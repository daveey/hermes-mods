#!/bin/sh
# Refuse commits that would publish secrets or private details. This repo is PUBLIC.
#  1. gitleaks on the staged diff (brew install gitleaks)
#  2. a private denylist (personal names, hosts, employer internals), one regex per line, read from
#     $HERMES_MODS_DENYLIST or ~/code/hermes/mods-denylist.txt — kept outside this repo on purpose.
# Enable once per clone: git config core.hooksPath .githooks   (hermes-sync does this for you)
set -e
cd "$(git rev-parse --show-toplevel)"

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --no-banner --redact -c .gitleaks.toml >/dev/null 2>&1 || {
    echo "pre-commit: gitleaks found a possible secret — run: gitleaks git --pre-commit --staged -v -c .gitleaks.toml" >&2
    exit 1
  }
else
  echo "pre-commit: gitleaks not installed; skipping secret scan (brew install gitleaks)" >&2
fi

deny="${HERMES_MODS_DENYLIST:-$HOME/code/hermes/mods-denylist.txt}"
if [ -f "$deny" ]; then
  pats=$(mktemp); grep -v '^[[:space:]]*#' "$deny" | grep -v '^[[:space:]]*$' > "$pats" || true
  if [ -s "$pats" ]; then
    hits=$(git diff --cached -U0 --diff-filter=AM | grep '^+' | grep -v '^+++' | grep -nEi -f "$pats" | cut -c1-160 || true)
    rm -f "$pats"
    if [ -n "$hits" ]; then
      echo "pre-commit: staged changes match the private denylist ($deny):" >&2
      echo "$hits" | head -10 >&2
      exit 1
    fi
  else
    rm -f "$pats"
  fi
fi
exit 0
