#!/usr/bin/env python3
"""hermes-chrome-agent: keep a real Google Chrome on an invisible virtual display, drivable over CDP.

Subcommands:
  run        supervisor (what the LaunchAgent runs): starts hermes-vdisplay + Chrome, keeps every Chrome
             window on the virtual display, restarts whichever child dies, and posts a macOS notification
             when a page asks for a passkey (WebAuthn get/create) so a human knows to tap Touch ID.
  status     print supervisor state, displays and Chrome windows
  show       move the agent's windows onto the main display and pause re-homing (to look / click)
  hide       resume re-homing (windows go back to the virtual display within ~1s)
  install    build hermes-vdisplay and write + load the LaunchAgent
  uninstall  unload and remove the LaunchAgent

Stdlib only (runs under /usr/bin/python3). Configuration via environment:
  HERMES_HOME                    default ~/.hermes
  HERMES_CHROME_AGENT_PORT       CDP port (default 9333, loopback only)
  HERMES_CHROME_AGENT_PROFILE    Chrome --user-data-dir (default $HERMES_HOME/chrome-agent)
  HERMES_CHROME_AGENT_TOOLS      dir holding the hermes-vdisplay binary (default $HERMES_HOME/chrome-agent-tools)
  HERMES_CHROME_AGENT_CHROME     Chrome binary (default /Applications/Google Chrome.app/Contents/MacOS/Google Chrome)
  HERMES_CHROME_AGENT_LABEL      LaunchAgent label (default com.hermes.chrome-agent)
  HERMES_CHROME_AGENT_SHOW_ON_PASSKEY=1  bring the passkey-requesting window to the main display until it settles
"""
import base64
import json
import os
import signal
import socket
import struct
import subprocess
import sys
import threading
import time
import urllib.request

HOME = os.path.expanduser("~")
HERMES_HOME = os.environ.get("HERMES_HOME") or os.path.join(HOME, ".hermes")
PORT = int(os.environ.get("HERMES_CHROME_AGENT_PORT") or 9333)
PROFILE = os.environ.get("HERMES_CHROME_AGENT_PROFILE") or os.path.join(HERMES_HOME, "chrome-agent")
TOOLS = os.environ.get("HERMES_CHROME_AGENT_TOOLS") or os.path.join(HERMES_HOME, "chrome-agent-tools")
CHROME = os.environ.get("HERMES_CHROME_AGENT_CHROME") or "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
LABEL = os.environ.get("HERMES_CHROME_AGENT_LABEL") or "com.hermes.chrome-agent"
VDISPLAY = os.path.join(TOOLS, "hermes-vdisplay")
STATE_DIR = os.path.join(HERMES_HOME, "cache", "chrome-agent")
STATE_FILE = os.path.join(STATE_DIR, "state.json")
SHOW_FLAG = os.path.join(STATE_DIR, "show")
LOG = os.path.join(HERMES_HOME, "logs", "chrome-agent.log")
SRC_DIR = os.path.dirname(os.path.realpath(__file__))
BINDING = "__hermesWebAuthn"
MENU_BAR = 40  # leave room for the virtual display's own menu bar
# Move the window asking for a passkey onto the main display until the request settles (max 120s), so the
# human sees which site they are approving. Off by default: the Touch ID sensor works without seeing it.
SHOW_ON_PASSKEY = os.environ.get("HERMES_CHROME_AGENT_SHOW_ON_PASSKEY", "") not in ("", "0", "false")

# Wraps navigator.credentials.get/create and reports the request through a CDP binding. Conditional
# mediation (passkey autofill, fired on page load without user intent) is not reported.
WEBAUTHN_HOOK = r"""(() => {
  try {
    if (window.__hermesWebAuthnHooked || !navigator.credentials) return;
    window.__hermesWebAuthnHooked = true;
    const c = navigator.credentials;
    for (const op of ['get', 'create']) {
      const orig = c[op] && c[op].bind(c);
      if (!orig) continue;
      c[op] = function (opts) {
        try {
          const pk = opts && opts.publicKey;
          if (pk && opts.mediation !== 'conditional' && typeof window.%s === 'function') {
            const report = window.%s, rpId = pk.rpId || (pk.rp && pk.rp.id) || location.hostname;
            report(JSON.stringify({op, origin: location.origin, rpId}));
            const done = () => { try { report(JSON.stringify({op: 'done', origin: location.origin, rpId})); } catch (e) {} };
            const p = orig(opts);
            p.then(done, done);
            return p;
          }
        } catch (e) {}
        return orig(opts);
      };
    }
  } catch (e) {}
})();""" % (BINDING, BINDING)


def log(msg):
    sys.stdout.write("%s %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg))
    sys.stdout.flush()


# ---------------------------------------------------------------- minimal CDP websocket client (stdlib)

class CDPError(Exception):
    pass


class CDP:
    """Browser-level CDP connection with flat sessions. One reader thread; call() blocks for its reply."""

    def __init__(self, ws_url, on_event=None, timeout=10):
        rest = ws_url.split("://", 1)[1]
        hostport, path = rest.split("/", 1)
        host, port = hostport.rsplit(":", 1)
        self.sock = socket.create_connection((host, int(port)), timeout=timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        # No Origin header: Chrome only checks --remote-allow-origins when one is sent.
        req = ("GET /%s HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
               "Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n" % (path, hostport, key))
        self.sock.sendall(req.encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise CDPError("handshake: connection closed")
            buf += chunk
        head, self._buf = buf.split(b"\r\n\r\n", 1)
        if b" 101 " not in head.split(b"\r\n", 1)[0]:
            raise CDPError("handshake failed: %r" % head[:200])
        self.sock.settimeout(None)
        self.on_event = on_event
        self.next_id = 0
        self.pending = {}
        self.lock = threading.Lock()
        self.send_lock = threading.Lock()
        self.closed = False
        self.reader = threading.Thread(target=self._read_loop, daemon=True)
        self.reader.start()

    def _recv_exact(self, n):
        while len(self._buf) < n:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise CDPError("connection closed")
            self._buf += chunk
        out, self._buf = self._buf[:n], self._buf[n:]
        return out

    def _read_frame(self):
        b1, b2 = self._recv_exact(2)
        op, ln = b1 & 0x0F, b2 & 0x7F
        if ln == 126:
            ln = struct.unpack(">H", self._recv_exact(2))[0]
        elif ln == 127:
            ln = struct.unpack(">Q", self._recv_exact(8))[0]
        mask = self._recv_exact(4) if b2 & 0x80 else None
        data = self._recv_exact(ln)
        if mask:
            data = bytes(c ^ mask[i % 4] for i, c in enumerate(data))
        return b1 & 0x80, op, data

    def _read_loop(self):
        msg, msg_op = b"", None
        try:
            while True:
                fin, op, data = self._read_frame()
                if op == 8:
                    break
                if op == 9:
                    self._send_frame(10, data)
                    continue
                if op in (1, 2):
                    msg, msg_op = data, op
                elif op == 0:
                    msg += data
                else:
                    continue
                if not fin:
                    continue
                self._dispatch(json.loads(msg.decode("utf-8")))
                msg = b""
        except Exception:
            pass
        finally:
            self.closed = True
            with self.lock:
                for ev in self.pending.values():
                    ev[1] = {"error": {"message": "connection closed"}}
                    ev[0].set()

    def _dispatch(self, m):
        if "id" in m:
            with self.lock:
                slot = self.pending.pop(m["id"], None)
            if slot:
                slot[1] = m
                slot[0].set()
        elif self.on_event:
            try:
                self.on_event(m)
            except Exception as e:  # never kill the reader on a handler bug
                log("event handler error: %s" % e)

    def _send_frame(self, op, payload):
        hdr = bytes([0x80 | op])
        n = len(payload)
        if n < 126:
            hdr += bytes([0x80 | n])
        elif n < 65536:
            hdr += bytes([0x80 | 126]) + struct.pack(">H", n)
        else:
            hdr += bytes([0x80 | 127]) + struct.pack(">Q", n)
        mask = os.urandom(4)
        body = bytes(c ^ mask[i % 4] for i, c in enumerate(payload))
        with self.send_lock:
            self.sock.sendall(hdr + mask + body)

    def call(self, method, params=None, session=None, timeout=10):
        if self.closed:
            raise CDPError("connection closed")
        with self.lock:
            self.next_id += 1
            mid = self.next_id
            slot = [threading.Event(), None]
            self.pending[mid] = slot
        msg = {"id": mid, "method": method, "params": params or {}}
        if session:
            msg["sessionId"] = session
        self._send_frame(1, json.dumps(msg).encode())
        if not slot[0].wait(timeout):
            with self.lock:
                self.pending.pop(mid, None)
            raise CDPError("%s timed out" % method)
        r = slot[1]
        if "error" in r:
            raise CDPError("%s: %s" % (method, r["error"].get("message")))
        return r.get("result", {})

    def close(self):
        self.closed = True
        try:
            self.sock.close()
        except Exception:
            pass


def cdp_version(timeout=1.0):
    try:
        with urllib.request.urlopen("http://127.0.0.1:%d/json/version" % PORT, timeout=timeout) as r:
            return json.load(r)
    except Exception:
        return None


# ---------------------------------------------------------------- supervisor

def parse_rect(s):
    xy, wh = s.split(" ")
    x, y = xy.split(",")
    w, h = wh.split("x")
    return [int(x), int(y), int(w), int(h)]


def inside(b, r, tol=2):
    return (b["left"] >= r[0] - tol and b["top"] >= r[1] - tol
            and b["left"] + b["width"] <= r[0] + r[2] + tol and b["top"] + b["height"] <= r[1] + r[3] + tol)


def notify(title, text):
    script = 'display notification %s with title %s sound name "Glass"' % (json.dumps(text), json.dumps(title))
    try:
        subprocess.Popen(["/usr/bin/osascript", "-e", script], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        log("notify failed: %s" % e)


class Supervisor:
    def __init__(self):
        self.vd = None
        self.chrome = None
        self.vbounds = None
        self.main = None
        self.cdp = None
        self.hooked = set()
        self.last_notice = {}
        self.sess_target = {}
        self.passkey = None  # {"target": id, "until": t, "wid": windowId|None} while a request is pending
        self.stop = False
        self.chrome_fails = 0
        self.shown = False

    # -- children
    def start_vdisplay(self):
        if not os.path.exists(VDISPLAY):
            raise SystemExit("missing %s (run: hermes-chrome-agent install)" % VDISPLAY)
        self.vbounds = None
        self.vd = subprocess.Popen([VDISPLAY], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                   universal_newlines=True, bufsize=1)
        threading.Thread(target=self._vd_reader, args=(self.vd,), daemon=True).start()
        deadline = time.time() + 10
        while self.vbounds is None and time.time() < deadline and self.vd.poll() is None:
            time.sleep(0.1)
        log("vdisplay pid %d bounds %s main %s" % (self.vd.pid, self.vbounds, self.main))

    def _vd_reader(self, proc):
        for line in proc.stdout:
            line = line.strip()
            if " bounds " in line:
                try:
                    rest = line.split(" bounds ", 1)[1]
                    own, _, main = rest.partition(" main ")
                    self.vbounds = parse_rect(own)
                    if main:
                        self.main = parse_rect(main)
                    log("vdisplay: " + line)
                except Exception:
                    log("vdisplay unparsed: " + line)
            elif line:
                log("vdisplay: " + line)

    def _kill_stale_chrome(self):
        """A Chrome left on our profile (previous supervisor SIGKILLed, manual launch) would swallow our
        launch (macOS hands the request to the running instance). The profile is dedicated, so stop it."""
        lock = os.path.join(PROFILE, "SingletonLock")
        try:
            pid = int(os.readlink(lock).rsplit("-", 1)[1])
        except Exception:
            return
        if self.chrome and pid == self.chrome.pid:
            return
        try:
            os.kill(pid, 0)
        except OSError:
            return
        log("stopping stale Chrome pid %d holding %s" % (pid, PROFILE))
        os.kill(pid, signal.SIGTERM)
        for _ in range(100):
            time.sleep(0.1)
            try:
                os.kill(pid, 0)
            except OSError:
                return
        os.kill(pid, signal.SIGKILL)
        time.sleep(0.5)

    def _prefs_off_savers(self):
        """Memory Saver discards hidden tabs and Energy Saver freezes them; agent sessions live in hidden
        tabs. Chrome rewrites Local State on exit, so set this while Chrome is down."""
        path = os.path.join(PROFILE, "Local State")
        try:
            with open(path) as f:
                st = json.load(f)
        except Exception:
            st = {}
        pt = st.setdefault("performance_tuning", {})
        changed = False
        for k in ("high_efficiency_mode", "battery_saver_mode"):
            if pt.get(k, {}).get("state") != 0:
                pt.setdefault(k, {})["state"] = 0
                changed = True
        if changed:
            with open(path + ".tmp", "w") as f:
                json.dump(st, f)
            os.replace(path + ".tmp", path)
            log("Local State: Memory Saver / Energy Saver forced off")

    def start_chrome(self):
        self._kill_stale_chrome()
        os.makedirs(PROFILE, exist_ok=True)
        self._prefs_off_savers()
        args = [CHROME, "--user-data-dir=" + PROFILE, "--remote-debugging-port=%d" % PORT,
                "--remote-debugging-address=127.0.0.1",
                "--remote-allow-origins=http://127.0.0.1:%d,http://localhost:%d" % (PORT, PORT),
                "--no-first-run", "--no-default-browser-check", "--hide-crash-restore-bubble",
                "--disable-backgrounding-occluded-windows", "--disable-renderer-backgrounding",
                "--disable-background-timer-throttling", "about:blank"]
        if self.vbounds:
            args.insert(-1, "--window-position=%d,%d" % (self.vbounds[0], self.vbounds[1] + MENU_BAR))
        self.chrome = subprocess.Popen(args, stdout=sys.stdout, stderr=subprocess.STDOUT)
        log("chrome pid %d started" % self.chrome.pid)
        self.hooked.clear()
        deadline = time.time() + 30
        while time.time() < deadline and self.chrome.poll() is None:
            if cdp_version():
                return
            time.sleep(0.2)
        log("chrome CDP did not come up within 30s")

    def stop_children(self):
        for name, p in (("chrome", self.chrome), ("vdisplay", self.vd)):
            if p and p.poll() is None:
                p.terminate()
                try:
                    p.wait(10)
                except subprocess.TimeoutExpired:
                    p.kill()
                log("%s stopped" % name)

    # -- CDP
    def connect(self):
        if self.cdp and not self.cdp.closed:
            return self.cdp
        v = cdp_version()
        if not v:
            return None
        self.cdp = CDP(v["webSocketDebuggerUrl"], on_event=self.on_event)
        self.hooked.clear()
        self.cdp.call("Target.setDiscoverTargets", {"discover": True})
        self.cdp.call("Target.setAutoAttach", {"autoAttach": True, "waitForDebuggerOnStart": False, "flatten": True})
        log("CDP connected")
        return self.cdp

    def hook_session(self, session, info=None):
        c = self.cdp
        try:
            # Page.enable keeps the script across cross-process navigations and Runtime.enable keeps the
            # binding; without them the hook silently disappears on the first cross-site navigation.
            c.call("Page.enable", {}, session=session, timeout=30)
            c.call("Runtime.enable", {}, session=session, timeout=30)
            c.call("Runtime.addBinding", {"name": BINDING}, session=session, timeout=30)
            c.call("Page.addScriptToEvaluateOnNewDocument", {"source": WEBAUTHN_HOOK}, session=session, timeout=30)
            c.call("Runtime.evaluate", {"expression": WEBAUTHN_HOOK}, session=session, timeout=30)
            log("webauthn hook installed in %s" % ((info or {}).get("url", "")[:80] or session))
        except Exception as e:
            log("hook failed (%s): %s" % ((info or {}).get("url", "")[:80], e))

    def on_event(self, m):
        method = m.get("method")
        p = m.get("params", {})
        if method == "Target.attachedToTarget":
            info = p.get("targetInfo", {})
            sid = p.get("sessionId")
            if info.get("type") == "page" and sid not in self.hooked:
                self.hooked.add(sid)
                self.sess_target[sid] = info.get("targetId")
                threading.Thread(target=self.hook_session, args=(sid, info), daemon=True).start()
        elif method == "Target.detachedFromTarget":
            self.hooked.discard(p.get("sessionId"))
        elif method == "Runtime.bindingCalled" and p.get("name") == BINDING:
            try:
                req = json.loads(p.get("payload") or "{}")
            except ValueError:
                req = {}
            site = req.get("rpId") or req.get("origin") or "a site"
            log("webauthn %s %s from %s" % (req.get("op"), "settled" if req.get("op") == "done" else "request",
                                             req.get("origin")))
            if req.get("op") == "done":
                self.passkey = None
                return
            op = "sign in with" if req.get("op") == "get" else "create"
            now = time.time()
            if SHOW_ON_PASSKEY:
                self.passkey = {"target": self.sess_target.get(m.get("sessionId")), "until": now + 120, "wid": None}
            if now - self.last_notice.get(site, 0) > 10:
                self.last_notice[site] = now
                notify("Hermes needs Touch ID", "Tap Touch ID to %s a passkey for %s" % (op, site))

    def windows(self):
        c = self.cdp
        seen = {}
        for t in c.call("Target.getTargets").get("targetInfos", []):
            if t.get("type") != "page":
                continue
            try:
                w = c.call("Browser.getWindowForTarget", {"targetId": t["targetId"]})
            except CDPError:
                continue
            seen.setdefault(w["windowId"], (w["bounds"], t))
        return seen

    def place(self, wid, bounds, rect):
        c = self.cdp
        if bounds.get("windowState", "normal") != "normal":
            c.call("Browser.setWindowBounds", {"windowId": wid, "bounds": {"windowState": "normal"}})
        target = {"left": rect[0], "top": rect[1] + MENU_BAR,
                  "width": rect[2], "height": rect[3] - MENU_BAR}
        c.call("Browser.setWindowBounds", {"windowId": wid, "bounds": target})
        return target

    def main_rect(self):
        m = self.main
        return [m[0] + 80, m[1] + 40, min(1400, m[2] - 160), min(900, m[3] - 80)]

    def rehome(self):
        show = os.path.exists(SHOW_FLAG)
        if show and show_expired():
            os.remove(SHOW_FLAG)
            log("show: timed out, re-homing resumed")
            show = False
        if show:
            if self.shown or not self.main:
                return
            rect = self.main_rect()
            for wid, (b, t) in self.windows().items():
                self.place(wid, b, rect)
                log("show: window %d -> main display (%s)" % (wid, t.get("url", "")[:80]))
            self.shown = True
            return
        self.shown = False
        if not self.vbounds:
            return
        pk = self.passkey
        if pk and time.time() > pk["until"]:
            self.passkey = pk = None
        for wid, (b, t) in self.windows().items():
            if pk and self.main and (wid == pk["wid"] or (pk["wid"] is None and t.get("targetId") == pk["target"])):
                if pk["wid"] is None:
                    pk["wid"] = wid
                    self.place(wid, b, self.main_rect())
                    log("passkey: window %d -> main display (%s)" % (wid, t.get("url", "")[:80]))
                continue
            # A display-filling window reports "maximized" (zoomed) on macOS; that is still home.
            if b.get("windowState", "normal") in ("normal", "maximized") and inside(b, self.vbounds):
                continue
            nb = self.place(wid, b, self.vbounds)
            log("rehome: window %d %s -> %s (%s)" % (wid, {k: b.get(k) for k in ("left", "top", "width", "height", "windowState")},
                                                  nb, t.get("url", "")[:80]))

    def write_state(self):
        st = {"pid": os.getpid(), "port": PORT, "profile": PROFILE, "vdisplay_bounds": self.vbounds,
              "main_bounds": self.main, "chrome_pid": self.chrome.pid if self.chrome else None,
              "vdisplay_pid": self.vd.pid if self.vd else None, "show": os.path.exists(SHOW_FLAG),
              "updated": time.time()}
        tmp = STATE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(st, f)
        os.replace(tmp, STATE_FILE)

    def run(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        signal.signal(signal.SIGTERM, lambda *_: setattr(self, "stop", True))
        signal.signal(signal.SIGINT, lambda *_: setattr(self, "stop", True))
        log("supervisor pid %d starting (port %d, profile %s)" % (os.getpid(), PORT, PROFILE))
        self.start_vdisplay()
        self.start_chrome()
        backoff_until = 0
        try:
            while not self.stop:
                if self.vd.poll() is not None:
                    log("vdisplay exited (%s); restarting" % self.vd.returncode)
                    self.start_vdisplay()
                if self.chrome.poll() is not None and time.time() >= backoff_until:
                    log("chrome exited (%s); restarting" % self.chrome.returncode)
                    if self.cdp:
                        self.cdp.close()
                        self.cdp = None
                    self.chrome_fails += 1
                    self.start_chrome()
                    if self.chrome.poll() is None and cdp_version():
                        self.chrome_fails = 0
                    backoff_until = time.time() + min(60, 2 ** min(self.chrome_fails, 6))
                try:
                    if self.connect():
                        self.rehome()
                except (CDPError, OSError) as e:
                    log("cdp: %s" % e)
                    if self.cdp:
                        self.cdp.close()
                        self.cdp = None
                self.write_state()
                time.sleep(1)
        finally:
            log("supervisor stopping")
            self.stop_children()


# ---------------------------------------------------------------- CLI

def cmd_status():
    try:
        with open(STATE_FILE) as f:
            st = json.load(f)
    except Exception:
        st = {}
    alive = False
    if st.get("pid"):
        try:
            os.kill(st["pid"], 0)
            alive = True
        except OSError:
            pass
    print("supervisor: %s (pid %s, state age %.0fs)" % ("running" if alive else "NOT running", st.get("pid"),
                                                       time.time() - st.get("updated", 0)))
    print("virtual display: %s   main display: %s" % (st.get("vdisplay_bounds"), st.get("main_bounds")))
    print("mode: %s" % ("SHOW (windows on main display)" if os.path.exists(SHOW_FLAG) else "hidden"))
    v = cdp_version()
    print("cdp: http://127.0.0.1:%d %s" % (PORT, v["Browser"] if v else "NOT answering"))
    if v:
        c = CDP(v["webSocketDebuggerUrl"])
        try:
            for t in c.call("Target.getTargets").get("targetInfos", []):
                if t.get("type") == "page":
                    b = c.call("Browser.getWindowForTarget", {"targetId": t["targetId"]})["bounds"]
                    print("  window %-5s %4s,%-4s %sx%s  %s" % (b.get("windowState"), b.get("left"), b.get("top"),
                                                             b.get("width"), b.get("height"), t.get("url", "")[:90]))
        finally:
            c.close()
    return 0 if alive and v else 1


def plist_text():
    py = "/usr/bin/python3"
    script = os.path.join(TOOLS, "hermes-chrome-agent")
    env = "".join("<key>%s</key><string>%s</string>" % (k, os.environ[k]) for k in
                  ("HERMES_CHROME_AGENT_PORT", "HERMES_CHROME_AGENT_PROFILE", "HERMES_CHROME_AGENT_CHROME")
                  if os.environ.get(k))
    return """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>%(label)s</string>
  <key>ProgramArguments</key><array><string>%(py)s</string><string>%(script)s</string><string>run</string></array>
  <key>EnvironmentVariables</key><dict><key>HERMES_HOME</key><string>%(home)s</string>%(env)s</dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>%(log)s</string>
  <key>StandardErrorPath</key><string>%(log)s</string>
</dict>
</plist>
""" % {"label": LABEL, "py": py, "script": script, "home": HERMES_HOME, "env": env, "log": LOG}


def cmd_install():
    os.makedirs(TOOLS, exist_ok=True)
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    subprocess.check_call(["swiftc", "-O", "-import-objc-header", os.path.join(SRC_DIR, "CGVirtualDisplay.h"),
                           os.path.join(SRC_DIR, "vdisplay.swift"), "-o", VDISPLAY])
    link = os.path.join(TOOLS, "hermes-chrome-agent")
    me = os.path.realpath(__file__)
    if os.path.realpath(link) != me:
        if os.path.lexists(link):
            os.remove(link)
        os.symlink(me, link)
    plist = os.path.join(HOME, "Library", "LaunchAgents", LABEL + ".plist")
    with open(plist, "w") as f:
        f.write(plist_text())
    uid = os.getuid()
    subprocess.call(["launchctl", "bootout", "gui/%d/%s" % (uid, LABEL)], stderr=subprocess.DEVNULL)
    subprocess.check_call(["launchctl", "bootstrap", "gui/%d" % uid, plist])
    print("installed %s, %s; log %s" % (VDISPLAY, plist, LOG))
    return 0


def cmd_uninstall():
    plist = os.path.join(HOME, "Library", "LaunchAgents", LABEL + ".plist")
    subprocess.call(["launchctl", "bootout", "gui/%d/%s" % (os.getuid(), LABEL)])
    if os.path.exists(plist):
        os.remove(plist)
    print("removed %s (profile %s kept)" % (plist, PROFILE))
    return 0


def show_expired(now=None):
    """The show flag may hold an epoch deadline (`show --minutes N`); empty = until `hide`."""
    try:
        text = open(SHOW_FLAG).read().strip()
        return bool(text) and float(text) <= (now or time.time())
    except (OSError, ValueError):
        return False


def cmd_show(minutes=None):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(SHOW_FLAG, "w") as f:
        f.write("%f" % (time.time() + float(minutes) * 60) if minutes else "")
    time.sleep(2)
    print("windows moved to the main display; run `hermes-chrome-agent hide` to send them back"
          + (" (auto-hide in %s min)" % minutes if minutes else ""))
    return 0


def cmd_hide():
    if os.path.exists(SHOW_FLAG):
        os.remove(SHOW_FLAG)
    time.sleep(2)
    print("re-homing resumed")
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    table = {"run": lambda: Supervisor().run() or 0, "status": cmd_status,
             "show": lambda: cmd_show(argv[3] if len(argv) > 3 and argv[2] == "--minutes" else None),
             "hide": cmd_hide,
             "install": cmd_install, "uninstall": cmd_uninstall}
    if cmd not in table:
        print(__doc__)
        return 2
    return table[cmd]()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
