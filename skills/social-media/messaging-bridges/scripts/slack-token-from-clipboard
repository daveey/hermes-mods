#!/usr/bin/env python3
"""Copy a Slack token, run this: stores it in ~/.hermes/.env without printing it."""
import pathlib
import re
import subprocess
import sys

tok = subprocess.run(["pbpaste"], capture_output=True, text=True).stdout.strip()
key = {"xoxb-": "SLACK_BOT_TOKEN", "xapp-": "SLACK_APP_TOKEN"}.get(tok[:5])
if not key or not re.fullmatch(r"[A-Za-z0-9-]+", tok):
    sys.exit("Clipboard doesn't hold an xoxb-/xapp- token.")
env = pathlib.Path.home() / ".hermes/.env"
lines = [l for l in env.read_text().splitlines() if not l.startswith(key + "=")] if env.exists() else []
lines.append(f"{key}={tok}")
env.write_text("\n".join(lines) + "\n")
env.chmod(0o600)
subprocess.run(["pbcopy"], input="", text=True)  # clear clipboard
print(f"Saved {key} ({tok[:9]}…)")
