{
  "timezone": "America/Los_Angeles",
  "owner": "you",
  "deadline_horizon_hours": 72,
  "max_action_chars": 240,
  "include_initial_blocked": true,
  "boards": null,
  "hermes_bin": null,
  "groups": [
    {"name": "Partner", "keywords": ["alex", "alex's"], "weight": 4},
    {"name": "Watch", "keywords": ["watch", "wrist"], "weight": 1},
    {"name": "Phone", "keywords": ["iphone", "phone", "app store", "testflight"], "weight": 1},
    {"name": "Home server", "keywords": ["server", "nas", "screen lock"], "weight": 1},
    {"name": "Decide / answer", "keywords": ["say whether", "which", "decide", "choose", "approve"], "weight": 1}
  ],
  "shared_steps": [
    {
      "id": "app-install",
      "sentence": "(?i)\\binstall",
      "value": "(?:build[- ])?(\\d{3,4})\\b",
      "agg": "max",
      "group": "Phone",
      "label": "Install the latest app build (>= {max}) on the phone",
      "check": "app_build {max}",
      "unblocks_when": "the phone reports the new build"
    }
  ],
  "rules": [
    {"match": "(?i)hasn't (opened|used) (her|his) invite", "group": "Partner", "check": "invite_used alex",
     "action": "Get Alex to open the invite link", "unblocks_when": "invite consumed"}
  ],
  "cards": {
    "t_00000000": {"action": "Override the one-line action", "group": "Phone", "check": "never_ok"}
  },
  "checks": {
    "app_build": {"cmd": "python3 ~/.hermes/scripts/my_checks.py app_build {0}", "unblock": false, "timeout": 60},
    "invite_used": {"cmd": "python3 ~/.hermes/scripts/my_checks.py invite_used {0}", "unblock": true},
    "never_ok": {"cmd": "exit 1", "unblock": true}
  }
}
