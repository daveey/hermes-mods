#!/usr/bin/env python3
"""Run pool_llm.py under the Hermes runtime interpreter (it imports agent.*), from any shell or venv."""
import json
import os
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
MODULE = os.path.join(os.path.dirname(HERE), "pool_llm.py")
MARK = "runpy.run_module('hermes_cli.main', run_name='__main__', alter_sys=True)"


def main() -> int:
    hermes = shutil.which("hermes") or os.path.expanduser("~/.local/bin/hermes")
    try:
        out = subprocess.run([hermes, "--print-runtime-command"], capture_output=True, text=True, timeout=60).stdout
        cmd = json.loads(out.strip().splitlines()[-1])
    except Exception as exc:  # noqa: BLE001
        print(f"hermes-pool-llm: cannot find the Hermes runtime ({exc}); is `hermes` on PATH?", file=sys.stderr)
        return 2
    code = cmd[-1]
    if MARK not in code:
        print("hermes-pool-llm: unexpected `hermes --print-runtime-command` output; update bin/hermes-pool-llm",
              file=sys.stderr)
        return 2
    code = code.replace(MARK, f"sys.argv = [{MODULE!r}] + sys.argv[1:]; runpy.run_path({MODULE!r}, run_name='__main__')")
    os.execv(cmd[0], cmd[:-1] + [code] + sys.argv[1:])
    return 0


if __name__ == "__main__":
    sys.exit(main())
