#!/bin/sh
# Only OS-managed shell/Python parse selection; never resolve code from PATH.
# -I ignores Python environment/cwd; -S excludes site initialization and .pth.
exec /usr/bin/python3 -I -B -S -c 'import pathlib, runpy, sys; script = pathlib.Path(sys.argv.pop(1)).resolve(); runpy.run_path(str(script.parents[1] / "runtime_binding.py"), run_name="__main__")' "$0" "$@"
