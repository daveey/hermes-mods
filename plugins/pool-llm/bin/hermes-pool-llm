#!/usr/bin/env python3
"""Use the installed managed Hermes contract, never PATH runtime discovery."""
import importlib.util
import json
import os
from pathlib import Path
import sys


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    spec = importlib.util.spec_from_file_location('pool_runtime_binding', root / 'runtime_binding.py')
    binding = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(binding)
    try:
        if sys.argv[1:] == ['binding']:
            print(json.dumps(binding.resolve(), sort_keys=True))
            return 0
        cmd = binding.command(root / 'pool_llm.py', sys.argv[1:])
    except (ValueError, OSError, KeyError, TypeError, SyntaxError):
        print('hermes-pool-llm: installed managed runtime binding invalid', file=sys.stderr)
        return 2
    os.execv(cmd[0], cmd)
    return 2


if __name__ == '__main__':
    sys.exit(main())
