diff --git a/tests/gateway/test_media_delivery_project_env_guard.py b/tests/gateway/test_media_delivery_project_env_guard.py
new file mode 100644
index 0000000000..28763cd0ad
--- /dev/null
+++ b/tests/gateway/test_media_delivery_project_env_guard.py
@@ -0,0 +1,120 @@
+"""Regression: a project-local ``.env`` / ``.envrc`` must not be deliverable as
+native media when the same path is read-blocked by ``agent/file_safety``.
+
+``gateway/platforms/base._media_delivery_denied_paths`` documents the invariant
+that "a credential the agent is forbidden to ... read must also never be
+auto-attached to a chat reply". ``agent/file_safety.get_read_block_error``
+read-blocks ``.env`` / ``.envrc`` anywhere on disk by basename, but the media
+denylist only enumerates ``<hermes-root>/.env``, so a user's *project* ``.env``
+(e.g. ``/home/user/app/.env``) was deliverable via a prompt-injected ``MEDIA:``
+tag in default (non-strict) single-user mode -> credential exfiltration.
+
+The gate is also only worth as much as its weakest path, so it must fail
+closed: an unavailable predicate has to deny, never skip the check.
+"""
+
+import importlib
+import sys
+from pathlib import Path
+
+import pytest
+
+from gateway.platforms.base import BasePlatformAdapter, validate_media_delivery_path
+from agent import file_safety
+
+
+def test_dotenv_basename_has_no_suffix():
+    # Reachability of the extensionless ``MEDIA:`` branch hinges on this pathlib
+    # fact: a leading-dot name has no suffix, so ``.env`` / ``.envrc`` are
+    # extensionless and take the branch that calls validate_media_delivery_path.
+    # Verified empirically, not from memory.
+    assert Path("/home/u/app/.env").suffix == ""
+    assert Path("/home/u/app/.envrc").suffix == ""
+    # A real extension is still detected, so ``.env.production`` is NOT
+    # extensionless and does not reach that branch (scope caveat).
+    assert Path("/home/u/app/.env.production").suffix == ".production"
+
+
+@pytest.mark.parametrize("basename", [".env", ".envrc"])
+def test_project_env_gate_mirrors_read_guard(tmp_path, monkeypatch, basename):
+    # Default single-user gateway = non-strict media delivery.
+    monkeypatch.setattr("gateway.media_policy.media_delivery_strict", lambda: False)
+
+    proj = tmp_path / "app"
+    proj.mkdir()
+    secret = proj / basename
+    secret.write_text("OPENAI_API_KEY=sk-live-SECRET\nDATABASE_URL=postgres://u:p@h/db\n")
+    p = str(secret.resolve())
+
+    # Precondition: the read guard blocks reading this project env file.
+    assert file_safety.get_read_block_error(p) is not None, (
+        "read guard should block the project env file (basename rule)"
+    )
+
+    # The delivery gate must mirror the read guard: a read-blocked credential
+    # must not be returned as a safe native attachment.
+    assert validate_media_delivery_path(p) is None, (
+        f"{basename} is read-blocked but validate_media_delivery_path approved "
+        "it for native attachment -> prompt-injected MEDIA: exfil"
+    )
+
+
+@pytest.mark.parametrize("basename", [".env", ".envrc"])
+def test_project_env_not_deliverable_via_media_tag(tmp_path, monkeypatch, basename):
+    # End-to-end: a prompt-injected MEDIA: tag pointing at a project env file
+    # must not surface it as a deliverable attachment.
+    monkeypatch.setattr("gateway.media_policy.media_delivery_strict", lambda: False)
+
+    proj = tmp_path / "app"
+    proj.mkdir()
+    secret = proj / basename
+    secret.write_text("STRIPE_SECRET_KEY=sk_live_SECRET\n")
+    p = str(secret.resolve())
+
+    reply = f"Sure, here is the file:\nMEDIA:{p}\n"
+    media, _cleaned = BasePlatformAdapter.extract_media(reply)
+    delivered_basenames = [Path(mp).name.lower() for mp, _voice in media]
+    assert basename not in delivered_basenames, (
+        f"project {basename} auto-attached for exfil via MEDIA: tag: {media}"
+    )
+
+
+def test_project_env_gate_fails_closed_on_import_failure(tmp_path, monkeypatch):
+    # The gate has to fail *closed*: an unavailable predicate must deny, never
+    # skip the check. Binding it at module import is what guarantees that, so
+    # pin the property rather than the mechanism -- a call-time import must not
+    # be able to decide whether the .env check runs at all.
+    monkeypatch.setattr("gateway.media_policy.media_delivery_strict", lambda: False)
+    monkeypatch.setitem(sys.modules, "agent.file_safety", None)
+
+    # Precondition: with the entry poisoned, a call-time import really fails.
+    with pytest.raises(ImportError):
+        importlib.import_module("agent.file_safety")
+
+    proj = tmp_path / "app"
+    proj.mkdir()
+    secret = proj / ".env"
+    secret.write_text("AWS_SECRET_ACCESS_KEY=SECRET\n")
+
+    assert validate_media_delivery_path(str(secret.resolve())) is None, (
+        "delivery gate fell open while agent.file_safety was unimportable at "
+        "call time -> project .env deliverable again"
+    )
+
+
+@pytest.mark.parametrize("strict", [False, True])
+def test_project_env_judged_on_canonical_path_in_every_mode(tmp_path, monkeypatch, strict):
+    # The gate judges the resolved path the sender uploads: a symlink with an innocent name, a
+    # case variant, and a file under the trusted cache allowlist are all still refused.
+    monkeypatch.setattr("gateway.media_policy.media_delivery_strict", lambda: strict)
+    cache = tmp_path / "cache"
+    cache.mkdir()
+    monkeypatch.setattr("gateway.platforms.base.MEDIA_DELIVERY_SAFE_ROOTS", (cache,))
+    (cache / ".ENVRC").write_text("TOKEN=SECRET\n")
+    (cache / "report.txt").write_text("ok\n")
+    link = tmp_path / "notes.txt"
+    link.symlink_to(cache / ".ENVRC")
+
+    for candidate in (cache / ".ENVRC", link):
+        assert validate_media_delivery_path(str(candidate)) is None, candidate
+    assert validate_media_delivery_path(str(cache / "report.txt")) == str((cache / "report.txt").resolve())
diff --git a/tests/gateway/test_native_redelivery_after_restart.py b/tests/gateway/test_native_redelivery_after_restart.py
new file mode 100644
index 0000000000..614e2fe241
--- /dev/null
+++ b/tests/gateway/test_native_redelivery_after_restart.py
@@ -0,0 +1,160 @@
+"""The first inbound after a gateway restart is not refused when it is the provider's redelivery.
+
+A messaging provider redelivers an event whose ACK was lost (Slack retries an event the stalled
+gateway never acknowledged; a watchdog restart drops the in-memory dedupe). The redelivery carries the
+same provider message id, so it is the same admission, but a native adapter stamps it with its own
+local arrival time (``MessageEvent.timestamp`` defaults to now) and the first reply per thread in a
+fresh process re-hydrates the thread history (``channel_context``). Both are in the admission's
+payload, so main refused the redelivery ``admission_conflict`` (ADMITTED_REQUEST_CONFLICT): the chat got
+a generic error (or, with warnings suppressed, nothing) instead of its answer or the pause notice.
+
+The committed row stays the one exactly-once identity: a redelivery that differs only in those
+gateway-derived fields resolves to it (as ``reconcile_native_retry`` already does for re-downloaded
+media), and changed user content under the same id still conflicts, now with a visible reply.
+Real GatewayRunner + SessionAuthority + SQLite, two owner epochs; the transport is stubbed.
+"""
+import asyncio
+from datetime import datetime, timedelta
+
+import pytest
+
+MESSAGE_ID = '1730000000.000100'
+
+
+async def _gateway(tmp_path, monkeypatch):
+    from gateway.config import GatewayConfig, Platform, PlatformConfig
+    from gateway.platforms.base import SendResult
+    from gateway.run import GatewayRunner
+    from gateway.session_ingress_context import register_transport_home
+    from tests.gateway.test_command_bypass_active_session import _StubAdapter
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setenv('TELEGRAM_ALLOWED_USERS', '42')
+    monkeypatch.setattr('gateway.run._hermes_home', tmp_path)
+    monkeypatch.setattr('hermes_state.DEFAULT_DB_PATH', tmp_path / 'state.db')
+    runner = GatewayRunner(GatewayConfig(multiplex_profiles=False, sessions_dir=tmp_path / 'sessions'))
+    adapter = _StubAdapter(PlatformConfig(enabled=True, token='fixture', typing_indicator=False), Platform.TELEGRAM)
+    sent, calls = [], []
+
+    async def send(chat_id, content, **kwargs):
+        sent.append(content)
+        return SendResult(success=True, message_id=str(len(sent)))
+    monkeypatch.setattr(adapter, 'send', send)
+
+    async def run_agent(**kwargs):
+        calls.append(kwargs.get('message'))
+        return {'final_response': 'the answer', 'messages': [], 'tools': [], 'history_offset': 0,
+                'last_prompt_tokens': 0}
+    runner._run_agent = run_agent
+    adapter.gateway_runner = runner
+    runner.adapters = {Platform.TELEGRAM: adapter}
+    register_transport_home(runner, None, tmp_path)
+    return runner, adapter, sent, calls
+
+
+def _wire(runner, adapter):
+    # As at startup: the authority exists before the adapters are wired, so the primary handler is
+    # the shared runtime's (``_make_default_profile_message_handler`` binds the native callback).
+    runner._wire_adapter_handlers(adapter)
+
+
+async def _settled(adapter, sent, calls, *, want):
+    for _ in range(200):
+        await asyncio.sleep(0.05)  # health: allow HX013 -- polls the adapter's background turn to quiesce
+        if not adapter._background_tasks and not adapter._session_tasks and want():
+            break
+    await asyncio.sleep(0.2)  # health: allow HX013 -- a late duplicate send would land here
+
+
+async def _admitted_before_crash(runner, adapter, *, started, **event_fields):
+    """Owner 1 commits the delivery (and, when ``started``, claims it) and dies before answering."""
+    from gateway.platforms.event import MessageEvent
+    from gateway.session_authority import initialize_session_authority
+    from gateway.session_ingress_context import native_callback
+    from hermes_constants import get_hermes_home
+    from hermes_state_runtime import claim_session_input
+    source = adapter.build_source(chat_id='42', chat_type='dm', user_id='42', thread_id='T1')
+    first = await initialize_session_authority(runner, profile_id=str(get_hermes_home()), instance_id='before-crash')
+    first._schedule = lambda ref: None  # the crash: its drain never ran
+    original = MessageEvent(text='hello', source=source, message_id=MESSAGE_ID,
+                            timestamp=datetime.now() - timedelta(seconds=40), **event_fields)
+    with native_callback(runner, original, get_hermes_home()):
+        receipt = await first.admit_native(original)
+    if started:
+        claim_session_input(first.db, epoch=first.epoch, session_id=receipt.ref.session_id)
+    return source, receipt
+
+
+async def _restart(runner):
+    from gateway.run_runtime import recover_profile_native_sessions
+    from gateway.session_authority import initialize_session_authority
+    from hermes_constants import get_hermes_home
+    second = await initialize_session_authority(runner, profile_id=str(get_hermes_home()), instance_id='after-restart')
+    await recover_profile_native_sessions(runner, second)
+    _wire(runner, runner.adapters[next(iter(runner.adapters))])
+    return second
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('rehydrated', [False, True], ids=['arrival-time', 'arrival-time-and-thread-context'])
+async def test_redelivery_after_restart_is_answered_once_not_refused(tmp_path, monkeypatch, rehydrated):
+    from gateway.platforms.event import MessageEvent
+    from hermes_state_runtime import list_session_admissions
+    runner, adapter, sent, calls = await _gateway(tmp_path, monkeypatch)
+    source, receipt = await _admitted_before_crash(runner, adapter, started=False)
+    try:
+        second = await _restart(runner)
+        # The provider's redelivery: same message id and text, this process's own arrival time and,
+        # for the first reply of a thread in a fresh process, the re-fetched thread history.
+        await adapter.handle_message(MessageEvent(
+            text='hello', source=source, message_id=MESSAGE_ID,
+            channel_context='[thread history fetched after the restart]' if rehydrated else None))
+        await _settled(adapter, sent, calls, want=lambda: 'the answer' in sent)
+        rows = list_session_admissions(second.db, session_id=receipt.ref.session_id, pending_only=False)
+    finally:
+        runner.session_store.close_all_db_handles()
+    replies = [text for text in sent if 'home channel' not in text]  # the first-contact /sethome tip is not a reply
+    assert replies == ['the answer'], 'the redelivery must be answered once, with no refusal beside it'
+    assert calls == ['hello'], 'the message must run exactly once'
+    assert [(row['request_id'], row['status']) for row in rows] == [(MESSAGE_ID, 'terminal')]
+
+
+@pytest.mark.asyncio
+async def test_redelivery_of_a_turn_lost_mid_run_tells_the_chat_it_is_paused(tmp_path, monkeypatch):
+    """Killed mid-turn: the turn is ``unknown`` and never replayed (GW-10). The redelivery is that
+    admission, so the chat gets the pause notice naming the way out, not a generic refusal."""
+    from gateway.platforms.event import MessageEvent
+    from hermes_state_runtime import list_session_admissions
+    runner, adapter, sent, calls = await _gateway(tmp_path, monkeypatch)
+    source, receipt = await _admitted_before_crash(runner, adapter, started=True)
+    try:
+        second = await _restart(runner)
+        await adapter.handle_message(MessageEvent(text='hello', source=source, message_id=MESSAGE_ID))
+        await _settled(adapter, sent, calls, want=lambda: bool(sent))
+        rows = list_session_admissions(second.db, session_id=receipt.ref.session_id, pending_only=False)
+    finally:
+        runner.session_store.close_all_db_handles()
+    assert calls == [], 'a turn lost mid-run is never replayed'
+    assert [row['status'] for row in rows] == ['unknown']
+    assert len(sent) == 1 and 'paused' in sent[0] and '/discard' in sent[0], sent
+
+
+@pytest.mark.asyncio
+async def test_changed_content_under_an_admitted_id_still_conflicts_and_says_so(tmp_path, monkeypatch):
+    """Exactly-once is unchanged: other user content under the same provider id is not this
+    admission. It is still refused, and the chat is told why instead of a generic turn error."""
+    from gateway.platforms.event import MessageEvent
+    from hermes_state_runtime import list_session_admissions
+    runner, adapter, sent, calls = await _gateway(tmp_path, monkeypatch)
+    source, receipt = await _admitted_before_crash(runner, adapter, started=False)
+    try:
+        second = await _restart(runner)
+        await _settled(adapter, sent, calls, want=lambda: 'the answer' in sent)  # the committed row runs
+        await adapter.handle_message(MessageEvent(text='a different message', source=source, message_id=MESSAGE_ID))
+        await _settled(adapter, sent, calls, want=lambda: len(sent) >= 2)
+        rows = list_session_admissions(second.db, session_id=receipt.ref.session_id, pending_only=False)
+    finally:
+        runner.session_store.close_all_db_handles()
+    assert calls == ['hello']
+    assert [row['payload']['text'] for row in rows] == ['hello']
+    refusal = [text for text in sent if text != 'the answer' and 'home channel' not in text]
+    assert len(refusal) == 1 and 'already received' in refusal[0] and 'RuntimeStoreError' not in refusal[0], sent
diff --git a/tests/gateway/test_owner_loop_claim_read.py b/tests/gateway/test_owner_loop_claim_read.py
new file mode 100644
index 0000000000..b861b2e6c0
--- /dev/null
+++ b/tests/gateway/test_owner_loop_claim_read.py
@@ -0,0 +1,60 @@
+"""The FIFO claim's pending-row reads wait off the owner loop.
+
+Every turn's drain reads the session's pending admissions before its claim (and re-reads the head
+after an awaited preclaim check). On slow storage that read used to stop the whole owner loop, every
+other session's turn, Stop and socket included. Real SessionAuthority + SessionDB; reads are slowed
+only for the session under test and only while the drain claims, and the stall is measured as
+loop-tick lag. The claim still takes the head the read validated.
+"""
+import asyncio
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+SLOW_S = 2.0
+
+
+@pytest.mark.asyncio
+async def test_claim_pending_read_keeps_the_owner_loop_ticking(tmp_path, monkeypatch):
+    import hermes_state_runtime as rt
+    from gateway import session_authority
+    from gateway.session_authority import LiveSession, SessionAuthority
+    from gateway.session_contract import SessionRef
+    from hermes_state import SessionDB
+    db = SessionDB(tmp_path / 'state.db')
+    db.create_session('s', source='cron')
+    authority = SessionAuthority(SimpleNamespace(_draining=False, adapters={}), profile_id='p', instance_id='t',
+                                 db=db, epoch=rt.begin_runtime_epoch(db, instance_id='t'))
+    live = authority.sessions['s'] = LiveSession(SimpleNamespace(platform=None, user_id='u'), 'route')
+    row = rt.admit_session_input(db, epoch=authority.epoch, principal_id='u', session_id='s',
+                                 request_id='r1', payload={'text': 'x'})
+    real, slow = rt.list_session_admissions, threading.Event()
+
+    def slow_list(*args, **kwargs):
+        if slow.is_set():
+            time.sleep(SLOW_S)  # health: allow HX013 -- the slow storage read IS the stall under test
+        return real(*args, **kwargs)
+    monkeypatch.setattr(session_authority, 'list_session_admissions', slow_list)
+    gaps = []
+
+    async def tick():
+        last = time.monotonic()
+        while True:
+            await asyncio.sleep(0.02)  # health: allow HX013 -- the ticker's period is the owner-loop stall measurement
+            now = time.monotonic()
+            gaps.append(now - last)
+            last = now
+    ticker = asyncio.create_task(tick())
+    await asyncio.sleep(0.05)  # health: allow HX013 -- the ticker runs before the claim starts
+    slow.set()
+    try:
+        claimed, first = await asyncio.wait_for(authority._claim_next(SessionRef('p', 's'), live), 30)
+    finally:
+        slow.clear()
+        ticker.cancel()
+        db.close()
+    assert first['admission_id'] == row['admission_id']
+    assert claimed and claimed['admission_id'] == row['admission_id'] and claimed['status'] == 'started'
+    assert max(gaps) < 0.2, f'owner loop stalled {max(gaps):.2f}s behind the claim read'
diff --git a/tests/gateway/test_owner_loop_cron_polling.py b/tests/gateway/test_owner_loop_cron_polling.py
new file mode 100644
index 0000000000..36b715d551
--- /dev/null
+++ b/tests/gateway/test_owner_loop_cron_polling.py
@@ -0,0 +1,131 @@
+"""A running cron job's owner-side polling never blocks the gateway event loop on storage.
+
+While an agent cron job runs, its in-process firer polls the owner (``cron/scheduler_authority.py``
+``observe`` -> ``gateway/session_cron.py`` ``operation('status')``) every <= 2 s, and journals its
+receipt with an fsynced write (``save``). Both used to run on the owner loop: on slow storage
+(a network filesystem holding SQLite's WAL ``-shm`` lock for seconds) every poll stopped every
+socket, timer, Stop and liveness probe the gateway serves for as long as the read took.
+
+Real GatewayRunner + SessionAuthority + SessionDB; storage is slowed by wrapping the store's own
+choke points (and the journal write), so the stall is measured as loop-tick lag, not inferred.
+"""
+import asyncio
+import threading
+import time
+
+import pytest
+
+SLOW_S = 2.0  # one slow storage call; the report measured 5-58 s stalls on NFS
+MAX_LAG_S = 0.2
+
+
+def _ticker(gaps):
+    async def tick():
+        last = time.monotonic()
+        while True:
+            await asyncio.sleep(0.02)  # health: allow HX013 -- the ticker's period is the owner-loop stall measurement
+            now = time.monotonic()
+            gaps.append(now - last)
+            last = now
+    return asyncio.create_task(tick())
+
+
+async def _owner(tmp_path, monkeypatch, run_job):
+    from cron import jobs, scheduler
+    from gateway import run
+    from gateway.config import GatewayConfig
+    from gateway.run import GatewayRunner
+    from gateway.session_authority import initialize_session_authority
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setattr('hermes_state.DEFAULT_DB_PATH', tmp_path / 'state.db')
+    monkeypatch.setattr(run, '_load_gateway_config', lambda *a: {'model': {}, 'platform_toolsets': {'cli': []}})
+    monkeypatch.setattr(jobs, 'get_job', lambda jid: {'id': jid, 'prompt': 'report', 'model': 'm', 'name': 'job'})
+    monkeypatch.setattr(scheduler, 'run_job', run_job)
+    runner = GatewayRunner(GatewayConfig(multiplex_profiles=False, sessions_dir=tmp_path / 'sessions'))
+    # The owner binds itself as this home's in-process cron owner (session_cron.bind_owner).
+    authority = await initialize_session_authority(runner, profile_id=str(tmp_path), instance_id='owner')
+    return runner, authority
+
+
+def _slow_store(monkeypatch, slow):
+    """Every SessionDB read and write waits ``SLOW_S`` while ``slow`` is set, on whatever thread."""
+    from hermes_state import SessionDB
+    read, write = SessionDB._read_ctx, SessionDB._execute_write
+
+    def _read_ctx(self, *args, **kwargs):
+        if slow.is_set():
+            time.sleep(SLOW_S)  # health: allow HX013 -- the slow storage read IS the stall under test
+        return read(self, *args, **kwargs)
+
+    def _execute_write(self, *args, **kwargs):
+        if slow.is_set():
+            time.sleep(SLOW_S)  # health: allow HX013 -- the slow storage write IS the stall under test
+        return write(self, *args, **kwargs)
+    monkeypatch.setattr(SessionDB, '_read_ctx', _read_ctx)
+    monkeypatch.setattr(SessionDB, '_execute_write', _execute_write)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('cancelled', [False, True], ids=['status-poll', 'cancel-poll'])
+async def test_cron_owner_polls_keep_the_loop_ticking_on_slow_storage(tmp_path, monkeypatch, cancelled):
+    from cron.scheduler_authority import run_canonical_job
+    running, release = threading.Event(), threading.Event()
+
+    def run_job(job, *, extra_prompt, execution_id, cancel_event):
+        running.set()
+        release.wait(30)
+        return (True, 'doc', 'answer', None)
+    runner, _authority = await _owner(tmp_path, monkeypatch, run_job)
+    slow = threading.Event()
+    _slow_store(monkeypatch, slow)
+    cancel = threading.Event()
+    firer = asyncio.create_task(asyncio.to_thread(
+        run_canonical_job, {'id': 'job'}, execution_id='fire', cancel_event=cancel))
+    gaps = []
+    try:
+        assert await asyncio.to_thread(running.wait, 10), 'the cron job never started on the owner'
+        await asyncio.sleep(2.5)  # health: allow HX013 -- the firer's status backoff reaches its 2 s cap
+        if cancelled:
+            cancel.set()  # the firer now sends cancel + status on every poll
+        slow.set()
+        tick = _ticker(gaps)
+        await asyncio.sleep(SLOW_S * 2.5)  # health: allow HX013 -- the slow-storage window the ticker measures
+        tick.cancel()
+    finally:
+        slow.clear()
+        release.set()
+        result = await asyncio.wait_for(firer, 30)
+        await asyncio.to_thread(runner.session_store.close_all_db_handles)
+    assert result[0] is True or cancelled, result
+    assert gaps and max(gaps) < MAX_LAG_S, f'owner loop stalled {max(gaps):.2f}s behind a cron poll'
+
+
+@pytest.mark.asyncio
+async def test_cron_receipt_journal_fsync_keeps_the_loop_ticking(tmp_path, monkeypatch):
+    """``observe``'s journal ``save()`` (atomic write + file and directory fsync) runs off the loop."""
+    import utils
+    from cron.scheduler_authority import run_canonical_job
+
+    def run_job(job, *, extra_prompt, execution_id, cancel_event):
+        return (True, 'doc', 'answer', None)
+    runner, _authority = await _owner(tmp_path, monkeypatch, run_job)
+    # Warm the fire path (cold imports of the submit/execute modules are not the write under test).
+    await asyncio.wait_for(asyncio.to_thread(run_canonical_job, {'id': 'job'}, execution_id='warm'), 30)
+    real_write, slow_writes = utils.atomic_json_write, []
+
+    def slow_journal_write(path, *args, **kwargs):
+        if '/cron/admissions/' in str(path):
+            slow_writes.append(threading.get_ident())
+            time.sleep(SLOW_S / 2)  # health: allow HX013 -- a slow (NFS) fsync IS the stall under test
+        return real_write(path, *args, **kwargs)
+    monkeypatch.setattr(utils, 'atomic_json_write', slow_journal_write)
+    gaps = []
+    tick = _ticker(gaps)
+    try:
+        result = await asyncio.wait_for(asyncio.to_thread(run_canonical_job, {'id': 'job'}, execution_id='fire'), 30)
+    finally:
+        tick.cancel()
+        await asyncio.to_thread(runner.session_store.close_all_db_handles)
+    assert result == (True, 'doc', 'answer', None)
+    assert len(slow_writes) >= 2, 'the journal was not written before submit and after the receipt'
+    assert max(gaps) < MAX_LAG_S, f'owner loop stalled {max(gaps):.2f}s behind the cron journal write'
diff --git a/tests/gateway/test_platform_allow_silence.py b/tests/gateway/test_platform_allow_silence.py
