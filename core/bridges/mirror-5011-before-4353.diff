+    return SimpleNamespace(choices=[SimpleNamespace(message=message, finish_reason="tool_calls" if tool_calls else "stop")],
+                           model="test/model", usage=SimpleNamespace(prompt_tokens=900, completion_tokens=7,
+                                                                     total_tokens=907))
