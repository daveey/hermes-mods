diff --git a/tests/hermes_cli/test_backup_archive_perms.py b/tests/hermes_cli/test_backup_archive_perms.py
new file mode 100644
index 0000000000..99db4ff3a9
--- /dev/null
+++ b/tests/hermes_cli/test_backup_archive_perms.py
@@ -0,0 +1,70 @@
+"""Backup archives carry credentials: they must be owner-only regardless of the umask."""
+import os
+import stat
+import zipfile
+
+import pytest
+
+from hermes_cli.backup import create_pre_update_backup
+from hermes_cli.backup_atomic import _atomic_output_path
+
+
+@pytest.fixture
+def umask_022():
+    old = os.umask(0o022)
+    try:
+        yield
+    finally:
+        os.umask(old)
+
+
+@pytest.mark.platforms("posix")
+def test_partial_is_owner_only_before_first_byte_and_after_publish(tmp_path, umask_022):
+    destination = tmp_path / "secret-backup.zip"
+    with _atomic_output_path(destination) as partial_path:
+        assert stat.S_IMODE(partial_path.stat().st_mode) == 0o600
+        with zipfile.ZipFile(partial_path, "w") as zf:
+            zf.writestr("auth.json", "credential-bearing-archive")
+            assert stat.S_IMODE(partial_path.stat().st_mode) == 0o600
+    assert stat.S_IMODE(destination.stat().st_mode) == 0o600
+
+
+@pytest.mark.platforms("posix")
+def test_partial_refuses_planted_symlink(tmp_path, umask_022, monkeypatch):
+    destination = tmp_path / "secret-backup.zip"
+    victim = tmp_path / "victim"
+    real_open = os.open
+
+    def plant_then_open(path, flags, mode=0o777, *args, **kwargs):
+        if str(path).endswith(".partial"):
+            os.symlink(victim, path)
+        return real_open(path, flags, mode, *args, **kwargs)
+
+    monkeypatch.setattr(os, "open", plant_then_open)
+    with pytest.raises(FileExistsError):
+        with _atomic_output_path(destination):
+            pass
+    monkeypatch.undo()
+    assert not victim.exists()
+    assert not destination.exists()
+
+
+@pytest.mark.platforms("posix")
+def test_pre_update_backup_owner_only_and_tightens_backups_dir(tmp_path, umask_022):
+    hermes_home = tmp_path / ".hermes"
+    hermes_home.mkdir()
+    (hermes_home / "config.yaml").write_text("model:\n  provider: openrouter\n")
+    (hermes_home / "auth.json").write_text('{"token": "sk-test"}\n')
+
+    out = create_pre_update_backup(hermes_home=hermes_home)
+    backup_dir = hermes_home / "backups"
+    assert out is not None
+    assert stat.S_IMODE(backup_dir.stat().st_mode) == 0o700
+    assert stat.S_IMODE(out.stat().st_mode) == 0o600
+
+    backup_dir.chmod(0o755)
+    out.unlink()
+    out2 = create_pre_update_backup(hermes_home=hermes_home)
+    assert out2 is not None
+    assert stat.S_IMODE(backup_dir.stat().st_mode) == 0o700
+    assert stat.S_IMODE(out2.stat().st_mode) == 0o600
diff --git a/tests/hermes_cli/test_cli_interrupt_input_not_persisted.py b/tests/hermes_cli/test_cli_interrupt_input_not_persisted.py
new file mode 100644
index 0000000000..4b1609f6fd
--- /dev/null
+++ b/tests/hermes_cli/test_cli_interrupt_input_not_persisted.py
@@ -0,0 +1,71 @@
+"""Text typed while a turn runs must not land in plaintext files under HERMES_HOME (#75461).
+
+Users paste credentials into the prompt (bot tokens during platform setup). The interrupt
+paths used to append the raw message to ``interrupt_debug.log`` with ``open().write()``,
+bypassing the logging module's RedactingFormatter.
+"""
+
+from __future__ import annotations
+
+import queue
+from unittest.mock import patch
+
+from agent.onboarding import BUSY_INPUT_FLAG
+from tests.hermes_cli.test_cli_interrupt_ack_race import _make_cli, _StubAgent
+
+SECRET = "1234567890:" + "A" * 35  # Telegram bot-token shape, synthetic
+
+
+def _files_containing(root, needle):
+    return [p for p in root.rglob("*") if p.is_file() and needle in p.read_text(errors="ignore")]
+
+
+def test_interrupt_fired_during_chat_does_not_persist_the_message(tmp_path):
+    cli = _make_cli()
+    agent = _StubAgent(cli.session_id)
+    cli.agent = agent
+    cli._interrupt_queue = queue.Queue()
+    cli._pending_input = queue.Queue()
+    cli._interrupt_queue.put(f"my token is {SECRET}")
+
+    import cli as cli_mod
+
+    with patch.object(cli_mod, "_hermes_home", tmp_path), \
+         patch.object(cli, "_ensure_runtime_credentials", return_value=True), \
+         patch.object(cli, "_resolve_turn_agent_config", return_value={
+             "signature": cli._active_agent_route_signature,
+             "model": None, "runtime": None, "request_overrides": None,
+         }), \
+         patch.object(cli, "_init_agent", return_value=True):
+        cli.chat("original")
+
+    assert agent.interrupt_calls == [f"my token is {SECRET}"]
+    assert _files_containing(tmp_path, SECRET) == []
+
+
+def test_enter_while_busy_interrupt_does_not_persist_the_message(tmp_path):
+    import cli as cli_mod
+
+    shell = object.__new__(cli_mod.HermesCLI)
+    shell.busy_input_mode = "interrupt"
+    shell.agent = None  # no redirect support -> legacy interrupt queue
+    shell._agent_running = True
+    shell._pending_input, shell._interrupt_queue = queue.Queue(), queue.Queue()
+    config = {"onboarding": {"seen": {BUSY_INPUT_FLAG: True}}}
+
+    with patch.object(cli_mod, "_hermes_home", tmp_path), patch.dict(cli_mod.__dict__, {"CLI_CONFIG": config}):
+        shell._tui_enter_while_busy(SECRET, [], SECRET)
+
+    assert shell._interrupt_queue.get_nowait() == SECRET
+    assert _files_containing(tmp_path, SECRET) == []
+
+
+def test_no_tip_points_users_at_the_removed_debug_file():
+    """The startup tips must not send users to ``interrupt_debug.log``: nothing writes it now."""
+    from agent import i18n
+    from agent.i18n import t
+    from hermes_cli import tips
+
+    stale = [(lang, key) for lang in i18n.supported_languages() for key in tips.tip_keys()
+             if "interrupt_debug.log" in t(key, lang=lang)]
+    assert stale == []
diff --git a/tests/hermes_cli/test_config_copy_permissions.py b/tests/hermes_cli/test_config_copy_permissions.py
new file mode 100644
index 0000000000..b1a037b2e5
--- /dev/null
+++ b/tests/hermes_cli/test_config_copy_permissions.py
@@ -0,0 +1,112 @@
+"""config.yaml copies made outside the config writer drop world access too (#59726).
+
+Restores, imports, clones and distribution installs publish a config.yaml with copy2 or an
+atomic extract that keeps the old/source mode, so each must narrow it the way the writer does.
+"""
+
+import os
+import stat
+import zipfile
+from argparse import Namespace
+from pathlib import Path
+
+import pytest
+
+import hermes_constants
+
+pytestmark = pytest.mark.platforms("posix")  # POSIX permission bits
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    for name in ("HERMES_MANAGED", "HERMES_CONTAINER", "HERMES_SKIP_CHMOD"):
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setattr(hermes_constants, "_detect_container", lambda: False)
+    (home / "config.yaml").write_text("model:\n  default: old\n", encoding="utf-8")
+    os.chmod(home / "config.yaml", 0o666)
+    return home
+
+
+def _mode(path):
+    return stat.S_IMODE(path.stat().st_mode)
+
+
+def test_snapshot_restore(home):
+    from hermes_cli.backup import create_quick_snapshot, restore_quick_snapshot
+    snap_id = create_quick_snapshot(hermes_home=home)
+    snap_config = home / "state-snapshots" / snap_id / "config.yaml"
+    os.chmod(snap_config, 0o666)  # a snapshot taken while the file was wide
+
+    assert restore_quick_snapshot(snap_id, hermes_home=home)
+
+    assert _mode(home / "config.yaml") == 0o660
+
+
+def test_backup_import(home, tmp_path, monkeypatch):
+    from hermes_cli import backup
+    monkeypatch.setattr(backup, "_revive_gateway_after_import", lambda _root: None)
+    archive = tmp_path / "backup.zip"
+    with zipfile.ZipFile(archive, "w") as zf:
+        zf.writestr("config.yaml", "model:\n  default: imported\n")
+
+    backup.run_import(Namespace(zipfile=str(archive), force=True))
+
+    assert "imported" in (home / "config.yaml").read_text(encoding="utf-8")
+    assert _mode(home / "config.yaml") == 0o660
+
+
+def test_profile_clone(home):
+    from hermes_cli.config import DEFAULT_CONFIG
+    from hermes_cli.profiles import create_profile
+    # Current version: no migration rewrite (save_config) runs on the clone.
+    (home / "config.yaml").write_text(f"_config_version: {DEFAULT_CONFIG['_config_version']}\n", encoding="utf-8")
+
+    profile_dir = create_profile("coder", clone_config=True, no_alias=True)
+
+    assert _mode(profile_dir / "config.yaml") == 0o660
+
+
+def test_distribution_install(home, tmp_path):
+    from hermes_cli.profile_distribution import DistributionManifest, install_distribution, write_manifest
+    staged = tmp_path / "staged"
+    staged.mkdir()
+    (staged / "config.yaml").write_text("model:\n  default: dist\n", encoding="utf-8")
+    os.chmod(staged / "config.yaml", 0o666)
+    write_manifest(staged, DistributionManifest(name="dist"))
+
+    plan = install_distribution(str(staged), name="dist")
+
+    assert _mode(plan.target_dir / "config.yaml") == 0o660
+
