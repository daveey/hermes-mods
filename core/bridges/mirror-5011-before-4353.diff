@@ -1,5 +1,6 @@
 """MarkdownV2 / rich-markdown conversion contracts, judged by the Bot API stand-in's parser."""
 
+import re
 import time
 
 import pytest
@@ -222,3 +223,129 @@ def test_link_shaped_text_inside_a_code_span_stays_verbatim(span):
     from plugins.platforms.telegram.telegram_markdown import degrade_unrenderable_links
 
     assert degrade_unrenderable_links(f"use {span} then [x](y)") == f"use {span} then x"
+
+
+@pytest.mark.parametrize("url", [
+    "http://127.0.0.1:5173/?token=abc123",
+    "https://web.archive.org/web/*/example.com/*",
+    "http://h.example/p?t=a*b*c",
+    "https://x.example/a~~b~~c",
+    "http://h.example/x||y||z",
+    "https://example.com/a*;b*c",
+    "https://example.com/a**,b**c",
+    "https://example.com/a*;b*c*",
+    "https://x.example/a~~;b~~c~~",
+])
+def test_bare_url_reaches_the_chat_as_literal_text(adapter, url):
+    """Every char of a bare URL is escaped, so * ~ || inside it never become italic/strike/spoiler."""
+    import re
+    out = adapter.format_message(f"Open {url} now")
+    assert mdv2_error(out) is None
+    assert re.sub(r"\\(.)", r"\1", out) == f"Open {url} now"
+    assert re.search(r"(?<!\\)[*_~|]", out) is None
+    italic = adapter.format_message(f"*Open {url} now*")
+    assert mdv2_error(italic) is None and url in re.sub(r"\\(.)", r"\1", italic[1:-1])
+
+
+@pytest.mark.parametrize("wrapped, rendered", [
+    ("*https://example.com/*", "_https://example\\.com/_"),
+    ("**https://example.com/**", "*https://example\\.com/*"),
+    ("~~https://example.com/~~", "~https://example\\.com/~"),
+    ("**bold https://example.com/**", "*bold https://example\\.com/*"),
+    ("*see https://x.com/docs/*", "_see https://x\\.com/docs/_"),
+    ("*https://a.example/* and *https://b.example/*", "_https://a\\.example/_ and _https://b\\.example/_"),
+    ("**x https://a.example/** y **z**", "*x https://a\\.example/* y *z*"),
+    ("*Open https://archive.example/web/* now* and https://b.example/*",
+     "_Open https://archive\\.example/web/\\* now_ and https://b\\.example/\\*"),
+    ("*See https://a.example/x and https://b.example/*", "_See https://a\\.example/x and https://b\\.example/_"),
+    ('"*https://example.com/*"', '"_https://example\\.com/_"'),
+    ('"**https://example.com/**"', '"*https://example\\.com/*"'),
+    ('"~~https://example.com/~~"', '"~https://example\\.com/~"'),
+])
+def test_emphasis_wrapping_a_url_that_ends_in_slash_still_renders(adapter, wrapped, rendered):
+    """A trailing mark after ``/`` is URL text (``/web/*``) unless it closes emphasis opened before the URL."""
+    out = adapter.format_message(f"see {wrapped} ok")
+    assert mdv2_error(out) is None
+    assert out == f"see {rendered} ok"
+
+
+@pytest.mark.parametrize("wrapped, rendered", [
+    ("**See\nhttps://example.com/**", "*See\nhttps://example\\.com/*"),
+    ("*outer **https://example.com/** end*", "_outer *https://example\\.com/* end_"),
+    ("**https://example.com**—next", "*https://example\\.com*—next"),
+    ("[**https://x.example/**]", "\\[*https://x\\.example/*\\]"),
+    ("~~https://x.example/a~~,next", "~https://x\\.example/a~,next"),
+    ("**https://x/a**,next", "*https://x/a*,next"),
+    ("**https://example.com/a**,next**word**", "*https://example\\.com/a*,next*word*"),
+    ("*Open https://example.com/a*;b*c* now*", "_Open https://example\\.com/a\\*;b\\*c\\* now_"),
+    # A URL run closes part of a mixed opener run, as the renderer's own star pairing does.
+    ("***bold* https://example.com/**", "*_bold_ https://example\\.com/*"),
+    ("***a** https://x/y*", "_*a* https://x/y_"),
+    ("**a *b https://x/c* d**", "*a _b https://x/c_ d*"),
+    ("**rm *x https://x/y**", "*rm \\*x https://x/y*"),
+    # A backslash-escaped star is URL text; only the marks after it may close (as on main).
+    (r"***Docs https://ex.com/a\** now", r"\*\*_Docs https://ex\.com/a\\\*_ now"),
+    (r"***see https://ex.com/\**, ok", r"\*\*_see https://ex\.com/\\\*_, ok"),
+    (r"**x https://ex.com/a\** z", r"\*_x https://ex\.com/a\\\*_ z"),
+    (r"**a *x https://ex.com/\*** z", r"*a \*x https://ex\.com/\\\** z"),
+])
+def test_emphasis_around_a_url_pairs_as_around_any_word(adapter, wrapped, rendered):
+    """Bold across a newline, nested emphasis and a closer with prose right after it pair as they
+    would around plain text: the URL stash never turns a real delimiter into URL text."""
+    out = adapter.format_message(wrapped)
+    assert mdv2_error(out) is None
+    assert out == rendered
+
+
+def _url_survives(text: str, url: str, out: str) -> bool:
+    """*url* reaches the chat whole (every mark escaped), or ends at a mark run that closes emphasis
+    opened before it: its text up to that run (a backslash-escaped first mark included) shows
+    contiguous and escaped, the run renders as the closer, and what follows the run is prose again."""
+    esc = telegram_markdown._escape_mdv2
+    if esc(url) in out:
+        return True
+    opened = text[:text.index(url)]
+
+    def cut(run) -> int:  # a backslash-escaped first mark is URL text: the closer starts after it
+        slashes = len(url[:run.start()]) - len(url[:run.start()].rstrip("\\"))
+        return run.start() + slashes % 2
+
+    return any(run.group()[0] in opened and cut(run) < run.end()
+               and re.search(re.escape(esc(url[:cut(run)])) + r"[*_~|]", out)
+               for run in re.finditer(r"[*~|]+", url))
+
+
+_URL_SHAPES = [f"a{m}{p}b{m}c{t}" for m in ("*", "**", "~~", "||") for p in ".,;:!?)" for t in ("", m)]
+# a backslash-escaped mark inside or at the end of a URL is URL text, never an emphasis closer
+_URL_SHAPES += [rf"a\{m}{p}b\{m}c{t}" for m in ("*", "**", "~~", "||") for p in ".," for t in ("", "\\" + m, m)]
+_URL_WRAPPERS = ["{}", "Open {} now", "*{}*", "**{}**", "~~{}~~", "||{}||", '"{}"', "*Open {} now*",
+                 "**see\n{}**", "*x* {} *y*", "{}, then **b**"]
+
+
+@pytest.mark.parametrize("wrapper", _URL_WRAPPERS)
+def test_no_bare_url_loses_a_character_to_formatting(wrapper):
+    """Property over every internal-punctuation URL shape: a mark inside a URL is URL text unless it
+    closes emphasis opened outside the URL, so no URL character is dropped or turned into formatting."""
+    for shape in _URL_SHAPES:
+        url = "https://example.com/" + shape
+        text = wrapper.format(url)
+        out = telegram_markdown.to_markdown_v2(text)
+        assert mdv2_error(out) is None, text
+        assert _url_survives(text, url, out), (text, out)
+
+
+@pytest.mark.parametrize("unit", ["https://example.com/a ", "**see https://x.example/web/** ok "])
+def test_many_bare_urls_format_in_linear_time(unit):
+    """Placeholder restoration is one pass, not one whole-message scan per URL, and deciding
+    ``/``-ended mark runs is budgeted: 10x the URLs costs about 10x the time (a per-URL scan ~100x)."""
+    def best(n: int) -> float:
+        text = unit * n
+        runs = []
+        for _ in range(3):
+            start = time.perf_counter()
+            telegram_markdown.to_markdown_v2(text)
+            runs.append(time.perf_counter() - start)
+        return min(runs)
+
+    small, large = best(2_000), best(20_000)
+    assert large < 40 * small + 0.5
diff --git a/tests/plugins/platforms/test_live_allowlist_host_profile.py b/tests/plugins/platforms/test_live_allowlist_host_profile.py
new file mode 100644
index 0000000000..5b98fe78c3
--- /dev/null
+++ b/tests/plugins/platforms/test_live_allowlist_host_profile.py
@@ -0,0 +1,358 @@
+"""A multiplexed gateway's host (launch) profile follows its own config.yaml allowlist edits.
+
+Once the gateway multiplexes, the host profile's work runs under its bound scope, whose gate env is
+``launch_secret_scope``: the env frozen at activation plus ``.env``. These tests freeze that env the way
+activation does, edit the host's config.yaml, and judge the next event under that scope: a removed user
+or a retracted ``allow_all_users`` grant is refused, while an operator's value (frozen env or ``.env``)
+still wins, a failed load keeps the last good lists, and a secondary profile's mapping is never touched.
+"""
+
+import os
+
+import pytest
+
+from gateway.config import Platform, load_gateway_config
+from tests.plugins.platforms.test_live_allowlist_edits import GATE_VARS, USER_ID, _allowed, _connected_discord, _write
+
+
+@pytest.fixture(autouse=True)
+def _home(tmp_path, monkeypatch):
+    home = tmp_path / "default"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    for var in GATE_VARS:  # setenv first so teardown also removes what the loader bridges in
+        for name in (var, f"HERMES_BRIDGED_{var}"):
+            monkeypatch.setenv(name, "")
+            monkeypatch.delenv(name)
+    from gateway import config_loader
+    monkeypatch.setattr(config_loader, "_BRIDGED_ALLOW_ALL_USERS", False)
+    return home
+
+
+@pytest.fixture
+def multiplexed():
+    from agent.secret_scope import reset_multiplex_context, set_multiplex_context
+    token = set_multiplex_context(True)
+    yield
+    reset_multiplex_context(token)
+
+
+def _telegram(home):
+    from gateway.platforms._shared import mark_live_gate_baseline
+    from plugins.platforms.telegram.adapter import TelegramAdapter
+    adapter = TelegramAdapter(load_gateway_config().platforms[Platform.TELEGRAM])
+    mark_live_gate_baseline(adapter)
+    return adapter
+
+
+def _freeze():
+    """Activation: the launch env is frozen with the bridged lists of that moment."""
+    import tui_gateway.launch_profile_policy as lpp
+    lpp.capture_launch_env()
+
+
+def _decision_under_host_scope(home, user_id):
+    from gateway.run import _profile_runtime_scope
+    from plugins.platforms.telegram.telegram_live_gates import env_allowlist_decision
+    with _profile_runtime_scope(home):
+        return env_allowlist_decision(user_id)
+
+
+# Repro tests by BearHuddleston (#154562 review).
+def test_a_multiplexed_launch_profiles_removed_user_is_refused_under_its_own_scope(_home):
+    from agent.secret_scope import reset_multiplex_context, set_multiplex_context
+    from gateway.run import _profile_runtime_scope
+
+    _write(_home, {"allow_from": [str(USER_ID), "777"]})
+    adapter, guild, member = _connected_discord(roles=())
+    _freeze()
+    token = set_multiplex_context(True)
+    try:
+        _write(_home, {"allow_from": ["777"]})
+        with _profile_runtime_scope(_home):  # the scope is bound BEFORE the reload sees the edit
+            verdict = _allowed(adapter, guild, member)
+    finally:
+        reset_multiplex_context(token)
+    assert verdict is False
+
+
+def test_a_multiplexed_launch_profiles_removed_telegram_user_is_refused_by_the_runner_gate(_home, multiplexed):
+    from plugins.platforms.telegram.telegram_live_gates import refresh_telegram_gates
+
+    _write(_home, telegram_cfg={"allow_from": ["111", "222"]})
+    adapter = _telegram(_home)
+    _freeze()
+    _write(_home, telegram_cfg={"allow_from": ["111"]})
+    refresh_telegram_gates(adapter)
+    assert _decision_under_host_scope(_home, "222") is False
+    assert _decision_under_host_scope(_home, "111") is True
+
+
+def test_a_retracted_allow_all_grant_is_gone_under_the_host_scope(_home, multiplexed):
+    from gateway.platforms._shared import platform_gate_env
+    from gateway.run import _profile_runtime_scope
+
+    (_home / "config.yaml").write_text("allow_all_users: true\nplatforms: {discord: {enabled: true}}\n", encoding="utf-8")
+    adapter, _guild, _member = _connected_discord(roles=())
+    _freeze()
+    with _profile_runtime_scope(_home):
+        assert platform_gate_env("GATEWAY_ALLOW_ALL_USERS") == "true"
+        _write(_home, {"allow_from": ["777"]})
+        adapter._refresh_live_gates()  # seen inside a body that bound the scope before the edit
+        in_body = platform_gate_env("GATEWAY_ALLOW_ALL_USERS")
+    with _profile_runtime_scope(_home):
+        next_body = platform_gate_env("GATEWAY_ALLOW_ALL_USERS")
+    assert (in_body, next_body) == ("", "")
+
+
+def test_the_host_profiles_dotenv_value_still_wins_over_a_yaml_edit(_home, multiplexed):
+    from plugins.platforms.telegram.telegram_live_gates import refresh_telegram_gates
+
+    from gateway.run import _profile_runtime_scope
+    from plugins.platforms.telegram.telegram_live_gates import env_allowlist_decision
+
+    (_home / ".env").write_text("TELEGRAM_ALLOWED_USERS=111,222\n", encoding="utf-8")
+    _write(_home, telegram_cfg={"allow_from": ["111", "222"]})
+    adapter = _telegram(_home)
+    _freeze()
+    _write(_home, telegram_cfg={"allow_from": ["111"]})
+    with _profile_runtime_scope(_home):
+        refresh_telegram_gates(adapter)
+        in_body = env_allowlist_decision("222")
+    assert (in_body, _decision_under_host_scope(_home, "222")) == (True, True)
+
+
+def test_a_frozen_operator_value_is_not_replaced_by_a_later_bridged_one(_home, multiplexed, monkeypatch):
+    """An env-only operator value (systemd ``Environment=``, ``op run``) lives only in the frozen env. If
+    the live env later loses it and the bridge writes the YAML list there, the host still uses the
+    operator's: live process env never overrides a frozen value the bridge did not own."""
+    from plugins.platforms.telegram.telegram_live_gates import refresh_telegram_gates
+
+    monkeypatch.setenv("TELEGRAM_ALLOWED_USERS", "999")
+    _write(_home, telegram_cfg={"allow_from": ["111"]})
+    adapter = _telegram(_home)
+    assert os.environ["TELEGRAM_ALLOWED_USERS"] == "999"  # the operator's value wins at startup
+    _freeze()
+    monkeypatch.delenv("TELEGRAM_ALLOWED_USERS")
+    _write(_home, telegram_cfg={"allow_from": ["111", "222"]})
+    refresh_telegram_gates(adapter)
+    assert os.environ["TELEGRAM_ALLOWED_USERS"] == "111,222"  # the bridge now owns the live value
+    assert (_decision_under_host_scope(_home, "999"), _decision_under_host_scope(_home, "222")) == (True, False)
+
+
+@pytest.mark.parametrize("drop_marker", [True, False])
+def test_a_frozen_bridged_list_the_bridge_did_not_retract_is_kept(_home, multiplexed, monkeypatch, drop_marker):
+    """Only the bridge's own retraction (name and marker both gone) drops a frozen bridged list. A live
+    value some other writer left, without a marker or over the bridge's stale one, is not evidence the
+    list was removed or replaced: dropping it would leave the host with no list at all, which an
+    allowlist-less gate reads as open."""
+    _write(_home, telegram_cfg={"allow_from": ["111"]})
+    _telegram(_home)
+    _freeze()
+    monkeypatch.setenv("TELEGRAM_ALLOWED_USERS", "333")
+    if drop_marker:
+        monkeypatch.delenv("HERMES_BRIDGED_TELEGRAM_ALLOWED_USERS")
+    assert (_decision_under_host_scope(_home, "111"), _decision_under_host_scope(_home, "333")) == (True, False)
+
+
+def test_an_operator_allow_all_grant_survives_the_host_scope(_home, multiplexed, monkeypatch):
+    """GATEWAY_ALLOW_ALL_USERS from the gateway's own environment (systemd, ``op run``) is not the
+    bridge's grant: following the bridge never revokes it."""
+    from gateway.platforms._shared import platform_gate_env
+    from gateway.run import _profile_runtime_scope
+
+    monkeypatch.setenv("GATEWAY_ALLOW_ALL_USERS", "true")
+    _write(_home, telegram_cfg={"allow_from": ["111"]})
+    _telegram(_home)
+    _freeze()
+    with _profile_runtime_scope(_home):
+        assert platform_gate_env("GATEWAY_ALLOW_ALL_USERS") == "true"
+
+
+def test_a_failed_host_reload_keeps_the_last_good_list(_home, multiplexed):
