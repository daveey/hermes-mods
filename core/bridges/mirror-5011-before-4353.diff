+    ("hermes_cli/windows_ssh_runtime.py", 'launches_module = logical_argv[1:3] == ["-m", "hermes_cli.main"]'),
+    ("hermes_state_holders.py", "_HERMES_PYTHON_MODULES = frozenset({"),
