diff --git a/tests/providers/test_provider_plugin_update.py b/tests/providers/test_provider_plugin_update.py
new file mode 100644
index 0000000000..ea856bde11
--- /dev/null
+++ b/tests/providers/test_provider_plugin_update.py
@@ -0,0 +1,135 @@
+"""An updated ``$HERMES_HOME`` provider plugin is swapped in whole by the forced plugin sweep.
+
+Regression for #153300: a provider plugin was imported once per process and never again, so an update reached
+a running gateway only through files the plugin imported lazily (inside ``create_client``), which then ran
+against siblings still loaded from the old tree ("cannot import name ..."). The update surfaces meanwhile said
+nothing of the plugin needed a restart.
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import sys
+import textwrap
+from pathlib import Path
+
+import pytest
+
+_INIT = textwrap.dedent("""
+    from providers import register_provider
+    from providers.base import ProviderProfile
+    from .setup import fn  # imported at load, like the DirectSDK plugin's directsdk_setup
+
+    class Profile(ProviderProfile):
+        def create_client(self, **kw):
+            from .client import Client  # imported on first use, like `from .directsdk import Client`
+            return Client(**kw)
+
+    register_provider(Profile(name="demo-provider", aliases=ALIASES,
+                              base_url="process://demo-provider", auth_type="external_process"))
+""")
+
+
+def _write(plugin: Path, version: int, *, extra: bool = False, broken: bool = False) -> None:
+    """One release of the demo plugin; ``extra`` also registers a second profile and a second alias, ``broken``
+    raises at import after loading its ``setup`` submodule."""
+    plugin.mkdir(parents=True, exist_ok=True)
+    (plugin / "plugin.yaml").write_text(f"name: demo-provider\nkind: model-provider\nversion: {version}.0\n")
+    (plugin / "setup.py").write_text(f"def fn():\n    return 'v{version}'\n")
+    # A client file from one release running against another release's ``setup`` reports "mixed".
+    (plugin / "client.py").write_text(
+        f"from .setup import fn\nclass Client:\n    def __init__(self, **kw):\n"
+        f"        self.version = fn() if fn() == 'v{version}' else 'mixed'\n")
+    tail = ""
+    if extra:
+        tail += ('register_provider(ProviderProfile(name="demo-extra", base_url="process://demo-extra", '
+                 'auth_type="external_process"))\n')
+    if broken:
+        tail += "raise RuntimeError('broken release')\n"
+    aliases = ("demo-alias", "demo-old") if extra else ("demo-alias",)
+    (plugin / "__init__.py").write_text(f"ALIASES = {aliases!r}\n" + _INIT + tail)
+    # Every release gets newer files than the last, as an update writes them.
+    stamp = (version + 1) * 10**12
+    for path in plugin.rglob("*"):
+        if path.is_file():
+            os.utime(path, ns=(stamp, stamp))
+    shutil.rmtree(plugin / "__pycache__", ignore_errors=True)
+
+
+def _reset_providers():
+    import providers
+
+    providers._REGISTRY.clear()
+    providers._ALIASES.clear()
+    providers._HOME_LAYERS.clear()
+    providers._PROVIDER_LIST_CACHE = None
+    providers._discovered = False
+    for mod in [m for m in sys.modules if m.startswith("_hermes_user_provider")]:
+        del sys.modules[mod]
+
+
+@pytest.fixture
+def plugin(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    _reset_providers()
+    yield tmp_path / "plugins" / "demo-provider"
+    _reset_providers()
+
+
+def _forced_sweep():
+    """What the gateway's ``reload-plugins`` verb runs after an install / enable / update."""
+    from hermes_cli.plugins import PluginManager
+
+    manager = PluginManager()
+    manager.discover_and_load(force=True)
+    return manager
+
+
+@pytest.mark.parametrize("isolation", ["in-process", "host"])
+def test_an_update_serves_new_sessions_whole_while_old_clients_stay_on_their_version(plugin, isolation):
+    # Under ``host`` the demo profile overrides create_client, so it is one of the profiles the plugin host
+    # hands back to the gateway process: the same lazy import, through the hosted path.
+    from providers import get_provider_profile
+
+    (plugin.parent.parent / "config.yaml").write_text(f"plugins:\n  isolation: {isolation}\n", encoding="utf-8")
+    _write(plugin, 1, extra=True)
+    before = get_provider_profile("demo-provider")  # loaded, but its lazy ``client`` not imported yet
+    assert get_provider_profile("demo-extra") is not None and get_provider_profile("demo-old") is before
+
+    _write(plugin, 2)
+    _forced_sweep()
+
+    assert get_provider_profile("demo-provider").create_client().version == "v2"
+    assert get_provider_profile("demo-alias") is get_provider_profile("demo-provider")
+    # A profile and an alias the new release dropped are gone.
+    assert get_provider_profile("demo-extra") is None and get_provider_profile("demo-old") is None
+    # An agent still holding the old profile imports its lazy file for the first time now: still v1, no mix.
+    assert before.create_client().version == "v1"
+
+
+def test_a_broken_update_keeps_the_previous_version_and_says_so(plugin):
+    from hermes_cli.plugins_activation import activation_hint, find_activation, plugin_activation_summary
+    from providers import get_provider_profile
+    from tui_gateway.contracts.tools_mcp_plugins import PluginActivation
+
+    _write(plugin, 1)
+    get_provider_profile("demo-provider")
+
+    def update_to(version: int, **kw) -> dict:
+        _write(plugin, version, **kw)
+        manager = _forced_sweep()
+        key = next(k for k in manager._plugins if k.endswith("demo-provider"))
+        summary = find_activation([plugin_activation_summary(manager, key)], "demo-provider")
+        PluginActivation.model_validate(summary)  # the shape Desktop / TUI clients receive
+        return {"gateway_reloaded": True, "activation": summary}
+
+    assert "model provider (new sessions use this version)" in activation_hint(update_to(2))
+
+    hint = activation_hint(update_to(3, broken=True))
+    assert "failed to load (RuntimeError: broken release)" in hint and "previous version keeps serving" in hint
+    assert get_provider_profile("demo-provider").create_client().version == "v2"
+
+    # The fixed release after it loads clean: nothing the broken one half-imported is reused.
+    assert "new sessions use this version" in activation_hint(update_to(4))
+    assert get_provider_profile("demo-provider").create_client().version == "v4"
diff --git a/tests/scripts/install/test_mac_backend_health.py b/tests/scripts/install/test_mac_backend_health.py
new file mode 100644
index 0000000000..3abdd40db2
--- /dev/null
+++ b/tests/scripts/install/test_mac_backend_health.py
@@ -0,0 +1,92 @@
+"""The macOS upgrade arm waits for the relaunched app's backend wherever it runs.
+
+In rehearsal rc.5-v0.23.2 Squirrel.Mac installed 0.23.2 and relaunched the app, and the arm
+failed 6 s later with "could not discover the relaunched backend's listening port". It looked
+once, only among the app's children for a `serve` process. The relaunched app was still
+starting, and 0.23.2 runs its gateway as a launchd job (`osascript` -> `python3 -m hermes_cli.main
+gateway run`, parent pid 1), outside the app's process tree.
+"""
+
+import os
+from pathlib import Path
+import subprocess
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[3]
+HELPER = ROOT / "tests" / "install" / "e2e-assets" / "mac-backend-health.sh"
+PAYLOAD = "/Users/runner/apps/Hermes Agent.app/Contents/Resources/agent-payload"
+GATEWAY = f"{PAYLOAD}/tools/python-3.14/bin/python3 -m hermes_cli.main --profile default gateway run --quiet"
+
+# ps, lsof and curl read a process table: one "pid|etime|args|port|first poll it listens on|healthy" per line.
+FAKE_PS = r"""#!/usr/bin/env bash
+table="$FAKE_TABLE"
+if [ "$1" = "-o" ]; then
+  awk -F'|' -v p="$4" '$1 == p { print $2 }' "$table"
+else
+  awk -F'|' '{ printf "%6s %11s %s\n", $1, $2, $3 }' "$table"
+fi
+"""
+FAKE_LSOF = r"""#!/usr/bin/env bash
+pid=""
+while [ $# -gt 0 ]; do [ "$1" = "-p" ] && pid="$2"; shift; done
+echo x >> "$FAKE_POLLS.$pid"
+polls=$(wc -l < "$FAKE_POLLS.$pid")
+awk -F'|' -v p="$pid" -v n="$polls" '$1 == p && $4 != "" && n >= $5 { print "p" p; print "f9"; print "n127.0.0.1:" $4 }' "$FAKE_TABLE"
+"""
+FAKE_CURL = r"""#!/usr/bin/env bash
+out="" url=""
+while [ $# -gt 0 ]; do
+  case "$1" in -o) out="$2"; shift ;; http*) url="$1" ;; esac
+  shift
+done
+port="${url#http://127.0.0.1:}"; port="${port%%/*}"
+grep -q "^[^|]*|[^|]*|[^|]*|$port|[^|]*|yes$" "$FAKE_TABLE" || exit 7
+printf '{"status":"ok","port":%s}\n' "$port" > "$out"
+"""
+
+
+def _run(tmp_path: Path, rows: list[tuple], *, ref: int, timeout: int = 20):
+    bin_dir = tmp_path / "bin"
+    bin_dir.mkdir()
+    for name, body in (("ps", FAKE_PS), ("lsof", FAKE_LSOF), ("curl", FAKE_CURL)):
+        (bin_dir / name).write_text(body)
+        (bin_dir / name).chmod(0o755)
+    table = tmp_path / "table"
+    table.write_text("".join("|".join(str(field) for field in row) + "\n" for row in rows))
+    out = tmp_path / "backend-health.json"
+    env = {**os.environ, "PATH": f"{bin_dir}:{os.environ['PATH']}", "FAKE_TABLE": str(table),
+           "FAKE_POLLS": str(tmp_path / "polls")}
+    result = subprocess.run(
+        ["bash", str(HELPER), "--payload", PAYLOAD, "--newer-than", str(ref), "--timeout", str(timeout),
+         "--out", str(out)],
+        capture_output=True, text=True, timeout=timeout + 30, env=env, check=False,
+    )
+    return result, out
+
+
+@pytest.mark.platforms("posix")
+def test_waits_for_a_backend_outside_the_app_process_tree(tmp_path):
+    rows = [
+        (3884, "00:06", "/Users/runner/apps/Hermes Agent.app/Contents/MacOS/Hermes Agent", "", "", "no"),
+        (3968, "00:04", f"/usr/bin/osascript -l JavaScript -e exec {GATEWAY}", "", "", "no"),
+        (3971, "00:04", GATEWAY, 49512, 3, "yes"),
+        (1186, "05:12", "/opt/homebrew/bin/node feed-server.mjs", 49385, 1, "yes"),
+    ]
+    result, out = _run(tmp_path, rows, ref=3884)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.strip() == "49512"
+    assert '"port":49512' in out.read_text()
+
+
+@pytest.mark.platforms("posix")
+def test_a_payload_process_older_than_the_relaunch_does_not_count(tmp_path):
+    rows = [
+        (3884, "00:06", "/Users/runner/apps/Hermes Agent.app/Contents/MacOS/Hermes Agent", "", "", "no"),
+        (1750, "01:40", f"{PAYLOAD}/tools/python-3.14/bin/python3 -m hermes_cli.main serve", 49394, 1, "yes"),
+    ]
+    result, out = _run(tmp_path, rows, ref=3884, timeout=3)
+    assert result.returncode == 1
+    assert "newer than pid 3884 answered /api/health within 3s" in result.stderr
+    assert "hermes_cli.main serve" in result.stderr
+    assert not out.exists()
diff --git a/tests/scripts/install/test_windows_uia_buttons.py b/tests/scripts/install/test_windows_uia_buttons.py
index a1e4f734a2..96128cd142 100644
--- a/tests/scripts/install/test_windows_uia_buttons.py
+++ b/tests/scripts/install/test_windows_uia_buttons.py
@@ -5,6 +5,12 @@ Automation order. When the lookup took the first button matching any pattern,
 the driver re-opened About every 3 s and never re-checked after NEW was published,
 so the windows-packaged arm reported "You're running the latest version" on every
 stable claim (rehearsal rc.1-v0.23.2, v0.22.1 claims).
+
+It also finds App Installer's Update prompt wherever App Installer put it. The update check
+Windows runs when OLD launches leaves an App Installer window with no buttons open, and the
+prompt can open in that process or in a second one. Looking only at the first App Installer
+process and its first window, the driver missed the prompt on both runners and the arm
+failed with "Native update did not automatically relaunch" (rehearsal rc.5-v0.23.2).
 """
 from pathlib import Path
 import shutil
@@ -52,3 +58,51 @@ def test_main_window_opens_settings_and_a_shared_pattern_keeps_tree_order():
     assert _pick(["Minimize", "New chat", "Open settings"], NAVIGATION) == "Open settings#3"
     assert _pick(["Close settings", "About", "Collapse: About", "About"], NAVIGATION) == "About#2"
     assert _pick(["Minimize", "Close"], NAVIGATION) == "none"
+
+
+APP_INSTALLER = ["^Update$", "^Install$", "^(Reinstall|Update) .*"]
+
+
+def _pick_window(processes: list[tuple[int, list[list[str]]]]) -> str:
+    """Find-WindowButton over fake App Installer processes: (pid, windows), each window a list
+    of button names. Returns 'name@pid/window' (1-based window) or 'none'."""
+    powershell = shutil.which("powershell")
+    assert powershell, "Windows PowerShell 5.1 is part of every supported Windows"
+    windows = []
+    for pid, pid_windows in processes:
+        for number, names in enumerate(pid_windows, 1):
+            windows.append(
+                f"[pscustomobject]@{{ Pid = {pid}; Tag = '{pid}/{number}'; Names = {_ps_array(names)} }}")
+    script = (
+        "$ErrorActionPreference = 'Stop'; Add-Type -AssemblyName UIAutomationClient, UIAutomationTypes; "
+        f". '{HELPER}'; "
+        f"$windows = @({', '.join(windows)}); "
+        "foreach ($w in $windows) { "
+        "$w | Add-Member -MemberType ScriptMethod -Name FindAll -Value { param($scope, $condition) "
+        "@(foreach ($n in $this.Names) { [pscustomobject]@{ Tag = $this.Tag; Current = [pscustomobject]@{ Name = $n } } }) } }; "
+        "$root = [pscustomobject]@{ Windows = $windows }; "
+        "$root | Add-Member -MemberType ScriptMethod -Name FindAll -Value { param($scope, $condition) "
+        "@($this.Windows | Where-Object { $_.Pid -eq $condition.Value }) }; "
+        f"$hit = Find-WindowButton -Root $root -ProcessIds @({', '.join(str(pid) for pid, _ in processes)}) "
+        f"-Patterns {_ps_array(APP_INSTALLER)}; "
+        "if ($hit) { \"$($hit.Name)@$($hit.Element.Tag)\" } else { 'none' }"
+    )
+    result = subprocess.run([powershell, "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", script],
+                            capture_output=True, text=True, timeout=120, check=False)
+    assert result.returncode == 0, result.stdout + result.stderr
+    return result.stdout.strip()
+
+
+def test_app_installer_prompt_in_a_second_process_is_found():
+    launch_check = (3600, [[]])
+    prompt = (13444, [["Minimize", "Maximize", "Close", "Update", "Cancel"]])
+    assert _pick_window([launch_check, prompt]) == "Update@13444/1"
+
+
+def test_app_installer_prompt_beside_a_buttonless_window_is_found():
