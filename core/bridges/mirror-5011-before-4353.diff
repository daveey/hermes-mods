+    if get_managed_system() is not None or _container_or_chmod_skipped():
+        return
+    try:
+        mode = path.stat().st_mode & 0o7777
+        if mode & 0o007:
+            os.chmod(path, mode & ~0o007)
+    except (OSError, NotImplementedError):
