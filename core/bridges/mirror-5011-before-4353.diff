@@ -0,0 +1,24 @@
+"""The plugin host child recognises a provider object whichever module name its base was imported by."""
+from __future__ import annotations
+
+import sys
+import types
+
+from hermes_agent.compat import moves
+from hermes_cli import plugin_host_child, plugin_isolation
+
+
+def test_a_base_imported_under_its_moved_name_still_matches(monkeypatch):
+    """HOST_OBJECT_BASES lists the old module name; a plugin that imported the base by its current name
+    loaded only that name, and its provider object must still be recognised."""
+    current = types.ModuleType("test_provider_base_current")
+
+    class Base:
+        pass
+
+    current.Base = Base
+    monkeypatch.setitem(sys.modules, "test_provider_base_current", current)
+    monkeypatch.setitem(moves.MOVES, "test_provider_base_old", "test_provider_base_current")
+    monkeypatch.setattr(plugin_isolation, "HOST_OBJECT_BASES", {"probe": "test_provider_base_old:Base"})
+
+    assert plugin_host_child._provider_base(type("Impl", (Base,), {})()) is Base
diff --git a/tests/hermes_cli/test_plugin_idle_tasks.py b/tests/hermes_cli/test_plugin_idle_tasks.py
new file mode 100644
index 0000000000..ba40ea40fe
--- /dev/null
+++ b/tests/hermes_cli/test_plugin_idle_tasks.py
@@ -0,0 +1,169 @@
+"""ctx.register_idle_task: the curator's idle scheduler, for plugins."""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime, timedelta
+
+import pytest
+
+from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+from hermes_cli.plugins_idle_tasks import cmd_idle_tasks, load_state, registered_idle_tasks, run_plugin_idle_tasks
+
+T0 = datetime(2026, 10, 1, 12, 0, tzinfo=UTC)
+IDLE = 3 * 3600.0
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    return tmp_path
+
+
+def _ctx(name="wisdom"):
+    manager = PluginManager()
+    return manager, PluginContext(PluginManifest(name=name, source="user"), manager)
+
+
+def _poll(manager, now, idle=IDLE):
+    """One poll, waited out: ``{"<plugin>:<task>": last_status}`` for the runs it started."""
+    started = run_plugin_idle_tasks(idle_for_seconds=idle, manager=manager, now=now)
+    for worker in started.values():
+        worker.join(timeout=10)
+        assert not worker.is_alive()
+    tasks = registered_idle_tasks(manager)
+    return {key: load_state(tasks[key].state_path())["last_status"] for key in started}
+
+
+def _recorder(calls, result="checked 3 skills"):
+    def fn(run):
+        calls.append(run)
+        return result
+    return fn
+
+
+def test_first_poll_seeds_and_defers_one_interval_then_runs_on_the_interval(home):
+    manager, ctx = _ctx()
+    calls = []
+    ctx.register_idle_task("suggest", _recorder(calls), interval_hours=24)
+
+    assert _poll(manager, T0) == {}
+    state = load_state(ctx.state.data_dir / "idle-tasks" / "suggest.json")
+    assert state["last_run_at"] == T0.isoformat() and state["run_count"] == 0 and not calls
+
+    assert _poll(manager, T0 + timedelta(hours=23)) == {}
+    assert _poll(manager, T0 + timedelta(hours=24)) == {"wisdom:suggest": "ok"}
+    assert len(calls) == 1
+    run = calls[0]
+    assert (run.name, run.idle_for_seconds, run.last_run_at, run.run_count) == ("suggest", IDLE, T0.isoformat(), 0)
+
+    state = load_state(ctx.state.data_dir / "idle-tasks" / "suggest.json")
+    assert (state["run_count"], state["last_status"], state["last_summary"]) == (1, "ok", "checked 3 skills")
+    assert _poll(manager, T0 + timedelta(hours=25)) == {}
+
+
+def test_immediate_first_run_and_min_idle_gate(home):
+    manager, ctx = _ctx()
+    calls = []
+    ctx.register_idle_task("suggest", _recorder(calls), interval_hours=24, min_idle_hours=2, first_run="immediate")
+
+    assert _poll(manager, T0, idle=3600.0) == {}  # host active one hour ago: not idle long enough
+    assert _poll(manager, T0) == {"wisdom:suggest": "ok"}
+    assert calls[0].last_run_at is None
+
+
+def test_registration_validates_and_floors_the_interval(home):
+    manager, ctx = _ctx()
+    for bad in ({"name": "Bad Name"}, {"first_run": "now"}, {"fn": "not callable"}, {"interval_hours": "weekly"},
+                {"interval_hours": float("inf")}, {"interval_hours": float("nan")},
+                {"min_idle_hours": float("inf")}, {"min_idle_hours": float("nan")}):
+        kwargs = {"name": "ok", "fn": _recorder([]), "interval_hours": 24} | bad
+        with pytest.raises(ValueError):
+            ctx.register_idle_task(kwargs.pop("name"), kwargs.pop("fn"), **kwargs)
+
+    calls = []
+    ctx.register_idle_task("tight", _recorder(calls), interval_hours=0.001, first_run="immediate")
+    assert _poll(manager, T0) == {"wisdom:tight": "ok"}
+    assert _poll(manager, T0 + timedelta(minutes=59)) == {}  # floored to one hour
+    assert _poll(manager, T0 + timedelta(hours=1)) == {"wisdom:tight": "ok"}
+
+
+def test_pause_and_resume_from_the_cli(home, capsys):
+    manager, ctx = _ctx()
+    calls = []
+    ctx.register_idle_task("suggest", _recorder(calls), interval_hours=1, first_run="immediate")
+    _poll(manager, T0)
+
+    cmd_idle_tasks("wisdom", pause="suggest")
+    assert _poll(manager, T0 + timedelta(hours=5)) == {}
+    cmd_idle_tasks()
+    assert "wisdom:suggest  paused  runs=1" in capsys.readouterr().out
+
+    cmd_idle_tasks("wisdom", resume="suggest")
+    assert _poll(manager, T0 + timedelta(hours=5)) == {"wisdom:suggest": "ok"}
+    with pytest.raises(SystemExit):
+        cmd_idle_tasks("wisdom", pause="missing")
+
+
+def test_a_run_never_overlaps_itself(home):
+    manager, ctx = _ctx()
+    nested = []
+
+    def fn(run):
+        nested.append(_poll(manager, T0 + timedelta(hours=5)))  # a second poller while this run holds the claim
+
+    ctx.register_idle_task("suggest", fn, interval_hours=1, first_run="immediate")
+    assert _poll(manager, T0) == {"wisdom:suggest": "ok"}
+    assert nested == [{}]
+
+    lock = ctx.state.data_dir / "idle-tasks" / ".suggest.lock"
+    lock.write_text("4242")  # another process holds it
+    assert _poll(manager, T0 + timedelta(hours=5)) == {}
+    lock.unlink()
+    assert _poll(manager, T0 + timedelta(hours=5)) == {"wisdom:suggest": "ok"}
+
+
+def test_a_failing_task_is_contained_and_recorded(home):
+    manager, ctx = _ctx()
+    other = []
+
+    def boom(run):
+        raise RuntimeError("model unreachable")
+
+    ctx.register_idle_task("boom", boom, interval_hours=1, first_run="immediate")
+    ctx.register_idle_task("fine", _recorder(other), interval_hours=1, first_run="immediate")
+
+    assert _poll(manager, T0) == {"wisdom:boom": "error", "wisdom:fine": "ok"}
+    state = load_state(ctx.state.data_dir / "idle-tasks" / "boom.json")
+    assert state["last_status"] == "error" and "model unreachable" in state["last_error"]
+    assert state["run_count"] == 1 and len(other) == 1
+
+
+def test_profile_scoping_and_disposal(home, tmp_path):
+    manager, ctx = _ctx()
+    calls = []
+    registration = ctx.register_idle_task("suggest", _recorder(calls), interval_hours=1, first_run="immediate")
+
+    elsewhere = PluginManager(scope_key=str(tmp_path / "profiles" / "coder"))
+    PluginContext(PluginManifest(name="wisdom", source="user"), elsewhere).register_idle_task(
+        "suggest", _recorder(calls), interval_hours=1, first_run="immediate")
+    assert _poll(elsewhere, T0) == {}  # another profile's manager runs nothing under this home
+    assert not calls
+
+    assert _poll(manager, T0) == {"wisdom:suggest": "ok"}
+    assert (home / "plugin-data").is_dir() and ctx.state.data_dir.is_relative_to(home)
+
+    registration.dispose()
+    assert _poll(manager, T0 + timedelta(hours=5)) == {}
+
+
+def test_the_gateway_idle_poll_runs_the_curator_and_the_plugin_tasks(home, monkeypatch):
+    import agent.curator
+    from gateway import run as gateway_run
+    from hermes_cli import plugins_idle_tasks
+
+    seen = []
+    monkeypatch.setattr(agent.curator, "maybe_run_curator", lambda **kw: seen.append(("curator", kw["idle_for_seconds"])))
+    monkeypatch.setattr(plugins_idle_tasks, "run_plugin_idle_tasks", lambda **kw: seen.append(("plugins", kw["idle_for_seconds"])))
+
+    gateway_run._housekeeping_curator()
+    assert seen == [("curator", float("inf")), ("plugins", float("inf"))]
diff --git a/tests/hermes_cli/test_plugin_idle_tasks_off_thread.py b/tests/hermes_cli/test_plugin_idle_tasks_off_thread.py
new file mode 100644
index 0000000000..06b5250a25
--- /dev/null
+++ b/tests/hermes_cli/test_plugin_idle_tasks_off_thread.py
@@ -0,0 +1,135 @@
+"""Plugin idle tasks run on their own thread: the host's poll (gateway housekeeping, CLI startup,
+``hermes serve``'s ticker) starts each due run and returns at once, the claim still keeps one run
+at a time, and the worker records the run and releases the claim whatever ``fn`` does."""
+
+from __future__ import annotations
+
+import os
+import threading
+import time
+from datetime import UTC, datetime, timedelta
+
+import pytest
+
+from agent.idle_schedule import CLAIM_STALE_SECONDS
+from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+from hermes_cli.plugins_idle_tasks import load_state, run_plugin_idle_tasks
+
+T0 = datetime(2026, 10, 1, 12, 0, tzinfo=UTC)
+IDLE = 3 * 3600.0
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    return tmp_path
+
+
+def _ctx(manager=None):
+    manager = manager or PluginManager()
+    return manager, PluginContext(PluginManifest(name="wisdom", source="user"), manager)
+
+
+def _poll(manager, now):
+    return run_plugin_idle_tasks(idle_for_seconds=IDLE, manager=manager, now=now)
+
+
+def _blocking(entered, release, calls):
+    def fn(run):
+        calls.append(threading.current_thread())
+        entered.set()
+        release.wait(5)
+        return "promoted 2 skills"
+    return fn
+
+
+def test_a_slow_task_runs_on_its_own_thread_and_the_poll_returns_at_once(home):
+    manager, ctx = _ctx()
+    entered, release, calls = threading.Event(), threading.Event(), []
+    ctx.register_idle_task("promote", _blocking(entered, release, calls), interval_hours=1, first_run="immediate")
+    state_path = ctx.state.data_dir / "idle-tasks" / "promote.json"
+
+    began = time.monotonic()
+    try:
+        started = _poll(manager, T0)
+        returned_after = time.monotonic() - began
+        assert entered.wait(5)
+        assert returned_after < 2.0  # the poll did not wait for the run
+        assert calls[0] is not threading.current_thread()
+        assert load_state(state_path)["run_count"] == 0  # still running
+    finally:
+        release.set()
+
+    worker = started["wisdom:promote"]
+    worker.join(10)
+    assert not worker.is_alive()
+    state = load_state(state_path)
+    assert (state["run_count"], state["last_status"], state["last_summary"]) == (1, "ok", "promoted 2 skills")
+    assert not (ctx.state.data_dir / "idle-tasks" / ".promote.lock").exists()
+
+
+def test_no_second_run_starts_while_one_is_in_flight(home):
+    manager, ctx = _ctx()
+    entered, release, calls = threading.Event(), threading.Event(), []
+    ctx.register_idle_task("promote", _blocking(entered, release, calls), interval_hours=1, first_run="immediate")
+    lock = ctx.state.data_dir / "idle-tasks" / ".promote.lock"
+
+    try:
+        first = _poll(manager, T0)
+        assert entered.wait(5)
+        assert _poll(manager, T0 + timedelta(hours=5)) == {}
+        # The run outlasts the claim's stale age: this process still knows it is running.
+        old = time.time() - CLAIM_STALE_SECONDS - 60
+        os.utime(lock, (old, old))
+        assert _poll(manager, T0 + timedelta(hours=6)) == {}
+        assert len(calls) == 1
+    finally:
+        release.set()
+    first["wisdom:promote"].join(10)
+
+    entered.clear()
+    again = _poll(manager, T0 + timedelta(hours=7))
+    again["wisdom:promote"].join(10)
+    assert len(calls) == 2
+
+
+def test_the_claim_is_released_and_the_run_recorded_after_an_exception(home):
+    manager, ctx = _ctx()
+
+    def boom(run):
+        raise RuntimeError("model unreachable")
+
+    ctx.register_idle_task("boom", boom, interval_hours=1, first_run="immediate")
+    _poll(manager, T0)["wisdom:boom"].join(10)
+
+    state = load_state(ctx.state.data_dir / "idle-tasks" / "boom.json")
+    assert (state["run_count"], state["last_status"]) == (1, "error") and "model unreachable" in state["last_error"]
+    assert not (ctx.state.data_dir / "idle-tasks" / ".boom.lock").exists()
+    _poll(manager, T0 + timedelta(hours=1))["wisdom:boom"].join(10)  # the next interval runs again
+    assert load_state(ctx.state.data_dir / "idle-tasks" / "boom.json")["run_count"] == 2
+
+
+def test_the_worker_keeps_the_profile_scope_of_the_poll(home, tmp_path):
+    from hermes_constants import get_hermes_home, reset_hermes_home_override, set_hermes_home_override
+
+    coder = tmp_path / "profiles" / "coder"
+    coder.mkdir(parents=True)
+    release, seen = threading.Event(), []
+
+    def fn(run):
+        release.wait(5)  # read the home only after the poller has left the profile's scope
+        seen.append(get_hermes_home())
+
+    token = set_hermes_home_override(coder)
+    try:
+        manager, ctx = _ctx(PluginManager(scope_key=str(coder)))
+        ctx.register_idle_task("suggest", fn, interval_hours=1, first_run="immediate")
+        state_path = ctx.state.data_dir / "idle-tasks" / "suggest.json"
+        started = _poll(manager, T0)
+    finally:
+        reset_hermes_home_override(token)
+        release.set()
+    started["wisdom:suggest"].join(10)
+
+    assert seen == [coder]
+    assert state_path.is_relative_to(coder) and load_state(state_path)["run_count"] == 1
diff --git a/tests/hermes_cli/test_plugin_idle_tasks_stop_fence.py b/tests/hermes_cli/test_plugin_idle_tasks_stop_fence.py
new file mode 100644
index 0000000000..79c1a43794
--- /dev/null
+++ b/tests/hermes_cli/test_plugin_idle_tasks_stop_fence.py
@@ -0,0 +1,147 @@
+"""The idle-task stop fence: once a host stops, none of its runs starts or records.
+
+A stopping host (gateway housekeeping) polls its plugins' idle tasks under an ``IdleTaskFence``.
+Plugin code cannot be killed, so closing the fence waits a bounded time for the runs and returns;
+a run that ends after that leaves the task's state as it was before the run and releases its claim.
+"""
+
+from __future__ import annotations
+
+import threading
+from datetime import UTC, datetime
+
+import pytest
+
+from hermes_cli import plugins_idle_tasks
+from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+from hermes_cli.plugins_idle_tasks import IdleTaskFence, load_state, run_plugin_idle_tasks
+from tests.waiting import wait_until
+
+T0 = datetime(2026, 1, 1, tzinfo=UTC)
+IDLE = 10 * 3600.0
+
+
+@pytest.fixture
+def ctx(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    return PluginContext(PluginManifest(name="wisdom", source="user"), PluginManager())
+
+
+def _poll(ctx, fence):
+    return run_plugin_idle_tasks(idle_for_seconds=IDLE, manager=ctx._manager, now=T0, fence=fence)
+
+
+def _paths(ctx, name="promote"):
+    base = ctx.state.data_dir / "idle-tasks"
+    return base / f"{name}.json", base / f".{name}.lock"
+
+
+def test_a_closed_fence_starts_no_run_and_takes_no_claim(ctx):
+    calls = []
+    ctx.register_idle_task("promote", calls.append, interval_hours=1, first_run="immediate")
+    fence = IdleTaskFence()
+    assert fence.close(0) is True
+    assert _poll(ctx, fence) == {}
+    assert calls == [] and not _paths(ctx)[1].exists()
+
+
+def test_a_set_stop_event_closes_the_fence(ctx):
+    calls, stop = [], threading.Event()
+    ctx.register_idle_task("promote", calls.append, interval_hours=1, first_run="immediate")
+    stop.set()
+    assert _poll(ctx, IdleTaskFence(stop)) == {} and calls == []
+
+
+def test_a_run_outlasting_the_close_records_nothing_and_releases_its_claim(ctx):
+    entered, release = threading.Event(), threading.Event()
+
+    def promote(run):
+        entered.set()
+        release.wait(30)
+        return "promoted"
+
+    ctx.register_idle_task("promote", promote, interval_hours=1, first_run="immediate")
+    state_path, lock = _paths(ctx)
+    fence = IdleTaskFence()
+    worker = _poll(ctx, fence)["wisdom:promote"]
+    try:
+        assert entered.wait(5)
+        assert fence.close(0.05) is False  # bounded: the run is still going
+    finally:
+        release.set()
+    worker.join(10)
+    assert not worker.is_alive() and not lock.exists()
+    assert load_state(state_path)["run_count"] == 0
+
+
+def test_a_run_ending_within_the_close_budget_is_recorded(ctx):
+    ctx.register_idle_task("promote", lambda run: "promoted", interval_hours=1, first_run="immediate")
+    fence = IdleTaskFence()
+    worker = _poll(ctx, fence)["wisdom:promote"]
+    worker.join(10)
+    assert fence.close(5) is True
+    state = load_state(_paths(ctx)[0])
+    assert (state["run_count"], state["last_summary"]) == (1, "promoted")
+
+
+def test_close_waits_for_a_record_in_progress(ctx, monkeypatch):
+    in_save, finish_save, order = threading.Event(), threading.Event(), []
+    real_save = plugins_idle_tasks.save_state
+
+    def slow_save(path, state):
+        in_save.set()
+        finish_save.wait(10)
+        real_save(path, state)
+        order.append("recorded")
+
+    monkeypatch.setattr(plugins_idle_tasks, "save_state", slow_save)
+    ctx.register_idle_task("promote", lambda run: "promoted", interval_hours=1, first_run="immediate")
+    fence = IdleTaskFence()
+    worker = _poll(ctx, fence)["wisdom:promote"]
+    assert in_save.wait(5)
+    closer = threading.Thread(target=lambda: (fence.close(5), order.append("closed")), daemon=True)
+    closer.start()
+    closer.join(0.3)  # gives a close that skipped the record's lock time to finish first
+    finish_save.set()
+    closer.join(10)
+    worker.join(10)
+    assert order == ["recorded", "closed"]
+
+
+def test_a_closed_fence_refuses_to_start_a_worker():
+    fence, ran = IdleTaskFence(), []
+    fence.close(0)
+    worker = threading.Thread(target=lambda: ran.append(1))
+    assert fence.start(worker) is False
+    assert worker.ident is None and ran == []
+
+
+def test_close_waits_for_a_run_that_ends_within_its_budget(ctx):
+    entered, release, seen = threading.Event(), threading.Event(), {}
+    ctx.register_idle_task("promote", lambda run: (entered.set(), release.wait(30)) and "promoted",
+                           interval_hours=1, first_run="immediate")
+    state_path, lock = _paths(ctx)
+    fence = IdleTaskFence()
+    worker = _poll(ctx, fence)["wisdom:promote"]
+    assert entered.wait(5)
+
+    def close():
+        seen["settled"] = fence.close(10)
+        seen["claim_left"] = lock.exists()
+
+    closer = threading.Thread(target=close, daemon=True)
+    closer.start()
+    try:
+        wait_until(lambda: fence.closed, what="the fence closed")
+    finally:
+        release.set()
+    closer.join(15)
+    worker.join(10)
+    assert seen == {"settled": True, "claim_left": False}  # close returned once the run had settled
+    assert load_state(state_path)["run_count"] == 0  # it ended after the stop: not recorded
+
+
+def test_without_a_fence_a_run_is_recorded_as_before(ctx):
+    ctx.register_idle_task("promote", lambda run: "promoted", interval_hours=1, first_run="immediate")
+    run_plugin_idle_tasks(idle_for_seconds=IDLE, manager=ctx._manager, now=T0)["wisdom:promote"].join(10)
+    wait_until(lambda: load_state(_paths(ctx)[0])["run_count"] == 1, what="the run's record")
diff --git a/tests/hermes_cli/test_plugin_registrars_abandoned_load.py b/tests/hermes_cli/test_plugin_registrars_abandoned_load.py
new file mode 100644
index 0000000000..aad18a2ec8
--- /dev/null
+++ b/tests/hermes_cli/test_plugin_registrars_abandoned_load.py
@@ -0,0 +1,85 @@
+"""After a plugin's load times out, nothing its abandoned worker calls on ``ctx`` may land: every
+registrar is a no-op, including the ones a ``PluginContext`` mixin contributes
+(``register_idle_task`` on ``PluginIdleTaskCtxMixin``)."""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import plugins_load_guard
+from hermes_cli.plugins import PluginContext, PluginManager, PluginManifest
+from hermes_cli.plugins_idle_tasks import registered_idle_tasks, run_plugin_idle_tasks
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    return tmp_path
+
+
+def _is_registrar(name: str) -> bool:
+    return name.startswith("register_") or name in {"subscribe", "on_unload"}
+
+
+def _abandoned():
+    manager = PluginManager()
+    ctx = PluginContext(PluginManifest(name="late", key="late", source="user"), manager)
+    ctx._abandon_load()
+    return manager, ctx
+
+
+def test_every_registrar_is_ignored_after_an_abandoned_load(home):
+    manager, ctx = _abandoned()
+    registrars = sorted(name for name in dir(PluginContext)
+                        if _is_registrar(name) and callable(getattr(PluginContext, name)))
+    # Mixin-defined registrars are part of the surface the guard has to cover.
+    assert {"register_tool", "register_hook", "subscribe", "on_unload", "register_idle_task"} <= set(registrars)
+
+    unguarded = []
+    for name in registrars:
+        try:
+            if getattr(ctx, name)() is not None:  # the guard returns before the registrar runs
+                unguarded.append(name)
+        except TypeError:  # the registrar itself ran and asked for its arguments
+            unguarded.append(name)
+
+    assert unguarded == []
+    assert manager._ownership_ledger == {}
+
+
+def test_an_abandoned_load_registers_no_idle_task_and_the_poll_runs_nothing(home):
+    manager, ctx = _abandoned()
+    calls = []
+
+    assert ctx.register_idle_task("late", calls.append, interval_hours=1, first_run="immediate") is None
+
+    assert registered_idle_tasks(manager) == {}
+    assert run_plugin_idle_tasks(idle_for_seconds=10 * 3600.0, manager=manager, now=datetime.now(UTC)) == {}
+    assert calls == []
+
+
+def test_registrars_a_mixin_contributes_are_guarded_too():
+    calls = []
+
+    class Mixin:
+        def register_probe(self, value):
+            calls.append(value)
+            return value
+
+    class Context(Mixin):
+        manifest = SimpleNamespace(name="probe")
+
+        def register_own(self, value):
+            calls.append(value)
+            return value
+
+    plugins_load_guard.ignore_registrars_after_abandoned_load(Context)
+    live, abandoned = Context(), Context()
+    abandoned._load_abandoned = True
+
+    assert (live.register_probe("a"), live.register_own("b")) == ("a", "b")
+    assert (abandoned.register_probe("c"), abandoned.register_own("d")) == (None, None)
+    assert calls == ["a", "b"]
