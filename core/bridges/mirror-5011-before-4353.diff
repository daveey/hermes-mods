@@ -0,0 +1,54 @@
+"""Kanban worker logs are durable and may quote secrets: never world-readable (#63594)."""
+
+from __future__ import annotations
+
+import os
+import stat
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_dispatch as kbd
+
+pytestmark = pytest.mark.platforms("posix")
+
+
+@pytest.fixture
+def log_path(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    return kb.worker_log_path("t_mode")
+
+
+def _mode(path: Path) -> int:
+    return stat.S_IMODE(path.stat().st_mode)
+
+
+def test_new_worker_log_is_not_world_readable(log_path):
+    old = os.umask(0o002)
+    try:
+        with kbd._open_worker_log(SimpleNamespace(id="t_mode"), None) as f:
+            f.write(b"x")
+    finally:
+        os.umask(old)
+    assert _mode(log_path) & 0o007 == 0
+    assert _mode(log_path) & 0o600 == 0o600
+
+
+def test_existing_world_readable_log_and_its_backup_are_tightened(log_path, monkeypatch):
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    log_path.write_bytes(b"old secret output\n" * 10)
+    log_path.chmod(0o664)
+    monkeypatch.setattr("hermes_cli.kanban_worker_log.worker_log_rotation_config", lambda: (16, 1))
+
+    with kbd._open_worker_log(SimpleNamespace(id="t_mode"), None) as f:
+        f.write(b"x")
+
+    backup = log_path.with_suffix(".log.1")
+    assert _mode(backup) == 0o660  # group bits kept for shared-group homes
+    assert _mode(log_path) & 0o007 == 0
diff --git a/tests/hermes_cli/test_kanban_worker_log_shared_owner.py b/tests/hermes_cli/test_kanban_worker_log_shared_owner.py
new file mode 100644
index 0000000000..39652e3447
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_worker_log_shared_owner.py
@@ -0,0 +1,67 @@
+"""Reopening a worker log owned by another account in a shared-group kanban home (#63594)."""
+
+from __future__ import annotations
+
+import errno
+import os
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_worker_log as kwl
+
+pytestmark = pytest.mark.platforms("posix")
+
+
+def _as_non_owner(monkeypatch: pytest.MonkeyPatch) -> list[int]:
+    """Make chmod behave as for a file another account owns; track descriptors opened."""
+    opened: list[int] = []
+    real_open = os.open
+
+    def _open(*args, **kwargs):
+        fd = real_open(*args, **kwargs)
+        opened.append(fd)
+        return fd
+
+    def _chmod(*_args, **_kwargs):
+        raise PermissionError(errno.EPERM, "Operation not permitted")
+
+    monkeypatch.setattr(kwl.os, "open", _open)
+    monkeypatch.setattr(kwl.os, "chmod", _chmod)
+    monkeypatch.setattr(kwl, "worker_log_rotation_config", lambda: (1 << 20, 1))
+    return opened
+
+
+def _is_open(fd: int) -> bool:
+    try:
+        os.fstat(fd)
+    except OSError:
+        return False
+    return True
+
+
+def test_private_group_writable_log_of_another_owner_reopens(tmp_path: Path, monkeypatch):
+    log = tmp_path / "t.log"
+    log.write_bytes(b"earlier run\n")
+    log.chmod(0o660)
+    _as_non_owner(monkeypatch)
+
+    with kwl.open_worker_log(log) as f:
+        f.write(b"next run\n")
+
+    assert log.read_bytes() == b"earlier run\nnext run\n"
+
+
+def test_world_readable_log_that_cannot_be_tightened_fails_closed_without_leaking(
+    tmp_path: Path, monkeypatch
+):
+    log = tmp_path / "t.log"
+    log.write_bytes(b"earlier run\n")
+    log.chmod(0o664)
+    opened = _as_non_owner(monkeypatch)
+
+    with pytest.raises(PermissionError):
+        kwl.open_worker_log(log)
+
+    assert opened and not _is_open(opened[-1])
+    assert log.read_bytes() == b"earlier run\n"
