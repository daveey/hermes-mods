+        ProcessRegistry._terminate_host_pid(pid, born)
+    leftover = None
+    if (unit := record.get("systemd_unit")) and not _stop_systemd_unit(unit):  # reaps double-forked descendants
+        _kill_scope(unit)
+        leftover = None if _stop_systemd_unit(unit) else unit
