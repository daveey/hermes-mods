+            "client_id": "id",
+            "client_secret": "secret",
+            "refresh_token": "refresh",
+            "token_uri": "https://oauth2.googleapis.com/token",
+        }
+    )
+
+    assert token_path.stat().st_mode & 0o777 == 0o600
+    assert json.loads(token_path.read_text(encoding="utf-8"))["token"] == "new"
