--- /dev/null
+++ b/tests/agent/test_process_transport.py
@@ -0,0 +1,121 @@
+"""External-process providers keep a local server's stall patience, keyed on auth_type (#149555).
+
+The ``process://`` URL used to earn that patience by accident, because ``is_local_endpoint`` reads a
+dot-less scheme host as a LAN name (#129153). The fixture's URL has a dot on purpose: the profile's
+``auth_type`` decides now, and the budget no longer changes with the model name.
+"""
+
+from __future__ import annotations
+
+import sys
+import threading
+import time
+
+import pytest
+
+from agent.acp_client import ACPClient
+
+PROVIDER = "patience-fixture"
+
+
+@pytest.fixture
+def process_agent(monkeypatch):
+    from hermes_constants import get_hermes_home
+    from providers import get_provider_profile
+    from run_agent import AIAgent
+
+    for name in ("HERMES_API_CALL_STALE_TIMEOUT", "HERMES_STREAM_STALE_TIMEOUT", "HERMES_LOCAL_STREAM_STALE_TIMEOUT",
+                 "HERMES_API_TIMEOUT"):
+        monkeypatch.delenv(name, raising=False)
+    plugin = get_hermes_home() / "plugins" / PROVIDER
+    plugin.mkdir(parents=True)
+    (plugin / "plugin.yaml").write_text(
+        f"name: {PROVIDER}\nkind: model-provider\nversion: 0.1.0\ndescription: test fixture\n")
+    (plugin / "__init__.py").write_text(
+        "from providers import register_provider\n"
+        "from providers.base import ProviderProfile\n"
+        f"register_provider(ProviderProfile(name='{PROVIDER}', auth_type='external_process', "
+        "base_url='process://patience.fixture', supports_streaming=True))\n")
+    profile = get_provider_profile(PROVIDER)
+    monkeypatch.setattr(profile, "create_client", lambda **kwargs: object())
+    return AIAgent(provider=PROVIDER, model="claude-opus-5-5[1m]", api_key="fixture", base_url=profile.base_url,
+                   enabled_toolsets=[], quiet_mode=True, skip_context_files=True, skip_memory=True)
+
+
+def _budgets(agent, model: str) -> tuple[float, float]:
+    from agent.chat_completion_helpers import _StreamingCall
+
+    agent.model = model
+    payload = {"model": model, "messages": [{"role": "user", "content": "x" * 1_300_000}]}
+    call = _StreamingCall(agent, payload, None)
+    call._resolve_stale_timeout()
+    return agent._compute_non_stream_stale_timeout(payload), call._stream_stale_timeout
+
+
+def _write_config(text: str) -> None:
+    from hermes_constants import get_hermes_home
+
+    (get_hermes_home() / "config.yaml").write_text(text)
+
+
+def test_external_process_stall_budget_is_one_explicit_deadline(process_agent):
+    """A ~325K-token request to a child process: unset, the request timeout bounds a buffered call and the 900s
+    local ceiling bounds a stream, the same for every model (opus was cut at 240s while haiku waited without
+    limit). An explicit value is the operator's deadline on both paths; 180 is not mistaken for the unset default."""
+    for model in ("claude-opus-5-5[1m]", "claude-sonnet-5-5", "claude-haiku-5-5"):
+        assert _budgets(process_agent, model) == (1800.0, 900.0), model
+    for seconds in (180, 1200):
+        _write_config(f"providers:\n  {PROVIDER}:\n    stale_timeout_seconds: {seconds}\n")
+        assert _budgets(process_agent, "claude-haiku-5-5") == (float(seconds), float(seconds)), seconds
+
+
+_DEAF_AFTER_SESSION = """import json, sys, time
+for line in sys.stdin:
+    request = json.loads(line)
+    result = {"protocolVersion": 1} if request["method"] == "initialize" else {"sessionId": "s1"}
+    print(json.dumps({"jsonrpc": "2.0", "id": request["id"], "result": result}), flush=True)
+    if request["method"] == "session/new":
+        break
+time.sleep(120)
+"""
+
+
+def test_buffered_call_to_a_child_that_stops_reading_times_out(process_agent, monkeypatch, tmp_path):
+    """An ACP child that answers session/new and then stops reading blocks the prompt write before
+    the client's own deadline is checked; the request timeout must still end the call."""
+    from providers import get_provider_profile
+
+    server = tmp_path / "deaf_acp.py"
+    server.write_text(_DEAF_AFTER_SESSION)
+    spawned = []
+
+    class _DeafClient(ACPClient):
+        def _spawn(self):
+            spawned.append(super()._spawn())
+            return spawned[-1]
+
+    monkeypatch.setattr(get_provider_profile(PROVIDER), "create_client", lambda **kwargs: _DeafClient(
+        command=sys.executable, args=[str(server)], acp_cwd=str(tmp_path)))
+    _write_config(f"providers:\n  {PROVIDER}:\n    request_timeout_seconds: 2\n")
+    process_agent.model = "claude-haiku-5-5"
+    outcome = {}
+
+    def call():
+        try:
+            process_agent._interruptible_api_call(
+                {"model": process_agent.model, "messages": [{"role": "user", "content": "x" * 4_000_000}]})
+        except Exception as exc:
+            outcome["error"] = exc
+
+    worker = threading.Thread(target=call, daemon=True)
+    started = time.monotonic()
+    worker.start()
+    try:
+        worker.join(30)
+        assert not worker.is_alive(), "the buffered call to a deaf child never ended"
+        assert isinstance(outcome.get("error"), TimeoutError)
+        assert time.monotonic() - started < 30
+    finally:
+        for proc in spawned:
+            proc.kill()
+        worker.join(5)
diff --git a/tests/agent/test_reasoning_persistence_redaction.py b/tests/agent/test_reasoning_persistence_redaction.py
new file mode 100644
index 0000000000..3c8b3cb445
--- /dev/null
+++ b/tests/agent/test_reasoning_persistence_redaction.py
@@ -0,0 +1,104 @@
+"""Assistant reasoning fields reach state.db redacted, like ``content`` (#43666 gap 3).
+
+A credential the model quotes in its thinking must not persist verbatim through
+``reasoning`` / ``reasoning_content`` / unsigned ``reasoning_details`` text, while
+signed and opaque replay material stays byte-exact and redaction-off is a no-op.
+"""
+
+import sqlite3
+
+from agent.chat_completion_helpers import build_assistant_message
+from hermes_state import SessionDB
+
+_SECRET = "ghp_" + "A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8"
+_THOUGHT = f"I will use the token {_SECRET} to call the API."
+
+
+class _Agent:
+    stream_delta_callback = None
+    _stream_callback = None
+    reasoning_callback = None
+    verbose_logging = False
+
+    def _extract_reasoning(self, msg):
+        return getattr(msg, "reasoning", None)
+
+    def _strip_think_blocks(self, text):
+        return text
+
+    def _needs_thinking_reasoning_pad(self):
+        return False
+
+
+class _Msg:
+    def __init__(self, **fields):
+        self.content = "done"
+        self.tool_calls = None
+        self.__dict__.update(fields)
+
+    def __getattr__(self, _name):
+        return None
+
+
+def _signed_detail():
+    return {"type": "reasoning.text", "text": _THOUGHT, "signature": "sig-opaque"}
+
+
+def _assistant_message():
+    return _Msg(
+        reasoning=_THOUGHT,
+        reasoning_content=_THOUGHT,
+        reasoning_details=[
+            {"type": "reasoning.summary", "summary": _THOUGHT},
+            _signed_detail(),
+            {"type": "reasoning.encrypted", "data": "opaque-blob"},
+            # Bedrock Converse shape for unsigned (non-Claude) reasoning.
+            {"type": "thinking", "thinking": _THOUGHT},
+            {"type": "thinking", "thinking": _THOUGHT, "signature": "sig-anthropic"},
+        ],
+    )
+
+
+def _persist(tmp_path, msg):
+    db_path = tmp_path / "state.db"
+    db = SessionDB(db_path=db_path)
+    db.create_session("s1", source="test")
+    db.append_message("s1", "assistant", msg["content"], reasoning=msg.get("reasoning"),
+                      reasoning_content=msg.get("reasoning_content"),
+                      reasoning_details=msg.get("reasoning_details"))
+    history = db.get_messages_as_conversation("s1")
+    db.close()
+    con = sqlite3.connect(db_path)
+    rows = con.execute("SELECT reasoning, reasoning_content, reasoning_details FROM messages").fetchall()
+    con.close()
+    return history[-1], rows
+
+
+def test_reasoning_fields_persist_redacted_and_signed_details_stay_exact(tmp_path, monkeypatch):
+    monkeypatch.setattr("agent.redact._REDACT_ENABLED", True, raising=False)
+    source = _assistant_message()
+    msg = build_assistant_message(_Agent(), source, "stop")
+    stored, rows = _persist(tmp_path, msg)
+
+    reasoning, reasoning_content, details_json = rows[0]
+    assert _SECRET not in reasoning
+    assert _SECRET not in reasoning_content
+    unsigned_summary, signed, encrypted, unsigned_thinking, signed_thinking = stored["reasoning_details"]
+    assert _SECRET not in unsigned_summary["summary"]
+    assert _SECRET not in unsigned_thinking["thinking"]
+    # Provider-verified replay material is untouched (byte-exact).
+    assert signed == _signed_detail()
+    assert encrypted == {"type": "reasoning.encrypted", "data": "opaque-blob"}
+    assert signed_thinking == {"type": "thinking", "thinking": _THOUGHT, "signature": "sig-anthropic"}
+    assert details_json.count(_SECRET) == 2  # only inside the two signed entries
+    # Copy-on-write: the SDK response object is not mutated.
+    assert source.reasoning_details[0]["summary"] == _THOUGHT
+
+
+def test_redaction_off_keeps_reasoning_verbatim(tmp_path, monkeypatch):
+    monkeypatch.setattr("agent.redact._REDACT_ENABLED", False, raising=False)
+    msg = build_assistant_message(_Agent(), _assistant_message(), "stop")
+    stored, _rows = _persist(tmp_path, msg)
+    assert stored["reasoning"] == _THOUGHT
+    assert stored["reasoning_content"] == _THOUGHT
+    assert stored["reasoning_details"][0]["summary"] == _THOUGHT
