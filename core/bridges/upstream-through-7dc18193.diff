+
+def test_run_time_survives_the_skills_assembly_path():
+    result = _prompt({"skills": ["ghost-skill"], "prompt": "go"})
+    assert "[CURRENT RUN TIME: Saturday, 2026-10-31 19:05 PDT (UTC-07:00)]" in result
