+  recents: { sessions, ...(errors ? { errors } : {}) },
+  cron: { sessions: [] },
+  messaging: { sessions: [] }
+})
+
+function mountSidebar() {
+  render(
+    <MemoryRouter>
+      <SidebarProvider>
+        <ChatSidebar
+          currentView="chat"
+          onArchiveSession={noop}
+          onBranchSession={noop}
+          onDeleteSession={noop}
+          onLoadMoreSessions={noop}
+          onManageCronJob={noop}
+          onNavigate={noop}
