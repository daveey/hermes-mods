index bdbfc692e3b..c45a4ce9bd5 100644
--- a/tests/agent/test_stream_stale_abandon.py
+++ b/tests/agent/test_stream_stale_abandon.py
@@ -274,3 +274,29 @@ def test_abandon_joins_the_worker_for_relay_teardown_like_stop(wedged, monkeypat
 
     assert isinstance(outcome.get("error"), TimeoutError), outcome
     assert len(joined) == 1 and joined[0][0] is not None and joined[0][1] == "Abandoned streaming"
+
+
+@pytest.mark.filterwarnings("ignore::pytest.PytestUnhandledThreadExceptionWarning")
+@pytest.mark.parametrize("stale,cap", [("inf", "1"), ("0.3", "0.3")], ids=["stale_off", "cap_at_stale"])
+def test_wedged_worker_under_the_lifetime_cap_is_abandoned_once(wedged, monkeypatch, tmp_path, caplog, stale, cap):
+    """agent.stream_max_lifetime kills that cannot unwind the worker get the same give-up as
+    stale kills: with the stale detector off, the cap alone must still end the turn. With the
+    cap at the stale timeout both checks fire on the same tick; one silent window is one kill,
+    and the call is abandoned once, with the stale error (no chunk ever arrived)."""
+    from agent.stream_max_lifetime import StreamLifetimeExceeded
+
+    monkeypatch.setenv("HERMES_STREAM_STALE_TIMEOUT", stale)
+    (tmp_path / "config.yaml").write_text(f"agent:\n  stream_max_lifetime: {cap}\n")
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    with caplog.at_level("WARNING"):
+        caller, outcome = _call_in_thread(wedged)
+        caller.join(timeout=10.0)
+
+    capped = stale == "inf"
+    assert not caller.is_alive(), "the cap re-killed the same wedged attempt forever"
+    assert isinstance(outcome.get("error"), StreamLifetimeExceeded) is capped, outcome
+    assert isinstance(outcome.get("error"), TimeoutError), outcome
+    assert _log_count(caplog, "Stream still running after") == (3 if capped else 0)  # _STALE_ABANDON_KILLS
+    assert _log_count(caplog, "Stream stale for") == (0 if capped else 3)
+    assert _log_count(caplog, "abandoning the request") == 1
+    assert wedged._consecutive_stale_streams == (0 if capped else 1), "cap kills must not feed the stale breaker"
