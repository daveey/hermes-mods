diff --git a/agent/stream_max_lifetime.py b/agent/stream_max_lifetime.py
new file mode 100644
index 00000000000..6ebb7a9dd56
--- /dev/null
+++ b/agent/stream_max_lifetime.py
@@ -0,0 +1,74 @@
+"""Opt-in total-lifetime cap for one streaming response attempt.
+
+The stale-stream detector bounds the gap BETWEEN chunks and resets on every
+chunk, so a stream that keeps yielding data but never finishes (a gateway
+trickling chunks, a runaway generation) is never cut. ``agent.stream_max_lifetime``
+caps the wall-clock time since the current attempt started; it never resets on
+chunk arrival. Default ``0`` = off, so a
+legitimately long reasoning stream is never cut unless the user asks for it.
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import time
+
+logger = logging.getLogger(__name__)
+
+
+def resolve_stream_max_lifetime(stale_timeout: float | None) -> float:
+    """Cap in seconds, ``0`` when disabled. Floored at a finite stale timeout so the
+    cap can never cut a stream the stale detector would still be waiting on."""
+    configured = 0.0
+    try:
+        from hermes_cli.config import load_config_readonly
+
+        agent_cfg = (load_config_readonly() or {}).get("agent")
+        value = agent_cfg.get("stream_max_lifetime") if isinstance(agent_cfg, dict) else None
+        if isinstance(value, (int, float)) and not isinstance(value, bool):
+            configured = float(value)
+    except Exception:  # unreadable config = the documented default (off)
+        logger.debug("stream_max_lifetime: config unreadable, cap off", exc_info=True)
+    if configured <= 0 or not math.isfinite(configured):
+        return 0.0
+    if stale_timeout is not None and math.isfinite(stale_timeout):
+        return max(configured, stale_timeout)
+    return configured
+
+
+class StreamLifetimeExceeded(TimeoutError):
+    """A stream attempt cut by ``agent.stream_max_lifetime``: the stream opened and was still
+    delivering chunks, so the user-facing error names the setting, not the endpoint."""
+
+    def __init__(self, elapsed: float, cap: float):
+        self.cap = cap
+        super().__init__(
+            f"Response still streaming after {elapsed:.0f}s, cut by agent.stream_max_lifetime ({cap:g}s). "
+            f"Raise agent.stream_max_lifetime, or set it to 0 to turn the cap off, if this model "
+            f"legitimately streams this long.")
+
+
+class StreamLifetime:
+    """Per-call clock: restarts whenever a new stream attempt is dispatched, so each
+    retry gets the full cap, and after each kill (the killed attempt may unwind slowly)."""
+
+    def __init__(self, cap: float):
+        self.cap = cap
+        self.attempt = None
+        self.started = time.time()
+
+    def exceeded(self, attempt) -> float | None:
+        """Elapsed seconds when the cap is exceeded for ``attempt``, else ``None``."""
+        if not self.cap:
+            return None
+        now = time.time()
+        if attempt != self.attempt:
+            self.attempt, self.started = attempt, now
+            return None
+        elapsed = now - self.started
+        if elapsed <= self.cap:
+            return None
+        self.started = now
+        return elapsed
+
diff --git a/agent/timeout_error_summary.py b/agent/timeout_error_summary.py
new file mode 100644
index 00000000000..04cd659d350
--- /dev/null
+++ b/agent/timeout_error_summary.py
@@ -0,0 +1,63 @@
+"""Phase-specific one-liners for transport-timeout API errors.
+
+A timeout that survives the retry loop otherwise surfaces as the SDK's bare
+text: ``Request timed out.`` (openai ``APITimeoutError``) or ``timed out`` (a
+raw httpx ``ReadTimeout`` mid-stream). Neither says whether a connection was
+ever made, nor which setting to raise. The openai SDK wraps EVERY httpx
+timeout, connect included, in ``APITimeoutError``, so the phase is read from
+the most specific timeout in the explicit ``__cause__`` chain. ``__context__``
+is not followed: an HTTP error raised while a timeout was being handled is a
+different failure and keeps its own summary.
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+# No TCP/TLS connection was established: raising the read timeout will not help.
+_CONNECT_TIMEOUT_TYPES = frozenset({"ConnectTimeout", "ConnectTimeoutError"})
+# The request was sent (or a stream was open) but no bytes arrived in time.
+# ``APITimeoutError`` without a transport cause also lands here.
+_READ_TIMEOUT_TYPES = frozenset({
+    "ReadTimeout", "TimeoutException", "ReadTimeoutError", "APITimeoutError",
+})
+# Waiting for a pooled connection or while uploading the request: the provider
+# never got to answer, so neither hint applies and the existing summary stays.
+_OTHER_TIMEOUT_TYPES = frozenset({"PoolTimeout", "WriteTimeout"})
+
+
+def _timeout_phase(error: BaseException) -> Optional[str]:
+    """``"connect"``, ``"read"``, or ``None`` when no timeout is in the chain."""
+    phase = None
+    current: Optional[BaseException] = error
+    seen: set[int] = set()
+    while current is not None and id(current) not in seen:
+        seen.add(id(current))
+        name = type(current).__name__
+        if name in _CONNECT_TIMEOUT_TYPES:
+            return "connect"
+        if name in _OTHER_TIMEOUT_TYPES:
+            return None
+        if name not in _READ_TIMEOUT_TYPES:
+            break
+        phase = "read"
+        current = current.__cause__
+    return phase
+
+
+def summarize_timeout_error(error: BaseException, provider: Optional[str] = None) -> Optional[str]:
+    """Timeout summary naming the phase and the setting to change, or ``None``
+    for any other error (the caller's existing summary handling then applies).
+
+    Both lines keep the "timed out" wording: cron failure notices and the error
+    classifier re-read this summary as text and match on it.
+    """
+    phase = _timeout_phase(error)
+    if phase == "connect":
+        return ("Connection to the provider timed out before it was established "
+                "(check the base_url and network path)")
+    if phase == "read":
+        key = provider.strip() if isinstance(provider, str) and provider.strip() else "<provider>"
+        return ("Request timed out waiting for the provider to respond (if the model needs "
+                f"longer, raise providers.{key}.request_timeout_seconds in config.yaml)")
+    return None
