-    @property
-    def is_connected(self) -> bool:
-        """``ws.open`` may be a bool (websockets <14) or a method (>=14)."""
-        if self._ws is None:
-            return False
-        open_attr = getattr(self._ws, "open", None)
-        try:
-            return open_attr is True or (callable(open_attr) and bool(open_attr()))
-        except Exception:
-            return False
