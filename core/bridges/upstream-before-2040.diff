-    _DEBOUNCE_WINDOW: float = 1.5  # seconds to wait for companion frames of a multi-part message
-    _LOOPS = (("_heartbeat_task", "_heartbeat_loop", "heartbeat"), ("_recv_task", "_receive_loop", "recv"))
