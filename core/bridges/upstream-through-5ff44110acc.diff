diff --git a/ui-tui/src/__tests__/approvalTell.test.ts b/ui-tui/src/__tests__/approvalTell.test.ts
new file mode 100644
index 00000000000..3bc976139c2
--- /dev/null
+++ b/ui-tui/src/__tests__/approvalTell.test.ts
@@ -0,0 +1,105 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { patchOverlayState, resetOverlayState } from '../app/overlayStore.js'
+import { steerOrQueue } from '../app/steerOrQueue.js'
+import { captureDestination } from '../app/submissionDestination.js'
+import { patchUiState, resetUiState } from '../app/uiStore.js'
+import { approvalAnswers } from '../app/useApprovalAnswers.js'
+import { approvalAction, approvalRows } from '../components/prompts.js'
+
+const req = { command: 'rm -rf build', description: 'recursive delete', requestId: 'r1' }
+
+const owner = () => ({ ...captureDestination(), sid: 'owner' })
+
+beforeEach(() => {
+  resetUiState()
+  resetOverlayState()
+  patchUiState({ sid: 'owner' })
+})
+
+describe('"No, and tell Hermes what to do instead" (#25693)', () => {
+  it('is offered after Deny on every prompt that has Deny, and picked by its number', () => {
+    const rows = approvalRows(req)
+
+    expect(rows).toEqual(['once', 'session', 'always', 'deny', 'tell'])
+    expect(approvalAction('5', {}, 0, rows)).toEqual({ kind: 'choose', choice: 'tell' })
+    expect(approvalRows({ ...req, smartDenied: true })).toEqual(['once', 'deny', 'tell'])
+    // Esc still denies outright: the tell row never becomes the default answer.
+    expect(approvalAction('', { escape: true }, 4, rows)).toEqual({ kind: 'choose', choice: 'deny' })
+  })
+
+  it('is not offered when the gateway sends no Deny choice', () => {
+    expect(approvalRows({ ...req, choices: ['once', 'session'] })).toEqual(['once', 'session'])
+  })
+
+  it('steers the instruction into the running turn and queues nothing', async () => {
+    const rpc = vi.fn(async () => ({ status: 'queued' }))
+    const enqueue = vi.fn()
+    const sys = vi.fn()
+
+    await steerOrQueue({ destination: owner(), enqueue, generation: 3, rpc: rpc as any, sys, text: 'use INSERT OR REPLACE' })
+
+    expect(rpc).toHaveBeenCalledWith('session.steer', {
+      execution_generation: 3,
+      session_id: 'owner',
+      text: 'use INSERT OR REPLACE'
+    })
+    expect(enqueue).not.toHaveBeenCalled()
+  })
+
+  it('keeps the words as the next prompt when the steer is refused or fails', async () => {
+    for (const rpc of [vi.fn(async () => ({ status: 'rejected' })), vi.fn(async () => Promise.reject(new Error('gone')))]) {
+      const enqueue = vi.fn()
+
+      await steerOrQueue({ destination: owner(), enqueue, rpc: rpc as any, sys: vi.fn(), text: 'do X instead' })
+
+      expect(enqueue).toHaveBeenCalledWith('do X instead', 'do X instead', expect.objectContaining({ sid: 'owner' }))
+    }
+  })
+
+  it('a late refusal queues into the session it was steered at, even after the user switched away', async () => {
+    let refuse!: (value: unknown) => void
+    const rpc = vi.fn(() => new Promise(resolve => (refuse = resolve)))
+    const enqueue = vi.fn()
+    const sys = vi.fn()
+    const steered = steerOrQueue({ destination: owner(), enqueue, rpc: rpc as any, sys, text: 'do X instead' })
+
+    patchUiState({ sid: 'other' })
+    refuse({ status: 'rejected' })
+    await steered
+
+    expect(enqueue).toHaveBeenCalledWith('do X instead', 'do X instead', expect.objectContaining({ sid: 'owner' }))
+    expect(sys).not.toHaveBeenCalled()
+  })
+
+  it('a submitted instruction locks the prompt: repeat Enter or an allow during the steer sends nothing extra', async () => {
+    const approval = { ...req }
+    let reply!: (value: unknown) => void
+    const rpc = vi.fn(() => new Promise(resolve => (reply = resolve)))
+    const respondWith = vi.fn()
+
+    patchOverlayState({ approval })
+
+    const { answerApproval, answerApprovalTell } = approvalAnswers({
+      approval,
+      canonical: false,
+      enqueue: vi.fn(),
+      respondWith,
+      rpc: rpc as any,
+      sys: vi.fn()
+    })
+
+    answerApprovalTell('use INSERT OR REPLACE')
+    answerApprovalTell('use INSERT OR REPLACE')
+    answerApproval('once')
+
+    expect(rpc).toHaveBeenCalledTimes(1)
+    expect(respondWith).not.toHaveBeenCalled()
+
+    reply({ status: 'queued' })
+    await new Promise(resolve => setImmediate(resolve))
+    answerApproval('once')
+
+    expect(respondWith.mock.calls.map(([, result]) => result)).toEqual([{ choice: 'deny' }])
+  })
+})
diff --git a/ui-tui/src/__tests__/canonicalRewindPicker.test.ts b/ui-tui/src/__tests__/canonicalRewindPicker.test.ts
new file mode 100644
index 00000000000..03b1525a8f1
--- /dev/null
+++ b/ui-tui/src/__tests__/canonicalRewindPicker.test.ts
@@ -0,0 +1,252 @@
+import { JsonRpcGatewayError } from '@hermes/shared/json-rpc-channel'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { createSlashHandler } from '../app/createSlashHandler.js'
+import { $overlayState, resetOverlayState } from '../app/overlayStore.js'
+import { rewindFocusIndex } from '../app/rewindFocusStore.js'
+import { rewindTargets } from '../app/slash/canonicalRewindPicker.js'
+import { patchUiState, resetUiState } from '../app/uiStore.js'
+import { shouldOpenRewindOnDoubleEsc } from '../app/useInputHandlers.js'
+
+const flush = () => new Promise(resolve => setImmediate(resolve))
+
+const messages = [
+  { role: 'user', content: 'first', row_id: 11 },
+  { role: 'assistant', content: 'a1', row_id: 12 },
+  { role: 'user', content: [{ type: 'input_image', image_url: 'x' }], row_id: 13 },
+  { role: 'assistant', content: 'a2', row_id: 14 },
+  { role: 'user', content: 'third question', row_id: 15 },
+  { role: 'assistant', content: 'a3', row_id: 16 }
+]
+
+function harness(rewindRefusal?: Error, repaintFailure?: Error) {
+  let cut = false
+
+  const request = vi.fn(async (method: string, params: any) => {
+    if (method === 'session.resume') {
+      if (cut && repaintFailure) {
+        throw repaintFailure
+      }
+
+      return { session_id: 'owner', revision: 7, execution_generation: 3, messages, info: { model: 'm' } }
+    }
+
+    if (method === 'session.mutate' && params.operation === 'branch') {
+      return {
+        session_id: 'owner',
+        operation: 'branch',
+        revision: 8,
+        execution_generation: 3,
+        branched_session_id: 'child'
+      }
+    }
+
+    if (method === 'session.info') {
+      return { title: 'Fork' }
+    }
+
+    if (method === 'session.mutate' && params.operation === 'rewind') {
+      if (rewindRefusal) {
+        throw rewindRefusal
+      }
+
+      cut = true
+
+      return { session_id: 'owner', operation: 'rewind', revision: 8, execution_generation: 4, rewound_count: 6 }
+    }
+
+    throw new Error(`unknown_method: ${method}`)
+  })
+
+  const sys = vi.fn()
+  const send = vi.fn()
+  const setHistoryItems = vi.fn()
+  const composer = { enqueue: vi.fn(), setInput: vi.fn() }
+
+  const ctx = {
+    slashFlightRef: { current: 0 },
+    gateway: { gw: { isCanonical: true, request }, rpc: request },
+    transcript: {
+      page: vi.fn(),
+      panel: vi.fn(),
+      send,
+      sys,
+      setHistoryItems,
+      trimLastExchange: (items: unknown[]) => items
+    },
+    local: { getHistoryItems: () => [], getLastUserMsg: () => '', maybeWarn: vi.fn() },
+    session: {
+      newSession: vi.fn(async () => patchUiState({ sid: 'fresh' })),
+      resumeById: vi.fn(async (id: string) => patchUiState({ sid: id }))
+    },
+    composer,
+    voice: {}
+  }
+
+  return { composer, ctx, request, send, setHistoryItems, slash: createSlashHandler(ctx as any), sys }
+}
+
+const mutations = (request: ReturnType<typeof harness>['request']) =>
+  request.mock.calls.filter(([method]) => method === 'session.mutate')
+
+beforeEach(() => {
+  resetUiState()
+  resetOverlayState()
+  patchUiState({
+    sid: 'owner',
+    info: { model: 'm', skills: {}, tools: {}, execution_epoch: '1', execution_generation: 3 } as any
+  })
+})
+
+describe('/rewind picker (#21910)', () => {
+  it('offers every earlier text prompt, numbered by turn; a media turn keeps its number but is not offered', () => {
+    expect(rewindTargets({ messages })).toEqual([
+      { rowId: 11, text: 'first', turn: 1 },
+      { rowId: 15, text: 'third question', throughRowId: 14, turn: 3 }
+    ])
+  })
+
+  it('cuts nothing until the edit is sent, then rewinds to the PICKED row and sends the edited text', async () => {
+    const { request, send, setHistoryItems, slash } = harness()
+
+    slash('/rewind')
+    await flush()
+
+    const picker = $overlayState.get().rewind
+
+    expect(picker?.targets.map(target => target.rowId)).toEqual([11, 15])
+    expect(mutations(request)).toHaveLength(0)
+
+    picker!.onSubmit(picker!.targets[0]!, 'first, but in French')
+    await flush()
+    await flush()
+
+    expect(mutations(request)).toHaveLength(1)
+    expect(mutations(request)[0]![1]).toMatchObject({
+      expected_revision: 7,
+      expected_generation: 3,
+      operation: 'rewind',
+      payload: { target_message_id: 11 }
+    })
+    expect(setHistoryItems).toHaveBeenCalled()
+    expect(send).toHaveBeenCalledWith('first, but in French')
+  })
+
+  it('a busy refusal at send time prints the stop-first text and sends nothing', async () => {
+    const busy = new JsonRpcGatewayError('session_busy', { code: 4001, data: { reason: 'session_busy' } })
+    const { composer, send, slash, sys } = harness(busy)
+
+    slash('/rewind')
+    await flush()
+    $overlayState.get().rewind!.onSubmit($overlayState.get().rewind!.targets[1]!, 'again')
+    await flush()
+    await flush()
+
+    expect(send).not.toHaveBeenCalled()
+    expect(sys.mock.calls.map(([text]) => String(text)).join('\n')).toContain('Stop the current reply first')
+    // Nothing was cut, so the edit goes back into the composer instead of vanishing with the picker.
+    expect(composer.setInput).toHaveBeenCalledWith('again')
+  })
+
+  it("a cut that commits but cannot repaint keeps the edit as that session's next prompt", async () => {
+    const { composer, send, slash } = harness(undefined, new Error('transport closed'))
+
+    slash('/rewind')
+    await flush()
+    $overlayState.get().rewind!.onSubmit($overlayState.get().rewind!.targets[0]!, 'first, edited')
+    await flush()
+    await flush()
+    await flush()
+
+    expect(send).not.toHaveBeenCalled()
+    expect(composer.enqueue).toHaveBeenCalledWith(
+      'first, edited',
+      'first, edited',
+      expect.objectContaining({ sid: 'owner' })
+    )
+  })
+
+  it('does not open while a turn runs', async () => {
+    patchUiState({ busy: true })
+    const { request, slash } = harness()
+
+    slash('/rewind')
+    await flush()
+
+    expect($overlayState.get().rewind).toBeNull()
+    expect(request.mock.calls.some(([method]) => method === 'session.resume' || method === 'session.mutate')).toBe(
+      false
+    )
+  })
+})
+
+describe('/rewind fork from here', () => {
+  it('branches through the row before the picked prompt, switches to the child and prefills the prompt unsent', async () => {
+    const { composer, ctx, request, send, slash } = harness()
+
+    slash('/rewind')
+    await flush()
+    const picker = $overlayState.get().rewind!
+
+    picker.onFork(picker.targets[1]!)
+    await flush()
+    await flush()
+    await flush()
+
+    expect(mutations(request)).toHaveLength(1)
+    expect(mutations(request)[0]![1]).toMatchObject({
+      session_id: 'owner',
+      operation: 'branch',
+      payload: { through_message_id: 14 }
+    })
+    expect(ctx.session.resumeById).toHaveBeenCalledWith('child')
+    expect(composer.setInput).toHaveBeenCalledWith('third question')
+    expect(send).not.toHaveBeenCalled()
+  })
+
+  it('forking the first prompt opens a plain new session with it prefilled and mutates nothing', async () => {
+    const { composer, ctx, request, slash } = harness()
+
+    slash('/rewind')
+    await flush()
+    const picker = $overlayState.get().rewind!
+
+    picker.onFork(picker.targets[0]!)
+    await flush()
+    await flush()
+
+    expect(mutations(request)).toHaveLength(0)
+    expect(ctx.session.newSession).toHaveBeenCalled()
+    expect(composer.setInput).toHaveBeenCalledWith('first')
+  })
+})
+
+describe('rewind focus in the transcript', () => {
+  const rows = [
+    { role: 'system', text: 'intro' },
+    { role: 'user', text: 'alpha' },
+    { role: 'assistant', text: 'a' },
+    { role: 'user', text: 'beta' },
+    { role: 'assistant', text: 'b' }
+  ]
+
+  it('finds the picked prompt by its turn, falls back to its text, and is -1 when closed', () => {
+    expect(rewindFocusIndex(rows, { text: 'beta', turn: 2 })).toBe(3)
+    expect(rewindFocusIndex(rows, { text: 'beta', turn: 5 })).toBe(3)
+    expect(rewindFocusIndex(rows, { text: 'gone', turn: 1 })).toBe(-1)
+    expect(rewindFocusIndex(rows, null)).toBe(-1)
+  })
+})
+
+describe('idle double-Esc opens the rewind picker', () => {
+  const idle = { blocked: false, busy: false, canonical: true, hasDraft: false, hasSession: true }
+
+  it('only on an idle, empty composer with no overlay', () => {
+    expect(shouldOpenRewindOnDoubleEsc(idle)).toBe(true)
+    expect(shouldOpenRewindOnDoubleEsc({ ...idle, busy: true })).toBe(false)
+    expect(shouldOpenRewindOnDoubleEsc({ ...idle, hasDraft: true })).toBe(false)
+    expect(shouldOpenRewindOnDoubleEsc({ ...idle, blocked: true })).toBe(false)
+    expect(shouldOpenRewindOnDoubleEsc({ ...idle, hasSession: false })).toBe(false)
+    expect(shouldOpenRewindOnDoubleEsc({ ...idle, canonical: false })).toBe(false)
+  })
+})
