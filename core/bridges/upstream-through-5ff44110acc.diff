@@ -0,0 +1,48 @@
+"""``gateway.bot_loop_guard.max_hops`` / ``bot_replies_expect_reply`` read from a real config.yaml through
+the loader both consumers use (``gateway.bot_loop_guard.load_settings``): the messaging gateway's chain
+rules and Bot Mode's ``agent/bot_chain.py`` (#137027)."""
+
+import json
+
+import pytest
+
+from gateway.bot_loop_guard import BotLoopGuard, load_settings
+
+
+@pytest.fixture
+def config_home(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+    def write(block: dict) -> None:
+        # JSON is YAML; the CI test env ships no pyyaml for fixtures.
+        (home / "config.yaml").write_text(json.dumps({"gateway": {"bot_loop_guard": block}}), encoding="utf-8")
+    return write
+
+
+def test_max_hops_and_reply_rule_from_config_yaml_drive_the_gateway_chain(config_home):
+    config_home({"max_hops": 2, "bot_replies_expect_reply": True})
+    assert (load_settings().max_hops, load_settings().bot_replies_expect_reply) == (2, True)
+
+    guard = BotLoopGuard()
+    verdicts = []
+    for n in range(4):
+        verdicts.append(guard.chain_admit("chat", "peer", f"ping {n}", is_bot=True)[1])
+        guard.note_reply("chat", "peer")  # replies expected: answering an answer is allowed
+    assert verdicts == ["ok", "ok", "max_hops", "max_hops"]
+
+
+def test_max_hops_from_config_yaml_caps_bot_mode_sends(config_home, monkeypatch):
+    from types import SimpleNamespace
+
+    from agent import bot_chain
+
+    monkeypatch.setattr(bot_chain, "_CHAINS", {})
+    config_home({"max_hops": 2, "bot_replies_expect_reply": False})
+    agent = SimpleNamespace(session_id="s", _turn_author={"id": "bot:alpha", "name": "alpha", "is_bot": True})
+    bot_chain.on_turn_start(agent, agent._turn_author, None, "hi")
+
+    reply = bot_chain.admit_send(agent, ["bot:alpha"], "answer")
+    assert reply.refusal is None and reply.notify_only == {"bot:alpha"}  # bot_replies_expect_reply: false
+    assert "limit of 2" in str(bot_chain.admit_send(agent, ["bot:gamma"], "next").refusal)
diff --git a/tests/gateway/test_bot_peer_runtime_notices.py b/tests/gateway/test_bot_peer_runtime_notices.py
new file mode 100644
index 00000000000..49733cce9c8
--- /dev/null
+++ b/tests/gateway/test_bot_peer_runtime_notices.py
@@ -0,0 +1,148 @@
+"""Runtime notices never reach a bot peer (#137027): the busy path, the failure copy, progress lanes.
+
+Each of these is a message the runtime wrote, not the model; delivered to another bot it is a new
+inbound turn there, which answers it, which is a new turn here. The model's own reply still goes.
+"""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway.platforms.base import MessageEvent
+from gateway.run_turn import GatewayTurnMixin
+from gateway.session import Platform, SessionSource
+
+
+def _source(is_bot):
+    return SessionSource(platform=Platform.MATTERMOST, chat_id="dm", chat_type="dm", user_id="peer", is_bot=is_bot)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("is_bot, sent", [(True, False), (False, True)], ids=["bot peer", "human control"])
+async def test_every_busy_path_reply_skips_a_bot_peer(is_bot, sent):
+    """The drain notice, skill reply and approval echo share ``_send_busy_reply`` with the ack."""
+    from gateway.run import GatewayRunner
+
+    runner = object.__new__(GatewayRunner)
+    runner._reply_anchor_for_event = lambda event: None
+    runner._thread_metadata_for_source = lambda source, anchor=None: None
+    adapter = SimpleNamespace(_send_with_retry=AsyncMock())
+    event = MessageEvent(text="x", message_id="m", source=_source(is_bot))
+
+    await GatewayRunner._send_busy_reply(runner, event, adapter, "Gateway is restarting; your message is queued.")
+
+    assert adapter._send_with_retry.await_count == (1 if sent else 0)
+
+
+class _Runner(GatewayTurnMixin):
+    def _silence_allowed_for_source(self, source, display_kind, reply_expected, agent_result):
+        from gateway.response_filters import silence_allowed
+        return silence_allowed(display_kind, reply_expected)
+
+    def __init__(self):
+        self.async_session_store = SimpleNamespace(clear_resume_pending=self._noop)
+
+    async def _noop(self, *_a, **_k):
+        return None
+
+    async def _clear_restart_failure_count(self, *_a, **_k):
+        return None
+
+
+async def _shape(agent_result, source):
+    return await _Runner()._hmwa_shape_agent_response(
+        agent_result, source, history=[], session_entry=SimpleNamespace(session_id="s"), session_key=None,
+        _quick_key=None, run_generation=0, _run_start_session_id="s", _platform_name="mattermost",
+        _msg_start_time=0.0)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("agent_result", [
+    {"final_response": "", "interrupted": True, "api_calls": 0, "messages": []},
+    {"final_response": "(empty)", "model": "m", "api_calls": 2, "messages": []},
+    {"final_response": "", "failed": True, "error": "boom", "api_calls": 1, "messages": []},
+], ids=["interrupted before start", "empty after retries", "failed turn"])
+async def test_runtime_failure_copy_is_not_the_reply_to_a_bot(agent_result):
+    response, _silent, _messages = await _shape(dict(agent_result), _source(True))
+    assert response == ""
+    human, _silent, _messages = await _shape(dict(agent_result), _source(False))
+    assert human  # the human control still gets the explanation
+
+
+@pytest.mark.asyncio
+async def test_the_models_reply_to_a_bot_is_still_delivered_and_its_silence_is_honoured():
+    response, silent, _ = await _shape({"final_response": "4", "api_calls": 1, "messages": []}, _source(True))
+    assert (response, silent) == ("4", False)
+    response, silent, _ = await _shape({"final_response": "[SILENT]", "api_calls": 1, "messages": []}, _source(True))
+    assert silent is True and response != _unexpected()
+
+
+def _unexpected():
+    from gateway.run_turn import _unexpected_silence_reply
+    return _unexpected_silence_reply()
+
+
+def test_status_and_notice_callbacks_stay_quiet_for_a_bot_peer():
+    from gateway.run_turn_runner import TurnRunner
+
+    turn_runner = object.__new__(TurnRunner)
+    turn_runner._schedule = MagicMock()
+    turn_runner._ctx = SimpleNamespace(
+        mute_notification_reply=False, source=_source(True), _status_adapter=object(),
+        _run_still_current=lambda: True, user_config={}, _status_chat_id="dm",
+        _status_thread_metadata=None, _cleanup_progress=False)
+
+    turn_runner._status_callback_sync("lifecycle", "⚠️ Model fallback: primary unavailable")
+    turn_runner._notice_callback_sync(SimpleNamespace(key="credits.low", text="Credits are low", level="warn"))
+
+    turn_runner._schedule.assert_not_called()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("reply_expected", [True, None], ids=["addressed (DM / mention)", "unaddressed"])
+async def test_an_addressed_bot_may_still_end_the_exchange_in_silence(reply_expected):
+    """Greptile 4467193953: Telegram/Slack set reply_expected=True for a DM or mention, bots included;
+    the silence fallback would then be runtime text the peer answers."""
+    runner = _Runner()
+    response, silent, _ = await runner._hmwa_shape_agent_response(
+        {"final_response": "[SILENT]", "api_calls": 1, "messages": []}, _source(True), history=[],
+        session_entry=SimpleNamespace(session_id="s"), session_key=None, _quick_key=None, run_generation=0,
+        _run_start_session_id="s", _platform_name="telegram", _msg_start_time=0.0, reply_expected=reply_expected)
+    assert silent is True and response != _unexpected()
+    human, silent, _ = await runner._hmwa_shape_agent_response(
+        {"final_response": "[SILENT]", "api_calls": 1, "messages": []}, _source(False), history=[],
+        session_entry=SimpleNamespace(session_id="s"), session_key=None, _quick_key=None, run_generation=0,
+        _run_start_session_id="s", _platform_name="telegram", _msg_start_time=0.0, reply_expected=True)
+    assert silent is False and human == _unexpected()  # the human control keeps the visible fallback
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("is_bot, sent", [(True, 0), (False, 1)], ids=["bot peer", "human control"])
+async def test_platform_notices_and_the_inactivity_warning_skip_a_bot_peer(is_bot, sent):
+    """Greptile 4467193888: the delegation-failure notice (``_deliver_platform_notice``) and the
+    inactivity warning sent straight to the adapter both go through the one bot-peer policy."""
+    from gateway.run import GatewayRunner
+
+    adapter = SimpleNamespace(send=AsyncMock(), emit_warning=AsyncMock(), config=None)
+    runner = object.__new__(GatewayRunner)
+    runner.config = None
+    runner._delivery_adapter_for = lambda source: adapter
+    runner._thread_metadata_for_source = lambda source, anchor=None: None
+    source = _source(is_bot)
+
+    await GatewayRunner._deliver_platform_notice(runner, source, "⚠️ Subagent failed: timeout")
+    worker = SimpleNamespace(agent_warning=600, agent_timeout=1200)
+    await GatewayRunner._run_agent_inactivity_warning(runner, worker, source, None)
+
+    assert adapter.send.await_count == sent and adapter.emit_warning.await_count == sent
+
+
+
+@pytest.mark.parametrize("is_bot", [True, False], ids=["bot peer", "human control"])
+def test_the_runtime_footer_is_not_sent_to_a_bot_peer(monkeypatch, is_bot):
+    import gateway.runtime_footer as footer
+
+    monkeypatch.setattr(footer, "build_footer_line", lambda **kw: "— model · 3s")
+    line = _Runner()._hmwa_runtime_footer_line({"model": "m"}, _source(is_bot), 3.0)
+    assert line == ("" if is_bot else "— model · 3s")
diff --git a/tests/gateway/test_bot_to_bot_chain.py b/tests/gateway/test_bot_to_bot_chain.py
new file mode 100644
index 00000000000..0be651046e8
--- /dev/null
+++ b/tests/gateway/test_bot_to_bot_chain.py
@@ -0,0 +1,119 @@
+"""Bot-to-bot exchanges end (#137027): the messaging gateway's chain rules (``BotLoopGuard.chain_admit``).
+The Bot Mode hop cap is ``tests/agent/test_bot_chain.py``; the tool entry ``tests/tools/test_bot_mode_dm_chain.py``.
+
+Two Hermes gateways DMing each other on Mattermost ran 17 h because every inbound bot message
+produced an outbound one (runtime notices included) and nothing counted the exchange.
+"""
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.bot_loop_guard import BotLoopGuard, BotLoopGuardSettings, configured_bot_user, settings_from_config
+from gateway.session import Platform, SessionSource
+
+CHAT = "dm_peer"
+PEER = "peer_bot"
+HUMAN = "alice"
+
+
+@pytest.fixture
+def clock():
+    state = {"t": 1_000.0}
+    return SimpleNamespace(now=lambda: state["t"], advance=lambda s: state.__setitem__("t", state["t"] + s))
+
+
+def _guard(clock, **overrides):
+    settings = BotLoopGuardSettings(**{"max_events": 1000, "window_seconds": 60, "cooldown_seconds": 600, **overrides})
+    return BotLoopGuard(settings=lambda: settings, clock=clock.now)
+
+
+# --- messaging gateway chain rules -------------------------------------------------------------
+
+
+def test_a_bot_ping_pong_stops_at_max_hops_and_a_human_message_starts_a_new_chain(clock):
+    guard = _guard(clock, max_hops=3, bot_replies_expect_reply=True)
+    verdicts = [guard.chain_admit(CHAT, PEER, f"ping {n}", is_bot=True)[0] for n in range(10)]
+    assert verdicts == [True, True, True] + [False] * 7
+
+    assert guard.chain_admit(CHAT, HUMAN, "keep going", is_bot=False) == (True, "human")
+    assert guard.chain_admit(CHAT, PEER, "ping 10", is_bot=True) == (True, "ok")
+
+
+def test_a_bot_answering_this_bots_reply_starts_no_turn_by_default(clock):
+    """The default reply rule: our answer to a bot needs no answer, so its answer to that ends it."""
+    guard = _guard(clock)
+    assert guard.chain_admit(CHAT, PEER, "what is 2+2?", is_bot=True) == (True, "ok")
+    guard.note_reply(CHAT, PEER)  # our "4" went out
+    assert guard.chain_admit(CHAT, PEER, "thanks!", is_bot=True) == (False, "reply_to_reply")
+    # Another bot in the same chat is a new ask, not a reply to our reply.
+    assert guard.chain_admit(CHAT, "other_bot", "hello", is_bot=True) == (True, "ok")
+
+
+def test_a_second_ask_before_any_reply_is_not_a_reply(clock):
+    """Greptile 4467194010: admission is not an answer. A bot's follow-up while its first message waits
+    (or after a turn that stayed silent) is a new ask, still capped by max_hops."""
+    guard = _guard(clock, max_hops=3)
+    assert guard.chain_admit(CHAT, PEER, "question", is_bot=True) == (True, "ok")
+    assert guard.chain_admit(CHAT, PEER, "also this", is_bot=True) == (True, "ok")
+    guard.note_reply(CHAT, PEER)
+    assert guard.chain_admit(CHAT, PEER, "thanks", is_bot=True) == (False, "reply_to_reply")
+
+
+def test_the_same_ask_repeated_inside_one_chain_is_one_hop(clock):
+    guard = _guard(clock, bot_replies_expect_reply=True)
+    assert guard.chain_admit(CHAT, PEER, "Interrupting current task", is_bot=True) == (True, "ok")
+    assert guard.chain_admit(CHAT, "bot_b", "x", is_bot=True)[0] is True
+    assert guard.chain_admit(CHAT, PEER, "  Interrupting   current task ", is_bot=True) == (False, "duplicate")
+
+
+def test_chain_rules_follow_enabled_and_config(clock):
+    off = BotLoopGuard(settings=lambda: BotLoopGuardSettings(enabled=False, max_hops=1), clock=clock.now)
+    assert all(off.chain_admit(CHAT, PEER, "same", is_bot=True)[0] for _ in range(5))
+    cfg = settings_from_config({"gateway": {"bot_loop_guard": {"max_hops": 7, "bot_replies_expect_reply": "yes"}}})
+    assert (cfg.max_hops, cfg.bot_replies_expect_reply) == (7, True)
+    assert settings_from_config({}).max_hops == 4 and settings_from_config({}).bot_replies_expect_reply is False
+
+
+@pytest.mark.asyncio
+async def test_ingress_drops_the_bot_reply_and_still_admits_the_human(monkeypatch, clock):
+    from gateway.platforms.base import MessageEvent
+    from gateway.run import GatewayRunner
+
+    runner = object.__new__(GatewayRunner)
+    runner._scale_to_zero_note_real_inbound = lambda: None
+
+    async def _passthrough(event, source):
+        return event
+    runner._hm_pre_gateway_dispatch_hook = _passthrough
+    runner._is_user_authorized_for_source = lambda source, **kw: True
+    runner._bot_loop_guard = _guard(clock)
+    runner._adapter_profile_for_source = lambda source: ""
+
+    def _event(user, text, is_bot):
+        source = SessionSource(platform=Platform.MATTERMOST, chat_id=CHAT, chat_type="dm", user_id=user, is_bot=is_bot)
+        return MessageEvent(text=text, message_id=text, source=source)
+
+    from gateway.session_ingress import executing_admission
+
+    first = _event(PEER, "question", True)
+    assert await runner._hm_admit_event(first) is not None
+    runner._note_bot_reply(first.source)  # the turn's reply was delivered
+    # The session authority executes the admitted row through the same handler: not a second hop.
+    token = executing_admission.set(True)
+    try:
+        assert await runner._hm_admit_event(first) is not None
+    finally:
+        executing_admission.reset(token)
+    assert await runner._hm_admit_event(_event(PEER, "answer to your answer", True)) is None
+    assert await runner._hm_admit_event(_event(HUMAN, "hi", False)) is not None
+    assert await runner._hm_admit_event(_event(PEER, "new question", True)) is not None
+
+
+def test_bot_users_marks_a_peer_on_a_platform_without_a_bot_flag():
+    config = SimpleNamespace(extra={"bot_users": ["peer_bot", " other "]})
+    assert configured_bot_user(config, "peer_bot") and configured_bot_user(config, "other")
+    assert not configured_bot_user(config, HUMAN)
+    assert configured_bot_user(SimpleNamespace(extra={"bot_users": "a,peer_bot"}), "peer_bot")
+    assert not configured_bot_user(SimpleNamespace(extra={}), "peer_bot")
