+        try:
+            packages = json.loads((entry.parent / "facts.json").read_text(encoding="utf-8-sig"))["packages"]
+        except (OSError, ValueError, KeyError, TypeError):
+            continue
+        if isinstance(packages, dict) and "python" in packages:
+            return True
+    return False
