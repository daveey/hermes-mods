diff --git a/tests/e2e/test_platform_sdk_mocks.py b/tests/e2e/test_platform_sdk_mocks.py
new file mode 100644
index 00000000000..f4cf33483b6
--- /dev/null
+++ b/tests/e2e/test_platform_sdk_mocks.py
@@ -0,0 +1,97 @@
+"""Guards for the platform-SDK mocks installed by ``tests/e2e/conftest.py``.
+
+The conftest fakes the ``telegram`` / ``discord`` / ``slack`` packages so the
+adapters import without their SDKs installed. Faking is only correct when the
+SDK really is absent: a real, installed SDK must never be swapped for a mock,
+otherwise the e2e suite exercises a MagicMock while claiming to exercise the
+real client interface (issue #147239).
+"""
+
+import importlib
+import sys
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import pytest
+
+from tests.e2e import conftest as e2e_conftest
+
+# platform id -> module names the conftest fakes for it
+FAKED_SDKS = {
+    "telegram": ("telegram",),
+    "discord": ("discord",),
+    "slack": ("slack_bolt", "slack_sdk"),
+}
+
+
+def _ensure(platform_name: str) -> None:
+    {
+        "telegram": e2e_conftest._ensure_telegram_mock,
+        "discord": e2e_conftest._ensure_discord_mock,
+        "slack": e2e_conftest._ensure_slack_mock,
+    }[platform_name]()
+
+
+@pytest.fixture
+def platform_modules():
+    """Snapshot the faked platform modules and restore them after the test.
+
+    Tests here delete entries from :data:`sys.modules` to simulate "not imported
+    yet" / "not installed"; without the restore the rest of the session would run
+    without the conftest mocks it depends on.
+    """
+    roots = {root for names in FAKED_SDKS.values() for root in names}  # module roots, not platform ids
+
+    def _owned(name: str) -> bool:
+        return name.split(".", 1)[0] in roots
+
+    snapshot = {name: mod for name, mod in sys.modules.items() if _owned(name)}
+    yield
+    for name in [name for name in sys.modules if _owned(name)]:
+        del sys.modules[name]
+    sys.modules.update(snapshot)
+
+
+def _drop(*names: str) -> None:
+    for name in [name for name in sys.modules if name.split(".", 1)[0] in names]:
+        del sys.modules[name]
+
+
+def _write_fake_sdk(root: Path, name: str, body: str = "") -> None:
+    package = root / name
+    package.mkdir()
+    (package / "__init__.py").write_text(
+        body or f'"""Installed stand-in for the {name} SDK."""\n', encoding="utf-8"
+    )
+
+
+@pytest.mark.parametrize("platform_name", sorted(FAKED_SDKS))
+def test_installed_sdk_is_not_replaced_by_the_mock(platform_name, tmp_path, monkeypatch, platform_modules):
+    """An installed-but-not-yet-imported SDK must survive the conftest."""
+    names = FAKED_SDKS[platform_name]
+    for name in names:
+        _write_fake_sdk(tmp_path, name)
+    monkeypatch.syspath_prepend(str(tmp_path))
+    _drop(*names)
+
+    _ensure(platform_name)
+
+    for name in names:
+        assert name not in sys.modules, f"{name} is installed but conftest installed a fake"
+        mod = importlib.import_module(name)
+        assert Path(mod.__file__).resolve().is_relative_to(tmp_path)
+        assert not isinstance(mod, MagicMock)
+
+
+@pytest.mark.parametrize("platform_name", sorted(FAKED_SDKS))
+def test_missing_sdk_still_gets_the_mock(platform_name, monkeypatch, platform_modules):
+    """With no SDK on the path the fake is still installed — that is the legit case."""
+    names = FAKED_SDKS[platform_name]
+    _drop(*names)
+    # Pretend nothing of this name is installed, whatever the test env has.
+    monkeypatch.setattr(importlib.util, "find_spec", lambda *args, **kwargs: None)
+
+    _ensure(platform_name)
+
+    for name in names:
+        assert isinstance(sys.modules[name], MagicMock), f"{name} was not mocked"
diff --git a/tests/fakes/main_era_venv.py b/tests/fakes/main_era_venv.py
new file mode 100644
index 00000000000..edd9076745b
--- /dev/null
+++ b/tests/fakes/main_era_venv.py
@@ -0,0 +1,49 @@
+"""A checkout's in-tree venv as a main-era installer or a developer built it, without building one.
+
+Shared by the PM and update suites that test the pre-PM venv carry: PM reads that venv's
+``pyvenv.cfg`` and site-packages, never imports it, so a directory tree with the right files is
+the real input.
+"""
+import json
+from pathlib import Path
+
+_TOP_LEVEL = ("agent", "hermes_cli", "tools")
+
+
+def site_packages(root: Path, name: str = "venv") -> Path:
+    return root / name / "lib" / "python3.11" / "site-packages"
+
+
+def main_era_venv(root: Path, *anchors: str, name: str = "venv", reinstalled_from_pm_tree: bool = False) -> Path:
+    """``root/<name>`` as a main-era installer left it: Hermes installed on a uv-managed Python.
+
+    ``reinstalled_from_pm_tree``: a pre-PM updater then ran ``uv pip install -e .[all]`` from the
+    tree it had just pulled, so the dist-info is the PM tree's (its top level lists ``pm``).
+    """
+    home = root.parent / "uv-python" / "cpython-3.11.9-linux-x86_64-gnu" / "bin"
+    top_level = (*_TOP_LEVEL, "pm") if reinstalled_from_pm_tree else _TOP_LEVEL
+    return _hermes_installed(root, name, anchors, home=home, top_level=top_level)
+
+
+def pm_built_venv(root: Path, *anchors: str, name: str = ".venv") -> Path:
+    """``root/<name>`` as ``pm.build_env --source . --out .venv`` built it before PM marked its
+    environments: on PM's pinned Python, from a tool store beside *root*."""
+    store = root.parent / "pm-tools"
+    entry = store / "python-3.14.9+20261021-linux-x64"
+    (entry / "bin").mkdir(parents=True, exist_ok=True)
+    (store / "facts.json").write_text(json.dumps({"schema": 1, "packages": {"python": {
+        "entry": entry.name, "target": "linux-x64", "version": "3.14.9+20261021"}}}), encoding="utf-8")
+    return _hermes_installed(root, name, anchors, home=entry / "bin", top_level=(*_TOP_LEVEL, "pm"))
+
+
+def _hermes_installed(root: Path, name: str, anchors, *, home: Path, top_level: tuple[str, ...]) -> Path:
+    (root / name).mkdir(parents=True, exist_ok=True)
+    (root / name / "pyvenv.cfg").write_text(f"home = {home}\ninclude-system-site-packages = false\n",
+                                            encoding="utf-8")
+    site = site_packages(root, name)
+    dist = site / "hermes_agent-0.0.0.dist-info"
+    dist.mkdir(parents=True, exist_ok=True)
+    (dist / "top_level.txt").write_text("\n".join(top_level) + "\n", encoding="utf-8")
+    for anchor in anchors:
+        (site / anchor).mkdir(parents=True, exist_ok=True)
+    return site
