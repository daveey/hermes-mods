+)
+def test_blocked_overflow_warning_is_suppressed_in_multi_user_chats(chat_type):
+    warning = CONTEXT_OVERFLOW_BLOCKED_WARNING_TEMPLATE.format(
+        tokens=85_000, threshold=72_000, reason="cooldown:30"
+    )
