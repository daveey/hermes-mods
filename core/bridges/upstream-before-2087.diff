diff --git a/tests/plugins/platforms/telegram/test_item_notes_admission.py b/tests/plugins/platforms/telegram/test_item_notes_admission.py
new file mode 100644
index 00000000000..1b0beeddd56
--- /dev/null
+++ b/tests/plugins/platforms/telegram/test_item_notes_admission.py
@@ -0,0 +1,87 @@
+"""An oversized-file note never costs the message: the event the adapter dispatches (single file or
+album) passes the real native admission, with the caption and every per-item note in its text."""
+
+import weakref
+from datetime import UTC, datetime
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway.config import GatewayConfig, Platform, PlatformConfig
+from gateway.run import GatewayRunner
+from gateway.run_runtime import initialize_gateway_runtime
+from gateway.runtime_ownership import process_ownership
+from gateway.session_authorities import active_authority
+from gateway.session_ingress import admit_message
+from gateway.session_ingress_context import native_callback, register_transport_home
+from plugins.platforms.telegram.adapter import TelegramAdapter
+from tests.gateway.test_telegram_documents import _make_document, _make_message
+from tests.waiting import async_wait_until
+
+TOO_BIG = 500 * 1024 * 1024
+
+
+def _update(msg):
+    return SimpleNamespace(update_id=1, message=msg, effective_message=msg, channel_post=None,
+                           business_message=None, edited_business_message=None)
+
+
+def _zip(caption=None, group=None):
+    msg = _make_message(document=_make_document("report.zip", "application/zip", file_size=TOO_BIG),
+                        caption=caption, media_group_id=group)
+    # A real update always carries a date (the envelope stamps it) and no reply unless it is one.
+    msg.date, msg.reply_to_message, msg.quote, msg.external_reply = datetime.now(UTC), None, None, None
+    return msg
+
+
+async def _dispatched(items):
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="t", extra={"media_group_wait_seconds": 0.05}))
+    adapter.handle_message = AsyncMock()
+    adapter._is_callback_user_authorized = lambda user_id, **_kw: True
+    for item in items:
+        await adapter._handle_media_message(_update(item), MagicMock())
+    await async_wait_until(lambda: adapter.handle_message.await_count, timeout=5)
+    adapter.handle_message.assert_awaited_once()
+    return adapter.handle_message.await_args.args[0]
+
+
+async def _admit(tmp_path, monkeypatch, event):
+    root = tmp_path / ".hermes"
+    root.mkdir(mode=0o700)
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(root))
+    import hermes_state
+    monkeypatch.setattr(hermes_state, "DEFAULT_DB_PATH", hermes_state._IMPORT_DEFAULT_DB_PATH)
+    config = GatewayConfig()
+    config._runtime_profile_homes = (("default", root),)
+    runner = GatewayRunner(config)
+    process_ownership.reserve([root])
+    try:
+        await initialize_gateway_runtime(runner)
+        register_transport_home(runner, None, root)
+        transport = object.__new__(TelegramAdapter)
+        runner.adapters = {Platform.TELEGRAM: transport}
+        runner._is_user_authorized_for_source = lambda *a, **k: True
+        event.source._transport_adapter_ref = weakref.ref(transport)
+        with native_callback(runner, event, root, None):
+            return await admit_message(active_authority(runner), event)
+    finally:
+        for authority in list(getattr(runner, "session_authorities", []) or []):
+            authority.db.close()
+        process_ownership.release(root)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("items", [lambda: [_zip("here it is")],
+                                   lambda: [_zip("here it is", "mg"), _zip(None, "mg")]], ids=["single", "album"])
+async def test_oversized_file_message_passes_native_admission(tmp_path, monkeypatch, items):
+    monkeypatch.setattr("gateway.platforms.base.DOCUMENT_CACHE_DIR", tmp_path / "docs")
+    built = items()
+    event = await _dispatched(built)
+    assert event.text.count("here it is") == 1 and event.text.count("too large") == len(built), event.text
+
+    reply = await _admit(tmp_path, monkeypatch, event)
+
+    assert not (reply and "refused" in reply), reply
diff --git a/tests/plugins/platforms/telegram/test_rich_message_addressing.py b/tests/plugins/platforms/telegram/test_rich_message_addressing.py
new file mode 100644
index 00000000000..19322c928aa
--- /dev/null
+++ b/tests/plugins/platforms/telegram/test_rich_message_addressing.py
@@ -0,0 +1,86 @@
+"""A text-less ``rich_message`` group message is addressed exactly like the same text sent as plain text (#151730):
+every addressing check (other-bot leading mention, ``/cmd@other_bot``, wake words, the reply-expected rule and the
+other-participant guard on handle stripping) reads the same text, so a message meant for another bot stays theirs."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.platforms.event import MessageType
+from plugins.platforms.telegram.telegram_context import group_reply_expected, group_trigger_text
+from tests.gateway.test_telegram_group_gating import _group_message, _make_adapter
+
+
+def _rich(*paragraphs):
+    msg = _group_message(None)
+    blocks = [p if isinstance(p, dict) else {"type": "paragraph", "text": p} for p in paragraphs]
+    msg.api_kwargs = {"rich_message": {"blocks": blocks}}
+    return msg
+
+
+def _plain(text, *spans):
+    return _group_message(text, entities=[SimpleNamespace(type=t, offset=text.index(s), length=len(s)) for t, s in spans])
+
+
+_LINK = ["see ", {"type": "url", "text": "docs", "url": "https://chompy.example.com/docs"}]
+_BOTH = "@hermes_bot , @ops_bot are you both listening?"
+
+
+def _gate(extra, msg):
+    return _make_adapter(**extra)._should_process_message(msg)
+
+
+def _reply_expected(extra, msg):
+    return group_reply_expected(_make_adapter(**extra), msg, "group")
+
+
+def _trigger_text(extra, msg):
+    adapter = _make_adapter(**extra)
+    return group_trigger_text(adapter, msg, adapter._build_message_event(msg, MessageType.TEXT).text.split("\n")[0])
+
+
+@pytest.mark.parametrize("probe, extra, plain, rich, expected", [
+    (_gate, {"require_mention": False}, _plain("@other_bot please deploy now", ("mention", "@other_bot")),
+     _rich("@other_bot please deploy now", "p2"), False),
+    (_gate, {"require_mention": False}, _plain("/status@other_bot now", ("bot_command", "/status@other_bot")),
+     _rich("/status@other_bot now", "second paragraph"), False),
+    (_gate, {"require_mention": True, "mention_patterns": [r"\bchompy\b"]},
+     _group_message("see docs", entities=[SimpleNamespace(type="text_link", offset=4, length=4,
+                                                          url="https://chompy.example.com/docs")]),
+     _rich(_LINK), False),
+    (_reply_expected, {"require_mention": False}, _plain("anyone around?"), _rich("anyone around?", "p2"), None),
+    (_trigger_text, {"require_mention": True},
+     _plain(_BOTH, ("mention", "@hermes_bot"), ("mention", "@ops_bot")), _rich(_BOTH), _BOTH),
+    # Leading code is content, as in plain text: the later foreign handle is not the addressee.
+    (_gate, {"require_mention": False}, _plain("x @other_bot please explain", ("code", "x"), ("mention", "@other_bot")),
+     _rich([{"type": "code", "text": "x"}, " @other_bot please explain"]), True),
+    (_gate, {"require_mention": False}, _plain("ls\n@other_bot run it", ("pre", "ls"), ("mention", "@other_bot")),
+     _rich({"type": "pre", "text": "ls"}, "@other_bot run it"), True),
+    # The opposite side: a rich message addressed to us is still answered, and our sole handle is still stripped.
+    (_gate, {"require_mention": True}, _plain("@hermes_bot deploy", ("mention", "@hermes_bot")),
+     _rich("@hermes_bot deploy", "p2"), True),
+    (_gate, {"require_mention": True}, _plain("/status@hermes_bot", ("bot_command", "/status@hermes_bot")),
+     _rich("/status@hermes_bot", "p2"), True),
+    (_trigger_text, {"require_mention": True}, _plain("@hermes_bot deploy", ("mention", "@hermes_bot")),
+     _rich("@hermes_bot deploy"), "deploy"),
+])
+def test_rich_only_group_message_is_addressed_like_plain_text(probe, extra, plain, rich, expected):
+    assert probe(extra, plain) == expected
+    assert probe(extra, rich) == expected
+
+def test_rich_linked_foreign_command_does_not_override_our_mention():
+    """A rich hyperlink label is text_link, not Telegram's bot_command entity (#151730)."""
+    linked = "/status@other_bot"
+    plain = _group_message(
+        f"{linked} @hermes_bot",
+        entities=[
+            SimpleNamespace(type="text_link", offset=0, length=len(linked),
+                            url="https://example.com/status"),
+            SimpleNamespace(type="mention", offset=len(linked) + 1, length=len("@hermes_bot")),
+        ],
+    )
+    rich = _rich([{"type": "url", "text": linked, "url": "https://example.com/status"}, " @hermes_bot"])
+
+    # The user deliberately mentions us; a clickable command-shaped label cannot veto that.
+    assert _gate({"require_mention": True}, plain) is True
+    assert _gate({"require_mention": True}, rich) is True
diff --git a/tests/plugins/platforms/telegram/test_telegram_import_failure_logging.py b/tests/plugins/platforms/telegram/test_telegram_import_failure_logging.py
new file mode 100644
index 00000000000..707f43bc4f6
--- /dev/null
+++ b/tests/plugins/platforms/telegram/test_telegram_import_failure_logging.py
@@ -0,0 +1,32 @@
+"""The ImportError that stubs the Telegram SDK must be logged with its cause (#87455)."""
+
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+_ROOT = Path(__file__).resolve().parents[4]
+_PROBE = """
+import importlib.abc, logging, sys
+class Block(importlib.abc.MetaPathFinder):
+    def find_spec(self, name, path=None, target=None):
+        if name == {missing!r} or name.startswith({missing!r} + "."):
+            raise ModuleNotFoundError("No module named " + repr(name), name=name)
+sys.meta_path.insert(0, Block())
+logging.basicConfig(level=logging.DEBUG, format="%(levelname)s|%(message)s", stream=sys.stdout)
+import plugins.platforms.telegram.adapter as a
+print("AVAILABLE", a.TELEGRAM_AVAILABLE)
+"""
+
+
+@pytest.mark.parametrize(("missing", "level"), [("telegram", "DEBUG"), ("telegram.ext", "WARNING")])
+def test_sdk_import_failure_is_logged_with_cause(missing, level):
+    if missing != "telegram":
+        pytest.importorskip("telegram")  # the partial-install leg needs the top-level package present
+    out = subprocess.run([sys.executable, "-c", _PROBE.format(missing=missing)], cwd=_ROOT, capture_output=True,
+                         text=True, timeout=120, stdin=subprocess.DEVNULL, check=False).stdout
+    assert "AVAILABLE False" in out
+    line = next(ln for ln in out.splitlines() if "python-telegram-bot import failed" in ln)
+    assert line.startswith(level + "|") and missing in line
+    assert "Traceback" in out  # the swallowed cause is printed, not just a summary
