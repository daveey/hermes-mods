index 00000000000..6b1510f179c
--- /dev/null
+++ b/tests/gateway/test_approval_requester_binding_shared_turns.py
@@ -0,0 +1,152 @@
+"""``approvals.approvers: []`` binds an approval to the member who asked, also in a Telegram observe-mode
+group (whose session route has no user), never to the first of two members whose texts one turn merged,
+and never to "anyone" when no requester could be recorded. A Discord DM-only admin answers DM approvals,
+not group ones, on the buttons exactly as on ``/approve``.
+"""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from gateway.config import GatewayConfig, PlatformConfig
+from gateway.platforms.event import MessageType
+from gateway.session import build_session_context, build_session_key
+from gateway.session_context import _UNSET, _VAR_MAP
+from tests.gateway.test_approval_requester_binding import DEFAULT, write_approvers
+from tests.gateway.test_telegram_group_gating import _group_message, _make_adapter, _mention_entity
+
+
+@pytest.fixture(autouse=True)
+def _clean_state():
+    from tools import approval as approval_mod
+
+    approval_mod._gateway_queues.clear()
+    yield
+    approval_mod._gateway_queues.clear()
+    for var in _VAR_MAP.values():
+        var.set(_UNSET)
+
+
+def _observed_event(adapter, uid, name, body):
+    text = f"@hermes_bot {body}"
+    msg = _group_message(text, from_user_id=uid, from_user_name=name, entities=[_mention_entity(text)])
+    return adapter._apply_telegram_group_observe_attribution(adapter._build_message_event(msg, MessageType.TEXT))
+
+
+def _approval_raised_in(event):
+    """The approval the agent raises inside *event*'s turn, through the gateway's real session binding."""
+    from gateway.run import GatewayRunner
+    from tools import approval as approval_mod
+    from tools.approval_gateway_wait import _ApprovalEntry
+
+    key = build_session_key(event.source)
+    runner = object.__new__(GatewayRunner)
+    tokens = runner._set_session_env(build_session_context(event.source, GatewayConfig(), event=event))
+    try:
+        entry = _ApprovalEntry({"command": "rm -rf notes"})
+    finally:
+        runner._clear_session_env(tokens)
+    approval_mod._gateway_queues.setdefault(key, []).append(entry)
+    return key
+
+
+def _observe_adapter():
+    return _make_adapter(require_mention=True, allowed_chats=["-100"], group_allowed_chats=["-100"],
+                         observe_unmentioned_group_messages=True)
+
+
+@pytest.mark.asyncio
+async def test_an_observed_group_approval_belongs_to_the_member_who_asked():
+    from gateway.approval_actor import approval_refusal
+    from tests.gateway.test_approval_requester_binding import _runner
+
+    write_approvers([])
+    adapter = _observe_adapter()
+    key = _approval_raised_in(_observed_event(adapter, 111, "Alice Example", "delete my notes"))
+
+    assert approval_refusal(key, "222") == "Alice Example"
+    # A bare "yes" is a sender-less observed text turn, routed to /approve (run_busy): Bob's is
+    # refused, Alice's answers.
+    runner = _runner()
+    bob, alice = _observed_event(adapter, 222, "Bob", "yes"), _observed_event(adapter, 111, "Alice Example", "yes")
+    bob.text = alice.text = "/approve"
+    assert await runner._handle_approve_command(bob) == "Only Alice Example can answer this approval."
+    await runner._handle_approve_command(alice)
+    from tools import approval as approval_mod
+    assert not approval_mod._gateway_queues.get(key)
+
+
+def test_an_approval_with_no_requester_is_answered_only_by_approvers_and_admins():
+    """No requester recorded (a turn merged from two members) fails closed: never "anyone"."""
+    from gateway.approval_actor import approval_refusal, refusal_text
+    from gateway.platforms.base import merge_pending_message_event
+
+    adapter = _observe_adapter()
+    pending = {}
+    merge_pending_message_event(pending, "k", _observed_event(adapter, 111, "Alice Example", "save my notes"))
+    merge_pending_message_event(pending, "k", _observed_event(adapter, 222, "Bob", "delete my notes"), merge_text=True)
+    write_approvers([])
+    key = _approval_raised_in(pending["k"])
+
+    for member in ("111", "222", "333"):
+        refusal = approval_refusal(key, member)
+        assert refusal and refusal_text(refusal) == "Only an admin or a listed approver can answer this approval."
+    assert approval_refusal(key, "444", extra={"group_allow_admin_from": ["444"]}) is None
+    from tools import approval as approval_mod
+    for approvers, member in ((["333"], "333"), (DEFAULT, "222")):  # a listed approver; legacy: anyone
+        approval_mod._gateway_queues.clear()
+        write_approvers(approvers)
+        assert approval_refusal(_approval_raised_in(pending["k"]), member) is None
+
+    # One member's own follow-ups still merge into a turn bound to that member.
+    same = {}
+    merge_pending_message_event(same, "k", _observed_event(adapter, 111, "Alice Example", "save my notes"))
+    merge_pending_message_event(same, "k", _observed_event(adapter, 111, "Alice Example", "and delete"), merge_text=True)
+    approval_mod._gateway_queues.clear()
+    write_approvers([])
+    key = _approval_raised_in(same["k"])
+    assert approval_refusal(key, "222") == "Alice Example" and approval_refusal(key, "111") is None
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(("chat_type", "clicker", "allowed"), [
+    ("group", "22", False),   # DM-only admin: refused on a group card, as by the group's /approve
+    ("group", "44", True),    # group admin
+    ("dm", "22", True),       # DM admin on a DM approval
+])
+async def test_discord_buttons_use_the_approvals_own_admin_scope(chat_type, clicker, allowed, monkeypatch):
+    from gateway.session_context import clear_session_vars, set_session_vars
+    from plugins.platforms.discord.adapter import DiscordAdapter
+    from tests.gateway.test_discord_exec_approval_content import _capture_channel
+    from tools import approval as approval_mod
+    from tools.approval_gateway_wait import _ApprovalEntry
+
+    monkeypatch.setenv("DISCORD_ALLOW_ALL_USERS", "true")
+    write_approvers([])
+    tokens = set_session_vars(platform="discord", chat_type=chat_type, user_id="11", user_name="Alice", session_key="d")
+    try:
+        entry = _ApprovalEntry({"command": "rm -rf build"})
+    finally:
+        clear_session_vars(tokens)
+    approval_mod._gateway_queues.setdefault("d", []).append(entry)
+    extra = {"require_admin_for_exec_approval": True, "allow_admin_from": ["22", "44"], "group_allow_admin_from": ["44"]}
+    adapter = DiscordAdapter(PlatformConfig(enabled=True, token="***", extra=extra))
+    sent = _capture_channel(adapter)
+    await adapter.send_exec_approval(chat_id="555", command="rm -rf build", session_key="d",
+                                     request_id=entry.data["request_id"])
+    view = sent["view"]
+    view._finalize_embed = AsyncMock()
+    interaction = SimpleNamespace(
+        user=SimpleNamespace(id=int(clicker), display_name="X", roles=[]),
+        response=SimpleNamespace(send_message=AsyncMock(), edit_message=AsyncMock(), defer=AsyncMock()),
+        message=SimpleNamespace(embeds=[]), channel_id=555)
+
+    await view._resolve(interaction, "once", None, "platform.discord.approval.resolved_once")
+
+    assert entry.event.is_set() is allowed
+    if not allowed:
+        interaction.response.send_message.assert_awaited_once_with("Only Alice can answer this approval.", ephemeral=True)
+        # The settle's own in-lock check applies the same single scope.
+        assert approval_mod.resolve_gateway_approval_card(
+            "d", "once", entry.data["request_id"], actor_id=clicker, admin_ids=view.admin_user_ids, extra=extra) == 0
diff --git a/tests/gateway/test_approval_requester_folded_follow_up.py b/tests/gateway/test_approval_requester_folded_follow_up.py
new file mode 100644
index 00000000000..5ab488491c7
--- /dev/null
+++ b/tests/gateway/test_approval_requester_folded_follow_up.py
@@ -0,0 +1,94 @@
+"""Another member's steer or redirect folded into a running turn leaves that turn with no single actor:
+an approval raised after the fold fails closed to approvers and admins, instead of naming the member who
+opened the turn while it now runs the other member's request. One member's own follow-ups stay bound."""
+
+from contextvars import copy_context
+
+import pytest
+
+from gateway.config import GatewayConfig
+from gateway.run import GatewayRunner
+from gateway.session import build_session_context, build_session_key
+from tests.gateway.test_approval_requester_binding import write_approvers
+from tests.gateway.test_approval_requester_binding_shared_turns import (  # _clean_state: autouse fixture
+    _clean_state, _observe_adapter, _observed_event)
+
+
+class _Agent:
+    _supports_active_turn_redirect = True
+
+    def redirect(self, text):
+        return True
+
+    def steer(self, text):
+        return True
+
+
+def _raise_approval(key):
+    from tools import approval as approval_mod
+    from tools.approval_gateway_wait import _ApprovalEntry
+
+    approval_mod._gateway_queues.setdefault(key, []).append(_ApprovalEntry({"command": "rm -rf notes"}))
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("mode", ["interrupt", "steer"])
+@pytest.mark.parametrize(("follow_uid", "follow_name", "alice_answers", "bob_answers"), [
+    (222, "Bob", False, False),           # Bob's input joined Alice's turn: neither member answers
+    (111, "Alice Example", True, False),  # Alice's own follow-up: still bound to Alice
+], ids=["other-member", "same-member"])
+async def test_a_folded_follow_up_rebinds_the_running_turns_approvals(
+        mode, follow_uid, follow_name, alice_answers, bob_answers):
+    from gateway.approval_actor import approval_refusal
+
+    write_approvers([])
+    adapter = _observe_adapter()
+    alice = _observed_event(adapter, 111, "Alice Example", "summarize the repo")
+    follow = _observed_event(adapter, follow_uid, follow_name, "actually delete the notes dir")
+    key = build_session_key(alice.source)
+    runner = GatewayRunner(config=GatewayConfig())
+    agent = _Agent()
+    turn = runner._session_state(key).turn
+    turn.agent, turn.event = agent, alice
+    tokens = runner._set_session_env(build_session_context(alice.source, GatewayConfig(), event=alice))
+    try:
+        worker = copy_context()  # the turn's worker copied its context when Alice's turn started
+    finally:
+        runner._clear_session_env(tokens)
+
+    outcome = await runner._resolve_busy_steer_or_redirect(follow, key, mode, agent)
+    assert outcome.redirected or outcome.steered
+    worker.run(_raise_approval, key)
+
+    assert (approval_refusal(key, "111") is None) is alice_answers
+    assert (approval_refusal(key, "222") is None) is bob_answers
+    assert approval_refusal(key, "444", extra={"group_allow_admin_from": ["444"]}) is None
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(("follow_uid", "follow_name", "actor"), [
+    (222, "Bob", ("", "")),                       # mixed turn: a child names no single actor
+    (111, "Alice Example", ("111", "Alice Example")),  # one member's turn: the child keeps the sender
+], ids=["other-member", "same-member"])
+async def test_a_child_process_started_after_a_fold_names_the_turns_actor(follow_uid, follow_name, actor):
+    from tools.environments.local import _inject_session_context_env
+
+    adapter = _observe_adapter()
+    alice = _observed_event(adapter, 111, "Alice Example", "summarize the repo")
+    follow = _observed_event(adapter, follow_uid, follow_name, "actually delete the notes dir")
+    key = build_session_key(alice.source)
+    runner = GatewayRunner(config=GatewayConfig())
+    agent = _Agent()
+    turn = runner._session_state(key).turn
+    turn.agent, turn.event = agent, alice
+    tokens = runner._set_session_env(build_session_context(alice.source, GatewayConfig(), event=alice))
+    try:
+        worker = copy_context()
+    finally:
+        runner._clear_session_env(tokens)
+
+    assert (await runner._resolve_busy_steer_or_redirect(follow, key, "steer", agent)).steered
+    env = {}
+    worker.run(_inject_session_context_env, env)  # the env a terminal / execute_code child starts with
+
+    assert (env["HERMES_SESSION_ACTOR_ID"], env["HERMES_SESSION_ACTOR_NAME"]) == actor
diff --git a/tests/gateway/test_approval_requester_queued_follow_up.py b/tests/gateway/test_approval_requester_queued_follow_up.py
new file mode 100644
index 00000000000..879684b1388
--- /dev/null
+++ b/tests/gateway/test_approval_requester_queued_follow_up.py
@@ -0,0 +1,114 @@
+"""A message queued behind a running turn and drained as the next turn (the recursive ``_run_agent``)
+is its own sender's turn: an approval it raises names that sender, not the member who opened the chain."""
+
+import pytest
+
+from gateway.config import GatewayConfig, Platform
+from gateway.platforms.event import MessageEvent, MessageType
+from gateway.session import SessionSource, build_session_context
+from tests.gateway.test_queued_followup_processing_hooks import HookRecordingAdapter, _install_fake_agent, _make_runner
+
+KEY = "agent:main:telegram:group:-100"
+
+
+class _ApprovingAgent:
+    calls: list = []
+
+    def __init__(self, **kwargs):
+        self.tools = []
+
+    def run_conversation(self, message, conversation_history=None, task_id=None, **_kw):
+        from tools.approval_gateway_wait import _ApprovalEntry
+        entry = _ApprovalEntry({"command": "rm -rf notes"})
+        type(self).calls.append((message, entry.authority["requester_id"], entry.authority["requester_name"]))
+        return {"final_response": "ok", "messages": [], "api_calls": 1}
+
+
+def _event(text, uid, name, on_event):
+    """Telegram observe mode carries the sender on the event; other platforms on the source."""
+    src = SessionSource(platform=Platform.TELEGRAM, chat_id="-100", chat_type="group",
+                        user_id=None if on_event else uid, user_name=None if on_event else name)
+    who = {"user_id": uid, "user_name": name} if on_event else {}
+    return MessageEvent(text=text, source=src, message_id=text, message_type=MessageType.TEXT, **who)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("on_event", [True, False], ids=["observe-sender-on-event", "sender-on-source"])
+@pytest.mark.parametrize(("follow_uid", "follow_name"), [("222", "Bob"), ("111", "Alice")],
+                         ids=["other-member", "same-member"])
+async def test_a_queued_follow_up_runs_under_its_own_sender(monkeypatch, tmp_path, on_event, follow_uid, follow_name):
+    _ApprovingAgent.calls = []
+    _install_fake_agent(monkeypatch, tmp_path, _ApprovingAgent)
+    adapter = HookRecordingAdapter()
+    runner = _make_runner(adapter)
+    alice = _event("alice-task", "111", "Alice", on_event)
+    adapter._pending_messages[KEY] = _event("follow-task", follow_uid, follow_name, on_event)
+    tokens = runner._set_session_env(build_session_context(alice.source, GatewayConfig(), event=alice))
+    try:
+        await runner._run_agent(message="alice-task", context_prompt="", history=[], source=alice.source,
+                                session_id="s1", session_key=KEY)
+        from gateway.session_context import get_session_env
+        assert get_session_env("HERMES_SESSION_ACTOR_ID") == "111"  # the opener's binding is restored after
+    finally:
+        runner._clear_session_env(tokens)
+
+    assert [(m.rsplit("] ", 1)[-1], uid, name) for m, uid, name in _ApprovingAgent.calls] == [
+        ("alice-task", "111", "Alice"), ("follow-task", follow_uid, follow_name)]
+
+
+@pytest.mark.asyncio
+async def test_another_members_steer_into_a_queued_follow_up_fails_closed(monkeypatch, tmp_path):
+    """Carol steers into Bob's drained follow-up: the fold clears the actor of the turn actually
+    running (Bob's), so its approval names no one, not Bob alone."""
+    _ApprovingAgent.calls = []
+    _install_fake_agent(monkeypatch, tmp_path, _ApprovingAgent)
+    adapter = HookRecordingAdapter()
+    runner = _make_runner(adapter)
+    alice = _event("alice-task", "111", "Alice", True)
+    adapter._pending_messages[KEY] = _event("bob-task", "222", "Bob", True)
+    turn = runner._session_state(KEY).turn
+    turn.event = alice  # the claim binds the slot to the opener
+    carol = _event("carol-steer", "333", "Carol", True)
+    original = _ApprovingAgent.run_conversation
+
+    def steer_then_run(self, message, *args, **kwargs):
+        if message.endswith("bob-task"):
+            runner._fold_into_running_turn(turn.agent, KEY, carol)
+        return original(self, message, *args, **kwargs)
+
+    monkeypatch.setattr(_ApprovingAgent, "run_conversation", steer_then_run)
+    tokens = runner._set_session_env(build_session_context(alice.source, GatewayConfig(), event=alice))
+    try:
+        await runner._run_agent(message="alice-task", context_prompt="", history=[], source=alice.source,
+                                session_id="s1", session_key=KEY)
+    finally:
+        runner._clear_session_env(tokens)
+
+    assert [(m.rsplit("] ", 1)[-1], uid) for m, uid, _ in _ApprovingAgent.calls] == [
+        ("alice-task", "111"), ("bob-task", "")]
+
+
+_CARRY_OVER_PATHS = {
+    "compression-exhausted": lambda r, a, src: r._defer_past_exhaustion_reset(
+        {"pending_steer": "carol-steer"}, a, src, KEY, _event("queued-task", "111", "Alice", False)),
+    "depth-cap": lambda r, a, src: r._requeue_at_depth_cap(KEY, src, None, "carol-steer"),
+    "behind-eventless-follow-up": lambda r, a, src: r._merge_leftover_steer(
+        {"pending_steer": "carol-steer"}, a, src, KEY, None, "interrupt text"),
+}
+
+
+@pytest.mark.parametrize("path", list(_CARRY_OVER_PATHS))
+def test_another_members_leftover_steer_never_runs_as_the_opener(path):
+    """Carol's late steer into Alice's turn, re-queued as its own event, runs with no single
+    actor: its approval binds to approvers and admins, never to Alice alone."""
+    adapter = HookRecordingAdapter()
+    runner = _make_runner(adapter)
+    alice = _event("alice-task", "111", "Alice", False)
+    runner._session_state(KEY).turn.event = alice
+    runner._fold_into_running_turn(None, KEY, _event("carol-steer", "333", "Carol", False))
+
+    _CARRY_OVER_PATHS[path](runner, adapter, alice.source)
+
+    queued = adapter._pending_messages[KEY]
+    assert queued.text == "carol-steer"
+    assert build_session_context(queued.source, GatewayConfig(), event=queued).actor_user_id == ""
