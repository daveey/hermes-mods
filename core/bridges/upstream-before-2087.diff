diff --git a/tests/gateway/test_telegram_draft_delete_flood_window.py b/tests/gateway/test_telegram_draft_delete_flood_window.py
new file mode 100644
index 00000000000..626a4549f71
--- /dev/null
+++ b/tests/gateway/test_telegram_draft_delete_flood_window.py
@@ -0,0 +1,75 @@
+"""Draft frames and message deletes stay out of a chat's Telegram flood window.
+
+A 429 ``retry_after`` arms the chat's send flood window; ``send_draft`` and ``delete_message``
+must not fire Bot API calls into it (Telegram lengthens a penalty that keeps getting hit), and a
+429 on either arms the window for the other paths. SDK-free: the refusal is any exception that
+carries ``retry_after``, as PTB's ``RetryAfter`` does.
+"""
+import asyncio
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway.config import PlatformConfig
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+
+class _Flood(Exception):
+    def __init__(self, seconds: float) -> None:
+        super().__init__(f"Flood control exceeded. Retry in {seconds} seconds")
+        self.retry_after = seconds
+
+
+def _adapter() -> TelegramAdapter:
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="***"))
+    adapter._bot = MagicMock()
+    adapter._bot.send_message_draft = AsyncMock(return_value=True)
+    adapter._bot.delete_message = AsyncMock(return_value=True)
+    return adapter
+
+
+@pytest.mark.asyncio
+async def test_draft_frames_skip_the_flood_window_a_refused_draft_armed():
+    adapter = _adapter()
+    adapter._bot.send_message_draft = AsyncMock(side_effect=[_Flood(30), True])
+
+    refused = await adapter.send_draft("4242", 7, "frame 1")
+    later = [await adapter.send_draft("4242", 7, f"frame {i}") for i in (2, 3)]
+
+    # The refusal keeps the draft transport (a skipped frame, not a failure) and fires nothing more.
+    assert refused.success and refused.raw_response == {"skipped": True}
+    assert all(r.success and r.raw_response == {"skipped": True} for r in later)
+    assert adapter._bot.send_message_draft.await_count == 1
+    # The window is the chat's: a send refuses locally too, and another chat still drafts.
+    assert (await adapter.send("4242", "hello")).error.startswith("flood_control:")
+    assert (await adapter.send_draft("777", 1, "other chat")).raw_response is None
+    assert adapter._bot.send_message_draft.await_count == 2
+
+
+@pytest.mark.asyncio
+async def test_delete_waits_out_the_flood_window_then_deletes():
+    adapter = _adapter()
+    adapter._record_send_flood_cooldown("4242", 1.0)  # a refused send armed a short window
+
+    task = asyncio.create_task(adapter.delete_message("4242", "55"))
+    for _ in range(5):
+        await asyncio.sleep(0)  # let the delete reach its wait
+    assert adapter._bot.delete_message.await_count == 0  # nothing fired into the window
+    assert await task is True
+    adapter._bot.delete_message.assert_awaited_once_with(chat_id=4242, message_id=55)
+
+
+@pytest.mark.asyncio
+async def test_long_flood_window_defers_the_delete_and_a_refused_delete_arms_it():
+    adapter = _adapter()
+    adapter._bot.delete_message = AsyncMock(side_effect=_Flood(60))
+    assert await adapter.delete_message("4242", "55") is False  # the 429 itself
+    assert adapter._send_flood_cooldown_remaining("4242") is not None
+
+    adapter._bot.delete_message = AsyncMock(return_value=True)
+    # Past the inline cap the delete is owned by a tracked background task: the caller is not parked.
+    assert await asyncio.wait_for(adapter.delete_message("4242", "56"), 0.5) is True
+    assert adapter._bot.delete_message.await_count == 0
+    pending = [t for t in adapter._background_tasks if not t.done()]
+    assert len(pending) == 1
+    await adapter.cancel_background_tasks()
diff --git a/tests/gateway/test_telegram_fallback_connect_budget.py b/tests/gateway/test_telegram_fallback_connect_budget.py
new file mode 100644
index 00000000000..11b0517ed45
--- /dev/null
+++ b/tests/gateway/test_telegram_fallback_connect_budget.py
@@ -0,0 +1,87 @@
+"""One request's fallback path walk shares a connect budget that ends inside the send deadline.
+
+The adapter bounds every text send with a 30s wall-clock deadline, but httpx's connect timeout
+applies per path. Three hung paths at the stock 10s connect timeout used up the whole deadline. The
+deadline then fired mid-walk as a bare TimeoutError, which the send classifier treats as
+"may have been delivered", so the message was dropped with no retry.
+"""
+
+import httpx
+import pytest
+
+import plugins.platforms.telegram.telegram_network as tnet
+
+
+class _Clock:
+    now = 1000.0
+
+    def monotonic(self):
+        return self.now
+
+
+class _HangingConnect(httpx.AsyncBaseTransport):
+    """An inner pool whose connect hangs for the request's whole connect timeout (advancing the
+    fake clock by it), then times out."""
+
+    def __init__(self, calls, clock):
+        self.calls, self.clock = calls, clock
+
+    async def handle_async_request(self, request):
+        connect = request.extensions["timeout"]["connect"]
+        self.calls.append((request.url.host, connect))
+        self.clock.now += connect
+        raise httpx.ConnectTimeout("connect timed out", request=request)
+
+    async def aclose(self):
+        return None
+
+
+class _CaptureRequest:
+    """Stands in for PTB's HTTPXRequest: keeps the httpx kwargs build_ptb_requests hands it."""
+
+    def __init__(self, **kwargs):
+        self.kwargs = kwargs
+
+
+def _stock_send_request():
+    request = httpx.Request("POST", "https://api.telegram.org/botTOKEN/sendMessage")
+    timeouts = tnet.ptb_request_kwargs()
+    request.extensions["timeout"] = {"connect": timeouts["connect_timeout"], "read": timeouts["read_timeout"],
+                                     "write": timeouts["write_timeout"], "pool": timeouts["pool_timeout"]}
+    return request
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("which", [0, 1], ids=["general", "getUpdates"])
+async def test_built_transports_walk_every_path_within_the_send_deadline(monkeypatch, which):
+    """Every path (two seed IPs plus the hostname) is tried, and the walk ends with the underlying
+    ConnectTimeout. It must not run into the send deadline."""
+    clock = _Clock()
+    monkeypatch.setattr(tnet.time, "monotonic", clock.monotonic)
+    calls = []
+    monkeypatch.setattr(tnet.httpx, "AsyncHTTPTransport", lambda **kw: _HangingConnect(calls, clock))
+    requests = tnet.build_ptb_requests(_CaptureRequest, fallback_ips=list(tnet.SEED_FALLBACK_IPS), proxy_url=None,
+                                       verify=False)
+    transport = requests[which].kwargs["httpx_kwargs"]["transport"]
+
+    with pytest.raises(httpx.ConnectTimeout):
+        await transport.handle_async_request(_stock_send_request())
+
+    assert [host for host, _ in calls] == [*tnet.SEED_FALLBACK_IPS, "api.telegram.org"]
+    # The sticky/first path keeps the stock 10s connect; the walk total stays well inside 30s.
+    assert calls[0][1] == 10.0
+    assert sum(connect for _, connect in calls) == 15.0
+
+
+@pytest.mark.asyncio
+async def test_tighter_configured_connect_is_never_widened(monkeypatch):
+    calls = []
+    monkeypatch.setattr(tnet.httpx, "AsyncHTTPTransport", lambda **kw: _HangingConnect(calls, _Clock()))
+    transport = tnet.TelegramFallbackTransport(tnet.SEED_FALLBACK_IPS, connect_budget=15.0)
+    request = _stock_send_request()
+    request.extensions["timeout"]["connect"] = 1.0
+
+    with pytest.raises(httpx.ConnectTimeout):
+        await transport.handle_async_request(request)
+
+    assert [connect for _, connect in calls] == [1.0, 1.0, 1.0]
diff --git a/tests/gateway/test_telegram_flood_window_delete_waits.py b/tests/gateway/test_telegram_flood_window_delete_waits.py
new file mode 100644
index 00000000000..f0243a03e53
--- /dev/null
+++ b/tests/gateway/test_telegram_flood_window_delete_waits.py
@@ -0,0 +1,64 @@
+"""The delete wait loop: a window re-armed while it sleeps is re-checked, never slept inline past the
+cap, and a window that closes during the last allowed wait still gets its delete."""
+import asyncio
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway.config import PlatformConfig
+from plugins.platforms.telegram import telegram_flood_window as fw
+from plugins.platforms.telegram.adapter import _FLOOD_INLINE_WAIT_CAP_SECS, TelegramAdapter
+from plugins.platforms.telegram.telegram_media_flood import _MAX_WINDOW_WAITS
+
+_real_sleep = asyncio.sleep
+
+
+def _adapter() -> TelegramAdapter:
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="***"))
+    adapter._bot = MagicMock()
+    adapter._bot.delete_message = AsyncMock(return_value=True)
+    return adapter
+
+
+def _scripted_sleep(monkeypatch, on_wake):
+    """Each sleep the delete loop takes returns at once; ``on_wake(n)`` is what other in-flight
+    traffic did to the window meanwhile."""
+    slept = []
+
+    async def sleep(seconds, *a, **k):
+        if seconds:
+            slept.append(seconds)
+            on_wake(len(slept))
+        await _real_sleep(0)
+    monkeypatch.setattr(fw.asyncio, "sleep", sleep)
+    return slept
+
+
+@pytest.mark.asyncio
+async def test_a_window_closing_during_the_last_allowed_wait_still_deletes(monkeypatch):
+    adapter = _adapter()
+    adapter._record_send_flood_cooldown("4242", 1.0)
+
+    def wake(n):
+        if n <= _MAX_WINDOW_WAITS:
+            adapter._record_send_flood_cooldown("4242", 1.0)  # re-armed by a sibling request
+        else:
+            adapter.__dict__["_telegram_send_cooldown_until"].clear()  # closed during the last sleep
+    slept = _scripted_sleep(monkeypatch, wake)
+
+    assert await adapter.delete_message("4242", "55") is True
+    assert len(slept) == _MAX_WINDOW_WAITS + 1
+    adapter._bot.delete_message.assert_awaited_once_with(chat_id=4242, message_id=55)
+
+
+@pytest.mark.asyncio
+async def test_a_window_extended_during_an_inline_wait_moves_to_the_background(monkeypatch):
+    adapter = _adapter()
+    adapter._record_send_flood_cooldown("4242", 1.0)  # short: waited inline
+    slept = _scripted_sleep(monkeypatch, lambda n: adapter._record_send_flood_cooldown("4242", 240.0))
+
+    assert await adapter.delete_message("4242", "55") is True  # owned by the background task now
+    assert len(slept) == 1 and slept[0] <= _FLOOD_INLINE_WAIT_CAP_SECS  # never slept the long window inline
+    assert adapter._bot.delete_message.await_count == 0
+    assert [t for t in adapter._background_tasks if not t.done()]
+    await adapter.cancel_background_tasks()
diff --git a/tests/gateway/test_telegram_getupdates_keepalive.py b/tests/gateway/test_telegram_getupdates_keepalive.py
new file mode 100644
index 00000000000..6b4858259e5
--- /dev/null
+++ b/tests/gateway/test_telegram_getupdates_keepalive.py
@@ -0,0 +1,65 @@
+"""getUpdates long-poll socket reuse, per OS (#87057 Windows deadlock vs #107880 TIME_WAIT exhaustion).
+
+Drives the real ``build_ptb_requests`` limits into a real httpx client against a local HTTP/1.1 server
+and counts the TCP connections the polls opened.
+"""
+
+import asyncio
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import httpx
+import pytest
+
+from plugins.platforms.telegram.telegram_network import build_ptb_requests
+
+
+class _Recorder:
+    def __init__(self, **kwargs):
+        self.kwargs = kwargs
+
+
+def _tcp_connections_for_polls(polls: int) -> int:
+    ports: set[int] = set()
+
+    class Handler(BaseHTTPRequestHandler):
+        protocol_version = "HTTP/1.1"
+
+        def do_POST(self):
+            ports.add(self.client_address[1])
+            self.rfile.read(int(self.headers.get("Content-Length") or 0))
+            body = b'{"ok":true,"result":[]}'
+            self.send_response(200)
+            self.send_header("Content-Length", str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    _general, updates = build_ptb_requests(_Recorder, fallback_ips=[], proxy_url=None)
+    httpx_kwargs = {k: v for k, v in updates.kwargs["httpx_kwargs"].items() if k != "verify"}
+
+    async def run():
+        async with httpx.AsyncClient(**httpx_kwargs) as client:
+            for _ in range(polls):
+                (await client.post(f"http://127.0.0.1:{server.server_port}/botT/getUpdates", json={})).raise_for_status()
+
+    try:
+        asyncio.run(run())
+    finally:
+        server.shutdown()
+        server.server_close()
+    return len(ports)
+
+
+@pytest.mark.platforms("posix")
+def test_getupdates_polls_reuse_one_socket_off_windows():
+    assert _tcp_connections_for_polls(10) == 1
+
+
+@pytest.mark.platforms("windows")
+def test_getupdates_polls_never_reuse_a_socket_on_windows():
+    assert _tcp_connections_for_polls(5) == 5
