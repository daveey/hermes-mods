+
+@pytest.mark.parametrize("tokens", ["1,,2", "07,200", "８５,０００", "1000"])
+def test_malformed_token_counts_are_not_suppressed(tokens):
+    warning = CONTEXT_OVERFLOW_BLOCKED_WARNING_TEMPLATE.format(
