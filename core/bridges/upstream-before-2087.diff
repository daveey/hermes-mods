diff --git a/tests/agent/test_fallback_trigger_logged.py b/tests/agent/test_fallback_trigger_logged.py
new file mode 100644
index 00000000000..80df6ea192b
--- /dev/null
+++ b/tests/agent/test_fallback_trigger_logged.py
@@ -0,0 +1,95 @@
+"""A fallback whose trigger is only buffered leaves its cause in the log (#152101).
+
+The "switching to fallback" status is only buffered, and the buffer is dropped once the fallback
+answers, so without a log line nothing records why the session left its primary model.
+"""
+from __future__ import annotations
+
+import logging
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+from agent.error_classifier import FailoverReason
+from agent.turn_response_check import retry_invalid_response
+from agent.turn_retry_state import TurnRetryState
+
+
+def _agent(switches: bool) -> MagicMock:
+    agent = MagicMock()
+    agent.log_prefix, agent.quiet_mode, agent.api_mode = "", True, "chat_completions"
+    agent.provider, agent.model = "nous", "anthropic/claude-opus-5.5"
+    agent._fallback_chain, agent._fallback_index = [{"provider": "custom", "model": "fb"}], 0
+    agent._try_activate_fallback.return_value = switches
+    return agent
+
+
+def _run(agent, caplog):
+    with caplog.at_level(logging.WARNING, logger="agent.conversation_loop"):
+        return retry_invalid_response(
+            agent, response=SimpleNamespace(choices=[], error=None), error_details=["response.choices is empty"],
+            _retry=TurnRetryState(), thinking_spinner=None, messages=[], api_messages=[], api_kwargs=None,
+            active_system_prompt=None, conversation_history=None, retry_count=0, max_retries=3,
+            compression_attempts=0, api_call_count=1, api_request_id="r", api_start_time=0.0, api_duration=0.4,
+            effective_task_id="t", turn_id="turn",
+        )
+
+
+def _switch_lines(caplog) -> list[str]:
+    return [r.getMessage() for r in caplog.records if "switched to fallback" in r.getMessage()]
+
+
+def test_invalid_response_fallback_logs_its_trigger(caplog):
+    verdict = _run(_agent(switches=True), caplog)
+    assert verdict.action == "break"
+    assert _switch_lines(caplog) == ["Invalid API response (response.choices is empty) — switched to fallback"]
+
+
+def test_declined_fallback_logs_no_switch(caplog):
+    _run(_agent(switches=False), caplog)
+    assert _switch_lines(caplog) == []
+
+
+def test_content_filter_stream_fallback_names_reason_and_logs(caplog):
+    from agent.turn_truncation import _Trunc, _content_filter_fallback
+
+    agent = _agent(switches=True)
+    st = _Trunc(
+        agent=agent, response=SimpleNamespace(_content_filter_terminated=True), finish_reason="length",
+        conversation_history=[], api_call_count=1, effective_task_id="t", current_turn_user_idx=None,
+        result=None, messages=[], length_continue_retries=0, truncated_response_parts=[],
+        truncated_tool_call_retries=0, retry_count=0, compression_attempts=0,
+    )
+    with caplog.at_level(logging.WARNING, logger="agent.conversation_loop"):
+        verdict = _content_filter_fallback(st, TurnRetryState())
+    assert verdict is not None and verdict.action == "break"
+    agent._try_activate_fallback.assert_called_once_with(reason=FailoverReason.content_policy_blocked)
+    assert _switch_lines(caplog) == ["Content filter terminated the stream — switched to fallback"]
+
+
+def test_nous_rate_guard_fallback_logs(monkeypatch, caplog):
+    from agent import nous_rate_guard
+    from agent.turn_api_call import nous_rate_limit_guard
+
+    monkeypatch.setattr(nous_rate_guard, "nous_rate_limit_remaining", lambda **kw: 600)
+    monkeypatch.setattr("hermes_cli.anon_auth.is_anonymous_agent", lambda agent: False)
+    monkeypatch.setattr("hermes_cli.anon_auth.apply_model_switch", lambda agent: None)
+    monkeypatch.setattr("agent.conversation_loop._arm_fallback_restart", lambda *a: "sys")
+    agent = _agent(switches=True)
+    with caplog.at_level(logging.WARNING, logger="agent.conversation_loop"):
+        verdict = nous_rate_limit_guard(
+            agent, _retry=TurnRetryState(), api_messages=[], messages=[], conversation_history=[],
+            active_system_prompt="system", retry_count=0, compression_attempts=0, api_call_count=0,
+        )
+    assert verdict.action == "break"
+    assert len(_switch_lines(caplog)) == 1 and _switch_lines(caplog)[0].startswith("Nous rate limit recorded")
+
+
+def test_codex_app_server_fallback_logs_its_trigger(caplog):
+    from agent.turn_recovery import activate_codex_app_server_fallback
+
+    agent = _agent(switches=True)
+    agent._has_pending_fallback.return_value = True
+    with caplog.at_level(logging.WARNING, logger="agent.conversation_loop"):
+        assert activate_codex_app_server_fallback(agent, {"error": "429 Too Many Requests"}) is True
+    agent._try_activate_fallback.assert_called_once_with(reason=FailoverReason.rate_limit)
+    assert _switch_lines(caplog) == ["Codex app-server turn failed (rate_limit: 429 Too Many Requests) — switched to fallback"]
diff --git a/tests/agent/test_redact_telegram_boundary.py b/tests/agent/test_redact_telegram_boundary.py
new file mode 100644
index 00000000000..4d73edc26ee
--- /dev/null
+++ b/tests/agent/test_redact_telegram_boundary.py
@@ -0,0 +1,128 @@
+"""Telegram recognition starts at a credential boundary, not inside an identifier.
+
+Every value here is synthetic and assembled at runtime; none is a live credential.
+"""
+import json
+import sys
+
+import pytest
+
+from agent.redact import redact_for_egress, redact_sensitive_text, redact_terminal_output
+
+
+def _redact(payload, mode):
+    if mode == "terminal":
+        return redact_terminal_output(payload, "python synthetic.py", force=True)
+    if mode == "egress":
+        return redact_for_egress(payload)
+    return redact_sensitive_text(payload, force=True, code_file=mode == "code")
+
+
+@pytest.mark.parametrize("mode", ["normal", "code", "terminal", "egress"])
+@pytest.mark.parametrize("bot_prefix", ["", "bot"])
+@pytest.mark.parametrize("left", [
+    r"\n", r"\t", r"\r", r"\b", r"\f", r"\v", r"\x1b", r"\u0000",
+    r"\u4ee4\u724c", r"\u0020", r"\U0001f600", "%0A", "%0a", "%09", "%20", "%3A",
+    "https://example.invalid/?message=%0A",
+])
+def test_encoded_boundary_masks_token_without_rewriting_representation(left, bot_prefix, mode):
+    token = bot_prefix + "987654321:" + "Qa_7-" * 7
+    neighbor = "ghp_" + "y" * 36
+    payload = left + token + " " + neighbor
+    result = _redact(payload, mode)
+    assert result.startswith(left + bot_prefix + "987654321:***")
+    assert "Qa_7-" not in result
+    assert neighbor not in result
+
+
+@pytest.mark.parametrize("mode", ["normal", "terminal", "egress"])
+@pytest.mark.parametrize("bot_prefix", ["", "bot"])
+@pytest.mark.parametrize("message", ["\n", "\t", "凭据"])
+def test_json_serialized_message_masks_token(message, bot_prefix, mode):
+    token = bot_prefix + "987654321:" + "Qa_7-" * 7
+    payload = json.dumps({"message": message + token})
+    result = _redact(payload, mode)
+    assert json.loads(result)["message"] == message + bot_prefix + "987654321:***"
+
+
+@pytest.mark.parametrize("left", [r"\u0061", r"\u005f", r"\u0031", r"\u0661", r"\x41", "%41", "%5F", "%31"])
+@pytest.mark.parametrize("bot_prefix", ["", "bot"])
+def test_encoded_identifier_character_is_not_a_credential_boundary(left, bot_prefix):
+    payload = left + bot_prefix + "987654321:" + "q-" + "z" * 32
+    assert redact_sensitive_text(payload, force=True) == payload
+
+
+@pytest.mark.parametrize("left", [r"\n", r"\u0020", "%0A"])
+def test_encoded_boundary_long_digit_run_completes_fast(left):
+    import time
+
+    payload = "dump: " + left + "0" * 100_000 + "\n"
+    start = time.perf_counter()
+    assert redact_sensitive_text(payload, force=True) == payload
+    assert time.perf_counter() - start < 2.0
+
+
+def test_repr_message_masks_token_without_rewriting_representation():
+    token = "987654321:" + "Qa_7-" * 7
+    payload = repr({"message": "\n" + token})
+    assert _redact(payload, "terminal") == repr({"message": "\n987654321:***"})
+
+
+@pytest.mark.parametrize("prefix", ["a", "Z", "_", "job-a", "a0"])
+@pytest.mark.parametrize("run_prefix", ["q-", "rv-", "prior-"])
+def test_embedded_digit_suffix_preserves_business_identity(prefix, run_prefix):
+    identity = "ITEM-000042:job-" + prefix + "12345678:" + run_prefix + "a" * 32
+    payload = json.dumps({"research_pending": [{"key": identity}]})
+    assert redact_sensitive_text(payload, force=True) == payload
+
+
+@pytest.mark.parametrize("left", ["", " ", "\n", "\t", "\x00", "\x1b", "'", '"', "(", "=", "/", ":", "令牌：", "令牌", "https://api.telegram.org/"])
+@pytest.mark.parametrize("bot_prefix", ["", "bot"])
+def test_token_boundary_still_masks_token_and_neighbor(left, bot_prefix):
+    token = bot_prefix + "123456789:" + "Ab_9-" * 7
+    neighbor = "ghp_" + "x" * 36
+    payload = left + token + " " + neighbor
+    result = redact_sensitive_text(payload, force=True)
+    assert result.startswith(left + bot_prefix + "123456789:***")
+    assert "Ab_9-" not in result
+    assert neighbor not in result
+
+
+def test_cron_stdout_preserves_identity_and_masks_adjacent_token(tmp_path, monkeypatch):
+    from cron.monitor import check_monitor
+
+    home = tmp_path / "home"
+    scripts = home / "scripts"
+    scripts.mkdir(parents=True)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr("agent.redact._REDACT_ENABLED", True)
+    identity = "ITEM-000042:job-a12345678:q-" + "a" * 32
+    token = "123456789:" + "Ab_9-" * 7
+    script = scripts / "synthetic_monitor.py"
+    # A real child emits JSON; resolution, capture, redaction and context stay real.
+    script.write_text("import json\nprint(json.dumps(" + repr({"key": identity, "credential": token, "message": "\n" + token}) + "))\n")
+    snapshots = []
+    # Only replace persistence: no cron job store or production monitor is touched.
+    monkeypatch.setattr("cron.monitor._persist_monitor_state", lambda *args: snapshots.append(args))
+    outcome = check_monitor({"id": "synthetic-monitor", "monitor_script": script.name, "interpreter": sys.executable})
+    assert outcome.ok, outcome.error
+    assert outcome.changed
+    result = json.loads(snapshots[0][2])
+    assert result["key"] == identity
+    # The JSON key-name pass may mask "credential" first; either way the token body is gone.
+    assert token not in result["credential"]
+    assert result["message"] == "\n123456789:***"
+    assert outcome.context_block is not None
+    assert "### Current output" in outcome.context_block
+    assert identity in outcome.context_block
+    assert token not in outcome.context_block
+
+
+@pytest.mark.parametrize("mode", ["normal", "code", "terminal", "egress"])
+@pytest.mark.parametrize("color", ["\x1b[32m", "\x1b[1;32m", "\x1b[0m"])
+def test_token_right_after_an_ansi_color_code_is_masked(color, mode):
+    token = "987654321:" + "Qa_7-" * 7
+    for payload in (color + token + "\x1b[0m", json.dumps(color + token)):
+        result = _redact(payload, mode)
+        assert "Qa_7-" not in result
+        assert "987654321:***" in result
