+def test_async_delegation_completion_is_deliverable_and_a_held_lane_logs_once(rig, caplog):
+    r = rig.runner
+    evt = {"type": "async_delegation", "delegation_id": "d1", "session_key": "agent:ops:discord:thread:123"}
+
+    async def _no_parent(_sid):
