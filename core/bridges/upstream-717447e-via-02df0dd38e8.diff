diff --git a/tests/gateway/test_housekeeping_idle_collect.py b/tests/gateway/test_housekeeping_idle_collect.py
new file mode 100644
index 00000000000..3ba29d10b4b
--- /dev/null
+++ b/tests/gateway/test_housekeeping_idle_collect.py
@@ -0,0 +1,76 @@
+"""Timer-lane trims run the full collection only while nobody is waiting (#139763).
+
+The gateway housekeeping tick dropped its forced ``gc.collect()`` because a full pass over a
+multi-million-object heap holds the GIL for 250-750 ms and froze every live session once a minute.
+Python 3.14's incremental collector only advances on allocation, so a quiet gateway would then keep
+closed agents' reference cycles (and their pages) forever. The tick collects once the process has
+been turn-free for ``IDLE_COLLECT_AFTER_SECONDS``: once per quiet period, again after a later
+agent close, and never while a turn runs.
+"""
+
+import pytest
+
+from agent import review_idle_queue
+from hermes_cli import mem_trim
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    queue = review_idle_queue.ReviewIdleQueue()
+    now = [1000.0]
+    queue._now = lambda: now[0]
+    monkeypatch.setattr(review_idle_queue, "QUEUE", queue)
+    collects = []
+    monkeypatch.setattr(mem_trim.gc, "collect", lambda *a: collects.append(now[0]) or 0)
+    monkeypatch.setattr(mem_trim, "_malloc_trim", lambda pad: 1)
+    monkeypatch.setattr(mem_trim, "_probe_done", True)
+    monkeypatch.setattr(mem_trim, "_last_trim_monotonic", 0.0)
+    monkeypatch.setattr(mem_trim, "_last_alloc_trim_monotonic", 0.0)
+    monkeypatch.setattr(mem_trim, "_config_settings", lambda: (True, 0.0, 1, 0.0))
+    monkeypatch.setattr(mem_trim, "_idle_collected_for", None)
+    monkeypatch.setattr(mem_trim, "_agent_closed_since_idle_collect", False)
+    return queue, now, collects
+
+
+def _tick():
+    from gateway import run as gateway_run
+    gateway_run._housekeeping_memory_trim()
+
+
+def test_housekeeping_collects_once_per_quiet_period_and_never_during_a_turn(clock):
+    queue, now, collects = clock
+    queue.note_turn_started()
+    now[0] += mem_trim.IDLE_COLLECT_AFTER_SECONDS * 3
+    _tick()
+    assert collects == []  # a turn is live: no freeze, however long it runs
+
+    queue.note_turn_finished()
+    now[0] += mem_trim.IDLE_COLLECT_AFTER_SECONDS - 1
+    _tick()
+    assert collects == []  # quiet, but not for long enough
+
+    now[0] += 2
+    _tick()
+    _tick()
+    assert len(collects) == 1  # the quiet period's one collection
+
+    mem_trim.note_agent_closed()  # idle-cache eviction later in the same quiet period
+    _tick()
+    _tick()
+    assert len(collects) == 2
+
+
+def test_a_new_turn_starts_a_new_quiet_period(clock):
+    queue, now, collects = clock
+    queue.note_turn_started()
+    queue.note_turn_finished()
+    now[0] += mem_trim.IDLE_COLLECT_AFTER_SECONDS
+    _tick()
+    queue.note_turn_started()
+    queue.note_turn_finished()
+    now[0] += 1
+    _tick()
+    assert len(collects) == 1  # just talked: the next collection waits for a full quiet window
+    now[0] += mem_trim.IDLE_COLLECT_AFTER_SECONDS
+    _tick()
+    assert len(collects) == 2
diff --git a/tests/gateway/test_legacy_client_label_adoption.py b/tests/gateway/test_legacy_client_label_adoption.py
new file mode 100644
index 00000000000..fe9044a989c
--- /dev/null
+++ b/tests/gateway/test_legacy_client_label_adoption.py
@@ -0,0 +1,90 @@
+"""A phone app's self-labelled chat continues in Desktop; a plugin platform sharing the label is untouched.
+
+The pre-authority ``hermes serve`` stored whatever ``source`` a client sent, so phone apps signed in
+through the dashboard login left routeless rows labelled ``mobile``, ``ios`` and the like (#146814).
+They are the owner's chats: Desktop's resume adopts them as writable conversations, while a third-party
+WebUI's rows (its own agent writes them) still open read-only. The catalog plugin hermes-mobile
+registers ``Platform('mobile')``; its routed chats keep their messaging route.
+"""
+from types import SimpleNamespace
+
+import pytest
+
+_CAPS = ['session:create', 'session:read', 'session:submit', 'session:control', 'session:approve',
+         'session:respond']
+
+
+async def _owner(tmp_path, monkeypatch, toolsets):
+    from gateway import run
+    from gateway.config import GatewayConfig
+    from gateway.owner_identity import host_owner_subject
+    from gateway.session import SessionStore
+    from gateway.session_authority import initialize_session_authority
+    from gateway.session_controls import AuthorityConnection
+
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setattr(run, '_load_gateway_config', lambda: {'platform_toolsets': toolsets})
+    store = SessionStore(tmp_path / 'sessions', GatewayConfig())
+    runner = SimpleNamespace(session_store=store, _session_db=store._db, adapters={}, _draining=False,
+                             _cached_agent_for=lambda route: None, _restored_source=lambda entry: entry.origin,
+                             _delivery_adapter_for=lambda source: None)
+    runner._adapter_for_source = lambda source: runner.adapters.get(source.platform)
+    authority = await initialize_session_authority(runner, profile_id=str(tmp_path), instance_id='first')
+    desktop = AuthorityConnection(authority, object(), {'provider': 'local', 'user_id': host_owner_subject(),
+        'profile_id': str(tmp_path), 'instance_id': 'first', 'capabilities': _CAPS})
+    return store, desktop
+
+
+@pytest.mark.asyncio
+async def test_a_phone_apps_own_label_resumes_writable_and_a_webui_row_stays_read_only(tmp_path, monkeypatch):
+    store, desktop = await _owner(tmp_path, monkeypatch, {'gui': []})
+    db = store._db
+    for sid, source, user_id in (('phone-mobile', 'mobile', None), ('phone-ios', 'ios', 'basic:admin'),
+                                 ('webui-row', 'webui', None), ('teams-row', 'teams', None),
+                                 ('curator-row', 'curator', None)):
+        db.create_session(sid, source=source, model='m', cwd=str(tmp_path), user_id=user_id)
+        db.append_message(sid, role='user', content='hi from ' + sid)
+        db.end_session(sid, 'ws_orphan_reap')
+    # hermes-mobile installed registers Platform('mobile'): a routeless row with that label still adopts.
+    from gateway.config import Platform
+    Platform._add_pseudo_member('mobile')
+    from hermes_cli.sessions_adopt import adoptable_sessions
+    offered = {row['id'] for row in adoptable_sessions(db.db_path)}
+    assert {'phone-mobile', 'phone-ios'} <= offered and not offered & {'webui-row', 'teams-row', 'curator-row'}
+    for i, sid in enumerate(('phone-mobile', 'phone-ios')):
+        if sid == 'phone-mobile':
+            # A metadata read first opens a read-only view; the resume then adopts it in place.
+            await desktop.dispatch({'id': 50, 'method': 'session.info', 'params': {'session_id': sid}})
+        resumed = await desktop.dispatch({'id': i, 'method': 'session.resume', 'params': {'session_id': sid}})
+        assert resumed.get('result', {}).get('session_id') == sid, resumed
+        assert [m['content'] for m in resumed['result']['messages']] == ['hi from ' + sid]
+        sent = await desktop.dispatch({'id': 10 + i, 'method': 'prompt.submit',
+                                       'params': {'session_id': sid, 'text': 'go on', 'submission_id': 's-' + sid}})
+        assert 'error' not in sent, sent
+        # Bound, it is the Desktop chat it resumes as; a second open still finds it.
+        assert db.get_session(sid)['source'] == 'desktop'
+        again = await desktop.dispatch({'id': 20 + i, 'method': 'session.resume', 'params': {'session_id': sid}})
+        assert again.get('result', {}).get('session_id') == sid, again
+    # A foreign writer's rows, a bundled plugin platform's label and automation stay read-only.
+    for i, sid in enumerate(('webui-row', 'teams-row', 'curator-row')):
+        await desktop.dispatch({'id': 30 + i, 'method': 'session.resume', 'params': {'session_id': sid}})
+        sent = await desktop.dispatch({'id': 40 + i, 'method': 'prompt.submit',
+                                       'params': {'session_id': sid, 'text': 'go on', 'submission_id': 's-' + sid}})
+        assert (sent.get('error', {}).get('data') or {}).get('reason') == 'session_read_only', (sid, sent)
+        assert db.get_session(sid)['source'] == sid.split('-')[0]
+
+
+@pytest.mark.asyncio
+async def test_a_plugin_platform_sharing_the_label_keeps_its_messaging_route(tmp_path, monkeypatch):
+    from gateway.config import Platform
+    from gateway.session import SessionSource
+
+    store, desktop = await _owner(tmp_path, monkeypatch, {})
+    Platform._add_pseudo_member('mobile')  # what the hermes-mobile plugin's platform registration yields
+    entry = store.get_or_create_session(SessionSource(platform=Platform('mobile'), chat_id='device-1',
+                                                      chat_type='dm', user_id='device-1'))
+    store._db.append_message(entry.session_id, role='user', content='from the plugin app')
+    resumed = await desktop.dispatch({'id': 1, 'method': 'session.resume',
+                                      'params': {'session_id': entry.session_id}})
+    assert [m['content'] for m in resumed.get('result', {}).get('messages', [])] == ['from the plugin app'], resumed
+    assert store._db.get_session(entry.session_id)['source'] == 'mobile'
diff --git a/tests/gateway/test_local_post_delivery.py b/tests/gateway/test_local_post_delivery.py
new file mode 100644
index 00000000000..0d8922f0007
--- /dev/null
+++ b/tests/gateway/test_local_post_delivery.py
@@ -0,0 +1,125 @@
+"""A local session's turn runs its post-delivery callbacks once it settles, and a deleted local session
+leaves nothing keyed by it on the local adapter.
+
+A messaging reply's adapter task (``_process_message_background``) runs the callbacks a turn registered
+(background-review release, temp-bubble cleanup, a deferred /goal verdict) after its send. A Desktop/TUI/CLI
+turn runs through the authority's drain with no such task: the callbacks must run there, or they never
+fire (the /goal verdict never reaches the viewer) and the adapter's per-route slot keeps the turn's whole
+context alive until restart.
+"""
+import pytest
+
+from tests.waiting import async_wait_until
+
+
+async def _owner(tmp_path, monkeypatch):
+    from gateway.config import GatewayConfig
+    from gateway.run import GatewayRunner
+    from gateway.session_authority import initialize_session_authority
+    from hermes_state import SessionDB
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    runner = GatewayRunner(GatewayConfig(sessions_dir=tmp_path / "sessions"))
+    db = SessionDB(tmp_path / "state.db")
+    runner.session_store._db = runner._session_db = db
+    authority = await initialize_session_authority(runner, profile_id="default", instance_id="owner", db=db)
+    return runner, authority, db
+
+
+def _viewer():
+    from gateway.session_contract import Principal
+    return Principal("test-owner", "default", frozenset(
+        {"session:create", "session:submit", "session:read", "session:control"}), "viewer")
+
+
+@pytest.mark.asyncio
+async def test_local_turn_runs_its_post_delivery_callbacks_after_settling(tmp_path, monkeypatch):
+    from gateway.session_contract import Submission
+    from gateway.session_local import create_local_session
+    from hermes_state_runtime import get_session_admission
+
+    runner, authority, db = await _owner(tmp_path, monkeypatch)
+    fired = []
+
+    async def turn(event):
+        live = authority.sessions[ref.session_id]
+        adapter = runner._delivery_adapter_for(live.source)
+        admission = event.message_id
+
+        def after_delivery():  # what TurnRunner / the /goal judge register for the turn
+            fired.append((event.text, get_session_admission(db, admission_id=admission)["status"]))
+        adapter.register_post_delivery_callback(live.route, after_delivery, generation=1)
+        if event.text == "fails":
+            raise RuntimeError("turn failed")
+        return "ok"
+
+    monkeypatch.setattr(runner, "_handle_message", turn)
+    try:
+        ref = create_local_session(authority, _viewer(), dict(request_id="r", source="tui", model="fixture",
+                                                              toolsets=[]))
+        live = authority.sessions[ref.session_id]
+        for text in ("answers", "fails"):
+            await authority.submit(_viewer(), Submission(text, ref, {"text": text}, "queue"))
+            await async_wait_until(lambda: text in [t for t, _ in fired], timeout=10, what=f"the {text} turn")
+        adapter = runner._delivery_adapter_for(live.source)
+        assert adapter._post_delivery_callbacks == {}
+    finally:
+        db.close()
+    # Once each, after the turn's outcome committed: the reply was out before they ran.
+    assert fired == [("answers", "terminal"), ("fails", "terminal")]
+
+
+@pytest.mark.asyncio
+async def test_post_delivery_is_taken_by_the_key_the_turn_registered_under(tmp_path, monkeypatch):
+    """A route rebind while the turn runs must not strand the slot under the key it registered with."""
+    from gateway.session_contract import Submission
+    from gateway.session_local import create_local_session
+
+    runner, authority, db = await _owner(tmp_path, monkeypatch)
+    fired = []
+
+    async def turn(event):
+        live = authority.sessions[ref.session_id]
+        runner._delivery_adapter_for(live.source).register_post_delivery_callback(
+            live.route, lambda: fired.append(event.text), generation=1)
+        live.route = live.route + ":rebound"
+        return "ok"
+
+    monkeypatch.setattr(runner, "_handle_message", turn)
+    try:
+        ref = create_local_session(authority, _viewer(), dict(request_id="r", source="tui", model="fixture",
+                                                              toolsets=[]))
+        live = authority.sessions[ref.session_id]
+        await authority.submit(_viewer(), Submission("answers", ref, {"text": "answers"}, "queue"))
+        await async_wait_until(lambda: fired == ["answers"], timeout=10, what="the post-delivery callback")
+        assert runner._delivery_adapter_for(live.source)._post_delivery_callbacks == {}
+    finally:
+        db.close()
+
+
+@pytest.mark.asyncio
+async def test_deleted_local_session_leaves_nothing_on_the_local_adapter(tmp_path, monkeypatch):
+    from gateway.session_local import create_local_session
+    from gateway.session_mutations import mutate_session
+    from gateway.session_queued_controls import _interactive
+
+    runner, authority, db = await _owner(tmp_path, monkeypatch)
+    try:
+        refs = [create_local_session(authority, _viewer(), dict(request_id=f"r{i}", source="gui", model="fixture",
+                                                                toolsets=[])) for i in range(2)]
+        kept, deleted = (authority.sessions[ref.session_id] for ref in refs)
+        adapter = runner._delivery_adapter_for(kept.source)
+        for live in (kept, deleted):
+            adapter.register_post_delivery_callback(live.route, lambda: None, generation=1)
+            with live.event_stream.lock:
+                _interactive(authority, live.source.chat_id)
+        result = await mutate_session(authority, _viewer(), refs[1], dict(
+            session_id=refs[1].session_id, request_id="delete", expected_revision=0,
+            expected_generation=0, operation="delete", payload={}))
+        assert result.get("deleted_ids") == [refs[1].session_id]
+        assert set(adapter.sources) == set(adapter.policies) == set(authority.launch_sources) == {
+            refs[0].session_id}
+        assert set(adapter._post_delivery_callbacks) == {kept.route}
+        assert adapter.authorize_source(kept.source)
+    finally:
+        db.close()
