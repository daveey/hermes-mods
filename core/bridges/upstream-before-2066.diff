diff --git a/tests/gateway/test_exec_approval_text_fallback_split_cap.py b/tests/gateway/test_exec_approval_text_fallback_split_cap.py
new file mode 100644
index 00000000000..9b6391d5fc5
--- /dev/null
+++ b/tests/gateway/test_exec_approval_text_fallback_split_cap.py
@@ -0,0 +1,92 @@
+"""The ``/approve`` text fallback on an adapter whose ``send`` caps a split message (Discord's
+``MAX_SPLIT_MESSAGES``) or cannot report a lost chunk (the relay): the uncut command must not push the
+answer instructions and the deadline past what is delivered (#62359)."""
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from gateway.config import PlatformConfig
+from gateway.run_turn_runner import TurnRunner
+from tools import approval
+from tools.approval_gateway_wait import _ApprovalEntry
+
+SESSION = "agent:main:discord:dm:555"
+TAIL = "&& rm -rf ~ # TAIL_MARKER"
+
+
+def _discord():
+    from plugins.platforms.discord.adapter import DiscordAdapter
+
+    adapter = DiscordAdapter(PlatformConfig(enabled=True, token="***"))
+    sent = []
+
+    async def fake_send(**kwargs):
+        sent.append(kwargs.get("content", ""))
+        return SimpleNamespace(id=len(sent))
+
+    channel = SimpleNamespace(send=AsyncMock(side_effect=fake_send))
+    adapter._client = SimpleNamespace(get_channel=lambda _chat_id: channel, fetch_channel=AsyncMock())
+
+    async def card_fails(**_kwargs):  # the button card could not be sent: the text fallback answers
+        raise RuntimeError("card send failed")
+    adapter.send_exec_approval = card_fails
+    adapter.pause_typing_for_chat = lambda _c: None
+    return adapter, sent
+
+
+def _render(adapter, command: str) -> None:
+    """Drive the production fallback path (``TurnRunner._render_approval_sync``) on ``adapter``."""
+    loop = asyncio.new_event_loop()
+    turn = object.__new__(TurnRunner)
+    turn._ctx = SimpleNamespace(_status_adapter=adapter, _status_chat_id="555", session_key=SESSION,
+                                _status_thread_metadata=None, _run_still_current=lambda: True)
+    turn._schedule = lambda coro, _m: SimpleNamespace(result=lambda timeout=None: loop.run_until_complete(coro))
+    turn._close_native_stream_boundary = lambda *_a, **_k: True
+    try:
+        turn._render_approval_sync({"command": command, "description": "recursive delete", "request_id": "r1"})
+    finally:
+        loop.close()
+
+
+@pytest.fixture()
+def pending():
+    entry = _ApprovalEntry({"request_id": "r1", "command": "x"})
+    with approval._lock:
+        approval._gateway_queues[SESSION] = [entry]
+    yield entry
+    with approval._lock:
+        approval._gateway_queues.clear()
+
+
+def test_discord_fallback_past_the_chunk_cap_keeps_instructions_and_offers_only_deny(pending):
+    adapter, sent = _discord()
+    _render(adapter, "echo " + "A" * 20000 + " " + TAIL)
+    delivered = "".join(sent)
+    assert "/deny" in delivered and "it will NOT run" in delivered  # instructions and deadline survive
+    assert TAIL not in delivered and "/approve" not in delivered  # an unseen tail is never offered for approval
+    assert len(sent) <= adapter.MAX_SPLIT_MESSAGES
+
+
+def test_relay_fallback_longer_than_one_message_keeps_instructions_and_offers_only_deny(pending):
+    from tests.gateway.relay.test_relay_full_command_proof import _Connector, _relay
+
+    connector = _Connector()
+    adapter = _relay(connector)
+
+    async def card_fails(**_kwargs):
+        raise RuntimeError("card send failed")
+    adapter.send_exec_approval, adapter.pause_typing_for_chat = card_fails, lambda _c: None
+    _render(adapter, "echo " + "A" * 6000 + " " + TAIL)
+    assert len(connector.sends) == 1 and len(connector.sends[0]) <= 2000  # nothing left for the connector to split
+    assert "/deny" in connector.sends[0] and "/approve" not in connector.sends[0] and TAIL not in connector.sends[0]
+
+
+def test_discord_fallback_within_the_chunk_cap_keeps_every_choice(pending):
+    adapter, sent = _discord()
+    _render(adapter, "echo " + "A" * 5000 + " " + TAIL)
+    delivered = "".join(sent)
+    assert TAIL in delivered and "/approve" in delivered and "/deny" in delivered
diff --git a/tests/gateway/test_exec_approval_truncated_preview.py b/tests/gateway/test_exec_approval_truncated_preview.py
new file mode 100644
index 00000000000..aad2f63fdbb
--- /dev/null
+++ b/tests/gateway/test_exec_approval_truncated_preview.py
@@ -0,0 +1,138 @@
+"""An approval card whose command preview is cut never offers an approve choice for text the user could
+not read: the whole command is sent just before the card, or, when it cannot be, only Deny is offered."""
+
+import pytest
+
+from gateway.platforms.base import BasePlatformAdapter, SendResult
+
+
+class _Chat(BasePlatformAdapter):
+    """Concrete adapter with a 1,000-char cap that records sends and the rendered prompt."""
+
+    MAX_MESSAGE_LENGTH = 1000
+
+    def __init__(self, *, send_ok: bool = True) -> None:
+        self.sent, self.prompts, self._send_ok = [], [], send_ok
+
+    def _exec_approval_cmd_budget(self, description: str, smart_denied: bool) -> int:
+        return 600
+
+    async def connect(self):  # pragma: no cover - unused
+        pass
+
+    async def disconnect(self):  # pragma: no cover - unused
+        pass
+
+    async def get_chat_info(self, chat_id):  # pragma: no cover - unused
+        return {}
+
+    async def send(self, chat_id, content, reply_to=None, metadata=None):
+        self.sent.append(content)
+        self.sent_metadata = metadata
+        return SendResult(success=self._send_ok, message_id="m1")
+
+    async def _send_exec_approval_prompt(self, prompt):
+        self.prompts.append(prompt)
+        return SendResult(success=True, message_id="card")
+
+
+def _choices(adapter):
+    return [choice for _, choice, _ in adapter.prompts[-1].actions]
+
+
+async def _ask(adapter, command):
+    await adapter.send_exec_approval("c1", command, "sk", description="flagged", request_id="r1")
+    return adapter.prompts[-1].text
+
+
+@pytest.mark.asyncio
+async def test_short_command_keeps_the_compact_card():
+    adapter = _Chat()
+    text = await _ask(adapter, "rm -rf /tmp/x")
+    assert adapter.sent == [] and "rm -rf /tmp/x" in text and "Preview shortened" not in text
+    assert _choices(adapter) == ["once", "session", "always", "deny"]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(("command", "send_ok", "choices", "attempted"), [
+    ("echo " + "A" * 900 + " && rm -rf ~ # TAIL", True, ["once", "session", "always", "deny"], True),
+    ("echo " + "A" * 900 + " && rm -rf ~ # TAIL", False, ["deny"], True),  # the full send failed
+    ("echo '```' " + "A" * 900 + " && rm -rf ~ # TAIL", True, ["deny"], False),  # cannot be fenced verbatim
+])
+async def test_truncated_preview_is_backed_by_the_full_command_or_deny_only(command, send_ok, choices, attempted):
+    adapter = _Chat(send_ok=send_ok)
+    text = await _ask(adapter, command)
+    assert "TAIL" not in text and "Preview shortened" in text and str(len(command)) in text
+    assert _choices(adapter) == choices
+    assert adapter.sent == ([f"```\n{command}\n```"] if attempted else [])
+
+
+@pytest.mark.asyncio
+async def test_full_command_send_is_marked_interim_so_it_never_seals_the_live_response():
+    """The full command goes out mid-turn: unmarked, a stream-is-the-message adapter (relay drafts) reads it
+    as the turn-final reply and swallows every later update to the open stream."""
+    adapter = _Chat()
+    await adapter.send_exec_approval("c1", "echo " + "A" * 900, "sk", metadata={"thread_id": "t1"})
+    assert adapter.sent_metadata == {"thread_id": "t1", "_interim_send": True}
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("adapter_factory", ["base", "discord", "slack"])
+async def test_backticks_inside_a_short_command_cannot_close_the_card_fence(adapter_factory):
+    """A ``` (or longer run) in the command would end the card's markdown fence early, and the rest
+    would render as markdown (spoilers, links): the fence is longer than any run in the command."""
+    from gateway.platforms.base_exec_approval import render_exec_approval
+
+    adapter = _Chat()
+    if adapter_factory == "discord":
+        from plugins.platforms.discord.adapter import DiscordAdapter
+        adapter = DiscordAdapter.__new__(DiscordAdapter)
+        adapter._approval_mention_content = lambda: ""
+    elif adapter_factory == "slack":
+        from plugins.platforms.slack.adapter import SlackAdapter
+        adapter = SlackAdapter.__new__(SlackAdapter)
+    command = "echo '```' ||spoiler|| [x](https://e.x) ````` done"
+    text, truncated = render_exec_approval(adapter, command, "flagged", False, True)
+    assert not truncated
+    fence = "``````"  # one longer than the command's longest run (5)
+    assert text.count(fence) == 2
+    assert text.index(fence) < text.index(command) < text.rindex(fence)
+
+
+@pytest.mark.parametrize("command", ["echo " + "`" * 900 + " ; rm -rf ~", "`" * 1990, "`" * 5000],
+                         ids=["echo-900-ticks", "1990-ticks", "5000-ticks"])
+def test_a_long_backtick_run_the_preview_drops_cannot_push_the_card_past_the_cap(command):
+    """The fence is sized from the preview actually shown: a backtick run cut off with the tail must not
+    widen the fence past Discord's 2,000-char cap (that card fell back to text and lost its buttons)."""
+    import re
+
+    from gateway.platforms.base_exec_approval import render_exec_approval
+    from plugins.platforms.discord.adapter import DiscordAdapter
+
+    adapter = DiscordAdapter.__new__(DiscordAdapter)
+    adapter._approval_mention_content = lambda: ""
+    text, truncated = render_exec_approval(adapter, command, "flagged", False, False)
+    assert len(text) <= adapter.MAX_MESSAGE_LENGTH
+    assert truncated and "Preview shortened" in text and "only Deny is offered" in text
+    runs = re.findall(r"^(`{3,})", text, re.MULTILINE)
+    open_fence, close_fence = runs[0], runs[-1]  # the opener line and the closer line
+    shown = text[text.index(open_fence) + len(open_fence):text.rindex(close_fence)].removeprefix("bash")
+    assert open_fence == close_fence and max(map(len, re.findall("`+", shown)), default=0) < len(open_fence)
+
+
+@pytest.mark.parametrize("command", ["`" * 20 + " rm -rf ~ " + "`" * 20, "`" * 20 + "x" * 4000 + "`" * 20],
+                         ids=["fits", "cut"])
+def test_slack_fence_sits_on_its_own_line_so_the_commands_backticks_never_merge_into_it(command):
+    """With the fence glued to the command, 20 leading backticks and a 21-tick fence render as one 41-tick run."""
+    import re
+
+    from gateway.platforms.base_exec_approval import render_exec_approval
+    from plugins.platforms.slack.adapter import SlackAdapter
+
+    adapter = SlackAdapter.__new__(SlackAdapter)
+    text, _ = render_exec_approval(adapter, command, "flagged", False, False)
+    assert len(text) <= 3000  # Slack's section cap
+    fence = "`" * 21
+    assert text.splitlines().count(fence) == 2  # opener and closer each alone on a line
+    shown = text.split(fence + "\n", 1)[1].rsplit("\n" + fence, 1)[0]
+    assert shown.startswith("`" * 20) and max(map(len, re.findall("`+", shown))) == 20
diff --git a/tests/gateway/test_execute_claimed_cancel_stamp.py b/tests/gateway/test_execute_claimed_cancel_stamp.py
new file mode 100644
index 00000000000..92eae999216
--- /dev/null
+++ b/tests/gateway/test_execute_claimed_cancel_stamp.py
@@ -0,0 +1,38 @@
+"""A drain cancelled while its turn waits on a cold ``/refine`` review's cancel leaves no executing stamp.
+
+``_stamp_claim`` sets ``executing[sid]`` before ``_execute_claimed`` runs; session retirement skips an
+executing session, so a stamp left behind pins the session in memory forever. The real review-run
+handshake and canceller run; only the admitted turn is stubbed.
+"""
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+
+@pytest.mark.asyncio
+async def test_a_drain_cancelled_during_the_review_cancel_clears_the_executing_stamp(monkeypatch):
+    from agent.background_review import finish_background_review_run, prepare_background_review_run
+    from gateway import session_finite
+    from gateway.session_authority import LiveSession, SessionAuthority
+    from gateway.session_contract import SessionRef
+    ran = []
+
+    async def turn(authority, ref, row):
+        ran.append(row['admission_id'])
+        return 'ok'
+    monkeypatch.setattr(session_finite, 'execute_finite_admission', turn)
+    ref = SessionRef('p', 'review-cancel-stamp')
+    live = LiveSession(SimpleNamespace(chat_id=ref.session_id), 'route')
+    run = prepare_background_review_run(live.review)  # a review still in its request phase
+    owner = SimpleNamespace(executing={ref.session_id: 7})  # as _stamp_claim left it
+    task = asyncio.ensure_future(SessionAuthority._execute_claimed(owner, ref, live, {'admission_id': 'a'}))
+    try:
+        # The canceller has fenced the review and now waits (off-loop) for its acknowledgement.
+        assert await asyncio.to_thread(run.cancel_requested.wait, 10), 'the turn never cancelled the review'
+        task.cancel()
+        await asyncio.wait({task}, timeout=10)
+    finally:
+        finish_background_review_run(live.review, run)  # releases the canceller's bounded wait
+    assert task.cancelled() and ran == [], (task, ran)
+    assert ref.session_id not in owner.executing, owner.executing
