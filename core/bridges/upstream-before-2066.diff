diff --git a/tests/gateway/test_slack_standalone_media_proxy_secret.py b/tests/gateway/test_slack_standalone_media_proxy_secret.py
new file mode 100644
index 00000000000..3214748af6a
--- /dev/null
+++ b/tests/gateway/test_slack_standalone_media_proxy_secret.py
@@ -0,0 +1,86 @@
+"""Slack's standalone media branch and its ``conversations.open`` DM lookup reach the model and the
+logs with the error text of a request sent through the resolved proxy: a secret in that proxy URL must
+not ride along (the text-only branch redacts already)."""
+
+import asyncio
+import json
+import logging
+import sys
+from types import ModuleType, SimpleNamespace
+from unittest.mock import patch
+from urllib.parse import unquote
+
+import pytest
+
+pytest.importorskip("aiohttp")
+
+SECRET = "qzxqzxqzx"
+PROXY = f"http://bob:{SECRET}#x@127.0.0.1:1"
+ENV_PROXY_VARS = ("HTTPS_PROXY", "HTTP_PROXY", "ALL_PROXY", "https_proxy", "http_proxy", "all_proxy", "NO_PROXY", "no_proxy")
+
+
+class _EchoingClient:
+    """``AsyncWebClient`` stand-in whose transport echoes the proxy it was given, as aiohttp does."""
+
+    def __init__(self, **_kw):
+        self.proxy = None
+
+    async def _fail(self, **_kw):
+        raise ConnectionError(f"Cannot connect to host slack.com:443 via proxy {self.proxy}")
+
+    chat_postMessage = files_upload_v2 = _fail
+
+
+@pytest.fixture
+def slack(monkeypatch):
+    from plugins.platforms.slack import adapter as slack_mod
+
+    for name in ENV_PROXY_VARS:
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setenv("HTTPS_PROXY", PROXY)
+    async_client = ModuleType("slack_sdk.web.async_client")
+    async_client.AsyncWebClient = _EchoingClient
+    for name, mod in {"slack_sdk": ModuleType("slack_sdk"), "slack_sdk.web": ModuleType("slack_sdk.web"),
+                      "slack_sdk.web.async_client": async_client}.items():
+        monkeypatch.setitem(sys.modules, name, mod)
+    with patch("gateway.platforms.base.gateway_trust_env", return_value=True):
+        yield slack_mod
+
+
+def _rendered(caplog):
+    formatter = logging.Formatter("%(message)s")
+    return "\n".join(formatter.format(r) for r in caplog.records)
+
+
+def _leaked(*texts):
+    return [t for t in texts if SECRET in t or SECRET in unquote(t)]
+
+
+@pytest.mark.parametrize("caption", [None, "see attached"])
+def test_media_send_never_carries_the_proxy_secret(slack, caplog, tmp_path, caption):
+    image = tmp_path / "a.png"
+    image.write_bytes(b"\x89PNG")
+    cfg = SimpleNamespace(token="xoxb-fake", extra={})
+    with caplog.at_level(logging.DEBUG):
+        result = asyncio.run(slack._standalone_send(cfg, "C123", "hi", media_files=[(str(image), False)], caption=caption))
+    text = json.dumps(result)
+    assert "ConnectionError via " in text, text  # the proxy-error rendering, not an unrelated failure
+    assert not _leaked(text, _rendered(caplog)), (text, _rendered(caplog))
+
+
+def test_missing_media_caption_fallback_log_never_carries_the_proxy_secret(slack, caplog, tmp_path):
+    cfg = SimpleNamespace(token="xoxb-fake", extra={})
+    with caplog.at_level(logging.DEBUG):
+        asyncio.run(slack._standalone_send(cfg, "C123", "", media_files=[(str(tmp_path / "gone.png"), False)], caption="cap"))
+    assert "Caption-fallback send failed" in caplog.text
+    assert not _leaked(_rendered(caplog)), _rendered(caplog)
+
+
+def test_dm_open_log_never_carries_the_proxy_secret(slack, caplog):
+    """Real aiohttp through the unparseable proxy URL: its InvalidURL text repeats the password."""
+    cfg = SimpleNamespace(token="xoxb-fake", extra={})
+    with caplog.at_level(logging.DEBUG):
+        result = asyncio.run(asyncio.wait_for(slack._standalone_send(cfg, "U123", "hi"), 30))
+    assert "user ID resolution failed" in result["error"], result
+    assert "conversations.open exception" in caplog.text, caplog.text
+    assert not _leaked(_rendered(caplog)), _rendered(caplog)
diff --git a/tests/gateway/test_standalone_send_proxy_secret.py b/tests/gateway/test_standalone_send_proxy_secret.py
new file mode 100644
index 00000000000..1345eaec148
--- /dev/null
+++ b/tests/gateway/test_standalone_send_proxy_secret.py
@@ -0,0 +1,71 @@
+"""A standalone (out-of-process) send through a proxy whose URL carries a secret never returns that
+secret in the tool result: the result text reaches the model, which may repeat it in chat.
+
+Drives each real ``_standalone_send`` with real aiohttp against an unreachable proxy URL."""
+
+import asyncio
+import json
+from types import SimpleNamespace
+from unittest.mock import patch
+from urllib.parse import unquote
+
+import pytest
+
+pytest.importorskip("aiohttp")
+
+PASSWORD = "p{a}ss|w0rd^99"
+SHAPES = ["bob:{pw}@127.0.0.1:1", "http://bob:{pw}#x@127.0.0.1:1"]
+ENV_PROXY_VARS = ("HTTPS_PROXY", "HTTP_PROXY", "ALL_PROXY", "https_proxy", "http_proxy", "all_proxy")
+
+
+def _leaks(text: str) -> list[str]:
+    pieces = {PASSWORD[i:j] for i in range(len(PASSWORD)) for j in range(i + 4, len(PASSWORD) + 1)}
+    return sorted(p for p in pieces if p in text or p in unquote(text))
+
+
+def _mattermost(monkeypatch, proxy):
+    from plugins.platforms.mattermost import adapter as mm
+
+    monkeypatch.setenv("MATTERMOST_PROXY", proxy)
+    cfg = SimpleNamespace(token="tok", extra={"url": "http://127.0.0.1:9"}, api_key=None)
+    return mm._standalone_send(cfg, "chan", "hi")
+
+
+def _sms(monkeypatch, proxy):
+    from plugins.platforms.sms import adapter as sms
+
+    secrets = {"TWILIO_ACCOUNT_SID": "AC1", "TWILIO_PHONE_NUMBER": "+15550000000", "TWILIO_AUTH_TOKEN": "t"}
+    monkeypatch.setattr(sms, "_get_scoped_secret", lambda key, default="": secrets.get(key, default))
+    return sms._standalone_send(SimpleNamespace(api_key="t"), "+15550000001", "hi")
+
+
+def _slack(monkeypatch, proxy):
+    from plugins.platforms.slack import adapter as slack
+
+    return slack._standalone_send(SimpleNamespace(token="xoxb-fake", extra={}), "C123", "hi")
+
+
+def _discord(monkeypatch, proxy):
+    from plugins.platforms.discord import adapter as dc
+
+    monkeypatch.setenv("DISCORD_PROXY", proxy)
+    return dc._standalone_send(SimpleNamespace(token="bot-token"), "123", "hi", thread_id="456")
+
+
+SENDERS = {"mattermost": _mattermost, "sms": _sms, "slack": _slack, "discord": _discord}
+
+
+@pytest.mark.parametrize("shape", SHAPES)
+@pytest.mark.parametrize("sender", list(SENDERS))
+def test_standalone_send_result_never_carries_the_proxy_secret(monkeypatch, sender, shape):
+    proxy = shape.format(pw=PASSWORD)
+    for name in ENV_PROXY_VARS:
+        monkeypatch.setenv(name, proxy)
+    for name in ("NO_PROXY", "no_proxy"):
+        monkeypatch.delenv(name, raising=False)
+    with patch("gateway.platforms.base.gateway_trust_env", return_value=True):
+        result = asyncio.run(asyncio.wait_for(SENDERS[sender](monkeypatch, proxy), 30))
+    text = json.dumps(result)
+    assert result.get("error"), result
+    assert " via " in result["error"], result  # the proxy-error path, not an unrelated failure
+    assert not _leaks(text), (_leaks(text), text)
