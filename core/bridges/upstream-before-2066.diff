+    host = f"[{host}]" if ":" in host else host
+    return f"{host}:{port}" if port is not None else host
+
+
+def _fit(safe: str, max_len: int) -> str:
+    if len(safe) <= max_len:
+        return safe
+    return "." * max_len if max_len <= 3 else f"{safe[:max_len - 3]}..."
 
 
