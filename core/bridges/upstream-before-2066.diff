diff --git a/tests/gateway/test_qqbot_approval_request_binding.py b/tests/gateway/test_qqbot_approval_request_binding.py
new file mode 100644
index 00000000000..55f6660658b
--- /dev/null
+++ b/tests/gateway/test_qqbot_approval_request_binding.py
@@ -0,0 +1,88 @@
+"""A QQBot approval card resolves the request it was rendered for, not the session's oldest (#124974).
+
+Drives the real ``tools.approval`` queue through ``send_exec_approval``'s keyboard and the adapter's
+``_default_interaction_dispatch``; nothing on the approval side is faked.
+"""
+
+import pytest
+
+from gateway.config import PlatformConfig
+from plugins.platforms.qqbot.keyboards import build_approval_keyboard, parse_approval_button_data, parse_interaction_event
+
+SESSION = "agent:main:qqbot:dm:u-42"
+
+
+def _adapter():
+    from plugins.platforms.qqbot.adapter import QQAdapter
+    return QQAdapter(PlatformConfig(enabled=True, extra={"app_id": "a", "client_secret": "b"}))
+
+
+def _queue(n):
+    """``n`` pending exec approvals in SESSION, each on its own waiting thread; returns their entries."""
+    from tools import approval
+    entries = []
+    for i in range(n):
+        from tools.approval_gateway_wait import _ApprovalEntry
+        entry = _ApprovalEntry({"command": f"cmd-{i}", "description": "d"})
+        with approval._lock:
+            approval._gateway_queues.setdefault(SESSION, []).append(entry)
+        entries.append(entry)
+    return entries
+
+
+def _tap(button_data):
+    return parse_interaction_event({"id": "i", "chat_type": 2, "user_openid": "u-42",
+                                    "data": {"resolved": {"button_data": button_data}}})
+
+
+async def _sent_card(adapter, request_id):
+    """The keyboard ``send_exec_approval`` hands to the QQ transport."""
+    sent = []
+
+    async def capture(chat_id, content, keyboard, reply_to=None):
+        sent.append(keyboard)
+        from gateway.platforms.base import SendResult
+        return SendResult(success=True, message_id="m1")
+
+    adapter.send_with_keyboard = capture
+    await adapter.send_exec_approval("u-42", "rm -rf x", SESSION, request_id=request_id)
+    return sent[0]
+
+
+@pytest.mark.asyncio
+async def test_tap_on_the_newest_card_resolves_the_newest_request():
+    from tools import approval
+    old, new = _queue(2)
+    try:
+        adapter = _adapter()
+        card = await _sent_card(adapter, new.data["request_id"])
+        allow = card.content.rows[0].buttons[0].action.data
+
+        await adapter._default_interaction_dispatch(_tap(allow))
+
+        assert new.event.is_set() and new.result == "once"
+        assert not old.event.is_set(), "the tap answered the session's oldest approval instead"
+    finally:
+        with approval._lock:
+            approval._gateway_queues.pop(SESSION, None)
+
+
+@pytest.mark.asyncio
+async def test_card_of_a_settled_request_resolves_nothing():
+    from tools import approval
+    (pending,) = _queue(1)
+    try:
+        stale = build_approval_keyboard(SESSION, request_id="0" * 32).content.rows[0].buttons[0].action.data
+        await _adapter()._default_interaction_dispatch(_tap(stale))
+        assert not pending.event.is_set()
+    finally:
+        with approval._lock:
+            approval._gateway_queues.pop(SESSION, None)
+
+
+def test_legacy_card_whose_session_ends_in_hex_keeps_its_whole_session():
+    """QQ openids are 32 hex: a card without a request id must not have its session tail read as one."""
+    from plugins.platforms.qqbot.keyboards import approval_button_request_id
+    hex_session = "agent:main:qqbot:dm:" + "ab" * 16
+    assert parse_approval_button_data(f"approve:{hex_session}:deny") == (hex_session, "deny")
+    assert approval_button_request_id(f"approve:{hex_session}:deny") is None
diff --git a/tests/gateway/test_restart_ack_before_teardown.py b/tests/gateway/test_restart_ack_before_teardown.py
new file mode 100644
index 00000000000..997f2ff181c
--- /dev/null
+++ b/tests/gateway/test_restart_ack_before_teardown.py
@@ -0,0 +1,133 @@
+"""An idle /restart delivers its acknowledgement BEFORE teardown starts.
+
+The ack used to be the command's return value, sent after ``request_restart`` had begun stopping the
+gateway; on a real Bot API round trip the adapter disconnected first and the user saw nothing.
+"""
+
+import asyncio
+
+import pytest
+
+from gateway.platforms.base import SendResult
+from gateway.platforms.event import MessageEvent, MessageType
+from tests.gateway.restart_test_helpers import make_restart_runner, make_restart_source
+
+
+def _idle_restart(monkeypatch, tmp_path, send):
+    monkeypatch.setattr("gateway.run._hermes_home", tmp_path)
+    monkeypatch.setattr("gateway.restart.is_container_restart_context", lambda: False)
+    monkeypatch.setattr("gateway.restart.is_gateway_supervisor_process", lambda: False)
+    runner, adapter = make_restart_runner()
+    monkeypatch.setattr(adapter, "send", send)
+    order = []
+    runner.request_restart = lambda **kw: order.append("restart") or True
+    return runner, order
+
+
+@pytest.mark.asyncio
+async def test_idle_restart_ack_is_delivered_before_teardown_starts(monkeypatch, tmp_path):
+    """Restart is requested only after the platform has ANSWERED the ack, not when the send starts."""
+    started, answered = asyncio.Event(), asyncio.Event()
+    sent = []
+
+    async def send(chat_id, content, **kwargs):
+        sent.append(content)
+        started.set()
+        await answered.wait()  # the Bot API round trip is still in flight
+        return SendResult(success=True, message_id="ack")
+
+    runner, order = _idle_restart(monkeypatch, tmp_path, send)
+    event = MessageEvent(text="/restart", message_type=MessageType.TEXT, source=make_restart_source(), message_id="m1")
+
+    handled = asyncio.create_task(runner._handle_message(event))
+    await asyncio.wait_for(started.wait(), timeout=5)
+    for _ in range(20):  # let a restart that does not wait for the answer run now
+        await asyncio.sleep(0)
+    assert len(sent) == 1 and "Restarting" in sent[0]
+    assert order == []  # send in flight: teardown has not been requested
+    answered.set()
+    result = await asyncio.wait_for(handled, timeout=5)
+
+    assert order == ["restart"]
+    assert not result  # already delivered: no second copy through the reply path
+
+
+@pytest.mark.asyncio
+async def test_idle_restart_ack_carries_the_ordinary_reply_routing(monkeypatch, tmp_path):
+    """The early ack is routed like any command reply: a forum-topic reply goes by topic metadata
+    with no reply anchor, and it is notify-worthy (not sent silently)."""
+    sent = []
+
+    async def send(chat_id, content, **kwargs):
+        sent.append(kwargs)
+        return SendResult(success=True, message_id="ack")
+
+    runner, _order = _idle_restart(monkeypatch, tmp_path, send)
+    source = make_restart_source(chat_id="-100777", chat_type="group", thread_id="42")
+    event = MessageEvent(text="/restart", message_type=MessageType.TEXT, source=source, message_id="m1")
+
+    await runner._handle_message(event)
+
+    assert sent[0]["reply_to"] is None
+    assert sent[0]["metadata"]["thread_id"] == "42"
+    assert sent[0]["metadata"]["notify"] is True
+
+
+@pytest.mark.asyncio
+async def test_local_restart_returns_its_ack(monkeypatch, tmp_path):
+    """A LOCAL session (``hermes chat -q "/restart"``) shows the handler's RETURNED reply; its
+    adapter's send is a no-op, so an early send there would leave the ack nowhere."""
+    from types import SimpleNamespace
+    from gateway.config import Platform
+    from gateway.session import SessionSource
+    from gateway.session_local import LocalSessionAdapter
+
+    async def send(chat_id, content, **kwargs):
+        return SendResult(success=True, message_id="ack")
+
+    runner, order = _idle_restart(monkeypatch, tmp_path, send)
+    runner.adapters[Platform.LOCAL] = LocalSessionAdapter(SimpleNamespace(runner=runner, sessions={}))
+    source = SessionSource(platform=Platform.LOCAL, chat_id="local-1", user_id="u1", chat_type="dm")
+    event = MessageEvent(text="/restart", message_type=MessageType.TEXT, source=source, message_id="m1")
+
+    result = await runner._handle_message(event)
+
+    assert order == ["restart"]
+    assert result and "Restarting" in result
+
+
+@pytest.mark.asyncio
+async def test_timed_out_restart_ack_is_not_sent_twice(monkeypatch, tmp_path):
+    """A send that timed out may already have landed; the reply path must not post a second copy."""
+    sent = []
+
+    async def send(chat_id, content, **kwargs):
+        sent.append(content)
+        return SendResult(success=False, error="Timed out")
+
+    runner, order = _idle_restart(monkeypatch, tmp_path, send)
+    event = MessageEvent(text="/restart", message_type=MessageType.TEXT, source=make_restart_source(), message_id="m1")
+
+    result = await runner._handle_message(event)
+
+    assert order == ["restart"] and len(sent) == 1
+    assert not result
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("error,retryable", [("Timed out", True), ("httpx.ConnectTimeout: timed out", False)],
+                         ids=["retryable-flag", "connect-timeout-text"])
+async def test_undelivered_timeout_falls_back_to_the_reply(monkeypatch, tmp_path, error, retryable):
+    """A timeout that never left (Telegram flags a wrapped ConnectTimeout / pool timeout ``retryable``;
+    other adapters name the connect timeout) was not delivered, so the ack still goes out through the
+    reply path, as ``_send_with_retry`` would retry it."""
+    async def send(chat_id, content, **kwargs):
+        return SendResult(success=False, error=error, retryable=retryable)
+
+    runner, order = _idle_restart(monkeypatch, tmp_path, send)
+    event = MessageEvent(text="/restart", message_type=MessageType.TEXT, source=make_restart_source(), message_id="m1")
+
+    result = await runner._handle_message(event)
+
+    assert order == ["restart"]
+    assert result and "Restarting" in result
diff --git a/tests/gateway/test_run_progress_flood_window.py b/tests/gateway/test_run_progress_flood_window.py
new file mode 100644
index 00000000000..8ccc227ce91
--- /dev/null
+++ b/tests/gateway/test_run_progress_flood_window.py
@@ -0,0 +1,270 @@
+"""A flood-refused progress edit never answers with a fresh send into the same chat (#76494).
+
+Telegram bills every call against the chat's open penalty and lengthens it while hammered: the
+progress loop used to answer a refused edit of its bubble with ``adapter.send()``, one extra message
+per tick for as long as the penalty lasted. Drives the real ``GatewayRunner._run_agent`` progress
+loop; only the agent and the platform transport are fakes.
+"""
+
+import importlib
+import sys
+import time
+import types
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.config import Platform, PlatformConfig
+from gateway.platforms.base import BasePlatformAdapter, SendResult
+from gateway.session import SessionSource
+
+
+class FloodedEditAdapter(BasePlatformAdapter):
+    """Every edit is refused with the canonical Telegram fail-closed flood result."""
+
+    def __init__(self, retry_after: float):
+        super().__init__(PlatformConfig(enabled=True, token="***"), Platform.TELEGRAM)
+        self.retry_after = retry_after
+        self.sent, self.edits = [], []
+
+    async def connect(self, *, is_reconnect: bool = False) -> bool:
+        return True
+
+    async def disconnect(self) -> None:
+        return None
+
+    async def send(self, chat_id, content, reply_to=None, metadata=None) -> SendResult:
+        self.sent.append(content)
+        return SendResult(success=True, message_id=f"m{len(self.sent)}")
+
+    async def edit_message(self, chat_id, message_id, content) -> SendResult:
+        self.edits.append(content)
+        return SendResult(success=False, error=f"flood_control:{self.retry_after}", retry_after=self.retry_after)
+
+    async def send_typing(self, chat_id, metadata=None) -> None:
+        return None
+
+    async def get_chat_info(self, chat_id: str):
+        return {"id": chat_id}
+
+
+class FourToolAgent:
+    """Opens the bubble, then three more tool events, each after the 1.5 s edit throttle."""
+
+    def __init__(self, **kwargs):
+        self.tool_progress_callback = kwargs.get("tool_progress_callback")
+        self.tools = []
+
+    @property
+    def is_interrupted(self) -> bool:
+        return False
+
+    def run_conversation(self, message, conversation_history=None, task_id=None):
+        for i in range(4):
+            self.tool_progress_callback("tool.started", "web_search", f"search {i}", {})
+            time.sleep(1.8)  # health: allow HX013 -- the gap must outlast the loop's real 1.5s edit throttle
+        return {"final_response": "done", "messages": [], "api_calls": 1}
+
+
+async def _run(monkeypatch, tmp_path, retry_after, adapter=None, agent_cls=FourToolAgent):
+    monkeypatch.setenv("HERMES_TOOL_PROGRESS_MODE", "all")
+    fake_run_agent = types.ModuleType("run_agent")
+    fake_run_agent.AIAgent = agent_cls
+    monkeypatch.setitem(sys.modules, "run_agent", fake_run_agent)
+    gateway_run = importlib.import_module("gateway.run")
+    monkeypatch.setattr(gateway_run, "_hermes_home", tmp_path)
+    monkeypatch.setattr(gateway_run, "_resolve_runtime_agent_kwargs", lambda: {"api_key": "fake"})
+    adapter = adapter or FloodedEditAdapter(retry_after)
+    runner = object.__new__(gateway_run.GatewayRunner)
+    runner.adapters = {adapter.platform: adapter}
+    runner._voice_mode, runner._prefill_messages, runner._running_agents = {}, [], {}
+    runner._ephemeral_system_prompt, runner._reasoning_config, runner._fallback_model = "", None, None
+    runner._provider_routing, runner._session_db = {}, None
+    runner.hooks = SimpleNamespace(loaded_hooks=False)
+    runner.config = SimpleNamespace(thread_sessions_per_user=False, group_sessions_per_user=False, stt_enabled=False)
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="-1001", chat_type="group")
+    result = await runner._run_agent(
+        message="hi", context_prompt="", history=[], source=source, session_id="s-flood",
+        session_key="agent:main:telegram:group:-1001")
+    return adapter, result
+
+
+@pytest.mark.asyncio
+async def test_flood_refused_progress_edit_sends_nothing_inside_the_window(monkeypatch, tmp_path):
+    adapter, result = await _run(monkeypatch, tmp_path, retry_after=30.0)
+
+    assert result["final_response"] == "done"
+    assert len(adapter.sent) == 1, adapter.sent  # the bubble itself; no fallback sends into the penalty
+    assert len(adapter.edits) == 1, adapter.edits  # the refusal opened a window: no further edits in it
+
+
+@pytest.mark.asyncio
+async def test_flood_refused_finalize_edit_is_not_retried_as_plain_text():
+    """The MarkdownV2 -> plain fallback is for parse errors; on a flood it was a second refused call."""
+    from unittest.mock import AsyncMock
+
+    from plugins.platforms.telegram.adapter import TelegramAdapter
+
+    class RetryAfter(Exception):
+        retry_after = 30
+
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="fake-token"))
+    adapter._bot = SimpleNamespace(edit_message_text=AsyncMock(side_effect=RetryAfter("Flood control exceeded. Retry in 30 seconds")))
+
+    result = await adapter.edit_message("-1001", "7", "**progress** line", finalize=True)
+
+    assert result.error == "flood_control:30"
+    assert adapter._bot.edit_message_text.await_count == 1
+
+
+class FloodOnceAdapter(FloodedEditAdapter):
+    """The first edit is refused with ``error`` (and ``retry_after``); later edits land."""
+
+    def __init__(self, error: str, retry_after=None):
+        super().__init__(0.0)
+        self.error, self.refused_retry_after, self.landed = error, retry_after, []
+
+    async def edit_message(self, chat_id, message_id, content) -> SendResult:
+        self.edits.append(content)
+        if len(self.edits) == 1:
+            return SendResult(success=False, error=self.error, retry_after=self.refused_retry_after)
+        self.landed.append((time.monotonic(), content))
+        return SendResult(success=True, message_id=message_id)
+
+
+class LongLastToolAgent:
+    """Two tool events, then a long-running last tool that emits no further progress."""
+
+    finished_at = 0.0
+
+    def __init__(self, **kwargs):
+        self.tool_progress_callback = kwargs.get("tool_progress_callback")
+        self.tools = []
+
+    @property
+    def is_interrupted(self) -> bool:
+        return False
+
+    def run_conversation(self, message, conversation_history=None, task_id=None):
+        self.tool_progress_callback("tool.started", "web_search", "search 0", {})
+        time.sleep(1.8)  # health: allow HX013 -- the gap must outlast the loop's real 1.5s edit throttle
+        self.tool_progress_callback("tool.started", "terminal", "long build", {})
+        time.sleep(4.0)  # health: allow HX013 -- the busy tool outlives the 1 s flood window
+        LongLastToolAgent.finished_at = time.monotonic()
+        return {"final_response": "done", "messages": [], "api_calls": 1}
+
+
+@pytest.mark.asyncio
+async def test_progress_held_by_a_flood_window_lands_when_it_closes_while_the_agent_is_busy(monkeypatch, tmp_path):
+    adapter = FloodOnceAdapter("flood_control:1.0", retry_after=1.0)
+
+    await _run(monkeypatch, tmp_path, 1.0, adapter=adapter, agent_cls=LongLastToolAgent)
+
+    in_turn = [content for at, content in adapter.landed if at < LongLastToolAgent.finished_at]
+    assert in_turn and "long build" in in_turn[0], adapter.landed  # not left stale until the turn ends
+    assert len(adapter.sent) == 1  # still no fallback send into the penalty
+
+
+@pytest.mark.asyncio
+async def test_flood_window_uses_the_wait_stated_in_raw_platform_wording(monkeypatch, tmp_path):
+    """The overflow-split path forwards PTB's text without ``retry_after``: the stated wait counts."""
+    adapter = FloodOnceAdapter("Flood control exceeded. Retry in 2 seconds")
+
+    await _run(monkeypatch, tmp_path, 0.0, adapter=adapter)
+
+    first_tick = adapter.landed[0][0] if adapter.landed else None
+    assert first_tick is not None, adapter.edits  # a 2 s penalty is not stretched into the 30 s default
+    assert len(adapter.sent) == 1
+
+
+def _held_progress(edit_results):
+    """The real progress mixin over a transport fake, holding an update owed by a closed window."""
+    import queue
+    from unittest.mock import AsyncMock
+
+    from gateway.run_turn_progress import GatewayTurnProgressMixin
+
+    loop = GatewayTurnProgressMixin()
+    loop._ctx = SimpleNamespace(
+        source=SimpleNamespace(chat_id="-1001"), _progress_metadata={}, _progress_reply_to=None, _cleanup_progress=False,
+        _run_still_current=lambda: True, agent_holder=[SimpleNamespace(is_interrupted=False)],
+        progress_queue=queue.Queue(), last_progress_msg=[None], repeat_count=[0])
+    adapter = SimpleNamespace(
+        name="fake", REQUIRES_EDIT_FINALIZE=False, edit_message=AsyncMock(side_effect=edit_results),
+        send=AsyncMock(return_value=SendResult(success=True, message_id="m2")))
+    st = loop._ProgressEditState(adapter, ["search 0", "long build"], "m1", True, len, 4000, False)
+    st.flood_pending, st.flood_until = True, 0.0
+    return loop, st
+
+
+@pytest.mark.asyncio
+async def test_progress_delivered_by_a_tool_event_is_not_resent_by_the_idle_retry():
+    """The bubble was deleted: the event's fallback send delivers the held line, so idle owes nothing."""
+    loop, st = _held_progress([SendResult(success=False, error="message to edit not found")])
+
+    await loop._progress_send_or_edit(st, "long build")
+    await loop._deliver_flood_pending_progress(st)
+
+    assert [c.kwargs["content"] for c in st.adapter.send.await_args_list] == ["long build"]
+
+
+@pytest.mark.asyncio
+async def test_held_progress_survives_a_transient_failure_of_its_idle_retry():
+    """A network blip on the first post-window edit leaves the update owed, not lost."""
+    loop, st = _held_progress([
+        SendResult(success=False, error="ConnectError", retryable=True),
+        SendResult(success=True, message_id="m1"),
+    ])
+
+    assert await loop._deliver_flood_pending_progress(st)  # attempted: caller spaces the next try
+    await loop._deliver_flood_pending_progress(st)
+
+    assert st.adapter.edit_message.await_count == 2
+    assert await loop._deliver_flood_pending_progress(st) is False  # landed: nothing left owed
+
+
+@pytest.mark.asyncio
+async def test_held_progress_reaches_its_own_bubble_after_a_content_reset():
+    """A content bubble landing inside the window closes the progress bubble; its held lines still land there."""
+    loop, st = _held_progress([SendResult(success=True, message_id="m1")])
+    st.flood_until = time.monotonic() + 60
+
+    loop._reset_progress_bubble(st)
+    assert await loop._deliver_flood_pending_progress(st) is False  # nothing fires into the open window
+    st.flood_until = 0.0  # the window closes while the agent works on
+    assert await loop._deliver_flood_pending_progress(st)
+
+    assert [(c.kwargs["message_id"], c.kwargs["content"]) for c in st.adapter.edit_message.await_args_list] == [
+        ("m1", "search 0\nlong build")]
+    assert await loop._deliver_flood_pending_progress(st) is False  # landed: nothing left owed
+
+
+@pytest.mark.asyncio
+async def test_a_closed_bubble_refused_again_stays_owed():
+    loop, st = _held_progress([
+        SendResult(success=False, error="flood_control:5", retry_after=5.0), SendResult(success=True, message_id="m1")])
+    loop._reset_progress_bubble(st)
+
+    assert await loop._deliver_flood_pending_progress(st)  # refused: a new window opens, the edit stays owed
+    assert await loop._deliver_flood_pending_progress(st) is False
+    st.flood_until = 0.0
+    assert await loop._deliver_flood_pending_progress(st)
+
+    assert st.adapter.edit_message.await_count == 2 and not st.owed_bubbles
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("held", [
+    {"flood_pending": False},  # nothing was held back
+    {"can_edit": False},  # one message per tool: nothing to edit
+    {"progress_msg_id": None},  # the bubble never landed
+])
+async def test_content_reset_owes_nothing_without_a_held_editable_bubble(held):
+    loop, st = _held_progress([SendResult(success=True, message_id="m1")])
+    for name, value in held.items():
+        setattr(st, name, value)
+
+    loop._reset_progress_bubble(st)
+
+    assert await loop._deliver_flood_pending_progress(st) is False
+    st.adapter.edit_message.assert_not_awaited()
