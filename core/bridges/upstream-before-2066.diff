+
+    monkeypatch.setattr(adapter, "send", _send)
+    formatter = logging.Formatter("%(levelname)s %(name)s %(message)s")
+    for call in (lambda: adapter.send_image("oc_x", "https://example.com/a.png"),
+                 lambda: adapter.send_animation("oc_x", "https://example.com/a.gif")):
+        caplog.clear()
+        with caplog.at_level(logging.DEBUG):
+            asyncio.run(asyncio.wait_for(call(), 60))
+        logs = "\n".join(formatter.format(r) for r in caplog.records if "feishu" in r.name)
+        assert "Failed to download" in logs, logs
+        assert "qzx" not in logs and "qzx" not in unquote(logs), logs[-2000:]
+
+
+@pytest.mark.parametrize("scheme", ["ftp", "socks4"])
+@pytest.mark.parametrize("sender", SENDERS)
+def test_an_unsupported_scheme_secret_proxy_is_redacted_even_when_no_proxy_names_the_target(monkeypatch, caplog,
+                                                                                             sender, scheme):
+    # httpx rejects the scheme while building the client, before it reads NO_PROXY, and its
+    # ``Unknown scheme for proxy URL`` error keeps the username (only the password is masked).
+    secret = f"{scheme}://qzxUser:qzxPass@127.0.0.1:1"
+    error, logs = _send_under(monkeypatch, caplog, sender, {"HTTPS_PROXY": secret, "HTTP_PROXY": secret,
+                                                            "NO_PROXY": _TARGET_HOSTS})
+    assert error
+    for text in (error, logs):
+        assert "qzx" not in text and "qzx" not in unquote(text), text[-2000:]
diff --git a/tests/gateway/test_sender_trust_env_error_text.py b/tests/gateway/test_sender_trust_env_error_text.py
new file mode 100644
index 00000000000..9442ca73c5b
--- /dev/null
+++ b/tests/gateway/test_sender_trust_env_error_text.py
@@ -0,0 +1,103 @@
+"""``gateway.trust_env: false`` builds aiohttp sessions that never read the proxy environment, so a
+LINE / Weixin send goes direct and its real API error (status, errcode) is kept even when an
+inherited ``HTTPS_PROXY`` holds a secret. With the default ``trust_env: true`` the same send goes
+through that proxy and only ``<ExceptionType> via <host:port>`` is shown.
+
+Each case drives the real standalone sender against a local aiohttp server.
+"""
+
+import asyncio
+import json
+from types import SimpleNamespace
+from urllib.parse import unquote
+
+import pytest
+
+web = pytest.importorskip("aiohttp.web")
+
+_SECRET = "http://bob:qzxqzxqzx@127.0.0.1:1"
+_LINE_BODY = '{"message":"Authentication failed due to invalid access token"}'
+_WEIXIN_BODY = json.dumps({"ret": -1, "errcode": 40013, "errmsg": "invalid appid"})
+
+
+async def _serve(status, body, send):
+    async def handler(request):
+        return web.Response(status=status, text=body, content_type="application/json")
+
+    app = web.Application()
+    app.router.add_route("*", "/{tail:.*}", handler)
+    runner = web.AppRunner(app)
+    await runner.setup()
+    site = web.TCPSite(runner, "127.0.0.1", 0)
+    await site.start()
+    port = site._server.sockets[0].getsockname()[1]
+    try:
+        return await asyncio.wait_for(send(f"http://127.0.0.1:{port}"), 60)
+    finally:
+        await runner.cleanup()
+
+
+def _line(monkeypatch):
+    from plugins.platforms.line import adapter as line
+
+    async def send(base):
+        monkeypatch.setattr(line, "LINE_PUSH_URL", f"{base}/v2/bot/message/push")
+        return await line._standalone_send(SimpleNamespace(extra={"channel_access_token": "tok"}), "U123", "hi")
+
+    return _serve(401, _LINE_BODY, send), "LINE push 401: " + _LINE_BODY
+
+
+def _weixin(monkeypatch):
+    from plugins.platforms.weixin import adapter as wx
+
+    if not wx.check_weixin_requirements():
+        pytest.skip("weixin needs aiohttp + cryptography")
+
+    async def send(base):
