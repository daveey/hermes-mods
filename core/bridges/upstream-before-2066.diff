+"""Who a Telegram group message is addressed to, kept out of the adapter facade.
+
+``exclusive_bot_mentions`` drops a group message addressed to another bot. Only a LEADING run of
+handles (``@BotA @BotB: do this``, ``/status@OtherBot``) addresses anyone: a foreign handle later
+in the text talks about that bot and must not silence this one (#136236). Our own handle anywhere
+still wins, unless the opening command explicitly targets another bot.
+
+``/cmd@ourbot args`` is how Telegram's group command menu sends a command; stripping our handle
+must keep the separator before the arguments (#56337), while prose cleanup stays as it was.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any, Callable, Iterator, Optional
+
+_SEPARATORS = " \t\n\r,:;"
+_RAW_LEADING_HANDLE_RE = re.compile(r"(?:/[A-Za-z0-9_]+)?@([A-Za-z0-9_]{2,31})\b")
+
+
+def _entity_type(entity: Any) -> str:
+    return str(getattr(entity, "type", "")).split(".")[-1].lower()
+
+
+def _utf16_to_str_offsets(text: str) -> list[int]:
+    """``offsets[utf16_index] -> str index``; a surrogate pair's low half maps to the pair itself."""
+    offsets: list[int] = []
+    for index, ch in enumerate(text):
+        offsets.append(index)
+        if ord(ch) > 0xFFFF:
+            offsets.append(index)
+    offsets.append(len(text))
+    return offsets
+
+
+def _entity_handle(etype: str, span: str) -> Optional[str]:
+    """``mention`` -> the handle; ``bot_command`` -> its ``@bot`` suffix (bare ``/cmd`` addresses no one)."""
+    span = span.strip()
+    if etype == "mention":
+        return span.lstrip("@").lower()
+    at = span.find("@")
+    return span[at + 1:].strip().lower() if at >= 0 else None
+
+
+def _leading_handles(text: str, entities: list) -> Iterator[str]:
+    """Handles at the head of one text/caption, separated by whitespace/``,;:``. With entities a handle
+    counts only where a ``mention``/``bot_command`` entity starts (UTF-16 offsets), so a handle in a
+    code span addresses no one; without entities ``@handle`` / ``/cmd@handle`` is read from the text."""
+    starts: dict[int, tuple[int, Optional[str]]] = {}
+    if entities:
+        offsets = _utf16_to_str_offsets(text)
+        for entity in entities:
+            etype = _entity_type(entity)
+            off, length = int(getattr(entity, "offset", -1)), int(getattr(entity, "length", 0))
+            if etype not in {"mention", "bot_command"} or off < 0 or length <= 0 or off + length >= len(offsets):
+                continue
+            start, end = offsets[off], offsets[off + length]
+            starts.setdefault(start, (end, _entity_handle(etype, text[start:end])))
+    pos = len(text) - len(text.lstrip())
+    while pos < len(text):
+        if entities:
+            if pos not in starts:
+                return
+            pos, handle = starts[pos]
+        else:
+            match = _RAW_LEADING_HANDLE_RE.match(text, pos)
+            if match is None:
+                return
+            pos, handle = match.end(), match.group(1).lower()
+        if handle is None:
+            return
+        yield handle
+        while pos < len(text) and text[pos] in _SEPARATORS:
+            pos += 1
+
+
+def leading_bot_handles(message: Any, is_bot_handle: Callable[[str], bool]) -> set[str]:
+    """Bot handles the head of the message text or caption is addressed to."""
+    found: set[str] = set()
+    for text, entities in ((getattr(message, "text", None) or "", getattr(message, "entities", None) or []),
+                           (getattr(message, "caption", None) or "", getattr(message, "caption_entities", None) or [])):
+        found.update(h for h in _leading_handles(text, entities) if is_bot_handle(h))
+    return found
+
+
+def _command_after_address(text: str, bot_username: str, *, has_entities: bool = False) -> Optional[re.Match[str]]:
+    return re.match(rf"(?i)\s*(?:@{re.escape(bot_username)}\b[,:-]*\s*)*"
+                    r"(/[A-Za-z0-9_-]++)(?:@([A-Za-z0-9_]{1,32}))?"
+                    + (r"(?![/\\])" if has_entities else r"(?=$|[\s,:;-])"), text)
+
+
+def foreign_command_target(message: Any, bot_username: str) -> Optional[str]:
+    """Only an opening command, optionally after our address, can override our later mention."""
+    for field in ("text", "caption"):
+        text = getattr(message, field, None) or ""
+        entities = getattr(message, "entities" if field == "text" else "caption_entities", None) or []
+        command = _command_after_address(text, bot_username, has_entities=bool(entities))
+        if not command or not command.group(2) or command.group(2).lower() == bot_username.lower():
+            continue
+        offset = len(text[:command.start(1)].encode("utf-16-le")) // 2
+        if not entities or any(_entity_type(e) == "bot_command" and e.offset == offset
+                               and (e.length == command.end() - command.start(1)
+                                    or command.group(1)[e.length:e.length + 1] == "-") for e in entities):
+            return command.group(2).lower()
+    return None
+
+
+def clean_bot_trigger_text(text: Optional[str], bot_username: str) -> Optional[str]:
+    """Drop our ``@handle`` from trigger text. A leading ``/cmd@ourbot`` keeps one space before its
+    arguments (``/reasoning@Bot medium`` -> ``/reasoning medium``), never gluing them to the command."""
+    if not text or not bot_username:
+        return text
+    handle = re.escape(bot_username)
+    command = _command_after_address(text, bot_username)
+    if command and (not command.group(2) or command.group(2).lower() == bot_username.lower()):
+        rest = text[command.end():]
+        if command.group(2):
+            rest = " " + re.sub(r"^[,:-]*\s*", "", rest)
+        rest = re.sub(rf"(?i)^(\s*)(?:@{handle}\b[,:-]*\s*)+", r"\1", rest)
+        rest = re.sub(rf"(?i)(?:@{handle}\b[,:-]*\s*+)+(?=$|[-–—]++\w)", "", rest)
+        return (command.group(1) + rest).strip()
+    # Preserve the legacy cleanup for paths and all other non-command text.
+    command = re.match(rf"(?i)\s*(/[A-Za-z0-9_]+)@{handle}\b[,:\-]*\s*", text)
+    if command:
+        rest = re.sub(rf"(?i)@{handle}\b[,:\-]*\s*", "", text[command.end():]).strip()
+        return f"{command.group(1)} {rest}" if rest else command.group(1)
+    cleaned = re.sub(rf"(?i)@{handle}\b[,:\-]*\s*", "", text).strip()
+    return cleaned or text
diff --git a/plugins/platforms/telegram/telegram_album.py b/plugins/platforms/telegram/telegram_album.py
new file mode 100644
index 00000000000..f457e0616b0
--- /dev/null
+++ b/plugins/platforms/telegram/telegram_album.py
@@ -0,0 +1,204 @@
+"""Telegram photo albums (``sendMediaGroup``, 10 per chunk) for the gateway adapter and the
+standalone sender.
+
+Telegram's own 5xx JSON answer (Bad Gateway) resends the SAME ``sendMediaGroup`` with the text
+lane's budget, never photo by photo. A chunk that may already be in the chat (a timeout, a 504, a
+reset after the write, an HTML 5xx page, or a 5xx JSON answer once that budget is spent:
+``telegram_send_errors``) is reported ambiguous and never resent. Any other failure (a Bot API
+refusal, a flood wait, a connect/pool failure whose request never left, a local error) falls back
+photo by photo. A stale forum topic ("thread not found") retries once without the topic.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import logging
+import os
+from typing import Any, Optional
+from urllib.parse import unquote
+
+from gateway.platforms.base import SendResult
+
+logger = logging.getLogger(__name__)
+
+ALBUM_LIMIT = 10  # Telegram's media-group cap
+
+
+def reply_lost(error: Exception) -> bool:
+    """True when the chunk may already be in the chat (``telegram_send_errors.may_have_delivered``:
+    a timeout, a 504, a reset after the write, a 5xx answer left after its same-request retries).
+    Only a refusal, a flood wait, a connect/pool failure (nothing left) or a local error falls back
+    photo by photo."""
+    from plugins.platforms.telegram.telegram_send_errors import may_have_delivered
+    return may_have_delivered(error)
+
+
+def _stale_topic(adapter: Any, error: Exception, metadata: Optional[dict]) -> bool:
+    """A forum topic Telegram no longer knows; Hermes DM-topic lanes keep their own anchor retry."""
+    return (adapter._is_bad_request_error(error) and adapter._is_thread_not_found_error(error)
+            and adapter._metadata_thread_id(metadata) is not None and not adapter._dm_topic_fallback(metadata))
+
+
+def _without_thread(metadata: Optional[dict]) -> dict:
+    return {k: v for k, v in (metadata or {}).items() if k not in ("thread_id", "message_thread_id")}
+
+
+def _local_path(url: str) -> Optional[str]:
+    return unquote(url[7:]) if url.startswith("file://") else None
+
+
+async def _send_one(adapter: Any, chat_id: str, url: str, alt: Optional[str], metadata: Optional[dict]) -> SendResult:
+    path = _local_path(url)
+    try:
+        if path is not None:
+            return await adapter.send_image_file(chat_id=chat_id, image_path=path, caption=alt or None, metadata=metadata)
+        return await adapter.send_image(chat_id=chat_id, image_url=url, caption=alt or None, metadata=metadata)
+    except Exception as exc:  # a per-photo failure is reported, never fatal to the batch
+        from plugins.platforms.telegram.adapter import _redact_telegram_error_text
+        logger.warning("[%s] Photo send failed: %s", adapter.name, _redact_telegram_error_text(exc), exc_info=True)
+        return SendResult(success=False, error=_redact_telegram_error_text(exc))
+
+
+async def _send_each(adapter: Any, chat_id: str, photos: list[tuple], metadata: Optional[dict], human_delay: float,
+                     failed: list) -> bool:
+    """One upload per photo (``send_image_file``'s photo -> document fallbacks); failures land in ``failed``."""
+    delivered = False
+    for photo_idx, (image_url, alt_text) in enumerate(photos):
+        if human_delay > 0 and photo_idx > 0:
+            await asyncio.sleep(human_delay)
+        result = await _send_one(adapter, chat_id, image_url, alt_text, metadata)
+        delivered = delivered or result.success
+        if not result.success:
+            failed.append((_local_path(image_url) or image_url, result.error or "send failed"))
+    return delivered
+
+
+def _open_chunk(adapter: Any, stack: contextlib.ExitStack, chunk: list[tuple], input_media: Any, failed: list):
+    """``(media, opened files, (url, alt) sent)`` for one album chunk; unreadable files land in ``failed``."""
+    from plugins.platforms.telegram.adapter import _redact_telegram_error_text as redact
+    media: list[Any] = []
+    opened: list[Any] = []
+    sent: list[tuple] = []
+    for image_url, alt_text in chunk:
+        source: Any = image_url
+        if (local_path := _local_path(image_url)) is not None:
+            if not os.path.exists(local_path):
+                logger.warning("[%s] Skipping missing image in media group: %s", adapter.name, local_path)
+                failed.append((local_path, "file not found"))
+                continue
+            # Pre-compress large rasters so the upload stays under media_write_timeout.
+            if compressed := adapter._compress_image_to_jpeg(local_path):
+                stack.callback(lambda p=compressed: os.path.exists(p) and os.remove(p))
+                local_path = compressed
+            try:
+                source = stack.enter_context(open(local_path, "rb"))  # streamed to the upload
+            except OSError as exc:
+                failed.append((_local_path(image_url), redact(exc)))
+                continue
+            opened.append(source)
+        media.append(input_media(media=source, caption=adapter._caption_1024(alt_text)))
+        sent.append((image_url, alt_text))
+    return media, opened, sent
+
+
+async def _send_chunk(adapter: Any, chat_id: str, media: list, opened: list, metadata: Optional[dict]) -> Optional[dict]:
+    """``sendMediaGroup``, the same request again on Telegram's 5xx JSON answer (the text lane's
+    budget), plus one retry without a stale forum topic. Returns the metadata the rest of the batch
+    should use; raises the send's error."""
+    from plugins.platforms.telegram import telegram_send_errors as kinds
+    from plugins.platforms.telegram.adapter import _redact_telegram_error_text as redact
+
+    def reset() -> None:
+        for fh in opened:
+            with contextlib.suppress(Exception):
+                fh.seek(0)
+
+    async def send(meta: Optional[dict]) -> None:
+        _, kwargs = adapter._media_send_kwargs(chat_id, None, meta)
+        for attempt in range(kinds.SAME_REQUEST_ATTEMPTS):
+            try:
+                await adapter._send_with_dm_topic_reply_anchor_retry(
+                    adapter._bot.send_media_group, {**kwargs, "media": media}, meta, "media group", reset_media=reset)
+                return
+            except Exception as err:
+                if (kinds.send_error_kind(err) != kinds.SERVER_ERROR
+                        or attempt >= kinds.SAME_REQUEST_ATTEMPTS - 1):
+                    raise
+                delay = kinds.same_request_backoff(attempt)
+                logger.warning("[%s] Telegram 5xx on media group (attempt %d/%d), resending it in %.1fs: %s",
+                               adapter.name, attempt + 1, kinds.SAME_REQUEST_ATTEMPTS, delay, redact(err))
+                await asyncio.sleep(delay)
+                reset()
+
+    try:
+        await send(metadata)
+        return metadata
+    except Exception as err:
+        if not _stale_topic(adapter, err, metadata):
+            raise
+    stale = adapter._metadata_thread_id(metadata)
+    logger.warning("[%s] Thread %s not found for media group, retrying without message_thread_id", adapter.name, stale)
+    adapter._prune_stale_dm_topic_binding(chat_id, stale, metadata=metadata)
+    metadata = _without_thread(metadata)
+    reset()
+    await send(metadata)
+    return metadata
+
+
+async def send_photo_album(
+    adapter: Any, chat_id: str, photos: list[tuple], metadata: Optional[dict] = None, human_delay: float = 0.0,
+    *, delivered: bool = False, per_photo_fallback: bool = True,
+) -> SendResult:
+    """Send ``(url, alt)`` photos as albums. ``success`` = at least one photo delivered or possibly
+    delivered; ``raw_response`` carries ``failed`` (``[(photo, error)]``), ``refused`` (when
+    ``per_photo_fallback`` is off: the first refused chunk's photos and every later one, in order,
+    for the caller to send its own way) and
+    ``ambiguous`` (a chunk was sent but never confirmed) whenever any applies."""
+    from plugins.platforms.telegram.adapter import _redact_telegram_error_text as redact
+    failed: list[tuple[str, str]] = []
+    refused: list[tuple] = []
+    ambiguous = False
+    try:
+        from telegram import InputMediaPhoto
+    except ImportError:  # SDK without media groups: every photo goes on its own
+        logger.warning("[%s] InputMediaPhoto unavailable, sending photos one by one", adapter.name)
+        InputMediaPhoto = None
+    chunks = [photos[i:i + ALBUM_LIMIT] for i in range(0, len(photos), ALBUM_LIMIT)] if InputMediaPhoto else []
+    for chunk_idx, chunk in enumerate(chunks):
+        if human_delay > 0 and chunk_idx > 0:
+            await asyncio.sleep(human_delay)
+        with contextlib.ExitStack() as stack:
+            media, opened, sent = _open_chunk(adapter, stack, chunk, InputMediaPhoto, failed)
+            if not media:
+                continue
+            logger.info("[%s] Sending media group of %d photo(s) (chunk %d/%d)",
+                        adapter.name, len(media), chunk_idx + 1, len(chunks))
+            try:
+                metadata = await _send_chunk(adapter, chat_id, media, opened, metadata)
+                delivered = True
+                continue
+            except Exception as err:
+                if reply_lost(err):
+                    logger.warning(
+                        "[%s] send_media_group reply lost (chunk %d/%d); not resending, it may have been posted: %s",
+                        adapter.name, chunk_idx + 1, len(chunks), redact(err), exc_info=True)
+                    ambiguous = delivered = True
+                    continue
+                logger.warning("[%s] send_media_group refused (chunk %d/%d), falling back to per-image: %s",
+                               adapter.name, chunk_idx + 1, len(chunks), redact(err), exc_info=True)
+        if per_photo_fallback:
+            delivered = await _send_each(adapter, chat_id, sent, metadata, human_delay, failed) or delivered
+        else:
+            # The caller's per-file fallback runs after we return, so later albums would land
+            # ahead of this chunk: hand back the rest of the batch too and keep the user's order.
+            refused += sent + [photo for later in chunks[chunk_idx + 1:] for photo in later]
+            break
+    if not chunks:  # no media-group support
+        if per_photo_fallback:
+            delivered = await _send_each(adapter, chat_id, photos, metadata, human_delay, failed) or delivered
+        else:
+            refused = list(photos)
+    detail = {"failed": failed, "refused": refused, "ambiguous": ambiguous} if failed or refused or ambiguous else None
+    error = None if delivered or refused else "all images failed to send" + (f": {failed[0][1]}" if failed else "")
+    return SendResult(success=delivered, error=error, raw_response=detail)
diff --git a/plugins/platforms/telegram/telegram_audio_meta.py b/plugins/platforms/telegram/telegram_audio_meta.py
new file mode 100644
index 00000000000..883298edc2e
--- /dev/null
+++ b/plugins/platforms/telegram/telegram_audio_meta.py
@@ -0,0 +1,118 @@
+"""Audio facts the Telegram media sends carry: duration, and the music-player fields of ``sendAudio``."""
+
+import contextlib
+import json
+import logging
+import os
+import shutil
+import subprocess
+import tempfile
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+
+def _coerce_duration_seconds(value: Any) -> Optional[int]:
+    """Round a raw length to whole positive seconds, or None if unusable."""
+    try:
+        secs = round(float(value))
+    except (TypeError, ValueError):
+        return None
+    return secs if secs > 0 else None
+
+
+def _probe_voice_duration_seconds(path: str) -> Optional[int]:
+    """Best-effort whole-second audio length (wave → mutagen → ffprobe; None if unreadable).
+
+    Telegram renders long clips as 0:00 without an explicit duration. Blocking: use ``to_thread``."""
+    if os.path.splitext(path)[1].lower() == ".wav":
+        try:
+            import wave
+            with wave.open(path, "rb") as wf:
+                rate = wf.getframerate() or 0
+                secs = _coerce_duration_seconds(wf.getnframes() / float(rate)) if rate else None
+            if secs is not None:
+                return secs
+        except Exception:
+            pass
+    try:
+        import mutagen
+        secs = _coerce_duration_seconds(getattr(getattr(mutagen.File(path), "info", None), "length", None))
+        if secs is not None:
+            return secs
+    except Exception:
+        pass
+    try:
+        import shutil
+        import subprocess
+        if shutil.which("ffprobe"):
+            proc = subprocess.run(
+                ["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "default=noprint_wrappers=1:nokey=1", path],
+                stdin=subprocess.DEVNULL, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=5, check=False)
+            if proc.returncode == 0:
+                return _coerce_duration_seconds(proc.stdout.strip())
+    except Exception:
+        pass
+    return None
+
+def audio_player_fields(path: str) -> dict[str, str]:
+    """``{"performer", "title", "thumbnail_path"}`` read from ``path``'s own tags; missing keys are omitted.
+
+    ``thumbnail_path`` is a temporary 320px JPEG of the embedded cover art the caller must delete.
+    Best effort and blocking (ffprobe/ffmpeg): run it in ``asyncio.to_thread``."""
+    if not shutil.which("ffprobe"):
+        return {}
+    fields: dict[str, str] = {}
+    try:
+        proc = subprocess.run(
+            ["ffprobe", "-v", "error", "-show_entries", "format_tags=artist,title:stream=codec_type",
+             "-of", "json", path],
+            stdin=subprocess.DEVNULL, capture_output=True, text=True, encoding="utf-8", errors="replace",
+            timeout=10, check=False)
+        blob = json.loads(proc.stdout or "{}") if proc.returncode == 0 else {}
+    except (OSError, subprocess.SubprocessError, ValueError):
+        logger.debug("[Telegram] audio tag probe failed for %s", path, exc_info=True)
+        return {}
+    tags = {k.lower(): str(v).strip() for k, v in ((blob.get("format") or {}).get("tags") or {}).items()}
+    for tag, field in (("artist", "performer"), ("title", "title")):
+        if tags.get(tag):
+            fields[field] = tags[tag][:256]
+    has_cover = any(s.get("codec_type") == "video" for s in blob.get("streams") or [])
+    if has_cover:
+        cover = _extract_cover_jpeg(path)
+        if cover:
+            fields["thumbnail_path"] = cover
+    return fields
+
+
+def _extract_cover_jpeg(path: str) -> Optional[str]:
+    """A temporary JPEG of ``path``'s embedded cover art (see :func:`fit_thumbnail_jpeg`), or None."""
+    return fit_thumbnail_jpeg(path, prefix="hermes-tg-cover-")
+
+
+def fit_thumbnail_jpeg(path: str, *, seek: Optional[int] = None, prefix: str = "hermes-tg-thumb-",
+                       timeout: int = 20) -> Optional[str]:
+    """A temporary JPEG of one frame of ``path`` (at ``seek`` seconds) fitted inside 320x320, or None.
+
+    Telegram limits a ``thumbnail`` to 320px on BOTH sides, so ``scale=320:-2`` would send portrait
+    art 320 wide and thousands tall. Every file operation stays inside the best-effort boundary: a
+    full or unwritable temp dir costs the thumbnail, never the send. The caller deletes the file."""
+    if not shutil.which("ffmpeg"):
+        return None
+    out = None
+    try:
+        fd, out = tempfile.mkstemp(suffix=".jpg", prefix=prefix)
+        os.close(fd)
+        seek_args = ["-ss", str(seek)] if seek is not None else []
+        ok = subprocess.run(
+            ["ffmpeg", "-y", *seek_args, "-i", path, "-an", "-frames:v", "1",
+             "-vf", "scale=320:320:force_original_aspect_ratio=decrease", "-q:v", "6", out],
+            stdin=subprocess.DEVNULL, capture_output=True, timeout=timeout, check=False).returncode == 0
+        if ok and os.path.getsize(out):
+            return out
+    except (OSError, subprocess.SubprocessError):
+        logger.debug("[Telegram] thumbnail extraction failed for %s", path, exc_info=True)
+    if out:
+        with contextlib.suppress(OSError):
+            os.remove(out)
+    return None
diff --git a/plugins/platforms/telegram/telegram_batching.py b/plugins/platforms/telegram/telegram_batching.py
new file mode 100644
index 00000000000..e1ba2318477
--- /dev/null
+++ b/plugins/platforms/telegram/telegram_batching.py
@@ -0,0 +1,28 @@
+"""Telegram inbound album and photo-burst event merging."""
+
+from typing import Optional
+
+from gateway.platforms.event import MessageEvent
+
+
+def pad_inline_flags(event: MessageEvent) -> list[Optional[bool]]:
+    """Represent unspecified legacy flags as None before appending media.
+
+    Local twin of core's private ``gateway.platforms.base_media_flags`` helper: plugins may only
+    import the published plugin API.
+    """
+    flags = list(getattr(event, "media_text_inlined", []) or [])
+    return flags + [None] * (len(event.media_urls) - len(flags))
+
+
+def merge_batched_event(pending: dict, key: str, event: MessageEvent, *, merge_caption) -> None:
+    """Retain each attachment's inlining semantics when combining album items."""
+    existing = pending.get(key)
+    if existing is None:
+        pending[key] = event
+        return
+    existing.absorb_reply_expected(event)
+    existing.media_text_inlined = pad_inline_flags(existing) + pad_inline_flags(event)
+    existing.extend_media(event)
+    if event.text:
+        existing.text = merge_caption(existing.text, event.text)
diff --git a/plugins/platforms/telegram/telegram_clarify_binding.py b/plugins/platforms/telegram/telegram_clarify_binding.py
new file mode 100644
index 00000000000..560362da5c7
--- /dev/null
+++ b/plugins/platforms/telegram/telegram_clarify_binding.py
@@ -0,0 +1,68 @@
+"""Bind a Telegram clarify prompt to the message that carries its buttons.
+
+A ``cl:<id>:<idx>`` callback is accepted only from the exact ``(chat_id, message_id)`` the clarify was
+rendered on. Chat-level authorization proves the caller may answer *some* prompt in that chat; it
+cannot tell a deliberate tap on this prompt from a callback that arrived on another message (#102957).
+A mismatch leaves the entry pending so the real prompt stays answerable, and is logged with enough
+non-secret provenance (callback-query id, caller id, both message identities) to audit afterwards.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import dataclasses
+import logging
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+
+def _ident(value: Any) -> Optional[str]:
+    """Normalize a Telegram id (int on the wire, str in state) for comparison."""
+    return None if value is None else str(value)
+
+
+@dataclasses.dataclass(frozen=True)
+class ClarifyPrompt:
+    """A pending clarify's session key plus the identity of the message that rendered its buttons.
+    ``thread_id`` is for the audit line only: the message implies it, and Telegram omits it for a
+    forum's General topic, so gating on it would only add false rejects."""
+
+    session_key: str
+    chat_id: Optional[str] = None
+    message_id: Optional[str] = None
+    thread_id: Optional[str] = None
+
+    @classmethod
+    def from_sent(cls, session_key: str, msg: Any) -> ClarifyPrompt:
+        return cls(session_key, _ident(getattr(msg, "chat_id", None)), _ident(getattr(msg, "message_id", None)),
+                   _ident(getattr(msg, "message_thread_id", None)))
+
+
+async def tap_matches_prompt(query: Any, clarify_id: str, prompt: ClarifyPrompt, denial: str) -> bool:
+    """True when the tap came from the prompt's own message; otherwise answer ``denial`` and fail closed."""
+    if prompt.message_id is None:
+        # Only a Bot API send result can leave no message id (no caller input reaches this): resolve
+        # rather than strand the prompt.
+        logger.warning("Telegram clarify callback unverifiable: no prompt message bound (id=%s)", clarify_id)
+        return True
+    message = getattr(query, "message", None)
+    got_chat, got_msg = _ident(getattr(message, "chat_id", None)), _ident(getattr(message, "message_id", None))
+    if (got_chat, got_msg) == (prompt.chat_id, prompt.message_id):
+        return True
+    logger.warning(
+        "Telegram clarify callback rejected: prompt binding mismatch (id=%s, expected chat=%s message=%s thread=%s, "
+        "got chat=%s message=%s thread=%s, callback_query=%s, caller_id=%s)", clarify_id, prompt.chat_id,
+        prompt.message_id, prompt.thread_id, got_chat, got_msg, _ident(getattr(message, "message_thread_id", None)),
+        getattr(query, "id", None), _ident(getattr(getattr(query, "from_user", None), "id", None)))
+    with contextlib.suppress(Exception):
+        await query.answer(text=denial)
+    return False
+
+
+def log_resolved(query: Any, clarify_id: str, prompt: ClarifyPrompt, choice: str, user_display: str) -> None:
+    """Audit line for a resolved clarify: which caller, which callback query, which prompt message."""
+    logger.info(
+        "Telegram clarify button resolved (id=%s, choice=%r, user=%s, caller_id=%s, callback_query=%s, chat=%s, message=%s)",
+        clarify_id, choice, user_display, _ident(getattr(getattr(query, "from_user", None), "id", None)),
+        getattr(query, "id", None), prompt.chat_id, prompt.message_id)
