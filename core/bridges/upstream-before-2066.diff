+
+        block = SimpleNamespace(
+            type="resource_link", uri="x://y", name=TAGGED, mimeType=TAGGED)
+        out = _render_mcp_resource_block(block, "srv")
+        assert "resource link" in out
+        _assert_no_tags(out)
