diff --git a/gateway/relay/adapter_inbound_media.py b/gateway/relay/adapter_inbound_media.py
new file mode 100644
index 00000000000..bed4bb2f89b
--- /dev/null
+++ b/gateway/relay/adapter_inbound_media.py
@@ -0,0 +1,47 @@
+"""Localize Relay attachments while preserving their parallel metadata."""
+import logging
+from typing import Optional
+
+from gateway.platforms.base_media_flags import pad_inline_flags
+
+logger = logging.getLogger(__name__)
+
+
+async def localize_inbound_media(event, get_media_client) -> None:
+    """Download connector re-hosted attachments to local temp paths — every NATIVE
+    adapter presents inbound media as LOCAL FILE PATHS (vision/file tools consume
+    paths). Best-effort per entry: a failed download drops that entry, never the
+    message; with no client only re-host URLs are dropped (they'd 401 downstream)."""
+    try:
+        urls = list(getattr(event, "media_urls", None) or [])
+        if not urls:
+            return
+        # Filter all per-attachment fields together so survivors keep their own semantics.
+        types = list(getattr(event, "media_types", None) or []) + [""] * len(urls)
+        names = list(getattr(event, "media_filenames", None) or []) + [""] * len(urls)
+        flags = pad_inline_flags(event)
+        client = get_media_client()
+        localized: list[tuple[str, str, str, Optional[bool]]] = []
+        for url, mime, name, inlined in zip(urls, types, names, flags):
+            if not isinstance(url, str) or not url:
+                continue
+            if client is None:
+                if "/relay/media/" not in url:
+                    localized.append((url, mime, name, inlined))
+                continue
+            # The path is a random temp name; the original name rides beside it.
+            got = await client.download_with_name(url, suggested_name=name or None)
+            if got:
+                localized.append((got[0], mime, got[1], inlined))
+            elif "/relay/media/" not in url:
+                # A public URL still has value as a URL; a dead re-host does not.
+                localized.append((url, mime, name, inlined))
+        legacy_unflagged = not getattr(event, "media_text_inlined", None)
+        event.media_urls, event.media_types, event.media_filenames, event.media_text_inlined = (
+            [entry[i] for entry in localized] for i in range(4))
+        if legacy_unflagged:
+            # [] and [None, ...] mean the same, but the admission payload stores the list verbatim:
+            # keep [] so a retry of a delivery committed before per-file flags still matches.
+            event.media_text_inlined = []
+    except Exception:
+        logger.debug("relay inbound media localization failed", exc_info=True)
diff --git a/gateway/relay/prompt_resolvers.py b/gateway/relay/prompt_resolvers.py
new file mode 100644
index 00000000000..d6c2a7a4ddd
--- /dev/null
+++ b/gateway/relay/prompt_resolvers.py
@@ -0,0 +1,65 @@
+"""Relay prompt-response resolvers: one per prompt kind (exec approval, slash confirm, clarify).
+
+Each runs on the transport read loop with the adapter, the popped prompt state, the chosen option,
+the chat id and the ack metadata; acks go through ``adapter._send_lifecycle_ack`` (fire-and-forget).
+"""
+
+from __future__ import annotations
+
+
+async def resolve_exec_approval(adapter, state, option_id, chat_id, ack_meta) -> None:
+    from gateway.relay import adapter as _relay
+    from tools.approval import resolve_gateway_approval_card
+
+    choice = option_id if option_id in _relay._EXEC_APPROVAL_LABELS else "deny"
+    # The answerer's authority is rechecked against the entry this settles, in the same critical section.
+    count = resolve_gateway_approval_card(str(state.get("session_key") or ""), choice, state.get("request_id"),
+                                          **(state.get("actor") or {}))
+    label = _relay._EXEC_APPROVAL_LABELS[choice] if count else "⌛ Approval expired — no command was waiting."
+    # In-channel ack preserves the audit trail the native edit gives (the
+    # connector's prompt message can't be edited cross-platform yet).
+    adapter._send_lifecycle_ack(chat_id, label, ack_meta)
+    if count:
+        adapter.resume_typing_for_chat(chat_id)
+
+
+async def resolve_slash_confirm(adapter, state, option_id, chat_id, ack_meta) -> None:
+    from gateway.relay import adapter as _relay
+    from tools import slash_confirm as slash_confirm_mod
+
+    choice = option_id if option_id in _relay._SLASH_CONFIRM_LABELS else "cancel"
+    result_text = await slash_confirm_mod.resolve(
+        str(state.get("session_key") or ""), str(state.get("confirm_id") or ""), choice
+    )
+    adapter._send_lifecycle_ack(chat_id, _relay._SLASH_CONFIRM_LABELS[choice], ack_meta)
+    if result_text:
+        adapter._send_lifecycle_ack(chat_id, str(result_text), ack_meta)
+
+
+async def resolve_clarify(adapter, state, option_id, chat_id, ack_meta) -> None:
+    from tools.clarify_gateway import mark_awaiting_text, resolve_gateway_clarify
+
+    clarify_id = str(state.get("clarify_id") or "")
+    if option_id == "other":
+        mark_awaiting_text(clarify_id)
+        adapter._send_lifecycle_ack(chat_id, "✏️ Type your answer:", ack_meta)
+        return
+    choices = state.get("choices") or []
+    try:
+        idx = int(option_id[1:]) if option_id.startswith("c") else -1
+    except ValueError:
+        idx = -1
+    if 0 <= idx < len(choices):
+        resolve_gateway_clarify(clarify_id, str(choices[idx]))
+        adapter._send_lifecycle_ack(chat_id, f"✅ {choices[idx]}", ack_meta)
+    else:
+        # Unmappable option: flip to text capture (never dead-end a clarify).
+        mark_awaiting_text(clarify_id)
+
+
+# prompt kind -> resolver (order-independent: kinds are distinct keys).
+PROMPT_RESOLVERS = {
+    "exec_approval": resolve_exec_approval,
+    "slash_confirm": resolve_slash_confirm,
+    "clarify": resolve_clarify,
+}
diff --git a/gateway/restart_ack.py b/gateway/restart_ack.py
new file mode 100644
index 00000000000..1b3db17fa42
--- /dev/null
+++ b/gateway/restart_ack.py
@@ -0,0 +1,32 @@
+"""Deliver the /restart acknowledgement before the gateway starts stopping (#65057)."""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+
+from gateway.config import Platform
+from gateway.platforms.base import BasePlatformAdapter, _mark_notify_metadata
+
+logger = logging.getLogger(__name__)
+
+
+async def send_restart_ack(runner, adapter, event, ack: str) -> bool:
+    """Send ``ack`` to the requester now and wait for the platform's answer; False = not delivered
+    (the caller then returns it through the ordinary reply path). Uses the ordinary command reply's
+    anchor and routing metadata (Slack workspace, Telegram topic lane, notify)."""
+    if adapter is None or adapter.platform is Platform.LOCAL:
+        return False  # a LOCAL send is a no-op: the viewer reads the RETURNED reply (final_response)
+    metadata = _mark_notify_metadata(runner._reply_metadata(event))
+    try:
+        result = await asyncio.wait_for(adapter.send(
+            event.source.chat_id, ack, reply_to=runner._reply_anchor_for_event(event), metadata=metadata), timeout=10)
+    except Exception:  # any adapter failure: the reply path is the fallback, never a lost /restart
+        logger.warning("Could not send the /restart acknowledgement before shutdown", exc_info=True)
+        return False
+    # A read/write timeout may already have landed (``_send_with_retry`` does not resend it either):
+    # count it as delivered so the reply path does not post a second copy. A timeout the adapter marks
+    # as never sent (``retryable``, a connect timeout) still falls back, as ``_send_with_retry`` retries it.
+    error = getattr(result, "error", None)
+    never_sent = getattr(result, "retryable", False) or BasePlatformAdapter._is_retryable_error(error)
+    return bool(getattr(result, "success", False)) or (not never_sent and BasePlatformAdapter._is_timeout_error(error))
