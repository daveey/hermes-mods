+        result = SimpleNamespace(messages=[msg], description=TAGGED)
+        out = _render_get_prompt(result, "srv")
+        _assert_no_tags(out)
+        assert out["description"] == "evil"
+        assert out["messages"][0]["role"] == "evil"
+        assert out["messages"][0]["content"] == "clean"
+
