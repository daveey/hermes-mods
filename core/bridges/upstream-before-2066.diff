--- /dev/null
+++ b/tests/agent/test_redact_cookies.py
@@ -0,0 +1,72 @@
+"""Cookie / Set-Cookie credential masking (#80936)."""
+
+import pytest
+
+from agent.redact import redact_sensitive_text, redact_terminal_output
+
+
+@pytest.fixture(autouse=True)
+def _ensure_redaction_enabled(monkeypatch):
+    """Ensure HERMES_REDACT_SECRETS is not disabled by prior test imports."""
+    monkeypatch.delenv("HERMES_REDACT_SECRETS", raising=False)
+    # Also patch the module-level snapshot so it reflects the cleared env var
+    monkeypatch.setattr("agent.redact._REDACT_ENABLED", True)
+
+
+class TestCookieCredentials:
+    def test_cookie_values_masked_in_assignment_and_inline_header_forms(self):
+        for text, secret in (
+            ("cookie=opaque-session-value-1234567890; Path=/", "opaque-session-value"),
+            ("export SESSION_COOKIE=opaqueSessionValue1234567890", "opaqueSessionValue"),
+            ("INFO upstream Cookie: a=1; sid=opaqueSessionValue1234567890; theme=dark user=bob",
+             "opaqueSessionValue"),
+            ("Set-Cookie: opaqueSessionValue1234567890", "opaqueSessionValue"),
+            ('export SESSION_COOKIE="a=1; sid=opaqueSessionValue1234567890"', "opaqueSessionValue"),
+            ('INFO upstream Cookie: sid="opaqueSessionValue1234567890"', "opaqueSessionValue"),
+            ("INFO upstream x-api-key: $opaqueSessionValue1234567890", "opaqueSessionValue"),
+            ("INFO upstream x-api-key: &opaqueSessionValue1234567890", "opaqueSessionValue"),
+            ("INFO upstream x-api-key: prefix|opaqueSessionValue1234567890", "opaqueSessionValue"),
+            ("INFO upstream x-api-key : opaqueSessionValue1234567890", "opaqueSessionValue"),
+            ("INFO upstream Cookie: sid=pre'opaqueSessionValue1234567890", "opaqueSessionValue"),
+            ("export SESSION_COOKIE='sid='\"opaqueSessionValue1234567890\"", "opaqueSessionValue"),
+        ):
+            assert secret not in redact_sensitive_text(text), text
+        # Terminal output scrubs with code_file=True (``curl -i``); the header is still a credential.
+        rc_line = "export SESSION_COOKIE='sid='\\''opaqueSessionValue1234567890'"
+        assert "opaqueSessionValue" not in redact_sensitive_text(rc_line, file_read=True, secret_file=True)
+        dump = "HTTP/2 200\nset-cookie: sid=opaqueSessionValue1234567890; Path=/\ncontent-type: text/html"
+        assert "opaqueSessionValue" not in redact_terminal_output(dump, "curl -i https://example.com")
+
+    def test_cookie_prose_unchanged(self):
+        # #80936 false positives: prose, cookie-ish identifiers and URL params are not credentials.
+        for text in (
+            "cookies enabled now",
+            "cookie_policy: strict",
+            "mycookiejar=1",
+            'Cookie.set("name", value)',
+            "The cookie: it was delicious",
+            "the Set-Cookie: header sets state",
+            "if cookie == expected:",
+            "GET https://example.com/cb?cookie=abc123&x=1",
+            # Code and placeholders, the same shapes main leaves alone for ``token``.
+            "cookie = getCookie()",
+            "self.cookie = cookie",
+            "cookie=None",
+            "cookie=$(cat jar)",
+            '{"cookie": "chocolate"}',
+            '{"apikey": "${API_KEY}"}',
+            '{"x-api-key": "${API_KEY}"}',
+        ):
+            assert redact_sensitive_text(text) == text, text
+            assert redact_sensitive_text(text, force=True) == text, text
+        # A masked value never swallows the text around it (JSON neighbours, shell separators).
+        out = redact_sensitive_text('{"output": "cookie=\'opaqueSessionValue1234567890\'", "model": "m"}')
+        assert out.endswith('\'", "model": "m"}') and "opaqueSessionValue" not in out
+        for text, tail in (
+            ("SESSION_COOKIE='opaqueSessionValue1234567890';echo done", "';echo done"),
+            ('{"output":"cookie=opaqueSessionValue1234567890","model":"m"}', '","model":"m"}'),
+            ("SESSION_COOKIE=opaqueSessionValue1234567890;echo done", "7890;echo done"),
+            ("INFO x-api-key: opaqueSessionValue1234567890&& echo ok", "***&& echo ok"),
+        ):
+            out = redact_sensitive_text(text)
+            assert out.endswith(tail) and "opaqueSessionValue" not in out, out
diff --git a/tests/agent/test_redact_headers.py b/tests/agent/test_redact_headers.py
new file mode 100644
index 00000000000..63d77d60be4
--- /dev/null
+++ b/tests/agent/test_redact_headers.py
@@ -0,0 +1,42 @@
+"""Header redaction must preserve the syntax consumed by diagnostic tools."""
+
+import json
+import shlex
+
+from agent.redact import redact_sensitive_text
+
+
+def test_json_headers_remain_parseable_without_exposing_credentials():
+    for name in ("x-api-key", "X-Goog-Api-Key", "apikey", "Cookie", "Set-Cookie"):
+        for value in ('abcd="opaque-session-secret-1234567890"; Path=/',
+                      's=short"value', "opaque\\session\\credential1234567890"):
+            payload = {"headers": {name: value}, "model": "example", "messages": []}
+            serialized = json.dumps(payload)
+            redacted = redact_sensitive_text(serialized, force=True)
+            restored = json.loads(redacted)
+            assert restored["headers"][name] != value
+            assert "opaque-session-secret" not in restored["headers"][name]
+            assert restored["model"] == payload["model"]
+            assert restored["messages"] == payload["messages"]
+            file_redacted = json.loads(redact_sensitive_text(serialized, force=True, file_read=True, secret_file=True))
+            assert file_redacted["headers"][name].startswith("«redacted")
+            assert redact_sensitive_text(serialized, force=True, code_file=True) == serialized
+        if "cookie" not in name.lower():  # a slash-led opaque key is a credential, not a path
+            slash_key = json.dumps({name: "/abcdef0123456789abcdef0123456789"})
+            assert "0123456789abcdef0123" not in redact_sensitive_text(slash_key, force=True)
+        vendor_key = json.dumps({name: "ghp_" + "A1b2C3d4" * 5})
+        assert "«redacted:ghp_" in redact_sensitive_text(vendor_key, force=True, file_read=True, secret_file=True)
+
+
+def test_raw_headers_mask_all_values_without_consuming_shell_or_next_line():
+    value = "sid=opaque-session-secret-1234567890; second=another-credential"
+    for name in ("Cookie", "sEt-CoOkIe", "x-api-key"):
+        raw = f"{name}: {value}\nX-Trace: unchanged"
+        assert redact_sensitive_text(raw, force=True) == f"{name}: ***\nX-Trace: unchanged"
+        for flag in ("-H", "--header"):
+            for quote in ("'", '"'):
+                command = f"curl {flag} {quote}{name}: {value}{quote} https://example.com/path"
+                output = redact_sensitive_text(command, force=True)
+                assert shlex.split(output) == ["curl", flag, f"{name}: ***", "https://example.com/path"]
+    for benign in ("the cookie: is a browser feature", 'Cookie.set("name", value)'):
+        assert redact_sensitive_text(benign, force=True) == benign
diff --git a/tests/ci/test_e2e_upgrade_start_version.py b/tests/ci/test_e2e_upgrade_start_version.py
new file mode 100644
index 00000000000..0a6ea27df7f
--- /dev/null
+++ b/tests/ci/test_e2e_upgrade_start_version.py
@@ -0,0 +1,100 @@
+"""The e2e-upgrade suites start from the release before HEAD, on every release shape (#150040).
+
+``tests/e2e/core/upgrade/_install_helpers.upgrade_base`` picks the release every upgrade leg starts
+from. It runs here against a small temp history rather than this checkout's own tags, so PR CI
+covers it: the e2e-upgrade lane runs only on release and dispatch runs.
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+from collections.abc import Iterator
+from pathlib import Path
+
+import pytest
+
+from tests.e2e.core.upgrade import _helpers as H
+from tests.e2e.core.upgrade import _install_helpers as I
+
+_ENV = {
+    "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
+    "GIT_CONFIG_NOSYSTEM": "1",
+    "GIT_CONFIG_GLOBAL": os.devnull,
+    "GIT_AUTHOR_NAME": "e2e", "GIT_AUTHOR_EMAIL": "e2e@example.invalid",
+    "GIT_COMMITTER_NAME": "e2e", "GIT_COMMITTER_EMAIL": "e2e@example.invalid",
+}
+
+
+class _Repo:
+    """A git history whose commits and tags carry increasing dates (``--sort=creatordate`` is real)."""
+
+    def __init__(self, path: Path) -> None:
+        self.path, self.clock = path, 1_790_000_000
+        path.mkdir()
+        self.git("init", "-q", "-b", "main")
+
+    def git(self, *args: str) -> str:
+        self.clock += 60
+        stamp = f"@{self.clock} +0000"
+        env = {**_ENV, "GIT_AUTHOR_DATE": stamp, "GIT_COMMITTER_DATE": stamp}
+        return subprocess.run(["git", *args], cwd=self.path, env=env, capture_output=True, text=True,
+                              check=True).stdout.strip()
+
+    def commit(self, message: str, *tags: str) -> None:
+        self.git("commit", "-q", "--allow-empty", "-m", message)
+        for tag in tags:
+            self.git("tag", "-a", "-m", tag, tag)
+
+
+@pytest.fixture
+def repo(tmp_path: Path, monkeypatch) -> Iterator[_Repo]:
+    """main: a CalVer release, v0.9.0, v0.10.0 with its candidate, a canary. ``release/0.10`` forks
+    at v0.10.0; v0.10.1 is published from a side branch, and v0.10.2 is cut as a merge whose first
+    parent is the release branch tip and whose second parent is v0.10.1 (v0.22.2's shape)."""
+    for name in ("HERMES_E2E_UPGRADE_BASE", "HERMES_E2E_N1_REF", "CI", "GITHUB_ACTIONS"):
+        monkeypatch.delenv(name, raising=False)
+    r = _Repo(tmp_path / "repo")
+    monkeypatch.setattr(H, "WORKTREE", r.path)
+    I.upgrade_base.cache_clear()
+    r.commit("calver era", "v2026.9.24")
+    r.commit("0.9", "v0.9.0")
+    r.commit("0.10", "rc.1-v0.10.0", "v0.10.0")
+    r.git("branch", "release/0.10")
+    r.commit("canary", "v0.10.0+canary.20261106T064428Z")
+    r.git("checkout", "-q", "-b", "publish-0.10.1", "release/0.10")
+    r.commit("hotfix published from a side branch", "v0.10.1")
+    r.git("checkout", "-q", "release/0.10")
+    r.commit("release branch moves on")
+    r.git("merge", "-q", "--no-ff", "-m", "release v0.10.2", "v0.10.1")
+    r.git("tag", "-a", "-m", "v0.10.2", "v0.10.2")
+    r.git("checkout", "-q", "main")
+    yield r
+    I.upgrade_base.cache_clear()
+
+
+def test_a_release_cut_as_a_merge_starts_from_the_release_on_its_second_parent(repo):
+    repo.git("checkout", "-q", "--detach", "v0.10.2")
+    assert repo.git("rev-parse", "HEAD^2") == repo.git("rev-parse", "v0.10.1^{commit}")
+    assert I.upgrade_base().ref == "v0.10.1"
+
+
+def test_a_tagged_head_starts_from_the_release_before_it(repo):
+    repo.commit("head", "v0.11.0")
+    assert I.upgrade_base().ref == "v0.10.0"
+
+
+def test_no_release_before_head_fails_on_ci_and_skips_locally(tmp_path, monkeypatch):
+    for name in ("HERMES_E2E_UPGRADE_BASE", "HERMES_E2E_N1_REF", "CI", "GITHUB_ACTIONS"):
+        monkeypatch.delenv(name, raising=False)
+    r = _Repo(tmp_path / "tagless")
+    r.commit("only commit", "rc.1-v0.1.0")
+    r.commit("head")
+    monkeypatch.setattr(H, "WORKTREE", r.path)
+    I.upgrade_base.cache_clear()
+    assert I.upgrade_base() is None
+    I.upgrade_base.cache_clear()
+    monkeypatch.setenv("CI", "true")
+    with pytest.raises(AssertionError, match="no release tag reachable before HEAD"):
+        I.upgrade_base()
+    I.upgrade_base.cache_clear()
