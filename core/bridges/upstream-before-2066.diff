index 8a21799fbd0..2450a498a4c 100644
--- a/plugins/platforms/telegram/telegram_network.py
+++ b/plugins/platforms/telegram/telegram_network.py
@@ -6,6 +6,7 @@ from __future__ import annotations
 import asyncio
 import ipaddress
 import logging
+import os
 import socket
 from typing import Iterable, Optional
 
@@ -62,6 +63,83 @@ SEED_FALLBACK_IPS: list[str] = ["149.154.166.110", "149.154.167.220"]
 _UNSET = object()
 
 
+def _env_number(key: str, default, cast):
+    raw = os.getenv(key, "").strip()
+    try:
+        return cast(raw) if raw else default
+    except (TypeError, ValueError):
+        return default
+
+
+def ptb_request_kwargs() -> dict:
+    """PTB ``HTTPXRequest`` sizing and timeouts (``HERMES_TELEGRAM_HTTP_*`` overrides): PTB's 1s pool
+    timeout trips "Pool timeout" on flaky networks. ``media_write_timeout`` is httpx's per-write
+    stall budget, so 60s rides out congested-link buffer stalls."""
+    return {
+        "connection_pool_size": _env_number("HERMES_TELEGRAM_HTTP_POOL_SIZE", 512, int),
+        "pool_timeout": _env_number("HERMES_TELEGRAM_HTTP_POOL_TIMEOUT", 8.0, float),
+        "connect_timeout": _env_number("HERMES_TELEGRAM_HTTP_CONNECT_TIMEOUT", 10.0, float),
+        "read_timeout": _env_number("HERMES_TELEGRAM_HTTP_READ_TIMEOUT", 20.0, float),
+        "write_timeout": _env_number("HERMES_TELEGRAM_HTTP_WRITE_TIMEOUT", 20.0, float),
+        "media_write_timeout": 60.0,
+    }
+
+
+def build_ptb_requests(request_cls, *, fallback_ips: list[str], proxy_url: Optional[str], verify=None) -> tuple:
+    """The (general, getUpdates) ``request_cls`` (PTB ``HTTPXRequest``) pair the gateway adapter and
+    the standalone sender both use: the fallback-IP transport when ``fallback_ips`` and no proxy,
+    else the explicit proxy, else direct DNS; every client verifies with ``verify`` (default: the
+    cached ``platform_ssl_context()``).
+
+    CLOSE_WAIT fd leak (#31599, #18451): PTB builds its httpx client with only
+    ``max_connections`` and httpx's default 5s keepalive, so behind an HTTP proxy a peer FIN can
+    sit in CLOSE_WAIT and leak fds; ``platform_httpx_limits()`` keepalive tuning is injected while
+    keeping PTB's pool size. A long-poll is always active, so getUpdates never reuses a pooled
+    socket (``max_keepalive_connections=0``). httpx ignores client ``limits`` when a custom
+    ``transport`` is supplied (#58790), so the fallback branch hands them to the transport."""
+    from gateway.platforms._http_client_limits import platform_httpx_limits
+    verify = platform_ssl_context() if verify is None else verify
+    kwargs = ptb_request_kwargs()
+    base = platform_httpx_limits()
+    pool = updates = None
+    if base is not None:
+        pool = httpx.Limits(max_connections=kwargs["connection_pool_size"],
+                            max_keepalive_connections=base.max_keepalive_connections, keepalive_expiry=base.keepalive_expiry)
+        updates = httpx.Limits(max_connections=kwargs["connection_pool_size"], max_keepalive_connections=0,
+                               keepalive_expiry=base.keepalive_expiry)
+
+    def pair(general_httpx: dict, updates_httpx: dict, **extra) -> tuple:
+        return (request_cls(**kwargs, **extra, httpx_kwargs={"verify": verify, **general_httpx}),
+                request_cls(**kwargs, **extra, httpx_kwargs={"verify": verify, **updates_httpx}))
+
+    def limited(limits) -> dict:
+        return {"limits": limits} if limits is not None else {}
+
+    if fallback_ips and not proxy_url:
+        transport_kwargs = {"socket_options": tcp_keepalive_socket_options(), "verify": verify}
+        return pair({"transport": TelegramFallbackTransport(fallback_ips, **transport_kwargs, **limited(pool))},
+                    {"transport": TelegramFallbackTransport(fallback_ips, **transport_kwargs, **limited(updates))})
+    return pair(limited(pool), limited(updates), **({"proxy": proxy_url} if proxy_url else {}))
+
+
+def proxy_target_hosts(base_url: Optional[str], fallback_ips: Iterable[str] = ()) -> list[str]:
+    """The hosts a Bot API request actually reaches, for the NO_PROXY check: a configured
+    ``base_url`` server's ``host:port`` (a local ``telegram-bot-api`` on 127.0.0.1:8081 must
+    match ``NO_PROXY=127.0.0.1``), else api.telegram.org and its fallback IPs."""
+    if base_url:
+        from urllib.parse import urlsplit
+        parts = urlsplit(base_url if "//" in base_url else f"//{base_url}")
+        try:
+            port = parts.port or (80 if parts.scheme == "http" else 443)
+        except ValueError:
+            port = None
+        host = parts.hostname or ""
+        if host:
+            host = f"[{host}]" if ":" in host else host
+            return [f"{host}:{port}" if port else host]
+    return [_TELEGRAM_API_HOST, *fallback_ips]
+
+
 def _resolve_proxy_url(target_hosts=None) -> str | None:
     from gateway.platforms.base import resolve_proxy_url  # env vars + macOS system proxy
     return resolve_proxy_url("TELEGRAM_PROXY", target_hosts=target_hosts)
diff --git a/plugins/platforms/telegram/telegram_outbound.py b/plugins/platforms/telegram/telegram_outbound.py
new file mode 100644
index 00000000000..40a03325123
--- /dev/null
+++ b/plugins/platforms/telegram/telegram_outbound.py
@@ -0,0 +1,88 @@
+"""Telegram outbound send policy shared by the gateway adapter and the standalone sender
+(``hermes send``, the ``send_message`` tool, standalone cron delivery): the push-notification
+mode and the visually-empty guard, so both lanes make the same decision for the same text."""
+
+from __future__ import annotations
+
+import logging
+import os
+
+logger = logging.getLogger(__name__)
+
+_NOTIFICATION_MODES = ("all", "important")
+
+# Code points that render as nothing: zero-width space/non-joiner/joiner, word joiner, invisible
+# operators, BOM, soft hyphen, Mongolian vowel separator, and the bidi marks/embeddings/isolates.
+# A message made only of these (plus whitespace) passes ``str.strip()`` and lands as an empty bubble.
+_INVISIBLE = str.maketrans("", "", (
+    "\u200b\u200c\u200d\u2060\u2061\u2062\u2063\u2064\ufeff\u00ad\u180e"
+    "\u200e\u200f\u202a\u202b\u202c\u202d\u202e\u2066\u2067\u2068\u2069"))
+
+
+def is_visually_empty(text: str | None) -> bool:
+    """True when ``text`` has no visible glyph (empty, whitespace, or invisible code points only)."""
+    return not text or not text.translate(_INVISIBLE).strip()
+
+
+def resolve_notifications_mode() -> str:
+    """``all`` or ``important``: ``HERMES_TELEGRAM_NOTIFICATIONS``, else the active profile's
+    ``display.platforms.telegram.notifications``; unknown values warn and use ``important``."""
+    mode = os.getenv("HERMES_TELEGRAM_NOTIFICATIONS", "").strip().lower()
+    if not mode:
+        from hermes_cli.config import cfg_get, load_config_readonly
+        raw = cfg_get(load_config_readonly(), "display", "platforms", "telegram", "notifications")
+        mode = "" if raw is None else str(raw).strip().lower()
+    if not mode:
+        return "important"
+    if mode not in _NOTIFICATION_MODES:
+        logger.warning("Unknown telegram notifications mode '%s', defaulting to 'important' (valid: %s)",
+                       mode, ", ".join(_NOTIFICATION_MODES))
+        return "important"
+    return mode
+
+
+def notification_kwargs(mode: str, notify: bool | None) -> dict:
+    """Bot API kwargs for one send: silent under ``important`` unless the caller asks to ``notify``."""
+    return {} if mode != "important" or notify else {"disable_notification": True}
+
+
+def _standalone_adapter(bot, extra: dict):
+    """An unconnected ``TelegramAdapter`` over the standalone ``bot`` (no polling, no lock), so an
+    out-of-process send reuses the gateway's gates, routing and fallbacks verbatim."""
+    from gateway.config import PlatformConfig
+    from plugins.platforms.telegram.adapter import TelegramAdapter
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, extra=dict(extra or {})))
+    adapter._bot = bot
+    adapter._notifications_mode = resolve_notifications_mode()
+    return adapter
+
+
+def _metadata(thread_id, notify) -> dict:
+    return {**({"thread_id": str(thread_id)} if thread_id is not None else {}), **({"notify": True} if notify else {})}
+
+
+async def send_rich_standalone(bot, extra: dict, chat_id, content: str, *, thread_id=None, notify=None):
+    """The gateway's ``sendRichMessage`` fast-path for an out-of-process send: the same gates
+    (``rich_messages`` opt-in, constructs MarkdownV2 degrades, Desktop crash/garble shapes, size cap,
+    capability latch) and routing. ``None`` = not eligible or permanently rejected, so the caller
+    sends legacy MarkdownV2; otherwise the adapter's ``SendResult``. A transient failure is returned,
+    not resent as legacy, because the rich request may have landed."""
+    adapter = _standalone_adapter(bot, extra)
+    if not adapter._should_attempt_rich(content):
+        return None
+    return await adapter._try_send_rich(str(chat_id), content, None, _metadata(thread_id, notify))
+
+
+async def send_album_standalone(bot, extra: dict, chat_id, paths: list[str], *, thread_id=None, notify=None):
+    """Photos as native albums (``sendMediaGroup``, 10 per chunk) through the adapter's album sender.
+    A refused chunk and every photo after it are handed back in order in ``raw_response["refused"]``
+    (local paths) for the caller's own per-file upload, which reports each failure; a lost reply is ``ambiguous`` and never resent."""
+    from urllib.parse import quote, unquote
+    from plugins.platforms.telegram.telegram_album import send_photo_album
+    adapter = _standalone_adapter(bot, extra)
+    # The caller hands absolute, existence-checked paths; quote() matches the album sender's unquote().
+    images = [("file://" + quote(p), None) for p in paths]
+    result = await send_photo_album(adapter, str(chat_id), images, _metadata(thread_id, notify), per_photo_fallback=False)
+    if result.raw_response:
+        result.raw_response["refused"] = [unquote(url[7:]) for url, _ in result.raw_response["refused"]]
+    return result
diff --git a/plugins/platforms/telegram/telegram_picker_labels.py b/plugins/platforms/telegram/telegram_picker_labels.py
new file mode 100644
index 00000000000..543da145ded
--- /dev/null
+++ b/plugins/platforms/telegram/telegram_picker_labels.py
@@ -0,0 +1,98 @@
+"""Readable, distinguishable button labels for the Telegram /model picker.
+
+Display-only: callback data still carries the catalog index, so the full model id is what gets
+selected. Bot API button text has no tight length cap; the budget below is what a phone shows
+on a full-width button before the client ellipsizes it.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+from collections import defaultdict
+from typing import Callable
+
+MODEL_LABEL_BUDGET = 44
+_NAMESPACE_DOT = re.compile(r"\.")
+
+
+def shared_label_prefix(model_ids: list[str]) -> str:
+    """The namespace every id shares (``global.anthropic.`` / ``ri.language-model-service..``), cut
+    after a dot so no label starts mid-word. Only when some id is over budget (short catalogs such as
+    ``gpt-5.1`` / ``gpt-5.2`` keep their names) and computed over the WHOLE list so labels stay stable
+    across pages; a single id keeps its full name."""
+    if len(model_ids) < 2 or max(len(m) for m in model_ids) <= MODEL_LABEL_BUDGET:
+        return ""
+    common = os.path.commonprefix(model_ids)
+    cut = max((m.end() for m in _NAMESPACE_DOT.finditer(common)), default=0)
+    # Never strip an id down to nothing (one id may BE the shared prefix plus a separator).
+    return common[:cut] if all(len(m) > cut for m in model_ids) else ""
+
+
+def _strip(model_id: str, prefix: str) -> str:
+    short = model_id[len(prefix):] if prefix and model_id.startswith(prefix) else model_id
+    return short.split("/")[-1]
+
+
+def _with_suffix(short: str, suffix: str) -> str:
+    return f"{short} · {suffix}" if suffix else short
+
+
+def _room(suffix: str) -> int:
+    return MODEL_LABEL_BUDGET - (len(suffix) + 3 if suffix else 0)
+
+
+def model_button_label(model_id: str, prefix: str, suffix: str = "") -> str:
+    """``model_id`` without the shared namespace; over budget, the middle goes so the
+    distinguishing tail (family, version, date) stays visible."""
+    short = _strip(model_id, prefix)
+    room = _room(suffix)
+    if len(short) > room:
+        head = max(room // 3, 4)
+        short = f"{short[:head]}…{short[-(room - head - 1):]}"
+    return _with_suffix(short, suffix)
+
+
+def _around_difference(name: str, others: list[str], room: int) -> str:
+    """``name`` shortened to ``room`` keeping the span where it differs from its look-alikes:
+    a short head, then a window starting just before the first differing character."""
+    if len(name) <= room:
+        return name
+    diff = max(len(os.path.commonprefix([name, o])) for o in others)
+    if diff < room - 4:
+        return name[:room - 1] + "…"
+    head = max(room // 4, 4)
+    start = max(diff - 4, head + 1)
+    body = name[start:start + room - head - 1]
+    if start + len(body) < len(name):
+        body = body[:-1] + "…"
+    return f"{name[:head]}…{body}"
+
+
+def _clashes(labels: list[str]) -> list[list[int]]:
+    groups: dict[str, list[int]] = defaultdict(list)
+    for i, label in enumerate(labels):
+        groups[label].append(i)
+    return [g for g in groups.values() if len(g) > 1]
+
+
+def model_button_labels(model_ids: list[str], suffix_for: Callable[[str], str]) -> list[str]:
+    """Labels for the WHOLE catalog (stable across pages), unique within it: ids whose head/tail
+    names collide are re-shortened around the span where they differ, and an ordinal is the last
+    resort so two buttons never read the same while selecting different models."""
+    prefix = shared_label_prefix(model_ids)
+    # Clashes resolve on full ids: ``org/`` can be all that differs (OpenRouter ``meta-llama/`` vs
+    # ``nousresearch/``, Ollama ``hf.co/<org>/``).
+    names = list(model_ids)
+    suffixes = [suffix_for(m) for m in model_ids]
+    labels = [model_button_label(m, prefix, s) for m, s in zip(model_ids, suffixes)]
+    # Compare names without the plan word: ``a…tail · Large`` beside ``a…tail`` is still ambiguous.
+    for group in _clashes([model_button_label(m, prefix) for m in model_ids]):
+        for i in group:
+            others = [names[j] for j in group if names[j] != names[i]] or [""]
+            labels[i] = _with_suffix(_around_difference(names[i], others, _room(suffixes[i])), suffixes[i])
+    for group in _clashes(labels):
+        for i in group:
+            tag = f" #{i + 1}"  # catalog position: unique across groups, stable across pages
+            labels[i] = _with_suffix(_around_difference(names[i], [""], _room(suffixes[i]) - len(tag)) + tag, suffixes[i])
+    return labels
diff --git a/plugins/platforms/telegram/telegram_polling_probe.py b/plugins/platforms/telegram/telegram_polling_probe.py
new file mode 100644
index 00000000000..3f1adc34eaa
--- /dev/null
+++ b/plugins/platforms/telegram/telegram_polling_probe.py
@@ -0,0 +1,92 @@
+"""Telegram pending-queue heartbeat probe: a getUpdates consumer that is wedged or stopped while the
+general request path stays healthy is only visible through ``getWebhookInfo.pending_update_count``."""
+
+import asyncio
+import logging
+
+logger = logging.getLogger("plugins.platforms.telegram.adapter")
+
+
+class TelegramPendingProbeMixin:
+    """Stuck-consumer probe for ``TelegramAdapter``'s polling heartbeat."""
+
+    async def _probe_pending_updates(self, bot, probe_timeout: float) -> bool:
+        """Detect a wedged or stopped getUpdates consumer via pending_update_count.
+
+        Returns True when this probe observed a first stuck signal (queued updates the poller isn't
+        consuming, or a stopped updater) that the heartbeat loop should re-check promptly — after
+        ``STUCK_CONFIRM_INTERVAL``, not a full heartbeat interval, so the confirming probe can land in
+        the same awake window on power-napping hosts (#139281).
+
+        PTB can report ``updater.running`` while the long-poll is stuck; get_me() stays healthy yet DMs queue in the
+        Bot API. A stuck queue over two probes ⇒ dead consumer. Also covers the updater having stopped
+        entirely (``running=False``, no reconnect in flight).
+
+        PTB can report ``updater.running == True`` while its long-poll task is silently stuck (e.g. a socket
+        that epoll keeps reporting readable on WSL2). ``get_me()`` stays healthy because it uses the general
+        request path, so the CLOSE-WAIT heartbeat never fires — yet DMs queue in the Bot API and never reach
+        handlers (#42909).
+        We detect the stopped updater directly and feed the same ladder (#55769).
+        """
+        # Polling mode only: in webhook mode Telegram pushes and holds no server-side queue.
+        if self._teardown_started or self._webhook_mode:
+            return False
+        # An in-flight reconnect owns recovery — don't double-trigger, and don't misread its brief
+        # stop()->start_polling() window (updater.running transiently False) as dead.
+        if self._recovery_in_flight():
+            self._polling_not_running_count = 0
+            return False
+        updater = getattr(self._app, "updater", None) if self._app else None
+        if updater is None:
+            self._polling_pending_stuck_count = 0
+            return False
+        if not getattr(updater, "running", False):
+            # Long-poll task gone, general-path calls still succeed, so no error_callback/probe ever
+            # fires. Debounced over two probes so a just-starting updater never trips it.
+            self._polling_pending_stuck_count = 0
+            # We are in polling mode with no reconnect in flight, yet PTB's updater has stopped entirely.
+            # This is distinct from the wedged-but-running consumer handled below: the long-poll task is
+            # gone, get_me()/get_webhook_info() on the general request path still succeed, so no
+            # error_callback or connectivity probe ever fires and the gateway silently stops receiving
+            # messages while the process stays alive (#55769).
+            self._polling_not_running_count += 1
+            logger.warning(
+                "[%s] Telegram polling heartbeat: updater stopped while in polling mode (stuck probe %d/2)", self.name,
+                self._polling_not_running_count)
+            if self._polling_not_running_count >= 2:
+                self._polling_not_running_count = 0
+                self._escalate_stuck_consumer(
+                    "[%s] Telegram updater is not running (long-poll task gone); triggering polling restart",
+                    "Telegram updater stopped while in polling mode")
+                return False
+            return True
+        self._polling_not_running_count = 0
+        get_webhook_info = getattr(bot, "get_webhook_info", None)
+        if not callable(get_webhook_info):
+            return False
+        try:
+            info = await asyncio.wait_for(get_webhook_info(), probe_timeout)  # type: ignore[arg-type]
+        except (TimeoutError, OSError):
+            return False  # connectivity symptom for the get_me() path, not a stuck-queue signal
+        pending = int(getattr(info, "pending_update_count", 0) or 0)
+        if pending <= 0:
+            self._polling_pending_stuck_count = 0
+            return False
+        self._polling_pending_stuck_count += 1
+        logger.warning(
+            "[%s] Telegram polling heartbeat: %d update(s) queued but not consumed (stuck probe %d/2)", self.name,
+            pending, self._polling_pending_stuck_count)
+        if self._polling_pending_stuck_count >= 2:
+            self._polling_pending_stuck_count = 0
+            self._escalate_stuck_consumer(
+                "[%s] getUpdates consumer appears wedged (queue not draining); triggering polling restart",
+                "getUpdates consumer wedged: pending updates not draining")
+            return False
+        return True
+
+    def _escalate_stuck_consumer(self, log_message: str, reason: str) -> None:
+        """Second consecutive stuck probe: restart polling via the network-error ladder (unless tearing down)."""
+        if self._teardown_started:
+            return
+        logger.warning(log_message, self.name)
+        self._polling_error_task = asyncio.get_running_loop().create_task(self._handle_polling_network_error(RuntimeError(reason)))
diff --git a/plugins/platforms/telegram/telegram_send_errors.py b/plugins/platforms/telegram/telegram_send_errors.py
new file mode 100644
index 00000000000..6773c524da0
--- /dev/null
+++ b/plugins/platforms/telegram/telegram_send_errors.py
@@ -0,0 +1,67 @@
+"""What a failed Bot API send means for a resend. The standalone text retry, the text plain-text
+fallback and the album sender (gateway adapter and standalone) all read this one classifier, so
+they cannot disagree on "may it already be in the chat".
+
+PTB keys errors on class (``BadRequest`` subclasses ``NetworkError`` yet is permanent), so status
+digits in a message never decide a resend. PTB words a timeout-class answer as such ("Timed out",
+"Gateway Timeout (504)"), and a 5xx whose body is not Telegram's JSON (a fronting proxy's HTML
+page) arrives as a ``NetworkError`` chained to the failed parse of that body.
+"""
+
+from __future__ import annotations
+
+REFUSED = "refused"  # Telegram answered with a refusal (BadRequest, Forbidden, InvalidToken)
+FLOOD = "flood"  # a flood wait: answered, nothing posted, ``retry_after`` says when
+UNSENT = "unsent"  # connect/pool failure: the request never left
+SERVER_ERROR = "server_error"  # Telegram's own 5xx JSON answer (Bad Gateway, Internal Server Error)
+LOST = "lost"  # the request left and no readable answer came back (timeout, 504, reset, HTML 5xx)
+LOCAL = "local"  # not a Telegram/transport error (raised before or outside the request)
+
+# A request in one of these may already be in the chat, so it is never resent in another shape
+# (per photo, plain text). On Telegram's own 5xx JSON answer (``SERVER_ERROR``, its policy since
+# c928ebb1b1a) the standalone text send and both album lanes repeat the SAME request, with the same
+# budget: ``SAME_REQUEST_ATTEMPTS`` tries, ``same_request_backoff(attempt)`` seconds apart.
+MAY_HAVE_DELIVERED = frozenset({LOST, SERVER_ERROR})
+SAME_REQUEST_ATTEMPTS = 3
+
+
+def same_request_backoff(attempt: int) -> float:
+    """Seconds before resending the same request after failed try ``attempt`` (0-based)."""
+    return float(2 ** attempt)
+
+
+def send_error_kind(error: Exception) -> str:
+    """One of the module constants for a failed send; ``LOST`` when the adapter is unavailable."""
+    try:
+        from plugins.platforms.telegram.adapter import TelegramAdapter as tg, _iter_exception_graph
+    except ImportError:
+        return LOST
+    if getattr(error, "retry_after", None) is not None:
+        return FLOOD
+    if tg._is_bad_request_error(error) or tg._looks_like_auth_error(error):
+        return REFUSED
