diff --git a/tests/gateway/test_approval_card_publication_window.py b/tests/gateway/test_approval_card_publication_window.py
new file mode 100644
index 00000000000..a9a3cce43dd
--- /dev/null
+++ b/tests/gateway/test_approval_card_publication_window.py
@@ -0,0 +1,90 @@
+"""A card tap can approve only a request whose card was rendered for it: an id-less tap (a card from an
+older build) settles nothing, and a freshly queued request is Deny-only from the moment it is enqueued,
+so no tap path can approve it in the window before its renderer has decided what the card may offer."""
+
+import asyncio
+import threading
+
+import pytest
+
+from gateway.config import PlatformConfig
+
+SK = "agent:main:qqbot:dm:u-42"
+
+
+def _qq_tap(button_data):
+    from plugins.platforms.qqbot.adapter import QQAdapter
+    from plugins.platforms.qqbot.keyboards import parse_interaction_event
+
+    adapter = QQAdapter(PlatformConfig(enabled=True, extra={"app_id": "a", "client_secret": "b"}))
+    asyncio.run(adapter._default_interaction_dispatch(parse_interaction_event(
+        {"id": "i", "chat_type": 2, "user_openid": "u-42", "data": {"resolved": {"button_data": button_data}}})))
+
+
+def _publish_and_hold():
+    """A real gateway wait whose notifier is held before any rendering: the request is published."""
+    from tools import approval
+    from tools.approval_gateway_wait import _await_gateway_decision
+
+    entered, release, out = threading.Event(), threading.Event(), {}
+
+    def notify(data):
+        out["request_id"] = data["request_id"]
+        entered.set()
+        assert release.wait(10)
+
+    def wait():
+        out["decision"] = _await_gateway_decision(SK, notify, {"command": "rm -rf /tmp/x"})
+
+    thread = threading.Thread(target=wait)
+    thread.start()
+    assert entered.wait(10)
+    return approval, thread, release, out
+
+
+def _finish(approval, thread, release, out):
+    if approval.has_blocking_approval(SK):
+        approval.resolve_gateway_approval(SK, "deny", request_id=out["request_id"])
+    release.set()
+    thread.join(12)
+    assert not thread.is_alive()
+
+
+def test_an_old_id_less_card_tap_never_approves_a_newly_published_request():
+    approval, thread, release, out = _publish_and_hold()
+    try:
+        _qq_tap(f"approve:{SK}:allow-once")  # the legacy card format: no request id
+        assert approval.list_gateway_approvals(SK), "an id-less tap settled the new request"
+    finally:
+        _finish(approval, thread, release, out)
+    assert out["decision"]["choice"] == "deny"
+
+
+def test_a_published_request_is_deny_only_before_its_card_is_rendered():
+    approval, thread, release, out = _publish_and_hold()
+    try:
+        (pending,) = approval._gateway_queues[SK]
+        assert pending.card_deny_only is True
+        assert approval.resolve_gateway_approval_card(SK, "once", out["request_id"]) == 0
+    finally:
+        _finish(approval, thread, release, out)
+
+
+@pytest.mark.asyncio
+async def test_a_card_that_shows_the_whole_command_lifts_the_mark(monkeypatch):
+    from gateway.platforms.base import SendResult
+    from plugins.platforms.qqbot.adapter import QQAdapter
+    from tools import approval
+    from tools.approval_gateway_wait import _ApprovalEntry
+
+    entry = _ApprovalEntry({"request_id": "r1"})
+    entry.card_deny_only = True  # as every request is created
+    monkeypatch.setitem(approval._gateway_queues, SK, [entry])
+    adapter = QQAdapter(PlatformConfig(enabled=True, extra={"app_id": "a", "client_secret": "b"}))
+
+    async def send_with_keyboard(*_a, **_k):
+        return SendResult(success=True, message_id="card")
+
+    adapter.send_with_keyboard = send_with_keyboard
+    await adapter.send_exec_approval(chat_id="u-42", command="ls", session_key=SK, request_id="r1")
+    assert approval.resolve_gateway_approval_card(SK, "once", "r1") == 1 and entry.result == "once"
diff --git a/tests/gateway/test_approval_delivery_observability.py b/tests/gateway/test_approval_delivery_observability.py
new file mode 100644
index 00000000000..be7f6ecc8b2
--- /dev/null
+++ b/tests/gateway/test_approval_delivery_observability.py
@@ -0,0 +1,149 @@
+"""Every boundary of the gateway approval delivery path must leave a bounded log record (#138133).
+
+A Telegram DM reported an approval card the user never saw and a five-minute tool timeout; the
+delivery chain (terminal gate → notifier handoff → platform send/ack → wait settle) had exactly
+one outcome with no log at all ("sent"), so the failing boundary could not be identified from
+logs. These tests pin the correlation records — request_id / session / message_id / settle
+state only; never the command text.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+
+# Imported at MODULE level on purpose: gateway.run's import side effects (hermes_bootstrap's
+# interrupted-update probe) stat the checkout's git dir, which sits inside the real Hermes home
+# when the suite runs from a developer worktree — the home-I/O guard is fixture-scoped and only
+# active during a test, so the probe must happen here at collection time.
+import gateway.run as gateway_run
+from gateway.run_turn_runner import TurnRunner
+from gateway.platforms.base import SendResult
+from tools import approval as _approval
+from tools import approval_gateway_wait as wait_mod
+
+SESSION = "agent:main:telegram:dm:1"
+APPROVAL = {"command": "rm -rf /tmp/x", "description": "recursive delete", "pattern_key": "k"}
+
+
+def _clear_queues():
+    with _approval._lock:
+        _approval._gateway_queues.clear()
+        _approval._gateway_notify_cbs.clear()
+
+
+def test_timeout_settle_leaves_dispatch_and_settle_records(monkeypatch, caplog):
+    """An unanswered prompt must log both the notifier handoff and how the wait ended."""
+    _clear_queues()
+    monkeypatch.setattr(wait_mod._ctx, "_fire_approval_hook", lambda name, **kw: None)
+    monkeypatch.setattr(wait_mod, "_poll_event", lambda event, session_key, **_kw: "timeout")
+    with caplog.at_level(logging.INFO, logger="tools.approval"):
+        decision = wait_mod._await_gateway_decision(SESSION, lambda data: None, APPROVAL)
+
+    assert decision == {"resolved": False, "choice": None, "reason": None}
+    records = [r.message for r in caplog.records]
+    dispatch = [m for m in records if m.startswith("Approval prompt handed to gateway notifier")]
+    settle = [m for m in records if m.startswith("Approval wait ended")]
+    assert len(dispatch) == 1 and f"session={SESSION}" in dispatch[0]
+    assert len(settle) == 1 and "state=timeout, resolved=False, choice=None" in settle[0]
+    # Bounded by contract: correlation fields only, never the command being approved.
+    assert "rm -rf" not in " ".join(records)
+
+
+def test_acknowledged_card_leaves_a_delivery_record(tmp_path, monkeypatch, caplog):
+    """A platform-acked card must log its message_id — the acknowledgement entry #138133 lacked."""
+    (tmp_path / "config.yaml").write_text("display: {}")
+    monkeypatch.setattr(gateway_run, "_hermes_home", tmp_path)
+
+    class _ButtonAdapter:
+        typed_command_prefix = "/"
+
+        def pause_typing_for_chat(self, chat_id: str) -> None:
+            return None
+
+        async def send_exec_approval(self, *a: Any, **k: Any) -> SendResult:
+            return SendResult(success=True, message_id="card-1")
+
+        async def send(self, chat_id: str, message: str, **k: Any) -> SendResult:
+            return SendResult(success=True, message_id="m2")
+
+    monkeypatch.setattr("gateway.platforms.base_exec_approval.approval_timeout_seconds", lambda: 300)
+    runner = object.__new__(TurnRunner)
+    runner._ctx = SimpleNamespace(
+        _status_adapter=_ButtonAdapter(), _status_chat_id="C1", _status_thread_metadata={"thread_id": "77"},
+        session_key=SESSION,
+    )
+
+    class _Fut:
+        def __init__(self, result): self._r = result
+        def result(self, timeout=None): return self._r
+
+    runner._schedule = lambda coro, _label: _Fut(asyncio.run(coro))
+    runner._close_native_stream_boundary = lambda _why: None
+
+    data = dict(APPROVAL, request_id="req-1")
+    with caplog.at_level(logging.INFO, logger="gateway.run"):
+        runner._approval_notify_sync(data)
+
+    delivered = [r.message for r in caplog.records if r.message.startswith("Exec approval card delivered")]
+    assert len(delivered) == 1
+    assert "message_id=card-1" in delivered[0] and "request_id=req-1" in delivered[0]
+    assert f"session={SESSION}" in delivered[0]
+    # Labelled as the REQUESTED lane: a stale-thread fallback can deliver elsewhere, so "thread=" would lie.
+    assert "requested_chat=C1" in delivered[0] and "requested_thread=77" in delivered[0]
+    assert " chat=" not in delivered[0] and " thread=" not in delivered[0]
+    assert "rm -rf" not in delivered[0]
+
+
+def test_handoff_failure_still_logs_the_wait_side_boundary(monkeypatch, caplog):
+    """A raising notifier keeps its existing warning; the handoff INFO must not fire for it."""
+    _clear_queues()
+    monkeypatch.setattr(wait_mod._ctx, "_fire_approval_hook", lambda name, **kw: None)
+
+    def _raising_notify(data):
+        raise RuntimeError("boundary gone")
+
+    with caplog.at_level(logging.INFO, logger="tools.approval"):
+        decision = wait_mod._await_gateway_decision(SESSION, _raising_notify, APPROVAL)
+
+    assert decision["notify_failed"] is True
+    assert not [r for r in caplog.records if r.message.startswith("Approval prompt handed")]
+    assert any(r.levelno == logging.WARNING and "notify failed" in r.message for r in caplog.records)
+
+
+@pytest.mark.parametrize("text_ok, level", [(False, logging.WARNING), (True, logging.INFO)])
+def test_text_fallback_send_leaves_a_record(tmp_path, monkeypatch, caplog, text_ok, level):
+    """A failed card falls back to text; that send's own outcome must be logged, success or not."""
+    (tmp_path / "config.yaml").write_text("display: {}")
+    monkeypatch.setattr(gateway_run, "_hermes_home", tmp_path)
+
+    class _FailingCardAdapter:
+        typed_command_prefix = "/"
+
+        def pause_typing_for_chat(self, chat_id: str) -> None:
+            return None
+
+        async def send_exec_approval(self, *a: Any, **k: Any) -> SendResult:
+            return SendResult(success=False, error="Not connected")
+
+        async def send(self, chat_id: str, message: str, **k: Any) -> SendResult:
+            return SendResult(success=True, message_id="t1") if text_ok else SendResult(success=False, error="Not connected")
+
+    monkeypatch.setattr("gateway.platforms.base_exec_approval.approval_timeout_seconds", lambda: 300)
+    runner = object.__new__(TurnRunner)
+    runner._ctx = SimpleNamespace(
+        _status_adapter=_FailingCardAdapter(), _status_chat_id="C1", _status_thread_metadata=None, session_key=SESSION)
+    runner._schedule = lambda coro, _label: SimpleNamespace(result=lambda timeout=None, _r=asyncio.run(coro): _r)
+    runner._close_native_stream_boundary = lambda _why: None
+
+    with caplog.at_level(logging.INFO, logger="gateway.run"):
+        runner._approval_notify_sync(dict(APPROVAL, request_id="req-1"))
+
+    text = [r for r in caplog.records if r.message.startswith("Exec approval text prompt send")]
+    assert len(text) == 1 and text[0].levelno == level
+    assert f"success={text_ok}" in text[0].message and "request_id=req-1" in text[0].message
+    assert "rm -rf" not in text[0].message
diff --git a/tests/gateway/test_approval_requester_binding.py b/tests/gateway/test_approval_requester_binding.py
new file mode 100644
index 00000000000..1d27478befc
--- /dev/null
+++ b/tests/gateway/test_approval_requester_binding.py
@@ -0,0 +1,128 @@
+"""Who may answer a shared-chat exec approval, per ``approvals.approvers`` in config.yaml.
+
+Default (``["*"]``, or the key absent): any admitted member answers, exactly as before.
+Opt-in (``[]`` or a list of ids): another member's /approve (or a button click, which runs
+the same check) gets "Only <requester> can answer this approval." and the command stays pending.
+"""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+import hermes_yaml as yaml
+
+from gateway.config import GatewayConfig, Platform, PlatformConfig
+from gateway.platforms.event import MessageEvent
+from gateway.session import SessionSource
+
+DEFAULT = "<no approvers key>"
+
+
+def _runner(extra=None):
+    from gateway.run import GatewayRunner
+
+    runner = object.__new__(GatewayRunner)
+    runner.config = GatewayConfig(platforms={Platform.TELEGRAM: PlatformConfig(
+        enabled=True, token="***", extra=extra or {})})
+    adapter = MagicMock()
+    adapter.send = AsyncMock()
+    runner.adapters = {Platform.TELEGRAM: adapter}
+    runner.hooks = SimpleNamespace(emit=AsyncMock(), loaded_hooks=False)
+    runner.session_store = MagicMock()
+    runner._pending_approvals = {}
+    runner._running_agents = {}
+    runner._background_tasks = set()
+    return runner
+
+
+def _event(text, user_id, user_name):
+    # thread_id makes this a shared thread session: everyone in it maps to one session key.
+    return MessageEvent(text=text, message_id="m1", source=SessionSource(
+        platform=Platform.TELEGRAM, chat_id="-100group", chat_type="group", thread_id="t1",
+        user_id=user_id, user_name=user_name))
+
+
+def write_approvers(approvers):
+    """Write the profile's config.yaml as a user would (``DEFAULT`` leaves the key out)."""
+    from hermes_constants import get_hermes_home
+
+    approvals = {"mode": "manual", **({} if approvers == DEFAULT else {"approvers": approvers})}
+    (get_hermes_home() / "config.yaml").write_text(yaml.safe_dump({"approvals": approvals}), encoding="utf-8")
+
+
+def pending_from(user_id, user_name, session_key, platform="telegram"):
+    """Enqueue an approval the way the agent thread does, inside the requester's turn."""
+    from gateway.session_context import clear_session_vars, set_session_vars
+    from tools import approval as approval_mod
+    from tools.approval_gateway_wait import _ApprovalEntry
+
+    tokens = set_session_vars(platform=platform, user_id=user_id, user_name=user_name, session_key=session_key)
+    try:
+        entry = _ApprovalEntry({"command": "rm -rf build"})
+    finally:
+        clear_session_vars(tokens)
+    approval_mod._gateway_queues.setdefault(session_key, []).append(entry)
+    return entry
+
+
+@pytest.fixture(autouse=True)
+def _clean_queues():
+    from tools import approval as approval_mod
+
+    approval_mod._gateway_queues.clear()
+    yield
+    approval_mod._gateway_queues.clear()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(("clicker", "extra", "approvers", "allowed"), [
+    ("bob", None, DEFAULT, True),                                 # default: anyone admitted, as before
+    ("bob", None, ["*"], True),                                   # the default, spelled out
+    ("bob", None, [], False),                                     # opt-in: another member is refused
+    ("alice", None, [], True),                                    # opt-in: the requester
+    ("bob", None, ["bob"], True),                                 # opt-in: a listed approver
+    ("bob", {"group_allow_admin_from": ["bob"]}, [], True),       # opt-in: a platform admin
+])
+async def test_who_answers_a_shared_chat_approval(clicker, extra, approvers, allowed):
+    write_approvers(approvers)
+    runner = _runner(extra)
+    event = _event("/approve", clicker, clicker.title())
+    session_key = runner._session_key_for_source(event.source)
+    assert session_key == runner._session_key_for_source(_event("x", "alice", "Alice").source)
+    entry = pending_from("alice", "Alice", session_key)
+
+    reply = await runner._handle_approve_command(event)
+
+    assert entry.event.is_set() is allowed
+    if not allowed:
+        assert reply == "Only Alice can answer this approval."
+        assert entry.result is None
+        # Left pending: the requester can still answer it.
+        await runner._handle_approve_command(_event("/approve", "alice", "Alice"))
+        assert entry.event.is_set() and entry.result == "once"
+
+
+@pytest.mark.asyncio
+async def test_queued_approvals_of_two_requesters_do_not_block_each_other():
+    """Plain /approve and /deny answer the oldest entry, so only that entry decides who may send them."""
+    write_approvers([])
+    runner = _runner()
+    bob_event = _event("/approve", "bob", "Bob")
+    session_key = runner._session_key_for_source(bob_event.source)
+    bobs = pending_from("bob", "Bob", session_key)
+    alices = pending_from("alice", "Alice", session_key)
+
+    # Alice's entry is behind Bob's: plain /approve targets Bob's, so Alice is refused and nothing moves.
+    assert await runner._handle_approve_command(_event("/approve", "alice", "Alice")) == "Only Bob can answer this approval."
+    assert not bobs.event.is_set() and not alices.event.is_set()
+    # /approve all covers Alice's entry too, so Bob is refused and neither resolves.
+    assert await runner._handle_approve_command(_event("/approve all", "bob", "Bob")) == "Only Alice can answer this approval."
+    assert not bobs.event.is_set() and not alices.event.is_set()
+
+    await runner._handle_approve_command(bob_event)
+    assert bobs.result == "once" and not alices.event.is_set()
+    # Bob's entry is gone, Alice's is now the oldest: Bob can no longer answer it, Alice can.
+    assert await runner._handle_deny_command(_event("/deny", "bob", "Bob")) == "Only Alice can answer this approval."
+    assert not alices.event.is_set()
+    await runner._handle_deny_command(_event("/deny", "alice", "Alice"))
+    assert alices.result == "deny"
