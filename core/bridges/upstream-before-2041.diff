+          vaultFill: 'Fill login',
+          vaultFillFailed: 'Fill failed',
+          vaultFilled: (label: string) => `Filled ${label}`,
+          vaultLoadFailed: 'Load failed',
+          vaultLoading: 'Loading…',
+          vaultOpenSettings: 'Open settings',
+          vaultPageNotReady: 'Page not ready',
