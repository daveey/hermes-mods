diff --git a/apps/desktop/src/lib/preview-signins.test.ts b/apps/desktop/src/lib/preview-signins.test.ts
new file mode 100644
index 00000000000..cbd9963d100
--- /dev/null
+++ b/apps/desktop/src/lib/preview-signins.test.ts
@@ -0,0 +1,94 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import type { PreviewSigninsResult } from '@/global'
+
+// Fresh module per test so the module-level `lastSynced` map does not leak across cases.
+async function load() {
+  vi.resetModules()
+
+  return import('./preview-signins')
+}
+
+function setBridge(bridge: unknown) {
+  ;(globalThis as { window: { hermesDesktop?: unknown } }).window = bridge
+    ? { hermesDesktop: { syncPreviewSignins: bridge } }
+    : {}
+}
+
+const ok = (status: PreviewSigninsResult['status']): PreviewSigninsResult => ({
+  status,
+  imported: 0,
+  skipped: 0,
+  failed: 0,
+  cleared: 0
+})
+
+beforeEach(() => {
+  setBridge(null)
+})
+
+afterEach(() => {
+  vi.restoreAllMocks()
+  delete (globalThis as { window?: unknown }).window
+})
+
+describe('syncPreviewSignins lastSynced (P2-8 renderer)', () => {
+  it('does NOT mark the scope synced when the bridge replies with status error, so a retry still runs', async () => {
+    const bridge = vi
+      .fn<(r: unknown) => Promise<PreviewSigninsResult>>()
+      .mockResolvedValueOnce(ok('error'))
+      .mockResolvedValueOnce(ok('imported'))
+
+    setBridge(bridge)
+
+    const mod = await load()
+    const scope = { connectionId: null, profile: 'work' }
+
+    const first = await mod.syncPreviewSignins(true, scope)
+    expect(first?.status).toBe('error')
+
+    // The failed sync must NOT have left a permanent "synced" mark: the next if-changed call retries.
+    const retry = mod.syncPreviewSigninsIfChanged(true, scope)
+    expect(retry).not.toBeNull()
+    await retry
+    expect(bridge).toHaveBeenCalledTimes(2)
+  })
+
+  it('marks the scope synced after a successful reply, so if-changed is a no-op', async () => {
+    const bridge = vi.fn<(r: unknown) => Promise<PreviewSigninsResult>>().mockResolvedValue(ok('imported'))
+
+    setBridge(bridge)
+
+    const mod = await load()
+    const scope = { connectionId: null, profile: 'work' }
+
+    await mod.syncPreviewSignins(true, scope)
+    const again = mod.syncPreviewSigninsIfChanged(true, scope)
+
+    expect(again).toBeNull()
+    expect(bridge).toHaveBeenCalledTimes(1)
+  })
+
+  it('a successful clear (cleared/disabled) still marks synced', async () => {
+    const bridge = vi.fn<(r: unknown) => Promise<PreviewSigninsResult>>().mockResolvedValue(ok('cleared'))
+
+    setBridge(bridge)
+
+    const mod = await load()
+    const scope = { connectionId: null, profile: 'work' }
+
+    await mod.syncPreviewSignins(false, scope)
+
+    expect(mod.syncPreviewSigninsIfChanged(false, scope)).toBeNull()
+  })
+
+  it('off-Desktop (no bridge) returns null and marks nothing', async () => {
+    setBridge(null)
+
+    const mod = await load()
+    const scope = { connectionId: null, profile: 'work' }
+
+    expect(await mod.syncPreviewSignins(true, scope)).toBeNull()
+    // Nothing marked, so a later real bridge sync is not suppressed.
+  })
+})
diff --git a/apps/desktop/src/lib/preview-signins.ts b/apps/desktop/src/lib/preview-signins.ts
new file mode 100644
index 00000000000..a50f067a23d
--- /dev/null
+++ b/apps/desktop/src/lib/preview-signins.ts
@@ -0,0 +1,55 @@
+import type { PreviewSigninsResult } from '@/global'
+
+/** The (connection, profile) a config record was read from: the same scope its toggle writes. */
+export interface PreviewSigninsScope {
+  connectionId?: null | string
+  profile?: null | string
+}
+
+// Last `enabled` synced per scope, shared by the boot hook and the explicit Settings actions, so a toggle
+// the panel already synced is not imported a second time when the cache update reaches the hook.
+const lastSynced = new Map<string, boolean>()
+
+export const previewSigninsScopeKey = (scope: PreviewSigninsScope | undefined) =>
+  `${(scope?.connectionId ?? '').trim()}::${(scope?.profile ?? '').trim() || 'default'}`
+
+/** Ask Electron main to sign the in-app browser in (or out) for `scope`. Main re-checks that the backend is
+ *  local and the backend re-checks consent; the reply carries counts only. Null off-Desktop. */
+export async function syncPreviewSignins(
+  enabled: boolean,
+  scope: PreviewSigninsScope | undefined
+): Promise<null | PreviewSigninsResult> {
+  const bridge = window.hermesDesktop?.syncPreviewSignins
+
+  if (!bridge) {
+    return null
+  }
+
+  const result = await bridge({ connectionId: scope?.connectionId ?? null, enabled, profile: scope?.profile ?? null })
+
+  // P2-8 (renderer): only mark the scope synced AFTER a successful reply. Stamping before the bridge
+  // resolves (or on a `status: 'error'` reply) marked a failed import/clear as done, so the boot hook
+  // skipped the real retry. A failure leaves `lastSynced` untouched so the next `syncPreviewSigninsIfChanged`
+  // tries again.
+  if (result && result.status !== 'error') {
+    lastSynced.set(previewSigninsScopeKey(scope), enabled)
+  }
+
+  return result
+}
+
+/** A Settings toggle / consent prompt is about to write `enabled` optimistically into the config cache: claim
+ *  it so the boot hook does not race the save (the backend would still read the old value), then the caller
+ *  syncs explicitly once the save has landed. */
