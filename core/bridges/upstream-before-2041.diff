index 00000000000..7c6ed4845e0
--- /dev/null
+++ b/apps/desktop/electron/hermes-process.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, it } from 'vitest'
+
+import { commandLineIsHermesRuntime } from './hermes-process'
+
+// HX003: process identity comes from a whole argv TOKEN, never an argv substring.
+describe('commandLineIsHermesRuntime (HX003 token matching)', () => {
+  it('matches a real Hermes gateway command line', () => {
+    expect(commandLineIsHermesRuntime('hermes\0gateway\0run')).toBe(true)
+    expect(commandLineIsHermesRuntime('hermes gateway run')).toBe(true)
+    expect(commandLineIsHermesRuntime('hermes --profile work gateway run')).toBe(true)
+  })
+
+  it('matches a Hermes launched by an interpreter (basename of a path token)', () => {
+    expect(commandLineIsHermesRuntime('/venv/bin/python\0/venv/bin/hermes\0gateway\0run')).toBe(true)
+    expect(commandLineIsHermesRuntime('C:\\Hermes\\hermes.exe gateway run')).toBe(true)
+  })
+
+  // The bug this replaces: a bare `.includes('hermes')` matched any of these.
+  it('does NOT match an unrelated process whose path merely contains "hermes"', () => {
+    expect(commandLineIsHermesRuntime('vim /home/user/hermes-notes.txt')).toBe(false)
+    expect(commandLineIsHermesRuntime('/opt/hermesbrew/bin/tool --run')).toBe(false)
+    expect(commandLineIsHermesRuntime('node /srv/hermes-dashboard/server.js')).toBe(false)
+    expect(commandLineIsHermesRuntime('cat ~/.hermes/config.yaml')).toBe(false)
+  })
+
+  // G2 (#150283): the real unmanaged-gateway launch is `python -m hermes_cli.main … gateway
+  // run`, which the executable-basename-only matcher REJECTED — so findRunningGatewayProfiles
+  // missed a live gateway at first launch / profile repair. Mirror the canonical Python matcher
+  // (gateway.status.looks_like_gateway_command_line): recognize the module entry point, by argv
+  // TOKENS not a substring, carrying the gateway subcommand.
+  it('matches a module-launched gateway (python -m hermes_cli.main … gateway run)', () => {
+    expect(commandLineIsHermesRuntime('python\0-m\0hermes_cli.main\0-p\0x\0gateway\0run')).toBe(true)
+    expect(commandLineIsHermesRuntime('python -m hermes_cli.main -p x gateway run')).toBe(true)
+    expect(commandLineIsHermesRuntime('/venv/bin/python /venv/lib/hermes_cli/main.py gateway run')).toBe(true)
+    expect(commandLineIsHermesRuntime('python -m hermes_cli.main --profile work gateway run')).toBe(true)
+  })
+
+  it('does NOT match a module entry without the gateway subcommand, nor an unrelated hermes-tool path', () => {
+    // A hermes_cli.main invocation that is not a gateway (e.g. `chat`) is not a running gateway.
+    expect(commandLineIsHermesRuntime('python -m hermes_cli.main chat')).toBe(false)
+    // HX003: no substring; an unrelated tool whose path contains "hermes" is never a runtime.
+    expect(commandLineIsHermesRuntime('/opt/hermes-tool/foo gateway run')).toBe(false)
+    // `-p gateway` is a profile value, not a subcommand.
+    expect(commandLineIsHermesRuntime('python -m hermes_cli.main -p gateway chat')).toBe(false)
+  })
+})
diff --git a/apps/desktop/electron/hermes-process.ts b/apps/desktop/electron/hermes-process.ts
new file mode 100644
index 00000000000..5647b98b18c
--- /dev/null
+++ b/apps/desktop/electron/hermes-process.ts
@@ -0,0 +1,102 @@
+import { execSync } from 'node:child_process'
+import fs from 'node:fs'
+
+/**
+ * The Hermes runtime executable, matched as a whole argv TOKEN's basename — never an
+ * argv substring (root AGENTS.md HX003 forbids argv-substring process identity). A
+ * substring check over the full command line matched any process whose path merely
+ * contained "hermes" (`vim ~/hermes-notes.txt`, a `/opt/hermesbrew/...` tool), so a
+ * recycled PID could be mistaken for a live gateway. Mirrors the whole-token basename
+ * policy in `isSharedRuntime` (package-process-reap.ts) and the Python canonical
+ * matchers named in AGENTS.md HX003.
+ */
+const HERMES_RUNTIME_BASENAME = /^hermes(?:-agent|-acp)?(?:\.exe|\.cmd)?$/i
+
+/** Tokenize a raw command line: `/proc/<pid>/cmdline` is NUL-separated, `ps -o args=`
+ *  is whitespace-separated. Either way, split on both so one matcher serves both. */
+function commandLineTokens(raw: string): string[] {
+  return raw
+    .split(/[\0\s]+/)
+    .filter(token => token.length > 0)
+}
+
+/** The basename of an argv token, `/`- and `\`-separated. */
+function tokenBasename(token: string): string {
+  return token.replace(/^.*[\\/]/, '')
+}
+
+/** True when the tokens carry a `gateway` subcommand (ignoring a `--profile`/`-p VALUE`
+ *  pair, whose value could itself be the word `gateway`). Mirrors the canonical matcher's
+ *  profile-flag stripping (`gateway.status._gateway_command_subcommand`). */
+function tokensNameGatewaySubcommand(tokens: string[]): boolean {
+  const filtered: string[] = []
+  let skipNext = false
+
+  for (const token of tokens) {
+    const lower = token.toLowerCase()
+
+    if (skipNext) {
+      skipNext = false
+    } else if (lower === '--profile' || lower === '-p') {
+      skipNext = true
+    } else if (!lower.startsWith('--profile=') && !lower.startsWith('-p=')) {
+      filtered.push(lower)
+    }
+  }
+
+  return filtered.includes('gateway')
+}
+
+/** True when `raw` is a Hermes runtime command line, identified by a whole argv TOKEN
+ *  (never an argv substring — root AGENTS.md HX003). Two shapes, mirroring the canonical
+ *  Python matcher `gateway.status.looks_like_gateway_command_line`:
+ *    1. a token whose basename is the Hermes executable (`hermes`, launched directly or by
+ *       an interpreter such as `python …/hermes gateway run`); or
+ *    2. a `hermes_cli.main` / `hermes_cli/main.py` module entry (`python -m hermes_cli.main
+ *       … gateway run`, the real unmanaged-gateway launch) carrying the `gateway` subcommand.
+ *  Shape 2 was missing, so `findRunningGatewayProfiles` could not see a module-launched
+ *  gateway at first launch / profile repair. Exported for unit tests. */
+export function commandLineIsHermesRuntime(raw: string): boolean {
+  const tokens = commandLineTokens(raw)
+
+  if (tokens.some(token => HERMES_RUNTIME_BASENAME.test(tokenBasename(token)))) {
+    return true
+  }
+
+  const hasModuleEntry = tokens.some(token => {
+    const lower = token.toLowerCase()
+
+    return lower === 'hermes_cli.main' || lower === 'hermes_cli/main.py' || lower.endsWith('/hermes_cli/main.py')
+  })
+
+  return hasModuleEntry && tokensNameGatewaySubcommand(tokens)
+}
+
+// True when the given pid belongs to a running Hermes process, identified by a whole
+// argv token (not a substring), avoiding false positives from stale gateway.pid files
+// whose PID was recycled by the OS to an unrelated process.
+export function isHermesProcess(pid: number): boolean {
+  try {
+    process.kill(pid, 0) // signal 0 = existence check, no signal sent
+  } catch {
+    return false
+  }
+
+  // On macOS / Linux, check the command line to avoid PID recycling false positives.
+  try {
+    const cmdline = fs.readFileSync(`/proc/${pid}/cmdline`, 'utf8')
+
+    return commandLineIsHermesRuntime(cmdline)
+  } catch {
+    // /proc not available (macOS) — fall back to ps. Use -o args= to inspect
+    // the full command line, not just the process name.  -o comm= would return
+    // "python3" for any Python process, creating false positives.
+    try {
+      const out = execSync(`ps -p ${pid} -o args=`, { encoding: 'utf8', timeout: 2000 })
+
+      return commandLineIsHermesRuntime(out)
+    } catch {
+      return false
+    }
+  }
+}
