+})
+
+vi.mock('@/store/notifications', () => ({ notify: vi.fn() }))
+
+vi.mock('./preview-vault', () => ({
+  forgetPreviewVaultBinding: vi.fn(),
+  openUserPreviewVaultBinding: vi.fn(() => 'bind-target')
+}))
+
+vi.mock('@/store/recovery-requests', () => ({ requestRoute: vi.fn() }))
+
