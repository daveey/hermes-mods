diff --git a/tests/hermes_cli/test_browser_preview_signins.py b/tests/hermes_cli/test_browser_preview_signins.py
new file mode 100644
index 00000000000..2ab24b51071
--- /dev/null
+++ b/tests/hermes_cli/test_browser_preview_signins.py
@@ -0,0 +1,90 @@
+"""``hermes browser export-signins``: the pipe Desktop reads the real-profile browser's cookies from."""
+
+from __future__ import annotations
+
+import io
+import json
+import threading
+
+import pytest
+
+from hermes_cli import browser_preview_signins as signins
+
+COOKIES = [
+    {"name": "sid", "value": "s3cret", "domain": "app.test", "path": "/", "httpOnly": True, "secure": True,
+     "session": False, "expires": 2e9, "sameSite": "Lax", "size": 9, "priority": "Medium"},
+    {"name": "chips", "value": "x", "domain": "embed.test", "path": "/",
+     "partitionKey": {"topLevelSite": "https://top.test", "hasCrossSiteAncestor": True}},
+]
+
+
+@pytest.fixture
+def cdp_server():
+    """A browser-level CDP endpoint that sends an event first, then answers Storage.getCookies."""
+    from websockets.sync.server import serve
+
+    def handler(ws):
+        req = json.loads(ws.recv())
+        ws.send(json.dumps({"method": "Target.targetCreated", "params": {}}))
+        assert req["method"] == "Storage.getCookies"
+        ws.send(json.dumps({"id": req["id"], "result": {"cookies": COOKIES}}))
+
+    server = serve(handler, "127.0.0.1", 0)
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    yield f"ws://127.0.0.1:{server.socket.getsockname()[1]}/devtools/browser/x"
+    server.shutdown()
+
+
+@pytest.fixture
+def released(monkeypatch):
+    calls = []
+    monkeypatch.setattr("tools.browser_session_real_profile.terminate_real_profile_browser",
+                        lambda: calls.append(True))
+    return calls
+
+
+def _run(monkeypatch, *, tty=False):
+    out = io.StringIO()
+    out.isatty = lambda: tty  # type: ignore[method-assign]
+    monkeypatch.setattr(signins.sys, "stdout", out)
+    code = signins.run_export_signins(type("A", (), {"json": True})())
+    return code, out.getvalue()
+
+
+def test_exports_the_real_profile_browsers_cookies_to_stdout(monkeypatch, cdp_server, released):
+    monkeypatch.setattr("tools.browser_session_real_profile.real_profile_cdp", lambda: (cdp_server, None))
+
+    code, out = _run(monkeypatch)
+
+    verdict = json.loads(out)
+    assert code == 0 and verdict["status"] == "ok"
+    # Partitioned (CHIPS) cookies are skipped: set unpartitioned they would widen the site's scope.
+    assert verdict["skipped"] == 1
+    assert verdict["cookies"] == [{k: COOKIES[0][k] for k in signins._COOKIE_FIELDS}]
+    assert released == [True]
+
+
+def test_consent_off_reports_disabled_and_reads_nothing(monkeypatch, released):
+    monkeypatch.setattr("tools.browser_session_real_profile.real_profile_cdp", lambda: (None, None))
+
+    code, out = _run(monkeypatch)
+
+    assert (code, json.loads(out)) == (0, {"status": "disabled"})
+
+
+def test_a_browser_that_cannot_start_is_an_error_not_an_empty_import(monkeypatch, released):
+    monkeypatch.setattr("tools.browser_session_real_profile.real_profile_cdp", lambda: (None, "profile locked"))
+
+    code, out = _run(monkeypatch)
+
+    assert (code, json.loads(out)) == (1, {"status": "error", "error": "profile locked"})
+
+
+def test_refuses_to_print_cookie_values_to_a_terminal(monkeypatch, capsys):
+    monkeypatch.setattr("tools.browser_session_real_profile.real_profile_cdp",
+                        lambda: pytest.fail("must not read cookies for a terminal"))
+
+    code, out = _run(monkeypatch, tty=True)
+
+    assert code == 2 and out == ""
+    assert "Hermes Desktop" in capsys.readouterr().err
diff --git a/tests/hermes_cli/test_profile_publication_after_delete.py b/tests/hermes_cli/test_profile_publication_after_delete.py
new file mode 100644
index 00000000000..18b8d731654
--- /dev/null
+++ b/tests/hermes_cli/test_profile_publication_after_delete.py
@@ -0,0 +1,62 @@
+"""A profile published under a previously deleted name is a live profile.
+
+``profile delete`` leaves a tombstone at ``profiles/.deleted/<name>``. Import, distribution
+install and rename each publish a directory under a name; a tombstone left for that name made
+the new profile unlisted, unresolvable through ``-p``, and refused by ``create`` as existing.
+"""
+
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from hermes_cli import profiles
+from hermes_cli.profile_distribution import DistributionManifest, install_distribution, write_manifest
+
+
+@pytest.fixture()
+def profile_env(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    return tmp_path
+
+
+def _create_and_delete(name: str) -> None:
+    profiles.create_profile(name, no_alias=True)
+    with patch("hermes_cli.profiles._cleanup_gateway_service"), \
+         patch("hermes_cli.profiles._live_default_multiplexer", return_value=False):
+        profiles.delete_profile(name, yes=True)
+
+
+def _publish_by_import(tmp_path: Path, name: str) -> None:
+    profiles.create_profile("source", no_alias=True)
+    archive = profiles.export_profile("source", str(tmp_path / "source.tar.gz"))
+    profiles.import_profile(str(archive), name=name)
+
+
+def _publish_by_install(tmp_path: Path, name: str) -> None:
+    source = tmp_path / "distribution"
+    source.mkdir()
+    (source / "SOUL.md").write_text("Distribution.\n")
+    (source / "config.yaml").write_text("model:\n  model: m\n")
+    write_manifest(source, DistributionManifest(name=name, version="0.1.0"))
+    install_distribution(str(source), name=name)
+
+
+def _publish_by_rename(tmp_path: Path, name: str) -> None:
+    profiles.create_profile("source", no_alias=True)
+    with patch("hermes_cli.profiles._cleanup_gateway_service"):
+        profiles.rename_profile("source", name)
+
+
+@pytest.mark.parametrize("publish", [_publish_by_import, _publish_by_install, _publish_by_rename],
+                         ids=["import", "install", "rename"])
+def test_profile_published_under_a_deleted_name_is_live(profile_env, publish):
+    _create_and_delete("reused")
+
+    publish(profile_env, "reused")
+
+    assert "reused" in [p.name for p in profiles.list_profiles()]
+    assert profiles.resolve_profile_env("reused") == str(profiles.get_profile_dir("reused"))
