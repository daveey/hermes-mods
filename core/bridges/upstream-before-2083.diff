diff --git a/scripts/ci/skills_index_probe.py b/scripts/ci/skills_index_probe.py
new file mode 100644
index 00000000000..af05b3f4cbf
--- /dev/null
+++ b/scripts/ci/skills_index_probe.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""Judge a downloaded skills-index.json and print ``status=``/``detail=``/``summary=`` output lines.
+
+Run by ``.github/workflows/skills-index-freshness.yml`` after it downloads the live
+``/docs/api/skills-index.json``; the step appends stdout to ``$GITHUB_OUTPUT``. The index is
+``degraded`` when it is more than 26 hours old, a major source has collapsed below its floor, or
+the total falls under 1500. ``parse-failed`` and ``invalid-shape`` cover a file that is not the
+expected JSON. Every verdict exits 0 so the workflow's issue step decides what to do.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from collections import Counter
+from datetime import UTC, datetime
+
+MAX_AGE_HOURS = 26
+MIN_TOTAL = 1500
+# Same as build_skills_index.py EXPECTED_FLOORS.
+SOURCE_FLOORS = {
+    "skills.sh": 100,
+    "lobehub": 100,
+    "clawhub": 50,
+    "official": 50,
+    "github": 30,
+    "browse-sh": 50,
+}
+
+
+def evaluate(data, now: datetime) -> list[str]:
+    """Return the ``key=value`` output lines for a decoded index."""
+    generated_at = data.get("generated_at", "")
+    total = data.get("skill_count", 0)
+    skills = data.get("skills", [])
+    if not isinstance(skills, list):
+        return [
+            "status=invalid-shape",
+            f"detail=skills field is not a list (got {type(skills).__name__})",
+        ]
+
+    by_src = Counter(s.get("source", "") for s in skills)
+
+    age_hours = None
+    try:
+        ts = datetime.fromisoformat(generated_at)
+        age_hours = (now - ts).total_seconds() / 3600
+    except (TypeError, ValueError):
+        pass  # an unreadable or naive timestamp skips only the age check
+
+    issues = []
+    if age_hours is not None and age_hours > MAX_AGE_HOURS:
+        issues.append(f"Index is {age_hours:.1f}h old (limit {MAX_AGE_HOURS}h)")
+    for src, floor in SOURCE_FLOORS.items():
+        count = by_src.get(src, 0)
+        if src == "skills.sh":
+            count = by_src.get("skills.sh", 0) + by_src.get("skills-sh", 0)
+        if count < floor:
+            issues.append(f"{src}: {count} < {floor}")
+    if total < MIN_TOTAL:
+        issues.append(f"total skills: {total} < {MIN_TOTAL}")
+
+    if issues:
+        # GITHUB_OUTPUT doesn't allow newlines without explicit delimiter
+        return ["status=degraded", f"detail={'; '.join(issues)}"]
+    by_summary = ", ".join(f"{k}={v}" for k, v in by_src.most_common(8))
+    return [
+        "status=ok",
+        f"detail=Index OK — {total} skills, generated {generated_at}",
+        f"summary={by_summary}",
+    ]
+
+
+def judge_file(path: str, now: datetime) -> list[str]:
+    try:
+        with open(path, encoding="utf-8-sig") as f:
+            data = json.load(f)
+    except (OSError, ValueError) as e:
+        return ["status=parse-failed", f"detail=JSON decode error: {e}"]
+    return evaluate(data, now)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Judge a downloaded skills-index.json.")
+    parser.add_argument("index", help="Path to the downloaded skills-index.json")
+    args = parser.parse_args(argv)
+    for line in judge_file(args.index, datetime.now(UTC)):
+        print(line)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/ci/skills_index_watchdog_issue.py b/scripts/ci/skills_index_watchdog_issue.py
new file mode 100644
index 00000000000..9ebfa79452d
--- /dev/null
+++ b/scripts/ci/skills_index_watchdog_issue.py
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+"""Open or update the watchdog issue for a failed probe in skills-index-freshness.yml.
+
+Each watchdog owns a title prefix. When an open issue already carries that prefix, the script
+appends a comment instead of opening a new issue each tick, so a stuck probe does not spam the
+tracker. The prefixes differ so a plugin-catalog CORS report never lands on a skills-index issue.
+
+Reads ``STATUS`` and ``DETAIL`` (probe outputs), ``GITHUB_REPOSITORY``, and leaves ``GH_TOKEN`` in
+the environment for ``gh``; the token never appears in argv.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import subprocess
+import sys
+from dataclasses import dataclass
+from datetime import UTC, datetime
+
+GH_TIMEOUT_SECONDS = 120
+
+
+@dataclass(frozen=True)
+class Watchdog:
+    title_prefix: str
+    title: str
+    body: str
+
+
+WATCHDOGS = {
+    "skills-index": Watchdog(
+        title_prefix="[skills-index-watchdog]",
+        title="Skills index is stale or degraded ({status})",
+        body="""Automated freshness probe failed.
+
+**Status:** `{status}`
+**Detail:** {detail}
+
+The Skills Hub at /docs/skills depends on `/docs/api/skills-index.json`.
+The unified index is rebuilt by `.github/workflows/skills-index.yml` (cron 6/18 UTC)
+and `.github/workflows/deploy-site.yml` (on every push affecting website/skills).
+If this issue keeps reopening, check the latest runs:
+
+- https://github.com/{repository}/actions/workflows/skills-index.yml
+- https://github.com/{repository}/actions/workflows/deploy-site.yml
+
+This issue was opened by `.github/workflows/skills-index-freshness.yml`. Close it once the underlying problem is fixed; the next probe will reopen if it's still broken.""",
+    ),
+    "plugin-catalog-cors": Watchdog(
+        title_prefix="[plugin-catalog-cors-watchdog]",
+        title="Desktop cannot read the plugin catalog ({status})",
+        body="""Hermes Desktop cannot read the plugin catalog.
+
+**Status:** `{status}`
+**Detail:** {detail}
+
+Desktop's `hermes://plugin/install?catalog=` links fetch `/docs/api/plugins.json` cross-origin.
+A browser rejects that fetch when any response in the redirect chain, including the docs host's
+redirect to GitHub Pages, lacks `Access-Control-Allow-Origin`. Every catalog install link then
+shows "Could not load the Hermes plugin catalog". Background: #136483.
+
+This issue was opened by `.github/workflows/skills-index-freshness.yml` (job `check-catalog-cors`). Close it once the header is back; the next probe will reopen it if it's still broken.""",
+    ),
+}
+
+
+def find_open_issue(issues: list[dict], title_prefix: str) -> int | None:
+    """First listed issue whose title starts with the prefix (GitHub search also matches mid-title)."""
+    for issue in issues:
+        if issue["title"].startswith(title_prefix):
+            return issue["number"]
+    return None
+
+
+def plan_commands(
+    watchdog: Watchdog,
+    existing: int | None,
+    *,
+    repository: str,
+    status: str,
+    detail: str,
+    now: datetime,
+) -> tuple[str, list[str]]:
+    """Return the log line and the ``gh`` argv that reports this failure."""
+    if existing is not None:
+        stamp = now.strftime("%Y-%m-%dT%H:%M:%SZ")
+        return f"Appending to existing issue #{existing}", [
+            "gh", "issue", "comment", str(existing), "--repo", repository,
+            "--body", f"Probe still failing at {stamp}: `{status}` — {detail}",
+        ]
+    fields = {"repository": repository, "status": status, "detail": detail}
+    return "Opening new watchdog issue", [
+        "gh", "issue", "create", "--repo", repository,
+        "--title", f"{watchdog.title_prefix} {watchdog.title.format(**fields)}",
+        "--body", watchdog.body.format(**fields),
+    ]
+
+
+def list_open_issues(repository: str, title_prefix: str) -> list[dict]:
+    """Open issues matching the prefix; a failed listing counts as none, so a new issue is filed."""
+    listed = subprocess.run(
+        [
+            "gh", "issue", "list", "--repo", repository, "--state", "open",
+            "--search", f'in:title "{title_prefix}"', "--json", "number,title",
+        ],
+        check=False, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, text=True, timeout=GH_TIMEOUT_SECONDS,
+    )
+    if listed.returncode != 0:
+        return []
+    return json.loads(listed.stdout)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Open or update a probe watchdog issue.")
+    parser.add_argument("watchdog", choices=sorted(WATCHDOGS))
+    args = parser.parse_args(argv)
+    watchdog = WATCHDOGS[args.watchdog]
+    repository = os.environ["GITHUB_REPOSITORY"]
+
+    existing = find_open_issue(list_open_issues(repository, watchdog.title_prefix), watchdog.title_prefix)
+    message, command = plan_commands(
+        watchdog,
+        existing,
+        repository=repository,
+        status=os.environ.get("STATUS", ""),
+        detail=os.environ.get("DETAIL", ""),
+        now=datetime.now(UTC),
+    )
+    print(message, flush=True)
+    return subprocess.run(command, check=False, stdin=subprocess.DEVNULL, timeout=GH_TIMEOUT_SECONDS).returncode
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/ci/verify_uv_lock.py b/scripts/ci/verify_uv_lock.py
new file mode 100755
index 00000000000..58b8964fa3b
--- /dev/null
+++ b/scripts/ci/verify_uv_lock.py
@@ -0,0 +1,161 @@
+#!/usr/bin/env python3
+"""Fail when uv.lock is out of sync with pyproject.toml, telling a registry outage apart.
+
+Run by the ``Verify uv.lock is up-to-date`` step of ``.github/workflows/repo-guards.yml``.
+``python -m pm.build_env --source . --check-lock`` re-resolves against PyPI (network), so it is
+retried: a registry blip must not read as "lockfile stale", while a genuinely stale lockfile
+fails every attempt (deterministic) and costs only seconds. The backoff is 5/15/45s rather than a
+flat 10s, because three attempts inside ~20s all land in the same blip.
+
+uv says "Request failed after N retries" when it cannot reach the registry and "lockfile needs
+to be updated" when the lock is stale. Only the second is the contributor's to fix, so an
+unreachable registry says so instead of sending them to ``hermes pm lock`` with nothing to
+regenerate. Writes the ``uv-lockfile`` review status (scripts/ci/review_status.py).
+
+An attempt that outlives ``CHECK_TIMEOUT`` is stopped, its partial log is still printed, and it
+reports a timeout without retrying: three more such attempts would outlive the job.
+
+Exit codes: 0 = in sync, 1 = stale lockfile, registry unreachable, or timed out.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import sys
+import time
+from collections.abc import Callable
+from pathlib import Path
+
+if __package__ in (None, ""):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from scripts.ci.review_status import action_required, publish
+
+CHECK_COMMAND = ("python", "-m", "pm.build_env", "--source", ".", "--check-lock")
+CHECK_TEXT = "python -m pm.build_env --source . --check-lock"
+RETRY_DELAYS = (5, 15, 45)
+ATTEMPTS = 3
+# Under the job's 15-minute cap; the check itself takes seconds to a minute.
+CHECK_TIMEOUT = 600
+ARTIFACT = "uv-lockfile"
+REGISTRY_UNREACHABLE = re.compile(
+    r"Request failed after|Failed to fetch|error sending request|connection (reset|closed)|timed out",
+    re.IGNORECASE,
+)
+
+STALE_SUMMARY = f"""\
+## ❌ uv.lock is out of sync with pyproject.toml
+
+**If this is a PR:** this check runs against the merged state
+(your branch + current `main`), not just your branch.  If
+`{CHECK_TEXT}` passes locally, your branch is likely behind
+`main` — recent changes to `pyproject.toml` on `main` aren't
+reflected in your branch's `uv.lock` yet.
+
+To fix, sync with main and regenerate the lockfile:
+
+```bash
+git fetch origin main
+git rebase origin/main   # or `git merge origin/main`
+hermes pm lock                  # regenerate against new pyproject.toml
+git add uv.lock
+git commit -m "chore: refresh uv.lock after syncing with main"
+git push --force-with-lease  # drop --force-with-lease if you merged
+```
+
+**If you only changed pyproject.toml:** run `hermes pm lock` locally
+and commit the result.
+
+This check is blocking because the Docker image build uses
+`uv sync --frozen --extra all`, which rejects stale lockfiles
+— catching it here avoids a ~15 min failed docker run
+on `main` post-merge.
+"""
+
+UNREACHABLE_STATUS = action_required(
+    "uv.lock check", "uv.lock check could not reach PyPI",
+    f"`{CHECK_TEXT}` could not reach the package registry after 3 attempts. "
+    "This is an infrastructure failure, not a stale lockfile.",
+    "Re-run the failed job. No change to `uv.lock` is needed.",
+)
+TIMEOUT_STATUS = action_required(
+    "uv.lock check", "uv.lock check timed out",
+    f"`{CHECK_TEXT}` ran longer than {CHECK_TIMEOUT}s and was stopped. "
+    "This is an infrastructure failure, not a stale lockfile.",
+    "Re-run the failed job. No change to `uv.lock` is needed.",
+)
+STALE_STATUS = action_required(
+    "uv.lock check", "uv.lock out of sync", "uv.lock is out of sync with pyproject.toml.",
+    "Run `hermes pm lock` locally and commit the result. If on a PR, sync with main first:\n"
+    "```\ngit fetch origin main\ngit rebase origin/main\nhermes pm lock\ngit add uv.lock\n"
+    'git commit -m "chore: refresh uv.lock"\n```\n',
+)
+
+
+IN_SYNC, STALE, UNREACHABLE, TIMED_OUT = "in-sync", "stale", "unreachable", "timed-out"
+
+
+def run_check(log: Path, timeout: float = CHECK_TIMEOUT) -> int | None:
+    """One attempt's exit code, or None when it timed out; the output goes to ``log``, then stdout."""
+    with log.open("wb") as fh:
+        try:
+            returncode = subprocess.run(CHECK_COMMAND, stdout=fh, stderr=subprocess.STDOUT,
+                                        stdin=subprocess.DEVNULL, timeout=timeout,
+                                        check=False).returncode
+        except subprocess.TimeoutExpired:
+            returncode = None
+    sys.stdout.flush()
+    sys.stdout.buffer.write(log.read_bytes())
+    sys.stdout.flush()
+    return returncode
+
+
+def verify(log: Path, sleep: Callable[[float], None] = time.sleep,
+           timeout: float = CHECK_TIMEOUT) -> str:
+    """IN_SYNC, STALE, UNREACHABLE or TIMED_OUT after up to three attempts."""
+    for attempt in range(1, ATTEMPTS + 1):
+        returncode = run_check(log, timeout)
+        if returncode is None:
+            return TIMED_OUT
+        if returncode == 0:
+            return IN_SYNC
+        if not REGISTRY_UNREACHABLE.search(log.read_text(encoding="utf-8-sig", errors="replace")):
+            # Deterministic failure (a real desync): retrying prints the same error twice more.
+            return STALE
+        if attempt == ATTEMPTS:
+            break
+        delay = RETRY_DELAYS[attempt - 1]
+        print(f"::warning::{CHECK_TEXT} could not reach the registry (attempt {attempt}); "
+              f"retrying in {delay}s", flush=True)
+        sleep(delay)
+    return UNREACHABLE
+
+
+def main() -> int:
+    runner_temp = Path(os.environ["RUNNER_TEMP"])
+    verdict = verify(runner_temp / "lock-check.log")
+    if verdict == TIMED_OUT:
+        print(f"::error title=uv.lock check timed out::Stopped after {CHECK_TIMEOUT}s — "
+              "infrastructure failure, not a stale lockfile. Re-run the job.")
+        publish(TIMEOUT_STATUS, ARTIFACT)
+        return 1
+    if verdict == UNREACHABLE:
+        print("::error title=uv.lock check could not reach PyPI::Registry unreachable after 3 "
+              "attempts — infrastructure failure, not a stale lockfile. Re-run the job.")
+        publish(UNREACHABLE_STATUS, ARTIFACT)
+        return 1
+    if verdict == STALE:
+        with open(os.environ["GITHUB_STEP_SUMMARY"], "a", encoding="utf-8") as fh:
+            fh.write(STALE_SUMMARY)
+        print("::error title=uv.lock out of sync::Run `hermes pm lock` locally and commit the "
+              "result. If on a PR, sync with main first.")
+        publish(STALE_STATUS, ARTIFACT)
+        return 1
+    publish([], ARTIFACT)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
