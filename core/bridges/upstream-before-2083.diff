diff --git a/scripts/ci/pr_diff_report.py b/scripts/ci/pr_diff_report.py
new file mode 100755
index 00000000000..e6ce77b46de
--- /dev/null
+++ b/scripts/ci/pr_diff_report.py
@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+"""Write a PR's advisory diff report and publish it to the step summary.
+
+Run by two steps of ``.github/workflows/repo-guards.yml`` on pull requests, with the target
+branch in ``BASE_REF``. Each report diffs from the merge base with ``origin/$BASE_REF``, not the
+base tip, so changes that landed on main after the branch point are not this PR's doing.
+
+    python3 scripts/ci/pr_diff_report.py prompt-surface   # $RUNNER_TEMP/prompt-surface.md
+    python3 scripts/ci/pr_diff_report.py lockfile         # $RUNNER_TEMP/lockfile-diff.md
+
+A non-empty report appends ``changed=true`` to ``$GITHUB_OUTPUT`` and the report, under its
+heading, to ``$GITHUB_STEP_SUMMARY``; an empty one appends ``changed=false``.
+``scripts/ci/review_status.py emit`` then publishes it for the live PR comment.
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+SCRIPTS = Path(__file__).resolve().parent
+PROMPT_SURFACE_SNAPSHOT = "tests/fixtures/prompt_surface"
+HEADINGS = {"prompt-surface": "## Prompt surface", "lockfile": "## JS lockfile semantic diff"}
+GIT_TIMEOUT = 120
+REPORT_TIMEOUT = 600
+REPORTS = {"prompt-surface": "prompt-surface.md", "lockfile": "lockfile-diff.md"}
+
+
+def merge_base() -> str:
+    return subprocess.run(("git", "merge-base", f"origin/{os.environ['BASE_REF']}", "HEAD"),
+                          stdout=subprocess.PIPE, text=True, stdin=subprocess.DEVNULL,
+                          timeout=GIT_TIMEOUT, check=True).stdout.strip()
+
+
+def extract_base_snapshot(base_sha: str, destination: Path) -> None:
+    """Extract the snapshot as committed at the merge base; a base without one leaves it absent."""
+    destination.mkdir(parents=True, exist_ok=True)
+    present = subprocess.run(("git", "cat-file", "-e", f"{base_sha}:{PROMPT_SURFACE_SNAPSHOT}"),
+                             stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
+                             timeout=GIT_TIMEOUT, check=False)
+    if present.returncode != 0:
+        return
+    archive = subprocess.run(("git", "archive", base_sha, PROMPT_SURFACE_SNAPSHOT),
+                             stdout=subprocess.PIPE, stdin=subprocess.DEVNULL,
+                             timeout=GIT_TIMEOUT, check=True).stdout
+    subprocess.run(("tar", "-x", "-C", str(destination)), input=archive, timeout=GIT_TIMEOUT,
+                   check=True)
+
+
+def write_report(kind: str, base_sha: str, report: Path) -> None:
+    if kind == "prompt-surface":
+        base_dir = report.parent / "base"
+        extract_base_snapshot(base_sha, base_dir)
+        command = [str(SCRIPTS / "prompt_surface.py"), "diff",
+                   str(base_dir / PROMPT_SURFACE_SNAPSHOT), PROMPT_SURFACE_SNAPSHOT]
+    else:
+        print(f"Merge base: {base_sha}", flush=True)
+        command = [str(SCRIPTS / "lockfile_diff.py"), "--base", base_sha, "--head", "HEAD"]
+    subprocess.run([sys.executable, *command, "--output", str(report)],
+                   stdin=subprocess.DEVNULL, timeout=REPORT_TIMEOUT, check=True)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Write a PR's advisory diff report.")
+    parser.add_argument("kind", choices=sorted(REPORTS))
+    args = parser.parse_args(argv)
+    report = Path(os.environ["RUNNER_TEMP"], REPORTS[args.kind])
+    try:
+        write_report(args.kind, merge_base(), report)
+    except subprocess.CalledProcessError as exc:
+        return exc.returncode
+    changed = report.is_file() and report.stat().st_size > 0
+    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
+        fh.write(f"changed={'true' if changed else 'false'}\n")
+    if changed:
+        with open(os.environ["GITHUB_STEP_SUMMARY"], "ab") as fh:
+            fh.write(f"{HEADINGS[args.kind]}\n\n".encode() + report.read_bytes())
+    elif args.kind == "lockfile":
+        report.write_bytes(b"")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/ci/review_status.py b/scripts/ci/review_status.py
new file mode 100755
index 00000000000..1d0bf3bb8c6
--- /dev/null
+++ b/scripts/ci/review_status.py
@@ -0,0 +1,137 @@
+#!/usr/bin/env python3
+"""Publish a repository guard's review_status for the live PR comment.
+
+A review_status is a JSON list of ``{source, results: [...]}`` objects. A guard step publishes it
+as a ``review_status=<json>`` line in ``$GITHUB_OUTPUT`` and, for scripts/ci/live_comment.py, in
+``$RUNNER_TEMP/review-status/<artifact>/review-status.json``, which repo-guards.yml uploads as
+the ``review-status-<artifact>`` artifact.
+
+    python3 scripts/ci/review_status.py emit <check>              # see FINDINGS
+    python3 scripts/ci/review_status.py merge <artifact> ENV...   # concatenate env-held lists
+
+``emit`` publishes one ``action_required`` result, carrying the check's report file as its
+detail, when the check's flag variable is ``true``, and ``[]`` otherwise.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+
+
+def status_line(status: list[dict], *, compact: bool = True, ascii_only: bool = True) -> str:
+    """The ``review_status=`` line; ``compact=False`` keeps json.dumps' default ``", "`` spacing."""
+    separators = (",", ":") if compact else None
+    return f"review_status={json.dumps(status, separators=separators, ensure_ascii=ascii_only)}\n"
+
+
+def publish(status: list[dict], artifact: str | None = None, *, output: bool = True,
+            compact: bool = True, ascii_only: bool = True) -> None:
+    """Append the status to ``$GITHUB_OUTPUT`` and/or write it as the artifact's file."""
+    line = status_line(status, compact=compact, ascii_only=ascii_only)
+    if output:
+        with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
+            fh.write(line)
+    if artifact:
+        directory = Path(os.environ["RUNNER_TEMP"], "review-status", artifact)
+        directory.mkdir(parents=True, exist_ok=True)
+        (directory / "review-status.json").write_text(line, encoding="utf-8")
+
+
+def action_required(source: str, title: str, summary: str, how_to_fix: str,
+                    detail: str | None = None) -> list[dict]:
+    result = {"kind": "action_required", "title": title, "summary": summary}
+    if detail is not None:
+        result["detail"] = detail
+    result["how_to_fix"] = how_to_fix
+    return [{"source": source, "results": [result]}]
+
+
+@dataclass(frozen=True)
+class Finding:
+    flag_env: str  # set to "true" by the step that produced the report
+    report: str  # file under $RUNNER_TEMP; its text is the result's detail
+    artifact: str | None
+    source: str
+    title: str
+    summary: str
+    how_to_fix: str
+    compact: bool = False
+
+
+FINDINGS = {
+    "prompt-surface": Finding(
+        "CHANGED", "prompt-surface.md", "prompt-surface", "prompt-surface",
+        "Prompt surface changed",
+        "This PR changes the system prompt or tool schemas every session sends.",
+        "Read the rendered change below (full text under tests/fixtures/prompt_surface/ "
+        "in the Files tab). Merging needs a hermes-agent-core approval."),
+    "lockfile-diff": Finding(
+        "CHANGED", "lockfile-diff.md", "lockfile-diff", "lockfile-diff",
+        "JS lockfiles",
+        "Locked JS dependency versions changed.",
+        "Verify the version changes are expected. Lockfile changes need a hermes-agent-core review.",
+        compact=True),
+    # No artifact: the merge subcommand combines these two into the supply-chain artifact.
+    "supply-chain-scan": Finding(
+        "FOUND", "supply-chain-findings.md", None, "supply chain",
+        "Critical supply chain risk",
+        "Critical supply chain risk patterns detected in this PR.",
+        "Review the flagged code carefully. If it is a false positive, narrow the pattern in "
+        "scripts/ci/scan_supply_chain.py."),
+    "dependency-bounds": Finding(
+        "FOUND", "supply-chain-unbounded.txt", None, "supply chain",
+        "Unbounded PyPI dependencies",
+        "This PR adds PyPI dependencies without upper bounds.",
+        'Add a `<next_major` upper bound, e.g. `"package>=1.2.0,<2"`. '
+        "See CONTRIBUTING.md dependency pinning policy."),
+}
+
+
+def emit(check: str) -> None:
+    finding = FINDINGS[check]
+    status: list[dict] = []
+    if os.environ.get(finding.flag_env, "") == "true":
+        detail = Path(os.environ["RUNNER_TEMP"], finding.report).read_text(encoding="utf-8-sig")
+        status = action_required(finding.source, finding.title, finding.summary,
+                                 finding.how_to_fix, detail)
+    publish(status, finding.artifact, compact=finding.compact)
+
+
+def merge(artifact: str, env_names: list[str]) -> None:
+    """Concatenate the review_status lists held in env vars into the artifact file only."""
+    merged: list[dict] = []
+    for name in env_names:
+        raw = os.environ.get(name, "")
+        if not raw:
+            continue
+        try:
+            data = json.loads(raw)
+        except json.JSONDecodeError:
+            continue
+        if isinstance(data, list):
+            merged.extend(data)
+    publish(merged, artifact, output=False, compact=False)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Publish a repository guard's review_status.")
+    sub = parser.add_subparsers(dest="command", required=True)
+    sub.add_parser("emit").add_argument("check", choices=sorted(FINDINGS))
+    merge_parser = sub.add_parser("merge")
+    merge_parser.add_argument("artifact")
+    merge_parser.add_argument("env_names", nargs="+")
+    args = parser.parse_args(argv)
+    if args.command == "emit":
+        emit(args.check)
+    else:
+        merge(args.artifact, args.env_names)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/ci/scan_supply_chain.py b/scripts/ci/scan_supply_chain.py
new file mode 100755
index 00000000000..3d634750707
--- /dev/null
+++ b/scripts/ci/scan_supply_chain.py
@@ -0,0 +1,123 @@
+#!/usr/bin/env python3
+"""Scan a PR's added lines for critical supply-chain indicators and unbounded PyPI deps.
+
+Run by two steps of ``.github/workflows/repo-guards.yml`` on pull requests, with the PR's base
+and head commits in ``_HERMES_PR_BASE_SHA`` and ``_HERMES_PR_HEAD_SHA``. Each subcommand appends ``found=true|false`` to
+``$GITHUB_OUTPUT`` and, on a finding, writes the report that
+``scripts/ci/review_status.py emit`` publishes:
+
+    python3 scripts/ci/scan_supply_chain.py patterns            # $RUNNER_TEMP/supply-chain-findings.md
+    python3 scripts/ci/scan_supply_chain.py dependency-bounds   # $RUNNER_TEMP/supply-chain-unbounded.txt
+
+``patterns`` is a narrow, high-signal scanner: only critical indicators of supply chain attacks
+(the litellm-style payloads). Low-signal heuristics were removed on purpose because they fired
+on nearly every PR and trained reviewers to ignore the scanner; keep it ruthlessly narrow.
+Both diff base...head, from the merge base, so only changes this PR introduces are judged, not
+changes that landed on main after the PR branched off.
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+
+LOCKFILE_EXCLUDES = (":!uv.lock", ":!*.lock", ":!pnpm-lock.yaml", ":!yarn.lock")
+MAX_MATCHES = 10
+
+
+@dataclass(frozen=True)
+class Indicator:
+    heading: str
+    explanation: str
+    patterns: tuple[re.Pattern[str], ...]  # every pattern must match the added line
+
+
+INDICATORS = (
+    Indicator(
+        "### 🚨 CRITICAL: base64 decode + exec/eval combo",
+        "Base64-decoded strings passed directly to exec/eval — the signature of hidden "
+        "credential-stealing payloads.",
+        (re.compile(r"base64\.(b64decode|decodebytes|urlsafe_b64decode)", re.IGNORECASE),
+         re.compile(r"exec\(|eval\(", re.IGNORECASE)),
+    ),
+    Indicator(
+        "### 🚨 CRITICAL: subprocess with encoded/obfuscated command",
+        "Subprocess calls whose command strings are base64- or hex-encoded are a strong "
+        "indicator of payload execution.",
+        (re.compile(r"subprocess\.(Popen|call|run)\s*\("),
+         re.compile(r"base64|\\x[0-9a-f]{2}|chr\(", re.IGNORECASE)),
+    ),
+)
+
+# A dep spec with ``>=`` and no ``,<`` ceiling (the pattern cannot match one); git+ URLs (commit
+# SHAs) and comments never match.
+# The workflow's ERE spelled the extras group ``\[[^\]]*\]``; in a POSIX bracket the backslash is
+# literal, so that is one non-backslash character then ``]*``. Kept as is: an extras group matches
+# only when it holds one character (``"a[b]>=2"``, not ``"pkg[extra]>=1"``).
+UNBOUNDED_DEP = re.compile(r'"[a-zA-Z0-9_-]+(?:\[[^\\]\]*\])?>=[ 0-9.]+"')
+
+
+def pr_diff(*pathspec: str) -> str:
+    """Three-dot diff of the PR; a git failure yields an empty diff, as ``|| true`` did."""
+    commits = f"{os.environ['_HERMES_PR_BASE_SHA']}...{os.environ['_HERMES_PR_HEAD_SHA']}"
+    result = subprocess.run(("git", "diff", commits, "--", *pathspec), stdout=subprocess.PIPE,
+                            stdin=subprocess.DEVNULL, timeout=300, check=False)
+    return result.stdout.decode("utf-8", "surrogateescape")
+
+
+def numbered_added_lines(diff: str) -> list[str]:
+    """``grep -n '^+'`` over the diff."""
+    return [f"{number}:{line}" for number, line in enumerate(diff.split("\n"), 1)
+            if line.startswith("+")]
+
+
+def critical_findings(diff: str) -> str:
+    added = numbered_added_lines(diff)
+    findings = ""
+    for indicator in INDICATORS:
+        hits = [line for line in added if all(p.search(line) for p in indicator.patterns)]
+        if hits:
+            matches = "\n".join(hits[:MAX_MATCHES])
+            findings += (f"\n{indicator.heading}\n{indicator.explanation}\n\n**Matches:**\n"
+                         f"```\n{matches}\n```\n")
+    return findings
+
+
+def unbounded_dependencies(diff: str) -> list[str]:
+    added = [line for line in diff.split("\n") if line.startswith("+") and not line.startswith("+++")]
+    return [match for line in added for match in UNBOUNDED_DEP.findall(line)]
+
+
+def _set_found(found: bool) -> None:
+    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as fh:
+        fh.write(f"found={'true' if found else 'false'}\n")
+
+
+def _write_report(name: str, text: str) -> None:
+    Path(os.environ["RUNNER_TEMP"], name).write_text(text + "\n", encoding="utf-8",
+                                                     errors="surrogateescape")
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Scan a PR diff for supply-chain risks.")
+    parser.add_argument("scan", choices=("patterns", "dependency-bounds"))
+    args = parser.parse_args(argv)
+    if args.scan == "patterns":
+        report = critical_findings(pr_diff(".", *LOCKFILE_EXCLUDES))
+        report_name = "supply-chain-findings.md"
+    else:
+        report = "\n".join(unbounded_dependencies(pr_diff("pyproject.toml")))
+        report_name = "supply-chain-unbounded.txt"
+    _set_found(bool(report))
+    if report:
+        _write_report(report_name, report)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
