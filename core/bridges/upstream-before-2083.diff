new file mode 100644
index 00000000000..a446938a348
--- /dev/null
+++ b/scripts/ci/catalog_changed_entries.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+"""List the catalog entry files a plugin-catalog PR adds or changes, for the pinned-source gate.
+
+Runs on the ``pull_request`` merge commit: HEAD diffed against its first parent is exactly what
+the PR would land. Anything else is refused rather than silently diffing a single commit.
+
+Admission PRs must be data-only: the gate's own enforcement code (the workflow, the validator,
+the composite actions, the built hermes) resolves from the PR checkout, so an entry PR that also
+touches tooling could neuter the gate vetting it. Contributor email maps are data the gate never
+executes; README/policy/CI PRs with no entry change skip this check.
+
+Writes ``files`` (newline-separated entry paths, empty when none) to ``$GITHUB_OUTPUT``.
+Exit 0 = listed, 1 = not a merge commit or a non-data path in an entry PR, other = git failed.
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+
+_REMOVED_LIST = re.compile(r"/removed\.yaml$")
+_DATA_PATHS = re.compile(r"^(plugin-catalog|contributors/emails)/")
+
+
+_GIT_SECONDS = 900
+
+
+def _git_lines(*args: str) -> list[str]:
+    # git quotes unusual path bytes itself (core.quotePath), so its output is ASCII.
+    out = subprocess.run(["git", *args], stdout=subprocess.PIPE, encoding="utf-8", check=True,
+                         timeout=_GIT_SECONDS).stdout
+    return out.rstrip("\n").split("\n") if out.strip("\n") else []
+
+
+def changed_entries() -> list[str]:
+    # Added + modified + renamed + typechanged entry files only; deletions and removed.yaml have
+    # nothing to clone. A rename or file->symlink change that slipped past this list would skip
+    # the supply-chain gate.
+    changed = _git_lines("diff", "--name-only", "--diff-filter=AMRT", "HEAD^1", "HEAD",
+                         "--", "plugin-catalog/*.yaml", "plugin-catalog/*.yml")
+    return [path for path in changed if not _REMOVED_LIST.search(path)]
+
+
+def non_data_paths() -> list[str]:
+    return [path for path in _git_lines("diff", "--name-only", "HEAD^1", "HEAD")
+            if not _DATA_PATHS.search(path)]
+
+
+def main(argv: list[str] | None = None) -> int:
+    argparse.ArgumentParser(description="List the catalog entries a PR changes.").parse_args(argv)
+    merge = subprocess.run(["git", "rev-parse", "-q", "--verify", "HEAD^2"],
+                           stdout=subprocess.DEVNULL, check=False, timeout=_GIT_SECONDS)
+    if merge.returncode != 0:
+        print("::error::expected the pull_request merge commit as HEAD")
+        return 1
+    try:
+        changed = changed_entries()
+        outside = non_data_paths() if changed else []
+    except subprocess.CalledProcessError as exc:
+        return exc.returncode
+    if outside:
+        print("::error::catalog entry PRs may only touch plugin-catalog/** and "
+              "contributors/emails/**, found:")
+        # Filenames are PR-controlled; a newline in one could smuggle a workflow command into
+        # the log.
+        print(" ".join(outside))
+        return 1
+
+    listed = "\n".join(changed)
+    print("Changed catalog entries:")
+    print(listed or "<none>", flush=True)
+    with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8", newline="\n") as output:
+        output.write(f"files<<__EOF__\n{listed}\n__EOF__\n")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/ci/catalog_entry_fields.py b/scripts/ci/catalog_entry_fields.py
new file mode 100644
index 00000000000..f0badc163b7
--- /dev/null
+++ b/scripts/ci/catalog_entry_fields.py
@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+"""Read the PR-controlled clone source of one catalog entry and print it as one JSON object.
+
+Prints ``{"REPO": ..., "SHA": ..., "SUBDIR": ..., "ATTESTED": ..., "BAD": ...}``, every value a
+string (``ATTESTED`` is newline-separated). These fields are
+PR-controlled, so the entry is rejected here (non-empty ``BAD``) before anything uses them: the
+clone must be remote-only and the subdir a plain relative path, or the pinned sha ends up
+validating files outside the pinned commit. Run it with ``python3 -I``: cwd is the PR tree, and
+isolated mode keeps the PR checkout's own modules off ``sys.path`` so they cannot shadow this
+parser's imports. ruamel.yaml comes from installed packages.
+
+    catalog_entry_fields.py <entry.yaml>
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+
+from ruamel.yaml import YAML
+
+
+def _load(path: str) -> object:
+    try:
+        with open(path, encoding="utf-8") as fh:  # windows-footgun: ok — Linux CI, same codec as the structural validator
+            return YAML(typ="safe").load(fh)
+    except Exception:  # health: allow BLE001 -- every read or parse failure is the "unparseable" verdict
+        return None
+
+
+def _rejection(data: object, repo: str, sha: object, subdir_raw: object, subdir: str) -> str:
+    if data is None:
+        return "entry yaml is empty or unparseable"
+    if not isinstance(data, dict):
+        return "entry yaml must be a mapping"
+    if not re.fullmatch(r"https://\S+", repo):
+        # No whitespace either: the value is echoed into the log, where a newline would smuggle
+        # workflow commands like ::error::.
+        return "repo must be an https:// git URL"
+    if not isinstance(sha, str):
+        return "sha must be a string"
+    if not re.fullmatch(r"[0-9a-f]{40}", sha):
+        # A ref name would validate the branch tip, not the pin; a leading '-' would become a
+        # checkout option.
+        return "sha must be exactly 40 lowercase hex characters"
+    if not isinstance(subdir_raw, str):
+        # Never coerce: a falsy non-string (0, false) would silently mean the clone root while
+        # the structural gate rejects the entry.
+        return "subdir must be a string"
+    if subdir and (not re.fullmatch(r"[A-Za-z0-9._/-]+", subdir)
+                   or any(seg in ("", ".", "..") for seg in subdir.split("/"))):
+        return "subdir must be a relative path without '.' or '..' segments"
+    return ""
+
+
+def _attested(data: object) -> tuple[list[str], str]:
+    """The ``attested_binaries`` paths (README rule 17) and the rejection for a bad one.
+
+    Each is joined onto the clone and echoed into the log, so it must be a plain relative path:
+    no absolute path, no '.' or '..' segment, no whitespace.
+    """
+    paths = data.get("attested_binaries") if isinstance(data, dict) else None
+    if not isinstance(paths, list):
+        return [], ""
+    for path in paths:
+        if not (isinstance(path, str) and re.fullmatch(r"[A-Za-z0-9._/-]+", path)
+                and not any(seg in ("", ".", "..") for seg in path.split("/"))):
+            return [], f"attested_binaries entry {path!r} is not a plain relative path"
+    return paths, ""
+
+
+def source_fields(data: object) -> dict[str, str]:
+    """REPO, SHA, SUBDIR, ATTESTED and the BAD verdict for a parsed entry."""
+    mapping = data if isinstance(data, dict) else {}
+    repo = str(mapping.get("repo", ""))
+    sha = mapping.get("sha", "")
+    subdir_raw = mapping.get("subdir", "")
+    if subdir_raw is None:
+        subdir_raw = ""  # `subdir:` with no value means the repo root
+    subdir = subdir_raw if isinstance(subdir_raw, str) else ""
+    attested, attested_bad = _attested(data)
+    bad = _rejection(data, repo, sha, subdir_raw, subdir) or attested_bad
+    return {"REPO": repo, "SHA": str(sha), "SUBDIR": subdir, "ATTESTED": "\n".join(attested),
+            "BAD": bad}
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Print a catalog entry's clone source.")
+    parser.add_argument("entry")
+    args = parser.parse_args(argv)
+    print(json.dumps(source_fields(_load(args.entry))))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
