+        return None
+    base = Path(root).expanduser()
+    rest = parts[token_at + 1:]
+    for candidate in (base.joinpath(parts[token_at], *rest), base.joinpath(*rest)):
+        if candidate.is_file():
+            return candidate
+    return None
