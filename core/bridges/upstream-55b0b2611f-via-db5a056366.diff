diff --git a/tests/gateway/test_silent_turn_stops_typing.py b/tests/gateway/test_silent_turn_stops_typing.py
new file mode 100644
index 0000000000..1e74259e49
--- /dev/null
+++ b/tests/gateway/test_silent_turn_stops_typing.py
@@ -0,0 +1,155 @@
+"""A turn that ends in intentional silence stops "typing" when the agent returns (#149948).
+
+The adapter's keep-alive refreshes typing until the message handler returns. A silent turn sends
+nothing that would end it, so the work after the agent finished (agent:end hooks, transcript
+persistence) kept the chat showing "typing" for a reply that never comes.
+"""
+
+import asyncio
+from unittest.mock import AsyncMock
+
+import pytest
+
+from gateway.config import Platform, PlatformConfig
+from gateway.platforms.base import BasePlatformAdapter
+from tests.gateway.test_gateway_silence_tokens import _event, _runner, _source
+from tests.waiting import async_wait_until
+
+KEY = "agent:main:telegram:group:-1001:12345"
+
+
+class _CountingPaused(set):
+    """``_typing_paused`` that counts the keep-alive's per-tick membership checks while ``armed``,
+    so the test waits on keep-alive iterations, not on wall-clock time."""
+
+    armed = False
+    checks = 0
+
+    def __contains__(self, item):
+        if self.armed:
+            self.checks += 1
+        return super().__contains__(item)
+
+
+class _Adapter(BasePlatformAdapter):
+    async def connect(self, *, is_reconnect: bool = False):
+        return True
+
+    async def disconnect(self):
+        pass
+
+    async def send(self, chat_id, content, reply_to=None, metadata=None):
+        return None
+
+    async def get_chat_info(self, chat_id):
+        return {}
+
+
+def _result(text):
+    return {"final_response": text, "failed": False, "api_calls": 1, "tools": [], "history_offset": 0,
+            "last_prompt_tokens": 0, "messages": [{"role": "user", "content": "side chatter"},
+                                                  {"role": "assistant", "content": text}]}
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("answer,typing_after_agent", [("[SILENT]", False), ("A real reply.", True)],
+                         ids=["silent-turn", "control-reply"])
+async def test_typing_stops_once_a_silent_turn_returns(monkeypatch, tmp_path, answer, typing_after_agent):
+    runner = _runner(monkeypatch, tmp_path)
+    adapter = _Adapter(PlatformConfig(enabled=True, token="t"), Platform.TELEGRAM)
+    adapter.gateway_runner = runner
+    runner._delivery_adapter_for = lambda _source: adapter
+    adapter._typing_paused = paused = _CountingPaused(adapter._typing_paused)
+    keep_typing = adapter._keep_typing
+    adapter._keep_typing = lambda chat_id, **kw: keep_typing(chat_id, interval=0.05, **kw)  # fast ticks
+    ticks, in_hook, release_hook, release_agent = [], asyncio.Event(), asyncio.Event(), asyncio.Event()
+
+    async def send_typing(chat_id, metadata=None):
+        ticks.append("hook" if in_hook.is_set() else "agent")
+
+    adapter.send_typing = send_typing
+
+    async def run_agent(**_kwargs):
+        await release_agent.wait()  # the agent works until the keep-alive has ticked
+        return _result(answer)
+
+    async def agent_end_hook(event_type, _ctx):
+        if event_type == "agent:end":  # post-agent work: nothing more will be shown
+            in_hook.set()
+            await release_hook.wait()
+
+    runner._run_agent = AsyncMock(side_effect=run_agent)
+    runner.hooks.emit = AsyncMock(side_effect=agent_end_hook)
+    adapter._message_handler = lambda ev: runner._handle_message_with_agent(ev, _source(), KEY, 1)
+    adapter._active_sessions[KEY] = asyncio.Event()
+    turn = asyncio.create_task(adapter._process_message_background(_event(reply_expected=False), KEY))
+
+    await async_wait_until(lambda: ticks.count("agent") >= 2, what="typing while the agent works", timeout=10)
+    release_agent.set()
+    await async_wait_until(in_hook.is_set, what="the agent:end hook to start", timeout=10)
+    paused.armed = True  # the keep-alive gets three full iterations while the hook runs
+    await async_wait_until(lambda: paused.checks >= 6, what="keep-alive iterations during the hook", timeout=10)
+    release_hook.set()
+    await asyncio.wait_for(turn, 10)
+
+    assert (ticks.count("hook") > 0) is typing_after_agent
+    assert "-1001" not in adapter._typing_paused  # the turn's finally lifted the pause
+
+
+@pytest.mark.asyncio
+async def test_a_silent_topic_leaves_another_topics_typing_on(monkeypatch, tmp_path):
+    """The pause is the silent turn's own: a second forum topic of the same chat whose agent is
+    still working keeps refreshing "typing" while the silent turn runs its hooks."""
+    runner = _runner(monkeypatch, tmp_path)
+    adapter = _Adapter(PlatformConfig(enabled=True, token="t"), Platform.TELEGRAM)
+    adapter.gateway_runner = runner
+    runner._delivery_adapter_for = lambda _source: adapter
+    adapter._typing_paused = paused = _CountingPaused(adapter._typing_paused)
+    keep_typing = adapter._keep_typing
+    adapter._keep_typing = lambda chat_id, **kw: keep_typing(chat_id, interval=0.05, **kw)
+    ticks, in_hook, release_hook, release_agent = [], asyncio.Event(), asyncio.Event(), asyncio.Event()
+
+    async def send_typing(chat_id, metadata=None):
+        if in_hook.is_set():
+            ticks.append((metadata or {}).get("thread_id"))
+
+    adapter.send_typing = send_typing
+
+    async def run_agent(**_kwargs):
+        await release_agent.wait()
+        return _result("[SILENT]")
+
+    async def agent_end_hook(event_type, _ctx):
+        if event_type == "agent:end":
+            in_hook.set()
+            await release_hook.wait()
+
+    runner._run_agent = AsyncMock(side_effect=run_agent)
+    runner.hooks.emit = AsyncMock(side_effect=agent_end_hook)
+    working_done = asyncio.Event()
+
+    async def handler(ev):
+        if ev.source.thread_id == "working":
+            await working_done.wait()
+            return None
+        return await runner._handle_message_with_agent(ev, ev.source, KEY, 1)
+
+    adapter._message_handler = handler
+    silent, working = _event(reply_expected=False), _event(reply_expected=True)
+    silent.source.thread_id, working.source.thread_id = "silent", "working"
+    adapter._active_sessions[KEY] = asyncio.Event()
+    adapter._active_sessions[KEY + ":working"] = asyncio.Event()
+    other = asyncio.create_task(adapter._process_message_background(working, KEY + ":working"))
+    turn = asyncio.create_task(adapter._process_message_background(silent, KEY))
+    try:
+        release_agent.set()
+        await async_wait_until(in_hook.is_set, what="the silent turn's agent:end hook", timeout=10)
+        paused.armed = True
+        await async_wait_until(lambda: paused.checks >= 8, what="both loops checking the pause", timeout=10)
+        assert "working" in ticks and "silent" not in ticks
+    finally:
+        release_hook.set()
+        await asyncio.wait_for(turn, 10)
+        working_done.set()
+        await asyncio.wait_for(other, 10)
+    assert not adapter._typing_paused  # both turns' finally lifted their pauses
diff --git a/tests/gateway/test_stream_consumer_native_draft.py b/tests/gateway/test_stream_consumer_native_draft.py
new file mode 100644
index 0000000000..a8881cd691
--- /dev/null
+++ b/tests/gateway/test_stream_consumer_native_draft.py
@@ -0,0 +1,163 @@
+"""Animated draft previews coalesce deltas without rewriting already shown text."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.platforms.base import BasePlatformAdapter, SendResult
+from gateway.stream_consumer import GatewayStreamConsumer, StreamConsumerConfig
+
+
+class AnimatedDraftAdapter(BasePlatformAdapter):
+    DRAFT_STREAM_PREFIX_STABLE = True
+
+    async def connect(self):
+        return True
+
+    async def disconnect(self):
+        pass
+
+    def supports_draft_streaming(self, chat_type=None, metadata=None, **kwargs):
+        return chat_type == "dm"
+
+    async def send_draft(self, chat_id, draft_id, content, metadata=None):
+        self.drafts.append((draft_id, content))
+        return self.draft_results.pop(0) if self.draft_results else SendResult(success=True)
+
+    async def send(self, chat_id, content, reply_to=None, metadata=None):
+        self.messages.append(content)
+        return SendResult(success=True, message_id=str(len(self.messages)))
+
+    async def edit_message(self, chat_id, message_id, content, **kwargs):
+        self.messages.append(content)
+        return SendResult(success=True, message_id=message_id)
+
+    async def send_typing(self, chat_id, metadata=None):
+        pass
+
+    async def get_chat_info(self, chat_id):
+        return {"type": "dm"}
+
+
+def make_consumer(monkeypatch, *, cursor="", edit_interval=0.8):
+    adapter = AnimatedDraftAdapter.__new__(AnimatedDraftAdapter)
+    adapter.drafts = []
+    adapter.draft_results = []
+    adapter.messages = []
+    clock = SimpleNamespace(now=100.0)
+    fake_time = SimpleNamespace(monotonic=lambda: clock.now)
+    monkeypatch.setattr("gateway.stream_consumer.time", fake_time)
+    monkeypatch.setattr("gateway.stream_consumer_transport.time", fake_time)
+    consumer = GatewayStreamConsumer(
+        adapter, "123", StreamConsumerConfig(
+            transport="draft", chat_type="dm", edit_interval=edit_interval,
+            buffer_threshold=4, cursor=cursor,
+        ),
+    )
+    return consumer, adapter, clock
+
+
+async def push_delta(consumer, text):
+    consumer.on_delta(text)
+    tick = consumer._drain_queue()
+    if consumer._should_edit(tick):
+        await consumer._push_update(tick)
+
+
+@pytest.mark.asyncio
+async def test_native_drafts_coalesce_fast_deltas_and_publish_latest_snapshot(monkeypatch):
+    consumer, adapter, clock = make_consumer(monkeypatch)
+    await consumer._start_transports()
+
+    await push_delta(consumer, "首个回复")
+    for delta in ("，", "接", "着", "输", "出"):
+        clock.now += 0.05
+        await push_delta(consumer, delta)
+    assert [text for _, text in adapter.drafts] == ["首个回复"]
+
+    clock.now = 100.81
+    await push_delta(consumer, "。")
+    assert [text for _, text in adapter.drafts] == ["首个回复", "首个回复，接着输出。"]
+    assert len({draft_id for draft_id, _ in adapter.drafts}) == 1
+
+
+@pytest.mark.asyncio
+async def test_native_draft_code_prefix_has_no_synthetic_fence_or_cursor(monkeypatch):
+    consumer, adapter, clock = make_consumer(monkeypatch, cursor="▉")
+    await consumer._start_transports()
+
+    await push_delta(consumer, "代码：\n```python\nprint(")
+    clock.now += 0.81
+    await push_delta(consumer, "'hello')\n```")
+
+    frames = [text for _, text in adapter.drafts]
+    assert frames == ["代码：\n```python\nprint(", "代码：\n```python\nprint('hello')\n```"]
+    assert frames[1].startswith(frames[0])
+
+
+@pytest.mark.asyncio
+async def test_skipped_draft_retries_latest_snapshot_without_claiming_delivery(monkeypatch):
+    consumer, adapter, clock = make_consumer(monkeypatch)
+    await consumer._start_transports()
+    adapter.draft_results = [SendResult(success=True, raw_response={"skipped": True})]
+
+    await push_delta(consumer, "首个回复")
+    assert consumer._last_sent_text == ""
+    assert consumer.already_sent is False
+    assert consumer._use_draft_streaming is True
+    assert adapter.messages == []
+
+    clock.now += 0.81
+    await push_delta(consumer, "，后续内容")
+    assert consumer._last_sent_text == "首个回复，后续内容"
+    assert adapter.drafts[-1][1] == "首个回复，后续内容"
+    assert len({draft_id for draft_id, _ in adapter.drafts}) == 1
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("success", [False, True])
+async def test_draft_cooldown_keeps_preview_transport_and_full_final_is_immediate(
+    monkeypatch, success,
+):
+    consumer, adapter, clock = make_consumer(monkeypatch)
+    await consumer._start_transports()
+    adapter.draft_results = [SendResult(
+        success=success, error=None if success else "flood_control:9", retry_after=9,
+        raw_response={"skipped": True} if success else None,
+    )]
+
+    await push_delta(consumer, "首个回复")
+    clock.now += 1.0
+    await push_delta(consumer, "，新内容")
+    assert len(adapter.drafts) == 1
+    assert consumer._use_draft_streaming is True
+    assert consumer._last_sent_text == ""
+    assert adapter.messages == []
+
+    # Completion bypasses preview cooldown and carries post-stream augmentation.
+    final_text = "首个回复，新内容。\n\n完整的最终结论。"
+    consumer.finish(final_text)
+    tick = consumer._drain_queue()
+    await consumer._push_update(tick)
+    await consumer._finalize_turn(tick)
+    assert adapter.messages == [final_text]
+    assert consumer.delivered_final_matches(final_text) is True
+
+
+@pytest.mark.asyncio
+async def test_draft_resumes_after_cooldown_with_latest_accumulated_text(monkeypatch):
+    consumer, adapter, clock = make_consumer(monkeypatch)
+    await consumer._start_transports()
+    adapter.draft_results = [SendResult(
+        success=True, retry_after=9, raw_response={"skipped": True},
+    )]
+
+    await push_delta(consumer, "首个回复")
+    clock.now += 1.0
+    await push_delta(consumer, "，新内容")
+    clock.now += 8.1
+    await push_delta(consumer, "。")
+
+    assert [text for _, text in adapter.drafts] == ["首个回复", "首个回复，新内容。"]
+    assert consumer._last_sent_text == "首个回复，新内容。"
+    assert adapter.messages == []
diff --git a/tests/gateway/test_stream_flood_frozen_preview.py b/tests/gateway/test_stream_flood_frozen_preview.py
new file mode 100644
index 0000000000..91b10b7d29
--- /dev/null
+++ b/tests/gateway/test_stream_flood_frozen_preview.py
@@ -0,0 +1,264 @@
+"""A streamed reply whose final edit AND fallback send were flood-refused is finished in place.
+
+Telegram refuses the finalize edit and the continuation send with a RetryAfter longer than the
+adapter's inline cap. Before: the consumer dropped the preview id, every delivery flag stayed unset
+and the gateway's plain final send posted the whole answer again beside the frozen preview. Now the
+consumer keeps the preview id and the gateway edits that preview up to the complete answer once the
+flood window passes: one message, complete.
+"""
+
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.platforms.base import SendResult
+from gateway.run_turn import GatewayTurnMixin
+from gateway.stream_consumer import GatewayStreamConsumer, StreamConsumerConfig
+from tests.waiting import async_wait_until
+
+
+class _Harness(GatewayTurnMixin):
+    """Only the delivery decision under test; the real consumer and predicate run."""
+
+
+class _FloodedChat:
+    """One chat whose edits and sends are flood-refused until ``open_at`` (loop time)."""
+
+    MAX_MESSAGE_LENGTH = 4096
+    FALLBACK_ON_FINAL_EDIT_FLOOD = True  # Telegram's: a flood-refused final edit falls back at once
+
+    def __init__(self, flood_secs: float) -> None:
+        self.flood_secs = flood_secs
+        self.open_at: float = float("inf")
+        self.armed = False
+        self.messages: dict[str, str] = {}
+        self.calls: list[tuple[str, str]] = []
+
+    def _flooded(self) -> bool:
+        return self.armed and asyncio.get_running_loop().time() < self.open_at
+
+    def _refuse(self) -> SendResult:
+        return SendResult(success=False, error=f"flood_control:{self.flood_secs}", retry_after=self.flood_secs)
+
+    async def send(self, chat_id, content, reply_to=None, metadata=None):
+        self.calls.append(("send", content))
+        if self._flooded():
+            return self._refuse()
+        mid = str(len(self.messages) + 1)
+        self.messages[mid] = content
+        return SendResult(success=True, message_id=mid)
+
+    async def edit_message(self, chat_id, message_id, content, *, finalize=False, **_kw):
+        self.calls.append(("edit", content))
+        if not self.armed:  # the first edit arms the flood window
+            self.armed, self.open_at = True, asyncio.get_running_loop().time() + self.flood_secs
+        if self._flooded():
+            return self._refuse()
+        self.messages[message_id] = content
+        return SendResult(success=True, message_id=message_id)
+
+    async def delete_message(self, chat_id, message_id):
+        self.messages.pop(message_id, None)
+        return True
+
+
+async def _flood_frozen_turn(adapter: _FloodedChat, final: str):
+    consumer = GatewayStreamConsumer(adapter, "chat-1", StreamConsumerConfig(
+        edit_interval=0.01, buffer_threshold=5, cursor=" ▉"))
+    # The adapter fails a RetryAfter past its inline cap closed; the consumer's own bounded retry
+    # (5 s) must not out-wait it, as with Telegram's real 18-35 s edit penalties.
+    consumer._max_fallback_flood_retry_seconds = adapter.flood_secs / 2
+    task = asyncio.create_task(consumer.run())
+    consumer.on_delta(final[:20])
+    await async_wait_until(lambda: adapter.messages, timeout=5, what="first preview sent")
+    consumer.on_delta(final[20:])
+    await async_wait_until(lambda: adapter.armed, timeout=5, what="preview edit flood-refused")
+    consumer.finish(final)
+    await asyncio.wait_for(task, timeout=5)
+    return consumer
+
+
+@pytest.mark.asyncio
+async def test_flood_frozen_preview_is_finished_in_place_not_sent_twice(monkeypatch):
+    monkeypatch.setattr("gateway.run_turn_final_reconcile._FLOOD_WAIT_SLACK_SECS", 0.05)
+    adapter = _FloodedChat(flood_secs=0.6)  # long enough to outlast the consumer's own retries
+    final = "The answer begins here and then " + "continues with more words " * 8 + "until the end."
+    consumer = await _flood_frozen_turn(adapter, final)
+    assert not consumer.final_response_sent and not consumer.final_content_delivered
+
+    response = {"final_response": final}
+    turn_ctx = SimpleNamespace(stream_consumer_holder=[consumer], source=SimpleNamespace(chat_id="chat-1"),
+                               session_key="agent:main:telegram:group:chat-1")
+    await asyncio.wait_for(_Harness()._run_agent_mark_streamed_delivery(response, turn_ctx), timeout=5)
+
+    assert response.get("already_sent") is True  # the gateway's normal final send stays off
+    assert list(adapter.messages.values()) == [final]  # ONE message, complete, no cursor
+
+
+@pytest.mark.asyncio
+async def test_preview_still_flooded_past_the_retry_leaves_the_normal_send(monkeypatch):
+    """A window that outlasts the bounded wait is not a delivery: ``already_sent`` stays unset so
+    the normal ledgered final send (and its redelivery) still owns the answer."""
+    monkeypatch.setattr("gateway.run_turn_final_reconcile._FLOOD_WAIT_SLACK_SECS", 0.0)
+    monkeypatch.setattr("gateway.run_turn_final_reconcile._MAX_FLOOD_WAITS", 1)
+    adapter = _FloodedChat(flood_secs=0.6)
+    final = "Short answer that is long enough to stream in two pieces."
+    consumer = await _flood_frozen_turn(adapter, final)
+    adapter.open_at += 30  # Telegram extends the penalty
+
+    response = {"final_response": final}
+    turn_ctx = SimpleNamespace(stream_consumer_holder=[consumer], source=SimpleNamespace(chat_id="chat-1"),
+                               session_key="agent:main:telegram:group:chat-1")
+    await asyncio.wait_for(_Harness()._run_agent_mark_streamed_delivery(response, turn_ctx), timeout=5)
+
+    assert "already_sent" not in response
+
+
+@pytest.mark.asyncio
+async def test_consumer_cancelled_mid_final_leaves_one_complete_message():
+    """The turn's 5 s flush bound cancels a consumer stuck in its final edit (#53449): the delivery
+    flags stay unset while the preview is on screen. The gateway finishes that preview in place."""
+    gate = asyncio.Event()
+
+    class _StuckFinal(_FloodedChat):
+        async def edit_message(self, chat_id, message_id, content, *, finalize=False, **_kw):
+            self.calls.append(("edit", content))
+            if finalize and not gate.is_set():
+                gate.set()
+                await asyncio.Event().wait()  # the final edit never returns
+            if finalize and len([c for c in self.calls if c[0] == "edit"]) == 2:
+                return self._refuse()  # the cancel handler's best-effort edit fails too
+            self.messages[message_id] = content
+            return SendResult(success=True, message_id=message_id)
+
+    adapter = _StuckFinal(flood_secs=0.0)
+    final = "A medium answer that streams in two parts and is then completed."
+    consumer = GatewayStreamConsumer(adapter, "chat-1", StreamConsumerConfig(
+        edit_interval=0.01, buffer_threshold=5, cursor=" ▉"))
+    task = asyncio.create_task(consumer.run())
+    consumer.on_delta(final[:25])
+    await async_wait_until(lambda: adapter.messages, timeout=5, what="first preview sent")
+    consumer.finish(final)
+    await asyncio.wait_for(gate.wait(), timeout=5)
+    task.cancel()  # what the turn's bounded flush (``_await_stream_task``) does on its timeout
+    await asyncio.gather(task, return_exceptions=True)
+    assert not consumer.final_response_sent and consumer.message_id == "1"
+
+    response = {"final_response": final}
+    turn_ctx = SimpleNamespace(stream_consumer_holder=[consumer], source=SimpleNamespace(chat_id="chat-1"),
+                               session_key="agent:main:telegram:dm:chat-1")
+    await asyncio.wait_for(_Harness()._run_agent_mark_streamed_delivery(response, turn_ctx), timeout=5)
+
+    assert response.get("already_sent") is True
+    assert list(adapter.messages.values()) == [final]
+
+
+@pytest.mark.asyncio
+async def test_turn_replaced_during_the_flood_wait_publishes_nothing(monkeypatch):
+    """``/new`` or ``/stop`` during the flood wait: the old answer is neither edited in nor sent."""
+    monkeypatch.setattr("gateway.run_turn_final_reconcile._FLOOD_WAIT_SLACK_SECS", 0.05)
+    adapter = _FloodedChat(flood_secs=0.6)
+    final = "The answer begins here and then " + "continues with more words " * 8 + "until the end."
+    consumer = await _flood_frozen_turn(adapter, final)
+    current = {"run": True}
+    consumer._run_still_current = lambda: current["run"]
+    frozen = dict(adapter.messages)
+
+    async def reset_mid_wait():
+        await async_wait_until(lambda: adapter.calls[-1][0] == "edit" and adapter._flooded(), timeout=5)
+        current["run"] = False
+
+    response = {"final_response": final}
+    turn_ctx = SimpleNamespace(stream_consumer_holder=[consumer], source=SimpleNamespace(chat_id="chat-1"),
+                               session_key="agent:main:telegram:group:chat-1")
+    await asyncio.wait_for(asyncio.gather(
+        _Harness()._run_agent_mark_streamed_delivery(response, turn_ctx), reset_mid_wait()), timeout=5)
+
+    assert adapter.messages == frozen  # nothing published after the reset
+    assert "already_sent" not in response  # the outer stale-run check discards the result
+
+
+@pytest.mark.asyncio
+async def test_finishing_edit_carries_the_topic_routing_metadata():
+    """A split's continuations are sent by the edit path: without the turn's routing metadata a
+    retried continuation lands outside the topic."""
+    seen = []
+
+    class _Topic(_FloodedChat):
+        async def edit_message(self, chat_id, message_id, content, *, finalize=False, metadata=None):
+            seen.append(metadata)
+            return await super().edit_message(chat_id, message_id, content, finalize=finalize)
+
+    adapter = _Topic(flood_secs=0.0)
+    from gateway.run_turn_final_reconcile import edit_preview_to_final
+    await edit_preview_to_final(adapter, "chat-1", "1", "answer", {"thread_id": "77"})
+    assert seen == [{"thread_id": "77"}]
+
+
+@pytest.mark.asyncio
+async def test_an_edit_that_would_truncate_leaves_the_normal_send():
+    """Google Chat, Slack and DingTalk cut an oversized edit short and still report success: a
+    reply longer than one message is never "finished in place" there, the normal send owns it."""
+    gate = asyncio.Event()
+
+    class _TruncatingEdit(_FloodedChat):
+        MAX_MESSAGE_LENGTH = 4000
+
+        async def edit_message(self, chat_id, message_id, content, *, finalize=False, **_kw):
+            self.calls.append(("edit", content))
+            if finalize and not gate.is_set():
+                gate.set()
+                await asyncio.Event().wait()  # stuck final edit: the turn's flush cancels the consumer
+            if finalize and len([c for c in self.calls if c[0] == "edit"]) == 2:
+                return self._refuse()  # the cancel handler's best-effort edit fails too
+            self.messages[message_id] = content[:3999] + "…" if len(content) > 4000 else content
+            return SendResult(success=True, message_id=message_id)
+
+    adapter = _TruncatingEdit(flood_secs=0.0)
+    final = "START " + "word " * 1500 + " END-OF-ANSWER"
+    consumer = GatewayStreamConsumer(adapter, "chat-1", StreamConsumerConfig(
+        edit_interval=0.01, buffer_threshold=5, cursor=" ▉"))
+    task = asyncio.create_task(consumer.run())
+    consumer.on_delta(final[:30])
+    await async_wait_until(lambda: adapter.messages, timeout=5, what="first preview sent")
+    consumer.finish(final)
+    await asyncio.wait_for(gate.wait(), timeout=5)
+    task.cancel()
+    await asyncio.gather(task, return_exceptions=True)
+
+    response = {"final_response": final}
+    turn_ctx = SimpleNamespace(stream_consumer_holder=[consumer], source=SimpleNamespace(chat_id="chat-1"),
+                               session_key="agent:main:googlechat:dm:chat-1")
+    await asyncio.wait_for(_Harness()._run_agent_mark_streamed_delivery(response, turn_ctx), timeout=5)
+
+    assert "already_sent" not in response
+    assert len([c for c in adapter.calls if c[0] == "edit"]) == 2  # no cut-short finishing edit was tried
+
+
+def test_slack_measures_the_formatted_text_its_edit_cuts():
+    """Slack escapes ``& < >`` before ``chat.update`` keeps one 39k chunk: a raw reply under the
+    limit that formats past it is never finished in place, where its tail would be lost."""
+    from gateway.config import PlatformConfig
+    from gateway.run_turn_final_reconcile import owns_reconcilable_preview
+    from plugins.platforms.slack.adapter import SlackAdapter
+
+    slack = SlackAdapter(PlatformConfig(enabled=True, token="xoxb-fake"))
+    preview = SimpleNamespace(message_id="1700000000.000100", adapter=slack)
+    heavy = ("a & b < c > d " * 3000)[:38990]
+    assert len(heavy) < slack.MAX_MESSAGE_LENGTH < len(slack.format_message(heavy))
+    assert not owns_reconcilable_preview(preview, "C1", heavy)
+    assert owns_reconcilable_preview(preview, "C1", "a & b < c " * 100)
+
+
+@pytest.mark.asyncio
+async def test_a_replaced_turn_and_a_receiptless_edit_are_distinguishable():
+    """The queued lane drops the reply only for a replaced turn; an edit with no receipt is not that."""
+    from gateway.run_turn_final_reconcile import TURN_REPLACED, edit_preview_to_final
+
+    class _NoReceipt:
+        async def edit_message(self, chat_id, message_id, content, *, finalize=False):
+            return None
+
+    assert await edit_preview_to_final(_NoReceipt(), "c", "1", "a", still_current=lambda: False) is TURN_REPLACED
+    assert await edit_preview_to_final(_NoReceipt(), "c", "1", "a") is not TURN_REPLACED
diff --git a/tests/gateway/test_streamed_media_notify_metadata.py b/tests/gateway/test_streamed_media_notify_metadata.py
new file mode 100644
index 0000000000..7517a138f7
--- /dev/null
+++ b/tests/gateway/test_streamed_media_notify_metadata.py
@@ -0,0 +1,71 @@
+"""A streamed turn's post-stream MEDIA delivery notifies like the non-streamed path (#144897).
+
+The non-streamed chain marks its final content — text and attachments — with
+``_mark_notify_metadata`` (``gateway/platforms/base.py``), so in ``important`` notification
+mode the attachments ring. The streamed chain handed ``_deliver_media_from_response`` no
+metadata at all: the function fell back to plain thread metadata, and every post-stream
+``send_voice`` / ``send_document`` / image batch went out silent — a voice-only streamed
+reply in ``important`` mode made no sound at all.
+"""
+
+import pytest
+
+from gateway.config import Platform
+from gateway.platforms.base import SendResult
+from gateway.platforms.event import MessageEvent, MessageType, SessionSource
+from gateway.run import GatewayRunner
+from tests.gateway.test_run_progress_topics import ProgressCaptureAdapter, _make_runner
+
+_SESSION_KEY = "agent:main:telegram:group:-1001:17585"
+
+
+class _VoiceCaptureAdapter(ProgressCaptureAdapter):
+    """Capture voice uploads so the metadata handed to send_voice is visible."""
+
+    def __init__(self):
+        super().__init__(platform=Platform.TELEGRAM)
+        self.voices = []
+
+    async def send_voice(self, chat_id, audio_path, caption=None, reply_to=None,
+                         metadata=None, is_voice=True, **kwargs) -> SendResult:
+        self.voices.append({"path": audio_path, "metadata": metadata})
+        return SendResult(success=True, message_id="voice-1")
+
+
+async def _streamed_completion_seam(adapter, response):
+    """Run an already-streamed result through ``_hmwa_deliver_turn_response`` — the seam that
+    uploads the streamed reply's trailing MEDIA: files."""
+    runner = _make_runner(adapter)
+    source = SessionSource(
+        platform=adapter.platform, chat_id="-1001", chat_type="group", thread_id="17585",
+    )
+    event = MessageEvent(text="hi", message_type=MessageType.TEXT, source=source, message_id="1")
+
+    class _Entry:
+        session_id = "s1"
+
+    agent_result = {"already_sent": True}
+    return await runner._hmwa_deliver_turn_response(
+        event, source, _Entry(), _SESSION_KEY, None, agent_result, [], response, None, False,
+    )
+
+
+@pytest.mark.asyncio
+async def test_streamed_media_delivery_carries_notify_metadata(tmp_path, monkeypatch):
+    """In ``important`` notification mode the media completing a streamed turn must ring:
+    the post-stream send carries notify metadata like the non-streamed attachments do."""
+    from gateway.platforms import base as platforms_base
+
+    voice = tmp_path / "note.ogg"
+    voice.write_bytes(b"ogg")
+    monkeypatch.setattr(platforms_base, "MEDIA_DELIVERY_SAFE_ROOTS", (tmp_path,))
+    adapter = _VoiceCaptureAdapter()
+
+    result = await _streamed_completion_seam(
+        adapter, f"here you go\n\nMEDIA: {voice} [[audio_as_voice]]")
+
+    assert result is None  # the streamed body is not re-sent
+    assert len(adapter.voices) == 1
+    metadata = adapter.voices[0]["metadata"] or {}
+    assert metadata.get("notify") is True
+
diff --git a/tests/gateway/test_streamed_reasoning_trailing.py b/tests/gateway/test_streamed_reasoning_trailing.py
new file mode 100644
index 0000000000..c8f1f9a6e3
--- /dev/null
+++ b/tests/gateway/test_streamed_reasoning_trailing.py
@@ -0,0 +1,114 @@
+"""show_reasoning on a streamed reply (#7251).
+
+With streaming on, the answer reaches the chat through the stream consumer, and the gateway's own
+final send is skipped (``already_sent``). The reasoning block that ``show_reasoning`` prepends to
+the final response only ever rode that skipped send, so a streamed reply never showed it. It now
+follows the streamed answer as its own message.
+"""
+
+import pytest
+
+from gateway.config import Platform
+from gateway.platforms.event import MessageEvent, MessageType, SessionSource
+from tests.gateway.test_run_progress_topics import ProgressCaptureAdapter, _make_runner
+
+
+async def _deliver(monkeypatch, *, show_reasoning: bool, already_sent: bool, is_bot: bool = False,
+                   uncertain: bool = False, ledger=None, saved: bool = True):
+    import gateway.run as gateway_run
+
+    monkeypatch.setattr(gateway_run, "_load_gateway_config",
+                        lambda: {"display": {"show_reasoning": show_reasoning}})
+    adapter = ProgressCaptureAdapter(platform=Platform.TELEGRAM)
+    if ledger is not None:
+        async def _ledger(event, session_key, response, *, error=None, **_kw):
+            ledger.append(response)
+            return saved
+
+        adapter.ledger_attempted_final = _ledger
+    runner = _make_runner(adapter)
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="42", chat_type="dm", is_bot=is_bot)
+    event = MessageEvent(text="hi", message_type=MessageType.TEXT, source=source, message_id="1")
+    result = {"final_response": "the answer is 42", "last_reasoning": "thinking hard about it",
+              "already_sent": already_sent}
+    if uncertain:
+        result["delivery_uncertain"] = True
+    response = runner._hmwa_prepend_reasoning(result, "the answer is 42", source, False)
+
+    class _Entry:
+        session_id = "s1"
+
+    returned = await runner._hmwa_deliver_turn_response(
+        event, source, _Entry(), "agent:main:telegram:dm:42", None, result, [], response, None, False)
+    return adapter, returned
+
+
+@pytest.mark.asyncio
+async def test_streamed_reply_is_followed_by_its_reasoning(monkeypatch):
+    adapter, returned = await _deliver(monkeypatch, show_reasoning=True, already_sent=True)
+
+    assert returned is None  # the streamed answer is not sent again
+    sent = [call["content"] for call in adapter.sent]
+    assert len(sent) == 1 and "thinking hard about it" in sent[0]
+    assert "the answer is 42" not in sent[0]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("show_reasoning, already_sent", [(False, True), (True, False)])
+async def test_no_trailing_reasoning_when_hidden_or_not_streamed(monkeypatch, show_reasoning, already_sent):
+    adapter, returned = await _deliver(monkeypatch, show_reasoning=show_reasoning, already_sent=already_sent)
+
+    assert adapter.sent == []
+    if not already_sent:  # the caller's normal send carries the reasoning above the answer
+        assert returned.startswith("💭") and returned.endswith("the answer is 42")
+
+
+@pytest.mark.asyncio
+async def test_a_bot_peer_gets_no_trailing_reasoning_message(monkeypatch):
+    """A second message to a bot peer is fresh input that can start another paid turn."""
+    adapter, returned = await _deliver(monkeypatch, show_reasoning=True, already_sent=True, is_bot=True)
+
+    assert returned is None
+    assert adapter.sent == []
+
+
+@pytest.mark.asyncio
+async def test_an_uncertain_streamed_final_carries_its_reasoning_only_once(monkeypatch):
+    """The ledgered redelivery of an uncertain streamed final already holds the reasoning block."""
+    ledger: list[str] = []
+    adapter, returned = await _deliver(monkeypatch, show_reasoning=True, already_sent=True,
+                                       uncertain=True, ledger=ledger)
+
+    assert returned is None
+    assert adapter.sent == []
+    assert len(ledger) == 1 and "thinking hard about it" in ledger[0] and ledger[0].endswith("the answer is 42")
+
+
+@pytest.mark.asyncio
+async def test_an_uncertain_streamed_final_with_the_ledger_off_still_shows_its_reasoning(monkeypatch):
+    """``gateway.delivery_ledger: false`` saves no redelivery row, so nothing else will carry the reasoning."""
+    ledger: list[str] = []
+    adapter, returned = await _deliver(monkeypatch, show_reasoning=True, already_sent=True,
+                                       uncertain=True, ledger=ledger, saved=False)
+
+    assert returned is None
+    sent = [call["content"] for call in adapter.sent]
+    assert len(sent) == 1 and "thinking hard about it" in sent[0]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("enabled", [True, False])
+async def test_the_base_ledger_reports_whether_it_saved_a_redelivery(monkeypatch, tmp_path, enabled):
+    """The real adapter seam: with ``gateway.delivery_ledger`` off nothing is saved, and it says so."""
+    from gateway import delivery_ledger as dl
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(dl, "ledger_enabled", lambda config=None: enabled)
+    adapter = ProgressCaptureAdapter(platform=Platform.TELEGRAM)
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="42", chat_type="dm")
+    event = MessageEvent(text="hi", message_type=MessageType.TEXT, source=source, message_id="1")
+
+    saved = await adapter.ledger_attempted_final(event, "agent:main:telegram:dm:42", "the answer is 42",
+                                                 error="Timed out")
+
+    assert saved is enabled
diff --git a/tests/gateway/test_telegram_chat_type_sites.py b/tests/gateway/test_telegram_chat_type_sites.py
