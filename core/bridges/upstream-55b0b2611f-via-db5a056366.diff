+    monkeypatch.setattr(subprocess, "run", fake_run)
+
+    bw.fetch_bitwarden_secrets(
+        access_token="0.t",
+        project_id=PROJECT_ID,
+        binary=fake_binary,
+        use_cache=False,
+    )
+
+    cmd = captured["cmd"]
+    assert cmd[-2:] == ["--", PROJECT_ID]
+
+
+# ---------------------------------------------------------------------------
+# Ambient BWS_SERVER_URL inherited from the parent environment
+# ---------------------------------------------------------------------------
+
+
+def _run_with_source_env(monkeypatch, tmp_path, source_env, **fetch_kwargs):
+    """Run a fetch with `source_env` as the parent env; return (env, warnings)."""
+    fake_binary = tmp_path / "bws"
+    fake_binary.write_text("", encoding="utf-8")
+    captured_env = {}
+
+    def fake_run(cmd, **kwargs):
+        captured_env.update(kwargs["env"])
+        return mock.Mock(returncode=0, stdout=_fake_bws_payload([]), stderr="")
+
+    monkeypatch.setattr(subprocess, "run", fake_run)
+    # The bws child env is built by base.source_child_env from the active source
+    # environment, so the seam is the base module's lookup, not bitwarden's.
+    monkeypatch.setattr(bw_base, "get_source_environment", lambda: dict(source_env))
+
+    _secrets, warnings = bw.fetch_bitwarden_secrets(
+        access_token="0.t",
+        project_id=PROJECT_ID,
+        binary=fake_binary,
+        use_cache=False,
+        **fetch_kwargs,
+    )
+    return captured_env, warnings
+
+
+def test_inherited_plaintext_server_url_is_dropped(monkeypatch, tmp_path):
+    """An exported http:// override must not redirect the token either."""
+    env, warnings = _run_with_source_env(
+        monkeypatch, tmp_path, {"BWS_SERVER_URL": "http://attacker.example"}
+    )
+    assert "BWS_SERVER_URL" not in env
+    assert any("Ignoring BWS_SERVER_URL" in w for w in warnings)
+
+
+def test_inherited_https_server_url_still_works(monkeypatch, tmp_path):
+    """A valid shell override keeps working — this is a documented escape hatch."""
+    env, warnings = _run_with_source_env(
+        monkeypatch, tmp_path, {"BWS_SERVER_URL": "https://vault.bitwarden.eu"}
+    )
+    assert env["BWS_SERVER_URL"] == "https://vault.bitwarden.eu"
+    assert warnings == []
+
+
+def test_configured_server_url_wins_over_inherited(monkeypatch, tmp_path):
+    env, _warnings = _run_with_source_env(
+        monkeypatch,
+        tmp_path,
+        {"BWS_SERVER_URL": "https://vault.bitwarden.eu"},
+        server_url="https://vault.example.com",
+    )
+    assert env["BWS_SERVER_URL"] == "https://vault.example.com"
+
+
+# ---------------------------------------------------------------------------
+# apply_server_url_to_env is the only writer of BWS_SERVER_URL, so it validates
+# explicit values too — callers that never went through fetch_bitwarden_secrets
+# (the CLI's `bws project list` path) must not be able to skip the check.
+# ---------------------------------------------------------------------------
+
+
+def test_explicit_plaintext_server_url_is_dropped():
+    env = {}
+    warning = bw.apply_server_url_to_env(env, "http://attacker.example")
+    assert "BWS_SERVER_URL" not in env
+    assert warning and "Ignoring the configured Bitwarden server_url" in warning
+
+
+def test_explicit_invalid_server_url_does_not_leave_an_inherited_value():
+    """A rejected explicit value must not fall through to the ambient one."""
+    env = {"BWS_SERVER_URL": "https://vault.bitwarden.eu"}
+    warning = bw.apply_server_url_to_env(env, "http://attacker.example")
+    assert "BWS_SERVER_URL" not in env
+    assert warning is not None
+
+
+def test_explicit_valid_server_url_is_applied_stripped():
+    env = {}
+    assert bw.apply_server_url_to_env(env, "  https://vault.bitwarden.eu  ") is None
+    assert env["BWS_SERVER_URL"] == "https://vault.bitwarden.eu"
diff --git a/tests/agent/test_context_references_repo_filters.py b/tests/agent/test_context_references_repo_filters.py
new file mode 100644
index 0000000000..b8c36ca60b
--- /dev/null
+++ b/tests/agent/test_context_references_repo_filters.py
@@ -0,0 +1,153 @@
+"""``@diff`` / ``@staged`` / ``@git:N`` empty the clean/smudge filter commands a repository names.
+
+Real temporary repositories with real ``git``: ``.gitattributes`` names a filter whose
+repository-local command touches a marker file and then behaves as ``cat``, and a tracked file
+is stat-dirty. Expansion goes through ``preprocess_context_references_async``.
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from agent import context_references
+from agent.context_references import preprocess_context_references_async
+from hermes_cli._subprocess_compat import FILTER_DISCOVERY_FAILED
+
+pytestmark = pytest.mark.skipif(shutil.which("git") is None, reason="git required")
+
+_STAMP = [1_000_000_000]
+
+
+def _git(repo: Path, *args: str) -> None:
+    env = {"HOME": str(repo.parent), "PATH": os.environ["PATH"], "GIT_CONFIG_NOSYSTEM": "1",
+           "GIT_CONFIG_GLOBAL": os.devnull}
+    subprocess.run(["git", *args], cwd=repo, check=True, capture_output=True, env=env)
+
+
+def _make_repo(tmp_path: Path, *, with_filter: bool = True, via_include: bool = False) -> tuple[Path, Path]:
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    _git(repo, "init", "-q", "-b", "main")
+    _git(repo, "config", "user.name", "Test")
+    _git(repo, "config", "user.email", "test@example.invalid")
+    _git(repo, "config", "core.autocrlf", "false")
+    (repo / "README").write_text("hello\n")
+    (repo / "notes.txt").write_text("alpha\n")
+    if with_filter:
+        (repo / ".gitattributes").write_text("README filter=probe\n*.txt filter=probe\n")
+    _git(repo, "add", "-A")
+    _git(repo, "commit", "-q", "-m", "init")
+    (repo / "notes.txt").write_text("alpha\nstaged-line\n")
+    _git(repo, "add", "notes.txt")
+    _git(repo, "commit", "-q", "-m", "second")
+    (repo / "notes.txt").write_text("alpha\nstaged-line\nstaged-two\n")
+    _git(repo, "add", "notes.txt")
+    (repo / "notes.txt").write_text("alpha\nstaged-line\nstaged-two\nworktree-line\n")
+    marker = tmp_path / "filter-ran"
+    if with_filter:
+        script = tmp_path / "probe-filter.sh"
+        script.write_text(f"#!/bin/sh\ntouch '{marker}'\nexec cat\n")
+        script.chmod(0o755)
+        if via_include:
+            (repo / ".git" / "probe-filters.inc").write_text(
+                f'[filter "probe"]\n\tclean = {script}\n\tsmudge = {script}\n')
+            _git(repo, "config", "include.path", "probe-filters.inc")
+        else:
+            _git(repo, "config", "filter.probe.clean", str(script))
+            _git(repo, "config", "filter.probe.smudge", str(script))
+    _STAMP[0] += 10
+    for name in ("README", "notes.txt"):
+        os.utime(repo / name, (_STAMP[0], _STAMP[0]))
+    if marker.exists():
+        marker.unlink()
+    return repo, marker
+
+
+async def _expand(repo: Path, message: str):
+    return await preprocess_context_references_async(message, cwd=repo, context_length=1_000_000)
+
+
+@pytest.mark.asyncio
+async def test_diff_reference_runs_no_repository_filter(tmp_path):
+    repo, marker = _make_repo(tmp_path)
+
+    result = await _expand(repo, "review @diff")
+
+    assert not marker.exists()
+    assert result.warnings == []
+    assert "+worktree-line" in result.message
+    assert "git diff" in result.message
+
+
+@pytest.mark.asyncio
+async def test_staged_reference_runs_no_repository_filter(tmp_path):
+    repo, marker = _make_repo(tmp_path)
+
+    result = await _expand(repo, "review @staged")
+
+    assert not marker.exists()
+    assert result.warnings == []
+    assert "+staged-two" in result.message
+    assert "+worktree-line" not in result.message
+
+
+@pytest.mark.asyncio
+async def test_git_log_reference_runs_no_repository_filter(tmp_path):
+    repo, marker = _make_repo(tmp_path)
+
+    result = await _expand(repo, "review @git:1")
+
+    assert not marker.exists()
+    assert result.warnings == []
+    assert "+staged-line" in result.message
+    assert "second" in result.message
+
+
+@pytest.mark.asyncio
+async def test_filter_defined_through_include_path_is_neutralized(tmp_path):
+    repo, marker = _make_repo(tmp_path, via_include=True)
+
+    result = await _expand(repo, "review @diff")
+
+    assert not marker.exists()
+    assert "+worktree-line" in result.message
+
+
+@pytest.mark.asyncio
+async def test_repository_without_filter_expands_the_same_content(tmp_path):
+    repo, _marker = _make_repo(tmp_path, with_filter=False)
+
+    result = await _expand(repo, "review @diff and @staged")
+
+    assert result.warnings == []
+    assert "+worktree-line" in result.message
+    assert "+staged-two" in result.message
+    assert "🧾 git diff (" in result.message
+    assert "🧾 git diff --staged (" in result.message
+
+
+@pytest.mark.asyncio
+async def test_unbuildable_repository_environment_warns_without_spawning_git(tmp_path, monkeypatch):
+    repo, marker = _make_repo(tmp_path)
+    spawned: list[list[str]] = []
+    real_popen = subprocess.Popen
+
+    def counting_popen(argv, *args, **kwargs):
+        spawned.append(list(argv))
+        return real_popen(argv, *args, **kwargs)
+
+    monkeypatch.setattr(context_references, "noninteractive_repo_git_env", lambda cwd, base=None: None,
+                        raising=False)
+    monkeypatch.setattr(context_references.subprocess, "Popen", counting_popen)
+
+    result = await _expand(repo, "review @diff")
+
+    assert result.warnings == [f"@diff: {FILTER_DISCOVERY_FAILED}"]
+    assert "+worktree-line" not in result.message
+    assert not [argv for argv in spawned if "diff" in argv]
+    assert not marker.exists()
diff --git a/tests/agent/test_empty_retry_machinery_budget.py b/tests/agent/test_empty_retry_machinery_budget.py
new file mode 100644
index 0000000000..78772addff
--- /dev/null
+++ b/tests/agent/test_empty_retry_machinery_budget.py
@@ -0,0 +1,116 @@
+"""Machinery turns get a quiet empty-response exit, not a paid retry budget.
+
+An injected internal_notification turn (``display_kind=internal_notification``,
+#82888 machinery lane) is not owed a reply. When the model answers it with an
+empty completion, the quiet exit ends the turn with no nudge, no paid retries,
+no provider switch, and no ``(empty)`` sentinel: #135816 logged notification
+turns burning twelve requests where every paid retry came back empty too. Only
+machinery turns collapse; a human turn keeps the full ladder.
+"""
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+from agent import turn_empty_response as ter
+from gateway import response_filters as gateway_filters
+from gateway.response_filters import MACHINERY_DISPLAY_KINDS as gateway_machinery_kinds
+
+
+def _agent():
+    a = MagicMock()
+    a.model = "test/model"
+    a.provider = "test"
+    a._current_streamed_assistant_text = ""
+    a._has_content_after_think_block.return_value = False
+    a._strip_think_blocks.side_effect = lambda t: t or ""
+    a._last_content_with_tools = None
+    a._thinking_prefill_retries = 2
+    a._fallback_chain = None
+    a._empty_content_retries = 0
+    a._emit_diagnostic_status = MagicMock()
+    a._buffer_diagnostic_status = MagicMock()
+    a._flush_status_buffer = MagicMock()
+    a._build_assistant_message = MagicMock(return_value={"role": "assistant", "content": ""})
+    # MagicMock.getattr(foo, "bar", False) returns a truthy child mock unless
+    # the attribute is explicitly set to a falsy value.  The real AIAgent
+    # object never auto-creates these attributes.
+    a._post_tool_empty_retried = False
+    a._response_was_previewed = False
+    return a
+
+
+def _assistant_msg():
+    return SimpleNamespace(reasoning=None, reasoning_content=None, reasoning_details=None)
+
+
+def _empty_response():
+    choice = SimpleNamespace(message=_assistant_msg(), finish_reason="stop")
+    choice.message.content = ""
+    choice.message.tool_calls = None
+    return SimpleNamespace(choices=[choice], model="test/model", usage=None)
+
+
+def _recover(agent, messages, **kwargs):
+    return ter.recover_empty_response(
+        agent,
+        _assistant_msg(),
+        None,
+        "stop",
+        final_response="",
+        messages=messages,
+        api_messages=[],
+        conversation_history=[],
+        active_system_prompt="sys",
+        api_call_count=1,
+        turn_exit_reason=None,
+        preflight_compression_blocked=False,
+        **kwargs,
+    )
+
+
+class TestMachineryEmptyRetryBudget:
+    def test_internal_notification_turn_skips_paid_retries(self):
+        agent = _agent()
+        messages = [
+            {"role": "user", "content": "[kanban] board updated", "display_kind": "internal_notification"},
+        ]
+        verdict = _recover(agent, messages)
+        assert verdict.action == "break"
+        assert verdict.final_response == ""
+        assert verdict.turn_exit_reason == ter.NOTIFICATION_NO_REPLY_EXIT
+        assert agent._empty_content_retries == 0  # no retry was scheduled
+        agent._emit_diagnostic_status.assert_not_called()  # no "retrying (1/3)" chatter
+
+    def test_human_turn_keeps_full_budget_and_retries(self):
+        agent = _agent()
+        messages = [{"role": "user", "content": "What happened?"}]
+        verdict = _recover(agent, messages)
+        assert verdict.action == "continue"
+        assert agent._empty_content_retries == 1
+
+    def test_only_machinery_kinds_collapse(self):
+        agent = _agent()
+        messages = [
+            {"role": "user", "content": "background result", "display_kind": "background_result"},
+        ]
+        verdict = _recover(agent, messages)
+        assert verdict.action == "continue"
+        assert agent._empty_content_retries == 1
+
+
+class TestMachineryKindsMirrorGateway:
+    def test_agent_mirror_matches_gateway_machinery_kinds(self):
+        # Cross-layer drift guard: the agent-side mirror
+        # (agent/turn_empty_response.py _MACHINERY_DISPLAY_KINDS) must stay equal to the
+        # set the gateway actually derives its machinery kinds from
+        # (gateway/response_filters.py MACHINERY_DISPLAY_KINDS). If the gateway ever grows
+        # a new machinery kind, this mirror must follow, otherwise the quiet exit silently
+        # keeps the new machinery turn on the paid human retry ladder.
+        assert ter._MACHINERY_DISPLAY_KINDS == gateway_machinery_kinds
+        assert "internal_notification" in gateway_machinery_kinds
+
+    def test_quiet_exit_reason_and_row_match_the_gateway(self):
+        # The gateway recognizes the exit by this string and the persisted row by this
+        # marker; both are mirrored on the agent side because agent/ cannot import gateway/.
+        assert ter.NOTIFICATION_NO_REPLY_EXIT == gateway_filters.NOTIFICATION_NO_REPLY_EXIT
+        assert ter.MACHINERY_NO_REPLY_ROW in gateway_filters.LIVE_GATEWAY_SILENT_MARKERS
diff --git a/tests/agent/test_file_safety_proc_devices.py b/tests/agent/test_file_safety_proc_devices.py
new file mode 100644
index 0000000000..4f3e5fea20
--- /dev/null
+++ b/tests/agent/test_file_safety_proc_devices.py
@@ -0,0 +1,40 @@
+"""``get_read_block_error`` — the published plugin path check — refuses the device and /proc
+files Hermes's own read_file refuses, so a plugin that follows the docs cannot read process
+secrets (environment, argv, memory layout) or hang on an endless device."""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+
+from agent.file_safety import get_read_block_error
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.parametrize("path", [
+    "/proc/self/environ", "/proc/1/environ", "/proc/self/cmdline", "/proc/self/task/1/maps",
+    "/proc/self/mem", "/dev/zero", "/dev/urandom", "/dev/stdin", "/dev/../dev/zero",
+])
+def test_device_and_proc_reads_are_refused(path):
+    err = get_read_block_error(path)
+    assert err and "device or process file" in err
+
+
+@pytest.mark.platforms("linux")
+def test_symlink_to_proc_environ_is_refused(tmp_path):
+    link = tmp_path / "innocent.txt"
+    os.symlink("/proc/self/environ", link)
+    assert get_read_block_error(str(link))
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.parametrize("path", ["/dev/null", "/proc/cpuinfo", "/proc/self/status"])
+def test_harmless_proc_and_dev_paths_stay_readable(path):
+    assert get_read_block_error(path) is None
+
+
+def test_ordinary_file_is_not_a_device(tmp_path):
+    target = tmp_path / "notes.txt"
+    target.write_text("hi")
+    assert get_read_block_error(str(target)) is None
diff --git a/tests/agent/test_file_safety_sibling_profiles.py b/tests/agent/test_file_safety_sibling_profiles.py
new file mode 100644
index 0000000000..111aa65dc3
--- /dev/null
+++ b/tests/agent/test_file_safety_sibling_profiles.py
@@ -0,0 +1,65 @@
+"""A sibling profile's credential stores get the same read/write denial as the active one's.
+
+The guards used to cover only the active HERMES_HOME and the global root, so from the
+default profile ``<root>/profiles/<other>/auth.json`` was readable (#46411) and
+``<root>/profiles/<other>/mcp-tokens/`` writable (#37617) through the file tools.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+import agent.file_safety as fs
+
+READ_DENIED = (
+    "auth.json", ".anthropic_oauth.json", "auth/google_oauth.json", "mcp-tokens/github.json",
+    "webhook_subscriptions.json", ".env", "vault/vault.key",
+)
+WRITE_DENIED = (
+    ".env", ".anthropic_oauth.json", "auth/google_oauth.json", "bws_cache.enc.json",
+    "cache/bws_cache.enc.json", "mcp-tokens/github.json", "pairing/telegram-approved.json",
+    "state.db", "sessions/session_abc.json",
+)
+WRITABLE_CONTROL_FILES = ("auth.json", "config.yaml", "webhook_subscriptions.json")
+
+
+@pytest.fixture()
+def default_profile_with_sibling(tmp_path, monkeypatch):
+    """Session runs in the default profile (HERMES_HOME == root); ``other`` is a sibling."""
+    root = tmp_path / "hermes_root"
+    sibling = root / "profiles" / "other"
+    sibling.mkdir(parents=True)
+    monkeypatch.setattr(fs, "_hermes_home_path", lambda: root)
+    monkeypatch.setattr(fs, "_hermes_root_path", lambda: root)
+    return sibling
+
+
+def _touch(base: Path, rel: str) -> Path:
+    p = base / rel
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_text('{"access_token": "CROSS_PROFILE_TOKEN_MARKER"}', encoding="utf-8")
+    return p
+
+
+def test_sibling_profile_credential_stores_are_read_and_write_denied(default_profile_with_sibling):
+    from tools.file_tools import read_file_tool
+
+    sibling = default_profile_with_sibling
+    for rel in READ_DENIED:
+        path = _touch(sibling, rel)
+        assert fs.get_read_block_error(str(path)), f"read allowed: {rel}"
+        out = read_file_tool(str(path), task_id="sibling-profile-read")
+        assert "CROSS_PROFILE_TOKEN_MARKER" not in out, f"read_file leaked {rel}"
+    for rel in WRITE_DENIED:
+        assert fs.is_write_denied(str(_touch(sibling, rel))), f"write allowed: {rel}"
+
+
+def test_sibling_profile_ordinary_and_control_files_stay_usable(default_profile_with_sibling):
+    sibling = default_profile_with_sibling
+    notes = _touch(sibling, "notes.md")
+    assert fs.get_read_block_error(str(notes)) is None
+    assert fs.is_write_denied(str(notes)) is False
+    for rel in WRITABLE_CONTROL_FILES:
+        assert fs.is_write_denied(str(_touch(sibling, rel))) is False, f"#45947 regression: {rel}"
diff --git a/tests/agent/test_file_safety_windows_spellings.py b/tests/agent/test_file_safety_windows_spellings.py
new file mode 100644
index 0000000000..46c2849a97
--- /dev/null
+++ b/tests/agent/test_file_safety_windows_spellings.py
@@ -0,0 +1,82 @@
+"""Windows: every spelling of a protected Hermes path is denied, not just the plain one (#154282).
+
+``\\\\?\\C:\\...`` and the local machine's administrative share (``\\\\localhost\\C$\\...``,
+``\\\\127.0.0.1\\C$\\...``, ``\\\\<this computer>\\C$\\...``) open the same file as ``C:\\...``; the
+name-based denies used to compare the resolved string, which keeps the prefix, so those spellings
+read and wrote straight through. Dummy files only, in a throwaway home.
+"""
+
+import json
+import socket
+from unittest.mock import patch
+
+import pytest
+
+from agent import file_safety as fs
+
+pytestmark = pytest.mark.platforms("windows")
+
+BS = "\\"
+
+
+def _spellings(path: str) -> dict[str, str]:
+    drive, rest = path[0], path[2:]
+    def share(host: str) -> str:
+        return BS * 2 + host + BS + drive + "$" + rest
+
+    return {
+        "extended-length": BS * 2 + "?" + BS + path,
+        "extended-length, forward slashes": ("//?/" + path).replace(BS, "/"),
+        "localhost share": share("localhost"),
+        "localhost share, upper case": share("LOCALHOST"),
+        "127.0.0.1 share": share("127.0.0.1"),
+        "127.1.2.3 share": share("127.1.2.3"),
+        "this computer's share": share(socket.gethostname()),
+    }
+
+
+@pytest.fixture
+def home(tmp_path):
+    home = tmp_path.resolve() / "hermes"
+    for rel in ("mcp-tokens/server/token.json", "vault/vault.key", "auth.json"):
+        target = home / rel
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_text(json.dumps({"secret": "DUMMY"}), encoding="utf-8")
+    with patch.object(fs, "_hermes_home_path", return_value=home), \
+            patch.object(fs, "_hermes_root_path", return_value=home):
+        yield home
+
+
+@pytest.mark.parametrize("rel", ["mcp-tokens/server/token.json", "vault/vault.key", "auth.json"])
+def test_every_local_spelling_of_a_protected_file_is_read_denied(home, rel):
+    plain = str(home / rel)
+    assert fs.get_read_block_error(plain)
+    for label, spelled in _spellings(plain).items():
+        assert fs.get_read_block_error(spelled), label
+
+
