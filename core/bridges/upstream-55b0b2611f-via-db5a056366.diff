+    stray_write = build_edit_proposal("write_file", {"path": str(hook), "content": "#!/bin/sh\n", "patch": decoy})
+    stray_empty = build_edit_proposal("write_file", {"path": str(hook), "content": "#!/bin/sh\n", "patch": ""})
