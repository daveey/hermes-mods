+        f"<p>{escape(message)}</p>"
+        "<p>Ask whoever runs this Hermes host to run that command, then reload this page.</p>"
+        "</body></html>"
+    )
+    return HTMLResponse(html, status_code=status_code, headers=page_headers(request, html, _NO_STORE))
