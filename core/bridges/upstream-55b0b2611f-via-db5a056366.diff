+++ b/tests/gateway/test_telegram_chat_type_sites.py
@@ -0,0 +1,53 @@
+"""Every Telegram chat-type classifier routes through ``_normalize_chat_type`` (#74696).
+
+Behaviour-preserving: each site keeps the answer it gave when it re-derived the rule inline.
+``get_chat_info`` reports forum supergroups as ``forum``; an inbound event's ``chat_type`` stays
+``group`` for any supergroup (the forum topic travels as ``thread_id``); a type that is not a known
+group or channel is a DM at both.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.config import PlatformConfig
+from gateway.platforms.event import MessageType
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+# (chat.type, is_forum) -> (get_chat_info type, inbound event chat_type), as the inline code had it
+CASES = {
+    ("private", False): ("dm", "dm"),
+    ("group", False): ("group", "group"),
+    ("supergroup", False): ("group", "group"),
+    ("supergroup", True): ("forum", "group"),
+    ("channel", False): ("channel", "channel"),
+    ("sender", False): ("dm", "dm"),  # unknown type
+}
+
+
+class _Bot:
+    def __init__(self, chat):
+        self._chat = chat
+
+    async def get_chat(self, _chat_id):
+        return self._chat
+
+
+def _chat(kind, is_forum):
+    return SimpleNamespace(id=-100123, type=kind, is_forum=is_forum, title="T", full_name="T", username=None)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("kind,is_forum", sorted(CASES))
+async def test_chat_info_and_inbound_event_keep_their_chat_type(kind, is_forum):
+    info_type, event_type = CASES[(kind, is_forum)]
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="***"))
+    adapter._bot = _Bot(_chat(kind, is_forum))
+    assert (await adapter.get_chat_info("-100123"))["type"] == info_type
+
+    message = SimpleNamespace(
+        chat=_chat(kind, is_forum), from_user=SimpleNamespace(id=7, full_name="U", is_bot=False),
+        message_id=5, message_thread_id=None, is_topic_message=False, text="hi", caption=None,
+        entities=None, caption_entities=None, reply_to_message=None, date=None, forum_topic_created=None)
+    event = adapter._build_message_event(message, MessageType.TEXT)
+    assert event.source.chat_type == event_type
diff --git a/tests/gateway/test_telegram_fifo_grace.py b/tests/gateway/test_telegram_fifo_grace.py
new file mode 100644
index 0000000000..c0a6bfcb43
--- /dev/null
+++ b/tests/gateway/test_telegram_fifo_grace.py
@@ -0,0 +1,117 @@
+"""Telegram grace applies before durable-FIFO and relay busy preemption (#152516).
+
+The old fast path queued a quick follow-up; authority and relay admissions bypassed
+that guard and interrupted the running agent instead.
+"""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+import pytest
+
+from gateway.config import Platform
+from gateway.platforms.event import MessageEvent, MessageType
+from gateway.run import GatewayRunner
+from gateway.session import SessionSource
+from gateway.session_ingress_live_turn import _route
+
+
+def _busy_telegram_turn():
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="grace-chat", chat_type="dm", user_id="u1")
+    event = MessageEvent(text="one more detail", message_type=MessageType.TEXT, source=source)
+    key = "telegram:grace-chat"
+    runner = object.__new__(GatewayRunner)
+    state = SimpleNamespace(turn=SimpleNamespace(started_ts=100.0, agent=object()))
+    runner._draining = False
+    runner._peek_session_state = lambda _key: state
+    runner._effective_busy_input_mode = lambda _source: "interrupt"
+    runner._effective_busy_text_mode = lambda _source: "interrupt"
+    runner._delivery_adapter_for = lambda _source: object()
+    runner._session_key_for_source = lambda _source: key
+    runner._is_session_running = lambda _key: True
+    runner._route_plaintext_approval_while_busy = AsyncMock(return_value=False)
+    runner._hm_pending_reply_intercepts = AsyncMock(return_value=None)
+    runner._hm_post_admission_consume = AsyncMock(return_value=(False, None))
+    runner._resolve_busy_steer_or_redirect = AsyncMock(
+        side_effect=AssertionError("grace follow-up preempted the running turn")
+    )
+    runner._busy_interrupt_and_ack = AsyncMock()
+    return runner, event, source, key
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("ingress", ["durable", "relay"])
+async def test_telegram_followup_within_grace_uses_durable_fifo(monkeypatch, ingress):
+    monkeypatch.setenv("HERMES_TELEGRAM_FOLLOWUP_GRACE_SECONDS", "3")
+    runner, event, source, key = _busy_telegram_turn()
+
+    with (
+        patch("gateway.run_inbound.time.time", return_value=102.0),
+        patch("gateway.session_ingress.admit_message", new_callable=AsyncMock, return_value="queued") as admit,
+    ):
+        if ingress == "durable":
+            assert await runner._hm_admit_to_fifo(object(), event, source, key, True) == (True, "queued")
+            admit.assert_awaited_once()
+        else:
+            assert await _route(runner, event) is False  # relay caller admits its own FIFO row
+            admit.assert_not_awaited()
+
+    runner._resolve_busy_steer_or_redirect.assert_not_awaited()
+    runner._busy_interrupt_and_ack.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_telegram_followup_after_grace_can_still_preempt(monkeypatch):
+    monkeypatch.setenv("HERMES_TELEGRAM_FOLLOWUP_GRACE_SECONDS", "3")
+    runner, event, source, key = _busy_telegram_turn()
+    runner._resolve_busy_steer_or_redirect = AsyncMock(
+        return_value=SimpleNamespace(steered=False, redirected=False)
+    )
+
+    with patch("gateway.run_inbound.time.time", return_value=105.0):
+        assert await runner._hm_busy_preempt(event, source, key) is False
+
+    runner._resolve_busy_steer_or_redirect.assert_awaited_once()
+    runner._busy_interrupt_and_ack.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_telegram_long_followup_uses_send_time_before_default_batch_flush(monkeypatch):
+    """A +2s Telegram text must not interrupt when its default 1.5s batch flushes at +3.5s."""
+    from datetime import UTC, datetime
+
+    from gateway.config import PlatformConfig
+    from plugins.platforms.telegram.adapter import TelegramAdapter
+
+    monkeypatch.delenv("HERMES_TELEGRAM_FOLLOWUP_GRACE_SECONDS", raising=False)
+    monkeypatch.delenv("HERMES_TELEGRAM_TEXT_BATCH_DELAY_SECONDS", raising=False)
+    runner, event, source, key = _busy_telegram_turn()
+    event.text = "One more detail " * 80  # >1,024 chars: default long-text delay, not the fast tier
+    event.timestamp = datetime.fromtimestamp(102.0, UTC)
+    event.raw_message = SimpleNamespace(date=event.timestamp)  # Telegram's provider send time
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="test-token"))
+    delay = adapter._text_batch_delay_for(event)
+    assert delay == pytest.approx(1.5)
+
+    with patch("gateway.run_inbound.time.time", return_value=102.0 + delay):
+        assert await runner._hm_busy_preempt(event, source, key) is False
+
+    runner._resolve_busy_steer_or_redirect.assert_not_awaited()
+    runner._busy_interrupt_and_ack.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("sent_at, edited_at, waits", [(95.0, 102.0, True), (101.0, 110.0, False)])
+async def test_telegram_edited_followup_is_judged_by_its_edit_time(monkeypatch, sent_at, edited_at, waits):
+    """An edit keeps the message's original ``date``; the grace reads the edit's own time instead."""
+    from datetime import UTC, datetime
+
+    monkeypatch.delenv("HERMES_TELEGRAM_FOLLOWUP_GRACE_SECONDS", raising=False)
+    runner, event, source, key = _busy_telegram_turn()
+    runner._resolve_busy_steer_or_redirect.side_effect = None  # the out-of-grace edit is expected to preempt
+    event.timestamp = datetime.fromtimestamp(sent_at, UTC)  # the turn started at 100
+    event.raw_message = SimpleNamespace(date=event.timestamp, edit_date=datetime.fromtimestamp(edited_at, UTC))
+    with patch("gateway.run_inbound.time.time", return_value=edited_at + 0.2):
+        await runner._hm_busy_preempt(event, source, key)
+    preempted = runner._busy_interrupt_and_ack.await_count + runner._resolve_busy_steer_or_redirect.await_count
+    assert (preempted == 0) is waits
diff --git a/tests/gateway/test_telegram_idless_send_ledger.py b/tests/gateway/test_telegram_idless_send_ledger.py
new file mode 100644
index 0000000000..f8b73ab411
--- /dev/null
+++ b/tests/gateway/test_telegram_idless_send_ledger.py
@@ -0,0 +1,44 @@
+"""#147616: a Telegram send accepted with no ``message_id`` is not a delivery.
+
+``sendRichMessage`` answered without an id used to come back as ``success=True``; the delivery ledger
+finalizes on ``success`` and prunes a delivered row, so a reply that never reached the chat was never
+redelivered. The delivery is unknown, so it must stay recoverable AND must not be resent on the spot
+(a blind resend would duplicate a message Telegram may already hold).
+"""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway import delivery_ledger as dl
+from gateway.config import Platform, PlatformConfig
+from gateway.platforms.event import MessageEvent, MessageType
+from gateway.session import SessionSource
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+pytest.importorskip("telegram")
+
+TABLE_REPLY = "Results:\n\n| a | b |\n|---|---|\n| 1 | 2 |\n"
+
+
+@pytest.mark.asyncio
+async def test_rich_send_without_message_id_stays_recoverable_and_is_sent_once(tmp_path, monkeypatch):
+    monkeypatch.setattr(dl, "_db_path", lambda: tmp_path / "state.db")
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="fake-token", extra={"rich_messages": True}))
+    bot = MagicMock()
+    bot.do_api_request = AsyncMock(return_value={})  # Telegram accepted the call; the result has no id
+    bot.send_message = AsyncMock(return_value=SimpleNamespace(message_id=7))
+    bot.send_chat_action = AsyncMock()
+    adapter._bot = bot
+    event = MessageEvent(text="hi", message_type=MessageType.TEXT, message_id="in-1",
+                         source=SessionSource(platform=Platform.TELEGRAM, chat_id="111", chat_type="dm"))
+
+    result, _ = await adapter.send_final_ledgered(event, "agent:main:telegram:dm:111", TABLE_REPLY, {}, reply_to=None)
+
+    assert result.success is False, "a send with no message id is no proof of delivery"
+    with dl._connect() as conn:
+        states = [row[0] for row in conn.execute("SELECT state FROM delivery_obligations")]
+    assert states == ["failed"], "the row must stay for redelivery, not be finalized as delivered and pruned"
+    assert bot.do_api_request.await_count == 1 and bot.send_message.await_count == 0, (
+        "delivery is unknown: neither a retry nor a legacy resend may duplicate it")
diff --git a/tests/gateway/test_telegram_live_location.py b/tests/gateway/test_telegram_live_location.py
new file mode 100644
index 0000000000..a3f538e3d4
--- /dev/null
+++ b/tests/gateway/test_telegram_live_location.py
@@ -0,0 +1,82 @@
+"""A Telegram live location is one input: its GPS refreshes start a turn only after real movement.
+
+Telegram delivers each refresh of a live location as an ``edited_message`` of the same message,
+every few seconds to a minute for up to eight hours, and PTB dispatches those edits to the
+location handler like new messages. Every tick used to become a full agent turn.
+"""
+
+import asyncio
+from datetime import UTC, datetime, timedelta
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+from tests.gateway.test_telegram_group_gating import _FakeSessionStore, _group_location_message, _make_adapter
+
+_T0 = datetime(2026, 11, 11, 12, 0, tzinfo=UTC)
+
+
+def _pin(lat, *, live=True, edited_after=None, message_id=50, update_id=1):
+    msg = _group_location_message(chat_id=111, lat=lat, lon=13.40)
+    msg.chat = SimpleNamespace(id=111, type="private", title=None, is_forum=False)
+    msg.message_id = message_id
+    msg.date = _T0
+    msg.edit_date = None if edited_after is None else _T0 + timedelta(seconds=edited_after)
+    msg.location = SimpleNamespace(latitude=lat, longitude=13.40, live_period=3600 if live else None)
+    return SimpleNamespace(update_id=update_id, message=msg, effective_message=msg)
+
+
+def _deliver(adapter, updates):
+    async def _run():
+        for update in updates:
+            await adapter._handle_location_message(update, SimpleNamespace())
+    asyncio.run(_run())
+    return [call.args[0].text.split("\n")[1] for call in adapter.handle_message.await_args_list]
+
+
+def _adapter():
+    adapter = _make_adapter(allow_from=["111"])
+    adapter.handle_message = AsyncMock()
+    return adapter
+
+
+def test_a_live_share_is_one_turn_until_the_user_moves():
+    adapter = _adapter()
+    turns = _deliver(adapter, [
+        _pin(52.52, update_id=1),
+        # GPS jitter of about a metre, every 30 s: the same place
+        *[_pin(52.52 + 0.00001 * i, edited_after=30 * i, update_id=1 + i) for i in range(1, 5)],
+        _pin(52.53, edited_after=150, update_id=6),  # ~1.1 km away: new input
+        _pin(52.53001, edited_after=180, update_id=7),  # jitter around the new spot
+        _pin(52.53001, edited_after=180 + 901, update_id=8),  # parked past the quiet window
+        _pin(52.53001, live=False, edited_after=1200, update_id=9),  # the share stopped
+    ])
+    assert turns == ["latitude: 52.52", "latitude: 52.53", "latitude: 52.53001"]
+
+
+def test_static_pins_and_separate_live_shares_each_reach_the_agent():
+    adapter = _adapter()
+    turns = _deliver(adapter, [
+        _pin(52.52, live=False, message_id=1),
+        _pin(52.52, live=False, message_id=2),  # the same spot pinned again on purpose
+        _pin(52.52, message_id=3),
+        _pin(52.52, message_id=4),  # a second live share, its own message
+    ])
+    assert turns == ["latitude: 52.52"] * 4
+
+
+def test_observed_group_records_a_live_share_once():
+    """In a group that observes unmentioned messages, the refreshes of one live share must not
+    each append a transcript row: the in-place check runs before the observe step."""
+    adapter = _make_adapter(require_mention=True, allowed_chats=["-100"], group_allowed_chats=["-100"],
+                            observe_unmentioned_group_messages=True)
+    adapter.handle_message = AsyncMock()
+    store = adapter._session_store = _FakeSessionStore()
+    updates = [_pin(52.52, update_id=1),
+               *[_pin(52.52 + 0.00001 * i, edited_after=30 * i, update_id=1 + i) for i in range(1, 5)]]
+    for update in updates:
+        update.message.chat = SimpleNamespace(id=-100, type="group", title="Test Group", is_forum=False)
+
+    _deliver(adapter, updates)
+
+    adapter.handle_message.assert_not_awaited()
+    assert len(store.messages) == 1
diff --git a/tests/gateway/test_telegram_local_bot_api_files.py b/tests/gateway/test_telegram_local_bot_api_files.py
new file mode 100644
index 0000000000..4bb47ec376
--- /dev/null
+++ b/tests/gateway/test_telegram_local_bot_api_files.py
@@ -0,0 +1,111 @@
+"""Inbound files from a ``--local`` telegram-bot-api whose storage is mounted elsewhere on this host (#55698).
+
+A ``--local`` server answers getFile with ITS OWN absolute path (``/var/lib/telegram-bot-api/<token>/
+videos/file_7.MOV``) and serves nothing over HTTP. When Hermes runs in another container/host, PTB
+cannot stat that path, so it prefixes ``base_file_url`` and GETs it: 404 ``Not Found: method not
+found``. ``extra.local_bot_api_root`` names where that storage is mounted here; the file is read from
+``<root>/<token>/<rest>`` (or ``<root>/<rest>``) with two stats, no directory walk.
+"""
+
+import os
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway.config import PlatformConfig
+from gateway.platforms.event import MessageType
+from plugins.platforms.telegram.adapter import TelegramAdapter
+from plugins.platforms.telegram.telegram_media_fetch import local_bot_api_path
+
+TOKEN = "123456:AAFakeToken_abc-DEF"
+DATA = b"local-mov-bytes"
+
+
+@pytest.fixture(autouse=True)
+def _cache_dirs(tmp_path, monkeypatch):
+    for name in ("DOCUMENT_CACHE_DIR", "VIDEO_CACHE_DIR", "AUDIO_CACHE_DIR", "IMAGE_CACHE_DIR"):
+        monkeypatch.setattr(f"gateway.platforms.base.{name}", tmp_path / name.lower())
+
+
+def _adapter(extra):
+    a = TelegramAdapter(PlatformConfig(enabled=True, token=TOKEN, extra=extra))
+    a.handle_message = AsyncMock()
+    a._is_callback_user_authorized = lambda user_id, **_kw: True
+    return a
+
+
+def _message(file_path, *, as_document):
+    file_obj = SimpleNamespace(file_path=file_path, download_as_bytearray=AsyncMock(
+        side_effect=RuntimeError("Not Found: method not found")))
+    media = MagicMock(file_size=len(DATA), mime_type="video/mp4", file_name="IMG_5109.MOV")
+    media.get_file = AsyncMock(return_value=file_obj)
+    msg = MagicMock(message_id=42, text="", caption=None, date=None, media_group_id=None, message_thread_id=None,
+                    photo=None, video=None, video_note=None, audio=None, voice=None, sticker=None, document=None)
+    msg.chat = MagicMock(id=100, type="private", title=None, full_name="Test User")
+    msg.from_user = MagicMock(id=1, full_name="Test User")
+    msg.reply_text = AsyncMock()
+    setattr(msg, "document" if as_document else "video", media)
+    return msg, file_obj
+
+
+def _stored(root, kind="videos"):
+    path = root / TOKEN / kind / "file_7.MOV"
+    path.parent.mkdir(parents=True)
+    path.write_bytes(DATA)
+    return path
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("as_document", [False, True], ids=["video", "video-document"])
+@pytest.mark.parametrize("reported", [
+    "/var/lib/telegram-bot-api/{token}/{kind}/file_7.MOV",
+    "http://127.0.0.1:8081/file/bot{token}//var/lib/telegram-bot-api/{token}/{kind}/file_7.MOV",
+], ids=["container-path", "url-embedded"])
+async def test_local_server_file_is_read_from_the_mounted_root(tmp_path, as_document, reported):
+    kind = "documents" if as_document else "videos"
+    _stored(tmp_path / "mount", kind)
+    adapter = _adapter({"base_url": "http://127.0.0.1:8081/bot", "local_mode": True,
+                        "local_bot_api_root": str(tmp_path / "mount")})
+    msg, file_obj = _message(reported.format(token=TOKEN, kind=kind), as_document=as_document)
+
+    await adapter._handle_media_message(MagicMock(message=msg, effective_message=msg), MagicMock())
+
+    event = adapter.handle_message.call_args[0][0]
+    assert event.message_type == MessageType.VIDEO
+    assert Path(event.media_urls[0]).read_bytes() == DATA
+    file_obj.download_as_bytearray.assert_not_awaited()  # no HTTP GET the --local server 404s
+    msg.reply_text.assert_not_awaited()  # no "Couldn't download" reply
+
+
+@pytest.mark.asyncio
+async def test_without_the_root_the_download_path_is_unchanged(tmp_path):
+    """No ``local_bot_api_root``: the PTB download runs as before (and its failure is surfaced)."""
+    _stored(tmp_path / "mount")
+    adapter = _adapter({"base_url": "http://127.0.0.1:8081/bot", "local_mode": True})
+    msg, file_obj = _message(f"/var/lib/telegram-bot-api/{TOKEN}/videos/file_7.MOV", as_document=False)
+
+    await adapter._handle_media_message(MagicMock(message=msg, effective_message=msg), MagicMock())
+
+    file_obj.download_as_bytearray.assert_awaited()
+    msg.reply_text.assert_awaited_once()
+
+
+def test_mapping_bounds(tmp_path):
+    root = tmp_path / "mount"
+    stored = _stored(root)
+    (root / "videos").mkdir()
+    (root / "videos" / "flat.MOV").write_bytes(DATA)
+    secret = tmp_path / "secret.txt"
+    secret.write_text("x")
+
+    assert local_bot_api_path(f"/srv/tg/{TOKEN}/videos/file_7.MOV", str(root)) == stored
+    # a root mounted at the token directory itself (``<root>/<rest>``)
+    assert local_bot_api_path(f"/var/lib/telegram-bot-api/{TOKEN}/videos/flat.MOV", str(root)) == root / "videos" / "flat.MOV"
+    # a relative public-API path has no token segment; a missing file maps to nothing
+    assert local_bot_api_path("videos/file_7.MOV", str(root)) is None
+    assert local_bot_api_path(f"/var/lib/telegram-bot-api/{TOKEN}/videos/none.MOV", str(root)) is None
+    # ``..`` never escapes the root
+    assert local_bot_api_path(f"/x/{TOKEN}/../../secret.txt", str(root)) is None
+    assert os.path.exists(secret)
diff --git a/tests/gateway/test_telegram_media_upload_retry.py b/tests/gateway/test_telegram_media_upload_retry.py
new file mode 100644
index 0000000000..104d49ee5e
--- /dev/null
+++ b/tests/gateway/test_telegram_media_upload_retry.py
@@ -0,0 +1,237 @@
+"""A native Telegram media upload repeats only a failure Telegram provably never posted (#62079).
+
+PTB wraps every httpx transport error as ``NetworkError(...) from <httpx error>``; Telegram's own
+5xx JSON answer is an unchained ``NetworkError('Bad Gateway')``. A connect failure and that 5xx
+answer are repeated as the same request; an error after the upload left (read reset, timeout) may
+already be in the chat, so it is never resent in any shape and never reported as a hard failure.
+"""
+
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import httpx
+import pytest
+
+from gateway.config import PlatformConfig
+from gateway.platforms.base import BasePlatformAdapter, SendResult
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+
+def _network_error(cause=None, text=None):
+    from telegram.error import NetworkError
+    err = NetworkError(text or f"httpx.{type(cause).__name__}: {cause}")
+    err.__cause__ = cause
+    return err
+
+
+def _connect_error():
+    return _network_error(httpx.ConnectError("All connection attempts failed"))
+
+
+def _bad_gateway():
+    return _network_error(text="Bad Gateway")
+
+
+def _read_error():
+    return _network_error(httpx.ReadError("Server disconnected without sending a response."))
+
+
+@pytest.fixture
+def adapter(monkeypatch):
+    monkeypatch.setattr("asyncio.sleep", AsyncMock())
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="123456:test-token", extra={}))
+    adapter._bot = MagicMock()
+    adapter._compress_image_to_jpeg = lambda _path: None
+    for name in ("send_document", "send_image_file", "send_video"):
+        monkeypatch.setattr(BasePlatformAdapter, name, AsyncMock(
+            return_value=SendResult(success=False, error="notice")))
+    return adapter
+
+
+def _uploads(adapter, method, outcomes):
+    """Bot method that fails with ``outcomes`` in order, then posts; records the bytes each try read."""
+    reads = []
+
+    async def upload(**kwargs):
+        reads.append(kwargs[method.removeprefix("send_")].read())
+        outcome = outcomes[len(reads) - 1] if len(reads) <= len(outcomes) else None
+        if outcome is not None:
+            raise outcome
+        return SimpleNamespace(message_id=77)
+
+    setattr(adapter._bot, method, upload)
+    return reads
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("first", [_connect_error, _bad_gateway], ids=["connect-error", "telegram-502"])
+async def test_unsent_upload_is_repeated_and_delivered(adapter, tmp_path, first):
+    path = tmp_path / "package.zip"
+    path.write_bytes(b"zip-bytes")
+    reads = _uploads(adapter, "send_document", [first()])
+
+    result = await adapter.send_document("123", str(path))
+
+    assert result.success is True and result.message_id == "77"
+    assert reads == [b"zip-bytes", b"zip-bytes"]  # the same upload again, rewound
+    BasePlatformAdapter.send_document.assert_not_awaited()  # no "Couldn't deliver" notice
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("error", [_connect_error, _bad_gateway], ids=["connect-error", "telegram-502-outage"])
+async def test_unsent_retries_are_bounded(adapter, tmp_path, error):
+    """Telegram's 5xx JSON on every try still means nothing was posted: a definite failure with the
+    notice, never reported as maybe-delivered."""
+    path = tmp_path / "package.zip"
+    path.write_bytes(b"zip-bytes")
+    reads = _uploads(adapter, "send_document", [error() for _ in range(5)])
+
+    result = await adapter.send_document("123", str(path))
+
+    assert len(reads) == 3
+    assert result.success is False and not (result.raw_response or {}).get("ambiguous")
+    BasePlatformAdapter.send_document.assert_awaited_once()  # the notice, once the budget is spent
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("method,call", [
+    ("send_document", lambda a, p: a.send_document("123", p)),
+    ("send_photo", lambda a, p: a.send_image_file("123", p)),
+    ("send_video", lambda a, p: a.send_video("123", p)),
+], ids=["document", "photo", "video"])
+async def test_upload_lost_after_the_request_left_is_never_resent(adapter, tmp_path, method, call):
+    path = tmp_path / ("clip.mp4" if method == "send_video" else "chart.png")
+    path.write_bytes(b"media-bytes")
+    reads = _uploads(adapter, method, [_read_error()])
+    adapter._bot.send_document = adapter._bot.send_document if method == "send_document" else AsyncMock()
+
+    result = await call(adapter, str(path))
+
+    assert len(reads) == 1
+    assert result.success is True and result.raw_response.get("ambiguous") is True  # unknown, not failed
+    if method != "send_document":
+        adapter._bot.send_document.assert_not_awaited()  # no re-upload as a document
+    for name in ("send_document", "send_image_file", "send_video"):
+        getattr(BasePlatformAdapter, name).assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("method", ["send_image", "send_animation"])
+async def test_url_media_lost_after_the_request_left_falls_back_to_nothing(adapter, monkeypatch, method):
+    """A URL photo whose request may have posted is not downloaded and re-uploaded, and a lost
+    animation is not resent as a photo: one request, no notice."""
+    calls = []
+
+    async def lost(**kwargs):
+        calls.append(kwargs)
+        raise _read_error()
+
+    adapter._bot.send_photo = lost
+    adapter._bot.send_animation = lost
+    monkeypatch.setattr("tools.url_safety.is_safe_url", lambda _url: True)
+    base_send_image = AsyncMock()
+    monkeypatch.setattr(BasePlatformAdapter, "send_image", base_send_image)
+    monkeypatch.setattr("tools.url_safety.create_ssrf_safe_async_client", MagicMock(
+        side_effect=AssertionError("the photo must not be downloaded for a re-upload")))
+
+    result = await getattr(adapter, method)("123", "https://example.com/a.gif")
+
+    assert len(calls) == 1
+    assert result.success is False and result.raw_response.get("delivery_uncertain") is True
+    assert result.raw_response.get("failure_notice_sent") is True  # the dispatcher posts no notice
+    base_send_image.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_local_error_before_the_request_is_still_a_failure(adapter, tmp_path, monkeypatch):
+    """An OSError raised before any request (the file vanished between check and open) never left:
+    it is a plain failure with its notice, not a maybe-delivered upload."""
+    path = tmp_path / "package.zip"
+    path.write_bytes(b"zip-bytes")
+    adapter._bot.send_document = AsyncMock()
+    monkeypatch.setattr("builtins.open", MagicMock(side_effect=PermissionError("denied")))
+
+    result = await adapter.send_document("123", str(path))
+
+    assert result.success is False
+    adapter._bot.send_document.assert_not_awaited()
+    BasePlatformAdapter.send_document.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_standalone_sender_repeats_unsent_and_never_resends_a_lost_upload(tmp_path, monkeypatch):
+    """The out-of-process sender (send_message tool, cron) follows the same policy."""
+    from plugins.platforms.telegram import standalone
+    monkeypatch.setattr("asyncio.sleep", AsyncMock())
+    path = tmp_path / "package.zip"
+    path.write_bytes(b"zip-bytes")
+    bot = SimpleNamespace()
+    reads = []
+
+    def upload_with(outcomes):
+        reads.clear()
+
+        async def upload(**kwargs):
+            reads.append(kwargs["document"].read())
+            if len(reads) <= len(outcomes):
+                raise outcomes[len(reads) - 1]
+            return SimpleNamespace(message_id=5)
+        bot.send_document = upload
+
+    kw = dict(caption=None, parse_mode=None, has_html=False, thread_kwargs={}, force_document=False)
+    upload_with([_connect_error()])
+    msg = await standalone._telegram_send_one_media(bot, 123, str(path), False, **kw)
+    assert msg.message_id == 5 and reads == [b"zip-bytes", b"zip-bytes"]
+
+    upload_with([_read_error()])
+    with pytest.raises(Exception):
+        await standalone._telegram_send_one_media(bot, 123, str(path), False, **kw)
+    assert len(reads) == 1
+
+
+@pytest.mark.asyncio
+async def test_album_photo_lost_after_the_request_left_is_reported_ambiguous(adapter, monkeypatch):
+    """A refused album falls back photo by photo; a photo whose request may have posted is reported
+    as possibly delivered (``ambiguous``), never as a failure a caller would answer with a resend."""
+    from telegram.error import BadRequest
+
+    calls = []
+
+    async def lost(**kwargs):
+        calls.append(kwargs)
+        raise _read_error()
+
+    adapter._bot.send_media_group = AsyncMock(side_effect=BadRequest("Wrong file identifier/http url specified"))
+    adapter._bot.send_photo = lost
+    monkeypatch.setattr("tools.url_safety.is_safe_url", lambda _url: True)
+
+    result = await adapter.send_multiple_images("123", [("https://example.com/a.png", ""), ("https://example.com/b.png", "")])
+
+    assert len(calls) == 2  # one request per photo, none resent
+    assert result.success is True and result.raw_response["ambiguous"] is True
+    assert result.raw_response["failed"] == []
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("images", [
+    [("https://example.com/a.gif", "")],
+    [("https://example.com/a.gif", ""), ("https://example.com/b.png", "")],
+])
+async def test_a_gif_whose_receipt_was_lost_keeps_the_batch_ambiguous(adapter, monkeypatch, images):
+    """A GIF upload that left but got no answer may be in the chat: the batch (GIF-only, or GIF
+    beside a still photo that posted) reports it possibly delivered, never a definite failure."""
+    calls = []
+
+    async def lost(**kwargs):
+        calls.append(kwargs)
+        raise _read_error()
+
+    adapter._bot.send_animation = lost
+    adapter._bot.send_media_group = AsyncMock(return_value=[SimpleNamespace(message_id=9)])
+    adapter._bot.send_photo = AsyncMock(return_value=SimpleNamespace(message_id=9))
+    monkeypatch.setattr("tools.url_safety.is_safe_url", lambda _url: True)
+
+    result = await adapter.send_multiple_images("123", images)
+
+    assert len(calls) == 1  # never resent
+    assert result.success is True and result.raw_response["ambiguous"] is True
diff --git a/tests/gateway/test_telegram_native_draft_budget.py b/tests/gateway/test_telegram_native_draft_budget.py
new file mode 100644
index 0000000000..e12cf4c611
--- /dev/null
+++ b/tests/gateway/test_telegram_native_draft_budget.py
@@ -0,0 +1,158 @@
+"""Telegram native draft previews: one shared draft/typing budget, a short RetryAfter keeps drafts on,
+the UTF-16 bound holds for astral text, and the opt-in ``plain_drafts`` frames only ever grow.
+
+Real ``GatewayStreamConsumer`` + real ``TelegramAdapter``; only the Bot transport is a fake.
+"""
+
+import asyncio
+import itertools
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway.config import PlatformConfig
+from gateway.platforms.base import utf16_len
+from gateway.stream_consumer import GatewayStreamConsumer, StreamConsumerConfig
+from plugins.platforms.telegram.adapter import TelegramAdapter
+from tests.waiting import async_wait_until
+
+
+class _Flood(Exception):
+    def __init__(self, seconds: float) -> None:
+        super().__init__(f"Flood control exceeded. Retry in {seconds} seconds")
+        self.retry_after = seconds
+
+
+def _adapter(**extra) -> TelegramAdapter:
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="***", extra=extra))
+    adapter._bot = MagicMock()
+    adapter._bot.send_message_draft = AsyncMock(return_value=True)
+    adapter._bot.send_chat_action = AsyncMock(return_value=True)
+    adapter._bot.send_message = AsyncMock(return_value=SimpleNamespace(message_id=9))
+    return adapter
+
+
+@pytest.mark.asyncio
+async def test_drafts_and_typing_share_one_per_chat_budget():
+    """20 calls per 5 s per chat across sendMessageDraft and sendChatAction: frame 21 is skipped
+    locally (no request), typing is quiet while drafts spend the budget, another chat is unaffected."""
+    adapter = _adapter()
+    for i in range(20):
+        assert (await adapter.send_draft("123", 7, f"frame {i}")).success
+    skipped = await adapter.send_draft("00123", 7, "frame 20")
+    assert skipped.success and skipped.raw_response == {"skipped": True} and skipped.retry_after > 0
+    assert adapter._bot.send_message_draft.await_count == 20
+    await adapter.send_typing("123")
+    adapter._bot.send_chat_action.assert_not_awaited()
+    assert not (await adapter.send_draft("456", 8, "other chat")).raw_response
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("plain", [False, True], ids=["default", "plain_drafts"])
+async def test_astral_draft_respects_the_utf16_limit(plain):
+    adapter = _adapter(plain_drafts=plain)
+    content = "😀" * 2100  # 2,100 code points, 4,200 UTF-16 units
+    await adapter.send_draft("123", 7, content)
+    sent = adapter._bot.send_message_draft.call_args.kwargs["text"]
+    assert utf16_len(sent) <= adapter.MAX_MESSAGE_LENGTH
+    if plain:
+        assert sent == "😀" * 2048  # a raw prefix: no chunk marker, no split surrogate
+
+
+async def _stream(adapter, deltas, final, *, cursor=" ▉"):
+    consumer = GatewayStreamConsumer(adapter, "123", StreamConsumerConfig(
+        transport="draft", chat_type="dm", edit_interval=0.01, buffer_threshold=1, cursor=cursor))
+    task = asyncio.create_task(consumer.run())
+    for delta in deltas:
+        before = adapter._bot.send_message_draft.await_count
+        consumer.on_delta(delta)
+        await async_wait_until(lambda: adapter._bot.send_message_draft.await_count > before, timeout=5,
+                               what=f"a draft frame for {delta!r}")
+    consumer.finish(final)
+    await asyncio.wait_for(task, timeout=10)
+    return consumer
+
+
+@pytest.mark.asyncio
+async def test_short_retry_after_keeps_native_drafts_for_the_rest_of_the_reply():
+    """A 1 s RetryAfter on one frame pauses previews; it never switches the reply to edit streaming."""
+    adapter = _adapter()
+    adapter._bot.send_message_draft.side_effect = [True, _Flood(1), True, True, True, True, True, True]
+    final = "first part, second part, third part, done."
+    consumer = await _stream(adapter, ["first part,", " second part,", " third part,", " done."], final)
+    assert consumer._use_draft_streaming is True
+    assert adapter._bot.send_message_draft.await_count >= 3  # previews resumed after the window
+    adapter._bot.edit_message_text.assert_not_called()
+    assert adapter._bot.send_message.await_count == 1  # exactly one durable final
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("plain", [True, False], ids=["plain_drafts", "default"])
+async def test_plain_drafts_frames_only_grow(plain):
+    """``plain_drafts``: raw text, no cursor, no synthetic fence, so every frame is a prefix of the
+    next. Default: MarkdownV2 previews as before (formatting parity), still without the cursor."""
+    adapter = _adapter(plain_drafts=plain)
+    deltas = ["Code:\n```python\nprint(", "'hello')\n```\nAnd **bold", " text** done."]
+    final = "".join(deltas)
+    await _stream(adapter, deltas, final)
+    frames = [c.kwargs for c in adapter._bot.send_message_draft.await_args_list]
+    assert frames and all("▉" not in f["text"] for f in frames)
+    if plain:
+        texts = [f["text"] for f in frames]
+        assert all("parse_mode" not in f for f in frames)
+        assert all(b.startswith(a) for a, b in itertools.pairwise(texts)), texts
+        assert texts[-1] == final
+    else:
+        assert all(f.get("parse_mode") for f in frames)
+    # The persistent final keeps its normal MarkdownV2 rendering either way.
+    assert adapter._bot.send_message.await_args.kwargs.get("parse_mode")
+
+
+@pytest.mark.asyncio
+async def test_plain_drafts_wins_over_rich_drafts():
+    adapter = _adapter(plain_drafts=True, rich_messages=True, rich_drafts=True)
+    adapter._bot.do_api_request = AsyncMock(return_value=True)
+    content = "| a | b |\n|---|---|\n| 1 | 2 |"
+    assert (await adapter.send_draft("123", 7, content)).success
+    adapter._bot.do_api_request.assert_not_awaited()  # no sendRichMessageDraft
+    assert adapter._bot.send_message_draft.await_args.kwargs == {"chat_id": 123, "draft_id": 7, "text": content}
+
+
+@pytest.mark.asyncio
+async def test_dm_topic_typing_retry_spends_its_own_budget_slot():
+    """The topic-less typing retry is a second request: it claims a slot, and is skipped when none is left."""
+    adapter = _adapter()
+    adapter._dm_topic_fallback = lambda metadata: True
+    adapter._message_thread_id_for_typing = lambda thread_id: 5
+    adapter._bot.send_chat_action.side_effect = [RuntimeError("Bad Request: message thread not found"), True]
+    for i in range(18):
+        await adapter.send_draft("123", 7, f"frame {i}")
+    await adapter.send_typing("123", metadata={"thread_id": "5"})
+    assert adapter._bot.send_chat_action.await_count == 2  # 18 drafts + 2 typing = the 20-call window
+    assert (await adapter.send_draft("123", 7, "over")).raw_response == {"skipped": True}
+
+    adapter2 = _adapter()
+    adapter2._dm_topic_fallback = lambda metadata: True
+    adapter2._message_thread_id_for_typing = lambda thread_id: 5
+    adapter2._bot.send_chat_action.side_effect = RuntimeError("Bad Request: message thread not found")
+    for i in range(19):
+        await adapter2.send_draft("123", 7, f"frame {i}")
+    await adapter2.send_typing("123", metadata={"thread_id": "5"})
+    assert adapter2._bot.send_chat_action.await_count == 1  # no slot left for the retry
+
+
+def test_plain_drafts_reaches_the_adapter_from_config_yaml(tmp_path, monkeypatch):
+    """Both documented nestings load through the gateway's config loader into the adapter."""
+    import json
+
+    from gateway.config import Platform, load_gateway_config
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    for doc in ({"telegram": {"extra": {"plain_drafts": True}}},
+                {"platforms": {"telegram": {"extra": {"plain_drafts": True}}}}):
+        (tmp_path / "config.yaml").write_text(json.dumps(doc))
+        platform_config = load_gateway_config().platforms[Platform.TELEGRAM]
+        assert TelegramAdapter(platform_config).DRAFT_STREAM_PREFIX_STABLE is True, doc
+    (tmp_path / "config.yaml").write_text(json.dumps({"telegram": {"extra": {"plain_drafts": False}}}))
+    assert TelegramAdapter(load_gateway_config().platforms[Platform.TELEGRAM]).DRAFT_STREAM_PREFIX_STABLE is False
