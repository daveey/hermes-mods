diff --git a/tests/gateway/test_media_spaced_path_dedup.py b/tests/gateway/test_media_spaced_path_dedup.py
new file mode 100644
index 0000000000..92d935dd38
--- /dev/null
+++ b/tests/gateway/test_media_spaced_path_dedup.py
@@ -0,0 +1,65 @@
+"""A ``MEDIA:`` tag whose known-extension path contains a space is ONE attachment (#78383).
+
+The extension-less scanner also walks that tag, stops at the first space, and validates the
+truncated prefix on disk. Through a symlinked directory (or with Windows separators) that prefix
+resolves to the same file under another spelling, and the string dedupe uploaded it twice. When the
+prefix is itself a real file, a second, unrelated file was attached.
+"""
+
+import os
+
+from gateway.platforms.base import BasePlatformAdapter
+
+
+def _allow(monkeypatch, root):
+    monkeypatch.setattr("gateway.platforms.base.MEDIA_DELIVERY_SAFE_ROOTS", (str(root),))
+    monkeypatch.delenv("HERMES_MEDIA_DELIVERY_STRICT", raising=False)
+
+
+def test_spaced_path_through_a_symlink_is_one_attachment(tmp_path, monkeypatch):
+    real = tmp_path / "real"
+    (real / "Hermes Agent").mkdir(parents=True)
+    (real / "Hermes Agent" / "notes.md").write_text("hi", encoding="utf-8")
+    link = tmp_path / "link"
+    link.symlink_to(real)
+    _allow(monkeypatch, tmp_path)
+
+    media, cleaned = BasePlatformAdapter.extract_media(f"Done.\nMEDIA:{link}/Hermes Agent/notes.md\n")
+
+    assert media == [(f"{link}/Hermes Agent/notes.md", False)]
+    assert cleaned == "Done."
+
+
+def test_spaced_path_prefix_that_is_another_file_is_not_attached(tmp_path, monkeypatch):
+    (tmp_path / "My Documents").mkdir()
+    (tmp_path / "My Documents" / "x.md").write_text("wanted", encoding="utf-8")
+    (tmp_path / "My").write_text("unrelated", encoding="utf-8")  # the path cut at its first space
+    _allow(monkeypatch, tmp_path)
+
+    media, cleaned = BasePlatformAdapter.extract_media(f"Here.\nMEDIA:{tmp_path}/My Documents/x.md\n")
+
+    assert [os.path.basename(p) for p, _ in media] == ["x.md"]
+    assert cleaned == "Here."
+
+
+def test_same_line_extensionless_tag_before_a_known_one_is_still_delivered(tmp_path, monkeypatch):
+    """The known-extension regex reads ``MEDIA:a MEDIA:b.pdf`` as one path; that glued match must not
+    hide the extensionless tag the validated pass delivers."""
+    (tmp_path / "Caddyfile").write_text("localhost {}", encoding="utf-8")
+    (tmp_path / "report.pdf").write_bytes(b"%PDF")
+    _allow(monkeypatch, tmp_path)
+
+    media, _ = BasePlatformAdapter.extract_media(f"MEDIA:{tmp_path}/Caddyfile MEDIA:{tmp_path}/report.pdf")
+
+    assert str((tmp_path / "Caddyfile").resolve()) in [p for p, _ in media]
+
+
+def test_prose_ending_in_a_known_extension_never_hides_the_real_attachment(tmp_path, monkeypatch):
+    """``MEDIA:/x/run.py — exported as out.png`` reads as one known-extension path that is no file;
+    only a real file's span may hide the extensionless match, so run.py is still delivered."""
+    (tmp_path / "run.py").write_text("print(1)", encoding="utf-8")
+    _allow(monkeypatch, tmp_path)
+
+    media, _ = BasePlatformAdapter.extract_media(f"MEDIA:{tmp_path}/run.py — exported as out.png")
+
+    assert str((tmp_path / "run.py").resolve()) in [p for p, _ in media]
diff --git a/tests/gateway/test_multiplex_streaming_config.py b/tests/gateway/test_multiplex_streaming_config.py
new file mode 100644
index 0000000000..43bd295614
--- /dev/null
+++ b/tests/gateway/test_multiplex_streaming_config.py
@@ -0,0 +1,74 @@
+"""Served-profile streaming configuration under multiplex (#136972).
+
+A multiplexed gateway's ``runner.config`` is the launch profile's alone; a turn run by a served
+profile must take ``streaming`` from that profile's own GatewayConfig, on both stream-consumer
+gates (the normal turn path and the proxy path).
+"""
+
+from types import SimpleNamespace
+
+import pytest
+
+import gateway.run as gateway_run
+from gateway.config import GatewayConfig, Platform, StreamingConfig
+from gateway.run_turn import GatewayTurnMixin
+from gateway.run_turn_runner import TurnRunner
+from gateway.session import SessionSource
+
+
+class _Consumer:
+    def __init__(self, **kwargs):
+        self.config = kwargs["config"]
+        self.stream_deltas_enabled = False
+
+
+def _source(profile):
+    return SessionSource(platform=Platform.TELEGRAM, chat_id="chat", chat_type="dm", profile=profile)
+
+
+def _runner(host_enabled, served_enabled, *, multiplex=True):
+    host = GatewayConfig(streaming=StreamingConfig(enabled=host_enabled))
+    host.multiplex_profiles = multiplex
+    return SimpleNamespace(
+        config=host, _primary_profile_name="default",
+        _profile_configs={"chief": GatewayConfig(streaming=StreamingConfig(enabled=served_enabled))},
+        _delivery_adapter_for=lambda _source: SimpleNamespace(SUPPORTS_MESSAGE_EDITING=True),
+        _build_stream_consumer_config=lambda _s, config, _a, **_k: (SimpleNamespace(transport=config.transport), None),
+    )
+
+
+# (host streaming, served streaming, profile running the turn, multiplex) -> stream consumer built
+CASES = [
+    (False, True, "chief", True, True),     # the report: served profile on, host off
+    (True, False, "chief", True, False),    # served profile off wins over the host's on
+    (True, False, "default", True, True),   # the launch profile keeps its own switch
+    (False, True, "ghost", True, False),    # an uncached profile falls back to the launch config
+    (False, True, "chief", False, False),   # single-profile gateway: runner.config is the profile's
+]
+
+
+@pytest.mark.parametrize(("host", "served", "profile", "multiplex", "expect"), CASES)
+def test_turn_stream_consumer_follows_the_profile_running_the_turn(monkeypatch, host, served, profile,
+                                                                    multiplex, expect):
+    monkeypatch.setattr("gateway.stream_consumer.GatewayStreamConsumer", _Consumer)
+    ctx = SimpleNamespace(
+        mute_notification_reply=False, streaming_tts_consumer_holder=[None], user_config={},
+        resolve_display_setting=lambda *_args: None, scheduled_heartbeat=False,
+        interim_assistant_messages_enabled=False, source=_source(profile), _status_thread_metadata=None,
+        progress_queue=None, event_message_id=None, _run_still_current=lambda: True,
+        stream_consumer_holder=[None],
+    )
+    consumer, callback, _, _ = TurnRunner(_runner(host, served, multiplex=multiplex), ctx)._setup_stream_consumer(
+        "telegram")
+    assert (consumer is not None) is expect
+    assert (callback is not None) is expect
+
+
+@pytest.mark.parametrize(("host", "served", "profile", "multiplex", "expect"), CASES)
+def test_proxy_stream_consumer_follows_the_profile_running_the_turn(monkeypatch, host, served, profile,
+                                                                     multiplex, expect):
+    monkeypatch.setattr("gateway.stream_consumer.GatewayStreamConsumer", _Consumer)
+    monkeypatch.setattr(gateway_run, "_load_gateway_config", dict)
+    consumer = GatewayTurnMixin._proxy_stream_consumer(
+        _runner(host, served, multiplex=multiplex), _source(profile), None, None, lambda: True)
+    assert (consumer is not None) is expect
