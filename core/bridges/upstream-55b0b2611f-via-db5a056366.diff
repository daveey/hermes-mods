@@ -0,0 +1,83 @@
+"""A managed local model is never sent a reasoning effort its chat template refuses.
+
+Regression for #136324: Qwen3.8's template raises on ``minimal`` and ``max``, llama-server answers
+HTTP 500, and every retry repeats the same request. The catalog lists the levels each template
+accepts; the request and the picker's "sends X" hint both clamp onto them.
+"""
+
+import pytest
+
+from agent.reasoning_effort import EFFORT_LADDER, effort_display_label
+from hermes_cli.local_runtime import catalog, growth
+
+MANAGED = "http://127.0.0.1:18434/v1"
+
+
+@pytest.fixture
+def managed_endpoint(monkeypatch):
+    monkeypatch.setattr(growth, "is_managed_endpoint", lambda url: url == MANAGED)
+
+
+def _model(entry_id):
+    return catalog.catalog_by_id()[entry_id].variants[0].model_id
+
+
+def _wire_effort(model_id, reasoning_config, base_url=MANAGED):
+    from agent.transports.chat_completions import ChatCompletionsTransport
+    from providers import get_provider_profile
+
+    wire = ChatCompletionsTransport().build_kwargs(
+        model=model_id, messages=[{"role": "user", "content": "Hello"}],
+        provider_profile=get_provider_profile("llamacpp"), base_url=base_url,
+        reasoning_config=reasoning_config)
+    return wire.get("reasoning_effort")
+
+
+@pytest.mark.parametrize("asked,sent", [
+    ("max", "xhigh"), ("ultra", "xhigh"), ("minimal", "low"),
+    ("low", "low"), ("medium", "medium"), ("high", "high"), ("xhigh", "xhigh"),
+])
+def test_qwen38_gets_the_nearest_level_its_template_accepts(managed_endpoint, asked, sent):
+    assert _wire_effort(_model("qwen3.8-27b"), {"enabled": True, "effort": asked}) == sent
+
+
+@pytest.mark.parametrize("off", [{"enabled": False}, {"enabled": True, "effort": "none"}])
+def test_turning_thinking_off_still_sends_none(managed_endpoint, off):
+    assert _wire_effort(_model("qwen3.8-27b"), off) == "none"
+
+
+def test_a_background_call_to_the_same_model_is_clamped_too(managed_endpoint):
+    from agent.auxiliary_client import _build_call_kwargs
+
+    kwargs = _build_call_kwargs(
+        "custom", _model("qwen3.8-27b"), [{"role": "user", "content": "Hello"}],
+        reasoning_config={"enabled": True, "effort": "max"}, base_url=MANAGED)
+    assert kwargs["reasoning_effort"] == "xhigh"
+
+
+def test_a_model_whose_template_takes_any_level_keeps_the_request(managed_endpoint):
+    for model_id in (_model("nemotron-3.5-bolt-74b-a9b"), "a-sideloaded-model"):
+        assert _wire_effort(model_id, {"enabled": True, "effort": "max"}) == "max"
+
+
+def test_another_server_serving_the_same_model_name_keeps_the_request(managed_endpoint):
+    sent = _wire_effort(_model("qwen3.8-27b"), {"enabled": True, "effort": "max"},
+                        base_url="http://192.168.1.20:8080/v1")
+    assert sent == "max"
+
+
+def test_the_picker_hint_names_the_level_actually_sent(managed_endpoint):
+    from gateway.session_local import effort_fields
+
+    model_id = _model("qwen3.8-27b")
+    info = effort_fields({"enabled": True, "effort": "max"}, "", model_id, "custom", MANAGED)
+    assert (info["reasoning_effort"], info["reasoning_effort_wire"]) == ("max", "xhigh")
+    assert effort_display_label("max", "llamacpp", model_id) == "max (sends xhigh on this route)"
+    assert effort_display_label("high", "llamacpp", model_id) == "high"
+    assert effort_display_label("none", "llamacpp", model_id) == "none"
+
+
+def test_catalog_effort_levels_are_levels_hermes_can_send():
+    sendable = set(EFFORT_LADDER) - {"none", "ultra"}
+    for entry in catalog.CATALOG:
+        assert set(entry.reasoning_efforts) <= sendable, entry.id
diff --git a/tests/hermes_cli/test_local_runtime_kv_q8.py b/tests/hermes_cli/test_local_runtime_kv_q8.py
new file mode 100644
index 0000000000..9c3748664a
--- /dev/null
+++ b/tests/hermes_cli/test_local_runtime_kv_q8.py
@@ -0,0 +1,83 @@
+"""The managed launch must not force a q8_0 KV cache on architectures whose attention head
+dims 32 cannot divide: llama.cpp refuses to boot those models
+("V cache type q8_0 with block size 32 does not divide n_embd_head_v=72", as with
+Kimi-Linear-48B-A3B's head_dim_v=72), and the managed runtime turns the refusal into an HTTP 500
+while a hand-launched server with the default f16 cache runs fine.
+
+The contract under test: profile_from_gguf flags such architectures (kv_q8_ok=False), the launch
+flags fall back to an f16 KV cache, and the context estimator prices the doubled KV so the 64K
+memory guarantee still holds.
+"""
+
+from __future__ import annotations
+
+from hermes_cli.local_runtime.context_policy import WindowDecision, launch_args
+from hermes_cli.local_runtime.estimator import ctx_bytes, kv_dtype_factor, profile_from_gguf
+from hermes_cli.local_runtime.gguf import GGUFHeader
+
+_ARCH = "kimi-linear-test"
+
+
+def _header(**extra_metadata) -> GGUFHeader:
+    metadata = {
+        "general.architecture": _ARCH,
+        f"{_ARCH}.block_count": 4,
+        f"{_ARCH}.context_length": 131072,
+        f"{_ARCH}.attention.head_count_kv": 8,
+        f"{_ARCH}.attention.key_length": 576,
+        f"{_ARCH}.attention.value_length": 72,  # 72 % 32 != 0: q8_0 blocks cannot serve it
+        **extra_metadata,
+    }
+    return GGUFHeader(path="test.gguf", version=3, metadata=metadata,
+                      n_tensors=0, tensor_bytes=0, embd_table_bytes=0)
+
+
+def _args(profile, **kwargs) -> list[str]:
+    decision = WindowDecision(window=131072, spill_bytes=0, kv_on_gpu=True)
+    return launch_args(profile, decision, **kwargs)
+
+
+def test_head_dim_not_divisible_by_32_disables_kv_q8():
+    profile = profile_from_gguf(_header())
+    assert profile.kv_q8_ok is False
+
+    args = _args(profile)
+    assert args[args.index("-ctk") + 1] == "f16"
+    assert args[args.index("-ctv") + 1] == "f16"
+
+
+def test_swa_head_dim_not_divisible_disables_kv_q8_too():
+    profile = profile_from_gguf(_header(**{
+        f"{_ARCH}.attention.sliding_window_pattern": [1, 1, 1, 1],
+        f"{_ARCH}.attention.key_length_swa": 576,
+        f"{_ARCH}.attention.value_length_swa": 72,
+    }))
+    assert profile.kv_q8_ok is False
+
+
+def test_divisible_head_dims_keep_the_q8_kv_cache():
+    profile = profile_from_gguf(_header(**{f"{_ARCH}.attention.value_length": 128}))
+    assert profile.kv_q8_ok is True
+
+    args = _args(profile)
+    assert args[args.index("-ctk") + 1] == "q8_0"
+    assert args[args.index("-ctv") + 1] == "q8_0"
+
+
+def test_non_divisible_dims_are_priced_at_full_f16_kv():
+    profile = profile_from_gguf(_header())
+    window = 65536
+    with_fa = ctx_bytes(profile, window, flash_attention=True)
+    without_fa = ctx_bytes(profile, window, flash_attention=False)
+    # Same memory plan as the non-FA posture: the physics check must see the doubled KV.
+    assert with_fa == without_fa
+    assert kv_dtype_factor(flash_attention=True, kv_q8_ok=profile.kv_q8_ok) == 1.0
+
+
+def test_divisible_dims_keep_the_q8_memory_discount():
+    profile = profile_from_gguf(_header(**{f"{_ARCH}.attention.value_length": 128}))
+    window = 65536
+    with_fa = ctx_bytes(profile, window, flash_attention=True)
+    without_fa = ctx_bytes(profile, window, flash_attention=False)
+    assert with_fa < without_fa
+    assert kv_dtype_factor(flash_attention=True, kv_q8_ok=profile.kv_q8_ok) < 1.0
