@@ -0,0 +1,84 @@
+"""Empty-response retries reach a chat as ONE reply, the plain explanation (#101138).
+
+The retry counter (``retrying (1/3) in 8s``) and the terminal "no content after all retries"
+status used to slip past the chat noise filter and arrive beside the turn's own explanation.
+"""
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from agent import turn_empty_response as ter
+from gateway.run import _prepare_gateway_status_message
+
+
+@pytest.mark.parametrize("message", [
+    "⚠️ Empty response from model — retrying (1/3) in 8s",
+    "⚠️ Empty response from model — retrying (1/1) in 6s — high-cost request, reduced retry budget",
+    "⏳ Retrying in 4.2s (attempt 1/3)...",
+])
+def test_counted_retry_chatter_stays_out_of_chats_but_not_the_cli(message):
+    assert _prepare_gateway_status_message("telegram", "status", message) is None
+    assert _prepare_gateway_status_message("local", "status", message) == message
+
+
+@pytest.mark.parametrize("reasoning", [None, "thought about it"])
+def test_terminal_empty_status_is_left_to_the_final_reply(reasoning):
+    agent = MagicMock()
+    agent._empty_streak_cost_usd = None  # no cost estimate: the streak-cost line is skipped
+    agent._extract_reasoning.return_value = reasoning
+    agent._build_assistant_message.return_value = {"role": "assistant"}
+    agent._fallback_chain = []
+    emitted = []
+    agent._emit_diagnostic_status.side_effect = emitted.append
+    assert ter._terminal_empty(agent, SimpleNamespace(), "stop", []) == "(empty)"
+    (status,) = emitted
+    # The chat's copy is dropped (the final reply explains the empty turn); the CLI keeps it.
+    assert _prepare_gateway_status_message("telegram", "status", status) is None
+    assert _prepare_gateway_status_message("local", "status", status) == status
+
+
+def test_other_warnings_still_reach_the_chat():
+    text = "⚠️ Tool output was truncated to 50,000 characters."
+    assert _prepare_gateway_status_message("telegram", "status", text) == text
+
+
+@pytest.mark.parametrize("deterministic", [False, True])
+def test_failed_fallback_ends_on_the_plain_explanation(deterministic):
+    """Fallback configured but it cannot activate: the buffered "switching to fallback..." (and the
+    deterministic-empty "skipping further retries") flush at the end and must not be the chat's last
+    status, since nothing after them says the switch failed. The CLI keeps the whole trace."""
+    from unittest.mock import patch
+
+    from agent.status_output import StatusOutputMixin
+
+    agent = MagicMock()
+    for name in ("_buffer_retry_message", "_buffer_status", "_buffer_diagnostic_status",
+                 "_flush_status_buffer", "_emit_diagnostic_status"):
+        setattr(agent, name, getattr(StatusOutputMixin, name).__get__(agent))
+    agent._retry_status_buffer = []
+    agent._empty_streak_cost_usd = None
+    agent._current_streamed_assistant_text = ""
+    agent._has_content_after_think_block.return_value = False
+    agent._strip_think_blocks.side_effect = lambda t: t or ""
+    agent._last_content_with_tools = None
+    agent._thinking_prefill_retries = 2
+    agent._extract_reasoning.return_value = None
+    agent._build_assistant_message.return_value = {"role": "assistant"}
+    agent._fallback_chain = ["openrouter/nope"]
+    agent._try_activate_fallback.return_value = False
+    emitted = []
+    agent._emit_status.side_effect = emitted.append
+    msg = SimpleNamespace(reasoning=None, reasoning_content=None, reasoning_details=None)
+    with patch.object(ter, "_retry_empty", return_value=(None, None, deterministic)):
+        verdict = ter.recover_empty_response(
+            agent, msg, None, "stop", final_response="", messages=[{"role": "user", "content": "hi"}],
+            api_messages=[], conversation_history=[], active_system_prompt="sys", api_call_count=4,
+            turn_exit_reason=None, preflight_compression_blocked=False,
+        )
+    assert (verdict.action, verdict.final_response) == ("break", "(empty)")
+    assert any("switching to fallback" in m for m in emitted)
+    assert any("skipping further retries" in m for m in emitted) is deterministic
+    assert [m for m in emitted if _prepare_gateway_status_message("telegram", "status", m)] == []
+    assert [_prepare_gateway_status_message("local", "status", m) for m in emitted] == emitted
diff --git a/tests/gateway/test_exhaustion_replay_order.py b/tests/gateway/test_exhaustion_replay_order.py
new file mode 100644
index 0000000000..63977112a2
--- /dev/null
+++ b/tests/gateway/test_exhaustion_replay_order.py
@@ -0,0 +1,133 @@
+"""A request whose turn exhausted the context is not re-run behind follow-ups the reset re-homed onto
+the fresh session: it would answer out of order (#137565 review). Real GatewayRunner, DiscordAdapter
+and SessionAuthority over SQLite; the turn is a stand-in."""
+import pytest
+
+from gateway.session_results import execution_result
+from tests.gateway import test_native_fifo_context_exhaustion as fifo
+
+_admit = fifo._admit
+native_fifo = fifo.native  # the shared real-authority fixture, registered here under its own name
+
+
+@pytest.mark.asyncio
+async def test_exhausted_request_is_not_rerun_behind_rehomed_follow_ups(native_fifo, monkeypatch):
+    native = native_fifo
+    runner, authority, adapter = native.runner, native.authority, native.adapter
+    admitted = [await _admit(native, text) for text in ("A", "B")]
+    authority.native_waiters.add(admitted[0][1].admission_id)  # an adapter task awaits A's reply
+    executed, queued_after_reset = [], []
+
+    async def turn(event, source, session_key, run_generation):
+        entry = runner.session_store.lookup_by_session_key(session_key)
+        executed.append(event.text)
+        captured = execution_result.get()
+        if event.text == "A" and executed.count("A") == 1:
+            result = {"failed": True, "compression_exhausted": True, "messages": []}
+            captured["result"] = result
+            await runner._hmwa_compression_exhaustion_reset(result, "copy", entry, session_key, source, event=event)
+            queued_after_reset.append(adapter._pending_messages.get(session_key))
+        else:
+            captured["result"] = {"final_response": "reply", "messages": []}
+        return "reply"
+
+    monkeypatch.setattr(runner, "_handle_message_with_agent", turn)
+    await authority._drain(admitted[0][1].ref)
+    # B was re-homed onto the fresh session; A going back in the head slot would run behind it.
+    assert queued_after_reset == [None], "the exhausted request was queued behind a re-homed follow-up"
+    assert executed == ["A"], executed
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("role", ["tool", "function"], ids=["tool-result", "legacy-function"])
+async def test_compacted_tool_evidence_blocks_exhaustion_replay(native_fifo, monkeypatch, role):
+    """A stale pre-compression history_offset must not hide a completed tool from the replay guard.
+
+    Compression can leave fewer messages than the original history_offset. A calendar tool may
+    already have booked the appointment, so replaying this request would book it twice.
+    """
+    native = native_fifo
+    runner, authority, adapter = native.runner, native.authority, native.adapter
+    _event, admission = await _admit(native, "book the appointment")
+    authority.native_waiters.add(admission.admission_id)  # an adapter task awaits the reply
+    queued_after_reset = []
+
+    async def turn(event, source, session_key, run_generation):
+        entry = runner.session_store.lookup_by_session_key(session_key)
+        # The compressor replaced the old history. Its stale offset now exceeds the transcript.
+        result = {
+            "failed": True, "compression_exhausted": True, "history_offset": 10,
+            "messages": [
+                {"role": "user", "content": event.text},
+                {"role": role, "name": "calendar_create", "content": "appointment booked"},
+            ],
+        }
+        execution_result.get()["result"] = result
+        await runner._hmwa_compression_exhaustion_reset(
+            result, "copy", entry, session_key, source, event=event,
+        )
+        queued_after_reset.append(adapter._pending_messages.get(session_key))
+        return "copy"
+
+    monkeypatch.setattr(runner, "_handle_message_with_agent", turn)
+    await authority._drain(admission.ref)
+    assert queued_after_reset == [None], "a finished calendar action must not be replayed"
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("keep_user", [True, False], ids=["user-kept", "user-compacted-away"])
+async def test_compacted_assistant_tool_call_blocks_exhaustion_replay(native_fifo, monkeypatch, keep_user):
+    """The review's shape: [user, assistant(tool_calls), tool] after compression, history_offset=12.
+    With the user row compacted away the turn cannot be bounded, so it is not replayed either."""
+    native = native_fifo
+    runner, authority, adapter = native.runner, native.authority, native.adapter
+    _event, admission = await _admit(native, "book the appointment")
+    authority.native_waiters.add(admission.admission_id)  # an adapter task awaits the reply
+    queued_after_reset = []
+
+    async def turn(event, source, session_key, run_generation):
+        entry = runner.session_store.lookup_by_session_key(session_key)
+        call = {"id": "c1", "type": "function", "function": {"name": "calendar_create", "arguments": "{}"}}
+        result = {
+            "failed": True, "compression_exhausted": True, "history_offset": 12,
+            "messages": [
+                *([{"role": "user", "content": event.text}] if keep_user else []),
+                {"role": "assistant", "content": "", "tool_calls": [call]},
+                {"role": "tool", "tool_call_id": "c1", "content": "appointment booked"},
+            ],
+        }
+        execution_result.get()["result"] = result
+        await runner._hmwa_compression_exhaustion_reset(result, "copy", entry, session_key, source, event=event)
+        queued_after_reset.append(adapter._pending_messages.get(session_key))
+        return "copy"
+
+    monkeypatch.setattr(runner, "_handle_message_with_agent", turn)
+    await authority._drain(admission.ref)
+    assert queued_after_reset == [None], "a finished calendar action must not be replayed"
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("live_waiter", [True, False], ids=["adapter-task-awaits", "relay-or-recovered"])
+async def test_exhausted_request_is_parked_only_where_an_adapter_task_drains_it(native_fifo, monkeypatch, live_waiter):
+    """The retry goes in the adapter's pending slot, which only the adapter task awaiting the native
+    waiter drains after the turn. A relay or restart-recovered row has no such task: a retry parked
+    there would sit until some unrelated later turn, so it keeps the resend notice instead."""
+    native = native_fifo
+    runner, authority, adapter = native.runner, native.authority, native.adapter
+    _event, admission = await _admit(native, "plan my week")
+    if live_waiter:
+        authority.native_waiters.add(admission.admission_id)
+    queued_after_reset = []
+
+    async def turn(event, source, session_key, run_generation):
+        entry = runner.session_store.lookup_by_session_key(session_key)
+        result = {"failed": True, "compression_exhausted": True, "messages": []}
+        execution_result.get()["result"] = result
+        await runner._hmwa_compression_exhaustion_reset(result, "copy", entry, session_key, source, event=event)
+        queued_after_reset.append(adapter._pending_messages.get(session_key))
+        return "copy"
+
+    monkeypatch.setattr(runner, "_handle_message_with_agent", turn)
+    await authority._drain(admission.ref)
+    parked = queued_after_reset[0]
+    assert (parked is not None and parked.text == "plan my week") is live_waiter, parked
