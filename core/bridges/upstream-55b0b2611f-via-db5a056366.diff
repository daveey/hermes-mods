+def _bash(script, stdin="", env_vars=None, timeout=20):
+    return subprocess.run(["bash", "-c", script], input=stdin, capture_output=True, text=True, check=False,
+                          env={**os.environ, **(env_vars or {})}, timeout=timeout)
