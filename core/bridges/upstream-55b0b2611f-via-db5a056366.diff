diff --git a/tests/e2e/core/platforms/test_discord_long_reply_fallback.py b/tests/e2e/core/platforms/test_discord_long_reply_fallback.py
new file mode 100644
index 0000000000..984adad812
--- /dev/null
+++ b/tests/e2e/core/platforms/test_discord_long_reply_fallback.py
@@ -0,0 +1,78 @@
+"""A long Discord reply whose file upload is refused still arrives whole, as paced messages.
+
+A reply past ``MAX_SPLIT_MESSAGES`` goes out as one ``.md`` file (#152012). When Discord refuses the
+attachment, the gateway sends the reply as ordinary messages: every part, in order, with no
+truncation notice (Teknium's ruling on PR #153476: Discord matches Telegram and never cuts a reply
+off), and a 429 in the middle is waited out and retried by discord.py. REAL gateway + adapter
+against the Discord stand-in.
+"""
+
+from __future__ import annotations
+
+import re
+import sys
+
+import pytest
+
+from tests.e2e.core.platforms._contract import merge
+from tests.e2e.core.platforms._drv_discord import DiscordDriver
+from tests.e2e.core.platforms._helpers import Director, GatewayUnderTest
+from tests.fakes.fake_llm_provider import FakeLLMServer, Text
+from tests.fakes.platforms._standin import wait_until
+
+pytestmark = [  # as test_discord_contract.py: the general suite (it has discord.py), not the OS-only jobs
+    pytest.mark.spawns_gateway_lookalike,
+    pytest.mark.skipif(sys.platform == "win32", reason="POSIX process-group gateway harness"),
+]
+
+
+def _reply(chars: int) -> str:
+    lines = [" ".join(f"w{i}x{j}" for j in range(9)) for i in range(chars // 60 + 1)]
+    return "\n".join(lines)[:chars]
+
+
+def test_refused_upload_sends_the_whole_reply_through_a_429(tmp_path):
+    drv = DiscordDriver()
+    drv.start()
+    director = Director()
+    llm = FakeLLMServer(director)
+    llm.start()
+    cfg = merge(drv.gateway_config(), {"streaming": {"enabled": False},
+                                       "display": {"platforms": {"discord": {"streaming": False}}}})
+    gw = GatewayUnderTest(tmp_path / "rig", llm_base_url=llm.base_url, config=cfg, env=drv.gateway_env(),
+                          ready=drv.connected)
+    st, texts = drv.standin, {"n": 0}
+
+    def fifth_text_send(p):
+        if p.get("_files"):
+            return False
+        texts["n"] += 1
+        return texts["n"] == 5
+
+    try:
+        gw.start()
+        st.fail("create_message", {"message": "Missing Permissions", "code": 50013}, status=403, times=99,
+                match=lambda p: bool(p.get("_files")))
+        st.fail("create_message", {"message": "You are being rate limited.", "retry_after": 1.0, "global": False},
+                status=429, times=1, match=fifth_text_send)
+        reply = _reply(40_000)
+        director.script("long", Text(reply, chunk_chars=len(reply) + 1))
+        chat = drv.dm("long reply please [in:long]").chat_id
+        tail = reply.rsplit("\n", 1)[-1]
+
+        def shown():
+            return [re.sub(r" \(\d+/\d+\)$", "", v.text) for v in drv.visible(chat) if not v.deleted]
+
+        wait_until(lambda: any(part.endswith(tail) for part in shown()), "the reply's last line", timeout=120,
+                   on_timeout=lambda: f"{drv.describe()}\n{gw.tail(4000)}")
+        gw.wait_idle()
+        parts = shown()
+        assert len(parts) > 8  # past the cap: no 8-message cut
+        assert re.sub(r"\s+", "", "".join(parts)) == re.sub(r"\s+", "", reply)  # every char, in order, once
+        assert not any("truncated" in part.lower() for part in parts)
+        assert sum(c.faulted and c.response.get("retry_after") is not None
+                   for c in st.calls_of("create_message") if isinstance(c.response, dict)) == 1
+    finally:
+        gw.stop()
+        llm.stop()
+        drv.stop()
diff --git a/tests/e2e/core/platforms/test_telegram_exhausted_request_replayed.py b/tests/e2e/core/platforms/test_telegram_exhausted_request_replayed.py
new file mode 100644
index 0000000000..08400199c5
--- /dev/null
+++ b/tests/e2e/core/platforms/test_telegram_exhausted_request_replayed.py
@@ -0,0 +1,85 @@
+"""A Telegram request whose turn exhausts context compression is re-run once on the fresh session the
+auto-reset creates, so it is answered without the user resending it (#137565). A re-run that
+exhausts the fresh session too is not re-run again. REAL gateway + adapter against the Bot API
+stand-in; the fake model rejects the request as too long (on the fresh session too in the second leg).
+"""
+
+from __future__ import annotations
+
+import json
+import sqlite3
+import time
+from contextlib import closing
+
+import pytest
+
+from tests.e2e.core.platforms._drv_telegram import TelegramDriver
+from tests.e2e.core.platforms._helpers import Director, GatewayUnderTest
+from tests.fakes.fake_llm_provider import Error, FakeLLMServer
+from tests.fakes.platforms._standin import wait_until
+
+pytestmark = [pytest.mark.spawns_gateway_lookalike, pytest.mark.platforms("posix")]
+_REQUEST = "book the dentist on friday [in:ex]"
+# A server measurement, so the overflow is believed and compression runs until it gives up.
+_TOO_LONG = "prompt is too long: 233153 tokens > 200000 maximum"
+
+
+class _Overflowing(Director):
+    """Rejects the request as too long on the exhausted session (its transcript holds the warm-up
+    turn); on the fresh session only when ``fresh_too``. Decided per request, never by timing."""
+
+    def __init__(self, fresh_too: bool) -> None:
+        super().__init__()
+        self.fresh_too = fresh_too
+
+    def __call__(self, record):
+        wire = json.dumps(record["body"].get("messages", []))
+        if "[in:ex]" in wire and (self.fresh_too or "[in:warm]" in wire):
+            return Error(400, _TOO_LONG)
+        return super().__call__(record)
+
+
+def _text(v) -> str:
+    return (v.text or "").replace("\\", "")
+
+
+@pytest.mark.parametrize("fits_after_reset", [True, False], ids=["replayed_once", "no_second_replay"])
+def test_exhausted_request_is_answered_on_the_fresh_session(tmp_path, fits_after_reset):
+    drv = TelegramDriver()
+    drv.start()
+    director = _Overflowing(fresh_too=not fits_after_reset)
+    llm = FakeLLMServer(director)
+    llm.start()
+    gw = GatewayUnderTest(tmp_path / "rig", llm_base_url=llm.base_url, config=drv.gateway_config(),
+                          env=drv.gateway_env(), ready=drv.connected)
+    try:
+        gw.start()
+        drv.dm("warm [in:warm]")
+        wait_until(lambda: drv.sends(drv.user_id), "the warm reply was sent")
+        gw.wait_idle()
+        drv.dm(_REQUEST)
+        wait_until(lambda: any("auto-reset" in _text(v).lower() for v in drv.standin.visible(drv.user_id)),
+                   "the auto-reset notice", timeout=120, on_timeout=gw.tail)
+        if fits_after_reset:
+            wait_until(lambda: director.turns.get("ex"), "the request re-ran", timeout=60, on_timeout=gw.tail)
+        # health: allow HX013 -- absence proof: a second replay or duplicate answer would land in this window
+        time.sleep(8)
+        gw.wait_idle()
+        with closing(sqlite3.connect(f"file:{gw.hermes_home / 'state.db'}?mode=ro", uri=True)) as db:
+            sessions = db.execute("SELECT id, end_reason FROM sessions ORDER BY started_at").fetchall()
+            stored = db.execute("SELECT session_id FROM messages WHERE role='user' AND content LIKE ?",
+                                (f"%{_REQUEST}%",)).fetchall()
+    finally:
+        gw.stop()
+        llm.stop()
+        drv.stop()
+    answers = [_text(v) for v in drv.standin.visible(drv.user_id) if "reply to ex" in _text(v)]
+    fresh = sessions[-1][0]
+    if fits_after_reset:
+        assert answers == ["reply to ex"], answers
+        assert director.turns.get("ex") == 1
+        assert [sid for (sid,) in stored].count(fresh) == 1, (sessions, stored)
+    else:
+        # One automatic retry only: the original turn and its single re-run, then the user decides.
+        assert answers == [] and len(sessions) == 3, sessions
+        assert [end for _, end in sessions] == ["session_reset", "session_reset", None], sessions
diff --git a/tests/e2e/core/platforms/test_telegram_stream_flood_finalize.py b/tests/e2e/core/platforms/test_telegram_stream_flood_finalize.py
new file mode 100644
index 0000000000..8cd284ffd1
--- /dev/null
+++ b/tests/e2e/core/platforms/test_telegram_stream_flood_finalize.py
@@ -0,0 +1,87 @@
+"""A streamed group reply whose final edit and fallback send are flood-refused ends as ONE complete
+message: the frozen preview is finished in place once the RetryAfter window passes, never posted a
+second time beside it (#96078, #102402, #53449). REAL gateway + adapter against the Bot API stand-in.
+"""
+
+from __future__ import annotations
+
+import threading
+import time
+
+import pytest
+
+from tests.e2e.core.platforms._contract import answer, foot, head, merge, norm
+from tests.e2e.core.platforms._drv_telegram import TelegramDriver
+from tests.e2e.core.platforms._helpers import Director, GatewayUnderTest
+from tests.fakes.fake_llm_provider import FakeLLMServer
+from tests.fakes.platforms._standin import wait_until
+
+pytestmark = [pytest.mark.spawns_gateway_lookalike, pytest.mark.platforms("posix")]
+_FLOOD_SECS = 8  # past the adapter's 5 s inline cap: the edit and the fallback send fail closed
+
+
+@pytest.fixture
+def rig(tmp_path):
+    drv = TelegramDriver()
+    drv.start()
+    director = Director()
+    llm = FakeLLMServer(director)
+    llm.start()
+    cfg = merge(drv.gateway_config(), {"streaming": {"enabled": True, "edit_interval": 0.3, "transport": "edit"},
+                                       "display": {"platforms": {"telegram": {"streaming": True}}}})
+    gw = GatewayUnderTest(tmp_path / "rig", llm_base_url=llm.base_url, config=cfg, env=drv.gateway_env(),
+                          ready=drv.connected)
+    try:
+        gw.start()
+        yield drv, director, gw
+    finally:
+        gw.stop()
+        llm.stop()
+        drv.stop()
+
+
+def _flood_after_first_preview(drv, chat: str) -> dict:
+    """Once the first preview lands, refuse every edit and send in ``chat`` with a 429 for a while."""
+    st, window = drv.standin, {"until": 0.0}
+    body = {"ok": False, "error_code": 429, "description": f"Too Many Requests: retry after {_FLOOD_SECS}",
+            "parameters": {"retry_after": _FLOOD_SECS}}
+
+    def flooded(p):
+        return str(p.get("chat_id")) == chat and time.monotonic() < window["until"]
+
+    def arm():
+        wait_until(lambda: any(not c.faulted and str(c.params.get("chat_id")) == chat
+                               for c in st.calls_of("sendMessage")), "first preview", timeout=60)
+        window["until"] = time.monotonic() + _FLOOD_SECS
+        for method in ("editMessageText", "sendMessage"):
+            st.fail(method, body, status=429, times=10_000, match=flooded)
+
+    threading.Thread(target=arm, daemon=True).start()
+    return window
+
+
+def test_flood_refused_final_is_finished_in_place_once(rig):
+    drv, director, gw = rig
+    aid = "A-flood"
+    body = " ".join(f"w{i:04d}" for i in range(250))
+    director.script("fl", answer(aid, body, chunk_chars=40, delay_per_chunk=0.02))
+    window = _flood_after_first_preview(drv, drv.group_chat_id)
+    drv.group("long answer please [in:fl]", mention=True)
+
+    def visible():
+        return [v for v in drv.visible(drv.group_chat_id) if not v.deleted]
+
+    wait_until(lambda: any(foot(aid) in norm(v.text) for v in visible()), "the complete reply", timeout=90,
+               on_timeout=lambda: f"{drv.describe()}\n{gw.tail(4000)}")
+    gw.wait_idle()
+    # A same-chat barrier turn: everything the flooded turn still meant to send is out before it.
+    director.script("flb", answer("B-flood", "barrier"))
+    drv.group("barrier [in:flb]", mention=True)
+    wait_until(lambda: any(foot("B-flood") in norm(v.text) for v in visible()), "barrier answered", timeout=60)
+    shown = [v for v in visible() if foot("B-flood") not in norm(v.text)]
+    assert any(c.faulted for c in drv.standin.calls_of("editMessageText")), "the flood never fired"
+    assert window["until"] > 0
+    assert sum(head(aid) in norm(v.text) for v in shown) == 1, f"reply shown twice: {drv.describe()}"
+    complete = [v for v in shown if head(aid) in norm(v.text) and foot(aid) in norm(v.text)]
+    assert len(complete) == 1 and "▉" not in complete[0].text, drv.describe()
+    assert director.turns.get("fl") == 1
diff --git a/tests/e2e/core/platforms/test_telegram_tls_key_exchange.py b/tests/e2e/core/platforms/test_telegram_tls_key_exchange.py
new file mode 100644
index 0000000000..bad2def106
--- /dev/null
+++ b/tests/e2e/core/platforms/test_telegram_tls_key_exchange.py
@@ -0,0 +1,222 @@
+"""Telegram's opt-in classic key exchange survives a network path that resets large ClientHellos.
+
+OpenSSL 3.5 sends a post-quantum hybrid key share by default, which makes the TLS ClientHello
+about 1.5 KB; some network paths reset a hello that large, and every Bot API path then fails with
+an empty ``ConnectError`` in a loop (#147179). A local TLS server here resets any first record over
+1,400 bytes, and the real adapter request builder drives a real PTB ``get_me`` through it.
+"""
+
+from __future__ import annotations
+
+import json
+import select
+import socket
+import ssl
+import struct
+import threading
+from datetime import UTC, datetime, timedelta
+from ipaddress import ip_address
+
+import pytest
+
+pytest.importorskip("telegram")
+from cryptography import x509
+from cryptography.hazmat.primitives import hashes, serialization
+from cryptography.hazmat.primitives.asymmetric import ec
+from cryptography.x509.oid import NameOID
+from telegram import Bot
+
+from gateway.config import PlatformConfig
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+_RESET_ABOVE = 1400
+
+
+def _default_hello_size() -> int:
+    """Bytes in this OpenSSL build's default TLS ClientHello (large only with the PQ hybrid share)."""
+    from agent.ssl_verify import platform_ssl_context
+
+    incoming, outgoing = ssl.MemoryBIO(), ssl.MemoryBIO()
+    tls = platform_ssl_context().wrap_bio(incoming, outgoing, server_hostname="127.0.0.1")
+    with pytest.raises(ssl.SSLWantReadError):
+        tls.do_handshake()
+    return len(outgoing.read())
+
+
+def _require_large_default_hello() -> None:
+    if _default_hello_size() <= _RESET_ABOVE:
+        pytest.skip("this OpenSSL sends no post-quantum key share by default; nothing for the path to reset")
+
+
+class _HelloSizeEdge:
+    """TLS edge on 127.0.0.1 that resets a connection whose ClientHello record exceeds
+    ``_RESET_ABOVE`` bytes and answers ``getMe`` otherwise."""
+
+    def __init__(self, tmp_path) -> None:
+        key = ec.generate_private_key(ec.SECP256R1())
+        name = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, "127.0.0.1")])
+        now = datetime.now(UTC)
+        cert = (x509.CertificateBuilder().subject_name(name).issuer_name(name).public_key(key.public_key())
+                .serial_number(x509.random_serial_number())
+                .not_valid_before(now - timedelta(days=1)).not_valid_after(now + timedelta(days=1))
+                .add_extension(x509.SubjectAlternativeName([x509.IPAddress(ip_address("127.0.0.1"))]), critical=False)
+                .sign(key, hashes.SHA256()))
+        self.cert_path = tmp_path / "edge.pem"
+        key_path = tmp_path / "edge.key"
+        self.cert_path.write_bytes(cert.public_bytes(serialization.Encoding.PEM))
+        key_path.write_bytes(key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8,
+                                               serialization.NoEncryption()))
+        self._ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+        self._ctx.load_cert_chain(self.cert_path, key_path)
+        self._sock = socket.create_server(("127.0.0.1", 0))
+        self.port = self._sock.getsockname()[1]
+        self.hello_sizes: list[int] = []
+        self.answered = 0
+        threading.Thread(target=self._accept, daemon=True).start()
+
+    def _accept(self) -> None:
+        while True:
+            try:
+                conn, _ = self._sock.accept()
+            except OSError:
+                return
+            threading.Thread(target=self._serve, args=(conn,), daemon=True).start()
+
+    def _serve(self, conn: socket.socket) -> None:
+        try:
+            conn.settimeout(5)
+            header = conn.recv(5, socket.MSG_PEEK)
+            size = struct.unpack("!H", header[3:5])[0] if len(header) == 5 else 0
+            self.hello_sizes.append(size)
+            if size > _RESET_ABOVE:
+                conn.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
+                return
+            tls = self._ctx.wrap_socket(conn, server_side=True)
+            request = b""
+            while b"\r\n\r\n" not in request:
+                chunk = tls.recv(65536)
+                if not chunk:
+                    return
+                request += chunk
+            body = json.dumps({"ok": True, "result": {"id": 1, "is_bot": True, "first_name": "edge",
+                                                      "username": "edge_bot"}}).encode()
+            tls.sendall(b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: %d\r\n"
+                        b"Connection: close\r\n\r\n" % len(body) + body)
+            self.answered += 1
+        except OSError:
+            pass
+        finally:
+            conn.close()
+
+    def close(self) -> None:
+        self._sock.close()
+
+
+class _HelloSizeProxy(_HelloSizeEdge):
+    """HTTPS CONNECT proxy on 127.0.0.1 with the same reset rule for ITS OWN TLS hello, serving
+    ``edge``'s certificate (one trusted cert for both legs), then tunnelling to the target."""
+
+    def __init__(self, tmp_path, edge: _HelloSizeEdge) -> None:
+        proxy_dir = tmp_path / "proxy"
+        proxy_dir.mkdir()
+        super().__init__(proxy_dir)
+        self._ctx.load_cert_chain(edge.cert_path, edge.cert_path.with_name("edge.key"))
+
+    def _serve(self, conn: socket.socket) -> None:
+        try:
+            conn.settimeout(5)
+            header = conn.recv(5, socket.MSG_PEEK)
+            size = struct.unpack("!H", header[3:5])[0] if len(header) == 5 else 0
+            self.hello_sizes.append(size)
+            if size > _RESET_ABOVE:
+                conn.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
+                return
+            tls = self._ctx.wrap_socket(conn, server_side=True)
+            request = b""
+            while b"\r\n\r\n" not in request:
+                chunk = tls.recv(65536)
+                if not chunk:
+                    return
+                request += chunk
+            host, port = request.split(b" ")[1].decode().rsplit(":", 1)
+            with socket.create_connection((host, int(port)), timeout=5) as remote:
+                tls.sendall(b"HTTP/1.1 200 Connection established\r\n\r\n")
+                while True:
+                    ready, _, _ = select.select([tls, remote], [], [], 5)
+                    if not ready:
+                        return
+                    for current in ready:
+                        data = current.recv(65536)
+                        if not data:
+                            return
+                        (remote if current is tls else tls).sendall(data)
+        except OSError:
+            pass
+        finally:
+            conn.close()
+
+
+async def _get_me_through_adapter(edge: _HelloSizeEdge, monkeypatch, extra: dict):
+    for key in ("HTTPS_PROXY", "https_proxy", "HTTP_PROXY", "http_proxy", "ALL_PROXY", "all_proxy", "TELEGRAM_PROXY"):
+        monkeypatch.delenv(key, raising=False)
+    monkeypatch.setenv("SSL_CERT_FILE", str(edge.cert_path))  # trusted on top of the platform store
+    monkeypatch.setenv("HERMES_TELEGRAM_HTTP_CONNECT_TIMEOUT", "3")
+    base_url = f"https://127.0.0.1:{edge.port}/bot"
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="123:abc", extra={
+        "base_url": base_url, "base_file_url": f"https://127.0.0.1:{edge.port}/file/bot",
+        "fallback_ips": ["149.154.166.110"], **extra}))
+    general, updates = await adapter._build_ptb_requests()
+    bot = Bot("123:abc", request=general, get_updates_request=updates, base_url=base_url)
+    try:
+        return await bot.get_me()
+    finally:
+        await bot.shutdown()
+
+
+@pytest.mark.asyncio
+async def test_classic_key_exchange_handshakes_where_the_default_hello_is_reset(tmp_path, monkeypatch):
+    edge = _HelloSizeEdge(tmp_path)
+    try:
+        if _default_hello_size() > _RESET_ABOVE:  # the failing leg needs OpenSSL's PQ default
+            with pytest.raises(Exception, match="ConnectError"):
+                await _get_me_through_adapter(edge, monkeypatch, {})
+            assert edge.hello_sizes and min(edge.hello_sizes) > _RESET_ABOVE
+            edge.hello_sizes.clear()
+
+        me = await _get_me_through_adapter(edge, monkeypatch, {"tls_classic_key_exchange": True})
+        assert me.username == "edge_bot"
+        assert edge.answered == 1
+        assert max(edge.hello_sizes) <= _RESET_ABOVE
+    finally:
