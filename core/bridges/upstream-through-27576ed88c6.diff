@@ -0,0 +1,225 @@
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+import { test } from 'vitest'
+
+import { createDesktopProfilePreferences } from './desktop-profile'
+import { PrimaryProfilePin } from './primary-profile-pin'
+import { connectPrimaryRemote } from './primary-remote-startup'
+
+const remote = {
+  baseUrl: 'https://offline.invalid',
+  wsUrl: 'wss://offline.invalid/api/ws',
+  connectionId: 'remote',
+  source: 'settings',
+  token: 'placeholder'
+}
+
+test('only a successful authoritative roster moves the primary, onto a profile that gateway serves', async ({
+  onTestFinished
+}) => {
+  const home = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-profile-restore-'))
+  const preferencePath = path.join(home, 'active-profile.json')
+  const preferences = createDesktopProfilePreferences(preferencePath)
+  onTestFinished(() => fs.rmSync(home, { recursive: true, force: true }))
+
+  const cases = [
+    { name: 'deleted', listing: { profiles: [{ name: 'default' }] }, want: 'default' },
+    { name: 'still exists', listing: { profiles: [{ name: 'default' }, { name: 'work' }] }, want: 'work' },
+    {
+      name: 'connection memory served',
+      listing: { profiles: [{ name: 'default' }, { name: 'lab' }] },
+      remembered: 'lab',
+      want: 'lab'
+    },
+    {
+      name: 'connection memory not served',
+      listing: { profiles: [{ name: 'default' }] },
+      remembered: 'lab',
+      want: 'default'
+    },
+    { name: 'no default', listing: { profiles: [{ name: 'other' }] }, want: 'other' },
+    { name: 'empty', listing: { profiles: [] }, want: 'work' },
+    { name: 'malformed', listing: {}, want: 'work' },
+    { name: 'partial roster', listing: { profiles: [{ name: 'default' }, {}] }, want: 'work' },
+    { name: 'failed read', listing: new Error('offline'), want: 'work' },
+    // `/api/profiles` lists installed profiles; `/api/status` names the served ones.
+    {
+      name: 'connection memory parked',
+      listing: { profiles: [{ name: 'default' }, { name: 'lab' }, { name: 'work' }] },
+      status: { gateway_shared_with: ['default'] },
+      remembered: 'lab',
+      want: 'default'
+    },
+    {
+      name: 'inherited profile installed but not served',
+      listing: { profiles: [{ name: 'default' }, { name: 'work' }] },
+      status: { gateway_shared_with: ['default', 'lab'] },
+      want: 'default'
+    },
+    {
+      name: 'single-profile gateway keeps the inherited profile',
+      listing: { profiles: [{ name: 'default' }, { name: 'work' }] },
+      status: { gateway_shared_with: [] },
+      want: 'work'
+    },
+    {
+      name: 'a served list never gains an unlisted default',
+      listing: { profiles: [{ name: 'default' }, { name: 'lab' }, { name: 'work' }] },
+      status: { gateway_shared_with: ['lab'] },
+      want: 'lab'
+    },
+    {
+      name: 'served set unknown: installed counts as served',
+      listing: { profiles: [{ name: 'default' }, { name: 'work' }] },
+      status: { gateway_shared_with: null },
+      want: 'work'
+    },
+    {
+      name: 'status read failed: installed counts as served',
+      listing: { profiles: [{ name: 'default' }, { name: 'lab' }] },
+      status: new Error('offline'),
+      remembered: 'lab',
+      want: 'lab'
+    },
+    { name: 'explicit route or destination override', allow: false, want: 'work' },
+    { name: 'destination override added during probe', destinationChanged: true, want: 'work' },
+    { name: 'profile alias', source: 'profile', want: 'work' },
+    { name: 'SSH remote profile', ssh: { remoteProfile: 'work' }, want: 'work' }
+  ]
+
+  for (const row of cases) {
+    preferences.remember('work')
+    preferences.connectionRemoved('remote')
+
+    if (row.remembered) {
+      preferences.rememberConnectionProfile('remote', row.remembered)
+    }
+
+    let allow = row.allow !== false
+    const pin = new PrimaryProfilePin()
+    pin.pin('work')
+
+    const connection = await connectPrimaryRemote(
+      { ...remote, source: row.source || remote.source, ssh: row.ssh },
+      {
+        profile: 'work',
+        restoreRememberedProfile: () => allow,
+        connectionProfile: preferences.connectionProfile,
+        assertCurrentAttempt: () => undefined,
+        advanceBootProgress: async () => undefined,
+        waitForRemote: async () => undefined,
+        readProfiles: async descriptor => {
+          assert.equal(descriptor.baseUrl, 'https://offline.invalid')
+          assert.equal(descriptor.connectionId, 'remote')
+
+          if (row.destinationChanged) {allow = false}
+
+          if (row.listing instanceof Error) {throw row.listing}
+
+          return row.listing ?? { profiles: [{ name: 'default' }] }
+        },
+        readStatus: async () => {
+          if (row.status instanceof Error) {throw row.status}
+
+          return row.status ?? {}
+        },
+        onProfileRestored: profile => {
+          pin.pin(profile)
+        },
+        updateBootProgress: () => undefined,
+        logs: () => [],
+        windowState: () => ({})
+      }
+    )
+
+    assert.equal(pin.booted, row.want, row.name)
+    assert.equal(connection.profile, row.want === 'work' ? undefined : row.want, row.name)
+    // The legacy profile is this machine's; a remote that lacks it never rewrites it.
+    assert.equal(preferences.readActive(), 'work', row.name)
+    assert.equal(connection.baseUrl, 'https://offline.invalid')
+    assert.equal(connection.connectionId, 'remote')
+  }
+})
+
+test('connection memory is pruned with its connection and ignores invalid names', ({ onTestFinished }) => {
+  const home = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-profile-memory-'))
+  const preferences = createDesktopProfilePreferences(path.join(home, 'active-profile.json'))
+  onTestFinished(() => fs.rmSync(home, { recursive: true, force: true }))
+
+  preferences.rememberConnectionProfile('lab', 'work')
+  preferences.rememberConnectionProfile('bad', '../etc')
+  preferences.rememberConnectionProfile('other', 'default')
+  assert.equal(preferences.connectionProfile('lab'), 'work')
+  assert.equal(preferences.connectionProfile('bad'), null)
+  preferences.connectionRemoved('lab')
+  assert.equal(preferences.connectionProfile('lab'), null)
+  assert.equal(preferences.connectionProfile('other'), 'default')
+})
+
+test('a superseded or aborted roster probe cannot publish or mutate the primary profile', async () => {
+  for (const cancelledBy of ['attempt', 'signal'] as const) {
+    const controller = new AbortController()
+    let current = true
+    const pin = new PrimaryProfilePin()
+    pin.pin('work')
+    let ready = false
+    await assert.rejects(
+      connectPrimaryRemote(remote, {
+        profile: 'work',
+        restoreRememberedProfile: () => true,
+        signal: controller.signal,
+        assertCurrentAttempt: () => {
+          if (!current) {throw new Error('superseded')}
+        },
+        advanceBootProgress: async () => undefined,
+        waitForRemote: async () => undefined,
+        readProfiles: async () => {
+          if (cancelledBy === 'signal') {controller.abort(new Error('aborted'))}
+          else {current = false}
+
+          return { profiles: [{ name: 'default' }] }
+        },
+        onProfileRestored: profile => {
+          pin.pin(profile)
+        },
+        updateBootProgress: () => {
+          ready = true
+        },
+        logs: () => [],
+        windowState: () => ({})
+      }),
+      /superseded|aborted/
+    )
+    assert.equal(pin.booted, 'work')
+    assert.equal(ready, false)
+  }
+})
+
+test('windows change one connection at a time; an older window cannot erase or resurrect entries', ({
+  onTestFinished
+}) => {
+  const home = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-profile-windows-'))
+  const preferences = createDesktopProfilePreferences(path.join(home, 'active-profile.json'))
+  onTestFinished(() => fs.rmSync(home, { recursive: true, force: true }))
+  const registered = new Set(['lab', 'vps', 'cloud'])
+  const isKnown = (id: string) => registered.has(id)
+
+  // Window A predates the mirror: its record is imported once.
+  preferences.importConnectionProfiles({ lab: 'work', vps: 'ops', gone: 'old' }, isKnown)
+  // Window B picks a newer profile for lab, then the user removes vps.
+  preferences.rememberConnectionProfile('lab', 'marina', isKnown)
+  preferences.connectionRemoved('vps')
+  registered.delete('vps')
+  // Window A, still holding { lab: 'work', vps: 'ops' }, changes only cloud.
+  preferences.importConnectionProfiles({ lab: 'work', vps: 'ops' }, isKnown)
+  preferences.rememberConnectionProfile('cloud', 'default', isKnown)
+  preferences.rememberConnectionProfile('vps', 'ops', isKnown)
+
+  assert.equal(preferences.connectionProfile('lab'), 'marina')
+  assert.equal(preferences.connectionProfile('vps'), null)
+  assert.equal(preferences.connectionProfile('cloud'), 'default')
+  assert.equal(preferences.connectionProfile('gone'), null)
+})
diff --git a/apps/desktop/electron/primary-remote-startup.ts b/apps/desktop/electron/primary-remote-startup.ts
new file mode 100644
index 00000000000..db37ba65688
--- /dev/null
+++ b/apps/desktop/electron/primary-remote-startup.ts
@@ -0,0 +1,198 @@
+interface ResolvedPrimaryRemote {
+  authMode?: 'oauth' | 'token'
+  baseUrl: string
+  connectionId?: string
+  headers?: Record<string, string>
+  remoteHermesVersion?: string
+  remoteHost?: string
+  remoteKind?: 'cloud' | 'ssh' | 'url'
+  source?: string
+  ssh?: {
+    effectiveConfigFingerprint?: string
+    host?: string
+    keyPath?: string
+    port?: number
+    remoteHermesPath?: string
+    remoteProfile?: string
+    user?: string
+  }
+  token: unknown
+  wsUrl: string
+}
+
+/**
+ * Build the renderer-facing primary remote descriptor without dropping route
+ * identity. Tests cross this same seam, so adding a field to the resolved
+ * remote cannot silently disappear during primary startup.
+ */
+export function createPrimaryRemoteConnection<State extends object>(
+  remote: ResolvedPrimaryRemote,
+  logs: string[],
+  windowState: State
+) {
+  return {
+    baseUrl: remote.baseUrl,
+    mode: 'remote' as const,
+    source: remote.source,
+    authMode: remote.authMode || 'token',
+    remoteHost: remote.remoteHost,
+    remoteKind: remote.remoteKind,
+    remoteHermesVersion: remote.remoteHermesVersion,
+    ...(remote.connectionId ? { connectionId: remote.connectionId } : {}),
+    ...(remote.ssh ? { ssh: remote.ssh } : {}),
+    // fetchJsonForBackend reads descriptor.headers for every REST call; the
+    // WebSocket header store is keyed by exact URL and cannot stand in for it.
+    headers: remote.headers,
+    token: remote.token,
+    wsUrl: remote.wsUrl,
+    logs,
+    ...windowState
+  }
+}
+
+interface PrimaryRemoteStartupOptions<State extends object> {
+  profile: string
+  restoreRememberedProfile: () => boolean
+  /** The profile this connection itself last ran, mirrored from the renderer. */
+  connectionProfile?: (connectionId: string | undefined) => null | string | undefined
+  signal?: AbortSignal
+  assertCurrentAttempt: () => void
+  advanceBootProgress: (phase: string, message: string, progress: number) => Promise<void>
+  waitForRemote: (remote: ResolvedPrimaryRemote) => Promise<void>
+  readProfiles: (remote: ResolvedPrimaryRemote) => Promise<unknown>
+  /** `/api/status`, for the gateway's served set; absent or failed reads as unknown. */
+  readStatus?: (remote: ResolvedPrimaryRemote) => Promise<unknown>
+  onProfileRestored: (profile: string) => void
+  updateBootProgress: (update: {
+    phase: string
+    message: string
+    progress: number
+    running: boolean
+    error: null
+  }) => void
+  logs: () => string[]
+  windowState: () => State
+}
+
+/**
+ * The served profile a primary should boot as when the inherited one is not
+ * served: null keeps `active`. Same ladder and served predicate as the
+ * renderer's startupProfileForConnection, so main and the window land on one
+ * profile.
+ */
+export function servedStartupProfile(
+  active: string,
+  remembered: null | string | undefined,
+  profiles: Array<{ name: string }>,
+  served: null | ReadonlySet<string> = null
+): null | string {
+  const names = profiles.map(profile => profile.name).filter(name => served === null || served.has(name))
+  const servable = new Set(names)
+
+  if (servable.has(active)) {
+    return null
+  }
+
+  if (remembered && servable.has(remembered)) {
+    return remembered
+  }
+
+  return servable.has('default') ? 'default' : (names[0] ?? null)
+}
+
+/**
+ * The profiles this gateway serves, from `/api/status`: `/api/profiles` lists
+ * every INSTALLED profile, parked and standalone ones included, while a
+ * gateway-hosted listener refuses those with `profile_mismatch`.
+ * `gateway_shared_with` is the multiplexer's served set, its launch profile
+ * included. [] (a single-profile gateway, serving only the profile it was
+ * launched as) and null (no gateway running, an older backend, a failed read)
+ * are unknown, and every installed profile counts as served, as before the set
+ * was read.
+ */
+export function servedProfileSet(status: unknown): null | Set<string> {
+  const shared = (status as { gateway_shared_with?: unknown } | null)?.gateway_shared_with
+
+  if (!Array.isArray(shared)) {
+    return null
+  }
+
+  const names = shared.filter((name): name is string => typeof name === 'string' && Boolean(name.trim()))
+
+  // [] is a single-profile gateway serving only the profile it was launched as,
+  // which the list does not name: unknown here, not `default`.
+  return names.length ? new Set(names) : null
+}
+
+/** A complete profile listing, or null: a failed or partial read proves nothing. */
+function installedProfiles(listing: unknown): Array<{ name: string }> | null {
+  const profiles = (listing as { profiles?: unknown } | null)?.profiles
+
+  if (!Array.isArray(profiles) || profiles.length === 0) {
+    return null
+  }
+
+  return profiles.every(profile => typeof profile?.name === 'string' && profile.name.trim())
+    ? (profiles as Array<{ name: string }>)
+    : null
+}
+
+/** Resolve a stale last-used profile against the gateway we actually connected to. */
+export async function connectPrimaryRemote<State extends object>(
+  remote: ResolvedPrimaryRemote,
+  options: PrimaryRemoteStartupOptions<State>
+) {
+  options.signal?.throwIfAborted()
+  options.assertCurrentAttempt()
+  await options.advanceBootProgress('backend.remote', `Connecting to remote Hermes backend at ${remote.baseUrl}`, 24)
+  await options.waitForRemote(remote)
+  options.signal?.throwIfAborted()
+  options.assertCurrentAttempt()
+
+  let restoredProfile: string | undefined
+
+  // Explicit routes and per-profile remote aliases are intent, not stale
+  // workspace memory. A failed/unsupported listing is not proof of deletion.
+  if (
+    options.restoreRememberedProfile() &&
+    options.profile !== 'default' &&
+    ['settings', 'env', 'registry'].includes(remote.source || '') &&
+    !remote.ssh?.remoteProfile
+  ) {
+    const [listing, status] = await Promise.all([
+      options.readProfiles(remote).catch(() => null),
+      options.readStatus?.(remote).catch(() => null) ?? null
+    ])
+
+    options.signal?.throwIfAborted()
+    options.assertCurrentAttempt()
+    const profiles = installedProfiles(listing)
+
+    const target =
+      profiles &&
+      servedStartupProfile(
+        options.profile,
+        options.connectionProfile?.(remote.connectionId),
+        profiles,
+        servedProfileSet(status)
+      )
+
+    if (target && options.restoreRememberedProfile()) {
+      restoredProfile = target
+      options.onProfileRestored(restoredProfile)
+    }
+  }
+
+  options.updateBootProgress({
+    phase: 'backend.ready',
+    message: 'Remote Hermes backend is ready',
+    progress: 94,
+    running: true,
+    error: null
+  })
+
+  return {
+    ...createPrimaryRemoteConnection(remote, options.logs(), options.windowState()),
+    ...(restoredProfile ? { profile: restoredProfile } : {})
+  }
+}
