+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { resolveProfileBackendRoute } from './connection-config'
+import { desktopConnectionRequestInheritsPrimary, resolveDesktopConnectionRequest } from './desktop-profile'
+import { joinPrimaryBoot, primaryBootRequest, primaryProfileRestorable } from './primary-boot-join'
+import { PrimaryProfilePin } from './primary-profile-pin'
+import { connectPrimaryRemote } from './primary-remote-startup'
+
+const remote = {
+  baseUrl: 'https://offline.invalid',
+  wsUrl: 'wss://offline.invalid/api/ws',
+  connectionId: 'homelab',
+  source: 'registry',
+  token: 'placeholder'
+}
+
+// main.ts's hermes:connection → ensureBackend path, minus the IPC: a renderer
+// asking with no profile, against a global remote primary whose inherited
+// profile ('windows-only') that gateway does not serve.
+function rendererRequest(profile: string | undefined, pin: PrimaryProfilePin) {
+  const route = resolveDesktopConnectionRequest(profile, null, pin.resolve(() => 'windows-only'))
+
+  return primaryBootRequest(route.profile, pin.resolve(() => 'windows-only'), desktopConnectionRequestInheritsPrimary(profile, null))
+}
+
+const routeFor = (pin: PrimaryProfilePin) => (key: string) =>
+  resolveProfileBackendRoute(key, { globalRemote: true, primaryProfile: pin.resolve(() => 'windows-only') })
+
+test('a renderer that joins a remote boot mid-roster read adopts the served profile it re-pinned to', async () => {
+  for (const asked of [undefined, 'windows-only'] as const) {
+    const pin = new PrimaryProfilePin()
+    pin.pin('windows-only')
+    const request = rendererRequest(asked, pin)
+    // Resolved before the wait, as ensureBackend does: it names the stale profile.
+    const route = routeFor(pin)(request.key)
+    assert.equal(route.descriptorProfile, 'windows-only')
+
+    const joined = await joinPrimaryBoot(request, route, {
+      primaryKey: () => pin.resolve(() => 'windows-only'),
+      resolveRoute: routeFor(pin),
+      // The in-flight boot's /api/profiles read lands while this caller waits.
+      start: async () => {
+        pin.pin('default')
+
+        return { mode: 'remote' }
+      }
+    })
+
+    // A profile-less caller follows the primary; one that named a profile keeps it.
+    const want = asked ? 'windows-only' : 'default'
+    assert.equal(joined.key, want, String(asked))
+    assert.equal(joined.route.descriptorProfile, want, String(asked))
+    // The descriptor ensureBackend returns: the global remote's shared primary, tagged with that profile.
+    assert.deepEqual(joined.descriptor, { mode: 'remote', profile: want, sharedPrimary: true }, String(asked))
+  }
+})
+
+test('a renderer retry after a failed remote boot still restores a served profile', async () => {
+  const pin = new PrimaryProfilePin()
+  // The failed boot cleared its pin; the retry resolves the stored preference.
+  const request = rendererRequest(undefined, pin)
+  assert.deepEqual(request, { key: 'windows-only', inheritsPrimary: true })
+
+  // startHermes(request.key, { inheritsPrimary }) gates restoration on this.
+  const restorable = () => primaryProfileRestorable(request.key, request.inheritsPrimary, null, {})
+
+  pin.pin(request.key)
+
+  const connection = await connectPrimaryRemote(remote, {
+    profile: request.key,
+    restoreRememberedProfile: restorable,
+    assertCurrentAttempt: () => undefined,
+    advanceBootProgress: async () => undefined,
+    waitForRemote: async () => undefined,
+    readProfiles: async () => ({ profiles: [{ name: 'default' }, { name: 'marina' }] }),
+    onProfileRestored: profile => {
+      pin.pin(profile)
+    },
+    updateBootProgress: () => undefined,
+    logs: () => [],
+    windowState: () => ({})
+  })
+
+  assert.equal(connection.profile, 'default')
+  assert.equal(pin.booted, 'default')
+
+  // An explicitly requested profile, a --profile launch or a per-profile
+  // route is intent and is never swapped.
+  for (const [inherits, launchArg, config] of [
+    [false, null, {}],
+    [true, 'windows-only', {}],
+    [true, null, { profiles: { default: { mode: 'remote', url: 'https://work.invalid' } } }],
+    [true, null, { profiles: { default: { mode: 'ssh', host: 'work.invalid' } } }]
+  ] as const) {
+    assert.equal(primaryProfileRestorable('windows-only', inherits, launchArg, config), false, JSON.stringify(config))
+  }
+})
+
+test('a default profile kept local with only remembered SSH settings still repairs the global remote primary', async () => {
+  // Settings → "This device" on the default profile parks its SSH form as
+  // savedSsh; the global remote stays the primary's effective route.
+  const config = {
+    mode: 'remote',
+    remote: { url: 'https://offline.invalid' },
+    profiles: { default: { mode: 'local', savedSsh: { mode: 'ssh', host: 'box.invalid', user: 'me' } } }
+  }
+
+  const reads: string[] = []
+
+  const connection = await connectPrimaryRemote(
+    { ...remote, source: 'settings' },
+    {
+      profile: 'work',
+      restoreRememberedProfile: () => primaryProfileRestorable('work', true, null, config),
+      assertCurrentAttempt: () => undefined,
+      advanceBootProgress: async () => undefined,
+      waitForRemote: async () => undefined,
+      readProfiles: async () => {
+        reads.push('profiles')
+
+        return { profiles: [{ name: 'default' }] }
+      },
+      onProfileRestored: () => undefined,
+      updateBootProgress: () => undefined,
+      logs: () => [],
+      windowState: () => ({})
+    }
+  )
+
+  assert.deepEqual(reads, ['profiles'])
+  assert.equal(connection.profile, 'default')
+})
diff --git a/apps/desktop/electron/primary-boot-join.ts b/apps/desktop/electron/primary-boot-join.ts
new file mode 100644
index 00000000000..353c546e9e9
--- /dev/null
+++ b/apps/desktop/electron/primary-boot-join.ts
@@ -0,0 +1,90 @@
+import { profileHasRemoteConnection } from './connection-config'
+
+/**
+ * Which profile a caller of the primary backend asked for, and whether it
+ * named one at all. A profile-less caller follows the primary, and only that
+ * caller may be moved when a remote boot re-pins the primary onto a profile its
+ * gateway serves. The resolved key alone cannot say this: `hermes:connection`
+ * fills an empty request with the primary's name before it reaches
+ * ensureBackend/startHermes.
+ */
+export interface PrimaryBootRequest {
+  key: string
+  inheritsPrimary: boolean
+}
+
+export function primaryBootRequest(profile: unknown, primaryKey: string, inheritsPrimary = false): PrimaryBootRequest {
+  const named = profile === null || profile === undefined ? '' : String(profile).trim()
+
+  return { key: named || primaryKey, inheritsPrimary: inheritsPrimary || !named }
+}
+
+/**
+ * Join (or start) the primary boot, then answer with the route the caller now
+ * owns. An inherited caller re-reads the primary after the wait: a remote boot
+ * that restored a served profile re-pinned it, and the route resolved before
+ * the wait still names the profile that gateway does not serve. An explicit
+ * caller keeps its own profile and route.
+ */
+export async function joinPrimaryBoot<Connection extends object, Route extends { descriptorProfile: null | string }>(
+  request: PrimaryBootRequest,
+  route: Route,
+  deps: {
+    primaryKey: () => string
+    resolveRoute: (key: string) => Route
+    start: (request: PrimaryBootRequest) => Promise<Connection>
+  }
+) {
+  const connection = await deps.start(request)
+  const key = request.inheritsPrimary ? deps.primaryKey() : request.key
+  const settled = key === request.key ? route : deps.resolveRoute(key)
+
+  return { connection, descriptor: primaryRouteDescriptor(connection, key, settled), key, route: settled }
+}
+
+/**
+ * The descriptor a primary-route caller gets. A shared backend still owes the
+ * caller its profile scope, so renderer-side WebSocket, filesystem and cache
+ * routing target the selected profile. `sharedPrimary` marks the
+ * shared-primary route: pooled backends also carry `profile`, so only this
+ * descriptor gets the flag. The unshared primary carries its own key too: a
+ * profile-less descriptor reads as "default" downstream, which breaks
+ * per-source profile memory (the primary IS "default" only when it actually
+ * booted as default).
+ */
+function primaryRouteDescriptor<Connection extends object>(
+  connection: Connection,
+  key: string,
+  route: { descriptorProfile: null | string }
+) {
+  return route.descriptorProfile
+    ? { ...connection, profile: route.descriptorProfile, sharedPrimary: true }
+    : { ...connection, profile: key }
+}
+
+/** Inherited and explicit dials of one name answer different profiles once a
+ *  remote boot re-pins the primary, so they never share a dial claim. */
+export function primaryDialClaimKey(scopeKey: string, inheritsPrimary: boolean): string {
+  return inheritsPrimary ? `${scopeKey}\u0000inherited` : scopeKey
+}
+
+/**
+ * A startHermes attempt may swap a remote primary's stale profile for a served
+ * one only when its profile was inherited: no caller named it, no --profile
+ * launch argument and no per-profile route pins it. "Pins" means the default
+ * profile's own EFFECTIVE route (what resolveDesktopRemoteRoute would select),
+ * not any `profiles.default` entry: a local entry that only remembers
+ * `savedSsh` leaves the primary on the global remote, which must still repair.
+ */
+export function primaryProfileRestorable(
+  requestedProfile: string | undefined,
+  inheritsPrimary: boolean,
+  launchArgProfile: null | string,
+  connectionConfig: Record<string, unknown>
+): boolean {
+  return (
+    (!requestedProfile || inheritsPrimary) &&
+    !launchArgProfile &&
+    !profileHasRemoteConnection(connectionConfig, 'default')
+  )
+}
diff --git a/apps/desktop/electron/primary-remote-profile-restore.test.ts b/apps/desktop/electron/primary-remote-profile-restore.test.ts
