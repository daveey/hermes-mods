+@pytest.mark.asyncio
+async def test_upload_failure_never_carries_the_bearer_a_hop_echoed(connector, tmp_path, caplog):
+    adapter = await _provisioned_adapter(connector)
+    pdf = tmp_path / "report.pdf"
+    pdf.write_bytes(b"%PDF-1.4 report")
+    connector.media_script = [echoing(400, '{"message":"token {token} rejected"}')]
+    caplog.set_level(logging.INFO)
+    try:
+        result = await adapter.send_document("C0REPORTS", str(pdf))
+    finally:
+        await adapter.disconnect()
+    bearer = connector.bearers_seen[-1].removeprefix("Bearer ")
+    assert connector.media_calls == 1 and result.success is False
+    assert "rejected" in caplog.text
+    assert bearer not in caplog.text and bearer not in (result.error or "")
+
+
+def test_diagnostics_scrub_the_exact_bearer_the_caller_sent():
+    """Salt's probe shape: a bare (prefix-less) HMAC upgrade token echoed in a JSON body."""
+    import http.client
+    import io
+    import urllib.error
+
+    from gateway.relay.auth import make_upgrade_token
+    from gateway.relay.http_diagnostics import describe_http_error, read_error_body
+
+    bearer = make_upgrade_token("gw-x", "s" * 64)
+    hdrs = http.client.parse_headers(io.BytesIO(b"\r\n"))
+    exc = urllib.error.HTTPError("http://c/relay/media", 403, "err", hdrs,
+                                 io.BytesIO(f'{{"message":"token {bearer} rejected"}}'.encode()))
+    text = describe_http_error(exc, read_error_body(exc), secrets=(bearer, ""))
+    assert bearer not in text and "rejected" in text
+
+
+@pytest.mark.parametrize("headers", [
+    {"Proxy-Status": "egress; error=dns_timeout", "Server": "envoy"},
+    {"Via": "1.1 edge-proxy"},
+    {"X-Squid-Error": "ERR_ACCESS_DENIED 0"},
+    {"Server": "cloudflare"},
+], ids=["proxy-status", "via", "x-squid-error", "server-cloudflare"])
+@pytest.mark.asyncio
+async def test_json_403_from_a_named_proxy_gets_the_fast_schedule_not_refusal_pacing(connector, headers):
+    connector.provision_script = [
+        json_proxy_403(**headers),                                              # another hop, JSON body
+        relay_refusal(403, "enterprise identity lifecycle is not confirmed"),   # the connector's own refusal
+    ]
+    slept: list[float] = []
+
+    async def fake_sleep(seconds):
+        slept.append(seconds)
+
+    assert await relay.retry_self_provision(sleep=fake_sleep) is True
+    delays, refusal = relay._PROVISION_RETRY_DELAYS_S, relay._PROVISION_REFUSAL_RETRY_S
+    # before #1, after the proxy's JSON 403 (fast), after the connector's refusal (throttled)
+    assert slept == [delays[0], delays[1], refusal]
+
+
+def test_connector_refusal_behind_a_non_proxy_edge_is_still_a_refusal(connector):
+    """The connector sets no Server header; a hosting edge (Railway) adds its own name. That
+    is not a proxy-origin signal, so the connector's reasoned refusal keeps its 600s pacing."""
+    spec = relay_refusal(403, "binding owned elsewhere")
+    spec["headers"]["Server"] = "railway-edge"
+    connector.provision_script = [spec]
+    assert relay._self_provision() == relay._REFUSED
+
+
+@pytest.mark.asyncio
+async def test_credentials_landing_mid_dial_are_not_pushed_back_to_the_backoff_cap(connector, monkeypatch):
+    """The reconnect watcher's pass began without credentials; the background provision retry
+    obtains them while that dial is still in flight. The dial's failure must not re-bump the
+    pulled-forward retry to the 300s cap: the very next pass dials with the new credentials."""
+    from unittest.mock import MagicMock
+
+    from tests.gateway.test_platform_reconnect import _make_runner
+
+    monkeypatch.setattr(relay, "_PROVISION_RETRY_DELAYS_S", (0.01,), raising=False)
+    connector.provision_script = [proxy_403()]
+    assert relay.self_provision_relay() is False
+    assert relay.register_relay_adapter()
+
+    runner = _make_runner()
+    runner._update_platform_runtime_status = MagicMock()
+    runner._sync_voice_mode_state_to_adapter = MagicMock()
+    runner._background_tasks = set()
+    runner._retain_background_task = lambda task: (runner._background_tasks.add(task), task)[1]
+    runner._failed_platforms[Platform.RELAY] = {
+        "config": PlatformConfig(enabled=True), "attempts": 4, "next_retry": 0.0,
+    }
+    info = runner._failed_platforms[Platform.RELAY]
+
+    async def refused_dial(adapter, platform, **_kw):
+        return False  # a no-credential dial is closed 4401
+
+    # Control: an ordinary failed pass backs off to the cap.
+    runner._connect_adapter_with_timeout = refused_dial
+    await runner._reconnect_failed_platform(Platform.RELAY, time.monotonic())
+    assert info["next_retry"] > time.monotonic() + 200
+
+    async def provisioning_lands_mid_dial(adapter, platform, **kw):
+        GatewayStartupMixin._start_relay_provision_retry(runner)
+        await asyncio.wait_for(asyncio.gather(*runner._background_tasks), timeout=10)
+        assert relay.relay_connection_auth() == (connector.gateway_id, connector.secret)
+        return await refused_dial(adapter, platform, **kw)  # this dial was built before them
+
+    info["next_retry"] = 0.0  # the watcher's time arrives
+    runner._connect_adapter_with_timeout = provisioning_lands_mid_dial
+    await runner._reconnect_failed_platform(Platform.RELAY, time.monotonic())
+    assert info["next_retry"] <= time.monotonic(), "credentials obtained mid-dial were pushed back"
+
+    # The next pass (the watcher re-checks every 10s) builds the adapter from the live env and connects.
+    del runner._connect_adapter_with_timeout  # the real bounded connect
+    try:
+        await runner._reconnect_failed_platform(Platform.RELAY, time.monotonic())
+        assert Platform.RELAY not in runner._failed_platforms
+        assert connector.ws_auth[-1] == "ok"
+    finally:
+        if Platform.RELAY in runner.adapters:
+            await runner.adapters[Platform.RELAY].disconnect()
diff --git a/tests/gateway/test_api_idle_retirement.py b/tests/gateway/test_api_idle_retirement.py
new file mode 100644
index 00000000000..148d3af2362
--- /dev/null
+++ b/tests/gateway/test_api_idle_retirement.py
@@ -0,0 +1,93 @@
+"""An API conversation leaves the authority's memory between requests, as a restart leaves it.
+
+Every API request binds its conversation (``bind_api_steps`` restores it from its binding receipt),
+so a ``LiveSession`` kept after the FIFO goes idle only pinned its event stream and replay ring for
+the life of the process. Retirement must never strand an admission committed around it.
+"""
+import asyncio
+
+import pytest
+
+from gateway.session_api_turn import admit_api_turn, observe_api_controls, observe_api_turn
+from tests.waiting import async_wait_until
+
+
+def _answer(owner, replies, check=None):
+    async def handle(event):
+        from gateway.session_results import execution_result
+        if check is not None:
+            check()
+        replies.append(event.text)
+        execution_result.get()['result'] = {'final_response': 'ok:' + event.text}
+        return 'ok:' + event.text
+    owner.runner._handle_message = handle
+
+
+@pytest.mark.asyncio
+async def test_api_session_leaves_memory_when_idle_and_its_next_request_restores_it(api, owner):
+    replies = []
+    _answer(owner, replies)
+    first = admit_api_turn(api, session_id='conv', user_message='one', conversation_history=[])
+    result, _ = await asyncio.wait_for(observe_api_turn(first), 10)
+    assert result['final_response'] == 'ok:one'
+    await async_wait_until(lambda: 'conv' not in owner.sessions, timeout=10, what='the idle API session to retire')
+    second = admit_api_turn(api, session_id='conv', user_message='two', conversation_history=[])
+    result, _ = await asyncio.wait_for(observe_api_turn(second), 10)
+    assert result['final_response'] == 'ok:two' and replies == ['one', 'two']
+    # An exact retry of the settled first request still answers from its receipt.
+    retry = admit_api_turn(api, session_id='conv', user_message='one', conversation_history=[],
+                           request_id=first[2]['request_id'])
+    assert retry[2]['admission_id'] == first[2]['admission_id']
+    assert (await asyncio.wait_for(observe_api_turn(retry), 10))[0]['final_response'] == 'ok:one'
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('controls', [True, False], ids=['approval-stream', 'plain'])
+async def test_api_admission_committed_after_its_session_retired_runs_with_its_observers(api, owner, controls):
+    """The session retires while a request's admission commits (between its bind and the commit):
+    the request's control observer (a streaming door) and the drain must land on the same restored
+    session, and the turn runs. The retirement is applied right after the commit, the state that
+    window leaves."""
+    import contextlib
+    replies, seen = [], []
+    owner.runner.adapters = {}  # a real runner's map (no LOCAL adapter: this profile serves API only)
+    admitted = admit_api_turn(api, session_id='race', user_message='hello', conversation_history=[])
+    del owner.sessions['race']  # retired in the window
+
+    def observed():
+        seen.append(len(owner.sessions['race'].event_stream.observers))
+    _answer(owner, replies, observed)
+    with observe_api_controls(admitted, lambda *_: None) if controls else contextlib.nullcontext():
+        result, _ = await asyncio.wait_for(observe_api_turn(admitted), 10)
+    assert result['final_response'] == 'ok:hello'
+    assert seen == [int(controls)]  # the approval projection is attached to the session the turn runs on
+
+
+@pytest.mark.asyncio
+async def test_api_session_with_a_viewer_or_queued_input_stays(api, owner):
+    """Retirement sheds only what nobody uses: a session a viewer subscribes to stays after idle."""
+    replies = []
+    _answer(owner, replies)
+    admitted = admit_api_turn(api, session_id='watched', user_message='hi', conversation_history=[])
+    owner.sessions['watched'].subscribers['sub'] = object()
+    live = owner.sessions['watched']
+    await asyncio.wait_for(observe_api_turn(admitted), 10)
+    # The retirement check runs at the drain's idle exit, before its task finishes.
+    await async_wait_until(lambda: live.task.done(), timeout=10, what='the drain to go idle')
+    assert owner.sessions.get('watched') is live
+
+
+@pytest.mark.asyncio
+async def test_deleting_an_idle_api_session_evicts_its_cached_agent(api, owner):
+    """A delete or prune of an API conversation retirement let go still drops its cached agent
+    (transcript, client pool, memory provider), as it does for one in memory."""
+    _answer(owner, [])
+    evicted = []
+    owner.runner._evict_cached_agent = lambda route, **kw: evicted.append(route)
+    admitted = admit_api_turn(api, session_id='conv', user_message='one', conversation_history=[])
+    route = owner.sessions['conv'].route
+    await asyncio.wait_for(observe_api_turn(admitted), 10)
+    await async_wait_until(lambda: 'conv' not in owner.sessions, timeout=10, what='the idle API session to retire')
+    from gateway.session_mutations import retire_live_sessions
+    retire_live_sessions(owner, ['conv'])  # the delete / prune primitive
+    assert evicted == [route]
