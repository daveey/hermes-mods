+                "gateway (%s) — parked, not retried. %s", profile_name, platform.value,
+                adapter.fatal_error_code, adapter.fatal_error_message or "",
+            )
+            self._mark_platform_fatal(f"{profile_name}:{platform.value}", adapter)
+            return
