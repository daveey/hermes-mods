diff --git a/tests/pm/test_carried_extras.py b/tests/pm/test_carried_extras.py
new file mode 100644
index 00000000000..a2c14e7d6a2
--- /dev/null
+++ b/tests/pm/test_carried_extras.py
@@ -0,0 +1,118 @@
+"""An extra carried over from a pre-PM venv that no longer builds never fails the sync that
+carries it: it is left out, recorded so the old venv's next scan skips it, and reported with
+the command that adds it back. Core and requested extras still fail loudly."""
+
+from __future__ import annotations
+
+import pytest
+
+from pm import extras, install, paths
+from pm.environment import BuildFailure
+from pm.environments import install_state_dir, runtime_facts_path
+from pm.lock import Facts
+
+
+class _Venv:
+    """The venv package with a build backend that fails whenever a broken extra is selected.
+
+    A build that succeeds commits a generation of this install, as the real one does: a
+    stamp only counts as current while the environment the facts name is on disk, so the
+    test must never lean on whatever venv the checkout running it happens to have.
+    """
+
+    def __init__(self, broken: set[str]):
+        self.broken, self.applied = broken, []
+
+    def project_root(self):
+        return paths.repo_root()
+
+    def expected_stamp(self, enabled, **_inputs):
+        return "stamp:" + ",".join(sorted(enabled))
+
+    def apply(self, enabled, **_inputs):
+        self.applied.append(sorted(enabled))
+        if self.broken & set(enabled):
+            raise BuildFailure("venv", "uv sync exited 1: Failed to build `python-olm==3.2.16`")
+        environment = install_state_dir(self.project_root()) / "environments" / str(len(self.applied)) / "venv"
+        environment.mkdir(parents=True)
+        (environment / "pyvenv.cfg").write_text("home = fixture\n")
+        return {"environment": environment}
+
+
+@pytest.fixture()
+def venv(monkeypatch, tmp_path):
+    repo = tmp_path / "checkout"
+    repo.mkdir()
+    monkeypatch.setattr(paths, "repo_root", lambda: repo)
+
+    def make(broken):
+        package = _Venv(broken)
+        monkeypatch.setattr(install, "get_package", lambda name: package)
+        return package
+    return make
+
+
+def _recorded():
+    return (Facts(runtime_facts_path(paths.repo_root())).get("venv") or {}).get("extras")
+
+
+def test_a_carried_extra_that_cannot_build_is_left_out_and_not_carried_again(venv, capsys):
+    package = venv({"matrix"})
+
+    install.sync_venv(["all", "fal", "matrix"], explicit=True, carried=["fal", "matrix"])
+
+    # The update completes with everything that builds, the carried extra that builds included.
+    assert _recorded() == ["all", "fal"]
+    assert extras.declined_extras() == {"matrix"}
+    assert extras.declined_reasons() == {"matrix": "it no longer builds on this machine"}
+    notice = capsys.readouterr().err
+    assert "'matrix'" in notice and "hermes pm install --extra matrix" in notice
+    # The next update finds the environment current: nothing is rebuilt or re-carried.
+    builds = len(package.applied)
+    install.sync_venv(None, explicit=True)
+    assert len(package.applied) == builds
+    # A lazy first use names why the extra is out instead of a `--without` nobody ran.
+    with pytest.raises(Exception, match="an update left 'matrix' out"):
+        install.sync_venv(["matrix"])
+
+
+@pytest.mark.parametrize(("broken", "carried"), [({"matrix"}, None), ({"all"}, ["matrix"])])
+def test_a_requested_extra_or_core_that_cannot_build_still_fails(venv, broken, carried):
+    venv(broken)
+
+    with pytest.raises(BuildFailure):
+        install.sync_venv(["all", "matrix"], explicit=True, carried=carried)
+
+    assert _recorded() is None
+    assert extras.declined_extras() == frozenset()
+
+
+def test_a_carried_extra_that_fails_for_the_moment_is_retried_by_the_next_update(venv):
+    """A carried extra whose trials fail on a download or tooling problem is not a verdict. Publishing
+    without it would write the facts that end the old venv's re-scan, losing the extra with no record;
+    the sync fails instead, and the next update carries it again and builds it once the cause clears."""
+    from pm.package import InstallError
+
+    package = venv(set())
+    # The full sync fails to build matrix; then its source goes missing for every per-extra trial.
+    failures = [BuildFailure("venv", "uv sync exited 1: Failed to build `review-optional`")]
+    unavailable = InstallError("venv", "uv sync exited 2: `review-optional` does not appear to be a Python project")
+    source_down = [True]
+
+    def apply(enabled, **inputs):
+        if "matrix" in enabled and source_down[0]:
+            package.applied.append(sorted(enabled))
+            raise failures.pop() if failures else unavailable
+        return _Venv.apply(package, enabled, **inputs)
+
+    package.apply = apply
+    with pytest.raises(InstallError, match=r"\['matrix'\].*could not be prepared") as refused:
+        install.sync_venv(["all", "fal", "matrix"], explicit=True, carried=["fal", "matrix"])
+    assert "hermes pm install --without matrix" in refused.value.remedy
+    assert _recorded() is None
+    assert extras.declined_extras() == frozenset()
+
+    source_down[0] = False
+    # No facts yet, so the next update scans the old venv and carries the same selection.
+    install.sync_venv(["all", "fal", "matrix"], explicit=True, carried=["fal", "matrix"])
+    assert _recorded() == ["all", "fal", "matrix"]
diff --git a/tests/pm/test_cmake_policy_floor.py b/tests/pm/test_cmake_policy_floor.py
new file mode 100644
index 00000000000..decc95fe88b
--- /dev/null
+++ b/tests/pm/test_cmake_policy_floor.py
@@ -0,0 +1,66 @@
+"""Every uv build tier hands cmake a policy floor.
+
+cmake 4.x removed compatibility with ``cmake_minimum_required(VERSION < 3.5)``,
+so an sdist that still declares an older minimum aborts at CONFIGURE time
+before a compiler is ever reached. python-olm 3.2.16 (pulled in by
+``mautrix[encryption]``) vendors libolm with ``VERSION 3.4``. Without
+``CMAKE_POLICY_VERSION_MINIMUM`` the install dies, so this pins the contract on
+the env uv actually spawns build backends with — the ``uv sync`` tier and the
+``uv pip install`` requirements tier alike, since they are the two ways a
+sdist can enter a PM environment.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+import subprocess
+import sys
+
+
+def _record_uv_envs(monkeypatch) -> list[dict]:
+    """Capture the env of every env-bearing uv spawn, reporting success."""
+    seen: list[dict] = []
+
+    def record(command, **kwargs):
+        if "env" not in kwargs:  # the pinned interpreter's sysconfig probe, not a uv spawn
+            return subprocess.CompletedProcess(command, 0, "{}", "")
+        seen.append(kwargs["env"])
+        return subprocess.CompletedProcess(command, 0, "", "")
+
+    monkeypatch.setattr(subprocess, "run", record)
+    return seen
+
+
+def _environment(tmp_path: Path):
+    from pm.environment import PythonEnvironment
+
+    return PythonEnvironment(uv=tmp_path / "uv", python=Path(sys.executable),
+                             destination=tmp_path / "venv", cache=tmp_path / "cache", env={})
+
+
+def test_both_install_tiers_receive_the_cmake_policy_floor(tmp_path, monkeypatch):
+    """`uv sync` and `uv pip install` are independent spawns; neither may be
+    left without the floor, or a sdist compiles on one path and fails on the other."""
+    seen = _record_uv_envs(monkeypatch)
+
+    _environment(tmp_path).sync(tmp_path)
+    _environment(tmp_path).install_requirements(["python-olm==3.2.16"])
+
+    # One spawn each: sync, then the requirements tier.
+    assert len(seen) == 2
+    assert [env["CMAKE_POLICY_VERSION_MINIMUM"] for env in seen] == ["3.5", "3.5"]
+
+
+def test_ambient_cmake_policy_version_is_not_overwritten(tmp_path, monkeypatch):
+    """The floor is a default, not a mandate: a user who exports their own
+    policy version (a newer minimum, or a build that must see none) keeps it.
+    Resolved through managed_environment, which is where the ambient shell env
+    actually becomes the build env for a lazy extra install."""
+    from pm.environment import managed_environment
+
+    monkeypatch.setenv("CMAKE_POLICY_VERSION_MINIMUM", "3.10")
+    monkeypatch.setattr("pm._uv._toolchain", lambda **kwargs: (tmp_path / "uv", Path(sys.executable)))
+    seen = _record_uv_envs(monkeypatch)
+
+    managed_environment(tmp_path / "candidate", cache=tmp_path).sync(tmp_path)
+
+    assert seen[0]["CMAKE_POLICY_VERSION_MINIMUM"] == "3.10"
diff --git a/tests/pm/test_declined_extras.py b/tests/pm/test_declined_extras.py
new file mode 100644
index 00000000000..b7ef44d6dd9
--- /dev/null
+++ b/tests/pm/test_declined_extras.py
@@ -0,0 +1,250 @@
+"""`hermes pm install --without EXTRA` drops a recorded extra, and nothing that carries a
+selection forward (recorded extras, the main-era venv scan, a lazy first use) re-adds it
+until the user asks for it again with `--extra EXTRA`."""
+
+from __future__ import annotations
+
+import argparse
+import importlib
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+import pm.cli
+from pm import extras, install
+from pm.package import InstallError
+from pm.paths import repo_root
+
+
+@pytest.fixture()
+def synced(monkeypatch):
+    calls = []
+    monkeypatch.setattr(pm.cli, "_install_names", lambda names, target=None, *, verify=True: 0)
+    monkeypatch.setattr(importlib.import_module("pm.install"), "activate", lambda **kwargs: [])
+    monkeypatch.setattr(importlib.import_module("pm.install"), "sync_venv",
+                        lambda extras=None, **kwargs: calls.append(list(extras or [])))
+    return calls
+
+
+def _next_selection(recorded, requested=None):
+    package = SimpleNamespace(project_root=repo_root, expected_stamp=lambda enabled, **_: "stamp")
+    return install._target_selection(package, {"extras": recorded}, extras=requested, inputs={},
+                                     repair=False, shipped=None, frozen=None)[0]
+
+
+def test_without_drops_a_recorded_extra_from_every_later_selection(synced, tmp_path):
+    assert pm.cli.cmd_install(argparse.Namespace(names=None, tools_only=False, without=["matrix"])) == 0
+
+    # The update's sync carries recorded extras forward; the dropped one stays out, others stay.
+    assert _next_selection(["all", "fal", "matrix"]) == ["all", "fal"]
+    # A data root without facts re-scans the main-era venv, which is never deleted.
+    site = tmp_path / "venv" / "lib" / "python3.11" / "site-packages"
+    for anchor in (*extras._anchors("matrix"), "fal_client"):
+        (site / anchor).mkdir(parents=True)
+    assert extras.legacy_selection(tmp_path) == ["all", "fal", "matrix"]
+    extras.record_declined_extras(add=["matrix"], project_root=tmp_path)
+    assert extras.legacy_selection(tmp_path) == ["all", "fal"]
+    # A lazy first use refuses instead of silently reinstalling it.
+    package = SimpleNamespace(project_root=repo_root)
+    with pytest.raises(InstallError, match="pm install --extra matrix"):
+        install._refuse_declined(package, ["matrix"], explicit=False)
+
+
+def test_extra_opts_a_dropped_extra_back_in():
+    extras.record_declined_extras(add=["matrix"])
+    assert _next_selection(["all"], requested=["matrix"]) == ["all", "matrix"]
+    install._refuse_declined(SimpleNamespace(project_root=repo_root), ["matrix"], explicit=True)
+
+
+def test_without_refuses_an_extra_the_default_sync_selects_anyway(synced, capsys):
+    assert pm.cli.cmd_install(argparse.Namespace(names=None, tools_only=False, without=["web"])) == 1
+    assert "extras outside [all]" in capsys.readouterr().out
+    assert synced == []
+
+
+class _BlockingVenv:
+    """The venv package with a build that records its selection and can be held mid-build."""
+
+    def __init__(self, hold=None):
+        self.built, self.hold = [], hold or {}
+
+    project_root = staticmethod(repo_root)
+
+    def expected_stamp(self, enabled, **_):
+        return "+".join(enabled)
+
+    def apply(self, enabled, **_):
+        self.built.append(list(enabled))
+        if (hook := self.hold.pop(tuple(enabled), None)) is not None:
+            hook()
+        return {}
+
+
+def _recorded():
+    from pm.environments import runtime_facts_path
+    from pm.lock import Facts
+
+    return (Facts(runtime_facts_path(repo_root())).get("venv") or {}).get("extras")
+
+
+def _watch_lock(monkeypatch, asked=None):
+    """Wrap the dependency lock: returns (threads holding it, event set once a second thread asks for it)."""
+    import threading
+    from contextlib import contextmanager
+
+    holders, asked = set(), asked or threading.Event()
+    real_lock = install._venv_install_lock
+
+    @contextmanager
+    def lock(**kwargs):
+        if threading.current_thread() is not threading.main_thread():
+            asked.set()
+        with real_lock(**kwargs):
+            holders.add(threading.get_ident())
+            try:
+                yield
+            finally:
+                holders.discard(threading.get_ident())
+
+    monkeypatch.setattr(install, "_venv_install_lock", lock)
+    return holders, asked
+
+
+def test_a_sync_queued_behind_an_opt_in_keeps_the_extra(monkeypatch):
+    """`--extra matrix` clears the decline while it still owns the dependency lock, so a bare
+    update sync queued behind it never reads the stale decline and publishes without matrix."""
+    import threading
+
+    monkeypatch.setattr(install, "_feature_policy", lambda extras, *, repair: (None, None))
+    package = _BlockingVenv()
+    monkeypatch.setattr(install, "get_package", lambda name: package)
+    install.sync_venv(["all"], explicit=True)
+    extras.record_declined_extras(add=["matrix"])
+
+    holders, _ = _watch_lock(monkeypatch)
+    queued_sync_selected = threading.Event()
+    real_target, real_record = install._target_selection, extras.record_declined_extras
+
+    def target(*args, **kwargs):
+        selection = real_target(*args, **kwargs)
+        if threading.current_thread() is not threading.main_thread():
+            queued_sync_selected.set()
+        return selection
+
+    def clear_decline(**kwargs):
+        # Cleared after the lock is released, the queued sync goes first: make that interleave certain.
+        if kwargs.get("remove") and threading.get_ident() not in holders:
+            assert queued_sync_selected.wait(30)
+        return real_record(**kwargs)
+
+    queued_errors = []
+
+    def queued_sync():
+        try:
+            install.sync_venv(explicit=True)
+        except BaseException as exc:
+            queued_errors.append(exc)
+
+    queued = threading.Thread(target=queued_sync)
+    package.hold[("all", "matrix")] = queued.start
+    monkeypatch.setattr(install, "_target_selection", target)
+    monkeypatch.setattr(extras, "record_declined_extras", clear_decline)
+
+    install.sync_venv(["matrix"], explicit=True)
+    queued.join(30)
+
+    assert not queued.is_alive() and queued_errors == []
+    assert package.built[-1] == ["all", "matrix"]
+    assert _recorded() == ["all", "matrix"]
+    assert extras.declined_extras() == frozenset()
+
+
+def test_without_during_an_opt_in_sync_stays_recorded(monkeypatch):
+    """`--without matrix` landing while `--extra matrix` builds waits for it, so the opt-in's
+    decline clear cannot erase the newer opt-out."""
+    import threading
+
+    monkeypatch.setattr(install, "_feature_policy", lambda extras, *, repair: (None, None))
+    settled, real_record = threading.Event(), extras.record_declined_extras
+    _watch_lock(monkeypatch, asked=settled)
+
+    def record(**kwargs):
+        result = real_record(**kwargs)
+        if kwargs.get("add"):
+            settled.set()
+        return result
+
+    def mid_build():
+        threading.Thread(target=install.decline_extras, args=(["matrix"],), name="opt-out").start()
+        # Set once the opt-out queues on the lock or, unlocked, has written its decline.
+        assert settled.wait(30)
+
+    package = _BlockingVenv({("all", "matrix"): mid_build})
+    monkeypatch.setattr(install, "get_package", lambda name: package)
+    monkeypatch.setattr(extras, "record_declined_extras", record)
+
+    install.sync_venv(["all", "matrix"], explicit=True)
+    for thread in threading.enumerate():
+        if thread.name == "opt-out":
+            thread.join(30)
+
+    assert extras.declined_extras() == frozenset({"matrix"})
+
+
+def test_without_after_a_failed_first_migration_keeps_the_other_legacy_extras(monkeypatch):
+    """A first PM sync that died before writing facts leaves the main-era venv as the only record of
+    what was installed: `--without matrix` seeds its sync from that scan and drops only matrix."""
+    calls = []
+    monkeypatch.setattr(pm.cli, "_install_names", lambda names, target=None, *, verify=True: 0)
+    monkeypatch.setattr(install, "activate", lambda **kwargs: [])
+    monkeypatch.setattr(install, "sync_venv", lambda extras=None, **kwargs: calls.append(list(extras or [])))
+    monkeypatch.setattr(pm.cli, "_install_defaults", lambda names, *, verify: None)
+    monkeypatch.setattr(pm.cli, "repo_root", lambda: root)
+    root = Path(os.environ["HERMES_HOME"]) / "checkout"
+    (root / "pyproject.toml").parent.mkdir(parents=True)
+    (root / "pyproject.toml").write_bytes((repo_root() / "pyproject.toml").read_bytes())
+    site = root / "venv" / "lib" / "python3.11" / "site-packages"
+    for anchor in (*extras._anchors("matrix"), "fal_client"):
+        (site / anchor).mkdir(parents=True)
+    monkeypatch.setattr(importlib.import_module("pm.paths"), "repo_root", lambda: root)
+
+    assert pm.cli.cmd_install(argparse.Namespace(names=None, tools_only=False, without=["matrix"])) == 0
+
+    assert calls == [["all", "fal"]]
+    assert extras.declined_extras(root) == frozenset({"matrix"})
+
+
+def test_automatic_repair_never_undoes_a_without_that_landed_after_its_read(monkeypatch):
+    """Configured-platform repair reads the declines, then asks PM for the configured extra. A
+    `--without matrix` completing between that read and PM's lock wins: repair's request was
+    Hermes's choice, not the user's, so it neither re-adds matrix nor clears the new decline."""
+    import pm.client
+    from hermes_cli import main_install_repair
+
+    monkeypatch.setattr(install, "_feature_policy", lambda extras, *, repair: (None, None))
+    package = _BlockingVenv()
+    monkeypatch.setattr(install, "get_package", lambda name: package)
+    monkeypatch.setattr(pm.client, "is_runtime", lambda: True)
+    monkeypatch.setattr(main_install_repair, "_configured_features_missing_deps",
+                        lambda: [("Matrix", "Run `hermes setup`.", "matrix")])
+    install.sync_venv(["all"], explicit=True)
+
+    real_lock, opted_out = install._venv_install_lock, []
+
+    def lock(**kwargs):
+        if not opted_out:
+            # Repair has read the declines and is about to take the lock: the opt-out lands first.
+            opted_out.append(True)
+            install.decline_extras(["matrix"])
+            install.sync_venv(["all"], explicit=True)
+        return real_lock(**kwargs)
+
+    monkeypatch.setattr(install, "_venv_install_lock", lock)
+    main_install_repair._install_configured_features_missing_deps(repo_root())
+
+    assert opted_out
+    assert extras.declined_extras() == frozenset({"matrix"})
+    assert _recorded() == ["all"]
+    assert all("matrix" not in built for built in package.built)
