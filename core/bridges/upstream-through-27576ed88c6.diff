+function startOwnedWorkspaceSession(
+  owner: AgentProfileRoute,
+  path: null | string,
+  activeSessionIdRef: MutableRefObject<string | null>,
+  startFreshSessionDraft: WorkspaceSessionOptions['startFreshSessionDraft']
