diff --git a/tests/hermes_cli/test_profile_distribution_swap.py b/tests/hermes_cli/test_profile_distribution_swap.py
new file mode 100644
index 00000000000..d1a8d4d4e70
--- /dev/null
+++ b/tests/hermes_cli/test_profile_distribution_swap.py
@@ -0,0 +1,100 @@
+"""Force-install swap failures: a copy or swap that fails part-way keeps the old tree."""
+
+from __future__ import annotations
+
+import shutil
+from pathlib import Path
+
+import pytest
+
+from hermes_cli.profile_distribution import install_distribution
+from tests.hermes_cli import test_profile_distribution as _base
+
+_make_staging_dir = _base._make_staging_dir
+profile_env = _base.profile_env
+
+
+def test_force_install_preserves_existing_dir_when_new_copy_fails(
+    profile_env, monkeypatch
+):
+    staged = _make_staging_dir(profile_env, "src")
+    plan = install_distribution(str(staged), name="target")
+    skill = plan.target_dir / "skills" / "demo" / "SKILL.md"
+    skill.write_text("old skill\n")
+    (staged / "skills" / "demo" / "SKILL.md").write_text("new skill\n")
+    original_copytree = shutil.copytree
+
+    def fail_skill_root_copy(src, dst, *args, **kwargs):
+        if Path(src).name == "demo":
+            Path(dst).mkdir(
+                parents=True, exist_ok=True
+            )  # a partial copy, then the lock bites
+            (Path(dst) / "SKILL.md").write_text("partial\n")
+            raise OSError("[WinError 145] The directory is not empty")
+        return original_copytree(src, dst, *args, **kwargs)
+
+    monkeypatch.setattr(
+        "hermes_cli.profile_distribution.shutil.copytree", fail_skill_root_copy
+    )
+
+    with pytest.raises(OSError, match="WinError 145"):
+        install_distribution(str(staged), name="target", force=True)
+
+    assert skill.read_text() == "old skill\n"
+    assert not list((plan.target_dir / "skills").glob(".*hermes-dist*"))
+
+
+def test_force_install_restores_existing_dir_when_staged_swap_fails(
+    profile_env, monkeypatch
+):
+    staged = _make_staging_dir(profile_env, "src")
+    plan = install_distribution(str(staged), name="target")
+    skill = plan.target_dir / "skills" / "demo" / "SKILL.md"
+    skill.write_text("old skill\n")
+    (staged / "skills" / "demo" / "SKILL.md").write_text("new skill\n")
+    original_rename = Path.rename
+
+    def fail_staged_swap(path, target):
+        if "demo" in path.name and "staging-" in path.name:
+            raise OSError("staged swap failed")
+        return original_rename(path, target)
+
+    monkeypatch.setattr(Path, "rename", fail_staged_swap)
+
+    with pytest.raises(OSError, match="staged swap failed"):
+        install_distribution(str(staged), name="target", force=True)
+
+    assert skill.read_text() == "old skill\n"
+    assert not list((plan.target_dir / "skills").glob(".*hermes-dist*"))
+
+
+def test_force_install_locked_old_tree_is_not_discovered(profile_env, monkeypatch):
+    from agent.skill_utils import is_excluded_skill_path, iter_skill_index_files
+    import hermes_cli.profile_distribution as pd
+
+    staged = _make_staging_dir(profile_env, "src")
+    plan = install_distribution(str(staged), name="target")
+    skills = plan.target_dir / "skills"
+    (skills / "demo" / "SKILL.md").write_text("old skill\n")
+    (staged / "skills" / "demo" / "SKILL.md").write_text("new skill\n")
+    original_remove = pd._remove_existing
+
+    def locked_backup(path):
+        if "demo" in path.name and "old-" in path.name:
+            raise PermissionError("[WinError 32] in use")
+        return original_remove(path)
+
+    monkeypatch.setattr(pd, "_remove_existing", locked_backup)
+
+    install_distribution(str(staged), name="target", force=True)
+
+    assert "old skill\n" in [
+        p.read_text() for p in skills.rglob("SKILL.md")
+    ]  # the leftover is on disk
+    walked = [p.read_text() for p in iter_skill_index_files(skills, "SKILL.md")]
+    globbed = [
+        p.read_text() for p in skills.rglob("SKILL.md") if not is_excluded_skill_path(p)
+    ]
+    for found in (walked, globbed):
+        assert "new skill\n" in found
+        assert "old skill\n" not in found
diff --git a/tests/hermes_cli/test_runtime_provider_missing_profile_key.py b/tests/hermes_cli/test_runtime_provider_missing_profile_key.py
new file mode 100644
index 00000000000..abfce0cb98b
--- /dev/null
+++ b/tests/hermes_cli/test_runtime_provider_missing_profile_key.py
@@ -0,0 +1,99 @@
+"""A named profile served by a multiplexing gateway reads provider keys only from its own ``.env``.
+
+When the endpoint's config declares ``key_env`` and that variable is missing from the profile's
+scope (it may exist in the server's process environment, which the profile must not read), the
+turn fails before any request with the provider, the variable, the profile and the command that
+stores the key, instead of sending the ``no-key-required`` placeholder and reporting the provider's
+401 as "rejected your API key". A custom block with no ``key_env`` is a keyless local server and
+keeps the placeholder.
+"""
+
+import json
+
+import pytest
+
+from agent import secret_scope
+
+
+def _named_profile(tmp_path, monkeypatch, *, key_env: bool, dotenv: str = "", model_extra=None):
+    home = tmp_path / ".hermes" / "profiles" / "beta"
+    home.mkdir(parents=True)
+    model = {"default": "fake-model", "provider": "custom", "base_url": "http://127.0.0.1:18991/v1", **(model_extra or {})}
+    entry = {"name": "FakeUp", "base_url": "http://127.0.0.1:18991/v1"}
+    if key_env:
+        entry["key_env"] = "CANARY_KEY"
+    (home / "config.yaml").write_text(json.dumps({"model": model, "custom_providers": [entry]}))
+    (home / ".env").write_text(dotenv)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    # The key lives only in the server's process environment: invisible to a routed profile.
+    monkeypatch.setenv("CANARY_KEY", "canary-process-env")
+    return home
+
+
+@pytest.fixture
+def multiplexed():
+    tokens = []
+
+    def bind(home):
+        tokens.append(secret_scope.set_secret_scope(secret_scope.build_profile_secret_scope(home)))
+
+    secret_scope.set_multiplex_active(True)
+    try:
+        yield bind
+    finally:
+        for token in reversed(tokens):
+            secret_scope.reset_secret_scope(token)
+        secret_scope.set_multiplex_active(False)
+
+
+def test_declared_key_missing_from_profile_scope_fails_before_the_request(tmp_path, monkeypatch, multiplexed):
+    from hermes_cli.auth import AuthError
+    from hermes_cli.runtime_provider import resolve_runtime_provider
+
+    multiplexed(_named_profile(tmp_path, monkeypatch, key_env=True))
+    with pytest.raises(AuthError) as excinfo:
+        resolve_runtime_provider()
+    message = str(excinfo.value)
+    assert excinfo.value.code == "missing_api_key"
+    for needle in ("FakeUp", "CANARY_KEY", "'beta'", "hermes -p beta config set CANARY_KEY"):
+        assert needle in message
+    assert "server's environment" in message  # the key the user exported is named as unreadable here
+    assert "canary-process-env" not in message
+
+
+@pytest.mark.parametrize("key_env,dotenv,expected_key", [
+    (False, "", "no-key-required"),  # keyless local server: placeholder, no error
+    (True, "CANARY_KEY=canary-profile-dotenv\n", "canary-profile-dotenv"),  # key in the profile's .env
+], ids=["keyless-local-endpoint", "key-in-profile-dotenv"])
+def test_keyless_endpoint_and_profile_key_still_resolve(tmp_path, monkeypatch, multiplexed, key_env, dotenv,
+                                                        expected_key):
+    from hermes_cli.runtime_provider import resolve_runtime_provider
+
+    multiplexed(_named_profile(tmp_path, monkeypatch, key_env=key_env, dotenv=dotenv))
+    runtime = resolve_runtime_provider()
+    assert runtime["provider"] == "custom"
+    assert runtime["api_key"] == expected_key
+
+
+@pytest.mark.parametrize("model_extra,kwargs,expect", [
+    # The codex app-server authenticates with its own login and never sends the resolved key.
+    ({"provider": "custom:FakeUp", "openai_runtime": "codex_app_server"}, {}, "codex_app_server"),
+    # A caller-supplied placeholder is a choice, not a synthesized stand-in for the unset variable.
+    ({}, {"explicit_api_key": "no-key-required"}, "chat_completions"),
+    # An explicit base_url replaces the selected entry's URL, not its key declaration.
+    ({"provider": "custom:FakeUp"}, {"explicit_base_url": "http://127.0.0.1:18992/v1"}, "missing_api_key"),
+], ids=["codex-app-server-owns-auth", "explicit-placeholder", "explicit-base-url-keeps-entry"])
+def test_only_a_synthesized_placeholder_for_the_selected_entry_is_refused(tmp_path, monkeypatch, multiplexed,
+                                                                         model_extra, kwargs, expect):
+    from hermes_cli.auth import AuthError
+    from hermes_cli.runtime_provider import resolve_runtime_provider
+
