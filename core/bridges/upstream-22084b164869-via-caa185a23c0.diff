+THOUGHT_TEXT_THOUGHT_CALL = [
+    {"type": "thought", "signature": SIG_A}, {"type": "model_output", "content": [{"type": "text", "text": "checking"}]},
+    {"type": "thought", "signature": SIG_B}, {"type": "function_call", "id": "c1", "name": "read", "arguments": {"p": 1}},
+]
