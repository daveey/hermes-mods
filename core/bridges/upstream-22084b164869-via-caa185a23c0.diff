+
+class QueuedFollowupAgent:
+    """Turn 1 emits progress, then a follow-up is queued; turn 2 records what the chat still showed."""
+
+    adapter = None
+    session_key = ""
+    deleted_at_turn2_start = None
+
+    def __init__(self, **kwargs):
+        self.tool_progress_callback = kwargs.get("tool_progress_callback")
+        self.tools = []
+
+    def run_conversation(self, message, conversation_history=None, task_id=None, **_kwargs):
+        from gateway.platforms.base import MessageEvent, MessageType
+        cls = type(self)
+        if message == "follow-up":
+            cls.deleted_at_turn2_start = list(cls.adapter.deleted)
+            return {"final_response": "second", "messages": [], "api_calls": 1}
+        cb = self.tool_progress_callback
+        cb("tool.started", "terminal", "pwd", {})
+        from tests.waiting import wait_until
+        wait_until(lambda: cls.adapter.sent, timeout=5, what="progress bubble delivered")
+        cls.adapter._pending_messages[cls.session_key] = MessageEvent(
+            text="follow-up", message_type=MessageType.TEXT,
+            source=SessionSource(platform=Platform.TELEGRAM, chat_id="-1001"))
+        return {"final_response": "first", "messages": [], "api_calls": 1}
+
+
+@pytest.mark.asyncio
+async def test_queued_followup_starts_after_prior_turn_bubbles_are_deleted(monkeypatch, tmp_path):
+    """The queued follow-up path returns before the normal-path cleanup registration; turn 1's
+    progress bubbles must still be deleted, and deleted BEFORE turn 2 begins."""
+    adapter = CleanupCaptureAdapter()
+    runner = _make_runner(adapter)
+    gateway_run = _install_fakes(monkeypatch, QueuedFollowupAgent, cleanup_on=True)
+    monkeypatch.setattr(gateway_run, "_hermes_home", tmp_path)
+    session_key = "agent:main:telegram:group:-1001"
+    QueuedFollowupAgent.adapter, QueuedFollowupAgent.session_key = adapter, session_key
+    QueuedFollowupAgent.deleted_at_turn2_start = None
+
+    result = await runner._run_agent(
+        message="hello", context_prompt="", history=[],
+        source=SessionSource(platform=Platform.TELEGRAM, chat_id="-1001"),
+        session_id="sess-1", session_key=session_key,
+    )
+
+    assert result["final_response"] == "second"
+    progress_ids = {m["message_id"] for m in adapter.sent if m["content"] != "first"}
+    assert progress_ids
+    assert QueuedFollowupAgent.deleted_at_turn2_start is not None
+    assert {d["message_id"] for d in QueuedFollowupAgent.deleted_at_turn2_start} >= progress_ids
+
+
+class HeldSendAdapter(CleanupCaptureAdapter):
+    """Holds every progress send open until the queued follow-up's turn starts."""
+
+    def __init__(self):
+        super().__init__()
+        self.loop = self.release = None
+        self.send_started = __import__("threading").Event()
+
+    async def send(self, chat_id, content, reply_to=None, metadata=None) -> SendResult:
+        if content not in ("first", "second"):
+            self.send_started.set()
+            await self.release.wait()
+        return await super().send(chat_id, content, reply_to=reply_to, metadata=metadata)
+
+
+class HeldSendAgent(QueuedFollowupAgent):
+    def run_conversation(self, message, conversation_history=None, task_id=None, **_kwargs):
+        from gateway.platforms.base import MessageEvent, MessageType
+        from tests.waiting import wait_until
+        cls, adapter = type(self), type(self).adapter
+        if message == "follow-up":
+            adapter.loop.call_soon_threadsafe(adapter.release.set)
+            return {"final_response": "second", "messages": [], "api_calls": 1}
+        self.tool_progress_callback("tool.started", "terminal", "pwd", {})
+        wait_until(adapter.send_started.is_set, timeout=5, what="progress send in flight")
+        adapter._pending_messages[cls.session_key] = MessageEvent(
+            text="follow-up", message_type=MessageType.TEXT,
+            source=SessionSource(platform=Platform.TELEGRAM, chat_id="-1001"))
+        return {"final_response": "first", "messages": [], "api_calls": 1}
+
+
+@pytest.mark.asyncio
+async def test_progress_send_in_flight_at_handoff_never_leaves_a_bubble(monkeypatch, tmp_path):
+    """A progress send still open when a queued follow-up takes over either lands before the
+    cleanup snapshot or never lands: no bubble from the finished turn outlives it."""
+    adapter = HeldSendAdapter()
+    adapter.loop, adapter.release = asyncio.get_running_loop(), asyncio.Event()
+    runner = _make_runner(adapter)
+    gateway_run = _install_fakes(monkeypatch, HeldSendAgent, cleanup_on=True)
+    monkeypatch.setattr(gateway_run, "_hermes_home", tmp_path)
+    session_key = "agent:main:telegram:group:-1001"
+    HeldSendAgent.adapter, HeldSendAgent.session_key = adapter, session_key
+
+    await runner._run_agent(
+        message="hello", context_prompt="", history=[],
+        source=SessionSource(platform=Platform.TELEGRAM, chat_id="-1001"),
+        session_id="sess-1", session_key=session_key,
+    )
+    for _ in range(20):
+        await asyncio.sleep(0)
+    progress_ids = {m["message_id"] for m in adapter.sent if m["content"] not in ("first", "second")}
+    assert progress_ids <= {d["message_id"] for d in adapter.deleted}
+
+
+@pytest.mark.asyncio
+async def test_one_slow_delete_does_not_strand_the_other_bubbles(monkeypatch):
+    """Cleanup runs under the post-delivery timeout; a hung delete must not use it all."""
+    from gateway import run_turn_bubble_cleanup as cleanup
+    from gateway.platforms.base_post_delivery import run_post_delivery_callback
+
+    class HungFirstDelete(CleanupCaptureAdapter):
+        async def delete_message(self, chat_id, message_id) -> bool:
+            if message_id == "1":
+                await asyncio.Event().wait()
+            return await super().delete_message(chat_id, message_id)
+
+    monkeypatch.setattr(cleanup, "DELETE_TIMEOUT_SECONDS", 0.05, raising=False)
+    adapter = HungFirstDelete()
+    turn_ctx = SimpleNamespace(
+        _cleanup_adapter=adapter, _cleanup_msg_ids=["1", "2"], session_key="k", _cleanup_progress=True,
+        source=SimpleNamespace(chat_id="-1001"), run_generation=None)
+    cleanup.register_bubble_cleanup({"final_response": "done"}, turn_ctx)
+    await run_post_delivery_callback(adapter.pop_post_delivery_callback("k"), timeout=5)
+    assert [d["message_id"] for d in adapter.deleted] == ["2"]
+
+
+@pytest.mark.asyncio
+async def test_hung_sender_delays_the_followup_by_at_most_the_cap(monkeypatch):
+    """A sender whose cancel-time flush never returns holds the handoff for the cap, not forever."""
+    from gateway import run_turn_bubble_cleanup as cleanup
+
+    async def _hung_sender():
+        try:
+            await asyncio.Event().wait()
+        except asyncio.CancelledError:
+            await asyncio.Event().wait()  # cancel-time edit that never returns
+
+    monkeypatch.setattr(cleanup, "DELETE_TIMEOUT_SECONDS", 0.1)
+    sender = asyncio.ensure_future(_hung_sender())
+    await asyncio.sleep(0)
+    # The 0.1 s cap is what returns; without it the outer bound expires and the test fails.
+    await asyncio.wait_for(cleanup.settle_turn_senders(sender, None), timeout=5)
+    await asyncio.sleep(0)
+    assert sender.done()
+
+
+@pytest.mark.asyncio
+async def test_cancelling_the_turn_during_the_sender_wait_starts_no_followup():
+    """A cancel aimed at the turn (shutdown, /stop) while it waits on its senders must propagate."""
+    from gateway import run_turn_bubble_cleanup as cleanup
+
+    release = asyncio.Event()
+
+    async def _slow_sender():
+        try:
+            await asyncio.Event().wait()
+        except asyncio.CancelledError:
+            await release.wait()
+
+    events = []
+
+    async def _turn(sender):
+        await cleanup.settle_turn_senders(sender)
+        events.append("follow-up started")
+
+    sender = asyncio.ensure_future(_slow_sender())
+    await asyncio.sleep(0)
+    turn = asyncio.ensure_future(_turn(sender))
+    for _ in range(5):
+        await asyncio.sleep(0)
+    turn.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await turn
+    assert events == []
+    release.set()
+    await asyncio.sleep(0)
diff --git a/tests/gateway/test_run_progress_oversized_item.py b/tests/gateway/test_run_progress_oversized_item.py
new file mode 100644
index 00000000000..65042c06b66
--- /dev/null
+++ b/tests/gateway/test_run_progress_oversized_item.py
@@ -0,0 +1,116 @@
+"""One tool-progress item larger than a Telegram message is shown whole, once (#151789).
+
+A /verbose terminal call queues its full multiline command as ONE progress item. When a content
+reset closed a flood-held bubble holding such an item, the owed edit was split by the adapter and a
+partial delivery settled it with its tail unseen; a carried remainder holding one went out as one
+send the adapter split, and a failed continuation re-sent the whole group, duplicating its head.
+Drives the real ``TelegramAdapter`` and the real progress mixin; only the PTB ``Bot`` is faked.
+"""
+
+import queue
+import re
+import time
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+from telegram.error import BadRequest, RetryAfter
+
+from gateway.config import PlatformConfig
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+MARKERS = {f"{i:04d}" for i in range(180)}
+
+
+def _bot(refuse):
+    """``refuse(attempt)`` returns the PTB exception the n-th ``send_message`` raises, or None.
+    ``shown`` maps message id to the text currently on screen (edits overwrite in place)."""
+    bot = SimpleNamespace(sends=0, shown={}, next_id=100)
+
+    async def send_message(**kwargs):
+        bot.sends += 1
+        if error := refuse(bot.sends):
+            raise error
+        bot.next_id += 1
+        bot.shown[bot.next_id] = kwargs["text"]
+        return SimpleNamespace(message_id=bot.next_id)
+
+    async def edit_message_text(**kwargs):
+        bot.shown[int(kwargs["message_id"])] = kwargs["text"]
+        return True
+
+    bot.send_message = AsyncMock(side_effect=send_message)
+    bot.edit_message_text = AsyncMock(side_effect=edit_message_text)
+    return bot
+
+
+def _held_bubble(bot, items):
+    """A progress bubble (message 7) holding ``items``, held by a flood window a content reset closes."""
+    from gateway.run_turn_progress import GatewayTurnProgressMixin
+
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="fake-token", typing_indicator=False))
+    adapter._bot = bot
+    loop = GatewayTurnProgressMixin()
+    loop._ctx = SimpleNamespace(
+        source=SimpleNamespace(chat_id="-1001"), _progress_metadata={}, _progress_reply_to=None,
+        _cleanup_progress=False, _run_still_current=lambda: True, progress_grouping="edit",
+        agent_holder=[SimpleNamespace(is_interrupted=False)], progress_queue=queue.Queue(),
+        last_progress_msg=[None], repeat_count=[0], last_was_terminal_block=[False])
+    st = loop._progress_edit_state(adapter)
+    st.progress_msg_id, st.flood_pending, st.flood_until = "7", True, time.monotonic() + 60
+    for item in items(loop, adapter):
+        loop._progress_absorb(st, item)
+    loop._reset_progress_bubble(st)  # a content bubble lands while the window is open
+    return loop, st
+
+
+def _penalty_runs_out(st):
+    st.flood_until = 0.0
+    st.adapter.__dict__.get("_telegram_send_cooldown_until", {}).clear()
+
+
+def _verbose_command(loop, adapter):
+    command = "\n".join(f"echo MARK{i:04d} " + "x" * 35 for i in range(180))
+    full, _ = loop._progress_terminal_blocks(adapter, "terminal", {"command": command}, "💻")
+    return [full]  # the real producer: one queue item for the whole command
+
+
+def _markers(bot):
+    return re.findall(r"MARK(\d{4})", "\n".join(bot.shown.values()))
+
+
+@pytest.mark.asyncio
+async def test_an_oversized_item_refused_mid_way_still_reaches_the_screen():
+    bot = _bot(lambda attempt: RetryAfter(20) if attempt == 1 else None)
+    loop, st = _held_bubble(bot, _verbose_command)
+
+    for _ in range(6):
+        _penalty_runs_out(st)
+        await loop._deliver_flood_pending_progress(st)
+
+    assert set(_markers(bot)) == MARKERS
+
+
+@pytest.mark.asyncio
+async def test_a_carried_oversized_item_is_never_shown_twice():
+    bot = _bot(lambda attempt: BadRequest("Chat write forbidden") if attempt == 2 else None)
+    loop, st = _held_bubble(bot, lambda loop, adapter: [
+        "short head", "\n".join(f"MARK{i:04d} " + "x" * 45 for i in range(180))])
+
+    for _ in range(8):
+        _penalty_runs_out(st)
+        await loop._deliver_flood_pending_progress(st)
+
+    shown = _markers(bot)
+    assert len(shown) == len(set(shown)) and set(shown) == MARKERS
+
+
+@pytest.mark.asyncio
+async def test_a_flood_refusal_after_a_dropped_reply_anchor_still_arms_the_wait():
+    bot = _bot(lambda attempt: BadRequest("Bad Request: reply message not found") if attempt == 1 else RetryAfter(20))
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="fake-token", typing_indicator=False))
+    adapter._bot = bot
+
+    result = await adapter._edit_overflow_split("-1001", "7", "word " * 2200, finalize=True)
+
+    assert result.retry_after == 20 and bot.sends == 2  # no third call into the penalty
diff --git a/tests/gateway/test_run_progress_owed_overflow.py b/tests/gateway/test_run_progress_owed_overflow.py
new file mode 100644
index 00000000000..2b65d3aa785
--- /dev/null
+++ b/tests/gateway/test_run_progress_owed_overflow.py
@@ -0,0 +1,128 @@
+"""A tool-progress bubble that outgrew the cap while a flood window was open is owed once (#151789).
+
+Inside the window the overflow roll cannot run, so a held bubble near the cap keeps absorbing lines.
+When a content bubble closes it, the owed edit used to carry the whole buffer: Telegram split it,
+re-edited chunk 1 and re-posted every continuation that had already landed on each idle tick, and a
+flood-refused continuation came back with no wait, so no window was armed and the loop went on.
+Drives the real ``TelegramAdapter`` and the real progress mixin; only the PTB ``Bot`` is faked.
+"""
+
+import queue
+import re
+import time
+from collections import Counter
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from gateway.config import PlatformConfig
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+
+class RetryAfter(Exception):
+    """PTB's ``telegram.error.RetryAfter`` shape: the penalty rides on ``retry_after``."""
+
+    def __init__(self, seconds: int):
+        super().__init__(f"Flood control exceeded. Retry in {seconds} seconds")
+        self.retry_after = seconds
+
+
+def _bot(refuse):
+    """A PTB bot fake: ``refuse(text, attempt)`` decides which ``send_message`` calls fail: truthy raises
+    a flood refusal, an exception instance is raised as is."""
+    bot = SimpleNamespace(sends=[], landed=[], edits=[])
+
+    async def send_message(**kwargs):
+        bot.sends.append(kwargs["text"])
+        refused = refuse(kwargs["text"], len(bot.sends))
+        if isinstance(refused, Exception):
+            raise refused
+        if refused:
+            raise RetryAfter(20)
+        bot.landed.append(kwargs["text"])
+        return SimpleNamespace(message_id=100 + len(bot.landed))
+
+    async def edit_message_text(**kwargs):
+        bot.edits.append(kwargs["text"])
+        return True
+
+    bot.send_message = AsyncMock(side_effect=send_message)
+    bot.edit_message_text = AsyncMock(side_effect=edit_message_text)
+    return bot
+
+
+def _held_over_cap_bubble(bot, content_resets=1):
+    from gateway.run_turn_progress import GatewayTurnProgressMixin
+
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="fake-token"))
+    adapter._bot = bot
+    loop = GatewayTurnProgressMixin()
+    loop._ctx = SimpleNamespace(
+        source=SimpleNamespace(chat_id="-1001"), _progress_metadata={}, _progress_reply_to=None,
+        _cleanup_progress=False, _run_still_current=lambda: True, progress_grouping="edit",
+        agent_holder=[SimpleNamespace(is_interrupted=False)], progress_queue=queue.Queue(),
+        last_progress_msg=[None], repeat_count=[0])
+    st = loop._progress_edit_state(adapter)
+    st.progress_msg_id, st.flood_pending, st.flood_until = "7", True, time.monotonic() + 60
+    for i in range(160):  # ~9.4k chars: well past one Telegram message
+        loop._progress_absorb(st, f'💻 terminal: "build step {i:03d} running the long command here"')
+    for _ in range(content_resets):  # content bubbles land while the window is still open
+        loop._reset_progress_bubble(st)
+    st.flood_until = 0.0  # the window closes while the agent keeps working
+    return loop, st
+
+
+async def _idle_ticks(loop, st, n=6):
+    for _ in range(n):
+        await loop._deliver_flood_pending_progress(st)
+
+
+@pytest.mark.asyncio
+async def test_owed_over_cap_bubble_never_reposts_a_landed_message():
+    bot = _bot(lambda text, attempt: "(3/" in text)  # one continuation stays refused
+    loop, st = _held_over_cap_bubble(bot)
+
+    await _idle_ticks(loop, st)
+
+    reposted = {text: n for text, n in Counter(bot.landed).items() if n > 1}
+    assert not reposted, f"{len(bot.landed)} landed, re-posted: {list(reposted)[:1]}"
+    assert len(bot.edits) == 1  # the closed bubble gets its owed edit once
+
+
+@pytest.mark.asyncio
+async def test_a_flood_refused_progress_message_arms_the_window_instead_of_looping():
+    bot = _bot(lambda text, attempt: attempt == 1)  # the first message after the window is refused
+    loop, st = _held_over_cap_bubble(bot)
+
+    await _idle_ticks(loop, st)
+
+    assert st.flood_until > time.monotonic() + 10  # the 20 s penalty is honoured
+    assert len(bot.sends) == 1, bot.sends  # nothing else fired into it, no plain-text retry either
+
+
+def _shown_steps(bot):
+    return set(re.findall(r"build step (\d{3})", "\n".join(bot.edits + bot.landed)))
+
+
+@pytest.mark.asyncio
+async def test_a_second_content_bubble_inside_the_window_keeps_the_carried_lines():
+    bot = _bot(lambda text, attempt: False)
+    loop, st = _held_over_cap_bubble(bot, content_resets=2)  # text, tool, more text: one penalty
+
+    await _idle_ticks(loop, st)
+
+    assert _shown_steps(bot) == {f"{i:03d}" for i in range(160)}
+    assert len(bot.landed) == len(set(bot.landed))
+
+
+@pytest.mark.parametrize("error", [Exception("Bad Request: chat write forbidden"), ConnectionError("Connection reset")])
+@pytest.mark.asyncio
+async def test_a_non_flood_failure_of_the_carried_lines_is_retried(error):
+    bot = _bot(lambda text, attempt: error if attempt == 1 else False)
+    loop, st = _held_over_cap_bubble(bot)
+
+    await _idle_ticks(loop, st)
+
+    assert _shown_steps(bot) == {f"{i:03d}" for i in range(160)}
+    assert len(bot.landed) == len(set(bot.landed))
