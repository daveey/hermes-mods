+        401, json={"error": {"message": f"bad key {echoed}", "type": "authentication_error"}}), calls))
+    result = fc.check_entry_live({"provider": "local-oai", "model": "m"},
+                                 _ready())
+    assert result.status == "live_auth" and echoed not in result.error
+    assert len(calls) == 1
