@@ -0,0 +1,29 @@
+/**
+ * The Webapp's browser notification permission as one store, so every control
+ * that can ask (the Allow button, Send test notification) and every row that
+ * shows the answer agree. The user can also change it in the browser's site
+ * settings, so a view refreshes it when it opens.
+ */
+
+import { atom } from 'nanostores'
+
+import {
+  browserNotificationPermission,
+  type BrowserNotificationPermission,
+  requestBrowserNotificationPermission
+} from '@/lib/browser-notifications'
+
+export const $browserNotificationPermission = atom<BrowserNotificationPermission>(browserNotificationPermission())
+
+export function refreshBrowserNotificationPermission(): void {
+  $browserNotificationPermission.set(browserNotificationPermission())
+}
+
+/** Call from a click handler only. */
+export async function askBrowserNotificationPermission(): Promise<BrowserNotificationPermission> {
+  const permission = await requestBrowserNotificationPermission()
+
+  $browserNotificationPermission.set(permission)
+
+  return permission
+}
diff --git a/apps/desktop/src/store/browser-tab-attention.test.ts b/apps/desktop/src/store/browser-tab-attention.test.ts
new file mode 100644
index 00000000000..c0351978416
--- /dev/null
+++ b/apps/desktop/src/store/browser-tab-attention.test.ts
@@ -0,0 +1,133 @@
+// The background tab flash must leave nothing behind once the user is back:
+// title, favicon and interval all reset however they return, and an icon that
+// finishes loading after the return must not re-badge the tab.
+import { cleanup } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { $tabFlashText, flagTabAttention } from './browser-tab-attention'
+import { installBrowserTabTitle } from './browser-tab-title'
+
+vi.mock('@/lib/host-capabilities', () => ({ hostHas: (name: string) => name === 'tabTitleStatus' }))
+// This suite owns tab-attention timers, not the fork's unrelated Kanban freshness clock.
+vi.mock('./session-dot-state', async () => {
+  const { atom } = await import('nanostores')
+  return { $unreadSessionCount: atom(0) }
+})
+
+const ICON = 'http://localhost/icon.png'
+const BADGED = 'data:image/png;base64,badged'
+
+const images: { onload: (() => void) | null; src: string }[] = []
+
+class FakeImage {
+  onload: (() => void) | null = null
+  src = ''
+  constructor() {
+    images.push(this)
+  }
+}
+
+let away = true
+let link: HTMLLinkElement
+let uninstallTitle: () => void
+
+function comeBack(how: 'focus' | 'visibilitychange') {
+  away = false
+
+  if (how === 'focus') {
+    window.dispatchEvent(new Event('focus'))
+  } else {
+    document.dispatchEvent(new Event('visibilitychange'))
+  }
+}
+
+function expectFullyReset() {
+  expect($tabFlashText.get()).toBeNull()
+  expect(document.title).toBe('Hermes')
+  expect(link.href).toBe(ICON)
+  expect(vi.getTimerCount()).toBe(0)
+}
+
+beforeEach(() => {
+  vi.useFakeTimers()
+  away = true
+  images.length = 0
+  vi.stubGlobal('Image', FakeImage)
+  Object.defineProperty(document, 'hidden', { configurable: true, get: () => away })
+  vi.spyOn(document, 'hasFocus').mockImplementation(() => !away)
+  vi.spyOn(HTMLCanvasElement.prototype, 'getContext').mockImplementation(
+    () =>
+      ({
+        arc: vi.fn(),
+        beginPath: vi.fn(),
+        drawImage: vi.fn(),
+        fill: vi.fn(),
+        stroke: vi.fn()
+      }) as unknown as CanvasRenderingContext2D
+  )
+  vi.spyOn(HTMLCanvasElement.prototype, 'toDataURL').mockReturnValue(BADGED)
+  link = document.createElement('link')
+  link.rel = 'icon'
+  link.href = ICON
+  document.head.appendChild(link)
+  uninstallTitle = installBrowserTabTitle()
+})
+
+afterEach(() => {
+  // Leave the module idle for the next test whatever this one asserted.
+  away = false
+  window.dispatchEvent(new Event('focus'))
+  uninstallTitle()
+  link.remove()
+  cleanup()
+  vi.restoreAllMocks()
+  vi.unstubAllGlobals()
+  vi.useRealTimers()
+})
+
+describe('flagTabAttention', () => {
+  it.each(['focus', 'visibilitychange'] as const)(
+    'retargets one flash and resets title, favicon and timer on return via %s',
+    how => {
+      flagTabAttention('Approval needed')
+      expect(document.title).toBe('Approval needed')
+      images[0].onload?.()
+      expect(link.href).toBe(BADGED)
+
+      vi.advanceTimersByTime(1000)
+      expect(document.title).toBe('Hermes')
+
+      flagTabAttention('Question for you')
+      expect(document.title).toBe('Question for you')
+      expect(vi.getTimerCount()).toBe(1)
+      expect(images).toHaveLength(1)
+      vi.advanceTimersByTime(2000)
+      expect(document.title).toBe('Question for you')
+
+      comeBack(how)
+      expectFullyReset()
+
+      // Listeners are gone too: a later away/back cycle without a new event changes nothing.
+      away = true
+      vi.advanceTimersByTime(5000)
+      expect(document.title).toBe('Hermes')
+    }
+  )
+
+  it('does not re-badge the favicon when its load finishes after the user returned', () => {
+    flagTabAttention('Approval needed')
+    comeBack('focus')
+
+    images[0].onload?.()
+    expectFullyReset()
+  })
+
+  it('does nothing while the user is looking at the tab', () => {
+    away = false
+    flagTabAttention('Approval needed')
+
+    expect(document.title).toBe('Hermes')
+    expect(images).toHaveLength(0)
+    expect(vi.getTimerCount()).toBe(0)
+  })
+})
diff --git a/apps/desktop/src/store/browser-tab-attention.ts b/apps/desktop/src/store/browser-tab-attention.ts
new file mode 100644
index 00000000000..654b60fecaa
--- /dev/null
+++ b/apps/desktop/src/store/browser-tab-attention.ts
@@ -0,0 +1,126 @@
+/**
+ * Tab attention for the Webapp: while the tab is in the background and an
+ * event that would raise an OS notification arrives, the tab title alternates
+ * between that notification's title and the normal one, and the favicon wears
+ * a dot, until the user comes back to the tab. The browser counterpart of
+ * Electron's `flashFrame`; it never focuses or navigates on its own.
+ */
+
+import { atom } from 'nanostores'
+
+import { hostHas } from '@/lib/host-capabilities'
+
+const FLASH_INTERVAL_MS = 1000
+const BADGE_COLOR = '#f59e0b'
+
+/** The text shown in place of the normal title right now; null shows the normal title. */
+export const $tabFlashText = atom<null | string>(null)
+
+let label: null | string = null
+let timer: null | ReturnType<typeof setInterval> = null
+const originalIconHrefs = new Map<HTMLLinkElement, string>()
+
+function userIsAway(): boolean {
+  return document.hidden || (typeof document.hasFocus === 'function' && !document.hasFocus())
+}
+
+function iconLinks(): HTMLLinkElement[] {
+  return Array.from(document.querySelectorAll<HTMLLinkElement>('link[rel~="icon"]'))
+}
+
+function badgeFavicon(): void {
+  const links = iconLinks()
+  const source = links[0]?.href
+
+  if (!source || originalIconHrefs.size) {
+    return
+  }
+
+  links.forEach(link => originalIconHrefs.set(link, link.href))
+
+  const image = new Image()
+
+  image.onload = () => {
+    // The flash may have ended while the icon loaded.
+    if (!originalIconHrefs.size) {
+      return
+    }
+
+    const size = 64
+    const canvas = document.createElement('canvas')
+
+    canvas.width = size
+    canvas.height = size
+    const context = canvas.getContext('2d')
+
+    if (!context) {
+      return
+    }
+
+    context.drawImage(image, 0, 0, size, size)
+    context.beginPath()
+    context.arc(size * 0.75, size * 0.25, size * 0.22, 0, Math.PI * 2)
+    context.fillStyle = BADGE_COLOR
+    context.fill()
+    context.lineWidth = size * 0.06
+    context.strokeStyle = '#ffffff'
+    context.stroke()
+    const badged = canvas.toDataURL('image/png')
+
+    originalIconHrefs.forEach((_, link) => (link.href = badged))
+  }
+
+  image.src = source
+}
+
+function restoreFavicon(): void {
+  originalIconHrefs.forEach((href, link) => (link.href = href))
+  originalIconHrefs.clear()
+}
+
+function stop(): void {
+  if (timer) {
+    clearInterval(timer)
+  }
+
+  timer = null
+  label = null
+  $tabFlashText.set(null)
+  restoreFavicon()
+  window.removeEventListener('focus', onReturn)
+  document.removeEventListener('visibilitychange', onReturn)
+}
+
+function onReturn(): void {
+  if (!userIsAway()) {
+    stop()
+  }
+}
+
+/** Start (or retarget) the flash for a notification titled `text`. A no-op
+ *  while the user is looking at the tab, and outside a browser host. */
+export function flagTabAttention(text: string): void {
+  if (typeof document === 'undefined' || !hostHas('tabTitleStatus') || !userIsAway()) {
+    return
+  }
+
+  label = text
+  $tabFlashText.set(text)
+  badgeFavicon()
+
+  if (timer) {
+    return
+  }
+
+  window.addEventListener('focus', onReturn)
+  document.addEventListener('visibilitychange', onReturn)
+  timer = setInterval(() => {
+    if (!userIsAway()) {
+      stop()
+
+      return
+    }
+
+    $tabFlashText.set($tabFlashText.get() === null ? label : null)
+  }, FLASH_INTERVAL_MS)
+}
