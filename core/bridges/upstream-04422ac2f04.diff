+
+const running: CronJob = {
+  deliver: 'local',
+  enabled: true,
+  id: 'job-1',
+  latest_execution: { claimed_at: '2026-10-25T21:00:00Z', id: 'exec-1', status: 'running' },
+  name: 'Nightly digest',
+  prompt: 'Summarize',
