+   try:
+    ss=os.stat(stale,dir_fd=dd,follow_symlinks=False)
+    if stat.S_ISREG(ss.st_mode) and now-ss.st_mtime>3600:os.unlink(stale,dir_fd=dd)
+   except OSError:pass
