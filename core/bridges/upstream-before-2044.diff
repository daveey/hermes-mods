index 00000000000..1a292b87b45
--- /dev/null
+++ b/hermes_cli/gateway_connections_probe.py
@@ -0,0 +1,74 @@
+"""The Webapp's Test button for a saved gateway: the reachability probe Desktop's
+``hermes:connections:test`` runs, from the serving gateway's side.
+
+The HTTP leg is the one Desktop runs first: ``GET <url>/api/status`` with the credential the entry
+saves (``X-Hermes-Session-Token`` for a token-mode remote, ``Authorization: Bearer`` for an
+oauth-mode sign-in in ``gateway-connection-tokens.json``) plus its extra headers. ``local`` is the
+serving gateway itself. SSH entries use the shared reach module's managed tunnel and its
+session token, then run the same authenticated HTTP probe.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from starlette.concurrency import run_in_threadpool
+
+from hermes_cli import gateway_connections as store
+from hermes_cli import gateway_connections_reach as reach
+
+_TIMEOUT_S = 8.0
+
+
+def _credential_headers(connection_id: str) -> tuple[str, dict[str, str]]:
+    """``(url, headers)`` from one store read, so the credential always belongs to the URL probed."""
+    snap = store.dial_snapshot(connection_id)
+    headers = dict(snap["headers"])
+    if snap["entry"].get("authMode") == "oauth":
+        if not snap["tokens"]:
+            raise store.ConnectionStoreError("This connection is not signed in. Sign in to it first.")
+        headers["Authorization"] = f"Bearer {snap['tokens']['accessToken']}"
+    elif snap["token"]:
+        headers["X-Hermes-Session-Token"] = snap["token"]
+    else:
+        raise store.ConnectionStoreError(
+            "This connection has no saved session token. Edit the connection and paste one.")
+    if not snap["url"]:
+        raise store.ConnectionStoreError("This connection has no gateway address.")
+    return snap["url"], headers
+
+
+async def _probe(base_url: str, headers: dict[str, str]) -> dict[str, Any]:
+    import httpx
+
+    from hermes_cli.web_routers.config_env import _endpoint_probe_client
+
+    async with _endpoint_probe_client(base_url, _TIMEOUT_S) as client:
+        try:
+            resp = await client.get(f"{base_url}/api/status", headers=headers)
+        except httpx.HTTPError as exc:
+            raise store.ConnectionStoreError(f"Could not reach the gateway: {exc}") from exc
+    if resp.status_code in (401, 403):
+        raise store.ConnectionStoreError(f"The gateway refused the saved credential (HTTP {resp.status_code}).")
+    if resp.status_code >= 400:
+        raise store.ConnectionStoreError(f"The gateway answered HTTP {resp.status_code}.")
+    try:
+        body = resp.json()
+    except ValueError:
+        body = {}
+    return {"ok": True, "baseUrl": base_url, "version": (body or {}).get("version") or None}
+
+
+async def probe_connection(connection_id: str) -> dict[str, Any]:
+    """Raises the store's and the reach path's own errors; the route maps them to HTTP."""
+    entry = next((c for c in store.read_registry()["connections"] if c["id"] == connection_id), None)
+    if entry is None:
+        raise store.NoSuchConnection(f'No connection with id "{connection_id}".')
+    if entry["kind"] == "local":
+        from hermes_cli import __version__
+
+        return {"ok": True, "baseUrl": None, "version": __version__}
+    if entry["kind"] == "ssh":
+        target = await run_in_threadpool(reach.resolve_target, connection_id)
+        return await _probe(*target)
+    return await _probe(*_credential_headers(entry["id"]))
diff --git a/hermes_cli/gateway_connections_reach.py b/hermes_cli/gateway_connections_reach.py
new file mode 100644
index 00000000000..8ae1334bdde
--- /dev/null
+++ b/hermes_cli/gateway_connections_reach.py
@@ -0,0 +1,125 @@
+"""Where the relay proxy dials a saved gateway connection, and with which credentials.
+
+:func:`resolve_target` is the one hook the proxy calls per request: ``(base_url, headers)`` for the
+registry entry, exactly the credentials native Desktop sends for that auth mode:
+
+- token-mode remote/cloud: ``X-Hermes-Session-Token`` (``electron/main.ts`` fetchJson), plus the
+  entry's extra headers (Cloudflare Access and the like);
+- oauth-mode remote/cloud: ``Authorization: Bearer <access token>``, refreshed through the remote's
+  ``/auth/native/refresh`` when at/near expiry (:mod:`hermes_cli.gateway_connections_oauth`), plus
+  the extra headers. After the remote answers 401, call again with ``rejected_token`` to force one
+  rotation (``oauth-rest-request.ts``: only a structured 401 earns it);
+- ssh: the tunnel's forwarded ``http://127.0.0.1:<port>`` and the owned serve's session token
+  (:mod:`hermes_cli.gateway_connections_ssh` ensures the tunnel; it blocks, so call it off the loop).
+
+:func:`mint_ws_ticket` mints the remote's one-use socket ticket for an oauth-mode entry the way
+Desktop does (``POST /api/auth/ws-ticket`` with the bearer). Token-mode and ssh sockets carry the
+session token as ``?token=`` (``connection-config.ts::buildGatewayWsUrl``) and need no ticket.
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+import httpx
+
+from hermes_cli import gateway_connections as store
+from hermes_cli import gateway_connections_oauth as oauth
+
+SESSION_TOKEN_HEADER = "X-Hermes-Session-Token"
+_TICKET_TIMEOUT_S = 8.0
+
+
+def _entry(connection_id: str) -> dict:
+    entry = next((c for c in store.read_registry()["connections"] if c["id"] == connection_id), None)
+    if entry is None:
+        raise store.NoSuchConnection(f'No connection with id "{connection_id}".')
+    return entry
+
+
+def _remote_target(entry: dict, rejected_token: str) -> tuple[str, dict[str, str]]:
+    if entry.get("authMode") == "oauth":
+        # The token comes back with the address it was issued by and that read's extra headers:
+        # one snapshot, never this entry's (possibly older) URL paired with a newer sign-in.
+        grant = oauth.ensure_access_token(entry["id"], rejected_token=rejected_token)
+        return grant.base_url, {**grant.headers, "Authorization": f"Bearer {grant.access_token}"}
+    snap = store.dial_snapshot(entry["id"])
+    if snap["url"] is None or snap["entry"].get("kind") not in ("remote", "cloud") \
+            or snap["entry"].get("authMode") == "oauth":
+        raise store.ConnectionStoreError(f'"{entry.get("label")}" changed while connecting; try again.')
+    headers = dict(snap["headers"])
+    if snap["token"]:
+        headers[SESSION_TOKEN_HEADER] = snap["token"]
+    return snap["url"], headers
+
+
+def _ssh_target(entry: dict, _rejected_token: str) -> tuple[str, dict[str, str]]:
+    from hermes_cli import gateway_connections_ssh as ssh
+
+    tunnel = ssh.ensure_tunnel(entry)
+    return tunnel.base_url, {SESSION_TOKEN_HEADER: tunnel.token}
+
+
+_BY_KIND = {"remote": _remote_target, "cloud": _remote_target, "ssh": _ssh_target}
+
+
+def resolve_target(connection_id: str, *, rejected_token: str = "") -> tuple[str, dict[str, str]]:
+    """``(base_url, headers)`` to reach *connection_id* as a normal client of that gateway.
+
+    Raises :class:`store.NoSuchConnection` (404), :class:`store.ConnectionStoreError` (400: the
+    local entry, or a remote with no URL), :class:`oauth.NotSignedIn` (the user must sign in),
+    :class:`oauth.OAuthSignInError` (the remote could not renew it) and
+    ``gateway_connections_ssh.SshReachError`` (the tunnel could not be brought up)."""
+    entry = _entry(connection_id)
+    target = _BY_KIND.get(str(entry.get("kind") or ""))
+    if target is None:
+        raise store.ConnectionStoreError("The local connection is this gateway itself; it is not relayed.")
+    if entry.get("kind") != "ssh" and not entry.get("url"):
+        raise store.ConnectionStoreError(f'"{entry.get("label")}" has no gateway address.')
+    return target(entry, rejected_token)
+
+
+def _post_ticket(base_url: str, headers: dict[str, str]) -> httpx.Response:
+    with httpx.Client(timeout=_TICKET_TIMEOUT_S, trust_env=False, follow_redirects=False) as client:
+        return client.post(f"{base_url}/api/auth/ws-ticket", headers=headers)
+
+
+def mint_ws_ticket(connection_id: str, *, for_base_url: Optional[str] = None) -> Optional[str]:
+    """The remote's one-use socket ticket for an oauth-mode *connection_id*; ``None`` for the auth
+    modes whose socket carries the session token instead. One forced rotation on a 401.
+
+    With *for_base_url* (the address the socket will dial), a ticket is minted only by that
+    gateway: an entry re-pointed meanwhile is refused rather than handing one host's ticket to
+    another."""
+    entry = _entry(connection_id)
+    if entry.get("kind") not in ("remote", "cloud") or entry.get("authMode") != "oauth":
+        return None
+    base_url, headers = _ticket_target(connection_id, "", for_base_url)
+    response = _post_ticket(base_url, headers)
+    if response.status_code == 401:
+        rejected = headers["Authorization"].removeprefix("Bearer ")
+        base_url, headers = _ticket_target(connection_id, rejected, for_base_url or base_url)
+        response = _post_ticket(base_url, headers)
+    if response.status_code != 200:
+        raise oauth.OAuthSignInError(f"{base_url} refused a socket ticket ({response.status_code}).")
+    ticket = (response.json() or {}).get("ticket")
+    if not isinstance(ticket, str) or not ticket:
+        raise oauth.OAuthSignInError(f"{base_url} did not return a socket ticket.")
+    return ticket
+
+
+def _ticket_target(connection_id: str, rejected_token: str, for_base_url: Optional[str]) -> tuple[str, dict[str, str]]:
+    base_url, headers = resolve_target(connection_id, rejected_token=rejected_token)
+    if for_base_url is not None and base_url != for_base_url.rstrip("/"):
+        raise oauth.OAuthSignInError("The connection changed address while connecting; try again.")
+    return base_url, headers
+
+
+def forget(connection_id: str) -> None:
+    """Drop what reaching *connection_id* holds on this machine: its SSH tunnel (and the owned
+    remote serve) and its sign-in. For the store's remove path."""
+    from hermes_cli import gateway_connections_ssh as ssh
+
+    ssh.disconnect(connection_id)
+    oauth.cancel_sign_in(connection_id)
+    store.drop_tokens([connection_id])
diff --git a/hermes_cli/gateway_connections_ssh.py b/hermes_cli/gateway_connections_ssh.py
new file mode 100644
index 00000000000..c649b1c683e
--- /dev/null
+++ b/hermes_cli/gateway_connections_ssh.py
@@ -0,0 +1,229 @@
+"""Gateway SSH connections: a ControlMaster tunnel to a remote ``hermes serve``.
+
+Server-side port of Desktop's SSH attach path (``apps/desktop/electron/ssh-connection.ts`` +
+``remote-lifecycle.ts``). ``ensure_tunnel`` opens (or reuses) a ControlMaster to the registry
+entry's host, starts or attaches a provably-owned ``serve --isolated`` there and forwards a
+127.0.0.1-only local port to it. Linux/macOS on both ends.
+
+Ownership is scoped to THIS gateway's connections store, not to a Desktop install: two clients
+sharing one remote never reap each other's serve. The serve's session token lives in process memory
+only; a fresh process cannot prove the old serve's token, so it reaps that (provably owned) serve
+and spawns anew.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import threading
+import time
+from dataclasses import dataclass
+from pathlib import Path
+
+from hermes_cli.gateway_connections_ssh_remote import (
+    DEFAULT_READY_TIMEOUT_S,
+    ConnectDeps,
+    Connected,
+    classify_ssh_reuse_proof,
+    connect,
+    disconnect_remote,
+)
+from hermes_cli.gateway_connections_ssh_transport import (
+    SshConnection,
+    SshEndpoint,
+    SshReachError,
+    control_socket_path,
+    default_control_dir,
+    pick_local_port,
+    resolve_ssh_binary,
+)
+
+__all__ = ["SshReachError", "SshTarget", "close_all", "disconnect", "ensure_tunnel", "tunnel_status"]
+
+HEALTH_TIMEOUT_S = 30.0
+_HTTP_TIMEOUT_S = 5.0
+
+
+@dataclass(frozen=True)
+class SshTarget:
+    base_url: str
+    token: str
+    local_port: int
+    remote_port: int
+    pid: int
+    reused: bool
+    hermes_version: str
+
+
+@dataclass
+class _Tunnel:
+    ssh: SshConnection
+    ownership_id: str
+    connected: Connected
+    host: str
+    fingerprint: tuple
+
+
+_tunnels: dict[str, _Tunnel] = {}
+_locks: dict[str, threading.Lock] = {}
+_registry_lock = threading.Lock()
+
+
+def _connection_lock(connection_id: str) -> threading.Lock:
+    with _registry_lock:
+        return _locks.setdefault(connection_id, threading.Lock())
+
+
+def store_root(root: Path | None = None) -> Path:
+    """The gateway-connections store root: a profile home names its root (ui_preferences rule)."""
+    if root is not None:
+        return Path(os.path.realpath(root))
+    from hermes_constants import get_hermes_home
+
+    home = Path(os.path.abspath(get_hermes_home()))
+    return (home.parent.parent if home.parent.name.lower() == "profiles" else home).resolve()
+
+
+def ownership_id(root: Path, connection_id: str) -> str:
+    return hashlib.sha256(f"hermes-gateway-connections\0{root}\0{connection_id}".encode()).hexdigest()[:32]
+
+
+def _http_get(url: str, token: str = ""):
+    import httpx
+
+    headers = {"X-Hermes-Session-Token": token} if token else {}
+    return httpx.get(url, headers=headers, timeout=_HTTP_TIMEOUT_S, trust_env=False)
+
+
+def _health_ok(base_url: str) -> bool:
+    import httpx
+
+    try:
+        response = _http_get(f"{base_url}/api/health")
+    except httpx.HTTPError:
+        return False
+    return response.status_code == 200 and response.json().get("ok") is True
+
+
+def _wait_for_health(base_url: str) -> None:
+    deadline = time.monotonic() + HEALTH_TIMEOUT_S
+    while time.monotonic() < deadline:
+        if _health_ok(base_url):
+            return
+        time.sleep(0.25)
+    raise SshReachError("ready-timeout", f"The forwarded remote serve never answered /api/health ({HEALTH_TIMEOUT_S:.0f}s).")
+
+
+def _probe_reuse_proof(base_url: str, token: str, spawn_nonce: str) -> str:
+    response = _http_get(f"{base_url}/api/ssh/ownership", token)
+    if response.status_code in (401, 403, 404):
+        return "authenticated-stale"
+    response.raise_for_status()
+    return classify_ssh_reuse_proof(response.json(), spawn_nonce)
+
+
+def _endpoint(connection: dict, root: Path, oid: str) -> SshEndpoint:
+    host, user = str(connection.get("host") or ""), str(connection.get("user") or "")
+    port = int(connection.get("port") or 22)
+    key_path = str(connection.get("keyPath") or "")
+    path = control_socket_path(user, host, port, default_control_dir(root), key_path=key_path, ownership_id=oid)
+    return SshEndpoint(host=host, user=user, port=port, key_path=key_path, control_path=str(path))
+
+
+def _fingerprint(connection: dict) -> tuple:
+    return tuple(str(connection.get(k) or "") for k in ("host", "user", "port", "keyPath", "remoteHermesPath",
+                                                         "remoteProfile"))
+
+
+def _target(tunnel: _Tunnel) -> SshTarget:
+    c = tunnel.connected
+    return SshTarget(c.base_url, c.token, c.local_port, c.remote_port, c.pid, c.reused, c.hermes_version)
+
+
+def _live_reuse(tunnel: _Tunnel) -> bool:
+    if not tunnel.ssh.is_alive() or not _health_ok(tunnel.connected.base_url):
+        return False
+    import httpx
+
+    try:
+        verdict = _probe_reuse_proof(tunnel.connected.base_url, tunnel.connected.token, tunnel.connected.spawn_nonce)
+    except httpx.HTTPError:
+        return False
+    return verdict == "authenticated-ok"
+
+
+def _teardown(tunnel: _Tunnel) -> None:
+    c = tunnel.connected
+    tunnel.ssh.cancel_forward(c.local_port, c.remote_port)
+    try:
+        disconnect_remote(tunnel.ssh, tunnel.ownership_id)
+    finally:
+        tunnel.ssh.close()
+
+
+def ensure_tunnel(connection: dict, *, root: Path | None = None) -> SshTarget:
+    """A live tunnel to the connection's remote serve; synchronous (run it in a threadpool)."""
+    connection_id = str(connection.get("id") or "")
+    if not connection_id:
+        raise SshReachError("unknown", "SSH connection entry has no id.")
+    with _connection_lock(connection_id):
+        existing = _tunnels.get(connection_id)
+        if existing and existing.fingerprint == _fingerprint(connection) and _live_reuse(existing):
+            return _target(existing)
+        if existing:
+            _tunnels.pop(connection_id, None)
+            if existing.fingerprint != _fingerprint(connection):
+                _teardown(existing)
+                existing = None
+            else:
+                # Same target, failed liveness: drop only this forward; the redial below
+                # exec-verifies (or evicts) the shared master and re-proves the serve with its token.
+                existing.ssh.cancel_forward(existing.connected.local_port, existing.connected.remote_port)
+        return _bootstrap(connection, store_root(root), existing)
+
+
+def _bootstrap(connection: dict, root: Path, previous: _Tunnel | None) -> SshTarget:
+    connection_id = str(connection["id"])
+    oid = ownership_id(root, connection_id)
+    ssh = SshConnection(_endpoint(connection, root, oid), ssh_binary=resolve_ssh_binary())
+    ssh.open()
+    reuse_token = previous.connected.token if previous else ""
+    try:
+        connected = connect(ConnectDeps(
+            ssh=ssh, ownership_id=oid, pick_local_port=pick_local_port, wait_for_health=_wait_for_health,
+            probe_reuse_proof=_probe_reuse_proof, profile=str(connection.get("remoteProfile") or ""),
+            remote_hermes_path=str(connection.get("remoteHermesPath") or ""), reuse_token=reuse_token,
+            ready_timeout_s=DEFAULT_READY_TIMEOUT_S))
+    except BaseException:
+        ssh.close()
+        raise
+    tunnel = _Tunnel(ssh, oid, connected, str(connection.get("host") or ""), _fingerprint(connection))
+    _tunnels[connection_id] = tunnel
+    return _target(tunnel)
+
+
+def disconnect(connection_id: str) -> bool:
+    """Cancel the forward, kill the provably-owned remote serve, close the master."""
+    with _connection_lock(connection_id):
+        tunnel = _tunnels.pop(connection_id, None)
+        if tunnel is None:
+            return False
+        _teardown(tunnel)
+        return True
+
+
+def close_all() -> None:
+    for connection_id in list(_tunnels):
+        try:
+            disconnect(connection_id)
+        except SshReachError:
+            continue
+
+
+def tunnel_status(connection_id: str) -> dict | None:
+    tunnel = _tunnels.get(connection_id)
+    if tunnel is None:
+        return None
+    c = tunnel.connected
+    return {"localPort": c.local_port, "remotePort": c.remote_port, "pid": c.pid, "reused": c.reused,
+            "hermesVersion": c.hermes_version, "host": tunnel.host}
