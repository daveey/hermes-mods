+function gateways({ home, peer, elsewhere = {}, routes = [] }: { home?: Handler; peer?: Handler; elsewhere?: Record<string, Handler>; routes?: unknown[] }) {
+  const state = { ended: false, routes }
+  const { create } = strictGroupCreation()
