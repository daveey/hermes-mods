diff --git a/apps/desktop/electron/connection-registry-remove.test.ts b/apps/desktop/electron/connection-registry-remove.test.ts
new file mode 100644
index 00000000000..3d701655512
--- /dev/null
+++ b/apps/desktop/electron/connection-registry-remove.test.ts
@@ -0,0 +1,258 @@
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+import { expect, it, onTestFinished } from 'vitest'
+
+import {
+  type ConnectionRegistry,
+  normalizeRegistry,
+  reconcileAppliedGlobalConnection,
+  reconcileRegistryDrift
+} from './connection-registry'
+import { registerGlobalRoute, removeSavedConnection } from './connection-registry-remove'
+import { writeSecretFileAtomic } from './hardening'
+import { appliedPrimaryWindowRoute } from './window-connection-route'
+
+function fixture(kind: 'cloud' | 'remote' | 'ssh', primary = 'saved-ssh') {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-connection-removal-'))
+  onTestFinished(() => fs.rmSync(root, { recursive: true, force: true }))
+  const configPath = path.join(root, 'connection.json')
+  const registryPath = path.join(root, 'connections.json')
+
+  const remote =
+    kind === 'ssh'
+      ? { mode: 'ssh', host: 'old.example.invalid', user: 'hermes', keyPath: '/offline/old-key' }
+      : { url: 'http://127.0.0.1:9119', authMode: 'oauth' }
+
+  const config = {
+    mode: kind,
+    remote,
+    profiles: {
+      research: { mode: 'remote', url: 'https://research.example.invalid', authMode: 'oauth' },
+      writing: { mode: 'ssh', host: 'writing.example.invalid', user: 'writer' }
+    }
+  }
+
+  const registry = normalizeRegistry({
+    version: 2,
+    primary,
+    launchMode: 'last-used',
+    lastUsed: 'saved-ssh',
+    connections: [
+      { id: 'local', kind: 'local', label: 'This device' },
+      { id: 'old-gateway', kind, label: 'Old gateway', ...remote },
+      { id: 'saved-ssh', kind: 'ssh', label: 'Saved SSH', host: 'saved.example.invalid', user: 'hermes' }
+    ]
+  })
+
+  const writers = {
+    writeConfig: (value: Record<string, any>) => writeSecretFileAtomic(configPath, JSON.stringify(value)),
+    writeRegistry: (value: ConnectionRegistry) => writeSecretFileAtomic(registryPath, JSON.stringify(value))
+  }
+
+  writers.writeConfig(config)
+  writers.writeRegistry(registry)
+
+  return {
+    config,
+    registry,
+    writers,
+    readConfig: () => JSON.parse(fs.readFileSync(configPath, 'utf8')),
+    coldRead: () =>
+      reconcileRegistryDrift(
+        normalizeRegistry(JSON.parse(fs.readFileSync(registryPath, 'utf8'))),
+        JSON.parse(fs.readFileSync(configPath, 'utf8'))
+      )
+  }
+}
+
+it.each(['remote', 'cloud', 'ssh'] as const)(
+  'keeps an explicitly removed legacy %s route absent across cold reads without disabling future Settings drift repair',
+  async kind => {
+    for (const primary of ['saved-ssh', 'old-gateway']) {
+      const state = fixture(kind, primary)
+      await removeSavedConnection('old-gateway', state.registry, state.config, state.writers)
+
+      const restart = state.coldRead()
+      expect(restart.changed).toBe(false)
+      expect(restart.registry.connections.map(connection => connection.id)).toEqual(['local', 'saved-ssh'])
+      expect(restart.registry.primary).toBe(primary === 'old-gateway' ? 'local' : 'saved-ssh')
+      expect(restart.registry.lastUsed).toBe('saved-ssh')
+      expect(restart.registry.launchMode).toBe('last-used')
+      expect(state.readConfig().profiles).toEqual(state.config.profiles)
+      expect(state.readConfig().mode).toBe('local')
+
+      // An explicit later Settings save must still register its route.
+      state.writers.writeConfig(state.config)
+      const reapplied = state.coldRead()
+      expect(reapplied.changed).toBe(true)
+      expect(reapplied.registry.connections).toHaveLength(3)
+    }
+
+    // Removing a different saved connection must not clear the global route.
+    const unrelated = fixture(kind)
+    await removeSavedConnection('saved-ssh', unrelated.registry, unrelated.config, unrelated.writers)
+    expect(unrelated.readConfig()).toEqual(unrelated.config)
+    expect(unrelated.coldRead().changed).toBe(false)
+
+    // A surviving equivalent route still owns the global configuration.
+    const duplicate = fixture(kind)
+    duplicate.registry.connections.push({
+      ...duplicate.registry.connections.find(connection => connection.id === 'old-gateway')!,
+      id: 'equivalent-route',
+      ...(kind === 'ssh'
+        ? { port: 22 }
+        : { kind: kind === 'cloud' ? 'remote' : 'cloud', url: 'http://127.0.0.1:9119/' })
+    })
+    duplicate.writers.writeRegistry(duplicate.registry)
+    await removeSavedConnection('old-gateway', duplicate.registry, duplicate.config, duplicate.writers)
+    expect(duplicate.readConfig()).toEqual(duplicate.config)
+    expect(duplicate.coldRead().changed).toBe(false)
+
+    // Removing another entry must not erase a pre-existing Settings-only route.
+    const drift = fixture(kind)
+    drift.registry.connections = drift.registry.connections.filter(connection => connection.id !== 'old-gateway')
+    drift.writers.writeRegistry(drift.registry)
+    await removeSavedConnection('saved-ssh', drift.registry, drift.config, drift.writers)
+    expect(drift.readConfig()).toEqual(drift.config)
+    expect(drift.coldRead().changed).toBe(true)
+  }
+)
+
+it.each(['config', 'registry'] as const)(
+  'preserves both files and the original error when the %s write fails during legacy-route removal',
+  async failingStore => {
+    const state = fixture('remote')
+    const failure = new Error('injected storage failure')
+    let failed = false
+
+    const write = (store: 'config' | 'registry', value: any) => {
+      if (store === failingStore && !failed) {
+        failed = true
+        throw failure
+      }
+
+      if (store === 'config') {
+        state.writers.writeConfig(value)
+      } else {
+        state.writers.writeRegistry(value)
+      }
+    }
+
+    await expect(
+      removeSavedConnection('old-gateway', state.registry, state.config, {
+        writeConfig: value => write('config', value),
+        writeRegistry: value => write('registry', value)
+      })
+    ).rejects.toBe(failure)
+    expect(state.readConfig()).toEqual(state.config)
+    expect(state.coldRead()).toEqual({ changed: false, registry: state.registry })
+  }
+)
+
+it('does not overwrite a subsequent registry edit while removal finishes', async () => {
+  const state = fixture('remote')
+  const removing = removeSavedConnection('old-gateway', state.registry, state.config, state.writers)
+  const edited = state.coldRead().registry
+  edited.connections.push({ id: 'new-ssh', kind: 'ssh', label: 'New SSH', host: 'new.example.invalid' })
+  state.writers.writeRegistry(edited)
+  await removing
+
+  expect(state.coldRead().registry.connections.map(connection => connection.id)).toEqual([
+    'local',
+    'saved-ssh',
+    'new-ssh'
+  ])
+})
+
+it('applying another remote profile on a saved SSH host adds it and leaves the saved profile alone', () => {
+  const registry = normalizeRegistry({
+    version: 2,
+    primary: 'coder',
+    launchMode: 'last-used',
+    lastUsed: 'coder',
+    connections: [
+      { id: 'local', kind: 'local', label: 'This device' },
+      {
+        id: 'coder',
+        kind: 'ssh',
+        label: 'Box (coder)',
+        host: 'box.example.invalid',
+        user: 'hermes',
+        remoteProfile: 'coder'
+      }
+    ]
+  })
+
+  const next = registerGlobalRoute(registry, {
+    mode: 'ssh',
+    remote: { host: 'box.example.invalid', user: 'hermes', remoteProfile: 'writer' }
+  })
+
+  const ssh = next.connections.filter(c => c.kind === 'ssh')
+  expect(ssh.find(c => c.id === 'coder')?.remoteProfile).toBe('coder')
+  expect(ssh.map(c => c.remoteProfile).sort()).toEqual(['coder', 'writer'])
+  expect(next.connections.find(c => c.id === next.primary)?.remoteProfile).toBe('writer')
+})
+
+it('saving a corrected key or Hermes path updates the matching SSH entry in place, set or cleared', () => {
+  const registry = normalizeRegistry({
+    version: 2,
+    primary: 'coder',
+    launchMode: 'last-used',
+    lastUsed: 'coder',
+    connections: [
+      { id: 'local', kind: 'local', label: 'This device' },
+      {
+        id: 'coder',
+        kind: 'ssh',
+        label: 'Box (coder)',
+        host: 'box.example.invalid',
+        user: 'hermes',
+        remoteProfile: 'coder',
+        keyPath: '/old/key',
+        remoteHermesPath: '/old/hermes'
+      }
+    ]
+  })
+
+  const route = { host: 'box.example.invalid', user: 'hermes', remoteProfile: 'coder' }
+
+  const fixed = registerGlobalRoute(registry, {
+    mode: 'ssh',
+    remote: { ...route, keyPath: '/new/key', remoteHermesPath: '/new/hermes' }
+  })
+
+  const entry = fixed.connections.find(c => c.id === 'coder')
+  expect(fixed.connections.filter(c => c.kind === 'ssh')).toHaveLength(1)
+  expect([entry?.label, entry?.keyPath, entry?.remoteHermesPath]).toEqual(['Box (coder)', '/new/key', '/new/hermes'])
+
+  const cleared = registerGlobalRoute(fixed, { mode: 'ssh', remote: route }).connections.find(c => c.id === 'coder')
+  expect([cleared?.keyPath, cleared?.remoteHermesPath]).toEqual([undefined, undefined])
+})
+
+it('Apply routes the window to each applied SSH profile, back to one already saved; Save never re-picks', () => {
+  let registry = normalizeRegistry({ connections: [{ id: 'local', kind: 'local', label: 'This device' }] })
+  const route = (remoteProfile: string) => ({
+    mode: 'ssh',
+    remote: { host: 'box.example.invalid', user: 'hermes', remoteProfile }
+  })
+
+  const routedProfile = (r: ConnectionRegistry) => {
+    const { connectionId } = appliedPrimaryWindowRoute(r, 'default')
+
+    return r.connections.find(c => c.id === connectionId)?.remoteProfile
+  }
+
+  // The connection-config:apply handler's registry step, then the window route it records.
+  for (const profile of ['coder', 'writer', 'coder']) {
+    const config = route(profile)
+    registry = registerGlobalRoute(reconcileAppliedGlobalConnection(registry, config), config, { select: true })
+    expect(routedProfile(registry)).toBe(profile)
+    expect(registry.lastUsed).toBe(registry.primary)
+  }
+
+  // Save (no select) of the saved writer route persists it without moving the primary off coder.
+  expect(routedProfile(registerGlobalRoute(registry, route('writer')))).toBe('coder')
+})
diff --git a/apps/desktop/electron/connection-registry-remove.ts b/apps/desktop/electron/connection-registry-remove.ts
new file mode 100644
index 00000000000..cd389425b97
--- /dev/null
+++ b/apps/desktop/electron/connection-registry-remove.ts
@@ -0,0 +1,171 @@
+import { modeIsRemoteLike, normalizeRemoteBaseUrl, normalizeSshConfig } from './connection-config'
+import { applyConnectionConfigAtomically } from './connection-config-apply'
+import {
+  type ConnectionRegistry,
+  normalizeConnectionInput,
+  reconcileRegistryDrift,
+  removeConnection,
+  uniqueLabel,
+  upsertConnection
+} from './connection-registry'
+
+interface ConnectionRemovalWriters {
+  writeConfig: (config: Record<string, any>) => void
+  writeRegistry: (registry: ConnectionRegistry) => void
+}
+
+/** connection.json with its app-global route reset to local (per-profile overrides kept). */
+export const withoutGlobalRoute = (config: Record<string, any>) => ({ ...config, mode: 'local', remote: {} })
+
+/** user@host:port::remoteProfile of an SSH route, or null when it names no host. */
+function sshRouteKey(route: Record<string, any>): null | string {
+  const ssh = normalizeSshConfig({ ...route, mode: 'ssh' })
+
+  return ssh
+    ? `${(ssh.user || '').trim().toLowerCase()}@${ssh.host.trim().toLowerCase()}:${ssh.port || 22}::${ssh.remoteProfile || ''}`
+    : null
+}
+
+const urlKey = (url: unknown): string => {
+  try {
+    return normalizeRemoteBaseUrl(url)
+  } catch {
+    return ''
+  }
+}
+
+/**
+ * True when connection.json's app-global route names a gateway the saved list no
+ * longer holds (same URL; same SSH user, host, port and remote profile). The list
+ * is the authority once it exists: such a route was removed (here or by the
+ * Webapp), so it must be dropped, never re-added.
+ */
+export function globalRouteRemoved(registry: ConnectionRegistry, config: Record<string, any>): boolean {
+  const remote = config?.remote && typeof config.remote === 'object' ? config.remote : {}
+
+  if (config?.mode === 'ssh') {
+    const key = sshRouteKey(remote)
+
+    return Boolean(key) && !registry.connections.some(c => c.kind === 'ssh' && sshRouteKey(c) === key)
+  }
+
+  const url = modeIsRemoteLike(config?.mode) ? urlKey(remote.url) : ''
+
+  return (
+    Boolean(url) &&
+    !registry.connections.some(c => (c.kind === 'remote' || c.kind === 'cloud') && urlKey(c.url) === url)
+  )
+}
+
+/**
+ * The list with connection.json's app-global route registered (Settings save / apply).
+ *
+ * An explicit save/apply is the user naming a route, so an SSH route joins the list
+ * unless an entry with the same user, host, port AND remote profile exists. The
+ * migration repair (reconcileRegistryDrift) instead realigns a same-host entry, which
+ * here would overwrite another saved profile on that host.
+ *
+ * A route new to the list becomes primary either way (what the read-time repair did
+ * for an unregistered route before this list was the authority). `select` is Apply:
+ * the window is routed to the list's primary, so a route that matches an existing
+ * entry must become primary too, or Apply coder -> writer -> coder stays on writer.
+ * Save omits it: Save is persistence-only and leaves a registered route's primary as is.
+ */
+export function registerGlobalRoute(
+  registry: ConnectionRegistry,
+  config: Record<string, any>,
+  { select = false }: { select?: boolean } = {}
+): ConnectionRegistry {
+  if (config?.mode !== 'ssh') {
+    return reconcileRegistryDrift(registry, config).registry
+  }
+
+  const route = config.remote && typeof config.remote === 'object' ? config.remote : {}
+  const key = sshRouteKey(route)
+
+  if (!key) {
+    return registry
+  }
+
+  const ssh = normalizeSshConfig({ ...route, mode: 'ssh' })!
+  const { mode: _mode, ...sshFields } = ssh
+  const existing = registry.connections.find(c => c.kind === 'ssh' && sshRouteKey(c) === key)
+
+  if (existing) {
+    // Same gateway (user, host, port, profile): carry a corrected key or Hermes path onto it.
+    const aligned = { ...existing }
+    delete aligned.keyPath
+    delete aligned.remoteHermesPath
+    const { host: _host, user: _user, port: _port, remoteProfile: _profile, ...paths } = sshFields
+    Object.assign(aligned, paths)
+    const next = upsertConnection(registry, aligned)
+
+    return select ? { ...next, primary: aligned.id, lastUsed: aligned.id } : next
+  }
+
+  const label = uniqueLabel(
+    ssh.remoteProfile ? `${ssh.host} (${ssh.remoteProfile})` : ssh.host,
+    registry.connections.map(c => c.label)
+  )
+
+  try {
+    const entry = normalizeConnectionInput({ kind: 'ssh', label, ...sshFields }, registry)
+
+    return { ...upsertConnection(registry, entry), primary: entry.id, lastUsed: entry.id }
+  } catch {
+    // Not a route we can register; the apply keeps failing the way it already does.
+    return registry
+  }
+}
+
+interface GlobalRouteIo {
+  readConfig: () => Record<string, any>
+  writeConfig: (config: Record<string, any>) => void
+  log?: (message: string) => void
+}
+
+/**
+ * Reset connection.json's app-global route when the saved list no longer holds it:
+ * removed by the Webapp, or by a build that left the route behind. Without this the
+ * removed gateway keeps winning the primary boot route over the list's primary.
+ */
+export function forgetRemovedGlobalRoute(registry: ConnectionRegistry, io: GlobalRouteIo): boolean {
+  const config = io.readConfig()
+
+  if (!globalRouteRemoved(registry, config)) {
+    return false
+  }
+
+  io.writeConfig(withoutGlobalRoute(config))
+  io.log?.('[connections] connection.json named a gateway no longer in the saved list; its route was reset to local')
+
+  return true
+}
+
+/** Persist the saved-connection removal before tearing down its live resources. */
+export async function removeSavedConnection(
+  id: string,
+  registry: ConnectionRegistry,
+  config: Record<string, any>,
+  writers: ConnectionRemovalWriters
+): Promise<ConnectionRegistry> {
+  const nextRegistry = removeConnection(registry, id)
+
+  // Use the reader's identity policy: clear only a global legacy route that
+  // this deletion would cause it to re-import. An unrelated removal, a route
+  // still represented by another entry, and pre-existing drift stay untouched.
+  if (!globalRouteRemoved(registry, config) && globalRouteRemoved(nextRegistry, config)) {
+    await applyConnectionConfigAtomically({
+      previousConfig: config,
+      previousRegistry: registry,
+      nextConfig: withoutGlobalRoute(config),
+      nextRegistry,
+      ...writers,
+      apply: async () => undefined
+    })
+  } else {
+    writers.writeRegistry(nextRegistry)
+  }
+
+  return nextRegistry
+}
