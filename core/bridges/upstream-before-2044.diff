+  if (!secret || typeof secret !== 'object') {
+    return ''
+  }
+
+  if (secret.encoding !== 'safeStorage') {
+    return String(secret.value || '')
+  }
+
+  const value = Buffer.from(String(secret.value || ''), 'base64').toString('utf8')
+
+  return value.startsWith('enc:') ? value.slice(4) : ''
