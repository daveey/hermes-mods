index 00000000000..c4a00bd9b79
--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/group-new-name-gateway.test.tsx
@@ -0,0 +1,139 @@
+/**
+ * A name with no room record is a new group chat, and every new group chat runs on a gateway:
+ * Manage groups' Create & join goes through New group chat's gateway create, and the workspace
+ * never opens such a name Desktop-driven (nor saves `engine: 'desktop'` on an edit), whether the
+ * gateway is current or too old to run group chats.
+ */
+
+import type * as HermesSdk from '@hermes/plugin-sdk'
+import { act, cleanup, fireEvent, render, screen, waitFor, within } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+import { $canonicalGroupBindings } from './canonical-group-registry'
+import { GroupDialog } from './create-dialog'
+import { CROSS_GATEWAY_GROUP_LOCALES } from './cross-gateway-locales'
+import { $botMeta, $lastRoster } from './data'
+import { $groupChats, $groupChatWorkspace } from './group-chat'
+import type * as GroupChatModule from './group-chat'
+import type * as GroupChatParts from './group-chat-parts'
+import { GroupChatWorkspace } from './group-chat-view'
+import { translateBots } from './i18n-test-helper'
+import type { RosterRow } from './types'
+import { moveGroupChatsToSection } from './user-sections'
+
+const { request, notify, openWorkspace } = vi.hoisted(() => ({ request: vi.fn(), notify: vi.fn(), openWorkspace: vi.fn() }))
+vi.mock('@hermes/plugin-sdk', async importOriginal => {
+  const sdk = await importOriginal<typeof HermesSdk>()
+  const { en } = await import('@/i18n/en')
+
+  return {
+    ...sdk,
+    gatewayActivationEpoch: () => 1,
+    useGatewayActivationEpoch: () => 1,
+    host: {
+      ...sdk.host, requestProfile: request, notify, openWorkspace,
+      request: (method: string, params?: Record<string, unknown>) => request(null, method, params),
+      connections: vi.fn(async () => []),
+      state: { ...sdk.host.state, connectionId: sdk.atom<string | null>('local'), profile: sdk.atom('default'), gateway: sdk.atom('open') }
+    },
+    useI18n: () => ({ locale: 'en', t: en }),
+    usePluginI18n: () => translateBots
+  }
+})
+vi.mock('./group-chat', async importOriginal => {
+  const actual = await importOriginal<typeof GroupChatModule>()
+
+  return { ...actual, updateGroupChat: vi.fn((group, mutate) => actual.updateGroupChat(group, mutate, { sync: false })) }
+})
+vi.mock('./group-chat-parts', async importOriginal => ({ ...await importOriginal<typeof GroupChatParts>(), GroupImageControls: () => null }))
+
+const alpha: RosterRow = { name: 'alpha', connectionId: 'local', connectionLabel: 'This device' }
+const beta: RosterRow = { name: 'beta', connectionId: 'local', connectionLabel: 'This device' }
+const remote: RosterRow = { name: 'scout', connectionId: 'other-box', connectionLabel: 'Other box', remoteSource: true }
+
+function gateway(capabilities: unknown) {
+  request.mockReset().mockImplementation(async (_route, method, params) => {
+    if (method === 'groups.capabilities') {return capabilities}
+
+    if (method === 'groups.list') {return { rooms: [], next_offset: null }}
+
+    if (method === 'groups.create') {return { room: { room_id: params.room_id, name: params.name, members: params.members } }}
+
+    return {}
+  })
+}
+
+beforeEach(() => {
+  gateway({ driver: true, persistent_process: true, seatable_profiles: ['alpha', 'beta'] })
+  $canonicalGroupBindings.set({})
+  $groupChats.set({})
+  $groupChatWorkspace.set(null)
+  $botMeta.set({})
+  $lastRoster.set([alpha, beta, remote])
+  notify.mockReset()
+  openWorkspace.mockReset().mockReturnValue(() => undefined)
+  Element.prototype.scrollIntoView = vi.fn()
+})
+afterEach(() => {
+  cleanup()
+  $groupChats.set({})
+  localStorage.clear()
+})
+
+const desktopRecords = () => Object.values($groupChats.get()).filter(room => room.engine === 'desktop')
+
+it('Create & join from a bot\'s Manage groups makes a gateway-run group chat, never a Desktop-run one', async () => {
+  const onCreated = vi.fn()
+  render(<GroupDialog bot={alpha} onClose={vi.fn()} onCreated={onCreated} />)
+  fireEvent.change(screen.getByRole('textbox'), { target: { value: 'Research' } })
+  await act(async () => { fireEvent.click(screen.getByRole('button', { name: 'Create & join' })) })
+
+  // New group chat opens with this bot picked and the name filled in; the person adds the others.
+  const dialog = await screen.findByRole('dialog', { name: 'New group chat' })
+  expect((within(dialog).getByRole('textbox', { name: 'Group name' }) as HTMLInputElement).value).toBe('Research')
+  await waitFor(() => expect(dialog.querySelector('[data-bot-face="beta"]')).not.toBeNull())
+  fireEvent.click(dialog.querySelector('[data-bot-face="beta"]')!.closest('label')!.querySelector('[role="checkbox"]')!)
+  const create = within(dialog).getByRole('button', { name: 'Create group (2)' }) as HTMLButtonElement
+  await waitFor(() => expect(create.disabled).toBe(false))
+  await act(async () => { fireEvent.click(create) })
+
+  await waitFor(() => expect(onCreated).toHaveBeenCalledOnce())
+  const created = request.mock.calls.filter(call => call[1] === 'groups.create')
+  expect(created).toHaveLength(1)
+  expect(created[0][2]).toMatchObject({ name: 'Research', members: [{ profile: 'alpha' }, { profile: 'beta' }] })
+  expect($groupChats.get().Research.engine).toMatchObject({ kind: 'gateway', connectionId: 'local' })
+  expect(desktopRecords()).toEqual([])
+})
+
+it('a name with no room record never opens Desktop-run, even when its bots span computers', async () => {
+  // A group known only from Bots' memberships (what Create & join used to leave behind).
+  await act(async () => { render(<GroupChatWorkspace group="Research" members={[alpha, remote]} />) })
+
+  await waitFor(() => expect(request.mock.calls.map(call => call[1])).toContain('groups.list'))
+  expect(screen.queryByRole('textbox', { name: 'Message Research' })).toBeNull()
+  expect(desktopRecords()).toEqual([])
+})
+
+it('a new name on a gateway too old to run group chats says to update it, as New group chat does', async () => {
+  gateway({ driver: false, persistent_process: false })
+  await act(async () => { render(<GroupChatWorkspace group="Research" members={[alpha, beta]} />) })
+
+  expect(await screen.findByText(CROSS_GATEWAY_GROUP_LOCALES.en.ownerUpdateRequired('This device'))).toBeTruthy()
+  expect(screen.getByRole('button', { name: 'Retry' })).toBeTruthy()
+  expect(screen.queryByRole('textbox')).toBeNull()
+  expect($groupChats.get()).toEqual({})
+})
+
+it.each(['section', 'order'])('a membership-only name filed by a layout write (%s) still never opens Desktop-run', async write => {
+  // Filing a group into a section or reordering it writes an empty record for the name.
+  if (write === 'section') {moveGroupChatsToSection(['Research'], 'work')} else {
+    $groupChats.set({ Research: { log: [], watermarks: {}, epoch: 0, running: false, rosterOrder: 0 } })
+  }
+
+  expect($groupChats.get().Research).toBeTruthy()
+  await act(async () => { render(<GroupChatWorkspace group="Research" members={[alpha, remote]} />) })
+
+  await waitFor(() => expect(request.mock.calls.map(call => call[1])).toContain('groups.list'))
+  expect(screen.queryByRole('textbox', { name: 'Message Research' })).toBeNull()
+  expect(desktopRecords()).toEqual([])
+})
diff --git a/apps/desktop/src/plugins/hermes-bots/group-reason-copy.test.tsx b/apps/desktop/src/plugins/hermes-bots/group-reason-copy.test.tsx
new file mode 100644
index 00000000000..ec91abfdc47
--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/group-reason-copy.test.tsx
@@ -0,0 +1,116 @@
+import { cleanup, render } from '@testing-library/react'
+import type { ReactNode } from 'react'
+import { afterEach, expect, it, vi } from 'vitest'
+
+const selection = vi.hoisted(() => ({ locale: 'en' }))
+vi.mock('@hermes/plugin-sdk', async () => ({
+  ...await (await import('./group-test-utils')).pluginSdkMock({}),
+  Tip: ({ children, label }: { children: ReactNode; label: string }) => <div title={label}>{children}</div>
+}))
+vi.mock('./canonical-group-labels', async () => {
+  const { CANONICAL_GROUP_LOCALES } = await import('./canonical-group-locales')
+
+  return { useCanonicalGroupLabels: () => CANONICAL_GROUP_LOCALES[selection.locale as keyof typeof CANONICAL_GROUP_LOCALES] }
+})
+
+import { CanonicalGroupHistory } from './canonical-group-history'
+import { CANONICAL_GROUP_LOCALES } from './canonical-group-locales'
+import { groupActivityLabel } from './group-activity'
+import { memberOutcomes, memberStatus } from './group-room-status'
+import { fill, MemberStatusChip, memberStatusText } from './group-room-ui'
+import { translateBotsIn } from './i18n-test-helper'
+import { setPluginCtx } from './shared'
+
+afterEach(() => { cleanup(); setPluginCtx(null) })
+const binding = { connectionId: 'local', profile: 'team', roomId: 'copy' }
+
+const knownReasons = [
+  'runtime_offline', 'queued_expired', 'delivery_timeout', 'agent_blocked', 'cancelled',
+  'provider_auth_or_access', 'provider_quota_limit', 'provider_rate_limit', 'provider_server_error',
+  'context_overflow', 'missing_config', 'model_unavailable', 'target_scope_unresolved',
+  'prepare_failed', 'slot_wait_timeout', 'target_busy', 'rate_limited', 'member gateway restarted'
+]
+
+it.each([
+  ["en", "The bot is unavailable", "A newer message replaced this turn", "The turn exceeded its time limit"],
+  ["ja", "ボットを利用できません", "新しいメッセージがこのターンに代わりました", "ターンの制限時間を超えました"],
+  ["zh", "机器人不可用", "新消息取代了此回合", "回合超出了时间限制"],
+  ["zh-hant", "機器人無法使用", "新訊息取代了此回合", "回合超出了時間限制"],
+  ["ar", "الروبوت غير متاح", "حلّت رسالة أحدث محل هذا الدور", "تجاوز الدور المهلة المحددة"],
+  ["ru", "Бот недоступен", "Более новое сообщение заменило этот ход", "Ход превысил лимит времени"],
+  ["fr", "Le bot est indisponible", "Un message plus récent a remplacé ce tour", "Le tour a dépassé le délai autorisé"],
+  ["de", "Der Bot ist nicht verfügbar", "Eine neuere Nachricht hat diesen Durchgang ersetzt", "Der Durchgang hat das Zeitlimit überschritten"],
+  ["es", "El bot no está disponible", "Un mensaje más reciente sustituyó este turno", "El turno superó el límite de tiempo"],
+])('renders known reasons and hides unknown codes in %s', (locale, unavailable, superseded, deadline) => {
+  selection.locale = locale
+  setPluginCtx({ i18n: { t: translateBotsIn(locale) } } as never)
+  const labels = CANONICAL_GROUP_LOCALES[locale as keyof typeof CANONICAL_GROUP_LOCALES]
+
+  const cases = [
+    ['member_unavailable', unavailable], ['superseded_by_newer_user_event', superseded], ['turn_deadline_exceeded', deadline],
+    ['unknown', ''], ['future_reason', ''], ['future.reason:v2', ''], ['Provider timed out', 'Provider timed out']
+  ]
+
+  for (const [reason, text] of cases) {
+    const events = [
+      { seq: 1, kind: 'turn.deferred', payload: { reason } },
+      { seq: 2, kind: 'turn.failed', payload: { error: reason } },
+      { seq: 3, kind: 'turn.failed', payload: { reason_code: reason } },
+      { seq: 4, kind: 'turn.cancelled', payload: { reason } }
+    ]
+
+    const view = render(<CanonicalGroupHistory binding={binding} events={events} />)
+    // A member that did not answer in time reads as that in the log; its status chip keeps the reason.
+    const logged = reason === 'member_unavailable' ? labels.turnNoAnswer : text
+    expect([...view.container.querySelectorAll('[data-room-notice] p')].map(node => node.textContent)).toEqual(
+      [labels.turnDeferred, labels.turnFailed, labels.turnFailed, labels.turnCancelled].map(word => word + (logged ? ': ' + logged : '')))
+    view.unmount()
+
+    const activity = groupActivityLabel({ at: 1, epoch: 0, kind: 'failed', member: 'Helper', reason })
+    expect(activity).toBe('Helper ' + translateBotsIn(locale)('group.activityFailed') + (text ? ' — ' + text : ''))
+  }
+
+  // Exercise the durable outcome -> status -> chip path, including unknown classification with useful error text.
+  for (const [reason, error, expected] of [
+    ['member_unavailable', '', unavailable], ['unknown', '', ''], ['unknown', 'Provider timed out', 'Provider timed out'],
+    ['future_reason', 'unknown', '']
+  ]) {
+    const events = [
+      { seq: 1, event_id: 'discussion', kind: 'message.user', payload: {} },
+      { seq: 2, kind: 'turn.failed', payload: { member_id: 'helper', discussion_event_id: 'discussion', reason_code: reason, error } }
+    ]
+
+    const status = memberStatus('helper', [], memberOutcomes(events), 1)
+    const text = labels.statusFailed + (expected ? ' · ' + expected : '')
+    expect(memberStatusText(status, labels)).toBe(text)
+    const view = render(<MemberStatusChip avatar={null} labels={labels} name="Helper" status={status} />)
+    expect(view.container.textContent).toBe('Helper·' + text)
+    expect(view.container.querySelector('[title]')?.getAttribute('title')).not.toMatch(/unknown|future_reason|member_unavailable/)
+    view.unmount()
+  }
+
+  for (const reason of knownReasons) {
+    const text = memberStatusText({ kind: 'failed', reason }, labels)
+    expect(text).toContain(labels.statusFailed + ' · ')
+    expect(text).not.toBe(labels.statusFailed + ' · ' + reason)
+
+    if (locale !== 'en') {
+      expect(text.slice(labels.statusFailed.length)).not.toBe(
+        memberStatusText({ kind: 'failed', reason }, CANONICAL_GROUP_LOCALES.en).slice(CANONICAL_GROUP_LOCALES.en.statusFailed.length))
+    }
+  }
+})
+
+it.each([
+  ["en", "{name}’s turn has not finished. Retry it?"],
+  ["ja", "{name} のターンはまだ完了していません。再試行しますか？"],
+  ["zh", "{name} 的回合尚未完成。要重试吗？"],
+  ["zh-hant", "{name} 的回合尚未完成。要重試嗎？"],
+  ["ar", "لم ينتهِ دور {name} بعد. هل تعيد المحاولة؟"],
+  ["ru", "Ход {name} ещё не завершён. Повторить?"],
+  ["fr", "Le tour de {name} n’est pas terminé. Réessayer ?"],
+  ["de", "Der Turn von {name} ist noch nicht abgeschlossen. Erneut versuchen?"],
+  ["es", "El turno de {name} no ha terminado. ¿Reintentar?"],
+])('asks to retry a turn that has not finished, wherever it ran, in %s', (locale, template) => {
+  expect(fill(CANONICAL_GROUP_LOCALES[locale as keyof typeof CANONICAL_GROUP_LOCALES].pendingRetry, { name: 'Helper' })).toBe(template.replace('{name}', 'Helper'))
+})
