+type RelayWindow = Window & {
+  __HERMES_AUTH_REQUIRED__?: boolean
+  __HERMES_BASE_PATH__?: string
+  __HERMES_UI_SURFACE__?: string
+  hermesDesktop?: Window['hermesDesktop']
+}
