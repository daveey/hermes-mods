+    }
+  }
+
+  function watch(handlers: { onRegistry: RegistryChangeHandler; onTokens: () => void }) {
+    // No read here: main registers this at load, before safeStorage may be used.
+    const onRegistryStat = () => {
+      const before = announced
+      const after = read()
