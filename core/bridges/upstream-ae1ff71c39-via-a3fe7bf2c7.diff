diff --git a/tests/tools/test_mcp_oauth_callback_preconnect.py b/tests/tools/test_mcp_oauth_callback_preconnect.py
new file mode 100644
index 0000000000..d1f47903be
--- /dev/null
+++ b/tests/tools/test_mcp_oauth_callback_preconnect.py
@@ -0,0 +1,161 @@
+"""An idle browser preconnect must not hold the authorization code past its lifetime.
+
+Chrome opens a second, speculative connection to the loopback callback alongside the one that
+carries ``GET /callback?code=...`` and leaves it idle for about a minute. The single-threaded
+callback server accepted that socket after serving the callback and blocked reading a request line
+that never came; the waiter's ``server.shutdown()`` then waited on that serve loop, so the code reached
+the token endpoint ~60 s after the redirect. Authorization servers with a 60 s code lifetime
+answered ``invalid_grant: Invalid or expired authorization code``. The listener now serves each
+connection on its own thread, so neither an idle socket nor a slow client holds up another.
+"""
+import asyncio
+import io
+import socket
+import threading
+import time
+from contextlib import contextmanager
+from http.client import HTTPConnection
+
+import pytest
+
+pytest.importorskip("mcp.client.auth.oauth2", reason="MCP SDK 1.26.0+ required")
+
+import tools.mcp_oauth as mo
+
+
+@contextmanager
+def _running_waiter(monkeypatch, timeout=10, hold_cleanup=None):
+    """Run the production waiter on its own loop thread; yields ``(server, out)`` once it is listening.
+
+    ``out`` gets ``result`` or ``error`` and ``returned_at``. Port 0: the OS picks a free port.
+    ``hold_cleanup``: an Event the listener's real ``shutdown()`` waits for, so a test can connect after
+    the callback without racing the listener closing."""
+    monkeypatch.setattr(mo.sys, "stdin", io.StringIO())  # paste reader sees EOF; the HTTP listener is under test
+    started, done, servers, out = threading.Event(), threading.Event(), [], {}
+    original_start = mo._start_callback_server
+
+    def recording_start(port, handler_cls):
+        server = original_start(port, handler_cls)
+        if hold_cleanup is not None:
+            real_shutdown = server.shutdown
+
+            def held_shutdown():
+                hold_cleanup.wait(5)
+                real_shutdown()
+
+            server.shutdown = held_shutdown
+        servers.append(server)
+        started.set()
+        return server
+
+    monkeypatch.setattr(mo, "_start_callback_server", recording_start)
+
+    def run():
+        async def main():
+            with mo.force_interactive_oauth():
+                return await mo._make_callback_waiter(0, timeout=timeout)()
+        try:
+            out["result"] = asyncio.run(main())
+        except Exception as exc:
+            out["error"] = exc
+        out["returned_at"] = time.monotonic()
+        done.set()
+
+    threading.Thread(target=run, daemon=True).start()
+    assert started.wait(5), "callback listener never bound"
+    try:
+        yield servers[0], out
+    finally:
+        assert done.wait(timeout + 5), "waiter never returned"
+
+
+def _raw_get(sock: socket.socket, query: str) -> bytes:
+    sock.sendall(f"GET /callback?{query} HTTP/1.0\r\nHost: localhost\r\n\r\n".encode())
+    chunks = []
+    while chunk := sock.recv(8192):
+        chunks.append(chunk)
+    return b"".join(chunks)
+
+
+@pytest.mark.parametrize("preconnect_first", [True, False])
+def test_idle_preconnect_does_not_delay_the_code(monkeypatch, preconnect_first):
+    opened = []  # every socket the test opens, closed whatever fails
+    preconnected = threading.Event()  # cleanup waits for it, so the late preconnect never meets a closed port
+    try:
+        with _running_waiter(monkeypatch, hold_cleanup=preconnected) as (server, out):
+            def preconnect():  # the browser's speculative socket: connects, sends nothing, stays open
+                opened.append(socket.create_connection(server.server_address, timeout=5))
+                preconnected.set()
+
+            if preconnect_first:
+                preconnect()  # the accept queue is FIFO: the server takes this socket ahead of the real request
+            sent_at = time.monotonic()
+            conn = HTTPConnection(*server.server_address, timeout=5)
+            opened.append(conn)
+            conn.request("GET", "/callback?code=abc&state=xyz")
+            assert conn.getresponse().status == 200
+            if not preconnect_first:
+                preconnect()  # accepted right after the callback was served
+        assert out["result"].code == "abc"
+        assert out["returned_at"] - sent_at < 5  # far inside a 60 s code lifetime
+    finally:
+        preconnected.set()
+        for sock in opened:
+            sock.close()
+
+
+def test_queued_idle_preconnects_do_not_delay_the_redirect(monkeypatch):
+    """Two silent sockets accepted ahead of the redirect: a per-socket read timeout cost 2 s each in turn."""
+    opened = []  # every socket the test opens, closed whatever fails
+    try:
+        with _running_waiter(monkeypatch) as (server, out):
+            opened += [socket.create_connection(server.server_address, timeout=5) for _ in range(2)]
+            sent_at = time.monotonic()
+            conn = HTTPConnection(*server.server_address, timeout=10)
+            opened.append(conn)
+            conn.request("GET", "/callback?code=abc&state=xyz")
+            assert conn.getresponse().status == 200
+            answered = time.monotonic() - sent_at
+        assert out["result"].code == "abc"
+        assert answered < 3.0, f"redirect answered after {answered:.2f}s behind idle preconnects"
+        assert out["returned_at"] - sent_at < 3.0  # two idle preconnects cost ~4 s on a serial listener
+    finally:
+        for sock in opened:
+            sock.close()
+
+
+def test_slow_client_still_delivers_the_code(monkeypatch):
+    """A client that sends its request line after 2.5 s (an SSH-tunnelled callback) is served, not dropped."""
+    with _running_waiter(monkeypatch) as (server, out):
+        with socket.create_connection(server.server_address, timeout=10) as sock:
+            time.sleep(2.5)  # health: allow HX013 -- the late request line IS the behaviour under test
+            reply = _raw_get(sock, "code=slow&state=s1")
+    assert reply.startswith(b"HTTP/1.0 200"), reply[:80]
+    assert (out["result"].code, out["result"].state) == ("slow", "s1")
+
+
+def test_concurrent_callbacks_one_consistent_winner(monkeypatch):
+    """Two valid callbacks in flight at once: exactly one wins, and its code and state stay together."""
+    both_in_handler = threading.Barrier(2, timeout=5)
+    real_parse = mo._parse_redirect_query
+
+    def rendezvous_parse(query):
+        both_in_handler.wait()  # a serial server never has two handlers running: it breaks here
+        return real_parse(query)
+
+    monkeypatch.setattr(mo, "_parse_redirect_query", rendezvous_parse)
+    replies = {}
+    with _running_waiter(monkeypatch) as (server, out):
+        def send(code):
+            with socket.create_connection(server.server_address, timeout=10) as sock:
+                replies[code] = _raw_get(sock, f"code={code}&state=state-{code}")
+
+        senders = [threading.Thread(target=send, args=(code,)) for code in ("one", "two")]
+        for sender in senders:
+            sender.start()
+        for sender in senders:
+            sender.join(15)
+    winners = [code for code, reply in replies.items() if b"Authorization Successful" in reply]
+    losers = [code for code, reply in replies.items() if b"Authorization already received" in reply]
+    assert len(winners) == 1 and len(losers) == 1, replies
+    assert (out["result"].code, out["result"].state) == (winners[0], f"state-{winners[0]}")
diff --git a/tests/tools/test_mcp_oauth_callback_shutdown.py b/tests/tools/test_mcp_oauth_callback_shutdown.py
new file mode 100644
index 0000000000..78325035d2
--- /dev/null
+++ b/tests/tools/test_mcp_oauth_callback_shutdown.py
@@ -0,0 +1,229 @@
+"""An idle OAuth callback connection must not freeze the MCP event loop (#149771).
+
+Listener cleanup (shutdown, then server_close) runs on a worker thread. Hold real listener
+cleanup open to prove unrelated loop work can proceed, and that a cancellation during
+cleanup still releases the port.
+"""
+import asyncio
+import io
+import socket
+import threading
+from concurrent.futures import ThreadPoolExecutor
+from http.client import HTTPConnection
+
+import pytest
+
+pytest.importorskip("mcp.client.auth.oauth2", reason="MCP SDK 1.26.0+ required")
+
+import tools.mcp_oauth as oauth
+
+
+def _free_port() -> int:
+    with socket.socket() as sock:
+        sock.bind(("127.0.0.1", 0))
+        return sock.getsockname()[1]
+
+
+def test_callback_shutdown_does_not_block_mcp_event_loop(monkeypatch):
+    monkeypatch.setattr(oauth.sys, "stdin", io.StringIO())
+    port = _free_port()
+    listening = threading.Event()
+    shutdown_entered = threading.Event()
+    loop_pulsed = threading.Event()
+    release_shutdown = threading.Event()
+    loop_ref = {}
+    outcome = {}
+    original_start = oauth._start_callback_server
+
+    def instrumented_start(callback_port, handler):
+        server = original_start(callback_port, handler)
+        original_shutdown = server.shutdown
+
+        def delayed_shutdown():
+            shutdown_entered.set()
+            # This callback cannot run while shutdown() monopolizes the loop.
+            loop_ref["loop"].call_soon_threadsafe(loop_pulsed.set)
+            assert release_shutdown.wait(8), "test failed to release shutdown"
+            original_shutdown()
+
+        server.shutdown = delayed_shutdown
+        listening.set()
+        return server
+
+    monkeypatch.setattr(oauth, "_start_callback_server", instrumented_start)
+
+    def run_waiter():
+        async def run():
+            loop_ref["loop"] = asyncio.get_running_loop()
+            with oauth.force_interactive_oauth():
+                return await oauth._make_callback_waiter(port, timeout=10)()
+
+        try:
+            outcome["result"] = asyncio.run(run())
+        except Exception as exc:
+            outcome["error"] = exc
+
+    worker = threading.Thread(target=run_waiter, daemon=True)
+    worker.start()
+    try:
+        assert listening.wait(5), "OAuth callback server never bound"
+        conn = HTTPConnection("127.0.0.1", port, timeout=5)
+        try:
+            conn.request("GET", "/callback?code=synthetic&state=s1")
+            response = conn.getresponse()
+            assert response.status == 200
+            response.read()
+        finally:
+            conn.close()
+
+        assert shutdown_entered.wait(5), "OAuth waiter never reached shutdown"
+        assert loop_pulsed.wait(2), "HTTPServer.shutdown() blocked the MCP event loop"
+    finally:
+        release_shutdown.set()
+        worker.join(timeout=8)
+
+    assert not worker.is_alive(), "OAuth waiter did not finish"
+    assert "error" not in outcome, f"OAuth waiter raised: {outcome.get('error')!r}"
+    assert (outcome["result"].code, outcome["result"].state) == ("synthetic", "s1")
+
+
+def test_cancelled_cleanup_still_closes_the_listener(monkeypatch):
+    """Cancelling the waiter twice while its listener cleanup runs must not skip ``server_close()``: the
+    port has to be bindable as soon as the task ends, or the retry dies with EADDRINUSE (#113771)."""
+    monkeypatch.setattr(oauth.sys, "stdin", io.StringIO())
+    listening = threading.Event()
+    shutdown_entered = threading.Event()
+    release_shutdown = threading.Event()
+    servers = []
+    original_start = oauth._start_callback_server
+
+    def instrumented_start(callback_port, handler):
+        server = original_start(callback_port, handler)  # kept referenced: a GC'd socket would free the port
+        original_shutdown = server.shutdown
+
+        def held_shutdown():
+            shutdown_entered.set()
+            release_shutdown.wait(8)
+            original_shutdown()
+
+        server.shutdown = held_shutdown
+        servers.append(server)
+        listening.set()
+        return server
+
+    monkeypatch.setattr(oauth, "_start_callback_server", instrumented_start)
+
+    def send_callback(port):
+        conn = HTTPConnection("127.0.0.1", port, timeout=5)
+        try:
+            conn.request("GET", "/callback?code=synthetic&state=s1")
+            assert conn.getresponse().status == 200
+        finally:
+            conn.close()
+
+    async def drive():
+        with oauth.force_interactive_oauth():
+            task = asyncio.create_task(oauth._make_callback_waiter(0, timeout=10)())
+        try:
+            assert await asyncio.to_thread(listening.wait, 5), "OAuth callback server never bound"
+            await asyncio.to_thread(send_callback, servers[0].server_address[1])
+            assert await asyncio.to_thread(shutdown_entered.wait, 5), "OAuth waiter never reached cleanup"
+            for _ in range(2):
+                task.cancel()
+                for _ in range(5):
+                    await asyncio.sleep(0)  # let the cancellation reach the task
+        finally:
+            release_shutdown.set()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        with socket.socket() as again:  # what the retry's _start_callback_server does
+            again.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+            again.bind(("127.0.0.1", servers[0].server_address[1]))
+            again.listen()
+
+    try:
+        asyncio.run(drive())
+    finally:
+        release_shutdown.set()
+        for server in servers:
+            server.server_close()
+
+
+def test_loop_teardown_during_cleanup_still_closes_the_listener(monkeypatch):
+    """``asyncio.run`` cancels every task still pending at teardown. Cleanup must not be one of them: a
+    cleanup queued behind a busy default executor was cancelled there and left the port bound."""
+    monkeypatch.setattr(oauth.sys, "stdin", io.StringIO())
+    servers = []
+    original_start = oauth._start_callback_server
+
+    def recording_start(callback_port, handler):
+        servers.append(original_start(callback_port, handler))  # kept referenced: a GC'd socket would free the port
+        return servers[-1]
+
+    monkeypatch.setattr(oauth, "_start_callback_server", recording_start)
+    executor_busy = threading.Event()
+
+    async def main():
+        loop = asyncio.get_running_loop()
+        loop.set_default_executor(ThreadPoolExecutor(max_workers=1))
+        loop.run_in_executor(None, executor_busy.wait, 5)  # every executor slot is taken
+        with oauth.force_interactive_oauth():
+            asyncio.create_task(oauth._make_callback_waiter(0, timeout=0)())  # timeout=0: straight to cleanup
+        for _ in range(20):
+            await asyncio.sleep(0)  # let the waiter bind and enter cleanup
+        threading.Timer(0.2, executor_busy.set).start()
+        # Returning here leaves the waiter pending: asyncio.run's teardown cancels it.
+
+    try:
+        asyncio.run(main())
+        assert servers, "OAuth callback server never bound"
+        with socket.socket() as again:  # what the retry's _start_callback_server does
+            again.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+            again.bind(("127.0.0.1", servers[0].server_address[1]))
+            again.listen()
+    finally:
+        executor_busy.set()
+        for server in servers:
+            server.server_close()
+
+
+def test_cleanup_failure_still_ends_the_waiter(monkeypatch):
+    """A listener whose ``server_close()`` raises must not leave the waiter waiting forever."""
+    monkeypatch.setattr(oauth.sys, "stdin", io.StringIO())
+    servers = []
+    original_start = oauth._start_callback_server
+
+    def failing_close_start(callback_port, handler):
+        server = original_start(callback_port, handler)
+        real_close = server.server_close
+
+        def failing_close():
+            real_close()
+            raise OSError("synthetic close failure")
+
+        server.server_close = failing_close
+        servers.append(server)
+        return server
+
+    monkeypatch.setattr(oauth, "_start_callback_server", failing_close_start)
+
+    outcome = {}
+
+    def run():  # own thread: a waiter that never ends swallows cancellation, so bound it with join()
+        async def main():
+            with oauth.force_interactive_oauth():
+                return await oauth._make_callback_waiter(0, timeout=0)()  # timeout=0: straight to cleanup
+
+        try:
+            outcome["result"] = asyncio.run(main())
+        except Exception as exc:
+            outcome["error"] = exc
+
+    worker = threading.Thread(target=run, daemon=True)
+    worker.start()
+    worker.join(10)
+    assert not worker.is_alive(), "waiter never finished after cleanup failed"
+    assert servers, "OAuth callback server never bound"
+    # No code arrived, so the waiter reports its own timeout.
+    assert isinstance(outcome.get("error"), oauth.OAuthNonInteractiveError), outcome
+    assert "callback timed out" in str(outcome["error"])
diff --git a/tests/tools/test_send_message_shared_bot_route_gate.py b/tests/tools/test_send_message_shared_bot_route_gate.py
