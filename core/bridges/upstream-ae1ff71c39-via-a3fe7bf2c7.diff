--- /dev/null
+++ b/tests/hermes_cli/test_config_declared_provider_credentials.py
@@ -0,0 +1,227 @@
+"""Regression for #145452: model-catalog probes must use a config-declared provider's own
+credential and endpoint.
+
+A ``providers.<id>`` block that is not in ``PROVIDER_REGISTRY`` is invisible to the registry-only
+credential resolver, so catalog helpers probed it keyless (or with an ambient ``OPENAI_API_KEY``)
+and without its base URL. ``${env:VAR}`` secret refs must also be expanded before they reach an
+``Authorization`` header.
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+from unittest.mock import MagicMock
+
+import hermes_yaml as yaml
+import pytest
+
+from agent import auxiliary_client as aux
+from hermes_cli import models as models_mod
+from hermes_cli import models_pricing
+from hermes_cli.auth import AuthError, resolve_api_key_provider_credentials
+
+BASE_URL = "https://proxy.example.test/v1"
+PROVIDER = "my-proxy"
+
+
+@pytest.fixture
+def hermes_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.delenv("OPENAI_API_KEY", raising=False)
+    return home
+
+
+@pytest.fixture(autouse=True)
+def _clear_catalog_caches():
+    models_pricing._pricing_cache.clear()
+    models_pricing._pricing_cache_retry_after.clear()
+    yield
+    models_pricing._pricing_cache.clear()
+    models_pricing._pricing_cache_retry_after.clear()
+
+
+def _write_provider(home, entry: dict) -> None:
+    (home / "config.yaml").write_text(yaml.safe_dump({
+        "model": {"default": "my-combo", "provider": PROVIDER, "base_url": BASE_URL},
+        "providers": {PROVIDER: {"name": "my proxy", "base_url": BASE_URL, **entry}},
+    }), encoding="utf-8")
+
+
+def test_inline_api_key_env_ref_is_expanded(hermes_home, monkeypatch):
+    """``api_key: ${env:VAR}`` must never reach a probe as the literal ref."""
+    monkeypatch.setenv("PROBE_KEY", "sk-declared-inline")
+    _write_provider(hermes_home, {"api_key": "${env:PROBE_KEY}"})
+
+    creds = resolve_api_key_provider_credentials(PROVIDER)
+
+    assert creds["api_key"] == "sk-declared-inline"
+    assert creds["base_url"] == BASE_URL
+
+
+@pytest.mark.parametrize("field", ["key_env", "api_key_env"])
+def test_key_env_pointer_is_resolved(hermes_home, monkeypatch, field):
+    """``key_env`` and its documented ``api_key_env`` alias both name the credential."""
+    monkeypatch.setenv("PROBE_KEY", "sk-declared-env")
+    _write_provider(hermes_home, {field: "PROBE_KEY"})
+
+    creds = resolve_api_key_provider_credentials(PROVIDER)
+
+    assert creds["api_key"] == "sk-declared-env"
+    assert creds["source"] == "PROBE_KEY"
+
+
+def test_key_cmd_token_is_materialized(hermes_home, monkeypatch, tmp_path):
+    """A ``key_cmd`` helper resolves to a probe-ready token through the same resolver."""
+    from agent.command_token_source import materialize_probe_api_key
+
+    helper = tmp_path / "mint_key.py"
+    helper.write_text("print('sk-declared-cmd')\n", encoding="utf-8")
+    _write_provider(hermes_home, {"key_cmd": f'"{sys.executable}" "{helper}"'})
+
+    creds = resolve_api_key_provider_credentials(PROVIDER)
+
+    assert materialize_probe_api_key(creds["api_key"]) == "sk-declared-cmd"
+
+
+def test_key_cmd_runs_once_per_token_not_per_probe(hermes_home, monkeypatch, tmp_path):
+    """Repeated catalog lookups reuse the minted token instead of re-running the helper; another
+    profile with the same key_cmd mints its own."""
+    runs = tmp_path / "runs.txt"
+    helper = tmp_path / "mint_key.py"
+    helper.write_text(f"open({str(runs)!r}, 'a').write('x')\nprint('tok')\n", encoding="utf-8")
+    entry = {"key_cmd": f'"{sys.executable}" "{helper}"'}
+    _write_provider(hermes_home, entry)
+
+    for _ in range(3):
+        assert resolve_api_key_provider_credentials(PROVIDER)["api_key"] == "tok"
+    other = tmp_path / "other-profile"
+    other.mkdir()
+    _write_provider(other, entry)
+    monkeypatch.setenv("HERMES_HOME", str(other))
+    assert resolve_api_key_provider_credentials(PROVIDER)["api_key"] == "tok"
+
+    assert runs.read_text() == "xx"
+
+
+def test_api_field_is_the_base_url(hermes_home):
+    """The ``api`` spelling (legacy named-endpoint field) is honoured like ``base_url``."""
+    (hermes_home / "config.yaml").write_text(yaml.safe_dump({
+        "providers": {PROVIDER: {"name": "my proxy", "api": "https://api.example.test/v1"}},
+    }), encoding="utf-8")
+
+    creds = resolve_api_key_provider_credentials(PROVIDER)
+
+    assert creds["base_url"] == "https://api.example.test/v1"
+
+
+def test_unknown_provider_still_raises(hermes_home):
+    """Only a real config entry widens the resolver; an unknown name stays an error."""
+    _write_provider(hermes_home, {"key_env": "PROBE_KEY"})
+
+    with pytest.raises(AuthError):
+        resolve_api_key_provider_credentials("not-configured-anywhere")
+
+
+def test_fast_model_catalog_sends_the_declared_credential(hermes_home, monkeypatch):
+    """``_fast_model_from_catalog`` probes the config-declared endpoint with its own key —
+    never an unexpanded ref — and reads the catalog from its declared base URL."""
+    monkeypatch.setenv("PROBE_KEY", "sk-declared-catalog")
+    _write_provider(hermes_home, {"api_key": "${env:PROBE_KEY}"})
+    seen: list[str | None] = []
+
+    def _fake_urlopen(req, timeout=8.0):
+        seen.append(req.get_header("Authorization"))
+        payload = {
+            "data": [{
+                "id": "proxy-small-mini",
+                "pricing": {"prompt": "0.000001", "completion": "0.000002"},
+            }],
+        }
+        resp = MagicMock()
+        resp.read.return_value = json.dumps(payload).encode()
+        resp.__enter__ = lambda self: self
+        resp.__exit__ = lambda *args: False
+        return resp
+
+    monkeypatch.setattr(models_mod, "_urlopen_model_catalog_request", _fake_urlopen)
+
+    assert aux._fast_model_from_catalog(PROVIDER) == "proxy-small-mini"
+    assert seen == ["Bearer sk-declared-catalog"]
+
+
+@pytest.fixture
+def two_catalog_servers():
+    """Two real loopback ``/v1/models`` servers; each records the Authorization it received."""
+    import http.server
+    import threading
+
+    servers = []
+    for _ in range(2):
+        class _Handler(http.server.BaseHTTPRequestHandler):
+            seen: list[str | None] = []
+
+            def do_GET(self):
+                type(self).seen.append(self.headers.get("Authorization"))
+                body = json.dumps({"data": [{"id": "relay-mini"}]}).encode()
+                self.send_response(200)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+            def log_message(self, *args):
+                pass
+
+        server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), _Handler)
+        threading.Thread(target=server.serve_forever, daemon=True).start()
+        servers.append(server)
+    yield [(f"http://127.0.0.1:{s.server_port}/v1", s.RequestHandlerClass.seen) for s in servers]
+    for server in servers:
+        server.shutdown()
+        server.server_close()
+
+
+@pytest.mark.parametrize("same_origin", [True, False])
+def test_relay_probe_sends_declared_key_only_to_its_own_origin(
+        hermes_home, monkeypatch, two_catalog_servers, same_origin):
+    """The picker's relay probe hits ``model.base_url``. The declared key belongs to
+    ``providers.<id>.base_url``, and inference resolves there, so a stale or edited
+    ``model.base_url`` on another origin is probed keyless, never with that key."""
+    (url_a, seen_a), (url_b, seen_b) = two_catalog_servers
+    monkeypatch.setenv("ROUTE_KEY", "route-key-secret")
+    probed_url, seen = (url_a, seen_a) if same_origin else (url_b, seen_b)
+    (hermes_home / "config.yaml").write_text(yaml.safe_dump({
+        "model": {"default": "my-combo", "provider": PROVIDER, "base_url": probed_url},
+        "providers": {PROVIDER: {"name": "my proxy", "base_url": url_a, "key_env": "ROUTE_KEY"}},
+    }), encoding="utf-8")
+
+    assert models_mod.provider_model_ids(PROVIDER, force_refresh=True) == ["relay-mini"]
+
+    assert seen == (["Bearer route-key-secret"] if same_origin else [None])
+    if not same_origin:
+        assert seen_a == []
+
+
+def test_relay_probe_keeps_a_registry_providers_key(monkeypatch):
+    """#121387: a registry provider's key still rides its relay probe on another origin; only a
+    declared providers.<id> key is bound to its entry's own origin."""
+    import providers
+
+    calls = []
+
+    class _Profile:
+        auth_type = "api_key"
+
+        def fetch_models(self, api_key=None, base_url=None):
+            calls.append((api_key, base_url))
+            return ["relay-only-model"]
+
+    monkeypatch.setattr(providers, "get_provider_profile", lambda name: _Profile())
+    monkeypatch.setattr(models_mod, "_api_key_credentials", lambda name: ("deepseek-key", "https://api.deepseek.com/v1"))
+    relay = "http://127.0.0.1:9001/deepseek/v1"
+
+    assert models_mod._relay_model_catalog("deepseek", relay) == ["relay-only-model"]
+    assert calls == [("deepseek-key", relay)]
diff --git a/tests/hermes_cli/test_config_secret_refs.py b/tests/hermes_cli/test_config_secret_refs.py
new file mode 100644
index 0000000000..a21cfe25ab
--- /dev/null
+++ b/tests/hermes_cli/test_config_secret_refs.py
@@ -0,0 +1,639 @@
+"""Config writers store credentials in ``.env`` and only a reference in ``config.yaml`` (#77471).
+
+Each test runs a real writer against a temp ``HERMES_HOME``, then checks the contract: the secret
+is not in ``config.yaml``, it is in the profile's ``.env``, and the runtime reader still resolves it.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+SECRET = "sk-77471-synthetic-secret-value"
+
+
+@pytest.fixture()
+def home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    (home / ".env").touch()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    import os
+    for name in list(os.environ):
+        if name in {"HERMES_MODEL_API_KEY", "HERMES_DELEGATION_API_KEY", "AUXILIARY_VISION_API_KEY"} or (
+                name.startswith(("HERMES_CUSTOM_", "HERMES_PROVIDER_"))):
+            monkeypatch.delenv(name, raising=False)
+    return home
+
+
+def _config_text(home) -> str:
+    return (home / "config.yaml").read_text(encoding="utf-8")
+
+
+def _assert_secret_only_in_env(home) -> None:
+    assert SECRET not in _config_text(home)
+    assert SECRET in (home / ".env").read_text(encoding="utf-8")
+
+
+def test_config_set_model_api_key_stores_a_reference(home, capsys):
+    from hermes_cli.config import load_config, set_config_value
+    from hermes_cli.runtime_provider import resolve_runtime_provider
+
+    set_config_value("model.provider", "custom")
+    set_config_value("model.base_url", "https://llm.example.com/v1")
+    set_config_value("model.default", "m")
+    set_config_value("model.api_key", SECRET)
+
+    _assert_secret_only_in_env(home)
+    assert "${HERMES_MODEL_API_KEY}" in _config_text(home)
+    assert SECRET not in capsys.readouterr().out
+    assert load_config()["model"]["api_key"] == SECRET
+    assert resolve_runtime_provider(requested="custom")["api_key"] == SECRET
+
+
+@pytest.mark.parametrize("key,env_name", [
+    ("auxiliary.vision.api_key", "AUXILIARY_VISION_API_KEY"),
+    ("delegation.api_key", "HERMES_DELEGATION_API_KEY"),
+])
+def test_config_set_aux_and_delegation_keys_store_a_reference(home, key, env_name):
+    from hermes_cli.config import load_config, set_config_value
+
+    set_config_value(key, SECRET)
+
+    _assert_secret_only_in_env(home)
+    assert f"${{{env_name}}}" in _config_text(home)
+    section, *rest = key.split(".")
+    node = load_config()[section]
+    for part in rest[:-1]:
+        node = node[part]
+    assert node["api_key"] == SECRET
+
+
+def test_config_set_keeps_an_explicit_reference_and_inline_values_still_resolve(home):
+    """A ``${VAR}`` the user types is stored verbatim; an inline value written by hand (no migration)
+    keeps resolving."""
+    from hermes_cli.config import load_config, set_config_value
+
+    set_config_value("model.api_key", "${MY_OWN_KEY}")
+    assert "${MY_OWN_KEY}" in _config_text(home)
+    assert "MY_OWN_KEY" not in (home / ".env").read_text(encoding="utf-8")
+
+    (home / "config.yaml").write_text(f"model:\n  provider: custom\n  api_key: {SECRET}\n", encoding="utf-8")
+    assert load_config()["model"]["api_key"] == SECRET
+
+
+def test_dashboard_main_custom_endpoint_stores_a_reference(home, monkeypatch):
+    from hermes_cli.config import load_config
+    from hermes_cli.runtime_provider import resolve_runtime_provider
+    from hermes_cli.web_server_config import _apply_model_assignment_sync
+
+    monkeypatch.setattr(
+        "hermes_cli.models_validate.validate_requested_model",
+        lambda *a, **k: {"accepted": True, "persist": True, "recognized": True, "message": None})
+    (home / "config.yaml").write_text("model:\n  provider: openrouter\n  default: x\n", encoding="utf-8")
+
+    _apply_model_assignment_sync("main", "custom", "m", "", "https://llm.example.com:8443/v1", SECRET)
+
+    _assert_secret_only_in_env(home)
+    cfg = load_config()
+    assert cfg["model"]["api_key"] == SECRET
+    row = next(e for e in cfg["custom_providers"] if e["base_url"] == "https://llm.example.com:8443/v1")
+    assert row["key_env"].startswith("HERMES_CUSTOM_LLM_EXAMPLE_COM_8443_") and "api_key" not in row
+    assert cfg["model"]["api_key"] == SECRET and f"${{{row['key_env']}}}" in _config_text(home)
+    assert resolve_runtime_provider(requested="custom")["api_key"] == SECRET
+
+
+def test_dashboard_aux_slot_stores_a_reference(home):
+    from agent.auxiliary_client import _resolve_task_provider_model
+    from hermes_cli.config import load_config
+    from hermes_cli.web_server_config import _apply_model_assignment_sync
+
+    (home / "config.yaml").write_text("model:\n  provider: openrouter\n  default: x\n", encoding="utf-8")
+
+    _apply_model_assignment_sync("auxiliary", "custom", "m", "vision", "https://llm.example.com/v1", SECRET)
+
+    _assert_secret_only_in_env(home)
+    assert load_config()["auxiliary"]["vision"]["api_key"] == SECRET
+    assert _resolve_task_provider_model("vision")[3] == SECRET
+
+
+def test_hermes_model_aux_flow_stores_a_reference(home):
+    from agent.auxiliary_client import _resolve_task_provider_model
+    from hermes_cli.main_provider_setup import _save_aux_choice
+
+    _save_aux_choice("vision", provider="custom", model="m", base_url="https://llm.example.com/v1", api_key=SECRET)
+
+    _assert_secret_only_in_env(home)
+    assert _resolve_task_provider_model("vision")[3] == SECRET
+
+
+def test_new_custom_provider_entry_stores_key_env(home):
+    from hermes_cli.config import load_config
+    from hermes_cli.runtime_provider import resolve_runtime_provider
+    from hermes_cli.main_provider_setup import _save_custom_provider
+
+    _save_custom_provider("https://llm.example.com/v1", SECRET, "m", name="Example")
+
+    _assert_secret_only_in_env(home)
+    entry = load_config()["custom_providers"][0]
+    assert entry["key_env"].startswith("HERMES_CUSTOM_LLM_EXAMPLE_COM_") and "api_key" not in entry
+    assert resolve_runtime_provider(requested="custom:example")["api_key"] == SECRET
+
+
+def test_plugin_aux_task_keys_with_distinct_underscores_keep_distinct_credentials(home):
+    """Two valid plugin task keys must not share the env variable after either is saved."""
+    from hermes_cli.config import load_config, read_raw_config
+    from hermes_cli.main_provider_setup import _save_aux_choice
+
+    tasks = (("my_task", "KEY-ONE"), ("my__task", "KEY-TWO"), ("my_task_", "KEY-THREE"), ("_my_task", "KEY-FOUR"),
+             ("My_Task", "KEY-FIVE"))
+    for n, (task, key) in enumerate(tasks):
+        _save_aux_choice(task, provider="custom", model="m", base_url=f"https://h{n}.example/v1", api_key=key)
+
+    raw = read_raw_config()["auxiliary"]
+    resolved = load_config()["auxiliary"]
+    assert len({raw[task]["api_key"] for task, _ in tasks}) == len(tasks)
+    assert {task: resolved[task]["api_key"] for task, _ in tasks} == dict(tasks)
+    assert raw["my_task"]["api_key"] == "${AUXILIARY_MY_TASK_API_KEY}"  # lowercase keys keep the legacy name
+
+
+def test_endpoint_names_separate_gateways_behind_one_host():
+    from hermes_cli.config_secret_refs import endpoint_api_key_env
+
+    assert endpoint_api_key_env("http://localhost:11434/v1").startswith("HERMES_CUSTOM_LOCALHOST_11434_")
+    assert endpoint_api_key_env("http://h:9/old/v1") != endpoint_api_key_env("http://h:9/new/v1")
+
+
+@pytest.mark.parametrize("first,second", [
+    ("https://my-host.com/v1", "https://my.host.com/v1"),
+    ("https://a.com/x_y/v1", "https://a.com/x/y/v1"),
+    ("https://a.com:8443/v1", "https://a.com/8443"),
