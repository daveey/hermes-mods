diff --git a/tests/hermes_state/test_network_fs_journal_default.py b/tests/hermes_state/test_network_fs_journal_default.py
new file mode 100644
index 0000000000..ddcd4eacb5
--- /dev/null
+++ b/tests/hermes_state/test_network_fs_journal_default.py
@@ -0,0 +1,136 @@
+"""Network-filesystem journal-mode policy for NEW stores (field report: state.db on NFS, WAL stalls).
+
+On an NFS mount every WAL ``-shm`` lock and unlock is a server round trip, and with several connections
+in ONE process (SessionDB alone holds a writer plus up to 8 pooled readers) a thread can sit in
+``fcntl(F_SETLK)`` on ``state.db-shm`` for 20-90 s. DELETE mode on the same mount stayed under 100 ms
+reads in the operator's benchmark. So a store Hermes creates on a network filesystem starts in DELETE,
+unless the operator explicitly configured ``database.journal_mode``:
+
+* fresh store on nfs/cifs/smb/sshfs, journal_mode unset  -> DELETE, one WARNING naming the override;
+* journal_mode explicitly ``wal``                         -> WAL (the operator's choice wins);
+* journal_mode explicitly ``delete``                      -> DELETE (unchanged);
+* an existing DELETE store on a network mount is not silently upgraded to WAL;
+* an existing WAL store is never live-downgraded and gets one WARNING with the offline remedy;
+* every other filesystem keeps today's WAL default.
+"""
+
+import logging
+import sqlite3
+
+import pytest
+
+import hermes_state_wal
+import hermes_yaml as yaml
+from hermes_state_wal import apply_wal_with_fallback
+
+
+@pytest.fixture(autouse=True)
+def _isolate(monkeypatch, tmp_path):
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(hermes_state_wal, "is_sqlite_wal_reset_vulnerable", lambda *a, **k: False)
+    monkeypatch.setattr(hermes_state_wal, "_path_on_cross_vm_fs", lambda p: False)
+    for name in ("_network_fs_warned_paths", "_network_fs_new_store_warned_paths",
+                 "_journal_upgrade_warned_paths", "_delete_overridden_warned_paths"):
+        if hasattr(hermes_state_wal, name):
+            getattr(hermes_state_wal, name).clear()
+    getattr(hermes_state_wal, "_network_fs_cache", {}).clear()
+    return home
+
+
+def _configure(home, journal_mode):
+    (home / "config.yaml").write_text(yaml.safe_dump({"database": {"journal_mode": journal_mode}}),
+                                      encoding="utf-8")
+
+
+def _on_network_fs(monkeypatch, value=True):
+    monkeypatch.setattr(hermes_state_wal, "_detect_network_fs", lambda directory, *a, **k: value, raising=False)
+
+
+def _open(path):
+    conn = sqlite3.connect(str(path))
+    try:
+        return apply_wal_with_fallback(conn, db_label=path.name), conn.execute("PRAGMA journal_mode").fetchone()[0]
+    finally:
+        conn.close()
+
+
+def _seed(path, mode):
+    seed = sqlite3.connect(str(path))
+    got = str(seed.execute(f"PRAGMA journal_mode={mode}").fetchone()[0]).lower()
+    if got != mode.lower():
+        seed.close()
+        pytest.skip(f"environment refuses journal_mode={mode}")
+    seed.execute("CREATE TABLE t (x)")
+    seed.commit()
+    seed.close()
+
+
+def test_fresh_store_on_network_fs_starts_in_delete_and_warns_once(tmp_path, monkeypatch, caplog):
+    _on_network_fs(monkeypatch)
+    with caplog.at_level(logging.WARNING, logger=hermes_state_wal.logger.name):
+        assert _open(tmp_path / "state.db") == ("delete", "delete")
+        assert _open(tmp_path / "state.db") == ("delete", "delete")
+    lines = [r for r in caplog.records if "network filesystem" in r.getMessage()]
+    assert len(lines) == 1 and lines[0].levelno == logging.WARNING
+    assert "database.journal_mode: wal" in lines[0].getMessage()  # names the override
+
+
+def test_same_fresh_store_off_network_fs_still_gets_wal(tmp_path, monkeypatch):
+    _on_network_fs(monkeypatch, False)
+    mode, on_disk = _open(tmp_path / "state.db")
+    if mode != "wal":
+        pytest.skip("environment refuses WAL for unrelated reasons")
+    assert on_disk == "wal"
+
+
+def test_explicit_wal_config_wins_on_network_fs(tmp_path, monkeypatch, _isolate):
+    _configure(_isolate, "wal")
+    _on_network_fs(monkeypatch, False)
+    if _open(tmp_path / "control.db")[0] != "wal":  # gate the skip on the ENVIRONMENT, never on the result
+        pytest.skip("environment refuses WAL for unrelated reasons")
+    _on_network_fs(monkeypatch)
+    hermes_state_wal._network_fs_cache.clear()
+    assert _open(tmp_path / "state.db") == ("wal", "wal")
+
+
+def test_explicit_delete_config_unchanged_on_network_fs(tmp_path, monkeypatch, _isolate):
+    _configure(_isolate, "delete")
+    _on_network_fs(monkeypatch)
+    assert _open(tmp_path / "state.db") == ("delete", "delete")
+
+
+def test_existing_delete_store_on_network_fs_is_not_upgraded_to_wal(tmp_path, monkeypatch, caplog):
+    db = tmp_path / "kanban.db"
+    _seed(db, "DELETE")
+    _on_network_fs(monkeypatch)
+    with caplog.at_level(logging.WARNING, logger=hermes_state_wal.logger.name):
+        assert _open(db) == ("delete", "delete")
+    assert not [r for r in caplog.records if "switched to WAL" in r.getMessage()]
+
+
+def test_existing_wal_store_on_network_fs_keeps_wal_and_names_the_offline_remedy(tmp_path, monkeypatch, caplog):
+    db = tmp_path / "state.db"
+    _seed(db, "WAL")
+    _on_network_fs(monkeypatch)
+    with caplog.at_level(logging.WARNING, logger=hermes_state_wal.logger.name):
+        for _ in range(2):
+            assert _open(db) == ("wal", "wal")  # never live-downgraded
+    lines = [r for r in caplog.records if "network filesystem" in r.getMessage()]
+    assert len(lines) == 1 and lines[0].levelno == logging.WARNING
+    text = lines[0].getMessage()
+    assert "hermes sessions set-journal-mode delete" in text
+    assert "database.journal_mode: delete" in text
+
+
+@pytest.mark.platforms("linux")
+def test_network_fstypes_cover_nfs_and_smb_variants(tmp_path):
+    rows = ["25 1 8:1 / / rw - ext4 /dev/sda1 rw"] + [
+        f"{600 + i} 25 0:{60 + i} / /mnt/{fs.replace('.', '_')} rw - {fs} srv:/x rw"
+        for i, fs in enumerate(("nfs", "nfs4", "cifs", "smb3", "fuse.sshfs"))]
+    mi = tmp_path / "mountinfo"
+    mi.write_text("\n".join(rows) + "\n", encoding="utf-8")
+    for fs in ("nfs", "nfs4", "cifs", "smb3", "fuse_sshfs"):
+        assert hermes_state_wal._detect_network_fs(f"/mnt/{fs}/home", mountinfo_path=str(mi)) is True
+    assert hermes_state_wal._detect_network_fs("/home/user/.hermes", mountinfo_path=str(mi)) is False
diff --git a/tests/hermes_state/test_network_fs_store_coverage.py b/tests/hermes_state/test_network_fs_store_coverage.py
new file mode 100644
index 0000000000..93e51c1a18
--- /dev/null
+++ b/tests/hermes_state/test_network_fs_store_coverage.py
@@ -0,0 +1,55 @@
+"""Every Hermes SQLite store shares the network-filesystem journal policy (one helper, not per-store copies).
+
+The field report saw the cron scheduler parked on ``cron/executions.db-shm`` too: converting state.db
+alone left ``cron/executions.db``, ``cron/deliveries.db``, ``response_store.db`` and ``projects.db`` in
+WAL. Each store opens through ``apply_wal_with_fallback`` (directly or via ``hermes_cli.sqlite_util.open_db``),
+so a fresh one on a network mount starts in DELETE like state.db does.
+"""
+
+import sqlite3
+
+import pytest
+
+import hermes_state_wal
+
+
+@pytest.fixture()
+def network_home(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    (home / "cron").mkdir(parents=True)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(hermes_state_wal, "is_sqlite_wal_reset_vulnerable", lambda *a, **k: False)
+    monkeypatch.setattr(hermes_state_wal, "_path_on_cross_vm_fs", lambda p: False)
+    monkeypatch.setattr(hermes_state_wal, "_detect_network_fs", lambda directory, *a, **k: True, raising=False)
+    getattr(hermes_state_wal, "_network_fs_cache", {}).clear()
+    getattr(hermes_state_wal, "_network_fs_new_store_warned_paths", set()).clear()
+    return home
+
+
+def _header_mode(path):
+    with sqlite3.connect(str(path)) as conn:
+        return str(conn.execute("PRAGMA journal_mode").fetchone()[0]).lower()
+
+
+def test_session_db_on_network_fs_starts_in_delete(network_home):
+    from hermes_state import SessionDB
+    with SessionDB(network_home / "state.db") as db:
+        db.create_session("s", source="test")
+        assert db._wal_active is False
+    assert _header_mode(network_home / "state.db") == "delete"
+
+
+@pytest.mark.parametrize("store", ["cron/executions.db", "cron/deliveries.db", "projects.db"])
+def test_open_db_stores_on_network_fs_start_in_delete(network_home, store):
+    from hermes_cli.sqlite_util import open_db
+    conn = open_db(network_home / store, db_label=store)
+    conn.close()
+    assert _header_mode(network_home / store) == "delete"
+
+
+def test_response_store_on_network_fs_starts_in_delete(network_home):
+    from gateway.platforms.api_server_response_store import ResponseStore
+    path = network_home / "response_store.db"
+    store = ResponseStore(db_path=str(path))
+    store.close()
+    assert _header_mode(path) == "delete"
diff --git a/tests/hermes_state/test_network_fs_wal_warn.py b/tests/hermes_state/test_network_fs_wal_warn.py
new file mode 100644
index 0000000000..bf43f75ec5
--- /dev/null
+++ b/tests/hermes_state/test_network_fs_wal_warn.py
@@ -0,0 +1,111 @@
+"""Network filesystem (nfs/cifs/smb/sshfs) existing-WAL warning, the #110848 remainder.
+
+Unlike the cross-VM class these mounts never refuse WAL for fresh databases (single-writer NFS homes are a
+legitimate shape), so the contract is narrower: an on-disk WAL database on one is warned about, once, at
+WARNING level, and a fresh database keeps upstream behaviour (WAL enabled, no warning).
+"""
+
+import logging
+import sqlite3
+
+import pytest
+
+import hermes_state_wal
+from hermes_state_wal import _detect_network_fs, apply_wal_with_fallback
+
+
+def _mountinfo(tmp_path, lines):
+    p = tmp_path / "mountinfo"
+    p.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return str(p)
+
+
+# Realistic mountinfo rows (id parent major:minor root mountpoint opts ... - fstype source superopts)
+ROOT_EXT4 = "25 1 8:1 / / rw,relatime shared:1 - ext4 /dev/sda1 rw"
+BIND_NFS = "620 25 0:60 / /srv/nas rw,relatime - nfs nas:/export/hermes rw"
+BIND_CIFS = "621 25 0:61 / /mnt/share rw,relatime - cifs //fileserver/hermes rw"
+BIND_FUSE_SSHFS = "622 25 0:62 / /home/remote rw,relatime - fuse.sshfs host:/home/user rw"
+BIND_VIRTIOFS = "623 25 0:63 / /data rw,relatime - virtiofs mount0 rw"
+
+
+@pytest.mark.platforms("linux")
+class TestDetectNetworkFs:
+    @pytest.mark.parametrize("path,expected", [
+        ("/srv/nas/agent", True),         # nfs bind mount
+        ("/mnt/share/db", True),          # cifs bind mount
+        ("/home/remote/.hermes", True),   # fuse.sshfs bind mount
+        ("/home/local/.hermes", False),   # ext4 root
+        ("/data/agent", False),           # virtiofs belongs to the cross-VM class, not this one
+    ])
+    def test_only_network_mounts_are_flagged(self, tmp_path, path, expected):
+        mi = _mountinfo(tmp_path, [ROOT_EXT4, BIND_NFS, BIND_CIFS, BIND_FUSE_SSHFS, BIND_VIRTIOFS])
+        assert _detect_network_fs(path, mountinfo_path=mi) is expected
+
+    @pytest.mark.parametrize("fstype", [
+        "ext4", "xfs", "btrfs", "zfs", "tmpfs", "overlay", "apfs", "f2fs", "fuse.ntfs3g", "fuse.rofs",
+    ])
+    def test_local_and_generic_fuse_filesystems_never_flagged(self, tmp_path, fstype):
+        # Generic FUSE can be local; flagging it would warn every ntfs3g home (#110848 scope call).
+        mi = _mountinfo(tmp_path, [f"25 1 8:1 / / rw,relatime shared:1 - {fstype} /dev/sda1 rw"])
+        assert _detect_network_fs("/home/user/.hermes", mountinfo_path=mi) is False
+
+    def test_missing_mountinfo_conservative_false(self, tmp_path):
+        assert _detect_network_fs("/srv/nas", mountinfo_path=str(tmp_path / "nope")) is False
+
+
+@pytest.mark.platforms("not linux")
+def test_network_mountinfo_is_not_used_on_other_hosts(tmp_path):
+    mi = _mountinfo(tmp_path, [ROOT_EXT4, BIND_NFS, BIND_CIFS, BIND_FUSE_SSHFS])
+    for path in ("/srv/nas/agent", "/mnt/share/db", "/home/remote/.hermes"):
+        assert _detect_network_fs(path, mountinfo_path=mi) is False
+
+
+class TestNetworkFsExistingWalWarn:
+    @pytest.fixture(autouse=True)
+    def _isolate(self, monkeypatch):
+        # Same isolation as the cross-VM suite: pin the WAL-reset gate and the config reader, keep the
+        # cross-VM class out of the picture, and clear the network once-per-process dedupe set.
+        monkeypatch.setattr(hermes_state_wal, "is_sqlite_wal_reset_vulnerable", lambda *a, **k: False)
+        monkeypatch.setattr(hermes_state_wal, "resolve_journal_mode", lambda: "wal")
+        monkeypatch.setattr(hermes_state_wal, "_path_on_cross_vm_fs", lambda p: False)
+        hermes_state_wal._network_fs_warned_paths.clear()
+
+    @pytest.mark.parametrize("wal_reset_vulnerable", [False, True])
+    def test_existing_wal_db_on_network_fs_warns_once_at_warning(
+        self, tmp_path, monkeypatch, caplog, wal_reset_vulnerable,
+    ):
+        # Both already-WAL early-return paths (regular and WAL-reset-vulnerable) must warn, never at ERROR:
+        # single-writer NFS is a working shape, so this is a risk signal, not an active-corruption alarm.
+        monkeypatch.setattr(hermes_state_wal, "is_sqlite_wal_reset_vulnerable", lambda *a, **k: wal_reset_vulnerable)
+        db = tmp_path / "already-wal.db"
+        seed = sqlite3.connect(str(db))
+        if str(seed.execute("PRAGMA journal_mode=WAL").fetchone()[0]).lower() != "wal":
+            seed.close()
+            pytest.skip("environment refuses WAL")
+        seed.execute("CREATE TABLE t (x)")
+        seed.commit()
+        seed.close()
+        monkeypatch.setattr(hermes_state_wal, "_path_on_network_fs", lambda p: True)
+        with caplog.at_level(logging.WARNING, logger=hermes_state_wal.logger.name):
+            for _ in range(2):
+                conn = sqlite3.connect(str(db))
+                assert apply_wal_with_fallback(conn, db_label="state.db") == "wal"
+                conn.close()
+        warnings = [r for r in caplog.records if "network filesystem" in r.getMessage()]
+        assert len(warnings) == 1
+        assert warnings[0].levelno == logging.WARNING
+        assert not [r for r in caplog.records if r.levelno >= logging.ERROR]
+
+    def test_fresh_db_on_network_fs_starts_in_delete_and_says_so(self, tmp_path, monkeypatch, caplog):
+        # Policy changed by the field report on NFS WAL stalls: a brand-new database on a network filesystem now
+        # starts in DELETE (an unset database.journal_mode), with one WARNING naming the `wal` override. The
+        # override itself is pinned in test_network_fs_journal_default.py.
+        monkeypatch.setattr(hermes_state_wal, "_path_on_network_fs", lambda p: True)
+        monkeypatch.setattr(hermes_state_wal, "_journal_mode_explicitly_configured", lambda: False)
+        hermes_state_wal._network_fs_new_store_warned_paths.clear()
+        conn = sqlite3.connect(str(tmp_path / "fresh.db"))
+        with caplog.at_level(logging.WARNING, logger=hermes_state_wal.logger.name):
+            mode = apply_wal_with_fallback(conn, db_label="fresh.db")
+        conn.close()
+        assert mode == "delete"
+        assert [r for r in caplog.records if "network filesystem" in r.getMessage()]
diff --git a/tests/hermes_state/test_read_pool_exhaustion_warning.py b/tests/hermes_state/test_read_pool_exhaustion_warning.py
new file mode 100644
index 0000000000..936f5141f6
--- /dev/null
+++ b/tests/hermes_state/test_read_pool_exhaustion_warning.py
@@ -0,0 +1,64 @@
+"""Read-pool exhaustion is visible at WARNING, rate-limited (field report: NFS stalls).
+
+When every pooled read permit is out, ``_get_read_conn`` serves the read from the writer connection under
+``SessionDB._lock``: that read then queues behind every writer, including one parked on a slow ``-shm`` lock.
+The message used to be DEBUG, invisible in a production log. It is now a WARNING, at most one per database
+per window, carrying a count of the reads that degraded since the last one. No SQL or parameters are logged.
+"""
+
+import logging
+
+import pytest
+
+import hermes_state_readpool
+from hermes_state import SessionDB
+
+
+@pytest.fixture()
+def db(tmp_path):
+    handle = SessionDB(tmp_path / "state.db")
+    handle.create_session("s", source="test")
+    yield handle
+    handle.close()
+
+
+def _exhaust(monkeypatch, db):
+    monkeypatch.setattr(db, "_wal_active", True)
+    monkeypatch.setattr(db._read_budget, "acquire", lambda requester: False)
+
+
+def test_pool_exhaustion_warns_once_per_window_with_a_count(db, monkeypatch, caplog):
+    _exhaust(monkeypatch, db)
+    clock = [1000.0]
+    monkeypatch.setattr(hermes_state_readpool.time, "monotonic", lambda: clock[0], raising=False)
+    getattr(hermes_state_readpool, "_pool_exhaustion_warned_at", {}).clear()
+    with caplog.at_level(logging.WARNING, logger="hermes_state"):
+        for _ in range(5):
+            assert db._get_read_conn() is None
+            assert db.get_session("s") is not None  # still served, from the locked writer
+        clock[0] += 61.0
+        assert db._get_read_conn() is None
+    warnings = [r for r in caplog.records
+                if r.levelno == logging.WARNING and "read pool at capacity" in r.getMessage()]
+    assert len(warnings) == 2, [r.getMessage() for r in warnings]
+    assert "state.db" in warnings[0].getMessage()
+    assert "locked writer connection" in warnings[0].getMessage()
+    # The second window reports how many reads degraded since the first warning.
+    assert "reads since the last warning" in warnings[1].getMessage()
+
+
+def test_pool_exhaustion_count_is_per_database(tmp_path, monkeypatch, caplog):
+    getattr(hermes_state_readpool, "_pool_exhaustion_warned_at", {}).clear()
+    a, b = SessionDB(tmp_path / "a" / "state.db"), SessionDB(tmp_path / "b" / "state.db")
+    try:
+        for handle in (a, b):
+            _exhaust(monkeypatch, handle)
+        with caplog.at_level(logging.WARNING, logger="hermes_state"):
+            a._get_read_conn()
+            b._get_read_conn()
+            a._get_read_conn()
+    finally:
+        a.close()
+        b.close()
+    warnings = [r for r in caplog.records if "read pool at capacity" in r.getMessage()]
+    assert len(warnings) == 2  # one per database, the repeat on `a` suppressed
