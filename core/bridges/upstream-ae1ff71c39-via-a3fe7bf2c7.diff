+"""A live allowlist refresh reads only the config the gate came from, and publishes all-or-nothing.
+
+An adapter built from ``gateway --config custom.yaml`` keeps that file's policy when the home
+config.yaml changes; a config.yaml edit whose typed construction fails leaves the adapter AND the
+runner's env-reading authorization on the last good lists.
+"""
+
+import itertools
+import os
+import time
+
+import hermes_yaml as yaml
+import pytest
+
+from gateway.config import Platform, load_gateway_config
+
+_WRITES = itertools.count()
+
+
+def _write(home, doc):
+    path = home / "config.yaml"
+    path.write_text(yaml.safe_dump(doc), encoding="utf-8")
+    stamp = time.time_ns() - 10_000_000_000 + next(_WRITES) * 1_000_000
+    os.utime(path, ns=(stamp, stamp))
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    for name in list(os.environ):
+        if name.startswith(("DISCORD_", "TELEGRAM_", "HERMES_BRIDGED_", "GATEWAY_ALLOW")):
+            monkeypatch.delenv(name)
+    for var in ("DISCORD_ALLOWED_USERS", "TELEGRAM_ALLOWED_USERS"):  # teardown removes bridged writes
+        monkeypatch.setenv(var, "")
+        monkeypatch.delenv(var)
+        monkeypatch.setenv(f"HERMES_BRIDGED_{var}", "")
+        monkeypatch.delenv(f"HERMES_BRIDGED_{var}")
+    return tmp_path
+
+
+def test_custom_config_adapter_ignores_home_config_edits(home):
+    from gateway.config_loader import load_gateway_config_file
+    from plugins.platforms.discord.adapter import DiscordAdapter
+
+    _write(home, {"discord": {"allow_from": ["222"]}})
+    custom = home / "custom.yaml"
+    custom.write_text(yaml.safe_dump({"platforms": {"discord": {"enabled": True, "extra": {"allow_from": ["111"]}}}}))
+    adapter = DiscordAdapter(load_gateway_config_file(str(custom)).platforms[Platform.DISCORD])
+    adapter._snapshot_gate_env()
+    adapter._allowed_user_ids = adapter._get_allowed_users()
+    adapter._allowed_role_ids = adapter._get_allowed_roles()
+    adapter._mark_live_gate_baseline()
+    assert (adapter._is_allowed_user("111"), adapter._is_allowed_user("222")) == (True, False)
+    _write(home, {"discord": {"allow_from": ["222"]}, "display": {"tool_preview_length": 123}})
+    assert (adapter._is_allowed_user("111"), adapter._is_allowed_user("222")) == (True, False)
+
+
+def test_failed_typed_construction_publishes_no_env_grant(home):
+    from gateway.platforms._shared import mark_live_gate_baseline
+    from plugins.platforms.telegram.adapter import TelegramAdapter
+    from tests.gateway.test_multiplex_interactive_auth import _runner
+
+    _write(home, {"telegram": {"allow_from": ["111"]}})
+    adapter = TelegramAdapter(load_gateway_config().platforms[Platform.TELEGRAM])
+    mark_live_gate_baseline(adapter)
+    runner = _runner(home)
+    runner.config.multiplex_profiles = False
+    runner.config.profile_routes = []
+    runner.adapters = {Platform.TELEGRAM: adapter}
+    runner.config.platforms = {Platform.TELEGRAM: adapter.config}
+    adapter.set_authorization_check(runner._make_adapter_auth_check(Platform.TELEGRAM))
+    assert adapter._is_callback_user_authorized("222", chat_id="222", chat_type="private") is False
+    # The Telegram list bridges fine; another platform's block then fails typed construction.
+    _write(home, {"telegram": {"allow_from": ["222"]}, "platforms": {"discord": {"home_channel": {"name": "x"}}}})
+    assert adapter._is_callback_user_authorized("222", chat_id="222", chat_type="private") is False
+    assert os.environ.get("TELEGRAM_ALLOWED_USERS") == "111"
+    assert adapter.config.extra.get("allow_from") == ["111"]
+
+
+def test_a_non_strict_load_that_fails_mid_bridge_restores_the_last_good_env(home, monkeypatch):
+    """The non-strict fallback swallows the YAML failure and continues on env/gateway.json, so the outer
+    transaction never unwinds: only the abort may undo the partial write, and it must retract nothing."""
+    from gateway.platforms._shared import bridged_env_marker
+
+    for var in ("DISCORD_ALLOWED_ROLES", "HERMES_BRIDGED_DISCORD_ALLOWED_ROLES"):  # teardown removes bridged writes
+        monkeypatch.setenv(var, "")
+        monkeypatch.delenv(var)
+    _write(home, {"discord": {"allow_from": ["111"], "allowed_roles": ["2"]}})
+    load_gateway_config()
+    good = {name: (os.environ.get(name), os.environ.get(bridged_env_marker(name)))
+            for name in ("DISCORD_ALLOWED_USERS", "DISCORD_ALLOWED_ROLES")}
+    assert good["DISCORD_ALLOWED_USERS"][0] == "111" and good["DISCORD_ALLOWED_ROLES"][0] == "2"
+    # The Discord list bridges, then the boolean ``telegram:`` block raises later in the same YAML stage.
+    _write(home, {"discord": {"allow_from": ["222"]}, "require_mention": True, "telegram": True})
+    load_gateway_config()
+    assert {name: (os.environ.get(name), os.environ.get(bridged_env_marker(name))) for name in good} == good
diff --git a/tests/scripts/install/test_windows_appinstaller_loopback.py b/tests/scripts/install/test_windows_appinstaller_loopback.py
new file mode 100644
index 0000000000..938c6b3e3f
--- /dev/null
+++ b/tests/scripts/install/test_windows_appinstaller_loopback.py
@@ -0,0 +1,74 @@
+"""The Windows update leg exempts App Installer from loopback isolation only for itself.
+
+On the windows-2025 runner, App Installer 1.26 fetched the leg's 127.0.0.1 feed from inside its
+AppContainer, failed with 0x80072efd, and showed "Cannot open app package. Reason: Error in parsing
+the app package." (rehearsals rc.1, rc.2 and rc.4 of v0.23.2). Reproduced on Windows 11 with App
+Installer 1.26.509; with the exemption the same descriptor opened the install prompt.
+"""
+import base64
+from pathlib import Path
+import shutil
+import subprocess
+
+import pytest
+
+pytestmark = pytest.mark.platforms("windows")
+HELPER = Path(__file__).resolve().parents[3] / "tests" / "install" / "e2e-assets" / "windows-appinstaller-loopback.ps1"
+FAMILY = "microsoft.desktopappinstaller_8wekyb3d8bbwe"
+
+# A function named like the executable shadows it, so the helper drives this fake exemption list.
+FAKE_CHECKNETISOLATION = r"""
+$global:exempt = [System.Collections.Generic.List[string]]::new()
+$global:calls = [System.Collections.Generic.List[string]]::new()
+$global:refuse = 'REFUSE'
+function CheckNetIsolation.exe {
+    $global:calls.Add($args -join ' ')
+    switch ($args[1]) {
+        '-s' { foreach ($name in $global:exempt) { '    Name: ' + $name } }
+        '-a' { if ($global:refuse -ne '-a') { $global:exempt.Add($args[2].Substring(3)) } }
+        '-d' { if ($global:refuse -ne '-d') { [void]$global:exempt.Remove($args[2].Substring(3)) } }
+    }
+}
+"""
+
+
+def _run(body: str, *, refuse: str = "") -> subprocess.CompletedProcess:
+    powershell = shutil.which("powershell")
+    assert powershell, "Windows PowerShell 5.1 is part of every supported Windows"
+    script = (FAKE_CHECKNETISOLATION.replace("REFUSE", refuse)
+              + body.replace("HELPER", str(HELPER)).replace("FAMILY", FAMILY))
+    encoded = base64.b64encode(script.encode("utf-16-le")).decode()
+    return subprocess.run([powershell, "-NoProfile", "-ExecutionPolicy", "Bypass", "-EncodedCommand", encoded],
+                          capture_output=True, text=True, timeout=60, check=False)
+
+
+def test_leg_adds_the_exemption_and_removes_only_its_own(tmp_path):
+    result = _run(r"""
+$added = & 'HELPER' -Action Add
+"added=$added exempt=$($global:exempt -join ',')"
+if ($added) { & 'HELPER' -Action Remove }
+"after=$($global:exempt -join ',')"
+$global:exempt.Add('FAMILY')
+$global:calls.Clear()
+$again = & 'HELPER' -Action Add
+"preexisting added=$again calls=$($global:calls.Count) exempt=$($global:exempt -join ',')"
+""")
+    assert result.returncode == 0, result.stdout + result.stderr
+    lines = [line.strip() for line in result.stdout.splitlines()]
+    assert f"added=True exempt={FAMILY}" in lines
+    assert "after=" in lines
+    # Someone else's exemption is reported as not ours, so the leg's teardown leaves it in place.
+    assert f"preexisting added=False calls=1 exempt={FAMILY}" in lines
+
+
+def test_leg_fails_when_the_exemption_does_not_take(tmp_path):
+    result = _run("& 'HELPER' -Action Add", refuse="-a")
+    assert result.returncode != 0
+    assert "Could not exempt App Installer from loopback isolation" in result.stdout + result.stderr
+
+
+def test_leg_fails_when_the_exemption_is_not_removed(tmp_path):
+    # Windows PowerShell 5.1 ignores a native command's exit code, so the helper re-reads the list.
+    result = _run("$global:exempt.Add('FAMILY'); & 'HELPER' -Action Remove", refuse="-d")
+    assert result.returncode != 0
+    assert "Could not remove App Installer's loopback exemption" in result.stdout + result.stderr
diff --git a/tests/tools/test_async_delegation_schema_once.py b/tests/tools/test_async_delegation_schema_once.py
new file mode 100644
index 0000000000..ba4c378541
--- /dev/null
+++ b/tests/tools/test_async_delegation_schema_once.py
@@ -0,0 +1,205 @@
+"""The async-delegation ledger reconciles state.db's schema once per database file, not per connection.
+
+``_connect`` opens a fresh short-lived connection for every ledger call, and its initializer replayed the
+whole canonical ``SCHEMA_SQL`` plus the column reconcile (~30 ``PRAGMA table_info``) each time. The orphan
+sweep runs every 30 s and calls ``_connect`` at least twice per pass (``recover_abandoned_delegations`` and
+``sweep_orphaned_completions``), so on a slow filesystem a field deployment saw this thread in two of three
+watchdog dumps. Reconciling once per (file identity, ``PRAGMA schema_version``) is enough for
+ordinary opens and DDL changes: a replacement file can share the old file's schema counter.
+After #135351 (its reconcile-once half).
+"""
+
+import os
+import sqlite3
+import time
+from contextlib import closing
+
+import pytest
+
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+from tools import async_delegation as ad
+
+
+@pytest.fixture(autouse=True)
+def home(tmp_path):
+    ad._reset_for_tests()
+    token = set_hermes_home_override(str(tmp_path))
+    yield tmp_path
+    reset_hermes_home_override(token)
+    ad._reset_for_tests()
+
+
+@pytest.fixture
+def reconcile_calls(monkeypatch):
+    import hermes_state_schema
+
+    calls = []
+    real = hermes_state_schema.reconcile_state_schema
+
+    def counting(conn):
+        calls.append(1)
+        return real(conn)
+
+    monkeypatch.setattr(hermes_state_schema, "reconcile_state_schema", counting)
+    return calls
+
+
+def _sweep_once():
+    ad.recover_abandoned_delegations()
+    ad.sweep_orphaned_completions(None, now=time.time())
+
+
+def test_repeated_orphan_sweeps_reconcile_the_schema_once(reconcile_calls):
+    for _ in range(4):
+        _sweep_once()
+    assert len(reconcile_calls) == 1
+
+
+def test_a_replaced_database_is_reconciled_again(home, reconcile_calls):
+    _sweep_once()
+    for suffix in ("", "-wal", "-shm", "-journal"):
+        (home / f"state.db{suffix}").unlink(missing_ok=True)
+    _sweep_once()
+    assert len(reconcile_calls) == 2
+    # ... and the ledger table really exists on the new file.
+    ad._persist_dispatch({"delegation_id": "d-1", "session_key": "", "origin_ui_session_id": "ui",
+                          "parent_session_id": "p", "dispatched_at": time.time()})
+    assert ad.get_durable_delegation("d-1") is not None
+
+
+def test_a_recreated_database_on_a_recycled_inode_still_gets_its_ledger(home, reconcile_calls):
+    """The filesystem may hand a recreated state.db the deleted file's inode, so no file-identity key can
+    tell the two apart; the schema_version header can (the fresh file reads 0)."""
+    _sweep_once()
+    for suffix in ("", "-wal", "-shm", "-journal"):
+        (home / f"state.db{suffix}").unlink(missing_ok=True)
+    (home / "state.db").touch()  # an empty file at the same path, whatever inode it got
+    ad._persist_dispatch({"delegation_id": "d-2", "session_key": "", "origin_ui_session_id": "ui",
+                          "parent_session_id": "p", "dispatched_at": time.time()})
+    assert ad.get_durable_delegation("d-2") is not None
+    assert len(reconcile_calls) == 2
+
+
+def test_a_restored_older_database_gets_its_missing_columns(home, reconcile_calls):
+    """A state.db swapped in from an older backup has the ledger table but not every column: its different
+    schema_version makes it reconcile again."""
+    import sqlite3
+    _sweep_once()
+    for suffix in ("", "-wal", "-shm", "-journal"):
+        (home / f"state.db{suffix}").unlink(missing_ok=True)
+    with sqlite3.connect(str(home / "state.db")) as old:
+        old.execute("CREATE TABLE async_delegations (delegation_id TEXT PRIMARY KEY)")
+    ad._persist_dispatch({"delegation_id": "d-3", "session_key": "", "origin_ui_session_id": "ui",
+                          "parent_session_id": "p", "dispatched_at": time.time()})
+    assert ad.get_durable_delegation("d-3") is not None
+
+
+def test_each_database_is_reconciled_on_its_own(tmp_path, reconcile_calls):
+    _sweep_once()
+    other = tmp_path / "other-home"
+    other.mkdir()
+    token = set_hermes_home_override(str(other))
+    try:
+        _sweep_once()
+        _sweep_once()
+    finally:
+        reset_hermes_home_override(token)
+    assert len(reconcile_calls) == 2
+
+
+@pytest.fixture
+def same_version_replacement(home):
+    with closing(ad._connect()) as conn:
+        version = conn.execute("PRAGMA schema_version").fetchone()[0]
+    replacement = home / "replacement.db"
+    with closing(sqlite3.connect(replacement)) as conn:
+        conn.execute("CREATE TABLE async_delegations (delegation_id TEXT PRIMARY KEY)")
+        # A DDL counter collision from ordinary migrations, not a forced PRAGMA value.
+        for i in range(version - 1):
+            conn.execute(f"CREATE TABLE historical_migration_{i} (id INTEGER)")
+        assert conn.execute("PRAGMA schema_version").fetchone()[0] == version
+    return replacement
+
+
+def _assert_dispatch_persisted():
+    ad._persist_dispatch({"delegation_id": "replacement", "session_key": "session",
+                          "dispatched_at": time.time()})
+    row = ad.get_durable_delegation("replacement")
+    assert row is not None
+    assert row["origin_session"] == "session"
+
+
+def test_same_version_replacement_gets_missing_columns(home, reconcile_calls, same_version_replacement):
+    os.replace(same_version_replacement, home / "state.db")
+    _assert_dispatch_persisted()
+    _sweep_once()
+    assert len(reconcile_calls) == 2
+
+
+@pytest.mark.parametrize("error", [FileNotFoundError, PermissionError])
+def test_unstatable_replacement_still_reconciles(home, same_version_replacement, monkeypatch, error):
+    os.replace(same_version_replacement, home / "state.db")
+    real_stat = os.stat
+
+    def failing_stat(path, *args, **kwargs):
+        if os.fspath(path) == str(home / "state.db"):
+            raise error("file identity unavailable")
+        return real_stat(path, *args, **kwargs)
+
+    monkeypatch.setattr(os, "stat", failing_stat)
+    _assert_dispatch_persisted()
+
+
+def test_replacement_between_stat_and_open_reconciles(home, same_version_replacement, monkeypatch):
+    from hermes_cli import sqlite_util
+
+    real_open = sqlite_util.open_db
+
+    def replacing_open(*args, **kwargs):
+        monkeypatch.setattr(sqlite_util, "open_db", real_open)
+        os.replace(same_version_replacement, home / "state.db")
+        return real_open(*args, **kwargs)
+
+    monkeypatch.setattr(sqlite_util, "open_db", replacing_open)
+    _assert_dispatch_persisted()
+
+
+@pytest.mark.platforms("posix")
+def test_replacement_during_reconcile_is_not_marked_ready(home, same_version_replacement, monkeypatch):
+    """The opened connection still refers to the old inode when its path is replaced."""
+    import hermes_state_schema
+
+    ad._SCHEMA_READY.clear()
+    real_reconcile = hermes_state_schema.reconcile_state_schema
+
+    def replacing_reconcile(conn):
+        real_reconcile(conn)
+        os.replace(same_version_replacement, home / "state.db")
+
+    with monkeypatch.context() as patch:
+        patch.setattr(hermes_state_schema, "reconcile_state_schema", replacing_reconcile)
+        ad._connect().close()
+    _assert_dispatch_persisted()
+
+
+@pytest.mark.parametrize("database", [":memory:", ""])
+def test_unnamed_databases_always_reconcile(database, reconcile_calls):
+    for _ in range(2):
+        with closing(sqlite3.connect(database)) as conn:
+            ad._initialize_schema(conn)
+            conn.execute("SELECT origin_session FROM async_delegations")
+    assert len(reconcile_calls) == 2
+
+
+def test_data_writes_do_not_reconcile_again(reconcile_calls):
+    for _ in range(3):
+        _assert_dispatch_persisted()
+    assert len(reconcile_calls) == 1
+
+
+def test_same_file_schema_changes_reconcile_again(home, reconcile_calls):
+    _sweep_once()
+    with closing(sqlite3.connect(home / "state.db")) as conn:
+        conn.execute("DROP TABLE async_delegations")
+    _assert_dispatch_persisted()
+    assert len(reconcile_calls) == 2
