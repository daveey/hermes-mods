@@ -0,0 +1,125 @@
+"""Dispatch gates and the claim must agree on the assignee (#147534).
+
+The dispatcher gates (``kanban.dispatch_profiles`` allowlist, profile existence,
+per-profile cap) run against the assignee read at tick start. A reassignment
+landing between those gates and the claim must not spawn a worker as the new,
+never-vetted profile: the claim loses and the next tick gates the new assignee.
+"""
+from __future__ import annotations
+
+import json
+import sqlite3
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_default_assignee as kbda
+from hermes_cli import kanban_db_dispatch as kbd
+
+
+@pytest.fixture
+def kanban_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    (home / "config.yaml").write_text(
+        "kanban:\n  dispatch_profiles: [worker-a]\n", encoding="utf-8",
+    )
+    kb.init_db()
+    return home
+
+
+@pytest.mark.parametrize("lane", ["ready", "review"])
+def test_reassign_inside_claim_window_does_not_spawn_unvetted_profile(
+    kanban_home, all_assignees_spawnable, monkeypatch, lane,
+):
+    spawned_as: list[str] = []
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="card", assignee="worker-a")
+        if lane == "review":
+            with kb.write_txn(conn):
+                conn.execute("UPDATE tasks SET status = 'review' WHERE id = ?", (tid,))
+        real_guard = kbd.check_respawn_guard
+
+        def guard_then_reassign(c, task_id, **kw):
+            # Last gate before the claim: an operator reassigns the card right now.
+            reason = real_guard(c, task_id, **kw)
+            with kbc.connect() as other:
+                kb.assign_task(other, task_id, "worker-b")
+            return reason
+
+        monkeypatch.setattr(kbd, "check_respawn_guard", guard_then_reassign)
+        res = kbd.dispatch_once(
+            conn, spawn_fn=lambda task, _ws: spawned_as.append(task.assignee) or 4242,
+        )
+        task = kb.get_task(conn, tid)
+        monkeypatch.setattr(kbd, "check_respawn_guard", real_guard)
+        nxt = kbd.dispatch_once(conn, spawn_fn=lambda task, _ws: spawned_as.append(task.assignee) or 4242)
+
+    assert task is not None
+    assert spawned_as == []
+    assert res.spawned == []
+    assert (task.status, task.assignee, task.claim_lock) == (lane, "worker-b", None)
+    # The next tick gates the card against its real assignee: not on the allowlist.
+    assert nxt.spawned == []
+    assert nxt.skipped_nonspawnable == [tid]
+
+
+def test_reassign_before_default_fill_does_not_log_phantom_assignment(
+    kanban_home, all_assignees_spawnable, monkeypatch,
+):
+    """A stale unassigned snapshot must not overwrite a real reassignment in the audit log."""
+    spawned_as: list[str] = []
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="unassigned", assignee=None)
+        real_apply = kbda.apply_default_assignee
+
+        def assign_before_default(c, task_id, assignee, *, dry_run):
+            # The operator assigns the card after the tick read it as unassigned.
+            with kbc.connect() as other:
+                kb.assign_task(other, task_id, "worker-b")
+            return real_apply(c, task_id, assignee, dry_run=dry_run)
+
+        monkeypatch.setattr(kbda, "apply_default_assignee", assign_before_default)
+        res = kbd.dispatch_once(
+            conn, default_assignee="worker-a",
+            spawn_fn=lambda task, _ws: spawned_as.append(task.assignee) or 4242,
+        )
+        task = kb.get_task(conn, tid)
+        assigned_payloads = [
+            json.loads(r["payload"])
+            for r in conn.execute(
+                "SELECT payload FROM task_events WHERE task_id = ? AND kind = 'assigned' ORDER BY id",
+                (tid,),
+            ).fetchall()
+        ]
+
+    assert task is not None
+    assert (task.status, task.assignee, task.claim_lock) == ("ready", "worker-b", None)
+    assert spawned_as == []
+    assert res.spawned == []
+    assert res.auto_assigned_default == []
+    assert res.skipped_unassigned == []
+    assert assigned_payloads == [{"assignee": "worker-b", "from": None}]
+
+
+def test_failed_default_fill_write_still_buckets_unassigned(
+    kanban_home, all_assignees_spawnable, monkeypatch,
+):
+    """A fill-in whose write failed (no concurrent assign) keeps the card visible as unassigned."""
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="unassigned", assignee=None)
+
+        def boom(*_a, **_k):
+            raise sqlite3.OperationalError("disk I/O error")
+
+        monkeypatch.setattr(kb, "_append_event", boom)
+        res = kbd.dispatch_once(conn, default_assignee="worker-a", spawn_fn=lambda task, _ws: 4242)
+        task = kb.get_task(conn, tid)
+
+    assert task is not None and not task.assignee  # the failed txn rolled the UPDATE back
+    assert res.skipped_unassigned == [tid]
+    assert (res.auto_assigned_default, res.spawned) == ([], [])
diff --git a/tests/hermes_cli/test_launchd_plist_path_staleness.py b/tests/hermes_cli/test_launchd_plist_path_staleness.py
new file mode 100644
index 0000000000..5e6078444c
--- /dev/null
+++ b/tests/hermes_cli/test_launchd_plist_path_staleness.py
@@ -0,0 +1,135 @@
+"""The launchd staleness check must see the Hermes-owned PATH prefix.
+
+A pm-managed Node bump rewrites the store dir the generated plist pins, but
+``_normalize_launchd_plist_for_comparison`` blanked the whole PATH payload before comparing, so an
+installed plist that still pointed at the OLD Node tree kept passing the check: ``gateway status``
+reported "Service definition matches the current Hermes install", ``gateway install`` refused without
+``--force``, and ``refresh_launchd_plist_if_needed()`` never rewrote the plist — leaving the
+long-running gateway (the process that fetches arbitrary URLs) on the previous Node binary (#144735).
+
+The masking still has a reason to exist: the PATH tail is whatever shell ran ``hermes gateway
+install``, and that must not flag a plist as stale. So these tests pin BOTH halves: the deterministic
+Hermes-owned prefix is compared, the shell tail is not.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+
+from hermes_cli import gateway as gateway_cli
+
+
+def _seed_managed_node(home, version: str) -> str:
+    """Record a pm-managed Node version the way ``pm install`` writes ``facts.json``.
+
+    ``_append_node_dir_for_service`` resolves the Node dir through ``Facts.env_for`` against the
+    target home's store (``{{store}}`` templates), so the record — not the test's PATH — decides what
+    the generated definition pins.
+    """
+    store = home / "tools"
+    entry = f"node-{version}-darwin-arm64"
+    node_dir = store / entry
+    node_dir.mkdir(parents=True)
+    facts = {
+        "schema": 1,
+        "packages": {"node": {"entry": entry, "version": version, "env": {"PATH": [f"{{{{store}}}}/{entry}"]}}},
+    }
+    (store / "facts.json").write_text(json.dumps(facts), encoding="utf-8")
+    return str(node_dir)
+
+
+def _install_plist(monkeypatch, tmp_path, home) -> tuple:
+    """Write the plist a ``gateway install`` would leave behind for the current managed Node."""
+    plist_path = tmp_path / "ai.hermes.gateway.plist"
+    monkeypatch.setattr(gateway_cli, "get_launchd_plist_path", lambda: plist_path)
+    plist_path.write_text(gateway_cli.generate_launchd_plist(), encoding="utf-8")
+    return plist_path, plist_path.read_text(encoding="utf-8")
+
+
+def test_a_managed_node_bump_makes_the_installed_plist_stale(monkeypatch, tmp_path):
+    """The pm-managed Node dir is part of the generated definition, so a bump must flag the plist."""
+    home = tmp_path / "hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    bin_dir = home / "node_modules" / ".bin"  # a service bin dir ahead of Node: the prefix count must decide
+    bin_dir.mkdir(parents=True)
+    old_dir = _seed_managed_node(home, "26.7.0")
+    _, installed = _install_plist(monkeypatch, tmp_path, home)
+    assert f"{bin_dir}:{old_dir}:" in installed
+    assert gateway_cli.launchd_plist_is_current() is True
+
+    new_dir = _seed_managed_node(home, "26.12.1")
+
+    assert gateway_cli.launchd_plist_is_current() is False
+    refreshed = gateway_cli.generate_launchd_plist()
+    assert new_dir in refreshed
+    assert old_dir not in refreshed
+
+
+def test_a_changed_shell_path_does_not_flag_the_installed_plist(monkeypatch, tmp_path):
+    """The PATH tail is the invoking shell's; a different shell must not report a stale service."""
+    home = tmp_path / "hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    _seed_managed_node(home, "26.7.0")
+    _install_plist(monkeypatch, tmp_path, home)
+    assert gateway_cli.launchd_plist_is_current() is True
+
+    monkeypatch.setenv("PATH", f"{tmp_path / 'somewhere-else' / 'bin'}:/usr/bin:/bin")
+
+    assert gateway_cli.launchd_plist_is_current() is True
+
+
+def test_an_installed_plist_without_the_managed_node_dir_is_stale(monkeypatch, tmp_path):
+    """A definition written before pm recorded Node pins no store dir; that is drift, not a match."""
+    home = tmp_path / "hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    node_dir = _seed_managed_node(home, "26.7.0")
+    plist_path, installed = _install_plist(monkeypatch, tmp_path, home)
+    assert node_dir in installed
+
+    # Stand-in for a definition generated before the store Node was recorded (or by another install):
+    # the same plist with the managed dir dropped from its PATH.
+    plist_path.write_text(installed.replace(f"{node_dir}:", "", 1), encoding="utf-8")
+
+    assert gateway_cli.launchd_plist_is_current() is False
+
+
+def test_removing_managed_node_makes_installed_plist_stale(monkeypatch, tmp_path):
+    """Removing the pm Node record must not hide a still-installed old Node in the PATH tail."""
+    home = tmp_path / "hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    old_dir = _seed_managed_node(home, "26.7.0")
+    _, installed = _install_plist(monkeypatch, tmp_path, home)
+    assert old_dir in installed
+    assert gateway_cli.launchd_plist_is_current() is True
+
+    # PM forgets Node, while the old download remains on disk: a shorter prefix.
+    (home / "tools" / "facts.json").write_text(
+        json.dumps({"schema": 1, "packages": {}}), encoding="utf-8"
+    )
+    assert old_dir not in gateway_cli.generate_launchd_plist()
+    assert gateway_cli.launchd_plist_is_current() is False
+
+
+def test_a_refresh_from_the_gateway_env_does_not_keep_the_superseded_node(monkeypatch, tmp_path):
+    """A refresh run inside the gateway inherits the installed plist's PATH; after a Node bump the
+    rewritten plist must not carry the old store Node, or the user's shell then reports it stale."""
+    home = tmp_path / "hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("PATH", "/usr/bin:/bin")
+    old_dir = _seed_managed_node(home, "26.7.0")
+    plist_path, installed = _install_plist(monkeypatch, tmp_path, home)
+
+    monkeypatch.setenv("PATH", re.search(r"<key>PATH</key>\s*<string>(.*?)</string>", installed, re.DOTALL).group(1))
+    _seed_managed_node(home, "26.12.1")
+    assert gateway_cli.launchd_plist_is_current() is False
+    plist_path.write_text(gateway_cli.generate_launchd_plist(), encoding="utf-8")
+    assert old_dir not in plist_path.read_text(encoding="utf-8")
+
+    monkeypatch.setenv("PATH", "/usr/bin:/bin")
+    assert gateway_cli.launchd_plist_is_current() is True
