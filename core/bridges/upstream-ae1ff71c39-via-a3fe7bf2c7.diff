index 0000000000..deb17c66b6
--- /dev/null
+++ b/tests/gateway/test_session_list_cursor.py
@@ -0,0 +1,130 @@
+"""``session.list``'s stored scope pages with ``cursor`` / ``next_cursor`` and filters by ``query`` (#141982)."""
+import base64
+import json
+from contextlib import asynccontextmanager
+from types import SimpleNamespace
+
+import pytest
+
+
+@asynccontextmanager
+async def _stored(tmp_path, monkeypatch, rows, cwd=None):
+    """A native reader over old local rows *rows*: ``(id, title, offered)``, oldest first. A row that is not
+    offered belongs to another profile, so the stored listing reads it from storage and skips it.
+    *cwd*: the folder the rows ran in (default: *tmp_path*)."""
+    from gateway import run
+    from gateway.config import GatewayConfig
+    from gateway.session import SessionStore
+    from gateway.session_authority import initialize_session_authority
+    from gateway.session_controls import AuthorityConnection
+
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setattr(run, '_load_gateway_config', lambda: {'platform_toolsets': {'cli': []}})
+    store = SessionStore(tmp_path / 'sessions', GatewayConfig())
+    db = store._db
+    for sid, title, offered in rows:
+        db.create_session(sid, source='cli', model='m', cwd=cwd or str(tmp_path),
+                          profile_name=None if offered else 'other')
+        if title:
+            db.set_session_title(sid, title)
+        db.append_message(sid, 'user', f'{sid} question')
+        db.end_session(sid, 'cli_exit')
+    runner = SimpleNamespace(session_store=store, _session_db=db, adapters={}, _draining=False,
+                             _cached_agent_for=lambda route: None)
+    runner._adapter_for_source = lambda source: runner.adapters.get(source.platform)
+    authority = await initialize_session_authority(runner, profile_id=str(tmp_path), instance_id='owner')
+    native = AuthorityConnection(authority, object(), {'provider': 'local', 'user_id': 'native',
+        'profile_id': str(tmp_path), 'instance_id': 'owner'})
+
+    async def listing(**params):
+        return await native.dispatch({'id': 1, 'method': 'session.list', 'params': params})
+    try:
+        yield listing
+    finally:
+        await native.close()
+        store.close_all_db_handles()
+
+
+async def _follow(listing, **params):
+    """Every page of a stored listing, following ``next_cursor`` until it is null."""
+    pages, cursor = [], None
+    while True:
+        reply = await listing(scope='stored', **params, **({'cursor': cursor} if cursor else {}))
+        assert 'result' in reply, reply
+        pages.append([row['id'] for row in reply['result']['sessions']])
+        cursor = reply['result']['next_cursor']
+        if cursor is None:
+            return pages
+        assert len(pages) < 100
+
+
+@pytest.mark.asyncio
+async def test_following_next_cursor_lists_every_conversation_once_in_order(tmp_path, monkeypatch):
+    # Every third storage row is skipped, and the rows span more than one 200-row storage batch.
+    rows = [(f's{n:03}', None, n % 3 != 1) for n in range(240)]
+    async with _stored(tmp_path, monkeypatch, rows) as listing:
+        whole = (await listing(scope='stored'))['result']
+        assert whole['next_cursor'] is None
+        unpaged = [row['id'] for row in whole['sessions']]
+        assert len(unpaged) == 160
+        pages = await _follow(listing, limit=7)
+        assert all(len(page) == 7 for page in pages[:-1])
+        assert [sid for page in pages for sid in page] == unpaged
+
+
+@pytest.mark.asyncio
+async def test_query_lists_only_matching_titles_and_pages_with_its_own_cursor(tmp_path, monkeypatch):
+    rows = [(f'old{n}', f'needle notes {n}', True) for n in range(3)]
+    rows += [(f'mid{n}', f'skip me needle {n}', False) for n in range(2)]
+    rows += [(f'new{n:02}', f'chat {n}', True) for n in range(12)]
+    async with _stored(tmp_path, monkeypatch, rows) as listing:
+        first = (await listing(scope='stored', limit=5))['result']
+        assert not {'old0', 'old1', 'old2'} & {row['id'] for row in first['sessions']}
+        pages = await _follow(listing, query='needle', limit=2)
+        assert sorted(sid for page in pages for sid in page) == ['old0', 'old1', 'old2']
+        assert len(pages) == 2
+        assert (await listing(scope='stored', query='no such title'))['result'] == {
+            'sessions': [], 'scope': 'stored', 'next_cursor': None}
+
+
+@pytest.mark.asyncio
+async def test_a_cursor_continues_a_listing_with_long_non_ascii_filters(tmp_path, monkeypatch):
+    # The longest title a session can have, in a script JSON escapes, in a deeply nested folder.
+    title = '\u4f1a\u8bdd\u6807\u9898' * 24
+    folder = str(tmp_path.joinpath(*['\u9879\u76ee' * 20] * 12))
+    rows = [(f'deep{n}', f'{title} {n}', True) for n in range(3)]
+    async with _stored(tmp_path, monkeypatch, rows, cwd=folder) as listing:
+        pages = await _follow(listing, query=title, workspace=folder, limit=1)
+        assert sorted(sid for page in pages for sid in page) == ['deep0', 'deep1', 'deep2']
+
+
+@pytest.mark.asyncio
+async def test_cursor_and_query_refusals(tmp_path, monkeypatch):
+    rows = [(f'needle{n}', f'needle {n}', True) for n in range(4)]
+    async with _stored(tmp_path, monkeypatch, rows) as listing:
+        page = (await listing(scope='stored', query='needle', limit=1))['result']
+        cursor = page['next_cursor']
+        assert isinstance(cursor, str)
+        assert 'result' in await listing(scope='stored', query='needle', limit=3, cursor=cursor)
+        # The same cursor with an offset no store can hold: refused like any cursor the method did not issue.
+        held = json.loads(base64.urlsafe_b64decode(cursor + '=' * (-len(cursor) % 4)))
+        held[1] = 2**63
+        too_large = base64.urlsafe_b64encode(json.dumps(held).encode()).decode().rstrip('=')
+        refused = [
+            {'scope': 'stored', 'query': 'other', 'cursor': cursor},
+            {'scope': 'stored', 'cursor': cursor},
+            {'scope': 'stored', 'query': 'needle', 'workspace': str(tmp_path / 'x'), 'cursor': cursor},
+            {'scope': 'stored', 'query': 'needle', 'include_hidden': True, 'cursor': cursor},
+            {'cursor': cursor},
+            {'scope': 'live', 'query': 'needle'},
+            {'query': 'needle'},
+            {'title': 'needle 1', 'query': 'needle'},
+            {'scope': 'stored', 'query': '   '},
+            {'scope': 'stored', 'query': 'x' * 201},
+            {'scope': 'stored', 'cursor': 'not a cursor'},
+            {'scope': 'stored', 'cursor': cursor[:-4]},
+            {'scope': 'stored', 'query': 'needle', 'cursor': too_large},
+        ]
+        for params in refused:
+            reply = await listing(**params)
+            assert reply['error']['data']['reason'] == 'invalid_params', (params, reply)
diff --git a/tests/gateway/test_stream_consumer_long_secret_holdback.py b/tests/gateway/test_stream_consumer_long_secret_holdback.py
new file mode 100644
index 0000000000..5e1af42ac0
--- /dev/null
+++ b/tests/gateway/test_stream_consumer_long_secret_holdback.py
@@ -0,0 +1,132 @@
+"""A credential value longer than any fixed scan window still never streams raw (#56039).
+
+AWS STS ``SessionToken`` values are 600-2000 base64 chars, and JSON ``api_key``/``client_secret``
+values can be as long. The hold for a labelled value must last from the label until the value
+ends, whatever its length, and the end-of-segment redaction must reach back to the label.
+"""
+
+import asyncio
+import random
+from itertools import pairwise
+from types import SimpleNamespace
+
+import pytest
+
+from agent.redact import redact_for_egress
+from gateway.platforms.base import BasePlatformAdapter
+from gateway.stream_consumer import GatewayStreamConsumer, StreamConsumerConfig
+from gateway.stream_consumer_redact import redact_settled
+from tests.waiting import async_wait_until
+
+_B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
+
+
+def _value(length: int, seed: int) -> str:
+    rnd = random.Random(seed)
+    return "".join(rnd.choice(_B64) for _ in range(length))
+
+
+def _sts(label: str, value: str) -> str:
+    return ('Temporary credentials:\n```json\n{\n  "Credentials": {\n'
+            f'    "{label}": "{value}",\n    "Expiration": "2026-11-12T12:00:00Z"\n  }}\n}}\n```\nDone.')
+
+
+def _deltas(text: str, seed: int) -> list[str]:
+    rnd, out, i = random.Random(seed), [], 0
+    while i < len(text):
+        k = rnd.randint(1, 4)
+        out.append(text[i:i + k])
+        i += k
+    return out
+
+
+def _raw_runs(texts, secret: str, width: int = 8) -> set[str]:
+    runs = {secret[i:i + width] for i in range(len(secret) - width + 1)}
+    return {r for r in runs for t in texts if r in t}
+
+
+_CASES = [(label, length) for label in ("Session" + "Token", "api_" + "key") for length in (1000, 2000)]
+
+
+@pytest.mark.parametrize(("label", "length"), _CASES)
+def test_long_labelled_value_streamed_in_small_deltas_never_settles_raw(label, length):
+    value = _value(length, seed=length)
+    text = _sts(label, value)
+    assert not _raw_runs([redact_for_egress(text)], value)  # the non-streamed send masks it
+    acc = prefix = ""
+    frames = []
+    for delta in _deltas(text, seed=length):
+        acc, settled = redact_settled(acc + delta, prefix, done=False)
+        prefix = acc[:settled]
+        frames.append(prefix)
+    final, _ = redact_settled(acc, prefix, done=True)
+    assert not _raw_runs(frames, value)
+    assert not _raw_runs([final], value)
+    assert all(later.startswith(earlier) for earlier, later in pairwise(frames))
+    assert final.startswith(frames[-1])
+
+
+def test_segment_end_redacts_a_value_longer_than_the_lookback_from_its_label():
+    value = _value(1500, seed=7)
+    text = 'Config:\n{"api_' + 'key": "' + value + '", "region": "us-east-1"}\nDone.'
+    head = text[:text.index(value) + 1200]  # settled up to deep inside the value
+    final, _ = redact_settled(text, head, done=True)
+    assert not _raw_runs([final], value)
+
+
+def _adapter(frames: list):
+    cls = type("ChatAdapter", (BasePlatformAdapter,), {"MAX_MESSAGE_LENGTH": 4000})
+    cls.__abstractmethods__ = frozenset()
+    adapter = cls.__new__(cls)
+    adapter._typing_paused = set()
+    adapter._fatal_error_message = None
+    ids = iter(f"m{i}" for i in range(1000))
+
+    async def send(**kw):
+        frames.append(kw["content"])
+        return SimpleNamespace(success=True, message_id=next(ids))
+
+    async def edit_message(**kw):
+        frames.append(kw["content"])
+        return SimpleNamespace(success=True, message_id=kw["message_id"])
+
+    adapter.send, adapter.edit_message = send, edit_message
+    return adapter
+
+
+@pytest.mark.asyncio
+async def test_long_session_token_is_never_shown_raw_by_the_consumer():
+    value = _value(1000, seed=11)
+    text = _sts("Session" + "Token", value)
+    frames = []
+    consumer = GatewayStreamConsumer(_adapter(frames), "chat", StreamConsumerConfig(
+        edit_interval=0.001, buffer_threshold=1, cursor=""))
+    drains = []
+    drain = consumer._drain_queue
+    consumer._drain_queue = lambda: (drains.append(None), drain())[1]
+    task = asyncio.create_task(consumer.run())
+    for i, delta in enumerate(_deltas(text, seed=11)):
+        consumer.on_delta(delta)
+        if i % 25 == 0:  # let a tick land while the value is still arriving
+            await async_wait_until(lambda: consumer._queue.empty(), timeout=5, what="delta drained")
+            seen = len(drains)
+            await async_wait_until(lambda: len(drains) > seen, timeout=5, what="tick done")
+    consumer.finish()
+    await task
+    assert frames
+    assert not _raw_runs(frames, value)
+
+
+def test_long_double_quoted_value_holding_an_apostrophe_never_settles_raw():
+    # The last quote on the line is the apostrophe, 600 chars past the label: the value's own
+    # opening quote must still anchor the label search.
+    value = _value(600, seed=5) + "'" + "bravo charlie delta"
+    text = 'Config:\n{"pass' + 'word": "' + value + '", "user": "bob"}\nDone.'
+    assert not _raw_runs([redact_for_egress(text)], value)
+    acc = prefix = ""
+    frames = []
+    for delta in _deltas(text, seed=5):
+        acc, settled = redact_settled(acc + delta, prefix, done=False)
+        prefix = acc[:settled]
+        frames.append(prefix)
+    assert not _raw_runs(frames, value)
diff --git a/tests/gateway/test_stream_consumer_secret_holdback.py b/tests/gateway/test_stream_consumer_secret_holdback.py
new file mode 100644
index 0000000000..aa309952be
--- /dev/null
+++ b/tests/gateway/test_stream_consumer_secret_holdback.py
@@ -0,0 +1,283 @@
+"""Streamed egress never emits text past the settled boundary (#56039).
+
+A secret still arriving — a key whose tail is in a later delta, ``Bearer`` before its token, a
+PEM block before its END — must not be sealed into a split head, cut by a splitter, or shown in a
+preview/draft frame, where a later re-mask cannot reach it. Assertions are on what the chat ends
+up showing per message (sends + edits replayed), and on every frame the transport received.
+"""
+
+import asyncio
+from itertools import pairwise
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.platforms.base import BasePlatformAdapter
+from gateway.stream_consumer import GatewayStreamConsumer, StreamConsumerConfig
+from tests.waiting import async_wait_until
+
+_BODY = "Q7mZ2xW9rT4kL8vB3nH6pD1sF5gJ0cY"
+_KEY = "sk-proj-" + _BODY
+_TOKEN = "Zq8vN3mK1pX7wL4tR9yB2cF6hJ0dS5gAxx"
+_AUTH = "Authorization: " + "Bearer "
+_PEM_LINES = ("MIIEpAIBAAKCAQEA1x2y3z4abcdefghijklmnopqrstuvwxyz0123456789ABCD",
+              "QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm0123456789ab",
+              "ZXCVBNMasdfghjklQWERTYUIOP0987654321zyxwvutsrqponmlkjihgfedcbaXY")
+_PEM_BEGIN, _PEM_END = "-----BEGIN RSA PRIVATE KEY-----", "-----END RSA PRIVATE KEY-----"
+
+
+def _adapter(**attrs):
+    cls = type("ChatAdapter", (BasePlatformAdapter,), {"MAX_MESSAGE_LENGTH": 1000})
+    cls.__abstractmethods__ = frozenset()
+    adapter = cls.__new__(cls)
+    adapter._typing_paused = set()
+    adapter._fatal_error_message = None
+    adapter.ops = []
+    ids = iter(f"m{i}" for i in range(100))
+
+    async def send(**kw):
+        adapter.ops.append(("send", next(ids), kw["content"]))
+        return SimpleNamespace(success=True, message_id=adapter.ops[-1][1])
+
+    async def edit_message(**kw):
+        adapter.ops.append(("edit", kw["message_id"], kw["content"]))
+        return SimpleNamespace(success=True, message_id=kw["message_id"])
+
+    adapter.send, adapter.edit_message = send, edit_message
+    for name, value in attrs.items():
+        setattr(adapter, name, value)
+    return adapter
+
+
+def _on_screen(adapter) -> dict[str, str]:
+    shown = {}
+    for _op, message_id, content in adapter.ops:
+        shown[message_id] = content
+    return shown
+
+
+async def _stream(adapter, *deltas: str, **cfg) -> None:
+    consumer = GatewayStreamConsumer(adapter, "chat", StreamConsumerConfig(
+        edit_interval=0.01, buffer_threshold=5, cursor="", **cfg))
+    drains = []
+    drain = consumer._drain_queue
+    consumer._drain_queue = lambda: (drains.append(None), drain())[1]
+    task = asyncio.create_task(consumer.run())
+    for delta in deltas:
+        # One delta per tick: the next drain after the one that took this delta starts only
+        # once that tick is over (a held delta reaches no wire, so the wire is no signal).
+        consumer.on_delta(delta)
+        await async_wait_until(lambda: consumer._queue.empty(), timeout=5, what="delta drained")
+        seen = len(drains)
+        await async_wait_until(lambda: len(drains) > seen, timeout=5, what="tick done")
+    consumer.finish()
+    await task
+
