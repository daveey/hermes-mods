+def _multiplexed_runner(tmp_path, homes):
+    config = GatewayConfig(sessions_dir=tmp_path / 'sessions')
+    config.multiplex_profiles = True
+    config._runtime_profile_homes = tuple(homes)
+    return GatewayRunner(config)
