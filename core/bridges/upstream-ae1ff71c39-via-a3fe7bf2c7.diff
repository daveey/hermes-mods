+@pytest.mark.asyncio
+@pytest.mark.parametrize("data", [{"name": "approve"}, {"name": "deny"}])
+async def test_an_unadmitted_discord_prompt_answer_still_reaches_the_runner(gateway, monkeypatch, data):
