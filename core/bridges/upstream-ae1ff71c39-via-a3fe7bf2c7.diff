+    env, runner = make_backend(backend)
+    noexec = _noexec_dir_or_skip()
+    try:
+        runner.temp_dir = noexec
+        runner.env["TMPDIR"] = str(noexec)
+        result = env.execute("sudo id -u && echo authed; cat", stdin_data="rest\n")
+        _wait_gone(noexec)
+    finally:
