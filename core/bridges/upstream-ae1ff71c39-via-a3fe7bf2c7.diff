+        assert active_session_registry_snapshot(tmp_path)[0]["lease_id"] == lease.lease_id
+        assert stat.S_IMODE(os.stat(registry).st_mode) == 0o640
+        assert stat.S_IMODE(os.stat(registry.parent).st_mode) == 0o750
+    finally:
