+        return waits === 1 ? pick.promise : new Promise(() => {})
+      }
+
+      return undefined
+    }
+  })
+  window.hermesDesktop = {
+    ...originalDesktop,
+    beginPreviewGuestActivity: async () => {
+      leases.add(++token)
+
+      return token
