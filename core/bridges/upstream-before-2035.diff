diff --git a/tests/hermes_state/test_transcript_handoff_rows_cost.py b/tests/hermes_state/test_transcript_handoff_rows_cost.py
new file mode 100644
index 00000000000..7134cc19a2b
--- /dev/null
+++ b/tests/hermes_state/test_transcript_handoff_rows_cost.py
@@ -0,0 +1,101 @@
+"""``SessionDB.transcript_handoff_rows`` looks its rows up in a fixed number of indexed reads, so its cost
+grows with the rows asked about, not with their product with the rows stored: a whole-lineage page asks
+about every row before its window. It finds what the one join it replaced found."""
+import json
+
+from agent.context_compressor import SUMMARY_PREFIX
+from hermes_state import SessionDB
+
+# The join the lookup replaced: each shown row, and every earlier row of the lineage with its message_uid,
+# that can hold a handoff.
+_ONE_JOIN = (
+    "SELECT w.id AS _shown_id, g.* FROM messages w JOIN messages g"
+    " ON g.session_id IN (SELECT value FROM json_each(:segments)) AND (g.id = w.id OR ("
+    "w.message_uid IS NOT NULL AND w.message_uid <> '' AND g.message_uid = w.message_uid AND g.id < w.id))"
+    " WHERE w.id IN (SELECT value FROM json_each(:shown)) AND g.role IN ('user', 'assistant')"
+    " AND (g._compressed_summary = 1 OR instr(g.content, '[CONTEXT COMPACTION') > 0"
+    " OR instr(g.content, '[CONTEXT SUMMARY]') > 0) ORDER BY w.id, g.id")
+
+
+def _steps(db, fn):
+    """``fn()`` and the thousands of SQLite VM steps it took on the snapshot's one connection."""
+    steps = [0]
+    with db.transcript_read_snapshot():
+        conn = db._pinned_read_conn()
+        conn.set_progress_handler(lambda: steps.__setitem__(0, steps[0] + 1) or 0, 1000)
+        try:
+            return fn(), steps[0]
+        finally:
+            conn.set_progress_handler(None, 0)
+
+
+def test_the_handoff_lookup_for_every_row_of_a_long_segment_stays_linear(tmp_path):
+    db = SessionDB(db_path=tmp_path / 'state.db')
+    try:
+        db.create_session('s', source='cli')
+        for i in range(1500):
+            db.append_message('s', 'user', f'question {i}')
+            db.append_message('s', 'assistant', f'answer {i}')
+        carrier = db.append_message('s', 'user', SUMMARY_PREFIX + ' what came before')
+        ids = [row['id'] for row in db._read_all("SELECT id FROM messages WHERE session_id = 's' ORDER BY id")]
+        found, steps = _steps(db, lambda: db.transcript_handoff_rows(ids, ['s']))
+        assert list(found) == [carrier] and [message['id'] for message in found[carrier]] == [carrier]
+        # About 0.4 thousand steps here; a lookup per shown row over the segment takes about 50 thousand.
+        assert steps < 3000, steps
+    finally:
+        db.close()
+
+
+def test_the_handoff_lookup_finds_what_one_join_over_the_shown_rows_found(tmp_path):
+    """Copies of a carrier in every state: live in an earlier segment, archived and removed in the tip, and
+    a later copy, which an earlier shown row never holds."""
+    db = SessionDB(db_path=tmp_path / 'state.db')
+    try:
+        db.create_session('root', source='cli')
+        db.create_session('tip', source='cli', parent_session_id='root')
+        rows = [('root', 'user', 'question', None, 1, 0), ('root', 'user', SUMMARY_PREFIX + ' one', 'U', 1, 0),
+                ('tip', 'user', SUMMARY_PREFIX + ' one, re-wrapped', 'U', 1, 0), ('tip', 'user', 'one, unwrapped', 'U', 1, 0),
+                ('tip', 'user', SUMMARY_PREFIX + ' two', 'V', 0, 1), ('tip', 'user', SUMMARY_PREFIX + ' two, removed', 'V', 0, 0),
+                ('tip', 'user', 'two, carried', 'V', 1, 0), ('tip', 'assistant', 'answer', None, 1, 0)]
+        ids = []
+        for session_id, role, content, uid, active, compacted in rows:
+            row_id = db.append_message(session_id, role, content)
+            db._execute_write(lambda conn, row_id=row_id, uid=uid, active=active, compacted=compacted: conn.execute(
+                'UPDATE messages SET message_uid = ?, active = ?, compacted = ? WHERE id = ?', (uid, active, compacted, row_id)))
+            ids.append(row_id)
+        for shown in (ids, ids[1:4], [ids[1]], ids[3:], [ids[6]]):
+            with db._read_ctx() as conn:
+                joined = conn.execute(_ONE_JOIN, {'segments': json.dumps(['root', 'tip']), 'shown': json.dumps(sorted(shown))}).fetchall()
+            expected = {}
+            for row in joined:
+                message = db._row_to_message_dict(row, warn_context='session.transcript', summary_flag=True)
+                expected.setdefault(int(message.pop('_shown_id')), []).append(message)
+            assert db.transcript_handoff_rows(shown, ['root', 'tip']) == expected, shown
+        assert [m['id'] for m in db.transcript_handoff_rows([ids[3]], ['root', 'tip'])[ids[3]]] == [ids[1], ids[2]]
+    finally:
+        db.close()
+
+
+def test_an_ordinary_shown_row_is_read_for_its_id_uid_and_flag_only(tmp_path):
+    """Only a shown row that can hold a handoff itself is read whole; every other shown row (a large image or
+    tool result included) is read for its id, uid and flag, so its body is not loaded a second time."""
+    db = SessionDB(db_path=tmp_path / 'state.db')
+    try:
+        db.create_session('s', source='cli')
+        plain = [db.append_message('s', 'user', 'x' * 200_000), db.append_message('s', 'assistant', 'answer')]
+        carrier = db.append_message('s', 'user', SUMMARY_PREFIX + ' what came before')
+        statements = []
+        with db.transcript_read_snapshot():
+            conn = db._pinned_read_conn()
+            conn.set_trace_callback(statements.append)
+            try:
+                found = db.transcript_handoff_rows([*plain, carrier], ['s'])
+            finally:
+                conn.set_trace_callback(None)
+        assert list(found) == [carrier] and [message['id'] for message in found[carrier]] == [carrier]
+        by_id = [sql for sql in statements if 'WHERE g.id IN' in sql]
+        # The shown rows' read carries no bodies; the one whole-row read by id names the carrier alone.
+        assert [sql for sql in by_id if 'g.*' not in sql] and [sql for sql in by_id if 'g.*' in sql], statements
+        assert all(f"json_each('{json.dumps([carrier])}')" in sql for sql in by_id if 'g.*' in sql), by_id
+    finally:
+        db.close()
diff --git a/tests/hermes_state/test_transcript_read_snapshot.py b/tests/hermes_state/test_transcript_read_snapshot.py
new file mode 100644
index 00000000000..6d8eefc2977
--- /dev/null
+++ b/tests/hermes_state/test_transcript_read_snapshot.py
@@ -0,0 +1,62 @@
+"""``SessionDB.transcript_read_snapshot``: every read inside sees one generation on a WAL store; a
+DELETE-journal store (reads go through the writer connection under the write lock) is not pinned, so a
+write from the same thread cannot wait on its own lock; there ``consistent()`` turns false once any write
+lands, this process's or another connection's."""
+import threading
+
+import hermes_yaml as yaml
+
+from hermes_state import SessionDB
+
+
+def _count(db):
+    return db._read_one("SELECT COUNT(*) FROM messages WHERE session_id = 's1'")[0]
+
+
+def test_reads_inside_a_snapshot_see_one_generation(tmp_path):
+    db = SessionDB(db_path=tmp_path / "state.db")
+    try:
+        assert db._wal_active
+        db.create_session("s1", source="cli")
+        db.append_message("s1", role="user", content="hello")
+        with db.transcript_read_snapshot() as consistent:
+            assert _count(db) == 1
+            db.append_message("s1", role="assistant", content="committed meanwhile")
+            assert _count(db) == 1  # the snapshot's generation
+            with db.transcript_read_snapshot() as inner:  # re-entrant: the same transaction
+                assert _count(db) == 1 and inner()
+            assert consistent()
+        assert _count(db) == 2
+    finally:
+        db.close()
+
+
+def test_a_delete_journal_store_is_not_pinned_and_any_write_makes_it_inconsistent(tmp_path, monkeypatch):
+    home = tmp_path / "hermes-home"
+    home.mkdir()
+    (home / "config.yaml").write_text(yaml.safe_dump({"database": {"journal_mode": "delete"}}), encoding="utf-8")
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    db = SessionDB(db_path=home / "state.db")
+    try:
+        assert db._wal_active is False
+        db.create_session("s1", source="cli")
+        done = []
+
+        other = SessionDB(db_path=home / "state.db")
+
+        def read_and_write():
+            with db.transcript_read_snapshot() as consistent:
+                done.append((consistent.pinned, consistent()))
+                db.append_message("s1", role="user", content="hello")
+                done.append((_count(db), consistent()))
+            with db.transcript_read_snapshot() as consistent:
+                assert consistent()
+                other.append_message("s1", role="assistant", content="from another connection")
+                done.append((_count(db), consistent()))
+        worker = threading.Thread(target=read_and_write, daemon=True)
+        worker.start()
+        worker.join(10)
+        assert done == [(False, True), (1, False), (2, False)]
+        other.close()
+    finally:
+        db.close()
diff --git a/tests/hermes_state/test_transcript_revision_trigger_skew.py b/tests/hermes_state/test_transcript_revision_trigger_skew.py
new file mode 100644
index 00000000000..95cd546b8fc
--- /dev/null
+++ b/tests/hermes_state/test_transcript_revision_trigger_skew.py
@@ -0,0 +1,52 @@
+"""``transcript_revision`` keeps moving on a reaction, a display rewrite and checkpoint pruning after an older
+Hermes opened the store (#150102 review). Every writable open runs its build's ``DEFERRED_INDEX_SQL`` through
+``_execute_ddl_skipping_settled_triggers``, which recreates a trigger whose stored body differs from the
+build's own. Every build since 1fc1999769 defines ``messages_transcript_revision_update`` with the content
+columns only, so the display columns live in a trigger of their own name that an older build never touches.
+"""
+from hermes_state import SessionDB
+
+# Verbatim from an older build's DEFERRED_INDEX_SQL (6b21d0564d): the pair its open runs for the shared name.
+OLDER_BUILD_DDL = """DROP TRIGGER IF EXISTS messages_transcript_revision_update;
+CREATE TRIGGER IF NOT EXISTS messages_transcript_revision_update
+AFTER UPDATE OF role, content, api_content, tool_calls, tool_call_id, tool_name, reasoning, reasoning_content,
+    reasoning_details ON messages
+BEGIN
+    -- An in-place rewrite (prompt expansion, multimodal context, a redaction) moves neither the
+    -- active row count nor the highest id; this write-side revision is what a transcript-derived
+    -- cache keys on (conversation_revision). Whoever wrote the row, old builds included.
+    UPDATE sessions SET transcript_revision = transcript_revision + 1 WHERE id = new.session_id;
+END;
+"""
+
+
+def open_as_older_build(db):
+    """What an older build's writable open does to this store's revision trigger, by its own DDL path.
+    Returns the statements it executed."""
+    executed = []
+    with db._lock:
+        db._conn.set_trace_callback(executed.append)
+        try:
+            SessionDB._execute_ddl_skipping_settled_triggers(db._conn.cursor(), OLDER_BUILD_DDL)
+        finally:
+            db._conn.set_trace_callback(None)
+    return executed
+
+
+def _revision(db, session_id):
+    return db._read_one("SELECT transcript_revision FROM sessions WHERE id = ?", (session_id,))[0]
+
+
+def test_a_reaction_moves_the_revision_after_an_older_build_opened_the_store(tmp_path):
+    db = SessionDB(db_path=tmp_path / "state.db")
+    try:
+        db.create_session("s", source="cli")
+        row = db.append_message("s", "assistant", "answer")
+        executed = open_as_older_build(db)
+        # Settled for the older build too: its open drops nothing, so it takes no write lock for it.
+        assert not [sql for sql in executed if sql.lstrip().upper().startswith("DROP TRIGGER")], executed
+        before = _revision(db, "s")
+        db.set_message_reaction("s", row, "\U0001f44d", author="user")
+        assert _revision(db, "s") > before
+    finally:
+        db.close()
