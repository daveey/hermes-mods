@@ -0,0 +1,60 @@
+"""A home the profile now points at can't answer for a turn its old home still holds.
+
+Fails on purpose: it shows the gap. The new home's "no session" answer is stubbed."""
+import asyncio
+import time
+
+from gateway import hosted_room_driver as tasks, hosted_rooms, session_hosted_transport as transport
+from gateway.session_group_controls import _disband
+from hermes_state_runtime import list_session_admissions
+from tests.gateway.test_session_hosted_transport import _SourceTask, _server
+
+
+def test_disband_keeps_a_turn_its_old_home_still_holds_after_a_remap(hosted_owner, tmp_path, monkeypatch):
+    authority, loop, _, _ = hosted_owner
+    home_a = tmp_path / 'profiles' / 'other'
+    home_a.mkdir(parents=True, mode=0o700)
+    home_b = tmp_path / 'elsewhere' / 'other'
+    home_b.mkdir(parents=True, mode=0o700)
+    authority.profile_id = str(home_a)
+    source = _SourceTask(tmp_path, monkeypatch, b'attachment')
+    service, runtime, db = source.service, source.service.runtime, source.db.db_path
+    runtime.prepare_room = runtime.publish_terminal = None
+    hosted_rooms.append_event(db, room_id='room', event_id='input', kind='message.user',
+        actor={'kind': 'user', 'id': 'alice'}, payload={'text': 'frozen'},
+        authority_gateway_id=source.gateway, authority_epoch=1)
+    servers = [_server(tmp_path), _server(home_a)]
+    transport.install_hosted_transport(servers[0], source.authority, loop, attest=service.attest)
+    transport.install_hosted_transport(servers[1], authority, loop, attest=lambda *a: None)
+    for server in servers:
+        assert asyncio.run_coroutine_threadsafe(server.start(), loop).result(10)
+    try:
+        binding = service.bindings()[0]
+        rpc = service._resolve_member_transport(binding, source.task)
+        sid = rpc.create(profile='other', source='bot_room', title='Group: room')['session_id']
+        rpc.submit(profile='other', source='bot_room', session_id=sid, prompt='frozen',
+                   task=source.identity, execution_generation=1, attachments=source.bound, on_terminal=None)
+        tasks.begin_task_cancel(db, source.identity, cancel_id='stop', expected_cancel_generation=0,
+                                clock=time.time)
+        with monkeypatch.context() as unanswered:
+            def no_answer(*_, **__):
+                raise TimeoutError('that gateway did not answer')
+            unanswered.setattr(transport, 'owner_request', no_answer)
+            now = time.time() + runtime.indeterminate_defer_seconds + 1
+            runtime.clock = lambda: now
+            runtime._retry_stopping_tasks(binding, runtime._ensure_lease(binding))
+        assert tasks.get_task(db, source.identity)['status'] == 'deferred'
+        # The profile now points at another home, whose daemon answers but holds no such session.
+        source.homes['other'] = str(home_b)
+        real = transport.HostedRoomOwnerRPC.resolve_exact
+        def resolve(self, **kw):
+            return None if str(self.home) == str(home_b) else real(self, **kw)
+        monkeypatch.setattr(transport.HostedRoomOwnerRPC, 'resolve_exact', resolve)
+        result = _disband(service, service, db, source.gateway, {'room_id': 'room'})
+        row, = list_session_admissions(authority.db, session_id=sid, pending_only=False)
+        assert 'tombstone' not in result or row['status'] == 'terminal', (
+            f"Disband finished while the old home still holds the turn: {row['status']}")
+    finally:
+        for server in servers:
+            asyncio.run_coroutine_threadsafe(server.stop(), loop).result(10)
+        source.db.close()
diff --git a/tests/gateway/test_hosted_room_policy_settle_race.py b/tests/gateway/test_hosted_room_policy_settle_race.py
new file mode 100644
index 00000000000..2b847a1684f
--- /dev/null
+++ b/tests/gateway/test_hosted_room_policy_settle_race.py
@@ -0,0 +1,64 @@
+"""A discussion's completion never ends a newer message on the same thread.
+
+When a member's reply lands, the room plans the next round. If the user sends a new
+message on that thread before the round settles, the settled status for the OLD
+discussion must not close the thread the newer message just reopened: the newer
+message would be silently dropped (the room shows idle and nobody answers).
+"""
+from gateway import hosted_rooms as rooms
+from gateway.hosted_room_policy_checkpoint import HostedRoomPolicyCheckpoint
+from gateway.hosted_room_router import paused_discussion
+
+
+def _append(db, event_id, kind, payload, actor="user"):
+    return rooms.append_event(db, room_id="room", event_id=event_id, kind=kind,
+        actor={"kind": actor, "id": "home"}, authority_gateway_id="home", authority_epoch=1, payload=payload)
+
+
+def test_old_discussion_settling_after_a_newer_message_keeps_the_newer_one_active(tmp_path):
+    db = tmp_path / "shared-state.db"
+    rooms.create_room(db, room_id="room", name="Room", authority_gateway_id="home",
+                      members=[{"member_id": "reviewer", "profile": "reviewer", "handle": "reviewer"}])
+    _append(db, "first", "message.user", {"text": "@reviewer one", "thread_id": "thread"})
+    newer = _append(db, "second", "message.user", {"text": "@reviewer two", "thread_id": "thread"})
+    # The first discussion's settle was planned before the second message, appended after it.
+    last = _append(db, "dactivity:first:silent_round", "room.activity", {
+        "status": "settled", "reason_code": "silent_round", "thread_id": "thread",
+        "discussion_event_id": "first"}, "gateway")
+    snapshot = HostedRoomPolicyCheckpoint(db).snapshot(room_id="room", latest_seq=int(last["seq"]))
+    # The thread stays open for the newer message (earlier messages ride along as its transcript).
+    assert any(e["seq"] == newer["seq"] for e in snapshot.events)
+
+
+def test_a_cap_notice_landing_after_a_newer_message_cannot_be_continued(tmp_path):
+    """Continue would hand the thread back to the capped discussion and strand the newer message."""
+    db = tmp_path / "shared-state.db"
+    rooms.create_room(db, room_id="room", name="Room", authority_gateway_id="home",
+                      members=[{"member_id": "reviewer", "profile": "reviewer", "handle": "reviewer"}])
+    _append(db, "first", "message.user", {"text": "@reviewer one", "thread_id": "thread"})
+    _append(db, "second", "message.user", {"text": "@reviewer two", "thread_id": "thread"})
+    _append(db, "dactivity:first:max_messages", "room.activity", {
+        "status": "bounded", "reason_code": "max_messages", "thread_id": "thread",
+        "discussion_event_id": "first"}, "gateway")
+    events = rooms.read_events(db, room_id="room")["events"]
+    assert paused_discussion(events, "first") is None
+
+
+def test_a_continue_an_older_build_wrote_after_a_newer_message_does_not_strand_it(tmp_path):
+    """Logs from before the router fence can hold that Continue; replaying it must not re-point the thread."""
+    db = tmp_path / "shared-state.db"
+    rooms.create_room(db, room_id="room", name="Room", authority_gateway_id="home",
+                      members=[{"member_id": "reviewer", "profile": "reviewer", "handle": "reviewer"}])
+    _append(db, "first", "message.user", {"text": "@reviewer one", "thread_id": "thread"})
+    _append(db, "second", "message.user", {"text": "@reviewer two", "thread_id": "thread"})
+    _append(db, "dactivity:first:max_messages", "room.activity", {
+        "status": "bounded", "reason_code": "max_messages", "thread_id": "thread",
+        "discussion_event_id": "first"}, "gateway")
+    _append(db, "dcontinue:first:1", "room.continued",
+            {"discussion_event_id": "first", "thread_id": "thread", "grant": 1}, "gateway")
+    _append(db, "dactivity:second:silent_round", "room.activity", {
+        "status": "settled", "reason_code": "silent_round", "thread_id": "thread",
+        "discussion_event_id": "second"}, "gateway")
+    other = _append(db, "third", "message.user", {"text": "@reviewer other", "thread_id": "other"})
+    snapshot = HostedRoomPolicyCheckpoint(db).snapshot(room_id="room", latest_seq=int(other["seq"]))
+    assert {(e.get("payload") or {}).get("thread_id") for e in snapshot.events} == {"other"}
diff --git a/tests/gateway/test_hosted_room_unknown_member_home_refusal.py b/tests/gateway/test_hosted_room_unknown_member_home_refusal.py
