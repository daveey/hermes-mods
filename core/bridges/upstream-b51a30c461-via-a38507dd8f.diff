+    bomb = gzip.compress(b" " * (64 * 1024 * 1024))
+
+    class _Wire(httpx.SyncByteStream):  # an unread body, as the network hands it over
+        def __init__(self, raw: bytes):
+            self.raw = raw
+
+        def __iter__(self):
+            yield self.raw
+
