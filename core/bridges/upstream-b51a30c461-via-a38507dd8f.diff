+platforms: [macos, linux]
+known_issues:
+  - "Guildhall is proven headlessly; live-client acceptance results are recorded in docs/INGAME-CHECKLIST.md and some lines may still read NOT RUN."
+  - "A solo /reload empties Guildhall's in-memory record log until guild sync re-converges from online guildmates (tracked as T-050 in the repo)."
+capabilities:
+  provides_tools: [wow_env, wow_api, wow_check, wow_test, wow_errors, wow_savedvars, wow_install, wow_bridge, wow_new]
+  provides_hooks: []
+  provides_middleware: []
+  requires_env: []
