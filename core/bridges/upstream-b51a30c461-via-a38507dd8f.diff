+    )
+  })
+
+  test('refuses literal private destinations without any DNS call', async () => {
+    let lookupRan = false
+
+    const tracking = async (host: string) => {
+      lookupRan = true
+
+      return [{ address: '93.184.216.34', family: 4 }]
