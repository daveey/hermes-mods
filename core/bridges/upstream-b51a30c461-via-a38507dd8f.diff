new file mode 100644
index 0000000000000000000000000000000000000000..c5f61c940981faea316870b2438e911a8b3bd303
--- /dev/null
+++ b/tests/gateway/test_mattermost_inbound_attachments.py
@@ -0,0 +1,124 @@
+"""Inbound Mattermost attachments: fetched only for authorized senders, read under the media cap.
+
+Drives the real adapter against a fake Mattermost REST API on 127.0.0.1 with the real
+GatewayRunner authorization callback wired as startup wires it.
+"""
+import json
+import os
+from pathlib import Path
+
+import aiohttp
+import pytest
+import pytest_asyncio
+from aiohttp import web
+
+from gateway.config import GatewayConfig, Platform, PlatformConfig
+
+OWNER, STRANGER = "owner_user", "stranger_user"
+
+
+@pytest_asyncio.fixture
+async def mattermost(tmp_path, monkeypatch):
+    from gateway.pairing import PairingStore
+    from gateway.run import GatewayRunner
+    from plugins.platforms.mattermost.adapter import MattermostAdapter
+
+    for key in ("GATEWAY_ALLOWED_USERS", "GATEWAY_ALLOW_ALL_USERS", "MATTERMOST_ALLOW_ALL_USERS"):
+        monkeypatch.delenv(key, raising=False)
+    monkeypatch.setenv("MATTERMOST_ALLOWED_USERS", OWNER)
+    monkeypatch.setattr("gateway.pairing.PAIRING_DIR", tmp_path / "pairing")
+
+    sizes, hits = {}, []
+
+    async def info(request):
+        hits.append(request.path)
+        return web.json_response({"name": f"{request.match_info['fid']}.pdf", "mime_type": "application/pdf"})
+
+    async def body(request):
+        hits.append(request.path)
+        resp = web.StreamResponse()  # chunked, so no Content-Length can be rejected up front
+        await resp.prepare(request)
+        remaining = sizes[request.match_info["fid"]]
+        try:
+            while remaining > 0:
+                await resp.write(b"x" * min(65536, remaining))
+                remaining -= 65536
+        except (ConnectionResetError, aiohttp.ClientConnectionResetError):
+            pass
+        return resp
+
+    app = web.Application()
+    app.router.add_get("/api/v4/files/{fid}/info", info)
+    app.router.add_get("/api/v4/files/{fid}", body)
+    server = web.AppRunner(app)
+    await server.setup()
+    site = web.TCPSite(server, "127.0.0.1", 0)
+    await site.start()
+    port = site._server.sockets[0].getsockname()[1]
+
+    adapter = MattermostAdapter(PlatformConfig(enabled=True, token="t", extra={"url": f"http://127.0.0.1:{port}"}))
+    adapter._bot_user_id = "bot"
+    adapter._session = aiohttp.ClientSession()
+    runner = object.__new__(GatewayRunner)
+    runner.config = GatewayConfig(platforms={Platform.MATTERMOST: adapter.config})
+    runner.adapters = {Platform.MATTERMOST: adapter}
+    runner.pairing_store = PairingStore()
+    adapter.set_authorization_check(runner._make_adapter_auth_check(Platform.MATTERMOST))
+    events = []
+
+    async def capture(event):
+        events.append(event)
+    adapter.handle_message = capture
+
+    async def dm(post_id, user_id, file_sizes, props=None):
+        sizes.update(file_sizes)
+        post = {"id": post_id, "user_id": user_id, "channel_id": "dm_chan", "message": "see attached",
+                "file_ids": list(file_sizes), "props": props or {}}
+        await adapter._handle_ws_event({"event": "posted", "data": {
+            "channel_type": "D", "sender_name": "@someone", "post": json.dumps(post)}})
+        return events[-1]
+
+    yield dm, hits
+    await adapter._session.close()
+    await server.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_attachments_are_fetched_only_for_authorized_senders(mattermost):
+    dm, hits = mattermost
+
+    denied = await dm("p1", STRANGER, {"stranger_doc": 1024})
+    assert hits == []
+    assert denied.media_urls == []
+    assert denied.source.user_id == STRANGER  # still dispatched so the runner can deny/pair
+
+    allowed = await dm("p2", OWNER, {"owner_doc": 1024})
+    assert len(allowed.media_urls) == 1
+    assert Path(allowed.media_urls[0]).stat().st_size == 1024
+
+
+@pytest.mark.asyncio
+async def test_bot_admitted_by_allow_bots_keeps_its_attachments(mattermost, monkeypatch):
+    monkeypatch.setenv("MATTERMOST_ALLOW_BOTS", "all")
+    dm, hits = mattermost
+
+    event = await dm("p4", "peer_bot", {"bot_doc": 1024}, props={"from_bot": "true"})
+
+    assert event.source.is_bot
+    assert len(event.media_urls) == 1
+    assert hits
+
+
+@pytest.mark.asyncio
+async def test_attachment_body_is_read_under_inbound_media_cap(mattermost):
+    from gateway.platforms.base import get_document_cache_dir, get_inbound_media_max_bytes
+
+    Path(os.environ["HERMES_HOME"], "config.yaml").write_text("gateway:\n  max_inbound_media_bytes: 1048576\n")
+    cap = get_inbound_media_max_bytes()
+    assert cap == 1048576
+    dm, _hits = mattermost
+
+    event = await dm("p3", OWNER, {"huge_doc": 4 * cap})
+
+    assert event.media_urls == []
+    assert all(p.stat().st_size <= cap for p in get_document_cache_dir().iterdir())
diff --git a/tests/gateway/test_mirror_bare_target_general.py b/tests/gateway/test_mirror_bare_target_general.py
new file mode 100644
index 0000000000000000000000000000000000000000..1c731be058e0e04331fd76fd10f8d760584a41b6
--- /dev/null
+++ b/tests/gateway/test_mirror_bare_target_general.py
@@ -0,0 +1,146 @@
+"""A bare (thread-less) group target mirrors into the General room, not the newest room.
+
+Reported on a live install, 2026-10-17 (reproduced 2×): ``hermes send -t telegram:<group> ...``
+(a bare target = the chat's General room, thread 1) delivered fine, but its delivery-mirror
+landed in the NEWEST-STARTED live thread session of the chat — thread 95 — instead of the
+General session (thread 1). The General agent then never saw the outgoing ask in context, so
+later text replies could be mis-mapped to the wrong room's question.
+
+Root cause: ``_find_session_id`` passed ``thread_id=None`` straight to
+``find_session_by_origin``, whose thread-less scan has no thread filter and returns
+``rows[0]`` ordered ``started_at DESC``. Its multi-user refusal only fires when several
+distinct users exist, so a single-user threaded chat resolved to its newest room.
+
+The fix: a bare target probes thread "1" (General) first, then the flat session "";
+neither → None (drop the mirror rather than guess). Both lookup paths — state.db and the
+sessions.json pre-migration fallback — take the same probes, so the fallback cannot
+regress on its own.
+"""
+
+import json
+from unittest.mock import patch
+
+import pytest
+
+import gateway.mirror as mirror_mod
+from gateway.mirror import _find_session_id, mirror_to_session
+from hermes_state import SessionDB
+
+CHAT = "-1001"  # the reported shape: a Telegram forum group
+
+
+def _thread_session(db, session_id, thread_id, *, user_id="u1"):
+    db.create_session(
+        session_id, "telegram", user_id=user_id,
+        session_key=f"agent:main:telegram:forum:{CHAT}:{user_id}:{thread_id}",
+        chat_id=CHAT, chat_type="forum", thread_id=thread_id,
+    )
+
+
+@pytest.fixture()
+def db(tmp_path):
+    session_db = SessionDB(db_path=tmp_path / "state.db")
+    yield session_db
+    session_db.close()
+
+
+@pytest.fixture()
+def wired(db, tmp_path):
+    """Point mirror's lookups at the tmp SessionDB; the sessions.json fallback stays absent."""
+    with patch("hermes_state_registry.acquire", return_value=db), \
+         patch("hermes_state_registry.release_or_close"), \
+         patch.object(mirror_mod, "_SESSIONS_INDEX", tmp_path / "sessions" / "sessions.json"):
+        yield db
+
+
+def test_bare_target_resolves_to_general_not_newest_room(wired):
+    """The reported bug: General (thread 1) is live, thread 95 started later."""
+    _thread_session(wired, "sess-general", "1")
+    _thread_session(wired, "sess-newer", "95")
+
+    assert _find_session_id("telegram", CHAT) == "sess-general"
+
+
+def test_bare_target_mirror_lands_in_general(wired):
+    """End to end: the delivery-mirror row lands in the General session's transcript."""
+    _thread_session(wired, "sess-general", "1")
+    _thread_session(wired, "sess-newer", "95")
+
+    assert mirror_to_session("telegram", CHAT, "🟡 the ask", source_label="cli", user_id="u1") is True
+    general = wired.get_messages("sess-general")
+    assert [m["role"] for m in general] == ["assistant"]
+    assert "the ask" in general[0]["content"]
+    assert wired.get_messages("sess-newer") == []
+
+
+def test_threaded_chat_without_general_refuses_instead_of_guessing(wired):
+    """No live General (or flat) session: drop the mirror rather than contaminate a room."""
+    _thread_session(wired, "sess-newer", "95")
+    _thread_session(wired, "sess-other", "59")
+
+    assert _find_session_id("telegram", CHAT) is None
+    assert mirror_to_session("telegram", CHAT, "🟡 the ask", source_label="cli", user_id="u1") is False
+    assert wired.get_messages("sess-newer") == []
+    assert wired.get_messages("sess-other") == []
+
+
+def test_flat_chat_still_resolves(wired):
+    """Control: DMs / non-threaded chats (no thread_id at all) keep resolving."""
+    wired.create_session("sess-dm", "telegram", user_id="u1",
+                         session_key="agent:main:telegram:dm:u1", chat_id="123", chat_type="dm")
+
+    assert _find_session_id("telegram", "123") == "sess-dm"
+
+
+def test_explicit_thread_suffix_still_wins(wired):
+    """Control: a thread-suffixed target keeps resolving to exactly that room."""
+    _thread_session(wired, "sess-general", "1")
+    _thread_session(wired, "sess-newer", "95")
+
+    assert _find_session_id("telegram", CHAT, thread_id="95") == "sess-newer"
+
+
+def test_sessions_json_fallback_prefers_thread1(tmp_path):
+    """Pre-migration fallback path parity: the same bare-target rule applies there."""
+    sessions_dir = tmp_path / "sessions"
+    sessions_dir.mkdir()
+    index = sessions_dir / "sessions.json"
+    index.write_text(json.dumps({
+        "general": {"session_id": "sess-general",
+                    "origin": {"platform": "telegram", "chat_id": CHAT, "thread_id": "1"},
+                    "updated_at": "2026-01-01T00:00:00"},
+        "newer": {"session_id": "sess-newer",
+                  "origin": {"platform": "telegram", "chat_id": CHAT, "thread_id": "95"},
+                  "updated_at": "2026-02-01T00:00:00"},
+    }), encoding="utf-8")
+    no_rows = type("NoRows", (), {"find_session_by_origin": staticmethod(lambda **kw: None)})()
+
+    with patch("hermes_state_registry.acquire", return_value=no_rows), \
+         patch("hermes_state_registry.release_or_close"), \
+         patch.object(mirror_mod, "_SESSIONS_INDEX", index):
+        assert _find_session_id("telegram", CHAT) == "sess-general"
+
+
+def test_bare_discord_thread_channel_resolves_its_own_thread(wired):
+    """Discord thread channels key the session on ``chat_id == thread_id``; a send to the
+    thread's channel id is bare yet names exactly that conversation."""
+    wired.create_session("sess-thread", "discord", user_id="u1",
+                         session_key="agent:main:discord:thread:777", chat_id="777",
+                         chat_type="thread", thread_id="777")
+
+    assert _find_session_id("discord", "777") == "sess-thread"
+
+
+def test_live_db_row_beats_a_stale_sessions_json_general_entry(wired, tmp_path):
+    """Every probe runs against state.db before the pre-migration index: an old General entry
+    left in sessions.json must not outrank the live flat session."""
+    wired.create_session("sess-live", "telegram", user_id="u1",
+                         session_key=f"agent:main:telegram:group:{CHAT}:u1", chat_id=CHAT,
+                         chat_type="group")
+    index = tmp_path / "sessions" / "sessions.json"
+    index.parent.mkdir()
+    index.write_text(json.dumps({"stale": {
+        "session_id": "sess-ended", "updated_at": "2026-01-01T00:00:00",
+        "origin": {"platform": "telegram", "chat_id": CHAT, "thread_id": "1"}}}), encoding="utf-8")
+
+    assert _find_session_id("telegram", CHAT) == "sess-live"
