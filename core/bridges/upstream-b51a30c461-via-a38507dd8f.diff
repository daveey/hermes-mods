index 0000000000000000000000000000000000000000..f5bad419e8c2fb8c80f49e98bc7fccf963ff92de
--- /dev/null
+++ b/tests/tools/test_local_env_dashboard_ws_credential.py
@@ -0,0 +1,34 @@
+"""The dashboard hands its PTY child two WebSocket URLs that carry a live dashboard
+credential in the query string (``?token=<_SESSION_TOKEN>`` on a loopback dashboard,
+``?internal=<internal_ws_credential()>`` when the dashboard is gated):
+``HERMES_TUI_SIDECAR_URL`` and ``HERMES_TUI_GATEWAY_URL``. The TUI process reads them
+once at start-up. The agent's own children never need them, and the scrub denylisted
+only the bare ``HERMES_DASHBOARD_SESSION_TOKEN``, so ``terminal("env")`` showed a
+working ``/api/ws`` login."""
+
+import pytest
+
+from tests.tools._child_env_fixtures import child_env, observe_child
+from tools.environments import local
+
+TUI_URL_VARS = ["HERMES_TUI_SIDECAR_URL", "HERMES_TUI_GATEWAY_URL"]
+URL = "ws://127.0.0.1:9119/api/pub?token=0123456789abcdef0123456789abcdef&channel=c1"
+# Other HERMES_TUI_* knobs are plain settings and keep flowing to children.
+KEPT = {"HERMES_TUI_MAX_TURNS": "7", "MY_CUSTOM_VAR": "x"}
+
+
+@pytest.mark.parametrize("builder", [
+    pytest.param(lambda: local._make_run_env({}), id="terminal"),
+    pytest.param(lambda: local.build_subprocess_env(scrub_secrets=True), id="background"),
+    pytest.param(lambda: local.hermes_subprocess_env(), id="helper"),
+    pytest.param(lambda: local.hermes_subprocess_env(inherit_credentials=True), id="inherit_credentials"),
+])
+@pytest.mark.usefixtures("child_env")
+def test_dashboard_ws_credential_urls_never_reach_spawned_children(monkeypatch, builder):
+    for name in TUI_URL_VARS:
+        monkeypatch.setenv(name, URL)
+    for name, value in KEPT.items():
+        monkeypatch.setenv(name, value)
+    observed = observe_child(builder(), [*TUI_URL_VARS, *KEPT])
+    assert {k: observed[k] for k in TUI_URL_VARS} == dict.fromkeys(TUI_URL_VARS)
+    assert {k: observed[k] for k in KEPT} == KEPT
diff --git a/tests/tools/test_local_env_multiplex_scope.py b/tests/tools/test_local_env_multiplex_scope.py
new file mode 100644
index 0000000000000000000000000000000000000000..3c654874bc2943c4bf12ccd8ea0f15a661c921cc
--- /dev/null
+++ b/tests/tools/test_local_env_multiplex_scope.py
@@ -0,0 +1,85 @@
+"""Terminal run envs resolve the routed profile's scope under multiplex (#142798).
+
+A host gateway keeps the environment of whatever session started it. Before the fix,
+``_make_run_env`` built a served profile's terminal commands from that env alone: the
+routed profile's own ``.env`` names only reached the child when the launch process also
+defined the name or it was a declared passthrough, and a launch-residue value for the
+same name won. The builder now overlays the bound secret scope first — the same
+semantics as ``build_subprocess_env(strip_launch_profile=True)``."""
+
+from tools.environments.local import _make_run_env
+from tools.process_registry import ProcessRegistry
+
+# A Hermes-managed provider credential name, built at runtime so no credential-shaped
+# literal sits in the source: the test only needs the NAME to be blocklisted.
+_PROVIDER_KEY = "OPENAI_" + "API_KEY"
+
+
+def _multiplex(monkeypatch, scope):
+    monkeypatch.setattr("agent.secret_scope.is_multiplex_active", lambda: True)
+    monkeypatch.setattr("agent.secret_scope.current_secret_scope", lambda: scope)
+
+
+def test_served_profile_commands_see_their_own_scope(monkeypatch):
+    monkeypatch.setenv("MYAPP_AGENT_ID", "from-p1")  # what started the host gateway
+    _multiplex(monkeypatch, {"MYAPP_AGENT_ID": "from-p2"})
+    env = _make_run_env({})
+    assert env["MYAPP_AGENT_ID"] == "from-p2"
+
+
+def test_single_profile_keeps_the_process_env(monkeypatch):
+    monkeypatch.setattr("agent.secret_scope.is_multiplex_active", lambda: False)
+    monkeypatch.setattr("agent.secret_scope.current_secret_scope", lambda: {"MYAPP_AGENT_ID": "from-p2"})
+    monkeypatch.setenv("MYAPP_AGENT_ID", "from-p1")
+    env = _make_run_env({})
+    assert env["MYAPP_AGENT_ID"] == "from-p1"
+
+
+def test_backend_env_still_beats_the_routed_scope(monkeypatch):
+    monkeypatch.setenv("MYAPP_AGENT_ID", "from-p1")
+    _multiplex(monkeypatch, {"MYAPP_AGENT_ID": "from-p2"})
+    env = _make_run_env({"MYAPP_AGENT_ID": "backend-declared"})
+    assert env["MYAPP_AGENT_ID"] == "backend-declared"
+
+
+def test_scope_values_pass_the_same_credential_scrub(monkeypatch):
+    _multiplex(monkeypatch, {_PROVIDER_KEY: "routed-profile-scrub-probe"})
+    monkeypatch.setenv(_PROVIDER_KEY, "launch-profile-scrub-probe")
+    env = _make_run_env({})
+    # The overlay rides along only names the scrub already allows: a provider credential
+    # stays out whether it came from the launch env or the routed profile's scope.
+    assert _PROVIDER_KEY not in env
+
+
+def test_first_party_context_values_keep_the_process_value(monkeypatch):
+    monkeypatch.setenv("BUZZ_MANAGED_AGENT", "1")  # the Buzz context entitles BUZZ_* names
+    monkeypatch.setenv("BUZZ_WORKSPACE_ID", "from-context")
+    _multiplex(monkeypatch, {"BUZZ_WORKSPACE_ID": "from-routed-dotenv"})
+    env = _make_run_env({})
+    assert env["BUZZ_WORKSPACE_ID"] == "from-context"
+
+
+def test_managed_policy_keys_beat_the_routed_scope(monkeypatch):
+    monkeypatch.setenv("ORG_POLICY_FLAG", "policy-value")
+    monkeypatch.setattr(
+        "hermes_cli.env_loader.managed_dotenv_keys", lambda: ["ORG_POLICY_FLAG"])
+    _multiplex(monkeypatch, {"ORG_POLICY_FLAG": "routed-user-value"})
+    env = _make_run_env({})
+    assert env["ORG_POLICY_FLAG"] == "policy-value"
+
+
+def test_background_commands_get_the_same_routed_base(monkeypatch, tmp_path):
+    """``terminal(background=True)`` spawns through ProcessRegistry, not ``_make_run_env``: it must
+    drop the launch profile's ``.env`` residue and see the served profile's own values too."""
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+    monkeypatch.setenv("MYAPP_AGENT_ID", "from-p1")
+    monkeypatch.setenv("LAUNCH_DOTENV_NAME", "launch-residue")
+    monkeypatch.setattr("hermes_cli.env_loader.launch_dotenv_keys", lambda: ["LAUNCH_DOTENV_NAME"])
+    _multiplex(monkeypatch, {"MYAPP_AGENT_ID": "from-p2"})
+    token = set_hermes_home_override(str(tmp_path / "profiles" / "p2"))
+    try:
+        env = ProcessRegistry._spawn_env({})
+    finally:
+        reset_hermes_home_override(token)
+    assert env["MYAPP_AGENT_ID"] == "from-p2"
+    assert "LAUNCH_DOTENV_NAME" not in env
diff --git a/tests/tools/test_local_env_vault_bootstrap_tokens.py b/tests/tools/test_local_env_vault_bootstrap_tokens.py
new file mode 100644
index 0000000000000000000000000000000000000000..28760b599dd046e8ad3478367d9786402ed34e5d
--- /dev/null
+++ b/tests/tools/test_local_env_vault_bootstrap_tokens.py
@@ -0,0 +1,79 @@
+"""A secret source's bootstrap credential (the vault machine token Hermes itself reads
+to fetch every other secret) must never reach a spawned child. Provider keys are Tier 2
+and already stripped; the vault token outranks them and was not on any list, so a
+``terminal("env")`` or any LSP / browser / TTS child inherited it. Each source hands the
+token to its own CLI explicitly (``_run_bws_list``, ``_op_child_env``), so no child of
+the generic spawn paths needs it."""
+
+import pytest
+
+from tests.tools._child_env_fixtures import child_env, observe_child
+from tools.environments import local
+
+# Default bootstrap env names declared by the bundled sources
+# (agent/secret_sources/bitwarden.py, agent/secret_sources/onepassword.py).
+VAULT_TOKENS = ["BWS_ACCESS_TOKEN", "OP_SERVICE_ACCOUNT_TOKEN"]
+# Operator-shell credentials that stay inheritable on purpose (SECURITY.md §3.2 posture,
+# local_env_policy.py AWS note); the fix must not widen the scrub to them.
+OPERATOR_KEPT = ["AWS_SECRET_ACCESS_KEY", "MY_CUSTOM_VAR"]
+
+
+def _seed(monkeypatch):
+    for name in [*VAULT_TOKENS, *OPERATOR_KEPT, "OPENAI_API_KEY"]:
+        monkeypatch.setenv(name, "fake-" + name)
+
+
+@pytest.mark.parametrize("builder", [
+    pytest.param(lambda: local._make_run_env({}), id="terminal"),
+    pytest.param(lambda: local.build_subprocess_env(scrub_secrets=True), id="background"),
+    pytest.param(lambda: local.hermes_subprocess_env(), id="helper"),
+    pytest.param(lambda: local.hermes_subprocess_env(inherit_credentials=True), id="inherit_credentials"),
+])
+@pytest.mark.usefixtures("child_env")
+def test_vault_bootstrap_tokens_never_reach_spawned_children(monkeypatch, builder):
+    _seed(monkeypatch)
+    observed = observe_child(builder(), [*VAULT_TOKENS, *OPERATOR_KEPT])
+    assert {k: observed[k] for k in VAULT_TOKENS} == dict.fromkeys(VAULT_TOKENS)
+    assert {k: observed[k] for k in OPERATOR_KEPT} == {k: "fake-" + k for k in OPERATOR_KEPT}
+
+
+@pytest.mark.usefixtures("child_env")
+def test_sources_still_hand_the_token_to_their_own_cli(monkeypatch):
+    # The scrub is about *other* children. The vault CLIs get the token explicitly.
+    from agent.secret_sources import onepassword
+    from agent.secret_sources.base import source_child_env
+
+    _seed(monkeypatch)
+    assert onepassword._op_child_env("op-token")["OP_SERVICE_ACCOUNT_TOKEN"] == "op-token"
+    bws_env = source_child_env()
+    bws_env["BWS_ACCESS_TOKEN"] = "bws-token"  # what _run_bws_list does
+    assert observe_child(bws_env, ["BWS_ACCESS_TOKEN"]) == {"BWS_ACCESS_TOKEN": "bws-token"}
+
+
+@pytest.mark.usefixtures("child_env")
+def test_launch_home_credentialed_children_keep_the_token(monkeypatch, tmp_path):
+    """A gateway Hermes starts for its own home and a ``key_cmd`` helper (``op read``) authenticate
+    to the vault themselves, so they keep the token, also when the process env (systemd, Docker -e)
+    holds it. A routed profile's child never gets the launch home's token."""
+    import shlex
+    import sys
+
+    from agent.command_token_source import _mint
+    from agent.secret_scope import reset_secret_scope, set_secret_scope
+    from hermes_constants import get_hermes_home
+
+    _seed(monkeypatch)
+    other = tmp_path / "hermes" / "profiles" / "other"
+    other.mkdir(parents=True)
+    own = local.served_profile_child_env(target_home=str(get_hermes_home()), inherit_credentials=True)
+    routed = local.served_profile_child_env(target_home=str(other), inherit_credentials=True)
+    token = set_secret_scope({}, profile_home=str(other))  # a served profile's scope, no target
+    try:
+        scoped = local.served_profile_child_env(inherit_credentials=True)
+    finally:
+        reset_secret_scope(token)
+    assert observe_child(own, VAULT_TOKENS) == {k: "fake-" + k for k in VAULT_TOKENS}
+    assert observe_child(routed, VAULT_TOKENS) == dict.fromkeys(VAULT_TOKENS)
+    assert observe_child(scoped, VAULT_TOKENS) == dict.fromkeys(VAULT_TOKENS)
+    key_cmd = shlex.join([sys.executable, "-c", "import os; print(os.environ['OP_SERVICE_ACCOUNT_TOKEN'])"])
+    assert _mint(key_cmd, "probe")[0] == "fake-OP_SERVICE_ACCOUNT_TOKEN"
