+                    {'session_key': sid, 'cwd': str(ws), 'explicit_cwd': True, 'source': 'desktop'})
+            terminal_tool.register_container_alias(f'{sid}-child', sid)
+            plans[sid] = _plan(sid)
+            assert _plan(f'{sid}-child') == plans[sid]  # a delegate child runs in its parent's container
+        finally:
