-    - pre_auxiliary_call
-    - post_auxiliary_call
-    - pre_tool_call
-    - post_tool_call
-    - transform_tool_result
-    - subagent_start
-    - subagent_stop
-    - on_session_end
-    - on_session_reset
-    - on_session_finalize
-  provides_middleware:
-    - tool_execution
-  requires_env: []
