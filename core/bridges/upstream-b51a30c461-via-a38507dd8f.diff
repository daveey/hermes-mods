+name: hermes-teamops
+repo: "https://github.com/agentworker33-droid/hermes-teamops"
+sha: "c7ab7104306e63149a3b13015e0d5dc80035e592"
+subdir: teamops
+title: "TeamOps — build and run your agent team"
+description: "One plugin for the full lifecycle of a multi-agent Hermes team. Deploy a whole team from a blueprint (profiles, SOULs, crons, shared kanban/mesh) with `hermes teams deploy`, verify it with Deploy Guard (preflight/smoke/rollback), watch fleet status and the mesh map, catch silent cron gaps (Cron911) and dead models (Model Guard), get a daily standup digest, and broadcast decisions across teams (mesh sync). The Agent Factory is an in-plugin template generator: from a one-line spec it extends a base blueprint with a new role or scaffolds a new team, then deploys it via the same verified pipeline (fixture fallback for demos). 16 tools plus the hermes teams CLI. Local-first by default: everything runs against your own HERMES_HOME; optional `--host` ssh deploys use your own credentials, nothing is stored; `--host` copies the bundle only to your own host. Disclosure — deploying a team creates Hermes profiles and cron jobs in your HERMES_HOME; rollback deletes only teamops-prefixed profiles and files under <home>/teams/<team>/; Model Guard apply and rollback rewrite every profile's config.yaml and jobs.json; fleet and cron scans read every profile's cron store; the optional `--host` deploy copies the team bundle to your VPS over your own ssh credentials and trusts a first-seen host key; `hermes teams dashboard` runs a token-protected server on 127.0.0.1:8781; the bundled trading blueprint is paper-only by instruction, and its agents get the terminal toolset."
+maintainer: "Dalton Wyant / AutomatedAgents"
+tier: community
+category: automation
+requires_hermes: ">=0.21.4"
+docs_url: "https://github.com/agentworker33-droid/hermes-teamops#readme"
+readme: true
+platforms: []
+capabilities:
+  provides_tools:
+    - blueprint_list
+    - team_deploy
+    - team_verify
+    - team_rollback
+    - team_factory
+    - team_status
+    - cron_scan
+    - model_scan
+    - model_rollback
+    - team_standup
+    - mesh_sync
+    - team_dashboard
+    - team_dashboard_status
+    - team_dashboard_stop
+    - phone_intake
+    - twilio_status
+  provides_hooks:
+    - pre_tool_call
+  provides_middleware: []
