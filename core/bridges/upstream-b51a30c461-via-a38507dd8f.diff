+                        ('TERMINAL_DOCKER_MOUNT_CWD_TO_WORKSPACE', 'true'), ('TERMINAL_CWD', str(launch_home))):
+        monkeypatch.setenv(name, value)
+    monkeypatch.setattr(terminal_tool, '_terminal_config_bridge_attempted', True)
+    plans = {}
