+    expect(await hookVerdict('http://rebind.wiring.test/')).toBe(true)
+    expect(await hookVerdict('http://127.0.0.1:8080/')).toBe(true)
+    expect(await hookVerdict('http://pub.wiring.test/next')).toBe(false)
+  })
+})
