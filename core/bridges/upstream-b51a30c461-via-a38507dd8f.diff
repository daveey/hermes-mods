+platforms: []
+known_issues:
+  - "Sign in once after installing: hermes mcp add lusor --url https://mcp.lusor.ai/mcp --auth oauth"
+capabilities:
+  provides_tools: []
+  provides_hooks: []
+  provides_middleware: []
+  requires_env: []
