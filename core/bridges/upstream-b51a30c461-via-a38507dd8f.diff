+    }
+
+
+@pytest.fixture
+def simplex(tmp_path, monkeypatch):
+    from gateway.pairing import PairingStore
+    from gateway.run import GatewayRunner
+    from plugins.platforms.simplex.adapter import SimplexAdapter
+
