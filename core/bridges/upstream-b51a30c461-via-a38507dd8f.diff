+  - https://raw.githubusercontent.com/rahlquist/goneby/a4e326e5ba87c56de64e7f44d837f538b703180f/docs/gallery/screenshot-verification.png
+  - https://raw.githubusercontent.com/rahlquist/goneby/a4e326e5ba87c56de64e7f44d837f538b703180f/docs/gallery/screenshot-retrieve.png
+  - https://raw.githubusercontent.com/rahlquist/goneby/a4e326e5ba87c56de64e7f44d837f538b703180f/docs/gallery/screenshot-endcard.png
+readme: true
+platforms: [linux, macos]
+capabilities:
