diff --git a/tests/ci/test_check_dockerfile_downloads.py b/tests/ci/test_check_dockerfile_downloads.py
new file mode 100644
index 0000000000000000000000000000000000000000..33817b3c12139797c7dd5022652a2762bfafed81
--- /dev/null
+++ b/tests/ci/test_check_dockerfile_downloads.py
@@ -0,0 +1,80 @@
+"""scripts/ci/check_dockerfile_downloads.py on real temp git repos: a download streamed into tar."""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+SCRIPT = REPO / "scripts" / "ci" / "check_dockerfile_downloads.py"
+sys.path.insert(0, str(SCRIPT.parent))
+
+import check_dockerfile_downloads as cdd
+
+_VERIFIED = """FROM debian:13
+ARG SHA=abc
+RUN curl -fsSL --retry 3 -o /tmp/a.tar.gz https://example.com/a.tar.gz; \\
+    printf '%s  %s\\n' "${SHA}" /tmp/a.tar.gz | sha256sum -c -; \\
+    tar -xzf /tmp/a.tar.gz -C /opt
+"""
+
+
+def _repo(tmp_path: Path, files: dict[str, str]) -> Path:
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
+    env.update(GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM="1")
+    subprocess.run(["git", "init", "-q"], cwd=repo, env=env, check=True, timeout=60)
+    for rel, text in files.items():
+        (repo / rel).parent.mkdir(parents=True, exist_ok=True)
+        (repo / rel).write_text(text)
+    subprocess.run(["git", "add", "-A"], cwd=repo, env=env, check=True, timeout=60)
+    return repo
+
+
+def test_a_download_streamed_into_tar_across_a_continuation_fails(tmp_path, capsys):
+    streamed = (
+        "FROM debian:13\n"
+        "RUN mkdir -p /opt/x; \\\n"
+        '    curl -fsSL "https://example.com/x-${V}.tar.gz" \\\n'
+        "        | tar -xz -C /opt/x; \\\n"
+        "    /opt/x/x --version\n"
+    )
+    repo = _repo(tmp_path, {"Dockerfile": _VERIFIED, "docker/sandbox.Dockerfile": streamed})
+    assert cdd.main(["--root", str(repo)]) == 1
+    out = capsys.readouterr().out
+    assert "docker/sandbox.Dockerfile:2" in out
+    assert "  Dockerfile:" not in out
+
+
+def test_comment_and_blank_lines_inside_a_continuation_do_not_hide_the_pipe(tmp_path, capsys):
+    # BuildKit runs each of these as `curl ... | tar` / `curl ... | sh`.
+    files = {
+        "a.Dockerfile": "FROM a\nRUN curl -fsSL u \\\n    # unpack\n    | tar -xz -C /opt\n",
+        "b.Dockerfile": "FROM a\nRUN curl -fsSL u \\\n\n    | tar -xz -C /opt\n",
+        "c.Dockerfile": "FROM a\n# fetch the installer \\\nRUN curl -fsSL u | sh\n",
+    }
+    assert cdd.main(["--root", str(_repo(tmp_path, files))]) == 1
+    out = capsys.readouterr().out
+    assert all(f"{rel}:" in out for rel in files), out
+
+
+def test_downloads_piped_into_absolute_executable_paths_fail(tmp_path, capsys):
+    files = {
+        "a.Dockerfile": "FROM a\nRUN curl -fsSL u | /bin/tar -xz -C /opt\n",
+        "b.Dockerfile": "FROM a\nRUN wget -qO- u | /usr/bin/sh\n",
+        "c.Dockerfile": "FROM a\nRUN curl -fsSL u | sudo /usr/local/bin/bash\n",
+    }
+    assert cdd.main(["--root", str(_repo(tmp_path, files))]) == 1
+    out = capsys.readouterr().out
+    assert all(f"{rel}:2" in out for rel in files), out
+
+
+def test_fetch_verify_extract_passes_and_so_does_the_repo(tmp_path):
+    repo = _repo(tmp_path, {"Dockerfile": _VERIFIED, "x/y.Dockerfile": "FROM a\nRUN wget -qO- u | sh\n"})
+    assert cdd.main(["--root", str(repo)]) == 1
+    (repo / "x/y.Dockerfile").write_text("FROM a\n# never: wget -qO- u | sh\nRUN true\n")
+    assert cdd.main(["--root", str(repo)]) == 0
+    assert cdd.main([]) == 0
diff --git a/tests/cron/test_cron_explicit_target_inherits_origin_thread.py b/tests/cron/test_cron_explicit_target_inherits_origin_thread.py
new file mode 100644
index 0000000000000000000000000000000000000000..1bb94b4fa07604912339eb46ce3d0db37b4dbba8
--- /dev/null
+++ b/tests/cron/test_cron_explicit_target_inherits_origin_thread.py
@@ -0,0 +1,120 @@
+"""``deliver="<platform>:<chat>"`` must keep the origin's thread (topic) lane.
+
+A job created from inside a topic carries ``origin.thread_id`` — the lane the user scheduled
+from. Its delivery target is usually written as an explicit ``platform:chat_id`` pair (the
+``cronjob`` tool, the dashboard, and hand-edited ``jobs.json`` all produce that form), which
+names no thread. Only Slack inherited the origin thread for a chat-only target, so on every
+other topic-capable platform the report fell into the chat's top-level/General lane:
+
+    WARNING cron.scheduler: Job 'ba51c5f0dd27': origin has thread_id=631677 but delivery
+    target lost it (deliver=telegram:167384518, target={... 'thread_id': None ...})
+
+Production evidence (Telegram DM topics, job fired daily for weeks): 38 occurrences in
+``agent.log`` in one log rotation, one per fire, for every job stored with an explicit
+chat-only target.
+
+The inherit is scoped to the origin conversation (same platform, same chat) and never
+overrides an explicit thread, so a fan-out target cannot be redirected into a topic it was
+not addressed to, and the platform's General sentinel (``telegram:<chat>:1``) still selects
+the top-level lane deliberately.
+"""
+
+import pytest
+
+from cron import scheduler_delivery as sd
+
+
+def _job(deliver, origin):
+    return {"id": "j1", "name": "nightly brief", "deliver": deliver, "origin": origin}
+
+
+TELEGRAM_ORIGIN = {
+    "platform": "telegram",
+    "chat_id": "167384518",
+    "chat_name": "Artem Ponomarenko",
+    "thread_id": "631677",
+    "user_id": "167384518",
+}
+
+
+def _resolved(job):
+    targets = sd._resolve_delivery_targets(job)
+    assert len(targets) == 1, targets
+    return targets[0]
+
+
+def test_telegram_chat_only_target_inherits_origin_topic_thread():
+    """The reported bug: chat-only target on the origin chat keeps the DM-topic thread."""
+    target = _resolved(_job("telegram:167384518", TELEGRAM_ORIGIN))
+    assert target["platform"] == "telegram"
+    assert target["chat_id"] == "167384518"
+    assert target["thread_id"] == "631677"
+
+
+def test_explicit_thread_in_target_wins_over_origin():
+    """An explicit lane is never rewritten — the report goes where it was addressed."""
+    target = _resolved(_job("telegram:167384518:999", TELEGRAM_ORIGIN))
+    assert target["thread_id"] == "999"
+
+
+def test_general_sentinel_still_selects_the_top_level_lane():
+    """Escape hatch for a deliberate top-level post in the origin chat: Telegram's General
+    sentinel parses to a thread id, so it survives the inherit instead of being replaced."""
+    target = _resolved(_job("telegram:167384518:1", TELEGRAM_ORIGIN))
+    assert target["thread_id"] == "1"
+
+
+def test_different_chat_does_not_inherit_the_origin_thread():
+    """Fan-out to another chat is not the origin conversation — no thread adoption."""
+    target = _resolved(_job("telegram:-100555", TELEGRAM_ORIGIN))
+    assert target["chat_id"] == "-100555"
+    assert target["thread_id"] is None
+
+
+@pytest.mark.parametrize("platform, chat, thread", [
+    ("matrix", "!abc:srv", "$evt1"),
+    ("mattermost", "chan1", "post9"),
+    ("discord", "42", "77"),
+])
+def test_platforms_without_durable_topic_lanes_keep_posting_top_level(platform, chat, thread):
+    """Matrix (auto_thread) and Mattermost (reply_mode: thread) stamp the creation message's own
+    id as the origin thread; inheriting it would move existing room jobs into that message's
+    reply thread with no top-level opt-out. Only Telegram topics and Slack threads inherit."""
+    origin = {"platform": platform, "chat_id": chat, "thread_id": thread}
+    target = _resolved(_job(f"{platform}:{chat}", origin))
+    assert target["thread_id"] is None
+
+
+def test_stale_slack_per_message_thread_is_not_inherited(monkeypatch):
+    """Regression guard for the Slack rule this generalisation came from: a thread-per-message
+    session key is not a location, so it must not be adopted even on the origin chat."""
+    monkeypatch.setattr(sd, "_get_home_target_chat_id", lambda platform: "D0ORIGIN")
+    origin = {"platform": "slack", "chat_id": "D0ORIGIN", "thread_id": "1700000000.000100"}
+    target = _resolved(_job("slack:D0ORIGIN", origin))
+    assert target["thread_id"] is None
+
+
+def test_genuine_slack_thread_on_a_non_home_chat_is_still_inherited(monkeypatch):
+    """Removing the Slack-only gate must not weaken Slack: a real thread on a non-home chat is
+    a location and keeps being inherited."""
+    monkeypatch.setattr(sd, "_get_home_target_chat_id", lambda platform: "DHOME")
+    origin = {"platform": "slack", "chat_id": "C0TEAM", "thread_id": "1700000000.000100"}
+    target = _resolved(_job("slack:C0TEAM", origin))
+    assert target["thread_id"] == "1700000000.000100"
+
+
+def test_origin_thread_is_stale_keeps_its_slack_scope(monkeypatch):
+    """The stale-key heuristic must stay Slack-only — on Telegram a DM-topic id IS a lane."""
+    monkeypatch.setattr(sd, "_get_home_target_chat_id", lambda platform: "167384518")
+    assert sd._origin_thread_is_stale(TELEGRAM_ORIGIN) is False
+    assert sd._origin_thread_is_stale(
+        {"platform": "slack", "chat_id": "167384518", "thread_id": "631677"}) is True
+
+
+def test_chat_only_target_and_origin_collapse_to_one_delivery():
+    """Before the inherit, ``telegram:<chat>,origin`` resolved to TWO targets — the same chat in
+    the General lane and in the origin topic — so a job addressed twice posted its report twice,
+    once outside the topic. Both spellings now resolve to the same lane and dedupe to one send."""
+    targets = sd._resolve_delivery_targets(_job("telegram:167384518,origin", TELEGRAM_ORIGIN))
+    assert [(t["platform"], t["chat_id"], t["thread_id"]) for t in targets] == [
+        ("telegram", "167384518", "631677")]
diff --git a/tests/cron/test_cron_manual_run_excerpt_reach.py b/tests/cron/test_cron_manual_run_excerpt_reach.py
new file mode 100644
index 0000000000000000000000000000000000000000..563c091904ced0ae687f8f9c3fce0fe3141ad888
--- /dev/null
+++ b/tests/cron/test_cron_manual_run_excerpt_reach.py
@@ -0,0 +1,130 @@
+"""A manual run's completion carries the job output only when no delivery target got it.
+
+The completion re-enters the session that ran ``cronjob(action='run')``, which can be another
+topic (#97557), so output a chat already received is not copied there. Output that reached nobody
+(every target failed) stays in it, or the agent has nothing to relay. A partial failure (one
+target sent, another refused) already posted the output, so it stays status-only.
+"""
+
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from cron.scheduler import _deliver_result
+from gateway.config import Platform, PlatformConfig
+from tools.cronjob_tools import _manual_run_completion
+
+GOOD, BAD = "-100111", "-100222"
+
+
+def _run_and_complete(deliver):
+    job = {"id": "j1", "name": "nightly", "deliver": deliver,
+           "origin": {"platform": "telegram", "chat_id": GOOD}}
+    config = MagicMock()
+    config.platforms = {Platform.TELEGRAM: PlatformConfig(enabled=True)}
+    config.get_home_channel = lambda p: None
+    stored: dict = {}
+
+    async def _send(platform, pconfig, chat_id, text, **kwargs):
+        return {"success": True, "message_id": "7"} if chat_id == GOOD else {"error": "chat not found"}
+
+    with patch("gateway.config.load_gateway_config", return_value=config), \
+         patch("cron.scheduler.load_config", return_value={"cron": {"wrap_response": False}}), \
+         patch("tools.send_message_tool._send_to_platform", _send), \
+         patch("cron.jobs.update_job", side_effect=lambda _id, values: stored.update(values)):
+        error = _deliver_result(job, "THE REPORT")
+    refreshed = {**stored, "last_delivery_error": error}
+    with patch("tools.cronjob_tools.get_job", return_value=refreshed), \
+         patch("tools.cronjob_tools._latest_job_output_excerpt", return_value="THE REPORT"):
+        return error, _manual_run_completion({"success": True}, "j1", "nightly", deliver, 0.0)["summary"]
+
+
+@pytest.mark.parametrize("deliver, echoed", [
+    (f"telegram:{BAD}", True),                    # failed everywhere: reached nobody
+    (f"telegram:{GOOD},telegram:{BAD}", False),   # partial: already posted in GOOD
+    (f"telegram:{GOOD}", False),                  # delivered
+])
+def test_completion_echoes_output_only_when_no_target_received_it(deliver, echoed):
+    error, summary = _run_and_complete(deliver)
+    assert (error is not None) == (BAD in deliver)
+    assert ("THE REPORT" in summary) is echoed
+
+
+def test_a_partial_standalone_split_send_counts_as_reached(monkeypatch):
+    """The REAL Telegram standalone sender lands chunks 1-2 of a long report, then chunk 3 fails.
+    The report's head is already in the target chat, so the manual-run completion must not echo it
+    into the invoking conversation as if the delivery had reached nobody."""
+    from types import SimpleNamespace
+    from unittest.mock import AsyncMock
+
+    from plugins.platforms.telegram.standalone import _send_telegram
+    from tests.tools.test_telegram_send_message_chunk_mdv2 import _install_telegram_mock, _no_proxy
+
+    _no_proxy(monkeypatch)
+    bot = MagicMock()
+    bot.send_message = AsyncMock(side_effect=[SimpleNamespace(message_id=501), SimpleNamespace(message_id=502),
+                                              RuntimeError("transport refused final chunk")])
+    _install_telegram_mock(monkeypatch, MagicMock(return_value=bot))
+    deliver = f"telegram:{GOOD}"
+    job = {"id": "j1", "name": "nightly", "deliver": deliver, "origin": {"platform": "telegram", "chat_id": GOOD}}
+    config = MagicMock()
+    config.platforms = {Platform.TELEGRAM: PlatformConfig(enabled=True)}
+    config.get_home_channel = lambda p: None
+    stored: dict = {}
+
+    async def _send(platform, pconfig, chat_id, text, **kwargs):
+        return await _send_telegram("tok", chat_id, text)
+
+    with patch("gateway.config.load_gateway_config", return_value=config), \
+         patch("cron.scheduler.load_config", return_value={"cron": {"wrap_response": False}}), \
+         patch("tools.send_message_tool._send_to_platform", _send), \
+         patch("cron.jobs.update_job", side_effect=lambda _id, values: stored.update(values)):
+        error = _deliver_result(job, "status line ok\n" * 700)
+    assert error and bot.send_message.await_count == 3
+    with patch("tools.cronjob_tools.get_job", return_value={**stored, "last_delivery_error": error}), \
+         patch("tools.cronjob_tools._latest_job_output_excerpt", return_value="THE REPORT"):
+        summary = _manual_run_completion({"success": True}, "j1", "nightly", deliver, 0.0)["summary"]
+    assert "THE REPORT" not in summary
+
+
+
+@pytest.mark.parametrize("lost", ["ack", "raise"])
+def test_a_report_whose_delivery_answer_was_lost_is_not_echoed(monkeypatch, lost):
+    """The report may be on screen at the target: Telegram accepted it but the answer never came back
+    (the REAL standalone sender reports ``delivery: uncertain``), or the sender itself raised."""
+    from types import SimpleNamespace
+    from unittest.mock import AsyncMock
+
+    from plugins.platforms.telegram.standalone import _send_telegram
+    from tests.tools.test_telegram_send_message_chunk_mdv2 import _install_telegram_mock, _no_proxy
+
+    _no_proxy(monkeypatch)
+    bot = MagicMock()
+    bot.send_message = AsyncMock(side_effect=OSError("connection reset after the request was sent"))
+    _install_telegram_mock(monkeypatch, MagicMock(return_value=bot))
+    deliver = f"telegram:{GOOD}"
+    job = {"id": "j1", "name": "nightly", "deliver": deliver, "origin": {"platform": "telegram", "chat_id": GOOD}}
+    config = MagicMock()
+    config.platforms = {Platform.TELEGRAM: PlatformConfig(enabled=True)}
+    config.get_home_channel = lambda p: None
+    stored: dict = {}
+    results: list = []
+
+    async def _send(platform, pconfig, chat_id, text, **kwargs):
+        if lost == "raise":
+            raise TimeoutError("sender gave up waiting for Telegram's answer")
+        results.append(await _send_telegram("tok", chat_id, text))
+        return results[-1]
+
+    with patch("gateway.config.load_gateway_config", return_value=config), \
+         patch("cron.scheduler.load_config", return_value={"cron": {"wrap_response": False}}), \
+         patch("tools.send_message_tool._send_to_platform", _send), \
+         patch("cron.jobs.update_job", side_effect=lambda _id, values: stored.update(values)):
+        error = _deliver_result(job, "THE REPORT")
+    assert error
+    if lost == "ack":
+        assert results[0].get("delivery") == "uncertain"
+    with patch("tools.cronjob_tools.get_job", return_value={**stored, "last_delivery_error": error}), \
+         patch("tools.cronjob_tools._latest_job_output_excerpt", return_value="THE REPORT"):
+        summary = _manual_run_completion({"success": True}, "j1", "nightly", deliver, 0.0)["summary"]
+    assert "THE REPORT" not in summary
