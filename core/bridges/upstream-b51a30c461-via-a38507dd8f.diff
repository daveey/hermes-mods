+
+def _save_notice_state(boots: list[float], sent: list[float], path, start: Optional[float] = None) -> None:
+    state: dict[str, object] = {"boots": boots[-_MAX_STORED_BOOTS:], "sent": sent[-_MAX_STORED_BOOTS:]}
