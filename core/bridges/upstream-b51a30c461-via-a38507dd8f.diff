+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 Atlas Omnia
+name: hermes-office-desktop
+title: "Workbench by Atlas Omnia"
+repo: https://github.com/AtlasOmnia/workbench
+docs_url: https://github.com/AtlasOmnia/workbench#readme
