+    - radar_list
+    - radar_inspect
+    - radar_propose
+    - radar_preference
+  provides_hooks:
+    - on_session_start
+    - post_llm_call
+    - subagent_stop
+    - post_compaction
+    - pre_gateway_dispatch
+    - pre_llm_call
+    - pre_tool_call
+  provides_middleware: []
+  requires_env: []
+
