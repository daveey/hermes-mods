index 00000000000..d0291377811
--- /dev/null
+++ b/tests/tui_gateway/test_delegate_completion_routing.py
@@ -0,0 +1,103 @@
+"""A delegate child must never claim its parent's completion as a continuation.
+
+Regression for the completion-routing repro on PR #150198: use the real child
+reservation, first-turn metadata writers and SessionDB, not a stubbed resolver.
+"""
+
+import queue
+import threading
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from agent.prompt_refresh import stamp_prompt_epoch
+from hermes_state import SessionDB
+from tests.tools import test_delegate_transcript_readiness as transcript_readiness
+from tools.delegate_tool import _build_child_agent
+from tools.process_registry_notifications import format_process_notification
+from tui_gateway import server
+
+
+offline_children = transcript_readiness.offline_children
+
+
+@pytest.mark.parametrize("event_type", ["completion", "async_delegation"])
+@pytest.mark.parametrize("compressed", [False, True], ids=["parent", "compression-tip"])
+def test_parent_completion_never_delivered_to_delegate_child(
+    tmp_path, monkeypatch, offline_children, event_type, compressed
+):
+    db = SessionDB(db_path=tmp_path / "state.db")
+    child = None
+    try:
+        db.create_session("parent", source="desktop")
+        db.append_message("parent", "user", "Delegate an inspection")
+        owner_key = "parent"
+        if compressed:
+            db.publish_compression_child(
+                parent_session_id="parent", child_session_id="tip", source="desktop",
+                messages=[{"role": "user", "content": "Continue the inspection"}],
+                require_compression_lease=False,
+            )
+            owner_key = "tip"
+        child = _build_child_agent(
+            task_index=0, goal="Synthetic inspection", context=None, toolsets=["file"],
+            model=None, max_iterations=2, task_count=1,
+            parent_agent=transcript_readiness._parent(db, owner_key, lambda *a, **kw: None),
+        )
+        # On a refreshed profile this precedes _ensure_db_session. Without the
+        # writer fix it freezes model_config without _delegate_from.
+        stamp_prompt_epoch(child, 17)
+        child._ensure_db_session()
+        db.append_message(child.session_id, "assistant", "Inspection complete")
+
+        owner = {"session_key": owner_key, "agent": None, "running": False,
+                 "history_lock": threading.RLock()}
+        child_ui = {"session_key": child.session_id, "agent": None, "running": False,
+                    "history_lock": threading.RLock()}
+        monkeypatch.setattr(server, "_sessions", {"parent-ui": owner, "child-ui": child_ui})
+        # Keep the real profile-aware DB context and resolver; only select the
+        # isolated store. No model turn or unrelated delivery ledger is needed.
+        monkeypatch.setattr(server, "_get_db", lambda: db)
+        submit = Mock(return_value=True)
+        emit = Mock()
+        monkeypatch.setattr(server, "_run_prompt_submit", submit)
+        monkeypatch.setattr(server, "_emit", emit)
+        monkeypatch.setattr("tools.async_delegation.claim_event_delivery", lambda *a: "claim")
+        monkeypatch.setattr("tools.async_delegation.complete_event_delivery", lambda *a: None)
+        registry = SimpleNamespace(completion_queue=queue.Queue(), is_completion_consumed=lambda _sid: False)
+        event = {"type": event_type, "session_key": "parent"}
+        if event_type == "async_delegation":
+            # The original tab is gone, so the durable lineage must decide who
+            # receives the result; a live origin would bypass the faulty walk.
+            event.update(delegation_id="parent-batch", origin_ui_session_id="closed-ui",
+                         results=[{"status": "completed", "summary": "Inspection complete"}])
+        else:
+            event.update(session_id="proc-parent", command="inspect", exit_code=0,
+                         completion_reason="exited", output="Inspection complete")
+
+        # Let the delegate's poller see it first, as in the live incident. It
+        # must neither emit a status nor inject a turn, and must retain the event.
+        deferred = []
+        server._notif_handle_ready(
+            "child-ui", child_ui, [event], set(), registry, format_process_notification, deferred)
+        submit.assert_not_called()
+        emit.assert_not_called()
+        assert deferred == [event]
+        assert not child_ui["running"]
+
+        # The parent (or its real compression continuation) must still receive
+        # the retained event. This prevents a false fix that merely drops it.
+        retained = []
+        server._notif_handle_ready(
+            "parent-ui", owner, deferred, set(), registry, format_process_notification, retained)
+        submit.assert_called_once()
+        assert submit.call_args.args[1] == "parent-ui"
+        assert submit.call_args.args[2] is owner
+        assert "Inspection complete" in submit.call_args.args[3]
+        assert retained == []
+        assert registry.completion_queue.empty()
+    finally:
+        if child is not None:
+            child.close()
+        db.close()
diff --git a/tests/tui_gateway/test_kanban_stray_delegate_subs.py b/tests/tui_gateway/test_kanban_stray_delegate_subs.py
new file mode 100644
index 00000000000..fe4e920978f
--- /dev/null
+++ b/tests/tui_gateway/test_kanban_stray_delegate_subs.py
@@ -0,0 +1,142 @@
+"""Kanban subscriptions bound to a parent's own subagent are reclaimed by the parent (#150198).
+
+Before the reserved child kept its ``_delegate_from`` marker, ``kanban_create`` resolved the parent's
+key to the unmarked child and saved the card's subscription under the child's id. v33 re-tags the
+session row but never touches kanban.db, so those cards kept notifying the subagent.
+"""
+
+import sqlite3
+from unittest.mock import patch
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_notify as kbn
+from hermes_state import SessionDB
+from hermes_state_delegate_children import delegate_descendant_ids
+from tui_gateway import server
+
+
+def _subscribed_task(chat_id: str) -> str:
+    conn = kbc.connect()
+    try:
+        tid = kb.create_task(conn, title="stray sub", assignee="worker")
+        kbn.add_notify_sub(conn, task_id=tid, platform="tui", chat_id=chat_id)
+        kb.complete_task(conn, tid, summary="shipped")
+        return tid
+    finally:
+        conn.close()
+
+
+def _chat_ids(tid: str) -> list:
+    conn = kbc.connect()
+    try:
+        return [row["chat_id"] for row in kbn.list_notify_subs(conn, task_id=tid)]
+    finally:
+        conn.close()
+
+
+def test_parent_reclaims_a_subscription_bound_to_its_own_subagent(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        db.create_session(session_id="parent", source="desktop")
+        db.create_session(session_id="child", source="subagent", parent_session_id="parent",
+                          model_config={"_delegate_from": "parent"})
+        db.create_session(session_id="other", source="desktop")
+        db.create_session(session_id="other-child", source="subagent", parent_session_id="other",
+                          model_config={"_delegate_from": "other"})
+        mine, theirs = _subscribed_task("child"), _subscribed_task("other-child")
+
+        with patch.object(server, "_get_db", lambda: db):
+            texts = server._collect_kanban_notifications({"session_key": "parent"})
+
+        assert len(texts) == 1 and mine in texts[0]
+        assert _chat_ids(mine) == ["parent"]
+        assert _chat_ids(theirs) == ["other-child"]  # another session's subagent is left alone
+        # A subagent's own tab never claims its parent's (or siblings') subscriptions.
+        assert delegate_descendant_ids(db, "child") == []
+    finally:
+        db.close()
+
+
+def test_a_transient_db_error_does_not_end_the_reclaim(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        db.create_session(session_id="parent", source="desktop")
+        db.create_session(session_id="child", source="subagent", parent_session_id="parent",
+                          model_config={"_delegate_from": "parent"})
+        tid = _subscribed_task("child")
+        session = {"session_key": "parent"}
+        real_count = kbn.count_notify_subs
+
+        def locked(*args, **kwargs):
+            if kwargs.get("chat_id") == "child":
+                raise sqlite3.OperationalError("database is locked")
+            return real_count(*args, **kwargs)
+
+        with patch.object(server, "_get_db", lambda: db):
+            with patch.object(kbn, "count_notify_subs", locked):
+                assert server._collect_kanban_notifications(session) == []
+            texts = server._collect_kanban_notifications(session)
+
+        assert len(texts) == 1 and tid in texts[0]
+        assert _chat_ids(tid) == ["parent"]
+    finally:
+        db.close()
+
+
+def test_reclaim_precedes_quiet_board_cache_and_keeps_durable_claims(tmp_path):
+    """Fork quiet-board caching must not swallow upstream reclaim or its transient retry."""
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        db.create_session(session_id="parent", source="desktop")
+        db.create_session(session_id="child", source="subagent", parent_session_id="parent",
+                          model_config={"_delegate_from": "parent"})
+        tid = _subscribed_task("child")
+        path = str(kb.kanban_db_path(board=kb.DEFAULT_BOARD))
+        session = {"session_key": "parent", "_kb_board_seen": {path: ("parent", "unchanged")}}
+        real_count = kbn.count_notify_subs
+
+        def locked(*args, **kwargs):
+            if kwargs.get("chat_id") == "child":
+                raise sqlite3.OperationalError("database is locked")
+            return real_count(*args, **kwargs)
+
+        with patch.object(server, "_get_db", lambda: db), \
+                patch.object(server, "_kb_board_file_sig", return_value="unchanged"):
+            with patch.object(kbn, "count_notify_subs", locked):
+                assert server._collect_kanban_notifications(session) == []
+            assert session["_kanban_stray_keys"] == ("child",)
+            assert path not in session["_kb_board_seen"]
+            claims = []
+            texts = server._collect_kanban_notifications(session, claims)
+        assert len(texts) == 1 and tid in texts[0]
+        assert _chat_ids(tid) == ["parent"]
+        assert len(claims) == 1 and claims[0]["chat_id"] == "parent"
+        assert claims[0]["texts"] == texts
+        assert session["_kanban_stray_keys"] == ()
+    finally:
+        db.close()
+
+
+def test_reclaims_a_subscription_bound_to_a_misrouted_childs_continuation(tmp_path):
+    """A child resumed as the chat compressed into an unmarked continuation; the pre-fix resolver subscribed
+    the card under that tip, and v33 rightly leaves the continuation unmarked."""
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        db.create_session(session_id="parent", source="desktop")
+        db.append_message("parent", "user", "parent question")
+        db.create_session(session_id="child", source="subagent", parent_session_id="parent",
+                          model_config={"_delegate_from": "parent"})
+        db.append_message("child", "assistant", "child work")
+        db.publish_compression_child(parent_session_id="child", child_session_id="child-tip", source="subagent",
+                                     messages=[{"role": "user", "content": "typed after misrouted resume"}],
+                                     require_compression_lease=False)
+        tid = _subscribed_task("child-tip")
+
+        with patch.object(server, "_get_db", lambda: db):
+            texts = server._collect_kanban_notifications({"session_key": "parent"})
+
+        assert len(texts) == 1 and tid in texts[0]
+        assert _chat_ids(tid) == ["parent"]
+    finally:
+        db.close()
