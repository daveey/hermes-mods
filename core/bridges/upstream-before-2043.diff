+                        {"role": "assistant", "content": "Ok."}], None, _PREVIOUS),
+        (_PRIOR_TURN + [{"role": "user", "content": [{"type": "text", "text": "\n\n" + steer_user_row("use zstd")["content"]}]},
+                        {"role": "assistant", "content": "Ok."}], None, _PREVIOUS),
