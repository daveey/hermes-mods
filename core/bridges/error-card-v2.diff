+export function useRevealStatusDrawer(token: number | null, collapsed: boolean, toggle: () => void) {
+  const [revealed, setRevealed] = useState<number | null>(null)
+
+  useEffect(() => {
+    if (token === null || revealed === token) {
+      return
+    }
+
+    setRevealed(token)
+
+    if (collapsed) {
+      toggle()
+    }
+  }, [collapsed, revealed, toggle, token])
