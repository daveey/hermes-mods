+def test_pool_bench(case, error, provider, keys, bench):
+    from agent.credential_pool import _exhausted_until
+
+    pool = CredentialPool(provider, [Key(provider, f"k{i}", f"k{i}", "api_key", i, "manual", f"sk-{i}" if i else "sk-primary")
