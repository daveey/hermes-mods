diff --git a/apps/desktop/e2e/catalog-desktop-plugin-install.spec.ts b/apps/desktop/e2e/catalog-desktop-plugin-install.spec.ts
new file mode 100644
index 00000000000..d29718062b0
--- /dev/null
+++ b/apps/desktop/e2e/catalog-desktop-plugin-install.spec.ts
@@ -0,0 +1,129 @@
+/**
+ * A desktop-only catalog plugin installed from its catalog card (Accent Picker, reported on X on
+ * 2026-11-07): the install worked, but the card kept its "+", the plugin sat switched off (it ships
+ * `defaultEnabled: false`), and a second Install answered "already exists" with Force out of sight.
+ *
+ * Real Electron and real `hermes serve`. The catalog feed is answered with one entry that points at a
+ * local Git repository laid out like hermes-official-plugins (plugin.yaml + desktop/plugin.js, no agent
+ * half), so the install clones, checks out the pinned commit and publishes for real, with no network.
+ *
+ * The second half is the copy an older build left behind: the folder with no recorded catalog entry.
+ * Installing from the card again adopts it in place instead of refusing.
+ */
+import { execFileSync } from 'node:child_process'
+import fs from 'node:fs'
+import path from 'node:path'
+import { pathToFileURL } from 'node:url'
+
+import { type MockBackendFixture, setupMockBackend, waitForAppReady } from './fixtures'
+import { expect, test } from './test'
+
+const CATALOG_FEED = 'https://nousresearch.github.io/hermes-agent/docs/api/plugins.json'
+const NAME = 'accent-picker'
+const INSTALL_ORIGIN = '.hermes-origin.json'
+
+const PLUGIN_JS = `export default {
+  id: 'accent',
+  name: 'Accent Picker',
+  description: 'E2E stand-in for the catalog accent picker.',
+  defaultEnabled: false,
+  register() {}
+}
+`
+
+let fixture: MockBackendFixture | null = null
+let repo = ''
+let sha = ''
+
+function git(cwd: string, ...args: string[]): string {
+  return execFileSync('git', args, { cwd, encoding: 'utf8' }).trim()
+}
+
+/** A repository shaped like hermes-official-plugins: the entry is a subdirectory, desktop half only. */
+function officialPluginsRepo(root: string): void {
+  const plugin = path.join(root, NAME)
+  fs.mkdirSync(path.join(plugin, 'desktop'), { recursive: true })
+  fs.writeFileSync(path.join(plugin, 'plugin.yaml'), `name: ${NAME}\nlabel: Accent Picker\nversion: 1.0.0\n`)
+  fs.writeFileSync(path.join(plugin, 'desktop', 'plugin.js'), PLUGIN_JS)
+  git(root, 'init', '-q', '-b', 'main')
+  git(root, 'add', '-A')
+  git(root, '-c', 'user.email=e2e@example.invalid', '-c', 'user.name=e2e', 'commit', '-q', '-m', 'accent-picker')
+}
+
+test.beforeAll(async () => {
+  fixture = await setupMockBackend()
+  repo = path.join(fixture.sandbox.root, 'hermes-official-plugins')
+  fs.mkdirSync(repo, { recursive: true })
+  officialPluginsRepo(repo)
+  sha = git(repo, 'rev-parse', 'HEAD')
+
+  const entry = {
+    category: 'desktop',
+    description: 'OKLCH accent colour picker for the status bar. Desktop-only.',
+    maintainer: 'NousResearch',
+    name: NAME,
+    repo: pathToFileURL(repo).href,
+    sha,
+    subdir: NAME,
+    tier: 'official',
+    version: '1.0.0'
+  }
+
+  await fixture.app
+    .context()
+    .route(CATALOG_FEED, route =>
+      route.fulfill({ body: JSON.stringify([entry]), contentType: 'application/json', status: 200 })
+    )
+})
+
+test.afterAll(async () => {
+  await fixture?.cleanup()
+  fixture = null
+})
+
+test('a desktop-only catalog plugin shows installed, turns on, and an older copy is adopted', async () => {
+  test.setTimeout(300_000)
+  const { page, sandbox } = fixture!
+  await waitForAppReady(fixture!, 120_000)
+  const folder = path.join(sandbox.hermesHome, 'desktop-plugins', NAME)
+  const addButton = page.getByRole('button', { name: `Add ${NAME}` })
+  const pluginSwitch = page.getByRole('switch', { name: 'Accent Picker' })
+
+  await page.evaluate(() => {
+    window.location.hash = '#/capabilities?tab=plugins'
+  })
+  const search = page.getByPlaceholder(/search plugins/i).first()
+  await search.waitFor({ timeout: 60_000 })
+  await search.fill('accent')
+
+  const installFromCard = async () => {
+    await addButton.first().click({ timeout: 60_000 })
+    const dialog = page.getByRole('dialog', { name: NAME })
+    await dialog.getByRole('button', { name: /^install$/i }).click({ timeout: 120_000 })
+    await dialog.waitFor({ state: 'detached', timeout: 120_000 })
+  }
+
+  // First install: the card records its entry, stops offering Install, and the plugin is on.
+  await installFromCard()
+  expect(JSON.parse(fs.readFileSync(path.join(folder, INSTALL_ORIGIN), 'utf8'))).toEqual({
+    catalogName: NAME,
+    repo: pathToFileURL(repo).href,
+    sha
+  })
+  expect(fs.existsSync(path.join(folder, '.hermes-package.json'))).toBe(false)
+  await expect(addButton).toHaveCount(0, { timeout: 30_000 })
+  await expect(pluginSwitch).toHaveAttribute('aria-checked', 'true', { timeout: 30_000 })
+
+  // What an older build left: the same folder with no recorded entry. Its card offers Install again.
+  fs.rmSync(path.join(folder, INSTALL_ORIGIN))
+  fs.writeFileSync(path.join(folder, 'state.json'), 'kept\n')
+  await page.getByRole('button', { name: 'Rescan' }).click()
+  await expect(addButton).toHaveCount(1, { timeout: 30_000 })
+
+  // Installing again adopts that copy in place: no "already exists", nothing in the folder replaced.
+  await installFromCard()
+  expect(JSON.parse(fs.readFileSync(path.join(folder, INSTALL_ORIGIN), 'utf8')).catalogName).toBe(NAME)
+  expect(fs.readFileSync(path.join(folder, 'state.json'), 'utf8')).toBe('kept\n')
+  await expect(addButton).toHaveCount(0, { timeout: 30_000 })
+  await expect(pluginSwitch).toHaveAttribute('aria-checked', 'true')
+})
diff --git a/apps/desktop/electron/desktop-plugin-install-origin.test.ts b/apps/desktop/electron/desktop-plugin-install-origin.test.ts
new file mode 100644
index 00000000000..bd0a1f6105d
--- /dev/null
+++ b/apps/desktop/electron/desktop-plugin-install-origin.test.ts
@@ -0,0 +1,153 @@
+import { execFileSync } from 'node:child_process'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { pathToFileURL } from 'node:url'
+
+import { afterEach, describe, expect, it } from 'vitest'
+
+import { installDesktopPluginFromGit } from './desktop-plugin-install'
+import { INSTALL_ORIGIN, PACKAGE_MARKER } from './desktop-plugins-root'
+
+// A desktop-only catalog entry (Accent Picker) installs as a standalone plugin with no package
+// marker. Without its catalog entry on disk the card never showed it installed, and the next
+// Install stopped at "already exists" (reported on X, 2026-11-07).
+const roots: string[] = []
+
+afterEach(() => {
+  for (const root of roots.splice(0)) {
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+})
+
+function mkdtemp(prefix: string) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), prefix))
+  roots.push(dir)
+
+  return dir
+}
+
+function git(repo: string, ...args: string[]) {
+  return execFileSync('git', args, { cwd: repo, stdio: 'pipe' }).toString().trim()
+}
+
+/** A desktop-only repo: a manifest beside `desktop/plugin.js`, no agent payload. */
+function desktopOnlyRepo(extra: Record<string, string> = {}): string {
+  const repo = mkdtemp('hermes-origin-repo-')
+  fs.mkdirSync(path.join(repo, 'desktop'))
+  fs.writeFileSync(path.join(repo, 'plugin.yaml'), 'name: accent-picker\n')
+  fs.writeFileSync(path.join(repo, 'desktop', 'plugin.js'), 'export default { id: "accent" }\n')
+
+  for (const [name, text] of Object.entries(extra)) {
+    fs.writeFileSync(path.join(repo, 'desktop', name), text)
+  }
+
+  git(repo, 'init', '-q')
+  git(repo, 'add', '.')
+  git(repo, '-c', 'user.email=f@example.com', '-c', 'user.name=F', 'commit', '-qm', 'init')
+
+  return repo
+}
+
+const originOf = (dir: string) => JSON.parse(fs.readFileSync(path.join(dir, INSTALL_ORIGIN), 'utf8'))
+
+describe('a standalone desktop plugin installed from the catalog', () => {
+  it('records its catalog entry, and stays standalone (no package marker)', async () => {
+    const repo = desktopOnlyRepo()
+    const appRoot = mkdtemp('hermes-origin-root-')
+    const sha = git(repo, 'rev-parse', 'HEAD')
+
+    const result = await installDesktopPluginFromGit('git', pathToFileURL(repo).href, appRoot, {
+      sha,
+      catalogName: 'accent-picker'
+    })
+
+    expect(result).toMatchObject({ ok: true })
+    const dir = path.join(appRoot, result.pluginName!)
+    expect(originOf(dir)).toEqual({ catalogName: 'accent-picker', repo: pathToFileURL(repo).href, sha })
+    expect(fs.existsSync(path.join(dir, PACKAGE_MARKER))).toBe(false)
+  })
+
+  it('records nothing for a Git URL install, and drops an origin file the repo ships', async () => {
+    const forged = JSON.stringify({ catalogName: 'trusted-entry', repo: 'https://github.com/x/y', sha: 'a'.repeat(40) })
+    const repo = desktopOnlyRepo({ [INSTALL_ORIGIN]: forged })
+    const appRoot = mkdtemp('hermes-origin-root-')
+
+    const result = await installDesktopPluginFromGit('git', pathToFileURL(repo).href, appRoot)
+
+    expect(result).toMatchObject({ ok: true })
+    expect(fs.existsSync(path.join(appRoot, result.pluginName!, INSTALL_ORIGIN))).toBe(false)
+  })
+
+  it('adopts an earlier install of the same tree instead of answering "already exists"', async () => {
+    const repo = desktopOnlyRepo({ 'panel.js': 'mine\n' })
+    const appRoot = mkdtemp('hermes-origin-root-')
+    const sha = git(repo, 'rev-parse', 'HEAD')
+    // The install every build before this one made: no origin recorded.
+    const first = await installDesktopPluginFromGit('git', pathToFileURL(repo).href, appRoot, { sha })
+    const dir = path.join(appRoot, first.pluginName!)
+    fs.writeFileSync(path.join(dir, 'state.json'), 'kept\n')
+
+    const again = await installDesktopPluginFromGit('git', pathToFileURL(repo).href, appRoot, {
+      sha,
+      catalogName: 'accent-picker'
+    })
+
+    expect(again).toMatchObject({ ok: true, pluginName: first.pluginName })
+    expect(originOf(dir).catalogName).toBe('accent-picker')
+    // Adopted in place: nothing in the folder was replaced.
+    expect(fs.readFileSync(path.join(dir, 'state.json'), 'utf8')).toBe('kept\n')
+  })
+
+  it('still refuses to replace a different plugin of that name without Force', async () => {
+    const repo = desktopOnlyRepo()
+    const appRoot = mkdtemp('hermes-origin-root-')
+    const sha = git(repo, 'rev-parse', 'HEAD')
+    const first = await installDesktopPluginFromGit('git', pathToFileURL(repo).href, appRoot, { sha })
+    const dir = path.join(appRoot, first.pluginName!)
+    fs.writeFileSync(path.join(dir, 'plugin.js'), 'export default { id: "my-own-edit" }\n')
+
+    const again = await installDesktopPluginFromGit('git', pathToFileURL(repo).href, appRoot, {
+      sha,
+      catalogName: 'accent-picker'
+    })
+
+    expect(again).toMatchObject({ ok: false, exists: true })
+    expect(again.error).toContain('already exists')
+    expect(fs.existsSync(path.join(dir, INSTALL_ORIGIN))).toBe(false)
+    expect(fs.readFileSync(path.join(dir, 'plugin.js'), 'utf8')).toContain('my-own-edit')
+  })
+
+  it('records the commit it cloned when the install names no pin', async () => {
+    const repo = desktopOnlyRepo()
+    const appRoot = mkdtemp('hermes-origin-root-')
+
+    const result = await installDesktopPluginFromGit('git', pathToFileURL(repo).href, appRoot, {
+      catalogName: 'accent-picker'
+    })
+
+    expect(result.ok).toBe(true)
+    expect(originOf(path.join(appRoot, result.pluginName!))).toEqual({
+      catalogName: 'accent-picker',
+      repo: pathToFileURL(repo).href,
+      sha: git(repo, 'rev-parse', 'HEAD')
+    })
+  })
+
+  it('records the commit it checked out when the pin is an annotated tag', async () => {
+    const repo = desktopOnlyRepo()
+    const appRoot = mkdtemp('hermes-origin-root-')
+    const commit = git(repo, 'rev-parse', 'HEAD')
+    git(repo, '-c', 'user.email=t@example.invalid', '-c', 'user.name=t', 'tag', '-a', 'v1', '-m', 'v1')
+    const tagObject = git(repo, 'rev-parse', 'v1')
+    expect(tagObject).not.toBe(commit)
+
+    const result = await installDesktopPluginFromGit('git', pathToFileURL(repo).href, appRoot, {
+      sha: tagObject,
+      catalogName: 'accent-picker'
+    })
+
+    expect(result).toMatchObject({ ok: true })
+    expect(originOf(path.join(appRoot, result.pluginName!))).toMatchObject({ sha: commit, pin: tagObject })
+  })
+})
