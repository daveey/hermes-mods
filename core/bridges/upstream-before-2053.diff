diff --git a/tests/gateway/relay/test_relay_clarify_reply.py b/tests/gateway/relay/test_relay_clarify_reply.py
new file mode 100644
index 00000000000..51c9afff664
--- /dev/null
+++ b/tests/gateway/relay/test_relay_clarify_reply.py
@@ -0,0 +1,89 @@
+"""A relay message sent while the chat's turn waits on a clarify question cancels the question.
+
+Relay deliveries skip ``_handle_message`` and commit straight to the durable FIFO, so a user who
+wrote something instead of picking a choice queued behind the turn waiting for them, which sat out
+the whole ``clarify_timeout`` (an hour) before their message ran. Real ``GatewayRunner`` + session
+authority + relay transport against a fixture connector; only the model turn is stubbed.
+"""
+import asyncio
+
+import pytest
+
+from gateway.session_results import execution_result
+from tests.gateway.relay.test_relay_native_turn_lifecycle import _gateway, _stub_model
+from tests.waiting import async_wait_until
+
+pytest.importorskip('websockets')
+
+FIRST, ROOT = '1700000000.000500', 'D5'
+
+
+class _Agent:
+    """The running turn's agent: records what interrupted it."""
+
+    def __init__(self):
+        self.interrupts = []
+        self.interrupted = asyncio.Event()
+        self.loop = asyncio.get_running_loop()
+
+    def interrupt(self, text=None):
+        self.interrupts.append(text)
+        self.loop.call_soon_threadsafe(self.interrupted.set)
+
+
+def _asking_turn(runner, agent, answers, *, hold_until_interrupted):
+    async def asks(event):
+        key = runner._session_key_for_source(event.source)
+        runner._session_state(key).turn.agent = agent
+        from tools import clarify_gateway as clarify
+        clarify.register('c-relay', key, 'Which?', ['a', 'b'])
+        answers.append(await asyncio.to_thread(clarify.wait_for_response, 'c-relay', 60))
+        if hold_until_interrupted:
+            await asyncio.wait_for(agent.interrupted.wait(), 20)
+        execution_result.get()['result'] = {'final_response': 'first done', 'messages': []}
+        return 'first done'
+    return asks
+
+
+@pytest.mark.asyncio
+async def test_a_message_instead_of_an_answer_cancels_the_question_and_takes_over_in_queue_mode(
+        tmp_path, monkeypatch):
+    from tools import clarify_gateway as clarify
+    answers, agent = [], _Agent()
+    async with _gateway(tmp_path, 'relay-clarify-prose') as (runner, _authority, send, _outgoing, _adapter):
+        # queue mode would leave the message behind a turn that carries on without its answer
+        monkeypatch.setattr(runner, '_busy_input_mode', 'queue', raising=False)
+        executed = _stub_model(runner, monkeypatch, {'first': _asking_turn(
+            runner, agent, answers, hold_until_interrupted=True)})
+        await send(FIRST, ROOT, 'first')
+        await async_wait_until(lambda: clarify.get_pending('c-relay') is not None, timeout=20,
+                               what='the question is pending')
+        await send('1700000000.000501', ROOT, 'can i set up multiple bots', thread_id=FIRST)
+        await async_wait_until(lambda: executed == ['first', 'can i set up multiple bots'], timeout=20,
+                               what='the message ran')
+        assert answers == [clarify.CANCELLED]
+        assert agent.interrupts == ['can i set up multiple bots']
+
+
+@pytest.mark.asyncio
+async def test_a_resent_answer_is_not_run_again_as_a_new_turn(tmp_path, monkeypatch):
+    """The connector re-sends a frame whose ACK was lost: an answer consumed by the question, never
+    committed, must not reach the FIFO the second time."""
+    answers = []
+    async with _gateway(tmp_path, 'relay-clarify-resend') as (runner, _authority, send, outgoing, _adapter):
+        executed = _stub_model(runner, monkeypatch, {'first': _asking_turn(
+            runner, _Agent(), answers, hold_until_interrupted=False)})
+        await send(FIRST, ROOT, 'first')
+        from tools import clarify_gateway as clarify
+        await async_wait_until(lambda: clarify.get_pending('c-relay') is not None, timeout=20,
+                               what='the question is pending')
+        await send('1700000000.000502', ROOT, '2', thread_id=FIRST)
+        await async_wait_until(lambda: answers == ['b'], timeout=20, what='the answer resolved the question')
+        acks = lambda: [f for f in outgoing if f.get('type') == 'inbound_ack']
+        await async_wait_until(lambda: len(acks()) >= 2, timeout=20, what='both frames acknowledged')
+        await send('1700000000.000502', ROOT, '2', thread_id=FIRST)
+        await async_wait_until(lambda: len(acks()) >= 3, timeout=20, what='the re-send acknowledged')
+        # The chat's FIFO runs a later message after anything the re-send could have queued.
+        await send('1700000000.000503', ROOT, 'next', thread_id=FIRST)
+        await async_wait_until(lambda: 'next' in executed, timeout=20, what='the next message ran')
+        assert executed == ['first', 'next']
diff --git a/tests/gateway/test_boot_reserve_lock_probe.py b/tests/gateway/test_boot_reserve_lock_probe.py
index b23054804a2..fc60c207b0f 100644
--- a/tests/gateway/test_boot_reserve_lock_probe.py
+++ b/tests/gateway/test_boot_reserve_lock_probe.py
@@ -263,3 +263,87 @@ def test_cancelled_hot_serve_never_takes_the_profile_after_cleanup(tmp_path, mon
         assert not process_ownership.owns(fresh)
     finally:
         process_ownership.release(fresh)
+
+
+# C7 (tests/e2e/core/tenancy/test_two_tenant_desktop_backend.py): every served profile's cron tick
+# starts the host gateway at once. The starter that lost root re-checked which homes conflict by
+# RESERVING each one alone, which wrote its own (live) PID into a profile's gateway.lock; the starter
+# that held root then lost that profile's flock to the probe, read the record as a live owner and
+# refused at once. Both exited 1 and the fire was booked failed. A probe or a rolled-back attempt
+# must never leave a record naming a live process that does not hold the lock.
+_STARTER = """
+import sys
+from pathlib import Path
+sys.path.insert(0, sys.argv[1])
+from gateway.runtime_ownership import OwnershipConflict, ProfileOwnership, _conflicting_homes
+homes = [Path(p) for p in sys.argv[3:]]
+if sys.argv[2] == "probe":  # the losing starter's re-check of which homes conflict
+    print(len(_conflicting_homes(homes)), flush=True)
+else:  # an all-or-nothing reserve that rolls back on its last home
+    try:
+        ProfileOwnership().reserve(homes)
+    except OwnershipConflict:
+        print("rolled-back", flush=True)
+sys.stdin.readline()  # stay alive: a record naming this pid reads as a LIVE owner
+"""
+
+
+@contextmanager
+def _live_starter(kind, *homes):
+    proc = subprocess.Popen([sys.executable, "-c", _STARTER, str(Path(__file__).resolve().parents[2]), kind,
+                             *map(str, homes)], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
+    try:
+        yield proc, proc.stdout.readline().strip()
+    finally:
+        proc.kill()
+        proc.wait()
+
+
+def _boot_through_probe_flicker(root, boot, flicker_home):
+    """Boot's reserve while a plain client probe holds *flicker_home* across the first attempt and
+    its re-check (the window in which the conflict is judged), released before the retry."""
+    held = []
+
+    class Probed(ProfileOwnership):
+        attempts = 0
+
+        def reserve(self, homes, **kwargs):
+            self.attempts += 1
+            while held:
+                held.pop().close()
+            if self.attempts > 1:
+                return super().reserve(homes, **kwargs)
+            held.append(_probe_hold(flicker_home))
+            return super().reserve(homes, **kwargs)
+
+    booting = Probed()
+    try:
+        _reserve_waiting_out_browse_reconcile(booting, [root, boot], wait_s=10)
+        return booting.owns(root) and booting.owns(boot)
+    finally:
+        booting.close()
+        for handle in held:
+            handle.close()
+
+
+def test_a_conflict_probe_never_publishes_its_prober_as_the_owner(tmp_path):
+    root, boot = _homes(tmp_path)
+    before = (boot / "gateway.lock").read_bytes()
+    with _live_starter("probe", boot) as (_proc, out):
+        assert out == "0"
+        assert (boot / "gateway.lock").read_bytes() == before, "a conflict probe wrote an owner record"
+        assert _boot_through_probe_flicker(root, boot, boot)
+
+
+def test_a_rolled_back_reserve_never_leaves_a_live_owner_record(tmp_path):
+    root, boot = _homes(tmp_path)
+    blocker = _probe_hold(boot)  # the rival starter's last home is held: its reserve rolls back
+    try:
+        with _live_starter("reserve", root, boot) as (proc, out):
+            assert out == "rolled-back"
+            blocker.close()
+            assert str(proc.pid) not in (root / "gateway.lock").read_text(encoding="utf-8"), \
+                "a rolled-back reserve left its live pid as root's owner record"
+            assert _boot_through_probe_flicker(root, boot, root)
+    finally:
+        blocker.close()
diff --git a/tests/gateway/test_steer_releases_pending_clarify.py b/tests/gateway/test_steer_releases_pending_clarify.py
new file mode 100644
index 00000000000..0b7d6400211
--- /dev/null
+++ b/tests/gateway/test_steer_releases_pending_clarify.py
@@ -0,0 +1,111 @@
+"""A ``/steer`` sent while a clarify owns the turn releases it, so the steer can drain.
+
+``/steer`` lands between tool-call iterations, i.e. only once the in-flight tool batch
+returns. When the only in-flight tool is a blocking ``clarify`` waiting for the same user,
+accepting the steer deadlocks the session until ``agent.clarify_timeout`` expires, and the
+ack promises an arrival that cannot happen. The prose lane already releases a clarify it
+cannot answer (``gateway/run_inbound.py::_hm_clarify_reply``); a recognized slash command is
+*not* an answer, so it stays armed, but the steer it carries must still be able to land.
+"""
+
+import pytest
+
+from gateway.config import GatewayConfig, Platform
+from gateway.platforms.event import MessageEvent
+from gateway.run import GatewayRunner
+from gateway.session import SessionSource
+from tools import clarify_gateway
+
+SESSION_KEY = "key"
+CLARIFY_ID = "clarify-145161"
+
+
+class _Receiver:
+    """The running turn's agent, as ``_busy_steer_command`` sees it."""
+
+    _supports_active_turn_redirect = True
+
+    def __init__(self):
+        self.payload = None
+        self.clarify_waiting_at_steer = None
+
+    def steer(self, text):
+        self.payload = text
+        # Releasing the clarify wakes the agent; a steer queued after that can miss its next prep.
+        self.clarify_waiting_at_steer = clarify_gateway.get_pending(CLARIFY_ID) is not None
+        return True
+
+
+@pytest.fixture(autouse=True)
+def _no_leaked_clarify():
+    """Drop the entry this module registers, whatever the test's outcome."""
+    yield
+    clarify_gateway.resolve_gateway_clarify(CLARIFY_ID, clarify_gateway.CANCELLED)
+    clarify_gateway.wait_for_response(CLARIFY_ID, 0.01)
+    clarify_gateway.clear_session(SESSION_KEY)
+
+
+def _runner(tmp_path, monkeypatch, receiver=None):
+    monkeypatch.setattr("gateway.run._hermes_home", tmp_path)
+    runner = GatewayRunner(config=GatewayConfig())
+    if receiver is not None:
+        runner._session_state(SESSION_KEY).turn.agent = receiver
+    return runner
+
+
+def _steer_event():
+    source = SessionSource(platform=Platform.TELEGRAM, chat_id="chat", user_id="user")
+    return MessageEvent(
+        text="/steer use the second option instead", source=source, message_id="message"
+    )
+
+
+@pytest.mark.asyncio
+async def test_steer_releases_the_clarify_that_owns_the_turn(tmp_path, monkeypatch):
+    """The deadlock: a steer cannot drain while the clarify tool is still waiting."""
+    entry = clarify_gateway.register(CLARIFY_ID, SESSION_KEY, "Which option?", ["one", "two"])
+    clarify_gateway.mark_awaiting_text(entry.clarify_id)  # tapped "Other (type answer)"
+    receiver = _Receiver()
+    runner = _runner(tmp_path, monkeypatch, receiver)
+    event = _steer_event()
+
+    reply = await runner._busy_steer_command(event, SESSION_KEY, event.source)
+
+    assert receiver.payload, "the steer itself must still be accepted"
+    assert receiver.clarify_waiting_at_steer, "the steer is queued before the agent is woken"
+    assert reply and "second option" in reply
+    assert clarify_gateway.wait_for_response(entry.clarify_id, 0.05) == clarify_gateway.CANCELLED
+
+
+@pytest.mark.asyncio
+async def test_steer_releases_a_choice_prompt_too(tmp_path, monkeypatch):
+    """A native choice prompt holds the turn the same way as "Other (type answer)"."""
+    entry = clarify_gateway.register(CLARIFY_ID, SESSION_KEY, "Which option?", ["one", "two"])
+    receiver = _Receiver()
+    runner = _runner(tmp_path, monkeypatch, receiver)
+    event = _steer_event()
+
+    await runner._busy_steer_command(event, SESSION_KEY, event.source)
+
+    assert receiver.payload
+    assert clarify_gateway.wait_for_response(entry.clarify_id, 0.05) == clarify_gateway.CANCELLED
+
+
+def test_a_clarify_without_a_steer_stays_pending():
+    """Control: nothing releases the prompt until a command that needs the turn arrives."""
+    entry = clarify_gateway.register(CLARIFY_ID, SESSION_KEY, "Which option?", ["one", "two"])
+
+    assert clarify_gateway.get_pending(entry.clarify_id) is not None
+
+
+@pytest.mark.asyncio
+async def test_steer_without_a_clarify_is_unchanged(tmp_path, monkeypatch):
+    """Control: the release is a no-op when no prompt owns the turn."""
+    receiver = _Receiver()
+    runner = _runner(tmp_path, monkeypatch, receiver)
+    event = _steer_event()
+
+    reply = await runner._busy_steer_command(event, SESSION_KEY, event.source)
+
+    assert receiver.payload
+    assert reply and "second option" in reply
