index 00000000000..1c3eac22b27
--- /dev/null
+++ b/scripts/whatsapp-bridge/passkey_browser.test.mjs
@@ -0,0 +1,126 @@
+import assert from 'node:assert/strict';
+import { createHash, generateKeyPairSync, randomBytes, verify } from 'node:crypto';
+import { test } from 'node:test';
+import { getEventListeners } from 'node:events';
+import { chromium } from 'playwright-core';
+import pino from 'pino';
+import { proto, initAuthCreds, Curve, hkdf, aesDecryptGCM } from '@whiskeysockets/baileys';
+import { makeShortcakeFlow } from './passkey_flow.js';
+import { createBrowserPasskeySigner, signPasskeyInPage } from './passkey_browser.js';
+
+const options = () => Buffer.from(JSON.stringify({
+  rpId: 'whatsapp.com', challenge: randomBytes(32).toString('base64url'),
+  allowCredentials: [], userVerification: 'required', timeout: 5000,
+}));
+
+test('rejects a different relying party or page origin before calling WebAuthn', async () => {
+  const page = { url: () => 'https://example.com', evaluate: () => assert.fail('must not prompt') };
+  await assert.rejects(signPasskeyInPage(page, options(), new AbortController().signal), /official WhatsApp/);
+  const wrong = Buffer.from(JSON.stringify({ rpId: 'example.com', challenge: 'abc' }));
+  await assert.rejects(signPasskeyInPage(page, wrong, new AbortController().signal), /Unsupported/);
+});
+
+test('cancelled socket rejects an outstanding browser prompt', async () => {
+  const controller = new AbortController();
+  const page = { url: () => 'https://web.whatsapp.com', evaluate: () => new Promise(() => {}) };
+  const pending = signPasskeyInPage(page, options(), controller.signal);
+  controller.abort();
+  await assert.rejects(pending, { name: 'AbortError' });
+});
+
+test('cancellation while the browser launches closes it and releases the socket listener', async t => {
+  const controller = new AbortController();
+  let finishLaunch;
+  const launch = new Promise(resolve => { finishLaunch = resolve; });
+  t.mock.method(chromium, 'launch', () => launch);
+  let closes = 0;
+  const pending = createBrowserPasskeySigner('browser')(options(), controller.signal);
+  controller.abort();
+  finishLaunch({ close: async () => { closes += 1; }, newPage: () => assert.fail('cancelled launch must not navigate') });
+  await assert.rejects(pending, { name: 'AbortError' });
+  assert.equal(closes, 1);
+  assert.equal(getEventListeners(controller.signal, 'abort').length, 0);
+});
+
+test('browser launch failure releases the socket listener', async t => {
+  const controller = new AbortController();
+  t.mock.method(chromium, 'launch', async () => { throw new Error('browser unavailable'); });
+  await assert.rejects(createBrowserPasskeySigner('missing')(options(), controller.signal), /browser unavailable/);
+  assert.equal(getEventListeners(controller.signal, 'abort').length, 0);
+});
+
+test('real Chromium WebAuthn assertion completes the salvaged encrypted handshake offline', {
+  skip: !process.env.PASSKEY_TEST_BROWSER,
+  timeout: 30000,
+}, async () => {
+  const browser = await chromium.launch({ executablePath: process.env.PASSKEY_TEST_BROWSER, headless: true });
+  try {
+    const page = await browser.newPage();
+    // This route exists only in the test: no WhatsApp account or network request is used.
+    await page.route('**/*', route => route.fulfill({ contentType: 'text/html', body: '<title>Offline WebAuthn test</title>' }));
+    await page.goto('https://web.whatsapp.com');
+    const cdp = await page.context().newCDPSession(page);
+    await cdp.send('WebAuthn.enable');
+    const { authenticatorId } = await cdp.send('WebAuthn.addVirtualAuthenticator', { options: {
+      protocol: 'ctap2', transport: 'internal', hasResidentKey: true,
+      hasUserVerification: true, isUserVerified: true, automaticPresenceSimulation: true,
+    } });
+    const key = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+    const credentialId = randomBytes(32);
+    await cdp.send('WebAuthn.addCredential', { authenticatorId, credential: {
+      credentialId: credentialId.toString('base64'), isResidentCredential: true,
+      rpId: 'whatsapp.com', privateKey: key.privateKey.export({ type: 'pkcs8', format: 'der' }).toString('base64'),
+      userHandle: Buffer.from('offline-owner').toString('base64'), signCount: 0,
+    } });
+    const requestOptions = options();
+    let creds = initAuthCreds();
+    const sent = new Map();
+    let code;
+    let approve;
+    const flow = makeShortcakeFlow({
+      logger: pino({ level: 'silent' }),
+      getCreds: () => creds, updateCreds: patch => { creds = { ...creds, ...patch }; },
+      signAssertion: (bytes, signal) => signPasskeyInPage(page, bytes, signal),
+      confirmCode: value => { code = value; return new Promise(resolve => { approve = resolve; }); },
+      query: async node => {
+        const child = node.content[0];
+        sent.set(child.tag, child);
+        return { tag: 'iq', attrs: { type: 'result' }, content: [{ tag: 'ref', attrs: {}, content: Buffer.from('offline-ref') }] };
+      },
+    });
+    await flow.executePrologue({ requestOptions });
+    const prologue = sent.get('passkey_prologue');
+    const leaf = name => prologue.content.find(child => child.tag === name).content;
+    assert.deepEqual(Buffer.from(leaf('credential_id')), credentialId);
+    const assertion = JSON.parse(Buffer.from(leaf('webauthn_assertion')));
+    const authData = Buffer.from(assertion.response.authenticatorData, 'base64url');
+    const clientData = Buffer.from(assertion.response.clientDataJSON, 'base64url');
+    assert.equal(JSON.parse(clientData).challenge, JSON.parse(requestOptions).challenge);
+    assert.equal(JSON.parse(clientData).origin, 'https://web.whatsapp.com');
+    assert.deepEqual(authData.subarray(0, 32), createHash('sha256').update('whatsapp.com').digest());
+    assert.equal(authData[32] & 5, 5, 'user presence and verification flags must be set');
+    assert.ok(verify('sha256', Buffer.concat([authData, createHash('sha256').update(clientData).digest()]),
+      key.publicKey, Buffer.from(assertion.response.signature, 'base64url')));
+    const payload = proto.ProloguePayload.decode(leaf('prologue_payload'));
+    const companion = proto.CompanionEphemeralIdentity.decode(payload.companionEphemeralIdentity);
+    const primary = Curve.generateKeyPair();
+    const continuation = flow.handleIncomingNotification({ tag: 'notification', attrs: { from: 's.whatsapp.net', type: 'crsc_continuation' }, content: [{
+      tag: 'primary_ephemeral_identity', attrs: {}, content: proto.PrimaryEphemeralIdentity.encode({ publicKey: primary.public, nonce: randomBytes(32) }).finish(),
+    }] });
+    await new Promise(resolve => setImmediate(resolve));
+    assert.ok(code);
+    assert.equal(sent.has('encrypted_pairing_request'), false, 'owner must confirm before pairing data leaves');
+    approve();
+    await continuation;
+    const envelope = proto.EncryptedPairingRequest.decode(sent.get('encrypted_pairing_request').content);
+    const secret = Curve.sharedKey(primary.private, companion.publicKey);
+    const encryptionKey = hkdf(secret, 32, { salt: Buffer.from(`Companion Pairing ${companion.deviceType} with ref offline-ref`), info: 'Pairing Information Encryption Key' });
+    const pairing = proto.PairingRequest.decode(aesDecryptGCM(envelope.encryptedPayload, encryptionKey, envelope.iv, Buffer.alloc(0)));
+    assert.deepEqual(Buffer.from(pairing.companionPublicKey), Buffer.from(creds.noiseKey.public));
+    assert.deepEqual(Buffer.from(pairing.companionIdentityKey), Buffer.from(creds.signedIdentityKey.public));
+    assert.deepEqual(Buffer.from(pairing.advSecret), Buffer.from(creds.advSecretKey, 'base64'));
+    assert.equal(flow.hasSession(), false);
+  } finally {
+    await browser.close();
+  }
+});
diff --git a/scripts/whatsapp-bridge/passkey_crypto.js b/scripts/whatsapp-bridge/passkey_crypto.js
new file mode 100644
index 00000000000..e6f92600a82
--- /dev/null
+++ b/scripts/whatsapp-bridge/passkey_crypto.js
@@ -0,0 +1,69 @@
+// Adapted from vinikjkkj's Baileys PR #2689 (MIT). See PASSKEY-LICENSE.
+import { randomBytes } from 'node:crypto';
+import { proto, aesEncryptGCM, Curve, hkdf, sha256, bytesToCrockford } from '@whiskeysockets/baileys';
+const NONCE_BYTES = 32;
+const VERIFICATION_CODE_BYTES = 5;
+const GCM_IV_BYTES = 12;
+const ENCRYPTION_KEY_BYTES = 32;
+const EPHEMERAL_PUBLIC_KEY_BYTES = 32;
+/** HKDF `info` for the pairing-request encryption key. */
+const ENCRYPTION_KEY_INFO = 'Pairing Information Encryption Key';
+/** Generate the companion's ephemeral identity + nonce commitment for the prologue. */
+export function generateCompanionEphemeralIdentity(args) {
+    const keyPair = Curve.generateKeyPair();
+    const companionNonce = randomBytes(NONCE_BYTES);
+    const companionEphemeralIdentityBytes = proto.CompanionEphemeralIdentity.encode({
+        publicKey: keyPair.public,
+        deviceType: args.deviceType,
+        ref: args.ref
+    }).finish();
+    const commitmentHash = sha256(Buffer.concat([companionEphemeralIdentityBytes, companionNonce]));
+    const prologuePayloadBytes = proto.ProloguePayload.encode({
+        companionEphemeralIdentity: companionEphemeralIdentityBytes,
+        commitment: { hash: commitmentHash }
+    }).finish();
+    return {
+        keyPair,
+        companionNonce,
+        companionEphemeralIdentityBytes,
+        commitmentHash,
+        prologuePayloadBytes
+    };
+}
+/** Parses + validates a `PrimaryEphemeralIdentity` proto from the primary. */
+export function decodePrimaryEphemeralIdentity(bytes) {
+    const decoded = proto.PrimaryEphemeralIdentity.decode(bytes);
+    const publicKey = decoded.publicKey;
+    const nonce = decoded.nonce;
+    if (!publicKey || publicKey.length !== EPHEMERAL_PUBLIC_KEY_BYTES) {
+        throw new Error('shortcake: PrimaryEphemeralIdentity.publicKey must be 32 bytes');
+    }
+    if (!nonce || nonce.length !== NONCE_BYTES) {
+        throw new Error('shortcake: PrimaryEphemeralIdentity.nonce must be 32 bytes');
+    }
+    return { publicKey, nonce };
+}
+/** Verification code: `Crockford32( primaryNonce[0..5] XOR SHA-256(companionNonce ‖ primaryPubKey)[0..5] )`. */
+export function deriveVerificationCode(companionNonce, primary) {
+    const digest = sha256(Buffer.concat([companionNonce, primary.publicKey]));
+    const code = Buffer.alloc(VERIFICATION_CODE_BYTES);
+    for (let i = 0; i < VERIFICATION_CODE_BYTES; i += 1) {
+        code[i] = primary.nonce[i] ^ digest[i];
+    }
+    return bytesToCrockford(code);
+}
+/** AES-GCM key for the pairing request: `HKDF( X25519(companionPriv, primaryPub), salt, ENCRYPTION_KEY_INFO )`. */
+export function deriveEncryptionKey(args) {
+    const shared = Curve.sharedKey(args.companionPrivKey, args.primaryPublicKey);
+    const salt = Buffer.from(`Companion Pairing ${String(args.deviceType)} with ref ${args.ref}`);
+    return hkdf(shared, ENCRYPTION_KEY_BYTES, { salt, info: ENCRYPTION_KEY_INFO });
+}
+/** Seal the pairing request under the derived key, returning the encoded `EncryptedPairingRequest`. */
+export function encryptPairingRequest(encryptionKey, plaintext) {
+    if (encryptionKey.length !== ENCRYPTION_KEY_BYTES) {
+        throw new Error('shortcake: encryption key must be 32 bytes');
+    }
+    const iv = randomBytes(GCM_IV_BYTES);
+    const encryptedPayload = aesEncryptGCM(plaintext, encryptionKey, iv, Buffer.alloc(0));
+    return proto.EncryptedPairingRequest.encode({ encryptedPayload, iv }).finish();
+}
diff --git a/scripts/whatsapp-bridge/passkey_flow.js b/scripts/whatsapp-bridge/passkey_flow.js
new file mode 100644
index 00000000000..9fd7670663d
--- /dev/null
+++ b/scripts/whatsapp-bridge/passkey_flow.js
@@ -0,0 +1,194 @@
+// Adapted from vinikjkkj's Baileys PR #2689 (MIT). See PASSKEY-LICENSE.
+import { randomBytes } from 'node:crypto';
+import { proto, getBinaryNodeChild, getBinaryNodeChildBuffer, getBinaryNodeChildString, S_WHATSAPP_NET, hkdf, hmacSign } from '@whiskeysockets/baileys';
+import { decodePrimaryEphemeralIdentity, deriveEncryptionKey, deriveVerificationCode, encryptPairingRequest, generateCompanionEphemeralIdentity } from './passkey_crypto.js';
+/** HKDF info for the pairing handoff HMAC key (derived from the ADV secret). */
+const HANDOFF_KEY_INFO = 'shortcake-passkey-handoff-v1';
+const HANDOFF_KEY_TTL_MS = 5 * 60 * 1000;
+const Stage = Object.freeze({
+    WaitingForPrimaryIdentity: 'waiting_for_primary_identity',
+    WaitingForConfirmation: 'waiting_for_confirmation',
+    WaitingForPairing: 'waiting_for_pairing'
+});
+const mdIq = (type, content) => ({
+    tag: 'iq',
+    attrs: { to: S_WHATSAPP_NET, type, xmlns: 'md' },
+    content
+});
+/** Drives the companion side of the "Shortcake" passkey-linking handshake (md IQ exchange + commit/reveal ECDH). */
+export const makeShortcakeFlow = (opts) => {
+    let session = null;
+    let activeController = null;
+    let handoffKey = null;
+    const requestPasskeyRequestOptions = async () => {
+        const response = await opts.query(mdIq('get', [{ tag: 'passkey_request_options', attrs: {} }]));
+        const options = getBinaryNodeChildBuffer(response, 'passkey_request_options');
+        if (!options) {
+            throw new Error('shortcake: get-passkey-request-options response missing options');
+        }
+        return options;
+    };
+    const requestRef = async () => {
+        const response = await opts.query(mdIq('get', [{ tag: 'ref', attrs: {} }]));
+        const ref = getBinaryNodeChildString(response, 'ref');
+        if (!ref) {
+            throw new Error('shortcake: get-ref response missing ref');
+        }
+        return ref;
+    };
+    /** Fetch options, sign (external), fetch ref, build the commitment, send the `passkey_prologue` IQ. */
+    const executePrologue = async (args = {}) => {
+        activeController?.abort();
+        session = null;
+        const controller = new AbortController();
+        activeController = controller;
+        const { signal } = controller;
+        const deviceType = opts.deviceType ?? proto.DeviceProps.PlatformType.CHROME;
+        try {
+            const requestOptions = args.requestOptions ?? (await requestPasskeyRequestOptions());
+            signal.throwIfAborted();
+            const assertion = await opts.signAssertion(requestOptions, signal);
+            signal.throwIfAborted();
+            const ref = await requestRef();
+            signal.throwIfAborted();
+            const companion = generateCompanionEphemeralIdentity({ ref, deviceType });
+            const pairingHandoffProof = handoffKey !== null && Date.now() - handoffKey.ts < HANDOFF_KEY_TTL_MS
+                ? hmacSign(companion.prologuePayloadBytes, handoffKey.hmac)
+                : undefined;
+            const skipHandoffUx = pairingHandoffProof !== undefined;
+            const prologueChildren = [
+                { tag: 'credential_id', attrs: {}, content: assertion.credentialId },
+                { tag: 'webauthn_assertion', attrs: {}, content: assertion.webauthnAssertion },
+                { tag: 'prologue_payload', attrs: {}, content: companion.prologuePayloadBytes }
+            ];
+            if (pairingHandoffProof) {
+                prologueChildren.push({ tag: 'pairing_handoff_proof', attrs: {}, content: pairingHandoffProof });
+            }
+            await opts.query(mdIq('set', [{ tag: 'passkey_prologue', attrs: {}, content: prologueChildren }]));
+            signal.throwIfAborted();
+            session = {
+                signal,
+                companion,
+                ref,
+                deviceType,
+                skipHandoffUx,
+                stage: Stage.WaitingForPrimaryIdentity
+            };
+            opts.logger.debug({ skipHandoffUx }, 'shortcake prologue sent');
+        }
+        catch (error) {
+            // Read before the cleanup below aborts it: a signal aborted by a newer prologue or a socket
+            // close means the interrupted browser or query call's own error (e.g. ERR_ABORTED) is a
+            // cancellation, not a pairing failure.
+            const superseded = signal.aborted;
+            if (activeController === controller) {
+                controller.abort();
+                activeController = null;
+                session = null;
+            }
+            throw superseded ? signal.reason : error;
+        }
+    };
+    /** Derive a handoff HMAC key from the ADV secret and rotate it (matching the official clients). */
+    const stashHandoffKeyAndRotateAdv = () => {
+        // Once per flow: the phone only knows the secret from the QR it scanned, so a superseding request
+        // keeps that key (expiring at its use-site window) instead of deriving one from the rotated secret.
+        if (handoffKey !== null) {
+            return;
+        }
+        const creds = opts.getCreds();
+        if (!creds?.advSecretKey) {
+            return;
+        }
+        handoffKey = {
+            hmac: hkdf(Buffer.from(creds.advSecretKey, 'base64'), 32, { info: HANDOFF_KEY_INFO }),
+            ts: Date.now()
+        };
+        opts.updateCreds({ advSecretKey: randomBytes(32).toString('base64') });
+    };
+    const handlePasskeyPrologueRequest = async (node) => {
+        stashHandoffKeyAndRotateAdv();
+        const requestOptions = getBinaryNodeChildBuffer(node, 'passkey_request_options');
+        opts.logger.debug({ embeddedOptions: !!requestOptions }, 'shortcake prologue requested by server');
+        await executePrologue({ requestOptions });
+        return true;
+    };
+    /** AES-GCM seal the pairing request under `encryptionKey` and send the `encrypted_pairing_request` IQ. */
+    const sendPairingRequest = async (current, encryptionKey) => {
+        current.signal.throwIfAborted();
+        const creds = opts.getCreds();
+        const plaintext = proto.PairingRequest.encode({
+            companionPublicKey: creds.noiseKey.public,
+            companionIdentityKey: creds.signedIdentityKey.public,
+            advSecret: Buffer.from(creds.advSecretKey, 'base64')
+        }).finish();
+        const envelope = encryptPairingRequest(encryptionKey, plaintext);
+        current.stage = Stage.WaitingForPairing;
+        await opts.query(mdIq('set', [{ tag: 'encrypted_pairing_request', attrs: {}, content: envelope }]));
+        current.signal.throwIfAborted();
+        session = null;
+        opts.logger.debug('shortcake encrypted pairing request sent');
+    };
+    const handlePrimaryEphemeralIdentity = async (node) => {
+        const child = getBinaryNodeChild(node, 'primary_ephemeral_identity');
+        if (!child) {
+            return false;
+        }
+        if (!session || session.stage !== Stage.WaitingForPrimaryIdentity) {
+            opts.logger.warn('shortcake primary identity ignored: no active prologue');
+            return true;
+        }
+        const current = session;
+        try {
+            await continuePairing(current, decodePrimaryEphemeralIdentity(getBinaryNodeChildBuffer(node, 'primary_ephemeral_identity')));
+        }
+        catch (error) {
+            if (current.signal.aborted)
+                throw current.signal.reason;
+            // Ctrl+C at the code question rejects with its own AbortError; only this attempt's signal is a supersede.
+            throw error?.name === 'AbortError' ? new Error(`Passkey confirmation cancelled: ${error.message}`) : error;
+        }
+        return true;
+    };
+    const continuePairing = async (current, primary) => {
+        await opts.query(mdIq('set', [{ tag: 'companion_nonce', attrs: {}, content: current.companion.companionNonce }]));
+        current.signal.throwIfAborted();
+        const verificationCode = deriveVerificationCode(current.companion.companionNonce, primary);
+        const encryptionKey = deriveEncryptionKey({
+            companionPrivKey: current.companion.keyPair.private,
+            primaryPublicKey: primary.publicKey,
+            deviceType: current.deviceType,
+            ref: current.ref
+        });
+        current.stage = Stage.WaitingForConfirmation;
+        opts.logger.debug({ skipHandoffUx: current.skipHandoffUx }, 'shortcake verification code ready');
+        // Without a trusted handoff the owner compares the code with the phone. The attempt's own signal
+        // cancels the question when a newer prologue or a socket close replaces this attempt, so a late
+        // answer can never approve a different attempt's code.
+        if (!current.skipHandoffUx)
+            await opts.confirmCode(verificationCode, current.signal);
+        await sendPairingRequest(current, encryptionKey);
+    };
+    /** Routes `passkey_prologue_request` / `crsc_continuation`; returns `true` when consumed. */
+    const handleIncomingNotification = async (node) => {
+        if (node.attrs.from !== S_WHATSAPP_NET && node.attrs.from !== 's.whatsapp.net')
+            return false;
+        if (node.attrs.type === 'passkey_prologue_request') {
+            return handlePasskeyPrologueRequest(node);
+        }
+        if (node.attrs.type === 'crsc_continuation') {
+            return handlePrimaryEphemeralIdentity(node);
+        }
+        return false;
+    };
+    return {
+        handleIncomingNotification,
+        executePrologue,
+        hasSession: () => session !== null,
+        clearSession: () => {
+            activeController?.abort();
+            activeController = null;
+            session = null;
+        }
+    };
+};
diff --git a/scripts/whatsapp-bridge/passkey_socket.js b/scripts/whatsapp-bridge/passkey_socket.js
new file mode 100644
index 00000000000..0866786597c
--- /dev/null
+++ b/scripts/whatsapp-bridge/passkey_socket.js
@@ -0,0 +1,59 @@
+import { proto } from '@whiskeysockets/baileys';
+import { makeShortcakeFlow } from './passkey_flow.js';
+
+export async function loadPasskeySigner(executablePath, { pairOnly, pairJson, isTTY },
+  load = () => import('./passkey_browser.js')) {
+  if (!executablePath) return undefined;
+  if (!pairOnly || pairJson || !isTTY) {
+    throw new Error('--passkey-browser requires interactive --pair-only setup.');
+  }
+  return (await load()).createBrowserPasskeySigner(executablePath);
+}
+
+// Baileys still owns acknowledgement of these notifications. The handshake
+// runs separately so an interactive browser prompt cannot delay that ACK.
+// confirmCode(code, signal) resolves once the owner confirms the code matches the phone and rejects
+// otherwise; the signal aborts when this attempt is superseded or the socket closes.
+export function attachPasskeyFlow(socket, { logger, signAssertion, confirmCode }) {
+  let closed = false;
+  let pending = Promise.resolve();
+  const flow = signAssertion ? makeShortcakeFlow({
+    logger,
+    query: node => socket.query(node),
+    signAssertion,
+    getCreds: () => socket.authState.creds,
+    updateCreds: patch => socket.ev.emit('creds.update', patch),
+    deviceType: proto.DeviceProps.PlatformType.CHROME,
+    confirmCode,
+  }) : null;
+
+  function notification(node) {
+    if (closed || !['s.whatsapp.net', '@s.whatsapp.net'].includes(node.attrs.from)) return;
+    if (!['passkey_prologue_request', 'crsc_continuation'].includes(node.attrs.type)) return;
+    if (node.attrs.type === 'passkey_prologue_request') {
+      socket.ev.emit('connection.update', { passkeyRequired: { hasSigner: Boolean(flow) } });
+      // A new request supersedes the current attempt: abort its browser prompt or code question now
+      // instead of queuing behind it.
+      flow?.clearSession();
+    }
+    if (!flow) return;
+    pending = pending.then(() => {
+      if (!closed) return flow.handleIncomingNotification(node);
+    }).catch(error => {
+      if (closed || error?.name === 'AbortError') return;
+      flow.clearSession();
+      socket.ev.emit('connection.update', { passkeyError: error });
+    });
+  }
+
+  function connection(update) {
+    if (update.connection !== 'close') return;
+    closed = true;
+    flow?.clearSession();
+    socket.ws.off('CB:notification', notification);
+    socket.ev.off('connection.update', connection);
+  }
+
+  socket.ws.on('CB:notification', notification);
+  socket.ev.on('connection.update', connection);
+}
diff --git a/scripts/whatsapp-bridge/passkey_socket.test.mjs b/scripts/whatsapp-bridge/passkey_socket.test.mjs
new file mode 100644
index 00000000000..fb8e9686b9d
--- /dev/null
+++ b/scripts/whatsapp-bridge/passkey_socket.test.mjs
@@ -0,0 +1,273 @@
+import assert from 'node:assert/strict';
+import { EventEmitter } from 'node:events';
+import { test } from 'node:test';
+import { initAuthCreds, proto, Curve, hkdf, hmacSign } from '@whiskeysockets/baileys';
+import { makeShortcakeFlow } from './passkey_flow.js';
+import { attachPasskeyFlow, loadPasskeySigner } from './passkey_socket.js';
+
+test('invalid pairing modes reject before loading the browser dependency', async () => {
+  const load = () => assert.fail('invalid mode must not import Playwright');
+  for (const mode of [
+    { pairOnly: false, pairJson: false, isTTY: true },
+    { pairOnly: true, pairJson: true, isTTY: true },
+    { pairOnly: true, pairJson: false, isTTY: false },
+  ]) {
+    await assert.rejects(loadPasskeySigner('browser', mode, load), /requires interactive --pair-only/);
+  }
+  assert.equal(await loadPasskeySigner('', {}, load), undefined);
+  const signer = () => {};
+  assert.equal(await loadPasskeySigner('browser', { pairOnly: true, pairJson: false, isTTY: true }, async () => ({
+    createBrowserPasskeySigner: executable => { assert.equal(executable, 'browser'); return signer; },
+  })), signer);
+});
+
+const logger = { debug() {}, warn() {} };
+const assertion = { credentialId: Buffer.from('test-id'), webauthnAssertion: Buffer.from('{}') };
+const options = Buffer.from(JSON.stringify({ rpId: 'whatsapp.com', challenge: 'dGVzdA' }));
+const request = (from = 's.whatsapp.net') => ({
+  tag: 'notification', attrs: { from, type: 'passkey_prologue_request' },
+  content: [{ tag: 'passkey_request_options', attrs: {}, content: options }],
+});
+const refReply = () => ({ tag: 'iq', attrs: {}, content: [{ tag: 'ref', attrs: {}, content: Buffer.from('ref') }] });
+const continuation = () => ({ tag: 'notification', attrs: { from: 's.whatsapp.net', type: 'crsc_continuation' }, content: [{
+  tag: 'primary_ephemeral_identity', attrs: {}, content: proto.PrimaryEphemeralIdentity.encode({
+    publicKey: Curve.generateKeyPair().public, nonce: Buffer.alloc(32, 3),
+  }).finish(),
+}] });
+const settle = () => new Promise(resolve => setImmediate(resolve));
+
+function socket() {
+  const ws = new EventEmitter();
+  const ev = new EventEmitter();
+  const creds = initAuthCreds();
+  ev.on('creds.update', patch => Object.assign(creds, patch));
+  return { ws, ev, authState: { creds } };
+}
+
+test('official socket event contract cancels queued and active signing on close', async () => {
+  const sock = socket();
+  let finish;
+  let signal;
+  let started;
+  const signingStarted = new Promise(resolve => { started = resolve; });
+  const signing = new Promise(resolve => { finish = resolve; });
+  let calls = 0;
+  sock.query = async () => assert.fail('closed socket must not send a prologue');
+  attachPasskeyFlow(sock, { logger, signAssertion: async (_bytes, abortSignal) => {
+    calls += 1;
+    signal = abortSignal;
+    started();
+    return signing;
+  } });
+  sock.ws.emit('CB:notification', request());
+  await signingStarted;
+  sock.ws.emit('CB:notification', request());
+  sock.ev.emit('connection.update', { connection: 'close' });
+  assert.equal(signal.aborted, true);
+  assert.equal(sock.ws.listenerCount('CB:notification'), 0);
+  finish(assertion);
+  await settle();
+  assert.equal(calls, 1);
+});
+
+test('missing signer is reported and another account cannot trigger a prompt', () => {
+  const sock = socket();
+  const events = [];
+  sock.ev.on('connection.update', update => events.push(update));
+  attachPasskeyFlow(sock, { logger });
+  const before = sock.authState.creds.advSecretKey;
+  sock.ws.emit('CB:notification', request('15550000000@s.whatsapp.net'));
+  assert.deepEqual(events, []);
+  assert.equal(sock.authState.creds.advSecretKey, before);
+  sock.ws.emit('CB:notification', request());
+  assert.deepEqual(events, [{ passkeyRequired: { hasSigner: false } }]);
+  sock.ev.emit('connection.update', { connection: 'close' });
+});
+
+test('signer failure surfaces through the socket and a fresh attempt can continue', async () => {
+  const sock = socket();
+  let calls = 0;
+  let prologueSent;
+  const prologue = new Promise(resolve => { prologueSent = resolve; });
+  sock.query = async node => {
+    if (node.content[0].tag === 'passkey_prologue') prologueSent();
+    return refReply();
+  };
+  attachPasskeyFlow(sock, { logger, signAssertion: async () => {
+    calls += 1;
+    if (calls === 1) throw new Error('owner declined');
+    return assertion;
+  } });
+  const failure = new Promise(resolve => sock.ev.on('connection.update', update => {
+    if (update.passkeyError) resolve(update.passkeyError);
+  }));
+  sock.ws.emit('CB:notification', request());
+  assert.equal((await failure).message, 'owner declined');
+  sock.ws.emit('CB:notification', request());
+  await prologue;
+  assert.equal(calls, 2);
+  sock.ev.emit('connection.update', { connection: 'close' });
+});
+
+test('pairing payload waits for owner confirmation without trusted handoff', async () => {
+  const creds = initAuthCreds();
+  const sent = [];
+  let approve;
+  let asked;
+  const question = new Promise(resolve => { asked = resolve; });
+  const flow = makeShortcakeFlow({
+    logger, getCreds: () => creds, updateCreds: patch => Object.assign(creds, patch),
+    signAssertion: async () => assertion,
+    confirmCode: () => new Promise(resolve => { approve = resolve; asked(); }),
+    query: async node => { sent.push(node.content[0].tag); return refReply(); },
+  });
+  await flow.executePrologue({ requestOptions: options });
+  const handled = flow.handleIncomingNotification(continuation());
+  await question;
+  assert.equal(sent.includes('encrypted_pairing_request'), false);
+  approve();
+  await handled;
+  assert.equal(sent.filter(tag => tag === 'encrypted_pairing_request').length, 1);
+  assert.equal(flow.hasSession(), false);
+});
+
+// Production entry point: the server's prologue request goes through CB:notification, which stashes the
+// ADV-derived handoff key first. Pin both outcomes so the confirmation prompt's reachability is explicit.
+async function driveServerPrologue(t, { signingMs, confirmCode }) {
+  const sock = socket();
+  const sent = [];
+  let clock = 1_000_000;
+  t.mock.method(Date, 'now', () => clock);
+  let prologueSent;
+  const prologue = new Promise(resolve => { prologueSent = resolve; });
+  sock.query = async node => {
+    sent.push(node.content[0].tag);
+    if (node.content[0].tag === 'passkey_prologue') setImmediate(prologueSent);
+    return refReply();
+  };
+  attachPasskeyFlow(sock, { logger, confirmCode, signAssertion: async () => { clock += signingMs; return assertion; } });
+  sock.ws.emit('CB:notification', request());
+  await prologue;
+  sock.ws.emit('CB:notification', continuation());
+  await settle();
+  return { sock, sent };
+}
+
+test('server prologue within the handoff window sends the pairing request without a prompt', async t => {
+  const confirmCode = t.mock.fn(async () => {});
+  const { sock, sent } = await driveServerPrologue(t, { signingMs: 1000, confirmCode });
+  assert.equal(confirmCode.mock.callCount(), 0);
+  assert.deepEqual(sent, ['ref', 'passkey_prologue', 'companion_nonce', 'encrypted_pairing_request']);
+  sock.ev.emit('connection.update', { connection: 'close' });
+});
+
+test('server prologue past the handoff window waits for owner confirmation', async t => {
+  let approve;
+  const confirmCode = t.mock.fn(() => new Promise(resolve => { approve = resolve; }));
+  const { sock, sent } = await driveServerPrologue(t, { signingMs: 6 * 60 * 1000, confirmCode });
+  assert.equal(confirmCode.mock.callCount(), 1);
+  assert.match(confirmCode.mock.calls[0].arguments[0], /^[0-9A-Z]{8}$/);
+  assert.equal(sent.includes('encrypted_pairing_request'), false);
+  approve();
+  await settle();
+  assert.equal(sent.at(-1), 'encrypted_pairing_request');
+  sock.ev.emit('connection.update', { connection: 'close' });
+});
+
+test('a newer prologue cancels the pending code question and a late answer sends nothing', async t => {
+  const questions = [];
+  // Ignores its signal on purpose, like a prompt that still returns "y" after being superseded.
+  const confirmCode = (code, signal) => new Promise(resolve => { questions.push({ code, signal, resolve }); });
+  const { sock, sent } = await driveServerPrologue(t, { signingMs: 6 * 60 * 1000, confirmCode });
+  const errors = [];
+  sock.ev.on('connection.update', update => { if (update.passkeyError) errors.push(update.passkeyError); });
+  assert.equal(questions.length, 1);
+  sock.ws.emit('CB:notification', request());
+  assert.equal(questions[0].signal.aborted, true, 'the superseded question must be cancelled at once');
+  questions[0].resolve();
+  await settle();
+  assert.equal(sent.includes('encrypted_pairing_request'), false);
+  assert.deepEqual(errors, [], 'a superseded attempt is a cancellation, not a pairing failure');
+  sock.ev.emit('connection.update', { connection: 'close' });
+});
+
+test('a code question that fails with a plain error after supersede is a cancellation', async t => {
+  // A closed readline interface rejects with its own error rather than the abort reason.
+  const confirmCode = (_code, signal) => new Promise((_, reject) => {
+    signal.addEventListener('abort', () => reject(new Error('readline was closed')), { once: true });
+  });
+  const { sock, sent } = await driveServerPrologue(t, { signingMs: 6 * 60 * 1000, confirmCode });
+  const errors = [];
+  sock.ev.on('connection.update', update => { if (update.passkeyError) errors.push(update.passkeyError); });
+  sock.ws.emit('CB:notification', request());
+  await settle();
+  assert.deepEqual(errors, []);
+  assert.equal(sent.includes('encrypted_pairing_request'), false);
+  sock.ev.emit('connection.update', { connection: 'close' });
+});
+
+test('Ctrl+C at the code question ends the attempt instead of passing as a supersede', async t => {
+  let interrupt;
+  const confirmCode = () => new Promise((_, reject) => { interrupt = reject; });
+  const { sock, sent } = await driveServerPrologue(t, { signingMs: 6 * 60 * 1000, confirmCode });
+  const errors = [];
+  sock.ev.on('connection.update', update => { if (update.passkeyError) errors.push(update.passkeyError); });
+  // What readline/promises question() rejects with on Ctrl+C: an AbortError the attempt's signal never sent.
+  interrupt(Object.assign(new Error('Aborted with Ctrl+C'), { name: 'AbortError', code: 'ABORT_ERR' }));
+  await settle();
+  assert.equal(errors.length, 1, 'the bridge must report the cancelled prompt and exit');
+  assert.match(errors[0].message, /cancelled.*Ctrl\+C/);
+  assert.equal(sent.includes('encrypted_pairing_request'), false);
+  sock.ev.emit('connection.update', { connection: 'close' });
+});
+
+test('a superseding prologue request proves the handoff with the secret from the scanned QR', async () => {
+  const sock = socket();
+  const qrSecret = sock.authState.creds.advSecretKey;
+  const prologues = [];
+  sock.query = async node => {
+    if (node.content[0].tag === 'passkey_prologue') prologues.push(node.content[0].content);
+    return refReply();
+  };
+  const signals = [];
+  attachPasskeyFlow(sock, { logger, confirmCode: async () => {}, signAssertion: (_bytes, signal) => {
+    signals.push(signal);
+    if (signals.length > 1) return Promise.resolve(assertion);
+    return new Promise((_, reject) => signal.addEventListener('abort', () => reject(signal.reason), { once: true }));
+  } });
+  sock.ws.emit('CB:notification', request());
+  await settle();
