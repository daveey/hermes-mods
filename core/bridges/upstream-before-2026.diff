+    assert service.runtime._reconcile_indeterminate(binding, lease) is True
+    now[0] = 108.0
+    assert service.runtime._reconcile_indeterminate(binding, lease) is False
+    assert driver.get_task(db, task["identity"])["status"] == "deferred"
