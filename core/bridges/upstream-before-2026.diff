diff --git a/tests/gateway/test_session_group_closed_admission.py b/tests/gateway/test_session_group_closed_admission.py
new file mode 100644
index 00000000000..676945f1950
--- /dev/null
+++ b/tests/gateway/test_session_group_closed_admission.py
@@ -0,0 +1,68 @@
+"""A closed admission survives every grant alive when Discard confirmed it."""
+
+import asyncio
+import time
+
+import pytest
+
+from gateway import hosted_room_driver as driver
+from gateway.hosted_room_peer import MAX_STATUS_GRANT_TTL_SECONDS, room_grant_hard_expiry
+from gateway.platforms.api_server_run_idempotency import RunIdempotencyStore
+from tests.gateway.test_session_group_peer_discard import (
+    _never_admitted_deferred_turn, gateway as gateway_fixture, linked_peer as linked_peer_fixture,
+)
+from tests.gateway.test_session_group_peers import _seat, call
+from tui_gateway.hosted_room_peer_http import PeerRunsHTTPError
+from tui_gateway.hosted_room_peer_transport import build_member_dispatch
+
+gateway, linked_peer = gateway_fixture, linked_peer_fixture
+
+
+@pytest.mark.asyncio
+async def test_closed_key_blocks_delayed_admission_under_older_longer_grant(
+        gateway, monkeypatch, linked_peer, tmp_path):
+    service, db, identity = await _never_admitted_deferred_turn(gateway, monkeypatch, linked_peer)
+    route = service.peer_routes[('linked', 'reviewer')]
+    client = service.peer_clients[('linked', 'reviewer')]
+    task = driver.get_task(db, identity)
+    delayed = build_member_dispatch(
+        binding=service.bindings()[0], route=route, room_id='linked', task_id=identity.task_id,
+        target_profile='default', execution_generation=1, source_event_seq=task['payload']['source_event_seq'],
+        prompt=task['payload']['prompt'], trace_id=route.trace_id).as_mapping()
+    _, url, catalog, room = linked_peer
+    short_grant, registered = await _seat(gateway, room, url, catalog, ttl_seconds=60)
+    assert registered['registered']
+    assert (await call(gateway.owner, 'groups.discard', room_id='linked', member_id='reviewer',
+                       task_id=identity.task_id, execution_generation=1))['discarded']
+    assert driver.get_task(db, identity)['status'] == 'cancelled'
+    # Restart the member's store; the original admission has still not arrived.
+    gateway.adapter._run_idempotency_store.close()
+    gateway.adapter._run_idempotency_store = RunIdempotencyStore(str(tmp_path / 'runs.db'))
+    future = room_grant_hard_expiry(short_grant) + 1
+    assert future < room_grant_hard_expiry(route.grant)
+    monkeypatch.setattr(time, 'time', lambda: future)
+    with pytest.raises(PeerRunsHTTPError) as refused:
+        await asyncio.to_thread(client.dispatch, dispatch=delayed, grant=route.grant)
+    assert refused.value.error_code == 'idempotency_key_conflict'
+    assert gateway.adapter._run_statuses == {}
+
+
+@pytest.mark.parametrize('close_again', [False, True])
+def test_closed_keys_expire_after_the_issuers_maximum_status_lifetime(tmp_path, monkeypatch, close_again):
+    now = [100.0]
+    monkeypatch.setattr(time, 'time', lambda: now[0])
+    store = RunIdempotencyStore(str(tmp_path / 'runs.db'))
+    try:
+        assert store.find_or_close('member', 'attempt') == ('closed', None)
+        now[0] += MAX_STATUS_GRANT_TTL_SECONDS - 1
+        assert store.lookup('member', 'attempt', 'delayed')[0] == 'conflict'
+        if close_again:
+            assert store.find_or_close('member', 'attempt') == ('closed', None)
+            now[0] += 1
+            assert store.lookup('member', 'attempt', 'newer-grant')[0] == 'conflict'
+            now[0] += MAX_STATUS_GRANT_TTL_SECONDS - 2
+        now[0] += 1
+        assert store.lookup('member', 'attempt', 'fresh')[0] == 'missing'
+        assert store.reserve('member', 'attempt', 'fresh', 'run', {'status': 'running'})[0] == 'created'
+    finally:
+        store.close()
diff --git a/tests/gateway/test_session_group_discard_refused_admission.py b/tests/gateway/test_session_group_discard_refused_admission.py
new file mode 100644
index 00000000000..d27ecab74d5
--- /dev/null
+++ b/tests/gateway/test_session_group_discard_refused_admission.py
@@ -0,0 +1,152 @@
+"""Discard overlapping a Retry whose admission the member then refuses: the receipt Discard saved
+names a run the member never kept, so a later Discard asks by key again (closing it) instead of
+trusting that receipt, and Disband can finish. The closed key still refuses a late POST."""
+
+import asyncio
+
+import pytest
+
+from gateway import hosted_room_driver as driver
+from aiohttp import web
+
+from gateway.platforms import api_server_runs
+from hermes_state_runtime import RuntimeStoreError
+from tests.gateway.test_session_group_peer_discard import (
+    _never_admitted_deferred_turn, gateway as gateway_fixture, linked_peer as linked_peer_fixture,
+)
+from tests.gateway.test_session_group_peers import call
+from tui_gateway.hosted_room_peer_http import PeerRunsHTTPClient, PeerRunsHTTPError
+from tui_gateway.hosted_room_peer_transport import build_member_dispatch
+
+gateway, linked_peer = gateway_fixture, linked_peer_fixture
+
+
+def _member_admits_through_its_authority(gateway, monkeypatch, admission):
+    """The member's POST /v1/runs reserves the key, then admits to its session authority (bound
+    only once the dispatch was validated, as on a gateway that runs session authority)."""
+    from types import SimpleNamespace
+    adapter = gateway.adapter
+
+    async def no_live_owner(*_a, **_kw):
+        # Session authority runs here, but this run is not admitted to it yet.
+        monkeypatch.setattr(adapter, 'gateway_runner', SimpleNamespace(
+            session_authority=object(), session_authorities=SimpleNamespace(active=lambda: None)))
+    monkeypatch.setattr(adapter, '_admit_to_live_bot_chat', no_live_owner)
+
+    async def admit_then_unbind(*args):
+        try:
+            return await admission(*args)
+        finally:
+            monkeypatch.setattr(adapter, 'gateway_runner', None)
+    monkeypatch.setattr(api_server_runs, '_admit_run_to_authority', admit_then_unbind)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('linked_peer', [True], indirect=True)
+async def test_discard_after_a_refused_overlapping_admission_settles_the_turn(
+        gateway, monkeypatch, linked_peer):
+    service, db, identity = await _never_admitted_deferred_turn(gateway, monkeypatch, linked_peer)
+    control = dict(room_id='linked', member_id='reviewer', task_id=identity.task_id, execution_generation=1)
+    admit, overlapped = api_server_runs._admit_run_to_authority, []
+
+    async def refuse(*_a, **_kw):
+        raise RuntimeStoreError('permission_denied')
+
+    async def discard_then_refuse(adapter, launch, run_id, *args):
+        # Retry's POST reserved the key; Discard finds that reservation before admission ends.
+        overlapped.append((run_id, await call(gateway.owner, 'groups.discard', **control)))
+        monkeypatch.setattr('gateway.session_api_turn.admit_api_turn_async', refuse)
+        return await admit(adapter, launch, run_id, *args)
+
+    _member_admits_through_its_authority(gateway, monkeypatch, discard_then_refuse)
+    assert await call(gateway.owner, 'groups.retry', **control) == 'peer_unreachable'
+    (run_id, first), = overlapped
+    assert first == 'session_busy'
+    client = service.peer_clients[('linked', 'reviewer')]
+    assert client._receipt(identity.task_id, 1)['run_id'] == run_id  # the receipt Discard saved
+    assert driver.get_task(db, identity)['status'] == 'deferred'
+    assert gateway.adapter._run_statuses == {}  # the member refused it: nothing runs there
+
+    discarded = await call(gateway.owner, 'groups.discard', **control)
+    assert isinstance(discarded, dict) and discarded['discarded'], discarded
+    assert driver.get_task(db, identity)['status'] == 'cancelled'
+    route = service.peer_routes[('linked', 'reviewer')]
+    task = driver.get_task(db, identity)
+    late = build_member_dispatch(
+        binding=service.bindings()[0], route=route, room_id='linked', task_id=identity.task_id,
+        target_profile='default', execution_generation=1, source_event_seq=task['payload']['source_event_seq'],
+        prompt=task['payload']['prompt'], trace_id=route.trace_id)
+    client._runs.clear()
+    with pytest.raises(PeerRunsHTTPError) as refused:
+        await asyncio.to_thread(client.dispatch, grant=route.grant, dispatch=late.as_mapping())
+    assert refused.value.error_code == 'idempotency_key_conflict'
+    assert gateway.adapter._run_statuses == {}
+    assert 'tombstone' in await call(gateway.owner, 'groups.disband', room_id='linked')
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('linked_peer', [True], indirect=True)
+async def test_disband_after_a_refused_overlapping_admission_finishes(gateway, monkeypatch, linked_peer):
+    _service, db, identity = await _never_admitted_deferred_turn(gateway, monkeypatch, linked_peer)
+    control = dict(room_id='linked', member_id='reviewer', task_id=identity.task_id, execution_generation=1)
+    admit = api_server_runs._admit_run_to_authority
+
+    async def refuse(*_a, **_kw):
+        raise RuntimeStoreError('permission_denied')
+
+    async def discard_then_refuse(adapter, launch, run_id, *args):
+        assert await call(gateway.owner, 'groups.discard', **control) == 'session_busy'
+        monkeypatch.setattr('gateway.session_api_turn.admit_api_turn_async', refuse)
+        return await admit(adapter, launch, run_id, *args)
+
+    _member_admits_through_its_authority(gateway, monkeypatch, discard_then_refuse)
+    assert await call(gateway.owner, 'groups.retry', **control) == 'peer_unreachable'
+    assert 'tombstone' in await call(gateway.owner, 'groups.disband', room_id='linked')
+    assert driver.list_tasks(db, room_id='linked') == [] or all(
+        t['status'] == 'cancelled' for t in driver.list_tasks(db, room_id='linked'))
+    assert gateway.adapter._run_statuses == {}
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('linked_peer', [True], indirect=True)
+@pytest.mark.parametrize('case', ['running_home', 'restarted_home', 'untyped_404'])
+async def test_retry_checks_the_saved_run_before_trusting_it(gateway, monkeypatch, linked_peer, case):
+    service, db, identity = await _never_admitted_deferred_turn(gateway, monkeypatch, linked_peer)
+    control = dict(room_id='linked', member_id='reviewer', task_id=identity.task_id, execution_generation=1)
+    admit = api_server_runs._admit_run_to_authority
+
+    async def refuse(*_a, **_kw):
+        raise RuntimeStoreError('permission_denied')
+
+    with monkeypatch.context() as overlap:
+        async def discard_then_refuse(adapter, launch, run_id, *args):
+            assert await call(gateway.owner, 'groups.discard', **control) == 'session_busy'
+            overlap.setattr('gateway.session_api_turn.admit_api_turn_async', refuse)
+            return await admit(adapter, launch, run_id, *args)
+
+        _member_admits_through_its_authority(gateway, overlap, discard_then_refuse)
+        assert await call(gateway.owner, 'groups.retry', **control) == 'peer_unreachable'
+
+    key = ('linked', 'reviewer')
+    client = service.peer_clients[key]
+    saved = client._receipt(identity.task_id, 1)['run_id']
+    if case == 'restarted_home':
+        # A restarted home builds a new client, with no group chat scope bound until it's first used.
+        client = service.peer_clients[key] = PeerRunsHTTPClient(
+            base_url=client.base_url, api_key='', receipt_db_path=client.receipt_db_path)
+    if case == 'untyped_404':
+        async def no_route(*_a, **_kw):
+            return web.Response(status=404, text='Not Found')
+
+        monkeypatch.setattr(api_server_runs, '_handle_get_run', no_route)
+        assert await call(gateway.owner, 'groups.retry', **control) == 'peer_unreachable'
+        assert client._receipt(identity.task_id, 1)['run_id'] == saved
+        assert gateway.adapter._run_statuses == {}
+        return
+    retried = await call(gateway.owner, 'groups.retry', **control)
+    assert isinstance(retried, dict), retried
+    new = client._receipt(identity.task_id, 1)['run_id']
+    assert new != saved
+    assert list(gateway.adapter._run_statuses) == [new]
+    task = driver.get_task(db, identity)
+    assert task['execution_generation'] == 1 and task['status'] == 'indeterminate'
diff --git a/tests/gateway/test_session_group_local_observation.py b/tests/gateway/test_session_group_local_observation.py
new file mode 100644
index 00000000000..4005757a1fe
--- /dev/null
+++ b/tests/gateway/test_session_group_local_observation.py
@@ -0,0 +1,119 @@
+"""The same recovery contract applies to a local member owned by another profile daemon."""
+
+import asyncio
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from gateway import hosted_room_driver as driver, hosted_rooms, run
+from gateway.session_hosted_service import CanonicalHostedRoomService
+from gateway.session_hosted_transport import HostedRoomOwnerRPC, install_hosted_transport
+from hermes_state import SessionDB
+from hermes_state_runtime import begin_runtime_epoch, list_session_admissions
+from tests.gateway.test_session_hosted_transport import _server
+from tests.tui_gateway.test_hosted_room_driver_runtime import FakeSessionRPC
+
+
+@pytest.mark.parametrize('retry_during_wait', [False, True])
+def test_renewed_local_member_turn_defers_when_its_owner_socket_disappears(
+    hosted_owner, tmp_path, monkeypatch, retry_during_wait
+):
+    target_authority, loop, _, _ = hosted_owner
+    source, target = tmp_path / 'source', tmp_path / 'profiles' / 'other'
+    source.mkdir(mode=0o700)
+    target.mkdir(mode=0o700, parents=True)
+    target_authority.profile_id = str(target)
+    monkeypatch.setenv('HERMES_HOME', str(source))
+    config = run._load_gateway_config()
+    monkeypatch.setattr(run, '_load_gateway_config', lambda: {
+        **config, 'hosted_rooms': {'profiles': {'other': str(target)}}})
+    with SessionDB(source / 'state.db') as db:
+        authority = SimpleNamespace(profile_id=str(source), db=db,
+                                    epoch=begin_runtime_epoch(db, instance_id='source'))
+        service = CanonicalHostedRoomService(authority, loop)
+        service.authorize_room('alice', 'local', create=True)
+        hosted_rooms.create_room(db.db_path, room_id='local', name='Local group chat',
+            authority_gateway_id=hosted_rooms.local_authority_gateway_id(), members=[
+                {'member_id': 'host', 'profile': 'default', 'handle': 'host'},
+                {'member_id': 'helper', 'profile': 'other', 'handle': 'helper'}])
+        runtime, binding = service.runtime, service.bindings()[0]
+        runtime.prepare_room = runtime.publish_terminal = None
+        now = [time.time()]
+        start = now[0]
+        runtime.clock = lambda: now[0]
+        older = driver.TaskIdentity('local', 'older', 'thread', 'older-turn')
+        driver.admit_task(db.db_path, older, payload={'target_profile': 'default',
+            'target_member_id': 'host', 'source_event_seq': 1, 'prompt': 'Earlier input'}, clock=runtime.clock)
+        old_lease = driver.acquire_lease(db.db_path, room_id='local', gateway_id=binding.gateway_id,
+            authority_epoch=1, process_generation='previous', ttl_seconds=1, clock=lambda: start - 2)
+        driver.start_task(db.db_path, older, old_lease, expected_cancel_generation=0, clock=lambda: start - 2)
+        lease = runtime._ensure_lease(binding)
+        driver.recover_room(db.db_path, lease, clock=runtime.clock)
+        driver.defer_indeterminate_task(db.db_path, older, lease, expected_execution_generation=1,
+            expected_cancel_generation=0, reason='member_unavailable', clock=runtime.clock)
+        identity = driver.TaskIdentity('local', 'task', 'thread', 'turn')
+        driver.admit_task(db.db_path, identity, payload={'target_profile': 'other',
+            'target_member_id': 'helper', 'source_event_seq': 2, 'prompt': 'input'}, clock=runtime.clock)
+        rpc = service._resolve_member_transport(binding, driver.get_task(db.db_path, identity))
+        assert isinstance(rpc, HostedRoomOwnerRPC)
+        healthy = FakeSessionRPC()
+        healthy.ref = SimpleNamespace(session_id=healthy.add_session(profile='default', title='Group: local'))
+        resolve = service._resolve_member_transport
+        def member_transport(binding, task):
+            assert not runtime._status_lock.locked()
+            return healthy if task['payload']['target_member_id'] == 'host' else resolve(binding, task)
+        monkeypatch.setattr(service, '_resolve_member_transport', member_transport)
+        runtime.transport_resolver = member_transport
+        servers = [_server(source), _server(target)]
+        install_hosted_transport(servers[0], authority, loop, attest=service.attest)
+        install_hosted_transport(servers[1], target_authority, loop, attest=lambda *a: None)
+        for server in servers:
+            assert asyncio.run_coroutine_threadsafe(server.start(), loop).result(10)
+        history, reads, retries = rpc.history, [], []
+
+        def tick(_timeout):
+            assert now[0] < start + 100, 'observation did not retire'
+            now[0] += 16 if now[0] < start + 32 else 1
+            if retry_during_wait and now[0] == start + 40:
+                retried = service.retry_room_task('local', member_id='host', task_id='older', execution_generation=1)
+                assert retried['status'] == 'queued'
+                assert runtime._leases['local'].lease_generation == lease.lease_generation
+                retries.append(retried)
+
+        monkeypatch.setattr(runtime._wake, 'wait', tick)
+
+        def lose_owner_after_renewal(**kwargs):
+            reads.append(now[0])
+            if len(reads) == 2:
+                now[0] += 16
+                asyncio.run_coroutine_threadsafe(servers[1].stop(), loop).result(10)
+            return history(**kwargs)
+
+        monkeypatch.setattr(rpc, 'history', lose_owner_after_renewal)
+        try:
+            runtime._process_room(binding)
+            assert reads[:2] == [start, start + 16], runtime._last_error
+            assert 'observation failed after submit' in runtime._last_error
+            assert len(list_session_admissions(target_authority.db,
+                       session_id=rpc.ref.session_id, pending_only=False)) == 1
+            assert bool(retries) == retry_during_wait
+            assert now[0] == start + 62
+            assert driver.get_task(db.db_path, identity)['status'] == 'indeterminate'
+            assert driver.get_task(db.db_path, identity)['indeterminate_at'] == now[0]
+            later = driver.TaskIdentity('local', 'later', 'thread', 'later-turn')
+            driver.admit_task(db.db_path, later, payload={'target_profile': 'default',
+                'target_member_id': 'host', 'source_event_seq': 3, 'prompt': 'Continue'}, clock=runtime.clock)
+            now[0] += runtime.indeterminate_defer_seconds
+            runtime._process_room(binding)
+            assert driver.get_task(db.db_path, identity)['status'] == 'deferred'
+            assert driver.get_task(db.db_path, later)['status'] == 'settled'
+            if retry_during_wait:
+                assert driver.get_task(db.db_path, older)['execution_generation'] == 2
+                assert driver.get_task(db.db_path, older)['status'] == 'settled'
+        finally:
+            for server in servers:
+                asyncio.run_coroutine_threadsafe(server.stop(), loop).result(10)
+            if rpc._monitor is not None:
+                rpc._monitor.join(10)
+                assert not rpc._monitor.is_alive()
