diff --git a/tests/hermes_cli/test_cli_backtrack_browse.py b/tests/hermes_cli/test_cli_backtrack_browse.py
new file mode 100644
index 00000000000..d8d31461394
--- /dev/null
+++ b/tests/hermes_cli/test_cli_backtrack_browse.py
@@ -0,0 +1,258 @@
+"""Codex-style backtrack browse in the classic CLI: Esc primes (hint), Esc again opens a transcript
+pager with the latest prompt selected in reverse video; ←/→ pick prompts, ↑/↓ scroll, Enter
+prefills the composer and cuts nothing, q/Esc close."""
+
+import os
+import shutil
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+from prompt_toolkit.utils import get_cwidth
+
+from hermes_state import SessionDB
+from tests.hermes_cli.test_cli_init import _make_cli
+
+
+@pytest.fixture
+def cli(tmp_path, monkeypatch):
+    cli = _make_cli()
+    cli._session_db.close()
+    db = SessionDB(db_path=tmp_path / "state.db")
+    cli._session_db = db
+    cli.session_id = "20261105_010000_bbbbbb"
+    db.create_session(cli.session_id, source="cli")
+    for role, content in (("user", "ALPHA"), ("assistant", "a1"), ("user", "BETA"), ("assistant", "b1"),
+                          ("user", "GAMMA"), ("assistant", "g1")):
+        db.append_message(cli.session_id, role, content)
+    cli.conversation_history = db.get_messages_as_conversation(cli.session_id)
+    cli.agent = None
+    cli._agent_running = False
+    cli._attached_images = []
+    cli._prefill_input_buffer = MagicMock()
+    cli._invalidate = MagicMock()
+    cli._pending_input = MagicMock()
+    printed = []
+    monkeypatch.setattr("cli._cprint", lambda text, *a, **k: printed.append(text))
+    cli.printed = printed
+    _terminal(monkeypatch, 100, 30)
+    yield cli
+    db.close()
+
+
+def _terminal(monkeypatch, cols, rows):
+    monkeypatch.setattr(shutil, "get_terminal_size", lambda fallback=None: os.terminal_size((cols, rows)))
+
+
+def _event(text=""):
+    buf = SimpleNamespace(text=text)
+    return SimpleNamespace(app=SimpleNamespace(current_buffer=buf), current_buffer=buf)
+
+
+def _esc(cli, text=""):
+    cli._backtrack_handle_escape(_event(text))
+
+
+def _hint(cli):
+    return "".join(text for _s, text in cli._tui_hint_text())
+
+
+def _rows(cli):
+    """Rendered panel rows as [(text, is_reverse)]."""
+    rows, line, rev = [], "", False
+    for style, text in cli._get_backtrack_display_fragments():
+        for i, part in enumerate(text.split("\n")):
+            if i:
+                rows.append((line, rev))
+                line, rev = "", False
+            line += part
+            rev = rev or ("reverse" in style.split() and bool(part.strip()))
+    return rows
+
+
+def _selected_text(cli):
+    return [text for text, rev in _rows(cli) if rev]
+
+
+def test_first_esc_primes_with_the_hint_and_the_second_opens_browse_on_the_latest(cli):
+    _esc(cli)
+    assert cli._backtrack_state is None
+    assert "esc again to edit previous message" in _hint(cli)
+    _esc(cli)
+    assert cli._backtrack_state is not None
+    assert cli._backtrack_selected() == (2, "GAMMA")
+    assert cli._backtrack_primed is None and "esc again" not in _hint(cli)
+    assert any("GAMMA" in text for text in _selected_text(cli))
+
+
+def test_a_non_escape_key_cancels_the_prime(cli):
+    from prompt_toolkit.key_binding.key_processor import KeyPress
+    from prompt_toolkit.keys import Keys
+    esc = [KeyPress(Keys.Escape, "\x1b")]
+    _esc(cli)
+    cli._backtrack_after_key_press(SimpleNamespace(key_buffer=[], _previous_key_sequence=esc))
+    assert cli._backtrack_primed  # the Esc that primed keeps it
+    cli._backtrack_after_key_press(SimpleNamespace(key_buffer=esc, _previous_key_sequence=[]))
+    assert cli._backtrack_primed  # an Esc waiting for a possible Alt-sequence keeps it
+    typed = [KeyPress("x", "x")]
+    cli._backtrack_after_key_press(SimpleNamespace(key_buffer=[], _previous_key_sequence=typed))
+    assert cli._backtrack_primed is None and "esc again" not in _hint(cli)
+    _esc(cli)
+    assert cli._backtrack_state is None  # primes again rather than opening
+
+
+def test_esc_with_a_draft_never_primes(cli):
+    _esc(cli, "draft")
+    assert cli._backtrack_primed is None and cli._backtrack_state is None
+
+
+def test_zero_prompts_primes_silently_then_says_no_previous_message(cli):
+    cli.conversation_history = []
+    _esc(cli)
+    assert _hint(cli) == ""
+    _esc(cli)
+    assert cli._backtrack_state is None
+    assert any("No previous message to edit." in line for line in cli.printed)
+
+
+def test_left_right_pick_prompts_and_clamp(cli):
+    assert cli._open_backtrack_picker()
+    cli._backtrack_step(-1)  # → at the newest clamps
+    assert cli._backtrack_selected()[1] == "GAMMA"
+    for expected in ("BETA", "ALPHA", "ALPHA"):  # ← older, clamps at the oldest
+        cli._backtrack_step(1)
+        assert cli._backtrack_selected()[1] == expected
+    assert _selected_text(cli) and all("ALPHA" in text for text in _selected_text(cli))
+    cli._backtrack_step(-1)
+    assert cli._backtrack_selected()[1] == "BETA"
+
+
+def test_up_down_scroll_without_moving_the_selection(cli, monkeypatch):
+    _terminal(monkeypatch, 80, 14)  # body smaller than the transcript, so it scrolls
+    assert cli._open_backtrack_picker()
+    _rows(cli)
+    bottom = cli._backtrack_state["_scroll_offset"]
+    assert bottom > 0  # opened scrolled down to the latest prompt
+    cli._backtrack_scroll(-1)
+    _rows(cli)
+    assert cli._backtrack_state["_scroll_offset"] == bottom - 1
+    assert cli._backtrack_selected()[1] == "GAMMA"
+    page = cli._backtrack_state["_page"]
+    cli._backtrack_scroll(pages=-1)
+    _rows(cli)
+    assert cli._backtrack_state["_scroll_offset"] == max(0, bottom - 1 - (page - 1))
+    assert cli._backtrack_selected()[1] == "GAMMA"
+
+
+def test_enter_prefills_the_prompt_and_cuts_nothing(cli):
+    sid = cli.session_id
+    assert cli._open_backtrack_picker()
+    cli._backtrack_step(1)
+    cli._backtrack_choose_edit()
+    assert cli._backtrack_state is None
+    cli._prefill_input_buffer.assert_called_once_with("BETA")
+    assert cli._backtrack_edit["ordinal"] == 1
+    rows = cli._session_db._conn.execute("SELECT active FROM messages WHERE session_id = ?", (sid,)).fetchall()
+    assert [a for (a,) in rows] == [1] * 6
+    assert len(cli.conversation_history) == 6
+
+
+def test_ctrl_c_closes_browse_and_leaves_everything_as_it_was(cli):
+    # Esc and q go through the real key processor in test_cli_backtrack_keys.py.
+    assert cli._open_backtrack_picker()
+    cli._tui_handle_ctrl_c(_event())
+    assert cli._backtrack_state is None and cli._backtrack_edit is None
+    cli._prefill_input_buffer.assert_not_called()
+
+
+def test_any_other_key_closes_browse_and_is_replayed_into_the_composer(cli):
+    assert cli._open_backtrack_picker()
+    processor = MagicMock()
+    event = SimpleNamespace(app=SimpleNamespace(key_processor=processor), key_sequence=["x"])
+    cli._backtrack_close_and_replay(event)
+    assert cli._backtrack_state is None
+    processor.feed_multiple.assert_called_once_with(["x"], first=True)
+
+
+def test_rewind_command_opens_browse_directly(cli):
+    cli._handle_rewind_command("/rewind")
+    assert cli._backtrack_selected() == (2, "GAMMA")
+
+
+def test_pager_shows_prompts_and_replies_with_markers(cli):
+    assert cli._open_backtrack_picker()
+    texts = [text for text, _rev in _rows(cli)]
+    body = "\n".join(texts)
+    for marker in ("› ALPHA", "• a1", "› BETA", "• b1", "› GAMMA", "• g1"):
+        assert marker in body
+    assert "Browsing transcript" in texts[-2]
+
+
+@pytest.mark.parametrize("cols,rows", [(80, 24), (60, 16), (100, 30)])
+def test_pager_fits_the_terminal_in_cells_with_a_cjk_prompt(cli, monkeypatch, cols, rows):
+    from hermes_cli.cli_tui_mixin import _PANEL_RESERVED_BELOW
+    _terminal(monkeypatch, cols, rows)
+    prompt = "请帮我把这个函数重构成更小的部分，并解释每一步为什么这样做，同时保留原有的行为和测试。" * 3
+    cli.conversation_history = [row for n in range(6) for row in (
+        {"role": "user", "content": f"P{n} {prompt}"},
+        {"role": "assistant", "content": "\n".join(f"回答 {n} 第 {i} 行：重构完成。" for i in range(8))})]
+    assert cli._open_backtrack_picker()
+    lines = _rows(cli)
+    assert len(lines) + _PANEL_RESERVED_BELOW <= rows
+    assert {get_cwidth(text) for text, _rev in lines} == {get_cwidth(lines[0][0])}
+    assert get_cwidth(lines[0][0]) < cols
+    selected = [text for text, rev in lines if rev]
+    assert selected and "P5" in selected[0]  # the latest prompt, in reverse video, is in view
+    cli._backtrack_step(5)  # jump to the oldest: brought into view
+    selected = [text for text, rev in _rows(cli) if rev]
+    assert selected and "P0" in selected[0]
+
+
+@pytest.mark.parametrize("cols,footer", [
+    (100, "Browsing transcript · ↑↓/jk scroll · ←→/hl prompts · ↵ edit · f fork · esc back"),
+    (80, "Browsing transcript · ↑↓/jk ←→/hl · ↵ edit · f fork · esc back"),
+    (50, "Browsing transcript · ↵ edit · esc back"),
+])
+def test_footer_sheds_whole_hints_at_narrow_widths(cli, monkeypatch, cols, footer):
+    _terminal(monkeypatch, cols, 24)
+    assert cli._open_backtrack_picker()
+    hint_rows = [text.strip("│ ").rstrip() for text, _rev in _rows(cli) if "Browsing" in text]
+    assert hint_rows == [footer]  # one row, never wrapped mid-hint
+
+
+def test_a_long_url_hard_wraps_inside_the_pager(cli, monkeypatch):
+    _terminal(monkeypatch, 40, 30)
+    db, sid = cli._session_db, cli.session_id
+    db.append_message(sid, "user", "see https://example.com/" + "a" * 120)
+    cli.conversation_history = db.get_messages_as_conversation(sid)
+    assert cli._open_backtrack_picker()
+    rendered = [text for text, _rev in _rows(cli)]
+    assert rendered and {get_cwidth(text) for text in rendered} == {get_cwidth(rendered[0])}
+    assert get_cwidth(rendered[0]) <= 40
+
+
+def test_an_image_prompt_edits_as_typed_without_the_vision_note(cli):
+    note = ("[The user attached an image. Here's what it contains:\nA blue square on red.]\n"
+            "[If you need a closer look, use vision_analyze with image_url: /cache/a.png]")
+    cli.conversation_history.append({"role": "user", "content": f"{note}\n\nWhat two colors?"})
+    assert cli._backtrack_prompts()[-1] == "What two colors?"
+
+
+def test_scrolling_the_pager_never_rewraps_unchanged_history(cli, monkeypatch):
+    """Repaints after a scroll or a ←/→ step reuse the wrapped rows of every unchanged turn."""
+    from hermes_cli import cli_backtrack_browse
+    cli_backtrack_browse._block.cache_clear()
+    calls = []
+    real = cli_backtrack_browse._wrap_panel_text
+    monkeypatch.setattr(cli_backtrack_browse, "_wrap_panel_text", lambda *a, **k: calls.append(a) or real(*a, **k))
+    cli.conversation_history = [row for n in range(4) for row in (
+        {"role": "user", "content": f"P{n} " + "请帮我把这个函数重构成更小的部分" * 200},
+        {"role": "assistant", "content": f"answer {n}"})]
+    assert cli._open_backtrack_picker()
+    _rows(cli)
+    first = len(calls)
+    cli._backtrack_scroll(1)
+    _rows(cli)
+    cli._backtrack_step(1)
+    _rows(cli)
+    assert first > 0 and len(calls) - first <= 2  # only the footer row may be wrapped again per paint
diff --git a/tests/hermes_cli/test_cli_backtrack_keys.py b/tests/hermes_cli/test_cli_backtrack_keys.py
new file mode 100644
index 00000000000..eea139a21e5
--- /dev/null
+++ b/tests/hermes_cli/test_cli_backtrack_keys.py
@@ -0,0 +1,185 @@
+"""Backtrack keys driven through prompt_toolkit's real input parser and key processor.
+
+A terminal delivers Esc and the next key in one read when they are typed quickly, and the parser
+turns that pair into an Alt chord. The gesture must still open browse and apply the key, while Alt
+keys keep working whenever no prime is pending."""
+
+import asyncio
+
+import pytest
+
+from tests.waiting import async_wait_until
+
+
+@pytest.fixture
+def cli(monkeypatch):
+    from cli import HermesCLI
+
+    monkeypatch.setenv("HERMES_DEFER_AGENT_STARTUP", "1")
+    cli = HermesCLI(model="fixture", provider="openai-compat", api_key="fixture",
+                    base_url="http://127.0.0.1:1/v1")
+    cli._tui_init_run_state()
+    cli.conversation_history = [
+        {"role": "user", "content": "ALPHA"}, {"role": "assistant", "content": "a1"},
+        {"role": "user", "content": "BETA"}, {"role": "assistant", "content": "b1"},
+        {"role": "user", "content": "GAMMA"}, {"role": "assistant", "content": "g1"}]
+    cli._invalidate = lambda *a, **k: None
+    return cli
+
+
+async def _until(predicate, timeout=3.0):
+    await async_wait_until(predicate, timeout=timeout, interval=0.01)
+
+
+def _drive(cli, script):
+    """Run a real Application on a pipe; ``script(pipe, editor)`` is an async callback."""
+    from prompt_toolkit.application import Application
+    from prompt_toolkit.input import create_pipe_input
+    from prompt_toolkit.layout import Layout
+    from prompt_toolkit.output import DummyOutput
+
+    editor = cli._tui_build_input_area()
+    cli._input_area = editor
+
+    async def run():
+        with create_pipe_input() as pipe:
+            app = Application(layout=Layout(editor), key_bindings=cli._tui_build_key_bindings(),
+                              input=pipe, output=DummyOutput())
+            app.key_processor.after_key_press += cli._backtrack_after_key_press
+            cli._app = app
+            painted = asyncio.Event()
+            app.after_render += lambda _: painted.set()
+            task = asyncio.create_task(app.run_async())
+            await asyncio.wait_for(painted.wait(), 3)
+            try:
+                await script(pipe, editor)
+            finally:
+                app.exit()
+                await task
+    asyncio.run(run())
+
+
+def _selected(cli):
+    return cli._backtrack_selected() and cli._backtrack_selected()[1]
+
+
+@pytest.mark.parametrize(("prime", "payload"), [
+    (False, "\x1b\x1b\x1b[D"),  # the whole gesture in one read
+    (True, "\x1b\x1b[D"),  # primed, then Esc + ← faster than the escape timeout
+    (True, "\x1b\x1bOD"),
+    (True, "\x1bh"),
+])
+def test_esc_esc_left_typed_fast_opens_browse_on_the_older_prompt(cli, prime, payload):
+    async def script(pipe, editor):
+        if prime:
+            pipe.send_text("\x1b")
+            await _until(lambda: cli._backtrack_primed == "hint")
+        pipe.send_text(payload)
+        await _until(lambda: _selected(cli) == "BETA")
+        assert editor.text == "" and editor.buffer.cursor_position == 0
+    _drive(cli, script)
+
+
+def test_prime_then_fast_esc_enter_prefills_the_latest_prompt_without_a_newline(cli):
+    async def script(pipe, editor):
+        pipe.send_text("\x1b")
+        await _until(lambda: cli._backtrack_primed == "hint")  # lone Esc released by the timeout
+        pipe.send_text("\x1b\r")
+        await _until(lambda: cli._backtrack_edit is not None)
+        assert editor.text == "GAMMA" and cli._backtrack_state is None
+        assert cli._backtrack_edit["ordinal"] == 2
+    _drive(cli, script)
+
+
+def test_slow_esc_esc_still_opens_browse_and_real_esc_and_q_close_it(cli):
+    async def script(pipe, editor):
+        for close in ("\x1b", "q"):
+            pipe.send_text("\x1b")
+            await _until(lambda: cli._backtrack_primed == "hint")
+            pipe.send_text("\x1b")
+            await _until(lambda: cli._backtrack_state is not None)
+            pipe.send_text("\x1b[D")
+            await _until(lambda: _selected(cli) == "BETA")
+            pipe.send_text(close)
+            await _until(lambda: cli._backtrack_state is None)
+            assert editor.text == "" and cli._backtrack_edit is None
+    _drive(cli, script)
+
+
+@pytest.mark.parametrize("draft", ["", "draft"])
+def test_alt_enter_inserts_a_newline_when_nothing_is_primed(cli, draft):
+    async def script(pipe, editor):
+        editor.buffer.text = draft
+        editor.buffer.cursor_position = len(draft)
+        pipe.send_text("\x1b\r")
+        await _until(lambda: editor.text == draft + "\n")
+        assert cli._backtrack_state is None and cli._backtrack_primed is None
+    _drive(cli, script)
+
+
+@pytest.mark.parametrize("gap", [True, False])
+def test_esc_esc_on_an_erased_edit_cancels_it_and_never_opens_browse(cli, gap):
+    """The edit's prefill erased, Esc Esc (slow or in one read) disarms it: the next message is plain."""
+    async def script(pipe, editor):
+        cli._backtrack_begin_edit(1, "BETA")
+        editor.buffer.text = ""
+        if gap:
+            pipe.send_text("\x1b")
+            await _until(lambda: cli._backtrack_primed is not None)
+            pipe.send_text("\x1b")
+        else:
+            pipe.send_text("\x1b\x1b")
+        await _until(lambda: cli._backtrack_edit is None)
+        assert cli._backtrack_state is None
+    cli._prefill_input_buffer = lambda text: None
+    _drive(cli, script)
+
+
+def test_primed_chord_with_more_keys_in_the_same_read_still_opens_browse_and_applies_them(cli):
+    """Primed, then Esc + ← + ↵ in ONE read: browse opens, ← steps to the older prompt, ↵ edits it."""
+    async def script(pipe, editor):
+        pipe.send_text("\x1b")
+        await _until(lambda: cli._backtrack_primed == "hint")
+        pipe.send_text("\x1b\x1b[D\r")
+        await _until(lambda: cli._backtrack_edit is not None)
+        assert cli._backtrack_edit["ordinal"] == 1 and editor.text == "BETA"
+        assert cli._backtrack_state is None
+    _drive(cli, script)
+
+
+def test_primed_esc_enter_then_a_typed_key_in_one_read_prefills_then_types(cli):
+    """Primed, then Esc + ↵ + X in ONE read: the latest prompt is prefilled and X lands after it."""
+    async def script(pipe, editor):
+        pipe.send_text("\x1b")
+        await _until(lambda: cli._backtrack_primed == "hint")
+        pipe.send_text("\x1b\rX")
+        await _until(lambda: editor.text == "GAMMAX")
+        assert cli._backtrack_edit["ordinal"] == 2 and cli._backtrack_state is None
+    _drive(cli, script)
+
+
+@pytest.mark.parametrize(("draft", "chord", "expected"), [
+    ("", "\x1b\rX", "\nX"), ("draft", "\x1b\rX", "draft\nX")])
+def test_unprimed_alt_enter_with_a_trailing_key_in_one_read_is_a_newline_then_the_key(cli, draft, chord, expected):
+    async def script(pipe, editor):
+        editor.buffer.text = draft
+        editor.buffer.cursor_position = len(draft)
+        pipe.send_text(chord)
+        await _until(lambda: editor.text == expected)
+        assert cli._backtrack_state is None and cli._backtrack_primed is None and cli._backtrack_edit is None
+    _drive(cli, script)
+
+
+def test_a_bracketed_paste_in_browse_is_text_never_a_fork_or_close(cli):
+    async def script(pipe, editor):
+        pipe.send_text("\x1b")
+        await _until(lambda: cli._backtrack_primed == "hint")
+        pipe.send_text("\x1b")
+        await _until(lambda: cli._backtrack_state is not None)
+        sessions = cli._session_db.list_sessions_rich() if hasattr(cli._session_db, "list_sessions_rich") else None
+        pipe.send_text("\x1b[200~f\x1b[201~")
+        await _until(lambda: cli._backtrack_state is None and "f" in editor.text)
+        assert cli._backtrack_edit is None
+        if sessions is not None:
+            assert len(cli._session_db.list_sessions_rich()) == len(sessions)
+    _drive(cli, script)
diff --git a/tests/hermes_cli/test_cli_backtrack_panel_wrap.py b/tests/hermes_cli/test_cli_backtrack_panel_wrap.py
new file mode 100644
index 00000000000..af84952fd95
--- /dev/null
+++ b/tests/hermes_cli/test_cli_backtrack_panel_wrap.py
@@ -0,0 +1,61 @@
+"""Shared panel wrap helpers count terminal cells, so CJK rows never push a panel's border out."""
+
+import pytest
+from prompt_toolkit.utils import get_cwidth
+
+from hermes_cli.cli_render import _append_panel_line, _wrap_panel_text
+
+
+@pytest.mark.parametrize("text", ["Which option?\n1) keep\n2) drop", "选哪个?\n1) 保留\n2) 删除"])
+def test_panel_wrap_never_keeps_a_newline_inside_a_row(text):
+    """Shared by clarify/approval/palette panels: a raw newline in a row breaks the right border."""
+    rows = _wrap_panel_text(text, 60)
+    assert rows and not any("\n" in row or "\t" in row for row in rows)
+
+
+def test_cjk_text_wraps_and_pads_by_terminal_cells():
+    text = "请帮我把这个函数重构成更小的部分，并解释每一步为什么这样做，同时保留原有的行为和测试。" * 2
+    rows = _wrap_panel_text(text, 30)
+    assert len(rows) > 1 and all(get_cwidth(row) <= 30 for row in rows)
+    lines = []
+    for row in rows:
+        _append_panel_line(lines, "b", "c", row, 34)
+    rendered = "".join(text for _style, text in lines).rstrip("\n").split("\n")
+    assert {get_cwidth(line) for line in rendered} == {36}
+
+
+def test_plain_ascii_wraps_exactly_like_textwrap():
+    import textwrap
+    text = " ".join(f"word{i}" for i in range(40))
+    assert _wrap_panel_text(text, 30) == textwrap.wrap(text, 30, break_long_words=False, break_on_hyphens=False)
+
+
+def test_a_combining_accent_stays_with_its_letter_and_rows_fit():
+    rows = _wrap_panel_text("中中中中e\u0301", 8)
+    assert all(get_cwidth(row) <= 8 for row in rows)
+    assert "".join(rows) == "中中中中e\u0301" and not rows[-1].startswith("\u0301")
+
+
+def test_other_panels_keep_long_words_whole():
+    """Only the backtrack pager hard-splits: approval/clarify panels keep main's textwrap output."""
+    url = "https://example.com/" + "a" * 120
+    assert _wrap_panel_text("see " + url, 40) == ["see", url]
+
+
+def test_a_long_cjk_prompt_wraps_in_one_pass(monkeypatch):
+    """Each character's width is read a bounded number of times, not once per wrapped row."""
+    from hermes_cli import cli_render
+    calls = []
+    real = cli_render._cells
+    monkeypatch.setattr(cli_render, "_cells", lambda text: calls.append(len(text)) or real(text))
+    text = "请帮我把这个函数重构成更小的部分" * 375  # 6,000 characters, ~130 rows at 92 cells
+    rows = cli_render._wrap_panel_text(text, 92, break_long_words=True)
+    assert len(rows) > 100 and all(get_cwidth(row) <= 92 for row in rows)
+    assert sum(calls) <= 3 * len(text)
+
+
+@pytest.mark.parametrize("keep_ws", [False, True])
+def test_fullwidth_spaces_count_as_two_cells(keep_ws):
+    """U+3000 is whitespace but two cells wide: a row of them must still fit the panel."""
+    rows = _wrap_panel_text("a\u3000" * 30, 40, keep_ws=keep_ws)
+    assert len(rows) > 1 and all(get_cwidth(row) <= 40 for row in rows)
diff --git a/tests/hermes_cli/test_gateway_attach.py b/tests/hermes_cli/test_gateway_attach.py
new file mode 100644
index 00000000000..415945f61f2
--- /dev/null
+++ b/tests/hermes_cli/test_gateway_attach.py
@@ -0,0 +1,111 @@
+"""`hermes gateway attach`: the public attach for a third-party local client (#142159).
+
+The real CLI runs against a real control socket with a real ticket store: it prints the owner's
+WebSocket URL and one single-use ticket bound to the caller's profile, or the bootstrap's verdict.
+"""
+import asyncio
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import threading
+
+import pytest
+
+from gateway.control_socket import GatewayControlServer
+from gateway.runtime_bootstrap import TicketStore
+from gateway.session_contract import CANONICAL_GATEWAY_PROTOCOL
+
+REPO = Path(__file__).resolve().parents[2]
+
+
+@pytest.fixture
+def home(request):
+    # Short and symlink-free: the socket path must fit sun_path, and the server refuses to mint
+    # for a home whose path crosses a symlink (macOS's /var).
+    root = Path(tempfile.mkdtemp(prefix="h-")).resolve()
+    request.addfinalizer(lambda: shutil.rmtree(root, ignore_errors=True))
+    home = root / "home"
+    home.mkdir(mode=0o700)
+    return home
+
+
+def _attach(home, *flags):
+    env = {**os.environ, "HERMES_HOME": str(home), "PYTHONPATH": str(REPO)}
+    return subprocess.run([sys.executable, "-m", "hermes_cli.main", "gateway", "attach", "--json", *flags],
+                          cwd=REPO, env=env, capture_output=True, text=True, timeout=120, stdin=subprocess.DEVNULL,
+                          check=False)
+
+
+def _serve(home, tickets):
+    """A ready owner's control socket on its own loop; returns a stop callable."""
+    identify = {"runtime_protocol": 1, "state": "ready", "served_profiles": [{"home": str(home), "profile_id": str(home)}],
+                "capabilities": ["session-authority-v1"], "authority_epoch": 1, "instance_id": "owner",
+                "api_origin": "http://127.0.0.1:8765", "supervisor": "none"}
+    server = GatewayControlServer(home, verb_handlers={"identify": lambda: identify})
+    server.ticket_store = tickets
+    loop = asyncio.new_event_loop()
+    threading.Thread(target=loop.run_forever, daemon=True).start()
+    assert asyncio.run_coroutine_threadsafe(server.start(), loop).result(10)
+
+    def stop():
+        asyncio.run_coroutine_threadsafe(server.stop(), loop).result(10)
+        loop.call_soon_threadsafe(loop.stop)
+    return stop
+
+
+@pytest.mark.platforms("linux", "macos")
+def test_attach_prints_the_url_and_a_single_use_profile_ticket(home):
+    tickets = TicketStore("owner", frozenset({str(home)}))
+    stop = _serve(home, tickets)
+    try:
+        run = _attach(home)
+        _check_attached(run, home, tickets)
+    finally:
+        stop()  # revokes every ticket, so redeem first
+
+
+def _check_attached(run, home, tickets):
+    assert run.returncode == 0, run.stderr
+    result = json.loads(run.stdout)
+    ticket = result["ticket"]
+    assert result["state"] == "ready" and result["endpoint"]["profile_id"] == str(home)
+    assert result["url"] == "ws://127.0.0.1:8765/api/ws"
+    assert result["protocol"] == CANONICAL_GATEWAY_PROTOCOL
+    assert result["protocols"] == [CANONICAL_GATEWAY_PROTOCOL, f"hermes-gateway-ticket.{ticket}"]
+    # Only the calling process's stdout carries the credential.
+    assert ticket not in run.stderr
+    assert not [p for p in home.rglob("*") if p.is_file() and ticket in p.read_text(errors="ignore")]
+    grant = tickets.redeem(ticket, profile_id=str(home), purpose="interactive")
+    assert grant["profile_id"] == str(home) and grant["scope"] == "profile"
+    with pytest.raises(PermissionError):
+        tickets.redeem(ticket, profile_id=str(home), purpose="interactive")
+
+
+def test_attach_without_an_owner_reports_the_bootstrap_verdict(home):
+    run = _attach(home)
+    assert run.returncode == 5, run.stderr
+    result = json.loads(run.stdout)
+    assert result["state"] == "absent" and result["endpoint"] is None
+    assert result["message"] == "gateway absent: not ready" and "gateway absent: not ready" in run.stderr
+    assert "ticket" not in result and "url" not in result
+
+
+@pytest.mark.platforms("linux", "macos")
+def test_a_ready_owner_that_refuses_the_ticket_is_one_bounded_verdict(home):
+    """No ticket store: the owner answers identify (ready) but refuses session-ticket. A client that
+    retries on this reply needs one JSON line, exit 7 and no credential, never a traceback."""
+    stop = _serve(home, None)
+    try:
+        run = _attach(home)
+    finally:
+        stop()
+    assert run.returncode == 7, run.stderr
+    assert len(run.stdout.splitlines()) == 1 and "Traceback" not in run.stderr
+    result = json.loads(run.stdout)
+    assert (result["state"], result["reason_code"]) == ("inaccessible", "ticket_unavailable")
+    assert result["message"].startswith("gateway inaccessible: ticket_unavailable")
+    assert "ticket" not in result and "url" not in result
diff --git a/tests/hermes_cli/test_memory_provider_seams_hosted.py b/tests/hermes_cli/test_memory_provider_seams_hosted.py
new file mode 100644
index 00000000000..0090cb9d63a
--- /dev/null
+++ b/tests/hermes_cli/test_memory_provider_seams_hosted.py
@@ -0,0 +1,188 @@
+"""plugins.isolation: host — the memory-provider seams cross the plugin host: a refused panel save
+(``json.JSONDecodeError`` raised in the host) is a 400 with no secret saved, a profile hook runs in
+the host with the new profile's home, and a host started only for that hook does not outlive it."""
+
+import json
+import os
+
+import hermes_yaml as yaml
+import pytest
+
+from hermes_cli import plugins as plugins_mod
+
+_INIT = """
+import json
+import os
+from pathlib import Path
+
+from agent.memory_provider import MemoryProvider
+
+
+class HostedProv(MemoryProvider):
+    name = "hostedprov"
+
+    def is_available(self):
+        return True
+
+    def initialize(self, session_id, **kwargs):
+        pass
+
+    def get_tool_schemas(self):
+        return []
+
+    def on_profile_created(self, profile_name, hermes_home):
+        (Path(hermes_home) / "hook.json").write_text(json.dumps({"name": profile_name, "pid": os.getpid()}))
+
+    def read_config_fields(self, hermes_home):
+        return {"values": json.loads((Path(hermes_home) / "hostedprov.json").read_text())}
+
+    def write_config_fields(self, values, hermes_home):
+        path = Path(hermes_home) / "hostedprov.json"
+        cfg = json.loads(path.read_text()) if path.exists() else {}  # JSONDecodeError on a corrupt file
+        cfg.update(values)
+        path.write_text(json.dumps(cfg))
+
+
+def _on_session_start(**kwargs):
+    return None
+
+
+def _hosted_tool(args, **kwargs):
+    return "ok"
+
+
+def _passthrough(payload, **kwargs):
+    return None
+
+
+def _session_env(session_id):
+    return {"HOSTEDPROV_SESSION": session_id}
+
+
+def register(ctx):
+    ctx.register_memory_provider(HostedProv())
+    ctx.register_hook("on_session_start", _on_session_start)
+    ctx.register_tool(name="hostedprov_probe", toolset="hostedprov", handler=_hosted_tool,
+                      schema={"name": "hostedprov_probe", "description": "probe", "parameters": {"type": "object", "properties": {}}})
+    ctx.register_middleware("tool_request", _passthrough)
+    ctx.register_session_env("HOSTEDPROV_SESSION", _session_env)
+    ctx.register_rpc("probe", _passthrough)
+    (Path(os.environ["HERMES_HOME"]) / "registered.json").write_text("{}")  # register() ran to the end
+"""
+
+_SCHEMA = """
+from plugins.memory.config_schema import KIND_SECRET, KIND_TEXT, STORAGE_PROVIDER, ProviderConfigSchema, ProviderField
+
+CONFIG_SCHEMA = ProviderConfigSchema(
+    name="hostedprov", label="Hosted", storage=STORAGE_PROVIDER,
+    fields=(ProviderField(key="apiKey", label="Key", kind=KIND_SECRET, description="", env_key="HOSTEDPROV_API_KEY"),
+            ProviderField(key="workspace", label="Workspace", kind=KIND_TEXT, description="")),
+)
+"""
+
+
+@pytest.fixture(params=["hostedprov", "hostedprov_pkg"])
+def hosted_home(request, tmp_path, monkeypatch):
+    """``hostedprov_pkg``: a pip provider whose package dir is named differently from the provider,
+    found through its entry point (the loader registers under the dir's name)."""
+    home = tmp_path / ".hermes"
+    plugin_dir = home / "plugins" / request.param
+    plugin_dir.mkdir(parents=True)
+    if request.param != "hostedprov":
+        import plugins.memory as memory_plugins
+        real = memory_plugins.find_provider_dir
+        monkeypatch.setattr(memory_plugins, "find_provider_dir",
+                            lambda name: plugin_dir if name == "hostedprov" else real(name))
+    (plugin_dir / "__init__.py").write_text(_INIT, encoding="utf-8")
+    (plugin_dir / "config_schema.py").write_text(_SCHEMA, encoding="utf-8")
+    (home / "config.yaml").write_text(yaml.safe_dump(
+        {"plugins": {"isolation": "host"}, "memory": {"provider": "hostedprov"}}), encoding="utf-8")
+    monkeypatch.setenv("HOME", str(tmp_path / "os-home"))
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    plugins_mod._reset_plugin_managers_for_tests()
+    yield home
+    for manager in plugins_mod._known_plugin_managers():
+        host = getattr(manager, "_plugin_host_instance", None)
+        if host is not None:
+            host.shutdown()
+    plugins_mod._reset_plugin_managers_for_tests()
+
+
+@pytest.mark.platforms("any")  # the host is a child process
+def test_a_refused_save_crosses_the_host_as_a_400_with_no_secret_saved(hosted_home):
+    from starlette.testclient import TestClient
+    from hermes_cli.config import load_env
+    from hermes_cli.web_server import _SESSION_HEADER_NAME, _SESSION_TOKEN, app
+
+    (hosted_home / "hostedprov.json").write_text("{not json", encoding="utf-8")
+    client = TestClient(app, headers={_SESSION_HEADER_NAME: _SESSION_TOKEN})
+
+    resp = client.put("/api/memory/providers/hostedprov/config?surface=declared",
+                      json={"values": {"workspace": "w", "apiKey": "hp-key"}})
+
+    assert resp.status_code == 400
+    assert "HOSTEDPROV_API_KEY" not in load_env()
+    assert (hosted_home / "hostedprov.json").read_text(encoding="utf-8") == "{not json"
+
+
+@pytest.mark.platforms("any")
+def test_a_profile_hook_runs_in_the_host_and_its_host_is_stopped(hosted_home):
+    from hermes_cli.profiles import create_profile
+
+    work = create_profile("work", clone_config=True, no_alias=True)
+
+    seen = json.loads((work / "hook.json").read_text())
+    assert seen["name"] == "work" and seen["pid"] != os.getpid()
+    hosts = [getattr(m, "_plugin_host_instance", None) for m in plugins_mod._known_plugin_managers()]
+    assert not any(h is not None and h.alive for h in hosts)
+    # Everything the hook-only load registered proxied into the stopped host: hook, tool,
+    # middleware, session env and RPC method are all gone from the new profile's manager.
+    from hermes_cli.plugins_session_env import _REGISTRATIONS
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+    from tools.registry import registry
+    assert (work / "registered.json").exists()
+    token = set_hermes_home_override(str(work))
+    try:
+        manager = plugins_mod.get_plugin_manager()
+        assert not any(manager._ownership_ledger.values())
+        assert not manager._hooks.get("on_session_start")
+        assert registry.get_entry("hostedprov_probe", scope=manager.scope_key) is None
+        assert not manager._middleware.get("tool_request")
+        assert not manager._plugin_rpc_methods
+        assert not [r for r in _REGISTRATIONS.values() if r[0] == manager.scope_key]
+    finally:
+        reset_hermes_home_override(token)
+
+
+@pytest.mark.platforms("any")
+def test_a_host_already_running_for_that_profile_is_left_alone(hosted_home):
+    """Rename fires the hook too: a host the dashboard already runs for that profile keeps running."""
+    from unittest.mock import patch
+
+    from hermes_cli.profiles import create_profile, rename_profile
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+    create_profile("work", clone_config=True, no_alias=True)
+
+    from hermes_cli import profile_memory_config as pmc  # rename late-imports notify from here
+    calls = []
+    original = pmc.notify_memory_provider
+
+    def notify_with_host_up(profile_dir, call):
+        token = set_hermes_home_override(str(profile_dir))
+        try:
+            manager = plugins_mod.get_plugin_manager()
+            manager._plugin_host().ensure_started()
+            calls.append((manager, manager._running_plugin_host().pid))
+        finally:
+            reset_hermes_home_override(token)
+        original(profile_dir, call)
+
+    with patch.object(pmc, "notify_memory_provider", notify_with_host_up), \
+            patch("hermes_cli.profiles.check_alias_collision", return_value="skip"):
+        play = rename_profile("work", "play")
+
+    (manager, pid), = calls
+    host = manager._running_plugin_host()
+    assert host is not None and host.pid == pid
+    assert json.loads((play / "hook.json").read_text())["name"] == "work"  # created hook, cloned along
