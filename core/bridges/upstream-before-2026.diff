@@ -0,0 +1,43 @@
+"""Owed revokes never decide coverage from a grant's unsigned claims: the home cannot check a member
+gateway's signature, so bad-signature grants filling one member's owed-revoke slots never make a real
+grant handed in after them go unrevoked."""
+
+import time
+
+import pytest
+
+from gateway import hosted_rooms
+from tests.gateway.test_hosted_room_owed_revoke_bounds import _grant, _owe, _rows
+from tests.gateway.test_session_group_peers import _grant_error, call, invite
+from tests.gateway.test_session_group_peers import gateway as gateway_fixture
+from tests.gateway.test_session_group_peers import linked_peer as linked_peer_fixture
+
+gateway, linked_peer = gateway_fixture, linked_peer_fixture
+
+
+def test_a_full_member_refuses_instead_of_dropping_a_grant(tmp_path):
+    db, now = tmp_path / "state.db", time.time()
+    for index in range(hosted_rooms.MAX_OWED_REVOKES_PER_MEMBER):
+        _owe(db, _grant(now + 86400 + index, f"forged{index}"))  # claims to outlive the real one
+    before = _rows(db)
+    with pytest.raises(hosted_rooms.OwedRevokesFullError):
+        _owe(db, _grant(now + 3600, "real"))
+    with pytest.raises(hosted_rooms.OwedRevokesFullError):
+        _owe(db, _grant(now + 10**6, "longer"))  # nor is an owed row evicted for an unsigned claim
+    assert _rows(db) == before
+
+
+@pytest.mark.asyncio
+async def test_forged_grants_in_every_slot_do_not_keep_a_real_grant_alive(gateway, linked_peer):
+    """The room ended before its invitation was registered, and its member's owed-revoke slots hold
+    bad-signature grants claiming longer lifetimes: the real grant is revoked at its member now."""
+    _server, url, catalog, room = linked_peer
+    grant = (await invite(gateway, room))['grant']
+    assert 'tombstone' in await call(gateway.owner, 'groups.disband', room_id='linked')
+    now = time.time()
+    for index in range(hosted_rooms.MAX_OWED_REVOKES_PER_MEMBER):
+        _owe(gateway.db.db_path, _grant(now + 86400 + index, f"forged{index}"), room='linked', member='reviewer')
+    refused = await call(gateway.owner, 'groups.peer.register', room_id='linked', member_id='reviewer',
+                         target_url=url, target_profile='default', grant=grant, catalog=catalog)
+    assert not isinstance(refused, dict), refused
+    assert await _grant_error(url, grant) == 'room_reauthorization_required'
diff --git a/tests/gateway/test_hosted_room_renewal_publication.py b/tests/gateway/test_hosted_room_renewal_publication.py
new file mode 100644
index 00000000000..1e26d09bf7f
--- /dev/null
+++ b/tests/gateway/test_hosted_room_renewal_publication.py
@@ -0,0 +1,62 @@
+"""Renewal serializes its durable route publication with re-seating and Disband."""
+
+import asyncio
+import threading
+
+import pytest
+
+from gateway import hosted_room_links, hosted_rooms
+from tests.gateway.test_session_group_peers import gateway as gateway_fixture, linked_peer as linked_peer_fixture, _seat, call
+
+gateway = gateway_fixture
+linked_peer = linked_peer_fixture
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('operation', ['register', 'disband'])
+async def test_renewal_save_cannot_overwrite_registration_or_disband(gateway, monkeypatch, linked_peer, operation):
+    _peer, url, catalog, room = linked_peer
+    service, key = gateway.service, ('linked', 'reviewer')
+    reached, release, lock = threading.Event(), threading.Event(), threading.Lock()
+
+    class PublicationLock:
+        def __enter__(self):
+            if not lock.acquire(blocking=False):
+                release.set()  # The competitor must wait for renewal's publication.
+                assert lock.acquire(timeout=10)
+
+        def __exit__(self, *args):
+            lock.release()
+
+    try:
+        original, _ = await _seat(gateway, room, url, catalog)
+        save = service._save_link
+
+        def paused_save(**link):
+            if link['grant'] == 'renewed-grant':
+                reached.set()
+                assert release.wait(10)
+            save(**link)
+
+        monkeypatch.setattr(service, '_save_link', paused_save)
+        monkeypatch.setattr(service, 'peer_route_lock', PublicationLock())
+        renewal = asyncio.create_task(asyncio.to_thread(
+            service._rotate_route_grant, *key, 'renewed-grant', previous=original))
+        assert await asyncio.to_thread(reached.wait, 10)
+        if operation == 'register':
+            replacement, result = await _seat(gateway, room, url, catalog)
+            assert result['registered'], result
+        else:
+            assert 'tombstone' in await call(gateway.owner, 'groups.disband', room_id='linked')
+        release.set()  # Without serialization, let renewal save after its competitor finishes.
+        await renewal
+        links = hosted_room_links.load_room_links(service.db_path)
+        if operation == 'register':
+            assert service.peer_routes[key].grant == links[0].grant == replacement
+        else:
+            assert key not in service.peer_routes and links == ()
+            with pytest.raises(hosted_rooms.HostedRoomError):
+                service._rotate_route_grant(*key, 'late-renewal', previous=original)
+            assert hosted_room_links.load_room_links(service.db_path) == ()
+    finally:
+        release.set()
