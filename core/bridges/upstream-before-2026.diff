+    # Documented in MemoryProvider.initialize: forks tell their shape apart by platform + parent.
+    if getattr(agent, "_parent_session_id", None):
+        kwargs["parent_session_id"] = agent._parent_session_id
+    if kwargs["platform"] == "cli":
