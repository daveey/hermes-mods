+
+        async def run_room(desc):
+            nonlocal exhausted
+            async with websocket(home, desc) as ws:
+                created = await rpc(ws, 'groups.create', room_id='switch-room', name='Switch room', members=[
+                    {'member_id': 'one', 'profile': 'default', 'handle': 'one'},
