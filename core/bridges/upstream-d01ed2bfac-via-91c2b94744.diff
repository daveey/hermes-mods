+docs_url: https://kinnuworks.github.io/ci-red-to-green/
+version: "0.2.5"
+image: https://raw.githubusercontent.com/kinnuworks/ci-red-to-green/83009f03e864264524b8c18bed4ec5423680ab4b/docs/assets/banner.png
+platforms: [linux, macos]
+capabilities:
+  provides_tools: []
+  provides_hooks:
+    - pre_llm_call
+    - pre_tool_call
+    - post_tool_call
+  provides_middleware: []
+  requires_env:
+    - CI_RED_TO_GREEN_GITHUB_TOKEN
