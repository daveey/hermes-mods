+            "SELECT status, COUNT(*) FROM hosted_room_driver_tasks WHERE room_id=? GROUP BY status", (room_id,))}
+        rows = _tasks_in_order(conn, room_id, statuses) if statuses else []
+    return counts, [_task_from_row(row) for row in rows]
