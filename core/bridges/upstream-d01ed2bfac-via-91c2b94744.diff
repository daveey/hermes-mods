+@pytest.mark.asyncio
+async def test_empty_transcript_still_emits_no_media_marker():
+    """The empty/inaudible sentinel (#41603) is unchanged by this fix.
+
+    That branch deliberately does NOT surface a transcript, and it `continue`s
