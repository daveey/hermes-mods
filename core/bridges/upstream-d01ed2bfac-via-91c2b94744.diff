+++ b/tests/tools/test_hosted_relative_paths.py
@@ -0,0 +1,215 @@
+"""A hosted relative path is never anchored on this host: neither a ``~`` TERMINAL_CWD expanded against this
+host's HOME nor the process working directory is sent to the sandbox or returned to the model. Outside a hosted
+scope both keep their local meaning."""
+
+from __future__ import annotations
+
+import json
+import posixpath
+
+import pytest
+
+from tests.tools.test_sandbox_scope_conformance import provider as _conformance_provider
+from tests.tools.test_sandbox_scope_conformance import A
+from tools.environments import sandbox_conformance as c
+
+provider = _conformance_provider  # the recording-sandbox fixture, by its name
+
+
+@pytest.fixture
+def host_paths(monkeypatch, tmp_path):
+    """A host HOME outside ``/home`` and ``/Users`` (a service account, a container data dir) and a host process
+    cwd, neither of which a hosted call may name."""
+    home, cwd = tmp_path / "hosthome-zz9", tmp_path / "host-proc-cwd"
+    home.mkdir()
+    cwd.mkdir()
+    monkeypatch.setenv("HOME", str(home))
+    monkeypatch.chdir(cwd)
+    return str(home), str(cwd)
+
+
+def _record_cwds(monkeypatch) -> tuple[list[str], list[tuple[str, str]]]:
+    """The cwd each sandbox was created with, and ``(command, cwd)`` of each command it ran."""
+    created: list[str] = []
+    ran: list[tuple[str, str]] = []
+    create, execute = c.RecordingSandboxProvider.create_environment, c.RecordingSandboxEnvironment.execute
+    monkeypatch.setattr(c.RecordingSandboxProvider, "create_environment",
+                        lambda self, **kw: created.append(kw["cwd"]) or create(self, **kw))
+    monkeypatch.setattr(c.RecordingSandboxEnvironment, "execute",
+                        lambda self, command, cwd="", **kw: ran.append((command, cwd)) or execute(self, command, cwd, **kw))
+    return created, ran
+
+
+def _sent(provider) -> str:
+    return "\n".join(f"{call.command}\n{call.stdin}" for call in provider.calls)
+
+
+def test_hosted_terminal_cwd_tilde_is_the_sandbox_home_never_this_hosts(provider, monkeypatch, host_paths):
+    """``TERMINAL_CWD='~'`` names the sandbox's home. The recording backend declares none, so the unchanged container
+    sanity check discards the unexpanded ``~`` for the backend default, and the terminal and the file tools both
+    work there."""
+    host_home, host_cwd = host_paths
+    monkeypatch.setenv("TERMINAL_CWD", "~")
+    created, ran = _record_cwds(monkeypatch)
+    with c._bind(A):
+        written = c.call_tool("write_file", {"path": "rel.txt", "content": "x\n"}, task_id="t")
+        terminal = c.call_tool("terminal", {"command": "pwd"}, task_id="t")
+    assert created == ["/root"], created
+    assert written.get("resolved_path") == "/root/rel.txt", written
+    assert [cwd for command, cwd in ran if command == "pwd"] == [posixpath.dirname(written["resolved_path"])], ran
+    sent, returned = _sent(provider), json.dumps([written, terminal])
+    for host_path in (host_home, host_cwd):
+        assert host_path not in sent and host_path not in returned, (host_path, sent, returned)
+
+
+@pytest.mark.parametrize(("default_cwd", "expected"), [("~", "/workspace/rel.txt"), (None, "/root/rel.txt")])
+def test_hosted_relative_path_anchors_in_the_sandbox_default(provider, monkeypatch, host_paths, default_cwd, expected):
+    """Controls: a ``~`` default the sandbox resolved (``/workspace``), and no declared default (``/root``)."""
+    if default_cwd is not None:
+        monkeypatch.setattr(c.RecordingSandboxProvider, "default_cwd", property(lambda self: default_cwd),
+                            raising=False)
+    with c._bind(A):
+        written = c.call_tool("write_file", {"path": "rel.txt", "content": "x\n"}, task_id="t")
+    assert written.get("resolved_path") == expected, written
+    assert not any(host_path in _sent(provider) for host_path in host_paths)
+
+
+def test_local_terminal_cwd_tilde_still_expands_to_this_hosts_home(monkeypatch, host_paths):
+    """With no scope bound a ``~`` TERMINAL_CWD is this host's HOME, as it always was."""
+    from tools.terminal_tool import _resolve_config_cwd
+
+    host_home, _ = host_paths
+    monkeypatch.setenv("TERMINAL_CWD", "~")
+    assert _resolve_config_cwd("docker", False) == (host_home, None)
+
+
+def test_local_relative_path_still_anchors_on_the_process_cwd(monkeypatch, host_paths):
+    """With no scope bound and no configured cwd a relative write lands in the process cwd, as it always did."""
+    import os
+
+    import model_tools  # registers the tools dispatched through the registry
+    from tools import file_tools, terminal_tool
+
+    _, host_cwd = host_paths
+    monkeypatch.setenv("TERMINAL_ENV", "local")
+    monkeypatch.delenv("TERMINAL_CWD", raising=False)
+    monkeypatch.setattr(terminal_tool, "_active_environments", {})
+    monkeypatch.setattr(terminal_tool, "_last_activity", {})
+    monkeypatch.setattr(file_tools, "_file_ops_cache", {})
+    monkeypatch.setattr(terminal_tool, "_task_env_overrides", {})
+    monkeypatch.setattr(terminal_tool, "_session_cwd", {})
+    written = c.call_tool("write_file", {"path": "rel.txt", "content": "x\n"}, task_id="t")
+    expected = os.path.join(os.path.realpath(host_cwd), "rel.txt")
+    assert written.get("resolved_path") == expected, written
+    with open(expected, encoding="utf-8") as fh:
+        assert fh.read() == "x\n"
+
+
+@pytest.fixture
+def unknown_sandbox_cwd(monkeypatch):
+    """Shape A: the backend's default cwd is ``~`` and the sandbox declares no usable home (its environment reports a
+    relative cwd), so no in-sandbox directory is known to anchor a relative path on."""
+    monkeypatch.setattr(c.RecordingSandboxProvider, "default_cwd", property(lambda self: "~"), raising=False)
+    monkeypatch.setattr(c.RecordingSandboxProvider, "create_environment",
+                        lambda self, **kw: c.RecordingSandboxEnvironment(self, kw["sandbox"], "relative-cwd"))
+
+
+_RELATIVE_CALLS = [
+    ("write_file", {"path": "rel.txt", "content": "x\n"}, "'rel.txt'"),
+    ("read_file", {"path": "rel.txt"}, "'rel.txt'"),
+    ("patch", {"path": "rel.txt", "old_string": "x", "new_string": "y"}, "'rel.txt'"),
+    ("search_files", {"pattern": "x", "path": "."}, "'.'"),
+]
+
+
+def test_hosted_relative_path_with_no_known_sandbox_cwd_is_sent_as_written(provider, host_paths, unknown_sandbox_cwd):
+    """With no known sandbox directory a relative path is the sandbox's to anchor: every file tool sends it as written,
+    never joined to this host's process cwd or HOME, refuses nothing, and looks nothing up on this host."""
+    from pathlib import Path
+
+    host_home, host_cwd = host_paths
+    results, sent, looked_up = [], [], []
+    with c._watch_host(Path(host_cwd)), c._watch_host(Path(host_home)) as touched, c._bind(A):
+        # The write guards check this host's fixed approval / deny list on every write, whatever the path: what a
+        # hosted write and patch of an ABSOLUTE sandbox path touch here is exactly that list.
+        c.call_tool("write_file", {"path": "/workspace/abs.txt", "content": "x\n"}, task_id="t")
+        c.call_tool("patch", {"path": "/workspace/abs.txt", "old_string": "x", "new_string": "y"}, task_id="t")
+        fixed = set(touched)
+        for name, args, _ in _RELATIVE_CALLS:
+            seen, opened = len(provider.calls), len(touched)
+            results.append(c.call_tool(name, args, task_id="t"))
+            sent.append("\n".join(f"{call.command}\n{call.stdin}" for call in provider.calls[seen:]))
+            looked_up.append(list(touched[opened:]))
+    assert not any(host_cwd in t or "abs.txt" in t for t in fixed), fixed
+    for (name, _, as_written), result, commands, host_touches in zip(_RELATIVE_CALLS, results, sent, looked_up):
+        tolerated = fixed if name in ("write_file", "patch") else set()
+        assert not [t for t in host_touches if t not in tolerated], (name, host_touches)
+        assert as_written in commands, (name, commands)
+        returned = json.dumps(result)
+        assert "Pass an absolute path" not in returned, (name, result)
+        for host_path in (host_home, host_cwd):
+            assert host_path not in commands and host_path not in returned, (name, host_path, commands, result)
+
+
+def test_hosted_relative_write_then_read_address_the_same_sandbox_file(provider, host_paths, unknown_sandbox_cwd):
+    with c._bind(A):
+        seen = len(provider.calls)
+        written = c.call_tool("write_file", {"path": "rel.txt", "content": "x\n"}, task_id="t")
+        wrote = [call.command for call in provider.calls[seen:]]
+        seen = len(provider.calls)
+        read = c.call_tool("read_file", {"path": "rel.txt"}, task_id="t")
+        reads = [call.command for call in provider.calls[seen:]]
+    assert "error" not in written and "error" not in read, (written, read)
+    assert any("t='rel.txt'" in command for command in wrote), wrote
+    assert reads and all("'rel.txt'" in command for command in reads), reads
+
+
+def test_hosted_absolute_path_with_no_known_sandbox_cwd_still_works(provider, host_paths, unknown_sandbox_cwd):
+    with c._bind(A):
+        written = c.call_tool("write_file", {"path": "/workspace/abs.txt", "content": "x\n"}, task_id="t")
+        read = c.call_tool("read_file", {"path": "/workspace/abs.txt"}, task_id="t")
+    assert written.get("resolved_path") == "/workspace/abs.txt" and "error" not in read, (written, read)
+    assert "'/workspace/abs.txt'" in _sent(provider)
+    assert not any(host_path in _sent(provider) for host_path in host_paths)
+
+
+@pytest.mark.parametrize("default_cwd", ["~", None], ids=["tilde_default_with_home", "no_default"])
+@pytest.mark.parametrize("terminal_cwd", ["~", "~/proj", "/srv/app"])
+def test_hosted_file_tools_anchor_where_the_hosted_terminal_starts(provider, monkeypatch, host_paths, terminal_cwd,
+                                                                   default_cwd):
+    """A relative write resolves in the directory the hosted terminal's commands start in (a ``~`` there is the
+    sandbox's declared home, ``/workspace`` for the recording sandbox), never in a TERMINAL_CWD the terminal
+    config discarded, and no host path is sent or returned."""
+    host_home, host_cwd = host_paths
+    monkeypatch.setenv("TERMINAL_CWD", terminal_cwd)
+    if default_cwd is not None:
+        monkeypatch.setattr(c.RecordingSandboxProvider, "default_cwd", property(lambda self: default_cwd),
+                            raising=False)
+    created, ran = _record_cwds(monkeypatch)
+    with c._bind(A):
+        written = c.call_tool("write_file", {"path": "rel.txt", "content": "x\n"}, task_id="t")
+        terminal = c.call_tool("terminal", {"command": "pwd"}, task_id="t")
+    started = [cwd for command, cwd in ran if command == "pwd"]
+    assert len(started) == 1 and created, (created, ran)
+    # Both backends declare a home here, so the sandbox directory is known and both name it.
+    terminal_dir = ("/workspace" if default_cwd == "~" else None) if started[0] == "~" else started[0]
+    assert terminal_dir is not None, started
+    assert written.get("resolved_path") == posixpath.join(terminal_dir, "rel.txt"), (started, written)
+    sent, returned = _sent(provider), json.dumps([written, terminal])
+    for host_path in (host_home, host_cwd):
+        assert host_path not in sent and host_path not in returned, (host_path, sent, returned)
+
+
+def test_hosted_relative_path_outside_the_terminal_cwd_still_warns(provider, monkeypatch, host_paths):
+    """With an absolute hosted TERMINAL_CWD and no recorded session cwd, a relative write that climbs out of it
+    carries the outside-workspace warning naming that directory; one inside it carries none."""
+    monkeypatch.setenv("TERMINAL_CWD", "/srv/app")
+    with c._bind(A):
+        escaped = c.call_tool("write_file", {"path": "../escape.txt", "content": "x\n"}, task_id="t")
+        inside = c.call_tool("write_file", {"path": "in.txt", "content": "x\n"}, task_id="t")
+    assert escaped.get("resolved_path") == "/srv/escape.txt", escaped
+    assert escaped.get("_warning", "").startswith(
+        "Relative path '../escape.txt' resolved to '/srv/escape.txt', which is OUTSIDE the active workspace "
+        "('/srv/app')."), escaped
+    assert inside.get("resolved_path") == "/srv/app/in.txt" and "_warning" not in inside, inside
+    assert not any(host_path in json.dumps([escaped, inside]) for host_path in host_paths)
diff --git a/tests/tools/test_hosted_review_gaps.py b/tests/tools/test_hosted_review_gaps.py
new file mode 100644
index 0000000000..7d3d1bb94d
--- /dev/null
+++ b/tests/tools/test_hosted_review_gaps.py
@@ -0,0 +1,176 @@
+"""Hosted-scope gaps from review: a tenant-named script read on the host by the gateway lifecycle
+guard, file-tool bookkeeping shared by agents that reuse a task id, a background notification
+promised to a hosted agent that no consumer can deliver, the full tool list still offered to a
+hosted caller, and session kernels that outlive the boundary that should reap them. Each runs the
+real tool or registry under a hosted scope with the recording sandbox."""
+
+from __future__ import annotations
+
+import json
+from typing import Any
+
+from agent.runtime_scope import bind_state
+from tests.tools.test_sandbox_scope_conformance import A, B
+from tests.tools.test_sandbox_scope_conformance import provider as _conformance_provider
+from tools.environments import sandbox_conformance as c
+
+provider = _conformance_provider
+
+
+def test_hosted_terminal_never_reads_a_named_script_on_the_host(provider, monkeypatch, tmp_path):
+    import tools.process_registry as processes
+    monkeypatch.setattr(processes, "_is_supervised_gateway_process", lambda: True)
+    host_dir = tmp_path / "host-workspace"  # apart from the test's HERMES_HOME
+    host_dir.mkdir()
+    script = host_dir / "deploy.sh"
+    script.write_text("#!/bin/sh\nsystemctl --user restart hermes-gateway\n")
+    with c._watch_host(host_dir) as touched, bind_state(A):
+        result = c.call_tool("terminal", {"command": f"bash {script}"}, task_id="t")
+    assert not touched, f"the hosted command's script was read on this host: {touched}"
+    assert "Blocked" not in str(result.get("error")), result
+    assert any(f"bash {script}" in call.command for call in provider.calls
+               if call.sandbox == c._identity(A) and call.op == "execute")
+
+
+def test_hosted_background_process_is_not_promised_a_notification(provider):
+    with bind_state(A):
+        result = c.call_tool("terminal", {"command": "sleep 5", "background": True, "notify_on_complete": True,
+                                          "watch_patterns": ["done"]}, task_id="t")
+        try:
+            assert result.get("notify_on_complete") is False and result.get("notify_unsupported"), result
+            assert "watch_patterns" not in result, result
+        finally:
+            c.call_tool("process_manage", {"action": "kill", "session_id": result.get("session_id")}, task_id="t")
+
+
+def test_hosted_agents_sharing_a_task_id_keep_their_own_file_bookkeeping(provider):
+    agents = [c.hosted_scope_for(f"agent-{n}") for n in range(4)]
+    for tool, args in (("search_files", {"pattern": "needle", "path": "/workspace"}),
+                       ("read_file", {"path": "/workspace/notes.txt"})):
+        for scope in agents:  # each agent's first call; on a shared tracker the 4th is "repeated"
+            with bind_state(scope):
+                result = c.call_tool(tool, args, task_id="default")
+            assert "BLOCKED" not in json.dumps(result) and "_warning" not in result, (tool, scope.agent, result)
+
+
+def test_hosted_scope_is_offered_only_its_allowlist(provider):
+    from model_tools import get_tool_definitions
+    from tools.hosted_tool_policy import HOSTED_TOOL_ALLOWLIST
+
+    local = {t["function"]["name"] for t in get_tool_definitions(quiet_mode=True)}  # fills the memo first
+    with bind_state(A):
+        hosted = {t["function"]["name"] for t in get_tool_definitions(quiet_mode=True)}
+    assert hosted and hosted <= HOSTED_TOOL_ALLOWLIST, hosted - HOSTED_TOOL_ALLOWLIST
+    assert local - HOSTED_TOOL_ALLOWLIST, "the local selection should still offer non-sandbox tools"
+
+
+def test_clear_session_finds_a_hosted_agents_local_kernels():
+    from tools.code_kernel import _KERNELS, shutdown_kernels_for_owner
+
+    torn = []
+    key = ("sandbox:acme/agent-a:session-key", "standard", "python3", "/workspace", frozenset())
+    stub: Any = type("Stub", (), {"key": key, "owner": key[0], "attached": 0,
+                                  "teardown": lambda self: torn.append(key)})()
+    _KERNELS[key] = stub
+    try:
+        with bind_state(A):
+            shutdown_kernels_for_owner("session-key")
+        assert torn == [key] and not _KERNELS, "the session boundary missed a hosted agent's kernel"
+    finally:
+        _KERNELS.pop(key, None)
+
+
+def test_clear_session_finds_a_hosted_agents_remote_kernels():
+    from tools.code_kernel_remote import _REMOTE_KERNELS, shutdown_remote_kernels_for_owner
+
+    killed = []
+    key = ("sandbox:acme/agent-a:session-key", "remote", "stub", "t", frozenset())
+    stub: Any = type("Stub", (), {"key": key, "owner": key[0], "attached": 0,
+                                  "kill": lambda self: killed.append(key)})()
+    _REMOTE_KERNELS[key] = stub
+    try:
+        with bind_state(A):
+            shutdown_remote_kernels_for_owner("session-key")
+        assert killed == [key] and not _REMOTE_KERNELS, "the session boundary missed a hosted agent's remote kernel"
+    finally:
+        _REMOTE_KERNELS.pop(key, None)
+
+
+def test_local_shutdown_does_not_kill_colon_suffix_owner():
+    """A session close matches its owner exactly: ``room`` is not ``telegram:room``, locally or
+    inside a sandbox (where the sandbox key, not a bare suffix, qualifies the owner)."""
+    from tools.code_kernel import _KERNELS, shutdown_kernels_for_owner
+
+    torn: list[str] = []
+    keys = []
+    for owner in ("room", "telegram:room"):
+        key = (owner, "probe")
+        keys.append(key)
+        _KERNELS[key] = type("Stub", (), {"teardown": lambda self, o=owner: torn.append(o)})()
+    try:
+        shutdown_kernels_for_owner("room")
+        assert torn == ["room"], torn
+    finally:
+        for key in keys:
+            _KERNELS.pop(key, None)
+
+
+def test_session_close_does_not_touch_another_agents_kernel(provider):
+    """Two hosted agents share a session key; a session close under one agent resolves that
+    agent's sandbox-qualified owner and must not run teardown in the other agent's sandbox."""
+    from tools.code_kernel_remote import (RemoteKernel, _REMOTE_KERNELS, _kernel_key,
+                                          shutdown_remote_kernels_for_owner)
+    from tools.environments.sandbox_scope import ScopedEnvironment, sandbox_identity
+
+    reached = []
+
+    class Backend:
+        def execute(self, command, cwd=None, timeout=30, scope=None):
+            reached.append((getattr(scope, "agent", None), command))
+            return {"output": ""}
+
+    keys = []
+    try:
+        for scope in (A, B):
+            from tools.approval_context import reset_current_session_key, set_current_session_key
+            from tools.code_kernel import _resolve_owner
+            token = set_current_session_key("shared-session")
+            try:
+                with bind_state(scope):
+                    owner = _resolve_owner("t")
+            finally:
+                reset_current_session_key(token)
+            key = _kernel_key(owner, "recording", "t", frozenset())
+            keys.append(key)
+            _REMOTE_KERNELS[key] = RemoteKernel(
+                env=ScopedEnvironment(Backend(), sandbox_identity(scope), owner=scope),
+                env_type="recording", kernel_dir="/workspace/k", pid="4242",
+                rpc_token="tok", owner=owner, owner_scope=scope)
+        with bind_state(B):
+            shutdown_remote_kernels_for_owner("shared-session")
+        assert not any(agent == "agent-a" for agent, _ in reached), reached
+        assert "agent-b" in {agent for agent, _ in reached}, reached
+    finally:
+        for key in keys:
+            _REMOTE_KERNELS.pop(key, None)
+
+
+def test_another_agents_eviction_still_stops_the_owning_kernels_service(provider):
+    from tools.code_kernel_remote import RemoteKernel
+    from tools.environments.sandbox_scope import ScopedEnvironment
+
+    reached = []
+
+    class _Inner:
+        def execute(self, command, cwd=None, timeout=30, scope=None):
+            reached.append((command, scope))
+            return ""
+
+    identity = c._identity(A)
+    kernel = RemoteKernel(env=ScopedEnvironment(_Inner(), identity, owner=A), env_type="stub",
+                          kernel_dir="/workspace/k", pid="4242", rpc_token="tok",
+                          owner="sandbox:acme/agent-a:session-key")
+    kernel.owner_scope = A
+    with bind_state(B):
+        kernel.kill()
+    assert any("4242" in command for command, _ in reached), reached
diff --git a/tests/tools/test_hosted_tilde_paths.py b/tests/tools/test_hosted_tilde_paths.py
new file mode 100644
index 0000000000..7c718c527c
--- /dev/null
+++ b/tests/tools/test_hosted_tilde_paths.py
@@ -0,0 +1,303 @@
+"""A hosted ``~`` path names the agent's sandbox home (the home its backend declared), never this
+host's HOME: a write and a read of the same ``~/x`` address one sandbox path, and nothing the tools
+send or return carries the host home. With no declared home a ``~`` path is refused before anything
+is sent. A local scope keeps the profile-home expansion."""
+
+from __future__ import annotations
+
+import json
+import os
+
+import pytest
+
+from tests.tools.test_sandbox_scope_conformance import A, host_dir as _conformance_host_dir
+from tests.tools.test_sandbox_scope_conformance import provider as _conformance_provider
+from tools.environments import sandbox_conformance as c
+
+provider = _conformance_provider  # the recording-sandbox fixture, by its name
+host_dir = _conformance_host_dir
+
+SANDBOX_HOME = "/home/tenant-sandbox"
+
+
+@pytest.fixture
+def host_home(monkeypatch, tmp_path):
+    home = tmp_path / "hosthome-zz9"
+    home.mkdir()
+    monkeypatch.setenv("HOME", str(home))
+    return str(home)
+
+
+@pytest.fixture
+def declared_home(monkeypatch):
+    monkeypatch.setattr(c.RecordingSandboxProvider, "default_cwd", property(lambda self: SANDBOX_HOME),
+                        raising=False)
+    return SANDBOX_HOME
+
+
+def _sent(provider) -> str:
+    return "\n".join(f"{call.command}\n{call.stdin}" for call in provider.calls)
+
+
+def test_hosted_write_then_read_of_a_tilde_path_address_the_sandbox_home(provider, host_home, declared_home):
+    with c._bind(A):
+        written = c.call_tool("write_file", {"path": "~/notes.txt", "content": "x\n"}, task_id="t")
+        read = c.call_tool("read_file", {"path": "~/notes.txt"}, task_id="t")
+        searched = c.call_tool("search_files", {"pattern": "x", "path": "~/src"}, task_id="t")
+        sensitive = c.call_tool("write_file", {"path": "~/../../etc/cron.d/x", "content": "x\n"}, task_id="t")
+    target = f"{declared_home}/notes.txt"
+    assert written.get("resolved_path") == target, written
+    reads = [call.command for call in provider.calls if call.op == "execute" and "wc -c" in call.command]
+    assert reads and all(target in cmd and "~/notes.txt" not in cmd for cmd in reads), reads
+    assert any(f"{declared_home}/src" in call.command for call in provider.calls), "search did not use the home"
+    assert host_home not in _sent(provider), "a hosted file tool sent the host HOME into the sandbox"
+    assert host_home not in json.dumps([written, read, searched])
+    assert "sensitive system path" in sensitive.get("error", ""), sensitive  # the guards still judge the path
+
+
+def test_hosted_patch_of_a_tilde_path_addresses_the_sandbox_home(provider, host_home, declared_home):
+    from tools.hosted_tool_policy import HOSTED_TOOL_ALLOWLIST
+    assert "patch" in HOSTED_TOOL_ALLOWLIST
+    with c._bind(A):
+        patched = c.call_tool("patch", {"path": "~/x", "old_string": "a", "new_string": "b"}, task_id="t")
+        v4a = c.call_tool("patch", {"mode": "patch", "patch": (
+            "*** Begin Patch\n*** Add File: ~/added.txt\n+hello\n*** End Patch\n")}, task_id="t")
+    sent = _sent(provider)
+    assert f"{declared_home}/x" in sent and f"{declared_home}/added.txt" in sent, sent
+    assert host_home not in sent and host_home not in json.dumps([patched, v4a])
+
+
+def test_hosted_tilde_with_no_declared_home_is_refused_and_nothing_is_sent(provider, host_home):
+    with c._bind(A):
+        c.call_tool("terminal", {"command": "true"}, task_id="t")  # the sandbox is up, with no home
+        seen = len(provider.calls)
+        results = [
+            c.call_tool("write_file", {"path": "~/notes.txt", "content": "x\n"}, task_id="t"),
+            c.call_tool("read_file", {"path": "~/notes.txt"}, task_id="t"),
+            c.call_tool("patch", {"path": "~/notes.txt", "old_string": "a", "new_string": "b"}, task_id="t"),
+            c.call_tool("read_file", {"path": "~root/notes.txt"}, task_id="t"),
+            c.call_tool("search_files", {"pattern": "x", "path": "~"}, task_id="t"),
+            c.call_tool("patch", {"mode": "patch", "patch": (
+                "*** Begin Patch\n*** Add File: ~/added.txt\n+hello\n*** End Patch\n")}, task_id="t"),
+        ]
+    for result in results:
+        assert "absolute path" in str(result.get("error", "")), result
+    assert "declared no home" in results[0]["error"] and "~root" in results[3]["error"]
+    assert provider.calls[seen:] == [], "a refused ~ path reached the sandbox"
+    assert host_home not in json.dumps(results)
+
+
+@pytest.mark.platforms("posix")
+def test_hosted_tilde_user_never_consults_the_host_passwd_database(provider, monkeypatch, declared_home):
+    import pwd
+
+    expanduser, getpwnam = os.path.expanduser, pwd.getpwnam
+
+    def refuse(found: bool):
+        if found:
+            raise AssertionError("a hosted ~user path consulted this host's passwd database")
+    monkeypatch.setattr(os.path, "expanduser", lambda p: refuse("~root" in os.fspath(p)) or expanduser(p))
+    monkeypatch.setattr(pwd, "getpwnam", lambda name: refuse(name == "root") or getpwnam(name))
+    with c._bind(A):
+        results = [c.call_tool("write_file", {"path": "~root/x", "content": "x\n"}, task_id="t"),
+                   c.call_tool("read_file", {"path": "~root/x"}, task_id="t"),
+                   c.call_tool("patch", {"path": "~root/x", "old_string": "a", "new_string": "b"}, task_id="t")]
+    for result in results:
+        assert "'~user' paths are not supported" in str(result.get("error", "")), result
+    assert not [call for call in provider.calls if "~root" in call.command]
+
+
+def _record_v4a(monkeypatch) -> list[str]:
+    """The V4A text each hosted patch hands the sandbox's file operations."""
+    from tools.file_operations import ShellFileOperations
+    sent: list[str] = []
+    original = ShellFileOperations.patch_v4a
+    monkeypatch.setattr(ShellFileOperations, "patch_v4a", lambda self, text: sent.append(text) or original(self, text))
+    return sent
+
+
+def _v4a(header: str, body: str = "") -> str:
+    return f"*** Begin Patch\n*** {header}\n{body}*** End Patch\n"
+
+
+_V4A_AS_WRITTEN = [
+    _v4a("Update File: rel.txt", "@@\n-old\n+new\n"), _v4a("Add File: sub/added.txt", "+hi\n"),
+    _v4a("Delete File: del.txt"), _v4a("Move File: src.txt -> dst.txt"),
+    _v4a("Update File: /workspace/abs.txt", "@@\n-old\n+new\n"), _v4a("Add File: /workspace/added.txt", "+hi\n"),
+    _v4a("Delete File: /workspace/del.txt"), _v4a("Move File: /workspace/src.txt -> /srv/dst.txt"),
+]
+
+
+@pytest.mark.parametrize("home", ["none", "declared", "tilde_default_cwd"])
+def test_hosted_v4a_relative_and_absolute_headers_reach_the_sandbox_as_written(provider, monkeypatch, tmp_path, home):
+    """Only a ``~`` header names the sandbox's home; every other header is the sandbox's to anchor, as it
+    always was, and no host directory is put in its place."""
+    if home == "declared":
+        monkeypatch.setattr(c.RecordingSandboxProvider, "default_cwd", property(lambda self: SANDBOX_HOME),
+                            raising=False)
+    elif home == "tilde_default_cwd":
+        monkeypatch.setattr(c.RecordingSandboxProvider, "default_cwd", property(lambda self: "~"), raising=False)
+        monkeypatch.setattr(c.RecordingSandboxProvider, "create_environment",
+                            lambda self, **kw: c.RecordingSandboxEnvironment(self, kw["sandbox"], "relative-cwd"))
+        (tmp_path / "host-cwd").mkdir()
+        monkeypatch.chdir(tmp_path / "host-cwd")
+    sent = _record_v4a(monkeypatch)
+    with c._bind(A):
+        results = [c.call_tool("patch", {"mode": "patch", "patch": text}, task_id="t") for text in _V4A_AS_WRITTEN]
+    assert sent == _V4A_AS_WRITTEN, (sent, results)
+    assert os.getcwd() not in _sent(provider)
+
+
+def test_hosted_v4a_tilde_headers_name_the_sandbox_home(provider, monkeypatch, host_home, declared_home):
+    sent = _record_v4a(monkeypatch)
+    patches = [_v4a("Update File: ~/t.txt", "@@\n-old\n+new\n"), _v4a("Delete File: ~/del.txt"),
+               _v4a("Move File: ~/src.txt -> ~/dst.txt"), _v4a("Move File: ~/a.txt -> rel.txt")]
+    with c._bind(A):
+        results = [c.call_tool("patch", {"mode": "patch", "patch": text}, task_id="t") for text in patches]
+    assert sent == [_v4a("Update File: /home/tenant-sandbox/t.txt", "@@\n-old\n+new\n"),
+                    _v4a("Delete File: /home/tenant-sandbox/del.txt"),
+                    _v4a("Move File: /home/tenant-sandbox/src.txt -> /home/tenant-sandbox/dst.txt"),
+                    _v4a("Move File: /home/tenant-sandbox/a.txt -> rel.txt")], results
+    assert host_home not in _sent(provider) and host_home not in json.dumps(results)
+
+
+def test_hosted_v4a_tilde_headers_with_no_home_or_a_user_are_refused(provider, host_home):
+    with c._bind(A):
+        c.call_tool("terminal", {"command": "true"}, task_id="t")  # the sandbox is up, with no home
+        seen = len(provider.calls)
+        results = [c.call_tool("patch", {"mode": "patch", "patch": text}, task_id="t") for text in (
+            _v4a("Update File: ~/t.txt", "@@\n-old\n+new\n"), _v4a("Delete File: ~/del.txt"),
+            _v4a("Move File: rel.txt -> ~/dst.txt"), _v4a("Update File: ~root/t.txt", "@@\n-old\n+new\n"))]
+    for result in results:
+        assert "absolute path" in str(result.get("error", "")), result
+    assert provider.calls[seen:] == [], "a refused ~ header reached the sandbox"
+
+
+def _tilde_cwd(monkeypatch, anchor: str) -> None:
+    """A ``~`` working directory from *anchor*; a task override goes through the real registration, which
+    also records it as the session's cwd."""
+    from tools import terminal_tool
+    monkeypatch.setattr(terminal_tool, "_task_env_overrides", {})
+    monkeypatch.setattr(terminal_tool, "_session_cwd", {})
+    if anchor == "terminal_cwd":
+        monkeypatch.setenv("TERMINAL_CWD", "~")
+    elif anchor == "padded_session_cwd":
+        with c._bind(A):
+            terminal_tool.record_session_cwd("t", " ~")  # recorded as given, unstripped
+    else:
+        with c._bind(A):
+            terminal_tool.register_task_env_overrides("t", {"cwd": "~"})
+            assert terminal_tool.get_session_cwd("t") == "~"
+
+
+@pytest.mark.parametrize("anchor", ["terminal_cwd", "task_override", "padded_session_cwd"])
+def test_hosted_tilde_cwd_with_no_declared_home_is_no_anchor(provider, monkeypatch, host_dir, host_home, anchor):
+    """A ``~`` working directory the sandbox gives no meaning to anchors nothing: a plain relative path
+    works as before, and nothing about it is looked up on this host."""
+    _tilde_cwd(monkeypatch, anchor)
+    (host_dir.parent / "elsewhere").mkdir()
+    (host_dir / "workspace-link").symlink_to(host_dir.parent / "elsewhere", target_is_directory=True)
+    monkeypatch.chdir(host_dir)
+    with c._watch_host(host_dir) as touched, c._bind(A):
+        results = [c.call_tool("read_file", {"path": "notes.txt"}, task_id="t"),
+                   c.call_tool("write_file", {"path": "notes.txt", "content": "x\n"}, task_id="t"),
+                   c.call_tool("write_file", {"path": "workspace-link/notes.txt", "content": "x\n"}, task_id="t"),
+                   c.call_tool("patch", {"path": "notes.txt", "old_string": "a", "new_string": "b"}, task_id="t"),
+                   c.call_tool("patch", {"mode": "patch", "patch": _v4a("Add File: added.txt", "+hi\n")}, task_id="t"),
+                   c.call_tool("search_files", {"pattern": "x", "path": "."}, task_id="t")]
+        touched = list(touched)
+    assert not touched, f"a hosted tool touched the host filesystem: {touched}"
+    for result in results:
+        assert "~" not in str(result.get("error", "")) and "declared no home" not in json.dumps(result), result
+    if anchor == "terminal_cwd":
+        return  # where the terminal config puts a ``~`` TERMINAL_CWD is its own concern
+    for written in results[1:3]:
+        resolved = written.get("resolved_path")
+        assert resolved and resolved.startswith("/"), written
+        assert not resolved.startswith((str(host_dir), host_home)), written
+    assert str(host_dir) not in _sent(provider) and host_home not in _sent(provider)
+
+
+@pytest.mark.parametrize("anchor", ["terminal_cwd", "task_override"])
+def test_hosted_tilde_cwd_with_a_declared_home_anchors_under_it(provider, monkeypatch, host_dir, host_home,
+                                                               declared_home, anchor):
+    _tilde_cwd(monkeypatch, anchor)
+    monkeypatch.chdir(host_dir)
+    with c._watch_host(host_dir) as touched, c._bind(A):
+        read = c.call_tool("read_file", {"path": "notes.txt"}, task_id="t")
+        written = c.call_tool("write_file", {"path": "sub/notes.txt", "content": "x\n"}, task_id="t")
+        patched = c.call_tool("patch", {"path": "p.txt", "old_string": "a", "new_string": "b"}, task_id="t")
+        touched = list(touched)
+    assert not touched, f"a hosted tool touched the host filesystem: {touched}"
+    assert written.get("resolved_path") == f"{declared_home}/sub/notes.txt", written
+    sent = _sent(provider)
+    assert f"{declared_home}/p.txt" in sent and "~" not in json.dumps([read, written, patched]), (sent, read, patched)
+    assert host_home not in sent and str(host_dir) not in sent
+
+
+def test_local_recorded_tilde_cwd_still_anchors_at_the_profile_home(monkeypatch, host_home):
+    """Outside a hosted scope a recorded ``~`` session cwd is returned as recorded and expands to this host's
+    profile home, as it always did."""
+    from pathlib import Path
+    from tools import file_tools_paths, terminal_tool
+
