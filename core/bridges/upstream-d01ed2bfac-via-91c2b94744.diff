@@ -0,0 +1,185 @@
+"""Hosted scopes keep host-only paths outside tool dispatch closed.
+
+Tool calls meet the deny-by-default allowlist (``tools/hosted_tool_policy.py``, covered by
+``test_hosted_deny_by_default.py`` and the conformance check ``host_tools_refused``). This file drives
+the paths that run without a tool call (checkpoints, inline skill shell, ``@`` references, the
+workspace probe, cron scripts, MCP stdio spawns, media delivery, transcription, ``/review``
+delegation) and document extraction inside the allowlisted ``read_file``, through their real entry
+points, under a hosted scope and with no scope bound, and checks the hosted call fails closed before
+any host effect. Each asks ``host_feature_enabled``.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import subprocess
+import sys
+
+import pytest
+
+from agent.runtime_scope import bind_state
+from hermes_scope import Principal, Scope
+from tools.hosted_tool_policy import HostedToolRefused
+
+A = Scope("acme", "agent-a", Principal("u1"), owner=Principal("u1"), can_administer=True)
+
+
+@pytest.fixture
+def no_spawn(monkeypatch):
+    """Record (and refuse) every host subprocess a hosted call would start."""
+    spawned = []
+
+    def refuse(*args, **kwargs):
+        spawned.append(args[0] if args else kwargs.get("args"))
+        raise AssertionError(f"a host process was started: {spawned[-1]}")
+    monkeypatch.setattr(subprocess, "Popen", refuse)
+    monkeypatch.setattr(subprocess, "run", refuse)
+    return spawned
+
+
+def test_browser_exec_runs_no_tenant_python_on_the_host(monkeypatch, no_spawn):
+    """browser_exec is reached only by tool dispatch, where the allowlist refuses it before setup."""
+    import tools.browser_use_cli as browser
+    from tools.registry import registry
+
+    setup = []
+    monkeypatch.setattr(browser, "_find_cli", lambda: setup.append("cli") or [sys.executable, "-"])
+    monkeypatch.setattr(browser, "_base_subprocess_env", lambda: setup.append("env") or {})
+    with bind_state(A):
+        dispatched = registry.dispatch("browser_exec", {"code": "print('HOST-EXECUTED')"}, task_id="t")
+        direct = browser.browser_exec("print('HOST-EXECUTED')", task_id="t")
+    for result in (dispatched, direct):
+        assert "not available to a hosted agent" in result
+    assert setup == [] and no_spawn == []
+
+
+def test_checkpoints_take_and_restore_nothing_on_the_host(tmp_path, no_spawn):
+    from tools.checkpoint_manager import CheckpointManager
+
+    mgr = CheckpointManager(enabled=True)
+    (tmp_path / "f.txt").write_text("x")
+    with bind_state(A):
+        assert mgr.ensure_checkpoint(str(tmp_path), "before write") is False
+        restored = mgr.restore(str(tmp_path), "deadbeef")
+    assert restored["success"] is False and "hosted agent" in restored["error"]
+    assert no_spawn == []
+
+
+def test_inline_skill_shell_does_not_run_on_the_host(tmp_path, no_spawn):
+    from agent.skill_preprocessing import run_inline_shell
+
+    with bind_state(A):
+        out = run_inline_shell("echo HOST", tmp_path, 5)
+    assert "refused" in out and no_spawn == []
+
+
+def test_context_references_read_nothing_on_the_host(tmp_path, monkeypatch):
+    from agent.context_references import preprocess_context_references
+    from tools.environments import sandbox_conformance as conformance
+
+    planted = tmp_path / "secret.txt"
+    planted.write_text("HOST-ONLY")
+    with conformance._watch_host(tmp_path) as touched, bind_state(A):
+        result = preprocess_context_references("look at @file:secret.txt and @diff", cwd=tmp_path,
+                                               context_length=100_000)
+    assert result.blocked and "HOST-ONLY" not in result.message and not touched
+
+
+def test_the_workspace_probe_runs_no_git_on_the_host(tmp_path, no_spawn):
+    from agent.coding_context import build_coding_workspace_block
+
+    (tmp_path / ".git").mkdir()
+    with bind_state(A):
+        assert build_coding_workspace_block(tmp_path) == ""
+    assert no_spawn == []
+
+
+def test_a_cron_script_does_not_run_on_the_host(tmp_path, no_spawn):
+    from cron.scheduler_script import _run_job_script
+
+    with bind_state(A):
+        ok, out = _run_job_script("job.py")
+    assert ok is False and "hosted agent" in out and no_spawn == []
+
+
+def test_an_mcp_stdio_server_is_not_started_on_the_host(no_spawn):
+    from tools.mcp_tool import MCPServerTask
+
+    server = MCPServerTask("user-server")
+    with bind_state(A), pytest.raises(HostedToolRefused):
+        asyncio.run(server._run_stdio({"command": "touch", "args": ["/tmp/x"]}))  # no-tmp: ok — never run
+    assert no_spawn == []
+
+
+def test_media_delivery_never_attaches_a_host_file(tmp_path):
+    from gateway.platforms.base import validate_media_delivery_path
+
+    planted = tmp_path / "report.png"
+    planted.write_bytes(b"x")
+    assert validate_media_delivery_path(str(planted)) == str(planted.resolve())
+    with bind_state(A):
+        assert validate_media_delivery_path(str(planted)) is None
+
+
+def test_transcription_reads_no_host_audio(tmp_path, no_spawn):
+    from tools.environments import sandbox_conformance as conformance
+    from tools.transcription_tools import transcribe_audio
+
+    audio = tmp_path / "voice.ogg"
+    audio.write_bytes(b"OggS")
+    with conformance._watch_host(tmp_path) as touched, bind_state(A):
+        result = transcribe_audio(str(audio))
+    assert result["success"] is False and "hosted agent" in result["error"]
+    assert not touched and no_spawn == []
+
+
+def test_delegation_spawns_no_child_agent():
+    from tools.delegate_tool import delegate_task
+
+    class Parent:
+        def __getattr__(self, name):
+            raise AssertionError(f"the parent agent was used to spawn a child ({name})")
+    with bind_state(A):
+        result = json.loads(delegate_task(goal="do it", parent_agent=Parent()))
+    assert "not available to a hosted agent" in result["error"]
+
+
+def test_document_extraction_is_not_done_on_the_host(monkeypatch):
+    from tools import file_tools, read_extract
+
+    monkeypatch.setattr(read_extract, "extract_document_bytes",
+                        lambda *a, **k: (_ for _ in ()).throw(AssertionError("extracted on the host")))
+    with bind_state(A):
+        assert file_tools._read_extracted_document("report.pdf", __import__("pathlib").PurePosixPath(
+            "/workspace/report.pdf"), 1, 100, "t") is None
+
+
+def test_local_calls_still_reach_every_guarded_path(tmp_path):
+    """With no scope bound the same entry points behave as before (spot checks of the cheap ones)."""
+    from agent.coding_context import build_coding_workspace_block
+    from agent.skill_preprocessing import run_inline_shell
+    from tools.checkpoint_manager import CheckpointManager
+
+    assert run_inline_shell("echo LOCAL", tmp_path, 5) == "LOCAL"
+    subprocess.run(["git", "init", "-q", str(tmp_path)], check=True)
+    assert build_coding_workspace_block(tmp_path) != ""
+    (tmp_path / "f.txt").write_text("x")
+    assert CheckpointManager(enabled=True).ensure_checkpoint(str(tmp_path), "t") is True
+
+
+def test_an_mcp_servers_tool_is_refused_in_a_hosted_scope():
+    """A tool an MCP server registered (toolset ``mcp-<server>``) runs for the profile, not the agent."""
+    from tools.registry import registry
+
+    calls = []
+    registry.register(name="mcp_probe_server_echo", toolset="mcp-probe-server",
+                      schema={"name": "mcp_probe_server_echo", "description": "echo", "parameters": {}},
+                      handler=lambda args, **kw: calls.append(args) or json.dumps({"ok": True}))
+    try:
+        with bind_state(A):
+            result = json.loads(registry.dispatch("mcp_probe_server_echo", {}))
+        assert "not available to a hosted agent" in result["error"] and calls == []
+        assert json.loads(registry.dispatch("mcp_probe_server_echo", {})) == {"ok": True}
+    finally:
+        registry.deregister("mcp_probe_server_echo")
diff --git a/tests/tools/test_image_source_unicode_space.py b/tests/tools/test_image_source_unicode_space.py
new file mode 100644
index 0000000000..005f124f9b
--- /dev/null
+++ b/tests/tools/test_image_source_unicode_space.py
@@ -0,0 +1,60 @@
+"""A media path the model retyped with a plain space still opens the macOS screenshot it names.
+
+macOS names screenshots ``Screenshot 2026-07-10 at 9.23.58<U+202F>AM.png`` (a NARROW NO-BREAK
+SPACE before AM/PM). A model echoing that name back emits U+0020, so ``vision_analyze``,
+``video_analyze`` and image/video generation reported "not found" for a file it had just been
+shown (#76334). The retry takes only the one same-directory file that differs invisibly, and
+never guesses between twins.
+"""
+import asyncio
+
+import pytest
+
+from tools.image_source import (
+    ResolveContext, SourceNotFound, resolve_image_source,
+)
+
+def _png() -> bytes:
+    import io
+    from PIL import Image
+    buf = io.BytesIO()
+    Image.new("RGB", (2, 2), (255, 0, 0)).save(buf, format="PNG")
+    return buf.getvalue()
+
+
+PNG = _png()
+
+
+def _resolve(path):
+    return asyncio.run(resolve_image_source(str(path), ResolveContext()))
+
+
+def test_flattened_screenshot_name_opens_in_vision_video_and_generation(tmp_path, monkeypatch):
+    from tools.image_generation_tool import _confine_source_images
+    from tools.vision_tools import _materialize_video
+
+    monkeypatch.setenv("TERMINAL_ENV", "local")
+    real = tmp_path / "Screenshot 2026-07-10 at 9.23.58\u202fAM.png"
+    real.write_bytes(PNG)
+    typed = str(tmp_path / "Screenshot 2026-07-10 at 9.23.58 AM.png")
+    clip = tmp_path / "Recording at 9.23\u202fAM.mp4"
+    clip.write_bytes(b"\x00\x00\x00\x18ftypmp42")
+
+    assert _resolve(typed).data == PNG
+    assert _confine_source_images(typed, [typed, "https://x/y.png"], None) == (
+        str(real), [str(real), "https://x/y.png"], None)
+    assert asyncio.run(_materialize_video(
+        str(tmp_path / "Recording at 9.23 AM.mp4"), None, [])) == clip
+
+
+def test_twins_and_missing_files_are_never_guessed(tmp_path, monkeypatch):
+    monkeypatch.setenv("TERMINAL_ENV", "local")
+    (tmp_path / "a\u202fb.png").write_bytes(PNG)
+    (tmp_path / "a\u00a0b.png").write_bytes(PNG)
+
+    with pytest.raises(SourceNotFound):
+        _resolve(tmp_path / "a b.png")
+    with pytest.raises(SourceNotFound):
+        _resolve(tmp_path / "other.png")
+    from tools.image_source import local_source_spelling
+    assert local_source_spelling(str(tmp_path / "a b.png")) == str(tmp_path / "a b.png")
diff --git a/tests/tools/test_long_lived_processes.py b/tests/tools/test_long_lived_processes.py
new file mode 100644
index 0000000000..e4bae1461c
--- /dev/null
+++ b/tests/tools/test_long_lived_processes.py
@@ -0,0 +1,191 @@
+"""The long-lived process mixin: its table and lock are one owned state (a concurrent first start
+never sees the table without the lock), a name reused after its leader exited reaps the old record
+(its children and pipes do not outlive the record), and stopping a process that runs inside a
+backend (docker exec / ssh / a plugin prefix) stops the service there, where its pid was recorded —
+not only the local client."""
+
+from __future__ import annotations
+
+import contextlib
+import os
+import signal
+import subprocess
+import threading
+import time
+
+import pytest
+
+from tools.environments.base_processes import LongLivedProcessMixin
+
+
+def _alive(pid: int) -> bool:
+    try:
+        os.kill(pid, 0)
+    except ProcessLookupError:
+        return False
+    return True
+
+
+def _wait_gone(pid: int, timeout: float = 10.0) -> bool:
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if not _alive(pid):
+            return True
+        time.sleep(0.05)
+    return not _alive(pid)
+
+
+class _HostEnv(LongLivedProcessMixin):
+    """A host backend: spawn like the local environment does, in an owned process group."""
+
+    def __init__(self, tmp_path=None):
+        self.cwd = os.getcwd()
+
+    def _spawn_long_lived(self, argv, child_env):
+        proc = subprocess.Popen(list(argv), stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                stderr=subprocess.DEVNULL, start_new_session=True)
+        proc._hermes_owned_pgid = proc.pid
+        return proc
+
+    def _kill_process(self, proc):
+        with contextlib.suppress(ProcessLookupError, PermissionError):
+            os.killpg(proc.pid, signal.SIGTERM)
+
+
+class _SandboxLikeEnv(LongLivedProcessMixin):
+    """A backend with an exec prefix (docker exec / ssh shape): the service runs behind a local
+    client. ``execute`` is the sandbox-side command channel, as a real backend's is."""
+
+    def __init__(self, tmp_path):
+        self._tmp = str(tmp_path)
+        self.executed: list[str] = []
+
+    def exec_prefix(self, *, user=None, interactive=True):
+        return ["env"]
+
+    def get_temp_dir(self):
+        return self._tmp
+
+    def execute(self, command, cwd=None, timeout=30, scope=None):
+        self.executed.append(command)
+        return subprocess.run(["bash", "-c", command], capture_output=True, timeout=timeout, check=False).stdout.decode()
+
+    def _kill_process(self, proc):
+        with contextlib.suppress(ProcessLookupError, OSError):
+            proc.kill()
+
+
+@pytest.mark.platforms("posix")  # POSIX argv and process-group signals
+def test_a_first_start_never_sees_the_table_without_its_lock():
+    env = _HostEnv()
+    # The first-touch window the old two-key init could leave: another thread saw the table
+    # before the starter installed its lock.
+    env.__dict__["_long_lived_processes"] = {}
+    env.start_process("svc", ["sleep", "5"])  # must not KeyError on the starter's lock
+    try:
+        assert env.attach_process("svc") is not None
+    finally:
+        env.stop_all_processes()
+
+
+def test_attach_and_stop_take_the_same_lock_as_start():
+    env = _HostEnv()
+    lock = env._long_lived_lock()
+    lock.acquire()
+    try:
+        probing = threading.Thread(target=lambda: env.attach_process("svc"), daemon=True)
+        probing.start()
+        probing.join(0.3)
+        assert probing.is_alive(), "attach_process took a different lock than start_process"
+    finally:
+        lock.release()
+    env.stop_all_processes()
+
+
+@pytest.mark.platforms("posix")  # POSIX argv and process-group signals
+def test_a_reused_name_reaps_the_old_records_children_and_pipes(tmp_path):
+    pidfile = tmp_path / "child.pid"
+    env = _HostEnv()
+    env.start_process("svc", ["bash", "-c", f"sleep 60 & echo $! > {pidfile}"])
+    deadline = time.monotonic() + 10
+    while not (pidfile.exists() and pidfile.read_text().strip()):
+        assert time.monotonic() < deadline, "the leader never started its child"
+        time.sleep(0.05)
+    child = int(pidfile.read_text().strip())
+    old = env._long_lived()["svc"]
+    deadline = time.monotonic() + 10
+    while old.poll() is None:  # the leader exits; the child keeps its owned group alive
+        assert time.monotonic() < deadline
+        time.sleep(0.05)
+    try:
+        env.start_process("svc", ["sleep", "5"])  # name reuse after the leader exited
+        assert _wait_gone(child), "reusing a name left the old record's children running"
+        env.stop_all_processes()
+    finally:
+        if _alive(child):
+            with contextlib.suppress(ProcessLookupError):
+                os.killpg(child, signal.SIGKILL)
+
+
+@pytest.mark.platforms("posix")  # POSIX argv and process-group signals
+def test_a_failed_respawn_keeps_the_stale_record():
+    """A respawn that fails (nonexistent executable) must keep the exited leader's record: its
+    pipes and children are still the environment's to stop, and dropping the record would orphan
+    both with nothing left to reap."""
+    env = _HostEnv()
+    env.start_process("svc", ["true"])
+    old = env._long_lived()["svc"]
+    assert old.stdin is not None and old.stdout is not None
+    old.wait(timeout=10)  # the leader exits; its record is now a leftover, not a running process
+    try:
+        with pytest.raises(FileNotFoundError):
+            env.start_process("svc", ["/nonexistent-hermes-review-executable"])
+        assert env._long_lived().get("svc") is old, \
+            "a failed spawn lost the stale record without reaping it"
+        assert not old.stdin.closed, "a failed spawn must not close the stale record's pipes behind its back"
+        env.stop_all_processes()
+        assert old.stdin.closed and old.stdout.closed, "stop must still reap the stale record"
+    finally:
+        if not old.stdin.closed:
+            old.stdin.close()
+        if not old.stdout.closed:
+            old.stdout.close()
+
+
+@pytest.mark.platforms("posix")  # POSIX argv and process-group signals
+def test_stopping_a_backend_process_stops_the_service_inside_the_sandbox(tmp_path):
+    env = _SandboxLikeEnv(tmp_path)
+    env.start_process("svc", ["sleep", "60"])
+    deadline = time.monotonic() + 10
+    while not list(tmp_path.glob("hermes_llp_*.pid")):
+        assert time.monotonic() < deadline, "the service never recorded its pid inside the sandbox"
+        time.sleep(0.05)
+    pidfile = next(tmp_path.glob("hermes_llp_*.pid"))
+    deadline = time.monotonic() + 10
+    while not pidfile.read_text().strip():
+        assert time.monotonic() < deadline, "the pid file stayed empty"
+        time.sleep(0.05)
+    service_pid = int(pidfile.read_text().split()[0])
+    try:
+        assert env.stop_process("svc") is True
+        assert _wait_gone(service_pid), "stopping killed only the local client; the service still runs"
+        assert any("kill" in command for command in env.executed), env.executed
+    finally:
+        env.stop_all_processes()
+        if _alive(service_pid):
+            with contextlib.suppress(ProcessLookupError):
+                os.kill(service_pid, signal.SIGKILL)
+
+
+@pytest.mark.platforms("posix")  # POSIX argv and process-group signals
+@pytest.mark.parametrize("impl", [_HostEnv, lambda tmp: _SandboxLikeEnv(tmp)])
+def test_streams_of_two_names_never_mix(tmp_path, impl):
+    env = impl(tmp_path)
+    one = env.start_process("one", ["bash", "-c", "read line; echo one:$line"])
+    two = env.start_process("two", ["bash", "-c", "read line; echo two:$line"])
+    try:
+        one.stdin.write(b"x\n"), one.stdin.flush()
+        two.stdin.write(b"y\n"), two.stdin.flush()
+        assert one.stdout.readline() == b"one:x\n" and two.stdout.readline() == b"two:y\n"
+    finally:
+        env.stop_all_processes()
diff --git a/tests/tools/test_long_lived_remote_stop.py b/tests/tools/test_long_lived_remote_stop.py
