+platforms: [linux, macos]
+capabilities:
+  provides_tools:
+    - nightshift_launch
+    - nightshift_watch
+    - nightshift_status
+    - nightshift_run
+    - nightshift_report
+    - nightshift_ack
+  provides_hooks:
+    - pre_llm_call
+    - on_session_start
+  provides_middleware: []
+  requires_env: []
