diff --git a/tests/gateway/test_reply_to_mode_config.py b/tests/gateway/test_reply_to_mode_config.py
new file mode 100644
index 0000000000..cfa75d7339
--- /dev/null
+++ b/tests/gateway/test_reply_to_mode_config.py
@@ -0,0 +1,58 @@
+"""``reply_to_mode: off`` reaches the adapter as ``off`` however it was written.
+
+YAML 1.1 reads a bare ``off`` as ``False`` and ``hermes config set ... off`` writes ``false``. The
+single-profile env bridge maps that back to ``off``, but a multiplexed secondary profile skips the
+bridge and reads ``PlatformConfig.reply_to_mode`` directly, so ``False`` fell to the adapters'
+``or 'first'`` default and every reply kept quoting the user's message.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from agent.secret_scope import set_multiplex_active
+from gateway.config import Platform, PlatformConfig, load_gateway_config
+from hermes_cli import config as cli_config
+from hermes_cli.plugins import discover_plugins
+
+
+@pytest.fixture
+def secondary(tmp_path, monkeypatch):
+    launch = tmp_path / "launch"
+    home = launch / "profiles" / "b2"
+    home.mkdir(parents=True)
+    monkeypatch.setenv("HERMES_HOME", str(launch))
+    monkeypatch.setattr("pathlib.Path.home", lambda: tmp_path)
+    discover_plugins()
+    yield home
+    set_multiplex_active(False)
+
+
+def _load_in_scope(home):
+    from gateway.run import _profile_runtime_scope
+    set_multiplex_active(True)
+    with _profile_runtime_scope(home, prepared_secret_scope={}):
+        return load_gateway_config()
+
+
+def test_config_set_off_disables_reply_threading_for_a_secondary_profile(secondary, monkeypatch):
+    (secondary / "config.yaml").write_text("platforms:\n  telegram:\n    enabled: true\n", encoding="utf-8")
+    monkeypatch.setenv("HERMES_HOME", str(secondary))
+    cli_config.set_config_value("platforms.telegram.reply_to_mode", "off")
+    from plugins.platforms.telegram.adapter import TelegramAdapter
+
+    cfg = _load_in_scope(secondary)
+
+    pc = cfg.platforms[Platform.TELEGRAM]
+    assert pc.reply_to_mode == "off"
+    adapter = TelegramAdapter(pc)
+    assert adapter._should_thread_reply("42", 0) is False
+
+
+@pytest.mark.parametrize(("raw", "expected"), [
+    (False, "off"), ("off", "off"), (" ALL ", "all"), ("first", "first"), (None, "first"),
+    ("sometimes", "first"), (True, "first"),
+])
+def test_reply_to_mode_is_always_a_known_mode(raw, expected):
+    data = {"enabled": True} if raw is None else {"enabled": True, "reply_to_mode": raw}
+    assert PlatformConfig.from_dict(data).reply_to_mode == expected
diff --git a/tests/gateway/test_reset_cleanup_profile_scope.py b/tests/gateway/test_reset_cleanup_profile_scope.py
new file mode 100644
index 0000000000..d7948d8c23
--- /dev/null
+++ b/tests/gateway/test_reset_cleanup_profile_scope.py
@@ -0,0 +1,169 @@
+"""Multiplex invariant: session-end work a gateway hands to a worker runs in the OWNING profile's scope.
+
+Memory providers' ``on_session_end`` and plugin ``on_session_finalize`` / ``on_session_reset``
+read the caller profile (home + secrets) at call time. ``/new`` and ``/reset`` run on the main
+loop with no scope installed (the confirm button), so their old-agent cleanup and session hooks
+ran unscoped: on a multiplexed gateway ``on_session_end`` was refused
+(``memory_caller_profile_unresolved``) and a provider that extracts at session end lost the
+conversation (#151672). The opposite slip: an in-turn caller that passes no session key (session
+hygiene, deferred cleanup) must keep its own profile's scope, never be moved to the default one.
+"""
+
+from __future__ import annotations
+
+import threading
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from agent import memory_caller_scope, secret_scope
+from gateway.config import GatewayConfig, Platform
+from gateway.run import GatewayRunner, _profile_runtime_scope
+from gateway.session import SessionSource
+from hermes_constants import get_hermes_home
+
+
+class _RecordingAgent:
+    """What ``_cleanup_agent_resources`` calls on a real agent: records where it ran and what the
+    memory-caller guard decides for a manager bound to ``bound_home`` from that scope."""
+
+    def __init__(self, seen: dict, bound_home: Path):
+        self.seen, self.bound_home = seen, bound_home
+
+    def shutdown_memory_provider(self, messages=None):
+        self.seen["cleanup"] = str(get_hermes_home())
+        self.seen["secret"] = (secret_scope.current_secret_scope() or {}).get("HINDSIGHT_LLM_API_KEY")
+        self.seen["guard"] = memory_caller_scope.caller_scope(
+            memory_caller_scope.bound_scope(self.bound_home), "hook on_session_end")
+
+    def close(self):
+        pass
+
+
+def _runner(profile_homes: dict[str, Path]) -> GatewayRunner:
+    runner = GatewayRunner.__new__(GatewayRunner)
+    runner._agent_cache = {}
+    runner._agent_cache_lock = threading.Lock()
+    runner.config = GatewayConfig(multiplex_profiles=True)
+    runner.session_store = SimpleNamespace(_profile_home_for_key=lambda key: profile_homes.get(key))
+    runner.hooks = SimpleNamespace(emit=AsyncMock())
+    return runner
+
+
+def _profile_b(tmp_path, monkeypatch) -> Path:
+    default_home = tmp_path / ".hermes"
+    prof_b = default_home / "profiles" / "b"
+    prof_b.mkdir(parents=True)
+    (prof_b / ".env").write_text("HINDSIGHT_LLM_API_KEY=key-of-b\n")
+    monkeypatch.setenv("HERMES_HOME", str(default_home))
