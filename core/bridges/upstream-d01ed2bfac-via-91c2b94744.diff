+    (pkg / "__init__.py").write_text(
+        "def register(ctx):\n"
+        "    from agent.secret_scope import get_secret\n"
+        "    key = get_secret('PROBE_KEY')\n"
+        "    ctx.register_command('regkey', handler=lambda args: 'reg:' + str(key), description='p')\n",
+        encoding="utf-8")
