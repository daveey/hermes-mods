+_URL_RE = re.compile(
+    r"\]\([^()\n]*(?:\([^()\n]*\)[^()\n]*)*\)|\]\([^)\n]*\)|(?:https?|ftp)://[^\s<>]+|www\.[^\s<>]+",
+    re.IGNORECASE)
