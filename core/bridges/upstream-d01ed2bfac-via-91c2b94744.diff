index 0000000000..e8ebf1ae74
--- /dev/null
+++ b/tests/hermes_cli/test_webapp_relay_target.py
@@ -0,0 +1,128 @@
+"""A saved gateway that stops answering never holds up this gateway's own traffic.
+
+Reaching a saved SSH gateway blocks for as long as its dial waits (ssh's 15 s connect timeout
+against a host that drops the connection). Relayed requests for it must not take the loop's default
+executor, which this gateway's own ``/api/ws`` handshake and routes run on, and requests waiting
+behind one dial must not each dial again, least of all after the connection is removed.
+"""
+import asyncio
+import threading
+from concurrent.futures import ThreadPoolExecutor
+
+import httpx
+import pytest
+
+from tests.hermes_cli.test_webapp_socket_tickets import _SESSION, serve_webapp
+from tests.waiting import async_wait_until
+
+_WORKERS = 4
+
+
+@pytest.fixture
+def unanswered(tmp_path, monkeypatch):
+    """The loopback Webapp. Every SSH master it opens waits for ``answer``, then times out the way
+    ``ssh`` does; ``dials`` lists the hosts dialed and ``asked`` counts the relay's resolutions."""
+    from hermes_cli import gateway_connections_ssh as ssh
+    from hermes_cli import webapp_relay_target as reach
+    from hermes_cli.gateway_connections_ssh_transport import SshReachError
+
+    served = serve_webapp(tmp_path, monkeypatch)
+    served.dials, served.asked, served.answer = [], [], threading.Event()
+
+    class Unanswered:
+        def __init__(self, endpoint, **_kwargs):
+            self.endpoint = endpoint
+
+        def open(self):
+            served.dials.append(self.endpoint.host)
+            served.answer.wait(30)
+            raise SshReachError("timeout", f"SSH operation to {self.endpoint.target} timed out.")
+
+    resolve = reach.resolve_target
+
+    async def asked(connection_id, **kwargs):
+        served.asked.append(connection_id)
+        return await resolve(connection_id, **kwargs)
+
+    monkeypatch.setattr(ssh, "SshConnection", Unanswered)
+    monkeypatch.setattr(ssh, "resolve_ssh_binary", lambda: "ssh")
+    monkeypatch.setattr(reach, "resolve_target", asked)
+    yield served
+    served.answer.set()
+
+
+def _save_ssh(host: str) -> str:
+    from hermes_cli import gateway_connections as store
+
+    saved, _registry = store.save_connection({"kind": "ssh", "label": f"Gone {host}", "host": host, "user": "operator"})
+    return saved["id"]
+
+
+def _relayed(served, connection_ids, each: int):
+    transport = httpx.ASGITransport(app=served.server.app)
+    tab = httpx.AsyncClient(transport=transport, base_url="http://localhost", headers=_SESSION)
+    pending = [asyncio.create_task(tab.get(f"/api/relay/{cid}/api/status")) for cid in connection_ids
+               for _ in range(each)]
+    return tab, pending
+
+
+def test_unanswered_saved_gateways_leave_the_default_executor_to_this_gateways_own_requests(unanswered):
+    ids = [_save_ssh(f"192.0.2.{n}") for n in range(1, _WORKERS + 1)]
+
+    async def scenario():
+        asyncio.get_running_loop().set_default_executor(ThreadPoolExecutor(_WORKERS))
+        tab, pending = _relayed(unanswered, ids, each=3)
+        try:
+            await async_wait_until(lambda: len(unanswered.asked) == len(pending) and unanswered.dials,
+                                   what="every relayed request waiting on a dial")
+            await asyncio.wait_for(asyncio.to_thread(lambda: "local"), timeout=5)
+        finally:
+            unanswered.answer.set()
+        statuses = [response.status_code for response in await asyncio.gather(*pending)]
+        await tab.aclose()
+        return statuses
+
+    assert asyncio.run(scenario()) == [409] * (_WORKERS * 3)
+
+
+def test_requests_waiting_on_one_dial_never_dial_a_removed_gateway_again(unanswered):
+    from hermes_cli import gateway_connections as store
+
+    cid = _save_ssh("192.0.2.1")
+
+    async def scenario():
+        tab, pending = _relayed(unanswered, [cid], each=_WORKERS)
+        try:
+            await async_wait_until(lambda: len(unanswered.asked) == _WORKERS and unanswered.dials,
+                                   what="every relayed request waiting on the dial")
+            store.remove_connection(cid)
+        finally:
+            unanswered.answer.set()
+        statuses = [response.status_code for response in await asyncio.gather(*pending)]
+        after = (await tab.get(f"/api/relay/{cid}/api/status")).status_code
+        await tab.aclose()
+        return statuses, after
+
+    statuses, after = asyncio.run(scenario())
+    assert unanswered.dials == ["192.0.2.1"]
+    assert statuses == [409] * _WORKERS and after == 404
+
+
+def test_a_caller_that_gives_up_leaves_the_shared_resolution_to_the_others(unanswered, monkeypatch):
+    from hermes_cli import webapp_relay_target as reach
+
+    busy, cid = _save_ssh("192.0.2.1"), _save_ssh("192.0.2.2")
+    monkeypatch.setattr(reach, "_POOL", ThreadPoolExecutor(1))
+
+    async def scenario():
+        holding = asyncio.create_task(reach.resolve_target(busy))
+        await async_wait_until(lambda: unanswered.dials, what="the only worker dialing another gateway")
+        leaving, staying = (asyncio.create_task(reach.resolve_target(cid)) for _ in range(2))
+        await async_wait_until(lambda: len(unanswered.asked) == 3, what="both callers waiting on one resolution")
+        leaving.cancel()
+        unanswered.answer.set()
+        return await asyncio.gather(holding, staying, return_exceptions=True)
+
+    outcomes = asyncio.run(scenario())
+    assert [type(outcome) for outcome in outcomes] == [reach.Unreachable, reach.Unreachable]
+    assert unanswered.dials == ["192.0.2.1", "192.0.2.2"]
diff --git a/tests/hermes_state/test_header_probe_release.py b/tests/hermes_state/test_header_probe_release.py
new file mode 100644
index 0000000000..1d6e9c2c9f
--- /dev/null
+++ b/tests/hermes_state/test_header_probe_release.py
@@ -0,0 +1,341 @@
+"""close_all_under releases the cached header-probe fds of the homes it sweeps.
+
+hermes_state_dbfile keeps one O_RDONLY fd per state.db for lock-safe header reads. Without
+this release a multiplexed gateway keeps one such fd for every profile it has unserved, until
+the process exits. The fd may only close once nothing else in the process has the inode open,
+because closing any descriptor on the file cancels the process's POSIX locks on it.
+"""
+
+import os
+import sqlite3
+import subprocess
+import sys
+import threading
+from pathlib import Path
+
+import pytest
+
+import hermes_state_dbfile as dbfile
+import hermes_state_registry as registry
+
+
+@pytest.fixture(autouse=True)
+def _clean_state(tmp_path):
+    registry.close_all()
+    registry._generations.clear()
+    registry._retired.clear()
+    registry._opening.clear()
+    registry._tearing_down.clear()
+    yield
+    registry.close_all()
+    # Only this test's probes: production keeps probes open on purpose (see the module docstring).
+    with dbfile._HEADER_PROBE_LOCK:
+        for key in [k for k in dbfile._HEADER_PROBE_FDS if Path(k).is_relative_to(tmp_path)]:
+            fd, _dev, _ino = dbfile._HEADER_PROBE_FDS.pop(key)
+            os.close(fd)
+
+
+def _probe(db_path):
+    assert dbfile._pread_db_header(db_path, 16) == b"SQLite format 3\x00"
+    fd = dbfile._HEADER_PROBE_FDS[str(db_path)][0]
+    os.set_inheritable(fd, True)  # a marker: os.open never sets it, so a re-opened probe lacks it
+    return fd
+
+
+def _is_open(fd):
+    try:
+        os.fstat(fd)
+    except OSError:
+        return False
+    return True
+
+
+def _assert_probe_kept(db_path, entry):
+    """The same probe, not just an open fd: a closed probe's number can be reused by the next open,
+    even by a re-probe that rebuilds an identical (fd, dev, ino) entry, so check _probe's marker too."""
+    assert dbfile._HEADER_PROBE_FDS.get(str(db_path)) == entry
+    assert _is_open(entry[0])
+    assert os.get_inheritable(entry[0]), "the probe was closed and re-opened"
+
+
+def _home(tmp_path, name):
+    home = tmp_path / "profiles" / name
+    home.mkdir(parents=True)
+    db_path = home / "state.db"
+    registry.release(registry.acquire(db_path))  # creates the schema; final release closes it
+    return home, db_path
+
+
+@pytest.mark.platforms("posix")
+def test_sweep_closes_the_probe_fd_of_a_closed_home(tmp_path):
+    home, db_path = _home(tmp_path, "work")
+    db = registry.acquire(db_path)
+    fd = _probe(db_path)
+
+    assert registry.close_all_under(home) == 1
+    assert db._conn is None
+    assert str(db_path) not in dbfile._HEADER_PROBE_FDS
+    assert not _is_open(fd)
+
+
+@pytest.mark.platforms("posix")
+def test_probe_left_by_an_earlier_close_is_released(tmp_path):
+    """The gateway case: the store already closed, only the probe fd remains."""
+    home, db_path = _home(tmp_path, "parked")
+    fd = _probe(db_path)
+
+    assert registry.close_all_under(home) == 0
+    assert not _is_open(fd)
+
+
+@pytest.mark.platforms("posix")
+def test_probe_kept_while_another_descriptor_holds_the_inode(tmp_path):
+    """A connection the registry cannot see (a bare sqlite3 one) keeps the probe open."""
+    home, db_path = _home(tmp_path, "busy")
+    fd = _probe(db_path)
+    entry = dbfile._HEADER_PROBE_FDS[str(db_path)]
+    conn = sqlite3.connect(db_path)
+    conn.execute("SELECT 1 FROM sqlite_master").fetchall()
+    try:
+        registry.close_all_under(home)
+        _assert_probe_kept(db_path, entry)
+    finally:
+        conn.close()
+
+    registry.close_all_under(home)
+    assert not _is_open(fd)
+
+
+@pytest.mark.platforms("posix")
+def test_probe_kept_when_a_tracked_connection_opens_after_the_scan(tmp_path, monkeypatch):
+    """A tracked connection the fd scan missed (it opened after the scan) keeps the probe open."""
+    home, db_path = _home(tmp_path, "tracked")
+    _probe(db_path)
+    entry = dbfile._HEADER_PROBE_FDS[str(db_path)]
+    conn = dbfile._connect_tracked_db(db_path)
+    monkeypatch.setattr(dbfile, "inodes_with_other_descriptors", lambda identities: set(), raising=False)
+    try:
+        registry.close_all_under(home)
+        _assert_probe_kept(db_path, entry)
+    finally:
+        conn.close()
+
+
+_LOCKF_CHILD = """import sys, fcntl
+f = open(sys.argv[1], "r+b")
+try:
+    fcntl.lockf(f.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB, 510, 1073741826)  # SQLite's SHARED range: in WAL mode the writer's lock on the main file
+    print("ACQUIRED")
+except BlockingIOError:
+    print("BLOCKED")
+"""
+
+
+@pytest.mark.platforms("posix")
+def test_hard_link_alias_opened_after_scan_keeps_probe(tmp_path, monkeypatch):
+    """A tracked open through a hard link after the scan is missed by the pathname-keyed guards;
+    closing the probe then would drop the alias writer's lock to another process."""
+    home, db_path = _home(tmp_path, "linked")
+    alias = tmp_path / "alias.db"  # outside the swept home
+    os.link(db_path, alias)
+    _probe(db_path)
+    entry = dbfile._HEADER_PROBE_FDS[str(db_path)]
+    from hermes_cli.sqlite_safe_read import connect_tracked
+
+    writers: list = []
+    scan = dbfile.inodes_with_other_descriptors
+
+    def _scan_then_open_alias(identities):
+        seen = scan(identities)
+        if not writers:
+            writer = connect_tracked(str(alias), tracking_path=alias)
+            writer.execute("BEGIN IMMEDIATE")
+            writer.execute("CREATE TABLE alias_write (x)")
+            writers.append(writer)
+        return seen
+
+    monkeypatch.setattr(dbfile, "inodes_with_other_descriptors", _scan_then_open_alias)
+    try:
+        registry.close_all_under(home)
+        _assert_probe_kept(db_path, entry)
+        locked = subprocess.run([sys.executable, "-c", _LOCKF_CHILD, str(db_path)],
+                                capture_output=True, text=True, check=True).stdout.strip()
+        assert locked == "BLOCKED"
+    finally:
+        for writer in writers:
+            writer.rollback()
+            writer.close()
+
+
+@pytest.mark.platforms("posix")
+def test_spillover_reader_starting_after_the_final_scan_waits_for_the_probe_close(tmp_path, monkeypatch):
+    """Session auto-prune's spillover reader can start between the final scan and the close.
+    Closing the probe under an open reader would drop the reader's SQLite lock mid-query, so the
+    reader must not open SQLite until the probe is closed."""
+    from tools.tool_result_storage import referenced_spillover_names
+
+    home, db_path = _home(tmp_path, "pruning")
+    _probe(db_path)
+    started = threading.Event()
+    probe_open_at_sqlite_open: list = []
+    result: list = []
+    real_sqlite_connect = sqlite3.connect
+
+    def _sqlite_connect(*args, **kwargs):
+        if threading.current_thread() is reader:
+            probe_open_at_sqlite_open.append(str(db_path) in dbfile._HEADER_PROBE_FDS)
+        return real_sqlite_connect(*args, **kwargs)
+
+    def _read():
+        started.set()
+        result.append(referenced_spillover_names(home / "cache" / "spillover"))
+
+    reader = threading.Thread(target=_read, daemon=True)
+    real_close = dbfile.close_header_probe_if_unchanged
+
+    def _start_reader_then_close(key, entry):  # runs after the final scan, before the close
+        reader.start()
+        assert started.wait(5.0)
+        reader.join(0.5)  # an unguarded reader opens SQLite (and starts its query) in here
+        return real_close(key, entry)
+
+    monkeypatch.setattr(sqlite3, "connect", _sqlite_connect)
+    monkeypatch.setattr(dbfile, "close_header_probe_if_unchanged", _start_reader_then_close)
+    registry.close_all_under(home)
+    reader.join(10.0)
+    assert not reader.is_alive()
+    assert str(db_path) not in dbfile._HEADER_PROBE_FDS
+    assert probe_open_at_sqlite_open == [False], "the reader opened SQLite while the probe was still open"
+    assert result == [set()]
+
+
+@pytest.mark.platforms("posix")
+def test_probe_kept_when_a_writer_is_published_after_the_sweep(tmp_path, monkeypatch):
+    """The #127811 shape: a caller acquires the path after the sweep tore it down."""
+    home, db_path = _home(tmp_path, "reopened")
+    _probe(db_path)
+    entry = dbfile._HEADER_PROBE_FDS[str(db_path)]
+    late: list = []
+    sweep = registry._teardown_swept_generations
+
+    def _sweep_then_reopen(*args, **kwargs):
+        closed = sweep(*args, **kwargs)
+        late.append(registry.acquire(db_path))
+        return closed
+
+    monkeypatch.setattr(registry, "_teardown_swept_generations", _sweep_then_reopen)
+    registry.close_all_under(home)
+    assert late and late[0]._conn is not None
+    _assert_probe_kept(db_path, entry)
+    registry.release(late[0])
+
+
+@pytest.mark.platforms("posix")
+def test_probe_kept_while_an_open_is_in_flight(tmp_path, monkeypatch):
+    """An acquire that is mid-open when the release runs keeps the probe open."""
+    home, db_path = _home(tmp_path, "opening")
+    _probe(db_path)
+    entry = dbfile._HEADER_PROBE_FDS[str(db_path)]
+    entered, resume = threading.Event(), threading.Event()
+    real_open = registry._open_session_db
+
+    def _paused_open(path):
+        entered.set()
+        assert resume.wait(10.0)
+        return real_open(path)
+
+    monkeypatch.setattr(registry, "_open_session_db", _paused_open)
+    opened: list = []
+    opener = threading.Thread(target=lambda: opened.append(registry.acquire(db_path)), daemon=True)
+    opener.start()
+    try:
+        assert entered.wait(5.0)
+        assert registry._opening.get(db_path.resolve()) is not None
+        sweeper = threading.Thread(target=registry.close_all_under, args=(home,), daemon=True)
+        sweeper.start()
+        sweeper.join(0.5)  # it waits on the lifecycle lock the opener holds
+        resume.set()
+        opener.join(10.0)
+        sweeper.join(10.0)
+        assert not sweeper.is_alive()
+    finally:
+        resume.set()
+    assert opened and opened[0]._conn is not None
+    _assert_probe_kept(db_path, entry)
+    registry.release(opened[0])
+
+
+@pytest.mark.platforms("posix")
+def test_probes_outside_the_swept_home_are_untouched(tmp_path):
+    home, _db_path = _home(tmp_path, "one")
+    _other_home, other_db = _home(tmp_path, "two")
+    _probe(other_db)
+    other_entry = dbfile._HEADER_PROBE_FDS[str(other_db)]
+
+    registry.close_all_under(home)
+    _assert_probe_kept(other_db, other_entry)
+
+
+@pytest.mark.platforms("posix")
+def test_two_spellings_of_one_path_do_not_pin_each_other(tmp_path):
+    """Probes hold no locks, so a second probe on the same inode must not keep the first open."""
+    home, db_path = _home(tmp_path, "aliased")
+    link = tmp_path / "alias"
+    link.symlink_to(home)
+    fd = _probe(db_path)
+    alias_fd = _probe(link / "state.db")
+
+    registry.close_all_under(home)
+    assert not _is_open(fd)
+    assert not _is_open(alias_fd)
+
+
+@pytest.mark.platforms("posix")
+def test_close_all_under_does_not_block_on_a_held_probe_lock(tmp_path, monkeypatch):
+    """The second scan runs while ``offline_file_access`` holds ``_live_lock``, so it must never
+    wait unbounded on ``_HEADER_PROBE_LOCK``: a writer holding that lock in ``_pread_db_range`` can
+    be waiting on ``_live_lock`` behind a collection that finalizes an unclosed ``SessionDB``, and
+    the sweep would park for good. Driving ``close_all_under`` end to end is the point: the leaf
+    call alone would still pass on a tree whose scan blocks."""
+    import contextlib
+
+    from hermes_cli import sqlite_safe_read
+
+    home, db_path = _home(tmp_path, "contended")
+    _probe(db_path)
+    entry = dbfile._HEADER_PROBE_FDS[str(db_path)]
+    lock_held = threading.Event()
+    release = threading.Event()
+
+    def _hold_lock():
+        with dbfile._HEADER_PROBE_LOCK:
+            lock_held.set()
+            assert release.wait(10.0)
+
+    holder = threading.Thread(target=_hold_lock, daemon=True)
+    real_offline_file_access = sqlite_safe_read.offline_file_access
+
+    @contextlib.contextmanager
+    def _contended_offline_file_access(path, **kwargs):
+        # The probe lock is held for the whole offline window, as a writer holds it inside
+        # _pread_db_range while _live_lock is held here.
+        with real_offline_file_access(path, **kwargs):
+            holder.start()
+            assert lock_held.wait(5.0)
+            try:
+                yield
+            finally:
+                release.set()
+                holder.join(10.0)
+
+    monkeypatch.setattr(sqlite_safe_read, "offline_file_access", _contended_offline_file_access)
+    sweeper = threading.Thread(target=registry.close_all_under, args=(home,), daemon=True)
+    sweeper.start()
+    sweeper.join(5.0)
+    try:
+        assert not sweeper.is_alive(), "the sweep waited on the probe lock while _live_lock was held"
+        _assert_probe_kept(db_path, entry)
+    finally:
+        release.set()
+        holder.join(10.0)
+        sweeper.join(10.0)
diff --git a/tests/hermes_state/test_reset_row_delegate_marker.py b/tests/hermes_state/test_reset_row_delegate_marker.py
new file mode 100644
index 0000000000..52eff03390
--- /dev/null
+++ b/tests/hermes_state/test_reset_row_delegate_marker.py
@@ -0,0 +1,122 @@
+"""A chat's /new continuation (``_reset_from``) never carries ``_delegate_from``: the marker hides the
+row from every session list while the gateway keeps routing the chat into it (#109073)."""
+
+from __future__ import annotations
+
+import json
+import sqlite3
+
+from hermes_state import SessionDB
+
+OLD, LIVE = "20260819_180933_c53aa488", "20260829_143124_a736cc"
+PEER = dict(user_id="410541755", session_key="agent:main:telegram:dm:410541755", chat_id="410541755",
+            chat_type="dm")
+
+
+def _config(db: SessionDB, sid: str) -> dict:
+    raw = db.get_session(sid)["model_config"]
+    return json.loads(raw) if isinstance(raw, str) else (raw or {})
+
+
+def _listed(db: SessionDB) -> list[str]:
+    return [s["id"] for s in db.list_sessions_rich(source="telegram", limit=50)]
+
+
+def _reset_chat(db: SessionDB) -> None:
+    db.create_session(OLD, "telegram", **PEER)
+    db.append_message(OLD, "user", "old")
+    db.end_session(OLD, "session_reset")
+    db.create_session(LIVE, "telegram", parent_session_id=OLD, model_config={"_reset_from": OLD}, **PEER)
+    db.append_message(LIVE, "user", "the live chat")
+
+
+def test_a_polluted_reset_row_is_listed_again_after_the_store_opens(tmp_path):
+    path = tmp_path / "state.db"
+    db = SessionDB(db_path=path)
+    _reset_chat(db)
+    db.close()
+    con = sqlite3.connect(path)  # the reporter's row, written by an older build
+    con.execute("UPDATE sessions SET model_config = json_set(model_config, '$._delegate_from', ?) WHERE id = ?",
+                (OLD, LIVE))
+    con.commit()
+    con.close()
+
+    db = SessionDB(db_path=path)
+    try:
+        assert _config(db, LIVE) == {"_reset_from": OLD}
+        assert _listed(db)[0] == LIVE
+    finally:
+        db.close()
+
+
+def test_a_config_arriving_with_a_delegate_marker_never_lands_on_a_reset_row(tmp_path):
+    db = SessionDB(db_path=tmp_path / "state.db")
+    try:
+        _reset_chat(db)
+        db.create_session(LIVE, "telegram", model_config={"_delegate_from": OLD, "max_iterations": 90}, **PEER)
+        assert _config(db, LIVE) == {"_reset_from": OLD, "max_iterations": 90}
+        assert _listed(db)[0] == LIVE
+        # A real delegate child (no reset marker) keeps its marker.
+        db.create_session("child", "subagent", parent_session_id=LIVE, model_config={"_delegate_from": LIVE})
+        assert _config(db, "child") == {"_delegate_from": LIVE}
+    finally:
+        db.close()
+
+
+def test_a_new_reset_row_with_a_delegate_marker_is_visible_before_reopen(tmp_path):
+    """A newly inserted polluted /new chat must not vanish until the store is reopened (#109073)."""
+    db = SessionDB(db_path=tmp_path / "state.db")
+    try:
+        db.create_session(OLD, "telegram", **PEER)
+        db.append_message(OLD, "user", "old chat")
+        db.end_session(OLD, "session_reset")
+        db.create_session(LIVE, "telegram", parent_session_id=OLD,
+                          model_config={"_reset_from": OLD, "_delegate_from": OLD}, **PEER)
+        db.append_message(LIVE, "user", "new chat")
+        assert _config(db, LIVE) == {"_reset_from": OLD}
+        assert _listed(db)[0] == LIVE
+    finally:
+        db.close()
+
+
+def test_a_new_keyed_row_with_only_a_delegate_marker_stays_hidden(tmp_path):
+    """No reset marker: indistinguishable from a captured delegate child (#138210), so it keeps the marker."""
+    db = SessionDB(db_path=tmp_path / "state.db")
+    try:
+        db.create_session(OLD, "telegram", **PEER)
+        db.create_session(LIVE, "telegram", parent_session_id=OLD, model_config={"_delegate_from": OLD}, **PEER)
+        db.append_message(LIVE, "user", "subagent work")
+        assert _config(db, LIVE) == {"_delegate_from": OLD}
+        assert LIVE not in _listed(db)
+    finally:
+        db.close()
+
+
+def test_a_healed_reset_row_is_indexed_for_substring_search(tmp_path):
+    """The marker kept the row's messages out of the trigram index; the heal must put them in."""
+    path = tmp_path / "state.db"
+    db = SessionDB(db_path=path)
+    db.create_session(OLD, "telegram", **PEER)
+    db.end_session(OLD, "session_reset")
+    db.create_session(LIVE, "telegram", parent_session_id=OLD, model_config={"_reset_from": OLD}, **PEER)
+    trigram = db._trigram_available
+    db.close()
