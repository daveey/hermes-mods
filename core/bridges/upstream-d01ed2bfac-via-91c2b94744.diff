+    - walrus_sync
+    - walrus_verify
+    - memory_import
+  requires_env: []
+optional_env:
+  - WALRUS_DELEGATE_KEY
+  - WALRUS_ACCOUNT_ID
+  - WALRUS_NAMESPACE
+  - WALRUS_SEAL_SESSION
+  - WALRUS_SEAL_BRIDGE
+  - WALRUS_SEAL_SDK_ROOT
