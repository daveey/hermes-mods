+    (staged / "vcruntime140.dll").write_bytes(b"arm64")
+
+    monkeypatch.setattr(filesystem, "_HELD_RETRY_DELAYS", (0,) * len(filesystem._HELD_RETRY_DELAYS))
+    refusals: list[str] = []
+    real_unlink = os.unlink
