+++ b/tests/tools/test_hosted_process_host_state.py
@@ -0,0 +1,99 @@
+"""A hosted agent's process activity leaves this host's process files alone: the running-process
+checkpoint (``processes.json``) and the completed-process receipts under ``logs/process-results``.
+Its remote kernel's commands run under the turn that issues them."""
+from __future__ import annotations
+
+import json
+import os
+import time
+
+from tests.tools.test_sandbox_scope_conformance import A
+from tests.tools.test_sandbox_scope_conformance import provider as _conformance_provider
+from tools.environments import sandbox_conformance as conformance
+
+provider = _conformance_provider
+
+
+def _state(path):
+    """Existence, mtime and bytes: a rewrite with identical content still changes the mtime."""
+    return (path.stat().st_mtime_ns, path.read_bytes()) if path.exists() else None
+
+
+def test_a_hosted_background_start_and_kill_leave_the_host_checkpoint_alone(provider):
+    from hermes_constants import get_hermes_home
+    ckpt = get_hermes_home() / "processes.json"
+    before = _state(ckpt)
+    with conformance._bind(A):
+        started = conformance.call_tool("terminal", {"command": "sleep 600", "background": True}, task_id="t")
+        session_id = started.get("session_id")
+        assert session_id, f"the background spawn failed: {started}"
+        polled = conformance.call_tool("process_manage", {"action": "poll", "session_id": session_id}, task_id="t")
+        assert polled.get("session_id") == session_id, polled
+        killed = conformance.call_tool("process_manage", {"action": "kill", "session_id": session_id}, task_id="t")
+        assert killed.get("status") in ("killed", "already_exited"), killed
+    assert _state(ckpt) == before, "a hosted process start or kill rewrote this host's processes.json"
+
+
+def test_hosted_process_manage_does_not_load_or_prune_host_receipts(provider, monkeypatch):
+    from gateway.session_context import scoped_current_session_id
+    from hermes_constants import get_hermes_home
+    from tools import process_registry_results as results
+
+    directory = get_hermes_home() / "logs" / "process-results"
+    directory.mkdir(parents=True, exist_ok=True)
+    record = {key: None for key in results._RESULT_FIELDS}
+    fresh, expired = directory / "proc_hostfresh.json", directory / "proc_hostexpired.json"
+    for path in (fresh, expired):
+        fresh_record = {**record, "id": path.stem, "command": "echo HOST", "parent_session_id": "sess-1",
+                        "output": "HOST-RECEIPT", "exit_code": 0}
+        path.write_text(json.dumps(fresh_record), encoding="utf-8")
+    old = time.time() - results.RESULT_RETENTION_SECONDS - 3600
+    os.utime(expired, (old, old))
+    before = {path: _state(path) for path in (fresh, expired)}
+
+    read = []
+    real_paths = results._result_paths
+    monkeypatch.setattr(results, "_result_paths", lambda: read.append(1) or real_paths())
+    with scoped_current_session_id("sess-1"), conformance._bind(A):
+        for args in ({"action": "list"}, {"action": "poll", "session_id": "proc_hostfresh"},
+                     {"action": "poll", "session_id": "proc_hostf"}):
+            out = conformance.call_tool("process_manage", args, task_id="t")
+            assert "HOST-RECEIPT" not in json.dumps(out), out
+    assert not read, "a hosted process_manage read this host's process receipts"
+    assert {path: _state(path) for path in (fresh, expired)} == before, "a hosted call pruned host receipts"
+
+
+def test_a_local_background_start_still_writes_the_checkpoint(tmp_path):
+    from hermes_constants import get_hermes_home
+    from tools.process_registry import ProcessRegistry
+    ckpt = get_hermes_home() / "processes.json"
+    registry = ProcessRegistry()
+    session = registry.spawn_local("sleep 30", cwd=str(tmp_path), task_id="t")
+    try:
+        assert session.id in json.dumps(json.loads(ckpt.read_text(encoding="utf-8")))
+    finally:
+        registry.kill_process(session.id)
+
+
+def test_a_remote_kernel_command_on_a_later_turn_runs_under_that_turns_scope():
+    """The kernel record keeps the scope of the turn that spawned it; a later turn of the same
+    sandbox runs its kernel commands under its own scope (and fence), not the spawning turn's."""
+    from agent.runtime_scope import bind_state
+    from hermes_scope import Fence
+    from tools.code_kernel_remote import RemoteKernel
+    from tools.environments.sandbox_scope import ScopedEnvironment, sandbox_identity
+
+    turn1, turn2 = A.for_turn("s", "turn-1", Fence(1, 1)), A.for_turn("s", "turn-2", Fence(1, 2))
+    reached = []
+
+    class Backend:
+        def execute(self, command, cwd=None, timeout=30, scope=None):
+            reached.append(scope)
+            return {"output": ""}
+
+    kernel = RemoteKernel(env=ScopedEnvironment(Backend(), sandbox_identity(A), owner=turn1), env_type="stub",
+                          kernel_dir="/workspace/k", pid="4242", rpc_token="tok",
+                          owner="sandbox:acme/agent-a:s", owner_scope=turn1)
+    with bind_state(turn2):
+        kernel.sh("true")
+    assert reached and reached[-1] is turn2, f"a turn-2 kernel command ran under {reached[-1]!r}"
diff --git a/tests/tools/test_hosted_reaper_keepalive.py b/tests/tools/test_hosted_reaper_keepalive.py
new file mode 100644
index 0000000000..eb7ef2dfd5
--- /dev/null
+++ b/tests/tools/test_hosted_reaper_keepalive.py
@@ -0,0 +1,72 @@
+"""The idle reaper keeps a hosted sandbox while any process carrying its key runs, even when the
+environment object cached under that key is not the one the process was spawned through; once the
+process is gone, the sandbox is suspended, not destroyed."""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+
+from tests.tools.test_sandbox_scope_conformance import A
+from tests.tools.test_sandbox_scope_conformance import provider as _conformance_provider
+from tools.environments import sandbox_conformance as c
+
+provider = _conformance_provider  # the recording-sandbox fixture, by its name
+
+
+@contextmanager
+def _running_under_replaced_env(provider):
+    """Start a hosted background process through the terminal tool, then cache a second environment
+    of the same sandbox (created and wrapped as the hosted cache holds it) under the sandbox key."""
+    from tools import terminal_tool
+    from tools.environments.sandbox_scope import create_hosted_environment
+    from tools.process_registry import process_registry
+    with c._bind(A):
+        started = c.call_tool("terminal", {"command": "sleep 600", "background": True}, task_id="t")
+    session_id = started.get("session_id")
+    assert session_id, f"the background spawn failed: {started}"
+    key = c._identity(A).key
+    try:
+        original = terminal_tool._active_environments[key]
+        with c._bind(A):
+            replacement = create_hosted_environment(c.STUB_BACKEND, provider, cwd="/workspace", timeout=60)
+        assert replacement is not original and replacement.sandbox == original.sandbox
+        terminal_tool._active_environments[key] = replacement
+        # The state the key rule exists for: the process is no longer matched by environment object.
+        assert not process_registry.has_running_in_env(key, replacement)
+        yield key, session_id
+    finally:
+        with c._bind(A):
+            c.call_tool("process_manage", {"action": "kill", "session_id": session_id}, task_id="t")
+        terminal_tool._active_environments.pop(key, None)
+        terminal_tool._last_activity.pop(key, None)
+
+
+def test_hosted_sandbox_is_kept_while_a_process_carrying_its_key_runs(provider):
+    """Pins the hosted keep-alive rule: a sandbox is kept while a process carrying its key runs, even
+    when its cached environment is not the object that process was spawned through. No production
+    path produces that state today; the cache entry is replaced directly."""
+    from tools import terminal_tool
+    from tools.terminal_tool_lifecycle import _cleanup_inactive_envs
+    with _running_under_replaced_env(provider) as (key, _session_id):
+        c._age_sandbox(A)
+        seen = len(provider.calls)
+        _cleanup_inactive_envs(lifetime_seconds=300)
+        assert key in terminal_tool._active_environments, "a sandbox with running work was reaped"
+        assert not [call.op for call in provider.calls[seen:] if call.op in ("cleanup", "stop_idle")]
+
+
+def test_hosted_sandbox_is_suspended_once_that_process_has_exited(provider):
+    """Control: in the same replaced-environment state, once the process is killed the next reaper pass
+    suspends the sandbox (``stop_idle``); it is not destroyed."""
+    from tools import terminal_tool
+    from tools.terminal_tool_lifecycle import _cleanup_inactive_envs
+    with _running_under_replaced_env(provider) as (key, session_id):
+        with c._bind(A):
+            killed = c.call_tool("process_manage", {"action": "kill", "session_id": session_id}, task_id="t")
+        assert killed.get("status") in ("killed", "already_exited"), killed
+        c._age_sandbox(A)
+        seen = len(provider.calls)
+        _cleanup_inactive_envs(lifetime_seconds=300)
+        assert key not in terminal_tool._active_environments, "an idle sandbox was kept"
+        lifecycle = [call.op for call in provider.calls[seen:] if call.op in ("cleanup", "stop_idle")]
+        assert lifecycle == ["stop_idle"], f"the idle sandbox was not suspended: {lifecycle}"
diff --git a/tests/tools/test_hosted_relative_paths.py b/tests/tools/test_hosted_relative_paths.py
