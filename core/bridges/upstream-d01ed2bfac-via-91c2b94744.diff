+                                 result={'result': {'cron_result': [True, 'doc', 'answer', None]}, 'usage': {}})
+            await asyncio.wait_for(firer, 10)
+            return sid, row
+        finally:
+            session_cron.unbind_owner(authority)
+
+    try:
+        sid, row = asyncio.run(probe())
+    finally:
+        db.close()
+    [scope] = seen
+    assert isinstance(scope, TurnScope), scope
