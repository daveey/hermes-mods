+    expect(CaptureRecorder.instances[0].state).toBe('inactive')
+    expect(tracks[0].stop).toHaveBeenCalledOnce()
+    expect(node.port.close).toHaveBeenCalledOnce()
+    expect(context.resume).toHaveBeenCalledOnce()
