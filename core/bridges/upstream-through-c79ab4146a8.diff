+    expect(f.delivered).toEqual(['new-document'])
+  }
+})
+
+test('cancelled work cannot fire later', () => {
+  const f = fixture()
+  f.request({ token: 'cancelled', delayMs: 400 })
+  f.request({ token: 'cancelled', delayMs: null })
