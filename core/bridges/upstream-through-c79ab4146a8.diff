+import processorUrl from './voice-level-processor.ts?worker&url'
+
+/** Functional voice detection follows captured audio, not the window's paint clock. */
+export function startVoiceLevelMeter(
+  context: AudioContext,
+  source: MediaStreamAudioSourceNode,
+  onLevel: (level: number, audioTimeMs: number, isCurrent: boolean) => void,
+  onError: () => void
+): { stop: () => void; ready: Promise<boolean> } {
+  let disposed = false
+  let node: AudioWorkletNode | null = null
+  let connected = false
+  let running = context.state === 'running'
+  const { promise: ready, resolve: settleReady } = Promise.withResolvers<boolean>()
+
+  const stop = () => {
+    disposed = true
+    settleReady(false)
+    context.removeEventListener('error', fail)
+    context.removeEventListener('statechange', checkState)
+
+    if (!node) {
+      return
+    }
+
+    node.onprocessorerror = null
+    node.port.onmessage = null
+    node.port.close()
+
+    if (connected) {
+      source.disconnect(node)
+      connected = false
+    }
+
+    node.disconnect()
+    node = null
+  }
+
+  const fail = () => {
+    if (!disposed) {
+      stop()
+      onError()
+    }
+  }
+
+  const checkState = () => {
+    if (context.state === 'running') {
+      running = true
+    } else if (running || context.state === 'closed') {
+      fail()
+    }
+  }
+
+  // A stopped audio clock cannot deliver the silence that ends a voice turn.
+  context.addEventListener('error', fail)
+  context.addEventListener('statechange', checkState)
+
+  void (async () => {
+    const resumed = context.state === 'suspended' ? context.resume().catch(fail) : Promise.resolve()
+    await Promise.all([context.audioWorklet.addModule(processorUrl), resumed])
+
+    if (disposed) {
+      return
