+  route: { connectionId: 'other-box', mode: 'remote', profile: 'spoofed', targetProfile: 'spoofed' }
+}
+
+const alpha: RosterRow = { name: 'alpha', connectionId: 'local' }
+const beta: RosterRow = { name: 'beta', connectionId: 'local' }
