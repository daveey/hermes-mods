+const remote = (name: string): RosterRow => ({
+  name,
+  connectionId: 'other-box',
+  connectionLabel: 'Other box',
+  remoteSource: true,
+  route: { connectionId: 'other-box', mode: 'remote', profile: name, targetProfile: name }
