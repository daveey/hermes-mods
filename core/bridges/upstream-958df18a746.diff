+
+it('names who the lead gave the message to, by their room names', () => {
+  render(<CanonicalGroupAssignmentRow event={assignment({ lead_member_id: 'm-ada', member_ids: ['m-linus', 'm-grace'], fallback: false })} members={members} />)
