+    await expect(redial).resolves.toBeUndefined()
+    expect(client.connectionState).toBe('open')
+    await expect(client.request('ping')).resolves.toEqual({})
+    expect(connections).toBe(2)
+  } finally {
+    off()
+    await shut(client, server)
