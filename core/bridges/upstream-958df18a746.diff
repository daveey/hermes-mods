+const listeners: Array<(event: { payload?: unknown }) => void> = []
+
+vi.mock('@hermes/plugin-sdk', async () => {
+  const { atom } = await import('nanostores')
+
+  const stub: unknown = new Proxy(function stubbed() {}, {
