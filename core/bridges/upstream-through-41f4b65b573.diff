+@method("image.render")
+def _(rid, params: dict) -> dict:
+    """Params: ``path``, ``cols``/``rows`` (cell budget), ``graphics`` (client owns a real
+    terminal), ``terminal`` (the client's own protocol pick). Result: ``{mode, cols, rows, ...}``
+    — see ``ImageRenderResult``."""
