diff --git a/gateway/session_bot_cancel.py b/gateway/session_bot_cancel.py
new file mode 100644
index 00000000000..cc57c314517
--- /dev/null
+++ b/gateway/session_bot_cancel.py
@@ -0,0 +1,64 @@
+"""``bot_relay.cancel``: a ``message_agent`` sender withdraws its own delivery by ``delivery_id``.
+
+The cancel runs on the delivery's owner under the same mailbox lock that admits the delivery's one
+automatic retry (``gateway/session_bot.py::_maybe_retry``), so it always sees which admission is the
+request now. A sender that picked an admission from the receipt file could race that retry: the
+first attempt already failed, the retry not yet recorded, and "nothing to cancel" while it runs.
+
+Whatever this finds, a retry not admitted yet is withdrawn for good (the receipt's ``retry`` marks
+it refused ``cancelled``), so no later wake, re-delivery or owner restart admits it.
+"""
+import asyncio
+
+from gateway.session_contract import SessionRef
+from hermes_state_runtime import RuntimeStoreError, get_session_admission
+
+_FIELDS = frozenset({'id', 'profile', 'author_id'})
+
+
+async def cancel(connection, params):
+    from gateway.session_authorities import require_serving
+    from gateway.session_runtime_workers import track_mutation
+    require_serving(connection.authority)
+    return await asyncio.shield(track_mutation(connection.authority, _cancel(connection, params)))
+
+
+async def _cancel(connection, params):
+    from gateway.session_bot import (_delivery_id, _delivery_result, _home, _retry_admission, _retry_eligible,
+                                     _retry_identity)
+    from gateway.session_bot_mailbox import mailbox_lock, read_receipt, remember_receipt, write_receipt
+    authority, actor = connection.authority, connection.actor
+    if set(params) - _FIELDS:
+        raise RuntimeStoreError('invalid_params')
+    home = _home(authority, actor, params.get('profile'))
+    try:
+        key = _delivery_id(params.get('id'))
+    except ValueError as exc:
+        raise RuntimeStoreError('invalid_params') from exc
+    async with mailbox_lock(authority):
+        _, record = await read_receipt(home, key)
+        if record is None or not record.get('admission_id'):
+            raise RuntimeStoreError('not_found')
+        # Only the delivery's own sender: the principal it was admitted on and the bot it named.
+        if record['principal_id'] != actor.subject or (record.get('author') or {}).get('id') != params.get('author_id'):
+            raise RuntimeStoreError('permission_denied')
+        retry_id = _retry_admission(authority, record)
+        current = retry_id or record['admission_id']
+        row = get_session_admission(authority.db, admission_id=current)
+        live = row is not None and row['status'] != 'terminal'
+        withdrawn = retry_id is None and (live or _retry_eligible(authority, record))
+        if withdrawn:
+            record['retry'] = {**(record.get('retry') or {}), 'identity': _retry_identity(key), 'refused': 'cancelled'}
+        status = 'finished'
+        if live:
+            answer = await connection.cancel(SessionRef(authority.profile_id, record['session_id']),
+                                             {'admission_id': current})
+            status = 'stopping'  # a running turn was told to stop; its receipt reports how it ended
+            if answer['status'] == 'terminal':
+                status = 'cancelled' if answer.get('outcome') == 'cancelled' else 'finished'
+        elif withdrawn:
+            status = 'cancelled'  # its first attempt failed; the retry it was owed never starts
+        record.update(_delivery_result(authority, record))
+        await write_receipt(home, record)
+        remember_receipt(authority, home, record)
+        return {'delivery_id': key, 'status': status, 'receipt_status': record['status']}
diff --git a/gateway/session_bot_outcome.py b/gateway/session_bot_outcome.py
new file mode 100644
index 00000000000..94cc93aca25
--- /dev/null
+++ b/gateway/session_bot_outcome.py
@@ -0,0 +1,65 @@
+"""What a teammate's finished turn tells the ``message_agent`` sender that asked it something.
+
+Forgotten reply: the single-reply protocol makes the teammate's final response the reply. A model that ends its
+turn with a silence marker or nothing, after it wrote its answer beside a tool call or tried to
+send it back through ``message_agent`` (refused: the final response is the reply), would leave the
+sender with an empty receipt. Its last visible words that turn are relayed instead, once, marked
+so the sender knows they were not a final answer. A notify-only request (``[no reply needed]``)
+never gets one: silence is its expected outcome.
+"""
+import json
+
+FORGOTTEN_REPLY_PREFIX = '[no final reply; their last message this turn:] '
+
+
+# A turn its own gateway's stop or restart interrupted settles ``interrupted`` and is never re-run: for
+# the sender that is a dead request, not a cancel it asked for.
+OWNER_STOPPED_ERROR = ('its gateway stopped or restarted mid-turn, so the turn was interrupted and is not '
+                       'run again (some steps may already have run)')
+
+
+def owner_stopped(result):
+    """True for a turn result its own gateway's stop or restart interrupted (``gateway/run.py`` reasons)."""
+    from gateway.run import _INTERRUPT_REASON_GATEWAY_RESTART, _INTERRUPT_REASON_GATEWAY_SHUTDOWN
+    return result.get('interrupt_message') in (_INTERRUPT_REASON_GATEWAY_RESTART, _INTERRUPT_REASON_GATEWAY_SHUTDOWN)
+
+
+def forgotten_reply(authority, admission_id, record):
+    """The marked fallback reply for ``record``'s settled-but-empty admission, or None."""
+    from tools.bot_mode_probe import NO_REPLY_MARKER
+    author = record.get('author') or {}
+    if not author.get('is_bot') or NO_REPLY_MARKER in (record.get('message') or ''):
+        return None
+    from gateway.session_results import admission_result
+    saved = (admission_result(authority.db, admission_id) or {}).get('result') or {}
+    text = _last_words(saved.get('messages') or [], str(author.get('name') or '').lower())
+    return FORGOTTEN_REPLY_PREFIX + text if text else None
+
+
+def _last_words(messages, sender):
+    from gateway.response_filters import is_intentional_silence_response
+    for message in reversed(messages):
+        if not isinstance(message, dict) or message.get('role') != 'assistant':
+            continue
+        for call in reversed(message.get('tool_calls') or []):
+            text = _reply_attempt(call, sender)
+            if text:
+                return text
+        content = message.get('content')
+        if isinstance(content, str) and content.strip() and not is_intentional_silence_response(content):
+            return content.strip()
+    return None
+
+
+def _reply_attempt(call, sender):
+    """The body of a ``message_agent`` call this turn made back to its own sender."""
+    function = (call or {}).get('function') or {} if isinstance(call, dict) else {}
+    if function.get('name') != 'message_agent':
+        return None
+    try:
+        args = json.loads(function.get('arguments') or '{}')
+    except ValueError:
+        return None
+    if not isinstance(args, dict) or str(args.get('target') or '').strip().lstrip('@').lower() != sender:
+        return None
+    return str(args.get('message') or '').strip() or None
diff --git a/gateway/session_bot_state.py b/gateway/session_bot_state.py
new file mode 100644
index 00000000000..0619c6ec200
--- /dev/null
+++ b/gateway/session_bot_state.py
@@ -0,0 +1,27 @@
+"""A Bot Chat's live state, handed to the teammate whose ``message_agent`` delivery it answers.
+
+A sender that only learns "queued" cannot tell a busy teammate from one parked on its user's
+approval or clarify card; it waits out the bound and reports a silent timeout. The deliver answer
+(and every same-id replay the waiting runner makes) carries this state instead. Read on the owner
+loop, never persisted: a receipt holds outcomes, not a snapshot that is stale a second later.
+"""
+from gateway.session_contract import SessionRef
+
+# Prompt kinds a running turn parks on, in the order a sender should hear about them.
+_WAITING_KINDS = ('approval', 'clarify')
+
+
+def bot_chat_state(authority, session_id):
+    """``paused`` (the owner admits nothing new: a drain for restart/update or retirement),
+    ``idle``, ``working``, or ``waiting_approval`` / ``waiting_clarify`` while the running turn
+    waits on its user."""
+    if authority.retiring or authority.runner._draining:
+        return 'paused'
+    live = authority.sessions.get(session_id)
+    if live is None:
+        return 'idle'
+    handle = authority._handle(SessionRef(authority.profile_id, session_id))
+    if handle.execution_state != 'running':
+        return 'idle'
+    kinds = {prompt['kind'] for prompt in live.controls.snapshot(session_id, handle.execution_generation)}
+    return next((f'waiting_{kind}' for kind in _WAITING_KINDS if kind in kinds), 'working')
