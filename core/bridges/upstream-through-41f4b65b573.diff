diff --git a/tests/hermes_cli/test_webapp_access_start_record.py b/tests/hermes_cli/test_webapp_access_start_record.py
new file mode 100644
index 00000000000..dcfadb6cab7
--- /dev/null
+++ b/tests/hermes_cli/test_webapp_access_start_record.py
@@ -0,0 +1,300 @@
+"""A Start's record covers the whole Start, not just its request.
+
+``start_progress`` on ``/api/webapp-access/status`` names the step a Start is on. It is reported
+from the moment the Start is asked for, ``preparing`` while another Web Access change holds the
+backend's one change lock, until the restart it asked for has put a gateway serving the new config
+in place, that restart failed, or the pane's own wait for it has run out. A pane opened at any point
+in between shows the Start running and keeps its controls disabled instead of offering Start or
+Restart gateway. Each Start keeps its own record, so one Start ending cannot hide another.
+Review of #148408 (teknium1, yoniebans).
+"""
+
+from __future__ import annotations
+
+import threading
+import time
+from typing import Any
+
+import pytest
+
+pytest.importorskip("fastapi")
+from fastapi.testclient import TestClient
+
+from tests.hermes_cli.native_gateway_client import native_desktop_client
+from tests.waiting import wait_until
+
+RESTART_PID = 4242
+
+
+@pytest.fixture(autouse=True)
+def starts(monkeypatch):
+    """This backend's Start records, fresh for each test: a followed restart outlives its request."""
+    from hermes_cli.web_routers import webapp_access as routes
+
+    records: dict = {}
+    monkeypatch.setattr(routes, "_STARTS", records)
+    return records
+
+
+@pytest.fixture()
+def client(monkeypatch):
+    return native_desktop_client(monkeypatch)
+
+
+@pytest.fixture()
+def nous(monkeypatch):
+    from hermes_cli import webapp_access
+
+    monkeypatch.setattr(webapp_access, "nous_signed_in", lambda: True)
+    monkeypatch.setattr(webapp_access, "_register_nous_sign_in", lambda _callback: None)
+    monkeypatch.setattr(webapp_access, "lan_address", lambda: "192.168.1.50")
+
+
+@pytest.fixture()
+def gateway(monkeypatch):
+    """The gateway as its control socket answers: the old one, serving no Webapp, until a test puts
+    its replacement in place (another ``instance``). A restart is recorded and answers with its
+    child's pid."""
+    import hermes_cli.web_server_gateway as gw
+    from hermes_cli import webapp_access
+
+    state = {"now": {"state": "off", "url": None, "reason": None}, "instance": (1000, 1), "restarts": [],
+             "failure": None,
+             "restart": {"restart_started": True, "restart_action": "gateway-restart", "restart_pid": RESTART_PID}}
+
+    def restart(_profile, *, what, label):
+        state["restarts"].append(what)
+        return dict(state["restart"])
+
+    monkeypatch.setattr(webapp_access, "_gateway_state", lambda _home: dict(state["now"]))
+    monkeypatch.setattr(webapp_access, "gateway_instance", lambda: state["instance"])
+    monkeypatch.setattr(gw, "_restart_gateway_after", restart)
+    monkeypatch.setattr(gw, "gateway_restart_failure", lambda _profile: state["failure"])
+    return state
+
+
+def _serving(port: int) -> dict:
+    return {"state": "serving", "url": f"http://192.168.1.50:{port}", "reason": None}
+
+
+@pytest.fixture()
+def instant_build(monkeypatch):
+    from hermes_cli import webapp
+
+    monkeypatch.setattr(webapp, "prepare_webapp_renderer", lambda project_root, **_options: webapp.webapp_dist_dir(project_root))
+
+
+class _Builds:
+    """``prepare_webapp_renderer`` that holds each build until the test allows one more to finish.
+    Teardown lets every held build go, so a failed test leaves no Start holding the change lock."""
+
+    def __init__(self, monkeypatch):
+        from hermes_cli import webapp
+
+        self._started = threading.Semaphore(0)
+        self._allowed = threading.Semaphore(0)
+        dist = webapp.webapp_dist_dir
+
+        def build(project_root, **_options):
+            self._started.release()
+            assert self._allowed.acquire(timeout=20), "the build was never allowed to finish"
+            return dist(project_root)
+
+        monkeypatch.setattr(webapp, "prepare_webapp_renderer", build)
+
+    def wait_started(self) -> None:
+        assert self._started.acquire(timeout=20), "the build never started"
+
+    def finish_one(self) -> None:
+        self._allowed.release()
+
+
+@pytest.fixture()
+def builds(monkeypatch):
+    held = _Builds(monkeypatch)
+    yield held
+    for _ in range(4):
+        held.finish_one()
+
+
+def _status(client, profile: str | None = None) -> dict:
+    other = TestClient(client.app, raise_server_exceptions=False)
+    response = other.get("/api/webapp-access/status", params={"profile": profile} if profile else None)
+    assert response.status_code == 200, response.text
+    return response.json()
+
+
+def _progress(client, profile: str | None = None) -> Any:
+    return _status(client, profile)["start_progress"]
+
+
+def _start_in_background(client, profile: str | None = None) -> threading.Thread:
+    def run() -> None:
+        other = TestClient(client.app, raise_server_exceptions=False)
+        response = other.post("/api/webapp-access/start", json={"mode": "lan"},
+                              params={"profile": profile} if profile else None)
+        assert response.status_code == 200, response.text
+
+    thread = threading.Thread(target=run, daemon=True)
+    thread.start()
+    return thread
+
+
+def _joined(*threads: threading.Thread) -> None:
+    for thread in threads:
+        thread.join(timeout=20)
+        assert not thread.is_alive(), "a Start never answered"
+
+
+def _reports(client, step: str, profile: str | None = None) -> Any:
+    return wait_until(lambda: (p := _progress(client, profile)) and p["step"] == step and p,
+                      what=f"a Start reported {step!r}")
+
+
+def test_a_start_waiting_for_another_gateways_start_is_reported_from_when_it_was_asked(nous, gateway, builds, monkeypatch):
+    from hermes_constants import get_hermes_home
+
+    solo = get_hermes_home() / "profiles" / "solo"
+    solo.mkdir(parents=True)
+    (solo / "config.yaml").write_text("gateway:\n  standalone: true\n", encoding="utf-8")
+    client = native_desktop_client(monkeypatch, {"solo": solo})
+
+    first = _start_in_background(client)
+    builds.wait_started()
+    asked = time.time()
+    second = _start_in_background(client, "solo")
+
+    waiting = _reports(client, "preparing", "solo")
+    assert asked <= waiting["started_at"] <= time.time()
+    assert _progress(client)["step"] == "building"
+
+    # The default gateway's Start lets go of the change lock; the same record moves on, clock and all.
+    builds.finish_one()
+    builds.wait_started()
+    assert _progress(client, "solo") == {"step": "building", "started_at": waiting["started_at"]}
+
+    builds.finish_one()
+    _joined(first, second)
+
+
+def test_one_start_ending_leaves_the_start_queued_behind_it_on_the_same_gateway(client, nous, gateway, builds, starts):
+    # Refused restarts: each Start's record ends with its own request.
+    gateway["restart"] = {"restart_started": False, "restart_error": "a chat is running", "restart_busy": True}
+
+    first = _start_in_background(client)
+    builds.wait_started()
+    first_started_at = _progress(client)["started_at"]
+    second = _start_in_background(client)
+    # Black-box status shows the running Start, not the one waiting behind it; count the records.
+    wait_until(lambda: sum(map(len, starts.values())) == 2, what="the second Start to queue")
+    released = time.time()
+
+    builds.finish_one()
+    builds.wait_started()
+
+    queued = _progress(client)
+    assert queued["step"] == "building"
+    assert first_started_at < queued["started_at"] < released
+
+    builds.finish_one()
+    _joined(first, second)
+    assert _progress(client) is None
+
+
+def test_a_start_is_reported_restarting_until_the_restarted_gateway_serves_it(client, nous, gateway, instant_build):
+    response = client.post("/api/webapp-access/start", json={"mode": "lan"})
+    assert response.status_code == 200, response.text
+    answer = response.json()
+    port = answer["port"]
+    # The pane keeps Start's answer as the status it shows: where the backend answering is the
+    # gateway being restarted, no status read succeeds until the new one is up, so the answer
+    # itself says the Start is restarting.
+    assert answer["start_progress"]["step"] == "restarting"
+
+    # The request answered; the old gateway still serves no Webapp.
+    assert _progress(client) == answer["start_progress"]
+
+    gateway["now"], gateway["instance"] = _serving(port), (1001, 2)
+    assert _progress(client) is None
+
+
+def test_the_gateway_a_start_restarts_does_not_end_it_by_serving_an_earlier_config_on_its_port(
+        client, nous, gateway, instant_build):
+    # An earlier Start's gateway serves the Webapp on this port; only its replacement reads this
+    # Start's mode and address.
+    port = client.get("/api/webapp-access/status").json()["port"]
+    gateway["now"] = _serving(port)
+
+    assert client.post("/api/webapp-access/start", json={"mode": "lan"}).status_code == 200
+
+    assert _progress(client)["step"] == "restarting"
+    gateway["instance"] = (1001, 2)
+    assert _progress(client) is None
+
+
+def test_a_later_starts_restart_replaces_the_one_an_earlier_start_is_followed_by(client, nous, gateway, builds):
+    first = _start_in_background(client)
+    builds.wait_started()
+    second = _start_in_background(client)
+
+    builds.finish_one()
+    _joined(first)
+    builds.wait_started()
+    gateway["restart"] = {**gateway["restart"], "restart_pid": RESTART_PID + 1}
+    builds.finish_one()
+    _joined(second)
+
+    # No status read saw the first restart fail before the second replaced it as the newest one;
+    # the second fails too.
+    gateway["failure"] = {"pid": RESTART_PID + 1, "exit_code": 1, "reason": "port 9120 is in use"}
+    assert _progress(client) is None
+
+
+@pytest.mark.parametrize("ending", ["restart failed", "followed as long as the pane waits", "stop", "restart"])
+def test_a_followed_restart_is_no_longer_reported_once_it_cannot_serve_the_start(
+        client, nous, gateway, instant_build, monkeypatch, ending):
+    from hermes_cli.web_routers import webapp_access as routes
+
+    if ending == "followed as long as the pane waits":
+        monkeypatch.setattr(routes, "_RESTART_FOLLOW_SECONDS", 0.0)
+    assert client.post("/api/webapp-access/start", json={"mode": "lan"}).status_code == 200
+
+    if ending == "restart failed":
+        assert _progress(client)["step"] == "restarting"
+        gateway["failure"] = {"pid": RESTART_PID, "exit_code": 1, "reason": "port 9187 is in use"}
+    elif ending in ("stop", "restart"):
+        assert _progress(client)["step"] == "restarting"
+        gateway["restart"] = {**gateway["restart"], "restart_pid": RESTART_PID + 1}
+        assert client.post(f"/api/webapp-access/{ending}").status_code == 200
+
+    assert _progress(client) is None
+
+
+def test_a_refused_restart_ends_the_start_with_its_request(client, nous, gateway, instant_build):
+    gateway["restart"] = {"restart_started": False, "restart_error": "a chat is running", "restart_busy": True}
+
+    response = client.post("/api/webapp-access/start", json={"mode": "lan"})
+
+    assert response.status_code == 200 and response.json()["restart_started"] is False
+    assert response.json()["start_progress"] is None
+    assert _progress(client) is None
+
+
+def test_the_gateway_instance_is_the_process_its_control_socket_answers_from(monkeypatch, tmp_path):
+    import json
+    import os
+
+    from gateway.control_socket import GatewayControlServer
+    from gateway.status import get_process_start_time
+    from hermes_cli import webapp_access, webapp_launcher
+
+    server = GatewayControlServer(tmp_path)
+    monkeypatch.setattr(webapp_launcher, "_control", lambda _home, verb, params=None: json.loads(
+        server.handle_request_line(json.dumps({"protocol": 1, "id": 1, "verb": verb}).encode(), "same-user")))
+    assert webapp_access.gateway_instance() == (os.getpid(), get_process_start_time(os.getpid()))
+
+    def unreachable(_home, _verb, params=None):
+        raise webapp_launcher.GatewayUnreachable("no socket")
+
+    monkeypatch.setattr(webapp_launcher, "_control", unreachable)
+    assert webapp_access.gateway_instance() is None
diff --git a/tests/tools/test_bot_mode_dm_coordination.py b/tests/tools/test_bot_mode_dm_coordination.py
new file mode 100644
index 00000000000..6cf6f55d21c
--- /dev/null
+++ b/tests/tools/test_bot_mode_dm_coordination.py
@@ -0,0 +1,189 @@
+"""``message_agent`` coordination: fan-out with one combined reply, notify-only, cancel, live
+teammate state, and the single reply path (tools/bot_mode_dm.py + tools/bot_mode_dm_coordination.py)."""
+
+import json
+import os
+import shlex
+import sys
+
+from tools import bot_live_delivery as live
+from tools import bot_mode_dm, bot_mode_dm_coordination as coordination
+
+# _fresh_probe_cache is the autouse probe-cache reset; importing it applies it here too.
+from tests.tools.test_bot_mode_dm import (
+    _FakeAgent, _canonical_target, _capture_spawn, _fresh_probe_cache, _managed_home,
+)
+
+
+def _spec(calls):
+    parts = shlex.split(calls[0]["command"])
+    with open(parts[parts.index("--fan-out") + 1], encoding="utf-8-sig") as stream:
+        return json.load(stream)
+
+
+def test_fan_out_spawns_one_runner_for_every_teammate(tmp_path, monkeypatch):
+    home = _managed_home(tmp_path, teammates=("researcher", "scribe"))
+    _canonical_target(monkeypatch, home / "profiles" / "researcher", home / "profiles" / "scribe")
+    calls = _capture_spawn(monkeypatch)
+
+    ack = json.loads(bot_mode_dm.message_agent_tool("researcher, @scribe", "status?", agent=_FakeAgent(home)))
+
+    assert len(calls) == 1 and calls[0]["notify_on_complete"] is True  # one wake, not one per teammate
+    assert [entry["label"] for entry in _spec(calls)] == ["@researcher", "@scribe"]
+    assert [entry["delivery_id"] for entry in _spec(calls)] == [a["delivery_id"] for a in ack["fan_out"]]
+    assert ack["process_id"] == "proc_test1234"
+
+
+def test_fan_out_runner_prints_one_typed_outcome_per_teammate(tmp_path, monkeypatch, capsys):
+    script = tmp_path / "child.py"
+    script.write_text("import sys, time\nmode = sys.argv[1]\n"
+                      "if mode == 'json': print('{\"status\": \"settled\", \"reply\": \"done\", \"target_state\": \"idle\"}')\n"
+                      "elif mode == 'fail': print('Delivery to @x failed [reason: runtime_offline]: gone'); sys.exit(1)\n"
+                      "else: time.sleep(30)\n", encoding="utf-8")
+    entries = [{"command": shlex.join([sys.executable, str(script), mode]), "label": f"@{mode}", "delivery_id": mode,
+                "output": "json" if mode == "json" else "text"} for mode in ("json", "fail", "slow")]
+    spec = tmp_path / "fanout-1.json"
+    spec.write_text(json.dumps(entries), encoding="utf-8")
+    monkeypatch.setattr(coordination, "FAN_OUT_WAIT_SECONDS", 3)
+
+    assert coordination.run_fan_out(str(spec)) == 1
+    out = json.loads(capsys.readouterr().out)
+    by_to = {entry["to"]: entry for entry in out["replies"]}
+    assert by_to["@json"] == {"to": "@json", "delivery_id": "json", "status": "settled", "reply": "done",
+                              "target_state": "idle"}
+    assert by_to["@fail"]["status"] == "failed" and "runtime_offline" in by_to["@fail"]["error"]
+    assert by_to["@slow"]["status"] == "pending"
+    assert (out["settled"], out["of"]) == (1, 3) and not spec.exists()
+
+
+def test_notify_only_never_starts_a_waiter_and_marks_the_message(tmp_path, monkeypatch):
+    home = _managed_home(tmp_path)
+    authority = _canonical_target(monkeypatch, home / "profiles" / "researcher")
+    calls = _capture_spawn(monkeypatch)
+    before = set(os.listdir(bot_mode_dm._dm_dir()))
+
+    ack = json.loads(bot_mode_dm.message_agent_tool("researcher", "FYI: build is green", agent=_FakeAgent(home),
+                                                    expects_reply=False))
+
+    assert calls == [] and ack["expects_reply"] is False and ack["delivery_id"]
+    assert authority.calls[0][1]["message"].endswith("): [no reply needed] FYI: build is green")
+    assert set(os.listdir(bot_mode_dm._dm_dir())) == before  # no payload or intent left for a runner that never runs
+
+
+def test_a_reply_to_the_turns_sender_goes_in_the_final_response(tmp_path, monkeypatch):
+    home = _managed_home(tmp_path)
+    authority = _canonical_target(monkeypatch, home / "profiles" / "researcher")
+    calls = _capture_spawn(monkeypatch)
+    agent = _FakeAgent(home)
+    agent._turn_author = {"id": "bot:researcher", "name": "researcher", "is_bot": True}
+
+    out = json.loads(bot_mode_dm.message_agent_tool("researcher", "here is my answer", agent=agent))
+
+    assert "final response already goes back" in out["error"]
+    assert authority.calls == [] and calls == []
+
+
+def test_cancel_is_the_senders_own_and_reaches_the_owner(tmp_path, monkeypatch):
+    home = _managed_home(tmp_path)
+    target = home / "profiles" / "researcher"
+    _canonical_target(monkeypatch, target)
+    _capture_spawn(monkeypatch)
+    ack = json.loads(bot_mode_dm.message_agent_tool("researcher", "long job", agent=_FakeAgent(home)))
+    with live._locked(target) as root:  # the owner's receipt records who sent it
+        path = root / f"{ack['delivery_id']}.json"
+        record = json.loads(path.read_text(encoding="utf-8-sig"))
+        live._write(path, {**record, "author": {"id": "bot:default", "name": "hermes", "is_bot": True}})
+    rpcs = []
+    monkeypatch.setattr(live, "_authority_rpc", lambda h, method, params: rpcs.append((method, params)) or
+                        {"delivery_id": params["id"], "status": "cancelled", "receipt_status": "cancelled"})
+
+    stranger = _FakeAgent(home)
+    stranger._session_db.db_path = str(target / "state.db")  # @researcher itself asks
+    refused = json.loads(bot_mode_dm.message_agent_tool("researcher", cancel=ack["delivery_id"], agent=stranger))
+    done = json.loads(bot_mode_dm.message_agent_tool("researcher", cancel=ack["delivery_id"], agent=_FakeAgent(home)))
+
+    assert "Only the agent that sent" in refused["error"]
+    assert done["status"] == "cancelled"
+    # By delivery id: the owner picks the admission (or withdraws the pending retry) under its own lock.
+    assert rpcs == [("bot_relay.cancel", {"id": ack["delivery_id"], "author_id": "bot:default", "profile": "researcher"})]
+
+
+def test_ack_reports_a_teammate_parked_on_its_user(tmp_path, monkeypatch):
+    home = _managed_home(tmp_path)
+    authority = _canonical_target(monkeypatch, home / "profiles" / "researcher")
+    plain = authority.__call__
+    monkeypatch.setattr(live, "authority_delivery", lambda h, p: {**plain(h, p), "target_state": "waiting_approval"})
+    _capture_spawn(monkeypatch)
+
+    ack = json.loads(bot_mode_dm.message_agent_tool("researcher", "deploy?", agent=_FakeAgent(home)))
+
+    assert ack["target_state"] == "waiting_approval"
+    assert "waiting for its user to approve" in ack["detail"]
+
+
+def _run_children(tmp_path, monkeypatch, capsys, body: str) -> dict:
+    script = tmp_path / "child.py"
+    script.write_text(body, encoding="utf-8")
+    spec = tmp_path / "fanout-2.json"
+    spec.write_text(json.dumps([{"command": shlex.join([sys.executable, str(script)]), "label": "@peer",
+                                 "delivery_id": "d1", "output": "text"}]), encoding="utf-8")
+    coordination.run_fan_out(str(spec))
+    return json.loads(capsys.readouterr().out)["replies"][0]
+
+
+def test_a_text_reply_that_looks_like_json_stays_the_reply(tmp_path, monkeypatch, capsys):
+    reply = _run_children(tmp_path, monkeypatch, capsys, "print('Reply from @peer:')\nprint('{\"status\": \"x\"}')\n")
+
+    assert reply["status"] == "settled" and reply["reply"].endswith('{"status": "x"}')
+
+
+def test_an_accepted_but_unfinished_peer_request_is_pending_with_its_warning(tmp_path, monkeypatch, capsys):
+    reply = _run_children(tmp_path, monkeypatch, capsys,
+                          "import sys\nprint(\"Peer 'p' accepted the message but its turn is still running. \"\n"
+                          "      \"Do NOT resend.\", file=sys.stderr)\nsys.exit(1)\n")
+
+    assert reply["status"] == "pending" and "accepted the message" in reply["detail"]
+
+
+def test_one_name_for_one_bot_sends_once_and_a_comma_name_resolves_whole(tmp_path, monkeypatch):
+    home = _managed_home(tmp_path, teammates=("researcher", "scribe"))
+    (home / "profiles" / "scribe" / "profile.yaml").write_text("display_name: QA, Release\n", encoding="utf-8")
+    authority = _canonical_target(monkeypatch, home / "profiles" / "researcher", home / "profiles" / "scribe")
+    _capture_spawn(monkeypatch)
+
+    bot_mode_dm.message_agent_tool("researcher, RESEARCHER", "status?", agent=_FakeAgent(home))
+    bot_mode_dm.message_agent_tool("QA, Release", "ship?", agent=_FakeAgent(home))
+
+    assert [target.name for target, _ in authority.calls] == ["researcher", "scribe"]
+
+
+def test_one_targets_setup_failure_keeps_the_others_combined_reply(tmp_path, monkeypatch):
+    home = _managed_home(tmp_path, teammates=("researcher", "scribe"))
+    _canonical_target(monkeypatch, home / "profiles" / "researcher", home / "profiles" / "scribe")
+    calls = _capture_spawn(monkeypatch)
+    dispatch = bot_mode_dm._dispatch
+
+    def flaky(target, *args, **kwargs):
+        if target == "scribe":
+            raise OSError("disk full")
+        return dispatch(target, *args, **kwargs)
+
+    monkeypatch.setattr(bot_mode_dm, "_dispatch", flaky)
+    ack = json.loads(bot_mode_dm.message_agent_tool("researcher, scribe", "status?", agent=_FakeAgent(home)))
+
+    assert [entry["label"] for entry in _spec(calls)] == ["@researcher"]
+    assert "disk full" in ack["fan_out"][1]["error"] and not ack["fan_out"][0].get("error")
+
+
+def test_a_peer_and_a_local_bot_sharing_a_name_are_two_recipients(tmp_path):
+    from types import SimpleNamespace
+
+    from tools import bot_mode_probe as probe
+
+    home = _managed_home(tmp_path, teammates=("qa",), peers=("mini",))
+    (home / "profiles" / "qa" / "profile.yaml").write_text("display_name: Mini\n", encoding="utf-8")
+    sender = SimpleNamespace(root=home, roster_homes=dict(probe._roster(home)), peers=probe._peers(home))
+
+    # 'mini' goes to the peer (dispatch checks peers first); 'qa' is the local bot named Mini.
+    assert coordination.split_targets("mini, qa", sender) == ["mini", "qa"]
+    assert coordination.split_targets("qa, Mini, mini/default", sender) == ["qa", "Mini", "mini/default"]
