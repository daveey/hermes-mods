diff --git a/tests/tools/test_checkpoint_scan_store_exclusion.py b/tests/tools/test_checkpoint_scan_store_exclusion.py
new file mode 100644
index 00000000000..95c41d25ece
--- /dev/null
+++ b/tests/tools/test_checkpoint_scan_store_exclusion.py
@@ -0,0 +1,140 @@
+"""The staging scan and budget estimate see only what ``git add -A`` stages.
+
+With HERMES_HOME as the working directory the checkpoint store sits inside the tree. The add
+excludes it by pathspec, but a scan (and ``ls-files -o -m`` narrowing) that still counted the
+store priced its own packfiles: as the store grew, HERMES_HOME checkpoints were skipped and
+backed off for an hour. Default-excluded trees (``node_modules/``) are pruned the same way,
+while tracked or re-included files in them stay size-capped.
+"""
+import os
+import subprocess
+
+import pytest
+
+from tools import checkpoint_manager as cm
+from tools import checkpoint_staging as staging
+
+_STORE_JUNK = 30
+_JUNK_BYTES = 900 * 1024  # 30 x 0.9 MB ~= 26 MB, the reproduced false estimate
+
+
+@pytest.fixture()
+def home(tmp_path, monkeypatch):
+    home = tmp_path / "hermes-home"
+    home.mkdir()
+    (home / "config.yaml").write_text("checkpoints:\n  enabled: true\n")
+    (home / "notes.md").write_text("one\n")
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(cm, "CHECKPOINT_BASE", home / "checkpoints")
+    monkeypatch.setattr(
+        cm, "selected_git_env", lambda base=None: dict(base if base is not None else os.environ),
+    )
+    # Simulated slow host: 26 MB costs ~52 s, over the 30 s budget; the real tree is ~instant.
+    monkeypatch.setattr(staging, "ADD_BYTES_PER_SECOND", 512 * 1024)
+    monkeypatch.setattr(staging, "load_factor", lambda: 1.0)
+    monkeypatch.setattr(staging, "_slow_dirs", {})
+    return home
+
+
+def _grow_store(store):
+    junk = store / "objects" / "pack"
+    junk.mkdir(parents=True, exist_ok=True)
+    for i in range(_STORE_JUNK):
+        (junk / f"junk-{i}.bin").write_bytes(os.urandom(_JUNK_BYTES))
+
+
+def test_growing_own_store_does_not_skip_hermes_home_checkpoints(home):
+    mgr = cm.CheckpointManager(enabled=True)
+    store = cm._store_path()
+    assert cm._init_store(store, str(home)) is None
+    _grow_store(store)
+
+    scan = cm._staging_scan(str(home), 0)
+    assert not [p for p in scan.files if p.startswith("checkpoints/")]
+    assert staging.estimate(scan, None).seconds < staging.budget_s(cm._GIT_TIMEOUT * 2)
+
+    assert mgr.ensure_checkpoint(str(home)), "first HERMES_HOME checkpoint skipped"
+    assert staging.slow_remaining_s(store, str(home)) == 0
+
+    # Warm turn: the store's files are fresher than the index; still not priced.
+    _grow_store(store)
+    (home / "notes.md").write_text("two\n")
+    mgr.new_turn()
+    assert mgr.ensure_checkpoint(str(home)), "warm HERMES_HOME checkpoint skipped"
+    assert staging.slow_remaining_s(store, str(home)) == 0
+
+
+def test_ls_files_narrowing_excludes_the_store(home):
+    """Even a scan that counted the store must be narrowed by a store-excluding listing."""
+    mgr = cm.CheckpointManager(enabled=True)
+    store = cm._store_path()
+    assert cm._init_store(store, str(home)) is None
+    _grow_store(store)
+    index_file = cm._index_path(store, cm._project_hash(str(home)))
+    index_file.parent.mkdir(parents=True, exist_ok=True)
+    unpruned = staging.scan_tree(str(home), 0, 10**9)  # no store skip: the old scan
+    assert staging.estimate(unpruned, None).seconds > staging.budget_s(cm._GIT_TIMEOUT * 2)
+    assert mgr._over_staging_budget(store, str(home), index_file, unpruned, None) is None
+
+
+def test_default_excludes_are_pruned_not_walked(tmp_path, monkeypatch):
+    work = tmp_path / "proj"
+    (work / "node_modules" / "pkg").mkdir(parents=True)
+    (work / ".venv" / "lib").mkdir(parents=True)
+    for i in range(50):
+        (work / "node_modules" / "pkg" / f"f{i}.js").write_text("x")
+        (work / ".venv" / "lib" / f"m{i}.py").write_text("x")
+    (work / "app.log").write_text("x")
+    (work / "main.py").write_text("x")
+    walked = []
+    real_walk = os.walk
+
+    def spy(*a, **kw):
+        for entry in real_walk(*a, **kw):
+            walked.append(entry[0])
+            yield entry
+
+    monkeypatch.setattr(staging.os, "walk", spy)
+    monkeypatch.setattr(cm, "CHECKPOINT_BASE", tmp_path / "ckpt")
+    scan = cm._staging_scan(str(work), 0)
+    assert set(scan.files) == {"main.py"}
+    assert not [d for d in walked if "node_modules" in d or ".venv" in d]
+    assert scan.count == 1
+
+
+def test_reincluded_and_tracked_oversize_files_in_pruned_dirs_stay_capped(tmp_path, monkeypatch):
+    monkeypatch.setattr(cm, "CHECKPOINT_BASE", tmp_path / "ckpt")
+    monkeypatch.setattr(
+        cm, "selected_git_env", lambda base=None: dict(base if base is not None else os.environ),
+    )
+    cap = 1024
+    work = tmp_path / "proj"
+    (work / "build").mkdir(parents=True)
+    (work / "dist").mkdir()
+    (work / "build" / "big.bin").write_bytes(b"b" * (cap + 1))
+    (work / "dist" / "big.bin").write_bytes(b"d" * (cap + 1))
+    (work / "main.py").write_text("x")
+
+    # A tracked path in a pruned dir: add -A re-reads it, so it must be capped.
+    store = cm._store_path()
+    assert cm._init_store(store, str(work)) is None
+    index_file = cm._index_path(store, cm._project_hash(str(work)))
+    index_file.parent.mkdir(parents=True, exist_ok=True)
+    ok, _, err = cm._run_git(
+        ["update-index", "--add", "--cacheinfo", "100644,e69de29bb2d1d6434b8b29ae775ad8c2e48c5391,build/big.bin"],
+        store, str(work), index_file=index_file,
+    )
+    assert ok, err
+    scan = cm._staging_scan(str(work), cap, store, index_file)
+    assert "build/big.bin" in scan.oversize
+    assert "dist/big.bin" not in scan.oversize  # untracked + excluded: git never reads it
+
+    # A .gitignore re-include: git may stage the excluded name, so it is walked.
+    (work / ".gitignore").write_text("!dist/\n")
+    scan = cm._staging_scan(str(work), cap)
+    assert "dist/big.bin" in scan.oversize
+    out = subprocess.run(
+        ["git", f"--git-dir={store}", f"--work-tree={work}", "ls-files", "-o", "--exclude-standard"],
+        capture_output=True, text=True, check=True, env={**os.environ, "GIT_INDEX_FILE": str(tmp_path / "idx")},
+    ).stdout.split()
+    assert "dist/big.bin" in out  # the re-include really is honoured by git
diff --git a/tests/tools/test_checkpoint_size_reinclude.py b/tests/tools/test_checkpoint_size_reinclude.py
new file mode 100644
index 00000000000..23876a36620
--- /dev/null
+++ b/tests/tools/test_checkpoint_size_reinclude.py
@@ -0,0 +1,55 @@
+"""Oversize files a project .gitignore re-includes never reach git add's clean filter."""
+from __future__ import annotations
+
+import pytest
+
+from tools import checkpoint_staging as staging
+from tools.checkpoint_manager import (
+    CheckpointManager, _init_store, _project_hash, _ref_name, _run_git, _store_path,
+)
+
+
+@pytest.mark.parametrize("name", ["weights.bin", "we[i]ghts *.bin", " lead\\trail .bin", ":(top)colon.bin"])
+def test_max_file_size_mb_reincluded_by_gitignore_never_runs_clean_filter(tmp_path, monkeypatch, name):
+    """A project ``!`` re-include beats core.excludesFile; the literal pathspec still holds."""
+    checkpoint_base = tmp_path / "checkpoints"
+    monkeypatch.setattr("tools.checkpoint_manager.CHECKPOINT_BASE", checkpoint_base)
+    wd = tmp_path / "proj"
+    wd.mkdir()
+    (wd / "small.py").write_text("tiny\n")
+    (wd / name).write_bytes(b"\0" * (2 * 1024 * 1024))  # 2 MB
+    # An oversize file the project ignores: an exclude pathspec naming it would fail git add.
+    (wd / "ignored.bin").write_bytes(b"\0" * (2 * 1024 * 1024))
+    escaped = staging.gitignore_literal(name)
+    (wd / ".gitignore").write_text(f"*.bin\n!{escaped}\n")
+    (wd / ".gitattributes").write_text("* filter=must-not-run\n*.py -filter\n.git* -filter\n")
+
+    store = _store_path(checkpoint_base)
+    assert _init_store(store, str(wd)) is None
+    assert _run_git(
+        ["config", "filter.must-not-run.clean", "hermes-filter-must-not-run"],
+        store, str(wd),
+    )[0]
+    assert _run_git(
+        ["config", "filter.must-not-run.required", "true"],
+        store, str(wd),
+    )[0]
+    # The re-include defeats the excludes file alone: git would open the file.
+    ok, ignored, _ = _run_git(
+        ["ls-files", "-z", "--others", "--ignored", "--exclude-standard"], store, str(wd),
+    )
+    assert ok and name not in ignored.split("\x00")
+    assert "ignored.bin" in ignored.split("\x00")
+
+    m = CheckpointManager(enabled=True, max_snapshots=5, max_file_size_mb=1)
+    assert m.ensure_checkpoint(str(wd), "initial") is True
+
+    ok, files, _ = _run_git(
+        ["ls-tree", "-r", "-z", "--name-only", _ref_name(_project_hash(str(wd)))],
+        store, str(wd),
+    )
+    assert ok
+    names = set(files.split("\x00"))
+    assert "small.py" in names
+    assert name not in names
+    assert "ignored.bin" not in names
diff --git a/tests/tools/test_checkpoint_staging_scan.py b/tests/tools/test_checkpoint_staging_scan.py
new file mode 100644
index 00000000000..0ebc66f0fcf
--- /dev/null
+++ b/tests/tools/test_checkpoint_staging_scan.py
@@ -0,0 +1,64 @@
+"""An excluded tree can exhaust the raw walk without exhausting the project guard.
+
+The size cap must still exclude later large files BEFORE git add, not merely
+remove their index entries after git has already read/compressed their contents.
+"""
+import hashlib
+import os
+
+from tools import checkpoint_manager as cm
+from tools import checkpoint_staging as staging
+
+
+def test_excluded_tree_does_not_hide_later_oversize_file(tmp_path, monkeypatch):
+    monkeypatch.setattr(cm, 'CHECKPOINT_BASE', tmp_path / 'checkpoints')
+    monkeypatch.setattr(cm, '_MAX_FILES', 8)
+    work = tmp_path / 'project'
+    build = work / 'build'
+    later = work / 'src'
+    build.mkdir(parents=True)
+    later.mkdir()
+    for i in range(12):
+        (build / f'ignored-{i}').write_text('excluded build product')
+    (later / 'small.py').write_text('keep = True\n')
+    data = b'x' * (1024 * 1024 + 1)
+    (later / 'large.bin').write_bytes(data)
+
+    # os.walk order is filesystem-dependent: put the real excluded directory
+    # before src, without substituting either tree or scan's file/stat results.
+    walk = os.walk
+
+    def ordered_walk(*args, **kwargs):
+        for root, dirs, files in walk(*args, **kwargs):
+            dirs.sort()
+            yield root, dirs, files
+
+    monkeypatch.setattr(staging.os, 'walk', ordered_walk)
+    assert cm._dir_file_count(str(work)) <= cm._MAX_FILES
+    bounded = staging.scan_tree(str(work), len(data) - 1, cm._MAX_FILES)
+    assert bounded.count > cm._MAX_FILES
+    assert 'src/large.bin' not in bounded.oversize  # regression precondition
+    complete = cm._staging_scan(str(work), len(data) - 1)
+    assert 'src/large.bin' in complete.oversize
+    assert 'src/small.py' in complete.files
+
+    manager = cm.CheckpointManager(enabled=True, max_file_size_mb=1)
+    assert manager.ensure_checkpoint(str(work))
+    target = manager.list_checkpoints(str(work))[0]['hash']
+    store = cm._store_path()
+    ok, paths, error = cm._run_git(['ls-tree', '-r', '--name-only', target], store, str(work))
+    assert ok, error
+    assert paths.splitlines() == ['src/small.py']
+    # A post-add index cleanup could produce the same tree while still storing
+    # the huge blob. Its absence proves git never hashed it into this fresh store.
+    oid = hashlib.sha1(f'blob {len(data)}\0'.encode() + data).hexdigest()
+    exists, _, _ = cm._run_git(['cat-file', '-e', oid], store, str(work), allowed_returncodes={1})
+    assert not exists
+
+    (later / 'small.py').write_text('keep = False\n')
+    manager.record_agent_write(str(later / 'small.py'))
+    plan = manager._safe_restore_plan(str(work), target)
+    assert plan['success'], plan
+    assert 'src/small.py' in plan['restore']
+    exists, _, _ = cm._run_git(['cat-file', '-e', oid], store, str(work), allowed_returncodes={1})
+    assert not exists
diff --git a/tests/tui_gateway/test_config_set_managed_keys.py b/tests/tui_gateway/test_config_set_managed_keys.py
new file mode 100644
index 00000000000..223a7cd79b8
--- /dev/null
+++ b/tests/tui_gateway/test_config_set_managed_keys.py
@@ -0,0 +1,139 @@
+"""``config.set`` refuses a key the administrator's managed scope pins, like ``hermes config set``.
+
+Before, both TUI paths wrote the pinned key and answered success while the managed value kept
+winning on every read. A managed scope that pins something else must not block other keys.
+"""
+from types import SimpleNamespace
+
+import pytest
+import hermes_yaml as yaml
+
+from hermes_cli import managed_scope
+from tui_gateway import server
+
+
+@pytest.fixture
+def homes(tmp_path, monkeypatch):
+    from hermes_cli import managed_scope
+    home, managed = tmp_path / "home", tmp_path / "managed"
+    home.mkdir()
+    managed.mkdir()
+    (managed / "config.yaml").write_text("display:\n  skin: corp\n  sections:\n    tools: collapsed\n"
+                                         "custom_prompt: policy\nmodel:\n  default: acme/pinned\n")
+    (home / "config.yaml").write_text("display:\n  tui_theme: dark\n")
+    monkeypatch.setenv("HERMES_MANAGED_DIR", str(managed))
+    monkeypatch.setattr(server, "_hermes_home", home)
+    managed_scope.invalidate_managed_cache()
+    server._cfg_cache = server._cfg_sig = server._cfg_path = None
+    yield home
+    managed_scope.invalidate_managed_cache()
+    server._cfg_cache = server._cfg_sig = server._cfg_path = None
+
+
+def _set(**params):
+    return server._methods["config.set"](1, params)
+
+
+@pytest.mark.parametrize(("key", "value", "pinned"), [
+    ("skin", "mono", "display.skin"),  # one-key funnel (_write_config_keys)
+    ("details_mode", "expanded", "display.sections.tools"),  # fan-out to every section leaf
+    ("prompt", "mine", "custom_prompt"),  # its own raw save
+])
+def test_tui_config_set_refuses_a_managed_key_and_writes_nothing(homes, key, value, pinned):
+    before = (homes / "config.yaml").read_text()
+    answer = _set(key=key, value=value)
+    assert answer["error"]["code"] == 4030, answer
+    assert pinned in answer["error"]["message"] and "managed by your administrator" in answer["error"]["message"]
+    assert (homes / "config.yaml").read_text() == before
+
+
+_DEFINITE = [
+    ("other/model --global", "model.default", None),
+    ("other/model --global --reasoning high", "agent.reasoning_effort", "agent:\n  reasoning_effort: low\n"),
+    ("other/model --global", "model.api_mode", "model:\n  api_mode: codex_responses\n"),  # always set or cleared
+]
+_CLEARED = ("other/model --global", "model.context_length", "model:\n  context_length: 8192\n")  # route changed
+
+
+@pytest.mark.parametrize(("running", "pick", "pinned", "managed"), [
+    *((running, *row) for running in (True, False) for row in _DEFINITE), (False, *_CLEARED)])
+def test_tui_persisting_model_pick_is_refused_before_anything_changes(homes, monkeypatch, running, pick, pinned, managed):
+    """Refused before the live switch, the model persist or the mid-turn queue, not after a partial success."""
+    from hermes_cli.model_switch import ModelSwitchResult
+    if managed:
+        (homes.parent / "managed" / "config.yaml").write_text(managed)
+        managed_scope.invalidate_managed_cache()
+    (homes / "config.yaml").write_text("model:\n  default: old/model\n  provider: nous\n  context_length: 4096\n")
+    monkeypatch.setenv("HERMES_HOME", str(homes))
+    monkeypatch.setattr("hermes_cli.model_switch.switch_model", lambda **kw: ModelSwitchResult(
+        success=True, new_model="other/model", target_provider="openrouter", is_global=True))
+    agent = SimpleNamespace(model="old/model", provider="nous", reasoning_config=None)  # no switch_model: never swapped
+    server._sessions["managed-pick"] = session = {"session_key": "managed-pick", "agent": agent, "running": running}
+    before = (homes / "config.yaml").read_text()
+    try:
+        answer = _set(key="model", value=pick, session_id="managed-pick")
+    finally:
+        server._sessions.pop("managed-pick", None)
+    assert answer["error"]["code"] == 4030, answer
+    assert pinned in answer["error"]["message"]
+    assert session == {"session_key": "managed-pick", "agent": agent, "running": running}  # nothing queued
+    assert vars(agent) == {"model": "old/model", "provider": "nous", "reasoning_config": None}
+    assert (homes / "config.yaml").read_text() == before
+
+
+def test_tui_config_set_still_writes_a_key_the_scope_does_not_pin(homes):
+    assert _set(key="theme", value="light")["result"] == {"key": "theme", "value": "light"}
+    assert yaml.safe_load((homes / "config.yaml").read_text())["display"]["tui_theme"] == "light"
+
+
+def _queue_then_apply(homes, monkeypatch, raw_model, pick, resolved):
+    """Queue ``pick`` on a busy session (live agent on another model), then apply it at turn start."""
+    from hermes_cli.model_switch import ModelSwitchResult
+    (homes.parent / "managed" / "config.yaml").write_text("model:\n  context_length: 8192\n")
+    managed_scope.invalidate_managed_cache()
+    (homes / "config.yaml").write_text(raw_model)
+    monkeypatch.setenv("HERMES_HOME", str(homes))
+    monkeypatch.setattr("hermes_cli.model_switch.switch_model", lambda **kw: ModelSwitchResult(
+        success=True, is_global=True, **resolved))
+    swaps, notices = [], []
+    for name in ("_restart_slash_worker", "_persist_live_session_runtime", "_persist_live_session_system_prompt",
+                 "_append_model_switch_marker", "_emit_session_info", "_merge_preflight_warning"):
+        monkeypatch.setattr(server, name, lambda *a, **kw: None)
+    monkeypatch.setattr(server, "_emit", lambda event, sid, payload=None: notices.append((event, payload)))
+    agent = SimpleNamespace(model="live/model", provider="nous", base_url="", api_key="", reasoning_config=None,
+                            switch_model=lambda **kw: swaps.append(kw))
+    server._sessions["queued-pick"] = session = {"session_key": "queued-pick", "agent": agent, "running": True}
+    try:
+        answer = _set(key="model", value=pick, session_id="queued-pick", confirm_expensive_model=True)
+        session["running"] = False
+        server._apply_pending_model_switch("queued-pick", session)
+    finally:
+        server._sessions.pop("queued-pick", None)
+    return answer, session, swaps, notices
+
+
