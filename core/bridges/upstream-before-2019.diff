+        if _prune_would_have_run(compressor, current_tokens):
+            _record_checkpoint_gate_suppression(agent, "the proactive tool-result prune")
+        return messages
+    prune = getattr(compressor, "prune_tool_results_only", None)
+    if not callable(prune):
