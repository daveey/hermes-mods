+        directory_patterns = tuple(
+            pattern[:-1] for pattern in DEFAULT_EXCLUDES if pattern.endswith("/")
+        )
+        file_patterns = tuple(
+            pattern for pattern in DEFAULT_EXCLUDES if not pattern.endswith("/")
+        )
