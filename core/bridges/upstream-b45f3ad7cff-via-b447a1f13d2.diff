diff --git a/tests/hermes_cli/test_web_profile_create_serves_now.py b/tests/hermes_cli/test_web_profile_create_serves_now.py
new file mode 100644
index 0000000000..b24d687c27
--- /dev/null
+++ b/tests/hermes_cli/test_web_profile_create_serves_now.py
@@ -0,0 +1,52 @@
+"""A profile created through ``POST /api/profiles`` is served by the live multiplexer right away.
+
+Creation asks the multiplexer to rescan over its control socket. On the gateway's own listener (the
+Webapp) that socket answers on the loop serving the route, so a create run on the loop waited out the
+socket's timeout instead, the multiplexer only served the profile at its periodic rescan, and the
+Webapp refused to switch to it ("This gateway does not serve profile ...") until then.
+"""
+import asyncio
+
+import pytest
+
+
+@pytest.fixture
+def client(monkeypatch, _isolate_hermes_home):
+    from starlette.testclient import TestClient
+
+    import hermes_state
+    from hermes_constants import get_hermes_home
+    from hermes_cli import profiles
+    from hermes_cli.web_server import _SESSION_HEADER_NAME, _SESSION_TOKEN, app
+
+    home = get_hermes_home()
+    home.mkdir(parents=True, exist_ok=True)
+    (home / "config.yaml").write_text("{}\n", encoding="utf-8")
+    monkeypatch.setattr(profiles, "_get_default_hermes_home", lambda: home)
+    monkeypatch.setattr(profiles, "_get_profiles_root", lambda: home / "profiles")
+    monkeypatch.setattr(hermes_state, "DEFAULT_DB_PATH", home / "state.db")
+    c = TestClient(app)
+    c.headers[_SESSION_HEADER_NAME] = _SESSION_TOKEN
+    return c
+
+
+def test_a_created_profile_is_served_without_waiting_for_the_rescan(client, monkeypatch):
+    from hermes_cli import gateway_multiplex_served
+
+    served = []
+
+    def multiplexer(name, **_kwargs):
+        # The control socket answers on the route's loop: called from that loop, it never does.
+        try:
+            asyncio.get_running_loop()
+        except RuntimeError:
+            served.append(name)
+            return ["default", name]
+        return None
+
+    monkeypatch.setattr(gateway_multiplex_served, "notify_multiplexer_profiles_changed", multiplexer)
+
+    response = client.post("/api/profiles", json={"name": "testing-profile", "no_skills": True})
+
+    assert response.status_code == 200, response.text
+    assert served == ["testing-profile"]
diff --git a/tests/hermes_cli/test_webapp_voice_relay.py b/tests/hermes_cli/test_webapp_voice_relay.py
new file mode 100644
index 0000000000..ccd9eac40a
--- /dev/null
+++ b/tests/hermes_cli/test_webapp_voice_relay.py
@@ -0,0 +1,67 @@
+"""The Webapp relays voice instead of handing its tab provider keys.
+
+``/api/audio/voice-config`` lets native Desktop call STT/TTS providers itself. A browser tab cannot:
+a provider without CORS (the Nous tool gateway Hermes Cloud routes speech through) refuses the
+tab's fetch, so dictation failed with "Failed to fetch", and the response put the keys in the page.
+On the Webapp surface both directions resolve to relay, with no key in the body; native surfaces
+keep client-direct.
+"""
+import importlib
+import sys
+from pathlib import Path
+
+import pytest
+import hermes_yaml as yaml
+from starlette.testclient import TestClient
+
+_TOKEN = "a" * 43
+_KEY = "gsk_voice_relay_test"
+
+
+@pytest.fixture
+def voice_config(tmp_path, monkeypatch):
+    """GET /api/audio/voice-config on ``web_server.app`` serving *surface*, for a profile whose STT
+    resolves client-direct (Groq, with its key)."""
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    (home / "config.yaml").write_text(
+        yaml.safe_dump({"stt": {"provider": "groq"}}), encoding="utf-8")
+    monkeypatch.setenv("GROQ_API_KEY", _KEY)
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    for name in ("hermes_cli.config", "tools.transcription_tools", "tools.tts_tool",
+                 "tools.voice_client_config"):
+        if name in sys.modules:
+            importlib.reload(sys.modules[name])
+
+    from hermes_cli import web_server
+
+    monkeypatch.setattr(web_server.app.state, "bound_host", "localhost", raising=False)
+    monkeypatch.setattr(web_server.app.state, "auth_required", False, raising=False)
+    monkeypatch.setattr(web_server, "_SESSION_TOKEN", _TOKEN)
+    client = TestClient(web_server.app, base_url="http://localhost")
+
+    def get(surface):
+        monkeypatch.setattr(web_server.app.state, "ui_surface", surface, raising=False)
+        response = client.get("/api/audio/voice-config", headers={"X-Hermes-Session-Token": _TOKEN})
+        assert response.status_code == 200, response.text
+        return response
+
+    return get
+
+
+def test_the_webapp_relays_voice_and_its_tab_gets_no_key(voice_config):
+    response = voice_config("webapp")
+
+    body = response.json()
+    assert body["stt"]["mode"] == "relay"
+    assert body["tts"]["mode"] == "relay"
+    assert _KEY not in response.text
+
+
+def test_native_desktop_still_calls_the_provider_directly(voice_config):
+    stt = voice_config("dashboard").json()["stt"]
+
+    assert stt["mode"] == "direct"
+    assert stt["api_key"] == _KEY
