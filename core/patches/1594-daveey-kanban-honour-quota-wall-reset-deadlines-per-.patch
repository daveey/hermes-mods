+    # Pool refusals carry ``resets at <epoch>`` (SubscriptionQuotaUnavailable's text).
+    epoch = re.search(r'resets?\s+at\s+(\d{9,11}(?:\.\d+)?)(?![\d:])', text, re.IGNORECASE)
+    if epoch:
