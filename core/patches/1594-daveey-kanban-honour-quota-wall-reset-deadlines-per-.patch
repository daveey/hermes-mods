+    cfg = {} if profile else {'default_model': 'class:standard', 'strong_model': 'claude-opus-5-5',
+                              'strong_provider': 'anthropic', 'default_model_keep_patterns': ['security']}
+    monkeypatch.setattr(tier, 'load_tier_config', lambda: cfg)
