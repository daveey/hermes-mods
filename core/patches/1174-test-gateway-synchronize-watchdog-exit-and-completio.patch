From 11834422cde34e95050b947f9ceff580effe0e26 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 08:13:22 +0000
Subject: [PATCH] test(gateway): synchronize watchdog exit and completion
 replay checks [daveey]

---
 .../fixtures/operator_cross_surface_peer.py        | 14 ++++++++++----
 tests/gateway/test_loop_liveness_watchdog.py       | 14 ++++++++++++++
 tests/tools/test_finite_delegation_outcomes.py     |  4 +++-
 3 files changed, 27 insertions(+), 5 deletions(-)

diff --git a/tests/gateway/fixtures/operator_cross_surface_peer.py b/tests/gateway/fixtures/operator_cross_surface_peer.py
index 1f5c883e93b..2c43201cbb4 100644
--- a/tests/gateway/fixtures/operator_cross_surface_peer.py
+++ b/tests/gateway/fixtures/operator_cross_surface_peer.py
@@ -165,10 +165,16 @@ async def probe(peer, creator):
                        for request in peer.requests]
             assert systems[0] == systems[1], 'operator handoff changed frozen system policy'
             assert 'local_operator_v1' not in json.dumps(peer.requests)
-            replay = await rpc(viewer, 'session.events.since', session_id=sid,
-                               replay_epoch=initial['replay_epoch'], last_sequence=initial['last_sequence'])
-            assert not replay['snapshot_required'], replay
-            assert len([event for event in replay['events'] if event['type'] == 'message.complete']) == 2
+            # Admission terminality precedes event publication; observe the contract we assert.
+            async with asyncio.timeout(45):
+                while True:
+                    replay = await rpc(viewer, 'session.events.since', session_id=sid,
+                                       replay_epoch=initial['replay_epoch'], last_sequence=initial['last_sequence'])
+                    assert not replay['snapshot_required'], replay
+                    completed = [event for event in replay['events'] if event['type'] == 'message.complete']
+                    if len(completed) == 2:
+                        break
+                    assert len(completed) < 2, replay
             snapshot = await rpc(viewer, 'session.resume', session_id=sid)
             assert snapshot['stored_session_id'] == sid
             assert 'LOCAL_ACK_WS_SHARED' in json.dumps(snapshot['messages'])
diff --git a/tests/gateway/test_loop_liveness_watchdog.py b/tests/gateway/test_loop_liveness_watchdog.py
index 5de4d82df81..5c9ab0f73f0 100644
--- a/tests/gateway/test_loop_liveness_watchdog.py
+++ b/tests/gateway/test_loop_liveness_watchdog.py
@@ -289,9 +289,15 @@ def test_loop_liveness_watchdog_marks_runtime_degraded_before_restart():
     write_runtime_status(gateway_state="running", exit_reason=None)
     loop = MagicMock(spec=asyncio.AbstractEventLoop)
     fired = threading.Event()
+    handle_ready = threading.Event()
     exit_codes = []
 
     def fake_exit(code: int) -> None:
+        assert handle_ready.wait(timeout=5.0)
+        # Real os._exit never returns. Disarm before returning from its test double,
+        # not later in the waiting test thread (which may be descheduled).
+        assert handle is not None
+        handle.stop()
         exit_codes.append(code)
         fired.set()
 
@@ -303,6 +309,7 @@ def test_loop_liveness_watchdog_marks_runtime_degraded_before_restart():
             loop, probe_interval=0.01, probe_timeout=0.01, max_strikes=2
         )
         assert handle is not None
+        handle_ready.set()
         # Returns as soon as the exit is reached. Must outlast the pre-exit
         # status persist, which itself waits out a throttled writer.
         assert fired.wait(timeout=30.0), "watchdog did not reach its restart exit"
@@ -336,9 +343,15 @@ def test_loop_liveness_watchdog_status_stamp_survives_a_slow_persist(monkeypatch
     status.write_runtime_status(gateway_state="running", exit_reason=None)
     loop = MagicMock(spec=asyncio.AbstractEventLoop)
     fired = threading.Event()
+    handle_ready = threading.Event()
     exit_codes = []
 
     def fake_exit(code: int) -> None:
+        assert handle_ready.wait(timeout=5.0)
+        # Real os._exit never returns. Disarm before returning from its test double,
+        # not later in the waiting test thread (which may be descheduled).
+        assert handle is not None
+        handle.stop()
         exit_codes.append(code)
         fired.set()
 
@@ -350,6 +363,7 @@ def test_loop_liveness_watchdog_status_stamp_survives_a_slow_persist(monkeypatch
             loop, probe_interval=0.01, probe_timeout=0.01, max_strikes=2
         )
         assert handle is not None
+        handle_ready.set()
         assert fired.wait(timeout=30.0), "watchdog did not reach its restart exit"
         handle.stop()
         handle.join(timeout=5.0)
diff --git a/tests/tools/test_finite_delegation_outcomes.py b/tests/tools/test_finite_delegation_outcomes.py
index 25e9ae843d0..a5b18294ee4 100644
--- a/tests/tools/test_finite_delegation_outcomes.py
+++ b/tests/tools/test_finite_delegation_outcomes.py
@@ -52,7 +52,9 @@ class _Child:
             if self.outcome == "slow":
                 assert self.interrupted.wait(5), "child never received stop"
                 self.unwinding.set()
-                assert self.allow_finish.wait(5), "child teardown was not released"
+                # Keep teardown bounded, but outlast a throttled parent's observation.
+                # The fixture also releases this gate on assertion failure.
+                assert self.allow_finish.wait(60), "child teardown was not released"
                 return {"final_response": "partial", "completed": False,
                         "interrupted": True, "api_calls": 1, "messages": []}
             if self.outcome == "error":
