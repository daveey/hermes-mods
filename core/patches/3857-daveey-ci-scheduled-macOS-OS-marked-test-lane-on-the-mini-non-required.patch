--- /dev/null
+++ b/.github/workflows/macos-os-tests.yml
@@ -0,0 +1,103 @@
+name: macOS OS-marked tests (scheduled)
+
+# Runs the platforms("macos") / platforms("posix") tests on a real macOS host,
+# on a schedule, against main. CI's tests-os lane (tests-os.yml) is off in this
+# fork (ci.yaml `if: false`: no GitHub-hosted macOS/Windows runner), so without
+# this nothing outside tests/hermes_state/ and the six Native memory paths ever
+# ran those tests on Darwin. Decision: kanban t_01a1d5b9382b24ad, option B
+# (scheduled, non-required; not a PR lane).
+#
+# Runner: the Mac mini's self-hosted runner (labels self-hosted, macOS,
+# hermes-state), the same one that serves the REQUIRED hermes_state (macOS)
+# and Native memory PR lanes and is already saturated by them. So this lane:
+#   * never runs on a pull request and is not part of "All required checks
+#     pass (v2)";
+#   * runs twice a day, 00:37 and 12:37 UTC (00-01 UTC had the fewest PR runs
+#     on 2026-11-11/12; agent PRs land around the clock, so the gate below,
+#     not the hour, is what keeps it out of the way);
+#   * yields: a `gate` job on Linux skips the slot when any job for the mini's
+#     label is already waiting for a runner (scripts/ci/macos_os_tests_gate.py);
+#     the next slot tries again. A manual dispatch is never gated;
+#   * runs at utility QoS with 2 workers, like the hermes_state lane.
+# A skipped slot leaves the run green with the test job skipped.
+#
+# Alerting: a red run is read by the hub's main-CI watcher (hermes-state
+# hosts/hermes-hub/ci-watch/ci_main_watch.py, SCHEDULED), which opens one ci-red
+# Kanban fix card per red streak. Renaming or moving this file needs that
+# SCHEDULED entry updated too.
+#
+# Probe the lane before merging a change to it by pushing a
+# `macos-os-probe/**` branch (deliberately not ci-probe/**, which also starts
+# the hermes_state lane on the same runner).
+
+on:
+  schedule:
+    - cron: '37 0,12 * * *'
+  workflow_dispatch:
+  push:
+    branches: ['macos-os-probe/**']
+
+permissions:
+  contents: read
+
+concurrency:
+  # One run at a time; a newer slot waits rather than cancelling a running one.
+  group: macos-os-tests-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  gate:
+    name: Yield to waiting mini jobs
+    runs-on: blacksmith-4vcpu-ubuntu-2404
+    timeout-minutes: 10
+    permissions:
+      actions: read
+      contents: read
+    outputs:
+      run: ${{ steps.gate.outputs.run }}
+    steps:
+      - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          persist-credentials: false
+          sparse-checkout: scripts/ci/macos_os_tests_gate.py
+          sparse-checkout-cone-mode: false
+      - name: Check the mini's queue
+        id: gate
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: python3 scripts/ci/macos_os_tests_gate.py
+
+  macos-os-tests:
+    name: macOS-only tests (mini)
+    needs: gate
+    if: needs.gate.outputs.run == 'true' && github.repository == 'example-org/hermes'
+    runs-on: [self-hosted, macOS, hermes-state]
+    # ~590 files at 2 workers on a shared host, plus cold environment provisioning.
+    timeout-minutes: 150
+    steps:
+      - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          fetch-depth: 1
+
+      - name: Run macOS-marked tests
+        # Same selection as tests-os.yml's macOS row: the helper narrows which
+        # files are imported; `-m "platforms and not integration"` decides which
+        # tests run (conftest skips foreign-OS specs). run_tests.sh fails the
+        # run when nothing was collected, so an empty selection is never green.
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 -c "import sys; assert sys.platform == 'darwin'"
+          HERMES_HOME="$(mktemp -d "${RUNNER_TEMP:-/tmp}/macos-os-home.XXXXXX")"
+          export HERMES_HOME
+          LIST="$(mktemp "${RUNNER_TEMP:-/tmp}/macos-os-files.XXXXXX")"
+          trap 'rm -rf "$HERMES_HOME" "$LIST"' EXIT
+          /usr/bin/python3 scripts/ci/list_os_marked_tests.py macos > "$LIST"
+          test -s "$LIST"
+          echo "selected $(wc -l < "$LIST" | tr -d ' ') file(s)"
+          taskpolicy -c utility scripts/run_tests.sh --files-from "$LIST" -j 2 -- \
+            -m "platforms and not integration" --tb=short
+        env:
+          OPENROUTER_API_KEY: ''
+          OPENAI_API_KEY: ''
+          NOUS_API_KEY: ''
diff --git a/scripts/ci/macos_os_tests_gate.py b/scripts/ci/macos_os_tests_gate.py
new file mode 100644
index 0000000000..2ec596bd6f
--- /dev/null
+++ b/scripts/ci/macos_os_tests_gate.py
@@ -0,0 +1,106 @@
+#!/usr/bin/env python3
+"""Decide whether a scheduled macOS OS-marked test run may take the mini.
+
+Called by .github/workflows/macos-os-tests.yml before its job on the Mac mini's
+self-hosted runner (labels self-hosted, macOS, hermes-state). That one runner
+also serves the required hermes_state (macOS) and Native memory lanes of pull
+requests, and it is already saturated by them. So the scheduled run yields:
+when any job for the mini's label is waiting for a runner (queued, waiting,
+pending or requested) in another workflow run, this run skips, and the next
+schedule slot tries again. A job that is already running on the mini is not a
+reason to skip: ours queues behind one job, it does not starve a queue.
+
+Only ``schedule`` runs are gated. A manual dispatch or a probe push always runs.
+If the API cannot be read, the run goes ahead (fail open to testing): a
+transient read error should not silently drop the lane, and one run's extra
+load is bounded by the workflow's concurrency group.
+
+Writes ``run=true|false`` to $GITHUB_OUTPUT. Standard library only; the GitHub
+client shells out to ``gh api`` with an argument vector, using GH_TOKEN.
+
+Tests: tests/ci/test_macos_os_tests_workflow.py.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+from collections.abc import Callable, Iterable
+from concurrent.futures import ThreadPoolExecutor
+from typing import Any
+
+MINI_LABEL = "hermes-state"
+WAITING = frozenset({"queued", "waiting", "pending", "requested"})
+OPEN_RUN_STATES = ("queued", "in_progress", "waiting", "pending", "requested")
+
+Api = Callable[[str], dict[str, Any]]
+
+
+def waiting_mini_jobs(jobs: Iterable[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Jobs that want the mini's label and have no runner yet."""
+    return [
+        job for job in jobs
+        if job.get("status") in WAITING and MINI_LABEL in (job.get("labels") or [])
+    ]
+
+
+def find_waiting(api: Api, repo: str, own_run_id: int) -> list[dict[str, Any]]:
+    """Every waiting mini job across this repository's open runs, ours excluded.
+
+    Busy hours have 100+ open runs; their job lists are read 8 at a time
+    (read serially, one probe took ~3 min).
+    """
+    run_ids: list[int] = []
+    for state in OPEN_RUN_STATES:
+        runs = api(f"repos/{repo}/actions/runs?status={state}&per_page=100").get("workflow_runs") or []
+        for run in runs:
+            run_id = int(run["id"])
+            if run_id != own_run_id and run_id not in run_ids:
+                run_ids.append(run_id)
+
+    def jobs(run_id: int) -> list[dict[str, Any]]:
+        return api(f"repos/{repo}/actions/runs/{run_id}/jobs?filter=latest&per_page=100").get("jobs") or []
+
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        return [job for listed in pool.map(jobs, run_ids) for job in waiting_mini_jobs(listed)]
+
+
+def decide(event: str, api: Api, repo: str, own_run_id: int) -> tuple[bool, str]:
+    if event != "schedule":
+        return True, f"{event} run: not gated"
+    try:
+        waiting = find_waiting(api, repo, own_run_id)
+    except (subprocess.SubprocessError, OSError, ValueError, KeyError, TypeError) as exc:
+        # Any read failure (gh error/timeout, bad JSON, missing field) fails open to testing.
+        return True, f"could not read the mini's queue ({exc}); running anyway"
+    if waiting:
+        names = ", ".join(sorted({str(job.get("name")) for job in waiting}))
+        return False, f"{len(waiting)} job(s) already waiting for the mini ({names}); skipping this slot"
+    return True, "no job waiting for the mini"
+
+
+def gh_api(path: str) -> dict[str, Any]:
+    argv = ["gh", "api", path]
+    out = subprocess.run(argv, check=True, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=60)
+    return json.loads(out.stdout)
+
+
+def main() -> int:
+    run, reason = decide(
+        os.environ.get("GITHUB_EVENT_NAME", ""),
+        gh_api,
+        os.environ["GITHUB_REPOSITORY"],
+        int(os.environ.get("GITHUB_RUN_ID", "0")),
+    )
+    print(("::notice::" if run else "::warning::") + reason)
+    output = os.environ.get("GITHUB_OUTPUT")
+    if output:
+        with open(output, "a", encoding="utf-8") as f:
+            f.write(f"run={'true' if run else 'false'}\n")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tests/ci/test_macos_os_tests_workflow.py b/tests/ci/test_macos_os_tests_workflow.py
new file mode 100644
index 0000000000..188d6b33a3
--- /dev/null
+++ b/tests/ci/test_macos_os_tests_workflow.py
@@ -0,0 +1,133 @@
+"""The scheduled macOS OS-marked lane: shape of macos-os-tests.yml and its mini-queue gate.
+
+Decision t_01a1d5b9382b24ad (option B): platforms("macos"/"posix") tests run on the
+Mac mini on a schedule only, never on a pull request, and yield to required mini jobs.
+"""
+from __future__ import annotations
+
+import importlib.util
+import subprocess
+from pathlib import Path
+
+import hermes_yaml
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+WORKFLOW = ROOT / ".github/workflows/macos-os-tests.yml"
+GATE = ROOT / "scripts/ci/macos_os_tests_gate.py"
+REPO = "example-org/hermes"
+
+
+def _gate():
+    spec = importlib.util.spec_from_file_location("macos_os_tests_gate", GATE)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _workflow():
+    return hermes_yaml.safe_load(WORKFLOW.read_text(encoding="utf-8"))
+
+
+def test_lane_is_scheduled_and_never_a_pull_request_lane():
+    workflow = _workflow()
+    triggers = workflow.get("on", workflow.get(True))
+    assert set(triggers) == {"schedule", "workflow_dispatch", "push"}
+    assert triggers["schedule"] == [{"cron": "37 0,12 * * *"}]
+    # Probe branches only: ci-probe/** would also start the hermes_state lane on the mini.
+    assert triggers["push"] == {"branches": ["macos-os-probe/**"]}
+    assert workflow["permissions"] == {"contents": "read"}
+    assert workflow["concurrency"]["cancel-in-progress"] is False
+    ci = (ROOT / ".github/workflows/ci.yaml").read_text(encoding="utf-8")
+    assert "uses: ./.github/workflows/macos-os-tests.yml" not in ci
+
+
+def test_test_job_waits_for_the_gate_and_runs_the_marked_selection_on_the_mini():
+    jobs = _workflow()["jobs"]
+    gate, job = jobs["gate"], jobs["macos-os-tests"]
+    assert gate["permissions"] == {"actions": "read", "contents": "read"}
+    assert "scripts/ci/macos_os_tests_gate.py" in gate["steps"][-1]["run"]
+    assert gate["outputs"]["run"] == "${{ steps.gate.outputs.run }}"
+    assert job["needs"] == "gate"
+    assert "needs.gate.outputs.run == 'true'" in job["if"]
+    assert f"github.repository == '{REPO}'" in job["if"]
+    assert job["runs-on"] == ["self-hosted", "macOS", "hermes-state"]
+    command = job["steps"][-1]["run"]
+    assert "sys.platform == 'darwin'" in command
+    assert "HERMES_HOME" in command and "mktemp -d" in command
+    assert "scripts/ci/list_os_marked_tests.py macos" in command
+    assert 'test -s "$LIST"' in command
+    assert "taskpolicy -c utility scripts/run_tests.sh --files-from \"$LIST\" -j 2" in command
+    assert '-m "platforms and not integration"' in command
+
+
+def _api(runs: dict[str, list[dict]], jobs: dict[int, list[dict]], calls: list[str] | None = None):
+    def api(path: str):
+        if calls is not None:
+            calls.append(path)
+        if "/jobs" in path:
+            run_id = int(path.split("/runs/")[1].split("/")[0])
+            return {"jobs": jobs.get(run_id, [])}
+        state = path.split("status=")[1].split("&")[0]
+        return {"workflow_runs": runs.get(state, [])}
+    return api
+
+
+def _job(status: str, labels=("self-hosted", "macOS", "hermes-state"), name="hermes_state (macOS) / x"):
+    return {"status": status, "labels": list(labels), "name": name}
+
+
+@pytest.mark.parametrize("status", ["queued", "waiting", "pending", "requested"])
+def test_schedule_skips_while_a_mini_job_waits(status):
+    api = _api({"in_progress": [{"id": 1}]}, {1: [_job("completed"), _job(status)]})
+    run, reason = _gate().decide("schedule", api, REPO, own_run_id=99)
+    assert run is False
+    assert "1 job(s) already waiting" in reason
+
+
+def test_schedule_runs_when_mini_jobs_are_only_running_or_on_other_labels():
+    jobs = {
+        1: [_job("in_progress")],
+        2: [_job("queued", labels=("blacksmith-4vcpu-ubuntu-2404",))],
+    }
+    api = _api({"in_progress": [{"id": 1}], "queued": [{"id": 2}]}, jobs)
+    assert _gate().decide("schedule", api, REPO, own_run_id=99) == (True, "no job waiting for the mini")
+
+
+def test_own_run_is_excluded_and_each_run_is_read_once():
+    calls: list[str] = []
+    jobs = {99: [_job("queued", name="macOS-only tests (mini)")], 1: []}
+    api = _api({"queued": [{"id": 99}, {"id": 1}], "in_progress": [{"id": 1}]}, jobs, calls)
+    run, _ = _gate().decide("schedule", api, REPO, own_run_id=99)
+    assert run is True
+    assert sum("/runs/1/jobs" in c for c in calls) == 1
+    assert not any("/runs/99/jobs" in c for c in calls)
+
+
+@pytest.mark.parametrize("event", ["workflow_dispatch", "push"])
+def test_manual_and_probe_runs_are_never_gated(event):
+    def api(path):
+        raise AssertionError("not read")
+    assert _gate().decide(event, api, REPO, own_run_id=1)[0] is True
+
+
+@pytest.mark.parametrize("error", [subprocess.CalledProcessError(1, ["gh"], stderr="HTTP 502"),
+                                   subprocess.TimeoutExpired(["gh"], 60), ValueError("bad JSON")])
+def test_unreadable_queue_fails_open_to_testing(error):
+    def api(path):
+        raise error
+    run, reason = _gate().decide("schedule", api, REPO, own_run_id=1)
+    assert run is True
+    assert "running anyway" in reason
+
+
+def test_main_writes_the_step_output(tmp_path, monkeypatch):
+    gate = _gate()
+    out = tmp_path / "out"
+    monkeypatch.setenv("GITHUB_OUTPUT", str(out))
+    monkeypatch.setenv("GITHUB_EVENT_NAME", "schedule")
+    monkeypatch.setenv("GITHUB_REPOSITORY", REPO)
+    monkeypatch.setenv("GITHUB_RUN_ID", "5")
+    monkeypatch.setattr(gate, "gh_api", _api({"queued": [{"id": 6}]}, {6: [_job("queued")]}))
+    assert gate.main() == 0
+    assert out.read_text() == "run=false\n"
