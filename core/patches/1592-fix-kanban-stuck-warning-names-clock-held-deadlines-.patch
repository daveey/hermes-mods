+def test_all_clock_held_only_when_every_ready_card_waits_on_a_clock(home):
+    with kbc.connect() as conn:
+        _quota_held(conn, "a", time.time() + 3600)
+        _cooldown_held(conn, "b")
+        all_held = _tick(conn, [])
+        assert kbd.all_clock_held([all_held])
