From 4dbfb504906e340344f013303513529dd722cc09 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 16:15:55 -0700
Subject: [PATCH] perf(desktop): keep remote gateways warm - always-on
 supervised dashboard, startup prewarm, 30 s dispatch probe skip [daveey]

- hermes always-on-dashboard install|run|status|uninstall: one launchd/systemd-supervised
  serve --isolated per host with a persisted token/nonce, fixed port 9147 and no idle exit;
  code-skew retirement + KeepAlive/Restart=always restarts it on new code after an update.
- remote-lifecycle connect(): default profile reuses the always-on dashboard before the
  lockfile path; waits up to 20 s for a supervisor restart; never kills or locks it.
- remote-prewarm.ts: dial every SSH connection at startup, 15 s forced keepalive, backoff
  reconnect on drop. ControlPersist 300 -> 3600.
- Dispatch skips /api/health when the backend answered within 30 s.
- [remote-timing] logs: connect-start, ssh dial, reuse/spawn, first request, dispatch probe.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff --git a/apps/desktop/electron/remote-lifecycle-always-on.test.ts b/apps/desktop/electron/remote-lifecycle-always-on.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1185d96615c41ba30945eebbca6facc882d0a4e1
--- /dev/null
+++ b/apps/desktop/electron/remote-lifecycle-always-on.test.ts
@@ -0,0 +1,183 @@
+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { connect, readAlwaysOnState } from './remote-lifecycle'
+
+// Part B (instant session loads): a launchd/systemd-supervised always-on `serve` per remote host
+// (hermes_cli/always_on_dashboard.py). connect() reuses it for the default profile before the owned-backend
+// lockfile path, waits out a supervisor restart (core update, crash) instead of spawning beside it, and never
+// kills it or writes a lockfile for it.
+
+const OWNERSHIP_ID = '0123456789abcdef0123456789abcdef'
+const TOKEN = 'a'.repeat(64)
+const NONCE = 'fedcba9876543210'
+
+function record(over: any = {}) {
+  return { schemaVersion: 1, pid: 4242, port: 9147, spawnNonce: NONCE, hermesHome: '~/.hermes', ...over }
+}
+
+// `states` is what successive always-on reads return: 'NONE' (not installed) or [ALIVE|DEAD, record].
+function fakeHost(states: any[], extra: any[] = []) {
+  const calls: string[] = []
+  let read = 0
+
+  return {
+    calls,
+    async exec(cmd: string) {
+      calls.push(cmd)
+
+      if (cmd.includes('desktop-ssh/always-on')) {
+        const state = states[Math.min(read++, states.length - 1)]
+
+        return state === 'NONE' ? 'NONE\n' : `${state[0]}\n${JSON.stringify(state[1])}\n${TOKEN}\n`
+      }
+
+      if (cmd.includes('.hermes-update-in-progress') && !/setsid|nohup/.test(cmd)) {
+        return 'CLEAR'
+      }
+
+      for (const [matcher, resp] of [
+        [/uname/, 'Darwin\narm64'],
+        [/\[ -x/, 'OK'],
+        [/kill -0/, 'ALIVE'],
+        ...extra
+      ] as any[]) {
+        if (matcher.test(cmd)) {
+          return typeof resp === 'function' ? resp(cmd) : resp
+        }
+      }
+
+      return ''
+    }
+  }
+}
+
+function deps(ssh, over: any = {}) {
+  const forwards: number[] = []
+  const cancelled: number[] = []
+
+  return {
+    forwards,
+    cancelled,
+    ssh,
+    ownershipId: OWNERSHIP_ID,
+    profile: '',
+    forward: async (_local, remote) => void forwards.push(remote),
+    cancelForward: async (_local, remote) => void cancelled.push(remote),
+    pickLocalPort: async () => 50001,
+    waitForHermes: async () => {},
+    probeReuseProof: async (_url, token, nonce) =>
+      token === TOKEN && nonce === NONCE ? 'authenticated-ok' : 'authenticated-stale',
+    adoptServedToken: async (_baseUrl, token) => token,
+    rememberLog: () => {},
+    readyTimeoutMs: 2000,
+    sleep: async () => {},
+    ...over
+  }
+}
+
+const SPAWNS = /setsid|nohup/
+const WRITES_LOCK = /backend\.lock\.json/
+const KILLS = /\bkill (-9 |-TERM )?4242\b|os\.kill\(/
+
+test('connect() reuses the always-on dashboard: no spawn, no lockfile, nothing killed', async () => {
+  const ssh = fakeHost([['ALIVE', record()]])
+  const d = deps(ssh)
+  const result = await connect(d)
+
+  assert.equal(result.alwaysOn, true)
+  assert.equal(result.reused, true)
+  assert.equal(result.pid, 4242)
+  assert.equal(result.remotePort, 9147)
+  assert.equal(result.token, TOKEN)
+  assert.deepEqual(d.forwards, [9147])
+  assert.ok(!ssh.calls.some(c => SPAWNS.test(c)), 'must not spawn an owned backend')
+  assert.ok(!ssh.calls.some(c => WRITES_LOCK.test(c)), 'must not read or write the owned lockfile')
+  assert.ok(!ssh.calls.some(c => KILLS.test(c)))
+})
+
+test('after a core update, connect() waits for the supervisor restart and reuses the restarted dashboard', async () => {
+  const logs: string[] = []
+  // 1: the old pid still runs the replaced runtime; 2: the code-skew watchdog retired it; 3: launchd/systemd restarted it.
+  const ssh = fakeHost([['ALIVE', record()], ['DEAD', record()], ['ALIVE', record({ pid: 5151 })]])
+  let probes = 0
+
+  const d = deps(ssh, {
+    rememberLog: line => logs.push(line),
+    probeReuseProof: async () => (++probes === 1 ? 'authenticated-stale' : 'authenticated-ok')
+  })
+
+  const result = await connect(d)
+
+  assert.equal(result.alwaysOn, true)
+  assert.equal(result.pid, 5151)
+  assert.ok(!ssh.calls.some(c => SPAWNS.test(c)), 'a restart window must not become a spawn')
+  assert.deepEqual(d.cancelled, [9147], 'the stale probe forward is closed')
+  assert.ok(logs.some(l => /stale after an update\); waiting for its supervisor restart/.test(l)), logs.join('\n'))
+  assert.ok(logs.some(l => /reusing always-on remote dashboard pid=5151/.test(l)), logs.join('\n'))
+})
+
+test('a dashboard that is still down after the restart wait falls back to the owned-backend path', async () => {
+  const logs: string[] = []
+  let clock = 0
+
+  const ssh = fakeHost(
+    [['DEAD', record()]],
+    [
+      [/grep -q ssh-session-token-file/, 'YES\n'],
+      [/setsid/, '777\n'],
+      [/cat .*\.log/, 'HERMES_DASHBOARD_READY port=51999\n']
+    ]
+  )
+
+  const d = deps(ssh, {
+    rememberLog: line => logs.push(line),
+    now: () => clock,
+    sleep: async ms => void (clock += ms),
+    alwaysOnRestartWaitMs: 3000
+  })
+
+  try {
+    await connect(d)
+  } catch {
+    // The owned spawn may fail in this double; only that it was attempted matters.
+  }
+
+  assert.ok(logs.some(l => /always-on dashboard unavailable \(pid 4242 not running\)/.test(l)), logs.join('\n'))
+  assert.ok(ssh.calls.some(c => SPAWNS.test(c)), 'falls back to spawning an owned backend')
+})
+
+test('no always-on dashboard installed: connect() goes straight to the lockfile path', async () => {
+  const ssh = fakeHost(['NONE'])
+  const d = deps(ssh)
+
+  try {
+    await connect(d)
+  } catch {
+    void 0
+  }
+
+  assert.equal(ssh.calls.filter(c => c.includes('desktop-ssh/always-on')).length, 1, 'read once, no waiting')
+  assert.ok(ssh.calls.some(c => WRITES_LOCK.test(c)))
+})
+
+test('a named profile keeps its own owned backend and never reads the always-on record', async () => {
+  const ssh = fakeHost([['ALIVE', record()]])
+
+  try {
+    await connect(deps(ssh, { profile: 'work' }))
+  } catch {
+    void 0
+  }
+
+  assert.ok(!ssh.calls.some(c => c.includes('desktop-ssh/always-on')))
+})
+
+test('readAlwaysOnState rejects a malformed record or token', async () => {
+  const bad = { exec: async () => `ALIVE\n${JSON.stringify(record({ spawnNonce: 'nope' }))}\n${TOKEN}\n` }
+  assert.deepEqual(await readAlwaysOnState(bad), { installed: true, alive: false, record: null, token: '' })
+
+  const ok = { exec: async () => `ALIVE\n${JSON.stringify(record())}\n${TOKEN}\n` }
+  assert.equal((await readAlwaysOnState(ok))?.alive, true)
+})
diff --git a/apps/desktop/electron/remote-lifecycle.ts b/apps/desktop/electron/remote-lifecycle.ts
index 7cc05449624139cf688944ea716c2fe3e080c8a9..8dce9c0825fa7e0373edd3d6981512b4d0741fc5 100644
--- a/apps/desktop/electron/remote-lifecycle.ts
+++ b/apps/desktop/electron/remote-lifecycle.ts
@@ -1541,6 +1541,163 @@ async function openForward(deps, remotePort, attempts = 3) {
   throw lastError
 }
 
+// Always-on remote dashboard (hermes_cli/always_on_dashboard.py): one launchd/systemd-supervised `serve` per host
+// with a persisted token, a fixed port and no idle exit. Desktop never owns it: it is reused when it proves itself
+// with the token it publishes, and never reaped, terminated or given a lockfile here.
+const ALWAYS_ON_DIR = '~/.hermes/desktop-ssh/always-on'
+const ALWAYS_ON_RECORD_SCHEMA = 1
+// A supervisor restart (code-skew retirement after an update, a crash) takes a few seconds; wait that out instead
+// of spawning a second backend next to it.
+const ALWAYS_ON_RESTART_WAIT_MS = 20_000
+const ALWAYS_ON_POLL_MS = 1_000
+
+// One remote command: is it installed, is the recorded pid alive, the record, the token. NONE = not installed.
+async function readAlwaysOnState(ssh) {
+  const dir = expandRemotePath(ALWAYS_ON_DIR)
+
+  const raw = await ssh.exec(
+    `d=${dir}; [ -f "$d/token" ] && [ -f "$d/record.json" ] || { echo NONE; exit 0; }; ` +
+      `rec=$(cat "$d/record.json"); pid=$(printf '%s' "$rec" | sed -n 's/.*"pid": *\\([0-9][0-9]*\\).*/\\1/p'); ` +
+      `if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then echo ALIVE; else echo DEAD; fi; ` +
+      `printf '%s\\n' "$rec"; cat "$d/token"`
+  )
+
+  const [state = '', recordLine = '', tokenLine = ''] = String(raw || '').trim().split('\n')
+
+  if (state.trim() === 'NONE' || !state.trim()) {
+    return null
+  }
+
+  let record
+
+  try {
+    record = JSON.parse(recordLine)
+  } catch {
+    return { installed: true, alive: false, record: null, token: '' }
+  }
+
+  const token = tokenLine.trim()
+
+  const valid =
+    record?.schemaVersion === ALWAYS_ON_RECORD_SCHEMA &&
+    Number.isInteger(record.pid) &&
+    Number.isInteger(record.port) &&
+    record.port > 0 &&
+    /^[0-9a-f]{16}$/.test(String(record.spawnNonce || '')) &&
+    /^[0-9a-f]{64}$/.test(token)
+
+  return valid
+    ? { installed: true, alive: state.trim() === 'ALIVE', record, token }
+    : { installed: true, alive: false, record: null, token: '' }
+}
+
+async function connectAlwaysOn(deps, { ssh, platform, hermesPath, hermesVersion, hermesHome, log, signal }) {
+  const { probeReuseProof, adoptServedToken, ownershipId } = deps
+  const waitMs = deps.alwaysOnRestartWaitMs ?? ALWAYS_ON_RESTART_WAIT_MS
+  const pollMs = deps.alwaysOnPollMs ?? ALWAYS_ON_POLL_MS
+  const sleep = deps.sleep ?? (ms => new Promise(resolve => setTimeout(resolve, ms)))
+  const now = deps.now ?? Date.now
+  const deadline = now() + waitMs
+  let lastReason = ''
+
+  for (;;) {
+    assertBootstrapNotSuperseded(signal)
+    const state = await readAlwaysOnState(ssh)
+
+    if (!state) {
+      return null
+    }
+
+    if (!state.record) {
+      // The supervisor writes the record atomically; an unusable one will not fix itself while we wait.
+      log('always-on dashboard record or token is malformed; not reusing it')
+
+      return null
+    }
+
+    let reason = ''
+
+    if (state.record.hermesHome && state.record.hermesHome !== hermesHome) {
+      log(`always-on dashboard serves ${state.record.hermesHome}, not ${hermesHome}; not reusing it`)
+
+      return null
+    }
+
+    if (!state.alive) {
+      reason = `pid ${state.record.pid} not running`
+    } else {
+      const { pid, port, spawnNonce } = state.record
+      const localPort = await openForward(deps, port)
+      const baseUrl = `http://127.0.0.1:${localPort}`
+      let classification = ''
+
+      try {
+        classification = await probeReuseProof(baseUrl, state.token, spawnNonce)
+      } catch {
+        classification = 'unreachable'
+      }
+
+      if (classification === 'authenticated-ok') {
+        try {
+          const token = await adoptOwnedServedToken(
+            adoptServedToken,
+            baseUrl,
+            state.token,
+            ssh,
+            pid,
+            'always-on remote dashboard'
+          )
+
+          assertBootstrapNotSuperseded(signal)
+          log(`reusing always-on remote dashboard pid=${pid} port=${port}`)
+
+          return {
+            baseUrl,
+            token,
+            tokenFingerprint: fingerprintToken(token),
+            remotePort: port,
+            localPort,
+            pid,
+            reused: true,
+            alwaysOn: true,
+            platform,
+            hermesPath,
+            hermesVersion,
+            ownershipId,
+            spawnNonce,
+            logPath: '',
+            hermesHome,
+            startedAt: state.record.startedAt || '',
+            creationTime: ''
+          }
+        } catch (error) {
+          await cancelForwardSafe(deps, localPort, port)
+          throw error
+        }
+      }
+
+      await cancelForwardSafe(deps, localPort, port)
+      reason =
+        classification === 'authenticated-stale'
+          ? `pid ${pid} runs a replaced runtime (stale after an update)`
+          : `pid ${pid} not answering on port ${port}`
+    }
+
+    if (now() >= deadline) {
+      log(`always-on dashboard unavailable (${reason}) after ${waitMs} ms; falling back to an owned backend`)
+
+      return null
+    }
+
+    if (reason !== lastReason) {
+      log(`always-on dashboard ${reason}; waiting for its supervisor restart`)
+      lastReason = reason
+    }
+
+    await sleep(pollMs)
+  }
+}
+
 /**
  * Establish (or reuse) a remote dashboard and a tunnel to it. `deps` injects the
  * opened SshConnection, forward/pickLocalPort/waitForHermes, a token-gated
@@ -1622,6 +1779,15 @@ async function connect(deps) {
     log(`remote hermes version: ${hermesVersion}`)
   }
 
+  // The always-on dashboard serves the default profile; named profiles keep their own owned backends.
+  if (!profile && deps.alwaysOn !== false) {
+    const alwaysOn = await connectAlwaysOn(deps, { ssh, platform, hermesPath, hermesVersion, hermesHome, log, signal })
+
+    if (alwaysOn) {
+      return alwaysOn
+    }
+  }
+
   const reuseToken = deps.reuseToken || ''
   const lock = await readLockfile(ssh, ownershipId)
 
@@ -1885,11 +2051,14 @@ async function connect(deps) {
 
 export {
   adoptOwnedServedToken,
+  ALWAYS_ON_DIR,
+  ALWAYS_ON_RESTART_WAIT_MS,
   assertRemoteInstallUpdateClear,
   buildSpawnCommand,
   classifySshReuseProof,
   cleanupStale,
   connect,
+  connectAlwaysOn,
   connectReservationPath,
   DEFAULT_READY_TIMEOUT_MS,
   disconnect,
@@ -1911,6 +2080,7 @@ export {
   probeRemoteHermesHome,
   probeRemotePlatform,
   PROTOCOL_VERSION,
+  readAlwaysOnState,
   readLockfile,
   readRemoteInstallId,
   READY_RE,
