+  skipWindowMs = DISPATCH_PROBE_SKIP_WINDOW_MS,
+  onProbe
 }: EnsureHealthyPooledRemoteBackendForDispatchOptions<TConnection>): Promise<TConnection> {
-  let connection: TConnection
+  let connection: TConnection | undefined
+  const startedAt = Date.now()
 
   try {
     connection = await connectionPromise
@@ -112,6 +154,12 @@ export async function ensureHealthyPooledRemoteBackendForDispatch<TConnection ex
       return reconnect()
     }
 
+    if (answers?.answeredWithin(connection.baseUrl, skipWindowMs)) {
+      onProbe?.('skipped', Date.now() - startedAt)
+
+      return connection
+    }
+
     try {
       await probe(connection, '/api/health', {
         timeoutMs: POOLED_REMOTE_DISPATCH_PROBE_TIMEOUT_MS
@@ -129,6 +177,8 @@ export async function ensureHealthyPooledRemoteBackendForDispatch<TConnection ex
       })
     }
   } catch (error) {
+    answers?.forget(connection?.baseUrl)
+
     if (currentConnectionPromise() === connectionPromise) {
       await retire(error)
     }
@@ -136,6 +186,9 @@ export async function ensureHealthyPooledRemoteBackendForDispatch<TConnection ex
