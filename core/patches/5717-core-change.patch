From a7d60815f3f741a65b8fc435c99bee26c3e6d4e3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 09:25:39 +0000
Subject: [PATCH] fix(kanban): identify authenticated card-answer HTTPS reads
 [daveey]

Records.read constructed urllib requests with only Authorization, leaving the
stdlib default User-Agent. The enrolled HTTPS edge rejected those reads with
403 while the same credential and URL accepted an application User-Agent.
Set a fixed generic application identity on the existing GET request; expose
no caller override and leave endpoint, credential, redirect, timeout, record
identity, response-size and sanitized-error contracts unchanged.

Proof: canonical guarded runner with HERMES_TEST_FILE_RETRIES=0. Regression
before fix: 1 failed (missing request User-Agent), 19 passed. After fix: all
11 card-answer transport/runtime/source/proof/answer and importing-consumer
files, 242 passed, 0 failed, 6 skipped. Added 403 sanitized-error coverage.
Full scripts/hermes-python scripts/check --base origin/main: 21 checks OK.

Hermes-Card: t_4b7ea282b80756a2
---
 hermes_cli/kanban_card_answer_transport.py            | 3 ++-
 tests/hermes_cli/test_kanban_card_answer_transport.py | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_card_answer_transport.py b/hermes_cli/kanban_card_answer_transport.py
index edbf4ce83d..88724bf7cb 100644
--- a/hermes_cli/kanban_card_answer_transport.py
+++ b/hermes_cli/kanban_card_answer_transport.py
@@ -41,7 +41,8 @@ class Records:
         if not isinstance(request_id, str) or not re.fullmatch(r'[A-Za-z0-9_-][A-Za-z0-9_.:-]{0,199}', request_id):
             raise AnswerRefused('courier_request_id_invalid')
         request = urllib.request.Request(self.url + '/v2/sync/requests/' + urllib.parse.quote(request_id, safe=''),
-                                         headers={'Authorization': 'Bearer ' + self._key}, method='GET')
+                                         headers={'Authorization': 'Bearer ' + self._key,
+                                                  'User-Agent': 'hermes-card-answer-readback/1.0'}, method='GET')
         try:
             with self._opener.open(request, timeout=10) as response:
                 raw = response.read(1024 * 1024 + 1)
diff --git a/tests/hermes_cli/test_kanban_card_answer_transport.py b/tests/hermes_cli/test_kanban_card_answer_transport.py
index bada376aa9..f285c52a7a 100644
--- a/tests/hermes_cli/test_kanban_card_answer_transport.py
+++ b/tests/hermes_cli/test_kanban_card_answer_transport.py
@@ -24,6 +24,7 @@ def test_reads_exact_authenticated_record(config, monkeypatch):
     def open_request(req, timeout):
         assert req.full_url == 'https://example.com/hub/v2/sync/requests/request-one'
         assert req.method == 'GET' and req.headers['Authorization'] == 'Bearer fixture-key'
+        assert req.get_header('User-agent') == 'hermes-card-answer-readback/1.0'
         assert timeout == 10
         return io.BytesIO(json.dumps({'request': {'id': 'request-one', 'state': 'done'}}).encode())
     monkeypatch.setattr(reader._opener, 'open', open_request)
@@ -55,7 +56,7 @@ def test_malformed_or_wrong_record_refuses(config, raw, monkeypatch):
         reader.read('request-one')
 
 
-@pytest.mark.parametrize('status', [302, 401, 404, 503])
+@pytest.mark.parametrize('status', [302, 401, 403, 404, 503])
 def test_http_errors_have_no_sensitive_details(config, status, monkeypatch):
     reader = transport.Records()
     def fail(*a, **kw):
