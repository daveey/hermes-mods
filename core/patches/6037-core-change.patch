+                       'from hermes_cli.kanban_source_barrier import CustodyBusy\n'
+                       'try:\n    s.transaction().__enter__()\nexcept CustodyBusy:\n    print("busy")\n')
+        assert child.stdout.strip() == 'busy', child.stderr
