+++ b/apps/desktop/src/components/assistant-ui/inline-preview-directive.test.ts
@@ -14,6 +14,7 @@ import {
   frameSizeFromMessage,
   INTENT_THROTTLE_MS,
   intentAckMessage,
+  intentRejectNotice,
   intentScript,
   MAX_INTENT_LENGTH,
   nextFrameHeight,
@@ -338,3 +339,25 @@ describe('intentScript', () => {
     expect(win.hermes?.maxLength).toBe(MAX_INTENT_LENGTH)
   })
 })
+
+// desktop-13785ebc41: a rating page sent every rating in one over-length
+// intent and ignored the refusal, so the user saw nothing while all of it was
+// lost. A refusal must reach the user, not only the page.
+describe('intentRejectNotice', () => {
+  it('names an over-length refusal for the user', () => {
+    const notice = intentRejectNotice({ error: 'too_long', maxLength: MAX_INTENT_LENGTH, ok: false })
+
+    expect(notice).toContain('not sent')
+    expect(notice).toContain(String(MAX_INTENT_LENGTH))
+  })
+
+  it('names invalid and undelivered refusals', () => {
+    expect(intentRejectNotice({ error: 'invalid', ok: false })).toContain('not sent')
+    expect(intentRejectNotice({ error: 'undelivered', ok: false })).toContain('not sent')
+  })
+
+  it('stays quiet for accepted and throttled intents (a good widget retries those)', () => {
+    expect(intentRejectNotice({ ok: true })).toBeNull()
+    expect(intentRejectNotice({ error: 'throttled', ok: false, retryAfterMs: 400 })).toBeNull()
+  })
+})
diff --git a/apps/desktop/src/components/assistant-ui/inline-preview-directive.tsx b/apps/desktop/src/components/assistant-ui/inline-preview-directive.tsx
index e6ee8dd5fc5..2133c0b13dd 100644
--- a/apps/desktop/src/components/assistant-ui/inline-preview-directive.tsx
+++ b/apps/desktop/src/components/assistant-ui/inline-preview-directive.tsx
@@ -184,6 +184,32 @@ export function intentAckMessage(token: string, id: number, ack: IntentAck) {
   return { ack, id, token, type: INTENT_ACK_MESSAGE_TYPE }
 }
 
+/** The line shown UNDER the frame when an intent was refused, or null.
+ *  The ack tells only the page, and a page that ignores it fails silently
+ *  while the user keeps entering data (desktop-13785ebc41: 333 ratings sent
+ *  as one over-length intent, all lost). Throttled is left to the page: a
+ *  well-built widget retries it after `retryAfterMs`, so a notice would be
+ *  noise. */
+export function intentRejectNotice(ack: IntentAck): string | null {
+  if (ack.ok) {
+    return null
+  }
+
+  switch (ack.error) {
+    case 'too_long':
+      return `Widget message not sent: longer than ${ack.maxLength ?? MAX_INTENT_LENGTH} characters. Ask the agent to send it in smaller pieces.`
+
+    case 'invalid':
+      return 'Widget message not sent: it was empty.'
+
+    case 'undelivered':
+      return 'Widget message not sent: no chat composer took it.'
+
+    default:
+      return null
+  }
+}
+
 /** Semantic tokens handed into the frame, resolved to concrete values from
  *  the LIVE theme. Friendly names, not internal ones — this is the contract
  *  reference HTML / skills write against (`var(--foreground)` etc.). */
@@ -429,6 +455,9 @@ function InlineHtmlFrame({
   const [sizing, setSizing] = useState<{ grow: number; measured: number | null }>({ grow: 0, measured: null })
   const measured = sizing.measured
   const [contentWidth, setContentWidth] = useState<number | null>(null)
+  // The last refused intent, shown under the frame (cleared by the next
+  // accepted one) so a refusal the page ignores still reaches the user.
+  const [rejectNotice, setRejectNotice] = useState<string | null>(null)
 
   // One token per mount: the message listener only trusts reports from the
   // document THIS mount injected, so two previews in one transcript (or a
@@ -492,6 +521,12 @@ function InlineHtmlFrame({
             : { error: 'undelivered', ok: false }
         }
 
+        const notice = intentRejectNotice(ack)
+
+        if (notice !== null || ack.ok) {
+          setRejectNotice(notice)
+        }
+
         // Reply only to the sender that proved it holds this mount's token.
         // The ack carries status, never app data; '*' because the sandboxed
         // frame's origin is opaque.
@@ -584,6 +619,11 @@ function InlineHtmlFrame({
           />
         </span>
       )}
+      {rejectNotice !== null && (
+        <span className="mt-1 block text-xs text-destructive" role="status">
+          {rejectNotice}
+        </span>
+      )}
     </span>
   )
 }
