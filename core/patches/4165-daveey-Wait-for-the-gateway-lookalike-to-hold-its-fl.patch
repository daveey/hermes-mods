From 04c4b4e7b1e078965b39a770c3665919684883b0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 05:38:10 +0000
Subject: [PATCH] [daveey] Wait for the gateway lookalike to hold its flock,
 not for the lock file

_spawn_gateway_lookalike returned as soon as gateway.lock existed, but the
child creates that file with open('a+') one statement before flock(). A child
descheduled in that gap leaves the lock inactive when stop_profile_gateway
runs: get_running_pid() sees no held lock, cleans the pid file and returns
None, so test_stop_profile_gateway_still_stops_own_gateway gets False
(CI run 43559782786 on main a3fe7bf2, passed on retry). The parent's own lock
probe can also win the flock and make the child's LOCK_NB fail.

The child now touches a ready file after flock succeeds and the parent waits
for it with tests.waiting.wait_until (60 s deadline that returns as soon as
the file appears), killing the child if it dies or never becomes ready.

Proof:
- RED: a copy of the old test with time.sleep(1.0) between open() and flock()
  in the child fails exactly like CI: "assert False is True" on
  stop_profile_gateway().
- GREEN: the same 1.0 s gap injected into the fixed helper passes (8/8), and
  the unmodified file passes 64/64 runs with its children SIGSTOP/SIGCONT
  duty-cycled under 8 CPU burners, 16 runs in parallel.
- scripts/check: 20 checks ok (health: 0 blocking).
---
 .../test_cross_profile_kill_refusal.py        | 27 +++++++++++++++----
 1 file changed, 22 insertions(+), 5 deletions(-)

diff --git a/tests/hermes_cli/test_cross_profile_kill_refusal.py b/tests/hermes_cli/test_cross_profile_kill_refusal.py
index a2e3b55e68..1c0fb55d98 100644
--- a/tests/hermes_cli/test_cross_profile_kill_refusal.py
+++ b/tests/hermes_cli/test_cross_profile_kill_refusal.py
@@ -21,20 +21,30 @@ from pathlib import Path
 import pytest
 
 from gateway.status import recorded_gateway_home_conflicts
+from tests.waiting import wait_until
 
 
 def _spawn_gateway_lookalike(bin_dir: Path, lock_path: Path) -> subprocess.Popen:
-    """Real child process whose argv matches the gateway runtime matcher."""
+    """Real child process whose argv matches the gateway runtime matcher.
+
+    Returns only once the child HOLDS the flock. ``open(..., 'a+')`` creates the lock file before
+    ``flock`` runs, so waiting for the file to exist let a CPU-starved child be caught in between:
+    the lock read as inactive and ``stop_profile_gateway`` returned False. The child touches a
+    ready file after ``flock`` succeeds and the parent waits for that instead.
+    """
     bin_dir.mkdir(parents=True, exist_ok=True)
     lock_path.parent.mkdir(parents=True, exist_ok=True)
+    ready_path = bin_dir / f"{lock_path.parent.name}-lookalike.ready"
+    ready_path.unlink(missing_ok=True)
     script = bin_dir / "hermes"
     if sys.platform == "win32":
-        body = "import time\ntime.sleep(120)\n"
+        body = f"import time\nopen({str(ready_path)!r}, 'w').close()\ntime.sleep(120)\n"
     else:
         body = (
             "import fcntl, time\n"
             f"fh = open({str(lock_path)!r}, 'a+')\n"
             "fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)\n"
+            f"open({str(ready_path)!r}, 'w').close()\n"
             "time.sleep(120)\n"
         )
     script.write_text(f"#!{sys.executable}\n{body}", encoding="utf-8")
@@ -46,11 +56,18 @@ def _spawn_gateway_lookalike(bin_dir: Path, lock_path: Path) -> subprocess.Popen
     proc = subprocess.Popen(
         cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
     )
-    deadline = time.monotonic() + 10.0
-    while time.monotonic() < deadline and not lock_path.exists():
+
+    def _ready() -> bool:
         if proc.poll() is not None:
             raise RuntimeError("gateway lookalike died at startup")
-        time.sleep(0.05)
+        return ready_path.exists()
+
+    try:
+        wait_until(_ready, timeout=60.0, what="gateway lookalike to hold its flock")
+    except BaseException:
+        proc.kill()
+        proc.wait(timeout=10)
+        raise
     return proc
 
 
