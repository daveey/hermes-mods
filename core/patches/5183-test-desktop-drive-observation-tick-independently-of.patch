From 481bbc2db9c19f247fc92f771b0c88455f87613e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 11:02:19 +0000
Subject: [PATCH] test(desktop): drive observation tick independently of timer
 fixture lifetime [daveey]

---
 apps/desktop/src/app/chat/session-status-dot.test.tsx         | 3 ++-
 apps/desktop/src/app/chat/sidebar/session-row-stripe.test.tsx | 4 +++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/app/chat/session-status-dot.test.tsx b/apps/desktop/src/app/chat/session-status-dot.test.tsx
index 635361f6e6..dbe48f937f 100644
--- a/apps/desktop/src/app/chat/session-status-dot.test.tsx
+++ b/apps/desktop/src/app/chat/session-status-dot.test.tsx
@@ -409,7 +409,8 @@ describe('SessionStatusDot external label', () => {
       expect(el).not.toBeNull()
       expect(el?.getAttribute('title')).toContain('Running on GitHub Actions')
       act(() => {
-        vi.advanceTimersByTime(301_000)
+        vi.setSystemTime(1_301_000)
+        $kanbanObservationTick.set($kanbanObservationTick.get() + 1)
       })
       expect(c.querySelector('[data-background-label="external"]')?.getAttribute('title')).toContain(
         'Status unknown on GitHub Actions'
diff --git a/apps/desktop/src/app/chat/sidebar/session-row-stripe.test.tsx b/apps/desktop/src/app/chat/sidebar/session-row-stripe.test.tsx
index e6a22d1a0f..6c18d9e6ca 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row-stripe.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row-stripe.test.tsx
@@ -4,6 +4,7 @@ import { afterEach, expect, it, vi } from 'vitest'
 
 import { createClientSessionState } from '@/lib/chat-runtime'
 import { $queuedPromptsBySession } from '@/store/composer-queue'
+import { $kanbanObservationTick } from '@/store/kanban-observation'
 import { reconcilePendingSubmissions } from '@/store/pending-submissions'
 import { $sessions, setSessions } from '@/store/session'
 import { resetStripeTransitionLog, setStripeReasonReporter } from '@/store/session-dot-state'
@@ -257,7 +258,8 @@ it('a mounted external stripe expires on the client clock with an unchanged sess
     expect(container.querySelector('[data-external-cloud="solid"]')).not.toBeNull()
     expect(stripe(container)?.getAttribute('aria-label')).toContain('Running on GitHub Actions')
     act(() => {
-      vi.advanceTimersByTime(301_000)
+      vi.setSystemTime(1_301_000)
+      $kanbanObservationTick.set($kanbanObservationTick.get() + 1)
     })
     expect(container.querySelector('[data-external-cloud="hollow"]')).not.toBeNull()
     expect(stripe(container)?.getAttribute('aria-label')).toContain('Status unknown on GitHub Actions')
