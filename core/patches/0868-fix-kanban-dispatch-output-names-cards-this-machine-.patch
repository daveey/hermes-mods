From b232537d0a5512be508e735fc0aafef575ef21f6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 01:25:33 +0000
Subject: [PATCH] fix(kanban): dispatch output names cards this machine cannot
 lease and deferred claims [daveey]

Follow-up to c44335f774: `hermes kanban dispatch [--dry-run] [--json]` now prints skipped_ineligible and
claim_deferred (task id + Board reason), so a machine can read back that a card whose runs_on excludes it is
skipped, not spawned (the MacBook readback for the 10-28 review-lane stall).

Test: test_cli_dispatch_dry_run_json_names_ineligible_cards.
---
 hermes_cli/kanban_ops.py                         |  7 +++++++
 tests/hermes_cli/test_kanban_runs_on_dispatch.py | 14 ++++++++++++++
 2 files changed, 21 insertions(+)

diff --git a/hermes_cli/kanban_ops.py b/hermes_cli/kanban_ops.py
index 46b8af0502..2e9ebc4453 100644
--- a/hermes_cli/kanban_ops.py
+++ b/hermes_cli/kanban_ops.py
@@ -111,6 +111,9 @@ def _cmd_dispatch(args: argparse.Namespace) -> int:
                 for (tid, reason) in res.respawn_guarded
             ],
             "rate_limited": res.rate_limited,
+            # Cards this machine cannot lease (runs_on / placement) and claims the Board deferred. [daveey]
+            "skipped_ineligible": [{"task_id": tid, "reason": reason} for (tid, reason) in res.skipped_ineligible],
+            "claim_deferred": [{"task_id": tid, "reason": reason} for (tid, reason) in res.claim_deferred],
             "shared_blocker_released": res.shared_blocker_released,
             "shared_blocker_probed": res.shared_blocker_probed,
             "skipped_locked": res.skipped_locked,
@@ -158,6 +161,10 @@ def _cmd_dispatch(args: argparse.Namespace) -> int:
         )
     for tid, reason in res.respawn_guarded:
         print(f"Guarded ({reason}): {tid}")
+    for tid, reason in res.skipped_ineligible:
+        print(f"Skipped (this machine cannot lease it: {reason}): {tid}")
+    for tid, reason in res.claim_deferred:
+        print(f"Claim deferred by the Board ({reason}): {tid}")
     if res.rate_limited:
         print(f"Rate-limited (released to ready, no failure counted): {', '.join(res.rate_limited)}")
     if res.shared_blocker_released:
diff --git a/tests/hermes_cli/test_kanban_runs_on_dispatch.py b/tests/hermes_cli/test_kanban_runs_on_dispatch.py
index 87dbd8c013..e3848a5d48 100644
--- a/tests/hermes_cli/test_kanban_runs_on_dispatch.py
+++ b/tests/hermes_cli/test_kanban_runs_on_dispatch.py
@@ -85,6 +85,20 @@ def test_dry_run_never_lists_a_card_this_machine_cannot_lease(gws):
     assert {t for t, _r in res.skipped_ineligible} >= {review, other}
 
 
+def test_cli_dispatch_dry_run_json_names_ineligible_cards(gws):
+    """The MacBook readback: `hermes kanban dispatch --dry-run --json` lists the refused card, not as spawned."""
+    import json
+
+    from hermes_cli import kanban as kcli
+    hub, worker = gws
+    review = _review_card_pinned_to_worker(hub, worker)
+    hub.enter()
+    out = json.loads(kcli.run_slash("dispatch --dry-run --json"))
+    assert review not in [s["task_id"] for s in out["spawned"]]
+    assert {"task_id": review, "reason": "labels_mismatch"} in out["skipped_ineligible"]
+    assert out["claim_deferred"] == []
+
+
 def test_health_probe_does_not_count_ineligible_cards(gws):
     hub, worker = gws
     _review_card_pinned_to_worker(hub, worker)
