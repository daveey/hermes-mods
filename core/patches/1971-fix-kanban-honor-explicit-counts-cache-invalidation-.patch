From c61d9dac756641a9e930a9860a10da30a66e3ae9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 4 Nov 2026 22:07:21 +0000
Subject: [PATCH] fix(kanban): honor explicit counts cache invalidation
 [daveey]

---
 hermes_cli/kanban_counts_scopes.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_counts_scopes.py b/hermes_cli/kanban_counts_scopes.py
index 40c08c9861c..00b16e028ef 100644
--- a/hermes_cli/kanban_counts_scopes.py
+++ b/hermes_cli/kanban_counts_scopes.py
@@ -29,7 +29,11 @@ def remember_locked() -> None:
 def restore_locked(scope: tuple[str, ...]) -> None:
     from hermes_cli import kanban_session_activity as ksa
 
-    if ksa._cache is not None and ksa._cache_scope == scope:
+    if ksa._cache is None:
+        # Dropping the active slot is an explicit invalidation, not a scope miss.
+        _entries.clear()
+        return
+    if ksa._cache_scope == scope:
         if scope in _entries:
             _entries.move_to_end(scope)
         return
-- 
2.55.0

