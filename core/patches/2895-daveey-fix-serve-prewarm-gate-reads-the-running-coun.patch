From 4ce8bd6f46cf966b7c7db5f05fcdf1caee588db6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 17:38:53 +0000
Subject: [PATCH] [daveey] fix(serve): prewarm gate reads the running count and
 names from one pass; reword the bind-deadline comment (review 5879107693
 nits)

---
 hermes_cli/boot_warmup_gate.py            | 13 ++++++---
 tests/hermes_cli/test_boot_warmup_gate.py | 35 +++++++++++++++++++++++
 2 files changed, 44 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/boot_warmup_gate.py b/hermes_cli/boot_warmup_gate.py
index 8804dce1f2..20b29b060a 100644
--- a/hermes_cli/boot_warmup_gate.py
+++ b/hermes_cli/boot_warmup_gate.py
@@ -33,8 +33,10 @@ log = logging.getLogger(__name__)
 ALWAYS_ON_WARMUP_BUDGET_S = 6.0
 # ...and ends this many seconds after process start, whichever comes first. Boot to bind on hermes-hub measured
 # 11.4-18.4 s (median ~14 s) over 30 restarts on 2026-11-12, so a fixed 6 s on top of a slow boot would bind past
-# Desktop's 20 s always-on attach window (``ALWAYS_ON_RESTART_WAIT_MS``). That window opens when Desktop sees the old
-# process gone, before the supervisor has started this one, so the deadline keeps ~3 s of slack for the restart.
+# Desktop's 20 s always-on attach window (``ALWAYS_ON_RESTART_WAIT_MS``). That window is not measured from the old
+# process's exit: it starts in ``connectAlwaysOn``, after Desktop has noticed the drop and run its SSH preflight.
+# Under core's systemd unit (``RestartSec=5``) a capped bind can land 5 + 17 = 22 s after the old process exits, so
+# the fit relies on that detection + preflight time, not on slack inside this deadline.
 ALWAYS_ON_BIND_DEADLINE_S = 17.0
 # A process older than this at the gate is not a fresh boot (or its start time is wrong): use the plain budget.
 _MAX_PLAUSIBLE_BOOT_S = 300.0
@@ -124,12 +126,15 @@ def hold_bind_for_prewarm(budget_s: Optional[float] = None) -> Optional[tuple[fl
         threads = boot_prewarm_threads()
         age = process_age_s()
         budget = warmup_budget_s(age) if budget_s is None else budget_s
-        elapsed, running = join_within(threads, budget)
+        elapsed, _ = join_within(threads, budget)
         age_note = "?" if age is None else f"{age:.1f}s"
+        # Count and names from one is_alive pass, so a prewarm finishing after the join can't skew the line.
+        names = running_prewarm_names(threads)
+        running = len(names)
         if running:
             log.info("always-on dashboard: boot prewarm budget spent after %.2fs of %.2fs (process age %s at gate; "
                      "%d thread(s), %d still running: %s); binding", elapsed, budget, age_note, len(threads),
-                     running, ", ".join(running_prewarm_names(threads)))
+                     running, ", ".join(names))
         else:
             log.info("always-on dashboard: boot prewarm finished after %.2fs of %.2fs (process age %s at gate; "
                      "%d thread(s)); binding", elapsed, budget, age_note, len(threads))
diff --git a/tests/hermes_cli/test_boot_warmup_gate.py b/tests/hermes_cli/test_boot_warmup_gate.py
index f9ac8b5c59..08d6f81676 100644
--- a/tests/hermes_cli/test_boot_warmup_gate.py
+++ b/tests/hermes_cli/test_boot_warmup_gate.py
@@ -130,6 +130,41 @@ def test_budget_spent_line_names_the_prewarms_still_running(monkeypatch, caplog)
     assert "2 still running: board, project tree); binding" in line, line
 
 
+def test_budget_spent_count_matches_the_names_it_lists(monkeypatch, caplog):
+    # A prewarm that finishes between the join and the naming pass must not leave "2 still running: board".
+    monkeypatch.setenv(ENV_FLAG, "1")
+    release = threading.Event()
+    board = threading.Thread(target=release.wait, args=(10,), daemon=True, name="kanban-board-prewarm")
+    finished = threading.Thread(target=lambda: None, name="kanban-annotation-prewarm")
+    for thread in (board, finished):
+        thread.start()
+    finished.join(5)
+    monkeypatch.setattr(gate, "boot_prewarm_threads", lambda: [board, finished])
+    monkeypatch.setattr(gate, "join_within", lambda threads, budget_s: (budget_s, 2))  # both alive at the join
+    try:
+        with caplog.at_level("INFO", logger=gate.log.name):
+            result = gate.hold_bind_for_prewarm(budget_s=0.1)
+        assert result is not None and result[1] == 1
+    finally:
+        release.set()
+    line = next(r.getMessage() for r in caplog.records if "binding" in r.getMessage())
+    assert "1 still running: board); binding" in line, line
+
+
+def test_all_prewarms_done_by_the_naming_pass_logs_finished(monkeypatch, caplog):
+    monkeypatch.setenv(ENV_FLAG, "1")
+    finished = threading.Thread(target=lambda: None, name="kanban-board-prewarm")
+    finished.start()
+    finished.join(5)
+    monkeypatch.setattr(gate, "boot_prewarm_threads", lambda: [finished])
+    monkeypatch.setattr(gate, "join_within", lambda threads, budget_s: (budget_s, 1))
+    with caplog.at_level("INFO", logger=gate.log.name):
+        result = gate.hold_bind_for_prewarm(budget_s=0.1)
+    assert result is not None and result[1] == 0
+    line = next(r.getMessage() for r in caplog.records if "binding" in r.getMessage())
+    assert "boot prewarm finished after" in line and "still running" not in line, line
+
+
 def test_annotation_boot_thread_reports_its_current_step(monkeypatch):
     from hermes_cli import projects_tree_prewarm
 
