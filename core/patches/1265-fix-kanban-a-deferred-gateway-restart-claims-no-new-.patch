From bd96e0118582be18c76663184359c30dfd1fd5bb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 14:13:28 +0000
Subject: [PATCH] fix(kanban): a deferred gateway restart claims no new Kanban
 cards [daveey]

With hermes-sync's 20 min claim hold lifted (GATEWAY_RESTART_SAFE), the
embedded dispatcher kept claiming during request_restart's after-turn wait.
The draining owner refuses those workers anyway; each claim only adds a
run the restart must carry. Spawns are suppressed (wake probes, promotion
and reclaim still run) while _restart_requested; a cancelled restart
clears it.
---
 gateway/kanban_watchers.py            |  6 ++++++
 tests/agent/test_core_update_drain.py | 16 +++++++++++++++-
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/gateway/kanban_watchers.py b/gateway/kanban_watchers.py
index fe269f469c1..f958856a7ac 100644
--- a/gateway/kanban_watchers.py
+++ b/gateway/kanban_watchers.py
@@ -332,6 +332,12 @@ class GatewayKanbanWatchersMixin:
                     # Core-update drain hold: spawns only are suppressed; wake probes,
                     # promotion and reclaim keep running. [daveey]
                     gate = _kanban_dispatch_gate()
+                    if gate is None and getattr(self, "_restart_requested", False):
+                        # A deferred restart (``request_restart``'s after-turn wait) claims nothing new
+                        # either: the draining owner refuses a new worker anyway, and with no hermes-sync
+                        # claim hold (core declares GATEWAY_RESTART_SAFE) a claim made now only adds a
+                        # run the restart must carry. A cancelled restart clears the flag. [daveey]
+                        gate = "drain"
                     if gate == "estop":
                         bad_ticks = 0
                     elif gate == "drain":
diff --git a/tests/agent/test_core_update_drain.py b/tests/agent/test_core_update_drain.py
index a9cf7ee91a4..f5525847410 100644
--- a/tests/agent/test_core_update_drain.py
+++ b/tests/agent/test_core_update_drain.py
@@ -111,7 +111,7 @@ def _dispatcher_board(tmp_path, monkeypatch):
     return dict(parent=parent, child=child, ready=ready, parked=parked), spawned
 
 
-def _run_one_tick(tmp_path, monkeypatch):
+def _run_one_tick(tmp_path, monkeypatch, *, restart_requested=False):
     import asyncio
 
     from gateway import kanban_watchers as watchers
@@ -129,6 +129,7 @@ def _run_one_tick(tmp_path, monkeypatch):
     monkeypatch.setattr(kwc, "run_due_wake_checks", probe)
     runner = watchers.GatewayKanbanWatchersMixin()
     runner._running = True
+    monkeypatch.setattr(runner, "_restart_requested", restart_requested, raising=False)
     cfg = {"auto_decompose": False, "dispatch_interval_seconds": 1}
     monkeypatch.setattr(runner, "_kanban_dispatcher_boot", lambda: (lambda: {"kanban": cfg}, kb, cfg))
 
@@ -176,6 +177,19 @@ def test_without_hold_the_same_tick_claims(tmp_path, monkeypatch):
     assert _statuses(ids)["ready"] == "running"
 
 
+def test_a_deferred_restart_claims_nothing_but_keeps_wake_probes_and_promotion(tmp_path, monkeypatch):
+    """With no hermes-sync hold (core declares GATEWAY_RESTART_SAFE), the gateway's own deferred restart
+    must not claim: each claim would add a run the after-turn wait has to carry. [daveey]"""
+    monkeypatch.setattr(drain, "_hermes_home", lambda: tmp_path)
+    monkeypatch.setattr(drain, "_canonical_root", lambda: tmp_path)
+    ids, spawned = _dispatcher_board(tmp_path, monkeypatch)
+    probes = _run_one_tick(tmp_path, monkeypatch, restart_requested=True)
+    assert [ids["parked"]] in probes
+    st = _statuses(ids)
+    assert st["parked"] == "ready" and st["child"] == "ready"
+    assert st["ready"] == "ready" and spawned == []
+
+
 def test_estop_still_skips_the_whole_tick(tmp_path, monkeypatch):
     monkeypatch.setattr(drain, "_hermes_home", lambda: tmp_path)
     monkeypatch.setattr(drain, "_canonical_root", lambda: tmp_path)
