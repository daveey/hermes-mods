From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:39:35 +0000
Subject: [PATCH] [daveey] Test origin snapshot cleanup when WAL setup fails

Retain the actual SQLite connection through OperationalError and KeyboardInterrupt propagation and assert it is already closed. Production is unchanged. Proof: focused canonical suite 7 passed, zero skips; exact M6 removal of the exception-path close killed (2 failed, 5 passed) via sdlc-review mutants.py; scripts/check 20 checks ok.
---
 .../test_kanban_origin_snapshot_wal.py        | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_origin_snapshot_wal.py b/tests/hermes_cli/test_kanban_origin_snapshot_wal.py
index 9395fae052..0a4e06ee5a 100644
--- a/tests/hermes_cli/test_kanban_origin_snapshot_wal.py
+++ b/tests/hermes_cli/test_kanban_origin_snapshot_wal.py
@@ -70,6 +70,31 @@ def test_existing_rollback_journal_snapshot_is_upgraded_on_the_next_save(home):
     assert activity._remote_snapshot() == [card()]
 
 
+@pytest.mark.parametrize('error_type', [sqlite3.OperationalError, KeyboardInterrupt])
+def test_wal_setup_failure_closes_connection_before_reraise(home, monkeypatch, error_type):
+    from hermes_cli import kanban_session_activity_origin_snapshot as snapshot
+
+    retained = []  # Keep the actual connection alive so GC cannot hide a missing close.
+    failure = error_type('WAL setup failed')
+
+    def fail_wal(conn):
+        retained.append(conn)
+        assert conn.execute('SELECT 1').fetchone() == (1,)
+        raise failure
+
+    monkeypatch.setattr(snapshot, '_use_wal', fail_wal)
+    try:
+        with pytest.raises(error_type) as raised:
+            snapshot.remote_snapshot([card()])
+        assert raised.value is failure
+        assert len(retained) == 1
+        with pytest.raises(sqlite3.ProgrammingError, match='closed database'):
+            retained[0].execute('SELECT 1')
+    finally:
+        for conn in retained:
+            conn.close()
+
+
 def guard_spy(monkeypatch):
     from hermes_cli import kanban_lockguard
     seen = []
