From b3ada5e8f83a36256be468b44b6dc3e75b1c4105 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 24 Nov 2026 02:25:10 +0000
Subject: [PATCH 6033] Kanban chat links, adoption provenance and rejected-retain archive

Public mirror of source commit b3ada5e8f83a36256be468b44b6dc3e75b1c4105.

---
diff --git a/hermes_cli/kanban_chat_links.py b/hermes_cli/kanban_chat_links.py
index a17e22d08f8..5b76aca701e 100644
--- a/hermes_cli/kanban_chat_links.py
+++ b/hermes_cli/kanban_chat_links.py
@@ -86,7 +86,9 @@
     created = [dict(r) for r in conn.execute(
         "SELECT l.* FROM task_chat_links l WHERE l.chat_gateway=? AND l.kind='created' "
         "AND EXISTS (SELECT 1 FROM task_events e WHERE e.task_id=l.task_id "
-        "AND e.kind='creator_chats_resolved')", (gateway,))] if has_links else []
+        "AND e.kind='creator_chats_resolved' AND (COALESCE(json_extract(e.payload,'$.local_adoption'),0)!=1 "
+        "OR json_extract(e.payload,'$.explicit_origin') = '@session:' || COALESCE(NULLIF(l.chat_profile,''),'default') "
+        "|| '@' || l.chat_gateway || '/' || l.chat_session))", (gateway,))] if has_links else []
     # Cards this gateway owns (a picked-up foreign copy keeps the owner's answer, see _owner_written_releases).
     foreign = {r[0] for r in conn.execute(
         "SELECT id FROM tasks WHERE created_on IS NOT NULL AND created_on != '' AND created_on != ?", (gateway,))} \
diff --git a/hermes_cli/kanban_local_adoption.py b/hermes_cli/kanban_local_adoption.py
index 6caceba2963..4bb3c53c7aa 100644
--- a/hermes_cli/kanban_local_adoption.py
+++ b/hermes_cli/kanban_local_adoption.py
@@ -84,7 +84,8 @@
 def _confer_created_ownership(conn, task_id: str, sid: str, me: str, profile: str) -> None:
     """Durable, sync-compatible ownership, the same shape an explicit courier origin writes
     (``kanban_creator_chats``): an unreleased ``created`` link plus a ``creator_chats_resolved`` event, which is what
-    keeps :func:`kanban_chat_links._local_links` wanting the link, so reconcile preserves it. ``tasks.session_id`` is
+    keeps :func:`kanban_chat_links._local_links` wanting only its explicit-origin link, not unrelated released
+    owners, so reconcile preserves it. ``tasks.session_id`` is
     not touched. Runs only after the conflict checks, in their transaction. A chat that released this card (here or
     upstream) is never silently re-owned; the write is idempotent."""
     from hermes_cli import kanban_db as kb
diff --git a/tests/hermes_cli/test_kanban_local_adoption_authority.py b/tests/hermes_cli/test_kanban_local_adoption_authority.py
index 4987304764e..b893af4b37a 100644
--- a/tests/hermes_cli/test_kanban_local_adoption_authority.py
+++ b/tests/hermes_cli/test_kanban_local_adoption_authority.py
@@ -227,6 +227,30 @@
                     actor(conn, tid)
 
 
+@pytest.mark.parametrize('old_profile', [None, 'default', 'builder'])
+def test_adopting_fresh_chat_preserves_other_released_owner(world, capsys, old_profile):
+    conn, tid, home = world
+    old = '20261123_121212_aaaaaa'
+    with sqlite3.connect(home / 'state.db') as db:
+        db.execute("INSERT INTO sessions VALUES (?,'desktop','desktop')", (old,))
+    with kb.write_txn(conn):
+        conn.execute(
+            "INSERT INTO task_chat_links "
+            "(uid,task_id,chat_gateway,chat_profile,chat_session,kind,released,created_at) "
+            "VALUES (?,?,?,?,?,'created',1,1)",
+            (chat_links.link_uid(tid, GW, old_profile, old, 'created'), tid, GW, old_profile, old))
+    with pytest.raises(RenewalRefused):
+        actor(conn, tid, old)
+    assert adopt(tid, capsys)['adopted']
+    for _ in range(2):
+        chat_links.reconcile(conn, 'default', GW, ledger=False)
+        assert actor(conn, tid).authority == 'chat'
+        previous = [row for row in links(conn, tid) if row['chat_session'] == old]
+        assert [row['released'] for row in previous] == [1]
+        with pytest.raises(RenewalRefused):
+            actor(conn, tid, old)
+
+
 def test_adoption_does_not_authorize_another_chat(world, capsys):
     conn, tid, _ = world
     assert adopt(tid, capsys)['adopted'] is True
