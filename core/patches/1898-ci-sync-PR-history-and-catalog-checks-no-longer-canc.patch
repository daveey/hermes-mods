From 207e594b603fb4342de18be516a761c6b50bf900 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 14:28:13 -0800
Subject: [PATCH] ci: sync-PR history and catalog checks no longer cancel at
 their timeouts

check-common-ancestor's full-blob checkout of the fork outran the 10-min
fast-lane cap; merge-base needs only commits, so use filter: blob:none.
pinned-source-validate re-validates every catalog entry an upstream sync
touches (126 here, ~18 s each) and hit its 30-min cap at entry 88; raise it to 75.
---
 .github/workflows/history-check.yml     | 3 +++
 .github/workflows/plugin-catalog-ci.yml | 4 +++-
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/history-check.yml b/.github/workflows/history-check.yml
index 6b356e2346a..a4e93fb2f0b 100644
--- a/.github/workflows/history-check.yml
+++ b/.github/workflows/history-check.yml
@@ -39,6 +39,9 @@ jobs:
         with:
           ref: ${{ inputs.commit }}
           fetch-depth: 0 # full history both sides for merge-base
+          # [daveey] merge-base needs only the commit graph; a full-blob clone of
+          # the ~1 GB fork outran the 10-min fast-lane cap on fresh runners.
+          filter: blob:none
 
       - id: merge-base-check
         name: Reject PRs with no common ancestor on main
diff --git a/.github/workflows/plugin-catalog-ci.yml b/.github/workflows/plugin-catalog-ci.yml
index 9d047dfa086..0c4defb4059 100644
--- a/.github/workflows/plugin-catalog-ci.yml
+++ b/.github/workflows/plugin-catalog-ci.yml
@@ -152,7 +152,9 @@ jobs:
     # and fails the image build unless the runner user can start bwrap. The
     # sandbox step below proves it on every run and fails closed if not.
     runs-on: [self-hosted, hermes-hub]
-    timeout-minutes: 30
+    # [daveey] An upstream sync re-validates every catalog entry upstream
+    # touched (126 in the c314285 sync, ~18 s each): 30 min cancelled it at 88.
+    timeout-minutes: 75
     steps:
       - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a  # v7.0.1 (fork: upstream uses useblacksmith/checkout)
         with:
-- 
2.55.0

