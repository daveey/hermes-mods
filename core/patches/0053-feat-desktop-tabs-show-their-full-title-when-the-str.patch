From 49fce9a12ca2dab9842a84d451169fb2f4093b0a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 14 Oct 2026 10:57:20 -0700
Subject: [PATCH] feat(desktop): tabs show their full title when the strip has
 room [daveey]

Horizontal pane tabs were capped at max-w-48 (12rem), clipping session
titles even with an empty strip. Drop the cap and let tabs shrink instead:
each tab sizes to its label, shrinks when the strip is crowded, and floors
at min(label width, 8rem) (closeable: clamp 3.25rem..8rem) via calc-size(),
so short labels keep their natural width. Past the floors the strip scrolls.
---
 apps/desktop/src/components/ui/pane-tab.tsx | 11 +++++------
 apps/desktop/src/styles.css                 | 13 +++++++++++++
 2 files changed, 18 insertions(+), 6 deletions(-)

diff --git a/apps/desktop/src/components/ui/pane-tab.tsx b/apps/desktop/src/components/ui/pane-tab.tsx
index 6999705fd3..d39d8a5ffa 100644
--- a/apps/desktop/src/components/ui/pane-tab.tsx
+++ b/apps/desktop/src/components/ui/pane-tab.tsx
@@ -19,11 +19,11 @@ const TAB =
 
 // Full height: with the strip's rule removed there is no last-pixel row to
 // leave uncovered, so tabs fill the bar and no sliver of gutter shows through.
-const TAB_HORIZONTAL = 'h-full min-w-0 max-w-48 not-first:border-l not-first:border-l-(--ui-stroke-quaternary)'
-
-// A closeable tab's floor keeps short labels left of the close button.
-// A floor, not padding — a tab already wider than it pays nothing.
-const TAB_CLOSEABLE = 'min-w-13'
+// [daveey] No width cap: a tab shows its full label while the strip has room
+// and shrinks (shrink, not shrink-0) once it doesn't. The floor —
+// min(label width, 8rem), plus the closeable floor — lives in styles.css
+// (`calc-size()` has no Tailwind utility); past it the strip scrolls.
+const TAB_HORIZONTAL = 'h-full shrink not-first:border-l not-first:border-l-(--ui-stroke-quaternary)'
 
 const TAB_VERTICAL =
   'w-full max-h-48 justify-center not-first:border-t not-first:border-t-(--ui-stroke-quaternary) [writing-mode:vertical-rl]'
@@ -102,7 +102,6 @@ export const PaneTab = React.forwardRef<HTMLDivElement, PaneTabProps>(function P
       className={cn(
         TAB,
         vertical ? TAB_VERTICAL : TAB_HORIZONTAL,
-        !vertical && onClose && TAB_CLOSEABLE,
         edge,
         active
           ? cn(TAB_ACTIVE, !vertical && TAB_ACTIVE_UNDERLINE)
diff --git a/apps/desktop/src/styles.css b/apps/desktop/src/styles.css
index 219de06112..3169d9a416 100644
--- a/apps/desktop/src/styles.css
+++ b/apps/desktop/src/styles.css
@@ -1744,6 +1744,19 @@ body.guest-pointer-lock :is(webview, iframe) {
   --pane-tab-close-width: 1.5rem;
 }
 
+/* [daveey] Horizontal tabs grow to their full label and shrink when the strip
+   runs out of room — but never below min(label width, 8rem), so a short label
+   keeps its natural width and a long one stays readable. A closeable tab's
+   floor (3.25rem) keeps short labels left of its hover close button. Past the
+   floors the strip scrolls. */
+[data-slot='pane-tab']:not([data-vertical]) {
+  min-width: calc-size(max-content, min(size, 8rem));
+}
+
+[data-slot='pane-tab'][data-closeable]:not([data-vertical]) {
+  min-width: calc-size(max-content, clamp(3.25rem, size, 8rem));
+}
+
 [data-slot='pane-tab'][data-closeable]:hover > .pane-tab-content {
   mask-image: linear-gradient(
     to right,
-- 
