From d98f7e805610b5dbb5994127a4cff739db50b958 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 12:02:12 +0000
Subject: [PATCH] fix(desktop): pin retained-Kanban reads without growing
 gateway.ts

primaryGatewayConnectionId('pin') returns the real primary id or null, so a
remote-primary window does not pass the 'local' fallback that makes Electron
cold-start a local hermes serve. gateway.ts stays at its main line cap.
---
 .../session/hooks/use-session-list-actions.ts  |  4 ++--
 apps/desktop/src/store/gateway.ts              | 18 +++---------------
 2 files changed, 5 insertions(+), 17 deletions(-)

diff --git a/apps/desktop/src/app/session/hooks/use-session-list-actions.ts b/apps/desktop/src/app/session/hooks/use-session-list-actions.ts
index c8e3df5e0e7..c9208344587 100644
--- a/apps/desktop/src/app/session/hooks/use-session-list-actions.ts
+++ b/apps/desktop/src/app/session/hooks/use-session-list-actions.ts
@@ -9,7 +9,7 @@ import {
   SIDEBAR_EXCLUDED_SOURCES
 } from '@/lib/session-source'
 import { markSidebarLive } from '@/store/boot-snapshot'
-import { gatewayActivationEpoch, primaryGatewayConnectionId, primaryGatewayConnectionPin } from '@/store/gateway'
+import { gatewayActivationEpoch, primaryGatewayConnectionId } from '@/store/gateway'
 import {
   $pinnedSessionIds,
   $sessionsLimit,
@@ -425,7 +425,7 @@ export function useSessionListActions({ profileScope }: UseSessionListActionsArg
         do {
           activationEpoch = gatewayActivationEpoch()
           primaryConnection = primaryGatewayConnectionId()
-          const primaryPin = primaryGatewayConnectionPin()
+          const primaryPin = primaryGatewayConnectionId('pin')
           result = await fetchPage()
 
           if (!owns()) { return }
diff --git a/apps/desktop/src/store/gateway.ts b/apps/desktop/src/store/gateway.ts
index af8876ddaf3..e7654000aff 100644
--- a/apps/desktop/src/store/gateway.ts
+++ b/apps/desktop/src/store/gateway.ts
@@ -574,21 +574,9 @@ export function pendingSessionReplay(runtimeId: string): Promise<boolean> | unde
   return pending.length ? Promise.all(pending).then(results => results.every(Boolean)) : undefined
 }
 
-/** Owner of untagged unified-list rows, never the foreground secondary. */
-export function primaryGatewayConnectionId(): string {
-  return g.primaryConnectionId ?? 'local'
-}
-
-/**
- * The primary's registry connection id when it HAS one, else null. Unlike
- * primaryGatewayConnectionId() this is safe to send as a request pin: its
- * 'local' fallback names the "This device" registry entry, which Electron
- * force-spawns a local backend for when the window's primary is a remote
- * (env override / legacy global remote) — so a window talking to a remote
- * would start a second, local `hermes serve` the user never asked for.
- */
-export function primaryGatewayConnectionPin(): null | string {
-  return g.primaryConnectionId
+/** Untagged-row owner. `'pin'` omits the 'local' fallback that force-spawns a local serve. */
+export function primaryGatewayConnectionId(mode?: 'pin'): null | string {
+  return mode === 'pin' ? g.primaryConnectionId : (g.primaryConnectionId ?? 'local')
 }
 
 /**
-- 
