+        occupied_count = len(occupied) + max(0, active - len(active_owners))
+        if occupied_count >= cap:
             return 'worker_capacity_full'
         return None
     except Exception:  # health: allow BLE001 -- any unreadable policy/controller must refuse claims
diff --git a/tests/hermes_cli/test_worker_account_admission.py b/tests/hermes_cli/test_worker_account_admission.py
new file mode 100644
index 0000000000..e03178fe31
--- /dev/null
+++ b/tests/hermes_cli/test_worker_account_admission.py
@@ -0,0 +1,92 @@
+"""Account capacity serializes installation roots through real SQL commit."""
+import sqlite3
+
+import pytest
+
+from hermes_cli import admission_fence as fence
+from hermes_cli import kanban_admission as admission
+from hermes_cli import worker_compute_capacity as capacity
+
+
+@pytest.fixture
+def account(monkeypatch, tmp_path):
+    root = tmp_path / 'account'
+    root.mkdir()
+    monkeypatch.setattr(capacity, 'policy_root', lambda: root)
+    monkeypatch.setattr(capacity, 'worker_enabled', lambda: True)
+    monkeypatch.setattr(admission, '_final_hub_gate', lambda *a: (None, None))
+    return root
+
+
+def connection(path):
+    conn = sqlite3.connect(path)
+    conn.execute('CREATE TABLE sample (value INTEGER)')
+    conn.commit()
+    return conn
+
+
+def test_two_installations_share_account_lock_through_commit(account, monkeypatch, tmp_path):
+    import hermes_constants
+    first = connection(tmp_path / 'one.db')
+    second = connection(tmp_path / 'two.db')
+    try:
+        monkeypatch.setattr(hermes_constants, 'get_default_hermes_root', lambda: tmp_path / 'install-one')
+        with admission.claim_transaction(first) as accepted:
+            assert accepted
+            first.execute('INSERT INTO sample VALUES (1)')
+            monkeypatch.setattr(hermes_constants, 'get_default_hermes_root', lambda: tmp_path / 'install-two')
+            with admission.claim_transaction(second) as other:
+                assert not other
+            with pytest.raises(fence.AdmissionBusy):
+                with fence.admission_lock(account, timeout=0):
+                    pass
+        with fence.admission_lock(account, timeout=0):
+            assert first.execute('SELECT * FROM sample').fetchall() == [(1,)]
+        with admission.claim_transaction(second) as accepted:
+            assert accepted
+    finally:
+        first.close()
+        second.close()
+
+
+def test_account_lock_released_after_rollback(account, monkeypatch, tmp_path):
+    import hermes_constants
+    monkeypatch.setattr(hermes_constants, 'get_default_hermes_root', lambda: tmp_path / 'installation')
+    conn = connection(tmp_path / 'rollback.db')
+    try:
+        with pytest.raises(RuntimeError, match='rollback'):
+            with admission.claim_transaction(conn) as accepted:
+                assert accepted
+                conn.execute('INSERT INTO sample VALUES (1)')
+                raise RuntimeError('rollback')
+        assert conn.execute('SELECT * FROM sample').fetchall() == []
+        with fence.admission_lock(account, timeout=0):
+            pass
+    finally:
+        conn.close()
+
+
+def test_same_account_and_installation_does_not_self_contend(account, monkeypatch, tmp_path):
+    import hermes_constants
+    monkeypatch.setattr(hermes_constants, 'get_default_hermes_root', lambda: account)
+    conn = connection(tmp_path / 'same.db')
+    try:
+        with admission.claim_transaction(conn) as accepted:
+            assert accepted
+    finally:
+        conn.close()
+
+
+def test_installation_update_hold_still_refuses(account, monkeypatch, tmp_path):
+    import hermes_constants
+    root = tmp_path / 'installation'
+    marker = root / 'core-update' / 'holds' / 'hermes-sync'
+    marker.parent.mkdir(parents=True)
+    marker.touch()
+    monkeypatch.setattr(hermes_constants, 'get_default_hermes_root', lambda: root)
+    conn = connection(tmp_path / 'held.db')
+    try:
+        with admission.claim_transaction(conn) as accepted:
+            assert not accepted
+    finally:
+        conn.close()
diff --git a/tests/hermes_cli/test_worker_account_boards.py b/tests/hermes_cli/test_worker_account_boards.py
new file mode 100644
index 0000000000..5fd5f2b1f0
--- /dev/null
+++ b/tests/hermes_cli/test_worker_account_boards.py
@@ -0,0 +1,54 @@
+"""Registered installation boards remain visible across dispatcher roots."""
+import sqlite3
+
+import pytest
+
+from hermes_cli import worker_account_boards as inventory
+from hermes_cli import worker_compute_capacity as capacity
+from hermes_cli import machine_metrics, kanban_db as kb
+
+
+def test_registered_foreign_board_counts_after_installation_changes(monkeypatch, tmp_path):
+    account = tmp_path / 'account'
+    account.mkdir()
+    monkeypatch.setattr(capacity, 'policy_root', lambda: account)
+    foreign = tmp_path / 'foreign' / 'kanban.db'
+    foreign.parent.mkdir()
+    conn = sqlite3.connect(foreign)
+    conn.execute('CREATE TABLE tasks (id TEXT, status TEXT)')
+    conn.execute("INSERT INTO tasks VALUES ('t_foreign', 'running')")
+    conn.commit()
+    try:
+        inventory.register(conn)
+        inventory.register(conn)
+        monkeypatch.setattr(kb, 'kanban_home', lambda: account)
+        monkeypatch.setattr('hermes_cli.kanban_db_boards.named_board_db_files', list)
+        owners = set()
+        assert machine_metrics.active_card_runs(extra_paths=inventory.paths(), owner_output=owners) == 1
+        assert owners == {('default', 't_foreign')}
+        assert machine_metrics.active_card_runs(extra_paths=[foreign, foreign]) == 1
+    finally:
+        conn.close()
+    foreign.unlink()
+    with pytest.raises(FileNotFoundError):
+        inventory.paths()
+
+
+@pytest.mark.parametrize('raw', ['{broken', '7', '"relative.db"'])
+def test_corrupt_inventory_fails_closed(monkeypatch, tmp_path, raw):
+    monkeypatch.setattr(capacity, 'policy_root', lambda: tmp_path)
+    records = tmp_path / 'worker-resources' / 'boards'
+    records.mkdir(parents=True)
+    (records / 'bad.json').write_text(raw)
+    with pytest.raises(ValueError):
+        inventory.paths()
+
+
+def test_unregistered_account_boards_count(monkeypatch, tmp_path):
+    monkeypatch.setattr(capacity, 'policy_root', lambda: tmp_path)
+    default = tmp_path / 'kanban.db'
+    default.touch()
+    named = tmp_path / 'kanban' / 'boards' / 'other' / 'kanban.db'
+    named.parent.mkdir(parents=True)
+    named.touch()
+    assert set(inventory.paths()) == {default, named}
diff --git a/tests/hermes_cli/test_worker_resource_admission.py b/tests/hermes_cli/test_worker_resource_admission.py
index e15bddab8d..6f634a3607 100644
--- a/tests/hermes_cli/test_worker_resource_admission.py
+++ b/tests/hermes_cli/test_worker_resource_admission.py
@@ -130,3 +130,26 @@ def test_worker_brake_is_not_bypassed_by_disabled_hub(monkeypatch, tmp_path):
     assert admission._final_hub_gate(None)[0] == 'worker_load_pressure'
     state = tmp_path / 'worker-resources' / 'pressure.json'
     assert json.loads(state.read_text())['held'] is True
+
+
+@pytest.mark.parametrize('expired,slow', [(True, False), (False, True), (False, False)])
+def test_worker_only_final_deadline_and_budget(worker_rig, monkeypatch, expired, slow):
+    import time
+    from types import SimpleNamespace
+    from hermes_cli import machine_cpu_metrics as cpu
+    monkeypatch.setattr(cpu, 'root_limit', lambda: (cpu.OFF, None))
+    gate = SimpleNamespace(expires=time.time() + (-10 if expired else 60))
+    started = time.monotonic() - (10 if slow else 0)
+    reason, _ = admission._final_hub_gate(gate, started)
+    assert reason == ('worker_resources_unknown' if expired or slow else None)
+
+
+def test_policy_enabled_after_lock_selection_refuses(worker_rig, monkeypatch):
+    from hermes_cli import machine_cpu_metrics as cpu
+    rig, _ = worker_rig
+    monkeypatch.setattr(cpu, 'root_limit', lambda: (cpu.OFF, None))
+    observations = iter([False, True])
+    monkeypatch.setattr(capacity, 'worker_enabled', lambda: next(observations))
+    with admission.claim_transaction(rig.conn) as accepted:
+        assert not accepted
+
