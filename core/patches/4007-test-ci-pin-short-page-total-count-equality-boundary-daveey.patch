From 2d10b4402f5bc4dd06274e0f661f9ba5eea2c723 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 01:33:18 +0000
Subject: [PATCH] test(ci): pin short-page total-count equality boundary
 [daveey]

Cover short pages at exact offset == total_count below and at MAX_RUN_PAGES. The >= to > mutant fails both new cases (23 passed, 2 failed); production passes all 25 with no skips. No production changes or mini dispatch.
---
 tests/ci/test_macos_os_tests_workflow.py | 26 ++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/tests/ci/test_macos_os_tests_workflow.py b/tests/ci/test_macos_os_tests_workflow.py
index d963c779e5..b2f57a01ef 100644
--- a/tests/ci/test_macos_os_tests_workflow.py
+++ b/tests/ci/test_macos_os_tests_workflow.py
@@ -163,6 +163,32 @@ def test_final_supported_page_is_read_before_deciding_saturation(final_job):
         ) == 1
 
 
+@pytest.mark.parametrize("at_cap", [False, True], ids=["below-cap", "at-cap"])
+def test_short_page_stops_when_offset_equals_total_count(at_cap):
+    gate = _gate()
+    gate.PAGE_SIZE = 2
+    final_page = gate.MAX_RUN_PAGES if at_cap else 2
+    calls: list[str] = []
+    pages = [[{"id": 2 * p + 1}, {"id": 2 * p + 2}] for p in range(final_page - 1)]
+    pages.append([{"id": 2 * final_page - 1}])
+    listing = _paged_api({"queued": pages}, {}, calls)
+
+    def api(path):
+        response = listing(path)
+        if "status=queued" in path:
+            # Filtered pages can contain fewer rows than the reported offset total.
+            response["total_count"] = final_page * gate.PAGE_SIZE
+        return response
+
+    assert gate.decide("schedule", api, REPO, own_run_id=0) == (
+        True, "no job waiting for the mini"
+    )
+    prefix = f"repos/{REPO}/actions/runs?status=queued&per_page={gate.PAGE_SIZE}&page="
+    assert [c for c in calls if c.startswith(prefix)] == [
+        f"{prefix}{page}" for page in range(1, final_page + 1)
+    ] * 2
+
+
 @pytest.mark.parametrize("reported_total", [None, 45])
 def test_short_nonterminal_page_does_not_hide_a_waiting_mini_job(reported_total):
     gate = _gate()
