diff --git a/tests/tools/test_clarify_early_bound.py b/tests/tools/test_clarify_early_bound.py
new file mode 100644
index 0000000000..51930f806f
--- /dev/null
+++ b/tests/tools/test_clarify_early_bound.py
@@ -0,0 +1,135 @@
+"""Bound early answers: a decision ends a blocked clarify only for the exact question it was bound to.
+
+Session matching alone (the pre-binding contract) let any undelivered decision of the same session end an unrelated
+clarify. Here a provider that declares ``accepts_question`` receives the exact displayed question descriptor and
+must echo its digest and tool call; legacy decision answers are ignored for a bound question, while a legacy
+withdrawal that answers nothing (the update pause) still works.
+"""
+
+import json
+import threading
+
+import pytest
+
+from tools import clarify_early
+from tools.clarify_tool import clarify_tool
+
+QUESTIONS = [{"question": "Which runner?", "choices": ["canary", "aws"]}]
+WAIT_S = 10
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch):
+    monkeypatch.setattr(clarify_early, "POLL_INTERVAL_S", 0.05)
+    clarify_early.reset_for_tests()
+    yield
+    clarify_early.reset_for_tests()
+
+
+class Blocking:
+    def __init__(self):
+        self.event = threading.Event()
+        self.entered = threading.Event()
+        self.calls = 0
+
+    def __call__(self, questions):
+        self.calls += 1
+        self.entered.set()
+        self.event.wait(WAIT_S)
+        return {"answers": {}, "outcome": "cancelled"}
+
+    def cancel_early(self, reason):
+        self.event.set()
+        return True
+
+
+def _decision_answer(commits, binding=None):
+    result = {"status": "answered_elsewhere", "decisions": [{"requestId": "r1", "title": "Which runner?",
+                                                             "choice": "canary"}]}
+    if binding is not None:
+        result["binding"] = binding
+    return clarify_early.EarlyAnswer(result, commit=lambda: commits.append("done"))
+
+
+def test_descriptor_is_the_exact_ordered_snapshot_with_a_stable_digest():
+    a = clarify_early.question_descriptor([{"question": "Q", "choices_offered": ["x", "y"]}], "call_1")
+    b = clarify_early.question_descriptor([{"question": "Q", "choices_offered": ["y", "x"]}], "call_1")
+    assert a["questions"] == [{"question": "Q", "choices": ["x", "y"]}] and a["toolCallId"] == "call_1"
+    assert a["digest"] != b["digest"]  # order is part of the question identity
+    assert a["digest"] == clarify_early.question_descriptor([{"question": "Q", "choices_offered": ["x", "y"]}],
+                                                            "other")["digest"]
+
+
+def test_bound_provider_receives_the_descriptor_and_its_echo_ends_the_clarify():
+    seen, commits = [], []
+
+    def provider(sid, tcid, question=None):
+        seen.append(question)
+        return _decision_answer(commits, {"toolCallId": tcid, "questionDigest": question["digest"]})
+    provider.accepts_question = True
+    clarify_early.register_provider(provider)
+    cb = Blocking()
+    out = json.loads(clarify_tool(QUESTIONS, callback=cb, session_id="s1", tool_call_id="call_a"))
+    assert out["status"] == "answered_elsewhere" and commits == ["done"] and cb.calls == 0
+    assert seen[0]["toolCallId"] == "call_a"
+    assert seen[0]["questions"] == [{"question": "Which runner?", "choices": ["canary", "aws"]}]
+
+
+def test_unbound_same_session_decision_does_not_end_the_clarify():
+    """Negative control: the provider answers for the right session but for a different question."""
+    commits = []
+
+    def provider(sid, tcid, question=None):
+        return _decision_answer(commits, {"toolCallId": tcid, "questionDigest": "0" * 64})
+    provider.accepts_question = True
+    clarify_early.register_provider(provider)
+    cb = Blocking()
+    box = {}
+    t = threading.Thread(target=lambda: box.update(out=json.loads(clarify_tool(
+        QUESTIONS, callback=cb, session_id="s1", tool_call_id="call_b"))))
+    t.start()
+    assert cb.entered.wait(WAIT_S)
+    t.join(0.5)
+    assert t.is_alive(), "an unbound decision must not end the clarify"
+    cb.event.set(); t.join(WAIT_S)
+    assert commits == [] and box["out"].get("status") != "answered_elsewhere"
+
+
+def test_legacy_decision_answer_cannot_end_a_bound_question():
+    commits = []
+    clarify_early.register_provider(lambda sid, tcid: _decision_answer(commits))
+    cb = Blocking()
+    box = {}
+    t = threading.Thread(target=lambda: box.update(out=json.loads(clarify_tool(
+        QUESTIONS, callback=cb, session_id="s1", tool_call_id="call_c"))))
+    t.start()
+    assert cb.entered.wait(WAIT_S)
+    t.join(0.5)
+    assert t.is_alive()
+    cb.event.set(); t.join(WAIT_S)
+    assert commits == []
+
+
+def test_echo_for_another_tool_call_is_rejected():
+    commits = []
+
+    def provider(sid, tcid, question=None):
+        return _decision_answer(commits, {"toolCallId": "call_other", "questionDigest": question["digest"]})
+    provider.accepts_question = True
+    assert clarify_early.poll("s1", "call_d", clarify_early.question_descriptor(QUESTIONS, "call_d")) is None
+    clarify_early.register_provider(provider)
+    assert clarify_early.poll("s1", "call_d", clarify_early.question_descriptor(QUESTIONS, "call_d")) is None
+
+
+def test_legacy_withdrawal_without_decisions_still_ends_the_clarify():
+    """The update-pause provider answers nothing; it may still withdraw the clarify."""
+    clarify_early.register_provider(lambda sid, tcid: clarify_early.EarlyAnswer(
+        {"status": "paused_for_update", "outcome": "paused_for_update", "notice": "paused"}, commit=lambda: None))
+    out = json.loads(clarify_tool(QUESTIONS, callback=Blocking(), session_id="s1", tool_call_id="call_e"))
+    assert out["status"] == "paused_for_update"
+
+
+def test_poll_without_descriptor_keeps_the_legacy_two_argument_contract():
+    commits = []
+    clarify_early.register_provider(lambda sid, tcid: _decision_answer(commits))
+    assert clarify_early.poll("s1", "call_f") is not None
diff --git a/tools/clarify_early.py b/tools/clarify_early.py
index 46603fb2af..f5c8f41d92 100644
--- a/tools/clarify_early.py
+++ b/tools/clarify_early.py
@@ -4,11 +4,20 @@ Plugins register a provider ``fn(session_id, tool_call_id) -> EarlyAnswer | None
 before showing a question and, while a surface is blocked waiting on the human, every ``POLL_INTERVAL_S``. A provider
 returns an answer only for decisions that belong to that session; ``commit()`` marks them delivered and is called only
 when the early answer is the one the clarify returns (never when the human answered first).
+
+Bound questions: a provider whose function has ``accepts_question = True`` is called as
+``fn(session_id, tool_call_id, question=descriptor)`` where ``descriptor`` (:func:`question_descriptor`) is the exact
+ordered question/choice snapshot the human sees plus its SHA-256 ``digest``. An early answer that carries
+``decisions`` ends the clarify only when its ``binding`` names this tool call and this digest: matching the session
+alone is never enough, so an unrelated decision recorded in the same session stays undelivered for normal delivery.
+A legacy provider (no ``accepts_question``) can still withdraw a clarify without answering it (no ``decisions``,
+e.g. the update pause), but its decision answers are ignored for a bound question.
 """
 
 from __future__ import annotations
 
 import contextvars
+import hashlib
 import json
 import logging
 import threading
@@ -19,6 +28,32 @@ logger = logging.getLogger(__name__)
 
 POLL_INTERVAL_S = 2.0
 STATUS = "answered_elsewhere"
+DESCRIPTOR_VERSION = 1
+
+
+def _canonical(value) -> str:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+
+
+def question_descriptor(normalized: list, tool_call_id: str) -> dict:
+    """The exact ordered questions and choice labels a surface shows for this clarify, with their digest."""
+    questions = [{"question": str(q.get("question") or ""),
+                  "choices": [str(c) for c in (q.get("choices_offered") or q.get("choices") or [])]}
+                 for q in normalized or [] if isinstance(q, dict)]
+    return {"schemaVersion": DESCRIPTOR_VERSION, "toolCallId": str(tool_call_id or ""), "questions": questions,
+            "digest": hashlib.sha256(_canonical(questions).encode("utf-8")).hexdigest()}
+
+
+def bound_to(early: EarlyAnswer, question: Optional[dict]) -> bool:
+    """Whether ``early`` may end the clarify described by ``question``."""
+    if question is None:
+        return True  # legacy caller without a descriptor: unchanged behaviour
+    result = early.result if isinstance(getattr(early, "result", None), dict) else {}
+    if not result.get("decisions"):
+        return True  # a withdrawal that answers nothing (update pause) needs no binding
+    binding = result.get("binding")
+    return (isinstance(binding, dict) and binding.get("questionDigest") == question.get("digest")
+            and binding.get("toolCallId") == question.get("toolCallId"))
 
 
 @dataclass
@@ -28,7 +63,7 @@ class EarlyAnswer:
 
 
 _lock = threading.Lock()
-_providers: list[Callable[[str, str], Optional[EarlyAnswer]]] = []
+_providers: list[Callable[..., Optional[EarlyAnswer]]] = []
 
 
 def register_provider(fn):
@@ -53,18 +88,25 @@ def has_providers() -> bool:
         return bool(_providers)
 
 
-def poll(session_id: str, tool_call_id: str) -> Optional[EarlyAnswer]:
-    """First provider answer for this session, or None. A failing provider never affects the clarify."""
+def poll(session_id: str, tool_call_id: str, question: Optional[dict] = None) -> Optional[EarlyAnswer]:
+    """First provider answer bound to this clarify, or None. A failing provider never affects the clarify."""
     with _lock:
         providers = list(_providers)
     for fn in providers:
         try:
-            found = fn(session_id, tool_call_id)
+            if question is not None and getattr(fn, "accepts_question", False) is True:
+                found = fn(session_id, tool_call_id, question=question)
+            else:
+                found = fn(session_id, tool_call_id)
         except Exception:
             logger.debug("clarify early-answer provider failed", exc_info=True)
             continue
-        if found is not None:
-            return found
+        if found is None:
+            continue
+        if not bound_to(found, question):
+            logger.info("clarify early answer ignored: its decisions are not bound to this question")
+            continue
+        return found
     return None
 
 
@@ -88,8 +130,9 @@ def _commit(early: EarlyAnswer) -> None:
 
 def ask(callback: Callable, normalized: list, session_id: str, tool_call_id: str) -> tuple[Optional[dict], Optional[str]]:
     """Run ``callback(normalized)`` with early-answer support -> ``(reply, early_json)``; exactly one is not None."""
+    question = question_descriptor(normalized, tool_call_id)
     if session_id and has_providers():
-        early = poll(session_id, tool_call_id)
+        early = poll(session_id, tool_call_id, question)
         if early is not None:
             _commit(early)
             return None, render(early)
@@ -110,7 +153,7 @@ def ask(callback: Callable, normalized: list, session_id: str, tool_call_id: str
 
     threading.Thread(target=run, name="clarify-wait", daemon=True).start()
     while not done.wait(POLL_INTERVAL_S):
-        early = poll(session_id, tool_call_id)
+        early = poll(session_id, tool_call_id, question)
         if early is None:
             continue
         cancelled = False
