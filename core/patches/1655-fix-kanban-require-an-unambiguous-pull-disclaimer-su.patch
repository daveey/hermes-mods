From 092736e844266683e77d1e3ada847d8ed6c50af4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 06:24:56 +0000
Subject: [PATCH] fix(kanban): require an unambiguous pull disclaimer subject
 [daveey]

---
 hermes_cli/kanban_db_dispatch_pr_policy.py       | 16 ++++++++++++++--
 .../test_kanban_active_pr_foreign_contract.py    | 14 ++++++++++++++
 2 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_db_dispatch_pr_policy.py b/hermes_cli/kanban_db_dispatch_pr_policy.py
index ea649a2eac4..dd4c7f36569 100644
--- a/hermes_cli/kanban_db_dispatch_pr_policy.py
+++ b/hermes_cli/kanban_db_dispatch_pr_policy.py
@@ -33,8 +33,20 @@ def _says_pull_does_not_block(body: str) -> bool:
 
     # A disclaimer in a mixed-URL comment may refer to a different pull from the
     # publication. Ambiguous prose must not release the duplicate-work guard.
-    urls = {norm_pr(url) for url in dispatch._RESPAWN_GUARD_PR_URL_RE.findall(body)}
-    return len(urls) == 1 and bool(_NONBLOCKING_RE.search(body))
+    urls = dispatch._RESPAWN_GUARD_PR_URL_RE.findall(body)
+    if len(urls) != 1 or re.search(r"\b(?:opened|created|published|pushed)\b", body, re.IGNORECASE):
+        return False
+    disclaimer = _NONBLOCKING_RE.search(body)
+    if disclaimer is None:
+        return False
+    # Recognize a deliberately narrow informational statement: the URL is the
+    # subject, directly or via "<URL> ... . It ...". Unrelated lint/CI subjects,
+    # publication statements, extra clauses and ambiguous prose remain guarded.
+    prefix = body[:disclaimer.start()].replace(urls[0], "PULL")
+    return bool(
+        re.fullmatch(r"\s*(?:See\s+)?PULL(?:\s+[^.!?\n]+\.\s+It)?\s+", prefix, re.IGNORECASE)
+        and re.fullmatch(r"[.!]?\s*", body[disclaimer.end():])
+    )
 
 
 def _own_contract_key(conn: sqlite3.Connection, task_id: str) -> Optional[str]:
diff --git a/tests/hermes_cli/test_kanban_active_pr_foreign_contract.py b/tests/hermes_cli/test_kanban_active_pr_foreign_contract.py
index db0d555ccf8..1ceae16cbb6 100644
--- a/tests/hermes_cli/test_kanban_active_pr_foreign_contract.py
+++ b/tests/hermes_cli/test_kanban_active_pr_foreign_contract.py
@@ -139,6 +139,20 @@ def test_mixed_comment_disclaimer_does_not_drop_published_pull(disclaimed, live_
         assert _guard(conn, tid) == "active_pr"
 
 
+@pytest.mark.parametrize("body", [
+    f"Opened {OWN}. The flaky lint check doesn't block this card.",
+    f"Opened {OWN}. Opened {OWN}/ again. The CI failure does not block the card.",
+    f"Opened {OWN.upper()} and {OWN}. Lint won't block you.",
+    f"Published {OWN}. It does not block this task.",
+    f"See {OWN}. The CI failure does not block this card.",
+])
+def test_publication_or_unrelated_subject_is_not_a_pull_disclaimer(body):
+    with kbc.connect() as conn:
+        tid = _claimed(conn, "ambiguous disclaimer")
+        worker_comment(conn, tid, "a", body)
+        assert _guard(conn, tid) == "active_pr"
+
+
 def test_nonblocking_comment_does_not_exempt_a_real_open_comment():
     with kbc.connect() as conn:
         tid = _claimed(conn, "opened then disclaimed")
