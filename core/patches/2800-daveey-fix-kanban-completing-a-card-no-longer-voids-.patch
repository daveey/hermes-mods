diff --git a/hermes_cli/kanban_operator_call.py b/hermes_cli/kanban_operator_call.py
index f22d1e5afe..9a93fbad37 100644
--- a/hermes_cli/kanban_operator_call.py
+++ b/hermes_cli/kanban_operator_call.py
@@ -378,7 +378,10 @@ def start(conn: sqlite3.Connection, req: dict, executor: str) -> str:
         return "rejected"
     payload = {"request_uid": uid, "board": board, "action": op["action"], "target_task_id": op.get("task_id"),
                "args": {k: v for k, v in op.items() if k not in ("op", "action", "task_id")},
-               "caller": caller, "requested_at": int(time.time()), "supervisor_request_id": req["id"],
+               # The call was made at submit (which proved the run live), not when this tick forwards it:
+               # the caller may have completed since.
+               "caller": caller, "requested_at": int(req["created_at"]),
+               "supervisor_request_id": req["id"],
                "home": verdict.get("home")}
     with kb.write_txn(conn):
         before = _outbox_rows(conn)
diff --git a/hermes_cli/kanban_retry_limit_exec.py b/hermes_cli/kanban_retry_limit_exec.py
index 3d5eb53c01..95c8aa9c67 100644
--- a/hermes_cli/kanban_retry_limit_exec.py
+++ b/hermes_cli/kanban_retry_limit_exec.py
@@ -12,7 +12,8 @@ appends the ordinary ``edited`` event. It is deliberately narrow:
   creating worker's own task. Not the creator chain, not siblings, not grandchildren.
 * **Never the requester's own card** (``self_scope``): a worker must not widen its own breaker.
 * **Bounded.** ``max_retries`` is an int 1..``MAX_RETRY_LIMIT``; bools are refused.
-* **Live cards only.** Archived or done targets, and a finished requester, are refused.
+* **Live cards only.** Archived or done targets are refused; so is an archived requester (a
+  requester that completed after filing still gets its request executed).
 
 Execution re-checks scope and the requester against the board as it is now. Each applied op
 appends a ``supervisor_retry_limit`` event carrying the request id, so a redelivered request
diff --git a/hermes_cli/kanban_supervisor_requests.py b/hermes_cli/kanban_supervisor_requests.py
index bd664240da..c7871e5d24 100644
--- a/hermes_cli/kanban_supervisor_requests.py
+++ b/hermes_cli/kanban_supervisor_requests.py
@@ -236,10 +236,13 @@ def endpoint_scope(conn: sqlite3.Connection, requester: str, task_id: str) -> Op
 
 
 def requester_refusal(conn: sqlite3.Connection, requester: str) -> Optional[str]:
+    """Only a missing or archived requester voids its queued requests. A ``done`` requester's request still
+    runs: ``submit`` proved a live run, filing a comment is naturally a worker's last act, and each executor
+    re-checks the op's scope against the board as it is now."""
     row = conn.execute("SELECT status FROM tasks WHERE id = ?", (requester,)).fetchone()
     if row is None:
         return f"requester {requester} no longer exists"
-    if row[0] in ("archived", "done"):
+    if row[0] == "archived":
         return f"requester {requester} is {row[0]}"
     return None
 
diff --git a/tests/hermes_cli/test_kanban_operator_call.py b/tests/hermes_cli/test_kanban_operator_call.py
index 127986d0b7..7b0838195d 100644
--- a/tests/hermes_cli/test_kanban_operator_call.py
+++ b/tests/hermes_cli/test_kanban_operator_call.py
@@ -379,6 +379,49 @@ def test_evicted_caller_copy_still_finishes(fleet):
     assert req["status"] == "done" and req["error"] == "requester_gone"
 
 
+def _complete_caller(f):
+    assert kb.complete_task(f.w, f.caller, summary="filed the comment", expected_run_id=f.run_id)
+    assert kb.get_task(f.w, f.caller).status == "done"
+
+
+def test_operator_comment_lands_after_requester_completes(fleet):
+    """A comment is naturally a worker's last act: completing the card must not void the filed request."""
+    f = fleet
+    out = _submit(f, {"op": "operator", "action": "comment", "task_id": f.target, "text": "handoff: PR #7 merged"})
+    _complete_caller(f)
+    _round(f)
+    comments = f.h.execute("SELECT body FROM task_comments WHERE task_id = ?", (f.target,)).fetchall()
+    assert [c[0] for c in comments] == ["handoff: PR #7 merged"]
+    req = ksr.get_request(f.w, out["request_id"])
+    assert req["status"] == "done" and req["error"] is None, (req["status"], req["error"], req["result"])
+    assert req["result"][0]["outcome"] == "applied"
+    kinds = [e.kind for e in kb.list_events(f.w, f.caller)]
+    assert "supervisor_request_done" in kinds
+    assert kb.get_task(f.w, f.caller).status == "done"  # the receipt neither wakes nor reopens the card
+    _round(f)  # a later round neither repeats the comment nor reopens the request
+    assert f.h.execute("SELECT COUNT(*) FROM task_comments WHERE task_id = ?", (f.target,)).fetchone()[0] == 1
+
+
+def test_late_forward_after_completion_is_proven_at_submit_time(fleet):
+    """The executor ran long after the caller's run ended: the home proves the run live when it was submitted."""
+    f = fleet
+    out = _submit(f, {"op": "operator", "action": "comment", "task_id": f.target, "text": "late"})
+    _complete_caller(f)
+    back = kox.SKEW_S * 5
+    with kb.write_txn(f.w):  # submit and completion happened well before this dispatcher tick
+        f.w.execute("UPDATE supervisor_requests SET created_at = created_at - ? WHERE id = ?",
+                    (back, out["request_id"]))
+        f.w.execute("UPDATE task_runs SET started_at = started_at - ?, ended_at = ended_at - ? WHERE id = ?",
+                    (back + 10, back - 5, f.run_id))
+    uid = f.w.execute("SELECT uid FROM task_runs WHERE id = ?", (f.run_id,)).fetchone()[0]
+    with kb.write_txn(f.rep):  # the Board already holds the run row; its start moves back with it
+        f.rep.execute("UPDATE task_runs SET started_at = started_at - ? WHERE uid = ?", (back + 10, uid))
+    _round(f)
+    req = ksr.get_request(f.w, out["request_id"])
+    assert req["status"] == "done", (req["error"], req["result"])
+    assert f.h.execute("SELECT COUNT(*) FROM task_comments WHERE task_id = ?", (f.target,)).fetchone()[0] == 1
+
+
 def test_home_offline_fails_after_deadline(fleet):
     f = fleet
     out = _submit(f, {"op": "operator", "action": "comment", "task_id": f.target, "text": "hi"})
diff --git a/tests/hermes_cli/test_kanban_retry_limit_exec.py b/tests/hermes_cli/test_kanban_retry_limit_exec.py
index ce37fecaf9..3310164d0e 100644
--- a/tests/hermes_cli/test_kanban_retry_limit_exec.py
+++ b/tests/hermes_cli/test_kanban_retry_limit_exec.py
@@ -202,14 +202,27 @@ def test_scope_lost_between_submit_and_execute_is_rejected(board, monkeypatch):
     assert _max_retries(board["child"]) is None
 
 
-def test_requester_finished_before_execute_is_rejected(board, monkeypatch):
+def test_requester_finished_before_execute_still_applies(board, monkeypatch):
+    """Completing the requester does not cancel its filed request; only archiving does."""
     out = _tool(_req(board["child"]))
     with kbc.connect_closing() as conn:
         assert kb.complete_task(conn, board["requester"], result="x", summary="finished")
     _as_executor(monkeypatch)
     _drain()
     req = _request(out["request_id"])
-    assert req["status"] == "rejected" and "requester" in req["error"], req
+    assert req["status"] == "done" and req["error"] is None, req
+    assert _max_retries(board["child"]) == 5
+
+
+def test_requester_archived_before_execute_is_rejected(board, monkeypatch):
+    out = _tool(_req(board["child"]))
+    with kbc.connect_closing() as conn:
+        assert kb.complete_task(conn, board["requester"], result="x", summary="finished")
+        kb.archive_task(conn, board["requester"])
+    _as_executor(monkeypatch)
+    _drain()
+    req = _request(out["request_id"])
+    assert req["status"] == "rejected" and "archived" in req["error"], req
     assert _max_retries(board["child"]) is None
 
 
diff --git a/tests/hermes_cli/test_kanban_supervisor_requests.py b/tests/hermes_cli/test_kanban_supervisor_requests.py
index 7676f0aaa6..4d9fc91077 100644
--- a/tests/hermes_cli/test_kanban_supervisor_requests.py
+++ b/tests/hermes_cli/test_kanban_supervisor_requests.py
@@ -437,6 +437,23 @@ def test_archived_requester_is_rejected_at_execution(board, monkeypatch):
         assert (board["qa119"], board["dev116"]) in _edges(conn)
 
 
+def test_unlink_applies_after_requester_completes(board, monkeypatch):
+    """Completing the card does not cancel a filed request; the receipt does not reopen the card."""
+    out = _tool({"ops": _reorder(board)})
+    with kbc.connect() as conn:
+        assert kb.complete_task(conn, board["requester"], summary="filed", expected_run_id=board["run_id"])
+    _as_executor(monkeypatch)
+    with kbc.connect() as conn:
+        assert ksr.drain(conn)["processed"] == [(out["request_id"], "done")]
+        assert (board["qa119"], board["dev116"]) not in _edges(conn)
+        assert (board["dev67"], board["dev81"]) not in _edges(conn)
+        req = ksr.get_request(conn, out["request_id"])
+        assert req["error"] is None and req["requester_woken"] == 1
+        kinds = [k for k, _ in _events(conn, board["requester"])]
+        assert kinds[-2:] == ["supervisor_request_accepted", "supervisor_request_done"]
+        assert kb.get_task(conn, board["requester"]).status == "done"
+
+
 def test_a_request_that_keeps_crashing_executors_is_failed_not_redelivered_forever(board, monkeypatch):
     out = _tool({"ops": _reorder(board)})
     _as_executor(monkeypatch)
