From 96b742295f8a12fc9704111078fdb65305174f9b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:19:01 +0000
Subject: [PATCH] fix(kanban): mark owner_recovery's state.db read as outside
 the board lockguard [daveey]

Upstream's kanban_owner_recovery reads the owner's session_admissions from its
state.db with a raw sqlite3.connect, which the fork's lockguard sweep
(test_kanban_modules_open_boards_only_through_the_guard) flags as an unguarded board
handle. It is not a board; annotate it with the sweep's noqa marker.
---
 hermes_cli/kanban_owner_recovery.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_owner_recovery.py b/hermes_cli/kanban_owner_recovery.py
index 5c12945d7c1..3250fb15fb5 100644
--- a/hermes_cli/kanban_owner_recovery.py
+++ b/hermes_cli/kanban_owner_recovery.py
@@ -34,7 +34,9 @@ def _admission_row(receipt):
     if not receipt:
         return None
     try:
-        with closing(sqlite3.connect(Path(receipt['db']).as_uri() + '?mode=ro', uri=True)) as owner:
+        # The owner's state.db (session_admissions), not a Kanban board: the board guard does not apply.
+        owner_uri = Path(receipt['db']).as_uri() + '?mode=ro'
+        with closing(sqlite3.connect(owner_uri, uri=True)) as owner:  # noqa: kanban-lockguard
             row = owner.execute('SELECT status,outcome FROM session_admissions WHERE target_session_id=? AND request_id=?',
                                 (receipt['session_id'], receipt['request_id'])).fetchone()
     except (OSError, KeyError, TypeError, ValueError, sqlite3.Error):
