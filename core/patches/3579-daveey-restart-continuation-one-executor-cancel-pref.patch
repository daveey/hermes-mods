From 8153ad1716d26ad83502d484c89bf5c87befcabe Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 13:15:12 +0000
Subject: [PATCH] [daveey] restart continuation: one executor-cancel prefix
 tuple; document the mid-tool own-result race

Follow-up of PR #2216 review 5891397575 nits (card t_01a1d4fe4b6a3a1a).

1. gateway/session_kanban_continue.py kept its own copy of the executor's
   cancel/skip prefixes (_STOP_RESULT_PREFIXES) next to agent/update_pause_cancel.py's
   _EXECUTOR_CANCEL_PREFIXES. A wording change in one would classify the executor's
   text differently on the restart-Stop path and the update-pause path. The tuple is
   now public (EXECUTOR_CANCEL_PREFIXES) and session_kanban_continue imports it.
   Refactor only: no behavior change.

2. test_a_real_owner_restart_mid_turn_continues_the_same_run[mid_tool_call] still
   accepts the bare stamp, now with the reason in a comment: the own-result form is
   a wall-clock race. The sequential executor waits 3 s for the interrupted call
   (agent/tool_executor.py) and the terminal's kill + drain join
   (tools/environments/base.py _kill_and_join) can use most of that on a loaded
   runner; past it the executor writes its own cancel text, which has no result of
   the call. When the own part is present, the test now pins it to the killed
   command's envelope ({"output": "...[Command interrupted]", "exit_code": 130}).
   Locally on hermes-worker-6 (load ~19), 5 of 5 runs produced the own-result form.

Tests: test_kanban_restart_continuation + every test file importing
update_pause_cancel / session_kanban_continue (10 files, 165 passed);
scripts/check --base origin/main: 19 checks ok.
---
 agent/update_pause_cancel.py                      |  5 +++--
 gateway/session_kanban_continue.py                | 12 +++++-------
 tests/gateway/test_kanban_restart_continuation.py | 12 +++++++++++-
 3 files changed, 19 insertions(+), 10 deletions(-)

diff --git a/agent/update_pause_cancel.py b/agent/update_pause_cancel.py
index 9ced10dee8..e2bec73025 100644
--- a/agent/update_pause_cancel.py
+++ b/agent/update_pause_cancel.py
@@ -96,7 +96,8 @@ OWN_RESULT_INTRO = "The call's own result when the update cancelled it:"
 OWN_RESULT_END = "[end of the cancelled call's own result]"
 # The executor's own text for a call the interrupt abandoned or skipped (tool_executor): no result of the call.
 # Its ``emit_cancelled`` JSON for a KeyboardInterrupt mid-tool is the same (``_executor_cancelled_json``).
-_EXECUTOR_CANCEL_PREFIXES = ("[Tool execution cancelled \u2014 ", "[Tool execution skipped \u2014 ")
+# The one definition: gateway/session_kanban_continue.py classifies a restart Stop's rows with it too.
+EXECUTOR_CANCEL_PREFIXES = ("[Tool execution cancelled \u2014 ", "[Tool execution skipped \u2014 ")
 
 
 def with_own_result(stamp: str, result: Any) -> str:
@@ -106,7 +107,7 @@ def with_own_result(stamp: str, result: Any) -> str:
     result whose last line is an executor's ``[Command interrupted]`` marker from reading as an interrupted
     result on replay (``replay_cleanup.is_interrupted_tool_result``), which would rewrite it away again."""
     if not isinstance(result, str) or not result.strip() or result == stamp \
-            or result.startswith(_EXECUTOR_CANCEL_PREFIXES) or _executor_cancelled_json(result):
+            or result.startswith(EXECUTOR_CANCEL_PREFIXES) or _executor_cancelled_json(result):
         return stamp
     kept = result.strip()
     if len(kept) > OWN_RESULT_HEAD + OWN_RESULT_TAIL:
diff --git a/gateway/session_kanban_continue.py b/gateway/session_kanban_continue.py
index 7b043b7538..0b64673b0f 100644
--- a/gateway/session_kanban_continue.py
+++ b/gateway/session_kanban_continue.py
@@ -117,17 +117,15 @@ def _unanswered(history):
     return _unanswered_tool_calls(history)
 
 
-# What the agent's own executor writes for a tool call a hard interrupt cancelled or skipped
-# (agent/tool_executor.py). With a killed command's own interrupted output (replay_cleanup's
-# ``is_interrupted_tool_result`` shape) these become the update-pause text after a restart Stop.
-_STOP_RESULT_PREFIXES = ('[Tool execution cancelled \u2014 ', '[Tool execution skipped \u2014 ')
-
-
 def _stop_result_rows(session_db, session_id) -> list:
     """``(row id, content)`` of the stopped turn's cancelled, skipped or interrupted tool results: the tool
     rows right after the transcript's last assistant tool-call message, past the closing assistant rows the
     stopped turn wrote (its empty final reply, the interrupted-delivery note) and nothing else."""
     from agent.replay_cleanup import is_interrupted_tool_result
+    # The executor's cancel/skip text (agent/tool_executor.py) and a killed command's own interrupted output
+    # become the update-pause text after a restart Stop. One prefix tuple with with_own_result, so a wording
+    # change can't classify the executor's text differently on the two paths.
+    from agent.update_pause_cancel import EXECUTOR_CANCEL_PREFIXES
     found = []
     for row in reversed(session_db.get_messages(session_id, latest=True, limit=256)):
         role = row.get('role')
@@ -140,7 +138,7 @@ def _stop_result_rows(session_db, session_id) -> list:
         if role != 'tool':
             return []
         content = row.get('content')
-        if isinstance(content, str) and (content.startswith(_STOP_RESULT_PREFIXES)
+        if isinstance(content, str) and (content.startswith(EXECUTOR_CANCEL_PREFIXES)
                                          or is_interrupted_tool_result(content)):
             found.append((int(row['id']), content))
     return []
diff --git a/tests/gateway/test_kanban_restart_continuation.py b/tests/gateway/test_kanban_restart_continuation.py
index 0230c056d2..9bbac91d27 100644
--- a/tests/gateway/test_kanban_restart_continuation.py
+++ b/tests/gateway/test_kanban_restart_continuation.py
@@ -67,7 +67,17 @@ def test_a_real_owner_restart_mid_turn_continues_the_same_run(tmp_path, mid_tool
         first, *own = receipt['mid_tool_results'][0].split('\n')
         assert re.fullmatch(r'\[interrupted by Hermes update at \d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ: check its outcome before re-running\]',
                             first), receipt['mid_tool_results']
-        assert not own or (own[0] == OWN_RESULT_INTRO and own[-1] == OWN_RESULT_END), receipt['mid_tool_results']
+        # Not pinned to the own-result form: it is a wall-clock race. The sequential executor waits 3 s for the
+        # interrupted call (agent/tool_executor.py, ``concurrent.futures.wait([future], timeout=3.0)``), and the
+        # terminal's kill + output-drain join (tools/environments/base.py ``_kill_and_join``) can use most of
+        # that on a loaded runner; past it the executor writes its own "[Tool execution cancelled — ..." text,
+        # which carries no result of the call, so the bare stamp is right then. Locally 5 of 5 runs kept it.
+        # When the own part is there it is exactly the killed command's interrupted envelope.
+        if own:
+            assert own[0] == OWN_RESULT_INTRO and own[-1] == OWN_RESULT_END, receipt['mid_tool_results']
+            envelope = json.loads('\n'.join(own[1:-1]))
+            assert (envelope['output'].endswith('[Command interrupted]'), envelope['exit_code']) == (True, 130), \
+                receipt['mid_tool_results']
 
 
 # --- the worker: a fake owner that restarts mid-turn -------------------------------------------
