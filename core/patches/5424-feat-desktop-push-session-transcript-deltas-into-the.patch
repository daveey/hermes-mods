+        "session_id": sid,
+        "profile": _serving_profile(profile),
+        "messages": projected,
+        "delta": {"after_id": after_id, "anchor_found": bool(page["anchor_found"]), "has_more": has_more,
+                  "transcript_revision": page["transcript_revision"], "limit": _limit,
+                  "returned": len(projected)}}
