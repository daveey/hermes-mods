+            conn.execute("INSERT OR REPLACE INTO task_wake_checks(task_id, cmd, every, next_at) VALUES (?,?,900,?)",
+                         (tid, f"hermes kanban wait-comment {tid} --after-id 0 --contains 'SOURCE-GO-REQUEST'",
