+    assert "will NOT wake the card" in miss["wake"] and "SOURCE-GO-REQUEST" in miss["wake"]
+    hit = json.loads(kt._handle_comment({"task_id": tid, "body": "SOURCE-GO-REQUEST PR4151@97ce66fd"}))
