+        kb._append_event(conn, tid, "commented", {"comment_id": "not-a-number", "writer_task": "t_0b716b01a47db7f6"})
+    assert run("wait-comment", tid, "--after-id", "0", "--from-card", "t_0b716b01a47db7f6") == 1
