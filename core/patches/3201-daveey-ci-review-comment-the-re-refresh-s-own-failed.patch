From d69ff05c3cf04c759d4aba59a66ad83f4b2b14a2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 06:15:12 +0000
Subject: [PATCH] [daveey] ci-review comment: the re-refresh's own failed
 footer points at the hourly sweep

A failed re-refresh (workflow_dispatch with head_sha, never queues another)
carried the requeued= mark and so wrote 'a re-refresh already queued at ...'
about itself. It now says 'next refresh: hourly sweep' and still carries the
mark, so a later CI/Docker failure of that head queues nothing.

Card t_01a1d1827d121b26.
---
 scripts/ci/batch_review_comments.py    | 8 ++++----
 tests/ci/test_batch_review_comments.py | 6 +++++-
 2 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/scripts/ci/batch_review_comments.py b/scripts/ci/batch_review_comments.py
index 9bc25cc065..a939b39fbd 100644
--- a/scripts/ci/batch_review_comments.py
+++ b/scripts/ci/batch_review_comments.py
@@ -380,10 +380,12 @@ def mark_refresh_failed(token: str, repo: str, pr: dict, now: datetime, error: s
         return "marker skipped: completed snapshot of this head kept; no re-refresh queued"
     notes = []
     requeued = requeued_at(existing, sha)
-    if requeued:
+    if not re_refresh:  # the re-refresh itself (or a sweep): the mark is carried, the hourly sweep is next
+        next_refresh = "next refresh: hourly sweep"
+    elif requeued:
         next_refresh = f"a re-refresh already queued at {requeued:%H:%M} UTC, then hourly"
         notes.append(f"re-refresh already queued at {requeued:%H:%M:%S}Z; not queued again")
-    elif re_refresh:
+    else:
         try:
             at = queue_re_refresh(token, repo, sha, run_id)
             requeued = datetime.now(UTC)
@@ -392,8 +394,6 @@ def mark_refresh_failed(token: str, repo: str, pr: dict, now: datetime, error: s
         except (OSError, ValueError, RuntimeError) as e:
             next_refresh = "next refresh: hourly sweep"
             notes.append(f"ERROR queueing re-refresh: {e}")
-    else:
-        next_refresh = "next refresh: hourly sweep"
     body = failed_refresh_body(existing, pr, sha, repo, now, run_id, datetime.now(UTC), error, next_refresh,
                                requeued=requeued)
     if body is None:  # unreachable: keeps_completed_snapshot was checked above
diff --git a/tests/ci/test_batch_review_comments.py b/tests/ci/test_batch_review_comments.py
index be2ffc5129..e66f1f57df 100644
--- a/tests/ci/test_batch_review_comments.py
+++ b/tests/ci/test_batch_review_comments.py
@@ -765,7 +765,11 @@ def test_ci_and_docker_failures_on_one_head_queue_one_re_refresh(monkeypatch, tm
     # The re-refresh itself fails: still one dispatch, and the queued mark is kept for any later CI/Docker failure.
     f.comments = {1: [{"id": 77, "body": body}]}
     assert b.run_batch("t", REPO, NOW + timedelta(minutes=6), head_sha=sha, trigger_workflow="") == 1
-    f.comments = {1: [{"id": 77, "body": f.posted.pop("1")}]}
+    body = f.posted.pop("1")
+    # Its footer points at the hourly sweep (the queued re-refresh was this run), and the state line keeps the mark.
+    assert "next refresh: hourly sweep" in body and "already queued" not in body
+    assert b.requeued_at(body, sha) is not None
+    f.comments = {1: [{"id": 77, "body": body}]}
     assert b.run_batch("t", REPO, NOW + timedelta(minutes=7), head_sha=sha, trigger_workflow="CI") == 1
     assert len(d.dispatches) == 1
 
