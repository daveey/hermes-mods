diff --git a/hermes_cli/kanban_worker_placement.py b/hermes_cli/kanban_worker_placement.py
index e8718b3095e..502119638aa 100644
--- a/hermes_cli/kanban_worker_placement.py
+++ b/hermes_cli/kanban_worker_placement.py
@@ -17,6 +17,10 @@ DISPATCH_NETWORK_BUDGET_S = 2.0
 # Re-asking at the same revision every dispatcher tick only repeats the refusal; wait for a new revision instead.
 NOT_CLAIMABLE_BACKOFF_S = 600.0
 _refused: dict[tuple[str, str], tuple[int, float]] = {}  # (board, task) -> (refused revision, retry after)
+# No assigned keepalive exists here. Sixty seconds bounds queue probes while still discovering
+# registry-only capacity changes without waiting for a task revision. Assigned renewals are unchanged.
+RESERVE_KEEPALIVE_S = 60.0
+_queued: dict[tuple[str, str], tuple[int, float]] = {}
 
 
 def creation_decision(args, cfg, gateway, pin, origin_intent):
@@ -144,6 +148,10 @@ def reevaluate(conn, hub, board, gateway, *, cfg=None):
                     del _refused[stale]
             labels = requested_move(conn, row["id"])
             stage = "reserve" if labels is None else "repin"  # provenance for a failure below
+            held = _queued.get(key)
+            if labels is None and held and held[0] == row["sync_version"] and now < held[1]:
+                continue
+            _queued.pop(key, None)
             try:
                 if labels is not None:
                     # A run moved this card (kanban_move). Its runs_on is Board-owned, so only the origin's
@@ -157,6 +165,12 @@ def reevaluate(conn, hub, board, gateway, *, cfg=None):
                 else:
                     reply = hub.reserve(board, task_id=row["id"], expected_revision=row["sync_version"],
                                         candidates=candidates)
+                    if reply.get("state") == "queued":
+                        # Never adopt an arbitrary post-pull revision: it may be somebody else's edit.
+                        version = reply.get("task_version", row["sync_version"])
+                        _queued[key] = (version, time.monotonic() + RESERVE_KEEPALIVE_S)
+                        if len(_queued) > 1024:
+                            del _queued[next(iter(_queued))]
                     queue.try_record(queue.record_reply, conn, row["id"], gateway, reply, candidates)
                 attempted += 1
             except OSError as exc:
diff --git a/tests/hermes_cli/test_kanban_queued_reserve_throttle.py b/tests/hermes_cli/test_kanban_queued_reserve_throttle.py
new file mode 100644
index 00000000000..53ded85784f
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_queued_reserve_throttle.py
@@ -0,0 +1,82 @@
+"""Queued placement is a bounded keepalive, not a dispatcher-frequency write."""
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_worker_placement as wp
+from hermes_cli import kanban_sync_client as client
+from hermes_cli import kanban_placement as placement
+from tests.hermes_cli import test_kanban_worker_reserve_client as fixtures
+
+conn = fixtures.conn
+CFG = {"worker_pools": {"hub": ["worker-1"]}}
+
+
+@pytest.mark.parametrize("entry", ["reevaluate", "dispatch_tick"])
+def test_queued_throttle_revision_and_expiry(conn, monkeypatch, entry):
+    tid = fixtures.acknowledged(conn)
+    hub = fixtures.RecordingHub()
+    clock = [100.0]
+    monkeypatch.setattr(wp, "time", SimpleNamespace(monotonic=lambda: clock[0]))
+    monkeypatch.setattr(client, "pull", lambda *a, **kw: None)
+    monkeypatch.setattr(client, "load_identity", lambda: SimpleNamespace(gateway="hub"))
+    monkeypatch.setattr(client, "Hub", lambda *a, **kw: hub)
+    monkeypatch.setattr(placement, "config", lambda: CFG)
+    def tick():
+        if entry == "dispatch_tick":
+            wp.dispatch_tick(conn)
+        else:
+            wp.reevaluate(conn, hub, "default", "hub", cfg=CFG)
+    tick()
+    for _ in range(5):
+        tick()
+    assert len(hub.calls) == 1
+    clock[0] += wp.RESERVE_KEEPALIVE_S
+    tick()
+    assert len(hub.calls) == 2
+    conn.execute("UPDATE kanban_sync_state SET applying=1")
+    conn.execute("UPDATE tasks SET sync_version=5 WHERE id=?", (tid,))
+    conn.execute("UPDATE kanban_sync_state SET applying=0")
+    conn.commit()
+    tick()
+    assert len(hub.calls) == 3
+
+
+@pytest.mark.parametrize("state", ["queued", "assigned"])
+def test_response_revision_and_assigned_renewal(conn, monkeypatch, state):
+    tid = fixtures.acknowledged(conn)
+    hub = fixtures.RecordingHub()
+    original = hub.reserve
+    def reserve(*args, **kwargs):
+        return {**original(*args, **kwargs), "state": state, "task_version": 5}
+    hub.reserve = reserve
+    def pull(*args, **kwargs):
+        conn.execute("UPDATE kanban_sync_state SET applying=1")
+        conn.execute("UPDATE tasks SET sync_version=5 WHERE id=?", (tid,))
+        conn.execute("UPDATE kanban_sync_state SET applying=0")
+        conn.commit()
+    monkeypatch.setattr(client, "pull", pull)
+    for _ in range(3):
+        wp.reevaluate(conn, hub, "default", "hub", cfg=CFG)
+    assert len(hub.calls) == (1 if state == "queued" else 3)
+
+
+def test_explicit_move_bypasses_queued_cache(conn, monkeypatch):
+    fixtures.acknowledged(conn)
+    hub = fixtures.RecordingHub()
+    monkeypatch.setattr(client, "pull", lambda *a, **kw: None)
+    wp.reevaluate(conn, hub, "default", "hub", cfg=CFG)
+    calls = []
+    hub.repin = lambda *a, **kw: calls.append(kw) or {"version": 5}
+    monkeypatch.setattr(wp, "requested_move", lambda *a: ["machine:hub"])
+    wp.reevaluate(conn, hub, "default", "hub", cfg=CFG)
+    assert len(calls) == 1
+    assert len(hub.calls) == 1
+
+
+def test_cache_has_hard_bound(conn, monkeypatch):
+    fixtures.acknowledged(conn)
+    monkeypatch.setattr(wp, "_queued", {("default", str(i)): (4, float("inf")) for i in range(1024)})
+    monkeypatch.setattr(client, "pull", lambda *a, **kw: None)
+    wp.reevaluate(conn, fixtures.RecordingHub(), "default", "hub", cfg=CFG)
+    assert len(wp._queued) == 1024
