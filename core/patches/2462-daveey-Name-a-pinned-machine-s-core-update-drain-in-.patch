 hermes_cli/kanban_queue_position.py           |  61 ++++++++-
 .../test_kanban_draining_machine_pin.py       | 124 ++++++++++++++++++
 tools/kanban_tools.py                         |   4 +-
 tools/kanban_tools_placement.py               |  19 +++
 5 files changed, 210 insertions(+), 3 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_draining_machine_pin.py

