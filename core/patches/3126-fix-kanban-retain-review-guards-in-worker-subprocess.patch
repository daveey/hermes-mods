From a9bb3e725f687e0cb9717ba4deede0057a80d30e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:40:35 +0000
Subject: [PATCH] fix(kanban): retain review guards in worker subprocesses
 [daveey]

---
 hermes_cli/kanban_db_operator.py                  |  3 ++-
 hermes_cli/kanban_review_required.py              |  3 ++-
 .../test_kanban_review_required_plumbing.py       |  7 ++++---
 tests/tools/test_kanban_review_required.py        | 15 ++++++++++++++-
 4 files changed, 22 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_db_operator.py b/hermes_cli/kanban_db_operator.py
index 8a10e2bb05..4cd4e33966 100644
--- a/hermes_cli/kanban_db_operator.py
+++ b/hermes_cli/kanban_db_operator.py
@@ -41,7 +41,8 @@ def edit_operator_fields(
     if goal_mode is not None:
         wanted["goal_mode"] = 1 if goal_mode else 0
     if review_required is not None:
-        if not review_required and os.environ.get("HERMES_KANBAN_TASK"):
+        worker = os.environ.get("HERMES_KANBAN_TASK") or os.environ.get("HERMES_KANBAN_WORKER_TASK")
+        if not review_required and worker:
             raise KanbanEditRefused("review_required can only be disabled by an orchestrator, not a worker")
         wanted["review_required"] = int(bool(review_required))
     if session_id is not None:
diff --git a/hermes_cli/kanban_review_required.py b/hermes_cli/kanban_review_required.py
index 4136be46fe..550e7111ca 100644
--- a/hermes_cli/kanban_review_required.py
+++ b/hermes_cli/kanban_review_required.py
@@ -14,7 +14,8 @@ def require_review(conn, task_id: str, expected_run_id: int | None, *, placement
     task = kb.get_task(conn, task_id)
     if task is None or not task.review_required or placement_settled:
         return
-    if task.status == "review" and expected_run_id is None and not os.environ.get("HERMES_KANBAN_TASK"):
+    worker = os.environ.get("HERMES_KANBAN_TASK") or os.environ.get("HERMES_KANBAN_WORKER_TASK")
+    if task.status == "review" and expected_run_id is None and not worker:
         return  # An operator may approve a pending review without claiming it.
     if (task.status == "running" and task.current_run_id is not None
             and (expected_run_id is None or expected_run_id == task.current_run_id)
diff --git a/tests/hermes_cli/test_kanban_review_required_plumbing.py b/tests/hermes_cli/test_kanban_review_required_plumbing.py
index 9db8d483f1..8fca6f2011 100644
--- a/tests/hermes_cli/test_kanban_review_required_plumbing.py
+++ b/tests/hermes_cli/test_kanban_review_required_plumbing.py
@@ -21,7 +21,7 @@ def home(tmp_path, monkeypatch):
     monkeypatch.setenv("HERMES_HOME", str(h))
     monkeypatch.setenv("HERMES_PROFILE", "default")
     for var in ("HERMES_KANBAN_TASK", "HERMES_KANBAN_RUN_ID", "HERMES_KANBAN_DB",
-                "HERMES_KANBAN_BOARD", "HERMES_SESSION_ID"):
+                "HERMES_KANBAN_BOARD", "HERMES_SESSION_ID", "HERMES_KANBAN_WORKER_TASK"):
         monkeypatch.delenv(var, raising=False)
     monkeypatch.setattr(kc, "_check_dispatcher_presence", lambda **kw: (True, ""))
     kb._INITIALIZED_PATHS.clear()
@@ -92,9 +92,10 @@ def test_cli_edit_review_required_alone_is_a_valid_edit(home):
     assert kc._cmd_edit(parse("edit", tid, "--review-required", "on")) == 0  # no "provide --title..." error
 
 
-def test_cli_edit_worker_cannot_disable(home, monkeypatch, capsys):
+@pytest.mark.parametrize("identity", ["HERMES_KANBAN_TASK", "HERMES_KANBAN_WORKER_TASK"])
+def test_cli_edit_worker_cannot_disable(home, monkeypatch, capsys, identity):
     tid = make(True)
-    monkeypatch.setenv("HERMES_KANBAN_TASK", tid)
+    monkeypatch.setenv(identity, tid)
     assert kc._cmd_edit(parse("edit", tid, "--review-required", "off")) != 0
     assert "orchestrator" in capsys.readouterr().err
     assert flag(tid) is True
diff --git a/tests/tools/test_kanban_review_required.py b/tests/tools/test_kanban_review_required.py
index 67bbe6d903..5b5563602d 100644
--- a/tests/tools/test_kanban_review_required.py
+++ b/tests/tools/test_kanban_review_required.py
@@ -14,7 +14,7 @@ def board(tmp_path, monkeypatch):
     monkeypatch.setenv("HERMES_HOME", str(tmp_path))
     monkeypatch.setenv("HERMES_PROFILE", "default")
     for key in ("HERMES_KANBAN_TASK", "HERMES_KANBAN_RUN_ID", "HERMES_KANBAN_DB",
-                "HERMES_KANBAN_BOARD", "HERMES_SESSION_ID"):
+                "HERMES_KANBAN_BOARD", "HERMES_SESSION_ID", "HERMES_KANBAN_WORKER_TASK"):
         monkeypatch.delenv(key, raising=False)
     kb._INITIALIZED_PATHS.clear()
     with kbc.connect_closing() as conn:
@@ -78,6 +78,19 @@ def test_operator_can_approve_review_but_implementer_cannot(board, monkeypatch):
     assert kb.complete_task(board, tid, summary="operator approved")
 
 
+@pytest.mark.parametrize("identity", ["HERMES_KANBAN_TASK", "HERMES_KANBAN_WORKER_TASK"])
+def test_pending_review_worker_cli_cannot_approve(board, monkeypatch, identity):
+    from hermes_cli import kanban
+    tid, run = claimed(board, monkeypatch)
+    assert kb.request_review(board, tid, summary="implemented", expected_run_id=run)
+    monkeypatch.delenv("HERMES_KANBAN_TASK")
+    monkeypatch.delenv("HERMES_KANBAN_RUN_ID")
+    monkeypatch.setenv(identity, tid)
+    assert kanban._cmd_complete(argparse.Namespace(
+        task_ids=[tid], result=None, summary="self approval", metadata=None, force=True)) != 0
+    assert kb.get_task(board, tid).status == "review"
+
+
 def test_rework_requires_another_review(board, monkeypatch):
     tid, run = claimed(board, monkeypatch)
     assert kb.request_review(board, tid, summary="implemented", expected_run_id=run)
-- 
2.51.0

