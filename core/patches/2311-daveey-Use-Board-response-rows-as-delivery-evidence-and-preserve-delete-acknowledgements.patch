Subject: [PATCH] [daveey] Use Board response rows as delivery evidence and
 preserve delete acknowledgements

---
 hermes_cli/kanban_sync_client.py              |  4 ++--
 .../hermes_cli/test_kanban_sync_omissions.py  | 22 +++++++++++++++++++
 2 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index 77f3a94b72f..3b86236cb28 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -701,8 +701,8 @@ def push(conn: sqlite3.Connection, hub: Hub, board: str, gateway: str, *, primar
                     continue
                 if status in ("applied", "merged"):
                     from hermes_cli.kanban_sync_omissions import acknowledge
-                    sent = next(op['fields'] for op in wire if op['client_op_id'] == op_id)
-                    acknowledge(conn, op_id, res.get("row") if status == "merged" else sent, sent=sent)
+                    sent = next(op.get('fields', {}) for op in wire if op['client_op_id'] == op_id)
+                    acknowledge(conn, op_id, res.get("row"), sent=sent)
                     conn.execute("DELETE FROM kanban_sync_outbox WHERE op_id = ?", (op_id,))
                     if row["table_name"] == "tasks" and res.get("version"):
                         conn.execute("UPDATE tasks SET sync_version = MAX(COALESCE(sync_version, 0), ?) WHERE id = ?",
diff --git a/tests/hermes_cli/test_kanban_sync_omissions.py b/tests/hermes_cli/test_kanban_sync_omissions.py
index ba4437fd33a..6201fe0a6be 100644
--- a/tests/hermes_cli/test_kanban_sync_omissions.py
+++ b/tests/hermes_cli/test_kanban_sync_omissions.py
@@ -175,6 +175,28 @@ def test_duplicate_original_verdict_cannot_grant_another_retry(live, svc):
                         (original['op_id'],)).fetchone()[0] == receipt['compat_op_id']
 
 
+def test_successful_delete_without_wire_fields_retires_outbox(live, svc):
+    tid = kb.create_task(live, title='delete control', assignee='worker')
+    client.push(live, svc.hub('macbook'), 'default', 'macbook', primary=True)
+    live.execute('DELETE FROM tasks WHERE id=?', (tid,))
+    live.commit()
+    assert live.execute("SELECT 1 FROM kanban_sync_outbox WHERE op='delete'").fetchone()
+    client.push(live, svc.hub('macbook'), 'default', 'macbook', primary=True)
+    assert not live.execute("SELECT 1 FROM kanban_sync_outbox WHERE op='delete'").fetchone()
+
+
+def test_applied_recalled_row_does_not_acknowledge_unsent_value(live, svc):
+    tid = omit_pin(live, svc)
+    live.execute('UPDATE tasks SET model_pin_mandatory=0 WHERE id=?', (tid,))
+    live.commit()
+    def recalled(board, batch):
+        # Board board.ts stores and recalls its original Outcome, including row.
+        return {'results': [{'client_op_id': op['client_op_id'], 'status': 'applied',
+            'row': {'uid': op['uid'], 'model_pin_mandatory': 1}} for op in batch]}
+    client.push(live, SimpleNamespace(ops=recalled), 'default', 'macbook', primary=True)
+    assert live.execute("SELECT 1 FROM kanban_sync_omissions WHERE state!='delivered'").fetchone()
+
+
 def test_transient_restore_identity_change_still_releases_custody(live, svc):
     tid = omit_pin(live, svc)
     version = live.execute('SELECT sync_version FROM tasks WHERE id=?', (tid,)).fetchone()[0]
