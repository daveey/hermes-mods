From e8b5acdb2b3ef3c76947cef8dce67649b56967d1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 19:55:42 +0000
Subject: [PATCH] [daveey] Clarify bot and profile unread-dot rationale

Comment-only follow-up to PR #1624. Name both canonical summary builders and the contract; distinguish active profile session rows from background squares.

Proof: git diff --check; inspected both builders and ProfileCanonicalSession. No executable code changes.
---
 apps/desktop/src/app/chat/sidebar/profile-switcher.tsx | 3 ++-
 apps/desktop/src/plugins/hermes-bots/bot-row.tsx       | 4 +++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/app/chat/sidebar/profile-switcher.tsx b/apps/desktop/src/app/chat/sidebar/profile-switcher.tsx
index 3807eb7f15..d87ecd79c5 100644
--- a/apps/desktop/src/app/chat/sidebar/profile-switcher.tsx
+++ b/apps/desktop/src/app/chat/sidebar/profile-switcher.tsx
@@ -145,7 +145,8 @@ function railCondensed(profileCount: number, restGroups: readonly FleetGroup[]):
 // [daveey] Its unread state stays the plain emerald unread class, not an outcome tone (unlike a session row's
 // unread dot): it is a rollup of N unread sessions, some only persisted markers with no loaded row and so no
 // stored outcome, with mixed outcomes no single tone describes. Its label is the unread count, never "Finished",
-// and each session's own row dot below carries that session's outcome tone.
+// and session row dots carry per-session outcome tones only where those rows are shown for the active profile.
+// A background profile's square has no session rows below it until that profile is selected.
 function ProfileStatusDot({ summary }: { summary: ProfileDotSummary }) {
   return <span aria-hidden="true" className={sessionDotClassName(summary.state)} data-slot="profile-status-dot" />
 }
diff --git a/apps/desktop/src/plugins/hermes-bots/bot-row.tsx b/apps/desktop/src/plugins/hermes-bots/bot-row.tsx
index 81f4a3ca62..34f20e7fd1 100644
--- a/apps/desktop/src/plugins/hermes-bots/bot-row.tsx
+++ b/apps/desktop/src/plugins/hermes-bots/bot-row.tsx
@@ -271,7 +271,9 @@ export function BotRow({ bot, onDelete, onEdit, onGroup, onNewSection, showHandl
                 [daveey] No `session` prop, so an unread dot here stays emerald whatever the chat's stored
                 outcome: the canonical Bot Chat is hidden from session listings and the roster's
                 canonical_session summary carries no outcome. Painting the outcome tone here means adding
-                `outcome` to that summary (gateway/session_group_controls.py) and passing it through. */}
+                `outcome` to both summary builders (gateway/session_group_controls.py::_bot_sessions and
+                tui_gateway/methods_profiles.py::_canonical_session_row), to ProfileCanonicalSession in
+                tui_gateway/contracts, and passing it through. */}
             <SidebarRowLead>
               <SessionStatusDot storedSessionId={canonicalSessionId} />
             </SidebarRowLead>
-- 
