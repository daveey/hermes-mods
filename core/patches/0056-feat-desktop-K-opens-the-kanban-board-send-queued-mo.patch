---
 apps/desktop/src/app/chat/composer/help-hint.tsx |  2 +-
 apps/desktop/src/app/chat/composer/index.tsx     |  8 +++++---
 apps/desktop/src/lib/keybinds/actions.ts         |  2 +-
 apps/desktop/src/plugins/kanban/plugin.tsx       | 15 +++++++++++++++
 4 files changed, 22 insertions(+), 5 deletions(-)

diff --git a/apps/desktop/src/app/chat/composer/help-hint.tsx b/apps/desktop/src/app/chat/composer/help-hint.tsx
index 8c0546ace3..4220627e5e 100644
--- a/apps/desktop/src/app/chat/composer/help-hint.tsx
+++ b/apps/desktop/src/app/chat/composer/help-hint.tsx
@@ -13,7 +13,7 @@ const COMPOSER_HOTKEY_ROWS = [
   { id: 'composer.slash', combos: ['/'] },
   { id: 'composer.help', combos: ['?'] },
   { id: 'composer.sendNewline', combos: ['enter', 'shift+enter'] },
-  { id: 'composer.sendQueued', combos: ['mod+shift+k'] },
+  { id: 'composer.sendQueued', combos: ['mod+alt+k'] },
   { id: 'keybinds.openPanel', combos: ['mod+/'] },
   { id: 'composer.cancel', combos: ['escape'] },
   { id: 'composer.history', combos: ['up', 'down'] }
diff --git a/apps/desktop/src/app/chat/composer/index.tsx b/apps/desktop/src/app/chat/composer/index.tsx
index aa77990f20..09b8e2ada2 100644
--- a/apps/desktop/src/app/chat/composer/index.tsx
+++ b/apps/desktop/src/app/chat/composer/index.tsx
@@ -752,9 +752,11 @@ export function ChatBar({
       return
     }
 
-    // Cmd/Ctrl+Shift+K drains the next queued message. Plain Cmd/Ctrl+K is
-    // reserved for the global command palette.
-    if ((event.metaKey || event.ctrlKey) && !event.altKey && event.shiftKey && event.key.toLowerCase() === 'k') {
+    // Cmd/Ctrl+Alt+K drains the next queued message. Plain Cmd/Ctrl+K is
+    // reserved for the global command palette, and Cmd/Ctrl+Shift+K opens the
+    // kanban board ([daveey] fork; upstream used Shift here). `code`, not
+    // `key`: macOS Option turns K into "˚".
+    if ((event.metaKey || event.ctrlKey) && event.altKey && !event.shiftKey && event.code === 'KeyK') {
       event.preventDefault()
 
       if (!busy) {
diff --git a/apps/desktop/src/lib/keybinds/actions.ts b/apps/desktop/src/lib/keybinds/actions.ts
index e406415b41..16c025aa52 100644
--- a/apps/desktop/src/lib/keybinds/actions.ts
+++ b/apps/desktop/src/lib/keybinds/actions.ts
@@ -383,7 +383,7 @@ export const KEYBIND_READONLY: readonly KeybindReadonly[] = [
   { id: 'composer.newline', category: 'composer', keys: ['shift+enter'] },
   { id: 'composer.steer', category: 'composer', keys: ['enter'] },
   { id: 'composer.queue', category: 'composer', keys: ['mod+enter'] },
-  { id: 'composer.sendQueued', category: 'composer', keys: ['mod+shift+k'] },
+  { id: 'composer.sendQueued', category: 'composer', keys: ['mod+alt+k'] },
   { id: 'composer.mention', category: 'composer', keys: ['@'] },
   { id: 'composer.slash', category: 'composer', keys: ['/'] },
   { id: 'composer.help', category: 'composer', keys: ['?'] },
diff --git a/apps/desktop/src/plugins/kanban/plugin.tsx b/apps/desktop/src/plugins/kanban/plugin.tsx
index 5836071773..91ba8bd82d 100644
--- a/apps/desktop/src/plugins/kanban/plugin.tsx
+++ b/apps/desktop/src/plugins/kanban/plugin.tsx
@@ -132,6 +132,7 @@ const plugin: HermesPlugin = {
           area: PALETTE_AREA,
           data: {
             id: 'kanban.open',
+            action: 'kanban.open',
             label: ctx.i18n.t('openBoard'),
             keywords: ['kanban', 'board', 'tasks', 'agents'],
             run: () => host.navigate('/kanban')
@@ -148,6 +149,20 @@ const plugin: HermesPlugin = {
             run: newTask
           } satisfies PaletteContribution
         },
+        // [daveey] ⌘⇧K / Ctrl+Shift+K opens the board from anywhere. Fork:
+        // upstream's composer used this chord for "send next queued", which
+        // moved to ⌘⌥K so the board gets the shorter chord.
+        {
+          id: 'open',
+          area: KEYBINDS_AREA,
+          data: {
+            id: 'kanban.open',
+            category: 'navigation',
+            defaults: ['mod+shift+k'],
+            label: ctx.i18n.t('openBoard'),
+            run: () => host.navigate('/kanban')
+          } satisfies KeybindContribution
+        },
         {
           id: 'new-task',
           area: KEYBINDS_AREA,
