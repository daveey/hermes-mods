From 6fedc046230d63f7c38996a570f96e68809bbb9d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 04:57:51 +0000
Subject: [PATCH] [daveey] Consume runuser long-option values before
 classifying shell stdin

Why: the short-only wrapper option walker stopped at --group/--supp-group operands, hiding later -u and treating cat input as shell code. Recognize separate and glued value-bearing options, including -G and -w; never interpret their values as user switches.

Proof: generated order/value/user-spelling matrix plus flag-looking-value controls: 30 failures before fix, 213 session tests green; all 1885 lifecycle tests pass. Check health currently exposes unrelated stale-base file-size deltas; canonical ship rebase must clear these before publication. Addresses review 5901734512.
---
 cron/lifecycle_guard_nested_shells.py         | 21 +++++++++++++----
 .../test_lifecycle_guard_session_aliases.py   | 23 +++++++++++++++++++
 2 files changed, 39 insertions(+), 5 deletions(-)

diff --git a/cron/lifecycle_guard_nested_shells.py b/cron/lifecycle_guard_nested_shells.py
index e02fa1a3ac..07345662f7 100644
--- a/cron/lifecycle_guard_nested_shells.py
+++ b/cron/lifecycle_guard_nested_shells.py
@@ -103,9 +103,15 @@ _SUDO_VALUE_OPTIONS = frozenset("ugUCprtTh")
 _NESTED_SHELL_HINT_RE = re.compile(r"sh\b|\bsu(?:do)?\b|\b(?:exec|runuser|doas)\b")
 
 
-def _option_words(arguments: list[str], value_letters: frozenset[str]) -> tuple[list[str], int]:
-    """``(option words, index of the first operand)`` of a getopt-style argv tail; a short option
-    in *value_letters* consumes the next word unless the value is glued (``-uroot``)."""
+def _option_words(
+    arguments: list[str], value_letters: frozenset[str],
+    value_names: frozenset[str] = frozenset(),
+) -> tuple[list[str], int]:
+    """``(option words, index of the first operand)`` of a getopt-style argv tail.
+
+    Value-taking short and long options consume a separate value, but not a glued one.
+    Values never enter the returned option namespace, even when they look like flags.
+    """
     options: list[str] = []
     index = 0
     while index < len(arguments) and arguments[index].startswith("-") and arguments[index] != "-":
@@ -114,7 +120,9 @@ def _option_words(arguments: list[str], value_letters: frozenset[str]) -> tuple[
         if word == "--":
             break
         options.append(word)
-        if not word.startswith("--"):
+        if word.startswith("--"):
+            index += word in value_names  # `--name=value` already carries its value
+        else:
             for position, letter in enumerate(word[1:], 1):
                 if letter in value_letters:
                     index += position == len(word) - 1  # `-u root` takes the next word
@@ -169,7 +177,10 @@ def _nested_shell_input(view: list[str]) -> Optional[tuple[str, Optional[str]]]:
         direct_user = any(
             word == "--user" or word.startswith("--user=")
             or re.fullmatch(r"-[mpPl]*u.*", word)
-            for word in _option_words(options, frozenset("ucsg"))[0]
+            for word in _option_words(options, frozenset("ucsgGw"), frozenset({
+                "--user", "--command", "--session-command", "--shell", "--group",
+                "--supp-group", "--whitelist-environment",
+            }))[0]
         )
         if name == "su" or not direct_user:
             # Direct-user runuser executes argv, not a shell command string.
diff --git a/tests/cron/test_lifecycle_guard_session_aliases.py b/tests/cron/test_lifecycle_guard_session_aliases.py
index 5a20e2edbe..c07c60f9e5 100644
--- a/tests/cron/test_lifecycle_guard_session_aliases.py
+++ b/tests/cron/test_lifecycle_guard_session_aliases.py
@@ -309,6 +309,29 @@ def test_plain_child_shell_keeps_session_names(tmp_path, live_kanban_db, shape):
         False, None)
 
 
+@pytest.mark.parametrize("option", [
+    "--group root", "--group=root", "-g root", "-groot",
+    "--supp-group root", "--supp-group=root", "-G root", "-Groot",
+    "--whitelist-environment HOME", "--whitelist-environment=HOME", "-w HOME", "-wHOME",
+])
+@pytest.mark.parametrize("user", ["-u bob", "-ubob", "--user bob", "--user=bob", "-mu bob"])
+@pytest.mark.parametrize("first", [True, False])
+def test_runuser_value_options_preserve_direct_stdin(tmp_path, live_kanban_db, option, user, first):
+    """Option values must not hide direct-user mode: cat only receives inert input."""
+    options = f"{option} {user}" if first else f"{user} {option}"
+    text = f"runuser {options} -- cat <<< 't ( bash {live_kanban_db} )'"
+    assert scan_gateway_lifecycle(text, cwd=str(tmp_path), session_aliases=frozenset({"zz"})) == (
+        False, None)
+
+
+@pytest.mark.parametrize("option", ["--group", "--supp-group", "--whitelist-environment", "-g", "-G", "-w"])
+def test_runuser_option_value_is_not_user_switch(tmp_path, live_kanban_db, option):
+    """A flag-looking value cannot prove direct-user mode and suppress the shell walk."""
+    text = f"runuser {option} -u bob <<< 't ( bash {live_kanban_db} )'"
+    unsafe, refusal = scan_gateway_lifecycle(text, cwd=str(tmp_path), session_aliases=frozenset({"zz"}))
+    assert unsafe and refusal is not None and "SQLite" in refusal
+
+
