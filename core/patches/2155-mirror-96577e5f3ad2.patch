   // Card header line: the workspace this belongs to — the project when it
   // resolves (same function the session color reads, so name and tint agree;
@@ -540,11 +540,7 @@ function SidebarSessionRowImpl({
             not a working one: with several sessions busy the arcs drowned out
             the current task. Working state stays on the status dot [daveey]. */}
         {isSelected && <span aria-hidden="true" className="arc-border arc-row" />}
-        <SessionRowStatusStripe
-          outcomePainted={!userBlocked && !liveTurn}
-          session={session}
-          statusStripe={statusStripe}
-        />
+        <SessionRowStatusStripe outcomePainted={outcomePainted} session={session} statusStripe={statusStripe} />
         {/* #38072 finding 3: the row's body is a DIV, not a button — the
             reorder grabber (dnd-kit role="button" + tabIndex, kept for
             keyboard reorder, #83617) and the ⋯ trigger must be SIBLINGS of
diff --git a/apps/desktop/src/store/session-dot-state.ts b/apps/desktop/src/store/session-dot-state.ts
index 80dbbac5d6a..d8233627642 100644
--- a/apps/desktop/src/store/session-dot-state.ts
+++ b/apps/desktop/src/store/session-dot-state.ts
@@ -333,6 +333,12 @@ const derivedStatusStripe = (
   )
 }
 
+/** [daveey] Whether a stored outcome may paint the stripe: a ⌘B park or the chat's own live turn beats it, but work
+ *  that outlives the turn (a running card, a background job) does not. The stripe's tooltip must use this same test,
+ *  or a red decision stripe on a chat whose card is running shows no question. */
+export const outcomePaintsStripe = (state: SessionDotState, userBlocked: boolean): boolean =>
+  !userBlocked && !hasOwnLiveTurn(state)
+
 //  [daveey] `outcome`: the row's stored outcome (session-outcome contract). When present it wins over every derived
 //  input below; a ⌘B park and a live turn (working / quiet / needs-input) still beat it. Absent (an older backend)
 //  → the derivation below, unchanged.
@@ -348,7 +354,7 @@ export const sessionStatusStripe = (
   kanbanStalled = 0,
   outcome: null | SessionOutcome | undefined = null
 ): null | SessionStatusStripe => {
-  if (!userBlocked && !hasOwnLiveTurn(state)) {
+  if (outcomePaintsStripe(state, userBlocked)) {
     const fromOutcome = outcomeStripe(outcome)
 
     if (fromOutcome) {
