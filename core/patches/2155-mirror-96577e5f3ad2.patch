From 96577e5f3ad29042fa12eab298b9c45ef101abdb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 18:24:29 +0000
Subject: [PATCH] [daveey] fix(desktop): red decision stripe keeps its question
 tooltip while a linked card runs

The stripe let the stored outcome paint unless the chat's OWN turn was live
(hasOwnLiveTurn), but session-row gated the tooltip on hasLiveTurn, which also
counts 'background' (a running card or job). A chat with an open approval and a
running card painted red with no tooltip, so nothing said what was waiting.
Both now use outcomePaintsStripe(), returned by useSessionRowStripe.
---
 .../chat/sidebar/session-row-stripe.test.tsx  | 48 ++++++++++++++++++-
 .../app/chat/sidebar/session-row-stripe.tsx   |  5 +-
 .../src/app/chat/sidebar/session-row.tsx      |  8 +---
 apps/desktop/src/store/session-dot-state.ts   |  8 +++-
 4 files changed, 58 insertions(+), 11 deletions(-)

diff --git a/apps/desktop/src/app/chat/sidebar/session-row-stripe.test.tsx b/apps/desktop/src/app/chat/sidebar/session-row-stripe.test.tsx
index 6a53963f280..b6ba7cbc664 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row-stripe.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row-stripe.test.tsx
@@ -1,4 +1,4 @@
-import { cleanup, render } from '@testing-library/react'
+import { cleanup, render, renderHook } from '@testing-library/react'
 import { afterEach, expect, it } from 'vitest'
 
 import { $queuedPromptsBySession } from '@/store/composer-queue'
@@ -6,7 +6,7 @@ import { reconcilePendingSubmissions } from '@/store/pending-submissions'
 import { $sessions, setSessions } from '@/store/session'
 import type { SessionInfo } from '@/types/hermes'
 
-import { SessionRowStatusStripe } from './session-row-stripe'
+import { SessionRowStatusStripe, useSessionRowStripe } from './session-row-stripe'
 
 const row = (id: string, extra: Partial<SessionInfo> = {}): SessionInfo =>
   ({ id, message_count: 4, source: 'desktop', started_at: 0, title: id, ...extra }) as SessionInfo
@@ -44,3 +44,47 @@ it('a red with no paused queue card keeps its own explanation', () => {
 
   expect(stripe(container)?.getAttribute('aria-label')).toBeNull()
 })
+
+// [daveey] A chat with an open decision whose linked card is running (dot state `background`) paints red from its
+// outcome; the stripe's tooltip must name the question then too, not go blank because "something is running".
+it('a red decision stripe on a chat whose card is running still names the question', () => {
+  const session = row('decision-chat', {
+    kanban_active: 1,
+    outcome: {
+      at: 1,
+      items: [{ choices: [], id: 'req-1', question: 'Build A, B and C?', state: 'open' }],
+      kind: 'decision',
+      source: 'derived'
+    }
+  } as Partial<SessionInfo>)
+
+  setSessions([session])
+
+  const { result } = renderHook(() => useSessionRowStripe(session, 'background', true))
+
+  expect(result.current.statusStripe).toBe('stuck')
+  expect(result.current.outcomePainted).toBe(true)
+
+  const { container } = render(
+    <SessionRowStatusStripe
+      outcomePainted={result.current.outcomePainted}
+      session={session}
+      statusStripe={result.current.statusStripe}
+    />
+  )
+
+  expect(stripe(container)?.getAttribute('aria-label')).toBe('Build A, B and C?')
+})
+
+it('the chat\'s own live turn still beats the outcome, for the stripe and its tooltip alike', () => {
+  const session = row('working-chat', {
+    outcome: { at: 1, items: [{ choices: [], id: 'req-2', question: 'Q?', state: 'open' }], kind: 'decision', source: 'derived' }
+  } as Partial<SessionInfo>)
+
+  setSessions([session])
+
+  const { result } = renderHook(() => useSessionRowStripe(session, 'working', true))
+
+  expect(result.current.outcomePainted).toBe(false)
+  expect(result.current.statusStripe).not.toBe('stuck')
+})
diff --git a/apps/desktop/src/app/chat/sidebar/session-row-stripe.tsx b/apps/desktop/src/app/chat/sidebar/session-row-stripe.tsx
