From ca3394199fb148c68d5906242e2c7c32b6fc81c8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 22:05:49 +0000
Subject: [PATCH] fix(kanban): audit effective creation fields without changing
 enrollment [daveey]

---
 tests/tools/test_kanban_creation_audit.py | 50 +++++++++++++++++++++++
 tools/kanban_tools.py                     |  8 ++--
 2 files changed, 54 insertions(+), 4 deletions(-)
 create mode 100644 tests/tools/test_kanban_creation_audit.py

diff --git a/tests/tools/test_kanban_creation_audit.py b/tests/tools/test_kanban_creation_audit.py
new file mode 100644
index 00000000000..d2845a0191b
--- /dev/null
+++ b/tests/tools/test_kanban_creation_audit.py
@@ -0,0 +1,50 @@
+"""Creation diagnostics must describe the effective tool fields, not omitted arguments."""
+import json
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_placement as placement
+from hermes_cli import projects_db
+from tests.hermes_cli import test_kanban_portable_reason_audit as audit_support
+from tools import kanban_tools as kt
+
+kanban_home = audit_support.kanban_home
+
+
+@pytest.mark.parametrize("case,reason,policy", [
+    ("inherited-project", "uncarried option", None),
+    ("implicit-assignee", "assignee not allowlisted", None),
+    ("portable", None, "worker-first-v1"),
+    ("empty-project", None, "worker-first-v1"),
+    ("local-pin", None, None),
+])
+def test_effective_creation_audit_preserves_enrollment(kanban_home, tmp_path, monkeypatch, case, reason, policy):
+    monkeypatch.setattr(placement.reg, "self_gateway", lambda: "hub")
+    monkeypatch.setattr(kt, "_persisted_identity", lambda: "specialist" if case == "implicit-assignee" else "default")
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    args = {"title": "Analyze public data", "requires": []}
+    project_id = None
+    if case in {"inherited-project", "empty-project"}:
+        repo = tmp_path / "repo"
+        repo.mkdir()
+        with projects_db.connect_closing() as conn:
+            project_id = projects_db.create_project(conn, name="Audit", primary_path=str(repo))
+        with kbc.connect() as conn:
+            parent = kb.create_task(conn, title="Project owner", assignee="default", project_id=project_id)
+        monkeypatch.setenv("HERMES_KANBAN_TASK", parent)
+        if case == "empty-project":
+            args["project"] = ""
+    if case == "local-pin":
+        args["placement"] = "local"
+    result = json.loads(kt._handle_create(args))
+    assert result.get("ok"), result
+    with kbc.connect() as conn:
+        task = kb.get_task(conn, result["task_id"])
+        event = next(e for e in kb.list_events(conn, task.id) if e.kind == "created")
+        assert task.placement_policy == policy
+        assert task.assignee == ("specialist" if case == "implicit-assignee" else "default")
+        assert task.project_id == (project_id if case == "inherited-project" else None)
+        assert task.workspace_kind == ("worktree" if case == "inherited-project" else "scratch")
+        assert event.payload["portable_reason"] == reason
diff --git a/tools/kanban_tools.py b/tools/kanban_tools.py
index 6ab126b2d0c..78982cf628a 100644
--- a/tools/kanban_tools.py
+++ b/tools/kanban_tools.py
@@ -1555,11 +1555,11 @@ def _place_remote(args: dict, *, assignee: str, skills, parents, project_id, ses
         return None, None
 
 
-def _creation_audit(args: dict) -> Optional[dict]:
-    """Worker-pool enrollment audit for the ``created`` event (kanban_worker_placement.creation_audit). [daveey]"""
+def _creation_audit(args: dict, **effective) -> Optional[dict]:
+    """Audit the same normalized fields placement judged, including inherited identity/project. [daveey]"""
     from hermes_cli.kanban_worker_placement import creation_audit
 
-    return creation_audit(args)
+    return creation_audit({**args, **effective})
 
 
 @_kanban_handler("kanban_create")
@@ -1684,7 +1684,7 @@ def _handle_create(args: dict, **kw) -> str:
                 requires=args.get("requires"), runs_on=runs_on, max_retries=max_retries,
                 placement_policy=(marker_placement or {}).get("placement_policy"),
                 placement_checked=True,  # this front door already checked pins, origins and portability
-                placement_audit=_creation_audit(args),
+                placement_audit=_creation_audit(args, assignee=str(assignee), skills=skills, project_id=project_id),
                 require_declaration=origin_intent is None and declaration_required(),  # couriers exempt [daveey]
                 model_override=model_override, provider_override=provider_override,
                 goal_mode=goal_mode, goal_max_turns=_opt_int(args.get("goal_max_turns")),
