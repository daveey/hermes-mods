From 32b0dddb4d140ae263c01e257f670a9d5fc5da3f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:43:42 +0000
Subject: [PATCH] [daveey] Preserve disk-full recovery for structured errors

Review found codes-first normalization selected generic storage_failure for disk_full. Recognize the explicit code in the earlier disk-full rule. Prior tests only asserted non-unclassified plus action, missing the wrong recovery text/category. Three exact code-only, message and nested tests fail before and pass after (also kill omission of this added predicate); five focused suites 40 passed, TypeScript and scripts/check passed. Historical screenshot cause remains undetermined.
---
 .../desktop/src/store/notifications-objects.test.ts | 13 +++++++++++++
 apps/desktop/src/store/notifications.ts             |  2 +-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/store/notifications-objects.test.ts b/apps/desktop/src/store/notifications-objects.test.ts
index 58e5fbc2c1e9f7b44eb292505c954d0b0daf7e17..9b561b921de7a411e1b9217ffeed67fa1c7d4237 100644
--- a/apps/desktop/src/store/notifications-objects.test.ts
+++ b/apps/desktop/src/store/notifications-objects.test.ts
@@ -63,6 +63,19 @@ test('handles circular, deep and empty objects with bounded detail and no duplic
   expect($notifications.get()[0]?.detail).toContain('xxx')
 })
 
+test.each([
+  { code: 'disk_full' },
+  { code: 'disk_full', message: 'No space left on device' },
+  { error: { message: 'Request refused', data: { code: 'disk_full' } } }
+])('preserves specific disk-full recovery and telemetry: %j', error => {
+  const result = readableError(error, fallback)
+  expect(result.category).toBe('disk_full')
+  expect(result.message).toBe('Disk full — free some space, then try again.')
+  expect(result.action).toBeDefined()
+  notifyError(error, fallback)
+  expect($notifications.get()[0]?.message).toBe(result.message)
+})
+
 test.each(['storage_locked', 'disk_full', 'gateway_auth_failed', 'invalid_api_key'])(
   'retains classification code %s',
   code => {
diff --git a/apps/desktop/src/store/notifications.ts b/apps/desktop/src/store/notifications.ts
index 7c960d74707879d6440367098b7bbd2e6bbcef89..6a7016e397a75a01900a0187f4e2c9dc7e88a6c5 100644
--- a/apps/desktop/src/store/notifications.ts
+++ b/apps/desktop/src/store/notifications.ts
@@ -170,7 +170,7 @@ const ERROR_SUMMARIES: ErrorSummaryRule[] = [
     // generic length truncation so the user gets a clear "free space" toast
     // instead of a silent send or a raw errno dump.
     category: 'disk_full',
-    test: isDiskFullErrorMessage,
+    test: msg => isDiskFullErrorMessage(msg) || /['"]code['"]\s*:\s*['"]disk_full['"]/i.test(msg),
     summarize: () => translateNow('notifications.errors.diskFull'),
     action: () => RECOVERY_ACTIONS.openMaintenance()
   },
-- 
2.43.0

