Subject: [PATCH 6589] Desktop kanban model-requirement and recovery transport test harnesses

Public mirror of source commit def856111715b077c39d414e89437b9253b336ee.

---
diff --git a/apps/desktop/e2e/core/kanban-model-requirement.spec.ts b/apps/desktop/e2e/core/kanban-model-requirement.spec.ts
index 15ffc497689..44dc7ffaef3 100644
--- a/apps/desktop/e2e/core/kanban-model-requirement.spec.ts
+++ b/apps/desktop/e2e/core/kanban-model-requirement.spec.ts
@@ -201,7 +201,8 @@
       // Exercise a fresh read of the persisted card, independently of the
       // board's live-refresh subscription (the create producer was checked above).
       await page.reload()
-      await waitForInteractive(app, page)
+      // Reload preserves #/kanban, which has no chat composer. openDrawer waits
+      // for the persisted board card and then the real drawer's model selector.
       const drawer = await openDrawer(page, NEW_TITLE)
       await expect(modelSelect(drawer)).toHaveValue('class:fast')
       await modelSelect(drawer).selectOption('')
