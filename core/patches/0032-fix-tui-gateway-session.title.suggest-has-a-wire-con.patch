From b63c7fca56f5a040f6eb336ee15d362d702a695d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 13 Oct 2026 16:50:36 -0700
Subject: [PATCH] fix(tui-gateway): session.title.suggest has a wire contract
 [daveey]

---
 apps/shared/src/gateway-contract.generated.ts | 13 +++
 apps/shared/src/gateway-contract.openrpc.json | 88 +++++++++++++++++++
 tui_gateway/contracts/sessions.py             | 17 ++++
 3 files changed, 118 insertions(+)

diff --git a/apps/shared/src/gateway-contract.generated.ts b/apps/shared/src/gateway-contract.generated.ts
index d9f414977a..95ccf29ca8 100644
--- a/apps/shared/src/gateway-contract.generated.ts
+++ b/apps/shared/src/gateway-contract.generated.ts
@@ -3268,6 +3268,16 @@ export interface SessionTitleResult {
   session_key?: string | null
   pending?: boolean | null
 }
+/** ``session_key`` (stored) or ``session_id`` (live runtime id first, else stored id / key). */
+export interface SessionTitleSuggestParams {
+  session_id?: string | null
+  session_key?: string | null
+  profile?: string | null
+}
+export interface SessionTitleSuggestResult {
+  session_key: string
+  title?: string | null
+}
 /** ``session_id`` is a live runtime id first, else a stored id / key / title. */
 export interface SessionSetHiddenParams {
   session_id: string
@@ -5450,6 +5460,8 @@ export interface RpcMethods {
   'session.take_over': { params: SessionParams; result: SessionTakeOverResult }
   /** Read or set a live session's title; a title set before the row exists is queued. */
   'session.title': { params: SessionTitleParams; result: SessionTitleResult }
+  /** Suggest a short (2-4 lowercase words) name from the transcript; read-only (Desktop rename pre-fill). */
+  'session.title.suggest': { params: SessionTitleSuggestParams; result: SessionTitleSuggestResult }
   /** Drop the last user turn (and everything after it) from an idle session. */
   'session.undo': { params: SessionUndoParams; result: SessionUndoResult }
   /** Token / context / cost counters for the session (+ Nous credit lines when available). */
@@ -5768,6 +5780,7 @@ export const RPC_METHODS = [
   'session.steer',
   'session.take_over',
   'session.title',
+  'session.title.suggest',
   'session.undo',
   'session.usage',
   'session.workspace.move',
diff --git a/apps/shared/src/gateway-contract.openrpc.json b/apps/shared/src/gateway-contract.openrpc.json
index 8c8053230c..c8f780fa38 100644
--- a/apps/shared/src/gateway-contract.openrpc.json
+++ b/apps/shared/src/gateway-contract.openrpc.json
@@ -3696,6 +3696,24 @@
         }
       }
     },
+    {
+      "name": "session.title.suggest",
+      "summary": "Suggest a short (2-4 lowercase words) name from the transcript; read-only (Desktop rename pre-fill).",
+      "params": [
+        {
+          "name": "params",
+          "schema": {
+            "$ref": "#/components/schemas/SessionTitleSuggestParams"
+          }
+        }
+      ],
+      "result": {
+        "name": "result",
+        "schema": {
+          "$ref": "#/components/schemas/SessionTitleSuggestResult"
+        }
+      }
+    },
     {
       "name": "session.undo",
       "summary": "Drop the last user turn (and everything after it) from an idle session.",
@@ -32726,6 +32744,76 @@
         "title": "SessionTitleResult",
         "type": "object"
       },
+      "SessionTitleSuggestParams": {
+        "additionalProperties": false,
+        "description": "``session_key`` (stored) or ``session_id`` (live runtime id first, else stored id / key).",
+        "properties": {
+          "session_id": {
+            "anyOf": [
+              {
+                "type": "string"
+              },
+              {
+                "type": "null"
+              }
+            ],
+            "default": null,
+            "title": "Session Id"
+          },
+          "session_key": {
+            "anyOf": [
+              {
+                "type": "string"
+              },
+              {
+                "type": "null"
+              }
+            ],
+            "default": null,
+            "title": "Session Key"
+          },
+          "profile": {
+            "anyOf": [
+              {
+                "type": "string"
+              },
+              {
+                "type": "null"
+              }
+            ],
+            "default": null,
+            "title": "Profile"
+          }
+        },
+        "title": "SessionTitleSuggestParams",
+        "type": "object"
+      },
+      "SessionTitleSuggestResult": {
+        "additionalProperties": false,
+        "properties": {
+          "session_key": {
+            "title": "Session Key",
+            "type": "string"
+          },
+          "title": {
+            "anyOf": [
+              {
+                "type": "string"
+              },
+              {
+                "type": "null"
+              }
+            ],
+            "default": null,
+            "title": "Title"
+          }
+        },
+        "required": [
+          "session_key"
+        ],
+        "title": "SessionTitleSuggestResult",
+        "type": "object"
+      },
       "SessionUndoParams": {
         "additionalProperties": false,
         "properties": {
diff --git a/tui_gateway/contracts/sessions.py b/tui_gateway/contracts/sessions.py
index b0f118dd28..55034f1aee 100644
--- a/tui_gateway/contracts/sessions.py
+++ b/tui_gateway/contracts/sessions.py
@@ -321,6 +321,23 @@ method("session.title", params=SessionTitleParams, result=SessionTitleResult,
        doc="Read or set a live session's title; a title set before the row exists is queued.")
 
 
+class SessionTitleSuggestParams(Params):
+    """``session_key`` (stored) or ``session_id`` (live runtime id first, else stored id / key)."""
+
+    session_id: str | None = None
+    session_key: str | None = None
+    profile: str | None = None
+
+
+class SessionTitleSuggestResult(Result):
+    session_key: str
+    title: str | None = None  # None: nothing could be suggested
+
+
+method("session.title.suggest", params=SessionTitleSuggestParams, result=SessionTitleSuggestResult,
+       doc="Suggest a short (2-4 lowercase words) name from the transcript; read-only (Desktop rename pre-fill).")
+
+
 class SessionSetHiddenParams(Params):
     """``session_id`` is a live runtime id first, else a stored id / key / title."""
 
-- 
2.55.0

