From 654e782900b040bc970c4911e18af4bd59e65820 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 06:59:12 +0000
Subject: [PATCH] [daveey] Keep malformed inventory wire responses retryable

---
 hermes_cli/kanban_origin_forward_adapter.py   | 10 +++-
 .../hermes_cli/test_origin_inventory_wire.py  | 54 +++++++++++++++++++
 2 files changed, 63 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_cli/test_origin_inventory_wire.py

diff --git a/hermes_cli/kanban_origin_forward_adapter.py b/hermes_cli/kanban_origin_forward_adapter.py
index 68bfce52ffecf519e0bfd811f4440c2e08b2adbb..a61407dad18971497c0e21833bd1179dd34c96d2 100644
--- a/hermes_cli/kanban_origin_forward_adapter.py
+++ b/hermes_cli/kanban_origin_forward_adapter.py
@@ -34,11 +34,19 @@ def receive(request):
         # Construct lazily: durable replay needs neither a live lease nor network.
         return read_lease(Hub(load_identity()), board, task)
 
+    def inventory():
+        # Decode failures describe unavailable remote evidence, not a bad caller
+        # request. Keep this normalization inside the inventory-read boundary.
+        try:
+            return Hub(load_identity()).machines()
+        except (ValueError, RecursionError) as exc:
+            raise ValueError("origin_forward_inventory_unavailable") from exc
+
     from hermes_cli.kanban_origin_native import lookup as native_lookup
     outbound = prepare(request, path=home / "kanban/origin-forward.db",
                        native_lookup=lambda origin, creator: native_lookup(origin, creator, gateway=gateway),
                        ledger=home / "kanban/origin-ledger.db", gateway=gateway, profile=profile,
-                       inventory_lookup=lambda: Hub(load_identity()).machines(),
+                       inventory_lookup=inventory,
                        lease_lookup=lookup, now_ms=lambda: int(time.time() * 1000),
                        session_exists=lambda sid: bool(_resolve_session(home / "state.db", sid)))
     return {"status": "prepared", "handoff_complete": False, "outbound": outbound}
diff --git a/tests/hermes_cli/test_origin_inventory_wire.py b/tests/hermes_cli/test_origin_inventory_wire.py
new file mode 100644
index 0000000000000000000000000000000000000000..58d7f2984b6d3fbce8a1c25e3b950606b7d1e01a
--- /dev/null
+++ b/tests/hermes_cli/test_origin_inventory_wire.py
@@ -0,0 +1,54 @@
+"""Inventory wire failures remain retryable without freezing an outbound."""
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+import pytest
+
+from tests.hermes_cli import test_origin_forward_adapter as adapter
+
+world = adapter.world
+envelope = adapter.envelope
+
+
+@pytest.mark.parametrize("broken", [b'{broken-json', b'\xff', b'[]', b'null'])
+def test_inventory_wire_failure_recovers(world, envelope, monkeypatch, capsys, broken):
+    from hermes_cli import kanban_sync_client as client
+
+    payload = [broken]
+    requests = []
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_GET(self):
+            requests.append(self.path)
+            raw = payload[0]
+            self.send_response(200)
+            self.send_header('Content-Length', str(len(raw)))
+            self.end_headers()
+            self.wfile.write(raw)
+
+        def log_message(self, *args):
+            pass
+
+    server = HTTPServer(('127.0.0.1', 0), Handler)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    hub = client.Hub(client.Identity(url=f'http://127.0.0.1:{server.server_port}', gateway='origin', key='fixture'))
+    monkeypatch.setattr(client.Hub, 'machines', lambda self: hub._call('GET', '/v2/machines'))
+    try:
+        result = adapter.invoke(world, monkeypatch, capsys, envelope)
+        assert result == {'status': 'pending', 'code': 'origin_forward_inventory_unavailable',
+                          'handoff_complete': False}
+        payload[0] = json.dumps({'me': 'origin', 'machines': [
+            {'name': 'origin', 'state': 'active'}, {'name': 'owner', 'state': 'active'}]}).encode()
+        first = adapter.invoke(world, monkeypatch, capsys, envelope)
+        assert first['status'] == 'prepared'
+        assert requests == ['/v2/machines', '/v2/machines']
+        payload[0] = broken
+        assert adapter.invoke(world, monkeypatch, capsys, envelope) == first
+        assert len(requests) == 2  # Durable replay does not touch inventory.
+    finally:
+        hub.close()
+        server.shutdown()
+        server.server_close()
+        thread.join()
