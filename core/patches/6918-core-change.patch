From 377c0e0e2253ae0a5c1cf68ffffb13f1edf94998 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 26 Nov 2026 12:52:15 +0000
Subject: [PATCH 6918] Replay sender: durable single-slot journal, deferred observation and bounded recovery (dormant)

Public mirror of source commit 377c0e0e2253ae0a5c1cf68ffffb13f1edf94998.

---
diff --git a/hermes_cli/kanban_replay_values.py b/hermes_cli/kanban_replay_values.py
index 811bd0dfb7ef74ef4490c1c7a91c0f47aa1f5742..5f0c36c0143ce1f233aaa306d93b018ceb9289e6 100644
--- a/hermes_cli/kanban_replay_values.py
+++ b/hermes_cli/kanban_replay_values.py
@@ -27,6 +27,11 @@
     for key in ('hlc', 'origin_gateway'):
         if image.get(key) is not None and not isinstance(image[key], str):
             raise ValueError(f'invalid replay current-row {key}')
+    if table == 'tasks':  # LOCAL columns the lease mirror still binds from the wire
+        if image.get('lease_holder') is not None and not isinstance(image['lease_holder'], str):
+            raise ValueError('invalid replay current-row lease_holder')
+        if image.get('lease_expires') is not None:
+            integer(image['lease_expires'], 'current-row lease_expires')
     allowed = sync.SYNCED_COLUMNS[table] | sync.SERVER_COLUMNS.get(table, frozenset())
     for column in conn.execute(f'PRAGMA table_info({table})'):
         name, kind = column[1], column[2].upper()
diff --git a/tests/hermes_cli/kanban_replay_field_matrix_support.py b/tests/hermes_cli/kanban_replay_field_matrix_support.py
index ce67e183b6c1ced99e6d56063efddec2ad699bd2..bf64638086cbeedcdc2980b8a833eb41c3cd1fe2 100644
--- a/tests/hermes_cli/kanban_replay_field_matrix_support.py
+++ b/tests/hermes_cli/kanban_replay_field_matrix_support.py
@@ -22,7 +22,8 @@
     'verdict': ('client_op_id', 'status', 'version', 'row', 'source_predecessor', 'reason', 'detail', 'deferred'),
     'reply': ('protocol', 'results', 'consumed', 'outcome_unknown', 'dup', 'sequence', 'h', 'payload_sha256'),
     'evidence': ('board', 'table', 'uid', 'state', 'head', 'row'),
-    'image': ('uid', 'version', 'deleted_at', 'hlc', 'origin_gateway', 'title', 'created_at'),
+    'image': ('uid', 'version', 'deleted_at', 'hlc', 'origin_gateway', 'title', 'created_at',
+              'lease_holder', 'lease_expires'),
 }
 REPLY_TRANSPORT_ONLY = {('verdict', 'row'), ('verdict', 'source_predecessor')}
 CASES = [(envelope, field) for envelope, fields in FIELDS.items() for field in fields]
@@ -76,7 +77,8 @@
         return True
     if envelope == 'image':
         return ((field == 'deleted_at' and value is None) or
-                (field in ('hlc', 'origin_gateway') and (value is None or value == '3')) or
+                (field == 'lease_expires' and value is None) or
+                (field in ('hlc', 'origin_gateway', 'lease_holder') and (value is None or value == '3')) or
                 (field == 'title' and value == '3') or
                 (field == 'created_at' and type(value) is int and value == -1))
     return False
