From 676f732d0b113f972470500d653886cafc16c748 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 14:42:17 -0800
Subject: [PATCH] test(cron): a['$(bash SCRIPT)']=1 executes only on Bash >= 4;
 pin Bash 3.2's literal subscript

The macOS-only lane (run 43645454916, job 132602112917 on the mini, main
cb213ed257) failed test_executed_arithmetic_substitutions_are_sinks for the
single-quoted indexed-array subscript shape, first attempt and retry. The
mini's bash is /bin/bash 3.2.57: it keeps a quoted subscript literal and fails
the arithmetic ("operand expected") before any substitution runs, so the
marker file is never created. Bash 5.3 runs the substitution (marker created).
The guard assertions (substitution_in_arithmetic, output_reaches_shell, the
padded-script refusal) hold on both; only the execution proof is
version-dependent.

On Bash < 4 the case now pins the literal behaviour (no marker, nonzero exit,
"operand expected"), so a change either way still shows; Bash >= 4 keeps the
marker assertion.

RED on main 3f93310ecf with /bin/bash 3.2.57 first on PATH: 1 failed
(this case); Homebrew bash 5.3.9 first: 29 passed.
GREEN at this commit: 29 passed under both.
Mutants: gate `< 4` -> `< 3` and an empty LITERAL_IN_BASH3 fail under 3.2;
dropping the version check fails under 5.3.
---
 .../test_lifecycle_guard_arith_lexical.py     | 22 ++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/tests/cron/test_lifecycle_guard_arith_lexical.py b/tests/cron/test_lifecycle_guard_arith_lexical.py
index 2dc639e4da..dc48bab814 100644
--- a/tests/cron/test_lifecycle_guard_arith_lexical.py
+++ b/tests/cron/test_lifecycle_guard_arith_lexical.py
@@ -27,6 +27,20 @@ SHAPES = [
     r"(( ')' )); a[$(echo b[\$\(bash SCRIPT\)])]=1; echo \'",
     "(( ')' ))\n" r"a[$(echo b[\$\(bash SCRIPT\)])]=1; echo \'",
 ]
+# Bash 3.2 (macOS /bin/bash, as on the mini's CI runner) keeps a single-quoted
+# indexed-array subscript literal and fails its arithmetic before any
+# substitution runs; Bash 5 runs the substitution. The guard refuses the shape
+# on every version (fail-closed); only the execution proof depends on it.
+LITERAL_IN_BASH3 = {"a['$(bash SCRIPT)']=1"}
+
+
+def _bash_major(bash):
+    probe = subprocess.run(
+        [bash, "--noprofile", "--norc", "-c", "echo ${BASH_VERSINFO[0]}"],
+        env={"PATH": "/usr/bin:/bin"}, capture_output=True, text=True,
+        encoding="utf-8", timeout=10, check=True,
+    )
+    return int(probe.stdout.strip())
 
 
 @pytest.mark.platforms("posix")
@@ -55,7 +69,13 @@ def test_executed_arithmetic_substitutions_are_sinks(tmp_path, shape):
         encoding="utf-8", timeout=10, check=False,
     )
     # Invalid arithmetic can error only AFTER the command substitution has run.
-    assert marker.exists(), (result.returncode, result.stderr)
+    if shape in LITERAL_IN_BASH3 and _bash_major(bash) < 4:
+        # Pin Bash 3.2's literal subscript too, so a change either way shows.
+        assert not marker.exists(), (result.returncode, result.stderr)
+        assert result.returncode != 0 and "operand expected" in result.stderr, (
+            result.returncode, result.stderr)
+    else:
+        assert marker.exists(), (result.returncode, result.stderr)
     assert substitution_in_arithmetic(command, date_exempt=True)
     assert output_reaches_shell(command)
     script.write_text("# padding\n" * 150000, encoding="utf-8")
-- 
