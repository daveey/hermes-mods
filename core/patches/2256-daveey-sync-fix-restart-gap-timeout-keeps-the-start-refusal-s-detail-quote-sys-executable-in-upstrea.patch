From f7bfd1b6f4ae17bc636e76a1b54eae7ec30198a1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 22:19:47 -0800
Subject: [PATCH] [daveey] sync fix: restart-gap timeout keeps the start
 refusal's detail; quote sys.executable in upstream test

Full suite on 9f84f76fc8 (run 42964576794) failed test_ensure_reports_which_unit_check_failed (detail None:
the fork's restart-gap wait rebuilt a bare refusal) and test_shell_lines_quote_the_interpreter (upstream test
line used an unquoted sys.executable).
---
 hermes_cli/gateway_runtime.py                         |  8 +++++---
 tests/hermes_cli/test_gateway_runtime_restart_gap.py  | 11 +++++++++++
 .../hermes_cli/test_gateway_runtime_service_detail.py |  3 ++-
 3 files changed, 18 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/gateway_runtime.py b/hermes_cli/gateway_runtime.py
index 0b217819ea6..f69c7687443 100644
--- a/hermes_cli/gateway_runtime.py
+++ b/hermes_cli/gateway_runtime.py
@@ -443,11 +443,12 @@ def _observe_replacing_stale(home: Path, deadline: float, replaced: set[Path]) -
 
 def _recover_start_refusal(home: Path, deadline: float, refusal: GatewayDiscovery) -> GatewayDiscovery:
     if refusal.reason_code == "service_identity_unverified":
-        return _await_unverified_service_owner(home, deadline)
+        return _await_unverified_service_owner(home, deadline, refusal)
     return refusal
 
 
-def _await_unverified_service_owner(home: Path, deadline: float) -> GatewayDiscovery:
+def _await_unverified_service_owner(home: Path, deadline: float,
+                                    refusal: GatewayDiscovery | None = None) -> GatewayDiscovery:
     """Observe only during a supervisor restart gap; never run an unverified definition.
 
     A custom launcher cannot be safely interpreted, but its returning private
@@ -469,7 +470,8 @@ def _await_unverified_service_owner(home: Path, deadline: float) -> GatewayDisco
                 return observed
             time.sleep(min(0.1, remaining(deadline)))
     except TimeoutError:
-        return GatewayDiscovery("inaccessible", reason_code="service_identity_unverified")
+        # The start refusal itself, with its detail (which unit check failed), not a bare code.
+        return refusal or GatewayDiscovery("inaccessible", reason_code="service_identity_unverified")
 
 
 def ensure_gateway_runtime(profile_home: str | Path, *, timeout: float | None = None,
diff --git a/tests/hermes_cli/test_gateway_runtime_restart_gap.py b/tests/hermes_cli/test_gateway_runtime_restart_gap.py
index d7329fe4eba..f8312471527 100644
--- a/tests/hermes_cli/test_gateway_runtime_restart_gap.py
+++ b/tests/hermes_cli/test_gateway_runtime_restart_gap.py
@@ -139,3 +139,14 @@ def test_observation_keeps_waiting_through_starting_until_owner_verdict(tmp_path
     monkeypatch.setattr(runtime, "discover_gateway_endpoint", lambda *args, **kwargs: next(seq))
     monkeypatch.setattr(time, "sleep", lambda duration: None)
     assert runtime._await_unverified_service_owner(tmp_path, time.monotonic() + 5) is ready
+
+
+def test_an_owner_that_never_returns_keeps_the_start_refusal_and_its_detail(tmp_path, monkeypatch):
+    now = [100.0]
+    monkeypatch.setattr(time, "monotonic", lambda: now[0])
+    monkeypatch.setattr(time, "sleep", lambda duration: now.__setitem__(0, now[0] + duration))
+    monkeypatch.setattr(runtime, "_update_fenced", lambda homes: False)
+    monkeypatch.setattr(runtime, "discover_gateway_endpoint", lambda *args, **kwargs: runtime.GatewayDiscovery("absent"))
+    refusal = runtime.GatewayDiscovery("inaccessible", reason_code="service_identity_unverified",
+                                       detail="unit runs as DynamicUser=yes")
+    assert runtime._await_unverified_service_owner(tmp_path, 105.0, refusal) == refusal
diff --git a/tests/hermes_cli/test_gateway_runtime_service_detail.py b/tests/hermes_cli/test_gateway_runtime_service_detail.py
index 18a0e85be89..978411d7f5a 100644
--- a/tests/hermes_cli/test_gateway_runtime_service_detail.py
+++ b/tests/hermes_cli/test_gateway_runtime_service_detail.py
@@ -8,6 +8,7 @@ which Desktop prints after the code.
 import json
 import os
 from pathlib import Path
+import shlex
 import sys
 import time
 from types import SimpleNamespace
@@ -154,7 +155,7 @@ def test_ensure_reports_which_unit_check_failed(case, needles, tmp_path, monkeyp
     unit.parent.mkdir(parents=True)
     unit.write_text("[Service]\n", encoding="utf-8")
     command = "/bin/echo hermes_cli.main gateway run" if case == "wrong_command" else (
-        f"{sys.executable} -m hermes_cli.main gateway run")
+        f"{shlex.quote(sys.executable)} -m hermes_cli.main gateway run")
     props = dict(LoadState="loaded", ActiveState="inactive", SubState="dead", UnitFileState="enabled",
                  User=str(os.getuid()), DynamicUser="yes" if case == "dynamic_user" else "no",
                  Environment=f'"HERMES_HOME={home}" "HERMES_SUPERVISED_CHILD=1"',
-- 
