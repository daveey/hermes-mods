From 128f1053edfd77d8dbecfbb9d0f382b10abb13e8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 00:53:44 +0000
Subject: [PATCH] fix(kanban): require live refusal before repeating unchecked
 walls [daveey]

Unchecked wall listings previously instructed workers to reassert stale external incidents without trying the affected capability. Require an attempt or provider free read in this run, and quote its refusal before reasserting. Keep checked-wall instructions and shared_blocker_guard unchanged. Regression covers unchecked-only and mixed contexts for probe and unrelated cards: 4 RED failures, 16 GREEN livelock tests, 765 passing tests across 36 shared-blocker consumer files.
---
 hermes_cli/kanban_shared_blockers.py           | 17 ++++++++---------
 .../test_kanban_shared_blocker_livelock.py     | 18 ++++++++++++++++++
 2 files changed, 26 insertions(+), 9 deletions(-)

diff --git a/hermes_cli/kanban_shared_blockers.py b/hermes_cli/kanban_shared_blockers.py
index d2e8f9a57fcec5d84bbf2fd911a61bb061c6ff51..9b7fee85c82f289d8246def0463b4a1d81b465c3 100644
--- a/hermes_cli/kanban_shared_blockers.py
+++ b/hermes_cli/kanban_shared_blockers.py
@@ -842,18 +842,17 @@ def render_blocker_context(conn: sqlite3.Connection, task_id: str) -> str:
         return ""
     from hermes_cli.kanban_shared_blocker_checks import registered_checks
     checks = registered_checks()
+    unchecked_rule = ("For walls without a registered check: The listing is not evidence. "
+                      "When your next step needs the walled capability, try it, or run the provider's "
+                      "own free read. End with the same `blocker_id` only if that attempt in this run "
+                      "was refused, and quote the refusal in the reason; only one card probes a "
+                      "blocker at a time.")
     lines = ["## Open shared blockers on this board",
-             "External walls other cards already hit. Stop early only when the step this run is about "
-             "to take needs the walled capability; then end "
-             "with kanban_block/kanban_continue passing the same `blocker_id` instead of rediscovering "
-             "it; only one card probes a blocker at a time. A timed wait (kind='time' or a "
-             "SCHEDULED_UNTIL= reason) keeps its wake time and wake_check when it also passes "
-             "blocker_id."]
+             unchecked_rule + " A timed wait (kind='time' or a SCHEDULED_UNTIL= reason) keeps its "
+             "wake time and wake_check when it also passes blocker_id."]
     if any(st.blocker_id in checks for st in states):
         lines[1] = ("For walls with a registered check, never re-assert from this context alone: "
-                    "run the live check when your next step needs the capability. For walls without a "
-                    "registered check, stop at the affected step and end with the same blocker_id; "
-                    "only one card probes those walls at a time.")
+                    "run the live check when your next step needs the capability. " + unchecked_rule)
     model, provider, lane = task_route(conn, task_id)
     lines.append(f"Current route: provider={provider or 'unknown'}, model={model or 'unknown'}, lane={lane}.")
     lines.append("Provider-scoped walls apply only to that provider. Continue unrelated work; if a later "
diff --git a/tests/hermes_cli/test_kanban_shared_blocker_livelock.py b/tests/hermes_cli/test_kanban_shared_blocker_livelock.py
index 9f0352ca47c7ee15a90edcacc9d0bc7b2df71066..0f752b40459487e155f744ecfdaf9d2bc6078014 100644
--- a/tests/hermes_cli/test_kanban_shared_blocker_livelock.py
+++ b/tests/hermes_cli/test_kanban_shared_blocker_livelock.py
@@ -106,6 +106,24 @@ def test_non_probe_context_requires_live_check(kanban_home):
         assert 'instead of rediscovering' not in text
 
 
+@pytest.mark.parametrize('with_checked_wall', [False, True])
+@pytest.mark.parametrize('is_probe', [False, True])
+def test_unchecked_wall_requires_this_runs_refusal(kanban_home, with_checked_wall, is_probe):
+    with kbc.connect_closing() as conn:
+        carrier = helpers._blocked_behind(conn, 'old outage', blocker_id='unchecked-provider-wall')
+        if with_checked_wall:
+            helpers._blocked_behind(conn, 'quota', blocker_id='github-quota-reserve')
+        text = blockers.render_blocker_context(conn, carrier if is_probe else 'unrelated-card')
+        assert 'The listing is not evidence' in text
+        assert "try it, or run the provider's own free read" in text
+        assert 'only if that attempt in this run was refused' in text
+        assert 'quote the refusal in the reason' in text
+        assert 'stop at the affected step and end with the same blocker_id' not in text
+        assert 'instead of rediscovering' not in text
+        if with_checked_wall:
+            assert 'Never re-assert without a live check' in text
+
+
 def test_promoted_card_after_reset_checks_before_continuing(kanban_home, monkeypatch):
     from hermes_cli import config, kanban_shared_blocker_checks as checks
 
