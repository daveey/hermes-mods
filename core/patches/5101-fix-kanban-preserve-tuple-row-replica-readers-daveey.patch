From 76500ae4aa9c5cb211e3af4ecdf4fa90741c58f5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 05:59:51 +0000
Subject: [PATCH] fix(kanban): preserve tuple-row replica readers [daveey]

The replica enrichment caller can use the default tuple row factory. Read the explicit task projection positionally without mutating connection policy. Cover tuple and sqlite Row callers with both legacy and containment schemas.

Proof: existing remote suite red with AttributeError before fix; added row-factory matrix red for tuple callers, green after. 56 tests passed across remote/details/lockguard/relay/local-replica; scripts/check --base origin/main: 21 checks ok.
---
 .../kanban_session_activity_card_details.py    |  4 ++--
 .../test_kanban_blocked_upstream_remote.py     | 18 ++++++++++++++++++
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_session_activity_card_details.py b/hermes_cli/kanban_session_activity_card_details.py
index 5d25bb92b9..1179efbd05 100644
--- a/hermes_cli/kanban_session_activity_card_details.py
+++ b/hermes_cli/kanban_session_activity_card_details.py
@@ -108,8 +108,8 @@ def _task_info(conn: sqlite3.Connection, replica: sqlite3.Connection | None, tas
             rows = _query(src, "SELECT id, status FROM tasks WHERE id=?", (task_id,))
         if rows:
             row = rows[0]
-            episode = row["containment_episode"] if "containment_episode" in row.keys() else None
-            return {"id": row["id"], "status": row["status"], "episode": episode}
+            episode = row[2] if len(row) > 2 else None
+            return {"id": row[0], "status": row[1], "episode": episode}
     return None
 
 
diff --git a/tests/hermes_cli/test_kanban_blocked_upstream_remote.py b/tests/hermes_cli/test_kanban_blocked_upstream_remote.py
index df917c2632..73431f60b1 100644
--- a/tests/hermes_cli/test_kanban_blocked_upstream_remote.py
+++ b/tests/hermes_cli/test_kanban_blocked_upstream_remote.py
@@ -71,6 +71,24 @@ def test_replica_stamp_precedence_and_ineligible_cards(status):
         assert "blocked_upstream" not in result
 
 
+@pytest.mark.parametrize("row_factory", [None, sqlite3.Row])
+@pytest.mark.parametrize("with_episode", [False, True])
+def test_task_info_supports_caller_row_factory(row_factory, with_episode):
+    from hermes_cli.kanban_session_activity_card_details import _task_info
+
+    with sqlite3.connect(":memory:") as conn:
+        conn.row_factory = row_factory
+        conn.execute("CREATE TABLE tasks(id TEXT, status TEXT)")
+        conn.execute("INSERT INTO tasks VALUES ('parent', 'triage')")
+        if with_episode:
+            conn.execute("ALTER TABLE tasks ADD COLUMN containment_episode TEXT")
+            conn.execute("UPDATE tasks SET containment_episode='episode'")
+        assert _task_info(conn, None, "parent") == {
+            "id": "parent", "status": "triage", "episode": "episode" if with_episode else None,
+        }
+        assert conn.row_factory is row_factory
+
+
 @pytest.mark.parametrize("transport", ["stamped", "graph", "old"])
 def test_replica_session_tasks_preserves_optional_ancestor(tmp_path, monkeypatch, transport):
     path = tmp_path / "replica.db"
