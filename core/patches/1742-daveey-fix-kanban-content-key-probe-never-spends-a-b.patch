From ec2cfc7b9319ddfe09bcabe808a05bea7dc9efa7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 20:51:41 +0000
Subject: [PATCH] [daveey] fix(kanban): content-key probe never spends a busy
 board's read budget

The annotation fingerprint and per-board memo each probe the board's content
revision through cached_ro before the real read. Since reader opens retry for
a 0.5 s busy budget (PR #475), a board held by a writer cost every poll three
full budgets (~1.5 s) instead of one, and overlapping cold polls serialized
past the 4 s bound in test_busy_board_open_does_not_block_session_poll.
The probe already falls back to the file stat on any sqlite error, so it now
opens with a zero budget and takes that fallback at once.
---
 hermes_cli/kanban_reader_lifecycle.py | 4 ++--
 hermes_cli/kanban_session_activity.py | 9 +++++----
 2 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_reader_lifecycle.py b/hermes_cli/kanban_reader_lifecycle.py
index 33ee825e0ae..62dce1f1cf1 100644
--- a/hermes_cli/kanban_reader_lifecycle.py
+++ b/hermes_cli/kanban_reader_lifecycle.py
@@ -6,8 +6,8 @@ import threading
 from hermes_cli.kanban_generation import DeletedWalGenerationError, lifecycle_access, retry_open
 
 
-def cached_entry(path):
-    return retry_open(lambda remaining: _cached_entry_once(path, remaining), 0.5)
+def cached_entry(path, busy_budget=0.5):
+    return retry_open(lambda remaining: _cached_entry_once(path, remaining), busy_budget)
 
 
 def _cached_entry_once(path, remaining):
diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index 91c06bb6948..38dcefe439d 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -513,14 +513,14 @@ register_reader_cache(evict_readers)
 
 
 @contextlib.contextmanager
-def cached_ro(path: Path) -> Iterator[sqlite3.Connection]:
+def cached_ro(path: Path, *, busy_budget: float = 0.5) -> Iterator[sqlite3.Connection]:
     """A shared read-only connection to ``path``, held exclusively for the ``with`` body. Reopened when the file is
     replaced (new inode: a rebuilt replica), after any sqlite error, or when its ``-shm`` generation is gone (the
     connection is stranded on a deleted WAL index and would fail with ``disk I/O error`` or read stale rows until
     restart; kanban-759104eb56). Raises ``sqlite3.OperationalError`` when the file is missing, like ``_open_ro``."""
     from hermes_cli.kanban_reader_lifecycle import cached_entry
 
-    key, entry = cached_entry(path)
+    key, entry = cached_entry(path, busy_budget)
     conn, _ident, lock, _shm = entry
     with lock:  # bodies read every result they start: an unfinished cursor would pin a WAL snapshot
         with _RO_CACHE_LOCK:
@@ -874,8 +874,9 @@ def _shadow_fingerprint() -> tuple:
 
 
 def _board_content_key(path: Path, tables: tuple[str, ...] = _revision.LOCAL_TABLES) -> tuple:
-    """Changes on every write to a row the activity readers read in ``path`` (stat fallback without the counter)."""
-    return _revision.content_key(path, tables, cached_ro)
+    """Changes on every write to a row the activity readers read in ``path`` (stat fallback without the counter, or
+    at once while the board is busy: this probe precedes the real read and must never spend its busy budget)."""
+    return _revision.content_key(path, tables, lambda p: cached_ro(p, busy_budget=0))
 
 
 def _without_local_open_duplicates(rows: list[dict[str, Any]], *, gateway: str,
-- 
