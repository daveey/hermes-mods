diff --git a/hermes_cli/kanban_dependency_validation.py b/hermes_cli/kanban_dependency_validation.py
index 210dfb67ad..dcfa592752 100644
--- a/hermes_cli/kanban_dependency_validation.py
+++ b/hermes_cli/kanban_dependency_validation.py
@@ -2,6 +2,23 @@
 import sqlite3
 
 
+def insert_link(conn: sqlite3.Connection, parent_id: str, child_id: str) -> None:
+    """Validate internal graph writes too, inside the caller's transaction.
+
+    Cross-board dependencies use explicit waits; sync imports retain their own
+    replica-aware ingestion path rather than manufacturing local task rows.
+    """
+    from hermes_cli.kanban_db import _missing_task_ids
+
+    missing = _missing_task_ids(conn, [parent_id, child_id])
+    if missing:
+        raise missing_dependency_error(missing)
+    conn.execute(
+        "INSERT OR IGNORE INTO task_links (parent_id, child_id) VALUES (?, ?)",
+        (parent_id, child_id),
+    )
+
+
 def would_cycle(conn: sqlite3.Connection, parent_id: str, child_id: str) -> bool:
     """True iff ``parent_id`` is already a descendant of ``child_id``."""
     seen = set()
diff --git a/tests/hermes_cli/test_kanban_link_insert.py b/tests/hermes_cli/test_kanban_link_insert.py
new file mode 100644
index 0000000000..d3572ace24
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_link_insert.py
@@ -0,0 +1,31 @@
+"""Internal graph writers must not bypass endpoint validation."""
+import pytest
+
+from hermes_cli import kanban_db as kb
+from tests.hermes_cli import test_kanban_cross_gateway_parents as fixtures
+
+local = fixtures.local
+
+
+@pytest.mark.parametrize("missing", ["parent", "child", "both"])
+def test_internal_link_refuses_unknown_endpoints_atomically(local, missing):
+    parent = kb.create_task(local, title="parent", assignee="worker")
+    child = kb.create_task(local, title="child", assignee="worker")
+    parent_id = "t_missing_parent" if missing in {"parent", "both"} else parent
+    child_id = "t_missing_child" if missing in {"child", "both"} else child
+    before = [tuple(row) for row in local.execute("SELECT * FROM task_events")]
+    with pytest.raises(ValueError, match="unknown task"):
+        with kb.write_txn(local):
+            kb._link(local, parent_id, child_id)
+            kb._append_event(local, child, "linked", {"parent": parent_id})
+    assert list(local.execute("SELECT * FROM task_links")) == []
+    assert [tuple(row) for row in local.execute("SELECT * FROM task_events")] == before
+
+
+def test_internal_link_accepts_uncommitted_endpoints_and_exact_retry(local):
+    with kb.write_txn(local):
+        parent = kb.create_task(local, title="parent", assignee="worker")
+        child = kb.create_task(local, title="child", assignee="worker")
+        kb._link(local, parent, child)
+        kb._link(local, parent, child)
+    assert kb.parent_ids(local, child) == [parent]
