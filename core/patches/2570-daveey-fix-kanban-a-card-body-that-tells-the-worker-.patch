From a30e4c1cbf66e2bf796a7865885a6abf317a61c9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 06:47:28 +0000
Subject: [PATCH] [daveey] fix(kanban): a card body that tells the worker to
 operate the Desktop app pins in either word order

Review t_01a1ce5ad188bd9c of f0d80b24 found instructions that main pinned leaving their origin:
"Open Hermes Desktop and send one prompt.", "In the Desktop app, open Settings and toggle the Kanban
panel.", "Reload the Desktop window and read the status bar.", "Restart the Desktop backend ...".
DESKTOP_ACTION_MARKER only took a verb before `desktop (app|chat|chats|window|sidebar)`, so bare
"Hermes Desktop", "backend" and surface-first sentences missed, and send/reload/drive/use and most
inflections were not verbs. LIVE_DESKTOP_MARKER also matched "desktop session(s)", which main never
pinned ("Each new Desktop session re-reads config.yaml" is a loader fix).

DESKTOP_ACTION_MARKER is now one sentence-level rule in both orders: an operate verb and a Desktop
surface with no ".", ";" or newline between them, at most 80 characters apart. Surface = hermes
desktop or desktop (app|backend|backends|renderer|window|chat|chats|sidebar|ui), so it pins nothing
main left unpinned. Verbs (with -s/-ing/-ed forms): open, launch, relaunch, restart, quit, focus,
click, send, reload, drive, toggle, verify, reproduce, watch, confirm, use. Deliberately not verbs:
start, type, check, read, run, show ("held at their start and end" must not match). LIVE loses
session|sessions.

Proof:
- tests/hermes_cli/test_kanban_placement_desktop_surface.py: every finding-A and A-weak body stays
  local through decide and portable_reason (three through kanban_create); every verb form and every
  surface in both orders; the symptom bodies (verbatim _BODY included) and sentence-split, >80-char
  and "Desktop session" bodies leave; "A throwaway Hermes Desktop chat subscribes to the card." pins
  only through LIVE's (hermes )?. On f0d80b24's module: 55 passed, 136 failed; on this commit: 191
  passed, 0 failed.
- 59 mutants, all killed: each marker's TITLE_ONLY/DEFAULT membership, verb-before and verb-after
  halves, LIVE's (hermes )?, session|sessions put back, each of . ; \n dropped from the sentence
  class, the 80-char bound removed, start/type/check/read/run/show added as verbs, each verb stem,
  each inflection group, and each surface alternative.
- Replay over this worker's real cards, read-only (mode=ro: ~/.hermes/kanban.db and
  ~/.hermes/kanban/sync-shadow/*.db, 7 DBs, 10455 distinct cards): main pins 4322, this head 4232;
  90 lose the pin, 0 gain one (same counts through portable_reason). The 90 are symptom or history
  text ("the Desktop backend pid ... held deleted -wal files", "Desktop chats ran gpt-6-astra",
  the verbatim replica-read card).
- All 42 test files that reference kanban_placement or kanban_tools_placement: 1247 passed, 0 failed.
---
 hermes_cli/kanban_placement.py                |  24 +++--
 .../test_kanban_placement_desktop_surface.py  | 101 ++++++++++++++++--
 2 files changed, 112 insertions(+), 13 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 53f41c322f..076c5616a3 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -94,14 +94,24 @@ BABYBEAR_MARKER = r"(?<![\w/.~-])baby ?bear(?![\w/-]|\.\w)"
 HERMES_DESKTOP_MARKER = r"\bhermes desktop\b"
 DESKTOP_SURFACE_MARKER = r"\bdesktop (app|backend|backends|renderer|window|chat|chats|sidebar|ui)\b"
 # A chat or window the card itself opens or drives in the live app ("a throwaway Desktop chat runs the CLI"):
-# that is work on the machine with the app, wherever in the card it is said.
+# that is work on the machine with the app, wherever in the card it is said. No "desktop session": main never
+# pinned it ("Each new Desktop session re-reads config.yaml" is a loader fix).
 LIVE_DESKTOP_MARKER = (r"\b(throwaway|scratch|disposable|hidden|fixture|fresh|new|real|live) "
-                       r"(hermes )?desktop (chat|chats|session|sessions|window)\b")
-# The same need said with a verb: "Open a Desktop chat and send one prompt", "Focus the existing Desktop
-# window". The verb and the surface sit in one sentence, at most a few words apart.
-DESKTOP_ACTION_MARKER = (r"\b(open|opens|opening|start|starts|launch|launches|focus|focuses|click|clicks|"
-                         r"type|types|quit|quits|relaunch|reopen|restart)\b[^.;:,()\n]{0,40}?"
-                         r"\bdesktop (app|chat|chats|window|sidebar)\b")
+                       r"(hermes )?desktop (chat|chats|window)\b")
+# The same need said as an instruction: an operate verb and a Desktop surface in one sentence (no ".", ";" or
+# newline between them, at most 80 characters apart), in either order: "Open Hermes Desktop and send one
+# prompt", "In the Desktop app, open Settings". Deliberately not verbs: start, type, check, read, run, show;
+# symptom text uses them ("turns are held at their start and end"). Every surface here also matches
+# HERMES_DESKTOP_MARKER or DESKTOP_SURFACE_MARKER, so this pins nothing main left unpinned.
+_DESKTOP_OPERATE_VERB = (r"\b(?:open(?:s|ing|ed)?|(?:re)?launch(?:es|ing|ed)?|restart(?:s|ing|ed)?|"
+                         r"quit(?:s|ting)?|focus(?:es|ing|ed)?|click(?:s|ing|ed)?|send(?:s|ing)?|"
+                         r"reload(?:s|ing|ed)?|driv(?:e|es|ing)|toggl(?:e|es|ing|ed)|verif(?:y|ies|ying|ied)|"
+                         r"reproduc(?:e|es|ing|ed)|watch(?:es|ing|ed)?|confirm(?:s|ing|ed)?|us(?:e|es|ing|ed))\b")
+_DESKTOP_OPERATE_SURFACE = (r"\b(?:hermes desktop|"
+                            r"desktop (?:app|backend|backends|renderer|window|chat|chats|sidebar|ui))\b")
+_DESKTOP_SAME_SENTENCE = r"[^.;\n]{0,80}?"
+DESKTOP_ACTION_MARKER = (_DESKTOP_OPERATE_VERB + _DESKTOP_SAME_SENTENCE + _DESKTOP_OPERATE_SURFACE + "|"
+                         + _DESKTOP_OPERATE_SURFACE + _DESKTOP_SAME_SENTENCE + _DESKTOP_OPERATE_VERB)
 # Phrases that mean the work needs this machine (a Mac the user works on). Case-insensitive.
 DEFAULT_LOCAL_MARKERS = (
     r"\bchrome\b", r"\bcdp\b", r"\bkeychain\b", r"\bcodesign", r"\bnotari[sz]", r"\btcc\b",
diff --git a/tests/hermes_cli/test_kanban_placement_desktop_surface.py b/tests/hermes_cli/test_kanban_placement_desktop_surface.py
index ba81f0611e..f7979e240e 100644
--- a/tests/hermes_cli/test_kanban_placement_desktop_surface.py
+++ b/tests/hermes_cli/test_kanban_placement_desktop_surface.py
@@ -55,23 +55,102 @@ def test_desktop_surface_in_the_title_still_pins(title):
     assert kp.portable_reason({"title": title, "body": "Push the fix."}, {}) == "local marker"
 
 
-@pytest.mark.parametrize("body", [
+# Bodies that tell the worker to operate the running app: an operate verb and a Desktop surface in one sentence,
+# in either order. Each was pinned on main; review t_01a1ce5ad188bd9c found most of them leaving on f0d80b24.
+_OPERATE_BODIES = [
     "Live on the MacBook: a throwaway desktop chat runs the CLI block on a fixture card.",
     "A hidden scratch Desktop chat will subscribe and complete this card mid-turn.\nThen read the notice.",
     "Open a fresh Desktop window and read the status bar.",
-    "Start a new Desktop session and send one prompt.",
     "Needs a Desktop DOM readback of the composer",
     "Open a Desktop chat and send one prompt.",
     "Focus the existing Desktop window and read the status bar.",
     "Open a fresh Hermes Desktop chat and send one prompt.",
     "Quit and relaunch the Desktop app, then read the version.",
-])
-def test_a_chat_or_window_the_card_drives_in_the_live_app_still_pins(body):
+    # Finding A
+    "Open Hermes Desktop and send one prompt.",
+    "Restart Hermes Desktop and confirm the version in Settings.",
+    "Quit Hermes Desktop, then relaunch it and read the version.",
+    "In Hermes Desktop, open Settings and toggle the Kanban panel.",
+    "In the Desktop app, open Settings and toggle the Kanban panel.",
+    "Send one prompt in the Desktop chat and read the notice.",
+    "Reload the Desktop window and read the status bar.",
+    "Drive the Desktop chat composer and read back the rendered notice.",
+    "Use the existing Desktop chat to send one prompt.",
+    "Relaunching the Desktop app must keep the session; check it by hand.",
+    "Restart the Desktop backend and read its log for the new line.",
+    # Finding A-weak
+    "Verify in the Desktop sidebar that the red badge clears after the card completes.",
+    "Reproduce the stuck spinner in the Desktop app and record what the composer shows.",
+    "Watch the Desktop sidebar while this card completes.",
+    # Matched only by LIVE_DESKTOP_MARKER's ``(hermes )?``: no operate verb in the sentence.
+    "A throwaway Hermes Desktop chat subscribes to the card.",
+]
+
+
+@pytest.mark.parametrize("body", _OPERATE_BODIES)
+def test_a_body_that_operates_the_live_app_still_pins(body):
     d = decide({"title": "Prove the notice text", "body": body})
     assert d["where"] == "local" and d["why"].startswith("local marker"), (body, d)
     assert kp.portable_reason({"title": "Prove the notice text", "body": body}, {}) == "local marker"
 
 
+# Every operate verb form, before the surface and after it.
+@pytest.mark.parametrize("verb", [
+    "open", "opens", "opening", "opened", "launch", "launches", "launching", "launched", "relaunch",
+    "relaunches", "relaunching", "relaunched", "restart", "restarts", "restarting", "restarted", "quit",
+    "quits", "quitting", "focus", "focuses", "focusing", "focused", "click", "clicks", "clicking", "clicked",
+    "send", "sends", "sending", "reload", "reloads", "reloading", "reloaded", "drive", "drives", "driving",
+    "toggle", "toggles", "toggling", "toggled", "verify", "verifies", "verifying", "verified", "reproduce",
+    "reproduces", "reproducing", "reproduced", "watch", "watches", "watching", "watched", "confirm", "confirms",
+    "confirming", "confirmed", "use", "uses", "using", "used",
+])
+@pytest.mark.parametrize("shape", ["{v} it in the Desktop app", "In the Desktop app, {v} it"])
+def test_every_operate_verb_pins_in_either_order(verb, shape):
+    body = shape.format(v=verb)
+    assert decide({"title": "Prove the notice text", "body": body})["where"] == "local", body
+    assert kp.portable_reason({"title": "Prove the notice text", "body": body}, {}) == "local marker", body
+
+
+@pytest.mark.parametrize("surface", [
+    "Hermes Desktop", "the Desktop app", "the Desktop backend", "the Desktop backends", "the Desktop renderer",
+    "the Desktop window", "the Desktop chat", "the Desktop chats", "the Desktop sidebar", "the Desktop UI",
+])
+def test_every_desktop_surface_pins_beside_an_operate_verb(surface):
+    for body in (f"Restart {surface} and read the log.", f"In {surface}, restart it."):
+        assert decide({"title": "Prove the notice text", "body": body})["where"] == "local", body
+        assert kp.portable_reason({"title": "Prove the notice text", "body": body}, {}) == "local marker", body
+
+
+# Symptom text: the app named beside a common word that is deliberately not an operate verb (start, type,
+# check, read, run, show), or an operate verb in another sentence (split by ".", ";" or a newline) or more
+# than 80 characters away, or a "Desktop session" (main never matched it).
+_NOT_OPERATE_BODIES = [
+    "Desktop chat turns are held at their start and end by plugin hooks.",
+    "Fix the type errors in the Desktop app's TypeScript so CI is green.",
+    "Check and read the run log while the Desktop sidebar shows red.",
+    "Run the suite until the Desktop chat turns start.",
+    "The Desktop sidebar does not show the badge.",
+    "Open the log file. The Desktop chat showed no notice.",
+    "Open the log file; the Desktop chat showed no notice.",
+    "Open the log file\nthe Desktop chat showed no notice.",
+    "The Desktop chat showed no notice. Open the log file.",
+    "The Desktop chat showed no notice; open the log file.",
+    "The Desktop chat showed no notice\nopen the log file.",
+    "Open the replica reader that returns twelve thousand rows one sqlite step at a time for every board in "
+    "the Desktop chat.",
+    "The Desktop chat stalls while the replica reader returns twelve thousand rows one sqlite step at a time "
+    "for every board, then open it.",
+    "Each new Desktop session re-reads config.yaml. Cache it in the loader.",
+]
+
+
+@pytest.mark.parametrize("body", _NOT_OPERATE_BODIES)
+def test_symptom_text_without_an_operate_sentence_leaves(body):
+    d = decide({"title": "Fix the session-activity projection", "body": body})
+    assert d["where"] == "hub", (body, d)
+    assert kp.portable_reason({"title": "Fix the session-activity projection", "body": body}, {}) is None, body
+
+
 def test_a_replaced_marker_list_scans_the_body_for_the_desktop_surface():
     """A caller who replaces ``local_markers`` owns the list: every pattern scans the whole text."""
     cfg = {**helpers.ROUTE, "local_markers": [kp.DESKTOP_SURFACE_MARKER]}
@@ -86,8 +165,18 @@ def test_create_tool_sends_a_card_that_describes_desktop_chats_to_the_hub(mac):
     assert out.get("placed", {}).get("gateway") == "hub" and "placement" not in out, out
     assert helpers._local_count() == 0
     for title, body in (("Prove the notice text", "Open a Desktop chat and send one prompt."),
-                        ("Read the block actor line", "A throwaway Desktop chat runs the CLI block.")):
+                        ("Confirm the build version", "Open Hermes Desktop and send one prompt."),
+                        ("Toggle the Kanban panel", "In the Desktop app, open Settings and toggle the Kanban panel."),
+                        ("Read the block actor line", "A throwaway Desktop chat runs the CLI block."),
+                        ("Subscribe a scratch owner", "A throwaway Hermes Desktop chat subscribes to the card.")):
         live = json.loads(kt._handle_create({"title": title, "body": body}))
-        assert live["placement"]["where"] == "local" and "desktop chat" in live["placement"]["why"], live
+        assert live["placement"]["where"] == "local" and "desktop" in live["placement"]["why"], live
+    assert helpers._local_count() == 5
+    for title, body in (
+            ("Unhold plugin hook turns", "Desktop chat turns are held at their start and end by plugin hooks."),
+            ("Cache the config loader", "Each new Desktop session re-reads config.yaml. Cache it in the loader.")):
+        out = json.loads(kt._handle_create({"title": title, "body": body}))
+        assert out.get("placed", {}).get("gateway") == "hub" and "placement" not in out, out
+    assert helpers._local_count() == 5
     pinned = json.loads(kt._handle_create({"title": "Desktop app: composer loses focus", "body": "Push the fix."}))
     assert pinned["placement"] == {"where": "local", "why": "local marker: mentions 'desktop app'"}, pinned
