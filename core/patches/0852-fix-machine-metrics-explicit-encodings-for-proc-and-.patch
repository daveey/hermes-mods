From a19249c642331103b4d60b1254c3df10d341c216 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 17:33:14 -0700
Subject: [PATCH] fix(machine metrics): explicit encodings for /proc and
 subprocess reads

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/machine_metrics.py | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/machine_metrics.py b/hermes_cli/machine_metrics.py
index bdf74546c3..22e0a00d77 100644
--- a/hermes_cli/machine_metrics.py
+++ b/hermes_cli/machine_metrics.py
@@ -44,11 +44,12 @@ def _macos_mem_used_pct(memsize: int, vm_stat: str) -> Optional[float]:
 def _mem_used_pct() -> Optional[float]:
     try:
         if sys.platform.startswith("linux"):
-            return _linux_mem_used_pct(Path("/proc/meminfo").read_text())
+            return _linux_mem_used_pct(Path("/proc/meminfo").read_text(encoding="utf-8"))
         if sys.platform == "darwin":
             memsize = int(subprocess.run(["/usr/sbin/sysctl", "-n", "hw.memsize"], capture_output=True, text=True,
-                                         timeout=5, check=True).stdout.strip())
-            vm = subprocess.run(["/usr/bin/vm_stat"], capture_output=True, text=True, timeout=5, check=True).stdout
+                                         encoding="utf-8", errors="replace", timeout=5, check=True).stdout.strip())
+            vm = subprocess.run(["/usr/bin/vm_stat"], capture_output=True, text=True, encoding="utf-8",
+                                errors="replace", timeout=5, check=True).stdout
             return _macos_mem_used_pct(memsize, vm)
     except (OSError, ValueError, subprocess.SubprocessError):
         return None
