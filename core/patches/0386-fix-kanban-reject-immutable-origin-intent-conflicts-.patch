From 16633d1e4110068cedb04a23d2279df200649445 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 26 Oct 2026 18:36:04 +0000
Subject: [PATCH] fix(kanban): reject immutable origin intent conflicts
 [daveey]

---
 hermes_cli/kanban_origin_owner.py            |  4 ++++
 tests/hermes_cli/test_kanban_origin_owner.py | 19 +++++++++++++++++++
 2 files changed, 23 insertions(+)

diff --git a/hermes_cli/kanban_origin_owner.py b/hermes_cli/kanban_origin_owner.py
index 3828bda621..6ee34cfce6 100644
--- a/hermes_cli/kanban_origin_owner.py
+++ b/hermes_cli/kanban_origin_owner.py
@@ -88,6 +88,10 @@ def _dispatch_result(raw_result):
         # Dispatch catches exceptions itself. An untyped error may follow a
         # committed write: keep the exact request retryable, never infer absence.
         return {'status': 'pending', 'code': 'origin_dispatch_pending', 'handoff_complete': False}
+    if result.get('code') in {'origin_creation_conflict', 'origin_already_bound'}:
+        # Replaying an immutable conflicting envelope cannot repair it. Reject
+        # this request only; the original intent and its receipt remain intact.
+        return {**result, 'status': 'rejected'}
     return result
 
 
diff --git a/tests/hermes_cli/test_kanban_origin_owner.py b/tests/hermes_cli/test_kanban_origin_owner.py
index d6d8fffce9..978484adec 100644
--- a/tests/hermes_cli/test_kanban_origin_owner.py
+++ b/tests/hermes_cli/test_kanban_origin_owner.py
@@ -156,6 +156,25 @@ def test_owner_cli_operation_mismatch_is_rejected(world, monkeypatch, capsys, co
         assert not conn.execute("SELECT 1 FROM sqlite_master WHERE name='origin_creation_intents'").fetchone()
 
 
+@pytest.mark.parametrize('conflict', ['same_id_changed_origin', 'same_origin_new_id'])
+def test_adoption_immutable_conflict_is_terminal(world, monkeypatch, capsys, conflict):
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title='Existing', session_id='creator')
+    request = {**world, 'action': 'origin-adopt', 'key': 'default/default/' + tid,
+               'args': {'origin': world['args']['origin']}}
+    assert invoke(request, monkeypatch, capsys)['adopted'] is True
+    if conflict == 'same_id_changed_origin':
+        request['args'] = {'origin': {**request['args']['origin'], 'session': 'different'}}
+        code = 'origin_creation_conflict'
+    else:
+        request['id'] = 'different-request-001'
+        code = 'origin_already_bound'
+    result = invoke(request, monkeypatch, capsys)
+    assert result['code'] == code
+    assert result.get('status') == 'rejected'
+    assert result['handoff_complete'] is False
+
+
 def test_owner_entry_adopts_existing_task_and_replays(world, monkeypatch, capsys):
     with kbc.connect_closing() as conn:
         tid = kb.create_task(conn, title='Existing', session_id='original-creator')
