From 15b490715145ca98f103b0b6be1c136a34ab1356 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 06:45:05 -0700
Subject: [PATCH] test: stop two hermes_cli tests touching the real Hermes home
 (stub retarget_to_owning_install; stub node instead of symlinking PM's tool
 store)

---
 tests/hermes_cli/test_tui_npm_install.py | 6 ++++--
 tests/hermes_cli/test_update_products.py | 3 +++
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_tui_npm_install.py b/tests/hermes_cli/test_tui_npm_install.py
index cbf5d7a9ee..4c02310d28 100644
--- a/tests/hermes_cli/test_tui_npm_install.py
+++ b/tests/hermes_cli/test_tui_npm_install.py
@@ -132,10 +132,12 @@ def test_runtime_node_comes_from_pm_without_legacy_repair(tmp_path, monkeypatch)
     import pm
     from pm.package import Runner
 
-    node = shutil.which("node")
+    # A stub executable, not a symlink to the developer's node: PM's real tool store lives in the
+    # real Hermes home, which the home-I/O guard rightly refuses once which() resolves the link.
     managed = tmp_path / "bin/node"
     managed.parent.mkdir()
-    managed.symlink_to(node)
+    managed.write_text("#!/bin/sh\n")
+    managed.chmod(0o755)
     monkeypatch.delenv("HERMES_NODE", raising=False)
     acquired = []
 
diff --git a/tests/hermes_cli/test_update_products.py b/tests/hermes_cli/test_update_products.py
index 3c0d14d421..7bcd1009f8 100644
--- a/tests/hermes_cli/test_update_products.py
+++ b/tests/hermes_cli/test_update_products.py
@@ -26,6 +26,9 @@ def test_command_reports_outcome_and_releases_real_lock(tmp_path, monkeypatch, f
     monkeypatch.setenv("HERMES_HOME", str(tmp_path))
     monkeypatch.setenv("HERMES_UPDATE_REEXEC", "1" if reexec else "")
     monkeypatch.setattr("os._exit", lambda *_: pytest.fail("normal cleanup bypassed"))
+    # The runner's interpreter (a PM test-environment venv under the real home) is not the
+    # checkout under test; retargeting would probe and re-exec it. Not this test's subject.
+    monkeypatch.setattr("hermes_cli.update_owning_install.retarget_to_owning_install", lambda *_: None)
     monkeypatch.setattr(main, "_update_preflight_handled", lambda args: False)
     monkeypatch.setattr(main, "_install_hangup_protection", lambda **kw: None)
     finalized = []
-- 
2.55.0

