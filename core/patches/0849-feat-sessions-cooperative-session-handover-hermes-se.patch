+    # owned here again (no record): the gate passes on to the slot claim
+    gw.svc.session_owners[BOARD] = {}
+    so.reset_cache()
+    session["running"] = True
+    server._admit_prompt_turn("live-sid", session, "hello", None, None, None, None)
