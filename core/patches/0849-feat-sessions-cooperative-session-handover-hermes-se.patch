+    assert so.owner(SID)["gateway"] == DST
+    gw.svc.offline = True
+    clock[0] += 3600  # far past the TTL: still the last answer, never "no record"
+    assert so.owner(SID)["gateway"] == DST
+    assert so.refusal(SID) is not None
+    with caplog.at_level(logging.WARNING, logger="hermes_cli.session_owner"):
