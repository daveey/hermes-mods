diff --git a/hermes_cli/kanban_priority_manifest.py b/hermes_cli/kanban_priority_manifest.py
new file mode 100644
index 00000000000..ae1454a2a6c
--- /dev/null
+++ b/hermes_cli/kanban_priority_manifest.py
@@ -0,0 +1,63 @@
+"""Strict validation of attachment-backed global normalization plans."""
+from __future__ import annotations
+
+from hermes_cli.kanban_priority_migration import plan_global
+
+
+STATUSES = frozenset({"todo", "ready", "running", "review", "blocked", "scheduled", "triage", "done", "archived"})
+
+
+def validate(manifest: dict) -> dict:
+    """Recompute the plan from originals; attachment integrity is not validation."""
+    try:
+        return _validate(manifest)
+    except (KeyError, TypeError, ValueError) as exc:
+        raise ValueError(f"invalid priority manifest: {exc}") from exc
+
+
+def _validate(manifest: dict) -> dict:
+    if not isinstance(manifest, dict) or set(manifest) != {
+        "version", "cap", "board_id", "ceiling", "exceptions", "rows"
+    }:
+        raise ValueError("unknown fields")
+    if not isinstance(manifest["board_id"], str) or not manifest["board_id"]:
+        raise ValueError("missing board identity")
+    if any(type(manifest[key]) is not int for key in ("version", "cap", "ceiling")):
+        raise ValueError("noninteger policy version")
+    if not isinstance(manifest["rows"], list) or not isinstance(manifest["exceptions"], list):
+        raise ValueError("rows and exceptions must be lists")
+    inventory = []
+    for row in manifest["rows"]:
+        if not isinstance(row, dict) or set(row) != {"id", "origin", "old", "new"}:
+            raise ValueError("invalid row")
+        if any(not isinstance(row[k], str) or not row[k] for k in ("id", "origin")):
+            raise ValueError("missing row identity")
+        if any(type(row[k]) is not int for k in ("old", "new")):
+            raise ValueError("noninteger priority")
+        inventory.append({"id": row["id"], "created_on": row["origin"],
+                          "priority": row["old"], "status": "ready"})
+    indexed = {row["id"]: row for row in inventory}
+    exceptions = []
+    for row in manifest["exceptions"]:
+        if not isinstance(row, dict) or set(row) != {"id", "origin", "old", "status"}:
+            raise ValueError("invalid exception")
+        if any(not isinstance(row[k], str) or not row[k] for k in ("id", "origin", "status")):
+            raise ValueError("missing exception identity")
+        if type(row["old"]) is not int or row["status"] not in STATUSES:
+            raise ValueError("invalid exception value or status")
+        original = {"id": row["id"], "created_on": row["origin"],
+                    "priority": row["old"], "status": row["status"]}
+        if row["status"] in ("done", "archived"):
+            if row["id"] in indexed:
+                raise ValueError("terminal exception is in open inventory")
+            inventory.append(original)
+        else:
+            active = indexed.get(row["id"])
+            if active is None or active["created_on"] != row["origin"] or active["priority"] != row["old"]:
+                raise ValueError("exception differs from open inventory")
+            active["status"] = row["status"]
+        exceptions.append(row["id"])
+    expected = plan_global(inventory, board_id=manifest["board_id"], exceptions=exceptions)
+    if expected != manifest:
+        raise ValueError("plan differs from canonical global ranking")
+    return manifest
diff --git a/hermes_cli/kanban_priority_prepare.py b/hermes_cli/kanban_priority_prepare.py
new file mode 100644
index 00000000000..3e403f6591f
--- /dev/null
+++ b/hermes_cli/kanban_priority_prepare.py
@@ -0,0 +1,85 @@
+"""Raw canonical capture and immutable staging for operator priority migration."""
+from __future__ import annotations
+
+import hashlib
+import os
+from pathlib import Path
+
+from hermes_cli import kanban_db as kb
+from hermes_cli.kanban_priority_manifest import STATUSES, validate
+from hermes_cli.kanban_priority_migration import plan_global, save_manifest
+
+
+def capture(hub, *, board_id: str, exceptions: list[str]) -> dict:
+    """Read raw Board pages at one feed head, without importing/clipping values."""
+    rows = []
+    after = ""
+    head = None
+    for _ in range(10000):
+        page = hub.snapshot_page(board_id, "tasks", after=after)
+        if page.get("table") != "tasks" or type(page.get("head")) is not int:
+            raise ValueError("invalid canonical snapshot page")
+        if head is None:
+            head = page["head"]
+        if page["head"] != head:
+            raise ValueError("canonical inventory changed; capture a new manifest")
+        batch = page.get("rows")
+        if not isinstance(batch, list) or type(page.get("more")) is not bool:
+            raise ValueError("invalid canonical inventory")
+        for row in batch:
+            if not isinstance(row, dict) or row.get("status") not in STATUSES:
+                raise ValueError("invalid canonical task status")
+            key = row.get("id")
+            if not isinstance(key, str) or key <= after:
+                raise ValueError("invalid snapshot cursor ordering")
+            after = key
+            rows.append(row)
+        if not page["more"]:
+            break
+        if not batch or page.get("next") != after:
+            raise ValueError("snapshot cursor failed to advance")
+    else:
+        raise ValueError("snapshot page limit exceeded")
+    # A final read closes the final-page/return gap at an observed head. Apply
+    # still has local CAS; this is not a distributed transaction or a lease.
+    final = hub.snapshot_page(board_id, "tasks", limit=1)
+    if final.get("head") != head:
+        raise ValueError("canonical inventory changed; capture a new manifest")
+    return validate(plan_global(rows, board_id=board_id, exceptions=exceptions))
+
+
+def stage(conn, manifest: dict, *, path: Path, task_id: str, writer: str) -> dict:
+    """Save a fresh immutable backup and attach identical bytes on the local owner."""
+    from hermes_cli.kanban_db_sync import sync_state
+    from hermes_cli.kanban_supervisor_requests import _non_worker_refusal
+
+    refusal = _non_worker_refusal()
+    if refusal:
+        raise PermissionError(refusal)
+    validate(manifest)
+    identity = sync_state(conn) or {}
+    if identity.get("mode") != "primary" or identity.get("gateway_id") != writer:
+        raise ValueError("staging requires this primary writer")
+    if identity.get("board_id") != manifest["board_id"]:
+        raise ValueError("manifest belongs to a different board")
+    owner = conn.execute("SELECT created_on FROM tasks WHERE id=?", (task_id,)).fetchone()
+    if owner is None or owner[0] != writer:
+        raise ValueError("attachment owner must belong to this writer")
+    save_manifest(path, manifest)
+    # Preserve the backup even if attachment storage subsequently fails. The
+    # existing attachment writer owns its transaction; staging changes no priority.
+    # Apply revalidates writer, attachment and complete owned inventory atomically.
+    directory = os.open(path.parent, os.O_RDONLY)
+    try:
+        os.fsync(directory)
+    finally:
+        os.close(directory)
+    data = path.read_bytes()
+    digest = hashlib.sha256(data).hexdigest()
+    attachment_id = kb.store_attachment_bytes(conn, task_id, path.name, data,
+                                               content_type="application/json")
+    attachment = kb.get_attachment(conn, attachment_id)
+    if attachment is None or Path(attachment.stored_path).read_bytes() != data:
+        raise ValueError("attached manifest readback mismatch; retain original backup")
+    return {"attachment_id": attachment_id, "manifest_sha256": digest,
+            "writer": writer, "backup": str(path)}
