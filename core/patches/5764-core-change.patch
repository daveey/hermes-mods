From 556473cc9380d40c9f80b27f7c6809106b3d4bd0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 18:46:50 +0000
Subject: [PATCH] [daveey] Ask for deltas on the primary SSH tunnel too

The primary SSH connection's pool scope is '' (sshScopeKey(null)). The
delta store read '' as "not bound", so the Desktop never sent
X-Hermes-Delta-Accept on the hub tunnel: every sessions/board/tree poll
went whole (576 KB, 389 KB, 103 KB) although the hub already answers
deltas (1.9 KB, 1.4 KB, 22 B measured on the always-on proxy). Those
whole bodies filled the one ssh link that session clicks reconcile over
(Send-Q 2.3 MB, ~17 MB/min), so a click painted from cache in 40 ms but
waited 6-8 s for its fresh read.

Treat any string scope, '' included, as bound.
---
 apps/desktop/electron/delta-reads.test.ts | 20 ++++++++++++++++++++
 apps/desktop/electron/delta-reads.ts      |  7 +++++--
 2 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/electron/delta-reads.test.ts b/apps/desktop/electron/delta-reads.test.ts
index f7a81f40d7..4c5e73005d 100644
--- a/apps/desktop/electron/delta-reads.test.ts
+++ b/apps/desktop/electron/delta-reads.test.ts
@@ -139,6 +139,26 @@ describe('asking for a delta', () => {
     expect(deltaRequestHeaders('GET', url)).toEqual({})
   })
 
+  it('binds the primary SSH connection, whose scope key is the empty string (sshScopeKey(null))', () => {
+    // [daveey] "switching sessions ... should be instant": the primary hub tunnel never asked for deltas
+    // because '' read as "not bound", so its sessions/board/tree polls went whole (576 KB vs a 1.9 KB delta) and
+    // filled the link that session clicks wait on.
+    const url = 'http://127.0.0.1:50666/api/profiles/sessions?limit=200'
+
+    expect(deltaRequestHeaders('GET', url)).toEqual({})
+    noteRemoteConnect('http://127.0.0.1:50666', '', Date.now(), () => undefined)
+    expect(deltaRequestHeaders('GET', url)).toEqual({ [DELTA_ACCEPT_HEADER]: 'zstd' })
+    expect(deltaBodyStore.keyFor(url)).toBe('\u0000/api/profiles/sessions?limit=200')
+
+    const body = cards(40)
+
+    decodeDeltaBody(url, whole(body), body)
+    expect(deltaRequestHeaders('GET', url)[DELTA_BASE_HEADER]).toBe(bodyHash(body))
+    deltaBodyStore.unbindScope('')
+    expect(deltaRequestHeaders('GET', url)).toEqual({})
+    expect(deltaBodyStore.keyFor('http://127.0.0.1:50999/api/cron/jobs')).toBeNull()
+  })
+
   it('noteRemoteConnect binds a tunnel to its scope in the shared store', () => {
     const url = 'http://127.0.0.1:50777/api/cron/jobs'
 
diff --git a/apps/desktop/electron/delta-reads.ts b/apps/desktop/electron/delta-reads.ts
index 9432c61a89..e737908dba 100644
--- a/apps/desktop/electron/delta-reads.ts
+++ b/apps/desktop/electron/delta-reads.ts
@@ -147,11 +147,14 @@ export class DeltaBodyStore {
    * A remote (SSH-tunnelled) backend now answers at baseUrl for this pool scope. A scope has one tunnel, so one
    * origin: a rebuild on a new local port takes the scope (and its copies) with it, and the old port, which may be
    * handed to something else, is no longer asked for deltas or able to file answers under this scope.
+   *
+   * [daveey] The empty string is a real scope: the primary SSH connection's key (sshScopeKey(null)). Reading it as
+   * "no scope" left the busiest tunnel (the hub's) asking for no deltas at all, so every poll went whole.
    */
   bindRemote(baseUrl: null | string | undefined, scope: string): void {
     const origin = originOf(baseUrl)
 
-    if (origin && scope) {
+    if (origin && typeof scope === 'string') {
       this.unbindScope(scope)
       this.#scopes.set(origin, scope)
     }
@@ -175,7 +178,7 @@ export class DeltaBodyStore {
       const parsed = new URL(url)
       const scope = this.#scopes.get(parsed.origin)
 
-      return scope ? `${scope}\u0000${parsed.pathname}${parsed.search}` : null
+      return scope === undefined ? null : `${scope}\u0000${parsed.pathname}${parsed.search}`
     } catch {
       return null
     }
