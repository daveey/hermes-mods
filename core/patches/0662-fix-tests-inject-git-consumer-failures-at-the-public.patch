From c70f80b17d4d02b948822c9c71594b038f774fba Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 07:48:37 +0000
Subject: [PATCH] fix(tests): inject git-consumer failures at the public PM
 boundary [daveey]

Private target/acquisition hooks sit behind PM runtime discovery: a missing packaged runtime reproduces four calls==[] failures while consumers correctly fall back. Injection now targets pm.ensure, preserving callback and real Git assertions, with checkout/missing-runtime parameter coverage and two unmocked preflight-to-consumer regressions.

Why: earlier runtime refusal bypasses private hooks; why not caught: clean source checkouts have no packaged stamp, and tests coupled consumer fallback to PM implementation details. Previous b98c132d9d addressed target-gap checks but not runtime discovery. Exact original mirror host state is unavailable; missing-runtime mechanism is reproduced, not asserted as proven incident history. RED: four missing-runtime cases fail with original hooks. GREEN: 86 tests across consumers, checkpoint, working diff, and PM target-gap coverage. No production changes.
---
 tests/tools/test_git_consumer_environment.py  | 36 ++++++++++---------
 .../test_git_consumer_runtime_fallback.py     | 35 ++++++++++++++++++
 2 files changed, 55 insertions(+), 16 deletions(-)
 create mode 100644 tests/tools/test_git_consumer_runtime_fallback.py

diff --git a/tests/tools/test_git_consumer_environment.py b/tests/tools/test_git_consumer_environment.py
index ec25c6951a..69ec2bc23d 100644
--- a/tests/tools/test_git_consumer_environment.py
+++ b/tests/tools/test_git_consumer_environment.py
@@ -1,5 +1,6 @@
 """Git consumers use the selected package environment without owning its layout."""
 import importlib
+import json
 import shutil
 import subprocess
 
@@ -58,36 +59,39 @@ def test_checkpoint_and_diff_follow_selected_git_environment(tmp_path, monkeypat
     assert manager.ensure_checkpoint(str(repo)) is False
 
 
+@pytest.mark.parametrize("runtime_state", ["checkout", "missing-packaged-runtime"])
 @pytest.mark.parametrize("consumer", ["checkpoint", "diff"])
 @pytest.mark.parametrize("failure", ["unsupported-target", "acquisition"])
-def test_git_consumers_fall_back_to_system_git(tmp_path, monkeypatch, consumer, failure):
+def test_git_consumers_fall_back_to_system_git(tmp_path, monkeypatch, consumer, failure, runtime_state):
+    if runtime_state == "missing-packaged-runtime":
+        stamp = tmp_path / "install.json"
+        stamp.write_text(json.dumps({
+            "distribution": "docker", "pmRuntime": str(tmp_path / "missing-runtime"),
+        }), encoding="utf-8")
+        monkeypatch.setattr(importlib.import_module("pm.paths"), "install_stamp_path", lambda project: stamp)
+        # This preflight refusal precedes both old private injection points.
+        with pytest.raises(pm.InstallError, match="packaged PM runtime is missing or invalid"):
+            pm.ensure("git")
+
     git = shutil.which("git")
     assert git is not None
     repo = tmp_path / "repo"
     subprocess.run([git, "init", str(repo)], check=True, capture_output=True)
     (repo / "new.txt").write_text("system git content\n", encoding="utf-8")
 
-    # Fail at the PM boundary reached by both ensure and env_for, without
-    # pretending this interpreter is running on a different host OS/CPU.
-    resolver = importlib.import_module("pm.install")
+    # These are consumer contracts: inject where selected_git_env reads PM,
+    # not behind runtime discovery, target-gap checks, or lazy-install policy.
     calls = []
 
-    def unavailable(*args, **kwargs):
-        calls.append(True)
+    def unavailable(name, *, base_env):
+        assert name == "git"
+        assert "PATH" in base_env
+        calls.append(name)
         if failure == "unsupported-target":
             raise RuntimeError("unsupported architecture")
         raise pm.InstallError("git", "managed Git unavailable")
 
-    if failure == "unsupported-target":
-        # pm.client's in-process target-gap check reads pm.store.current_target
-        # before any pm.install boundary, so the target probe fails there too.
-        monkeypatch.setattr(resolver, "current_target", unavailable)
-        monkeypatch.setattr(importlib.import_module("pm.store"), "current_target", unavailable)
-    else:
-        # Model a target with no deliberate git gap (POSIX's gap would refuse
-        # before acquisition is ever attempted), so acquisition itself fails.
-        monkeypatch.setattr(importlib.import_module("pm.client"), "_raise_target_gap", lambda package: None)
-        monkeypatch.setattr(resolver, "_installed_location", unavailable)
+    monkeypatch.setattr(pm, "ensure", unavailable)
     monkeypatch.setattr(checkpoint_manager, "CHECKPOINT_BASE", tmp_path / "checkpoints")
     if consumer == "checkpoint":
         manager = checkpoint_manager.CheckpointManager(enabled=True)
diff --git a/tests/tools/test_git_consumer_runtime_fallback.py b/tests/tools/test_git_consumer_runtime_fallback.py
new file mode 100644
index 0000000000..900f4c9d78
--- /dev/null
+++ b/tests/tools/test_git_consumer_runtime_fallback.py
@@ -0,0 +1,35 @@
+"""Real PM preflight failures must still allow system Git consumers."""
+import importlib
+import json
+import shutil
+import subprocess
+
+import pytest
+
+import pm
+from tools import checkpoint_manager, working_diff
+
+
+@pytest.mark.parametrize("consumer", ["checkpoint", "diff"])
+def test_git_consumers_survive_missing_pm_runtime(tmp_path, monkeypatch, consumer):
+    stamp = tmp_path / "install.json"
+    stamp.write_text(json.dumps({
+        "distribution": "docker", "pmRuntime": str(tmp_path / "missing-runtime"),
+    }), encoding="utf-8")
+    monkeypatch.setattr(importlib.import_module("pm.paths"), "install_stamp_path", lambda project: stamp)
+    with pytest.raises(pm.InstallError, match="packaged PM runtime is missing or invalid"):
+        pm.ensure("git")
+
+    git = shutil.which("git")
+    assert git is not None
+    repo = tmp_path / "repo"
+    subprocess.run([git, "init", str(repo)], check=True, capture_output=True)
+    (repo / "new.txt").write_text("runtime fallback content\n", encoding="utf-8")
+    monkeypatch.setattr(checkpoint_manager, "CHECKPOINT_BASE", tmp_path / "checkpoints")
+    # Do not replace pm.ensure: exercise its real preflight through the consumer.
+    if consumer == "checkpoint":
+        assert checkpoint_manager.CheckpointManager(enabled=True).ensure_checkpoint(str(repo)) is True
+    else:
+        result = working_diff.collect_working_diff(str(repo))
+        assert result["success"] is True
+        assert "+runtime fallback content" in result["diff"]
