From 32c65bb7d4065e28c39c9b2bd5dd7a0d0e344b6e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 21:22:34 +0000
Subject: [PATCH] fix(kanban): retain unknown carry on nested JSON and schema
 skew [daveey]

---
 docs/terminal-carry-recovery.md                |  9 +++++++++
 hermes_cli/kanban_terminal_carry.py            |  4 ++--
 tests/hermes_cli/test_kanban_terminal_carry.py | 10 +++++++++-
 3 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/docs/terminal-carry-recovery.md b/docs/terminal-carry-recovery.md
index 8a3ae770f36..509be09fe2f 100644
--- a/docs/terminal-carry-recovery.md
+++ b/docs/terminal-carry-recovery.md
@@ -67,3 +67,12 @@ uses the established completion verifier without weakening the ordinary reader.
 NULL/wrong-profile identity, missing owner runs/events, goal-mode without receipts,
 changed completion generation, corrupt registration, stale/current Board state,
 both snapshot carry entry points, and standard release capture/reopen restoration.
+
+Review robustness follow-up: a missing Board column raises `IndexError` from
+`sqlite3.Row`, and excessive JSON nesting raises `RecursionError`. Neither was in
+the evidence-reader exception lists, so invalid evidence could abort the entire
+projection instead of retaining unknown. Existing malformed-JSON/schema tests
+covered syntax errors and unreadable databases, not these exception classes.
+The recovery seam now handles these specific evidence failures (not a blanket
+exception catch); both after-release regressions fail before and pass after the
+fix. Proof-loss remains unknown/unreleased; no completion predicate is weakened.
diff --git a/hermes_cli/kanban_terminal_carry.py b/hermes_cli/kanban_terminal_carry.py
index a512ca0f146..79edd83eeb8 100644
--- a/hermes_cli/kanban_terminal_carry.py
+++ b/hermes_cli/kanban_terminal_carry.py
@@ -186,7 +186,7 @@ def reconcile_carry(cards: list[dict]) -> list[dict]:
             key = tuple(identity[k] for k in _IDENTITY)
             # Duplicate registrations are ambiguous rather than last-file-wins.
             receipts[key] = None if key in receipts else receipt
-        except (OSError, ValueError, KeyError, TypeError):
+        except (OSError, ValueError, KeyError, TypeError, RecursionError):
             continue
     result = []
     for card in cards:
@@ -209,7 +209,7 @@ def reconcile_carry(cards: list[dict]) -> list[dict]:
                                         terminal_carry_verified=True)
                 finally:
                     conn.close()
-        except (OSError, sqlite3.Error, ValueError, KeyError, TypeError):
+        except (OSError, sqlite3.Error, ValueError, KeyError, TypeError, IndexError, RecursionError):
             pass  # Missing/corrupt evidence preserves the explicit unknown obligation.
         result.append(restored)
     return result
diff --git a/tests/hermes_cli/test_kanban_terminal_carry.py b/tests/hermes_cli/test_kanban_terminal_carry.py
index 2da17806cf1..2e04d3dc206 100644
--- a/tests/hermes_cli/test_kanban_terminal_carry.py
+++ b/tests/hermes_cli/test_kanban_terminal_carry.py
@@ -227,16 +227,24 @@ def test_receiptless_goal_mode_never_uses_other_tasks_judge_epoch(world):
     assert not world['receipt'].exists()
 
 
-@pytest.mark.parametrize('failure', ['json', 'shape', 'missing_shadow', 'corrupt_shadow'])
+@pytest.mark.parametrize('failure', ['json', 'shape', 'missing_shadow', 'corrupt_shadow',
+                                     'nested_json', 'schema_skew'])
 def test_storage_failure_after_release_restores_unknown(world, failure):
     register(world)
     released = carry.reconcile_carry([world['card']])[0]
     assert released['released'] is True
+    def nested_json():
+        # Python 3.14's decoder uses a C-stack budget, not sys.getrecursionlimit().
+        depth = 100000
+        world['receipt'].write_text('[' * depth + '0' + ']' * depth)
+
     mutations = {
         'json': lambda: world['receipt'].write_text('{'),
         'shape': lambda: world['receipt'].write_text('[]'),
         'missing_shadow': world['replica'].unlink,
         'corrupt_shadow': lambda: world['replica'].write_bytes(b'not sqlite'),
+        'nested_json': nested_json,
+        'schema_skew': lambda: edit(world['replica'], 'ALTER TABLE tasks DROP COLUMN body'),
     }
     mutations[failure]()
     row = carry.reconcile_carry([released])[0]
-- 
2.55.0

