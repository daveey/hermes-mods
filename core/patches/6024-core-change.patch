From 8bcdbb3f09422764c6f1ee2cd712a75589b3af17 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 16:17:40 -0800
Subject: [PATCH 6024] Backup snapshot pruning and settled-result compaction

Public mirror of source commit 8bcdbb3f09422764c6f1ee2cd712a75589b3af17.

---
diff --git a/hermes_cli/backup.py b/hermes_cli/backup.py
index e6860560ace..65a173ae45d 100644
--- a/hermes_cli/backup.py
+++ b/hermes_cli/backup.py
@@ -1443,7 +1443,7 @@
     # smaller keep value so large state.db copies do not accumulate indefinitely.
     # The policy for an incomplete snapshot (#68805) lives in backup_prune.
     prune_after_snapshot(
-        root, _QUICK_DEFAULT_KEEP if keep is None else keep, failed_dbs, oversized_skipped
+        root, _QUICK_DEFAULT_KEEP if keep is None else keep, failed_dbs, oversized_skipped, snap_id
     )
 
     logger.info(
diff --git a/hermes_cli/backup_prune.py b/hermes_cli/backup_prune.py
index 447417a6fe1..0c242803023 100644
--- a/hermes_cli/backup_prune.py
+++ b/hermes_cli/backup_prune.py
@@ -45,7 +45,8 @@
 
 
 def prune_after_snapshot(
-    root: Path, keep: int, failed_dbs: Sequence[str], oversized_skipped: Sequence[str]
+    root: Path, keep: int, failed_dbs: Sequence[str], oversized_skipped: Sequence[str],
+    current: Optional[str] = None,
 ) -> None:
     """Prune after a new quick snapshot landed in ``root``.
 
@@ -73,9 +74,10 @@
     if not oversized_skipped:
         _prune_quick_snapshots(root, keep=keep)
         return
-    # max(keep, 1): an incomplete snapshot never prunes itself (keep=0 did nothing here before).
+    # An incomplete snapshot never prunes itself: keep is at least 1 (0 or a negative keep did nothing
+    # here before), and ``current`` (the snapshot just made) is exempt wherever its name sorts.
     _prune_quick_snapshots(
         root,
         keep=max(keep, 1),
-        protect=lambda d: any((d / rel).is_file() for rel in oversized_skipped),
+        protect=lambda d: d.name == current or any((d / rel).is_file() for rel in oversized_skipped),
     )
diff --git a/tests/hermes_cli/test_backup_prune.py b/tests/hermes_cli/test_backup_prune.py
index 833e30d40e1..1693c59c25e 100644
--- a/tests/hermes_cli/test_backup_prune.py
+++ b/tests/hermes_cli/test_backup_prune.py
@@ -51,11 +51,10 @@
         _advance_backup_clock()
 
         monkeypatch.setattr(backup, "_safe_copy_db", lambda *a, **k: False)
-        third_id = backup.create_quick_snapshot(label="failed", hermes_home=hermes_home, keep=1)
+        backup.create_quick_snapshot(label="failed", hermes_home=hermes_home, keep=1)
 
         snap_ids = {s["id"] for s in backup.list_quick_snapshots(limit=100, hermes_home=hermes_home)}
         assert {first_id, second_id} <= snap_ids
-        assert third_id is None or third_id in snap_ids
 
     def test_nested_board_db_skipped_for_size_protects_the_snapshot_holding_it(self, tmp_path):
         from hermes_cli.backup_prune import prune_after_snapshot
@@ -94,3 +93,14 @@
 
         assert len(list(root.iterdir())) == 3
         assert "skipped for size: state.db" in capsys.readouterr().out
+
+    def test_size_skip_never_prunes_the_new_snapshot_even_when_it_sorts_older(self, tmp_path):
+        from hermes_cli.backup_prune import prune_after_snapshot
+
+        root = tmp_path / "state-snapshots"
+        for name in ("20260101-000001-pre-update", "20260101-000001-zz", "20260101-000000"):
+            (root / name).mkdir(parents=True)
+
+        prune_after_snapshot(root, 1, [], ["state.db"], current="20260101-000001-pre-update")
+
+        assert sorted(d.name for d in root.iterdir()) == ["20260101-000001-pre-update", "20260101-000001-zz"]
