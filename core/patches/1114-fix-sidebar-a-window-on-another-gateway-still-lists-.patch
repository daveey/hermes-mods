+import { describe, expect, it, vi } from 'vitest'
+
+import type { SessionInfo, SidebarSessionsResponse } from '@/hermes'
+
+import { mergePrimaryRecents, withPrimaryRecents } from './primary-recents'
+
+const row = (id: string, over: Partial<SessionInfo> = {}): SessionInfo =>
+  ({ id, message_count: 3, profile: 'default', title: id, ...over }) as SessionInfo
+
+const page = (sessions: SessionInfo[], extra: Partial<SidebarSessionsResponse['recents']> = {}): SidebarSessionsResponse => ({
+  cron: { sessions: [] },
+  messaging: { sessions: [] },
+  recents: { sessions, ...extra }
+})
+
+describe('withPrimaryRecents', () => {
+  it('asks nothing extra while the window is on the primary (or untagged)', async () => {
+    const fetchPrimary = vi.fn()
+
+    for (const windowConnection of [null, undefined, '', 'local']) {
+      const result = await withPrimaryRecents(Promise.resolve(page([row('a')])), windowConnection, 'local', fetchPrimary)
+
+      expect(result.recents.sessions.map(s => s.id)).toEqual(['a'])
+    }
+
+    expect(fetchPrimary).not.toHaveBeenCalled()
+  })
+
+  it("adds this Mac's own stamped rows, tagged with the primary, while the window is on another gateway", async () => {
+    const hub = row('h1', { connection_id: 'hermes-hub' })
+    const own = row('cron-chat', { cron_active: true })
+
+    const result = await withPrimaryRecents(Promise.resolve(page([hub])), 'hermes-hub', 'local', () =>
+      Promise.resolve(page([own]))
+    )
+
+    expect(result.recents.sessions).toEqual([hub, { ...own, connection_id: 'local' }])
+  })
+
+  it("keeps the window's page when the primary read fails or comes back failed", async () => {
+    const hub = page([row('h1', { connection_id: 'hermes-hub' })])
+
+    const rejected = await withPrimaryRecents(Promise.resolve(hub), 'hermes-hub', 'local', () =>
+      Promise.reject(new Error('ECONNREFUSED'))
+    )
+
+    expect(rejected).toBe(hub)
+    expect(mergePrimaryRecents(hub, page([row('x')], { failed: true }), 'local')).toBe(hub)
+    expect(mergePrimaryRecents(hub, page([row('x')], { retry: true }), 'local')).toBe(hub)
+    expect(mergePrimaryRecents(hub, page([]), 'local')).toBe(hub)
+  })
+
+  it('never duplicates a row the window page already carries for the same owner', () => {
+    const hub = page([row('same', { connection_id: 'local' }), row('h1', { connection_id: 'hermes-hub' })])
+    const merged = mergePrimaryRecents(hub, page([row('same'), row('h1')]), 'local')
+
+    // `h1` of the primary is a different owner than the hub's `h1`: both stay; `same` stays once.
+    expect(merged.recents.sessions.map(s => [s.id, s.connection_id])).toEqual([
+      ['same', 'local'],
+      ['h1', 'hermes-hub'],
+      ['h1', 'local']
+    ])
+  })
+})
diff --git a/apps/desktop/src/app/session/hooks/primary-recents.ts b/apps/desktop/src/app/session/hooks/primary-recents.ts
new file mode 100644
index 00000000000..453f99aaa64
--- /dev/null
+++ b/apps/desktop/src/app/session/hooks/primary-recents.ts
@@ -0,0 +1,58 @@
+import type { SessionInfo, SidebarSessionsResponse } from '@/hermes'
+
+/**
+ * [daveey] The sidebar list follows the window's connection. While the window is on another gateway (the hub), that
+ * list carries none of this Mac's own chats, so `mergeOfflineFallback` kept painting them from the cold-start boot
+ * snapshot: frozen at launch, with no activity stamps (`cron_active`, `kanban_*`, `outcome`, ...). Those copies
+ * shadow the stamped projects-tree rows, so a chat that owns a live cron job (or waits on cards) lost its stripe
+ * for as long as the window stayed on the hub.
+ *
+ * Fold the primary backend's own recents page (pinned rows included) into the window's page, tagged with the
+ * primary's connection id. A failed or unreachable primary read changes nothing: the window's page is returned as
+ * is and the fallback rows keep painting as before.
+ */
+export async function withPrimaryRecents(
+  page: Promise<SidebarSessionsResponse>,
+  windowConnection: null | string | undefined,
+  primaryConnection: string,
+  fetchPrimary: () => Promise<SidebarSessionsResponse>
+): Promise<SidebarSessionsResponse> {
+  const remote = Boolean(windowConnection?.trim()) && windowConnection?.trim() !== primaryConnection
+
+  if (!remote) {
+    return page
+  }
+
+  const [result, own] = await Promise.all([page, fetchPrimary().catch(() => null)])
+
+  return mergePrimaryRecents(result, own, primaryConnection)
+}
+
+/** Exported for tests: the window's page plus the primary's recents rows it does not already carry. */
+export function mergePrimaryRecents(
+  result: SidebarSessionsResponse,
+  own: null | SidebarSessionsResponse | undefined,
+  primaryConnection: string
+): SidebarSessionsResponse {
+  const ownRows = own?.recents?.sessions
+
+  if (!own || own.recents?.failed === true || own.recents?.retry === true || !ownRows?.length) {
+    return result
+  }
+
+  const key = (row: SessionInfo) =>
+    `${row.connection_id?.trim() || primaryConnection}\u0000${(row.profile ?? '').trim() || 'default'}\u0000${row.id}`
+
+  const windowRows = result.recents?.sessions ?? []
+  const have = new Set(windowRows.map(key))
+
+  const added = ownRows
+    .map(row => (row.connection_id?.trim() ? row : { ...row, connection_id: primaryConnection }))
+    .filter(row => !have.has(key(row)))
+
+  if (!added.length) {
+    return result
+  }
+
+  return { ...result, recents: { ...result.recents, sessions: [...windowRows, ...added] } }
+}
