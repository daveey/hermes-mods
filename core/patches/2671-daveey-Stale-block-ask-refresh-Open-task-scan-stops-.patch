From fa8154e689c6045fb64da2afaeff1b71a9ade212 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:48:00 -0800
Subject: [PATCH] [daveey] Stale block-ask refresh: Open-task scan stops only
 at a real notice head; tid cannot backtrack (review F3/F4)

---
 hermes_cli/kanban_stale_ask.py               | 12 ++++++----
 tests/gateway/test_kanban_stale_block_ask.py | 24 ++++++++++++++++++++
 2 files changed, 31 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_stale_ask.py b/hermes_cli/kanban_stale_ask.py
index dabdb0a6a4..18cda4e325 100644
--- a/hermes_cli/kanban_stale_ask.py
+++ b/hermes_cli/kanban_stale_ask.py
@@ -38,12 +38,14 @@ def _field(*marks: str) -> str:
 _ASK = re.compile(
     r"(?P<head>blocked — actor: [^\n]*\n)Next action for the user: (?P<action>" + _field("\nWhy only the user: ") + r")\n"
     r"Why only the user: " + _field("\nScope: ") + r"\n"
-    r"(?P<rest>Scope: (?P<scope>" + _field("\nOpen task: ") + r")\nOpen task: @task:(?P<board>[^/@\s]+)(?:@(?P<gw>[^/\s]+))?/(?P<tid>[A-Za-z0-9_-]+))"
+    r"(?P<rest>Scope: (?P<scope>" + _field("\nOpen task: ") + r")\nOpen task: @task:(?P<board>[^/@\s]+)(?:@(?P<gw>[^/\s]+))?/(?P<tid>[A-Za-z0-9_-]+)(?![A-Za-z0-9_-]))"
+    # (The tid guard makes a shorter tid fail at once, so a long token cannot backtrack: review F4.)
     r"(?P<hint>" + re.escape(TERMINAL_HINT) + r")?"
-    # A second "Open task:" line before the next notice's actor line (or the end of the text) means a
-    # field quoted one, so the matched Open task may be a quote: ambiguous, leave it. The scan does not
-    # stop at a blank line, since a human_request field may contain one (review F1/F2).
-    r"(?!(?:(?!blocked — actor: ).)*\nOpen task: )",
+    # A second "Open task:" line before the next notice's head (its actor line followed by the ask mark)
+    # or the end of the text means a field quoted one, so the matched Open task may be a quote:
+    # ambiguous, leave it. The scan stops neither at a blank line nor at a bare "blocked — actor: "
+    # substring, since a human_request field may contain either (review F1/F2/F3).
+    r"(?!(?:(?!blocked — actor: [^\n]*\nNext action for the user: ).)*\nOpen task: )",
     re.DOTALL)
 logger = logging.getLogger(__name__)
 _PT = "America/Los_Angeles"
diff --git a/tests/gateway/test_kanban_stale_block_ask.py b/tests/gateway/test_kanban_stale_block_ask.py
index 76feb1f004..9b820c788b 100644
--- a/tests/gateway/test_kanban_stale_block_ask.py
+++ b/tests/gateway/test_kanban_stale_block_ask.py
@@ -221,6 +221,30 @@ def test_scope_copied_from_a_done_cards_notice_keeps_the_ask(tmp_path, monkeypat
         assert refresh_stale_ask(text) == text, tail
 
 
+def test_copied_scope_with_an_actor_substring_in_its_tail_keeps_the_ask(tmp_path, monkeypatch):
+    """Review F3: a "blocked — actor: " substring in the copied scope's tail must not end the
+    second-Open-task scan early; only a real notice head (actor line + ask mark) does."""
+    from hermes_cli.kanban_stale_ask import refresh_stale_ask
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    copied, _task = _card_with_scope("Only this card.")
+    _finish(copied)
+    for tail in ("\nblocked — actor: user\nmore", " (see blocked — actor: user)", "\n\nblocked — actor: x"):
+        tid, task = _card_with_scope(f"Only this card.\nOpen task: @task:default/{copied}{tail}")
+        text = _wake_text(tid, task)
+        assert refresh_stale_ask(text) == text, tail
+
+
+def test_long_task_token_does_not_backtrack(tmp_path, monkeypatch):
+    """Review F4: a long task token followed by a later Open task line must not cost seconds."""
+    import time
+    from hermes_cli.kanban_stale_ask import _ASK
+    text = ("blocked — actor: user\nNext action for the user: Choose.\nWhy only the user: y\nScope: z\n"
+            "Open task: @task:default/" + "a" * 8000 + "\nOpen task: @task:default/t_x")
+    start = time.monotonic()
+    assert _ASK.search(text) is None
+    assert time.monotonic() - start < 0.5
+
+
 def test_open_task_line_inside_scope_of_a_done_card_is_left_alone(tmp_path, monkeypatch):
     """Ambiguous notice (two Open task lines): unchanged, never guessed."""
     from hermes_cli.kanban_stale_ask import refresh_stale_ask
