From 2375f94701b76b3fcc15cb8686c152be97c886d1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 19:30:29 +0000
Subject: [PATCH] [daveey] spike(R1) V2a: VIRTUAL_WIRE_FIELDS allowed by
 _wire_fields; unseen full-row keeps virtual fields

---
 hermes_cli/kanban_db_sync.py     | 4 ++++
 hermes_cli/kanban_sync_client.py | 5 ++++-
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_db_sync.py b/hermes_cli/kanban_db_sync.py
index 9bec000d87..fa65a3e61d 100644
--- a/hermes_cli/kanban_db_sync.py
+++ b/hermes_cli/kanban_db_sync.py
@@ -114,6 +114,10 @@ REF_COLUMNS: dict[tuple[str, str], str] = {
     ("task_events", "run_id"): "run_uid",
 }
 SYNCED_TABLES = tuple(SYNCED_COLUMNS)
+# Wire-only fields: carried by an outbox op and sent, never a column (so never in ``SYNCED_COLUMNS``, which
+# ``undeclared_columns``, ``_row_fields`` and the import path read as real columns). ``source_receipt`` rides
+# the status-leaving tasks op (``kanban_source_receipt``); an old Board's refusal drops it with no omission.
+VIRTUAL_WIRE_FIELDS: dict[str, frozenset[str]] = {"tasks": frozenset({"source_receipt"})}
 # Synced columns core keeps in Unix SECONDS (``int(time.time())``). The service's own clocks (leases, HLCs, the feed,
 # tombstones) are milliseconds; a millisecond value in one of these columns makes every ``now - started_at`` reader
 # wrong by 1000x (2026-10-27: the Board's lease grants wrote ``task_runs.started_at`` in ms and
diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index e2004582d1..5a5709dd68 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -547,6 +547,7 @@ def _next_hlc(conn: sqlite3.Connection, gateway: str) -> str:
 def _wire_fields(table: str, fields: dict) -> dict:
     """Only the synced wire columns (a column a later migration added is not sent until it is declared)."""
     allowed = {sync._wire_name(table, c) for c in sync.SYNCED_COLUMNS[table]}
+    allowed |= sync.VIRTUAL_WIRE_FIELDS.get(table, frozenset())
     return {k: v for k, v in fields.items() if k in allowed}
 
 
@@ -587,7 +588,9 @@ def _full_row_if_unseen(conn: sqlite3.Connection, row: dict) -> dict:
     if task is None or task["sync_version"] is not None:
         from hermes_cli.kanban_worker_placement import acknowledged_outbox
         return acknowledged_outbox(row, task)
-    return {**row, "fields": _row_fields(conn, "tasks", task)}
+    fields = row["fields"] if isinstance(row["fields"], dict) else json.loads(row["fields"])
+    virtual = {k: v for k, v in fields.items() if k in sync.VIRTUAL_WIRE_FIELDS["tasks"]}  # not in the row
+    return {**row, "fields": {**_row_fields(conn, "tasks", task), **virtual}}
 
 
 # Rejections the service lifts on its own; anything else is final. A capped number of retries keeps a real mismatch
-- 
2.51.0

