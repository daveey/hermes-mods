From 1399c76f511736867064c4b7195505f7efc89ebb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 20:49:37 +0000
Subject: [PATCH 6521] Forward retry identity

Public mirror of source commit 1399c76f511736867064c4b7195505f7efc89ebb.

---
diff --git a/tests/hermes_cli/test_kanban_forward_retry_boundary.py b/tests/hermes_cli/test_kanban_forward_retry_boundary.py
index 7784b0c8961..66620cbc7dc 100644
--- a/tests/hermes_cli/test_kanban_forward_retry_boundary.py
+++ b/tests/hermes_cli/test_kanban_forward_retry_boundary.py
@@ -17,6 +17,7 @@
 
 @pytest.mark.parametrize("case", [
     "valid", "same-run", "keyless", "wrong-key", "wrong-creator", "wrong-origin", "missing-run",
+    "empty-run", "null-run", "integer-run", "list-run", "object-run",
     "done", "sent", "queued", "failed", "expired", "unknown", "other-code", "handoff", "missing-handoff",
     "wrong-status", "wrong-action", "wrong-collection", "malformed-body", "malformed-result", "absent", "legacy-row",
 ])
@@ -28,6 +29,11 @@
         "wrong-creator": lambda: body["args"].update(creator={**CREATOR, "task_id": "t_abcdef0123456789"}),
         "wrong-origin": lambda: body["args"].update(origin={**ORIGIN, "session": "elsewhere"}),
         "missing-run": lambda: body["args"].pop("run_uid"),
+        "empty-run": lambda: body["args"].update(run_uid=""),
+        "null-run": lambda: body["args"].update(run_uid=None),
+        "integer-run": lambda: body["args"].update(run_uid=3),
+        "list-run": lambda: body["args"].update(run_uid=["run-1"]),
+        "object-run": lambda: body["args"].update(run_uid={"uid": "run-1"}),
         "other-code": lambda: result.update(code="self_work_refused"),
         "handoff": lambda: result.update(handoff_complete=True),
         "missing-handoff": lambda: result.pop("handoff_complete"),
diff --git a/tests/hermes_cli/test_kanban_placement_identity.py b/tests/hermes_cli/test_kanban_placement_identity.py
index eff9810b65e..c916539d794 100644
--- a/tests/hermes_cli/test_kanban_placement_identity.py
+++ b/tests/hermes_cli/test_kanban_placement_identity.py
@@ -199,4 +199,8 @@
     second = call("run-2")
     assert second["ok"] and second["request_id"] != first["request_id"]
     assert call("run-2")["request_id"] == second["request_id"]  # exact retries in that run stay stable
-    assert ["idempotency_key=" + json.dumps("product-key")] == stored[second["request_id"]][1]
+    third = call("run-3")
+    assert third["ok"] and third["request_id"] not in (first["request_id"], second["request_id"])
+    assert call("run-3")["request_id"] == third["request_id"]
+    for retry in (second, third):
+        assert ["idempotency_key=" + json.dumps("product-key")] == stored[retry["request_id"]][1]
-- 
