From 3bff2cda2341883019ccc4cb40f3939e084b5270 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 22:29:40 +0000
Subject: [PATCH] [daveey] fix(kanban): evict a cached reader whose
 busy_timeout restore fails; share the 500 ms constant

Review follow-up: a failed restore no longer leaves a zero-budget reader
cached, the lifecycle opener uses _RO_BUSY_TIMEOUT_S, and a non-sqlite body
error test replaces a warm-key test that also passed on the parent.
---
 hermes_cli/kanban_reader_lifecycle.py          |  2 +-
 hermes_cli/kanban_session_activity.py          |  8 +++++++-
 .../test_kanban_content_key_busy_budget.py     | 18 +++++++++---------
 3 files changed, 17 insertions(+), 11 deletions(-)

diff --git a/hermes_cli/kanban_reader_lifecycle.py b/hermes_cli/kanban_reader_lifecycle.py
index 62dce1f1cf1..6ca561b28d7 100644
--- a/hermes_cli/kanban_reader_lifecycle.py
+++ b/hermes_cli/kanban_reader_lifecycle.py
@@ -41,7 +41,7 @@ def _cached_entry_once(path, remaining):
                 stale[2].release()
         if entry is None:
             conn = activity._open_ro(path, check_same_thread=False, timeout=0)
-            conn.execute("PRAGMA busy_timeout=500")
+            conn.execute(f"PRAGMA busy_timeout={int(activity._RO_BUSY_TIMEOUT_S * 1000)}")
             entry = (conn, ident, threading.Lock(), shm_identity(path))
             with activity._RO_CACHE_LOCK:
                 activity._RO_CACHE[key] = entry
diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index c1008ca018a..90bb121296c 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -543,7 +543,13 @@ def cached_ro(path: Path, *, busy_budget: float = 0.5) -> Iterator[sqlite3.Conne
             raise
         finally:
             if lowered and _RO_CACHE.get(key) is entry:
-                conn.execute(f"PRAGMA busy_timeout={int(_RO_BUSY_TIMEOUT_S * 1000)}")
+                try:
+                    conn.execute(f"PRAGMA busy_timeout={int(_RO_BUSY_TIMEOUT_S * 1000)}")
+                except sqlite3.Error:  # never keep a reader with the probe's budget
+                    with _RO_CACHE_LOCK:
+                        if _RO_CACHE.get(key) is entry:
+                            del _RO_CACHE[key]
+                    _close_quietly(conn)
 
 
 # The cached reader's own SQLite busy timeout, set when ``kanban_reader_lifecycle`` opens it.
diff --git a/tests/hermes_cli/test_kanban_content_key_busy_budget.py b/tests/hermes_cli/test_kanban_content_key_busy_budget.py
index 09c6cc12410..4d0b0c167a1 100644
--- a/tests/hermes_cli/test_kanban_content_key_busy_budget.py
+++ b/tests/hermes_cli/test_kanban_content_key_busy_budget.py
@@ -80,13 +80,13 @@ def test_cached_reader_statement_budget_restored_after_no_wait_key(busy_board):
         assert again.execute("PRAGMA busy_timeout").fetchone()[0] == 500
 
 
-def test_warm_key_read_on_busy_board_does_not_wait_in_sqlite(busy_board):
-    board, blocker = busy_board
+def test_cached_reader_budget_restored_after_non_sqlite_error(busy_board):
+    board, _blocker = busy_board
     with activity.cached_ro(board) as conn:
-        conn.execute("SELECT count(*) FROM marker").fetchone()
-    blocker.execute("BEGIN EXCLUSIVE")
-    # The cached handle is reused; with busy_timeout=0 SQLite raises at once and the key falls back.
-    assert activity._board_content_key(board)[0] == "stat"
-    blocker.rollback()
-    with activity.cached_ro(board) as reopened:
-        assert reopened.execute("PRAGMA busy_timeout").fetchone()[0] == 500
+        pass
+    with pytest.raises(RuntimeError), activity.cached_ro(board, busy_budget=0) as same:
+        assert same is conn
+        raise RuntimeError("body failed outside SQLite")
+    with activity.cached_ro(board) as again:
+        assert again is conn  # still cached: only sqlite errors evict
+        assert again.execute("PRAGMA busy_timeout").fetchone()[0] == 500
-- 
2.55.0

