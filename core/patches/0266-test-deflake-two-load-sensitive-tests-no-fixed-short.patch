From b60f11ae12bcb9cda3ad9cce6d267136cdfb08bc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 19:58:35 -0700
Subject: [PATCH] test: deflake two load-sensitive tests (no fixed short
 wall-clock deadlines) [daveey]

test_redirect_from_input_thread_cancels_live_model_request waited 2 s
for the turn to reach the model call; on a CPU-throttled runner it
failed both attempts. It now waits on the events with a 30 s bound that
returns as soon as they fire.
test_transient_remote_stop_failure_stays_pending_and_retries ran with a
0.4 s driver lease and 1-5 s waits; the lease lapsed between retries
under load. Lease expiry is not under test, so it uses a 30 s lease and
30 s event bounds.
Under a SIGSTOP/SIGCONT duty cycle (30 ms run / 1.2 s stopped) the old
versions failed 2/2 and 1/3; the new ones passed 2/2 and 9/9.

t_94f2c8ba
---
 tests/agent/test_run_agent.py                 | 15 ++++++++++----
 .../test_hosted_room_driver_runtime.py        | 20 +++++++++++++++----
 2 files changed, 27 insertions(+), 8 deletions(-)

diff --git a/tests/agent/test_run_agent.py b/tests/agent/test_run_agent.py
index 19caa6fbce..9180fe4c1d 100644
--- a/tests/agent/test_run_agent.py
+++ b/tests/agent/test_run_agent.py
@@ -26,6 +26,11 @@ from agent.memory_manager import MemoryManager
 from agent.prompt_builder import DEFAULT_AGENT_IDENTITY
 from tui_gateway import server as tui_server
 
+# Upper bound for one thread to observe another (event set, redirect seen,
+# join). Generous on purpose: the waits return as soon as the event fires, and
+# a loaded CI host can take seconds to schedule a thread (t_94f2c8ba).
+_CROSS_THREAD_TIMEOUT_S = 30.0
+
 
 # ---------------------------------------------------------------------------
 # Fixtures
@@ -4009,8 +4014,10 @@ class TestRunConversation:
             if calls == 1:
                 agent._fire_reasoning_delta("Following the original approach.")
                 entered.set()
-                deadline = time.time() + 2
-                while not agent._interrupt_requested and time.time() < deadline:
+                # Wait for the redirect itself, not a wall-clock guess: on a
+                # loaded CI host the turn took >2 s just to reach this call.
+                deadline = time.monotonic() + _CROSS_THREAD_TIMEOUT_S
+                while not agent._interrupt_requested and time.monotonic() < deadline:
                     time.sleep(0.01)
                 raise InterruptedError("request cancelled by redirect")
             return final
@@ -4027,9 +4034,9 @@ class TestRunConversation:
                 )
             )
             worker.start()
-            assert entered.wait(timeout=2)
+            assert entered.wait(timeout=_CROSS_THREAD_TIMEOUT_S)
             assert agent.redirect("Use the corrected approach.") is True
-            worker.join(timeout=5)
+            worker.join(timeout=_CROSS_THREAD_TIMEOUT_S)
 
         assert worker.is_alive() is False
         assert calls == 2
diff --git a/tests/tui_gateway/test_hosted_room_driver_runtime.py b/tests/tui_gateway/test_hosted_room_driver_runtime.py
index 2bbc20d562..22bc6b1ae7 100644
--- a/tests/tui_gateway/test_hosted_room_driver_runtime.py
+++ b/tests/tui_gateway/test_hosted_room_driver_runtime.py
@@ -422,6 +422,11 @@ def _runtime(
     )
 
 
+# Event waits that return the moment the condition holds; the bound only
+# matters on a starved host, where a few seconds is not enough.
+_LOADED_HOST_TIMEOUT_S = 30.0
+
+
 def _wait_for(predicate, *, timeout: float = 5.0) -> None:
     deadline = time.monotonic() + timeout
     while time.monotonic() < deadline:
@@ -1509,7 +1514,11 @@ def test_transient_remote_stop_failure_stays_pending_and_retries(db: Path):
     identity = _identity()
     _admit(db, identity)
     rpc = FakeSessionRPC(auto_complete=False)
-    runtime = _runtime(db, rpc)
+    # Lease expiry is not under test here. The default 0.4 s lease lapsed
+    # between retries on a CPU-throttled CI runner, and the cancel never
+    # settled within the wait (t_94f2c8ba). A long lease takes wall-clock
+    # scheduling out of the outcome.
+    runtime = _runtime(db, rpc, lease_ttl_seconds=30.0)
     original_interrupt = rpc.interrupt
     attempts = 0
     retry_allowed = threading.Event()
@@ -1519,18 +1528,21 @@ def test_transient_remote_stop_failure_stays_pending_and_retries(db: Path):
         attempts += 1
         if attempts == 1:
             raise RuntimeError("temporary stop transport failure")
-        assert retry_allowed.wait(1.0)
+        assert retry_allowed.wait(_LOADED_HOST_TIMEOUT_S)
         return original_interrupt(**kwargs)
 
     rpc.interrupt = flaky_interrupt
     runtime.start()
-    assert rpc.submitted.wait(1.0)
+    assert rpc.submitted.wait(_LOADED_HOST_TIMEOUT_S)
     stopping = runtime.cancel(identity, cancel_id="cancel-retry")
     assert stopping["status"] == "stopping"
     assert state.get_task(db, identity)["status"] == "stopping"
     retry_allowed.set()
     runtime.wakeup()
-    _wait_for(lambda: state.get_task(db, identity)["status"] == "cancelled")
+    _wait_for(
+        lambda: state.get_task(db, identity)["status"] == "cancelled",
+        timeout=_LOADED_HOST_TIMEOUT_S,
+    )
     assert attempts >= 2
     assert runtime.stop(timeout=5.0)
     assert state.get_task(db, identity)["status"] == "cancelled"
-- 
