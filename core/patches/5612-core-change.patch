From fda7e141771a92cd2cd88d2ba52374758cd0e09c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 13:21:11 +0000
Subject: [PATCH] test(kanban): provision executing profile for tier admission
 [daveey]

---
 tests/plugins/test_kanban_model_override.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/tests/plugins/test_kanban_model_override.py b/tests/plugins/test_kanban_model_override.py
index e95ec3d6d2..60d1a1857b 100644
--- a/tests/plugins/test_kanban_model_override.py
+++ b/tests/plugins/test_kanban_model_override.py
@@ -175,7 +175,11 @@ def test_spawn_resolves_claimed_task_policy(
 
     profile = kanban_home / "profiles" / "elias"
     profile.mkdir(parents=True)
-    (profile / "config.yaml").write_text("{}\n")  # identity marker: a bare dir is not a live profile
+    # Tier admission reads the executing profile, not the root-home registry.
+    (profile / "config.yaml").write_text((kanban_home / "config.yaml").read_text())
+    from hermes_cli.kanban_model_assignment import _assignee_config
+    effective = _assignee_config("elias")
+    assert effective is not None and effective["model_routing"]["enabled"] is True
     workspace = tmp_path / "ws"
     workspace.mkdir()
     overrides = dict(overrides)
-- 
