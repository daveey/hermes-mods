From a2253c7f196c9059aac75dc5f2c491fa9b8f408d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:14:12 +0000
Subject: [PATCH] fix(status): retain asks and remote ownership on adapter
 failure

N1: carry human_request from the existing count SELECTs into board assemble fallback, without another query. N2: remote failed_card uses only remote gateway and owner_profile (legacy profile only when owner_profile absent), never local defaults or unrelated source ownership.

Root (happened): fallback reconstruction discarded count-row asks and reused local ownership for remote rows. Evidence: failure-isolation-review.md N1/N2 and regression RED logs; assemble ask failed with KeyError, and all 24 remote fault/owner/source cases failed ownership assertions before correction.

Root (not caught): prior assemble test asserted only legacy counts; add_cards failure fixture covered only local rows. Strengthen real multi-session counts and exercise remote session_tasks for missing, partial and conflicting owner fields.

Recurrence: first N1/N2 occurrence identified by exact-head ade594f review; inspected recent adapter/activity history (ade594f, 29b07d). Countermeasure proof: nice bash scripts/run_tests.sh over failure isolation, card observations, source snapshot, session activity, source safety, golden and show-current-run: 420 passed, exit 0. Logs and full command/hash evidence in parent workspace n1-n2-*.log; no lifecycle, clock or policy changes.
---
 hermes_cli/kanban_execution_observations.py   | 10 ++--
 hermes_cli/kanban_session_activity.py         | 36 ++++++-------
 ...test_kanban_execution_failure_isolation.py | 53 +++++++++++++++++--
 3 files changed, 74 insertions(+), 25 deletions(-)

diff --git a/hermes_cli/kanban_execution_observations.py b/hermes_cli/kanban_execution_observations.py
index 7d029a7e89..22f65802b1 100644
--- a/hermes_cli/kanban_execution_observations.py
+++ b/hermes_cli/kanban_execution_observations.py
@@ -180,9 +180,13 @@ def failed_card(row, *, gateway=None, profile=None, now=None):
     from hermes_cli.kanban_execution_source import unknown_raw
     source = row.get("_execution_source")
     source = source if isinstance(source, dict) else {}
-    value = unknown_raw(row, {**source, "gateway": source.get("gateway") or gateway,
-                              "profile": source.get("profile") or profile,
-                              "board": source.get("board") or row.get("board")})
+    if row.get("remote"):
+        source = {"gateway": row.get("gateway"), "profile": row.get("owner_profile", row.get("profile")),
+                  "board": row.get("board")}
+    else:
+        source = {**source, "gateway": source.get("gateway") or gateway,
+                  "profile": source.get("profile") or profile, "board": source.get("board") or row.get("board")}
+    value = unknown_raw(row, source)
     return _project(value, now=time.time() if now is None else now, source_class="sidebar")
 
 
diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index 8c09c38811..6f006c36af 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -208,27 +208,24 @@ def _read_counts(path: Path, statuses: tuple[str, ...] = ACTIVE_STATUSES) -> dic
         conn.close()
 
 
-def _counts_on(conn: sqlite3.Connection, statuses: tuple[str, ...] = ACTIVE_STATUSES) -> dict[str, int]:
-    if "session_id" not in {r[1] for r in conn.execute("PRAGMA table_info(tasks)")}:
