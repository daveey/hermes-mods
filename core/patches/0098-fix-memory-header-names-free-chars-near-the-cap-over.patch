From 340f8d60473737c769a20eb05926f1b90cc50f19 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 15 Oct 2026 19:57:48 -0700
Subject: [PATCH] fix(memory): header names free chars near the cap; overflow
 errors target 10% headroom [daveey]

Both memory stores lived at 97-99% (2,170/2,200 and 1,364/1,375). The
system-prompt header showed only a percentage, so every save (foreground
and background review) tried a bare add or a lengthening patch first,
overflowed, and needed a second call. The retry then freed just enough to
fit, which left the store at the cap again for the next save.

- Header: once free space is under 10% of the limit, it names the free
  char count and the same-batch rule.
- Over-limit errors (add/patch/replace/batch) also say how much to free
  to leave 10% headroom, so one consolidation breaks the cycle.
- Schema IF FULL: check the header's free count and batch removes with
  the add on the first call.
---
diff --git a/tests/tools/test_memory_tool.py b/tests/tools/test_memory_tool.py
index a1823dbd336e54bcafff9fe05c0d12c29daea929..ba98c024e5f09d606ce73df51e3741e5ae5076a4 100644
--- a/tests/tools/test_memory_tool.py
+++ b/tests/tools/test_memory_tool.py
@@ -276,6 +276,12 @@ class TestMemoryStoreReplace:
         store.add("memory", "x" * 380)  # 65 + 3 + 380 = 448 of 500
         full = store.add("memory", "y" * 54)  # 448 + 3 + 54 = 505
         assert "by 5 chars" in full["error"] and "free at least 5 chars" in full["error"]
+        # ...and how much to free so the NEXT save fits too: 505 - 450 (90% of 500) = 55.
+        assert "Free ~55 chars instead to leave 10% headroom" in full["error"]
+        over = store.apply_batch("memory", [{"action": "patch", "old_text": "manual approval",
+                                             "content": "manual approval, " + "z" * 60}])  # +62 -> 510
+        assert "free at least 10 chars" in over["error"] and "Free ~60 chars instead" in over["error"]
+        assert store.memory_entries[0].endswith("manual approval.")  # all-or-nothing: unchanged
         miss = store.apply_batch("memory", [{"action": "patch", "old_text": "Deploys via GitHub Actions to Fly",
                                              "content": "Deploys: Fly.io + canary."}])
         assert miss["closest_entries"] == ["Deploys go through GitHub Actions to Fly.io with manual approval."]
@@ -462,6 +468,22 @@ class TestMemoryStoreSnapshot:
         assert "loaded at start" in snapshot
         assert "added later" not in snapshot
 
+    def test_header_calls_out_free_chars_when_nearly_full(self, store):
+        """Stores lived at 97-99% (2,170/2,200): the header showed only a percentage, so every
+        save tried a bare add first, overflowed, and retried. Under 10% headroom the header now
+        names the free count and the same-batch rule; with room to spare it stays terse."""
+        store.add("memory", "x" * 200)
+        store.load_from_disk()
+        roomy = store.format_for_system_prompt("memory")
+        assert "[40% — 200/500 chars]\n" in roomy and "free" not in roomy
+
+        store.add("memory", "y" * 260)  # 200 + 3 + 260 = 463 of 500
+        store.load_from_disk()
+        tight = store.format_for_system_prompt("memory")
+        header = tight.splitlines()[1]
+        assert header.startswith("MEMORY (your personal notes) [92% — 463/500 chars]")
+        assert "only 37 chars free" in header and "SAME batch" in header
+
 
 # =========================================================================
 # memory_tool() dispatcher
diff --git a/tools/memory_tool.py b/tools/memory_tool.py
index abf8342f0b074ee239b2ea0cff8e260abc01a376..6156588728c54d663e4cc0eb0914fed178c3e87b 100644
--- a/tools/memory_tool.py
+++ b/tools/memory_tool.py
@@ -387,8 +387,10 @@ MEMORY_SCHEMA = {
         "corrections for that kind of work) belongs in the task's skill via skill_manage, "
         "where it loads only when relevant; memory is injected into every turn and must "
         "stay small.\n\n"
-        "IF FULL: an add is rejected with the current entries shown. Reissue as ONE batch that "
-        "removes or shortens enough stale entries and adds the new one together.\n\n"
+        "IF FULL: check the memory block header before writing — when it says only N chars are "
+        "free and your new text is longer, send the add/patch in ONE batch with removes or "
+        "shortening patches of stale entries on the FIRST call (an add alone is rejected). Free "
+        "enough to leave ~10% headroom so the next save fits too.\n\n"
         "TARGETS: 'user' = who the user is (name, role, preferences, style). 'memory' = your "
         "notes (environment, conventions, tool quirks, lessons).\n\n"
         "SKIP: trivial/obvious info, easily re-discovered facts, raw data dumps, task progress, "
-- 
