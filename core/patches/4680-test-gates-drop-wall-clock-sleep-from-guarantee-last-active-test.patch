\ No newline at end of file
+{"version": 1, "fingerprint": "417f2db477576e05458a5c19fdd4aff806808899aeffb5c40a7ee2aede6dc3f2", "hooks": ["on_session_end", "post_tool_call", "pre_tool_call", "transform_tool_result"]}
\ No newline at end of file
diff --git a/tests/tui_gateway/test_h2_gate_mutations.py b/tests/tui_gateway/test_h2_gate_mutations.py
