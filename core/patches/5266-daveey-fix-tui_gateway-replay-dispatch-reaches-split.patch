From acb7000ac2f5bc02c41277721263735ed7f0454c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 18:42:48 +0000
Subject: [PATCH] [daveey] fix(tui_gateway): replay dispatch reaches
 split-module helpers through server

automation_replay_dispatch.Delivery.stage imported _submit_row_target_key and
_SUBMIT_ROW_SESSION_KEY straight from tui_gateway.session_workdir (PR #3773).
session_workdir is a bind_module split module, so tests/tui_gateway/
test_split_module_imports.py requires its names be reached as server.<name>;
main CI (run 44784092422) and every PR based on main fail on that guard.

Runtime check: the raw copy of _submit_row_target_key reads only its argument
(no server globals) and _SUBMIT_ROW_SESSION_KEY is a constant, so the direct
import did not hit an unbound global today. The guard is a blanket rule against
a latent NameError if the helper ever grows a server global, so this follows it
rather than exempting it; behaviour is unchanged (producer_admission and
session_notifications reach the same helpers the same way).

Tests: tests/tui_gateway/test_split_module_imports.py and
test_automation_replay*.py: 109 passed.
---
 tui_gateway/automation_replay_dispatch.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/tui_gateway/automation_replay_dispatch.py b/tui_gateway/automation_replay_dispatch.py
index 80f7150c3c..b0de79c806 100644
--- a/tui_gateway/automation_replay_dispatch.py
+++ b/tui_gateway/automation_replay_dispatch.py
@@ -15,10 +15,10 @@ class Delivery:
         """Write on the journal's transaction, then adopt its exact committed content."""
         from agent.context_compressor import _DB_PERSISTED_MARKER
         from agent.message_metadata import stamp_message_timestamp
-        from tui_gateway.session_workdir import _submit_row_target_key, _SUBMIT_ROW_SESSION_KEY
+        from tui_gateway import server
         if db is None or Path(db.db_path).resolve() != self.journal.path:
             raise ValueError("replay profile store mismatch")
-        target = _submit_row_target_key(session)
+        target = server._submit_row_target_key(session)
         staged = stamp_message_timestamp({"role": "user", "content": text,
                                           "display_kind": kind, "display_metadata": metadata})
 
@@ -48,7 +48,7 @@ class Delivery:
                       "display_kind": row["display_kind"],
                       "display_metadata": json.loads(row["display_metadata"] or "{}")}
         staged[_DB_PERSISTED_MARKER] = True
-        staged[_SUBMIT_ROW_SESSION_KEY] = receipt["target"]
+        staged[server._SUBMIT_ROW_SESSION_KEY] = receipt["target"]
         session["_submit_user_row"] = staged
         session["_marker_until_tool"] = True
         self.session, self.staged = session, staged
