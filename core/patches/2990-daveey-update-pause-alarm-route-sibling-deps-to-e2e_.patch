From bb18338145f3b973253fb7c282ff1729ccae0501 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 17:39:15 +0000
Subject: [PATCH] [daveey] update-pause alarm: route sibling deps to
 e2e_upgrade; own non-primary keys only by created_on

- CI (shard 8/8 on 122633a): test_update_ci_routing found update_pause_siblings
  imports kanban_capability_routing and kanban_foreign_card, unrouted to the
  e2e_upgrade lane. Add both to _UPDATE_DEPENDENCIES.
- Review nit (t_01a1d0c6ee556b43): _own_row adopted any card under a
  non-primary own key (hostname key of an enrolled host) whatever its
  created_on. Only the primary key is trusted outright now; the hostname and
  pre-host keys need an empty created_on or one of this host's names.
- Tests: a foreign card under the enrolled host's hostname key is not adopted
  (RED before); a pre-host-key card another host created is not adopted
  (regression pin).
---
 hermes_cli/update_pause_deferrals.py          | 15 ++++----
 scripts/ci/classify_changes.py                |  2 ++
 .../hermes_cli/test_update_pause_deferrals.py | 35 +++++++++++++++++++
 3 files changed, 45 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/update_pause_deferrals.py b/hermes_cli/update_pause_deferrals.py
index 653f6f5ecd..48f4158cf5 100644
--- a/hermes_cli/update_pause_deferrals.py
+++ b/hermes_cli/update_pause_deferrals.py
@@ -162,11 +162,12 @@ def main(argv: list[str] | None = None) -> int:
     return 0
 
 
-def _own_row(conn, keys: frozenset, legacy: str, own: frozenset):
-    """This host's newest non-archived alarm under one of its ``keys`` (one per name the host has
-    carried: a host that enrolls in the Board mid-streak keeps its hostname-keyed card), or under the
-    pre-host ``legacy`` key when this host created it (a streak open across the upgrade keeps its
-    owner; another host's never). An empty ``created_on`` is a card this board file created."""
+def _own_row(conn, key: str, keys: frozenset, legacy: str, own: frozenset):
+    """This host's newest non-archived alarm under its primary ``key``, or under another of its
+    ``keys`` (one per name the host has carried: a host that enrolls in the Board mid-streak keeps its
+    hostname-keyed card) or the pre-host ``legacy`` key when this host created it (a streak open
+    across the upgrade keeps its owner; another host's never, nor one whose hostname merely matches
+    this host's). An empty ``created_on`` is a card this board file created."""
     cols = {r[1] for r in conn.execute("PRAGMA table_info(tasks)")}
     on = "created_on" if "created_on" in cols else "NULL"
     wanted = sorted(keys | {legacy})
@@ -175,7 +176,7 @@ def _own_row(conn, keys: frozenset, legacy: str, own: frozenset):
         f"({','.join('?' * len(wanted))}) AND status != 'archived' ORDER BY created_at DESC, rowid DESC",
         wanted,
     ):
-        if row[2] in keys or not row[3] or row[3] in own:
+        if row[2] == key or not row[3] or row[3] in own:
             return row
     return None
 
@@ -194,7 +195,7 @@ def _report(conn, unit: str, count: int, first_at: str, reason: str) -> str:
     # Serialize lookup + create so overlapping unattended updates cannot create two owners.
     with kb.write_txn(conn, allow_nested=True):
         keys = frozenset({key, *(sib.alarm_key(name, root, unit) for name in own)})
-        row = _own_row(conn, keys, sib.legacy_key(root, unit), own)
+        row = _own_row(conn, key, keys, sib.legacy_key(root, unit), own)
         if row and row[1] not in {"done", "failed", "cancelled"}:
             if count % REFRESH_EVERY == 0 and not conn.execute(
                 "SELECT 1 FROM task_comments WHERE task_id = ? AND author = ? AND body = ?",
diff --git a/scripts/ci/classify_changes.py b/scripts/ci/classify_changes.py
index e424e1cf67..ce2050f34b 100644
--- a/scripts/ci/classify_changes.py
+++ b/scripts/ci/classify_changes.py
@@ -409,6 +409,8 @@ _UPDATE_DEPENDENCIES = (
     "agent/deadline.py",  # bounded probes' process-tree timeout cleanup
     "hermes_cli/kanban_db.py",  # update_upstream_conflict files the conflict card
     "hermes_cli/kanban_db_connect.py",
+    "hermes_cli/kanban_capability_routing.py",  # update_pause_siblings names this host's Board gateway
+    "hermes_cli/kanban_foreign_card.py",  # update_pause_siblings reads sibling alarms in the Board replica
     # migrate_all_homes' second-hop provider/profile decisions, run on every update. Its
     # plugin-install branch (plugins_cmd, plugins_cmd_install) runs only for a home whose
     # configured memory provider left core; no update journey's home has one, so those
diff --git a/tests/hermes_cli/test_update_pause_deferrals.py b/tests/hermes_cli/test_update_pause_deferrals.py
index d270dd9f4e..257cf3dc89 100644
--- a/tests/hermes_cli/test_update_pause_deferrals.py
+++ b/tests/hermes_cli/test_update_pause_deferrals.py
@@ -457,3 +457,38 @@ def test_an_open_pre_host_key_card_of_this_host_is_kept(tmp_path, monkeypatch):
         old = kb.create_task(conn, title=sib.TITLE + FLEET, assignee="default", created_by="update-pause",
                              idempotency_key=sib.legacy_key(install_root(), FLEET), body="On `worker-1` ...")
     assert _file(monkeypatch, "worker-1") == old
+
+
+def _foreign_card(key, created_on):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import update_pause_siblings as sib
+    from hermes_cli.kanban_db_connect import connect_closing
+    with connect_closing() as conn:
+        task_id = kb.create_task(conn, title=sib.TITLE + FLEET, assignee="default", created_by="update-pause",
+                                 idempotency_key=key, body=f"On `{created_on}` ...")
+        if "created_on" not in {r[1] for r in conn.execute("PRAGMA table_info(tasks)")}:
+            conn.execute("ALTER TABLE tasks ADD COLUMN created_on TEXT")  # as a synced board has it
+        conn.execute("UPDATE tasks SET created_on = ? WHERE id = ?", (created_on, task_id))
+        conn.commit()
+    return task_id
+
+
+def test_a_pre_host_key_card_another_host_created_is_not_adopted(tmp_path, monkeypatch):
+    """worker-5's open card under the shared pre-host key is worker-5's, not worker-1's."""
+    from hermes_cli import update_pause_siblings as sib
+    from hermes_cli.update_pause_record import install_root
+    _board(tmp_path, monkeypatch)
+    w5 = _foreign_card(sib.legacy_key(install_root(), FLEET), "worker-5")
+    assert _file(monkeypatch, "worker-1") != w5
+
+
+def test_an_enrolled_host_does_not_adopt_a_foreign_card_under_its_hostname_key(tmp_path, monkeypatch):
+    """Enrolled as gateway ``worker-1``, this host still accepts its hostname-keyed card, but only one
+    it created: another machine that shares the hostname (created_on ``worker-5``) keeps its own."""
+    from hermes_cli import kanban_capability_routing as kcr
+    from hermes_cli import update_pause_siblings as sib
+    from hermes_cli.update_pause_record import install_root
+    _board(tmp_path, monkeypatch)
+    foreign = _foreign_card(sib.alarm_key("ip-10-0-0-1", install_root(), FLEET), "worker-5")
+    monkeypatch.setattr(kcr, "_own_gateway", lambda conn: "worker-1")
+    assert _file(monkeypatch, "ip-10-0-0-1") != foreign
