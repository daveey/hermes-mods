From 04bba9a27eef43be3f7a1310e5e87fe7601a411a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 05:01:54 -0800
Subject: [PATCH] refactor(ci): table-drive sync evidence rejection fixtures
 [daveey]

---
 tests/scripts/ci/test_upstream_sync.py | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/tests/scripts/ci/test_upstream_sync.py b/tests/scripts/ci/test_upstream_sync.py
index 5aa83dc2add..8dc9aa616b3 100644
--- a/tests/scripts/ci/test_upstream_sync.py
+++ b/tests/scripts/ci/test_upstream_sync.py
@@ -303,14 +303,14 @@ def test_incomplete_job_evidence_cannot_land(world, fault):
     def corrupt(jobs):
         if fault == "missing":
             jobs.pop()
-        elif fault == "skipped":
-            jobs[-1]["conclusion"] = "skipped"
-        elif fault == "hosted":
-            jobs[-1]["labels"] = ["ubuntu-latest"]
-        elif fault == "unknown-blacksmith":
-            jobs[-1]["labels"] = ["blacksmith-unapproved"]
         else:
-            jobs[-1]["runner_name"] = None
+            updates = {
+                "skipped": {"conclusion": "skipped"},
+                "hosted": {"labels": ["ubuntu-latest"]},
+                "unknown-blacksmith": {"labels": ["blacksmith-unapproved"]},
+                "no-runner": {"runner_name": None},
+            }
+            jobs[-1].update(updates[fault])
     actions.job_override = corrupt
     assert gate(checkout, head, actions) == sync.REFUSED
     assert main_of(root) == before
-- 
2.55.0

