+
+    if (when === 'before load') { await load() }
+    result = readSessionTasksLoadedIdentity()
+  } finally { host.sessions.beginWorkSourceRead = original }
+
+  expect(result!).toMatchObject({ status: 'NOT_READY', reason: 'SDK_CHANGED' })
+})
