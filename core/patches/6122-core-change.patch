+
+  try {
+    Array.prototype.every = (() => true) as unknown as typeof original
+    result = readSessionTasksLoadedIdentity()
+  } finally { Array.prototype.every = original }
+
+  expect(result!).toMatchObject({ status: 'NOT_READY', reason: 'SURFACE_CHANGED' })
+})
