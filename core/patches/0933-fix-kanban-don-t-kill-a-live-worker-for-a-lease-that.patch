From 49dcb95c950d030182be663ee12ac3b01c1f124e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 00:56:54 -0700
Subject: [PATCH] fix(kanban): don't kill a live worker for a lease that lapsed
 while the Mac slept (#192)

* fix(kanban): don't kill a live worker for a lease that lapsed while the Mac slept

Card t_01a18628253a543a. The Mac clamshell-slept 17:59-18:14 PDT 10-28 with live
workers; on dark wakes the dispatcher saw their leases past expiry on its own clock
(lease_lost) and SIGTERMed them, and the Board reclaimed at TTL. Now:

- release_stale_claims asks the Board (reassert_lease) before stopping a live
  heartbeating worker whose lease lapsed: renewed -> keep; Board unreachable and the
  lapse < LEASE_DARK_HOLD_SECONDS (12 h, = Board DARK_HOLD_MAX) -> defer and retry;
  refused / holder moved / offline past the hold -> stop as before.
- _renewal_due retries a lapsed lease every 30 s instead of ttl/3: the throttle runs
  on time.monotonic(), which stops during macOS sleep.

Pairs with daveey/hermes-hub#60 (Board holds a dark holder's lapsed lease).

* refactor(kanban): fold the Board reassert into lease_lost (kanban_db.py stays under its health cap)
---
diff --git a/hermes_cli/kanban_db_sync.py b/hermes_cli/kanban_db_sync.py
index 51602cd8e8a0aa051b68cd151cfa8d4c6be26453..0443b8888e8eec26a40675e1c5ddc8656f801f75 100644
--- a/hermes_cli/kanban_db_sync.py
+++ b/hermes_cli/kanban_db_sync.py
@@ -42,6 +42,12 @@ MODES = ("off", "shadow", "primary")
 # A worker whose lease cannot be renewed is stopped this long before the
 # server-side expiry, so it is gone before another gateway can be granted the card.
 LEASE_SAFETY_MARGIN_SECONDS = 60
+# [daveey] How long past its expiry a lapsed lease can still be ours while the Board cannot be asked. Matches the
+# Board's DARK_HOLD_MAX_MS: the Board keeps the lease of a holder that went silent (a laptop asleep, offline) that
+# long, so a worker frozen by sleep, or woken in a networkless maintenance wake, is not stopped on our clock alone.
+LEASE_DARK_HOLD_SECONDS = 12 * 3600
+# [daveey] Retry spacing for a lease that has already lapsed (see ``_renewal_due``).
+LAPSED_RENEW_RETRY_SECONDS = 30
 
 # Columns that travel to the service. Integer cross-references travel as uids
 # (``REF_COLUMNS``); identity columns (``KEY_COLUMNS``) are the row key, never a field.
@@ -737,10 +743,15 @@ def stage_claim(conn: sqlite3.Connection, task_id: str, gate: Optional[ClaimGate
 
 
 def _renewal_due(task_id: str, lease_expires_ms: int, ttl_s: int) -> bool:
-    """At most one renewal attempt per ``ttl/3``, and only once a third of the lease is used."""
+    """At most one renewal attempt per ``ttl/3``, and only once a third of the lease is used.
+
+    [daveey] A lease already inside the safety margin (lapsed while the process was suspended: the throttle is
+    measured on the monotonic clock, which stops during macOS sleep, while the lease is wall-clock) is retried every
+    ``LAPSED_RENEW_RETRY_SECONDS`` instead, so the first heartbeat after a wake renews it."""
     remaining_s = lease_expires_ms / 1000 - time.time()
     last = _RENEW_ATTEMPTS.get(task_id)
-    if remaining_s > ttl_s * 2 / 3 or (last is not None and time.monotonic() - last < ttl_s / 3):
+    spacing = LAPSED_RENEW_RETRY_SECONDS if remaining_s <= LEASE_SAFETY_MARGIN_SECONDS else ttl_s / 3
+    if remaining_s > ttl_s * 2 / 3 or (last is not None and time.monotonic() - last < spacing):
         return False
     _RENEW_ATTEMPTS[task_id] = time.monotonic()
     return True
@@ -785,16 +796,56 @@ def _renew(conn: sqlite3.Connection, task_id: str, run_uid: Optional[str], ttl_s
     return None
 
 
-def lease_lost(conn: sqlite3.Connection, task_id: str, now: int) -> bool:
+def lease_lost(conn: sqlite3.Connection, task_id: str, now: int, reassert_ttl_s: Optional[int] = None) -> bool:
     """True when this gateway no longer holds the card's lease, or the lease is
-    within the safety margin of expiring (renewal kept failing)."""
+    within the safety margin of expiring (renewal kept failing).
+
+    [daveey] With ``reassert_ttl_s`` (the caller is about to stop a live worker), a lapse on our clock is checked
+    with the Board first (:func:`reassert_lease`): only ``lost`` counts, so a Mac that slept keeps its workers."""
     if board_mode(conn) != "primary":
         return False
     row = conn.execute("SELECT lease_holder, lease_expires FROM tasks WHERE id = ?", (task_id,)).fetchone()
     if row is None or row["lease_expires"] is None:
         return False
     own = _state(conn)["gateway_id"]
-    return row["lease_holder"] != own or now >= row["lease_expires"] // 1000 - LEASE_SAFETY_MARGIN_SECONDS
+    lost = row["lease_holder"] != own or now >= row["lease_expires"] // 1000 - LEASE_SAFETY_MARGIN_SECONDS
+    return lost and (reassert_ttl_s is None or reassert_lease(conn, task_id, now, reassert_ttl_s) == "lost")
+
+
+def reassert_lease(conn: sqlite3.Connection, task_id: str, now: int, ttl_s: int) -> str:
+    """[daveey] Before a live local worker is stopped for :func:`lease_lost`, ask the Board.
+
+    A lease past its expiry on our clock is not proof the Board gave the card away: the machine may have slept
+    through the renewals (its workers frozen with it) and the Board holds a dark holder's lease (DARK_HOLD_MAX_MS).
+    Returns ``held`` (renewed: keep the worker), ``unknown`` (Board unreachable and the lapse is within
+    ``LEASE_DARK_HOLD_SECONDS``: keep it and ask again) or ``lost`` (another holder, a lease the Board already
+    ended, a refused renewal, or offline past the hold: stop it)."""
+    row = conn.execute(
+        "SELECT t.lease_holder, t.lease_expires, r.uid AS run_uid FROM tasks t "
+        "LEFT JOIN task_runs r ON r.id = t.current_run_id WHERE t.id = ?", (task_id,),
+    ).fetchone()
+    if row is None or row["lease_expires"] is None or row["run_uid"] is None:
+        return "lost"
+    if row["lease_holder"] != _state(conn)["gateway_id"]:
+        return "lost"  # the Board's feed moved or ended the lease: a real takeover, not a gap on our side
+    try:
+        lease = _client().renew(board_id=_state(conn)["board_id"], task_uid=task_id, run_uid=row["run_uid"],
+                                gateway_id=_state(conn)["gateway_id"], ttl_s=max(int(ttl_s), 1))
+    except _CLIENT_ERRORS as exc:
+        lapsed_s = now - int(row["lease_expires"]) // 1000
+        _log.info("kanban sync: lease of %s lapsed %ds ago and the Board is unreachable (%s: %s)",
+                  task_id, lapsed_s, type(exc).__name__, exc)
+        return "unknown" if lapsed_s <= LEASE_DARK_HOLD_SECONDS else "lost"
+    from hermes_cli.kanban_db_connect import write_txn
+    with write_txn(conn):
+        if lease.granted:
+            conn.execute("UPDATE tasks SET lease_expires = ?, lease_version = COALESCE(?, lease_version) "
+                         "WHERE id = ?", (lease.expires_ms, lease.version, task_id))
+            _log.info("kanban sync: lease of %s re-asserted after a renewal gap", task_id)
+            return "held"
+        _log.warning("kanban sync: lease for %s lost to %s (%s)", task_id, lease.holder, lease.reason)
+        conn.execute("UPDATE tasks SET lease_holder = ? WHERE id = ?", (lease.holder, task_id))
+    return "lost"
 
 
 def release_lease(conn: sqlite3.Connection, task_id: str, run_uid: Optional[str]) -> None:
diff --git a/tests/hermes_cli/test_kanban_sync_leases.py b/tests/hermes_cli/test_kanban_sync_leases.py
index ec13d5ac6436e99318929475093dc34cb3acad75..c8fd1ad2ca7b95cb1eb1b53d2c3aa428a0b8da7c 100644
--- a/tests/hermes_cli/test_kanban_sync_leases.py
+++ b/tests/hermes_cli/test_kanban_sync_leases.py
@@ -148,25 +148,83 @@ def _attach_worker(conn, tid, proc):
                      (proc.pid, kbd._process_fingerprint(proc.pid), int(time.time()), tid))
 
 
-def test_worker_that_cannot_renew_is_stopped_before_lease_expiry(primary, lease_client):
+def _lapse(conn, tid, seconds_ago: int) -> None:
+    """The lease and the claim ran out ``seconds_ago`` on the wall clock with no renewal: the machine slept (or the
+    backend restarted) while the worker was alive, so nothing renewed in between."""
+    with kbc.write_txn(conn):
+        conn.execute("UPDATE tasks SET lease_expires = ?, claim_expires = ? WHERE id = ?",
+                     (int((time.time() - seconds_ago) * 1000), int(time.time()) - 1, tid))
+
+
+def test_lease_gap_does_not_kill_a_live_worker_when_the_board_still_holds_it(primary, lease_client):
+    """Regression (card t_01a18628253a543a): the Mac slept 17:59-18:14 PDT with live workers; on the first wake the
+    dispatcher saw their leases past expiry on its own clock and SIGTERMed them. The Board holds a dark holder's
+    lease, so the dispatcher must renew it and keep the worker."""
     conn = primary
-    tid = kb.create_task(conn, title="network drops", assignee="worker")
-    lease_client.lease_seconds = 30  # lease already inside the 60s safety margin
+    tid = kb.create_task(conn, title="slept through renewals", assignee="worker")
     kb.claim_task(conn, tid, ttl_seconds=900)
-    lease_ms = conn.execute("SELECT lease_expires FROM tasks WHERE id = ?", (tid,)).fetchone()[0]
-    proc, reaper = _spawn_worker()
+    run_uid = lease_client.calls[0][1]["run_uid"]
+    proc, _reaper = _spawn_worker()
     try:
         _attach_worker(conn, tid, proc)
+        _lapse(conn, tid, 15 * 60)
+        assert kb.release_stale_claims(conn) == 0
+        assert proc.poll() is None, "a live worker was stopped for a lease the Board still held"
+        assert kb.get_task(conn, tid).status == "running"
+        assert lease_client.calls[-1][0] == "renew" and lease_client.calls[-1][1]["run_uid"] == run_uid
+        lease_ms, claim_expires = conn.execute(
+            "SELECT lease_expires, claim_expires FROM tasks WHERE id = ?", (tid,)).fetchone()
+        assert lease_ms / 1000 > time.time() + 800 and claim_expires > time.time()
+        assert _run_rows(conn, tid)[-1][1:] == (None, "running")
+    finally:
+        proc.kill()
+
+
+def test_lease_gap_with_the_board_unreachable_keeps_the_worker(primary, lease_client):
+    """A maintenance wake has no network (agent.log 18:18:47: Errno 51), so the lease cannot be checked: keep the
+    worker and ask again, instead of stopping it on our clock alone."""
+    conn = primary
+    tid = kb.create_task(conn, title="dark wake", assignee="worker")
+    kb.claim_task(conn, tid, ttl_seconds=900)
+    proc, _reaper = _spawn_worker()
+    try:
+        _attach_worker(conn, tid, proc)
+        _lapse(conn, tid, 20 * 60)
         lease_client.renew_mode = "offline"
-        kb.heartbeat_claim(conn, tid, ttl_seconds=900)
-        assert lease_client.count("renew") == 1
-        claim_expires = conn.execute("SELECT claim_expires FROM tasks WHERE id = ?", (tid,)).fetchone()[0]
-        assert claim_expires <= lease_ms // 1000 - sync.LEASE_SAFETY_MARGIN_SECONDS
+        assert kb.release_stale_claims(conn) == 0
+        assert proc.poll() is None
+        assert kb.get_task(conn, tid).status == "running"
+        kinds = [r[0] for r in conn.execute("SELECT kind FROM task_events WHERE task_id = ? ORDER BY id", (tid,))]
+        assert kinds[-1] == "claim_extended" and "reclaimed" not in kinds
+        # Back online: the next sweep renews it.
+        lease_client.renew_mode = "grant"
+        with kbc.write_txn(conn):
+            conn.execute("UPDATE tasks SET claim_expires = ? WHERE id = ?", (int(time.time()) - 1, tid))
+        assert kb.release_stale_claims(conn) == 0
+        assert proc.poll() is None
+        assert conn.execute("SELECT lease_expires FROM tasks WHERE id = ?", (tid,)).fetchone()[0] > time.time() * 1000
+    finally:
+        proc.kill()
+
+
+@pytest.mark.parametrize("case", ["refused", "offline_past_dark_hold"])
+def test_lease_gap_stops_the_worker_once_the_lease_is_really_gone(primary, lease_client, case):
+    """Controls: the Board refuses the renewal (it gave the card away), or it stayed unreachable past the hold."""
+    conn = primary
+    tid = kb.create_task(conn, title="really gone", assignee="worker")
+    kb.claim_task(conn, tid, ttl_seconds=900)
+    proc, reaper = _spawn_worker()
+    try:
+        _attach_worker(conn, tid, proc)
+        if case == "refused":
+            _lapse(conn, tid, 15 * 60)
+            lease_client.renew_mode = "deny"
+        else:
+            _lapse(conn, tid, sync.LEASE_DARK_HOLD_SECONDS + 60)
+            lease_client.renew_mode = "offline"
         assert kb.release_stale_claims(conn) == 1
-        stopped_at_ms = time.time() * 1000
         reaper.join(timeout=30)
-        assert proc.poll() is not None, "worker kept running after its lease was lost"
-        assert stopped_at_ms < lease_ms
+        assert proc.poll() is not None, "worker kept running after its lease was gone"
         assert kb.get_task(conn, tid).status == "ready"
         assert _run_rows(conn, tid)[-1][1:] == ("lease_lost", "lease_lost")
     finally:
@@ -174,6 +232,21 @@ def test_worker_that_cannot_renew_is_stopped_before_lease_expiry(primary, lease_
             proc.kill()
 
 
+def test_first_heartbeat_after_sleep_renews_a_lapsed_lease(primary, lease_client):
+    """The renewal throttle runs on the monotonic clock, which stops during macOS sleep: a renewal attempted just
+    before the lid closed must not block the first renewal after wake, when the lease has already lapsed."""
+    conn = primary
+    tid = kb.create_task(conn, title="wakes up", assignee="worker")
+    lock = "host:1"
+    kb.claim_task(conn, tid, ttl_seconds=900, claimer=lock)
+    sync._RENEW_ATTEMPTS[tid] = time.monotonic() - 60  # last attempt 1 min "ago" (monotonic) = before the sleep
+    with kbc.write_txn(conn):
+        conn.execute("UPDATE tasks SET lease_expires = ? WHERE id = ?", (int((time.time() - 600) * 1000), tid))
+    assert kb.heartbeat_claim(conn, tid, ttl_seconds=900, claimer=lock)
+    assert lease_client.count("renew") == 1
+    assert conn.execute("SELECT claim_expires FROM tasks WHERE id = ?", (tid,)).fetchone()[0] > time.time() + 600
+
+
 def test_live_worker_with_a_valid_lease_keeps_its_claim(primary, lease_client):
     """Control for the test above: same stale claim, lease still valid -> extended."""
     conn = primary
