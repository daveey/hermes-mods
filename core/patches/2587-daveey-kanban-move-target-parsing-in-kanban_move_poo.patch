From fbe7656eda65fd3a02d03a231df867fe4028dfe1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 08:31:36 +0000
Subject: [PATCH] [daveey] kanban: move-target parsing in kanban_move_pool,
 cli_runs_on returns an explicit --runs-on; kanban.py back to the 2000-line
 cap

---
 hermes_cli/kanban.py                  | 20 +++++++-------------
 hermes_cli/kanban_move_pool.py        | 10 ++++++++++
 hermes_cli/kanban_worker_placement.py | 10 ++++++----
 3 files changed, 23 insertions(+), 17 deletions(-)

diff --git a/hermes_cli/kanban.py b/hermes_cli/kanban.py
index e74d6066d2..c3a5a74dc0 100644
--- a/hermes_cli/kanban.py
+++ b/hermes_cli/kanban.py
@@ -523,10 +523,8 @@ def _cmd_create(args: argparse.Namespace) -> int:
                 human_request=getattr(args, "human_request", None),
                 creator_task_id=(os.environ.get("HERMES_KANBAN_TASK")
                                  if in_worker else None),
-                validate_workspace=True, validate_skills=True,
-                # [daveey] No --runs-on: a portable card queues for the worker pool (kanban.placement.worker_queue).
-                runs_on=(getattr(args, "runs_on", None) if getattr(args, "runs_on", None) is not None
-                         else cli_runs_on(conn, args, body, ws_kind, ws_path, board, assignee=assignee)),
+                validate_workspace=True, validate_skills=True,  # [daveey] no --runs-on: queue for the worker pool
+                runs_on=cli_runs_on(conn, args, body, ws_kind, ws_path, board, assignee=assignee),
                 placement_policy=cli_policy(args, body, ws_kind, ws_path, board, assignee=assignee),
                 placement_checked=True, board=board,
                 placement_audit=cli_audit(args, body, ws_kind, ws_path, board, assignee=assignee),
@@ -891,14 +889,11 @@ def _cmd_reclaim(args: argparse.Namespace) -> int:
 def _cmd_move(args: argparse.Namespace) -> int:
     """[daveey] ``hermes kanban move``: the card's own worker (HERMES_KANBAN_TASK + run id) moves its running card;
     otherwise a queued card is relabelled, or with --reclaim a card running here is stopped first."""
-    from hermes_cli import kanban_move as km
-    from hermes_cli.kanban_placement import POOL_LABEL
-    pool = bool(getattr(args, "pool", False))
-    if pool == bool(args.runs_on):
-        print("kanban move: pass exactly one of --pool or --runs-on [invalid_runs_on]", file=sys.stderr)
+    from hermes_cli import kanban_move as km, kanban_move_pool as kmp
+    labels, host, err = kmp.cli_labels(args)
+    if labels is None:
+        print(err, file=sys.stderr)
         return 1
-    labels = [POOL_LABEL] if pool else [x.strip() for x in str(args.runs_on).split(",") if x.strip()]
-    host = {"host_reason": getattr(args, "host_reason", None)}
     own_run = os.environ.get("HERMES_KANBAN_TASK") == args.task_id and os.environ.get("HERMES_KANBAN_RUN_ID")
     with kbc.connect_closing() as conn:
         status = (conn.execute("SELECT status FROM tasks WHERE id = ?", (args.task_id,)).fetchone() or {"status": None})
@@ -913,8 +908,7 @@ def _cmd_move(args: argparse.Namespace) -> int:
                 res = {"ok": False, "reason_code": "running",
                        "error": f"{args.task_id} is running: its worker moves it (kanban_move), or pass --reclaim"}
             else:
-                res = km.move_reclaim(conn, args.task_id, runs_on=labels, reason=args.reason, force=args.force,
-                                      **host)
+                res = km.move_reclaim(conn, args.task_id, runs_on=labels, reason=args.reason, force=args.force, **host)
         else:
             res = km.move_queued(conn, args.task_id, runs_on=labels, reason=args.reason,
                                  checkpoint=args.checkpoint or "", force=args.force, **host)
diff --git a/hermes_cli/kanban_move_pool.py b/hermes_cli/kanban_move_pool.py
index eaf90db6ba..7422575f0c 100644
--- a/hermes_cli/kanban_move_pool.py
+++ b/hermes_cli/kanban_move_pool.py
@@ -31,6 +31,16 @@ def pool_label() -> str:
     return POOL_LABEL
 
 
+def cli_labels(args: Any) -> tuple[Optional[list[str]], dict[str, Any], str]:
+    """``hermes kanban move`` target: (labels, {host_reason}, \"\") from exactly one of ``--pool`` / ``--runs-on``,
+    else (None, {}, error)."""
+    pool, runs_on = bool(getattr(args, "pool", False)), getattr(args, "runs_on", None)
+    if pool == bool(runs_on):
+        return None, {}, "kanban move: pass exactly one of --pool or --runs-on [invalid_runs_on]"
+    labels = [pool_label()] if pool else [x.strip() for x in str(runs_on).split(",") if x.strip()]
+    return labels, {"host_reason": getattr(args, "host_reason", None)}, ""
+
+
 def pool_pins(labels: list[str], machines: Mapping[str, Mapping[str, Any]]) -> list[str]:
     """Machines named by ``machine:<x>`` labels that are pool workers (carry the pool label)."""
     label = pool_label()
diff --git a/hermes_cli/kanban_worker_placement.py b/hermes_cli/kanban_worker_placement.py
index ab466f2051..4ee1c821cb 100644
--- a/hermes_cli/kanban_worker_placement.py
+++ b/hermes_cli/kanban_worker_placement.py
@@ -165,13 +165,15 @@ def cli_policy(args, body, workspace_kind, workspace_path, board, *, assignee):
 
 
 def cli_runs_on(conn, args, body, workspace_kind, workspace_path, board, *, assignee):
-    """``runs_on`` the worker queue gives a CLI-created card (``kanban.placement.worker_queue``), or None.
-
-    Only on a Board primary (``runs_on`` is a Board placement field) and only without an explicit ``--runs-on``."""
+    """``runs_on`` for a CLI-created card: an explicit ``--runs-on`` as given, else what the worker queue
+    (``kanban.placement.worker_queue``) gives it, or None. The queue applies only on a Board primary
+    (``runs_on`` is a Board placement field)."""
     from hermes_cli import kanban_db_sync as sync
     from hermes_cli import kanban_placement as placement
 
-    if getattr(args, "runs_on", None) is not None or sync.board_mode(conn) != "primary":
+    if getattr(args, "runs_on", None) is not None:
+        return args.runs_on
+    if sync.board_mode(conn) != "primary":
         return None
     cfg = placement.config()
     if not cfg.get("worker_queue"):
-- 
2.43.0

