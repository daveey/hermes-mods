From 39594304a239c80bc26e36372b424ea40251602e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 05:32:24 +0000
Subject: [PATCH] [daveey] test(worker-boards): ENOTDIR is not missing;
 removing() keeps an unreadable board's record

Follow-up to #1886 review nits:
- missing() docstring states ENOTDIR (a path component that is a regular
  file) propagates by design; _board_file absorbs it for a slug only.
- paths() raises NotADirectoryError when worker-resources/ or kanban/ is a
  regular file; a stray regular-file slug entry is still no board.
- removing()'s finally keeps the registration when stat of the board fails
  with EACCES after a failed removal (except OSError: removed = False), and
  the body's error, not the PermissionError, propagates.
---
 hermes_cli/worker_board_retirement.py         |  7 ++++++
 .../hermes_cli/test_worker_account_boards.py  | 21 +++++++++++++++++
 .../test_worker_board_retirement.py           | 23 +++++++++++++++++++
 3 files changed, 51 insertions(+)

diff --git a/hermes_cli/worker_board_retirement.py b/hermes_cli/worker_board_retirement.py
index 88d23f1cf1..7f8b04e106 100644
--- a/hermes_cli/worker_board_retirement.py
+++ b/hermes_cli/worker_board_retirement.py
@@ -35,6 +35,13 @@ def missing(path: Path) -> bool:
     OSError, while 3.11-3.13 raise e.g. PermissionError. Inventory and
     retirement decisions must not depend on that: an unreadable path read as
     absent would drop or retire a board silently instead of refusing loudly.
+
+    ENOTDIR is deliberately not absence either (3.11-3.13 ``exists()`` said
+    False): a path component that is a regular file (e.g. ``kanban`` or
+    ``worker-resources`` is a file) is a broken layout, so NotADirectoryError
+    propagates rather than silently dropping every record under it. A caller
+    that wants a non-directory entry to mean "no board" says so itself
+    (``worker_account_boards._board_file`` for a board slug).
     """
     try:
         path.stat()
diff --git a/tests/hermes_cli/test_worker_account_boards.py b/tests/hermes_cli/test_worker_account_boards.py
index 77c8a1ee19..48642f84ae 100644
--- a/tests/hermes_cli/test_worker_account_boards.py
+++ b/tests/hermes_cli/test_worker_account_boards.py
@@ -241,6 +241,27 @@ def test_unreadable_inventory_location_refuses_instead_of_dropping(monkeypatch,
         inventory.paths()
 
 
+@pytest.mark.parametrize('parent', ['worker-resources', 'kanban'])
+def test_regular_file_inventory_parent_refuses_instead_of_dropping(monkeypatch, tmp_path, parent):
+    """ENOTDIR is not absence: a regular file where the inventory directory's
+    parent belongs is a broken layout, so paths() raises NotADirectoryError
+    (3.11-3.13 ``Path.exists()`` returned False and would drop the records)."""
+    monkeypatch.setattr(capacity, 'policy_root', lambda: tmp_path)
+    (tmp_path / 'kanban.db').touch()
+    (tmp_path / parent).write_text('not a directory')
+    with pytest.raises(NotADirectoryError):
+        inventory.paths()
+
+
+def test_regular_file_board_slug_is_no_board(monkeypatch, tmp_path):
+    """Contrast: ``_board_file`` absorbs ENOTDIR for a single slug entry only."""
+    monkeypatch.setattr(capacity, 'policy_root', lambda: tmp_path)
+    boards = tmp_path / 'kanban' / 'boards'
+    boards.mkdir(parents=True)
+    (boards / 'stray').write_text('not a board directory')
+    assert inventory.paths() == []
+
+
 def test_unreadable_registration_record_is_not_rewritten(monkeypatch, tmp_path):
     """register() treats only a missing record as absent; EACCES propagates."""
     monkeypatch.setattr(capacity, 'policy_root', lambda: tmp_path)
diff --git a/tests/hermes_cli/test_worker_board_retirement.py b/tests/hermes_cli/test_worker_board_retirement.py
index 4391c8efc2..a7fd217e2e 100644
--- a/tests/hermes_cli/test_worker_board_retirement.py
+++ b/tests/hermes_cli/test_worker_board_retirement.py
@@ -1,4 +1,6 @@
 """Removal cannot strand account registrations or race final admission."""
+import errno
+import os
 import sqlite3
 from pathlib import Path
 
@@ -120,6 +122,27 @@ def test_post_rename_failure_retires_proven_idle_record(registered, monkeypatch)
     inventory.paths()  # must not poison all account claims
 
 
+def test_unreadable_board_after_failed_removal_keeps_registration(registered, monkeypatch):
+    """removing()'s finally: a stat that fails with anything but ENOENT is not
+    proof of removal (``except OSError: removed = False``), so the record stays
+    and the body's own error, not the PermissionError, propagates."""
+    root, path = registered
+    blocked = os.fspath(path.resolve())
+    real_stat = os.stat
+
+    def denied_stat(target, *args, **kwargs):
+        if isinstance(target, (str, os.PathLike)) and os.fspath(target) == blocked:
+            raise PermissionError(errno.EACCES, 'Permission denied', blocked)
+        return real_stat(target, *args, **kwargs)
+
+    with pytest.raises(RuntimeError, match='fixture removal failed'):
+        with monkeypatch.context() as denied, inventory.removing(path):
+            path.unlink()  # absent underneath: only the EACCES hides it
+            denied.setattr(os, 'stat', denied_stat)
+            raise RuntimeError('fixture removal failed')
+    assert list((root / 'worker-resources' / 'boards').glob('*.json'))
+
+
 def test_enabled_metadata_only_board_can_be_removed(registered):
     root, path = registered
     # An unregistered board with metadata but no DB has no rows to retire.
