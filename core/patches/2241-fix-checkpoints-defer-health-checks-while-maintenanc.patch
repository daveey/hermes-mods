From 7de8e7baae874bd1edb740f909026dde7abaad43 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 06:38:46 +0000
Subject: [PATCH] fix(checkpoints): defer health checks while maintenance holds
 the lock [daveey]

---
 tests/tools/test_checkpoint_health_floor.py | 11 +++++++++++
 tools/checkpoint_maintenance.py             | 21 +++++++++++++--------
 2 files changed, 24 insertions(+), 8 deletions(-)

diff --git a/tests/tools/test_checkpoint_health_floor.py b/tests/tools/test_checkpoint_health_floor.py
index e01b34fab5c..d3322856264 100644
--- a/tests/tools/test_checkpoint_health_floor.py
+++ b/tests/tools/test_checkpoint_health_floor.py
@@ -86,3 +86,14 @@ def test_floor_receipt_invalidated(tmp_path, monkeypatch, fault):
         (store / ".gc-pending").touch()
     monkeypatch.setattr(health, "_run_git", lambda *args: (fault != "git_failure", refs, ""))
     assert health.protected_floor(store, 10) is False
+
+
+def test_busy_store_defers_health_observation(tmp_path, monkeypatch, caplog):
+    from tools.checkpoint_pruning import store_lock
+    base, _ = _over_cap_store(tmp_path, monkeypatch, 1)
+    caplog.set_level(logging.ERROR)
+    with store_lock(base):
+        assert maintenance.check_store_health(base, 0.5) is False
+    assert not (base / ".last_health_check").exists()
+    assert not caplog.records
+    assert maintenance.check_store_health(base, 0.5) is True
diff --git a/tools/checkpoint_maintenance.py b/tools/checkpoint_maintenance.py
index 0145e482b59..7bf17b6d50c 100644
--- a/tools/checkpoint_maintenance.py
+++ b/tools/checkpoint_maintenance.py
@@ -478,6 +478,16 @@ _HEALTH_PRUNE_STALE_S = 48 * 3600
 
 
 def check_store_health(base: Path, cap_mb: float) -> bool:
+    """Skip a busy store: maintenance in progress is not evidence of failed maintenance."""
+    from tools.checkpoint_pruning import PruneError, store_lock
+    try:
+        with store_lock(base):
+            return _check_store_health(base, cap_mb)
+    except (PruneError, OSError):
+        return False
+
+
+def _check_store_health(base: Path, cap_mb: float) -> bool:
     """Daily ERROR for over-cap stores: twice the cap OR no successful prune in 48 h.
     A verified compacted floor is an INFO exception, never permission to delete final snapshots.
     The daily marker bounds observation cost. Returns whether it reported an error."""
@@ -510,14 +520,9 @@ def check_store_health(base: Path, cap_mb: float) -> bool:
     stale = last is None or now - last >= _HEALTH_PRUNE_STALE_S
     if size <= 2 * cap_bytes and not stale:
         return False
-    from tools.checkpoint_pruning import PruneError, store_lock
-    try:
-        with store_lock(base):
-            if protected_floor(store, _dir_size_bytes(store)):
-                logger.info("Checkpoint store above cap: protected floor; final snapshots retained (%s)", store)
-                return False
-    except (PruneError, OSError):
-        pass  # An unverified floor is not an exemption.
+    if protected_floor(store, size):
+        logger.info("Checkpoint store above cap: protected floor; final snapshots retained (%s)", store)
+        return False
     when = "never" if last is None else f"{(now - last) / 3600:.0f} h ago"
     logger.error("checkpoint store over cap: %.2f GB / %g MB, last prune %s (%s); "
                  "set checkpoints.auto_prune: true or run `hermes checkpoints prune`",
-- 
2.55.0

