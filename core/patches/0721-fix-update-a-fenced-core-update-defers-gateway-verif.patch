From fc7b1ac399cda5d9ea62e0d78c73535c91dae05b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 04:04:53 -0700
Subject: [PATCH] fix(update): a fenced core update defers gateway verification
 to the fence owner instead of owing a false restart [daveey]

hermes-sync runs `hermes update --yes` inside its core-update fence: <home>/core-update/intent
holds its pid and every hermes-gateway-launcher parks until it is released, which happens only
after the update exits. The post-update fleet probe waited its 120 s settle window, saw no rows
and recorded a gateway_restart follow-up on every fenced update (David-MBP: 5 consecutive runs,
gateway back 7 s after each update exited).

When an intent is held by a live ancestor of this process, probe once without the settle window;
an empty fleet is then 'held by the fence', not failed. The fleet obligation stays armed and is not
used for migration, so a gateway that never returns still warns at the next CLI start. Stale or
down rows the probe can see, a missing fence, and a non-ancestor intent keep the fail-closed path.
---
 hermes_cli/update_cmd_fleet_verify.py         |  30 +++-
 hermes_cli/update_gateway_fence.py            |  93 ++++++++++++
 .../test_update_fleet_core_update_fence.py    | 136 ++++++++++++++++++
 3 files changed, 257 insertions(+), 2 deletions(-)
 create mode 100644 hermes_cli/update_gateway_fence.py
 create mode 100644 tests/hermes_cli/test_update_fleet_core_update_fence.py

diff --git a/hermes_cli/update_cmd_fleet_verify.py b/hermes_cli/update_cmd_fleet_verify.py
index 4ee3b2185d..67f51cfee3 100644
--- a/hermes_cli/update_cmd_fleet_verify.py
+++ b/hermes_cli/update_cmd_fleet_verify.py
@@ -230,6 +230,14 @@ def _verify_fleet_after_update(restart, *, _pre_update_plan, _windows_gateway_re
     # instead of assuming the restart phase worked.
     # Phase 1 (#91277): post-update fleet version verification.
     _fleet_snapshot: list = []
+    # [daveey] Inside hermes-sync's core-update fence the launchers park until this process exits,
+    # so no successor can publish a row yet: probe once (no settle window) and leave verification
+    # to the fence owner instead of owing a restart that is already scheduled (update_gateway_fence).
+    _fence_owner = None
+    with _best_effort('Core-update fence check failed: %s'):
+        from hermes_cli.update_gateway_fence import ancestor_fence_owner
+        _fence_owner = ancestor_fence_owner()
+    _fence_deferred = False
     with _best_effort('Fleet version verification failed: %s'):
         from hermes_cli.update_receipt import print_fleet_version_matrix
         # Cross-platform "rows expected" signal: (restarted_services or killed_pids)
@@ -243,13 +251,25 @@ def _verify_fleet_after_update(restart, *, _pre_update_plan, _windows_gateway_re
         _fleet_rows_expected = _m()._fleet_probe_expected_runtimes(
             _pre_update_plan, _pre_restart, _windows_gateway_resume, restart.restarted_services, _killed,
         )
-        _fleet_snapshot = _collect_fleet_snapshot(restart, _fleet_rows_expected)
+        _fleet_snapshot = _collect_fleet_snapshot(restart, _fleet_rows_expected and _fence_owner is None)
         if print_fleet_version_matrix(_fleet_snapshot):
             restart.incomplete = True
             # A proven-stale survivor must not keep running (its ticker yields every tick and
             # nothing else restarts it, #117275): hand it to the drain-first restart path.
             from hermes_cli.update_cmd_stale_survivors import signal_stale_fleet_survivors
             signal_stale_fleet_survivors(_fleet_snapshot, restart, fleet._gateway_drain_budget())
+        elif not _fleet_snapshot and _fleet_rows_expected and _fence_owner is not None:
+            # Not verified, not failed: the gateways start when the fence owner releases its intent
+            # (after this process exits). The fleet obligation stays armed below, so a gateway that
+            # never comes back still warns at the next CLI start and is retried by the next update.
+            _fence_deferred = True
+            print(
+                f"\n  ↻ Gateway restart held by the core-update fence (pid {_fence_owner}): launcher-supervised"
+                " gateways start when it releases, after this update exits; the fence owner verifies them."
+            )
+            with suppress(Exception):
+                from hermes_cli.update_receipt import record_skip
+                record_skip("gateway_verification", f"held by the core-update fence of pid {_fence_owner}")
         elif not _fleet_snapshot and _fleet_rows_expected:
             # collect_fleet_versions() swallows every failure, so zero rows with
             # expected runtimes is indistinguishable from health — keep the restart owed.
@@ -313,7 +333,7 @@ def _verify_fleet_after_update(restart, *, _pre_update_plan, _windows_gateway_re
                 if _active is not None:
                     _active.data["runtime_outcomes"] = _runtime_outcomes
 
-    if not restart.incomplete:
+    if not restart.incomplete and not _fence_deferred:
         with _best_effort('Owed-gateway check failed: %s'):
             if _named_gateways_still_owed():
                 # A gateway a previous run could not restart is still not serving HEAD (nothing
@@ -348,6 +368,12 @@ def _verify_fleet_after_update(restart, *, _pre_update_plan, _windows_gateway_re
 
     if restart.incomplete:
         return
+    if _fence_deferred:
+        # Unverified, so the armed obligation is neither cleared nor used to migrate the topology:
+        # the next CLI start discharges it once the fence's successors serve this checkout.
+        with _best_effort('Fleet restart inventory not recorded: %s'):
+            _record_owed_gateway_inventory(_pre_update_plan)
+        return
     fleet._clear_fleet_restart_pending_marker()
     if not update_complete:
         # Fleet caught up, but the selected runtime's SQLite is unsafe or the tail is still owed
diff --git a/hermes_cli/update_gateway_fence.py b/hermes_cli/update_gateway_fence.py
new file mode 100644
index 0000000000..3109daeb07
--- /dev/null
+++ b/hermes_cli/update_gateway_fence.py
@@ -0,0 +1,93 @@
+"""[daveey] Is this update running inside a core-update launcher fence?
+
+hermes-sync applies a core update as ``hermes update --yes`` INSIDE a fence (state repo
+``hermes-sync`` ``fenced_core_update``, docs/core-update-safety.md): it writes
+``<gateway home>/core-update/intent`` with its own pid and holds LOCK_EX on ``exec.lock``. Every
+``hermes-gateway-launcher`` parks while that intent exists, so NO launcher-supervised gateway can
+start until the fence owner releases it — which happens only after this update process exits.
+
+The post-update fleet probe therefore cannot see a successor from inside the fence: it polled the
+full 120 s settle window, found no rows and recorded a false ``gateway_restart`` follow-up on every
+fenced update (David-MBP, 5 consecutive updates on 2026-10-27/28). Verifying the restart is the
+fence owner's job once it releases the fence; this update keeps the fleet obligation armed so a
+gateway that never comes back still warns at the next CLI start.
+
+Only an intent written by a live ANCESTOR of this process counts: that is the one fence that is
+provably held for this update's whole lifetime. An intent from an unrelated (or dead) process is
+not evidence of anything here, and the normal fail-closed verification applies.
+"""
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+from contextlib import suppress
+from pathlib import Path
+from typing import Iterable, Optional
+
+
+def _ancestor_pids() -> set[int]:
+    """Pids of every ancestor of this process (not including itself). Empty when unreadable."""
+    with suppress(Exception):
+        import psutil
+
+        return {proc.pid for proc in psutil.Process(os.getpid()).parents()}
+    pids: set[int] = set()
+    pid = os.getppid()
+    for _ in range(64):
+        if pid <= 1 or pid in pids:
+            break
+        pids.add(pid)
+        try:
+            out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True,
+                                 timeout=5, check=False).stdout.strip()
+            pid = int(out)
+        except (OSError, ValueError, subprocess.SubprocessError):
+            break
+    return pids
+
+
+def _intent_pid(home: Path) -> Optional[int]:
+    try:
+        data = json.loads((Path(home) / "core-update" / "intent").read_text(encoding="utf-8"))
+        pid = int(data["pid"])
+    except (OSError, ValueError, KeyError, TypeError):
+        return None
+    return pid if pid > 1 else None
+
+
+def _gateway_homes() -> list[Path]:
+    homes: list[Path] = []
+    with suppress(Exception):
+        from hermes_constants import get_default_hermes_root
+
+        homes.append(Path(get_default_hermes_root()))
+    with suppress(Exception):
+        from hermes_cli.update_receipt import _profile_homes
+
+        homes.extend(home for _profile, home in _profile_homes())
+    seen: set[str] = set()
+    unique: list[Path] = []
+    for home in homes:
+        key = os.path.realpath(home)
+        if key not in seen:
+            seen.add(key)
+            unique.append(home)
+    return unique
+
+
+def ancestor_fence_owner(homes: Optional[Iterable[Path]] = None) -> Optional[int]:
+    """Pid of a live ancestor of this process holding a core-update intent on a gateway home, else None.
+
+    Never raises: any unreadable state answers None, which keeps the normal fail-closed verification.
+    """
+    try:
+        candidates = list(homes) if homes is not None else _gateway_homes()
+        pids = {pid for pid in (_intent_pid(home) for home in candidates) if pid is not None}
+        if not pids:
+            return None
+        ancestors = _ancestor_pids()
+        owners = sorted(pids & ancestors)
+        return owners[0] if owners else None
+    except Exception:  # health: allow BLE001 -- detection only; unknown keeps fail-closed verification
+        return None
diff --git a/tests/hermes_cli/test_update_fleet_core_update_fence.py b/tests/hermes_cli/test_update_fleet_core_update_fence.py
new file mode 100644
index 0000000000..140e3bd268
--- /dev/null
+++ b/tests/hermes_cli/test_update_fleet_core_update_fence.py
@@ -0,0 +1,136 @@
+"""[daveey] A fenced core update must not report a false ``gateway_restart`` follow-up.
+
+hermes-sync runs ``hermes update --yes`` inside its core-update fence: ``<home>/core-update/intent``
+holds the fence owner's pid and every ``hermes-gateway-launcher`` parks while it exists. The
+launcher-supervised successor therefore starts only AFTER the update exits (David-MBP 2026-10-28:
+update exit 00:55:50, gateway up 00:55:57). The post-update probe polled the full settle window,
+found no rows and printed "Fleet version check returned no rows" plus an owed ``gateway_restart``
+on every fenced update. Controls: no fence, and a fence held by a process that is not this
+update's ancestor, keep the fail-closed warning.
+"""
+from __future__ import annotations
+
+import json
+import os
+import types
+
+import pytest
+
+from hermes_cli.update_inventory import RuntimeRecord
+
+
+def _plan():
+    return types.SimpleNamespace(runtimes=[RuntimeRecord(kind="gateway", profile="default")])
+
+
+def _write_intent(home, pid):
+    (home / "core-update").mkdir(parents=True, exist_ok=True)
+    (home / "core-update" / "intent").write_text(json.dumps({"pid": pid, "created_at": 0}) + "\n")
+
+
+@pytest.fixture
+def harness(monkeypatch, tmp_path):
+    from hermes_cli import main, update_cmd, update_cmd_fleet as fleet, update_cmd_fleet_verify as fleet_verify
+    from hermes_cli import update_gateway_fence, update_receipt
+
+    monkeypatch.setattr(main, "PROJECT_ROOT", tmp_path)
+    monkeypatch.setattr(fleet_verify, "_print_legacy_units_warning", lambda: None)
+    monkeypatch.setattr("hermes_cli.update_cmd_maint._refresh_dashboard_after_update", lambda **kw: None)
+    monkeypatch.setattr(update_cmd, "_surviving_pre_update_serve_runtimes", lambda plan: [])
+    monkeypatch.setattr("hermes_cli.update_inventory.report_unaccounted_runtimes", lambda rows: False)
+    migrated = []
+    monkeypatch.setattr("hermes_cli.gateway_migrate.maybe_auto_migrate_after_update", lambda: migrated.append(1))
+    cleared = []
+    monkeypatch.setattr(fleet, "_clear_fleet_restart_pending_marker", lambda: cleared.append(True))
+    monkeypatch.setattr(fleet_verify, "_record_owed_gateway_inventory", lambda plan, stopped=(): None)
+
+    # Simulated clock. The launcher-supervised successor cannot appear while this process runs
+    # (the launcher parks on the fence owner's intent), so every probe made here sees no row; the
+    # post-release "successor appears after N seconds" half is hermes-sync's (tests/test_core_fence_verify.py).
+    clock = {"now": 0.0}
+
+    def sleep(seconds):
+        clock["now"] += seconds
+
+    def collect(**kwargs):
+        return []
+
+    monkeypatch.setattr(fleet_verify, "_time", types.SimpleNamespace(monotonic=lambda: clock["now"], sleep=sleep))
+    monkeypatch.setattr(update_receipt, "collect_fleet_versions", collect)
+
+    home = tmp_path / "hermes-home"
+    home.mkdir()
+    monkeypatch.setattr(update_gateway_fence, "_gateway_homes", lambda: [home])
+
+    def run():
+        restart = fleet._GatewayRestartOutcome(
+            incomplete=False, phase_errors=[], pre_restart_gateway_pids=[], restarted_services=[],
+            failed_or_stale_units=[], relaunched_profiles=[], externally_supervised_profiles=[], killed_pids=set(),
+        )
+        update_receipt.begin_update_receipt()
+        fleet_verify._verify_fleet_after_update(restart, _pre_update_plan=_plan(),
+                                                _windows_gateway_resume=None, update_complete=True)
+        receipt = json.loads((update_cmd.get_hermes_home() / "logs/update_receipts/latest.json").read_text())
+        return restart, receipt
+
+    return types.SimpleNamespace(home=home, run=run, clock=clock, cleared=cleared, migrated=migrated,
+                                 fence=update_gateway_fence)
+
+
+def test_fenced_update_defers_verification_instead_of_owing_a_restart(harness, monkeypatch, capsys):
+    # The fence owner is this update's ancestor (hermes-sync -> hermes update).
+    _write_intent(harness.home, os.getppid())
+    restart, receipt = harness.run()
+    out = capsys.readouterr().out
+    assert "returned no rows" not in out
+    assert "did not finish" not in out
+    assert "held by the core-update fence" in out
+    assert restart.incomplete is False
+    assert [f["step"] for f in receipt.get("followups", [])] == []
+    # Unverified: the armed obligation is kept (not cleared) and the topology is not migrated.
+    assert harness.cleared == []
+    assert harness.migrated == []
+    # No 120 s settle wait inside the fence: one probe, no simulated time spent.
+    assert harness.clock["now"] == 0.0
+
+
+def test_without_a_fence_an_absent_successor_still_owes_the_restart(harness, capsys):
+    restart, receipt = harness.run()
+    out = capsys.readouterr().out
+    assert "returned no rows" in out
+    assert restart.incomplete is True
+    assert [f["step"] for f in receipt["followups"]] == ["gateway_restart"]
+    assert harness.cleared == []
+
+
+def test_an_intent_from_a_non_ancestor_is_not_a_fence(harness, capsys):
+    # A live process that is not this update's ancestor (pid 1 is never accepted; use our own pid,
+    # which is not in our ancestor set) proves nothing about this update's gateways.
+    _write_intent(harness.home, os.getpid())
+    restart, receipt = harness.run()
+    assert "returned no rows" in capsys.readouterr().out
+    assert restart.incomplete is True
+    assert [f["step"] for f in receipt["followups"]] == ["gateway_restart"]
+
+
+def test_fence_still_flags_a_stale_gateway_it_can_see(harness, monkeypatch, capsys):
+    # The fence only explains ABSENT rows; a visible stale gateway still owes its restart.
+    from hermes_cli import update_receipt
+    _write_intent(harness.home, os.getppid())
+    monkeypatch.setattr(update_receipt, "collect_fleet_versions", lambda **kw: [
+        {"profile": "default", "pid": 777, "state": "stale", "code_sha": "b" * 40}])
+    monkeypatch.setattr("hermes_cli.update_cmd_stale_survivors.signal_stale_fleet_survivors", lambda *a, **k: None)
+    restart, receipt = harness.run()
+    assert restart.incomplete is True
+    assert [f["step"] for f in receipt["followups"]] == ["gateway_restart"]
+
+
+def test_ancestor_fence_owner_reads_only_live_ancestor_intents(tmp_path):
+    from hermes_cli.update_gateway_fence import ancestor_fence_owner
+    home = tmp_path / "h"
+    home.mkdir()
+    assert ancestor_fence_owner([home]) is None
+    _write_intent(home, os.getppid())
+    assert ancestor_fence_owner([home]) == os.getppid()
+    (home / "core-update" / "intent").write_text("not json")
+    assert ancestor_fence_owner([home]) is None
