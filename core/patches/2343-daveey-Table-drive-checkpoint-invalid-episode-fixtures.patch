From 93bf119d43a516ea0274fc5a08b33d12643fca93 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 20:12:45 +0000
Subject: [PATCH] [daveey] Table-drive checkpoint invalid-episode fixtures

---
 tests/gateway/test_update_checkpoint.py | 11 +++--------
 1 file changed, 3 insertions(+), 8 deletions(-)

diff --git a/tests/gateway/test_update_checkpoint.py b/tests/gateway/test_update_checkpoint.py
index 698e10a902c..b8a375d883a 100644
--- a/tests/gateway/test_update_checkpoint.py
+++ b/tests/gateway/test_update_checkpoint.py
@@ -56,14 +56,9 @@ def test_invalid_episode_never_starts_restart(checkpoint, change):
     module, home, runner, intent = checkpoint
     if change == "no-hold":
         admission_fence.clear_hold(home)
-    elif change == "expired":
-        intent["expires_at"] = time.time() - 1
-    elif change == "dead-owner":
-        intent["pid"] = -1
-    elif change == "wrong-kind":
-        intent["kind"] = "fenced"
-    elif change == "no-checkpoint":
-        intent["checkpoint"] = False
+    changes = {"expired": {"expires_at": time.time() - 1}, "dead-owner": {"pid": -1},
+               "wrong-kind": {"kind": "fenced"}, "no-checkpoint": {"checkpoint": False}}
+    intent.update(changes.get(change, {}))
     (home / "core-update/intent").write_text(json.dumps(intent))
     result = invoke(module, runner, nonce="wrong" if change == "nonce" else "episode-one")
     assert not result["pausing"]
-- 
