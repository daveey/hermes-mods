diff --git a/scripts/ci/nix_cache_budget.py b/scripts/ci/nix_cache_budget.py
new file mode 100644
index 0000000000..270d886371
--- /dev/null
+++ b/scripts/ci/nix_cache_budget.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""Enforce the existing 5 GiB store budget without expanding repository quota."""
+
+import json
+import os
+from pathlib import Path
+import sys
+
+
+def main():
+    info = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8-sig"))
+    # Nix 2.19 uses a list; current Nix keys records by store path.
+    records = info.values() if isinstance(info, dict) else info
+    size = sum(item["closureSize"] for item in records)
+    report = f"Stable rooted closure: {size} bytes (limit: 5368709120 bytes)\n"
+    print(report)
+    with Path(os.environ["GITHUB_STEP_SUMMARY"]).open("a", encoding="utf-8") as summary:
+        summary.write(report)
+    if size > 5368709120:
+        print("::error::Stable Nix roots exceed the 5 GiB store-cache budget")
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/ci/nix_cache_summary.py b/scripts/ci/nix_cache_summary.py
new file mode 100644
index 0000000000..6802371f57
--- /dev/null
+++ b/scripts/ci/nix_cache_summary.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""Report cache effectiveness from tee'd Nix output, even on build failure."""
+
+import os
+from pathlib import Path
+import re
+import sys
+
+
+def main():
+    lines = []
+    for name in sys.argv[1:]:
+        path = Path(name)
+        if path.exists():
+            lines.extend(path.read_text(encoding="utf-8-sig", errors="replace").splitlines())
+    copies = sum(bool(re.match(r"^copying path '/nix/store/[^']+' from '", line)) for line in lines)
+    fetches = sum(bool(re.match(r"^[^\s>]+> trying https://", line)) for line in lines)
+    report = f"Paths copied from substituters: {copies}\n\nHTTPS source fetches: {fetches}\n"
+    print(report)
+    with Path(os.environ["GITHUB_STEP_SUMMARY"]).open("a", encoding="utf-8") as summary:
+        summary.write("## Nix cache effectiveness\n\n" + report)
+    if (os.environ.get("GITHUB_EVENT_NAME") == "push"
+            and os.environ.get("GITHUB_REF") == "refs/heads/main"
+            and os.environ.get("NIX_CACHE_HIT") == "true" and copies > 10):
+        print(f"::warning::Nix primary-key hit still copied {copies} paths (budget: 10)")
+
+
+if __name__ == "__main__":
+    main()
