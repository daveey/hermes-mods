---
diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index 2f699cb6f0685515df54bc92c152e3e14a2563ce..3748cafd1eee1aa13a61ead50481c4623fa30458 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -818,10 +818,7 @@
 
 def pull(conn: sqlite3.Connection, hub: Hub, board: str, *, observers: bool,
          partition: Optional[str] = None, max_pages: Optional[int] = PULL_PAGE_BUDGET) -> Pulled:
-    """Apply the feed pages after this file's cursor, at most ``max_pages`` (None: to the head). Returns the number
-    of changes read; its ``more`` is true when the budget ran out before the head. On a board with an outbox
-    (primary), fields with an unanswered local edit are not overwritten; ``partition`` (a gateway name) keeps only
-    that gateway's cards. [daveey]"""
+    """Bound feed pages (None: to head), preserving local pending fields and optional gateway partition. [daveey]"""
     from hermes_cli.kanban_sync_stop import checkpoint
     total = pages = 0
     from hermes_cli.kanban_sync_apply_budget import apply_page, service_pushes
diff --git a/tests/hermes_cli/test_kanban_sync_shutdown.py b/tests/hermes_cli/test_kanban_sync_shutdown.py
index 9234a36598fa805641bc1e26aef23e19144e14f5..d5ac049de2b6dbae14793bc7a52ab81b8bc90d2b 100644
--- a/tests/hermes_cli/test_kanban_sync_shutdown.py
+++ b/tests/hermes_cli/test_kanban_sync_shutdown.py
@@ -1,5 +1,6 @@
 """A cancelled gateway watcher must not leave bootstrap in asyncio's executor."""
 import asyncio
+import sqlite3
 import threading
 import time
 from types import SimpleNamespace
@@ -33,13 +34,18 @@
     monkeypatch.setattr(client.sync, "apply_remote_changes", lambda *a, **k: applied.append(k["new_cursor"]))
     monkeypatch.setattr(client, "pending_task_fields", lambda conn: {})
     monkeypatch.setattr(client, "IMPORT_ORDER", ["tasks"])
-    conn = SimpleNamespace(execute=lambda *a: None)
 
     def round_loop(keep_running, interval, runstate):
-        if snapshot:
-            client.resync(conn, Hub(), "default", observers=False)
-        else:
-            client.pull(conn, Hub(), "default", observers=False)
+        # Native pull checks durable replay before fetching. Keep that real read,
+        # with SQLite owned and closed by the executor thread using it.
+        conn = sqlite3.connect(":memory:")
+        try:
+            if snapshot:
+                client.resync(conn, Hub(), "default", observers=False)
+            else:
+                client.pull(conn, Hub(), "default", observers=False)
+        finally:
+            conn.close()
 
     monkeypatch.setattr(client, "_run_forever", round_loop)
 
