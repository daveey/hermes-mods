From 9f4f557b8eb3fc7b6fbe1340878a58d002802d62 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 01:17:38 +0000
Subject: [PATCH] fix(proof-home): match --ssh-session-token-file=F; pin
 provenance keys both sides [daveey]

Follow-up to PR #1776 review nits (t_01a1d26926c35872):

- is_desktop_ssh_backend_argv also matches argparse's equals form
  (--ssh-session-token-file=PATH). An agent-stamped `serve` with that
  form on a production home previously reached config import (rc 87);
  it now exits 2 like the space form. process_identity's Desktop-owned
  check shares the helper and agrees.
- leaked-worker-env.ts: the comment claimed the Python test reads the
  TS (it no longer does). Both sides now pin the literal names
  (HERMES_AGENT_TOOL_CALL, HERMES_AGENT_ORIGIN, HERMES_AGENT_HOME):
  the vitest pins AGENT_PROVENANCE_KEYS, test_serve_proof_home.py pins
  proof_home.PROVENANCE_KEYS, so drift on either side fails a test.

Task: t_01a1d26d3179e61a
---
 apps/desktop/electron/leaked-worker-env.test.ts |  7 ++++++-
 apps/desktop/electron/leaked-worker-env.ts      |  5 +++--
 hermes_cli/_startup_fast.py                     |  4 +++-
 tests/hermes_cli/test_process_identity.py       | 11 +++++++++++
 tests/hermes_cli/test_serve_proof_home.py       |  7 +++++--
 5 files changed, 28 insertions(+), 6 deletions(-)

diff --git a/apps/desktop/electron/leaked-worker-env.test.ts b/apps/desktop/electron/leaked-worker-env.test.ts
index e8bdcd99ee..a40122a7b2 100644
--- a/apps/desktop/electron/leaked-worker-env.test.ts
+++ b/apps/desktop/electron/leaked-worker-env.test.ts
@@ -1,8 +1,13 @@
 import { describe, expect, it } from 'vitest'
 
-import { dropAgentProvenance, scrubLeakedWorkerEnv } from './leaked-worker-env'
+import { AGENT_PROVENANCE_KEYS, dropAgentProvenance, scrubLeakedWorkerEnv } from './leaked-worker-env'
 
 describe('dropAgentProvenance', () => {
+  it('pins the stamp names hermes_cli/proof_home.py PROVENANCE_KEYS stamps', () => {
+    // tests/hermes_cli/test_serve_proof_home.py pins the Python side to this same literal list.
+    expect([...AGENT_PROVENANCE_KEYS]).toEqual(['HERMES_AGENT_TOOL_CALL', 'HERMES_AGENT_ORIGIN', 'HERMES_AGENT_HOME'])
+  })
+
   it('drops tool-child stamps even without a worker marker', () => {
     const env: NodeJS.ProcessEnv = {
       HERMES_AGENT_HOME: '/Users/x/.hermes',
diff --git a/apps/desktop/electron/leaked-worker-env.ts b/apps/desktop/electron/leaked-worker-env.ts
index 1be3dd8310..e799049d6c 100644
--- a/apps/desktop/electron/leaked-worker-env.ts
+++ b/apps/desktop/electron/leaked-worker-env.ts
@@ -62,8 +62,9 @@ export function scrubLeakedWorkerEnv(env: NodeJS.ProcessEnv = process.env): stri
   return removed
 }
 
-// Agent tool-child provenance stamps (hermes_cli/proof_home.py PROVENANCE_KEYS;
-// tests/hermes_cli/test_serve_proof_home.py fails on drift). A Desktop an agent opened is still the
+// Agent tool-child provenance stamps (mirrors hermes_cli/proof_home.py PROVENANCE_KEYS; no test reads
+// the other side's source, so leaked-worker-env.test.ts and tests/hermes_cli/test_serve_proof_home.py
+// each pin these exact literal names and drift on either side fails). A Desktop an agent opened is still the
 // person's app: its own HERMES_DESKTOP=1 backend must not read as an agent-launched restart proof,
 // which the proof-home guard refuses on the production home (gateway-9aaf151a15). Dropped always,
 // not only with a worker marker: a plain chat's terminal tool carries no worker marker.
diff --git a/hermes_cli/_startup_fast.py b/hermes_cli/_startup_fast.py
index fe780f6190..0cb01e7f9d 100644
--- a/hermes_cli/_startup_fast.py
+++ b/hermes_cli/_startup_fast.py
@@ -111,7 +111,9 @@ def is_desktop_ssh_backend_argv(argv: list[str]) -> bool:
     ``HERMES_DASHBOARD_SESSION_TOKEN`` env var the local pool spawn uses. Every reader of
     "is this process Desktop's backend" needs both shapes; this is the argv half.
     """
-    return "--ssh-session-token-file" in argv
+    # argparse also accepts the equals form (``--ssh-session-token-file=F``): the same shape.
+    flag = "--ssh-session-token-file"
+    return any(arg == flag or arg.startswith(flag + "=") for arg in argv)
 
 
 def is_container_startup_environment() -> bool:
diff --git a/tests/hermes_cli/test_process_identity.py b/tests/hermes_cli/test_process_identity.py
index 13970c5d99..14652dabd7 100644
--- a/tests/hermes_cli/test_process_identity.py
+++ b/tests/hermes_cli/test_process_identity.py
@@ -363,6 +363,17 @@ def test_desktop_ssh_backend_spawn_shape_is_desktop_owned(monkeypatch):
     assert pi.is_desktop_owned_backend(["serve", "--host", "127.0.0.1", "--port", "0"]) is False
 
 
+def test_desktop_ssh_backend_token_file_equals_form_is_desktop_owned(monkeypatch):
+    """argparse accepts ``--ssh-session-token-file=F`` as the same flag, so it is the same shape."""
+    monkeypatch.setenv("HERMES_DESKTOP", "1")
+    monkeypatch.delenv("HERMES_DASHBOARD_SESSION_TOKEN", raising=False)
+
+    assert pi.is_desktop_owned_backend(
+        ["serve", "--isolated", "--ssh-session-token-file=/home/u/.hermes/desktop-ssh/abc.token"]) is True
+    # A different flag that merely shares the prefix is not the token-file flag.
+    assert pi.is_desktop_owned_backend(["serve", "--ssh-session-token-file-x=/f"]) is False
+
+
 # ---------------------------------------------------------------------------
 # Host-reclaim rung: reap_orphaned_backend_owner (#121964)
 # ---------------------------------------------------------------------------
diff --git a/tests/hermes_cli/test_serve_proof_home.py b/tests/hermes_cli/test_serve_proof_home.py
index e00a3cc0de..9590682b11 100644
