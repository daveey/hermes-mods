From 53d5c7369bed119f31eb43b71b0e4c9aa7053981 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 24 Oct 2026 05:19:24 +0000
Subject: [PATCH] fix(kanban): partition bulk writes by owner profile and board
 [daveey]

---
 .../src/plugins/kanban/api.gateways.test.ts   | 17 +++++++++++++++++
 apps/desktop/src/plugins/kanban/api.ts        | 19 ++++++++++---------
 2 files changed, 27 insertions(+), 9 deletions(-)

diff --git a/apps/desktop/src/plugins/kanban/api.gateways.test.ts b/apps/desktop/src/plugins/kanban/api.gateways.test.ts
index 1559320cb8..4a661fb54c 100644
--- a/apps/desktop/src/plugins/kanban/api.gateways.test.ts
+++ b/apps/desktop/src/plugins/kanban/api.gateways.test.ts
@@ -205,6 +205,23 @@ describe('gateway routing', () => {
     ])
   })
 
+  it('partitions bulk writes by owner board and profile even on the active gateway', async () => {
+    registry('local')
+    await bind(call => call.path.startsWith('/tasks/bulk')
+      ? { results: (call.opts?.body as { ids: string[] }).ids.map(id => ({ id, ok: true })) }
+      : board({ ready: [] }))
+    api.rememberTaskOwner('bulk-a', 'ops', 'local', 'worker-a')
+    api.rememberTaskOwner('bulk-b', 'ops', 'local', 'worker-b')
+    api.rememberTaskOwner('bulk-c', 'other', 'local', 'worker-a')
+    calls = []
+    await bulkTasks(['bulk-a', 'bulk-b', 'bulk-c'], { status: 'todo' })
+    expect(calls).toEqual([
+      { path: '/tasks/bulk?board=ops', opts: { connectionId: 'local', profile: 'worker-a', method: 'POST', body: { ids: ['bulk-a'], status: 'todo' } } },
+      { path: '/tasks/bulk?board=ops', opts: { connectionId: 'local', profile: 'worker-b', method: 'POST', body: { ids: ['bulk-b'], status: 'todo' } } },
+      { path: '/tasks/bulk?board=other', opts: { connectionId: 'local', profile: 'worker-a', method: 'POST', body: { ids: ['bulk-c'], status: 'todo' } } }
+    ])
+  })
+
   it('keeps the single-gateway path byte-identical', async () => {
     registry('local')
     await bind(() => board({ ready: [task('a')] }))
diff --git a/apps/desktop/src/plugins/kanban/api.ts b/apps/desktop/src/plugins/kanban/api.ts
index 7fb2581c28..03d5e64010 100644
--- a/apps/desktop/src/plugins/kanban/api.ts
+++ b/apps/desktop/src/plugins/kanban/api.ts
@@ -1051,22 +1051,23 @@ type BulkResult = { results: Array<{ id: string; ok: boolean; error?: string }>
  *  outcomes so the UI can toast partial failures. [daveey] Split per owning
  *  gateway (and board); a whole gateway failing reports each of its ids. */
 export async function bulkTasks(ids: string[], patch: Record<string, unknown>): Promise<BulkResult> {
-  const groups = new Map<string, string[]>()
+  const groups = new Map<string, { ids: string[]; path: string; opts: PluginRestOptions; gateway: string }>()
 
   for (const id of ids) {
-    const owner = taskOwners.get(id)
-    const key = owner && owner.gateway !== routedScope() ? `${owner.gateway}\0${owner.board}` : ''
-    groups.set(key, [...(groups.get(key) ?? []), id])
+    // Capture the complete route before starting any asynchronous writes.
+    const [path, opts] = forTask(id, '/tasks/bulk')
+    const gateway = taskGateway(id)
+    const key = JSON.stringify([gateway, opts.profile, path])
+    const group = groups.get(key) ?? { ids: [], path, opts, gateway }
+    group.ids.push(id)
+    groups.set(key, group)
   }
 
   const outcomes = await Promise.all(
-    [...groups.entries()].map(async ([key, group]) => {
-      const [gateway, board] = key ? key.split('\0') : [routedScope(), '']
-      const path = key ? withSlug('/tasks/bulk', board) : withBoard('/tasks/bulk')
-
+    [...groups.values()].map(async ({ ids: group, path, opts, gateway }) => {
       try {
         return await nudged(
-          call<BulkResult>(path, { ...(key ? via(gateway) : {}), method: 'POST', body: { ids: group, ...patch } }),
+          call<BulkResult>(path, { ...opts, method: 'POST', body: { ids: group, ...patch } }),
           gateway
         )
       } catch (err) {
-- 
