From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 03:17:47 -0800
Subject: [PATCH] kanban_stale_ask: open the board through
 kanban_lockguard.connect (lockguard test)

---
 hermes_cli/kanban_stale_ask.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_stale_ask.py b/hermes_cli/kanban_stale_ask.py
index 5d5ca4fad5..c793e72d9e 100644
--- a/hermes_cli/kanban_stale_ask.py
+++ b/hermes_cli/kanban_stale_ask.py
@@ -64,7 +64,8 @@ def _read_card(board: str, task_id: str):
     path = kanban_db_path(board=board)
     if not path.exists():
         return None
-    conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=2)
+    from hermes_cli import kanban_lockguard
+    conn = kanban_lockguard.connect(f"file:{path}?mode=ro", uri=True, timeout=2)
     try:
         row = conn.execute("SELECT status, human_request FROM tasks WHERE id=?", (task_id,)).fetchone()
         if row is None:
