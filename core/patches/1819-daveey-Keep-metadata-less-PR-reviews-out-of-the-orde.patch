 .../test_kanban_dependency_review.py          | 35 +++++++++++++------
 ...est_kanban_dependency_review_no_verdict.py | 26 +++++++++++---
 .../test_kanban_dependency_review_sync.py     |  6 ++--
 5 files changed, 77 insertions(+), 20 deletions(-)

