diff --git a/hermes_cli/kanban_dependency_review.py b/hermes_cli/kanban_dependency_review.py
index 8519a805f42..a972f745be5 100644
--- a/hermes_cli/kanban_dependency_review.py
+++ b/hermes_cli/kanban_dependency_review.py
@@ -188,6 +188,30 @@ def _approval_prs(conn, parent_id, parked_at, owner_run_id, captured: set[str])
     return named if named is not None else set(captured)
 
 
+_REVIEW_KEYS = ("verdict", "approved", "reviewed_sha", "reviewed_pr")
+
+
+def is_review_result(metadata, summary, captured) -> bool:
+    """True when a parent's result belongs to the review rules, not the ordering handoff.
+
+    Verdict keys or a ``VERDICT:`` line mark a review (a bare ``head`` does not:
+    operator gates record one). So does a result that
+    names a checkpointed PR (``pr``/summary ``PR #N`` or URL) with none of them: a
+    review whose metadata was lost must fail closed on the exact-head check rather
+    than pass as an ordering prerequisite once the park is a second past the PR.
+    """
+    if any(key in metadata for key in _REVIEW_KEYS) or _SUMMARY_VERDICT.search(summary or ""):
+        return True
+    prs = {u.rstrip("/").lower() for u in captured or () if isinstance(u, str)}
+    if not prs:
+        return False
+    if "pr" in metadata and _named_prs(metadata, prs):
+        return True
+    text = (summary or "").lower()
+    nums = set(_SUMMARY_PR_NUM.findall(text))
+    return any(u in text or u.rsplit("/", 1)[-1] in nums for u in prs)
+
+
 def _historical_parent(conn, parent_id, parked_at):
     """Legacy checkpoints: exempt only provably finished, unchanged dependencies."""
     from hermes_cli import kanban_db as kb
diff --git a/tests/hermes_cli/test_kanban_dependency_review.py b/tests/hermes_cli/test_kanban_dependency_review.py
index fb37c901cf5..7b5548ff424 100644
--- a/tests/hermes_cli/test_kanban_dependency_review.py
+++ b/tests/hermes_cli/test_kanban_dependency_review.py
@@ -1,4 +1,6 @@
 """Dependency-review continuation must repair the same PR, not defeat respawn guards."""
+import time
+
 import pytest
 
 from hermes_cli import kanban_db as kb
@@ -19,16 +21,29 @@ def board(tmp_path, monkeypatch):
         yield conn
 
 
-def parked(conn, *, authenticated=True):
-    task = kb.create_task(conn, title="implementation", assignee="dev")
-    kb.claim_task(conn, task)
-    run = kb.get_task(conn, task).current_run_id
-    worker_comment(conn, task, "dev", PR)
-    reviews = [kb.create_task(conn, title="review", assignee="reviewer") for _ in range(2)]
-    for review in reviews:
-        kb.link_tasks(conn, review, task, expected_child_run_id=run)
-    assert kb.block_task(conn, task, kind="dependency", reason="Independent review",
-                         expected_run_id=run if authenticated else None)
+def parked(conn, *, authenticated=True, park_delay=1):
+    """Owner publishes its PR, then parks ``park_delay`` whole seconds later.
+
+    The clock is pinned, not wall-clock: the ordering-dependency handoff only
+    considers a park strictly after the PR comment, so an unpinned fixture
+    flipped between that path and the same-second tie with runner load. 1 s is
+    production's usual ordering; both stamps are at or before real "now", so
+    later events (review completion, promotion) still sort after the park.
+    """
+    parked_at = int(time.time())
+    published = parked_at - park_delay
+    with pytest.MonkeyPatch.context() as clock:
+        clock.setattr(time, "time", lambda: published)
+        task = kb.create_task(conn, title="implementation", assignee="dev")
+        kb.claim_task(conn, task)
+        run = kb.get_task(conn, task).current_run_id
+        worker_comment(conn, task, "dev", PR)
+        clock.setattr(time, "time", lambda: parked_at)
+        reviews = [kb.create_task(conn, title="review", assignee="reviewer") for _ in range(2)]
+        for review in reviews:
+            kb.link_tasks(conn, review, task, expected_child_run_id=run)
+        assert kb.block_task(conn, task, kind="dependency", reason="Independent review",
+                             expected_run_id=run if authenticated else None)
     return task, reviews
 
 
