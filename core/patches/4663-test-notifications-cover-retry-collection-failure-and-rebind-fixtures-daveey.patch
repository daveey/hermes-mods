From 8170cec51e4363972f6320e481a2ecbe094ee693 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 23:26:39 +0000
Subject: [PATCH] test(notifications): cover retry collection failure and
 rebind fixtures [daveey]

---
 .../gateway/test_kanban_tui_sibling_custody.py  |  2 +-
 .../tui_gateway/test_bot_live_owner_delivery.py |  8 ++++++--
 .../test_notification_remote_retry.py           | 17 +++++++++++++++++
 3 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/tests/gateway/test_kanban_tui_sibling_custody.py b/tests/gateway/test_kanban_tui_sibling_custody.py
index 4ccf8d59ce762da9df290bdde674cae6e95dc1b6..86f1382837e608df394a6a3135f504151914bb56 100644
--- a/tests/gateway/test_kanban_tui_sibling_custody.py
+++ b/tests/gateway/test_kanban_tui_sibling_custody.py
@@ -408,7 +408,7 @@ def test_gateway_owned_chat_skips_the_remote_collection_a_legacy_only_chat_keeps
     _runner, authority, _adapter, _admitted = env
     asked = []
     monkeypatch.setattr(server, "_collect_remote_kanban_notifications",
-                        lambda key, claims: asked.append(key) or [])
+                        lambda key, claims, *, session=None: asked.append(key) or [])
     session = _session()
     _legacy_collect(session)
     assert asked == [CHAT], "a legacy-only chat still collects its remote notices"
diff --git a/tests/tui_gateway/test_bot_live_owner_delivery.py b/tests/tui_gateway/test_bot_live_owner_delivery.py
index bce3253e7a466c89187c88a23d2eb12c44277786..0f6020b2442c59c8583bde13af955434864ac550 100644
--- a/tests/tui_gateway/test_bot_live_owner_delivery.py
+++ b/tests/tui_gateway/test_bot_live_owner_delivery.py
@@ -101,8 +101,9 @@ def test_viewer_poller_never_discovers_or_claims_bot_execution(monkeypatch, tmp_
         '_notif_log_failure': unexpected_failure, 'logger': logging.getLogger(__name__),
     })
     # Start from the module's own globals: the fork's poller also reads its parked/held handoff helpers.
-    poll = rebind(session_notifications._notification_poller_scoped_loop, {
+    globals_ = {
         **vars(session_notifications),
+        'logger': logging.getLogger(__name__),
         '_kb_release_claims': release_claims, '_notif_log_failure': unexpected_failure,
         'time': time, '_LOOP_POLL_SECONDS': 0, '_KANBAN_POLL_SECONDS': 0,
         '_poll_bot_live_delivery_once': lambda *a: calls.append('legacy-claim'),
@@ -112,7 +113,10 @@ def test_viewer_poller_never_discovers_or_claims_bot_execution(monkeypatch, tmp_
         '_session_profile_runtime_scope': lambda session: contextlib.nullcontext(),
         '_session_home': lambda session: tmp_path,
         '_notif_handle_ready': lambda sid, session, ready, *a, **kw: (delivered.extend(ready), stop.set()),
-    })
+    }
+    for name in ('_notification_poller_run', '_notification_poller_cleanup'):
+        globals_[name] = rebind(getattr(session_notifications, name), globals_)
+    poll = rebind(session_notifications._notification_poller_scoped_loop, globals_)
     poll(stop, 'live', {'agent': object(), 'history_lock': threading.RLock(), 'session_key': 'chat',
                       'active_session_lease': SimpleNamespace(lease_id='lease', released=False)})
     assert delivered == [{'type': 'owned-completion'}]
diff --git a/tests/tui_gateway/test_notification_remote_retry.py b/tests/tui_gateway/test_notification_remote_retry.py
index 6bec320ba084adbd824dfbcf88c5cc258737623b..1fc85d5ffd2c86a56404747d077d17824fcfbe73 100644
--- a/tests/tui_gateway/test_notification_remote_retry.py
+++ b/tests/tui_gateway/test_notification_remote_retry.py
@@ -49,6 +49,23 @@ def test_deferred_reader_consumes_publication_before_next_churn(own, monkeypatch
     assert not computes  # the genuine retry hit ended the previous miss episode
 
 
+def test_remote_collector_failure_cancels_callback_retry(own, monkeypatch):
+    session = {"session_key": fixtures.CHAT}
+    failures = []
+    monkeypatch.setattr(sn, "_session_lineage", lambda key: ())
+    monkeypatch.setattr(sn, "_notif_log_failure", lambda *args: failures.append(args))
+
+    def collect(*args, on_defer, **kwargs):
+        on_defer()
+        assert "_kanban_remote_retry_at" in session
+        raise RuntimeError("collector failed after deferring")
+
+    monkeypatch.setattr(krn, "collect", collect)
+    assert sn._collect_remote_kanban_notifications(fixtures.CHAT, [], session=session) == []
+    assert "_kanban_remote_retry_at" not in session
+    assert len(failures) == 1 and "collector failed" in str(failures[0][1])
+
+
 @pytest.mark.parametrize("outcome", ["empty_hit", "defer", "mixed_ok", "binding", "release_error",
                                     "refused", "_closing", "_finalized", "_lease_taken_over", "exception"])
 def test_poll_attempt_keeps_only_valid_deferral(monkeypatch, outcome):
