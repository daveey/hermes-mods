 def _build_api_kwargs_for_mode(agent, api_messages: list, tools_for_api: list | None = None) -> dict:
+    # Every request shape (main turn, compression summary, Codex flush) is built here: an agent
+    # constructed before managed enforcement was enabled adopts its approved tuple before the
+    # credential-dependent shaping below (OAuth system/beta handling), or raises before any send.
+    from agent.model_routing_agent import adopt_managed_policy
+    adopt_managed_policy(agent)
     # One-shot continuation override — consumed exactly once, on the FIRST
     # request this call builds (only one api_mode branch runs per invocation).
     reasoning_config = _reasoning_config_for_wire(agent)
diff --git a/agent/model_routing_agent.py b/agent/model_routing_agent.py
index f5a165c145..c755e5505d 100644
--- a/agent/model_routing_agent.py
+++ b/agent/model_routing_agent.py
@@ -135,6 +135,72 @@ def try_class_fallback(agent):
     return True
 
 
+def adopt_managed_policy(agent):
+    """Bring an agent built before managed enforcement was switched on under the policy.
+
+    ``enforce_subscription_only`` is read live, but subscription provenance is only minted when
+    an agent is constructed, so every agent already alive when an operator enables the policy
+    (gateway caches, Desktop sessions, running Kanban workers) would fail closed at its next
+    request with "lacks verified subscription provenance". Before a request is shaped, re-resolve
+    the agent's own concrete tuple as a managed exact pin and rebuild its client from the fenced
+    runtime. Unapproved tuples (paid keys, aggregators, unknown models) still raise before any
+    send, and a paid credential the legacy agent held is replaced by the subscription pool.
+    Returns True only when provenance was adopted by this call.
+    """
+    if getattr(agent, "model_routing", None):
+        return False
+    if isinstance(getattr(agent, "_one_turn_runtime", None), dict):
+        return False  # a temporary switch owns the runtime; its own guards apply
+    from agent.model_routing_managed import managed_config, resolve_managed_runtime
+    config = managed_config()
+    if config is None:
+        return False
+    from agent.agent_init import _build_client, _snapshot_primary_runtime
+    from agent.agent_runtime_helpers import sync_credential_pool_entry_id
+
+    requirements = dict(getattr(agent, "_model_routing_requirements", None) or {"tools": True, "streaming": True})
+    old_client = getattr(agent, "client", None)
+    old_anthropic_client = getattr(agent, "_anthropic_client", None)
+    previous = vars(agent).copy()
+
+    def prepare(runtime):
+        agent.model, agent.provider = runtime["model"], runtime["provider"]
+        agent.base_url, agent.api_mode = runtime["base_url"], runtime["api_mode"]
+        agent._credential_pool = runtime["credential_pool"]
+        _build_client(agent, runtime["api_key"], runtime["base_url"], [])
+
+    try:
+        runtime = resolve_managed_runtime(agent.model, agent.provider, config=config,
+                                          session_id=agent.session_id, requirements=requirements,
+                                          prepare_runtime=prepare)
+    except BaseException:
+        vars(agent).clear()
+        vars(agent).update(previous)
+        raise
+    agent.model_routing = runtime["model_routing"]
+    agent._model_routing_requirements = requirements
+    agent._fallback_chain = []
+    agent._fallback_model = None
+    if old_client is not None and old_client is not agent.client:
+        agent._retire_shared_openai_client(old_client, reason="managed_policy_adoption")
+    if old_anthropic_client is not None and old_anthropic_client is not getattr(agent, "_anthropic_client", None):
+        import logging
+        try:
+            old_anthropic_client.close()
+        except Exception:
+            logging.getLogger(__name__).debug("Retired legacy client close failed", exc_info=True)
+    sync_credential_pool_entry_id(agent)
+    if hasattr(agent, "_transport_cache"):
+        agent._transport_cache.clear()
+    _snapshot_primary_runtime(agent)
+    persist_class_metadata(agent)
+    import logging
+    logging.getLogger(__name__).info(
+        "Adopted managed subscription policy for live agent session=%s route=%s/%s",
+        agent.session_id, agent.provider, agent.model)
+    return True
+
+
 def link_compression_route(agent, parent_session_id, child_session_id):
     """Only compression publication/adoption may join main-agent allocations."""
     from agent.agent_runtime_once import standing_runtime
diff --git a/agent/model_routing_state.py b/agent/model_routing_state.py
index 6ecaf209d6..028a9060d8 100644
--- a/agent/model_routing_state.py
+++ b/agent/model_routing_state.py
@@ -91,7 +91,7 @@ class RoutingState:
                 raise ModelRoutingError("Exact pinned route cannot fail over")
         if not candidates:
             raise ModelRoutingError(f"No eligible {level} routes under billing/capability policy")
-        route = self._choose(db, level, candidates, version)
+        route = self._choose(db, level, candidates, version, kind=_allocation_kind(root))
         metadata = {"requested_class": level, "policy_version": version,
                     "selected_provider": route["provider"], "selected_model": route["model"],
                     "billing_group": route["billing"], "reason": "same-class-failover" if row else "allocation"}
@@ -116,7 +116,7 @@ class RoutingState:
         return root
 
     @staticmethod
-    def _choose(db, level, candidates, version):
+    def _choose(db, level, candidates, version, kind="main"):
         # Provider weights, not route/account counts, determine traffic share.
         subscriptions = [r for r in candidates if r["billing"] == "subscription"]
         candidates = subscriptions or candidates
@@ -124,9 +124,19 @@ class RoutingState:
         for route in candidates:
             groups.setdefault(route["provider"], []).append(route)
         cycle = [p for p in sorted(groups) for _ in range(groups[p][0]["weight"])]
-        pool = json.dumps([version, level, [(p, groups[p][0]["weight"]) for p in sorted(groups)]])
+        key = [version, level, [(p, groups[p][0]["weight"]) for p in sorted(groups)]]
+        # Main sessions and auxiliary owners keep separate cycles. A shared counter interleaved
+        # one main + one aux allocation per session, so with two providers every main session
+        # landed on the same provider (and every aux call on the other). The main key is
+        # unchanged so existing counters keep their position.
+        pool = json.dumps(key if kind == "main" else key + [kind])
         row = db.execute("SELECT position FROM counters WHERE pool=?", (pool,)).fetchone()
         position = row[0] if row else 0
         provider = cycle[position % len(cycle)]
         db.execute("INSERT OR REPLACE INTO counters VALUES (?, ?)", (pool, position + 1))
         return sorted(groups[provider], key=lambda r: r["model"])[0]
+
+
+def _allocation_kind(root):
+    """Auxiliary owners are allocated under ``aux:<owner>:<task>:<class>`` roots."""
+    return "aux" if str(root).startswith("aux:") else "main"
