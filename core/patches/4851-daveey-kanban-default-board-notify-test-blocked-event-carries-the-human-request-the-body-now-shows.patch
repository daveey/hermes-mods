From a3cf785dc296f17aa58e05c72f50017ec249d290 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 21:56:24 -0800
Subject: [PATCH] [daveey] kanban default-board notify test: blocked event
 carries the human_request the body now shows

CI (JS & TS checks, run 41584340234) failed api.default-notify.test.ts, which pinned the old
reason-as-body contract changed in 6c79560a95. The socket pipeline test now sends a human_request
and asserts its action is the notification body.
---
 apps/desktop/src/plugins/kanban/api.default-notify.test.ts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/plugins/kanban/api.default-notify.test.ts b/apps/desktop/src/plugins/kanban/api.default-notify.test.ts
index 54da41cd08555a1b4eb1779f55d92848c0d67807..bf9e4dca699ecc7ca845f33a6925f569ded78df4 100644
--- a/apps/desktop/src/plugins/kanban/api.default-notify.test.ts
+++ b/apps/desktop/src/plugins/kanban/api.default-notify.test.ts
@@ -169,11 +169,11 @@ describe('default board event notifications', () => {
       cursor: 102,
       events: [
         { id: 99, kind: 'completed' },
-        { id: 102, kind: 'blocked', task_id: 'task', payload: { reason: 'Need approval' } }
+        { id: 102, kind: 'blocked', task_id: 'task', payload: { reason: 'Need approval', human_request: { action: 'Reply in chat with yes or no.' } } }
       ]
     })
     await vi.waitFor(() => expect(doors.notify).toHaveBeenCalledTimes(1))
-    expect(doors.notify).toHaveBeenCalledWith(expect.objectContaining({ message: 'Need approval' }))
+    expect(doors.notify).toHaveBeenCalledWith(expect.objectContaining({ message: 'Reply in chat with yes or no.' }))
     callbacks[0]({ cursor: 102, events: [{ id: 102, kind: 'blocked' }] })
     await new Promise(resolve => setTimeout(resolve, 0))
     expect(doors.notify).toHaveBeenCalledTimes(1)
-- 
