From 07c68dbc5e2b44249482107030033a38a3f0c315 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 9 Nov 2026 17:08:25 +0000
Subject: [PATCH] [daveey] Wait for cancelled control diagnostic publication in
 test

---
 tests/gateway/test_control_diagnostics.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/tests/gateway/test_control_diagnostics.py b/tests/gateway/test_control_diagnostics.py
index 488f66c8e7c..eadb81a3620 100644
--- a/tests/gateway/test_control_diagnostics.py
+++ b/tests/gateway/test_control_diagnostics.py
@@ -310,7 +310,10 @@ def test_cancelled_connection_still_reports_slow_running_handler(tmp_path, caplo
         timer = threading.Timer(0.6, release.set)
         timer.start()
         try:
-            await async_wait_until(lambda: server._diagnostics.in_flight == 0, timeout=3)
+            # completed() drops in_flight before emitting on the worker thread.
+            # Keep capture active until publication, not merely accounting, finishes.
+            await async_wait_until(lambda: latency_records(caplog), timeout=30)
+            assert server._diagnostics.in_flight == 0
         finally:
             release.set()
             timer.join()
-- 
