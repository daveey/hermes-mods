From f45ecd5723a6d8980f9c776085702966a8bd8d05 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 10:03:42 +0000
Subject: [PATCH] test(kanban): preserve entry atomicity and class pacing
 without pin fixtures [daveey]

---
 .../test_kanban_create_entry_parity.py        |  6 ++--
 .../test_kanban_pacing_default_reads.py       |  8 +++--
 .../test_model_whitespace_entry_parity.py     | 34 ++++++++++++++-----
 3 files changed, 35 insertions(+), 13 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_create_entry_parity.py b/tests/hermes_cli/test_kanban_create_entry_parity.py
index 0058f0301d..88995ae37b 100644
--- a/tests/hermes_cli/test_kanban_create_entry_parity.py
+++ b/tests/hermes_cli/test_kanban_create_entry_parity.py
@@ -255,7 +255,7 @@ def test_single_decomposer_returns_rejected_outcome(restricted_creator, monkeypa
 
 @pytest.mark.parametrize("surface", ["tool", "cli", "rest"])
 def test_every_create_path_refuses_a_pin_the_managed_registry_rejects(chat, monkeypatch, surface):
-    """[daveey] A pin the worker's managed subscription policy refuses at startup is refused at create on every path."""
+    """Concrete selectors are refused before insert, even if registry validation once handled them."""
     from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
     (chat / "config.yaml").write_text("model:\n  default: claude-sonnet-5-5\n  provider: anthropic\n" + _managed_yaml())
     monkeypatch.setattr(kc, "_check_dispatcher_presence", lambda **kw: (True, ""))
@@ -263,7 +263,7 @@ def test_every_create_path_refuses_a_pin_the_managed_registry_rejects(chat, monk
         from tools.registry import registry
         bad = json.loads(registry.dispatch("kanban_create", {"title": "Bad", "assignee": "default",
                                                              "model": "claude-sonnet-4-5"}))
-        assert bad["code"] == "model_pin_not_in_routing_registry", bad
+        assert "Kanban is model-neutral" in bad.get("error", ""), bad
     elif surface == "cli":
         root = argparse.ArgumentParser()
         kc.build_parser(root.add_subparsers())
@@ -278,7 +278,7 @@ def test_every_create_path_refuses_a_pin_the_managed_registry_rejects(chat, monk
         with TestClient(app) as client:
             bad = client.post("/tasks", json={"title": "Bad", "assignee": "default",
                                               "model_override": "claude-sonnet-4-5"})
-            assert bad.status_code == 400 and "model_pin_not_in_routing_registry" in bad.text, bad.text
+            assert bad.status_code == 400 and "Kanban is model-neutral" in bad.text, bad.text
     with kbc.connect_closing() as conn:
         assert kb.list_tasks(conn) == []
 
diff --git a/tests/hermes_cli/test_kanban_pacing_default_reads.py b/tests/hermes_cli/test_kanban_pacing_default_reads.py
index a37534af3c..8ecc2f31d8 100644
--- a/tests/hermes_cli/test_kanban_pacing_default_reads.py
+++ b/tests/hermes_cli/test_kanban_pacing_default_reads.py
@@ -28,8 +28,12 @@ def _default_config(monkeypatch):
 
 
 def _anthropic_card(conn, priority=900):
-    return kb.create_task(conn, title="paced pool card", assignee="default", priority=priority,
-                          model_override=notices.OPUS, provider_override="anthropic")
+    # The fixture's real class registry has only the Anthropic subscription route.
+    # Pacing follows eligible class providers, never a stored per-card selector.
+    tid = kb.create_task(conn, title="paced pool card", assignee="default", priority=priority)
+    task = kb.get_task(conn, tid)
+    assert (task.model_override, task.provider_override) == (None, None)
+    return tid
 
 
 def test_a_paced_pool_is_no_hold_to_describe_and_a_held_one_still_is(board):
diff --git a/tests/hermes_cli/test_model_whitespace_entry_parity.py b/tests/hermes_cli/test_model_whitespace_entry_parity.py
index 5b07c5b3c9..12411042ee 100644
--- a/tests/hermes_cli/test_model_whitespace_entry_parity.py
+++ b/tests/hermes_cli/test_model_whitespace_entry_parity.py
@@ -152,7 +152,9 @@ def test_cmd_chat_m_accepts_local_spaced_id(main_mod, fake_cli, monkeypatch, mod
     assert fake_cli["model"] == model
 
 
-# ── Kanban --model pins ─────────────────────────────────────────────────
+# ── Kanban restrictions: stricter than interactive model selection ──────
+
+from hermes_cli.kanban_model_neutral import ERROR as NEUTRAL_MSG
 
 @pytest.fixture
 def board(tmp_path, monkeypatch):
@@ -179,7 +181,7 @@ def board(tmp_path, monkeypatch):
 def test_kanban_create_rejects(board, model, provider):
     from hermes_cli import kanban_db as kb
 
-    with pytest.raises(ValueError, match=SPACES_MSG):
+    with pytest.raises(ValueError, match=NEUTRAL_MSG):
         kb.create_task(board, title="probe", assignee="worker", model_override=model, provider_override=provider)
     assert board.execute("SELECT count(*) FROM tasks").fetchone()[0] == 0
 
@@ -189,14 +191,30 @@ def test_kanban_set_model_rejects(board, model, provider):
     from hermes_cli import kanban_db as kb
 
     tid = kb.create_task(board, title="probe", assignee="worker")
-    with pytest.raises(ValueError, match=SPACES_MSG):
+    before = tuple(board.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone())
+    events = [tuple(row) for row in board.execute("SELECT * FROM task_events ORDER BY id")]
+    with pytest.raises(ValueError, match=NEUTRAL_MSG):
         kb.set_model_override(board, tid, model, provider)
-    assert kb.get_task(board, tid).model_override is None
+    assert tuple(board.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone()) == before
+    assert [tuple(row) for row in board.execute("SELECT * FROM task_events ORDER BY id")] == events
+
+
+@pytest.mark.parametrize("model,provider,base_url", GOOD_LOCAL)
+def test_kanban_create_refuses_custom_spaced_id(board, model, provider, base_url):
+    """Interactive local ids stay valid above; Kanban never stores a concrete pin."""
+    from hermes_cli import kanban_db as kb
+
+    with pytest.raises(ValueError, match=NEUTRAL_MSG):
+        kb.create_task(board, title="probe", assignee="worker", model_override=model,
+                       provider_override=provider)
+    assert board.execute("SELECT count(*) FROM tasks").fetchone()[0] == 0
 
 
-def test_kanban_create_accepts_custom_spaced_id(board):
+@pytest.mark.parametrize("model,provider", [(None, None), ("class:standard", "auto")])
+def test_kanban_neutral_and_class_selectors_still_work(board, model, provider):
     from hermes_cli import kanban_db as kb
 
-    tid = kb.create_task(board, title="probe", assignee="worker", model_override="My Model",
-                         provider_override="custom")
-    assert kb.get_task(board, tid).model_override == "My Model"
+    tid = kb.create_task(board, title="probe", assignee="worker", model_override=model,
+                         provider_override=provider)
+    task = kb.get_task(board, tid)
+    assert (task.model_override, task.provider_override) == (model, provider)
