From 5ae5b5e9e5eabdb623b5f5884a25cb247f0c7610 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 15:55:06 +0000
Subject: [PATCH] [daveey] Bound no-sink heredoc scan work instead of scheduler
 time

The 8000-line semantic scan used a five-second wall deadline, so unrelated descheduling failed correct scans. A controlled six-second SIGSTOP at its scan boundary fails the old assertion and passes the work-count replacement. Historical suite timing alone does not establish how much CPU the failed run consumed.

Keep both input sizes and the original semantic verdict. Profile call counts with an absolute per-line budget and an eightfold-input growth ceiling; retain the separate regex-backtracking performance test because cProfile cannot observe work inside C regex calls. No production guard changes.

Proof: canonical output-sink suite 194 passed. Exact-child six-second SIGSTOP RED/GREEN. Duplicate traversal killed at 4513904 calls for 1000 lines; size-dependent work killed by growth [2253467,21962457] below absolute budgets; wrong-verdict and historical quadratic regex mutants killed. Quiet unprofiled 1000/2000/8000-line CPU times 0.241/0.540/1.975s. Search found related PR3336 token deduplication but no overlapping fixture change.
---
 .../cron/test_lifecycle_guard_output_sink.py  | 23 +++++++++++++++----
 1 file changed, 18 insertions(+), 5 deletions(-)

diff --git a/tests/cron/test_lifecycle_guard_output_sink.py b/tests/cron/test_lifecycle_guard_output_sink.py
index 4e0767be33156dfd0e1bd692c84111f51e896f0b..ec2d098285ae4dbf8f9d8dfa92b7cd2601cbd15a 100644
--- a/tests/cron/test_lifecycle_guard_output_sink.py
+++ b/tests/cron/test_lifecycle_guard_output_sink.py
@@ -6,6 +6,7 @@ an interpreter string literal. The shape corpus (``heredoc_shape_corpus``, ``s_p
 "sink"``) crosses every sink with every wrapper and nesting form under real bash.
 """
 
+import cProfile
 import shutil
 import subprocess
 import time
@@ -217,11 +218,23 @@ def test_sink_regex_is_linear_on_masked_newline_runs():
 
 
 def test_large_no_sink_heredoc_scan_stays_fast(tmp_path):
-    body = "".join(f"x{i} = {i}\n" for i in range(8000))
-    command = "python3 - <<'PY'\n" + body + "PY\n"
-    started = time.monotonic()
-    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (False, None)
-    assert time.monotonic() - started < 5.0
+    # Wall time includes unrelated suite scheduling (reported 15.8s on a loaded
+    # runner, 4.3s on retry). Count work instead: eight times the input must stay
+    # near eight times the calls, with an absolute budget to catch extra passes.
+    # Count builtin calls too; cProfile does NOT count work inside a C regex, so
+    # test_sink_regex_is_linear_on_masked_newline_runs remains a separate guard.
+    calls = []
+    for lines in (1000, 8000):
+        body = "".join(f"x{i} = {i}\n" for i in range(lines))
+        command = "python3 - <<'PY'\n" + body + "PY\n"
+        with cProfile.Profile() as profile:
+            assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (False, None)
+        count = sum(entry.callcount for entry in profile.getstats())
+        # Baseline ~2370 calls/line; allow implementation/interpreter variation,
+        # not a second traversal. No elapsed-time deadline is widened or mocked.
+        assert count < 3000 * lines + 100_000, (lines, count)
+        calls.append(count)
+    assert calls[1] < 9 * calls[0], calls
 
 
 def test_producer_reading_an_oversized_data_file_under_a_sink_fails_closed(tmp_path):
