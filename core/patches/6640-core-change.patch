From 1202bf98436b97980b5914234a0b81cbed79adc3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 26 Nov 2026 22:58:27 +0000
Subject: [PATCH 6640] Hot-path read-cost reductions (SQLite hand-offs, request coalescing, memoization)

Public mirror of source commit 1202bf98436b97980b5914234a0b81cbed79adc3.

---
diff --git a/apps/desktop/src/app/contrib/hooks/use-background-sync.test.ts b/apps/desktop/src/app/contrib/hooks/use-background-sync.test.ts
index ac3fceb75f1a4844090a39d4f876ddd495795889..0cc8a3384b88ef70b9d266f92834ca8c10cb6f68 100644
--- a/apps/desktop/src/app/contrib/hooks/use-background-sync.test.ts
+++ b/apps/desktop/src/app/contrib/hooks/use-background-sync.test.ts
@@ -1285,13 +1285,13 @@
   // identity across the tick-driven re-renders — an unstable prop would
   // re-run the connect-reseed effect and re-subscribe the throttle each
   // render, polluting the counts under observation.
-  function renderTypingSync(refreshSessions: () => Promise<void>) {
+  function renderTypingSync(refreshSessions: () => Promise<void>, refreshMessagingSessions: () => unknown = vi.fn()) {
     const stable = {
       refreshActiveTranscript: async () => undefined,
       refreshCronJobs: vi.fn(),
       refreshCurrentModel: vi.fn(),
       refreshHermesConfig: vi.fn(),
-      refreshMessagingSessions: vi.fn(),
+      refreshMessagingSessions,
       requestGateway: vi.fn(async () => ({ sessions: [] })) as never,
       // Required by the hook's params. This harness never drives the
       // transcript path, so the updater just runs against a throwaway state —
@@ -1440,6 +1440,48 @@
 
     expect(refreshSessions).toHaveBeenCalledTimes(1)
   })
+
+  // [daveey] The batched sidebar page refreshSessions reads already carries the
+  // messaging slice, so a change tick must not read that slice a second time.
+  it('reads the session lists once per change tick: no separate messaging read beside the batched page', async () => {
+    vi.useFakeTimers()
+    $changeEventsAvailable.set(true)
+    const refreshSessions = vi.fn(async () => undefined)
+    const refreshMessagingSessions = vi.fn()
+
+    renderTypingSync(refreshSessions, refreshMessagingSessions)
+    await primeThrottle(refreshSessions)
+    refreshMessagingSessions.mockClear()
+
+    // Three throttle windows of continuous backend changes (one per second).
+    for (let second = 0; second < 30; second += 1) {
+      act(() => notifySessionsChanged())
+      await act(async () => {
+        vi.advanceTimersByTime(1_000)
+        await Promise.resolve()
+      })
+    }
+
+    expect(refreshSessions.mock.calls.length).toBeGreaterThanOrEqual(2)
+    expect(refreshSessions.mock.calls.length).toBeLessThanOrEqual(4)
+    expect(refreshMessagingSessions).not.toHaveBeenCalled()
+  })
+
+  it('keeps the legacy messaging poll against a backend without change events', async () => {
+    vi.useFakeTimers()
+    $changeEventsAvailable.set(false)
+    const refreshSessions = vi.fn(async () => undefined)
+    const refreshMessagingSessions = vi.fn()
+
+    renderTypingSync(refreshSessions, refreshMessagingSessions)
+
+    await act(async () => {
+      vi.advanceTimersByTime(31_000)
+      await Promise.resolve()
+    })
+
+    expect(refreshMessagingSessions).toHaveBeenCalledTimes(3)
+  })
 })
 
 describe('an empty persisted page over a populated runtime', () => {
diff --git a/apps/desktop/src/app/contrib/hooks/use-background-sync.ts b/apps/desktop/src/app/contrib/hooks/use-background-sync.ts
index 896a596ec9212d46596fa3eaf478a8f8fabb1ac5..aec4a14c47325f6f32f93ac6f42fbb40813f7770 100644
--- a/apps/desktop/src/app/contrib/hooks/use-background-sync.ts
+++ b/apps/desktop/src/app/contrib/hooks/use-background-sync.ts
@@ -1463,8 +1463,12 @@
     const run = () => {
       lastRunAt = Date.now()
       markSessionListRefreshReason('sessions.changed')
+      // [daveey] refreshSessions' batched page already carries the messaging
+      // slice (same limit and excludes) and publishes it, so a second
+      // refreshMessagingSessions() here re-read every profile store for rows
+      // this pass had just fetched: one extra aggregate list read per tick,
+      // per window, for as long as the backend keeps changing.
       void refreshSessions()
-      void refreshMessagingSessions()
 
       // Archived sessions use their own capped query. Reload it only while the
       // sidebar is showing that view, matching the on-demand fetch contract.
@@ -1547,7 +1551,6 @@
   }, [
     changeEventsAvailable,
     gatewayState,
-    refreshMessagingSessions,
     refreshSessions,
     requestActiveTranscriptRefresh,
     updateSessionState
