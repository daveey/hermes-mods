From 7014c687420a4d52cb1280c12eb09e488710f4de Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 17:15:18 +0000
Subject: [PATCH] [daveey] worker policy root: HERMES_TEST_POLICY_ROOT under a
 temp root isolates a non-pytest suite's account inventory

---
 hermes_cli/worker_compute_capacity.py         | 29 ++++++++++++++
 .../test_worker_compute_capacity.py           | 39 +++++++++++++++++++
 2 files changed, 68 insertions(+)

diff --git a/hermes_cli/worker_compute_capacity.py b/hermes_cli/worker_compute_capacity.py
index 6b1adc4b26..1a8be772fd 100644
--- a/hermes_cli/worker_compute_capacity.py
+++ b/hermes_cli/worker_compute_capacity.py
@@ -134,11 +134,40 @@ def policy_root() -> Path:
 
     Worker enrollment uses this fixed Linux account installation. Custom profile
     roots remain valid for session data, but cannot disable host CPU policy.
+    The one exception is a test harness's temp root (:func:`_test_policy_override`).
     """
+    override = _test_policy_override()
+    if override is not None:
+        return override
     from hermes_constants import _account_home
     return _account_home() / '.hermes'
 
 
+def _test_policy_override(environ=None) -> Path | None:
+    """``HERMES_TEST_POLICY_ROOT``, honoured only as an absolute path under a temp root.
+
+    A non-pytest suite (state's unittest ``run-state-suite-local``) rebinds HOME,
+    which never moved :func:`policy_root`: a test's core child that claimed a card
+    registered its throwaway board in the REAL account inventory, and once the
+    test deleted it every claim on the host deferred ``worker_resources_unknown``
+    (worker-1, 2026-11-13, t_01a1d5bf526e1344). The suite points the policy at
+    its shard dir instead. Temp roots only: no setting can move a worker's
+    policy anywhere durable, so it cannot disable host CPU policy by accident.
+    """
+    import os
+    import tempfile
+    raw = (os.environ if environ is None else environ).get('HERMES_TEST_POLICY_ROOT', '')
+    if not raw or not os.path.isabs(raw):
+        return None
+    path = Path(os.path.realpath(raw))
+    # no-tmp: ok — recognises a harness's temp root; nothing is written here
+    for root in ('/tmp', '/var/tmp', '/dev/shm', tempfile.gettempdir()):
+        real = Path(os.path.realpath(root))
+        if path != real and path.is_relative_to(real):
+            return path
+    return None
+
+
 def worker_enabled() -> bool:
     """Read installation policy, never a card's environment or profile override."""
     from hermes_cli.config_backend import read_config_doc_readonly
diff --git a/tests/hermes_cli/test_worker_compute_capacity.py b/tests/hermes_cli/test_worker_compute_capacity.py
index f8027d423b..a9557b487d 100644
--- a/tests/hermes_cli/test_worker_compute_capacity.py
+++ b/tests/hermes_cli/test_worker_compute_capacity.py
@@ -46,3 +46,42 @@ def test_unknown_populated_scope_reserves_and_failed_sample_refuses(tmp_path):
     (group / 'cgroup.events').write_text('frozen 0\n')
     with pytest.raises(ValueError, match='populated'):
         occupied_owners(tmp_path, {}, set())
+
+
+@pytest.mark.parametrize('raw, honoured', [
+    ('/dev/shm/state-suite-local-x/shard-5/account-policy/.hermes', True),
+    ('/tmp/run/account-policy/.hermes', True),
+    ('/dev/shm', False),  # the temp root itself is no harness dir
+    ('relative/.hermes', False),
+    ('/home/ubuntu/.hermes', False),  # never somewhere durable: a worker's real policy stays put
+    ('/srv/policy/.hermes', False),
+    ('', False),
+])
+def test_test_policy_root_is_honoured_only_under_a_temp_root(raw, honoured):
+    """state's run-state-suite-local (unittest, no pytest) rebinds HOME, which never moved policy_root: a test's
+    core child registered its board in worker-1's real inventory and held every claim once the board was deleted
+    (2026-11-13, t_01a1d5bf526e1344). The suite points HERMES_TEST_POLICY_ROOT at its shard dir instead."""
+    import os
+    from pathlib import Path
+    from hermes_cli import worker_compute_capacity as capacity
+    got = capacity._test_policy_override({'HERMES_TEST_POLICY_ROOT': raw})
+    assert got == (Path(os.path.realpath(raw)) if honoured else None)
+
+
+def test_policy_root_follows_the_override_in_a_child(tmp_path):
+    """The unpatched policy_root (a fresh interpreter, no conftest) answers the shard dir, not the account."""
+    import os
+    import subprocess
+    import sys
+    from pathlib import Path
+    root = Path('/dev/shm') if os.access('/dev/shm', os.W_OK) else Path('/tmp')
+    want = root / f'policy-override-{os.getpid()}' / '.hermes'
+    env = {**os.environ, 'HERMES_TEST_POLICY_ROOT': str(want)}
+    code = 'from hermes_cli import worker_compute_capacity as c; print(c.policy_root())'
+    out = subprocess.run([sys.executable, '-c', code], env=env, capture_output=True, text=True,
+                         cwd=str(Path(__file__).resolve().parents[2]), check=True).stdout.strip()
+    assert out == os.path.realpath(want)
+    env.pop('HERMES_TEST_POLICY_ROOT')
+    out = subprocess.run([sys.executable, '-c', code], env=env, capture_output=True, text=True,
+                         cwd=str(Path(__file__).resolve().parents[2]), check=True).stdout.strip()
+    assert out != os.path.realpath(want) and out.endswith('/.hermes')
