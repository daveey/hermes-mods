Date: Fri, 23 Oct 2026 01:50:18 +0000
Subject: [PATCH] ci: drop duplicate continue-on-error in lockfile-diff.yml
 (invalid workflow file made ci.yaml fail to start) (#30)

---
 .github/workflows/lockfile-diff.yml | 1 -
 1 file changed, 1 deletion(-)

diff --git a/.github/workflows/lockfile-diff.yml b/.github/workflows/lockfile-diff.yml
index 093fb96729..ab1108e128 100644
--- a/.github/workflows/lockfile-diff.yml
+++ b/.github/workflows/lockfile-diff.yml
@@ -102,7 +102,6 @@ jobs:
         # Informational: an artifact-quota hit must not fail the job.
         continue-on-error: true
         uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
-        continue-on-error: true
         with:
           name: lockfile-diff
           path: /tmp/lockfile-diff.md
