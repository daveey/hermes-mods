From 26fd91a0a6bd76d2ab18a1e115c51e22a847e083 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 23:17:44 +0000
Subject: [PATCH] fix(tests): reset fixture skips tui_gateway.server while
 another thread is mid-import

---
 tests/conftest.py                             | 16 +++++++--
 ...tui_server_reset_fixture_partial_import.py | 33 +++++++++++++++++++
 2 files changed, 47 insertions(+), 2 deletions(-)
 create mode 100644 tests/test_tui_server_reset_fixture_partial_import.py

diff --git a/tests/conftest.py b/tests/conftest.py
index 68977a4f5f..5100772879 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -972,11 +972,23 @@ def _teardown_tui_server_sessions(mod) -> None:
         mod._close_session_by_id(sid, end_reason="test_cleanup")
 
 
+def _tui_server_importing(mod) -> bool:
+    """True while another thread is still executing ``tui_gateway.server``'s import.
+
+    A prior test's leaked worker thread (e.g. one starved past its join timeout) can import the
+    server lazily; ``sys.modules`` then holds a partially initialized module whose globals
+    (``_methods``, ``_sessions``, ...) do not exist yet. Touching them raises AttributeError and
+    cascades into every later test in the file as a setup/teardown ERROR.
+    """
+    spec = getattr(mod, "__spec__", None)
+    return bool(getattr(spec, "_initializing", False))
+
+
 @pytest.fixture(autouse=True)
 def _reset_tui_gateway_server_state():
     mod = sys.modules.get(_TUI_SERVER_MODULE)
     snapshot = None
-    if mod is not None:
+    if mod is not None and not _tui_server_importing(mod):
         snapshot = {
             "methods": dict(mod._methods),
             "cfg": (mod._cfg_cache, mod._cfg_sig, mod._cfg_path),
@@ -987,7 +999,7 @@ def _reset_tui_gateway_server_state():
     yield
 
     mod = sys.modules.get(_TUI_SERVER_MODULE)
-    if mod is None:
+    if mod is None or _tui_server_importing(mod):
         return
 
     # This finalizer can run before the test's own monkeypatch undo, so a
diff --git a/tests/test_tui_server_reset_fixture_partial_import.py b/tests/test_tui_server_reset_fixture_partial_import.py
new file mode 100644
index 0000000000..e8659bdbf5
--- /dev/null
+++ b/tests/test_tui_server_reset_fixture_partial_import.py
@@ -0,0 +1,33 @@
+"""The tui_gateway.server reset fixture must tolerate a module another thread is still importing."""
+import importlib.machinery
+import sys
+import types
+
+from tests import conftest as root_conftest
+
+
+def _fixture_body():
+    fx = root_conftest._reset_tui_gateway_server_state
+    return getattr(fx, "__wrapped__", None) or fx.__pytest_wrapped__.obj
+
+
+def test_partially_initialized_server_module_is_skipped(monkeypatch):
+    mod = types.ModuleType("tui_gateway.server")  # no _methods/_sessions yet, like mid-import
+    spec = importlib.machinery.ModuleSpec("tui_gateway.server", None)
+    spec._initializing = True
+    mod.__spec__ = spec
+    monkeypatch.setitem(sys.modules, "tui_gateway.server", mod)
+    assert root_conftest._tui_server_importing(mod) is True
+    gen = _fixture_body()()
+    next(gen)  # setup must not touch the missing globals
+    try:
+        next(gen)  # teardown must not either
+    except StopIteration:
+        pass
+    # Left "initializing" so the outer autouse fixture's own teardown is exercised too.
+
+
+def test_fully_initialized_module_is_not_skipped():
+    mod = types.ModuleType("x")
+    mod.__spec__ = importlib.machinery.ModuleSpec("x", None)
+    assert root_conftest._tui_server_importing(mod) is False
