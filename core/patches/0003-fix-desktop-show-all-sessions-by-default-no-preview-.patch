From 25959a5f8eaccae7f3e27b8be39c824c2719a2d6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 11 Oct 2026 12:06:37 -0700
Subject: [PATCH] fix(desktop): show all sessions by default, no preview cap
 [daveey]

---
 .../app/chat/sidebar/projects/overview-row.test.tsx |  8 +++++++-
 .../app/chat/sidebar/projects/workspace-group.tsx   |  8 ++++----
 apps/desktop/src/store/layout-sidebar-view.test.ts  | 13 +++++++------
 apps/desktop/src/store/layout.ts                    |  6 +++---
 4 files changed, 21 insertions(+), 14 deletions(-)

diff --git a/apps/desktop/src/app/chat/sidebar/projects/overview-row.test.tsx b/apps/desktop/src/app/chat/sidebar/projects/overview-row.test.tsx
index 0bd689a5c5..5b022000ff 100644
--- a/apps/desktop/src/app/chat/sidebar/projects/overview-row.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/projects/overview-row.test.tsx
@@ -1,8 +1,9 @@
 import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
 import type { ReactNode } from 'react'
-import { afterEach, describe, expect, it, vi } from 'vitest'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
 
 import type { SessionInfo } from '@/hermes'
+import { $sidebarShowAllSessions } from '@/store/layout'
 import type * as ProjectsStore from '@/store/projects'
 
 import type * as Model from './model'
@@ -63,6 +64,11 @@ const project = { id: 'p1', label: 'Test D' } as unknown as SidebarProjectTree
 
 const session = (id: string, updated: number): SessionInfo => ({ id, updated_at: updated }) as unknown as SessionInfo
 
+// These cover the preview-capped mode ("Show all sessions" off).
+beforeEach(() => {
+  $sidebarShowAllSessions.set(false)
+})
+
 describe('ProjectOverviewRow', () => {
   afterEach(() => {
     workspaceOpen.value = false
diff --git a/apps/desktop/src/app/chat/sidebar/projects/workspace-group.tsx b/apps/desktop/src/app/chat/sidebar/projects/workspace-group.tsx
index 32c79bbf7c..fbabaa8fd1 100644
--- a/apps/desktop/src/app/chat/sidebar/projects/workspace-group.tsx
+++ b/apps/desktop/src/app/chat/sidebar/projects/workspace-group.tsx
@@ -71,10 +71,10 @@ export function SidebarWorkspaceGroup({
   // A profile previews the same handful a project does, and clicking its label
   // is how you see the rest. Workspace groups page within what's loaded unless
   // the user asked for everything.
-  const visibleSessions = isProfileGroup
-    ? sessions.slice(0, PROJECT_PREVIEW_COUNT)
-    : showAllSessions
-      ? sessions
+  const visibleSessions = showAllSessions
+    ? sessions
+    : isProfileGroup
+      ? sessions.slice(0, PROJECT_PREVIEW_COUNT)
       : lane.shown
 
   const nextCount = isProfileGroup || showAllSessions ? 0 : lane.more
diff --git a/apps/desktop/src/store/layout-sidebar-view.test.ts b/apps/desktop/src/store/layout-sidebar-view.test.ts
index 29f2747012..fa54c5b4b4 100644
--- a/apps/desktop/src/store/layout-sidebar-view.test.ts
+++ b/apps/desktop/src/store/layout-sidebar-view.test.ts
@@ -25,20 +25,21 @@ beforeEach(() => {
 
 describe('the sidebar as it ships', () => {
   it('remembers expanded project previews across grouping changes and clears them on reset', () => {
-    expect($sidebarShowAllSessions.get()).toBe(false)
+    // Local default: show every session (no "..." preview cap).
+    expect($sidebarShowAllSessions.get()).toBe(true)
     setSidebarGrouping('project')
-    setSidebarShowAllSessions(true)
+    setSidebarShowAllSessions(false)
     setSidebarGrouping('date')
 
-    expect($sidebarShowAllSessions.get()).toBe(true)
+    expect($sidebarShowAllSessions.get()).toBe(false)
     expect($sidebarViewCustomized.get()).toBe(true)
-    expect(window.localStorage.getItem('hermes.desktop.sidebarShowAllSessions')).toBe('true')
+    expect(window.localStorage.getItem('hermes.desktop.sidebarShowAllSessions')).toBe('false')
 
     resetSidebarView()
 
-    expect($sidebarShowAllSessions.get()).toBe(false)
+    expect($sidebarShowAllSessions.get()).toBe(true)
     expect($sidebarViewCustomized.get()).toBe(false)
-    expect(window.localStorage.getItem('hermes.desktop.sidebarShowAllSessions')).toBe('false')
+    expect(window.localStorage.getItem('hermes.desktop.sidebarShowAllSessions')).toBe('true')
   })
 
   it('offers no reset until something actually moves off the defaults', () => {
diff --git a/apps/desktop/src/store/layout.ts b/apps/desktop/src/store/layout.ts
index 8b8e542115..0bb0c51bc7 100644
--- a/apps/desktop/src/store/layout.ts
+++ b/apps/desktop/src/store/layout.ts
@@ -353,7 +353,7 @@ export const $sidebarRowMeta = modeBound('sidebarRowMeta', $sidebarRowMetaPref,
 export const $sidebarCardRows = persistentAtom(SIDEBAR_CARD_ROWS_STORAGE_KEY, false, Codecs.bool)
 
 /** Project overview: two complete recency groups instead of three preview rows. */
-export const $sidebarShowAllSessions = persistentAtom(SIDEBAR_SHOW_ALL_SESSIONS_STORAGE_KEY, false, Codecs.bool)
+export const $sidebarShowAllSessions = persistentAtom(SIDEBAR_SHOW_ALL_SESSIONS_STORAGE_KEY, true, Codecs.bool)
 
 export function setSidebarShowAllSessions(on: boolean) {
   $sidebarShowAllSessions.set(on)
@@ -439,7 +439,7 @@ export const $sidebarViewCustomized: ReadableAtom<boolean> = computed(
     ordering !== SIDEBAR_DEFAULT_ORDERING ||
     !sameRowMeta(rowMeta, SIDEBAR_DEFAULT_ROW_META) ||
     cardRows ||
-    showAllSessions ||
+    !showAllSessions ||
     filtersActive
 )
 
@@ -947,7 +947,7 @@ export function resetSidebarView() {
   setSidebarOrdering(SIDEBAR_DEFAULT_ORDERING)
   $sidebarRowMeta.set(SIDEBAR_DEFAULT_ROW_META)
   $sidebarCardRows.set(false)
-  $sidebarShowAllSessions.set(false)
+  $sidebarShowAllSessions.set(true)
   clearSidebarFilters()
 }
 
-- 
