From 83064d7988ea49743f3e3a3f8354a9d86bb44544 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 22:24:19 +0000
Subject: [PATCH] fix(tui_gateway): use rebound legacy display classifier
 [daveey]

Why: the automation-holder takeover reader imported a raw split-module helper, violating the facade binding invariant and turning main CI red. Route its legacy-prefix classification through server so globals follow method_ctx binding. No behavior or guard relaxation.

Proof: canonical split-module suite reproduced 1 failure before the fix; split-module, automation-holder takeover and update-pause ledger suites pass 45 tests after it. scripts/check --base origin/main passes.
---
 tui_gateway/session_lifecycle.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/tui_gateway/session_lifecycle.py b/tui_gateway/session_lifecycle.py
index 723b5b865e..1f480ec062 100644
--- a/tui_gateway/session_lifecycle.py
+++ b/tui_gateway/session_lifecycle.py
@@ -156,9 +156,9 @@ def latest_user_turn_kind(conn, session_key: str) -> str | None:
         return None
     if row[0]:
         return row[0]
-    # Imported functions are not rebound onto server.py (method_ctx.bind_module): import here.
-    from tui_gateway.session_history import _legacy_display_kind
-    return _legacy_display_kind("user", row[1] or "") if isinstance(row[1], str) else None
+    # Split-module helpers must use the facade's rebound globals.
+    from tui_gateway import server
+    return server._legacy_display_kind("user", row[1] or "") if isinstance(row[1], str) else None
 
 
 def _automation_holder_kind(session: dict) -> str | None:
-- 
