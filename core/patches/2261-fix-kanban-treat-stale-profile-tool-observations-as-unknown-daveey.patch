From d61c47182ddb84175b635556b2282560340540cc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 02:02:06 +0000
Subject: [PATCH] fix(kanban): treat stale profile tool observations as unknown
 [daveey]

---
 hermes_cli/kanban_placement.py                |  6 ++--
 .../test_kanban_stale_profile_tools.py        | 31 +++++++++++++++++++
 2 files changed, 35 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_stale_profile_tools.py

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 4d12061fb58..f7c7db6597f 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -252,9 +252,11 @@ def target_info(target: str, *, now: float, remote: Optional[dict] = None) -> di
         name = c["name"]
         if not name.startswith(prefix):
             continue
-        tools = {} if tools is None else tools
         raw = c.get("checked_at")
-        if not c.get("ok") or isinstance(raw, bool) or not isinstance(raw, (int, float)) or now - raw > limit:
+        if isinstance(raw, bool) or not isinstance(raw, (int, float)) or not 0 <= now - raw <= limit:
+            continue
+        tools = {} if tools is None else tools
+        if not c.get("ok"):
             continue
         _, prof, tool = name.split(":", 2)
         tools.setdefault(prof, set()).add(tool)
diff --git a/tests/hermes_cli/test_kanban_stale_profile_tools.py b/tests/hermes_cli/test_kanban_stale_profile_tools.py
new file mode 100644
index 00000000000..7093a76f3c4
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_stale_profile_tools.py
@@ -0,0 +1,31 @@
+"""Stale remote observations are unknown, not affirmative tool absence."""
+import pytest
+
+from hermes_cli import kanban_placement as kp
+from hermes_cli import kanban_runs_on_capabilities as rc
+
+
+@pytest.mark.parametrize("checked", [0, True, None, "bad", float("nan"), float("inf"), 10001])
+def test_stale_or_invalid_tools_allow_move_but_leave_claim_gate(monkeypatch, checked):
+    monkeypatch.setattr(kp.reg, "remote_gateway_profiles", lambda _: ["default"])
+    monkeypatch.setattr(kp.reg, "stale_after", lambda: 1800)
+    record = {"worker": {"schema": 1, "capabilities": [
+        {"name": "profile-tools:default:terminal", "ok": True, "checked_at": checked}]}}
+    info = kp.target_info("worker", now=10000, remote=record)
+    assert info["tools"] is None
+    got = rc.check(["machine:worker"], assignee="default", requires=["terminal", "file", "git"],
+                   me="hub", exclude_me=True, machines={"worker": {"state": "active"}},
+                   remote_tools=lambda _: info["tools"])
+    assert got == {"worker": None}
+
+
+def test_fresh_negative_still_refuses_missing_tools(monkeypatch):
+    monkeypatch.setattr(kp.reg, "remote_gateway_profiles", lambda _: ["default"])
+    monkeypatch.setattr(kp.reg, "stale_after", lambda: 1800)
+    record = {"worker": {"schema": 1, "capabilities": [
+        {"name": "profile-tools:default:terminal", "ok": False, "checked_at": 9999}]}}
+    info = kp.target_info("worker", now=10000, remote=record)
+    assert info["tools"] == {}
+    with pytest.raises(rc.PlacementCapabilityMismatch):
+        rc.check(["machine:worker"], assignee="default", requires=["terminal"], me="hub",
+                 machines={"worker": {"state": "active"}}, remote_tools=lambda _: info["tools"])
-- 
