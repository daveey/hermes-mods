From 839e5d768d7bd04a1a32fae273ef67d46dbc448b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 02:14:26 +0000
Subject: [PATCH] [daveey] kanban_singleton: code-health waivers and logged
 fail-open probes

---
 gateway/kanban_singleton.py            | 10 +++++-----
 gateway/kanban_watchers.py             |  4 ++--
 hermes_cli/kanban.py                   |  9 +++++----
 hermes_cli/kanban_db_dispatch_stuck.py |  2 +-
 4 files changed, 13 insertions(+), 12 deletions(-)

diff --git a/gateway/kanban_singleton.py b/gateway/kanban_singleton.py
index 90ac7ec35f0..13e90823844 100644
--- a/gateway/kanban_singleton.py
+++ b/gateway/kanban_singleton.py
@@ -49,7 +49,7 @@ def is_root_gateway() -> bool:
         from hermes_cli.kanban_db import kanban_home
         from hermes_constants import get_hermes_home
         return _resolve(get_hermes_home()) == _resolve(kanban_home())
-    except Exception:
+    except Exception:  # health: allow BLE001 -- cannot tell -> pre-lease behaviour (no deference)
         return True  # can't tell -> behave like the pre-lease code (no deference)
 
 
@@ -66,7 +66,7 @@ def _pid_alive(pid: int) -> bool:
     try:
         from gateway.status import _pid_exists
         return bool(_pid_exists(pid))
-    except Exception:
+    except Exception:  # health: allow BLE001 -- liveness probe: any failure reads as not alive
         return False
 
 
@@ -313,7 +313,7 @@ def is_root_home(home: Optional[str]) -> bool:
     try:
         from hermes_cli.kanban_db import kanban_home
         return _resolve(Path(home)) == _resolve(kanban_home())
-    except Exception:
+    except Exception:  # health: allow BLE001 -- an unresolvable home is simply not the root
         return False
 
 
@@ -326,7 +326,7 @@ def root_expected_locks() -> list[Path]:
         from hermes_cli.config_backend import config_exists, read_config_doc_readonly
         path = kanban_home() / "config.yaml"
         kanban = ((read_config_doc_readonly(path) if config_exists(path) else None) or {}).get("kanban") or {}
-    except Exception:
+    except Exception:  # health: allow BLE001 -- an unreadable root config means default locks; never block resume
         kanban = {}
     if kanban.get("dispatch_in_gateway", True):
         locks.append(root / ".dispatcher.lock")
@@ -345,7 +345,7 @@ def wait_for_root_locks(pid: int, *, timeout: float = ROOT_LOCK_WAIT_SECONDS, lo
     """
     try:
         paths = root_expected_locks() if locks is None else [Path(p) for p in locks]
-    except Exception:
+    except Exception:  # health: allow BLE001 -- probe must never raise into the updater's resume
         return []
     sleep = sleep or time.sleep
     clock = clock or time.monotonic
diff --git a/gateway/kanban_watchers.py b/gateway/kanban_watchers.py
index 78cc1f03d51..96911c1581c 100644
--- a/gateway/kanban_watchers.py
+++ b/gateway/kanban_watchers.py
@@ -342,7 +342,7 @@ class GatewayKanbanWatchersMixin:
                     pids = await _to_thread_process_service(_kbd.reap_worker_zombies)
                     if pids:
                         logger.info("kanban dispatcher: reaped %d zombie worker(s), pids=%s", len(pids), pids)
-                except Exception:
+                except Exception:  # health: allow BLE001 -- moved unchanged: zombie reaper failure is logged with traceback
                     logger.exception("kanban dispatcher: zombie reaper failed")
 
                 try:
@@ -406,7 +406,7 @@ class GatewayKanbanWatchersMixin:
                 except asyncio.CancelledError:
                     logger.debug("kanban dispatcher: cancelled")
                     raise
-                except Exception:
+                except Exception:  # health: allow BLE001 -- moved unchanged: one tick's failure never stops the next (logged with traceback)
                     health.invalidate()
                     logger.exception("kanban dispatcher: unexpected watcher error")
 
diff --git a/hermes_cli/kanban.py b/hermes_cli/kanban.py
index cd73bd7a99c..f9c210a73db 100644
--- a/hermes_cli/kanban.py
+++ b/hermes_cli/kanban.py
@@ -9,6 +9,7 @@ from __future__ import annotations
 import argparse
 import contextlib
 import json
+import logging
 import os
 import re
 import shlex
@@ -141,8 +142,8 @@ def _check_dispatcher_presence(hermes_home: Optional[Path] = None) -> tuple[bool
         holder = holder_info(kanban_home() / "kanban" / ".dispatcher.lock")
         if holder:
             return (True, f"host dispatcher: {describe_holder(holder)}")
-    except Exception:
-        pass
+    except Exception:  # health: allow BLE001 -- fails open like the rest of this probe
+        logging.getLogger(__name__).debug("dispatcher presence: host lock probe failed", exc_info=True)
     try:
         from gateway.status import resolve_gateway_liveness  # type: ignore
 
@@ -1614,8 +1615,8 @@ def _host_lock_holders() -> dict:
         root = kb.kanban_home() / "kanban"
         for name in ("dispatcher", "sync"):
             out[name] = holder_info(root / f".{name}.lock")
-    except Exception:
-        pass
+    except Exception:  # health: allow BLE001 -- stats must print even when the lock probe can't run
+        logging.getLogger(__name__).debug("kanban stats: host lock probe failed", exc_info=True)
     return out
 
 
diff --git a/hermes_cli/kanban_db_dispatch_stuck.py b/hermes_cli/kanban_db_dispatch_stuck.py
index d1e68ea1832..a6572cd7d36 100644
--- a/hermes_cli/kanban_db_dispatch_stuck.py
+++ b/hermes_cli/kanban_db_dispatch_stuck.py
@@ -68,7 +68,7 @@ def cap_source(capacity: str) -> str:
     try:
         from hermes_constants import get_hermes_home
         config = f"{get_hermes_home()}/config.yaml"
-    except Exception:
+    except Exception:  # health: allow BLE001 -- cap source is decoration on a warning line; never break the warning
         config = "config.yaml"
     if capacity.startswith("max_in_progress="):
         from hermes_cli.kanban_db_dispatch import configured_max_in_progress
-- 
2.55.0

