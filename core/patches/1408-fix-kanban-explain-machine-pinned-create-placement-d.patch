From e3bd1c8cd1f5259174d995bc9f170d93d4567f53 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 05:11:38 +0000
Subject: [PATCH] fix(kanban): explain machine-pinned create placement [daveey]

---
 hermes_cli/kanban_placement.py              |  5 +++++
 tests/hermes_cli/test_kanban_worker_node.py | 11 ++++++++---
 tools/kanban_tools.py                       |  4 ++--
 tools/kanban_tools_placement.py             |  9 +++++++++
 4 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 6cb1a22b7ce..84bcc12858a 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -121,6 +121,11 @@ LOCAL_MARKER_REMEDY = (
 PINNED_LOCAL_WHY = "placement pinned local by the caller"
 
 
+def pinned_machine_why(machine: str) -> str:
+    """Explain a machine pin without implying that the card executes on the creating gateway."""
+    return f"placement pinned to machine {machine} (runs there through the Board lease)"
+
+
 def local_pin_note(target: str) -> str:
     """Result note for a placement='local' pin whose card would run on ``target`` without it. [daveey]"""
     return ("placement='local' was pinned, but nothing in the card names a machine-only need; without the pin "
diff --git a/tests/hermes_cli/test_kanban_worker_node.py b/tests/hermes_cli/test_kanban_worker_node.py
index 283d0507728..3def8abbd5f 100644
--- a/tests/hermes_cli/test_kanban_worker_node.py
+++ b/tests/hermes_cli/test_kanban_worker_node.py
@@ -161,18 +161,23 @@ def _tool_create(args):
     return json.loads(kanban_tools._handle_create(args))
 
 
-def test_tool_create_runs_on_and_placement_to_an_enrolled_machine(gws, monkeypatch):
+def test_tool_create_runs_on_and_placement_to_an_enrolled_machine(gws, monkeypatch, caplog):
     hub, _ = gws
     hub.enter()
     monkeypatch.setattr("hermes_cli.kanban_capability_registry.self_gateway", lambda: HUB)
-    out = _tool_create({"title": "on the worker", "assignee": "default", "placement": WORKER})
+    with caplog.at_level("INFO", logger="tools.kanban_tools_placement"):
+        out = _tool_create({"title": "on the worker", "assignee": "default", "placement": WORKER})
     assert out.get("ok", True) and "error" not in out, out
     tid = out["task_id"]
     row = hub.conn.execute("SELECT runs_on, created_on FROM tasks WHERE id = ?", (tid,)).fetchone()
     assert json.loads(row["runs_on"]) == ["machine:worker-1"]  # created here, runs only there
     # The response says so, so a caller doesn't read the pin as ignored and re-create the card.
     assert out["runs_on"] == ["machine:worker-1"]
-    assert out["placement"] == {"where": "local", "runs_on": ["machine:worker-1"], "machine": WORKER}
+    why = f"placement pinned to machine {WORKER} (runs there through the Board lease)"
+    assert out["placement"]["why"] == why
+    assert out["placement"] == {"where": "local", "runs_on": ["machine:worker-1"], "machine": WORKER, "why": why}
+    assert f"kanban placement: local, runs_on ['machine:worker-1'] ({why})" in caplog.messages
+    assert "nothing in the card names a machine-only need" not in out["note"]
     assert "runs on " + WORKER + " via the board lease" in out["note"] and tid in out["note"]
     out = _tool_create({"title": "explicit", "assignee": "default", "runs_on": ["linux"]})
     # No machine pin: no machine placement block, only the plain local reason every local card carries.
diff --git a/tools/kanban_tools.py b/tools/kanban_tools.py
index d96fb0fc870..c70408f8881 100644
--- a/tools/kanban_tools.py
+++ b/tools/kanban_tools.py
@@ -21,7 +21,7 @@ from tools.registry import no_cache_check_fn, registry, tool_error
 from hermes_cli.config import cfg_get, load_config
 from hermes_cli.kanban_capabilities import check_tool_create, declaration_required
 from hermes_cli import kanban_contract_cli as _contract_cli, kanban_overlap, kanban_reason_comment as krc
-from tools.kanban_tools_placement import (_local_placement, _marker_placement_fields, _persisted_session_id,
+from tools.kanban_tools_placement import (_local_placement, _machine_placement, _marker_placement_fields, _persisted_session_id,
                                           _placement_refused, _runs_where)
 from tools.kanban_tools_db_hint import generic_tool_error
 from tools.kanban_tools_park_args import _blocker_id_arg, _clear_blocker_arg
@@ -1808,7 +1808,7 @@ def _handle_create(args: dict, **kw) -> str:
             # and a caller that archives and re-creates it makes a duplicate. [daveey]
             extra["runs_on"] = runs_on
             if pinned_machine:
-                extra["placement"] = {"where": "local", "runs_on": runs_on, "machine": pinned_machine}
+                extra["placement"] = _machine_placement(pinned_machine, runs_on)
                 extra["note"] = (f"Created here as {new_tid}; it runs on {pinned_machine} via the board lease "
                                  f"(runs_on={runs_on}). The pin was honoured: do not re-create it.")
         # Every result says where the card runs (a caller that can't tell re-creates it or never learns it is stranded)
diff --git a/tools/kanban_tools_placement.py b/tools/kanban_tools_placement.py
index 9c476fec1de..587cffd435f 100644
--- a/tools/kanban_tools_placement.py
+++ b/tools/kanban_tools_placement.py
@@ -95,6 +95,15 @@ def _marker_placement_fields(conn, new_tid: str, marker_placement: Optional[dict
     return out
 
 
+def _machine_placement(machine: str, runs_on: list[str]) -> dict:
+    """Preserve the machine pin's reason when replacing the rewritten local-pin decision. [daveey]"""
+    from hermes_cli.kanban_placement import pinned_machine_why
+
+    why = pinned_machine_why(machine)
+    logger.info("kanban placement: local, runs_on %s (%s)", runs_on, why)
+    return {"where": "local", "runs_on": runs_on, "machine": machine, "why": why}
+
+
 def _runs_where(runs_on, pinned_machine, marker_placement) -> str:
     """Where a card created on this board runs, for the kanban_create result. Never raises."""
     if runs_on is not None:
-- 
