diff --git a/.github/workflows/plugin-catalog-ci.yml b/.github/workflows/plugin-catalog-ci.yml
index 8e54e2081d9..d6b8df7da01 100644
--- a/.github/workflows/plugin-catalog-ci.yml
+++ b/.github/workflows/plugin-catalog-ci.yml
@@ -9,6 +9,23 @@ name: Plugin Catalog CI
 #                            reachable in the entry's repo, and the plugin
 #                            at that exact commit must pass
 #                            `hermes plugins validate`.
+#
+# Trusted base, untrusted data. A PR's catalog files are the only thing either
+# job takes from the PR, and only as bytes: each job reads them out of the PR
+# merge commit's tree into $RUNNER_TEMP as regular files, deletes the PR
+# checkout, and checks out the merge commit's first parent (the base branch tip
+# GitHub merged into) in its place. Everything the gate executes after that
+# (the structural validator, the setup-pm and retry actions, the PM-built
+# hermes, the sandbox wrapper, the payload scanner) is the base's, so a PR can
+# neither rewrite the validator that judges its own entries nor run its own
+# scanner, action or core outside the sandbox. Limit: this workflow file itself
+# runs from the PR (pull_request event), so a PR editing it is stopped only by
+# review of the workflow, not by anything here.
+#
+# Bootstrap: each job's "Confirm the trusted checkout" lists the tools it will
+# run and fails if the base lacks one, never falling back to the PR's copy. A
+# PR that adds a tool (the sandbox wrapper, say) changes no entry, so neither
+# job runs that tool for it; entry PRs need a base that already has it.
 
 on:
   pull_request:
@@ -27,8 +44,87 @@ jobs:
     steps:
       - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a  # v7.0.1 (fork: upstream uses useblacksmith/checkout)
         with:
+          # The merge commit and its first parent, the trusted base.
+          fetch-depth: 2
           persist-credentials: false # this job is read-only
 
+      - name: Export the PR's catalog data
+        id: data
+        run: |
+          set -euo pipefail
+          if ! git rev-parse -q --verify 'HEAD^2' >/dev/null; then
+            echo "::error::expected the pull_request merge commit as HEAD"
+            exit 1
+          fi
+          # Every file under plugin-catalog/ in the merged tree, read from the
+          # tree (never the worktree) and written as a regular file. A symlink
+          # or submodule there would have the validator read something other
+          # than the bytes that land, so it fails here instead.
+          DATA="${RUNNER_TEMP:?}/catalog-data"
+          rm -rf -- "$DATA"
+          mkdir -p -- "$DATA/plugin-catalog"
+          LIST=$(mktemp)
+          git ls-tree -r -z --full-tree \
+            --format='%(objectmode) %(objecttype) %(objectname)%x09%(path)' HEAD -- plugin-catalog/ > "$LIST"
+          BAD=0
+          while IFS= read -r -d '' rec; do
+            meta=${rec%%$'\t'*} path=${rec#*$'\t'}
+            case "/$path/" in */../*|*/./*|*//*) BAD=1; continue ;; esac
+            case "$meta" in
+              "100644 blob "*|"100755 blob "*)
+                mkdir -p -- "$DATA/$(dirname -- "$path")"
+                git cat-file blob "${meta##* }" > "$DATA/$path" ;;
+              *) BAD=1 ;;
+            esac
+          done < "$LIST"
+          rm -f -- "$LIST"
+          if [ "$BAD" -ne 0 ]; then
+            echo "::error::plugin-catalog/ may only hold regular files"
+            exit 1
+          fi
+          {
+            echo "base=$(git rev-parse 'HEAD^1')"
+            echo "dir=$DATA/plugin-catalog"
+          } >> "$GITHUB_OUTPUT"
+
+      - name: Drop the PR checkout
+        run: |
+          set -euo pipefail
+          # Nothing of the PR may stay where the gate executes from; its catalog
+          # bytes were exported above.
+          find "${GITHUB_WORKSPACE:?}" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
+
+      - name: Check out the trusted base
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a  # v7.0.1 (fork: upstream uses useblacksmith/checkout)
+        with:
+          ref: ${{ steps.data.outputs.base }}
+          persist-credentials: false
+
+      - name: Confirm the trusted checkout
+        env:
+          TRUSTED_BASE: ${{ steps.data.outputs.base }}
+          # Every workspace file this job executes.
+          TRUSTED_TOOLS: scripts/validate_plugin_catalog.py .github/actions/retry/action.yml
+        run: |
+          set -euo pipefail
+          if [ "$(git rev-parse HEAD)" != "${TRUSTED_BASE:?}" ] \
+              || [ -n "$(git status --porcelain --ignored --untracked-files=all)" ]; then
+            echo "::error::the workspace is not exactly the trusted base $TRUSTED_BASE"
+            exit 1
+          fi
+          # Bootstrap: a base from before a tool was added cannot run it, and
+          # the PR's copy is never a fallback. The PR that adds a tool changes
+          # no entry, so it never reaches the step that runs it; an entry PR on
+          # an older base fails here and passes once rebased.
+          MISSING=""
+          for tool in ${TRUSTED_TOOLS:?}; do
+            if [ -L "$tool" ] || [ ! -f "$tool" ]; then MISSING="$MISSING $tool"; fi
+          done
+          if [ -n "$MISSING" ]; then
+            echo "::error::the trusted base $TRUSTED_BASE predates this gate (missing:$MISSING); rebase the PR onto its base branch"
+            exit 1
+          fi
+
       - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
         with:
           python-version: "3.11"
@@ -39,22 +135,29 @@ jobs:
           command: pip install ruamel.yaml==0.18.17
 
       - name: Validate catalog files (structural)
+        env:
+          CATALOG_DATA: ${{ steps.data.outputs.dir }}
         run: |
           set -euo pipefail
-          # Validating the whole directory is simpler than diffing and keeps
-          # the invariant that EVERYTHING in plugin-catalog/ stays valid.
-          python3 scripts/validate_plugin_catalog.py plugin-catalog/
+          # The base's validator over the PR's exported catalog. Validating the
+          # whole directory keeps the invariant that EVERYTHING in
+          # plugin-catalog/ stays valid.
+          python3 -I scripts/validate_plugin_catalog.py "${CATALOG_DATA:?}/"
 
