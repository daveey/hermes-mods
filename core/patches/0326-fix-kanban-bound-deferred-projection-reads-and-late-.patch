From 57989636f5e4cceab5fe1b24a8858dbb1c3cd7d6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 25 Oct 2026 19:41:42 +0000
Subject: [PATCH] fix(kanban): bound deferred projection reads and late
 publication [daveey]

---
 .../src/store/native-notifications.test.ts    | 34 +++++++++++++++++++
 .../desktop/src/store/native-notifications.ts | 18 ++++++++--
 2 files changed, 50 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/store/native-notifications.test.ts b/apps/desktop/src/store/native-notifications.test.ts
index 3dba369724..9f93d49b3a 100644
--- a/apps/desktop/src/store/native-notifications.test.ts
+++ b/apps/desktop/src/store/native-notifications.test.ts
@@ -249,6 +249,40 @@ describe('dispatchNativeNotification focus gating', () => {
     }
   })
 
+  it('bounds a hung projection refresh and prevents its late publication', async () => {
+    vi.useFakeTimers()
+    const runtime = freshSession()
+    const stored = `${runtime}-stored`
+    publishSessionState(runtime, createClientSessionState(stored))
+    setActiveSessionId(runtime)
+    const endedAt = Date.now() / 1000
+    let oldMayPublish: (() => boolean) | undefined
+
+    const refreshProjection = vi.fn()
+      .mockImplementationOnce((mayPublish?: () => boolean) => {
+        oldMayPublish = mayPublish
+
+        return new Promise<void>(() => {})
+      })
+      .mockImplementation(async () => {
+        setSessions([{ id: stored, profile: 'default', kanban_observed_at: Date.now() / 1000 } as never])
+      })
+
+    try {
+      setSessions([{ id: stored, profile: 'default', kanban_unknown: true } as never])
+      dispatchNativeNotification({ kind: 'turnDone', sessionId: runtime, title: 'done',
+        projectionAfter: endedAt, refreshProjection })
+      await vi.advanceTimersByTimeAsync(45000)
+      expect(refreshProjection).toHaveBeenCalledTimes(2)
+      expect(oldMayPublish?.()).toBe(false)
+      expect(notify).toHaveBeenCalledTimes(1)
+    } finally {
+      dropSessionState(runtime)
+      setSessions([])
+      vi.useRealTimers()
+    }
+  })
+
   it('retains a missing projection using the independently recorded runtime owner', () => {
     const runtime = freshSession()
     const stored = `${runtime}-stored`
diff --git a/apps/desktop/src/store/native-notifications.ts b/apps/desktop/src/store/native-notifications.ts
index 31940cf0b7..2f094e0b98 100644
--- a/apps/desktop/src/store/native-notifications.ts
+++ b/apps/desktop/src/store/native-notifications.ts
@@ -201,7 +201,7 @@ export interface NativeNotificationInput {
   /** Wait for an origin projection observed after this turn ended (epoch seconds). */
   projectionAfter?: number
   /** Existing session-list refresh, retained for background release checks. */
-  refreshProjection?: () => Promise<void>
+  refreshProjection?: (shouldPublish?: () => boolean) => Promise<void>
   /**
    * Not tied to a chat session (e.g. pet generation). Fires whenever the user
    * is away, bypassing the session-match gate that completion kinds normally
@@ -324,7 +324,21 @@ function deferCompletion(input: NativeNotificationInput, storedId: string, owner
     }
 
     const callbacks = new Set([...deferredCompletions.values()].map(p => p.input.refreshProjection))
-    await Promise.allSettled([...callbacks].filter(Boolean).map(callback => Promise.resolve().then(() => callback?.())))
+    // refreshSessions already accepts a publication guard. Time out this read
+    // without allowing a late page to overwrite a newer retry or owner state.
+    let current = true
+    let deadline: ReturnType<typeof setTimeout> | undefined
+
+    try {
+      await Promise.race([
+        Promise.allSettled([...callbacks].filter(Boolean).map(callback =>
+          Promise.resolve().then(() => callback?.(() => current && !stopped)))),
+        new Promise<void>(resolve => { deadline = setTimeout(resolve, 15000) })
+      ])
+    } finally {
+      current = false
+      clearTimeout(deadline)
+    }
 
     if (!stopped) {
       retry()
-- 
2.55.0

