+        # callers a pending origin bound to this execution, filled when it settles.
         if len(self._pending) >= MAX_PENDING:
             self._settle()
         self._pending.append(entry)
@@ -1707,6 +1732,14 @@
             raise
         finally:
             self._tls.busy = busy
+            if entry[4]:
