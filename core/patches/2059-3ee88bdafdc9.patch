From 3ee88bdafdc9e307e7043b8dd5930195e34f8351 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 9 Nov 2026 02:18:43 +0000
Subject: [PATCH] test: pin relay FIFO policy and await published busy agent
 [daveey]

---
 tests/gateway/test_relay_authority.py | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/tests/gateway/test_relay_authority.py b/tests/gateway/test_relay_authority.py
index 13ccfaae28c..0871f0cb3a8 100644
--- a/tests/gateway/test_relay_authority.py
+++ b/tests/gateway/test_relay_authority.py
@@ -39,7 +39,7 @@ async def probe(peer):
     from gateway.run_api import start_gateway_api, stop_gateway_api
     from gateway.session_authority import initialize_session_authority
     from gateway.session_contract import SessionRef
-    from gateway.session_envelope import prepare_native, restore_native
+    from gateway.session_envelope import prepare_native, restore_native, restore_native_source
     from hermes_cli import web_server
     from hermes_state_runtime import RuntimeStoreError, list_session_admissions
     from tests.waiting import async_wait_until
@@ -178,6 +178,13 @@ async def probe(peer):
                 blocked.update(message_id='relay-3', text='BLOCK_FIFO')
                 await connector_ws.send(json.dumps({'type': 'inbound', 'event': blocked}) + '\n')
                 assert await asyncio.to_thread(peer.blocked.wait, PROGRESS_TIMEOUT)
+                # The model thread can enter before the loop publishes its agent.
+                # Exercise busy routing with the real agent, not the startup sentinel
+                # (which bypasses redirect/steer regardless of the configured mode).
+                key = runner._session_key_for_source(restore_native_source(rows[0]['payload']))
+                await async_wait_until(lambda: (state := runner._peek_session_state(key)) is not None
+                                       and state.turn.agent is warm_agent,
+                                       timeout=PROGRESS_TIMEOUT, what='the blocked agent published for busy routing')
                 queued = deepcopy(raw)
                 queued.update(message_id='relay-4', text='QUEUED_AFTER_BLOCK')
                 await connector_ws.send(json.dumps({'type': 'inbound', 'event': queued}) + '\n')
@@ -281,6 +288,8 @@ def main():
     os.environ.update(OPENAI_API_KEY='loopback-only', OPENAI_BASE_URL=url)
     Path(os.environ['HERMES_HOME'], 'config.yaml').write_text(
         f'model:\n  default: local-wire-stub\n  provider: custom\n  base_url: {url}\n'
+        # This scenario asserts separate FIFO turns, not live-turn redirect/steer.
+        'display:\n  busy_input_mode: queue\n'
         'streaming:\n  enabled: false\nauxiliary:\n  title_generation:\n    enabled: false\n')
     try:
         asyncio.run(probe(peer))
-- 
