diff --git a/tests/test_scratch_dir.py b/tests/test_scratch_dir.py
index 2472b026c6..d8fec23a8f 100644
--- a/tests/test_scratch_dir.py
+++ b/tests/test_scratch_dir.py
@@ -244,8 +244,13 @@ def test_prune_reaps_process_living_in_idle_entry_and_spares_live_tree(tmp_path)
     sleeper = [sys.executable, "-c", "import time; time.sleep(60)"]
     doomed = subprocess.Popen(sleeper, cwd=str(idle), stdin=subprocess.DEVNULL)
     spared = subprocess.Popen(sleeper, cwd=str(live), stdin=subprocess.DEVNULL)
+    import psutil
+
+    # Scan real children, not unrelated host workers protected by the home-I/O guard.
+    children = [psutil.Process(doomed.pid), psutil.Process(spared.pid)]
     try:
-        assert prune_scratch_dir(scratch) == 1
+        with patch("psutil.process_iter", return_value=children):
+            assert prune_scratch_dir(scratch) == 1
         assert doomed.wait(timeout=10) is not None
         assert spared.poll() is None
         assert not idle.parent.exists() and live.exists()
@@ -279,8 +284,13 @@ def test_prune_records_removals_and_kills_in_scratch_prune_log(tmp_path: Path) -
         if os.path.realpath(path) != os.path.realpath(stuck):
             real_rmtree(path, *args, **kwargs)
 
+    import psutil
+
+    children = [psutil.Process(worker.pid)]
     try:
-        with patch("hermes_constants_scratch.shutil.rmtree", rmtree):
+        with patch("hermes_constants_scratch.shutil.rmtree", rmtree), patch(
+            "psutil.process_iter", return_value=children,
+        ):
