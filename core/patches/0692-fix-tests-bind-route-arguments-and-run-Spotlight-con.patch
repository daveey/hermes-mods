Subject: [PATCH] fix(tests): bind route arguments and run Spotlight contracts
 on macOS [daveey]

---
diff --git a/tests/hermes_cli/test_session_detail_malformed_db.py b/tests/hermes_cli/test_session_detail_malformed_db.py
index 88589b7a7590572ca70f68956197fb96c95d138f..b121aeda3245cc3fc2b10eab27c910e394ffa083 100644
--- a/tests/hermes_cli/test_session_detail_malformed_db.py
+++ b/tests/hermes_cli/test_session_detail_malformed_db.py
@@ -14,7 +14,7 @@ A corrupt store is an unavailable store, not an empty one.
 import sqlite3
 
 import pytest
-from fastapi import HTTPException
+from fastapi import HTTPException, Request
 
 from hermes_cli import web_server
 import hermes_cli.web_server_sessions as _web_server_sessions
@@ -86,7 +86,9 @@ async def test_db_is_closed_even_when_corruption_raises(malformed_db):
 async def test_messages_endpoint_reports_corruption(malformed_db):
     with pytest.raises(HTTPException) as excinfo:
         await sessions_router.get_session_messages(
-            "20260830_180820_744f05", None, None, 0, None, False
+            request=Request({"type": "http", "headers": []}),
+            session_id="20260830_180820_744f05", profile=None,
+            limit=None, offset=0, order=None, include_compacted=False,
         )
     assert excinfo.value.status_code == 503
 
diff --git a/tests/pm/test_uv_cache.py b/tests/pm/test_uv_cache.py
index 73c060ac5eedc22a57dcb73790872b0a2ad947c0..956030cb30b266b32eb4bb70e04a15bcb35da582 100644
--- a/tests/pm/test_uv_cache.py
+++ b/tests/pm/test_uv_cache.py
@@ -4,6 +4,8 @@ from __future__ import annotations
 
 
 
+import pytest
+
 import pm.packages as pkgs
 
 
@@ -68,16 +70,15 @@ def test_bundle_uses_shipped_environment_until_an_extension_is_committed(monkeyp
     assert not home.exists(), "selecting shipped dependencies must not copy or mutate them"
 
 
+@pytest.mark.platforms("macos")
 def test_uv_cache_dir_lives_in_a_spotlight_noindex_dir_on_macos(monkeypatch, tmp_path):
     """[daveey] cache/uv is a symlink to cache/uv.noindex on macOS; an existing cache moves intact."""
-    import sys
 
     home = tmp_path / "home"
     (home / "cache" / "uv" / "wheels-v5").mkdir(parents=True)
     (home / "cache" / "uv" / "wheels-v5" / "a.whl").write_text("w", encoding="utf-8")
     import hermes_constants
 
-    monkeypatch.setattr(sys, "platform", "darwin")
     monkeypatch.delenv("HERMES_SPOTLIGHT_INDEX_CACHE", raising=False)
     monkeypatch.setattr(hermes_constants, "get_default_hermes_root", lambda: home)
     import pm.paths as paths_mod
