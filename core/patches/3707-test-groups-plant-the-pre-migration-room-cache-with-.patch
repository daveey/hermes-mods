From 9c459c5d43b787b7ef19ea7f59499c846c94295e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 17:29:09 +0000
Subject: [PATCH] test(groups): plant the pre-migration room cache with the
 driver stopped

test_same_thread_followup_migrates_and_delivers_committed_peer_reply wiped
hosted_room_policy_transcript and its schema-state row while the hosted-room
driver was live. Right after publishing room.activity the room thread runs one
more checkpoint sync. When that sync passed its schema check before the wipe
and read its page after the test appended user-2, it indexed user-2 over the
emptied transcript. Nothing rebuilt it, because the wipe leaves the cursor
alone. A real migration resets the cursor under BEGIN IMMEDIATE, and the page
loop's through_seq check catches that. So @hermes's frozen prompt lost
"@ops: reply from ops" (CI run 43460161350, job 132005114224).

Stop the driver before planting the old cache and start it again afterwards,
the way an upgraded build meets that cache at boot.

Repro: holding the room thread between its schema check and its page read
until the test sends user-2 fails 3/3 on main with the CI assertion. With this
change it passes 3/3, the file passes 37/37, and 36/36 runs pass under a
SIGSTOP/SIGCONT duty cycle.
---
 tests/tui_gateway/test_hosted_room_service.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/tests/tui_gateway/test_hosted_room_service.py b/tests/tui_gateway/test_hosted_room_service.py
index a2a8c7f494..da40f6dfdd 100644
--- a/tests/tui_gateway/test_hosted_room_service.py
+++ b/tests/tui_gateway/test_hosted_room_service.py
@@ -590,6 +590,10 @@ def test_same_thread_followup_migrates_and_delivers_committed_peer_reply(
             for event in service._events("room-1")
         )
     )
+    # Plant the pre-migration cache with the driver stopped, as an upgraded build meets it at boot. A live
+    # room thread can be mid-sync past its schema check and index the next message over the wiped rows;
+    # a real migration resets the cursor under BEGIN IMMEDIATE, which that sync detects, but this wipe does not.
+    assert service.stop(timeout=30.0)
     with sqlite3.connect(db) as conn:
         assert conn.execute(
             """SELECT COUNT(*) FROM hosted_room_policy_transcript
@@ -600,6 +604,7 @@ def test_same_thread_followup_migrates_and_delivers_committed_peer_reply(
             """DELETE FROM hosted_room_policy_transcript_state
                WHERE room_id='room-1'"""
         )
+    service.start()
     service.send(
         room_id="room-1",
         event_id="user-2",
-- 
2.43.0

