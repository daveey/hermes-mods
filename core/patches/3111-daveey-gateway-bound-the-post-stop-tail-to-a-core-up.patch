From 78f3cf981763e9813e50926f4dcc6b1330369a71 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 02:56:49 +0000
Subject: [PATCH] [daveey] gateway: bound the post-stop tail to a core update
 checkpoint's exit promise

The checkpoint ack tells the updater to wait drain_timeout (70s) for the gateway
process to EXIT. stop() was bounded by it, but the tail after stop() (control
socket wait_closed, cron/housekeeping thread waits up to 65s/35s, MCP) was not:
hermes-hub 2026-11-13 the tail ran 44.5s and the process exited 2s past the
updater's wait, deferring the update (t_01a1d2c328159209).

- exit_deadline.set_exit_target: a soft target clamp_wait honours (never os._exit)
- checkpoint_for_update sets it at accept + CHECKPOINT_DRAIN_S - 8s; _cancel_restart clears it
- control socket stop takes a bounded close wait (3s, clamped) instead of waiting on every open connection
- a tail >= 10s logs its phase marks
---
 gateway/control_socket.py                     |  13 +-
 gateway/exit_deadline.py                      |  38 ++++-
 gateway/run_bootstrap.py                      |  16 +-
 gateway/run_shutdown_restart_wait.py          |   2 +
 gateway/update_checkpoint.py                  |   7 +
 tests/gateway/test_core_update_total_drain.py |  12 ++
 tests/gateway/test_update_checkpoint.py       |  29 ++++
 tests/gateway/test_update_exit_target.py      | 137 ++++++++++++++++++
 8 files changed, 246 insertions(+), 8 deletions(-)
 create mode 100644 tests/gateway/test_update_exit_target.py

diff --git a/gateway/control_socket.py b/gateway/control_socket.py
index e16e3e1528..5f554d5d16 100644
--- a/gateway/control_socket.py
+++ b/gateway/control_socket.py
@@ -409,8 +409,12 @@ class GatewayControlServer:
         self._pipe_server = NativeControlServer(self._home, self.handle_request_line)
         await asyncio.to_thread(self._pipe_server.start)
         return True
-    async def stop(self) -> None:
-        """Stop serving and remove the socket/pointer files."""
+    async def stop(self, close_wait_s: float | None = None) -> None:
+        """Stop serving and remove the socket/pointer files.
+
+        ``close_wait_s`` bounds the wait for open connections (``Server.wait_closed`` waits for every one
+        since Python 3.12, so a connection held by a slow handler held the gateway's exit with it); the
+        rest of the teardown still runs when it times out. ``None`` waits unbounded (prior behaviour)."""
         if self._loop_watchdog is not None:
             self._loop_watchdog.stop()
             self._loop_watchdog = None
@@ -419,7 +423,10 @@ class GatewayControlServer:
         if self._server is not None:
             self._server.close()
             with contextlib.suppress(Exception):
-                await self._server.wait_closed()
+                if close_wait_s is None:
+                    await self._server.wait_closed()
+                else:
+                    await asyncio.wait_for(self._server.wait_closed(), timeout=max(0.0, close_wait_s))
         if self._pipe_server is not None:
             with contextlib.suppress(Exception):
                 await asyncio.to_thread(self._pipe_server.close)
diff --git a/gateway/exit_deadline.py b/gateway/exit_deadline.py
index 41055ae837..46194e8f15 100644
--- a/gateway/exit_deadline.py
+++ b/gateway/exit_deadline.py
@@ -47,6 +47,7 @@ _state: dict[str, Any] = {}
 
 
 def _reset_for_tests() -> None:
+    """Clears the deadline, the exit target and the phase marks."""
     with _lock:
         _state.clear()
         _done.clear()
@@ -85,11 +86,40 @@ def is_exiting() -> bool:
 
 
 def remaining_s() -> Optional[float]:
-    """Seconds left before the deadline fires; ``None`` when no deadline is set (yet)."""
-    deadline = _state.get("deadline_mono")
-    if deadline is None:
+    """Seconds left before the deadline fires, or before an earlier exit target (:func:`set_exit_target`)
+    if one is set; ``None`` when neither is set (yet)."""
+    ends = [end for end in (_state.get("deadline_mono"), _state.get("target_mono")) if end is not None]
+    if not ends:
         return None
-    return max(0.0, deadline - time.monotonic())
+    return max(0.0, min(ends) - time.monotonic())
+
+
+# Kept between a core update's checkpoint exit target and the updater's own wait: the exit funnel and the
+# updater's 0.2s poll land inside it.
+UPDATE_EXIT_MARGIN_S = 8.0
+
+
+def set_exit_target(target_mono: Optional[float], reason: str = "") -> None:
+    """A soft exit target (monotonic) the stop tail's waits are clamped to; ``None`` clears it.
+
+    Unlike the deadline it never ``os._exit``s: it only shortens the cooperative waits (cron/housekeeping
+    threads, control socket, MCP) so the process exits by then. A core update's checkpoint sets it at
+    ``accept + drain_timeout - margin``: the updater waits ``drain_timeout`` from the ack for the gateway
+    process to EXIT, and the post-stop tail used to have no bound tied to that promise (hermes-hub
+    2026-11-13 01:58-01:59Z: stop() took 12s, the tail 44.5s, the process exited 2s after the updater's
+    70s wait and the update was deferred). [daveey]"""
+    with _lock:
+        if target_mono is None:
+            _state.pop("target_mono", None)
+            _state.pop("target_reason", None)
+        else:
+            _state.update(target_mono=float(target_mono), target_reason=reason)
+
+
+def phases() -> dict[str, float]:
+    """Phase marks (seconds since the stop began) recorded so far, for the tail's timing log line."""
+    with _lock:
+        return dict(_state.get("phases") or {})
 
 
 # Left on the deadline after the cron/housekeeping waits: MCP shutdown (5s) + the exit funnel.
diff --git a/gateway/run_bootstrap.py b/gateway/run_bootstrap.py
index beeb40fcf1..9643f6583e 100644
--- a/gateway/run_bootstrap.py
+++ b/gateway/run_bootstrap.py
@@ -27,6 +27,12 @@ def _start_deferred_state_db_integrity_check(evidence: dict) -> None:
 # Log-record parity with the origin module.
 logger = logging.getLogger("gateway.run")
 
+# A shutdown tail at least this long logs where its time went (normally 0.3-3.6s on the hub).
+_SLOW_TAIL_LOG_S = 10.0
+# Control socket stop: open connections each carry one short request (2s client timeout); a connection
+# held longer by a slow handler is dropped with the process instead of holding the exit.
+_CONTROL_STOP_TIMEOUT_S = 3.0
+
 
 def _hand_home_back_to_supervisor(existing_pid: int) -> None:
     """[daveey] A supervised start refused by a MANUAL owner of this home asks that owner to drain.
@@ -520,11 +526,13 @@ async def _start_gateway_shutdown_tail(
     _signal_initiated_shutdown: list) -> bool:
     """Post-``wait_for_shutdown`` teardown; returns the process exit verdict (True = exit 0)."""
     from gateway.run import (_CRON_SHUTDOWN_DRAIN_TIMEOUT, _HOUSEKEEPING_SHUTDOWN_DRAIN_TIMEOUT, _await_thread_exit, _best_effort, _resolve_gateway_exit_verdict, _shutdown_mcp_servers_nonblocking, _stop_cron_provider, exit_deadline)
+    tail_started = time.monotonic()
     # Control socket first: once shutdown begins we are no longer a truthful "serving here" answer and a
     # successor must be able to bind. Early-exit paths rely on the atexit cleanup_files hook instead.
     if _control_server is not None:
         try:
-            await _control_server.stop()
+            await _control_server.stop(close_wait_s=exit_deadline.clamp_wait(
+                _CONTROL_STOP_TIMEOUT_S, phase="control_stop"))
         except Exception:
             logger.debug("Control socket stop failed (non-fatal)", exc_info=True)
 
@@ -563,6 +571,12 @@ async def _start_gateway_shutdown_tail(
     except Exception:
         logger.warning("MCP shutdown failed; connections may be left open", exc_info=True)
 
+    # One line naming where a slow tail went: the stop's own phases are logged by stop(), and a tail that
+    # outlived a core update's wait was otherwise unattributable (hermes-hub 2026-11-13 01:58:45-01:59:29Z).
+    tail_s = time.monotonic() - tail_started
+    if tail_s >= _SLOW_TAIL_LOG_S:
+        exit_deadline.mark_phase("tail_done")
+        logger.warning("Shutdown tail took %.1fs (phase marks since stop began: %s)", tail_s, exit_deadline.phases())
     # The failure verdict comes AFTER the cooperative teardown: returning early here leaked the
     # cron ticker + housekeeping threads (and open MCP connections) for embedded callers (#12175).
     return _resolve_gateway_exit_verdict(runner, _signal_initiated_shutdown[0])
diff --git a/gateway/run_shutdown_restart_wait.py b/gateway/run_shutdown_restart_wait.py
index a9d824ac7a..a715420481 100644
--- a/gateway/run_shutdown_restart_wait.py
+++ b/gateway/run_shutdown_restart_wait.py
@@ -227,6 +227,8 @@ class GatewayRestartWaitMixin:
         self._restart_update_intent = None
         self._core_update_kanban_cap_spent = False
         self._stop_kanban_leash_s = None
+        from gateway import exit_deadline
+        exit_deadline.set_exit_target(None)  # the update's exit promise went with it
         self._draining = False
