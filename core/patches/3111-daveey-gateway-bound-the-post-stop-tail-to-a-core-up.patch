         self._scale_to_zero_status("running", "restart cancel: status mark failed")
diff --git a/gateway/update_checkpoint.py b/gateway/update_checkpoint.py
index 327540e7fe..fcb09ebc7a 100644
--- a/gateway/update_checkpoint.py
+++ b/gateway/update_checkpoint.py
@@ -191,7 +191,14 @@ def checkpoint_for_update(runner, loop, params):
                     return
                 claimed = True
             # The admitted path, not a fresh lookup: a withdrawal during preserve must still cancel.
+            accepted_at = time.monotonic()
             accepted = runner.request_restart(detached=False, via_service=True, update_intent=intent_path)
+            if accepted:
+                # The ack promises the updater this process EXITS within CHECKPOINT_DRAIN_S (it waits that long
+                # from the ack, then defers the update): bound the post-stop tail to that promise too.
+                from gateway import exit_deadline
+                exit_deadline.set_exit_target(
+                    accepted_at + CHECKPOINT_DRAIN_S - exit_deadline.UPDATE_EXIT_MARGIN_S, "core-update checkpoint")
             result.append({"pausing": bool(accepted), "already_stopping": not accepted,
                            "checkpoint": True, "nonce": intent["nonce"], "pid": pid, "drain_timeout": CHECKPOINT_DRAIN_S})
         except (OSError, TimeoutError, ValueError, TypeError, KeyError) as exc:
diff --git a/tests/gateway/test_core_update_total_drain.py b/tests/gateway/test_core_update_total_drain.py
index afff0974b1..c30b87dba1 100644
--- a/tests/gateway/test_core_update_total_drain.py
+++ b/tests/gateway/test_core_update_total_drain.py
@@ -139,3 +139,15 @@ async def test_real_settle_wait_fits_the_short_leash(monkeypatch):
     except Exception as exc:  # the tail after the wait needs real authorities; only the wait matters
         waited.setdefault("tail_error", repr(exc))
     assert waited["timeout"] <= 40.0 - 2.0 - run_runtime.STOP_TAIL_RESERVE_SECONDS
+
+
+def test_cancelled_restart_clears_the_update_exit_target(tmp_path, monkeypatch):
+    from gateway import exit_deadline
+    runner, _ = _runner(tmp_path, monkeypatch)
+    exit_deadline._reset_for_tests()
+    try:
+        exit_deadline.set_exit_target(time.monotonic() + 5.0, "core-update checkpoint")
+        runner._cancel_restart()
+        assert exit_deadline.remaining_s() is None
+    finally:
+        exit_deadline._reset_for_tests()
diff --git a/tests/gateway/test_update_checkpoint.py b/tests/gateway/test_update_checkpoint.py
index 983fa08383..e21d296c22 100644
--- a/tests/gateway/test_update_checkpoint.py
+++ b/tests/gateway/test_update_checkpoint.py
@@ -248,3 +248,32 @@ def test_live_delegation_refusal_says_so(checkpoint, monkeypatch):
     monkeypatch.setattr("gateway.run_active_work_verb._delegation_units", lambda now: [{"id": "d1"}])
     result = invoke(module, runner)
     assert "1 live async delegation(s)" in result["reason"]
+
+
+def test_accepted_checkpoint_sets_the_exit_target_inside_its_drain_timeout(checkpoint):
+    """The ack's drain_timeout is how long the updater waits for the process to EXIT: the tail is bound to it."""
+    from gateway import exit_deadline
+    module, _home, runner, _intent = checkpoint
+    exit_deadline._reset_for_tests()
+    try:
+        before = time.monotonic()
+        result = invoke(module, runner)
+        left = exit_deadline.remaining_s()
+        assert result["pausing"]
+        assert left is not None
+        assert left <= result["drain_timeout"] - exit_deadline.UPDATE_EXIT_MARGIN_S + (time.monotonic() - before)
+        assert left >= result["drain_timeout"] - exit_deadline.UPDATE_EXIT_MARGIN_S - 5
+    finally:
+        exit_deadline._reset_for_tests()
+
+
+def test_refused_or_unaccepted_checkpoint_sets_no_exit_target(checkpoint):
+    from gateway import exit_deadline
+    module, _home, runner, _intent = checkpoint
+    exit_deadline._reset_for_tests()
+    try:
+        runner.request_restart.return_value = False  # already stopping: not this update's promise
+        invoke(module, runner)
+        assert exit_deadline.remaining_s() is None
+    finally:
+        exit_deadline._reset_for_tests()
diff --git a/tests/gateway/test_update_exit_target.py b/tests/gateway/test_update_exit_target.py
new file mode 100644
index 0000000000..0000dd4854
--- /dev/null
+++ b/tests/gateway/test_update_exit_target.py
@@ -0,0 +1,137 @@
+"""A core update's checkpoint promises the updater the gateway process EXITS within its drain timeout.
+
+hermes-hub 2026-11-13 01:58-01:59Z: the checkpoint was acked at 01:58:17 (drain_timeout 70s), stop()
+finished at 01:58:45, but the post-stop tail (control socket, cron/housekeeping thread waits, MCP) ran
+44.5s more: the process exited at 01:59:29, 2s after the updater's 70s wait, so the update was deferred
+and hermes-sync cooled off 60 min. The tail's waits are now clamped to the checkpoint's exit target.
+"""
+from __future__ import annotations
+
+import asyncio
+import threading
+import time
+from unittest.mock import MagicMock
+
+import pytest
+
+from gateway import exit_deadline
+import gateway.run as gateway_run
+
+
+@pytest.fixture(autouse=True)
+def _clean_deadline():
+    exit_deadline._reset_for_tests()
+    yield
+    exit_deadline._reset_for_tests()
+
+
+def test_exit_target_clamps_waits_without_a_deadline():
+    assert exit_deadline.clamp_wait(65.0) == 65.0
+    exit_deadline.set_exit_target(time.monotonic() + 20.0, "test")
+    assert 12.0 <= exit_deadline.clamp_wait(65.0) <= 13.0  # 20 - TAIL_RESERVE_S
+    exit_deadline.set_exit_target(None)
+    assert exit_deadline.clamp_wait(65.0) == 65.0
+
+
+def test_exit_target_and_deadline_take_the_earlier():
+    now = time.monotonic()
+    exit_deadline._state.update(deadline_mono=now + 50.0)
+    exit_deadline.set_exit_target(now + 30.0)
+    assert 29.0 <= exit_deadline.remaining_s() <= 30.0
+    exit_deadline.set_exit_target(now + 80.0)
+    assert 49.0 <= exit_deadline.remaining_s() <= 50.0
+
+
+@pytest.mark.asyncio
+async def test_tail_exits_by_the_update_exit_target(monkeypatch):
+    """A cron ticker blocked past cron_stop held the tail up to its 65s default."""
+    cron_stop = threading.Event()
+    hang = threading.Event()
+    cron = threading.Thread(target=hang.wait, args=(30,), daemon=True)  # ignores cron_stop
+    cron.start()
+    housekeeping = threading.Thread(target=cron_stop.wait, daemon=True)
+    housekeeping.start()
+    watcher_stop = threading.Event()
+    watcher = threading.Thread(target=watcher_stop.wait, daemon=True)
+    watcher.start()
+
+    async def fake_mcp_shutdown(*_args, **_kwargs):
+        return True
+
+    monkeypatch.setattr(gateway_run, "_shutdown_mcp_servers_nonblocking", fake_mcp_shutdown)
+    monkeypatch.setattr(gateway_run, "_stop_cron_provider", lambda provider: None)
+    monkeypatch.setattr("hermes_cli.nous_auth_keepalive.stop_nous_auth_keepalive", lambda: None)
+    runner = MagicMock(should_exit_with_failure=True, exit_reason="test stop", exit_code=None)
+
+    from gateway.run_bootstrap import _start_gateway_shutdown_tail
+    exit_deadline.set_exit_target(time.monotonic() + exit_deadline.TAIL_RESERVE_S + 1.0, "test")
+    started = time.monotonic()
+    await asyncio.wait_for(_start_gateway_shutdown_tail(
+        runner, None, cron_stop, object(), cron, housekeeping, watcher_stop, watcher, [False]), timeout=15)
+    elapsed = time.monotonic() - started
+    hang.set()
+    assert elapsed < 4.0
+
+
+@pytest.mark.asyncio
+async def test_tail_bounds_the_control_socket_stop(monkeypatch):
+    """The control socket stop is given a bounded connection wait (it was unbounded)."""
+    seen = {}
+
+    class Control:
+        async def stop(self, close_wait_s=None):
+            seen["close_wait_s"] = close_wait_s
+
+    cron_stop = threading.Event()
+    threads = [threading.Thread(target=cron_stop.wait, daemon=True) for _ in range(2)]
+    for thread in threads:
+        thread.start()
+    watcher_stop = threading.Event()
+    watcher = threading.Thread(target=watcher_stop.wait, daemon=True)
+    watcher.start()
+
+    async def fake_mcp_shutdown(*_args, **_kwargs):
+        return True
+
+    monkeypatch.setattr(gateway_run, "_shutdown_mcp_servers_nonblocking", fake_mcp_shutdown)
+    monkeypatch.setattr(gateway_run, "_stop_cron_provider", lambda provider: None)
+    monkeypatch.setattr("hermes_cli.nous_auth_keepalive.stop_nous_auth_keepalive", lambda: None)
+    runner = MagicMock(should_exit_with_failure=True, exit_reason="test stop", exit_code=None)
+
+    from gateway.run_bootstrap import _start_gateway_shutdown_tail
+    await _start_gateway_shutdown_tail(
+        runner, Control(), cron_stop, object(), threads[0], threads[1], watcher_stop, watcher, [False])
+    from gateway.run_bootstrap import _CONTROL_STOP_TIMEOUT_S
+    assert seen["close_wait_s"] == _CONTROL_STOP_TIMEOUT_S
+
+
+@pytest.mark.platforms("posix")
+def test_control_socket_stop_does_not_wait_on_a_held_connection(tmp_path):
+    """Server.wait_closed() waits for every open connection; one held by a slow handler held the exit."""
+    from gateway.control_socket import GatewayControlServer, query_gateway_control
+    home = tmp_path / "h"
+    home.mkdir()
+    release = threading.Event()
+    entered = threading.Event()
+
+    def slow():
+        entered.set()
+        release.wait(20)
+        return {"ok": True}
+
+    async def scenario():
+        server = GatewayControlServer(home, verb_handlers={"status": slow})
+        assert await server.start()
+        loop = asyncio.get_running_loop()
+        client = loop.run_in_executor(None, lambda: query_gateway_control(home, "status", timeout=20))
+        assert await asyncio.to_thread(entered.wait, 10)  # the request is in the handler, its connection open
+        started = time.monotonic()
+        try:
+            await server.stop(close_wait_s=0.5)
+            return time.monotonic() - started
+        finally:
+            release.set()
+            await asyncio.gather(client, return_exceptions=True)
+
+    elapsed = asyncio.run(scenario())
+    assert elapsed < 3.0
-- 
2.51.0

