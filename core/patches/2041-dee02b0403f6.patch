From dee02b0403f6145ddc4a5d17a8bc9d7bd64971a1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 7 Nov 2026 14:21:14 +0000
Subject: [PATCH] fix(preview): decline vault requests from parked bystander
 windows [daveey]

---
 .../gateway-event/server-requests.test.ts            | 12 ++++++++++++
 .../gateway-event/server-requests.ts                 |  8 +++++++-
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/app/session/hooks/use-message-stream/gateway-event/server-requests.test.ts b/apps/desktop/src/app/session/hooks/use-message-stream/gateway-event/server-requests.test.ts
index 4533f1946f4..8283a265fc2 100644
--- a/apps/desktop/src/app/session/hooks/use-message-stream/gateway-event/server-requests.test.ts
+++ b/apps/desktop/src/app/session/hooks/use-message-stream/gateway-event/server-requests.test.ts
@@ -675,6 +675,18 @@ describe('a hidden session keeps driving its own parked Browser page', () => {
     return $previewTabs.get().find(tab => tab.target.url === `https://${host}`)!
   }
 
+  it('declines vault open in a parked window so the visible owner can answer', async () => {
+    openOwn('stored-a', 'flow.example')
+    const { decline, respond } = deliver(
+      'preview.act',
+      { action: 'vault', session_id: 'rt-a', vault: { operation: 'open' } },
+      'rt-b'
+    )
+
+    await vi.waitFor(() => expect(decline).toHaveBeenCalledTimes(1))
+    expect(respond).not.toHaveBeenCalled()
+  })
+
   it("acts in the hidden session's own tab, never the page on screen", async () => {
     const a = openOwn('stored-a', 'flow.example')
     const b = openOwn('stored-b', 'b.example')
diff --git a/apps/desktop/src/app/session/hooks/use-message-stream/gateway-event/server-requests.ts b/apps/desktop/src/app/session/hooks/use-message-stream/gateway-event/server-requests.ts
index e0f6fa9b3f7..4484084be14 100644
--- a/apps/desktop/src/app/session/hooks/use-message-stream/gateway-event/server-requests.ts
+++ b/apps/desktop/src/app/session/hooks/use-message-stream/gateway-event/server-requests.ts
@@ -1059,7 +1059,13 @@ export function handleServerRequest(
       // window it was last shown in. That window claims the session's
       // preview.read/preview.act so the agent keeps working while the user is
       // in another chat; the handler only ever reaches that session's own tab.
-      if (BACKGROUND_PREVIEW_REQUESTS.has(request.method) && windowHoldsBackgroundPreview(sessionId)) {
+      // Vault bindings belong to the visible owner. A parked window must decline,
+      // not race that owner with the vault handler's inactive-session refusal.
+      if (
+        BACKGROUND_PREVIEW_REQUESTS.has(request.method) &&
+        request.params.action !== 'vault' &&
+        windowHoldsBackgroundPreview(sessionId)
+      ) {
         handler({ deps, request, sessionId, isActiveSession: false })
 
         return true
-- 
2.55.0

