From 4a79c9aff5053fa23927720e0a934e6cfdf45ced Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 02:49:48 +0000
Subject: [PATCH] fix(ci): session_move spawn env via build_subprocess_env; add
 session_move to v4 tool_enabled_unused toolset enum

---
 .../observability/schemas/hermes.shared_metrics.v4.schema.json | 1 +
 hermes_cli/session_handover.py                                 | 3 ++-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/observability/schemas/hermes.shared_metrics.v4.schema.json b/hermes_cli/observability/schemas/hermes.shared_metrics.v4.schema.json
index 4b1621a1dd..5ee500f3ec 100644
--- a/hermes_cli/observability/schemas/hermes.shared_metrics.v4.schema.json
+++ b/hermes_cli/observability/schemas/hermes.shared_metrics.v4.schema.json
@@ -3654,6 +3654,7 @@
                 "project",
                 "safe",
                 "search",
+                "session_move",
                 "session_search",
                 "setup",
                 "skills",
diff --git a/hermes_cli/session_handover.py b/hermes_cli/session_handover.py
index 359fdd499f..00bb6cfdd3 100644
--- a/hermes_cli/session_handover.py
+++ b/hermes_cli/session_handover.py
@@ -468,6 +468,7 @@ def spawn_after_turn_move(session_id: str, to: str, reason: str) -> int:
     """Start ``hermes sessions move <id> --to <to> --reason ... --after-turn`` detached (the agent tool's path);
     returns its pid. Output goes to ``<hermes home>/logs/session-move-<id>.log``."""
     from hermes_constants import get_hermes_home
+    from tools.environments.local import build_subprocess_env
     log_dir = Path(get_hermes_home()) / "logs"
     log_dir.mkdir(parents=True, exist_ok=True)
     log = open(log_dir / f"session-move-{session_id}.log", "ab")  # handed to the child
@@ -477,7 +478,7 @@ def spawn_after_turn_move(session_id: str, to: str, reason: str) -> int:
             [sys.executable, "-m", "hermes_cli.main", "sessions", "move", session_id, "--to", to,
              "--reason", reason, "--after-turn"],
             cwd=repo, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
-            env={**os.environ})
+            env=build_subprocess_env(scrub_secrets=False, inherit_profile_home=False))
     finally:
         log.close()
     return p.pid
-- 
2.55.0

