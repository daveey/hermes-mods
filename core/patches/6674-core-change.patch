+    result = _run(tmp_path, 'settler', r'''
+        ca.SETTLE_DELAY = 0.0
+        for name, source in sources.items():
+            load(p / name, source)
+        limit = time.monotonic() + 10
+        while a._pending and time.monotonic() < limit:
+            time.sleep(0.01)
