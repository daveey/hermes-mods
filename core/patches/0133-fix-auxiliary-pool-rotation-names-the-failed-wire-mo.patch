-    _client_api_key = str(getattr(client, "api_key", "") or "")
+    # Capture the exact key and wire model used so recovery finds the right pool entry even if
+    # another process rotated the pool meanwhile (current() would be None), and scopes a
+    # per-model 429 to that model instead of benching the whole credential.
     # Gate on the narrowed error: a connection failure from the retry above arrives here
     # unaccepted on purpose (a fresh key cannot fix an unreachable endpoint), so rotation
     # is skipped and ``first_err`` is handed to the provider-fallback chain as-is.
@@ -7811,7 +7855,9 @@ def _ladder_credential_rungs(
                 _LadderStep("call", (client, kwargs)), _credential_rung_accepts)
             if recovery_err is None:
                 return resp, None
-        if _recover_provider_pool(pool_provider, recovery_err, failed_api_key=_client_api_key):
+        _failed_key, _failed_model = _failed_identity(recovery_err, client, kwargs)
+        if _recover_provider_pool(pool_provider, recovery_err, failed_api_key=_failed_key,
+                                  failed_model=_failed_model):
             logger.info("Auxiliary %s%s: recovered %s via credential-pool rotation after %s",
                         task or "call", tag, pool_provider, type(recovery_err).__name__)
             try:
@@ -7822,7 +7868,10 @@ def _ladder_credential_rungs(
                 # then fall through to the provider fallback.
                 if (_is_payment_error(retry2_err) or _is_auth_error(retry2_err)
                         or _is_rate_limit_error(retry2_err)):
-                    _recover_provider_pool(pool_provider, retry2_err)
+                    # The stamp names the rotated credential and model that just failed.
+                    _rot_key, _rot_model = _failed_identity(retry2_err, None, None)
+                    _recover_provider_pool(pool_provider, retry2_err, failed_api_key=_rot_key,
+                                           failed_model=_rot_model or _failed_model)
                     first_err = retry2_err
