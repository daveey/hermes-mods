-def _recover_provider_pool(provider: str, exc: Exception, *, failed_api_key: str = "") -> bool:
+# Attribute stamped on an exception raised by a same-provider retry: the (api_key, wire model)
+# that request actually used, so pool recovery benches the credential that failed rather than
+# the original client's (or whatever ``current()`` is by then).
+_AUX_FAILED_IDENTITY_ATTR = "_hermes_aux_failed_identity"
+
+
+def _stamp_failed_identity(exc: BaseException, client: Any, request_kwargs: Optional[dict]) -> None:
+    """Record which credential and model a failed request used (innermost stamp wins)."""
+    if getattr(exc, _AUX_FAILED_IDENTITY_ATTR, None) is not None:
+        return
+    identity = (str(getattr(client, "api_key", "") or ""), str((request_kwargs or {}).get("model") or ""))
+    with contextlib.suppress(Exception):
+        setattr(exc, _AUX_FAILED_IDENTITY_ATTR, identity)
+
+
+def _failed_identity(exc: BaseException, client: Any, request_kwargs: Optional[dict]) -> tuple[str, str]:
+    """``(api_key, model)`` of the request that raised *exc*: the retry's stamp when present,
+    else the given client/kwargs (the original request)."""
+    stamped = getattr(exc, _AUX_FAILED_IDENTITY_ATTR, None)
+    if isinstance(stamped, tuple) and len(stamped) == 2:
+        return str(stamped[0] or ""), str(stamped[1] or "")
+    return str(getattr(client, "api_key", "") or ""), str((request_kwargs or {}).get("model") or "")
+
+
+def _recover_provider_pool(
+    provider: str, exc: Exception, *, failed_api_key: str = "", failed_model: str = "",
+) -> bool:
     """Try same-provider credential-pool recovery for auxiliary calls.
 
     ``failed_api_key`` lets mark_exhausted_and_rotate identify the right pool entry even if
-    another process already rotated (current() would be None).
+    another process already rotated (current() would be None). ``failed_model`` is the wire
+    model of the failed request: the pool scopes a generic Anthropic 429 to that model only.
+    Without it the pool benches the whole credential for every model. The classified
+    ``failure_reason`` keeps billing/quota failures account-wide even with a model.
     """
     normalized = _normalize_aux_provider(provider)
     try:
@@ -3734,13 +3763,18 @@ def _recover_provider_pool(provider: str, exc: Exception, *, failed_api_key: str
         return False
