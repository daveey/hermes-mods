+        calls.append(tid)
+        return {"ok": True, "runs_on": labels, "repinned": True}
+    monkeypatch.setattr(repin, "repin_to_origin", fake_repin)
+    out = _submit(f, {"op": "operator", "action": "move", "task_id": f.target, "runs_on": ["machine:hub"],
+                      "reason": "back to the origin"})
+    _round(f)
