     _require(len(rows) <= MAX_OPS, 'refusal_inventory_bound')
     state = sync.sync_state(shadow) or {}
     _require(state.get('board_id') == board and state.get('gateway_id') == identity[2], 'replica_identity_changed')
@@ -87,7 +104,7 @@
         for conn in (live, shadow):
