From 7ae71d8fb7d3a057a8651a9ff734b5450835cd5d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 05:05:22 +0000
Subject: [PATCH] [daveey] Test awaited repair claim task and run provenance

Add two negative claim witnesses with valid foreign keys: wrong task/current run and same task/other run. Both must retain the active_pr hold. Production repair and fail-closed gates are unchanged.

Proof: canonical awaited suites 150 passed, zero skips. Focused baseline 2 passed; task predicate omission fails different_task only, run predicate omission fails different_run only, zero skips.
---
 .../test_kanban_awaited_review_repair.py      | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_awaited_review_repair.py b/tests/hermes_cli/test_kanban_awaited_review_repair.py
index adbbb4b81a..7eb96cb943 100644
--- a/tests/hermes_cli/test_kanban_awaited_review_repair.py
+++ b/tests/hermes_cli/test_kanban_awaited_review_repair.py
@@ -95,6 +95,25 @@ def test_repair_requires_authenticated_current_park_and_review(clock, monkeypatc
         assert kar.resumes_awaited_review(conn, tid, urls) is False
 
 
+@pytest.mark.parametrize("claim_scope", ["different_task", "different_run"])
+def test_repair_rejects_claim_outside_parked_owner_run(clock, monkeypatch, claim_scope):
+    with kbc.connect() as conn:
+        tid, rev = _owner(conn, clock, monkeypatch)
+        parked_run = kar._park(conn, tid)[0]["id"]
+        review_run = conn.execute(
+            "SELECT id FROM task_runs WHERE task_id=?", (rev,)).fetchone()["id"]
+        # Keep a real FK but mismatch exactly one provenance dimension. The
+        # legitimate review claim remains, so only the owner's claim is invalid.
+        claim_task = rev if claim_scope == "different_task" else tid
+        claim_run = parked_run if claim_scope == "different_task" else review_run
+        with kb.write_txn(conn):
+            conn.execute("DELETE FROM task_events WHERE task_id=? AND kind='claimed'", (tid,))
+            conn.execute(
+                "INSERT INTO task_events (task_id, run_id, kind, payload, created_at) "
+                "VALUES (?, ?, 'claimed', '{}', ?)", (claim_task, claim_run, clock[0]))
+        assert prs.active_pr_reason(conn, tid, clock[0] + 10) == "active_pr"
+
+
 @pytest.mark.parametrize("metadata", [REPAIR | {"reviewed_pr": base.OTHER},
                                       REPAIR | {"reviewed_sha": "b" * 40},
                                       REPAIR | {"verdict": "unknown"}])
