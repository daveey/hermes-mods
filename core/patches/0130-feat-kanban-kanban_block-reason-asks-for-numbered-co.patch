 2 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/tests/tools/test_kanban_tools.py b/tests/tools/test_kanban_tools.py
index 7885daf5db..5cb8e4a11b 100644
--- a/tests/tools/test_kanban_tools.py
+++ b/tests/tools/test_kanban_tools.py
@@ -141,6 +141,21 @@ def test_kanban_task_id_descriptions_state_the_non_worker_case():
     assert "kanban_show" in seen
 
 
+def test_kanban_block_reason_asks_for_unblock_steps():
+    """[daveey] Desktop's blocked-panel shows ``reason`` above the chat's composer as
+    the human's unblock instructions, so the schema must ask for an ask-first,
+    numbered, concrete reason instead of a one-or-two-sentence status summary."""
+    from tools import kanban_tools_schemas as kts
+
+    desc = kts.KANBAN_BLOCK_SCHEMA["parameters"]["properties"]["reason"]["description"]
+    assert "unblock instructions" in desc
+    assert "Lead with the ask" in desc
+    assert "numbered steps" in desc
+    assert "exact device, app, setting" in desc
+    assert "one or two sentences" not in desc
+    assert "above the managing chat's composer" in kts.KANBAN_BLOCK_SCHEMA["description"]
+
+
 def test_list_filters_tasks(monkeypatch, worker_env):
     """kanban_list gives orchestrators filtered board discovery."""
     monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
diff --git a/tools/kanban_tools_schemas.py b/tools/kanban_tools_schemas.py
index 68c450d79a..b407deb981 100644
--- a/tools/kanban_tools_schemas.py
+++ b/tools/kanban_tools_schemas.py
@@ -176,7 +176,9 @@ KANBAN_BLOCK_SCHEMA = _schema(
         "needed), 'needs_input' (you need a human decision/answer), "
         "'capability' (a hard wall: no access, missing credentials, an action "
         "no agent can do), or 'transient' (a flaky failure that may clear). "
-        "``reason`` is shown to the human on the board. If a task keeps "
+        "``reason`` is shown to the human on the board and, in Desktop, in a "
+        "panel above the managing chat's composer as the steps to unblock it. "
+        "If a task keeps "
         "getting unblocked and re-blocked for the same reason, it is "
         "auto-escalated to triage. Use for genuine blockers only — don't "
         "block on things you can resolve yourself. Waiting on time or an "
@@ -186,9 +188,14 @@ KANBAN_BLOCK_SCHEMA = _schema(
     {
         "task_id": _prop("string", _DESC_TASK_ID_DEFAULT),
         "reason": _prop("string", (
-                "What you need answered or what stopped you, in one or "
-                "two sentences. Don't paste the whole conversation; the "
-                "human has the board and can ask follow-ups via comments."
+                "The human's unblock instructions. Lead with the ask, not "
+                "with what you finished. For needs_input/capability write "
+                "numbered steps the human must perform (\"1) ... 2) ...\"), "
+                "naming the exact device, app, setting, page or command, then "
+                "what to do when done (e.g. \"then unblock this card\" or "
+                "\"reply with the value\"). For a decision, state the question "
+                "and the options. Keep it short; the human has the board and "
+                "can ask follow-ups via comments."
         )),
         "kind": {
             "type": "string",
