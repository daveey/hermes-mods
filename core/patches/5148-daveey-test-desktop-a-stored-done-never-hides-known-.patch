From 8d7ab4bff711b9e0b6b8d686dba2207e3decb32e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 11:30:52 -0800
Subject: [PATCH] [daveey] test(desktop): a stored done never hides known
 unfinished work

Narrows the 'outcome wins over derived inputs' pin: stored done no longer overrides blocked/waiting/background evidence.
---
 apps/desktop/src/lib/session-outcome.test.ts | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/apps/desktop/src/lib/session-outcome.test.ts b/apps/desktop/src/lib/session-outcome.test.ts
index 8e930f2280..afe4ee3830 100644
--- a/apps/desktop/src/lib/session-outcome.test.ts
+++ b/apps/desktop/src/lib/session-outcome.test.ts
@@ -78,9 +78,11 @@ describe('sessionStatusStripe with a stored outcome', () => {
     ['unresolved', 'attention']
   ] as const)('%s paints %s', (kind, stripe) => {
     expect(outcomeStripe(OUTCOMES[kind])).toBe(stripe)
-    // Wins over every derived input that would otherwise paint something else.
-    expect(sessionStatusStripe('idle', true, false, 3, true, 'stuck', 2, 4, 1, OUTCOMES[kind])).toBe(stripe)
-    expect(sessionStatusStripe('background', false, false, 0, false, null, 0, 0, 0, OUTCOMES[kind])).toBe(stripe)
+    // Wins over every derived input that would otherwise paint something else, except that a stored
+    // `done` never hides known unfinished work (blocked/waiting cards, background work): that stays non-green.
+    const held = kind === 'done'
+    expect(sessionStatusStripe('idle', true, false, 3, true, 'stuck', 2, 4, 1, OUTCOMES[kind])).toBe(held ? sessionStatusStripe('idle', true, false, 3, true, 'stuck', 2, 4, 1) : stripe)
+    expect(sessionStatusStripe('background', false, false, 0, false, null, 0, 0, 0, OUTCOMES[kind])).toBe(held ? sessionStatusStripe('background', false, false, 0, false, null, 0, 0, 0) : stripe)
     expect(sessionStatusStripe('unread', true, false, 0, false, null, 0, 0, 0, OUTCOMES[kind])).toBe(stripe)
   })
 
