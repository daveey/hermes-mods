 2 files changed, 7 insertions(+)

diff --git a/tests/fixtures/resolution_allowlist.json b/tests/fixtures/resolution_allowlist.json
index 7c2bb44e12..eddafab5f2 100644
--- a/tests/fixtures/resolution_allowlist.json
+++ b/tests/fixtures/resolution_allowlist.json
@@ -237,6 +237,11 @@
     "symbol": "_gh_cli_token",
     "kind": "bare_which"
   },
+  {
+    "path": "hermes_cli/kanban_capability_registry.py",
+    "symbol": "hub_cli_path",
+    "kind": "bare_which"
+  },
   {
     "path": "hermes_cli/kanban_db_dispatch.py",
     "symbol": "_resolve_hermes_argv",
diff --git a/tests/scripts/test_run_tests_parallel_stdio.py b/tests/scripts/test_run_tests_parallel_stdio.py
index 601071ee09..9c75fcc870 100644
--- a/tests/scripts/test_run_tests_parallel_stdio.py
+++ b/tests/scripts/test_run_tests_parallel_stdio.py
@@ -28,6 +28,8 @@ def _load_runner():
 def test_silent_child_failure_reports_exit_code(tmp_path, monkeypatch):
     from types import SimpleNamespace
     mod = _load_runner()
+    # No host slot: the slot lookup reads ~/.hermes/config.yaml, which the home I/O guard refuses.
+    monkeypatch.setenv("HERMES_TEST_HOST_SLOTS", "0")
     child = SimpleNamespace(pid=123, returncode=23, communicate=lambda **kwargs: ("", None))
     monkeypatch.setattr(mod.subprocess, "Popen", lambda *args, **kwargs: child)
     monkeypatch.setattr(mod, "_kill_tree", lambda *args, **kwargs: None)
