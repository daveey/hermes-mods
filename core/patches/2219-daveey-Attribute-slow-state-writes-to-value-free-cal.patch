diff --git a/hermes_state_write_diagnostics.py b/hermes_state_write_diagnostics.py
new file mode 100644
index 00000000000..3d86f115ded
--- /dev/null
+++ b/hermes_state_write_diagnostics.py
@@ -0,0 +1,40 @@
+"""Value-free diagnostics for slow writer transactions; never affect settlement."""
+from __future__ import annotations
+
+import logging
+import os
+import re
+import sys
+
+logger = logging.getLogger("hermes_state")
+
+
+def log_write_duration(held_s: float, stage: str) -> None:
+    """Attribute a completed/failed hold to code, including generic SQL wrappers.
+
+    Never inspect SQL, parameters, locals, callable reprs, or exception text. The
+    bounded stack survives wrapper calls and identifies their semantic caller.
+    This runs only for slow holds, after commit/rollback; logging must not make a
+    committed operation look failed (and invite a caller to retry it).
+    """
+    try:
+        frame = sys._getframe(1)
+        sites = []
+        try:
+            for _ in range(4):
+                if frame is None:
+                    break
+                code = frame.f_code
+                name = re.sub(r"[^a-zA-Z0-9_.<>]", "_", code.co_qualname)[:160]
+                filename = re.sub(r"[^a-zA-Z0-9_.-]", "_", os.path.basename(code.co_filename))[:80]
+                sites.append(f"{filename}:{frame.f_lineno}:{name}")
+                frame = frame.f_back
+        finally:
+            del frame
+        logger.warning(
+            "state.db write lock held %.1fs (pid %d) stage=%s callsites=%s",
+            held_s, os.getpid(), stage, " <- ".join(sites),
+        )
+    except Exception:  # health: allow BLE001,S110 -- diagnostic handlers must never change commit settlement or cause replay
+        # No recursive logging here: the failed handler may be the cause.
+        return
diff --git a/tests/hermes_state/test_write_diagnostics.py b/tests/hermes_state/test_write_diagnostics.py
new file mode 100644
index 00000000000..dc443bb91c2
--- /dev/null
+++ b/tests/hermes_state/test_write_diagnostics.py
@@ -0,0 +1,59 @@
+"""Slow writer provenance must not change commit/rollback semantics."""
+import logging
+import sqlite3
+
+import pytest
+
+import hermes_state
+from hermes_state import SessionDB
+import hermes_state_write_diagnostics as diagnostics
+
+
+@pytest.fixture
+def db(tmp_path, monkeypatch):
+    store = SessionDB(tmp_path / "state.db")
+    store._conn.execute("CREATE TABLE diagnostic_fixture (value TEXT)")
+    monkeypatch.setattr(hermes_state, "_WRITE_HOLD_WARN_S", 0)
+    yield store
+    store.close()
+
+
+def semantic_operation(db):
+    db._write_sql("INSERT INTO diagnostic_fixture VALUES ('literal-secret')")
+
+
+def test_wrapper_provenance_no_values(db, caplog):
+    with caplog.at_level(logging.WARNING, logger="hermes_state"):
+        semantic_operation(db)
+    assert "semantic_operation" in caplog.text
+    assert "stage=committed" in caplog.text
+    assert "literal-secret" not in caplog.text
+    assert "INSERT" not in caplog.text
+    assert db._conn.execute("SELECT count(*) FROM diagnostic_fixture").fetchone()[0] == 1
+
+
+def test_failed_callback_is_attributed_and_rolled_back_once(db, caplog):
+    calls = []
+
+    def failed_operation(conn):
+        calls.append(1)
+        conn.execute("INSERT INTO diagnostic_fixture VALUES (?)", ("parameter-secret",))
+        raise ValueError("exception-secret")
+
+    with caplog.at_level(logging.WARNING, logger="hermes_state"), pytest.raises(ValueError):
+        db._execute_write(failed_operation)
+    assert "stage=callback" in caplog.text
+    assert "test_failed_callback_is_attributed" in caplog.text
+    assert "parameter-secret" not in caplog.text
+    assert "exception-secret" not in caplog.text
+    assert calls == [1]
+    assert db._conn.execute("SELECT count(*) FROM diagnostic_fixture").fetchone()[0] == 0
+
+
+def test_logging_failure_cannot_turn_commit_into_error(db, monkeypatch):
+    def broken_handler(*args, **kwargs):
+        raise sqlite3.OperationalError("database is locked")
+
+    monkeypatch.setattr(diagnostics.logger, "warning", broken_handler)
+    semantic_operation(db)
+    assert db._conn.execute("SELECT count(*) FROM diagnostic_fixture").fetchone()[0] == 1
diff --git a/tests/hermes_state/test_write_diagnostics_settlement.py b/tests/hermes_state/test_write_diagnostics_settlement.py
new file mode 100644
index 00000000000..d927ae58c46
--- /dev/null
+++ b/tests/hermes_state/test_write_diagnostics_settlement.py
@@ -0,0 +1,61 @@
+"""Failure injection at COMMIT: diagnostics cannot replay uncertain commits."""
+import logging
+import sqlite3
+
+import pytest
+
+import hermes_state
+from hermes_state import SessionDB
+
+
+@pytest.mark.parametrize("settled", [False, True])
+def test_commit_failure_never_replays(tmp_path, monkeypatch, caplog, settled):
+    db = SessionDB(tmp_path / "state.db")
+    real = db._conn
+    assert real is not None
+    real.execute("CREATE TABLE diagnostic_fixture(value TEXT)")
+    calls = []
+
+    class CommitFailure:
+        def __getattr__(self, name):
+            return getattr(real, name)
+
+        def commit(self):
+            if settled:
+                real.commit()
+            raise sqlite3.OperationalError("disk I/O error secret")
+
+    monkeypatch.setattr(db, "_conn", CommitFailure())
+    monkeypatch.setattr(hermes_state, "_WRITE_HOLD_WARN_S", 0)
+
+    def operation(conn):
+        calls.append(1)
+        conn.execute("INSERT INTO diagnostic_fixture VALUES ('secret')")
+
+    try:
+        with caplog.at_level(logging.WARNING, logger="hermes_state"), pytest.raises(sqlite3.OperationalError):
+            db._execute_write(operation)
+        assert calls == [1]
+        assert "stage=commit" in caplog.text
+        assert "secret" not in caplog.text
+        assert real.execute("SELECT count(*) FROM diagnostic_fixture").fetchone()[0] == int(settled)
+    finally:
+        db._conn = real
+        db.close()
+
+
+def test_many_and_rowcount_are_attributed(tmp_path, monkeypatch, caplog):
+    db = SessionDB(tmp_path / "state.db")
+    assert db._conn is not None
+    db._conn.execute("CREATE TABLE diagnostic_fixture(value TEXT)")
+    monkeypatch.setattr(hermes_state, "_WRITE_HOLD_WARN_S", 0)
+    try:
+        with caplog.at_level(logging.WARNING, logger="hermes_state"):
+            db._write_sql("INSERT INTO diagnostic_fixture VALUES (?)", [("secret",), ("secret",)], many=True)
+            assert db._write_rowcount("DELETE FROM diagnostic_fixture") == 2
+        assert "SessionDB._write_sql" in caplog.text
+        assert "SessionDB._write_rowcount" in caplog.text
+        assert "test_many_and_rowcount" in caplog.text
+        assert "secret" not in caplog.text
+    finally:
+        db.close()
