From 484c6f219ee33d12cf48019715744de981f819d5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 01:35:20 -0800
Subject: [PATCH] [daveey] CI: halve the affected-test slice budget so pull
 request runs finish in 5-6 min

After #3589 the first two pull request runs that selected affected files took 8.2 and 8.8 min
(runs 44264991449: 885 files in 2 slices of 5.9 and 6.9 min; 44264593158: 3 slices of 5.9-7.4 min).
An affected slice was sized like a full-suite slice (16 x 240 s of per-file time, ~7 min), so wall
time bottomed out near 8 min however few files were selected.

SLICE_SECONDS goes to 16 x 120: an affected run uses about twice as many runners, each for about
half as long, plus ~1 min of setup per extra slice. MAX_SLICES still caps the matrix at 12, and a
selection over 40% of the suite still runs the full suite, so the largest affected run (about
18,600 s of files) fits in 10 slices. Full-suite slices are unchanged.

Proof: tests/ci/test_affected_tests.py and tests/ci/test_fast_runner_routing.py pass
(hermes-core-wt test --local on macOS). Not measured: the 5-6 min figure is an estimate from the
two runs above until pull request runs on this change finish.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 .github/workflows/tests.yml  | 4 ++--
 scripts/ci/affected_tests.py | 5 ++++-
 2 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index 2e31387942d937104cddf5cea8420b155c96ba5c..3a4d521568422ca268bd7db8bf9622645246d011 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -68,8 +68,8 @@ jobs:
     # Before 2026-10-29, two slices on the shared hermes-hub pool ran 42 min
     # + 19 min p50 queue each, ~75% of all CI runner-hours.
     #
-    # Pull requests usually run one slice of affected files (ci.yaml detect sizes the
-    # matrix, scripts/ci/affected_tests.py); every other event runs all twelve.
+    # Pull requests usually run a few half-size slices of affected files (ci.yaml detect
+    # sizes the matrix, scripts/ci/affected_tests.py); every other event runs all twelve.
     if: inputs.python
     name: Run tests (${{ inputs.python_changed != '' && 'affected, ' || '' }}${{ matrix.slice }}/${{ strategy.job-total }})
     runs-on: blacksmith-4vcpu-ubuntu-2404
diff --git a/scripts/ci/affected_tests.py b/scripts/ci/affected_tests.py
index 6751d965c781e8f5cb712cca5515ffaffc84a09a..43f84e0a81cf8ce194d324649d2b6b25046de65f 100755
--- a/scripts/ci/affected_tests.py
+++ b/scripts/ci/affected_tests.py
@@ -56,7 +56,10 @@ FULL_FRACTION = 0.4
 # Basenames too generic to mean one file when a test mentions them.
 GENERIC = {"__init__.py", "README.md", "index.ts", "index.js", "main.py", "utils.py", "config.py", "cli.py",
            "package.json", "SKILL.md", "types.ts", "constants.py"}
-SLICE_SECONDS = 16 * 240  # one affected slice holds about what a full-suite slice does (~12.9 h / MAX_SLICES)
+# One affected slice: 16 workers x ~2 min of per-file time, about half a full-suite slice (~12.9 h /
+# MAX_SLICES = ~3870 s). At 16 x 240 the first affected runs after #3589 took 8.2 and 8.8 min, their
+# slices 6-7 min each; half-size slices trade about twice the runners for a ~5-6 min pull request run.
+SLICE_SECONDS = 16 * 120
 MAX_SLICES = 12  # tests.yml's full-suite matrix (one 8 vCPU Blacksmith VM per slice)
 DEFAULT_FILE_SECONDS = 3.0
 
-- 
2.43.0

