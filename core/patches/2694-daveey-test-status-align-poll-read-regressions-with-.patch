From 15fe7b15f45ec1a3a34bbeb0f23edb9c3891116f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 07:00:30 +0000
Subject: [PATCH] [daveey] test(status): align poll-read regressions with
 additive observations and bounded memo age

Four tests on main-green files failed on this branch (earlier handoff
compared against the feature base, not main): two compared whole replayed
rows that now carry an optional (unknown) execution observation; one
compared the whole spies dict that gained a boards list; one crossed the
2 h stall cutoff with a 2 h jump that also passes the new per-board
_COUNTS_MAX_AGE_S source-age bound. Keep each invariant exact: legacy row
fields unchanged and replayed observation never current; recompute/thread
counts unchanged; stall verdict moves without a re-read inside the max age,
and an unchanged board is re-read exactly once after it.

Proof: 544 files / 8782 passed with only these 4 failing before; 3 files
21/21 after.
---
 .../hermes_cli/test_kanban_poll_cache_guarantees.py  |  2 +-
 tests/hermes_cli/test_kanban_sidebar_poll_reads.py   | 12 ++++++++++--
 tests/hermes_cli/test_web_board_busy.py              |  6 +++++-
 3 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_poll_cache_guarantees.py b/tests/hermes_cli/test_kanban_poll_cache_guarantees.py
index 03e6077cd8..eaf79cd38d 100644
--- a/tests/hermes_cli/test_kanban_poll_cache_guarantees.py
+++ b/tests/hermes_cli/test_kanban_poll_cache_guarantees.py
@@ -99,7 +99,7 @@ def test_inline_poll_reads_each_board_revision_once(clock, spies, tmp_path, monk
         reads.clear()
         helpers._advance(clock, ksa._CACHE_TTL_S + 0.5)
         assert helpers._poll()["kanban_active"] == 2
-        assert spies == {"recompute": 1, "threads": cold_threads}
+        assert {k: spies[k] for k in ("recompute", "threads")} == {"recompute": 1, "threads": cold_threads}
         assert reads == Counter({path: 1 for path in paths})
     finally:
         for conn in conns:
diff --git a/tests/hermes_cli/test_kanban_sidebar_poll_reads.py b/tests/hermes_cli/test_kanban_sidebar_poll_reads.py
index f9b5306a7a..b8cb998a40 100644
--- a/tests/hermes_cli/test_kanban_sidebar_poll_reads.py
+++ b/tests/hermes_cli/test_kanban_sidebar_poll_reads.py
@@ -82,15 +82,23 @@ def test_a_write_rereads_only_the_board_that_moved(kanban_root, monkeypatch):
 
 def test_a_memoized_board_still_turns_stalled_when_the_clock_passes_the_cutoff(kanban_root, monkeypatch):
     now = time.time()
+    # Cross the 2 h cutoff inside the memo's max age: only the verdict may move, the rows are not re-read.
     _board(kanban_root / "kanban.db", [
         {"id": "t_probe", "status": "scheduled", "session": "s_a",
-         "events": [("scheduled", {"reason": "grant", "wake_check": "python3 probe.py"}, int(now - H))]},
+         "events": [("scheduled", {"reason": "grant", "wake_check": "python3 probe.py"}, int(now - 2 * H + 10))]},
     ])
     reads = _count_board_reads(monkeypatch)
     assert _snapshot()[6] == {}
-    monkeypatch.setattr(ksa.time, "time", lambda: now + 2 * H)
+    step = (ksa._CACHE_TTL_S + ksa._COUNTS_MAX_AGE_S) / 2
+    assert 10 < step < ksa._COUNTS_MAX_AGE_S
+    monkeypatch.setattr(ksa.time, "time", lambda: now + step)
     assert _snapshot()[6] == {"s_a": 1}
     assert len(reads) == 1  # the rows were read once; only the verdict moved
+    # Past the max age an unchanged board is re-read once (bounded source age), and the verdict holds.
+    monkeypatch.setattr(ksa.time, "time", lambda: now + 2 * H)
+    assert _snapshot()[6] == {"s_a": 1}
+    assert _snapshot()[6] == {"s_a": 1}
+    assert len(reads) == 2
 
 
 def test_a_failed_display_read_is_not_memoized(kanban_root, monkeypatch):
diff --git a/tests/hermes_cli/test_web_board_busy.py b/tests/hermes_cli/test_web_board_busy.py
index 5ca1ded023..f4c615f695 100644
