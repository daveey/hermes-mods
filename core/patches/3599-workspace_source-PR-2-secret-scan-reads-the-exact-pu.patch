+    for sha, (kind, data) in objects.items():
+        if kind == "tag":
+            raise PublishRefused("secret_scan_refused", f"tag object {sha[:12]} in the push range")
+        if kind == "blob" and (line := _blob_secret_line(data)) is not None:
