diff --git a/tests/cron/test_cron_observer_reconnect_bounds.py b/tests/cron/test_cron_observer_reconnect_bounds.py
new file mode 100644
index 00000000000..75f9df35089
--- /dev/null
+++ b/tests/cron/test_cron_observer_reconnect_bounds.py
@@ -0,0 +1,121 @@
+"""Typed/bounded recovery controls with a deterministic clock, never a real outage wait."""
+import asyncio
+from contextlib import asynccontextmanager
+from types import SimpleNamespace
+
+import pytest
+
+from cron import observer_reconnect as recovery
+from hermes_cli.gateway_client import GatewayClientError, GatewayRPCError, GatewayUnavailableError
+
+
+@pytest.mark.parametrize('error,attempted,retries', [
+    (GatewayClientError('lost'), True, True),
+    (GatewayClientError('lost'), False, False),
+    (GatewayRPCError('permission_denied'), True, False),
+    (GatewayUnavailableError('down', 'absent'), True, True),
+    (GatewayUnavailableError('starting', 'starting'), True, True),
+    (GatewayUnavailableError('draining', 'draining'), True, True),
+    (GatewayUnavailableError('failed', 'failed'), True, False),
+])
+def test_transport_retry_is_bounded_and_refusals_fail_closed(monkeypatch, error, attempted, retries):
+    clock, connections, sleeps = [0.0], [], []
+
+    @asynccontextmanager
+    async def connect():
+        connections.append(clock[0])
+        raise error
+        yield
+
+    async def sleep(seconds):
+        sleeps.append(seconds)
+        clock[0] += seconds
+        assert 0 < seconds and clock[0] <= 3, 'reconnect exceeded its retry window'
+
+    async def observe(call):
+        pytest.fail('no connection should reach observation')
+
+    async def probe():
+        monkeypatch.setattr(recovery.asyncio, 'get_running_loop', lambda: SimpleNamespace(time=lambda: clock[0]))
+        monkeypatch.setattr(recovery.asyncio, 'sleep', sleep)
+        monkeypatch.setattr(recovery, 'RECONNECT_SECONDS', 3)
+        with pytest.raises(type(error)) as caught:
+            await recovery.observe_remote(connect, observe, lambda: attempted)
+        assert caught.value is error
+
+    asyncio.run(probe())
+    assert connections == ([0, 2, 3] if retries else [0])
+    assert sleeps == ([2, 1] if retries else [])
+
+
+def test_recovery_ack_does_not_reset_failed_status_budget(monkeypatch):
+    clock = [0.0]
+    calls = []
+
+    class Peer:
+        async def rpc(self, method, **data):
+            calls.append(method)
+            if method == 'cron.status':
+                raise GatewayClientError('lost')
+            return {}
+
+    @asynccontextmanager
+    async def connect():
+        yield Peer()
+
+    async def observe(call):
+        await call('recover', {})
+        return await call('status', {})
+
+    async def sleep(seconds):
+        clock[0] += seconds
+        assert 0 < seconds and clock[0] <= 3, 'successful recovery ACK reset the failed status budget'
+
+    async def probe():
+        monkeypatch.setattr(recovery.asyncio, 'get_running_loop', lambda: SimpleNamespace(time=lambda: clock[0]))
+        monkeypatch.setattr(recovery.asyncio, 'sleep', sleep)
+        monkeypatch.setattr(recovery, 'RECONNECT_SECONDS', 3)
+        with pytest.raises(GatewayClientError):
+            await recovery.observe_remote(connect, observe, lambda: True)
+
+    asyncio.run(probe())
+    assert calls == ['cron.recover', 'cron.status'] * 3
+
+
+def test_successful_status_starts_a_fresh_outage_budget(monkeypatch):
+    clock, connections = [0.0], []
+
+    class Peer:
+        def __init__(self):
+            self.calls = 0
+
+        async def rpc(self, method, **data):
+            self.calls += 1
+            if self.calls == 2:
+                raise GatewayClientError('next outage')
+            clock[0] += 3
+            return {'status': 'started'}
+
+    @asynccontextmanager
+    async def connect():
+        peer = Peer()
+        connections.append(peer)
+        yield peer
+
+    async def observe(call):
+        result = await call('status', {})
+        if len(connections) < 3:
+            await call('status', {})
+        return result
+
+    async def sleep(seconds):
+        clock[0] += seconds
+
+    async def probe():
+        monkeypatch.setattr(recovery.asyncio, 'get_running_loop', lambda: SimpleNamespace(time=lambda: clock[0]))
+        monkeypatch.setattr(recovery.asyncio, 'sleep', sleep)
+        monkeypatch.setattr(recovery, 'RECONNECT_SECONDS', 3)
+        assert await recovery.observe_remote(connect, observe, lambda: True) == {'status': 'started'}
+
+    asyncio.run(probe())
+    assert len(connections) == 3
diff --git a/tests/cron/test_cron_observer_restart.py b/tests/cron/test_cron_observer_restart.py
new file mode 100644
index 00000000000..847aac824dd
--- /dev/null
+++ b/tests/cron/test_cron_observer_restart.py
@@ -0,0 +1,91 @@
+"""A scoped firer observes a canonical owner; losing its socket is not losing the fire."""
+from contextlib import asynccontextmanager
+import json
+
+import pytest
+
+from cron import scheduler_authority as authority
+from hermes_cli import gateway_client
+
+
+@pytest.mark.parametrize('lost_at', ['submit', 'status'])
+@pytest.mark.parametrize('success', [True, False])
+def test_observer_recovers_same_fire_after_restart(monkeypatch, lost_at, success):
+    calls = []
+    connections = []
+    result = [success, 'durable document', 'answer' if success else '', None if success else 'interrupted']
+
+    class Peer:
+        def __init__(self, number):
+            self.number = number
+
+        async def rpc(self, method, **params):
+            calls.append((self.number, method, params))
+            if self.number == 0 and method == 'cron.' + lost_at:
+                raise gateway_client.GatewayClientError(gateway_client.DISCONNECTED)
+            if method == 'cron.submit':
+                return {'session_id': 'session', 'admission_id': 'admission'}
+            if method == 'cron.recover':
+                assert params == {'job_id': 'job', 'request_id': 'fire', 'extra_prompt': None}
+                return {'status': 'terminal', 'session_id': 'session', 'admission_id': 'admission'}
+            assert params == {'session_id': 'session', 'admission_id': 'admission'}
+            return {'status': 'terminal', 'result': result}
+
+    @asynccontextmanager
+    async def connect():
+        peer = Peer(len(connections))
+        connections.append(peer)
+        yield peer
+
+    monkeypatch.setattr(gateway_client, 'connect_gateway', connect)
+    assert authority.run_canonical_job({'id': 'job'}, execution_id='fire') == tuple(result)
+    assert sum(method == 'cron.submit' for _, method, _ in calls) == 1
+    assert len(connections) == 2
+    record = json.loads(authority.journal_path('job', 'fire').read_text())
+    assert record['receipt'] == {'session_id': 'session', 'admission_id': 'admission'}
+
+
+def test_existing_journal_is_recovered_not_resubmitted(monkeypatch):
+    path = authority.journal_path('job', 'fire')
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps({'params': {'job_id': 'job', 'request_id': 'fire', 'extra_prompt': None},
+                                'receipt': None}))
+    calls = []
+
+    class Peer:
+        async def rpc(self, method, **params):
+            calls.append(method)
+            assert method == 'cron.recover', 'an existing fire must not be submitted again'
+            return {'status': 'missing', 'session_id': 'session', 'admission_id': 'admission'}
+
+    @asynccontextmanager
+    async def connect():
+        yield Peer()
+
+    monkeypatch.setattr(gateway_client, 'connect_gateway', connect)
+    with pytest.raises(authority.CronExecutionUnknown):
+        authority.run_canonical_job({'id': 'job'}, execution_id='fire')
+    assert calls == ['cron.recover']
+
+
+def test_recovery_refusal_is_not_treated_as_a_submit_refusal(monkeypatch):
+    monkeypatch.setattr('cron.observer_reconnect.RECONNECT_SECONDS', 0)
+    path = authority.journal_path('job', 'fire')
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps({'params': {'job_id': 'job', 'request_id': 'fire', 'extra_prompt': None},
+                                'receipt': None}))
+    calls = []
+
+    class Peer:
+        async def rpc(self, method, **params):
+            calls.append(method)
+            raise gateway_client.GatewayRPCError('permission_denied')
+
+    @asynccontextmanager
+    async def connect():
+        yield Peer()
+
+    monkeypatch.setattr(gateway_client, 'connect_gateway', connect)
+    with pytest.raises(authority.CronExecutionUnknown):
+        authority.run_canonical_job({'id': 'job'}, execution_id='fire')
+    assert calls == ['cron.recover']
diff --git a/tests/cron/test_cron_owner_restart_pending.py b/tests/cron/test_cron_owner_restart_pending.py
new file mode 100644
index 00000000000..663a4a278f9
--- /dev/null
+++ b/tests/cron/test_cron_owner_restart_pending.py
@@ -0,0 +1,64 @@
+"""A replacement owner runs only queued admissions, never an interrupted started fire."""
+from contextlib import asynccontextmanager
+
+import pytest
+
+from cron import executions, jobs, scheduler
+from gateway import session_cron
+from hermes_cli import gateway_client
+from hermes_state_runtime import claim_session_input, recover_session_inputs, settle_session_input
+from tests.cron import test_cron_recovery as helpers
+
+
+@pytest.mark.parametrize('started', [False, True], ids=['queued', 'unknown-started'])
+def test_restart_pending_admission_never_resubmits(tmp_path, monkeypatch, started):
+    with jobs.use_cron_store(tmp_path / 'cron'):
+        job = jobs.create_job(prompt='controlled pending fire', schedule='every 1h', deliver='local')
+        owner, db = helpers._owner(tmp_path, monkeypatch)
+        active, databases, calls, connections = [owner], [db], [], []
+        fire = executions.create_execution(job['id'], source='test')['id']
+        monkeypatch.setattr('cron.observer_reconnect.RECONNECT_DELAY', 0)
+
+        class Peer:
+            async def rpc(self, method, **params):
+                op = method.removeprefix('cron.')
+                calls.append(op)
+                if len(connections) == 1 and op == 'status':
+                    databases[-1].close()
+                    replacement, replacement_db = helpers._owner(tmp_path, monkeypatch)
+                    active.append(replacement)
+                    databases.append(replacement_db)
+                    recover_session_inputs(replacement_db, epoch=replacement.epoch)
+                    raise gateway_client.GatewayClientError(gateway_client.DISCONNECTED)
+                answer = await session_cron.operation(active[-1], op, params)
+                if op == 'submit' and started:
+                    claim_session_input(databases[-1], epoch=active[-1].epoch, session_id=answer['session_id'])
+                if op == 'recover' and not started:
+                    assert answer['status'] == 'queued'
+                    row = claim_session_input(databases[-1], epoch=active[-1].epoch, session_id=answer['session_id'])
+                    settle_session_input(databases[-1], epoch=active[-1].epoch,
+                                         admission_id=row['admission_id'], generation=row['generation'],
+                                         outcome='completed',
+                                         result={'result': {'cron_result': [True, 'doc', 'answer', None]}, 'usage': {}})
+                return answer
+
+        @asynccontextmanager
+        async def connect():
+            connections.append(Peer())
+            yield connections[-1]
+
+        monkeypatch.setattr(gateway_client, 'connect_gateway', connect)
+        try:
+            scheduler._run_one_job_body(dict(jobs.get_job(job['id']), execution_id=fire))
+            assert calls.count('submit') == 1
+            assert calls.count('recover') == 1
+            assert len(connections) == 2
+            current = jobs.get_job(job['id'])
+            if started:
+                assert current['state'] == 'paused'
+                assert executions.get_execution(fire)['status'] == 'unknown'
+            else:
+                assert current['last_status'] == 'ok'
+                assert executions.get_execution(fire)['status'] == 'completed'
+        finally:
+            databases[-1].close()
diff --git a/tests/cron/test_cron_owner_restart_receipt.py b/tests/cron/test_cron_owner_restart_receipt.py
new file mode 100644
index 00000000000..8bc83e1e764
--- /dev/null
+++ b/tests/cron/test_cron_owner_restart_receipt.py
@@ -0,0 +1,82 @@
+"""Real owner/admission/execution stores across replacement of the canonical owner.
+
+The transport drop is injected, not a live service restart. The workload is a
+controlled local result; no model, external side effects or production jobs run.
+"""
+from contextlib import asynccontextmanager
+
+import pytest
+
+from cron import executions, jobs, scheduler
+from gateway import session_cron
+from gateway.session_contract import SessionRef
+from hermes_cli import gateway_client
+from hermes_state_runtime import claim_session_input, settle_session_input
+from tests.cron import test_cron_recovery as helpers
+
+
+@pytest.mark.parametrize('success', [True, False], ids=['completed', 'shutdown-interrupted'])
+def test_firer_books_durable_terminal_after_owner_replacement(tmp_path, monkeypatch, success):
+    with jobs.use_cron_store(tmp_path / 'cron'):
+        job = jobs.create_job(prompt='controlled restart proof', schedule='every 1h', deliver='local')
+        owner, db = helpers._owner(tmp_path, monkeypatch)
+        owners, databases, connections, submissions = [owner], [db], [], []
+        fire = executions.create_execution(job['id'], source='test')['id']
+        original_run = scheduler.run_job
+        expected = (True, 'document', 'answer', None) if success else (
+            False, 'interrupted document', '', 'Gateway shutdown interrupted the controlled workload')
+
+        def workload(job, **kwargs):
+            if session_cron.current_execution() is not None:
+                return expected
+            return original_run(job, **kwargs)
+
+        monkeypatch.setattr(scheduler, 'run_job', workload)
+        monkeypatch.setattr('cron.observer_reconnect.RECONNECT_DELAY', 0)
+
+        class Peer:
+            async def rpc(self, method, **params):
+                op = method.removeprefix('cron.')
+                if len(connections) == 1 and op == 'status':
+                    # The owner has settled, but its final reply never reaches the
+                    # external firer. A fresh owner reads the same durable receipt.
+                    databases[-1].close()
+                    replacement, replacement_db = helpers._owner(tmp_path, monkeypatch)
+                    owners.append(replacement)
+                    databases.append(replacement_db)
+                    raise gateway_client.GatewayClientError(gateway_client.DISCONNECTED)
+                answer = await session_cron.operation(owners[-1], op, params)
+                if op == 'submit':
+                    submissions.append(params)
+                    active = owners[-1]
+                    row = claim_session_input(databases[-1], epoch=active.epoch,
+                                              session_id=answer['session_id'])
+                    policy = next(iter(active.runner.adapters.values())).policies[answer['session_id']]
+                    try:
+                        await session_cron.execute(active, SessionRef(active.profile_id, answer['session_id']), row, policy)
+                    except RuntimeError:
+                        if success:
+                            raise
+                    settle_session_input(databases[-1], epoch=active.epoch,
+                                         admission_id=row['admission_id'], generation=row['generation'],
+                                         outcome='completed' if success else 'failed',
+                                         result=active.pending_results.pop(row['admission_id']))
+                return answer
+
+        @asynccontextmanager
+        async def connect():
+            connections.append(Peer())
+            yield connections[-1]
+
+        monkeypatch.setattr(gateway_client, 'connect_gateway', connect)
+        try:
+            scheduler._run_one_job_body(dict(jobs.get_job(job['id']), execution_id=fire))
+            assert len(connections) == 2
+            assert len(submissions) == 1
+            assert owners[0].epoch != owners[1].epoch
+            assert executions.get_execution(fire)['status'] == ('completed' if success else 'failed')
+            assert jobs.get_job(job['id'])['last_status'] == ('ok' if success else 'error')
+            assert jobs.get_job(job['id'])['state'] != 'paused'
+            assert executions.recover_interrupted_executions() == 0
+        finally:
+            databases[-1].close()
