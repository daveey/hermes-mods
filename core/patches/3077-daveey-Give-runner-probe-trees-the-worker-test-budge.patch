Date: Thu, 12 Nov 2026 03:34:02 +0000
Subject: [PATCH] [daveey] Give runner probe trees the worker test-budget
 imports

---
 tests/_fixtures/runner_probe.py               | 22 +++++++++++++++++++
 tests/scripts/test_run_tests_parallel.py      |  3 +++
 tests/scripts/test_run_tests_parallel_rss.py  |  3 +++
 .../test_run_tests_parallel_slow_cases.py     |  3 +++
 4 files changed, 31 insertions(+)
 create mode 100644 tests/_fixtures/runner_probe.py

diff --git a/tests/_fixtures/runner_probe.py b/tests/_fixtures/runner_probe.py
new file mode 100644
index 0000000000..01fc187e97
--- /dev/null
+++ b/tests/_fixtures/runner_probe.py
@@ -0,0 +1,22 @@
+"""[daveey] Shared pieces of the throwaway runner trees that runner tests build.
+
+The runner reads the account's worker test-budget policy
+(``hermes_cli.worker_compute_capacity``) and its receipts helper
+(``scripts/worker_test_budget.py``), so a probe tree needs both.
+"""
+from __future__ import annotations
+
+import shutil
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+
+
+def add_runner_imports(root: Path) -> None:
+    """Copy the receipts helper and link the real top-level Python modules (no pytest config)."""
+    shutil.copy2(REPO / "scripts" / "worker_test_budget.py", root / "scripts")
+    for entry in REPO.iterdir():
+        package = entry.is_dir() and (entry / "__init__.py").exists() and entry.name not in {"scripts", "tests"}
+        module = entry.suffix == ".py" and entry.name != "conftest.py"
+        if (package or module) and not (root / entry.name).exists():
+            (root / entry.name).symlink_to(entry)
diff --git a/tests/scripts/test_run_tests_parallel.py b/tests/scripts/test_run_tests_parallel.py
index c3cbd134c1..94974ac75b 100644
--- a/tests/scripts/test_run_tests_parallel.py
+++ b/tests/scripts/test_run_tests_parallel.py
@@ -31,6 +31,8 @@ from pathlib import Path
 
 import pytest
 
+from tests._fixtures.runner_probe import add_runner_imports
+
 
 @pytest.fixture(autouse=True)
 def isolated_probe_environment(monkeypatch):
@@ -49,6 +51,7 @@ def _probe_root(tmp_path):
     shutil.copy2(real / "run_tests_parallel_rss.py", scripts)
     shutil.copy2(real / "run_tests_launch.py", scripts)
     shutil.copy2(real / "run_tests_fork_child.py", scripts)
+    add_runner_imports(root)
     # The runner shares the platforms() spec resolver with the CI lane selector.
     shutil.copy2(real / "ci" / "list_os_marked_tests.py", scripts / "ci")
     return root
