From b1a9b5ddb760db86b3291fb45dd191a4d62a17e2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 19:23:16 +0000
Subject: [PATCH] fix(sync): conservatively reopen when pread is unavailable
 [daveey]

---
 hermes_cli/kanban_sync_board_watch.py         |  2 ++
 .../test_kanban_sync_checkpoint_keep.py       | 25 +++++++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/hermes_cli/kanban_sync_board_watch.py b/hermes_cli/kanban_sync_board_watch.py
index 02ebe98897..da71458356 100644
--- a/hermes_cli/kanban_sync_board_watch.py
+++ b/hermes_cli/kanban_sync_board_watch.py
@@ -53,6 +53,8 @@ def parsed_from(conn: sqlite3.Connection, real: str) -> Optional[list]:
     stores a DESC index in ascending order, and a reader that parsed format 4 walks it the wrong
     way (wrong rows, no error). SQLite writes the number once, with the first table, so on a
     live board the main file's copy never changes after that. Read with a lock-safe ``pread``."""
+    if not hasattr(os, "pread"):  # no lock-safe header evidence on this platform: never keep
+        return None
     header = pread_lock_safe(real, 44, 4)
     return None if header is None else [header] + schema_rows(conn)
 
diff --git a/tests/hermes_cli/test_kanban_sync_checkpoint_keep.py b/tests/hermes_cli/test_kanban_sync_checkpoint_keep.py
index 3a3e892e87..c137633979 100644
--- a/tests/hermes_cli/test_kanban_sync_checkpoint_keep.py
+++ b/tests/hermes_cli/test_kanban_sync_checkpoint_keep.py
@@ -100,6 +100,31 @@ def _moved(watch, path):
     return watch._conns[str(path)][0][2:] != (stat.st_mtime_ns, stat.st_size)
 
 
+def test_missing_pread_reads_and_reopens_conservatively(board, monkeypatch):
+    """Platforms without pread still read boards; no checkpoint may keep their reader."""
+    path, writer, watch = board
+    image = _two_images(writer, path)
+    monkeypatch.delattr(os, "pread", raising=False)
+    gen, row = watch.query(path, VALUE, unchanged_ok=True)
+    assert row == ("b",)
+    old = _reader(watch, path)
+    assert watch._conns[str(path)][6] is None
+    writer.execute("INSERT INTO pad VALUES (?)", (PAD,))
+    _checkpoint(writer, "TRUNCATE")
+    assert _moved(watch, path)
+    assert watch.query(path, VALUE, unchanged_ok=True) == (gen, ("b",))
+    assert _reader(watch, path) is not old
+    writer.execute("UPDATE t SET v = 'later'")
+    assert watch.query(path, VALUE, unchanged_ok=True) == (gen, ("later",))
+    _checkpoint(writer, "TRUNCATE")
+    old = _reader(watch, path)
+    _rewrite(path, image)
+    assert _moved(watch, path)
+    assert watch.query(path, VALUE, unchanged_ok=True) == (gen, ("a",))
+    assert _reader(watch, path) is not old
+    assert _runs("sync.reader_keep/checkpoint") == 0
+
+
 def test_same_inode_raw_restore_reopens(board):
     path, writer, watch = board
     image = _two_images(writer, path)
-- 
