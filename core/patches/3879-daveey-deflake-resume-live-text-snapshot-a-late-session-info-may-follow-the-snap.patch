From 486a7a77b62797cfcca6cbd81bfec977f98952d5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 21:13:32 +0000
Subject: [PATCH] [daveey] deflake resume live-text snapshot: a late
 session.info may follow the snapshot

test_reattach_gets_head_and_tail_then_future_deltas_once pinned the second
resume's last_sequence to the stream's head read after the resume returned.
The resume reply waits up to REPLY_INVENTORY_BUDGET_S (2 s) for the session
inventory; on a throttled CI runner the first resume misses it and gets the
pending shape, so the build is marked deferred. When it finishes during the
second resume (after that resume's attach snapshot, while reply_info waits on
the shared build), _settle publishes a session.info frame, so the head is one
past the snapshot (CI run 43497244212: assert 3 == 4, call 3.02 s).

That frame is correct product behaviour. The test now records TAIL's sequence
and asserts tail_seq <= last_sequence <= head: the snapshot covers TAIL, and
the existing deltas == ['NEXT'] check still proves later deltas arrive exactly
once. The NEXT-delivery wait goes from 10 s to 30 s (returns on the event).

RED on main: holding session_inventory until the second resume's
refresh_profile_hooks call (budget 1 s) fails test[True] with assert 3 == 4
three runs out of three; GREEN with this change, also under a 70% SIGSTOP
duty cycle.
---
 tests/gateway/test_resume_live_text_snapshot.py | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/tests/gateway/test_resume_live_text_snapshot.py b/tests/gateway/test_resume_live_text_snapshot.py
index 45b513f075..4f9b04f557 100644
--- a/tests/gateway/test_resume_live_text_snapshot.py
+++ b/tests/gateway/test_resume_live_text_snapshot.py
@@ -34,6 +34,8 @@ async def test_reattach_gets_head_and_tail_then_future_deltas_once(tmp_path, mon
     assert first['inflight'] == {'assistant': 'HEAD ', 'streaming': True, 'user': '', 'segment_only': True}
     await authority.detach(actor, first['subscription_id'])
     _delta(authority, ref, 'TAIL ')  # published while nobody was attached
+    events = authority.sessions[ref.session_id].event_stream
+    tail_seq = events.watermark()[1]
     seen, got_next = [], threading.Event()  # the fanout writes from its own daemon thread
 
     def write(frame):
@@ -45,9 +47,12 @@ async def test_reattach_gets_head_and_tail_then_future_deltas_once(tmp_path, mon
                                                           'close': staticmethod(lambda: None)})()
     second = await _resume_keeping_transport(authority, actor, ref, omit_messages=omit)
     assert second['inflight']['assistant'] == 'HEAD TAIL '
-    assert second['last_sequence'] == authority.sessions[ref.session_id].event_stream.watermark()[1]
+    # The snapshot covers TAIL. Not pinned to the stream's head: an inventory past the reply budget
+    # (``REPLY_INVENTORY_BUDGET_S``, easily missed on a throttled runner) publishes a late ``session.info``
+    # that can land after the snapshot, while the resume is still building its reply.
+    assert tail_seq <= second['last_sequence'] <= events.watermark()[1]
     _delta(authority, ref, 'NEXT')
-    got_next.wait(10)
+    got_next.wait(30)
     assert got_next.is_set()
     deltas = [f['params']['payload']['text'] for f in seen if f['params']['type'] == 'message.delta']
     assert deltas == ['NEXT']  # the snapshot covers HEAD+TAIL; later frames arrive exactly once
-- 
