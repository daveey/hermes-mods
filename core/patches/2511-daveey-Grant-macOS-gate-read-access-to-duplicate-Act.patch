From 6948d8bc684bfd6b61ffe847aeef0bcacb2f4512 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:59:39 +0000
Subject: [PATCH] [daveey] Grant macOS gate read access to duplicate Actions
 runs

Proof: new permission regression failed before YAML fix; targeted CI suites 398 passed, 8 skipped; scripts/check 18 gates passed.
---
 .github/workflows/ci.yaml               | 3 +++
 tests/ci/test_macos_state_superseded.py | 5 +++++
 2 files changed, 8 insertions(+)

diff --git a/.github/workflows/ci.yaml b/.github/workflows/ci.yaml
index a5081d8b90..b0837233ca 100644
--- a/.github/workflows/ci.yaml
+++ b/.github/workflows/ci.yaml
@@ -605,6 +605,9 @@ jobs:
   # The separately required fork macOS lane fails closed on unknown selection.
   macos-state-required:
     name: macOS state required (v1)
+    permissions:
+      contents: read
+      actions: read
     needs: [detect, hermes-state-macos]
     if: ${{ always() }}
     runs-on: blacksmith-2vcpu-ubuntu-2404
diff --git a/tests/ci/test_macos_state_superseded.py b/tests/ci/test_macos_state_superseded.py
index a8807a60a3..9eeb26c9a0 100644
--- a/tests/ci/test_macos_state_superseded.py
+++ b/tests/ci/test_macos_state_superseded.py
@@ -8,6 +8,11 @@ from tests.ci.test_required_results import _OWN, _api_down, _dup, _fake_fetch, _
 from tests.ci.test_macos_state_routing import ROOT, context, gha, workflow
 
 
+def test_macos_gate_grants_private_actions_lookup_and_checkout_permissions():
+    job = workflow("ci.yaml")["jobs"]["macos-state-required"]
+    assert job["permissions"] == {"contents": "read", "actions": "read"}
+
+
 def needs(selected="true", lane="cancelled", detect="success"):
     return {"detect": {"result": detect, "outputs": {"hermes_state": selected}},
             "hermes-state-macos": {"result": lane}}
-- 
