From c5d5cbe1b5adaee91dbfc570c1709860fef86ef5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 00:41:39 +0000
Subject: [PATCH] test(ci): use case-insensitive workflow proxy keys only once

---
 .github/workflows/cache-save-timeout-smoke.yml | 2 --
 1 file changed, 2 deletions(-)

diff --git a/.github/workflows/cache-save-timeout-smoke.yml b/.github/workflows/cache-save-timeout-smoke.yml
index cbf353bcd29..197f54617d3 100644
--- a/.github/workflows/cache-save-timeout-smoke.yml
+++ b/.github/workflows/cache-save-timeout-smoke.yml
@@ -62,9 +62,7 @@ jobs:
         timeout-minutes: 1
         uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
         env:
-          HTTPS_PROXY: ${{ env.CACHE_PROBE_URL }}
           https_proxy: ${{ env.CACHE_PROBE_URL }}
-          NO_PROXY: ''
           no_proxy: ''
         with:
           path: ${{ runner.temp }}/cache-timeout-probe/payload
-- 
2.55.0

