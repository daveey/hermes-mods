     return _kb()._sync.held_by_us_live(conn, task_id, now)
 
 
-_LEFTOVER_CLAIM_STATUSES = ("ready", "todo", "review", "blocked", "scheduled", "done")
+_LEFTOVER_CLAIM_STATUSES = ("ready", "todo", "review", "blocked", "scheduled", "done", "triage")
 
 
