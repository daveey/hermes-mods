From 69c5e1b193c16dc8c3caef8b9a880e6fec2d8b6c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 21:07:15 +0000
Subject: [PATCH] [daveey] Keep pricing expiry eviction visible to payload
 memos

Advance pricing generation under the catalog lock when readers evict expired entries. This prevents the empty expired-key tuple from restoring a pre-expiry payload memo key.

Proof: both consumer-order regressions fail on the previous code; 41 focused and 188 pricing consumer tests pass; omitting the eviction generation increment kills both new regressions.
---
 hermes_cli/models_pricing.py                  |  3 +++
 ...test_model_options_pricing_invalidation.py | 20 +++++++++++++++++++
 2 files changed, 23 insertions(+)

diff --git a/hermes_cli/models_pricing.py b/hermes_cli/models_pricing.py
index 215756036ad30aa231154c98aef47d464c7e4f5a..9cd609c8147faba54306140b50f430fb9ba6bab7 100644
--- a/hermes_cli/models_pricing.py
+++ b/hermes_cli/models_pricing.py
@@ -50,6 +50,7 @@ def pricing_cache_version() -> tuple:
 
 def _cached_catalog(cache_key: str) -> Optional[dict[str, dict[str, Any]]]:
     """The cached catalog for *cache_key*, or None to go fetch it."""
+    global _pricing_cache_generation
     with _pricing_cache_lock:
         cached = _pricing_cache.get(cache_key)
         if cached is None:
@@ -58,6 +59,8 @@ def _cached_catalog(cache_key: str) -> Optional[dict[str, dict[str, Any]]]:
         if retry_after is not None and time.monotonic() >= retry_after:
             _pricing_cache.pop(cache_key, None)
             _pricing_cache_retry_after.pop(cache_key, None)
+            # Removing the expired-key stamp must not restore a pre-expiry memo key.
+            _pricing_cache_generation += 1
             return None
         return cached
 
diff --git a/tests/hermes_cli/test_model_options_pricing_invalidation.py b/tests/hermes_cli/test_model_options_pricing_invalidation.py
index c0048a15c7616c96a8c26625e5751176292aa1c6..54bcba16b97dc9673f4bf08cd0db1facf5452710 100644
--- a/tests/hermes_cli/test_model_options_pricing_invalidation.py
+++ b/tests/hermes_cli/test_model_options_pricing_invalidation.py
@@ -60,3 +60,23 @@ def test_pricing_changes_invalidate_payload_memo(picker, monkeypatch, change):
     fresh = call()
     assert fresh != before  # positive control: this input changes real pricing decoration
     assert got == fresh
+
+
+@pytest.mark.parametrize("evict_first", [False, True])
+def test_expired_prices_never_resurrect_after_reader_eviction(picker, monkeypatch, evict_first):
+    call, clock, _tier = picker
+    pricing._cache_catalog("first", CATALOG, ttl_seconds=1.0)
+    before = call()
+    assert call() == before
+    clock["t"] += 2
+    if evict_first:
+        assert pricing._cached_catalog("first") is None
+    # Cover both another consumer evicting first and the picker doing its own eviction.
+    # Keep the memo clock frozen so TTL expiry cannot hide an obsolete stamp's reuse.
+    for _ in range(3):
+        got = call()
+        with monkeypatch.context() as patch:
+            patch.setattr(inventory, "_MEMO_ENABLED", False)
+            fresh = call()
+        assert fresh != before
+        assert got == fresh
-- 
