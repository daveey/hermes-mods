Subject: [PATCH 6635] Small fixes and test-harness hardening

Public mirror of source commit 1c39f03b01362476ce4848257b6e7a7c07e6d661.

---
diff --git a/tests/tools/test_mcp_child_filter_supervisor.py b/tests/tools/test_mcp_child_filter_supervisor.py
index 8ebc42cdb17afe3ad748ee3e14ae93ec1f60af0f..0fc6fd3a780225aca6707ec9f1b19b33082bc138 100644
--- a/tests/tools/test_mcp_child_filter_supervisor.py
+++ b/tests/tools/test_mcp_child_filter_supervisor.py
@@ -41,13 +41,47 @@
         assert process_identity._supervisor is None, "releasing the last group stops the supervisor"
 
 
-def test_a_supervisor_whose_spawn_has_not_returned_yet_is_still_not_an_mcp_child(monkeypatch):
-    """``_supervisor`` is assigned only after the spawn returns; a scan in that gap must still skip it."""
+@pytest.mark.parametrize("empty_argv", [False, True])
+def test_a_supervisor_whose_spawn_has_not_returned_yet_is_still_not_an_mcp_child(monkeypatch, empty_argv):
+    """The returned supervisor is unpublished; exec can also transiently hide its argv."""
+    import psutil
+
     monkeypatch.setattr(process_identity, "_supervisor", None)
     supervisor = process_identity._spawn_supervisor()  # running, but not yet published as _supervisor
     assert supervisor is not None
+    original_cmdline = psutil.Process.cmdline
+    inspected = []
+
+    def cmdline(proc):
+        if empty_argv and proc.pid == supervisor.pid:
+            inspected.append(proc.pid)
+            return []
+        return original_cmdline(proc)
+
+    monkeypatch.setattr(psutil.Process, "cmdline", cmdline)
     try:
         assert mcp_tool_lifecycle._filter_mcp_children({supervisor.pid}) == set()
+        if empty_argv:
+            assert inspected == [supervisor.pid]
     finally:
         supervisor.stdin.close()
         supervisor.wait(timeout=10)
+
+
+def test_an_uninspectable_child_is_not_adopted_but_an_ordinary_mcp_child_is(monkeypatch):
+    import psutil
+
+    calls = []
+
+    class Child:
+        def __init__(self, pid):
+            self.pid = pid
+
+        def cmdline(self):
+            calls.append(self.pid)
+            return [] if self.pid == 1 else ["python", "fixture_mcp_server.py"]
+
+    monkeypatch.setattr(psutil, "Process", Child)
+    assert mcp_tool_lifecycle._filter_mcp_children({1, 2}) == {2}
+    assert sorted(calls) == [1, 2]
+
diff --git a/tools/mcp_tool_lifecycle.py b/tools/mcp_tool_lifecycle.py
index 4f06c10640bf12d371224bafd78a1469cd8e309d..b8acb693073eb0827e0d41803b7829955d70f036 100644
--- a/tools/mcp_tool_lifecycle.py
+++ b/tools/mcp_tool_lifecycle.py
@@ -103,6 +103,8 @@
             argv = psutil.Process(pid).cmdline()
         except (psutil.NoSuchProcess, psutil.AccessDenied, OSError):
             continue  # raced away or zombie — cannot be our fresh server, unsafe to track
+        if not argv:
+            continue  # an exec/zombie snapshot cannot establish this is our fresh MCP server
         if is_owner_death_supervisor(argv):
             continue  # the shared reaper of every owned child; MCP teardown must never kill it
         if not any(marker in arg for arg in argv[1:] for marker in _NON_MCP_CHILD_CMDLINE_MARKERS):
