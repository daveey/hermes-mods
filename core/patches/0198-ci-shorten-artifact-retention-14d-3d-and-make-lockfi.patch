From 0bbb5995aa521e4ac6eff555f07f37995eecc62c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 01:08:07 +0000
Subject: [PATCH] ci: shorten artifact retention (14d->3d) and make lockfile
 diff upload non-fatal (#25)

---
diff --git a/.github/workflows/desktop-bundle-smoke.yml b/.github/workflows/desktop-bundle-smoke.yml
index 2bf0107439ac4d1c521a28002f7c7336b85b96dd..296409fe92a93502dfac37224c4975a8ce483233 100644
--- a/.github/workflows/desktop-bundle-smoke.yml
+++ b/.github/workflows/desktop-bundle-smoke.yml
@@ -239,7 +239,7 @@ jobs:
           # Only evidence, never the isolated profile or installed application.
           path: ${{ env.SMOKE_ROOT }}/out
           if-no-files-found: warn
-          retention-days: 14
+          retention-days: 3
 
   windows:
     name: Windows install and chat
diff --git a/.github/workflows/e2e-desktop-core.yml b/.github/workflows/e2e-desktop-core.yml
index 9a67577175dc3f0917211421950fa299bf03afce..81bf296fa04dcc9a803f08b21049dbba0fac191c 100644
--- a/.github/workflows/e2e-desktop-core.yml
+++ b/.github/workflows/e2e-desktop-core.yml
@@ -109,6 +109,6 @@ jobs:
           path: |
             apps/desktop/test-results/core
             apps/desktop/playwright-report/core
-          retention-days: 14
+          retention-days: 3
           overwrite: true
           if-no-files-found: ignore
diff --git a/.github/workflows/e2e-desktop-update.yml b/.github/workflows/e2e-desktop-update.yml
index 6219c076283f87a1857a6c8cfaa49e2f34141ddc..330c8cf5529e4ac1e85cf7a29354979b537c88e2 100644
--- a/.github/workflows/e2e-desktop-update.yml
+++ b/.github/workflows/e2e-desktop-update.yml
@@ -126,6 +126,6 @@ jobs:
           path: |
             apps/desktop/test-results/update
             apps/desktop/playwright-report/update
-          retention-days: 14
+          retention-days: 3
           overwrite: true
           if-no-files-found: ignore
diff --git a/.github/workflows/e2e-desktop.yml b/.github/workflows/e2e-desktop.yml
index a3e6bb4123e4823a508c86116a52db137ebe921e..69f9a0e8dba926b1aeb6429fffb64adf54cae208 100644
--- a/.github/workflows/e2e-desktop.yml
+++ b/.github/workflows/e2e-desktop.yml
@@ -126,7 +126,7 @@ jobs:
         with:
           name: playwright-report-${{ github.sha }}
           path: apps/desktop/playwright-report
-          retention-days: 14
+          retention-days: 3
           overwrite: true
 
       # ── Upload test results (screenshots, traces, diffs) ───────────────
@@ -137,7 +137,7 @@ jobs:
         with:
           name: playwright-test-results-${{ github.sha }}
           path: apps/desktop/test-results
-          retention-days: 14
+          retention-days: 3
           overwrite: true
 
       # ── Upload just the visual diffs (small, fast to review) ──────────
@@ -151,7 +151,7 @@ jobs:
             apps/desktop/test-results/**/*-diff.png
             apps/desktop/test-results/**/*-actual.png
             apps/desktop/test-results/**/*-expected.png
-          retention-days: 14
+          retention-days: 3
           overwrite: true
           if-no-files-found: ignore
 
diff --git a/.github/workflows/install-e2e-macos-run.yml b/.github/workflows/install-e2e-macos-run.yml
index abf9712292ed3f76f2fd720bec8d26bfba06affb..2c1559488d88c52513e4fa11b1ddd739d3c97b79 100644
--- a/.github/workflows/install-e2e-macos-run.yml
+++ b/.github/workflows/install-e2e-macos-run.yml
@@ -202,7 +202,7 @@ jobs:
         with:
           name: ${{ steps.artifact.outputs.name }}
           path: ${{ runner.temp }}/e2e-logs
-          retention-days: 14
+          retention-days: 3
           if-no-files-found: ignore
 
   # ---- arm 3: the real signed bundle pair, in-app update ------------------
@@ -290,5 +290,5 @@ jobs:
         with:
           name: ${{ steps.artifact.outputs.name }}
           path: ${{ runner.temp }}/e2e-logs
-          retention-days: 14
+          retention-days: 3
           if-no-files-found: ignore
diff --git a/.github/workflows/install-e2e-run.yml b/.github/workflows/install-e2e-run.yml
index 762934ac4992608be3cbb30782a918adedb3e2d5..48153ac12933f3ce3e535594b27a32de9a201031 100644
--- a/.github/workflows/install-e2e-run.yml
+++ b/.github/workflows/install-e2e-run.yml
@@ -180,5 +180,5 @@ jobs:
           # times per route, and same-named artifacts collide.
           name: ${{ steps.artifact.outputs.name }}-${{ github.sha }}
           path: ${{ runner.temp }}/e2e-logs
-          retention-days: 14
+          retention-days: 3
           if-no-files-found: ignore
diff --git a/.github/workflows/install-e2e-windows-run.yml b/.github/workflows/install-e2e-windows-run.yml
index dff4b319558b328e42b8ba580952ae014217080b..c7ecd17d8ca0ba2bbdd04c3d557571b60c3f3707 100644
--- a/.github/workflows/install-e2e-windows-run.yml
+++ b/.github/workflows/install-e2e-windows-run.yml
@@ -166,7 +166,7 @@ jobs:
             ${{ runner.temp }}/hermes-bundled-update/home/logs/
             ${{ runner.temp }}/hermes-bundled-update-recording.mkv
           if-no-files-found: error
-          retention-days: 14
+          retention-days: 3
   e2e:
     # Short static name on purpose: name expressions render UNEXPANDED on
     # skipped jobs.
@@ -293,7 +293,7 @@ jobs:
           name: install-e2e-known-${{ steps.update.outputs.known_failure }}--${{ inputs.leg-id }}
           path: gui-e2e-proof/known-failure.json
           if-no-files-found: error
-          retention-days: 14
+          retention-days: 3
 
       - name: Stop screen recording
         if: always()
@@ -335,5 +335,5 @@ jobs:
         with:
           name: install-e2e-logs-${{ inputs.leg-id }}
           path: gui-e2e-proof
-          retention-days: 14
+          retention-days: 3
           if-no-files-found: ignore
diff --git a/.github/workflows/install-e2e.yml b/.github/workflows/install-e2e.yml
index 34cadfd5b762c930c500bbd000b8dbea172ff890..b56174e25756bfe88477e5c63d9588d89816bc33 100644
--- a/.github/workflows/install-e2e.yml
+++ b/.github/workflows/install-e2e.yml
@@ -365,7 +365,7 @@ jobs:
           name: install-e2e-player
           path: tests/install/e2e-assets/playback.html
           archive: false
-          retention-days: 14
+          retention-days: 3
           if-no-files-found: error
 
   # Strict source-matrix gate (release runs). needs collapses each matrix to
diff --git a/.github/workflows/lockfile-diff.yml b/.github/workflows/lockfile-diff.yml
index 28853595aecf3714b5370ef62d70ada2065acecf..8e9db7522054f4de4ae4ed1e27990bfb2221ecc3 100644
--- a/.github/workflows/lockfile-diff.yml
+++ b/.github/workflows/lockfile-diff.yml
@@ -106,6 +106,8 @@ jobs:
           if-no-files-found: ignore
 
       - name: Upload diff artifact
+        # Informational: an artifact-quota hit must not fail the job.
+        continue-on-error: true
         uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
         with:
           name: lockfile-diff
diff --git a/.github/workflows/windows-install-update-e2e.yml b/.github/workflows/windows-install-update-e2e.yml
index ed98a3640822899ef58ad836c253e7e9b35d098e..0e8cfca0b192159b9b9423f2307925f0e5fb586a 100644
--- a/.github/workflows/windows-install-update-e2e.yml
+++ b/.github/workflows/windows-install-update-e2e.yml
@@ -130,7 +130,7 @@ jobs:
           name: windows-install-update-e2e-${{ github.run_attempt }}
           path: ${{ runner.temp }}/win-update-e2e
           if-no-files-found: ignore
-          retention-days: 14
+          retention-days: 3
 
       - name: No leftover Python / Hermes processes
         # Backstop for each journey's teardown: nothing a machine started may outlive it.
-- 
2.55.0

