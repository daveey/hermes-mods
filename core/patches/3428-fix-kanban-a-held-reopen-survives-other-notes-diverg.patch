From 58d31d77a25385ecf768be6e8e2874b9f4492e84 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 07:50:06 +0000
Subject: [PATCH] fix(kanban): a held reopen survives other notes; divergence
 keeps a live reopen [daveey]

Review of #1958 @e0d9b03f22 (t_01a1d3c8473828b8):

- Blocking: `_restore_held` read the newest `stale_wake_ignored` of any
  source and bailed unless it came from the apply guard. A push-strip note
  written between the held row's page and the reopen event's page made the
  restore give up, so the card stayed done locally over a legitimate Board
  reopen. It now selects the newest note whose source is `apply`.
  Regression: test_a_push_strip_note_between_the_pages_does_not_lose_the_reopen
  (RED on e0d9b03f22).
- Nit: `_stale_lifecycle`'s run-less branch checked only the replica's log,
  so an uncaptured local reopen (the case repair_divergence exists for) was
  adopted back to done. Both logs must now hold the card terminal.
  Regression: test_divergence_repair_still_sends_an_uncaptured_local_reopen
  (RED on e0d9b03f22).
- Nit: `terminal_hold` ran `PRAGMA table_info` per call. It now runs one
  query and falls back to `NULL AS uid` only on a pre-uid schema error.
---
 hermes_cli/kanban_sync_divergence.py          |  6 ++-
 hermes_cli/kanban_terminal_guard.py           | 30 ++++++++-----
 .../test_kanban_stale_wake_terminal.py        | 43 +++++++++++++++++++
 3 files changed, 67 insertions(+), 12 deletions(-)

diff --git a/hermes_cli/kanban_sync_divergence.py b/hermes_cli/kanban_sync_divergence.py
index 189ea4603c..401d99c88f 100644
--- a/hermes_cli/kanban_sync_divergence.py
+++ b/hermes_cli/kanban_sync_divergence.py
@@ -166,10 +166,12 @@ def _stale_lifecycle(live: sqlite3.Connection, shadow: sqlite3.Connection, row:
     copy. [daveey]"""
     if not run_uid:
         # A wake on a stale copy (current run cleared) over the replica's done card: no reopen follows the
-        # completion, so the live status is older, not a local edit (t_01a1d1092f3caa2f). [daveey]
+        # completion, so the live status is older, not a local edit (t_01a1d1092f3caa2f). Both logs must hold it:
+        # a reopen in the live log (an uncaptured local reopen, which this repair exists to send) wins. [daveey]
         from hermes_cli.kanban_terminal_guard import terminal_hold
         return (theirs["status"] in _TERMINAL and row["status"] not in _TERMINAL and row["status"] != "running"
-                and row["claim_lock"] is None and terminal_hold(shadow, row["id"]) is not None)
+                and row["claim_lock"] is None and terminal_hold(shadow, row["id"]) is not None
+                and terminal_hold(live, row["id"]) is not None)
     if row["status"] == "running" and (_run_ended(live, run_uid) or _run_ended(shadow, run_uid)):
         return True
     if row["claim_lock"] is not None:
diff --git a/hermes_cli/kanban_terminal_guard.py b/hermes_cli/kanban_terminal_guard.py
index 46eb4c9c1d..e9281e693c 100644
--- a/hermes_cli/kanban_terminal_guard.py
+++ b/hermes_cli/kanban_terminal_guard.py
@@ -69,13 +69,21 @@ def is_reopen(event: dict) -> bool:
     return False
 
 
+_LIFECYCLE_KINDS = tuple(sorted({*_TERMINAL_KINDS, *REOPEN_KINDS, *_STATUS_KINDS}))
+_EVENTS_SQL = ("SELECT id, {uid}, kind, payload, created_at FROM task_events WHERE task_id = ? "
+               f"AND kind IN ({','.join('?' * len(_LIFECYCLE_KINDS))})")
+
+
 def _events(conn: sqlite3.Connection, task_id: str) -> list[dict]:
-    cols = {r[1] for r in conn.execute("PRAGMA table_info(task_events)")}
-    uid = "uid" if "uid" in cols else "NULL AS uid"
-    kinds = sorted({*_TERMINAL_KINDS, *REOPEN_KINDS, *_STATUS_KINDS})
-    return [dict(r) for r in conn.execute(
-        f"SELECT id, {uid}, kind, payload, created_at FROM task_events WHERE task_id = ? "
-        f"AND kind IN ({','.join('?' * len(kinds))})", (task_id, *kinds))]
+    """The card's terminal and reopen events. One indexed query; a pre-uid schema (no ``task_events.uid``) is the
+    rare fallback, so it costs a failed prepare there instead of a ``PRAGMA`` on every call."""
+    try:
+        rows = conn.execute(_EVENTS_SQL.format(uid="uid"), (task_id, *_LIFECYCLE_KINDS))
+    except sqlite3.OperationalError as exc:
+        if "uid" not in str(exc):
+            raise
+        rows = conn.execute(_EVENTS_SQL.format(uid="NULL AS uid"), (task_id, *_LIFECYCLE_KINDS))
+    return [dict(r) for r in rows]
 
 
 def terminal_hold(conn: sqlite3.Connection, task_id: str) -> Optional[dict]:
@@ -197,13 +205,15 @@ def _restore_held(conn: sqlite3.Connection, task_id: str) -> Optional[str]:
     row = conn.execute("SELECT status FROM tasks WHERE id = ?", (task_id,)).fetchone()
     if row is None or row[0] not in TERMINAL_STATUSES or terminal_hold(conn, task_id) is not None:
         return None
-    last = conn.execute("SELECT id, payload FROM task_events WHERE task_id = ? AND kind = ? ORDER BY id DESC LIMIT 1",
+    # The newest hold the apply guard wrote. A note from another source (a push strip, a producer skip) can sit
+    # between the held row's page and the reopen's page and says nothing about what the apply held back.
+    last = conn.execute("SELECT id, payload FROM task_events WHERE task_id = ? AND kind = ? "
+                        "AND json_extract(payload, '$.source') = 'apply' ORDER BY id DESC LIMIT 1",
                         (task_id, STALE_WAKE_IGNORED)).fetchone()
     if last is None:
         return None
-    payload = _payload(last[1])
-    held = payload.get("held_status")
-    if payload.get("source") != "apply" or not isinstance(held, str) or held in TERMINAL_STATUSES:
+    held = _payload(last[1]).get("held_status")
+    if not isinstance(held, str) or held in TERMINAL_STATUSES:
         return None
     # Only a hold newer than every terminal event: an older one belongs to an earlier completion.
     newest_terminal = max((e["id"] for e in _events(conn, task_id) if terminal_status(e)), default=0)
