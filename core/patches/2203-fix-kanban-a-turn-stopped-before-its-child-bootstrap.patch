From ac55213633450e08c190619c085e534a6c53de77 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 02:49:40 +0000
Subject: [PATCH] fix(kanban): a turn stopped before its child bootstrapped is
 not continued [daveey]

Review of 23ce3427a4a: admit_managed checkpointed every restart-caused interruption, including a stop
during child spawn/startup (_interrupted_before_bootstrap) when the turn never ran. For an attempt
started from a copied transcript the session is non-empty, so the next owner continued it with only
the continuation note (skipping this run's first prompt, skills and resume note) and could rewrite the
previous run's trailing cancelled tool results. Such a stop is now booked without a checkpoint: the
plain uncounted requeue (with transcript copy), as before this change.

Proof: test_a_stop_before_the_child_bootstrapped_is_not_a_checkpoint; mutant B1 (flag ignored) killed.
---
 gateway/session_managed_worker.py             |  6 ++++--
 tests/gateway/test_core_update_kanban_wait.py | 19 +++++++++++++++++++
 2 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/gateway/session_managed_worker.py b/gateway/session_managed_worker.py
index 53bbb4ec8c..3af68a19d3 100644
--- a/gateway/session_managed_worker.py
+++ b/gateway/session_managed_worker.py
@@ -459,7 +459,7 @@ def _launch_env_only_credentials(home, env):
 def _interrupted_before_bootstrap(authority, row, cause=None):
     authority.pending_results[row['admission_id']] = {
         'result': {'final_response': '', 'interrupted': True, **({'interrupt_message': cause} if cause else {})},
-        'usage': {}, 'runtime_stop_cause': cause}
+        'usage': {}, 'runtime_stop_cause': cause, 'before_bootstrap': True}
     return ''
 
 
@@ -642,7 +642,9 @@ async def admit_managed(authority, ref, row, policy):
         # receipt becomes terminal: a runtime Stop must not spend the card's retries.
         # [daveey] A clean stop is a checkpoint the next owner continues (session_kanban_continue).
         from gateway.session_kanban_restart import book_restart_interruption
-        await book_restart_interruption(authority, policy, checkpoint={
+        # A turn stopped before its child bootstrapped never ran: nothing to continue (a copied
+        # transcript's tail is the previous run's), so it takes the plain uncounted requeue.
+        await book_restart_interruption(authority, policy, checkpoint=None if pending.get('before_bootstrap') else {
             'session_id': ref.session_id, 'request_id': row.get('request_id'),
             'admission_id': row.get('admission_id'), 'cause': pending.get('runtime_stop_cause')})
     return reply
diff --git a/tests/gateway/test_core_update_kanban_wait.py b/tests/gateway/test_core_update_kanban_wait.py
index a935debb29..40a59d615e 100644
--- a/tests/gateway/test_core_update_kanban_wait.py
+++ b/tests/gateway/test_core_update_kanban_wait.py
@@ -135,6 +135,25 @@ async def test_cooperative_stop_booking_before_admission_settlement(monkeypatch,
                                                            'admission_id': 'a', 'cause': cause}
 
 
+@pytest.mark.asyncio
+async def test_a_stop_before_the_child_bootstrapped_is_not_a_checkpoint(monkeypatch):
+    # [daveey] The turn never ran: a copied transcript's tail is the previous run's, so continuing it
+    # would skip this run's first prompt and rewrite the old run's tool results. Plain requeue instead.
+    from gateway import session_managed_worker as managed
+    from gateway import session_kanban_restart as booking
+    authority = SimpleNamespace(pending_results={}, _mutation_tasks=set())
+    row = {'admission_id': 'a'}
+
+    async def execute(*_):
+        return managed._interrupted_before_bootstrap(authority, row, 'Gateway restarting')
+    monkeypatch.setattr(managed, 'execute_managed', execute)
+    monkeypatch.setattr('gateway.session_policy.workspace_ready', lambda _: True)
+    recorded = MagicMock()
+    monkeypatch.setattr(booking, 'record_restart_interruption', recorded)
+    await managed.admit_managed(authority, SimpleNamespace(session_id='s'), row, SimpleNamespace(kanban_json='{}'))
+    assert recorded.call_count == 1 and recorded.call_args.kwargs['checkpoint'] is None
+
+
 @pytest.mark.asyncio
 @pytest.mark.parametrize('has_intent', [True, False])
 async def test_restart_line_states_whether_the_kanban_cap_is_armed(monkeypatch, tmp_path, caplog, has_intent):
