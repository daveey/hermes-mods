+def parse_annotation(message: str) -> dict[str, str]:
+    test_id, _, excerpt = message.partition("\n")
+    return {"test_id": test_id.strip(), "first_attempt_excerpt": excerpt, "retried": "tests" if "::" in test_id else "file"}
+
