 hermes_cli/auth_codex_quota_window.py                | 10 +++++++---
 tests/agent/test_codex_rotation_window_boundaries.py |  6 +++++-
 tests/hermes_cli/test_auth_codex_quota_probe.py      |  5 +++--
 4 files changed, 16 insertions(+), 7 deletions(-)

