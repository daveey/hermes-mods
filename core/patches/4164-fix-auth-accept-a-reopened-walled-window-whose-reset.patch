-    # Restoration must prove the same weekly window, not just anonymous percentages.
-    payload["rate_limit"]["secondary_window"]["reset_at"] = store["credential_pool"]["openai-codex"][0]["last_error_reset_at"]
+    # Restoration must cover the walled window, not just anonymous percentages: a redeemed
