From 26222447de06242364445fb3bb168350a0f44330 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 19:17:46 +0000
Subject: [PATCH] test: port fork tests and upstream tests across the merge
 [daveey]

- provider_parity / local_prompt_progress: vendor-qualified model ids (the fork's model/provider guard
  refuses a bare id on Nous/OpenRouter before any request).
- compression stall: the fork's deterministic-retry test passes upstream's precommit_deadline_monotonic.
- pre_final_delivery_channels: upstream relays only extracted reasoning, never the visible reply (#132477).
---
 .../test_compression_stall_deterministic_fallback.py     | 2 ++
 tests/agent/test_local_prompt_progress.py                | 9 +++++----
 tests/agent/test_pre_final_delivery_channels.py          | 7 +++++--
 tests/agent/test_provider_parity.py                      | 4 +++-
 4 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/tests/agent/test_compression_stall_deterministic_fallback.py b/tests/agent/test_compression_stall_deterministic_fallback.py
index 7e5168d09c6..8c31311303c 100644
--- a/tests/agent/test_compression_stall_deterministic_fallback.py
+++ b/tests/agent/test_compression_stall_deterministic_fallback.py
@@ -324,6 +324,8 @@ def test_deterministic_pinned_retry_outlasts_the_llm_idle_window():
         dict(DETERMINISTIC_SUMMARY_ROUTE),
         worker=worker, messages=original, system_prompt_fallback="degraded-prompt",
         idle_timeout_seconds=llm_idle, total_ceiling_seconds=llm_idle,
+        # Upstream's shared pre-commit ceiling (6fb41c9eabf); spent before the slow commit ends.
+        precommit_deadline_monotonic=time.monotonic() + llm_idle,
         on_commit_overrun=None, on_timeout_cause=None, telemetry_agent=None, new_fence=None,
     )
     elapsed = time.monotonic() - started
diff --git a/tests/agent/test_local_prompt_progress.py b/tests/agent/test_local_prompt_progress.py
index cbe6705fb79..99b3188f80e 100644
--- a/tests/agent/test_local_prompt_progress.py
+++ b/tests/agent/test_local_prompt_progress.py
@@ -67,10 +67,10 @@ class TestPromptProgressHelpers:
         assert prompt_progress_percent({"total": "x"}) is None
 
 
-def _local_agent(provider="llamacpp", base_url="http://127.0.0.1:18434/v1"):
+def _local_agent(provider="llamacpp", base_url="http://127.0.0.1:18434/v1", model="qwen"):
     from run_agent import AIAgent
 
-    agent = AIAgent(api_key="k", base_url=base_url, provider=provider, model="qwen",
+    agent = AIAgent(api_key="k", base_url=base_url, provider=provider, model=model,
                     quiet_mode=True, skip_context_files=True, skip_memory=True)
     agent.api_mode = "chat_completions"
     agent._interrupt_requested = False
@@ -103,9 +103,10 @@ class TestMainStreamProgress:
         client = MagicMock()
         client.chat.completions.create.return_value = iter([_text_chunk("ok", finish_reason="stop")])
         mock_create.return_value = client
-        agent = _local_agent(provider="openrouter", base_url="https://openrouter.ai/api/v1")
+        # Fork: the model/provider guard refuses a bare vendor id on OpenRouter before any request.
+        agent = _local_agent(provider="openrouter", base_url="https://openrouter.ai/api/v1", model="qwen/qwen")
 
-        agent._interruptible_streaming_api_call({"model": "qwen", "messages": [{"role": "user", "content": "hi"}]})
+        agent._interruptible_streaming_api_call({"model": "qwen/qwen", "messages": [{"role": "user", "content": "hi"}]})
 
         sent = client.chat.completions.create.call_args.kwargs
         assert "return_progress" not in (sent.get("extra_body") or {})
diff --git a/tests/agent/test_pre_final_delivery_channels.py b/tests/agent/test_pre_final_delivery_channels.py
index 3f9fb830083..753cd86aebf 100644
--- a/tests/agent/test_pre_final_delivery_channels.py
+++ b/tests/agent/test_pre_final_delivery_channels.py
@@ -45,9 +45,12 @@ def test_unresolved_error_surface_names_runtime_not_provider():
 
 
 def test_unbuffered_progress_preview_unchanged(agent):
-    Run(agent, ["Ordinary response."])
+    # Upstream relays only extracted reasoning as ``reasoning.available``, never the visible reply
+    # (#132477); an unbuffered gate leaves that preview as it is.
+    Run(agent, ["<think>Ordinary plan.</think>Ordinary response."])
     progress = []
     agent.tool_progress_callback = lambda *args: progress.append(args)
     result = _run(agent, lambda **kwargs: None)
     assert result["completed"]
-    assert "Ordinary response." in str(progress)
+    assert "Ordinary plan." in str(progress)
+    assert "Ordinary response." not in str(progress)
diff --git a/tests/agent/test_provider_parity.py b/tests/agent/test_provider_parity.py
index ab8be6a3701..262f87b6d7f 100644
--- a/tests/agent/test_provider_parity.py
+++ b/tests/agent/test_provider_parity.py
@@ -365,7 +365,9 @@ class TestBuildApiKwargsNousPortal:
     ])
     def test_connector_data_use_asks_for_a_no_training_route_and_never_reaches_the_wire(
             self, monkeypatch, data_use, provider):
-        agent = _make_agent(monkeypatch, "nous", base_url="https://inference-api.nousresearch.com/v1", model="gpt-5")
+        # Fork: the model/provider guard refuses a bare vendor id on Nous before any request.
+        agent = _make_agent(monkeypatch, "nous", base_url="https://inference-api.nousresearch.com/v1",
+                            model="openai/gpt-5")
         tool = {"role": "tool", "tool_call_id": "c1", "content": "inbox"}
         messages = [
             {"role": "user", "content": "read my mail"},
-- 
2.55.0

