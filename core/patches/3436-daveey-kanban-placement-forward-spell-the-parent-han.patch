From b0fa8397a114dd2c56a76813a0cf0fa21e15a4a5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:15:20 +0000
Subject: [PATCH] [daveey] kanban placement forward: spell the parent-handoff
 footer as a cross_task read, so forwarded cards stay portable

The forwarder appended 'read them there with cross_task @task:default@<gw>/<id>' to every forwarded card with
parents. kanban_placement_coordination._actions parses 'with cross_task' followed by a non-action token as an
explicit unknown invocation (needs home coordination action), so the target gateway kept the card home even
when its hub admission judge denied it (t_01a1d49003c65ca4, hub-pin sweep prevention slug
parent-handoff-cross-task). The footer now names the tool's read call,
cross_task(action='read', target='@task:default@<gw>/<id>'), which needs only capability:coordination-read
(carried by every pool worker).

Proof: tests/hermes_cli/test_kanban_placement_forward_footer.py: 3 of 4 fail on the old footer (refusal
'needs home coordination action'; portable_reason not None), 4/4 pass with it. Neighbouring placement,
identity, review-required, cancel, rejected, origin-notify and cross-board creator suites: 350 passed.

[card:t_01a1d498e973d6e6]
---
 hermes_cli/kanban_placement_forward.py        |  5 +-
 .../test_kanban_placement_forward_footer.py   | 68 +++++++++++++++++++
 2 files changed, 72 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_cli/test_kanban_placement_forward_footer.py

diff --git a/hermes_cli/kanban_placement_forward.py b/hermes_cli/kanban_placement_forward.py
index 4a510c43cc..06bfef9b6c 100644
--- a/hermes_cli/kanban_placement_forward.py
+++ b/hermes_cli/kanban_placement_forward.py
@@ -437,8 +437,11 @@ def remote_args(conn: sqlite3.Connection, task, *, self_gw: str) -> dict:
         lines.append(f"- {pid} ({p.title if p else '?'}): {handoff[:1500]}")
     body = (task.body or "").rstrip()
     if lines:
+        # Spell the tool's read call: "with cross_task @task:..." parses as an unknown explicit invocation in
+        # kanban_placement_coordination._actions (ACTION_REASON), which kept such forwarded cards on the
+        # target's home instead of the pool (t_01a1d49003c65ca4). A read only needs coordination-read.
         body += (f"\n\n---\nParent handoffs (the parents ran on {self_gw}; read them there with "
-                 f"cross_task @task:default@{self_gw}/<id>):\n" + "\n".join(lines))
+                 f"cross_task(action='read', target='@task:default@{self_gw}/<id>')):\n" + "\n".join(lines))
     body += f"\n\nThis card was {self_gw} card {task.id}; it completes there when this one is done."
     return {
         "title": task.title, "body": body, "assignee": task.assignee or "default",
diff --git a/tests/hermes_cli/test_kanban_placement_forward_footer.py b/tests/hermes_cli/test_kanban_placement_forward_footer.py
new file mode 100644
index 0000000000..05c2e420a5
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_placement_forward_footer.py
@@ -0,0 +1,68 @@
+"""The forwarded card's parent-handoff footer must read as a portable cross_task read.
+
+t_01a1d49003c65ca4: a macbook card forwarded to the hub carried the footer "read them there with
+cross_task @task:default@macbook/<id>". The coordination scan parses "with cross_task" followed by a
+non-action token as an explicit unknown invocation (ACTION_REASON), so the hub kept a card its own
+admission judge had denied. The footer now spells the tool's read action.
+"""
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_placement_coordination as coord
+from hermes_cli import kanban_placement_forward as forward
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    kb.init_db()
+    return home
+
+
+def _forwarded_body(parents=1):
+    with kbc.connect_closing() as conn:
+        pids = []
+        for n in range(parents):
+            pid = kb.create_task(conn, title=f"Parent {n}", assignee="default")
+            kb.complete_task(conn, pid, summary=f"Parent {n}: re-proved the archive", force=True)
+            pids.append(pid)
+        child = kb.create_task(conn, title="Fix startup 503", body="Fix spec: retry while starting.",
+                               assignee="default", parents=pids)
+        return pids, forward.remote_args(conn, kb.get_task(conn, child), self_gw="macbook")["body"]
+
+
+def test_parent_handoff_footer_is_a_portable_read(home):
+    pids, body = _forwarded_body()
+    assert f"- {pids[0]} (Parent 0): Parent 0: re-proved the archive" in body
+    assert "@task:default@macbook/<id>" in body
+    labels, refusal = coord.requirements(body)
+    assert refusal is None, body
+    assert labels == {"capability:coordination-read"}
+
+
+def test_footer_names_the_read_action_of_the_cross_task_tool(home):
+    _, body = _forwarded_body(parents=2)
+    assert "cross_task(action='read', target='@task:default@macbook/<id>')" in body
+    assert [action for _, _, action in coord._actions(body, coord._CROSS, {"read", "list", "comment"})] == ["read"]
+
+
+def test_card_without_parents_has_no_footer_and_no_coordination_need(home):
+    _, body = _forwarded_body(parents=0)
+    assert "cross_task" not in body
+    assert "This card was macbook card" in body
+    assert coord.requirements(body) == (set(), None)
+
+
+def test_forwarded_card_with_parents_is_portable_to_an_attested_pool(home, monkeypatch):
+    from hermes_cli import kanban_placement as placement
+    monkeypatch.setattr(placement.reg, "self_gateway", lambda: "hub")
+    seen = []
+    monkeypatch.setattr(coord, "attested", lambda names, required: seen.append(set(required)) or True)
+    cfg = {"worker_pools": {"hub": ["worker-1", "worker-2"]}}
+    _, body = _forwarded_body()
+    assert placement.portable_reason({"title": "Fix startup 503", "body": body, "assignee": "default"}, cfg) is None
+    assert {"capability:coordination-read"} in seen
