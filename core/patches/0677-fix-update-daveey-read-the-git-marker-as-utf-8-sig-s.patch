From 047865a80e9bb35f24a335966918faa5a046f9f8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 08:09:33 +0000
Subject: [PATCH] fix(update): [daveey] read the git marker as utf-8-sig
 (scripts/check footgun from 2aa3397018)

---
 hermes_cli/update_cmd_stash.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hermes_cli/update_cmd_stash.py b/hermes_cli/update_cmd_stash.py
index ca350eae07..9b147258ab 100644
--- a/hermes_cli/update_cmd_stash.py
+++ b/hermes_cli/update_cmd_stash.py
@@ -106,7 +106,7 @@ def recover_flipped_bare_checkout(git_cmd: list[str], cwd: Path) -> bool:
     resolved = git_marker
     if git_marker.is_file():
         pointed = ""
-        for line in git_marker.read_text(encoding="utf-8", errors="replace").splitlines():
+        for line in git_marker.read_text(encoding="utf-8-sig", errors="replace").splitlines():
             if line.strip().lower().startswith("gitdir:"):
                 pointed = line.split(":", 1)[1].strip()
                 break
