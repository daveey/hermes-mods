From 68768e4551165f341e81e291820822bc65c11b27 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 17:20:09 +0000
Subject: [PATCH] [daveey] compact skills index: strip triggers from
 plugin-registered skill rows too

skills.index_in_kanban_worker=compact (the Kanban-worker default) dropped the
Asks:/Not for: suffix from on-disk rows in _label_visible_entries, but plugin
rows from _plugin_skill_prompt_rows are appended afterwards and kept it.
Thread with_triggers through to extract_skill_description: full keeps the
config default, compact/names pass False. No row or name is hidden.

Follow-up to #3043 review nit 1 (t_01a1db064a1850e1).

Proof: tests/agent/test_skill_index_kanban_worker.py::test_plugin_skill_rows_follow_the_index_mode
fails on origin/main (compact plugin row ends with the trigger text) and passes
here; related skill/plugin/prompt_builder suites green (10 files, 203 tests).
---
 agent/prompt_builder.py                       | 11 +++++++----
 tests/agent/test_skill_index_kanban_worker.py | 18 ++++++++++++++++++
 2 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/agent/prompt_builder.py b/agent/prompt_builder.py
index 00ab4b695b..b607d2da22 100644
--- a/agent/prompt_builder.py
+++ b/agent/prompt_builder.py
@@ -1332,14 +1332,15 @@ def _skill_should_show(
 
 def _plugin_skill_prompt_rows(
     disabled: set[str], available_tools: set[str] | None, available_toolsets: set[str] | None,
-    session_platform: str | None,
+    session_platform: str | None, with_triggers: bool | None = None,
 ) -> list[tuple[str, str]]:
     """``(qualified_name, description)`` for every skill registered by an ENABLED plugin
     (``ctx.register_skill``), filtered through the same offer-time gates as on-disk skills.
     Plugin skills live in the plugin-manager registry — never under the profile skills tree —
     so the disk scans above cannot see them; this is their one path into ``<available_skills>``.
     The qualified ``plugin:skill`` name is exactly what ``skill_view`` resolves, and disabling
-    or unloading a plugin removes its registry entries, so enablement gating is inherent."""
+    or unloading a plugin removes its registry entries, so enablement gating is inherent.
+    ``with_triggers=False`` drops the ``triggers:`` suffix, as on-disk rows do in a lean index."""
     rows: list[tuple[str, str]] = []
     try:
         from hermes_cli.plugins import discover_plugins, get_plugin_manager
@@ -1356,7 +1357,8 @@ def _plugin_skill_prompt_rows(
                                       available_toolsets, session_platform):
                 continue
             desc = extract_skill_description(
-                {**frontmatter, "description": meta.get("description") or frontmatter.get("description") or ""})
+                {**frontmatter, "description": meta.get("description") or frontmatter.get("description") or ""},
+                with_triggers=with_triggers)
             rows.append((name, desc))
     except Exception:
         logger.debug("Plugin skill prompt rows unavailable", exc_info=True)
@@ -1448,7 +1450,8 @@ def _build_skills_system_prompt_inner(
     disabled = get_disabled_skill_names(_platform_hint or None)
     # Plugin-registered skills (ctx.register_skill) are registry state, not files under any scanned
     # root — the snapshot manifest can't see them change, so they participate in the cache key.
-    plugin_rows = _plugin_skill_prompt_rows(disabled, available_tools, available_toolsets, _platform_hint or None)
+    plugin_rows = _plugin_skill_prompt_rows(disabled, available_tools, available_toolsets, _platform_hint or None,
+                                            with_triggers=None if index_mode == "full" else False)
     # Skill files are part of the key: another process (a hub install in a second terminal, the curator
     # inside the gateway, a git pull of an external dir) never clears this process's LRU, so a key of
     # config alone served the pre-change index to every running session until restart (#92313).
diff --git a/tests/agent/test_skill_index_kanban_worker.py b/tests/agent/test_skill_index_kanban_worker.py
index e33e41a8b7..9dcebcca75 100644
--- a/tests/agent/test_skill_index_kanban_worker.py
+++ b/tests/agent/test_skill_index_kanban_worker.py
@@ -69,6 +69,24 @@ def test_compact_strips_only_the_exact_trigger_suffix(home):
     assert "- apple-notes: Use when David Asks: notes." in build_skills_system_prompt(index_mode="compact")
 
 
+def test_plugin_skill_rows_follow_the_index_mode(monkeypatch):
+    # Plugin (ctx.register_skill) rows join the index after the on-disk rows are labelled: compact must
+    # strip their triggers too, full keeps them, names lists the name only. No mode hides the name.
+    from hermes_cli import plugins
+    meta = {"name": "demo:disk-helper", "description": DESC, "frontmatter": {
+        "name": "disk-helper", "description": DESC,
+        "triggers": {"asks": ["my disk is full"], "not_for": "the CI runner disk"}}}
+    monkeypatch.setattr(plugins, "discover_plugins", lambda *a, **k: None)
+    monkeypatch.setattr(plugins, "get_plugin_manager",
+                        lambda: SimpleNamespace(list_plugin_skill_metadata=lambda: [meta]))
+    assert _row(build_skills_system_prompt(), "demo:disk-helper").endswith(f"- demo:disk-helper: {DESC}{TRIGGERS}")
+    compact = build_skills_system_prompt(index_mode="compact")
+    assert _row(compact, "demo:disk-helper").endswith(f"- demo:disk-helper: {DESC}")
+    assert "Asks:" not in compact and "Not for:" not in compact
+    names = build_skills_system_prompt(index_mode="names")
+    assert "demo:disk-helper" in names and DESC not in names and "Asks:" not in names
+
+
 def test_names_mode_lists_every_skill_name_and_no_description():
     names = build_skills_system_prompt(index_mode="names")
     for name in ("mac-disk-cleanup", "apple-notes", "email-triage"):
