+    getConnectionFor: vi.fn(async (_route: { connectionId: string; profile: string }) => remoteConn),
+    getGatewayWsUrl: vi.fn(async (conn?: { wsUrl?: string }) => conn?.wsUrl ?? primary.wsUrl),
