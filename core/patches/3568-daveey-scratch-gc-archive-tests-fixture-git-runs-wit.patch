From 4bef98e45e84314bff83a0f439171081e51ef7c7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 14:06:37 +0000
Subject: [PATCH] [daveey] scratch gc archive tests: fixture git runs with
 auto-maintenance off

test_unpushed_commit_lands_in_verified_bundle commits inside a clone that
`_gc()` then scans for archiving. Every `git commit` launches
`git maintenance run --auto`; git >= 2.47 detaches it, so
`.git/objects/maintenance.lock` can appear and vanish while
kanban_scratch_archive._scan walks the tree. The scan correctly fails closed
(ArchiveRefused "scan uncertain"), which turns into a flaky test. This is the
same race state PR #2283 fixed for its fixture repos.

Fix (tests only; the scan's fail-closed behaviour is unchanged): the module's
`_run` git helper passes `-c maintenance.auto=false -c gc.auto=0`, which
covers the seed repo, every clone and the in-clone commit. The archive's own
git calls (rev-parse, remote, for-each-ref, rev-list, bundle, diff,
hash-object, ls-files) never trigger auto-maintenance.

Guard: test_fixture_git_never_spawns_background_maintenance builds the same
seed + clone + commit under GIT_TRACE2_EVENT and asserts no `git maintenance`
/ `git gc` child_start (and that the commit really ran). Same shape as the
existing guard in test_kanban_scratch_git_preservation.py.

RED (guard only, helper unchanged, git 2.43):
  AssertionError: [{'argv': ['git', 'maintenance', 'run', '--auto', '--quiet'],
  'event': 'child_start', ...}]
GREEN: test_kanban_scratch_gc_archive.py + test_kanban_gc_retention_hours.py
(imports these helpers): 86 passed. scripts/check --base origin/main: ok.

Other core tests checked: test_kanban_scratch_git_preservation.py already sets
maintenance.auto=false with a TRACE2 guard; test_kanban_scratch_custody.py,
test_kanban_scratch_gc.py, test_kanban_gc_retention.py and
test_kanban_scratch_owned_jobs.py make no git commits in scanned trees.

Card: t_01a1d536ceaf877b
---
 .../test_kanban_scratch_gc_archive.py         | 28 ++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_scratch_gc_archive.py b/tests/hermes_cli/test_kanban_scratch_gc_archive.py
index 1fefb397f7..ef01de8808 100644
--- a/tests/hermes_cli/test_kanban_scratch_gc_archive.py
+++ b/tests/hermes_cli/test_kanban_scratch_gc_archive.py
@@ -31,15 +31,23 @@ def board(tmp_path, monkeypatch):
 
 
 def _run(*args, cwd=None):
+    # maintenance.auto/gc.auto off: a fixture commit must not leave a detached
+    # `git maintenance run --auto` writing objects/maintenance.lock under a
+    # tree the scratch archive is about to scan (it would fail closed).
     return subprocess.run(
         ["git", "-c", "user.name=t", "-c", "user.email=t@example.com",
-         "-c", "init.defaultBranch=main", *args],
+         "-c", "init.defaultBranch=main",
+         "-c", "maintenance.auto=false", "-c", "gc.auto=0", *args],
         cwd=cwd, check=True, capture_output=True, text=True,
     ).stdout.strip()
 
 
 @pytest.fixture
 def remote(tmp_path):
+    return _seed_remote(tmp_path)
+
+
+def _seed_remote(tmp_path):
     src = tmp_path / "seed"
     src.mkdir()
     _run("init", "-q", cwd=src)
@@ -136,6 +144,24 @@ def test_unpushed_commit_lands_in_verified_bundle(board, remote, tmp_path):
     assert sha in _run("bundle", "list-heads", str(bundle), cwd=check)
 
 
+def test_fixture_git_never_spawns_background_maintenance(board, tmp_path, monkeypatch):
+    # A commit inside a scanned clone would otherwise launch `git maintenance run
+    # --auto`; git >= 2.47 detaches it, so objects/maintenance.lock can come and go
+    # while _gc scans the tree and the archive fails closed ("scan uncertain").
+    trace = tmp_path / "git-trace2.jsonl"
+    monkeypatch.setenv("GIT_TRACE2_EVENT", str(trace))
+    _, path = _task(remote=_seed_remote(tmp_path))
+    (path / "repo" / "tracked.txt").write_text("two\n")
+    _run("commit", "-q", "-am", "unpushed work", cwd=path / "repo")
+    events = [json.loads(line) for line in trace.read_text().splitlines()]
+    assert any(e.get("event") == "start" and "commit" in e.get("argv", []) for e in events)
+    maintenance = [
+        e for e in events
+        if e.get("event") == "child_start" and e.get("argv", [])[:2] in (["git", "maintenance"], ["git", "gc"])
+    ]
+    assert not maintenance, maintenance
+
+
 def test_workspace_that_is_itself_a_clone(board, remote):
     tid, path = _task(remote=remote, clone_into=".")
     (path / "extra.txt").write_text("x")
