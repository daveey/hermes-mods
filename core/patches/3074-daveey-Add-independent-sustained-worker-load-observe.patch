diff --git a/docs/worker-compute-capacity.md b/docs/worker-compute-capacity.md
index e8efcad0d9..8a237a0567 100644
--- a/docs/worker-compute-capacity.md
+++ b/docs/worker-compute-capacity.md
@@ -30,6 +30,35 @@ A missing database with no proof cannot be recovered by this command. Restore th
 original database from a trusted backup, verify/drain its work, and use normal
 board removal. Never delete a registration merely to make admission green.
 
+## Independent sustained-load observer
+
+`python -m hermes_cli.worker_load_observer` performs one sample. Enrollment must
+schedule it every 30 seconds in a **system** oneshot service with `User=<worker>`,
+`Slice=system.slice`, and `TimeoutStartSec=20s` (including publication). Do not put
+it in the user manager: the user CPU backstop can starve it. The timer and service
+are still rollout work; this module alone does not install or enable them.
+
+The durable observer outbox fires after load/core is strictly above 2 for 600
+seconds. Gaps over 90 seconds, reversed clocks and unreadable load reset continuity
+as unknown. A pending alert survives load recovery and retries with the same
+idempotency key, including after an uncertain successful create or archived alert.
+A recovered valid load at or below 2 rearms the next incident. Evidence failures
+never suppress load observations. Process evidence reports sanitized comm/PID,
+interval CPU, mapped card, and active uncontained same-UID processes. These are
+**not proven escapes**: gateways and user shells also legitimately live outside
+the compute pool. No argv, environment, execution DB path or cgroup path is sent.
+Corrupt observer state fails loudly; operators must preserve it for diagnosis
+rather than silently declaring a continuous observation window.
+
+## Execution ownership
+
+Worker identities are `(resolved absolute execution database path, task id)`.
+Board labels cannot distinguish two installations and are not ownership proof.
+Admission counts the prospective owner union, allowing a parked owner to resume
+at the cap when its populated slice already reserves that slot. A new owner must
+fit. Load pressure still refuses both kinds of claim. Existing slug-based owner
+maps and legacy flat scopes require explicit rollout migration before enabling.
+
 ## Pressure contention
 
 Hysteresis writers wait up to 250 ms for the pressure lock, then refuse as unknown.
diff --git a/hermes_cli/worker_load_observer.py b/hermes_cli/worker_load_observer.py
new file mode 100644
index 0000000000..cb0655ae69
--- /dev/null
+++ b/hermes_cli/worker_load_observer.py
@@ -0,0 +1,134 @@
+"""Independent 30-second sustained worker-load observer with durable alert outbox.
+
+Run as a system timer outside hermes-kanban.slice, never from admission. No
+process argv, environment, paths or credentials are included in alert evidence.
+"""
+from __future__ import annotations
+
+import json
+from contextlib import closing
+import math
+import os
+from pathlib import Path
+import tempfile
+import uuid
+
+from hermes_cli.worker_board_retirement import sync_directory
+
+
+def _save(directory: Path, state: dict) -> None:
+    temporary = None
+    try:
+        with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', dir=directory, delete=False) as stream:
+            temporary = Path(stream.name)
+            json.dump(state, stream, allow_nan=False)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, directory / 'observer.json')
+        sync_directory(directory)
+    finally:
+        if temporary is not None:
+            temporary.unlink(missing_ok=True)
+
+
+def tick(directory: Path, *, now: float, load_per_core: float | None, evidence: dict, publish) -> dict:
+    """Persist observation/outbox before publication; retries keep the exact key.
+
+    Gaps >90 seconds, reversed clocks and unreadable samples explicitly break
+    continuity as unknown. They are not observations of recovered load.
+    """
+    import fcntl
+    if not math.isfinite(now):
+        raise ValueError('invalid observer clock')
+    directory.mkdir(parents=True, exist_ok=True)
+    with (directory / 'observer.lock').open('a') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        try:
+            state = json.loads((directory / 'observer.json').read_text(encoding='utf-8'))
+        except FileNotFoundError:
+            state = dict(version=1, last=None, high_since=None, pending=None, published_id=None, armed=True)
+        if not isinstance(state, dict) or state.get('version') != 1:
+            raise ValueError('invalid observer state')
+        previous = state['last']
+        gap = previous is not None and (now <= previous or now - previous > 90)
+        valid = load_per_core is not None and math.isfinite(load_per_core) and load_per_core >= 0
+        state['coverage'] = 'unknown_sample' if not valid else 'unknown_gap' if gap else 'observed'
+        if gap or not valid:
+            state['high_since'] = None
+            state['last_unknown'] = now
+        if valid:
+            if load_per_core <= 2:
+                state['high_since'] = None
+                state['armed'] = True
+            elif state['high_since'] is None:
+                state['high_since'] = now
+        state.update(last=now, load_per_core=load_per_core if valid else None)
+        since = state['high_since']
+        if (valid and since is not None and now - since >= 600
+                and state['armed'] and state['pending'] is None):
+            state['pending'] = dict(key='worker-load:' + uuid.uuid4().hex,
+                                    since=since, observed_at=now, load_per_core=load_per_core,
+                                    evidence=evidence)
+            state['armed'] = False
+        _save(directory, state)
+        if state['pending'] is not None:
+            try:
+                task = publish(state['pending'])
+                if not isinstance(task, str) or not task:
+                    raise ValueError('publisher returned no card identity')
+            except Exception as exc:  # health: allow BLE001 -- retain durable outbox across publisher failures
+                state['publish_error'] = type(exc).__name__
+            else:
+                state.update(pending=None, published_id=task, publish_error=None)
+            _save(directory, state)
+        return state
+
+
+def publish_alert(alert: dict) -> str:
+    """Create/read back one durable alert card, including after uncertain success."""
+    import socket
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_db_connect import connect
+    from hermes_cli.worker_compute_capacity import policy_root
+    # This independent service has no worker DB/profile environment. Explicit
+    # file path avoids a current-board symlink changing alert custody.
+    with closing(connect(db_path=policy_root() / 'kanban.db')) as conn:
+        # Include archived cards: a crash after create and operator archive must
+        # not recreate a second card for the same incident on retry.
+        existing = conn.execute('SELECT id FROM tasks WHERE idempotency_key=?', (alert['key'],)).fetchone()
+        if existing:
+            return existing[0]
+        body = ('Measured load/core stayed above 2 for at least 600 seconds with no sampling gap over 90 seconds. '
+                'Investigate owning cards and unexpected scopes; do not kill workloads without authorization.\n\n'
+                + json.dumps(alert, indent=2, sort_keys=True))
+        task = kb.create_task(conn, title=f'Worker sustained load: {socket.gethostname()}', body=body,
+                              assignee='default', created_by='worker-load-observer', requires=['terminal'],
+                              workspace_kind='scratch', idempotency_key=alert['key'], initial_status='running',
+                              completion_contract='local-only')
+        stored = conn.execute('SELECT id, idempotency_key FROM tasks WHERE id=?', (task,)).fetchone()
+        if not stored or stored[1] != alert['key']:
+            raise ValueError('alert readback failed')
+        return task
+
+
+def main() -> None:
+    import time
+    from hermes_cli import worker_compute_capacity as capacity
+    from hermes_cli.worker_load_snapshot import snapshot
+    if not capacity.worker_enabled():
+        return
+    directory = capacity.policy_root() / 'worker-resources' / 'observer'
+    try:
+        cores = capacity.effective_cores()
+        ratio = os.getloadavg()[0] / cores
+    except (OSError, ValueError):
+        ratio = None
+    try:
+        evidence = snapshot()
+    except Exception:  # health: allow BLE001 -- auxiliary evidence must never suppress load observation
+        evidence = {'process_inventory': 'unknown'}
+    tick(directory, now=time.time(), load_per_core=ratio, evidence=evidence, publish=publish_alert)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/hermes_cli/worker_load_snapshot.py b/hermes_cli/worker_load_snapshot.py
new file mode 100644
index 0000000000..a09082e556
--- /dev/null
+++ b/hermes_cli/worker_load_snapshot.py
@@ -0,0 +1,89 @@
+"""Bounded, sanitized /proc evidence for sustained worker-load alerts."""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import re
+import time
+
+from hermes_cli import worker_compute_capacity as capacity
+
+
+def _text(value: str, length=64) -> str:
+    return re.sub(r'[^A-Za-z0-9_.:+-]', '_', value)[:length]
+
+
+def _processes(proc: Path) -> dict:
+    result = {}
+    for path in proc.iterdir():
+        if not path.name.isdecimal():
+            continue
+        try:
+            raw = (path / 'stat').read_text(encoding='utf-8')
+            opening, closing = raw.index('('), raw.rindex(')')
+            fields = raw[closing + 2:].split()
+            # Fields after comm start at stat field 3; starttime is field 22.
+            ticks, birth = int(fields[11]) + int(fields[12]), int(fields[19])
+            cgroup = (path / 'cgroup').read_text(encoding='utf-8')
+            unified = next(line[3:] for line in cgroup.splitlines() if line.startswith('0::'))
+            result[int(path.name)] = dict(birth=birth, ticks=ticks, comm=_text(raw[opening + 1:closing]),
+                                          group=unified, uid=path.stat().st_uid)
+        except (FileNotFoundError, ProcessLookupError):
+            continue  # exited during snapshot, not a living omitted CPU owner
+        except (PermissionError, ValueError, IndexError, StopIteration):
+            result[int(path.name)] = None
+    return result
+
+
+def snapshot(*, proc: Path = Path('/proc'), interval: float = 0.2) -> dict:
+    """Interval CPU (100% = one core); no command lines or environment reads."""
+    if not 0 < interval <= 1:
+        raise ValueError('invalid CPU evidence sampling interval')
+    owners = {}
+    owner_errors = 0
+    directory = capacity.policy_root() / 'worker-resources' / 'owners'
+    if directory.exists():
+        for path in directory.glob('*.json'):
+            try:
+                owner = json.loads(path.read_text(encoding='utf-8'))
+                if (not isinstance(owner, list) or len(owner) != 2
+                        or not all(isinstance(value, str) and value for value in owner)
+                        or capacity.owner_slice(*owner) != path.stem):
+                    raise ValueError('invalid owner evidence')
+                owners[path.stem] = _text(owner[1])
+            except FileNotFoundError:
+                continue
+            except (OSError, ValueError):
+                owner_errors += 1
+    first = _processes(proc)
+    started = time.monotonic()
+    time.sleep(interval)
+    second = _processes(proc)
+    elapsed = time.monotonic() - started
+    if elapsed <= 0:
+        raise ValueError('invalid CPU evidence clock')
+    hz = os.sysconf('SC_CLK_TCK')
+    rows = []
+    unknown = 0
+    for pid, current in second.items():
+        previous = first.get(pid)
+        if current is None or previous is None or current['birth'] != previous['birth']:
+            unknown += 1
+            continue
+        delta = current['ticks'] - previous['ticks']
+        if delta < 0:
+            unknown += 1
+            continue
+        parts = current['group'].split('/')
+        owned = next((owners[part] for part in parts if part in owners), None)
+        contained = 'hermes-kanban.slice' in parts
+        rows.append(dict(pid=pid, comm=current['comm'], cpu_percent=round(100 * delta / hz / elapsed, 2),
+                         card=owned or 'unknown', contained=contained,
+                         uncontained_same_uid=current['uid'] == os.getuid() and not contained))
+    rows.sort(key=lambda row: (-row['cpu_percent'], row['pid']))
+    return dict(cpu_basis='interval; 100% = one core', sample_seconds=round(elapsed, 3),
+                process_inventory='partial' if unknown else 'observed', unknown_processes=unknown,
+                owner_map='partial' if owner_errors else 'observed', owner_errors=owner_errors,
+                processes=rows[:20],
+                uncontained_active=[row for row in rows if row['uncontained_same_uid'] and row['cpu_percent'] > 0][:20])
diff --git a/tests/hermes_cli/test_worker_load_observer.py b/tests/hermes_cli/test_worker_load_observer.py
