From 8c002b43f3482c6cb75418ad925f4e161e928539 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 16:47:40 +0000
Subject: [PATCH] [daveey] lifecycle guard: follow a remote shell's -c payload
 to its stdin reader

Review 5911756789 B1: _remote_reads_stdin skipped a shell's -c payload, so
`ssh h1 "ssh h2 'bash -c bash'" < f` (also sh -c sh, bash -c "exec bash")
no longer walked f although the payload's shell executes it. The payload is
now classified recursively under the same depth cap; payloads ending in a
data consumer (bash -c "python3 -") stay data.

Self-heal lifecycleguard-6d64a5ee3d48.
---
 cron/lifecycle_guard_nested_shells.py              |  7 ++++++-
 tests/cron/test_lifecycle_guard_session_aliases.py | 12 ++++++++++++
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/cron/lifecycle_guard_nested_shells.py b/cron/lifecycle_guard_nested_shells.py
index 1a204ba09dd20cb59994b4531b18d4757af2ac4f..9f7bef41181882377bc85615638b0160646ddc67 100644
--- a/cron/lifecycle_guard_nested_shells.py
+++ b/cron/lifecycle_guard_nested_shells.py
@@ -232,7 +232,12 @@ def _remote_reads_stdin(remote: list[str], hops: int = 1) -> bool:
         index = _executed_command_index(view)
         name = _executable_name(view[index]) if index is not None else None
         if index is not None and name in _SHELL_EXECUTABLES:
-            if _shell_inputs(_split_redirections(view[index + 1:])[0], name)[0] == "stdin":
+            kind, value = _shell_inputs(_split_redirections(view[index + 1:])[0], name)
+            if kind == "stdin":
+                return True
+            # A -c payload inherits the stdin: follow it like a hop (`bash -c bash`,
+            # `sh -c "exec sh"`; review 5911756789 B1), under the same depth cap.
+            if kind == "payload" and _remote_reads_stdin([value or ""], hops + 1):
                 return True
             continue
         if _nested_shell_input(view, hops=hops + 1) is not None:
diff --git a/tests/cron/test_lifecycle_guard_session_aliases.py b/tests/cron/test_lifecycle_guard_session_aliases.py
index 336111d026b136c2a0265228fbf84f60d1a96979..5b0760ea13de5057531bdd3f470285feaa796c08 100644
--- a/tests/cron/test_lifecycle_guard_session_aliases.py
+++ b/tests/cron/test_lifecycle_guard_session_aliases.py
@@ -828,6 +828,9 @@ _MULTI_HOP_DATA_CONSUMERS = [
     "ssh h1 'ssh h2 -p 22 python3 -' < {py}",
     "ssh h1 -T 'ssh h2 -o BatchMode=yes -T python3 -' < {py}",
     "ssh h1 'ssh h2 -- python3 -' < {py}",
+    # A -c payload whose own stdin reader is a data consumer stays data.
+    "ssh h1 \"ssh h2 'bash -c \\\"python3 -\\\"'\" < {py}",
+    "ssh h1 'bash -c \"exec python3 -\"' < {py}",
     "ssh h1 \"ssh h2 python3 -\" <<'PY'\n" + _PY_TAKEOVER + "PY",
 ]
 
@@ -866,6 +869,15 @@ _MULTI_HOP_SHELLS = [
     "ssh h1 'ssh h2 -o BatchMode=yes -p22 -T bash' < {script}",
     "ssh h1 -T < {script}",
     "ssh h1 -p 22 -- < {script}",
+    # A shell's -c payload is followed too: a payload that runs a stdin-reading shell
+    # executes the file (review 5911756789 B1), on the first hop and on later ones.
+    "ssh h1 'bash -c bash' < {script}",
+    "ssh h1 \"ssh h2 'bash -c bash'\" < {script}",
+    "ssh h1 \"ssh h2 'sh -c sh'\" < {script}",
+    "ssh h1 \"ssh h2 'bash -c \\\"exec bash\\\"'\" < {script}",
+    "ssh h1 \"ssh h2 'bash -c \\\"bash -c sh\\\"'\" < {script}",
+    "ssh h1 \"ssh h2 'sh -c \\\"ssh h3\\\"'\" < {script}",
+    "ssh h1 \"ssh h2 'bash -c \\\"python3 -; sh\\\"'\" < {script}",
 ]
 
 
