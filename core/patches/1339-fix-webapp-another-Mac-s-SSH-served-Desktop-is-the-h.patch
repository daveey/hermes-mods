From 11fe85840509be7bea8fd472c0ccd66993a04516 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 14:54:39 -0700
Subject: [PATCH] fix(webapp): another Mac's SSH-served Desktop is the host
 owner, so its archive of a hub chat stops 403ing [daveey]

desktop-ssh (the loopback serve --isolated identity bound from a token file the Desktop wrote over SSH as
this host's OS user) was missing from the owner-login set added in 8497ce9318, so the MacBook's PATCH
/api/sessions/{id} archive of a hub desktop chat (user_id=uid:1000) got 403 permission_denied and the
sidebar row reappeared.
---
 gateway/owner_identity.py                   |  5 +++-
 tests/gateway/test_webapp_owner_identity.py | 28 +++++++++++++++++++++
 2 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/gateway/owner_identity.py b/gateway/owner_identity.py
index bffdf405527..0801309282d 100644
--- a/gateway/owner_identity.py
+++ b/gateway/owner_identity.py
@@ -41,7 +41,10 @@ def principal_subject(identity: dict) -> str:
 # (:func:`_login_provider`). ``session-token`` is the loopback Webapp's own credential and
 # ``server-internal`` the PTY child a signed-in dashboard spawns: both act for whoever opened that page,
 # the owner. ``local`` (a native grant) is not a sign-in: its stamp names an OS user (:func:`_owner_login`).
-_BUNDLED_LOGINS = frozenset({'basic', 'nous', 'self-hosted', 'session-token', 'server-internal'})
+# [daveey] ``desktop-ssh`` is another Mac's Desktop driving this host's loopback ``serve --isolated`` through
+# a token file it wrote over SSH as this host's OS user (web_server._ssh_bootstrap_session): the owner too,
+# or its archive/pin/rename of the owner's own chats is refused as permission_denied.
+_BUNDLED_LOGINS = frozenset({'basic', 'nous', 'self-hosted', 'session-token', 'server-internal', 'desktop-ssh'})
 
 
 def _login_provider(provider: str) -> bool:
diff --git a/tests/gateway/test_webapp_owner_identity.py b/tests/gateway/test_webapp_owner_identity.py
index 195445a2bb9..24ace872bed 100644
--- a/tests/gateway/test_webapp_owner_identity.py
+++ b/tests/gateway/test_webapp_owner_identity.py
@@ -130,3 +130,31 @@ def test_an_old_chat_a_webapp_tab_edited_is_adopted_by_the_owner(store):
         adopt('uid:999999')
     adopt(OWNER)
     assert store.db.get_session('legacy-web')['user_id'] == OWNER
+
+
+def _ssh_desktop_request(tmp_path):
+    """A REST request as an SSH-served Desktop presents it: the loopback ``serve --isolated`` binds the
+    validated token file's ownership id as ``provider='desktop-ssh'`` (web_server._ssh_bootstrap_session)."""
+    from hermes_cli.dashboard_auth.base import Session
+    session = Session(user_id='a' * 32, provider='desktop-ssh', email='', display_name='', org_id='',
+                      expires_at=0, access_token='', refresh_token='')
+    return SimpleNamespace(state=SimpleNamespace(native_http_principal=None, session=session),
+                           app=SimpleNamespace(state=SimpleNamespace(session_authority=None, gateway_runner=None)))
+
+
+def test_another_macs_ssh_desktop_edits_the_owners_desktop_chat(store, tmp_path):
+    """Archive/pin/rename from another Mac's Desktop over SSH is the owner (it logged in over SSH as this
+    host's OS user), so the owner's routeless desktop chat (user_id = the owner) is its to edit (#archive 403)."""
+    from hermes_cli.web_server_sessions import _session_mutation_context
+    from hermes_state_mutation_binding import authorize_history
+    _authority, actor = _session_mutation_context(_ssh_desktop_request(tmp_path), None)
+    assert actor.subject == OWNER
+    store.db.create_session('hub-desktop-chat', source='desktop', user_id=OWNER)
+    with store.db._read_ctx() as conn:
+        assert authorize_history(conn, actor, 'hub-desktop-chat') is True
+
+
+@pytest.mark.parametrize('stamp', ['desktop-ssh:' + 'a' * 32, 'auth:v1:["desktop-ssh","","' + 'a' * 32 + '"]'])
+def test_a_stamp_an_ssh_desktop_stored_reads_as_the_owners(stamp):
+    assert same_owner(stamp, OWNER) is True
+    assert same_owner(stamp, 'uid:999999') is False
-- 
