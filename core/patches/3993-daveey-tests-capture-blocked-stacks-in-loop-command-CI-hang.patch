From d7bf9f9b2d2d9b66f345f4cd30361c50377acc4f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 23:13:48 +0000
Subject: [PATCH] [daveey] tests: capture blocked stacks in loop command CI
 hang

Two exact-head CI runs timed out after six loop-command tests without a stack. Local verbose, default-capture and forced-GC runs pass. Capture a 30-second faulthandler dump before the unchanged per-file hard timeout; retain every assertion. Diagnostic only: no root cause claimed.
---
 tests/tui_gateway/test_loop_command.py | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/tests/tui_gateway/test_loop_command.py b/tests/tui_gateway/test_loop_command.py
index ae7b25cd35..fcf0c980fa 100644
--- a/tests/tui_gateway/test_loop_command.py
+++ b/tests/tui_gateway/test_loop_command.py
@@ -9,6 +9,7 @@ wakeups via ``_maybe_fire_tui_loop_tick``.
 
 from __future__ import annotations
 
+import faulthandler
 import importlib
 import threading
 import time
@@ -18,6 +19,16 @@ from unittest.mock import MagicMock, patch
 import pytest
 
 
+@pytest.fixture(autouse=True)
+def _diagnose_loop_command_hang():
+    """Keep blocked-thread evidence before the per-file runner's hard timeout."""
+    faulthandler.dump_traceback_later(30)
+    try:
+        yield
+    finally:
+        faulthandler.cancel_dump_traceback_later()
+
+
 @pytest.fixture()
 def hermes_home(tmp_path, monkeypatch):
     home = tmp_path / ".hermes"
