From d71f0613a295840d14c45241fcb1c5beb8ffddad Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 14:06:58 +0000
Subject: [PATCH] [daveey] test(hub-admission): pin the verdict to the Board's
 holder claim, not the later lock claim

test_unjudged_claims_is_empty_before_the_gate_and_ignores_later_verdicts
stamped the hub_admission verdict at MAX(created_at) over every 'claimed'
event. A hub claim writes two: the Board's holder-tagged claim, stamped at
grant time, and the local lock claim, written after it. When a second
boundary falls between them (likely on a throttled CI runner), the verdict
lands a second after the holder claim, the gate opens after it and
unjudged_claims rightly drops it as pre-gate: [] != [early].

Stamp the verdict at the holder claim's time, the claim unjudged_claims
reads. Red on the base with the lock claim bumped +1s, green with the fix.

Task: t_01a1d533437fa189
---
 tests/hermes_cli/test_kanban_hub_admission_claim.py | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_hub_admission_claim.py b/tests/hermes_cli/test_kanban_hub_admission_claim.py
index 902d840ebd..cfb2d4e0d0 100644
--- a/tests/hermes_cli/test_kanban_hub_admission_claim.py
+++ b/tests/hermes_cli/test_kanban_hub_admission_claim.py
@@ -499,10 +499,13 @@ def test_unjudged_claims_is_empty_before_the_gate_and_ignores_later_verdicts(gws
     with kb.write_txn(hub.conn):  # a verdict recorded after the claim does not make that claim judged
         kb._append_event(hub.conn, early, "hub_admission", {"admit": True, "entry": "move"})
         # Same second as the claim: the gate opens no later than the claim (else the claim predates the gate
-        # and is rightly ignored), but the verdict still follows it by event id.
+        # and is rightly ignored), but the verdict still follows it by event id. The claim is the Board's
+        # holder-tagged one, stamped at grant time: the local lock claim lands after it and can fall in the next
+        # second, which would open the gate after the claim.
         hub.conn.execute(
             "UPDATE task_events SET created_at = (SELECT MAX(created_at) FROM task_events WHERE task_id = ? "
-            "AND kind = 'claimed') WHERE task_id = ? AND kind = 'hub_admission'", (early, early))
+            "AND kind = 'claimed' AND json_extract(payload, '$.holder') = ?) "
+            "WHERE task_id = ? AND kind = 'hub_admission'", (early, HUB, early))
     assert [tid for tid, _at in hac.unjudged_claims(hub.conn, HUB)] == [early]
     audited = _hub_card(hub, title="admitted at creation",
                         placement_audit={"hub_admission": {"admit": True, "entry": "create", "why": "ok"}})
