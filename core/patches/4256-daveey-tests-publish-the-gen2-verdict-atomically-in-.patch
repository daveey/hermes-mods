From a50dff0c97f53429441c6e0709241026ef0be096 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 17:25:20 +0000
Subject: [PATCH] [daveey] tests: publish the gen2 verdict atomically in the
 POSIX hand-off pid test

test_a_later_update_generation_adopts_the_handoffs_claim flaked in CI
(run 43617394175, Python tests slice 6/8): the fake generation-1
`hermes update` died with JSONDecodeError on an empty verdict file, while
pytest's own later read of the same file saw adopted=true.

Cause: the generation-2 probe wrote its verdict with Path.write_text,
which creates (truncates) the file before writing. Generation 1 polls
`out.exists()` every 50 ms and parses the file at once, so it could read
the empty file in that window and exit 1.

Fix (test-only): the probe writes a sibling `.part` file and os.replace()s
it onto the verdict path, so the file only ever appears complete. No
production update_lock/posix.sh change; all assertions unchanged.

Proof: a scratch harness that patches the probe's Path.write_text to
sleep 1 s between open and write fails the old fixture deterministically
(JSONDecodeError on '') and passes with this change; the real test passes.
---
 .../scripts/desktop_update/test_posix_handoff_pid_export.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/tests/scripts/desktop_update/test_posix_handoff_pid_export.py b/tests/scripts/desktop_update/test_posix_handoff_pid_export.py
index 6389b364db..c4fcb2ee69 100644
--- a/tests/scripts/desktop_update/test_posix_handoff_pid_export.py
+++ b/tests/scripts/desktop_update/test_posix_handoff_pid_export.py
@@ -27,6 +27,8 @@ REPOSITORY = Path(__file__).resolve().parents[3]
 # The update child (generation 1) starts generation 2 through an intermediate that exits at once,
 # so generation 2 is reparented away from it (no ancestry to lean on), then waits for its verdict.
 # Generation 2 runs this repository's real UpdateLock against the marker the real posix.sh wrote.
+# It publishes its verdict with os.replace: generation 1 reads the file as soon as it exists, and a
+# plain write_text creates it empty before writing, which generation 1 could read as invalid JSON.
 SECOND_GENERATION = """
 import os, sys, json, subprocess, time
 from pathlib import Path
@@ -37,9 +39,11 @@ if sys.argv[1:2] == ['update'] and '--help' not in sys.argv:  # not the --keep-s
         "from hermes_cli.update_lock import UpdateLock, update_marker_path\\n"
         "lock = UpdateLock(path=update_marker_path())\\n"
         "ok = lock.acquire()\\n"
-        "Path(sys.argv[1]).write_text(json.dumps({'adopted': ok, 'pid': os.getpid(), "
+        "part = Path(sys.argv[1] + '.part')\\n"
+        "part.write_text(json.dumps({'adopted': ok, 'pid': os.getpid(), "
         "'holder': lock.holder.pid if lock.holder else None, "
         "'told': os.environ.get('HERMES_UPDATE_HANDOFF_PID')}), encoding='utf-8')\\n"
+        "os.replace(part, sys.argv[1])\\n"
         "ok and lock.release()\\n")
     env = {k: v for k, v in os.environ.items() if not k.startswith('PYTHON')}
     env['PYTHONPATH'] = os.environ['GEN2_REPO']
-- 
