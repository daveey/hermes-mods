---
diff --git a/hermes_cli/kanban_annotation_parts.py b/hermes_cli/kanban_annotation_parts.py
index a02be0db767..2a64c3e045b 100644
--- a/hermes_cli/kanban_annotation_parts.py
+++ b/hermes_cli/kanban_annotation_parts.py
@@ -139,7 +139,7 @@
     content = tuple((p, ksa._board_content_key(Path(p), ksa._revision.SHADOW_TABLES)) for p in replicas)
     if not ksa._revalidate.revalidatable(content, wall):
         return object()
-    return (tuple(sorted(ksa._done_checks)), content, _signature(scope, paths - set(replicas)))
+    return (tuple(sorted(ksa._done_checks.items())), content, _signature(scope, paths - set(replicas)))
 
 
 def keys(scope: tuple[str, ...]) -> dict[str, object] | None:
diff --git a/tests/hermes_cli/test_kanban_annotation_semantic_attention.py b/tests/hermes_cli/test_kanban_annotation_semantic_attention.py
new file mode 100644
index 00000000000..3447b3a6108
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_annotation_semantic_attention.py
@@ -0,0 +1,26 @@
+"""Provider replacement is a semantic input, not only a set of check names."""
+from hermes_cli import kanban_session_activity as ksa
+from tests.hermes_cli import test_kanban_annotation_parts as helpers
+
+world = helpers.world
+
+
+def test_replacing_a_declared_closure_rechecks_attention(world):
+    helpers._refresh()
+    before = helpers._reads(world)
+    assert before[2] > 0
+    assert helpers._published()[10] == {'s1': 1}
+
+    def replacement(card):
+        world.checks += 1
+        return False
+
+    dispose = ksa.register_done_check('fixture', replacement,
+                                      watch_paths=lambda: [world.declared], next_deadline=lambda: None)
+    try:
+        helpers._refresh()
+        assert world.checks == before[2] + 1
+        assert helpers._published()[10] == {}
+        assert helpers._reads(world)[:2] == before[:2]
+    finally:
+        dispose()
