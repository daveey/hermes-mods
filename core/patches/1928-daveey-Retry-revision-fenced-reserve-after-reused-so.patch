+                srv.dropped.set()
             self.close_connection = True
             self.connection.shutdown(socket.SHUT_RDWR)
             return
@@ -131,7 +135,8 @@ def test_stale_socket_get_is_retried_once(server, monkeypatch):
 
 
 @pytest.mark.parametrize("elapsed", [1.5, 2.1])
