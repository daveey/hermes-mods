From 00089f59fbb93c01ee6b03aea29dfa1d039b2c1d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 17:30:51 -0700
Subject: [PATCH] test(tools): exit-cleanup test waits for the foreground
 command to be registered before cleaning up (#129)

The child is visible in /proc before execute() publishes it in _live_foreground; on a
CPU-starved runner cleanup_all_environments ran in that window and found nothing to kill.
Reproduced by delaying publication 2s; fixed by waiting on the registration event.
---
 tests/tools/test_local_interrupt_cleanup.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/tests/tools/test_local_interrupt_cleanup.py b/tests/tools/test_local_interrupt_cleanup.py
index efd6fba406d..6ae1f7855a7 100644
--- a/tests/tools/test_local_interrupt_cleanup.py
+++ b/tests/tools/test_local_interrupt_cleanup.py
@@ -230,6 +230,12 @@ def test_exit_cleanup_kills_foreground_command_still_running(monkeypatch, caplog
         while (proc := _descendant_running("sleep 3517")) is None and time.monotonic() < deadline:
             time.sleep(0.05)
         assert proc is not None, "test setup: foreground sleep never started"
+        # The child is visible in /proc a moment before execute() publishes it in
+        # _live_foreground; cleaning up in that window (a starved runner) finds nothing to kill.
+        from tools.environments import base as env_base
+        while not env_base._live_foreground and time.monotonic() < deadline:
+            time.sleep(0.05)
+        assert env_base._live_foreground, "test setup: foreground command never registered"
         pgid = os.getpgid(proc.pid)
 
         terminal_tool_lifecycle.cleanup_all_environments()
