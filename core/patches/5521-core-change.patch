         out_lanes[name] = {
@@ -348,6 +351,6 @@ def snapshot(conn, *, window: str = "6h", now: Optional[float] = None, pol=None,
             "limits": {"cards_per_day": spec.cards_per_day, "usd_per_day": spec.usd_per_day,
