From 699b7de0787e6f2809ed967e14570833c000d583 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 12:30:13 +0000
Subject: [PATCH] [daveey] lanes: one spend scan per projection; reuse
 request-derived PR url per card

The lanes flow projection ran the whole worker_result spend aggregate once per lane
(spent_today in a loop) and re-derived each card's PR url from its full history although
Evidence already holds it. On a 156-open-card board that is about 0.3 s and 0.2 s of a ~1 s
expanded projection; on the loaded hub the same projection took ~3 s and was the dominant stage
of the lanes push change->frame latency (t_45b2ec2f725df5fd).

- lanes.spent_by_lane: one scan, same rounding and per-lane association as spent_today
  (which now delegates); flow.snapshot uses it once.
- flow._pr_snapshot(url=): _card_from_row passes the evidence-derived URL (identical derivation).

Proof: tests compare the single scan to the legacy per-lane scan for known/unknown tenants,
assert one worker_result scan, and compare evidence vs plain flow PR urls. RED before
(spent_by_lane missing), GREEN after; test_kanban_lanes{,_flow,_sources}: 106 passed.
---
 hermes_cli/kanban_lanes.py                 | 20 +++++--
 hermes_cli/kanban_lanes_flow.py            | 11 ++--
 tests/hermes_cli/test_kanban_lanes_flow.py | 65 ++++++++++++++++++++++
 3 files changed, 86 insertions(+), 10 deletions(-)

diff --git a/hermes_cli/kanban_lanes.py b/hermes_cli/kanban_lanes.py
index 601745458d..c13a7f6616 100644
--- a/hermes_cli/kanban_lanes.py
+++ b/hermes_cli/kanban_lanes.py
@@ -545,19 +545,27 @@ def cards_today(conn, lane: str, *, now: Optional[float] = None, pol=None) -> in
     return count(conn, lane, now=now, pol=pol)
 
 
-def spent_today(conn, pol: Policy, lane: str, *, now: Optional[float] = None) -> float:
-    """Run spend charged to ``lane`` since local midnight (same receipts ``usage`` uses)."""
+def spent_by_lane(conn, pol: Policy, *, now: Optional[float] = None) -> dict[str, float]:
+    """Run spend charged to every lane since local midnight, from ONE scan of the receipts. [daveey]
+
+    ``spent_today`` per lane re-ran this whole aggregate once for each lane in every lanes projection.
+    """
     start = day_start(now)
-    total = 0.0
+    totals = {name: 0.0 for name in pol.lanes}
     for tenant, cost in conn.execute(
             "SELECT tenant, SUM(cost) FROM ("
             "SELECT t.tenant AS tenant, MAX(COALESCE(json_extract(e.payload, '$.usage.cost_usd'), 0)) AS cost "
             "FROM task_events e JOIN tasks t ON t.id = e.task_id WHERE e.kind = 'worker_result' "
             "AND e.created_at >= ? AND json_extract(e.payload, '$.usage') IS NOT NULL "
             "GROUP BY e.task_id, e.run_id) GROUP BY tenant", (start,)):
-        if pol.lane_of(tenant) == lane:
-            total += float(cost or 0)
-    return round(total, 2)
+        name = pol.lane_of(tenant)
+        totals[name] = totals.get(name, 0.0) + float(cost or 0)
+    return {name: round(total, 2) for name, total in totals.items()}
+
+
+def spent_today(conn, pol: Policy, lane: str, *, now: Optional[float] = None) -> float:
+    """Run spend charged to ``lane`` since local midnight (same receipts ``usage`` uses)."""
+    return spent_by_lane(conn, pol, now=now).get(lane, 0.0)
 
 
 def _daily_limit_reason(conn, pol: Policy, lane_name: str, opts: dict) -> Optional[str]:
