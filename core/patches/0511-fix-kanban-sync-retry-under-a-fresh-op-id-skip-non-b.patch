From 29bf90695b6ae1bc7d675797ac238f674a8c0b0a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 12:28:40 -0700
Subject: [PATCH] fix(kanban-sync): retry under a fresh op id; skip non-board
 folders [daveey]

- A transient rejection retried under the same client_op_id got the service's
  remembered answer back forever (applied_ops idempotency): link rows refused
  'unknown table' during a deploy kept being refused after the Board knew the
  table. A deferred row now gets a fresh op id for its next attempt.
- board_paths() keeps only valid board ids: boards/_archived holds archived
  boards and failed every round ('invalid board id').

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/kanban_sync_client.py            | 13 ++++++++++---
 tests/hermes_cli/test_kanban_sync_client.py | 15 +++++++++++++++
 2 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index 3a1469fca4..ad3308009c 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -24,6 +24,7 @@ from __future__ import annotations
 
 import json
 import logging
+import re
 import sqlite3
 import threading
 import time
@@ -45,6 +46,7 @@ SNAPSHOT_PAGE = 1000
 HTTP_TIMEOUT_S = 30.0
 EVENT_IMPORT_WINDOW_S = 30 * 24 * 3600  # the service's event retention (worker board.ts EVENT_RETENTION_MS)
 # Row order for an import: links need both tasks, everything else names its task.
+BOARD_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")  # the service's BOARD_RE
 IMPORT_ORDER = ("tasks", "task_links", "task_runs", "task_comments", "task_events", "task_attachments", "task_chat_links")
 
 
@@ -135,7 +137,9 @@ def board_paths() -> list[tuple[str, Path]]:
     found = [("default", root / "kanban.db")] if (root / "kanban.db").exists() else []
     boards = kanban_db.boards_root()
     if boards.is_dir():
-        found += [(p.parent.name, p) for p in sorted(boards.glob("*/kanban.db")) if p.is_file()]
+        # Only real board slugs (the service's board-id rule): ``_archived/`` holds archived boards, not a board.
+        found += [(p.parent.name, p) for p in sorted(boards.glob("*/kanban.db"))
+                  if p.is_file() and BOARD_ID_RE.match(p.parent.name)]
     return [(slug, path) for slug, path in found if sync.board_selected(str(path))]
 
 
@@ -320,8 +324,11 @@ def push(conn: sqlite3.Connection, hub: Hub, board: str, gateway: str, *, primar
                     # The service will accept this later (a deploy still rolling out, a storage hiccup, an earlier op
                     # on the card that was itself transient): keep it pending and retry next round.
                     reason = f"{res.get('reason')}: {res.get('detail') or ''}".strip(": ")
-                    conn.execute("UPDATE kanban_sync_outbox SET attempts = attempts + 1, last_error = ?, retry_after = ? "
-                                 "WHERE op_id = ?", (f"retrying: {reason}"[:500], int(time.time()) + _backoff_s(row["attempts"]), op_id))
+                    # A fresh op id: the service remembers every answer by op id (idempotency), so a retry under the
+                    # old id would get the same rejection back forever.
+                    conn.execute("UPDATE kanban_sync_outbox SET op_id = ?, attempts = attempts + 1, last_error = ?, "
+                                 "retry_after = ? WHERE op_id = ?",
+                                 (sync.uuid7(), f"retrying: {reason}"[:500], int(time.time()) + _backoff_s(row["attempts"]), op_id))
                     out.deferred += 1
                 else:
                     reason = f"{res.get('reason')}: {res.get('detail') or ''}".strip(": ")
diff --git a/tests/hermes_cli/test_kanban_sync_client.py b/tests/hermes_cli/test_kanban_sync_client.py
index bebeaf5657..ee25a16610 100644
--- a/tests/hermes_cli/test_kanban_sync_client.py
+++ b/tests/hermes_cli/test_kanban_sync_client.py
@@ -6,6 +6,7 @@ from __future__ import annotations
 
 import hashlib
 import json
+import sqlite3
 import time
 
 import pytest
@@ -680,8 +681,11 @@ def test_transient_rejections_retry_next_round_and_give_up_after_a_cap(live, svc
     real = svc.hub(ME).ops
     calls = {"n": 0}
 
+    remembered = set()
+
     def rolling_out(board, ops):  # the service has not picked up the new code yet
         calls["n"] += 1
+        remembered.update(o["client_op_id"] for o in ops)
         return {"results": [{"client_op_id": o["client_op_id"], "status": "rejected", "reason": "invalid",
                              "detail": f"unknown table {o['table']}"} for o in ops], "head": 0}
     hub = svc.hub(ME)
@@ -693,6 +697,8 @@ def test_transient_rejections_retry_next_round_and_give_up_after_a_cap(live, svc
     assert ksc.push(live, hub, BOARD, ME, primary=False).sent == 0  # backing off: not retried at once
     with kbc.write_txn(live):
         live.execute("UPDATE kanban_sync_outbox SET retry_after = 0")  # the backoff elapsed
+    # The retry goes under a fresh op id: the service would replay its remembered rejection for the old one.
+    assert not ({r[0] for r in live.execute("SELECT op_id FROM kanban_sync_outbox")} & remembered)
     assert ksc.push(live, hub, BOARD, ME, primary=False).rejected == 0
     assert tid in svc.board(BOARD)["rows"]["tasks"] and not _pending(live)
     # A rejection that never clears ends up rejected after the cap.
@@ -732,3 +738,12 @@ def test_a_child_queued_before_its_card_does_not_hold_the_card_back(live, svc):
     assert svc.board(BOARD)["rows"]["tasks"][tid]["title"] == "made before attach"
     assert live.execute("SELECT sync_version FROM tasks WHERE id = ?", (tid,)).fetchone()[0] is not None
     assert any(c["body"] == "captured first" for c in svc.board(BOARD)["rows"]["task_comments"].values())
+
+
+def test_board_discovery_skips_the_archive_folder(kanban_home):
+    support.write_sync_config(kanban_home, True)
+    for slug in ("_archived", "runners"):
+        d = kanban_home / "kanban" / "boards" / slug
+        d.mkdir(parents=True, exist_ok=True)
+        sqlite3.connect(d / "kanban.db").close()
+    assert [s for s, _ in ksc.board_paths()] == ["runners"]
