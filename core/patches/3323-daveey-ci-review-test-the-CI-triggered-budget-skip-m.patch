From 96fbbb345723409d37abed99515080915ae1dc4c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 09:28:19 +0000
Subject: [PATCH] [daveey] ci-review: test the CI-triggered budget-skip marker;
 word the budget-skip log line per mode (PR #1967 review nits)

Review 5888188312 nits:
1. The budget-skip failed marker was only tested with trigger_workflow=''
   (re_refresh=False). New test: a CI-triggered targeted run skipped by
   the budget gate queues exactly one re-refresh and records requeued=
   in the comment's state line.
2. The budget-skip log line ended 'the next sweep takes them' in every
   mode. It now says that only for the sweep; a CI-triggered targeted run
   says each PR is marked failed with at most one re-refresh per head
   queued, and the re-refresh/dispatch run says the hourly sweep is next.
---
 scripts/ci/batch_review_comments.py    |  8 ++++-
 tests/ci/test_batch_review_comments.py | 46 ++++++++++++++++++++++++++
 2 files changed, 53 insertions(+), 1 deletion(-)

diff --git a/scripts/ci/batch_review_comments.py b/scripts/ci/batch_review_comments.py
index e9da513d91..ae16d167c7 100644
--- a/scripts/ci/batch_review_comments.py
+++ b/scripts/ci/batch_review_comments.py
@@ -454,8 +454,14 @@ def run_batch(token: str, repo: str, now: datetime | None = None, *, head_sha: s
         if deadline is not None and _clock() + lc.DOWNLOAD_ATTEMPT_MAX_S + PR_MIN_BUDGET_S > deadline:
             left = len(targets) - i
             failures += left
+            if not head_sha:
+                then = "the next sweep takes them"
+            elif trigger_workflow:  # mark_refresh_failed queues one re-refresh per head (or notes the queued one)
+                then = "each is marked refresh failed; at most one re-refresh per head is queued, then the hourly sweep"
+            else:  # the re-refresh itself (or a dispatch) queues nothing
+                then = "each is marked refresh failed; the hourly sweep is next"
             print(f"ERROR run budget ({RUN_BUDGET_S}s) spent: {left} PR(s) not refreshed "
-                  f"(#{', #'.join(str(p['number']) for p in targets[i:])}); the next sweep takes them",
+                  f"(#{', #'.join(str(p['number']) for p in targets[i:])}); {then}",
                   file=sys.stderr)
             if head_sha:  # a targeted run must not leave "running on" standing as if live (PR #1907 review)
                 for skipped in targets[i:]:
diff --git a/tests/ci/test_batch_review_comments.py b/tests/ci/test_batch_review_comments.py
index abcf053099..8af02802e2 100644
--- a/tests/ci/test_batch_review_comments.py
+++ b/tests/ci/test_batch_review_comments.py
@@ -774,6 +774,52 @@ def test_a_targeted_run_skipped_by_the_budget_gate_marks_the_comment_failed(monk
     assert d.dispatches == []  # the re-refresh itself (a dispatch) never queues another
 
 
+def test_a_ci_triggered_run_skipped_by_the_budget_gate_queues_one_re_refresh(monkeypatch, tmp_path, capsys):
+    """Review 5888188312 nit 1: the CI-triggered branch (re_refresh=True) of the budget-skip marker queues exactly one
+    re-refresh and records ``requeued=`` in the comment; nit 2: its log line names that, not "the next sweep"."""
+    from datetime import timedelta
+    sha = "a" * 40
+    prs = [_pr(1, sha)]
+    f = Fake(monkeypatch, prs, {sha: [_done(5, sha)]}, fresh=_fresh(prs),
+             comments={1: [_running_comment(sha, NOW - timedelta(minutes=20))]})
+    d = Downloads(monkeypatch, tmp_path, fail=0)
+    c = Clock(monkeypatch, d, 1.0)
+    c.t = b.RUN_BUDGET_S - 10
+    assert b.run_batch("t", REPO, NOW, head_sha=sha, trigger_workflow="CI", deadline=float(b.RUN_BUDGET_S)) == 1
+    assert d.calls == 0 and f.collected == []
+    body = f.posted["1"]
+    assert BOT_HEAD.search(body) is None and "refresh failed on [aaaaaaa]" in body and "run budget" in body
+    assert "re-refresh queued" in body and b.requeued_at(body, sha) is not None
+    assert body.count(b.STATE_PREFIX) == 1 and " requeued=" in body
+    assert len(d.dispatches) == 1
+    assert d.dispatches[0][1]["inputs"]["head_sha"] == sha
+    err = capsys.readouterr().err
+    assert "the next sweep takes them" not in err
+    assert "one re-refresh per head is queued" in err
+
+
+def test_budget_skip_log_line_is_worded_per_mode(monkeypatch, tmp_path, capsys):
+    """Review 5888188312 nit 2: the sweep defers to the next sweep; a targeted re-refresh (no trigger) marks the PR
+    failed and points at the hourly sweep, never claiming a re-refresh was queued."""
+    from datetime import timedelta
+    sha = "a" * 40
+    prs = [_pr(1, sha)]
+    f = Fake(monkeypatch, prs, {sha: [_done(5, sha)]}, fresh=_fresh(prs),
+             comments={1: [_running_comment(sha, NOW - timedelta(minutes=20))]})
+    d = Downloads(monkeypatch, tmp_path, fail=0)
+    c = Clock(monkeypatch, d, 1.0)
+    c.t = b.RUN_BUDGET_S - 10
+    assert b.run_batch("t", REPO, NOW, deadline=float(b.RUN_BUDGET_S)) == 1
+    err = capsys.readouterr().err
+    assert "the next sweep takes them" in err and "marked refresh failed" not in err
+    f.posted.clear()
+    assert b.run_batch("t", REPO, NOW, head_sha=sha, trigger_workflow="", deadline=float(b.RUN_BUDGET_S)) == 1
+    err = capsys.readouterr().err
+    assert "the next sweep takes them" not in err and "re-refresh" not in err.split("\n")[0]
+    assert "marked refresh failed; the hourly sweep is next" in err
+    assert d.dispatches == []
+
+
 def test_the_sweep_skipped_by_the_budget_gate_writes_no_marker(monkeypatch, tmp_path):
     from datetime import timedelta
     sha = "a" * 40
-- 
