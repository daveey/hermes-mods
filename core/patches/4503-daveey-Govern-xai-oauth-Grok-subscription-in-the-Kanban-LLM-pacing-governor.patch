diff --git a/tests/hermes_cli/test_kanban_llm_pacing_xai.py b/tests/hermes_cli/test_kanban_llm_pacing_xai.py
new file mode 100644
index 0000000000000000000000000000000000000000..2aae887d1eb8bbcde3dfc1f2165bdbc09189a827
