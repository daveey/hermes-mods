diff --git a/hermes_cli/kanban_awaiting.py b/hermes_cli/kanban_awaiting.py
index 547ce845229..16038db1ebe 100644
--- a/hermes_cli/kanban_awaiting.py
+++ b/hermes_cli/kanban_awaiting.py
@@ -1214,12 +1214,16 @@ def escalate(conn: sqlite3.Connection, task_id: str, *, record: dict, reason: Op
     # The first owner keeps the legacy key after completion. Later owners used to be keyless,
     # so retries never found an OPEN successor. The source ledger binds target, premise and episode
     # without title matching; its latest matching owner is authoritative, including terminal owners.
-    existing = conn.execute(
-        "SELECT t.id, t.status FROM task_events e JOIN tasks t "
+    from hermes_cli.kanban_sync_divergence import _event_order
+    uid = "e.uid" if "uid" in {r[1] for r in conn.execute("PRAGMA table_info(task_events)")} else "NULL"
+    episodes = conn.execute(
+        "SELECT t.id, t.status, e.id, e.created_at, " + uid + " FROM task_events e JOIN tasks t "
         "ON t.id = json_extract(e.payload, '$.owner_task_id') "
         "WHERE e.task_id = ? AND e.kind = ? "
-        "AND json_extract(e.payload, '$.awaiting.premise') = ? ORDER BY e.id DESC LIMIT 1",
-        (task_id, ESCALATED_EVENT, record['premise'])).fetchone()
+        "AND json_extract(e.payload, '$.awaiting.premise') = ?",
+        (task_id, ESCALATED_EVENT, record['premise'])).fetchall()
+    existing = max(episodes, key=lambda row: _event_order(
+        {"id": row[2], "created_at": row[3], "uid": row[4]}), default=None)
     if existing is None:
         existing = conn.execute("SELECT id, status FROM tasks WHERE idempotency_key = ?", (key,)).fetchone()
     owner = existing[0] if existing and existing[1] not in ("done", "archived") else None
diff --git a/tests/hermes_cli/test_kanban_escalation_successor.py b/tests/hermes_cli/test_kanban_escalation_successor.py
index 6fa246f29a9..45679bd6a9d 100644
--- a/tests/hermes_cli/test_kanban_escalation_successor.py
+++ b/tests/hermes_cli/test_kanban_escalation_successor.py
@@ -3,6 +3,7 @@ import concurrent.futures
 import json
 from pathlib import Path
 import threading
+import uuid
 
 import pytest
 
@@ -131,6 +132,31 @@ def test_concurrent_retry_after_terminal_episode_retains_all_nine_reasons(kanban
         assert conn.execute("SELECT count(*) FROM tasks WHERE status NOT IN ('done','archived') AND id != ?", (tid,)).fetchone()[0] == 1
 
 
+@pytest.mark.parametrize("with_uid", [False, True])
+def test_delayed_older_episode_does_not_replace_latest_open_owner(kanban_home, monkeypatch, with_uid):
+    monkeypatch.setattr(kaw, "_supervisor_profile", lambda task: None)
+    with kbc.connect_closing() as conn:
+        tid = helpers._running(conn)
+        first = _escalate(conn, tid, "first")
+        _finish(conn, first)
+        successor = _escalate(conn, tid, "successor")
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, kaw.ESCALATED_EVENT,
+                             {"owner_task_id": first, "awaiting": RECORD, "reason": "late old delivery"})
+            rows = conn.execute("SELECT id FROM task_events WHERE task_id=? AND kind=? ORDER BY id", (tid, kaw.ESCALATED_EVENT)).fetchall()
+            if with_uid:
+                conn.execute("ALTER TABLE task_events ADD COLUMN uid TEXT")
+                # The older event arrives last. Both origin clocks share a second;
+                # UUID time, not local arrival or random UUID suffix, selects the successor.
+                for row, ms in zip(rows, (1, 9, 2), strict=True):
+                    uid = str(uuid.UUID(int=((1700000000 * 1000 + ms) << 80) | (7 << 76) | (2 << 62)))
+                    conn.execute("UPDATE task_events SET created_at=?,uid=? WHERE id=?", (1700000000, uid, row[0]))
+            else:
+                for row, second in zip(rows, (1700000000, 1700000001, 1700000000), strict=True):
+                    conn.execute("UPDATE task_events SET created_at=? WHERE id=?", (second, row[0]))
+        assert _escalate(conn, tid, "retry") == successor
+
+
 @pytest.mark.parametrize("finish_each", [False, True])
 def test_frozen_nine_records_preserve_open_vs_completed_episode_boundary(kanban_home, monkeypatch, finish_each):
     # Synthetic nine-record regression fixture; no private bundle attestation.
