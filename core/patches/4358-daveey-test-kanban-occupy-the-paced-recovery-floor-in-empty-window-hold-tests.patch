From b7523ba7aa68da4568f5942ec13522733bc5b708 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:17:17 +0000
Subject: [PATCH] [daveey] test(kanban): occupy the paced recovery floor in
 empty-window hold tests

---
 tests/hermes_cli/test_kanban_llm_pacing_empty_windows.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_llm_pacing_empty_windows.py b/tests/hermes_cli/test_kanban_llm_pacing_empty_windows.py
index 87233ee20b62411edf2260b60d2ef231fc0763ea..2415d3aae41604f370ccf6e20f8f0c48bcef000c 100644
--- a/tests/hermes_cli/test_kanban_llm_pacing_empty_windows.py
+++ b/tests/hermes_cli/test_kanban_llm_pacing_empty_windows.py
@@ -33,6 +33,7 @@ __all__ = ["paced_board"]
 
 def test_paced_after_an_expired_held_row_is_recorded_again(paced_board, monkeypatch):
     """Reviewer repro: pool reads paced -> held (reset now+60) -> paced; diagnostics an hour past the reset."""
+    monkeypatch.setattr(pd, "local_running", lambda *_a: 1)  # recovery floor occupied
     _config(paced_board, kanban={"llm_pacing": {"read_interval_seconds": 0}})
     phase, reset = ["paced"], [0.0]
 
@@ -64,6 +65,7 @@ def test_paced_after_an_expired_held_row_is_recorded_again(paced_board, monkeypa
 def test_a_flapping_hold_appends_at_most_one_row_per_expiry(paced_board, monkeypatch):
     """held <-> paced flaps do not refill the episode: once ``paced`` is newest, a later ``held`` (a key the episode
     holds) appends nothing, so the newest row stays the untimed ``paced`` one."""
+    monkeypatch.setattr(pd, "local_running", lambda *_a: 1)  # recovery floor occupied
     _config(paced_board, kanban={"llm_pacing": {"read_interval_seconds": 0}})
     phase = ["paced"]
 
-- 
