Date: Sat, 17 Oct 2026 01:55:13 -0700
Subject: [PATCH] fix(skills): provide safe recovery for stale patch batches
 [daveey]

---
 tests/tools/test_skill_patch_recovery.py | 74 ++++++++++++++++++++++++
 tools/skill_manager_batch.py             | 11 +++-
 tools/skill_manager_tool.py              | 18 +++++-
 3 files changed, 101 insertions(+), 2 deletions(-)
 create mode 100644 tests/tools/test_skill_patch_recovery.py

diff --git a/tests/tools/test_skill_patch_recovery.py b/tests/tools/test_skill_patch_recovery.py
new file mode 100644
index 0000000000..ec7551113d
--- /dev/null
+++ b/tests/tools/test_skill_patch_recovery.py
@@ -0,0 +1,74 @@
+"""Stale anchors must recover without overwriting concurrent skill additions."""
+import importlib
+import json
+
+import pytest
+
+PREFIX = "See references/integrations.md for per-integration notes "
+CURRENT = PREFIX + "(Hatch, Eight Sleep, Porsche Connect, Comelit intercom: its local web admin, backup/restore and face recognition)."
+BODY = "---\nname: probe\ndescription: Use when testing patch recovery.\n---\n# Probe\n" + ("Context.\n" * 90) + CURRENT + "\n"
+
+
+@pytest.fixture
+def skill(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    root = home / "skills" / "probe"
+    root.mkdir(parents=True)
+    (root / "SKILL.md").write_text(BODY)
+    (root / "references").mkdir()
+    (root / "references" / "notes.md").write_text(BODY)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_YOLO_MODE", "1")
+    import tools.skill_manager_tool as mod
+    importlib.reload(mod)
+    return root
+
+
+def dispatch(ops):
+    from tools.registry import registry
+    return json.loads(registry.dispatch("skill_manage", {"operations": ops}))
+
+
+@pytest.mark.parametrize("old", [PREFIX + "(Hatch).", PREFIX + "(Hatch, Eight Sleep, Porsche Connect)."])
+@pytest.mark.parametrize("file_path", [None, "references/notes.md"])
+def test_stale_anchor_reports_reload_and_whole_batch_retry(skill, old, file_path):
+    first = {"action": "write_file", "name": "probe", "file_path": "references/new.md", "file_content": "New lesson.\n"}
+    edit = {"action": "patch", "name": "probe", "old_string": old, "new_string": old + "\nNew lesson."}
+    if file_path:
+        edit["file_path"] = file_path
+    result = dispatch([first, edit])
+    assert result["success"] is False
+    assert not (skill / "references/new.md").exists()
+    target = skill / (file_path or "SKILL.md")
+    assert target.read_text() == BODY
+    recovery = result["recovery"]
+    assert recovery["tool"] == "skill_view"
+    assert recovery["arguments"] == ({"name": "probe", "file_path": file_path} if file_path else {"name": "probe"})
+    assert "preserve" in recovery["instruction"]
+    assert result["rollback_complete"] is True
+    assert result["operations_applied"] == 0
+    assert "entire batch" in result["retry_instruction"]
+    # Recovery uses the current anchor, preserves the concurrent addition, and retries BOTH ops.
+    edit.update(old_string=CURRENT, new_string=CURRENT + "\nNew lesson.")
+    assert dispatch([first, edit])["success"] is True
+    assert (skill / "references/new.md").read_text() == "New lesson.\n"
+    assert target.read_text() == BODY.replace(CURRENT, CURRENT + "\nNew lesson.")
+
+
+def test_failed_rollback_does_not_recommend_blind_batch_retry(skill, monkeypatch):
+    import tools.skill_manager_batch as batch
+    monkeypatch.setattr(batch, "_rollback", lambda *args: ("rollback failed", True))
+    result = dispatch([{"action": "patch", "name": "probe", "old_string": "absent anchor",
+                        "new_string": "new lesson"}])
+    assert result["success"] is False
+    assert result["rollback_complete"] is False
+    assert "operations_applied" not in result
+    assert "inspect every affected file" in result["retry_instruction"]
+
+
+def test_ambiguous_anchor_requires_unique_fresh_anchor(skill):
+    result = dispatch([{"action": "patch", "name": "probe", "old_string": "Context.",
+                        "new_string": "Updated context."}])
+    assert result["success"] is False
+    assert "unique anchor" in result["recovery"]["instruction"]
+    assert (skill / "SKILL.md").read_text() == BODY
diff --git a/tools/skill_manager_batch.py b/tools/skill_manager_batch.py
index 20f711b56b..5db367c23a 100644
--- a/tools/skill_manager_batch.py
+++ b/tools/skill_manager_batch.py
@@ -279,7 +279,16 @@ def _skill_manage_batch(operations, default_name: str | None = None, task_id: st
                         "success": False,
                         "error": (f"operations[{i}] ({op['action']} on '{names[i]}') failed: "
                                   f"{parsed.get('error', 'unknown error')} — batch aborted, {note}."),
-                        "failed_index": i, "completed_before_failure": i}
+                        "failed_index": i, "completed_before_failure": i,
+                        "rollback_complete": not rollback_failed,
+                        "retry_instruction": (
+                            "Rollback failed: inspect every affected file before retrying; "
+                            "some operations may remain applied."
+                            if rollback_failed else
+                            "No operations remain applied. After correcting the failed operation, "
+                            "retry the entire batch, including earlier operations that were rolled back.")}
+                    if not rollback_failed:
+                        fail["operations_applied"] = 0
                     # Carry the failing op's teaching payload (patch's file_preview /
                     # fuzzy-match hints) through — without it the model recovers blind.
                     for k, v in parsed.items():
diff --git a/tools/skill_manager_tool.py b/tools/skill_manager_tool.py
index 6532085c8c..365156e389 100644
--- a/tools/skill_manager_tool.py
+++ b/tools/skill_manager_tool.py
@@ -622,7 +622,23 @@ def _patch_skill(name: str, old_string: str, new_string: str, file_path: str | N
         with suppress(Exception):
             from tools.fuzzy_match import format_no_match_hint
             match_error += format_no_match_hint(match_error, match_count, old_string, content)
-        return _err(match_error) | {"file_preview": _clip(content, 500, "...")}
+        # A stale anchor is not permission to replace a similar, newer passage. Give
+        # an actionable read rather than only the opening 500 chars (usually frontmatter).
+        # Keep it structured so the batch wrapper cannot bury it in truncated prose.
+        read_args = {"name": name}
+        if file_path:
+            read_args["file_path"] = file_path
+        return _err(match_error) | {
+            "file_preview": _clip(content, 500, "..."),
+            "recovery": {
+                "tool": "skill_view", "arguments": read_args,
+                "instruction": (
+                    "Reload this exact file before retrying. old_string may be stale or "
+                    "ambiguous; copy a unique anchor from the fresh read and preserve newer "
+                    "content when constructing new_string. Do not resend the unchanged patch "
+                    "or replace the whole file from an older snapshot."),
+            },
+        }
     if err := _validate_content_size(new_content, label=target_label):
         return _err(err)
     if not file_path and (err := _validate_frontmatter(new_content)):
