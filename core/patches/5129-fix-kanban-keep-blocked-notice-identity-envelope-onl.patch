From bc1480255183f4fc3cc8a373270f51a4b5f86543 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 04:31:38 +0000
Subject: [PATCH] fix(kanban): keep blocked notice identity; envelope only
 parked asks

Review 5987490092: the blocked ask_notice envelope changed blocked@<at> to blocked@<event_id>,
re-notifying delivered blocked cards and resurrecting stale ones on rollout. Blocked cards
already reach the origin chat through the terminal notice, so only decision_requested parks
are enveloped. Adds the reviewer's rollout probe as a regression test.
---
 hermes_cli/kanban_remote_ask.py               | 10 +++---
 .../test_kanban_remote_ask_rollout.py         | 36 +++++++++++++++++++
 2 files changed, 42 insertions(+), 4 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_remote_ask_rollout.py

diff --git a/hermes_cli/kanban_remote_ask.py b/hermes_cli/kanban_remote_ask.py
index faf8a61550..c62ca1fcab 100644
--- a/hermes_cli/kanban_remote_ask.py
+++ b/hermes_cli/kanban_remote_ask.py
@@ -6,14 +6,16 @@ import math
 def publish(conn, task: dict) -> dict | None:
     """Publish only the latest current park's ask, never a historical question."""
     status = task.get('status')
-    if status not in ('scheduled', 'blocked'):
+    # A blocked card already reaches the origin chat through the terminal notice, whose identity must not change
+    # on rollout (re-notifying delivered blocks / resurrecting stale ones): only a parked ask is enveloped.
+    if status != 'scheduled':
         return None
-    kinds = ('scheduled', 'continued', 'decision_requested') if status == 'scheduled' else ('blocked',)
+    kinds = ('scheduled', 'continued', 'decision_requested')
     marks = ','.join('?' for _ in kinds)
     row = conn.execute(
         f'SELECT id,kind,created_at,payload FROM task_events WHERE task_id=? AND kind IN ({marks}) ORDER BY id DESC LIMIT 1',
         (task['id'], *kinds)).fetchone()
-    if row is None or (status == 'scheduled' and row[1] != 'decision_requested'):
+    if row is None or row[1] != 'decision_requested':
         return None
     return {'event_id': row[0], 'kind': row[1], 'created_at': row[2], 'payload': json.loads(row[3] or '{}')}
 
@@ -23,7 +25,7 @@ def envelope(task: dict) -> dict | None:
     notice = task.get('ask_notice')
     if not isinstance(notice, dict):
         return None
-    expected = {'scheduled': 'decision_requested', 'blocked': 'blocked'}.get(task.get('status'))
+    expected = 'decision_requested' if task.get('status') == 'scheduled' else None
     if (expected is None or notice.get('kind') != expected or type(notice.get('event_id')) is not int
             or notice['event_id'] <= 0 or type(notice.get('created_at')) not in (int, float)
             or not math.isfinite(notice['created_at']) or not isinstance(notice.get('payload'), dict)):
diff --git a/tests/hermes_cli/test_kanban_remote_ask_rollout.py b/tests/hermes_cli/test_kanban_remote_ask_rollout.py
new file mode 100644
index 0000000000..b5391d4806
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_remote_ask_rollout.py
@@ -0,0 +1,36 @@
+import time
+import pytest
+from tests.tui_gateway import test_kanban_remote_wake as remote
+from tui_gateway import kanban_unloaded as ku
+from tui_gateway import kanban_remote_notices as krn
+
+home = remote.home
+
+
+def _sweeper(monkeypatch):
+    wakes = []
+    def wake(tip, text, metadata):
+        wakes.append(tip); remote._turn_writes_row(tip, text, metadata); return 'started'
+    monkeypatch.setattr(ku, 'wake_turn', wake)
+    monkeypatch.setattr(ku, '_spawn_thread', lambda job: job())
+    return wakes, lambda: ku.sweep_remote_once(set(), grace_s=0, gateway='macbook')
+
+
+@pytest.mark.parametrize('human', [True, False])
+@pytest.mark.parametrize('age', [600, 5 * 86400])
+def test_rollout_blocked_card_gains_ask_notice(home, monkeypatch, human, age):
+    at = time.time() - age
+    card = remote._blocked_on_david('t_blk', at)
+    if not human:
+        card.pop('human_request'); card['block_kind'] = 'dependency'
+    remote._publish(home, [card], arrived_ago=age)
+    wakes, sweep = _sweeper(monkeypatch)
+    sweep()
+    before = len(remote._notice_rows())
+    # owner upgrades: same block, now with an ask envelope
+    card2 = {**card, 'ask_notice': {'event_id': 4242, 'kind': 'blocked', 'created_at': at, 'payload': {'reason': 'x'}}}
+    remote._publish(home, [card2], arrived_ago=0)
+    sweep(); sweep()
+    after = len(remote._notice_rows())
+    print('HUMAN', human, 'AGE', age, 'BEFORE', before, 'AFTER', after, 'WAKES', wakes)
+    assert after == before, (before, after)
-- 
