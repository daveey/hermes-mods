Subject: [PATCH] test(cron): assert Bash 3.2 heredoc fixture outcomes [daveey]

---
 ...test_lifecycle_guard_heredoc_delimiters.py | 12 ++++++----
 .../test_lifecycle_guard_heredoc_escapes.py   | 14 +++++++----
 .../cron/test_lifecycle_guard_heredoc_nul.py  | 24 ++++++++++++++++++-
 3 files changed, 39 insertions(+), 11 deletions(-)

diff --git a/tests/cron/test_lifecycle_guard_heredoc_delimiters.py b/tests/cron/test_lifecycle_guard_heredoc_delimiters.py
index 1f05cd2dcbd7835ffdda044713042729b0e81584..23426a2b9e5852afe592c7bc06489ed25444cb6d 100644
--- a/tests/cron/test_lifecycle_guard_heredoc_delimiters.py
+++ b/tests/cron/test_lifecycle_guard_heredoc_delimiters.py
@@ -8,7 +8,8 @@ used to stop such a word at its first ``(`` or space, so the body had no termina
 were walked as commands of the script around it, and a ``}`` there closed the outer group early,
 hiding ``cat f.py`` from the ``} | python3`` it feeds. Now exact words parse whole, and a
 ``$(…)`` word is unparsable: the guard also walks the script once per later line holding ``$(``.
-Every terminator below is the one bash itself uses, checked with a harmless marker.
+Modern Bash terminators are checked with harmless markers; Bash 3.2's differing
+syntax outcomes are asserted explicitly without weakening the static guard cases.
 """
 
 from __future__ import annotations
@@ -21,6 +22,7 @@ import pytest
 
 from cron import lifecycle_guard_groups
 from cron.lifecycle_guard import scan_gateway_lifecycle
+from tests.cron.test_lifecycle_guard_heredoc_nul import _assert_bash_marker
 from tools.shell_heredoc import _parse_heredoc_operator
 
 # Assembled so this file's own text never carries the literal command.
@@ -83,7 +85,8 @@ def test_bash_ends_the_body_at_the_terminator(delimiter, terminator):
     command = _group(delimiter, terminator, "echo MARKER_FED", "cat")
     result = subprocess.run(["bash", "-c", command], capture_output=True, text=True,
                             timeout=20, check=False)
-    assert "MARKER_FED" in result.stdout.splitlines(), result.stderr
+    _assert_bash_marker(result, "MARKER_FED",
+                        bash32_rejects=(delimiter, terminator) in REPRINTED[1:])
 
 
 @pytest.mark.parametrize(("delimiter", "terminator"), EXACT)
@@ -169,7 +172,7 @@ def test_bash_reads_both_bodies_of_one_opener(words, first, second):
     command = _two_body_group(words, first, second, "echo MARKER_FED", "cat")
     result = subprocess.run(["bash", "-c", command], capture_output=True, text=True,
                             timeout=20, check=False)
-    assert "MARKER_FED" in result.stdout.splitlines(), result.stderr
+    _assert_bash_marker(result, "MARKER_FED", bash32_rejects="echo  E|cat" in words)
 
 
 def test_two_heredocs_on_one_opener_with_harmless_group_stay_allowed():
@@ -194,8 +197,7 @@ def test_reprinted_view_preserves_earlier_heredoc_bodies(tmp_path, prefix, delim
     if shutil.which("bash"):
         result = subprocess.run(["bash", "-c", command("echo MARKER_FED", "cat")],
                                 capture_output=True, text=True, timeout=20, check=False)
-        assert result.returncode == 0, result.stderr
-        assert "MARKER_FED" in result.stdout.splitlines(), result.stderr
+        _assert_bash_marker(result, "MARKER_FED", bash32_rejects="|cat" in delimiter)
 
 
 def _candidate_lines(count: int) -> str:
diff --git a/tests/cron/test_lifecycle_guard_heredoc_escapes.py b/tests/cron/test_lifecycle_guard_heredoc_escapes.py
index 697dd67765a3b894f9b02c4c4e5e177482f8bebe..c976ab508b6034e9280fb7bb42fe2be2b31dd43e 100644
--- a/tests/cron/test_lifecycle_guard_heredoc_escapes.py
+++ b/tests/cron/test_lifecycle_guard_heredoc_escapes.py
@@ -8,7 +8,9 @@ import subprocess
 import pytest
 
 from cron.lifecycle_guard import scan_gateway_lifecycle
-from tests.cron.test_lifecycle_guard_heredoc_nul import LIFECYCLE, _group
+from tests.cron.test_lifecycle_guard_heredoc_nul import (
+    LIFECYCLE, _assert_bash_marker, _bash32, _group,
+)
 from tools.shell_heredoc import _parse_heredoc_operator
 from tools.shell_heredoc_words import _decode_ansi_c
 
@@ -55,10 +57,11 @@ def test_bash_marker_and_harmless_controls(tmp_path, fragment, decoded, suffix):
     marker = tmp_path / "marker.py"
     marker.write_text("print('MARKER_EXECUTED')\n", encoding="utf-8")
     command = _group(word, terminator, marker, "python3")
-    result = subprocess.run(["bash", "--noprofile", "--norc"], input=command,
+    result = subprocess.run([shutil.which("bash") or "bash", "--noprofile", "--norc"], input=command,
                             capture_output=True, text=True, encoding="utf-8", timeout=20,
                             env={"PATH": "/usr/bin:/bin", "LC_ALL": "C.UTF-8"}, check=False)
-    assert (result.returncode, result.stdout, result.stderr) == (0, "MARKER_EXECUTED\n", "")
+    # 3.2 retains Unicode escapes and the second control-backslash literally.
+    _assert_bash_marker(result, "MARKER_EXECUTED", bash32_rejects=fragment != r"E\0ignored")
     assert scan_gateway_lifecycle(command) == (False, None)
     marker.write_text(f"import os\nos.system({LIFECYCLE!r})\n", encoding="utf-8")
     # Never execute this file: a non-interpreter sink only prints its source.
@@ -78,11 +81,12 @@ def test_bash_marker_and_harmless_controls(tmp_path, fragment, decoded, suffix):
 def test_bash_byte_boundaries(escape, hex_bytes):
     # Bash supports legacy UTF-8 above Unicode's limit until signed 32-bit overflow.
     # Those non-Unicode bytes cannot be a terminator in a UTF-8 str command.
-    result = subprocess.run(["bash", "--noprofile", "--norc"],
+    result = subprocess.run([shutil.which("bash") or "bash", "--noprofile", "--norc"],
                             input=f"printf %s $'{escape}'\n".encode(), capture_output=True,
                             timeout=20, env={"PATH": "/usr/bin:/bin", "LC_ALL": "C.UTF-8"},
                             check=False)
-    assert (result.returncode, result.stdout, result.stderr) == (0, bytes.fromhex(hex_bytes), b"")
+    expected = escape.encode() if _bash32() else bytes.fromhex(hex_bytes)
+    assert (result.returncode, result.stdout, result.stderr) == (0, expected, b"")
     if escape in (r"\U00110000", r"\U7FFFFFFF"):
         assert _decode_ansi_c(escape) == escape
 
diff --git a/tests/cron/test_lifecycle_guard_heredoc_nul.py b/tests/cron/test_lifecycle_guard_heredoc_nul.py
index c1a6d037e4272fa8d26080ed781e53725a2eab9b..c8fb202fea1f3b0c5555a11d85bab30a0cd56c0b 100644
--- a/tests/cron/test_lifecycle_guard_heredoc_nul.py
+++ b/tests/cron/test_lifecycle_guard_heredoc_nul.py
@@ -2,6 +2,7 @@
 
 from __future__ import annotations
 
+from functools import lru_cache
 import shlex
 import shutil
 import subprocess
@@ -31,6 +32,26 @@ WORDS = [
 ]
 
 
+@lru_cache(maxsize=1)
+def _bash32() -> bool:
+    result = subprocess.run(["bash", "--version"], capture_output=True, text=True,
+                            timeout=20, check=True)
+    return "version 3.2." in result.stdout
+
+
+def _assert_bash_marker(result, marker: str, *, bash32_rejects: bool):
+    # These exact modern-terminator fixtures are syntax errors on Bash 3.2,
+    # not successful execution proofs. Assert that boundary rather than skip it.
+    if _bash32() and bash32_rejects:
+        assert result.returncode == 2, result.stderr
+        assert result.stdout == ""
+        assert "syntax error" in result.stderr
+    else:
+        assert result.returncode == 0, result.stderr
+        assert marker in result.stdout.splitlines(), result.stderr
+        assert result.stderr == ""
+
+
 def _group(word, terminator, script, sink):
     return (f"{{\ncat >/dev/null <<{word}\n}}\n{terminator}\n"
             f"cat {shlex.quote(str(script))}\n}} | {sink}")
@@ -61,5 +82,6 @@ def test_nul_fragment_real_bash_and_harmless_control(tmp_path, word, terminator)
     result = subprocess.run(["bash", "--noprofile", "--norc", "-c", command],
                             capture_output=True, text=True, encoding="utf-8", timeout=20,
                             check=False)
-    assert (result.returncode, result.stdout, result.stderr) == (0, "MARKER_EXECUTED\n", "")
+    _assert_bash_marker(result, "MARKER_EXECUTED",
+                        bash32_rejects=word in (r"$'E\u0000junk'", r"$'E\U00000000junk'"))
     assert scan_gateway_lifecycle(command) == (False, None)
