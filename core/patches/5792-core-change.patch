From c9d83070c83fe9d224b6206bdaa9f7892c5635bb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 20:10:03 +0000
Subject: [PATCH] [daveey] Stop native annotation refresh building legacy
 narrow inventories

The native event holder plans independent part refreshes and never compares the legacy narrow key. Marking it active nevertheless made prepare rebuild semantic replica inventories before every read, ahead of the part gates.

Remove the native legacy-active toggle. Publish ordinary exact copies without narrow/watch extensions; preserve payloads, timestamps, strict adoption, event deadlines and the legacy holder. No synthetic freshness certificate, new timer, payload TTL or retained connection.

Proof: four new native preparation tests fail on parent and pass here; 465 annotation tests pass across 41 files without retries. Loop accounting consumers and scripts/check --base origin/main pass. Synthetic stable/alternating/reopened reader diagnostic confirms turnover susceptibility only; live CPU and sessions latency remain unverified pending natural deployment.
---
 hermes_cli/kanban_annotation_host.py          |  4 +-
 .../test_annotation_native_prepare.py         | 80 +++++++++++++++++++
 2 files changed, 82 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/test_annotation_native_prepare.py

diff --git a/hermes_cli/kanban_annotation_host.py b/hermes_cli/kanban_annotation_host.py
index 75714d45ee..7c3d22a0f1 100644
--- a/hermes_cli/kanban_annotation_host.py
+++ b/hermes_cli/kanban_annotation_host.py
@@ -695,7 +695,8 @@ def _event_refresh(events) -> float | None:
                 return None
             if not _ksa._annotate_refresh_lock.acquire(blocking=False):
                 return _scope_retry(scope)
-            _holder_ctx.active = True
+            # Native scheduling uses part keys, never the legacy narrow-key gate. Do not build its expensive
+            # inventory in prepare or claim its extended display lifetime: publish the ordinary exact copy.
             # Inner caches can return without emitting their clock boundaries.
             # Preserve those until consumed; replacing the list needs per-cache
             # deadline ownership, not just a successful outer projection.
@@ -738,7 +739,6 @@ def _event_refresh(events) -> float | None:
                 return min(_clock_deadlines[scope], default=None)
             finally:
                 _holder_ctx.deadlines = None
-                _holder_ctx.active = False
                 _ksa._revalidate.force_read.scope = None
                 _ksa._revalidate.force_read.parts = None
                 _ksa._annotate_refresh_lock.release()
diff --git a/tests/hermes_cli/test_annotation_native_prepare.py b/tests/hermes_cli/test_annotation_native_prepare.py
new file mode 100644
index 0000000000..6cb14ac1e4
--- /dev/null
+++ b/tests/hermes_cli/test_annotation_native_prepare.py
@@ -0,0 +1,80 @@
+"""Native event refresh does not build an unused legacy narrow certificate."""
+import contextvars
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_annotation_disk as disk
+from hermes_cli import kanban_annotation_host as host
+from hermes_cli import kanban_session_activity as ksa
+from tests.hermes_cli import test_kanban_annotation_host as helpers
+
+world = helpers.world
+SCOPE = helpers.SCOPE
+
+
+def native(monkeypatch):
+    monkeypatch.setattr(host, '_known', {SCOPE: contextvars.copy_context()})
+    monkeypatch.setattr(host, '_discovery_paths', lambda: (set(), set()))
+    monkeypatch.setattr(host, 'SETTLE_S', ())
+    disk.touch_demand(SCOPE)
+    return host._event_refresh(SimpleNamespace(replace=lambda *a, **kw: None, control_only=False))
+
+
+def header():
+    out = {}
+    copy = disk.load_host(SCOPE, shared=True, header_out=out)
+    assert copy is not None
+    return copy, out
+
+
+def test_native_reads_and_committed_changes_never_probe_narrow(world, monkeypatch):
+    monkeypatch.setattr(host, '_narrow_now', lambda *a: pytest.fail('native performed legacy inventory work'))
+    native(monkeypatch)
+    first, meta = header()
+    assert first[2][0]['s1'] == 2
+    assert meta.get('narrow_key') is None
+    assert meta.get('watch_sig') is None
+    world['conn'].execute("UPDATE tasks SET status='done' WHERE id='t1'")
+    helpers._advance(world, 1)
+    native(monkeypatch)
+    second, _ = header()
+    assert second[2][0]['s1'] == 1
+    assert second[0] != first[0]
+    helpers._other_process()
+    assert host.adopt(SCOPE) == second[2]
+
+
+def test_native_payload_matches_legacy_publication(world, monkeypatch):
+    monkeypatch.setattr(host, '_narrow_now', lambda *a: 'legacy-key')
+    host.demand(SCOPE)
+    assert host._holder_refresh_scope(SCOPE)
+    before, before_header = header()
+    assert before_header['narrow_key'] == 'legacy-key'
+    native(monkeypatch)
+    after, after_header = header()
+    assert after == before
+    assert after_header.get('narrow_key') is None
+    assert after_header.get('watch_sig') is None
+    assert after_header['read_at'] == before_header['read_at']
+
+
+def test_native_copy_does_not_gain_quiet_watch_extension(world, monkeypatch):
+    native(monkeypatch)
+    helpers._advance(world, host.DISPLAY_MAX_AGE_S)
+    helpers._other_process()
+    assert host.adopt_display(SCOPE) is not None
+    helpers._advance(world, 0.01)
+    helpers._other_process()
+    assert host.adopt_display(SCOPE) is None
+
+
+def test_legacy_holder_keeps_narrow_after_native_read(world, monkeypatch):
+    calls = []
+    monkeypatch.setattr(host, '_narrow_now', lambda *a: calls.append(a) or 'legacy-key')
+    native(monkeypatch)
+    assert calls == []
+    host.kick(SCOPE)
+    assert host._holder_refresh_scope(SCOPE)
+    assert len(calls) == 1
+    assert header()[1]['narrow_key'] == 'legacy-key'
