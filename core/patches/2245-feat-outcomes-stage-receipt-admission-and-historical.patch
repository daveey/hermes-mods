+    if next_state != "decision":
+        assert out["kind"] != "done"
+    assert out.get("completion_receipt") == value
+    assert out["completion_receipt_source"]["declared_at"] == declared["at"]
+    assert so.get_outcome("chat", db=db)["completion_receipt"] == value
