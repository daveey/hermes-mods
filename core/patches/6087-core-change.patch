diff --git a/tests/hermes_cli/test_sessions_early_boot.py b/tests/hermes_cli/test_sessions_early_boot.py
new file mode 100644
index 00000000000..ced243488ca
--- /dev/null
+++ b/tests/hermes_cli/test_sessions_early_boot.py
@@ -0,0 +1,97 @@
+"""Early capture keeps one owner through import failures and app adoption."""
+from types import SimpleNamespace
+import signal
+
+from fastapi import FastAPI
+import pytest
+
+from hermes_cli import sessions_early_boot as early
+from hermes_cli import sessions_native_startup as native
+
+
+@pytest.fixture
+def boot(monkeypatch):
+    from hermes_cli import isolated_scope, process_identity, proof_home, update_proxy_env
+    from hermes_cli.web_routers import profiles
+    calls = []
+    runtime = SimpleNamespace(start_background=lambda: calls.append('start'),
+                              close=lambda: calls.append('close'))
+    monkeypatch.setenv('HERMES_FACTS_SESSIONS', '1')
+    monkeypatch.setattr(early.sys, 'platform', 'linux')
+    monkeypatch.setattr(proof_home, 'assert_backend_home', lambda **kw: calls.append('preflight'))
+    monkeypatch.setattr(update_proxy_env, 'restore_user_proxy_env', lambda: calls.append('proxy'))
+    monkeypatch.setattr(process_identity, 'is_desktop_owned_backend', lambda: False)
+    monkeypatch.setattr(isolated_scope, 'record_launch_scope', lambda **kw: calls.append(('scope', kw)))
+    monkeypatch.setattr(profiles, '_profile_targets', lambda reason: calls.append('targets') or [('default', '/unused')])
+    monkeypatch.setattr(native, 'SessionsRuntime', lambda *a: runtime)
+    return calls, runtime
+
+
+@pytest.mark.parametrize('error', [ImportError, SystemExit, OSError, KeyboardInterrupt])
+def test_pre_adoption_failures_close(boot, error):
+    calls, _ = boot
+    with pytest.raises(error):
+        with early.early_sessions(headless=True, isolated=True):
+            raise error()
+    assert calls == ['preflight', 'proxy', ('scope', {'isolated': True, 'desktop_owned': False}), 'targets', 'start', 'close']
+
+
+@pytest.mark.asyncio
+async def test_adoption_no_duplicate_start_or_close(boot):
+    calls, runtime = boot
+    app = FastAPI()
+    with early.early_sessions(headless=True, isolated=False) as owner:
+        app.state.early_sessions_owner = owner
+        async with native.lifespan(app):
+            assert app.state.sessions_facts is runtime
+            with pytest.raises(RuntimeError, match='consumed'):
+                owner.adopt()
+        assert owner.closed
+        assert app.state.sessions_facts is None
+    assert calls.count('start') == calls.count('close') == 1
+
+
+@pytest.mark.parametrize('signum', [signal.SIGTERM, signal.SIGINT])
+def test_signal_in_import_gap_drains_and_chains(boot, signum):
+    calls, _ = boot
+    original = signal.getsignal(signum)
+    def previous(sig, frame):
+        calls.append('previous')
+        raise SystemExit(123)
+    signal.signal(signum, previous)
+    try:
+        with pytest.raises(SystemExit, match='123'):
+            with early.early_sessions(headless=True, isolated=False):
+                signal.getsignal(signum)(signum, None)
+        assert calls[-2:] == ['close', 'previous']
+        assert signal.getsignal(signum) is previous
+    finally:
+        signal.signal(signum, original)
+
+
+@pytest.mark.parametrize('mode', ['legacy', 'dashboard', 'darwin'])
+def test_rollback_does_not_touch_runtime(boot, monkeypatch, mode):
+    calls, _ = boot
+    if mode == 'legacy':
+        monkeypatch.setenv('HERMES_FACTS_SESSIONS', '0')
+    if mode == 'darwin':
+        monkeypatch.setattr(early.sys, 'platform', 'darwin')  # os-marker: ok — unsupported-watch rollback only; no macOS APIs
+    with early.early_sessions(headless=mode != 'dashboard', isolated=False) as owner:
+        assert owner is None
+    assert not calls
+
+
+def test_failed_drain_retains_owner():
+    calls = []
+    def close():
+        calls.append('close')
+        if len(calls) == 1:
+            raise TimeoutError('retained')
+    owner = early.EarlySessions(SimpleNamespace(close=close))
+    with pytest.raises(TimeoutError):
+        owner.close()
+    assert not owner.closed
+    owner.close()
+    assert owner.closed
+    with pytest.raises(RuntimeError):
+        owner.adopt()
diff --git a/tests/hermes_cli/test_web_boot_services.py b/tests/hermes_cli/test_web_boot_services.py
new file mode 100644
index 00000000000..b17c788792b
--- /dev/null
+++ b/tests/hermes_cli/test_web_boot_services.py
@@ -0,0 +1,203 @@
+"""Native sessions can answer while unrelated standalone services warm."""
+import asyncio
+from contextlib import asynccontextmanager
+from types import SimpleNamespace
+
+from fastapi import FastAPI
+import httpx
+import pytest
+
+
+@pytest.mark.asyncio
+async def test_services_wait_for_listener_and_gate_unready_routes():
+    from hermes_cli.web_boot_services import BootServicesMiddleware, services_lifespan
+    app = FastAPI()
+    app.state.http_listener_ready = asyncio.Event()
+    app.state.sessions_facts = SimpleNamespace()
+    app.add_middleware(BootServicesMiddleware)
+    entered, release, closed = asyncio.Event(), asyncio.Event(), asyncio.Event()
+
+    @asynccontextmanager
+    async def services(app):
+        entered.set()
+        await release.wait()
+        try:
+            yield
+        finally:
+            closed.set()
+
+    @app.get('/api/health')
+    @app.get('/api/profiles/sessions')
+    @app.get('/api/profiles/sessions/sidebar')
+    @app.get('/api/private')
+    async def response():
+        return {'sessions': [{'id': 'real-row'}]}
+
+    async with services_lifespan(app, services):
+        assert not entered.is_set()
+        app.state.http_listener_ready.set()
+        await asyncio.wait_for(entered.wait(), 2)
+        async with httpx.AsyncClient(transport=httpx.ASGITransport(app), base_url='http://test') as client:
+            for path in ('/api/health', '/api/profiles/sessions', '/api/profiles/sessions/sidebar'):
+                assert (await client.get(path)).status_code == 200
+            pending = await client.get('/api/private')
+            assert pending.status_code == 503
+            assert pending.headers['retry-after'] == '1'
+            assert (await client.post('/api/health')).status_code == 503
+            assert (await client.get('/api/profiles/sessions/unsafe')).status_code == 503
+            release.set()
+            await asyncio.wait_for(app.state.boot_services_ready.wait(), 2)
+            assert (await client.get('/api/private')).status_code == 200
+    assert closed.is_set()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('mode', ['legacy', 'embedded', 'no_listener'])
+async def test_other_startup_modes_still_wait_for_services(mode):
+    from hermes_cli.web_boot_services import services_lifespan
+    app = FastAPI()
+    app.state.http_listener_ready = asyncio.Event() if mode != 'no_listener' else None
+    app.state.sessions_facts = None if mode == 'legacy' else SimpleNamespace()
+    app.state.gateway_runner = object() if mode == 'embedded' else None
+    entered, release = asyncio.Event(), asyncio.Event()
+
+    @asynccontextmanager
+    async def services(app):
+        entered.set()
+        await release.wait()
+        yield
+
+    context = services_lifespan(app, services)
+    opening = asyncio.create_task(context.__aenter__())
+    await asyncio.wait_for(entered.wait(), 2)
+    assert not opening.done()
+    release.set()
+    await opening
+    await context.__aexit__(None, None, None)
+
+
+@pytest.mark.asyncio
+async def test_shutdown_before_bind_does_not_start_services():
+    from hermes_cli.web_boot_services import services_lifespan
+    app = FastAPI()
+    app.state.http_listener_ready = asyncio.Event()
+    app.state.sessions_facts = SimpleNamespace()
+
+    @asynccontextmanager
+    async def services(app):
+        pytest.fail('services ran before listener')
+        yield
+
+    async with services_lifespan(app, services):
+        pass
+    assert app.state.boot_services_ready is None
+
+
+@pytest.mark.asyncio
+async def test_real_native_lifespan_keeps_health_open_while_services_warm(monkeypatch):
+    from hermes_cli import web_server, web_server_app
+    monkeypatch.setenv('HERMES_FACTS_SESSIONS', '1')
+    monkeypatch.setenv('HERMES_FACTS_LINKS', '0')
+    monkeypatch.setenv('HERMES_FACTS_ANNOTATION', '0')
+    monkeypatch.setenv('HERMES_FACTS_BOARD', '0')
+    entered, release = asyncio.Event(), asyncio.Event()
+
+    @asynccontextmanager
+    async def services(app):
+        entered.set()
+        await release.wait()
+        yield
+
+    monkeypatch.setattr(web_server_app, 'standalone_lifespan', services)
+    app = web_server.app
+    monkeypatch.setattr(app.state, 'http_listener_ready', asyncio.Event(), raising=False)
+    async with app.router.lifespan_context(app):
+        assert app.state.sessions_facts is not None
+        assert not entered.is_set()
+        app.state.http_listener_ready.set()
+        await asyncio.wait_for(entered.wait(), 2)
+        try:
+            async with httpx.AsyncClient(transport=httpx.ASGITransport(app), base_url='http://test',
+                    headers={web_server._SESSION_HEADER_NAME: web_server._SESSION_TOKEN}) as client:
+                assert (await client.get('/api/health')).status_code == 200
+                pending = await client.get('/api/models')
+                assert pending.status_code == 503
+                assert 'warming' in pending.text
+        finally:
+            release.set()
+
+
+@pytest.mark.asyncio
+async def test_failed_warmup_remains_fail_closed(caplog):
+    from hermes_cli.web_boot_services import BootServicesMiddleware, services_lifespan
+    app = FastAPI()
+    app.state.http_listener_ready = asyncio.Event()
+    app.state.sessions_facts = SimpleNamespace()
+    app.add_middleware(BootServicesMiddleware)
+    failed = asyncio.Event()
+
+    @asynccontextmanager
+    async def services(app):
+        failed.set()
+        raise RuntimeError('warmup failed')
+        yield
+
+    with pytest.raises(RuntimeError, match='warmup failed'):
+        async with services_lifespan(app, services):
+            app.state.http_listener_ready.set()
+            await failed.wait()
+            async with httpx.AsyncClient(transport=httpx.ASGITransport(app), base_url='http://test') as client:
+                assert (await client.get('/api/models')).status_code == 503
