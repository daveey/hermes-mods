From accb8e9c3414d8282fffc4f2b5f45da48bafd55b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 06:28:11 +0000
Subject: [PATCH] [daveey] Align real-ledger notification integration with
 silent deferral

---
 .../tui_gateway/test_notification_refusal_backoff.py | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/tests/tui_gateway/test_notification_refusal_backoff.py b/tests/tui_gateway/test_notification_refusal_backoff.py
index da64833120..419d9bef70 100644
--- a/tests/tui_gateway/test_notification_refusal_backoff.py
+++ b/tests/tui_gateway/test_notification_refusal_backoff.py
@@ -56,17 +56,17 @@ def test_canonical_busy_notification_backs_off_without_consuming_work(monkeypatc
         assert session["running"] is False
         assert db.get_messages_as_conversation(key) == []
         assert waits and waits[0] > 0, "refused notification must yield before its caller requeues it"
-        # Fork: the first ownership refusal of a streak shows ONE notice naming where the chat is open
-        # (test_notification_owner_refusal_backoff); it must not be a failed user turn bubble.
-        assert len(emitted) == 1, emitted
-        assert "open in another Hermes window or device" in emitted[0][2]["text"]
-        emitted.clear()
+        # Gateway-ledger contention is self-resolving, not a foreign owner requiring takeover.
+        # Exercise the real producer + SQLite admission boundary, not only direct helper calls.
+        assert not emitted, "even the first gateway-busy refusal must not show an ownership card"
+        assert session["_notif_owner_refusal_delay"] == 30.0
         assert registry.completion_queue.get_nowait() is event
         assert not completed
 
-        # Still refused (the gateway keeps owning the chat): each retry waits twice as long, to a cap.
+        # Still refused: the short producer requeue yields grow, but ownership retries stay at 30 s.
         for _ in range(8):
             dispatch()
+            assert session["_notif_owner_refusal_delay"] == 30.0
             assert registry.completion_queue.get_nowait() is event
         assert not emitted, "retries inside a refusal streak stay silent"
         assert not completed
