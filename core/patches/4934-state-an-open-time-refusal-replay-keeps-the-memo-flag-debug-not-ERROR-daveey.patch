From 94987ce57282bb7642747e724f985083f633ce07 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 00:19:34 -0800
Subject: [PATCH] state: an open-time refusal replay keeps the memo flag
 (debug, not ERROR) [daveey]

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_state_fts_online.py                |  2 +-
 tests/hermes_state/test_fts_free_gates.py | 17 +++++++++++++++++
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/hermes_state_fts_online.py b/hermes_state_fts_online.py
index 6b7a573e030b6dd496c9b6d9b844f901c76508f7..9d8c6565efef40a567f343690e5be306bef91398 100644
--- a/hermes_state_fts_online.py
+++ b/hermes_state_fts_online.py
@@ -386,7 +386,7 @@ class SessionFtsOnlineRecoveryMixin:
             plan = self._fts_plan()
         except OnlineRecoveryRefused as exc:
             if startup:
-                self._fts_tick_plan = ("refused", str(exc))
+                self._fts_tick_plan = ("refused", str(exc), bool(getattr(exc, "memoized", False)))
             log = logger.debug if getattr(exc, "memoized", False) else logger.error
             log("%s skipped: %s. `hermes sessions recover` rebuilds the store offline.", context, exc)
             self._fts_gate_outcome = "refused"
diff --git a/tests/hermes_state/test_fts_free_gates.py b/tests/hermes_state/test_fts_free_gates.py
index e49d13993e79b38a5c0a7d23b69ab782bbf21336..61a52d11ea6079be16ae28b89e6564cda0d5d495 100644
--- a/tests/hermes_state/test_fts_free_gates.py
+++ b/tests/hermes_state/test_fts_free_gates.py
@@ -785,3 +785,20 @@ def test_the_schema_memo_still_records_an_open(tmp_path):
     hermes_state_schema_memo.clear()
     SessionDB(db_path=path).close()
     assert hermes_state_schema_memo._memo, "the per-thread plan state disabled the schema-init memo"
+
+
+def test_a_remembered_refusal_replayed_at_open_stays_at_debug(store, caplog):
+    import logging
+
+    path, _before = store
+    _stale_source_view(path, claim=False)
+    _behind_v30(path)
+    hermes_state_fts_online.write_refusal_memo(path, "earlier damage")
+    caplog.set_level(logging.DEBUG, logger="hermes_state")
+    db = SessionDB(db_path=path)
+    try:
+        skipped = [r for r in caplog.records if "skipped: earlier damage" in r.getMessage()]
+        assert skipped and all(r.levelno == logging.DEBUG for r in skipped)
+    finally:
+        hermes_state_fts_online.write_refusal_memo(path, None)
+        db.close()
-- 
