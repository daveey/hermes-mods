Subject: [PATCH] fix(kanban): isolate retained worker handles between tests
 [daveey] (#156)

---
 tests/hermes_cli/conftest.py                  | 13 ++++++
 .../test_kanban_worker_exit_decode.py         | 46 +++++++++++++++++++
 2 files changed, 59 insertions(+)

diff --git a/tests/hermes_cli/conftest.py b/tests/hermes_cli/conftest.py
index 9714d8c0e2..c6ab3581f3 100644
--- a/tests/hermes_cli/conftest.py
+++ b/tests/hermes_cli/conftest.py
@@ -5,6 +5,19 @@ from __future__ import annotations
 import pytest
 
 
+@pytest.fixture(autouse=True)
+def _isolate_kanban_worker_process_registries(monkeypatch):
+    """Spawn doubles and exit classifications belong to one test, not the next tick's test.
+
+    Restoring Popen alone leaves its fake handles parked in the dispatcher's registries.
+    Use fresh dictionaries rather than clearing shared ones so teardown restores their owner.
+    """
+    from hermes_cli import kanban_db_dispatch
+
+    monkeypatch.setattr(kanban_db_dispatch, "_live_worker_procs", {})
+    monkeypatch.setattr(kanban_db_dispatch, "_recent_worker_exits", {})
+
+
 @pytest.fixture
 def all_assignees_spawnable(monkeypatch):
     """Pretend every assignee maps to a real Hermes profile.
diff --git a/tests/hermes_cli/test_kanban_worker_exit_decode.py b/tests/hermes_cli/test_kanban_worker_exit_decode.py
index 9b07bbc8fa..0880b50a73 100644
--- a/tests/hermes_cli/test_kanban_worker_exit_decode.py
+++ b/tests/hermes_cli/test_kanban_worker_exit_decode.py
@@ -26,6 +26,52 @@ def _spawn_exit(code: int) -> subprocess.Popen:
 
 
 
+@pytest.mark.parametrize("code", [0, 7, kb.KANBAN_RATE_LIMIT_EXIT_CODE])
+def test_reaper_retains_running_worker_and_records_exit_once(code):
+    """The owned Popen survives live ticks, then publishes its exit exactly once."""
+    proc = subprocess.Popen(
+        [sys.executable, "-c", "import sys; sys.stdin.read(); raise SystemExit(int(sys.argv[1]))", str(code)],
+        stdin=subprocess.PIPE,
+    )
+    try:
+        kbd._live_worker_procs[proc.pid] = proc
+        assert kbd.reap_worker_zombies() == []
+        assert kbd._live_worker_procs[proc.pid] is proc
+        assert kbd._classify_worker_exit(proc.pid) == ("unknown", None)
+
+        proc.communicate(timeout=10)
+        assert kbd.reap_worker_zombies() == [proc.pid]
+        assert proc.pid not in kbd._live_worker_procs
+        expected = "clean_exit" if code == 0 else (
+            "rate_limited" if code == kb.KANBAN_RATE_LIMIT_EXIT_CODE else "nonzero_exit")
+        assert kbd._classify_worker_exit(proc.pid) == (expected, code)
+        recorded = kbd._recent_worker_exits[proc.pid]
+        assert kbd.reap_worker_zombies() == []
+        assert kbd._recent_worker_exits[proc.pid] == recorded
+    finally:
+        if proc.poll() is None:
+            proc.kill()
+        proc.communicate(timeout=10)
+
+
+@pytest.mark.platforms("posix")
+def test_reaper_records_signaled_worker():
+    import signal
+
+    proc = subprocess.Popen([sys.executable, "-c", "import sys; sys.stdin.read()"], stdin=subprocess.PIPE)
+    try:
+        kbd._live_worker_procs[proc.pid] = proc
+        proc.terminate()
+        proc.communicate(timeout=10)
+        assert kbd.reap_worker_zombies() == [proc.pid]
+        assert kbd._classify_worker_exit(proc.pid) == ("signaled", signal.SIGTERM)
+        assert proc.pid not in kbd._live_worker_procs
+    finally:
+        if proc.poll() is None:
+            proc.kill()
+        proc.communicate(timeout=10)
+
+
