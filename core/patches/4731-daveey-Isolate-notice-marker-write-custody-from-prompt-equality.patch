From 2aea17c037cf4efc2c0b034294a7640808cb9b20 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:29:26 +0000
Subject: [PATCH] [daveey] Isolate notice marker write custody from prompt
 equality

A failed marker write with different stale text was rejected by the separate
full-prompt guard, masking deletion of the successful-write predicate.
Use identical stale text so the existing regression kills that mutant.

Proof: canonical 11-test baseline passed; deleting the successful-write
predicate failed the matching-stale-text control. Full-prompt, notice-kind,
and broad eligibility mutants also failed expected assertions.
---
 tests/tui_gateway/test_update_pause_first_request.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_update_pause_first_request.py b/tests/tui_gateway/test_update_pause_first_request.py
index a0b6916523205c308c0398e847fccd76f534084a..01a5b3bf95ecf062c7f5d1caaca47fb77744c7cc 100644
--- a/tests/tui_gateway/test_update_pause_first_request.py
+++ b/tests/tui_gateway/test_update_pause_first_request.py
@@ -60,7 +60,8 @@ def test_a_notice_with_its_own_durable_prompt_may_yield(home):
 def test_a_notice_without_a_successful_marker_write_cannot_yield(home, monkeypatch, stale):
     from tui_gateway.turn_marker import record_turn_start
     if stale:
-        assert record_turn_start(home, "session-key", "an earlier notice")
+        # Same text isolates write custody from the independent full-prompt equality guard.
+        assert record_turn_start(home, "session-key", "go")
     monkeypatch.setattr(server, "record_turn_start", lambda *a, **k: False)
     seen, _ = _submit(home, display_kind="kanban_notice")
     assert seen == [(False, True)]
-- 
