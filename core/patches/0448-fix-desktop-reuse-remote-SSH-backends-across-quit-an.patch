 function buildOwnedStaleTerminationCommand(lock, ownershipId) {
   const pid = Number(lock.pid)
   // expandRemotePath() output is already a shell-quoted fragment; embed it
@@ -1596,6 +1655,8 @@ async function connect(deps) {
