             _explain_red(repo, cand, main, gh_repo, request, gh)
diff --git a/scripts/ci/upstream_sync_superseded.py b/scripts/ci/upstream_sync_superseded.py
index 86df3362a70..6290daa2d34 100644
--- a/scripts/ci/upstream_sync_superseded.py
+++ b/scripts/ci/upstream_sync_superseded.py
@@ -1,4 +1,4 @@
-"""Close open sync PRs that a landed sync made redundant (scripts/ci/upstream_sync.py housekeeping).
+"""Clean superseded sync PRs and orphan staging refs (upstream_sync.py housekeeping).
 
 An open PR main <- sync/upstream-<X> from this repo is superseded once a freshly fetched origin/main
 contains every parent of X (X is a merge). This is the gate's supersession policy, not tree equality.
@@ -6,6 +6,8 @@ Such a PR is
 commented (naming the main sha that holds the parents), closed, and its branch deleted only if it
 still points at X. Anything else (forks, other branches, single-parent heads, a parent main lacks,
 a moved branch) stays open. Every fault is printed and skipped: this never changes the gate's verdict.
+Orphan sync refs need no open PR (on any base) and all head parents on main. Delete with a lease
+on the listed SHA; exclude this invocation's staged/landing candidates and refs handled as PRs.
 """
 from __future__ import annotations
 
@@ -66,7 +68,45 @@ def _close(repo, pr, parents, gh_repo, main, gh, run, env) -> bool:
     return True
 
 
-def close_superseded(repo, gh_repo, request, gh, *, run, env, prefix) -> None:
+def _delete_orphans(repo, gh_repo, request, main, *, run, env, prefix, protected, excluded):
+    # Any open PR, including one targeting a release branch, vetoes orphan cleanup.
+    pages = request(f"repos/{gh_repo}/pulls?state=open&per_page=100")
+    open_refs = {str((pr.get("head") or {}).get("ref") or "")
+                 for page in pages for pr in page if isinstance(pr, dict)}
+    open_refs.update(excluded)  # Do not retry a failed PR deletion against a newly moved head.
+    open_refs.update(prefix + sha for sha in protected)  # Protect the ref even if its head moved before listing.
+    listed = run(repo, "ls-remote", "--heads", "origin", f"refs/heads/{prefix}*")
+    if listed.returncode:
+        raise RuntimeError(f"could not list origin sync branches: {listed.stderr}")
+    deleted = failed = checked = 0
+    for line in listed.stdout.splitlines():
+        sha, ref = line.split()
+        if not SHA.fullmatch(sha) or not ref.startswith(f"refs/heads/{prefix}"):
+            continue
+        if ref.removeprefix("refs/heads/") in open_refs or sha in protected:
+            continue
+        checked += 1
+        try:
+            if run(repo, "cat-file", "-e", f"{sha}^{{commit}}").returncode:
+                run(repo, "fetch", "-q", "origin", ref)
+            ancestry = run(repo, "rev-list", "--parents", "-n1", sha)
+            if ancestry.returncode:
+                raise RuntimeError(f"could not read listed head {sha}: {ancestry.stderr}")
+            parents = ancestry.stdout.split()[1:]
+            if not parents or any(run(repo, "merge-base", "--is-ancestor", p, main).returncode for p in parents):
+                continue
+            result = run(repo, "push", "-q", f"--force-with-lease={ref}:{sha}", "origin", f":{ref}", env=env)
+            if result.returncode:
+                raise RuntimeError((result.stderr or result.stdout).strip()[-300:])
+            deleted += 1
+            print(f"DELETED superseded sync branch {ref} at {sha}: main {main} contains every parent")
+        except Exception as exc:  # health: allow BLE001 -- one branch cannot stop housekeeping or change the verdict
+            failed += 1
+            print(f"  superseded sync branch {ref} at {sha}: branch kept: {exc}")
+    print(f"superseded sync branches: {deleted} deleted, {failed} failed ({checked} orphan(s) checked)")
+
+
+def close_superseded(repo, gh_repo, request, gh, *, run, env, prefix, protected=()) -> None:
     try:
         pulls = _open_sync_prs(gh_repo, request, prefix)
     except Exception as exc:  # health: allow BLE001 -- housekeeping only: any fault is printed, the gate goes on
@@ -80,6 +120,8 @@ def close_superseded(repo, gh_repo, request, gh, *, run, env, prefix) -> None:
     failed = 0
     for pr in pulls:
         try:
+            if (pr.get("head") or {}).get("sha") in protected:
+                continue
             why, parents = _kept_because(repo, pr, gh_repo, main, run, prefix)
             if why:
                 print(f"  sync PR #{pr.get('number')} stays open: {why}")
@@ -95,3 +137,5 @@ def close_superseded(repo, gh_repo, request, gh, *, run, env, prefix) -> None:
         print(f"superseded sync PRs: cleanup incomplete ({closed} closed, {failed} failed)")
     elif not closed:
         print(f"superseded sync PRs: none superseded ({len(pulls)} open sync PR(s) checked against main {main[:10]})")
+    _delete_orphans(repo, gh_repo, request, main, run=run, env=env, prefix=prefix, protected=protected,
+                    excluded={str((pr.get("head") or {}).get("ref") or "") for pr in pulls})
diff --git a/tests/scripts/ci/test_upstream_sync_orphans.py b/tests/scripts/ci/test_upstream_sync_orphans.py
new file mode 100644
index 00000000000..c540fb32d08
--- /dev/null
+++ b/tests/scripts/ci/test_upstream_sync_orphans.py
@@ -0,0 +1,137 @@
+"""Real origin refs exercise orphan cleanup, leases and per-item fault isolation."""
+import pytest
+
+from scripts.ci import upstream_sync as sync
+from tests.scripts.ci.test_upstream_sync import FakeActions, commit, gate, git, make_world, merge_upstream, upstream_commit
+from tests.scripts.ci.test_upstream_sync_superseded import (
+    assert_closed, branch, host, landed_elsewhere, open_pr, other_merge,
+)
+
+
+@pytest.fixture
+def world(tmp_path):
+    return make_world(tmp_path)
+
+
+def orphan(root, sha):
+    ref = sync.BRANCH_PREFIX + sha
+    git(host(root), "push", "-q", "origin", f"{sha}:refs/heads/{ref}")
+    return ref
+
+
+def test_orphan_deleted_without_pr(world, capsys):
+    root, checkout, main0, up, actions = landed_elsewhere(world)
+    sha = other_merge(root, main0, up, "abandoned staging")
+    ref = orphan(root, sha)
+    assert gate(checkout, None, actions) == sync.NOT_YET
+    assert not branch(root, ref)
+    out = capsys.readouterr().out
+    assert f"DELETED superseded sync branch refs/heads/{ref} at {sha}" in out
+    assert "superseded sync branches: 1 deleted, 0 failed" in out
+
+
+def test_orphan_missing_parent_kept(world):
+    root, checkout, main0, up, actions = landed_elsewhere(world)
+    clone = host(root)
+    git(clone, "checkout", "-q", "--detach", main0)
+    fork = commit(clone, {"fork.txt": "unlanded"}, "fork")
+    sha = other_merge(root, fork, up, "missing fork parent")
+    ref = orphan(root, sha)
+    assert gate(checkout, None, actions) == sync.NOT_YET
+    assert branch(root, ref) == sha
+
+
+@pytest.mark.parametrize("move_candidate", [False, True])
+def test_staged_candidate_kept_when_main_moves_before_cleanup(world, move_candidate):
+    root, checkout = world
+    up = upstream_commit(root, {"u.txt": "u"}, "upstream")
+    main0 = git(checkout, "rev-parse", "HEAD")
+    head = merge_upstream(checkout)
+    actions = FakeActions(root / "origin.git", root)
+    request = actions.request
+
+    def landed_before_cleanup(endpoint):
+        if "/pulls?" in endpoint:
+            twin = other_merge(root, main0, up, "concurrent landed twin")
+            git(host(root), "push", "-q", "origin", f"{twin}:refs/heads/main")
+            if move_candidate:
+                git(host(root), "push", "-q", "-f", "origin", f"{twin}:refs/heads/{sync.BRANCH_PREFIX}{head}")
+        return request(endpoint)
+
+    assert sync.advance(checkout, head, gh_repo="example/fork", request=landed_before_cleanup,
+                        gh=actions.gh) == sync.NOT_YET
+    expected = git(root / "origin.git", "rev-parse", "main") if move_candidate else head
+    assert branch(root, sync.BRANCH_PREFIX + head) == expected
+
+
+def test_orphan_moved_after_listing_lease_refused_and_continues(world, monkeypatch, capsys):
+    root, checkout, main0, up, actions = landed_elsewhere(world)
+    heads = sorted(other_merge(root, main0, up, name) for name in ("first", "second"))
+    refs = [orphan(root, sha) for sha in heads]
+    for ref in refs:
+        git(checkout, "fetch", "-q", "origin", ref)
+    original = sync._run
+    raced = []
+
+    def run(repo, *args, **kwargs):
+        result = original(repo, *args, **kwargs)
+        if args[:2] == ("ls-remote", "--heads"):
+            git(host(root), "push", "-q", "-f", "origin", f"{main0}:refs/heads/{refs[0]}")
+            raced.append(True)
+        return result
+
+    monkeypatch.setattr(sync, "_run", run)
+    assert gate(checkout, None, actions) == sync.NOT_YET
+    assert raced and branch(root, refs[0]) == main0
+    assert not branch(root, refs[1])
+    out = capsys.readouterr().out
+    assert "branch kept" in out and "stale info" in out
+    assert "superseded sync branches: 1 deleted, 1 failed" in out
+
+
+@pytest.mark.parametrize("failure", ["exception", "nonzero"])
+def test_first_pr_comment_failure_does_not_stop_second(world, capsys, failure):
+    root, checkout, main0, up, actions = landed_elsewhere(world)
+    first, second = [open_pr(root, actions, other_merge(root, main0, up, name)) for name in ("first", "second")]
+    gh = actions.gh
+
+    def comment_fails(*args, **kwargs):
+        if args[:3] == ("pr", "comment", str(first["number"])):
+            if failure == "exception":
+                raise OSError("first comment transport failed")
+            import subprocess
+            return subprocess.CompletedProcess(args, 1, "", "first comment transport failed")
+        return gh(*args, **kwargs)
+
+    assert sync.advance(checkout, None, gh_repo="example/fork", request=actions.request,
+                        gh=comment_fails) == sync.NOT_YET
+    assert first["state"] == "open" and branch(root, first["head"]["ref"])
+    assert_closed(root, second)
+    assert "first comment transport failed" in capsys.readouterr().out
+
+
+def test_landing_candidate_kept_after_create_error_and_concurrent_landing(world):
+    root, checkout = world
+    up = upstream_commit(root, {"u.txt": "u"}, "upstream")
+    main0 = git(checkout, "rev-parse", "HEAD")
+    head = merge_upstream(checkout)
+    actions = FakeActions(root / "origin.git", root)
+    assert gate(checkout, head, actions) == sync.NOT_YET
+    actions.ci()
+
+    def create_fails(*args, **kwargs):
+        assert args[:2] == ("pr", "create")
+        twin = other_merge(root, main0, up, "concurrent landed twin")
+        git(host(root), "push", "-q", "origin", f"{twin}:refs/heads/main")
+        raise OSError("create transport failed")
+
+    assert sync.advance(checkout, None, gh_repo="example/fork", request=actions.request,
+                        gh=create_fails) == sync.REFUSED
+    assert branch(root, sync.BRANCH_PREFIX + head) == head
+
+
+def test_open_release_pr_is_not_an_orphan(world):
+    root, checkout, main0, up, actions = landed_elsewhere(world)
+    pr = open_pr(root, actions, other_merge(root, main0, up, "release sync"), base="release")
+    assert gate(checkout, None, actions) == sync.NOT_YET
+    assert pr["state"] == "open" and branch(root, pr["head"]["ref"])
