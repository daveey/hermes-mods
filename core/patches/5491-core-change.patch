new file mode 100644
index 0000000000..a1507e18e8
--- /dev/null
+++ b/docs/designs/kanban-capsule-contract-v2.md
@@ -0,0 +1,56 @@
+# Kanban capsule contract v2
+
+`kanban-capsule-contract-v2` is an additive behavioral compatibility contract for
+capsule-required Kanban submission across core revisions. It is not a general
+permission grant, a full loaded-code digest or a sandbox against same-uid attackers.
+
+## Admission and launch
+
+The submitter still requires a known full commit identity and transport-v1. A
+same-revision owner retains the legacy path. Different revisions additionally
+require v2. No caller chooses a child core or interpreter.
+
+The ready descriptor names the implemented ABI. Every control-socket identify
+filters v2 against the bootstrap-installed integrity ledger and strict disk
+identity: matching resolved root, matching boot commit, supported owner launch
+route, no unfiltered pending/unknown provenance, and clean unchanged Git state
+before and after ledger inventory. No ledger is installed late. Dirty or unknown
+boot identity is sticky; an update withdraws compatibility until a clean restart.
+Ordinary gateway operations and transport-v1 are not withdrawn by this check.
+
+Before scope resolution or single-use rendezvous consumption, placement repeats
+strict identity checks. Capsule workers launch through the fixed bootstrap-first
+managed-worker template with the owner's executable and core. Ordinary workers
+retain the previous bare module command. The owner appends a private v2 SHA argv
+expectation alongside the observation FD. Old children reject the extra argv.
+The new child requires its own installed ledger and the exact managed-worker
+route before hello, then repeats checks before execution, observation, after
+checkpoint recovery, before construction, before ready and before turns. An
+installed FD with lost expectation fails closed. Startup failures revoke binding
+and close session/RPC resources; consumed rendezvous cannot be reused.
+
+These checks are uncached. A measured clean disk scan alone is not a bound on
+whole identify latency or ledger inventory. Unsupported bootstrap routes do not
+perform the strict capsule boot scan.
+
+## Frozen ABI and evidence limits
+
+Golden vectors cover observer digest bytes/order, module/sentinel interfaces,
+claim and registration/reply fields, observer line, capsule requirement derivation,
+start identity/type/workspace validation and private consumed-marker mode. The
+existing claim/run, peer credentials, observer verification and scope placement
+contracts remain authoritative. Changing their meaning requires deliberate ABI
+migration, not silently reusing v2.
+
+The composed no-model fixture drives a real cross-SHA submitter WebSocket RPC
+through owner placement and authenticated rendezvous into an unmodified native
+managed main/execute, real claim binding and observation. Its discovery/ticket,
+owner handler/adoption reply, owner installed-ledger observation and post-bind
+checkpoint effect are explicitly scoped fixture seams. The verified observer is
+a stand-in, not an application's private observer. Separate tests freeze a real
+pre-v2 worker entrypoint, test native startup update refusals, and drive prehello
+loss through dispatcher crash disposition. These do not establish a historical
+full-core matrix, private app lifecycle, successful model completion, systemd
+confinement or app deployment readiness. A pinned application must separately
+review its ownership port, observer/scope argv, dependency environment, historical
+workflow preservation and owner-controlled activation against its deployed base.
diff --git a/gateway/capsule_contract.py b/gateway/capsule_contract.py
new file mode 100644
index 0000000000..e3dbf154fc
--- /dev/null
+++ b/gateway/capsule_contract.py
@@ -0,0 +1,99 @@
+"""Strict, dynamically checked availability of the cross-revision capsule ABI."""
+from pathlib import Path
+
+from hermes_cli.kanban_capsule_owner import CONTRACT_CAPABILITY
+from hermes_cli._startup_fast import project_root_str
+
+CORE_ROOT = Path(project_root_str())
+
+
+def _verified_sha(*, worker=False):
+    """Require the boot-installed ledger as well as a clean, unchanged disk.
+
+    Never install a ledger here: late provenance cannot attest already loaded
+    code. Unknowns are sticky and intentionally unfiltered, including deps.
+    """
+    from hermes_cli.code_attestation import integrity_observation
+    from hermes_cli.git_fingerprint import capsule_code_sha
+    try:
+        sha = capsule_code_sha(CORE_ROOT)
+        if sha is None:
+            return None
+        observed = integrity_observation()
+        routes = ('managed-worker-stub',) if worker else (
+            'managed-stub', 'managed-stub-relaunch', 'console-main-first')
+        if (observed['core_root'] != str(CORE_ROOT.resolve())
+                or observed['boot_sha'] != sha or observed['route'] not in routes
+                or observed['unknowns']):
+            return None
+        # The inventory can itself span an update. Never cache a positive.
+        return sha if capsule_code_sha(CORE_ROOT) == sha else None
+    except (RuntimeError, OSError, KeyError, TypeError, ValueError):
+        return None
+
+
+def available_capabilities(capabilities, *, advertised_sha=None):
+    """Withdraw v2 on unknown/dirty/skewed code; never manufacture an advertisement.
+
+    Legacy transport remains unchanged. Unlike ordinary code-skew diagnostics,
+    an unresolved identity and even a restart-free revision difference refuse v2.
+    """
+    result = list(capabilities)
+    if CONTRACT_CAPABILITY in result:
+        sha = _verified_sha()
+        if sha is None or advertised_sha != sha:
+            result = [cap for cap in result if cap != CONTRACT_CAPABILITY]
+    return result
+
+
+def owner_launch_sha(required):
+    """Non-consuming capsule prelaunch identity; ordinary launches are unchanged."""
+    if not required:
+        return None
+    from hermes_state_runtime import RuntimeStoreError
+    sha = _verified_sha()
+    if sha is None:
+        raise RuntimeStoreError('capsule_owner_code_unverified')
+    return sha
+
+
+WORKER_FLAG = '--capsule-contract-v2'
+_worker_expected_sha = None
+
+
+def worker_command(policy):
+    """Owner-selected core and interpreter, never a submitter-supplied target."""
+    import sys
+    from gateway.session_kanban_capsule import check_capsule_transport
+    if not check_capsule_transport(policy):
+        return [sys.executable, '-m', 'agent.managed_worker']
+    from hermes_cli._launch_template import render
+    return [sys.executable, '-I', '-c', render(str(CORE_ROOT), 'agent.managed_worker', 'main')]
+
+
+def install_worker_contract(argv):
+    """Read only the owner's private exec argv, never policy/env/bootstrap data.
+
+    Strip the expectation before the legacy observation-fd parser. An old child
+    cannot understand this extra argv and therefore refuses instead of executing.
+    """
+    global _worker_expected_sha
+    argv = list(argv)
+    if WORKER_FLAG not in argv:
+        if argv:
+            raise RuntimeError('capsule_worker_code_unverified')
+        return argv
+    if (len(argv) != 4 or argv[0] != '--observation-fd' or argv[2] != WORKER_FLAG
+            or _worker_expected_sha is not None or not argv[3]
+            or _verified_sha(worker=True) != argv[3]):
+        raise RuntimeError('capsule_worker_code_unverified')
+    _worker_expected_sha = argv[3]
+    return argv[:2]
+
+
+def check_worker_identity():
+    """Repeat at execution entry and before observation/model/tool initialization."""
+    from agent.observation_bind import installed_fd
+    if (_worker_expected_sha is None and installed_fd() is not None
+            or _worker_expected_sha is not None and _verified_sha(worker=True) != _worker_expected_sha):
+        raise RuntimeError('capsule_worker_code_unverified')
