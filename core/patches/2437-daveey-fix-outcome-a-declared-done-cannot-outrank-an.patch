From f729113bd1b839ea878393048e12d4e781f2fc40 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 03:21:30 +0000
Subject: [PATCH] [daveey] fix(outcome): a declared done cannot outrank an
 unread Kanban card

Review t_01a1cd98d7bd7d72 at 6498bd6d: a still-valid declared done returned before the card_read_failed
guard, so a board-busy read could still paint a chat done. A counted open card already outranks a declared
done (waits are checked first), so an unread card must too. Declared waiting is still honoured; the
declared done is carried as 'declared' on the unresolved outcome. Proof: the declared case of
test_busy_card_read_preserves_authority_but_not_silent_completion fails on 6498bd6d and passes here
(103/103 in the file).
---
 hermes_state_outcome.py                    | 10 ++++++----
 tests/hermes_state/test_session_outcome.py | 11 +++++++++--
 2 files changed, 15 insertions(+), 6 deletions(-)

diff --git a/hermes_state_outcome.py b/hermes_state_outcome.py
index 4039ff4198..baa3168f68 100644
--- a/hermes_state_outcome.py
+++ b/hermes_state_outcome.py
@@ -607,14 +607,16 @@ def _derive_current(db: Any, sid: str, *, ignore_live_turn: bool = False,
         return _outcome("waiting", now, on=waits, **carry)
     crons = _guarded("cron", sid, lambda: _cron_items(_lineage_ids(db, sid)), [])
     named = {"crons": crons} if crons else {}
-    if holds and declared.get("kind") in ("done", "waiting"):
-        return {**{k: v for k, v in declared.items() if k != "crons"},
-                **(named if declared.get("kind") == "done" else {})}
+    if holds and declared and declared.get("kind") == "waiting":
+        return {k: v for k, v in declared.items() if k != "crons"}
     if card_read_failed:
-        # Unknown card state is not evidence of completion, regardless of the reply.
+        # Unknown card state is not evidence of completion, regardless of the reply or a declared
+        # done: a counted open card outranks a declared done (``waits`` above), so an unread one must too.
         if stored and stored.get("kind") in ("waiting", "decision"):
             return stored
         return _outcome("unresolved", now, reason="card_read_failed", **carry)
+    if holds and declared and declared.get("kind") == "done":
+        return {**{k: v for k, v in declared.items() if k != "crons"}, **named}
     if not tail:
         return _outcome("unresolved", now, reason="empty", **carry)
     reason = _tail_reason(tail)
diff --git a/tests/hermes_state/test_session_outcome.py b/tests/hermes_state/test_session_outcome.py
index 550c63fb88..9ef51be26a 100644
--- a/tests/hermes_state/test_session_outcome.py
+++ b/tests/hermes_state/test_session_outcome.py
@@ -711,7 +711,7 @@ def test_human_decision_card_still_outranks_the_reply(db, board):
     assert so.refresh_outcome("chat", "turn_end", db=db)["kind"] == "decision"
 
 
-@pytest.mark.parametrize("precedence", ["declared", "provider", "silent_cron"])
+@pytest.mark.parametrize("precedence", ["declared", "declared_waiting", "provider", "silent_cron"])
 def test_busy_card_read_preserves_authority_but_not_silent_completion(db, monkeypatch, precedence):
     from hermes_cli.kanban_generation import BoardLifecycleBusy
 
@@ -719,6 +719,8 @@ def test_busy_card_read_preserves_authority_but_not_silent_completion(db, monkey
     declared = None
     if precedence == "declared":
         declared = so.declare_outcome("chat", {"kind": "done", "summary": SUMMARY}, db=db)
+    elif precedence == "declared_waiting":
+        declared = so.declare_outcome("chat", {"kind": "waiting", "on": [{"kind": "card", "id": "t_x"}]}, db=db)
     elif precedence == "provider":
         so.register_outcome_provider("approval", lambda sid: {
             "decision_items": [{"id": "approval", "question": "Deploy?"}]})
@@ -732,7 +734,12 @@ def test_busy_card_read_preserves_authority_but_not_silent_completion(db, monkey
     monkeypatch.setattr(ksa, "session_tasks", busy)
     out = so.refresh_outcome("chat", "manual", db=db)
     if precedence == "declared":
-        assert out == declared
+        # A declared done cannot outrank an unread card any more than a counted open one.
+        assert out["kind"] != "done"
+        assert (out["kind"], out["reason"]) == ("unresolved", "card_read_failed")
+        assert out["declared"]["kind"] == "done"
+    elif precedence == "declared_waiting":
+        assert out["kind"] == "waiting" and out["on"] == (declared or {})["on"]
     elif precedence == "provider":
         assert out["kind"] == "decision" and out["items"][0]["id"] == "approval"
     else:
-- 
