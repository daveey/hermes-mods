diff --git a/scripts/ci/state_contract_dispatch.sh b/scripts/ci/state_contract_dispatch.sh
new file mode 100755
index 0000000000..9ea9c36716
--- /dev/null
+++ b/scripts/ci/state_contract_dispatch.sh
@@ -0,0 +1,81 @@
+#!/usr/bin/env bash
+# Selects and runs the `gh workflow run` dispatches for .github/workflows/state-contract-dispatch.yml.
+#
+# Inputs (env): GITHUB_EVENT_NAME, GITHUB_REPOSITORY, GITHUB_SHA, GITHUB_STEP_SUMMARY (optional),
+# SCHEDULE_CRON (github.event.schedule; only set on schedule events), GH_TOKEN (for gh).
+#
+#   push                     core main moved a file state's tests read:
+#                              bb-dev-tests.yml (unchanged) and
+#                              hermes-sync-tests.yml -f core_ref=$GITHUB_SHA (mods stays at state's pin).
+#   schedule '17 11 * * *'   daily backstop, unchanged: bb-dev-tests.yml and hermes-sync-tests.yml, no inputs.
+#   anything else            hourly schedule or workflow_dispatch = the upstream canary: hermes-sync-tests.yml
+#                              -f mods_ref=<mods main HEAD> -f core_ref=<core main HEAD>, no skip.
+#
+# `gh` resolves from PATH so tests can put a fake first.
+set -euo pipefail
+
+repo="${GITHUB_REPOSITORY:?}"
+event="${GITHUB_EVENT_NAME:?}"
+sha="${GITHUB_SHA:?}"
+cron="${SCHEDULE_CRON:-}"
+summary="${GITHUB_STEP_SUMMARY:-/dev/null}"
+mods_repo="${MODS_REPOSITORY:-daveey/hermes-mods}"
+daily_cron='17 11 * * *'
+
+note() { echo "$*" | tee -a "$summary"; }
+
+dispatch() { # dispatch <workflow> [-f k=v ...]
+  local wf="$1"; shift
+  gh workflow run "$wf" --repo "$repo" --ref state "$@"
+}
+
+state_sha=$(gh api "repos/${repo}/commits/state" --jq .sha)
+
+if [ "$event" = push ] || { [ "$event" = schedule ] && [ "$cron" = "$daily_cron" ]; }; then
+  for wf in bb-dev-tests.yml hermes-sync-tests.yml; do
+    args=()
+    if [ "$event" = push ] && [ "$wf" = hermes-sync-tests.yml ]; then
+      args=(-f "core_ref=${sha}")
+    fi
+    dispatch "$wf" ${args[@]+"${args[@]}"}
+    note "dispatched $wf on state ${state_sha} (core main ${sha}, event ${event}${args[*]:+, ${args[*]}})"
+  done
+  exit 0
+fi
+
+# Upstream canary (hourly cron or manual): test both upstream heads against state's tests.
+mods_head=$(gh api "repos/${mods_repo}/commits/main" --jq .sha)
+core_head=$(gh api "repos/${repo}/commits/main" --jq .sha)
+pins=$(gh api "repos/${repo}/contents/.github/workflows/hermes-sync-tests.yml?ref=state" --jq .content \
+  | base64 -d | grep -E '^[[:space:]]+(MODS|CORE)_FIXTURE_SHA:' | sed -E 's/^[[:space:]]+//' || true)
+
+dispatch hermes-sync-tests.yml -f "mods_ref=${mods_head}" -f "core_ref=${core_head}"
+
+# gh workflow run prints no run id: find the run by its canary title (set by state's run-name).
+title="hermes-sync-tests upstream canary mods=${mods_head} core=${core_head}"
+run_id=""
+for _ in 1 2 3 4 5 6; do
+  run_id=$(gh run list --repo "$repo" --workflow hermes-sync-tests.yml --branch state --event workflow_dispatch \
+    --limit 10 --json databaseId,displayTitle \
+    --jq "[.[] | select(.displayTitle == \"${title}\")][0].databaseId // empty" || true)
+  [ -n "$run_id" ] && break
+  sleep 5
+done
+
+if [ -n "$run_id" ]; then
+  run_text="https://github.com/${repo}/actions/runs/${run_id}"
+else
+  run_text="run not found yet; title: ${title}"
+fi
+
+{
+  echo "### Upstream canary (${event})"
+  echo "- mods main HEAD: \`${mods_head}\`"
+  echo "- core main HEAD: \`${core_head}\`"
+  echo "- state HEAD: \`${state_sha}\`"
+  echo "- state pins:"
+  echo '```'
+  echo "$pins"
+  echo '```'
+  echo "- dispatched hermes-sync-tests.yml on state: ${run_text}"
+} | tee -a "$summary"
diff --git a/tests/ci/test_state_contract_dispatch.py b/tests/ci/test_state_contract_dispatch.py
new file mode 100644
index 0000000000..0d0310173c
--- /dev/null
+++ b/tests/ci/test_state_contract_dispatch.py
@@ -0,0 +1,122 @@
+"""scripts/ci/state_contract_dispatch.sh: which dispatches state-contract-dispatch.yml makes.
+
+A fake `gh` first on PATH records every call; the script's selection logic is what is under test.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import stat
+import subprocess
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+SCRIPT = REPO_ROOT / "scripts" / "ci" / "state_contract_dispatch.sh"
+WORKFLOW = REPO_ROOT / ".github" / "workflows" / "state-contract-dispatch.yml"
+
+REPO = "example-org/hermes"
+MODS_HEAD = "a" * 40
+CORE_HEAD = "b" * 40
+STATE_HEAD = "c" * 40
+PUSH_SHA = "d" * 40
+CANARY_TITLE = f"hermes-sync-tests upstream canary mods={MODS_HEAD} core={CORE_HEAD}"
+PINS_YAML = (
+    "env:\n  MODS_FIXTURE_SHA: " + "1" * 40 + "\n  CORE_FIXTURE_SHA: " + "2" * 40 + "\n"
+)
+
+FAKE_GH = r"""#!/usr/bin/env bash
+echo "$*" >> "$FAKE_GH_LOG"
+case "$1 $2" in
+  "workflow run") exit 0 ;;
+  "run list") echo 987654321; exit 0 ;;
+esac
+if [ "$1" = api ]; then
+  case "$2" in
+    repos/*/commits/state) echo __STATE__ ;;
+    repos/daveey/hermes-mods/commits/main) echo __MODS__ ;;
+    repos/*/commits/main) echo __CORE__ ;;
+    repos/*/contents/.github/workflows/hermes-sync-tests.yml*) printf '%s' "$FAKE_PINS_B64" ;;
+    *) echo "unexpected api $2" >&2; exit 9 ;;
+  esac
+  exit 0
+fi
+echo "unexpected gh $*" >&2
+exit 9
+"""
+
+
+def _run(tmp_path: Path, event: str, cron: str = "") -> tuple[list[str], str]:
+    bindir = tmp_path / "bin"
+    bindir.mkdir()
+    gh = bindir / "gh"
+    gh.write_text(
+        FAKE_GH.replace("__STATE__", STATE_HEAD).replace("__MODS__", MODS_HEAD).replace("__CORE__", CORE_HEAD)
+    )
+    gh.chmod(gh.stat().st_mode | stat.S_IXUSR)
+    log = tmp_path / "gh.log"
+    summary = tmp_path / "summary.md"
+    import base64
+
+    env = {
+        "PATH": f"{bindir}:{os.environ['PATH']}",
+        "HOME": str(tmp_path),
+        "FAKE_GH_LOG": str(log),
+        "FAKE_PINS_B64": base64.b64encode(PINS_YAML.encode()).decode(),
+        "GITHUB_REPOSITORY": REPO,
+        "GITHUB_SHA": PUSH_SHA,
+        "GITHUB_EVENT_NAME": event,
+        "GITHUB_STEP_SUMMARY": str(summary),
+        "SCHEDULE_CRON": cron,
+    }
+    proc = subprocess.run(["bash", str(SCRIPT)], env=env, capture_output=True, text=True, timeout=60, check=False)
+    assert proc.returncode == 0, proc.stderr
+    calls = log.read_text().splitlines() if log.exists() else []
+    return [c for c in calls if c.startswith("workflow run")], summary.read_text() if summary.exists() else ""
+
+
+def test_push_dispatches_core_ref_only(tmp_path):
+    runs, summary = _run(tmp_path, "push")
+    assert runs == [
+        f"workflow run bb-dev-tests.yml --repo {REPO} --ref state",
+        f"workflow run hermes-sync-tests.yml --repo {REPO} --ref state -f core_ref={PUSH_SHA}",
+    ]
+    assert "mods_ref" not in " ".join(runs)
+    assert PUSH_SHA in summary
+
+
+def test_daily_schedule_is_unchanged(tmp_path):
+    runs, _ = _run(tmp_path, "schedule", "17 11 * * *")
+    assert runs == [
+        f"workflow run bb-dev-tests.yml --repo {REPO} --ref state",
+        f"workflow run hermes-sync-tests.yml --repo {REPO} --ref state",
+    ]
+
+
+def _assert_canary(runs: list[str], summary: str) -> None:
+    assert runs == [
+        f"workflow run hermes-sync-tests.yml --repo {REPO} --ref state -f mods_ref={MODS_HEAD} -f core_ref={CORE_HEAD}"
+    ]
+    assert f"mods main HEAD: `{MODS_HEAD}`" in summary
+    assert f"core main HEAD: `{CORE_HEAD}`" in summary
+    assert "MODS_FIXTURE_SHA: " + "1" * 40 in summary
+    assert "CORE_FIXTURE_SHA: " + "2" * 40 in summary
+    assert f"{REPO}/actions/runs/987654321" in summary
+
+
+def test_hourly_schedule_dispatches_both_heads(tmp_path):
+    _assert_canary(*_run(tmp_path, "schedule", "47 * * * *"))
+
+
+def test_manual_dispatch_runs_the_canary(tmp_path):
+    _assert_canary(*_run(tmp_path, "workflow_dispatch"))
+
+
+def test_workflow_wires_script_and_crons():
+    text = WORKFLOW.read_text()
+    assert "- cron: '17 11 * * *'" in text
+    assert re.search(r"- cron: '\d+ \* \* \* \*'", text), "hourly cron missing"
+    assert "scripts/ci/state_contract_dispatch.sh" in text
+    assert "SCHEDULE_CRON: ${{ github.event.schedule }}" in text
+    assert "group: state-contract-dispatch-${{ github.event_name }}" in text
+    assert "'scripts/ci/state_contract_dispatch.sh'" in text, "script change must trigger a push dispatch"
