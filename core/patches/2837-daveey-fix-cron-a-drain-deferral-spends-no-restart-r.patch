From c165810de9f757da3a2244ede86810ee7feb3ffa Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 16:14:50 +0000
Subject: [PATCH] [daveey] fix(cron): a drain deferral spends no restart rerun

defer_unadmitted re-arms a fire the draining owner never admitted through
reschedule_interrupted, which wrote the ordinary restart_rerun marker. The
first real attempt after the deferral was then taken for the rerun itself:
cut by the next instant update on hermes-hub (b5b0e485e75e) it was logged
'the interrupted attempt was itself a restart rerun' and never rerun.

Deferral markers now carry deferred=true and do not count as a rerun; a
deferred pending rerun keeps the rerun's time, so the one-rerun bound holds,
and is re-armed instead of being dropped as 'itself a restart rerun'.

t_01a1d009633f359e
---
 cron/restart_cut.py            |  6 +--
 cron/restart_rerun.py          | 32 ++++++++++----
 tests/cron/test_restart_cut.py | 79 ++++++++++++++++++++++++++++++++++
 3 files changed, 106 insertions(+), 11 deletions(-)

diff --git a/cron/restart_cut.py b/cron/restart_cut.py
index 421d117c29..bdd3dc3ede 100644
--- a/cron/restart_cut.py
+++ b/cron/restart_cut.py
@@ -37,7 +37,7 @@ def _detail(error: Any) -> str:
     return RESTART_CUT_REASON if not error or error == RESTART_CUT_REASON else f"{RESTART_CUT_REASON} ({error})"
 
 
-def _reschedule(job_id: str, execution_id: str) -> bool:
+def _reschedule(job_id: str, execution_id: str, *, deferred: bool = False) -> bool:
     from cron.executions import get_execution
     from cron.restart_rerun import reschedule_interrupted
 
@@ -45,7 +45,7 @@ def _reschedule(job_id: str, execution_id: str) -> bool:
     if record is None or record.get("job_id") != job_id:
         return False
     try:
-        return reschedule_interrupted(record, restart_cut=True)
+        return reschedule_interrupted(record, restart_cut=True, deferred=deferred)
     except Exception:  # health: allow BLE001 -- the attempt is already booked; a missed rerun is logged
         logger.warning("cron: rescheduling %s after its restart cut failed", job_id, exc_info=True)
         return False
@@ -147,7 +147,7 @@ def defer_unadmitted(job: dict[str, Any], execution_id: str, detail: str, fire_o
         _retire_journal(job_id, execution_id)
     else:
         scheduler.finish_execution(execution_id, success=False, error=note, delivery_outcome="suppressed")
-    rearmed = _reschedule(job_id, execution_id)
+    rearmed = _reschedule(job_id, execution_id, deferred=True)
     if not recovered and fire_owner:  # a gone firer's claim names a dead process: the next claim reclaims it
         _release_own_claim(job_id, fire_owner, note)
     logger.warning("Cron %s %s: %s", job_id, "deferred" if rearmed else "not re-armed", note)
diff --git a/cron/restart_rerun.py b/cron/restart_rerun.py
index 03195b7bc5..b8652cb512 100644
--- a/cron/restart_rerun.py
+++ b/cron/restart_rerun.py
@@ -45,7 +45,7 @@ def _at_or_after(value: Any, claimed: datetime) -> bool:
 
 def _skip_reason(
     job: dict[str, Any], record: dict[str, Any], claimed: datetime, now: datetime,
-    restart_cut: bool = False,
+    restart_cut: bool = False, deferred: bool = False,
 ) -> Optional[str]:
     from cron.jobs import _is_recoverable_error_job, is_job_runnable, is_terminal_job
     from cron.scheduler_ownership import _claim_owner_is_dead
@@ -55,7 +55,10 @@ def _skip_reason(
         if marker.get("execution_id") == record["id"]:
             return "already rescheduled"
         rescheduled_at = _parse(marker.get("at"))
-        if rescheduled_at is not None and claimed >= rescheduled_at:
+        # A deferral re-arms a fire that never ran (defer_unadmitted), so it spends no rerun: neither
+        # the attempt a deferral leads to nor a deferred rerun (re-armed, still the rerun) is skipped.
+        if (not deferred and not marker.get("deferred")
+                and rescheduled_at is not None and claimed >= rescheduled_at):
             # Claimed after a reschedule that no real outcome has settled: the rerun itself.
             return "the interrupted attempt was itself a restart rerun"
     # A verified restart cut (the owner's own verdict) is settled by its firer or journal recovery,
@@ -92,7 +95,18 @@ def _future_slot_pending(job: dict[str, Any], now: str) -> bool:
     return not is_terminal_job(job) and slot is not None and slot > datetime.fromisoformat(now)
 
 
-def _apply(job: dict[str, Any], record: dict[str, Any], now: str) -> None:
+def _marker(job: dict[str, Any], record: dict[str, Any], now: str, deferred: bool) -> dict[str, Any]:
+    """The loop guard written with a reschedule. A deferral marks itself ``deferred`` so it spends no
+    rerun, except when it defers a pending rerun: that keeps the rerun's time, still unsettled."""
+    if not deferred:
+        return {"execution_id": record["id"], "at": now}
+    prior = job.get(MARKER_KEY)
+    if isinstance(prior, dict) and not prior.get("deferred") and _parse(prior.get("at")) is not None:
+        return {"execution_id": record["id"], "at": prior["at"]}
+    return {"execution_id": record["id"], "at": now, "deferred": True}
+
+
+def _apply(job: dict[str, Any], record: dict[str, Any], now: str, deferred: bool = False) -> None:
     from cron import extra_fire
     from cron.jobs import _activate_job_record
 
@@ -113,7 +127,7 @@ def _apply(job: dict[str, Any], record: dict[str, Any], now: str) -> None:
         job["next_run_at"] = now
     # A fire/run claim left by the dead scheduler needs no clearing: its owner is provably dead
     # (checked above), so the next tick's claim reclaims it at once (_claim_owner_is_dead).
-    job[MARKER_KEY] = {"execution_id": record["id"], "at": now}
+    job[MARKER_KEY] = _marker(job, record, now, deferred)
 
 
 def _newest_attempt_id(job_id: str) -> Optional[str]:
@@ -125,12 +139,14 @@ def _newest_attempt_id(job_id: str) -> Optional[str]:
     return None
 
 
-def reschedule_interrupted(record: dict[str, Any], *, restart_cut: bool = False) -> bool:
+def reschedule_interrupted(record: dict[str, Any], *, restart_cut: bool = False,
+                           deferred: bool = False) -> bool:
     """Put ``record``'s job back on the schedule for now; True when it was rescheduled.
 
     ``restart_cut``: the owner itself reported that its restart cut this attempt (``RESTART_CUT_FLAG``
     on the canonical result), and the caller (the attempt's firer or its journal recovery) is the
-    one settling it, so the journal and a live claim are no reason to defer."""
+    one settling it, so the journal and a live claim are no reason to defer. ``deferred``: the
+    attempt never ran (refused while draining), so its re-arm spends no rerun (``_marker``)."""
     from cron.jobs import _MISSING, _hermes_now, _under_fire_fence, _with_job, save_jobs
 
     job_id = str(record.get("job_id") or "")
@@ -156,12 +172,12 @@ def reschedule_interrupted(record: dict[str, Any], *, restart_cut: bool = False)
     def apply(jobs, _i, job):
         _fence_reported[0] = True
         now = _hermes_now()
-        reason = _skip_reason(job, record, claimed, now, restart_cut)
+        reason = _skip_reason(job, record, claimed, now, restart_cut, deferred)
         if reason is not None:
             logger.info("cron: not rescheduling %s (execution %s) after restart interruption: %s",
                         job_id, record["id"], reason)
             return False
-        _apply(job, record, now.isoformat())
+        _apply(job, record, now.isoformat(), deferred)
         save_jobs(jobs)
         return True
 
diff --git a/tests/cron/test_restart_cut.py b/tests/cron/test_restart_cut.py
index e694ee96d8..f4fae04dd3 100644
--- a/tests/cron/test_restart_cut.py
+++ b/tests/cron/test_restart_cut.py
@@ -332,3 +332,82 @@ def test_draining_refusal_whose_absence_check_was_lost_is_deferred_by_recovery(h
     assert saved.get("last_status") is None and int(saved.get("failure_streak") or 0) == 0
     assert not scheduler_authority.journal_path(job["id"], fire).exists()
     _assert_rerun_once(job["id"], fire, natural_next=natural_next)
+
+
+def _defer_while_draining(job_id, monkeypatch, owner_ops):
+    from hermes_state_runtime import RuntimeStoreError
+
+    def refuse(_params):
+        raise RuntimeStoreError("runtime_draining")
+
+    owner_ops["submit"] = refuse
+    owner_ops["recover"] = lambda params: {"status": "missing"}
+    claimed = jobs.claim_job_for_fire(job_id, return_job=True) or \
+        jobs.claim_job_for_fire(job_id, force=True, return_job=True)
+    assert isinstance(claimed, dict)
+    scheduler.run_one_job(claimed)
+    assert "deferred" in executions.get_execution(claimed["execution_id"])["error"]
+    assert _due(job_id)
+
+
+def _cut_next_attempt(job_id, monkeypatch):
+    def run_job(job, **_kwargs):
+        job["_restart_cut"] = True
+        return (False, "", "", "interrupted")
+
+    monkeypatch.setattr(scheduler, "run_job", run_job)
+    attempt = jobs.claim_job_for_fire(job_id, return_job=True)
+    assert isinstance(attempt, dict)
+    assert scheduler.run_one_job(attempt) is True
+    return attempt["execution_id"]
+
+
+def test_first_run_after_a_deferral_cut_by_a_restart_is_still_rerun(home, monkeypatch, owner_ops):
+    """Hub live proof (b5b0e485e75e): a run-now deferred while draining, then its real attempt on the
+    new gateway cut by the next update, was logged "itself a restart rerun" and never rerun. A
+    deferral re-arms a fire that never ran, so it spends no rerun."""
+    job = jobs.create_job(prompt="probe", schedule=FAR_FUTURE, name="probe", deliver="local")
+    natural_next = job["next_run_at"]
+    _defer_while_draining(job["id"], monkeypatch, owner_ops)
+
+    cut = _cut_next_attempt(job["id"], monkeypatch)
+
+    saved = jobs.get_job(job["id"])
+    assert int(saved.get("failure_streak") or 0) == 0
+    assert executions.get_execution(cut)["delivery_outcome"] == "suppressed"
+    _assert_rerun_once(job["id"], cut, natural_next=natural_next)
+
+
+def test_rerun_after_a_deferral_cut_again_is_not_rerun(home, monkeypatch, owner_ops):
+    """The deferral spends no rerun, but the one rerun still holds: deferral -> cut -> rerun -> cut
+    waits for the schedule."""
+    job = jobs.create_job(prompt="probe", schedule=FAR_FUTURE, name="probe", deliver="local")
+    _defer_while_draining(job["id"], monkeypatch, owner_ops)
+    first_cut = _cut_next_attempt(job["id"], monkeypatch)
+    assert _due(job["id"])
+    _cut_next_attempt(job["id"], monkeypatch)
+    saved = jobs.get_job(job["id"])
+    assert saved["restart_rerun"]["execution_id"] == first_cut
+    assert not _due(job["id"]), "a rerun cut again waits for its schedule"
+
+
+def test_deferring_a_pending_rerun_keeps_it_a_rerun(home, monkeypatch, owner_ops):
+    """A rerun refused while draining is deferred, but stays the rerun: cut again, it is not rerun."""
+    job = jobs.create_job(prompt="probe", schedule=FAR_FUTURE, name="probe", deliver="local")
+
+    def run_job(job, **_kwargs):
+        job["_restart_cut"] = True
+        return (False, "", "", "interrupted")
+
+    real_run_job = scheduler.run_job
+    monkeypatch.setattr(scheduler, "run_job", run_job)
+    first = jobs.claim_job_for_fire(job["id"], force=True, return_job=True)
+    assert scheduler.run_one_job(first) is True
+    rerun_at = jobs.get_job(job["id"])["restart_rerun"]["at"]
+    monkeypatch.setattr(scheduler, "run_job", real_run_job)  # the rerun goes to the draining owner
+    _defer_while_draining(job["id"], monkeypatch, owner_ops)
+    marker = jobs.get_job(job["id"])["restart_rerun"]
+    assert marker["at"] == rerun_at and not marker.get("deferred")
+
+    _cut_next_attempt(job["id"], monkeypatch)
+    assert not _due(job["id"]), "the deferred rerun, cut again, waits for its schedule"
-- 
