     work, launch = _sections("work"), _sections("launch")
     assert "file" in work and "terminal" not in work, sorted(work)
     assert "terminal" in launch and "file" not in launch, sorted(launch)
+
+
+def test_tools_show_runs_on_the_rpc_pool():
+    """It reads the tool list, which waits out a plugin force-reload: never on the RPC reader."""
+    from tui_gateway import server
+
+    assert "tools.show" in server._LONG_HANDLERS
diff --git a/tools/registry_reload.py b/tools/registry_reload.py
index 2bebd1c232..dca6f18d4b 100644
--- a/tools/registry_reload.py
+++ b/tools/registry_reload.py
@@ -16,6 +16,7 @@ waited on. The wait is bounded: past the bound the caller proceeds on what the r
 
 from __future__ import annotations
 
+import asyncio
 import logging
 import threading
 import time
@@ -95,6 +96,18 @@ def wait_for_reload(scope: Optional[str] = None, timeout: Optional[float] = None
     return waited
 
 
+def wait_for_reload_off_loop(scope: Optional[str] = None, timeout: Optional[float] = None) -> bool:
+    """:func:`wait_for_reload` for a caller that may run on an asyncio event-loop thread (a tool-list
+    build reached from an ``async def`` handler, e.g. the gateway's ``/reload-mcp`` refresh of cached
+    agents): there it returns False at once, since blocking the loop for up to the wait bound would
+    stall every connection it serves."""
+    try:
+        asyncio.get_running_loop()
+    except RuntimeError:
+        return wait_for_reload(scope, timeout)
+    return False
+
+
 def settle_reload_since(epoch: int, scope: Optional[str] = None, timeout: Optional[float] = None) -> bool:
     """True when a pass for *scope* ran or started since *epoch* was read (after waiting it out):
     a miss observed in between is not authoritative and the caller should read again."""
diff --git a/tui_gateway/methods_tools.py b/tui_gateway/methods_tools.py
index 1fe36999a0..e794061c0b 100644
--- a/tui_gateway/methods_tools.py
+++ b/tui_gateway/methods_tools.py
@@ -1983,3 +1983,6 @@ def _(rid, params: dict) -> dict:
 def register(server) -> None:
     """Rebind this module's helpers + handlers onto ``server`` and register the handlers."""
     bind_module(globals(), server, skip=("_",))
+    # [daveey] tools.show reads the tool list, which waits out a plugin force-reload (up to
+    # tools.registry_reload.RELOAD_WAIT_SECONDS): on the pool, never the RPC reader.
+    server._LONG_HANDLERS = server._LONG_HANDLERS | {"tools.show"}
