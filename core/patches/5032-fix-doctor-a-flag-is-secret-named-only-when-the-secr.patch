From cf7b3aefda6220905cd1b1957a2d5c8ad08f4aa7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 17:13:29 -0800
Subject: [PATCH] fix(doctor): a flag is secret-named only when the secret word
 ends its name

--api-key-timeout 30 counted as a secret flag (the name contains "key"),
so with numbers masked after secret flags its value was hidden and the
identifier test failed. The secret word must now end the flag name
(--api-key, --webhook-secret, --aws-secret-access-key, --auth-token), which
also stops --token-env, --max-tokens and --password-file from matching.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_state_argv_secrets.py | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/hermes_state_argv_secrets.py b/hermes_state_argv_secrets.py
index dc82511610b..1121ed7f335 100644
--- a/hermes_state_argv_secrets.py
+++ b/hermes_state_argv_secrets.py
@@ -14,9 +14,10 @@ import re
 from collections import Counter
 
 MASK = "***"
-# A flag whose NAME says its value is a secret: --api-key, --webhook-secret, --auth, --db-password, -token ...
+# The secret word ends the name: --api-key, --webhook-secret, --aws-secret-access-key, --db-password, --auth-token;
+# not --api-key-timeout, --token-env, --max-tokens or --password-file, whose values are settings or paths.
 _SECRET_FLAG = re.compile(
-    r"^-{1,2}[\w.-]*(?:key|token|secret|passw(?:or)?d|passwd|pwd|auth|credential|cookie|bearer)[\w.-]*$",
+    r"^-{1,2}[\w.-]*?(?:key|token|secret|passw(?:or)?d|passwd|pwd|auth|credentials?|cookie|bearer)$",
     re.IGNORECASE,
 )
 # Flags that LOOK secret-named but carry public, identifying values.
