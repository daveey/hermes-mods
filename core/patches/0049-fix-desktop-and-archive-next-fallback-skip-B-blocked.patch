---
 apps/desktop/src/store/sidebar-visible-order.test.ts | 3 ++-
 apps/desktop/src/store/sidebar-visible-order.ts      | 9 ++++++---
 2 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/apps/desktop/src/store/sidebar-visible-order.test.ts b/apps/desktop/src/store/sidebar-visible-order.test.ts
index 0ac8b9f340..aa499289e7 100644
--- a/apps/desktop/src/store/sidebar-visible-order.test.ts
+++ b/apps/desktop/src/store/sidebar-visible-order.test.ts
@@ -168,7 +168,8 @@ describe('nextSidebarSessionId (⌘] / ⌘[)', () => {
     expect(toggleSessionBlocked('d')).toBe(true)
     expect(nextSidebarSessionId('a', 1, false)).toBe('e') // d is blocked (grey)
     expect(nextSidebarSessionId('e', -1, false)).toBe('a')
-    expect(nextSidebarSessionId('a', 1, true)).toBe('b') // ⇧ still steps to anything
+    expect(nextSidebarSessionId('c', 1, true)).toBe('e') // ⇧ skips it too
+    expect(nextSidebarSessionId('e', -1, true)).toBe('c')
     expect(toggleSessionBlocked('d')).toBe(false)
     expect(nextSidebarSessionId('a', 1, false)).toBe('d')
   })
diff --git a/apps/desktop/src/store/sidebar-visible-order.ts b/apps/desktop/src/store/sidebar-visible-order.ts
index 1e7af634dd..48ff68d943 100644
--- a/apps/desktop/src/store/sidebar-visible-order.ts
+++ b/apps/desktop/src/store/sidebar-visible-order.ts
@@ -136,7 +136,8 @@ export function stepSessionId(
 
 /** ⌘] / ⌘[: next session with a status stripe (green / red); null when none
  *  has one. ⇧ (`anySession`) steps to the plain neighbour. `fallbackToAny`
- *  (archive → next) takes the plain neighbour when no row has a stripe. */
+ *  (archive → next) takes the plain neighbour when no row has a stripe.
+ *  Sessions blocked with ⌘B are skipped by every variant. */
 export function nextSidebarSessionId(
   currentId: null | string,
   direction: 1 | -1,
@@ -145,11 +146,13 @@ export function nextSidebarSessionId(
 ): null | string {
   const order = sidebarSessionOrder()
 
+  const notBlocked = (id: string) => !isSessionBlocked(id)
+
   if (anySession) {
-    return stepSessionId(order, currentId, direction)
+    return stepSessionId(order, currentId, direction, notBlocked)
   }
 
   const striped = stepSessionId(order, currentId, direction, sessionHasStatusStripe)
 
-  return striped ?? (fallbackToAny ? stepSessionId(order, currentId, direction) : null)
+  return striped ?? (fallbackToAny ? stepSessionId(order, currentId, direction, notBlocked) : null)
 }
