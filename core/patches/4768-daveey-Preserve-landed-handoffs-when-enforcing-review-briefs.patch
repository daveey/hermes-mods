From 7aaba59593a6b2a8ee8907288785afa94e6c5386 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 05:45:57 +0000
Subject: [PATCH] [daveey] Preserve landed handoffs when enforcing review
 briefs

Read-only replay over 18,078 completed local/Board-replica rows exposed a real combined review/landing handoff. Keep the existing published_pr exemption and add its exact metadata shape as a control; receipt-only ship reviews still require their verdict.
---
 hermes_cli/kanban_review_contract.py       | 4 +++-
 tests/tools/test_kanban_review_contract.py | 8 +++++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_review_contract.py b/hermes_cli/kanban_review_contract.py
index 642209f51f4c23756faa27f69b5b747215575190..a809eff152f6badb04347c4cdd532247be0651bf 100644
--- a/hermes_cli/kanban_review_contract.py
+++ b/hermes_cli/kanban_review_contract.py
@@ -112,7 +112,9 @@ def refusal(body: Optional[str], metadata: Any) -> Optional[str]:
     """The refusal text for a review result on a core-fork pull card that ship cannot read, else None."""
     # Ship's generated brief is a review assignment, even when a reviewer forgets every
     # metadata key. Other cards may merely discuss the contract or hand off a landing.
-    required = states_contract(body) and re.match(r"\s*Independent exact-head review of\b", body or "", re.IGNORECASE)
+    landing = isinstance(metadata, dict) and metadata.get("published_pr")
+    required = (not landing and states_contract(body)
+                and re.match(r"\s*Independent exact-head review of\b", body or "", re.IGNORECASE))
     if not required and not is_review_result(metadata):
         return None
     if states_contract(body):
diff --git a/tests/tools/test_kanban_review_contract.py b/tests/tools/test_kanban_review_contract.py
index ef378d401c930b653f612ae1ad9a3daf0615049c..781cfc658ca2849f8329ca3d084f592b47d561d1 100644
--- a/tests/tools/test_kanban_review_contract.py
+++ b/tests/tools/test_kanban_review_contract.py
@@ -125,7 +125,7 @@ def test_refusal_none_when_not_a_review_result(md):
     assert krc.refusal("Investigate the review contract: " + SHIP_BODY, md) is None
 
 
-@pytest.mark.parametrize("md", [None, {}, {"completion_receipt": {}}, {"published_pr": PR}])
+@pytest.mark.parametrize("md", [None, {}, {"completion_receipt": {}}])
 def test_ship_brief_requires_metadata_even_without_review_keys(md):
     result = krc.completion_refusal(SHIP_BODY, md, worker_run_id=1)
     assert result and result[1] == "review_contract"
@@ -133,6 +133,12 @@ def test_ship_brief_requires_metadata_even_without_review_keys(md):
     assert "metadata.reviewed_sha" in result[0]
 
 
+def test_review_brief_landing_handoff_remains_exempt():
+    # A real review-and-land card retained the original review brief after landing.
+    md = {"published_pr": PR, "merged_sha": SHA, "approved_head": SHA, "review_id": 123}
+    assert krc.refusal(SHIP_BODY, md) is None
+
+
 @pytest.mark.parametrize("key", ["verdict", "review_verdict", "review_outcome", "reviewed_sha", "reviewed_head",
                                  "reviewed_pr", "approved", "approval"])
 def test_each_review_key_makes_a_review_result(key):
