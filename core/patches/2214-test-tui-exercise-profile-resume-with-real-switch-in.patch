From 47579369660160270f0ae6b60c905bff9030c5e0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 07:51:09 +0000
Subject: [PATCH] test(tui): exercise profile resume with real switch intent
 storage [daveey]

---
 tests/tui_gateway/test_tui_gateway_server.py | 27 ++++++++++----------
 1 file changed, 13 insertions(+), 14 deletions(-)

diff --git a/tests/tui_gateway/test_tui_gateway_server.py b/tests/tui_gateway/test_tui_gateway_server.py
index 89d1f484d4..f924d3a8bc 100644
--- a/tests/tui_gateway/test_tui_gateway_server.py
+++ b/tests/tui_gateway/test_tui_gateway_server.py
@@ -10301,24 +10301,17 @@ def test_config_set_model_recovers_failed_profile_resume_after_build_completes(
             error_message="",
         )
 
-    class FakeDb:
-        def __init__(self, *_args, **_kwargs):
-            pass
+    from hermes_state import SessionDB
 
-        def get_session(self, _key):
-            return {"model_config": {}}
+    with SessionDB(profile_home / "state.db") as seed:
+        seed.create_session("session-key", "desktop", model="old/model")
 
+    class RecordingDb(SessionDB):
         def update_session_meta(self, key, model_config, model):
             seen["persisted"].append(
-                {
-                    "key": key,
-                    "model": model,
-                    "config": json.loads(model_config),
-                }
+                {"key": key, "model": model, "config": json.loads(model_config)}
             )
-
-        def close(self):
-            pass
+            return super().update_session_meta(key, model_config=model_config, model=model)
 
     def fake_make_agent(_sid, _key, **kwargs):
         nonlocal make_calls
@@ -10355,7 +10348,7 @@ def test_config_set_model_recovers_failed_profile_resume_after_build_completes(
         "hermes_cli.model_selection_guards.combined_selection_warning",
         lambda *args, **kwargs: None,
     )
-    monkeypatch.setattr("hermes_state_registry.acquire", FakeDb)
+    monkeypatch.setattr("hermes_state_registry.acquire", RecordingDb)
     monkeypatch.setattr(server, "_make_agent", fake_make_agent)
     monkeypatch.setattr(server, "_transfer_db_to_agent", barrier_transfer)
     monkeypatch.setattr(
@@ -10406,7 +10399,13 @@ def test_config_set_model_recovers_failed_profile_resume_after_build_completes(
 
         assert not request_thread.is_alive()
         assert "error" not in response
+        assert "error" not in response["value"], response["value"]
         assert response["value"]["result"]["value"] == "new/model"
+        with SessionDB(profile_home / "state.db") as persisted:
+            raw_intent = persisted.route_switch_intent("session-key")
+            assert raw_intent is not None
+            intent = json.loads(raw_intent)
+            assert (intent["model"], intent["provider"]) == ("new/model", "custom:new-provider")
         assert make_calls == 2
         assert seen["switch"] == {
             "home": profile_home,
