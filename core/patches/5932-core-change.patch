diff --git a/hermes_cli/fact_board_inputs.py b/hermes_cli/fact_board_inputs.py
new file mode 100644
index 0000000000..8c8b26019e
--- /dev/null
+++ b/hermes_cli/fact_board_inputs.py
@@ -0,0 +1,176 @@
+"""Demanded native board/tree evidence on the existing ContentOwner feed. [daveey]
+
+This adapter owns no task/session clock or route response cache. Trusted startup
+supplies scoped native capture functions; the engine's ordinary view reducers
+consume their detached inputs. Request demand only edits a bounded memory queue.
+Each worker turn captures one selector, so a slow view cannot starve its peers.
+"""
+from collections import deque
+from contextvars import copy_context
+from dataclasses import dataclass, replace
+import hashlib
+import json
+import threading
+import time
+
+from hermes_cli.fact_capture import CaptureBudgetExceeded
+from hermes_cli.fact_contract import Fact, FactKey, freeze
+from hermes_cli.fact_store import view_key
+from hermes_cli.fact_source_watch import NativeSourceWatch
+
+
+@dataclass(frozen=True)
+class CapturedInput:
+    value: object
+    source_vector: tuple
+    observed_at: float
+
+
+@dataclass(frozen=True)
+class BoardCapture:
+    key: object = None
+    value: object = None
+    source_vector: tuple = ()
+    observed_at: float = 0
+    after: object = None
+    next_deadline: float | None = None
+    failed: bool = False
+
+
+class BoardInputSource:
+    """One bounded round-robin evidence source per authenticated board scope."""
+    def __init__(self, engine, source, capture, *, paths=(), max_selectors=128, refresh_seconds=30, valid_seconds=60):
+        if source.scope != engine.scope or source.kind != 'board.input':
+            raise ValueError('invalid board input source')
+        if max_selectors <= 0 or not 0 < refresh_seconds < valid_seconds:
+            raise ValueError('invalid board input bounds')
+        self.engine, self.source, self._capture = engine, source, capture
+        self.key = FactKey(source.scope, 'BoardInput', '')  # one operational input namespace per scope
+        self._maximum, self._refresh, self._valid = max_selectors, refresh_seconds, valid_seconds
+        self._context = copy_context()
+        self._lock = threading.Lock()
+        self._wanted, self._pending = {}, deque()
+        self._closed = False
+        self._worker = self._result = self._wake = self._deadline = self._active = None
+        self._paths, self._watch = tuple(paths), None
+
+    def input_key(self, view, selector):
+        return FactKey(self.source.scope, 'BoardInput', view_key(self.source.scope, view, selector).id)
+
+    def want(self, view, selector):
+        key = self.input_key(view, selector)
+        with self._lock:
+            if self._closed:
+                return False
+            if key not in self._wanted:
+                if len(self._wanted) >= self._maximum:
+                    return False
+                self._wanted[key] = (view, freeze(selector))
+                self._pending.append(key)
+                wake = self._wake
+            else:
+                wake = None
+        if wake is not None:
+            wake()
+        return True
+
+    def watch(self, wake):
+        with self._lock:
+            if self._closed or self._wake is not None:
+                raise RuntimeError('board source closed or already watched')
+            self._wake = wake
+        if self._paths:
+            self._watch = NativeSourceWatch(self._paths, self._invalidate)
+        return self
+
+    def _invalidate(self):
+        with self._lock:
+            if self._closed:
+                return
+            pending = set(self._pending)
+            self._pending.extend(key for key in self._wanted if key not in pending)
+            wake = self._wake
+        if wake is not None:
+            wake()
+
+    def capture(self, cursor, budget):
+        if self._watch is not None:
+            self._watch.check()
+        with self._lock:
+            if self._closed or self._wake is None:
+                raise RuntimeError('board source unavailable')
+            if self._result is not None:
+                return replace(self._result, next_deadline=time.monotonic() + (0 if self._pending else self._refresh))
+            if self._worker is None or not self._worker.is_alive():
+                if not self._pending:
+                    self._pending.extend(self._wanted)
+                if not self._pending:
+                    return BoardCapture(after=cursor)
+                self._active = self._pending.popleft()
+                self._deadline = time.monotonic() + budget.max_seconds
+                view, selector = self._wanted[self._active]
+                self._worker = threading.Thread(target=self._context.run,
+                    args=(self._build, self._active, view, selector, budget), daemon=True, name='fact-board-capture')
+                self._worker.start()
+            if self._deadline is not None and time.monotonic() >= self._deadline:
+                self._deadline = None
+                return BoardCapture(key=self._active, after=cursor, failed=True, observed_at=time.time())
+            return BoardCapture(after=cursor, next_deadline=self._deadline)
+
+    def _build(self, key, view, selector, budget):
+        started = time.monotonic()
+        try:
+            captured = self._capture(view, selector, budget)
+            encoded = json.dumps(captured.value, separators=(',', ':'), allow_nan=False).encode()
+            if len(encoded) > budget.max_bytes or time.monotonic() - started > budget.max_seconds:
+                raise CaptureBudgetExceeded('board evidence capture budget exceeded')
+            result = BoardCapture(key, freeze(captured.value), captured.source_vector, captured.observed_at,
+                                  hashlib.sha256(encoded).hexdigest())
+        except Exception:  # health: allow BLE001 -- retain prior evidence stale; never publish exception text or empty success
+            import logging
+            logging.getLogger(__name__).debug('board capture failed view=%s', view, exc_info=True)
+            result = BoardCapture(key=key, failed=True, observed_at=time.time())
+        with self._lock:
+            if self._closed:
+                return
+            self._result = result
+            wake = self._wake
+        wake()
+
+    def commit(self, capture):
+        if capture.key is None:
+            return
+        if capture.failed:
+            self._fail(capture.key)
+        else:
+            self.engine.publish([Fact(capture.key, capture.value, source_vector=capture.source_vector,
+                observed_at=capture.observed_at, valid_until=capture.observed_at + self._valid, health='fresh')], now=time.time())
+        with self._lock:
+            # capture() supplies an updated scheduling deadline on a detached result.
+            if self._result is not None and self._result.key == capture.key:
+                self._result = None
+
+    def _fail(self, key):
+        old = self.engine.store.snapshot(self.engine.scope).get(key)
+        fact = (replace(old, health='stale', error_code='board_capture_failed') if old is not None
+                else Fact(key, {}, error_code='board_capture_failed'))
+        self.engine.publish([fact], now=time.time())
+
+    def failure(self):
+        with self._lock:
+            keys = tuple(self._wanted)
+        for key in keys:
+            self._fail(key)
+
+    def close(self, timeout=5):
+        with self._lock:
+            self._closed = True
+            worker = self._worker
+        if self._watch is not None:
+            self._watch.close()
+        if worker is not None:
+            worker.join(timeout)
+            if worker.is_alive():
+                raise TimeoutError('board capture did not stop; custody retained')
+        with self._lock:
+            self._wake = self._result = None
diff --git a/hermes_cli/fact_board_native.py b/hermes_cli/fact_board_native.py
new file mode 100644
index 0000000000..083c8e6aec
--- /dev/null
+++ b/hermes_cli/fact_board_native.py
@@ -0,0 +1,84 @@
+"""Native board/catalog inputs; never call these captures from a request. [daveey]
+
+Only trusted startup supplies ``api`` and the board scope. Related live rows
+share one transaction; shadow and catalog databases retain independent source
+observations. External policy/roster/clock evidence is bounded-refresh, not a
+claim of an atomic cross-database snapshot or instantaneous external truth.
+"""
+from contextlib import closing
+import sqlite3
+import time
+
+from dataclasses import asdict
+from hermes_cli import kanban_task_change as changes
+from hermes_cli import kanban_shadow_view as shadow_view
+
+
+
+def _observation(conn):
+    _dirty, cursor = changes.changed_since(conn, None, limit=1)
+    return {'content': asdict(cursor) if cursor is not None else None,
+            'schema': conn.execute('PRAGMA schema_version').fetchone()[0]}
+
+
+def _board(api, board, selector):
+    observed_at = time.time()
+    with closing(api._conn(board=board)) as live:
+        live.execute('BEGIN')
+        local = api.board_fact_capture.capture(live, **selector)
+        observations = {'local': _observation(live)}
+        shadow = None
+        try:
+            with shadow_view.open_shadow_replica(live) as replica:
+                if replica is not None:
+                    replica.execute('BEGIN')
+                    observations['replica'] = _observation(replica)
+                    shadow = api.board_shadow.capture(live, replica, api.board_fact_capture.project(local),
+                        selector['tenant'], selector['include_archived'], selector['workflow_template_id'],
+                        selector['current_step_key'], selector['done_limit'])
+                    replica.rollback()
+        except sqlite3.Error:
+            # Canonical shadow failure preserves healthy live cards. Record the
+            # degraded source separately rather than claiming a healthy empty replica.
+            observations['replica'] = {'health': 'failed'}
+        live.rollback()
+    return {'value': {'local': local, 'shadow': shadow}, 'observed_at': observed_at,
+            'observations': observations}
+
+
+def capture(api, board, view, selector):
+    """Gather detached canonical inputs on the authorized auxiliary worker."""
+    if view == 'board':
+        return _board(api, board, selector)
+    if view not in ('projects', 'boards'):
+        raise ValueError('unknown board view')
+    from hermes_cli import kanban_db, projects_db
+    observed_at = time.time()
+    with projects_db.connect_closing() as conn:
+        conn.execute('BEGIN')
+        rows = [p.to_dict() for p in projects_db.list_projects(conn, include_archived=view == 'boards')]
+        schema = conn.execute('PRAGMA schema_version').fetchone()[0]
+        conn.rollback()
+    if view == 'projects':
+        value = {'rows': rows}
+    else:
+        boards = kanban_db.list_boards(include_archived=selector['include_archived'])
+        value = {'rows': boards, 'current': kanban_db.get_current_board(),
+                 'counts': {b['slug']: api.board_counts._query(kanban_db.kanban_db_path(board=b['slug']))[0] for b in boards},
+                 'workspace_kinds': {b['slug']: api._default_workspace_kind(b) for b in boards},
+                 'project_names': {p['id']: p['name'] for p in rows}}
+    return {'value': value, 'observed_at': observed_at, 'observations': {'catalog': {'schema': schema}}}
+
+
+def project(api, view, captured):
+    """Canonical serializers only; all discovery and dynamic evidence are captured."""
+    value = api.board_fact_capture._plain(captured)
+    if view == 'board':
+        local = api.board_fact_capture.project(value['local'])
+        return local if value['shadow'] is None else api.board_shadow.project_captured(local, value['shadow'])
+    if view == 'projects':
+        return api.board_catalog_projection.projects(value['rows'])
+    if view == 'boards':
+        return api.board_catalog_projection.boards(value['rows'], value['current'], counts=value['counts'],
+            workspace_kinds=value['workspace_kinds'], project_names=value['project_names'])
+    raise ValueError('unknown board view')
diff --git a/hermes_cli/fact_board_startup.py b/hermes_cli/fact_board_startup.py
new file mode 100644
index 0000000000..36c76b6fc0
--- /dev/null
+++ b/hermes_cli/fact_board_startup.py
@@ -0,0 +1,120 @@
+"""Trusted bundled board mount cutover and scoped native evidence. [daveey]
+
+The flag is startup-only. ON admits no legacy board read, including cold views;
+OFF starts the unchanged prewarm lifetime once. External roster/diagnostic inputs
+have 30s bounded recapture and 60s local validity, not subsecond upstream truth.
+"""
+import json
+import os
+import sys
+import threading
+
+from hermes_cli.fact_board_inputs import CapturedInput
+from hermes_cli.fact_content_owner import ContentBinding
+from hermes_cli.fact_contract import Scope, SourceId, Ready, Pending, Unavailable
+from hermes_cli.fact_view_owner import ViewOwner
+from functools import partial
+from hermes_cli import fact_board_native as board_native_inputs
+
+
+class BoardRuntime:
+    Ready, Pending, Unavailable = Ready, Pending, Unavailable
+
+    def __init__(self, api, *, boards=None):
+        from hermes_cli import kanban_db
+        from hermes_cli.config import get_hermes_home
+        from hermes_cli.profiles import get_active_profile_name
+        self.api = api
+        self.home = str(get_hermes_home())
+        self.profile = get_active_profile_name()
+        self.current = kanban_db.get_current_board()
+        self.boards = tuple(dict.fromkeys(boards if boards is not None else
+                            [self.current, *(b['slug'] for b in kanban_db.list_boards())]))
+        self.owners, self.views = {}, {}
+        self._closed = self._drained = False
+        self._lock = threading.RLock()
+        self._previous = None
+
+    def start(self):
+        from hermes_cli import kanban_db
+        self.api.board_prewarm.stop_board_prewarm()
+        for board in self.boards:
+            scope = Scope(self.home, self.profile, board)
+            path = kanban_db.kanban_db_path(board=board)
+            def capture(view, selector, budget, board=board, scope=scope):
+                result = board_native_inputs.capture(self.api, board, view, dict(selector))
+                source = SourceId(scope, 'board.input', 'native')
+                return CapturedInput(result['value'], ((source, result['observations']),), result['observed_at'])
+            owner = ViewOwner(scope, capture, partial(board_native_inputs.project, self.api), ('board', 'boards', 'projects'),
+                              paths=(path, path.parent, self.home),
+                              bindings=[ContentBinding(SourceId(scope, 'tasks.content', 'local'), path)])
+            self.owners[board] = owner
+            handle = owner.start()
+            paths = (str(path),)
+            def stop(paths=paths):
+                self.api.board_legacy.stop(paths)
+                self.api.board_rows.retire(paths)
+                self.api.board_snapshot.retire(paths)
+            view = self.api.board_fact_views.bind(handle.v1, scope, stop_legacy=stop,
+                start_legacy=lambda: None, demand=handle.demand,
+                hot_selectors=(('board', self.api.board_fact_views.board_selector()), ('projects', {}),
+                               ('boards', {'include_archived': False})))
+            self.views[board] = view
+            view.on_mode('facts', 1)
+            view.prepare()
+        self._previous = self.api.board_fact_views._installed
+        self.api.board_fact_views.install_provider(self, self.provider)
+        return self
+
+    def provider(self, board):
+        from hermes_cli.config import get_hermes_home
+        # Scope comes from the already-authenticated native/plugin route context.
+        # Foreign profiles must never borrow the launch profile's projection.
+        if str(get_hermes_home()) != self.home or self._closed:
+            return Unavailable('board_scope_unavailable')
+        if board is None:
+            owner = self.owners.get(self.current)
+            if owner is None or owner.handle is None:
+                return Unavailable('board_scope_unavailable')
+            catalog = owner.handle.v1.snapshot(owner.scope).view('boards', {'include_archived': False})
+            if not isinstance(catalog, Ready):
+                return Unavailable('board_catalog_unavailable')
+            board = json.loads(catalog.encoded)['current']
+        return self.views.get(board, Unavailable('board_scope_unavailable'))
+
+    def ready(self, board):
+        return self.views[board].prepare()
+
+    def close(self):
+        with self._lock:
+            if self._drained:
+                return
+            self._closed = True  # failed teardown keeps a fail-closed installed provider
+            failures = []
+            for resource in (*self.views.values(), *self.owners.values()):
+                try:
+                    resource.close()
+                except Exception as exc:  # health: allow BLE001 -- retain failed custody and attempt all sibling drains
+                    failures.append(exc)
+            if failures:
+                raise ExceptionGroup('board shutdown incomplete', failures)
+            views = self.api.board_fact_views
+            if views._installed is not None and views._installed[1] == self.provider:
+                views._installed = self._previous
+            self._drained = True
+
+
+def start(api):
+    # health: allow HX002 -- task-defined startup-only rollback switch; not a credential
+    if (os.environ.get('HERMES_FACTS_BOARD', '1').strip().lower() in ('0', 'off', 'false', 'no')
+            or not sys.platform.startswith('linux')):
+        from hermes_cli import kanban_db
+        boards = {kanban_db.get_current_board(), *(b['slug'] for b in kanban_db.list_boards())}
+        api.board_legacy.resume(str(kanban_db.kanban_db_path(board=board)) for board in boards)
+        return api.board_prewarm.LegacyLifecycle(api)
+    runtime = BoardRuntime(api)
+    try:
+        return runtime.start()
+    except BaseException:
+        runtime.close()
+        raise
