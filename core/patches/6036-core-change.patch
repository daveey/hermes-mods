From 62845b723c04c98aae956cb7f81c798e8b05d637 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 24 Nov 2026 03:06:57 +0000
Subject: [PATCH 6036] Early native-sessions capture at serve boot and update-admission hold

Public mirror of source commit 62845b723c04c98aae956cb7f81c798e8b05d637.

---
diff --git a/hermes_cli/always_on_rollover.py b/hermes_cli/always_on_rollover.py
index 9985c7ce8be..19895722694 100644
--- a/hermes_cli/always_on_rollover.py
+++ b/hermes_cli/always_on_rollover.py
@@ -630,9 +630,29 @@
                 return port, False
         return None, False
 
+    def admission_deferred(self, reason: str) -> bool:
+        """Keep launch outside the update hold; supervision retries with its normal backoff.
+
+        marker lives in the installation root (not the active backend's profile home).
+        Stay stdlib-only like the standalone roller; match admission_fence.is_held's lstat.
+        The serve-side fence remains authoritative for a hold arriving after this check.
+        """
+        hold = self.marker.parent / "core-update" / "holds" / "hermes-sync"
+        try:
+            hold.lstat()
+        except FileNotFoundError:
+            return False
+        except OSError as exc:
+            log(f"roll ({reason}) deferred: cannot read update admission hold {hold}: {exc}; keeping current backend")
+            return True
+        log(f"roll ({reason}) deferred: update admission hold {hold} is set; keeping current backend")
+        return True
+
     def roll(self, reason: str, *, marker_waited: bool = False) -> bool:
         """*marker_waited*: the caller already waited out the update marker (Roller.start), so a stale marker
         does not hold the roll for a second UPDATE_WAIT_S."""
+        if self.admission_deferred(reason):
+            return False
         if not marker_waited and not aod.wait_for_update_clear(self.marker, sleep=self.sleep, now=self.clock):
             log("update marker still present; rolling anyway")
         record = read_active(self.home)
@@ -642,6 +662,10 @@
         if port is None:
             log(f"roll ({reason}) skipped: every backend port {self.ports} is busy; retiring backends hold them")
             return False
+        # Port discovery and marker waits may outlive the first admission observation.
+        # Do not publish warming state (or consume the unit boot budget) under a new hold.
+        if self.admission_deferred(reason):
+            return False
         log(f"roll ({reason}): {'adopting' if adopted else 'starting'} backend :{port}"
             f" (active :{active_port or '-'}, HEAD {(head or '?')[:10]})")
         if active_port is None:
diff --git a/tests/hermes_cli/test_always_on_rollover.py b/tests/hermes_cli/test_always_on_rollover.py
index 4a653e10f5e..fe6a4c5a830 100644
--- a/tests/hermes_cli/test_always_on_rollover.py
+++ b/tests/hermes_cli/test_always_on_rollover.py
@@ -276,6 +276,85 @@
     return roller
 
 
+@pytest.mark.parametrize("dangling", [False, True])
+def test_roll_defers_admission_hold_then_launches_after_clear(home, capsys, dangling):
+    host = FakeHost(running={9148}, commits={9148: "a" * 40})
+    ro.write_active(9148)
+    before = ro.active_path().read_bytes()
+    roller = make_roller(home, host)
+    hold = roller.marker.parent / "core-update" / "holds" / "hermes-sync"
+    hold.parent.mkdir(parents=True)
+    if dangling:
+        hold.symlink_to(home / "absent")
+    else:
+        hold.touch()
+    for _ in range(3):  # a permanent hold returns immediately, without consuming boot time
+        assert roller.roll("held", marker_waited=True) is False
+        assert ro.active_path().read_bytes() == before
+        assert host.running == {9148}
+        health = roller.health(9148)
+        assert health and health["ok"] is True
+    assert roller.clock() == 0
+    assert host.calls == []  # held admission must defer even before port discovery
+    assert not any(c[0] in ("start", "stop", "reset-failed") for c in host.calls)
+    assert "update admission hold" in capsys.readouterr().err
+    from hermes_cli import admission_fence, serve_update_wait
+
+    boot_logs = []
+    start = host._start
+
+    def boot(port):
+        assert serve_update_wait.wait_for_update_clear(
+            update_probe=lambda: False,
+            hold_probe=lambda: admission_fence.is_held(hold.parent.parent),
+            log=boot_logs.append, sleep=roller.sleep, now=roller.clock) == "clear"
+        return start(port)
+
+    host._start = boot
+    hold.unlink()
+    assert roller.roll("clear") is True
+    assert boot_logs == []  # real serve gate saw no hold and emitted no waiting line
+    assert ("start", "--no-block", ro.backend_unit(9149)) in host.calls
+    assert "update admission hold" not in capsys.readouterr().err
+    assert 9148 in host.running
+
+
+def test_roll_rechecks_admission_after_port_discovery(home, monkeypatch):
+    host = FakeHost(running={9148})
+    ro.write_active(9148)
+    before = ro.active_path().read_bytes()
+    roller = make_roller(home, host)
+    pick = roller.pick_port
+
+    def pick_then_hold(*args):
+        result = pick(*args)
+        hold = roller.marker.parent / "core-update" / "holds" / "hermes-sync"
+        hold.parent.mkdir(parents=True)
+        hold.touch()
+        return result
+
+    monkeypatch.setattr(roller, "pick_port", pick_then_hold)
+    assert roller.roll("new hold") is False
+    assert ro.active_path().read_bytes() == before
+    assert host.running == {9148}
+    assert not any(c[0] in ("start", "reset-failed", "stop") for c in host.calls)
+
+
+def test_roll_unreadable_admission_fails_closed(home, monkeypatch, capsys):
+    roller = make_roller(home, FakeHost())
+    real_lstat = Path.lstat
+
+    def unreadable(path):
+        if path.name == "hermes-sync":
+            raise PermissionError("denied")
+        return real_lstat(path)
+
+    monkeypatch.setattr(Path, "lstat", unreadable)
+    assert roller.roll("unreadable") is False
+    assert "cannot read update admission hold" in capsys.readouterr().err
+    assert ro.read_active() is None
+
+
 def test_roll_warms_the_successor_before_switching_and_never_stops_the_old_backend(home):
     host = FakeHost(running={9148}, commits={9148: "a" * 40})
     ro.write_active(9148)
