Subject: [PATCH 6267] Explicit Carbon routing and model-neutral obligations

Public mirror of source commit 259738f37b5382e0437b10b45dc3e1a62ea96964.

---
diff --git a/hermes_cli/kanban_model_neutral.py b/hermes_cli/kanban_model_neutral.py
index db7259182f5..b1a629a0e7f 100644
--- a/hermes_cli/kanban_model_neutral.py
+++ b/hermes_cli/kanban_model_neutral.py
@@ -217,6 +217,19 @@
     return True
 
 
+def _route_spans(line):
+    """Map the validator's one-pass Markdown rendering back to original bytes."""
+    positions, last = [], 0
+    for match in re.finditer(r'(`+|\*\*|__|\*|_)(.+?)\1', line):
+        positions.extend(range(last, match.start()))
+        positions.extend(range(*match.span(2)))
+        last = match.end()
+    positions.extend(range(last, len(line)))
+    rendered = ''.join(line[index] for index in positions)
+    return [(positions[match.start()], positions[match.end() - 1] + 1)
+            for match in _ROUTE_OCCURRENCE.finditer(rendered)]
+
+
 def neutral_line(line):
     """The refused line with only the route identities its obligations name made neutral.
 
@@ -226,7 +239,7 @@
     machine directive such as ``require_model: true``). No lexical guess decides
     which prose is a gate: only the unchanged ingress recognizer is consulted.
     """
-    spans = [m.span() for m in _ROUTE_OCCURRENCE.finditer(line)]
+    spans = _route_spans(line)
 
     def render(chosen):
         out, last = [], 0
@@ -268,7 +281,13 @@
     lines = []
     for line in (text or '').splitlines():
         if not _passes(line):
-            line = retained_line(line) or _EVIDENCE + json.dumps(line, ensure_ascii=False)
+            if _REQUIRED.fullmatch(line):
+                line = _EVIDENCE + json.dumps(line, ensure_ascii=False)
+            else:
+                retained = retained_line(line)
+                if retained is None:
+                    validate_text(line)  # Refuse rather than discard unknown mixed obligations.
+                line = retained
         lines.append(line)
     return '\n'.join(lines)
 
diff --git a/tests/hermes_cli/test_kanban_model_retirement_preserve.py b/tests/hermes_cli/test_kanban_model_retirement_preserve.py
index 7668508e486..6e5d191765c 100644
--- a/tests/hermes_cli/test_kanban_model_retirement_preserve.py
+++ b/tests/hermes_cli/test_kanban_model_retirement_preserve.py
@@ -73,6 +73,29 @@
                        + NEUTRAL_ROUTE + '; keep CI green.')
 
 
+@pytest.mark.parametrize('identity', ['opus', '**opus**', '_opus_', '__opus__', '`opus`', '*opus*'])
+@pytest.mark.parametrize('transform', [retired_body, forwarded_text])
+def test_markdown_identity_keeps_active_gates(identity, transform):
+    line = f'Must use {identity}; keep CI green. Never hand merge.'
+    with pytest.raises(ValueError):
+        validate_text(line)
+    out = transform(line)
+    validate_text(out)
+    active = _active(out)
+    assert 'keep CI green. Never hand merge.' in active
+    assert identity.replace('opus', NEUTRAL_ROUTE) in out.splitlines()[1]
+    assert transform(out) == out
+
+
+def test_forwarding_refuses_unknown_neutralization_without_discarding_gates(monkeypatch):
+    from hermes_cli import kanban_model_neutral as policy
+    monkeypatch.setattr(policy, 'neutral_line', lambda line: None)
+    with pytest.raises(ValueError):
+        forwarded_text('Must use opus; keep CI green. Never hand merge.')
+    line = 'Must use opus; keep CI green. Never hand merge.'
+    assert retired_body(line) == line
+
+
 def test_nameless_pure_directive_is_quoted_alone():
     assert retired_body('  require_model: true\n') == PREFIX + json.dumps('  require_model: true') + '\n'
     assert forwarded_text('require_model: true') == PREFIX + json.dumps('require_model: true')
