diff --git a/.github/scripts/workspace-check-stall-probe.mjs b/.github/scripts/workspace-check-stall-probe.mjs
new file mode 100644
index 0000000000..7bff1bdb57
--- /dev/null
+++ b/.github/scripts/workspace-check-stall-probe.mjs
@@ -0,0 +1,183 @@
+// A stall probe for run-workspace-checks.mjs.
+//
+// Main CI run 41087044980 failed on four tests that each sat for 24-34 s
+// (a git init, a scripted ssh close, a bash spawn, a store rewrite) while the
+// same sha passed twice. Total test time was the same in all three runs, so
+// the runner did not run slower. Single operations froze, in passing runs too
+// (`ensureGitRepo` 26 s, checkout-handoff 35 s). Nothing in the job log says
+// whether the freeze is the disk (fsync), memory reclaim at the cgroup limit,
+// or CPU. This probe measures all three on the runner itself:
+//
+//   - every second it writes and fsyncs a small file in the temp directory the
+//     tests use, and records how long that took;
+//   - it reads the cgroup's PSI files (io, memory, cpu) and memory.events at
+//     the start and the end, so the summary carries the time tasks spent
+//     stalled on each resource during this run.
+//
+// Pure functions and an injectable fsync, so tests run without a cgroup.
+
+import { open, unlink } from 'node:fs/promises'
+import { join } from 'node:path'
+
+/** A probe write+fsync slower than this is a stall worth naming. */
+export const STALL_MS = 1000
+/** ... and slower than this is long enough to time out a 5 s test on its own. */
+export const SEVERE_STALL_MS = 5000
+
+/**
+ * The cumulative stall time of a cgroup v2 PSI file, in microseconds.
+ * `full` is absent on cpu.pressure of older kernels.
+ *
+ * @param {string | null} text
+ * @returns {{some: number, full: number | null} | null}
+ */
+export function parsePressure(text) {
+  if (!text) return null
+  const total = (/** @type {string} */ kind) => {
+    const n = text.match(new RegExp(`^${kind} .*\\btotal=(\\d+)`, 'm'))?.[1]
+    return n === undefined ? null : Number(n)
+  }
+  const some = total('some')
+  return some === null ? null : { some, full: total('full') }
+}
+
+/**
+ * The counters of a cgroup v2 `memory.events` file.
+ *
+ * @param {string | null} text
+ * @returns {Record<string, number>}
+ */
+export function parseEvents(text) {
+  /** @type {Record<string, number>} */
+  const out = {}
+  for (const line of (text ?? '').split('\n')) {
+    const [key, value] = line.trim().split(/\s+/)
+    if (key && /^\d+$/.test(value ?? '')) out[key] = Number(value)
+  }
+  return out
+}
+
+/**
+ * One reading of everything the summary compares.
+ *
+ * @param {(file: string) => string | null} read reads a file of the job's cgroup
+ */
+export function readCounters(read) {
+  return {
+    io: parsePressure(read('io.pressure')),
+    memory: parsePressure(read('memory.pressure')),
+    cpu: parsePressure(read('cpu.pressure')),
+    events: parseEvents(read('memory.events')),
+  }
+}
+
+/** @typedef {{at: number, fsyncMs: number, lagMs: number, running: string[]}} Sample */
+
+/**
+ * @param {Sample[]} samples
+ * @param {ReturnType<typeof readCounters>} before
+ * @param {ReturnType<typeof readCounters>} after
+ */
+export function summarize(samples, before, after) {
+  const sorted = [...samples].sort((a, b) => b.fsyncMs - a.fsyncMs)
+  const delta = (/** @type {'io'|'memory'|'cpu'} */ k, /** @type {'some'|'full'} */ f) => {
+    const a = after[k]?.[f]
+    const b = before[k]?.[f]
+    return a == null || b == null ? null : Math.round((a - b) / 1000)
+  }
+  const event = (/** @type {string} */ k) =>
+    k in after.events && k in before.events ? after.events[k] - before.events[k] : null
+  return {
+    samples: samples.length,
+    maxFsyncMs: sorted[0] ? Math.round(sorted[0].fsyncMs) : null,
+    maxLagMs: samples.reduce((m, s) => Math.max(m, Math.round(s.lagMs)), 0),
+    stalls: samples.filter((s) => s.fsyncMs >= STALL_MS).length,
+    severeStalls: samples.filter((s) => s.fsyncMs >= SEVERE_STALL_MS).length,
+    worst: sorted.slice(0, 5).filter((s) => s.fsyncMs >= STALL_MS),
+    // Milliseconds any task / all tasks of the cgroup spent stalled.
+    stalledMs: {
+      ioSome: delta('io', 'some'),
+      ioFull: delta('io', 'full'),
+      memorySome: delta('memory', 'some'),
+      memoryFull: delta('memory', 'full'),
+      cpuSome: delta('cpu', 'some'),
+    },
+    // Times the cgroup crossed memory.high / hit memory.max during this run.
+    events: { high: event('high'), max: event('max') },
+  }
+}
+
+/** @param {string} dir */
+async function defaultFsync(dir) {
+  const path = join(dir, `.stall-probe-${process.pid}`)
+  const handle = await open(path, 'w')
+  try {
+    await handle.write(Buffer.alloc(4096, 1))
+    await handle.sync()
+  } finally {
+    await handle.close()
+    await unlink(path).catch(() => {})
+  }
+}
+
+/**
+ * Start sampling. `stop()` ends it and returns the samples.
+ *
+ * @param {{dir: string, intervalMs?: number, running?: () => string[], onStall?: (s: Sample) => void,
+ *   fsyncOnce?: (dir: string) => Promise<void>, now?: () => number}} opts
+ * @returns {{stop: () => Promise<Sample[]>}}
+ */
+export function startStallProbe({
+  dir,
+  intervalMs = 1000,
+  running = () => [],
+  onStall,
+  fsyncOnce = defaultFsync,
+  now = () => performance.now(),
+}) {
+  /** @type {Sample[]} */
+  const samples = []
+  let stopped = false
+  /** @type {ReturnType<typeof setTimeout> | undefined} */
+  let timer
+  /** @type {Promise<void>} */
+  let loop = Promise.resolve()
+
+  function schedule() {
+    const due = now() + intervalMs
+    timer = setTimeout(() => {
+      loop = tick(due)
+    }, intervalMs)
+    // The probe must never keep the process alive.
+    timer.unref?.()
+  }
+
+  /** @param {number} due */
+  async function tick(due) {
+    const started = now()
+    // How late the timer fired: the event loop of this process was stuck.
+    const lagMs = Math.max(0, started - due)
+    try {
+      await fsyncOnce(dir)
+    } catch {
+      // A probe that cannot write says nothing about the disk; skip the sample.
+      if (!stopped) schedule()
+      return
+    }
+    /** @type {Sample} */
+    const sample = { at: Date.now(), fsyncMs: now() - started, lagMs, running: running() }
+    samples.push(sample)
+    if (sample.fsyncMs >= SEVERE_STALL_MS) onStall?.(sample)
+    if (!stopped) schedule()
+  }
+
+  schedule()
+  return {
+    async stop() {
+      stopped = true
+      clearTimeout(timer)
+      await loop
+      return samples
+    },
+  }
+}
diff --git a/.github/scripts/workspace-check-temp-memory.mjs b/.github/scripts/workspace-check-temp-memory.mjs
new file mode 100644
index 0000000000..efb2fe1b2c
--- /dev/null
+++ b/.github/scripts/workspace-check-temp-memory.mjs
@@ -0,0 +1,13 @@
+import { statfsSync } from 'node:fs'
+
+/**
+ * tmpfs pages count against the same cgroup as the check processes. Reserve
+ * the whole bounded mount, not its current use, before starting those writers.
+ * @param {string} dir
+ * @param {(dir: string) => {type: number, bsize: number, blocks: number}} read
+ */
+export function temporaryMemoryMiB(dir, read = statfsSync) {
+  if (process.platform !== 'linux') return 0
+  const fs = read(dir)
+  return fs.type === 0x01021994 ? Math.ceil(fs.bsize * fs.blocks / 2 ** 20) : 0
+}
diff --git a/.github/workflows/js-tests.yml b/.github/workflows/js-tests.yml
index 309d6b42d4..1f0140597e 100644
--- a/.github/workflows/js-tests.yml
+++ b/.github/workflows/js-tests.yml
@@ -117,7 +117,40 @@ jobs:
         # the sum stays inside that cgroup limit.
         env:
           NODE_OPTIONS: --max-old-space-size=4096
-        run: node .github/scripts/run-workspace-checks.mjs
+        shell: bash
+        run: |
+          # CI overlay /tmp measured 32-35s write+fsync stalls (#335).
+          # Disposable fixtures need executable storage, not durable EBS writes.
+          # The scheduler reserves this full 1 GiB inside the 8 GiB cgroup.
+          # The runner container may lack CAP_SYS_ADMIN (PR 335 run 41100984332: mount denied).
+          # Then fall back to an executable /dev/shm of at least 512 MiB, else the default disk.
+          mounted=""
+          if temp_root="$(mktemp -d /tmp/wc.XXXXXX)" &&
+            sudo mount -t tmpfs -o size=1G,mode=1777,exec,nosuid,nodev tmpfs "$temp_root"; then
+            mounted="$temp_root"
+          else
+            rmdir "$temp_root" 2>/dev/null || true
+            echo "::warning::tmpfs mount denied; probing /dev/shm"
+            grep -E ' /dev/shm ' /proc/mounts || true
+            shm_kib="$(df -Pk /dev/shm 2>/dev/null | awk 'NR==2{print $2}')"
+            if [ "${shm_kib:-0}" -ge 524288 ] && ! grep -E ' /dev/shm .*[ ,(]noexec[ ,)]' /proc/mounts >/dev/null; then
+              temp_root="$(mktemp -d /dev/shm/wc.XXXXXX)"
+            else
+              echo "::warning::no executable tmpfs available; fixtures stay on the runner disk"
+              temp_root="$(mktemp -d /tmp/wc.XXXXXX)"
+            fi
+          fi
+          cleanup() {
+            df -h "$temp_root"
+            if [ -n "$mounted" ]; then
+              # Job-end process cleanup follows this step. Detach even if a test
+              # daemon still holds its cwd; don't leak a mount into the next job.
+              sudo umount "$temp_root" || sudo umount -l "$temp_root"
+            fi
+            rm -rf "$temp_root" 2>/dev/null || true
+          }
+          trap cleanup EXIT
+          TMPDIR="$temp_root" node .github/scripts/run-workspace-checks.mjs
       - name: Check the checkout is clean
         # Last step of every job (tests/ci/test_clean_worktree_check.py): a test or CI step that
         # leaves an untracked or modified file in the checkout is reported here. Runs only when
diff --git a/tests-js/workspace-check-stall-probe.test.mjs b/tests-js/workspace-check-stall-probe.test.mjs
new file mode 100644
index 0000000000..c7866893d9
--- /dev/null
+++ b/tests-js/workspace-check-stall-probe.test.mjs
@@ -0,0 +1,114 @@
+import { mkdtempSync, readdirSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+import { expect, test } from 'vitest'
+
+import {
+  SEVERE_STALL_MS,
+  parseEvents,
+  parsePressure,
+  readCounters,
+  startStallProbe,
+  summarize,
+} from '../.github/scripts/workspace-check-stall-probe.mjs'
+
+const PSI = 'some avg10=0.00 avg60=1.20 avg300=0.50 total=2500000\nfull avg10=0.00 avg60=0.10 avg300=0.05 total=400000\n'
+
+test('PSI totals are read as microseconds, and a missing or empty file is null', () => {
+  expect(parsePressure(PSI)).toEqual({ some: 2500000, full: 400000 })
+  expect(parsePressure('some avg10=0.00 avg60=0.00 avg300=0.00 total=7\n')).toEqual({ some: 7, full: null })
+  expect(parsePressure(null)).toBeNull()
+  expect(parsePressure('')).toBeNull()
+})
+
+test('memory.events counters are read by name', () => {
+  expect(parseEvents('low 0\nhigh 4\nmax 12\noom 0\noom_kill 0\n')).toMatchObject({ high: 4, max: 12 })
+  expect(parseEvents(null)).toEqual({})
+})
+
+test('the summary reports stall time per resource as the difference over the run', () => {
+  const files = (io, memory, high) => (f) =>
+    ({
+      'io.pressure': `some avg10=0 avg60=0 avg300=0 total=${io}\nfull avg10=0 avg60=0 avg300=0 total=${io / 2}\n`,
+      'memory.pressure': `some avg10=0 avg60=0 avg300=0 total=${memory}\nfull avg10=0 avg60=0 avg300=0 total=${memory}\n`,
+      'memory.events': `high ${high}\nmax 0\n`,
+    })[f] ?? null
+  const before = readCounters(files(1_000_000, 0, 1))
+  const after = readCounters(files(31_000_000, 2_000_000, 4))
+  const samples = [
+    { at: 1, fsyncMs: 12, lagMs: 1, running: [] },
+    { at: 2, fsyncMs: 31_400, lagMs: 30_000, running: ['apps/desktop :: check:test:ui'] },
+    { at: 3, fsyncMs: 1_200, lagMs: 0, running: [] },
+  ]
+  const s = summarize(samples, before, after)
+  expect(s).toMatchObject({
+    samples: 3,
+    maxFsyncMs: 31_400,
+    maxLagMs: 30_000,
+    stalls: 2,
+    severeStalls: 1,
+    stalledMs: { ioSome: 30_000, ioFull: 15_000, memorySome: 2_000, memoryFull: 2_000, cpuSome: null },
+    events: { high: 3, max: 0 },
+  })
+  expect(s.worst.map((w) => w.at)).toEqual([2, 3])
+})
+
+test('a runner without a cgroup gives null stall times, never zero', () => {
+  const none = readCounters(() => null)
+  expect(summarize([], none, none).stalledMs).toEqual({
+    ioSome: null,
+    ioFull: null,
+    memorySome: null,
+    memoryFull: null,
+    cpuSome: null,
+  })
+})
+
+test('the probe reports a slow write with the checks that were running, and stops sampling on stop()', async () => {
+  let clock = 0
+  const stalls = []
+  const probe = startStallProbe({
+    dir: '/unused',
+    intervalMs: 1,
+    now: () => clock,
+    running: () => ['ui-tui :: check'],
+    fsyncOnce: async () => {
+      clock += SEVERE_STALL_MS + 1
+    },
+    onStall: (s) => stalls.push(s),
+  })
+  await new Promise((r) => setTimeout(r, 40))
+  const samples = await probe.stop()
+  expect(samples.length).toBeGreaterThan(0)
+  expect(stalls.length).toBe(samples.length)
+  expect(stalls[0]).toMatchObject({ fsyncMs: SEVERE_STALL_MS + 1, running: ['ui-tui :: check'] })
+  await new Promise((r) => setTimeout(r, 20))
+  expect(await probe.stop()).toHaveLength(samples.length)
+})
+
+test('a write that fails is skipped, not recorded as a fast disk', async () => {
+  const probe = startStallProbe({
+    dir: '/unused',
+    intervalMs: 1,
+    fsyncOnce: async () => {
+      throw new Error('ENOSPC')
+    },
+  })
+  await new Promise((r) => setTimeout(r, 20))
+  expect(await probe.stop()).toEqual([])
+})
+
+test('the real write+fsync path measures the temp dir and leaves nothing behind', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'stall-probe-'))
+  try {
+    const probe = startStallProbe({ dir, intervalMs: 5 })
+    await new Promise((r) => setTimeout(r, 150))
+    const samples = await probe.stop()
+    expect(samples.length).toBeGreaterThan(2)
+    expect(samples.every((s) => s.fsyncMs >= 0 && s.fsyncMs < SEVERE_STALL_MS)).toBe(true)
+    expect(readdirSync(dir)).toEqual([])
+  } finally {
+    rmSync(dir, { recursive: true, force: true })
+  }
+})
