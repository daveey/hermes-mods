From f686b421ae14f72628b02b8ed965cff136cd3072 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:47:12 +0000
Subject: [PATCH] fix: mark the fork's five intentional detached spawns for
 upstream's spawn checker [daveey]

---
diff --git a/hermes_cli/kanban_db_recover.py b/hermes_cli/kanban_db_recover.py
index 827b1dd7e3501fddb5f7f438439975997256923b..f76fb47d845c0bc4a6c33f6811ddafb0fd428943 100644
--- a/hermes_cli/kanban_db_recover.py
+++ b/hermes_cli/kanban_db_recover.py
@@ -876,6 +876,7 @@ def spawn_recovery(db_path: Path, *, wait: bool = False, timeout: float = RECOVE
         log = Path(key).with_name(Path(key).name + ".recover.log")
         with open(log, "ab") as out:
             subprocess.Popen(cmd, stdout=out, stderr=out, stdin=subprocess.DEVNULL, env=env,
+                             # detached-spawn: ok — board recovery must finish its backup/swap even if the process that noticed the damage dies [daveey]
                              cwd=repo_root, start_new_session=True)
         _log.error("kanban board %s has table b-tree damage; started automatic recovery (log %s)", key, log)
         return None
diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index a635f5c1614288ae74978dcfe062b18b9441a08a..7a1dacf0b583dc2dd4264d6145512baa0dae6e38 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -590,6 +590,7 @@ def _default_spawn(argv: list[str]) -> None:
     """Start ``argv`` detached: it finishes (and records its result) even after the tool call returns."""
     try:
         subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+                         # detached-spawn: ok — the placement forwarder must outlive the tool call that starts it and record its result [daveey]
                          start_new_session=True)
     except OSError:
         pass
diff --git a/hermes_cli/kanban_wake_check.py b/hermes_cli/kanban_wake_check.py
index bd261c526779712e504e889ddd0398eb50defdf4..69fc4049db63760c431c892d670619de2610b2fd 100644
--- a/hermes_cli/kanban_wake_check.py
+++ b/hermes_cli/kanban_wake_check.py
@@ -367,6 +367,7 @@ def _run_probe(key: tuple[str, str], cmd: str, cwd: str, env: dict) -> tuple[Any
     try:
         proc = subprocess.Popen(
             ["bash", "-lc", cmd], cwd=cwd, env=env, stdin=subprocess.DEVNULL,
+            # detached-spawn: ok — awaited with PROBE_TIMEOUT_SECONDS; _kill ends the whole group on timeout [daveey]
             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
     except OSError as exc:
         return 127, f"could not start probe: {exc}"
diff --git a/hermes_cli/session_handover.py b/hermes_cli/session_handover.py
index 77abaff653041c5a672d7b270595613e997f837f..7dcfd027599df60d440e7992a2242404adbd6337 100644
--- a/hermes_cli/session_handover.py
+++ b/hermes_cli/session_handover.py
@@ -495,6 +495,7 @@ def spawn_after_turn_move(session_id: str, to: str, reason: str) -> int:
         p = subprocess.Popen(
             [sys.executable, "-m", "hermes_cli.main", "sessions", "move", session_id, "--to", to,
              "--reason", reason, "--after-turn"],
+            # detached-spawn: ok — the after-turn move must outlive the turn (and agent) that requested it [daveey]
             cwd=repo, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
             env=build_subprocess_env(scrub_secrets=False, inherit_profile_home=False))
     finally:
-- 
