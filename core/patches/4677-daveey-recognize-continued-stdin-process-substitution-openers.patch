From 29b5f9d05234f0b6ff304a9322ae8262d3f50aae Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 11:56:28 +0000
Subject: [PATCH] [daveey] recognize continued stdin process-substitution
 openers

The printed nested-shell walk prefiltered literal <( while the tokenizer already understands active backslash-newline continuations. Use a continuation-aware prefilter without rewriting quoted data or heredoc bodies. Generated insertion tests cover every process-feed shape with one and two continuations; real Bash marker execution, scan-cap refusal, clean twins and inert text controls cover B1.
---
 cron/lifecycle_guard_nested_shells.py         |  5 ++-
 .../test_lifecycle_guard_session_aliases.py   | 41 ++++++++++++++++++-
 2 files changed, 44 insertions(+), 2 deletions(-)

diff --git a/cron/lifecycle_guard_nested_shells.py b/cron/lifecycle_guard_nested_shells.py
index 41bc88a4c5da021d0af6ec78a0046d2c467faa84..18fb18eaeafe468019b083137a0c9de27d65c0b8 100644
--- a/cron/lifecycle_guard_nested_shells.py
+++ b/cron/lifecycle_guard_nested_shells.py
@@ -516,7 +516,8 @@ def _iter_nested_printed_payloads(command: str, *, pipes: bool = True) -> Iterat
     """
     from cron.lifecycle_guard_output import iter_printed_shell_payloads
 
-    piped, substituted = pipes and "|" in command, "<(" in command
+    piped = pipes and "|" in command
+    substituted = _STDIN_PROCESS_OPENER.search(command) is not None
     if not (piped or substituted):
         return  # do not tokenize large generators with neither feed a second time
     for unit in _printed_pipeline_units(command):
@@ -532,6 +533,8 @@ def _iter_nested_printed_payloads(command: str, *, pipes: bool = True) -> Iterat
                 yield payload
 
 
+# Only a prefilter: tokenization below removes active continuations in their quote frame.
+_STDIN_PROCESS_OPENER = re.compile(r"<(?:\\\n)*\(")
 _STDIN_OPERATORS = frozenset({"<", "0<", "<>", "0<>"})
 _SUBSTITUTION_WORD = "\x00<(…)"  # what a `<(…)` stands in for in a command's words
 
diff --git a/tests/cron/test_lifecycle_guard_session_aliases.py b/tests/cron/test_lifecycle_guard_session_aliases.py
index 135b0d8cc934a3cd370e3a7c3434519ec8d58039..5eb907f4c30c466961deff9d692e87898c165264 100644
--- a/tests/cron/test_lifecycle_guard_session_aliases.py
+++ b/tests/cron/test_lifecycle_guard_session_aliases.py
@@ -356,7 +356,44 @@ _NESTED_FOREIGN_SHELLS = [
 ]
 
 
-@pytest.mark.parametrize("shape", _NESTED_FOREIGN_SHELLS)
+@pytest.mark.parametrize("count", [1, 2])
+@pytest.mark.parametrize("names", [frozenset({"zz"}), frozenset(), None])
+def test_continued_process_opener_real_bash_and_clean_twin(tmp_path, count, names):
+    import shlex
+
+    from tools.environments.local import build_subprocess_env
+
+    script = _big(tmp_path)
+    # The referenced script is harmless to execute, but exceeds the guard's scan cap.
+    script.write_text("# padding\n" * 130000 + "printf RAN\n")
+    payload = "shopt -s expand_aliases\nalias t='time '\n" + f"t ( bash {script} )"
+    command = "bash --noprofile -l < <" + "\\\n" * count + "(printf '%s\\n' " + shlex.quote(payload) + ")"
+    result = subprocess.run(["/bin/bash", "--noprofile", "--norc", "-c", command],
+                            env=build_subprocess_env(), text=True, encoding="utf-8",
+                            capture_output=True, timeout=10, check=True)
+    assert result.stdout == "RAN"
+    unsafe, refusal = scan_gateway_lifecycle(command, cwd=str(tmp_path), session_aliases=names)
+    assert unsafe and refusal is not None and "scan cap" in refusal
+    script.write_text("printf RAN\n")
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path), session_aliases=names) == (False, None)
+
+
+@pytest.mark.parametrize("count", [1, 2])
+@pytest.mark.parametrize("wrapper", ["printf '%s' {text}", "cat <<'EOF'\n{text}\nEOF"])
+def test_continued_process_opener_inert_text(tmp_path, live_kanban_db, count, wrapper):
+    import shlex
+
+    text = "su -l bob < <" + "\\\n" * count + f"(echo t ( bash {live_kanban_db} ))"
+    command = wrapper.format(text=shlex.quote(text) if wrapper.startswith("printf") else text)
+    for names in (frozenset({"zz"}), frozenset()):
+        assert scan_gateway_lifecycle(command, cwd=str(tmp_path), session_aliases=names) == (False, None)
+
+
+@pytest.mark.parametrize("shape", _NESTED_FOREIGN_SHELLS + [
+    shape.replace("<(", "<" + "\\\n" * count + "(")
+    for shape in _NESTED_FOREIGN_SHELLS if "<(" in shape
+    for count in (1, 2)
+])
 def test_nested_login_shell_body_treats_names_as_unknown(tmp_path, live_kanban_db, shape):
     """Base refused these under any session alias; #2358 allowed them when the outer names
     (`zz`) missed `t`. The inner shell's own startup files decide whether `t` is an alias."""
@@ -434,6 +471,8 @@ def test_nested_login_shell_body_treats_names_as_unknown(tmp_path, live_kanban_d
     "bash < <(echo 't ( bash {db} )')",
     "bash -s < <(printf '%s\\n' 't ( bash {db} )')",
     "cat < <(echo 't ( bash {db} )')",
+    *[shell + " < <" + "\\\n" * count + "(echo 't ( bash {db} )')"
+      for shell in ("bash", "cat") for count in (1, 2)],
     "su -l bob -c true < <(echo 't ( bash {db} )')",
     "su -l bob; cat < <(echo 't ( bash {db} )')",
     "{{ su -l bob; cat < <(echo 't ( bash {db} )'); }}",
