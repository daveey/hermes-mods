+@pytest.mark.parametrize("offset,removed", [(-1, 0), (0, 1), (1, 1)])
+def test_authority_lease_expiry_boundary(env, offset, removed):
+    _, path, _ = evicted(env)
+    env.owner.update(lease_holder="other", lease_expires=(NOW + 60) * 1000)
+    env.now = NOW + 60 + offset
+    assert gc.gc_task_scratch(env.conn, older_than_days=7) == removed
+    assert path.exists() is (not removed)
+
+
+@pytest.mark.parametrize("offset,removed", [(-1, 0), (0, 1), (1, 1)])
+def test_retention_deadline_boundary(env, offset, removed):
+    _, path, _ = evicted(env)
+    env.owner["completed_at"] = NOW
+    env.now = NOW + 7 * 86400 + offset
+    assert gc.gc_task_scratch(env.conn, older_than_days=7) == removed
+    assert path.exists() is (not removed)
+
+
