From fd7d62aca16dff44758dce15fe6f544541f92237 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 04:38:40 +0000
Subject: [PATCH 1138/1157] test: rename guard isolates the inode (same size,
 mtime and dir mtime); comment names the unseen paths [daveey]

---
 hermes_cli/plugins_snapshot.py                   |  3 ++-
 .../test_plugin_hook_presence_record.py          | 16 +++++++++++-----
 2 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/plugins_snapshot.py b/hermes_cli/plugins_snapshot.py
index db713e0d3e7..4414b4744ca 100644
--- a/hermes_cli/plugins_snapshot.py
+++ b/hermes_cli/plugins_snapshot.py
@@ -88,7 +88,8 @@ def _stat_entry(path: Path, label: str) -> list:
     # bb gate's next cold assign paid a full discovery (20-45 s) again. A content change still moves
     # one of the kept fields: an in-place write sets a new mtime, and a sync that restores the source
     # mtime writes a temp file and renames it (new inode). Only an in-place, same-size rewrite that
-    # then forges the old mtime back goes unseen; nothing on the sync or edit paths does that.
+    # then forges the old mtime back goes unseen (cp -p / rsync --inplace onto an existing file); no
+    # path hermes uses does that (hermes-sync rsync without --inplace, git, pip, editors).
     try:
         st = path.stat()
     except OSError as exc:
diff --git a/tests/hermes_cli/test_plugin_hook_presence_record.py b/tests/hermes_cli/test_plugin_hook_presence_record.py
index b16fc46d979..6533c61cc88 100644
--- a/tests/hermes_cli/test_plugin_hook_presence_record.py
+++ b/tests/hermes_cli/test_plugin_hook_presence_record.py
@@ -239,18 +239,24 @@ def test_metadata_only_sync_pass_keeps_the_record_served(home):
 
 def test_sync_replacing_a_plugin_file_with_its_old_mtime_still_invalidates(home):
     """rsync -a writes changed content to a temp file, renames it over the old one and restores the
-    source mtime: same mtime, maybe same size, new inode. That must still read as a change."""
+    source mtime: same size, same mtime, same dir mtime, new inode. That must still read as a change."""
+    init = home / "plugins" / "bystander" / "__init__.py"
+    before, after = textwrap.dedent(BYSTANDER), textwrap.dedent(OBSERVER)
+    size = max(len(before), len(after)) + 1
+    init.write_text(before + "#" * (size - len(before)))  # same-size content on both sides
     _config(home, ["bystander"])
     tid = _run(home, "setup")["task_id"]
     _run(home, "discover")
     assert "on_kanban_task_updated" not in _hooks_record(home)["hooks"]
-    init = home / "plugins" / "bystander" / "__init__.py"
-    old = init.stat()
+    old, old_dir = init.stat(), init.parent.stat()
     tmp = init.with_name(".__init__.py.tmp")
-    tmp.write_text(textwrap.dedent(OBSERVER))
+    tmp.write_text(after + "#" * (size - len(after)))
     os.utime(tmp, ns=(old.st_atime_ns, old.st_mtime_ns))
     os.replace(tmp, init)
-    assert init.stat().st_mtime_ns == old.st_mtime_ns
+    os.utime(init.parent, ns=(old_dir.st_atime_ns, old_dir.st_mtime_ns))
+    new = init.stat()
+    assert (new.st_size, new.st_mtime_ns, init.parent.stat().st_mtime_ns) == (old.st_size, old.st_mtime_ns, old_dir.st_mtime_ns)
+    assert new.st_ino != old.st_ino
     out = _run(home, "assign", task_id=tid, profile="bob")
     assert out["assigned"] is True and out["sweeps"] == 1
     assert _observed(home) == [{"task_id": tid, "changed_fields": ["assignee"]}]
