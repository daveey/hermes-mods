From 556fba5f337ec0213eba02c6bb0f9b26822108d8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 07:45:19 +0000
Subject: [PATCH] fix(plugins): retry suppressed tree metadata failures during
 discovery [daveey]

Independent review found Path.is_file suppresses OSError in Python 3.14 after successful scope fingerprinting. Use explicit stat to preserve unknown failure versus known absence. Real-file public-consumer permission and generic OS error probes fail on scoped recovery before this change and pass after; unscoped controls remain green. Four canonical suites pass 165 tests and full scripts/check passes.
---
 hermes_cli/plugin_catalog.py                  | 10 +++++-
 .../hermes_cli/test_plugin_discovery_reads.py | 32 +++++++++++++++++++
 2 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/plugin_catalog.py b/hermes_cli/plugin_catalog.py
index 2fc0efc5bf..38db58d046 100644
--- a/hermes_cli/plugin_catalog.py
+++ b/hermes_cli/plugin_catalog.py
@@ -250,8 +250,16 @@ def load_catalog(catalog_dir: Optional[Path] = None) -> list[PluginCatalogEntry]
 
 def _read_removed_list(catalog_dir: Optional[Path] = None) -> Optional[list[RemovedEntry]]:
     """Keep failed reads distinct from a successfully empty or missing tree list."""
+    from stat import S_ISREG
+
     path = (catalog_dir or get_catalog_dir()) / "removed.yaml"
-    if not path.is_file():
+    try:
+        regular = S_ISREG(path.stat().st_mode)
+    except FileNotFoundError:
+        return []
+    except OSError:
+        return None
+    if not regular:
         return []
     data = _read_yaml(path)
     if data is None:
diff --git a/tests/hermes_cli/test_plugin_discovery_reads.py b/tests/hermes_cli/test_plugin_discovery_reads.py
index 48bc9ba6d5..35e7aa6e1d 100644
--- a/tests/hermes_cli/test_plugin_discovery_reads.py
+++ b/tests/hermes_cli/test_plugin_discovery_reads.py
@@ -124,6 +124,38 @@ def test_failed_stat_is_not_memoized(tmp_path, monkeypatch, source):
         assert catalog._removal_reads.get() == {}
 
 
+@pytest.mark.parametrize('scoped', [False, True])
+@pytest.mark.parametrize('failure', [PermissionError, OSError])
+def test_tree_reader_stat_failure_retries(tmp_path, monkeypatch, scoped, failure):
+    from contextlib import nullcontext
+    from hermes_cli.plugins_cmd_catalog import installed_plugin_removal
+
+    tree = tmp_path / 'catalog'
+    tree.mkdir()
+    removed = tree / 'removed.yaml'
+    removed.write_text('removed: [{name: recalled}]')
+    monkeypatch.setattr(catalog, 'get_catalog_dir', lambda: tree)
+    monkeypatch.setattr(catalog, '_live_cache_path', lambda: tmp_path / 'absent.json')
+    import os
+    original = os.stat
+    calls = []
+    fail_at = 2 if scoped else 1  # after the scope's successful fingerprint stat
+
+    def flaky_stat(path, *args, **kwargs):
+        if Path(path) == removed:
+            calls.append(removed)
+            if len(calls) == fail_at:
+                raise failure('transient tree metadata failure')
+        return original(path, *args, **kwargs)
+
+    monkeypatch.setattr(os, 'stat', flaky_stat)
+    with catalog.removal_read_scope() if scoped else nullcontext():
+        assert installed_plugin_removal('ordinary', tmp_path) is None
+        assert len(calls) == fail_at, 'fault must be injected'
+        assert installed_plugin_removal('recalled', tmp_path) is not None
+        assert installed_plugin_removal('recalled', tmp_path) is not None
+
+
 def test_missing_catalogs_are_memoized(tmp_path, monkeypatch):
     monkeypatch.setattr(catalog, '_live_cache_path', lambda: tmp_path / 'missing.json')
     monkeypatch.setattr(catalog, 'get_catalog_dir', lambda: tmp_path)
