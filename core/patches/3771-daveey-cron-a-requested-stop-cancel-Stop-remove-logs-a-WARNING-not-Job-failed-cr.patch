 cron/scheduler.py                         |  44 +++++---
 tests/cron/test_requested_stop_logging.py | 124 ++++++++++++++++++++++
 tests/cron/test_shutdown_interrupt.py     |   6 +-
 tests/gateway/test_session_cron.py        |   2 +-
