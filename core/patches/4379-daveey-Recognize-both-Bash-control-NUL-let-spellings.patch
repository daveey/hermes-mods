From 303a46fb73584ecd7f5054d93c37fa0cedfe2811 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:59:39 +0000
Subject: [PATCH] [daveey] Recognize both Bash control-NUL let spellings

Control-backtick truncates its ANSI-C piece just like control-@. Preserve concatenation and escaped-quote framing. Proof: six real-Bash/lifecycle regressions fail before the fix; 160 focused tests pass after it, with one existing xfail and word-quotes DATA unchanged.
---
 tests/cron/test_lifecycle_guard_arith_let_word.py | 7 +++++++
 tools/shell_let_word.py                           | 3 ++-
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/tests/cron/test_lifecycle_guard_arith_let_word.py b/tests/cron/test_lifecycle_guard_arith_let_word.py
index cedb08ac04d2cbae6b6076c5066052b24f4ab084..4f04b567d0f2be5d0d99a921bb40dca1a28dcff9 100644
--- a/tests/cron/test_lifecycle_guard_arith_let_word.py
+++ b/tests/cron/test_lifecycle_guard_arith_let_word.py
@@ -18,6 +18,9 @@ from tools.shell_let_word import hidden_let_end
 
 # NUL truncates only its ANSI-C piece, not subsequent quoted/literal pieces.
 REVIEW_SINKS = [
+    r"$'let\c`ignored' 'a[$(SCRIPT)]=1'",
+    r"$'le\c`ignored't 'a[$(SCRIPT)]=1'",
+    r"$'le\c`ignored\'still ignored't 'a[$(SCRIPT)]=1'",
     r"$'let\0ignored' 'a[$(SCRIPT)]=1'",
     r"$'le\x00ignored't 'a[$(SCRIPT)]=1'",
     r"$'le\u0000ignored't 'a[$(SCRIPT)]=1'",
@@ -76,6 +79,10 @@ PRINTED = [
 # Bash runs none of these: no word is `let` after quote removal, or none of its operands
 # holds a subscript substitution.
 DATA = [
+    r"$'let\c`ignored'x 'a[$(SCRIPT)]=1' 2>/dev/null",
+    r"$'le\c`ignored' 'a[$(SCRIPT)]=1' 2>/dev/null",
+    r"$'let\cAignored' 'a[$(SCRIPT)]=1' 2>/dev/null",
+    r"$'let\caignored' 'a[$(SCRIPT)]=1' 2>/dev/null",
     r"$'let\0ignored'x 'a[$(SCRIPT)]=1' 2>/dev/null",
     r"$'lex\0let' 'a[$(SCRIPT)]=1' 2>/dev/null",
     r"$'letx\0' 'a[$(SCRIPT)]=1' 2>/dev/null",
diff --git a/tools/shell_let_word.py b/tools/shell_let_word.py
index 2a55685953e61dd8d0cba9e8568436cd9489322d..1ce158aea44c5c660397fad026cb1ce671a76519 100644
--- a/tools/shell_let_word.py
+++ b/tools/shell_let_word.py
@@ -118,7 +118,8 @@ def _ansi_c_piece(command: str, pos: int) -> tuple[str | None, int]:
                 out.append(chr(value) if value <= 0x10FFFF else "\ufffd")
             index = numeric.end()
             continue
-        if command.startswith("\\c@", index):
+        # Bash folds ASCII case before XOR 0x40: both @ and ` produce NUL.
+        if command.startswith(("\\c@", "\\c`"), index):
             truncated = True
             index += 3
             continue
-- 
