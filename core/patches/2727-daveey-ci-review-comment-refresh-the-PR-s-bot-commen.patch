+# Fork PRs are skipped.
 
 on:
   schedule:
     - cron: "17 * * * *"
   workflow_dispatch:
+  workflow_run:
+    workflows: [CI]
+    types: [completed]
+    branches: ["wt/**"]
 
 permissions:
   contents: read
   actions: read
   pull-requests: write
 
-# One batch at a time; a running batch is never cancelled.
+# One batch at a time; a running batch is never cancelled. A targeted refresh
+# has its own group per head sha: in a shared group GitHub keeps only the newest
+# pending run and cancels the others, which would drop another PR's refresh.
 concurrency:
-  group: ci-review-comment
+  group: ci-review-comment${{ github.event_name == 'workflow_run' && format('-{0}', github.event.workflow_run.head_sha) || '' }}
   cancel-in-progress: false
 
 jobs:
   comment:
-    name: CI review comment (hourly)
+    name: CI review comment
+    if: >-
+      github.event_name != 'workflow_run' || (
+        github.event.workflow_run.event == 'pull_request' &&
+        github.event.workflow_run.head_repository.full_name == github.repository &&
+        (github.event.workflow_run.conclusion == 'success' || github.event.workflow_run.conclusion == 'failure')
+      )
     runs-on: blacksmith-2vcpu-ubuntu-2404
     timeout-minutes: 15
     steps:
@@ -39,6 +65,9 @@ jobs:
       - name: Post batched review summaries
         env:
           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
