From ff0feb5d2e5bd01a56073ca58164c83971b84af9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 17:16:22 +0000
Subject: [PATCH] fix(kanban): resolve text obligations against model catalog
 [daveey]

Problem: common create refused plugin-catalog subjects, completed-review provenance, execution receipts and conditional code specifications carrying no card-route mandate.

Root (happened): prefix identity guesses and unscoped named-review/use/pin searches conflated model routing obligations with unrelated source data. Root (not caught): previous producer controls omitted real ship range-diff subjects and authentic provenance strings.

Countermeasure: use offline shipped catalog identities, scope imperative matching, retain explicit mandatory review controls and report offending lines. Unchanged independent probe RED 9 failed / 3 passed; final five focused files 82 passed, retries disabled; importing/facade consumers and full scripts/check passed. No fleet mutation, quota bypass or delivery completion claim. Fresh exact-head CI and independent review remain required.
---
 hermes_cli/kanban_model_neutral.py            | 35 +++++--
 .../test_kanban_model_neutral_review41.py     | 98 +++++++++++++++++++
 2 files changed, 125 insertions(+), 8 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_model_neutral_review41.py

diff --git a/hermes_cli/kanban_model_neutral.py b/hermes_cli/kanban_model_neutral.py
index 36198c2e90..a16f0f2bb7 100644
--- a/hermes_cli/kanban_model_neutral.py
+++ b/hermes_cli/kanban_model_neutral.py
@@ -13,13 +13,24 @@ from agent.model_routing import is_class_selector
 ERROR = 'Kanban is model-neutral: use a class/tier or capability requirement, not a concrete model/provider or mandatory pin'
 # Match directives, not incidental named execution evidence or author exclusions.
 _REQUIRED = re.compile(r'^\s*require_model\s*:\s*(?:true|yes|1)\s*$', re.IGNORECASE | re.MULTILINE)
-_MODEL = re.compile(r'(?:\b|(?<=independent)|(?<=primary))(?:gpt-[\w.-]+|claude-[\w.-]+|grok-[\w.-]+|gemini-[\w.-]+|opus|sonnet|fable|astra|luna|sol)\b', re.IGNORECASE)
+def _model_names():
+    """Offline catalog identity, not vendor-prefix guesses or live entitlement."""
+    from hermes_cli.models_catalog_static import _PROVIDER_MODELS
+    names = {name.lower().rsplit('/', 1)[-1] for rows in _PROVIDER_MODELS.values() for name in rows}
+    # These are human shorthand for catalog families, not arbitrary claude-* tools.
+    aliases = {alias for alias in ('opus', 'sonnet', 'fable', 'astra', 'luna', 'sol')
+               if any(alias in re.split(r'[-.]', name) for name in names)}
+    return '|'.join(re.escape(name) for name in sorted(names | aliases, key=lambda name: (-len(name), name)))
+
+
+_MODEL = re.compile(r'(?:\b|(?<=independent)|(?<=primary))(?:' + _model_names() + r')(?![\w-]|\.[\w])', re.IGNORECASE)
 # Bind the obligation to the route, rather than co-occurrence with unrelated
 # words such as "required CI", "source only" or a tool-call bug report.
 _QUALIFIER = r'(?:(?:the|a|an|only|model|provider|route|reviewer|review|independent|primary|exact[- ]head|on|to|with|use|using|run|by)\s+)*'
 _ROUTE_NAME = r'(?:[\w-]+/)?' + _MODEL.pattern
 _DIRECTIVE = re.compile(
-    r'\b(?:must|require|requires|required|mandatory|use|select|choose|pin|pinned|restrict|no fallback for)\s+'
+    r'(?:\b(?:must|require|requires|required|mandatory|no fallback for)\s+'
+    r'|(?:^|:)\s*(?:[-*]\s*)?(?:use|select|choose|pin|restrict)\s+)'
     + _QUALIFIER + _ROUTE_NAME
     + r'|' + _ROUTE_NAME + r'(?:/[\w-]+)?\s+(?:(?:review\s+|is\s+)?(?:required|mandatory|only)\b|must\s+be\s+used\b)',
     re.IGNORECASE,
@@ -61,7 +72,7 @@ def validate_text(*values):
         for line in (text or '').splitlines():
             line = _active_text(line)
             if _REQUIRED.search(line):
-                raise ValueError(ERROR)
+                raise ValueError(f'{ERROR}; refused line: {line}')
             if line.lstrip().startswith('<!-- implementer-models:'):
                 continue
             for clause in re.split(r'(?<=[.!?;])\s+', line):
@@ -86,11 +97,19 @@ def validate_text(*values):
                     clause, re.IGNORECASE,
                 ):
                     continue
-                named_review = re.search(
-                    r'(?:primary|independent|exact[- ]?head)[ -]*(?:opus|sonnet|fable|astra|luna|sol)\b'
-                    r'|\breview\s*\((?:claude-|gpt-|grok-|gemini-)', clause, re.IGNORECASE)
-                if _DIRECTIVE.search(clause) or named_review:
-                    raise ValueError(ERROR)
+                # A bare requested-review title is operative; a sentence that
+                # merely attributes a completed review is not. Do not scan for
+                # "independent Opus" anywhere inside arbitrary provenance prose.
+                named_review = re.fullmatch(
+                    r'\s*(?:(?:primary|independent|exact[- ]?head)[ -]*)+'
+                    + _MODEL.pattern + r'\s+(?:exacthead\s+)?review(?:\s+required)?'
+                    r'(?:\s*[,;+].*)?[.!]?\s*', clause, re.IGNORECASE)
+                required_review = re.search(
+                    r'\b(?:needs?|requires?|must get)\s+(?:a\s+)?(?:fresh\s+)?'
+                    r'(?:independent\s+)?review\s*\(\s*' + _ROUTE_NAME,
+                    clause, re.IGNORECASE)
+                if _DIRECTIVE.search(clause) or named_review or required_review:
+                    raise ValueError(f'{ERROR}; refused line: {line}')
 
 
 def forwarded_text(text):
diff --git a/tests/hermes_cli/test_kanban_model_neutral_review41.py b/tests/hermes_cli/test_kanban_model_neutral_review41.py
new file mode 100644
index 0000000000..7af0c5e351
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_model_neutral_review41.py
@@ -0,0 +1,98 @@
+"""Reviewer probe 3 (not part of the PR): create_task with text that names a route/plugin but carries no card-route mandate.
+
+Strings are copied from live board rows or origin/main commit subjects. Controls are real mandates.
+"""
+from __future__ import annotations
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from tests.hermes_cli import test_kanban_containment_lifecycle as chelpers
+
+board = chelpers.board
+
+NOT_MANDATES = [
+    # origin/main commit subjects (ship copies subjects into review-card bodies via range-diff)
+    ("subject_gemini_live", "feat(plugin-catalog): pin gemini-live to the latest commit"),
+    ("subject_directsdk", "chore(catalog): pin claude-subscription-directsdk to 0.3.4"),
+    # tool / plugin names, not models
+    ("claude_code_skill", "Use the claude-code skill to delegate the refactor."),
+    # provenance copied from live cards
+    ("followup_from_review", "Non-blocking follow-up from independent Opus review of state PR3204 exact 89c9a9fa8c."),
+    ("previous_review", "Previous exact-head Opus review t_f0af40fb3ddcdf92 approved, ran 39 tests, but ship refused it."),
+    ("review_done", "exact-head validate and independent Opus review (APPROVE) done."),
+    ("canary_evidence", "The canary card t_a1d5f9ad509e0cc2 (pinned gpt-6-astra/openai-codex by `canary_pin`) was never claimed."),
+    ("run_receipt", "Actual session local-962f pinned anthropic/claude-opus-5-5 exact_pin=true fallback_active=false."),
+    # implementation spec for code under change, not for the card's route
+    ("code_spec", "If the config names no fast model, use claude-haiku-5-5 and record it."),
+]
+MANDATES = [
+    ("mandate_must", "This review MUST run claude-opus-5-5/anthropic, mandatory pin."),
+    ("mandate_required", "Independent primary Opus review required"),
+    ("mandate_directive", "require_model: true"),
+]
+
+
+@pytest.mark.parametrize("text", [t for _n, t in NOT_MANDATES], ids=[n for n, _t in NOT_MANDATES])
+def test_non_mandate_body_creates(board, text):
+    tid = kb.create_task(board, title="Follow-up card", body=f"Context for the worker.\n{text}\nMore context.", assignee="default")
+    assert board.execute("SELECT body FROM tasks WHERE id=?", (tid,)).fetchone()[0].count(text) == 1
+
+
+@pytest.mark.parametrize("text", [t for _n, t in MANDATES], ids=[n for n, _t in MANDATES])
+def test_mandate_refused_no_write(board, text):
+    before = board.execute("SELECT COUNT(*) FROM tasks").fetchone()[0]
+    with pytest.raises(ValueError):
+        kb.create_task(board, title="Review card", body=text, assignee="default")
+    assert board.execute("SELECT COUNT(*) FROM tasks").fetchone()[0] == before
+
+
+@pytest.mark.parametrize('subject', [text for _name, text in NOT_MANDATES[:2]])
+def test_ship_range_diff_creates_review_with_literal_subject(board, subject):
+    body = (
+        'Independent exact-head review. Keep required CI and normal landing gates.\n'
+        'Canonical clean rebase range-diff:\n```\n'
+        f'1: abcdef12 = 1: 123456ab {subject}\n```\n'
+        'Read the complete diff and return an evidence-backed verdict.'
+    )
+    tid = kb.create_task(board, title='Independent exact-head review', body=body)
+    stored = kb.get_task(board, tid)
+    assert stored.body == body
+    assert stored.model_override is None and stored.provider_override is None
+
+
+@pytest.mark.parametrize('text', [text for _name, text in MANDATES])
+def test_refusal_identifies_exact_line(board, text):
+    with pytest.raises(ValueError) as error:
+        kb.create_task(board, title='Review card', body='Context\n' + text)
+    assert 'refused line: ' + text in str(error.value)
+
+
+@pytest.mark.parametrize('text', [
+    'Use claude-code to inspect the implementation.',
+    'Use gemini-live for the speech integration.',
+    'Pin claude-opus-5-5-plugin to a commit.',
+    'Use gpt-6-luna-helper to format the report.',
+    'Use claude-opus-5-5.extra as the fixture string.',
+    'Independent Opus review (APPROVE) done.',
+    'Independent Opus review t_fixture approved; retain that audit receipt.',
+    'If the config has no fast model, use claude-haiku-5-5 and record it; use the class registry for this card.',
+])
+def test_non_route_context_not_mandatory(board, text):
+    tid = kb.create_task(board, title='Implementation context', body=text)
+    assert kb.get_task(board, tid).body == text
+
+
+@pytest.mark.parametrize('text', [
+    'Use claude-opus-5-5.',
+    'Use claude-opus-5-5/anthropic.',
+    'Use anthropic/claude-opus-5-5.',
+    'Use grok-4.6.',
+    'Use gpt-6-luna.',
+    'Use only claude-opus-5-5; keep required CI.',
+])
+def test_catalog_model_obligation_is_not_tool_name(board, text):
+    before = board.execute('SELECT COUNT(*) FROM tasks').fetchone()[0]
+    with pytest.raises(ValueError, match='refused line:'):
+        kb.create_task(board, title='Review instruction', body=text)
+    assert board.execute('SELECT COUNT(*) FROM tasks').fetchone()[0] == before
