From 49f0ccd4a5ef33ef7505d37d8de20c58cc9f954c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 18:35:03 +0000
Subject: [PATCH] [daveey] placement: linear cd-home .hermes scan; pushd home
 and commented cd count

Follow-up to PR #2460 review 5895876398 nits 1-3 (hermes_cli/kanban_placement.py HERMES_STATE_PATH).

1. Performance: the `_CD_HOME [\s\S]*? .hermes/` arm rescanned to the end of the text from every cd home
   when no `.hermes/` followed: O(#cd-home x length). 20000 `cd ~ && make` lines took ~37 s per re.search,
   so a pasted shell transcript could stall kanban_create. The span is now a tempered token that stops at
   the next cd home (which starts its own scan), so the total scan is O(length): the same 20000-line body
   classifies three times in ~0.1 s. Match results are unchanged (a .hermes/ after several cd homes is
   still found from the last one).
2. Missed marker (misplacement only; hub-read still enforces READ_ROOTS): `pushd <home>` is a cd-home form,
   and the cd/pushd may end in a trailing shell comment (`cd ~ # go home`) or a redirect
   (`pushd $HOME >/dev/null`). A bare `pushd` (stack swap) and `cd ~#x` (a literal dir) do not count.
3. `cd`/`pushd` must be lowercase words (`(?-i:...)`), so prose "Burn a CD" / "CD ~" no longer counts.
   The `_state_path` fallback names a relative hit as its `~/.hermes/<path>` instead of repr()ing the whole
   cd..path span into the placement note; as a `~/` path it also gets the same own-artifact probe.

RED (on PR #2460 head fcfe28583f, patch-identical to main 907d09c9f6): 9 failures in the new rows of
tests/hermes_cli/test_kanban_state_path_home_forms.py (5 pushd/comment pins, 2 prose CD, the timing test,
the clipped hit). GREEN: 88 placement/importer files, 2582 passed, 0 failed.
---
 hermes_cli/kanban_home_marker_placement.py    |  7 ++-
 hermes_cli/kanban_placement.py                |  9 +++-
 .../test_kanban_state_path_home_forms.py      | 44 +++++++++++++++++++
 3 files changed, 56 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_home_marker_placement.py b/hermes_cli/kanban_home_marker_placement.py
index 7afc58f32d..39d45dd664 100644
--- a/hermes_cli/kanban_home_marker_placement.py
+++ b/hermes_cli/kanban_home_marker_placement.py
@@ -31,6 +31,7 @@ _WT_ROOT = re.compile(_HOME + r"/code/_wt(?:-[\w-]+)?/[\w-]+(?:\.[\w-]+)*")
 _DOT_WT_ROOT = re.compile(_HOME + r"/(?:[^/\s`'\"]+/)*\.worktrees/[\w-]+(?:\.[\w-]+)*")
 _CLAUDE_WT_ROOT = re.compile(r"(?:~|/)[^\s`'\"]*/\.claude/worktrees/[\w-]+(?:\.[\w-]+)*")
 _STATE = re.compile(_HOME + r"/\.hermes/[^\s`'\"<>()\[\]]*")
+_REL_STATE = re.compile(r"\.hermes/[^\s`'\"<>()\[\]]*", re.IGNORECASE)
 # This worker's own unpublished files: a card's workspace, evidence or attachments, or a scratch file.
 _ARTIFACT = re.compile(r"/\.hermes/(kanban/(?:workspaces|evidence|attachments)|cache/scratch)/([^/\s]+)")
 
@@ -119,11 +120,13 @@ def _worktree(pattern, match, gateway, probe):
 
 def _state_path(pattern, match, gateway, probe):
     from hermes_cli import kanban_placement as kp
-    # ``$HOME``/``${HOME}`` prefixes too (kp.HOME_PREFIX); a relative path after a cd home falls back to the hit.
+    # ``$HOME``/``${HOME}`` prefixes too (kp.HOME_PREFIX). A relative path after a cd home is named as its ``~/``
+    # path, not the whole cd..path span the hit covers (review 5895876398).
     state = re.compile(kp.HOME_PREFIX + _STATE.pattern[len(_HOME):])
     paths = [p for p in (_clean(m.group(0)) for m in state.finditer(match.string))
              if re.match(kp.HERMES_STATE_PATH, p)]
-    for raw in dict.fromkeys(paths) or [match.group(0)]:
+    rel = _REL_STATE.match(match.string, match.start() + match.group(0).lower().rfind(".hermes/"))
+    for raw in dict.fromkeys(paths) or [_clean("~/" + rel.group(0)) if rel else match.group(0)]:
         if art := _ARTIFACT.search(raw):
             # health: allow HX001 -- the card text names ~/.hermes literally; probe that same path on this worker
             if (Path.home() / ".hermes" / art.group(1) / art.group(2)).exists():
diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index d80af233ec..7f239b2622 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -578,9 +578,14 @@ def _heavy_marker(title: str, body: str, cfg: _Cfg) -> Optional[str]:
 # The home prefix also takes ``$HOME``/``${HOME}``, bare or double-quoted, and a relative ``.hermes/`` path counts after
 # a ``cd`` to home (``cd``, ``cd ~``, ``cd $HOME``, ``cd /home/<u>``) anywhere earlier in the text (PR #2405 review
 # 5894942332 nit). A later cd elsewhere is not tracked: such text still pins (fails toward the home gateway).
+# ``pushd <home>`` counts too, and the cd may end in a shell comment; ``cd``/``pushd`` are lowercase words (a prose
+# "CD" is not one) and a bare ``pushd`` only swaps the stack (review 5895876398). The scan from a cd home stops at
+# the next cd home (that one starts its own scan), so a transcript of N ``cd ~`` lines costs O(length), not
+# O(N x length): 20000 such lines took 37 s per search before.
 HOME_PREFIX = r"(?:~|/home/[^/\s]+|\$HOME\b|\$\{HOME\}|\"\$HOME\"|\"\$\{HOME\}\")"
-_CD_HOME = r"(?<![\w./-])cd(?:[ \t]+" + HOME_PREFIX + r"/?)?(?=[ \t]*(?:$|[\n;&|)]))"
-HERMES_STATE_PATH = (r"(?:" + HOME_PREFIX + r"/|" + _CD_HOME + r"[\s\S]*?(?<![\w./~$}-]))"
+_CD_HOME = (r"(?<![\w./-])(?-i:cd(?:[ \t]+" + HOME_PREFIX + r"/?)?|pushd[ \t]+" + HOME_PREFIX + r"/?)"
+            r"(?=[ \t]*(?:$|[\n;&|)>])|[ \t]+#)")
+HERMES_STATE_PATH = (r"(?:" + HOME_PREFIX + r"/|" + _CD_HOME + r"(?:(?!" + _CD_HOME + r")[\s\S])*?(?<![\w./~$}-]))"
                      r"\.hermes/(?!(?:hermes-agent|repos|bin)(?:/|\b))[\w.-]")
 HOST_WORKTREE_PATH = r"(?:~|/home/[^/\s]+)/code/_wt(?:-[\w-]+)?(?:/|\b)"
 # Any home-rooted ``<dir>/.worktrees`` (``~/code/<repo>/.worktrees/t_*``, ``~/.hermes/hermes-agent/.worktrees``):
diff --git a/tests/hermes_cli/test_kanban_state_path_home_forms.py b/tests/hermes_cli/test_kanban_state_path_home_forms.py
index 5b05bd2449..39f1c2a7f3 100644
--- a/tests/hermes_cli/test_kanban_state_path_home_forms.py
+++ b/tests/hermes_cli/test_kanban_state_path_home_forms.py
@@ -5,6 +5,7 @@ PR #2405 review 5894942332 nit: :data:`hermes_cli.kanban_placement.HERMES_STATE_
 ``hub:read`` must not clear the new forms either: only ``~``/``/home/<u>`` paths under its roots are cleared.
 """
 import re
+import time
 
 import pytest
 
@@ -74,3 +75,46 @@ def test_declared_hub_read_does_not_clear_home_forms(attested, body):
 def test_tilde_root_path_still_clears(attested):
     cfg, _, _ = attested
     assert roots.reason("ssh hermes-hub cat ~/.hermes/logs/x.log", cfg) is None
+
+
+# PR #2460 review 5895876398 nits 1-3: a pushd home and a cd home with a trailing shell comment are cd-home forms
+# too; a prose "CD", a bare pushd (it swaps the stack, it does not go home) and a ``cd ~#x`` word are not.
+@pytest.mark.parametrize("body", [
+    "cd ~ # comment\ncat .hermes/.env",
+    "cd # go home\ncat .hermes/.env",
+    "pushd ~ && cat .hermes/.env",
+    "pushd $HOME >/dev/null; cat .hermes/.env",
+    "pushd /home/ubuntu\ncat .hermes/state.db",
+])
+def test_pushd_and_commented_cd_home_are_state_paths(body):
+    assert _hit(body)
+
+
+@pytest.mark.parametrize("body", [
+    "Burn a CD\ncat .hermes/.env",
+    "CD ~ && cat .hermes/.env",
+    "pushd && cat .hermes/.env",
+    "cd ~#x && cat .hermes/.env",
+    "popd ~ && cat .hermes/.env",
+])
+def test_prose_cd_and_non_home_pushd_stay_portable(body):
+    assert not _hit(body)
+
+
+def test_many_cd_home_lines_without_a_state_path_scan_in_linear_time():
+    # A pasted shell transcript: before the fix each ``cd ~`` scanned to the end of the text (20000 lines: ~37 s).
+    body = "cd ~ && make\n" * 20000
+    start = time.perf_counter()
+    assert not _hit(body)
+    assert not _hit(body + "cat src/.hermes/x\n")
+    assert _hit(body + "cat .hermes/.env\n")
+    assert time.perf_counter() - start < 0.5
+
+
+def test_relative_state_path_hit_is_the_home_path_not_the_cd_span():
+    from hermes_cli import kanban_home_marker_placement as hm
+
+    match = _hit("cd ~ && make all && cat .hermes/logs/x.log")
+    [(decision, cls, hit, labels, note)] = hm._state_path(kp.HERMES_STATE_PATH, match, "worker-2", hm._Probe())
+    assert (decision, cls, hit, labels) == ("queue", "b", "~/.hermes/logs/x.log", ("capability:hub-write",))
+    assert "make all" not in note
