From d0a398c0e7d38627437775aa13ba1b0ec9886a9b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 00:48:59 +0000
Subject: [PATCH] [daveey] fix(kanban): a required-check name is not a macOS
 marker

Ship's review body quotes the required checks ("CI at filing: green:
macOS state required (v1): success; ..."). MACOS_MARKER read the check
name as Mac work, so every ship-filed review card stayed on its filing
pool worker, and on the hub went through the admission judge.

One negative lookahead: the OS word followed by " state required" no
longer matches. APPLE_CONTEXT_MARKERS reuses the pattern on purpose.
Tests run the real ship review card text (t_01a1d2434cf3676c) through
the pool-worker and hub placement decisions.
---
 hermes_cli/kanban_placement.py                |  6 ++-
 .../ship_review_card_t_01a1d2434cf3676c.json  |  5 ++
 tests/hermes_cli/test_kanban_placement.py     | 52 +++++++++++++++++++
 3 files changed, 61 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/fixtures/ship_review_card_t_01a1d2434cf3676c.json

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 1ec315f7fb..d64d59895c 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -90,8 +90,10 @@ DEFAULT_HUB_LIVE_SECONDS = 600
 DEFAULT_CREATOR_SESSION = "kanban-placement"
 
 # "macOS" as a word, not a CI runner label or file/skill name (macos-latest, macos-release,
-# hermes-state-macos.yml): a GitHub-hosted macOS job runs on GitHub, not on this Mac.
-MACOS_MARKER = r"(?<![\w/.-])mac ?os(?![\w/-]|\.\w)"
+# hermes-state-macos.yml): a GitHub-hosted macOS job runs on GitHub, not on this Mac. Nor the required-check
+# name "macOS state required (v1)": ship's review body quotes it ("CI at filing: ..."), which kept every
+# ship-filed review card on its filing worker. APPLE_CONTEXT_MARKERS reuses this on purpose.
+MACOS_MARKER = r"(?<![\w/.-])mac ?os(?![\w/-]|\.\w)(?! state required\b)"
 # Example App the product, named in the TITLE (see TITLE_ONLY_LOCAL_MARKERS) and not as part of a skill,
 # repo or path name (myapp-ship-and-ops, me/myapp, ~/code/myapp-h4): the BB repo is
 # checked out on the hub and its devices are reached over ssh:mini, so a body that loads a BB skill
diff --git a/tests/hermes_cli/fixtures/ship_review_card_t_01a1d2434cf3676c.json b/tests/hermes_cli/fixtures/ship_review_card_t_01a1d2434cf3676c.json
new file mode 100644
index 0000000000..2b6fcc58c7
--- /dev/null
+++ b/tests/hermes_cli/fixtures/ship_review_card_t_01a1d2434cf3676c.json
@@ -0,0 +1,5 @@
+{
+ "source": "t_01a1d2434cf3676c (worker-2, created 2026-11-13T00:16:28Z) via cross_task read on hermes-hub",
+ "title": "Independent exact-head review PR #1750 @86efb897d7 (core-wt ship review required)",
+ "body": "Independent exact-head review of https://github.com/example-org/hermes/pull/1750 at **86efb897d730b59ad4c06fa6191720027a5f92ad**.\nCI at filing: green: macOS state required (v1): success; All required checks pass (v2): success.\nRequired CI passed before filing.\n\nThe current head is 86efb897d730b59ad4c06fa6191720027a5f92ad; the earlier head is 6e765497c6a77aa0d6ffb54a46bb8069973f303f. The earlier review does not authorize landing the current head.\nThis review request does not establish a clean ship rebase or patch identity; the earlier head or\nrange-diff may be unreadable. Review every commit at the current head, including any added commits.\nThe ship gate lands only a head approved at its exact sha. This card was filed by ship; the landing session must not be the one reviewing.\n\nReview the PR as it is at that sha (diff against its base, the tests, the CI result). Trace the logic and\nreport what you observe. The range-diff below compares the previously reviewed commits with these; '=' means\nan identical patch, '!' a changed one. Verdicts: 2 '='.\n\nFinish with kanban_complete metadata exactly:\n  {\"verdict\": \"approve\" | \"request_changes\", \"reviewed_sha\": \"86efb897d730b59ad4c06fa6191720027a5f92ad\", \"reviewed_pr\": \"https://github.com/example-org/hermes/pull/1750\"}\nAn approval of any other sha, or a summary without that metadata, approves nothing.\nAdd `findings` (a list of strings) where each non-blocking point starts with \"Nit (non-blocking):\", and\nalso post it on the PR (a COMMENT review): ship refuses to land until the PR thread answers each one.\n\n```\n$ git range-diff 6e765497c6a7...86efb897d730 (each over its fork point from origin/main)\n1:  52ede0b6af = 1:  1f4e0fca0c [daveey] Refuse worker pool repins without an eligible machine\n2:  6e765497c6 = 2:  86efb897d7 fix(kanban): refuse pool repins using stale registry fallback [daveey]\n```"
+}
\ No newline at end of file
diff --git a/tests/hermes_cli/test_kanban_placement.py b/tests/hermes_cli/test_kanban_placement.py
index ac79c7cbeb..4a117d38e9 100644
--- a/tests/hermes_cli/test_kanban_placement.py
+++ b/tests/hermes_cli/test_kanban_placement.py
@@ -9,6 +9,7 @@ from __future__ import annotations
 
 import json
 import os
+import re
 import sqlite3
 import time
 from pathlib import Path
@@ -384,6 +385,57 @@ def test_macos_ci_runner_labels_do_not_pin_the_card():
     assert d["where"] == "local" and "macos" in d["why"], d
 
 
+# --- tool-generated card text: a required-check name is not device context ----------------------
+# 11-12/13: every review card `hermes-core-wt ship --request-review` filed on a pool worker stayed on that
+# worker (t_01a1d1c2ca18df39, t_01a1d2434cf3676c, t_01a1d1fe567955ba): its body quotes the required checks
+# ("CI at filing: green: macOS state required (v1): success; ..."), and MACOS_MARKER read the check name
+# as Mac work. On the hub the same text sent the card to the admission judge. [daveey]
+
+SHIP_REVIEW = json.loads((Path(__file__).parent / "fixtures" /
+                          "ship_review_card_t_01a1d2434cf3676c.json").read_text())
+SHIP_REVIEW_ARGS = {"title": SHIP_REVIEW["title"], "body": SHIP_REVIEW["body"], "assignee": "default",
+                    "priority": 60000, "requires": ["terminal", "git"]}
+POOL = "pool:worker"
+
+
+def test_ship_review_fixture_quotes_the_required_check_name():
+    assert "CI at filing: green: macOS state required (v1): success" in SHIP_REVIEW["body"]
+
+
+def test_ship_review_card_on_a_pool_worker_joins_the_pool_queue():
+    d = kp.decide(dict(SHIP_REVIEW_ARGS), cfg={"worker_queue": {"worker-2": POOL}}, self_gw="worker-2",
+                  live=ALIVE, locate=NOWHERE, info=SILENT, carries=True, machine_ok=lambda name: True)
+    assert POOL in (d.get("runs_on") or []), d
+    assert "local marker" not in d["why"] and not any(v.startswith("machine:") for v in d["runs_on"]), d
+    assert kp.portable_reason(dict(SHIP_REVIEW_ARGS), {"worker_queue": {"worker-2": POOL}}) is None
+
+
+def test_ship_review_card_on_the_hub_is_no_marker_hit_and_never_consults_admission(monkeypatch):
+    from hermes_cli import kanban_hub_admission as judge
+    asked = []
+    monkeypatch.setattr(judge, "admit", lambda fields, **kw: asked.append(fields) or judge.Verdict())
+    cfg = {"worker_queue": {"hub": POOL}}
+    d = kp.decide(dict(SHIP_REVIEW_ARGS), cfg=cfg, self_gw="hub", live=ALIVE, locate=NOWHERE, info=SILENT,
+                  carries=True, machine_ok=lambda name: True)
+    assert asked == [] and POOL in (d.get("runs_on") or []), d
+    assert "marker" not in d["why"], d
+
+
+@pytest.mark.parametrize("text", [
+    "macOS state required (v1)", "MACOS STATE REQUIRED (v2)", "mac os state required", "macOS state required",
+])
+def test_the_required_check_name_is_not_a_macos_marker(text):
+    assert not re.search(kp.MACOS_MARKER, text, re.IGNORECASE)
+
+
+@pytest.mark.parametrize("text", [
+    "macOS state is broken after the update", "macOS required for this repro", "Only on macOS state",
+    "macOS stateful tests fail", "macOS",
+])
+def test_macos_followed_by_other_words_still_matches(text):
+    assert re.search(kp.MACOS_MARKER, text, re.IGNORECASE)
+
+
 # --- liveness -----------------------------------------------------------------------------------
 
 def test_target_live_needs_a_recent_sync_and_a_fresh_target_record():
