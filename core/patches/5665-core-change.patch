From 80cee31f98d6678a5020a08edb18f437b6a53177 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 04:23:40 +0000
Subject: [PATCH] fix(workers): require explicit tool credential opt-in
 [daveey]

Managed worker tool_environment previously treated implicit CLI default tools
as credential authorization, staging unrelated profile tool API keys. Resolve
explicit request/platform toolsets separately, then intersect their tools with
the effective child policy. Keep platform bot/app tokens and Slack/Telegram
credentials with the owner even when their tools are explicitly selected.

Preserve route-key staging and owner-authenticated hydration. Update the
existing web compatibility fixture to declare its opt-in rather than mocking
only the effective catalog.

Proof: original core produced 11 failures in the initial regression matrix.
48 managed-worker/turn and credential-consumer test files: 239 passed.
Eight source mutants killed (default fallback, implicit tools, request
precedence, internal secret, Slack, Telegram, bot and app token exclusions).
Full scripts/check --base origin/main passed.
---
 gateway/session_worker_credentials.py         | 17 +++-
 .../gateway/test_managed_worker_env_compat.py |  4 +-
 .../test_managed_worker_tool_credentials.py   | 97 +++++++++++++++++++
 3 files changed, 114 insertions(+), 4 deletions(-)
 create mode 100644 tests/gateway/test_managed_worker_tool_credentials.py

diff --git a/gateway/session_worker_credentials.py b/gateway/session_worker_credentials.py
index bc785cac5a..1a2f645881 100644
--- a/gateway/session_worker_credentials.py
+++ b/gateway/session_worker_credentials.py
@@ -161,13 +161,24 @@ def hydrate_credentials(frame, rpc):
 
 
 def tool_environment(authority, policy, config):
-    """Only credential requirements of tools selected by the child's frozen policy."""
+    """Only explicitly selected tool credentials; platform delivery stays with the owner."""
     from tools.registry import registry
     from toolsets import resolve_toolset
+    from hermes_cli.toolset_validation import parse_platform_toolsets_value
     from tools.environments.local_env_policy import _is_hermes_internal_secret
-    selected = {name for toolset in policy.current_toolsets(config) for name in resolve_toolset(toolset)}
+    request = json.loads(policy.request_json)
+    platform = 'acp' if policy.source == 'acp' else 'cli'
+    explicit = request.get('toolsets') if 'toolsets' in request else (
+        (config.get('platform_toolsets') or {}).get(platform))
+    explicit = parse_platform_toolsets_value(explicit)
+    if not explicit:
+        return {}
+    permitted = {name for toolset in explicit for name in resolve_toolset(toolset)}
+    selected = {name for toolset in policy.current_toolsets(config) for name in resolve_toolset(toolset)} & permitted
     names = {name for entry in registry.get_all_entries() if entry.name in selected
-             for name in entry.requires_env if isinstance(name, str) and not _is_hermes_internal_secret(name)}
+             for name in entry.requires_env if isinstance(name, str) and not _is_hermes_internal_secret(name)
+             and not name.upper().startswith(('SLACK_', 'TELEGRAM_'))
+             and not name.upper().endswith(('_BOT_TOKEN', '_APP_TOKEN'))}
     values = _profile_values(authority, policy)
     return {name: values[name] for name in names if values.get(name) is not None}
 
