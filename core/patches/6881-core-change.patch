diff --git a/tests/hermes_cli/test_kanban_replay_sender_process.py b/tests/hermes_cli/test_kanban_replay_sender_process.py
new file mode 100644
index 0000000000000000000000000000000000000000..2f889ba3afae0cd6b96e13d1d0f9c1456349a8fa
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_replay_sender_process.py
@@ -0,0 +1,140 @@
+"""Independent-process sender occupancy through a real HTTP session. [daveey]"""
+import json
+import multiprocessing
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli import kanban_db_sync as sync, kanban_sync_client as client
+from hermes_cli.kanban_sync_guard import SyncRoundBusy, board_sync_lock
+from tests.hermes_cli import test_kanban_replay_sender as helpers
+
+live = helpers.live
+
+
+def _send(path, url, results):
+    conn = kbc.connect(path)
+    try:
+        hub = client.Hub(client.Identity(url, 'fixture-key', 'macbook'))
+        result = client.push(conn, hub, 'default', 'macbook', primary=False, max_batches=1)
+        results.put(('ok', result.applied))
+    except (OSError, ValueError, RuntimeError, client.HubError) as exc:
+        results.put(('error', str(exc)))
+        raise
+    finally:
+        conn.close()
+
+
+class Peer:
+    def __init__(self, stage):
+        self.receiver = helpers.Receiver()
+        self.entered = threading.Event()
+        self.release = threading.Event()
+        peer = self
+
+        class Handler(BaseHTTPRequestHandler):
+            def do_GET(self):
+                self.reply('GET')
+
+            def do_POST(self):
+                self.reply('POST')
+
+            def reply(self, method):
+                assert self.headers.get('Authorization') == 'Bearer fixture-key'
+                length = int(self.headers.get('Content-Length', '0'))
+                body = json.loads(self.rfile.read(length)) if length else None
+                data = json.dumps(peer.receiver._call(method, self.path, body)).encode()
+                if self.path.endswith('/' + stage):
+                    peer.entered.set()
+                    assert peer.release.wait(30), 'parent did not release real HTTP response'
+                self.send_response(200)
+                self.send_header('Content-Type', 'application/json')
+                self.send_header('Content-Length', str(len(data)))
+                self.end_headers()
+                self.wfile.write(data)
+
+            def log_message(self, *args):
+                pass
+
+        self.server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
+        self.thread = threading.Thread(target=self.server.serve_forever)
+        self.thread.start()
+
+    def close(self):
+        self.release.set()
+        self.server.shutdown()
+        self.server.server_close()
+        self.thread.join(10)
+        assert not self.thread.is_alive()
+
+
+@pytest.mark.parametrize('action', ['push', 'detach'])
+@pytest.mark.parametrize('stage', ['session', 'ops'])
+def test_process_in_http_session_excludes_other_sender_and_detach(live, action, stage):
+    kb.create_task(live, title='one sender', assignee='worker')
+    path = Path(live.execute('PRAGMA database_list').fetchone()[2])
+    peer = Peer(stage)
+    ctx = multiprocessing.get_context('spawn')
+    results = ctx.Queue()
+    proc = ctx.Process(target=_send, args=(path, f'http://127.0.0.1:{peer.server.server_port}', results))
+    proc.start()
+    other = helpers.Receiver()
+    try:
+        assert peer.entered.wait(30), 'child never reached the real HTTP boundary'
+        assert proc.is_alive()
+        before = list(live.iterdump())
+        with pytest.raises(SyncRoundBusy):
+            if action == 'push':
+                client.push(live, other, 'default', 'macbook', primary=False, max_batches=1)
+            else:
+                sync.set_mode(live, 'off')
+        assert other.calls == []
+        assert list(live.iterdump()) == before
+        peer.release.set()
+        proc.join(30)
+        assert proc.exitcode == 0
+        assert results.get(timeout=5) == ('ok', 1)
+        assert len(peer.receiver.sent) == 1
+        # The normal round already holds its distinct round lock. No recursive
+        # lock or bypass token is needed to enter the sender after drainage.
+        with board_sync_lock(path):
+            client.push(live, peer.receiver, 'default', 'macbook', primary=False, max_batches=1)
+        sync.set_mode(live, 'off')
+    finally:
+        peer.release.set()
+        if proc.is_alive():
+            proc.terminate()
+        proc.join(10)
+        results.close()
+        results.join_thread()
+        peer.close()
+
+
+def test_detached_preopened_sender_does_not_publish(live):
+    path = Path(live.execute('PRAGMA database_list').fetchone()[2])
+    preopened = kbc.connect(path)
+    receiver = helpers.Receiver()
+    try:
+        sync.set_mode(live, 'off')
+        before = list(live.iterdump())
+        with pytest.raises(ValueError, match='detached'):
+            client.push(preopened, receiver, 'default', 'macbook', primary=False)
+        assert receiver.calls == []
+        assert list(live.iterdump()) == before
+    finally:
+        preopened.close()
+
+
+def test_sender_refuses_nonpersistent_board_before_any_io():
+    import sqlite3
+    conn = sqlite3.connect(':memory:')
+    receiver = helpers.Receiver()
+    try:
+        with pytest.raises(ValueError, match='on-disk board'):
+            client.push(conn, receiver, 'default', 'macbook', primary=False)
+        assert receiver.calls == []
+    finally:
+        conn.close()
diff --git a/tests/hermes_cli/test_kanban_sync_writer_process.py b/tests/hermes_cli/test_kanban_sync_writer_process.py
new file mode 100644
index 0000000000000000000000000000000000000000..7eb48126b499c234e5c6344ab0ec826545f14142
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_sync_writer_process.py
@@ -0,0 +1,64 @@
+"""Independent old-writer DB refusal; not an external-process drain receipt."""
+import multiprocessing
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_sync_writer_gate as gate
+from tests.hermes_cli import test_kanban_sync_writer_gate as helpers
+
+board = helpers.board
+
+
+def _writer(path, revision, channel):
+    conn = sqlite3.connect(path, isolation_level=None)  # noqa: kanban-lockguard -- old-writer fixture
+    try:
+        if revision is not None:
+            conn.create_function('replay_writer_revision', 0, lambda: revision)
+        conn.execute('SELECT count(*) FROM tasks').fetchone()
+        channel.send('preopened')
+        assert channel.recv() == 'write'
+        try:
+            conn.execute("INSERT INTO tasks(id,title,status,created_at) VALUES ('t_child','child','todo',1)")
+        except sqlite3.Error as exc:
+            channel.send(('refused', str(exc)))
+        else:
+            channel.send(('written', None))
+    finally:
+        conn.close()
+        channel.close()
+
+
+@pytest.mark.parametrize('revision', [None, 0, 1])
+def test_preopened_independent_writer_checks_persisted_minimum(board, revision):
+    path, conn = board
+    ctx = multiprocessing.get_context('spawn')
+    parent, child = ctx.Pipe()
+    proc = ctx.Process(target=_writer, args=(path, revision, child))
+    proc.start()
+    child.close()
+    try:
+        assert parent.poll(30), 'child did not open its independent SQLite connection'
+        assert parent.recv() == 'preopened'
+        with kbc.write_txn(conn):
+            gate.activate(conn)  # Disposable fixture only, never a deployment.
+        before = list(conn.iterdump())
+        parent.send('write')
+        assert parent.poll(30), 'child did not report its write outcome'
+        outcome, detail = parent.recv()
+        proc.join(10)
+        assert proc.exitcode == 0
+        if revision == 1:
+            assert outcome == 'written'
+            assert conn.execute("SELECT title FROM tasks WHERE id='t_child'").fetchone()[0] == 'child'
+        else:
+            assert outcome == 'refused'
+            assert ('replay_writer_revision' if revision is None else 'revision too old') in detail
+            assert list(conn.iterdump()) == before
+        assert conn.execute('SELECT minimum FROM replay_writer_gate1').fetchone()[0] == 1
+    finally:
+        parent.close()
+        if proc.is_alive():
+            proc.terminate()
+        proc.join(10)
