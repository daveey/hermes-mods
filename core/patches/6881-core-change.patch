diff --git a/hermes_cli/kanban_replay_sender.py b/hermes_cli/kanban_replay_sender.py
index 61427a8f5aab9e61af7211bb1fabd0f3cf9343e4..57f3ba26982b763d28a09e8b5df2e5b33153ceb1 100644
--- a/hermes_cli/kanban_replay_sender.py
+++ b/hermes_cli/kanban_replay_sender.py
@@ -40,11 +40,25 @@
 
 
 def push(conn, hub, board, gateway, *, primary, max_batches=25, before_head=False, seen=None):
+    """Serialize the complete session/send, not only individual SQL writes."""
+    from hermes_cli.kanban_db_connect import _main_db_file
+    from hermes_cli.kanban_sync_guard import sender_lock
+    path = _main_db_file(conn)
+    if path is None:
+        raise ValueError('sender requires an on-disk board')
+    with sender_lock(path):
+        return _push(conn, hub, board, gateway, primary=primary, max_batches=max_batches,
+                     before_head=before_head, seen=seen)
+
+
+def _push(conn, hub, board, gateway, *, primary, max_batches, before_head, seen):
     """Select only the journal-bound transport; never auto-enroll or fall back."""
     from hermes_cli import kanban_sync_client as client
     client.refuse_if_schema_ahead(conn)
     from hermes_cli.kanban_replay_admission import guard
     guard(conn)
+    if (sync.sync_state(conn) or {}).get('mode') == 'off':
+        raise ValueError('sync is detached; sender disabled')
     if (sync.sync_state(conn) or {}).get('journal_id') is not None:
         from hermes_cli import kanban_replay_existence as existence
         existence.guard(conn)
diff --git a/hermes_cli/kanban_sync_guard.py b/hermes_cli/kanban_sync_guard.py
index 943b6b5b36b1feb2de8b83abc7d4bb8acde76e46..857bb642901ff8dcc194703f506ffa00c9745ca4 100644
--- a/hermes_cli/kanban_sync_guard.py
+++ b/hermes_cli/kanban_sync_guard.py
@@ -4,7 +4,23 @@
 
 
 class SyncRoundBusy(RuntimeError):
-    """A sync round or detach already owns this board's synchronization fence."""
+    """A sync round, sender or detach already owns this board's fence."""
+
+
+@contextmanager
+def sender_lock(path: Path | str):
+    """Own the full send/session, including direct callers outside sync rounds.
+
+    Separate from the round lock: a round calls push while holding its own lock.
+    Detach acquires round then sender, never the reverse. No nested admission or
+    process-local bypass is supported. Old processes still require explicit drain.
+    """
+    from hermes_cli.kanban_db_connect import _dispatch_tick_lock
+    canonical = Path(path).resolve()
+    with _dispatch_tick_lock(canonical.with_name(canonical.name + ".sender")) as held:
+        if not held:
+            raise SyncRoundBusy("board sender is busy; retry after it finishes")
+        yield
 
 
 @contextmanager
