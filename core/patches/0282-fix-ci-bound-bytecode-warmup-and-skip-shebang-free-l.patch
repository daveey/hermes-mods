From 581d7c04a994e787bb1501e98a3c7906f48dab45 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 25 Oct 2026 23:08:54 +0000
Subject: [PATCH] fix(ci): bound bytecode warmup and skip shebang-free line
 scans [daveey]

---
 scripts/check_bash_shebangs.py      | 4 +++-
 scripts/run_tests.sh                | 4 +++-
 tests/scripts/test_bash_shebangs.py | 6 +++++-
 3 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/scripts/check_bash_shebangs.py b/scripts/check_bash_shebangs.py
index a5145b3d45..1cd4b084ef 100644
--- a/scripts/check_bash_shebangs.py
+++ b/scripts/check_bash_shebangs.py
@@ -28,7 +28,9 @@ def check(root: Path) -> list[str]:
         if path.is_symlink() or not path.is_file():
             continue
         data = path.read_bytes()
-        if b"\0" in data:
+        # Most tracked text contains no shebang. Avoid splitting and testing
+        # every source/lockfile line in Python while preserving the full scan.
+        if b"\0" in data or b"#!" not in data:
             continue
         for number, line in enumerate(data.splitlines(), 1):
             if FIXED_BASH.search(line):
diff --git a/scripts/run_tests.sh b/scripts/run_tests.sh
index 36d7abffbf..bd94e3fd45 100755
--- a/scripts/run_tests.sh
+++ b/scripts/run_tests.sh
@@ -183,8 +183,10 @@ cd "$REPO_ROOT"
 # Pre-building the bytecode cache once here (instead of each subprocess
 # compiling on first import) avoids redundant work across ~2000 processes.
 # Uses git to list tracked .py files (skips venv, node_modules, etc).
+# Keep this optional warmup serial: -j 0 spawns a host-sized process pool
+# even for a single-file -j 1 run, bypassing the test runner's CPU budget.
 echo "▶ pre-compiling bytecode cache"
-"$PYTHON" -m compileall -q -j 0 -- $(git ls-files '*.py') >/dev/null 2>&1 || true
+"$PYTHON" -m compileall -q -j 1 -- $(git ls-files '*.py') >/dev/null 2>&1 || true
 
 echo "▶ launching test runner"
 exec env -i \
diff --git a/tests/scripts/test_bash_shebangs.py b/tests/scripts/test_bash_shebangs.py
index fd412ce1d3..ad8ca21c47 100644
--- a/tests/scripts/test_bash_shebangs.py
+++ b/tests/scripts/test_bash_shebangs.py
@@ -17,6 +17,9 @@ def test_checker_reports_and_clears_fixed_bash_paths(tmp_path):
         "other.sh": "#!/bin/sh\n",
         "portable.sh": "#!/usr/bin/env bash\n",
         "usr.sh": "#! /usr/bin/" + "bash\n",
+        "large.txt": "ordinary text without a shell marker\n" * 10000,
+        "late.txt": "ordinary text\r\n" * 10000 + fixed + "\n",
+        "binary.dat": "\0" + fixed,
     }
     for name, text in files.items():
         (tmp_path / name).write_text(text, encoding="utf-8")
@@ -29,8 +32,9 @@ def test_checker_reports_and_clears_fixed_bash_paths(tmp_path):
         "activate:1: use #!/usr/bin/env bash",
         "example.md:2: use #!/usr/bin/env bash",
         "generator.py:1: use #!/usr/bin/env bash",
+        "late.txt:10001: use #!/usr/bin/env bash",
         "usr.sh:1: use #!/usr/bin/env bash",
-        "Bash shebang check: 4 violation(s)",
+        "Bash shebang check: 5 violation(s)",
     ]
     for name, text in files.items():
         (tmp_path / name).write_text(
