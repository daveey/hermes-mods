From fb3b3b2f72825acb96cf835edc22ede4c07b18ec Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 07:17:29 -0700
Subject: [PATCH] tests: close the read-only state.db probe connections so a
 leaked handle can't strand the restarted daemon on a deleted WAL (deflake
 restore_refuses_live_authority) (#310)

---
 tests/gateway/fixtures/local_recovery_probe.py         | 4 ++--
 tests/hermes_cli/test_runtime_maintenance_exclusion.py | 6 +++++-
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/tests/gateway/fixtures/local_recovery_probe.py b/tests/gateway/fixtures/local_recovery_probe.py
index 0b555a78a27..16e426300b7 100644
--- a/tests/gateway/fixtures/local_recovery_probe.py
+++ b/tests/gateway/fixtures/local_recovery_probe.py
@@ -1,6 +1,6 @@
 """Real daemon restart driver; model and preclaim crash barriers are owned fixtures."""
 import asyncio
-from contextlib import contextmanager
+from contextlib import closing, contextmanager
 from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
 import json
 import os
@@ -145,7 +145,7 @@ def probe(tmp_path):
                OPENAI_API_KEY='loopback-only', OPENAI_BASE_URL=url, PYTHONUNBUFFERED='1')
     sessions, params, pids, epochs = {}, {}, [], []
     def rows():
-        with sqlite3.connect(f'file:{home / "state.db"}?mode=ro', uri=True) as db:
+        with closing(sqlite3.connect(f'file:{home / "state.db"}?mode=ro', uri=True)) as db:
             return dict(db.execute('SELECT request_id,status FROM session_admissions'))
     async def first(desc, proc):
         async with websocket(home, desc) as ws:
diff --git a/tests/hermes_cli/test_runtime_maintenance_exclusion.py b/tests/hermes_cli/test_runtime_maintenance_exclusion.py
index a35a3e46e60..5403e248c6a 100644
--- a/tests/hermes_cli/test_runtime_maintenance_exclusion.py
+++ b/tests/hermes_cli/test_runtime_maintenance_exclusion.py
@@ -1,5 +1,6 @@
 """Maintenance must not replace the database behind a live authority."""
 import asyncio
+from contextlib import closing
 from http.server import ThreadingHTTPServer
 import json
 import os
@@ -35,7 +36,10 @@ def test_restore_refuses_live_authority_without_changing_data(tmp_path):
                OPENAI_API_KEY='loopback-only', OPENAI_BASE_URL=url)
 
     def rows():
-        with sqlite3.connect(f'file:{home / "state.db"}?mode=ro', uri=True) as db:
+        # closing(): `with connect()` only ends the transaction. A connection left open until GC holds
+        # a WAL generation, and the raw read_bytes() of the sidecars below cancels its POSIX locks, so
+        # the daemon's exit unlinks the WAL under it and the restarted daemon refuses (DeletedWalGeneration).
+        with closing(sqlite3.connect(f'file:{home / "state.db"}?mode=ro', uri=True)) as db:
             return list(db.execute('SELECT request_id,status FROM session_admissions ORDER BY rowid'))
 
     async def exercise(desc):
-- 
2.55.0

