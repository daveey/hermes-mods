From 16272c058751645c9a7a43110e64c3677bc3eddd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 08:10:30 +0000
Subject: [PATCH] test(kanban): cover shrinking overdue membership [daveey]

Answer PR #3719 review 5988257804: prove that closing a two-card
incident then resolving one card creates a replacement for the remaining
member, rather than silencing a subset for 12 hours. The added regression
passes the exact-set implementation and fails the >= mutant (exit 1).

Correct the detector documentation to describe the 12-hour closed-incident
cooldown, immediate membership-change replacement, archived undated
coverage, and first-line membership marker. Correct the source comment:
the old detector minted a new card per tick, not at an enforced 1h floor.
No production behavior changes; Mac hold/sleep state is untouched.
---
 docs/kanban-home-stall.md                         | 10 ++++++++--
 hermes_cli/kanban_pickup_stall_home.py            |  6 +++---
 tests/hermes_cli/test_kanban_pickup_stall_home.py | 12 ++++++++++++
 3 files changed, 23 insertions(+), 5 deletions(-)

diff --git a/docs/kanban-home-stall.md b/docs/kanban-home-stall.md
index 7fba746359..896d36d8ec 100644
--- a/docs/kanban-home-stall.md
+++ b/docs/kanban-home-stall.md
@@ -20,8 +20,14 @@ One open incident is reused per home under the authenticated hub alarm prefix
 `pickup-stall:hub:home-overdue-<home>:`. It follows existing pickup-alarm creator,
 assignee and placement rules. Repeated passes comment instead of creating a second
 card; elapsed age and held-home heartbeats alone do not churn subsequent comments.
-A closed incident allows a new incident if the condition persists. Active incidents
-are not automatically archived: an agent may still be verifying transfer custody.
+A closed incident covers unchanged overdue membership for 12 hours after completion;
+then a persisting condition can file a replacement. Any membership change, including
+removing a card, allows a replacement immediately. An archived incident without a
+completion timestamp covers unchanged membership indefinitely. New incident bodies
+start with a detector-owned `Home-overdue membership v1: ` JSON array; legacy bodies
+use the overdue listing instead. Title/checkpoint prose is not membership evidence
+for new incidents. Active incidents are not automatically archived: an agent may
+still be verifying transfer custody.
 
 Every listed row includes its title, overdue age and latest continuation checkpoint.
 Machine-only WIP detection is deliberately conservative: paths or unpublished-work
diff --git a/hermes_cli/kanban_pickup_stall_home.py b/hermes_cli/kanban_pickup_stall_home.py
index d48ea71ee4..9a90a268e3 100644
--- a/hermes_cli/kanban_pickup_stall_home.py
+++ b/hermes_cli/kanban_pickup_stall_home.py
@@ -145,9 +145,9 @@ def _fresh(replica, now: float) -> bool:
     return row is not None and type(row[0]) in (int, float) and -5 <= now - row[0] <= FRESH_SECONDS
 
 
-# Pick: a closed incident keeps covering the same home and same overdue membership for 12 h (the repair
-# completes after a no-op inspect, so the 1 h REPLACE_AFTER_SECONDS floor still minted ~24 cards/day for a
-# silent example host; 12 h gives <= 2/day). A changed membership files a fresh incident at once.
+# Pick: a closed incident keeps covering the same home and same overdue membership for 12 h.
+# Previously each no-op repair completion allowed another incident on the next tick (~102/day).
+# With unchanged membership, 12 h gives <= 2/day; changed membership files a fresh incident at once.
 # Open incidents always win over a closed sibling. New bodies carry membership on their first
 # line, before all title/checkpoint prose. The listing parser is only for legacy incidents.
 # archive_task leaves completed_at NULL; such incidents cover indefinitely until membership changes.
diff --git a/tests/hermes_cli/test_kanban_pickup_stall_home.py b/tests/hermes_cli/test_kanban_pickup_stall_home.py
index 71aa156b22..facd06eeba 100644
--- a/tests/hermes_cli/test_kanban_pickup_stall_home.py
+++ b/tests/hermes_cli/test_kanban_pickup_stall_home.py
@@ -256,6 +256,18 @@ def test_closed_incident_is_replaced_when_membership_changes(replica, local):
     assert second != first
 
 
+def test_closed_incident_is_replaced_when_membership_shrinks(replica, local):
+    card(replica, "one")
+    card(replica, "two")
+    [first] = subject.sweep(local, replica, "hub", now_ms=NOW * 1000)
+    _close(local, first, NOW)
+    replica.execute("UPDATE tasks SET status='done' WHERE id='two'")
+    _fresh_at(replica, NOW + 60)
+    [second] = subject.sweep(local, replica, "hub", now_ms=(NOW + 60) * 1000)
+    assert second != first
+    assert local.execute("SELECT COUNT(*) FROM tasks").fetchone()[0] == 2
+
+
