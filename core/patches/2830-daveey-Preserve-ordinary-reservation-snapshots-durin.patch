From 000175d5a90460fa6656d246851da67042d1f27c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 04:34:23 +0000
Subject: [PATCH] [daveey] Preserve ordinary reservation snapshots during
 recovery ticks

---
 hermes_cli/kanban_worker_placement.py         | 6 ++++--
 tests/hermes_cli/test_kanban_no_pool_audit.py | 2 +-
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_worker_placement.py b/hermes_cli/kanban_worker_placement.py
index 3bf0a466db..df3f2f2910 100644
--- a/hermes_cli/kanban_worker_placement.py
+++ b/hermes_cli/kanban_worker_placement.py
@@ -295,9 +295,11 @@ def reevaluate(conn, hub, board, gateway, *, cfg=None):
         for row in rows:
             if row["placement_policy"] is not None:
                 last = row["id"]
-            if not recovery.unchanged_ready(conn, row):
-                continue
             mode = recovery.available_mode(conn, dict(row), cfg, hub, board, gateway)
+            # Recovery changes placement policy: revalidate its current inputs. Ordinary
+            # renewals retain the pre-loop snapshot used by picked_up after an in-loop pull.
+            if mode and not recovery.unchanged_ready(conn, row):
+                continue
             if row["placement_policy"] is None and mode is None:
                 continue
             key = (board, row["id"])
diff --git a/tests/hermes_cli/test_kanban_no_pool_audit.py b/tests/hermes_cli/test_kanban_no_pool_audit.py
index 07d80f9f01..af6bd4761c 100644
--- a/tests/hermes_cli/test_kanban_no_pool_audit.py
+++ b/tests/hermes_cli/test_kanban_no_pool_audit.py
@@ -62,4 +62,4 @@ def test_audit_failure_is_visible_not_portable(monkeypatch):
     def broken(*args):
         raise ValueError("invalid classifier input")
     monkeypatch.setattr(placement, "portable_reason", broken)
-    assert worker.creation_audit({}, {}) == {"portable_reason": "audit failed"}
+    assert worker.creation_audit({}, {}) == {"portable_reason": "audit failed", "placement_intent": "auto"}
-- 
2.43.0

