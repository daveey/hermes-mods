From 0bbf96efe8d40fead57987f2bd7f669c309e6063 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 03:38:47 +0000
Subject: [PATCH] [daveey] Pickup-stall home-overdue: listing-only membership,
 open-before-closed

Review of aa0634255d21: regexing the whole body treated checkpoint bullets like
"- tests (12 passed)" as overdue ids, so a closed card never covered and every
tick minted again. Closed covering also ran before the open check, so an open
incident got no observation while a matching closed sibling existed. Archived
rows have NULL completed_at; COALESCE to created_at started the 12h clock at
create, so a long-open then archived card was replaced on the next tick.

Fix: parse only listing lines (`- <id> (<title>), scheduled|todo, N minutes overdue`);
prefer an open covering repair; keep covering when completed_at is NULL.

Proof: three new tests failed on aa0634255d21 and pass here; existing home suite green.
---
 hermes_cli/kanban_pickup_stall_home.py        | 30 +++++++++----
 .../test_kanban_pickup_stall_home.py          | 44 +++++++++++++++++++
 2 files changed, 65 insertions(+), 9 deletions(-)

diff --git a/hermes_cli/kanban_pickup_stall_home.py b/hermes_cli/kanban_pickup_stall_home.py
index d8100cc471..8d23b601f3 100644
--- a/hermes_cli/kanban_pickup_stall_home.py
+++ b/hermes_cli/kanban_pickup_stall_home.py
@@ -147,20 +147,31 @@ def _fresh(replica, now: float) -> bool:
 # Pick: a closed incident keeps covering the same home and same overdue membership for 12 h (the repair
 # completes after a no-op inspect, so the 1 h REPLACE_AFTER_SECONDS floor still minted ~24 cards/day for a
 # silent example host; 12 h gives <= 2/day). A changed membership files a fresh incident at once.
+# Open incidents always win over a closed sibling. Membership is the listing line we write
+# (`- <id> (<title>), <status>, N minutes overdue`), not every `- token (` in checkpoint prose.
+# archive_task leaves completed_at NULL; do not start the 12 h clock at created_at.
 HOME_REPLACE_AFTER_SECONDS = 12 * 3600
-_LISTED = re.compile(r"^- (\S+) \(", re.MULTILINE)
+_LISTED = re.compile(
+    r"^- (\S+) \(.*\), (?:scheduled|todo), \d+ minutes overdue", re.MULTILINE)
+
+
+def _listed_ids(body: str) -> set[str]:
+    return set(_LISTED.findall(body or ""))
 
 
 def _recently_closed(conn, key: str, card_ids: list[str], now_ms: int) -> str | None:
     from hermes_cli import kanban_pickup_stall as kps
     row = conn.execute(
-        "SELECT id, body, COALESCE(completed_at, created_at) AS closed FROM tasks WHERE created_by = ? "
+        "SELECT id, body, completed_at FROM tasks WHERE created_by = ? "
         "AND idempotency_key >= ? AND idempotency_key < ? AND status IN ('done', 'archived') "
         "ORDER BY COALESCE(completed_at, created_at) DESC, id LIMIT 1", (kps.DETECTOR, key, key + "\U0010ffff")
     ).fetchone()
-    if row is None or now_ms / 1000 - row["closed"] >= HOME_REPLACE_AFTER_SECONDS:
+    if row is None:
         return None
-    return row["id"] if set(_LISTED.findall(row["body"] or "")) == set(card_ids) else None
+    closed = row["completed_at"]
+    if closed is not None and now_ms / 1000 - closed >= HOME_REPLACE_AFTER_SECONDS:
+        return None
+    return row["id"] if _listed_ids(row["body"] or "") == set(card_ids) else None
 
 
 def sweep(conn, replica, own: str, *, now_ms: int) -> list[str]:
@@ -185,12 +196,13 @@ def sweep(conn, replica, own: str, *, now_ms: int) -> list[str]:
                 "last parent completed; a scheduled clock uses its current wake/backstop.\n\n" + listed
                 + "\n\n" + HOWTO)
         key = f"{kps.KEY_PREFIX}{own}:home-overdue-{home}:"
-        recent = _recently_closed(conn, key, [c["id"] for c in cards], now_ms)
-        if recent is not None:
-            ids.append(recent)  # silence: the same overdue set was just repaired, do not mint another worker
-            continue
+        if not kps._covering_repair(conn, key, now_ms):
+            recent = _recently_closed(conn, key, [c["id"] for c in cards], now_ms)
+            if recent is not None:
+                ids.append(recent)  # silence: same overdue set was just repaired
+                continue
         ids.append(kps._create(
-            conn, key=f"{kps.KEY_PREFIX}{own}:home-overdue-{home}:",
+            conn, key=key,
             title=f"Home transitions overdue on {home} ({len(cards)} cards)", body=body,
             tenant=cards[0]["tenant"], own=own, now_ms=now_ms, howto=HOWTO))
     return ids
diff --git a/tests/hermes_cli/test_kanban_pickup_stall_home.py b/tests/hermes_cli/test_kanban_pickup_stall_home.py
index c6150eb39c..f41c14e226 100644
--- a/tests/hermes_cli/test_kanban_pickup_stall_home.py
+++ b/tests/hermes_cli/test_kanban_pickup_stall_home.py
@@ -228,6 +228,50 @@ def test_closed_incident_is_replaced_when_membership_changes(replica, local):
     assert second != first
 
 
+def test_closed_incident_membership_ignores_checkpoint_bullets(replica, local):
+    card(replica, "one")
+    replica.execute(
+        "INSERT INTO task_runs VALUES (1, 'one', 'continued', ?, ?)",
+        ("status:\n- tests (12 passed)", NOW),
+    )
+    [first] = subject.sweep(local, replica, "hub", now_ms=NOW * 1000)
+    task = kb.get_task(local, first)
+    assert task is not None
+    assert "\n- tests (12 passed)" in (task.body or "")
+    _close(local, first, NOW)
+    _fresh_at(replica, NOW + 60)
+    assert subject.sweep(local, replica, "hub", now_ms=(NOW + 60) * 1000) == [first]
+    assert local.execute("SELECT COUNT(*) FROM tasks").fetchone()[0] == 1
+
+
+def test_open_incident_observed_even_when_closed_sibling_matches(replica, local):
+    card(replica, "one")
+    [open_id] = subject.sweep(local, replica, "hub", now_ms=NOW * 1000)
+    body, key = local.execute("SELECT body, idempotency_key FROM tasks WHERE id=?", (open_id,)).fetchone()
+    local.execute(
+        "INSERT INTO tasks (id, title, body, status, created_by, created_at, completed_at, "
+        "workspace_kind, idempotency_key) VALUES (?,?,?,?,?,?,?,?,?)",
+        ("closed-sib", "closed", body, "done", kps.DETECTOR, NOW, NOW + 1, "scratch", key + "z"),
+    )
+    local.commit()
+    _fresh_at(replica, NOW + 60)
+    assert subject.sweep(local, replica, "hub", now_ms=(NOW + 60) * 1000) == [open_id]
+    assert len(kb.list_comments(local, open_id)) == 1
+
+
+def test_archived_without_completed_at_still_covers(replica, local):
+    card(replica, "one")
+    [first] = subject.sweep(local, replica, "hub", now_ms=NOW * 1000)
+    local.execute(
+        "UPDATE tasks SET status='archived', completed_at=NULL, created_at=? WHERE id=?",
+        (NOW - subject.HOME_REPLACE_AFTER_SECONDS - 10, first),
+    )
+    local.commit()
+    _fresh_at(replica, NOW)
+    assert subject.sweep(local, replica, "hub", now_ms=NOW * 1000) == [first]
+    assert local.execute("SELECT COUNT(*) FROM tasks").fetchone()[0] == 1
+
+
 def test_legacy_backstop_and_current_park(replica):
     from hermes_cli.kanban_timed_park import implied_wake
     card(replica, wake={})
