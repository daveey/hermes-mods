From 258e68cb77ad86b50fb7ab33eeaaf20fab54e24a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 03:34:36 +0000
Subject: [PATCH] [daveey] justify optional PATH-only choom lookup

CI exposed the repository-wide command-resolution ratchet missing from the initial consumer selection. choom is an optional system tool, not a managed runtime; retaining PATH-only lookup preserves the requested no-choom fallback. Proof: seven focused files, 73 passed, including all eight managed-runtime guards and the five real terminal adjustment cases.
---
 tests/fixtures/resolution_allowlist.json | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/tests/fixtures/resolution_allowlist.json b/tests/fixtures/resolution_allowlist.json
index be212c49f52f2794c58e84aad5079c2ec7ac61a9..2155c1af07bbf4b603be81cc9b4671e55c97388c 100644
--- a/tests/fixtures/resolution_allowlist.json
+++ b/tests/fixtures/resolution_allowlist.json
@@ -1,4 +1,10 @@
 [
+  {
+    "path": "tools/terminal_oom.py",
+    "symbol": "prefer_command_victim",
+    "kind": "bare_which",
+    "reason": "choom is an optional system utility, not a Hermes-managed runtime. Only wrap commands when it exists on PATH; otherwise preserve argv. Covered by tests/tools/test_terminal_oom_adj.py."
+  },
   {
     "path": "agent/anthropic_adapter.py",
     "symbol": "<module>",
-- 
2.43.0

