From a6f191e6c65c54e5974141212989097038de4b7c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 12:03:18 +0000
Subject: [PATCH] test(kanban): a bare-name pickup drops a non-claiming worker
 [daveey]

_machine_picks_up passes an empty wanted set, so the machine: pin does
not keep a worker that publishes claiming=0. Review 5992299192 noted
that and had no test. This one kills a mutant that treats the empty set
as a pin. The docstring now says the carve-out needs machine:<name> in
wanted.

Review t_eeeeee0000000028 nit on 49203f09cce8.
---
 hermes_cli/kanban_placement.py             |  3 ++-
 tests/hermes_cli/test_claim_gate_giveup.py | 10 ++++++++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index d7fbc9dedd..4b92ba46d9 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -300,7 +300,8 @@ def label_machines(label: str | Iterable[str], machines: Optional[dict] = None)
 
 
 def _claiming_for(name: str, entry: dict, wanted: set) -> bool:
-    """A non-claiming machine leaves a portable label set. A pin to that machine stays."""
+    """A non-claiming machine leaves a portable label set. A pin stays only when ``machine:<name>`` is in
+    ``wanted``. A bare-name pickup passes an empty set, so that carve-out does not keep it."""
     from hermes_cli.kanban_move import _not_claiming
     if not _not_claiming(entry):
         return True
diff --git a/tests/hermes_cli/test_claim_gate_giveup.py b/tests/hermes_cli/test_claim_gate_giveup.py
index 13a34bde01..6c562c4eca 100644
--- a/tests/hermes_cli/test_claim_gate_giveup.py
+++ b/tests/hermes_cli/test_claim_gate_giveup.py
@@ -88,6 +88,16 @@ def test_label_machines_keeps_a_pinned_non_claiming_worker():
     assert label_machines({"pool:worker", "machine:worker-1"}, machines) == ["worker-1"]
 
 
+def test_bare_name_pickup_drops_a_non_claiming_worker():
+    """A bare-name pickup passes an empty wanted set, so the machine: pin does not keep it."""
+    seen = int(time.time() * 1000)
+    entry = {"state": "active", "labels": ["pool:worker", "machine:worker-1"], "pickup": "all",
+             "last_seen": seen, "metrics": {"claiming": 0}}
+    assert label_machines((), {"worker-1": entry}) == []
+    entry["metrics"] = {"claiming": 1}
+    assert label_machines((), {"worker-1": entry}) == ["worker-1"]
+
+
 def test_sync_watcher_give_up_is_wired():
     from gateway.run_startup import GatewayStartupMixin
 
