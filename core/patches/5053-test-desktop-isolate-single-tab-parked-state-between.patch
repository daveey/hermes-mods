 create mode 100644 apps/desktop/src/components/pane-shell/tree/single-tab-memory.ts

diff --git a/apps/desktop/src/components/pane-shell/tree/single-tab-memory.test.ts b/apps/desktop/src/components/pane-shell/tree/single-tab-memory.test.ts
new file mode 100644
index 0000000000..7bd0d89f2a
--- /dev/null
+++ b/apps/desktop/src/components/pane-shell/tree/single-tab-memory.test.ts
@@ -0,0 +1,42 @@
+import { describe, expect, it } from 'vitest'
+
+import { $parkedTreePanes, setTreePaneParked } from './parked-panes'
+import { resetSingleTabsForTests, singleTabMemory } from './single-tab-memory'
+
+function seed() {
+  singleTabMemory.parked = [{ groupId: 'main', id: 'session-tile:previous', index: 0 }]
+  singleTabMemory.preferred = 'session-tile:preferred'
+  setTreePaneParked('session-tile:previous', true)
+}
+
+describe('Single-tab test reset', () => {
+  it('clears both bookkeeping fields and only unparks Single-owned panes', () => {
+    seed()
+    setTreePaneParked('browser:background', true)
+
+    resetSingleTabsForTests()
+
+    expect(singleTabMemory.parked).toEqual([])
+    expect(singleTabMemory.preferred).toBeNull()
+    expect($parkedTreePanes.get().has('session-tile:previous')).toBe(false)
+    expect($parkedTreePanes.get().has('browser:background')).toBe(true)
+    setTreePaneParked('browser:background', false)
+  })
+
+  it('is safe to call repeatedly without changing unrelated parking', () => {
+    setTreePaneParked('browser:background', true)
+    resetSingleTabsForTests()
+    resetSingleTabsForTests()
+    expect([...$parkedTreePanes.get()]).toEqual(['browser:background'])
+    setTreePaneParked('browser:background', false)
+  })
+
+  // Deliberately leave state dirty: the global setup hook, not a local hook,
+  // must clear it before the next case starts.
+  it.each([1, 2])("starts case %i without the previous test's module state", () => {
+    expect(singleTabMemory.parked).toEqual([])
+    expect(singleTabMemory.preferred).toBeNull()
+    expect($parkedTreePanes.get().has('session-tile:previous')).toBe(false)
+    seed()
+  })
+})
diff --git a/apps/desktop/src/components/pane-shell/tree/single-tab-memory.ts b/apps/desktop/src/components/pane-shell/tree/single-tab-memory.ts
new file mode 100644
index 0000000000..e996bd65d2
--- /dev/null
+++ b/apps/desktop/src/components/pane-shell/tree/single-tab-memory.ts
@@ -0,0 +1,21 @@
+import { setTreePaneParked } from './parked-panes'
+
+export interface ParkedTab {
+  groupId: string
+  id: string
+  index: number
+}
+
+// Keep this module free of the registry/settings graph: global test setup imports it
+// before individual test files install their mocks.
+export const singleTabMemory: { parked: ParkedTab[]; preferred: string | null } = {
+  parked: [],
+  preferred: null
+}
+
+export function resetSingleTabsForTests(): void {
+  const entries = singleTabMemory.parked
+  singleTabMemory.parked = []
+  singleTabMemory.preferred = null
+  entries.forEach(entry => setTreePaneParked(entry.id, false))
+}
