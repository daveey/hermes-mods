From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 07:19:11 +0000
Subject: [PATCH 6345] Sized titlebar tools and Sessions tab-strip contributions

Public mirror of source commit 04b7e844f9ddc9a94d75da5c5d80331bf18c85b7.

---
diff --git a/apps/desktop/e2e/sessions-tab-strip.spec.ts b/apps/desktop/e2e/sessions-tab-strip.spec.ts
new file mode 100644
index 00000000000..49b64bedd71
--- /dev/null
+++ b/apps/desktop/e2e/sessions-tab-strip.spec.ts
@@ -0,0 +1,41 @@
+import { readFileSync } from 'node:fs'
+
+import { expect, test } from '@playwright/test'
+import { compile } from 'tailwindcss'
+
+// Compile the production slot's actual utilities: a duplicated CSS fixture could
+// stay green while the component regresses to unsafe end alignment.
+const source = readFileSync(new URL('../src/components/pane-shell/tree/renderer/sessions-tab-strip.tsx', import.meta.url), 'utf8')
+const classes = /className="([^"]+)"/.exec(source)![1]
+
+test('overflowing Sessions contributions remain reachable from first to last', async ({ page }) => {
+  const compiler = await compile('@tailwind utilities;')
+  const css = compiler.build(classes.split(' '))
+  await page.setContent(`<style>${css}
+    * { box-sizing: border-box; }
+    #strip { display: flex; width: 300px; }
+    #tabs { flex: 1 1 0%; min-width: 0; }
+    button { flex: 0 0 150px; }
+  </style><div id="strip"><div id="tabs">Sessions / Bots</div>
+    <div id="slot" class="${classes}"><button>First</button><button>Last</button></div>
+  </div>`)
+  const slot = page.locator('#slot')
+
+  const geometry = await slot.evaluate(element => {
+    const first = element.firstElementChild!
+
+    return {
+      width: element.clientWidth,
+      scrollWidth: element.scrollWidth,
+      firstOffset: first.getBoundingClientRect().left - element.getBoundingClientRect().left
+    }
+  })
+
+  expect(geometry.width).toBe(195)
+  expect(geometry.scrollWidth).toBe(300)
+  expect(geometry.firstOffset).toBe(0)
+  await expect(page.getByRole('button', { name: 'First' })).toBeInViewport({ ratio: 1 })
+  await slot.evaluate(element => { element.scrollLeft = element.scrollWidth })
+  await expect(page.getByRole('button', { name: 'Last' })).toBeInViewport({ ratio: 1 })
+  expect(await slot.evaluate(element => element.scrollLeft)).toBe(105)
+})
diff --git a/apps/desktop/src/components/pane-shell/tree/renderer/sessions-tab-strip.test.tsx b/apps/desktop/src/components/pane-shell/tree/renderer/sessions-tab-strip.test.tsx
index 8ef74eba436..304ad0848db 100644
--- a/apps/desktop/src/components/pane-shell/tree/renderer/sessions-tab-strip.test.tsx
+++ b/apps/desktop/src/components/pane-shell/tree/renderer/sessions-tab-strip.test.tsx
@@ -60,6 +60,7 @@
   expect(slot.closest('[role="tablist"]')).toBeNull()
   expect(strip.querySelector('[role="tablist"]')?.textContent).toContain('bots')
   expect(slot.className).toContain('max-w-[65%]')
+  expect(slot.className).not.toMatch(/justify-end|flex-end/)
 })
 
 it('keeps clicks in the slot from starting a pane drag', () => {
diff --git a/apps/desktop/src/components/pane-shell/tree/renderer/sessions-tab-strip.tsx b/apps/desktop/src/components/pane-shell/tree/renderer/sessions-tab-strip.tsx
index 19b233bf462..1bc501e54c2 100644
--- a/apps/desktop/src/components/pane-shell/tree/renderer/sessions-tab-strip.tsx
+++ b/apps/desktop/src/components/pane-shell/tree/renderer/sessions-tab-strip.tsx
@@ -15,7 +15,7 @@
 
   return (
     <div
-      className="flex min-w-0 max-w-[65%] shrink items-center justify-end overflow-x-auto overflow-y-hidden [-webkit-app-region:no-drag] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
+      className="flex min-w-0 max-w-[65%] shrink items-center overflow-x-auto overflow-y-hidden [-webkit-app-region:no-drag] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
       data-sessions-tab-strip=""
       onPointerDown={event => event.stopPropagation()}
     >
