From a4b0825ccd2244ba23ee69b7016c5332a933ddf1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 00:33:03 +0000
Subject: [PATCH] fix(kanban): worker protocol prompt names
 $HERMES_KANBAN_WORKER_TASK for shell use [daveey]

Worker tool children (terminal, execute_code) never get HERMES_KANBAN_TASK
(scrub_kanban_env, by design); they carry the card id as
HERMES_KANBAN_WORKER_TASK. The protocol prompt still told agents the id was in
$HERMES_KANBAN_TASK, so shell lines written from it expanded empty: self-heal
briefs' '--card $HERMES_KANBAN_TASK' failed with 'argument --card: expected
one argument', and the worktree fallback branch became 'wt/'.
---
 agent/prompt_builder.py                       |  5 +++--
 tests/tools/test_kanban_worker_task_marker.py | 11 +++++++++++
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/agent/prompt_builder.py b/agent/prompt_builder.py
index eff196ed360..19453cb182e 100644
--- a/agent/prompt_builder.py
+++ b/agent/prompt_builder.py
@@ -263,7 +263,8 @@ SKILLS_GUIDANCE = "When you work out a non-trivial workflow, record it with skil
 KANBAN_GUIDANCE = (
     "# Kanban task execution protocol\n"
     "You have been assigned ONE task from the shared board at `~/.hermes/kanban.db`. Your task id is in "
-    "`$HERMES_KANBAN_TASK`; your workspace is `$HERMES_KANBAN_WORKSPACE`. The `kanban_*` tools in your schema are your "
+    "`$HERMES_KANBAN_TASK` (in terminal and execute_code shells it is `$HERMES_KANBAN_WORKER_TASK`: they never get "
+    "`$HERMES_KANBAN_TASK`); your workspace is `$HERMES_KANBAN_WORKSPACE`. The `kanban_*` tools in your schema are your "
     "primary coordination surface — they write directly to the shared SQLite DB and work regardless of terminal "
     "backend (local/docker/modal/ssh).\n"
     "\n"
@@ -334,7 +335,7 @@ KANBAN_GUIDANCE = (
     "\n"
     "## Reference details that change outcomes\n\n"
     "- **Workspace.** `cd $HERMES_KANBAN_WORKSPACE` first. For a `worktree` kind with no `.git`, `git worktree add "
-    "<path> ${HERMES_KANBAN_BRANCH:-wt/$HERMES_KANBAN_TASK}` from the main repo, then cd there. For a project-linked "
+    "<path> ${HERMES_KANBAN_BRANCH:-wt/$HERMES_KANBAN_WORKER_TASK}` from the main repo, then cd there. For a project-linked "
     "task the workspace is a fresh `<repo>/.worktrees/<task-id>` and `$HERMES_KANBAN_BRANCH` a deterministic "
     "`<project-slug>/<task-id>` — the main repo is two levels up, so run `git worktree add` from there.\n"
     "- **Worktrees you create.** Any other `git worktree add` you run (nested in the workspace, a sibling "
diff --git a/tests/tools/test_kanban_worker_task_marker.py b/tests/tools/test_kanban_worker_task_marker.py
index b5c2bcac5dc..beb8ba64777 100644
--- a/tests/tools/test_kanban_worker_task_marker.py
+++ b/tests/tools/test_kanban_worker_task_marker.py
@@ -181,3 +181,14 @@ def test_nested_hermes_with_only_marker_gets_no_worker_lifecycle_tools(tmp_path,
     assert proc.returncode == 0, proc.stderr
     control = _row(proc.stdout)
     assert control["in_worker"] is True and all(control["avail"].values()), control
+
+
+def test_worker_protocol_prompt_names_the_variable_its_shells_have():
+    """The protocol prompt must not send a worker's shell commands to ``$HERMES_KANBAN_TASK``: its terminal and
+    execute_code children never have it (above), so `--card $HERMES_KANBAN_TASK` expanded to a bare `--card` and
+    `wt/$HERMES_KANBAN_TASK` to `wt/` (self-heal briefs failed with "argument --card: expected one argument")."""
+    from agent.prompt_builder import KANBAN_GUIDANCE
+
+    assert f"${KANBAN_WORKER_TASK_ENV}" in KANBAN_GUIDANCE
+    for shell_use in ("wt/$HERMES_KANBAN_TASK", "`$HERMES_KANBAN_TASK`;"):
+        assert shell_use not in KANBAN_GUIDANCE, shell_use
-- 
