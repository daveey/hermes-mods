From 4a255f7ffa23bf792e9d079de01d25e92e628ce4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 01:06:28 +0000
Subject: [PATCH] ci(tests): raise Run tests timeout to 120 min (shared 16-core
 hub runner) (#21)

---
 .github/workflows/tests.yml | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index a08567431f..8699444f47 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -38,9 +38,16 @@ jobs:
     # 3x the price because files contend for the shared machine. Separate machines
     # scale linearly. run_tests_parallel.py partitions from the checkout alone, so
     # both slices agree on the split without a planning job.
+    #
+    # The ~10 min figure assumes a dedicated 32-core box per slice. The
+    # self-hosted hermes-hub runners are 6 runner services on ONE 16-core host
+    # (load average ~80 when busy), so a slice gets a fraction of that and
+    # takes ~60-70 min under contention. 30 min cancelled both slices at
+    # 45%/78% (run 39732864100). 120 leaves headroom; revisit if the hub
+    # gets more cores.
     name: Run tests (${{ matrix.slice }}/2)
     runs-on: [self-hosted, hermes-hub]
-    timeout-minutes: 30
+    timeout-minutes: 120
     strategy:
       fail-fast: false
       matrix:
-- 
2.54.0 (Apple Git-157)

