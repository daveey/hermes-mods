From 873a509e8c7891ea349ebeeb9bf352eeeb803c4c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 19:26:17 +0000
Subject: [PATCH] fix(gateway): publish admission outcome off the event loop
 [daveey]

---
 gateway/run_turn_prepare.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/gateway/run_turn_prepare.py b/gateway/run_turn_prepare.py
index 9bbeed901f..b994f6b9d2 100644
--- a/gateway/run_turn_prepare.py
+++ b/gateway/run_turn_prepare.py
@@ -837,7 +837,7 @@ class GatewayTurnPrepareMixin:
         # earlier would falsely recover a message that never began processing.
         await self._mark_durable_active_turn(event, session_entry.session_key)
         from gateway.turn_outcome import refresh_gateway_turn_start_outcome
-        refresh_gateway_turn_start_outcome(self, session_entry)
+        await asyncio.to_thread(refresh_gateway_turn_start_outcome, self, session_entry)
 
         # An unreadable store is not an empty conversation: stop before the agent invents continuity
         # from []. Restore task-local context here (before the broad cleanup finally).
-- 
