From 3ba6f504ae010038f80708d3546f3a145d83286c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 19:23:34 -0700
Subject: [PATCH] [daveey] cron: scoped runs drop the update reservation;
 restart re-checks a withdrawn update intent after the wait

Review of t_01a189db034f3b2b:
- a scope-isolated (restart-safe) cron worker kept its core-update admission reservation, so a
  drain window would wait on runs the gateway restart deliberately excludes (hub: 4 at once).
- the withdrawn-intent check ran only inside the restart wait loop; an intent removed during the
  poll sleep as the last unit ended (or at the deadline) still restarted the gateway on old code.
---
diff --git a/cron/scheduler.py b/cron/scheduler.py
index cf09537b851b1a2d7558e5c54b3f8e2d478bc4f3..4119b4d5dca0180f08a79e68d797560d5c9112a6 100644
--- a/cron/scheduler.py
+++ b/cron/scheduler.py
@@ -811,6 +811,9 @@ def _record_external_cron_worker(job_id: str, pid: Any, *, scope_isolated: bool)
             _running_worker_pids[key] = int(pid)
         if scope_isolated:
             _scope_isolated_job_ids.add(key)
+            # A scoped worker outlives a gateway restart, so the restart wait excludes it; the
+            # update drain must too, or a long scoped run holds every drain window open. [daveey]
+            _drop_run_reservation(key)
 
 
 def try_register_running_job(job_id: str, *, owner=None, future=_FUTURE_PENDING) -> bool:
diff --git a/gateway/run_shutdown_restart_wait.py b/gateway/run_shutdown_restart_wait.py
index d1924cb76a444d70af7ddcbdbec6d853f0372da4..15e935af508147e62827a312dfbf34a3906a7799 100644
--- a/gateway/run_shutdown_restart_wait.py
+++ b/gateway/run_shutdown_restart_wait.py
@@ -89,6 +89,17 @@ class GatewayRestartWaitMixin:
             "update that did not apply", intent, self._awaitable_work_count())
         return True
 
+    async def _restart_wait_cancelled(self) -> bool:
+        """Run the after-turn wait; True when the restart must be cancelled instead of run.
+
+        Re-checks the intent on every exit path, not only inside the wait loop: it can vanish during
+        the poll sleep while the last unit ends (loop exits on count == 0) or at the deadline, and a
+        restart then would relaunch old code for an update that gave up. [daveey]
+        """
+        if await self._await_active_work_before_restart() is RESTART_CANCELLED:
+            return True
+        return self._update_intent_withdrawn(getattr(self, "_restart_update_intent", None))
+
     def _cancel_restart(self) -> None:
         """Undo ``request_restart`` before ``stop()``: accept new turns again, report ``running``, and
         let the next update's SIGUSR1 request a fresh restart. API runs keep their informational
diff --git a/tests/cron/test_update_admission_hold.py b/tests/cron/test_update_admission_hold.py
index a15138d74b54a5ca4cb373887668f27095503828..56f3262e20f087ca03e7c211006d2a94430fdb86 100644
--- a/tests/cron/test_update_admission_hold.py
+++ b/tests/cron/test_update_admission_hold.py
@@ -89,3 +89,24 @@ def test_a_running_job_holds_an_admission_reservation_until_it_ends(tmp_path, mo
         assert admission_fence.state(root)["reservations"] == 0
     finally:
         admission_fence.clear_hold(root)
+
+
+def test_a_scope_isolated_run_drops_its_reservation_an_in_process_run_keeps_it(tmp_path, monkeypatch):
+    """A scoped external worker survives the gateway restart, which excludes it from its wait; the
+    update drain must not wait on it either (hub: 4 restart-safe scoped crons at once)."""
+    from cron import scheduler
+    from hermes_cli import admission_fence
+
+    root = _root()
+    assert scheduler.try_register_running_job("scoped-job")
+    assert scheduler.try_register_running_job("inproc-job")
+    try:
+        assert admission_fence.state(root)["reservations"] == 2
+        scheduler._record_external_cron_worker("scoped-job", 4242, scope_isolated=True)
+        scheduler._record_external_cron_worker("inproc-job", 4243, scope_isolated=False)
+        assert admission_fence.state(root)["reservations"] == 1
+        assert "scoped-job" in scheduler.get_running_job_ids()  # still in flight for dedupe
+    finally:
+        scheduler.release_running_job("scoped-job")
+        scheduler.release_running_job("inproc-job")
+    assert admission_fence.state(root)["reservations"] == 0
diff --git a/tests/gateway/test_restart_cancel_on_update_giveup.py b/tests/gateway/test_restart_cancel_on_update_giveup.py
index 77f787c5ee80f6cf4913f32473019783a9161096..698c0f425381c260732bfccd4e9790741f669edd 100644
--- a/tests/gateway/test_restart_cancel_on_update_giveup.py
+++ b/tests/gateway/test_restart_cancel_on_update_giveup.py
@@ -56,6 +56,51 @@ async def test_update_restart_is_cancelled_when_the_intent_goes_away(tmp_path, m
     runner.stop.assert_awaited_once_with(restart=True, detached_restart=False, service_restart=True)
 
 
+@pytest.mark.asyncio
+async def test_restart_is_cancelled_when_the_intent_goes_as_the_last_unit_ends(tmp_path, monkeypatch):
+    """Intent removed during the poll sleep in the same step the last unit finishes: the loop exits
+    on count == 0, and must still see the give-up instead of restarting on old code."""
+    intent = _intent(tmp_path, monkeypatch)
+    runner, _adapter = make_restart_runner()
+    runner.stop = AsyncMock()
+    runner._restart_after_turn_timeout = 30.0
+    session_key = "agent:main:telegram:dm:1"
+    runner._running_agents[session_key] = MagicMock()
+
+    assert runner.request_restart(detached=False, via_service=True) is True
+    await _let_the_wait_loop_run()
+    intent.unlink()
+    del runner._running_agents[session_key]
+    await asyncio.wait_for(runner._restart_task, 5)
+
+    runner.stop.assert_not_awaited()
+    assert runner._draining is False
+    assert runner._restart_requested is False
+
+
+@pytest.mark.asyncio
+async def test_restart_is_cancelled_when_the_wait_times_out_after_the_intent_went(tmp_path, monkeypatch):
+    intent = _intent(tmp_path, monkeypatch)
+    runner, _adapter = make_restart_runner()
+    runner.stop = AsyncMock()
+    runner._restart_after_turn_timeout = 1e-6  # deadline already passed on the first iteration
+    runner._running_agents["agent:main:telegram:dm:1"] = MagicMock()
+    # The withdrawn check inside the loop runs before the deadline check; make it miss once so the
+    # deadline branch is the one that sees the removed intent.
+    real = runner._update_intent_withdrawn
+    calls = []
+
+    def withdrawn(path):
+        calls.append(path)
+        return False if len(calls) == 1 else real(path)
+
+    runner._update_intent_withdrawn = withdrawn
+    assert runner.request_restart(detached=False, via_service=True) is True
+    intent.unlink()
+    await asyncio.wait_for(runner._restart_task, 5)
+    runner.stop.assert_not_awaited()
+
+
 @pytest.mark.asyncio
 async def test_update_restart_proceeds_when_work_drains_while_the_intent_stands(tmp_path, monkeypatch):
     _intent(tmp_path, monkeypatch)
