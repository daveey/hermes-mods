From 230ca12482148788cdede871c3038138ee832f04 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 17:21:50 +0000
Subject: [PATCH] [daveey] Preserve absent PR evidence and enforce projection
 scan budgets

---
 hermes_cli/kanban_lanes_flow.py            | 10 +++++++---
 tests/hermes_cli/test_kanban_lanes_flow.py | 17 +++++++++++++----
 2 files changed, 20 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban_lanes_flow.py b/hermes_cli/kanban_lanes_flow.py
index 43da95b471..a2fc3eaaf0 100644
--- a/hermes_cli/kanban_lanes_flow.py
+++ b/hermes_cli/kanban_lanes_flow.py
@@ -186,10 +186,14 @@ def _pr_url(task, events) -> Optional[str]:
     return None
 
 
-def _pr_snapshot(task, events, awaiting, reader=None, *, url=None) -> Optional[dict]:
+_URL_UNSET = object()
+
+
+def _pr_snapshot(task, events, awaiting, reader=None, *, url=_URL_UNSET) -> Optional[dict]:
     snap: dict[str, Any] = {}
     # A caller holding the card's already derived URL (request evidence) skips re-deriving it from the history.
-    url = url or _pr_url(task, events)
+    if url is _URL_UNSET:
+        url = _pr_url(task, events)
     if not url and isinstance(awaiting, dict):
         ref = awaiting.get("ref")
         if isinstance(ref, str) and ref.startswith("https://github.com/") and "/pull/" in ref:
@@ -271,7 +275,7 @@ def _card_from_row(conn, task, now: float, reader=None, pol=None, *, evidence=No
     human = _json_obj(task["human_request"] if "human_request" in task.keys() else None)
     age = max(0.0, (now - float(task["created_at"] or now)) / 3600.0)
     pr = _pr_snapshot(task, events, awaited, reader,
-                      url=None if evidence is None else evidence.pr_url(task))
+                      url=_URL_UNSET if evidence is None else evidence.pr_url(task))
     event_dicts = [{"kind": e["kind"], "payload": e["payload"]} for e in events]
     return {
         "id": task["id"], "title": task["title"], "status": task["status"],
diff --git a/tests/hermes_cli/test_kanban_lanes_flow.py b/tests/hermes_cli/test_kanban_lanes_flow.py
index b0dea26fb4..f4cf8b623d 100644
--- a/tests/hermes_cli/test_kanban_lanes_flow.py
+++ b/tests/hermes_cli/test_kanban_lanes_flow.py
@@ -184,7 +184,7 @@ def test_spend_comes_from_one_scan_and_equals_the_per_lane_scan(conn, configured
     configured()
     now = int(time.time())
     pol = lanes.policy()
-    for lane, cost in (("myapp", 1.25), ("myapp", 2.5), ("other", 0.1), ("stranger", 7.0)):
+    for lane, cost in (("myapp", 1.25), ("myapp", 2.5), ("other", 0.126), ("stranger", 7.0)):
         tid = base._ready_in(conn, lane, f"spend {lane} {cost}")
         conn.execute("INSERT INTO task_runs (task_id, status, started_at, ended_at) VALUES (?, 'done', ?, ?)",
                      (tid, now - 10, now - 1))
@@ -203,17 +203,17 @@ def test_spend_comes_from_one_scan_and_equals_the_per_lane_scan(conn, configured
     scans.clear()
     snap = flow.snapshot(conn, window="6h", now=now, pol=pol, reader=type("R", (), {
         "prefetch": lambda self, urls: None, "get": lambda self, url: {}})())
-    assert len([s for s in scans if "GROUP BY e.task_id, e.run_id" in s and "created_at >= " in s]) >= 1
+    assert len([s for s in scans if "GROUP BY e.task_id, e.run_id" in s and "created_at >= " in s]) == 1
     assert snap["lanes"]["myapp"]["usage"]["usd_today"] == 3.75
 
 
-def test_evidence_projection_equals_plain_projection_with_pr_urls(conn, configured):
+def test_evidence_projection_equals_plain_projection_with_pr_urls(conn, configured, monkeypatch):
     configured()
     now = int(time.time())
     pol = lanes.policy()
     published = base._ready_in(conn, "myapp", "published")
     waiting = base._ready_in(conn, "myapp", "waiting on ci")
-    base._ready_in(conn, "myapp", "plain")
+    plain = base._ready_in(conn, "myapp", "plain")
     conn.execute("INSERT INTO task_events (task_id, kind, payload, created_at) VALUES (?, 'review_requested', ?, ?)",
                  (published, json.dumps({"metadata": {"pr": "https://github.com/example/repo/pull/7"}}), now))
     conn.execute("UPDATE tasks SET status='scheduled' WHERE id=?", (waiting,))
@@ -222,7 +222,16 @@ def test_evidence_projection_equals_plain_projection_with_pr_urls(conn, configur
     conn.commit()
     reader = type("R", (), {"prefetch": lambda self, urls: None, "get": lambda self, url: {}})()
     from hermes_cli.kanban_lanes_flow_evidence import Evidence
+    calls = []
+    original = flow._pr_url
+
+    def counted(task, events):
+        calls.append(task["id"])
+        return original(task, events)
+
+    monkeypatch.setattr(flow, "_pr_url", counted)
     with_evidence = flow.snapshot(conn, window="6h", now=now, pol=pol, reader=reader, evidence=Evidence(conn))
+    assert sorted(calls) == sorted([published, waiting, plain])
     plain_cards = [flow._card_from_row(conn, row, now, reader, pol) for row in
                    conn.execute(f"SELECT * FROM tasks WHERE status IN {flow._OPEN} ORDER BY created_at, id")]
     by_id = {c["id"]: c["pr"] for c in with_evidence["cards"]}
