From df6aa49e0c5a9387d3074a3d607f599a2d55af25 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 20:44:37 -0800
Subject: [PATCH] [daveey] codex: toolless turns end on commentary; class
 routes fail over at once on an exhausted pool

bb-aux (API server, no tools) made 2-4 model calls on 20/878 turns: gpt-6-luna ended a completed
response on a phase=commentary message, the normalizer marked it incomplete and the loop re-called
the model (+4-8 s, and 7 turns walked the reasoning-only ladder into a class failover). With no
tools offered there is no tool call to wait for, so the commentary is the final answer.

- turn_response_intake: promote_toolless_codex_commentary() turns a completed, commentary-only,
  tool-call-free response into the final text when the agent offers no tools.
- turn_truncation: every Codex continuation logs reason=commentary_only|reasoning_only|partial_text|empty,
  response status and tools_offered (no message text).
- turn_recovery: a class-routed agent (no legacy fallback chain) takes the eager rate-limit
  failover when the credential pool cannot recover, instead of a backoff sleep + doomed retry.
---
 agent/turn_recovery.py                        |  11 +-
 agent/turn_response_intake.py                 |  51 +++++
 agent/turn_truncation.py                      |  21 ++
 .../agent/test_toolless_codex_turn_latency.py | 197 ++++++++++++++++++
 4 files changed, 279 insertions(+), 1 deletion(-)
 create mode 100644 tests/agent/test_toolless_codex_turn_latency.py

diff --git a/agent/turn_recovery.py b/agent/turn_recovery.py
index 37a7c8046b4..5f133b2460f 100644
--- a/agent/turn_recovery.py
+++ b/agent/turn_recovery.py
@@ -1450,6 +1450,12 @@ def reset_hint(api_error: Exception) -> str:
     return f"~{format_duration_compact(remaining)}" if remaining >= 1 else ""
 
 
+def _class_failover_available(agent: Any) -> bool:
+    """True when ``try_activate_fallback`` would try a same-class route (a class selector, not an exact pin)."""
+    routing = getattr(agent, "model_routing", None)
+    return isinstance(routing, dict) and bool(routing) and not routing.get("exact_pin")
+
+
 def compute_error_backoff(
     agent: Any, api_error: Exception, *, retry_count: int, max_retries: int, is_rate_limited: bool,
     is_zai_coding_overload: bool, base_url: Any, model: Any,
@@ -1944,7 +1950,10 @@ def route_classified_error(
         (is_rate_limited and _wrapped_output_cap_budget is None)
         or (_is_transport_failure and retry_count >= 2)
     ) and not (getattr(classified, "error_context", None) or {}).get("usage_window")  # never switch models on a plan limit
-    if _should_fallback and agent._fallback_index < len(agent._fallback_chain):
+    # [daveey] Class routes have no legacy chain; fail over now, not after a backoff + doomed retry (~4 s).
+    _eager_target = agent._fallback_index < len(agent._fallback_chain) or (
+        is_rate_limited and _class_failover_available(agent))
+    if _should_fallback and _eager_target:
         # No eager fallback while credential pool rotation may recover. Exception: an
         # upstream-aggregator 429 — the pool can't help, always fall back.
         # Fixes #11314.
diff --git a/agent/turn_response_intake.py b/agent/turn_response_intake.py
index 481ffc81ddf..e74314676ee 100644
--- a/agent/turn_response_intake.py
+++ b/agent/turn_response_intake.py
@@ -162,6 +162,54 @@ def _relay_thinking(agent: Any, content: str, assistant_message: Any = None) ->
         pass
 
 
+def promote_toolless_codex_commentary(agent: Any, assistant_message: Any, response: Any) -> bool:
+    """[daveey] A completed Codex response whose only text is ``phase=commentary`` is the answer
+    when the agent offers no tools: commentary is the preamble before a tool call, and a request with
+    no tools has no call to wait for. The normalizer marks it ``incomplete`` (commentary never ends a
+    tool-using turn), which made every such toolless API-server turn re-call the model 1-3 times
+    (bb-aux: 2-4 calls, +4-8 s) and sometimes walk the reasoning-only ladder into a class failover.
+
+    Promotes the commentary text to ``content`` and sets ``finish_reason="stop"`` in place; returns
+    True when it did. Tool-using agents, responses with any non-completed status/item, a final-answer
+    item, tool calls, or visible content keep today's continuation."""
+    if getattr(agent, "valid_tool_names", None):
+        return False
+    if getattr(assistant_message, "tool_calls", None) or (assistant_message.content or "").strip():
+        return False
+    status = getattr(response, "status", None)
+    if not (isinstance(status, str) and status.strip().lower() == "completed"):
+        return False
+    items = getattr(assistant_message, "codex_message_items", None) or []
+    commentary: list[str] = []
+    for item in items:
+        if not isinstance(item, dict):
+            return False
+        phase = str(item.get("phase") or "").strip().lower()
+        if phase != "commentary" or str(item.get("status") or "").strip().lower() != "completed":
+            return False
+        text = "".join(
+            part.get("text") or "" for part in item.get("content") or []
+            if isinstance(part, dict) and part.get("type") == "output_text"
+        ).strip()
+        if text:
+            commentary.append(text)
+    if not commentary:
+        return False
+    content = "\n\n".join(commentary)
+    assistant_message.content = content
+    reasoning = getattr(assistant_message, "reasoning", None)
+    if isinstance(reasoning, str):
+        # The normalizer flattened the commentary into reasoning; keep only real reasoning there.
+        parts = [p for p in reasoning.split("\n\n") if p.strip() and p.strip() not in commentary]
+        assistant_message.reasoning = "\n\n".join(parts) or None
+    assistant_message.finish_reason = "stop"
+    logger.info(
+        "%sCodex response ended on commentary with no tools offered: using %d-char commentary "
+        "(%d item(s)) as the final answer instead of continuing", agent.log_prefix, len(content), len(commentary),
+    )
+    return True
+
+
 def normalize_model_response(
     agent: Any, *, response: Any, messages: Any, api_messages: Any, conversation_history: Any,
     api_call_count: Any, api_duration: Any, api_start_time: Any, api_request_id: Any,
@@ -170,6 +218,9 @@ def normalize_model_response(
     """Normalize ``response`` into ``assistant_message`` (str content, never dict/list) and run
     the post-response hooks and continuation guards, in the original order."""
     assistant_message = normalize_response_for_agent(agent, response)
+    if agent.api_mode == "codex_responses" and assistant_message.finish_reason == "incomplete":
+        # Toolless commentary-only answer becomes a final text response before hooks and guards run.
+        promote_toolless_codex_commentary(agent, assistant_message, response)
     finish_reason = assistant_message.finish_reason
 
     def _verdict(action: str, result: Optional[dict[str, Any]] = None) -> ResponseIntakeVerdict:
diff --git a/agent/turn_truncation.py b/agent/turn_truncation.py
index 4c3354aa477..2a161febf0b 100644
--- a/agent/turn_truncation.py
+++ b/agent/turn_truncation.py
@@ -558,6 +558,19 @@ _CODEX_REPLAY_KEYS = (
 CODEX_FALLBACK_ACTIVATED = "codex_fallback_activated"
 
 
+def _codex_continuation_reason(interim_msg: dict[str, Any], has_content: bool) -> str:
+    """Short label for why a Codex response did not end the turn (log only, never message text)."""
+    if has_content:
+        return "partial_text"
+    phases = {
+        str(item.get("phase") or "").strip().lower()
+        for item in interim_msg.get("codex_message_items") or [] if isinstance(item, dict)
+    }
+    if "commentary" in phases:
+        return "commentary_only"
+    return "reasoning_only" if interim_msg.get("codex_reasoning_items") or interim_msg.get("reasoning") else "empty"
+
+
 def continue_codex_incomplete(
     agent: Any, assistant_message: Any, finish_reason: str, *, messages: list[dict[str, Any]],
     conversation_history: Any, api_call_count: int, response: Any = None,
@@ -600,6 +613,14 @@ def continue_codex_incomplete(
     reasoning_only = not interim_has_content and not getattr(assistant_message, "tool_calls", None)
     agent._codex_reasoning_only_streak = agent._codex_reasoning_only_streak + 1 if reasoning_only else 0
     streak = agent._codex_reasoning_only_streak
+    # [daveey] Every extra model call this path makes is otherwise invisible in agent.log (the _vprint
+    # below is diagnostic-only): name why the turn continued, with no message text.
+    _status = getattr(response, "status", None)
+    logger.info(
+        "%sCodex continuation %d/3: reason=%s response_status=%s tools_offered=%s reasoning_only_streak=%d",
+        getattr(agent, "log_prefix", ""), n, _codex_continuation_reason(interim_msg, interim_has_content),
+        _status if isinstance(_status, str) else None, bool(getattr(agent, "valid_tool_names", None)), streak,
+    )
 
     if interim_has_content or interim_has_reasoning or interim_has_codex_reasoning or interim_has_codex_message_items:
         last_msg = messages[-1] if messages else None
diff --git a/tests/agent/test_toolless_codex_turn_latency.py b/tests/agent/test_toolless_codex_turn_latency.py
new file mode 100644
index 00000000000..974a7325c39
--- /dev/null
+++ b/tests/agent/test_toolless_codex_turn_latency.py
@@ -0,0 +1,197 @@
+"""[daveey] Toolless Codex turns end on the first final text, and an exhausted pool fails over at once.
+
+bb-aux (API server, ``platform_toolsets.api_server: []``) saw 20 of 878 toolless turns make 2-4 model
+calls: gpt-6-luna ended a ``completed`` response on a ``phase=commentary`` message, the normalizer
+marked it ``incomplete`` (commentary never ends a tool-using turn) and the loop re-called the model.
+With no tools offered there is no tool call to wait for, so the commentary is the answer.
+
+A class-routed agent has no legacy ``_fallback_chain``, so the eager rate-limit fallback never fired
+for it: an exhausted codex pool waited out the backoff and a second attempt before same-class failover.
+"""
+
+from __future__ import annotations
+
+import logging
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+
+from agent.error_classifier import FailoverReason
+from agent.transports.codex import ResponsesApiTransport
+from agent.turn_response_intake import promote_toolless_codex_commentary
+
+
+def _commentary_response(*, status="completed", item_status="completed", final=False):
+    output = [
+        SimpleNamespace(type="reasoning", id="rs_1", summary=[], encrypted_content="enc", status=None),
+        SimpleNamespace(
+            type="message", role="assistant", status=item_status, phase="commentary", id="msg_c",
+            content=[SimpleNamespace(type="output_text", text="Sure, the lights are off now.")],
+        ),
+    ]
+    if final:
+        output.append(SimpleNamespace(
+            type="message", role="assistant", status="completed", phase="final_answer", id="msg_f",
+            content=[SimpleNamespace(type="output_text", text="Done.")],
+        ))
+    return SimpleNamespace(status=status, output=output, output_text="", incomplete_details=None)
+
+
+def _agent(tools=()):
+    return SimpleNamespace(valid_tool_names=set(tools), log_prefix="")
+
+
+def _normalized(response):
+    return ResponsesApiTransport().normalize_response(response, issuer_kind="codex_backend")
+
+
+def test_commentary_only_completed_response_is_incomplete_before_promotion():
+    # Guards the premise: the normalizer alone sends this turn round the continuation loop.
+    msg = _normalized(_commentary_response())
+    assert msg.finish_reason == "incomplete"
+    assert not (msg.content or "").strip()
+
+
+def test_toolless_agent_promotes_commentary_to_final_answer(caplog):
+    response = _commentary_response()
+    msg = _normalized(response)
+    with caplog.at_level(logging.INFO, logger="agent.conversation_loop"):
+        assert promote_toolless_codex_commentary(_agent(), msg, response) is True
+    assert msg.finish_reason == "stop"
+    assert msg.content == "Sure, the lights are off now."
+    assert "Sure, the lights" not in (msg.reasoning or "")
+    # The replay sidecar is untouched: the wire history still says what the model sent.
+    assert [i["phase"] for i in msg.codex_message_items] == ["commentary"]
+    log = "\n".join(r.getMessage() for r in caplog.records)
+    assert "ended on commentary with no tools offered" in log
+    assert "lights" not in log  # no message text in agent.log
+
+
+@pytest.mark.parametrize("case", ["tools_offered", "response_incomplete", "item_in_progress"])
+def test_other_incomplete_responses_keep_continuing(case):
+    response = _commentary_response(
+        status="incomplete" if case == "response_incomplete" else "completed",
+        item_status="in_progress" if case == "item_in_progress" else "completed",
+    )
+    msg = _normalized(response)
+    agent = _agent(tools=("terminal",) if case == "tools_offered" else ())
+    assert promote_toolless_codex_commentary(agent, msg, response) is False
+    assert msg.finish_reason == "incomplete"
+    assert not (msg.content or "").strip()
+
+
+def test_reasoning_only_response_is_not_promoted():
+    response = SimpleNamespace(
+        status="completed", output_text="", incomplete_details=None,
+        output=[SimpleNamespace(type="reasoning", id="rs_1", summary=[], encrypted_content="enc", status=None)],
+    )
+    msg = _normalized(response)
+    assert msg.finish_reason == "incomplete"
+    assert promote_toolless_codex_commentary(_agent(), msg, response) is False
+
+
+def test_commentary_plus_final_answer_is_already_final():
+    msg = _normalized(_commentary_response(final=True))
+    assert msg.finish_reason == "stop"
+    assert msg.content == "Done."
+
+
+def test_continuation_logs_its_reason_without_text(caplog):
+    from agent.turn_truncation import continue_codex_incomplete
+
+    response = _commentary_response()
+    msg = _normalized(response)
+    agent = MagicMock()
+    agent.quiet_mode, agent.log_prefix, agent.max_tokens = True, "", 2000
+    agent.valid_tool_names = {"terminal"}
+    agent._codex_incomplete_retries = 0
+    agent._codex_reasoning_only_streak = 0
+    agent._build_assistant_message.side_effect = lambda m, fr: {
+        "role": "assistant", "content": m.content or "", "finish_reason": fr,
+        "codex_reasoning_items": m.codex_reasoning_items, "codex_message_items": m.codex_message_items,
+    }
+    agent._interim_assistant_visible_text.return_value = ""
+    with caplog.at_level(logging.INFO, logger="agent.conversation_loop"):
+        continue_codex_incomplete(agent, msg, "incomplete", messages=[{"role": "user", "content": "x"}],
+                                  conversation_history=None, api_call_count=1, response=response)
+    log = "\n".join(r.getMessage() for r in caplog.records)
+    assert "Codex continuation 1/3: reason=commentary_only response_status=completed tools_offered=True" in log
+    assert "lights" not in log
+
+
+class _RateLimited(RuntimeError):
+    status_code = 429
+
+
+def _route(agent, monkeypatch):
+    import agent.conversation_loop as cl
+    from agent.turn_recovery import route_classified_error
+
+    monkeypatch.setattr(cl, "_arm_fallback_restart", lambda a, m, p, r: p)
+    monkeypatch.setattr(cl, "_ra", lambda: SimpleNamespace(
+        _pool_may_recover_from_rate_limit=lambda pool: False))
+    classified = SimpleNamespace(reason=FailoverReason.rate_limit, error_context={}, is_auth=False,
+                                 should_fallback=True, retryable=True)
+    err = _RateLimited("HTTP 429: The usage limit has been reached")
+    return route_classified_error(
+        agent, err, classified, MagicMock(), error_msg=str(err), error_context={},
+        recovered_with_pool=False, base_url="https://chatgpt.com/backend-api/codex", model="gpt-6-luna",
+        messages=[], api_messages=[], system_message="", active_system_prompt="", conversation_history=None,
+        retry_count=1, max_retries=3, compression_attempts=0, max_compression_attempts=3, api_call_count=1,
+        effective_task_id=None,
+    )
+
+
+def _class_agent(routing):
+    agent = MagicMock()
+    agent.provider, agent.model = "openai-codex", "gpt-6-luna"
+    agent._fallback_index, agent._fallback_chain = 0, []
+    agent.model_routing = routing
+    agent._try_activate_fallback.return_value = True
+    return agent
+
+
+def test_exhausted_pool_on_class_route_fails_over_without_backoff(monkeypatch):
+    agent = _class_agent({"requested_class": "fast"})
+    verdict = _route(agent, monkeypatch)
+    assert verdict.action == "break"
+    agent._try_activate_fallback.assert_called_once()
+    assert agent._try_activate_fallback.call_args.kwargs["reason"] == FailoverReason.rate_limit
+
+
+@pytest.mark.parametrize("routing", [None, {"requested_class": "fast", "exact_pin": True}])
+def test_unrouted_or_pinned_agent_keeps_legacy_gate(monkeypatch, routing):
+    agent = _class_agent(routing)
+    verdict = _route(agent, monkeypatch)
+    assert verdict.action != "break"
+    agent._try_activate_fallback.assert_not_called()
+
+
+def test_turn_intake_ends_toolless_commentary_turn_without_continuing(monkeypatch):
+    """The call site: the intake hands the turn to the text-response path, not the Codex continuation."""
+    import agent.turn_response_intake as intake
+    import hermes_cli.observability.shared_metrics_harness as metrics
+
+    monkeypatch.setattr(intake, "splice_provider_projection", lambda *a, **k: None)
+    monkeypatch.setattr(intake, "_fire_post_api_request_hook", lambda *a, **k: None)
+    monkeypatch.setattr(metrics, "record_reply_content", lambda *a, **k: None)
+    continued = []
+    monkeypatch.setattr(intake, "continue_codex_incomplete", lambda *a, **k: continued.append(1))
+    transport = ResponsesApiTransport()
+    transport._last_issuer_kind = "codex_backend"
+    agent = MagicMock()
+    agent.api_mode, agent.valid_tool_names, agent.log_prefix, agent.quiet_mode = "codex_responses", set(), "", True
+    agent.tool_progress_callback = None
+    agent._final_gate_buffer = None
+    agent._get_transport.return_value = transport
+    agent._incomplete_scratchpad_retries = 0
+    verdict = intake.normalize_model_response(
+        agent, response=_commentary_response(), messages=[], api_messages=[], conversation_history=None,
+        api_call_count=1, api_duration=1.0, api_start_time=0.0, api_request_id="r", effective_task_id=None,
+        turn_id="t",
+    )
+    assert continued == []
+    assert verdict.action == "fallthrough"
+    assert verdict.finish_reason == "stop"
+    assert verdict.assistant_message.content == "Sure, the lights are off now."
-- 
