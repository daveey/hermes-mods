+                     "started_at=? WHERE id=?", (pid, fingerprint, now - 60, now - 120, now - 3600, tid))
+        conn.execute("UPDATE task_runs SET worker_pid=?, worker_started_at=?, claim_expires=? WHERE id=?",
+                     (pid, fingerprint, now - 60, task.current_run_id))
