From 8b22b97ca6aa5e2c0125ba7d766eede7d3cd22c2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 18:58:43 +0000
Subject: [PATCH] [daveey] Normalize SessionDB filesystem path inputs before
 initialization

---
 hermes_state.py                               |  4 +-
 .../hermes_state/test_session_db_pathlike.py  | 67 +++++++++++++++++++
 2 files changed, 69 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_state/test_session_db_pathlike.py

diff --git a/hermes_state.py b/hermes_state.py
index a574e88c2a2..4774731c83b 100644
--- a/hermes_state.py
+++ b/hermes_state.py
@@ -627,8 +627,8 @@ class SessionDB(
         except Exception as exc:
             logger.warning("%s close failed for %s: %s", label, self.db_path, exc)
 
-    def __init__(self, db_path: Path | None = None, read_only: bool = False):
-        self.db_path = db_path or _default_db_path()
+    def __init__(self, db_path: str | os.PathLike[str] | None = None, read_only: bool = False):
+        self.db_path = Path(db_path or _default_db_path())
         _ensure_test_isolation(self.db_path)  # before any connection/pragma/mkdir
         self.read_only = read_only
         # Keep only the opening call site, never a frame (which pins caller locals).
diff --git a/tests/hermes_state/test_session_db_pathlike.py b/tests/hermes_state/test_session_db_pathlike.py
new file mode 100644
index 00000000000..a2bd213f7c9
--- /dev/null
+++ b/tests/hermes_state/test_session_db_pathlike.py
@@ -0,0 +1,67 @@
+"""SessionDB normalizes filesystem paths before guards and SQLite setup."""
+from pathlib import Path
+
+import pytest
+
+import hermes_state
+from hermes_state import SessionDB
+
+
+class StringPath:
+    def __init__(self, path):
+        self.path = str(path)
+
+    def __fspath__(self):
+        return self.path
+
+
+@pytest.mark.parametrize("convert", [str, Path, StringPath])
+@pytest.mark.parametrize("read_only", [False, True])
+def test_filesystem_path_round_trip(tmp_path, convert, read_only):
+    path = tmp_path / "nested" / "sessions.db"
+    writer = SessionDB(path)
+    writer.create_session("path-roundtrip", "test")
+    writer.close()
+    db = SessionDB(convert(path), read_only=read_only)
+    try:
+        assert db.db_path == path
+        assert isinstance(db.db_path, Path)
+        session = db.get_session("path-roundtrip")
+        assert session is not None
+        assert session["source"] == "test"
+    finally:
+        db.close()
+
+
+def test_string_path_creates_missing_parent(tmp_path):
+    path = tmp_path / "new-parent" / "sessions.db"
+    db = SessionDB(str(path))
+    try:
+        assert path.is_file()
+    finally:
+        db.close()
+
+
+def test_default_path_is_preserved(tmp_path, monkeypatch):
+    path = tmp_path / "default.db"
+    monkeypatch.setattr(hermes_state, "_default_db_path", lambda: path)
+    db = SessionDB()
+    try:
+        assert db.db_path == path
+    finally:
+        db.close()
+
+
+def test_isolation_guard_receives_normalized_path(tmp_path, monkeypatch):
+    path = tmp_path / "guarded.db"
+    seen = []
+
+    def reject(candidate):
+        seen.append(candidate)
+        raise RuntimeError("isolation sentinel")
+
+    monkeypatch.setattr(hermes_state, "_ensure_test_isolation", reject)
+    with pytest.raises(RuntimeError, match="isolation sentinel"):
+        SessionDB(str(path))
+    assert seen == [path]
+    assert not path.exists()
