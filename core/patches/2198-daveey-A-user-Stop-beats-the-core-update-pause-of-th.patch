 def interrupted_tool_result(at: float | None = None) -> str:
     """The persisted result of a tool call the update cancelled (UTC, whole seconds)."""
     stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(_now() if at is None else at))
