From 2385895f5ac46acd0461c4ce4daa8dd61f1d1e06 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 05:56:08 -0700
Subject: [PATCH] test(kanban): exercise bytecode churn at plugin record reuse
 [daveey] (#287)

---
 .../hermes_cli/test_kanban_capabilities_plugin_snapshot.py  | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py b/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py
index 2805fd10f8f..92a16cffd72 100644
--- a/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py
+++ b/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py
@@ -197,6 +197,12 @@ def test_new_plugin_dir_and_config_edit_invalidate_the_record(home):
     assert _run(home)["discoveries"] == 0
     _tool_plugin(home, "late", "late_ping", "late")
     assert _run(home)["discoveries"] == 1
+    # A concurrent importer can create bytecode after discovery recorded its inputs.
+    # That moves the plugin directory's mtime, but must not invalidate the new record.
+    plugin = home / "plugins" / "late"
+    (plugin / "__pycache__").mkdir()
+    st = plugin.stat()
+    os.utime(plugin, ns=(st.st_atime_ns, st.st_mtime_ns + 1_000_000_000))
     assert _run(home)["discoveries"] == 0
     _config(home, "platform_toolsets:\n  cli: [terminal, file]\n" + ENABLED % "late")
     assert _run(home)["discoveries"] == 1
-- 
