From 66f25fad6fc583754c71d62e49c87df812fb055c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 06:32:55 +0000
Subject: [PATCH] ci: only lift the AppArmor userns knob where the kernel has
 it [daveey]

PR #1077 run 42971425553: Blacksmith kernels have no
/proc/sys/kernel/apparmor_restrict_unprivileged_userns, so the unconditional
sysctl failed the bubblewrap step. The bwrap self-test after it still fails
closed if namespaces are unavailable.
---
 .github/workflows/plugin-catalog-ci.yml | 3 ++-
 .github/workflows/tests.yml             | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/plugin-catalog-ci.yml b/.github/workflows/plugin-catalog-ci.yml
index c164ea6499..d3edf38412 100644
--- a/.github/workflows/plugin-catalog-ci.yml
+++ b/.github/workflows/plugin-catalog-ci.yml
@@ -385,7 +385,8 @@ jobs:
         run: |
           set -euo pipefail
           sudo apt-get install -y -qq bubblewrap
-          sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
+          # Blacksmith kernels have no AppArmor userns knob (unrestricted already).
+          if [ -e /proc/sys/kernel/apparmor_restrict_unprivileged_userns ]; then sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0; fi
 
       - name: Prove the plugin validation sandbox
         if: steps.changed.outputs.files != ''
diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index 38322c29aa..d0ffa5219e 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -99,7 +99,8 @@ jobs:
         run: |
           set -euo pipefail
           command -v bwrap >/dev/null || { sudo apt-get update -qq && sudo apt-get install -y -qq bubblewrap; }
-          sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
+          # Blacksmith kernels have no AppArmor userns knob (unrestricted already).
+          if [ -e /proc/sys/kernel/apparmor_restrict_unprivileged_userns ]; then sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0; fi
           bwrap --ro-bind / / --unshare-user --unshare-pid true
 
       - name: Set up locked Python and test dependencies
-- 
2.55.0

