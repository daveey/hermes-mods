index 0000000000..34183691bb
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_replica_scope_controls.py
@@ -0,0 +1,99 @@
+"""Cross-origin freshness, legacy-fold and cache lifecycle controls. [daveey]"""
+import json
+
+import pytest
+
+from hermes_cli import kanban_replica_projection as projection
+from hermes_cli import kanban_session_activity as activity
+from tests.hermes_cli import test_kanban_replica_read_memo as memo_tests
+from tests.hermes_cli import test_kanban_replica_profile_states as profile_tests
+from tests.hermes_cli.test_kanban_remote_terminal_release import observed
+from tests.hermes_cli.test_kanban_replica_incremental import World, _ok, _scopes
+
+hub = memo_tests.hub
+as_profile = profile_tests.as_profile
+
+
+@pytest.mark.parametrize('links', [None, {}, 'bad', [None, 7, 'bad'], [
+    {'gw': 'origin', 'profile': 'a', 'session': 's', 'rel': rel}
+    for rel in ('shepherd', 'cross_task', 'create-task', 'adopt-task', 'unrelated')
+] + [
+    {'gw': 'origin', 'profile': 'b', 'session': '', 'rel': 'shepherd'},
+    {'gw': 'other', 'profile': 'b', 'session': 's', 'rel': 'unrelated'},
+    {'gw': 'other', 'profile': 'a', 'session': 's', 'rel': 'shepherd'},
+]])
+def test_link_targets_exactly_match_linked_sessions(links):
+    task = {'sessions': links}
+    targets = projection.link_targets(task)
+    assert len(targets) == len(set(targets))
+    for gateway in ('origin', 'other', 'absent'):
+        for profile in ('a', 'b', 'absent'):
+            assert ((gateway, profile) in targets) == bool(projection.linked_sessions(task, gateway, profile))
+
+
+def test_shared_alias_folds_keep_origin_and_freshness_separate(hub, as_profile):
+    path, _, _, clock = hub
+    w = World(path, clock)
+    identity = {'created_at': 500, 'created_by': 'u'}
+    task = observed(memo_tests.card('t_fold', status='done', sessions=[], title='whole title', **identity))
+    task['origin_observation']['verified'] = True
+    w.put('work/build/t_fold', json.dumps(task))
+    links = [{'gw': 'origin', 'profile': p, 'session': 's_' + p, 'rel': 'shepherd'} for p in ('a', 'b')]
+    w.put('build/t_fold', json.dumps(memo_tests.card('t_fold', profile=None, sessions=links, **identity)))
+    _scopes(path, [_ok(1000)], seq=200)
+    for seq, scopes in enumerate(([_ok(1000)], [], [_ok(1000)]), start=201):
+        _scopes(path, scopes, seq=seq)
+        for profile in ('a', 'b', 'a', 'b'):
+            as_profile(profile)
+            live, full, outs, expected = w.both()
+            assert live == full and outs == expected
+            if not scopes:
+                # An unproven terminal twin is unknown, so it cannot inherit frozen links.
+                assert live == [] and outs[3] == set()
+                continue
+            assert len(live) == 1
+            assert live[0]['session'] == 's_' + profile
+            assert live[0]['origin_profile'] == profile
+            assert live[0]['title'] == 'whole title'
+            assert live[0]['released'] is True
+    # Deleting the only link-carrying alias must remove both scopes' cards,
+    # even though the qualified shared stage is unchanged.
+    w.delete('build/t_fold')
+    for profile in ('b', 'a'):
+        as_profile(profile)
+        assert w.same() == []
+
+
+def test_reset_drops_shared_stages_and_memos(hub, as_profile):
+    path, put, _, _ = hub
+    put('t_one')
+    as_profile('unlinked')
+    activity._read_remote_links(path)
+    assert projection._shared and projection._states and activity._remote_read_memo
+    activity._reset_cache_for_tests()
+    assert not projection._shared
+    assert not projection._states
+    assert not activity._remote_read_memo
+
+
+def test_projection_lru_refresh_preserves_recent_scope(hub, as_profile, monkeypatch):
+    path, put, _, _ = hub
+    put('t_one')
+    monkeypatch.setattr(projection, '_MAX_STATES', 2)
+    for profile in ('a', 'b', 'a', 'c'):
+        as_profile(profile)
+        # Force projection rather than a higher-level memo hit.
+        activity._remote_read_memo = None
+        activity._read_remote_links(path)
+    assert set(projection._states) == {(str(path), 'origin', p) for p in ('a', 'c')}
+
+
+def test_memo_republication_refreshes_eviction_order(hub, as_profile, monkeypatch):
+    path, put, _, clock = hub
+    put('t_one')
+    monkeypatch.setattr(activity, '_REMOTE_READ_MEMOS', 2)
+    for profile in ('a', 'b', 'a', 'c'):
+        as_profile(profile)
+        clock['now'] -= 1  # rollback refuses a hit and republishes the same scope
+        activity._read_remote_links(path)
+    assert set(activity._remote_read_memo) == {(str(path), 'origin', p) for p in ('a', 'c')}
