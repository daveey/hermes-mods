From 3406dfac3694a906c855c986c157301c5cb4c9ba Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 01:05:13 +0000
Subject: [PATCH] fix(cron): retain nested grammar through redirection encoding
 [daveey]

---
 cron/lifecycle_guard_lines.py                  | 18 +++++++++++++++---
 cron/lifecycle_guard_words.py                  | 15 ++++++++++++++-
 ...t_lifecycle_guard_heredoc_frame_fallback.py |  5 ++++-
 3 files changed, 33 insertions(+), 5 deletions(-)

diff --git a/cron/lifecycle_guard_lines.py b/cron/lifecycle_guard_lines.py
index eb7db4986d86f51ee60c1801af53094ef1d0c0ec..2a452d0ff00dec398110a91f0f73bb90348e6892 100644
--- a/cron/lifecycle_guard_lines.py
+++ b/cron/lifecycle_guard_lines.py
@@ -161,7 +161,7 @@ class _HereDocs:
     def __init__(self) -> None:
         self._pending: list[tuple[str, bool]] = []
         self._arith = -1
-
+        self._bracket_end = -1
         self.unbounded = False
         self.skipped = False
 
@@ -169,8 +169,11 @@ class _HereDocs:
         """Advance on the character at *pos*; when it is the newline before complete bodies,
         return the position after them, else *pos*."""
         char = text[pos]
-        if char == "(" and self._arith < 0 and text.startswith("((", pos) and (
-                word_start or text[pos - 1] == "$"):
+        if char == "[" and _arithmetic_bracket(text, pos):
+            self._bracket_end = text.find("]", pos + 1)
+        if pos <= self._bracket_end:
+            return pos
+        if char == "(" and self._arith < 0 and text.startswith("((", pos):
             self._arith = depth
         elif char == ")" and depth - 1 == self._arith:
             self._arith = -1
@@ -187,6 +190,15 @@ class _HereDocs:
         return pos
 
 
+def _arithmetic_bracket(text: str, pos: int) -> bool:
+    """Legacy arithmetic expansion or an assignment subscript, not literal ``[``."""
+    if text[pos - 1:pos] == "$":
+        return True
+    end = text.find("]", pos + 1)
+    return end >= 0 and text.startswith(("=", "+="), end + 1) and bool(
+        re.search(r"(?:^|[\s;|(])[A-Za-z_][A-Za-z_0-9]*$", text[:pos]))
+
+
 def _newline_breaks(breaks: list[int] | None, text: str, start: int, end: int,
                     offset: int) -> None:
     if breaks is not None:
diff --git a/cron/lifecycle_guard_words.py b/cron/lifecycle_guard_words.py
index 1734b1a23952a5e2bc6dbe8c895784ba97e84672..6b36ddc90c3a6473478e51fd0561b8d5807a3923 100644
--- a/cron/lifecycle_guard_words.py
+++ b/cron/lifecycle_guard_words.py
@@ -5,6 +5,7 @@ from collections.abc import Callable
 import re
 
 from cron.lifecycle_guard_groups import split_glued_redirections
+from cron.lifecycle_guard_lines import _expansion
 
 # Optional fd or array-element fd variable, operator, and glued target.
 REDIRECTION = re.compile(
@@ -33,6 +34,7 @@ def redirection_parts(word: str, pattern: re.Pattern[str]) -> tuple[str, str, st
 
 def tokenize_redirections(line: str, tokenize: Callable[[str], list[str]],
                           pattern: re.Pattern[str]) -> list[str]:
+
     # Encode the escape character itself too, even outside quotes. A one-pass
     # decode cannot confuse literal fragments joined by quote removal with syntax.
     marker = "\ue000"
@@ -41,7 +43,18 @@ def tokenize_redirections(line: str, tokenize: Callable[[str], list[str]],
     protected: list[str] = []
     single = double = escaped = False
     quote_marker = marker + "5" + marker
-    for ch in line:
+    end = 0
+    for pos, ch in enumerate(line):
+        if pos < end:
+            continue
+        if ch == "$" and not single and not escaped and line.startswith("${", pos):
+            # Keep nested grammar intact for the tokenizer's own frame normalizer.
+            end, span = _expansion(line, pos, in_double=double, shlex_quotes=False)
+            if any(q in span for q in "\\'\""):
+                # Quoting inside the frame still makes the word quoted.
+                protected.append(quote_marker)
+            protected.append(span.replace(marker, replacements[marker]))
+            continue
         literal = single or double or escaped
         # Mark the boundary, including empty quoted pieces. The escape marker
         # itself is encoded below, so literal input cannot synthesize this tag.
diff --git a/tests/cron/test_lifecycle_guard_heredoc_frame_fallback.py b/tests/cron/test_lifecycle_guard_heredoc_frame_fallback.py
index 0bf76d1c2d4bec26a28c1071c524717765399b7c..ff3d60ed2c430ffad3583c478080993428cbffed 100644
--- a/tests/cron/test_lifecycle_guard_heredoc_frame_fallback.py
+++ b/tests/cron/test_lifecycle_guard_heredoc_frame_fallback.py
@@ -26,11 +26,14 @@ FRAMES = ['echo "${x:-$(BODY)}"', 'echo ${x:-"$(BODY)"}',
 
 
 @pytest.mark.parametrize("body,tail", ARITHMETIC)
+@pytest.mark.parametrize("outer", [False, True], ids=["root", "subshell"])
 @pytest.mark.parametrize("dangerous", [True, False], ids=["RUN", "clean"])
-def test_arithmetic_shift_is_not_a_heredoc(tmp_path, body, tail, dangerous):
+def test_arithmetic_shift_is_not_a_heredoc(tmp_path, body, tail, outer, dangerous):
     helpers._tree(tmp_path)
     cmd = "bash ./r.sh" if dangerous else "python3 ./clean.py"
     command = 'echo "${x:-$(' + body + '\n)}"; ' + cmd + '\n' + tail
+    if outer:
+        command = '(\n' + command + '\n)'
     assert helpers._bash_runs(tmp_path, command) is dangerous
     refused, reason = scan_gateway_lifecycle(command, cwd=str(tmp_path))
     assert refused is dangerous, reason
