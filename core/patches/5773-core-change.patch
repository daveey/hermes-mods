From 9b1525211b209978d812c3be2c74e88c9a6e64aa Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 16:26:17 +0000
Subject: [PATCH] [daveey] Checkpoint-keep restore tests: age the board file so
 a coarse mtime tick cannot hide the write

CI on c78de9ca61 and 0325aa546b (shard 5/12, blacksmith ubuntu-2404, Linux 6.8) failed
test_restore_with_checkpoint_in_same_interval_matches_fresh_reader with
`('b',) == ('a',)`: the watch answered from the old page although a new reader saw the
restored bytes.

Why:
1. The watch returned its stored reader with no decision at all: the main file's
   (dev, ino, mtime_ns, size) equalled the identity stored at open.
2. The restore image has the same size, so only mtime could show the write, and the
   test's final write (the PASSIVE checkpoint) set mtime back to "now".
3. Before Linux 6.13 a file's mtime is the coarse kernel clock (one tick, 1-10 ms).
   The whole test runs inside one tick on a fast runner, so "now" was the mtime the
   reader was opened with.
4. The test assumed any write moves mtime. This host (Linux 7.0, fine-grained
   timestamps) never showed it: 300 of 300 runs passed here.
5. Nothing in the test asserted its own precondition (the file moved), so the failure
   read as a wrong answer from the kept path. That path never ran.

Fix (tests only): `_two_images` ages the file by 10 s before any reader opens, so every
later write moves mtime on any clock; both restore tests assert the file moved before
they ask the watch.

Proof: forcing the checkpoint's mtime to the stored one (a scratch probe, not committed)
reproduces the CI signature exactly: answer ('b',), `sync.reader_keep/checkpoint` 0. The
file passes 21/21 here; the shrink_memory mutant (M3) is still killed by this test.

Not changed: the identity compare at kanban_sync_board_watch.py:64-67 is main's. A
same-size raw restore stamped in the reader's own mtime tick is invisible to it on main
too; this PR neither widens nor narrows that.

Hermes-Card: t_20097f02b6abaa50
---
 .../hermes_cli/test_kanban_sync_checkpoint_keep.py  | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_sync_checkpoint_keep.py b/tests/hermes_cli/test_kanban_sync_checkpoint_keep.py
index 3f28b2fed4..ff20b9b569 100644
--- a/tests/hermes_cli/test_kanban_sync_checkpoint_keep.py
+++ b/tests/hermes_cli/test_kanban_sync_checkpoint_keep.py
@@ -84,9 +84,20 @@ def _two_images(writer, path):
     writer.execute("UPDATE t SET v = 'b'")
     _checkpoint(writer, "TRUNCATE")
     assert len(path.read_bytes()) == len(image)
+    # Same size, so only mtime can show the next write, and a coarse file clock (one kernel tick,
+    # 1-10 ms before Linux 6.13) stamps a write in this same tick with this same mtime. Age the
+    # file so every later write moves it. (Observed CI failure: the checkpoint landed in the tick.)
+    stat = os.stat(path)
+    os.utime(path, ns=(stat.st_atime_ns, stat.st_mtime_ns - 10_000_000_000))
     return image
 
 
+def _moved(watch, path):
+    """The main file no longer has the (mtime, size) the kept reader was stored with."""
+    stat = os.stat(path)
+    return watch._conns[str(path)][0][2:] != (stat.st_mtime_ns, stat.st_size)
+
+
 def test_same_inode_raw_restore_reopens(board):
     path, writer, watch = board
     image = _two_images(writer, path)
@@ -97,6 +108,7 @@ def test_same_inode_raw_restore_reopens(board):
     assert state is not None  # the sidecars are there: nothing but missing proof forces the reopen
     _rewrite(path, image)
     assert evidence.read(path) == state
+    assert _moved(watch, path)
     assert watch.query(path, VALUE, unchanged_ok=True) == (gen, ("a",))
     assert _reader(watch, path) is not old
     with pytest.raises(sqlite3.ProgrammingError):
@@ -121,6 +133,7 @@ def test_restore_with_checkpoint_in_same_interval_matches_fresh_reader(board):
     finally:
         fresh.close()
     assert expected == ("a",)
+    assert _moved(watch, path)  # else the watch is never asked to choose, and no path is tested
     assert watch.query(path, VALUE)[1] == expected
     assert _reader(watch, path) is kept  # the proof held, so this exercised the kept path
     assert _runs("sync.reader_keep/checkpoint") == 1
