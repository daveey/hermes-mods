Subject: [PATCH] test(quiet): RED-on-parent coverage for review nits
 (shut-down pool submit, cancelled queued audio job, same-boot cooldown,
 expired-episode end)

---
 tests/gateway/test_quiet_control.py         |  8 +++-
 tests/hermes_cli/test_local_work_threads.py | 46 +++++++++++++++++++++
 2 files changed, 53 insertions(+), 1 deletion(-)

diff --git a/tests/gateway/test_quiet_control.py b/tests/gateway/test_quiet_control.py
index d28bd78539..d67922b39d 100644
--- a/tests/gateway/test_quiet_control.py
+++ b/tests/gateway/test_quiet_control.py
@@ -438,7 +438,13 @@ def test_token_authority_expires_with_the_lease(env):
     snap = ok(env, "quiet-observe-snapshot", follow_params(env, token))
     assert snap["valid"] is False and "lease_inactive" in snap["reasons"]
     env.control._lease_reader = None  # the lease is back, but the episode died with it
-    assert "PermissionError" in call(env, "quiet-observe-snapshot", follow_params(env, token))["error"]
+    dead = ok(env, "quiet-observe-snapshot", follow_params(env, token))
+    assert dead["valid"] is False and dead["phase"] == "ended" and dead["reasons"] == ["episode_ended"]
+    # The observer's best-effort end on the expired episode is answered, not a foreign-episode error.
+    ended = ok(env, "quiet-observe-end", follow_params(env, token))
+    assert ended["valid"] is False and ended["reasons"] == ["episode_ended"]
+    # A token that never belonged to the episode is still refused.
+    assert "PermissionError" in call(env, "quiet-observe-snapshot", follow_params(env, "forged"))["error"]
 
 
 def test_bookkeeping_handlers_do_not_reserve(env):
diff --git a/tests/hermes_cli/test_local_work_threads.py b/tests/hermes_cli/test_local_work_threads.py
index ad1d419422..d42551bee1 100644
--- a/tests/hermes_cli/test_local_work_threads.py
+++ b/tests/hermes_cli/test_local_work_threads.py
@@ -176,6 +176,52 @@ def test_failed_submit_keeps_enqueued_target_custody(tmp_path, monkeypatch):
     assert registry.snapshot().unknowns  # no optimistic recovery after uncertainty
 
 
+def test_submit_to_shut_down_pool_releases_without_latching(tmp_path):
+    """A stdlib pool refuses a submit after shutdown BEFORE enqueuing: release, no sticky unknown
+    (RED on 95089d00fb: the reservation leaked and 'submit-outcome-uncertain' latched)."""
+    registry, home = setup_owner(tmp_path)
+    pool = ThreadPoolExecutor(max_workers=1)
+    pool.shutdown(wait=True)
+    with pytest.raises(RuntimeError, match="shutdown"):
+        submit_tracked(pool, lambda: None, registry=registry, home=home, source="after-shutdown")
+    snap = registry.snapshot()
+    assert snap.active == 0 and snap.unknowns == ()
+
+
+def test_audio_cancelled_queued_job_releases_and_never_runs(tmp_path, monkeypatch):
+    """hermes_cli.web_routers.audio._run_reserved: cancelling the awaiting request while the job is
+    still queued releases the reservation, and the job never runs (RED on 95089d00fb: token leaked)."""
+    from hermes_cli import local_work
+    from hermes_cli.web_routers import audio
+
+    registry, home = setup_owner(tmp_path)
+    monkeypatch.setattr(local_work, "_registry", registry)
+    monkeypatch.setenv("HERMES_HOME", home)
+    entered, release, ran = threading.Event(), threading.Event(), threading.Event()
+
+    async def scenario():
+        loop = asyncio.get_running_loop()
+        pool = ThreadPoolExecutor(max_workers=1)
+        loop.set_default_executor(pool)
+        blocker = loop.run_in_executor(None, lambda: (entered.set(), release.wait(5)))
+        assert entered.wait(5)
+        task = asyncio.ensure_future(audio._run_reserved("test.audio", ran.set))
+        await asyncio.sleep(0.05)
+        assert registry.snapshot().active == 1
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        assert registry.snapshot().active == 0
+        release.set()
+        await blocker
+        pool.shutdown(wait=True)
+
+    asyncio.run(scenario())
+    assert not ran.is_set()
+    snap = registry.snapshot()
+    assert snap.active == 0 and snap.unknowns == ()
+
+
