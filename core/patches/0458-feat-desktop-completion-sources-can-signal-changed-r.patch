From fb72ad495b32aefba0c4e79e67985107b807ddda Mon Sep 17 00:00:00 2001
From: x <x@example.com>
Date: Tue, 27 Oct 2026 00:17:01 -0700
Subject: [PATCH] feat(desktop): @ completion sources can signal changed rows
 so an open popover re-asks

ComposerAtCompletionSource gains optional subscribe(onChange). useAtCompletions
subscribes to every contributed source and bumps the live adapter's epoch, so a
popover open on an unchanged query picks up rows a source fetched in the
background instead of waiting for the next keystroke.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/desktop/src/app/chat/composer/contrib.ts |  5 +++
 .../hooks/use-at-completions-contrib.test.tsx | 35 +++++++++++++++++++
 .../chat/composer/hooks/use-at-completions.ts | 34 ++++++++++++++++--
 3 files changed, 72 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/app/chat/composer/contrib.ts b/apps/desktop/src/app/chat/composer/contrib.ts
index 96c0d5432a..93767a8fe0 100644
--- a/apps/desktop/src/app/chat/composer/contrib.ts
+++ b/apps/desktop/src/app/chat/composer/contrib.ts
@@ -77,6 +77,11 @@ export interface ComposerAtCompletionItem {
  *  lookups belong behind the source's own cache. */
 export interface ComposerAtCompletionSource {
   provide: (query: string) => ComposerAtCompletionItem[]
+  /** Optional: call `onChange` when rows `provide` would return have changed
+   *  (e.g. a background fetch behind the source's cache landed). An open
+   *  popover re-asks for its current query; without this it keeps what it
+   *  got on the last keystroke. Returns an unsubscribe function. */
+  subscribe?: (onChange: () => void) => () => void
 }
 
 export interface ComposerAttachmentContext {
diff --git a/apps/desktop/src/app/chat/composer/hooks/use-at-completions-contrib.test.tsx b/apps/desktop/src/app/chat/composer/hooks/use-at-completions-contrib.test.tsx
index e931dd7805..2cfcfe5fd5 100644
--- a/apps/desktop/src/app/chat/composer/hooks/use-at-completions-contrib.test.tsx
+++ b/apps/desktop/src/app/chat/composer/hooks/use-at-completions-contrib.test.tsx
@@ -183,4 +183,39 @@ describe('contributed @ completion sources', () => {
     expect(rows[0]).toBe('@researcher')
     expect(rows.length).toBeGreaterThan(1)
   })
+  it('re-asks an open popover when a source signals its rows changed', async () => {
+    vi.useFakeTimers()
+    let rows: Array<{ insert: string; meta?: string }> = []
+    const listeners = new Set<() => void>()
+
+    disposers.push(
+      registry.register({
+        id: 'sessions',
+        area: COMPOSER_AREAS.atCompletions,
+        data: {
+          provide: () => rows,
+          subscribe: (onChange: () => void) => {
+            listeners.add(onChange)
+
+            return () => listeners.delete(onChange)
+          }
+        } satisfies ComposerAtCompletionSource
+      })
+    )
+
+    const { result, unmount } = renderHook(() =>
+      useAtCompletions({ gateway: gatewayStub([]) as never, sessionId: 's1', cwd: '/repo' })
+    )
+
+    expect(await searchAndRead(result, 'the')).not.toContain('@runners-panel')
+
+    // The source's background fetch lands; the query in the popover is unchanged.
+    rows = [{ insert: '@runners-panel', meta: 'Session' }]
+    act(() => listeners.forEach(fn => fn()))
+
+    expect(await searchAndRead(result, 'the')).toContain('@runners-panel')
+
+    unmount()
+    expect(listeners.size).toBe(0)
+  })
 })
diff --git a/apps/desktop/src/app/chat/composer/hooks/use-at-completions.ts b/apps/desktop/src/app/chat/composer/hooks/use-at-completions.ts
index 505e0e646e..511329401e 100644
--- a/apps/desktop/src/app/chat/composer/hooks/use-at-completions.ts
+++ b/apps/desktop/src/app/chat/composer/hooks/use-at-completions.ts
@@ -1,5 +1,5 @@
 import type { Unstable_TriggerAdapter, Unstable_TriggerItem } from '@assistant-ui/core'
-import { useCallback } from 'react'
+import { useCallback, useEffect, useState } from 'react'
 
 import { refChipLabel } from '@/components/assistant-ui/directive-text'
 import { useContributions } from '@/contrib/react/use-contributions'
@@ -133,6 +133,36 @@ export function useAtCompletions(options: {
 
   const contributed = useContributions(COMPOSER_AREAS.atCompletions)
 
+  // A source whose rows change behind its cache (a background fetch landed)
+  // signals through `subscribe`; bumping the adapter's epoch makes an open
+  // popover re-ask for the query it is showing instead of serving stale rows.
+  const [sourceEpoch, setSourceEpoch] = useState(0)
+
+  useEffect(() => {
+    const bump = () => setSourceEpoch(n => n + 1)
+    const unsubscribers: Array<() => void> = []
+
+    for (const contribution of contributed) {
+      const source = contribution.data as ComposerAtCompletionSource | undefined
+
+      if (typeof source?.subscribe !== 'function') {
+        continue
+      }
+
+      try {
+        const off = source.subscribe(bump)
+
+        if (typeof off === 'function') {
+          unsubscribers.push(off)
+        }
+      } catch {
+        /* a broken source must not take down @ completions */
+      }
+    }
+
+    return () => unsubscribers.forEach(off => off())
+  }, [contributed])
+
   // Contributed rows for the query, mapped into the gateway entry shape so
   // one classify/toItem path renders every row. Provider errors are isolated:
   // a throwing source drops ITS rows, never the popover.
@@ -267,7 +297,7 @@ export function useAtCompletions(options: {
   // nothing when the answer is already in hand.
   const isCached = useCallback((query: string) => hasCachedPathCompletion(cacheKey(query)), [cacheKey])
 
-  return useLiveCompletionAdapter({ enabled, fetcher, isCached, toItem })
+  return useLiveCompletionAdapter({ enabled, epoch: sourceEpoch, fetcher, isCached, toItem })
 }
 
 /** Re-export `classify` for use by the formatter (insertion side). */
