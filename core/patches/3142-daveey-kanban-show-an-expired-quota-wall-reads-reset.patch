@@ -100,11 +100,11 @@ def _observation(payload: dict[str, Any]) -> str:
 
 
 def _options(parent_id: str, evidence: Optional[dict[str, Any]] = None,
-             payload: Optional[dict[str, Any]] = None) -> str:
