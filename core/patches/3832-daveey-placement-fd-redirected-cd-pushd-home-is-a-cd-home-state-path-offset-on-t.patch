From f77225df8808e0a26f0b73ae3589d29e61580e4b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:39:33 +0000
Subject: [PATCH] [daveey] placement: fd-redirected cd/pushd home is a cd home;
 _state_path offset on the original span

Follow-up to PR #2533 (independent exact-head review at e588aae926, card t_01a1d6458c834a09, nits 1-2).
Both gaps fell back to the weaker placement outcome.

1. kanban_placement._CD_HOME: the lookahead after the home word took `>` but not a redirect that starts
   with an fd number, so `cd ~ 2>/dev/null && cat .hermes/.env` and `pushd ~ 2>/dev/null && ...` were
   not state paths. _CMD_END now also accepts `[ \t]+\d+>`. Whitespace is required before the fd digit, so
   `cd ~2>x` / `cd ~/2>x` (a literal dir word) stay portable. `&>` was already covered by `&`.

2. kanban_home_marker_placement._state_path: the offset came from `match.group(0).lower().rfind(...)`,
   but `str.lower()` can change length (`"\u0130".lower()` is 2 code points). The shifted offset made
   `_REL_STATE.match` return None, so the hit fell back to the whole cd..path span and skipped the
   own-artifact probe. It now takes the last case-insensitive `.hermes/` hit on the original span (_last_rel_state, used for every cd-home hit).

Tests (tests/hermes_cli/test_kanban_state_path_home_forms.py):
- RED on base 0324054f56 (rebased past c0bf2d0f0b, resolved onto its _CMD_END): 4 failed (pushd ~ 2>, cd ~ 2>, cd $HOME 2>&1, and the \u0130 _state_path row).
- GREEN: test_kanban_state_path_home_forms + test_kanban_hub_read_roots + test_kanban_placement +
  test_kanban_pool_queue: 559 passed.
---
 hermes_cli/kanban_home_marker_placement.py    | 12 +++++++---
 hermes_cli/kanban_placement.py                |  3 ++-
 .../test_kanban_state_path_home_forms.py      | 23 +++++++++++++++----
 3 files changed, 30 insertions(+), 8 deletions(-)

diff --git a/hermes_cli/kanban_home_marker_placement.py b/hermes_cli/kanban_home_marker_placement.py
index 9d587b873e..649deeb312 100644
--- a/hermes_cli/kanban_home_marker_placement.py
+++ b/hermes_cli/kanban_home_marker_placement.py
@@ -118,6 +118,13 @@ def _worktree(pattern, match, gateway, probe):
             yield "queue", "worktree-not-here", root, (), NOTES["path"].format(hit=root, gateway=gateway)
 
 
+def _last_rel_state(match):
+    # ``_REL_STATE`` at the span's last ``.hermes/``, found on the original text: ``str.lower()`` can change the
+    # length (``"\u0130".lower()`` is 2 code points), which would shift an offset taken on a lowered copy.
+    last = [m.start() for m in re.finditer(r"\.hermes/", match.group(0), re.IGNORECASE)][-1:]
+    return _REL_STATE.match(match.string, match.start() + last[0]) if last else None
+
+
 def _state_path(pattern, match, gateway, probe):
     from hermes_cli import kanban_placement as kp
     # ``$HOME``/``${HOME}`` prefixes too (kp.HOME_PREFIX). Every relative ``.hermes/<p>`` after a cd home reads as
@@ -127,11 +134,10 @@ def _state_path(pattern, match, gateway, probe):
     state = re.compile(kp.HOME_PREFIX + _STATE.pattern[len(_HOME):])
     found = [m.group(0) for m in state.finditer(text)]
     for m in re.finditer(kp.HERMES_STATE_PATH, text, re.IGNORECASE):
-        if re.match(kp._CD_HOME, m.group(0)) and (rel := _REL_STATE.match(
-                text, m.start() + m.group(0).lower().rfind(".hermes/"))):
+        if re.match(kp._CD_HOME, m.group(0)) and (rel := _last_rel_state(m)):
             found.append("~/" + rel.group(0))
     paths = [p for p in map(_clean, found) if re.match(kp.HERMES_STATE_PATH, p)]
-    rel = _REL_STATE.match(text, match.start() + match.group(0).lower().rfind(".hermes/"))
+    rel = _last_rel_state(match)
     for raw in dict.fromkeys(paths) or [_clean("~/" + rel.group(0)) if rel else match.group(0)]:
         if art := _ARTIFACT.search(raw):
             # health: allow HX001 -- the card text names ~/.hermes literally; probe that same path on this worker
diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 9fdc7e910f..9b723dc953 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -586,7 +586,8 @@ def _heavy_marker(title: str, body: str, cfg: _Cfg) -> Optional[str]:
 # or ``cd .hermes`` after a cd home) counts too (review 5895947424). A bare ``~/.hermes`` anywhere else does not:
 # "the hermes-agent tree under ~/.hermes" is ordinary repo work and must reach the worker pool (9328cbc2d9b).
 HOME_PREFIX = r"(?:~|/home/[^/\s]+|\$HOME\b|\$\{HOME\}|\"\$HOME\"|\"\$\{HOME\}\")"
-_CMD_END = r"(?=[ \t]*(?:$|[\n;&|)>])|[ \t]+#)"
+# ``cd ~ 2>/dev/null`` ends the cd too (an fd-numbered redirect); ``cd ~2>x`` is a dir word, not a redirect.
+_CMD_END = r"(?=[ \t]*(?:$|[\n;&|)>])|[ \t]+(?:#|\d+>))"
 _CD_HOME = (r"(?<![\w./-])(?-i:cd(?:[ \t]+" + HOME_PREFIX + r"/?)?|pushd[ \t]+" + HOME_PREFIX + r"/?)" + _CMD_END)
 _CHDIR = r"(?<![\w./-])(?-i:cd|pushd|popd)(?![\w.-])(?![ \t]+[\"']?(?:\./)?\.hermes(?![\w.-]))"
 _CD_INTO = r"(?<![\w./-])(?-i:cd|pushd)[ \t]+[\"']?"
diff --git a/tests/hermes_cli/test_kanban_state_path_home_forms.py b/tests/hermes_cli/test_kanban_state_path_home_forms.py
index 39f1c2a7f3..29bd644b3f 100644
--- a/tests/hermes_cli/test_kanban_state_path_home_forms.py
+++ b/tests/hermes_cli/test_kanban_state_path_home_forms.py
@@ -85,6 +85,11 @@ def test_tilde_root_path_still_clears(attested):
     "pushd ~ && cat .hermes/.env",
     "pushd $HOME >/dev/null; cat .hermes/.env",
     "pushd /home/ubuntu\ncat .hermes/state.db",
+    # PR #2533 review: a redirect that starts with an fd number (or ``&>``) after the home word.
+    "pushd ~ 2>/dev/null && cat .hermes/.env",
+    "cd ~ 2>/dev/null && cat .hermes/.env",
+    "cd $HOME 2>&1 >/dev/null; cat .hermes/.env",
+    "cd ~ &>/dev/null && cat .hermes/.env",
 ])
 def test_pushd_and_commented_cd_home_are_state_paths(body):
     assert _hit(body)
@@ -96,6 +101,9 @@ def test_pushd_and_commented_cd_home_are_state_paths(body):
     "pushd && cat .hermes/.env",
     "cd ~#x && cat .hermes/.env",
     "popd ~ && cat .hermes/.env",
+    # No space: ``~2`` / ``~/2`` is a literal directory word, not home plus a ``2>`` redirect.
+    "cd ~2>x && cat .hermes/.env",
+    "cd ~/2>x && cat .hermes/.env",
 ])
 def test_prose_cd_and_non_home_pushd_stay_portable(body):
     assert not _hit(body)
@@ -111,10 +119,17 @@ def test_many_cd_home_lines_without_a_state_path_scan_in_linear_time():
     assert time.perf_counter() - start < 0.5
 
 
-def test_relative_state_path_hit_is_the_home_path_not_the_cd_span():
+@pytest.mark.parametrize("body, cls, path", [
+    ("cd ~ && make all && cat .hermes/logs/x.log", "b", "~/.hermes/logs/x.log"),
+    # PR #2533 review: ``"\u0130".lower()`` is two code points, so an offset taken on the lowered span shifted.
+    ("cd ~ && make all \u0130 && cat .hermes/kanban/workspaces/t_x/f", "artifact-not-here",
+     "~/.hermes/kanban/workspaces/t_x/f"),
+])
+def test_relative_state_path_hit_is_the_home_path_not_the_cd_span(body, cls, path, tmp_path, monkeypatch):
     from hermes_cli import kanban_home_marker_placement as hm
 
-    match = _hit("cd ~ && make all && cat .hermes/logs/x.log")
-    [(decision, cls, hit, labels, note)] = hm._state_path(kp.HERMES_STATE_PATH, match, "worker-2", hm._Probe())
-    assert (decision, cls, hit, labels) == ("queue", "b", "~/.hermes/logs/x.log", ("capability:hub-write",))
+    monkeypatch.setenv("HOME", str(tmp_path))  # the own-artifact probe must not find a real workspace file
+    match = _hit(body)
+    [(decision, got_cls, hit, labels, note)] = hm._state_path(kp.HERMES_STATE_PATH, match, "worker-2", hm._Probe())
+    assert (decision, got_cls, hit, labels) == ("queue", cls, path, ("capability:hub-write",))
     assert "make all" not in note
