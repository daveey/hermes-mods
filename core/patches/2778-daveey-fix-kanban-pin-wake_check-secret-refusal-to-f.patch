From 83d038a67f5af3c245d3c73eaf4f50636128d064 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 14:28:06 +0000
Subject: [PATCH] [daveey] fix(kanban): pin wake_check secret refusal to
 force=True; keep its text intact under the redactor

Gap 1 (surviving mutant M8, verification t_01a1d0154aac633e): secret_error() calls
redact_sensitive_text(cmd, force=True). Flipping it to force=False left all 40 tests green, yet with
redaction off (HERMES_REDACT_SECRETS=false / security.redact_secrets: false) both park paths would
store and run an inline secret. New tests disable redaction both ways (env var + agent.redact
._REDACT_ENABLED) and assert secret_error, `hermes kanban schedule --wake-check` and the tool
kanban_schedule still refuse with wake_check_secret. RED under M8 (9 failed), GREEN on main.

Gap 2: the refusal named the assignment as ``at `OPENAI_API_KEY=`. Probes...``; the output
redactor read ``=`.`` as a value and printed ``OPENAI_API_KEY=*** Probes``. The name is now given
without ``=``. At a line start the YAML pass also masked the word after the code
(``wake_check_secret: ***``), so ``wake_check_secret`` joins IDENTIFIER_KEY_NAMES (a refusal code,
not a credential). Test: redact_sensitive_text(secret_error(p), force=True) == secret_error(p)
for 7 probe shapes (RED on main, GREEN now). The shared module stays the single check.

Kanban: t_01a1d01fc03b9e63
---
 agent/redact_identifier_keys.py               |   4 +
 hermes_cli/kanban_wake_check_secret.py        |   6 +-
 .../test_kanban_cli_probe_secret.py           |   2 +-
 .../test_kanban_wake_check_secret_forced.py   | 104 ++++++++++++++++++
 4 files changed, 113 insertions(+), 3 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_wake_check_secret_forced.py

diff --git a/agent/redact_identifier_keys.py b/agent/redact_identifier_keys.py
index 66038ae4dc..969bdfc010 100644
--- a/agent/redact_identifier_keys.py
+++ b/agent/redact_identifier_keys.py
@@ -7,9 +7,13 @@ the list, and every credential name (``api_key``, ``secret_key``, ``private_key`
 ``primary_key``/``secondary_key`` are deliberately absent: Azure names its shared-access keys that way (azurerm
 ``*.primary_key``, azure-mgmt ``AccessKeys.primary_key``). A dotted name is judged on its last segment, so
 ``cosmos.primary_key=`` masks too.
+
+``wake_check_secret`` is a Kanban refusal code, not a credential: its message starts ``wake_check_secret: this
+wake_check ...``, and at a line start the YAML pass read that as an assignment and masked ``this``.
 """
 from __future__ import annotations
 
 IDENTIFIER_KEY_NAMES = frozenset({
     "idempotency_key", "cache_key", "sort_key", "partition_key", "dedupe_key", "dedup_key",
+    "wake_check_secret",
 })
diff --git a/hermes_cli/kanban_wake_check_secret.py b/hermes_cli/kanban_wake_check_secret.py
index 47b08303cc..7a32ad6680 100644
--- a/hermes_cli/kanban_wake_check_secret.py
+++ b/hermes_cli/kanban_wake_check_secret.py
@@ -16,7 +16,9 @@ WAKE_CHECK_SECRET = "wake_check_secret"
 
 def secret_error(cmd: str) -> Optional[str]:
     """Refusal text when ``redact_sensitive_text(cmd, force=True)`` would change ``cmd``, else None.
-    The message names only the redacted assignment, never the value."""
+    The message names the redacted assignment without its ``=`` (the output redactor read ``NAME=`.`` as an
+    assignment and masked the rest of the sentence), never the value. ``force=True`` is the check itself: a host
+    with redaction off (``security.redact_secrets: false``) refuses the same probes."""
     from agent.redact import redact_sensitive_text
 
     redacted = redact_sensitive_text(str(cmd), force=True)
@@ -28,7 +30,7 @@ def secret_error(cmd: str) -> Optional[str]:
         if op == "equal":
             continue
         m = re.match(r"^['\"]?([A-Za-z0-9_.\-]+)\s*=", red[b1]) if b1 < b2 else None
-        names.append(f"`{m.group(1)}=`" if m else f"the value after `{raw[a1 - 1]}`" if a1 else "its first word")
+        names.append(f"`{m.group(1)}`" if m else f"the value after `{raw[a1 - 1]}`" if a1 else "its first word")
     return (f"{WAKE_CHECK_SECRET}: this wake_check contains a secret or credential-shaped value at "
             f"{', '.join(names[:3])}. Probes run exactly as stored and the board never stores a "
             "secret, so it was not stored, run or masked. Never inline a secret in a probe: read it from env "
diff --git a/tests/hermes_cli/test_kanban_cli_probe_secret.py b/tests/hermes_cli/test_kanban_cli_probe_secret.py
index 4b3c6ce4a3..1fe068a613 100644
--- a/tests/hermes_cli/test_kanban_cli_probe_secret.py
+++ b/tests/hermes_cli/test_kanban_cli_probe_secret.py
@@ -74,7 +74,7 @@ def test_cli_park_with_inline_secret_is_refused_and_stores_nothing(kanban_home,
     rc = _run(verb[0], tid, *verb[1:], "--wake-check", SECRET_PROBE)
     out = capsys.readouterr()
     assert rc == 2
-    assert "wake_check_secret" in out.err and "OPENAI_API_KEY=" in out.err
+    assert "wake_check_secret" in out.err and "`OPENAI_API_KEY`" in out.err
     assert SECRET not in out.err + out.out  # the refusal never echoes the secret
     cmd, events, comments, status = _stored(tid)
     assert cmd is None and status == "running"
diff --git a/tests/hermes_cli/test_kanban_wake_check_secret_forced.py b/tests/hermes_cli/test_kanban_wake_check_secret_forced.py
new file mode 100644
index 0000000000..40ab855b7b
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_wake_check_secret_forced.py
@@ -0,0 +1,104 @@
+"""The wake_check secret refusal holds with redaction off, and its text survives the output redactor. [daveey]
+
+``secret_error`` asks ``redact_sensitive_text(cmd, force=True)`` whether a probe carries a secret. With
+``force=False`` (mutant M8, verification t_01a1d0154aac633e) the answer follows ``security.redact_secrets`` /
+``HERMES_REDACT_SECRETS``, so on a host with redaction off both park paths (tool and CLI) stored and ran an
+inline secret, and no test ran with redaction off. Separately, the refusal named the assignment as
+``at `OPENAI_API_KEY=`. Probes...``: the CLI's output redactor read ``=`.`` as an assigned value and printed
+``at `OPENAI_API_KEY=*** Probes...``, and at a line start the YAML pass read the code ``wake_check_secret: this``
+as an assignment and masked ``this``. The name is now given without ``=``, the refusal code is an identifier
+name the redactor keeps, and the text is a redaction fixpoint.
+"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from agent import redact
+from hermes_cli.kanban_wake_check_secret import secret_error
+from tests.hermes_cli import test_kanban_cli_probe_secret as cli
+from tests.hermes_cli.test_kanban_cli_probe_secret import SECRET, SECRET_PROBE, UNTIL, _run, _running, _stored
+
+kanban_home = cli.kanban_home  # the CLI suite's isolated board fixture
+
+PROBES = [
+    SECRET_PROBE,
+    "api_key='sk-" + "Zq9" * 12 + "' curl -sf https://api.example.com/ready",
+    "AWS_SECRET_ACCESS_KEY=" + "wJalrXUtnFEMI/K7MDENG/bPxRfiCY" + "EXAMPLEKEY" + " aws s3 ls",
+    "PRIMARY_KEY=" + "Zm9vYmFyYmF6cXV4" * 5 + "K3Rlc3Q=" + " az storage ls",
+    'curl -sf -H "Authorization: Bearer ' + "ghp_" + "A1b2" * 10 + '" https://api.github.com/x',
+    "ghp_" + "A1b2" * 10 + " | grep -q ok",
+    "GITHUB_TOKEN=ghp_" + "A1b2" * 10 + " OPENAI_API_KEY=" + SECRET + " gh pr view 1",
+]
+
+
+@pytest.fixture
+def redaction_off(monkeypatch):
+    """Redaction disabled both ways a host can: the env var (read at import) and the module snapshot."""
+    monkeypatch.setenv("HERMES_REDACT_SECRETS", "false")
+    monkeypatch.setattr(redact, "_REDACT_ENABLED", False)
+    assert redact.redact_sensitive_text(SECRET_PROBE) == SECRET_PROBE  # the switch is really off
+
+
+@pytest.mark.parametrize("probe", PROBES)
+def test_secret_error_refuses_with_redaction_off(redaction_off, probe):
+    err = secret_error(probe)
+    assert err and err.startswith("wake_check_secret:")
+
+
+def test_cli_schedule_refuses_with_redaction_off(kanban_home, redaction_off, capsys):
+    from hermes_cli import kanban_db_connect as kbc
+    with kbc.connect_closing() as conn:
+        tid = _running(conn)
+    capsys.readouterr()
+    rc = _run("schedule", tid, UNTIL, "--wake-check", SECRET_PROBE)
+    out = capsys.readouterr()
+    assert rc == 2
+    assert "wake_check_secret" in out.err and SECRET not in out.err + out.out
+    cmd, events, _comments, status = _stored(tid)
+    assert cmd is None and status == "running" and not any(SECRET in e for e in events)
+
+
+def test_tool_schedule_refuses_with_redaction_off(redaction_off, monkeypatch, tmp_path):
+    from pathlib import Path
+
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    from tools import kanban_tools as kt
+
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_PROFILE", "test-worker")
+    monkeypatch.setenv("HERMES_KANBAN_WAKE_DRYRUN", "0")
+    monkeypatch.delenv("HERMES_SESSION_ID", raising=False)
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="worker-test", assignee="test-worker")
+        kb.claim_task(conn, tid)
+        run_id = kb._current_run_id(conn, tid)
+    monkeypatch.setenv("HERMES_KANBAN_TASK", tid)
+    monkeypatch.setenv("HERMES_KANBAN_RUN_ID", str(run_id))
+
+    d = json.loads(kt._handle_schedule({"reason": f"{UNTIL} waiting on the api", "wake_check": SECRET_PROBE,
+                                        "awaiting": {"kind": "external", "ref": "api", "why": "it comes up"}}))
+    assert "wake_check_secret" in json.dumps(d), d
+    assert SECRET not in json.dumps(d)
+    cmd, events, _comments, status = _stored(tid)
+    assert cmd is None and status == "running" and not any(SECRET in e for e in events)
+
+
+@pytest.mark.parametrize("probe", PROBES)
+def test_refusal_text_is_stable_under_the_output_redactor(probe):
+    err = secret_error(probe)
+    assert err
+    assert redact.redact_sensitive_text(err, force=True) == err
+
+
+def test_refusal_names_the_assignment_without_its_value():
+    err = secret_error(SECRET_PROBE)
+    assert err and "at `OPENAI_API_KEY`." in err
+    assert SECRET not in err
-- 
