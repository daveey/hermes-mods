From 8e9f6218b5c080ae06e5dfe53e97b78d6c6de93c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:05:01 +0000
Subject: [PATCH] [daveey] kanban pickup-stall held alarm: pin stranded()'s
 truthy-hold read

Post-merge check t_01a1d666580d271c (sweep-1857 A) of PR #2526: mutant P2 in
hermes_cli/kanban_pickup_stall_held.py stranded(),
`not entry.get("hold")` -> `entry.get("hold") is not True` (the pre-#2526 read),
survived test_kanban_pickup_stall_lifted.py + test_kanban_pickup_stall_held.py.
Under it a held machine with a non-bool truthy hold ("yes") lists no stranded
default-board cards, so the held-machine alarm never fires, while pickup's
eligible() treats the machine as held. Same point as review 5896490321's nit.

Test-only: a parametrized case asserts stranded() lists the waiting card for
hold="yes" and nothing for the falsy hold="" control (and that eligible() agrees).

Proof (hermes-core-wt test, both files):
- origin/main + test: 16 passed, 0 failed, 0 skipped
- P2 alone + test: 15 passed, 1 failed:
  test_stranded_reads_the_hold_by_truthiness_like_pickup[yes-True]
  (assert [] == ['t_...']); the "" control passes under both.

Card: t_01a1d67f4808ad0d
---
 .../test_kanban_pickup_stall_held.py           | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_pickup_stall_held.py b/tests/hermes_cli/test_kanban_pickup_stall_held.py
index effd0178ef..0c3de90c68 100644
--- a/tests/hermes_cli/test_kanban_pickup_stall_held.py
+++ b/tests/hermes_cli/test_kanban_pickup_stall_held.py
@@ -190,6 +190,24 @@ def test_no_alarm_once_the_card_left_default_placement_or_the_hold_ended(pair):
     assert not _repairs(held.conn)
 
 
+@pytest.mark.parametrize("hold,listed", [("yes", True), ("", False)])
+def test_stranded_reads_the_hold_by_truthiness_like_pickup(pair, hold, listed):
+    """Pickup's ``eligible()`` treats any truthy ``hold`` as held (PR #2526). ``stranded()`` must read it the same
+    way: a ``"yes"`` hold strands the default card (the alarm fires), a falsy ``""`` hold strands nothing. An
+    ``is not True`` read listed nothing for ``"yes"``, so the alarm never fired while pickup held the machine."""
+    held, _free, t0, _reg = pair
+    tid = _own_card(held)
+    held.enter()
+    from hermes_cli import kanban_pickup_stall as kps
+    from hermes_cli import kanban_pickup_stall_held as kpsh
+    machines = _machines(t0)
+    machines[HELD]["hold"] = hold
+    assert (wn.eligible({"runs_on": None, "created_on": HELD}, HELD, machines) is not None) is listed
+    later_ms = int((t0 + kps.stall_seconds() + 60) * 1000)
+    got = kpsh.stranded(held.conn, HELD, machines, now_ms=later_ms, stall_s=kps.stall_seconds())
+    assert [c["id"] for c in got] == ([tid] if listed else [])
+
+
 def test_a_worktree_card_is_never_listed(pair):
     held, _free, t0, _reg = pair
     held.enter()
