Subject: [PATCH 6716] Producer chat-link reconciliation without display feedback

Public mirror of source commit a42ae95579e9bb4e68d3433b5df4e91486384f61.

---
diff --git a/tests/hermes_cli/test_kanban_chat_links_parity.py b/tests/hermes_cli/test_kanban_chat_links_parity.py
index 3498fe5464f6304c56ffce8f1d2530a57600e64b..e59fb74761fe4ad775f4496c5755def060651cc9 100644
--- a/tests/hermes_cli/test_kanban_chat_links_parity.py
+++ b/tests/hermes_cli/test_kanban_chat_links_parity.py
@@ -37,6 +37,8 @@
     monkeypatch.setattr(ksc, "shadow_path", lambda slug: tmp_path / "shadow" / f"{slug}.db")
     ledger: list[dict] = []
     monkeypatch.setattr(ksa, "_remote_links", lambda stale_ok=False: list(ledger))
+    # This synthetic ledger is already the complete producer view.
+    monkeypatch.setattr(ksa, "remote_links_and_origin_rows", lambda stale_ok=False: (list(ledger), []))
     ksa._reset_cache_for_tests()
     getattr(links, "_reset_for_tests", lambda: None)()
     yield {"tmp": tmp_path, "home": home, "ledger": ledger, "replicas": replicas}
diff --git a/tests/hermes_cli/test_kanban_terminal_carry.py b/tests/hermes_cli/test_kanban_terminal_carry.py
index 8f40fc0fe938a840a1994dd0356d4825fbd04458..d792302240dc1a498fb15dbaf26c5f8d1e31ed44 100644
--- a/tests/hermes_cli/test_kanban_terminal_carry.py
+++ b/tests/hermes_cli/test_kanban_terminal_carry.py
@@ -298,7 +298,8 @@
     support.write_sync_config(home, True)
     conn = kbc.connect(home / 'live.db')
     sync.ensure_identity(conn, 'default', 'origin')
-    monkeypatch.setattr(activity, '_remote_links', lambda: carry.reconcile_carry([w['card']]))
+    monkeypatch.setattr(activity, 'remote_links_and_origin_rows',
+                        lambda: (carry.reconcile_carry([w['card']]), []))
     try:
         links.reconcile(conn, 'default', 'origin')
         assert conn.execute("SELECT released FROM task_chat_links WHERE kind='shepherd'").fetchone()[0] == 0
