From 9b77743e869d15a755e69dd5b3d1655be623d3b7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 01:39:45 +0000
Subject: [PATCH] fix(update-pause): a /goal continuation waits for a
 core-update-paused turn instead of overwriting its marker [daveey]

_run_post_turn_followups claimed the session directly for a goal continuation
(bypassing _notif_claim_turn and update_pause.continuation_due) and the turn was
not synthesized, so after a notice turn carried a paused marker the goal tick
recorded its own marker over it and retired it: the paused request was replaced,
not continued. Skip the goal tick while a pause marker is carried/held or its
continuation is due; the paused turn's continuation re-runs the goal judge.

Tests: test_update_pause_superseded.py (RED before, GREEN after; control case
proves the goal still continues once the pause is retired). Card t_01a18533d0a0182d.
---
 .../test_update_pause_superseded.py           | 56 +++++++++++++++++++
 tui_gateway/prompt_turn.py                    | 18 ++++++
 2 files changed, 74 insertions(+)

diff --git a/tests/tui_gateway/test_update_pause_superseded.py b/tests/tui_gateway/test_update_pause_superseded.py
index 9a30c1a1ce..70fe5122d4 100644
--- a/tests/tui_gateway/test_update_pause_superseded.py
+++ b/tests/tui_gateway/test_update_pause_superseded.py
@@ -182,3 +182,59 @@ def test_fresh_backend_notification_turn_refused_at_prepare_still_rearms_the_wat
     monkeypatch.setattr(server, "_prepare_turn_input", lambda *a, **k: None)
     server._notif_run_submit("__notif__1", "ui-sid", session, "[Background process proc_1 finished]")
     _assert_paused_turn_continues(env, session)
+
+
+# --- /goal continuation after a carried notice turn (t_01a18533d0a0182d). _run_post_turn_followups claimed the
+# session directly for the goal continuation (no _notif_claim_turn gate) and did not mark it synthesized, so it
+# wrote its own marker over the paused one and retired it: the paused request was replaced, not continued.
+
+def _goal_after(monkeypatch, prompts):
+    """The goal judge asks for a continuation after every turn whose prompt is in ``prompts``."""
+    def _fake(sid, session, result, status, raw):
+        return "[goal] keep going" if session.get("_test_last_prompt") in prompts else None
+    real_submit = server._run_prompt_submit
+
+    def _spy(rid, sid, session, text, *a, **kw):
+        session["_test_last_prompt"] = text
+        session.setdefault("_test_prompts", []).append(text)
+        return real_submit(rid, sid, session, text, *a, **kw)
+
+    monkeypatch.setattr(server, "_goal_followup_after_turn", _fake)
+    monkeypatch.setattr(server, "_run_prompt_submit", _spy)
+
+
+def test_goal_continuation_after_a_carried_notice_turn_keeps_the_paused_turn(env, monkeypatch):
+    session = _paused_session(env.home)
+    notice = "[Background process proc_1 finished]"
+    _goal_after(monkeypatch, {notice})
+
+    session["running"] = True  # the notification poller claimed the idle session
+    assert server._notif_run_submit("__notif__1", "ui-sid", session, notice)
+
+    assert session["_test_prompts"] == [notice], "the goal continuation ran ahead of the paused turn"
+    marker = read_turn_marker(env.home, "session-key")
+    assert marker is not None, "the goal continuation replaced the paused request"
+    assert marker["reason"] == up.PAUSE_REASON and marker["prompt"] == "the long task"
+    assert not session.get("running")
+    assert up.in_place_resume_action(session, "session-key", skew=lambda: None) == "resume"
+
+
+def test_goal_continuation_waits_while_a_paused_turn_continuation_is_due(env, monkeypatch):
+    session = _paused_session(env.home)
+    _goal_after(monkeypatch, {"some turn"})
+    monkeypatch.setattr(up, "continuation_due", lambda s: True)
+    session.pop("_update_pause_marker_key", None)
+    server._run_post_turn_followups("rid", "ui-sid", session, {}, "[goal] keep going")
+    assert "_test_prompts" not in session and not session.get("running")
+
+
+def test_goal_continuation_still_runs_once_the_pause_is_retired(env, monkeypatch):
+    session = _paused_session(env.home)
+    typed = "actually, do something else"
+    _goal_after(monkeypatch, {typed})
+
+    session["running"] = True
+    server._run_prompt_submit("rid-2", "ui-sid", session, typed)  # the user moved on: pause retired
+
+    assert session["_test_prompts"] == [typed, "[goal] keep going"]
+    assert read_turn_marker(env.home, "session-key") is None
diff --git a/tui_gateway/prompt_turn.py b/tui_gateway/prompt_turn.py
index 7272f65fe6..7390c2f57a 100644
--- a/tui_gateway/prompt_turn.py
+++ b/tui_gateway/prompt_turn.py
@@ -552,6 +552,22 @@ def _dispatch_claimed_followup(rid, sid, session, prompt, what, *, on_done=None,
         _notif_release_turn(session)
 
 
+def _goal_waits_for_paused_turn(session: dict) -> bool:
+    """[daveey] A /goal continuation must not run ahead of a turn paused for a core update. It claims the session
+    directly (not through ``_notif_claim_turn``) and is a real turn, so it would record its own marker over the
+    paused one and retire it: the paused request was replaced, not continued. Skip the tick instead; the paused
+    turn's continuation (or the user's next message) ends with its own goal evaluation."""
+    with session["history_lock"]:
+        pending = bool(session.get("_paused_marker_carried") or session.get("_update_pause_marker_key"))
+    if not pending:
+        from tui_gateway.update_pause import continuation_due
+        pending = continuation_due(session)
+    if pending:
+        logger.info("core-update pause: goal continuation for %s waits for the paused turn",
+                    session.get("session_key") or "")
+    return pending
+
+
 def _run_post_turn_followups(
     rid, sid: str, session: dict, result: Any, goal_followup: str | None) -> None:
     """Chain whatever should run after ``running`` was released.  Order: a mid-turn user
@@ -564,6 +580,8 @@ def _run_post_turn_followups(
             _enqueue_prompt(session, steer, session.get("transport"))
     if _drain_queued_prompt(rid, sid, session):
         return
+    if goal_followup and _goal_waits_for_paused_turn(session):
+        goal_followup = None  # the paused turn's own end runs the goal judge again
     if goal_followup:
         with _session_turn_admission(session) as admitted:
             if not admitted or session.get("running"):
