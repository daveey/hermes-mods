From 9a58ca08596b0d3dc17cc0f9c17ea2e6fcdf3bc4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 16:43:36 +0000
Subject: [PATCH] fix(kanban): resolve systemctl via the managed resolver in
 the self-stop [daveey]

Required CI's resolution allowlist test flagged the bare shutil.which in
_stop_own_unit. Use hermes_platform.resolver.locate_command (imported lazily,
ImportError is a no-op) and stub the resolver in the tests.
---
 hermes_cli/kanban_failed_result_observer.py     |  8 ++++----
 .../test_kanban_failed_result_self_stop.py      | 17 +++++++++++++----
 2 files changed, 17 insertions(+), 8 deletions(-)

diff --git a/hermes_cli/kanban_failed_result_observer.py b/hermes_cli/kanban_failed_result_observer.py
index 030683fa03..dfb0a9ccde 100644
--- a/hermes_cli/kanban_failed_result_observer.py
+++ b/hermes_cli/kanban_failed_result_observer.py
@@ -9,7 +9,6 @@ import contextlib
 import json
 import os
 import select
-import shutil
 import sqlite3
 import subprocess
 import sys
@@ -238,11 +237,12 @@ def _stop_own_unit(context):
         cgroup = Path('/proc/self/cgroup').read_text(encoding='utf-8')
         if not any(line.rsplit('/', 1)[-1] == unit for line in cgroup.splitlines()):
             return
-        systemctl = shutil.which('systemctl')
+        from hermes_platform.resolver import locate_command
+        systemctl = locate_command('systemctl').command
         if systemctl:
-            subprocess.run([systemctl, '--user', '--no-block', 'stop', unit], stdin=subprocess.DEVNULL,
+            subprocess.run([*systemctl, '--user', '--no-block', 'stop', unit], stdin=subprocess.DEVNULL,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5, check=False)
-    except (AttributeError, OSError, ValueError, subprocess.SubprocessError):
+    except (AttributeError, ImportError, OSError, ValueError, subprocess.SubprocessError):
         pass
 
 
diff --git a/tests/hermes_cli/test_kanban_failed_result_self_stop.py b/tests/hermes_cli/test_kanban_failed_result_self_stop.py
index d695389dc3..4061f1077b 100644
--- a/tests/hermes_cli/test_kanban_failed_result_self_stop.py
+++ b/tests/hermes_cli/test_kanban_failed_result_self_stop.py
@@ -7,11 +7,12 @@ lines/h on worker-4). A queued stop job cancels the manager's auto-restart. No
 live service mutation: ``systemctl`` and ``/proc/self/cgroup`` are fixtures.
 """
 import json
-import shutil
+import types
 from pathlib import Path
 
 import pytest
 
+from hermes_platform import resolver
 from hermes_cli import kanban_failed_result_observer as observer
 
 UNIT = 'hermes-failed-result-174699-3952684799857.service'
@@ -23,10 +24,18 @@ def _import_failure(_):
     raise ModuleNotFoundError("No module named 'ruamel'")
 
 
+def _systemctl_at(monkeypatch, path):
+    """The observer resolves systemctl through the managed resolver, never a bare which."""
+    def locate(name, *args, **kwargs):
+        found = path if name == 'systemctl' else None
+        return types.SimpleNamespace(command=(found,) if found else ())
+    monkeypatch.setattr(resolver, 'locate_command', locate)
+
+
 @pytest.fixture
 def systemctl(monkeypatch):
     calls = []
-    monkeypatch.setattr(shutil, 'which', lambda name: '/usr/bin/systemctl' if name == 'systemctl' else None)
+    _systemctl_at(monkeypatch, '/usr/bin/systemctl')
     def run(command, **kwargs):
         calls.append(command)
         return observer.subprocess.CompletedProcess(command, 0)
@@ -83,7 +92,7 @@ def test_stop_failure_never_masks_retire_exit(systemctl, monkeypatch):
 
 
 def test_missing_systemctl_or_cgroup_is_a_no_op(systemctl, monkeypatch):
-    monkeypatch.setattr(shutil, 'which', lambda name: None)
+    _systemctl_at(monkeypatch, None)
     _cgroup(monkeypatch, f'/user.slice/user-1000.slice/user@1000.service/app.slice/{UNIT}')
     assert observer.main(['observer', json.dumps(CONTEXT)]) == observer.STARTUP_FAILURE_EXIT
     real = Path.read_text
@@ -92,6 +101,6 @@ def test_missing_systemctl_or_cgroup_is_a_no_op(systemctl, monkeypatch):
             raise FileNotFoundError(self)
         return real(self, *args, **kwargs)
     monkeypatch.setattr(Path, 'read_text', no_proc)
-    monkeypatch.setattr(shutil, 'which', lambda name: '/usr/bin/systemctl')
+    _systemctl_at(monkeypatch, '/usr/bin/systemctl')
     assert observer.main(['observer', json.dumps(CONTEXT)]) == observer.STARTUP_FAILURE_EXIT
     assert systemctl == []
-- 
