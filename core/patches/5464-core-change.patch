@@ -0,0 +1,21 @@
+import { describe, expect, it } from 'vitest'
+
+import { isSessionBusyRefusal } from './session-busy-refusal'
+
+describe('isSessionBusyRefusal', () => {
+  it('treats a busy chat as a refused send', () => {
+    expect(isSessionBusyRefusal({ failureReason: 'session_busy' })).toBe(true)
+    expect(isSessionBusyRefusal({ error: 'session_turn_lease_timeout:abc' })).toBe(true)
+  })
+
+  // A route behind a subscription quota wall refuses the turn before the agent is built: the message never
+  // ran, so the composer offers it back (hub chat 20000101_000000_e23a59).
+  it('treats a quota-walled route refusal as a refused send', () => {
+    expect(isSessionBusyRefusal({ surfaceCode: 'route_refused' })).toBe(true)
+  })
+
+  it('leaves other failures alone', () => {
+    expect(isSessionBusyRefusal({ surfaceCode: 'agent_init_failed' })).toBe(false)
+    expect(isSessionBusyRefusal({})).toBe(false)
+  })
+})
diff --git a/apps/desktop/src/lib/session-busy-refusal.ts b/apps/desktop/src/lib/session-busy-refusal.ts
index 4000519b21..be8ee7540a 100644
--- a/apps/desktop/src/lib/session-busy-refusal.ts
+++ b/apps/desktop/src/lib/session-busy-refusal.ts
@@ -13,11 +13,15 @@ export interface RefusalSignals {
   surfaceCode?: unknown
 }
 
-/** Whether a failed turn is a busy-chat refusal that never processed the user's message. */
+/** The surface code of a turn refused because its pinned route's subscription quota is out (agent/error_surface.py). */
+export const ROUTE_REFUSED_CODE = 'route_refused'
+
+/** Whether a failed turn never processed the user's message: a busy chat, or a route behind a quota wall. */
 export function isSessionBusyRefusal({ error, failureReason, surfaceCode }: RefusalSignals): boolean {
   return (
     failureReason === SESSION_BUSY_FAILURE ||
     surfaceCode === SESSION_BUSY_FAILURE ||
+    surfaceCode === ROUTE_REFUSED_CODE ||
     (typeof error === 'string' && error.trim().startsWith(LEASE_TIMEOUT_ERROR_PREFIX))
   )
 }
