From 7ea312192f998211904e7a8ee108b1a16d30249f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 02:28:38 +0000
Subject: [PATCH] fix(kanban): refuse a pickup-stall pool move for ssh access
 the Board cannot place [daveey]

Workers attest capability:ssh-mbp / capability:ssh-mini, so after #1825 an alarm
could operator-move a card declaring requires ssh:mbp/ssh:mini to pool:worker,
where the Board's pool selection leaves it in task_requirement_unsupported.
scope_refusal now consults kanban_placement_coordination.board_refusal(requires)
before the pool eligibility check and refuses with that reason.

Task: t_01a1d2b4b091e158
---
 hermes_cli/kanban_pickup_stall_repin.py            | 13 +++++++++++--
 tests/hermes_cli/test_kanban_pickup_stall_repin.py | 14 ++++++++++++++
 2 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_pickup_stall_repin.py b/hermes_cli/kanban_pickup_stall_repin.py
index 163c2d40e0..9a2b131956 100644
--- a/hermes_cli/kanban_pickup_stall_repin.py
+++ b/hermes_cli/kanban_pickup_stall_repin.py
@@ -90,14 +90,18 @@ def listed_targets(conn: sqlite3.Connection, alarm: Any, own: str) -> set:
     return out
 
 
-def _need(target: Any) -> set:
+def _requires(target: Any) -> list:
     import json
     try:
         requires = json.loads(target["requires"]) if target["requires"] else []
     except (TypeError, ValueError):
         requires = []
+    return [r for r in requires if isinstance(r, str)] if isinstance(requires, list) else []
+
+
+def _need(target: Any) -> set:
     from hermes_cli.kanban_placement_coordination import requirement_label
-    return {requirement_label(r) for r in requires if isinstance(r, str)} | {f"profile:{target['assignee']}"}
+    return {requirement_label(r) for r in _requires(target)} | {f"profile:{target['assignee']}"}
 
 
 def eligible_now(name: str, own: str, machines: Optional[Mapping[str, Mapping[str, Any]]], need: set,
@@ -135,6 +139,11 @@ def scope_refusal(conn: sqlite3.Connection, alarm: Any, target: Any, runs_on: An
     except ValueError as exc:
         return str(exc)
     if labels == [pool_label()]:
+        # A worker may attest ssh access, but the Board's pool selection cannot place it: the card would sit in
+        # task_requirement_unsupported instead of leaving the stalled machine.
+        from hermes_cli.kanban_placement_coordination import board_refusal
+        if why := board_refusal(_requires(target)):
+            return f"{target['id']} cannot go to {pool_label()}: {why}"
         return pool_refusal(own, machines, _need(target), now_ms)
     if len(labels) != 1 or not labels[0].startswith("machine:"):
         return f"runs_on must be exactly [\"{pool_label()}\"] or exactly one machine:<X> label"
diff --git a/tests/hermes_cli/test_kanban_pickup_stall_repin.py b/tests/hermes_cli/test_kanban_pickup_stall_repin.py
index 3d7f89db91..0a0f8c6985 100644
--- a/tests/hermes_cli/test_kanban_pickup_stall_repin.py
+++ b/tests/hermes_cli/test_kanban_pickup_stall_repin.py
@@ -234,6 +234,20 @@ def test_declared_hub_write_needs_the_hyphenated_label_a_worker_attests(board):
     assert "capability:hub-write" in board.why(runs_on=[POOL], machines=_machines(**{X: lacking}))
 
 
+@pytest.mark.parametrize("access", ["ssh:mbp", "ssh:mini"])
+def test_declared_ssh_access_refuses_the_pool_queue_with_the_board_reason(board, access):
+    """t_01a1d2b4b091e158: workers attest ``capability:ssh-mbp``/``ssh-mini``, but the Board's pool selection cannot
+    place ssh access, so a pool move would leave the card in task_requirement_unsupported."""
+    from hermes_cli import kanban_placement_coordination as coord
+    board.set(board.target, requires=json.dumps([access]))
+    label = coord.requirement_label(access)
+    machines = _pooled(worker_2={"labels": [*_worker(X)["labels"], POOL, label]})
+    assert rp.pool_refusal(M, machines, rp._need(board.conn.execute(
+        "SELECT * FROM tasks WHERE id = ?", (board.target,)).fetchone()), NOW) is None  # a worker qualifies
+    why = board.why(runs_on=[POOL], machines=machines)
+    assert why is not None and coord.BOARD_REASON in why, why
+
+
 @pytest.mark.parametrize("name, label", [("hub:write", "capability:hub-write"), ("hub:read", "capability:hub-read"),
                                          ("ssh:mbp", "capability:ssh-mbp"), ("ssh:mini", "capability:ssh-mini"),
                                          ("terminal", "capability:terminal")])
-- 
