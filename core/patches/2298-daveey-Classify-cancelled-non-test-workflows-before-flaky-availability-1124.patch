From f5b73d0b7c1f16f16726971e1d0597a5ce6be4bf Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 19:11:48 +0000
Subject: [PATCH] [daveey] Classify cancelled non-test workflows before flaky
 availability (#1124)

---
 scripts/ci/flaky_artifact_poll.py    |  6 ++++--
 tests/ci/test_flaky_artifact_poll.py | 22 ++++++++++++++++++++--
 2 files changed, 24 insertions(+), 4 deletions(-)

diff --git a/scripts/ci/flaky_artifact_poll.py b/scripts/ci/flaky_artifact_poll.py
index 0f820b1056d..8d54290abd5 100644
--- a/scripts/ci/flaky_artifact_poll.py
+++ b/scripts/ci/flaky_artifact_poll.py
@@ -90,11 +90,13 @@ def _job_attempt(job: dict[str, Any], attempt: int) -> int:
 def expected_jobs(jobs: list[dict[str, Any]], attempt: int = 1, *,
                   cancelled: bool = False) -> tuple[int, dict[int, tuple[int, int]]]:
     """``(slices, {slice: (job id, producing attempt)})``; no Python jobs means not applicable."""
-    if cancelled:
-        raise Unavailable("jobs_unavailable")
     by_slice: dict[int, tuple[int, int]] = {}
     totals: set[int] = set()
     for job in jobs:
+        # Even skipped test jobs in a cancelled attempt cannot prove a full matrix.
+        name = job.get("name")
+        if cancelled and isinstance(name, str) and "Run tests" in name:
+            raise Unavailable("jobs_unavailable")
         found = _job_slice(job)
         if found is None:
             continue
diff --git a/tests/ci/test_flaky_artifact_poll.py b/tests/ci/test_flaky_artifact_poll.py
index 2d5e91f02da..fd7f3eaf660 100644
--- a/tests/ci/test_flaky_artifact_poll.py
+++ b/tests/ci/test_flaky_artifact_poll.py
@@ -86,6 +86,23 @@ def test_no_python_test_jobs_is_not_applicable_and_distinct_from_empty(gh, jobs)
     assert state["runs"] == ["5/1"] and gh.downloads == [] and not board.cards
 
 
+@pytest.mark.parametrize("jobs", [
+    # Metadata-only projection of Actions run 43074641622's actual job shape.
+    [{"id": 130711154736, "name": "CI review comment (live)",
+      "status": "completed", "conclusion": "cancelled", "run_attempt": 1}],
+    [],
+])
+def test_cancelled_non_test_run_is_not_applicable_and_deduped(gh, jobs):
+    gh.run()
+    gh.runs[0]["conclusion"] = "cancelled"
+    gh.jobs[(5, 1)] = jobs
+    log, board, state = _poll()
+    assert log == ["POLL complete=0 empty=0 unavailable=0 not_applicable=1"]
+    assert state["runs"] == ["5/1"] and not board.cards and not gh.downloads
+    assert not any("/artifacts" in url for url in gh.urls)
+    assert _poll(board, state)[0] == []
+
+
 def test_affected_job_names_are_recognised(gh):
     gh.simple()
     gh.jobs[(5, 1)] = [job(9, name="Python tests / Run tests (affected, 1/1)")]
@@ -322,8 +339,9 @@ def test_explicit_other_or_malformed_job_attempt_is_unavailable(gh, own):
     assert not state["runs"] and not board.cards and not gh.downloads
 
 
-@pytest.mark.parametrize("jobs", [[], [job(9, conclusion="skipped")], [job(9)]])
-def test_cancelled_run_never_means_no_flakes(gh, jobs):
+@pytest.mark.parametrize("jobs", [[job(9, conclusion="skipped")], [job(9)],
+                                  [job(9, conclusion="cancelled")]])
+def test_cancelled_test_run_never_means_no_flakes(gh, jobs):
     gh.run()["conclusion"] = "cancelled"
     gh.jobs[(5, 1)] = jobs
     log, board, state = _poll()
-- 
2.55.0

