+def test_unreadable_replica_keeps_its_last_rows_as_stale(env):
+    path = replica(env, [("t_open", "running", HUB), ("t_done", "done", HUB)],
+                   [("t_open", "s1", "created", 0), ("t_done", "s1", "created", 0)])
