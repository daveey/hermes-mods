From 82c868369c286e7cc5cef6ee799d96d3b045ff42 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 07:38:49 -0700
Subject: [PATCH] fix(ci): let macOS state suite finish on every main push
 [daveey]

---
 .github/workflows/hermes-state-macos.yml | 18 ++++--------------
 1 file changed, 4 insertions(+), 14 deletions(-)

diff --git a/.github/workflows/hermes-state-macos.yml b/.github/workflows/hermes-state-macos.yml
index dd56f6e4f9..33e0370967 100644
--- a/.github/workflows/hermes-state-macos.yml
+++ b/.github/workflows/hermes-state-macos.yml
@@ -19,18 +19,6 @@ name: hermes_state (macOS)
 on:
   push:
     branches: [main, 'ci-probe/**']
-    paths:
-      - 'hermes_state*'
-      - 'hermes_state/**'
-      - 'tests/hermes_state/**'
-      - 'tests/conftest.py'
-      - 'scripts/run_tests*'
-      - 'scripts/_activation.sh'
-      - 'scripts/run-in-hermes-env'
-      - 'pyproject.toml'
-      - 'uv.lock'
-      - 'pm/**'
-      - '.github/workflows/hermes-state-macos.yml'
   workflow_dispatch:
 
 permissions:
@@ -38,13 +26,15 @@ permissions:
 
 concurrency:
   group: hermes-state-macos-${{ github.ref }}
-  cancel-in-progress: true
+  # Let a running main suite finish even when pushes arrive faster than it runs.
+  cancel-in-progress: false
 
 jobs:
   hermes-state-macos:
     name: tests/hermes_state (macOS, mini)
     runs-on: [self-hosted, macOS, hermes-state]
-    timeout-minutes: 30
+    # Include cold environment provisioning and reduced-priority shared-host work.
+    timeout-minutes: 90
     steps:
       - name: Checkout code
         uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
-- 
2.55.0

