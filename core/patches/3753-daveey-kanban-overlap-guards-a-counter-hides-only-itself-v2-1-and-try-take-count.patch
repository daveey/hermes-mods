From 17f28630e42c573037fffdcb1706ec497b750f05 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 18:39:38 +0000
Subject: [PATCH] [daveey] kanban overlap guards: a counter hides only itself;
 v2.1 and try/take counters are re-issues; not/never before as/because is no
 denial

Follow-ups from exact-head review 5896093750 of PR #2481 (card t_01a1d62c5c827ca7):

1. Fail-closed regression (kanban_overlap_own): `_reissue_counter` skipped the whole replaced span, so
   "Fix guard (attempt 2, w1-01)" vs "Fix guard (attempt 3, w1-02)" returned None and create_overlap refused a
   real leg. `_counters` now returns the counter tokens' indices and `_span_markers` drops only those, so the
   span keeps w1-01/w1-02 and reads as an enumeration again.
2. Fail-open: `_DIGIT_TOKEN.fullmatch` rejected "v2.1" before `_REISSUE_TOKEN` ran, so "v2.1" vs "v2.2" read as
   an enumeration. The counter check now matches `_REISSUE_TOKEN` and dotted numbers directly.
3. Fail-open: try/take were dropped from `_REISSUE_WORD` with pass (to fix the "Pass 1 of 3" false refusal of
   review 5895781842), which also dropped them from the ordinal branch. `_TRY_WORD` puts try/take back: a
   number after try/take is a counter unless "of" follows ("Take 1 of 3" stays a leg), and an ordinal before
   try/take is one ("2nd try"). pass stays out of both.
4. Detector undercount (kanban_dup_detector): the not/never branch of `_NEGATED` had no as/with exclusion and
   the no branch accepted "because", so "Never started as duplicate of t_X", "Not run as duplicate of t_X" and
   "no work because duplicate of t_X" returned []. Both branches now refuse a window holding a joining word
   (as/with/because/since/so/but/due/hence/thus); after not/never a judging verb before "as" (marked,
   considered, flagged, closed, ...) still denies, so "Not marked as (a) duplicate of t_X" stays a denial
   ("Not marked as a duplicate" and "Not closed as a duplicate" were missed denials before; now pinned).

RED (base 70f920be3fe): 11 new cases fail (5 in test_kanban_create_overlap_same_creator.py, 6 in
test_kanban_dup_detector.py). GREEN: all 15 test files importing kanban_overlap / kanban_dup_detector /
create_overlap pass (479 passed, 1 skipped), including the 3-completion replay opening exactly one card, the
14 recorded fan-outs admitted and the "round 2" re-issue refused.
---
 hermes_cli/kanban_dup_detector.py             | 14 +++++--
 hermes_cli/kanban_overlap_own.py              | 40 +++++++++++++------
 tests/hermes_cli/test_kanban_dup_detector.py  | 11 +++++
 ...test_kanban_create_overlap_same_creator.py |  9 +++++
 4 files changed, 57 insertions(+), 17 deletions(-)

diff --git a/hermes_cli/kanban_dup_detector.py b/hermes_cli/kanban_dup_detector.py
index 9097553a38..59fbd56a34 100644
--- a/hermes_cli/kanban_dup_detector.py
+++ b/hermes_cli/kanban_dup_detector.py
@@ -32,11 +32,17 @@ _AFTER = re.compile(rf"[^.\n]{{0,120}}?\b({_CARD})\b")
 # A denial that governs the keyword in its own clause: "Not a duplicate of t_X", "No duplicates found; parent
 # t_X", "isn't a duplicate", "non-duplicate", "0 duplicates", "Not a real duplicate", "No other duplicates" (PR
 # #2329 review). Up to two words may sit between. Only "non" takes a hyphen, so "No-op as duplicate of t_X" is
-# no denial, and a "no"/"0" whose window holds "as"/"with" counts a noun, not the keyword ("no changes as
-# duplicate of t_X") (PR #2429 reviews). An earlier clause ("No code changes; duplicate of t_X") does not deny it.
+# no denial, and a window holding a joining word ("as", "with", "because", ...) negates another word, not the
+# keyword ("no changes as duplicate of t_X", "Never started as duplicate of t_X", "no work because duplicate of
+# t_X") (PR #2429 reviews, PR #2481 review 5896093750). After not/never, a judging verb before "as" still denies
+# ("Not marked as a duplicate of t_X"). An earlier clause ("No code changes; duplicate of t_X") does not deny it.
 _WORD = r"[\w'\u2019]+\s+"
-_NOT_NOUN = rf"(?:(?!(?:as|with)\b){_WORD})"
-_NEGATED = re.compile(rf"(?:\b(?:not|never|\w+n['\u2019]t)\s+(?:{_WORD}){{0,2}}"
+_JOIN = r"(?:as|with|because|since|so|but|due|hence|thus)"
+_NOT_NOUN = rf"(?:(?!{_JOIN}\b){_WORD})"
+_JUDGED = (r"(?:marked|considered|flagged|treated|closed|counted|filed|labell?ed|tagged|reported|listed|deemed|"
+           r"regarded|classified|recorded|identified|confirmed|resolved|seen)")
+_NEGATED = re.compile(rf"(?:\b(?:not|never|\w+n['\u2019]t)\s+(?:{_NOT_NOUN}{{0,2}}"
+                      rf"|{_NOT_NOUN}?{_JUDGED}\s+(?:as\s+)?(?:(?:an?|the)\s+)?)"
                       rf"|(?:\b(?:no|zero)|(?<![\w.])0)\s+{_NOT_NOUN}{{0,2}}"
                       r"|\bnon[\s-]+)$", re.IGNORECASE)
 # "Checked for duplicates: none", "Duplicates found: 0": a count of none right after the keyword that ends the
diff --git a/hermes_cli/kanban_overlap_own.py b/hermes_cli/kanban_overlap_own.py
index 530ae1d96b..d518d1d161 100644
--- a/hermes_cli/kanban_overlap_own.py
+++ b/hermes_cli/kanban_overlap_own.py
@@ -104,24 +104,38 @@ def _title_tokens(title: str) -> list[str]:
 
 
 # A counter after one of these words numbers a re-issue of the same work, not a leg (PR #2429 review).
-# "pass"/"take"/"try" are left out: "Pass 1 of 3: parser" / "Pass 2 of 3: parser" are staged legs (PR #2481 review).
+# "pass"/"take"/"try" are not here: "Pass 1 of 3: parser" / "Pass 2 of 3: parser" are staged legs (PR #2481 review);
+# try/take go through ``_TRY_WORD`` below.
 _REISSUE_WORD = re.compile(r"(?:attempts?|rounds?|retry|retries|v|rev|revision|iterations?)",
                            re.IGNORECASE)
-_REISSUE_TOKEN = re.compile(r"(?:v|rev)\d+(?:\.\d+)*", re.IGNORECASE)  # "v2", "rev3"
+_REISSUE_TOKEN = re.compile(r"(?:v|rev)\d+(?:\.\d+)*", re.IGNORECASE)  # "v2", "rev3", "v2.1"
+_COUNT = re.compile(r"\d+(?:\.\d+)*")  # "2", "2.1"
+# "try 2"/"take 3" number a re-issue unless a staged "N of M" follows ("Take 1 of 3"); "2nd try" is one. "pass"
+# stays out of both: "Pass 1 of 3" and "2nd pass" are staged legs (PR #2481 reviews 5895781842, 5896093750).
+_TRY_WORD = re.compile(r"(?:try|tries|take)", re.IGNORECASE)
 _ORDINAL = re.compile(r"\d+(?:st|nd|rd|th)", re.IGNORECASE)  # "2nd attempt"
 
 
-def _reissue_counter(tokens: list[str], i1: int, i2: int) -> bool:
-    """``tokens[i1:i2]`` holds a re-issue counter: a number right after a re-issue word (``attempt 2``,
-    ``round 1``), ``v3``, or an ordinal before one (``2nd attempt``)."""
+def _counters(tokens: list[str], i1: int, i2: int) -> set[int]:
+    """Indices in ``tokens[i1:i2]`` of re-issue counters: a number right after a re-issue word (``attempt 2``,
+    ``round 1``, ``try 2``), ``v3``/``v2.1``, or an ordinal before one (``2nd attempt``, ``3rd try``)."""
+    found = set()
     for k in range(i1, i2):
         tok = tokens[k]
-        if not _DIGIT_TOKEN.fullmatch(tok.lower()):
-            continue
-        if (_REISSUE_TOKEN.fullmatch(tok) or (k > 0 and _REISSUE_WORD.fullmatch(tokens[k - 1]))
-                or (_ORDINAL.fullmatch(tok) and k + 1 < len(tokens) and _REISSUE_WORD.fullmatch(tokens[k + 1]))):
-            return True
-    return False
+        before = tokens[k - 1] if k > 0 else ""
+        after = tokens[k + 1] if k + 1 < len(tokens) else ""
+        if (_REISSUE_TOKEN.fullmatch(tok)
+                or (_COUNT.fullmatch(tok) and (_REISSUE_WORD.fullmatch(before)
+                                               or (_TRY_WORD.fullmatch(before) and after.lower() != "of")))
+                or (_ORDINAL.fullmatch(tok) and (_REISSUE_WORD.fullmatch(after) or _TRY_WORD.fullmatch(after)))):
+            found.add(k)
+    return found
+
+
+def _span_markers(tokens: list[str], i1: int, i2: int) -> frozenset[str]:
+    """Index markers of ``tokens[i1:i2]`` without its re-issue counters: ``attempt 3, w1-02`` keeps ``w1-02``."""
+    skip = _counters(tokens, i1, i2)
+    return markers(" ".join(tokens[k] for k in range(i1, i2) if k not in skip))
 
 
 def _shape(marker: str) -> str:
@@ -143,9 +157,9 @@ def enumerated(title: str, theirs: str) -> Optional[tuple[frozenset[str], frozen
     deleted: set[str] = set()
     inserted: set[str] = set()
     for tag, i1, i2, j1, j2 in ops:
-        if tag == "equal" or _reissue_counter(a, i1, i2) or _reissue_counter(b, j1, j2):
+        if tag == "equal":
             continue
-        mine_m, their_m = markers(" ".join(a[i1:i2])), markers(" ".join(b[j1:j2]))
+        mine_m, their_m = _span_markers(a, i1, i2), _span_markers(b, j1, j2)
         if tag == "replace" and mine_m and their_m and mine_m != their_m:
             return mine_m - their_m, their_m - mine_m
         deleted |= mine_m if tag == "delete" else set()
diff --git a/tests/hermes_cli/test_kanban_dup_detector.py b/tests/hermes_cli/test_kanban_dup_detector.py
index f2e7d124b2..d33f9442ae 100644
--- a/tests/hermes_cli/test_kanban_dup_detector.py
+++ b/tests/hermes_cli/test_kanban_dup_detector.py
@@ -111,6 +111,12 @@ def test_a_keyword_does_not_reach_past_a_later_denied_keyword_or_a_none(summary)
     "No-op as duplicate of t_0123456789abcdef.",
     "Done with no changes as duplicate of t_0123456789abcdef.",
     "Closed with no further work, a duplicate of t_0123456789abcdef.",
+    # PR #2481 review 5896093750: a not/never that negates another verb, or a "no" before "because".
+    "Never started as duplicate of t_0123456789abcdef.",
+    "Not run as duplicate of t_0123456789abcdef.",
+    "no work because duplicate of t_0123456789abcdef.",
+    "Not started because duplicate of t_0123456789abcdef.",
+    "Wasn't run, as a duplicate of t_0123456789abcdef.",
 ])
 def test_a_negator_that_does_not_govern_the_keyword_does_not_deny_it(summary):
     """PR #2429 review: "no" denies only "no duplicate(s)" / "not a duplicate", not "no-op" or "no <noun> as"."""
@@ -125,6 +131,11 @@ def test_a_negator_that_does_not_govern_the_keyword_does_not_deny_it(summary):
     "No obvious duplicate of t_0123456789abcdef.",
     "Not an exact duplicate; parent t_0123456789abcdef.",
     "Not marked as duplicate of t_0123456789abcdef.",
+    "Not marked as a duplicate of t_0123456789abcdef.",
+    "Wasn't considered a duplicate of t_0123456789abcdef.",
+    "Never flagged as duplicate of t_0123456789abcdef.",
+    "Not closed as a duplicate of t_0123456789abcdef.",
+    "Not being a duplicate of t_0123456789abcdef, it stays open.",
     "Checked for duplicates: none found, parent t_0123456789abcdef.",
 ])
 def test_a_negator_two_words_before_the_keyword_still_denies_it(summary):
