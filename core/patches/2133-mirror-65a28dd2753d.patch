From 65a28dd2753d1556f20ac7af2be9044ce205c6a6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 22:30:31 +0000
Subject: [PATCH] fix(desktop): a tile resume that returns no runtime id logs
 outcome failed [daveey]

Review follow-up: the last remaining silent throw in resumeTile.
---
 .../use-session-tile-delegate.cache-paint.test.ts  | 14 ++++++++++++++
 .../app/contrib/hooks/use-session-tile-delegate.ts |  2 ++
 2 files changed, 16 insertions(+)

diff --git a/apps/desktop/src/app/contrib/hooks/use-session-tile-delegate.cache-paint.test.ts b/apps/desktop/src/app/contrib/hooks/use-session-tile-delegate.cache-paint.test.ts
index 3deb00d9efb..88943d6b4ff 100644
--- a/apps/desktop/src/app/contrib/hooks/use-session-tile-delegate.cache-paint.test.ts
+++ b/apps/desktop/src/app/contrib/hooks/use-session-tile-delegate.cache-paint.test.ts
@@ -231,6 +231,20 @@ describe('[daveey] a tile (the @session ref click) paints from the transcript ca
     expect(tileLines()[0]).not.toHaveProperty('paint')
   })
 
+  it('a resume that returns no runtime id writes outcome "failed" instead of nothing', async () => {
+    setSessionOwnerHint('no-runtime-ref', ROUTE)
+    vi.mocked(getLatestSessionMessages).mockResolvedValue({
+      messages: rows('from rest'),
+      session_id: 'no-runtime-ref'
+    } as never)
+    vi.mocked(requestGatewayForAgent).mockResolvedValue({} as never)
+    renderTile()
+
+    await expect(sessionTileDelegate()!.resumeTile('no-runtime-ref')).rejects.toThrow('resume returned no session id')
+
+    expect(tileLines()).toEqual([expect.objectContaining({ id: 'no-runtime-ref', outcome: 'failed', surface: 'tile' })])
+  })
+
   // [daveey] The main pane caches every REST page it opens with; a cold tile open (the first ref click on a session
   // the prefetch had not warmed) did not, so the next open of the same old session missed the cache again.
   it('a cold tile open caches the REST page it painted, under the tile owner key', async () => {
diff --git a/apps/desktop/src/app/contrib/hooks/use-session-tile-delegate.ts b/apps/desktop/src/app/contrib/hooks/use-session-tile-delegate.ts
index c9576186624..52a0c3fe4e7 100644
--- a/apps/desktop/src/app/contrib/hooks/use-session-tile-delegate.ts
+++ b/apps/desktop/src/app/contrib/hooks/use-session-tile-delegate.ts
@@ -603,6 +603,8 @@ export function useSessionTileDelegate({
         const runtimeId = resumed?.session_id
 
         if (!runtimeId) {
+          timing?.reconciled('failed')
+
           throw new Error('resume returned no session id')
         }
 
-- 
2.55.0

