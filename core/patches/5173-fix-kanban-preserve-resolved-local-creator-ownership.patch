From 47bb3d1443e69b6245aab442686adaec4e313984 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 11:22:28 +0000
Subject: [PATCH] fix(kanban): preserve resolved local creator ownership in
 strand checks [daveey]

Match local chat reconciliation for stale released creator links without restoring a board-wide scan. Retain foreign, unresolved, shepherd, machine and placeholder exclusions; cover local tui subscription ownership.

Proof: reviewed head RED on local resolved creator; GREEN 49 focused tests and full sweep consumer suite. Six targeted mutants killed (including tui branch, foreign, resolution, gateway and kind boundaries). All scripts/check gates passed.
---
 hermes_cli/kanban_triage_sweep.py             | 18 ++++++-
 .../test_kanban_contained_remote_owner.py     | 52 +++++++++++++++++++
 2 files changed, 68 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_triage_sweep.py b/hermes_cli/kanban_triage_sweep.py
index 1360d4b161..4700317939 100644
--- a/hermes_cli/kanban_triage_sweep.py
+++ b/hermes_cli/kanban_triage_sweep.py
@@ -119,11 +119,24 @@ def stranded_contained(conn: sqlite3.Connection, *, now: Optional[float] = None)
     return out
 
 
+def _local_creator_links(conn: sqlite3.Connection, tid: str, gateway: str, rows: list[dict]) -> list[dict]:
+    """Match _local_links' persistent creator binding without scanning the whole board."""
+    task = conn.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone()
+    if not task or dict(task).get("created_on") not in (None, "", gateway):
+        return []
+    if not conn.execute("SELECT 1 FROM task_events WHERE task_id=? AND kind='creator_chats_resolved' LIMIT 1",
+                        (tid,)).fetchone():
+        return []
+    # A foreign reconciler can stale-release this row; local reconciliation restores it.
+    return [r for r in rows if r["chat_gateway"] == gateway and r["kind"] == "created"]
+
+
 def _contained_chat_owners(conn: sqlite3.Connection, ids: list[str]) -> set[str]:
     """Owning chats on any gateway, including subscriptions not projected into links yet.
 
-    A stored release wins over a lingering subscription. Notice-only subscriptions and
-    machine/placeholder sessions are not owners. Read failures propagate to the sweep's
+    Stored releases win over lingering remote subscriptions; local resolved creator links
+    persist like _local_links even when a foreign reconciler stale-releases their flag.
+    Notice-only subscriptions and machine/placeholder sessions are not owners. Read failures propagate to the sweep's
     fail-closed boundary rather than becoming evidence of absent ownership. [daveey]
     """
     from hermes_cli.kanban_db_notify import is_machine_session
@@ -138,6 +151,7 @@ def _contained_chat_owners(conn: sqlite3.Connection, ids: list[str]) -> set[str]
         rows = [dict(r) for r in conn.execute("SELECT * FROM task_chat_links WHERE task_id=?", (tid,))] if has_links else []
         known = {(r["chat_gateway"], r["chat_profile"] or "default", r["chat_session"]) for r in rows}
         candidates = [r for r in rows if not r["released"] and r["kind"] in ("created", "shepherd")]
+        candidates.extend(_local_creator_links(conn, tid, gateway, rows))
         # Per-card reads only (no board-wide scan on the dispatcher hot path). Subs count the way
         # _owner_hub_links does: creators, shepherds and origin bindings, not notice-only subs.
         made_in = conn.execute("SELECT session_id FROM tasks WHERE id=?", (tid,)).fetchone()
diff --git a/tests/hermes_cli/test_kanban_contained_remote_owner.py b/tests/hermes_cli/test_kanban_contained_remote_owner.py
index be74775453..860f58adb4 100644
--- a/tests/hermes_cli/test_kanban_contained_remote_owner.py
+++ b/tests/hermes_cli/test_kanban_contained_remote_owner.py
@@ -67,6 +67,58 @@ def test_hub_subscription_reasons_before_link_row_lands(board, reason, expected)
     assert len(h.sweep.escalate_stranded_contained(board, now=h.NOW)) == expected
 
 
+@pytest.mark.parametrize("reason,expected", [("shepherd", 0), ("create", 0), (None, 0),
+                                           ("touch", 1), ("send_refused", 1)])
+def test_local_tui_subscription_before_link_row_lands(board, reason, expected):
+    relay, authority, _ = h._contained(board)
+    h._finish(board, authority)
+    board.execute("INSERT INTO kanban_notify_subs(task_id,platform,chat_id,created_at,delivery_metadata) "
+                  "VALUES (?,'tui','20261120_000000_abcdef',?,?)",
+                  (relay, h.NOW - 3600, json.dumps({"reason": reason}) if reason else None))
+    assert len(h.sweep.escalate_stranded_contained(board, now=h.NOW)) == expected
+
+
+@pytest.mark.parametrize("gateway,kind,resolved,foreign,expected", [
+    ("local", "created", True, False, 0),
+    ("local", "created", False, False, 1),
+    ("local", "shepherd", True, False, 1),
+    ("remote-chat-host", "created", True, False, 1),
+    ("local", "created", True, True, 1),
+])
+def test_released_creator_link_matches_local_reconciliation(board, monkeypatch, gateway, kind,
+                                                          resolved, foreign, expected):
+    from hermes_cli import kanban_origin
+    monkeypatch.setattr(kanban_origin, "gateway_name", lambda: "local")
+    relay, authority, _ = h._contained(board)
+    h._finish(board, authority)
+    board.execute("INSERT INTO task_chat_links VALUES ('owner',?,?,'default',"
+                  "'20261120_000000_abcdef',?,1,?)", (relay, gateway, kind, h.NOW))
+    if resolved:
+        h.kb._append_event(board, relay, "creator_chats_resolved", {})
+    if foreign:
+        board.execute("ALTER TABLE tasks ADD COLUMN created_on TEXT")
+        board.execute("UPDATE tasks SET created_on='remote-card-host' WHERE id=?", (relay,))
+    # Test ownership directly too: escalation correctly skips foreign retained copies independently.
+    assert (relay in h.sweep._contained_chat_owners(board, [relay])) == (expected == 0)
+    if not foreign:
+        assert len(h.sweep.escalate_stranded_contained(board, now=h.NOW)) == expected
+
+
+@pytest.mark.parametrize("session", ["cron_fixture", "kanban:fixture", "local-test"])
+def test_released_local_creator_still_filters_non_chat(board, monkeypatch, session):
+    from hermes_cli import kanban_origin, kanban_db_notify, kanban_placement
+    monkeypatch.setattr(kanban_origin, "gateway_name", lambda: "local")
+    relay, authority, _ = h._contained(board)
+    h._finish(board, authority)
+    h.kb._append_event(board, relay, "creator_chats_resolved", {})
+    board.execute("INSERT INTO task_chat_links VALUES ('owner',?,'local','default',?,'created',1,?)",
+                  (relay, session, h.NOW))
+    # Exercise both exclusion boundaries deterministically, independent of host session inventory.
+    monkeypatch.setattr(kanban_db_notify, "is_machine_session", lambda g, s, **k: session != "local-test")
+    monkeypatch.setattr(kanban_placement, "is_placeholder_session", lambda s: session == "local-test")
+    assert len(h.sweep.escalate_stranded_contained(board, now=h.NOW)) == 1
+
+
 def test_ownership_read_is_per_card_not_board_wide(board, monkeypatch):
     from hermes_cli import kanban_chat_links
     relay, authority, _ = h._contained(board)
