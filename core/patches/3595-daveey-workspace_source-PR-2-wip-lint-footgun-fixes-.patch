     seen = board.actions()[:marks[0]]
@@ -152,7 +151,7 @@ def test_attach_refused_releases_unused_grant_and_never_spawns(conn, board, disp
     dispatcher.snapshot = _source_snapshot()
     board.refuse["source_attach"] = "custody_attached"
     spawned = []
