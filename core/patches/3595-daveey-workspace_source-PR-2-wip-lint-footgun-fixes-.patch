diff --git a/hermes_cli/kanban_source_cli.py b/hermes_cli/kanban_source_cli.py
index 33c67b8c6a..515194cfb7 100644
--- a/hermes_cli/kanban_source_cli.py
+++ b/hermes_cli/kanban_source_cli.py
@@ -53,7 +53,7 @@ def _admin_hub() -> Any:
     if not key_path.is_file():
         raise PermissionError(f"no admin key at {ADMIN_KEY}: source-release runs on the hub (Board admin key)")
     ident = client.load_identity()
-    key = key_path.read_text(encoding="utf-8").strip()
+    key = key_path.read_text(encoding="utf-8-sig").strip()
     return client.Hub(client.Identity(url=ident.url, key=key, gateway=ident.gateway))
 
 
diff --git a/hermes_cli/kanban_source_publish.py b/hermes_cli/kanban_source_publish.py
index e6e51dd5d2..2a1c588271 100644
--- a/hermes_cli/kanban_source_publish.py
+++ b/hermes_cli/kanban_source_publish.py
@@ -124,7 +124,7 @@ def check_local(deadline: _Deadline, path: str) -> None:
         raise PublishRefused("source_submodules_unsupported", ".gitmodules present")
     for rel in _git(deadline, path, "ls-files", "--", ".gitattributes", "*/.gitattributes").splitlines():
         try:
-            text = (Path(path) / rel).read_text(encoding="utf-8", errors="replace")
+            text = (Path(path) / rel).read_text(encoding="utf-8-sig", errors="replace")
         except OSError:
             continue
         if "filter=lfs" in text:
