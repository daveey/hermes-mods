From b5589d6c5e3cf401337b797608ab166f20ed7bbd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:21:18 -0700
Subject: [PATCH] fix(desktop): 'created' sidebar sort keeps projects in place

Under the created sort, projects no longer hoist the active project or
re-sort by last activity (explicit before auto, then label), and fresh
projects append below a hand-picked order instead of jumping above it.
The default 'updated' sort is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/desktop/src/app/chat/sidebar/index.tsx   |  6 ++-
 .../app/chat/sidebar/projects/model.test.ts   | 41 +++++++++++++++++++
 .../src/app/chat/sidebar/projects/model.ts    | 31 +++++++++++---
 3 files changed, 70 insertions(+), 8 deletions(-)

diff --git a/apps/desktop/src/app/chat/sidebar/index.tsx b/apps/desktop/src/app/chat/sidebar/index.tsx
index b171eb814b..f4069b43ae 100644
--- a/apps/desktop/src/app/chat/sidebar/index.tsx
+++ b/apps/desktop/src/app/chat/sidebar/index.tsx
@@ -1089,7 +1089,8 @@ export function ChatSidebar({
             isHiddenFromProjects
           )
         ),
-      activeProjectId
+      activeProjectId,
+      { stable: ordering === 'created' }
     )
 
     // Layer the user's manual drag-order on top of the deterministic sort. Empty
@@ -1109,12 +1110,13 @@ export function ChatSidebar({
       return true
     })
 
-    return orderProjectsByIds(deduped, projectOrderIds)
+    return orderProjectsByIds(deduped, projectOrderIds, { stable: ordering === 'created' })
   }, [
     visibleProjectTree,
     dismissedAutoProjects,
     orderRepos,
     activeProjectId,
+    ordering,
     projectFilter,
     projectOrderIds,
     isHiddenFromProjects,
diff --git a/apps/desktop/src/app/chat/sidebar/projects/model.test.ts b/apps/desktop/src/app/chat/sidebar/projects/model.test.ts
index 8035686f38..78194f74f0 100644
--- a/apps/desktop/src/app/chat/sidebar/projects/model.test.ts
+++ b/apps/desktop/src/app/chat/sidebar/projects/model.test.ts
@@ -76,3 +76,44 @@ describe('sortProjectsForOverview', () => {
     expect(ids(sortProjectsForOverview(projects, 'active'))).toEqual([NO_PROJECT_ID, 'active', 'scanned'])
   })
 })
+
+describe('stable project order (created sort)', () => {
+  const named = (id: string, lastActive: number, isAuto = true): SidebarProjectTree => ({
+    ...makeProject(id, 1),
+    isAuto,
+    lastActive
+  })
+
+  it('does not hoist the active project or follow activity', () => {
+    const projects = [named('zeta', 900), named('alpha', 100), named('mid', 500)]
+
+    expect(ids(sortProjectsForOverview(projects, 'zeta', { stable: true }))).toEqual(['alpha', 'mid', 'zeta'])
+  })
+
+  it('keeps the same order when activity changes', () => {
+    const before = [named('b', 100), named('a', 200), named('c', 300)]
+    const after = [named('b', 999), named('a', 200), named('c', 1)]
+
+    expect(ids(sortProjectsForOverview(after, 'b', { stable: true }))).toEqual(
+      ids(sortProjectsForOverview(before, 'a', { stable: true }))
+    )
+  })
+
+  it('keeps explicit projects above auto repos and Home on top', () => {
+    const projects = [named('auto-a', 5), named('mine', 1, false), home()]
+
+    expect(ids(sortProjectsForOverview(projects, null, { stable: true }))).toEqual([NO_PROJECT_ID, 'mine', 'auto-a'])
+  })
+
+  it('keeps the default sort activity-led', () => {
+    const projects = [named('old', 100), named('new', 900)]
+
+    expect(ids(sortProjectsForOverview(projects, null))).toEqual(['new', 'old'])
+  })
+
+  it('appends a new active project below the hand-picked order instead of above it', () => {
+    const projects = [makeProject('ordered', 1), makeProject('just-started', 3)]
+
+    expect(ids(orderProjectsByIds(projects, ['ordered'], { stable: true }))).toEqual(['ordered', 'just-started'])
+  })
+})
diff --git a/apps/desktop/src/app/chat/sidebar/projects/model.ts b/apps/desktop/src/app/chat/sidebar/projects/model.ts
index 5c68ec0afb..e74219bdc2 100644
