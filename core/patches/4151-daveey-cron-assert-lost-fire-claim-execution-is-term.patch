From 1c43b3d289949ccdd0fb75e46158514b1b7dea94 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 05:20:25 +0000
Subject: [PATCH] [daveey] cron: assert lost fire-claim execution is terminal
 at ready-ack publication

The PR #2839 adoption test read only the execution row's final status, so a
regression that books finish_lost_execution() after the ready ack (audit
mutant S9, t_01a1d839f0aa6622) survived. The gateway may exit as soon as it
sees the ack, so a lost claim's row must already be terminal when the atomic
os.replace(tmp, ack) publishes it.

The existing ack interceptor now records the row status at publication for the
replaced/removed cases and asserts failed/cancelled respectively. The
no-dispatch (observed == ["ready"]) and final-status assertions are unchanged.

Proof (sdlc-review mutants.py, exact S9 edits from the audit probe spec):
- baseline: 3 passed, 0 failed
- S9 booking moved after ack: killed, 2 failed (replaced, removed)

Tests only; no production change.
---
 tests/cron/test_external_worker_fire_claim_adoption.py | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/tests/cron/test_external_worker_fire_claim_adoption.py b/tests/cron/test_external_worker_fire_claim_adoption.py
index 59ab538925..98be172880 100644
--- a/tests/cron/test_external_worker_fire_claim_adoption.py
+++ b/tests/cron/test_external_worker_fire_claim_adoption.py
@@ -38,7 +38,7 @@ def test_worker_stamps_claim_before_ready_without_run_heartbeat(tmp_path, monkey
             assert jobs.get_job(job["id"]) is None
     payload, ack = tmp_path / "payload.json", tmp_path / "ready"
     payload.write_text(json.dumps({"job": job, "profile_home": str(home)}))
-    observed = []
+    observed, status_at_ack = [], []
     real_replace = os.replace
 
     def publish(src, dst):
@@ -48,6 +48,11 @@ def test_worker_stamps_claim_before_ready_without_run_heartbeat(tmp_path, monkey
                 claim = jobs.get_job(job["id"])["fire_claim"]
                 assert claim.get("runner") == f"{socket.gethostname()}:{os.getpid()}"
                 assert not jobs.claim_job_for_fire(job["id"])
+            else:
+                # The gateway may exit as soon as it sees the ack: a lost claim's
+                # execution must already be terminal, not booked afterwards.
+                with use_cron_store(home):
+                    status_at_ack.append(executions.get_execution(job["execution_id"])["status"])
         return real_replace(src, dst)
 
     monkeypatch.setattr(os, "replace", publish)
@@ -56,6 +61,8 @@ def test_worker_stamps_claim_before_ready_without_run_heartbeat(tmp_path, monkey
 
     assert scheduler._run_external_worker_payload(payload, ack) is True
     assert observed == (["ready", "run"] if claim_state == "owned" else ["ready"])
+    if claim_state != "owned":
+        assert status_at_ack == [{"replaced": "failed", "removed": "cancelled"}[claim_state]]
     assert ack.exists()
     with use_cron_store(home):
         record = executions.get_execution(job["execution_id"])
-- 
