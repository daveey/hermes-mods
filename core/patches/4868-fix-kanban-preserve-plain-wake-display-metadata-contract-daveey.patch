From ed33885f62ec6677043af3ea035f53122b6a66df Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 09:44:24 +0000
Subject: [PATCH] fix(kanban): preserve plain wake display metadata contract
 [daveey]

---
 gateway/kanban_wake_fold.py                       |  7 ++++---
 .../gateway/test_kanban_remote_notice_display.py  | 15 +++++++++++++++
 2 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/gateway/kanban_wake_fold.py b/gateway/kanban_wake_fold.py
index 997ac464df2ba07362a71e22e81dc1ca14af79c6..37b5acd6532c8e2bf92a140f0dcfef2094183313 100644
--- a/gateway/kanban_wake_fold.py
+++ b/gateway/kanban_wake_fold.py
@@ -332,9 +332,10 @@ def refresh_claimed(payload):
             # Strict: an unreadable card would fall back to its as-delivered text and undo the
             # relabel the fold already made, so any unreadable card leaves the whole text as it was.
             payload['text'] = _compose(cards, guidance, strict=True)
-            from gateway.session_automation import _DISPLAY_TEXT_LIMIT
-            text = payload['text']
-            descriptor['display_text'] = text if len(text) <= _DISPLAY_TEXT_LIMIT else text[:_DISPLAY_TEXT_LIMIT - 1] + '…'
+            if descriptor.get('display_kind'):
+                from gateway.session_automation import _DISPLAY_TEXT_LIMIT
+                text = payload['text']
+                descriptor['display_text'] = text if len(text) <= _DISPLAY_TEXT_LIMIT else text[:_DISPLAY_TEXT_LIMIT - 1] + '…'
     except Exception:  # health: allow BLE001 -- a refresh must never cost the wake itself
         logger.warning('kanban wake: claim-time relabel skipped; delivering the wake unchanged', exc_info=True)
 
diff --git a/tests/gateway/test_kanban_remote_notice_display.py b/tests/gateway/test_kanban_remote_notice_display.py
index 24eb3b88374f03b154043aa0ff3a395db804f52d..a5849268fe87da58d8bc41619fc025ca3ae4fb0a 100644
--- a/tests/gateway/test_kanban_remote_notice_display.py
+++ b/tests/gateway/test_kanban_remote_notice_display.py
@@ -25,6 +25,21 @@ def test_refreshed_display_matches_bounded_model_text(monkeypatch, envelope, ext
     assert 'Next action for the user:' not in expected
     assert session_automation.admission_display(payload)['display_text'] == expected
 
+@pytest.mark.parametrize('envelope', ['local_automation_v1', 'native_text_v1'])
+def test_plain_local_wake_refresh_does_not_add_half_a_display_card(monkeypatch, envelope):
+    text = '[kanban] Task t_local blocked.'
+    descriptor = {'identity': json.dumps(['kanban-wake', 'fixture']),
+                  'kanban_cards': [{'task_id': 't_local', 'board': 'default',
+                                    'kinds': ['blocked'], 'text': text}]}
+    payload = {'text': text, envelope: descriptor if envelope == 'local_automation_v1'
+               else {'automation': descriptor}}
+    monkeypatch.setattr(kanban_wake_fold, '_live_task', lambda *a, **kw: ('ready', ''))
+    kanban_wake_fold.refresh_claimed(payload)
+    assert '[kanban] Task t_local ready.' in payload['text']
+    assert 'display_text' not in descriptor
+    session_automation.admission_display(payload)
+
+
 def test_preceding_link_keeps_intervening_context_once():
     lines = ['Open task: @task:default@hub/t_remote', 'Context before the ask',
              'Next action for the user: choose', 'Context after the ask']
-- 
