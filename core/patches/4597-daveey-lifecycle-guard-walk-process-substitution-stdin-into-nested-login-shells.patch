From 0dd94fe88e7686ed95d9e8542f59ccea5607ed57 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 18:17:34 +0000
Subject: [PATCH] [daveey] lifecycle guard: walk process-substitution stdin
 into nested login shells

`su -l bob < <(cat inner.sh)` and `bash -l < <(cat inner.sh)` passed
scan_gateway_lifecycle under session aliases {zz}/{}/None, while the
equivalent `su -l bob < inner.sh` was refused (PR #3081 review 5911162815
follow-up; pre-existing on main).

Why: _iter_nested_shell_inputs classified flat command views from
_iter_command_segment_views, which keep only the `<(...)` placeholder.
_iter_segment_contexts already resolves a `< <(cat f)` feed into a
contextual segment whose redirection is `< f`, but the nested walk never
used those segments, so the login shell's stdin script was never walked.

Fix: classify the views of the contextual segments instead. A plain
`bash < <(cat f)` (non-login, non-interactive) still keeps session scope,
as do `su -l bob -c true < <(cat f)` and `cat < <(cat f)`.

Tests: 9 refused shapes (su, bash -l, 0<, login sudo, ssh, nested <(...),
cat < f, brace group, subshell) under {zz}/{}/None; 4 session-scope controls.
---
 cron/lifecycle_guard_nested_shells.py              |  7 ++++++-
 tests/cron/test_lifecycle_guard_session_aliases.py | 13 +++++++++++++
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/cron/lifecycle_guard_nested_shells.py b/cron/lifecycle_guard_nested_shells.py
index e1868f5d75cc35189d088334a4c3d9ca00c384f6..b2c237586a58a77f38aac51a396d2488b502cdb3 100644
--- a/cron/lifecycle_guard_nested_shells.py
+++ b/cron/lifecycle_guard_nested_shells.py
@@ -550,8 +550,13 @@ def _iter_nested_shell_inputs(
         return
     from tools.shell_heredoc import iter_heredoc_bodies
 
+    from cron.lifecycle_guard import _command_segment_views, _iter_segment_contexts
+
+    # Contextual segments resolve process-substitution file feeds into redirections.
+    # Flat command views retain only the substitution placeholder, losing that file.
     classified = [(view, _nested_shell_input(view))
-                  for view in _iter_command_segment_views(walk_command)]
+                  for segment, _call_argument, _piped in _iter_segment_contexts(walk_command)
+                  for view in _command_segment_views(segment)]
     # Such a shell inside a compound command reads that command's stdin redirections and
     # heredocs (`{ su -l bob; } < f`, `( su -l bob ) <<< T`, `if …; then su -l bob; fi <<E`).
     # Where the group opens is not tracked (it may be lines earlier), nor whether the shell's own
diff --git a/tests/cron/test_lifecycle_guard_session_aliases.py b/tests/cron/test_lifecycle_guard_session_aliases.py
index ba72db4ee164933d54f99b8b0a281635d8ae06d3..6f0c7c1c5ca304df27bb3fc6cae680e613fe1c27 100644
--- a/tests/cron/test_lifecycle_guard_session_aliases.py
+++ b/tests/cron/test_lifecycle_guard_session_aliases.py
@@ -277,6 +277,15 @@ _NESTED_FOREIGN_SHELLS = [
     "su --sess='t ( bash {db} )' bob",
     "doas -a style -s <<< 't ( bash {db} )'",
     # A stdin file fed to a login-shell launcher is that shell's script (review 5903452583 B1).
+    "su -l bob < <(cat {script})",
+    "bash -l < <(cat {script})",
+    "su -l bob 0< <(cat {script})",
+    "sudo -i < <(cat {script})",
+    "ssh host < <(cat {script})",
+    "su -l bob < <(cat < {script})",
+    "su -l bob < <(cat <(cat {script}))",
+    "{{ su -l bob; }} < <(cat {script})",
+    "( bash -l ) < <(cat {script})",
     "su -l bob < {script}",
     "su - bob < {script}",
     "su bob < {script}",
@@ -351,6 +360,10 @@ def test_nested_login_shell_body_treats_names_as_unknown(tmp_path, live_kanban_d
     "bash -s <<'EOF'\nt ( bash {db} )\nEOF",
     "t2 ( bash {db} )",
     "bash <<< 't ( bash {db} )'",
+    "bash < <(cat {script})",
+    "bash -s < <(cat {script})",
+    "cat < <(cat {script})",
+    "su -l bob -c true < <(cat {script})",
     "bash < {script}",
     "bash -l 3<<< 't ( bash {db} )'",
     "ENV=x sh -c 't ( bash {db} )'",
-- 
