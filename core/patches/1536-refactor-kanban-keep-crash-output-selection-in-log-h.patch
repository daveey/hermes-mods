From c185ad7a11ac6f6a8c33c9182e1e379971b6b546 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 17:32:22 +0000
Subject: [PATCH] refactor(kanban): keep crash output selection in log helper
 [daveey]

---
 hermes_cli/kanban_db_dispatch.py | 7 ++-----
 hermes_cli/kanban_worker_log.py  | 9 +++++++++
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_db_dispatch.py b/hermes_cli/kanban_db_dispatch.py
index a6ab1fb6cc3..69ad27f0749 100644
--- a/hermes_cli/kanban_db_dispatch.py
+++ b/hermes_cli/kanban_db_dispatch.py
@@ -1228,7 +1228,7 @@ from hermes_cli.kanban_worker_log import (
     current_run_log, exit_summary_marker as _exit_summary_marker, log_noise_prefixes as _log_noise_prefixes)
 
 
-from hermes_cli.kanban_worker_log import _worker_final_output
+from hermes_cli.kanban_worker_log import _worker_final_output, crash_worker_output
 
 
 def _classify_dead_worker(
@@ -1254,10 +1254,7 @@ def _classify_dead_worker(
     else:
         dead = _ou.noted(_classify_dead_worker_exit(pid, claimer, exit_code, task_id=task_id, board=board, run_id=run_id), conn, task_id, run_id, log)
     if task_id and not dead.rate_limited:
-        from hermes_cli.kanban_worker_log import managed_worker_output
-        worker_output = managed_worker_output(conn, task_id, run_id, pid, claimer)
-        if worker_output is None:
-            worker_output = _worker_final_output(task_id, board=board, run_id=run_id)
+        worker_output = crash_worker_output(conn, task_id, run_id, pid, claimer, board=board)
         if worker_output:
             dead.error_text += f"{WORKER_OUTPUT_SEP}{worker_output!r}"
             dead.event_payload["worker_output"] = worker_output
diff --git a/hermes_cli/kanban_worker_log.py b/hermes_cli/kanban_worker_log.py
index 21149941115..af4c891b401 100644
--- a/hermes_cli/kanban_worker_log.py
+++ b/hermes_cli/kanban_worker_log.py
@@ -105,6 +105,15 @@ def current_run_log(raw: str, run_id=None) -> str:
     return body[starts[-1].start():] if starts else body
 
 
+def crash_worker_output(conn, task_id, run_id, pid, claim_lock, *, board=None) -> str:
+    """Select run-owned managed output, retaining the legacy log reader's patch seam."""
+    output = managed_worker_output(conn, task_id, run_id, pid, claim_lock)
+    if output is not None:
+        return output
+    from hermes_cli import kanban_db_dispatch as dispatch
+    return dispatch._worker_final_output(task_id, board=board, run_id=run_id)
+
+
 def managed_worker_output(conn, task_id, run_id, pid, claim_lock) -> Optional[str]:
     """Prefer an attributable receipt over the shared log, even if its output is empty.
 
-- 
2.55.0

