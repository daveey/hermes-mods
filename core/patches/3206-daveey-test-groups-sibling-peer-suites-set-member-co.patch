From 292472190f7c6d31c39701c400ef10abeb41f654 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 06:52:37 +0000
Subject: [PATCH] [daveey] test(groups): sibling peer suites set member config
 through the fixture and boot via _member

62fce90aea moved the member gateway's config.yaml write to its first boot
(api_daemon picks the port then), but two suites import that `gateways`
fixture, edit target/config.yaml right after creating it and boot the member
with plain `daemon`. On main both fail every run with FileNotFoundError on
target/config.yaml:
  test_session_group_peer_setup_daemons.py::test_a_setup_stopped_between_its_steps_...
  test_session_group_peer_approvals.py::test_lent_bot_approval_survives_reregistration_...

The fixture now takes `target_config` (top-level keys, dicts merged one level),
applied to every config write, and both suites boot the member through
`_member`, so they also get the owned-port boot instead of the old race.
---
 .../gateway/test_session_group_peer_approvals.py | 11 ++++-------
 tests/gateway/test_session_group_peer_daemons.py | 16 +++++++++++-----
 .../test_session_group_peer_setup_daemons.py     | 11 ++++-------
 3 files changed, 19 insertions(+), 19 deletions(-)

diff --git a/tests/gateway/test_session_group_peer_approvals.py b/tests/gateway/test_session_group_peer_approvals.py
index aefcc419b2..c820796a33 100644
--- a/tests/gateway/test_session_group_peer_approvals.py
+++ b/tests/gateway/test_session_group_peer_approvals.py
@@ -7,7 +7,7 @@ import pytest
 
 from tests.gateway.fixtures.local_recovery_probe import daemon, rpc, websocket
 from tests.gateway.test_session_group_peer_daemons import (
-    Model, _create, _events, _invite, _register, _room_link, _send, _wait_rpc,
+    Model, _create, _events, _invite, _member, _register, _room_link, _send, _wait_rpc,
     gateways as gateways_fixture,
 )
 
@@ -40,11 +40,8 @@ class _ApprovalModel(Model):
 
 @pytest.mark.platforms('posix')
 def test_lent_bot_approval_survives_reregistration_and_runs_each_command_once(gateways):
-    g = gateways(handler=_ApprovalModel)
-    config = json.loads((g.target / 'config.yaml').read_text())
-    config['platform_toolsets']['api_server'] = ['terminal']
-    config['approvals'] = {'mode': 'manual'}
-    (g.target / 'config.yaml').write_text(json.dumps(config))
+    g = gateways(handler=_ApprovalModel, target_config={
+        'platform_toolsets': {'api_server': ['terminal']}, 'approvals': {'mode': 'manual'}})
     effects = g.target / 'effects'
     g.target_model.command = (
         f'rm -rf {shlex.quote(str(g.target / "disposable"))}; '
@@ -84,6 +81,6 @@ def test_lent_bot_approval_survives_reregistration_and_runs_each_command_once(ga
                 assert effects.read_text().splitlines() == ['ran'] * turn
                 assert (await rpc(home_ws, 'groups.state', room_id='linked'))['result']['driver_status']['pending_actions'] == []
 
-    with daemon(g.root, g.target, g.target_env, barrier=False) as (_, target_desc):
+    with _member(g) as (_, target_desc):
         with daemon(g.root, g.home, g.home_env, barrier=False) as (_, home_desc):
             asyncio.run(exercise(home_desc, target_desc))
diff --git a/tests/gateway/test_session_group_peer_daemons.py b/tests/gateway/test_session_group_peer_daemons.py
index 169d14025f..900d547333 100644
--- a/tests/gateway/test_session_group_peer_daemons.py
+++ b/tests/gateway/test_session_group_peer_daemons.py
@@ -67,16 +67,19 @@ def _model(reply, *markers, handler=Model):
     return server
 
 
-def _write_config(home, model, *, api_port=None, link_port=None):
+def _write_config(home, model, *, api_port=None, link_port=None, overrides=None):
     base = f'http://127.0.0.1:{model.server_port}/v1'
     gateway = {'multiplex_profiles': False}
     if api_port is not None:
         gateway |= {'room_link_url': f'http://127.0.0.1:{link_port or api_port}',
                     'platforms': {'api_server': {'enabled': True, 'port': api_port, 'host': '127.0.0.1'}}}
-    (home / 'config.yaml').write_text(json.dumps({
+    config = {
         'model': {'provider': 'custom', 'default': 'room-model', 'base_url': base},
         'gateway': gateway, 'platform_toolsets': {'gui': [], 'bot_room': [], 'api_server': []},
-        'auxiliary': {'title_generation': {'enabled': False}}, 'terminal': {'cwd': str(home)}}))
+        'auxiliary': {'title_generation': {'enabled': False}}, 'terminal': {'cwd': str(home)}}
+    for key, value in (overrides or {}).items():
+        config[key] = config[key] | value if isinstance(config.get(key), dict) else value
+    (home / 'config.yaml').write_text(json.dumps(config))
 
 
 def _gateway(tmp_path, name, model, root, *, api_server=False):
@@ -99,7 +102,9 @@ def gateways(tmp_path):
     """Isolated models and gateway environments; tests own every daemon/restart boundary."""
     models, relays = [], []
 
-    def create(*markers, lossy=False, handler=Model):
+    def create(*markers, lossy=False, handler=Model, target_config=None):
+        """``target_config`` overrides top-level member config keys (dicts merge one level deep). The
+        member's config.yaml is written only at its first boot (``_member``), so edit it through this."""
         root = Path(__file__).resolve().parents[2]
         home_model, target_model = _model('HOME_REPLY'), _model('PEER_REPLY', *markers, handler=handler)
         models.extend((home_model, target_model))
@@ -115,7 +120,8 @@ def gateways(tmp_path):
             g.api_port, g.target_env['API_SERVER_PORT'] = port, str(port)
             if relay:
                 relay.target_port = port
-            _write_config(target, target_model, api_port=port, link_port=relay.port if relay else None)
+            _write_config(target, target_model, api_port=port, link_port=relay.port if relay else None,
+                          overrides=target_config)
         g.write_target_config = write_target_config
         return g
     yield create
