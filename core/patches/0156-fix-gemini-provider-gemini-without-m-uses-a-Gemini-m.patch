diff --git a/hermes_cli/cli_agent_setup_mixin.py b/hermes_cli/cli_agent_setup_mixin.py
index f9a74812d7..6ab10e581a 100644
--- a/hermes_cli/cli_agent_setup_mixin.py
+++ b/hermes_cli/cli_agent_setup_mixin.py
@@ -327,6 +327,24 @@ class CLIAgentSetupMixin:
             except Exception:
                 pass
 
+        # [daveey] `--provider gemini` without `-m` must not send the config's claude-* model to Gemini
+        # (404 on every call): a model that clearly belongs to another vendor falls back to the
+        # provider's default. Unknown/ambiguous ids pass through untouched.
+        if getattr(self, "_provider_flag_without_model", False) and resolved_provider and isinstance(self.model, str):
+            try:
+                from hermes_cli.model_normalize import model_conflicts_with_provider
+                if model_conflicts_with_provider(self.model, resolved_provider):
+                    from hermes_cli.models import get_default_model_for_provider
+                    _default = get_default_model_for_provider(resolved_provider)
+                    if _default:
+                        logger.info(
+                            "--provider %s without -m: configured model %s belongs to another vendor; "
+                            "using %s", resolved_provider, self.model, _default)
+                        self.model = _default
+                        self._model_is_default = True
+            except Exception:
+                logger.debug("provider-default model swap failed", exc_info=True)
+
         # Normalize model for the resolved provider (e.g. swap non-Codex models on openai-codex).
         # Fixes #651.
         model_changed = self._normalize_model_for_provider(resolved_provider)
diff --git a/hermes_cli/cli_init_mixin.py b/hermes_cli/cli_init_mixin.py
index 254f2e864a..86e03844a9 100644
--- a/hermes_cli/cli_init_mixin.py
+++ b/hermes_cli/cli_init_mixin.py
@@ -162,6 +162,7 @@ class CLIInitMixin:
         # `--provider <custom>` without `-m` uses that entry's default_model, else the global
         # default goes to the custom endpoint and the compressor gets the wrong context length.
         # Explicit `-m` still wins. See #86978.
+        _custom_default_applied = False
         if not model and provider:
             try:
                 from hermes_cli.runtime_provider import _get_named_custom_provider
@@ -177,6 +178,11 @@ class CLIInitMixin:
             if _provider_default:
                 self.model = _provider_default
                 self._model_is_default = False
+                _custom_default_applied = True
+        # [daveey] `--provider X` without `-m` (and no custom default above): the config's model belongs
+        # to the config's provider, so _ensure_runtime_credentials swaps it for X's default when it
+        # clearly belongs to another vendor (claude-* on gemini 404s on every call).
+        self._provider_flag_without_model = bool(provider) and not model and not _custom_default_applied
         self._provider_source: Optional[str] = None
         self.provider = self.requested_provider
         self.api_mode = "chat_completions"
diff --git a/hermes_cli/model_normalize.py b/hermes_cli/model_normalize.py
index 395c536ab5..dfbc0a04c6 100644
--- a/hermes_cli/model_normalize.py
+++ b/hermes_cli/model_normalize.py
@@ -159,6 +159,29 @@ def detect_vendor(model_name: str) -> Optional[str]:
     return next((vendor for prefix, vendor in _VENDOR_PREFIXES.items() if name_lower.startswith(prefix)), None)
 
 
+# [daveey] Direct providers that serve only their own vendor's models. A model whose detected vendor is
+# another one (``claude-opus-5-5`` on ``gemini``) can never work there: the API 404s on every call.
+_SINGLE_VENDOR_PROVIDERS: dict[str, str] = {
+    "gemini": "google",
+    "anthropic": "anthropic"}
+
+
+def model_conflicts_with_provider(model_name: object, provider: str) -> bool:
+    """True only when ``model_name`` clearly belongs to another vendor than single-vendor ``provider``.
+
+    Unknown vendors, aggregators and every other provider return False: this is a "certainly wrong"
+    check (used when ``--provider`` is given without ``-m``), never a guess about an unfamiliar id."""
+    if not isinstance(model_name, str) or not model_name.strip():
+        return False
+    expected = _SINGLE_VENDOR_PROVIDERS.get(_normalize_provider_alias(provider or ""))
+    if not expected:
+        return False
+    vendor = detect_vendor(_strip_matching_provider_prefix(model_name.strip(), provider))
+    # Only vendors from the known table count: ``models/gemini-…`` (Gemini's own resource form) or a
+    # custom ``org/model`` prefix is no evidence of a mismatch.
+    return vendor in set(_VENDOR_PREFIXES.values()) and vendor != expected
+
+
 def _prepend_vendor(model_name: str) -> str:
     """Prepend the detected ``vendor/`` for aggregators; names with ``/`` or no detectable vendor
     pass through (the aggregator may still accept them)."""
