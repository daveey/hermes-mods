diff --git a/tests/agent/test_gemini_aux_default_model.py b/tests/agent/test_gemini_aux_default_model.py
new file mode 100644
index 0000000000..98c7625bd0
--- /dev/null
+++ b/tests/agent/test_gemini_aux_default_model.py
@@ -0,0 +1,20 @@
+"""[daveey] Gemini's auxiliary default (title generation etc.) must be a model new AI Studio keys can
+use: gemini-2.5-* returns 404 "no longer available to new users"."""
+
+from agent.auxiliary_client import _get_aux_model_for_provider, resolve_provider_client
+from agent.gemini_native_adapter import GeminiNativeClient
+
+
+def test_gemini_aux_default_is_current_flash():
+    assert _get_aux_model_for_provider("gemini") == "gemini-3.8-flash"
+
+
+def test_title_generation_on_gemini_without_model_uses_current_flash(monkeypatch):
+    monkeypatch.setenv("GEMINI_API_KEY", "test-gemini-key")
+    monkeypatch.delenv("GOOGLE_API_KEY", raising=False)
+    monkeypatch.delenv("GEMINI_BASE_URL", raising=False)
+
+    client, model = resolve_provider_client("gemini", None, task="title_generation")
+
+    assert isinstance(client, GeminiNativeClient)
+    assert model == "gemini-3.8-flash"
diff --git a/tests/hermes_cli/test_cli_provider_resolution.py b/tests/hermes_cli/test_cli_provider_resolution.py
index 6e197b98b1..98237a4cb1 100644
--- a/tests/hermes_cli/test_cli_provider_resolution.py
+++ b/tests/hermes_cli/test_cli_provider_resolution.py
@@ -875,3 +875,52 @@ def test_custom_endpoint_key_env_is_a_valid_posix_name_for_ip_endpoints():
     for identity in ("127.0.0.1_8080", "0.0.0.0", "10.0.0.7:11434", "", "-–-"):
         assert _ENV_VAR_NAME_RE.match(custom_endpoint_key_env(identity)), identity
 
+
+
+# [daveey] `--provider gemini` without `-m` used to send the config's claude-* model to Gemini (404).
+def _gemini_runtime(**kwargs):
+    return {
+        "provider": "gemini",
+        "api_mode": "chat_completions",
+        "base_url": "https://generativelanguage.googleapis.com/v1beta",
+        "api_key": "test-gemini-key",
+        "source": "env",
+    }
+
+
+def _claude_config(monkeypatch, cli, default="claude-opus-5-5"):
+    monkeypatch.setitem(cli.CLI_CONFIG, "model", {"default": default, "provider": "anthropic"})
+    monkeypatch.setattr("hermes_cli.runtime_provider.resolve_runtime_provider", _gemini_runtime)
+
+
+def test_provider_switch_without_model_drops_foreign_vendor_model(monkeypatch):
+    cli = _import_cli()
+    _claude_config(monkeypatch, cli)
+    from hermes_cli.models import get_default_model_for_provider
+
+    shell = cli.HermesCLI(provider="gemini", compact=True, max_turns=1)
+    assert shell._ensure_runtime_credentials() is True
+
+    assert shell.provider == "gemini"
+    assert shell.model == get_default_model_for_provider("gemini") == "gemini-3.8-flash"
+
+
+def test_provider_switch_with_explicit_model_keeps_it(monkeypatch):
+    """An explicit -m is the user's call, even a foreign-vendor one."""
+    cli = _import_cli()
+    _claude_config(monkeypatch, cli)
+
+    for explicit in ("gemini-3.6-flash", "claude-opus-5-5"):
+        shell = cli.HermesCLI(provider="gemini", model=explicit, compact=True, max_turns=1)
+        assert shell._ensure_runtime_credentials() is True
+        assert shell.model == explicit
+
+
+@pytest.mark.parametrize("configured", ["gemini-3.7-flash", "models/gemini-3.7-flash", "my-private-finetune"])
+def test_provider_switch_without_model_keeps_same_vendor_or_unknown_model(monkeypatch, configured):
+    cli = _import_cli()
+    _claude_config(monkeypatch, cli, default=configured)
+
+    shell = cli.HermesCLI(provider="gemini", compact=True, max_turns=1)
+    assert shell._ensure_runtime_credentials() is True
+    assert shell.model == configured
diff --git a/tests/hermes_cli/test_model_normalize.py b/tests/hermes_cli/test_model_normalize.py
index 3b368d0ee7..57899704c6 100644
--- a/tests/hermes_cli/test_model_normalize.py
+++ b/tests/hermes_cli/test_model_normalize.py
@@ -201,3 +201,22 @@ class TestColonProviderPrefixIsStrippedLikeSlash:
     ])
     def test_non_matching_colon_untouched(self, model, provider):
         assert normalize_model_for_provider(model, provider) == model
+
+
+class TestModelConflictsWithProvider:
+    """[daveey] Only certain cross-vendor mismatches on single-vendor providers count."""
+
+    @pytest.mark.parametrize(("model", "provider"), [
+        ("claude-opus-5-5", "gemini"), ("gpt-5.5", "gemini"), ("anthropic/claude-sonnet-5", "google"),
+        ("gemini-3.8-flash", "anthropic")])
+    def test_conflicts(self, model, provider):
+        from hermes_cli.model_normalize import model_conflicts_with_provider
+        assert model_conflicts_with_provider(model, provider)
+
+    @pytest.mark.parametrize(("model", "provider"), [
+        ("gemini-3.8-flash", "gemini"), ("google/gemini-3.8-flash", "gemini"), ("models/gemini-3.8-flash", "gemini"),
+        ("gemma-4-27b", "gemini"), ("my-finetune", "gemini"), ("", "gemini"), (None, "gemini"),
+        ("claude-opus-5-5", "openrouter"), ("claude-opus-5-5", "custom"), ("claude-opus-5-5", "anthropic")])
+    def test_no_conflict(self, model, provider):
+        from hermes_cli.model_normalize import model_conflicts_with_provider
+        assert not model_conflicts_with_provider(model, provider)
