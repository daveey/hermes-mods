 tests/agent/test_gemini_aux_default_model.py  | 20 ++++++++
 .../test_cli_provider_resolution.py           | 49 +++++++++++++++++++
 tests/hermes_cli/test_model_normalize.py      | 19 +++++++
 9 files changed, 139 insertions(+), 4 deletions(-)
