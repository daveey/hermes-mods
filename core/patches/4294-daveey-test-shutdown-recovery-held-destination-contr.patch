From ba64b1d730b54e59882908fe3752b922c5feb5c6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:34:36 +0000
Subject: [PATCH] [daveey] test shutdown recovery held destination contract

Pin the exact held set to both ancestor s and destination tip in all three real-DB spool variants. Preserve unrelated progress, byte custody, ordered retry and idempotence coverage. Scope is the returned held-set contract, not an invented changing-lineage scenario.

Proof: canonical route suite 3 passed; deleting exactly blocked_sessions[target_sid] = blocked_sessions.get(target_sid, 0) + 1 under sources.intersection yields 3 failures (missing tip), zero skips. Restored production plus passive-row suite and scripts/check --base origin/main pass. No production changes.
---
 tests/gateway/test_shutdown_route_order.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/gateway/test_shutdown_route_order.py b/tests/gateway/test_shutdown_route_order.py
index 2a0f0c62dd..28cdb83512 100644
--- a/tests/gateway/test_shutdown_route_order.py
+++ b/tests/gateway/test_shutdown_route_order.py
@@ -36,7 +36,9 @@ def test_route_read_failure_preserves_order(parked, spool_home, monkeypatch, lat
         patcher.setattr(db, '_read_ctx', fail_once)
         recovered, blocked = shutdown_flush.recover_pending_spool(db)
     assert recovered == 1
-    assert 's' in blocked
+    # The failed lookup only knew s; holding a later row must also mark its
+    # destination so the live writer knows tip still has spool custody.
+    assert blocked == {'s', 'tip'}
     assert [m['content'] for m in db.get_messages('tip')] == ['summary']
     assert [m['content'] for m in db.get_messages('unrelated')] == ['independent']
     remaining = helpers._spool_files()
