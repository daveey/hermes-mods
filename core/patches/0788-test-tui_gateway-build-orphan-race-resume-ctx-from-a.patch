From 264ba95bc9efa13851d0d8f281bc5976d031bd37 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 16:45:19 +0000
Subject: [PATCH] test(tui_gateway): build orphan-race resume ctx from a real
 _Resume [daveey]

The late-RPC reuse cases used a duck-typed SimpleNamespace ctx that predates
_resume_reuse_live_locked reading ctx.lazy (0864c0ca49), so both
[closed-reuse] and [live-reuse] raised AttributeError on main. Build the ctx
from server._Resume and stub only the DB-touching mint/restore, so new ctx
reads can't silently break these fixtures again. Reap assertions unchanged.
---
 tests/tui_gateway/test_ws_orphan_races.py | 25 ++++++++++++-----------
 1 file changed, 13 insertions(+), 12 deletions(-)

diff --git a/tests/tui_gateway/test_ws_orphan_races.py b/tests/tui_gateway/test_ws_orphan_races.py
index 30fa11db90..4c99577cce 100644
--- a/tests/tui_gateway/test_ws_orphan_races.py
+++ b/tests/tui_gateway/test_ws_orphan_races.py
@@ -149,6 +149,17 @@ def test_orphan_interrupt_claim_clears_when_session_leaves_detached_state(monkey
     assert sid not in server._pending_ws_reaps
 
 
+def _resume_ctx():
+    """A real ``session.resume`` ctx, so every attribute the resume paths read exists (e.g. ``lazy``, which a
+    duck-typed double silently lacked); only the DB-touching steps are stubbed — these tests drive live-session
+    races, not history reads."""
+    ctx = server._Resume(1, {"omit_messages": True}, "stored")
+    ctx.found = {}
+    ctx.mint = lambda prompts=True: ("unused", "tui", ".")
+    ctx.restore = lambda: ([], [], [])
+    return ctx
+
+
 @pytest.mark.parametrize("path", ["unpersisted", "reuse", "eager", "activate", "prompt"])
 @pytest.mark.parametrize("claim", ["already_claimed", "wins_lock", "retired"])
 def test_reconnect_cannot_cross_orphan_interrupt_claim(monkeypatch, path, claim):
@@ -184,12 +195,7 @@ def test_reconnect_cannot_cross_orphan_interrupt_claim(monkeypatch, path, claim)
             self.held = False
 
     monkeypatch.setattr(server, "_session_resume_lock", ResumeLock())
-    ctx = SimpleNamespace(rid=1, owns_db=False, db=None, cols=80, omit_messages=True,
-                          defer_history=False, target="stored", profile=None,
-                          profile_home=None, profile_resume_cwd=None, found={},
-                          messages=lambda history: [], mint=lambda: ("unused", "tui", "."),
-                          restore=lambda: ([], [], []), display_prefix=list,
-                          inline_images=True)
+    ctx = _resume_ctx()
     if path == "eager":
         monkeypatch.setattr(server, "_profile_build_scope", lambda *a: nullcontext())
         monkeypatch.setattr(server, "_make_agent_in_context", lambda *a, **kw: Mock())
@@ -249,12 +255,7 @@ def test_late_rpc_from_closed_socket_keeps_orphan_reap_armed(monkeypatch, path,
     monkeypatch.setattr(server, "_load_dashboard_process_isolation_config", dict)
     monkeypatch.setattr(server, "_handle_busy_submit", lambda *a, **kw: {"result": {"status": "queued"}})
     monkeypatch.setattr(server, "_sess", lambda *a: (session, None))
-    ctx = SimpleNamespace(rid=1, owns_db=False, db=None, cols=80, omit_messages=True,
-                          defer_history=False, target="stored", profile=None,
-                          profile_home=None, profile_resume_cwd=None, found={},
-                          messages=lambda history: [], mint=lambda: ("unused", "tui", "."),
-                          restore=lambda: ([], [], []), display_prefix=list,
-                          inline_images=True)
+    ctx = _resume_ctx()
     if path == "unpersisted":
         response = server._resume_live_unpersisted(ctx, sid, session)
     elif path == "reuse":
