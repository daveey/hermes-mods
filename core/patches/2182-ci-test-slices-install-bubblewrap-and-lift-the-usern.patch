From b3ef6789d0bfce32e9d2cf7ae22dc4460fcda300 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 06:17:09 +0000
Subject: [PATCH] ci: test slices install bubblewrap and lift the userns
 restriction on Blacksmith [daveey]

PR #1077 run 42969943079: tests/ci/test_plugin_*sandbox*.py failed with
'bubblewrap (bwrap) is not installed'. The tfgar runner AMI shipped bwrap with
userns allowed; Blacksmith's Ubuntu 24.04 image has neither.
---
 .github/workflows/tests.yml | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index db55493ba4..38322c29aa 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -93,6 +93,15 @@ jobs:
           command -v tmux >/dev/null || { sudo apt-get update -qq && sudo apt-get install -y -qq tmux; }
           tmux -V
 
+      - name: Install bubblewrap and allow user namespaces
+        # tests/ci/test_plugin_*sandbox*.py run real bubblewrap. Blacksmith's Ubuntu 24.04 image
+        # ships no bwrap and restricts unprivileged userns (the old tfgar AMI did both at bake time).
+        run: |
+          set -euo pipefail
+          command -v bwrap >/dev/null || { sudo apt-get update -qq && sudo apt-get install -y -qq bubblewrap; }
+          sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
+          bwrap --ro-bind / / --unshare-user --unshare-pid true
+
       - name: Set up locked Python and test dependencies
         uses: ./.github/actions/setup-pm
         with:
-- 
2.55.0

