From 8dfcbd174f37f797935a334c9a95b498b8f5f963 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 17:56:08 +0000
Subject: [PATCH] fix(worker): preserve legacy read lineage precheck [daveey]

---
 agent/runtime_session_compression.py          |  5 +++
 .../test_worker_session_context_query.py      | 31 +++++++++++++++++++
 2 files changed, 36 insertions(+)

diff --git a/agent/runtime_session_compression.py b/agent/runtime_session_compression.py
index 105dcead2d..88de4a3605 100644
--- a/agent/runtime_session_compression.py
+++ b/agent/runtime_session_compression.py
@@ -48,6 +48,11 @@ class RuntimeSessionCompressionMixin:
                     except _retryable_owner_errors() as exc:
                         if not is_retryable_owner_error(exc) or attempt + 1 == _RETRYABLE_ATTEMPTS:
                             raise
+            # Old owners journal reads; reject foreign targets before enqueueing one.
+            if session_id != self.scope['session_id']:
+                ids = self._apply('compression.lineage', {'target': self.scope['session_id']})['readable_ids']
+                if session_id not in ids:
+                    raise WorkerPersistenceError('permission_denied')
             return self._apply('compression.context', {'target': session_id})['session']
 
     def get_compression_lineage(self, session_id):
diff --git a/tests/gateway/test_worker_session_context_query.py b/tests/gateway/test_worker_session_context_query.py
index d40b76cec0..1b12592214 100644
--- a/tests/gateway/test_worker_session_context_query.py
+++ b/tests/gateway/test_worker_session_context_query.py
@@ -133,6 +133,37 @@ def test_context_legacy_owner_fallback_only_for_method_not_found(worker):
     assert calls.count('worker.persist') == 2
 
 
+@pytest.mark.parametrize('cached_legacy', [False, True])
+def test_context_legacy_refused_target_does_not_poison_store(worker, cached_legacy):
+    store, original = worker.store, worker.store.rpc
+    worker.db.create_session('foreign', 'cli')
+    calls = []
+
+    def legacy(method, **params):
+        calls.append((method, params.get('operation'), params.get('payload')))
+        if method == 'worker.sessionContext':
+            error = WorkerPersistenceError('Method not found')
+            error.code = -32601
+            raise error
+        return original(method, **params)
+
+    store.rpc = legacy
+    if cached_legacy:
+        assert store.get_session('owned')['id'] == 'owned'
+        calls.clear()
+    with pytest.raises((WorkerPersistenceError, RuntimeStoreError), match='^permission_denied$'):
+        store.get_session('foreign')
+    assert store.failure is None
+    assert store.journal['pending'] == []
+    assert not any(operation == 'compression.context' for _, operation, _ in calls)
+    assert store.get_session('owned')['id'] == 'owned'
+    assert store.try_acquire_compression_lock('owned', 'after-refused-read')
+    store.publish_compression_child(parent_session_id='owned', child_session_id='child', source='cli',
+        messages=[{'role': 'assistant', 'content': 'summary'}], compression_lock_holder='after-refused-read')
+    assert store.get_session('child')['id'] == 'child'
+    assert store.get_session('owned')['id'] == 'owned'
+
+
 @pytest.mark.parametrize('code', [None, 4001, -32603])
 def test_context_does_not_downgrade_other_owner_errors(worker, code):
     calls = []
