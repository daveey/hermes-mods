From b5af5ccd09250326dd74adfdeda001d43f5a35c5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 13:59:38 +0000
Subject: [PATCH] test(kanban): wait for admitted dispatcher launch [daveey]

---
 tests/gateway/fixtures/kanban_owner_probe.py | 26 ++++++++++++++++++--
 tests/gateway/test_session_kanban.py         |  7 +++++-
 2 files changed, 30 insertions(+), 3 deletions(-)

diff --git a/tests/gateway/fixtures/kanban_owner_probe.py b/tests/gateway/fixtures/kanban_owner_probe.py
index 042908a72ef..281cd8e810c 100644
--- a/tests/gateway/fixtures/kanban_owner_probe.py
+++ b/tests/gateway/fixtures/kanban_owner_probe.py
@@ -66,7 +66,8 @@ def main():
     os.environ['HERMES_KANBAN_HOME'] = str(home)
     peer = ThreadingHTTPServer(('127.0.0.1', 0), Model)
     peer.requests = []
-    peer.mode = os.environ.get('KANBAN_PROBE_MODE', 'complete')
+    contended = os.environ.get('KANBAN_PROBE_MODE') == 'timeout_contended'
+    peer.mode = 'timeout' if contended else os.environ.get('KANBAN_PROBE_MODE', 'complete')
     peer.blocked, peer.release = threading.Event(), threading.Event()
     threading.Thread(target=peer.serve_forever, daemon=True).start()
     url = f'http://127.0.0.1:{peer.server_port}/v1'
@@ -121,7 +122,28 @@ def main():
             subprocess.Popen = spawn
             try:
                 with closing(connect(board='owned')) as conn:
-                    launched = dispatch.dispatch_once(conn, board='owned', max_spawn=1)
+                    from contextlib import nullcontext
+                    from hermes_cli.admission_fence import admission_lock
+                    from hermes_constants import get_default_hermes_root
+                    # A descheduled reservation publisher can own this flock when the first tick runs.
+                    with admission_lock(get_default_hermes_root()) if contended else nullcontext():
+                        launched = dispatch.dispatch_once(conn, board='owned', max_spawn=1)
+                    if contended:
+                        assert launched.spawned == [], launched
+                        receipt['initial_claim_deferred'] = True
+                    from tests.waiting import wait_until
+                    def launch_when_admitted():
+                        nonlocal launched
+                        if launched.spawned:
+                            return launched
+                        # Only an unclaimed tick is retryable: never hide a failed/lost launch.
+                        pending = kb.get_task(conn, tid)
+                        runs = conn.execute('SELECT count(*) FROM task_runs WHERE task_id=?', (tid,)).fetchone()[0]
+                        assert pending is not None
+                        assert pending.status == 'ready' and pending.current_run_id is None and runs == 0, (pending, runs, launched)
+                        launched = dispatch.dispatch_once(conn, board='owned', max_spawn=1)
+                        return launched if launched.spawned else None
+                    launched = wait_until(launch_when_admitted, timeout=60, what='dispatcher claim and spawn')
                     assert [s[0] for s in launched.spawned] == [tid], launched
                     task = kb.get_task(conn, tid)
                     params = dict(task_id=tid, board='owned', run_id=task.current_run_id, claim_lock=task.claim_lock)
diff --git a/tests/gateway/test_session_kanban.py b/tests/gateway/test_session_kanban.py
index 9dea82e4546..6989fec9f1c 100644
--- a/tests/gateway/test_session_kanban.py
+++ b/tests/gateway/test_session_kanban.py
@@ -58,7 +58,8 @@ def test_claim_freezes_task_policy_and_rejects_forgery(tmp_path, monkeypatch):
         build_policy({'source': 'kanban', 'cwd': str(workspace)}, config)
 
 
-@pytest.mark.parametrize('mode', ['complete', 'timeout', 'rate_limit', 'billing', 'crash'])
+@pytest.mark.parametrize('mode', ['complete', 'timeout', 'rate_limit', 'billing', 'crash',
+    pytest.param('timeout_contended', marks=pytest.mark.platforms('posix'))])
 def test_real_dispatcher_lifecycle(tmp_path, mode):
     import os
     import subprocess
@@ -72,6 +73,10 @@ def test_real_dispatcher_lifecycle(tmp_path, mode):
     assert result.returncode == 0, result.stdout + result.stderr
     receipt = json.loads((tmp_path / 'state' / 'receipt.json').read_text())
     print(json.dumps(receipt))
+    if mode == 'timeout_contended':
+        assert receipt['initial_claim_deferred']
+        assert receipt['run_outcome'] == 'timed_out' and receipt['failures'] == 1
+        assert receipt['pid_preserved'] and receipt['managed_dead']
     if mode != 'complete':
         assert receipt['task_status'] == 'ready'
         return
-- 
2.55.0

