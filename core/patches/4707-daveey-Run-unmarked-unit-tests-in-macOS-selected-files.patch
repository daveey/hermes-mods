From 31122d738c5e92ebd8cd5769064be7623f53143f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 02:46:39 +0000
Subject: [PATCH] [daveey] Run unmarked unit tests in macOS-selected files

The file selector already imports mixed marked/unmarked modules, but the platforms marker expression hid native-only branches inside unmarked tests. Widen both macOS selectors, preserving Windows filtering and the separate GUI-session lane. Remove the temporary measurement matrix.

Proof: native baseline run 44196623242: 3481 passed, 613 skipped, 1040.7s; widened initially 9953 passed, 6 failed, 727 skipped, 1572.8s. Fixed run 44211177454: 9970 passed, zero failed, 727 skipped, 1562.5s. Full cron superset: 11172 passed, zero failed, 1089 skipped. Darwin stub removal run 44217005078 fails exactly the original loop-accounting test; restoration run 44217245650 is green. Local workflow and gate tests: 78 passed; original Bash cases plus shared gate: 71 passed. Native version-gate contract additionally invokes all four original substitution cases. Full check requires fresh main because the old base retains unrelated already-repaired health findings.
---
 .github/workflows/macos-os-tests.yml     | 41 ++++--------------------
 .github/workflows/tests-os.yml           | 19 +++++------
 tests/ci/test_macos_os_tests_workflow.py | 32 +++++++++++++++++-
 tests/cron/test_bash_execution.py        | 16 +++++++++
 4 files changed, 64 insertions(+), 44 deletions(-)

diff --git a/.github/workflows/macos-os-tests.yml b/.github/workflows/macos-os-tests.yml
index 9624726578360075766de8706fa15fb8516cee91..c5536f318b78d7a2b40e995755dd87d6e6f6ad7c 100644
--- a/.github/workflows/macos-os-tests.yml
+++ b/.github/workflows/macos-os-tests.yml
@@ -1,6 +1,6 @@
 name: macOS OS-marked tests (scheduled)
 
-# Runs the platforms("macos") / platforms("posix") tests on a real macOS host,
+# Runs unit tests in platforms("macos") / platforms("posix") files on a real macOS host,
 # on a schedule, against main. CI's tests-os lane (tests-os.yml) is off in this
 # fork (ci.yaml `if: false`: no GitHub-hosted macOS/Windows runner), so without
 # this nothing outside tests/hermes_state/ and the six Native memory paths ever
@@ -71,12 +71,7 @@ jobs:
         run: python3 scripts/ci/macos_os_tests_gate.py
 
   macos-os-tests:
-    name: macOS measurement (${{ matrix.selection }})
-    strategy:
-      fail-fast: false
-      max-parallel: 1
-      matrix:
-        selection: [widened, cron]
+    name: macOS-only tests (mini)
     needs: gate
     if: needs.gate.outputs.run == 'true' && github.repository == 'example-org/hermes'
     runs-on: [self-hosted, macOS, hermes-state]
@@ -96,10 +91,10 @@ jobs:
           # `all` intentionally excludes messaging; platform tests need its SDKs.
           extras: '["all", "messaging"]'
 
-      - name: Run macOS-marked tests
+      - name: Run macOS file selection
         # Same selection as tests-os.yml's macOS row: the helper narrows which
-        # files are imported; `-m "platforms and not integration"` decides which
-        # tests run (conftest skips foreign-OS specs). run_tests.sh fails the
+        # files are imported, including their unmarked unit tests. Conftest
+        # skips foreign-OS specs; GUI cases have their own lane. run_tests.sh fails the
         # run when nothing was collected, so an empty selection is never green.
         shell: bash
         run: |
@@ -110,37 +105,15 @@ jobs:
           LIST="$(mktemp "${RUNNER_TEMP:-/tmp}/macos-os-files.XXXXXX")"
           trap 'rm -rf "$HERMES_HOME" "$LIST"' EXIT
           /usr/bin/python3 scripts/ci/list_os_marked_tests.py macos > "$LIST"
-          MARKERS="not integration and not macos_login_session"
-          if [ "$SELECTION" = baseline ]; then
-            MARKERS="platforms and $MARKERS"
-          elif [ "$SELECTION" = cron ]; then
-            # Measure all cron tests, a conservative superset of real-Bash callers.
-            printf '%s\n' tests/cron/test_*.py > "$LIST"
-          fi
           test -s "$LIST"
-          mkdir -p "$RUNNER_TEMP/macos-measurement"
-          cp "$LIST" "$RUNNER_TEMP/macos-measurement/files.txt"
           echo "selected $(wc -l < "$LIST" | tr -d ' ') file(s)"
-          date -u
-          set +e
-          taskpolicy -c utility scripts/run_tests.sh --files-from "$LIST" -j 2 --file-retries 0 -- \
-            -m "$MARKERS" -v --tb=short -ra 2>&1 | tee "$RUNNER_TEMP/macos-measurement/tests.log"
-          status=${PIPESTATUS[0]}
-          date -u
-          exit "$status"
+          taskpolicy -c utility scripts/run_tests.sh --files-from "$LIST" -j 2 -- \
+            -m "not integration and not macos_login_session" --tb=short
         env:
-          SELECTION: ${{ matrix.selection }}
           OPENROUTER_API_KEY: ''
           OPENAI_API_KEY: ''
           NOUS_API_KEY: ''
 
-      - name: Preserve measurement logs
-        if: always()
-        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
-        with:
-          name: macos-measurement-${{ matrix.selection }}
-          path: ${{ runner.temp }}/macos-measurement/
-
   macos-login-session-tests:
     name: macOS login-session tests (mini)
     needs: gate
diff --git a/.github/workflows/tests-os.yml b/.github/workflows/tests-os.yml
index 7c1fe92547ad8c0aca8feeebfea18c96c5ba84a3..827f1e6939b204ade7c521dc0c5ef8781f1bc95c 100644
--- a/.github/workflows/tests-os.yml
+++ b/.github/workflows/tests-os.yml
@@ -11,17 +11,14 @@ name: OS-specific tests
 # reproducing any of the OS behaviour that branch exists for. This workflow
 # is where those markers actually execute:
 #
-#   macos    → ``-m platforms``    on blacksmith-12vcpu-macos-latest
+#   macos    → all non-integration, non-login-session tests in the listed files
 #   windows  → ``-m platforms``    on blacksmith-32vcpu-windows-2025 and windows-latest-32-arm-core
 #
-# (tests/conftest.py's ``pytest_collection_modifyitems`` hook skips
-# foreign-OS ``platforms(...)`` markers on each host, so one shared ``-m
-# platforms`` expression selects "this host's own marked tests" on either
-# lane — the helper narrows WHICH FILES get imported first.)
+# tests/conftest.py skips foreign-OS platforms(...) markers on each host.
+# The helper narrows WHICH FILES get imported first; unmarked tests in those
+# files run on macOS too, catching native branches that Linux cannot exercise.
 #
-# Deliberately NOT sliced. The marked set is small (tens of tests, not
-# thousands), so one plain ``pytest`` process per OS is both faster and far
-# less machinery than the per-file parallel runner the Linux lane uses.
+# The canonical per-file runner isolates imports; macOS uses two slices.
 # Each lane FAILS when it selects zero tests (pytest exit code 5) — a
 # renamed marker or bad selector can never report a green job that ran
 # nothing.
@@ -205,9 +202,13 @@ jobs:
           # ``-m`` — "must never pass without running its OS's tests").
           SEPARATOR="$(python -c 'import os, sys; sys.stdout.write(os.pathsep)')"
           FILES="$(tr -d '\r' < "$LIST" | paste -sd "$SEPARATOR" -)"
+          MARKERS="platforms and not integration"
+          if [ "${{ matrix.marker }}" = macos ]; then
+            MARKERS="not integration and not macos_login_session"
+          fi
           scripts/run_tests.sh --files "$FILES" -- \
             ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} \
-            -m "platforms and not integration" \
+            -m "$MARKERS" \
             -v --tb=short
         env:
           # These files spawn nested PowerShell trees. CPU-count parallelism
diff --git a/tests/ci/test_macos_os_tests_workflow.py b/tests/ci/test_macos_os_tests_workflow.py
index ec34913951e93283557154d016bad967d0eb8f98..c2d14c0d0bb6c1581f9b5739584950fecc1fb6d2 100644
--- a/tests/ci/test_macos_os_tests_workflow.py
+++ b/tests/ci/test_macos_os_tests_workflow.py
@@ -61,7 +61,7 @@ def test_test_job_waits_for_the_gate_and_runs_the_marked_selection_on_the_mini()
     assert "scripts/ci/list_os_marked_tests.py macos" in command
     assert 'test -s "$LIST"' in command
     assert "taskpolicy -c utility scripts/run_tests.sh --files-from \"$LIST\" -j 2" in command
-    assert '-m "platforms and not integration and not macos_login_session"' in command
+    assert '-m "not integration and not macos_login_session"' in command
 
 
 @pytest.mark.parametrize("domain_status", [0, 125])
@@ -89,6 +89,36 @@ def test_login_session_job_is_gated_and_requires_a_real_gui_domain(domain_status
     assert any(step.get("uses") == "./.github/actions/setup-pm" for step in job["steps"])
 
 
+@pytest.mark.parametrize("marker", ["macos", "windows"])
+def test_reusable_lane_preserves_windows_and_widens_only_macos(marker):
+    workflow = hermes_yaml.safe_load((ROOT / ".github/workflows/tests-os.yml").read_text(encoding="utf-8"))
+    job = workflow["jobs"]["os-tests"]
+    assert any(row["marker"] == marker for row in job["strategy"]["matrix"]["include"])
+    step = next(step for step in job["steps"] if step.get("name") == "Run ${{ matrix.marker }} tests")
+    command = step["run"]
+    assert '-m "$MARKERS"' in command
+    # Execute the actual selection branch, not a test-side copy of its conditions.
+    selection = command.split('MARKERS=', 1)
+    assert len(selection) == 2
+    shell = 'MARKERS=' + selection[1].split('scripts/run_tests.sh', 1)[0]
+    shell = shell.replace("${{ matrix.marker }}", marker)
+    result = subprocess.run(
+        ["bash", "-eu", "-c", shell + '\nprintf "%s" "$MARKERS"'],
+        capture_output=True, text=True, encoding="utf-8", check=True,
+    )
+    expected = "not integration and not macos_login_session" if marker == "macos" else "platforms and not integration"
+    assert result.stdout == expected
+
+
+def test_unmarked_darwin_regression_is_collected_in_widened_lane():
+    files, expression = _lane("macos-os-tests")
+    path = "tests/hermes_cli/test_loop_accounting.py"
+    node = path + "::test_without_procfs_snapshot_folds_exited_threads"
+    assert path in files
+    assert node in _collected([path], expression)
+    assert node not in _collected([path], "platforms and not integration")
+
+
 def test_session_runner_label_is_declared_for_actionlint():
     config = hermes_yaml.safe_load((ROOT / ".github/actionlint.yaml").read_text(encoding="utf-8"))
     assert "hermes-mac-session" in config["self-hosted-runner"]["labels"]
diff --git a/tests/cron/test_bash_execution.py b/tests/cron/test_bash_execution.py
index 30bceb986779b2338664aec3dfad51684041cfa2..d9f7f3e655b09027db48164096faa288567af4fb 100644
--- a/tests/cron/test_bash_execution.py
+++ b/tests/cron/test_bash_execution.py
@@ -6,6 +6,22 @@ import pytest
 from tests.cron import bash_execution as execution
 
 
+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("script", ["bash ./r.sh", "bash 2>$(echo /dev/null) < ./r.sh"])
+@pytest.mark.parametrize("wrapper", ['echo "$(BODY)"', 'echo "$(echo "$(BODY)")"'])
+def test_original_case_substitution_premises_use_shared_native_gate(tmp_path, script, wrapper):
+    from tests.cron import test_lifecycle_guard_substitution_comments as original
+
+    args = (tmp_path, 'case x in x) echo " # ";; esac; SCRIPT', wrapper, script, True)
+    # Native proof: no mocked version or substitute Bash. Old Bash must report
+    # the shared reason; Linux Bash 5 must still execute the original assertions.
+    if execution.system_bash_major() < 4:
+        with pytest.raises(pytest.skip.Exception, match="execution premise requires /bin/bash >= 4"):
+            original.test_nested_quote_comment_boundary(*args)
+    else:
+        original.test_nested_quote_comment_boundary(*args)
+
+
 @pytest.mark.parametrize("major", [3, 4, 5])
 def test_version_gate(monkeypatch, major):
     monkeypatch.setattr(execution, "system_bash_major", lambda: major)
