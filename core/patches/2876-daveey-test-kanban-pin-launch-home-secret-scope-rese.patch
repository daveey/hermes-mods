From 17ea16b8f4cf8b6b6fe338487a60c98d81d816b6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 17:43:56 +0000
Subject: [PATCH] [daveey] test(kanban): pin launch-home secret scope +
 reset-on-error for live pool reads via the dispatcher entry path

Kills two mutants of kanban_provider_walls._home_secret_scope that survived all 285 tests in the
13 suites importing the module (PR #1546 verification t_01a1d0b761d79481):
- M2 (no try/finally reset) -> test_failed_pool_read_in_tick_keeps_the_wall_and_restores_scope
- M4 (empty scope bound) -> test_dispatcher_tick_reads_pool_under_launch_home_scope_and_admits
---
 .../test_kanban_provider_walls_scope_entry.py | 131 ++++++++++++++++++
 1 file changed, 131 insertions(+)
 create mode 100644 tests/hermes_cli/test_kanban_provider_walls_scope_entry.py

diff --git a/tests/hermes_cli/test_kanban_provider_walls_scope_entry.py b/tests/hermes_cli/test_kanban_provider_walls_scope_entry.py
new file mode 100644
index 0000000000..a691373d4b
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_provider_walls_scope_entry.py
@@ -0,0 +1,131 @@
+"""The launch home's secret scope around live pool reads, through the dispatcher's own entry path [daveey].
+
+``dispatch.check_respawn_guard -> kanban_quota_episode.decision -> live_quota_room -> load_pool`` in a
+multiplexing process with two profile homes, each holding a fixture marker key. Only the pool reader's I/O
+boundary (``agent.credential_pool.load_pool``) is spied: the spy records which scope is bound when it is
+called and still delegates to the real reader over a fixture pool file. No real credentials.
+
+Pins two properties of ``kanban_provider_walls._home_secret_scope`` that the unit suites missed (PR #1546
+mutation run): the bound scope is the launch home's own (not an empty one, under which the singleton
+seeder's ``ANTHROPIC_TOKEN`` reads as missing), and it is reset even when the pool read raises (otherwise
+it leaks into every later read of that dispatcher Context).
+"""
+import contextvars
+
+import pytest
+
+from agent import secret_scope
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as dispatch
+from hermes_cli import kanban_provider_walls as walls
+from tests.hermes_cli.test_kanban_quota_episode import board as board, routing  # noqa: PLC0414 -- the self-alias suppresses F811 for the pytest fixture parameter
+from tests.hermes_cli.test_kanban_quota_episode_gateway import _clock, _on_gateway, _reap_wall
+
+DAY = 86_400
+MODEL = 'claude-opus-5-5'
+
+
+def _fixture_pool(tmp_path, monkeypatch):
+    from agent.credential_pool import PooledCredential
+    from hermes_cli.auth import write_credential_pool
+    monkeypatch.setenv('HERMES_SHARED_AUTH_DIR', str(tmp_path / 'shared'))
+    rows = [PooledCredential.from_dict('anthropic', dict(
+        id=f'acct{i}', label=f'account{i}', source='manual:device_code', auth_type='oauth',
+        access_token=f'fixture-access-{i}', refresh_token=f'fixture-refresh-{i}', priority=i)).to_dict()
+        for i in range(2)]
+    write_credential_pool('anthropic', rows)
+
+
+@pytest.fixture
+def two_scopes(board, tmp_path, monkeypatch):
+    """Launch home A (the board's HERMES_HOME) and a second profile home B, each with a marker key."""
+    home_a = board
+    (home_a / '.env').write_text('FIXTURE_SCOPE_MARK=home-a\n')
+    home_b = home_a / 'profiles' / 'b'
+    home_b.mkdir(parents=True)
+    (home_b / '.env').write_text('FIXTURE_SCOPE_MARK=home-b\n')
+    monkeypatch.delenv('FIXTURE_SCOPE_MARK', raising=False)
+    monkeypatch.setattr(secret_scope, '_MULTIPLEX_ACTIVE', True)
+    _fixture_pool(tmp_path, monkeypatch)
+    seen = []
+    import agent.credential_pool as cp
+    real = cp.load_pool
+
+    def spy(provider, **kw):
+        scope = secret_scope.current_secret_scope()
+        seen.append((provider, None if scope is None else scope.get('FIXTURE_SCOPE_MARK'),
+                     secret_scope.current_secret_scope_home()))
+        return real(provider, **kw)
+    monkeypatch.setattr(cp, 'load_pool', spy)
+    return home_a, home_b, seen
+
+
+def _foreign_wall_card(monkeypatch):
+    clock = _clock(monkeypatch)
+    routing(monkeypatch)
+    monkeypatch.setattr(walls, 'active_walls', lambda **_k: {})
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title='opus card walled on gateway A', assignee='a')
+        conn.execute("UPDATE tasks SET model_override=?, provider_override='anthropic' WHERE id=?", (MODEL, tid))
+        conn.commit()
+        _reap_wall(conn, tid, clock[0] + 5 * DAY)
+        clock[0] += 301
+    _on_gateway(monkeypatch, 'worker-b')  # this gateway did not record the wall: only its live pool decides
+    return tid
+
+
+def test_dispatcher_tick_reads_pool_under_launch_home_scope_and_admits(two_scopes, monkeypatch,
+                                                                       all_assignees_spawnable):
+    home_a, _home_b, seen = two_scopes
+    tid = _foreign_wall_card(monkeypatch)
+    seen.clear()  # count only the guard's own reads, not the setup's
+
+    def tick():
+        assert secret_scope.current_secret_scope() is None  # a dispatcher tick: empty Context
+        with kbc.connect() as conn:
+            return dispatch.check_respawn_guard(conn, tid)
+    assert contextvars.Context().run(tick) is None  # pool has room -> foreign wall lifted
+    assert seen, 'live_quota_room never reached load_pool'
+    # The launch home's own secrets are bound, not an empty scope.
+    assert {(p, mark) for p, mark, _h in seen} == {('anthropic', 'home-a')}
+    assert {h for _p, _m, h in seen} == {str(home_a)}
+    assert secret_scope.current_secret_scope() is None
+
+
+def test_routed_turn_for_home_b_keeps_home_b_scope(two_scopes, monkeypatch, all_assignees_spawnable):
+    _home_a, home_b, seen = two_scopes
+    tid = _foreign_wall_card(monkeypatch)
+    seen.clear()  # count only the guard's own reads, not the setup's
+
+    def turn():
+        token = secret_scope.set_secret_scope({'FIXTURE_SCOPE_MARK': 'home-b'}, profile_home=str(home_b))
+        try:
+            with kbc.connect() as conn:
+                return dispatch.check_respawn_guard(conn, tid)
+        finally:
+            secret_scope.reset_secret_scope(token)
+    assert contextvars.Context().run(turn) is None
+    assert seen and {(m, h) for _p, m, h in seen} == {('home-b', str(home_b))}
+
+
+def test_failed_pool_read_in_tick_keeps_the_wall_and_restores_scope(two_scopes, monkeypatch,
+                                                                     all_assignees_spawnable):
+    import agent.credential_pool as cp
+    tid = _foreign_wall_card(monkeypatch)
+    scopes_at_failure = []
+
+    def boom(provider, **_kw):
+        scopes_at_failure.append(secret_scope.current_secret_scope_home())
+        raise OSError('fixture: pool unreadable')
+    monkeypatch.setattr(cp, 'load_pool', boom)
+    monkeypatch.setattr(walls, '_READ_FAILURE_WARNED', {})
+
+    def tick():
+        with kbc.connect() as conn:
+            reason = dispatch.check_respawn_guard(conn, tid)
+        return reason, secret_scope.current_secret_scope()
+    reason, after = contextvars.Context().run(tick)
+    assert reason == 'subscription_quota_reset'  # a failed read is never "room"
+    assert scopes_at_failure and all(h is not None for h in scopes_at_failure)
+    assert after is None  # the home scope was reset after the exception
-- 
2.43.0

