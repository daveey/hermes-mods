From 542663b487e8efb79038bcc834593ecc72a00608 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 18:32:37 +0000
Subject: [PATCH] [daveey] D2: health fixes (narrow accounting except, module
 flag not env var, HX015 waiver on the scratch copy)

---
 hermes_state_rank_memo.py      | 10 ++++++----
 scripts/benchmark_rank_memo.py | 10 +++++-----
 2 files changed, 11 insertions(+), 9 deletions(-)

diff --git a/hermes_state_rank_memo.py b/hermes_state_rank_memo.py
index d51745a2a5..fc2bfdc634 100644
--- a/hermes_state_rank_memo.py
+++ b/hermes_state_rank_memo.py
@@ -40,7 +40,6 @@ from __future__ import annotations
 
 import json
 import logging
-import os
 import re
 import sqlite3
 import threading
@@ -319,8 +318,8 @@ def _account(outcome: str) -> None:
                   fallback=outcome.startswith("fallback/"), outer=False)
         if outcome.startswith("fallback/"):
             la.record(f"recency.rank_memo.{outcome}", outer=False)
-    except Exception:
-        pass
+    except (ImportError, AttributeError, TypeError, ValueError):  # accounting never fails a read
+        logger.debug("rank memo pass accounting failed", exc_info=True)
 
 
 def ranked_ids(conn, memo: RankMemo, key: tuple, need: int, exact_ids, restricted_ids) -> list:
@@ -398,5 +397,8 @@ def project(conn, memo: RankMemo, ids_rows: list, select_head: str, prompt_join:
     return rows
 
 
+ENABLED = True  # tests and the benchmark flip it to compare against the exact ranking
+
+
 def enabled() -> bool:
-    return os.environ.get("HERMES_RANK_MEMO", "1") != "0"
+    return ENABLED
diff --git a/scripts/benchmark_rank_memo.py b/scripts/benchmark_rank_memo.py
index 313f604060..5a5e326166 100644
--- a/scripts/benchmark_rank_memo.py
+++ b/scripts/benchmark_rank_memo.py
@@ -111,13 +111,13 @@ def replay(n: int, rounds: int, store: str | None = None) -> dict:
         with tempfile.TemporaryDirectory() as tmp:  # TMPDIR: never beside the live store
             if store:  # a real store: replay on a consistent private copy (sqlite backup API)
                 import sqlite3
-                src = sqlite3.connect(f"file:{store}?mode=ro", uri=True)
-                dst = sqlite3.connect(Path(tmp) / "state.db")
+                src = sqlite3.connect(f"file:{store}?mode=ro", uri=True)  # health: allow HX015 -- read-only source of a scratch copy for the benchmark
+                dst = sqlite3.connect(Path(tmp) / "state.db")  # health: allow HX015 -- private scratch copy, not a live store
                 src.backup(dst)
                 src.close()
                 dst.close()
             db = SessionDB(db_path=Path(tmp) / "state.db")
-            real_enabled = memo.enabled
+            real_enabled = memo.ENABLED
             try:
                 if store:
                     with db._read_ctx() as conn:
@@ -129,7 +129,7 @@ def replay(n: int, rounds: int, store: str | None = None) -> dict:
                 recency.clear()
                 memo.OUTCOMES.clear()
                 if mode == "exact":
-                    memo.enabled = lambda: False  # type: ignore[assignment]  # today's exact ranking
+                    memo.ENABLED = False  # today's exact ranking
                 spent, clock, per_slice = 0.0, BASE + n * 40, {}
                 for _ in range(rounds):
                     for _ in range(r.randrange(0, 6)):  # writes between two Desktop refreshes
@@ -159,7 +159,7 @@ def replay(n: int, rounds: int, store: str | None = None) -> dict:
                                  per_slice_ms={f"limit{SLICES[i]['limit']}": round(v / rounds, 2)
                                                for i, v in per_slice.items()})
             finally:
-                memo.enabled = real_enabled  # type: ignore[assignment]
+                memo.ENABLED = real_enabled
                 db.close()
                 recency.clear()
     out["ratio"] = round(out["memo"]["cpu_ms_per_refresh"] / out["exact"]["cpu_ms_per_refresh"], 3)
-- 
2.43.0

