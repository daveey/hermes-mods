-        subprocess.run([*prefix, "/bin/bash"], input=bash_input(case), text=True,
+        subprocess.run([*prefix, proof_bash()], input=TIMEOUT_PREAMBLE + bash_input(case), text=True,
                        capture_output=True, timeout=20, check=False, cwd=root,
