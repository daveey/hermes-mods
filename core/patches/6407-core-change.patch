+        monkeypatch.setattr(ca, '_installed', None)
+        return snapshot
+    monkeypatch.setattr(ca, 'diagnostic_snapshot', replace)
+    assert control.handle(params, 'peer') == pc._error('identity_changed')
+    assert not control._snapshots
