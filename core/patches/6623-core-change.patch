From b2f024fbd514fb2627091f8df7f57591924b927c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 26 Nov 2026 18:01:28 +0000
Subject: [PATCH 6623] Hot-path read-cost reductions (SQLite hand-offs, request coalescing, memoization)

Public mirror of source commit b2f024fbd514fb2627091f8df7f57591924b927c.

---
diff --git a/plugins/kanban/dashboard/plugin_api.py b/plugins/kanban/dashboard/plugin_api.py
index 279189fab3866930bd137e30256c2b4f48b3da1a..5576e0e16909e6c6da3ce27fd442f4a1f137fca2 100644
--- a/plugins/kanban/dashboard/plugin_api.py
+++ b/plugins/kanban/dashboard/plugin_api.py
@@ -411,7 +411,7 @@
     raise HTTPException(status_code=404, detail=f"task {task_id} not found")
 
 
-task_detail_flight.mount(router, get_task)
+task_detail_flight.mount(router, get_task, coalesced_read, lambda: kanban_db.get_current_board())
 
 
 def _task_detail(conn: sqlite3.Connection, task: kanban_db.Task, run_state_type: Optional[str],
diff --git a/plugins/kanban/dashboard/task_detail_flight.py b/plugins/kanban/dashboard/task_detail_flight.py
index 2cc4aafc85964dc15a7a341c542b9679399e50b3..3f889c10871816515f75b99d766100f8a82517dd 100644
--- a/plugins/kanban/dashboard/task_detail_flight.py
+++ b/plugins/kanban/dashboard/task_detail_flight.py
@@ -3,11 +3,7 @@
 
 from fastapi import Query
 
-from hermes_cli import kanban_db
-from hermes_cli.web_read_coalescing import coalesced_read
-
-
-def mount(router, get_task):
+def mount(router, get_task, coalesced_read, current_board):
     # Four tracked flights, not a new threadpool cap. Excess distinct resources
     # keep their original runner admission; identical tracked polls share work.
     read = coalesced_read(get_task, admission_key=lambda a: tuple(a.values()),
@@ -19,5 +15,5 @@
         run_state_type: Optional[str] = Query(None, description="With run_state_name: filter runs by column 'status' or 'outcome'"),
         run_state_name: Optional[str] = Query(None, description="With run_state_type: exact value for that run column")):
         # Select before keying: a board switch must never join the old board.
-        return await read(task_id=task_id, board=board or kanban_db.get_current_board(),
+        return await read(task_id=task_id, board=board or current_board(),
                           run_state_type=run_state_type, run_state_name=run_state_name)
