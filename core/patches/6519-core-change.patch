From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 19:10:39 +0000
Subject: [PATCH 6519] Forward retry identity

Public mirror of source commit 955f44ebb8b6cfda6e0221d792f5734642cd5c8e.

---
diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 1eba109f7fb..f0aa5ba6ab6 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -1308,6 +1308,13 @@
     transport_args = {**args, "idempotency_key": transport_key} if transport_key else args
     rid = request_id(self_gw, transport_args, origin_session or "", options)
     prior = remote_state(rid)
+    if foreign_origin and prior in FAILED_STATES:
+        # A forwarded envelope carries the creating run's uid, and a terminally failed request is immutable, so a
+        # later run's retry of the same product key would only collide (request_id_conflict). Give that run its own
+        # transport identity. The product idempotency_key still travels in ``options``, so the receiver dedupes.
+        rid = request_id(self_gw, {**transport_args, "idempotency_key": f"{transport_args.get('idempotency_key') or rid}:run:{run_uid}"},
+                         origin_session or "", options)
+        prior = remote_state(rid)
     if prior in ("queued", "sent", "done") and not options.get("idempotency_key") and not foreign_origin:
         # Content-addressed retries need no send. Explicit keys must let the courier compare
         # the complete envelope: the same key can also name changed or formerly dropped metadata.
diff --git a/tests/hermes_cli/test_kanban_placement_identity.py b/tests/hermes_cli/test_kanban_placement_identity.py
index 091f2df9c06..b2a297a2fbd 100644
--- a/tests/hermes_cli/test_kanban_placement_identity.py
+++ b/tests/hermes_cli/test_kanban_placement_identity.py
@@ -165,3 +165,33 @@
         assert forwarder.run() == "parked"
         assert kb.get_task(conn, child).status == "scheduled"
     assert len(mac["calls"]) == 1
+
+
+def test_later_run_retry_after_terminal_forward_rejection_gets_own_transport_identity(monkeypatch):
+    """The forwarded envelope carries the creating run's uid: a rejected request is immutable, so the next run's
+    retry of the same product key must not reuse its ID (request_id_conflict), yet keeps the product key."""
+    stored, states = {}, {}
+
+    def courier(argv):
+        rid = argv[argv.index("--id") + 1]
+        envelope = (argv[argv.index("--creator-run") + 1], [a for a in argv if a.startswith("idempotency_key=")])
+        if rid in stored and stored[rid] != envelope:
+            return 2, "", "request_id_conflict: request id already used for a different envelope"
+        stored[rid] = envelope
+        return 0, rid, ""
+
+    monkeypatch.setattr(kp, "hub_carries_options", lambda cli: True)
+    monkeypatch.setattr(kp, "hub_runner", courier)
+    monkeypatch.setattr(kp, "remote_state", lambda rid: states.get(rid))
+    creator = {"gateway": "w", "profile": "default", "board": "default", "task_id": "t_0123456789abcdef"}
+    call = lambda run: kp.create_remote(
+        {"title": "B3a", "idempotency_key": "product-key"}, target="hub", self_gw="w", origin_session="s1",
+        origin_profile="default", cfg={}, origin_gateway="hub", creator=creator, run_uid=run)
+    first = call("run-1")
+    assert first["ok"]
+    assert not call("run-2")["ok"]  # not terminal yet: unchanged immutable-envelope refusal
+    states[first["request_id"]] = "rejected"
+    second = call("run-2")
+    assert second["ok"] and second["request_id"] != first["request_id"]
+    assert call("run-2")["request_id"] == second["request_id"]  # exact retries in that run stay stable
+    assert ["idempotency_key=" + json.dumps("product-key")] == stored[second["request_id"]][1]
