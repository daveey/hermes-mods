From 0362a20c0e39651291280105e81f7c42f4f435f7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 12:55:30 -0800
Subject: [PATCH] fix(state): describe every futility-window reset; test the
 reset branches

Review follow-up: the docstring now names all three resets (no holder at
the last deferral, a negative gap, a gap over twice the backoff cap), and
the clock-back and empty-holder resets each get a test.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_state_schema.py                        |  3 ++-
 .../test_fts_futile_holder_churn.py           | 24 +++++++++++++++++++
 .../hermes_state/test_fts_runtime_rebuild.py  |  4 ++--
 3 files changed, 28 insertions(+), 3 deletions(-)

diff --git a/hermes_state_schema.py b/hermes_state_schema.py
index 9c9520dfe52e768d1abd1b3c8e3c937a880eb28d..f49f4afcf6bbe544671dfe140a22b5dae8f6caef 100644
--- a/hermes_state_schema.py
+++ b/hermes_state_schema.py
@@ -517,7 +517,8 @@ class SessionSchemaMixin:
         (whichever PIDs they were) the record is marked ``futile`` and the escalation names the
         holders and the remedy that works from inside a gateway session (stop only the other
         holder; this process's own retry tick admits the rebuild). The window restarts only
-        when no deferral was recorded for longer than the retry backoff cap (a new episode)."""
+        when the last deferral saw no holder, or when the gap since it is negative or longer
+        than twice the retry backoff cap (a new episode)."""
         now = time.time()
         try:
             row = cursor.execute(
diff --git a/tests/hermes_state/test_fts_futile_holder_churn.py b/tests/hermes_state/test_fts_futile_holder_churn.py
index 9be21cf85a02289f3d3067bca033ed5e46d26bc2..d96c9d3ae35916e05574fe5fd86770c75b3f4808 100644
--- a/tests/hermes_state/test_fts_futile_holder_churn.py
+++ b/tests/hermes_state/test_fts_futile_holder_churn.py
@@ -127,3 +127,27 @@ def test_a_quiet_gap_longer_than_the_retry_cap_starts_a_new_window(stale_store):
     # No deferral recorded for longer than any retry backoff: an old episode, not continuous presence.
     record = _defer(db, clock, hermes_state_schema._FTS_STALE_RETRY_MAX_SECONDS * 2 + 1)
     assert record["holders_attempts"] == 1 and not record.get("futile")
+
+
+@pytest.mark.parametrize(
+    "break_continuity", ["clock_went_back", "last_deferral_saw_no_holder"]
+)
+def test_a_broken_presence_record_starts_a_new_window(stale_store, break_continuity):
+    db, _db_path, clock = stale_store
+    attempts = hermes_state_schema._FTS_HOLDER_FUTILE_ATTEMPTS
+    step = hermes_state_schema._FTS_HOLDER_FUTILE_SECONDS / (attempts - 1)
+    for _ in range(attempts - 2):
+        record = _defer(db, clock, step)
+    assert record["holders_attempts"] == attempts - 1, record
+    if break_continuity == "clock_went_back":
+        clock[0] -= 2 * step
+        record = _defer(db, clock, 0.0)
+    else:
+        # What the orphan reap writes when it cleared every holder.
+        db._conn.execute(
+            "UPDATE state_meta SET value = json_set(value, '$.holder_pids', json('[]')) WHERE key = ?",
+            (FTS_REBUILD_DEFERRAL_KEY,),
+        )
+        db._conn.commit()
+        record = _defer(db, clock, step)
+    assert record["holders_attempts"] == 1 and not record.get("futile"), record
diff --git a/tests/hermes_state/test_fts_runtime_rebuild.py b/tests/hermes_state/test_fts_runtime_rebuild.py
index 1a95c9105b5465b4b5e11185ed28303e83d594a4..0e13ef90f320e996ab66a9519de27b1f3c4da82b 100644
--- a/tests/hermes_state/test_fts_runtime_rebuild.py
+++ b/tests/hermes_state/test_fts_runtime_rebuild.py
@@ -736,8 +736,8 @@ class TestRuntimeFtsRebuild:
         self, db, tmp_path, monkeypatch, caplog
     ):
         """#106393: a supervised peer never satisfies the orphan reap, so the generic
-        'remains blocked ... with the gateway stopped' escalation repeats forever. Once the SAME
-        PID set has blocked the futile window, the record is marked futile, the escalation names
+        'remains blocked ... with the gateway stopped' escalation repeats forever. Once foreign
+        holders have blocked every deferral of the futile window, the record is marked futile, the escalation names
         the holder's cmdline and a remedy runnable from inside the gateway, and doctor says so."""
         if not db._fts_enabled:
             pytest.skip("FTS5 unavailable in this build")
