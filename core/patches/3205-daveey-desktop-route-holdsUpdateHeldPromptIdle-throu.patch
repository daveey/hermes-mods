From 35eeddeba52299be470f85768448ac43a9e1f240 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 06:52:50 +0000
Subject: [PATCH] [daveey] desktop: route holdsUpdateHeldPromptIdle through
 holdsTurnClaim

Follow-up to the non-blocking nit in PR #1925's review: tool-parts.ts
holdsUpdateHeldPromptIdle still spelled out `!busy && !awaitingResponse &&
!turnLive` inline next to the "single copy" holdsTurnClaim predicate.

holdsTurnClaim now accepts a field pick (TurnClaimFields =
Pick<ClientSessionState, 'awaitingResponse' | 'busy' | 'turnLive'>) via an
overload: a ClientSessionState | undefined argument keeps the existing type
guard (callers in session-states, native-notifications and the tile
delegate still narrow), while a bare pick gets a plain boolean, because a
generic `state is T` guard narrows the negated branch to `never` and broke
holdsUpdateHeldPromptIdle's later `state.streamId`/`state.messages` reads.

No behaviour change: same three fields, same truthiness.

Proof: tsc -p apps/desktop --noEmit clean; eslint + prettier clean on both
files; vitest rewind, lib/chat-messages, store/session-states*,
use-session-tile-delegate*, native-notifications, session-watchdog:
32 files / 523 tests pass.
---
 .../desktop/src/lib/chat-messages/tool-parts.ts |  4 ++--
 .../src/store/session-states-live-turn.ts       | 17 ++++++++++++++---
 2 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/apps/desktop/src/lib/chat-messages/tool-parts.ts b/apps/desktop/src/lib/chat-messages/tool-parts.ts
index 42bc47f5a0..c27744b1cc 100644
--- a/apps/desktop/src/lib/chat-messages/tool-parts.ts
+++ b/apps/desktop/src/lib/chat-messages/tool-parts.ts
@@ -6,6 +6,7 @@ import { isTodoToolName, parseTodos } from '@/lib/todos'
 import { effectiveToolCall } from '@/lib/tool-media-renderers'
 import { isCardToolName } from '@/lib/tool-render-class'
 import type { ToolResultMetadata } from '@/lib/tool-result-metadata'
+import { holdsTurnClaim } from '@/store/session-states-live-turn'
 import type { SessionMessage, StoredToolCallLabels } from '@/types/hermes'
 
 import type { ChatMessage, ChatMessagePart, GatewayEventPayload } from './types'
@@ -594,8 +595,7 @@ export function holdsUpdateHeldPromptIdle(
   state: { awaitingResponse: boolean; busy: boolean; messages: ChatMessage[]; streamId: null | string; turnLive: boolean },
   queuedHeld = false
 ): boolean {
-  return !state.busy && !state.awaitingResponse && !state.turnLive && !state.streamId &&
-    (queuedHeld || state.messages.some(awaitsUpdate))
+  return !holdsTurnClaim(state) && !state.streamId && (queuedHeld || state.messages.some(awaitsUpdate))
 }
 
 /**
diff --git a/apps/desktop/src/store/session-states-live-turn.ts b/apps/desktop/src/store/session-states-live-turn.ts
index 86cfb31007..2c426d43a5 100644
--- a/apps/desktop/src/store/session-states-live-turn.ts
+++ b/apps/desktop/src/store/session-states-live-turn.ts
@@ -38,12 +38,23 @@ export function liveTurnLastActiveMs(
   return lastActive != null && Number.isFinite(ms) && ms > 0 ? ms : null
 }
 
+/** [daveey] The fields a turn claim is read from. */
+export type TurnClaimFields = Pick<ClientSessionState, 'awaitingResponse' | 'busy' | 'turnLive'>
+
 /** [daveey] Whether `state` holds a turn claim: busy, awaiting a reply, or a
- *  live turn. The single copy of this predicate — reconnect reconcile and the
- *  tile delegate's retireBusyClaim must agree on it (PR #1913). */
-export function holdsTurnClaim(state: ClientSessionState | undefined): state is ClientSessionState {
+ *  live turn. The single copy of this predicate — reconnect reconcile, the
+ *  tile delegate's retireBusyClaim and the update-held idle check
+ *  (`holdsUpdateHeldPromptIdle`) must agree on it (PR #1913). A full
+ *  `ClientSessionState` (or undefined) gets a type guard; a bare field pick
+ *  gets a plain boolean, since its negation must not narrow it to `never`. */
+/* eslint-disable no-redeclare -- overload signatures; the rule predates TS */
+export function holdsTurnClaim(state: ClientSessionState | undefined): state is ClientSessionState
+export function holdsTurnClaim(state: TurnClaimFields | undefined): boolean
+
+export function holdsTurnClaim(state: TurnClaimFields | undefined): boolean {
   return Boolean(state && (state.busy || state.awaitingResponse || state.turnLive))
 }
+/* eslint-enable no-redeclare */
 
 export function isLiveTurnAwaitingEvents(state: ClientSessionState | undefined): boolean {
   return holdsTurnClaim(state) && !state.needsInput
-- 
