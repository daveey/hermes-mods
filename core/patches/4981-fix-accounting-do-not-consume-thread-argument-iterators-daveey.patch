From 8c373b4294258f61e26b0d5065c29a88cc39ea26 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 09:31:24 +0000
Subject: [PATCH] fix(accounting): do not consume thread argument iterators
 [daveey]

Only inspect tuple/list arguments; unknown iterables keep conservative target naming without consuming invocation inputs. Covers plain, partial, Context.run and partial Context.run targets.

Proof: iterator regression RED 4 failures before fix, focused GREEN 60 passed, 20 consumer suites 412 passed/13 skipped, full scripts/check passes. Existing list and tuple naming regressions retained.
---
 hermes_cli/loop_accounting.py                 |  4 ++-
 .../test_loop_accounting_thread_targets.py    | 29 +++++++++++++++++++
 2 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/loop_accounting.py b/hermes_cli/loop_accounting.py
index d7acf3e57136c8832d91f08dfcd3572e3b229aeb..2cc353feb2b063107bdd995ffbce6dbf337c377c 100644
--- a/hermes_cli/loop_accounting.py
+++ b/hermes_cli/loop_accounting.py
@@ -1050,7 +1050,9 @@ TARGET_OTHER = "other"
 
 def _target_key(target: Any, args: tuple | list = ()) -> str:
     """Name of a ``Thread`` target (``module.qualname``; a lambda also gets its line number)."""
-    target = _callable_target(target, tuple(args))
+    # Inspection must not consume one-shot iterables before Thread.run uses them.
+    inspect_args = tuple(args) if isinstance(args, (tuple, list)) else ()
+    target = _callable_target(target, inspect_args)
     name = _callable_name(target)
     code = getattr(getattr(target, "__func__", target), "__code__", None)
     if name.endswith("<lambda>") and code is not None:
diff --git a/tests/hermes_cli/test_loop_accounting_thread_targets.py b/tests/hermes_cli/test_loop_accounting_thread_targets.py
index 7283892b2155fa5caec60403b9efb58611757f89..a9aa72eaa66816facf3ec35c334207c03af3c8c9 100644
--- a/tests/hermes_cli/test_loop_accounting_thread_targets.py
+++ b/tests/hermes_cli/test_loop_accounting_thread_targets.py
@@ -263,6 +263,35 @@ def test_thread_carriers_preserve_sequence_args_attribution(carrier, args_type):
     assert la._target_exited[la._target_key(original)]["threads"] == 1
 
 
+@pytest.mark.parametrize("carrier", ["plain", "partial", "context", "context_partial"])
+def test_thread_attribution_does_not_consume_iterator_args(carrier):
+    from contextvars import Context
+    from functools import partial
+
+    la.instrument_thread_targets()
+    seen = []
+
+    def original(*values):
+        seen.append(values)
+
+    target = original
+    values = [2]
+    expected = (2,)
+    if carrier in ("partial", "context_partial"):
+        target = partial(original, 1)
+        expected = (1, 2)
+    if carrier == "context":
+        target, values = Context().run, [target, 2]
+    elif carrier == "context_partial":
+        target = partial(Context().run, target)
+    args = iter(values)
+    th = threading.Thread(target=target, args=args)
+    th.start()
+    th.join()
+    assert seen == [expected]
+    assert list(args) == []  # Only the actual invocation consumes the iterator.
+
+
 def test_context_thread_names_original_target():
     from contextvars import Context
 
