diff --git a/hermes_cli/kanban_pr_acceptance.py b/hermes_cli/kanban_pr_acceptance.py
index cea7808807..7e55103f2e 100644
--- a/hermes_cli/kanban_pr_acceptance.py
+++ b/hermes_cli/kanban_pr_acceptance.py
@@ -18,6 +18,12 @@ from urllib.parse import quote
 
 _REPO = re.compile(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+")
 _PR = re.compile(r"https://github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/pull/([1-9][0-9]*)")
+# The way out of a contract that can never pass. A worker can't take it (orchestrator-only),
+# so the worker blocks WITHOUT a human_request: the owning chat clears agent-owned parks,
+# and David never gets a "approve closing this card" ask. [daveey]
+_REPOINT_HINT = ("this contract can never pass: the orchestrator (not this card's worker, and not a human ask) "
+                 "re-points it with `hermes kanban edit <task> --completion-contract <local-only|OWNER/REPO|PR URL> "
+                 "--reason \"...\"`; a worker blocks without a human_request and names the evidence.")
 
 
 def validate_contract(value: str | None) -> str:
@@ -54,6 +60,11 @@ def _api(endpoint: str, *, query: str | None = None, paginate: bool = False,
             raise _GateAuthError(f"HTTP {denied[1]} on {endpoint.split('?')[0]}") from None
         if exc.returncode == 4:  # gh's authentication-required exit: this profile has no login
             raise _GateAuthError(f"gh has no login for {endpoint.split('?')[0]}") from None
+        # GraphQL NOT_FOUND makes gh exit 1 before the ``repository is None`` check below
+        # can classify it: a repo this login can't see, or one that was renamed, moved or
+        # suspended. Retrying never helps, so it is never ``infra``. [daveey]
+        if "Could not resolve to a Repository" in (exc.stderr or ""):
+            raise _GateAuthError(f"repository not found on {endpoint.split('?')[0]}") from None
         raise
     value = json.loads(result.stdout)
     if isinstance(value, dict) and value.get("errors"):
@@ -199,7 +210,8 @@ def collect_acceptance(contract: str, published_pr: str | None,
                                     for r in rule["parameters"]["required_status_checks"])
         receipt["required"] = [{"context": c, "app_id": a} for c, a in sorted(required, key=str)]
         if not required:
-            receipt["detail"] = "No repository-required checks are configured; explicitly use a local-only contract for non-CI tasks."
+            receipt["detail"] = ("No repository-required checks are configured on the PR's base branch, so "
+                                 f"{_REPOINT_HINT} (Create non-CI tasks with a local-only contract.)")
             return receipt
         phase = "reading check runs"
         pages = _api(f"repos/{repo}/commits/{sha}/check-runs?per_page=100&filter=latest",
@@ -245,7 +257,8 @@ def collect_acceptance(contract: str, published_pr: str | None,
         login = f"assignee profile {assignee!r}'s gh login" if assignee else "the ambient gh login"
         receipt.update(classification="auth",
                        detail=f"GitHub refused the acceptance read ({exc}) as {login}; "
-                              "fix that profile's GitHub credentials/access to the repository, then retry completion.")
+                              "fix that profile's GitHub credentials/access to the repository, then retry completion. "
+                              f"If the repository was renamed, moved or suspended instead, {_REPOINT_HINT}")
         return receipt
     except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError, IndexError) as exc:
         # Never persist gh stderr (credentials/host details); the failed phase is actionable.
diff --git a/tests/hermes_cli/test_kanban_edit_operator_fields.py b/tests/hermes_cli/test_kanban_edit_operator_fields.py
index b4b206e4ec..e2a81dc370 100644
--- a/tests/hermes_cli/test_kanban_edit_operator_fields.py
+++ b/tests/hermes_cli/test_kanban_edit_operator_fields.py
@@ -231,3 +231,125 @@ def test_reopen_requires_reason(kanban_home, capsys):
         _main(["reopen", tid])
     assert _main(["reopen", tid, "--reason", "   "]) == 2
     assert _show(tid)["task"]["status"] == "done"
+
+
+# --- completion contract -------------------------------------------------------
+# A finished card whose bound PR can never be read (its repo was suspended) used to
+# park on a human "approve closing this card" ask: nothing could re-point the gate.
+
+
+_GONE_PR = "https://github.com/gone-owner/repo/pull/336"
+
+
+def _contract_events(task_id: str) -> list[dict]:
+    with kbc.connect_closing() as conn:
+        return [e.payload for e in kb.list_events(conn, task_id) if e.kind == "contract_changed"]
+
+
+def _contract(task_id: str) -> str:
+    with kbc.connect_closing() as conn:
+        return conn.execute("SELECT completion_contract FROM tasks WHERE id = ?", (task_id,)).fetchone()[0]
+
+
+def _gate_reads_a_vanished_repo(monkeypatch) -> list:
+    """The real gate with only its GitHub read replaced: the bound repo no longer resolves."""
+    from hermes_cli import kanban_pr_acceptance as kpa
+
+    calls: list = []
+
+    def gone(contract, published_pr, assignee=None):
+        calls.append(contract)
+        return {"ok": False, "classification": "auth", "head_sha": None, "pr_url": contract,
+                "checks": [], "recovery": "x", "detail": "repository not found on graphql"}
+
+    monkeypatch.setattr(kpa, "collect_acceptance", gone)
+    return calls
+
+
+def test_contract_repoint_lets_a_card_bound_to_a_vanished_repo_complete(kanban_home, monkeypatch):
+    calls = _gate_reads_a_vanished_repo(monkeypatch)
+    tid = _new(completion_contract=_GONE_PR)
+    with kbc.connect_closing() as conn:
+        assert not kb.complete_task(conn, tid, summary="AC-8 passed live", force=True)
+    assert calls == [_GONE_PR]
+    rc = _main(["edit", tid, "--completion-contract", "local-only",
+                "--reason", "repo suspended; the merge commit is on the new home"])
+    assert rc == 0
+    assert _contract(tid) == "local-only"
+    with kbc.connect_closing() as conn:
+        assert kb.complete_task(conn, tid, summary="AC-8 passed live", force=True)
+    assert calls == [_GONE_PR]  # local-only: the gate is not consulted again
+    assert _show(tid)["task"]["status"] == "done"
+
+
+def test_contract_repoint_records_event_and_comment(kanban_home, monkeypatch, capsys):
+    monkeypatch.setenv("HERMES_PROFILE", "operator-x")
+    tid = _new(completion_contract=_GONE_PR)
+    assert _main(["edit", tid, "--completion-contract", "new-owner/repo", "--reason", "repo moved"]) == 0
+    assert f"completion_contract: '{_GONE_PR}' -> 'new-owner/repo'" in capsys.readouterr().out
+    assert _contract(tid) == "new-owner/repo"
+    events = _contract_events(tid)
+    assert len(events) == 1
+    assert events[0]["from"] == _GONE_PR and events[0]["to"] == "new-owner/repo"
+    assert events[0]["reason"] == "repo moved" and events[0]["actor"]
+    with kbc.connect_closing() as conn:
+        bodies = [c.body for c in kb.list_comments(conn, tid)]
+    assert f"CONTRACT CHANGED: {_GONE_PR} -> new-owner/repo: repo moved" in bodies
+
+
+def test_contract_repoint_works_on_a_blocked_card(kanban_home):
+    tid = _new(completion_contract=_GONE_PR)
+    with kbc.connect_closing() as conn:
+        assert kb.block_task(conn, tid, reason="gate can't read the PR")
+    assert _main(["edit", tid, "--completion-contract", "local-only", "--reason", "repo suspended"]) == 0
+    assert _contract(tid) == "local-only"
+    assert _show(tid)["task"]["status"] == "blocked"  # re-pointing never unblocks by itself
+
+
+def test_contract_repoint_same_value_appends_nothing(kanban_home, capsys):
+    tid = _new(completion_contract="owner/repo")
+    assert _main(["edit", tid, "--completion-contract", "owner/repo", "--reason", "noop"]) == 0
+    assert "unchanged" in capsys.readouterr().out
+    assert _contract_events(tid) == []
+
+
+@pytest.mark.parametrize("argv_tail, needle", [
+    (["--completion-contract", "local-only"], "requires --reason"),
+    (["--completion-contract", "local-only", "--reason", "   "], "requires --reason"),
+    (["--completion-contract", "not a contract", "--reason", "x"], "completion_contract must be"),
+    (["--completion-contract", "local-only", "--reason", "x", "--title", "renamed"], "can't be combined"),
+    (["--completion-contract", "local-only", "--reason", "x", "--max-retries", "3"], "can't be combined"),
+    (["--reason", "x", "--title", "renamed"], "--reason only applies"),
+])
+def test_contract_repoint_refusals_change_nothing(kanban_home, capsys, argv_tail, needle):
+    tid = _new(title="card", completion_contract=_GONE_PR)
+    assert _main(["edit", tid, *argv_tail]) == 2
+    assert needle in capsys.readouterr().err
+    assert _contract(tid) == _GONE_PR
+    assert _show(tid)["task"]["title"] == "card"
+    assert _contract_events(tid) == []
+
+
+def test_contract_repoint_is_refused_inside_a_kanban_worker(kanban_home, monkeypatch, capsys):
+    tid = _new(completion_contract=_GONE_PR)
+    monkeypatch.setenv("HERMES_KANBAN_TASK", tid)
+    assert _main(["edit", tid, "--completion-contract", "local-only", "--reason", "let me out"]) == 2
+    assert "orchestrator-only" in capsys.readouterr().err
+    assert _contract(tid) == _GONE_PR
+    assert _contract_events(tid) == []
+
+
+@pytest.mark.parametrize("status", ["done", "archived"])
+def test_contract_repoint_refuses_closed_cards(kanban_home, capsys, status):
+    tid = _done() if status == "done" else _new()
+    if status == "archived":
+        with kbc.connect_closing() as conn:
+            assert kb.archive_task(conn, tid)
+    assert _main(["edit", tid, "--completion-contract", "owner/repo", "--reason", "x"]) == 2
+    assert "history" in capsys.readouterr().err
+    assert _contract(tid) == "local-only"
+
+
+def test_contract_repoint_refuses_unknown_task(kanban_home, capsys):
+    assert _main(["edit", "t_nope", "--completion-contract", "local-only", "--reason", "x"]) == 1
+    assert "unknown id" in capsys.readouterr().err
diff --git a/tests/hermes_cli/test_kanban_pr_transport.py b/tests/hermes_cli/test_kanban_pr_transport.py
index f9abc9a154..55a9b53ad1 100644
--- a/tests/hermes_cli/test_kanban_pr_transport.py
+++ b/tests/hermes_cli/test_kanban_pr_transport.py
@@ -94,3 +94,38 @@ def test_wrapper_interpolation_uses_assignee_scope(tmp_path, monkeypatch):
         assert gate._gh_command_prefix(str(target)) == [sys.executable, "target-scope"]
     finally:
         reset_secret_scope(token)
+
+
+@pytest.mark.platforms("posix")
+def test_graphql_repo_not_found_is_auth_with_the_repoint_path(tmp_path, monkeypatch):
+    """gh exits 1 on a GraphQL NOT_FOUND (a suspended, moved or invisible repo), before the
+    ``repository is None`` check runs. A retry never passes, so it is ``auth`` and names the
+    orchestrator's re-point, never ``infra``/"retry completion". [daveey]"""
+    monkeypatch.setenv("PATH", "")
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    folder = tmp_path / "bin"
+    folder.mkdir()
+    gh = folder / "gh"
+    gh.write_text(
+        f"#!{sys.executable}\n"
+        "import sys\n"
+        "sys.stderr.write(\"gh: Could not resolve to a Repository with the name 'gone/repo'.\\n\")\n"
+        "sys.exit(1)\n"
+    )
+    gh.chmod(0o755)
+    receipt = gate.collect_acceptance("https://github.com/gone/repo/pull/336", None)
+    assert receipt["classification"] == "auth"
+    assert "repository not found on graphql" in receipt["detail"]
+    assert "--completion-contract" in receipt["detail"]
+    assert "Could not resolve" not in receipt["detail"]  # gh's stderr is never persisted
+
+
+def test_no_required_checks_names_the_repoint_path(monkeypatch):
+    pr = {"data": {"repository": {"pullRequest": {
+        "headRefOid": "a" * 40, "baseRefName": "feature/stack", "state": "OPEN",
+        "baseRef": {"branchProtectionRule": None}}}}}
+    monkeypatch.setattr(gate, "_api", lambda endpoint, **kw: pr if endpoint == "graphql" else [[]])
+    receipt = gate.collect_acceptance("https://github.com/acme/repo/pull/7", None)
+    assert receipt["ok"] is False and receipt["classification"] == "missing"
+    assert "No repository-required checks" in receipt["detail"]
+    assert "--completion-contract" in receipt["detail"]
-- 
