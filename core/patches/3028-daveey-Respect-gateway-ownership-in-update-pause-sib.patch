Subject: [PATCH] [daveey] Respect gateway ownership in update-pause sibling
 notifications

Proof: foreign pickup cases fail before fix; 32 ownership and deferral tests pass after; scripts/check passes 18 checks.
---
 hermes_cli/update_pause_siblings.py           | 10 ++-
 .../test_update_pause_sibling_ownership.py    | 85 +++++++++++++++++++
 2 files changed, 93 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/test_update_pause_sibling_ownership.py

diff --git a/hermes_cli/update_pause_siblings.py b/hermes_cli/update_pause_siblings.py
index dc4d7e84c1..99ea694d14 100644
--- a/hermes_cli/update_pause_siblings.py
+++ b/hermes_cli/update_pause_siblings.py
@@ -99,13 +99,19 @@ def _open_alarms(db: sqlite3.Connection, unit: str) -> list[dict]:
         host = created_on or (m.group(1) if (m := _HOST.search(body)) else None)
         refusal = m.group(1).strip() if (m := _REFUSAL.search(body)) else ""
         sibling = m.group(1) if (m := _SIBLING.search(body)) else None
-        out.append({"id": task_id, "host": host, "created_at": created_at, "refusal": refusal, "sibling": sibling})
+        out.append({"id": task_id, "host": host, "created_on": created_on,
