From ae1130a14bf6fa31ebfd1426c5dd965c2b4fb116 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 08:16:04 +0000
Subject: [PATCH] test(web): coalesced session reads must send distinct
 Response objects; fix per_request_response rationale [daveey]

Review of #1286: Starlette 1.9 copies the header list, so the CORS reason did not hold and the
coalesced test passed with per_request_response removed. The real reason is FastAPI setting
.background on a returned Response; the test now asserts each request sends its own object.
---
 hermes_cli/web_json_response.py            |  6 +++---
 tests/hermes_cli/test_web_json_response.py | 17 +++++++++++++----
 2 files changed, 16 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/web_json_response.py b/hermes_cli/web_json_response.py
index 7886e489e4..3744f3d889 100644
--- a/hermes_cli/web_json_response.py
+++ b/hermes_cli/web_json_response.py
@@ -34,9 +34,9 @@ def per_request_response(result):
     """A fresh ``Response`` for this request from a possibly shared encoded result.
 
     A coalesced read or cache hands one result to several waiting requests.
-    Starlette sends ``response.raw_headers`` itself as the start message's header
-    list and middleware (CORS) appends to that list in place, and FastAPI sets
-    ``response.background``, so one ``JSONResponse`` object must not be sent twice.
+    FastAPI sets ``response.background`` on a returned Response, so one shared
+    ``JSONResponse`` object would carry one request's background tasks into
+    another; each request gets its own object instead.
     The shared part is the rendered body; the per-request ``Response`` built here
     is a constant-time wrapper with the same status, content-type and
     content-length headers. Anything else (a raw payload that took the fallback,
diff --git a/tests/hermes_cli/test_web_json_response.py b/tests/hermes_cli/test_web_json_response.py
index bcef10e38e..9240673627 100644
--- a/tests/hermes_cli/test_web_json_response.py
+++ b/tests/hermes_cli/test_web_json_response.py
@@ -302,16 +302,24 @@ async def test_profiles_sessions_body_matches_parent_path(routed):
 
 
 @pytest.mark.asyncio
-async def test_coalesced_requests_each_get_full_body_and_own_headers(routed):
+async def test_coalesced_requests_each_get_full_body_and_own_headers(routed, monkeypatch):
     """Two requests joined on one read share the rendered body, not one Response object.
 
-    CORS middleware appends to the start message's header list, which Starlette takes
-    straight from ``response.raw_headers``: a shared Response would send the second
-    caller a doubled ``vary``.
+    FastAPI sets ``response.background`` on a returned Response, so one shared
+    object would carry the first request's background tasks into the joined one.
     """
     import httpx
+    from starlette.responses import Response
     from tests.waiting import async_wait_until
 
+    sent = []
+    real_call = Response.__call__
+
+    async def recording_call(self, scope, receive, send):
+        sent.append(self)
+        return await real_call(self, scope, receive, send)
+
+    monkeypatch.setattr(Response, "__call__", recording_call)
     routed["block"] = True
     routed["release"].clear()
     headers = {"Origin": "http://desktop.test"}
@@ -327,6 +335,7 @@ async def test_coalesced_requests_each_get_full_body_and_own_headers(routed):
         # A later, separate read after the joined pair still answers normally.
         third = await client.get("/api/profiles/sessions", params={"limit": 200}, headers=headers)
     assert routed["reads"] == 2, "the two concurrent requests did not join one read"
+    assert len(sent) == 3 and len({id(r) for r in sent}) == 3, "joined requests sent one shared Response object"
     bodies = {r.content for r in [*responses, third]}
     assert len(bodies) == 1
     assert len(responses[0].json()["sessions"]) >= 200
-- 
