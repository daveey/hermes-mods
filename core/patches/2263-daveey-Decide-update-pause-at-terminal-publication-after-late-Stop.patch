From 1c9ae799daca17d2df7fe1db73caf7591beb2ba0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 11:04:46 +0000
Subject: [PATCH] [daveey] Decide update pause at terminal publication after
 late Stop

---
 .../test_update_pause_user_stop.py            | 17 +++++++++++++-
 tui_gateway/prompt_turn.py                    | 22 ++++++++++---------
 2 files changed, 28 insertions(+), 11 deletions(-)

diff --git a/tests/tui_gateway/test_update_pause_user_stop.py b/tests/tui_gateway/test_update_pause_user_stop.py
index ea33c89b23f..599785e9a39 100644
--- a/tests/tui_gateway/test_update_pause_user_stop.py
+++ b/tests/tui_gateway/test_update_pause_user_stop.py
@@ -94,7 +94,22 @@ def _stop_right_after_the_hook(monkeypatch):
     return fired
 
 
-STOPS = {"during_hook": _stop_while_the_hook_runs, "after_hook": _stop_right_after_the_hook}
+def _stop_during_payload(monkeypatch):
+    """Stop after payload construction has begun, before terminal publication."""
+    real, fired = server._complete_turn_payload, []
+
+    def complete(*args, **kwargs):
+        payload = real(*args, **kwargs)
+        fired.append(1)
+        _user_stop()
+        return payload
+
+    monkeypatch.setattr(server, "_complete_turn_payload", complete)
+    return fired
+
+
+STOPS = {"during_hook": _stop_while_the_hook_runs, "after_hook": _stop_right_after_the_hook,
+         "during_payload": _stop_during_payload}
 
 
 def _turn(env, monkeypatch, path):
diff --git a/tui_gateway/prompt_turn.py b/tui_gateway/prompt_turn.py
index aa2c4a30372..74fada67f24 100644
--- a/tui_gateway/prompt_turn.py
+++ b/tui_gateway/prompt_turn.py
@@ -1432,28 +1432,30 @@ def _run_admitted_prompt(
             status_note = _absorb_turn_result(
                 sid, session, st, text, display_kind, display_metadata)
             from tui_gateway import update_pause  # [daveey] before the marker is retired: a user Stop beats the pause
-            paused_for_update = update_pause.pause_stands(session, st.marker_key, st.result)
             payload, raw, status = _complete_turn_payload(session, st, status_note, cols)
             if status == "error":  # [daveey] module calls: harnesses rebind this body with minimal globals
                 automation_replay.plan_for_turn(st, st.result)
-            if paused_for_update:
-                update_pause.announce_pause(sid, payload)
-            # [daveey] A client Stop ended this turn: persist "Stopped by <login>" so the chat says why it
-            # went quiet (methods_session_interrupt._record_stop_notice; a no-op for any other ending).
-            _record_stop_notice(session, status)
+
             if status == "complete":
                 # Before message.complete: the desktop re-reads the sign-in offer on that event.
                 from tui_gateway.free_tier_task_done import note_task_done
                 note_task_done(session, st.result, st.agent, display_kind)
-            _emit("message.complete", sid, payload)
+            # Payload construction may yield to Stop. Decide and publish under the same lock
+            # that drops the pause, rather than carrying a pre-construction pause snapshot.
+            with session["history_lock"]:
+                paused_for_update = update_pause.pause_stands(session, st.marker_key, st.result)
+                if paused_for_update:
+                    update_pause.announce_pause(sid, payload)
+                _record_stop_notice(session, status)
+                _emit("message.complete", sid, payload)
+                if paused_for_update:
+                    update_pause.start_in_place_watcher(sid, session, st.marker_key)
             _schedule_refused_turn_retry(sid, session, st.marker_key)
             if status == "complete":
                 # [daveey] This turn's context carried any failed delivery already in the transcript.
                 automation_replay.cancel_carried(st.marker_key, str(session.get("session_key") or ""))
             automation_replay.schedule_for_turn(session, st)
-            if paused_for_update:
-                # The new backend continues it; if no update replaces this one, continue it here.
-                update_pause.start_in_place_watcher(sid, session, st.marker_key)
+
             goal_followup = _goal_followup_after_turn(sid, session, st.result, status, raw)
             if status == "complete":
                 _after_complete_turn(sid, session, st, raw)
-- 
