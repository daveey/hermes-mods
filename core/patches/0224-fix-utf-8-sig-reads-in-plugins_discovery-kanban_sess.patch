From e1f92d6ca504b4778e1e971157251b2f2c17cc25 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 05:51:15 +0000
Subject: [PATCH 222/248] fix: utf-8-sig reads in plugins_discovery +
 kanban_session_activity so the blocking footguns lint passes on main [daveey]

---
 hermes_cli/kanban_session_activity.py | 2 +-
 hermes_cli/plugins_discovery.py       | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index 5066a20bf0..300e23d196 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -168,7 +168,7 @@ def _self_gateway(conn: sqlite3.Connection) -> str:
         pass
     try:
         cfg = Path(os.environ.get("HERMES_MAIL_CONFIG") or Path.home() / ".config" / "hermes-mail" / "config.json")
-        return str(json.loads(cfg.read_text()).get("gateway") or "")
+        return str(json.loads(cfg.read_text(encoding="utf-8-sig")).get("gateway") or "")
     except (OSError, ValueError, AttributeError):
         return ""
 
diff --git a/hermes_cli/plugins_discovery.py b/hermes_cli/plugins_discovery.py
index a0f10bcbc2..6ce1cf4e28 100644
--- a/hermes_cli/plugins_discovery.py
+++ b/hermes_cli/plugins_discovery.py
@@ -253,7 +253,7 @@ def _peek_manifest_name(plugin_dir: Path) -> str:
     """Best-effort ``name:`` of a dir's plugin.yaml without full parsing (for conflict reports only)."""
     for fname in ("plugin.yaml", "plugin.yml"):
         try:
-            for line in (plugin_dir / fname).read_text(encoding="utf-8", errors="replace").splitlines():
+            for line in (plugin_dir / fname).read_text(encoding="utf-8-sig", errors="replace").splitlines():
                 m = re.match(r"\s*name\s*:\s*['\"]?([^'\"#\s]+)", line)
                 if m and not line.startswith((" ", "\t")):
                     return m.group(1)
