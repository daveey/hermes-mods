From c89737e6bfbfd2d1280889edcb4883c3cd3791bd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 23:04:32 +0000
Subject: [PATCH] [daveey] fix(doctor): mask degenerate long hex argv values

Apply the documented >12-character hex mask before numeric and letter
identifier exceptions. token_hex can produce entirely decimal digits or
entirely A-F; requiring both classes let these synthetic secrets through.
Keep abbreviated hex, ordinary short numbers and typed identifiers readable.

Occurrence 66 failed the zero-leak token_hex parameter on main 0b1fda72.
The historical token was not retained: deterministic synthetic counterexamples
prove a compatible classifier gap, not the incident's exact bytes.

Proof: 42 deterministic regressions fail on the old classifier while 8
readability controls pass. With the fix all 866 argv tests pass through
scripts/run_tests.sh with HERMES_TEST_FILE_RETRIES=0. Random coverage and
leak ceilings are unchanged. Full scripts/check --base origin/main passes.
---
 hermes_state_argv_secrets.py            |  7 +++---
 tests/hermes_state/test_argv_secrets.py | 33 +++++++++++++++++++++++++
 2 files changed, 37 insertions(+), 3 deletions(-)

diff --git a/hermes_state_argv_secrets.py b/hermes_state_argv_secrets.py
index c1f3295ee0..b9be883800 100644
--- a/hermes_state_argv_secrets.py
+++ b/hermes_state_argv_secrets.py
@@ -16,7 +16,7 @@ secrets, 3% of 24-character, 2% of 32-character and 1.5% of 40-character ones (r
 the tests hold these under 10%, 5%, 3% and 2% (32 characters in bare, path, URL and spaced-env positions, 24 in all
 but the query ones, 16 and 40 in all). About 0.15% of this repo's identifiers and 0.1% of its env names are
 masked. This is a rate, not a guarantee, and some secrets look exactly like identifiers and are shown: pronounceable
-passwords (``correcthorse``), all-digit values, UUIDs, strings under 12 characters and a secret shaped like a
+passwords (``correcthorse``), all-digit values up to 12 characters, UUIDs, strings under 12 characters and a secret shaped like a
 kebab-case ``--flag`` right after a secret-named flag (read as the next flag, as switches need), unless a name marks
 them secret. Short hex (up to 12 characters) is shown on purpose: it is how commits are abbreviated; longer hex (full
 commits, digests, container ids) is masked with the keys it looks like. Encoded query values are judged decoded,
@@ -241,14 +241,15 @@ def _alpha_ok(run: str) -> bool:
 
 def _segment_ok(segment: str) -> bool:
     """One separator-free piece of an identifier."""
+    # Hex can be entirely digits or entirely A-F; neither is exempt from the long-hex mask.
+    if re.fullmatch(r"[0-9a-fA-F]+", segment):
+        return len(segment) <= _SHORT_HEX
     if not segment or segment.isdigit():
         return True
     if not segment.isascii():
         return segment.isalnum()  # a word in another script (naïve, café, Cyrillic names)
     if not segment.isalnum():
         return False  # symbols: passwords, not identifiers
-    if re.fullmatch(r"[0-9a-fA-F]+", segment) and re.search(r"\d", segment) and re.search(r"[A-Fa-f]", segment):
-        return len(segment) <= _SHORT_HEX
     runs = re.findall(r"[A-Za-z]+|\d+", segment)
     if len(segment) >= 10 and len(runs) >= 6:
         return False  # letters and digits alternating: generated, not named
diff --git a/tests/hermes_state/test_argv_secrets.py b/tests/hermes_state/test_argv_secrets.py
index 593c4cf3c2..e65c032bf1 100644
--- a/tests/hermes_state/test_argv_secrets.py
+++ b/tests/hermes_state/test_argv_secrets.py
@@ -594,6 +594,39 @@ def test_long_hex_is_masked_like_the_keys_it_resembles(token):
     assert MASK in shown([token])[0]
 
 
+_HEX_POSITIONS = {
+    "bare": lambda s: s,
+    "path": lambda s: f"/srv/{s}/file.json",
+    "url": lambda s: f"https://example.com/{s}",
+    "query": lambda s: f"https://example.com/?value={s}",
+    "assignment": lambda s: f"VALUE={s}",
+    "flag": lambda s: f"--value={s}",
+}
+
+
+@pytest.mark.parametrize("secret", [
+    "22015686243846424052243111151650",  # synthetic seed-66 token_hex-shaped numeric sample
+    "feedface" * 4,
+    "FEEDFACE" * 4,
+    "a" * 32,
+    "0" * 32,
+    "1234567890123",  # first length beyond abbreviated commits
+    "abcdefabcdefa",
+])
+@pytest.mark.parametrize("position", sorted(_HEX_POSITIONS))
+def test_degenerate_long_hex_is_masked(secret, position):
+    assert shown([_HEX_POSITIONS[position](secret)]) == [_HEX_POSITIONS[position](MASK)]
+
+
+@pytest.mark.parametrize("value", [
+    "123456789012", "abcdefabcdef", "012345abcdef", "4096",
+    "naïve", "12345678-1234-1234-1234-123456789012",
+    "t_eeeeee00000000016789012345678901", "i-01234567890123456",
+])
+def test_hex_mask_retains_short_and_typed_identifiers(value):
+    assert shown([value]) == [value]
+
+
 def test_deep_nesting_is_masked_not_a_crash():
     out = shown(["a=" * 1000 + "x"])[0]
     assert out.startswith("a=") and out.endswith(MASK)
