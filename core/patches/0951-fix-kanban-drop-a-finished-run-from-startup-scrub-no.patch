From aaab5e3f4766a88d8532765ad9533f5f55128bdd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 02:59:39 -0700
Subject: [PATCH] fix(kanban): drop a finished run from startup scrub, not main
 [daveey]

main.py is over its line cap, so the drop runs as the first step of
scrub_for_top_level_launch, before the command gate. A board-read
failure is logged and does not abort startup.
---
 hermes_cli/kanban_identity.py                  |  3 ++-
 hermes_cli/main.py                             |  7 -------
 hermes_cli/top_level_env.py                    | 12 +++++++++++-
 tests/hermes_cli/test_stale_kanban_identity.py | 11 +++++++----
 4 files changed, 20 insertions(+), 13 deletions(-)

diff --git a/hermes_cli/kanban_identity.py b/hermes_cli/kanban_identity.py
index 4f4a2cbdf7..447d1fc59a 100644
--- a/hermes_cli/kanban_identity.py
+++ b/hermes_cli/kanban_identity.py
@@ -49,7 +49,8 @@ def _board_db(env: Mapping[str, str]) -> Optional[Path]:
     try:
         from hermes_cli.kanban_db import kanban_db_path
         return kanban_db_path()
-    except Exception:
+    except Exception:  # health: allow BLE001 -- unreadable board path must keep the pair, not abort startup
+        log.debug("kanban board path unavailable", exc_info=True)
         return None
 
 
diff --git a/hermes_cli/main.py b/hermes_cli/main.py
index 419071f420..c590421265 100644
--- a/hermes_cli/main.py
+++ b/hermes_cli/main.py
@@ -3538,13 +3538,6 @@ def _default_to_chat(args) -> None:
 
 def main():
     """Main entry point for hermes CLI."""
-    # A finished run's identity (a terminal app that outlived its worker) must not
-    # survive into plugin load. Before any fast path. [daveey]
-    try:
-        from hermes_cli.kanban_identity import drop_finished_kanban_identity
-        drop_finished_kanban_identity()
-    except Exception:
-        pass
     # A Desktop/serve/dashboard/gateway launched from inside a kanban worker must not inherit
     # the worker's identity env (it fences every chat's kanban tools). Before any fast path. [daveey]
     try:
diff --git a/hermes_cli/top_level_env.py b/hermes_cli/top_level_env.py
index 99a9a30ff3..b561462425 100644
--- a/hermes_cli/top_level_env.py
+++ b/hermes_cli/top_level_env.py
@@ -48,7 +48,17 @@ def _first_positional(argv: Sequence[str]) -> str:
 
 
 def scrub_for_top_level_launch(argv: Sequence[str]) -> list[str]:
-    """Scrub ``os.environ`` when ``argv`` (``sys.argv[1:]``) launches a top-level surface."""
+    """Scrub ``os.environ`` when ``argv`` (``sys.argv[1:]``) launches a top-level surface.
+
+    Also drops a finished run's identity on every launch, before the command gate,
+    so chat and kanban do not inherit a dead worker. [daveey]
+    """
+    try:
+        from hermes_cli.kanban_identity import drop_finished_kanban_identity
+        drop_finished_kanban_identity()
+    except Exception:  # health: allow BLE001 -- a board-read failure must not abort startup
+        import logging
+        logging.getLogger(__name__).debug("finished-run identity drop failed", exc_info=True)
     if _first_positional(argv) not in TOP_LEVEL_COMMANDS:
         return []
     # Name the dead lineage while the pins still exist (the scrub removes them). [daveey]
diff --git a/tests/hermes_cli/test_stale_kanban_identity.py b/tests/hermes_cli/test_stale_kanban_identity.py
index 23a6e21786..966e2f8bc9 100644
--- a/tests/hermes_cli/test_stale_kanban_identity.py
+++ b/tests/hermes_cli/test_stale_kanban_identity.py
@@ -150,8 +150,11 @@ def test_drop_line_is_on_stderr_even_when_a_handler_exists(monkeypatch, tmp_path
 
 def test_main_drops_identity_before_plugins_load():
     from hermes_cli.main import main
+    from hermes_cli.top_level_env import scrub_for_top_level_launch
     src = inspect.getsource(main)
-    drop_at = src.index("drop_finished_kanban_identity")
-    assert drop_at < src.index("_prepare_agent_startup")
-    assert drop_at < src.index("_try_fast_chat_launch")
-    assert drop_at < src.index("_try_fast_serve_launch")
+    scrub_at = src.index("scrub_for_top_level_launch")
+    assert scrub_at < src.index("_prepare_agent_startup")
+    assert scrub_at < src.index("_try_fast_chat_launch")
+    assert scrub_at < src.index("_try_fast_serve_launch")
+    scrub_src = inspect.getsource(scrub_for_top_level_launch)
+    assert scrub_src.index("drop_finished_kanban_identity") < scrub_src.index("TOP_LEVEL_COMMANDS")
-- 
2.55.0

