From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 23:31:54 +0000
Subject: [PATCH 6558] Sync loop efficiency and write ordering

Public mirror of source commit 69c596917e2c179a2cfcfc0f3e18c9930cf41e0b.

---
diff --git a/hermes_cli/kanban_db_sync.py b/hermes_cli/kanban_db_sync.py
index afedc03c35f..b6624d60693 100644
--- a/hermes_cli/kanban_db_sync.py
+++ b/hermes_cli/kanban_db_sync.py
@@ -1348,7 +1348,8 @@
     from hermes_cli import kanban_containment_replica as containment
     from hermes_cli.kanban_sync_apply_budget import check_budget, transaction_budget
     containment.prepare_apply(conn, changes)
-    with page_writer(conn, (*SYNCED_TABLES, "kanban_sync_outbox"), cache=bool(changes) and keep is None), transaction_budget(conn):
+    with page_writer(conn, (*SYNCED_TABLES, "kanban_sync_outbox", "kanban_sync_state"),
+                     cache=bool(changes) and keep is None), transaction_budget(conn):
         result.revision_before = _repair_revision(conn)
         # Serialize with set_mode(off): a feed fetched before detach must not
         # overwrite locally held custody after the detach transaction commits.
