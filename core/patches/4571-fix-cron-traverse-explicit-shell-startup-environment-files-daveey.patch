diff --git a/cron/lifecycle_guard_startup.py b/cron/lifecycle_guard_startup.py
new file mode 100644
index 0000000000000000000000000000000000000000..98ae960bb710d2264d1d846e0bdf2a09530d6969
--- /dev/null
+++ b/cron/lifecycle_guard_startup.py
@@ -0,0 +1,89 @@
+"""Explicit shell startup environment references for the bounded lifecycle walk."""
+from __future__ import annotations
+
+import shlex
+from collections.abc import Iterator
+
+
+def _startup_variable(shell: str, arguments: list[str]) -> str | None:
+    """Select the startup variable from shell options, never from script arguments."""
+    from cron.lifecycle_guard import _SHELL_LONG_OPTIONS_WITH_VALUES
+
+    interactive = False
+    posix = shell in {"sh", "dash", "ksh", "ash"}
+    index = 0
+    while index < len(arguments):
+        word = arguments[index]
+        index += 1
+        if word in {"--", "-"} or not word.startswith(("-", "+")):
+            break
+        if word in _SHELL_LONG_OPTIONS_WITH_VALUES:
+            index += 1
+        elif word == "--posix":
+            posix = True
+        elif word == "--interactive":
+            interactive = True
+        elif not word.startswith("--"):
+            if word.startswith("-") and "i" in word[1:]:
+                interactive = True
+            for flag in word[1:]:
+                if flag in "oO":
+                    value = arguments[index] if index < len(arguments) else ""
+                    index += 1
+                    if flag == "o" and value == "posix":
+                        posix = word.startswith("-")
+    if posix:
+        return "ENV" if interactive else None
+    return "BASH_ENV" if shell == "bash" and not interactive else None
+
+
+def iter_startup_sources(command: str) -> Iterator[str]:
+    """Source explicit assignment-prefix/env-wrapper files before child-shell payloads.
+
+    Reuse the ordinary source walk so local/remote read limits, cycles and refusals
+    stay identical. Prefix assignments are conservative across wrappers; inherited
+    process environment is deliberately not consulted for remote commands.
+    """
+    if "BASH_ENV=" not in command and "ENV=" not in command:
+        return
+    from cron.lifecycle_guard import (
+        _executable_name, _executed_command_index, _iter_command_segment_views,
+        _split_redirections,
+    )
+
+    for view in _iter_command_segment_views(command):
+        view = _split_redirections(view)[0]
+        index = _executed_command_index(view)
+        if index is None:
+            continue
+        shell = _executable_name(view[index])
+        if shell not in {"bash", "sh", "dash", "ksh", "ash"}:
+            continue
+        variable = _startup_variable(shell, view[index + 1:])
+        if variable is None:
+            continue
+        for word in view[:index]:
+            name, equals, value = word.partition("=")
+            if equals and name == variable and value:
+                yield value
+
+
+def scan_startup_sources(command, recurse, budget, cwd, executed, source) -> bool:
+    """Walk startup input before -c text; never evaluate dynamic names in the guard."""
+    for value in iter_startup_sources(command):
+        if "$" in value or "`" in value:
+            if executed:
+                budget.refusal = "Cannot statically resolve shell startup file expansion; use a literal path"
+                return True
+            continue
+        if recurse("source " + shlex.quote(value), cwd, executed, source,
+                   nested=True, preserve_source_cwd=True):
+            return True
+    return False
+
+
+def script_working_directory(resolved, cwd, preserve_cwd):
+    """Startup sources do not chdir; retain the legacy directory rule elsewhere."""
+    from cron.lifecycle_guard import _resolve_script_directory
+
+    return cwd if preserve_cwd else _resolve_script_directory(str(resolved)) or cwd
diff --git a/tests/cron/test_lifecycle_guard_startup_env.py b/tests/cron/test_lifecycle_guard_startup_env.py
new file mode 100644
index 0000000000000000000000000000000000000000..6331c77d715fb5169aebb660860ae2e24a2081fa
--- /dev/null
+++ b/tests/cron/test_lifecycle_guard_startup_env.py
@@ -0,0 +1,114 @@
+"""Startup files are executed input, not ordinary environment data."""
+import shlex
+import shutil
+import subprocess
+
+import pytest
+
+from cron.lifecycle_guard import scan_gateway_lifecycle
+
+
+SHAPES = [
+    "BASH_ENV=start.sh bash -c true",
+    "env BASH_ENV=./start.sh bash -c true",
+    "BASH_ENV='start.sh' command bash -c true",
+    "env -i PATH=/usr/bin:/bin BASH_ENV=start.sh bash -c true",
+    "env BASH_ENV=start.sh bash clean.sh",
+    "ENV=start.sh bash --posix -ic true",
+    "env ENV=./start.sh sh -ic true",
+]
+
+
+def run_bash(tmp_path, command):
+    bash = shutil.which("bash")
+    assert bash, "real Bash required for startup proof"
+    return subprocess.run(
+        [bash, "--noprofile", "--norc", "-c", command], cwd=tmp_path,
+        env={"PATH": "/usr/bin:/bin"}, capture_output=True, text=True,
+        timeout=10, check=False,
+    )
+
+
+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("command", SHAPES)
+def test_startup_script_marker_and_clean_twin(tmp_path, command):
+    startup = tmp_path / "start.sh"
+    marker = tmp_path / "ran"
+    (tmp_path / "clean.sh").write_text("true\n")
+    startup.write_text("touch ran\n")
+    result = run_bash(tmp_path, command)
+    assert result.returncode == 0, result.stderr
+    assert marker.exists(), result.stderr
+    marker.unlink()
+    startup.write_text("hermes gateway restart\n")
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (True, None)
+    startup.write_text("touch ran\n")
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (False, None)
+    assert not marker.exists(), "scanner must not execute startup files"
+
+
+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("prefix", ["BASH_ENV=start.sh", "env BASH_ENV=start.sh"])
+def test_startup_declaration_precedes_child_payload(tmp_path, prefix):
+    (tmp_path / "start.sh").write_text("declare -i x\n")
+    payload = tmp_path / "payload.sh"
+    payload.write_text("touch ran\nprintf 0\n")
+    payload.chmod(0o755)
+    command = prefix + " bash -c " + shlex.quote(r"x=a[\$\(./payload.sh\)]")
+    result = run_bash(tmp_path, command)
+    assert (tmp_path / "ran").exists(), result.stderr
+    payload.write_text("hermes gateway restart\n")
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (True, None)
+    payload.write_text("true\n")
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (False, None)
+
+
+@pytest.mark.parametrize("command", [
+    "BASH_ENV=start.sh true", "env BASH_ENV=start.sh printf ok",
+    "bash -c true BASH_ENV=start.sh", "ENV=start.sh bash -c true",
+    "ENV=start.sh sh -c true", "BASH_ENV=start.sh bash --posix -c true",
+])
+def test_environment_data_is_not_startup(tmp_path, command):
+    (tmp_path / "start.sh").write_text("hermes gateway restart\n")
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (False, None)
+
+
+@pytest.mark.platforms("posix")
+def test_startup_relative_commands_keep_invocation_cwd(tmp_path):
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub/start.sh").write_text("sh ./payload.sh\n")
+    payload = tmp_path / "payload.sh"
+    payload.write_text("touch ran\n")
+    command = "BASH_ENV=sub/start.sh bash -c true"
+    result = run_bash(tmp_path, command)
+    assert (tmp_path / "ran").exists(), result.stderr
+    payload.write_text("hermes gateway restart\n")
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (True, None)
+    payload.write_text("true\n")
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (False, None)
+
+
+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("value", ["$PWD/start.sh", "$(sh ./payload.sh)"])
+def test_dynamic_startup_paths_fail_closed_without_execution(tmp_path, value):
+    (tmp_path / "start.sh").write_text("touch ran\n")
+    (tmp_path / "payload.sh").write_text("touch ran\n")
+    command = "BASH_ENV=" + shlex.quote(value) + " bash -c true"
+    result = run_bash(tmp_path, command)
+    assert (tmp_path / "ran").exists(), result.stderr
+    (tmp_path / "ran").unlink()
+    unsafe, refusal = scan_gateway_lifecycle(command, cwd=str(tmp_path))
+    assert unsafe and refusal and "startup file expansion" in refusal
+    assert not (tmp_path / "ran").exists()
+
+
+def test_startup_remote_read_uses_same_walk(tmp_path):
+    seen = []
+
+    def remote(path):
+        seen.append(path)
+        return "hermes gateway restart\n"
+
+    assert scan_gateway_lifecycle("BASH_ENV=remote.sh bash -c true", cwd=str(tmp_path),
+                                  read_remote_script=remote) == (True, None)
+    assert seen == [str(tmp_path / "remote.sh")]
