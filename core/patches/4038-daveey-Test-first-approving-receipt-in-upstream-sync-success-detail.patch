From 4f17d83e5bf4519b22ed989169d526a634eacb01 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 01:55:04 +0000
Subject: [PATCH] [daveey] Test first approving receipt in upstream sync
 success detail

Assert an off-key Kanban approval remains the named audit receipt when a later GitHub candidate also approves. Production unchanged.

Proof: receipts[0] -> receipts[-1] yields 1 failed / 22 passed, with test_success_detail_names_first_offkey_receipt_before_github failing on the exact detail. Restored source: 57 passed across offkey and review suites, zero skips. scripts/check --base origin/main: 20 checks OK.
---
 .../ci/test_upstream_sync_offkey_review.py    | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/tests/scripts/ci/test_upstream_sync_offkey_review.py b/tests/scripts/ci/test_upstream_sync_offkey_review.py
index c4b6522aa2..06ce39092f 100644
--- a/tests/scripts/ci/test_upstream_sync_offkey_review.py
+++ b/tests/scripts/ci/test_upstream_sync_offkey_review.py
@@ -180,6 +180,32 @@ def test_every_offkey_approval_requires_reply_guard(land_stub, tmp_path, monkeyp
     assert state["filed"] == []
 
 
+def test_success_detail_names_first_offkey_receipt_before_github(land_stub, tmp_path, monkeypatch):
+    board(tmp_path / "land-state.db")
+    land_stub.update(approve={CARD: SHA})
+    checker = review.ShipReview(tmp_path)
+    mod = checker._module()
+    original_gate = mod.review_gate
+    receipts = []
+
+    def review_gate(*args, **kwargs):
+        if args[6]:
+            receipt = original_gate(*args, **kwargs)
+        else:
+            receipt = {"source": "github", "id": 12345, "reviewed_sha": SHA, "verdict": "approve"}
+        receipts.append(receipt)
+        return receipt
+
+    monkeypatch.setattr(mod, "review_gate", review_gate)
+    monkeypatch.setattr(checker, "_module", lambda: mod)
+    accepted, detail = checker.check("example/fork", 7, SHA, "sync/head")
+
+    assert [(r["source"], r["id"]) for r in receipts] == [("kanban", CARD), ("github", 12345)]
+    assert accepted is True
+    assert detail == f"independent exact-head review kanban {CARD} approves {SHA}"
+    assert land_stub.read()["filed"] == []
+
+
 def test_keyed_refusal_cannot_be_bypassed_by_offkey(land_stub, tmp_path):
     board(tmp_path / "land-state.db")
     land_stub.update(cards={f"example/fork#7:{SHA}": "t_keyed"}, approve={CARD: SHA})
