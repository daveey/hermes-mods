From 41b37878bf69460acac9085303ae24d6bfd2d28b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 07:23:46 +0000
Subject: [PATCH] [daveey] tests: FakeHub lease release guards outcomes, merges
 diagnostic/extra, refuses spawn_failed

Follow-up to PR #1943 review 5887470228 (three non-blocking nits), checked
against hermes-hub worker/src/transitions.ts releaseTask on main:

- Outcome guard: the leases release and FakeService.release_op refuse an
  outcome outside RELEASE_OUTCOMES as `invalid` before the fence and change
  nothing, so a typo'd test outcome fails instead of emitting that kind.
- Diagnostic merge: canonical failures (crashed, timed_out,
  terminal_provider) merge the holder's diagnostic into run metadata and the
  event payload ({diagnostic_truncated: true} past MAX_DIAGNOSTIC_CHARS); a
  crashed release with protocol_violation marks the run metadata; neutral
  releases merge the holder's extra.
- spawn_failed: releaseTask hands it to endCustody + recordTaskFailure,
  whose run/event shape is the failure accounting this path does not model,
  so the fake raises NotImplementedError instead of a wrong shape. The
  docstring now lists what is and is not modelled.

Test-only change.

Kanban: t_01a1d3c3cedaaafe

Tests: 55 files importing kanban_sync_fake_board / FakeService: 1007 passed,
0 failed, 10 skipped. RED on #1943's fake: 7 new cases fail.
---
 tests/hermes_cli/kanban_sync_fake_board.py    | 45 ++++++++++----
 .../hermes_cli/test_kanban_sync_rejections.py | 58 +++++++++++++++++++
 2 files changed, 93 insertions(+), 10 deletions(-)

diff --git a/tests/hermes_cli/kanban_sync_fake_board.py b/tests/hermes_cli/kanban_sync_fake_board.py
index 851ae56e70..4d08918d19 100644
--- a/tests/hermes_cli/kanban_sync_fake_board.py
+++ b/tests/hermes_cli/kanban_sync_fake_board.py
@@ -129,11 +129,17 @@ class FakeService:
     NEUTRAL = {"rate_limited": ("rate_limited", "rate_limited"), "owner_restart": ("reclaimed", "owner_restart_lost"),
                "owner_unavailable": ("owner_unavailable", "owner_unavailable"), "owner_down": ("owner_down", "owner_down"),
                "reboot_bystander": ("host_reboot", "host_reboot")}
+    # transitions.ts RELEASE_OUTCOMES: releaseTask rejects any other outcome as ``invalid``.
+    RELEASE_OUTCOMES = frozenset({"released", *NEUTRAL, "crashed", "timed_out", "spawn_failed", "terminal_provider"})
+    # transitions.ts MAX_DIAGNOSTIC_CHARS: a larger holder diagnostic is replaced by ``{diagnostic_truncated: true}``.
+    MAX_DIAGNOSTIC_CHARS = 8000
 
     def release_op(self, b: dict, op: dict, gw: str) -> dict:
         """As transitions.ts releaseTask: only the lease holder's run is released; the Board ends that run, emits
         its one outcome event (carrying the holder's ``diagnostic``) and books a charged outcome exactly once."""
         task, run = op["task"], op["run_uid"]
+        if op.get("outcome", "released") not in self.RELEASE_OUTCOMES:
+            return {"status": "rejected", "reason": "invalid"}
         lease = b["leases"].get(task)
         if not lease or lease["holder"] != gw or lease["run_uid"] != run:
             return {"status": "rejected", "reason": "lease_lost"}
@@ -264,6 +270,12 @@ class FakeHub:
             if not cur or cur["holder"] != self.gateway or cur["run_uid"] != run:
                 return {"status": "rejected", "reason": "lease_lost", "lease": cur}
         else:
+            if str(body.get("outcome") or "released") not in self.svc.RELEASE_OUTCOMES:
+                # releaseTask checks the outcome before its fence: an unknown one (a test typo) is ``invalid``.
+                return {"status": "rejected", "reason": "invalid", "lease": cur}
+            if self.svc.lease_runs and body.get("outcome") == "spawn_failed":
+                raise NotImplementedError("FakeHub.leases: spawn_failed release (endCustody + recordTaskFailure) is "
+                                          "not modelled; see _release_run")
             if self.svc.lease_runs and (not cur or cur["holder"] != gw or cur["run_uid"] != run):
                 # releaseTask's fence(): a release that does not name this gateway's live lease run is refused and
                 # changes nothing (the card keeps its lease and mirror).
@@ -289,11 +301,19 @@ class FakeHub:
         a running card goes back to ``retry`` (retryStatusForRun) and the run-outcome event always carries it as
         ``retry_status``.
 
-        A neutral outcome (``FakeService.NEUTRAL`` = NEUTRAL_RELEASES) ends the run as its mapped outcome and emits
-        its mapped event; anything else ends as ``outcome`` (``terminal_provider`` -> ``crashed``) and emits that
-        kind. Failure accounting (recordTaskFailure for crashed/timed_out/spawn_failed) is not modelled on this
-        path; :meth:`FakeService.release_op` covers it for the ops path. ``unused_grant`` (live t_01a1a1dea9c64d6a
-        run 164239) marks the run metadata and the event only for a plain ``released`` outcome."""
+        Modelled outcomes (anything outside ``FakeService.RELEASE_OUTCOMES`` is refused ``invalid`` before this):
+        - neutral (``FakeService.NEUTRAL`` = NEUTRAL_RELEASES): the run ends as its mapped outcome and emits its
+          mapped event; the holder's ``extra`` (plus ``owner_restart: true``) is merged into run metadata and payload.
+        - ``released``, ``crashed``, ``timed_out``, ``terminal_provider`` (-> ``crashed``): the run ends as that
+          outcome and emits that kind. For the canonical failures the holder's ``diagnostic`` is merged into run
+          metadata and payload (``{diagnostic_truncated: true}`` past MAX_DIAGNOSTIC_CHARS), and a ``crashed``
+          release with ``protocol_violation: true`` marks the run metadata. ``unused_grant`` (live
+          t_01a1a1dea9c64d6a run 164239) marks the run metadata and the event only for a plain ``released``.
+
+        Not modelled: failure accounting (recordTaskFailure: consecutive_failures, failure_finalized, the breaker,
+        the protocol-violation streak); :meth:`FakeService.release_op` covers it for the ops path. ``spawn_failed``
+        is refused with NotImplementedError by :meth:`leases`: the real releaseTask hands it to endCustody +
+        recordTaskFailure(releaseClaim, endRun), whose run/event shape is that accounting."""
         gw, svc = self.gateway, self.svc
         outcome = str(body.get("outcome") or "released")
         error = str(body.get("error") or outcome)[:500]
@@ -302,7 +322,7 @@ class FakeHub:
         neutral = svc.NEUTRAL.get(outcome)
         if neutral:
             ended, kind = neutral
-            meta = {"owner_restart": True} if outcome == "owner_restart" else {}
+            meta = {**(body.get("extra") or {}), **({"owner_restart": True} if outcome == "owner_restart" else {})}
             run_fields = {"error": error, "metadata": json.dumps(meta, separators=(",", ":")) if meta else None}
             payload: dict = {**meta, "error": error, "retry_status": retry}
             task_fields = {"status": retry, "last_failure_error": error} if running else {}
@@ -311,10 +331,15 @@ class FakeHub:
             unused = bool(body.get("unused_grant")) and outcome == "released" and running
             canonical = outcome in ("crashed", "timed_out", "terminal_provider")
             err = None if outcome == "released" else error
-            run_fields = {"error": err, **({"metadata": json.dumps({"unused_grant": True}, separators=(",", ":"))}
-                                           if unused else {})}
-            payload = {**({"failure_notice": "canonical"} if canonical else {}), "error": err, "retry_status": retry,
-                       **({"terminal_provider": True} if outcome == "terminal_provider" else {}),
+            diag = dict(body.get("diagnostic") or {}) if canonical else {}
+            if len(json.dumps(diag, separators=(",", ":"))) > svc.MAX_DIAGNOSTIC_CHARS:
+                diag = {"diagnostic_truncated": True}
+            meta = {**diag, **({"protocol_violation": True}
+                               if outcome == "crashed" and body.get("protocol_violation") is True else {}),
+                    **({"unused_grant": True} if unused else {})}
+            run_fields = {"error": err, **({"metadata": json.dumps(meta, separators=(",", ":"))} if meta else {})}
+            payload = {**diag, **({"failure_notice": "canonical"} if canonical else {}), "error": err,
+                       "retry_status": retry, **({"terminal_provider": True} if outcome == "terminal_provider" else {}),
                        **({"unused_grant": True} if unused else {})}
             task_fields = {"status": retry, **({"last_failure_error": error} if outcome == "rate_limited" else {})} \
                 if running else {}
diff --git a/tests/hermes_cli/test_kanban_sync_rejections.py b/tests/hermes_cli/test_kanban_sync_rejections.py
index f8c677ef24..2b6808abd5 100644
--- a/tests/hermes_cli/test_kanban_sync_rejections.py
+++ b/tests/hermes_cli/test_kanban_sync_rejections.py
@@ -1,4 +1,5 @@
 """Selective rejection retirement uses authoritative evidence, never replica absence."""
+import copy
 import json
 
 import pytest
@@ -376,6 +377,17 @@ def test_fake_lease_release_is_fenced_on_the_holders_run(live, kanban_home, gate
      {"error": "rate_limited", "retry_status": "ready"}, "ready"),
     ({"outcome": "terminal_provider", "error": "bad key"}, "ready", "crashed", "crashed",
      {"failure_notice": "canonical", "error": "bad key", "retry_status": "ready", "terminal_provider": True}, "ready"),
+    # The holder's diagnostic belongs to a canonical failure: merged into run metadata and the event payload.
+    ({"outcome": "timed_out", "diagnostic": {"exit_code": 124}}, "ready", "timed_out", "timed_out",
+     {"exit_code": 124, "failure_notice": "canonical", "error": "timed_out", "retry_status": "ready"}, "ready"),
+    ({"outcome": "crashed", "diagnostic": {"tail": "x" * 9000}}, "ready", "crashed", "crashed",
+     {"diagnostic_truncated": True, "failure_notice": "canonical", "error": "crashed", "retry_status": "ready"},
+     "ready"),
+    # ...but not to a plain release; a neutral release merges the holder's extra instead.
+    ({"diagnostic": {"exit_code": 0}}, "ready", "released", "released", {"error": None, "retry_status": "ready"},
+     "ready"),
+    ({"outcome": "owner_down", "extra": {"host": "mini"}}, "ready", "owner_down", "owner_down",
+     {"host": "mini", "error": "owner_down", "retry_status": "ready"}, "ready"),
 ])
 def test_fake_lease_release_emits_run_outcome_event(live, kanban_home, extra, lane, run_outcome, kind, payload,
                                                     status):
@@ -396,6 +408,52 @@ def test_fake_lease_release_emits_run_outcome_event(live, kanban_home, extra, la
     assert rows["tasks"][tid]["lease_run_uid"] is None
 
 
+def _leased(live, svc):
+    hub = svc.hub(ME)
+    tid = kb.create_task(live, title="leased", assignee="worker")
+    client.push(live, hub, BOARD, ME, primary=False)
+    grant = {"action": "grant", "task": tid, "run_uid": RUN, "client_op_id": "g"}
+    assert hub.leases(BOARD, grant)["status"] == "applied"
+    return hub, tid
+
+
+def test_fake_lease_release_merges_diagnostic_into_run_metadata(live, kanban_home):
+    """As releaseTask: a crashed release's diagnostic and protocol_violation flag land in the run metadata."""
+    svc = FakeService(lease_runs=True)
+    hub, tid = _leased(live, svc)
+    release = {"action": "release", "task": tid, "run_uid": RUN, "client_op_id": "r", "outcome": "crashed",
+               "diagnostic": {"exit_code": 1}, "protocol_violation": True}
+    assert hub.leases(BOARD, release)["status"] == "applied"
+    run = svc.board(BOARD)["rows"]["task_runs"][RUN]
+    assert json.loads(run["metadata"]) == {"exit_code": 1, "protocol_violation": True}
+
+
+@pytest.mark.parametrize("lease_runs", [True, False])
+def test_fake_lease_release_rejects_unknown_outcome(live, kanban_home, lease_runs):
+    """As releaseTask's RELEASE_OUTCOMES guard: a typo'd outcome is ``invalid`` and changes nothing."""
+    svc = FakeService(lease_runs=lease_runs)
+    hub, tid = _leased(live, svc)
+    before = copy.deepcopy(svc.board(BOARD))
+    release = {"action": "release", "task": tid, "run_uid": RUN, "client_op_id": "r", "outcome": "crashd"}
+    res = hub.leases(BOARD, release)
+    assert (res["status"], res["reason"]) == ("rejected", "invalid")
+    assert svc.board(BOARD) == before
+    b = svc.board(BOARD)
+    op = {"op": "release", "task": tid, "run_uid": RUN, "client_op_id": "o", "outcome": "crashd"}
+    assert svc.release_op(b, op, ME) == {"status": "rejected", "reason": "invalid"}
+    assert svc.board(BOARD) == before
+
+
+def test_fake_lease_release_spawn_failed_is_not_modelled(live, kanban_home):
+    """releaseTask hands spawn_failed to endCustody + recordTaskFailure; the fake refuses it loudly."""
+    svc = FakeService(lease_runs=True)
+    hub, tid = _leased(live, svc)
+    with pytest.raises(NotImplementedError):
+        hub.leases(BOARD, {"action": "release", "task": tid, "run_uid": RUN, "client_op_id": "r",
+                           "outcome": "spawn_failed"})
+    assert svc.board(BOARD)["leases"][tid]["run_uid"] == RUN
+
+
 def test_release_local_change_during_read_vetoes(live, svc, monkeypatch):
     lost_release(live, svc)
     hub = svc.hub(ME)
