             continue  # a human owns it, or its kernel recovery card is its producer
         recent = conn.execute(
diff --git a/tests/hermes_cli/test_kanban_resume_requester_sync.py b/tests/hermes_cli/test_kanban_resume_requester_sync.py
index 9ffc72436ab..a8b7e5500bd 100644
--- a/tests/hermes_cli/test_kanban_resume_requester_sync.py
