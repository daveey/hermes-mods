From 5583b66ef935267eaefcbf98fbb461f8ec6f743c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 21:59:38 +0000
Subject: [PATCH] [daveey] fix(notices): preserve unrelated input in premerged
 carriers

Review #3105: a passive A carrier can already contain passive B when woken A arrives. Refuse supersession of differing contents with fold provenance; fall back to lossless ordinary merge. Fix non-dict notice-id guard. RED: 4 failures on f09f2e54fd (A/B/A loss and three provenance guards); GREEN: 365 notice tests plus 384 repair/persistence tests. Reverse order is a passing guard. Mixed plain-user-run sidecar gap is preexisting and owned by t_01a1dc121fa992f2.
---
 agent/agent_runtime_helpers_user_rows.py      | 11 +++++-
 .../test_kanban_remote_notice_once.py         | 35 +++++++++++++++++++
 2 files changed, 45 insertions(+), 1 deletion(-)

diff --git a/agent/agent_runtime_helpers_user_rows.py b/agent/agent_runtime_helpers_user_rows.py
index 9913ef654b..d79d8558e3 100644
--- a/agent/agent_runtime_helpers_user_rows.py
+++ b/agent/agent_runtime_helpers_user_rows.py
@@ -19,7 +19,7 @@ def _remember_own_row(survivor: dict[str, Any]) -> None:
 
 def _notice_id(msg: Any) -> Optional[str]:
     meta = msg.get("display_metadata") if isinstance(msg, dict) else None
-    if msg.get("role") != "user" or msg.get("display_kind") != "kanban_notice" or not isinstance(meta, dict):
+    if not isinstance(meta, dict) or msg.get("role") != "user" or msg.get("display_kind") != "kanban_notice":
         return None
     value = meta.get("notice_id")
     return value if isinstance(value, str) and value else None
@@ -32,9 +32,18 @@ def keep_one_notice_row(prev: dict[str, Any], msg: Any) -> Optional[dict[str, An
     turn's api_content (its ask-gate live-state block) with the stale sidecar (t_01a1db370b459fab). The row
     carrying api_content is kept (the woken turn's), else the first; the other is retired onto it, unfolded."""
     from agent.agent_runtime_helpers import _count_unnamed_row, _remember_absorbed_row
+    from agent.conversation_compression_archive import MERGED_DURABLE_ROWS
+    from agent.message_metadata import MERGED_TURN_PREFIX
 
     if not isinstance(msg, dict) or (nid := _notice_id(prev)) is None or _notice_id(msg) != nid:
         return None
+    # A previous plain merge retains the first notice's identity while adding other input.
+    # Never supersede that input merely because its carrier has the same notice_id.
+    if prev.get("content") != msg.get("content") and any(
+        row.get(key) for row in (prev, msg)
+        for key in (MERGED_TURN_PREFIX, MERGED_DURABLE_ROWS, "_absorbed_row_ids")
+    ):
+        return None
     keep, drop = (msg, prev) if ("api_content" in msg and "api_content" not in prev) else (prev, msg)
     _count_unnamed_row(keep, drop)
     _remember_absorbed_row(keep, drop, folded=False)
diff --git a/tests/tui_gateway/test_kanban_remote_notice_once.py b/tests/tui_gateway/test_kanban_remote_notice_once.py
index fc40c78b80..178e1dd6db 100644
--- a/tests/tui_gateway/test_kanban_remote_notice_once.py
+++ b/tests/tui_gateway/test_kanban_remote_notice_once.py
@@ -11,6 +11,8 @@ import json
 import sqlite3
 import time
 
+import pytest
+
 from hermes_state import SessionDB
 from tui_gateway import kanban_remote_notices as krn
 from tui_gateway.kanban_remote_notices import sweep_remote_notices
@@ -196,3 +198,36 @@ def test_alternation_repair_keeps_one_copy_of_a_notice_and_its_api_content():
     messages = [{"role": "assistant", "content": "ok"}, dict(passive), other]
     repair_message_sequence(None, messages)
     assert messages[-1]["content"].count(text) == 2
+
+
+@pytest.mark.parametrize("woken_first", [False, True])
+def test_notice_dedupe_never_discards_a_previously_folded_other_notice(woken_first):
+    from agent.agent_runtime_helpers import repair_message_sequence
+
+    a = {"role": "user", "content": "notice A", "display_kind": "kanban_notice",
+         "display_metadata": {"notice_id": "A"}, "_row_id": 10}
+    b = {"role": "user", "content": "notice B", "display_kind": "kanban_notice",
+         "display_metadata": {"notice_id": "B"}, "_row_id": 11}
+    woken = {**a, "_row_id": 12, "api_content": "notice A\n[ask-gate] live state"}
+    messages = [{"role": "assistant", "content": "ok"},
+                *([woken, b, a] if woken_first else [a, b, woken])]
+    repair_message_sequence(None, messages)
+    assert "notice B" in messages[-1]["content"]
+    assert "notice A" in messages[-1]["content"]
+    assert {10, 11, 12} <= {messages[-1]["_row_id"], *messages[-1].get("_absorbed_row_ids", [])}
+
+
+@pytest.mark.parametrize("marker", ["_merged_turn_prefix", "_merged_durable_rows", "_absorbed_row_ids"])
+def test_notice_dedupe_refuses_premerged_rows(marker):
+    from agent.agent_runtime_helpers_user_rows import keep_one_notice_row
+    from agent.conversation_compression_archive import MERGED_DURABLE_ROWS
+    from agent.message_metadata import MERGED_TURN_PREFIX
+
+    key = {"_merged_turn_prefix": MERGED_TURN_PREFIX, "_merged_durable_rows": MERGED_DURABLE_ROWS,
+           "_absorbed_row_ids": "_absorbed_row_ids"}[marker]
+    passive = {"role": "user", "content": "A and other input", "display_kind": "kanban_notice",
+               "display_metadata": {"notice_id": "A"}, key: [1] if marker == "_absorbed_row_ids" else 1}
+    woken = {"role": "user", "content": "A", "api_content": "A live state",
+             "display_kind": "kanban_notice", "display_metadata": {"notice_id": "A"}}
+    assert keep_one_notice_row(passive, woken) is None
+    assert keep_one_notice_row(woken, passive) is None
-- 
