From 974fe494b2ec530b2f7f8a1ffc946a50ea441580 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 23:16:10 +0000
Subject: [PATCH] test(desktop): pin legacy tab-slot fixture and cover Single
 fallback [daveey]

---
 .../src/app/hooks/use-keybinds-tab-slot.test.ts     | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/apps/desktop/src/app/hooks/use-keybinds-tab-slot.test.ts b/apps/desktop/src/app/hooks/use-keybinds-tab-slot.test.ts
index c169805532..6188bf48df 100644
--- a/apps/desktop/src/app/hooks/use-keybinds-tab-slot.test.ts
+++ b/apps/desktop/src/app/hooks/use-keybinds-tab-slot.test.ts
@@ -19,6 +19,7 @@ import { findGroup, group, split } from '@/components/pane-shell/tree/model'
 import { $activeTreeGroup, $hoveredTreeGroup, $layoutTree } from '@/components/pane-shell/tree/store'
 import { registry } from '@/contrib/registry'
 import { isMacPlatform } from '@/lib/platform'
+import { setTabStripDefault } from '@/store/tabstrip-prefs'
 
 // ⌘1…⌘9 is one chord with two meanings: the Nth tab of the zone under the
 // pointer (else the focused zone, else the workspace's) when that zone is a
@@ -57,6 +58,7 @@ beforeAll(() => {
 })
 
 beforeEach(() => {
+  setTabStripDefault('auto') // multi-tab fixtures predate Single
   switchProfileToSlot.mockClear()
   unmountKeybinds = renderHook(
     () =>
@@ -111,6 +113,17 @@ describe('⌘N over a tab strip is a tab switch, elsewhere a profile switch', ()
     expect(switchProfileToSlot).toHaveBeenCalledWith(2)
   })
 
+  it('falls through to profile switching for the hidden main strip in Single', () => {
+    setTabStripDefault('single')
+    $layoutTree.set(group(['workspace', 'a'], { active: 'workspace', id: 'main' }))
+    $hoveredTreeGroup.set('main')
+
+    press(2)
+
+    expect(activePane('main')).toBe('workspace')
+    expect(switchProfileToSlot).toHaveBeenCalledWith(2)
+  })
+
   it('falls through when the strip has no Nth tab', () => {
     $layoutTree.set(split('row', [group(['workspace', 'a'], { active: 'workspace', id: 'left' })]))
     $hoveredTreeGroup.set('left')
-- 
