From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 01:50:25 +0000
Subject: [PATCH] fix(kanban): distinguish coordination commands from prose
 [daveey]

Proof: 427 real-row replay; portable66 to69, no baseline-portable regression. 426 focused tests pass; false-positive regressions failed before fix.
---
 hermes_cli/kanban_placement_coordination.py   |  51 +++++++--
 .../test_kanban_coordination_placement.py     | 105 +++++++++++++++++-
 2 files changed, 147 insertions(+), 9 deletions(-)

diff --git a/hermes_cli/kanban_placement_coordination.py b/hermes_cli/kanban_placement_coordination.py
index e6df7ec5c29..83597c41e16 100644
--- a/hermes_cli/kanban_placement_coordination.py
+++ b/hermes_cli/kanban_placement_coordination.py
@@ -13,8 +13,43 @@ import time
 REASON = "needs worker coordination capability"
 ACTION_REASON = "needs home coordination action"
 # Intentionally narrower than the CLI: status and pull are the reader install's proof.
-_HUB = re.compile(r"\bhermes-hub\b(?!\s+client\b)(?:\s+([\w-]+))?", re.IGNORECASE)
-_CROSS = re.compile(r"\bcross_task\b(?:\s+(read|list)\b)?", re.IGNORECASE)
+_HUB = re.compile(r"(?<![\w/.-])hermes-hub\b(?![/.-])", re.IGNORECASE)
+_CROSS = re.compile(r"(?<![\w/.-])cross_task\b(?![/.-])", re.IGNORECASE)
+_HUB_ACTIONS = set(("status pull sync sessions inbox tasks where links request requests "
+                    "inspect-legacy reconcile-legacy inspect-alias retire-alias adopt-task "
+                    "create-task depend outcomes install-watch watch diff-shared").split())
+_EXECUTION = re.compile(r"(?:\b(?:run|execute|invoke|call|use|via|with)\s+`?|`|[;$|&]\s*)$", re.IGNORECASE)
+
+
+def _actions(text, tool, known):
+    """Recognize action tokens or explicit invocations, not host/repository names.
+
+    Unknown commands fail closed in command syntax (quotes, execution verbs,
+    shell separators, or a standalone command line). A prose mention alone is
+    not execution intent. Do not exempt the containing sentence/line: other
+    home markers remain independently binding.
+    """
+    for match in tool.finditer(text):
+        tail = text[match.end():]
+        action = re.match(r"[ \t]+([\w-]+)(?![\w-])", tail)
+        # Also accept the actual tool-call spelling, including unknown actions.
+        call = re.match(r"\(\s*action\s*=\s*['\"]([^'\"]+)['\"]", tail)
+        value = (call.group(1) if call else action.group(1) if action else "").lower()
+        prefix = text[:match.start()]
+        line = prefix.rsplit("\n", 1)[-1]
+        standalone = not line.strip() and not tail.strip(" \t`\n")
+        command_line = (not line.strip() and action is not None
+                        and not tail[action.end():].strip(" \t`\n"))
+        explicit = _EXECUTION.search(prefix)
+        # A quoted executable name (`hermes-hub` CLI shim) is documentation,
+        # unlike a quoted command with an action (`hermes-hub unknown-command`).
+        if explicit and explicit.group().strip() == "`" and not action:
+            explicit = None
+        if call or value in known or explicit or standalone or command_line:
+            end = match.end() + (call.end() if call else action.end() if action else 0)
+            yield match.start(), end, value
+
+
 _TOOLS = {
     "token-broker": "capability:token-broker",
     "hermes-core-wt": "capability:core-ship",
@@ -25,12 +60,12 @@ _TOOLS = {
 def requirements(text):
     """Return required labels and an unsupported-action refusal, without changing text."""
     labels = set()
-    for match in _HUB.finditer(text):
-        if (match.group(1) or "").lower() not in ("status", "pull"):
+    for _, _, action in _actions(text, _HUB, _HUB_ACTIONS):
+        if action not in ("status", "pull"):
             return labels, ACTION_REASON
         labels.add("capability:coordination-read")
-    for match in _CROSS.finditer(text):
-        if not match.group(1):
+    for _, _, action in _actions(text, _CROSS, {"read", "list", "comment"}):
+        if action not in ("read", "list"):
             return labels, ACTION_REASON
         labels.add("capability:coordination-read")
     if re.search(r"\b(?:parent|sibling)[ -]card (?:lookup|read)|\bkanban_show\b", text, re.IGNORECASE):
@@ -92,7 +127,9 @@ def check(text, cfg, *, target=None, skills=None):
 
 def marker_text(text):
     """Only called after check succeeds. Extra operator markers use ORIGINAL text."""
-    text = _HUB.sub("", text)
+    for start, end, action in reversed(list(_actions(text, _HUB, _HUB_ACTIONS))):
+        if action in ("status", "pull"):
+            text = text[:start] + text[end:]
     return re.sub(r"\btoken-broker\b", "", text, flags=re.IGNORECASE)
 
 
diff --git a/tests/hermes_cli/test_kanban_coordination_placement.py b/tests/hermes_cli/test_kanban_coordination_placement.py
index 7a33eb7f06e..af85ec6314c 100644
--- a/tests/hermes_cli/test_kanban_coordination_placement.py
+++ b/tests/hermes_cli/test_kanban_coordination_placement.py
@@ -140,6 +140,107 @@ def test_skill_pin_requires_attestation(fleet, skill):
     assert kp.portable_reason(args, cfg) == "needs worker coordination capability"
 
 
-def test_development_title_is_not_cli_execution(fleet):
+@pytest.mark.parametrize("text", [
+    "hermes-hub client: retry a 409 from the Board",
+    "Build a `hermes-hub` CLI shim",
+    "Fix the `cross_task` endpoint",
+    "Live check on\nhermes-hub reports no tools and exits 0",
+    "crash storm on hermes-hub) was detected yesterday",
+    "hermes-hub error receipt PR75",
+    "hosts/hermes-hub/bin/hub-core-update",
+    'connection="hermes-hub"',
+    "Fix cross_task comments being labeled human through Desktop endpoint",
+    "Check cross_task comment179201 wrongly writer_kind=human",
+    "Test actual agent cross_task path and human UI path independently",
+])
+def test_development_or_hostname_mentions_add_no_requirement(fleet, text):
+    from hermes_cli import kanban_placement_coordination as coord
+    cfg, entry, _ = fleet
+    entry["labels"] = []
+    assert coord.requirements(text) == (set(), None)
+    assert reason(text, cfg) is None
+
+
+@pytest.mark.parametrize("text", [
+    "Run hermes-hub frobnicate", "`hermes-hub frobnicate`",
+    "hermes-hub unknown-command", "hermes-hub --new-option",
+    "hermes-hub status; hermes-hub create-task title",
+    "Use cross_task comment", "cross_task comment task-id",
+    'cross_task(action="comment", target="task")',
+    "cross_task read; cross_task unknown-command", "cross_task",
+])
+def test_explicit_execution_is_fail_closed(fleet, text):
+    from hermes_cli import kanban_placement_coordination as coord
+    assert coord.requirements(text)[1] == coord.ACTION_REASON
+
+
+@pytest.mark.parametrize("text", ["hermes-hub status", "hermes-hub pull", "cross_task read", "cross_task list"])
+def test_each_read_needs_fresh_attestation(fleet, text):
+    cfg, entry, _ = fleet
+    assert reason(text, cfg) is None
+    entry["labels"] = []
+    assert reason(text, cfg) == "needs worker coordination capability"
+
+
+@pytest.mark.parametrize("pools", [None, [], "worker", {}, {"hub": [" "]},
+                                        {"hub": ["worker"] * 65}])
+def test_missing_or_invalid_current_pool(fleet, pools):
+    cfg, _, _ = fleet
+    cfg["worker_pools"] = pools
+    assert reason("cross_task read", cfg) == "needs worker coordination capability"
+
+
+@pytest.mark.parametrize("snapshot", [None, [], {}, {"machines": None},
+                                           {"machines": []}, {"machines": {}},
+                                           {"machines": {"worker": None}}])
+def test_invalid_registry_or_missing_destination(fleet, monkeypatch, snapshot):
+    cfg, _, _ = fleet
+    monkeypatch.setattr(wn, "registry", lambda: snapshot)
+    assert reason("cross_task read", cfg) == "needs worker coordination capability"
+
+
+@pytest.mark.parametrize("field,value", [
+    ("labels", None), ("labels", [1, "capability:coordination-read"]),
+    ("last_seen", None), ("last_seen", float("nan")),
+    ("last_seen", 10**1000), ("last_seen", float("-inf")),
+])
+def test_malformed_attestation_fields(fleet, field, value):
+    cfg, entry, _ = fleet
+    entry[field] = value
+    assert reason("cross_task read", cfg) == "needs worker coordination capability"
+
+
+def test_explicit_destination_does_not_borrow_current_pool(fleet):
+    from hermes_cli import kanban_placement_coordination as coord
+    cfg, _, _ = fleet
+    assert coord.check("cross_task read", cfg, target="missing") == coord.REASON
+    cfg["worker_pools"] = None
+    assert coord.check("cross_task read", cfg, target="worker") is None
+
+
+def test_marker_exemption_preserves_legacy_and_other_text():
+    from hermes_cli import kanban_placement_coordination as coord
+    text = "hermes-hub status; hermes-hub sessions; token-broker; ssh server"
+    assert coord.marker_text(text) == "; hermes-hub sessions; ; ssh server"
+
+
+@pytest.mark.parametrize("command", [
+    "sync", "sessions", "inbox", "tasks", "where", "links", "request", "requests",
+    "inspect-legacy", "reconcile-legacy", "inspect-alias", "retire-alias",
+    "adopt-task", "create-task", "depend", "outcomes", "install-watch", "watch", "diff-shared",
+])
+def test_every_legacy_cli_marker_still_refuses(fleet, command):
     cfg, _, _ = fleet
-    assert reason("hermes-hub client: retry a 409 from the Board", cfg) is None
+    assert reason("hermes-hub " + command, cfg) == "needs home coordination action"
+    # The old marker permits arbitrary whitespace; narrowing intent detection
+    # must never turn a non-exempt old marker into a portable card.
+    assert reason("hermes-hub\n" + command, cfg) is not None
+
+
+def test_ordinary_work_does_not_read_registry(monkeypatch):
+    from hermes_cli import kanban_placement_coordination as coord
+    def unexpected():
+        pytest.fail("ordinary source work must not need registry availability")
+    monkeypatch.setattr(wn, "registry", unexpected)
+    assert coord.check("Fix cross_task comments in the endpoint", {}) is None
+    assert coord.legacy_refusal({"title": "Fix cross_task comments"}) is False
