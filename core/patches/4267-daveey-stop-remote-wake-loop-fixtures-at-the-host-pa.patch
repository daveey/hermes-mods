From 13d3d3be0d0cfea99c7e65222ffa841ee72753ae Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 21:57:32 +0000
Subject: [PATCH] [daveey] stop remote wake loop fixtures at the host-pass
 boundary

H2 may skip the empty local notice sweep, so using it to set the loop stop event hangs the remote-wake fixture. Stop after the actual host pass instead; preserve all notice delivery assertions. Proof: PR3101 CI timed out at 600s, local original exceeded 180s; corrected remote wake plus gate suites: 116 passed.
---
 tests/tui_gateway/test_kanban_remote_wake.py | 24 ++++++++++++++++++--
 1 file changed, 22 insertions(+), 2 deletions(-)

diff --git a/tests/tui_gateway/test_kanban_remote_wake.py b/tests/tui_gateway/test_kanban_remote_wake.py
index 8990d934c8..68de69386d 100644
--- a/tests/tui_gateway/test_kanban_remote_wake.py
+++ b/tests/tui_gateway/test_kanban_remote_wake.py
@@ -102,7 +102,17 @@ def _one_pass(monkeypatch, wake_verdict="started", row_lands=True):
     monkeypatch.setattr(ku, "wake_turn", wake)
     monkeypatch.setattr(ku, "_spawn_thread", lambda job: (job(), "dispatched")[1])
     stop = threading.Event()
-    monkeypatch.setattr(ku, "sweep_once", lambda *a, **k: stop.set() or [])
+    monkeypatch.setattr(ku, "sweep_once", lambda *a, **k: [])
+    host_pass = ku.host_pass
+
+    def one_host_pass(*args, **kwargs):
+        try:
+            return host_pass(*args, **kwargs)
+        finally:
+            # Empty local sweeps may be skipped; stop at the host boundary.
+            stop.set()
+
+    monkeypatch.setattr(ku, "host_pass", one_host_pass)
     ku._loop(stop)
     return wakes
 
@@ -316,7 +326,17 @@ def _one_pass_live(monkeypatch, admit, row_lands=False):
     monkeypatch.setattr(ku, "wake_turn", wake)
     monkeypatch.setattr(ku, "_spawn_thread", lambda job: (job(), "dispatched")[1])
     stop = threading.Event()
-    monkeypatch.setattr(ku, "sweep_once", lambda *a, **k: stop.set() or [])
+    monkeypatch.setattr(ku, "sweep_once", lambda *a, **k: [])
+    host_pass = ku.host_pass
+
+    def one_host_pass(*args, **kwargs):
+        try:
+            return host_pass(*args, **kwargs)
+        finally:
+            # Empty local sweeps may be skipped; stop at the host boundary.
+            stop.set()
+
+    monkeypatch.setattr(ku, "host_pass", one_host_pass)
     ku._loop(stop)
     return wakes
 
-- 
