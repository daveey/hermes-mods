diff --git a/plugins/kanban/dashboard/board_rows.py b/plugins/kanban/dashboard/board_rows.py
index 8e8bfb173c4501bf7e7c50c280d53b6d65ffb447..e7fc12265124a344a66d02f7417a48400ec22f68 100644
--- a/plugins/kanban/dashboard/board_rows.py
+++ b/plugins/kanban/dashboard/board_rows.py
@@ -290,15 +290,27 @@ def incremental(key: tuple, path: str, build: Callable, fallback: Callable) -> d
         conn.row_factory = sqlite3.Row
         try:
             conn.execute("BEGIN")
-            changed, cursor = kanban_task_change.changed_since(conn, hit[0] if hit else None)
-            rows = build(conn, hit[1] if hit else None, changed)
+            # Sample while holding this observer's refresh lock and snapshot. A
+            # version captured by version() before the lock can predate another
+            # refresh. This key includes bookkeeping commits, unlike P2.
+            commit_key = (obs.gen, *obs.ident,
+                          conn.execute("PRAGMA schema_version").fetchone()[0],
+                          conn.execute("PRAGMA data_version").fetchone()[0])
+            if hit is not None and len(hit) > 2 and hit[0] is not None and hit[2] == commit_key:
+                from hermes_cli import loop_accounting
+                with loop_accounting.pass_("kanban.board.rows", skipped=True):
+                    rows = hit[1]
+                cursor = hit[0]
+            else:
+                changed, cursor = kanban_task_change.changed_since(conn, hit[0] if hit else None)
+                rows = build(conn, hit[1] if hit else None, changed)
         finally:
             if conn.in_transaction:
                 conn.rollback()
             conn.row_factory = factory
         with _lock:
             if _observers.get(str(path)) is obs:
-                _entries[cache_key] = (cursor, rows)
+                _entries[cache_key] = (cursor, rows, commit_key)
                 _entries.move_to_end(cache_key)
                 while len(_entries) > MAX_ENTRIES:
                     _entries.popitem(last=False)
diff --git a/plugins/kanban/dashboard/board_run_history.py b/plugins/kanban/dashboard/board_run_history.py
index 75ffbf2d2ad211bfddd7664d9126076fabd707fd..f0dc2c366e49e04d3662bab4b605598a0a00481e 100644
--- a/plugins/kanban/dashboard/board_run_history.py
+++ b/plugins/kanban/dashboard/board_run_history.py
@@ -1,4 +1,5 @@
 """P2-retained run snapshots with an exact per-read bookkeeping overlay."""
+import marshal
 from types import MappingProxyType
 
 # P2 excludes these run columns. Even historical terminal runs need the overlay:
@@ -47,9 +48,10 @@ def retained_runs(conn, ids, prev, changed, load):
             continue
         rows = []
         for original, row in zip(before, overlay):
-            # Type-exact: 1 -> 1.0 or 0 -> False is a change the retained row must show.
+            # Same typed encoding as the signature, including signed floating zero
+            # on legacy untyped columns. Never stamp bytes for values not retained.
             updates = {key: value for key, value in zip(columns, row[2:])
-                       if (prior := original[key]) != value or type(prior) is not type(value)}
+                       if marshal.dumps(original[key], 2) != marshal.dumps(value, 2)}
             rows.append(MappingProxyType({**original, **updates}) if updates else original)
         # Read before these values, so a later write can only make the next compare miss.
         result[tid] = RunHistory(rows, signatures.get(tid, ""))
@@ -59,9 +61,9 @@ def retained_runs(conn, ids, prev, changed, load):
 
 
 class RunHistory(tuple):
-    """Retained runs of one task plus the SQL signature of their ids and bookkeeping values."""
+    """Retained runs plus the packed signature of their ids and bookkeeping values."""
 
-    signature: str
+    signature: bytes | str
 
     def __new__(cls, rows, signature):
         self = super().__new__(cls, rows)
@@ -70,12 +72,20 @@ class RunHistory(tuple):
 
 
 def _signatures(conn, task_ids, columns) -> dict:
-    """``{task_id: text}`` naming every run id and bookkeeping value, ``quote``d so type and
-    NULL-ness are exact, built in SQLite rather than by comparing each run in Python."""
+    """Exact typed run values, packed in C instead of SQL quote/concatenation.
+
+    These bytes are only compared in-process, never persisted or unmarshalled.
+    Version 2 avoids reference-identity encoding: equal values must encode equally
+    regardless of Python object sharing. It preserves SQLite NULL/int/float/text/blob,
+    including embedded NULs that SQLite quote(text) truncates.
+    """
     if not task_ids:
         return {}
-    fields = "||','||".join(f"quote({c})" for c in ("id", *columns))
-    return {r[0]: r[1] for r in conn.execute(
-        f"SELECT task_id, group_concat(sig, ';') FROM (SELECT task_id, {fields} AS sig FROM task_runs "
-        f"WHERE task_id IN ({','.join('?' for _ in task_ids)}) ORDER BY task_id, id) GROUP BY task_id",
-        tuple(task_ids))}
+    selected = ", ".join(("task_id", "id", *columns))
+    grouped = {}
+    for row in conn.execute(
+            f"SELECT {selected} FROM task_runs "
+            f"WHERE task_id IN ({','.join('?' for _ in task_ids)}) ORDER BY task_id, id",
+            tuple(task_ids)):
+        grouped.setdefault(row[0], []).append(tuple(row)[1:])
+    return {tid: marshal.dumps(rows, 2) for tid, rows in grouped.items()}
diff --git a/tests/plugins/test_kanban_board_commit_reuse.py b/tests/plugins/test_kanban_board_commit_reuse.py
new file mode 100644
index 0000000000000000000000000000000000000000..15c1d49d3092b289480ed31b74c521db48f40bea
--- /dev/null
+++ b/tests/plugins/test_kanban_board_commit_reuse.py
@@ -0,0 +1,92 @@
+"""Commit-fenced row reuse must still project live values on every GET."""
+from hermes_cli import kanban_db_connect as kbc
+from plugins.kanban.dashboard import board_read as br
+from plugins.kanban.dashboard import board_rows
+from tests.plugins import test_kanban_board_incremental as helpers
+
+board = helpers.board
+
+
+def test_write_free_get_skips_materialize_but_projects(board, monkeypatch):
+    helpers._seed()
+    first = helpers._read(board)
+    calls = []
+    real = br.materialize
+    monkeypatch.setattr(br, "materialize", lambda *a, **k: calls.append(1) or real(*a, **k))
+    projected = []
+    real_project = br.project
+    monkeypatch.setattr(br, "project", lambda *a, **k: projected.append(1) or real_project(*a, **k))
+    second = helpers._read(board)
+    assert helpers._stable(first) == helpers._stable(second)
+    assert not calls, "unchanged observer generation+commit must reuse SQL rows"
+    assert projected == [1], "clock/config/replica projection must never be memoized"
+
+
+def test_bookkeeping_commit_rearms_overlay(board, monkeypatch):
+    ids, run_id = helpers._seed()
+    helpers._read(board)
+    calls = []
+    real = br.materialize
+    monkeypatch.setattr(br, "materialize", lambda *a, **k: calls.append(1) or real(*a, **k))
+    conn = kbc.connect()
+    try:
+        conn.execute("UPDATE tasks SET last_heartbeat_at=12345 WHERE id=?", (ids[0],))
+        conn.execute("UPDATE task_runs SET worker_pid=987 WHERE id=?", (run_id,))
+        conn.commit()
+    finally:
+        conn.close()
+    after = helpers._stable(helpers._read(board))
+    assert calls == [1]
+    assert next(t for c in after['columns'] for t in c['tasks'] if t['id'] == ids[0])['last_heartbeat_at'] == 12345
+    assert after == helpers._cold(board)
+
+
+def test_observer_reset_never_reuses_prior_generation(board, monkeypatch):
+    helpers._seed()
+    helpers._read(board)
+    board_rows.clear()
+    calls = []
+    real = br.materialize
+    monkeypatch.setattr(br, "materialize", lambda *a, **k: calls.append(k.get('prev')) or real(*a, **k))
+    helpers._read(board)
+    assert calls == [None]
+
+
+def test_write_free_reuse_keeps_clock_and_profiles_live(board, monkeypatch):
+    from hermes_cli import kanban_db as kb
+    helpers._seed()
+    clock = [10000000000]
+    monkeypatch.setattr(br.time, "time", lambda: clock[0])
+    monkeypatch.setattr(kb, "list_profiles_on_disk", lambda: ["first-profile"])
+    first = helpers._read(board)
+    calls = []
+    real = br.materialize
+    monkeypatch.setattr(br, "materialize", lambda *a, **k: calls.append(1) or real(*a, **k))
+    clock[0] += 60
+    monkeypatch.setattr(kb, "list_profiles_on_disk", lambda: ["second-profile"])
+    second = helpers._read(board)
+    assert not calls
+    assert second["now"] == first["now"] + 60
+    assert "second-profile" in second["assignees"]
+    assert "first-profile" not in second["assignees"]
+    old = {t["id"]: t for c in first["columns"] for t in c["tasks"]}
+    for col in second["columns"]:
+        for task in col["tasks"]:
+            assert task["age"]["created_age_seconds"] == old[task["id"]]["age"]["created_age_seconds"] + 60
+
+
+def test_schema_change_forces_materialize(board, monkeypatch):
+    helpers._seed()
+    helpers._read(board)
+    calls = []
+    real = br.materialize
+    monkeypatch.setattr(br, "materialize", lambda *a, **k: calls.append(1) or real(*a, **k))
+    conn = kbc.connect()
+    try:
+        conn.execute("CREATE TABLE commit_reuse_schema_test (value)")
+        conn.commit()
+    finally:
+        conn.close()
+    result = helpers._read(board)
+    assert calls == [1]
+    assert helpers._stable(result) == helpers._cold(board)
