diff --git a/hermes_cli/kanban_placement_provenance.py b/hermes_cli/kanban_placement_provenance.py
new file mode 100644
index 0000000000000000000000000000000000000000..d82db8d539bff552e9617c0c6e52dd39dc43b05f
--- /dev/null
+++ b/hermes_cli/kanban_placement_provenance.py
@@ -0,0 +1,37 @@
+"""Discover a forwarding creator identity; the origin gateway authenticates it.
+
+Replica ownership is a routing hint, not permission. Only the origin-local
+binding plus the server-owned lease can authorize the resulting request.
+"""
+from __future__ import annotations
+
+from hermes_cli import kanban_db_sync as sync
+from hermes_cli.kanban_execution_observations import board_owner_profile
+from hermes_cli.kanban_origin import _replica_task_owners
+from hermes_cli.kanban_placement_forward import opened_board
+
+
+def forwarding_authority(conn, task_id, run_id, *, self_gw):
+    """Require evidenced owner namespace and portable run identity, never guess."""
+    if conn is None or not task_id or not self_gw:
+        raise ValueError("origin_forward_creator_unknown")
+    board = opened_board(conn)
+    cols = sync.table_columns(conn, "tasks")
+    if "created_on" not in cols:
+        raise ValueError("origin_forward_creator_unknown")
+    row = conn.execute("SELECT created_on FROM tasks WHERE id=?", (task_id,)).fetchone()
+    gateway = row[0] if row else None
+    if not gateway:
+        raise ValueError("origin_forward_creator_unknown")
+    if gateway == self_gw:
+        path = sync._db_key(conn)
+        profile = board_owner_profile(path) if path else None
+    else:
+        profiles = {profile for gw, profile in _replica_task_owners(task_id, board) if gw == gateway}
+        profile = next(iter(profiles)) if len(profiles) == 1 else None
+    run = conn.execute("SELECT task_id FROM task_runs WHERE id=?", (run_id,)).fetchone()
+    uid = sync.run_uid(conn, run_id) if run and run[0] == task_id else None
+    if not profile or not uid:
+        raise ValueError("origin_forward_creator_unknown")
+    return {"creator": {"gateway": gateway, "profile": profile, "board": board, "task_id": task_id},
+            "run_uid": uid}
diff --git a/tests/hermes_cli/test_placement_provenance.py b/tests/hermes_cli/test_placement_provenance.py
new file mode 100644
index 0000000000000000000000000000000000000000..7f92e3553f81f9776adc3b095e5f9d4794946137
--- /dev/null
+++ b/tests/hermes_cli/test_placement_provenance.py
@@ -0,0 +1,56 @@
+"""Foreign creator discovery never substitutes the executing worker namespace."""
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_placement_provenance as provenance
+
+
+@pytest.fixture
+def db(monkeypatch):
+    conn = sqlite3.connect(":memory:")
+    conn.executescript("CREATE TABLE tasks(id TEXT, created_on TEXT);"
+                       "CREATE TABLE task_runs(id INTEGER, task_id TEXT, uid TEXT);"
+                       "INSERT INTO tasks VALUES ('t_creator','hub');"
+                       "INSERT INTO task_runs VALUES (7,'t_creator','run-portable');")
+    monkeypatch.setattr(provenance, "opened_board", lambda c: "research")
+    monkeypatch.setattr(provenance.sync, "board_mode", lambda c: "primary")
+    monkeypatch.setattr(provenance, "_replica_task_owners", lambda t, b: [("hub", "owner-profile")])
+    yield conn
+    conn.close()
+
+
+def test_exact_foreign_owner_and_run(db):
+    assert provenance.forwarding_authority(db, "t_creator", 7, self_gw="worker-7") == {
+        "creator": {"gateway": "hub", "profile": "owner-profile", "board": "research", "task_id": "t_creator"},
+        "run_uid": "run-portable"}
+
+
+@pytest.mark.parametrize("owners", [[], [("other", "default")], [("hub", "a"), ("hub", "b")]])
+def test_unknown_or_ambiguous_owner_never_uses_worker_profile(db, monkeypatch, owners):
+    monkeypatch.setattr(provenance, "_replica_task_owners", lambda t, b: owners)
+    with pytest.raises(ValueError, match="creator_unknown"):
+        provenance.forwarding_authority(db, "t_creator", 7, self_gw="worker-7")
+
+
+@pytest.mark.parametrize("change", ["UPDATE tasks SET created_on=NULL", "DELETE FROM tasks",
+                                    "UPDATE task_runs SET task_id='t_other'", "UPDATE task_runs SET uid=NULL",
+                                    "DELETE FROM task_runs"])
+def test_unknown_owner_or_run_refuses(db, change):
+    db.execute(change)
+    with pytest.raises(ValueError, match="creator_unknown"):
+        provenance.forwarding_authority(db, "t_creator", 7, self_gw="worker-7")
+
+
+def test_local_owner_uses_board_namespace_not_active_profile(db, monkeypatch):
+    db.execute("UPDATE tasks SET created_on='worker-7'")
+    monkeypatch.setattr(provenance.sync, "_db_key", lambda c: "/evidenced/board.db")
+    monkeypatch.setattr(provenance, "board_owner_profile", lambda p: "board-profile")
+    result = provenance.forwarding_authority(db, "t_creator", 7, self_gw="worker-7")
+    assert result["creator"]["profile"] == "board-profile"
+
+
+def test_unsynced_run_is_not_authority(db, monkeypatch):
+    monkeypatch.setattr(provenance.sync, "board_mode", lambda c: "off")
+    with pytest.raises(ValueError, match="creator_unknown"):
+        provenance.forwarding_authority(db, "t_creator", 7, self_gw="worker-7")
