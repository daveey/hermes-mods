From 2450be6e088fa0e0ba5aa11f9b18ec28c4096257 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:00:46 -0800
Subject: [PATCH] test(tui-gateway): the _make_agent stubs take the session id
 the resolver now receives [daveey]

tests/tui_gateway/test_start_toolsets.py stubbed _resolve_agent_model_runtime with a two-argument lambda;
_make_agent now passes the session id it builds as a third argument (the wall reroute needs it), so four tests
failed with a TypeError on the hub run of the 226 files that touch these modules (3,177 passed, these 4 failed).
The stubs accept the argument; no assertion changed.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 tests/tui_gateway/test_start_toolsets.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/tui_gateway/test_start_toolsets.py b/tests/tui_gateway/test_start_toolsets.py
index 7c6b83446f..651d7affd2 100644
--- a/tests/tui_gateway/test_start_toolsets.py
+++ b/tests/tui_gateway/test_start_toolsets.py
@@ -155,7 +155,7 @@ def _build(monkeypatch, store, key, wide=("terminal", "file", "code_execution"))
     monkeypatch.setattr(server, "_load_enabled_toolsets", lambda platform=None: list(wide))
     monkeypatch.setattr(server, "_agent_cbs", lambda sid: {})
     monkeypatch.setattr(server, "_startup_system_prompt", lambda cfg, key: "")
-    monkeypatch.setattr(server, "_resolve_agent_model_runtime", lambda m, p: ("model", {}))
+    monkeypatch.setattr(server, "_resolve_agent_model_runtime", lambda m, p, session=None: ("model", {}))
     monkeypatch.setattr(server, "_load_cfg", dict)
     monkeypatch.setattr(server, "_resolve_agent_platform", lambda p=None: "desktop")
     return server._make_agent("sid", key, session_id=key, session_db=store.db)
@@ -186,7 +186,7 @@ def test_no_session_store_means_no_pin_and_the_build_proceeds(monkeypatch, store
     monkeypatch.setattr(server, "_load_enabled_toolsets", lambda platform=None: ["terminal"])
     monkeypatch.setattr(server, "_agent_cbs", lambda sid: {})
     monkeypatch.setattr(server, "_startup_system_prompt", lambda cfg, key: "")
-    monkeypatch.setattr(server, "_resolve_agent_model_runtime", lambda m, p: ("model", {}))
+    monkeypatch.setattr(server, "_resolve_agent_model_runtime", lambda m, p, session=None: ("model", {}))
     monkeypatch.setattr(server, "_load_cfg", dict)
     monkeypatch.setattr(server, "_resolve_agent_platform", lambda p=None: "desktop")
     agent = server._make_agent("sid", "no-db")
-- 
