+                raise AnnotationUnavailable('annotation projection contract mismatch')
+            if 'execution_observations' in patch:
+                allowed = SOURCES.get(family, frozenset())
+                if family == 'kanban':
+                    allowed = allowed | {'kanban.replica_run'}
