new file mode 100644
index 00000000000..c791e62fffd
--- /dev/null
+++ b/hermes_cli/fact_annotation_views.py
@@ -0,0 +1,58 @@
+"""Canonical selector-aware annotation projections for native startup. [daveey]
+
+SessionFact remains the default consumer contract. Native startup explicitly
+selects variant ViewFacts; these do not mislabel scalar session rows as complete
+annotations. Only families with real capture contracts register here.
+"""
+from hermes_cli.fact_contract import FactKey
+from hermes_cli.fact_materializers import Projection
+
+
+def selector_for(scope, row, *, display=False):
+    """One identity for lookup AND demand; no paths or prior stamps from callers."""
+    if type(display) is not bool:
+        raise ValueError('annotation display must be boolean')
+    profile = row.get('profile', scope.profile_id)
+    if profile != scope.profile_id:
+        raise ValueError('annotation profile mismatch')
+    identity = {'id': row['id'], 'profile': profile}
+    if not isinstance(identity['id'], str) or not identity['id']:
+        raise ValueError('annotation session id required')
+    if '_lineage_root_id' in row:
+        root = row['_lineage_root_id']
+        if root is not None and not isinstance(root, str):
+            raise ValueError('invalid lineage root')
+        identity['_lineage_root_id'] = root
+    if '_lineage_ids' in row:
+        lineage = row['_lineage_ids']
+        if lineage is not None and (not isinstance(lineage, (tuple, list))
+                                   or any(not isinstance(item, str) for item in lineage)):
+            raise ValueError('invalid lineage ids')
+        identity['_lineage_ids'] = None if lineage is None else list(lineage)
+    return {'row': identity, 'display': display}
+
+
+def _membership_projection(family, field, project, argument):
+    def dependencies(scope, selector, snapshot):
+        # Also validates identities arriving through direct owner demands.
+        if selector != selector_for(scope, selector['row'], display=selector['display']):
+            raise ValueError('invalid annotation selector')
+        return {FactKey(scope, 'AnnotationInput', family)}
+
+    def render(selector, facts, now):
+        captured = next(iter(facts.values())).value
+        row = dict(selector['row'])
+        project([row], captured[argument])
+        return {field: row[field]} if field in row else {}
+
+    return Projection('annotations.' + family, ('AnnotationInput',), dependencies, render)
+
+
+def projections():
+    """Register captured goal/cron families, never silently empty other families."""
+    from hermes_cli.goal_session_activity import project_goal_activity
+    from hermes_cli.cron_session_activity import project_cron_activity
+    return (
+        _membership_projection('goal', 'goal_active', project_goal_activity, 'active'),
+        _membership_projection('cron', 'cron_active', project_cron_activity, 'owners'),
+    )
diff --git a/hermes_cli/fact_bootstrap.py b/hermes_cli/fact_bootstrap.py
new file mode 100644
index 00000000000..7eabf44a8b7
--- /dev/null
+++ b/hermes_cli/fact_bootstrap.py
@@ -0,0 +1,139 @@
+"""Source-owned task bootstrap pages; never expose a partial generation. [daveey]"""
+from dataclasses import replace
+
+from hermes_cli.fact_capture import (
+    CaptureBudgetExceeded, CapturePending, CaptureRefused, capture_tasks, payload_bytes,
+)
+
+
+class PagedBootstrap:
+    """Stage keyset pages then indexed closed dirty windows before publication.
+
+    Failed reads retain safe staged pages. Lost coverage resets only staging.
+    Completed captures remain cached for a failed publication. The candidate
+    cap latches an explicit error until source revision or capacity changes,
+    avoiding repeated full rescans for unchanged oversized input.
+    Scalar byte bounds are not a Python RSS guarantee.
+    """
+    def __init__(self, path, hydrate, *, capture=capture_tasks, max_candidate_bytes=64 * 1024 * 1024):
+        self.path, self.hydrate = path, hydrate
+        self._capture = capture
+        self.max_candidate_bytes = max_candidate_bytes
+        self.reset()
+
+    def reset(self):
+        self.anchor = None
+        self.before = None
+        self.last_id = ""
+        self.rows = {}
+        self.sizes = {}
+        self.size = 0
+        self.replay = False
+        self.ready = None
+        self.fence = None
+        self.position = None
+        self.page_keys = None
+        self.fast_pages = 0
+        self.error = None
+        self.capped_at = None
+        self.capped_limit = None
+
+    def _apply(self, capture):
+        updates = {row["id"]: row for row in capture.records}
+        if len(updates) != len(capture.records) or not updates.keys() <= set(capture.ids):
+            raise CaptureRefused("hydrator returned duplicate or unrequested tasks")
+        sizes = {key: payload_bytes(key) + payload_bytes(row) for key, row in updates.items()}
+        size = self.size - sum(self.sizes.get(key, 0) for key in capture.ids) + sum(sizes.values())
+        if size > self.max_candidate_bytes:
+            self.reset()
+            self.error = "bootstrap candidate byte budget exceeded"
+            self.capped_at = capture.after
+            self.capped_limit = self.max_candidate_bytes
+            raise CaptureRefused(self.error)
+        for key in capture.ids:
+            self.rows.pop(key, None)
+            self.sizes.pop(key, None)
+        self.rows.update(updates)
+        self.sizes.update(sizes)
+        self.size = size
+
+    def _step(self, budget):
+        if not self.replay:
+            result = self._capture(self.path, self.anchor, self.hydrate,
+                                   budget=budget, page_after=self.last_id)
+            self._observe_page(result, budget)
+            if self.anchor is None:
+                self.anchor = result.after
+            self._apply(result)
+            if result.ids:
+                self.last_id = result.ids[-1]
+            self.replay = len(result.ids) < budget.max_keys
+            return None
+        result = self._capture(self.path, self.anchor, self.hydrate, budget=budget,
+                               replay=True, replay_fence=self.fence, replay_position=self.position)
+        self._observe_page(result, budget)
+        self._apply(result)
+        self.fence, self.position = result.replay_fence, result.replay_position
+        if not result.replay_done:
+            return None
+        if result.after != self.fence:
+            # Writes after the fence may have moved marks out of this window.
+            # Replay those before claiming the staged generation is coherent.
+            self.anchor, self.fence, self.position = self.fence, None, None
+            return None
+        keys = tuple(sorted(self.rows))
+        self.ready = replace(result, before=self.before, full=True, ids=keys,
+                             records=tuple(self.rows[key] for key in keys), payload_bytes=self.size)
+        return self.ready
+
+    def _observe_page(self, result, budget):
+        if (result.transaction_seconds < budget.max_seconds / 4
+                and result.payload_bytes < budget.max_bytes / 4):
+            self.fast_pages += 1
+            if self.fast_pages >= 4:
+                self.page_keys = budget.max_keys * 2
+                self.fast_pages = 0
+        else:
+            self.fast_pages = 0
+
+    def capture(self, cursor, budget):
+        if self.error:
+            # Failure retries probe one bounded revision window, never hydrate
+            # or rescan the candidate. Real source changes can recover quietly.
+            try:
+                probe = self._capture(self.path, self.capped_at, lambda conn, ids: (),
+                                      budget=replace(budget, max_keys=1), replay=True)
+            except CaptureBudgetExceeded:
+                raise
+            except CaptureRefused:
+                self.reset()
+                raise
+            if probe.after == self.capped_at and self.capped_limit == self.max_candidate_bytes:
+                raise CaptureRefused(self.error)
+            self.reset()
+        if self.ready is not None:
+            if cursor == self.before:
+                return self.ready
+            if cursor != self.ready.after:
+                raise CaptureRefused("unexpected bootstrap caller cursor")
+            self.reset()
+        if self.anchor is not None and cursor != self.before:
+            raise CaptureRefused("unexpected bootstrap caller cursor")
+        if self.anchor is None:
+            self.before = cursor
+        page_budget = replace(budget, max_keys=min(budget.max_keys, self.page_keys or budget.max_keys))
+        try:
+            result = self._step(page_budget)
+        except CaptureBudgetExceeded:
+            if page_budget.max_keys == 1:
+                raise
+            self.fast_pages = 0
+            self.page_keys = max(1, page_budget.max_keys // 2)
+            raise CapturePending("retry smaller task bootstrap page") from None
+        except CaptureRefused:
+            if not self.error:
+                self.reset()
+            raise
+        if result is not None:
+            return result
+        raise CapturePending("task bootstrap page captured")
diff --git a/hermes_cli/fact_capture.py b/hermes_cli/fact_capture.py
new file mode 100644
index 00000000000..7daf4b2b268
--- /dev/null
+++ b/hermes_cli/fact_capture.py
@@ -0,0 +1,167 @@
+"""Guarded, bounded task-content capture for the projection owner. [daveey]
+
+This is a transaction primitive, not a complete TaskFact adapter: hydrate must
+select only declared content inputs covered by the task cursor. Operational and
+external inputs need their own revisions. Large FULLs are explicitly refused
+until the paged bootstrap/replay owner can handle them; never publish a prefix.
+"""
+from __future__ import annotations
+
+import sqlite3
+import time
+from collections.abc import Callable, Iterable, Mapping
+from contextlib import closing
+from dataclasses import dataclass
+from pathlib import Path
+
+from hermes_cli import kanban_task_change as changes
+from hermes_cli.fact_contract import freeze
+from hermes_cli.kanban_generation import open_ro
+from hermes_cli.kanban_lockguard import shm_identity
+
+
+class CapturePending(RuntimeError):
+    """A bounded page completed; reschedule without publication or cursor advance."""
+
+
+class CaptureRefused(RuntimeError):
+    """Discard this entire capture; the caller retains its last published cursor."""
+
+
+class CaptureOverflow(CaptureRefused):
+    """A full generation needs source-owned pagination."""
+
+
+class CaptureBudgetExceeded(CaptureRefused):
+    """A smaller page may satisfy this transaction's time/byte budget."""
+
+
+@dataclass(frozen=True)
+class CaptureBudget:
+    max_keys: int = 2000
+    max_seconds: float = 0.020
+    max_bytes: int = 4 * 1024 * 1024
+
+    def __post_init__(self):
+        if not 1 <= self.max_keys <= 2000 or self.max_seconds <= 0 or self.max_bytes < 1:
+            raise ValueError("invalid capture budget")
+
+
+@dataclass(frozen=True)
+class TaskCapture:
+    before: changes.Cursor | None
+    after: changes.Cursor | None
+    full: bool
+    ids: tuple[str, ...]
+    records: tuple[Mapping, ...]
+    observed_at: float
+    transaction_seconds: float
+    payload_bytes: int = 0
+    replay_fence: changes.Cursor | None = None
+    replay_position: tuple | None = None
+    replay_done: bool = False
+
+
+def _identity(path: Path):
+    stat = path.stat()
+    return stat.st_dev, stat.st_ino, shm_identity(path)
+
+
+def payload_bytes(value):
+    """Raw scalar payload bound, not a claim about Python RSS or encoded views."""
+    if isinstance(value, Mapping):
+        return 8 + sum(payload_bytes(k) + payload_bytes(v) for k, v in value.items())
+    if isinstance(value, (tuple, list)):
+        return sum(payload_bytes(item) for item in value)
+    if isinstance(value, str):
+        return len(value.encode("utf-8"))
+    if isinstance(value, bytes):
+        return len(value)
+    if value is None or isinstance(value, (bool, int, float)):
+        return 8
+    raise TypeError("capture hydrators must return raw SQLite scalars")
+
+
+def capture_tasks(path: Path, cursor: changes.Cursor | None,
+                  hydrate: Callable[..., Iterable[Mapping]], *,
+                  budget: CaptureBudget = CaptureBudget(),
+                  page_after: str | None = None,
+                  replay: bool = False, replay_fence=None, replay_position=None) -> TaskCapture:
+    """Capture cursor and raw inputs in one snapshot, closing before return.
+
+    hydrate runs on batches of at most 500 ids; absence is represented by ids
+    without a corresponding row. A FULL replaces source membership, whereas a
+    delta's missing rows are tombstones. No cursor is installed here: only the
+    owner may advance it after successful source+derived publication.
+    """
+    from hermes_state_guard import ensure_kanban_test_isolation
+
+    path = Path(path).resolve()
+    ensure_kanban_test_isolation(path)
+    initial = path.stat()
+    with closing(open_ro(path, timeout=0)) as conn:
+        # SQLite refuses oversized rows before Python allocates their values.
+        conn.setlimit(sqlite3.SQLITE_LIMIT_LENGTH, budget.max_bytes)
+        before = _identity(path)
+        if before[:2] != (initial.st_dev, initial.st_ino):
+            raise CaptureRefused("source generation changed while opening")
+        started = time.monotonic()
+        deadline = started + budget.max_seconds
+        conn.set_progress_handler(lambda: int(time.monotonic() >= deadline), 1000)
+        conn.execute("BEGIN")
+        try:
+            from hermes_cli import fact_task_replay
+            if replay:
+                ids, after, replay_fence, replay_position = fact_task_replay.page(
+                    conn, cursor, replay_position, replay_fence, budget.max_keys)
+                full = False
+            elif page_after is not None:
+                after = fact_task_replay.coverage(conn, cursor)
+                full = True
+                ids = tuple(row[0] for row in conn.execute(
+                    "SELECT id FROM tasks WHERE id > ? ORDER BY id LIMIT ?",
+                    (page_after, budget.max_keys)))
+            else:
+                dirty, after = changes.changed_since(conn, cursor, limit=budget.max_keys)
+                full = dirty is changes.FULL or len(dirty) > budget.max_keys
+                if full:
+                    ids = tuple(row[0] for row in conn.execute(
+                        "SELECT id FROM tasks ORDER BY id LIMIT ?", (budget.max_keys + 1,)))
+                else:
+                    ids = tuple(sorted(dirty))
+            if len(ids) > budget.max_keys:
+                raise CaptureOverflow("keys budget exceeded; continuation required")
+            records = []
+            size = payload_bytes(ids)
+            if size > budget.max_bytes:
+                raise CaptureBudgetExceeded("capture byte budget exceeded")
+            for offset in range(0, len(ids), 500):
+                if time.monotonic() >= deadline:
+                    raise CaptureBudgetExceeded("transaction time budget exceeded")
+                for row in hydrate(conn, ids[offset:offset + 500]):
+                    size += payload_bytes(row)
+                    if size > budget.max_bytes:
+                        raise CaptureBudgetExceeded("capture byte budget exceeded")
+                    records.append(row)
+            # Recheck after caller hydration, within the SAME snapshot. Ordinary
+            # concurrent WAL commits cannot advance this cursor; replacement can.
+            _dirty, verified = changes.changed_since(conn, after, limit=budget.max_keys)
+            if verified != after or _identity(path) != before:
+                raise CaptureRefused("source generation changed during capture")
+            if time.monotonic() >= deadline:
+                raise CaptureBudgetExceeded("transaction time budget exceeded")
+            conn.execute("COMMIT")
+            elapsed = time.monotonic() - started
+        except sqlite3.OperationalError as exc:
+            if getattr(exc, "sqlite_errorcode", None) == sqlite3.SQLITE_INTERRUPT:
+                raise CaptureBudgetExceeded("transaction time budget exceeded") from exc
+            raise
+        finally:
+            conn.set_progress_handler(None, 0)
+            if conn.in_transaction:
+                conn.execute("ROLLBACK")
+    # Detach/freeze only after SQLite custody has ended. Hydrators return raw
+    # scalars, not lazy generators or SQL handles stored in records.
+    return TaskCapture(cursor, after, full, ids, tuple(freeze(row) for row in records),
+                       time.time(), elapsed, size, replay_fence, replay_position,
+                       replay and len(ids) < budget.max_keys)
diff --git a/hermes_cli/fact_content_owner.py b/hermes_cli/fact_content_owner.py
new file mode 100644
index 00000000000..7fdc12abf5f
--- /dev/null
+++ b/hermes_cli/fact_content_owner.py
@@ -0,0 +1,106 @@
+"""Authorized native content adapters composed with the shared owner. [daveey]
+
+No discovery and no activation: trusted startup supplies sources, their scalar
+hydrators and the scope engines. Registrations are fixed before the thread
+starts. This is the task/session content slice, not external/operational inputs
+or a declaration that consumer TaskFact/SessionFact schemas are ready.
+"""
+from dataclasses import dataclass
+
+from hermes_cli.fact_capture import CaptureBudget
+from hermes_cli.fact_feed import ChangeFeed
+from hermes_cli.fact_demand_source import DemandSource
+from hermes_cli.fact_content_rows import task_rows, session_rows
+from hermes_cli.fact_session_source import SessionContentSource
+from hermes_cli.fact_source_commit import SourcePublisher
+from hermes_cli.fact_task_source import TaskContentSource
+
+
+@dataclass(frozen=True)
+class ContentBinding:
+    source: object
+    path: object
+    hydrate: object = None
+
+
+class ContentStartupError(RuntimeError):
+    """Failed startup whose cleanup must be retried through ``owner.close()``."""
+    def __init__(self, owner):
+        super().__init__('content startup failed; cleanup custody retained')
+        self.owner = owner
+
+
+class ContentOwner:
+    """One ChangeFeed thread across all authorized board/shadow/session inputs.
+
+    Engines must be fully configured before construction and thereafter mutated
+    only by this feed. Runtime demands use bounded mailboxes on that same thread;
+    discovery and production projection registration remain startup obligations.
+    Engines can share one FactStore; a source capture and its affected outputs
+    are one atomic generation, not a cross-database snapshot guarantee.
+    """
+    def __init__(self, engines, bindings, *, budget=CaptureBudget(), operational=()):
+        self._publishers = {}
+        self._by_source = {}
+        for binding in bindings:
+            source = binding.source
+            if source in self._by_source:
+                raise ValueError('duplicate source identity')
+            if source.scope not in engines:
+                raise ValueError('unauthorized source scope')
+            if source.kind == 'tasks.content':
+                adapter_type, kind, rows = TaskContentSource, 'TaskContentInput', task_rows
+            elif source.kind == 'sessions.content':
+                adapter_type, kind, rows = SessionContentSource, 'SessionContentInput', session_rows
+            else:
+                raise ValueError('unsupported content source kind')
+            adapter = adapter_type(source, binding.path, rows if binding.hydrate is None else binding.hydrate)
+            publisher = SourcePublisher(engines[source.scope], source, kind)
+            self._publishers[adapter] = publisher
+            self._by_source[source] = publisher
+        for adapter in operational:
+            if engines.get(adapter.source.scope) is not adapter.engine:
+                raise ValueError('unauthorized operational engine')
+            if adapter.source in self._by_source:
+                raise ValueError('duplicate source identity')
+            if any(getattr(item, 'key', None) == adapter.key for item in self._publishers):
+                raise ValueError('duplicate operational output key')
+            self._publishers[adapter] = adapter
+            self._by_source[adapter.source] = adapter
+        if not self._publishers:
+            raise ValueError('empty content source set')
+        self._demands = {scope: DemandSource(engine) for scope, engine in engines.items()}
+        self._publishers.update((source, source) for source in self._demands.values())
+        self.feed = ChangeFeed(self._commit, self._failure, budget=budget)
+        try:
+            for adapter in self._publishers:
+                self.feed.register(adapter)
+        except Exception:  # health: allow BLE001 -- construction unwind retains owner custody on failure
+            try:
+                self.feed.close()
+            except Exception as cleanup_error:  # health: allow BLE001 -- attach exact owner for cleanup retry
+                raise ContentStartupError(self) from cleanup_error
+            raise
+
+    def publisher(self, source):
+        """Startup key/metadata seam, not a request-side source resolver."""
+        return self._by_source[source]
+
+    def _commit(self, adapter, capture):
+        self._publishers[adapter].commit(capture)
+
+    def _failure(self, adapter, error):
+        self._publishers[adapter].failure()
+
+    def demand(self, scope, view, selector):
+        """Authorize and enqueue only; reduction never runs on the caller thread."""
+        if scope not in self._demands:
+            raise ValueError('unauthorized demand scope')
+        if not self.feed._thread.is_alive():
+            raise RuntimeError('content owner closed or unavailable')
+        self._demands[scope].demand(view, selector)
+
+    def close(self):
+        for source in self._demands.values():
+            source.close()
+        self.feed.close()
diff --git a/hermes_cli/fact_content_rows.py b/hermes_cli/fact_content_rows.py
new file mode 100644
index 00000000000..87bf543cec8
--- /dev/null
+++ b/hermes_cli/fact_content_rows.py
@@ -0,0 +1,36 @@
+"""Bounded scalar inputs covered by the native task/session clocks. [daveey]
+
+These are content inputs, NOT full board/annotation payloads. Related task tables
+and operational fields need separate declared hydration/revision coverage; do not
+silently use these rows as complete TaskFact/SessionFact schemas. No transcript
+bodies, filesystem discovery, external calls or connection lifetime live here.
+"""
+from hermes_cli.kanban_activity_revision import BOOKKEEPING_COLUMNS
+
+
+def _rows(conn, ids, table, excluded):
+    if not conn.in_transaction:
+        raise ValueError('content hydration requires capture transaction')
+    if not ids:
+        return ()
+    if len(ids) > 500 or any(type(identity) is not str for identity in ids):
+        raise ValueError('invalid hydration id batch')
+    # Table is chosen exclusively by the two fixed entrypoints below; quote
+    # schema-derived column identifiers rather than trusting future migrations.
+    columns = [row[1] for row in conn.execute(f'PRAGMA table_info({table})') if row[1] not in excluded]
+    if 'id' not in columns:
+        raise ValueError('content table lacks identity')
+    names = ','.join('"' + name.replace('"', '""') + '"' for name in columns)
+    placeholders = ','.join('?' for _ in ids)
+    result = conn.execute(f'SELECT {names} FROM {table} WHERE id IN ({placeholders}) ORDER BY id', ids)
+    return (dict(zip(columns, row)) for row in result)
+
+
+def task_rows(conn, ids):
+    """All task scalar columns except canonical cursor-excluded bookkeeping."""
+    return _rows(conn, ids, 'tasks', BOOKKEEPING_COLUMNS['tasks'])
+
+
+def session_rows(conn, ids):
+    """Listing + content clocks jointly cover every session scalar column."""
+    return _rows(conn, ids, 'sessions', frozenset())
