+
+def test_selector_retains_all_filter_dimensions():
+    assert board_selector("tenant", True, "workflow", "step", 0) == {
+        "tenant": "tenant", "include_archived": True,
+        "workflow_template_id": "workflow", "current_step_key": "step", "done_limit": 0}
+
