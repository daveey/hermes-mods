new file mode 100644
index 00000000000..42c81389544
--- /dev/null
+++ b/tui_gateway/notification_loaded_executor.py
@@ -0,0 +1,204 @@
+"""f-only cooperative executor for loaded-session notification pollers. [daveey]
+
+With ``display.loaded_notification_f`` ON no chat owns an OS thread. One daemon
+thread per completion queue (one per process in production) advances every
+loaded session's poller *generator* (``_notification_poller_lane_steps``). A
+generator yields ``(timeout, wake_generation)`` exactly where the legacy thread
+called ``take_ready(queue, timeout, wake_generation=...)``; this executor waits
+on that same queue condition and resumes a lane with ``take_ready(queue, 0)``
+once its legacy wait would have returned (queued event, wake generation moved
+on, timeout elapsed). The legacy blocking driver runs the same generators, so
+completion, producer, parked, held, heartbeat/loop and cleanup obligations are
+the same code in both modes.
+
+Per-lane identity is carried explicitly in a ContextVar for consumer-health
+receipts. The OS thread registry is never modified. Each step runs in the
+lane's own context, isolating the profile runtime scope per session.
+
+Steps are serialized: a lane blocked inside an existing bounded action (a
+submit, a board read) delays the other lanes but never drops custody: its
+events are in in-flight custody, everyone else's are still queued or held.
+"""
+from __future__ import annotations
+
+import contextvars
+import logging
+import threading
+import time
+import weakref
+from typing import Any
+
+log = logging.getLogger(__name__)
+
+EXECUTOR_THREAD_NAME = "tui-notif-executor"
+
+_current_lane: contextvars.ContextVar[Any] = contextvars.ContextVar("notification_lane", default=None)
+_lock = threading.Lock()
+_executors: weakref.WeakKeyDictionary = weakref.WeakKeyDictionary()
+
+
+class Lane(threading.Thread):
+    """One loaded session's poller identity. Never started as an OS thread.
+
+    Duck-types the ``threading.Thread`` surface the poller bookkeeping uses
+    (``name``, ``ident``, ``is_alive``, ``join``): ``_notification_pollers``
+    reapers, ``kanban_consumer_health`` and ``process_consumer_health``.
+    """
+
+    _notif_lane = True
+
+    def __init__(self, sid: str, stop: threading.Event):
+        super().__init__(name=f"tui-notif-poller-{sid}", daemon=True)
+        self.sid = sid
+        self.stop_event = stop
+        self.context = contextvars.Context()
+        self.done = threading.Event()
+        self.executor: Executor | None = None
+        self.steps: Any = None
+        self.factory: Any = None
+        self.deadline: float | None = None  # None: never advanced yet, run now
+        self.wake_generation = None
+        self._admitted_ident: int | None = None
+
+    @property
+    def ident(self):
+        # None until admitted (like an unstarted thread), then the executor's ident for good,
+        # so kanban_consumer_health prunes a finished lane exactly like a dead thread.
+        return self._admitted_ident
+
+    def is_alive(self) -> bool:
+        return self.executor is not None and not self.done.is_set()
+
+    def start(self):  # pragma: no cover - misuse guard
+        raise RuntimeError("a notification lane is advanced by its executor, never started")
+
+    def join(self, timeout=None):
+        executor = self.executor
+        if executor is not None and executor.thread is not None and threading.get_ident() == executor.thread.ident:
+            raise RuntimeError("cannot join a notification lane from its own executor")
+        self.done.wait(timeout)
+
+    def _runnable(self, now: float, generation, queued: bool) -> bool:
+        # Mirrors take_ready's wait predicate: it returns at once when the queue
+        # is non-empty, the timeout is zero, or the wake generation moved on.
+        return (self.deadline is None or queued or now >= self.deadline
+                or generation != self.wake_generation)
+
+
+class Executor:
+    """Serialized cooperative executor bound to one completion queue's condition."""
+
+    def __init__(self, queue):
+        self.queue = queue
+        self.lanes: list[Lane] = []
+        self.thread: threading.Thread | None = None
+
+    def add(self, lane: Lane, factory) -> None:
+        cond = self.queue.not_empty
+        with cond:
+            lane.executor = self
+            lane.factory = factory
+            self.lanes.append(lane)
+            if self.thread is None:
+                # Scope-free by design: every lane step runs in that lane's own context.
+                thread = threading.Thread(  # health: allow HX012 -- lanes carry their own contexts
+                    target=self._run, name=EXECUTOR_THREAD_NAME, daemon=True)
+                self.thread = thread
+                thread._notif_executor = self  # type: ignore[attr-defined]
+                thread.start()
+            lane._admitted_ident = self.thread.ident
+            cond.notify_all()
+
+    # -- loop ------------------------------------------------------------------------------------------------------
+    def _run(self) -> None:
+        me = threading.current_thread()
+        cond = self.queue.not_empty
+        while True:
+            with cond:
+                while True:
+                    if not self.lanes:
+                        if self.thread is me:
+                            self.thread = None  # the next add() starts a fresh executor
+                        return
+                    now = time.monotonic()
+                    generation = getattr(self.queue, "_notification_generation", 0)
+                    queued = bool(self.queue._qsize())
+                    runnable = [lane for lane in self.lanes if lane._runnable(now, generation, queued)]
+                    if runnable:
+                        break
+                    deadlines = [lane.deadline for lane in self.lanes if lane.deadline is not None]
+                    cond.wait(max(0.0, min(deadlines) - now) if deadlines else None)
+            for lane in runnable:
+                if lane.steps is not None:
+                    # An earlier lane in this round may have drained the queue: re-check
+                    # so a lost race is a skipped no-op, not an extra source pass.
+                    with cond:
+                        if not lane._runnable(time.monotonic(),
+                                              getattr(self.queue, "_notification_generation", 0),
+                                              bool(self.queue._qsize())):
+                            continue
+                self._step(lane)
+
+    def _step(self, lane: Lane) -> None:
+        try:
+            finished = lane.context.run(self._advance, lane)
+        except BaseException:  # health: allow BLE001 -- one lane's failure must not kill every chat's executor
+            log.exception("notification lane %s failed", lane.sid)
+            finished = True
+
+        if finished:
+            with self.queue.not_empty:
+                if lane in self.lanes:
+                    self.lanes.remove(lane)
+            lane.done.set()
+
+    def _advance(self, lane: Lane) -> bool:
+        """Advance ``lane`` to its next wait; True once its generator has returned."""
+        _current_lane.set(lane)
+        try:
+            if lane.steps is None:
+                lane.steps = lane.factory()
+                request = next(lane.steps)
+            else:
+                from tools.process_registry_awaiting import take_ready
+                try:
+                    ready = take_ready(self.queue, 0, wake_generation=lane.wake_generation)
+                except BaseException as exc:  # health: allow BLE001 -- rethrown into the pass at its wait
+                    request = lane.steps.throw(exc)
+                else:
+                    request = lane.steps.send(ready)
+        except StopIteration:
+            return True
+        timeout, lane.wake_generation = request
+        lane.deadline = time.monotonic() + max(0.0, timeout)
+        return False
+
+
+def submit(queue, lane: Lane, factory) -> None:
+    """Admit ``lane``; ``factory()`` builds its steps generator inside the lane's context."""
+    with _lock:
+        executor = _executors.get(queue)
+        if executor is None:
+            executor = _executors[queue] = Executor(queue)
+    executor.add(lane, factory)
+
+
+def executor_for(queue) -> Executor | None:
+    with _lock:
+        return _executors.get(queue)
+
+
+def current_identity():
+    """The running poller's identity: its lane under this executor, else the OS thread."""
+    consumer = current_consumer()
+    return consumer if isinstance(consumer, Lane) else threading.get_ident()
+
+
+def current_consumer():
+    """Explicit health identity, independent of the OS thread registry."""
+    lane = _current_lane.get()
+    thread = threading.current_thread()
+    # Context-carrying child threads must not inherit the lane's publish authority.
+    if lane is not None and lane.executor is not None and lane.executor.thread is thread:
+        return lane
+    return thread
diff --git a/tui_gateway/notification_loaded_f.py b/tui_gateway/notification_loaded_f.py
new file mode 100644
index 00000000000..bb475202e57
--- /dev/null
+++ b/tui_gateway/notification_loaded_f.py
@@ -0,0 +1,327 @@
+"""f-only loaded-session scheduling. One reconciler, existing delivery/ACK owners.
+
+The 30s process clock repairs missed wakes, establishes the observation baseline
+and reconciles legacy aliases once per profile, never once per chat. Completion,
+producer and parked-event executors remain independent of this source schedule.
+"""
+from __future__ import annotations
+
+from collections import deque
+from contextvars import copy_context
+import json
+import logging
+import sqlite3
+import threading
+import time
+
+RECONCILE_SECONDS = 30.0
+log = logging.getLogger(__name__)
+
+
+def enabled():
+    from hermes_cli.config import load_config
+    return load_config().get('display', {}).get('loaded_notification_f', True) is True
+
+
+class Action:
+    facts = True
+
+    def __init__(self, scheduler, session, profile, wake):
+        self.scheduler, self.session, self.profile, self.wake = scheduler, session, profile, wake
+        self.context = copy_context()
+        self.pending = deque()
+        self.closed = False
+        session['_notif_remote_batch'] = ()  # no legacy scan before the first shared capture
+        session['_notif_local_boards'] = ()
+
+    def due(self, *, legacy_due):
+        with self.scheduler.lock:
+            if self.closed or not self.pending:
+                return False
+            batch, boards = self.pending.popleft()
+            self.session['_notif_remote_batch'] = batch
+            self.session['_notif_local_boards'] = boards
+            return True
+
+    def retry(self):
+        import json
+        batch = self.session.get('_notif_remote_batch')
+        if hasattr(batch, 'rows'):
+            self.scheduler.invalidate([(gw, key) for gw, key, _ in json.loads(batch.rows)])
+        else:
+            self.scheduler.source_changed()
+
+    def deadline(self, now, last_poll):
+        with self.scheduler.lock:
+            if self.pending:
+                return now
+        if self.session.get('_kanban_pending') or self.session.get('_kanban_claims'):
+            return last_poll + 1.0
+        return self.session.get('_notif_f_retry_at')
+
+    def tick(self, sid, now, last_poll, error_retry_at, poll):
+        from tui_gateway.notification_remote_retry import cancel, deadline
+        due = self.due(legacy_due=False)
+        retry_at = deadline(self.session, now)
+        source_retry = self.session.get('_notif_f_retry_at')
+        if any(at is not None and now >= at for at in (retry_at, source_retry, error_retry_at)):
+            cancel(self.session)
+            self.session.pop('_notif_f_retry_at', None)
+            self.retry()  # fresh shared evidence, never an expired batch or a per-chat full scan
+            error_retry_at = None
+        continuation = bool(self.session.get('_kanban_pending') or self.session.get('_kanban_claims'))
+        if not due and not (continuation and now >= last_poll + 1):
+            return last_poll, error_retry_at
+        try:
+            if due:
+                poll(sid, self.session, remote_only=not self.session['_notif_local_boards'])
+            else:
+                self.session['_notif_remote_batch'] = ()
+                poll(sid, self.session, remote_only=True)  # custody/ACK only; no source polling
+            return now, None
+        except Exception:  # health: allow BLE001 -- retain independent action retry after a failed delivery pass
+            log.exception('loaded notification action failed')
+            return now, now + 1.0
+
+    def close(self):
+        with self.scheduler.lock:
+            self.closed = True
+            self.scheduler.actions.discard(self)
+            self.scheduler.catchup.discard(self)
+            self.pending.clear()
+        self.session.pop('_notif_remote_batch', None)
+        self.session.pop('_notif_local_boards', None)
+        self.scheduler.event.set()
+
+
+class Scheduler:
+    def __init__(self, *, clock=time.monotonic):
+        self.clock = clock
+        self.lock = threading.Lock()
+        self.pass_lock = threading.Lock()
+        self.event = threading.Event()
+        self.actions = set()
+        self.dirty = set()
+        self.catchup = set()
+        self.known_keys = {}
+        self.next_reconcile = 0.0
+        self.stop = threading.Event()
+        self.thread = None
+        self.watch = None
+        self.source_dirty = True
+        self.last_seq = (0, '', '')
+        self.source_identity = None
+
+    def start(self, *, native=True):
+        if native:
+            from hermes_cli.fact_source_watch import NativeSourceWatch
+            from tui_gateway.kanban_remote_notices import hub_db_path
+            try:
+                self.watch = NativeSourceWatch((hub_db_path(),), self.source_changed)
+            except (OSError, NotImplementedError):
+                log.warning('native remote notice hints unavailable; 30s reconciliation remains active', exc_info=True)
+        self.thread = threading.Thread(target=_run, args=(self,), name='loaded-notice-reconciler', daemon=True)
+        self.thread.start()
+
+    def close(self):
+        self.stop.set()
+        self.event.set()
+        if self.thread is not None:
+            self.thread.join(5)
+        if self.watch is not None:
+            self.watch.close()
+
+    def source_changed(self):
+        with self.lock:
+            self.source_dirty = True
+        self.event.set()
+
+    def _changed_keys(self):
+        """Indexed sequence hints only; deletion/reset repair belongs to the clock."""
+        from contextlib import closing
+        from tui_gateway.kanban_remote_notices import _ro, hub_db_path
+        path = hub_db_path()
+        if not path.is_file():
+            return ()
+        with closing(_ro(path)) as conn:
+            conn.execute('BEGIN')
+            meta = dict(conn.execute("SELECT k,v FROM meta WHERE k IN ('gateway','cursor','head')"))
+            stat = path.stat()
+            identity = (str(path), stat.st_dev, stat.st_ino, meta.get('gateway'))
+            if identity != self.source_identity:
+                self.last_seq = (0, '', '')
+                self.source_identity = identity
+            if conn.execute("SELECT 1 FROM sqlite_master WHERE type='index' "
+                            "AND name='replica_poll_metadata'").fetchone() is None:
+                return ()  # old replicas remain on bounded reconciliation, never a hint-triggered scan
+            rows = conn.execute("SELECT gw,key,seq FROM replica INDEXED BY replica_poll_metadata "
+                                "WHERE coll='tasks' AND (seq,gw,key) > (?,?,?) "
+                                "ORDER BY seq,gw,key LIMIT 500", self.last_seq).fetchall()
+            if rows:
+                self.last_seq = (rows[-1][2], rows[-1][0], rows[-1][1])
+            if len(rows) == 500:
+                self.source_changed()
+            return [(gw, key) for gw, key, _seq in rows if gw != meta.get('gateway')]
+
+    def add(self, session, profile, wake):
+        action = Action(self, session, profile, wake)
+        with self.lock:
+            self.actions.add(action)
+            self.catchup.add(action)
+        self.event.set()
+        return action
+
+    def invalidate(self, keys=None):
+        with self.lock:
+            if keys is None:
+                self.source_dirty = True  # reset/health hints cannot borrow a census
+            else:
+                from tui_gateway.kanban_remote_notices_keyed import coalesce
+                self.dirty.update(coalesce(keys))
+        self.event.set()
+
+    def step(self):
+        # Only this process owner captures. Consumers receive immutable evidence
+        # but retain their original serialized claim/delivery executors.
+        with self.pass_lock:
+            now = self.clock()
+            with self.lock:
+                scan = bool(self.actions) and (self.source_dirty or now >= self.next_reconcile)
+                self.source_dirty = False
+            if scan:
+                self.invalidate(self._changed_keys())
+            with self.lock:
+                reconcile = now >= self.next_reconcile
+                if not self.actions or (not reconcile and not self.dirty and not self.catchup):
+                    return
+                # Cache identities, not deliverable evidence: a late chat gets a
+                # fresh keyed capture (including deletions/changes), never stale
+                # rows, expired observations, or another scope's batch.
+                for action in self.catchup:
+                    scope = (action.session.get('profile_home'), action.profile)
+                    chat = action.session.get('session_key')
+                    self.dirty.update(key for key, chats in self.known_keys.get(scope, {}).items()
+                                      if chat in chats)
+                keys = None if reconcile else tuple(self.dirty)
+                self.dirty.clear()
+                if reconcile:
+                    # Reserve the budget after hint discovery, even if capture
+                    # fails. No wake, chat registration or overflow can reset it.
+                    self.next_reconcile = self.clock() + RECONCILE_SECONDS
+                actions = tuple(self.actions)
+            groups = {}
+            batches = {}
+            for action in actions:
+                groups.setdefault((action.session.get('profile_home'), action.profile), []).append(action)
+            for scope, group in groups.items():
