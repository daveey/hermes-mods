+"""Isolated annotation transport targets; lifecycle facade is TEST ONLY.
+
+Source capture is deliberately controlled SQLite, not the production adapter or
+release latch. Real FactHost/ReplicaHandle and canonical annotation code run.
+"""
+from contextlib import contextmanager
+from types import SimpleNamespace
+import builtins
+from pathlib import Path
+import socket
+import sqlite3
+import subprocess
+import threading
+
+import pytest
+
+from hermes_cli import kanban_annotation_facts as annotations
+from hermes_cli import kanban_session_activity as activity
+from hermes_cli import kanban_annotation_disk as disk
+from hermes_cli.kanban_activity_projection import project_kanban_activity
+from hermes_cli.fact_contract import Fact, FactKey, Scope
+from hermes_cli.fact_host import FactHost, acquire
+from hermes_cli.fact_replica import Endpoint
+
+SCOPES = (Scope('annotation-test', 'alpha'), Scope('annotation-test', 'beta'))
+TOKENS = ('a' * 48, 'b' * 48)
+
+
+def owner(directory, pipe):
+    host = FactHost(directory, dict(zip(TOKENS, SCOPES)))
+    try:
+        host.start()
+    except OSError as exc:
+        pipe.send({'error': type(exc).__name__})
+        pipe.close()
+        return
+    reads = 0
+    db = sqlite3.connect(directory / 'source.db')
+    db.execute('CREATE TABLE IF NOT EXISTS waiting (profile TEXT, task TEXT)')
+    pipe.send({'ready': True})
+    try:
+        while True:
+            cmd = pipe.recv()
+            if cmd[0] == 'stop':
+                break
+            if cmd[0] == 'capture':
+                _, index, tasks = cmd
+                profile = SCOPES[index].profile_id
+                with db:
+                    db.execute('DELETE FROM waiting WHERE profile=?', (profile,))
+                    db.executemany('INSERT INTO waiting VALUES (?,?)', [(profile, task) for task in tasks])
+                captured = [r[0] for r in db.execute('SELECT task FROM waiting WHERE profile=?', (profile,))]
+                reads += 1
+                keys = {('default/' + task, 'active', False) for task in captured}
+                parts = ({'s': len(captured)}, {}, {}, {}, {'s': set(captured)}, {}, {}, {},
+                         {'s': keys}, {}, {}, {})
+                projected = project_kanban_activity([{'id': 's'}], parts=parts,
+                                                    observed_at=1234.0, now=1234.0, external={})[0]
+                patch = {k: v for k, v in projected.items() if k != 'id'}
+                host.store.publish([Fact(FactKey(SCOPES[index], 'SessionFact', 's'),
+                                         {'annotations': {'kanban': patch}}, health='fresh')])
+                pipe.send({'expected': projected, 'reads': reads})
+            elif cmd[0] == 'stats':
+                pipe.send({'reads': reads, 'epoch': host.store.snapshot(SCOPES[0]).epoch})
+    finally:
+        db.close()
+        host.close()
+        pipe.close()
+
+
+class LifecycleFacade:
+    """Only the missing coordinator seam is doubled, never store or transport."""
+    def __init__(self, v1):
+        self.v1 = v1
+        self.callback = None
+
+    def __getattr__(self, name):
+        return getattr(self.v1, name)
+
+    def bind_consumer(self, name, scope, callback):
+        assert name == 'annotations'
+        self.callback = callback
+        return SimpleNamespace(close=lambda: None)
+
+
+@contextmanager
+def request_guard():
+    """Trip only on request thread; real replica sockets remain operational."""
+    request_thread = threading.get_ident()
+    calls = []
+    def guarded(original, label):
+        def call(*args, **kwargs):
+            if threading.get_ident() == request_thread:
+                calls.append(label)
+                raise AssertionError('request I/O: ' + label)
+            return original(*args, **kwargs)
+        return call
+    with pytest.MonkeyPatch.context() as patch:
+        for obj, name in ((builtins, 'open'), (Path, 'open'), (Path, 'stat'),
+                          (sqlite3, 'connect'), (socket, 'socket'), (subprocess, 'Popen'),
+                          (activity, '_annotation_snapshot'), (activity, '_open_ro'),
+                          (activity, 'cached_ro'), (disk, 'load_host'), (disk, 'load')):
+            patch.setattr(obj, name, guarded(getattr(obj, name), name))
+        yield calls
+
+
+def replica(directory, index, pipe):
+    scope = SCOPES[index]
+    handle = acquire(scope, endpoint=Endpoint(str(directory / 'facts.sock'), TOKENS[index]))
+    lifecycle = []
+    facade = LifecycleFacade(handle.v1)
+    consumer = annotations.AnnotationFacts(SimpleNamespace(v1=facade, demand=handle.demand), scope,
+        stop_legacy=lambda: lifecycle.append('stop'), start_legacy=lambda: lifecycle.append('start'))
+    consumer.on_mode('facts', 1)  # controlled seam only; NOT global release activation
+    pipe.send({'ready': True})
+    try:
+        while True:
+            cmd = pipe.recv()
+            if cmd == 'stop':
+                break
+            if cmd == 'read':
+                try:
+                    with request_guard() as calls, annotations.use(consumer):
+                        rows = activity.annotate_kanban_activity([{'id': 's'}])
+                    pipe.send({'rows': rows, 'io': calls, 'epoch': handle.v1.snapshot(scope).epoch})
+                except annotations.AnnotationUnavailable:
+                    pipe.send({'unavailable': True})
+            elif cmd == 'privacy':
+                try:
+                    handle.v1.snapshot(SCOPES[1 - index])
+                except ValueError:
+                    pipe.send({'denied': True})
+                else:
+                    pipe.send({'denied': False})
+            elif cmd == 'rollback':
+                consumer.on_mode('legacy', 2)
+                consumer.on_mode('legacy', 2)
+                pipe.send({'lifecycle': lifecycle, 'subscription': consumer._subscription is not None})
+    finally:
+        consumer.close()
+        handle.close()
+        pipe.close()
diff --git a/tests/hermes_cli/fact_host_processes.py b/tests/hermes_cli/fact_host_processes.py
new file mode 100644
index 00000000000..78d7e77209e
--- /dev/null
+++ b/tests/hermes_cli/fact_host_processes.py
@@ -0,0 +1,125 @@
+"""Real isolated owner/serve/gateway process targets for fact host proofs."""
+import hashlib
+import resource
+import sqlite3
+import time
+
+from hermes_cli.fact_contract import Fact, FactKey, Scope
+from hermes_cli.fact_host import FactHost, acquire
+from hermes_cli.fact_replica import Endpoint
+
+SCOPES = (Scope("test-install", "alpha"), Scope("test-install", "beta"))
+TOKENS = ("a" * 48, "b" * 48)
+
+
+class OwnerCommands:
+    def __init__(self, host):
+        self.host = host
+
+    def put(self, index, data):
+        key = self.host.store.view_key(SCOPES[index], "panel_status", {"session_id": "one"})
+        return self.host.store.publish([Fact(key, {"encoded": data}, health="fresh")])
+
+    def expire(self):
+        key = self.host.store.view_key(SCOPES[0], "panel_status", {"session_id": "one"})
+        return self.host.store.publish([Fact(key, {"encoded": b"expires"}, health="fresh",
+                                             valid_until=time.time() + 2)])
+
+    def dataset(self):
+        for scope in SCOPES:
+            for batch in range(24):
+                self.host.store.publish(Fact(FactKey(scope, "TaskFact", str(batch * 500 + i)),
+                                             {"title": "task", "status": "ready", "index": i})
+                                        for i in range(500))
+        return True
+
+    def burst(self):
+        start = time.monotonic()
+        for i in range(100):
+            self.put(0, str(i).encode())
+        return {"elapsed": time.monotonic() - start}
+
+    def stats(self):
+        return {"rss_kib": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,
+                "pins": self.host.pages.retained_bytes, "ring": self.host.store._retained_bytes,
+                "queues": [(s.queued_bytes, len(s.queue), s.reset_pending)
+                           for s in self.host.store._subscribers]}
+
+
+def owner_main(directory, pipe):
+    host = FactHost(directory, dict(zip(TOKENS, SCOPES)), page_ttl=3)
+    try:
+        host.start()
+    except OSError as exc:
+        pipe.send({"error": type(exc).__name__})
+        return
+
+    def demand(scope, view, selector):
+        key = host.store.view_key(scope, view, selector)
+        host.store.publish([Fact(key, {"encoded": b"demanded"}, health="fresh")])
+
+    host.demand = demand
+    commands = OwnerCommands(host)
+    handlers = {"put": commands.put, "expire": commands.expire, "dataset": commands.dataset,
+                "burst": commands.burst, "stats": commands.stats}
+    pipe.send({"ready": True})
+    try:
+        while True:
+            cmd = pipe.recv()
+            if cmd[0] == "stop":
+                break
+            pipe.send(handlers[cmd[0]](*cmd[1:]))
+    finally:
+        host.close()
+        pipe.close()
+
+
+class ReplicaCommands:
+    def __init__(self, handle, index):
+        self.handle, self.index = handle, index
+        self.reads = 0
+
+    def no_db(self, *args, **kwargs):
+        self.reads += 1
+        raise AssertionError("replica attempted DB access")
+
+    def view(self):
+        snap = self.handle.v1.snapshot(SCOPES[self.index])
+        result = snap.view("panel_status", {"session_id": "one"})
+        if hasattr(result, "encoded"):
+            return {"size": len(result.encoded), "digest": hashlib.sha256(result.encoded).hexdigest(),
+                    "epoch": result.epoch, "rev": result.rev}
+        return {"state": type(result).__name__}
+
+    def demand(self):
+        self.handle.demand("panel_status", {"session_id": "one"})
+        return True
+
+    def privacy(self):
+        try:
+            self.handle.v1.snapshot(SCOPES[1 - self.index])
+        except ValueError:
+            return {"denied": True, "scopes": {k.scope.profile_id for k in self.handle._store._facts}}
+        return {"denied": False}
+
+    def stats(self):
+        return {"reads": self.reads, "rss_kib": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}
+
+
+def replica_main(directory, index, pipe):
+    commands = ReplicaCommands(None, index)
+    sqlite3.connect = commands.no_db
+    handle = acquire(SCOPES[index], endpoint=Endpoint(str(directory / "facts.sock"), TOKENS[index]))
+    commands.handle = handle
+    handlers = {"view": commands.view, "demand": commands.demand,
+                "privacy": commands.privacy, "stats": commands.stats}
+    pipe.send({"ready": True})
+    try:
+        while True:
+            cmd = pipe.recv()
+            if cmd == "stop":
+                break
+            pipe.send(handlers[cmd]())
+    finally:
+        handle.close()
+        pipe.close()
