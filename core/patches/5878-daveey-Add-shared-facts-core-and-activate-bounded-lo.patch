@@ -0,0 +1,47 @@
+"""Task content source for ChangeFeed; projection policy belongs to materializers. [daveey]
+
+A source's namespaced identity and hydration callback are supplied by the host.
+Hydration must select ONLY content covered by kanban_task_change. Operational
+claims/leases/wake state require separate adapters; this is not a universal
+board cursor. The callback receives batches of at most 500 task ids in a guarded
+read snapshot and must return detached raw data, not perform external I/O.
+"""
+from pathlib import Path
+
+from hermes_cli.fact_capture import CaptureBudgetExceeded, CaptureOverflow, CapturePending, capture_tasks
+from hermes_cli.fact_bootstrap import PagedBootstrap
+from hermes_cli.fact_source_watch import NativeSourceWatch
+
+
+class TaskContentSource:
+    def __init__(self, source, path, hydrate):
+        self.source = source
+        # Keep the lexical alias: native coverage must see symlink retargets.
+        self.path = Path(path).absolute()
+        self._hydrate = hydrate
+        self._watch = None
+        self._bootstrap = None
+
+    def watch(self, wake):
+        if self._watch is not None:
+            raise RuntimeError("source already registered")
+        self._watch = NativeSourceWatch((self.path,), wake)
+        return self._watch
+
+    def capture(self, cursor, budget):
+        if self._watch is not None:
+            self._watch.check()
+        if (self._bootstrap is not None and self._bootstrap.ready is not None
+                and cursor == self._bootstrap.ready.after):
+            self._bootstrap = None
+        if self._bootstrap is not None:
+            result = self._bootstrap.capture(cursor, budget)
+        else:
+            try:
+                result = capture_tasks(self.path, cursor, self._hydrate, budget=budget)
+            except (CaptureOverflow, CaptureBudgetExceeded):
+                self._bootstrap = PagedBootstrap(self.path, self._hydrate)
+                raise CapturePending("task bootstrap required") from None
+        if self._watch is not None:
+            self._watch.check()
+        return result
diff --git a/hermes_cli/fact_wire.py b/hermes_cli/fact_wire.py
new file mode 100644
index 00000000000..198af9db01c
--- /dev/null
+++ b/hermes_cli/fact_wire.py
@@ -0,0 +1,74 @@
+"""Private JSON transport for the existing fact contract (never pickle). [daveey]"""
+from __future__ import annotations
+
+import base64
+import json
+from collections.abc import Mapping
+from dataclasses import fields, is_dataclass
+from typing import Any
+
+from hermes_cli import fact_contract as contract
+
+_TYPES: dict[str, Any] = {cls.__name__: cls for cls in (
+    contract.Scope, contract.SourceId, contract.FactKey, contract.Fact,
+    contract.Position, contract.Delta,
+)}
+
+
+def pack(value):
+    if is_dataclass(value) and _TYPES.get(type(value).__name__) is type(value):
+        return ["record", type(value).__name__, [pack(getattr(value, f.name)) for f in fields(value)]]
+    if isinstance(value, Mapping):
+        return ["map", [[pack(k), pack(v)] for k, v in value.items()]]
+    if isinstance(value, bytes):
+        return ["bytes", [base64.b64encode(value[i:i + 65536]).decode("ascii")
+                          for i in range(0, len(value), 65536)]]
+    if isinstance(value, (tuple, list)):
+        return ["tuple", [pack(v) for v in value]]
+    if isinstance(value, (set, frozenset)):
+        return ["set", [pack(v) for v in value]]
+    if value is None or isinstance(value, (str, bool, int, float)):
+        return value
+    raise TypeError(type(value).__name__)
+
+
+def unpack(value) -> Any:
+    if not isinstance(value, list):
+        return value
+    tag = value[0]
+    if tag == "record":
+        return _TYPES[value[1]](*(unpack(v) for v in value[2]))
+    if tag == "map":
+        return {unpack(k): unpack(v) for k, v in value[1]}
+    if tag == "bytes":
+        return b"".join(base64.b64decode(chunk, validate=True) for chunk in value[1])
+    if tag == "tuple":
+        return tuple(unpack(v) for v in value[1])
+    if tag == "set":
+        return frozenset(unpack(v) for v in value[1])
+    raise ValueError("unknown fact transport tag")
+
+
+def encode(value) -> bytes:
+    return json.dumps(pack(value), ensure_ascii=True, separators=(",", ":"), allow_nan=False).encode("ascii")
+
+
+def decode(data: bytes | bytearray) -> Any:
+    return unpack(json.loads(data))
+
+
+def encoded_size(value):
+    return sum(len(part) for part in json.JSONEncoder(
+        ensure_ascii=True, separators=(",", ":"), allow_nan=False).iterencode(pack(value)))
+
+
+def encode_into(value, stream, limit):
+    """Spool reset bytes without retaining a second full encoded generation."""
+    size = 0
+    for part in json.JSONEncoder(ensure_ascii=True, separators=(",", ":"), allow_nan=False).iterencode(pack(value)):
+        block = part.encode("ascii")
+        size += len(block)
+        if size > limit:
+            raise ValueError("reset_budget_exceeded")
+        stream.write(block)
+    return size
