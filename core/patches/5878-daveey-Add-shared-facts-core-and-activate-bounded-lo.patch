@@ -0,0 +1,85 @@
+"""Term/scoped, expiring reset byte pages; not a new public fact schema. [daveey]"""
+from __future__ import annotations
+
+import threading
+import time
+import uuid
+import tempfile
+from dataclasses import dataclass
+
+from hermes_cli.fact_wire import encode_into
+
+PAGE_BYTES = 256 * 1024
+MAX_RESET_BYTES = 64 * 1024 * 1024
+
+
+@dataclass
+class _Pin:
+    scope: object
+    stream: object
+    size: int
+    expires: float
+    timer: threading.Timer
+
+
+class PinnedPages:
+    def __init__(self, *, ttl=30.0, max_bytes=MAX_RESET_BYTES, max_pins=8, directory=None):
+        if ttl <= 0 or max_bytes < 1 or max_pins < 1:
+            raise ValueError("positive reset limits required")
+        self.ttl, self.max_bytes, self.max_pins = ttl, max_bytes, max_pins
+        self._lock = threading.Lock()
+        self._encode_lock = threading.Lock()
+        self.directory = directory
+        self._pins = {}
+        self.retained_bytes = 0
+
+    def pin(self, scope, delta):
+        with self._encode_lock:
+            with self._lock:
+                available = self.max_bytes - self.retained_bytes
+                if len(self._pins) >= self.max_pins:
+                    raise ValueError("reset_budget_exceeded")
+            stream = tempfile.TemporaryFile(dir=self.directory)
+            try:
+                size = encode_into(delta, stream, available)
+                return self._install(scope, delta, stream, size)
+            except (OSError, ValueError, TypeError):
+                stream.close()
+                raise
+
+    def _install(self, scope, delta, stream, size):
+        with self._lock:
+            token = uuid.uuid4().hex
+            timer = threading.Timer(self.ttl, self.release, args=(token, scope))
+            timer.daemon = True
+            self._pins[token] = _Pin(scope, stream, size, time.monotonic() + self.ttl, timer)
+            self.retained_bytes += size
+            timer.start()
+            return {"token": token, "size": size, "epoch": delta.epoch, "rev": delta.rev}
+
+    def page(self, token, scope, offset):
+        with self._lock:
+            pin = self._pins.get(token)
+            if pin is None or pin.scope != scope or pin.expires <= time.monotonic():
+                raise ValueError("reset_expired")
+            if type(offset) is not int or offset < 0 or offset >= pin.size:
+                raise ValueError("invalid_page_offset")
+            pin.stream.seek(offset)
+            return pin.stream.read(PAGE_BYTES)
+
+    def release(self, token, scope):
+        with self._lock:
+            pin = self._pins.get(token)
+            if pin is not None and pin.scope == scope:
+                del self._pins[token]
+                self.retained_bytes -= pin.size
+                pin.timer.cancel()
+                pin.stream.close()
+
+    def close(self):
+        with self._lock:
+            for pin in self._pins.values():
+                pin.timer.cancel()
+                pin.stream.close()
+            self._pins.clear()
+            self.retained_bytes = 0
diff --git a/hermes_cli/fact_parity.py b/hermes_cli/fact_parity.py
new file mode 100644
index 00000000000..309de34f968
--- /dev/null
+++ b/hermes_cli/fact_parity.py
@@ -0,0 +1,106 @@
+"""Shadow comparison of legacy JSON with one pinned fact generation. [daveey]
+
+This harness never invokes action executors or reads live sources. The capture
+owner supplies legacy responses from the SAME captured source state and clock.
+Passing this comparison alone is not source-coverage or live-parity evidence.
+"""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+
+from hermes_cli.fact_contract import Ready, freeze
+from hermes_cli.fact_store import Snapshot
+
+
+@dataclass(frozen=True)
+class ExpectedView:
+    name: str
+    selector: Mapping
+    encoded: bytes
+
+    def __post_init__(self):
+        object.__setattr__(self, "selector", freeze(self.selector))
+
+
+@dataclass(frozen=True)
+class ParityFailure:
+    case: int
+    reason: str
+
+
+@dataclass(frozen=True)
+class ParityReport:
+    epoch: str
+    rev: int
+    checked: int
+    failures: tuple[ParityFailure, ...]
+
+    @property
+    def passed(self) -> bool:
+        return self.checked > 0 and not self.failures
+
+
+def _difference(expected, actual) -> str | None:
+    # Python equality conflates true/1/1.0, unlike the typed wire contract.
+    if type(expected) is not type(actual):
+        return "json_type"
+    if isinstance(expected, dict):
+        if expected.keys() != actual.keys():
+            return "json_fields"
+        pairs = ((value, actual[key]) for key, value in expected.items())
+    elif isinstance(expected, list):
+        if len(expected) != len(actual):
+            return "json_length"
+        pairs = zip(expected, actual)
+    else:
+        return None if expected == actual else "json_value"
+    for left, right in pairs:
+        reason = _difference(left, right)
+        if reason:
+            return reason
+    return None
+
+
+def _object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("duplicate JSON key")
+        result[key] = value
+    return result
+
+
+def _constant(_value):
+    raise ValueError("non-finite JSON number")
+
+
+def _decode(encoded):
+    return json.loads(encoded, object_pairs_hook=_object, parse_constant=_constant)
+
+
+def _selector_value(value):
+    if isinstance(value, Mapping):
+        return {key: _selector_value(item) for key, item in value.items()}
+    if isinstance(value, tuple):
+        return [_selector_value(item) for item in value]
+    return value
+
+
+def compare_views(snapshot: Snapshot, expected: Sequence[ExpectedView]) -> ParityReport:
+    """No hydration, fallback, clock reads or encoding; diagnostics omit payloads."""
+    failures = []
+    for index, case in enumerate(expected):
+        result = snapshot.view(case.name, _selector_value(case.selector))
+        if not isinstance(result, Ready):
+            reason = "view_not_ready"
+        else:
+            try:
+                reason = _difference(_decode(case.encoded), _decode(result.encoded))
+            except (ValueError, UnicodeError, TypeError, RecursionError):
+                reason = "invalid_json"
+        if reason:
+            failures.append(ParityFailure(index, reason))
+    return ParityReport(snapshot.epoch, snapshot.rev, len(expected), tuple(failures))
diff --git a/hermes_cli/fact_participant.py b/hermes_cli/fact_participant.py
new file mode 100644
index 00000000000..8253e681336
--- /dev/null
+++ b/hermes_cli/fact_participant.py
@@ -0,0 +1,136 @@
+"""Process-local participant control, not a distributed release latch. [daveey]
+
+Startup supplies the complete authorized roster. An external release owner must
+fence requests across all processes BEFORE calling transition. Readiness never
+auto-activates; failed drains retain callback custody for explicit rollback.
+"""
+from collections.abc import Callable
+from contextvars import copy_context
+from dataclasses import dataclass
+from functools import partial
+import threading
+
+
+@dataclass
+class Registration:
+    remove: Callable[[], None]
+    closed: bool = False
+
+    def close(self):
+        if not self.closed:
+            self.remove()
+            self.closed = True
+
+
+class ProcessLifecycle:
+    def __init__(self, expected):
+        self.expected = frozenset(expected)
+        if not self.expected:
+            raise ValueError('empty participant roster')
+        self._lock = threading.RLock()
+        self._operation = threading.RLock()
+        self._callbacks = {}
+        self._ready = {}
+        self._retired = set()
+        self.mode = 'legacy'
+        self.generation = 0
+
+    def bind_consumer(self, name, scope, callback):
+        key = (scope, name)
+        callback = partial(copy_context().run, callback)
+        with self._operation:
+            with self._lock:
+                if key not in self.expected:
+                    raise ValueError('unexpected consumer')
+                if key in self._retired:
+                    raise ValueError('retired consumer requires a new participant capability')
+                if key in self._callbacks or self.mode != 'legacy':
+                    raise RuntimeError('consumer already owned or participant not legacy')
+                self._callbacks[key] = callback
+                self.mode = 'transition'
+            try:
+                callback('legacy', self.generation)
+            except BaseException:
+                with self._lock:
+                    self.mode = 'failed'
+                raise
+            with self._lock:
+                self.mode = 'legacy'
+        return Registration(lambda: self.unbind_consumer(name, scope))
+
+    def unbind_consumer(self, name, scope):
+        """Also recovers retained slots whose initial bind callback failed."""
+        with self._operation, self._lock:
+            if self.mode != 'legacy':
+                raise RuntimeError('rollback required before unregister')
+            self._callbacks.pop((scope, name), None)
+            self._ready.pop((scope, name), None)
+            self._retired.add((scope, name))
+
+    def has_bindings(self, scope):
+        with self._lock:
+            return any(key[0] == scope for key in self._callbacks)
+
+    def report_ready(self, name, scope, *, version=1, ready=True):
+        with self._lock:
+            key = (scope, name)
+            if key not in self._callbacks:
+                raise ValueError('consumer not bound')
+            self._ready[key] = type(version) is int and version == 1 and ready is True
+
+    def _is_ready(self):
+        return all(k in self._callbacks and self._ready.get(k) for k in self.expected)
+
+    def _call_all(self, callbacks, mode, generation):
+        errors = []
+        for callback in callbacks:
+            try:
+                callback(mode, generation)
+            except Exception as exc:  # health: allow BLE001 -- aggregate failures and retain every participant for rollback
+                errors.append(exc)
+                if mode == 'facts':
+                    break
+            except BaseException:
+                with self._lock:
+                    self.mode = 'failed'
+                    self._ready.clear()
+                raise
+        return errors
+
+    def transition(self, mode, generation):
+        """Synchronous control-plane call; callers keep it off request threads."""
+        if mode not in ('legacy', 'facts'):
+            raise ValueError('invalid participant mode')
+        with self._operation:
+            with self._lock:
+                if self.mode == 'transition':
+                    raise RuntimeError('reentrant participant transition')
+                if type(generation) is not int or generation <= self.generation:
+                    raise ValueError('non-increasing release generation')
+                if mode == 'facts' and self.mode != 'legacy':
+                    raise RuntimeError('rollback required before activation')
+                if mode == 'facts' and not self._is_ready():
+                    raise RuntimeError('participant not ready')
+                self.generation = generation
+                self.mode = 'transition'
+                callbacks = tuple(self._callbacks.values())
+            errors = self._call_all(callbacks, mode, generation)
+            with self._lock:
+                if mode == 'facts' and not self._is_ready():
+                    errors.append(RuntimeError('readiness withdrawn during transition'))
+            if errors and mode == 'facts':
+                # Rollback gets a NEW generation. A consumer may reject replay of
+                # facts at the generation it already rolled back.
+                generation += 1
+                rollback_errors = self._call_all(reversed(callbacks), 'legacy', generation)
+                errors.extend(rollback_errors)
+                resulting_mode = 'failed' if rollback_errors else 'legacy'
+            else:
+                resulting_mode = 'failed' if errors else mode
+            with self._lock:
+                self.generation = generation
+                self.mode = resulting_mode
+                if errors or mode == 'legacy':
+                    self._ready.clear()
+            if errors:
+                raise ExceptionGroup('participant transition incomplete', errors)
