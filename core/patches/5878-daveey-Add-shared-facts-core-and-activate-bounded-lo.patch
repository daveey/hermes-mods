+               ("hermes_cli/kanban_external_activity.py", "stamp_boards"),
+               ("hermes_cli/kanban_external_activity.py", "stamp_rows")),
+    "goal": (("hermes_cli/goal_session_activity.py", "annotate_goal_activity"),
