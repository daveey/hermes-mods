From f42947400c09aec8dc6ec1fc4d7704679c444ea5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 12:19:05 +0000
Subject: [PATCH] fix(nix): judge warm cache by HTTPS source fetches [daveey]

Apply option A authorized by owning orchestrator comment <current-instruction-id> on t_eeeeee0000000024, superseding comment <prior-instruction-id>. The 10-copy acceptance was agent-authored; the orchestrator explicitly changed it to a budget of 10 HTTPS source fetches. Preserve the existing advisory warning semantics, main push/primary-key-hit gates, both reported counters, 5 GiB rooted ceiling and gc-max-store-size-linux: 5G.

Evidence: post-3778 main run 44728380684 hit the cache but copied 368 free cache.nixos.org paths over about 51 seconds; HTTPS source fetches were 5 versus 239 in cold run 44719100443. Stable roots were 3,064,048,544 B. Retaining all copied paths would need about 8.08 GB and grow the Blacksmith archive from about 2.3 to 3.9 GB (estimate); limits/pricing are unverified. No paid storage, runner/Blacksmith change, removed check or forced main rerun.

Proof: new cases fail three ways before the change, then all 27 tests across four Nix CI suites pass; scripts/check reports 21 checks OK. Tests retain warm miss/PR/topic gating, exercise 10/11 source boundary and cold-like 239 fetches on an apparent hit. Main two-run acceptance follows independent exact-head approval and green CI landing.
---
 scripts/ci/nix_cache_summary.py         |  6 ++++--
 tests/ci/test_nix_cache_observations.py | 20 +++++++++++---------
 2 files changed, 15 insertions(+), 11 deletions(-)

diff --git a/scripts/ci/nix_cache_summary.py b/scripts/ci/nix_cache_summary.py
index 6802371f57..939d39622b 100644
--- a/scripts/ci/nix_cache_summary.py
+++ b/scripts/ci/nix_cache_summary.py
@@ -19,10 +19,12 @@ def main():
     print(report)
     with Path(os.environ["GITHUB_STEP_SUMMARY"]).open("a", encoding="utf-8") as summary:
         summary.write("## Nix cache effectiveness\n\n" + report)
+    # Free binary substitutions are expected under the unchanged 5 GiB GC cap;
+    # source downloads, not copied store paths, diagnose a broken warm cache.
     if (os.environ.get("GITHUB_EVENT_NAME") == "push"
             and os.environ.get("GITHUB_REF") == "refs/heads/main"
-            and os.environ.get("NIX_CACHE_HIT") == "true" and copies > 10):
-        print(f"::warning::Nix primary-key hit still copied {copies} paths (budget: 10)")
+            and os.environ.get("NIX_CACHE_HIT") == "true" and fetches > 10):
+        print(f"::warning::Nix primary-key hit still fetched {fetches} HTTPS sources (budget: 10)")
 
 
 if __name__ == "__main__":
diff --git a/tests/ci/test_nix_cache_observations.py b/tests/ci/test_nix_cache_observations.py
index c87946c8da..7efb90240f 100644
--- a/tests/ci/test_nix_cache_observations.py
+++ b/tests/ci/test_nix_cache_observations.py
@@ -10,18 +10,20 @@ from ruamel.yaml import YAML
 ROOT = Path(__file__).resolve().parents[2]
 
 
-@pytest.mark.parametrize(('event', 'ref', 'hit', 'copies', 'warn'), [
-    ('push', 'refs/heads/main', 'true', 11, True),
-    ('push', 'refs/heads/main', 'true', 10, False),
-    ('push', 'refs/heads/main', 'false', 11, False),
-    ('pull_request', 'refs/heads/main', 'true', 11, False),
-    ('push', 'refs/heads/topic', 'true', 11, False),
+@pytest.mark.parametrize(('event', 'ref', 'hit', 'copies', 'fetches', 'warn'), [
+    ('push', 'refs/heads/main', 'true', 368, 5, False),
+    ('push', 'refs/heads/main', 'true', 0, 11, True),
+    ('push', 'refs/heads/main', 'true', 368, 10, False),
+    ('push', 'refs/heads/main', 'true', 93, 239, True),
+    ('push', 'refs/heads/main', 'false', 93, 239, False),
+    ('pull_request', 'refs/heads/main', 'true', 0, 11, False),
+    ('push', 'refs/heads/topic', 'true', 0, 11, False),
 ])
-def test_summary_counts_real_log_lines(tmp_path, event, ref, hit, copies, warn):
+def test_summary_counts_real_log_lines(tmp_path, event, ref, hit, copies, fetches, warn):
     log = tmp_path / 'build.log'
     log.write_text(
         "copying path '/nix/store/a' from 'https://cache.nixos.org'...\n" * copies
-        + 'source> trying https://example.com/source.tar.gz\n'
+        + 'source> trying https://example.com/source.tar.gz\n' * fetches
         + 'echo "copying path /nix/store/quoted"\n'
     )
     summary = tmp_path / 'summary'
@@ -33,7 +35,7 @@ def test_summary_counts_real_log_lines(tmp_path, event, ref, hit, copies, warn):
     )
     assert result.returncode == 0, result.stderr
     assert f'Paths copied from substituters: {copies}' in summary.read_text()
-    assert 'HTTPS source fetches: 1' in summary.read_text()
+    assert f'HTTPS source fetches: {fetches}' in summary.read_text()
     assert ('::warning::' in result.stdout) is warn
 
 
