From 67f63845e50ed7cf5421bc6f26f1accdcf89cad4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 15:42:07 +0000
Subject: [PATCH] [daveey] Test that an explicit now reaches _not_claiming from
 every caller

Review nit on PR #3793: dropping now=now at kanban_move.matching_machines or
kanban_placement._claiming_for left every test green. The new test runs on the
real clock with at=NOW*1000, so only a threaded now refuses.
Mutants: dropping now= in matching_machines and in _claiming_for each fail
test_explicit_now_is_honoured_by_every_caller. The label_machines call-site now= is equivalent (same instant).
---
 tests/hermes_cli/test_claiming_freshness.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/tests/hermes_cli/test_claiming_freshness.py b/tests/hermes_cli/test_claiming_freshness.py
index 0b55a7dc2d..014e104e4f 100644
--- a/tests/hermes_cli/test_claiming_freshness.py
+++ b/tests/hermes_cli/test_claiming_freshness.py
@@ -52,3 +52,12 @@ def test_unknown_or_out_of_window_metrics_do_not_refuse(metrics):
     assert not move._not_claiming(entry, now=NOW)
     assert move.matching_machines(["pool:worker"], {"worker-1": entry}, me="hub", now=NOW) == ["worker-1"]
     assert placement._claiming_for("worker-1", entry, {"pool:worker"}, now=NOW)
+
+
+def test_explicit_now_is_honoured_by_every_caller():
+    """``now`` must reach ``_not_claiming``; the real clock (unpatched) is years after NOW, so a sample fresh at
+    NOW is stale on it and only a threaded ``now`` refuses."""
+    entry = {"labels": ["pool:worker"], "metrics": {"claiming": 0, "at": NOW * 1000}}
+    assert move._not_claiming(entry, now=NOW)
+    assert move.matching_machines(["pool:worker"], {"worker-1": entry}, me="hub", now=NOW) == []
+    assert not placement._claiming_for("worker-1", entry, {"pool:worker"}, now=NOW)
