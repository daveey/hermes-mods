From d457a42734d5f340b0763392d7d9ae378ce01877 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:52:38 +0000
Subject: [PATCH] [daveey] Flush archive ancestor entries before scratch
 deletion

---
 hermes_cli/kanban_scratch_archive.py          |  6 ++-
 .../test_kanban_scratch_gc_archive.py         | 46 +++++++++++++++++++
 2 files changed, 51 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_scratch_archive.py b/hermes_cli/kanban_scratch_archive.py
index 6d9302e9e75..f68958eb7da 100644
--- a/hermes_cli/kanban_scratch_archive.py
+++ b/hermes_cli/kanban_scratch_archive.py
@@ -535,7 +535,11 @@ def archive_workspace(workspace: Path, archive_dir: Path, *, task_id: str,
             final = archive_dir.with_name(f"{archive_dir.name}-{int(time.time())}")
         partial.rename(final)
         try:
-            _fsync_path(final.parent, directory=True)  # publication name durable before any detach
+            # Persist every ancestor entry, not just the published name. Existing
+            # directories may come from an interrupted prior attempt whose mkdir
+            # was never flushed, so existence cannot serve as a durability fence.
+            for parent in final.absolute().parents:
+                _fsync_path(parent, directory=True)
         except BaseException:
             shutil.rmtree(final, ignore_errors=True)
             raise
diff --git a/tests/hermes_cli/test_kanban_scratch_gc_archive.py b/tests/hermes_cli/test_kanban_scratch_gc_archive.py
index 9659be32ce0..be72d45f1e1 100644
--- a/tests/hermes_cli/test_kanban_scratch_gc_archive.py
+++ b/tests/hermes_cli/test_kanban_scratch_gc_archive.py
@@ -751,6 +751,52 @@ def test_archive_fsyncs_all_artifacts_bottom_up_before_publication_and_detach(bo
     assert str(_archive(tid).parent) in [p for k, p in events[pub:det] if k == "fsync"]
 
 
+@pytest.mark.parametrize("existing", [False, True], ids=["absent_root", "retry_existing_chain"])
+def test_archive_flushes_ancestor_entries_before_return(tmp_path, monkeypatch, existing):
+    from hermes_cli import kanban_scratch_archive as sa
+
+    source = tmp_path / "source"
+    source.mkdir()
+    (source / "evidence").write_text("unique")
+    dest = tmp_path / "archive" / "scratch" / "new-board" / "task"
+    if existing:
+        dest.parent.mkdir(parents=True)
+    flushed = []
+    real_flush = sa._fsync_path
+
+    def flush(path, *, directory):
+        real_flush(path, directory=directory)
+        if directory:
+            flushed.append(path)
+
+    monkeypatch.setattr(sa, "_fsync_path", flush)
+    result = sa.archive_workspace(source, dest, task_id="task", completed_at=OLD)
+    sa.verify_complete_archive(result)
+    assert all(parent in flushed for parent in dest.absolute().parents)
+
+
+@pytest.mark.parametrize("ancestor", [0, 1, 2])
+def test_ancestor_fsync_failure_preserves_workspace(board, monkeypatch, ancestor):
+    from hermes_cli import kanban_scratch_archive as sa
+
+    tid, path = _plain_task(lambda p: None)
+    target = list(_archive(tid).parent.parents)[ancestor]
+    real_flush = sa._fsync_path
+    hits = []
+
+    def flush(current, *, directory):
+        if directory and current == target:
+            hits.append(current)
+            raise OSError(5, "ancestor EIO")
+        return real_flush(current, directory=directory)
+
+    monkeypatch.setattr(sa, "_fsync_path", flush)
+    assert _gc() == 0
+    assert hits
+    assert (path / "notes.txt").read_text() == "scratch"
+    assert not _archive(tid).exists()
+
+
 @pytest.mark.parametrize("target", ["file", "directory", "publication_parent"])
 def test_fsync_failure_fails_closed_without_publication(board, monkeypatch, target):
     from hermes_cli import kanban_scratch_archive as sa
