From 8f5ccdb4eeb3eda00333d3d040b3be5c80bed44a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 01:37:06 +0000
Subject: [PATCH] [daveey] Index wake-check deadlines for idle due probes

The G2b MIN(next_at) gate lacked its required index. Add the schema index and exercise legacy upgrade plus idempotent schema replay. Proof: query-plan regression fails without the DDL and passes with the covering index; focused gate suite passes. Live reclaim budget remains to be measured after deployment.
---
 hermes_cli/kanban_db.py                       |  1 +
 tests/hermes_cli/test_kanban_wake_due_gate.py | 14 ++++++++++++++
 2 files changed, 15 insertions(+)

diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index 3f508cc29f..2a62d805ef 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -1000,6 +1000,7 @@ CREATE TABLE IF NOT EXISTS task_wake_checks (
     fails     INTEGER NOT NULL DEFAULT 0, first_failure_at INTEGER,
     generation TEXT, purpose TEXT NOT NULL DEFAULT 'wake'  -- 'wake' (park) | 'ask_resolved' (kanban_ask_resolved)
 );
+CREATE INDEX IF NOT EXISTS idx_wake_checks_next_at  ON task_wake_checks(next_at);
 CREATE INDEX IF NOT EXISTS idx_links_child           ON task_links(child_id);
 CREATE INDEX IF NOT EXISTS idx_links_parent          ON task_links(parent_id);
 CREATE INDEX IF NOT EXISTS idx_comments_task         ON task_comments(task_id, created_at);
diff --git a/tests/hermes_cli/test_kanban_wake_due_gate.py b/tests/hermes_cli/test_kanban_wake_due_gate.py
index fed2aabea7..c67529f3ce 100644
--- a/tests/hermes_cli/test_kanban_wake_due_gate.py
+++ b/tests/hermes_cli/test_kanban_wake_due_gate.py
@@ -10,6 +10,20 @@ from tests.hermes_cli import test_kanban_wake_check as helpers
 kanban_home = helpers.kanban_home
 
 
+def test_deadline_query_uses_covering_index_after_schema_upgrade(kanban_home):
+    with kbc.connect_closing() as conn:
+        # Simulate an existing board from before the deadline index was added.
+        conn.execute("DROP INDEX IF EXISTS idx_wake_checks_next_at")
+        kbc.apply_schema_steps(conn)
+        plan = conn.execute(
+            "EXPLAIN QUERY PLAN SELECT MIN(next_at) FROM task_wake_checks"
+        ).fetchall()
+        assert any("COVERING INDEX idx_wake_checks_next_at" in row[3] for row in plan)
+        # Schema initialization remains idempotent on subsequent opens.
+        kbc.apply_schema_steps(conn)
+        assert conn.execute("SELECT MIN(next_at) FROM task_wake_checks").fetchone()[0] is None
+
+
 def test_not_due_avoids_probe_join_and_config_but_due_runs(kanban_home, monkeypatch):
     from hermes_cli import kanban_ci_progress as ci
     monkeypatch.setattr(ci, "submit_sweep", Mock(return_value=None))
