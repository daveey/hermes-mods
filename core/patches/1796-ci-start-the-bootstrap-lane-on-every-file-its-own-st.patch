From e52e00c5d6a8cfb1575ba5b52ea8fb73bc3cebe7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 19:45:43 -0800
Subject: [PATCH] ci: start the bootstrap lane on every file its own steps run
 [daveey]

The lane's pytest step runs tests/scripts/test_fresh_source_install.py in a bare interpreter (pytest, pytest-asyncio, ruamel.yaml, packaging), so a harness edit the full suite tolerates can break this lane alone. b4bb0d87b0 added an autouse fixture in tests/_fixtures/offline_catalogs.py that imports httpx; its PR skipped the lane because only scripts/install.sh, setup-hermes.sh and apps/bootstrap-installer/ started it, and main went red on the next push (run 41556904515). #727's fix skipped the lane the same way.

The lane now also starts on the scripts its steps run (gen-bootstrap-pins, verify-bootstrap-version-stamp, scripts/ci/python_packages), its suite and the helper module it imports (tests/pm/_fixtures.py), and the shared pytest harness (_PY_TEST_HARNESS), as the hermes_state lane already does.

test_bootstrap_lane_starts_on_every_file_its_own_steps_run reads bootstrap-installer.yml, the suites' and the root conftest's tests.* imports and run_tests.sh's helpers, and fails until each file starts the lane: 17 files did not on main. About 1.3% of main commits over the last 14 days touched these paths; the lane takes about 2 minutes.
---
 scripts/ci/classify_changes.py    | 18 +++++++++++++-
 tests/ci/test_classify_changes.py | 41 ++++++++++++++++++++++++++++---
 2 files changed, 54 insertions(+), 5 deletions(-)

diff --git a/scripts/ci/classify_changes.py b/scripts/ci/classify_changes.py
index 19333649c7e..c0641013e55 100644
--- a/scripts/ci/classify_changes.py
+++ b/scripts/ci/classify_changes.py
@@ -262,6 +262,21 @@ _PY_TEST_HARNESS = (
 # hermes_state.py and every hermes_state_* sibling, their tests, the shared pytest harness
 # that runs them, and the dependency manifests they import through.
 _HERMES_STATE_PATHS = ("hermes_state", "tests/hermes_state/", *_PY_TEST_HARNESS, *_DEP_MANIFESTS)
+# The bootstrap lane's own inputs beyond the installer it guards: the scripts its
+# steps run, its pytest suite and the helper that suite imports, and the shared
+# pytest harness. That suite runs in a bare interpreter (four packages, none of
+# Hermes' dependencies), so a harness edit the full suite tolerates can break
+# this lane alone; when only main's push ran it, an autouse fixture that
+# imported httpx turned main red. tests/ci/test_classify_changes.py derives the
+# list from bootstrap-installer.yml and fails until each file starts the lane.
+_BOOTSTRAP_LANE_INPUTS = (
+    "scripts/gen-bootstrap-pins.py",
+    "scripts/verify-bootstrap-version-stamp.py",
+    "scripts/ci/python_packages.py",
+    "tests/scripts/test_fresh_source_install.py",
+    "tests/pm/_fixtures.py",
+    *_PY_TEST_HARNESS,
+)
 # The compare API returns at most this many files, so a list this long may be truncated.
 COMPARE_FILE_CAP = 300
 # Both Desktop suites package the app and share this harness (the update
@@ -682,7 +697,8 @@ def classify(files: list[str], run_e2e: bool = False) -> dict[str, bool]:
         "uv_lock": any(f in ("pyproject.toml", "uv.lock") for f in files),
         "npm_lock": npm_lock,
         "bootstrap": any(
-            f.startswith(_BOOTSTRAP_PATHS) or f in _BOOTSTRAP_FILES for f in files
+            f.startswith(_BOOTSTRAP_PATHS + _BOOTSTRAP_LANE_INPUTS) or f in _BOOTSTRAP_FILES
+            for f in files
         ),
         "desktop_updater": any(_is_desktop_updater(f) for f in files),
         "rust": any(_is_rust(f) for f in files),
diff --git a/tests/ci/test_classify_changes.py b/tests/ci/test_classify_changes.py
index 5db80f31179..75a5c44f6e3 100644
--- a/tests/ci/test_classify_changes.py
+++ b/tests/ci/test_classify_changes.py
@@ -252,14 +252,15 @@ CASES = {
     ),
     # conftest.py owns the _OS_MARKS skip logic, so it re-arms the
     # desktop_updater integration tests too (fail-open).
-    # The shared harness can break every Python E2E suite.
+    # The shared harness can break every Python E2E suite, and the bootstrap
+    # lane's bare-interpreter pytest step loads it as well.
     "conftest → python + desktop_updater + python e2e": (
         ["tests/conftest.py"],
-        _lanes(python=True, python_prod=False, scan=True, desktop_updater=True, e2e=True, e2e_upgrade=True, hermes_state=True),
+        _lanes(python=True, python_prod=False, scan=True, bootstrap=True, desktop_updater=True, e2e=True, e2e_upgrade=True, hermes_state=True),
     ),
     "conftest fixture module → python + desktop_updater + python e2e": (
         ["tests/_fixtures/platform_gating.py"],
-        _lanes(python=True, python_prod=False, scan=True, desktop_updater=True, e2e=True, e2e_upgrade=True, hermes_state=True),
+        _lanes(python=True, python_prod=False, scan=True, bootstrap=True, desktop_updater=True, e2e=True, e2e_upgrade=True, hermes_state=True),
     ),
     "tests + prod source → both lanes": (
         ["tests/agent/test_foo.py", "agent/x.py"],
@@ -271,7 +272,7 @@ CASES = {
     # .py/.pth payloads are what it scans for).
     "test runner script → python_prod stays on": (
         ["scripts/run_tests_parallel.py"],
-        _lanes(python=True, scan=True, e2e=True, e2e_upgrade=True, hermes_state=True),
+        _lanes(python=True, scan=True, bootstrap=True, e2e=True, e2e_upgrade=True, hermes_state=True),
     ),
     # Supply-chain lanes
     ".pth file → scan": (["evil.pth"], _lanes(python=True, scan=True)),
@@ -656,6 +657,38 @@ def test_remote_backends_lane_runs_test_files_that_exist_and_start_it():
     assert "scripts/run_tests.sh --fail-on-skip" in text
 
 
+def _repo_imports(rel: str) -> list[str]:
+    """Repo files behind the top-level ``tests.*`` / ``scripts.*`` imports of ``rel``."""
+    text = (_REPO / rel).read_text(encoding="utf-8")
+    paths = []
+    for module in re.findall(r"^(?:from|import)\s+((?:tests|scripts)(?:\.\w+)+)", text, re.MULTILINE):
+        base = module.replace(".", "/")
+        paths.append(f"{base}.py" if (_REPO / f"{base}.py").is_file() else f"{base}/__init__.py")
+    return paths
+
+
+def test_bootstrap_lane_starts_on_every_file_its_own_steps_run():
+    """The lane's pytest step runs in a bare interpreter (four packages, none of
+    Hermes' dependencies), so a harness edit the full suite tolerates can break
+    this lane alone. An autouse fixture in tests/_fixtures/ that imported httpx
+    did: its PR skipped the lane, since nothing it touched started it, and main
+    went red on the next push. So every script the lane's steps run, its pytest
+    files, the modules those import, and the conftest harness start it.
+    """
+    text = (_REPO / ".github/workflows/bootstrap-installer.yml").read_text(encoding="utf-8-sig")
+    suites = sorted(set(re.findall(r"scripts/run_tests\.sh\s+(tests/[\w/.-]+\.py)", text)))
+    assert suites, "found no pytest file in the lane: the parse is broken, not the routing"
+    scripts = set(re.findall(r"(?<![\w/.-])(scripts/[\w/.-]+\.(?:py|sh))", text))
+    scripts |= {m.replace(".", "/") + ".py" for m in re.findall(r"python3? -m (scripts(?:\.\w+)+)", text)}
+    runner = (_REPO / "scripts/run_tests.sh").read_text(encoding="utf-8")
+    scripts |= set(re.findall(r"(scripts/run_tests\w*\.py)", runner))
+    loaded = {*suites, *scripts, "tests/conftest.py"}
+    loaded |= {p for rel in [*suites, "tests/conftest.py"] for p in _repo_imports(rel)}
+    assert "tests/_fixtures/offline_catalogs.py" in loaded, "the conftest walk is broken"
+    assert [p for p in sorted(loaded) if not (_REPO / p).is_file()] == []
+    assert [p for p in sorted(loaded) if not classify([p])["bootstrap"]] == []
+
+
 def test_windows_venv_e2e_runs_only_test_files_that_exist():
     """``run_tests.sh`` drops a missing path (or a ``::node`` selector) without
     a word, so a stale entry silently stops running on every wine2e push."""
