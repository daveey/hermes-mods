From af3ea6ae52d677a6ae01340a3dd91d997e98baa6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 9 Nov 2026 15:07:29 +0000
Subject: [PATCH] fix(kanban): preserve unknown registry admission behavior
 [daveey]

---
 hermes_cli/kanban_runs_on_capabilities.py       |  9 +++++++--
 .../test_kanban_runs_on_label_admission.py      | 17 +++++++++++++++--
 2 files changed, 22 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_runs_on_capabilities.py b/hermes_cli/kanban_runs_on_capabilities.py
index 78a0e237760..e74a7d32bc1 100644
--- a/hermes_cli/kanban_runs_on_capabilities.py
+++ b/hermes_cli/kanban_runs_on_capabilities.py
@@ -143,12 +143,17 @@ def check_create(conn, runs_on, *, assignee: Optional[str], requires, workspace_
     if sync.board_mode(conn) != "primary":
         return
     labels = wn.normalize_runs_on(runs_on if isinstance(runs_on, str) else list(runs_on))
-    reg = wn.registry() if labels else None
+    try:
+        reg = wn.registry() if labels else None
+    except Exception:  # health: allow BLE001 -- same unknown-registry policy as check/runs_elsewhere
+        reg = None
     machines = reg.get("machines") if reg is not None else None
+    me = wn._own(conn)
     # No candidates is not evidence of missing profile tools (check deliberately
     # allows unknown tools). It IS evidence of an impossible label conjunction.
     # Include held/inactive machines: temporary unavailability is not a typo.
-    if labels and machines is not None and not any(
+    # A missing self entry is incomplete evidence, as in runs_elsewhere.
+    if labels and machines and machines.get(me) and not any(
             set(labels) <= wn.effective_labels(entry, name) for name, entry in machines.items()):
         raise ValueError(
             f"runs_on={labels}: no enrolled machine carries all these labels. Nothing was written. "
diff --git a/tests/hermes_cli/test_kanban_runs_on_label_admission.py b/tests/hermes_cli/test_kanban_runs_on_label_admission.py
index 1f4ed7bb84a..4c30509865e 100644
--- a/tests/hermes_cli/test_kanban_runs_on_label_admission.py
+++ b/tests/hermes_cli/test_kanban_runs_on_label_admission.py
@@ -42,7 +42,20 @@ def test_registered_labels_are_not_rejected_while_machines_held(gws, monkeypatch
     assert kb.create_task(hub.conn, title="held not impossible", assignee="default", requires=[], runs_on=labels)
 
 
-def test_unknown_registry_does_not_claim_labels_are_impossible(gws, monkeypatch):
+@pytest.mark.parametrize("registry", [None, {"machines": {}}, {"machines": {"other": {"labels": []}}}])
+def test_unknown_registry_does_not_claim_labels_are_impossible(gws, monkeypatch, registry):
     hub, _ = gws
-    monkeypatch.setattr(wn, "registry", lambda: None)
+    monkeypatch.setattr(wn, "registry", lambda: registry)
     assert kb.create_task(hub.conn, title="unknown", assignee="default", requires=[], runs_on=["custom"])
+    assert kb.create_task(hub.conn, title="self", assignee="default", requires=[], runs_on=[f"machine:{HUB}"])
+
+
+def test_registry_exception_preserves_unknown_behavior(gws, monkeypatch):
+    hub, _ = gws
+
+    def unavailable():
+        from hermes_cli.kanban_sync_client import SyncUnavailable
+        raise SyncUnavailable("identity unavailable")
+
+    monkeypatch.setattr(wn, "registry", unavailable)
+    assert kb.create_task(hub.conn, title="unknown", assignee="default", requires=[], runs_on=["linux"])
-- 
2.55.0

