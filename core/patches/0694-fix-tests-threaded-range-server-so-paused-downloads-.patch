From a081ba9470cba41ef7f8eb832499d8fa9ce5dcfc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 09:57:42 +0000
Subject: [PATCH] fix(tests): threaded range server so paused downloads stop in
 0.04 s, not 3.7 s [daveey]

test_quickstart_pause_stops_the_sequence flaked on main CI (run
40653617896, slice 2: 'running' == 'paused', passed on retry). The shared
dl_server was a single-threaded HTTPServer (backlog 5) while the
downloader opens 8 range connections, so a paused job had to wait for
every queued connection to be drained in turn: pause->paused measured a
steady 3.66 s on hub, a quarter of the tests' 15 s poll deadline, which a
loaded CI runner exceeds. A ThreadingHTTPServer (like any real host)
brings it to 0.04 s; all 22 files using the server pass (202 tests).
---
 tests/pm/_range_server.py | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/tests/pm/_range_server.py b/tests/pm/_range_server.py
index 699469307a..fdeab89b22 100644
--- a/tests/pm/_range_server.py
+++ b/tests/pm/_range_server.py
@@ -11,7 +11,7 @@ from __future__ import annotations
 import hashlib
 import threading
 import time
-from http.server import BaseHTTPRequestHandler, HTTPServer
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
 
 import pytest
 
@@ -110,7 +110,15 @@ def dl_server():
     RangeHandler.no_range = False
     RangeHandler.etags = True
     RangeHandler.chunk = 1 << 20
-    server = HTTPServer(("127.0.0.1", 0), RangeHandler)
+    # Threaded, like any real file host: the downloader opens up to 8 range
+    # connections at once. A single-threaded server (listen backlog 5)
+    # served them one by one, so a paused download had to wait for every
+    # queued connection to be drained in turn (plus SYN-retry backoff for
+    # the overflow one) — ~3.7 s idle, and past the pause tests' 15 s poll
+    # deadline on a loaded CI runner.
+    server = ThreadingHTTPServer(("127.0.0.1", 0), RangeHandler)
+    server.daemon_threads = True
+    server.block_on_close = False
     thread = threading.Thread(target=server.serve_forever, daemon=True)
     thread.start()
     try:
-- 
