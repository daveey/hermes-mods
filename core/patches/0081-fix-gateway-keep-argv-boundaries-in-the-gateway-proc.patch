From 2ef2ab094cd9135938eb43c4546abb87be552e80 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 15 Oct 2026 08:22:58 -0700
Subject: [PATCH] fix(gateway): keep argv boundaries in the gateway process
 scan [daveey]

ps -o command= and a NUL->space /proc read join argv with spaces, so a
whitespace-bearing interpreter path (~/Applications/Hermes Python.app)
split in two and the inline-source walk never reached the Hermes runpy
bootstrap. find_gateway_pids(all_profiles=True) returned [] for the
mini's launchd gateway, so hermes update never restarted it through the
manual/external-supervisor path. Quote whitespace-bearing args from exact
argv (shared argv_to_command_line), and re-read the exact argv for ps
rows that mention 'gateway' but fail the matcher.
---
 gateway/status.py                             | 26 ++++--
 hermes_cli/gateway.py                         | 19 +++-
 .../test_gateway_scan_spaced_interpreter.py   | 93 +++++++++++++++++++
 3 files changed, 127 insertions(+), 11 deletions(-)
 create mode 100644 tests/hermes_cli/test_gateway_scan_spaced_interpreter.py

diff --git a/gateway/status.py b/gateway/status.py
index a3a081d139..d0d72b0f02 100644
--- a/gateway/status.py
+++ b/gateway/status.py
@@ -507,6 +507,22 @@ def get_process_start_time(pid: int) -> Optional[int]:
     return _get_process_start_time(pid)
 
 
+def argv_to_command_line(parts) -> str:
+    """[daveey] One command-line string from an exact argv, for the identity matchers.
+
+    Whitespace-bearing args (``~/Applications/Hermes Python.app/...``, an inline ``-c`` source) are
+    double-quoted so the quote-aware tokenizer in ``_gateway_command_subcommand`` keeps each one a
+    single token. A space-joined argv (``ps -o command=``, a NUL->space ``/proc`` read) loses those
+    boundaries: the interpreter path splits in two, the ``-c`` walk stops at its second half, and a
+    Hermes runpy bootstrap (``python -I -c "import sys, runpy; …"``) stops matching as a gateway.
+    Args that already carry a double quote stay as-is. Empty parts (the trailing NUL) are dropped."""
+    return " ".join(
+        f'"{part}"' if any(c.isspace() for c in part) and '"' not in part else part
+        for part in parts
+        if part
+    ).strip()
+
+
 def _read_process_cmdline(pid: int) -> Optional[str]:
     """Process command line as one string: /proc, then psutil, then ``ps``.
 
@@ -518,18 +534,12 @@ def _read_process_cmdline(pid: int) -> Optional[str]:
     with contextlib.suppress(OSError):
         raw = Path(f"/proc/{pid}/cmdline").read_bytes()
         if raw:
-            return raw.replace(b"\x00", b" ").decode("utf-8", errors="ignore").strip()
+            return argv_to_command_line(raw.decode("utf-8", errors="ignore").split("\x00"))
     with contextlib.suppress(Exception):
         import psutil  # type: ignore
         cmdline_parts = psutil.Process(pid).cmdline()
         if cmdline_parts:
-            # [daveey] Quote whitespace-bearing args (``~/Applications/Hermes Python.app/...``) so
-            # the quote-aware tokenizer in ``_gateway_command_subcommand`` keeps them one token.
-            # Args that already carry a double quote (an inline ``-c`` source) stay as-is.
-            return " ".join(
-                f'"{part}"' if any(c.isspace() for c in part) and '"' not in part else part
-                for part in cmdline_parts
-            )
+            return argv_to_command_line(cmdline_parts)
     if not _IS_WINDOWS:
         with contextlib.suppress(OSError, subprocess.TimeoutExpired):
             result = subprocess.run(
diff --git a/hermes_cli/gateway.py b/hermes_cli/gateway.py
index 9a3c0dd716..e785e27e58 100644
--- a/hermes_cli/gateway.py
+++ b/hermes_cli/gateway.py
@@ -561,7 +561,9 @@ def _iter_proc_cmdlines(exclude_pids: set[int]):
                 cmdline = _f.read().decode("utf-8", errors="replace")
         except (OSError, PermissionError):
             continue
-        yield pid, cmdline.replace("\x00", " ")
+        # [daveey] Keep argv boundaries: a whitespace-bearing arg must stay one token for the matcher.
+        from gateway.status import argv_to_command_line
+        yield pid, argv_to_command_line(cmdline.split("\x00"))
 
 
 def _scan_gateway_pids(
@@ -621,10 +623,21 @@ def _scan_gateway_pids(
         # wmic/CIM listing): only the native default home keeps the legacy bare-argv claim.
         return current_home_is_native
 
-    def _consider(pid: int, command: str) -> None:
-        matches_runtime = looks_like_gateway_command_line(command) or (
+    def _matches_runtime(command: str) -> bool:
+        return looks_like_gateway_command_line(command) or (
             include_restart_managers and looks_like_gateway_runtime_command_line(command)
         )
+
+    def _consider(pid: int, command: str) -> None:
+        matches_runtime = _matches_runtime(command)
+        if not matches_runtime and "gateway" in command.lower() and pid not in exclude_pids:
+            # [daveey] ``ps -o command=`` joins argv with spaces, so a whitespace-bearing argv (the
+            # ``Hermes Python.app`` interpreter running Hermes' runpy bootstrap) loses its token
+            # boundaries and fails the matcher. Re-read the exact argv for candidate rows only.
+            from gateway.status import _read_process_cmdline
+            exact = _read_process_cmdline(pid)
+            if exact and exact != command and _matches_runtime(exact):
+                matches_runtime, command = True, exact
         if matches_runtime and not pid_is_other_users(pid) and (all_profiles or _matches_current_profile(pid, command)):
             _append_unique_pid(pids, pid, exclude_pids)
 
diff --git a/tests/hermes_cli/test_gateway_scan_spaced_interpreter.py b/tests/hermes_cli/test_gateway_scan_spaced_interpreter.py
new file mode 100644
index 0000000000..1ebfacd2a8
--- /dev/null
+++ b/tests/hermes_cli/test_gateway_scan_spaced_interpreter.py
@@ -0,0 +1,93 @@
+"""A gateway run by an interpreter whose path contains a space must still be found by the scan.
+
+The mini's launchd gateway runs as ``~/Applications/Hermes Python.app/Contents/MacOS/python3.14 -I -c
+"import sys, runpy; …; sys.argv = [… 'gateway', 'run', '--external-supervisor']; runpy.run_path(…)"``.
+``ps -o command=`` joins argv with spaces, so the interpreter path splits in two, the inline-source
+walk stops at ``Python.app/…`` and the strict matcher rejected the row. ``find_gateway_pids`` then
+returned ``[]`` and ``hermes update`` never restarted the gateway through the fleet path.
+"""
+
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+import hermes_cli.gateway as gateway_mod
+from gateway.status import argv_to_command_line, looks_like_gateway_command_line
+
+_PY = "/Users/me/Applications/Hermes Python.app/Contents/MacOS/python3.14"
+_SRC = (
+    "import sys, runpy; sys.path.insert(0, '/Users/me/code/hermes-agent'); "
+    "sys.argv = ['/Users/me/code/hermes-agent/.venv/bin/hermes', 'gateway', 'run', '--external-supervisor']; "
+    "runpy.run_path('/Users/me/code/hermes-agent/.venv/bin/hermes', run_name='__main__')"
+)
+_ARGV = [_PY, "-I", "-c", _SRC]
+_PS_ROW = " ".join(_ARGV)  # what ``ps -Aww -o pid=,command=`` prints: argv boundaries lost
+
+
+def test_exact_argv_of_runpy_bootstrap_under_spaced_interpreter_is_a_gateway():
+    assert looks_like_gateway_command_line(argv_to_command_line(_ARGV))
+
+
+def test_argv_to_command_line_drops_trailing_nul_part_and_keeps_plain_argv():
+    assert argv_to_command_line(["python", "-m", "hermes_cli.main", "gateway", "run", ""]) == (
+        "python -m hermes_cli.main gateway run"
+    )
+
+
+def test_non_gateway_inline_source_under_spaced_interpreter_stays_rejected():
+    """Control: the #107002 rule holds — an arbitrary ``-c`` program carrying a gateway argv is not one."""
+    argv = [_PY, "-c", "import subprocess, sys; subprocess.run(sys.argv[1:])", "hermes", "gateway", "run"]
+    assert not looks_like_gateway_command_line(argv_to_command_line(argv))
+
+
+@pytest.mark.platforms("linux", "macos")
+def test_ps_scan_rereads_exact_argv_for_space_split_gateway_rows():
+    ps_out = f"4242 {_PS_ROW}\n4343 /usr/bin/python3 -m some_other_thing gateway-ish\n"
+    reads = []
+
+    def _exact(pid):
+        reads.append(pid)
+        return argv_to_command_line(_ARGV) if pid == 4242 else "/usr/bin/python3 -m some_other_thing gateway-ish"
+
+    with (
+        patch("os.path.isdir", side_effect=lambda p: p != "/proc"),
+        patch("hermes_cli.gateway._get_ancestor_pids", return_value=set()),
+        patch("hermes_cli.gateway_migrate_guards.pid_is_other_users", return_value=False),
+        patch("gateway.status._read_process_cmdline", side_effect=_exact),
+        patch("subprocess.run", return_value=MagicMock(returncode=0, stdout=ps_out, stderr="")),
+    ):
+        assert gateway_mod._scan_gateway_pids(set(), all_profiles=True) == [4242]
+    assert 4242 in reads
+
+
+@pytest.mark.platforms("linux", "macos")
+def test_ps_scan_does_not_reread_rows_without_gateway_token():
+    """Cost control: only candidate rows pay the per-pid argv read."""
+    ps_out = "5151 /bin/zsh -l\n"
+    with (
+        patch("os.path.isdir", side_effect=lambda p: p != "/proc"),
+        patch("hermes_cli.gateway._get_ancestor_pids", return_value=set()),
+        patch("gateway.status._read_process_cmdline") as read,
+        patch("subprocess.run", return_value=MagicMock(returncode=0, stdout=ps_out, stderr="")),
+    ):
+        assert gateway_mod._scan_gateway_pids(set(), all_profiles=True) == []
+    read.assert_not_called()
+
+
+@pytest.mark.platforms("linux")
+def test_proc_scan_keeps_argv_boundaries():
+    raw = "\x00".join(_ARGV) + "\x00"
+
+    def _open(path, mode="r", **kwargs):
+        m = MagicMock()
+        m.read.return_value = raw.encode()
+        m.__enter__ = lambda s: s
+        m.__exit__ = MagicMock(return_value=False)
+        return m
+
+    with (
+        patch("os.listdir", return_value=["4242"]),
+        patch("builtins.open", side_effect=_open),
+    ):
+        rows = list(gateway_mod._iter_proc_cmdlines(set()))
+    assert rows and looks_like_gateway_command_line(rows[0][1])
-- 
