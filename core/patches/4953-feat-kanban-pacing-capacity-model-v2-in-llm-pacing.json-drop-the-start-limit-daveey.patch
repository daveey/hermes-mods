+        "anthropic": [15, 100], "openrouter": [7, 0], "openai-codex": [22, 1], "xai-oauth": [3, 0]}
+    counters = mt.counters(tmp_path)
+    assert counters["tokens_io_total"] == 47 and "tokens_by_provider" not in counters  # the 10 s path is unchanged
