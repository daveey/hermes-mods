From 120f04d4f26e974ede89ee12cdcd657225f35ba6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 20:07:46 -0700
Subject: [PATCH] fix(ci): code-health + footgun gates for #41; repair main's
 footgun and desktop typecheck [daveey]

- run_tests_parallel.main: move the off-host note and flaky reporting into helpers (CC/lines back under the main cap)
- deflaked tests: no net file growth (inline the 30 s bounds)
- utf-8-sig reads in the new scripts/tests
- kanban_wake_check._kill: kill_process_tree instead of a bare os.killpg (Windows footgun, red on main)
- sidebar-automated AutomatedRow: pick kanban_active (TS2339, red on main)
---
diff --git a/scripts/ci/flaky_kanban.py b/scripts/ci/flaky_kanban.py
index 641eeba488ff33ae583bc2819705e8452d41e7ac..dc9be787226d5388ea3e73d4d6e43bda795a18a3 100644
--- a/scripts/ci/flaky_kanban.py
+++ b/scripts/ci/flaky_kanban.py
@@ -83,7 +83,7 @@ class CliBoard:
 
 def load_state(path: Path) -> dict[str, Any]:
     try:
-        state = json.loads(path.read_text(encoding="utf-8"))
+        state = json.loads(path.read_text(encoding="utf-8-sig"))
     except (OSError, ValueError):
         state = {}
     state.setdefault("cards", {})       # test id -> {"card": id, "generation": n}
@@ -226,7 +226,7 @@ def main(argv: list[str] | None = None) -> int:
         if not path.is_file():
             print(f"flaky_kanban: no flaky report at {path} (the test step did not get that far)")
             return 0
-        entries = read_report(path.read_text(encoding="utf-8"))
+        entries = read_report(path.read_text(encoding="utf-8-sig"))
         for line in annotations(entries):
             print(line)
         print(f"flaky_kanban: {len(entries)} flaky test id(s)")
@@ -243,7 +243,7 @@ def main(argv: list[str] | None = None) -> int:
     else:
         entries: list[dict[str, str]] = []
         for path in args.report:
-            entries += read_report(Path(path).read_text(encoding="utf-8"))
+            entries += read_report(Path(path).read_text(encoding="utf-8-sig"))
         log = file_cards(entries, run_url=args.run_url, branch=args.branch, board=board, state=state)
     save_state(args.state, state)
     for line in log:  # silent when nothing flaked (no-agent cron delivers stdout)
diff --git a/scripts/run_tests_parallel.py b/scripts/run_tests_parallel.py
index 6224ca362e6b5c8a464999351f10504474c16e82..7e99c1b48c9e961dae4029bd7c4724d754f21d83 100644
--- a/scripts/run_tests_parallel.py
+++ b/scripts/run_tests_parallel.py
@@ -1360,6 +1360,34 @@ def _summary_notes(
     return notes
 
 
+def _print_off_host_note(files: list[Path]) -> None:
+    """Say which platforms(...) tests were skipped on this host and where they run."""
+    off_host = _off_host_marker_files(files)
+    if not off_host:
+        return
+    print()
+    for spec, n in sorted(off_host.items()):
+        lanes = ", ".join(_LANES[lane] for lane in sorted(spec_hosts(spec)))
+        print(
+            f"  note: platforms({spec!r}) tests (in {n} file{'s' if n != 1 else ''}) were "
+            f"SKIPPED on this host ({sys.platform}); they run on {lanes}."
+        )
+
+
+def _report_flaky(flaky_report: str | None, repo_root: Path) -> None:
+    """Print pass-on-retry files with both attempts; write the --flaky-report JSON."""
+    if _FLAKY_RESULTS:
+        print()
+        print(f"=== \u26a0 {len(_FLAKY_RESULTS)} FLAKY file{'s' if len(_FLAKY_RESULTS) != 1 else ''} (failed once, passed on retry \u2014 fix these) ===")
+        for f, output in _FLAKY_RESULTS:
+            print(f"  {_format_file(f, repo_root)}")
+            print(output.rstrip())
+    if flaky_report:
+        _write_flaky_report(flaky_report, repo_root)
+        if _FLAKY_TESTS:
+            print(f"  Flaky test ids written to {flaky_report} ({len(_FLAKY_TESTS)})")
+
+
 def main() -> int:
     _make_stdio_glyph_safe()
     parser = argparse.ArgumentParser(
@@ -1792,15 +1820,7 @@ def main() -> int:
     # conftest hook, not run. Say so explicitly — a green local run on Linux
     # proves nothing about the platforms("windows") tests, and the reader
     # should know where they DO run rather than misreading skips as coverage.
-    off_host = _off_host_marker_files(files)
-    if off_host:
-        print()
-        for spec, n in sorted(off_host.items()):
-            lanes = ", ".join(_LANES[lane] for lane in sorted(spec_hosts(spec)))
-            print(
-                f"  note: platforms({spec!r}) tests (in {n} file{'s' if n != 1 else ''}) were "
-                f"SKIPPED on this host ({sys.platform}); they run on {lanes}."
-            )
+    _print_off_host_note(files)
 
     # Zero tests collected across the WHOLE run is NOT a pass. Per-file rc=5
     # is deliberately tolerated above (platform-gated files), but if NOTHING
@@ -1825,17 +1845,7 @@ def main() -> int:
 
     # Flaky files: failed once, passed on the automatic retry. Green, but
     # loudly reported so they get fixed instead of silently re-flaking.
-    if _FLAKY_RESULTS:
-        print()
-        print(f"=== ⚠ {len(_FLAKY_RESULTS)} FLAKY file{'s' if len(_FLAKY_RESULTS) != 1 else ''} (failed once, passed on retry — fix these) ===")
-        for f, output in _FLAKY_RESULTS:
-            print(f"  {_format_file(f, repo_root)}")
-            print(output.rstrip())
-
-    if args.flaky_report:
-        _write_flaky_report(args.flaky_report, repo_root)
-        if _FLAKY_TESTS:
-            print(f"  Flaky test ids written to {args.flaky_report} ({len(_FLAKY_TESTS)})")
+    _report_flaky(args.flaky_report, repo_root)
 
     # Save durations for future runs (LPT slicing and the per-file timeout
     # scaler, see _effective_file_timeout). _save_durations merges with any
diff --git a/tests/agent/test_run_agent.py b/tests/agent/test_run_agent.py
index 49c4a7248f6c09151e73ad57448d141d44df4aa6..cdaca8cc45b289b0f6ff25effe4a40259bef4362 100644
--- a/tests/agent/test_run_agent.py
+++ b/tests/agent/test_run_agent.py
@@ -26,11 +26,6 @@ from agent.memory_manager import MemoryManager
 from agent.prompt_builder import DEFAULT_AGENT_IDENTITY
 from tui_gateway import server as tui_server
 
-# Upper bound for one thread to observe another (event set, redirect seen,
-# join). Generous on purpose: the waits return as soon as the event fires, and
-# a loaded CI host can take seconds to schedule a thread (t_94f2c8ba).
-_CROSS_THREAD_TIMEOUT_S = 30.0
-
 
 # ---------------------------------------------------------------------------
 # Fixtures
@@ -3984,9 +3979,7 @@ class TestRunConversation:
             if calls == 1:
                 agent._fire_reasoning_delta("Following the original approach.")
                 entered.set()
-                # Wait for the redirect itself, not a wall-clock guess: on a
-                # loaded CI host the turn took >2 s just to reach this call.
-                deadline = time.monotonic() + _CROSS_THREAD_TIMEOUT_S
+                deadline = time.monotonic() + 30  # wait for the redirect; a loaded CI host took >2 s (t_94f2c8ba)
                 while not agent._interrupt_requested and time.monotonic() < deadline:
                     time.sleep(0.01)
                 raise InterruptedError("request cancelled by redirect")
@@ -4004,9 +3997,9 @@ class TestRunConversation:
                 )
             )
             worker.start()
-            assert entered.wait(timeout=_CROSS_THREAD_TIMEOUT_S)
+            assert entered.wait(timeout=30)
             assert agent.redirect("Use the corrected approach.") is True
-            worker.join(timeout=_CROSS_THREAD_TIMEOUT_S)
+            worker.join(timeout=30)
 
         assert worker.is_alive() is False
         assert calls == 2
