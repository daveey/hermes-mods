From 10b860a6ea5cb29c7029cc1b61fb5b0aa4421f81 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 06:07:41 +0000
Subject: [PATCH] [daveey] Fail closed on unpredictable SQLite targets under
 offline reservations

A file: URI with an escaped NUL (SQLite truncates the name there), a custom VFS,
a remote authority or a connection factory that substitutes its own path could
open a file other than the one the reservation check predicted. Treat
unpredictable URIs as conflicting with every raw reservation, re-check the file
SQLite actually opened before any statement runs, and make the header probe wait
for a foreign reservation as it used to wait for the registry lock.
---
 hermes_cli/sqlite_offline_reservations.py     | 31 +++++--
 hermes_cli/sqlite_safe_read.py                | 54 +++++++----
 .../test_sqlite_offline_reservations.py       | 16 ++--
 .../test_sqlite_reservation_adversarial.py    | 92 +++++++++++++++++++
 4 files changed, 158 insertions(+), 35 deletions(-)

diff --git a/hermes_cli/sqlite_offline_reservations.py b/hermes_cli/sqlite_offline_reservations.py
index 108fb48828..d509c8e68c 100644
--- a/hermes_cli/sqlite_offline_reservations.py
+++ b/hermes_cli/sqlite_offline_reservations.py
@@ -9,22 +9,35 @@ from __future__ import annotations
 import os
 from pathlib import Path
 import threading
-from urllib.parse import parse_qs, unquote, urlsplit
+from urllib.parse import parse_qs, unquote_to_bytes, urlsplit
 
 
 _active: list[tuple[str, int, threading.Event]] = []
+# The target cannot be predicted before SQLite parses it: exclude every reservation.
+UNKNOWN = object()
 
 
 def database_key(path, *, uri=False):
-    value = os.fsdecode(path)
-    if uri and value.startswith("file:"):
-        parsed = urlsplit(value)
-        value = unquote(parsed.path)
-        if parse_qs(parsed.query).get("mode") == ["memory"]:
+    """Canonical file SQLite will open for *path*; ``None`` when nothing on disk, ``UNKNOWN``
+    when SQLite's own parsing could pick a file this prediction would miss."""
+    try:
+        value = os.fsdecode(path)
+        if uri and value.startswith("file:"):
+            parsed = urlsplit(value)
+            query = parse_qs(parsed.query, keep_blank_values=True)
+            # SQLite decodes bytes and stops at an escaped NUL; a VFS may map names anywhere.
+            raw = unquote_to_bytes(parsed.path)
+            if (os.name == "nt" or b"\x00" in raw or "vfs" in query
+                    or parsed.netloc not in ("", "localhost")):
+                return UNKNOWN
+            value = os.fsdecode(raw)
+            if query.get("mode") == ["memory"]:
+                return None
+        if value in ("", ":memory:"):
             return None
-    if value in ("", ":memory:"):
-        return None
-    return str(Path(value).resolve())
+        return str(Path(value).resolve())
+    except (OSError, RuntimeError, ValueError):
+        return UNKNOWN
 
 
 def overlaps(left, right):
diff --git a/hermes_cli/sqlite_safe_read.py b/hermes_cli/sqlite_safe_read.py
index 053bda678e..a1cae32102 100644
--- a/hermes_cli/sqlite_safe_read.py
+++ b/hermes_cli/sqlite_safe_read.py
@@ -224,13 +224,17 @@ def connect_tracked(
                                uri=tracking_path is None and kwargs.get("uri", False))
     # An arbitrary opener may ignore path and run SQL before returning. Without
     # an explicit tracking_path, conservatively exclude every raw reservation.
-    with _tracking_access(wait_for_tracking, key=key,
-                          unknown=connect_fn is not None and tracking_path is None):
+    unknown = key is offline.UNKNOWN or (connect_fn is not None and tracking_path is None)
+    with _tracking_access(wait_for_tracking, key=key, unknown=unknown):
         conn = opener(str(path), **kwargs)
         try:
             resolved = _key(tracking_path) if tracking_path is not None else _canonical_db_path(conn)
             if resolved is None:
                 return conn  # in-memory / unnamed: nothing on disk to byte-probe
+            if resolved != key and offline.conflicts(resolved):
+                # SQLite (or a factory) opened a reserved file the prediction missed. Nothing
+                # has read it yet; refuse before any statement can.
+                raise _tracking_busy()
             if not isinstance(conn, _TrackingMixin):
                 # The opener substituted its own factory and discarded ours (test doubles
                 # simulating FTS5-less runtimes do this). Retag the instance's class so close()
@@ -311,24 +315,34 @@ def read_header_bytes_preopen(path: Path | str, *, length: int = 100, force: boo
     cannot be opened between deciding "nothing is live" and closing this descriptor."""
     from hermes_cli import sqlite_offline_reservations as offline
 
-    with _live_lock:
-        if offline.conflicts(_key(path), raw=True):
-            return None  # a restore may currently be replacing this file
-        if not force and _live_main_key(_key(path)) is not None:
-            logger.debug(
-                "refusing byte-level read of %s: a live connection exists in "
-                "this process and close() would cancel its POSIX locks",
-                path)
-            return None
-        try:
-            # Untracked read-only caches may still hold SQLite locks. On POSIX use a
-            # never-closed descriptor even when this registry is empty (or force=True).
-            if hasattr(os, "pread"):
-                return read_header_lock_safe(path, length=length)
-            with open(path, "rb") as handle:
-                return handle.read(length)
-        except OSError:
-            return None
+    recursive = getattr(_live_lock, "_is_owned", lambda: True)()
+    while True:
+        with _live_lock:
+            pending = offline.conflicts(_key(path), raw=True)
+            if not pending:
+                return _read_header_registered(path, length, force)
+            if recursive or offline.owns_reservation():
+                return None  # cannot wait for the other owner without pinning the registry
+        pending[0][2].wait()  # a restore may be replacing this file: read it afterwards
+
+
+def _read_header_registered(path, length, force):
+    """Body of :func:`read_header_bytes_preopen` (caller holds ``_live_lock``, no reservation)."""
+    if not force and _live_main_key(_key(path)) is not None:
+        logger.debug(
+            "refusing byte-level read of %s: a live connection exists in "
+            "this process and close() would cancel its POSIX locks",
+            path)
+        return None
+    try:
+        # Untracked read-only caches may still hold SQLite locks. On POSIX use a
+        # never-closed descriptor even when this registry is empty (or force=True).
+        if hasattr(os, "pread"):
+            return read_header_lock_safe(path, length=length)
+        with open(path, "rb") as handle:
+            return handle.read(length)
+    except OSError:
+        return None
 
 
 @contextlib.contextmanager
