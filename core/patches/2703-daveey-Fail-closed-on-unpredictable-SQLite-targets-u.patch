--- a/tests/hermes_cli/test_sqlite_offline_reservations.py
+++ b/tests/hermes_cli/test_sqlite_offline_reservations.py
@@ -49,20 +49,20 @@ def test_same_thread_wait_refuses_and_nested_raw_cleanup(tmp_path):
