From fa9c993ce859cad81e6af589f2256c7b5f731065 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 8 Nov 2026 06:14:19 +0000
Subject: [PATCH] [daveey] preserve scratch custody on Board resync responses

Catch the distinct HTTP410 Resync exception at the authority boundary and stop the pass without deleting receipts or trees. Regression fails before the catch (103 pass, 1 fail), and passes afterward. Document the session-history-only SQLite reader using the existing lockguard annotation; board connections remain guarded.
---
 hermes_cli/kanban_scratch_custody.py            | 7 ++++---
 tests/hermes_cli/test_kanban_scratch_custody.py | 1 +
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_scratch_custody.py b/hermes_cli/kanban_scratch_custody.py
index 2ffd4cc47ed..bff65ac8ac7 100644
--- a/hermes_cli/kanban_scratch_custody.py
+++ b/hermes_cli/kanban_scratch_custody.py
@@ -61,7 +61,8 @@ def _state_paths():
 
 @contextlib.contextmanager
 def _state(path):
-    conn = sqlite3.connect(path.as_uri() + "?mode=ro", uri=True, timeout=1)
+    # Local session history only, never a board DB; callers supply _state_paths().
+    conn = sqlite3.connect(path.as_uri() + "?mode=ro", uri=True, timeout=1)  # noqa: kanban-lockguard
     conn.row_factory = sqlite3.Row
     try:
         yield conn
@@ -297,8 +298,8 @@ def gc_custody(conn, days):
                     continue
                 try:
                     owner = _terminal(hub, board, receipt["task_id"])
-                except (OSError, client.SyncUnavailable) as exc:
-                    # Transport failure: every later receipt would wait out its own timeout.
+                except (OSError, client.SyncUnavailable, client.Resync) as exc:
+                    # Unavailable authority: stop rather than repeat the failure for every receipt.
                     log.warning("Scratch custody preserved: task=%s path=%s reason=board_unavailable "
                                 "eligible_at=None; pass stopped (%s)", receipt["task_id"],
                                 receipt["workspace_path"], exc)
diff --git a/tests/hermes_cli/test_kanban_scratch_custody.py b/tests/hermes_cli/test_kanban_scratch_custody.py
index 849d83bb9b2..27a029cb1de 100644
--- a/tests/hermes_cli/test_kanban_scratch_custody.py
+++ b/tests/hermes_cli/test_kanban_scratch_custody.py
@@ -752,6 +752,7 @@ def test_gc_skips_unavailable_path_before_board_and_keeps_receipt(env, caplog, s
     (lambda: __import__("urllib.error").error.URLError("connection refused"), True),
     (lambda: TimeoutError("Board request exceeded its budget"), True),
     (lambda: client.SyncUnavailable("offline"), True),
+    (lambda: client.Resync("authority requires resync"), True),
     (lambda: client.HubError(404, "no such row"), False),  # a per-row answer, not transport
 ])
 def test_board_transport_failure_stops_pass(env, monkeypatch, caplog, error, stops):
