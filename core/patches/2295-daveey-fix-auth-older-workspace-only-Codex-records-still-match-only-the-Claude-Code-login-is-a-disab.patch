From 2f37939b80f1519c04888acfdc533d8eeebe158b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 06:06:35 +0000
Subject: [PATCH] [daveey] fix(auth): older workspace-only Codex records still
 match; only the Claude Code login is a disabled slot

Review of ba4dd778519:
- a record written with account=<workspace> (before <workspace>/<sub>) was skipped by the account
  guard, re-enabling its row; a row of that workspace whose account extends it now counts as the same.
- src matching is limited to claude_code (it rotates its own token). An env var keeps its value,
  which the fingerprint covers; matching env:VAR by source refused any later key put there.

Proof: 2 tests RED with the fix reverted, GREEN with it; 251 files of pool/auth/codex/xai/delegate/
routing/model tests: 2502 passed.
---
 agent/credential_pool_disabled.py                  | 11 +++++++----
 tests/agent/test_credential_pool_disabled_paths.py | 14 ++++++++++++++
 2 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/agent/credential_pool_disabled.py b/agent/credential_pool_disabled.py
index 86ed37c0404..42b7123c0a3 100644
--- a/agent/credential_pool_disabled.py
+++ b/agent/credential_pool_disabled.py
@@ -15,8 +15,9 @@ A record ``{"id", "label", "account", "fp", "src"}`` matches a row by any of:
   a row whose token names a different one, so disabling the Codex singleton slot does not disable
   whoever signs into that slot next;
 - ``fp``: a non-reversible fingerprint of the token at disable time;
-- ``src``: for borrowed sources (the Claude Code login, ``env:VAR``), the source itself, so the token
-  that source holds NOW is refused too (Claude Code refreshes its own token outside Hermes).
+- ``src``: for the Claude Code login, the source itself, so the token it holds NOW is refused too (it
+  refreshes its own token outside Hermes). This disables that login slot: another account signed into
+  Claude Code later stays refused until ``hermes auth enable``.
 
 Readers union the active store's section with the global root's, so a disable in the root home
 applies to every profile on the host. Reads are cached by each file's (mtime, size), so a
@@ -103,7 +104,9 @@ def fingerprint_of(entry: Any) -> Optional[str]:
 
 def _borrowed_source(entry: Any) -> str:
     source = str(getattr(entry, "source", "") or "")
-    return source if source == "claude_code" or source.startswith("env:") else ""
+    # Only the Claude Code login rotates its own token outside Hermes; an env var keeps its value, which
+    # the fingerprint already covers, and matching env:VAR by source would refuse any key put there later.
+    return source if source == "claude_code" else ""
 
 
 def _source_tokens(provider: str, source: str) -> set[str]:
@@ -193,7 +196,7 @@ def matches(entry: Any, keys: tuple) -> bool:
     fp = fingerprint_of(entry) or ""
     src = _borrowed_source(entry)
     for rid, rlabel, racct, rfp, rsrc in keys[2]:
-        if racct and acct and racct != acct:
+        if racct and acct and racct != acct and not acct.startswith(racct + "/"):  # older records: workspace only
             continue
         if ((rid and rid == entry_id) or (rlabel and rlabel == label) or (racct and racct == acct)
                 or (rfp and rfp == fp) or (rsrc and rsrc == src)):
diff --git a/tests/agent/test_credential_pool_disabled_paths.py b/tests/agent/test_credential_pool_disabled_paths.py
index 6a5a3e62533..ac884f8abc9 100644
--- a/tests/agent/test_credential_pool_disabled_paths.py
+++ b/tests/agent/test_credential_pool_disabled_paths.py
@@ -458,3 +458,17 @@ def test_fingerprint_follows_the_live_token_after_a_rotation():
     from agent.credential_persistence import fingerprint_secret_value
     row = SimpleNamespace(access_token="fixture-new", extra={"secret_fingerprint": fingerprint_secret_value("fixture-old")})
     assert cpd.fingerprint_of(row) == fingerprint_secret_value("fixture-new")
+
+
+def test_older_workspace_only_codex_record_still_matches_its_seat():
+    seat = SimpleNamespace(id="r0", label="device_code", access_token=_seat("ws-team", "user-a", "a@x.com"))
+    keys = cpd._keys_from_records([{"id": "r0", "label": "device_code", "account": "ws-team"}])
+    assert cpd.matches(seat, keys)
+
+
+def test_an_env_var_source_is_not_disabled_as_a_slot(monkeypatch):
+    row = SimpleNamespace(id="e0", label="anthropic_token", source="env:ANTHROPIC_TOKEN", access_token="fixture-env-1")
+    keys = cpd._keys_from_records([{"id": "e0", "label": "anthropic_token", "fp": cpd.fingerprint_of(row),
+                                    "src": cpd._borrowed_source(row)}])
+    other = SimpleNamespace(id="e1", label="anthropic_token", source="env:ANTHROPIC_TOKEN", access_token="fixture-env-2")
+    assert cpd.matches(row, keys) and not cpd.matches(other, keys)
