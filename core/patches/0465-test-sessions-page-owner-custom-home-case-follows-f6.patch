From 19a2a3de28acfe7733acb37a5a0aaaa355391412 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 04:21:25 -0700
Subject: [PATCH] test(sessions): page-owner custom-home case follows
 f6a16700fd's nested-root rule [daveey]

f6a16700fd made a HERMES_HOME nested under ~/.hermes (but not profiles/<name>)
its own root, so profile=default resolves to that home, not the native one.
The [None] case still expected the native 1-row store and turned main CI red.
The named-profile case keeps the cross-profile assertion.
---
 tests/hermes_cli/test_session_message_page_owner.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_session_message_page_owner.py b/tests/hermes_cli/test_session_message_page_owner.py
index 5d453f83ab..77f8952fb4 100644
--- a/tests/hermes_cli/test_session_message_page_owner.py
+++ b/tests/hermes_cli/test_session_message_page_owner.py
@@ -43,7 +43,10 @@ def test_message_pages_identify_the_serving_profile(tmp_path, monkeypatch, servi
     assert default["profile"] == "default"
     assert len(tail["messages"]) == 120
     assert len(older["messages"]) == 79
-    assert len(default["messages"]) == 1
+    # A named profile's "default" is the native home (1 row). A custom home nested under
+    # ~/.hermes but not in profiles/ is its own installation (f6a16700fd), so its
+    # "default" is itself: the same 199-row store, newest page.
+    assert len(default["messages"]) == (1 if serving_profile else 120)
     assert [row["content"] for row in older["messages"] + tail["messages"]] == [
         f"message-{index}" for index in range(199)
     ]
