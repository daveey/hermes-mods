From 1c6567f0edacfa9d9689a055f8fc16e1db27ba93 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 24 Oct 2026 04:14:16 +0000
Subject: [PATCH] feat(browser): scope managed Chrome requests and cleanup by
 owner [daveey]

---
diff --git a/tests/tools/test_browser_agent_lifecycle.py b/tests/tools/test_browser_agent_lifecycle.py
new file mode 100644
index 0000000000000000000000000000000000000000..5fa2d0a958e2dd0d9f525c39447e6b66ee33ec9b
--- /dev/null
+++ b/tests/tools/test_browser_agent_lifecycle.py
@@ -0,0 +1,178 @@
+"""Managed Chrome entry paths use owner leases, never ambient/shared daemons."""
+import json
+import subprocess
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+from tools import browser_use_cli as cli
+
+
+@pytest.fixture
+def managed(tmp_path, monkeypatch):
+    calls = []
+    owners = {}
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_POST(self):
+            payload = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
+            calls.append((self.path, payload))
+            if self.path.endswith('/acquire'):
+                owner = tuple(payload['owner'])
+                cap = owners.setdefault(owner, 'cap-' + str(len(owners)))
+                result = dict(capability=cap, request_id='request-' + str(len(calls)),
+                              daemon_name='lease-' + cap, endpoint=endpoint + '/lease/' + cap)
+            else:
+                result = {'ok': True}
+            body = json.dumps(result).encode()
+            self.send_response(200)
+            self.send_header('Content-Length', str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def log_message(self, *args):
+            pass
+
+    server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
+    endpoint = 'http://127.0.0.1:' + str(server.server_port)
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    config = {'browser': {'cdp_url': endpoint, 'managed_agent': {
+        'endpoint': endpoint, 'installation_id': 'test-installation'}}}
+    (tmp_path / 'config.yaml').write_text(json.dumps(config))
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.delenv('BROWSER_CDP_URL', raising=False)
+    monkeypatch.setattr(cli, '_base_subprocess_env', dict)
+    monkeypatch.setattr(cli, '_find_cli', lambda: ['unused-test-cli'])
+    monkeypatch.setattr(cli, '_attach_vault_supervisor', lambda *args: None)
+    monkeypatch.setattr(cli, '_workspace_dir', lambda task: None)
+    monkeypatch.setattr(cli, '_find_screenshot', lambda *args: None)
+    monkeypatch.setattr(cli, '_code_url_verdict', lambda code: cli._CodeUrlVerdict('', False))
+    # Raw discovery must not precede acquisition, even when idle.
+    monkeypatch.setattr('tools.browser_tool_cdp._get_cdp_override',
+                        lambda: pytest.fail('unscoped discovery'))
+    executions = []
+
+    def run(cmd, code, env, timeout):
+        executions.append((code, dict(env), timeout))
+        return subprocess.CompletedProcess(cmd, 0, 'ok', '')
+
+    monkeypatch.setattr(cli, '_run_cli_killing_process_group', run)
+    yield endpoint, calls, executions
+    from tools import browser_agent_lifecycle as lifecycle
+    lifecycle.release_all()
+    server.shutdown()
+    server.server_close()
+    thread.join(timeout=5)
+
+
+@pytest.mark.parametrize('local', [False, True])
+def test_managed_entry_acquires_before_dispatch_and_completes(managed, local):
+    endpoint, calls, executions = managed
+    result = json.loads(cli.browser_exec('print(1)', task_id='owner-a', local=local, timeout_s=900))
+    assert result['success']
+    assert [path for path, _ in calls] == ['/lifecycle/acquire', '/lifecycle/complete']
+    assert calls[0][1]['owner'][1:] == ['owner-a', 'default']
+    assert calls[0][1]['timeout_s'] == 900
+    assert executions[0][1]['BU_CDP_URL'].startswith(endpoint + '/lease/')
+    assert executions[0][1]['BU_NAME'].startswith('lease-')
+    assert executions[0][1]['BH_RUNTIME_DIR_SHARED'] == '1'
+    assert executions[0][1]['BH_TMP_DIR_SHARED'] == '1'
+
+
+def test_cleanup_releases_only_tasks_own_capabilities(managed):
+    from tools.browser_tool_lifecycle import cleanup_browser
+    _, calls, executions = managed
+    for task in ('owner-a', 'owner-b'):
+        for session in ('', 'same'):
+            assert json.loads(cli.browser_exec('print(1)', task_id=task, session=session))['success']
+    assert len({env['BU_NAME'] for _, env, _ in executions}) == 4
+    caps = [payload['capability'] for path, payload in calls if path.endswith('/complete')]
+    cleanup_browser('owner-a')
+    assert [p['capability'] for path, p in calls if path.endswith('/release')] == caps[:2]
+    assert json.loads(cli.browser_exec('print(2)', task_id='owner-b', session='same'))['success']
+    assert executions[-1][1]['BU_NAME'] == executions[-2][1]['BU_NAME']
+
+
+def test_failed_execution_completes_request(managed, monkeypatch):
+    _, calls, _ = managed
+
+    def fail(*args):
+        raise subprocess.TimeoutExpired('test', 10)
+
+    monkeypatch.setattr(cli, '_run_cli_killing_process_group', fail)
+    assert 'timed out' in json.loads(cli.browser_exec('print(1)', task_id='owner-a'))['error']
+    assert calls[-1][0] == '/lifecycle/complete'
+
+
+def test_route_reset_does_not_release_other_sessions_but_shutdown_does(managed):
+    from tools.browser_tool_lifecycle import cleanup_all_browsers
+    _, calls, executions = managed
+    cli.browser_exec('print(1)', task_id='owner-a')
+    cli.browser_exec('print(1)', task_id='owner-b')
+    cleanup_all_browsers()
+    assert not [p for path, p in calls if path.endswith('/release')]
+    assert len(executions) == 2  # no --reload for a managed sibling daemon
+    cleanup_all_browsers(process_shutdown=True)
+    assert len([p for path, p in calls if path.endswith('/release')]) == 2
+
+
+def test_profile_isolation_and_emergency_release_without_legacy_sessions(managed, tmp_path, monkeypatch):
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    from tools import browser_tool as bt
+    from tools import browser_tool_lifecycle as lifecycle
+    _, calls, executions = managed
+    cli.browser_exec('print(1)', task_id='same-task')
+    other = tmp_path / 'other'
+    other.mkdir()
+    (other / 'config.yaml').write_text((tmp_path / 'config.yaml').read_text())
+    token = set_hermes_home_override(str(other))
+    try:
+        cli.browser_exec('print(1)', task_id='same-task')
+        lifecycle.cleanup_browser('same-task')
+    finally:
+        reset_hermes_home_override(token)
+    caps = [p['capability'] for path, p in calls if path.endswith('/complete')]
+    assert executions[0][1]['BU_NAME'] != executions[1][1]['BU_NAME']
+    assert [p['capability'] for path, p in calls if path.endswith('/release')] == [caps[1]]
+    monkeypatch.setattr(bt, '_cleanup_done', False)
+    monkeypatch.setattr(lifecycle._real_profile, '_terminate_real_profile_chrome', lambda: None)
+    monkeypatch.setattr(lifecycle, '_stop_all_lightpanda', lambda: None)
+    monkeypatch.setattr(lifecycle, '_reap_orphaned_browser_sessions', lambda: None)
+    lifecycle._emergency_cleanup_all_sessions()
+    assert [p['capability'] for path, p in calls if path.endswith('/release')] == [caps[1], caps[0]]
+
+
+def test_managed_setup_failure_and_missing_owner_never_dispatch(managed, monkeypatch):
+    from tools import browser_agent_lifecycle as lifecycle
+    _, calls, executions = managed
+    assert 'identity' in json.loads(cli.browser_exec('print(1)'))['error']
+    assert calls == executions == []
+
+    def refused(*args, **kwargs):
+        raise lifecycle.ManagedBrowserError('deliberately disabled')
+
+    monkeypatch.setattr(lifecycle, '_post', refused)
+    assert 'disabled' in json.loads(cli.browser_exec('print(1)', task_id='owner'))['error']
+    assert executions == []
+
+
+def test_unrelated_override_does_not_use_managed_control(managed, monkeypatch):
+    _, calls, executions = managed
+    monkeypatch.setattr(cli, '_base_subprocess_env', lambda: {'BU_CDP_URL': 'http://127.0.0.1:19001'})
+    assert json.loads(cli.browser_exec('print(1)', task_id='owner'))['success']
+    assert not calls
+    assert executions[0][1]['BU_CDP_URL'] == 'http://127.0.0.1:19001'
+
+
+def test_concurrent_default_and_duplicate_named_sessions_are_distinct(managed):
+    from concurrent.futures import ThreadPoolExecutor
+    from contextvars import copy_context
+    _, _, executions = managed
+    owners = [('owner-a', ''), ('owner-b', ''), ('owner-a', 'default'), ('owner-b', 'default')]
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        futures = [pool.submit(copy_context().run, cli.browser_exec, 'print(1)', session=session, task_id=task)
+                   for task, session in owners]
+        assert all(json.loads(future.result())['success'] for future in futures)
+    assert len({env['BU_NAME'] for _, env, _ in executions}) == 4
diff --git a/tools/browser_agent_lifecycle.py b/tools/browser_agent_lifecycle.py
new file mode 100644
index 0000000000000000000000000000000000000000..752747fb78961931dc9d62e038e22a687c471090
--- /dev/null
+++ b/tools/browser_agent_lifecycle.py
@@ -0,0 +1,139 @@
+"""Opt-in lifecycle client for a dedicated Chrome agent (never personal Chrome).
+
+The supervisor owns persistence, target attribution and idle decisions. This module
+only keeps this process's capabilities for task-scoped release. A dead worker's
+request protection expires at the supervisor; open daemon sockets are not activity.
+"""
+import contextlib
+import json
+import logging
+import re
+import threading
+import urllib.error
+import urllib.parse
+import urllib.request
+
+from hermes_constants import get_hermes_home
+
+logger = logging.getLogger(__name__)
+_TOKEN = re.compile(r"^[A-Za-z0-9_-]{1,128}$")
+_lock = threading.RLock()
+_leases: dict[tuple[str, str, str, str], tuple[dict, str]] = {}
+
+
+class ManagedBrowserError(RuntimeError):
+    """An explicitly managed route cannot safely proceed."""
+
+
+def configured_route(browser_cfg: dict, env: dict) -> dict | None:
+    """Match the exact operator override before any CDP discovery or profile launch."""
+    config = browser_cfg.get("managed_agent")
+    if config is None:
+        return None
+    if not isinstance(config, dict):
+        raise ManagedBrowserError("browser.managed_agent must be a mapping")
+    if config == {"endpoint": "", "installation_id": ""}:
+        return None
+    endpoint = config.get("endpoint")
+    if not isinstance(endpoint, str):
+        raise ManagedBrowserError("browser.managed_agent.endpoint is required")
+    from tools.browser_tool_cdp import _get_cdp_override_raw
+    selected = env.get("BU_CDP_WS") or env.get("BU_CDP_URL") or _get_cdp_override_raw()
+    if selected != endpoint:
+        return None  # cloud, personal-copy and other explicit routes retain their behavior
+    parts = urllib.parse.urlsplit(endpoint)
+    if (parts.scheme != "http" or parts.hostname != "127.0.0.1" or not parts.port
+            or parts.path or parts.query or parts.fragment or parts.username or parts.password):
+        raise ManagedBrowserError("Managed agent endpoint must be an exact loopback HTTP root")
+    identity = config.get("installation_id")
+    if not isinstance(identity, str) or not identity or len(identity) > 256:
+        raise ManagedBrowserError("browser.managed_agent.installation_id is required")
+    if set(config) - {"endpoint", "installation_id"}:
+        raise ManagedBrowserError("Unknown managed_agent setting; activate the installed listener explicitly")
+    return {"endpoint": endpoint, "installation_id": identity}
+
+
+def _post(config: dict, action: str, **payload) -> dict:
+    body = json.dumps({"installation_id": config["installation_id"], **payload}).encode()
+    request = urllib.request.Request(config["endpoint"] + "/lifecycle/" + action,
+                                     data=body, headers={"Content-Type": "application/json"}, method="POST")
+    # A local lifecycle capability must never pass through a configured HTTP proxy or redirect.
+    class NoRedirect(urllib.request.HTTPRedirectHandler):
+        def redirect_request(self, *args, **kwargs):
+            return None
+
+    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
+    try:
+        with opener.open(request, timeout=60) as response:
+            result = json.loads(response.read(65537))
+        if not isinstance(result, dict) or result.get("error"):
+            raise ManagedBrowserError("Managed browser rejected lifecycle " + action)
+        return result
+    except urllib.error.HTTPError as exc:
+        # Do not echo response text: capabilities and URLs are not model-visible errors.
+        if exc.code == 403:
+            raise ManagedBrowserError("Managed browser deliberately stopped/disabled, identity invalid, or lease refused; operator activation may be required") from None
+        raise ManagedBrowserError(f"Managed browser lifecycle unavailable (HTTP {exc.code})") from None
+    except (OSError, ValueError) as exc:
+        raise ManagedBrowserError("Managed browser listener unavailable; idle wake requires the activated listener, not a stopped installation") from exc
+
+
+def _validate_grant(config: dict, result: dict) -> None:
+    for field in ("capability", "request_id", "daemon_name"):
+        value = result.get(field)
+        if not isinstance(value, str) or not _TOKEN.fullmatch(value):
+            raise ManagedBrowserError("Managed browser returned an invalid lease grant")
+    if (result.get("endpoint") != config["endpoint"] + "/lease/" + result["capability"]
+            or result["daemon_name"] != "lease-" + result["capability"]):
+        raise ManagedBrowserError("Managed browser lease endpoint or daemon identity mismatch")
+
+
+@contextlib.contextmanager
+def request_lease(config: dict, task_id: str | None, session: str, timeout: int, env: dict):
+    if not task_id:
+        raise ManagedBrowserError("Managed browser requires a tool task/session identity; refusing shared default ownership")
+    owner = (str(get_hermes_home()), task_id, f"named:{session}" if session else "default")
+    key = (*owner, config["endpoint"])
+    with _lock:
+        grant = _post(config, "acquire", owner=list(owner), timeout_s=timeout)
+        _validate_grant(config, grant)
+        _leases[key] = (dict(config), grant["capability"])
+    env.pop("BU_CDP_WS", None)
+    env["BU_CDP_URL"] = grant["endpoint"]
+    env["BU_NAME"] = grant["daemon_name"]
+    # Caller-provided harness directories otherwise use a bare 'bu' socket,
+    # silently ignoring BU_NAME and merging independently leased owners.
+    env["BH_RUNTIME_DIR_SHARED"] = "1"
+    env["BH_TMP_DIR_SHARED"] = "1"
+    env["BU_AUTOSPAWN"] = "0"  # failed owned setup must not spawn an unrelated cloud browser
+    try:
+        yield
+    finally:
+        try:
+            _post(config, "complete", capability=grant["capability"], request_id=grant["request_id"])
+        except ManagedBrowserError:
+            logger.warning("Managed browser completion unavailable; request deadline remains bounded")
+
+
+def _release(keys) -> None:
+    for key in keys:
+        config, capability = _leases[key]
+        try:
+            _post(config, "release", capability=capability)
+        except ManagedBrowserError:
+            logger.warning("Managed browser release unavailable; retaining capability for retry")
+        else:
+            _leases.pop(key, None)
+
+
+def release_task(task_id: str) -> None:
+    """Never release another profile's identically named task or a sibling task."""
+    home = str(get_hermes_home())
+    with _lock:
+        _release([key for key in _leases if key[:2] == (home, task_id)])
+
+
+def release_all() -> None:
+    """Process shutdown only: records carry the original installation and profile."""
+    with _lock:
+        _release(list(_leases))
