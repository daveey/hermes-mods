From d718b8d2bfcaab8388ce287795f0030c3dc05a56 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 04:41:36 +0000
Subject: [PATCH] [daveey] Prefer capable workers over hub for pickup-stall
 alarms

Cause: alarm placement ranked the hub alongside capable non-hub operators solely by free slots, so an idle hub won even with available worker capacity. Prefer eligible-now non-hub operators first; retain all existing eligibility and fallback rules, including exclusion of the stalled host.

Proof: strengthened sweep-to-card regression fails on original code (machine:hub vs machine:worker-2); 253 tests across all 12 importing consumer suites pass with the ranking fix. scripts/check: 20 checks pass. Existing evidence cards unchanged.
---
 hermes_cli/kanban_pickup_stall.py                      | 6 +++---
 tests/hermes_cli/test_kanban_pickup_alarm_placement.py | 4 +++-
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_pickup_stall.py b/hermes_cli/kanban_pickup_stall.py
index 3a26e1faca..af0ed9e230 100644
--- a/hermes_cli/kanban_pickup_stall.py
+++ b/hermes_cli/kanban_pickup_stall.py
@@ -321,8 +321,8 @@ def alarm_placement(own: str, machines: Optional[Mapping[str, Mapping[str, Any]]
                     requires: tuple[str, ...] = _REQUIRES, now_ms: Optional[int] = None,
                     ) -> tuple[Optional[list[str]], str]:
     """``(runs_on, why)`` for an alarm about machine ``own``; never ``machine:<own>``. ``machines`` is the registry
-    (None: unreadable). In order: the eligible-now host (:func:`_can_host` and :func:`_ready_now`) with the most
-    free slots; the hub operator lane; any other host; any other machine that copies cards, even held (the hub
+    (None: unreadable). In order: an eligible-now non-hub host (:func:`_can_host` and :func:`_ready_now`) with the
+    most free slots; the eligible-now hub; the hub operator lane; any other host; any card-copying host, even held (hub
     first: it runs the alarm when that hold ends, not ``own``'s). With no other such machine enrolled, None
     (default placement): the registry offers nowhere else."""
     from hermes_cli import kanban_worker_node as wn
@@ -337,7 +337,7 @@ def alarm_placement(own: str, machines: Optional[Mapping[str, Mapping[str, Any]]
     hosts = {n: e for n, e in machines.items() if _can_host(n, e, own, need)}
     now = sorted(n for n, e in hosts.items() if _ready_now(e, now_ms))
     if now:
-        best = min(now, key=lambda n: (-(_free_slots(hosts[n]) or 0), n))
+        best = min(now, key=lambda n: (n == OPERATOR_LANE, -(_free_slots(hosts[n]) or 0), n))
         free = _free_slots(hosts[best])
         return [f"machine:{best}"], (f"{best} is active, unheld, not draining"
                                      + (f" and has {free} free card slot(s)" if free is not None else ""))
diff --git a/tests/hermes_cli/test_kanban_pickup_alarm_placement.py b/tests/hermes_cli/test_kanban_pickup_alarm_placement.py
index 85f5670e19..81bd4020ab 100644
--- a/tests/hermes_cli/test_kanban_pickup_alarm_placement.py
+++ b/tests/hermes_cli/test_kanban_pickup_alarm_placement.py
@@ -80,7 +80,9 @@ def test_a_hold_alarm_lands_on_another_eligible_machine_with_the_evidence(gws, m
 
 def test_a_queue_full_alarm_lands_on_another_eligible_machine(gws, monkeypatch):
     hub, worker = gws
-    _registry(monkeypatch)
+    # A free hub must not win over a capable worker with only one free slot.
+    _registry(monkeypatch, hub=_hub())
+    monkeypatch.setitem(support.MACHINES, OTHER, _worker(OTHER, metrics={"active_card_runs": 9}))
     old, new = stall._pinned(hub, title="oldest"), stall._pinned(hub, title="newer")
     worker.round()
     worker.tick(max_spawn=0)
