diff --git a/tests/hermes_cli/test_origin_create_validation.py b/tests/hermes_cli/test_origin_create_validation.py
new file mode 100644
index 0000000000000000000000000000000000000000..645423e1f973ea7162f2c808ca9bb0274a2fe6d0
--- /dev/null
+++ b/tests/hermes_cli/test_origin_create_validation.py
@@ -0,0 +1,70 @@
+"""Definitive pre-insert refusals must not hide behind write uncertainty."""
+import json
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from tests.hermes_cli import test_kanban_origin_owner as helpers
+
+world = helpers.world
+
+
+def _counts():
+    with kbc.connect_closing() as conn:
+        tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
+        return {table: conn.execute(f'SELECT COUNT(*) FROM {table}').fetchone()[0] if table in tables else 0
+                for table in ('tasks', 'task_links', 'task_events', 'origin_creation_intents', 'kanban_notify_subs')}
+
+
+def test_foreign_parent_is_terminal_without_partial_writes(world, monkeypatch, capsys):
+    from hermes_cli.kanban_dependency_validation import missing_dependency_error
+
+    world['args']['create']['parents'] = ['t_foreign_parent']
+    frozen = json.dumps(world, sort_keys=True)
+    before = _counts()
+    for _ in range(2):
+        result = helpers.invoke(world, monkeypatch, capsys)
+        assert result.get('status') == 'rejected', result
+        assert result['code'] == 'origin_parent_unknown'
+        assert str(missing_dependency_error(['t_foreign_parent'])) in result['error']
+        assert result['created'] is False and result['handoff_complete'] is False
+        assert _counts() == before
+        assert json.dumps(world, sort_keys=True) == frozen
+
+
+def test_exact_committed_replay_precedes_current_parent_validation(world, monkeypatch, capsys):
+    with kbc.connect_closing() as conn:
+        parent = kb.create_task(conn, title='Parent', settle_owner_chat=False)
+    world['args']['create']['parents'] = [parent]
+    first = helpers.invoke(world, monkeypatch, capsys)
+    assert first.get('created') is True, first
+    with kbc.connect_closing() as conn:
+        conn.execute('DELETE FROM task_links WHERE parent_id=?', (parent,))
+        conn.execute('DELETE FROM tasks WHERE id=?', (parent,))
+        conn.commit()
+    before = _counts()
+    second = helpers.invoke(world, monkeypatch, capsys)
+    assert second['origin_creation'] == first['origin_creation']
+    assert _counts() == before
+    assert before['tasks'] == 1
+
+
+@pytest.mark.parametrize('failure', [ValueError, RuntimeError])
+def test_postcommit_exception_is_pending_and_exact_retry_creates_once(world, monkeypatch, capsys, failure):
+    original = kb.create_task
+
+    def lost_reply(*args, **kwargs):
+        result = original(*args, **kwargs)
+        if kwargs.get('origin_intent') is not None:
+            raise failure('reply lost after committed origin create')
+        return result
+
+    with monkeypatch.context() as patch:
+        patch.setattr(kb, 'create_task', lost_reply)
+        result = helpers.invoke(world, monkeypatch, capsys)
+    assert result == {'status': 'pending', 'code': 'origin_dispatch_pending', 'handoff_complete': False}
+    before = _counts()
+    assert before['tasks'] == before['origin_creation_intents'] == 1
+    replay = helpers.invoke(world, monkeypatch, capsys)
+    assert replay.get('created') is True, replay
+    assert _counts() == before
diff --git a/tests/hermes_cli/test_standing_owner_retry.py b/tests/hermes_cli/test_standing_owner_retry.py
new file mode 100644
index 0000000000000000000000000000000000000000..e6875121ec2e5203383bb08d71e586813e7f6e4c
--- /dev/null
+++ b/tests/hermes_cli/test_standing_owner_retry.py
@@ -0,0 +1,47 @@
+"""A rejected standing owner is not repaired merely by starting another run."""
+import json
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_placement as kp
+from tests.hermes_cli import test_kanban_forward_retry_boundary as helpers
+
+
+@pytest.mark.parametrize('synthetic', [True, False])
+def test_later_run_keeps_synthetic_binding_refusal_without_another_send(tmp_path, monkeypatch, synthetic):
+    session = 'kanban_owner_pressure' if synthetic else 's1'
+    options = {'idempotency_key': 'product-key'}
+    original_id = kp.request_id('w', options, session, options)
+    result, body = helpers._history()
+    body['args']['origin']['session'] = session
+    path = tmp_path / 'hub.db'
+    with sqlite3.connect(path) as db:
+        db.execute('CREATE TABLE sent (id TEXT PRIMARY KEY, state TEXT, result TEXT, body TEXT)')
+        db.execute('INSERT INTO sent VALUES (?,?,?,?)', (
+            original_id, 'rejected', json.dumps(result), json.dumps(body)))
+    monkeypatch.setattr(kp.reg, 'hub_db_path', lambda: path)
+    monkeypatch.setattr(kp, 'hub_carries_options', lambda cli: True)
+    calls = []
+
+    def send(argv):
+        calls.append(argv)
+        return 0, '', ''
+
+    monkeypatch.setattr(kp, 'hub_runner', send)
+    before = path.read_bytes()
+    for run in ('run-2', 'run-3'):
+        out = kp.create_remote(options, target='hub', self_gw='w', origin_session=session,
+                               origin_profile='default', cfg={}, origin_gateway='hub',
+                               creator=helpers.CREATOR, run_uid=run)
+        if synthetic:
+            assert out.get('ok') is False, out
+            assert out['fatal'] is True
+            assert out['request_id'] == original_id
+            assert out['code'] == 'origin_forward_binding_missing'
+            assert 'custody' in out['error']
+        else:
+            assert out.get('ok') is True, out
+            assert out['request_id'] != original_id
+    assert len(calls) == (0 if synthetic else 2)
+    assert path.read_bytes() == before
