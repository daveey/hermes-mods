From 22a148fa2450677eddf49cfc1772b681f82df88b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:16:40 +0000
Subject: [PATCH] fix(cron): settle chronos startup pass via a CronScheduler
 method, not a new core import [daveey]

CI's boundary lint (tests/scripts/test_boundary_lint.py) refused the
plugin's new module_to_core import cron.scheduler_provider.mark_startup_recovered.
The helper becomes a non-abstract CronScheduler method (additive; the ABC
still requires only name/start), so chronos calls self.mark_startup_recovered
through the base class it already imports.

Proof: boundary lint, test_restart_rerun, test_scheduler_provider,
chronos plugin tests, test_plugins: 184 passed. Dropping the chronos call
fails test_chronos_fallback_ticker_does_not_rerun.
---
 cron/scheduler_provider.py                 | 9 ++++-----
 plugins/cron_providers/chronos/__init__.py | 3 +--
 2 files changed, 5 insertions(+), 7 deletions(-)

diff --git a/cron/scheduler_provider.py b/cron/scheduler_provider.py
index d72426d3a1..cafc412d5f 100644
--- a/cron/scheduler_provider.py
+++ b/cron/scheduler_provider.py
@@ -153,11 +153,6 @@ def _claim_startup_pass(home) -> bool:
         return True
 
 
-def mark_startup_recovered(home) -> None:
-    """For a provider whose start() recovers without rerunning (chronos): its startup pass is done."""
-    _claim_startup_pass(home)
-
-
 @contextlib.contextmanager
 def _startup_recovery_scope(home, *, owned: bool = True):
     """Run the block as this process's startup recovery for ``home`` when it is the first pass and
@@ -192,6 +187,10 @@ class CronScheduler(ABC):
         """Whether this provider can run here. MUST NOT make network calls; False → built-in."""
         return True
 
+    def mark_startup_recovered(self, home) -> None:
+        """For a provider whose start() recovers without rerunning (chronos): its startup pass is done."""
+        _claim_startup_pass(home)
+
     @abstractmethod
     def start(
         self, stop_event: threading.Event, *, adapters: Any = None, loop: Any = None,
diff --git a/plugins/cron_providers/chronos/__init__.py b/plugins/cron_providers/chronos/__init__.py
index e1d702b23c..a10c30afff 100644
--- a/plugins/cron_providers/chronos/__init__.py
+++ b/plugins/cron_providers/chronos/__init__.py
@@ -79,13 +79,12 @@ class ChronosCronScheduler(CronScheduler):
         self._ticker_kwargs = {"adapters": adapters, "loop": loop, "interval": interval}
         self._stop_event = stop_event
         # A new lifecycle can't prove what an interrupted process did: classify unknown, never requeue.
-        from cron.scheduler_provider import mark_startup_recovered
         from hermes_constants import get_process_hermes_home
 
         self.recover_interrupted()
         # Settles this home's startup pass, so a later built-in fallback ticker (_note_identity_rejected)
         # does not take its own start() for a restart and rerun attempts (cron/restart_rerun.py).
-        mark_startup_recovered(get_process_hermes_home())
+        self.mark_startup_recovered(get_process_hermes_home())
         self._reconcile_logged(logger.warning, "start()")
 
     def stop(self) -> None:
-- 
2.55.0

