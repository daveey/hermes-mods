diff --git a/hermes_cli/kanban_unused_grant.py b/hermes_cli/kanban_unused_grant.py
new file mode 100644
index 00000000000..86f28fdbc0a
--- /dev/null
+++ b/hermes_cli/kanban_unused_grant.py
@@ -0,0 +1,40 @@
+"""Distinguish a returned Board reservation from an owner execution. [daveey]"""
+from __future__ import annotations
+
+import sqlite3
+
+
+def is_unused_grant(conn: sqlite3.Connection, run) -> bool:
+    """Require a bare Board grant/release, with no contradictory execution trace."""
+    from hermes_cli import kanban_db as kb
+
+    metadata = kb._json_dict(run["metadata"])
+    if (run["status"] != "released" or run["outcome"] != "released" or run["ended_at"] is None
+            or set(metadata) != {"unused_grant"} or metadata.get("unused_grant") is not True):
+        return False
+    if any(run[key] is not None for key in ("worker_pid", "worker_started_at", "last_heartbeat_at", "claim_lock")):
+        return False
+    if run["summary"] or run["error"]:
+        return False
+    released = False
+    for event in conn.execute("SELECT kind, payload FROM task_events WHERE task_id = ? AND run_id = ?",
+                              (run["task_id"], run["id"])):
+        payload = kb._json_dict(event["payload"])
+        if event["kind"] == "claimed" and "lock" not in payload:
+            continue
+        if event["kind"] != "released" or payload.get("unused_grant") is not True:
+            return False
+        released = True
+    return released
+
+
+def latest_started_run(conn: sqlite3.Connection, task_id: str):
+    """Latest run, ignoring only positively attested, unstarted unused grants.
+
+    A missing receipt or any execution/failure evidence consumes the handoff.
+    Keep run/event identity local: sync remaps their run ids together.
+    """
+    for run in conn.execute("SELECT * FROM task_runs WHERE task_id = ? ORDER BY id DESC", (task_id,)):
+        if not is_unused_grant(conn, run):
+            return run
+    return None
diff --git a/tests/hermes_cli/test_kanban_dependency_unused_grant.py b/tests/hermes_cli/test_kanban_dependency_unused_grant.py
new file mode 100644
index 00000000000..d433300716b
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_dependency_unused_grant.py
@@ -0,0 +1,80 @@
+"""Unused Board grants must not spend an owner's dependency continuation."""
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_dispatch as dispatch
+from hermes_cli import kanban_db_dispatch_pr_state as prs
+from tests.hermes_cli import test_kanban_dependency_pr_handoff as helpers
+
+board = helpers.board
+
+
+def release_unused(conn, task, clock, *, evidence=None, unused=True):
+    clock[0] += 1
+    kb.claim_task(conn, task)
+    run = kb.get_task(conn, task).current_run_id
+    with kb.write_txn(conn):
+        conn.execute("UPDATE task_runs SET status = 'released', outcome = 'released', ended_at = ?, "
+                     "claim_lock = NULL, metadata = ? WHERE id = ?",
+                     (clock[0], '{"unused_grant":true}', run))
+        conn.execute("UPDATE task_events SET payload = ? WHERE task_id = ? AND run_id = ? AND kind = 'claimed'",
+                     ('{"holder":"hub"}', task, run))
+        conn.execute("UPDATE tasks SET status = 'ready', claim_lock = NULL, current_run_id = NULL WHERE id = ?", (task,))
+        kb._append_event(conn, task, "released", {"unused_grant": unused, "retry_status": "ready"}, run_id=run)
+        if evidence:
+            kb._append_event(conn, task, evidence, {}, run_id=run)
+    return run
+
+
+def test_unused_grants_preserve_dependency_dispatch(board, monkeypatch, all_assignees_spawnable):
+    task, _, clock = helpers.park(board, monkeypatch)
+    release_unused(board, task, clock)
+    release_unused(board, task, clock)
+    assert prs.active_pr_reason(board, task, int(time.time())) is None
+    launched = []
+    result = dispatch.dispatch_once(board, spawn_fn=lambda task, workspace, **kwargs: launched.append(task.id) or 123456789)
+    assert task in launched, result
+    assert prs.active_pr_reason(board, task, int(time.time())) == "active_pr"
+
+
+@pytest.mark.parametrize("evidence", ["worker_bound", "worker_result", "spawned", "crashed", "reclaimed", "timed_out",
+                                      "owner_admitted", "heartbeat", "unknown_future_execution"])
+def test_used_or_failed_grants_remain_guarded(board, monkeypatch, evidence):
+    task, _, clock = helpers.park(board, monkeypatch)
+    release_unused(board, task, clock, evidence=evidence)
+    assert prs.active_pr_reason(board, task, int(time.time())) == "active_pr"
+
+
+@pytest.mark.parametrize("field,value", [
+    ("status", "running"), ("outcome", "crashed"), ("ended_at", None),
+    ("worker_pid", 123), ("worker_started_at", "birth"), ("last_heartbeat_at", 123),
+    ("claim_lock", "hub:123"), ("summary", "worked"), ("error", "failed"),
+    ("metadata", '{}'), ("metadata", '{"unused_grant":1}'),
+    ("metadata", '{"unused_grant":true,"worker_result":{}}'),
+])
+def test_contradictory_run_fields_consume_handoff(board, monkeypatch, field, value):
+    task, _, clock = helpers.park(board, monkeypatch)
+    run = release_unused(board, task, clock)
+    with kb.write_txn(board):
+        board.execute(f"UPDATE task_runs SET {field} = ? WHERE id = ?", (value, run))
+    assert prs.active_pr_reason(board, task, int(time.time())) == "active_pr"
+
+
+def test_local_claim_or_missing_release_consumes_handoff(board, monkeypatch):
+    task, _, clock = helpers.park(board, monkeypatch)
+    run = release_unused(board, task, clock)
+    with kb.write_txn(board):
+        board.execute("UPDATE task_events SET payload = ? WHERE run_id = ? AND kind = 'claimed'",
+                      ('{"lock":"local"}', run))
+    assert prs.active_pr_reason(board, task, int(time.time())) == "active_pr"
+    with kb.write_txn(board):
+        board.execute("DELETE FROM task_events WHERE run_id = ?", (run,))
+    assert prs.active_pr_reason(board, task, int(time.time())) == "active_pr"
+
+
+def test_release_without_unused_receipt_remains_guarded(board, monkeypatch):
+    task, _, clock = helpers.park(board, monkeypatch)
+    release_unused(board, task, clock, unused=False)
+    assert prs.active_pr_reason(board, task, int(time.time())) == "active_pr"
diff --git a/tests/hermes_cli/test_kanban_guard_queue_notice.py b/tests/hermes_cli/test_kanban_guard_queue_notice.py
new file mode 100644
index 00000000000..2415289c589
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_guard_queue_notice.py
@@ -0,0 +1,40 @@
+"""Queue and chat notices describe guard observations, not nonexistent slot waits."""
+import time
+
+import pytest
+
+from hermes_cli import kanban_chat_wait as cw
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_parent_unclaimed as pu
+from hermes_cli import kanban_queue_position as qp
+from tests.hermes_cli import test_kanban_dependency_pr_handoff as helpers
+
+board = helpers.board
+
+
+@pytest.mark.parametrize("cleared_by", ["unblocked", "hold_released", "continued", "promoted"])
+@pytest.mark.parametrize("reason", ["active_pr", "blocker_auth", "recent_success"])
+def test_guarded_queue_and_notice(board, monkeypatch, reason, cleared_by):
+    clock = [int(time.time())]
+    monkeypatch.setattr(time, "time", lambda: clock[0])
+    task = kb.create_task(board, title="waiting owner", assignee="dev", session_id="chat")
+    clock[0] += 1801
+    with kb.write_txn(board):
+        kb._append_event(board, task, "respawn_guarded", {"reason": reason})
+    place = qp.position(board, kb.get_task(board, task))
+    assert place == {"lane": "respawn_guard", "reason": reason}
+    assert cw.sweep(board, now=clock[0]) == 1
+    payload = kb._json_dict(board.execute(
+        "SELECT payload FROM task_events WHERE task_id = ? AND kind = ?", (task, cw.NOTICE_KIND),
+    ).fetchone()[0])
+    assert payload["respawn_guard"] == reason
+    for text in (qp.describe(place), cw.notice_text(payload), pu.notice_text(payload),
+                 pu.ready_hint(board, kb.get_task(board, task))):
+        assert reason in text
+        assert "local slot" not in text
+        assert "bump" not in text
+        assert "last recorded" in text
+    assert qp.position(board, kb.get_task(board, task)) == place  # notice doesn't erase hold
+    with kb.write_txn(board):
+        kb._append_event(board, task, cleared_by, {})
+    assert qp.position(board, kb.get_task(board, task))["lane"] != "respawn_guard"
