+  title: `Chat ${id}`,
+  version: 1,
+  ...extra
+})
+
+const registry = () =>
+  ({
+    connections: [
+      { id: 'local', kind: 'local', label: 'This device' },
+      { id: 'mac-mini', kind: 'ssh', label: 'Mac Mini' }
+    ],
+    primary: 'local',
+    version: 2
