+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import {
+  hubDbPath,
+  installSidebarBootSnapshot,
+  readHubSessions,
+  readTreeSnapshot,
+  writeTreeSnapshot
+} from './sidebar-boot-snapshot'
+
+// [daveey] Sidebar boot snapshot: Electron main reads hub.db the way hub-sync's hubview.py `sessions()` does, so the
+// first window can paint every gateway's rows (this one's included) before the local backend is up.
+
+// The hermes-hub client's tables this reader touches (hermes_hub.SCHEMA).
+const SCHEMA = `
+CREATE TABLE meta (k TEXT PRIMARY KEY, v TEXT);
+CREATE TABLE published (coll TEXT, key TEXT, sha TEXT, data TEXT, version INTEGER, seq INTEGER, PRIMARY KEY (coll, key));
+CREATE TABLE replica (gw TEXT, coll TEXT, key TEXT, version INTEGER, seq INTEGER, data TEXT, updated_at INTEGER,
+  PRIMARY KEY (gw, coll, key));
+CREATE TABLE sent (id TEXT PRIMARY KEY, body TEXT, state TEXT, result TEXT, created_at REAL, done_at REAL, posted INTEGER DEFAULT 0);
+CREATE TABLE overrides (gw TEXT, coll TEXT, key TEXT, field TEXT, value TEXT, hlc TEXT, by_gw TEXT, seq INTEGER,
+  PRIMARY KEY (gw, coll, key, field));
+`
+
+const NOW = 1_800_000_000
+
+let dir: string
+let dbFile: string
+
+function buildDb(opts: { lastOk?: number; shared?: string } = {}) {
+  const db = new DatabaseSync(dbFile)
+  db.exec(SCHEMA)
+  const meta = db.prepare('INSERT INTO meta (k, v) VALUES (?, ?)')
+  meta.run('gateway', 'macbook')
+  meta.run('last_ok', String(opts.lastOk ?? NOW - 5))
+
+  if (opts.shared) {
+    meta.run('shared_fields', opts.shared)
+  }
+
+  const pub = db.prepare("INSERT INTO published (coll, key, data, version) VALUES ('sessions', ?, ?, ?)")
+  pub.run('default/s_own', JSON.stringify({ activity: NOW - 10, id: 's_own', profile: 'default', title: 'Own chat' }), 3)
+  pub.run('default/s_arch', JSON.stringify({ activity: NOW, archived: true, id: 's_arch', title: 'Archived' }), 1)
+  pub.run('default/s_bad', 'not json', 1)
+
+  const rep = db.prepare("INSERT INTO replica (gw, coll, key, version, data, updated_at) VALUES (?, 'sessions', ?, ?, ?, ?)")
+  rep.run('mini', 'default/s_mini', 7, JSON.stringify({ activity: NOW - 1, id: 's_mini', title: 'Mini chat' }), (NOW - 60) * 1000)
+  rep.run('hub', 'default/s_hub', 2, JSON.stringify({ activity: NOW - 100, id: 's_hub', title: 'Hub chat' }), (NOW - 600) * 1000)
+  // A replica copy of this gateway's own row is never shown twice.
+  rep.run('macbook', 'default/s_own', 3, JSON.stringify({ id: 's_own', title: 'Own chat (echo)' }), NOW * 1000)
+
+  db.prepare("INSERT INTO sent (id, body, state, created_at) VALUES ('r1', ?, 'queued', ?)").run(
+    JSON.stringify({ action: 'pin', args: {}, coll: 'sessions', key: 'default/s_mini', to_gw: 'mini' }),
+    NOW - 3
+  )
+  db.prepare("INSERT INTO sent (id, body, state, created_at) VALUES ('r2', ?, 'done', ?)").run(
+    JSON.stringify({ action: 'pin', coll: 'sessions', key: 'default/s_hub', to_gw: 'hub' }),
+    NOW - 3
+  )
+  db.prepare(
+    "INSERT INTO overrides (gw, coll, key, field, value, hlc, by_gw, seq) VALUES ('mini', 'sessions', 'default/s_mini', 'title', ?, 'h', 'macbook', 1)"
+  ).run(JSON.stringify('Renamed on the hub'))
+  db.close()
+}
+
+beforeEach(() => {
+  dir = fs.mkdtempSync(path.join(os.tmpdir(), 'boot-snapshot-'))
+  dbFile = path.join(dir, 'hub.db')
+})
+
+afterEach(() => {
+  fs.rmSync(dir, { force: true, recursive: true })
+})
+
+describe('readHubSessions', () => {
+  it('returns own (published) and other gateways (replica) rows, newest activity first, archived and torn rows dropped', () => {
+    buildDb()
+    const snap = readHubSessions(dbFile, NOW)!
+
+    expect(snap.gateway).toBe('macbook')
+    expect(snap.stale).toBe(false)
+    expect(snap.sessions.map(r => [r.gateway, r.id, r.local])).toEqual([
+      ['mini', 's_mini', false],
+      ['macbook', 's_own', true],
+      ['hub', 's_hub', false]
+    ])
+  })
+
+  it('stamps synced_at like hubview: now for own rows, min(owner publish, last pull) for replica rows', () => {
+    buildDb({ lastOk: NOW - 5 })
+    const byId = Object.fromEntries(readHubSessions(dbFile, NOW)!.sessions.map(r => [r.id, r]))
+
+    expect(byId.s_own.synced_at).toBe(NOW)
+    expect(byId.s_mini.synced_at).toBe(NOW - 60)
+    expect(byId.s_hub.synced_at).toBe(NOW - 600)
+    expect(byId.s_mini.updated_at_hub).toBe(NOW - 60)
+  })
+
+  it('marks every replica row stale when the last pull is older than the stale window', () => {
+    buildDb({ lastOk: NOW - 1000 })
+    const snap = readHubSessions(dbFile, NOW)!
+
+    expect(snap.stale).toBe(true)
+    expect(snap.sessions.filter(r => !r.local).every(r => r.stale === true)).toBe(true)
+    expect(snap.sessions.find(r => r.local)!.stale).toBe(false)
+  })
+
+  it('attaches pending (local/queued) requests to their row', () => {
+    buildDb()
+    const byId = Object.fromEntries(readHubSessions(dbFile, NOW)!.sessions.map(r => [r.id, r]))
+
+    expect(byId.s_mini.pending).toEqual([{ action: 'pin', args: {}, created_at: NOW - 3, id: 'r1', state: 'queued' }])
+    expect(byId.s_hub.pending).toEqual([]) // its request is done
+  })
+
+  it('applies shared-field overrides only in primary mode, marking a value the owner has not applied', () => {
+    buildDb({ shared: JSON.stringify({ sessions: 'primary' }) })
+    const primary = readHubSessions(dbFile, NOW)!.sessions.find(r => r.id === 's_mini')!
+
+    expect(primary.title).toBe('Renamed on the hub')
+    expect(primary.shared).toEqual({ title: { by: 'macbook', owner_value: 'Mini chat' } })
+
+    fs.rmSync(dbFile)
+    buildDb({ shared: JSON.stringify('shadow') })
+    const shadow = readHubSessions(dbFile, NOW)!.sessions.find(r => r.id === 's_mini')!
+
+    expect(shadow.title).toBe('Mini chat')
+    expect(shadow.shared).toBeUndefined()
+  })
+
+  it('answers null for a missing db and never creates one', () => {
+    expect(readHubSessions(dbFile, NOW)).toBeNull()
+    expect(fs.existsSync(dbFile)).toBe(false)
+  })
+
+  it('caps the row count', () => {
+    buildDb()
+
+    expect(readHubSessions(dbFile, NOW, 1)!.sessions.map(r => r.id)).toEqual(['s_mini'])
+  })
+})
+
+describe('hubDbPath', () => {
+  it('follows HERMES_HUB_STATE like hubview, else ~/.local/state/hermes-hub', () => {
+    expect(hubDbPath({}, '/home/me')).toBe('/home/me/.local/state/hermes-hub/hub.db')
+    expect(hubDbPath({ HERMES_HUB_STATE: '~/hub' }, '/home/me')).toBe('/home/me/hub/hub.db')
+  })
+})
+
+describe('tree snapshot file', () => {
+  it('round-trips and rejects a torn or foreign file', () => {
+    const file = path.join(dir, 'tree.json')
+    writeTreeSnapshot(file, { activeProjectId: 'p_1', connectionId: 'local', tree: [{ id: 'p_1' }] }, 123)
+
+    expect(readTreeSnapshot(file)).toEqual({ activeProjectId: 'p_1', connectionId: 'local', savedAt: 123, tree: [{ id: 'p_1' }] })
+
+    fs.writeFileSync(file, '{"v":1,"tree":')
+    expect(readTreeSnapshot(file)).toBeNull()
+    fs.writeFileSync(file, JSON.stringify({ connectionId: 'local', tree: [], v: 99 }))
+    expect(readTreeSnapshot(file)).toBeNull()
+    expect(readTreeSnapshot(path.join(dir, 'missing.json'))).toBeNull()
+  })
+})
+
+describe('installSidebarBootSnapshot IPC', () => {
+  function install() {
+    const handlers = new Map<string, (event: any, payload?: any) => void>()
+    const ipcMain = { on: vi.fn((channel: string, fn: any) => void handlers.set(channel, fn)) }
+    installSidebarBootSnapshot({ appStartMs: 42, hubDb: dbFile, ipcMain: ipcMain as any, log: () => {}, userDataDir: dir })
+
+    return handlers
+  }
+
+  it('read (sendSync) returns the process start, hub rows and the saved tree', () => {
+    buildDb()
+    const handlers = install()
+    handlers.get('hermes:boot-snapshot:save-tree')!({}, { activeProjectId: null, connectionId: 'local', tree: [{ id: 'p' }] })
+    const event: { returnValue?: any } = {}
+    handlers.get('hermes:boot-snapshot:read')!(event)
+
+    expect(event.returnValue.appStartMs).toBe(42)
+    expect(event.returnValue.hub.gateway).toBe('macbook')
+    expect(event.returnValue.hub.sessions.length).toBe(3)
+    expect(event.returnValue.tree.tree).toEqual([{ id: 'p' }])
+    expect(typeof event.returnValue.readMs).toBe('number')
+  })
+
+  it('read without hub.db or a saved tree still answers (nothing to paint)', () => {
+    const handlers = install()
+    const event: { returnValue?: any } = {}
+    handlers.get('hermes:boot-snapshot:read')!(event)
+
+    expect(event.returnValue).toMatchObject({ appStartMs: 42, hub: null, tree: null })
+  })
+
+  it('save-tree ignores a malformed payload', () => {
+    const handlers = install()
+    handlers.get('hermes:boot-snapshot:save-tree')!({}, { tree: 'nope' })
+    handlers.get('hermes:boot-snapshot:save-tree')!({}, null)
+
+    expect(fs.existsSync(path.join(dir, 'sidebar-boot-snapshot.json'))).toBe(false)
+  })
+})
diff --git a/apps/desktop/electron/sidebar-boot-snapshot.ts b/apps/desktop/electron/sidebar-boot-snapshot.ts
new file mode 100644
index 0000000000..5943ae7ab4
--- /dev/null
+++ b/apps/desktop/electron/sidebar-boot-snapshot.ts
@@ -0,0 +1,365 @@
+/**
+ * [daveey] Sidebar boot snapshot (instant session loads, cold start).
+ *
+ * The sidebar's rows come from the local Python backend, which takes ~6 s to
+ * boot. This module lets the first window paint them before that, from two
+ * sources Electron main can read synchronously:
+ *
+ *  - hub sessions: this gateway's hermes-hub replica (`hub.db`), read
+ *    read-only. Same rows the hub-sync plugin's `GET /sessions` serves
+ *    (published = this gateway's own, replica = every other gateway's,
+ *    pending requests attached, shared-field overrides on top in primary
+ *    mode); `hub-sync/hubview.py` View.rows is the reference.
+ *  - projects tree: the last tree a live backend answered, saved by the
+ *    renderer to `sidebar-boot-snapshot.json` in userData.
+ *
+ * IPC (preload exposes it as `hermesDesktop.bootSnapshot`):
+ *   hermes:boot-snapshot:read       sendSync  -> BootSnapshot
+ *   hermes:boot-snapshot:save-tree  send      {tree, activeProjectId, connectionId}
+ */
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+
+import type { IpcMain } from 'electron'
+
+// hubview.py: STALE_AFTER_S, PENDING_STATES, SHARED["sessions"].
+export const HUB_STALE_AFTER_S = 180
+const PENDING_STATES = ['local', 'queued']
+const SHARED_SESSION_FIELDS = new Set(['title', 'pinned', 'archived', 'hidden'])
+export const HUB_SESSIONS_LIMIT = 2000
+const TREE_FILE = 'sidebar-boot-snapshot.json'
+const TREE_VERSION = 1
+
+export interface HubSessionsSnapshot {
+  available: true
+  gateway: null | string
+  sessions: Record<string, unknown>[]
+  stale: boolean
+  synced_at: null | number
+}
+
+export interface TreeSnapshot {
+  activeProjectId: null | string
+  connectionId: string
+  savedAt: number
+  tree: unknown[]
+}
+
+export interface BootSnapshot {
+  /** Epoch ms the Electron main process started (cold-start timing base). */
+  appStartMs: number
+  hub: HubSessionsSnapshot | null
+  readMs: number
+  tree: TreeSnapshot | null
+}
+
+export function hubDbPath(env: NodeJS.ProcessEnv = process.env, home = os.homedir()): string {
+  const base = env.HERMES_HUB_STATE?.trim() || path.join(home, '.local', 'state', 'hermes-hub')
+
+  return path.join(base.replace(/^~(?=$|\/)/, home), 'hub.db')
+}
+
+const parseObject = (text: unknown): null | Record<string, any> => {
+  try {
+    const value = JSON.parse(String(text))
+
+    return value && typeof value === 'object' && !Array.isArray(value) ? value : null
+  } catch {
+    return null
+  }
+}
+
+const parseJson = (text: unknown): unknown => {
+  try {
+    return JSON.parse(String(text))
+  } catch {
+    return null
+  }
+}
+
+const toFloat = (value: unknown): null | number => {
+  if (value === null || value === undefined || value === '' || value === 'None') {
+    return null
+  }
+
+  const n = Number(value)
+
+  return Number.isFinite(n) ? n : null
+}
+
+/**
+ * hubview.py `sessions(include_archived=False)` against `dbPath`, read-only:
+ * null when the db is missing or unreadable (the caller paints nothing).
+ */
+export function readHubSessions(
+  dbPath: string,
+  nowS: number = Date.now() / 1000,
+  limit: number = HUB_SESSIONS_LIMIT
+): HubSessionsSnapshot | null {
+  if (!fs.existsSync(dbPath)) {
+    return null
+  }
+
+  let db: DatabaseSync | null = null
+
+  try {
+    // hubview.ro_connect: rw + query_only, because a readOnly open fails on a WAL db whose -wal/-shm are missing.
+    // The existsSync above means this never creates the file.
+    db = new DatabaseSync(dbPath, { timeout: 500 })
+    db.exec('PRAGMA query_only = ON')
+    const conn = db
+
+    const has = (table: string) =>
+      Boolean(conn.prepare("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?").get(table))
+
+    const meta = (key: string): null | string => {
+      if (!has('meta')) {
+        return null
+      }
+
+      const row = conn.prepare('SELECT v FROM meta WHERE k = ?').get(key) as { v?: unknown } | undefined
+      const v = row?.v
+
+      return v === null || v === undefined || v === 'None' ? null : String(v)
+    }
+
+    const gateway = meta('gateway')
+    const lastOk = toFloat(meta('last_ok'))
+    const stale = lastOk === null || nowS - lastOk > HUB_STALE_AFTER_S
+
+    const ownerSeen = new Map<string, number>()
+
+    if (has('replica')) {
+      for (const r of conn.prepare('SELECT gw, MAX(updated_at) AS t FROM replica GROUP BY gw').all() as any[]) {
+        ownerSeen.set(String(r.gw), (Number(r.t) || 0) / 1000)
+      }
+    }
+
+    const syncedAt = (gw: string): null | number => {
+      const seen = ownerSeen.get(gw)
+
+      if (seen === undefined) {
+        return lastOk
+      }
+
+      return lastOk ? Math.min(seen, lastOk) : seen
+    }
+
+    const pending = new Map<string, unknown[]>()
+
+    if (has('sent')) {
+      const rows = conn
+        .prepare(
+          `SELECT id, body, state, created_at FROM sent WHERE state IN (${PENDING_STATES.map(() => '?').join(',')}) ORDER BY created_at`
+        )
+        .all(...PENDING_STATES) as any[]
+
+      for (const r of rows) {
+        const b = parseObject(r.body)
+
+        if (!b || b.coll !== 'sessions') {
+          continue
+        }
+
+        const k = `${b.to_gw}\u0000${b.key}`
+        const list = pending.get(k) ?? []
+        list.push({ action: b.action, args: b.args || {}, created_at: r.created_at, id: r.id, state: r.state })
+        pending.set(k, list)
+      }
+    }
+
+    let sharedPrimary = false
+
+    try {
+      const raw = parseJson(meta('shared_fields') ?? '"off"')
+      const mode = raw && typeof raw === 'object' ? (raw as Record<string, unknown>).sessions : raw
+      sharedPrimary = mode === 'primary'
+    } catch {
+      sharedPrimary = false
+    }
+
+    const overrides = new Map<string, Map<string, { by: unknown; value: unknown }>>()
+
+    if (sharedPrimary && has('overrides')) {
+      const rows = conn
+        .prepare("SELECT gw, key, field, value, by_gw FROM overrides WHERE coll = 'sessions' AND value IS NOT NULL")
+        .all() as any[]
+
+      for (const r of rows) {
+        if (SHARED_SESSION_FIELDS.has(r.field) || r.field === 'pending_action') {
+          const k = `${r.gw}\u0000${r.key}`
+          const fields = overrides.get(k) ?? new Map()
+          fields.set(String(r.field), { by: r.by_gw, value: parseJson(r.value) })
+          overrides.set(k, fields)
+        }
+      }
+    }
+
+    const overlay = (d: Record<string, any>) => {
+      const ovr = overrides.get(`${d.gateway}\u0000${d.key}`)
+
+      if (!ovr) {
+        return d
+      }
+
+      for (const [field, o] of ovr) {
+        if (field === 'pending_action') {
+          d.pending_action = o.value
+
+          continue
+        }
+
+        if (d[field] !== o.value) {
+          d.shared = { ...(d.shared ?? {}), [field]: { by: o.by, owner_value: d[field] } }
+        }
+
+        d[field] = o.value
+      }
+
+      return d
+    }
+
+    const out: Record<string, any>[] = []
+
+    if (has('published')) {
+      for (const r of conn.prepare("SELECT key, data, version FROM published WHERE coll = 'sessions'").all() as any[]) {
+        const d = parseObject(r.data)
+
+        if (d) {
+          Object.assign(d, {
+            gateway,
+            key: r.key,
+            local: true,
+            pending: pending.get(`${gateway}\u0000${r.key}`) ?? [],
+            stale: false,
+            synced_at: nowS,
+            version: r.version
+          })
+          out.push(overlay(d))
+        }
+      }
+    }
+
+    if (has('replica')) {
+      const rows = conn
+        .prepare("SELECT gw, key, data, version, updated_at FROM replica WHERE coll = 'sessions' AND gw IS NOT ?")
+        .all(gateway) as any[]
+
+      for (const r of rows) {
+        const d = parseObject(r.data)
+
+        if (d) {
+          Object.assign(d, {
+            gateway: r.gw,
+            key: r.key,
+            local: false,
+            pending: pending.get(`${r.gw}\u0000${r.key}`) ?? [],
+            stale,
+            synced_at: syncedAt(String(r.gw)),
+            updated_at_hub: (Number(r.updated_at) || 0) / 1000,
+            version: r.version
+          })
+          out.push(overlay(d))
+        }
+      }
+    }
+
+    const sessions = out
+      .filter(d => !d.archived)
+      .sort((a, b) => (Number(b.activity || b.started_at) || 0) - (Number(a.activity || a.started_at) || 0))
+      .slice(0, Math.max(1, Math.min(limit, 5000)))
+
+    return { available: true, gateway, sessions, stale, synced_at: lastOk }
+  } catch {
+    return null
+  } finally {
+    try {
+      db?.close()
+    } catch {
+      // already closed
+    }
+  }
+}
+
+export function readTreeSnapshot(file: string): TreeSnapshot | null {
+  try {
+    const raw = parseObject(fs.readFileSync(file, 'utf8'))
+
+    if (!raw || raw.v !== TREE_VERSION || !Array.isArray(raw.tree) || typeof raw.connectionId !== 'string') {
+      return null
+    }
+
+    return {
+      activeProjectId: typeof raw.activeProjectId === 'string' ? raw.activeProjectId : null,
+      connectionId: raw.connectionId,
+      savedAt: Number(raw.savedAt) || 0,
+      tree: raw.tree
+    }
+  } catch {
+    return null
+  }
+}
+
+/** Atomic replace (tmp + rename) so a crash mid-write never leaves a torn snapshot. */
+export function writeTreeSnapshot(file: string, snapshot: Omit<TreeSnapshot, 'savedAt'>, nowMs = Date.now()): void {
+  const tmp = `${file}.${process.pid}.tmp`
+  fs.writeFileSync(tmp, JSON.stringify({ v: TREE_VERSION, savedAt: nowMs, ...snapshot }))
+  fs.renameSync(tmp, file)
+}
+
+export interface SidebarBootSnapshotDeps {
+  appStartMs: number
+  hubDb?: string
+  ipcMain: IpcMain
+  log: (line: string) => void
+  userDataDir: string
+}
+
+export function installSidebarBootSnapshot(deps: SidebarBootSnapshotDeps) {
+  const treeFile = path.join(deps.userDataDir, TREE_FILE)
+  const hubDb = deps.hubDb ?? hubDbPath()
+
+  const read = (): BootSnapshot => {
+    const t0 = performance.now()
+    let hub: HubSessionsSnapshot | null = null
+    let tree: TreeSnapshot | null = null
+
+    try {
+      hub = readHubSessions(hubDb)
+    } catch (error) {
+      deps.log(`hub read failed: ${(error as Error)?.message || error}`)
+    }
+
+    try {
+      tree = readTreeSnapshot(treeFile)
+    } catch (error) {
+      deps.log(`tree read failed: ${(error as Error)?.message || error}`)
+    }
+
+    return { appStartMs: deps.appStartMs, hub, readMs: Math.round(performance.now() - t0), tree }
+  }
+
+  deps.ipcMain.on('hermes:boot-snapshot:read', event => {
+    event.returnValue = read()
+  })
+
+  deps.ipcMain.on('hermes:boot-snapshot:save-tree', (_event, payload) => {
+    if (!payload || !Array.isArray(payload.tree) || typeof payload.connectionId !== 'string') {
+      return
+    }
+
+    try {
+      writeTreeSnapshot(treeFile, {
+        activeProjectId: typeof payload.activeProjectId === 'string' ? payload.activeProjectId : null,
+        connectionId: payload.connectionId,
+        tree: payload.tree
+      })
+    } catch (error) {
+      deps.log(`tree save failed: ${(error as Error)?.message || error}`)
+    }
+  })
+
+  return { read }
+}
