From 5b41834463baba9d9b171f640bd49d1b588660f8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 19:30:29 +0000
Subject: [PATCH] [daveey] spike(R1): tests for source_receipt on the
 status-leaving wire op (red on main)

---
 .../test_kanban_source_receipt_spike.py       | 248 ++++++++++++++++++
 1 file changed, 248 insertions(+)
 create mode 100644 tests/hermes_cli/test_kanban_source_receipt_spike.py

diff --git a/tests/hermes_cli/test_kanban_source_receipt_spike.py b/tests/hermes_cli/test_kanban_source_receipt_spike.py
new file mode 100644
index 0000000000..175e11ad0f
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_source_receipt_spike.py
@@ -0,0 +1,248 @@
+"""Spike R1 (t_01a1d0bdfa1955d5, design t_01a1cc30806b0e62 plan v4 §2.1, review t_01a1d0b31e8c442d V1/V2).
+
+A ``source_receipt`` must ride the outbox op that moves a card out of ``running`` AND survive onto the wire op
+``push`` sends (``translate(_full_row_if_unseen(conn, row), hlc)``). A refused ending must leave no pending
+receipt behind for a later involuntary ending of the same run (V1). An old Board's ``forbidden_field`` on the
+virtual field drops it without an omission row (V2). Throwaway spike: no PR.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import sqlite3
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as kd
+from hermes_cli import kanban_db_sync as sync
+from hermes_cli import kanban_sync_client as ksc
+from tests.hermes_cli import kanban_sync_support as support
+from tests.hermes_cli import test_kanban_sync_run_rows as helpers
+
+svc = helpers.svc
+live = helpers.live
+
+
+@pytest.fixture
+def kanban_home(tmp_path, monkeypatch):
+    return support.kanban_home(tmp_path, monkeypatch)
+
+
+@pytest.fixture
+def conn(kanban_home):
+    yield from support.synced_conn(kanban_home)
+
+
+def _ksr():
+    from hermes_cli import kanban_source_receipt as ksr  # absent on origin/main
+    return ksr
+
+
+def _receipt(run_uid: str) -> dict:
+    return {"run_uid": run_uid, "state": "unchanged", "manifest_revision": 1, "commit": "a" * 40}
+
+
+def _applying(conn, sql, params=()):
+    """A fixture edit the capture triggers must not see."""
+    with kbc.write_txn(conn):
+        conn.execute("UPDATE kanban_sync_state SET applying = 1")
+        conn.execute(sql, params)
+        conn.execute("UPDATE kanban_sync_state SET applying = 0")
+
+
+def _run_of(conn, tid):
+    run_id = conn.execute("SELECT current_run_id FROM tasks WHERE id = ?", (tid,)).fetchone()[0]
+    return run_id, conn.execute("SELECT uid FROM task_runs WHERE id = ?", (run_id,)).fetchone()[0]
+
+
+def _running(conn, title="r1", *, acked=True):
+    tid = kb.create_task(conn, title=title, assignee="worker")
+    assert kb.claim_task(conn, tid, ttl_seconds=900, claimer=f"{kb._host_prefix()}:1")
+    if acked:  # the Board has acknowledged the card: the ordinary custody case
+        _applying(conn, "UPDATE tasks SET sync_version = 1 WHERE id = ?", (tid,))
+    with kbc.write_txn(conn):
+        conn.execute("DELETE FROM kanban_sync_outbox")
+    return (tid, *_run_of(conn, tid))
+
+
+def _wire(conn, tid):
+    """What ``push`` would send for this card's pending ops, in order."""
+    rows = [dict(r) for r in conn.execute(
+        "SELECT * FROM kanban_sync_outbox WHERE table_name = 'tasks' AND row_uid = ? AND state = 'pending' "
+        "ORDER BY created_at, rowid", (tid,))]
+    return [ksc.translate(ksc._full_row_if_unseen(conn, r), "hlc") for r in rows]
+
+
+def _pending(conn) -> int:
+    return conn.execute("SELECT COUNT(*) FROM kanban_source_receipt_pending").fetchone()[0]
+
+
+def _complete(conn, tid, run_id):
+    return kb.complete_task(conn, tid, result="ok", summary="done", expected_run_id=run_id)
+
+
+def _schedule(conn, tid, run_id):
+    return kb.schedule_task(conn, tid, reason="SCHEDULED_UNTIL=2099-01-01T00:00:00Z", clock_only=True,
+                           expected_run_id=run_id)
+
+
+def _block(conn, tid, run_id):
+    return kb.block_task(conn, tid, reason="1) tap Approve on the iPhone", kind="needs_input", expected_run_id=run_id)
+
+
+ENDINGS = {"complete": (_complete, "done"), "schedule": (_schedule, "scheduled"), "block": (_block, "blocked")}
+
+
+@pytest.mark.parametrize("ending", sorted(ENDINGS))
+def test_receipt_rides_status_leaving_op(conn, ending):
+    end, status = ENDINGS[ending]
+    tid, run_id, run_uid = _running(conn)
+    with _ksr().staged(tid, run_id, _receipt(run_uid)):
+        assert end(conn, tid, run_id)
+    wire = _wire(conn, tid)
+    leaving = [i for i, op in enumerate(wire) if op["fields"].get("status") == status]
+    assert len(leaving) == 1, wire
+    op = wire[leaving[0]]
+    assert op["fields"]["source_receipt"] == _receipt(run_uid)
+    assert "current_run_uid" not in op["fields"], "status and run clear must stay separate ops"
+    later = wire[leaving[0] + 1:]
+    assert any(o["fields"].get("current_run_uid", "absent") is None for o in later), later
+    assert not any("source_receipt" in o["fields"] for i, o in enumerate(wire) if i != leaving[0])
+    assert _pending(conn) == 0
+
+
+def test_unseen_card_full_row_keeps_source_receipt(conn):
+    """A card the Board has not acknowledged goes as its full row; the virtual field must survive that."""
+    tid, run_id, run_uid = _running(conn, acked=False)
+    with _ksr().staged(tid, run_id, _receipt(run_uid)):
+        assert _complete(conn, tid, run_id)
+    leaving = [op for op in _wire(conn, tid) if op["fields"].get("status") == "done"]
+    assert [op["fields"].get("source_receipt") for op in leaving][:1] == [_receipt(run_uid)]
+
+
+def test_receipt_not_a_synced_column(conn):
+    assert "source_receipt" not in sync.SYNCED_COLUMNS["tasks"]
+    assert "source_receipt" in sync.VIRTUAL_WIRE_FIELDS["tasks"]
+    assert sync.undeclared_columns(conn) == {}
+
+
+def test_receipt_rolled_back_with_ending(conn, monkeypatch):
+    tid, run_id, run_uid = _running(conn)
+
+    def boom(*_a, **_k):
+        raise RuntimeError("ending failed after the status UPDATE")
+    monkeypatch.setattr(kb, "_end_run", boom)
+    with _ksr().staged(tid, run_id, _receipt(run_uid)), pytest.raises(RuntimeError):
+        _complete(conn, tid, run_id)
+    assert conn.execute("SELECT status FROM tasks WHERE id = ?", (tid,)).fetchone()[0] == "running"
+    assert _wire(conn, tid) == []
+    assert _pending(conn) == 0
+
+
+def _parents_race(monkeypatch):
+    """The parent reopens between ``complete_task``'s pre-check and its in-txn re-check."""
+    answers = iter([True])
+    monkeypatch.setattr(kb, "_parents_satisfied", lambda *_a, **_k: next(answers, False))
+
+
+REFUSALS = {
+    "complete_parents_unsatisfied": lambda c, t, r, mp: (_parents_race(mp), _complete(c, t, r))[1],
+    "complete_run_mismatch": lambda c, t, r, mp: _complete(c, t, r + 999),
+    "schedule_cas_miss": lambda c, t, r, mp: _schedule(c, t, r + 999),
+    "block_cas_miss": lambda c, t, r, mp: _block(c, t, r + 999),
+}
+
+
+@pytest.mark.parametrize("refusal", sorted(REFUSALS))
+def test_refused_ending_leaves_no_pending_receipt(conn, monkeypatch, refusal):
+    tid, run_id, run_uid = _running(conn)
+    with _ksr().staged(tid, run_id, _receipt(run_uid)):
+        assert not REFUSALS[refusal](conn, tid, run_id, monkeypatch)
+    assert conn.execute("SELECT status FROM tasks WHERE id = ?", (tid,)).fetchone()[0] == "running"
+    assert _pending(conn) == 0
+
+
+def test_stale_reclaim_after_refused_complete_sends_no_receipt(conn):
+    tid, run_id, run_uid = _running(conn)
+    with _ksr().staged(tid, run_id, _receipt(run_uid)):
+        assert not _complete(conn, tid, run_id + 999)
+    # The worker dies; its claim bookkeeping is gone and the claim is older than the in-flight grace.
+    _applying(conn, "UPDATE task_events SET created_at = created_at - 100000 WHERE task_id = ? AND kind = 'claimed'",
+              (tid,))
+    _applying(conn, "UPDATE tasks SET claim_lock = NULL, claim_expires = NULL WHERE id = ?", (tid,))
+    assert kd.reconcile_orphaned_running(conn) == [tid]
+    raw = [json.loads(r[0]) for r in conn.execute(
+        "SELECT fields FROM kanban_sync_outbox WHERE table_name = 'tasks' AND row_uid = ?", (tid,))]
+    assert not any("source_receipt" in f for f in raw), raw  # outbox level: not masked by the wire filter
+    wire = _wire(conn, tid)
+    assert any(op["fields"].get("status") == "ready" for op in wire), wire
+    assert not any("source_receipt" in op["fields"] for op in wire), wire
+    assert _pending(conn) == 0
+
+
+def _claimed_live(live, kanban_home, svc):
+    tid = kb.create_task(live, title="pushed", assignee="worker")
+    helpers._round(kanban_home, svc)
+    assert kb.claim_task(live, tid, ttl_seconds=900, claimer=f"{kb._host_prefix()}:1")
+    helpers._round(kanban_home, svc)
+    return (tid, *_run_of(live, tid))
+
+
+def test_push_wire_op_carries_source_receipt(live, svc, kanban_home):
+    tid, run_id, run_uid = _claimed_live(live, kanban_home, svc)
+    with _ksr().staged(tid, run_id, _receipt(run_uid)):
+        assert _complete(live, tid, run_id)
+    sent: list[dict] = []
+    hub = svc.hub(helpers.ME)
+
+    def ops(board, batch):  # a new Board consumes the receipt; the fake only stores real columns
+        sent.extend(copy.deepcopy(batch))
+        return hub.ops(board, [{**op, "fields": {k: v for k, v in op["fields"].items() if k != "source_receipt"}}
+                               if "fields" in op else op for op in batch])
+    res = ksc.push(live, SimpleNamespace(ops=ops), helpers.BOARD, helpers.ME, primary=True)
+    assert res.rejected == 0
+    done = [op for op in sent if op["table"] == "tasks" and op.get("fields", {}).get("status") == "done"]
+    assert [op["fields"].get("source_receipt") for op in done] == [_receipt(run_uid)]
+    assert not any("source_receipt" in op.get("fields", {}) for op in sent if op not in done)
+
+
+def test_old_board_forbidden_source_receipt_drops_without_omission(live, svc, kanban_home):
+    tid, run_id, run_uid = _claimed_live(live, kanban_home, svc)
+    with _ksr().staged(tid, run_id, _receipt(run_uid)):
+        assert _complete(live, tid, run_id)
+    sent: list[dict] = []
+    hub = svc.hub(helpers.ME)
+
+    def ops(board, batch):  # an old Board: source_receipt is not a writable task field
+        sent.extend(copy.deepcopy(batch))
+        results = []
+        for op in batch:
+            if op["table"] == "tasks" and "source_receipt" in op.get("fields", {}):
+                results.append({"client_op_id": op["client_op_id"], "status": "rejected",
+                                "reason": "forbidden_field", "detail": "not writable on tasks: source_receipt"})
+            else:
+                results.extend(hub.ops(board, [op])["results"])
+        return {"results": results}
+    for _ in range(3):
+        ksc.push(live, SimpleNamespace(ops=ops), helpers.BOARD, helpers.ME, primary=True)
+    refused = [op for op in sent if "source_receipt" in op.get("fields", {})]
+    assert len(refused) == 1, "the old Board must have seen (and refused) the receipt exactly once"
+    assert svc.board(helpers.BOARD)["rows"]["tasks"][tid]["status"] == "done"
+    assert live.execute("SELECT COUNT(*) FROM kanban_sync_omissions").fetchone()[0] == 0
+    assert live.execute("SELECT COUNT(*) FROM kanban_sync_outbox").fetchone()[0] == 0
+    from hermes_cli.kanban_sync_omissions import repair_holds
+    assert tid not in repair_holds(live, "tasks")
+
+
+def test_malformed_pending_receipt_rejected(conn):
+    tid, run_id, _uid = _running(conn)
+    with pytest.raises(sqlite3.IntegrityError):
+        with kbc.write_txn(conn):
+            conn.execute("INSERT INTO kanban_source_receipt_pending (task_id, run_id, receipt) VALUES (?, ?, ?)",
+                         (tid, run_id, "{not json"))
+    assert _pending(conn) == 0
+    assert _complete(conn, tid, run_id)  # the ending itself is unaffected
-- 
