-    the canonical service fails (or bootstraps a second, competing supervisor). The canonical plist
-    starts the gateway through a stderr launcher, so its job pid may be the gateway's parent: walk
-    the ancestry. Only a positive match counts; an unreadable job (launchctl/systemctl error or
-    timeout) is not proof of ownership. Kinds other than launchd/systemd keep the service path.
-    """
-    if kind not in ("launchd", "systemd"):
-        return True
-    from hermes_cli import gateway as gw
-
-    try:
-        if kind == "launchd":
-            service_pid = gw._launchd_print_service_pid(gw._launchd_domain(), gw.get_launchd_label())[1]
-        else:
-            service_pid = gw._systemd_main_pid(system=system)
-    except Exception:
-        return False
-    if not service_pid or service_pid <= 1:
-        return False
-    current: int | None = pid
-    for _ in range(8):  # gateway → launcher → job; bounded against pid-reuse cycles
-        if current is None or current <= 1:
-            return False
-        if current == service_pid:
-            return True
-        current = gw._get_parent_pid(current)
-    return False
-
-
 def _wait_for_supervised_gateway_replacement(
     old_pid: int, timeout: float | None = None, *, poll_interval: float = 0.5
 ) -> int | None:
diff --git a/tests/hermes_cli/test_gateway_restart_installed_service_external_supervisor.py b/tests/hermes_cli/test_gateway_restart_installed_service_external_supervisor.py
index 7bb063e6a03..061072e332d 100644
--- a/tests/hermes_cli/test_gateway_restart_installed_service_external_supervisor.py
+++ b/tests/hermes_cli/test_gateway_restart_installed_service_external_supervisor.py
@@ -67,19 +67,28 @@ def _spawn_fake_gateway(script) -> subprocess.Popen:
 
 
 class _FakeSupervisor:
-    """A KeepAlive manager this test owns: relaunches the gateway once its first instance exits."""
+    """A KeepAlive manager this test owns: relaunches the gateway once its first instance exits.
+
+    ``close`` stops relaunching before it kills anything: killing ``first`` wakes the watcher, and
+    without the closed flag (checked under the same lock the relaunch holds) it spawned ``second``
+    after teardown had already passed it, leaking a lookalike gateway past the test.
+    """
 
     def __init__(self, script, relaunch: bool = True):
         self._script = script
+        self._lock = threading.Lock()
+        self._closed = False
         self.first = _spawn_fake_gateway(script)
         self.second: subprocess.Popen | None = None
         self._relaunch = relaunch
-        threading.Thread(target=self._watch, daemon=True).start()
+        self._watcher = threading.Thread(target=self._watch, daemon=True)
+        self._watcher.start()
 
     def _watch(self):
         self.first.wait()
-        if self._relaunch:
-            self.second = _spawn_fake_gateway(self._script)
+        with self._lock:
+            if self._relaunch and not self._closed:
+                self.second = _spawn_fake_gateway(self._script)
 
     def running_pid(self, *a, **k):
         if self.first.poll() is None:
@@ -87,9 +96,15 @@ class _FakeSupervisor:
         return self.second.pid if self.second is not None else None
 
     def close(self):
+        with self._lock:  # waits out an in-flight relaunch, then forbids any later one
+            self._closed = True
         for proc in (self.first, self.second):
             if proc is not None and proc.poll() is None:
                 proc.kill()
+        self._watcher.join(timeout=10)
+        for proc in (self.first, self.second):
+            if proc is not None:
+                proc.wait(timeout=10)
 
 
