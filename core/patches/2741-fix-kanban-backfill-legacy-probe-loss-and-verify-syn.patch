diff --git a/hermes_cli/kanban_ask_resolved_backfill.py b/hermes_cli/kanban_ask_resolved_backfill.py
new file mode 100644
index 0000000000..385fe3d454
--- /dev/null
+++ b/hermes_cli/kanban_ask_resolved_backfill.py
@@ -0,0 +1,77 @@
+"""Backfill ``human_request.resolved_check_dropped_at`` for asks whose probe was dropped before the mark existed. [daveey]
+
+Older cores appended ``BROKEN_EVENT`` / ``LOST_EVENT`` without marking the ask. ``kanban_ask_resolved.reconcile``
+skips such a card forever (a terminal event follows its latest filing), so nothing tells origins or readers that
+the probe stopped. This marks only a card that is still blocked, still names a resolved_check, has no probe row
+and no mark, and whose *latest* ``blocked`` filing is followed by a drop event and no resolution. The mark takes
+the drop event's own time and kind; no event or comment is written (the drop was already reported), and the read
+pass takes no write txn. A refiled ask has a newer ``blocked`` event, so an older drop never marks it. An ask whose
+probe another gateway owns, or a worker-node copy of another gateway's card, is left to that owner.
+"""
+from __future__ import annotations
+
+import sqlite3
+from typing import Optional
+
+_DROPS = ("resolved_check_broken", "resolved_check_lost")
+_RESOLVED = "ask_resolved"
+
+
+def _latest_drop(conn: sqlite3.Connection, tid: str) -> Optional[tuple[int, int, str, int]]:
+    """``(filed_id, drop_event_id, kind, drop_time)`` for the latest filing's unresolved drop, else None."""
+    filed = conn.execute("SELECT id FROM task_events WHERE task_id = ? AND kind = 'blocked' "
+                         "ORDER BY id DESC LIMIT 1", (tid,)).fetchone()
+    if filed is None:
+        return None
+    marks = ",".join("?" for _ in (*_DROPS, _RESOLVED))
+    rows = conn.execute(f"SELECT id, kind, created_at FROM task_events WHERE task_id = ? AND id > ? "
+                        f"AND kind IN ({marks}) ORDER BY id", (tid, filed[0], *_DROPS, _RESOLVED)).fetchall()
+    drops = [r for r in rows if r[1] in _DROPS]
+    if not drops or any(r[1] == _RESOLVED for r in rows):
+        return None
+    last = drops[-1]
+    return int(filed[0]), int(last[0]), str(last[1]), int(last[2] or 0)
+
+
+def _eligible(conn: sqlite3.Connection, tid: str) -> bool:
+    from hermes_cli import kanban_ask_resolved as kar
+    from hermes_cli import kanban_wake_check as kwc
+
+    row = conn.execute("SELECT status, human_request FROM tasks WHERE id = ?", (tid,)).fetchone()
+    if row is None or row[0] != "blocked" or not kar.resolved_check(row[1])[0]:
+        return False
+    if (kar._request(row[1]) or {}).get("resolved_check_dropped_at"):
+        return False
+    return kwc.get_state(conn, tid) is None
+
+
+def backfill(conn: sqlite3.Connection) -> list[str]:
+    """Mark legacy dropped asks; returns the ids marked. Idempotent: a marked ask is never selected again."""
+    from hermes_cli import kanban_ask_resolved as kar
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_wake_check as kwc
+
+    try:
+        ids = [r[0] for r in conn.execute(
+            "SELECT t.id FROM tasks t LEFT JOIN task_wake_checks w ON w.task_id = t.id WHERE t.status = 'blocked' "
+            "AND w.task_id IS NULL AND t.human_request LIKE '%\"resolved_check\"%' "
+            "AND t.human_request NOT LIKE '%\"resolved_check_dropped_at\"%'").fetchall()]
+    except sqlite3.OperationalError:
+        return []
+    own = kwc.own_gateway(conn)
+    foreign = kwc.foreign_ids(conn, own)
+    marked: list[str] = []
+    for tid in ids:
+        drop = _latest_drop(conn, tid)
+        if drop is None:
+            continue
+        payload = conn.execute("SELECT payload FROM task_events WHERE id = ?", (drop[0],)).fetchone()
+        host = kb._json_dict(payload[0]).get("probe_host") if payload else None
+        if (host and own and host != own) or (tid in foreign and not host):
+            continue
+        with kb.write_txn(conn):
+            if _latest_drop(conn, tid) != drop or not _eligible(conn, tid):
+                continue
+            kar.mark_dropped(conn, tid, drop[2], drop[3])
+            marked.append(tid)
+    return marked
diff --git a/tests/hermes_cli/test_kanban_ask_backfill.py b/tests/hermes_cli/test_kanban_ask_backfill.py
new file mode 100644
index 0000000000..f3f70af009
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_ask_backfill.py
@@ -0,0 +1,139 @@
+"""Legacy dropped asks (drop event, no ``resolved_check_dropped_at``) are marked once by reconcile."""
+import json
+
+import pytest
+
+from hermes_cli import kanban_ask_resolved as kar
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_wake_check as kwc
+from tests.hermes_cli import test_kanban_ask_resolved_check as helpers
+
+board = helpers.board
+DROPS = [kar.BROKEN_EVENT, kar.LOST_EVENT]
+
+
+def _request(conn, tid):
+    value = kb.get_task(conn, tid).human_request
+    return (json.loads(value) if isinstance(value, str) else value) or {}
+
+
+def _legacy(conn, tid, kind, at=5000, **payload):
+    """Old core: probe row gone, drop event appended, ask left unmarked."""
+    with kb.write_txn(conn):
+        conn.execute("DELETE FROM task_wake_checks WHERE task_id = ?", (tid,))
+        kb._append_event(conn, tid, kind, {"cmd": "exit 1", **payload})
+        conn.execute("UPDATE task_events SET created_at = ? WHERE id = (SELECT MAX(id) FROM task_events "
+                     "WHERE task_id = ?)", (at, tid))
+
+
+def _count(conn):
+    return conn.execute("SELECT COUNT(*) FROM task_events").fetchone()[0]
+
+
+def _snapshot(conn):
+    return (conn.total_changes, _count(conn), conn.execute("SELECT human_request FROM tasks").fetchall())
+
+
+@pytest.mark.parametrize("kind", DROPS)
+def test_old_drop_is_marked_once_without_new_events(board, kind):
+    with kbc.connect_closing() as conn:
+        tid = helpers._blocked_ask(conn, "exit 1")
+        _legacy(conn, tid, kind, at=5000)
+        events = _count(conn)
+        out = kar.reconcile(conn, now=99999)
+        assert out["restored"] == out["lost"] == []
+        req = _request(conn, tid)
+        assert (req["resolved_check_dropped_at"], req["resolved_check_drop_reason"]) == (5000, kind)
+        assert req["resolved_check"] == "exit 1"
+        assert _count(conn) == events and kwc.get_state(conn, tid) is None
+        assert kb.get_task(conn, tid).status == "blocked"
+        before = _snapshot(conn)
+        assert not any(kar.reconcile(conn, now=199999).values())
+        assert _snapshot(conn) == before  # no writes at all
+
+
+def test_refile_does_not_inherit_old_mark_and_old_drop_does_not_mark_refile(board):
+    with kbc.connect_closing() as conn:
+        tid = helpers._blocked_ask(conn, "exit 1")
+        _legacy(conn, tid, kar.BROKEN_EVENT)
+        kar.reconcile(conn, now=9000)
+        marked = _request(conn, tid)
+        assert marked["resolved_check_dropped_at"] == 5000
+        with kb.write_txn(conn):
+            kar.store_request(conn, tid, marked)
+            kb._append_event(conn, tid, "blocked", {})
+        refiled = _request(conn, tid)
+        assert "resolved_check_dropped_at" not in refiled and kwc.get_state(conn, tid) is not None
+        # Refiled with its probe row lost (legacy): the old drop precedes the new filing, so no mark.
+        with kb.write_txn(conn):
+            conn.execute("DELETE FROM task_wake_checks WHERE task_id = ?", (tid,))
+        kar.reconcile(conn, now=10000)
+        assert "resolved_check_dropped_at" not in _request(conn, tid)
+        assert kar.RESTORED_EVENT in {e.kind for e in kb.list_events(conn, tid)}
+
+
+def test_resolved_event_is_not_marked(board):
+    with kbc.connect_closing() as conn:
+        tid = helpers._blocked_ask(conn, "exit 1")
+        _legacy(conn, tid, kar.BROKEN_EVENT)
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, kar.EVENT, {"cmd": "exit 1", "rc": 0})
+        kar.reconcile(conn, now=9000)
+        assert "resolved_check_dropped_at" not in _request(conn, tid)
+
+
+def test_latest_drop_kind_wins(board):
+    with kbc.connect_closing() as conn:
+        tid = helpers._blocked_ask(conn, "exit 1")
+        _legacy(conn, tid, kar.BROKEN_EVENT, at=5000)
+        _legacy(conn, tid, kar.LOST_EVENT, at=6000)
+        kar.reconcile(conn, now=9000)
+        assert (_request(conn, tid)["resolved_check_dropped_at"],
+                _request(conn, tid)["resolved_check_drop_reason"]) == (6000, kar.LOST_EVENT)
+
+
+def test_remote_probe_owner_and_live_probe_and_unblocked_are_left_alone(board, monkeypatch):
+    from hermes_cli.kanban_ask_resolved_backfill import backfill
+
+    with kbc.connect_closing() as conn:
+        live = helpers._blocked_ask(conn, "exit 1")  # probe row still present
+        with kb.write_txn(conn):
+            kb._append_event(conn, live, kar.BROKEN_EVENT, {})
+        remote = helpers._blocked_ask(conn, "exit 1")
+        with kb.write_txn(conn):
+            kb._append_event(conn, remote, "blocked", {"probe_host": "gw-worker"})
+        _legacy(conn, remote, kar.BROKEN_EVENT)
+        done = helpers._blocked_ask(conn, "exit 1")
+        _legacy(conn, done, kar.BROKEN_EVENT)
+        kb.unblock_task(conn, done)
+        monkeypatch.setattr(kwc, "own_gateway", lambda c: "gw-home")
+        assert backfill(conn) == []
+        for tid in (live, remote, done):
+            assert "resolved_check_dropped_at" not in _request(conn, tid)
+        monkeypatch.setattr(kwc, "own_gateway", lambda c: "gw-worker")  # the owner itself marks it
+        assert backfill(conn) == [remote]
+
+
+def test_write_fence_rechecks_latest_filing_and_missing_probe(board, monkeypatch):
+    from hermes_cli import kanban_ask_resolved_backfill as bf
+
+    with kbc.connect_closing() as conn:
+        tid = helpers._blocked_ask(conn, "exit 1")
+        _legacy(conn, tid, kar.BROKEN_EVENT)
+        real = bf._latest_drop
+
+        def racing(c, t):
+            result = real(c, t)
+            if not racing.done:  # between the read pass and the txn, the ask is refiled
+                racing.done = True
+                with kb.write_txn(c):
+                    kar.store_request(c, t, _request(c, t))
+                    kb._append_event(c, t, "blocked", {})
+            return result
+
+        racing.done = False
+        monkeypatch.setattr(bf, "_latest_drop", racing)
+        assert bf.backfill(conn) == []
+        assert "resolved_check_dropped_at" not in _request(conn, tid)
+        assert kwc.get_state(conn, tid) is not None
diff --git a/tests/hermes_cli/test_kanban_ask_mutation_fences.py b/tests/hermes_cli/test_kanban_ask_mutation_fences.py
new file mode 100644
index 0000000000..12b9b492a6
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_ask_mutation_fences.py
@@ -0,0 +1,218 @@
+"""Mutation-survivor tests: grace boundary, backfill eligibility/generation fences, notice coalescing."""
+import sqlite3
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_ask_resolved as kar
+from hermes_cli import kanban_ask_resolved_backfill as bf
+from hermes_cli import kanban_block_notice as bn
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_wake_check as kwc
+from tests.hermes_cli import test_kanban_ask_backfill as legacy
+from tests.hermes_cli import test_kanban_ask_resolved_check as helpers
+
+board = helpers.board
+
+
+def _fail(conn, tid, at):
+    state = kwc.get_state(conn, tid)
+    return kar.apply_result(conn, tid, state["cmd"], 255, "down", generation=state["generation"], now=at)
+
+
+def test_grace_window_is_exactly_six_hours_with_count_already_met(board):
+    with kbc.connect_closing() as conn:
+        tid = helpers._blocked_ask(conn, "exit 255")
+        assert _fail(conn, tid, 1000) is None
+        assert _fail(conn, tid, 1001) is None
+        assert _fail(conn, tid, 1000 + kar.BROKEN_MIN_SECONDS - 1) is None  # 3rd failure, one second short
+        assert kwc.get_state(conn, tid)["fails"] == 3
+        assert _fail(conn, tid, 1000 + kar.BROKEN_MIN_SECONDS) == kar.BROKEN_EVENT
+    assert kar.BROKEN_MIN_SECONDS == 21600
+
+
+# --- backfill eligibility ---------------------------------------------------------------------------------
+
+def _candidates(conn, monkeypatch):
+    seen = []
+    real = bf._latest_drop
+    monkeypatch.setattr(bf, "_latest_drop", lambda c, t: (seen.append(t), real(c, t))[1])
+    bf.backfill(conn)
+    return set(seen)
+
+
+def test_sql_prefilter_excludes_probed_unblocked_and_already_marked(board, monkeypatch):
+    with kbc.connect_closing() as conn:
+        helpers._blocked_ask(conn, "exit 1")  # probe row present
+        done = helpers._blocked_ask(conn, "exit 1")
+        legacy._legacy(conn, done, kar.BROKEN_EVENT)
+        kb.unblock_task(conn, done)
+        marked = helpers._blocked_ask(conn, "exit 1")
+        legacy._legacy(conn, marked, kar.BROKEN_EVENT)
+        with kb.write_txn(conn):
+            kar.mark_dropped(conn, marked, kar.BROKEN_EVENT, 5000)
+        plain = helpers._blocked_ask(conn, "exit 1")
+        legacy._legacy(conn, plain, kar.LOST_EVENT)
+        assert _candidates(conn, monkeypatch) == {plain}
+
+
+def test_eligible_checks_each_clause(board):
+    with kbc.connect_closing() as conn:
+        tid = helpers._blocked_ask(conn, "exit 1")
+        assert not bf._eligible(conn, tid)  # probe row present
+        legacy._legacy(conn, tid, kar.BROKEN_EVENT)
+        assert bf._eligible(conn, tid)
+        assert not bf._eligible(conn, "missing")
+        with kb.write_txn(conn):
+            kar.mark_dropped(conn, tid, kar.BROKEN_EVENT, 5000)
+        assert not bf._eligible(conn, tid)  # already marked
+        plain = helpers._blocked_ask(conn, "exit 1")
+        legacy._legacy(conn, plain, kar.BROKEN_EVENT)
+        with kb.write_txn(conn):  # blocked but the filed ask names no resolved_check
+            conn.execute("UPDATE tasks SET human_request = ? WHERE id = ?",
+                         ('{"action": "x", "interaction": "user_terminal"}', plain))
+        assert not bf._eligible(conn, plain)
+        kb.unblock_task(conn, tid)
+        assert not bf._eligible(conn, tid)
+
+
+def test_foreign_card_without_host_is_left_and_with_own_host_is_marked(board, monkeypatch):
+    with kbc.connect_closing() as conn:
+        a = helpers._blocked_ask(conn, "exit 1")
+        legacy._legacy(conn, a, kar.BROKEN_EVENT)
+        monkeypatch.setattr(kwc, "own_gateway", lambda c: "gw-home")
+        monkeypatch.setattr(kwc, "foreign_ids", lambda c, own: {a})
+        assert bf.backfill(conn) == []  # worker copy of another gateway's card, no probe_host
+        b = helpers._blocked_ask(conn, "exit 1")
+        with kb.write_txn(conn):
+            kb._append_event(conn, b, "blocked", {"probe_host": "gw-home"})
+        legacy._legacy(conn, b, kar.BROKEN_EVENT)
+        monkeypatch.setattr(kwc, "foreign_ids", lambda c, own: {a, b})
+        assert bf.backfill(conn) == [b]  # probe host is us, even though the card id is foreign
+
+
+def test_write_fence_skips_when_latest_drop_changes_in_race(board, monkeypatch):
+    with kbc.connect_closing() as conn:
+        tid = helpers._blocked_ask(conn, "exit 1")
+        legacy._legacy(conn, tid, kar.BROKEN_EVENT)
+        real = bf._latest_drop
+
+        def racing(c, t):
+            result = real(c, t)
+            if not racing.done:
+                racing.done = True
+                with kb.write_txn(c):  # newer filing, probe row still absent: only the drop comparison catches it
+                    kb._append_event(c, t, "blocked", {})
+            return result
+
+        racing.done = False
+        monkeypatch.setattr(bf, "_latest_drop", racing)
+        assert bf.backfill(conn) == []
+        assert "resolved_check_dropped_at" not in legacy._request(conn, tid)
+
+
+def test_write_fence_skips_when_card_stops_being_eligible_in_race(board, monkeypatch):
+    with kbc.connect_closing() as conn:
+        tid = helpers._blocked_ask(conn, "exit 1")
+        legacy._legacy(conn, tid, kar.BROKEN_EVENT)
+        real = bf._latest_drop
+
+        def racing(c, t):
+            result = real(c, t)
+            if not racing.done:
+                racing.done = True
+                kb.unblock_task(c, t)  # unblock adds no blocked/drop/resolved event
+            return result
+
+        racing.done = False
+        monkeypatch.setattr(bf, "_latest_drop", racing)
+        assert bf.backfill(conn) == []
+        assert "resolved_check_dropped_at" not in legacy._request(conn, tid)
+
+
+def test_backfill_tolerates_a_database_without_wake_checks():
+    conn = sqlite3.connect(":memory:")
+    conn.execute("CREATE TABLE tasks (id TEXT, status TEXT, human_request TEXT)")
+    assert bf.backfill(conn) == []
+
+
+def test_ask_filed_after_old_drop_with_older_filing_is_judged_by_latest_filing(board):
+    with kbc.connect_closing() as conn:
+        tid = helpers._blocked_ask(conn, "exit 1")
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, "blocked", {})  # earlier filing
+        legacy._legacy(conn, tid, kar.BROKEN_EVENT, at=5000)
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, "blocked", {})  # latest filing, after the drop
+        assert bf._latest_drop(conn, tid) is None
+        assert bf.backfill(conn) == []
+
+
+# --- notice coalescing ------------------------------------------------------------------------------------
+
+def _ev(i, kind):
+    return SimpleNamespace(id=i, kind=kind)
+
+
+def test_coalesce_keeps_other_events_and_uses_latest_drop():
+    batch = [_ev(1, "status"), _ev(2, "blocked"), _ev(3, "resolved_check_broken"), _ev(4, "blocked"),
+             _ev(5, "resolved_check_lost"), _ev(6, "comment")]
+    assert [e.id for e in bn.coalesce_superseded_blocks(batch)] == [1, 3, 5, 6]
+    assert [e.id for e in bn.coalesce_superseded_blocks(batch[:3] + [_ev(4, "blocked")])] == [1, 3, 4]
+    assert bn.coalesce_superseded_blocks(batch[:2]) == batch[:2]
+    assert [e.id for e in bn.coalesce_superseded_blocks([_ev(1, "resolved_check_lost"), _ev(2, "blocked")])] == [1, 2]
+
+
+def test_drop_warning_names_cause_from_mark_else_from_event():
+    assert "its probe kept failing" in bn.drop_warning({"resolved_check_drop_reason": "resolved_check_broken"})
+    assert "its probe went missing" in bn.drop_warning({}, "resolved_check_lost")
+    assert "its probe kept failing" in bn.drop_warning({}, "resolved_check_broken")
+    assert "()" not in bn.drop_warning({}) and "(its probe" not in bn.drop_warning({})
+
+
+def test_store_request_clears_both_marks_without_mutating_the_callers_dict(board):
+    with kbc.connect_closing() as conn:
+        tid = helpers._blocked_ask(conn, "exit 1")
+        original = legacy._request(conn, tid)
+        original.update(resolved_check_dropped_at=5, resolved_check_drop_reason=kar.LOST_EVENT)
+        passed = dict(original)
+        with kb.write_txn(conn):
+            kar.store_request(conn, tid, passed)
+        stored = legacy._request(conn, tid)
+        assert "resolved_check_dropped_at" not in stored and "resolved_check_drop_reason" not in stored
+        assert passed == original  # the caller's request still carries the mark it handed in
+
+
+def test_dropped_card_notice_names_the_work_and_refiled_card_via_session_formatter(board):
+    from tui_gateway import session_notifications as sn
+
+    with kbc.connect_closing() as conn:
+        tid = helpers._blocked_ask(conn, "exit 1")
+        with kb.write_txn(conn):
+            kar.mark_dropped(conn, tid, kar.LOST_EVENT, 5000)
+        marked = kb.get_task(conn, tid)
+        text = sn._format_kanban_event_text({}, marked, SimpleNamespace(kind=kar.LOST_EVENT, payload={}), "default")
+        assert f"Work: {marked.title}" in text and "Automatic detection stopped" in text
+        with kb.write_txn(conn):
+            kar.store_request(conn, tid, legacy._request(conn, tid))  # re-filed: mark cleared
+        refiled = kb.get_task(conn, tid)
+        text = sn._format_kanban_event_text({}, refiled, SimpleNamespace(kind=kar.LOST_EVENT, payload={}), "default")
+        assert "re-filed since" in text.lower()
+        text = sn._format_kanban_event_text({}, refiled, SimpleNamespace(kind="blocked", payload={}), "default")
+        assert "re-filed since" not in text.lower()
+
+
+def test_remote_drop_mark_requires_blocked_valid_nonzero_json_or_dict():
+    from tui_gateway import kanban_remote_notices as krn
+    from tui_gateway import kanban_remote_observations as kro
+
+    request = {"resolved_check_dropped_at": 7}
+    assert krn.drop_mark({"status": "blocked", "human_request": request}) == 7.0
+    assert krn.drop_mark({"status": "blocked", "human_request": '{"resolved_check_dropped_at": 7}'}) == 7.0
