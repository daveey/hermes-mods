From 713492d02d1703ccf3eb23806f2eb83e3d6ea9d9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 07:19:18 +0000
Subject: [PATCH] [daveey] Pass the resolved assignee keyword to _cli_fields in
 CLI create diagnostics

main's PR1230 made kanban_worker_placement._cli_fields(..., *, assignee) keyword-only;
the rebased diagnostic call site still used the old positional shape, so every CLI
create that reached the structural diagnostic raised TypeError after the commit.

Pass assignee=task.assignee and build the fields inside the diagnostic's failure
guard, so a future helper drift degrades to 'portability diagnostic failed' rather
than crashing an already committed create. The create tests already fail on
b96d0f49 (8 CLI cases); the failure test now also covers field building.
---
 hermes_cli/kanban_placement_diagnostics.py    |  3 +--
 .../test_kanban_placement_diagnostics.py      | 20 ++++++++++++++++---
 2 files changed, 18 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_placement_diagnostics.py b/hermes_cli/kanban_placement_diagnostics.py
index 52fe4efa91..04323dc427 100644
--- a/hermes_cli/kanban_placement_diagnostics.py
+++ b/hermes_cli/kanban_placement_diagnostics.py
@@ -91,9 +91,8 @@ def cli_creation(args, body, workspace_kind, workspace_path, board, task, *, ski
     runs_on = getattr(args, "runs_on", None)
     if runs_on is not None:
         return {**result, "runs_on": runs_on, "why": "execution labels specified by the caller"}
-    fields = _cli_fields(args, body, workspace_kind, workspace_path, board)
-    fields["assignee"] = task.assignee
     try:
+        fields = _cli_fields(args, body, workspace_kind, workspace_path, board, assignee=task.assignee)
         result["why"] = local_why(fields, fallback="CLI creates on this gateway")
     except Exception:  # health: allow BLE001 -- diagnostics cannot fail an already committed create
         result["why"] = "portability diagnostic failed"
diff --git a/tests/hermes_cli/test_kanban_placement_diagnostics.py b/tests/hermes_cli/test_kanban_placement_diagnostics.py
index 678ae94a70..cb045dee3f 100644
--- a/tests/hermes_cli/test_kanban_placement_diagnostics.py
+++ b/tests/hermes_cli/test_kanban_placement_diagnostics.py
@@ -166,13 +166,27 @@ def test_cli_diagnostic_judges_the_resolved_assignee(local_board):
     assert out == {"where": "local", "why": "assignee not allowlisted"}
 
 
-def test_cli_diagnostic_failure_does_not_fail_committed_create(local_board, monkeypatch):
+@pytest.mark.parametrize("module,attr", [("kanban_placement_diagnostics", "local_why"),
+                                         ("kanban_worker_placement", "_cli_fields")])
+def test_cli_diagnostic_failure_does_not_fail_committed_create(local_board, monkeypatch, module, attr):
+    """Field building is diagnostic too: helper drift (e.g. a new keyword-only argument)
+    must not turn an already committed create into a CLI crash."""
+    import importlib
+    import sys
+
     from hermes_cli import kanban as cli
-    from hermes_cli import kanban_placement_diagnostics as diagnostics
+    target = importlib.import_module(f"hermes_cli.{module}")
+    real = getattr(target, attr)
+    calls = []
+
     def broken(*args, **kwargs):
+        if sys._getframe(1).f_code.co_name != "cli_creation":
+            return real(*args, **kwargs)  # cli_policy/cli_audit judge the same fields before the commit
+        calls.append(attr)
         raise ValueError("broken diagnostic")
-    monkeypatch.setattr(diagnostics, "local_why", broken)
+    monkeypatch.setattr(target, attr, broken)
     out = json.loads(cli.run_slash("create 'Inspect special-device' --assignee default --json"))
+    assert calls == [attr]
     assert out["placement"] == {"where": "local", "why": "portability diagnostic failed"}
     with kbc.connect() as conn:
         assert kb.get_task(conn, out["id"]) is not None
-- 
