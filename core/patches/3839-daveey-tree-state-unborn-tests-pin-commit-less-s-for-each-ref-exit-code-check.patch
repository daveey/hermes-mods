From 0f684d9661348bedaf6c2d47977fc23551377a8f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:50:05 +0000
Subject: [PATCH] [daveey] tree_state unborn tests: pin _commit_less's
 for-each-ref exit-code check

#2582 added `and not refs.stderr.strip()` to `_commit_less`. The only test of
the `refs.returncode == 0` clause faked a failing for-each-ref WITH stderr
(`fatal: broken`), so the stderr conjunct backstopped it and dropping the rc
clause (mutant M4) left all 13 tests green. A for-each-ref that fails silently
(signal-killed git: exit -9, empty stdout and stderr) would then read a repo
as commit-less, tree_state None, and the card would leave the machine.

New test_a_ref_listing_that_fails_silently_keeps_the_fail_safe fakes exactly
that and asserts the unpushed fail-safe holds.

Proof (hermes-core-wt test tests/hermes_cli/test_kanban_tree_state_unborn.py):
- origin/main + test: 14 passed, 0 failed, 0 skipped
- M4 (`return not refs.stdout.strip() and not refs.stderr.strip()`): 13 passed,
  1 failed (only the new test)

Kanban: t_01a1d6a367b14405 (found by post-merge check t_01a1d697a75b329e)
---
 tests/hermes_cli/test_kanban_tree_state_unborn.py | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_tree_state_unborn.py b/tests/hermes_cli/test_kanban_tree_state_unborn.py
index d13eb40128..dda18eafb5 100644
--- a/tests/hermes_cli/test_kanban_tree_state_unborn.py
+++ b/tests/hermes_cli/test_kanban_tree_state_unborn.py
@@ -88,6 +88,21 @@ def test_a_failing_ref_listing_keeps_the_fail_safe(tmp_path, monkeypatch):
     assert kmp.tree_state([str(tree)]) == f"unpushed commits in {tree}"
 
 
+def test_a_ref_listing_that_fails_silently_keeps_the_fail_safe(tmp_path, monkeypatch):
+    """A ``for-each-ref`` killed by a signal (exit -9, no stdout and no stderr) is no proof of an empty repo: the
+    exit code alone must keep the fail-safe, since the stderr check has nothing to see."""
+    from hermes_cli import worktree_ops
+    real = worktree_ops._git
+
+    def git(args, cwd, *a, **kw):
+        if args and args[0] == "for-each-ref" and "refs/remotes" not in args:
+            return subprocess.CompletedProcess(["git", *args], -9, "", "")
+        return real(args, cwd, *a, **kw)
+    monkeypatch.setattr(worktree_ops, "_git", git)
+    tree = _init(tmp_path / "core-fixture")
+    assert kmp.tree_state([str(tree)]) == f"unpushed commits in {tree}"
+
+
 def _commit_behind_a_broken_ref(tmp_path, ref_text):
     """A clean repo holding commit c1 whose only ref is broken: index and file gone, so status reads clean, HEAD
     does not resolve, and ``for-each-ref`` skips the ref with a stderr warning, exit 0 and no output."""
