Subject: [PATCH] feat(desktop): allow strictly validated client VNC launches
 [daveey]

---
 apps/desktop/electron/external-open.test.ts | 27 +++++++++++++++++++++
 apps/desktop/electron/external-open.ts      | 27 +++++++++++++++++++++
 2 files changed, 54 insertions(+)

diff --git a/apps/desktop/electron/external-open.test.ts b/apps/desktop/electron/external-open.test.ts
index aaac609090..a02aa335df 100644
--- a/apps/desktop/electron/external-open.test.ts
+++ b/apps/desktop/electron/external-open.test.ts
@@ -46,6 +46,33 @@ function makeDeps(overrides: Partial<ExternalOpenDeps> = {}) {
   return { deps, calls }
 }
 
+test('VNC opens only strict host authorities through the client OS, never WSL shell', async () => {
+  const { deps, calls } = makeDeps({ isWsl: true })
+
+  for (const host of ['computer.local', '192.0.2.1', 'computer.local:5901']) {
+    assert.deepEqual(await openExternalUrl(`vnc://${host}`, deps), { ok: true })
+  }
+
+  assert.deepEqual(calls.opened, ['vnc://computer.local', 'vnc://192.0.2.1', 'vnc://computer.local:5901'])
+})
+
+test('VNC rejects credentials, paths, controls, ambiguous IPs and shell syntax', async () => {
+  const { deps, calls } = makeDeps()
+
+  for (const host of ['user@host', 'host/', 'host?x', 'host#x', 'host\\n', ' host', '[::1]', '::1', 'host:0', 'host:65536', 'host:abc', '-host', 'host..local', '999.1.1.1', '127.1', 'host;open', 'host%20', 'host\\\\path']) {
+    assert.deepEqual(await openExternalUrl(`vnc://${host}`, deps), { ok: false, reason: 'invalid' }, host)
+  }
+
+  assert.deepEqual(calls.opened, [])
+})
+
+test('VNC launch failures are surfaced', async () => {
+  const { deps, calls } = makeDeps({ openExternal: async () => { throw new Error('No VNC handler') } })
+
+  assert.deepEqual(await openExternalUrl('vnc://computer.local', deps), { ok: false, reason: 'failed', message: 'No VNC handler' })
+  assert.deepEqual(calls.notified, [['vnc://computer.local', 'No VNC handler']])
+})
+
 test('resolves ok and opens when openExternal succeeds', async () => {
   const { deps, calls } = makeDeps()
 
diff --git a/apps/desktop/electron/external-open.ts b/apps/desktop/electron/external-open.ts
index 8e06318594..6d6894c6ef 100644
--- a/apps/desktop/electron/external-open.ts
+++ b/apps/desktop/electron/external-open.ts
@@ -81,6 +81,33 @@ export function externalOpenErrorMessage(error: unknown): string {
  * so fire-and-forget callers can `void` the result safely.
  */
 export async function openExternalUrl(rawUrl: string, deps: ExternalOpenDeps): Promise<ExternalOpenResult> {
+  // VNC is an authority-only capability, not a general external scheme.
+  // Validate BEFORE trim/URL parsing, which otherwise erase hostile controls.
+  if (/^vnc:/i.test(String(rawUrl || '').trim())) {
+    const match = /^vnc:\/\/([a-zA-Z0-9.-]+)(?::([0-9]{1,5}))?$/.exec(rawUrl)
+    const host = match?.[1] || ''
+    const labels = host.split('.')
+
+    const validHost = host.length <= 253 && labels.every(label =>
+      /^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$/.test(label))
+
+    const validIp = !/^[0-9.]+$/.test(host) || (labels.length === 4 && labels.every(label =>
+      /^(0|[1-9][0-9]{0,2})$/.test(label) && Number(label) <= 255))
+
+    // IPv6 is deliberately unsupported; never pass a partially parsed address.
+    if (!match || match[0] !== rawUrl || !validHost || !validIp || (match[2] && (Number(match[2]) < 1 || Number(match[2]) > 65535))) {
+      return { ok: false, reason: 'invalid' }
+    }
+
+    try {
+      await deps.openExternal(rawUrl)
+
+      return { ok: true }
+    } catch (error) {
+      return failOpen(deps, rawUrl, error)
+    }
+  }
+
   const raw = absolutizeProtocolRelativeUrl(String(rawUrl || '').trim())
 
   if (!raw) {
