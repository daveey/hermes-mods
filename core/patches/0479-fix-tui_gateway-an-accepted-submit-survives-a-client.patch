diff --git a/tui_gateway/session_history.py b/tui_gateway/session_history.py
index 22ced4df50da9230765e859514bdd39a78e2719b..76e89357af86b5f8143c4d141295f62f79473a19 100644
--- a/tui_gateway/session_history.py
