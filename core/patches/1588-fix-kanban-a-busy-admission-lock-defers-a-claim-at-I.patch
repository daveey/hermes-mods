From 02b2c78f2881a92c1c68cf423fc8780c9ff8682e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 00:56:24 +0000
Subject: [PATCH] fix(kanban): a busy admission lock defers a claim at INFO,
 not WARNING+traceback [daveey]

Designed contention (another claimer holding admission.lock through its commit)
was logged like a real lock failure, so the coach detector filed false self-heal
defects (agent-df3f7bcb33). AdmissionBusy now logs INFO with no traceback; OSError
and other TimeoutErrors keep WARNING with exc_info. Claim behaviour is unchanged.
Tests pin both log-level contracts.
---
 hermes_cli/kanban_admission.py                |  9 ++++-
 .../test_kanban_admission_contention.py       | 33 +++++++++++++++++++
 2 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_admission.py b/hermes_cli/kanban_admission.py
index f322dfc7ef7..fe9502b3063 100644
--- a/hermes_cli/kanban_admission.py
+++ b/hermes_cli/kanban_admission.py
@@ -83,7 +83,7 @@ def claim_transaction(conn):
     process's installation root, not the board path. Hooks run after both locks.
     """
     from hermes_constants import get_default_hermes_root
-    from hermes_cli.admission_fence import admission_lock, is_held, HOLD_MESSAGE, SUPPORTED
+    from hermes_cli.admission_fence import AdmissionBusy, admission_lock, is_held, HOLD_MESSAGE, SUPPORTED
     from hermes_cli.kanban_db import write_txn
 
     if conn.in_transaction:
@@ -103,6 +103,13 @@ def claim_transaction(conn):
             try:
                 root = stack.enter_context(admission_lock(get_default_hermes_root(), timeout=0))
                 held = is_held(root)
+            except AdmissionBusy:
+                # [daveey] Designed contention: another claimer (or hermes-sync) holds admission.lock
+                # through its commit. A normal defer, not a failure: no WARNING/traceback, which the
+                # coach signal detector would file as a defect.
+                logging.getLogger(__name__).info("Update admission lock busy; deferring Kanban claim to the next tick")
+                yield False
+                return
             except (OSError, TimeoutError):
                 logging.getLogger(__name__).warning("Update admission unavailable; deferring Kanban claim", exc_info=True)
                 yield False
diff --git a/tests/hermes_cli/test_kanban_admission_contention.py b/tests/hermes_cli/test_kanban_admission_contention.py
index 310f27391b2..107bcbd9e5d 100644
--- a/tests/hermes_cli/test_kanban_admission_contention.py
+++ b/tests/hermes_cli/test_kanban_admission_contention.py
@@ -1,5 +1,6 @@
 """Real SQLite/flock contention at the Kanban publication boundary."""
 import contextlib
+import logging
 import sqlite3
 import threading
 from concurrent.futures import ThreadPoolExecutor
@@ -154,3 +155,35 @@ def test_body_error_rolls_back_before_unlock(board):
     assert kb.get_task(conn, task).status == "ready"
     with af.admission_lock(home, timeout=0):
         pass
+
+
+@pytest.mark.parametrize("review", [False, True])
+def test_busy_admission_lock_defers_quietly(board, caplog, review):
+    """Designed contention (another claimer holds admission.lock for its commit) is a normal defer:
+    INFO, no traceback. A WARNING with exc_info here filed false self-heal defects."""
+    conn, home = board
+    task = _task(conn, review)
+    claim = kb.claim_review_task if review else kb.claim_task
+    caplog.set_level(logging.DEBUG, logger="hermes_cli.kanban_admission")
+    with af.admission_lock(home, timeout=1):  # held from another fd
+        assert claim(conn, task) is None
+    assert kb.get_task(conn, task).status == ("review" if review else "ready")
+    records = [r for r in caplog.records if r.name == "hermes_cli.kanban_admission"]
+    assert not [r for r in records if r.levelno >= logging.WARNING]
+    assert not [r for r in records if r.exc_info]
+    assert any(r.levelno == logging.INFO and "lock busy" in r.getMessage() for r in records)
+
+
+def test_real_admission_failure_stays_loud(board, caplog, monkeypatch):
+    conn, _home = board
+    task = _task(conn, False)
+
+    def broken_lock(root, *, timeout=10):
+        raise PermissionError("admission.lock: permission denied")
+
+    monkeypatch.setattr(af, "admission_lock", broken_lock)
+    caplog.set_level(logging.DEBUG, logger="hermes_cli.kanban_admission")
+    assert kb.claim_task(conn, task) is None
+    assert kb.get_task(conn, task).status == "ready"
+    warns = [r for r in caplog.records if r.name == "hermes_cli.kanban_admission" and r.levelno >= logging.WARNING]
+    assert warns and warns[0].exc_info and isinstance(warns[0].exc_info[1], PermissionError)
