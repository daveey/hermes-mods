From 07f5ca1154373f43372e842a3cbbaa26d702ee0d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 22 Oct 2026 21:29:23 -0700
Subject: [PATCH 213/248] fix(desktop): open Kanban worker sessions read-only
 and quietly (no 'Resume failed' toast on gateway 4132)

---
diff --git a/apps/desktop/src/app/session/hooks/use-session-actions/owner-follow.kanban-refusal.test.ts b/apps/desktop/src/app/session/hooks/use-session-actions/owner-follow.kanban-refusal.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d87e46bc91a59f403026ac3319ca99e0d7c2f548
--- /dev/null
+++ b/apps/desktop/src/app/session/hooks/use-session-actions/owner-follow.kanban-refusal.test.ts
@@ -0,0 +1,12 @@
+import { describe, expect, it } from 'vitest'
+
+import { isKanbanWorkerResumeRefusal } from './owner-follow'
+
+describe('isKanbanWorkerResumeRefusal', () => {
+  it('matches the gateway 4132 refusal only', () => {
+    expect(isKanbanWorkerResumeRefusal(Object.assign(new Error('worker'), { code: 4132 }))).toBe(true)
+    expect(isKanbanWorkerResumeRefusal(Object.assign(new Error('nf'), { code: 4007 }))).toBe(false)
+    expect(isKanbanWorkerResumeRefusal(new Error('x'))).toBe(false)
+    expect(isKanbanWorkerResumeRefusal(null)).toBe(false)
+  })
+})
diff --git a/apps/desktop/src/app/session/hooks/use-session-actions/owner-follow.ts b/apps/desktop/src/app/session/hooks/use-session-actions/owner-follow.ts
index 06347b4389bd97c90bf3287ce09900c63315c4a1..25af98d7437815ce1a1864cd9c9f1e424ab7157b 100644
--- a/apps/desktop/src/app/session/hooks/use-session-actions/owner-follow.ts
+++ b/apps/desktop/src/app/session/hooks/use-session-actions/owner-follow.ts
@@ -39,6 +39,20 @@ export const SESSION_NOT_FOUND_CODE = 4007
 /** JSON-RPC 4001 — the gateway holds no live runtime by that id ("not in memory"). */
 export const SESSION_NOT_IN_MEMORY_CODE = 4001
 
+/** JSON-RPC 4132 — the gateway refuses to resume a Kanban worker transcript
+ *  (tui_gateway _resume_guard): a resumed chat would be a second, unsupervised
+ *  writer next to the dispatcher-owned run. The stored transcript is still
+ *  readable over REST, so Desktop opens it read-only instead of erroring. */
+export const KANBAN_WORKER_RESUME_REFUSED_CODE = 4132
+
+export function isKanbanWorkerResumeRefusal(error: unknown): boolean {
+  return (
+    Boolean(error) &&
+    typeof error === 'object' &&
+    (error as Partial<JsonRpcGatewayError>).code === KANBAN_WORKER_RESUME_REFUSED_CODE
+  )
+}
+
 /** True for a gateway's "no such stored session" answer to `session.resume`.
  *  A bare 4001 (live runtime reaped) is a different signal and does not
  *  qualify: the stored session exists there, only its runtime is gone. */
-- 
