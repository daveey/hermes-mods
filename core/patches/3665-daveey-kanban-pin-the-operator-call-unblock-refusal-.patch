From db8b5f8c576e4eb7f365761e6ced8ebbd9eff212 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 16:30:51 +0000
Subject: [PATCH] [daveey] kanban: pin the operator-call unblock refusal text
 for a terminal-held stale copy

Post-merge check t_01a1d5aa79f50690 of #2271 found that the operator-call
unblock path (`kanban_operator_call._apply`, action `unblock`) had no test
driving a refused unblock of a card held done by its `completed` event: the
mutant `unblock_refusal(conn, target)` -> `None` survived (31 passed in
test_kanban_stale_wake_terminal.py), so a regression back to
"cannot unblock <id> (state changed)" would ship silently. The CLI and
dashboard paths were already pinned.

New test (tests only), next to the other operator-call unblock tests: a hub
card whose row still reads blocked by its own agent run, with a `completed`
event appended after it. A worker's operator-call unblock round is refused at
the home with text naming `its completed event holds it done` and
`hermes kanban reopen <id> --reason`, and the card stays blocked.

The seed is a blocked row, not the scheduled row of
`_stale_scheduled_copy_of_a_done_card`: `_agent_block` refuses any non-blocked
target first ("is scheduled, not blocked"), so a scheduled copy never reaches
the `unblock_refusal` line.

RED/GREEN (tests/hermes_cli/test_kanban_operator_call.py, skipped=0):
- main + test: 32 passed, 0 failed
- mutant (`unblock_refusal(conn, target)` -> `None`): 31 passed, 1 failed
  (AssertionError: cannot unblock t_... (state changed))
---
 tests/hermes_cli/test_kanban_operator_call.py | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_operator_call.py b/tests/hermes_cli/test_kanban_operator_call.py
index 2ce22f36fb..ec9bee484a 100644
--- a/tests/hermes_cli/test_kanban_operator_call.py
+++ b/tests/hermes_cli/test_kanban_operator_call.py
@@ -313,6 +313,27 @@ def test_unblock_refuses_human_gate_and_hand_hold(fleet):
     assert ksr.get_request(f.w, out["request_id"])["status"] == "done"
 
 
+def test_unblock_of_a_terminal_held_stale_copy_names_the_completion_and_reopen(fleet):
+    """#2271: the home's row still reads blocked (its own agent's block) but the card's ``completed`` event reached
+    the file after it, so ``unblock_task`` refuses (an unblock is a reopen). The refusal must say why and how to
+    revive it, not the bare "(state changed)" fallback."""
+    f = fleet
+    stale = f.card(f.h, "completed elsewhere, stale blocked copy here")
+    kb.block_task(f.h, stale, reason="waiting on CI", actor=f"agent (task {stale})", kind="transient")
+    with kb.write_txn(f.h):  # the completion's event reached the hub's file, the row did not
+        kb._append_event(f.h, stale, "completed", {"result_len": 12})
+    assert kb.get_task(f.h, stale).status == "blocked"
+    f.board()
+    _submit(f, {"op": "operator", "action": "unblock", "task_id": stale, "reason": "CI is green"})
+    _round(f)
+    assert kb.get_task(f.h, stale).status == "blocked"
+    row = next(r for r in _log(f.h, "execute") if r["target_task_id"] == stale)
+    assert row["outcome"] == "refused", row
+    assert "its completed event holds it done" in row["detail"], row["detail"]
+    assert f"hermes kanban reopen {stale} --reason" in row["detail"], row["detail"]
+    assert "state changed" not in row["detail"]
+
+
 def test_running_target_is_not_moved(fleet):
     f = fleet
     kb.claim_task(f.h, f.target)
