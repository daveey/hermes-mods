From e9752b369a0e128f5028bd6dc324996e7fa99b34 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 04:42:50 +0000
Subject: [PATCH] fix(kanban): retain WAL guard after refused reader close
 [daveey]

The real thread-checking close can raise before SQLite closes. Guard rearm
then attempted SQL on the same foreign thread, failed the same thread check
and left a live tracked reader without its OFD protection. Snapshot held
custody before release and rearm from its verified WAL path without SQL.
Preserve ProgrammingError and existing close/registry/lifecycle ordering.

Independent Opus bounded design review approved this correction before
production edits (close-review.md). The strengthened real WAL reader test
fails on the prior source at is_guarded after three rejected closes; the
fixed version retains tracking and balanced handle counts. Also migrate
reader-isolation cleanup assertions to the new tracked cache lifetime.
Linux-specific fd proof tests are marked explicitly; no fake platforms.
Correctness only: G26 remains STOP; no performance acceptance.
---
 hermes_cli/kanban_lockguard.py                | 34 ++++++++++++-------
 .../test_cached_ro_restore_safety.py          |  2 ++
 .../test_kanban_observer_tracking.py          | 19 ++++++++---
 .../test_kanban_open_session_isolation.py     |  4 +++
 .../test_kanban_reader_close_isolation.py     | 11 ++++--
 5 files changed, 50 insertions(+), 20 deletions(-)

diff --git a/hermes_cli/kanban_lockguard.py b/hermes_cli/kanban_lockguard.py
index ce1e155825..b75d1c2a1c 100644
--- a/hermes_cli/kanban_lockguard.py
+++ b/hermes_cli/kanban_lockguard.py
@@ -96,6 +96,7 @@ class _GuardMixin:
 
     def close(self) -> None:  # type: ignore[misc]
         held = getattr(self, "_hermes_lockguard", None)
+        was_guarded = bool(held)
         _release(self)
         try:
             super().close()  # type: ignore[misc]
@@ -103,8 +104,13 @@ class _GuardMixin:
             forget(self)
         except sqlite3.ProgrammingError:
             # Cross-thread close refused: the connection stays open, so put the guard back.
-            if held is not None:
-                _apply(self, held_path=getattr(self, "_hermes_lockguard_path", None))
+            if was_guarded:
+                try:
+                    # SQL cannot run on this foreign thread either. The held WAL
+                    # guard already proved the mode before release emptied it.
+                    _apply(self, held_path=self._hermes_lockguard_path, wal_verified=True)
+                except Exception:
+                    logger.debug("kanban guard rearm after refused close failed", exc_info=True)
             raise
 
 
@@ -141,19 +147,23 @@ def unguard(conn: sqlite3.Connection) -> None:
         conn._hermes_lockguard = None
 
 
-def _apply(conn: Any, held_path: Optional[str] = None, *, strict=False) -> bool:
+def _apply(conn: Any, held_path: Optional[str] = None, *, strict=False, wal_verified=False) -> bool:
+    # Refused-close rearming may not execute SQL on the foreign thread.
+    if wal_verified and not held_path:
+        return False
     path = held_path or _db_file(conn)
     if not path:
         return False
-    try:
-        # Also the first read: it opens -wal/-shm, so hold() can lock SQLite's own -shm descriptor.
-        mode = conn.execute("PRAGMA journal_mode").fetchone()[0]
-    except sqlite3.Error:
-        if strict:
-            raise
-        return False
-    if str(mode).lower() != "wal":
-        return False
+    if not wal_verified:
+        try:
+            # First read attaches -wal/-shm so hold() can use SQLite's own fds.
+            mode = conn.execute("PRAGMA journal_mode").fetchone()[0]
+        except sqlite3.Error:
+            if strict:
+                raise
+            return False
+        if str(mode).lower() != "wal":
+            return False
     held = getattr(conn, "_hermes_lockguard", None)
     if held is None or getattr(conn, "_hermes_lockguard_finalizer", None) is None:
         held = {}
