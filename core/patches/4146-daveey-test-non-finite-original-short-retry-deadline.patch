From 66e91715a513c2eaa52809600a939a6af7eafbf8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 05:19:46 +0000
Subject: [PATCH] [daveey] test non-finite original/short retry deadlines on
 different code

Post-merge mutation audit (t_01a1d839f0aa6622) of PR #2766 found that
dropping `math.isfinite` from notice_retry.effective_due survived: no test
had a known-different code sha with a non-finite deadline, where min()
would otherwise let +inf original lose to a finite short, or a -inf short
win over a finite original.

Adds test_different_code_nonfinite_deadline_keeps_original with both cases.
Test-only; no production change. Same/unknown-code controls unchanged.

Proof (canonical scripts/run_tests.sh via sdlc-review mutants.py, scratch HOME):
- GREEN baseline: test_notice_retry_successor.py 22 passed, 0 failed, 0 skipped
- RED mutant "drop math.isfinite guard": killed, exactly the 2 new cases fail
  ([inf-100.0] and [200.0--inf]); all restored
- Broader importers of notice_retry/notice_guarantee: 10 files, 228 passed, 0 skipped
---
 tests/tui_gateway/test_notice_retry_successor.py | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/tests/tui_gateway/test_notice_retry_successor.py b/tests/tui_gateway/test_notice_retry_successor.py
index 5a678b2a7f..ac610fa608 100644
--- a/tests/tui_gateway/test_notice_retry_successor.py
+++ b/tests/tui_gateway/test_notice_retry_successor.py
@@ -86,6 +86,14 @@ def test_malformed_provenance_keeps_original(field, value, monkeypatch):
     assert nr.effective_due(closeout) == closeout["retry_at"]
 
 
+@pytest.mark.parametrize("due,short", [(float("inf"), 100.0), (200.0, -float("inf"))])
+def test_different_code_nonfinite_deadline_keeps_original(due, short, monkeypatch):
+    # Known different code would take min(); a non-finite deadline must not win it.
+    monkeypatch.setattr(host_loop_lease, "_core_sha", lambda: "b" * 40)
+    closeout = {"retry_code_sha": "a" * 40, "retry_at": due, "retry_short_at": short}
+    assert nr.effective_due(closeout) == due
+
+
 def test_booking_only_marks_extended_delays_and_never_extends_due(monkeypatch):
     monkeypatch.setattr(host_loop_lease, "_core_sha", lambda: "a" * 40)
     assert nr.booking(100, 100) == {}
