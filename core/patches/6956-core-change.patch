     with _db_scope(db) as handle:  # [daveey] also reduces and fence-publishes the canonical ``status`` envelope
-        return refresh(handle, sid, trigger, frozenset(concluding_turn or ()))
+        if _agreement_blocking.get():
+            return refresh(handle, sid, trigger, frozenset(concluding_turn or ()))
