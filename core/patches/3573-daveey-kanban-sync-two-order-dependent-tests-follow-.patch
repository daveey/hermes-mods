From 699395948a94aa93a894701b45fde816ad592546 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 07:57:36 +0000
Subject: [PATCH] [daveey] kanban sync: two order-dependent tests follow
 push-before-pull; outbox-age cites the missing loop alarm

- test_kanban_sync_own_writes: race on the round's second send (the first goes before the pulls); it keyed on the
  before_pull kwarg the rework renamed to hold_runs, so it raced on the pre-pull send.
- test_kanban_sync_rejections: compare the audit row without its local-only origin_gateway, which the same
  round's pull now stamps from the Board's echo.
- kanban_sync_outbox_age.check: a failing loop is not covered by another alarm; cite follow-up t_01a1d3df5e5d0757.
---
 hermes_cli/kanban_sync_outbox_age.py            | 4 +++-
 tests/hermes_cli/test_kanban_sync_own_writes.py | 8 ++++----
 tests/hermes_cli/test_kanban_sync_rejections.py | 8 ++++++--
 3 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban_sync_outbox_age.py b/hermes_cli/kanban_sync_outbox_age.py
index 56a4093b4f..b52efa8254 100644
--- a/hermes_cli/kanban_sync_outbox_age.py
+++ b/hermes_cli/kanban_sync_outbox_age.py
@@ -131,7 +131,9 @@ def check(*, mono: Callable[[], float] = time.monotonic, file_fn: Optional[Calla
         for slug, path in boards:
             seconds = age(path) if _loop_healthy(slug, now) else None
             if seconds is None or seconds < STALE_S:
-                _FILED.discard(slug)  # answered (or the loop is failing, which other alarms cover): incident over
+                # Answered, or the loop is failing: incident over. No alarm covers a failing loop yet;
+                # t_01a1d3df5e5d0757 adds a replica-freshness check here.
+                _FILED.discard(slug)
                 continue
             if slug in _FILED:
                 continue
diff --git a/tests/hermes_cli/test_kanban_sync_own_writes.py b/tests/hermes_cli/test_kanban_sync_own_writes.py
index f9ef46f280..b0cdd48c56 100644
--- a/tests/hermes_cli/test_kanban_sync_own_writes.py
+++ b/tests/hermes_cli/test_kanban_sync_own_writes.py
@@ -114,12 +114,12 @@ def test_another_connections_write_during_the_round_still_repairs(live, svc, kan
     parent, child = credit._settle(live, svc, kanban_home)
     calls = credit._spy(monkeypatch)
     real_push = ksc.push
-    done = []
+    sends = []
 
     def push_and_race(conn, *a, **k):
-        # On the round's send after its inputs read (it also sends before its pulls, t_01a1d36ddcea59fe).
-        if not done and not k.get("before_pull"):
-            done.append(1)
+        # On the round's second send, after its inputs read (the first goes before its pulls, t_01a1d36ddcea59fe).
+        sends.append(1)
+        if len(sends) == 2:
             credit._uncaptured_edit(live, child, "raced")
         return real_push(conn, *a, **k)
     monkeypatch.setattr(ksc, "push", push_and_race)
diff --git a/tests/hermes_cli/test_kanban_sync_rejections.py b/tests/hermes_cli/test_kanban_sync_rejections.py
index 30a1b42540..c671573d80 100644
--- a/tests/hermes_cli/test_kanban_sync_rejections.py
+++ b/tests/hermes_cli/test_kanban_sync_rejections.py
@@ -49,13 +49,17 @@ def reject_status(live, svc):
 
 def test_normal_sync_retires_superseded_keeps_audit_and_is_idempotent(live, svc, kanban_home):
     reject_status(live, svc)
-    audits = [tuple(r) for r in live.execute("SELECT * FROM task_events WHERE kind='sync_rejected'")]
+    # Every column but the local-only origin_gateway: the round pushes before it pulls (t_01a1d36ddcea59fe), so
+    # the same round's pull lands the Board's echo of this audit row, which stamps that column.
+    cols = [c for c in sync.table_columns(live, "task_events") if c != "origin_gateway"]
+    audit_sql = f"SELECT {', '.join(cols)} FROM task_events WHERE kind='sync_rejected'"
+    audits = [tuple(r) for r in live.execute(audit_sql)]
     assert audits
     result = client.sync_board(BOARD, kanban_home / "kanban.db", svc.hub(ME), ME)
     assert result.rejection_resolutions[0]["classification"] == "superseded"
     assert result.rejection_resolutions[0]["action"] == "retired"
     assert client.status(live)["rejected"] == 0
-    assert [tuple(r) for r in live.execute("SELECT * FROM task_events WHERE kind='sync_rejected'")] == audits
+    assert [tuple(r) for r in live.execute(audit_sql)] == audits
     client.sync_board(BOARD, kanban_home / "kanban.db", svc.hub(ME), ME)
     shadow = client.open_shadow(BOARD, ME)
     try:
-- 
