+def store_new_receipt(conn, session_id, receipt):
+    """Creation opt-in from the trusted frozen config; never reload config under the write lock.
+
+    Enabling requires an operator to verify every policy reader's compatibility.
+    Absence, malformed sections and non-boolean values preserve legacy inline writes.
+    Existing owners keep their representation through replace_receipt, not this helper.
+    """
+    try:
+        config = json.loads(receipt['policy']['config_json'])
+        sessions = config.get('sessions') if isinstance(config, dict) else None
+        intern = isinstance(sessions, dict) and sessions.get('intern_policy_configs') is True
+    except (KeyError, TypeError, ValueError, RecursionError):
+        intern = False
+    store_receipt(conn, session_id, receipt, intern=intern)
+
+
 def replace_receipt(conn, session_id, receipt):
     """Replace hydrated values while retaining this owner's storage format."""
     store_receipt(conn, session_id, receipt, intern=_stored_reference(conn, session_id) is not None)
diff --git a/hermes_state_policy_rollout.py b/hermes_state_policy_rollout.py
new file mode 100644
index 0000000000000000000000000000000000000000..dd05fb6685a40c3df9aff8d143a7e25dc0671799
--- /dev/null
+++ b/hermes_state_policy_rollout.py
@@ -0,0 +1,142 @@
+"""Opt-in, bounded policy representation conversion, never startup maintenance.
+
+Call on the existing SessionDB transaction owner. This is not reader discovery:
+readers_compatible acknowledges independently established rollout custody. A batch
+cursor is a scan position, NOT a downgrade-readiness receipt. Busy/oversize owners
+must be revisited; disable new interned writes before a rollback scan.
+"""
+from typing import Any
+
+from hermes_state_local import POLICY_PREFIX
+from hermes_state_local_lineage import validate_local_lineage
+from hermes_state_mutation_guards import MUTATION_GUARD_REFUSALS, require_idle
+from hermes_state_policy_config import BLOB_PREFIX, _stored_reference, decode_receipt, store_receipt
+from hermes_state_runtime import RuntimeStoreError
+
+
+def convert_policy_config_batch(db, *, intern, apply=False, readers_compatible=False,
+                                after='', limit=8, max_bytes=1024 * 1024):
+    """Inspect at most limit keys and rewrite at most max_bytes of stored receipts.
+
+    Dry-run uses the read path and performs no DML. Apply uses one existing owner
+    transaction; an unreadable receipt rolls back the ENTIRE batch. No additional
+    transaction control, checkpoints, VACUUM, config writes, runtime-epoch changes
+    or background loop; ordinary owner commit/maintenance behavior is unchanged.
+    Neither `more=False` nor `converted=0` proves all refs are gone: skipped rows
+    and concurrent creates require a fresh pass after producer disable/quiescence.
+    """
+    if (type(intern) is not bool or type(apply) is not bool or
+            type(limit) is not int or not 1 <= limit <= 32 or
+            type(max_bytes) is not int or not 1 <= max_bytes <= 4 * 1024 * 1024 or
+            not isinstance(after, str)):
+        raise RuntimeStoreError('invalid_params')
+    if apply and intern and readers_compatible is not True:
+        raise RuntimeStoreError('runtime_coordination_required')
+
+    def batch(conn):
+        rows = conn.execute('SELECT key,length(CAST(value AS BLOB)) FROM state_meta '
+                            'WHERE key GLOB ? AND key>? ORDER BY key LIMIT ?',
+                            (POLICY_PREFIX + '*', POLICY_PREFIX + after, limit + 1)).fetchall()
+        result: dict[str, Any] = dict(scanned=0, converted=0, bytes=0, skipped={}, after=after,
+                                      more=len(rows) > limit, applied=apply)
+        for key, size in rows[:limit]:
+            sid = key[len(POLICY_PREFIX):]
+            digest = None
+            if size is None or size > max_bytes:
+                result['scanned'] += 1
+                result['after'] = sid
+                result['skipped'][sid] = 'oversize'
+                continue
+            if result['bytes'] + size > max_bytes:
+                result['more'] = True
+                break
+            raw_size = size
+            if apply:
+                digest = _stored_reference(conn, sid)
+                if digest is not None:
+                    blob = conn.execute('SELECT length(CAST(value AS BLOB)) FROM state_meta WHERE key=?',
+                                        (BLOB_PREFIX + digest,)).fetchone()
+                    if blob is None or not isinstance(blob[0], int):
+                        raise RuntimeStoreError('storage_unavailable')
+                    # Worst-case JSON escaping is six bytes per payload byte. Bound
+                    # hydrated output BEFORE loading a potentially huge shared blob.
+                    size += 6 * blob[0]
+            if size > max_bytes:
+                result['scanned'] += 1
+                result['after'] = sid
+                result['bytes'] += raw_size  # inspected raw bytes still spend the batch budget
+                result['skipped'][sid] = 'oversize'
+                continue
+            if result['bytes'] + size > max_bytes:
+                result['bytes'] += raw_size
+                result['more'] = True
+                break
+            result['scanned'] += 1
+            result['after'] = sid
+            result['bytes'] += size
+            if not apply:
+                continue
+            raw = conn.execute('SELECT value FROM state_meta WHERE key=?', (key,)).fetchone()[0]
+            saved = decode_receipt(conn, raw)
+            target = validate_local_lineage(conn, saved)
+            try:
+                require_idle(db, conn, list({sid, target}))
+            except RuntimeStoreError as exc:
+                if exc.reason not in ('session_busy', 'unknown_execution'):
+                    raise
+                result['skipped'][sid] = exc.reason
+                continue
+            except MUTATION_GUARD_REFUSALS:
+                result['skipped'][sid] = 'session_busy'
+                continue
+            # Already in the requested representation: do not rewrite unchanged pages.
+            if (digest is not None) == intern:
+                continue
+            store_receipt(conn, sid, saved, intern=intern)
+            result['converted'] += 1
+        return result
+
+    if apply:
+        return db._execute_write(batch)
+    with db._read_ctx() as conn:
+        return batch(conn)
+
+
+def main(argv=None):
+    """One finite maintenance batch; dry-run by default. No implicit activation."""
+    import argparse
+    from contextlib import closing
+    import json
+    from pathlib import Path
+    import sqlite3
+
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--db', required=True, type=Path)
+    parser.add_argument('--direction', required=True, choices=('intern', 'inline'))
+    parser.add_argument('--apply', action='store_true')
+    parser.add_argument('--readers-compatible', action='store_true')
+    parser.add_argument('--after', default='')
+    parser.add_argument('--limit', type=int, default=8)
+    parser.add_argument('--max-bytes', type=int, default=1024 * 1024)
+    args = parser.parse_args(argv)
+    if not args.db.is_file():
+        parser.error('--db must name an existing state database')
+    if args.apply and args.direction == 'intern' and not args.readers_compatible:
+        print(json.dumps({'error': 'runtime_coordination_required'}))
+        return 2
+    from hermes_state import SessionDB
+    try:
+        with closing(SessionDB(args.db, read_only=not args.apply)) as db:
+            result = convert_policy_config_batch(db, intern=args.direction == 'intern', apply=args.apply,
+                readers_compatible=args.readers_compatible, after=args.after,
+                limit=args.limit, max_bytes=args.max_bytes)
+    except (RuntimeStoreError, sqlite3.Error):
+        # Never echo frozen config, request data or SQLite exception payloads.
+        print(json.dumps({'error': 'storage_unavailable'}))
+        return 2
+    print(json.dumps(result, sort_keys=True))
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/tests/hermes_state/test_policy_config_rollout.py b/tests/hermes_state/test_policy_config_rollout.py
new file mode 100644
index 0000000000000000000000000000000000000000..54e607c40a2d5fdb3629201d790ea0c51094f1e5
--- /dev/null
+++ b/tests/hermes_state/test_policy_config_rollout.py
@@ -0,0 +1,69 @@
+"""Disabled-by-default producer switch and transaction-owned representation rollout."""
+from contextlib import closing
+from dataclasses import asdict
+import json
+
+import pytest
+
+from hermes_state import SessionDB
+from hermes_state_local import POLICY_PREFIX, commit_local_session, local_receipt
+from hermes_state_policy_config import BLOB_PREFIX, REF_PREFIX
+import hermes_state_runtime as rt
+
+
+def create(db, epoch, cwd, flag, request_id='first'):
+    from gateway.config import Platform
+    from gateway.session import SessionEntry, SessionSource
+    from gateway.session_lifecycle import _now
+    from gateway.session_local_recovery import local_identity
+    from gateway.session_policy import build_policy
+    sid = local_identity('profile', 'human', request_id)
+    source = SessionSource(platform=Platform.LOCAL, chat_id=sid, user_id='human', chat_type='dm')
+    now = _now()
+    entry = SessionEntry('local:' + sid, sid, now, now, origin=source, platform=Platform.LOCAL)
+    config = {'platform_toolsets': {'cli': []}, 'sessions': {'intern_policy_configs': flag}}
+    policy = build_policy({'source': 'cli', 'cwd': str(cwd), 'model': 'm', 'toolsets': []},
+                          config, private_secrets={})
+    expected = dict(profile_id='profile', principal_id='human', request_id=request_id, session_id=sid,
+                    route=entry.session_key, entry=entry.to_dict(), policy=asdict(policy))
+    expected = json.loads(json.dumps(expected))  # persisted JSON normalizes policy tuples
+    assert commit_local_session(db, epoch=epoch, receipt=expected) == expected
+    return sid, expected
+
+
+@pytest.mark.parametrize('flag,interned', [(True, True), (False, False), ('true', False), (1, False), (None, False)])
+def test_creation_switch_is_exact_opt_in_and_retry_preserves_values(tmp_path, flag, interned):
+    with closing(SessionDB(tmp_path / 'state.db')) as db:
+        epoch = rt.begin_runtime_epoch(db, instance_id='owner')
+        sid, expected = create(db, epoch, tmp_path, flag)
+        with db._read_ctx() as conn:
+            raw = json.loads(conn.execute('SELECT value FROM state_meta WHERE key=?', (POLICY_PREFIX + sid,)).fetchone()[0])
+            assert ('config_ref_v1' in raw['policy']) is interned
+            assert ('config_json' in raw['policy']) is not interned
+            blobs = conn.execute('SELECT count(*) FROM state_meta WHERE key GLOB ?', (BLOB_PREFIX + '*',)).fetchone()[0]
+            assert blobs == int(interned)
+        assert local_receipt(db, sid) == expected
+        assert commit_local_session(db, epoch=epoch, receipt=expected) == expected
+
+
+def test_bounded_conversion_resumes_and_rolls_back_exact_values(tmp_path):
+    from hermes_state_policy_rollout import convert_policy_config_batch
+    with closing(SessionDB(tmp_path / 'state.db')) as db:
+        epoch = rt.begin_runtime_epoch(db, instance_id='owner')
+        expected = dict(create(db, epoch, tmp_path, False, str(i)) for i in range(3))
+        first = convert_policy_config_batch(db, intern=True, apply=True, readers_compatible=True, limit=1)
+        assert first['converted'] == 1 and first['scanned'] == 1 and first['more']
+        second = convert_policy_config_batch(db, intern=True, apply=True, readers_compatible=True,
+                                             after=first['after'], limit=2)
+        assert second['converted'] == 2 and not second['more']
+        for sid, receipt in expected.items():
+            assert local_receipt(db, sid) == receipt
+        with db._read_ctx() as conn:
+            assert conn.execute('SELECT count(*) FROM state_meta WHERE key GLOB ?', (BLOB_PREFIX + '*',)).fetchone()[0] == 1
+        back = convert_policy_config_batch(db, intern=False, apply=True)
+        assert back['converted'] == 3
+        with db._read_ctx() as conn:
+            assert conn.execute('SELECT key FROM state_meta WHERE key GLOB ? OR key GLOB ?',
+                                (BLOB_PREFIX + '*', REF_PREFIX + '*')).fetchall() == []
+        for sid, receipt in expected.items():
+            assert local_receipt(db, sid) == receipt
diff --git a/tests/hermes_state/test_policy_config_rollout_boundaries.py b/tests/hermes_state/test_policy_config_rollout_boundaries.py
new file mode 100644
index 0000000000000000000000000000000000000000..64c8feebbcf82962a011f9c6f6ead7ea3ffa3129
--- /dev/null
+++ b/tests/hermes_state/test_policy_config_rollout_boundaries.py
@@ -0,0 +1,95 @@
+"""Real owner admission and failure boundaries for policy conversion."""
+from contextlib import closing
+import json
+
+import pytest
+
+from hermes_state import SessionDB
+from hermes_state_local import POLICY_PREFIX, local_receipt
+from hermes_state_policy_config import store_receipt
+import hermes_state_runtime as rt
+from tests.hermes_state.test_policy_config_rollout import create
+
+
+@pytest.mark.parametrize('status', ['queued', 'started', 'unknown'])
+def test_conversion_skips_live_or_unknown_and_preserves_runtime_revision(tmp_path, status):
+    from hermes_state_policy_rollout import convert_policy_config_batch
+    with closing(SessionDB(tmp_path / 'state.db')) as db:
+        epoch = rt.begin_runtime_epoch(db, instance_id='owner')
+        sid, expected = create(db, epoch, tmp_path, False)
+        rt.admit_session_input(db, epoch=epoch, principal_id='human', session_id=sid,
+                               request_id='turn', payload={'text': 'keep'})
+        if status != 'queued':
+            rt.claim_session_input(db, epoch=epoch, session_id=sid)
+            if status == 'unknown':
+                db._execute_write(lambda conn: conn.execute('UPDATE session_admissions SET status=? WHERE target_session_id=?', (status, sid)))
+        before = db.get_session(sid)
+        result = convert_policy_config_batch(db, intern=True, apply=True, readers_compatible=True)
+        assert result['converted'] == 0
+        assert result['skipped'] == {sid: 'unknown_execution' if status == 'unknown' else 'session_busy'}
+        assert db.get_session(sid) == before
+        assert local_receipt(db, sid) == expected
+
+
+def test_dry_run_and_unacknowledged_conversion_never_write(tmp_path):
+    from hermes_state_policy_rollout import convert_policy_config_batch
+    with closing(SessionDB(tmp_path / 'state.db')) as db:
+        epoch = rt.begin_runtime_epoch(db, instance_id='owner')
+        sid, expected = create(db, epoch, tmp_path, False)
+        with db._read_ctx() as conn:
+            before = conn.execute('SELECT key,value FROM state_meta ORDER BY key').fetchall()
+        assert convert_policy_config_batch(db, intern=True)['applied'] is False
+        with pytest.raises(rt.RuntimeStoreError, match='runtime_coordination_required'):
+            convert_policy_config_batch(db, intern=True, apply=True)
+        with db._read_ctx() as conn:
+            assert conn.execute('SELECT key,value FROM state_meta ORDER BY key').fetchall() == before
+        assert local_receipt(db, sid) == expected
+
+
+def test_converter_rolls_back_earlier_owner_on_later_bad_receipt(tmp_path):
+    from hermes_state_policy_rollout import convert_policy_config_batch
+    with closing(SessionDB(tmp_path / 'state.db')) as db:
+        epoch = rt.begin_runtime_epoch(db, instance_id='owner')
+        for i in range(2):
+            create(db, epoch, tmp_path, False, str(i))
+        def corrupt(conn):
+            keys = conn.execute('SELECT key FROM state_meta WHERE key GLOB ? ORDER BY key', (POLICY_PREFIX + '*',)).fetchall()
+            conn.execute('UPDATE state_meta SET value=? WHERE key=?', ('bad JSON', keys[-1][0]))
+            return conn.execute('SELECT key,value FROM state_meta ORDER BY key').fetchall()
+        before = db._execute_write(corrupt)
+        with pytest.raises(rt.RuntimeStoreError, match='storage_unavailable'):
+            convert_policy_config_batch(db, intern=True, apply=True, readers_compatible=True)
+        with db._read_ctx() as conn:
+            assert conn.execute('SELECT key,value FROM state_meta ORDER BY key').fetchall() == before
+
+
+def test_rollback_accounts_for_hydrated_output_byte_bound(tmp_path):
+    from hermes_state_policy_rollout import convert_policy_config_batch
+    with closing(SessionDB(tmp_path / 'state.db')) as db:
+        epoch = rt.begin_runtime_epoch(db, instance_id='owner')
+        sid, expected = create(db, epoch, tmp_path, False)
+        expected['policy']['config_json'] = 'x' * 65536
+        db._execute_write(lambda conn: store_receipt(conn, sid, expected, intern=True))
+        result = convert_policy_config_batch(db, intern=False, apply=True, max_bytes=16384)
+        assert result['converted'] == 0 and result['skipped'] == {sid: 'oversize'}
+        with db._read_ctx() as conn:
+            raw = conn.execute('SELECT value FROM state_meta WHERE key=?', (POLICY_PREFIX + sid,)).fetchone()[0]
+            assert 'config_ref_v1' in json.loads(raw)['policy']
+        assert local_receipt(db, sid) == expected
+
+
+def test_aggregate_byte_fence_does_not_parse_next_unadmitted_receipt(tmp_path):
+    from hermes_state_policy_rollout import convert_policy_config_batch
+    with closing(SessionDB(tmp_path / 'state.db')) as db:
+        epoch = rt.begin_runtime_epoch(db, instance_id='owner')
+        for i in range(2):
+            create(db, epoch, tmp_path, False, str(i))
+        def prepare(conn):
+            rows = conn.execute('SELECT key,length(CAST(value AS BLOB)) FROM state_meta WHERE key GLOB ? ORDER BY key',
+                                (POLICY_PREFIX + '*',)).fetchall()
+            conn.execute('UPDATE state_meta SET value=? WHERE key=?', ('bad JSON', rows[1][0]))
+            return rows[0][0][len(POLICY_PREFIX):], rows[0][1]
+        sid, size = db._execute_write(prepare)
+        result = convert_policy_config_batch(db, intern=True, apply=True, readers_compatible=True, max_bytes=size)
+        assert result['converted'] == 1 and result['more'] and result['after'] == sid
+        assert result['bytes'] == size
