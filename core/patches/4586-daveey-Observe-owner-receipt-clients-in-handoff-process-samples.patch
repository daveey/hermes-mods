         for tid, procs in by_card.items():
             pids = {p["pid"] for p in procs}
             roots = sorted(p["pid"] for p in procs if p["ppid"] not in pids)
diff --git a/tests/e2e/core/upgrade/handoff/test_worker_sampler.py b/tests/e2e/core/upgrade/handoff/test_worker_sampler.py
