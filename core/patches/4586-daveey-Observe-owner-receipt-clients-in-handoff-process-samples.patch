 .../upgrade/handoff/test_worker_sampler.py    | 41 +++++++++++++++++++
 3 files changed, 52 insertions(+), 6 deletions(-)
 create mode 100644 tests/e2e/core/upgrade/handoff/test_worker_sampler.py

