From 4240111507868a74c6d76c19896e77d10f07ec64 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:20:21 +0000
Subject: [PATCH] [daveey] Prove absent gateway identity cannot establish probe
 custody

Proof: removal of the own-gateway truthiness guard fails both None and empty-string cases; restored suite passes all 10 tests.
---
 tests/hermes_cli/test_kanban_hub_probe_custody.py | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_hub_probe_custody.py b/tests/hermes_cli/test_kanban_hub_probe_custody.py
index c1af28f459..45ae095a25 100644
--- a/tests/hermes_cli/test_kanban_hub_probe_custody.py
+++ b/tests/hermes_cli/test_kanban_hub_probe_custody.py
@@ -46,6 +46,19 @@ def test_unknown_or_different_probe_custody_keeps_the_local_guard(gws, payload):
     assert not registered_here(hub.conn, tid, probe)
 
 
+@pytest.mark.parametrize("own", [None, ""])
+def test_missing_local_identity_cannot_establish_custody(gws, monkeypatch, own):
+    from hermes_cli import kanban_wake_check
+    from hermes_cli.kanban_hub_probe_custody import registered_here
+    hub, _worker, _svc = gws
+    tid = claim._hub_card(hub)
+    probe = "test -f ~/.hermes/cache/ready.flag"
+    with kb.write_txn(hub.conn):
+        kb._append_event(hub.conn, tid, "scheduled", {"wake_check": probe, "probe_host": own})
+    monkeypatch.setattr(kanban_wake_check, "own_gateway", lambda _conn: own)
+    assert not registered_here(hub.conn, tid, probe)
+
+
 def test_a_later_park_cannot_borrow_an_older_probe_host(gws):
     from hermes_cli.kanban_hub_probe_custody import registered_here
     hub, _worker, _svc = gws
