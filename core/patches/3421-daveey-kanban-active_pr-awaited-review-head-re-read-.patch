+def _store(key: str, state: Optional[str], now: float) -> None:
+    if state == "REJECTED":
+        _cache.pop(key, None)  # requeue must invalidate rejection immediately
+    elif state in TERMINAL_STATES:
+        _cache[key] = (state, None)
+    else:
