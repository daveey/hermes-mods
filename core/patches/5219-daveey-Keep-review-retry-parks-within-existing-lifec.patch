From e3cb33d0cb5cfbb19f82e034407483d6e89b3227 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 13:48:13 +0000
Subject: [PATCH] [daveey] Keep review retry parks within existing lifecycle
 contracts

CI exposed an unintended direct review-to-scheduled transition and a ready-lane receipt shape change. Preserve existing refusal and payload contracts: only resumed review phases need the additive resume_status field. Cover triage resumption and claimed review runs without allowing an unclaimed review card to schedule.

Proof: all three CI-red consumer files plus retry custody suite pass: 149 tests over four files; scripts/check all checks pass. Existing workflow/refusal/tool-receipt assertions remain unchanged.
---
 hermes_cli/kanban_db_schedule.py                     | 7 +++----
 tests/hermes_cli/test_kanban_review_retry_custody.py | 4 +++-
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_db_schedule.py b/hermes_cli/kanban_db_schedule.py
index d7d5bb3f87..8245a2b55f 100644
--- a/hermes_cli/kanban_db_schedule.py
+++ b/hermes_cli/kanban_db_schedule.py
@@ -61,9 +61,8 @@ def schedule_task(
         task = _kb.get_task(conn, task_id)
         source_status = (_kb._retry_status_for_run(conn, task_id) if task and task.status == 'running'
                          else _kb._resume_status_from_events(conn, task_id))
-        if task and task.status == 'review':
-            source_status = 'review'
-        payload['resume_status'] = source_status
+        if source_status == 'review':
+            payload['resume_status'] = source_status
         if watch:
             payload["watch"] = True
         wake_check, check_every = kwc.validate_park(
@@ -80,7 +79,7 @@ def schedule_task(
                    claim_expires= NULL,
                    worker_pid   = NULL
              WHERE id = ?
-               AND status IN ('todo', 'ready', 'running', 'blocked', 'triage', 'review')
+               AND status IN ('todo', 'ready', 'running', 'blocked', 'triage')
         """
         if expected_run_id is not None:
             sql += " AND current_run_id = ?"
diff --git a/tests/hermes_cli/test_kanban_review_retry_custody.py b/tests/hermes_cli/test_kanban_review_retry_custody.py
index f0dfc5a975..014a8e4c96 100644
--- a/tests/hermes_cli/test_kanban_review_retry_custody.py
+++ b/tests/hermes_cli/test_kanban_review_retry_custody.py
@@ -133,7 +133,7 @@ def test_three_admission_failures_then_legacy_deep_wake_keeps_reviewer(board, mo
 
 
 @pytest.mark.parametrize('wake', ['unblock', 'timer'])
-@pytest.mark.parametrize('source', ['review', 'ready', 'running'])
+@pytest.mark.parametrize('source', ['triage', 'ready', 'running'])
 def test_schedule_unblock_preserves_source_lane(board, source, wake):
     conn, _ = board
     tid = kb.create_task(conn, title='Wait', assignee='worker')
@@ -141,6 +141,8 @@ def test_schedule_unblock_preserves_source_lane(board, source, wake):
     conn.commit()
     if source == 'running':
         assert kb.claim_review_task(conn, tid, claimer=kb._claimer_id())
+    elif source == 'triage':
+        kb._append_event(conn, tid, 'gave_up', {'resume_status': 'review'})
     assert kb.schedule_task(conn, tid, clock_only=True, awaiting={'kind': 'clock', 'why': 'cooldown'})
     if wake == 'unblock':
         assert kb.unblock_task(conn, tid)
-- 
