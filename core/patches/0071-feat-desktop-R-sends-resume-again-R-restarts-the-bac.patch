diff --git a/apps/desktop/electron/main.ts b/apps/desktop/electron/main.ts
index 4ec65d1f798850d9e01e576d61b1ba1ab308ed26..ded27c8fb7a062dcd90a4ae16422f2518733c492 100644
--- a/apps/desktop/electron/main.ts
+++ b/apps/desktop/electron/main.ts
@@ -6402,14 +6402,15 @@ function buildApplicationMenu() {
     submenu: [
       // Not `role: 'reload'`: that hard-reloads the RENDERER (every pane, the
       // whole shell) and a focused in-app browser needs ⌘R to mean "reload
-      // this page", the way it does in every other browser. ⇧⌘R
-      // (`forceReload`) below stays the unconditional escape hatch.
+      // this page", the way it does in every other browser. `forceReload`
+      // below stays the unconditional escape hatch, on ⌥⇧⌘R (fork: ⇧⌘R is
+      // the renderer's `app.reloadAll` keybind, so no accelerator may eat it).
       //
       // No accelerator: ⌘R is claimed in `installPreviewShortcut`, which works
       // on every platform (this menu exists only on macOS). Declaring it here
       // too would fire the item and the input hook for one keypress.
       { click: () => sendPreviewNavCommand('reload'), label: 'Reload' },
-      { role: 'forceReload' },
+      { role: 'forceReload', accelerator: 'Alt+Shift+CommandOrControl+R' },
       {
         label: 'Toggle Developer Tools',
         accelerator: process.platform === 'darwin' ? 'Alt+Cmd+I' : 'Ctrl+Shift+I',
@@ -6563,8 +6564,8 @@ function installPreviewShortcut(window) {
     // ⌘R rides here rather than on the View menu item for the same reason:
     // the application menu only exists on macOS (it is set to null elsewhere,
     // see #77845), so a menu accelerator would leave Windows and Linux with no
-    // way to reload a page at all. ⇧⌘R is left alone — that is `forceReload`,
-    // the unconditional whole-window escape hatch.
+    // way to reload a page at all. ⇧⌘R is left alone so it reaches the
+    // renderer's `app.reloadAll` keybind (fork; `forceReload` is ⌥⇧⌘R).
     if (action === 'reload') {
       event.preventDefault()
       sendPreviewNavCommand('reload')
diff --git a/apps/desktop/src/app/contrib/hooks/use-desktop-integrations.ts b/apps/desktop/src/app/contrib/hooks/use-desktop-integrations.ts
index 8a9fa064fd78382e1998bdfd15fc2decf46a06cf..52cdd3a740d568d206a01e6ce6b7d1ee2a7758b6 100644
--- a/apps/desktop/src/app/contrib/hooks/use-desktop-integrations.ts
+++ b/apps/desktop/src/app/contrib/hooks/use-desktop-integrations.ts
@@ -539,8 +539,8 @@ export function useDesktopIntegrations({
       }
 
       if (!commandFocusedPreview(command) && command === 'reload') {
-        // Fork: ⌘R runs whatever action is bound to mod+r (`app.reloadAll`
-        // by default); only an unbound ⌘R reloads the window. ⇧⌘R
+        // Fork: ⌘R runs whatever action is bound to mod+r (`session.resume`
+        // by default); only an unbound ⌘R reloads the window. ⌥⇧⌘R
         // (forceReload) is the unconditional reload.
         const bound = $comboIndex.get().get(canonicalizeCombo('mod+r')) ?? []
 
diff --git a/apps/desktop/src/app/hooks/use-keybinds.ts b/apps/desktop/src/app/hooks/use-keybinds.ts
index cecd796e528b82945565c53a131a75efe94e5fb2..2df34b994ec3e25337c07383139ea8abb127be5a 100644
--- a/apps/desktop/src/app/hooks/use-keybinds.ts
+++ b/apps/desktop/src/app/hooks/use-keybinds.ts
@@ -392,7 +392,7 @@ export function useKeybinds(deps: KeybindRuntimeDeps): void {
     // Fork ⌘R: send "resume" to the active chat as if typed (queues behind a
     // live turn like any submit).
     'session.resume': () => requestComposerSubmit('resume', { target: 'active' }),
-    // Fork ⌘R: restart the backend, then reload the window.
+    // Fork ⇧⌘R: restart the backend, then reload the window.
     'app.reloadAll': () => void reloadAppAndBackend(),
     // ⌘⇧P: typeahead over projects for the selected (else focused) session.
     'session.moveToProject': () => {
diff --git a/apps/desktop/src/lib/keybinds/actions.test.ts b/apps/desktop/src/lib/keybinds/actions.test.ts
index b43a50f4ebe527ea99bcf7e6ec975a3428944ec5..cf73747040959459fa6afc696af12985019394a7 100644
--- a/apps/desktop/src/lib/keybinds/actions.test.ts
+++ b/apps/desktop/src/lib/keybinds/actions.test.ts
@@ -135,11 +135,11 @@ describe('view.tabSlot.N layers over profile.switch.N on ⌘1…⌘9 (#92569)',
     expect(firstProfileSwitch).toBeGreaterThan(firstTabSlot)
   })
 
-  it('fork: ⌘R is app.reloadAll, ⌥⌘R is session.resume, both work from the composer (⇧⌘R stays the window reload)', () => {
-    expect(KEYBIND_ACTIONS.filter(a => a.defaults.includes('mod+r')).map(a => a.id)).toEqual(['app.reloadAll'])
-    expect(keybindActionAllowedInEditableTarget('app.reloadAll', 'mod+r')).toBe(true)
-    expect(keybindAction('session.resume')?.defaults).toEqual(['mod+alt+r'])
-    expect(keybindActionAllowedInEditableTarget('session.resume', 'mod+alt+r')).toBe(true)
-    expect(KEYBIND_ACTIONS.filter(a => a.defaults.includes('mod+shift+r'))).toEqual([])
+  it('fork: ⌘R is session.resume, ⇧⌘R is app.reloadAll, both work from the composer', () => {
+    expect(KEYBIND_ACTIONS.filter(a => a.defaults.includes('mod+r')).map(a => a.id)).toEqual(['session.resume'])
+    expect(keybindActionAllowedInEditableTarget('session.resume', 'mod+r')).toBe(true)
+    expect(KEYBIND_ACTIONS.filter(a => a.defaults.includes('mod+shift+r')).map(a => a.id)).toEqual(['app.reloadAll'])
+    expect(keybindActionAllowedInEditableTarget('app.reloadAll', 'mod+shift+r')).toBe(true)
+    expect(KEYBIND_ACTIONS.filter(a => a.defaults.includes('mod+alt+r'))).toEqual([])
   })
 })
