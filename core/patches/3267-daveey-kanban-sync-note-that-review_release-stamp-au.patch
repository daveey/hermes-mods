From 2788fb7e3bbdac98caceac7e80bb6956f229297c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 07:07:18 +0000
Subject: [PATCH] [daveey] kanban sync: note that review_release stamp
 authority depends on task_events.origin_gateway

PR #1803 second review (t_01a1d38a3c4fe5f2) nit 2: _upsert_row copies the wire origin_gateway onto
task_events, and released() trusts a promoted event's stamp only when that origin is the card's home.
---
 hermes_cli/kanban_db_sync.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/hermes_cli/kanban_db_sync.py b/hermes_cli/kanban_db_sync.py
index a6ed48a158..9456b34550 100644
--- a/hermes_cli/kanban_db_sync.py
+++ b/hermes_cli/kanban_db_sync.py
@@ -1347,6 +1347,8 @@ def _upsert_row(conn: sqlite3.Connection, ch: RemoteChange, own: str, result: Ap
     from hermes_cli.kanban_sync_omissions import without_held
     cols = _local_fields(conn, table, without_held(conn, table, ch.uid, ch.fields), task_id)
     if table == "task_events" and "origin_gateway" in table_columns(conn, table):
+        # Authority, not provenance only: kanban_review_release.released() honours a promoted event's
+        # review_release stamp only when this column names the card's home, so it must come from the wire. [daveey]
         cols["origin_gateway"] = ch.origin_gateway or None
     if table == "task_links":
         return conn.execute("INSERT OR IGNORE INTO task_links (parent_id, child_id) VALUES (?, ?)",
-- 
