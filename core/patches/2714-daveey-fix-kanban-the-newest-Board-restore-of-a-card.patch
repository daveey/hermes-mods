From b33ce6d25dabc90bf7cacaf897c73e220267da21 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 12:15:32 +0000
Subject: [PATCH] [daveey] fix(kanban): the newest Board restore of a card wins
 its restored_at

note_restored_task kept the first restore time (INSERT OR IGNORE). It only runs when the
board file lacked the card, so a card lost a second time got no hub subscription for links
written after the first restore + skew. Upsert restored_at instead, add a regression test for
a second loss after a newer link, and name the same-gateway gap in the module docstring
(review 5874036730 on #1387, t_01a1cf4cfd7eb125).
---
 hermes_cli/kanban_restore_chat_subs.py        |  8 ++++-
 .../test_kanban_sync_restore_origin_subs.py   | 30 +++++++++++++++++++
 2 files changed, 37 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_restore_chat_subs.py b/hermes_cli/kanban_restore_chat_subs.py
index 7ed8ab9c5c..43e1ef049f 100644
--- a/hermes_cli/kanban_restore_chat_subs.py
+++ b/hermes_cli/kanban_restore_chat_subs.py
@@ -22,6 +22,9 @@ wildcard), a released link, a chat on this gateway (a ``tui`` destination, not a
 session, an archived card, a link that arrives later for a card this file already held (that chat's subscription may
 have been retired on purpose), the replica copy (``sync-shadow``) and link-only files (``sync-links``), and foreign
 copies a worker node picks up (their owner delivers). Two links for one chat give one subscription; owning wins.
+
+Known gap: chats on THIS gateway are not rebuilt: a same-gateway chat of another profile (its ``hub`` sub from
+``kanban_creator_chats``) and a local ``tui`` shepherd sub have no exact destination in the synced link row.
 """
 
 from __future__ import annotations
@@ -54,7 +57,10 @@ def note_restored_task(conn: sqlite3.Connection, task_id: str, created_on: Any,
     if sync.board_mode(conn) != "primary":
         return
     conn.execute(MARKER_DDL)
-    conn.execute("INSERT OR IGNORE INTO kanban_restored_cards (task_id, restored_at) VALUES (?, ?)",
+    # The newest restore wins: this only runs when the file lacked the card, so a card lost again after an earlier
+    # restore must cover the links written since (keeping the first time would drop them).
+    conn.execute("INSERT INTO kanban_restored_cards (task_id, restored_at) VALUES (?, ?) "
+                 "ON CONFLICT(task_id) DO UPDATE SET restored_at = excluded.restored_at",
                  (task_id, int(time.time())))
 
 
diff --git a/tests/hermes_cli/test_kanban_sync_restore_origin_subs.py b/tests/hermes_cli/test_kanban_sync_restore_origin_subs.py
index c8a733ec8b..b34108994b 100644
--- a/tests/hermes_cli/test_kanban_sync_restore_origin_subs.py
+++ b/tests/hermes_cli/test_kanban_sync_restore_origin_subs.py
@@ -180,6 +180,36 @@ def test_reconcile_after_a_rebuild_that_lost_the_card_restores_its_subscription(
     assert _hub_subs(live, tid) == [("hub/default/chat-a", "origin")]
 
 
+def _lose(live, tid):
+    """A corruption rebuild loses the card, its links and its subscriptions without capture."""
+    with kbc.write_txn(live):
+        live.execute("UPDATE kanban_sync_state SET applying = 1")
+        for table in ("kanban_notify_subs", "task_chat_links", "task_events", "task_runs"):
+            live.execute(f"DELETE FROM {table} WHERE task_id = ?", (tid,))
+        live.execute("DELETE FROM tasks WHERE id = ?", (tid,))
+        live.execute("UPDATE kanban_sync_state SET applying = 0")
+
+
+def test_a_second_loss_of_the_same_card_restores_links_written_after_the_first_restore(live, svc, kanban_home):
+    tid = kb.create_task(live, title="card", assignee="worker", chat_origin="hub/default/chat-a")
+    _round(kanban_home, svc)
+    _lose(live, tid)
+    ksc.reconcile(BOARD, kanban_home / "kanban.db", hub=svc.hub(ME))
+    assert _hub_subs(live, tid) == [("hub/default/chat-a", "origin")]
+    # An hour later a chat on another gateway starts shepherding the card.
+    with kbc.write_txn(live):
+        live.execute("UPDATE kanban_restored_cards SET restored_at = restored_at - 3600 WHERE task_id = ?", (tid,))
+        live.execute("INSERT INTO task_chat_links (uid, task_id, chat_gateway, chat_profile, chat_session, kind, "
+                     "released, created_at) VALUES (?, ?, ?, 'default', 'chat-new', 'shepherd', 0, ?)",
+                     (link_uid(tid, OTHER, "default", "chat-new", "shepherd"), tid, OTHER, int(time.time())))
+    _round(kanban_home, svc)
+    # The card is lost again: the newest restore covers the newer link too.
+    _lose(live, tid)
+    report = ksc.reconcile(BOARD, kanban_home / "kanban.db", hub=svc.hub(ME))
+    assert report["restored"].get("tasks") == 1
+    assert _hub_subs(live, tid) == [("hub/default/chat-a", "origin"), (f"{OTHER}/default/chat-new", "shepherd")]
+
+
 def test_the_replica_copy_and_foreign_cards_get_no_subscriptions(live, svc, kanban_home):
     tid = kb.create_task(live, title="card", assignee="worker", chat_origin="hub/default/chat-a")
     hub = svc.hub(OTHER)
