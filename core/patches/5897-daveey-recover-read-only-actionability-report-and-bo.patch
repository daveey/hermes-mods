diff --git a/hermes_cli/kanban_actionability.py b/hermes_cli/kanban_actionability.py
new file mode 100644
index 00000000000..8590b6ef765
--- /dev/null
+++ b/hermes_cli/kanban_actionability.py
@@ -0,0 +1,177 @@
+"""Pure administrative actionability projection; never an admission/release decision. [daveey]"""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+
+NONTERMINAL = ('todo', 'ready', 'running', 'scheduled', 'triage', 'blocked', 'review')
+
+
+def positive_time(value) -> int | None:
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value <= 0:
+        return None
+    return int(value)
+
+
+def owner(value) -> dict:
+    if isinstance(value, str) and value.strip():
+        return {'kind': 'assignee', 'refs': [value]}
+    return {'kind': 'unavailable', 'refs': []}
+
+
+def _block(row: dict, prerequisite: str, trigger: str, *, action: str) -> None:
+    row.update(action=action, instruction=trigger,
+               blocker={'prerequisite': prerequisite, 'trigger': trigger, 'evidence': row['source_refs']})
+
+
+def _decision(row: dict, facts: dict) -> None:
+    contract = facts.get('next_action') or {}
+    blocker = contract.get('blocker') if isinstance(contract.get('blocker'), dict) else {}
+    prerequisite = blocker.get('prerequisite')
+    trigger = blocker.get('trigger') or blocker.get('prerequisite')
+    instruction = contract.get('instruction')
+    _block(row, prerequisite if isinstance(prerequisite, str) and prerequisite.strip() else (
+        facts['stop'].get('cause') or 'Recorded spend decision'),
+        trigger if isinstance(trigger, str) and trigger.strip() else
+        'Administrative owner records a scoped decision; comments, timers and notices do not release work',
+        action='decide_scope')
+    if isinstance(instruction, str) and instruction.strip():
+        row['instruction'] = instruction
+    evidence = blocker.get('evidence')
+    if isinstance(evidence, list) and all(isinstance(ref, str) for ref in evidence):
+        row['blocker']['evidence'] = list(dict.fromkeys([*row['source_refs'], *evidence]))
+    release = contract.get('release')
+    if isinstance(release, dict) and isinstance(release.get('condition'), str) and release['condition'].strip():
+        row['release']['condition'] = release['condition']
+    row['release']['authority'] = 'unavailable'  # recorded conditions never grant release
+
+
+def _status(row: dict, facts: dict, now: int) -> None:
+    status = row['status']
+    if status not in NONTERMINAL:
+        row.update(action='no_open_action', instruction='n/a: terminal task has no open action')
+        row['release'] = {'authority': 'not_applicable', 'condition': 'No open action'}
+    elif facts.get('pending_command'):
+        _block(row, 'Exact canonical stop receipt reconciliation',
+               'Recover the original frozen request and verify its exact receipt; no replacement identity or fallback',
+               action='resolve_release_authority')
+        row['release']['authority'] = 'unavailable'
+        row['evidence_state'] = 'unknown'
+    elif facts.get('stop') and (not facts.get('containment') or
+                               facts['stop'].get('cause') in ('safety_refusal', 'scope_stopped')):
+        _decision(row, facts)
+    elif facts.get('containment'):
+        _block(row, 'Exact contained episode and live release authority',
+               'Resolve reconsideration ownership for this episode without resuming the held scope',
+               action='resolve_release_authority')
+        row['release']['authority'] = 'unavailable'
+    elif facts.get('human_step'):
+        _block(row, facts['human_step'], 'Supply the recorded human step: ' + facts['human_step'],
+               action='supply_recorded_human_step')
+    elif facts.get('dependencies'):
+        deps = facts['dependencies']
+        _block(row, '; '.join(f"{d['task_id']} ({d['status'] or 'unknown'})" for d in deps),
+               '; '.join(d['trigger'] for d in deps), action='satisfy_dependency')
+    elif status == 'scheduled':
+        _schedule(row, facts, now)
+    elif status == 'running':
+        run = facts.get('run') or {}
+        if not run or run.get('status') != 'running' or run.get('ended_at') is not None:
+            if facts.get('run_evidence_known'):
+                row['violations'].append('running_without_current_run')
+            else:
+                row['evidence_state'] = 'unknown'
+            _block(row, 'Current live executor/run witness',
+                   'Dispatcher verifies worker loss through existing reclaim APIs; preserve pending stop custody',
+                   action='repair_lifecycle_contract')
+        else:
+            row.update(action='execute_current_scope', instruction='Current executor continues its admitted scope')
+            # A persisted running row cannot prove process/lease liveness without a fresh witness.
+            row['evidence_state'] = 'unknown'
+    elif status in ('ready', 'review'):
+        row.update(action='review_current_scope' if status == 'review' else 'execute_current_scope',
+                   instruction='Assigned profile requests normal admission; all existing holds and review gates apply')
+        row['evidence_state'] = 'unknown'  # read-only database evidence is not live eligibility
+    elif status == 'todo':
+        row['violations'].append('dependency_transition_due')
+        _block(row, 'Existing recompute_ready transition',
+               'Dispatcher recomputes satisfied dependencies, preserving review phase and all execution holds',
+               action='repair_lifecycle_contract')
+    elif status == 'triage':
+        row.update(action='decide_scope', instruction='Assigned profile specifies or reviews scope before explicit promotion')
+    else:
+        row['violations'].append('lifecycle_contract_missing')
+        _block(row, 'Supported lifecycle transition', 'Assigned owner repairs the lifecycle contract without bypassing holds',
+               action='repair_lifecycle_contract')
+
+
+def _schedule(row: dict, facts: dict, now: int) -> None:
+    wake = positive_time(facts.get('wake_at'))
+    awaiting = facts.get('awaiting') or {}
+    probe = facts.get('probe')
+    if not wake:
+        row['violations'].append('scheduled_wake_missing')
+    elif now > wake + 600:
+        row['violations'].append('scheduled_wake_overdue')
+    trigger = f"Recorded clock reaches {wake}" if awaiting.get('kind') == 'clock' and wake else (
+        f"Recorded {awaiting.get('kind')} producer {awaiting.get('ref') or awaiting.get('why') or ''}" if awaiting else '')
+    if probe:
+        trigger = f'Recorded condition probe succeeds: {probe}'
+    if not trigger:
+        row['violations'].append('recovery_trigger_missing')
+    _block(row, trigger or 'Named finite producer and recovery condition',
+           trigger or 'Repair the missing wake/producer through existing scheduling APIs',
+           action='repair_lifecycle_contract' if row['violations'] else 'wait_for_named_producer')
+
+
+def project(facts: dict, *, now: int) -> dict:
+    """Project only supplied facts. `now` affects overdue display, never identity/deadline."""
+    task = facts['task']
+    identity = {key: facts.get(key) for key in ('source_uid', 'stop_episode', 'containment',
+                                              'administrative_owner')}
+    identity['dependencies'] = [{k: dep.get(k) for k in ('task_id', 'status', 'owner', 'stop_episode', 'containment')}
+                                for dep in facts.get('dependencies', [])]
+    command = facts.get('pending_command')
+    identity['pending_command'] = {k: command.get(k) for k in ('request_uid', 'request_sha256', 'run_uid', 'operation_kind')} if command else None
+    identity['stop_cause'] = (facts.get('stop') or {}).get('cause')
+    identity.update(task_id=task['id'], status=task['status'], assignee=task.get('assignee'))
+    key = hashlib.sha256(json.dumps(identity, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+    first = positive_time(facts.get('source_at')) or positive_time(task.get('created_at'))
+    deadline = positive_time(facts.get('deadline_at'))
+    wake = positive_time(facts.get('wake_at'))
+    if task['status'] == 'scheduled' and wake and not any(
+            facts.get(k) for k in ('pending_command', 'stop', 'containment', 'human_step', 'dependencies')):
+        deadline = max(deadline or 0, wake + 600)
+    row = {'version': 1, 'task_id': task['id'], 'status': task['status'], 'contract_key': key,
+           'evidence_state': 'unknown' if facts.get('unknown') else 'known',
+           'owner': facts.get('administrative_owner') or owner(task.get('assignee')),
+           'action': 'repair_lifecycle_contract', 'instruction': '', 'blocker': None,
+           'release': {'authority': 'existing_lifecycle_gates', 'condition': 'Existing authenticated lifecycle policy'},
+           'escalation': {'at': deadline, 'route': 'existing_decision_requested', 'state': 'pending', 'receipt_uid': None},
+           'violations': [], 'source_refs': facts.get('source_refs', []),
+           'dependencies': facts.get('dependencies', []), 'first_observed': first,
+           'materialization': 'source_derived'}
+    _status(row, facts, now)
+    if task['status'] not in NONTERMINAL:
+        row['violations'] = []
+        row['escalation'].update(at=None, state='not_applicable')
+        return row
+    deps = row['dependencies']
+    if deps and all(d.get('restricted') and d.get('evidence_state') == 'known' for d in deps):
+        row['release']['authority'] = 'unavailable'
+        if all(d.get('administrative_owner', {}).get('kind') == 'unavailable' for d in deps):
+            row['violations'].append('dependency_recovery_unavailable')
+    if row['owner']['kind'] == 'unavailable':
+        row['violations'].append('owner_missing')
+    elif row['owner']['kind'] == 'unknown' or not row['owner'].get('refs'):
+        row['evidence_state'] = 'unknown'
+    if not deadline:
+        row['violations'].append('escalation_deadline_missing')
+        row['escalation']['state'] = 'unavailable'
+        row['evidence_state'] = 'unknown'
+    if row['blocker'] and deadline and now >= deadline:
+        row['violations'].append('escalation_overdue')
+    if facts.get('unknown'):
+        row['evidence_state'] = 'unknown'
+    return row
diff --git a/hermes_cli/kanban_actionability_cli.py b/hermes_cli/kanban_actionability_cli.py
new file mode 100644
index 00000000000..272a9ccea0c
--- /dev/null
+++ b/hermes_cli/kanban_actionability_cli.py
@@ -0,0 +1,87 @@
+"""Read-only stranded-card report with exact streamed counts, no init/sync/network. [daveey]"""
+from __future__ import annotations
+
+from collections import Counter
+from contextlib import closing
+import json
+import sqlite3
+import sys
+import time
+
+from hermes_cli.kanban_actionability import NONTERMINAL
+from hermes_cli.kanban_actionability_sources import Reader, describe
+from hermes_cli.kanban_lockguard import connect
+
+
+def report(conn: sqlite3.Connection, *, limit: int = 100, after: str = '', now: int | None = None) -> dict:
+    """Counts cover the complete snapshot, pagination only limits displayed rows.
+
+    Unknown and violated are independent: a partial replica may already demonstrate
+    a violation without proving the absence of others. No zero-known-violation
+    result is evidence of an invariant while unknown_count is nonzero.
+    """
+    if isinstance(limit, bool) or not isinstance(limit, int) or not 1 <= limit <= 1000:
+        raise ValueError('limit must be between 1 and 1000')
+    now = int(time.time()) if now is None else int(now)
+    rows, count, violations, unknown, more = [], 0, 0, 0, False
+    per_status = Counter()
+    owned_transaction = not conn.in_transaction
+    if owned_transaction:
+        conn.execute('BEGIN')
+    try:
+        reader = Reader(conn)
+        cursor = ''
+        marks = ','.join('?' for _ in NONTERMINAL)
+        while True:
+            batch = conn.execute(f'SELECT id,status FROM tasks WHERE id>? AND status IN ({marks}) '
+                                 'ORDER BY id LIMIT 128', (cursor, *NONTERMINAL)).fetchall()
+            if not batch:
+                break
+            for task in batch:
+                tid, status = task
+                row = describe(conn, tid, now=now, reader=reader)
+                count += 1
+                per_status[status] += 1
+                violations += bool(row['violations'])
+                unknown += row['evidence_state'] == 'unknown'
+                if tid > after:
+                    if len(rows) < limit:
+                        rows.append(row)
+                    else:
+                        more = True
+            cursor = batch[-1][0]
+    finally:
+        if owned_transaction:
+            conn.rollback()  # close this read snapshot, never the caller's transaction
+    return {'version': 1, 'observed_at': now, 'total_nonterminal': count, 'scanned_count': count,
+            'known_violation_count': violations, 'unknown_count': unknown, 'per_status': dict(per_status),
+            'returned_count': len(rows), 'has_more': more,
+            'next_after': rows[-1]['task_id'] if more and rows else None, 'rows': rows,
+            'read_only': True, 'admission_authority': False}
+
+
+def command(args) -> int:
+    from hermes_cli import kanban_db as kb
+    path = kb.kanban_db_path()
+    try:
+        with closing(connect(path.absolute().as_uri() + '?mode=ro', uri=True)) as conn:
+            conn.row_factory = sqlite3.Row
+            conn.execute('PRAGMA query_only=ON')
+            result = report(conn, limit=args.limit, after=args.after or '')
+    except (sqlite3.Error, ValueError) as exc:
+        print(f'kanban stranded: {exc}', file=sys.stderr)
+        return 1
+    if args.json:
+        print(json.dumps(result, sort_keys=True))
+    else:
+        print(f"{result['total_nonterminal']} nonterminal; {result['known_violation_count']} with known violations; "
+              f"{result['unknown_count']} with unknown evidence (not invariant success)")
+        for row in result['rows']:
+            blocker = row['blocker']
+            step = blocker['trigger'] if blocker else row['instruction']
+            print(f"{row['task_id']} {row['status']} owner={row['owner']} {row['action']}: {step}; "
+                  f"deadline={row['escalation']['at']} evidence={row['evidence_state']} "
+                  f"violations={','.join(row['violations']) or 'none observed'}")
+        if result['has_more']:
+            print(f"More rows: --after {result['next_after']}")
+    return 0
diff --git a/hermes_cli/kanban_actionability_evidence.py b/hermes_cli/kanban_actionability_evidence.py
new file mode 100644
index 00000000000..198802348d3
--- /dev/null
+++ b/hermes_cli/kanban_actionability_evidence.py
@@ -0,0 +1,66 @@
+"""Fault-contained, read-only reuse of lifecycle evidence; never a policy writer. [daveey]"""
+from __future__ import annotations
+
+import json
+import sqlite3
+
+EVIDENCE_ERRORS = (sqlite3.Error, ValueError, TypeError, KeyError, AttributeError, OverflowError)
+
+
+class Rows:
+    """Give legacy policy readers named rows without mutating a caller's connection factory."""
+
+    def __init__(self, conn):
+        self.conn = conn
+
+    def execute(self, sql, params=()):
+        cursor = self.conn.cursor()
+        cursor.row_factory = sqlite3.Row
+        return cursor.execute(sql, params)
+
+
+def effective(reader, tid):
+    """Return (pending stop, execution restriction, unknown). Arrival order is LOCAL evidence."""
+    from hermes_cli import kanban_spend_decision as decision
+    conn = Rows(reader.conn)
+    try:
+        stop = decision.pending_episode(conn, tid)
+        restricted = decision.execution_restricted(conn, tid)
+        if stop:
+            stop = {**stop, 'data': json.loads(stop['payload'] or '{}')}
+            if not isinstance(stop['data'], dict):
+                return None, False, True
+            if restricted:
+                from hermes_cli.kanban_refusal_receipt import restricted as safety
+                stop['data']['cause'] = 'safety_refusal' if safety(conn, tid) else 'scope_stopped'
+        return stop, restricted, False
+    except EVIDENCE_ERRORS:
+        return None, False, True
+
+
+def fields(conn, task, *, replica=False):
+    """Optional per-card carriage. No whole-report scan, refresh or admission side effect."""
+    from hermes_cli.kanban_actionability_sources import describe
+    try:
+        row = describe(conn, task.id)
+    except EVIDENCE_ERRORS:
+        from hermes_cli.kanban_actionability import project
+        row = project({'task': {'id': task.id, 'status': task.status, 'assignee': task.assignee},
+                       'unknown': True}, now=0)
+        row['violations'] = ['evidence_unavailable']
+        row.update(action='repair_lifecycle_contract', instruction='Recover authoritative task evidence')
+    if replica and row['action'] != 'no_open_action':
+        row['evidence_state'] = 'unknown'
+    return {'actionability': row}
+
+
+def render(row):
+    """Bounded prompt/status line, not a generated executable original-scope instruction."""
+    return (f"Actionability: {row['action']}; owner={row['owner']}; "
+            f"{row['instruction']}; deadline={row['escalation']['at']} "
+            f"(null=unrecorded); evidence={row['evidence_state']}; "
+            f"violations={','.join(row['violations']) or 'none observed'}")[:1800]
+
+
+def context(lines, conn, task):
+    lines.append(render(fields(conn, task)['actionability']))
diff --git a/hermes_cli/kanban_actionability_sources.py b/hermes_cli/kanban_actionability_sources.py
new file mode 100644
index 00000000000..60a8d0009e4
--- /dev/null
+++ b/hermes_cli/kanban_actionability_sources.py
@@ -0,0 +1,267 @@
+"""Read-only SQLite fact adapters for actionability. No migrations, refresh or side effects. [daveey]"""
+from __future__ import annotations
+
+import json
+import sqlite3
+import time
+
+from hermes_cli.kanban_actionability import owner, project
+from hermes_cli.kanban_actionability_evidence import EVIDENCE_ERRORS, effective
+
+KINDS = ('created', 'blocked', 'scheduled', 'continued', 'spend_budget_triaged',
+         'decision_hold_restricted', 'decision_retained', 'decision_protected_stopped',
+         'spend_budget_decision_ready', 'promoted_manual', 'archived', 'contained')
+
+
+def record(raw) -> dict:
+    if isinstance(raw, dict):
+        return raw
+    try:
+        value = json.loads(raw or '{}')
+    except (ValueError, TypeError):
+        return {}
+    return value if isinstance(value, dict) else {}
+
+
+def _human_step(raw) -> str | None:
+    request = record(raw)
+    required = ('action', 'why_human', 'scope', 'evidence')
+    if not all(isinstance(request.get(k), str) and request[k].strip() for k in required):
+        return None
+    return request['action'] if request.get('interaction') in ('approval', 'reply', 'user_terminal', 'physical', 'external') else None
+
+
+class Reader:
+    """Only fixed local schema names and parameterized coordinates; optional legacy tables are unknown."""
+
+    def __init__(self, conn: sqlite3.Connection):
+        self.conn = conn
+        self.tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
+        self.schema = {}
+        self.event_columns = self.columns('task_events')
+        self.events_complete = {'task_id', 'kind', 'payload', 'created_at', 'id'} <= self.event_columns
+        self.partial = not self.events_complete
+        self.malformed = set()
+        sync_columns = self.columns('kanban_sync_state')
+        self.synced = 'mode' in sync_columns and bool(conn.execute(
+            "SELECT 1 FROM kanban_sync_state WHERE mode!='off' LIMIT 1").fetchone())
+        self.partial |= 'kanban_sync_state' in self.tables and 'mode' not in sync_columns
+        shapes = {'task_runs': {'id', 'task_id', 'status', 'ended_at'},
+                  'task_wake_checks': {'task_id', 'cmd'},
+                  'kanban_failure_commands': {'task_id', 'run_uid', 'request_uid', 'operation_kind',
+                                             'delivery_state', 'canonical_receipt_json'}}
+        self.partial |= any(not required <= self.columns(table) for table, required in shapes.items())
+
+    def columns(self, table: str) -> set[str]:
+        if table not in self.schema:
+            self.schema[table] = {r[0] for r in self.conn.execute('SELECT name FROM pragma_table_info(?)', (table,))}
+        return self.schema[table]
+
+    def rows(self, sql: str, params=()) -> list[dict]:
+        cursor = self.conn.execute(sql, params)
+        names = [d[0] for d in cursor.description]
+        return [dict(zip(names, row)) for row in cursor]
+
+    def task(self, tid: str) -> dict | None:
+        rows = self.rows('SELECT * FROM tasks WHERE id=?', (tid,))
+        return rows[0] if rows else None
+
+    def events(self, tid: str) -> list[dict]:
+        if not self.events_complete:
+            return []
+        order = 'created_at DESC,uid DESC' if 'uid' in self.event_columns else 'created_at DESC,id DESC'
+        marks = ','.join('?' for _ in KINDS)
+        live = ' AND deleted_at IS NULL' if 'deleted_at' in self.event_columns else ''
+        rows = self.rows(f'SELECT * FROM task_events WHERE task_id=? AND kind IN ({marks}){live} ORDER BY {order}',
+                         (tid, *KINDS))
+        for row in rows:
+            try:
+                payload = json.loads(row['payload'] or '{}')
+                if not isinstance(payload, dict) or any(
+                        payload.get(k) is not None and not isinstance(payload[k], str)
+                        for k in ('episode', 'episode_uid', 'cause')) or any(
+                        payload.get(k) is not None and not isinstance(payload[k], dict)
+                        for k in ('next_action', 'producer')):
+                    self.malformed.add(tid)
+            except (ValueError, TypeError):
+                self.malformed.add(tid)
+        return [{**r, 'data': record(r['payload'])} for r in rows]
+
+    def uid(self, event: dict) -> str | None:
+        if 'uid' in self.event_columns and event.get('uid'):
+            return event['uid']
+        return None if self.synced else str(event['id'])
+
+    def pending(self, tid: str) -> dict | None:
+        if 'kanban_failure_commands' not in self.tables:
+            return None
+        columns = self.columns('kanban_failure_commands')
+        if not {'task_id', 'run_uid', 'request_uid', 'operation_kind', 'delivery_state', 'canonical_receipt_json'} <= columns:
+            return None
+        rows = self.rows("SELECT * FROM kanban_failure_commands WHERE task_id=? AND operation_kind='retain' "
+                         "AND (delivery_state IS NULL OR delivery_state NOT IN ('confirmed','rejected')) "
+                         "ORDER BY run_uid,request_uid LIMIT 2", (tid,))
+        return {**rows[0], '_ambiguous': len(rows) > 1} if rows else None
+
+
+def _unresolved_receipt(events: list[dict]) -> dict | None:
+    promoted = False
+    for event in events:
+        if event['kind'] == 'promoted_manual':
+            promoted = True
+        if event['kind'] not in ('decision_retained', 'decision_protected_stopped'):
+            continue
+        disposition = record(event['data'].get('disposition'))
+        restricted = event['kind'] == 'decision_protected_stopped' or disposition.get('reason') == 'scope_stopped' or event['data'].get('superseded_by_safety_stop') is True
+        if restricted or not promoted:
+            return event
+    return None
+
+
+def _state(reader, tid, events):
+    stop, restricted, unknown = effective(reader, tid)
+    try:
+        from hermes_cli.kanban_scope_renewal import covered, renewals
+        from hermes_cli.kanban_actionability_evidence import Rows
+        renewed = covered(Rows(reader.conn), tid)
+        valid = renewals(Rows(reader.conn), tid)
+    except EVIDENCE_ERRORS:
+        renewed, valid, unknown = (), [], True
+    remaining = [e for e in events if e['data'].get('superseded_by_safety_stop') is True or (
+                 reader.uid(e) not in renewed and not any(
+                     e['data'].get('episode_uid') == r['payload']['episode'] and
+                     int(e['id']) < int(r['id']) for r in valid))]
+    receipt = None if stop else _unresolved_receipt(remaining)
+    return stop or receipt, restricted, reader.partial or unknown or bool(receipt) or tid in reader.malformed
+
+
+def _dependencies(reader: Reader, tid: str) -> tuple[list[dict], bool]:
+    if 'task_links' not in reader.tables:
+        return [], True
+    result, unknown = [], False
+    for (pid,) in reader.conn.execute('SELECT parent_id FROM task_links WHERE child_id=? ORDER BY parent_id', (tid,)):
+        parent = reader.task(pid)
+        if parent is None:
+            result.append({'task_id': pid, 'status': None, 'owner': owner(None),
+                           'trigger': f'Recover authoritative parent evidence for {pid}'})
+            unknown = True
+            continue
+        parent_events = reader.events(pid)
+        stop, restricted, partial = _state(reader, pid, parent_events)
+        unknown |= partial or reader.synced
+        contained = parent.get('containment_episode')
+        if parent['status'] in ('done', 'archived') and not stop and not contained and not partial:
+            continue
+        episode = (stop['data'].get('episode_uid') or stop['data'].get('episode') or reader.uid(stop)) if stop else None
+        admin, _ = _administration(reader, parent_events, episode)
+        step = _human_step(parent.get('human_request'))
+        result.append({'task_id': pid, 'status': parent['status'], 'owner': owner(parent.get('assignee')),
+                       'restricted': restricted, 'administrative_owner': admin,
+                       'evidence_state': 'unknown' if partial or reader.synced else 'known',
+                       'stop_episode': (stop['data'].get('episode_uid') or stop['data'].get('episode') or reader.uid(stop)) if stop else None,
+                       'containment': contained,
+                       'trigger': f'{pid}: {step}' if isinstance(step, str) and step.strip() else (
+                           f'{pid}: supported resolution of its protected episode' if stop or contained else
+                           f'{pid}: accountable owner completes its acceptance')})
+    return result, unknown
+
+
+def _route_owner(reader: Reader, route: dict) -> dict:
+    tid = route.get('task_id')
+    if not tid and route.get('kind') == 'task' and isinstance(route.get('refs'), list):
+        tid = next(iter(route['refs']), None)
+    if isinstance(tid, str):
+        task = reader.task(tid)
+        if not task or task['status'] in ('done', 'archived'):
+            return {'kind': 'unavailable', 'refs': [tid]}
+        stop, restricted, unknown = _state(reader, tid, reader.events(tid))
+        if unknown or reader.synced:
+            return {'kind': 'unknown', 'refs': [tid]}
+        held = stop or restricted or task.get('containment_episode')
+        return {'kind': 'unavailable' if held else 'task', 'refs': [tid]}
+    if route.get('kind') in ('chat', 'chats'):
+        return {'kind': 'chat', 'refs': []}  # route exists, exact counted/liveness evidence not loaded offline
+    return {'kind': 'unavailable', 'refs': []}
+
+
+def _administration(reader: Reader, events: list[dict], episode: str | None) -> tuple[dict, dict]:
+    scoped = [e for e in events if episode and (e['data'].get('episode') or e['data'].get('episode_uid')) == episode]
+    routes, deadlines = [], []
+    from hermes_cli.kanban_actionability import positive_time
+    for event in scoped:
+        p = event['data']
+        next_action = record(p.get('next_action'))
+        deadline = positive_time(next_action.get('escalate_at')) or positive_time(record(next_action.get('escalation')).get('at'))
+        if deadline:
+            deadlines.append(deadline)
+        route = p.get('producer') or next_action.get('owner')
+        if isinstance(route, dict):
+            routes.append(route)
+    admin = _route_owner(reader, routes[0]) if routes else {'kind': 'unavailable', 'refs': []}
+    contracts = [record(e['data'].get('next_action')) for e in scoped if record(e['data'].get('next_action'))]
+    return admin, {**(contracts[0] if contracts else {}), 'escalate_at': min(deadlines) if deadlines else None}
+
+
+def describe(conn: sqlite3.Connection, tid: str, *, now: int | None = None, reader: Reader | None = None) -> dict:
+    """One task and its immediate parents only; malformed optional evidence stays UNKNOWN."""
+    reader = reader or Reader(conn)
+    task = reader.task(tid)
+    if task is None:
+        raise ValueError(f'unknown task: {tid}')
+    now = int(time.time()) if now is None else now
+    try:
+        return _describe(conn, tid, now=now, reader=reader)
+    except EVIDENCE_ERRORS:
+        row = project({'task': task, 'unknown': True}, now=now)
+        if task['status'] in ('done', 'archived'):
+            return row
+        row['violations'] = ['evidence_unavailable']
+        row.update(action='repair_lifecycle_contract', instruction='Recover authoritative task evidence')
+        return row
+
+
+def _describe(conn, tid, *, now, reader):
+    """Source-derived diagnostics only. Foreign/canonical freshness is explicitly UNKNOWN."""
+    reader = reader or Reader(conn)
+    task = reader.task(tid)
+    if task is None:
+        raise ValueError(f'unknown task: {tid}')
+    events = reader.events(tid)
+    stop, _restricted, receipt_only = _state(reader, tid, events)
+    schedule = next((e for e in events if e['kind'] in ('scheduled', 'continued')), None)
+    # Notes/notices do not replace the material source or reset its deadline.
+    source = stop or (schedule if task['status'] == 'scheduled' else next(
+        (e for e in events if e['kind'] not in ('spend_budget_decision_ready', 'decision_retained',
+                                             'decision_protected_stopped')), None))
+    deps, missing = _dependencies(reader, tid)
+    episode = (stop['data'].get('episode') or stop['data'].get('episode_uid') or reader.uid(stop)) if stop else None
+    episode = episode if isinstance(episode, str) and episode else None
+    root = next((e for e in events if reader.uid(e) == episode), stop) if episode else stop
+    admin, next_action = _administration(reader, events, episode) if stop else (None, {})
+    stop_data = stop['data'] if stop else {}
+    cause = stop_data.get('cause')
+    cause = cause if isinstance(cause, str) and cause.strip() else 'spend_budget'
+    facts = {'task': task, 'stop': {**stop_data, 'cause': cause} if stop else None,
+             'stop_episode': episode, 'dependencies': deps,
+             'administrative_owner': admin, 'next_action': next_action,
+             'source_uid': reader.uid(source) if source else None,
+             'source_at': ((root if stop else source) or {}).get('created_at'),
+             'source_refs': [reader.uid(source)] if source and reader.uid(source) else [],
+             'deadline_at': next_action.get('escalate_at') or record(next_action.get('escalation')).get('at'),
+             'containment': task.get('containment_episode'), 'pending_command': reader.pending(tid),
+             'human_step': _human_step(task.get('human_request')),
+             'unknown': reader.synced or reader.partial or missing or bool(receipt_only) or bool(source and not reader.uid(source))
+                        or bool(task.get('human_request') and not _human_step(task['human_request']))}
+    if schedule:
+        facts.update(wake_at=schedule['data'].get('wake_at'), awaiting=record(schedule['data'].get('awaiting')))
+    wake_columns = reader.columns('task_wake_checks')
+    if {'task_id', 'cmd'} <= wake_columns:
+        probe = conn.execute('SELECT cmd FROM task_wake_checks WHERE task_id=?', (tid,)).fetchone()
+        facts['probe'] = probe[0] if probe else None
+    run_columns = reader.columns('task_runs')
+    facts['run_evidence_known'] = {'id', 'task_id', 'status', 'ended_at'} <= run_columns and 'current_run_id' in task
+    if facts['run_evidence_known'] and task.get('current_run_id') is not None:
+        runs = reader.rows('SELECT * FROM task_runs WHERE id=? AND task_id=?', (task['current_run_id'], tid))
+        facts['run'] = runs[0] if runs else None
+    facts['unknown'] |= bool(stop and not episode)
+    return project(facts, now=int(time.time()) if now is None else now)
