diff --git a/.github/actions/fetch-merge-base/action.yml b/.github/actions/fetch-merge-base/action.yml
new file mode 100644
index 00000000000..8abe4084bf5
--- /dev/null
+++ b/.github/actions/fetch-merge-base/action.yml
@@ -0,0 +1,43 @@
+name: Fetch the merge base
+description: >-
+  After a default (depth 1) checkout, fetch the complete commit history of HEAD and one base
+  revision, commits only (--filter=tree:0, no other heads, no tags), and output their merge base.
+  It replaces `fetch-depth: 0`, which on this ~1 GB fork fetched all ~500 heads, every tag and
+  every blob: 2-3 min on a good ci-fast runner and past the job timeout on slow ones, failing the
+  required aggregate. The history is complete, so merge-base, `base..HEAD` ranges and
+  `git log --author` answer exactly as on a full clone. Trees and blobs of other commits are fetched
+  lazily on first use (git diff / archive / worktree), which needs credentials: keep the
+  checkout's default persist-credentials, or pass a token to those commands yourself. Use it
+  right after actions/checkout (default fetch-depth) with `base` set to the PR's base branch;
+  the merge base is in `steps.<id>.outputs.sha`.
+
+inputs:
+  base:
+    description: Branch name (fetched to refs/remotes/origin/<base>) or a 40-hex commit.
+    required: true
+  head:
+    description: Revision in the checkout, or a 40-hex commit to fetch. Default HEAD.
+    default: HEAD
+  token:
+    description: Token for the fetch when the checkout did not persist credentials.
+    default: ${{ github.token }}
+
+outputs:
+  sha:
+    description: The merge base of base and head; empty when the histories are unrelated.
+    value: ${{ steps.fetch.outputs.sha }}
+
+runs:
+  using: composite
+  steps:
+    - id: fetch
+      shell: bash
+      env:
+        _BASE: ${{ inputs.base }}
+        _HEAD: ${{ inputs.head }}
+        FETCH_TOKEN: ${{ inputs.token }}
+      run: |
+        set -euo pipefail
+        sha=$("$GITHUB_ACTION_PATH/fetch-merge-base.sh" "$_BASE" "$_HEAD")
+        echo "Merge base of ${_BASE} and ${_HEAD}: ${sha:-<none: unrelated histories>}"
+        echo "sha=${sha}" >> "$GITHUB_OUTPUT"
diff --git a/.github/actions/fetch-merge-base/fetch-merge-base.sh b/.github/actions/fetch-merge-base/fetch-merge-base.sh
new file mode 100755
index 00000000000..354d4e5232a
--- /dev/null
+++ b/.github/actions/fetch-merge-base/fetch-merge-base.sh
@@ -0,0 +1,58 @@
+#!/usr/bin/env bash
+# Fetch the full commit graph of HEAD and one base revision, commits only, and print their
+# merge base (empty when the histories are unrelated). See action.yml for why.
+#
+#   fetch-merge-base.sh <base> [<head>]
+#     base  a branch name (fetched to refs/remotes/origin/<base>) or a 40-hex commit
+#     head  a revision already in the repo, or a 40-hex commit to fetch; default HEAD
+#
+# FETCH_TOKEN (optional) authenticates https://github.com remotes when the checkout did not
+# persist credentials. Exit status is non-zero only when the fetch itself fails.
+set -euo pipefail
+
+base=${1:?usage: fetch-merge-base.sh <base> [<head>]}
+head=${2:-HEAD}
+
+is_sha() { [[ $1 =~ ^[0-9a-f]{40}$ ]]; }
+
+if is_sha "$head"; then
+  head_sha=$head
+else
+  head_sha=$(git rev-parse --verify "${head}^{commit}")
+fi
+if is_sha "$base"; then
+  base_spec=$base
+  base_rev=$base
+else
+  base_spec="+refs/heads/${base}:refs/remotes/origin/${base}"
+  base_rev="refs/remotes/origin/${base}"
+fi
+
+git_auth=()
+url=$(git remote get-url origin)
+if [[ -n ${FETCH_TOKEN:-} && $url == https://github.com/* ]] \
+   && ! git config --get-regexp '^http\..*\.extraheader$' >/dev/null 2>&1; then
+  basic=$(printf 'x-access-token:%s' "$FETCH_TOKEN" | base64 | tr -d '\n')
+  git_auth=(-c "http.https://github.com/.extraheader=AUTHORIZATION: basic ${basic}")
+fi
+
+# tree:0 = commit objects only: the whole history of both sides is tens of MB, where the
+# full-history checkout it replaces pulled every head, tag, tree and blob of the repo. The repo
+# becomes a partial clone, so a later diff/archive/worktree of the merge base lazily fetches that
+# commit's trees and blobs (credentials must reach those commands too).
+depth_args=()
+if [[ $(git rev-parse --is-shallow-repository) == true ]]; then
+  depth_args=(--unshallow)
+fi
+start=$SECONDS
+git "${git_auth[@]}" fetch --quiet --no-tags --no-recurse-submodules --filter=tree:0 \
+  "${depth_args[@]}" origin "$head_sha" "$base_spec"
+echo "fetch-merge-base: fetched ${base_rev} and ${head_sha} history in $((SECONDS - start))s" >&2
+
+# Exit 1 with no output is "no common ancestor"; anything else (a missing object) is an error,
+# never a silent "unrelated".
+rc=0
+git merge-base "$base_rev" "$head_sha" || rc=$?
+if (( rc > 1 )); then
+  exit "$rc"
+fi
