From da4cba6943715d1daad656cbd44be2c47ff9adc1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 02:13:23 +0000
Subject: [PATCH] nightly e2e: report marker never relabels production main;
 production creates drop inherited worker task

---
 scripts/ci/flaky_kanban.py   |  3 +++
 scripts/ci/nightly_e2e.py    |  5 +++--
 tests/ci/test_nightly_e2e.py | 37 ++++++++++++++++++++++++++++++++----
 3 files changed, 39 insertions(+), 6 deletions(-)

diff --git a/scripts/ci/flaky_kanban.py b/scripts/ci/flaky_kanban.py
index e54f72e4f9d..1fcd4275a81 100644
--- a/scripts/ci/flaky_kanban.py
+++ b/scripts/ci/flaky_kanban.py
@@ -87,6 +87,9 @@ class CliBoard:
              extra_env: dict[str, str] | None = None) -> str:
         scope = ["--board", board] if board else []
         env = {**os.environ, **extra_env} if extra_env else None
+        if args[:1] == ("create",) and not (extra_env and "HERMES_KANBAN_TASK" in extra_env):
+            # A production create must not inherit a running worker's task as creator_task_id.
+            env = {k: v for k, v in (env or os.environ).items() if k != "HERMES_KANBAN_TASK"}
         proc = subprocess.run([*self.hermes, "kanban", *scope, *args], input=stdin, capture_output=True,
                               text=True, timeout=120, check=False, env=env)
         if proc.returncode == 2 and args[0] == "create":
diff --git a/scripts/ci/nightly_e2e.py b/scripts/ci/nightly_e2e.py
index d918a60de51..06c937b095f 100644
--- a/scripts/ci/nightly_e2e.py
+++ b/scripts/ci/nightly_e2e.py
@@ -556,7 +556,8 @@ def report(
     out: list[str] = []
     still: list[dict[str, Any]] = []
     for entry in list(state["pending"]):
-        if acceptance and not entry.get("acceptance_marker"):  # label runs recorded before the flag existed
+        # Label runs recorded before the flag existed, but never a production-main run: that incident stays real.
+        if acceptance and not entry.get("acceptance_marker") and entry.get("ref") != "main":
             entry["acceptance_marker"], entry["acceptance_owner"] = acceptance
         try:
             done, msg = _settle(gh, board, state, entry, now=now)
@@ -609,7 +610,7 @@ def main(argv: list[str] | None = None) -> int:
     ap.add_argument(
         "--acceptance-marker",
         help="mark every card for these runs as an acceptance fixture (not a production incident); "
-        "needs --acceptance-owner-task. report: also labels pending runs dispatched without a marker",
+        "needs --acceptance-owner-task. report: also labels pending non-main-ref runs dispatched without a marker",
     )
     ap.add_argument(
         "--acceptance-owner-task",
diff --git a/tests/ci/test_nightly_e2e.py b/tests/ci/test_nightly_e2e.py
index 31926f06c77..f55644998e4 100644
--- a/tests/ci/test_nightly_e2e.py
+++ b/tests/ci/test_nightly_e2e.py
@@ -225,7 +225,7 @@ def test_alert_intent_survives_dispatch_and_report_cli(tmp_path, monkeypatch, re
 def test_report_marker_labels_legacy_pending_acceptance(tmp_path, monkeypatch, outcome):
     gh, board, path = FakeGitHub(), FakeBoard(), tmp_path / "state.json"
     gh.auto_create = outcome != "missing"
-    _seed(path, gh, time.time() - 5 * 3600)
+    _seed(path, gh, time.time() - 5 * 3600, ref="29953696677a")
     if outcome in ("failure", "cancelled"):
         gh.finish(100, outcome, _log("tests/e2e/a.py::t"))
     elif outcome == "error":
@@ -235,12 +235,25 @@ def test_report_marker_labels_legacy_pending_acceptance(tmp_path, monkeypatch, o
     monkeypatch.setattr(ne, "NightlyBoard", lambda *a: board)
     assert ne.main(["report", "--state", str(path), "--acceptance-marker", "legacy-check", "--acceptance-owner-task", OWNER]) == 0
     card = board.cards["t_1"]
-    assert "ACCEPTANCE" in card["title"] and "main" in card["title"]
+    assert "ACCEPTANCE" in card["title"] and "29953696677a" in card["title"]
     assert "legacy-check" in card["body"]
     assert "acceptance fixture; do not repair main" in card["body"]
     assert "Fix main" not in card["body"]
 
 
+def test_report_marker_never_relabels_pending_production_main(tmp_path, monkeypatch):
+    gh, board, path = FakeGitHub(), FakeBoard(), tmp_path / "state.json"
+    _seed(path, gh, time.time() - 5 * 3600)
+    gh.finish(100, "failure", _log("tests/e2e/a.py::t"))
+    monkeypatch.setenv("GH_TOKEN", "x")
+    monkeypatch.setattr(ne, "RestGitHub", lambda *a: gh)
+    monkeypatch.setattr(ne, "NightlyBoard", lambda *a: board)
+    assert ne.main(["report", "--state", str(path), "--acceptance-marker", "m", "--acceptance-owner-task", OWNER]) == 0
+    card = board.cards["t_1"]
+    assert "ACCEPTANCE" not in card["title"] and "Fix main" in card["body"]
+    assert card["creator_task_id"] is None
+
+
 def test_acceptance_and_historical_runs_do_not_update_production_cards(env):
     gh, board, state = env
     for i, (ref, marker) in enumerate([("main", ""), ("29953696677a", ""), ("main", "scope-check")]):
@@ -418,9 +431,9 @@ def test_board_failure_past_deadline_keeps_run_pending_and_says_so(env):
     assert state["pending"] == [] and len(board.cards) == 1
 
 
-def _seed(path, gh, dispatched_at):
+def _seed(path, gh, dispatched_at, ref="main"):
     with ne.locked_state(path) as state:
-        _dispatch(gh, state, now=dispatched_at)
+        _dispatch(gh, state, ref=ref, now=dispatched_at)
 
 
 @pytest.mark.platforms("posix")
@@ -572,3 +585,19 @@ def test_nightly_board_stamps_creator_only_for_acceptance(monkeypatch):
     board.create("t", "b", "k")
     board.create("t", "b", "k", creator_task_id=OWNER)
     assert envs == [None, {"HERMES_KANBAN_TASK": OWNER}]
+
+
+def test_cli_create_env_only_carries_worker_task_in_acceptance(monkeypatch):
+    seen = []
+
+    def fake_run(cmd, **kw):
+        seen.append(kw["env"])
+        return subprocess.CompletedProcess(cmd, 0, '{"id":"t_x"}', "")
+
+    monkeypatch.setenv("HERMES_KANBAN_TASK", "t_ffffffffffffffff")
+    monkeypatch.setattr(subprocess, "run", fake_run)
+    board = ne.NightlyBoard("hermes")
+    board.create("t", "b", "k")
+    board.create("t", "b", "k", creator_task_id=OWNER)
+    assert "HERMES_KANBAN_TASK" not in seen[0]
+    assert seen[1]["HERMES_KANBAN_TASK"] == OWNER
-- 
2.55.0

