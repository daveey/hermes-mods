From 8bcc20d517216a3164bcae0cdf6a841351763ac3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 04:47:10 +0000
Subject: [PATCH] fix(kanban): annotate only appended remote session rows
 [daveey]

append_remote_listed_cards walked the mixed local+remote list against
the replica, so a lagging blocked parent overwrote a locally done
parent. Collect remote rows and pass those. Quote replica file URIs
with Path.as_uri().

Proof: test_stale_replica_does_not_override_local_parent_status failed
on the mixed walk then passed; 88 focused tests green; health clean.
---
 .../kanban_session_activity_card_details.py   |  4 +--
 hermes_cli/kanban_session_outcome_tasks.py    |  4 ++-
 .../test_kanban_blocked_upstream_details.py   | 35 +++++++++++++++++++
 3 files changed, 40 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_session_activity_card_details.py b/hermes_cli/kanban_session_activity_card_details.py
index 6770b5f760..5d25bb92b9 100644
--- a/hermes_cli/kanban_session_activity_card_details.py
+++ b/hermes_cli/kanban_session_activity_card_details.py
@@ -83,7 +83,7 @@ def _replica_for(conn: sqlite3.Connection) -> sqlite3.Connection | None:
         path = shadow_path(board_slug_for_path(key))
         if not path.is_file() or Path(key).resolve() == path.resolve():
             return None
-        replica = connect(f"file:{path}?mode=ro", uri=True, timeout=5)
+        replica = connect(path.resolve().as_uri() + "?mode=ro", uri=True, timeout=5)
         replica.row_factory = sqlite3.Row
         return replica
     except (OSError, TypeError, ValueError, sqlite3.Error):
@@ -236,7 +236,7 @@ def annotate_remote_upstream(cards: list[dict[str, Any]]) -> None:
             path = shadow_path(board)
             if not path.is_file():
                 continue
-            replica = connect(f"file:{path}?mode=ro", uri=True, timeout=5)
+            replica = connect(path.resolve().as_uri() + "?mode=ro", uri=True, timeout=5)
             replica.row_factory = sqlite3.Row
             _add_blocked_upstream(replica, found)
         except (OSError, TypeError, ValueError, sqlite3.Error):
