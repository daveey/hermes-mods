From 6c3ee405e68ac621b1bcf7599d6df089c6d7ba72 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 5 Nov 2026 11:39:10 -0800
Subject: [PATCH] [daveey] Backport bootstrap test environment psutil
 dependency

Backport upstream bd312c903ea42763a535a5ac034ef132fad1a5d2 while preserving the fork pytest pin. PR900 installer tests passed but global teardown lacked psutil; keep real process cleanup and all behavior assertions enabled.
---
 .github/workflows/bootstrap-installer.yml | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/bootstrap-installer.yml b/.github/workflows/bootstrap-installer.yml
index 4aec9dc6b62..601946cebd3 100644
--- a/.github/workflows/bootstrap-installer.yml
+++ b/.github/workflows/bootstrap-installer.yml
@@ -125,7 +125,8 @@ jobs:
 
       - name: Prepare isolated acceptance-test dependencies
         shell: bash
-        run: python -m scripts.ci.python_packages pytest==9.0.3 pytest-asyncio==1.3.0 ruamel.yaml==0.18.17 packaging==26.0
+        # psutil: tests/conftest.py's session-end daemon reaper reads process environments with it.
+        run: python -m scripts.ci.python_packages pytest==9.0.3 pytest-asyncio==1.3.0 ruamel.yaml==0.18.17 packaging==26.0 psutil==7.2.2
 
       - name: Current installer to PM worker to published command
         shell: bash
-- 
2.55.0

