index 0000000000..edfd00e54a
--- /dev/null
+++ b/tests/tui_gateway/test_remote_projection_withdrawal.py
@@ -0,0 +1,82 @@
+"""Frozen withdrawal recipients remain relevant to compact observation lanes. [daveey]"""
+import json
+import sqlite3
+
+import pytest
+
+from hermes_cli.kanban_replica_relevance import is_bystander
+from hermes_state import SessionDB
+from tests.tui_gateway.test_kanban_remote_arrival import _hub
+from tests.tui_gateway.test_kanban_remote_notices import CHAT, _card
+from tests.tui_gateway.test_remote_projection_bystander_memory import NOW, _opener
+from tui_gateway import kanban_remote_notices as remote
+from tui_gateway import kanban_remote_observations as obs
+
+
+def _withdrawal():
+    card = _card("t_frozen", CHAT, status="archived", at=NOW - 60)
+    task = card["task"]
+    task["sessions"] = []
+    task["withdrawal_notice"] = dict(kind="request_withdrawn", event_id=42, created_at=NOW - 60)
+    task["withdrawal_recipients"] = [dict(gw="macbook", profile="default", session=CHAT)]
+    return card
+
+
+def _arrive(replica, card):
+    with sqlite3.connect(replica) as conn:
+        conn.execute("INSERT INTO replica VALUES ('hub','tasks',?,?,101)",
+                     (card["key"], json.dumps(card["task"])))
+        conn.execute("UPDATE meta SET v='101' WHERE k IN ('cursor', 'head')")
+
+
+def test_frozen_recipient_observation_preserves_first_seen_across_cache_and_restart(tmp_path):
+    card = _withdrawal()
+    assert is_bystander(card["task"], card["key"], "macbook", ())
+    assert remote._linked_chats(card["task"], "macbook") == [("default", CHAT)]
+    replica = _hub(tmp_path, [])
+    ledger = tmp_path / "ledger.db"
+    remote._reset_for_tests()
+    assert obs.observe(replica, ledger, NOW - 60) == {}
+    assert remote.collect(CHAT, "default", hub_db=replica, ledger=ledger, now=NOW - 60) == []
+    _arrive(replica, card)
+    identity = ("hub", card["key"], "request_withdrawn@42")
+    observed = obs.observe(replica, ledger, NOW)
+    assert observed == {identity: NOW}
+    assert observed.first_seen == {identity: NOW}
+    first = remote.collect(CHAT, "default", hub_db=replica, ledger=ledger, now=NOW + 1)
+    assert len(first) == 1 and not first[0]["text"].startswith("Late notices")
+    assert remote.release(first[0], ledger=ledger)
+    warm = obs.observe(replica, ledger, NOW + remote.FRESH_S + 1)
+    assert warm == observed and warm.first_seen == {identity: NOW}
+    remote._reset_for_tests()
+    restarted = obs.observe(replica, ledger, NOW + remote.FRESH_S + 2)
+    assert restarted == observed and restarted.first_seen == {identity: NOW}
+    late = remote.collect(CHAT, "default", hub_db=replica, ledger=ledger, now=NOW + remote.FRESH_S + 3)
+    assert len(late) == 1 and late[0]["text"].startswith("Late notices")
+    assert remote.release(late[0], ledger=ledger)
+    assert remote.collect(CHAT, "default", hub_db=replica, ledger=ledger,
+                          now=NOW + remote.LATE_MAX_S + 1) == []
+
+
+@pytest.mark.parametrize("bad_field", [None, "gw", "profile", "session"])
+def test_frozen_recipient_downstream_delivery_and_malformed_controls(tmp_path, bad_field):
+    card = _withdrawal()
+    if bad_field:
+        card["task"]["withdrawal_recipients"][0][bad_field] = ["invalid"]
+    replica = _hub(tmp_path, [])
+    ledger = tmp_path / "ledger.db"
+    remote._reset_for_tests()
+    obs.observe(replica, ledger, NOW - 60)
+    _arrive(replica, card)
+    with SessionDB(tmp_path / "state.db") as db:
+        db.create_session(CHAT, "desktop")
+        delivered = remote.sweep_remote_notices(replica_path=replica, gateway="macbook",
+                                                session_db=_opener(db), ledger=ledger, now=NOW)
+        messages = db.get_messages(CHAT)
+        assert len(delivered) == len(messages) == (0 if bad_field else 1)
+        if not bad_field:
+            assert "request withdrawn" in messages[0]["content"]
+        remote._reset_for_tests()
+        assert remote.sweep_remote_notices(replica_path=replica, gateway="macbook",
+                                           session_db=_opener(db), ledger=ledger, now=NOW + 1) == []
+        assert remote.collect(CHAT, "default", hub_db=replica, ledger=ledger, now=NOW + 2) == []
