From 3be1dc41d096d60717a4d121df0627fdd3380498 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 19:34:49 +0000
Subject: [PATCH] test(gateway): port upstream kanban/turn tests onto fork
 gates

- dir-workspace kanban tests (finite admission, custom launch route, recovery probe) give the
  assignee the profile capabilities the fork's kanban_capabilities gate requires.
- fallback_failure_details: the stub runner/ctx carry the adapter lookup and session_id upstream's
  run_sync policy scope now reads.
---
 tests/gateway/fixtures/kanban_recovery_probe.py           | 4 ++++
 .../test_bare_custom_launch_keeps_profile_route.py        | 4 ++++
 tests/gateway/test_fallback_failure_details.py            | 6 ++++--
 tests/gateway/test_kanban_finite_admission.py             | 8 ++++++++
 4 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/tests/gateway/fixtures/kanban_recovery_probe.py b/tests/gateway/fixtures/kanban_recovery_probe.py
index 53873b76c5b..0a49e1d1bb7 100644
--- a/tests/gateway/fixtures/kanban_recovery_probe.py
+++ b/tests/gateway/fixtures/kanban_recovery_probe.py
@@ -48,6 +48,10 @@ def main():
            'auxiliary': {'title_generation': {'enabled': False}},
            'platform_toolsets': {'cli': []}, 'kanban': {'dispatch_in_gateway': False}}
     (owner / 'config.yaml').write_text(json.dumps(cfg))
+    # Fork: dir workspaces need terminal/file/host_repo in the assignee's profile policy; that gate
+    # (hermes_cli.kanban_capabilities) is not what this recovery probe covers.
+    import hermes_cli.kanban_capabilities as kanban_capabilities
+    kanban_capabilities._profile_capabilities = lambda name: {'terminal', 'file', 'git', 'host_repo', 'kanban'}
     env = dict(os.environ, HERMES_HOME=str(owner), OPENAI_API_KEY='loopback-only', OPENAI_BASE_URL=url)
     # Already-running owner deliberately has no dispatcher-specific board overrides.
     for key in list(env):
diff --git a/tests/gateway/test_bare_custom_launch_keeps_profile_route.py b/tests/gateway/test_bare_custom_launch_keeps_profile_route.py
index 8b895dada4e..0d10fb224e7 100644
--- a/tests/gateway/test_bare_custom_launch_keeps_profile_route.py
+++ b/tests/gateway/test_bare_custom_launch_keeps_profile_route.py
@@ -128,6 +128,10 @@ def test_a_kanban_custom_provider_override_stays_on_the_profiles_endpoint(tmp_pa
     monkeypatch.setenv('HERMES_HOME', str(tmp_path))
     monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
     monkeypatch.setattr('hermes_cli.profiles.resolve_profile_env', lambda name: str(tmp_path))
+    # Fork: dir workspaces need terminal/file/host_repo in the assignee's profile policy; that gate
+    # (hermes_cli.kanban_capabilities) is not what this upstream test covers, so the assignee has them.
+    monkeypatch.setattr('hermes_cli.kanban_capabilities._profile_capabilities',
+                        lambda name: {'terminal', 'file', 'git', 'host_repo', 'kanban'})
     kb.create_board('owned')
     with closing(connect(board='owned')) as conn:
         task_id = kb.create_task(conn, title='t', assignee='default', workspace_kind='dir',
diff --git a/tests/gateway/test_fallback_failure_details.py b/tests/gateway/test_fallback_failure_details.py
index 89a86e15658..ef166c97db6 100644
--- a/tests/gateway/test_fallback_failure_details.py
+++ b/tests/gateway/test_fallback_failure_details.py
@@ -18,11 +18,13 @@ def test_gateway_reply_includes_failed_fallback(monkeypatch):
     ])
     wrapped = RuntimeError(str(chain))
     wrapped.__cause__ = chain
-    runner = SimpleNamespace(_resolve_session_agent_runtime=Mock(side_effect=wrapped))
+    # Upstream's run_sync resolves the source's session policy first (d8835ab3a8b7); no adapter here.
+    runner = SimpleNamespace(_resolve_session_agent_runtime=Mock(side_effect=wrapped),
+                             _adapter_for_source=lambda source: None)
     turn = object.__new__(TurnRunner)
     turn._runner = runner
     turn._ctx = SimpleNamespace(source=SimpleNamespace(platform=Platform.LOCAL),
-                                session_key='test-session', user_config={})
+                                session_key='test-session', session_id='test-session', user_config={})
     monkeypatch.setattr(turn, '_combined_ephemeral_prompt', lambda: '')
     monkeypatch.setattr(run, '_current_max_iterations', lambda: 10)
     result = turn.run_sync()
diff --git a/tests/gateway/test_kanban_finite_admission.py b/tests/gateway/test_kanban_finite_admission.py
index c9d524ddc1b..8486fc1da83 100644
--- a/tests/gateway/test_kanban_finite_admission.py
+++ b/tests/gateway/test_kanban_finite_admission.py
@@ -19,6 +19,10 @@ def test_kanban_submission_enters_single_query_approval_context(tmp_path, monkey
     for name in ('HERMES_KANBAN_DB', 'HERMES_DELEGATED_CHILD', 'HERMES_SINGLE_QUERY_SESSION'):
         monkeypatch.delenv(name, raising=False)
     monkeypatch.setattr('hermes_cli.profiles.resolve_profile_env', lambda name: str(tmp_path))
+    # Fork: dir workspaces need terminal/file/host_repo in the assignee's profile policy; that gate
+    # (hermes_cli.kanban_capabilities) is not what this upstream test covers, so the assignee has them.
+    monkeypatch.setattr('hermes_cli.kanban_capabilities._profile_capabilities',
+                        lambda name: {'terminal', 'file', 'git', 'host_repo', 'kanban'})
     workspace = tmp_path / 'workspace'
     workspace.mkdir()
     kb.create_board('owned')
@@ -80,6 +84,10 @@ def kanban_owner(tmp_path, monkeypatch):
         monkeypatch.delenv(name, raising=False)
     monkeypatch.setattr(run, '_hermes_home', tmp_path)
     monkeypatch.setattr('hermes_cli.profiles.resolve_profile_env', lambda name: str(tmp_path))
+    # Fork: dir workspaces need terminal/file/host_repo in the assignee's profile policy; that gate
+    # (hermes_cli.kanban_capabilities) is not what this upstream test covers, so the assignee has them.
+    monkeypatch.setattr('hermes_cli.kanban_capabilities._profile_capabilities',
+                        lambda name: {'terminal', 'file', 'git', 'host_repo', 'kanban'})
 
     def build(config):
         (tmp_path / 'config.yaml').write_text(json.dumps(config))
