From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 17:21:28 +0000
Subject: [PATCH] [daveey] bind session profile scope for post-turn outcome
 refresh

---
 .../test_turn_outcome_secret_scope.py         | 67 +++++++++++++++++++
 tui_gateway/turn_outcome.py                   |  5 +-
 2 files changed, 71 insertions(+), 1 deletion(-)
 create mode 100644 tests/tui_gateway/test_turn_outcome_secret_scope.py

diff --git a/tests/tui_gateway/test_turn_outcome_secret_scope.py b/tests/tui_gateway/test_turn_outcome_secret_scope.py
new file mode 100644
index 00000000000..29322310b1d
--- /dev/null
+++ b/tests/tui_gateway/test_turn_outcome_secret_scope.py
@@ -0,0 +1,67 @@
+"""Post-turn refresh owns its credential scope after the turn released its own."""
+from __future__ import annotations
+
+import contextvars
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+
+import hermes_state_outcome as so
+from agent import secret_scope
+from hermes_constants import get_hermes_home
+from tui_gateway import server
+from tui_gateway.turn_outcome import refresh_turn_outcome
+from tests.tui_gateway import test_turn_outcome_refresh as helpers
+
+# Reuse the real store and hook-cleanup fixture, not a fake derivation.
+db = helpers.db
+
+
+@pytest.mark.parametrize("foreign", [False, True])
+@pytest.mark.parametrize("judge_fails", [False, True])
+def test_post_turn_refresh_scopes_judge_and_restores_caller(monkeypatch, tmp_path, db, foreign, judge_fails):
+    home = tmp_path / ("foreign" if foreign else "launch")
+    home.mkdir()
+    (home / ".env").write_text("ANTHROPIC_TOKEN=fixture-owner\n", encoding="utf-8")
+    monkeypatch.setattr(server, "_launch_home", lambda: home)
+    monkeypatch.setattr(server, "_get_db", lambda: db)
+    # Store selection has separate coverage; keep both profiles in this owned fixture store.
+    from contextlib import nullcontext
+    monkeypatch.setattr(server, "_session_db", lambda session: nullcontext(db))
+    monkeypatch.setenv("ANTHROPIC_TOKEN", "fixture-wrong-process")
+    monkeypatch.setattr(secret_scope, "_MULTIPLEX_ACTIVE", True)
+    token = secret_scope.set_secret_scope(None)
+    seen = []
+
+    def credential_read():
+        value = secret_scope.get_secret("ANTHROPIC_TOKEN")
+        seen.append((value, get_hermes_home()))
+        if judge_fails:
+            raise RuntimeError("controlled judge failure")
+        return True
+
+    def judge(sid, text, **kwargs):
+        # Same context-copy/thread boundary as session-outcome._with_budget.
+        ctx = contextvars.copy_context()
+        with ThreadPoolExecutor(max_workers=1) as pool:
+            return pool.submit(ctx.run, credential_read).result()
+
+    db.create_session("post-turn", source="desktop")
+    db.append_message("post-turn", role="user", content="finish the check")
+    db.append_message("post-turn", role="assistant", content=helpers.SUMMARY)
+    so.register_outcome_judge(judge)
+    try:
+        with pytest.raises(secret_scope.UnscopedSecretError):
+            secret_scope.get_secret("ANTHROPIC_TOKEN")
+        before_home = get_hermes_home()
+        refresh_turn_outcome({"session_key": "post-turn", "profile_home": str(home) if foreign else None})
+        assert seen == [("fixture-owner", home)]
+        assert secret_scope.current_secret_scope() is None
+        assert get_hermes_home() == before_home
+        with pytest.raises(secret_scope.UnscopedSecretError):
+            secret_scope.get_secret("ANTHROPIC_TOKEN")
+        stored = so.get_outcome("post-turn", db=db)
+        assert stored is not None
+        assert bool(stored.get("judged")) is not judge_fails
+    finally:
+        secret_scope.reset_secret_scope(token)
diff --git a/tui_gateway/turn_outcome.py b/tui_gateway/turn_outcome.py
index 7a608bbb2c6..bfddc9f6705 100644
--- a/tui_gateway/turn_outcome.py
+++ b/tui_gateway/turn_outcome.py
@@ -21,7 +21,10 @@ def refresh_turn_outcome(session: dict, agent=None) -> None:
         from hermes_state_outcome import refresh_outcome
         from tui_gateway import server  # split helpers only work rebound onto server globals (bind_module)
 
-        with server._session_db(session) as db:
+        # The turn has already released its secret scope (the home override alone
+        # still exists). Outcome judges may call a provider, including on copied-
+        # context threads: bind the owning session's full runtime scope again.
+        with server._session_profile_runtime_scope(session), server._session_db(session) as db:
             if db is not None:
                 refresh_outcome(sid, "turn_end", db=db)
     except Exception:  # health: allow BLE001 -- the turn already concluded; a failed refresh is logged
