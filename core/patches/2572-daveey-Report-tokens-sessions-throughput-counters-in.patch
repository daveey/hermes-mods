From 74ece72c13ebed4450eb1c8ddd6f9b98691ebad3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 07:10:32 +0000
Subject: [PATCH] [daveey] Report tokens/sessions throughput counters in
 machine metrics

collect() now adds four cumulative counters summed over every profile's
state.db on the host (root + profiles/*/state.db), for the Board's
throughput panel:

- tokens_io_total / tokens_cache_total from session_model_usage
  (input+output, cache read+write). Its main-turn rows match sessions'
  totals; its other rows are auxiliary calls (compression, titles, coach,
  approval ...) that sessions never counts, ~12% of the hub's tokens.
  A db without the table falls back to the sessions columns.
- sessions_started_total / sessions_ended_total = count(*), count(ended_at).

Read-only URI connections, 1 s busy timeout, result cached 60 s; any
unreadable db (or none at all) omits all four, never reports 0. Hub cost:
~36 ms warm / ~320 ms cold over all 12 profiles (10.8 GB, 22,380-session
root state.db).

A Board older than hermes-hub 30d2261 rejects the whole report with 400
"unknown field(s): ...". send_compatible() then retries without the
counters (and the CPU busy sample, which is never resent), keeping drain
fields, and the Reporter stops sending counters for UNSUPPORTED_RETRY_S.
---
 hermes_cli/machine_drain_metrics.py      |  20 +++-
 hermes_cli/machine_metrics.py            |  15 ++-
 hermes_cli/machine_throughput_metrics.py |  86 ++++++++++++++
 tests/hermes_cli/test_machine_metrics.py | 145 ++++++++++++++++++++++-
 4 files changed, 259 insertions(+), 7 deletions(-)
 create mode 100644 hermes_cli/machine_throughput_metrics.py

diff --git a/hermes_cli/machine_drain_metrics.py b/hermes_cli/machine_drain_metrics.py
index 6323600501..2310304793 100644
--- a/hermes_cli/machine_drain_metrics.py
+++ b/hermes_cli/machine_drain_metrics.py
@@ -36,16 +36,30 @@ def collect():
 ADDITIVE_FIELDS = ("drain_active", "drain_until_ms", "cpu_busy_pct", "cpu_busy_window_ms", "cpu_busy_sample_end_ms")
 
 
-def send_compatible(send, sample):
+def send_compatible(send, sample, on_counters_rejected=None):
     """Old Boards reject unknown metrics atomically; retry once with every additive field removed.
 
     Only a 400 on a sample that carried an additive field is retried; any other error (timeouts included) is raised
-    and the sample is dropped. An unrelated validation error simply fails again on the retry and is raised."""
+    and the sample is dropped. An unrelated validation error simply fails again on the retry and is raised.
+
+    Throughput counters (``machine_throughput_metrics.FIELDS``) are newer still: a Board that predates them answers
+    400 "unknown field(s): ...". That answer first drops just the counters (calling ``on_counters_rejected`` so the
+    caller stops sending them for a while) and the CPU busy fields, keeping drain fields for a Board that accepts
+    those."""
     from hermes_cli.kanban_sync_client import HubError
+    from hermes_cli.machine_throughput_metrics import FIELDS as COUNTERS
 
     try:
         return send(sample)
     except HubError as exc:
-        if exc.status != 400 or not any(k in sample for k in ADDITIVE_FIELDS):
+        if exc.status != 400:
+            raise
+        if any(k in sample for k in COUNTERS) and "unknown field" in str(exc):
+            if on_counters_rejected is not None:
+                on_counters_rejected()
+            # CPU busy fields are never resent (above), on this retry either.
+            from hermes_cli.machine_cpu_metrics import FIELDS as CPU
+            return send_compatible(send, {k: v for k, v in sample.items() if k not in COUNTERS and k not in CPU})
+        if not any(k in sample for k in ADDITIVE_FIELDS):
             raise
         return send({k: v for k, v in sample.items() if k not in ADDITIVE_FIELDS})
