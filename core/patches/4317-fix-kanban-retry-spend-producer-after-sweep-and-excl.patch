From 6369c6fb7a25654acea4fcdfcf2ff1b1f6816b87 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:35:45 +0000
Subject: [PATCH] fix(kanban): retry spend producer after sweep and exclude
 observers [daveey]

---
 hermes_cli/kanban_spend_decision.py               |  4 +++-
 hermes_cli/kanban_triage_sweep.py                 |  2 +-
 tests/hermes_cli/test_kanban_spend_budget_hold.py | 15 ++++++++++++---
 3 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_spend_decision.py b/hermes_cli/kanban_spend_decision.py
index 94775fb4c8..8b2e2f75c1 100644
--- a/hermes_cli/kanban_spend_decision.py
+++ b/hermes_cli/kanban_spend_decision.py
@@ -83,7 +83,9 @@ def producer(conn, task_id: str, note: str) -> dict:
         if not is_headless_session(chat_id):
             local = gw == own and profile == get_active_profile_name()
             bind("tui" if local else "hub", session if local else chat_id)
-    if conn.execute("SELECT 1 FROM kanban_notify_subs WHERE task_id=? LIMIT 1", (task_id,)).fetchone():
+    from hermes_cli.kanban_db_notify import _owning_sub_clause
+    if conn.execute("SELECT 1 FROM kanban_notify_subs s JOIN tasks p ON p.id=s.task_id "
+                    f"WHERE s.task_id=? AND {_owning_sub_clause()} LIMIT 1", (task_id,)).fetchone():
         return {"kind": "chats"}
     episode = conn.execute("SELECT COALESCE(MAX(id),0) FROM task_events WHERE task_id=?", (task_id,)).fetchone()[0]
     sup = kb.create_task(
diff --git a/hermes_cli/kanban_triage_sweep.py b/hermes_cli/kanban_triage_sweep.py
index 54a2ad1278..ab31238302 100644
--- a/hermes_cli/kanban_triage_sweep.py
+++ b/hermes_cli/kanban_triage_sweep.py
@@ -24,7 +24,7 @@ TRIAGE_SWEEP_CAP_WINDOW = 86400
 # Events that put a card into triage. A card in triage whose newest such event is newer than its last
 # ``triage_swept`` re-entered triage after that sweep.
 TRIAGE_ENTRY_EVENTS = ("gave_up", "block_loop_detected", "agent_block_escalated", "supervisor_escalated",
-                       "continuation_exhausted", "blocked", "status")
+                       "continuation_exhausted", "blocked", "status", "spend_budget_triaged")
 _TRIAGE_BRIEF = (
     "\n\n---\n[triage sweep] This card sat in triage with no specifier. Specify it "
     "(clarify title/body, then do the work), or park it with kanban_schedule + a wake_check "
diff --git a/tests/hermes_cli/test_kanban_spend_budget_hold.py b/tests/hermes_cli/test_kanban_spend_budget_hold.py
index 04e40c61aa..b81d2be338 100644
--- a/tests/hermes_cli/test_kanban_spend_budget_hold.py
+++ b/tests/hermes_cli/test_kanban_spend_budget_hold.py
@@ -61,9 +61,13 @@ def test_owned_stop_has_one_chat_notice_and_no_supervisor(kanban_home, origin):
         assert len(events) == 1
 
 
-def test_unowned_stop_has_one_supervisor(kanban_home):
+@pytest.mark.parametrize("observer", [None, "touch", "shepherd"])
+def test_unowned_stop_has_one_supervisor(kanban_home, observer):
     with kbc.connect_closing() as conn:
         tid = stopped(conn)
+        if observer:
+            notify.add_notify_sub(conn, task_id=tid, platform="tui", chat_id="observer",
+                                  delivery_metadata={"reason": observer})
         assert budget.hold(conn, tid) == "triage"
         budget.hold(conn, tid)
         (event,) = helpers._events(conn, tid, decision.NOTICE)
@@ -74,7 +78,7 @@ def test_unowned_stop_has_one_supervisor(kanban_home):
         assert tid in supervisor.body and "15 runs" in supervisor.body
         assert "promote" in supervisor.body and "archive" in supervisor.body
         assert conn.execute("SELECT COUNT(*) FROM tasks").fetchone()[0] == 2
-        assert conn.execute("SELECT COUNT(*) FROM kanban_notify_subs WHERE task_id=?", (tid,)).fetchone()[0] == 0
+        assert conn.execute("SELECT COUNT(*) FROM kanban_notify_subs WHERE task_id=?", (tid,)).fetchone()[0] == int(bool(observer))
 
 
 @pytest.mark.parametrize("status", ["ready", "review"])
@@ -139,9 +143,14 @@ def test_gateway_notice_contains_spend_and_decision(kanban_home):
     assert "15 runs" in text and "promote" in text and "archive" in text
 
 
-def test_producer_failure_keeps_hold_and_sweep_retries_once(kanban_home, monkeypatch):
+@pytest.mark.parametrize("prior_sweep", [False, True])
+def test_producer_failure_keeps_hold_and_sweep_retries_once(kanban_home, monkeypatch, prior_sweep):
     with kbc.connect_closing() as conn:
         tid = stopped(conn)
+        if prior_sweep:
+            with kb.write_txn(conn):
+                conn.execute("UPDATE tasks SET status='triage' WHERE id=?", (tid,))
+            assert tid in sweep.sweep_stale_triage(conn, now=int(time.time()) + 7200)
         real = decision.producer
         def fail(c, task_id, note):
             real(c, task_id, note)  # even a partial publication must roll back
