From f19856575b93de28b458646d3feee87983080381 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 21:30:55 +0000
Subject: [PATCH] [daveey] fix(kanban): scratch preserve pin also guards
 detached-trash sweep; non-mapping kanban section fails closed

Review 5898185328 (PR #2665) nits:
- _sweep_detached_trash now skips .<id>.gc-rm-* trees whose id is pinned by
  kanban.scratch_gc_preserve (card: every removal path skips the pin).
- A non-mapping kanban: section makes preserved_ids() return None (pin every
  tree) instead of reading as an empty list.
- New test kills the surviving rows-loop mutant: a pinned row is never walked
  by gc_task_scratch.

RED (fix reverted, tests kept): test_detached_trash_of_pinned_id_is_not_swept
and 3x test_non_mapping_kanban_section_fails_closed fail; with the rows-loop
pin check deleted, test_preserved_row_is_never_walked_by_retention_gc fails.
GREEN: test_kanban_scratch_custody{,_gaps}.py 194 passed.
---
 hermes_cli/kanban_scratch_preserve.py         |  5 ++-
 hermes_cli/kanban_worktree_gc.py              |  5 +++
 .../test_kanban_scratch_custody_gaps.py       | 35 +++++++++++++++++++
 3 files changed, 44 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_scratch_preserve.py b/hermes_cli/kanban_scratch_preserve.py
index 0569c667f6..aa043788cc 100644
--- a/hermes_cli/kanban_scratch_preserve.py
+++ b/hermes_cli/kanban_scratch_preserve.py
@@ -25,7 +25,10 @@ def preserved_ids() -> frozenset[str] | None:
     try:
         from hermes_cli.config import load_config_readonly
         kanban = load_config_readonly().get("kanban") or {}
-        value = kanban.get("scratch_gc_preserve") if isinstance(kanban, dict) else ()
+        if not isinstance(kanban, dict):
+            _warn(f"invalid kanban section {type(kanban).__name__}")
+            return None
+        value = kanban.get("scratch_gc_preserve")
     except Exception as exc:  # health: allow BLE001 -- unreadable config pins every tree (fail closed)
         _warn(f"unreadable config ({type(exc).__name__})")
         return None
diff --git a/hermes_cli/kanban_worktree_gc.py b/hermes_cli/kanban_worktree_gc.py
index 1f064f28ff..3bc73338ff 100644
--- a/hermes_cli/kanban_worktree_gc.py
+++ b/hermes_cli/kanban_worktree_gc.py
@@ -175,6 +175,8 @@ def _sweep_detached_trash(root: Path, rows) -> None:
     and only touches names this GC mints."""
     import shutil
 
+    from hermes_cli.kanban_scratch_preserve import preserved
+
     parents = {root}
     for row in rows:
         if row["workspace_path"]:
@@ -189,6 +191,9 @@ def _sweep_detached_trash(root: Path, rows) -> None:
         for trash in entries:
             if trash.is_symlink() or not trash.is_dir():
                 continue
+            if preserved(None, trash):
+                log.info("Scratch preserved: reason=scratch_gc_preserve path=%s", trash)
+                continue
             shutil.rmtree(trash, ignore_errors=True)
             if os.path.lexists(trash):
                 log.warning("Scratch GC left detached tree %s; retried next run", trash)
diff --git a/tests/hermes_cli/test_kanban_scratch_custody_gaps.py b/tests/hermes_cli/test_kanban_scratch_custody_gaps.py
index 979ad04aec..026909ed74 100644
--- a/tests/hermes_cli/test_kanban_scratch_custody_gaps.py
+++ b/tests/hermes_cli/test_kanban_scratch_custody_gaps.py
@@ -461,3 +461,38 @@ def test_preserve_matches_id_component_and_detached_names(monkeypatch):
     assert not preserve.preserved("t_bbbbbbbbbbbbbbbb", "/w/t_bbbbbbbbbbbbbbbb")
     assert not preserve.preserved(None, "/w/xt_aaaaaaaaaaaaaaaa")
     assert not preserve.preserved(None, None)
+
+
+def test_preserved_row_is_never_walked_by_retention_gc(board, monkeypatch):
+    tid, path = _local_done(board)
+    walked = []
+    real = ws._scratch_tree_removable
+    monkeypatch.setattr(ws, "_scratch_tree_removable", lambda p: walked.append(p) or real(p))
+    _config(board, scratch_gc_preserve=[tid])
+    assert gc.gc_task_scratch(board.conn, older_than_days=7) == 0
+    assert walked == [] and (path / "notes").read_text() == "keep me"
+    _config(board)
+    assert gc.gc_task_scratch(board.conn, older_than_days=7) == 1  # control: unpinned is walked
+    assert walked == [path]
+
+
+def test_detached_trash_of_pinned_id_is_not_swept(board, caplog):
+    root = kb.workspaces_root()
+    root.mkdir(parents=True, exist_ok=True)
+    pinned = root / f".{TID}.gc-rm-{'0' * 32}"
+    other = root / f".t_ffffffffffffffff.gc-rm-{'1' * 32}"
+    for trash in (pinned, other):
+        trash.mkdir()
+        (trash / "notes").write_text("x")
+    _config(board, scratch_gc_preserve=[TID])
+    with caplog.at_level("INFO"):
+        gc._sweep_detached_trash(root, [])
+    assert (pinned / "notes").exists() and not other.exists()
+    assert f"reason=scratch_gc_preserve path={pinned}" in caplog.text
+
+
+@pytest.mark.parametrize("section", ['"oops"', "[t_aaaaaaaaaaaaaaaa]", "3"])
+def test_non_mapping_kanban_section_fails_closed(board, section):
+    (board.home / "config.yaml").write_text(f"kanban: {section}\n")
+    assert preserve.preserved_ids() is None
+    assert preserve.preserved("t_cccccccccccccccc") is True
