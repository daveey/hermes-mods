From 1c22fc1e46ac7edd615c2adb804ed0d36ca54539 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 4 Nov 2026 21:15:24 +0000
Subject: [PATCH] fix(redact): use earliest command head and preserve
 continuation precedence [daveey]

---
 agent/redact.py                           | 16 +++++++++-------
 tests/agent/test_redact_outbox_secrets.py | 10 ++++++++++
 2 files changed, 19 insertions(+), 7 deletions(-)

diff --git a/agent/redact.py b/agent/redact.py
index b8f4cf60e38..12eea326e90 100644
--- a/agent/redact.py
+++ b/agent/redact.py
@@ -850,6 +850,7 @@ def _redact_random_secret_fields(text: str, mask) -> str:
 # path segments stay separate) inside that exact diagnostic is masked. Search for a secret
 # in-process instead of passing it in argv: argv is also visible in ``ps`` and /proc.
 _SUBPROCESS_COMMAND_TAIL_RE = re.compile(r"(['\"]) (?:timed out after |returned non-zero exit status |died with )")
+_SUBPROCESS_COMMAND_HEAD_RE = re.compile(r"Command ['\"]")
 _SUBPROCESS_COMMAND_SPAN = 16384  # a shell=True script may span lines
 _ARGV_RANDOM_TOKEN_RE = re.compile(
     r"(?<![A-Za-z0-9_+-])(?=[A-Za-z0-9_+-]*[a-z])(?=[A-Za-z0-9_+-]*[A-Z])[A-Za-z0-9_+-]{32,}={0,2}"
@@ -869,15 +870,16 @@ def _redact_subprocess_argv(text: str) -> str:
         lo = max(scanned, end - _SUBPROCESS_COMMAND_SPAN)
         scanned = m.end()
         # A shell script can contain a tail with a different quote from the
-        # diagnostic's head. Treat either quote as a conservative boundary.
-        head = max(text.rfind("Command '", lo, end), text.rfind('Command "', lo, end))
-        if head >= 0:
-            body = head + len("Command ") + 1
-            in_command = True
-        elif in_command:
+        # diagnostic's head, or a fake Command head. Start at the first head
+        # of either quote style so script text cannot hide earlier tokens.
+        head = _SUBPROCESS_COMMAND_HEAD_RE.search(text, lo, end)
+        if in_command:
             # The earlier tail may itself be script text. Continue masking in
-            # this disjoint, bounded window rather than losing the real tail.
+            # this disjoint, bounded window, even across another script head.
             body = lo
+        elif head is not None:
+            body = head.end()
+            in_command = True
         else:
             continue
         out += [text[pos:body], _ARGV_RANDOM_TOKEN_RE.sub("***", text[body:end])]
diff --git a/tests/agent/test_redact_outbox_secrets.py b/tests/agent/test_redact_outbox_secrets.py
index fdbed517b63..86d4e3148f6 100644
--- a/tests/agent/test_redact_outbox_secrets.py
+++ b/tests/agent/test_redact_outbox_secrets.py
@@ -113,6 +113,16 @@ class TestSubprocessArgvDiagnostics:
         text = str(exc)
         assert SECRET not in redact_sensitive_text(text, code_file=True)
 
+    @pytest.mark.parametrize("error", [subprocess.TimeoutExpired, subprocess.CalledProcessError])
+    @pytest.mark.parametrize("quote", ["'", '"'])
+    @pytest.mark.parametrize("as_list", [False, True])
+    @pytest.mark.parametrize("prefix", ["", 'echo "worker" died with code; '])
+    def test_embedded_command_head_does_not_hide_earlier_secret(self, error, quote, as_list, prefix):
+        script = prefix + f"curl -H {SECRET}; echo Command {quote}x{quote}"
+        argv = ["sh", "-c", script] if as_list else script
+        exc = error(argv, 30) if error is subprocess.TimeoutExpired else error(1, argv)
+        assert SECRET not in redact_sensitive_text(str(exc), code_file=True)
+
     def test_unheaded_tail_does_not_mask_ordinary_text(self):
         text = f"ordinary {SECRET}' died with code"
         assert redact_sensitive_text(text, code_file=True) == text
