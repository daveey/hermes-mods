Subject: [PATCH 6175] Fail-closed startup readiness and natural controller rollover

Public mirror of source commit 46bf7c2fa0bfafa91c1a8a42b7e28e36aa2f3695.

---
diff --git a/hermes_cli/session_owner_discovery.py b/hermes_cli/session_owner_discovery.py
index df26a3d2eb4..42052586739 100644
--- a/hermes_cli/session_owner_discovery.py
+++ b/hermes_cli/session_owner_discovery.py
@@ -172,11 +172,18 @@
     ``OWNER_STARTING_BUDGET_S`` after the first read began and lifts the read cap: from then on
     both transient verdicts are re-read until another verdict or that deadline.
 
+    A budget that saw ``starting`` or ``draining`` and ends on a ``control_timeout`` answers the
+    newest of those settling verdicts: the owner is still mid-restart, its busy loop only missed the
+    last identify. A bare ``control_timeout`` is not replayed by Desktop (it reads it as a stall the
+    server already rode out), so a slow restart turned into a
+    manual Retry. Representative observation: loop stalls during a core-update restart caused
+    an archive to end on ``control_timeout`` after its starting budget expired.
+
     Reads are shared with concurrent callers for the same home (``_shared_read``); the shared
     read is shielded, so a caller that leaves on its own deadline never cancels it for others."""
     began = clock()
     deadline = began + OWNER_DISCOVERY_BUDGET_S
-    discovery, starting, attempt, last = None, False, 0, None
+    discovery, starting, attempt, last, settled = None, False, 0, None, None
     while starting or attempt < OWNER_DISCOVERY_ATTEMPTS:
         pause = OWNER_STARTING_POLL_S if _settling(discovery) else OWNER_DISCOVERY_BACKOFF_S
         remaining = deadline - clock()
@@ -194,8 +201,11 @@
         except TimeoutError:
             discovery = _timed_out()
         if _settling(discovery):
+            settled = discovery
             if not starting:
                 starting, deadline = True, began + OWNER_STARTING_BUDGET_S
         elif not is_transient(discovery):
             return discovery
+    if settled is not None and is_transient(discovery):
+        return settled  # still restarting: the retryable verdict Desktop replays
     return discovery or _timed_out()  # the first read always runs; this only types the result
diff --git a/tests/hermes_cli/test_session_owner_discovery_starting.py b/tests/hermes_cli/test_session_owner_discovery_starting.py
index b127678e552..d5f7682d11b 100644
--- a/tests/hermes_cli/test_session_owner_discovery_starting.py
+++ b/tests/hermes_cli/test_session_owner_discovery_starting.py
@@ -87,6 +87,51 @@
     assert len(seen) == 3
 
 
+@pytest.mark.asyncio
+@pytest.mark.parametrize('settling', [STARTING, GatewayDiscovery('draining')])
+async def test_a_restart_budget_ending_on_a_stall_answers_the_restart(tmp_path, monkeypatch, settling):
+    """Representative observation: a core-update restart outlasted the budget with repeated loop stalls,
+    so an archive saw ``starting`` and then only missed identifies until the budget ran out. That
+    write must answer the restart verdict (Desktop replays it), not ``control_timeout`` (final)."""
+    clock = _Clock()
+    start = clock.now
+    _reads(monkeypatch, [settling, TIMEOUT], clock)
+    verdict = await sod.discover_session_owner(tmp_path, clock=clock, sleep=clock.sleep)
+    assert verdict is settling
+    assert sod.owner_unavailable_detail(verdict, DRAIN_ADVICE) != sod.CONTROL_TIMEOUT_DETAIL
+    assert clock.now - start <= sod.OWNER_STARTING_BUDGET_S
+
+
+@pytest.mark.asyncio
+async def test_a_stall_without_a_restart_seen_stays_control_timeout(tmp_path, monkeypatch):
+    clock = _Clock()
+    seen = _reads(monkeypatch, [TIMEOUT], clock)
+    assert sod.is_transient(await sod.discover_session_owner(tmp_path, clock=clock, sleep=clock.sleep))
+    assert len(seen) == sod.OWNER_DISCOVERY_ATTEMPTS
+
+
+@pytest.mark.asyncio
+async def test_a_start_ending_on_stalls_answers_the_starting_503(tmp_path, monkeypatch):
+    """The write path: the starting 503 that Desktop's restart replay matches, nothing forwarded."""
+    from hermes_cli import web_server_sessions
+
+    _fast_poll(monkeypatch)
+    monkeypatch.setattr(sod, 'OWNER_STARTING_BUDGET_S', 0.3)
+    request = _standalone_request(monkeypatch, tmp_path)
+    _reads(monkeypatch, [STARTING, TIMEOUT])
+    attempts, connects = [], []
+    monkeypatch.setattr('hermes_cli.gateway_client.connect_gateway', lambda **kw: connects.append(kw))
+    with _held(attempts) as held:
+        monkeypatch.setattr('gateway.runtime_ownership.exclusive_maintenance', held)
+        with pytest.raises(HTTPException) as exc:
+            await web_server_sessions._mutate_session_request(
+                request, None, 's1', request_id='req-1', expected_revision=0,
+                operation='sidebar', payload={'archived': True})
+    assert exc.value.status_code == 503
+    assert exc.value.detail == sod.STARTING_DETAIL
+    assert len(attempts) == 1 and connects == []
+
+
 def test_only_a_starting_verdict_without_an_endpoint_is_starting():
     assert sod.is_starting(STARTING) and sod.is_starting(GatewayDiscovery('starting', reason_code='deadline'))
     assert not sod.is_starting(SimpleNamespace(state='starting', endpoint='owner', reason_code=None))
