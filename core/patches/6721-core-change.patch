Subject: [PATCH 6721] Lanes flow wait kinds, park semantics, triage attention and lane samples

Public mirror of source commit c66b0bafa9a579abfe6c49d685b919c5763ad6fe.

---
diff --git a/hermes_cli/kanban_lanes_flow.py b/hermes_cli/kanban_lanes_flow.py
index dd9edb85f79a4ec5dd1cbacc4595a5eac930459e..b1d94ede9ed2eef63c7c1f6cf32978905dca5435 100644
--- a/hermes_cli/kanban_lanes_flow.py
+++ b/hermes_cli/kanban_lanes_flow.py
@@ -257,9 +257,13 @@
 def _awaiting(task, events=()) -> Optional[dict]:
     if task["status"] != "scheduled":
         return None
+    # [daveey] kanban_continue parks write a 'continued' event (status=scheduled)
+    # carrying the awaiting; the newest park of either kind is the current wait.
     for event in reversed(events):
-        if event["kind"] == "scheduled":
-            data = _payload(dict(event)).get("awaiting")
+        payload = _payload(dict(event))
+        if event["kind"] == "scheduled" or (
+                event["kind"] == "continued" and payload.get("status") == "scheduled"):
+            data = payload.get("awaiting")
             return data if isinstance(data, dict) else None
     return None
 
diff --git a/tests/hermes_cli/test_kanban_lanes_flow_evidence.py b/tests/hermes_cli/test_kanban_lanes_flow_evidence.py
index b74ccb0bc6e4e9e24370d7fdd04b5358e9792cb0..793112f1fa824c1736fe208b964d03672733e6ba 100644
--- a/tests/hermes_cli/test_kanban_lanes_flow_evidence.py
+++ b/tests/hermes_cli/test_kanban_lanes_flow_evidence.py
@@ -30,6 +30,29 @@
     assert card(conn, tid)["step"] == step
 
 
+def test_continued_park_supplies_newest_awaiting(conn, configured):
+    """A kanban_continue park records its wait on a 'continued' event; it must win
+    over an older 'scheduled' park so the strip shows the card's current wait."""
+    tid = base._ready_in(conn, "myapp", "ci")
+    conn.execute("UPDATE tasks SET status='scheduled' WHERE id=?", (tid,))
+    kb._append_event(conn, tid, "scheduled", {"wake_at": 1})
+    kb._append_event(conn, tid, "continued", {"status": "scheduled",
+                                              "awaiting": {"kind": "ci", "ref": URL}})
+    conn.commit()
+    got = card(conn, tid)
+    assert got["wait"] == "ci"
+    assert got["step"] == "ci"
+
+
+def test_continued_to_ready_is_not_a_park(conn, configured):
+    tid = base._ready_in(conn, "myapp", "deploy")
+    conn.execute("UPDATE tasks SET status='scheduled' WHERE id=?", (tid,))
+    kb._append_event(conn, tid, "scheduled", {"awaiting": {"kind": "deploy", "ref": URL}})
+    kb._append_event(conn, tid, "continued", {"status": "ready", "awaiting": {"kind": "ci"}})
+    conn.commit()
+    assert card(conn, tid)["wait"] == "deploy"
+
+
 def test_changes_requested_invalidates_old_review(conn, configured):
     tid = base._ready_in(conn, "myapp", "rework")
     kb._append_event(conn, tid, "review_requested", {})
