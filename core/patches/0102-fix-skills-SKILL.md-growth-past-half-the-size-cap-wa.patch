diff --git a/tools/skill_manager_tool.py b/tools/skill_manager_tool.py
index 06fc0ddb87..4a9f234297 100644
--- a/tools/skill_manager_tool.py
+++ b/tools/skill_manager_tool.py
@@ -179,15 +179,70 @@ def _validate_frontmatter(content: str, *, new_skill: bool = False) -> Optional[
     return None
 
 
+# A SKILL.md write that grows the file past this share of the hard cap gets a ``size_warning``
+# on EVERY growing write. The linter's ``oversized-body`` finding fires only on the write that
+# first crosses its soft budget, so without this a skill grew silently from ~24k to the 100k cap
+# and every later patch failed outright (myapp-development, 2026-10).
+_SKILL_SIZE_WARN_FRACTION = 0.5
+_SKILL_SPLIT_RECIPE = (
+    "To make room, in ONE skill_manage batch: write_file references/<topic>.md with the text of one "
+    "large section, then patch that section in SKILL.md down to a one-line pointer to the file, then "
+    "your change. Ops apply in order, so the shrinking ops must come before the growing one. Or put "
+    "the new content in a references/ file and link it from SKILL.md.")
+
+
+def _section_sizes(content: str) -> list[tuple[str, int]]:
+    """``(heading, chars)`` per level-2 (``## ``) section, ignoring headings inside fenced code."""
+    sections: list[tuple[str, int]] = []
+    heading, size, in_fence = None, 0, False
+    for line in content.splitlines(keepends=True):
+        if line.lstrip().startswith(("```", "~~~")):
+            in_fence = not in_fence
+        if not in_fence and line.startswith("## "):
+            if heading is not None:
+                sections.append((heading, size))
+            heading, size = line.strip(), 0
+        size += len(line)
+    if heading is not None:
+        sections.append((heading, size))
+    return sections
+
+
+def _largest_sections_note(content: str, n: int = 3) -> str:
+    top = sorted(_section_sizes(content), key=lambda s: -s[1])[:n]
+    if not top:
+        return ""
+    return "Largest sections: " + ", ".join(f"'{h}' ({c:,} chars)" for h, c in top) + ". "
+
+
 def _validate_content_size(content: str, label: str = "SKILL.md") -> Optional[str]:
     if len(content) > MAX_SKILL_CONTENT_CHARS:
-        return (
+        msg = (
             f"{label} content is {len(content):,} characters (limit: {MAX_SKILL_CONTENT_CHARS:,}). "
             f"Consider splitting into a smaller SKILL.md with supporting files in references/ "
             f"or templates/.")
+        if label == "SKILL.md":
+            over = len(content) - MAX_SKILL_CONTENT_CHARS
+            msg += (f" This write is {over:,} chars over; free well more than that so the next "
+                    f"write fits too. {_largest_sections_note(content)}{_SKILL_SPLIT_RECIPE}")
+        return msg
     return None
 
 
+def _attach_size_warning(result: dict[str, Any], before: str, after: str) -> dict[str, Any]:
+    """Advisory on a SKILL.md write that GREW the file and leaves it past the warn share of the
+    hard cap: the next writes will start failing, so name the sections to move out now."""
+    if len(after) <= len(before) or len(after) < _SKILL_SIZE_WARN_FRACTION * MAX_SKILL_CONTENT_CHARS:
+        return result
+    pct = len(after) * 100 // MAX_SKILL_CONTENT_CHARS
+    result["size_warning"] = (
+        f"The write succeeded, but SKILL.md is now {len(after):,} chars, {pct}% of the "
+        f"{MAX_SKILL_CONTENT_CHARS:,}-char hard cap. A write that crosses the cap fails. Stop growing "
+        f"SKILL.md: add new detail to references/ instead, and move a large section out soon. "
+        f"{_largest_sections_note(after)}{_SKILL_SPLIT_RECIPE}")
+    return result
+
+
 def _description_preview(content: str) -> str:
     """First 120 chars of the frontmatter description; '' on any failure."""
     with suppress(Exception):
@@ -488,7 +543,7 @@ def _create_skill(name: str, content: str, category: str | None = None) -> dict[
                 f"skill_manage(action='write_file', name='{name}', file_path='references/example.md', "
                 "file_content='...')"}
     _attach_lint_findings(_add_description_prompt_preview(result, content), skill_md)
-    return result
+    return _attach_size_warning(result, "", content)
 
 
 def _edit_skill(name: str, content: str) -> dict[str, Any]:
@@ -496,13 +551,17 @@ def _edit_skill(name: str, content: str) -> dict[str, Any]:
     if err := _validate_frontmatter(content) or _validate_content_size(content):
         return _err(err)
     skill_dir, guard = _locate_for_write(name, "edit")
+    before = ""
+    if not guard:
+        with suppress(OSError):
+            before = (skill_dir / "SKILL.md").read_text(encoding="utf-8-sig")
     # SKILL.md always exists here (_find_skill requires it), so a blocked scan restores it.
     if guard := guard or _guarded_write(name, skill_dir, skill_dir / "SKILL.md", "edit", "SKILL.md", content):
         return guard
     result = {
         "success": True, "message": f"Skill '{name}' updated (full rewrite).",
         "path": str(skill_dir), "_change": {"description": _description_preview(content)}}
-    return _add_description_prompt_preview(result, content)
+    return _attach_size_warning(_add_description_prompt_preview(result, content), before, content)
 
 
 def _patch_skill(name: str, old_string: str, new_string: str, file_path: str | None = None,
@@ -556,6 +615,7 @@ def _patch_skill(name: str, old_string: str, new_string: str, file_path: str | N
     # (oversized-body, incident-log-shape) — a clean patch attaches nothing and stays quiet.
     if not file_path:
         _attach_lint_findings(result, target, before=content)
+        _attach_size_warning(result, content, new_content)
     return result
 
 
