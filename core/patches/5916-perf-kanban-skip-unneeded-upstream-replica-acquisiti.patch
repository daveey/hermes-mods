diff --git a/hermes_cli/kanban_session_activity_card_details.py b/hermes_cli/kanban_session_activity_card_details.py
index be3863536a8..4d8d3b8740c 100644
--- a/hermes_cli/kanban_session_activity_card_details.py
+++ b/hermes_cli/kanban_session_activity_card_details.py
@@ -281,7 +281,16 @@ def _walk(conn: sqlite3.Connection, task_id: str,
 
 def _add_blocked_upstream(conn: sqlite3.Connection, found: dict[str, dict[str, Any]], *, replica: Any = LEGACY_REPLICA) -> None:
     """Optional presentation evidence; old schemas remain readable. Replica fills foreign parents."""
-    if not found:
+    # Clear stale presentation on every card, but only acquire/read graph evidence
+    # for statuses the walk can annotate. Owner observations often contain one
+    # terminal card: opening its shadow was all cost and could not affect output.
+    pending = {}
+    for task_id, card in found.items():
+        card.pop("blocked_upstream", None)
+        card.pop("upstream", None)
+        if card.get("status") not in {"done", "archived", "blocked", "triage"}:
+            pending[task_id] = card
+    if not pending:
         return
     owned = replica is LEGACY_REPLICA
     if owned:
@@ -291,15 +300,11 @@ def _add_blocked_upstream(conn: sqlite3.Connection, found: dict[str, dict[str, A
     memo: dict = {}
     try:
         try:
-            root_parents = _root_parents(conn, replica, list(found))
+            root_parents = _root_parents(conn, replica, list(pending))
         except sqlite3.Error:
             logging.getLogger(__name__).debug("Could not read blocked upstream roots", exc_info=True)
-            root_parents = {task_id: [] for task_id in found}
-        for task_id, card in found.items():
-            card.pop("blocked_upstream", None)
-            card.pop("upstream", None)
-            if card.get("status") in {"done", "archived", "blocked", "triage"}:
-                continue
+            root_parents = {task_id: [] for task_id in pending}
+        for task_id, card in pending.items():
             try:
                 blocked, upstream = _walk(conn, task_id, replica, root_parents=root_parents, memo=memo)
             except sqlite3.Error:
diff --git a/tests/hermes_cli/test_kanban_upstream_skipped_rows.py b/tests/hermes_cli/test_kanban_upstream_skipped_rows.py
new file mode 100644
index 00000000000..5876dc59650
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_upstream_skipped_rows.py
@@ -0,0 +1,55 @@
+"""Skipped upstream cards must not acquire replicas or read dependency graphs."""
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_session_activity_card_details as details
+
+
+@pytest.mark.parametrize('status', ['done', 'archived', 'blocked', 'triage'])
+@pytest.mark.parametrize('explicit', [False, True])
+def test_skipped_only_clears_stale_fields_without_reads(monkeypatch, status, explicit):
+    with sqlite3.connect(':memory:') as conn, sqlite3.connect(':memory:') as replica:
+        statements = []
+        conn.set_trace_callback(statements.append)
+        replica.set_trace_callback(statements.append)
+        monkeypatch.setattr(details, '_replica_for', lambda _: pytest.fail('unneeded replica acquisition'))
+        found = {'task': {'status': status, 'blocked_upstream': {'id': 'stale'}, 'upstream': {'id': 'stale'}}}
+        details._add_blocked_upstream(conn, found, **({'replica': replica} if explicit else {}))
+        assert found == {'task': {'status': status}}
+        assert statements == []
+        assert replica.execute('SELECT 1').fetchone() == (1,)
+
+
+def test_mixed_roots_exclude_skipped_rows_and_preserve_pending_walk(monkeypatch):
+    with sqlite3.connect(':memory:') as conn:
+        conn.executescript('CREATE TABLE tasks (id TEXT PRIMARY KEY, status TEXT);'
+                           'CREATE TABLE task_links (child_id TEXT, parent_id TEXT);'
+                           "INSERT INTO tasks VALUES ('pending', 'ready'), ('parent', 'blocked');"
+                           "INSERT INTO task_links VALUES ('pending', 'parent');")
+        roots = details._root_parents
+        seen = []
+
+        def record(conn, replica, ids):
+            seen.append(list(ids))
+            return roots(conn, replica, ids)
+
+        monkeypatch.setattr(details, '_root_parents', record)
+        found = {'skip': {'status': 'done', 'upstream': {'id': 'stale'}},
+                 'pending': {'status': 'ready', 'upstream': {'id': 'stale'}}}
+        details._add_blocked_upstream(conn, found, replica=None)
+        assert seen == [['pending']]
+        assert found == {'skip': {'status': 'done'}, 'pending': {
+            'status': 'ready', 'blocked_upstream': {'id': 'parent', 'status': 'blocked'}}}
+
+
+def test_skipped_fields_clear_even_when_pending_root_query_fails(monkeypatch):
+    with sqlite3.connect(':memory:') as conn:
+        def fail(*args):
+            raise sqlite3.OperationalError('unavailable')
+
+        monkeypatch.setattr(details, '_root_parents', fail)
+        found = {'skip': {'status': 'triage', 'blocked_upstream': {'id': 'stale'}},
+                 'pending': {'status': 'ready', 'upstream': {'id': 'stale'}}}
+        details._add_blocked_upstream(conn, found, replica=None)
+        assert found == {'skip': {'status': 'triage'}, 'pending': {'status': 'ready'}}
