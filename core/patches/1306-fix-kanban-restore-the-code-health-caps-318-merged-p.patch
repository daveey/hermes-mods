From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 12:05:10 -0700
Subject: [PATCH] fix(kanban): restore the code-health caps #318 merged past;
 dispatcher entry test for forwarded owner archives [daveey] (#328)

PR #318 (68293f0c8b) landed with 'code health ratchet (blocking)' red: kanban_db.py,
kanban_db_dispatch.py and kanban_tools.py grew past their caps and the reclaim phase gained a
blind except. Move the archive-forward branch into kanban_owner_archive_relay.forward_local_miss,
fold both remote-archive steps of the reclaim phase into apply_remote_archives (one guarded
loop), and split the attach-url downloader into tools/kanban_tools_attach_url.py. No behaviour
change; adds a test that the dispatcher entry still applies a forwarded archive when the
stop-request step fails.

Co-authored-by: a <a@example.com>
---
 .../tools/test_kanban_owner_archive_relay.py  | 45 +++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/tests/tools/test_kanban_owner_archive_relay.py b/tests/tools/test_kanban_owner_archive_relay.py
index fc3afb7ffc..182dbdab73 100644
--- a/tests/tools/test_kanban_owner_archive_relay.py
+++ b/tests/tools/test_kanban_owner_archive_relay.py
@@ -172,3 +172,48 @@ def test_home_refuses_a_forged_request_for_another_cards_owner(gateways, monkeyp
     assert out.get("ok") is False, out
     assert "not a capability owner card of" in out["error"]
     assert kb.get_task(home, owner_b).status == "done"
+
+
+def test_dispatcher_step_applies_forwarded_archive_when_stop_requests_fail(gateways, monkeypatch):
+    """A failed remote-stop source must not prevent answering forwarded owner archives."""
+    from hermes_cli import kanban_remote_stop
+
+    home, worker, home_db = gateways
+    waiting, owner, requester = _relayed(home, worker, home_db, monkeypatch)
+    assert kb.complete_task(home, owner, summary="done")
+    route = oar.relayed_owner_route(worker, requester, owner)
+    assert route is not None and route["waiting"] == waiting
+    pending = oar.forward(worker, route, owner, requester=requester, run_id=192, wait_s=0)
+    assert pending["status"] == "archive_pending"
+
+    def boom(_conn):
+        raise RuntimeError("stop requests unreadable")
+
+    monkeypatch.setattr(kanban_remote_stop, "apply_stop_requests", boom)
+    _copy_events(worker, home, oar.REQUEST_KIND)
+    assert oar.apply_remote_archives(home) == [owner]
+    assert kb.get_task(home, owner).status == "archived"
+    assert oar.apply_remote_archives(home) == []
+    assert len(oar._events(home, waiting, oar.RESULT_KIND)) == 1
+
+
+def test_worker_archive_entry_forwards_done_owner_with_requesting_run(gateways, monkeypatch):
+    """The extracted worker entry preserves the forwarding result and run attribution."""
+    home, worker, home_db = gateways
+    waiting, owner, requester = _relayed(home, worker, home_db, monkeypatch)
+    assert kb.complete_task(home, owner, summary="done")
+    run_requests = []
+
+    def run_id(task_id):
+        run_requests.append(task_id)
+        return 192
+
+    refusal, out = oar.worker_archive(worker, owner, run_id_fn=run_id)
+    assert refusal is None
+    assert out == {"status": "archived"}
+    assert run_requests == [requester]
+    assert kb.get_task(home, owner).status == "archived"
+    event = _archived_payload(home, owner)
+    assert event["forwarded_task"] == requester
+    assert event["forwarded_run_id"] == 192
+    assert event["via"].startswith(f"capability owner of {waiting} by {requester}")
