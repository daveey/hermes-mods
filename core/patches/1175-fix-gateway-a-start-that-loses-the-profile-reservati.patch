From 4f1812702cb92e52b67995a0266b49b30e703a56 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 07:47:39 +0000
Subject: [PATCH] fix(gateway): a start that loses the profile-reservation race
 to a live gateway is gateway.start_refused [daveey]

Two gateways booting at once on one home: the loser found the winner's gateway.lock flock
before gateway.pid existed and logged gateway.exit_nonzero (cause=profile_reservation_conflict),
which self-heal files as a crash (mini 10-30 05:01Z, gateway-0a890988a6). When the conflicting
holder is a live gateway of that home, note_start_refused('profile_reservation', owner_pid=...).
Exit code stays 1; a non-gateway or maintenance holder keeps exit_nonzero with its cause.
---
 gateway/run_bootstrap.py                     | 19 ++++++
 gateway/runtime_ownership.py                 | 20 ++++++
 tests/hermes_cli/test_gateway_exit_signal.py | 67 ++++++++++++++++++++
 3 files changed, 106 insertions(+)

diff --git a/gateway/run_bootstrap.py b/gateway/run_bootstrap.py
index 656bd55097e..78527ae3f52 100644
--- a/gateway/run_bootstrap.py
+++ b/gateway/run_bootstrap.py
@@ -652,6 +652,18 @@ def _reserve_waiting_out_browse_reconcile(ownership, homes, *, wait_s: float | N
     return reserve_waiting_out_transient_holders(ownership, homes, wait_s=wait_s)
 
 
+def _reservation_conflict_gateway_holder(homes):
+    """``(home, pid)`` of the first conflicting home held by a live gateway, else None."""
+    from gateway.runtime_ownership import _conflicting_homes, live_gateway_lock_holder
+    try:
+        for home in _conflicting_homes(homes):
+            if (pid := live_gateway_lock_holder(home)) is not None:
+                return home, pid
+    except Exception:  # health: allow BLE001 -- naming the holder must not change the exit
+        logger.debug("Could not identify the gateway.lock holder", exc_info=True)
+    return None
+
+
 def _start_gateway_reserve_profiles(profile_homes) -> bool:
     """Reserve the launch home plus every served profile home; False when startup must abort."""
     from gateway.run import get_hermes_home
@@ -676,6 +688,13 @@ def _start_gateway_reserve_profiles(profile_homes) -> bool:
             _write_runtime_status_quiet(gateway_state="startup_failed", exit_reason=str(exc))
             raise SystemExit(GATEWAY_FATAL_CONFIG_EXIT_CODE)
         from gateway.run_exit_reason import note_exit_cause
+        # [daveey] Losing the race to a live gateway of this home is a refused start, like pid_claim:
+        # the winner held gateway.lock before it wrote gateway.pid (gateway-0a890988a6). Exit code
+        # stays 1; a holder that is not a live gateway keeps the exit_nonzero cause below.
+        if (holder := _reservation_conflict_gateway_holder(homes)) is not None:
+            from gateway.run_exit_reason import note_start_refused
+            home, pid = holder
+            note_start_refused("profile_reservation", owner_pid=pid, detail=str(home))
         note_exit_cause("profile_reservation_conflict", exc)
         return False
     except OSError as exc:
diff --git a/gateway/runtime_ownership.py b/gateway/runtime_ownership.py
index 41a80f60213..1a17ee95ae5 100644
--- a/gateway/runtime_ownership.py
+++ b/gateway/runtime_ownership.py
@@ -249,6 +249,26 @@ def lock_record_unpublished(home: Path) -> bool:
     return not record or _live_pid_from_record(record) in (None, os.getpid())
 
 
+def live_gateway_lock_holder(home: Path) -> int | None:
+    """PID of the live gateway whose published ``gateway.lock`` record holds *home*, else None.
+
+    [daveey] A start that loses the reservation race to a gateway booting at the same moment (its
+    flock is taken before it writes ``gateway.pid``) was refused, not crashed, so the boot names
+    that holder (mini 10-30, gateway-0a890988a6). Maintenance (``purpose``), the caller itself, a
+    dead or recycled pid, and a live process that is not this home's gateway all read None.
+    Advisory only, never grants the lock."""
+    from gateway.status import (_live_pid_from_record, _read_gateway_lock_record,
+                                _record_matches_live_gateway_pid)
+    home = canonical_home(home)
+    record = _read_gateway_lock_record(home / 'gateway.lock')
+    if not record or record.get('purpose'):
+        return None
+    pid = _live_pid_from_record(record)
+    if pid is None or pid == os.getpid():
+        return None
+    return pid if _record_matches_live_gateway_pid(record, pid, expected_home=home) else None
+
+
 # A client's discovery probe (gateway.status._probe_lock_file) holds a gateway.lock flock for an
 # instant; the next attempt after this pause normally finds it gone.
 PROBE_RETRY_BACKOFF_S = 0.015
diff --git a/tests/hermes_cli/test_gateway_exit_signal.py b/tests/hermes_cli/test_gateway_exit_signal.py
index 9fc30252a04..1d4739e9a38 100644
--- a/tests/hermes_cli/test_gateway_exit_signal.py
+++ b/tests/hermes_cli/test_gateway_exit_signal.py
@@ -164,6 +164,73 @@ def test_early_start_gateway_false_records_its_cause(monkeypatch):
     assert "disk full" in extra["exit_reason"]
 
 
+# --- [daveey] a start that loses the profile-reservation race is a refusal, not a crash ---------------------
+# Two gateways starting at once on one home (mini, 10-30 05:01Z: client auto-start vs the launchd service): the
+# loser found the winner's gateway.lock flock before any gateway.pid existed and wrote exit_nonzero
+# (cause=profile_reservation_conflict). The winner is a live gateway, so the start was refused, like pid_claim.
+
+_HOLDER_SRC = """
+import sys
+sys.path.insert(0, {repo!r})
+from gateway.runtime_ownership import ProfileOwnership
+owner = ProfileOwnership()  # kept alive: dropping it closes the handle and frees the flock
+owner.reserve([{home!r}])
+print("ready", flush=True)
+sys.stdin.read()
+"""
+
+
+@pytest.fixture
+def lock_holder(tmp_path):
+    """Start a process that holds ``<HERMES_HOME>/gateway.lock`` (real flock + published record)."""
+    import subprocess
+    import sys
+    procs = []
+
+    def _start(script_name: str, *argv: str):
+        home = os.environ["HERMES_HOME"]
+        script = tmp_path / script_name
+        script.write_text(_HOLDER_SRC.format(repo=str(Path(__file__).resolve().parents[2]), home=home))
+        proc = subprocess.Popen([sys.executable, str(script), *argv], stdin=subprocess.PIPE,
+                                stdout=subprocess.PIPE, text=True, env={**os.environ, "HERMES_HOME": home})
+        procs.append(proc)
+        assert proc.stdout is not None
+        assert proc.stdout.readline().strip() == "ready"
+        return proc
+
+    yield _start
+    for proc in procs:
+        proc.kill()
+        proc.wait(timeout=10)
+
+
+def _reservation_conflict_record(monkeypatch):
+    from gateway import run_bootstrap
+    from hermes_cli.gateway_exit_diag import nonzero_exit_record
+    import hermes_cli.gateway as gateway_cli
+    monkeypatch.setattr(gateway_cli, "named_profile_served_by_running_multiplexer", lambda: False)
+    monkeypatch.setattr(run_bootstrap, "_browse_reconcile_reserve_wait_s", lambda: 0.0)
+    assert run_bootstrap._start_gateway_reserve_profiles([]) is False  # exit code stays 1
+    return nonzero_exit_record()
+
+
+@pytest.mark.spawns_gateway_lookalike  # a stub that only holds the lock; the fixture reaps it
+def test_reservation_conflict_with_live_gateway_holder_is_start_refused(monkeypatch, lock_holder):
+    holder = lock_holder("hermes", "gateway", "run")
+    tag, extra = _reservation_conflict_record(monkeypatch)
+    assert tag == "gateway.start_refused"
+    assert extra["reason"] == "profile_reservation"
+    assert extra["owner_pid"] == holder.pid
+    assert extra["owner_alive"] is True
+
+
+def test_reservation_conflict_with_non_gateway_holder_stays_exit_nonzero(monkeypatch, lock_holder):
+    lock_holder("holder.py")
+    tag, extra = _reservation_conflict_record(monkeypatch)
+    assert tag == "gateway.exit_nonzero"
+    assert extra["cause"] == "profile_reservation_conflict"
+
+
 _NOTE_CALLS = {"note_exit_cause", "note_start_refused"}
 
 
