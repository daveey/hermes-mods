From d9b0935ad04ce7a1de1ead61ead81f8430e4ebcd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 19:27:07 +0000
Subject: [PATCH] fix(desktop): put the row's hover Archive button at the right
 edge, after the kebab [daveey]

The archive button sat left of the kebab, so on hover it landed mid-row instead of where the trailing figure (gateway cloud) was. Swap the order so Archive ends the cluster at the row's right edge.
---
 .../chat/sidebar/session-row-actions.test.tsx |  5 ++--
 .../sidebar/session-row-hover-actions.tsx     | 27 ++++++++++---------
 2 files changed, 17 insertions(+), 15 deletions(-)

diff --git a/apps/desktop/src/app/chat/sidebar/session-row-actions.test.tsx b/apps/desktop/src/app/chat/sidebar/session-row-actions.test.tsx
index 524a86acdb1..373b8b5eb3e 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row-actions.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row-actions.test.tsx
@@ -218,8 +218,9 @@ describe('SidebarSessionRow actions', () => {
     )
 
     const button = screen.getByRole('button', { name: 'Archive' })
-    // Sits right before the kebab in the hover cluster.
-    expect(button.nextElementSibling?.getAttribute('aria-label')).toBe('Session actions')
+    // Ends the hover cluster at the row's right edge, after the kebab.
+    expect(button.previousElementSibling?.getAttribute('aria-label')).toBe('Session actions')
+    expect(button.nextElementSibling).toBeNull()
     fireEvent.pointerDown(button, { button: 0, pointerType: 'mouse' })
     fireEvent.click(button)
 
diff --git a/apps/desktop/src/app/chat/sidebar/session-row-hover-actions.tsx b/apps/desktop/src/app/chat/sidebar/session-row-hover-actions.tsx
index 45832401bed..99d684f350d 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row-hover-actions.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row-hover-actions.tsx
@@ -20,12 +20,24 @@ interface RowHoverActionsProps {
   menu: MenuProps
 }
 
-/** [daveey] A sidebar row's hover actions: a one-click Archive beside the
- *  kebab. Both ride one cluster that lifts over the row's tail (which reserves
+/** [daveey] A sidebar row's hover actions: the kebab, then a one-click
+ *  Archive at the row's right edge (where the trailing figure, e.g. the
+ *  gateway cloud, sits). Both ride one cluster that lifts over the row's tail (which reserves
  *  their width, see tailHides) and yields to a hovered PR link together. */
 export function RowHoverActions({ actionsLabel, archiveLabel, className, menu }: RowHoverActionsProps) {
   return (
     <span className={cn('flex items-center gap-1', className)}>
+      <SessionActionsMenu {...menu}>
+        <Button
+          aria-label={actionsLabel}
+          className={ROW_ACTION_BUTTON}
+          data-session-actions
+          size="icon"
+          variant="ghost"
+        >
+          <Codicon name="kebab-vertical" size="0.875rem" />
+        </Button>
+      </SessionActionsMenu>
       {!menu.archived && (
         <Tip label={archiveLabel} side="top">
           <Button
@@ -49,17 +61,6 @@ export function RowHoverActions({ actionsLabel, archiveLabel, className, menu }:
           </Button>
         </Tip>
       )}
-      <SessionActionsMenu {...menu}>
-        <Button
-          aria-label={actionsLabel}
-          className={ROW_ACTION_BUTTON}
-          data-session-actions
-          size="icon"
-          variant="ghost"
-        >
-          <Codicon name="kebab-vertical" size="0.875rem" />
-        </Button>
-      </SessionActionsMenu>
     </span>
   )
 }
