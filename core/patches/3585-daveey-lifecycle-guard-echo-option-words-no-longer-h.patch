From 4b4bf77359b21c016a8fc68aa72224f809b8713a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 13:31:49 +0000
Subject: [PATCH] [daveey] lifecycle guard: echo option words no longer hide
 the printed command (PR #2230 review nit)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Under an output sink, `_iter_printed_shell_payloads` yielded the argument
line of every executed `echo`/`printf` as written, so `echo -n bash
/x/huge.sh | bash` was walked as `-n bash /x/huge.sh`: `-n` read as the
executed command and the oversized script as a mention. The guard allowed
it (False, None) and bash ran huge.sh; `echo -ne`, `echo -n -e`,
`echo -E` under `eval "$(…)"` and `printf -- bash\ /x/huge.sh` likewise.
Base a0307c048c allows them too; not a #2230 regression.

Fix: `_printed_argument_lines` yields, besides the line as written, the
line without echo's leading `-[neE]+` option words and (fail closed) the
line without every leading `-word`, for echo and printf alike. Extra
variants are only ever walked as more executed text, so they can refuse
more, never less; dedupe keeps the walk budget unchanged for plain lines.

Tests: `_SINK_SHAPES` gains echo-n, echo-ne, echo-n-e, echo-E-eval,
echo-n-wrapped and printf-dashdash. SINK_CONSUMERS gains `echo-n`
(+588 sink cases, 20938 total); main_verdicts.json regenerated with the
CLI against the same baseline da52aff8f4 (old allows unchanged, 294 new
allows).

Proof:
- test_lifecycle_guard_output_sink.py: guard at 7121008ade 6 failed (every
  new shape), this tree 83 passed
- test_lifecycle_guard_heredoc_walk.py with the new corpus: guard at
  7121008ade fails the corpus property (echo -n violations), this tree passes
- heredoc_shape_corpus.py report --full: cases=20938 bash_ran=5780
  refused=17630 violations=0
- scripts/run_tests.sh tests/cron/: 2276 passed, 2 skipped; the 5 tests/tools
  + tests/hermes_cli files importing the guard: 368 passed
---
 cron/lifecycle_guard.py                       |  29 +-
 .../main_verdicts.json                        | 298 +++++++++++++++++-
 tests/cron/heredoc_shape_corpus.py            |   4 +-
 .../cron/test_lifecycle_guard_output_sink.py  |   7 +
 4 files changed, 332 insertions(+), 6 deletions(-)

diff --git a/cron/lifecycle_guard.py b/cron/lifecycle_guard.py
index ba2c8b2a52..0705698350 100644
--- a/cron/lifecycle_guard.py
+++ b/cron/lifecycle_guard.py
@@ -1411,6 +1411,24 @@ _QUOTED_LITERAL_RES = (re.compile(r"(?='([^']+)')"), re.compile(r"(?=\"([^\"]+)\
 _PRINTED_ESCAPE_RE = re.compile(r"\\[ntrvf]")
 # Producers that print their own arguments, quoted or not (`echo bash /x/a.sh | bash`).
 _ARGUMENT_PRINTERS = frozenset({"echo", "printf"})
+# bash's builtin echo options (`echo -n`, `echo -ne`): they are not printed, so left in the line
+# the walk would read `-n` as the executed command and the script path as its argument.
+_ECHO_OPTION_RE = re.compile(r"-[neE]+")
+
+
+def _printed_argument_lines(name: str, arguments: list[str]) -> Iterator[str]:
+    """The line(s) an ``echo``/``printf`` with *arguments* may print: as written, without
+    ``echo``'s leading option words, and (fail closed) without every leading ``-word``."""
+    yield " ".join(arguments)
+    if name == "echo":
+        index = 0
+        while index < len(arguments) and _ECHO_OPTION_RE.fullmatch(arguments[index]):
+            index += 1
+        yield " ".join(arguments[index:])
+    index = 0
+    while index < len(arguments) and arguments[index].startswith("-"):
+        index += 1
+    yield " ".join(arguments[index:])
 
 
 def _with_escapes_decoded(text: str) -> Iterator[str]:
@@ -1423,7 +1441,8 @@ def _iter_printed_shell_payloads(command: str) -> Iterator[str]:
     """When some output in *command* is run as shell code (``python3 - <<'PY' | bash``,
     ``eval "$(…)"``, ``bash <(…)``), yield what a producer may print as the shell's command:
     every quoted string literal (``print('bash /x/big.sh')``) and the argument line of every
-    ``echo``/``printf`` (``echo bash /x/big.sh``), each also with ``\\n``-style escapes turned into
+    ``echo``/``printf`` (``echo bash /x/big.sh``, also without leading option words:
+    ``echo -n bash /x/big.sh``), each also with ``\\n``-style escapes turned into
     newlines. Their paths are executed, not mentions. Single and double quotes are matched
     independently, so a literal nested in the other kind (``python3 -c "print('bash x')"``) is
     yielded too, and every span between two consecutive quotes of a kind is yielded, so a stray
@@ -1455,8 +1474,12 @@ def _iter_printed_shell_payloads(command: str) -> Iterator[str]:
         while segment and segment[0] in _SUBSHELL_OPENING_WORDS:  # `{ echo …; }`, `then echo …`
             segment = segment[1:]
         index = _executed_command_index(segment)
-        if index is not None and _executable_name(segment[index]) in _ARGUMENT_PRINTERS:
-            yield from unseen(" ".join(segment[index + 1 :]))
+        if index is None:
+            continue
+        name = _executable_name(segment[index])
+        if name in _ARGUMENT_PRINTERS:
+            for line in _printed_argument_lines(name, segment[index + 1 :]):
+                yield from unseen(line)
 
 
 # --- referenced-script reading ----------------------------------------------------------------
