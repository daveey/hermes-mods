diff --git a/tests/tui_gateway/test_kanban_remote_notices.py b/tests/tui_gateway/test_kanban_remote_notices.py
index dfb99a86694..96b6cf70099 100644
--- a/tests/tui_gateway/test_kanban_remote_notices.py
+++ b/tests/tui_gateway/test_kanban_remote_notices.py
@@ -586,3 +586,48 @@ def test_canonical_drops_only_superseded_legacy_rows():
             ("mini", "default/t_a", 3, "other-gateway-legacy")]  # another owner gateway: kept
     assert sorted(r[3] for r in krn._canonical(rows)) == [
         "current-a", "legacy-only", "other-gateway-legacy", "other-profile-a"]
+
+
+def test_both_remote_writers_record_blocked_on_human(tmp_path, monkeypatch):
+    """The notice guarantee cannot look a remote card up locally, so both writers store its human-block state."""
+    from tui_gateway import kanban_remote_notices as krn
+    from tui_gateway import server
+
+    human = {"action": "Reply ship or hold here. Unblock = deploy; archive = drop it.",
+             "why_human": "Only David approves prod.", "interaction": "approval", "scope": "prod deploy",
+             "evidence": "CI green"}
+    now = time.time()
+    asks = _card("t_asks", CHAT, status="blocked", at=now - 60, summary="need a yes")
+    asks["task"]["human_request"] = human
+    plain = _card("t_plain", CHAT, status="blocked", at=now - 50, summary="tool broke")
+    plain["task"]["block_kind"] = "transient"
+    done = _card("t_done2", CHAT, status="done", at=now - 40, summary="shipped")
+    replica = _hub(tmp_path, [asks, plain, done])
+
+    krn._reset_for_tests()
+    db, opener = _sweep_db(tmp_path, (CHAT,))
+    with db:
+        sweep_remote_notices(replica_path=replica, gateway="macbook", session_db=opener,
+                             ledger=tmp_path / "sweep.db", now=now)
+        flags = {m["display_metadata"]["task_id"]: m["display_metadata"].get("blocked_on_human")
+                 for m in db.get_messages(CHAT)}
+    assert flags == {"t_asks": True, "t_plain": False, "t_done2": False}
+
+    krn._reset_for_tests()
+    got = {item["ref"].rsplit("/", 1)[1]: item.get("blocked_on_human")
+           for item in krn.collect(CHAT, "default", hub_db=replica, ledger=tmp_path / "poll.db", now=now)}
+    assert got == {"t_asks": True, "t_plain": False, "t_done2": False}
+
+    # The open-chat poller's persisted row carries it too (any remote item in the batch blocked on a human).
+    monkeypatch.setattr(krn, "hub_db_path", lambda: replica)
+    monkeypatch.setattr(krn, "collect", lambda *a, **k: [
+        {"text": "⏸ t_asks blocked", "event_key": "remote:hub:default/default/t_asks:x", "blocked_on_human": True,
+         "ref": "hub/default/default/t_asks", "state": "blocked@1", "session": CHAT}])
+    texts = server._collect_remote_kanban_notifications(CHAT, None)
+    with SessionDB(tmp_path / "live.db") as live:
+        live.create_session(CHAT, "desktop")
+        monkeypatch.setattr(server, "_get_db", lambda: live)
+        verdict, _batch, _kwargs = server._kb_persist_batch({"session_key": CHAT, "history": []}, texts, False)
+        assert verdict == "written"
+        rows = [m for m in live.get_messages(CHAT) if m.get("display_kind") == "kanban_notice"]
+    assert rows[-1]["display_metadata"].get("blocked_on_human") is True
diff --git a/tests/tui_gateway/test_notice_guarantee.py b/tests/tui_gateway/test_notice_guarantee.py
index c001b7aee48..aaddb24813d 100644
--- a/tests/tui_gateway/test_notice_guarantee.py
+++ b/tests/tui_gateway/test_notice_guarantee.py
@@ -113,3 +113,63 @@ def test_a_blocked_on_human_notice_never_wakes_and_reads_decision(db):
     stored = so.get_outcome(CHAT, db=db)
     assert stored["kind"] == "decision"
     assert stored["items"][0]["card_id"] == tid and [c["value"] for c in stored["items"][0]["choices"]] == ["ship", "hold"]
+
+
+# Remote notices (defect kanban-a9b5d2c7c1): a notice about a card on ANOTHER gateway carries that owner's board
+# name, which does not exist here. The guarantee must not open a local board for it; it reads the
+# ``blocked_on_human`` flag the remote writer stored. [daveey]
+
+def _no_local_board(monkeypatch):
+    def refuse(*_a, **_k):
+        raise AssertionError("a remote notice must not open a local kanban board")
+    monkeypatch.setattr(kbc, "connect", refuse)
+
+
+@pytest.mark.parametrize("flag, expected", [(True, "refreshed:human"), (False, "dispatched")])
+def test_a_remote_notice_reads_its_flag_and_never_opens_a_local_board(db, monkeypatch, flag, expected):
+    _no_local_board(monkeypatch)
+    row = _notice(db, "⏸ Kanban t_remote1 on hub blocked — remote card", board="nosuchboard", task_id="t_remote1",
+                  gateway="hub", kanban_event_keys=["remote:hub:nosuchboard/default/t_remote1:blocked@1:default:x"],
+                  blocked_on_human=flag)
+
+    out, calls = _run(db)
+
+    assert [o["result"] for o in out] == [expected]
+    assert (calls == []) is flag
+    if not flag:
+        assert _closeout(db, row) == "started"
+
+
+def test_a_live_poller_row_of_only_remote_keys_is_remote_too(db, monkeypatch):
+    _no_local_board(monkeypatch)
+    _notice(db, "⏸ Kanban t_remote2 on hub blocked — remote card", blocked_on_human=True,
+            kanban_event_keys=["remote:hub:bb/default/t_remote2:blocked@1:default:x"])
+
+    out, calls = _run(db)
+
+    assert calls == [] and [o["result"] for o in out] == ["refreshed:human"]
+
+
+def test_a_local_notice_whose_board_is_gone_still_gets_a_closeout(db):
+    row = _notice(db, "✔ Kanban t_gone1 done — card on a deleted board", board="deletedboard", task_id="t_gone1")
+
+    out, calls = _run(db)
+
+    assert calls == [(CHAT, row)] and [o["result"] for o in out] == ["dispatched"]
+    assert _closeout(db, row) == "started"
+
+
+def test_a_notice_whose_handling_raises_is_stamped_error_once(db, monkeypatch):
+    row = _notice(db, "✔ Kanban t_aaa done — deploy card")
+
+    def boom(*_a, **_k):
+        raise RuntimeError("database is locked")
+    monkeypatch.setattr(ng, "started_last_hour", boom)
+
+    out, calls = _run(db)
+
+    assert calls == [] and [o["result"] for o in out] == ["error"]
+    assert _closeout(db, row) == "error"
+    assert ng.candidates(db, time.time()) == []  # handled once, not retried on every pass
+    stored = so.get_outcome(CHAT, db=db)
+    assert (stored["kind"], stored["reason"]) == ("unresolved", "notice_tail")
diff --git a/tui_gateway/kanban_remote_notices.py b/tui_gateway/kanban_remote_notices.py
index c19181be93d..d1322164a93 100644
--- a/tui_gateway/kanban_remote_notices.py
+++ b/tui_gateway/kanban_remote_notices.py
@@ -247,13 +247,28 @@ def _completion_text(gw: str, key: str, task: dict, me: str, profile: str, sid:
     return server._format_kanban_event_text(sub, SimpleNamespace(**task), ev, task.get("board", "default"))
 
 
+def remote_blocked_on_human(task: dict) -> bool:
+    """Whether a remote card is parked on a validated human request, from its replicated task record. Stored in
+    the notice's metadata: the notice guarantee cannot look the card up on this gateway. [daveey]"""
+    try:
+        from types import SimpleNamespace
+
+        from tui_gateway.kanban_unloaded import _blocked_on_human
+        return bool(_blocked_on_human(SimpleNamespace(status=task.get("status"), block_kind=task.get("block_kind"),
+                                                      human_request=task.get("human_request"))))
+    except Exception:
+        logger.debug("remote blocked_on_human check failed", exc_info=True)
+        return False
+
+
 def _notice_item(card: dict, session_key: str, me: str, profile: str) -> dict:
     task = card["task"]
     at = _terminal_at(task)
     sid = card.get("sid") or session_key
     text = _completion_text(card["gw"], card["key"], task, me, profile, sid)
     item = {"text": text or format_notice(card["gw"], card["key"], task), "session": session_key,
-            "ref": f"{card['gw']}/{card['key']}", "state": f"{task['status']}@{int(at) if at else 0}"}
+            "ref": f"{card['gw']}/{card['key']}", "state": f"{task['status']}@{int(at) if at else 0}",
+            "blocked_on_human": remote_blocked_on_human(task)}
     if text:
         item["event_key"] = _event_key(card["gw"], card["key"], task["completion_notice"])
     elif task.get("status") == "blocked":
@@ -573,11 +588,13 @@ def _sweep_payload(owner: str, key: str, task: dict, me: str, profile: str, sid:
         event_key = _event_key(owner, key, notice)
         metadata = {"notice_id": f"remote:{owner}:{key}:{event_id}:{profile}:{sid}",
                     "board": task.get("board", "default"), "task_id": task["id"],
-                    "gateway": owner, "event_ids": [event_id], "kanban_event_keys": [event_key]}
+                    "gateway": owner, "event_ids": [event_id], "kanban_event_keys": [event_key],
+                    "blocked_on_human": False}
         return event_key, metadata, _completion_text(owner, key, task, me, profile, sid)
     event_key = _shared_key(owner, key, task, profile, sid)
     metadata = {"notice_id": event_key, "board": task.get("board", "default"),
-                "task_id": task["id"], "gateway": owner, "kanban_event_keys": [event_key]}
+                "task_id": task["id"], "gateway": owner, "kanban_event_keys": [event_key],
+                "blocked_on_human": remote_blocked_on_human(task)}
     return event_key, metadata, format_notice(owner, key, task)
 
 
diff --git a/tui_gateway/notice_guarantee.py b/tui_gateway/notice_guarantee.py
index f5fc428b6ec..37f05de95cb 100644
--- a/tui_gateway/notice_guarantee.py
+++ b/tui_gateway/notice_guarantee.py
@@ -16,6 +16,11 @@ unloaded sweeper's loop therefore looks, in every profile store, for chats whose
 Ownership follows the unloaded sweeper's: a chat another live backend holds is that backend's (its own pass
 handles it); a chat with a live turn is skipped. The close-out prompt row is itself a notice, stamped as claimed,
 so a close-out never wakes another one.
+
+A notice about a card on another gateway (``gateway`` in its metadata, or only ``remote:`` event keys) is judged
+by the ``blocked_on_human`` flag its writer stored, never by a local board lookup: its ``board`` is the owner's.
+A candidate whose handling raises is stamped ``closeout.state = "error"`` once and left for the auditor, instead
+of being retried (and logged) on every pass.
 """
 
 from __future__ import annotations
@@ -93,20 +98,49 @@ def _stamp(db: Any, msg_id: int, verdict: str) -> None:
                        (json.dumps(meta, ensure_ascii=False), msg_id))
 
 
+def _this_gateway() -> str:
+    try:
+        from hermes_cli.kanban_origin import gateway_names
+        return gateway_names()[0]
+    except Exception:
+        logger.debug("notice guarantee: this gateway's name is unknown", exc_info=True)
+        return ""
+
+
+def _is_remote(meta: dict) -> bool:
+    """A notice about a card on another gateway: its ``board`` names the OWNER's board, not one here. [daveey]"""
+    gateway = str(meta.get("gateway") or "")
+    if gateway and gateway != _this_gateway():
+        return True
+    keys = [str(k) for k in meta.get("kanban_event_keys") or ()]
+    return bool(keys) and all(k.startswith("remote:") for k in keys)
+
+
 def blocked_on_human(cand: dict) -> bool:
-    """True when a card this notice is about is (still) parked on a validated human request."""
+    """True when a card this notice is about is (still) parked on a validated human request.
+
+    Remote notices (defect kanban-a9b5d2c7c1) read the ``blocked_on_human`` flag their writer stored and never open
+    a local board. A local notice whose board is gone or archived reads as not blocked, so its close-out runs."""
     from hermes_cli import kanban_db as _kb
     from hermes_cli import kanban_db_connect as _kbc
     from tui_gateway.kanban_unloaded import _blocked_on_human
     from tui_gateway.notice_fanout import _notice_tasks
     meta = cand["meta"]
+    flagged = bool(meta.get("blocked_on_human"))
+    if _is_remote(meta):
+        return flagged
     keys = [str(k) for k in meta.get("kanban_event_keys") or () if ":" in str(k) and not str(k).startswith("remote:")]
     board = meta.get("board") or (keys[0].rsplit(":", 1)[0] if keys else None)
     tasks = _notice_tasks(cand["content"], meta)
     if not tasks:
-        return False
-    with contextlib.closing(_kbc.connect(board=board) if board else _kbc.connect()) as conn:
-        return any(_blocked_on_human(_kb.get_task(conn, tid)) for tid in sorted(tasks))
+        return flagged
+    try:
+        conn = _kbc.connect(board=board) if board else _kbc.connect()
+    except ValueError:  # board deleted or archived since the notice: nothing here can be waiting on a human
+        logger.debug("notice guarantee: board %r of notice %s is gone", board, cand.get("msg_id"))
+        return flagged
+    with contextlib.closing(conn):
+        return flagged or any(_blocked_on_human(_kb.get_task(conn, tid)) for tid in sorted(tasks))
 
 
 def _wake(sid: str, msg_id: int) -> str:
@@ -180,6 +214,20 @@ def _handle(db, cand: dict, now: float, *, holders, session_db, wake, spawn) ->
     return "dispatched"
 
 
+def _give_up(db, cand: dict) -> str:
+    """A candidate whose handling raised: stamp it ``error`` (compare-and-swap, so a row another backend claimed
+    meanwhile is left alone) and refresh the outcome, which then reads ``unresolved{notice_tail}`` for the auditor.
+    Without the stamp the same row was retried and logged on every pass forever (349 warnings in one window). [daveey]"""
+    try:
+        meta = {**cand["meta"], "closeout": {"state": "error", "at": time.time(), "pid": os.getpid()}}
+        db._write_rowcount("UPDATE messages SET display_metadata = ? WHERE id = ? AND display_metadata IS ?",
+                           (json.dumps(meta, ensure_ascii=False), cand["msg_id"], cand["raw_meta"]))
+        _refresh(db, cand["sid"])
+    except Exception:
+        logger.debug("notice guarantee: could not stamp %s as error", cand["sid"], exc_info=True)
+    return "error"
+
+
 @contextlib.contextmanager
 def _profile_store(profile: Optional[str]) -> Iterator[Any]:
     from tui_gateway import server
@@ -214,7 +262,7 @@ def guarantee_pass(*, now: Optional[float] = None, stores: Callable[[], Iterator
                     result = _handle(db, cand, now, holders=holders, session_db=session_db, wake=wake, spawn=spawn)
                 except Exception:
                     logger.warning("notice guarantee failed for %s", cand["sid"], exc_info=True)
-                    result = "error"
+                    result = _give_up(db, cand)
                 out.append({"session_id": cand["sid"], "msg_id": cand["msg_id"], "result": result})
     except Exception:
         logger.warning("notice guarantee pass failed", exc_info=True)
