From b8a7f53c95447942403d5c5c94b62bb94c1c2f84 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 21:43:29 +0000
Subject: [PATCH] fix(ci): dry-run dispatch writes nothing; GET /api/sessions
 draft sweep opens writable only with drafts to archive [daveey]

bc67ee012ff stamped kanban.db on dry-run ticks (skip _record_dispatch_pass when dry_run);
851e72eed44 made every session-list poll open state.db writable and stamp last_draft_archive
(probe read-only, stamp only after archiving); the gateway-lock test fake lacked the new method.
Supersedes #226.
---
 hermes_cli/web_server_sessions.py             |  9 +++++++
 hermes_state_maintenance.py                   | 25 +++++++++++--------
 ...st_web_server_auto_archive_gateway_lock.py |  3 +++
 .../hermes_state/test_empty_draft_archive.py  | 11 ++++++++
 4 files changed, 38 insertions(+), 10 deletions(-)

diff --git a/hermes_cli/web_server_sessions.py b/hermes_cli/web_server_sessions.py
index 0c9452d04a1..f49a076aa56 100644
--- a/hermes_cli/web_server_sessions.py
+++ b/hermes_cli/web_server_sessions.py
@@ -252,6 +252,15 @@ def _maybe_auto_archive_for_profile(profile: Optional[str]) -> None:
         # of its own and a bare lock-file probe would report stopped.
         if _check_gateway_running(profile_home):
             return
+        if not cfg.get("auto_archive", False):
+            # Draft sweep only: opening the store writable bumps the WAL data_version even when
+            # nothing is archived, which a GET /api/sessions poll must not do. Ask read-only first.
+            probe = _open_session_db_for_profile(profile, read_only=True)
+            try:
+                if not probe.empty_draft_ids():
+                    return
+            finally:
+                probe.close()
         db = _open_session_db_for_profile(profile, read_only=False)
         try:
             db.maybe_archive_empty_drafts()  # [daveey] not gated by sessions.auto_archive
diff --git a/hermes_state_maintenance.py b/hermes_state_maintenance.py
index 56c6b3d77a0..a2c154d7137 100644
--- a/hermes_state_maintenance.py
+++ b/hermes_state_maintenance.py
@@ -324,12 +324,12 @@ class SessionMaintenanceMixin:
     DRAFT_MAX_AGE_S = 86400.0
     DRAFT_SWEEP_INTERVAL_S = 3600.0
 
-    def archive_empty_drafts(self, *, older_than_s: float = DRAFT_MAX_AGE_S) -> int:
-        """Archive (soft-hide, sweep provenance) interactive rows that never got a message and were last
-        touched ``older_than_s`` ago. Pinned rows, the hidden canonical Bot Chat and compression
-        continuations are exempt. Returns rows archived."""
+    def empty_draft_ids(self, *, older_than_s: float = DRAFT_MAX_AGE_S) -> list:
+        """Ids of interactive rows that never got a message and were last touched ``older_than_s`` ago
+        (read-only, so a read-only handle can ask before anyone opens the store writable). Pinned rows,
+        the hidden canonical Bot Chat and compression continuations are exempt."""
         cutoff = time.time() - float(older_than_s)
-        rows = self._read_all(
+        return [r[0] for r in self._read_all(
             f"""
             SELECT s.id FROM sessions s
             WHERE s.archived = 0
@@ -342,24 +342,29 @@ class SessionMaintenanceMixin:
               AND NOT EXISTS (SELECT 1 FROM sessions p WHERE p.id = s.parent_session_id
                                 AND p.end_reason = 'compression')
               AND {_LAST_ACTIVE_SQL} < ?
-            """, (*self.DRAFT_SOURCES, self.CANONICAL_BOT_CHAT_TITLE, cutoff))
+            """, (*self.DRAFT_SOURCES, self.CANONICAL_BOT_CHAT_TITLE, cutoff))]
+
+    def archive_empty_drafts(self, *, older_than_s: float = DRAFT_MAX_AGE_S) -> int:
+        """Archive (soft-hide, sweep provenance) the :meth:`empty_draft_ids` rows. Returns rows archived."""
+        rows = self.empty_draft_ids(older_than_s=older_than_s)
         for row in rows:
-            self._auto_archive_lineage(row[0])
+            self._auto_archive_lineage(row)
         if rows:
             logger.info("state.db: archived %d empty draft session(s) older than %.0fh", len(rows),
                         older_than_s / 3600)
         return len(rows)
 
     def maybe_archive_empty_drafts(self) -> int:
-        """:meth:`archive_empty_drafts` at most once per ``DRAFT_SWEEP_INTERVAL_S`` (state_meta
-        ``last_draft_archive``). Runs whatever ``sessions.auto_archive`` says. Never raises."""
+        """:meth:`archive_empty_drafts` at most once per ``DRAFT_SWEEP_INTERVAL_S`` after a sweep
+        that archived rows (state_meta ``last_draft_archive``; an empty sweep is read-only). Runs whatever ``sessions.auto_archive`` says. Never raises."""
         try:
             now = time.time()
             since = _seconds_since(now, self.get_meta("last_draft_archive"))
             if since is not None and since < self.DRAFT_SWEEP_INTERVAL_S:
                 return 0
             count = self.archive_empty_drafts()
-            self.set_meta("last_draft_archive", str(now))
+            if count:  # a sweep that found nothing writes nothing: GET /api/sessions polls reach here
+                self.set_meta("last_draft_archive", str(now))
             return count
         except Exception:  # health: allow BLE001 -- a maintenance chore must never break its tick; logged
             logger.warning("state.db empty-draft archive failed", exc_info=True)
diff --git a/tests/hermes_cli/test_web_server_auto_archive_gateway_lock.py b/tests/hermes_cli/test_web_server_auto_archive_gateway_lock.py
index 95a0f22a751..0905d08a431 100644
--- a/tests/hermes_cli/test_web_server_auto_archive_gateway_lock.py
+++ b/tests/hermes_cli/test_web_server_auto_archive_gateway_lock.py
@@ -35,6 +35,9 @@ class _FakeDB:
     def __init__(self, archived):
         self._archived = archived
 
+    def maybe_archive_empty_drafts(self):
+        return 0
+
     def maybe_auto_archive(self, **kwargs):
         self._archived.append(kwargs)
 
diff --git a/tests/hermes_state/test_empty_draft_archive.py b/tests/hermes_state/test_empty_draft_archive.py
index 91a64de13f4..86d9327ef10 100644
--- a/tests/hermes_state/test_empty_draft_archive.py
+++ b/tests/hermes_state/test_empty_draft_archive.py
@@ -59,3 +59,14 @@ def test_gateway_maintenance_tick_archives_drafts_without_auto_archive(monkeypat
     run._housekeeping_state_db_maintenance()
 
     assert _archived(db, "old")
+
+
+def test_empty_sweep_writes_nothing_and_ids_are_listed_read_only(db):
+    """A sweep that finds no draft stamps no state_meta row (GET /api/sessions polls reach it), and
+    ``empty_draft_ids`` lets a read-only handle ask before the store is opened writable."""
+    _draft(db, "young", 2)
+    assert db.empty_draft_ids() == []
+    assert db.maybe_archive_empty_drafts() == 0
+    assert db.get_meta("last_draft_archive") is None
+    _draft(db, "old", 30)
+    assert db.empty_draft_ids() == ["old"]
-- 
