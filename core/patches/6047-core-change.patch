diff --git a/tests/hermes_cli/test_native_watch_rearm.py b/tests/hermes_cli/test_native_watch_rearm.py
new file mode 100644
index 00000000000..6c0cdb5eb46
--- /dev/null
+++ b/tests/hermes_cli/test_native_watch_rearm.py
@@ -0,0 +1,54 @@
+"""Ordinary writes hint without tearing down native coverage. [daveey]"""
+import sys
+import time
+
+import pytest
+
+from hermes_cli.annotation_file_events import FileEvents
+from hermes_cli.fact_source_watch import NativeSourceWatch
+from tests.waiting import wait_until
+
+pytestmark = pytest.mark.skipif(
+    not sys.platform.startswith('linux'), reason='Linux native notification boundary')
+
+
+def test_ordinary_writes_hint_without_reinstall(tmp_path, monkeypatch):
+    path = tmp_path / 'state.db'
+    path.write_bytes(b'init')
+    hints = []
+    original = FileEvents.replace
+    calls = []
+
+    def counted(self, *args, **kwargs):
+        calls.append(self)
+        return original(self, *args, **kwargs)
+
+    monkeypatch.setattr(FileEvents, 'replace', counted)
+    watch = NativeSourceWatch((path,), lambda: hints.append(time.monotonic()))
+    try:
+        assert wait_until(lambda: calls, timeout=2), 'coverage must install before writes'
+        baseline = len(calls)
+        for i in range(12):
+            path.write_bytes(b'x' * (i + 1))
+        assert wait_until(lambda: hints, timeout=2), 'native watch must hint on ordinary writes'
+        assert len(calls) == baseline, (
+            'ordinary IN_MODIFY must not replace inotify coverage; '
+            f'got {len(calls)} installs after {baseline} baseline')
+    finally:
+        watch.close()
+
+
+def test_new_parent_directory_retains_future_write_hints(tmp_path):
+    path = tmp_path / 'later' / 'state.db'
+    hints = []
+    watch = NativeSourceWatch((path,), lambda: hints.append(time.monotonic()))
+    try:
+        path.parent.mkdir()
+        assert wait_until(lambda: hints, timeout=2)
+        watch._owner.submit(lambda: None).wait()
+        baseline = len(hints)
+        path.write_bytes(b'new source')
+        assert wait_until(lambda: len(hints) > baseline, timeout=2), (
+            'ancestor creation must install coverage for future source writes')
+    finally:
+        watch.close()
diff --git a/tests/hermes_cli/test_review_enqueue_wakeup.py b/tests/hermes_cli/test_review_enqueue_wakeup.py
new file mode 100644
index 00000000000..70c97af1802
--- /dev/null
+++ b/tests/hermes_cli/test_review_enqueue_wakeup.py
@@ -0,0 +1,34 @@
+"""Local delivery still wakes after publication with main's original lock order. [daveey]"""
+import threading
+
+import pytest
+
+from hermes_cli.fact_contract import Fact, FactKey, Scope
+from hermes_cli.fact_inprocess import InProcessFacts, IncrementalLifecycle
+from hermes_cli.fact_store import FactStore
+
+
+@pytest.mark.parametrize('post_enqueue_notify', [False, True])
+def test_quiet_publication_wakes_local_delivery(monkeypatch, post_enqueue_notify):
+    store = FactStore()
+    scope = Scope('review', 'default')
+    owner = InProcessFacts(store, {scope}, demand=lambda *args: None)
+    handle = owner.acquire(scope, lifecycle=IncrementalLifecycle({(scope, 'board')}))
+    initial = threading.Event()
+    delivered = threading.Event()
+
+    def receive(delta):
+        (delivered if delta.upserts else initial).set()
+
+    sub = handle.v1.subscribe(scope, (), None, None, receive)
+    try:
+        assert initial.wait(3)
+        store.publish([Fact(FactKey(scope, 'TaskFact', 't'), {'v': 1})])
+        if post_enqueue_notify:
+            with store._condition:
+                store._condition.notify_all()
+        assert delivered.wait(2), 'committed delta queued but local delivery slept through its only wake'
+    finally:
+        sub.close()
+        handle.close()
+        owner.close()
diff --git a/tests/hermes_cli/test_review_expiry_enqueue_lock.py b/tests/hermes_cli/test_review_expiry_enqueue_lock.py
new file mode 100644
index 00000000000..cf3d77c5398
--- /dev/null
+++ b/tests/hermes_cli/test_review_expiry_enqueue_lock.py
@@ -0,0 +1,45 @@
+"""Expiry publication and ordinary publish both finish under main's lock order. [daveey]"""
+import threading
+import time
+
+import pytest
+
+from hermes_cli.fact_contract import Fact, FactKey, Scope
+from hermes_cli.fact_expiry import ExpiryWorker
+from hermes_cli.fact_store import FactStore
+
+
+@pytest.mark.parametrize('expiry', [False, True])
+def test_expiry_and_offlock_enqueue_make_progress(monkeypatch, expiry):
+    store = FactStore()
+    scope = Scope('review', 'default')
+    expires = FactKey(scope, 'TaskFact', 'expires')
+    key = FactKey(scope, 'TaskFact', 'other')
+    store.publish([Fact(expires, {'v': 0}, health='fresh', valid_until=time.time() - 1)])
+    store.subscribe(scope, (), None, None, lambda delta: None)
+    store.drain()
+    first = threading.Thread(name='review-publisher', target=lambda: store.publish([Fact(key, {'v': 1})]))
+    first.start()
+    worker = None
+    second = None
+    try:
+        if expiry:
+            worker = ExpiryWorker(store)
+        else:
+            second = threading.Thread(target=lambda: store.publish([Fact(key, {'v': 2})]))
+            second.start()
+        first.join(4)
+        if second:
+            second.join(4)
+        assert not first.is_alive()
+        if second:
+            assert not second.is_alive()
+        if expiry:
+            expired = store.snapshot(scope).get(expires)
+            assert expired is not None and expired.health == 'stale'
+    finally:
+        first.join(5)
+        if second:
+            second.join(5)
+        if worker:
+            worker.close()
