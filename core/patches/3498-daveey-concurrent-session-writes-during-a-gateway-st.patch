From 4b3ad9ca4fe911e7b71d972b82989c1f62330a39 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 12:34:56 +0000
Subject: [PATCH] [daveey] concurrent session writes during a gateway start
 share one home's owner reads

Follow-up to #2150 (review 5890602012, two non-blocking nits).

1. Budget guard. OWNER_STARTING_BUDGET_S was tied to Desktop's request
   deadline only by a comment. The starting test now reads
   DEFAULT_FETCH_TIMEOUT_MS from apps/desktop/electron/hardening.ts (the
   constant lives there, not under apps/desktop/src), fails loudly when the
   literal is not found, and asserts
   OWNER_STARTING_BUDGET_S + OWNER_DISCOVERY_ATTEMPT_S < that deadline.
   No runtime change.

2. Shared reads. Each write that saw `starting` polled the control socket on
   its own (one default-executor thread per read, every 0.5 s, up to 24 s),
   so a bulk archive of N sessions during a restart made N reads per poll.
   discover_session_owner now gets each read from _shared_read: the home's
   newest read is joined when it began no more than one poll interval before
   the caller asked and after the caller's own previous read; otherwise the
   caller starts one. A read that already answered is joined only on a
   re-read once `starting` was seen, so a request's first read never reuses
   an earlier request's verdict. Reads are shielded, so a caller leaving on
   its own deadline never cancels the read for others.

   Kept: discovery stays read-only and never starts a gateway; the mutation
   is still sent at most once per request (the caller's code is unchanged);
   each caller keeps its own deadline from its own first read and its own
   attempt count; no verdict older than one poll interval is taken.

   Design note: callers keep their own (timer-only) loops rather than one
   background poller task per home. The costly part was the reads and their
   executor threads, which are now single-flight per home; the per-caller
   loop keeps each caller's deadline and needs no task lifecycle.

Tests (tests/hermes_cli/test_session_owner_discovery_starting.py):
- 20 concurrent writes during `starting` then live: 5-8 reads (main: 24),
  all 20 land, one session.mutate each, nothing offline.
- 20 concurrent writes behind a persisting `starting`: every one gets the
  STARTING_DETAIL 503, each tried the lock once, none forwarded, reads
  <= budget/poll + 4 (main: 80).
- a late caller keeps its own budget (not cut at the first caller's
  deadline, not kept past its own); reads bounded by elapsed/poll.
- _shared_read freshness: joined within one poll only, never the caller's
  own previous read, a first read never reuses a settled read.
RED on origin/main: the 4 behavior tests fail (24 reads, 80 reads,
20 reads, no _shared_read). The budget guard passes on main by design; it
goes RED with DEFAULT_FETCH_TIMEOUT_MS = 25_000 (24 + 1.5 < 25 fails) and
with a re-spelled literal (literal not found).
GREEN: the starting, retry, maintenance_http, mutation_standalone,
owner_forward, mute_live_owner, canonical_cron, cron_run_history_sessions
and gateway_runtime_home_identity files: 86 passed.
---
 hermes_cli/session_owner_discovery.py         |  66 +++++++-
 .../test_session_owner_discovery_starting.py  | 158 +++++++++++++++++-
 2 files changed, 216 insertions(+), 8 deletions(-)

diff --git a/hermes_cli/session_owner_discovery.py b/hermes_cli/session_owner_discovery.py
index 40b278f9b6..49e89ba485 100644
--- a/hermes_cli/session_owner_discovery.py
+++ b/hermes_cli/session_owner_discovery.py
@@ -21,12 +21,22 @@ Every other verdict is final on its first read: ``absent`` keeps the offline pat
 about authorization, protocol, permissions or profile identity are never retried. Discovery never
 starts a gateway, and the mutation itself is never retried here: the caller sends it at most
 once, and a client retry replays its own request_id.
+
+Reads of one home are shared. A Desktop bulk archive sent during a restart is many writes at
+once, and each used to poll the starting gateway's control socket on its own (one executor
+thread per read, every ``OWNER_STARTING_POLL_S``, for up to ``OWNER_STARTING_BUDGET_S``). A
+caller now awaits the newest read of its home when that read began no more than one poll
+interval before the caller asked, and starts a read only when there is none, so the reads of N
+concurrent writes do not grow with N. Each caller keeps its own deadline and attempt count.
 """
 
 from __future__ import annotations
 
 import asyncio
+import os
 import time
+import weakref
+from dataclasses import dataclass
 from pathlib import Path
 
 # Total wall-clock spent discovering one write's owner, from the request's point of view.
@@ -39,7 +49,8 @@ OWNER_DISCOVERY_BACKOFF_S = 0.25
 _MIN_ATTEMPT_S = 0.1
 
 # One write's whole wait for a gateway seen ``starting``, measured from the first read. Desktop
-# cuts a request at 30 s (DEFAULT_FETCH_TIMEOUT_MS), so this leaves the forward its own seconds.
+# cuts a request at 30 s (DEFAULT_FETCH_TIMEOUT_MS in apps/desktop/electron/hardening.ts; the
+# starting tests read it from there), so this leaves the forward its own seconds.
 OWNER_STARTING_BUDGET_S = 24.0
 # A ``starting`` read answers at once (lock probe or identify), so it is polled, not backed off.
 OWNER_STARTING_POLL_S = 0.5
@@ -81,6 +92,45 @@ def _timed_out():
     return GatewayDiscovery("inaccessible", reason_code=CONTROL_TIMEOUT)
 
 
+@dataclass(frozen=True)
+class _Read:
+    """One identify of a home: when it began (the caller's clock) and its pending verdict."""
+    began: float
+    verdict: asyncio.Future
+
+
+# The newest read of each home, per event loop (a future belongs to one loop).
+_NEWEST: weakref.WeakKeyDictionary = weakref.WeakKeyDictionary()
+
+
+def _retrieve(future):
+    if not future.cancelled():
+        future.exception()  # every waiter may have left on its own deadline: never "never retrieved"
+
+
+def _shared_read(home: Path, timeout: float, *, asked: float, after: float | None, settled_ok: bool) -> _Read:
+    """The read a caller asking at *asked* awaits: the home's newest, or a new one.
+
+    The newest read is joined when it began no earlier than one poll interval before *asked*
+    (the verdict is never staler than a poll the caller would have made itself) and after the
+    caller's own previous read (*after*), so a re-read is always a newer observation. A read that
+    already answered is joined only on a re-read of a gateway seen starting (*settled_ok*); a
+    caller's first read never reuses an earlier request's verdict."""
+    from hermes_cli import gateway_runtime
+
+    reads = _NEWEST.setdefault(asyncio.get_running_loop(), {})
+    key = os.fspath(home)
+    newest = reads.get(key)
+    if (newest is not None and newest.began >= asked - OWNER_STARTING_POLL_S
+            and (after is None or newest.began > after) and (settled_ok or not newest.verdict.done())):
+        return newest
+    verdict = asyncio.ensure_future(asyncio.to_thread(gateway_runtime.discover_gateway_endpoint, home,
+                                                      timeout=timeout))
+    verdict.add_done_callback(_retrieve)
+    reads[key] = read = _Read(asked, verdict)
+    return read
+
+
 async def discover_session_owner(home: Path, *, clock=time.monotonic, sleep=asyncio.sleep):
     """Discovery's verdict for *home*, re-reading ``control_timeout`` and ``starting`` in budget.
 
@@ -92,12 +142,13 @@ async def discover_session_owner(home: Path, *, clock=time.monotonic, sleep=asyn
     Until a read says ``starting`` the budget is ``OWNER_DISCOVERY_BUDGET_S`` and at most
     ``OWNER_DISCOVERY_ATTEMPTS`` reads. The first ``starting`` moves the deadline to
     ``OWNER_STARTING_BUDGET_S`` after the first read began and lifts the read cap: from then on
-    both transient verdicts are re-read until another verdict or that deadline."""
-    from hermes_cli import gateway_runtime
+    both transient verdicts are re-read until another verdict or that deadline.
 
+    Reads are shared with concurrent callers for the same home (``_shared_read``); the shared
+    read is shielded, so a caller that leaves on its own deadline never cancels it for others."""
     began = clock()
     deadline = began + OWNER_DISCOVERY_BUDGET_S
-    discovery, starting, attempt = None, False, 0
+    discovery, starting, attempt, last = None, False, 0, None
     while starting or attempt < OWNER_DISCOVERY_ATTEMPTS:
         pause = OWNER_STARTING_POLL_S if is_starting(discovery) else OWNER_DISCOVERY_BACKOFF_S
         remaining = deadline - clock()
@@ -107,10 +158,11 @@ async def discover_session_owner(home: Path, *, clock=time.monotonic, sleep=asyn
             await sleep(pause)
             remaining = deadline - clock()
         attempt += 1
-        read = asyncio.to_thread(gateway_runtime.discover_gateway_endpoint, home,
-                                 timeout=min(OWNER_DISCOVERY_ATTEMPT_S, remaining))
+        read = _shared_read(home, min(OWNER_DISCOVERY_ATTEMPT_S, remaining), asked=clock(), after=last,
+                            settled_ok=starting)
+        last = read.began
         try:
-            discovery = await asyncio.wait_for(read, timeout=remaining)
+            discovery = await asyncio.wait_for(asyncio.shield(read.verdict), timeout=remaining)
         except TimeoutError:
             discovery = _timed_out()
         if is_starting(discovery):
diff --git a/tests/hermes_cli/test_session_owner_discovery_starting.py b/tests/hermes_cli/test_session_owner_discovery_starting.py
index dada7a9aa8..b127678e55 100644
--- a/tests/hermes_cli/test_session_owner_discovery_starting.py
+++ b/tests/hermes_cli/test_session_owner_discovery_starting.py
@@ -105,8 +105,24 @@ def test_the_detail_names_starting_only_for_starting():
     assert sod.owner_unavailable_detail(refused, DRAIN_ADVICE) == f'owner_unavailable: authorization: {DRAIN_ADVICE}'
 
 
+def _desktop_request_timeout_s():
+    """Desktop's default request deadline, read from its source: a renamed or re-spelled constant
+    fails here instead of silently unpinning the budget below."""
+    import re
+
+    source = Path(__file__).resolve().parents[2] / 'apps' / 'desktop' / 'electron' / 'hardening.ts'
+    found = re.search(r'^const DEFAULT_FETCH_TIMEOUT_MS = ([0-9_]+)$', source.read_text(), re.MULTILINE)
+    assert found, f'DEFAULT_FETCH_TIMEOUT_MS literal not found in {source}'
+    return int(found.group(1).replace('_', '')) / 1000
+
+
 def test_the_starting_budget_fits_under_the_desktop_request_deadline():
-    assert sod.OWNER_DISCOVERY_BUDGET_S < sod.OWNER_STARTING_BUDGET_S <= 25.0  # Desktop cuts at 30 s
+    """A write waits at most the starting budget plus one read that began just before it ran out;
+    the forward still needs its own seconds before Desktop cuts the request."""
+    desktop = _desktop_request_timeout_s()
+    assert desktop >= 1.0  # a sanity floor on the parse, not on Desktop's choice
+    assert sod.OWNER_STARTING_BUDGET_S + sod.OWNER_DISCOVERY_ATTEMPT_S < desktop
+    assert sod.OWNER_DISCOVERY_BUDGET_S < sod.OWNER_STARTING_BUDGET_S
     assert 0 < sod.OWNER_STARTING_POLL_S <= 1.0
 
 
@@ -243,6 +259,146 @@ def test_live_owner_forward_answers_the_starting_detail(tmp_path, monkeypatch):
     assert len(seen) > sod.OWNER_DISCOVERY_ATTEMPTS
 
 
+# --- Concurrent writes share the starting re-reads of one home. ---
+
+N_WRITES = 20
+
+
+def _counted_reads(monkeypatch, verdict_for):
+    """Discovery answers ``verdict_for(n)`` for the n-th read (1-based), counted across callers."""
+    import threading
+
+    lock, seen = threading.Lock(), []
+
+    def fake(home, timeout=2.0):
+        with lock:
+            seen.append(timeout)
+            n = len(seen)
+        return verdict_for(n)
+    monkeypatch.setattr('hermes_cli.gateway_runtime.discover_gateway_endpoint', fake)
+    return seen
+
+
+@pytest.mark.asyncio
+async def test_concurrent_writes_during_starting_share_reads_and_each_sends_one_mutation(tmp_path, monkeypatch):
+    """A bulk archive sent while the gateway starts: reads do not grow with the number of writes,
+    every write lands once the gateway is live, and each sends exactly one mutation."""
+    import asyncio
+    from hermes_cli import web_server_sessions
+
+    _no_backoff(monkeypatch)
+    monkeypatch.setattr(sod, 'OWNER_STARTING_POLL_S', 0.02)
+    request = _standalone_request(monkeypatch, tmp_path)
+    seen = _counted_reads(monkeypatch, lambda n: STARTING if n <= 4 else READY)
+    rpcs, offline = [], []
+
+    class Client:
+        async def rpc(self, method, **params):
+            rpcs.append(params['request_id'])
+            return {'session_id': params['session_id'], 'operation': 'sidebar', 'revision': 1}
+
+    @asynccontextmanager
+    async def connect(endpoint=None, subject=None):
+        assert endpoint == 'owner-endpoint'
+        yield Client()
+    monkeypatch.setattr('hermes_cli.gateway_client.connect_gateway', connect)
+    monkeypatch.setattr(web_server_sessions, '_mutate_offline_store',
+                        lambda profile, actor, params: offline.append(params))
+    results = await asyncio.gather(*(web_server_sessions._mutate_session_request(
+        request, None, f's{i}', request_id=f'req-{i}', expected_revision=0,
+        operation='sidebar', payload={'archived': True}, expected_generation=0) for i in range(N_WRITES)))
+    assert [result['ok'] for result in results] == [True] * N_WRITES
+    assert sorted(rpcs) == sorted(f'req-{i}' for i in range(N_WRITES))  # one mutation each
+    assert offline == []
+    # Four starting reads, then the one that saw it live: a constant, not one poll per write.
+    assert 5 <= len(seen) <= 8, len(seen)
+
+
+@pytest.mark.asyncio
+async def test_concurrent_writes_behind_a_persisting_start_each_answer_the_starting_503(tmp_path, monkeypatch):
+    import asyncio
+    from hermes_cli import web_server_sessions
+
+    _no_backoff(monkeypatch)
+    budget, poll = 0.3, 0.05
+    monkeypatch.setattr(sod, 'OWNER_STARTING_BUDGET_S', budget)
+    monkeypatch.setattr(sod, 'OWNER_STARTING_POLL_S', poll)
+    request = _standalone_request(monkeypatch, tmp_path)
+    seen = _counted_reads(monkeypatch, lambda _n: STARTING)
+    attempts, connects = [], []
+    monkeypatch.setattr('hermes_cli.gateway_client.connect_gateway', lambda **kw: connects.append(kw))
+    with _held(attempts) as held:
+        monkeypatch.setattr('gateway.runtime_ownership.exclusive_maintenance', held)
+        results = await asyncio.gather(*(web_server_sessions._mutate_session_request(
+            request, None, f's{i}', request_id=f'req-{i}', expected_revision=0,
+            operation='sidebar', payload={'archived': True}) for i in range(N_WRITES)),
+            return_exceptions=True)
+    refusals = [exc for exc in results if isinstance(exc, HTTPException)]
+    assert len(refusals) == N_WRITES, results
+    assert {(exc.status_code, exc.detail) for exc in refusals} == {(503, sod.STARTING_DETAIL)}
+    assert len(attempts) == N_WRITES and connects == []  # each tried the lock once; none forwarded
+    # Reads are spaced by the poll interval across all writes, so they fit the budget's polls.
+    assert sod.OWNER_DISCOVERY_ATTEMPTS < len(seen) <= budget / poll + 4, len(seen)
+
+
+@pytest.mark.asyncio
+async def test_a_late_caller_keeps_its_own_budget(tmp_path, monkeypatch):
+    """A write that joins a starting wait already under way waits its own budget from its own first
+    read: it is neither cut at the earlier write's deadline nor kept past its own."""
+    import asyncio
+
+    budget, poll = 0.6, 0.05
+    monkeypatch.setattr(sod, 'OWNER_STARTING_BUDGET_S', budget)
+    monkeypatch.setattr(sod, 'OWNER_STARTING_POLL_S', poll)
+    loop, fourth = asyncio.get_running_loop(), asyncio.Event()
+
+    def verdict(n):
+        if n == 4:
+            loop.call_soon_threadsafe(fourth.set)
+        return STARTING
+    seen = _counted_reads(monkeypatch, verdict)
+
+    async def timed():
+        began = time.monotonic()
+        result = await sod.discover_session_owner(tmp_path)
+        return result, began, time.monotonic()
+
+    first = asyncio.ensure_future(timed())
+    await fourth.wait()
+    late = await timed()
+    early = await first
+    assert early[0] is STARTING and late[0] is STARTING
+    assert late[1] > early[1]
+    for _verdict, began, ended in (early, late):
+        assert budget - poll - sod._MIN_ATTEMPT_S - 0.05 < ended - began <= budget + 1.0, (began, ended)
+    assert late[2] > early[2]  # the late write was not cut at the first write's deadline
+    assert len(seen) <= (late[2] - early[1]) / poll + 3, len(seen)
+
+
+@pytest.mark.asyncio
+async def test_a_shared_read_is_joined_only_within_one_poll_interval(tmp_path, monkeypatch):
+    """A caller never takes a verdict that began more than one poll before it asked, nor its own
+    previous read again; a first read never reuses a read that already answered."""
+    from hermes_cli import gateway_runtime
+
+    monkeypatch.setattr(gateway_runtime, 'discover_gateway_endpoint', lambda home, timeout=2.0: STARTING)
+    poll = sod.OWNER_STARTING_POLL_S
+    read = sod._shared_read(tmp_path, 1.5, asked=10.0, after=None, settled_ok=False)
+    assert sod._shared_read(tmp_path, 1.5, asked=10.0 + poll / 2, after=None, settled_ok=False) is read
+    assert await read.verdict is STARTING
+    assert sod._shared_read(tmp_path, 1.5, asked=10.0 + poll / 2, after=9.0, settled_ok=True) is read
+    newer = sod._shared_read(tmp_path, 1.5, asked=10.0 + poll / 2, after=None, settled_ok=False)
+    assert newer is not read and await newer.verdict is STARTING  # first reads: in flight only
+    stale = sod._shared_read(tmp_path, 1.5, asked=newer.began + poll + 0.01, after=None, settled_ok=True)
+    assert stale is not newer
+    own = sod._shared_read(tmp_path, 1.5, asked=stale.began, after=stale.began, settled_ok=True)
+    assert own is not stale
+    other = sod._shared_read(tmp_path / 'other', 1.5, asked=own.began, after=None, settled_ok=True)
+    assert other is not own
+    for pending in (stale, own, other):
+        await pending.verdict
+
+
 # --- A real reservation, and a real gateway caught while it starts (never a live one). ---
 
 BODY = {'request_id': 'archive-1', 'expected_revision': 0, 'expected_generation': 0,
