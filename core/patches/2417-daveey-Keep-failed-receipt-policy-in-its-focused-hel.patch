From e60f7045741a907169737eec79530fbfa0b65961 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 21:33:23 +0000
Subject: [PATCH] [daveey] Keep failed-receipt policy in its focused helper

---
 hermes_cli/kanban_db.py                              |  3 +--
 hermes_cli/kanban_db_dispatch.py                     | 12 +++---------
 hermes_cli/kanban_failed_result.py                   | 10 ++++++++++
 .../test_kanban_failed_result_reconcile.py           |  4 ++--
 4 files changed, 16 insertions(+), 13 deletions(-)

diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index 5fb0f9503f..66ad39a807 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -1568,8 +1568,7 @@ def link_tasks(
     parent_id: str,
     child_id: str,
     *,
-    expected_child_run_id: Optional[int] = None,
-    allow_nested: bool = False,
+    expected_child_run_id: Optional[int] = None, allow_nested: bool = False,
 ) -> bool:
     """Link ``parent_id -> child_id``. Returns True when the link gated a
     ``ready`` child back to ``todo`` (the new parent is not yet terminal), so
diff --git a/hermes_cli/kanban_db_dispatch.py b/hermes_cli/kanban_db_dispatch.py
index 756df23161..f9b2a0de4e 100644
--- a/hermes_cli/kanban_db_dispatch.py
+++ b/hermes_cli/kanban_db_dispatch.py
@@ -1326,15 +1326,9 @@ def _reclaim_dead_workers(conn: sqlite3.Connection, board: Optional[str] = None,
                 continue
             if _worker_alive(row["worker_pid"], _kb._row_get(row, "worker_started_at")):
                 continue
-            # An ambiguous receipt holds the card while the attempt may still run; once nothing
-            # can be executing it (a dead bound interpreter, or a run that never bound one): crash.
-            from hermes_cli.kanban_failed_result import failed_result_proof, failed_result_receipt
-            proof = failed_result_proof(conn, row['id'], row['current_run_id'], row['claim_lock'])
-            receipt = failed_result_receipt(conn, row['id'], row['current_run_id'], row['claim_lock'])
-            if proof is None and (failed_results_only or (
-                    receipt is not None and receipt['result'].get('death_proof_version') == 1)):
-                # Versioned receipts require the two-process fence even during
-                # ordinary dispatch. Historical receipts retain legacy recovery.
+            from hermes_cli.kanban_failed_result import reclaim_proof
+            proof, hold = reclaim_proof(conn, row, failed_results_only=failed_results_only)
+            if hold:
                 continue
             if proof is None and owner_reclaim_blocked(conn, row["id"], crash_sweep=True):
                 continue
diff --git a/hermes_cli/kanban_failed_result.py b/hermes_cli/kanban_failed_result.py
index a0cf94fc41..d511c3fe98 100644
--- a/hermes_cli/kanban_failed_result.py
+++ b/hermes_cli/kanban_failed_result.py
@@ -120,6 +120,16 @@ def failed_result_receipt(conn, task_id, run_id, claim_lock):
             'bound': (bound.get('pid'), bound.get('started_at'))}
 
 
+def reclaim_proof(conn, row, *, failed_results_only=False):
+    """Keep strict receipt vetoes distinct from unsupported legacy recovery."""
+    identity = (row['id'], row['current_run_id'], row['claim_lock'])
+    proof = failed_result_proof(conn, *identity)
+    receipt = failed_result_receipt(conn, *identity)
+    hold = proof is None and (failed_results_only or (
+        receipt is not None and receipt['result'].get('death_proof_version') == 1))
+    return proof, hold
+
+
 def failed_result_proof(conn, task_id, run_id, claim_lock):
     """Return latest attributable failed result only after both processes exit."""
     receipt = failed_result_receipt(conn, task_id, run_id, claim_lock)
diff --git a/tests/hermes_cli/test_kanban_failed_result_reconcile.py b/tests/hermes_cli/test_kanban_failed_result_reconcile.py
index 3a47ffe465..28abb9d336 100644
--- a/tests/hermes_cli/test_kanban_failed_result_reconcile.py
+++ b/tests/hermes_cli/test_kanban_failed_result_reconcile.py
@@ -186,7 +186,7 @@ def test_observer_waits_for_distinct_outer_process(board):
                              stdin=subprocess.PIPE, env=build_subprocess_env())
     try:
         _failed_child(conn, context, observe=True, outer_pid=outer.pid)
-        time.sleep(1)
+        time.sleep(1)  # health: allow HX013 -- prove the observer does not close during a live-outer window
         assert conn.execute('SELECT status FROM task_runs WHERE id=?',
                             (context['run_id'],)).fetchone()[0] == 'running'
         assert outer.stdin is not None
@@ -238,7 +238,7 @@ def test_failed_receipt_waits_for_real_bound_process(board, entry):
             assert child.poll() is None
             assert conn.execute('SELECT status FROM task_runs WHERE id=?',
                                 (context['run_id'],)).fetchone()[0] == 'running'
-            time.sleep(.05)
+            time.sleep(.05)  # health: allow HX013 -- bounded negative observation while bound worker stays live
         child.communicate('x', timeout=5)
         deadline = time.monotonic() + 5
         state = 'running'
-- 
