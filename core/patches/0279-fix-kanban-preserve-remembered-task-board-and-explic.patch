From 27f2821f37f0c1b264ff4f0f1456d50270a686d8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 24 Oct 2026 05:11:28 +0000
Subject: [PATCH] fix(kanban): preserve remembered task board and explicit
 profile [daveey]


Public-series adaptation: preserve merged preceding changes.

---
diff --git a/apps/desktop/src/plugins/kanban/api.gateways.test.ts b/apps/desktop/src/plugins/kanban/api.gateways.test.ts
index b5eaa7d73adc28d952d0ff05f1a4ecfbb860649a..1559320cb80a43122675850c920646f451a4354a 100644
--- a/apps/desktop/src/plugins/kanban/api.gateways.test.ts
+++ b/apps/desktop/src/plugins/kanban/api.gateways.test.ts
@@ -172,6 +172,39 @@ describe('mergeBoardLists', () => {
 })
 
 describe('gateway routing', () => {
+  it('keeps a remembered board when its owner is the active gateway', async () => {
+    registry('local')
+    await bind(() => board({ ready: [] }))
+    api.rememberTaskOwner('pinned-board', 'owner-board', 'local')
+    calls = []
+
+    await api.fetchTask('pinned-board')
+    await patchTask('pinned-board', { status: 'todo' })
+
+    expect(calls.map(call => call.path)).toEqual([
+      '/tasks/pinned-board?board=owner-board',
+      '/tasks/pinned-board?board=owner-board'
+    ])
+  })
+
+  it('pins an explicit owner profile for task reads and writes on the active gateway', async () => {
+    registry('local')
+    await bind(() => board({ ready: [] }))
+    api.rememberTaskOwner('pinned-profile', 'ops', 'local', 'worker')
+    calls = []
+
+    await api.fetchTask('pinned-profile')
+    await patchTask('pinned-profile', { status: 'todo' })
+
+    expect(calls).toEqual([
+      { path: '/tasks/pinned-profile?board=ops', opts: { connectionId: 'local', profile: 'worker' } },
+      {
+        path: '/tasks/pinned-profile?board=ops',
+        opts: { connectionId: 'local', profile: 'worker', method: 'PATCH', body: { status: 'todo' } }
+      }
+    ])
+  })
+
   it('keeps the single-gateway path byte-identical', async () => {
     registry('local')
     await bind(() => board({ ready: [task('a')] }))
diff --git a/apps/desktop/src/plugins/kanban/api.ts b/apps/desktop/src/plugins/kanban/api.ts
index e236e50ffb46ce5af49e0b08bfd1375e5c9a4a71..7fb2581c28740c4a68e4153032fe10b561469d93 100644
--- a/apps/desktop/src/plugins/kanban/api.ts
+++ b/apps/desktop/src/plugins/kanban/api.ts
@@ -472,6 +472,7 @@ function remoteRead<T>(gateway: string, path: string): Promise<T> {
 interface TaskOwner {
   gateway: string
   board: string
+  profile?: string
 }
 
 const taskOwners = new Map<string, TaskOwner>()
@@ -484,8 +485,8 @@ const hubTaskRefs = new Map<string, { board: string; hubGateway: string }>()
 /** [daveey] Record where a task lives before the board has read it (the
  *  open-task hook: a card opened from a chat on another gateway), so the
  *  drawer's first fetch goes to the owning gateway + board. */
-export function rememberTaskOwner(id: string, board: string, gateway: string): void {
-  taskOwners.set(id, { board, gateway })
+export function rememberTaskOwner(id: string, board: string, gateway: string, profile?: string): void {
+  taskOwners.set(id, { board, gateway, ...(profile === undefined ? {} : { profile }) })
 }
 
 /** Registry ids of every gateway, the routed (active) one first. A single
@@ -532,8 +533,11 @@ function withSlug(path: string, slug: string, params: Record<string, string> = {
 function forTask(id: string, path: string, params: Record<string, string> = {}): [string, PluginRestOptions] {
   const owner = taskOwners.get(id)
 
-  return owner && owner.gateway !== routedScope()
-    ? [withSlug(path, owner.board, params), via(owner.gateway)]
+  return owner
+    ? [
+        withSlug(path, owner.board, params),
+        owner.profile === undefined ? via(owner.gateway) : { connectionId: owner.gateway, profile: owner.profile }
+      ]
     : [withBoard(path, params), {}]
 }
 
