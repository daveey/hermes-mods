Date: Mon, 2 Nov 2026 22:39:42 +0000
Subject: [PATCH] fix(tests): default CLI model catalog manifests offline in
 unit tests [daveey]

Adds a manifest transport seam in hermes_cli.model_catalog and an autouse
fixture that refuses non-loopback manifest/provider-catalog fetches unless a
test stubs them. Pins the OpenRouter catalog in the non-Nous portal-feed test,
which only passed because the live docs manifest had dropped the model.
---
 hermes_cli/model_catalog.py                |  7 +-
 tests/_fixtures/offline_cli_catalogs.py    | 36 ++++++++++
 tests/conftest.py                          |  1 +
 tests/hermes_cli/test_model_validation.py  |  5 +-
 tests/test_offline_cli_catalog_defaults.py | 83 ++++++++++++++++++++++
 5 files changed, 130 insertions(+), 2 deletions(-)
 create mode 100644 tests/_fixtures/offline_cli_catalogs.py
 create mode 100644 tests/test_offline_cli_catalog_defaults.py

diff --git a/hermes_cli/model_catalog.py b/hermes_cli/model_catalog.py
index 8927b9c950d..bd4ab13770c 100644
--- a/hermes_cli/model_catalog.py
+++ b/hermes_cli/model_catalog.py
@@ -122,11 +122,16 @@ def _cache_path() -> Path:
     return get_hermes_home() / "cache" / "model_catalog.json"
 
 
+def _open_manifest_request(req: urllib.request.Request, *, timeout: float):
+    """Manifest transport boundary, separate from parsing and fallback policy."""
+    return urllib.request.urlopen(req, timeout=timeout)
+
+
 def _fetch_manifest(url: str, timeout: float) -> dict[str, Any] | None:
     """HTTP GET the manifest URL and return a validated dict, or None on failure."""
     try:
         req = urllib.request.Request(url, headers={"Accept": "application/json", "User-Agent": hermes_user_agent()})
-        with urllib.request.urlopen(req, timeout=timeout) as resp:
+        with _open_manifest_request(req, timeout=timeout) as resp:
             data = json.loads(resp.read().decode())
     except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError) as exc:
         logger.info("model catalog fetch failed (%s): %s", url, exc)
diff --git a/tests/_fixtures/offline_cli_catalogs.py b/tests/_fixtures/offline_cli_catalogs.py
new file mode 100644
index 00000000000..14b3cd5f2df
--- /dev/null
+++ b/tests/_fixtures/offline_cli_catalogs.py
@@ -0,0 +1,36 @@
+"""Offline transport defaults for CLI manifests and provider model listings."""
+import urllib.error
+import urllib.request
+from urllib.parse import urlsplit
+
+import pytest
+
+from tests._fixtures.offline_catalogs import _is_loopback
+
+
+@pytest.fixture(autouse=True)
+def _offline_cli_catalog_transport(request, monkeypatch):
+    if request.node.get_closest_marker("live"):
+        return
+    from hermes_cli import model_catalog, models
+
+    real_urlopen = urllib.request.urlopen
+    real_credentials = models.open_credentialed_url
+    manifest_open = model_catalog._open_manifest_request
+    provider_open = models._urlopen_model_catalog_request
+
+    def remote(req):
+        return not _is_loopback(urlsplit(req.full_url).hostname or "")
+
+    def manifest(req, **kwargs):
+        if remote(req) and urllib.request.urlopen is real_urlopen:
+            raise urllib.error.URLError("offline CLI catalog fixture: stub the manifest transport")
+        return manifest_open(req, **kwargs)
+
+    def provider(req, **kwargs):
+        if remote(req) and models.open_credentialed_url is real_credentials:
+            raise urllib.error.URLError("offline CLI catalog fixture: stub the provider transport")
+        return provider_open(req, **kwargs)
+
+    monkeypatch.setattr(model_catalog, "_open_manifest_request", manifest)
+    monkeypatch.setattr(models, "_urlopen_model_catalog_request", provider)
