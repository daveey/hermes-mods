 .../test_kanban_artifact_custody_bounds.py    | 42 +++++++++++++++++++
 3 files changed, 58 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban_artifact_prestage.py b/hermes_cli/kanban_artifact_prestage.py
index dc3e2ba199..2554c04d06 100644
--- a/hermes_cli/kanban_artifact_prestage.py
+++ b/hermes_cli/kanban_artifact_prestage.py
@@ -57,6 +57,8 @@ def _fill(conn, task_id: str, metadata: dict, cache: dict) -> None:
 
     for raw in declared_files(metadata):
         source = Path(raw).expanduser()
+        if str(source) in cache:
+            continue  # Another spelling of a file already read; one copy serves both.
         dest = None
         try:
             if not source.is_file() or validate_media_delivery_path(str(source)) is None:
diff --git a/hermes_cli/kanban_artifact_receipt.py b/hermes_cli/kanban_artifact_receipt.py
index bdae8f879d..5a0f1254e3 100644
--- a/hermes_cli/kanban_artifact_receipt.py
+++ b/hermes_cli/kanban_artifact_receipt.py
@@ -122,13 +122,20 @@ def _large(conn, task_id: str, source: Path, stat, record: dict, staged: list[Pa
         record["warning"] = f"Over {kb.KANBAN_ATTACHMENT_MAX_BYTES} bytes and not hashed: {reason}"
         return
     if managed:
-        # Large files cannot use blob sync, but must outlive scratch GC.
-        directory = kb.task_attachments_dir(task_id, board=board) / "local-artifacts"
-        dest = kb._unique_attachment_path(directory, source.name, set(staged))
-        staged.append(dest)
-        observed["temp"].rename(dest)
-        observed["temp"] = None
-        record["retained_path"] = str(dest)
+        # Large files cannot use blob sync, but must outlive scratch GC. One
+        # file declared under two spellings (``<ws>/x``, ``<ws>/./x``, ``~/…``)
+        # shares one pre-lock entry: later records reuse the first claim.
+        retained = observed.get("retained_path")
+        if retained is None:
+            if observed["temp"] is None:
+                raise kb.ArtifactPreservationError("no pre-lock copy was staged; retry")
+            directory = kb.task_attachments_dir(task_id, board=board) / "local-artifacts"
+            dest = kb._unique_attachment_path(directory, source.name, set(staged))
+            staged.append(dest)
+            observed["temp"].rename(dest)
+            observed["temp"] = None
+            observed["retained_path"] = retained = str(dest)
+        record["retained_path"] = retained
     record["sha256"] = observed["sha256"]
 
 
diff --git a/tests/hermes_cli/test_kanban_artifact_custody_bounds.py b/tests/hermes_cli/test_kanban_artifact_custody_bounds.py
index 1c60199744..3af9acb2ba 100644
