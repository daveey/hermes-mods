From 6872c54436768b2c18eb4833494fc1b0da7ab775 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 27 Nov 2026 16:25:57 +0000
Subject: [PATCH 6816] Origin-forward refusals, queued-create wait handles and wait-check parsing

Public mirror of source commit 6872c54436768b2c18eb4833494fc1b0da7ab775.

---
diff --git a/hermes_cli/kanban_origin_forward_wait.py b/hermes_cli/kanban_origin_forward_wait.py
index cd045a6e582403114c8e8f4292edf239ee251702..126e11904645c7502bdef90126b0b0e83af6b984 100644
--- a/hermes_cli/kanban_origin_forward_wait.py
+++ b/hermes_cli/kanban_origin_forward_wait.py
@@ -31,6 +31,7 @@
 
 def _words(wake_check: str) -> list[str]:
     """Shell words of ``wake_check`` with every operator its own word, however it is spaced."""
+    wake_check = wake_check.replace("\\\r\n", " ").replace("\\\n", " ")  # a continuation is a space
     lexer = shlex.shlex(wake_check, posix=True, punctuation_chars=True)
     lexer.whitespace = " \t\r"  # a newline separates commands: keep it as a word
     lexer.wordchars = _WORD_CHARS  # keys like ``bb-land:817:ab`` stay one word
@@ -52,6 +53,8 @@
         return []
     commands: list[list[str]] = [[]]
     for word in words:
+        if word == "\n" and (not commands[-1] or commands[-1][-1] == "&&"):
+            continue  # a blank line, or a line break after ``&&``, continues the command
         if word in _SEQUENCE:
             commands.append([])
         elif word == "&&" or _REDIRECT.match(word):
diff --git a/tests/hermes_cli/test_origin_forward_rejected_wait.py b/tests/hermes_cli/test_origin_forward_rejected_wait.py
index e7271708b56e677165a42caa3ed5e3c7a051503a..3c516f707debf8fae572a0d1bd55604b7501a8ac 100644
--- a/tests/hermes_cli/test_origin_forward_rejected_wait.py
+++ b/tests/hermes_cli/test_origin_forward_rejected_wait.py
@@ -253,11 +253,36 @@
     (f'({wake()})', []),
     (f"{wake()} || true", []),
     (f'{wake()} && true', [KEY]),
+    # a line break after ``&&`` continues the conjunction; it is not a new command
+    (f'{wake(OTHER_KEY)} &&\n{wake()}', [OTHER_KEY, KEY]),
+    (f'{wake(OTHER_KEY)} && \n {wake()}', [OTHER_KEY, KEY]),
+    (f'{wake()} &&\n{wake(OTHER_KEY)}', [KEY, OTHER_KEY]),
+    (f'{wake(OTHER_KEY)} && \\\n{wake()}', [OTHER_KEY, KEY]),     # backslash-newline is a continuation
+    (f'{wake(OTHER_KEY)} &&\n\n{wake()}', [OTHER_KEY, KEY]),
+    (f'{wake()} \\\n', [KEY]),
+    ('hermes kanban wait-check key ' + KEY + ' \\\n --gateway hub', [KEY]),
+    (f'{wake(OTHER_KEY)} &&\n{wake()}\n', [OTHER_KEY, KEY]),
 ])
 def test_wait_keys_reads_the_keys_the_exit_status_depends_on(probe, keys):
     assert wait_keys(probe) == keys, probe
 
 
+@pytest.mark.parametrize('joiner', [' &&\n', ' && \\\n', ' &&\n\n'])
+def test_the_lost_key_after_a_line_continued_conjunction_refuses(refused, joiner):
+    """``OTHER &&<newline> LOST`` can never fire either: the line break continues the ``&&``."""
+    task, run, _ = refused
+    with kbc.connect_closing() as conn:
+        why = refusal('schedule', conn, task, run, wake_check=f'{wake(OTHER_KEY)}{joiner}{wake()}')
+        assert 'origin_forward_rejected_wait' in (why or ''), why
+
+
+def test_a_lone_lost_key_wrapped_with_a_continuation_refuses(refused):
+    task, run, _ = refused
+    with kbc.connect_closing() as conn:
+        why = refusal('schedule', conn, task, run, wake_check='hermes kanban wait-check key ' + KEY + ' \\\n --gateway hub')
+        assert 'origin_forward_rejected_wait' in (why or ''), why
+
+
 def test_a_quoted_operator_in_a_key_is_one_word():
     assert wait_keys("hermes kanban wait-check key 'a;b' --gateway hub") == ['a;b']
     assert wait_keys('hermes kanban wait-check key a#b --gateway hub') == ['a#b']
