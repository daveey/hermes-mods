 import pytest
 
+from agent import shell_hooks
 from agent.shell_hooks import ShellHookSpec, _spawn
+from hermes_cli import worker_drain_fence
 
 pytestmark = pytest.mark.platforms("posix")  # POSIX process-group semantics
 
