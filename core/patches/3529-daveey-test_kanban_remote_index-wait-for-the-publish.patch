From 43899644c6f537c4c0d33f3091604d75e3848094 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 13:23:45 +0000
Subject: [PATCH] [daveey] test_kanban_remote_index: wait for the publishing
 pass before counting publishes

test_holder_republishes_on_replica_change_only_while_leased flaked on CI
(run 43429435385, `assert 2 == 1`): it waited until the published key on disk
matched the replica, then read `kri.stats["publishes"]`. But `publish()`
commits the key in `_write` and only bumps the counter afterwards, under
`_memo_lock`. A starved runner let the test read the counter in that gap (1),
then the holder counted the same publish (2) during the idle passes.

The test now waits for the publishing pass to end (the holder beats after
`refresh` returns, so after the counter moves) before snapshotting it.
No production change.

Proof: with a 0.3 s sleep injected between `_write` and the counter bump, the
old test fails 3/3 with the CI signature `assert 2 == 1`; the new test passes
5/5. Without the probe, the whole file passes 8/8 parallel runs under a
SIGSTOP/SIGCONT duty cycle.
---
 tests/tui_gateway/test_kanban_remote_index.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/tests/tui_gateway/test_kanban_remote_index.py b/tests/tui_gateway/test_kanban_remote_index.py
index b5e3342d18..55894d6787 100644
--- a/tests/tui_gateway/test_kanban_remote_index.py
+++ b/tests/tui_gateway/test_kanban_remote_index.py
@@ -225,6 +225,10 @@ def test_holder_republishes_on_replica_change_only_while_leased(tmp_path):
         wait_until(lambda: kri.published_key(ledger) == kri.replica_key(replica), what="holder publish")
         _add(replica, _linked("t_new", CHAT), 50)
         wait_until(lambda: kri.published_key(ledger) == kri.replica_key(replica), what="change-driven publish")
+        # The key is on disk before ``publish`` counts it: let the publishing pass end (it beats after
+        # ``refresh`` returns) before reading the counter, or a starved runner reads it one short.
+        beats = lease.beats
+        wait_until(lambda: lease.beats > beats, what="publishing pass done")
         publishes = kri.stats["publishes"]
         beats = lease.beats
         wait_until(lambda: lease.beats > beats + 5, what="idle passes")
