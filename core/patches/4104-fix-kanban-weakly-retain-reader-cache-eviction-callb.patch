From 15147bd5077ea7f0b6256e417b5e47e7cbf221ff Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 16:45:21 -0800
Subject: [PATCH] fix(kanban): weakly retain reader cache eviction callbacks
 [daveey]

The process-lifetime registry owned bound methods, which owned retired plugin
cache instances and their SQLite handles across reloads. Existing recovery
coverage exercised eviction, not callback-owner lifetime.

Use WeakMethod/ref with a strong fallback only for nonweakrefable callables.
Prune on reads/registration and add idempotent unregister_reader_cache.
Preserve callable iteration/membership and snapshot-before-eviction locking.

Proof: new five-reader GC regression fails on base (5 != 0); unregister
fails before implementation. All five targeted tests pass after the fix,
including recovery outside the registry lock and nonweakrefable fallback.
scripts/check --base origin/main: all 20 checks pass.

Recurrence: module history and reader cache PR search found no prior weak
registry fix. Add lifetime assertions to prevent the ownership regression.
---
 hermes_cli/kanban_generation.py               |  53 +++++++-
 ...kanban_generation_reader_cache_registry.py | 124 ++++++++++++++++++
 2 files changed, 176 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_cli/test_kanban_generation_reader_cache_registry.py

diff --git a/hermes_cli/kanban_generation.py b/hermes_cli/kanban_generation.py
index 9bf1e0331e..107ae0a766 100644
--- a/hermes_cli/kanban_generation.py
+++ b/hermes_cli/kanban_generation.py
@@ -18,7 +18,52 @@ from hermes_cli.kanban_lifecycle_diagnostics import LifecycleLock
 
 _lock = threading.RLock()
 _connections: weakref.WeakSet = weakref.WeakSet()
-_reader_caches: list = []
+
+
+class _ReaderCaches:
+    """Non-owning callbacks; callers hold _lock while reading or changing entries."""
+
+    def __init__(self):
+        self._entries = []
+
+    def _snapshot(self):
+        live, entries = [], []
+        for entry in self._entries:
+            callback = entry() if isinstance(entry, weakref.ReferenceType) else entry
+            if callback is not None:
+                live.append(callback)
+                entries.append(entry)
+        self._entries = entries
+        return live
+
+    def __iter__(self):
+        with _lock:
+            return iter(self._snapshot())
+
+    def __len__(self):
+        with _lock:
+            return len(self._snapshot())
+
+    def discard(self, callback):
+        for index, current in enumerate(self._snapshot()):
+            if current == callback:
+                del self._entries[index]
+                return True
+        return False
+
+    def append(self, callback):
+        self._snapshot()
+        try:
+            entry = weakref.WeakMethod(callback)
+        except TypeError:
+            try:
+                entry = weakref.ref(callback)
+            except TypeError:
+                entry = callback  # Some extension callables cannot be weakly referenced.
+        self._entries.append(entry)
+
+
+_reader_caches = _ReaderCaches()
 _poisoned: set[str] = set()
 _lifecycle_locks: weakref.WeakValueDictionary = weakref.WeakValueDictionary()
 
@@ -211,6 +256,12 @@ def register_reader_cache(evict) -> None:
             _reader_caches.append(evict)
 
 
+def unregister_reader_cache(evict) -> bool:
+    """Remove one registered eviction callback; repeated removal is harmless."""
+    with _lock:
+        return _reader_caches.discard(evict)
+
+
 @contextmanager
 def _cache_registry_available(lock):
     # Recovery runs under a board lifecycle lock. Never wait for a foreign
diff --git a/tests/hermes_cli/test_kanban_generation_reader_cache_registry.py b/tests/hermes_cli/test_kanban_generation_reader_cache_registry.py
new file mode 100644
index 0000000000..288469b4ea
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_generation_reader_cache_registry.py
@@ -0,0 +1,124 @@
+"""Reader eviction registration must not own retired plugin instances."""
+import gc
+import sqlite3
+import weakref
+
+from hermes_cli import kanban_generation as kg
+
+
+class Connection(sqlite3.Connection):
+    """sqlite3's subclass supports weak references for lifetime assertions."""
+
+
+class Cache:
+    def __init__(self, path):
+        self.conn = sqlite3.connect(path.as_uri() + "?mode=ro", uri=True, factory=Connection)
+
+    def evict(self, path):
+        self.conn.close()
+
+
+def test_retired_caches_release_five_readonly_connections(tmp_path, monkeypatch):
+    monkeypatch.setattr(kg, "_reader_caches", type(kg._reader_caches)())
+    path = tmp_path / "board.db"
+    with sqlite3.connect(path) as writer:
+        writer.execute("CREATE TABLE tasks (id TEXT)")
+    writer.close()
+    caches = [Cache(path) for _ in range(5)]
+    connections = [weakref.ref(cache.conn) for cache in caches]
+    for cache in caches:
+        kg.register_reader_cache(cache.evict)
+    assert len(kg._reader_caches) == 5
+    del cache, caches
+    gc.collect()
+    assert len(kg._reader_caches) == 0
+    assert all(ref() is None for ref in connections)
+
+
+def test_unregister_removes_only_matching_entry_and_is_idempotent(monkeypatch):
+    monkeypatch.setattr(kg, "_reader_caches", type(kg._reader_caches)())
+
+    def first(path):
+        pass
+
+    def second(path):
+        pass
+
+    kg.register_reader_cache(first)
+    kg.register_reader_cache(second)
+    kg.register_reader_cache(first)
+    assert len(kg._reader_caches) == 2
+    assert kg.unregister_reader_cache(first) is True
+    assert list(kg._reader_caches) == [second]
+    assert kg.unregister_reader_cache(first) is False
+    assert list(kg._reader_caches) == [second]
+
+
+def test_recover_calls_live_cache_outside_registry_lock(tmp_path, monkeypatch):
+    import threading
+    from hermes_cli import kanban_lockguard
+
+    monkeypatch.setattr(kg, "_reader_caches", type(kg._reader_caches)())
+    monkeypatch.setattr(kg, "_connections", weakref.WeakSet())
+    monkeypatch.setattr(kg, "_poisoned", set())
+    path = str(tmp_path / "board.db")
+    calls = []
+    scans = iter([["retired-wal"], []])
+    monkeypatch.setattr(kanban_lockguard, "stranded_sidecars", lambda _: next(scans))
+
+    class LiveCache:
+        def evict(self, board):
+            def register_from_other_thread():
+                with kg._lock:
+                    calls.append(board)
+            thread = threading.Thread(target=register_from_other_thread)
+            thread.start()
+            thread.join(timeout=2)
+            assert not thread.is_alive(), "recovery held registry lock across eviction"
+
+    cache = LiveCache()
+    kg.register_reader_cache(cache.evict)
+    kg.register_reader_cache(cache.evict)
+    assert len(kg._reader_caches) == 1
+    kg.recover(path)
+    assert calls == [path]
+    assert kg.unregister_reader_cache(cache.evict) is True
+    assert kg.unregister_reader_cache(cache.evict) is False
+
+
+def test_function_lifetime_and_registration_prune_dead_entries(monkeypatch):
+    monkeypatch.setattr(kg, "_reader_caches", type(kg._reader_caches)())
+
+    def callback(path):
+        pass
+
+    kg.register_reader_cache(callback)
+    assert callback in kg._reader_caches
+    ref = weakref.ref(callback)
+    del callback
+    gc.collect()
+    assert ref() is None
+
+    def replacement(path):
+        pass
+
+    kg.register_reader_cache(replacement)
+    assert list(kg._reader_caches) == [replacement]
+    assert len(kg._reader_caches._entries) == 1
+
+
+def test_non_weakrefable_callable_is_retained_until_unregistered(monkeypatch):
+    monkeypatch.setattr(kg, "_reader_caches", type(kg._reader_caches)())
+
+    class Callback:
+        __slots__ = ()
+
+        def __call__(self, path):
+            pass
+
+    callback = Callback()
+    kg.register_reader_cache(callback)
+    gc.collect()
+    assert list(kg._reader_caches) == [callback]
+    assert kg.unregister_reader_cache(callback) is True
+    assert len(kg._reader_caches) == 0
