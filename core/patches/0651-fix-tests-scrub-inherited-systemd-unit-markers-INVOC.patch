From 90a63800fbcd1dd41962e75954c493c4aa9b9cb8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 07:01:59 +0000
Subject: [PATCH] fix(tests): scrub inherited systemd unit markers
 (INVOCATION_ID, NOTIFY_SOCKET, WATCHDOG_*) per test so Kanban spawn tests
 pass when pytest runs inside a Kanban worker [daveey]

---
 tests/_fixtures/env_filter.py              | 13 ++++++++++
 tests/test_hermetic_env_systemd_markers.py | 30 ++++++++++++++++++++++
 2 files changed, 43 insertions(+)
 create mode 100644 tests/test_hermetic_env_systemd_markers.py

diff --git a/tests/_fixtures/env_filter.py b/tests/_fixtures/env_filter.py
index 630c3adc12..455f16b422 100644
--- a/tests/_fixtures/env_filter.py
+++ b/tests/_fixtures/env_filter.py
@@ -328,4 +328,17 @@ _HERMES_BEHAVIORAL_VARS = frozenset({
     "WHATSAPP_REQUIRE_MENTION",
     "DINGTALK_REQUIRE_MENTION",
     "MATRIX_REQUIRE_MENTION",
+    # systemd unit markers. pytest started from a Kanban worker, a gateway
+    # terminal or a systemd-hosted runner inherits these, and production code
+    # branches on them: INVOCATION_ID flips restart_safe_gateway_child_argv()
+    # into scope/degraded mode (Kanban spawn tests raised "cannot create
+    # restart-safe systemd scope ... no current run id" only on hosts), and
+    # NOTIFY_SOCKET/WATCHDOG_* would make sd_notify() talk to the REAL unit.
+    # Tests that exercise systemd behavior set them explicitly.
+    "INVOCATION_ID",
+    "NOTIFY_SOCKET",
+    "WATCHDOG_USEC",
+    "WATCHDOG_PID",
+    "JOURNAL_STREAM",
+    "MANAGERPID",
 })
diff --git a/tests/test_hermetic_env_systemd_markers.py b/tests/test_hermetic_env_systemd_markers.py
new file mode 100644
index 0000000000..5d077d10a6
--- /dev/null
+++ b/tests/test_hermetic_env_systemd_markers.py
@@ -0,0 +1,30 @@
+"""The hermetic test env drops systemd unit markers inherited from the host.
+
+pytest launched from a Kanban worker / gateway terminal on a systemd host
+inherits INVOCATION_ID (and NOTIFY_SOCKET etc.). Unscrubbed, the Kanban spawn
+path took the restart-safe-scope branch and raised "cannot create restart-safe
+systemd scope ... no current run id" on hosts only, never on CI.
+"""
+
+import os
+
+from tests._fixtures.env_filter import _HERMES_BEHAVIORAL_VARS
+
+_SYSTEMD_MARKERS = (
+    "INVOCATION_ID", "NOTIFY_SOCKET", "WATCHDOG_USEC", "WATCHDOG_PID", "JOURNAL_STREAM", "MANAGERPID",
+)
+
+
+def test_systemd_markers_are_scrubbed_per_test():
+    for name in _SYSTEMD_MARKERS:
+        assert name in _HERMES_BEHAVIORAL_VARS
+        assert name not in os.environ, f"{name} leaked from the host into a test"
+
+
+def test_worker_spawn_dispatch_is_in_process_without_opt_in():
+    from tools.process_registry import restart_safe_gateway_child_argv
+
+    dispatch = restart_safe_gateway_child_argv(
+        ["true"], unit_suffix="kanban-t-run-missing", require_restart_safe_scope=True, outlives_parent=True,
+    )
+    assert dispatch.mode == "in_process"
-- 
