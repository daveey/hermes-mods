@@ -111,3 +111,89 @@ def test_origin_bound_settled_completion_needs_a_fresh_hub_sync(world, board):
     path, replica = _bound_done(world)
     row = _project(path, replica, 1001 + 37 * 3600)  # this gateway has not pulled for 37 h
