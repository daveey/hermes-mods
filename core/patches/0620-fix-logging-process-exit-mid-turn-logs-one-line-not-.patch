From c5153adda1eb0e48cebdc7ddc0f165f251d68f1e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 04:50:20 +0000
Subject: [PATCH] fix(logging): process exit mid-turn logs one line, not a
 traceback (pre-final gate, tool executor, errors.log filter) [daveey]

A turn finishing while the backend exits hit pre_final_gate._invoke after the main thread
returned; its pool submit raised 'cannot schedule new futures after interpreter shutdown'
(or, on a first pool use, 'can't register atexit after shutdown'), logged as a WARNING
with a full traceback in errors.log and filed by self-heal as a defect (agent-9a2a3cc05d).

- pre_final_gate._invoke / tool_executor sequential error path: shutdown errors log one
  INFO line and fail open exactly as before.
- tools.interpreter_shutdown also recognizes the atexit-refusal message.
- Root guard: errors.log handler gets _ProcessExitNoiseFilter, collapsing any record whose
  exception is a process-exit scheduling error to one line (agent.log keeps the traceback),
  so future thread-starting sites need no opt-in.
Tests: tests/agent/test_pre_final_gate_interpreter_shutdown.py (subprocess gate after main
exit, both CPython messages; tool path; real-error controls), test_hermes_logging filter test.
---
 agent/pre_final_gate.py                       |  11 +-
 agent/tool_executor.py                        |   6 +-
 hermes_logging.py                             |  42 ++++++-
 ...est_pre_final_gate_interpreter_shutdown.py | 109 ++++++++++++++++++
 tests/test_hermes_logging.py                  |  28 +++++
 tools/interpreter_shutdown.py                 |  10 +-
 6 files changed, 201 insertions(+), 5 deletions(-)
 create mode 100644 tests/agent/test_pre_final_gate_interpreter_shutdown.py

diff --git a/agent/pre_final_gate.py b/agent/pre_final_gate.py
index cdb1031c88..f8f76abcf6 100644
--- a/agent/pre_final_gate.py
+++ b/agent/pre_final_gate.py
@@ -235,8 +235,15 @@ def _invoke(cb: Callable, kwargs: dict[str, Any], budget: int, limit: float) ->
         return _call(cb, call_kwargs, limit)
     except concurrent.futures.TimeoutError:
         logger.warning("pre_final_gate hook %s timed out after %.1fs", name, limit)
-    except Exception:
-        logger.warning("pre_final_gate hook %s raised", name, exc_info=True)
+    except Exception as exc:
+        from tools.interpreter_shutdown import interpreter_shutting_down
+
+        if isinstance(exc, RuntimeError) and interpreter_shutting_down(exc):
+            # The process is exiting (Desktop quit, update, restart) while a turn finishes: not a
+            # gate failure. One quiet line, no traceback; fail open exactly as for any other error.
+            logger.info("pre_final_gate hook %s skipped: %s (process exiting)", name, exc)
+        else:
+            logger.warning("pre_final_gate hook %s raised", name, exc_info=True)
     return _FAILED
 
 
