@@ -0,0 +1,44 @@
+"""Same UTC day and area selection, under the intake authority's write lock."""
+from dataclasses import dataclass
+from datetime import UTC, datetime
+
+from hermes_cli import kanban_selfwork as policy
+
+
+@dataclass(frozen=True)
+class Decision:
+    disposition: str
+    task_id: str | None = None
+
+
+def day_key(now):
+    return datetime.fromtimestamp(now, UTC).date().isoformat()
+
+
+def choose(conn, value, *, now, tenant=None):
+    value = policy.contract(value)
+    if value is None:
+        return Decision('create')
+    row = conn.execute(
+        "SELECT t.id FROM tasks t JOIN task_events e ON e.task_id=t.id "
+        "WHERE t.tenant IS ? AND t.status NOT IN ('done','archived') AND e.kind=? "
+        "AND json_extract(e.payload,'$.repository')=? AND json_extract(e.payload,'$.area')=? "
+        "AND json_extract(e.payload,'$.day')=? ORDER BY t.created_at,t.id LIMIT 1",
+        (tenant, policy.EVENT, value['repository'], value['area'], day_key(now)),
+    ).fetchone()
+    return Decision('append', row['id']) if row else Decision('create')
+
+
+def append(conn, decision, value, *, request_id, title, body, author):
+    from hermes_cli import kanban_db as kb
+    if not conn.in_transaction or decision.disposition != 'append' or not decision.task_id:
+        raise policy.SelfWorkError('self-work append requires a transactional owner decision')
+    task = kb.get_task(conn, decision.task_id)
+    if task is None or task.status in {'done', 'archived'}:
+        raise policy.SelfWorkError('self-work owner no longer open')
+    comment_id = kb.add_comment(conn, task.id, author,
+                               f'Self-work finding ({request_id}): {title}\n\n{body or ""}', system=True)
+    receipt = dict(request_id=request_id, task_id=task.id, self_work=value,
+                   comment_id=comment_id, disposition='append', created=False)
+    kb._append_event(conn, task.id, 'self_work_appended', receipt)
+    return receipt
diff --git a/hermes_cli/kanban_selfwork_discovery.py b/hermes_cli/kanban_selfwork_discovery.py
new file mode 100644
index 0000000000000000000000000000000000000000..84cf27d64710384264b57ab1195a7c384a28a463
--- /dev/null
+++ b/hermes_cli/kanban_selfwork_discovery.py
@@ -0,0 +1,49 @@
+"""Untrusted worker route discovery; never grants origin authority.
+
+The origin-local forward receiver checks its accepted obligation and a fresh
+Board lease. Replica data here is only enough to address that receiver.
+"""
+from __future__ import annotations
+
+import os
+import re
+import sqlite3
+
+from hermes_cli.kanban_selfwork import SelfWorkError
+
+_ID = re.compile(r'[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}')
+
+
+def worker_creator():
+    from hermes_cli import kanban_db as kb, kanban_origin
+    from hermes_cli.kanban_identity import _connect
+    from hermes_cli.kanban_placement_forward import opened_board
+
+    task = os.environ.get('HERMES_KANBAN_TASK') or os.environ.get('HERMES_KANBAN_WORKER_TASK')
+    markers = {os.environ[k] for k in ('HERMES_KANBAN_TASK', 'HERMES_KANBAN_WORKER_TASK') if os.environ.get(k)}
+    run = os.environ.get('HERMES_KANBAN_RUN_ID', '')
+    if (len(markers) > 1 or not task or not _ID.fullmatch(task)
+            or not re.fullmatch(r'[0-9]{1,19}', run) or not 0 < int(run) <= 9223372036854775807):
+        raise SelfWorkError('self-work worker requires authorized origin-gateway forwarding: missing creator run')
+    try:
+        conn = _connect(kb.kanban_db_path())
+        try:
+            board = opened_board(conn)
+            row = conn.execute('''SELECT t.created_on,r.uid FROM tasks t JOIN task_runs r
+                ON r.task_id=t.id AND r.id=t.current_run_id
+                WHERE t.id=? AND r.id=? AND t.status='running' AND r.status='running'
+                AND r.ended_at IS NULL''', (task, int(run))).fetchone()
+        finally:
+            conn.close()
+    except (OSError, sqlite3.Error) as exc:
+        raise SelfWorkError('self-work creator discovery unavailable; never create locally') from exc
+    if row is None:
+        raise SelfWorkError('self-work creator run is not current')
+    gateway, uid = row
+    owners = {(gw, profile) for gw, profile in kanban_origin._replica_task_owners(task, board) if gw == gateway}
+    if len(owners) != 1:
+        raise SelfWorkError('self-work creator publication namespace is missing or ambiguous')
+    creator = dict(gateway=gateway, profile=next(iter(owners))[1], board=board, task_id=task, run_uid=uid)
+    if not all(isinstance(v, str) and _ID.fullmatch(v) for v in creator.values()):
+        raise SelfWorkError('self-work creator identity is invalid')
+    return creator
diff --git a/hermes_cli/kanban_selfwork_forward.py b/hermes_cli/kanban_selfwork_forward.py
new file mode 100644
index 0000000000000000000000000000000000000000..ecdd62953a486b7a7418db4eff32c3f3473a42b1
--- /dev/null
+++ b/hermes_cli/kanban_selfwork_forward.py
@@ -0,0 +1,204 @@
+"""Trusted courier authorization at the origin; never creates or queues work.
+
+Only local accepted obligations plus a fresh authenticated Board lease authorize
+an initial handoff. The immutable journal makes subsequent delivery retries safe.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import re
+import sqlite3
+import sys
+import time
+from pathlib import Path
+
+from hermes_cli import kanban_origin_ledger as ledger
+from hermes_cli import kanban_selfwork_owner as owner
+
+_ID = re.compile(r'[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}')
+_MAX_PAGES = 32
+_MAX_ROWS = 1000
+
+
+def _hash(value):
+    return hashlib.sha256(ledger._json(value).encode()).hexdigest()
+
+
+def _tuple(value, keys):
+    return (isinstance(value, dict) and set(value) == set(keys)
+            and all(isinstance(v, str) and _ID.fullmatch(v) for v in value.values()))
+
+
+def _validate(request, config, gateway, profile):
+    if not isinstance(request, dict) or not isinstance(request.get('args'), dict):
+        raise ValueError('self_work_request_invalid')
+    body = request['args']
+    if (set(body) != {'origin', 'creator', 'create'}
+            or not _tuple(body.get('origin'), ('gateway', 'profile', 'session'))
+            or not _tuple(body.get('creator'), ('gateway', 'profile', 'board', 'task_id', 'run_uid'))
+            or not isinstance(body.get('create'), dict)
+            or body['create'].get('self_work') is None
+            or any(k in body['create'] for k in ('origin_intent', 'selfwork_intent', 'origin_session', 'creator_task_id'))
+            or not isinstance(request.get('id'), str) or not _ID.fullmatch(request['id'])):
+        raise ValueError('self_work_request_invalid')
+    from hermes_cli.kanban_selfwork import contract
+    contract(body['create']['self_work'])
+    origin = body['origin']
+    sender = request.get('from')
+    if (not isinstance(sender, str) or not sender.startswith('gw:') or not _ID.fullmatch(sender[3:])
+            or request.get('coll') != 'sessions' or request.get('action') != 'selfwork-forward'
+            or request.get('to_gw') != gateway or origin['gateway'] != gateway
+            or profile == 'custom' or origin['profile'] != profile
+            or request.get('key') != profile + '/' + origin['session']):
+        raise ValueError('self_work_route_mismatch')
+    kanban = config.get('kanban') if isinstance(config, dict) else None
+    section = kanban.get('self_work') if isinstance(kanban, dict) else None
+    home = section.get('home') if isinstance(section, dict) else None
+    if not _tuple(home, ('gateway', 'profile', 'board')) or home['profile'] == 'custom':
+        raise ValueError('self_work_home_invalid')
+    from hermes_cli import kanban_db as kb
+    if kb._normalize_board_slug(home['board']) != home['board']:
+        raise ValueError('self_work_home_invalid')
+    return home
+
+
+def _obligation(conn, origin, creator):
+    expected = {k: creator[k] for k in ('gateway', 'profile', 'board', 'task_id')}
+    for key, digest, raw, released in conn.execute(
+            'SELECT binding_id,binding_hash,binding_json,released FROM origin_obligations'):
+        binding = json.loads(raw)
+        ledger.validate_binding(binding)
+        if binding['origin'] != origin or binding['owner'] != expected:
+            continue
+        if released or ledger.binding_hash(binding) != digest or ledger._binding_key(binding) != key:
+            raise ValueError('self_work_creator_unauthorized')
+        for stored_hash, receipt_raw in conn.execute(
+                'SELECT binding_hash,receipt_json FROM origin_receipts WHERE binding_hash=?', (digest,)):
+            ack = json.loads(receipt_raw)
+            if (isinstance(ack, dict) and ack.get('status') == 'accepted'
+                    and stored_hash == ack.get('binding_hash') == digest
+                    and ack.get('binding_id') == binding['binding_id']
+                    and ack.get('owner') == expected and ack.get('origin') == origin):
+                return {'binding': binding, 'binding_hash': digest}
+    raise ValueError('self_work_creator_unauthorized')
+
+
+def _lease(creator, sender, gateway):
+    from hermes_cli.kanban_sync_client import Hub, HubError, SyncUnavailable, load_identity
+    try:
+        identity = load_identity()
+        if identity.gateway != gateway:
+            raise ValueError('self_work_route_mismatch')
+        hub = Hub(identity, timeout=10, deadline=time.monotonic() + 30)
+        after, seen, evidence, head = '', set(), None, None
+        for _ in range(_MAX_PAGES):
+            page = hub.snapshot_page(creator['board'], 'leases', after)
+            if (not isinstance(page, dict) or page.get('table') != 'leases'
+                    or type(page.get('head')) is not int or page['head'] < 0
+                    or type(page.get('more')) is not bool
+                    or not isinstance(page.get('next'), str)
+                    or not isinstance(page.get('rows'), list) or len(page['rows']) > _MAX_ROWS):
+                raise ValueError('self_work_lease_invalid')
+            if head is not None and head != page['head']:
+                raise ValueError('self_work_lease_invalid')
+            head = page['head']
+            previous = after
+            for row in page['rows']:
+                if (not isinstance(row, dict)
+                        or not all(isinstance(row.get(k), str) and _ID.fullmatch(row[k])
+                                   for k in ('task_id', 'run_uid', 'holder'))
+                        or type(row.get('expires')) not in (int, float)
+                        or not math.isfinite(row['expires'])):
+                    raise ValueError('self_work_lease_invalid')
+                if row['task_id'] <= previous:
+                    raise ValueError('self_work_lease_invalid')
+                previous = row['task_id']
+                if row['task_id'] == creator['task_id']:
+                    if evidence is not None:
+                        raise ValueError('self_work_lease_invalid')
+                    evidence = {'lease': row, 'head': page['head']}
+            if page['next'] != previous:
+                raise ValueError('self_work_lease_invalid')
+            if not page['more']:
+                if (evidence is None or evidence['lease']['run_uid'] != creator['run_uid']
+                        or evidence['lease']['holder'] != sender[3:]
+                        or evidence['lease']['expires'] <= time.time() * 1000):
+                    raise ValueError('self_work_lease_invalid')
+                return evidence
+            after = page['next']
+            if not after or after in seen or not page['rows'] or len(after) > 256:
+                raise ValueError('self_work_lease_invalid')
+            seen.add(after)
+        raise ValueError('self_work_lease_invalid')
+    except (OSError, HubError, SyncUnavailable) as exc:
+        raise ValueError('self_work_lease_unavailable') from exc
+
+
+def _schema(conn):
+    conn.execute('''CREATE TABLE IF NOT EXISTS selfwork_forward_admissions (
+        request_id TEXT PRIMARY KEY, envelope_hash TEXT NOT NULL, home_json TEXT NOT NULL,
+        evidence_json TEXT NOT NULL, receipt_json TEXT NOT NULL)''')
+    conn.commit()
+
+
+def _replay(conn, request, home):
+    row = conn.execute('SELECT envelope_hash,home_json,receipt_json FROM selfwork_forward_admissions '
+                       'WHERE request_id=?', (request['id'],)).fetchone()
+    if row is None:
+        return None
+    if row[0] != _hash(request) or row[1] != ledger._json(home):
+        raise ValueError('self_work_forward_conflict')
+    return json.loads(row[2])
+
+
+def receive(request: dict) -> dict:
+    config, gateway, profile, root = owner._runtime()
+    home = _validate(request, config, gateway, profile)
+    path = root / 'kanban/origin-ledger.db'
+    with ledger._db(path) as conn:
+        _schema(conn)
+        prior = _replay(conn, request, home)
+        if prior is not None:
+            return prior
+        body = request['args']
+        binding = _obligation(conn, body['origin'], body['creator'])
+    evidence = _lease(body['creator'], request['from'], gateway)
+    downstream = {'id': 'swf-' + _hash([request['id'], request['from'], gateway, request['key'], home]),
+                  'to_gw': home['gateway'], 'coll': 'tasks', 'key': home['profile'] + '/' + home['board'],
+                  'action': 'selfwork-create',
+                  'args': {'create': {**body['create'], 'board': home['board'],
+                                      'session_id': body['origin']['session']}, 'origin': body['origin'],
+                           'creator': body['creator']}}
+    receipt = {'status': 'accepted', 'code': 'self_work_forward_authorized',
+               'request_id': request['id'], 'downstream': downstream, 'handoff_complete': False}
+    with ledger._db(path) as conn, conn:
+        conn.execute('BEGIN IMMEDIATE')
+        prior = _replay(conn, request, home)
+        if prior is not None:
+            return prior
+        if _obligation(conn, body['origin'], body['creator']) != binding:
+            raise ValueError('self_work_creator_unauthorized')
+        if evidence['lease']['expires'] <= time.time() * 1000:
+            raise ValueError('self_work_lease_invalid')
+        conn.execute('INSERT INTO selfwork_forward_admissions VALUES (?,?,?,?,?)',
+                     (request['id'], _hash(request), ledger._json(home),
+                      ledger._json({**binding, **evidence}), ledger._json(receipt)))
+    return receipt
+
+
+def command(args) -> int:
+    try:
+        raw = sys.stdin.read() if args.request_file == '-' else Path(args.request_file).read_text(encoding='utf-8-sig')
+        result = receive(json.loads(raw))
+    except (OSError, sqlite3.Error):
+        result = {'status': 'pending', 'code': 'self_work_storage_unavailable', 'handoff_complete': False}
+    except (KeyError, TypeError, ValueError) as exc:
+        code = str(exc)
+        if not re.fullmatch(r'(self_work|origin)_[a-z_]+', code):
+            code = 'self_work_request_invalid'
+        status = 'pending' if code == 'self_work_lease_unavailable' else 'rejected'
+        result = {'status': status, 'code': code, 'handoff_complete': False}
+    print(json.dumps(result))
+    return 0
diff --git a/hermes_cli/kanban_selfwork_intake.py b/hermes_cli/kanban_selfwork_intake.py
new file mode 100644
index 0000000000000000000000000000000000000000..07ee7559ad17e70d5853892a26db34952e5d7d2c
--- /dev/null
+++ b/hermes_cli/kanban_selfwork_intake.py
@@ -0,0 +1,153 @@
+"""Single-writer admission; caller must authenticate routing before admission.
+
+The journal is local to the configured authority, not replicated admission state.
+It freezes a request's result, including appends, before transport acknowledges it.
+"""
+from __future__ import annotations
+
+import json
+import re
+import threading
+from contextlib import contextmanager
+from contextvars import ContextVar
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_selfwork as policy
+from hermes_cli import kanban_selfwork_batch as batch
+
+_CREATION = ContextVar('self_work_intake_creation', default=None)
+
+
+def _json(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False)
+
+
+@contextmanager
+def _creation_scope(conn, value):
+    token = _CREATION.set((conn, _json(value), threading.get_ident()))
+    try:
+        yield
+    finally:
+        _CREATION.reset(token)
+
+
+def assert_admitted_creation(conn, value):
+    current = _CREATION.get()
+    if (current is None or current[0] is not conn or current[1] != _json(value)
+            or current[2] != threading.get_ident() or not conn.in_transaction):
+        raise policy.SelfWorkError('declared self-work requires authoritative intake')
+
+
+def _authority(conn, authority, local_gateway):
+    from hermes_cli.kanban_db_sync import sync_state
+    state = sync_state(conn)
+    actual = state['gateway_id'] if state else local_gateway
+    if not authority or not local_gateway or actual != local_gateway or actual != authority:
+        raise policy.SelfWorkError('self-work admission must run at configured authority')
+
+
+def replay(conn, request_id, request):
+    if not conn.execute("SELECT 1 FROM sqlite_master WHERE name='self_work_intake' AND type='table'").fetchone():
+        return None
+    row = conn.execute('SELECT request_json,receipt_json FROM self_work_intake WHERE request_id=?',
+                       (request_id,)).fetchone()
+    if row is None:
+        return None
+    if row['request_json'] != _json(request):
+        raise policy.SelfWorkError('self-work request identity reused with different intent')
+    return {**json.loads(row['receipt_json']), 'replayed': True}
+
+
+def _adopt(conn, intent, task_id, board):
+    from hermes_cli.kanban_origin_creation import adopt_with_origin
+    from hermes_cli.kanban_origin import OriginError
+    adoption = {**intent, 'owner': {**intent['owner'], 'task_id': task_id}}
+    try:
+        adopt_with_origin(conn, adoption, board=board)
+    except OriginError as exc:
+        if exc.code != 'origin_already_bound':
+            raise
+
+
+def admit(conn, *, request_id, authority, local_gateway, options, now, create_guard=None,
+          on_created=None, request=None):
+    _authority(conn, authority, local_gateway)
+    if not isinstance(request_id, str) or not re.fullmatch(r'[A-Za-z0-9._:-]{8,128}', request_id):
+        raise policy.SelfWorkError('self-work requires a stable request identity')
+    value = policy.contract(options.get('self_work'))
+    if value is None:
+        raise policy.SelfWorkError('self-work intake requires explicit declaration')
+    options = json.loads(_json({**options, 'self_work': value}))
+    intent = options.get('origin_intent')
+    if intent is not None and (not isinstance(intent, dict) or not isinstance(intent.get('owner'), dict)
+                               or intent['owner'].get('gateway') != authority):
+        raise policy.SelfWorkError('self-work origin owner must be admission authority')
+    request = options if request is None else request
+    with kb.write_txn(conn, allow_nested=True):
+        _authority(conn, authority, local_gateway)
+        conn.execute('CREATE TABLE IF NOT EXISTS self_work_intake ('
+                     'request_id TEXT PRIMARY KEY NOT NULL, request_json TEXT NOT NULL, receipt_json TEXT NOT NULL)')
+        prior = replay(conn, request_id, request)
+        if prior is not None:
+            return prior
+        from hermes_cli.kanban_db_graph import initial_task_state
+        tenant = initial_task_state(conn, tuple(options.get('parents', ())), options.get('initial_status', 'running'),
+                                    options.get('triage', False), options.get('tenant'))[1]
+        decision = batch.choose(conn, value, now=now, tenant=tenant)
+        if decision.disposition == 'append':
+            receipt = batch.append(conn, decision, value, request_id=request_id,
+                                   title=options['title'], body=options.get('body'),
+                                   author=options.get('created_by') or 'system')
+            if intent := options.get('origin_intent'):
+                _adopt(conn, intent, decision.task_id, options.get('board') or kb.get_current_board())
+        else:
+            if options.get('idempotency_key') and conn.execute(
+                "SELECT 1 FROM tasks WHERE idempotency_key=? AND status!='archived' LIMIT 1",
+                (options['idempotency_key'],),
+            ).fetchone():
+                raise policy.SelfWorkError('self-work idempotency key already names another request')
+            from hermes_cli.kanban_db_creation import run_insert_guard
+            run_insert_guard(conn, create_guard)
+            with _creation_scope(conn, value):
+                task_id = kb.create_task(conn, **options)
+            policy.record(conn, task_id, value, day=batch.day_key(now))
+            if on_created is not None:
+                on_created(conn, task_id)
+            receipt = dict(request_id=request_id, disposition='create', task_id=task_id, created=True)
+        receipt.update(ownership_pending=False, **_origin_receipt(conn, options, receipt['task_id']))
+        _store(conn, request_id, request, receipt)
+    return receipt
+
+
+def _store(conn, request_id, request, receipt):
+    conn.execute('INSERT INTO self_work_intake VALUES (?,?,?)', (request_id, _json(request), _json(receipt)))
+
+
+def _origin_receipt(conn, options, task_id):
+    intent = options.get('origin_intent')
+    if intent is None:
+        return {}
+    owner = {**intent['owner'], 'task_id': task_id}
+    for row in conn.execute('SELECT * FROM origin_creation_intents WHERE task_id=?', (task_id,)):
+        binding = json.loads(row['binding_json'])
+        if binding['owner'] == owner and binding['origin'] == intent['origin']:
+            return {'handoff_complete': False, 'origin_creation': {
+                'request_id': row['request_id'], 'binding': binding, 'child_request_id': row['child_request_id']}}
+    raise policy.SelfWorkError('self-work origin adoption has no durable receipt')
+
+
+def append_existing(conn, *, request_id, authority, options, request, now):
+    """Try append before creation preflight; a miss performs no writes."""
+    from hermes_cli.kanban_db_graph import initial_task_state
+    _authority(conn, authority, authority)
+    value = policy.contract(options.get('self_work'))
+    with kb.write_txn(conn, allow_nested=True):
+        prior = replay(conn, request_id, request)
+        if prior is not None:
+            return prior
+        tenant = initial_task_state(conn, tuple(options.get('parents', ())), options.get('initial_status', 'running'),
+                                    options.get('triage', False), options.get('tenant'))[1]
+        if batch.choose(conn, value, now=now, tenant=tenant).disposition != 'append':
+            return None
+        return admit(conn, request_id=request_id, authority=authority, local_gateway=authority,
+                     options=options, request=request, now=now)
diff --git a/hermes_cli/kanban_selfwork_outbound.py b/hermes_cli/kanban_selfwork_outbound.py
new file mode 100644
index 0000000000000000000000000000000000000000..8b2407533383b821630f18a3ba49d19c02c5f633
--- /dev/null
+++ b/hermes_cli/kanban_selfwork_outbound.py
@@ -0,0 +1,116 @@
+"""Single-home self-work submission, independent of execution placement.
+
+Queue acknowledgement is not task creation. No fallback to a local writer, even
+when the configured home is this gateway. Foreign chat forwarding fails closed.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import subprocess
+from datetime import UTC, datetime
+
+from hermes_cli.kanban_selfwork import SelfWorkError, contract
+
+_ID = re.compile(r'[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}')
+
+
+def prepare(args):
+    from hermes_cli.kanban_selfwork_owner import _runtime
+    from hermes_cli import kanban_origin
+    from gateway.session_context import get_session_env
+
+    contract(args.get('self_work'))
+    config, gateway, profile, _ = _runtime()
+    home = config.get('kanban', {}).get('self_work', {}).get('home')
+    if (not isinstance(home, dict) or set(home) != {'gateway', 'profile', 'board'}
+            or not all(isinstance(v, str) and _ID.fullmatch(v) for v in home.values())
+            or not isinstance(gateway, str) or not _ID.fullmatch(gateway)):
+        raise SelfWorkError('self-work intake home must configure gateway, profile and board')
+    worker = bool(os.environ.get('HERMES_KANBAN_TASK') or os.environ.get('HERMES_KANBAN_WORKER_TASK'))
+    creator = None
+    if worker:
+        from hermes_cli.kanban_selfwork_discovery import worker_creator
+        creator = worker_creator()
+    create = json.loads(json.dumps(args))
+    raw_origin = create.pop('origin_session', None) or kanban_origin.ambient_origin_ref()
+    session = create.pop('session_id', None) or get_session_env('HERMES_SESSION_ID')
+    origin = kanban_origin.parse_origin(raw_origin) if raw_origin else None
+    if worker and origin is None:
+        raise SelfWorkError('self-work worker forwarding requires a qualified origin session')
+    if not worker and origin is not None and origin.gateway != gateway:
+        raise SelfWorkError('self-work foreign origin must submit from its authenticated origin gateway')
+    if origin is None and session:
+        origin = kanban_origin.Origin(gateway, profile, session)
+    create['board'] = home['board']
+    create.setdefault('assignee', profile)
+    body = {'create': create}
+    if origin:
+        if not all(isinstance(v, str) and _ID.fullmatch(v) for v in (origin.gateway, origin.profile, origin.session)):
+            raise SelfWorkError('invalid self-work origin identity')
+        if not worker:
+            create['session_id'] = session or origin.session
+        body['origin'] = {'gateway': origin.gateway, 'profile': origin.profile, 'session': origin.session}
+    identity = {'sender': gateway, 'home': home, 'key': create.get('idempotency_key')}
+    if worker:
+        body['creator'] = creator
+        identity.update(creator=creator, origin=body['origin'])
+    if not identity['key']:
+        identity['body'] = body
+        identity['day'] = datetime.now(UTC).date().isoformat()
+    digest = hashlib.sha256(json.dumps(identity, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+    return home, body, 'sw-' + digest
+
+
+def submit(args):
+    home, body, request_id = prepare(args)
+    from tools.environments.local import build_subprocess_env
+    if 'creator' in body:
+        origin = body['origin']
+        route = [origin['gateway'], 'sessions', origin['profile'] + '/' + origin['session'], 'selfwork-forward']
+    else:
+        route = [home['gateway'], 'tasks', home['profile'] + '/' + home['board'], 'selfwork-create']
+    argv = ['hermes-hub', 'request', *route, '--id', request_id, '--args-file', '-']
+    try:
+        result = subprocess.run(argv, input=json.dumps(body), capture_output=True, text=True,  # windows-footgun: ok (encoding on next line)
+                                encoding='utf-8', timeout=30, check=False, env=build_subprocess_env())
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        raise SelfWorkError('self-work transport unavailable; retry the same request, never create locally') from exc
+    if result.returncode not in (0, 3) or request_id not in result.stdout.splitlines():
+        raise SelfWorkError('self-work transport refused: ' + result.stderr.strip()[:1000])
+    return {'ok': False, 'created': False, 'handoff_complete': False, 'code': 'self_work_queued',
+            'request_id': request_id, 'home': home, 'queued': True}
+
+
+def cli_submit(args, *, body, workspace_kind, workspace_path, max_runtime, branch_name):
+    if branch_name or getattr(args, 'reasoning_effort', None):
+        raise SelfWorkError('self-work courier does not support branch or reasoning_effort yet')
+    names = ('title', 'assignee', 'tenant', 'priority', 'admission_class', 'admission_frees',
+             'self_work', 'project', 'triage', 'idempotency_key', 'skills', 'max_retries',
+             'pin_mandatory', 'goal_mode', 'review_required', 'goal_max_turns', 'completion_contract',
+             'initial_status', 'human_request', 'runs_on', 'requires', 'distinct_from', 'distinct_reason',
+             'origin_session')
+    values = {key: getattr(args, key) for key in names if getattr(args, key, None) is not None}
+    values.update(body=body, workspace_kind=workspace_kind, workspace_path=workspace_path,
+                  parents=list(args.parent or ()), max_runtime_seconds=max_runtime)
+    for old, new in (('model_override', 'model'), ('provider_override', 'provider')):
+        if getattr(args, old, None) is not None:
+            values[new] = getattr(args, old)
+    from hermes_cli.kanban_cli_body import session_identity
+    worker = bool(os.environ.get('HERMES_KANBAN_TASK') or os.environ.get('HERMES_KANBAN_WORKER_TASK'))
+    _, session_id = session_identity(worker)
+    if session_id is not None:
+        values['session_id'] = session_id
+    return submit(values)
+
+
+def cli_command(args, **kwargs):
+    from hermes_cli.kanban import _err, _print_json
+    try:
+        result = cli_submit(args, **kwargs)
+    except (SelfWorkError, ValueError, OSError) as exc:
+        return _err(f'kanban: {exc}', 2)
+    _print_json(result)
+    return 0
diff --git a/hermes_cli/kanban_selfwork_owner.py b/hermes_cli/kanban_selfwork_owner.py
new file mode 100644
index 0000000000000000000000000000000000000000..5253877cf11221eaa2d3f7cbae74fd2caf60ad71
--- /dev/null
+++ b/hermes_cli/kanban_selfwork_owner.py
@@ -0,0 +1,144 @@
+"""Authenticated courier-owner adapter; execution placement is not admission home.
+
+The transport must reach a trusted courier receiver first. Public tool arguments
+cannot supply intake context, and this adapter independently checks the installed
+home tuple and physical database before committing an intake request.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import time
+from pathlib import Path
+
+from hermes_cli import kanban_selfwork as policy
+from hermes_cli import kanban_selfwork_intake as intake
+
+
+def _runtime():
+    from hermes_cli.config import load_config_readonly
+    from hermes_cli.profiles import get_active_profile_name
+    from hermes_cli.kanban_origin_adapter import _gateway
+    from hermes_constants import get_hermes_home
+    replica = Path(os.environ.get('HERMES_HUB_STATE') or Path.home() / '.local/state/hermes-hub') / 'hub.db'
+    return load_config_readonly(), _gateway(replica), get_active_profile_name(), get_hermes_home().resolve()
+
+
+def validate_declared_home(conn, value, intent, board):
+    """Product creation keeps its existing route and does not load self-work policy."""
+    if value is not None:
+        validate_home(conn, intent, board)
+
+
+def validate_home(conn, intent, board):
+    from hermes_cli import kanban_db as kb
+    if not isinstance(intent, dict) or not isinstance(intent.get('owner'), dict):
+        raise policy.SelfWorkError('self-work requires authenticated routing to its configured intake home')
+    if 'origin' not in intent and (
+            not isinstance(intent.get('sender'), str)
+            or not re.fullmatch(r'gw:[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}', intent['sender'])):
+        raise policy.SelfWorkError('self-work requires an authenticated gateway sender')
+    config, gateway, profile, root = _runtime()
+    kanban = config.get('kanban') if isinstance(config, dict) else None
+    section = kanban.get('self_work') if isinstance(kanban, dict) else None
+    home = section.get('home') if isinstance(section, dict) else None
+    if (not isinstance(home, dict) or set(home) != {'gateway', 'profile', 'board'}
+            or not all(isinstance(v, str) and v for v in home.values())):
+        raise policy.SelfWorkError('self-work intake home must configure gateway, profile and board')
+    if (home != intent['owner'] or gateway != home['gateway'] or profile != home['profile']
+            or board != home['board'] or kb._normalize_board_slug(board) != board
+            or not kb.board_exists(board) or kb.kanban_home().resolve() != root):
+        raise policy.SelfWorkError('self-work intake home route mismatch')
+    expected = root / 'kanban.db' if board == 'default' else root / 'kanban/boards' / board / 'kanban.db'
+    actual = next((row[2] for row in conn.execute('PRAGMA database_list') if row[1] == 'main'), '')
+    if not actual or Path(actual).resolve() != expected or kb.kanban_db_path(board).resolve() != expected:
+        raise policy.SelfWorkError('self-work intake home database mismatch')
+    return gateway
+
+
+def creator_task(conn, intent):
+    """Resolve private provenance only in its authoritative home namespace.
+
+    Foreign creator policy is not yet supported: a same-ID replica must never
+    silently stand in for an authenticated creator from another namespace.
+    """
+    if 'creator' not in intent:
+        return None
+    creator = intent['creator']
+    if (not isinstance(creator, dict)
+            or set(creator) != {'gateway', 'profile', 'board', 'task_id', 'run_uid'}
+            or not all(isinstance(v, str) and re.fullmatch(r'[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}', v)
+                       for v in creator.values())
+            or {k: creator[k] for k in ('gateway', 'profile', 'board')} != intent['owner']):
+        raise policy.SelfWorkError('self-work creator namespace unavailable at intake home')
+    columns = {row[1] for row in conn.execute('PRAGMA table_info(tasks)')}
+    provenance = 'created_on' if 'created_on' in columns else 'NULL'
+    row = conn.execute(f'SELECT {provenance} FROM tasks WHERE id=?', (creator['task_id'],)).fetchone()
+    if row is None or row[0] not in (None, creator['gateway']):
+        raise policy.SelfWorkError('self-work creator missing or foreign at intake home')
+    return creator['task_id']
+
+
+def snapshot(args):
+    return json.loads(json.dumps(args)) if args.get('self_work') is not None else None
+
+
+def replay(conn, args, intent, *, origin_intent=None):
+    """Revalidate authority even for a replay; never rerun create preflight."""
+    if args.get('self_work') is None:
+        return None
+    authority = validate_home(conn, intent, args.get('board'))
+    request = {'args': args, 'intent': intent}
+    receipt = intake.replay(conn, intent['request_id'], request)
+    if receipt is None:
+        from tools.kanban_tools import _persisted_identity, _coerce_str_list
+        options = {key: args[key] for key in ('title', 'body', 'self_work', 'tenant', 'board') if key in args}
+        options.update(origin_intent=origin_intent or (intent if 'origin' in intent else None),
+                       creator_task_id=creator_task(conn, intent),
+                       created_by=intent.get('sender') or _persisted_identity(),
+                       parents=_coerce_str_list(args.get('parents') or [], 'parents', 'task ids'))
+        receipt = intake.append_existing(conn, request_id=intent['request_id'], authority=authority,
+                                         options=options, request=request, now=int(time.time()))
+    return _render(conn, receipt, intent) if receipt is not None else None
+
+
+def _render(conn, receipt, intent, marker_placement=None, place_origin=None):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_origin_creation
+    from tools import kanban_tools as kt
+    extra = {'handoff_complete': False, 'subscribed': False, **receipt}
+    if receipt['task_id'] is None:
+        return json.dumps({'ok': False, 'code': 'self_work_deferred', **extra})
+    task = kb.get_task(conn, receipt['task_id'])
+    if intent.get('origin') is not None:
+        extra.update(kanban_origin_creation.origin_link_fields(conn, task.id, intent['origin']))
+    if receipt['created'] and not receipt.get('replayed'):
+        extra.update(kt._marker_placement_fields(conn, task.id, marker_placement, **(place_origin or {})))
+    no_chat = intent.get('origin') is None
+    extra['handoff_complete'] = no_chat
+    return json.dumps({'ok': no_chat, 'code': 'self_work_accepted' if no_chat else 'origin_bind_pending',
+                       **kt._fields(task, kt._ca.CREATED_FIELDS), **extra})
+
+
+def create(conn, options, *, after_create, marker_placement, place_origin, request, intent=None):
+    """Called by the existing tool path after normalization/preflight, before INSERT.
+
+    Only DB-local effects execute under intake's transaction. Courier origins
+    are subscribed by the origin ledger; no ambient session subscription or
+    capability-routing network call is made here.
+    """
+    intent = intent if intent is not None else options.get('origin_intent')
+    authority = validate_home(conn, intent, options.get('board'))
+    options = dict(options)
+    options['creator_task_id'] = creator_task(conn, intent)
+    guard = options.pop('insert_guard', None)
+    # Gateway forwarding would split one area across admission journals. Board
+    # execution labels remain valid, but legacy deferred forwarding cannot.
+    if marker_placement and marker_placement.get('defer'):
+        raise policy.SelfWorkError('self-work admission stays at home; use Board execution labels, not gateway forwarding')
+    receipt = intake.admit(conn, request_id=intent['request_id'], authority=authority,
+                           local_gateway=authority, options=options, now=int(time.time()),
+                           create_guard=guard, on_created=after_create,
+                           request={'args': request, 'intent': intent})
+    return _render(conn, receipt, intent, marker_placement, place_origin)
diff --git a/hermes_cli/kanban_selfwork_receiver.py b/hermes_cli/kanban_selfwork_receiver.py
