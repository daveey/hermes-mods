From fb855a70456e4354840e732728326c7e4d1c1432 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 07:00:51 +0000
Subject: [PATCH] fix(tests): clear the host slot holder record on release
 [daveey]

A record left by a released slot names a dead pid; an older checkout's runner that takes the slot next
writes none, so a waiter would read the stale record and reclaim a live holder's slot.
---
 scripts/run_tests_host_slots.py            | 4 ++++
 tests/conftest.py                          | 9 ++++++---
 tests/scripts/test_run_tests_host_slots.py | 9 +++++++++
 3 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/scripts/run_tests_host_slots.py b/scripts/run_tests_host_slots.py
index 4ef15cdd08..973dc3ccb7 100644
--- a/scripts/run_tests_host_slots.py
+++ b/scripts/run_tests_host_slots.py
@@ -293,7 +293,11 @@ def acquire_host_slot(on_wait=None) -> int | None:
 
 
 def release_host_slot(fd: int | None) -> None:
+    """Clear the holder record, then free the slot. A record left behind would be read as the holder of
+    the next acquirer that writes none (an older checkout's runner) and misjudge it as gone."""
     if fd is not None:
+        with contextlib.suppress(OSError):
+            os.ftruncate(fd, 0)
         with contextlib.suppress(OSError):
             os.close(fd)
 
diff --git a/tests/conftest.py b/tests/conftest.py
index 72f1ac2fb7..3f5451d90d 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -1359,9 +1359,12 @@ def _release_host_test_slot(config) -> None:
     fd = getattr(config, "_hermes_host_slot_fd", None)
     if fd is not None:
         try:
-            os.close(fd)
-        except OSError:
-            pass
+            _host_slots_module().release_host_slot(fd)  # clears the holder record, then closes
+        except Exception:
+            try:
+                os.close(fd)
+            except OSError:
+                pass
         config._hermes_host_slot_fd = None
 
 
diff --git a/tests/scripts/test_run_tests_host_slots.py b/tests/scripts/test_run_tests_host_slots.py
index 6a29d421e5..bc7fbb42b6 100644
--- a/tests/scripts/test_run_tests_host_slots.py
+++ b/tests/scripts/test_run_tests_host_slots.py
@@ -334,6 +334,15 @@ def test_live_young_holder_is_not_reclaimed(slot_env, monkeypatch, tmp_path):
         child.wait(5)
 
 
+def test_release_clears_the_holder_record(slot_env, monkeypatch):
+    """A record left after release would name a dead pid as the holder of an older runner that writes none."""
+    monkeypatch.setenv("HERMES_TEST_HOST_SLOTS", "1")
+    fd = slots.acquire_host_slot()
+    assert (slot_env / "0.lock").read_text().startswith("{")
+    slots.release_host_slot(fd)
+    assert (slot_env / "0.lock").read_text() == ""
+
+
 def test_slot_max_age_env_and_config(tmp_path, monkeypatch):
     monkeypatch.setenv("HERMES_TEST_SLOT_CONFIG", str(tmp_path / "absent.yaml"))
     monkeypatch.delenv(slots.MAX_AGE_ENV, raising=False)
