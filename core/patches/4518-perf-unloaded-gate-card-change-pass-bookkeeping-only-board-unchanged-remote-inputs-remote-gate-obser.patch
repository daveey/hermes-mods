+
+
+# --- the pass is skipped while its inputs are unchanged (t_48c41072e7cba68d) ------------------------------------------
+
+@pytest.fixture
+def gated(db, remote, monkeypatch):
+    """A controllable input key; ``reads`` counts the passes that actually read the projection."""
+    ledger, key, reads = [], [("gw", "default", ())], []
+    monkeypatch.setattr(nf, "_remote_inputs_key", lambda: None if key[0] is None else (key[0], list(ledger)))
+    real = remote
+
+    def read(ids, statuses, stale_ok):
+        reads.append(1)
+        return list(real)
+    monkeypatch.setattr(ksa, "_remote_cards", read)
+    return ledger, key, reads
+
+
+def test_unchanged_inputs_skip_the_remote_read(db, remote, gated):
+    _ledger, _key, reads = gated
+    run(db)  # seeds
+    run(db)
+    n = len(reads)
+    for _ in range(3):
+        assert run(db) == []
+    assert len(reads) == n  # three more passes, no read
+
+
+def test_a_changed_input_runs_the_pass_and_a_card_change_is_fanned_out(db, remote, gated):
+    _ledger, key, _reads = gated
+    assert so.refresh_outcome(CHAT, "manual", db=db)["kind"] == "done"
+    run(db)
+    run(db)
+    remote.append(card())
+    key[0] = ("gw", "default", ("revision", 2))
+    assert len(run(db)) == 1
+    assert so.get_outcome(CHAT, db=db)["kind"] == "waiting"
+
+
+def test_a_new_ledger_projection_runs_the_pass(db, remote, gated):
+    ledger, _key, reads = gated
+    run(db)
+    run(db)
+    n = len(reads)
+    ledger.append({"key": "x"})
+    run(db)
+    assert len(reads) > n
+
+
+def test_unvouched_inputs_never_skip(db, remote, gated):
+    _ledger, key, reads = gated
+    key[0] = None
+    run(db)
+    n = len(reads)
+    run(db)
+    run(db)
+    assert len(reads) > n
+
+
+def test_a_failed_refresh_is_retried_not_memoised(db, remote, gated, monkeypatch):
+    _ledger, key, reads = gated
+    run(db)
+    run(db)
+    remote.append(card())
+    key[0] = ("gw", "default", ("revision", 3))
+    with monkeypatch.context() as patch:
+        patch.setattr(so, "refresh_outcomes_quietly", lambda *a, **k: False)
+        assert run(db) == []
+    n = len(reads)
+    assert len(run(db)) == 1  # same inputs, but the chat was never acknowledged: the pass runs again
+    assert len(reads) > n
diff --git a/tui_gateway/kanban_unloaded_gates.py b/tui_gateway/kanban_unloaded_gates.py
index 53a06ece5cc4cf4bf7b587fcefe5c53302ae71f9..a2916e3b02e510ada87acd152cc02c4b0e492aa2 100644
--- a/tui_gateway/kanban_unloaded_gates.py
+++ b/tui_gateway/kanban_unloaded_gates.py
@@ -281,13 +281,34 @@ def _remote(live: frozenset = frozenset()) -> Inputs:
         return Inputs()
     # The key is what the pass would read, not the replica's commit counter: the hub's replica commits on every
     # sync, and none of those commits changed a card this host owes a notice for (t_48c41072e7cba68d).
+    # ``observe`` records this host's first sighting of EVERY terminal state, linked or not, and a later link must
+    # not resurrect a notice that expired unseen: so a replica whose task rows changed is never skipped, even when
+    # no card the sweep owes a notice for changed. Unreadable = unknown = hot.
+    tasks = _replica_tasks_signature(path)
+    if tasks is None:
+        return Inputs()
     digest = hashlib.sha256()
+    digest.update(repr(tasks).encode())
     for owner, key, task, links in cards:
         digest.update(repr((owner, key, remote._notice_state(task),
                             tuple((link.get('profile'), link.get('session')) for link in links))).encode())
     return Inputs((str(path), me, digest.hexdigest(), str(ledger), ledger_stamp), pending=False)
 
 
+def _replica_tasks_signature(path):
+    """The replica's task rows as ``observe`` reads them (count, newest seq, seq total): unchanged across the sync
+    pulls that commit only cursors or other collections. None when unreadable."""
+    import contextlib
+    import sqlite3
+
+    from tui_gateway.kanban_remote_notices import _ro
+    try:
+        with contextlib.closing(_ro(path)) as conn:
+            return tuple(conn.execute("SELECT COUNT(*), MAX(seq), TOTAL(seq) FROM replica WHERE coll='tasks'").fetchone())
+    except (OSError, sqlite3.Error, TypeError):
+        return None
+
+
 def _cards_settled(conn, cards, live) -> bool:
     """True when every notice the sweep could deliver already has a settled ledger row, so the pass has nothing to
     deliver, claim, wait on or count. Anything unproven (a link without a settled row, an open chat, whose poller
diff --git a/tui_gateway/notice_fanout.py b/tui_gateway/notice_fanout.py
index 4603376969a951035ee7306375c822747bc2c641..dce3114fc513fbc04c9fe2b4094fde2dc914d0b3 100644
--- a/tui_gateway/notice_fanout.py
+++ b/tui_gateway/notice_fanout.py
@@ -49,6 +49,8 @@ _TASK_ID = re.compile(r"Kanban (t_[0-9A-Za-z_]+)")
 
 
 def _reset_for_tests() -> None:
+    global _remote_memo
+    _remote_memo = None
     from tui_gateway import notice_fanout_state
     notice_fanout_state.reset_for_tests()
 
@@ -182,8 +184,20 @@ def _board_idle(ident: str) -> bool:
         if since is None:
             return False
         with reader(Path(ident)) as ro:
-            top = ro.execute("SELECT COALESCE(MAX(id), 0) FROM task_events").fetchone()[0]
-        return int(top) == since
+            top = int(ro.execute("SELECT COALESCE(MAX(id), 0) FROM task_events").fetchone()[0])
+            if top == since:
+                return True
+            if top < since:
+                return False
+            # Heartbeats, comments and other bookkeeping events move the newest id every few seconds on a live
+            # board, but ``_changed_tasks`` fans out only STATUS_EVENT_KINDS: when none lies in (since, top] the
+            # full pass would return no card, and only advance the cursor, which is all this does (t_48c41072e7cba68d).
+            kinds = ",".join("?" * len(STATUS_EVENT_KINDS))
+            if ro.execute(f"SELECT 1 FROM task_events WHERE id > ? AND id <= ? AND kind IN ({kinds}) LIMIT 1",
+                          (since, top, *STATUS_EVENT_KINDS)).fetchone() is not None:
+                return False
+        state.set_cursor(ident, top)
+        return True
     except Exception:  # health: allow BLE001 -- an unreadable board is not idle; the full pass decides
         logger.debug("card-change idle check unavailable for %s", ident, exc_info=True)
         return False
@@ -231,8 +245,55 @@ def _fan_out_changes(conn: sqlite3.Connection, _kb: Any, session_db: Callable, s
     return out
 
 
+# The input key of the last remote pass that left every chat acknowledged, with the ledger cards it was computed over
+# (held, so an object identity in the key cannot be reused). A pass over the same inputs reads the same snapshot.
+_remote_memo: Optional[tuple] = None
+
+
+def _remote_inputs_key() -> Optional[tuple]:
+    """Everything ``activity._remote_cards`` reads for the replica projection that ``_remote_change_pass`` keeps
+    (card key, status, chat, origin chat), or None when any of it cannot be vouched for. That is each synced board's
+    replica content revision (trigger-backed only: a stat fallback never vouches), the origin-ledger projection's
+    card objects (``_remote_links`` returns the same dicts until it re-projects), this gateway and profile, and
+    the reader mode. A pull that moves only ``pulled_at`` changes none of them (t_48c41072e7cba68d)."""
+    from hermes_cli import kanban_db_sync as sync
+    from hermes_cli import kanban_session_activity as activity
+    from hermes_cli import kanban_sync_client as ksc
+    from hermes_cli.kanban_activity_revision import SHADOW_TABLES, is_revision
+    from hermes_cli.profiles import get_active_profile_name
+
+    if sync.sync_config().get("links_reader") != "replica":
+        return None
+    try:
+        gateway = ksc.load_identity().gateway
+    except ksc.SyncUnavailable:
+        return None
+    if not gateway:
+        return None
+    boards = []
+    for slug, _path in ksc.board_paths():
+        path = ksc.shadow_path(slug)
+        content = activity._board_content_key(path, SHADOW_TABLES)
+        if not is_revision(content):
+            return None
+        boards.append((slug, str(path), content))
+    ledger = activity._remote_links(stale_ok=True)
+    return (gateway, get_active_profile_name(), tuple(boards)), ledger
+
+
 def _remote_change_pass(session_db: Callable) -> list[dict]:
     """Observe the same remote projection as outcomes; failed reads never mean cards finished."""
+    global _remote_memo
+    try:
+        inputs = _remote_inputs_key()
+    except Exception:  # health: allow BLE001 -- an unreadable input is unknown: run the pass
+        logger.debug("remote card-change inputs unavailable", exc_info=True)
+        inputs = None
+    memo = _remote_memo
+    if inputs is not None and memo is not None and memo[0] == inputs[0] and len(memo[1]) == len(inputs[1]) \
+            and all(a is b for a, b in zip(memo[1], inputs[1])):
+        return []
+    _remote_memo = None
     from hermes_cli import kanban_session_activity as activity
     from hermes_state_outcome import refresh_outcomes_quietly
     from tui_gateway import notice_fanout_state as state
@@ -269,6 +330,8 @@ def _remote_change_pass(session_db: Callable) -> list[dict]:
         out.append({"board": None, "task_id": None, "chat_id": chat, "session_id": tip,
                     "status": None, "skipped": skipped, "source": "remote"})
     state.ack_remote(acked)
+    if inputs is not None and all(previous.get(c) == snapshot.get(c) or c in acked for c in previous.keys() | snapshot.keys()):
+        _remote_memo = inputs
     return out
 
 
