From c4bdf75a576583598b9dce694721a868758972a2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 23:03:28 +0000
Subject: [PATCH] fix(kanban): heartbeat_claim renews the Board lease only for
 a claim the caller still owns [daveey]

An ended worker's post-run turns still fire the activity heartbeat. heartbeat_expiry renews under the
card's current run uid, so once the card has a new run the old process renewed (or, when the Board
refused, logged a false 'lease ... lost to' warning for) another worker's lease. Check ownership with
the UPDATE's own predicate before any Board call.

heartbeat_claim moves to hermes_cli/kanban_db_heartbeat.py (re-exported from kanban_db) to keep
kanban_db.py under its file-size cap.
---
diff --git a/hermes_cli/kanban_db_heartbeat.py b/hermes_cli/kanban_db_heartbeat.py
new file mode 100644
index 0000000000000000000000000000000000000000..d56a1966ec25b578e93955d5a06d62bc706020f1
--- /dev/null
+++ b/hermes_cli/kanban_db_heartbeat.py
@@ -0,0 +1,37 @@
+"""Claim heartbeat (``kanban_db.heartbeat_claim``), moved out of ``kanban_db`` for its file-size cap.
+
+``kanban_db`` re-exports it; callers keep using ``kanban_db.heartbeat_claim``.
+"""
+
+from __future__ import annotations
+
+import sqlite3
+import time
+from typing import Optional
+
+
+def heartbeat_claim(
+    conn: sqlite3.Connection, task_id: str, *, ttl_seconds: Optional[int] = None,
+    claimer: Optional[str] = None,
+) -> bool:
+    """Extend a running claim; True if we still own it."""
+    from hermes_cli import kanban_db as _kb
+
+    expires = int(time.time()) + _kb._resolve_claim_ttl_seconds(ttl_seconds)
+    lock = claimer or _kb._claimer_id()
+    # [daveey] Only the claim's owner touches the Board lease. An ended worker's post-run turns still fire the
+    # activity heartbeat, and heartbeat_expiry renews under the card's *current* run, which may be another worker's
+    # (a refused renewal then logs a false "lease ... lost to" warning). Same predicate as the UPDATE below.
+    if conn.execute("SELECT 1 FROM tasks WHERE id = ? AND status = 'running' AND claim_lock = ?",
+                    (task_id, lock)).fetchone() is None:
+        return False
+    expires = _kb._sync.heartbeat_expiry(conn, task_id, expires)  # bounded by the lease on synced boards
+    with _kb.write_txn(conn):
+        cur = conn.execute(
+            "UPDATE tasks SET claim_expires = ? "
+            "WHERE id = ? AND status = 'running' AND claim_lock = ?", (expires, task_id, lock),
+        )
+        if cur.rowcount != 1:
+            return False
+        _kb._extend_run_claim(conn, task_id, expires)
+        return True
diff --git a/tests/hermes_cli/test_kanban_heartbeat_owner.py b/tests/hermes_cli/test_kanban_heartbeat_owner.py
new file mode 100644
index 0000000000000000000000000000000000000000..6275df86027c39abe2c94c7c1e8bb48861b8b24c
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_heartbeat_owner.py
@@ -0,0 +1,74 @@
+"""heartbeat_claim must not touch the Board lease for a claim the caller no longer owns."""
+from __future__ import annotations
+
+import logging
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_sync as sync
+from tests.hermes_cli import kanban_sync_support as support
+
+
+@pytest.fixture
+def kanban_home(tmp_path, monkeypatch):
+    return support.kanban_home(tmp_path, monkeypatch)
+
+
+@pytest.fixture
+def lease_client():
+    yield from support.lease_client()
+
+
+@pytest.fixture
+def primary(kanban_home):
+    for conn in support.synced_conn(kanban_home):
+        sync.set_mode(conn, "primary")
+        yield conn
+
+
+OLD, NEW = "host:old", "host:new"
+
+
+def _claimed_again(conn, lease_client):
+    """Claim with OLD, end that run (continued), claim again with NEW; leave the lease due for renewal."""
+    tid = kb.create_task(conn, title="moved on", assignee="worker")
+    assert kb.claim_task(conn, tid, ttl_seconds=900, claimer=OLD) is not None
+    now = int(time.time())
+    with kbc.write_txn(conn):
+        conn.execute("UPDATE task_runs SET status = 'continued', outcome = 'continued', ended_at = ? "
+                     "WHERE task_id = ? AND ended_at IS NULL", (now, tid))
+        conn.execute("UPDATE tasks SET status = 'ready', claim_lock = NULL, claim_expires = NULL, "
+                     "current_run_id = NULL, worker_pid = NULL WHERE id = ?", (tid,))
+    assert kb.claim_task(conn, tid, ttl_seconds=900, claimer=NEW) is not None
+    new_uid = conn.execute("SELECT r.uid FROM tasks t JOIN task_runs r ON r.id = t.current_run_id WHERE t.id = ?",
+                           (tid,)).fetchone()[0]
+    with kbc.write_txn(conn):  # a third of the lease used up: a renewal is due
+        conn.execute("UPDATE tasks SET lease_expires = ? WHERE id = ?", (int((time.time() + 200) * 1000), tid))
+    sync._RENEW_ATTEMPTS.pop(tid, None)
+    lease_client.calls.clear()
+    return tid, new_uid
+
+
+def test_ended_worker_heartbeat_makes_no_renewal_for_the_next_run(primary, lease_client):
+    tid, _new_uid = _claimed_again(primary, lease_client)
+    assert kb.heartbeat_claim(primary, tid, ttl_seconds=900, claimer=OLD) is False
+    assert lease_client.count("renew") == 0, lease_client.calls
+
+
+def test_ended_worker_heartbeat_logs_no_false_lease_lost(primary, lease_client, caplog):
+    tid, _new_uid = _claimed_again(primary, lease_client)
+    holder = primary.execute("SELECT lease_holder FROM tasks WHERE id = ?", (tid,)).fetchone()[0]
+    lease_client.renew_mode = "deny"  # the Board refuses a renew from a process that is not the holder's run
+    with caplog.at_level(logging.INFO, logger="hermes_cli.kanban_db_sync"):
+        kb.heartbeat_claim(primary, tid, ttl_seconds=900, claimer=OLD)
+    assert [r.getMessage() for r in caplog.records if r.levelno >= logging.WARNING] == []
+    assert primary.execute("SELECT lease_holder FROM tasks WHERE id = ?", (tid,)).fetchone()[0] == holder
+
+
+def test_owner_heartbeat_still_renews_when_due(primary, lease_client):
+    tid, new_uid = _claimed_again(primary, lease_client)
+    assert kb.heartbeat_claim(primary, tid, ttl_seconds=900, claimer=NEW) is True
+    assert [(k, kw["run_uid"]) for k, kw in lease_client.calls] == [("renew", new_uid)]
