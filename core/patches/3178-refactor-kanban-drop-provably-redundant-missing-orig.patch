From f4296a1063432da39a1d46ef7ea85eac4e12839f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 00:57:16 +0000
Subject: [PATCH] refactor(kanban): drop provably redundant missing-origin
 operand in review-release consumer [daveey]

Mutation run8 (87 mutants) left m049 (`not origin`) green: the branch is
entered only when origin is truthy or foreign_copy() is true, and
foreign_copy() requires a truthy created_on, so a missing origin already
differs from home. Behaviour unchanged.
---
 hermes_cli/kanban_review_release.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_review_release.py b/hermes_cli/kanban_review_release.py
index e2781b77ef..fa2ea6b036 100644
--- a/hermes_cli/kanban_review_release.py
+++ b/hermes_cli/kanban_review_release.py
@@ -112,7 +112,8 @@ def released(conn, task_id, pr_urls):
         origin = event["origin_gateway"] if "origin_gateway" in event.keys() else None
         if origin or foreign_copy(conn, task_id):
             home = conn.execute("SELECT created_on FROM tasks WHERE id=?", (task_id,)).fetchone()[0]
-            if not origin or origin != home:
+            # A foreign copy always has a truthy home, so a missing origin differs.
+            if origin != home:
                 return False
         if conn.execute("SELECT 1 FROM task_events WHERE task_id=? AND id>? "
                         "AND kind='descendant_invalidated' LIMIT 1", (task_id, event["id"])).fetchone():
