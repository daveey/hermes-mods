+def test_missing_registry_defers(replica, local, monkeypatch):
+    card(replica)
+    monkeypatch.setattr(wn, "registry", lambda **kw: None)
+    assert subject.sweep(local, replica, "hub", now_ms=NOW * 1000) == []
