From 0606cda5b442bb56ac0941b452eca295db1f3618 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 12:03:06 -0700
Subject: [PATCH] fix(doctor): the dashboard import probe launches like the
 runtime, so a store install stops reporting a missing ruamel [daveey]
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The probe ran bare `sys.executable -c 'import hermes_cli.web_server'`. On a store install the
interpreter runs isolated and only hermes_bootstrap puts the dependency generation on sys.path, so
`hermes doctor` on the laptop and the mini reported 'Dashboard web surface: No module named ruamel'
while their dashboards served 200. The probe now uses runtime_command(code=...), the same launch as
update_cmd_validation's import probe.

Tests: test_probe_runs_without_lazy_installs now pins the runtime command (it pinned the bare argv);
test_probe_loads_the_dependency_generation_like_the_runtime runs it for real. Live repro on this Mac
with the launcher's exact command: old checkout '✗ No module named ruamel', this change '✓ imports cleanly'.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/doctor_platform.py                 |  6 ++++-
 .../test_doctor_web_dashboard_import.py       | 23 ++++++++++++++++---
 2 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/doctor_platform.py b/hermes_cli/doctor_platform.py
index 43efbc3a70f..0c7f71e8379 100644
--- a/hermes_cli/doctor_platform.py
+++ b/hermes_cli/doctor_platform.py
@@ -538,12 +538,16 @@ def _check_web_dashboard_import(should_fix: bool, f: Finding) -> None:
     from taking the doctor down with it; lazy installs stay off so the probe never mutates the
     environment it is diagnosing.
     """
+    from hermes_cli._launchers import runtime_command
     from hermes_cli.doctor import PROJECT_ROOT
 
     env = dict(os.environ, HERMES_DISABLE_LAZY_INSTALLS="1")
     try:
         proc = subprocess.run(
-            [sys.executable, "-c", "import hermes_cli.web_server"],
+            # The runtime's own launch: the store interpreter runs isolated and only
+            # ``hermes_bootstrap`` puts the dependency generation on sys.path, so a bare
+            # ``python -c`` reported "No module named 'ruamel'" for a dashboard that served 200.
+            runtime_command(PROJECT_ROOT, code="import hermes_cli.web_server"),
             capture_output=True,
             text=True,
             encoding="utf-8",
diff --git a/tests/hermes_cli/test_doctor_web_dashboard_import.py b/tests/hermes_cli/test_doctor_web_dashboard_import.py
index 8e3b0b76412..94501f7e272 100644
--- a/tests/hermes_cli/test_doctor_web_dashboard_import.py
+++ b/tests/hermes_cli/test_doctor_web_dashboard_import.py
@@ -10,7 +10,6 @@ crash lands in the report instead of the user's terminal.
 
 from __future__ import annotations
 
-import sys
 
 from hermes_cli import doctor_platform as dp
 from hermes_cli.doctor_report import Finding
@@ -52,8 +51,26 @@ def test_probe_runs_without_lazy_installs(capsys, monkeypatch):
     _run_check(monkeypatch, _FakeCompleted(0, ""), recorded)
 
     (args, kwargs) = recorded[0]
-    assert args[0][:2] == [sys.executable, "-c"]
-    assert args[0][2] == "import hermes_cli.web_server"
+    from hermes_cli._launchers import runtime_command
+    from hermes_cli.doctor import PROJECT_ROOT
+
+    assert args[0] == runtime_command(PROJECT_ROOT, code="import hermes_cli.web_server")
     env = kwargs["env"]
     assert env["HERMES_DISABLE_LAZY_INSTALLS"] == "1"
     assert kwargs["timeout"] >= 60
+
+
+def test_probe_loads_the_dependency_generation_like_the_runtime():
+    """The store interpreter runs isolated; only ``hermes_bootstrap`` adds the dependency generation. A bare
+    ``python -c 'import hermes_cli.web_server'`` failed "No module named 'ruamel'" on every store install
+    while the dashboard served 200 (2026-10-29)."""
+    import subprocess
+
+    from hermes_cli._launchers import runtime_command
+    from hermes_cli.doctor import PROJECT_ROOT
+
+    argv = runtime_command(PROJECT_ROOT, code="import ruamel.yaml, hermes_cli.web_server; print('ok')")
+    assert "-I" in argv and "import hermes_bootstrap" in argv[argv.index("-c") + 1]
+    proc = subprocess.run(argv, cwd=str(PROJECT_ROOT), capture_output=True, text=True, timeout=120, check=False,
+                          env={**__import__("os").environ, "HERMES_DISABLE_LAZY_INSTALLS": "1"})
+    assert proc.returncode == 0 and proc.stdout.strip().endswith("ok"), proc.stderr[-2000:]
-- 
