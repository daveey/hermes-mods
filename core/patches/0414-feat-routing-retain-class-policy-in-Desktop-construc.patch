diff --git a/docs/model-routing.md b/docs/model-routing.md
index 9eb41bed57a85f2aa375b0167bd033409f2d94c2..e50923922b1e63258c97f57a47a330421face53a 100644
--- a/docs/model-routing.md
+++ b/docs/model-routing.md
@@ -89,6 +89,13 @@ CLI integration tests exercise the native Anthropic SDK streaming request throug
 an isolated mock HTTP transport, inspect endpoint/model/OAuth headers, and restore
 from a real temporary session DB. This is not a live entitlement probe.
 
-Desktop, messaging, API, delegation, cron, Kanban and auxiliary adapters and their
-per-entry request/recovery tests remain required before activation. This document
-is not rollout proof.
+Desktop/TUI construction defers class credential resolution until AIAgent has its
+durable session key. Runtime persistence/restoration retains the class while showing
+the concrete model; explicit switches clear the metadata. Config sync does not
+rebalance existing conversations when a class default changes. Desktop tests cover
+construction, restoration, explicit pinning, empty-pool zero sends, and the native
+Anthropic streaming SDK request via mock HTTP transport (not live entitlement).
+
+Messaging, API, delegation, cron, Kanban and auxiliary adapters and their per-entry
+request/recovery tests remain required before activation. Desktop background/preview
+agents and startup readiness also require audit. This document is not rollout proof.
diff --git a/tests/tui_gateway/test_class_routing.py b/tests/tui_gateway/test_class_routing.py
new file mode 100644
index 0000000000000000000000000000000000000000..c3b16cd040c9126f72d4b048f9cdf6c725e57711
--- /dev/null
+++ b/tests/tui_gateway/test_class_routing.py
@@ -0,0 +1,94 @@
+"""Desktop construction and resume preserve the class credential fence."""
+from unittest.mock import patch
+
+import pytest
+import run_agent  # bootstrap before real-home guard
+from tui_gateway import server
+from tests.agent import test_model_routing_agent
+
+routing_home = test_model_routing_agent.routing_home
+streaming_route = test_model_routing_agent.streaming_route
+
+
+@pytest.fixture
+def native_transport(monkeypatch):
+    import json
+    import anthropic
+    import httpx
+    sent = []
+
+    def respond(request):
+        sent.append((str(request.url), dict(request.headers), json.loads(request.content)))
+        events = [
+            {"type": "message_start", "message": {
+                "id": "test", "type": "message", "role": "assistant", "model": "anthropic-deep",
+                "content": [], "stop_reason": None, "usage": {"input_tokens": 10, "output_tokens": 0}}},
+            {"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}},
+            {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "ok"}},
+            {"type": "content_block_stop", "index": 0},
+            {"type": "message_delta", "delta": {"stop_reason": "end_turn"}, "usage": {"output_tokens": 1}},
+            {"type": "message_stop"}]
+        body = "".join(f"event: {e['type']}\ndata: {json.dumps(e)}\n\n" for e in events)
+        return httpx.Response(200, headers={"content-type": "text/event-stream"}, content=body)
+
+    original = anthropic.Anthropic
+
+    def client(**kwargs):
+        return original(**kwargs, http_client=httpx.Client(transport=httpx.MockTransport(respond)))
+
+    monkeypatch.setattr(anthropic, "Anthropic", client)
+    monkeypatch.setattr("agent.title_generator._auto_title_enabled", lambda: False)
+    return sent
+
+
+def test_desktop_construct_resume_and_pin(routing_home, streaming_route, native_transport, monkeypatch):
+    from hermes_cli.config import load_config
+    monkeypatch.setattr(server, "_load_cfg", load_config)
+    monkeypatch.setattr(server, "_resolve_startup_runtime", lambda: ("class:deep", "auto"))
+    monkeypatch.setattr(server, "_agent_cbs", lambda sid: {})
+    monkeypatch.setattr(server, "_load_enabled_toolsets", lambda platform: [])
+    monkeypatch.setattr(server, "_startup_system_prompt", lambda *a: "")
+    monkeypatch.setattr(server, "_get_db", lambda: None)
+    with patch("model_tools.get_tool_definitions", return_value=[]):
+        agent = server._make_agent("ui-id", "durable-id")
+        assert isinstance(agent, run_agent.AIAgent)
+        assert agent.model == "anthropic-deep"
+        assert agent.model_routing["requested_class"] == "deep"
+        assert agent.run_conversation("Say ok")["final_response"] == "ok"
+        assert native_transport
+        assert all(body["model"] == "anthropic-deep" for _, _, body in native_transport)
+        assert all(url.startswith("https://api.anthropic.com/") for url, _, _ in native_transport)
+        assert all(headers.get("authorization", "").startswith("Bearer sk-ant-oat")
+                   and "x-api-key" not in headers for _, headers, _ in native_transport)
+        config = server._runtime_model_config(agent)
+        overrides = server._stored_session_runtime_overrides({"model": agent.model, "model_config": config})
+        assert overrides["model_override"]["model"] == "class:deep"
+        assert overrides["provider_override"] == "auto"
+        resumed = server._make_agent("new-ui-id", "durable-id", **overrides)
+        assert resumed.model_routing == agent.model_routing
+        monkeypatch.setattr(server, "_config_model_target", lambda: ("class:standard", ""))
+        session = {"agent": agent, "model_override": {"model": "class:deep"},
+                   "composer_override_profile": {"model": "old", "provider": "auto"}}
+        with patch.object(server, "_apply_model_switch") as switch:
+            server._sync_agent_model_with_config("ui-id", session)
+        switch.assert_not_called()
+        assert session["model_override"] == {"model": "class:deep"}
+        agent.switch_model(agent.model, agent.provider, api_key=agent.api_key,
+                           base_url=agent.base_url, api_mode=agent.api_mode)
+        assert "model_routing" not in server._runtime_model_config(agent, config)
+        agent.release_clients()
+        resumed.release_clients()
+
+
+def test_desktop_exhaustion_cannot_enter_paid_fallback(routing_home, streaming_route, monkeypatch):
+    from agent.model_routing import ModelRoutingError
+    monkeypatch.setattr(server, "_resolve_startup_runtime", lambda: ("class:deep", "auto"))
+    monkeypatch.setattr(server, "_agent_cbs", lambda sid: {})
+    monkeypatch.setattr(server, "_startup_system_prompt", lambda *a: "")
+    monkeypatch.setattr(server, "_get_db", lambda: None)
+    monkeypatch.setattr("agent.credential_pool.CredentialPool.has_available", lambda *a, **k: False)
+    with patch("anthropic.Anthropic") as sdk, patch.object(server, "_resolve_runtime_with_fallback") as legacy:
+        with pytest.raises(ModelRoutingError):
+            server._make_agent("ui-empty", "durable-empty")
+    sdk.assert_not_called()
+    legacy.assert_not_called()
diff --git a/tui_gateway/class_routing.py b/tui_gateway/class_routing.py
new file mode 100644
index 0000000000000000000000000000000000000000..2463326332ab51dea18b931fd73e0cb2d735cf04
--- /dev/null
+++ b/tui_gateway/class_routing.py
@@ -0,0 +1,52 @@
+"""Class selectors stay intact until AIAgent owns a durable session identity."""
+from agent.model_routing import is_class_selector
+
+
+def deferred_runtime(model, provider, config):
+    if not is_class_selector(model):
+        return None
+    model_config = config.get("model") or {}
+    configured = model_config.get("provider") if isinstance(model_config, dict) else None
+    # AIAgent validates the selector and provider and fences credentials atomically.
+    requested = provider or configured or "auto"
+    return {"provider": requested, "requested_provider": requested}
+
+
+def restore_class_overrides(model, config, overrides):
+    route = config.get("model_routing")
+    if not isinstance(route, dict) or route.get("selected_model") != model:
+        return overrides
+    level = route.get("requested_class")
+    if level not in ("deep", "standard", "fast"):
+        return overrides
+    overrides["model_override"] = {"model": f"class:{level}", "provider": "auto"}
+    overrides["provider_override"] = "auto"
+    return overrides
+
+
+def runtime_model_config(agent, existing, runtime_view, logger):
+    """Persist concrete display identity and class policy, clearing stale explicit-switch metadata."""
+    config = dict(existing or {})
+    route = getattr(agent, "model_routing", None)
+    agent = runtime_view(agent)
+    attr = lambda k: str(getattr(agent, k, "") or "").strip()
+    model, provider, base_url = attr("model"), attr("provider"), attr("base_url")
+    if provider.lower() == "custom":
+        try:
+            from hermes_cli.runtime_provider import canonical_custom_identity
+            provider = canonical_custom_identity(base_url=base_url, model=model or None) or provider
+        except Exception:
+            logger.debug("custom provider identity lookup failed", exc_info=True)
+    reasoning_config = getattr(agent, "reasoning_config", None)
+    live = {
+        "model": model, "provider": provider, "base_url": base_url, "api_mode": attr("api_mode"),
+        "reasoning_config": reasoning_config if isinstance(reasoning_config, dict) else None,
+        "service_tier": getattr(agent, "service_tier", None),
+        "model_routing": route,
+    }
+    for key, value in live.items():
+        if value or isinstance(value, dict):
+            config[key] = value
+        else:
+            config.pop(key, None)
+    return config
diff --git a/tui_gateway/model_switch.py b/tui_gateway/model_switch.py
index f6f6412868ffce08f14de0d6dc03fe3609edbbea..b3da15d4d769b18fd8c11fb474766b501621178e 100644
