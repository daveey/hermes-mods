diff --git a/hermes_cli/kanban_annotation_parts.py b/hermes_cli/kanban_annotation_parts.py
index 40e7be526d0..f50198828e7 100644
--- a/hermes_cli/kanban_annotation_parts.py
+++ b/hermes_cli/kanban_annotation_parts.py
@@ -10,7 +10,12 @@
 inputs that part reads, and forces a part only when its key differs from the one its last forced read answered:
 
 - ``counts``: the boards' and sync shadows' content revisions, the origin ledger, and the plain inputs below;
-- ``links``: the boards' content revisions, the origin ledger and the plain inputs;
+- ``links``: the inputs the links cache keys on (``kanban_session_activity._links_fingerprint``): the boards'
+  content revisions (the hub's tasks/gateway content signature among them) and the origin ledger. The plain inputs
+  are left out on purpose: state.db (alias tips), config and the hub database's raw stat/WAL churn move every few
+  seconds and that cache bounds them by its TTL instead. Keying links on them forced a
+  full ledger projection under ``_links_lock`` on nearly every wake,
+  delaying strict links readers including the Desktop action queue;
 - ``attention``: the boards' content revisions and the files the done checks declared (a declared board or sync
   replica by its content revision, never its stat).
 
@@ -109,7 +114,7 @@
         return None
     ledger = ksa._origin_ledger_fingerprint()
     plain = _plain_key(scope)
-    return {COUNTS: (local, shadows, ledger, plain), LINKS: (local, ledger, plain),
+    return {COUNTS: (local, shadows, ledger, plain), LINKS: (local, ledger),
             ATTENTION: (local, _done_key(scope, wall))}
 
 
diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index f75686d9102..c58fc73e598 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -968,8 +968,9 @@
 
 def _links_lookup(scope: tuple, stale_ok: bool) -> tuple:
     with diag.source("links_display" if stale_ok else "links_strict"):
-        # Native source/clock invalidation must cross the inner TTL cache too:
-        # state/config inputs and wall-time verdicts can move without this key.
+        # The holder forces this past the inner TTL cache when a provider clock deadline came due (wall-time
+        # verdicts move without any key), no key can vouch for the inputs, or the links part key moved
+        # (``kanban_annotation_parts``); state/config churn alone is left to ``_LINKS_MAX_AGE_S``.
         if _revalidate.forced(scope, 'links'):
             with _links_lock:
                 fingerprint = diag.timed("fingerprint", _links_fingerprint)
