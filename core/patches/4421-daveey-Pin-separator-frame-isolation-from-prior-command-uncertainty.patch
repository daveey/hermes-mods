From 5314b831571d1fb09d732521d8b2b31b83c5bc69 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 06:01:20 +0000
Subject: [PATCH] [daveey] Pin separator-frame isolation from prior command
 uncertainty

The #2788 separator reset is not redundant with the classifier word reset:
mask_prefix_expansions runs first and intentionally rejects case grammar.
Without resetting the frame start, a completed prior case expansion can
therefore make a later echo argument look like an arithmetic sink.

Add a behavioral contract across seven separator/comment forms and three
command frames, retaining positive unset controls. Production is unchanged.
No source-shape or frame-offset assertion is introduced.

Proof: canonical run_tests.sh, at current base c1d532eb6fc78327366c462245463c0c76e60aea
and historical #2788 0002f69fbb577e969ab037a7d354e4dfcbe6ab16:
98 passed baseline; exact stack[-1][4] = pos -> stack[-1][4] = stack[-1][4]
mutant fails all 21 new cases. No skips. Differential audit of 1050 inputs
covers comments, redirections, nested quoted frames and 10000-word prior
commands: 105 differences, all prior-case/data-consumer false positives;
baseline classifies all controls correctly. Shell syntax checks pass.
Full scripts/check --base origin/main passed.

Task: t_b5be97c1d7282ea1
---
 tests/cron/test_lifecycle_guard_subscript_linear.py | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/tests/cron/test_lifecycle_guard_subscript_linear.py b/tests/cron/test_lifecycle_guard_subscript_linear.py
index d0f1ab2c257fe7e6d94fe3be3e8dfb94649c5225..ef6a5b237ab570ec721e2362438756d55b35b2de 100644
--- a/tests/cron/test_lifecycle_guard_subscript_linear.py
+++ b/tests/cron/test_lifecycle_guard_subscript_linear.py
@@ -108,6 +108,18 @@ def test_quoted_compound_array_element_is_data():
     assert arith_sink.substitution_in_arithmetic('declare -a "x=([$(cat f)]=1)"', date_exempt=True)
 
 
+@pytest.mark.parametrize("separator", ["; ", "\n", " && ", " || ", " | ", " & ",
+                                       "; # ignored ' \" ; & |\n"])
+@pytest.mark.parametrize("frame", ["{body}", 'printf %s "$({body})"', "({body})"])
+def test_previous_command_uncertainty_does_not_taint_subscript(separator, frame):
+    # The prefix masker deliberately cannot parse case patterns. That uncertainty
+    # belongs to the completed command, not a later data consumer or name builtin.
+    previous = "echo $(case x in (x) :;; esac)" + separator
+    for consumer, expected in (("unset", True), ("echo", False)):
+        command = frame.format(body=previous + f'{consumer} "a[$(printf 7)]"')
+        assert arith_sink.substitution_in_arithmetic(command, date_exempt=False) is expected
+
+
 SINKS = [
     'echo hi; unset "a[{p}]"',
     'echo hi && unset "a[{p}]"',
