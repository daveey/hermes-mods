From cb8da3bf9a6597e707e6ae72ff2a8838cc7fce79 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 09:07:44 +0000
Subject: [PATCH] fix(tests): [daveey] pass Request into direct transcript page
 callers

Five whys: CI 40653617896 shard 2 failed
test_messages_endpoint_reports_corruption (400, not 503) because
07fb47660c added a leading Request and the positional call bound False
to order before the store opened. That caller is fixed on main by
59528bfd7c. The same shift still TypeErrors the two history-page
callers (missing session_id). Shard 1 never reported them: the runner
dropped. Direct calls must pass Request; FastAPI Query defaults are
not applied outside the framework, so order is passed explicitly.
---
 tests/hermes_cli/test_history_commentary_display.py | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/tests/hermes_cli/test_history_commentary_display.py b/tests/hermes_cli/test_history_commentary_display.py
index e64a5be8f9..7dcfc12b41 100644
--- a/tests/hermes_cli/test_history_commentary_display.py
+++ b/tests/hermes_cli/test_history_commentary_display.py
@@ -1,5 +1,7 @@
 """Public Codex commentary is a display projection, never a replay mutation."""
 
+from starlette.requests import Request
+
 from hermes_cli.web_routers.sessions import _project_for_display
 from tui_gateway.server import _history_to_messages
 from agent.history_commentary import visible_commentary
@@ -9,6 +11,10 @@ import asyncio
 import pytest
 
 
+def _messages_request():
+    return Request({"type": "http", "method": "GET", "path": "/", "headers": []})
+
+
 def _row(text="I will inspect the files."):
     return {
         "role": "assistant",
@@ -175,6 +181,7 @@ def test_rest_pages_bind_the_history_owner_for_messages_and_around(
             ("hidden", []),
         ):
             page = await sessions.get_session_messages(
+                _messages_request(),
                 "sid",
                 profile=profile,
                 limit=120,
@@ -182,6 +189,7 @@ def test_rest_pages_bind_the_history_owner_for_messages_and_around(
                 order="latest",
                 include_compacted=True,
             )
+            assert isinstance(page, dict)
             around = await sessions.get_session_messages_around(
                 "sid", row_id=1, profile=profile, limit=120
             )
@@ -235,6 +243,7 @@ def test_unscoped_rest_history_uses_custom_home_of_its_database(monkeypatch, tmp
 
     async def exercise():
         page = await sessions.get_session_messages(
+            _messages_request(),
             "sid",
             profile=None,
             limit=120,
@@ -242,6 +251,7 @@ def test_unscoped_rest_history_uses_custom_home_of_its_database(monkeypatch, tmp
             order="latest",
             include_compacted=True,
         )
+        assert isinstance(page, dict)
         around = await sessions.get_session_messages_around(
             "sid",
             row_id=1,
