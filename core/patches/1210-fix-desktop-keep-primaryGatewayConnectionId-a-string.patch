From 52b178548e163e16c8203953cfc9f28e9660f638 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 08:03:47 +0000
Subject: [PATCH] fix(desktop): keep primaryGatewayConnectionId() a string; pin
 via pinnedPrimaryGatewayConnectionId()

Main's primary-recents caller passes primaryGatewayConnectionId() as a string, so
widening it to null | string broke the desktop typecheck on the merge. The pin
read gets its own null-returning getter; gateway.ts stays at its main line cap.
---
 .../src/app/session/hooks/use-session-list-actions.ts     | 4 ++--
 apps/desktop/src/store/gateway.ts                         | 8 ++++----
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/apps/desktop/src/app/session/hooks/use-session-list-actions.ts b/apps/desktop/src/app/session/hooks/use-session-list-actions.ts
index c9208344587..ea8e3d34e74 100644
--- a/apps/desktop/src/app/session/hooks/use-session-list-actions.ts
+++ b/apps/desktop/src/app/session/hooks/use-session-list-actions.ts
@@ -9,7 +9,7 @@ import {
   SIDEBAR_EXCLUDED_SOURCES
 } from '@/lib/session-source'
 import { markSidebarLive } from '@/store/boot-snapshot'
-import { gatewayActivationEpoch, primaryGatewayConnectionId } from '@/store/gateway'
+import { gatewayActivationEpoch, pinnedPrimaryGatewayConnectionId, primaryGatewayConnectionId } from '@/store/gateway'
 import {
   $pinnedSessionIds,
   $sessionsLimit,
@@ -425,7 +425,7 @@ export function useSessionListActions({ profileScope }: UseSessionListActionsArg
         do {
           activationEpoch = gatewayActivationEpoch()
           primaryConnection = primaryGatewayConnectionId()
-          const primaryPin = primaryGatewayConnectionId('pin')
+          const primaryPin = pinnedPrimaryGatewayConnectionId()
           result = await fetchPage()
 
           if (!owns()) { return }
diff --git a/apps/desktop/src/store/gateway.ts b/apps/desktop/src/store/gateway.ts
index e7654000aff..dffd20d756e 100644
--- a/apps/desktop/src/store/gateway.ts
+++ b/apps/desktop/src/store/gateway.ts
@@ -574,10 +574,10 @@ export function pendingSessionReplay(runtimeId: string): Promise<boolean> | unde
   return pending.length ? Promise.all(pending).then(results => results.every(Boolean)) : undefined
 }
 
-/** Untagged-row owner. `'pin'` omits the 'local' fallback that force-spawns a local serve. */
-export function primaryGatewayConnectionId(mode?: 'pin'): null | string {
-  return mode === 'pin' ? g.primaryConnectionId : (g.primaryConnectionId ?? 'local')
-}
+/** Owner of untagged unified-list rows, never the foreground secondary. */
+export const primaryGatewayConnectionId = (): string => g.primaryConnectionId ?? 'local'
+/** The same owner without the 'local' fallback, which force-spawns a local serve. */
+export const pinnedPrimaryGatewayConnectionId = (): null | string => g.primaryConnectionId
 
 /**
  * The registry connection serving the gateway the user is currently looking
-- 
