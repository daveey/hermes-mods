diff --git a/hermes_cli/kanban_db_dispatch_claims.py b/hermes_cli/kanban_db_dispatch_claims.py
new file mode 100644
index 00000000000..3942f3f31e8
--- /dev/null
+++ b/hermes_cli/kanban_db_dispatch_claims.py
@@ -0,0 +1,86 @@
+"""Claim bookkeeping beside the dispatcher: the in-flight claim test and the leftover local claim sweep. [daveey]
+
+Moved out of ``kanban_db_dispatch`` (which re-exports these names).
+"""
+from __future__ import annotations
+
+import sqlite3
+import time
+
+
+def _kb():
+    from hermes_cli import kanban_db
+    return kanban_db
+
+
+def _worker_alive(pid, started_at) -> bool:
+    from hermes_cli.kanban_db_dispatch import _worker_alive as alive
+    return alive(pid, started_at)
+
+
+# A ``claimed`` event younger than this means a claim may still be publishing, so the orphan sweep leaves
+# the card alone. One claim publication (``claim_task``/``claim_review_task``) is: the Board lease grant
+# RPC (``kanban_sync_client.HTTP_TIMEOUT_S`` = 30 s), the claim txn's ``BEGIN IMMEDIATE`` (busy timeout,
+# ``DEFAULT_BUSY_TIMEOUT_MS`` = 120 s), then, when the CAS was refused, the release RPC of the unused
+# lease (30 s): 180 s worst case. The Board's grant row can reach the local DB anywhere in that window
+# and leaves the card ``running`` with no ``claim_lock``. A real orphan waits at most this long more.
+ORPHAN_CLAIM_GRACE_SECONDS = 180
+
+
+def _claim_in_flight(conn: sqlite3.Connection, task_id: str, now: int) -> bool:
+    """A claim on ``task_id`` may still be publishing: claimed within the grace, or the Board
+    lease mirror says this gateway holds an unexpired lease on it."""
+    if conn.execute(
+        "SELECT 1 FROM task_events WHERE task_id = ? AND kind = 'claimed' AND created_at >= ? LIMIT 1",
+        (task_id, now - ORPHAN_CLAIM_GRACE_SECONDS),
+    ).fetchone():
+        return True
+    return _kb()._sync.held_by_us_live(conn, task_id, now)
+
+
+_LEFTOVER_CLAIM_STATUSES = ("ready", "todo", "review", "blocked", "scheduled", "done")
+
+
+def release_leftover_local_claims(conn: sqlite3.Connection) -> list[str]:
+    """Clear this host's claim fields left on cards that are no longer ``running``; returns their ids. [daveey]
+
+    Invariant: only a ``running`` card holds a local claim. A status-only write (the sync feed's Board lease-expiry
+    row; claim columns are local and never overwritten by a pull) can move a card off ``running`` and leave the dead
+    claimer's ``claim_lock``/``worker_pid`` behind. The dispatcher claims only ``claim_lock IS NULL`` cards and the
+    other sweeps look at ``running`` only, so such a card never started and nothing said why (self-heal
+    agent-dc4177df2e: T6 t_01a1a09e94bfaa25 sat ready 5 days on ``hermes-hub:28820``). Only host-local locks are
+    judged (a pid means nothing elsewhere); a live worker, a claim in flight, or a card leased elsewhere is left
+    alone. Status is unchanged; the CAS matches the exact values read."""
+    now = int(time.time())
+    prefix = _kb()._host_prefix()
+    marks = ",".join("?" * len(_LEFTOVER_CLAIM_STATUSES))
+    rows = conn.execute(
+        f"SELECT id, status, claim_lock, claim_expires, worker_pid, worker_started_at FROM tasks "
+        f"WHERE status IN ({marks}) AND claim_lock IS NOT NULL AND substr(claim_lock, 1, ?) = ?"
+        + _kb()._sync.held_elsewhere_sql(conn),
+        (*_LEFTOVER_CLAIM_STATUSES, len(prefix), prefix),
+    ).fetchall()
+    released: list[str] = []
+    for row in rows:
+        tid, pid = row["id"], row["worker_pid"]
+        if pid and _worker_alive(pid, _kb()._row_get(row, "worker_started_at")):
+            continue
+        if _claim_in_flight(conn, tid, now):
+            continue
+        with _kb().write_txn(conn):
+            cur = conn.execute(
+                "UPDATE tasks SET claim_lock = NULL, claim_expires = NULL, worker_pid = NULL, "
+                "worker_started_at = NULL, last_heartbeat_at = NULL "
+                "WHERE id = ? AND status = ? AND claim_lock IS ? AND claim_expires IS ? AND worker_pid IS ?",
+                (tid, row["status"], row["claim_lock"], row["claim_expires"], pid),
+            )
+            if cur.rowcount != 1:
+                continue
+            _kb()._append_event(conn, tid, "claim_released", {
+                "reason": "leftover_local_claim", "status": row["status"], "claim_lock": row["claim_lock"],
+                "worker_pid": int(pid) if pid else None, "now": now,
+            })
+        released.append(tid)
+    if released:
+        _kb()._log.info("kanban: released leftover local claims on non-running cards: %s", released)
+    return released
diff --git a/hermes_cli/kanban_queue_position.py b/hermes_cli/kanban_queue_position.py
index f5c96a42d4c..a5fab4585e8 100644
--- a/hermes_cli/kanban_queue_position.py
+++ b/hermes_cli/kanban_queue_position.py
@@ -6,7 +6,8 @@ A ready card with no claim for hours looked the same as a stuck one, so chats re
 worker pool instead, and the Board's last answer about it is stored by ``kanban_queue_reason``.
 
 :func:`position` returns ``{"lane": "local", "ahead", "running", "limit", "approximate": True}`` or
-``{"lane": "worker_pool", "reason": <code>}``; None for a card that is not ready.
+``{"lane": "worker_pool", "reason": <code>}``; ``{"lane": "leftover_claim", "claim_lock", "worker_pid"}`` for a ready card
+still holding a local claim (never dispatched); None for a card that is not ready.
 """
 from __future__ import annotations
 
@@ -96,6 +97,11 @@ def position(conn: sqlite3.Connection, task, board: Optional[str] = None) -> Opt
     """The queue a ``ready`` ``task`` in this gateway's live file waits in; None for any other status."""
     if task is None or task.status != "ready":
         return None
+    # [daveey] A ready card still holding a local claim is never picked (the dispatcher claims only claim_lock IS
+    # NULL); say so instead of a slot wait (agent-dc4177df2e: T6 read as a CPU wait for 5 days).
+    lock = conn.execute("SELECT claim_lock, worker_pid FROM tasks WHERE id = ?", (task.id,)).fetchone()
+    if lock is not None and lock[0]:
+        return {"lane": "leftover_claim", "claim_lock": lock[0], "worker_pid": lock[1]}
     from hermes_cli.kanban_worker_placement import POLICY
     if getattr(task, "placement_policy", None) == POLICY:
         from hermes_cli import kanban_queue_reason as kqr
@@ -123,6 +129,10 @@ def describe(place: Optional[dict[str, Any]]) -> Optional[str]:
     if not place:
         return None
     lane = place.get("lane")
+    if lane == "leftover_claim":
+        return (f"held by leftover claim {place.get('claim_lock')} (worker gone, pid {place.get('worker_pid')}): "
+                "the dispatcher skips a ready card with a claim_lock. Its leftover-claim sweep clears a dead local "
+                "claim on the next tick; if this line persists, the claim belongs to a live or foreign worker")
     if lane == "unplaceable":
         missing = place.get("missing") or []
         what = (f"label(s) {', '.join(missing)} carried by no machine" if missing
diff --git a/tests/hermes_cli/test_kanban_leftover_local_claim.py b/tests/hermes_cli/test_kanban_leftover_local_claim.py
new file mode 100644
index 00000000000..42c842821c1
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_leftover_local_claim.py
@@ -0,0 +1,120 @@
+"""A card that is not ``running`` holds no local claim (self-heal agent-dc4177df2e). [daveey]
+
+T6 (t_01a1a09e94bfaa25) went running -> ready through a Board lease-expiry row from the sync feed. Claim fields are
+local-only and never overwritten by a pull, so ``claim_lock``/``worker_pid`` of the dead worker stayed set. The
+dispatcher only claims ready cards with ``claim_lock IS NULL`` and both cleanup sweeps look at ``running`` only, so
+the card sat ready for 5 days and its read said nothing about why.
+"""
+
+from __future__ import annotations
+
+import time
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as kbd
+from hermes_cli import kanban_queue_position as kqp
+
+DEAD_PID = 2 ** 22 - 3  # above the default pid_max: never a live process
+
+
+@pytest.fixture
+def conn(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    db_path = kb.kanban_db_path(board="default")
+    kb._INITIALIZED_PATHS.discard(str(db_path.resolve()))
+    kb.init_db()
+    with kbc.connect() as c:
+        yield c
+
+
+def _feed_requeued(conn, *, pid=DEAD_PID, lock=None, status="ready"):
+    """A card claimed here, then moved off ``running`` by a status-only write (the feed's lease-expiry row): local
+    claim fields stay as the dead claimer left them. The claim is aged past the in-flight grace."""
+    tid = kb.create_task(conn, title="t6", assignee="w")
+    assert kb.claim_task(conn, tid)
+    lock = lock or f"{kb._host_prefix()}28820"
+    conn.execute("UPDATE tasks SET status = ?, claim_lock = ?, worker_pid = ?, worker_started_at = NULL "
+                 "WHERE id = ?", (status, lock, pid, tid))
+    conn.execute("UPDATE task_events SET created_at = ? WHERE task_id = ? AND kind = 'claimed'",
+                 (int(time.time()) - 3600, tid))
+    conn.commit()
+    return tid
+
+
+def _claim_cols(conn, tid):
+    return tuple(conn.execute(
+        "SELECT claim_lock, claim_expires, worker_pid, worker_started_at, last_heartbeat_at FROM tasks WHERE id = ?",
+        (tid,)).fetchone())
+
+
+def test_ready_card_with_dead_claim_is_released_then_claimable(conn):
+    tid = _feed_requeued(conn)
+    assert kb.claim_task(conn, tid) is None  # the bug: never dispatchable
+
+    assert kbd.release_leftover_local_claims(conn) == [tid]
+
+    assert _claim_cols(conn, tid) == (None, None, None, None, None)
+    assert conn.execute("SELECT status FROM tasks WHERE id = ?", (tid,)).fetchone()[0] == "ready"
+    released = [e for e in kb.list_events(conn, tid) if e.kind == "claim_released"]
+    assert released and released[-1].payload["reason"] == "leftover_local_claim"
+    assert released[-1].payload["claim_lock"].endswith(":28820")
+    assert kb.claim_task(conn, tid) is not None
+
+
+def test_dispatch_tick_releases_it_with_nothing_running(conn):
+    """The sweep runs every tick, also when no card is running (T6's board had none running at times)."""
+    tid = _feed_requeued(conn)
+    kbd.dispatch_once(conn, spawn_fn=lambda *a, **k: (True, ""), dry_run=True)
+    assert _claim_cols(conn, tid)[0] is None
+
+
+@pytest.mark.parametrize("status", ["todo", "review", "blocked", "scheduled", "done"])
+def test_every_non_running_status_is_covered(conn, status):
+    tid = _feed_requeued(conn, status=status)
+    assert kbd.release_leftover_local_claims(conn) == [tid]
+    assert conn.execute("SELECT status FROM tasks WHERE id = ?", (tid,)).fetchone()[0] == status
+
+
+def test_live_worker_keeps_its_claim(conn):
+    import os
+    tid = _feed_requeued(conn, pid=os.getpid())
+    assert kbd.release_leftover_local_claims(conn) == []
+    assert _claim_cols(conn, tid)[0] is not None
+
+
+def test_other_hosts_lock_is_not_judged_by_a_local_pid(conn):
+    tid = _feed_requeued(conn, lock="some-other-host:28820")
+    assert kbd.release_leftover_local_claims(conn) == []
+    assert _claim_cols(conn, tid)[0] == "some-other-host:28820"
+
+
+def test_claim_in_flight_is_left_alone(conn):
+    tid = _feed_requeued(conn)
+    conn.execute("UPDATE task_events SET created_at = ? WHERE task_id = ? AND kind = 'claimed'",
+                 (int(time.time()), tid))
+    conn.commit()
+    assert kbd.release_leftover_local_claims(conn) == []
+
+
+def test_running_card_is_not_touched(conn):
+    tid = _feed_requeued(conn, status="running")
+    assert kbd.release_leftover_local_claims(conn) == []
+    assert _claim_cols(conn, tid)[0] is not None
+
+
+def test_card_read_names_the_leftover_claim(conn):
+    """Detection: the read of such a card says why it waits instead of a local-slot wait or nothing."""
+    tid = _feed_requeued(conn)
+    place = kqp.read(conn, kb.get_task(conn, tid))
+    assert place["lane"] == "leftover_claim"
+    assert place["claim_lock"].endswith(":28820")
+    note = kqp.describe(place)
+    assert "leftover claim" in note and "worker gone" in note
-- 
