From 22f15a8f3dc53ea1de560e067aeaa82d96eb72ad Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 05:59:07 +0000
Subject: [PATCH] test(cron): preserve Bash 3.2 hidden-let execution premises
 [daveey]

The four native failures were execution assumptions, not scanner regressions: Bash 3.2 retains Unicode escapes and rejects the quoted parameter subscript before payload evaluation. Pin absence, exit status and diagnostic for those four shapes on 3.2 only; keep modern execution and all arithmetic/output/lifecycle security assertions unchanged. No skips or xfails added.

Proof: isolated GNU Bash 3.2.0 Linux build reproduces exactly 4 failed / 99 passed before; 103 passed after. Canonical modern-Bash suite: 103 passed. Full scripts/check --base origin/main passed. Native job 132683811670 confirms the same four rows; final scheduled macOS acceptance remains with t_9d4372000de9e2db. No mini dispatch.
---
 .../test_lifecycle_guard_arith_let_word.py    | 34 +++++++++++++++++--
 1 file changed, 32 insertions(+), 2 deletions(-)

diff --git a/tests/cron/test_lifecycle_guard_arith_let_word.py b/tests/cron/test_lifecycle_guard_arith_let_word.py
index 4f04b567d0f2be5d0d99a921bb40dca1a28dcff9..291542bd86c99a8becba362c0e4a4f9544c00d7c 100644
--- a/tests/cron/test_lifecycle_guard_arith_let_word.py
+++ b/tests/cron/test_lifecycle_guard_arith_let_word.py
@@ -115,11 +115,41 @@ def _run(tmp_path, shape):
     return command, marker.exists(), result
 
 
+# Bash 3.2 preserves Unicode escapes literally and rejects this parameter subscript
+# before evaluating its quoted substitution. These remain scanner sinks: the guard
+# must conservatively cover newer Bash even when the local shell treats them as data.
+BASH32_DATA = {
+    r"$'le\u0000ignored't 'a[$(SCRIPT)]=1'": (127, "command not found"),
+    r"$'le\U00000000ignored't 'a[$(SCRIPT)]=1'": (127, "command not found"),
+    r"$'\u006cet' 'a[$(SCRIPT)]=1'": (127, "command not found"),
+    r"a=(1); echo ${a[ \let '$(SCRIPT)' ]} 2>/dev/null": (1, "arithmetic operator"),
+}
+
+
+@pytest.fixture(scope="module")
+def bash_version():
+    bash = shutil.which("bash")
+    assert bash is not None, "Bash required for execution proof"
+    result = subprocess.run(
+        [bash, "--noprofile", "--norc", "-c",
+         'printf "%s.%s" "${BASH_VERSINFO[0]}" "${BASH_VERSINFO[1]}"'],
+        env={"PATH": "/usr/bin:/bin"}, capture_output=True, text=True,
+        encoding="utf-8", timeout=10, check=True,
+    )
+    return result.stdout
+
+
 @pytest.mark.platforms("posix")
 @pytest.mark.parametrize("shape", SINKS)
-def test_hidden_let_subscripts_are_sinks(tmp_path, shape):
+def test_hidden_let_subscripts_are_sinks(tmp_path, shape, bash_version):
     command, ran, result = _run(tmp_path, shape)
-    assert ran, (result.returncode, result.stderr)
+    if bash_version == "3.2" and shape in BASH32_DATA:
+        status, diagnostic = BASH32_DATA[shape]
+        assert not ran, (result.returncode, result.stderr)
+        assert result.returncode == status
+        assert diagnostic in result.stderr
+    else:
+        assert ran, (result.returncode, result.stderr)
     assert substitution_in_arithmetic(command, date_exempt=True)
     assert output_reaches_shell(command)
 
-- 
