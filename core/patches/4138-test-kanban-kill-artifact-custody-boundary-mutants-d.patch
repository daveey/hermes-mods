From 600c75a0e9c19fd09427efe30d90a7b7f7c684e1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 04:02:30 +0000
Subject: [PATCH] test(kanban): kill artifact custody boundary mutants [daveey]

Cover the exact attachment cap, incidental source policy, malformed and digest-free delivery receipts, missing receiver bytes and newest completion selection. Canonical four-file restored run: 33 passed, zero skips. Exact-anchor mutation runs reject executor spoofing, policy bypass, relocation forgery, size/retention/cleanup changes, evidence rewriting and unsafe receiver resolution.
---
 .../test_kanban_artifact_delivery.py           |  4 ++++
 .../hermes_cli/test_kanban_artifact_machine.py | 17 +++++++++++++++++
 .../test_kanban_scratch_artifact_custody.py    | 18 ++++++++++++++++++
 3 files changed, 39 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_artifact_delivery.py b/tests/hermes_cli/test_kanban_artifact_delivery.py
index cb1961bbd3..4c63ebd141 100644
--- a/tests/hermes_cli/test_kanban_artifact_delivery.py
+++ b/tests/hermes_cli/test_kanban_artifact_delivery.py
@@ -83,3 +83,7 @@ async def test_notifier_uses_replicated_attachment_and_not_foreign_paths(stores,
         changed = {**record, **changes}
         assert delivery.receipt_delivery_paths(home_conn, tid, [changed]) == []
     assert delivery.receipt_delivery_paths(home_conn, "other-task", [record]) == []
+    without_digest = {key: value for key, value in record.items() if key != "sha256"}
+    assert delivery.receipt_delivery_paths(home_conn, tid, [None, "bad", {}, without_digest]) == []
+    uploaded.unlink()
+    assert delivery.receipt_delivery_paths(home_conn, tid, [record]) == []
diff --git a/tests/hermes_cli/test_kanban_artifact_machine.py b/tests/hermes_cli/test_kanban_artifact_machine.py
index f60dfb14d2..4c1b3faa72 100644
--- a/tests/hermes_cli/test_kanban_artifact_machine.py
+++ b/tests/hermes_cli/test_kanban_artifact_machine.py
@@ -99,6 +99,23 @@ def test_latest_receipt_survives_long_event_history():
     text = format_receipt(latest_receipt(events))
     assert "sha256: abc" in text
     assert "attachment_uid: uid" in text
+    newer = [{"machine": "worker-c", "path": "/new.md"}]
+    events.append(SimpleNamespace(kind="completed", payload={"artifact_receipt": newer}))
+    assert latest_receipt(events) == {"artifact_receipt": newer}
+
+
+def test_exact_attachment_cap_replicates_bytes(stores, monkeypatch):
+    home, worker, home_conn, conn, _, tid, round_at = stores
+    report = worker / "boundary.bin"
+    report.write_bytes(b"proof")
+    monkeypatch.setattr(kb, "KANBAN_ATTACHMENT_MAX_BYTES", 5)
+    record = complete(conn, tid, [str(report)])["artifact_receipt"][0]
+    assert record["attachment_uid"]
+    round_at(worker, "worker")
+    round_at(home, "hub")
+    rows = kb.list_attachments(home_conn, tid)
+    assert len(rows) == 1
+    assert Path(rows[0].stored_path).read_bytes() == b"proof"
 
 
 def test_external_receipt_ref_is_attached_without_rewriting_identity(stores):
diff --git a/tests/hermes_cli/test_kanban_scratch_artifact_custody.py b/tests/hermes_cli/test_kanban_scratch_artifact_custody.py
index 392c396275..09689aaf08 100644
--- a/tests/hermes_cli/test_kanban_scratch_artifact_custody.py
+++ b/tests/hermes_cli/test_kanban_scratch_artifact_custody.py
@@ -68,3 +68,21 @@ def test_scratch_copy_failure_does_not_destroy_existing_evidence(kanban_home, mo
         assert kb.get_task(conn, task).status == "running"
         assert not kb.list_attachments(conn, task)
         assert not [p for p in kb.task_attachments_dir(task).rglob("*") if p.is_file()]
+
+
+def test_incidental_metadata_cannot_launder_denied_source(kanban_home, monkeypatch):
+    from gateway.platforms import base
+    from hermes_cli.kanban_metadata_files import SKIPPED_KEY
+
+    with kbc.connect_closing() as conn:
+        task, ws, run = helpers._scratch_card(conn)
+        secret = ws / "credential"
+        secret.write_text("not for delivery")
+        denied = secret.resolve()
+        monkeypatch.setattr(base, "_path_under_denied_prefix", lambda p: p == denied)
+        monkeypatch.setattr(base, "_media_delivery_allowed_roots", list)
+        assert kb.complete_task(conn, task, summary="Report", expected_run_id=run,
+                                metadata={"report": str(secret)})
+        meta = kb.latest_run(conn, task).metadata
+        assert "denied" in meta[SKIPPED_KEY][str(secret)]
+        assert not kb.list_attachments(conn, task)
