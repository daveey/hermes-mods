From 81073c68c22501c62f4c34f54fcd8cea94d79289 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 04:25:57 +0000
Subject: [PATCH] test(update): tolerate reaping after opening fetch procfs
 stat [daveey]

---
 tests/hermes_cli/test_update_custody.py       |  3 +-
 .../test_update_custody_observation.py        | 46 ++++++++++++++++++-
 2 files changed, 46 insertions(+), 3 deletions(-)

diff --git a/tests/hermes_cli/test_update_custody.py b/tests/hermes_cli/test_update_custody.py
index e5bdb92956..ac9b2c6e18 100644
--- a/tests/hermes_cli/test_update_custody.py
+++ b/tests/hermes_cli/test_update_custody.py
@@ -215,7 +215,8 @@ def _fetch_exited(pid: int) -> bool:
 def _state(pid: int) -> str:
     try:
         stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8-sig")
-    except FileNotFoundError:
+    except (FileNotFoundError, ProcessLookupError):
+        # Reaping before open gives ENOENT; after open, the stat read gives ESRCH.
         return "Z"
     return stat[stat.rfind(")") + 2:][:1]
 
diff --git a/tests/hermes_cli/test_update_custody_observation.py b/tests/hermes_cli/test_update_custody_observation.py
index 58e19ea19d..a75c45a8f3 100644
--- a/tests/hermes_cli/test_update_custody_observation.py
+++ b/tests/hermes_cli/test_update_custody_observation.py
@@ -1,5 +1,7 @@
 """Process observation contracts for the real-fetch custody assertions."""
 
+import subprocess
+import sys
 from pathlib import Path
 
 import pytest
@@ -18,7 +20,7 @@ def test_fetch_exit_observation(monkeypatch, state, exited):
     assert custody._fetch_exited(123) is exited
 
 
-@pytest.mark.parametrize("error", [FileNotFoundError, PermissionError, OSError])
+@pytest.mark.parametrize("error", [FileNotFoundError, ProcessLookupError, PermissionError, OSError])
 def test_fetch_exit_observation_read_errors(monkeypatch, error):
     # The entry existed at a prior observation, but stat may disappear before read.
     monkeypatch.setattr(Path, "exists", lambda self: True)
@@ -27,8 +29,48 @@ def test_fetch_exit_observation_read_errors(monkeypatch, error):
         raise error("proc observation")
 
     monkeypatch.setattr(Path, "read_text", read)
-    if error is FileNotFoundError:
+    if error in (FileNotFoundError, ProcessLookupError):
         assert custody._fetch_exited(123)
     else:
         with pytest.raises(error, match="proc observation"):
             custody._fetch_exited(123)
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.parametrize("after_open", [False, True], ids=["before-open", "before-read"])
+def test_fetch_exit_observation_during_real_reaping(monkeypatch, after_open):
+    # A pipe keeps our child alive without a timer. Reap at the actual procfs
+    # boundary: ENOENT before open, ESRCH when reading an already-open inode.
+    child = subprocess.Popen(
+        [sys.executable, "-c", "import sys; sys.stdin.buffer.read()"],
+        stdin=subprocess.PIPE,
+    )
+    target = Path(f"/proc/{child.pid}/stat")
+    original_open = Path.open
+    observed = []
+
+    def open_then_reap(path, *args, **kwargs):
+        if path != target:
+            return original_open(path, *args, **kwargs)
+        stream = original_open(path, *args, **kwargs) if after_open else None
+        try:
+            child.kill()
+            child.wait(timeout=30)
+            observed.append(after_open)
+        except BaseException:
+            if stream is not None:
+                stream.close()
+            raise
+        return stream if stream is not None else original_open(path, *args, **kwargs)
+
+    try:
+        assert not custody._fetch_exited(child.pid), "live child misclassified as exited"
+        monkeypatch.setattr(Path, "open", open_then_reap)
+        assert custody._fetch_exited(child.pid)
+        assert observed == [after_open]
+    finally:
+        if child.poll() is None:
+            child.kill()
+        child.wait(timeout=30)
+        assert child.stdin is not None
+        child.stdin.close()
-- 
