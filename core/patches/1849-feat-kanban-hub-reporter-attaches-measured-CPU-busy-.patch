--- a/hermes_cli/machine_drain_metrics.py
+++ b/hermes_cli/machine_drain_metrics.py
@@ -31,13 +31,21 @@ def collect():
     return result
 
 
+# Fields newer Boards accept and older Boards reject (400, atomically). CPU busy fields are never resent: the
+# compatibility retry strips them, so an old CPU sample is never re-stamped as fresh.
+ADDITIVE_FIELDS = ("drain_active", "drain_until_ms", "cpu_busy_pct", "cpu_busy_window_ms", "cpu_busy_sample_end_ms")
+
+
 def send_compatible(send, sample):
-    """Old Boards reject unknown metrics atomically; retry only additive drain fields."""
+    """Old Boards reject unknown metrics atomically; retry once with every additive field removed.
+
+    Only a 400 on a sample that carried an additive field is retried; any other error (timeouts included) is raised
+    and the sample is dropped. An unrelated validation error simply fails again on the retry and is raised."""
     from hermes_cli.kanban_sync_client import HubError
 
     try:
         return send(sample)
     except HubError as exc:
-        if exc.status != 400 or not any(k in sample for k in ("drain_active", "drain_until_ms")):
+        if exc.status != 400 or not any(k in sample for k in ADDITIVE_FIELDS):
             raise
-        return send({k: v for k, v in sample.items() if k not in ("drain_active", "drain_until_ms")})
+        return send({k: v for k, v in sample.items() if k not in ADDITIVE_FIELDS})
diff --git a/hermes_cli/machine_metrics.py b/hermes_cli/machine_metrics.py
index 408e60ad965..11edf67ed1a 100644
--- a/hermes_cli/machine_metrics.py
+++ b/hermes_cli/machine_metrics.py
@@ -5,6 +5,12 @@ calls; the kanban sync loop sends it with ``report_due()`` at most every :data:`
 since worker-first-v1 (docs/worker-first-v1.md): the Board's worker-pool admission scores the reported sample, and
 ``kanban_worker_placement.local_admission`` takes a fresh ``collect()`` before turning a policy card's grant into a
 local run. Cards without ``placement_policy`` are still placed without it.
+
+Hub overflow: on a host whose installation-root config sets ``kanban.admission.cpu_busy_below_pct`` the reporter
+also takes a measured ~1 s CPU busy sample (``machine_cpu_metrics.sample``) immediately before each send and attaches
+the complete triple ``cpu_busy_pct``/``cpu_busy_window_ms``/``cpu_busy_sample_end_ms``. ``collect()`` itself never
+samples CPU busy. A CPU-bearing report has a hard 2 s total transport budget and is never replayed: a failed round
+drops its sample and the next round measures again.
 """
 from __future__ import annotations
 
@@ -21,8 +27,8 @@ from typing import Any, Callable, Optional
 
 _log = logging.getLogger(__name__)
 
-REPORT_EVERY_S = 30.0
-# A Board without the route (older deploy) answers 404/405: ask again rarely, not every 30 s.
+REPORT_EVERY_S = 10.0
+# A Board without the route (older deploy) answers 404/405: ask again rarely, not every 10 s.
 UNSUPPORTED_RETRY_S = 600.0
 _GB = 1024 ** 3
 
@@ -128,10 +134,23 @@ class Reporter:
     """Sends ``collect()`` to the Board at most every REPORT_EVERY_S; never raises into the sync loop."""
 
     def __init__(self, send: Callable[[dict], Any], *, collect_fn: Optional[Callable[[], dict]] = None,
-                 clock: Callable[[], float] = time.monotonic) -> None:
+                 clock: Callable[[], float] = time.monotonic,
+                 cpu_limit_fn: Optional[Callable[[], tuple]] = None,
+                 cpu_sample_fn: Optional[Callable[[], Optional[dict]]] = None) -> None:
         self.send, self.collect_fn, self.clock = send, collect_fn, clock
+        self.cpu_limit_fn, self.cpu_sample_fn = cpu_limit_fn, cpu_sample_fn
         self.next_at = 0.0
 
+    def _sample(self) -> dict:
+        from hermes_cli import machine_cpu_metrics as cpu
+        sample = dict((self.collect_fn or collect)())
+        state, _limit = (self.cpu_limit_fn or cpu.root_limit)()
+        if state == cpu.ON:  # only the gated hub pays the ~1 s measurement, taken last: right before sending
+            measured = (self.cpu_sample_fn or cpu.sample)()
+            if measured and all(k in measured for k in cpu.FIELDS):
+                sample.update({k: measured[k] for k in cpu.FIELDS})
+        return sample
+
     def report_due(self) -> bool:
         now = self.clock()
         if now < self.next_at:
@@ -139,7 +158,7 @@ class Reporter:
         self.next_at = now + REPORT_EVERY_S
         try:
             from hermes_cli.machine_drain_metrics import send_compatible
-            send_compatible(self.send, (self.collect_fn or collect)())
+            send_compatible(self.send, self._sample())
             return True
         except Exception as exc:  # health: allow BLE001 -- load reporting must never stop kanban sync
             status = getattr(exc, "status", None)
diff --git a/tests/hermes_cli/test_kanban_sync_metrics_budget.py b/tests/hermes_cli/test_kanban_sync_metrics_budget.py
new file mode 100644
index 00000000000..75088315cc9
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_sync_metrics_budget.py
@@ -0,0 +1,94 @@
+"""A CPU-bearing metrics POST has a hard 2 s total budget (real local HTTP server, real sockets)."""
+import http.server
+import threading
+import time
+
+import pytest
+
+from hermes_cli import kanban_sync_client as ksc
+
+CPU = {"cpu_busy_pct": 12.5, "cpu_busy_window_ms": 1000, "cpu_busy_sample_end_ms": 1_700_000_000_000}
+
+
+class Server:
+    def __init__(self, mode):
+        self.requests = []
+        outer = self
+
+        class H(http.server.BaseHTTPRequestHandler):
+            protocol_version = "HTTP/1.1"
+
+            def log_message(self, *a):
+                pass
+
+            def do_POST(self):
+                n = int(self.headers.get("content-length") or 0)
+                outer.requests.append((self.path, self.rfile.read(n)))
+                if mode == "stall":
+                    time.sleep(4)
+                    body = b"{}"
+                    self.send_response(200)
+                    self.send_header("content-length", str(len(body)))
+                    self.end_headers()
+                    self.wfile.write(body)
+                elif mode == "trickle":  # headers fast, then one byte every 0.4 s: each recv is within its timeout
+                    body = b'{"ok": true}' + b" " * 12
+                    self.send_response(200)
+                    self.send_header("content-length", str(len(body)))
+                    self.end_headers()
+                    for i in range(len(body)):
+                        try:
+                            self.wfile.write(body[i:i + 1])
+                            self.wfile.flush()
+                        except OSError:
+                            return
+                        time.sleep(0.4)
+                else:
+                    body = b'{"ok": true}'
+                    self.send_response(200)
+                    self.send_header("content-length", str(len(body)))
+                    self.end_headers()
+                    self.wfile.write(body)
+
+        self.httpd = http.server.ThreadingHTTPServer(("127.0.0.1", 0), H)
+        self.httpd.daemon_threads = True
+        threading.Thread(target=self.httpd.serve_forever, daemon=True).start()
+        self.url = f"http://127.0.0.1:{self.httpd.server_port}"
+
+    def close(self):
+        self.httpd.shutdown()
+        self.httpd.server_close()
+
+
+@pytest.fixture
+def server(request):
+    s = Server(request.param)
+    yield s
+    s.close()
+
+
+def hub(url):
+    return ksc.Hub(ksc.Identity(url=url, key="k" * 16, gateway="gw"))
+
+
+@pytest.mark.parametrize("server", ["stall", "trickle"], indirect=True)
+def test_cpu_report_has_hard_total_budget(server, monkeypatch):
+    monkeypatch.setattr(ksc.urllib.request, "getproxies", dict)
+    t0 = time.monotonic()
+    with pytest.raises(TimeoutError):
+        hub(server.url).report_metrics({"cpus": 4, **CPU})
+    assert time.monotonic() - t0 <= ksc.CPU_REPORT_BUDGET_S + 0.25
+    assert len(server.requests) == 1  # sent once, never resent
+
+
+@pytest.mark.parametrize("server", ["ok"], indirect=True)
+def test_cpu_report_succeeds_inside_budget_and_plain_report_keeps_normal_path(server, monkeypatch):
+    monkeypatch.setattr(ksc.urllib.request, "getproxies", dict)
+    h = hub(server.url)
+    assert h.report_metrics({"cpus": 4, **CPU}) == {"ok": True}
+    assert h.report_metrics({"cpus": 4}) == {"ok": True}
+    assert len(server.requests) == 2
+
+
+def test_cpu_report_budget_is_two_seconds():
+    assert ksc.CPU_REPORT_BUDGET_S == 2.0
diff --git a/tests/hermes_cli/test_machine_metrics.py b/tests/hermes_cli/test_machine_metrics.py
index e2098b71178..6b143a9301c 100644
--- a/tests/hermes_cli/test_machine_metrics.py
