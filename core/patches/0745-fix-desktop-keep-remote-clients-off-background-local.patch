@@ -0,0 +1,54 @@
+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { normalizeRegistry, resolveRegistryLocalRoute, reuseMatchingPrimaryRemoteBackend } from './connection-registry'
+import { resolveDesktopRemoteRoute } from './desktop-remote-route'
+import { EnvironmentRegistry } from './environment-registry'
+
+const env = { url: 'https://env.test', token: 'process-only-token' }
+
+test('env primary has an owner and registry requests reuse it without a local spawn', async () => {
+  const stored = normalizeRegistry(null)
+  const overlay = new EnvironmentRegistry(env)
+  const registry = overlay.read(stored)
+  assert.equal(overlay.read(stored), registry)
+  const route = resolveDesktopRemoteRoute({ config: { mode: 'local' }, env, registry })
+  assert.equal(route?.connectionId, registry.primary)
+
+  const reused = await reuseMatchingPrimaryRemoteBackend({
+    registry,
+    connectionId: registry.primary,
+    source: registry.connections.find(c => c.id === registry.primary)!,
+    profile: 'research',
+    ensurePrimary: async () => ({ mode: 'remote', connectionId: route?.connectionId })
+  })
+
+  assert.equal(reused?.sharedRemote, true)
+  assert.equal(reused?.profile, 'research')
+  assert.equal(resolveRegistryLocalRoute('default', { globalRemote: true }).delegate, false)
+})
+
+test('env selection and credentials never persist, but saved source edits survive', () => {
+  const stored = normalizeRegistry({ primary: 'saved', lastUsed: 'saved', connections: [
+    { id: 'saved', kind: 'remote', label: 'Saved', url: 'https://saved.test' },
+    { id: 'environment-gateway', kind: 'remote', label: 'Existing', url: 'https://existing.test' }
+  ] })
+
+  const overlay = new EnvironmentRegistry(env)
+  const registry = overlay.read(stored)
+  assert.notEqual(registry.primary, 'environment-gateway')
+
+  const next = { ...registry, lastUsed: registry.primary, connections: registry.connections.map(c =>
+    c.id === 'saved' ? { ...c, label: 'Renamed' } : c) }
+
+  const persisted = overlay.stored(next, stored)
+  assert.equal(persisted.primary, 'saved')
+  assert.equal(persisted.lastUsed, 'saved')
+  assert.equal(persisted.connections.find(c => c.id === 'saved')?.label, 'Renamed')
+  assert.equal(JSON.stringify(persisted).includes(env.token), false)
+  assert.equal(JSON.stringify(persisted).includes(env.url), false)
+  assert.throws(() => overlay.assertEditable(registry.primary), /environment/)
+  overlay.assertEditable('local')
+  assert.equal(new EnvironmentRegistry({}).read(persisted), persisted)
+})
diff --git a/apps/desktop/electron/environment-registry.ts b/apps/desktop/electron/environment-registry.ts
new file mode 100644
index 0000000000..51aab3ebae
--- /dev/null
+++ b/apps/desktop/electron/environment-registry.ts
@@ -0,0 +1,69 @@
+import { connectionIdForLabel, type ConnectionRegistry } from './connection-registry'
+
+/** The env route is a process-local source, never a saved gateway or credential. */
+export class EnvironmentRegistry {
+  private views = new WeakMap<ConnectionRegistry, ConnectionRegistry>()
+  private environmentId: string | null = null
+
+  constructor(private readonly env: { url?: string; token?: string }) {}
+
+  read(stored: ConnectionRegistry): ConnectionRegistry {
+    const url = String(this.env.url || '').trim()
+
+    if (!url) {
+      return stored
+    }
+
+    const cached = this.views.get(stored)
+
+    if (cached) {
+      return cached
+    }
+
+    const id = connectionIdForLabel('Environment gateway', stored.connections.map(c => c.id))
+
+    const view: ConnectionRegistry = {
+      ...stored,
+      primary: id,
+      lastUsed: id,
+      connections: [
+        ...stored.connections,
+        {
+          id,
+          kind: 'remote',
+          label: 'Environment gateway',
+          url,
+          authMode: 'token',
+          token: { encoding: 'plain', value: String(this.env.token || '').trim() }
+        }
+      ]
+    }
+
+    this.environmentId = id
+    this.views.set(stored, view)
+
+    return view
+  }
+
+  /** Keep edits to saved sources, but never persist the env source or its selection. */
+  stored(next: ConnectionRegistry, previous: ConnectionRegistry): ConnectionRegistry {
+    const id = this.environmentId
+
+    if (!id) {
+      return next
+    }
+
+    return {
+      ...next,
+      connections: next.connections.filter(c => c.id !== id),
+      primary: next.primary === id ? previous.primary : next.primary,
+      lastUsed: next.lastUsed === id ? previous.lastUsed : next.lastUsed
+    }
+  }
+
+  assertEditable(id: unknown): void {
+    if (this.environmentId && id === this.environmentId) {
+      throw new Error('This gateway is configured by HERMES_DESKTOP_REMOTE_URL; change the environment to edit it.')
+    }
+  }
+}
