diff --git a/tests/gateway/test_kanban_notify_wake_one_turn.py b/tests/gateway/test_kanban_notify_wake_one_turn.py
index 0618fae30e..356f09dc09 100644
--- a/tests/gateway/test_kanban_notify_wake_one_turn.py
+++ b/tests/gateway/test_kanban_notify_wake_one_turn.py
@@ -440,3 +440,94 @@ def test_a_covered_event_landing_between_the_defer_check_and_the_claim_goes_only
     last, subs = _cursors(tid)
     assert subs["tui"] == (last, None)
     assert _notice_leg() == [] and len(adapter.turns) == 1
+
