From bd0a515ea8dd1bcf787c3506365d32348dff1f64 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 17:07:12 +0000
Subject: [PATCH] ci: diagnose docker-ci bind mount visibility (temporary)

---
 .github/workflows/tests.yml | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index bade4c65584..c639e461dcc 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -195,6 +195,20 @@ jobs:
           test-environment: 'true'
           prune-python-cache: true
 
+      - name: Diagnose bind-mount visibility
+        if: always()
+        env:
+          HERMES_TEST_DOCKER_MOUNT_ROOT: ${{ runner.temp }}/termux-assembly
+        run: |
+          set +e
+          D="$HERMES_TEST_DOCKER_MOUNT_ROOT/diag"; mkdir -p "$D/sub"; touch "$D/sub/marker"
+          id; ls -ld "$D" "$D/sub"; mount | grep -i docker-ci | head; echo "DOCKER_HOST=$DOCKER_HOST"
+          docker info 2>&1 | grep -i "rootless\|userns\|Docker Root\|Storage Driver"
+          docker run --rm --user 0:0 --entrypoint ls -v "$D:/m" python@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a -laR /m
+          docker run --rm --user 0:0 --entrypoint ls -v "$RUNNER_TEMP:/m" python@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a -la /m
+          echo "RUNNER_TEMP=$RUNNER_TEMP"; ls -la "$RUNNER_TEMP" | head -20
+          true
+
       - name: Run assembly permission tests
         # --fail-on-skip: a missing daemon or image must not go green.
         # Bind-mount sources must live where the docker daemon can see them.
-- 
