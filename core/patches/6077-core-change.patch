Subject: [PATCH 6077] TUI RPC method lanes, projects tree caching and GC budget

Public mirror of source commit 4bf39cb6903028f57bc081a5ca0a7a4a50f5e661.

---
diff --git a/tests/tui_gateway/test_non_workspace_policy_cache.py b/tests/tui_gateway/test_non_workspace_policy_cache.py
index c3b08f7d5db..8367adf9d44 100644
--- a/tests/tui_gateway/test_non_workspace_policy_cache.py
+++ b/tests/tui_gateway/test_non_workspace_policy_cache.py
@@ -54,7 +54,6 @@
 def test_changed_home_or_temp_root_is_seen_at_once(homes, monkeypatch, tmp_path):
     import hermes_constants
 
-    home, internal, _ = homes
     other = tmp_path / "other-home"
     other.mkdir()
     assert not server._is_non_workspace_path(str(other / "x"))
@@ -70,7 +69,6 @@
 def test_relinked_root_is_seen_after_the_ttl(homes, monkeypatch, tmp_path):
     import hermes_constants
 
-    home, internal, _ = homes
     first, second = tmp_path / "store-1", tmp_path / "store-2"
     first.mkdir()
     second.mkdir()
diff --git a/tui_gateway/coalesced_build.py b/tui_gateway/coalesced_build.py
index 23c4f06ed68..5f78f62a71e 100644
--- a/tui_gateway/coalesced_build.py
+++ b/tui_gateway/coalesced_build.py
@@ -18,7 +18,7 @@
 
 
 class _State:
-    __slots__ = ("started", "finished", "running", "value", "waiters")
+    __slots__ = ("finished", "running", "started", "value", "waiters")
 
     def __init__(self) -> None:
         self.started = 0  # builds begun
