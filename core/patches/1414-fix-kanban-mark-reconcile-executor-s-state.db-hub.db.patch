From 2b855ee2a97df1f5b5c2f2d3007700ab3d478c13 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 06:10:33 +0000
Subject: [PATCH] fix(kanban): mark reconcile executor's state.db/hub.db reads
 as lockguard-exempt [daveey]

---
 hermes_cli/kanban_notify_reconcile_exec.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_notify_reconcile_exec.py b/hermes_cli/kanban_notify_reconcile_exec.py
index 796ca2c2dc1..86119f255fe 100644
--- a/hermes_cli/kanban_notify_reconcile_exec.py
+++ b/hermes_cli/kanban_notify_reconcile_exec.py
@@ -125,7 +125,7 @@ def local_session_exists(_profile: str, chat: str) -> bool:
     for store in stores:
         if not store.exists():
             continue
-        conn = sqlite3.connect(f"file:{store}?mode=ro", uri=True, timeout=10)
+        conn = sqlite3.connect(f"file:{store}?mode=ro", uri=True, timeout=10)  # noqa: kanban-lockguard (state.db, not a board)
         try:
             if conn.execute("SELECT 1 FROM sessions WHERE id=?", (chat,)).fetchone():
                 return True
@@ -181,7 +181,7 @@ def _sent(read_id: str) -> Optional[dict]:
     path = hub_db_path()
     if not path.exists():
         return None
-    conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=10)
+    conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=10)  # noqa: kanban-lockguard (hub.db, not a board)
     try:
         row = conn.execute("SELECT body, state, result FROM sent WHERE id=?", (read_id,)).fetchone()
     finally:
-- 
