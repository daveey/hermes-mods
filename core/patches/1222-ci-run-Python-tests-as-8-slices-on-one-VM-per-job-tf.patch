From f3ef20cd252875987d54889347ea783b809eec1b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 13:58:33 -0700
Subject: [PATCH] ci: run Python tests as 8 slices on one-VM-per-job
 tfgar-tests runners

Measured 2026-10-29: two slices on the shared hermes-hub pool took 42 min run +
19 min p50 queue each and were ~75% of CI runner-hours; PR wall time p50 93 min.
The suite is ~7.2 h of per-file wall time, LPT-balanced from
test_durations.json, so eight slices at -j 16 on a dedicated 8-vCPU VM target
~7 min of tests each. Full-suite runs (main, release) get 8 slices; PRs keep
the affected planner's count. Timeout 120 -> 30 min. Needs the tfgar-tests
group (metta#29975) live before merge.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/actionlint.yaml              |  2 ++
 .github/workflows/tests.yml          | 30 +++++++++++++---------------
 scripts/ci/affected_tests.py         |  2 +-
 tests/ci/test_fast_runner_routing.py |  7 ++++---
 4 files changed, 21 insertions(+), 20 deletions(-)

diff --git a/.github/actionlint.yaml b/.github/actionlint.yaml
index 2133c192ab8..2bdd3e23c9c 100644
--- a/.github/actionlint.yaml
+++ b/.github/actionlint.yaml
@@ -27,6 +27,8 @@ self-hosted-runner:
     - ci-fast
     # bubblewrap-capable hub slots (tests.yml e2e-upgrade).
     - ci-bwrap
+    # Autoscaled one-VM-per-job group for the Python test slices (tests.yml test).
+    - tfgar-tests
     # Dedicated single-job macOS state-suite runner on the mini.
     - hermes-state
 
diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index f8297d93f9b..8bde505bf29 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -18,7 +18,7 @@ on:
         description: JSON list of slice numbers, 1..N (ci.yaml detect sizes it from test_durations.json).
         type: string
         required: false
-        default: '[1, 2]'
+        default: '[1, 2, 3, 4, 5, 6, 7, 8]'
       # The E2E jobs below are slow lanes (scripts/ci/classify_changes.py).
       # ci.yaml passes the classifier's answer; a caller that passes nothing
       # gets every job.
@@ -50,24 +50,22 @@ concurrency:
 
 jobs:
   test:
-    # Two 32-core slices instead of one box: on one runner the suite is ~10 min of
-    # nearly fully packed work, and a single bigger runner (96-core) scaled ~1.8x for
-    # 3x the price because files contend for the shared machine. Separate machines
-    # scale linearly. run_tests_parallel.py partitions from the checkout alone, so
-    # both slices agree on the split without a planning job.
-    #
-    # The ~10 min figure assumes a dedicated 32-core box per slice. The
-    # self-hosted hermes-hub runners are 6 runner services on ONE 16-core host
-    # (load average ~80 when busy), so a slice gets a fraction of that and
-    # takes ~60-70 min under contention. 30 min cancelled both slices at
-    # 45%/78% (run 39732864100). 120 leaves headroom; revisit if the hub
-    # gets more cores.
+    # Eight slices, each on its own autoscaled VM (tfgar-tests: one on-demand
+    # c7a.2xlarge per job, terminated after it; metta#29975, runner session).
+    # Measured 2026-10-29 with two slices on the shared hermes-hub pool: 42 min
+    # run + 19 min p50 queue per slice, ~75% of all CI runner-hours. The suite is
+    # ~7.2 h of per-file wall time; split 8 ways by run_tests_parallel.py's LPT on
+    # test_durations.json that is ~55 min of files per slice, ~7 min at -j 16
+    # (2 x nproc on 8 vCPU; the VM is not in a shared CPU slice, so
+    # test_workers.py falls back to 2 x nproc). run_tests_parallel.py partitions
+    # from the checkout alone, so all slices agree on the split.
     #
     # Pull requests usually run one slice of affected files (ci.yaml detect sizes the
-    # matrix, scripts/ci/affected_tests.py); every other event runs both.
+    # matrix, scripts/ci/affected_tests.py); every other event runs all eight.
     name: Run tests (${{ inputs.python_changed != '' && 'affected, ' || '' }}${{ matrix.slice }}/${{ strategy.job-total }})
-    runs-on: [self-hosted, hermes-hub]
-    timeout-minutes: 120
+    runs-on: [self-hosted, tfgar-tests]
+    # ~10 min expected; 30 leaves room for a cold cache or a dilated file.
+    timeout-minutes: 30
     strategy:
       fail-fast: false
       matrix:
diff --git a/scripts/ci/affected_tests.py b/scripts/ci/affected_tests.py
index ca5c14c26d2..18c436f3fb0 100755
--- a/scripts/ci/affected_tests.py
+++ b/scripts/ci/affected_tests.py
@@ -52,7 +52,7 @@ FULL_FRACTION = 0.4
 GENERIC = {"__init__.py", "README.md", "index.ts", "index.js", "main.py", "utils.py", "config.py", "cli.py",
            "package.json", "SKILL.md", "types.ts", "constants.py"}
 SLICE_SECONDS = 16 * 300  # one slice: 16 workers x ~5 min of per-file wall time
-MAX_SLICES = 2  # tests.yml's full-suite matrix ([1, 2] on the shared hermes-hub pool)
+MAX_SLICES = 8  # tests.yml's full-suite matrix (one tfgar-tests VM per slice)
 DEFAULT_FILE_SECONDS = 3.0
 
 
diff --git a/tests/ci/test_fast_runner_routing.py b/tests/ci/test_fast_runner_routing.py
index a30ebf89edc..976b02ace35 100644
--- a/tests/ci/test_fast_runner_routing.py
+++ b/tests/ci/test_fast_runner_routing.py
@@ -208,14 +208,15 @@ def test_python_slices_match_their_matrix():
     job = wf["jobs"]["test"]
     assert job["strategy"]["matrix"]["slice"] == "${{ fromJSON(inputs.python_slices) }}"
     default = wf["on"]["workflow_call"]["inputs"]["python_slices"]["default"]
-    assert default == "[1, 2]"
+    assert default == "[1, 2, 3, 4, 5, 6, 7, 8]"
     # The planner's full-suite slice count is the same matrix (scripts/ci/affected_tests.py).
     planner = (ROOT / "scripts" / "ci" / "affected_tests.py").read_text(encoding="utf-8")
-    assert "MAX_SLICES = 2 " in planner
+    assert "MAX_SLICES = 8 " in planner
     run = next(step for step in job["steps"] if step.get("name") == "Run tests")
     assert run["env"]["HERMES_TEST_SLICE"] == "${{ matrix.slice }}/${{ strategy.job-total }}"
     assert "${{ matrix.slice }}/${{ strategy.job-total }}" in job["name"]
-    assert job["runs-on"] == ["self-hosted", "hermes-hub"]
+    # tfgar-tests is one VM per job: a slice never shares a CPU budget with other jobs.
+    assert job["runs-on"] == ["self-hosted", "tfgar-tests"]
 
 
 def test_pull_requests_pass_their_affected_plan_to_the_slices():
-- 
2.55.0

