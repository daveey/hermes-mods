From 3573cd035fe383a856508dfd57d49358fe40bcd8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 04:11:29 +0000
Subject: [PATCH] fix(kanban): keep cross-profile adoption on courier route
 [daveey]

Local interactive provenance is profile-local. Never recommend switching a chat into the card profile to use --local: preserve both profile identities through the supported courier route. Regression routing and owner-entry tests fail on prior head and pass after fix. Focused suites: 81 passed; 37 consumer files: 877 passed; all 21 scripts/check checks passed.
---
 hermes_cli/kanban_origin.py                   |  8 ++---
 .../hermes_cli/test_kanban_origin_adoption.py | 31 ++++++++++++++++++-
 2 files changed, 34 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_origin.py b/hermes_cli/kanban_origin.py
index 891b48c60a..5f353856a7 100644
--- a/hermes_cli/kanban_origin.py
+++ b/hermes_cli/kanban_origin.py
@@ -335,10 +335,10 @@ def adopt_next_step(task_id: str, board: str, *, env: Optional[Mapping[str, str]
         session = _safe(_turn_session_id(env, explicit_env), "<origin-session-id>")
         # "custom" = a HERMES_HOME outside ~/.hermes: no profile name to pass; the CLI resolves its own.
         origin_profile = my_profile if my_profile != "custom" else ""
-    if me and owner_gw == me and (not worker or run_on == me):
-        # Card and chat on the same gateway: a tui subscription binds them, no courier involved.
-        pflag = "" if owner_profile == my_profile else f"-p {owner_profile} "
-        step = f"hermes {pflag}kanban --board {board} origin-adopt {task_id} --local"
+    if me and owner_gw == me and owner_profile == my_profile and (not worker or run_on == me):
+        # Local provenance and tui subscriptions are profile-local. Cross-profile
+        # adoption keeps both identities through the existing courier route.
+        step = f"hermes kanban --board {board} origin-adopt {task_id} --local"
         who = ("A worker is fenced from that on its own board: report to the chat with cross_session instead, or "
                "have the chat run it:" if worker else "Bind this chat to it by running in a terminal here:")
         return {"next_step": step, "run_on": me, "complete": "<" not in step,
diff --git a/tests/hermes_cli/test_kanban_origin_adoption.py b/tests/hermes_cli/test_kanban_origin_adoption.py
index 4daf824394..7e6ef9d883 100644
--- a/tests/hermes_cli/test_kanban_origin_adoption.py
+++ b/tests/hermes_cli/test_kanban_origin_adoption.py
@@ -266,7 +266,36 @@ def test_chat_refusal_for_card_on_another_local_profile_names_it(board, tmp_path
     _hub_state(tmp_path, monkeypatch, "hub", [("hub", "work/release/t_rel1")])
     monkeypatch.setenv("HERMES_SESSION_ID", "s_local")
     refused = _refuse("t_rel1", board="release")
-    assert refused["next_step"] == "hermes -p work kanban --board release origin-adopt t_rel1 --local"
+    assert refused["next_step"] == (
+        "hermes-hub adopt-task hub work/release/t_rel1 --origin-session s_local "
+        "--origin-profile default --id adopt:t_rel1:s_local")
+    assert refused["run_on"] == "hub"
+
+
+def test_cross_profile_hint_executes_through_courier_owner_entry(board, tmp_path, monkeypatch):
+    """Keep source profile provenance; never switch the chat into the target profile."""
+    import shlex
+    from tools.registry import registry
+    conn, tid = board
+    _hub_state(tmp_path, monkeypatch, "hub", [("hub", f"work/default/{tid}")])
+    monkeypatch.setenv("HERMES_SESSION_ID", "s_local")
+    words = shlex.split(_refuse(tid)["next_step"])
+    assert words[:2] == ["hermes-hub", "adopt-task"]
+    # The courier contract carries both profiles independently into the trusted
+    # owner entrypoint; no local state.db lookup in the target profile is needed.
+    profile, slug, task = words[3].split("/")
+    request = {"request_id": words[words.index("--id") + 1],
+               "owner": {"gateway": words[2], "profile": profile, "board": slug, "task_id": task},
+               "origin": {"gateway": "hub", "profile": words[words.index("--origin-profile") + 1],
+                          "session": words[words.index("--origin-session") + 1]}}
+    monkeypatch.setenv("HERMES_PROFILE", "work")
+    result = json.loads(registry.dispatch("kanban_origin_adopt", {"task_id": tid, "board": "default"},
+                                         origin_intent=request))
+    assert result["adopted"] is True, result
+    binding = result["origin_creation"]["binding"]
+    assert binding["owner"]["profile"] == "work"
+    assert binding["origin"] == {"gateway": "hub", "profile": "default", "session": "s_local"}
+    assert conn.execute("SELECT COUNT(*) FROM tasks").fetchone()[0] == 1
 
 
 def test_worker_refusal_points_at_origin_gateway_cli(board, tmp_path, monkeypatch):
