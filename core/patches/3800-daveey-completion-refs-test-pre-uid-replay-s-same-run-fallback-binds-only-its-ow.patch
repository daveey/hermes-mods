From 8dc94e2f9a171cc40d0b8d2af00ddbe7f1ebfe45 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:45:20 +0000
Subject: [PATCH] [daveey] completion refs test: pre-uid replay's same-run
 fallback binds only its own gateway's receipt

Post-merge check t_01a1d615bccc192f of #2398 found mutant 2398-M4 surviving: dropping the
`origin_gateway == origin` condition from `pick`'s same-run fallback (hermes_cli/kanban_completion_refs.py)
left all 45 completion-refs tests green. Nothing else in `pick` scopes that fallback by origin (`mine`
filters only task, kind and id < before), so the mutant is not equivalent.

New behaviour test: an imported pre-uid completion from worker-3 whose integer names nothing; the same
card and run carry worker-3's green receipt and a LATER red receipt from another gateway (worker-4) or
written on this board (NULL origin). The completion must bind worker-3's receipt (verified).

Proof (card t_01a1d66a50953d54):
- GREEN at origin/main + test: test_kanban_completion_refs_sync.py 24 passed.
- RED with M4 applied: both parametrizations fail on `verified(hub, tid) == (True, True)`
  ((False, False)), preconditions passing; 22 passed, 2 failed.
---
 .../test_kanban_completion_refs_sync.py       | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_completion_refs_sync.py b/tests/hermes_cli/test_kanban_completion_refs_sync.py
index bf775685ab..8914eec994 100644
--- a/tests/hermes_cli/test_kanban_completion_refs_sync.py
+++ b/tests/hermes_cli/test_kanban_completion_refs_sync.py
@@ -363,3 +363,31 @@ def test_an_imported_completions_integer_never_binds_a_receipt_written_on_this_b
         hub.execute("UPDATE task_events SET task_id=?, kind='pr_acceptance', payload=?, run_id=? WHERE id=?",
                     (tid, json.dumps(RED), run, worker_int))
     assert verified(hub, tid) == (True, True)
+
+
+@pytest.mark.parametrize("later_origin", ["worker-4", None])
+def test_a_pre_uid_replay_binds_its_own_gateways_run_receipt_not_a_later_one_from_elsewhere(boards, later_origin):
+    """The same-run fallback is scoped to the completion's gateway: a newer receipt of the same card and run id
+    written by another gateway (or on this board) is not the one the worker bound, even when it is the latest."""
+    worker, hub = boards
+    tid = completed_on_worker(worker)
+    replay(worker, hub)
+    event_id, _ = payload_of(hub, tid)
+    rewrite(hub, event_id, lambda p: (p.pop("pr_acceptance_event_uid", None),
+                                      p.update(pr_acceptance_event_id=p["pr_acceptance_event_id"] + 100000)))
+    run = hub.execute("SELECT run_id FROM task_events WHERE id=?", (event_id,)).fetchone()[0]
+    (green,) = receipts(hub, tid)
+    created = hub.execute("SELECT id FROM task_events WHERE task_id=? AND kind='created'", (tid,)).fetchone()["id"]
+    with kb.write_txn(hub):
+        # worker-3's green receipt of this run, earlier; the later receipt of the same run is red, from elsewhere.
+        hub.execute("UPDATE task_events SET kind='pr_acceptance', run_id=?, payload=? WHERE id=?",
+                    (run, green["payload"], created))
+        hub.execute("UPDATE task_events SET payload=?, origin_gateway=? WHERE id=?",
+                    (json.dumps(RED), later_origin, green["id"]))
+    mine, later = receipts(hub, tid)
+    # Precondition: both receipts are this run's and before the completion; the integer names neither.
+    assert mine["run_id"] == later["run_id"] == run and mine["id"] < later["id"] < event_id
+    assert mine["origin_gateway"] == "worker-3" and later["origin_gateway"] == later_origin
+    assert hub.execute("SELECT 1 FROM task_events WHERE id=?",
+                       (payload_of(hub, tid)[1]["pr_acceptance_event_id"],)).fetchone() is None
+    assert verified(hub, tid) == (True, True)
