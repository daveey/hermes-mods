From d1881f0195f89caf48c75adaf6a551d953a15dae Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 09:19:48 +0000
Subject: [PATCH] fix(tui): refresh stored outcome on in-memory session reap
 [daveey]

Hub chats 20000101_000000_000001 / 000002 / 000003 kept unresolved{turn_failed}
after a later complete reply because ws_orphan_reap tears down the live
session without the DB orphan sweep's outcome refresh. Manual
`hermes sessions outcome --refresh` re-derived waiting/done.

Refresh on automatic in-memory ends (ws_orphan_reap, disconnect, idle, lru).
Discount the still-held active lease at turn_end when _last is not yet copied.
Tests: failed_turn then a later good reply must not stay turn_failed.
---
 tests/hermes_state/test_session_outcome.py    | 14 ++++
 .../tui_gateway/test_turn_outcome_refresh.py  | 71 ++++++++++++++++++-
 tui_gateway/session_lifecycle.py              |  6 ++
 tui_gateway/turn_outcome.py                   | 25 ++++++-
 4 files changed, 114 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_state/test_session_outcome.py b/tests/hermes_state/test_session_outcome.py
index 2c53833090..98f22fa165 100644
--- a/tests/hermes_state/test_session_outcome.py
+++ b/tests/hermes_state/test_session_outcome.py
@@ -526,6 +526,20 @@ def test_a_real_reply_after_the_failure_clears_it(db, board):
     assert so.derive_outcome("chat", db=db)["kind"] == "waiting"
 
 
+def test_turn_end_clears_stored_turn_failed_after_a_later_good_reply(db, board):
+    """Stored ``turn_failed`` (the auditor's row) must not survive a later good assistant
+    reply once turn_end refresh runs — no manual ``--refresh``."""
+    add_card(board, "t_run", "chat", "scheduled")
+    say(db, "user", "archive my receipts")
+    failed_turn(db)
+    assert so.refresh_outcome("chat", "turn_end", db=db)["reason"] == "turn_failed"
+    assert so.get_outcome("chat", db=db)["reason"] == "turn_failed"
+    say(db, "assistant", SUMMARY)
+    out = so.refresh_outcome("chat", "turn_end", db=db)
+    assert out["kind"] == "waiting"
+    assert so.get_outcome("chat", db=db)["kind"] == "waiting"
+
+
 def test_interrupted_automation_delivery_does_not_paint_a_waiting_chat(db, board):
     from agent.turn_failure_copy import AUTOMATION_INTERRUPTED_NOTICE
     add_card(board, "t_run", "chat", "scheduled")
diff --git a/tests/tui_gateway/test_turn_outcome_refresh.py b/tests/tui_gateway/test_turn_outcome_refresh.py
