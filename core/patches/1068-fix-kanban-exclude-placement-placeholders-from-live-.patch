From 59ed33340c0c5858018527fcc249e086fb678991 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 14:33:25 -0700
Subject: [PATCH] fix(kanban): exclude placement placeholders from live pollers
 [daveey]

---
diff --git a/tests/hermes_cli/test_kanban_placeholder_sessions.py b/tests/hermes_cli/test_kanban_placeholder_sessions.py
index 973eeaa53b797275124193853f1a17c813aea2fe..ed8536b13f36aaa8f4de6af8cdac8c5606556ae4 100644
--- a/tests/hermes_cli/test_kanban_placeholder_sessions.py
+++ b/tests/hermes_cli/test_kanban_placeholder_sessions.py
@@ -76,3 +76,14 @@ def test_origin_creation_and_ledger_projection_ignore_placeholder(tmp_path, monk
         dict(id=tid, board='default', origin_gateway='hub', session=origin['session'], via='origin')])
     assert kanban_chat_links._ledger_links('default', 'hub') == {}
 
+
+def test_live_pollers_ignore_placeholder_before_storage(monkeypatch):
+    from tui_gateway import kanban_remote_notices, session_notifications
+    def unexpected(*args, **kwargs):
+        raise AssertionError('placeholder reached storage')
+    monkeypatch.setattr(kanban_remote_notices, 'hub_db_path', unexpected)
+    monkeypatch.setattr(session_notifications, '_kb_poll_board_now', unexpected)
+    assert kanban_remote_notices.collect('kanban-placement-macbook', 'default') == []
+    assert session_notifications._kb_poll_board(None, 'default', 'kanban-placement-macbook') == []
+
+
diff --git a/tui_gateway/kanban_remote_notices.py b/tui_gateway/kanban_remote_notices.py
index 077f265b448efe98b38278cb94b7888a8c17c864..848d7c5b0a69e9a9c93a81b25f8c19271708bf24 100644
--- a/tui_gateway/kanban_remote_notices.py
+++ b/tui_gateway/kanban_remote_notices.py
@@ -360,6 +360,9 @@ def collect(session_key: str, profile: str, *, hub_db: Optional[Path] = None, le
     local placeholder already reports. ``transcript_has(notice_key, task_id)`` lets a dead holder's claim be
     acked instead of re-offered, and re-offers a legacy ``delivered=1`` row once. Never raises.
     """
+    from hermes_cli.kanban_placement import is_placeholder_session
+    if is_placeholder_session(session_key):
+        return []
     path = hub_db or hub_db_path()
     if not session_key or not path.is_file():
         return []
-- 
2.55.0

