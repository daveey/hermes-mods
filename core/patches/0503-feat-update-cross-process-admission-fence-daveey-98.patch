--- a/hermes_cli/backend_retirement.py
+++ b/hermes_cli/backend_retirement.py
@@ -56,6 +56,40 @@ class RetirementFence:
             if admitted:
                 self.release()
 
+    @contextmanager
+    def reservation(self, home=None):
+        """Compose process retirement with the cross-process update reservation.
+
+        Neither lock is held while acquiring the other, or while callers hold
+        session locks. The pending reservation remains visible until publication.
+        """
+        from hermes_constants import get_default_hermes_root, get_hermes_home
+        from hermes_cli.admission_fence import reserve, HOLD_MESSAGE, SUPPORTED
+
+        if not SUPPORTED:
+            with self.work() as admitted:
+                yield admitted
+            return
+
+        admitted = self.acquire()
+        pending = None
+        try:
+            if admitted:
+                try:
+                    pending = reserve(get_default_hermes_root(home=home or get_hermes_home()))
+                except (OSError, TimeoutError):
+                    logging.getLogger(__name__).warning("Update admission unavailable", exc_info=True)
+                if pending is None:
+                    logging.getLogger(__name__).info(HOLD_MESSAGE)
+            yield admitted and pending is not None
+        finally:
+            try:
+                if pending is not None:
+                    pending.close()
+            finally:
+                if admitted:
+                    self.release()
+
     def prepare(self):
         from hermes_cli.web_server_idle_proof import idle_proof
 
diff --git a/hermes_cli/kanban_admission.py b/hermes_cli/kanban_admission.py
new file mode 100644
index 0000000000000000000000000000000000000000..3370b8219bb2d11cf5bd55c33c392c92afd1a8cf
--- /dev/null
+++ b/hermes_cli/kanban_admission.py
@@ -0,0 +1,79 @@
+"""Kanban claim publication boundary for the POSIX updater fence."""
+import contextlib
+import logging
+
+
+def claim_and_open_run(conn, task_id, source_status, lock, expires, now, *, event_extra=None, gate=None):
+    """CAS to running and publish its run/event. Caller owns the fenced transaction."""
+    from hermes_cli import kanban_db as kb
+
+    cur = conn.execute(
+        """
+        UPDATE tasks
+           SET status = 'running', human_request = NULL, claim_lock = ?,
+               claim_expires = ?, started_at = COALESCE(started_at, ?)
+         WHERE id = ? AND status = ? AND claim_lock IS NULL
+        """,
+        (lock, expires, now, task_id, source_status),
+    )
+    if cur.rowcount != 1:
+        return None
+    kb._sync.stage_claim(conn, task_id, gate)
+    trow = conn.execute(
+        "SELECT assignee, max_runtime_seconds, current_step_key FROM tasks WHERE id = ?", (task_id,),
+    ).fetchone()
+    run_cur = conn.execute(
+        """
+        INSERT INTO task_runs (
+            task_id, profile, step_key, status, claim_lock, claim_expires, max_runtime_seconds, started_at
+        ) VALUES (?, ?, ?, 'running', ?, ?, ?, ?)
+        """,
+        (task_id, trow["assignee"] if trow else None, trow["current_step_key"] if trow else None,
+         lock, expires, trow["max_runtime_seconds"] if trow else None, now),
+    )
+    run_id = run_cur.lastrowid
+    conn.execute("UPDATE tasks SET current_run_id = ? WHERE id = ?", (run_id, task_id))
+    kb._append_event(
+        conn, task_id, "claimed",
+        {"lock": lock, "expires": expires, "run_id": run_id, **(event_extra or {})}, run_id=run_id,
+    )
+    return run_id
+
+
+@contextlib.contextmanager
+def claim_transaction(conn):
+    """Fence check and real SQL commit share admission.lock (never a savepoint).
+
+    Board storage may be overridden independently of the installation. Use the
+    process's installation root, not the board path. Hooks run after both locks.
+    """
+    from hermes_constants import get_default_hermes_root
+    from hermes_cli.admission_fence import admission_lock, is_held, HOLD_MESSAGE, SUPPORTED
+    from hermes_cli.kanban_db import write_txn
+
+    if conn.in_transaction:
+        raise RuntimeError("Kanban claim cannot run inside an existing transaction")
+    if not SUPPORTED:
+        with write_txn(conn):
+            yield True
+        return
+    # BEGIN IMMEDIATE can wait through SQLite's busy timeout and retries. Do
+    # that before taking the installation-wide flock, so a busy board cannot
+    # stall updater holds or unrelated reservations. Never wait for admission
+    # while owning the DB writer lock: an unavailable flock defers this claim.
+    # The stack deliberately OUTLIVES write_txn: accepted claims must COMMIT
+    # (including retries), or roll back on failure, before releasing admission.
+    with contextlib.ExitStack() as stack:
+        with write_txn(conn):
+            try:
+                root = stack.enter_context(admission_lock(get_default_hermes_root(), timeout=0))
+                held = is_held(root)
+            except (OSError, TimeoutError):
+                logging.getLogger(__name__).warning("Update admission unavailable; deferring Kanban claim", exc_info=True)
+                yield False
+                return
+            if held:
+                logging.getLogger(__name__).info(HOLD_MESSAGE)
+                yield False
+            else:
+                yield True
diff --git a/tests/hermes_cli/test_admission_fence.py b/tests/hermes_cli/test_admission_fence.py
new file mode 100644
index 0000000000000000000000000000000000000000..b89e338b435c7f47dda95fb0746a0e1056b36866
--- /dev/null
+++ b/tests/hermes_cli/test_admission_fence.py
@@ -0,0 +1,216 @@
+"""Real flock tests for the updater's cross-process admission protocol."""
+import json
+import multiprocessing
+
+from pathlib import Path
+import subprocess
+import sys
+import threading
+
+import pytest
+
+from hermes_cli import admission_fence as af
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli.backend_retirement import RetirementFence
+from tui_gateway import server  # bootstrap before the real-home guard
+
+pytestmark = pytest.mark.platforms("posix")
+
+
+def _reservation_child(home, ready, finish):
+    reservation = af.reserve(home)
+    ready.set()
+    finish.wait(20)
+    reservation.close()
+
+
+def _lock_child(home, ready, finish):
+    with af.admission_lock(home):
+        ready.set()
+        finish.wait(20)
+
+
+def test_hold_refuses_and_existing_reservation_survives(tmp_path):
+    reservation = af.reserve(tmp_path)
+    assert af.state(tmp_path)["reservations"] == 1
+    assert af.set_hold(tmp_path) == {"version": 1, "held": True, "reservations": 1}
+    assert af.reserve(tmp_path) is None
+    reservation.close()
+    reservation.close()
+    assert af.state(tmp_path)["reservations"] == 0
+    af.clear_hold(tmp_path)
+    af.reserve(tmp_path).close()
+
+
+def test_cross_process_reservation_and_crash_cleanup(tmp_path):
+    ctx = multiprocessing.get_context("spawn")
+    ready, finish = ctx.Event(), ctx.Event()
+    child = ctx.Process(target=_reservation_child, args=(tmp_path, ready, finish))
+    child.start()
+    try:
+        assert ready.wait(10)
+        assert af.set_hold(tmp_path)["reservations"] == 1
+        child.kill()
+        child.join(10)
+        assert af.state(tmp_path) == {"version": 1, "held": True, "reservations": 0}
+    finally:
+        if child.is_alive():
+            child.kill()
+        child.join(10)
+
+
+def test_lock_timeout_and_process_crash_releases_lock(tmp_path):
+    ctx = multiprocessing.get_context("spawn")
+    ready, finish = ctx.Event(), ctx.Event()
+    child = ctx.Process(target=_lock_child, args=(tmp_path, ready, finish))
+    child.start()
+    try:
+        assert ready.wait(10)
+        with pytest.raises(TimeoutError):
+            with af.admission_lock(tmp_path, timeout=0.05):
+                pytest.fail("crossed process lock")
+        child.kill()
+        child.join(10)
+        assert af.state(tmp_path)["reservations"] == 0
+    finally:
+        if child.is_alive():
+            child.kill()
+        child.join(10)
+
+
+def test_retirement_composition_and_profile_root(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    profile = tmp_path / "profiles" / "test"
+    profile.mkdir(parents=True)
+    fence = RetirementFence()
+    with fence.reservation(profile) as admitted:
+        assert admitted
+        assert af.state(tmp_path)["reservations"] == 1
+        assert fence.prepare() == {"ok": False, "idle": False}
+        af.set_hold(tmp_path)
+    assert fence.active_count() == 0
+    with fence.reservation(profile) as admitted:
+        assert not admitted
+    assert fence.active_count() == 0
+    assert af.state(tmp_path)["reservations"] == 0
+
+
+def test_desktop_pending_and_worker_are_counted(tmp_path, monkeypatch):
+    from hermes_cli import backend_retirement
+    fence = RetirementFence()
+    monkeypatch.setattr(backend_retirement, "retirement", fence)
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    session = {"history_lock": threading.RLock(), "profile_home": str(tmp_path)}
+    with server._session_turn_admission(session) as admitted:
+        assert admitted
+        assert af.state(tmp_path)["reservations"] == 1
+    entered, finish = threading.Event(), threading.Event()
+
+    def work():
+        entered.set()
+        assert finish.wait(10)
+
+    thread = server._start_session_work(work, name="test-update-work", session=session)
+    try:
+        assert entered.wait(10)
+        assert af.set_hold(tmp_path)["reservations"] == 1
+        with server._session_turn_admission(session) as admitted:
+            assert not admitted
+        # An already admitted turn may hand off more stages under the hold;
+        # an independent new session must still be denied.
+        fresh = {"history_lock": threading.RLock(), "profile_home": str(tmp_path)}
+        assert server._start_session_work(lambda: pytest.fail("ran"), name="denied", session=fresh) is None
+    finally:
+        finish.set()
+        thread.join(10)
+    assert fence.active_count() == 0
+    assert af.state(tmp_path)["reservations"] == 0
+
+
+@pytest.mark.parametrize("review", [False, True])
+def test_hold_blocks_kanban_claims_without_mutation(tmp_path, monkeypatch, review):
+    from hermes_cli import kanban_db as kb
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    conn = kbc.connect(tmp_path / "kanban.db")
+    try:
+        task = kb.create_task(conn, title="held", assignee="default")
+        status = "review" if review else "ready"
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET status=? WHERE id=?", (status, task))
+        claim = kb.claim_review_task if review else kb.claim_task
+        af.set_hold(tmp_path)
+        assert claim(conn, task) is None
+        assert kb.get_task(conn, task).status == status
+        assert conn.execute("SELECT count(*) FROM task_runs").fetchone()[0] == 0
+        af.clear_hold(tmp_path)
+        assert claim(conn, task).status == "running"
+        assert not conn.in_transaction
+    finally:
+        conn.close()
+
+
+def test_claim_rejects_nested_transaction_before_waiting(tmp_path, monkeypatch):
+    from hermes_cli import kanban_db as kb
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    conn = kbc.connect(tmp_path / "kanban.db")
+    try:
+        with kb.write_txn(conn), af.admission_lock(tmp_path):
+            with pytest.raises(RuntimeError, match="existing transaction"):
+                kb.claim_task(conn, "not-needed")
+    finally:
+        conn.close()
+
+
+@pytest.mark.parametrize("review", [False, True])
+def test_claim_fence_spans_commit_and_hooks_run_after_release(tmp_path, monkeypatch, review):
+    from hermes_cli import kanban_db as kb
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    conn = kbc.connect(tmp_path / "kanban.db")
+    observed = []
+    try:
+        task = kb.create_task(conn, title="publication", assignee="default")
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET status=? WHERE id=?", ("review" if review else "ready", task))
+
+        def trace(sql):
+            if sql == "COMMIT":
+                try:
+                    with af.admission_lock(tmp_path, timeout=0):
+                        observed.append("unfenced")
+                except TimeoutError:
+                    observed.append("fenced")
+
+        def hook(*args):
+            with af.admission_lock(tmp_path, timeout=0):
+                observed.append("hook-unlocked")
+
+        monkeypatch.setattr(kb, "_fire_task_hook", hook)
+        conn.set_trace_callback(trace)
+        assert (kb.claim_review_task if review else kb.claim_task)(conn, task)
+        conn.set_trace_callback(None)
+        assert observed == (["fenced"] if review else ["fenced", "hook-unlocked"])
+        assert af.set_hold(tmp_path)["held"]
+        with kbc.connect(tmp_path / "kanban.db") as reader:
+            assert kb.get_task(reader, task).status == "running"
+            assert reader.execute("SELECT count(*) FROM task_runs WHERE status='running'").fetchone()[0] == 1
+    finally:
+        conn.close()
+
+
+def test_retirement_idle_probe_can_read_fence_without_deadlock(tmp_path, monkeypatch):
+    from hermes_cli import web_server_idle_proof
+    fence = RetirementFence()
+    monkeypatch.setattr(web_server_idle_proof, "idle_proof", lambda: {"idle": af.state(tmp_path)["reservations"] == 0})
+    token = fence.prepare()["token"]
+    with fence.reservation(tmp_path) as admitted:
+        assert not admitted
+    assert fence.cancel(token)["ok"]
+    with fence.reservation(tmp_path) as admitted:
+        assert admitted
+
+
+def test_standalone_capability_uses_only_stdlib():
+    result = subprocess.run([sys.executable, "-S", str(Path(af.__file__)), "capability"],
+                            check=True, capture_output=True, text=True)
+    assert json.loads(result.stdout) == af.CAPABILITY
diff --git a/tests/hermes_cli/test_kanban_admission_contention.py b/tests/hermes_cli/test_kanban_admission_contention.py
new file mode 100644
index 0000000000000000000000000000000000000000..310f27391b27883d4ee3fac913ba99af7529e996
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_admission_contention.py
@@ -0,0 +1,156 @@
+"""Real SQLite/flock contention at the Kanban publication boundary."""
+import contextlib
+import sqlite3
+import threading
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+
+from hermes_cli import admission_fence as af
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli.kanban_admission import claim_transaction
+
+pytestmark = pytest.mark.platforms("posix")
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    conn = kbc.connect(tmp_path / "kanban.db")
+    try:
+        yield conn, tmp_path
+    finally:
+        conn.close()
+
+
+def _task(conn, review):
+    task = kb.create_task(conn, title="contention", assignee="default")
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET status=? WHERE id=?", ("review" if review else "ready", task))
+    return task
+
+
+@pytest.mark.parametrize("review", [False, True])
+def test_sqlite_wait_does_not_block_admission_and_new_hold_wins(board, review):
+    conn, home = board
+    task = _task(conn, review)
+    began = threading.Event()
+    claim = kb.claim_review_task if review else kb.claim_task
+
+    def worker():
+        # Schema/bootstrap has already run; use a separate real DB connection.
+        with contextlib.closing(sqlite3.connect(home / "kanban.db", timeout=5)) as other:
+            other.row_factory = sqlite3.Row
+            other.set_trace_callback(lambda sql: began.set() if sql == "BEGIN IMMEDIATE" else None)
+            return claim(other, task)
+
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        conn.execute("BEGIN IMMEDIATE")
+        future = pool.submit(worker)
+        try:
+            assert began.wait(5)
+            assert not future.done()
+            # A blocked BEGIN must leave the global lock free. The updater can
+            # install a hold before the writer is released; the claimant must
+            # check that NEW hold, not a snapshot taken before its SQLite wait.
+            with af.admission_lock(home, timeout=0.2):
+                pass
+            reservation = af.reserve(home)
+            assert reservation is not None
+            reservation.close()
+            assert af.set_hold(home)["held"]
+        finally:
+            conn.execute("ROLLBACK")
+        assert future.result(timeout=10) is None
+    assert kb.get_task(conn, task).status == ("review" if review else "ready")
+    assert conn.execute("SELECT count(*) FROM task_runs").fetchone()[0] == 0
+    assert conn.execute("SELECT count(*) FROM task_events WHERE kind='claimed'").fetchone()[0] == 0
+
+
+@pytest.mark.parametrize("review", [False, True])
+def test_busy_admission_defers_without_waiting_or_leaking_writer(board, monkeypatch, review):
+    conn, home = board
+    task = _task(conn, review)
+    real_lock = af.admission_lock
+    attempts = []
+
+    @contextlib.contextmanager
+    def checked_lock(root, *, timeout=10):
+        attempts.append(timeout)
+        assert conn.in_transaction  # DB first, flock second.
+        assert timeout == 0  # No sleep/retry while owning the DB writer.
+        with real_lock(root, timeout=timeout) as locked:
+            yield locked
+
+    with real_lock(home):
+        monkeypatch.setattr(af, "admission_lock", checked_lock)
+        assert (kb.claim_review_task if review else kb.claim_task)(conn, task) is None
+        assert not conn.in_transaction
+        with contextlib.closing(sqlite3.connect(home / "kanban.db", timeout=0)) as other:
+            other.execute("BEGIN IMMEDIATE")
+            other.rollback()
+    assert attempts == [0]
+    assert kb.get_task(conn, task).status == ("review" if review else "ready")
+    assert conn.execute("SELECT count(*) FROM task_runs").fetchone()[0] == 0
+
+
+@pytest.mark.parametrize("fail_commit", [False, True])
+def test_commit_retry_and_failure_remain_fenced(board, monkeypatch, fail_commit):
+    conn, home = board
+    task = _task(conn, False)
+    boundaries = []
+    real_boundary = kbc._execute_boundary_with_retry
+
+    def boundary(connection, sql):
+        if sql == "COMMIT":
+            # Simulate a slow/retried COMMIT boundary. The outer flock must
+            # remain held through the whole helper and through rollback.
+            for _ in range(2):
+                with pytest.raises(TimeoutError):
+                    with af.admission_lock(home, timeout=0):
+                        pytest.fail("commit escaped admission lock")
+                boundaries.append(sql)
+            if fail_commit:
+                raise sqlite3.OperationalError("database is locked")
+        return real_boundary(connection, sql)
+
+    rollbacks = []
+
+    def trace(sql):
+        if sql == "ROLLBACK":
+            try:
+                with af.admission_lock(home, timeout=0):
+                    rollbacks.append("unfenced")
+            except TimeoutError:
+                rollbacks.append("fenced")
+
+    monkeypatch.setattr(kbc, "_execute_boundary_with_retry", boundary)
+    conn.set_trace_callback(trace)
+    if fail_commit:
+        with pytest.raises(sqlite3.OperationalError, match="locked"):
+            kb.claim_task(conn, task)
+    else:
+        assert kb.claim_task(conn, task).status == "running"
+    assert boundaries == ["COMMIT", "COMMIT"]
+    assert rollbacks == (["fenced"] if fail_commit else [])
+    assert not conn.in_transaction
+    with af.admission_lock(home, timeout=0):
+        pass
+    assert kb.get_task(conn, task).status == ("ready" if fail_commit else "running")
+    assert conn.execute("SELECT count(*) FROM task_runs").fetchone()[0] == (0 if fail_commit else 1)
+
+
+def test_body_error_rolls_back_before_unlock(board):
+    conn, home = board
+    task = _task(conn, False)
+    with pytest.raises(ValueError, match="abort"):
+        with claim_transaction(conn) as admitted:
+            assert admitted
+            conn.execute("UPDATE tasks SET status='running' WHERE id=?", (task,))
+            raise ValueError("abort")
+    assert not conn.in_transaction
+    assert kb.get_task(conn, task).status == "ready"
+    with af.admission_lock(home, timeout=0):
+        pass
