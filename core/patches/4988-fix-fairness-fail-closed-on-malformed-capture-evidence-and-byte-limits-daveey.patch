         raise ValueError("max_bytes outside capture bound")
@@ -65,6 +144,15 @@ def append_records(out: Path, records, *, max_bytes: int = MAX_CAPTURE_BYTES) ->
         raise ValueError("capture is already sealed")
     state = receipts(out)
