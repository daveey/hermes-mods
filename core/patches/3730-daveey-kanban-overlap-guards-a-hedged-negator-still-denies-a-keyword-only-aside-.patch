From 70f920be3feaaa7c4cbbc28b7d3417b965b379ed Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 18:06:32 +0000
Subject: [PATCH] [daveey] kanban overlap guards: a hedged negator still
 denies; a keyword-only aside is no keyword; none other than is no count;
 pass/take/try are legs

PR #2481 review 5895781842 (card t_01a1d610e8e7a850) found the narrowed filler list after a negator
regressed ordinary denials ('Not a real duplicate of t_X', 'No other duplicates, parent t_X' and four
more read as naming t_X). Restore the two-word window: only 'non' takes a hyphen (so 'No-op as
duplicate' is no denial) and a 'no'/'0' window holding as/with counts a noun ('no changes as
duplicate of t_X'). Non-blocking behaviour nits fixed too: an aside naming a keyword but no card
('Closed as duplicate (not superseded) of t_X') is blanked before scanning; 'none'/'0' denies only
when it ends the clause ('Duplicate: none other than t_X' names t_X); pass/take/try are no longer
re-issue words ('Pass 1 of 3' / 'Pass 2 of 3' is a staged leg).

RED at d7a18234f9 source: 9 new cases failed (8 detector, 1 enumeration). GREEN: 68/68 in the two
target files.
---
 hermes_cli/kanban_dup_detector.py             | 27 ++++++++++++-------
 hermes_cli/kanban_overlap_own.py              |  3 ++-
 tests/hermes_cli/test_kanban_dup_detector.py  | 25 +++++++++++++++++
 ...test_kanban_create_overlap_same_creator.py |  1 +
 4 files changed, 46 insertions(+), 10 deletions(-)

diff --git a/hermes_cli/kanban_dup_detector.py b/hermes_cli/kanban_dup_detector.py
index 5e0ad83adc..9097553a38 100644
--- a/hermes_cli/kanban_dup_detector.py
+++ b/hermes_cli/kanban_dup_detector.py
@@ -30,14 +30,22 @@ _CARD = r"t_[0-9a-f]{8,16}"
 _KEYWORD = re.compile(r"\b(?:duplicat\w*|supersed\w*)\b", re.IGNORECASE)
 _AFTER = re.compile(rf"[^.\n]{{0,120}}?\b({_CARD})\b")
 # A denial that governs the keyword in its own clause: "Not a duplicate of t_X", "No duplicates found; parent
-# t_X", "isn't a duplicate", "non-duplicate", "0 duplicates" (PR #2329 review). Only an article or a hedge may
-# sit between, so "No-op as duplicate of t_X" and "no changes as duplicate of t_X" are not denials (PR #2429
-# review). An earlier clause ("No code changes; duplicate of t_X") does not deny it.
-_FILLER = r"(?:a|an|the|as|really|actually|truly|exactly|strictly|just|simply|considered|marked|being|been|be)"
-_NEGATED = re.compile(rf"(?:\b(?:not|no|never|non|zero|\w+n['\u2019]t)|(?<![\w.])0)[\s-]+(?:{_FILLER}\s+){{0,3}}$",
-                      re.IGNORECASE)
-# "Checked for duplicates: none", "Duplicates found: 0": a count of none right after the keyword.
-_NONE_AFTER = re.compile(r"\s*(?:found\s*)?[:=\-\u2013\u2014]?\s*(?:none|nil|zero|0)\b", re.IGNORECASE)
+# t_X", "isn't a duplicate", "non-duplicate", "0 duplicates", "Not a real duplicate", "No other duplicates" (PR
+# #2329 review). Up to two words may sit between. Only "non" takes a hyphen, so "No-op as duplicate of t_X" is
+# no denial, and a "no"/"0" whose window holds "as"/"with" counts a noun, not the keyword ("no changes as
+# duplicate of t_X") (PR #2429 reviews). An earlier clause ("No code changes; duplicate of t_X") does not deny it.
+_WORD = r"[\w'\u2019]+\s+"
+_NOT_NOUN = rf"(?:(?!(?:as|with)\b){_WORD})"
+_NEGATED = re.compile(rf"(?:\b(?:not|never|\w+n['\u2019]t)\s+(?:{_WORD}){{0,2}}"
+                      rf"|(?:\b(?:no|zero)|(?<![\w.])0)\s+{_NOT_NOUN}{{0,2}}"
+                      r"|\bnon[\s-]+)$", re.IGNORECASE)
+# "Checked for duplicates: none", "Duplicates found: 0": a count of none right after the keyword that ends the
+# clause ("Duplicate: none other than t_X" names t_X).
+_NONE_AFTER = re.compile(r"\s*(?:found\s*)?[:=\-\u2013\u2014]?\s*(?:none|nil|zero|0)(?:\s+found)?(?=\s*(?:[.;:!?,)\n]|$))",
+                         re.IGNORECASE)
+# An aside that names a keyword but no card ("Closed as duplicate (not superseded) of t_X") is blanked first, so
+# its keyword neither stops nor denies the outer one (PR #2481 review).
+_ASIDE = re.compile(r"\([^()\n]*\)")
 _CLAUSE_END = re.compile(r"[.;:!?,\n]")
 
 
@@ -52,7 +60,8 @@ def sibling_named(text: str) -> list[str]:
 
     A keyword's forward window stops at the next keyword, so "Duplicate check: not a duplicate of t_X" is the
     denied second keyword's, not the first one's (PR #2429 review)."""
-    text = text or ""
+    text = _ASIDE.sub(lambda m: m.group(0) if re.search(_CARD, m.group(0)) or not _KEYWORD.search(m.group(0))
+                      else " " * len(m.group(0)), text or "")
     found = []
     keywords = list(_KEYWORD.finditer(text))
     for i, kw in enumerate(keywords):
diff --git a/hermes_cli/kanban_overlap_own.py b/hermes_cli/kanban_overlap_own.py
index a1f9ba203b..530ae1d96b 100644
--- a/hermes_cli/kanban_overlap_own.py
+++ b/hermes_cli/kanban_overlap_own.py
@@ -104,7 +104,8 @@ def _title_tokens(title: str) -> list[str]:
 
 
 # A counter after one of these words numbers a re-issue of the same work, not a leg (PR #2429 review).
-_REISSUE_WORD = re.compile(r"(?:attempts?|rounds?|retry|retries|try|tries|take|v|rev|revision|pass|iteration)",
+# "pass"/"take"/"try" are left out: "Pass 1 of 3: parser" / "Pass 2 of 3: parser" are staged legs (PR #2481 review).
+_REISSUE_WORD = re.compile(r"(?:attempts?|rounds?|retry|retries|v|rev|revision|iterations?)",
                            re.IGNORECASE)
 _REISSUE_TOKEN = re.compile(r"(?:v|rev)\d+(?:\.\d+)*", re.IGNORECASE)  # "v2", "rev3"
 _ORDINAL = re.compile(r"\d+(?:st|nd|rd|th)", re.IGNORECASE)  # "2nd attempt"
diff --git a/tests/hermes_cli/test_kanban_dup_detector.py b/tests/hermes_cli/test_kanban_dup_detector.py
index 1da019045a..f2e7d124b2 100644
--- a/tests/hermes_cli/test_kanban_dup_detector.py
+++ b/tests/hermes_cli/test_kanban_dup_detector.py
@@ -117,6 +117,31 @@ def test_a_negator_that_does_not_govern_the_keyword_does_not_deny_it(summary):
     assert dd.sibling_named(summary) == ["t_0123456789abcdef"]
 
 
+@pytest.mark.parametrize("summary", [
+    "Not a real duplicate of t_0123456789abcdef.",
+    "No other duplicates, parent t_0123456789abcdef owns it.",
+    "No known duplicates; parent t_0123456789abcdef.",
+    "No open duplicates; see t_0123456789abcdef.",
+    "No obvious duplicate of t_0123456789abcdef.",
+    "Not an exact duplicate; parent t_0123456789abcdef.",
+    "Not marked as duplicate of t_0123456789abcdef.",
+    "Checked for duplicates: none found, parent t_0123456789abcdef.",
+])
+def test_a_negator_two_words_before_the_keyword_still_denies_it(summary):
+    """PR #2481 review: a hedge or adjective between the negator and the keyword keeps the denial."""
+    assert dd.sibling_named(summary) == []
+
+
+@pytest.mark.parametrize("summary", [
+    "Closed as duplicate (not superseded) of t_0123456789abcdef.",
+    "Duplicate: none other than t_0123456789abcdef.",
+    "Closed (duplicate of t_0123456789abcdef).",
+])
+def test_an_aside_or_a_none_that_does_not_end_the_clause_keeps_the_card(summary):
+    """PR #2481 review: a keyword-only aside is not a later keyword, and "none other than" is not a count."""
+    assert dd.sibling_named(summary) == ["t_0123456789abcdef"]
+
+
 def test_a_closed_detector_card_lets_the_next_occurrence_open_a_new_one(conn):
     creator = kb.create_task(conn, title="creator", assignee="default")
     first, second = _pair(conn, creator)
