From 3cffefa01beee6aad7a2ad2b9ccea34127fcbd5c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 06:05:18 -0800
Subject: [PATCH] [daveey] kanban: a provisional failure event does not stop
 the wake from settling the tui sibling (no second failure_finalized turn
 after archive)

---
 gateway/kanban_wake_sibling.py                |  6 +++-
 .../test_kanban_notify_wake_one_turn.py       | 32 +++++++++++++++++++
 2 files changed, 37 insertions(+), 1 deletion(-)

diff --git a/gateway/kanban_wake_sibling.py b/gateway/kanban_wake_sibling.py
index a267fe0027..fbe92bd8ea 100644
--- a/gateway/kanban_wake_sibling.py
+++ b/gateway/kanban_wake_sibling.py
@@ -160,6 +160,7 @@ def settle_tui_sibling(board: Optional[str], sub: dict, upto: int) -> bool:
     from types import SimpleNamespace
 
     from hermes_cli import kanban_db_connect as kbc
+    from hermes_cli.kanban_failure_notice import provisional_failure
     from tui_gateway.session_notifications import _KANBAN_EVENT_FORMATTERS
     if not _waking_local(sub):
         return False
@@ -180,7 +181,10 @@ def settle_tui_sibling(board: Optional[str], sub: dict, upto: int) -> bool:
                 data = json.loads(payload) if payload else {}
             except ValueError:
                 data = {}
-            if kind in _KANBAN_EVENT_FORMATTERS and not covered(SimpleNamespace(kind=kind, payload=data)):
+            ev = SimpleNamespace(kind=kind, payload=data)
+            if provisional_failure(ev):
+                continue  # the tui row shows nothing for it; its failure_finalized carries the notice
+            if kind in _KANBAN_EVENT_FORMATTERS and not covered(ev):
                 return False  # the tui row still owes a notice the wake did not carry
         if held is None:
             cur = conn.execute(f"UPDATE kanban_notify_subs SET last_event_id = ? WHERE {key} "
diff --git a/tests/gateway/test_kanban_notify_wake_one_turn.py b/tests/gateway/test_kanban_notify_wake_one_turn.py
index 425aebfbca..a963b90295 100644
--- a/tests/gateway/test_kanban_notify_wake_one_turn.py
+++ b/tests/gateway/test_kanban_notify_wake_one_turn.py
@@ -314,3 +314,35 @@ def test_unloaded_sweeper_delivers_a_covered_event_the_wake_never_delivered(boar
     ku.sweep_once(set(), now=time.time() + 3600, session_db=opener)  # an hour on, past DEFER_MAX_S
     rows = [m for m in db.get_messages(CHAT) if m.get("display_kind") == "kanban_notice"]
     assert len(rows) == 1 and NOTICE["completed"].format(tid=tid) in (rows[0].get("content") or "")
+
+
+def test_archived_card_after_a_local_failure_wake_leaves_no_second_notice_turn(board):
+    """Review of PR #1465 at 196018f8a7: a local failure appends a provisional canonical ``crashed`` event in the same
+    transaction as ``failure_finalized``. The tui row shows nothing for the provisional event, so it must not stop the
+    wake from settling the tui row; otherwise archiving the card after the wake delivers failure_finalized again."""
+    from hermes_cli.kanban_db_archive import archive_task
+
+    runner, adapter = board
+    tid = _card()
+    conn = kbc.connect()
+    try:
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, "crashed", {"error": "worker exited 1", "failure_notice": "canonical"})
+            kb._append_event(conn, tid, "failure_finalized", {"error": "worker exited 1", "failures": 1,
+                                                             "trigger_outcome": "crashed", "tripped": False,
+                                                             "run_uid": "local:1", "final_status": "ready"})
+    finally:
+        conn.close()
+    _wake_leg(runner)
+    assert len(adapter.turns) == 1
+    last, subs = _cursors(tid)
+    assert subs["tui"] == (last, None)  # the wake settled the tui row past the provisional event
+    conn = kbc.connect()
+    try:
+        archive_task(conn, tid)
+        with kb.write_txn(conn):
+            conn.execute("DELETE FROM kanban_notify_subs WHERE task_id = ? AND platform = 'local'", (tid,))
+    finally:
+        conn.close()
+    assert _notice_leg() == []
+    assert len(adapter.turns) == 1
-- 
