Date: Thu, 29 Oct 2026 22:51:12 +0000
Subject: [PATCH] fix(tools): fork tool descriptions open with a whole
 <=80-char first sentence for upstream's catalog [daveey]

---
diff --git a/tests/fixtures/prompt_surface/tools/session_move.json b/tests/fixtures/prompt_surface/tools/session_move.json
index d46935e3eaf9bf5c5f4567f45078995fdab65089..6f418856282b7fc0d3eb3edd98adcbe89879d7ef 100644
--- a/tests/fixtures/prompt_surface/tools/session_move.json
+++ b/tests/fixtures/prompt_surface/tools/session_move.json
@@ -1,5 +1,5 @@
 {
-  "description": "Move THIS chat to another gateway (machine) after the current turn ends, e.g. when the work needs files, devices or tools that only exist there. The chat's whole history is copied, the other gateway becomes its owner and the copy here is archived; the user reopens the chat on the target. Only targets listed in sessions.move.hosts are allowed. Say what will happen and why before calling it; the move starts once this turn is over.",
+  "description": "Move THIS chat to another gateway (machine) after the current turn ends. Use it when the work needs files, devices or tools that only exist there. The chat's whole history is copied, the other gateway becomes its owner and the copy here is archived; the user reopens the chat on the target. Only targets listed in sessions.move.hosts are allowed. Say what will happen and why before calling it; the move starts once this turn is over.",
   "name": "session_move",
   "parameters": {
     "properties": {
diff --git a/tools/session_move_tool.py b/tools/session_move_tool.py
index e16229ac4a8a6c47e414559fcb754730bf32a6b6..ae4d41fb57dd43eab4f2c0e7dc72225710c500c8 100644
--- a/tools/session_move_tool.py
+++ b/tools/session_move_tool.py
@@ -15,8 +15,8 @@ from tools.registry import no_cache_check_fn, registry, tool_error, tool_result
 SESSION_MOVE_SCHEMA = {
     "name": "session_move",
     "description": (
-        "Move THIS chat to another gateway (machine) after the current turn ends, e.g. when the work needs files, "
-        "devices or tools that only exist there. The chat's whole history is copied, the other gateway becomes "
+        "Move THIS chat to another gateway (machine) after the current turn ends. Use it when the work needs "
+        "files, devices or tools that only exist there. The chat's whole history is copied, the other gateway becomes "
         "its owner and the copy here is archived; the user reopens the chat on the target. Only targets listed in "
         "sessions.move.hosts are allowed. Say what will happen and why before calling it; the move starts once "
         "this turn is over."),
