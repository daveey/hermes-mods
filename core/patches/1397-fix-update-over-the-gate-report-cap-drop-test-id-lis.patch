From 2947ddb1f55001d487abfc32a06d4e9830dc5393 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 03:16:52 +0000
Subject: [PATCH] fix(update): over the gate-report cap, drop test id listings
 before evidence lines [daveey]
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Review of f6f69bd8adf: with 20+ failing ids per listing the 40-line cap cut the
attribution and nightly owner lines. Listings ('      - ' / '      … ') go first.
---
 hermes_cli/update_cmd_git.py                       |  8 ++++++--
 .../hermes_cli/test_update_upstream_gate_report.py | 14 ++++++++++++++
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/update_cmd_git.py b/hermes_cli/update_cmd_git.py
index 40fc7e02557..79a411ef30b 100644
--- a/hermes_cli/update_cmd_git.py
+++ b/hermes_cli/update_cmd_git.py
@@ -370,8 +370,12 @@ def _gate_report(output: str) -> list[str]:
     start = len(lines) - 4
     if verdicts and verdicts[-1] < start:
         start = verdicts[-1]
-    shown = lines[max(start, 0):][:_GATE_REPORT_LINES]
-    hidden = len(lines) - max(start, 0) - len(shown)
+    tail = lines[max(start, 0):]
+    if len(tail) > _GATE_REPORT_LINES:  # drop the per-test id listings first: the evidence/owner lines matter more
+        kept = [line for line in tail if not line.startswith(("      - ", "      … "))]
+        tail = kept + [f"… {len(tail) - len(kept)} test id line(s) omitted"] if len(kept) < len(tail) else tail
+    shown = tail[:_GATE_REPORT_LINES]
+    hidden = len(tail) - len(shown)
     return shown + ([f"… {hidden} more line(s)"] if hidden > 0 else [])
 
 
diff --git a/tests/hermes_cli/test_update_upstream_gate_report.py b/tests/hermes_cli/test_update_upstream_gate_report.py
index 97f33dd8881..6c7bf8a7d1a 100644
--- a/tests/hermes_cli/test_update_upstream_gate_report.py
+++ b/tests/hermes_cli/test_update_upstream_gate_report.py
@@ -41,3 +41,17 @@ def test_report_is_capped():
     shown = update_cmd_git._gate_report("\n".join(lines))
     assert shown[0] == "REFUSED: red" and len(shown) == update_cmd_git._GATE_REPORT_LINES + 1
     assert shown[-1] == f"… {101 - update_cmd_git._GATE_REPORT_LINES} more line(s)"
+
+
+def test_over_the_cap_test_id_listings_go_before_evidence_lines():
+    """Two 20-id listings (the diagnostics' per-job cap) still leave attribution and the owner visible."""
+    listing = [f"      - tests/e2e/test_{n}.py::test_x" for n in range(20)] + ["      … and 5 more"]
+    lines = ["REFUSED: the full suite failed on aaaaaaaaaa: https://ci.example/run/20",
+             "  required job failure: Full suite / e2e https://ci.example/job/21 — 25 failing test(s)", *listing,
+             "  main baseline: bbbbbbbbbb (the sync's first parent, on main)",
+             "  e2e: main-baseline failure: 25 failing test(s) also fail on main bbbbbbbbbb", *listing,
+             "  nightly-e2e owner for this exact failing set: t_owner (running)"]
+    shown = update_cmd_git._gate_report("\n".join(lines))
+    assert shown[0].startswith("REFUSED:") and "  nightly-e2e owner for this exact failing set: t_owner (running)" in shown
+    assert "  e2e: main-baseline failure: 25 failing test(s) also fail on main bbbbbbbbbb" in shown
+    assert shown[-1] == "… 42 test id line(s) omitted"
-- 
