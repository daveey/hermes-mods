+                clock[0] += 31
+                yield
+        monkeypatch.setattr(recovery, "write_txn", delayed)
+    else:
+        read = hub.row_evidence
+        def slow(*args):
+            e = read(*args)
+            clock[0] += 11
+            return e
+        monkeypatch.setattr(hub, "row_evidence", slow)
+    r = recovery.apply(live, hub, BOARD, uid, p["token"], "retain link")
