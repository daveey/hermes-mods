From 0833958728f50bff9a63e5e274a3db933bcbb268 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 4 Nov 2026 11:12:06 +0000
Subject: [PATCH] test(redact): quote interpreter path in terminal outbox probe

---
 tests/agent/test_redact_outbox_secrets.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tests/agent/test_redact_outbox_secrets.py b/tests/agent/test_redact_outbox_secrets.py
index f556e0a9655..8412653ebba 100644
--- a/tests/agent/test_redact_outbox_secrets.py
+++ b/tests/agent/test_redact_outbox_secrets.py
@@ -14,6 +14,7 @@ Every secret here is synthetic. Nothing reads a real worker outbox.
 
 import json
 import secrets
+import shlex
 import subprocess
 import sys
 from pathlib import Path
@@ -199,7 +200,7 @@ class TestToolEntryPaths:
         pending = _write_outbox(tmp_path)
         script = tmp_path / f"probe_{shape}.py"
         script.write_text(_scripts(pending)[shape])
-        result = terminal_tool(f"{sys.executable} {script}", task_id=f"outbox-redact-{shape}")
+        result = terminal_tool(f"{shlex.quote(sys.executable)} {shlex.quote(str(script))}", task_id=f"outbox-redact-{shape}")
         assert SECRET not in result
         assert ("'secret': '***'" in result) if shape == "repr" else ("TimeoutExpired" in result)
 
