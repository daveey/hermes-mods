@@ -403,3 +403,56 @@ class TestSidebarShowSubagents:
         assert _slice_ids(payload, "recents") == {"default-parent", "worker-parent", "worker-sub"}
         # The messaging slice keeps its shape: a subagent run is not a platform thread.
