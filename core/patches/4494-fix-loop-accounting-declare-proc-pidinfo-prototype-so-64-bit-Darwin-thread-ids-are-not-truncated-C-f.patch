From 1817c992f7a381ff6d4a3180065e23b78366022a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 17:41:39 +0000
Subject: [PATCH] fix(loop-accounting): declare proc_pidinfo prototype so
 64-bit Darwin thread ids are not truncated; C-fixture test

---
 hermes_cli/loop_accounting.py                 |  7 +++-
 .../test_loop_accounting_residual.py          | 40 +++++++++++++++++++
 2 files changed, 45 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/loop_accounting.py b/hermes_cli/loop_accounting.py
index 52bcb893119ca15fa7874dfe362ee6b2ed5144c6..b672cf187a3fad532d00886eadd4ea87da917b28 100644
--- a/hermes_cli/loop_accounting.py
+++ b/hermes_cli/loop_accounting.py
@@ -425,17 +425,20 @@ def _darwin_thread_cpu() -> list[tuple[int, str, float]]:
                         ("sleep_time", ctypes.c_int32), ("curpri", ctypes.c_int32), ("priority", ctypes.c_int32),
                         ("maxpriority", ctypes.c_int32), ("name", ctypes.c_char * 64)]
 
+        # Explicit prototype: without it ctypes passes Python ints as 32-bit C int and truncates 64-bit thread ids.
+        lib.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]
+        lib.proc_pidinfo.restype = ctypes.c_int
         pid = os.getpid()
         ids = (ctypes.c_uint64 * 1024)()
         # PROC_PIDLISTTHREADIDS (28) returns thread ids (== threading.native_id), which is what
         # PROC_PIDTHREADID64INFO (15) looks up; PROC_PIDLISTTHREADS (6) would return pthread handles.
-        got = lib.proc_pidinfo(pid, 28, 0, ids, ctypes.sizeof(ids))
+        got = lib.proc_pidinfo(pid, 28, 0, ctypes.addressof(ids), ctypes.sizeof(ids))
         if got <= 0:
             return []
         out = []
         for i in range(got // 8):
             info = _ThreadInfo()
-            if lib.proc_pidinfo(pid, 15, ids[i], ctypes.byref(info), ctypes.sizeof(info)) <= 0:  # THREADID64INFO
+            if lib.proc_pidinfo(pid, 15, ids[i], ctypes.addressof(info), ctypes.sizeof(info)) <= 0:  # THREADID64INFO
                 continue
             out.append((int(ids[i]), info.name.decode("utf-8", "replace"), (info.user + info.system) / 1e9))  # pth_*_time are already ns
         total = sum(c for _, _, c in out)
diff --git a/tests/hermes_cli/test_loop_accounting_residual.py b/tests/hermes_cli/test_loop_accounting_residual.py
index c18263d840afc36b6511edfc70bab9d583587963..fff6597d12503c9812b44cf785a95a1867087940 100644
--- a/tests/hermes_cli/test_loop_accounting_residual.py
+++ b/tests/hermes_cli/test_loop_accounting_residual.py
@@ -326,3 +326,43 @@ def test_old_snapshot_keys_unchanged():
         assert key in snap
     for key in ("cpu_s", "accounted_cpu_s", "unaccounted_live_cpu_s", "exited_threads_cpu_s"):
         assert key in snap["process"]
+
+
+_C_FIXTURE = r"""
+#include <stdint.h>
+#include <string.h>
+int proc_pidinfo(int pid, int flavor, uint64_t arg, void *buf, int size) {
+    static const uint64_t ids[2] = {0x100000005ULL, 0x200000007ULL};
+    if (flavor == 28) { memcpy(buf, ids, sizeof ids); return (int)sizeof ids; }
+    if (flavor == 15) {
+        if (arg != ids[0] && arg != ids[1]) return 0;   /* a truncated id is unknown to the kernel */
+        memset(buf, 0, 112);
+        uint64_t t[2] = {100000000ULL, 100000000ULL};
+        memcpy(buf, t, sizeof t);
+        strcpy((char *)buf + 48, arg == ids[0] ? "fixtureone" : "fixturetwo");
+        return 112;
+    }
+    return 0;
+}
+"""
+
+
+def test_darwin_proc_pidinfo_passes_64bit_thread_ids(monkeypatch, tmp_path):
+    """C fixture standing in for libproc: ids above 2**32 must reach proc_pidinfo untruncated."""
+    import ctypes
+    import shutil
+    import subprocess
+    cc = shutil.which("cc") or shutil.which("gcc") or shutil.which("clang")
+    if not cc:
+        pytest.skip("no C compiler")
+    src = tmp_path / "fx.c"
+    src.write_text(_C_FIXTURE)
+    lib_path = tmp_path / "libfx.so"
+    subprocess.run([cc, "-shared", "-fPIC", "-o", str(lib_path), str(src)], check=True)
+    real = ctypes.CDLL
+    monkeypatch.setattr(ctypes, "CDLL", lambda *a, **k: real(str(lib_path)))
+    monkeypatch.setattr(la.os, "times", lambda: types.SimpleNamespace(user=10.0, system=10.0))
+    got = la._darwin_thread_cpu()
+    assert sorted(g[0] for g in got) == [0x100000005, 0x200000007]
+    assert sorted(g[1] for g in got) == ["fixtureone", "fixturetwo"]
+    assert all(abs(g[2] - 0.2) < 1e-9 for g in got)
-- 
