From 01103b7ebf4c11faf47d60d61a43803e08f36069 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 17:27:23 +0000
Subject: [PATCH] [daveey] kanban: contain unblock_verdict failures and index
 the shared-blocker assertion scan

Follow-up to PR #2946 (review t_01a1d87b2d982b68, nits 1-2).

1. unblock_verdict() runs after kanban_unblock / `hermes kanban unblock`
   already committed, with no containment: an evaluator exception turned
   a committed tool unblock into a tool error, and inside _bulk_apply's
   ok_msg it aborted the remaining ids of a bulk unblock. It now degrades
   to "shared-blocker verdict unavailable: <ExcType>" (logged with the
   traceback), so every caller (tool owner-wake/missing-parent/plain
   paths, bulk CLI) keeps its result.

2. _unblocked_since_assertion lost its `id >= unblocked` bound in #2946
   and walked every blocked/scheduled event on the board per held card
   per tick. Since #3010, _event_order always lies inside the row's own
   created_at second, so `created_at >= unblock_second` is an exact
   window (no skew margin): an earlier-second assertion can never order
   after the unblock, and same-second ties still go to the ms/id tie
   break. A window alone does not help (the kind index still visits
   ~19k rows), so a partial index idx_events_blocker_assert
   ON task_events(created_at) WHERE <the scan's kind/payload terms>
   is created by the additive migration and the drift rebuild (same
   pattern as idx_runs_blocker_assert), and the board-wide read names it
   (INDEXED BY) when present; an unmigrated board keeps the kind-index
   plan. own_only reads keep idx_events_task (task_id, created_at).

Proof
- RED (base e3825409, new tests only): the tool and bulk-CLI
  containment tests fail; GREEN after.
- Timing, read-only copy of worker-6's sync-shadow default.db (886,488
  events, 1,017 assertion rows), before = unbounded #3010 code, after =
  this change + the migration's index:
    184 real (card, blocker) pairs, board-wide: median 21.8 -> 0.05 ms,
      p95 75.3 -> 20.7 ms
    1,500 adversarial cross pairs, board-wide: median 67.7 -> 15.3 ms,
      p95 122 -> 21.5 ms
    own_only unchanged (~0.1 ms); unmigrated board: same as before.
  Verdicts identical old vs new on all 3,368 (pair, own_only) inputs.
  Index build on that board: ~1 s once.
- Mutants (each killed): window strict >, window dropped, window +1 s,
  own_only naming the board-wide index, index-presence check inverted,
  containment dropped, migration not creating the index, rebuild spec
  dropping it.
- tests: 35 files importing the shared-blocker modules / unblock tools
  + kanban_db / schema_owner / db_init suites pass.
---
 hermes_cli/kanban_db_connect.py               | 10 ++
 hermes_cli/kanban_shared_blockers.py          | 30 +++++-
 .../hermes_cli/test_kanban_shared_blockers.py | 91 +++++++++++++++++++
 3 files changed, 128 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_db_connect.py b/hermes_cli/kanban_db_connect.py
index 32502b986c..7e3226698f 100644
--- a/hermes_cli/kanban_db_connect.py
+++ b/hermes_cli/kanban_db_connect.py
@@ -1227,6 +1227,7 @@ def _migrate_add_optional_columns(conn: sqlite3.Connection) -> None:
     # Same ordering rule as the ``tasks`` indexes above: index after column.
     conn.execute("CREATE INDEX IF NOT EXISTS idx_events_run ON task_events(run_id, id)")
     conn.execute("CREATE INDEX IF NOT EXISTS idx_events_kind_task_id ON task_events(kind, task_id, id)")
+    conn.execute(_EVENT_BLOCKER_ASSERT_INDEX.replace("CREATE INDEX ", "CREATE INDEX IF NOT EXISTS ", 1))
 
     if _table_exists(conn, "kanban_notify_subs"):
         notify_cols = _column_names(conn, "kanban_notify_subs")
@@ -1356,6 +1357,14 @@ _RUN_PARTIAL_INDEXES = (
     "CREATE INDEX idx_runs_rate_limited ON task_runs(ended_at) WHERE outcome = 'rate_limited'",
     "CREATE INDEX idx_runs_blocker_assert ON task_runs(ended_at) WHERE metadata LIKE '%\"blocker_id\"%'",
 )
+# [daveey] The same for task_events: ``kanban_shared_blockers._unblocked_since_assertion`` asks, per ready card
+# behind a blocker per tick, for the board's assertions at or after the card's unblock second. Without this
+# index that read walked every blocked/scheduled event (~19k of ~886k on the hub board, ~18-60 ms per call);
+# ~1k of them carry a blocker id. Its WHERE is repeated verbatim by that query, which names it (INDEXED BY).
+_EVENT_BLOCKER_ASSERT_INDEX = (
+    "CREATE INDEX idx_events_blocker_assert ON task_events(created_at) WHERE kind IN "
+    "('blocked', 'scheduled', 'continued', 'block_loop_detected') AND payload LIKE '%\"blocker_id\"%'"
+)
 
 
 def _ensure_run_partial_indexes(conn: sqlite3.Connection) -> None:
@@ -1377,6 +1386,7 @@ _REBUILD_SPECS = {
             "CREATE INDEX idx_events_task ON task_events(task_id, created_at)",
             "CREATE INDEX idx_events_run ON task_events(run_id, id)",
             "CREATE INDEX idx_events_kind_task_id ON task_events(kind, task_id, id)",
+            _EVENT_BLOCKER_ASSERT_INDEX,
         ),
     ),
     "task_comments": (
diff --git a/hermes_cli/kanban_shared_blockers.py b/hermes_cli/kanban_shared_blockers.py
index 43ef34f3ed..4be1adc4c6 100644
--- a/hermes_cli/kanban_shared_blockers.py
+++ b/hermes_cli/kanban_shared_blockers.py
@@ -512,6 +512,14 @@ def _unblocked_since_assertion(conn: sqlite3.Connection, task_id: str, blocker_i
 
     Replication assigns new local ids to old events. UUIDv7 milliseconds (or legacy
     created_at seconds) preserve occurrence order; tied bulk events retain id order.
+
+    :func:`_event_order` always falls inside the row's own ``created_at`` second, so an
+    assertion recorded in an earlier second than the unblock can never order after it:
+    the ``created_at`` window below is exact, not a heuristic. Board-wide, it is an index
+    range over ``idx_events_blocker_assert`` (named, since without statistics the planner
+    prefers the far larger kind index); unbounded, this walked every blocked/scheduled event
+    (PR #2946 review: ~37 ms per call on an 863k-event board). A board the running core has
+    not migrated lacks the index and keeps the kind-index plan.
     """
     from hermes_cli import kanban_db as kb
 
@@ -521,9 +529,13 @@ def _unblocked_since_assertion(conn: sqlite3.Connection, task_id: str, blocker_i
     if unblocked is None:
         return False
     own = " AND task_id=?" if own_only else ""
+    named = "" if own_only or conn.execute(
+        "SELECT 1 FROM sqlite_master WHERE type='index' AND name='idx_events_blocker_assert'"
+    ).fetchone() is None else " INDEXED BY idx_events_blocker_assert"
     for row in conn.execute(
-        "SELECT * FROM task_events WHERE kind IN ('blocked', 'scheduled', 'continued', 'block_loop_detected') "
-        "AND payload LIKE '%\"blocker_id\"%'" + own, (task_id,) if own_only else (),
+        "SELECT * FROM task_events" + named + " WHERE kind IN ('blocked', 'scheduled', 'continued', "
+        "'block_loop_detected') AND payload LIKE '%\"blocker_id\"%' AND created_at >= ?" + own,
+        (unblocked[0] // 1000, *((task_id,) if own_only else ())),
     ):
         if (_event_order(row) >= unblocked and
                 normalize_blocker_id(kb._json_dict(row["payload"]).get("blocker_id")) == blocker_id):
@@ -574,7 +586,19 @@ def shared_blocker_guard(
 
 
 def unblock_verdict(conn: sqlite3.Connection, task_id: str) -> str:
-    """Read-only shared-blocker verdict, not a promise about other admission gates."""
+    """Read-only shared-blocker verdict, not a promise about other admission gates.
+
+    Callers report it after the unblock has already committed, so a failure here must
+    never turn that committed unblock into an error (or abort a bulk unblock's remaining
+    ids): it degrades to an "unavailable" verdict instead. [daveey]"""
+    try:
+        return _unblock_verdict(conn, task_id)
+    except Exception as exc:  # health: allow BLE001 -- the unblock already committed; the verdict is advisory
+        logger.warning("shared-blocker verdict failed for %s", task_id, exc_info=True)
+        return f"shared-blocker verdict unavailable: {type(exc).__name__}"
+
+
+def _unblock_verdict(conn: sqlite3.Connection, task_id: str) -> str:
     hold = _shared_blocker_hold(conn, task_id)
     if hold is None:
         return "released: claimable on the next tick"
diff --git a/tests/hermes_cli/test_kanban_shared_blockers.py b/tests/hermes_cli/test_kanban_shared_blockers.py
index 251e3bf137..671a402074 100644
--- a/tests/hermes_cli/test_kanban_shared_blockers.py
+++ b/tests/hermes_cli/test_kanban_shared_blockers.py
@@ -155,6 +155,97 @@ def test_unblock_reports_shared_guard(kanban_home, monkeypatch, capsys, entry, r
     assert expected in result
 
 
+DEGRADED = "shared-blocker verdict unavailable: RuntimeError"
+
+
+def _broken_evaluator(monkeypatch):
+    def boom(*_a, **_kw):
+        raise RuntimeError("evaluator broke")
+
+    monkeypatch.setattr(ksb, "_shared_blocker_hold", boom)
+
+
+def test_verdict_failure_keeps_committed_tool_unblock(kanban_home, monkeypatch):
+    """The verdict runs after the unblock committed: its failure must not report the unblock as failed."""
+    from tools.kanban_tools_self_heal import handle_unblock
+
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    with kbc.connect_closing() as conn:
+        target = _blocked_behind(conn, "target")
+    _broken_evaluator(monkeypatch)
+    result = json.loads(handle_unblock({"task_id": target}))
+    assert result.get("ok") is True, result
+    assert result["shared_blocker_verdict"] == DEGRADED
+    with kbc.connect_closing() as conn:
+        assert kb.get_task(conn, target).status == "ready"
+
+
+def test_verdict_failure_keeps_bulk_cli_unblock_going(kanban_home, monkeypatch, capsys):
+    """One failing verdict must not abort the remaining ids of ``hermes kanban unblock a b c``."""
+    from argparse import Namespace
+    from hermes_cli import kanban
+
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    with kbc.connect_closing() as conn:
+        ids = [_blocked_behind(conn, f"card {n}") for n in range(3)]
+    _broken_evaluator(monkeypatch)
+    assert kanban._cmd_unblock(Namespace(task_ids=ids, reason=None)) == 0
+    out = capsys.readouterr().out
+    with kbc.connect_closing() as conn:
+        assert [kb.get_task(conn, tid).status for tid in ids] == ["ready"] * 3
+    for tid in ids:
+        assert f"Unblocked {tid}; {DEGRADED}" in out
+
+
+@pytest.mark.parametrize("own_only, indexed, index", [
+    (False, True, "idx_events_blocker_assert (created_at>?)"),
+    (False, False, "idx_events_kind_task_id (kind=?)"),   # a board this core has not migrated
+    (True, True, "(task_id=?"),
+])
+def test_assertion_scan_reads_only_the_unblock_window(kanban_home, own_only, indexed, index):
+    """The guard runs per held card per tick: its assertion read must be an index range from the
+    unblock's second, not a walk of every blocked/scheduled event on the board (PR #2946 review)."""
+    with kbc.connect_closing() as conn:
+        target = _blocked_behind(conn, "target")
+        assert kb.unblock_task(conn, target)
+        if not indexed:
+            with kb.write_txn(conn):
+                conn.execute("DROP INDEX idx_events_blocker_assert")
+        with kb.write_txn(conn):   # a newer assertion in the window still decides
+            kb._append_event(conn, target, "scheduled", {"blocker_id": BID})
+        statements: list[str] = []
+        conn.set_trace_callback(statements.append)
+        try:
+            assert ksb._unblocked_since_assertion(conn, target, BID, own_only=own_only) is False
+        finally:
+            conn.set_trace_callback(None)
+        scans = [s for s in statements if "blocker_id" in s]
+        assert len(scans) == 1, statements
+        plan = " ".join(r[-1] for r in conn.execute("EXPLAIN QUERY PLAN " + scans[0]))
+        assert index in plan and "SCAN" not in plan, plan
+        assert own_only is False or "idx_events_blocker_assert" not in plan, plan
+
+
+def test_drifted_task_events_rebuild_keeps_the_assertion_index(kanban_home):
+    """DROP TABLE in the drift rebuild takes every index down; the rebuild must restore this one too."""
+    import sqlite3
+    from hermes_cli import kanban_db_connect as kdc
+
+    db_path = kanban_home / "legacy-events.db"
+    seed = sqlite3.connect(db_path)
+    seed.execute("CREATE TABLE task_events (id TEXT PRIMARY KEY, task_id TEXT NOT NULL, kind TEXT NOT NULL,"
+                 " payload TEXT, created_at INTEGER NOT NULL)")
+    seed.execute("INSERT INTO task_events VALUES ('e1', 't1', 'scheduled', '{\"blocker_id\": \"x\"}', 5)")
+    seed.commit()
+    seed.close()
+    conn = kdc.connect(db_path)
+    try:
+        assert not kdc._table_has_drifted(conn, "task_events")
+        assert conn.execute("SELECT 1 FROM sqlite_master WHERE type='index' "
+                            "AND name='idx_events_blocker_assert'").fetchone() is not None
+    finally:
+        conn.close()
+
 
 @pytest.fixture
 def scoped_routing(monkeypatch):
