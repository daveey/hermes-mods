From 7604ad60cbb2a81a5857242de17d25c2b1e6ae5f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 23:55:50 +0000
Subject: [PATCH] [daveey] Accept BOM-prefixed evidence carriage receipts

---
 hermes_cli/kanban_carried_evidence.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_carried_evidence.py b/hermes_cli/kanban_carried_evidence.py
index 3997631ce7..bffb60fd3a 100644
--- a/hermes_cli/kanban_carried_evidence.py
+++ b/hermes_cli/kanban_carried_evidence.py
@@ -43,7 +43,7 @@ def without_carried_inputs(text: str, cfg: dict) -> str:
         path = get_hermes_home() / "kanban" / "carried-evidence.json"
         if path.is_symlink() or path.stat().st_size > MAX_BYTES:
             return text
-        receipt = json.loads(path.read_text(encoding="utf-8"))
+        receipt = json.loads(path.read_text(encoding="utf-8-sig"))
         if not isinstance(receipt, dict) or receipt.get("version") != 1:
             return text
         at = receipt.get("verified_at")
