+        if not _reap_identity_still_matches(pid, starts[pid]):
+            failed.append(pid)
+            continue
         try:
             os.kill(pid, signal_term)
         except ProcessLookupError:
@@ -1015,6 +1062,9 @@ def _reap_orphaned_desktop_local_serves(
             continue
         try:
