From 15f82634a9e7a2eefaeb91913f41d64e0d358f6d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 14:01:59 +0000
Subject: [PATCH] fix(launch): route launch_probe to the upgrade suite; gateway
 PM stub accepts activate options

PR CI (bb1d567) shards 5/8 and 7/8: launch_probe.py is imported by venv_sync on the
update path but was not routed to e2e_upgrade; the gateway survival test's pm.activate
stub took no arguments, so the opt-out's activate(allow_incomplete=True) raised TypeError
before the stub recorded the call.
---
 scripts/ci/classify_changes.py      | 1 +
 tests/gateway/test_pm_activation.py | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/scripts/ci/classify_changes.py b/scripts/ci/classify_changes.py
index 91377ee9fd2..857f65eee80 100644
--- a/scripts/ci/classify_changes.py
+++ b/scripts/ci/classify_changes.py
@@ -270,6 +270,7 @@ _UPDATE_PIPELINE = (
     # Prefix: _early_recovery.py and its _early_recovery_* siblings (ZIP swap journal).
     "hermes_cli/_early_recovery",  # interrupted pull / shim restore at launch
     "hermes_cli/venv_sync.py",  # completion obligation + launch-time tail
+    "hermes_cli/launch_probe.py",  # venv_sync's bounded launch-time currency probe
     "hermes_cli/source_",  # source_completion/_build/_releases/_check/_stamp
     "hermes_cli/_launchers.py",
     "hermes_cli/release_channels.py",
diff --git a/tests/gateway/test_pm_activation.py b/tests/gateway/test_pm_activation.py
index 1383923d294..5132586d223 100644
--- a/tests/gateway/test_pm_activation.py
+++ b/tests/gateway/test_pm_activation.py
@@ -13,7 +13,7 @@ def test_gateway_main_survives_pm_failure(monkeypatch, tmp_path):
     import gateway.run as gateway
 
     failed = []
-    def broken():
+    def broken(**_options):
         failed.append("activate")
         raise RuntimeError("PM unavailable")
 
-- 
2.55.0

