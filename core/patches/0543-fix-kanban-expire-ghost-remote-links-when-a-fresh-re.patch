From 672a3a3b9ed644e8ba8106054a6c1743e8cd5544 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 17:11:21 -0700
Subject: [PATCH] fix(kanban): expire ghost remote links when a fresh replica
 carries the owner row without the link

---
 hermes_cli/kanban_session_activity.py         | 12 ++++++++++--
 .../test_kanban_remote_inventory_cache.py     | 19 +++++++++++++++++++
 2 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index b69a11995f..0b2804ca9b 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -489,7 +489,8 @@ def _fold_legacy_aliases(tasks: dict[tuple, dict[str, Any]], raw: dict[tuple, di
 
 
 def _read_remote_links(path: Path, now: float | None = None, *,
-                       qualified_out: set | None = None) -> list[dict[str, Any]]:
+                       qualified_out: set | None = None,
+                       owners_out: set | None = None) -> list[dict[str, Any]]:
     """Replica cards linked to a session on this gateway, one row per (session, card).
 
     Open and unproven cards come back ``unfinished``; cards their owner attests closed
@@ -547,6 +548,10 @@ def _read_remote_links(path: Path, now: float | None = None, *,
                 # terminal evidence or the qualified ledger projection supersedes it.
                 t = {**t, 'reported_status': t.get('status'), 'status': 'unknown', 'unfinished': True}
             tasks[key] = t
+    if owners_out is not None and not stale:
+        # A fresh replica that still carries the owner row is authoritative about its links: a remembered
+        # (session, card) pair absent from it is a dropped link, not an unreadable replica.
+        owners_out.update((gw, board, tid) for gw, _, board, tid in tasks)
     blank_before = {key for key in tasks if key[1] is None}
     _fold_legacy_aliases(tasks, raw)
     # Only a proven-identity alias is the same card as its qualified twin (folded above, links carried
@@ -841,7 +846,8 @@ def _legacy_remote_links() -> list[dict[str, Any]]:
         if path is None:
             raise FileNotFoundError("no hub.db")
         qualified: set[tuple[str, str, str]] = set()
-        cards = _read_remote_links(path, qualified_out=qualified)
+        owners: set[tuple[str, str, str]] = set()
+        cards = _read_remote_links(path, qualified_out=qualified, owners_out=owners)
     except Exception as exc:  # a broken replica must never break the sidebar
         if previous is None:
             if path is not None:
@@ -865,6 +871,8 @@ def _legacy_remote_links() -> list[dict[str, Any]]:
                  # Successful reads migrate graph-inferred cache entries only.
                  # Receipt-backed obligations remain in the separate ledger.
                  and c.get("via") != "descendant"
+                 # Fresh replica + owner row present but this session's link gone: expire the ghost.
+                 and (c.get("gateway"), c.get("board"), c.get("id")) not in owners
                  and not (c.get("ownership_state") == "unknown"
                           and (c["session"], c.get("gateway"), c.get("board"), c.get("id")) in qualified_now))
     if _snapshot_saved != (scope, cards):
diff --git a/tests/hermes_cli/test_kanban_remote_inventory_cache.py b/tests/hermes_cli/test_kanban_remote_inventory_cache.py
index 4db7dbac28..c6d93b636d 100644
--- a/tests/hermes_cli/test_kanban_remote_inventory_cache.py
+++ b/tests/hermes_cli/test_kanban_remote_inventory_cache.py
@@ -166,3 +166,22 @@ def test_unchanged_inventory_is_written_once(replica):
     activity._legacy_remote_links()
     activity._legacy_remote_links()
     assert len(writes) == 1
+
+
+def test_dropped_link_on_fresh_replica_expires_ghost(replica, monkeypatch):
+    _, _, card = replica
+    card.update(gateway='owner', board='work', id='t_one')
+    activity._legacy_remote_links()
+    def read(path, owners_out=None, **kw):
+        owners_out.add(('owner', 'work', 't_one'))
+        return []
+    monkeypatch.setattr(activity, '_read_remote_links', read)
+    assert activity._legacy_remote_links() == []
+
+
+def test_missing_owner_keeps_stale_ghost(replica, monkeypatch):
+    _, _, card = replica
+    card.update(gateway='owner', board='work', id='t_one')
+    activity._legacy_remote_links()
+    monkeypatch.setattr(activity, '_read_remote_links', lambda path, **kw: [])
+    assert [c['stale'] for c in activity._legacy_remote_links()] == [True]
-- 
2.55.0

