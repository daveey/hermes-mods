From 72232abb8fb8f7450a25d933665003055f055c50 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 00:58:37 +0000
Subject: [PATCH] fix(lifecycle): preserve literal filename characters during
 tokenization [daveey]

Replace the redirection ampersand sentinel with shlex escapes. Keep the restoration hook as identity for existing callers; never replace literal U+E000 input. Both-files-present fixtures cover dangerous and harmless marker paths versus their ampersand siblings, quoted and unquoted, direct/source/pipeline execution.

Proof: 21 new regressions fail on 1fe6ea3a9350; all 23 new cases and all 1302 lifecycle tests pass with the fix. Remaining direct importer files and scripts/check pass. Existing routing tests retain descriptor and control-operator contracts.
---
 cron/lifecycle_guard_groups.py                | 18 +++++++-------
 ...ifecycle_guard_literal_ampersand_marker.py | 24 +++++++++++++++++++
 2 files changed, 32 insertions(+), 10 deletions(-)
 create mode 100644 tests/cron/test_lifecycle_guard_literal_ampersand_marker.py

diff --git a/cron/lifecycle_guard_groups.py b/cron/lifecycle_guard_groups.py
index e064d12817..7020e17435 100644
--- a/cron/lifecycle_guard_groups.py
+++ b/cron/lifecycle_guard_groups.py
@@ -31,8 +31,6 @@ PROCESS_SUBSTITUTION = "\x00<(…)"
 _SUBSTITUTION_OPENERS = frozenset({"<", ">", ">>", ">|", "1>", "1>>", "1>|", "&>", "&>>"})
 # Operators that carry a command on past the end of its line.
 _CONTINUING_OPERATORS = frozenset({"|", "|&", "&&", "||"})
-# Stands, while tokenizing, for the `&` of `>&`, `<&`, `&>` and `&>>` (a private-use character).
-_REDIRECTION_AMPERSAND = "\ue000"
 
 Context = tuple[list[str], bool, list[str]]
 # Each process substitution of a command: (its position, or None for a `>(…)`, files it writes).
@@ -133,11 +131,11 @@ def split_glued_redirections(line: str) -> str:
 
 
 def protect_redirection_ampersands(line: str) -> str:
-    """*line* with the ``&`` of each unquoted, unescaped redirection operator (``2>&1``, ``<&0``,
-    ``&>f``, ``&>>f``) swapped for a word character, so a tokenizer splitting on ``&`` keeps the
-    redirection whole instead of reading a background ``&``. ``&&``, ``|&`` and a lone ``&``
-    keep theirs. The ``|`` of ``>|f`` is escaped for shlex too: it is no pipe. Undo the ampersand
-    swap per token with ``restore_redirection_ampersands``."""
+    """Escape redirection punctuation for shlex, leaving control operators unchanged.
+
+    Shlex consumes these escapes itself. No sentinel or post-tokenization replacement
+    may alias literal filename characters to a different file.
+    """
     out: list[str] = []
     in_single = in_double = escape = False
     previous = ""  # the last character when it was unquoted and unescaped
@@ -156,7 +154,7 @@ def protect_redirection_ampersands(line: str) -> str:
             after = line[position + 1: position + 2]
             if ch == "&" and (previous in ("<", ">")
                               or (after == ">" and previous not in ("&", "|"))):
-                ch = _REDIRECTION_AMPERSAND
+                ch = r"\&"
             elif ch == "|" and previous == ">":  # `>|f` writes f; it pipes nothing
                 ch = r"\|"
         previous = ch if shell_character else ""
@@ -165,8 +163,8 @@ def protect_redirection_ampersands(line: str) -> str:
 
 
 def restore_redirection_ampersands(token: str) -> str:
-    """*token* as written (see ``protect_redirection_ampersands``)."""
-    return token.replace(_REDIRECTION_AMPERSAND, "&")
+    """Compatibility hook: shlex now removes escapes without a sentinel swap."""
+    return token
 
 
 def join_continued_lines(token_lists: Iterable[list[str]]) -> Iterator[list[str]]:
diff --git a/tests/cron/test_lifecycle_guard_literal_ampersand_marker.py b/tests/cron/test_lifecycle_guard_literal_ampersand_marker.py
new file mode 100644
index 0000000000..5563becd29
--- /dev/null
+++ b/tests/cron/test_lifecycle_guard_literal_ampersand_marker.py
@@ -0,0 +1,24 @@
+"""Literal private-use filenames must never alias an ampersand sibling."""
+
+import shlex
+
+import pytest
+
+from cron.lifecycle_guard import _shlex_tokens, scan_gateway_lifecycle
+
+
+@pytest.mark.parametrize("quote", [shlex.quote, lambda s: '"' + s + '"', str])
+@pytest.mark.parametrize("template", ["bash {path}", ". {path}", "cat {path} | bash"])
+@pytest.mark.parametrize("dangerous_marker", [True, False])
+def test_literal_marker_and_ampersand_siblings(tmp_path, quote, template, dangerous_marker):
+    marker = tmp_path / "task\ue000.sh"
+    sibling = tmp_path / "task&.sh"
+    lifecycle = " ".join(["hermes", "gateway", "re" + "start"])
+    marker.write_text(lifecycle if dangerous_marker else "echo harmless\n", encoding="utf-8")
+    sibling.write_text("echo harmless\n" if dangerous_marker else lifecycle, encoding="utf-8")
+    assert scan_gateway_lifecycle(template.format(path=quote(str(marker)))) == (dangerous_marker, None)
+
+
+@pytest.mark.parametrize("literal", ["\ue000", "a\ue000b", "\ue000\ue001", "a&b", "a\\b"])
+def test_tokenizer_preserves_literal_characters(literal):
+    assert _shlex_tokens("echo " + shlex.quote(literal) + " 2>&1") == ["echo", literal, "2>&1"]
