From 95decd74f96b28ac60dfb85642177c6696da01fe Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 05:49:46 +0000
Subject: [PATCH 1142/1157] fix(cli): name the contract-refused fields in
 create refusal copy [daveey]

The canonical session.create check refuses with data.fields (a list); refusal_text read only
data.field/data.detail, so 'hermes chat --source peer-mail' printed a bare invalid_params under
"couldn't start the model connection" and pointed the investigation at model routing. It now
reads 'invalid_params (source)'.
---
 hermes_cli/cli_chat_error_copy.py             |  9 ++-
 .../test_create_refusal_fields_copy.py        | 64 +++++++++++++++++++
 2 files changed, 70 insertions(+), 3 deletions(-)
 create mode 100644 tests/hermes_cli/test_create_refusal_fields_copy.py

diff --git a/hermes_cli/cli_chat_error_copy.py b/hermes_cli/cli_chat_error_copy.py
index cbf6b33b698..be1a8afe148 100644
--- a/hermes_cli/cli_chat_error_copy.py
+++ b/hermes_cli/cli_chat_error_copy.py
@@ -38,9 +38,10 @@ def refusal_text(error: BaseException | str) -> str:
     named one (``invalid_params (toolsets: unknown or invalid toolset name: 'mcp-codegraph')``).
 
     The gateway sends ``field``/``detail`` in the JSON-RPC error's ``data``
-    (``gateway/session_controls.py``), and ``hermes_cli.gateway_client.rpc_error`` carries the
-    bounded scalars onto ``GatewayRPCError.data``. A refusal from anywhere else has no ``data`` and
-    reads exactly as before."""
+    (``gateway/session_controls.py``); the canonical contract check sends ``fields`` (a list:
+    ``invalid_params (source)``). ``hermes_cli.gateway_client.rpc_error`` carries the bounded
+    scalars and short lists onto ``GatewayRPCError.data``. A refusal from anywhere else has no
+    ``data`` and reads exactly as before."""
     if str(error) == "launch_credentials_unavailable":
         # The chat's launch key changed: every retry repeats the refusal, so name the way out.
         from agent.turn_failure_copy import launch_credentials_copy
@@ -49,6 +50,8 @@ def refusal_text(error: BaseException | str) -> str:
     data = getattr(error, "data", None)
     data = data if isinstance(data, dict) else {}
     field, detail = str(data.get("field") or "").strip(), str(data.get("detail") or "").strip()
+    if not field and isinstance(data.get("fields"), list):
+        field = ", ".join(str(name).strip() for name in data["fields"] if str(name or "").strip())
     if not field and not detail:
         return str(error)
     return f"{error} ({field or 'unnamed field'}{': ' + detail if detail else ''})"
diff --git a/tests/hermes_cli/test_create_refusal_fields_copy.py b/tests/hermes_cli/test_create_refusal_fields_copy.py
new file mode 100644
index 00000000000..e6ca5bbe4ec
--- /dev/null
+++ b/tests/hermes_cli/test_create_refusal_fields_copy.py
@@ -0,0 +1,64 @@
+"""A refused ``session.create`` names the field, and the CLI's own labels pass the create contract.
+
+The canonical contract check refuses with ``data.fields`` (a list); the CLI copy read only
+``data.field``/``data.detail``, so ``--source peer-mail`` printed a bare ``invalid_params`` under
+"couldn't start the model connection" and sent the investigation to model routing.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli._parser import build_top_level_parser
+
+
+def test_refusal_text_renders_a_fields_list():
+    from hermes_cli.cli_chat_error_copy import agent_init_failure_message, refusal_text
+    from hermes_cli.gateway_client import GatewayRPCError, rpc_error
+
+    # The exact frame gateway/session_controls.dispatch sends for a contract refusal.
+    exc = rpc_error({"code": 4001, "message": "invalid_params",
+                     "data": {"reason": "invalid_params", "fields": ["source"]}})
+    assert refusal_text(exc) == "invalid_params (source)"
+    assert "invalid_params (source)" in agent_init_failure_message(exc)
+    two = GatewayRPCError("invalid_params", 4001, {"reason": "invalid_params", "fields": ["source", "params.bogus"]})
+    assert refusal_text(two) == "invalid_params (source, params.bogus)"
+    # A field/detail refusal still reads as before, and an empty list adds no parentheses.
+    single = GatewayRPCError("invalid_params", 4001, {"field": "toolsets", "detail": "unknown"})
+    assert refusal_text(single) == "invalid_params (toolsets: unknown)"
+    assert refusal_text(GatewayRPCError("invalid_params", 4001, {"fields": []})) == "invalid_params"
+
+
+class _FakeConnection:
+    def __init__(self):
+        self.created = []
+
+    def call(self, method, **params):
+        if method == "runtime.describe":
+            return {"session_create": {"sources": ["cli"], "parameters": []}}
+        assert method == "session.create"
+        self.created.append(params)
+        return {"stored_session_id": "s1", "info": {}}
+
+    def state(self, sid):
+        return SimpleNamespace(adopt_snapshot=lambda snapshot: None)
+
+
+@pytest.mark.parametrize("given, stored", [("tool", "tool"), ("desktop", "gui"), ("oneshot", "oneshot")])
+def test_cli_sources_create_a_session_the_contract_accepts(monkeypatch, given, stored):
+    """`hermes chat -Q --oneshot --source tool|desktop` parses, and the create it drives passes the
+    canonical ``session.create`` check the gateway dispatcher runs."""
+    from hermes_cli.gateway_session_store import GatewaySessionStore
+    from tui_gateway.contracts.registry import CANONICAL_METHODS, canonical_param_problems
+
+    parser, _subparsers, _chat = build_top_level_parser()
+    args = parser.parse_args(["chat", "-Q", "--oneshot", "-q", "hi", "--source", given])
+    # What cmd_chat does with --source before the store creates the row.
+    monkeypatch.setenv("HERMES_SESSION_SOURCE", args.source)
+    monkeypatch.setenv("HERMES_SESSION_SOURCE_EXPLICIT", "1")
+    monkeypatch.setenv("TERMINAL_ENV", "local")
+    connection = _FakeConnection()
+    assert GatewaySessionStore(connection).create({}) == "s1"
+    (params,) = connection.created
+    assert params["source"] == stored
+    assert canonical_param_problems(CANONICAL_METHODS["session.create"], params) == []
