From 3e6b3d924ea61ebe590762962aeea4fc6df2e213 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 04:05:22 +0000
Subject: [PATCH] [daveey] fix(kanban): pickup-stall repin needs
 profile:default for a card with no assignee, like the Board

The Board's requiredLabels reads `assignee || "default"`; _need built profile:None / profile:, which no worker carries, so a NULL/empty-assignee card's pool move looked ineligible. Regression test RED on base. (t_01a1d3123e9d25fd)
---
 hermes_cli/kanban_pickup_stall_repin.py            |  3 ++-
 tests/hermes_cli/test_kanban_pickup_stall_repin.py | 10 ++++++++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_pickup_stall_repin.py b/hermes_cli/kanban_pickup_stall_repin.py
index 8290da10da..2f2bcf7d73 100644
--- a/hermes_cli/kanban_pickup_stall_repin.py
+++ b/hermes_cli/kanban_pickup_stall_repin.py
@@ -142,7 +142,8 @@ def malformed_skills(target: Any) -> Optional[str]:
 
 def _need(target: Any) -> set:
     from hermes_cli.kanban_placement_coordination import requirement_label
-    return {requirement_label(r) for r in _requires(target)} | {f"profile:{target['assignee']}"}
+    # A NULL or empty assignee runs as ``default``, as in the Board's ``requiredLabels`` (``assignee || "default"``).
+    return {requirement_label(r) for r in _requires(target)} | {f"profile:{target['assignee'] or 'default'}"}
 
 
 def _pool_need(target: Any) -> set:
diff --git a/tests/hermes_cli/test_kanban_pickup_stall_repin.py b/tests/hermes_cli/test_kanban_pickup_stall_repin.py
index e3c327e4fb..870774baa5 100644
--- a/tests/hermes_cli/test_kanban_pickup_stall_repin.py
+++ b/tests/hermes_cli/test_kanban_pickup_stall_repin.py
@@ -316,6 +316,16 @@ def test_every_need_site_maps_access_names_to_their_attested_labels(name, label)
     assert kps.alarm_placement(M, machines, assignee="default", requires=(name,), now_ms=NOW)[0] == [f"machine:{X}"]
 
 
+@pytest.mark.parametrize("assignee", [None, ""])
+def test_a_card_with_no_assignee_needs_the_default_profile_like_the_board(assignee):
+    """t_01a1d3123e9d25fd: the Board's ``requiredLabels`` reads ``assignee || "default"``; ``_need`` built
+    ``profile:None`` / ``profile:``, which no worker carries, so the pool move looked ineligible."""
+    from hermes_cli import kanban_repin_notice as rn
+    row = {"requires": None, "assignee": assignee}
+    assert rp._need(row) == {"profile:default"} == set(rn.required_labels(row))
+    assert rp.pool_refusal(M, _pooled(), rp._need(row), NOW) is None
+
+
 def test_the_hub_lane_without_hub_write_is_a_valid_target(board):
     assert board.why(runs_on=["machine:hub"]) is None  # hub-write is the alarm's need, not the card's
 
-- 
