From ef80b53a69c2a886546d740ed9db55865412aa15 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 21 Oct 2026 15:21:00 -0700
Subject: [PATCH] fix(browser): CDP supervisor opens its fallback page in the
 background [daveey]

A foreground Target.createTarget hands Chrome keyboard focus on macOS, so a
supervisor attaching to a page-less browser stole focus from the user's app.
---
 .../test_browser_supervisor_background_tab.py | 34 +++++++++++++++++++
 tools/browser_supervisor.py                   |  5 ++-
 2 files changed, 38 insertions(+), 1 deletion(-)
 create mode 100644 tests/tools/test_browser_supervisor_background_tab.py

diff --git a/tests/tools/test_browser_supervisor_background_tab.py b/tests/tools/test_browser_supervisor_background_tab.py
new file mode 100644
index 0000000000..4c8c361ccd
--- /dev/null
+++ b/tests/tools/test_browser_supervisor_background_tab.py
@@ -0,0 +1,34 @@
+"""The CDP supervisor must open its fallback page in the background.
+
+A foreground Target.createTarget makes macOS hand Chrome keyboard focus, stealing
+it from the user's app whenever a supervisor attached to a browser with no page.
+"""
+import asyncio
+
+import tools.browser_supervisor as bs
+
+
+def test_initial_page_created_in_background(monkeypatch):
+    supervisor = bs.CDPSupervisor(task_id="bg-tab", cdp_url="ws://127.0.0.1:9222")
+    calls = []
+
+    async def fake_cdp(method, params=None, **_kw):
+        calls.append((method, params or {}))
+        if method == "Target.getTargets":
+            return {"result": {"targetInfos": []}}
+        if method == "Target.createTarget":
+            return {"result": {"targetId": "T1"}}
+        if method == "Target.attachToTarget":
+            return {"result": {"sessionId": "S1"}}
+        return {"result": {}}
+
+    async def _noop(*_a, **_k):
+        pass
+
+    monkeypatch.setattr(supervisor, "_cdp", fake_cdp)
+    monkeypatch.setattr(supervisor, "_enable_page_domains", _noop)
+    monkeypatch.setattr(supervisor, "_install_dialog_bridge", _noop)
+    asyncio.run(supervisor._attach_initial_page())
+
+    creates = [p for m, p in calls if m == "Target.createTarget"]
+    assert creates == [{"url": "about:blank", "background": True}]
diff --git a/tools/browser_supervisor.py b/tools/browser_supervisor.py
index 243eac9717..d19b93d2a4 100644
--- a/tools/browser_supervisor.py
+++ b/tools/browser_supervisor.py
@@ -442,7 +442,10 @@ class CDPSupervisor(DialogSupervisionMixin, FrameTrackingMixin):
         targets = (await self._cdp("Target.getTargets")).get("result", {}).get("targetInfos", [])
         page_target = next((t for t in targets if t.get("type") == "page"), None)
         if page_target is None:
-            page_target = (await self._cdp("Target.createTarget", {"url": "about:blank"}))["result"]
+            # background: a foreground createTarget hands Chrome keyboard focus on macOS.
+            page_target = (await self._cdp(
+                "Target.createTarget", {"url": "about:blank", "background": True}
+            ))["result"]
         attach = await self._cdp("Target.attachToTarget", {"targetId": page_target["targetId"], "flatten": True})
         self._page_session_id = sid = attach["result"]["sessionId"]
         await self._enable_page_domains(sid, timeout=10.0)
