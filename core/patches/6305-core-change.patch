From 693893a9ee4f1ae00cb2c3f76ad0e88b6214c7a0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 24 Nov 2026 18:06:59 +0000
Subject: [PATCH 6305] Immutable historical rejection observations and fresh audit cuts

Public mirror of source commit 693893a9ee4f1ae00cb2c3f76ad0e88b6214c7a0.

---
diff --git a/hermes_cli/kanban_history_residue_source.py b/hermes_cli/kanban_history_residue_source.py
index 71d92811e8a..7dad6c72905 100644
--- a/hermes_cli/kanban_history_residue_source.py
+++ b/hermes_cli/kanban_history_residue_source.py
@@ -35,7 +35,7 @@
     raise Refused('nonfinite_number')
 
 
-def strict_object(raw: object) -> dict:
+def strict_object(raw: object, *, max_bytes: int = MAX_BYTES) -> dict:
     """Bounded UTF-8 JSON object; reject duplicates, nonfinite values and surrogates."""
     if not isinstance(raw, str):
         raise Refused('json_required')
@@ -43,7 +43,7 @@
         size = len(raw.encode('utf-8'))
     except UnicodeError as exc:
         raise Refused('invalid_unicode') from exc
-    _require(size <= MAX_BYTES, 'json_size')
+    _require(size <= max_bytes, 'json_size')
     try:
         value = json.loads(raw, object_pairs_hook=_pairs, parse_constant=_constant)
     except Refused:
@@ -120,11 +120,20 @@
     """
     row = decode_source(exact_source)
     fields = strict_object(row['fields'])
-    data = strict_object(raw)
+    # A source string is JSON-escaped again and two full parent snapshots are returned.
+    # Keep a finite response budget separate from the unchanged 128 KiB source cap.
+    data = strict_object(raw, max_bytes=2 * 1024 * 1024)
     _require(set(data) == {'version', 'gateway', 'receipt', 'current'} and type(data['version']) is int
              and data['version'] == 1 and data['gateway'] == gateway, 'proof_identity')
     receipt, current = data['receipt'], data['current']
     _require(isinstance(receipt, dict) and isinstance(current, dict), 'proof_objects')
+    _require(set(receipt) == {'version', 'gateway', 'source_json', 'reason', 'disposition',
+             'canonical_acceptance', 'historical_identity_certified', 'execution_authority',
+             'reported_rejection_only', 'snapshot_only', 'observed_at_ms', 'observed_head', 'parent', 'absence'},
+             'receipt_keys')
+    _require(set(current) == {'observed_at_ms', 'observed_head', 'parent', 'absence', 'no_lease',
+             'no_running_run', 'no_retained_op_receipt', 'op_history_certified', 'retained_receipt_floor1',
+             'execution_authority'}, 'current_keys')
     _require(type(receipt.get('version')) is int and receipt['version'] == 1
              and receipt.get('gateway') == gateway and receipt.get('source_json') == exact_source
              and receipt.get('disposition') == 'retained_unreplayed'
diff --git a/tests/hermes_cli/test_kanban_history_residue_proof.py b/tests/hermes_cli/test_kanban_history_residue_proof.py
index 3a35871de1a..935046acb60 100644
--- a/tests/hermes_cli/test_kanban_history_residue_proof.py
+++ b/tests/hermes_cli/test_kanban_history_residue_proof.py
@@ -26,6 +26,24 @@
     return raw, {'version': 1, 'gateway': 'home', 'receipt': receipt, 'current': current}
 
 
+@pytest.mark.parametrize('section,key,value', [('current', 'op_unknown', True),
+    ('current', 'canonical_acceptance', True), ('current', 'historical_identity_certified', True),
+    ('receipt', 'op_unknown', True)])
+def test_rejects_unexpected_nested_contract_keys(section, key, value):
+    raw, data = proof()
+    data[section][key] = value
+    with pytest.raises(source.Refused):
+        source.validate_current(json.dumps(data), raw, gateway='home', board='default', head=100)
+
+
+def test_large_legal_response_has_its_own_bound_not_source_cap():
+    raw, data = proof()
+    data['receipt']['parent']['body'] = 'x' * 65536
+    data['current']['parent']['body'] = 'x' * 65536
+    assert len(json.dumps(data).encode()) > source.MAX_BYTES
+    assert source.validate_current(json.dumps(data), raw, gateway='home', board='default', head=100) == data['current']
+
+
 def test_separates_historical_receipt_from_current_safe_parent_and_cache_uncertainty():
     raw, data = proof()
     data['current']['parent']['version'] = 8
