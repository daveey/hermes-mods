From fd38384cb95c4b3b657166c1ff171be97eececcb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 17 Oct 2026 00:17:22 -0700
Subject: [PATCH] fix(kanban): route timed waits to kanban_schedule, not
 kanban_block [daveey]

Workers parked time waits (run caps, soaks) with kanban_block, which marks the
creating chat red as needing a human. The worker guidance and the kanban_block
description now point timed/external waits at kanban_schedule (status
'scheduled', counted as in-progress on the sidebar).
---
 agent/prompt_builder.py           |  5 ++++-
 tests/agent/test_system_prompt.py | 11 +++++++++++
 tools/kanban_tools_schemas.py     |  4 +++-
 3 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/agent/prompt_builder.py b/agent/prompt_builder.py
index 9271b1b0a7..a4b731a216 100644
--- a/agent/prompt_builder.py
+++ b/agent/prompt_builder.py
@@ -284,7 +284,10 @@ KANBAN_GUIDANCE = (
     "progress.\n"
     "4. **Block on genuine ambiguity.** If you need a human decision you cannot infer (missing credentials, UX choice, "
     "paywalled source, peer output you need first), call `kanban_block(reason=\"...\")` and stop. Don't guess. The "
-    "user will unblock with context and the dispatcher will respawn you.\n"
+    "user will unblock with context and the dispatcher will respawn you "
+    "Waiting on time is not a block: when the next step must wait for a clock or an external event (a run cap, a soak, "
+    "a release window), call `kanban_schedule(reason=\"SCHEDULED_UNTIL=<ISO8601> — what you're waiting for\")` and "
+    "say what wakes the card. A blocked card marks its chat red as needing a human.\n"
     "5. **Finish with the review model encoded by the task graph.** Always include the structured handoff (`summary`, "
     "`metadata`) on the lifecycle transition itself; never put secrets, tokens, or raw PII in these durable fields. If "
     "`kanban_show()` lists child IDs, inspect those cards with `kanban_show(task_id=...)` before choosing the terminal "
diff --git a/tests/agent/test_system_prompt.py b/tests/agent/test_system_prompt.py
index 38f3d739bb..0704a505cf 100644
--- a/tests/agent/test_system_prompt.py
+++ b/tests/agent/test_system_prompt.py
@@ -956,3 +956,14 @@ class TestConversationStartedTwoLine:
         vol = self._volatile(agent)
         assert "Conversation started:" not in vol
         assert "as of the last context rebuild" not in vol
+
+
+def test_kanban_guidance_routes_timed_waits_to_schedule_not_block():
+    """A worker waiting on a clock (a cap, a soak, a release window) must park
+    with kanban_schedule: a blocked card paints its chat red as needing a human. [daveey]"""
+    from agent.prompt_builder import KANBAN_GUIDANCE
+    from tools.kanban_tools_schemas import KANBAN_BLOCK_SCHEMA
+
+    assert "kanban_schedule(" in KANBAN_GUIDANCE
+    assert "SCHEDULED_UNTIL=" in KANBAN_GUIDANCE
+    assert "kanban_schedule" in KANBAN_BLOCK_SCHEMA["description"]
diff --git a/tools/kanban_tools_schemas.py b/tools/kanban_tools_schemas.py
index ec5a72610e..dc79891441 100644
--- a/tools/kanban_tools_schemas.py
+++ b/tools/kanban_tools_schemas.py
@@ -179,7 +179,9 @@ KANBAN_BLOCK_SCHEMA = _schema(
         "``reason`` is shown to the human on the board. If a task keeps "
         "getting unblocked and re-blocked for the same reason, it is "
         "auto-escalated to triage. Use for genuine blockers only — don't "
-        "block on things you can resolve yourself."
+        "block on things you can resolve yourself. Waiting on time or an "
+        "external event (a cap, a soak, a release window) is not a block: use "
+        "kanban_schedule, since a blocked card marks its chat as needing a human."
     ),
     {
         "task_id": _prop("string", _DESC_TASK_ID_DEFAULT),
-- 
2.55.0

