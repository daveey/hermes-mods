From 7e88d5f862601159a689ec6fbc91eddb6044ac33 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 04:34:32 +0000
Subject: [PATCH] fix(gateway): keep deferred replay hydration off loop
 [daveey]

---
 gateway/session_settlement_recovery.py | 11 +++++++++--
 gateway/shutdown_flush.py              |  6 ++++--
 2 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/gateway/session_settlement_recovery.py b/gateway/session_settlement_recovery.py
index a051e74e0f..066a8d4953 100644
--- a/gateway/session_settlement_recovery.py
+++ b/gateway/session_settlement_recovery.py
@@ -251,10 +251,17 @@ async def drain_deferred_rows(authority, ref):
         from gateway.shutdown_flush import replay_deferred_rows
         drain = lambda sid: replay_deferred_rows(authority.db, sid)
     from contextlib import nullcontext
-    from agent.runtime_scope import bind_profile_scope
+    from pathlib import Path
     home = getattr(authority, 'profile_id', None)
     try:
-        with bind_profile_scope(home) if home else nullcontext():
+        # Secret-source hydration can run an external CLI (1Password, vault): the async scope loads it
+        # off the owner loop, never ``bind_profile_scope`` here.
+        if home:
+            from gateway.run import _async_profile_runtime_scope
+            scope = _async_profile_runtime_scope(Path(home))
+        else:
+            scope = nullcontext()  # supports ``async with``
+        async with scope:
             # Each drain discovers the proven ancestors of this tip. These ids are discovery
             # anchors, not spool-source == append-destination assertions.
             for sid in dict.fromkeys((ref.session_id, authority.physical_target(ref))):
diff --git a/gateway/shutdown_flush.py b/gateway/shutdown_flush.py
index ecf0e38a0b..d8f9f2c86a 100644
--- a/gateway/shutdown_flush.py
+++ b/gateway/shutdown_flush.py
@@ -226,11 +226,13 @@ def deferred_transcript_route(session_db, session_id: str) -> tuple[str, set[str
     A concurrent rotation after this read is harmless: the normal append fence refuses the old tip
     and custody stays with the spool until the next pass.
     """
-    from hermes_state_common import _non_continuation_child_sql
-    from hermes_state_compression import _CHAIN_CAP
     read = getattr(session_db, '_read_ctx', None)
     if not callable(read):  # legacy replay-only adapters cannot prove any redirection
         return session_id, {session_id}
+    # Imported only once a real SessionDB is proven: hermes_state_common pulls ~28 MB of agent modules, which a
+    # replay-only adapter (and the bounded-memory recovery of a large spool backlog) must not pay for.
+    from hermes_state_common import _non_continuation_child_sql
+    from hermes_state_compression import _CHAIN_CAP
     with read() as conn:
         def successor(sid):
             rows = conn.execute(
