From 9edbaace2441c7227e09e5d1f11c17a9ac34be28 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 21:39:41 +0000
Subject: [PATCH] [daveey] placement: a cd/pushd with an operand after its
 redirect is not cd home

`cd 2>/dev/null repo && cat .hermes/.env` matched HERMES_STATE_PATH: _CD_HOME took a bare
`cd` followed by any redirect as "cd home", but the shell enters `repo`. A portable card was
over-routed to the hub. `cd >/dev/null repo` already matched before #2603; #2603's fd-redirect
alternative (`[ \t]+\d+>`) widened it to `2>`.

Why: _CMD_END ended the cd at the first `>` (or `N>`) without reading what followed the
redirect target, so the redirect hid the operand.

Fix: _CMD_END now skips redirects (`>`, `>>`, `&>`, `N>`, `N>&M`, each with its target word,
quoted targets included) and then requires the command to end (`$`, newline, `; | )`, a lone
`&`, or ` #`). `cd 2>/dev/null && ...`, `cd ~ 2>/dev/null && ...`, `pushd ~ >>log 2>&1 && ...`
still count as home; `cd ~2>x` stays a dir word. _STATE_DIR uses the same end, so
`cd ~/.hermes 2>/dev/null && cat .env` and `cd ~ && cd .hermes 2>x && cat .env` stay pinned.

Tests (tests/hermes_cli/test_kanban_state_path_home_forms.py):
- 6 new operand-after-redirect rows are not state paths; all 6 fail on base 707cac9f6e2.
- New pins: bare cd with only redirects (incl. comment end and quoted target), pushd ~ with
  two redirects, and the PR #2603 review nit 2 _STATE_DIR rows.

Proof: run_tests.sh on test_kanban_state_path_home_forms.py, test_kanban_hub_read_roots.py,
test_kanban_placement.py: 468 passed. Ten other placement/home-marker suites: 528 passed.

Follow-up from PR #2603 exact-head review (card t_01a1d6a7b6fded95, nits 1 and 2).
---
 hermes_cli/kanban_placement.py                |  6 ++++-
 .../test_kanban_state_path_home_forms.py      | 24 +++++++++++++++++++
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index a57162e42a..d6d31f4006 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -594,7 +594,11 @@ def _heavy_marker(title: str, body: str, cfg: _Cfg) -> Optional[str]:
 # ~/.hermes/hermes-agent``, not the state directory (nit 2).
 HOME_PREFIX = r"(?:~|/home/[^/\s]+|\$HOME\b|\$\{HOME\}|\"\$HOME\"|\"\$\{HOME\}\")"
 # ``cd ~ 2>/dev/null`` ends the cd too (an fd-numbered redirect); ``cd ~2>x`` is a dir word, not a redirect.
-_CMD_END = r"(?=[ \t]*(?:$|[\n;&|)>])|[ \t]+(?:#|\d+>))"
+# Redirects (``>``, ``>>``, ``&>``, ``N>``, ``N>&M`` plus their target word) are skipped, and the command must
+# then end: ``cd 2>/dev/null repo`` enters ``repo``, not home (PR #2603 review nit 1).
+_REDIR = (r"(?:[ \t]*&?>|[ \t]+\d+>)>?[ \t]*&?"
+          r"(?:\"[^\"\n]*\"|'[^'\n]*'|[^\s;&|()<>\"'])+")
+_CMD_END = r"(?=(?:" + _REDIR + r")*(?:[ \t]*(?:$|[\n;|)]|&(?!>))|[ \t]+#))"
 _CD_HOME = (r"(?<![\w./-])(?-i:cd(?:[ \t]+" + HOME_PREFIX + r"/?)?|pushd[ \t]+" + HOME_PREFIX + r"/?)" + _CMD_END)
 _CHDIR = (r"(?:" + _CD_HOME + r"|(?:(?<=\n)|&&|\|\||;|`|\{)[ \t]*"
           r"(?-i:cd(?![\w.-])(?![ \t]+-" + _CMD_END + r")|pushd(?![\w.-])(?![ \t]+[+-]\d+" + _CMD_END + r")(?!"
diff --git a/tests/hermes_cli/test_kanban_state_path_home_forms.py b/tests/hermes_cli/test_kanban_state_path_home_forms.py
index 32261182b7..01bf8a6481 100644
--- a/tests/hermes_cli/test_kanban_state_path_home_forms.py
+++ b/tests/hermes_cli/test_kanban_state_path_home_forms.py
@@ -90,11 +90,35 @@ def test_tilde_root_path_still_clears(attested):
     "cd ~ 2>/dev/null && cat .hermes/.env",
     "cd $HOME 2>&1 >/dev/null; cat .hermes/.env",
     "cd ~ &>/dev/null && cat .hermes/.env",
+    # PR #2603 review nit 1: a bare cd with only redirects (and no operand after them) still goes home.
+    "cd 2>/dev/null && cat .hermes/.env",
+    "cd >/dev/null; cat .hermes/.env",
+    "cd 2>x 3>y && cat .hermes/.env",
+    "cd >>log 2>&1 # home\ncat .hermes/.env",
+    'cd 2>"/dev/null" && cat .hermes/.env',
+    "pushd ~ >>log 2>&1 && cat .hermes/.env",
+    # PR #2603 review nit 2: the fd-redirect end reaches a cd into the state dir itself too.
+    "cd ~/.hermes 2>/dev/null && cat .env",
+    "cd ~ && cd .hermes 2>x && cat .env",
 ])
 def test_pushd_and_commented_cd_home_are_state_paths(body):
     assert _hit(body)
 
 
+# PR #2603 review nit 1: an operand after the redirect is the cd target (``cd 2>/dev/null repo`` enters ``repo``), so
+# the span is not home and a portable card must not be routed to the hub.
+@pytest.mark.parametrize("body", [
+    "cd 2>/dev/null repo && cat .hermes/.env",
+    "cd >/dev/null repo && cat .hermes/.env",
+    "cd &>/dev/null repo && cat .hermes/.env",
+    "cd 2>&1 >/dev/null repo; cat .hermes/.env",
+    "cd >>log repo\ncat .hermes/.env",
+    'cd 2>"x y" repo && cat .hermes/.env',
+])
+def test_cd_with_operand_after_a_redirect_is_not_cd_home(body):
+    assert not _hit(body)
+
+
 @pytest.mark.parametrize("body", [
     "Burn a CD\ncat .hermes/.env",
     "CD ~ && cat .hermes/.env",
-- 
