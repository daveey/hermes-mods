diff --git a/hermes_cli/kanban_wake_episode.py b/hermes_cli/kanban_wake_episode.py
new file mode 100644
index 00000000000..b62c2d2b492
--- /dev/null
+++ b/hermes_cli/kanban_wake_episode.py
@@ -0,0 +1,78 @@
+"""Durable age of a clean not-yet probe, independent of disposable probe leases.
+
+Ready/todo/running/review are the wake → worker → re-park corridor. An episode
+survives that corridor only for the identical probe; leaving it resets the wait.
+The status trigger covers direct SQL and synced status writers as well as tools.
+"""
+from __future__ import annotations
+
+import math
+import sqlite3
+from datetime import datetime
+from zoneinfo import ZoneInfo
+
+STALE_EVENT = "wake_check_stale"
+DEFAULT_STALE_HOURS = 48
+
+
+def ensure_schema(conn: sqlite3.Connection) -> None:
+    """Installed after legacy table rebuilds; local-only, like task_wake_checks."""
+    conn.execute("""CREATE TABLE IF NOT EXISTS task_wake_episodes (
+        task_id TEXT PRIMARY KEY, cmd TEXT NOT NULL, first_at INTEGER NOT NULL,
+        checks INTEGER NOT NULL, last_stale_at INTEGER)""")
+    conn.execute("""CREATE TRIGGER IF NOT EXISTS task_wake_episode_reset
+        AFTER UPDATE OF status ON tasks
+        WHEN NEW.status NOT IN ('scheduled', 'todo', 'ready', 'running', 'review')
+        BEGIN DELETE FROM task_wake_episodes WHERE task_id = NEW.id; END""")
+    conn.execute("""CREATE TRIGGER IF NOT EXISTS task_wake_episode_delete
+        AFTER DELETE ON tasks
+        BEGIN DELETE FROM task_wake_episodes WHERE task_id = OLD.id; END""")
+    conn.execute("DELETE FROM task_wake_episodes WHERE task_id NOT IN (SELECT id FROM tasks)")
+
+
+def reset(conn: sqlite3.Connection, task_id: str) -> None:
+    conn.execute("DELETE FROM task_wake_episodes WHERE task_id = ?", (task_id,))
+
+
+def repark(conn: sqlite3.Connection, task_id: str, cmd: str | None) -> None:
+    conn.execute("DELETE FROM task_wake_episodes WHERE task_id = ? AND cmd IS NOT ?", (task_id, cmd))
+
+
+def stale_seconds() -> float:
+    from hermes_cli.config_backend import ConfigBackendUnavailable
+    from hermes_cli.config import load_config
+
+    try:
+        section = load_config().get("kanban")
+    except (ConfigBackendUnavailable, OSError, ValueError):
+        section = None
+    value = section.get("wake_check_stale_hours") if isinstance(section, dict) else None
+    try:
+        hours = float(value)
+    except (TypeError, ValueError):
+        hours = DEFAULT_STALE_HOURS
+    if not math.isfinite(hours) or hours <= 0:
+        hours = DEFAULT_STALE_HOURS
+    return hours * 3600
+
+
+def stamp(timestamp: int) -> str:
+    return datetime.fromtimestamp(timestamp, ZoneInfo("America/Los_Angeles")).strftime("%Y-%m-%d %H:%M PT")
+
+
+def not_yet(conn: sqlite3.Connection, task_id: str, cmd: str, now: int, interval: float) -> dict | None:
+    """Count a validated clean exit 1 and return a due stale-wake payload."""
+    repark(conn, task_id, cmd)
+    conn.execute(
+        "INSERT INTO task_wake_episodes(task_id, cmd, first_at, checks) VALUES (?, ?, ?, 1) "
+        "ON CONFLICT(task_id) DO UPDATE SET checks = checks + 1", (task_id, cmd, now))
+    first, checks, last = conn.execute(
+        "SELECT first_at, checks, last_stale_at FROM task_wake_episodes WHERE task_id = ?", (task_id,)).fetchone()
+
+    if now - first < interval or (last is not None and now - last < interval):
+        return None
+    conn.execute("UPDATE task_wake_episodes SET last_stale_at = ? WHERE task_id = ?", (now, task_id))
+    note = (f"wake_check has not passed in {(now - first) / 3600:g} h "
+            f"({checks} checks since {stamp(first)}): check that its condition can occur, "
+            "then change the wait or the acceptance. Re-parking on the identical probe keeps this episode.")
+    return {"wake_check": cmd, "first_at": first, "checks": checks, "last_stale_at": now, "note": note}
diff --git a/tests/hermes_cli/test_kanban_wake_episode.py b/tests/hermes_cli/test_kanban_wake_episode.py
new file mode 100644
index 00000000000..3aa2c021948
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_wake_episode.py
@@ -0,0 +1,256 @@
+"""Clean not-yet probes must eventually ask their worker to reconsider the wait."""
+from __future__ import annotations
+
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_wake_check as wc
+from tests.hermes_cli import test_kanban_wake_check as helpers
+
+kanban_home = helpers.kanban_home
+HOUR = 3600
+STALE = "wake_check_stale"
+
+
+@pytest.fixture
+def parked(kanban_home, monkeypatch):
+    clock = [int(time.time())]
+    monkeypatch.setattr(time, "time", lambda: clock[0])
+    with kbc.connect_closing() as conn:
+        tid = helpers._running(conn)
+        assert kb.schedule_task(conn, tid, reason="waiting", wake_check="exit 1")
+        yield conn, tid, clock
+
+
+def result(parked, hours, rc=1):
+    conn, tid, clock = parked
+    state = wc.get_state(conn, tid)
+    now = clock[0] + int(hours * HOUR)
+    return wc.apply_result(conn, tid, state["cmd"], rc, "", generation=state["generation"], now=now)
+
+
+def repark(parked, cmd="exit 1"):
+    conn, tid, _ = parked
+    assert kb.claim_task(conn, tid, claimer="worker") is not None
+    assert kb.schedule_task(conn, tid, reason="waiting", wake_check=cmd)
+
+
+def test_always_not_yet_wakes_once_at_48_hours(parked):
+    conn, tid, _ = parked
+    for hour in (0, 12, 24, 47):
+        assert result(parked, hour) is None
+    assert result(parked, 48) == STALE
+    assert kb.get_task(conn, tid).status == "ready"
+    assert len(helpers._events(conn, tid, STALE)) == 1
+    text = "\n".join(c.body for c in kb.list_comments(conn, tid))
+    assert "wake_check has not passed in 48 h (5 checks since " in text
+    assert " PT): check that its condition can occur" in text
+    assert "Re-parking on the identical probe keeps this episode." in text
+    assert "wake_check has not passed" in kb.build_worker_context(conn, tid)
+
+
+def test_pass_inside_window_resets_episode(parked):
+    conn, tid, _ = parked
+    result(parked, 0)
+    assert result(parked, 24, 0) == "condition_met"
+    repark(parked)
+    result(parked, 25)
+    assert result(parked, 48) is None
+    assert not helpers._events(conn, tid, STALE)
+
+
+def test_same_probe_repark_waits_another_48_hours(parked):
+    conn, tid, _ = parked
+    result(parked, 0)
+    assert result(parked, 48) == STALE
+    repark(parked)
+    for hour in (49, 72, 95):
+        assert result(parked, hour) is None
+    assert len(helpers._events(conn, tid, STALE)) == 1
+    assert result(parked, 96) == STALE
+    assert len(helpers._events(conn, tid, STALE)) == 2
+
+
+def test_changed_probe_starts_new_episode(parked):
+    conn, tid, _ = parked
+    result(parked, 0)
+    with kb.write_txn(conn):
+        wc.set_check(conn, tid, "test -f new-flag", 120)
+    result(parked, 47)
+    assert result(parked, 48) is None
+    assert result(parked, 95) == STALE
+
+
+def test_exit_two_does_not_advance_episode(parked):
+    conn, tid, clock = parked
+    result(parked, 0)
+    assert result(parked, 49, 2) is None
+    assert not helpers._events(conn, tid, STALE)
+    state = wc.get_state(conn, tid)
+    assert state["episode_first_at"] == clock[0]
+    assert state["episode_checks"] == 1
+    assert state["fails"] == 1
+    assert result(parked, 50) == STALE
+    assert helpers._events(conn, tid, STALE)[0].payload["checks"] == 2
+
+
+@pytest.mark.parametrize("status", ["blocked", "triage", "done", "archived"])
+def test_leaving_wait_cycle_resets_even_without_a_dispatch_tick(parked, status):
+    conn, tid, clock = parked
+    result(parked, 0)
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET status = ? WHERE id = ?", (status, tid))
+        conn.execute("UPDATE tasks SET status = 'scheduled' WHERE id = ?", (tid,))
+        wc.set_check(conn, tid, "exit 1", 120)
+    assert result(parked, 48) is None
+    assert wc.get_state(conn, tid)["episode_first_at"] == clock[0] + 48 * HOUR
+
+
+@pytest.mark.parametrize("rc", [2, 124, 255, "timeout", None])
+def test_errors_do_not_start_an_episode(parked, rc):
+    conn, tid, _ = parked
+    assert result(parked, 0, rc) is None
