diff --git a/hermes_cli/kanban_pr_rest.py b/hermes_cli/kanban_pr_rest.py
new file mode 100644
index 0000000000..170378cedd
--- /dev/null
+++ b/hermes_cli/kanban_pr_rest.py
@@ -0,0 +1,42 @@
+"""REST projection of the PR/policy evidence used by completion acceptance."""
+from urllib.parse import quote
+
+
+class GraphQLRateLimit(ValueError):
+    """Only GitHub GraphQL quota exhaustion; not a local budget or auth refusal."""
+
+
+class UnprotectedBranch(ValueError):
+    """GitHub positively reports that the base branch is not protected."""
+
+
+def quota_error(text: str) -> bool:
+    lowered = text.lower()
+    return "rate_limited" in lowered or "api rate limit" in lowered
+
+
+def read_pr(api, repo: str, number: int, profile_home: str | None) -> dict:
+    """Preserve policy app IDs and merge timestamps; unreadable policy fails closed."""
+    pull = api(f"repos/{repo}/pulls/{number}", profile_home=profile_home)
+    state, merged = pull["state"], pull["merged"]
+    if state not in {"open", "closed"} or not isinstance(merged, bool) or (merged and state != "closed"):
+        raise ValueError("Invalid REST PR state")
+    result = {"headRefOid": pull["head"]["sha"], "baseRefName": pull["base"]["ref"],
+              "state": "MERGED" if merged else state.upper(),
+              "mergedAt": pull["merged_at"], "mergeCommit": {"oid": pull["merge_commit_sha"]}}
+    if result["state"] == "CLOSED":
+        return result
+    branch = quote(result["baseRefName"], safe="")
+    try:
+        protection = api(f"repos/{repo}/branches/{branch}/protection/required_status_checks",
+                         profile_home=profile_home)
+    except UnprotectedBranch:
+        protection = {"contexts": [], "checks": []}
+    # Both keys are part of the REST contract; missing policy is not no policy.
+    required = [{"context": row["context"], "app": {"databaseId": row["app_id"]}}
+                for row in protection["checks"]]
+    pinned = {row["context"] for row in required}
+    required.extend({"context": context, "app": None}
+                    for context in protection["contexts"] if context not in pinned)
+    result["baseRef"] = {"branchProtectionRule": {"requiredStatusChecks": required}}
+    return result
diff --git a/tests/hermes_cli/test_kanban_pr_rest.py b/tests/hermes_cli/test_kanban_pr_rest.py
new file mode 100644
index 0000000000..80af0214c6
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_pr_rest.py
@@ -0,0 +1,85 @@
+"""Quota fallback retains exact-head, policy and merge-time acceptance."""
+import subprocess
+
+import pytest
+
+from hermes_cli import kanban_pr_acceptance as gate
+from tests.hermes_cli import test_kanban_pr_acceptance as fixtures
+
+
+acceptance_github = fixtures.github
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.parametrize("fault", [None, "failure", "missing", "stale", "head_change"])
+def test_exhausted_completion_uses_rest(acceptance_github, monkeypatch, fault):
+    github = acceptance_github
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_db_connect import connect
+
+    original = gate._api
+    calls = []
+
+    def api(endpoint, **kwargs):
+        calls.append(endpoint)
+        if endpoint == "graphql":
+            raise gate._GraphQLRateLimit("GraphQL quota exhausted")
+        if endpoint.endswith("/protection/required_status_checks"):
+            return {"contexts": ["required"], "checks": [{"context": "required", "app_id": 1}]}
+        value = original(endpoint, **kwargs)
+        if endpoint == "repos/acme/repo/pulls/7":
+            value.update(merged_at="2026-11-02T13:10:04Z", merge_commit_sha=None)
+        return value
+
+    monkeypatch.setattr(gate, "_api", api)
+    if fault == "failure":
+        github["conclusion"] = "failure"
+    elif fault:
+        github[fault] = True
+    with connect() as conn:
+        task = kb.create_task(conn, title="REST acceptance", completion_contract="acme/repo")
+        ok = kb.complete_task(conn, task, summary="done", metadata={
+            "published_pr": "https://github.com/acme/repo/pull/7"})
+        assert ok is (fault is None)
+        assert (kb.get_task(conn, task).status == "done") is ok
+    assert calls.count("graphql") == 1
+    assert sum(path == "repos/acme/repo/pulls/7" for path in calls) == 2
+
+
+@pytest.mark.parametrize("message", [
+    "GraphQL: API rate limit already exceeded for user ID 123",
+    '{"errors":[{"type":"RATE_LIMITED"}]}',
+])
+def test_transport_classifies_rate_limit_before_http_auth(monkeypatch, message):
+    monkeypatch.setattr(gate, "_gh_command_prefix", lambda home: [])
+    monkeypatch.setattr(gate, "_gh_env", lambda home: None)
+    monkeypatch.setattr("hermes_platform.resolver.github.resolve_gh", lambda *a: type(
+        "Resolved", (), {"found": True, "command": ["gh"]})())
+
+    def fail(*args, **kwargs):
+        raise subprocess.CalledProcessError(1, "gh", stderr=message + " (HTTP 403)")
+
+    monkeypatch.setattr(subprocess, "run", fail)
+    with pytest.raises(gate._GraphQLRateLimit):
+        gate._api("graphql", query="{}")
+    with pytest.raises(gate._GateAuthError):
+        gate._api("repos/acme/repo/pulls/7")
+
+
+def test_rest_policy_unreadable_does_not_accept(acceptance_github, monkeypatch):
+    original = gate._api
+
+    def api(endpoint, **kwargs):
+        if endpoint == "graphql":
+            raise gate._GraphQLRateLimit()
+        if "/protection/" in endpoint:
+            raise gate._GateAuthError("HTTP 404")
+        value = original(endpoint, **kwargs)
+        if endpoint == "repos/acme/repo/pulls/7":
+            value.update(merged_at="2026-11-02T13:10:04Z", merge_commit_sha=None)
+        return value
+
+    monkeypatch.setattr(gate, "_api", api)
+    receipt = gate.collect_acceptance("acme/repo", "https://github.com/acme/repo/pull/7")
+    assert not receipt["ok"]
+    assert receipt["classification"] == "auth"
