From 8c008db574eb6c7a24d110a727163873ffefe102 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 27 Nov 2026 01:48:24 +0000
Subject: [PATCH 6679] File-descriptor headroom guard and incident reporting

Public mirror of source commit 8c008db574eb6c7a24d110a727163873ffefe102.

---
diff --git a/hermes_cli/fd_headroom_incident.py b/hermes_cli/fd_headroom_incident.py
index 16e42ca93725e74ee253df89e9ad1a6bb6321fba..c38f18b8d371e5922cf22b5ec9bdfc03a800d6ec 100644
--- a/hermes_cli/fd_headroom_incident.py
+++ b/hermes_cli/fd_headroom_incident.py
@@ -145,7 +145,7 @@
                 '--id', key, '--option', f'idempotency_key={json.dumps(key)}',
                 '--option', 'runs_on=["pool:worker"]']
         if probe:
-            argv += ['--option', 'triage=true']
+            argv += ['--option', 'initial_status="blocked"']
         state.update(pending={'id': key, 'argv': argv, 'retry_at': now + HOUR}, task_id=None,
                      filed_at=now, commented_at=now)
         _save(path, state)  # persist frozen envelope BEFORE any possible external write
diff --git a/tests/hermes_cli/test_fd_headroom_incident.py b/tests/hermes_cli/test_fd_headroom_incident.py
index 8fcd625820801f5b0d1cf4d8d324e6d7a91c3116..e797057ad41e24f7ffd1ce1eb88d0e5f33490e5c 100644
--- a/tests/hermes_cli/test_fd_headroom_incident.py
+++ b/tests/hermes_cli/test_fd_headroom_incident.py
@@ -57,6 +57,8 @@
     _, rows, creates, _ = courier
     report(courier, 0, probe=True)
     assert creates[0][3].startswith('[probe]')
+    assert 'initial_status="blocked"' in creates[0]
+    assert 'triage=true' not in creates[0]
     rows[0]['status'] = 'archived'
     report(courier, 1, probe=True)
     assert len(creates) == 1
-- 
