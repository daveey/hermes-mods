-def backfill(conn, *, apply: bool) -> dict:
-    """Give each ownerless open card its producer's owner chat (``apply``), re-checked under the write lock.
-    Links to owner chats the user deleted or archived are released (or unsubscribed) first."""
+def backfill(conn, *, apply: bool, limit: Optional[int] = None) -> dict:
+    """Give each ownerless open card (up to ``limit``) its producer's live owner chat (``apply``), re-checked under
+    the write lock. A card left on a deleted or archived owner chat is re-validated first (``ensure(force=True)``
+    restores an archived chat; a deleted one rotates). On a synced board its dead link stays: creating-chat links
+    are never released on their own gateway (``kanban_chat_links._local_links``), and the live link beside it
+    owns the card. On a board without links the dead subscription is dropped."""
     from hermes_cli import kanban_db as kb
     links = bool(conn.execute("SELECT 1 FROM sqlite_master WHERE name='task_chat_links'").fetchone())
     db, live = _liveness()
     try:
         found, linked = ownerless(conn, live), []
         if apply:
-            for task_id, producer in found:
-                sid = ensure(producer)  # state.db work outside the kanban write lock
+            forced: set[str] = set()
+            for task_id, producer in found[:limit]:
+                dead = _needs_owner(conn, task_id, links, live)
+                if dead is None:
+                    continue
+                force = bool(dead) and producer not in forced
+                sid = ensure(producer, force=force)  # state.db work outside the kanban write lock
+                if force:
+                    forced.add(producer)
                 with kb.write_txn(conn):
-                    dead = _needs_owner(conn, task_id, links, live)
-                    if dead is None:
-                        continue
-                    for ref in dead:
-                        if ref.rsplit("/", 1)[-1] == sid:
-                            continue  # an archived chat ensure() just restored: keep its link
-                        if links:
-                            conn.execute("UPDATE task_chat_links SET released=1 WHERE task_id=? AND kind='created' "
-                                         "AND chat_session=?", (task_id, ref))
-                        else:
-                            conn.execute("DELETE FROM kanban_notify_subs WHERE task_id=? AND platform='tui' "
-                                         "AND chat_id=?", (task_id, ref))
-                    link(conn, task_id, producer, sid)
-                    linked.append(task_id)
+                    if _relink(conn, task_id, producer, sid, links, live):
+                        linked.append(task_id)
     finally:
         db.close()
     by_producer: dict[str, int] = {}
@@ -316,14 +331,30 @@
     return {"ownerless": len(found), "linked": len(linked), "by_producer": by_producer}
 
 
+def _relink(conn, task_id: str, producer: str, sid: str, links: bool, live) -> bool:
+    """Under the write lock: own the card by ``sid`` if it still needs an owner. True when newly linked or its
+    archived chat was just restored."""
+    dead = _needs_owner(conn, task_id, links, live)
+    if dead is None:
+        return False
+    for ref in dead if not links else ():
+        if ref != sid:
+            conn.execute("DELETE FROM kanban_notify_subs WHERE task_id=? AND platform='tui' AND chat_id=?",
+                         (task_id, ref))
+    return link(conn, task_id, producer, sid) or sid in dead
+
