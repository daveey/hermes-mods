From beb53f93b52bc2f388aecd42b323aeba34ab9e54 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 06:04:00 +0000
Subject: [PATCH] fix(update): register conflict reporting subprocess and CI
 dependencies [daveey]

---
 hermes_cli/worker_drain_spawn_inventory.json | 5 +++++
 scripts/ci/classify_changes.py               | 3 +++
 2 files changed, 8 insertions(+)

diff --git a/hermes_cli/worker_drain_spawn_inventory.json b/hermes_cli/worker_drain_spawn_inventory.json
index 9db0c05c06..18bd75bbf1 100644
--- a/hermes_cli/worker_drain_spawn_inventory.json
+++ b/hermes_cli/worker_drain_spawn_inventory.json
@@ -920,6 +920,11 @@
    "routed": 0,
    "status": "pending"
   },
+  "hermes_cli/update_conflict_reporting.py": {
+   "direct": 1,
+   "routed": 0,
+   "status": "pending"
+  },
   "hermes_cli/update_lock.py": {
    "direct": 2,
    "routed": 0,
diff --git a/scripts/ci/classify_changes.py b/scripts/ci/classify_changes.py
index 26754ac10b..90558a19a2 100644
--- a/scripts/ci/classify_changes.py
+++ b/scripts/ci/classify_changes.py
@@ -466,6 +466,9 @@ _UPDATE_DEPENDENCIES = (
     "agent/deadline.py",  # bounded probes' process-tree timeout cleanup
     "hermes_cli/kanban_db.py",  # update_upstream_conflict files the conflict card
     "hermes_cli/kanban_db_connect.py",
+    "hermes_cli/kanban_db_sync.py",  # conflict reporting validates the inventory board
+    "hermes_cli/kanban_sync_client.py",  # authoritative conflict-owner evidence
+    "hermes_cli/config_effective.py",  # fail-closed conflict reporting configuration
     "hermes_cli/kanban_schema_owner.py",  # post_update reports a board schema only the installed core may migrate
     "hermes_cli/kanban_capability_routing.py",  # update_pause_siblings names this host's Board gateway
     "hermes_cli/kanban_foreign_card.py",  # update_pause_siblings reads sibling alarms in the Board replica
-- 
