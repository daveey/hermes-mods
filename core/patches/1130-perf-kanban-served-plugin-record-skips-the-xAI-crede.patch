From 012e35dfcde87ce0e8793470c327c0058dbe8eaf Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 21:55:50 -0700
Subject: [PATCH] perf(kanban): served plugin record skips the xAI credential
 probe (no hermes_cli.auth import on cold assign_task) (#249)

---
 hermes_cli/tools_config.py                    |  6 +++++-
 ...est_kanban_capabilities_plugin_snapshot.py | 21 +++++++++++++++++++
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/tools_config.py b/hermes_cli/tools_config.py
index c057a0543bf..a791730b71d 100644
--- a/hermes_cli/tools_config.py
+++ b/hermes_cli/tools_config.py
@@ -512,7 +512,11 @@ def _composite_toolsets(toolset_names: list[str], platform: str, explicitly_conf
     all_tool_names = {t for ts_name in toolset_names for t in resolve_toolset(ts_name)}
     enabled = _configurable_subset_of(all_tool_names, platform)
     default_off = _default_off_toolsets(platform, explicitly_configured)
-    if _toolset_allowed_for_platform("x_search", platform) and _xai_credentials_present():
+    # [daveey] A served plugin record (kanban admission) reads only terminal/file/kanban membership; x_search
+    # cannot change that, and the credential probe imports hermes_cli.auth (~3.7 s cold on the mini).
+    from hermes_cli import plugins_snapshot
+    if (plugins_snapshot.active() is None and _toolset_allowed_for_platform("x_search", platform)
+            and _xai_credentials_present()):
         enabled.add("x_search")
         default_off.discard("x_search")
     return enabled - default_off
diff --git a/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py b/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py
index 50b4f4537f9..1dff6bff30b 100644
--- a/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py
+++ b/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py
@@ -33,6 +33,7 @@ PROBE = textwrap.dedent("""
         out = {"missing": exc.missing}
     out["discoveries"] = len(calls)
     out["providers_discovered"] = bool(providers._discovered)
+    out["auth_imported"] = "hermes_cli.auth" in sys.modules
     print("RESULT " + json.dumps(out))
 """)
 
@@ -104,6 +105,26 @@ def test_second_cold_process_serves_the_record_without_discovery(home):
     assert second["providers_discovered"] is False
 
 
+def test_served_default_composite_does_not_import_auth_or_providers(home):
+    """A profile with no saved cli toolset list resolves through the default composite, which probes
+    xAI credentials (importing hermes_cli.auth, ~3.7 s cold on the mini). A served record needs
+    only terminal/file membership, so it must not pay that; a stale record falls back to the full
+    discovery (and its credential probe)."""
+    _tool_plugin(home, "extra", "extra_ping", "extra")
+    _config(home, ENABLED % "extra")
+    first = _run(home)
+    assert first["discoveries"] == 1 and first["granted"] == ["terminal", "file"]
+    second = _run(home)
+    assert _verdict(second) == _verdict(first)
+    assert second["discoveries"] == 0
+    assert second["auth_imported"] is False and second["providers_discovered"] is False
+    # Editing a plugin makes the record stale: full discovery again, same verdict.
+    (home / "plugins" / "extra" / "__init__.py").write_text(
+        (home / "plugins" / "extra" / "__init__.py").read_text() + "\n# edited\n")
+    third = _run(home)
+    assert third["discoveries"] == 1 and _verdict(third) == _verdict(first)
+
+
 @pytest.mark.parametrize("cli", [
     None,                                   # platform default composite
     "[hermes-cli]",                         # explicit composite
-- 
2.55.0

