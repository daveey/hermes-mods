+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+
+import { describe, expect, it, vi } from 'vitest'
+
+import { coalescedBackendRead, ReadCoalescer } from './read-coalescing'
+
+const deferred = <T>() => {
+  let resolve!: (value: T) => void
+  let reject!: (error: unknown) => void
+
+  const promise = new Promise<T>((res, rej) => {
+    resolve = res
+    reject = rej
+  })
+
+  return { promise, reject, resolve }
+}
+
+const hub = { baseUrl: 'http://127.0.0.1:59853', authMode: 'token', token: 'tok-a', headers: { 'X-A': '1' } }
+const LIST = '/api/profiles/sessions?limit=50&profile=all&source=cron'
+
+describe('coalescedBackendRead', () => {
+  it('sends one request for identical concurrent reads and gives each caller its own copy', async () => {
+    const coalescer = new ReadCoalescer()
+    const answer = deferred<{ sessions: { id: string }[] }>()
+    const once = vi.fn(() => answer.promise)
+
+    const reads = Array.from({ length: 10 }, () =>
+      coalescedBackendRead(coalescer, hub, LIST, { timeoutMs: 15_000 }, once)
+    )
+
+    answer.resolve({ sessions: [{ id: 'a' }] })
+    const results = await Promise.all(reads)
+
+    expect(once).toHaveBeenCalledTimes(1)
+    expect(results.every(result => result.sessions[0].id === 'a')).toBe(true)
+
+    // A caller that edits its answer (tagRemoteSessionRows does) cannot change another caller's.
+    results[0].sessions[0].id = 'edited'
+    expect(results.slice(1).every(result => result.sessions[0].id === 'a')).toBe(true)
+    expect(new Set(results).size).toBe(10)
+  })
+
+  it('asks again once the shared read has settled', async () => {
+    const coalescer = new ReadCoalescer()
+    const once = vi.fn(async () => ({ n: once.mock.calls.length }))
+
+    const first = await coalescedBackendRead(coalescer, hub, LIST, {}, once)
+    const second = await coalescedBackendRead(coalescer, hub, LIST, {}, once)
+
+    expect(once).toHaveBeenCalledTimes(2)
+    expect([first.n, second.n]).toEqual([1, 2])
+    expect(coalescer.inflight).toBe(0)
+  })
+
+  it('keeps reads apart when anything on the wire or the deadline differs', async () => {
+    const coalescer = new ReadCoalescer()
+    const gate = deferred<unknown>()
+    const once = vi.fn(() => gate.promise)
+
+    const variants = [
+      coalescedBackendRead(coalescer, hub, LIST, {}, once),
+      coalescedBackendRead(coalescer, hub, `${LIST}&offset=50`, {}, once),
+      coalescedBackendRead(coalescer, { ...hub, token: 'tok-b' }, LIST, {}, once),
+      coalescedBackendRead(coalescer, { ...hub, baseUrl: 'http://127.0.0.1:60000' }, LIST, {}, once),
+      coalescedBackendRead(coalescer, { ...hub, headers: { 'X-A': '2' } }, LIST, {}, once),
+      coalescedBackendRead(coalescer, hub, LIST, { timeoutMs: 4_000 }, once),
+      coalescedBackendRead(coalescer, hub, LIST, { pool: 'probe' }, once),
+      coalescedBackendRead(coalescer, hub, LIST, { profileScoped: true }, once)
+    ]
+
+    gate.resolve({})
+    await Promise.all(variants)
+    expect(once).toHaveBeenCalledTimes(variants.length)
+  })
+
+  it('never coalesces writes, and a read after a write does not join a read sent before it', async () => {
+    const coalescer = new ReadCoalescer()
+    const before = deferred<string>()
+    const after = deferred<string>()
+    const reads = [before, after]
+
+    const once = vi.fn((_d: unknown, _p: string, opts: { method?: string; body?: unknown }) =>
+      opts.method === 'POST' ? Promise.resolve('wrote') : (reads.shift() as ReturnType<typeof deferred<string>>).promise
+    )
+
+    const stale = coalescedBackendRead(coalescer, hub, LIST, {}, once)
+
+    const writes = [
+      coalescedBackendRead(coalescer, hub, '/api/sessions/x/archive', { method: 'POST', body: {} }, once),
+      coalescedBackendRead(coalescer, hub, '/api/sessions/x/archive', { method: 'POST', body: {} }, once)
+    ]
+
+    const fresh = coalescedBackendRead(coalescer, hub, LIST, {}, once)
+
+    before.resolve('before the write')
+    after.resolve('after the write')
+
+    expect(await Promise.all(writes)).toEqual(['wrote', 'wrote'])
+    expect(await stale).toBe('before the write')
+    expect(await fresh).toBe('after the write')
+    expect(once).toHaveBeenCalledTimes(4)
+  })
+
+  it('shares a failure with every caller and then lets the next read try again', async () => {
+    const coalescer = new ReadCoalescer()
+    const answer = deferred<unknown>()
+    const once = vi.fn(() => answer.promise)
+
+    const reads = [1, 2, 3].map(() => coalescedBackendRead(coalescer, hub, LIST, {}, once))
+    answer.reject(new Error('Timed out connecting to Hermes backend after 15000ms'))
+
+    for (const read of reads) {
+      await expect(read).rejects.toThrow('Timed out')
+    }
+
+    expect(once).toHaveBeenCalledTimes(1)
+    await coalescedBackendRead(
+      coalescer,
+      hub,
+      LIST,
+      {},
+      vi.fn(async () => 'ok')
+    )
+    expect(coalescer.inflight).toBe(0)
+  })
+
+  it('treats only bodyless GETs as reads', () => {
+    expect(ReadCoalescer.isRead({})).toBe(true)
+    expect(ReadCoalescer.isRead({ method: 'get' })).toBe(true)
+    expect(ReadCoalescer.isRead({ method: 'GET', body: {} })).toBe(false)
+    expect(ReadCoalescer.isRead({ method: 'GET', upload: { path: '/x' } })).toBe(false)
+    expect(ReadCoalescer.isRead({ method: 'DELETE' })).toBe(false)
+  })
+})
+
+describe('main.ts wiring', () => {
+  const main = readFileSync(join(__dirname, 'main.ts'), 'utf8')
+
+  it('sends every backend REST call through the coalescer, and the coalescer only to the real transport', () => {
+    const front = main.slice(
+      main.indexOf('function fetchJsonForBackend('),
+      main.indexOf('async function fetchJsonForBackendOnce(')
+    )
+
+    expect(front).toContain(
+      'coalescedBackendRead(backendReadCoalescer, descriptor, path, opts, fetchJsonForBackendOnce)'
+    )
+    // Nothing else calls the uncoalesced transport, so no read can bypass the sharing.
+    expect(main.match(/\bfetchJsonForBackendOnce\b/g)).toHaveLength(2)
+  })
+})
diff --git a/apps/desktop/electron/read-coalescing.ts b/apps/desktop/electron/read-coalescing.ts
new file mode 100644
index 0000000000..a88a1a757d
--- /dev/null
+++ b/apps/desktop/electron/read-coalescing.ts
@@ -0,0 +1,131 @@
+// [daveey] One wire request for identical concurrent reads of a backend.
+//
+// Measured 2026-11-13 on the hub's loopback port (30 s pcap of the Desktop's SSH tunnel): the same session-list
+// GET left this Desktop up to 6 times within 1.5 s (sidebar slices, cron list, per-profile merges and windows each
+// asking for profile=all), each answered with the same 120-273 KB body. Repeats of a read still in flight were 44%
+// of every byte the hub sent (4.1 of 9.5 MB in 101 requests); on a lossy remote link those bursts queued the other
+// requests past their deadline ("Timed out connecting to Hermes backend", 72 on conn=hermes-hub in 30 min).
+//
+// A GET that is identical to one still in flight (same backend, credential, headers, path, deadline, pool) now
+// waits for that one's answer instead of sending its own. Each caller gets its own copy of the answer, so a caller
+// that edits its result cannot change another's. A write to a backend starts a new generation: a read issued after
+// it never joins a read that left before it, so read-after-write still sees the write.
+
+export interface CoalescibleRead {
+  method?: string
+  body?: unknown
+  upload?: unknown
+}
+
+const copyOf = <T>(value: T): T => {
+  try {
+    return structuredClone(value)
+  } catch {
+    return value // not cloneable (never true for parsed JSON): hand out the shared value rather than fail the read
+  }
+}
+
+export class ReadCoalescer {
+  readonly #inflight = new Map<string, { joined: number; promise: Promise<unknown> }>()
+  readonly #generations = new Map<string, number>()
+
+  /** True for a plain read: a GET (or no method) with no body and no upload. */
+  static isRead(opts: CoalescibleRead = {}): boolean {
+    return String(opts.method || 'GET').toUpperCase() === 'GET' && opts.body === undefined && !opts.upload
+  }
+
+  /** A write to `origin` is starting: reads issued from now on never join one that left before it. */
+  noteWrite(origin: string): void {
+    this.#generations.set(origin, (this.#generations.get(origin) ?? 0) + 1)
+  }
+
+  /** The key identical reads share; `parts` must already name the credential, headers, path and deadline. */
+  keyFor(origin: string, parts: unknown[]): string {
+    return JSON.stringify([origin, this.#generations.get(origin) ?? 0, ...parts])
+  }
+
+  /** Run `start` unless a read with this key is in flight; then share its answer (each caller gets a copy). */
+  run<T>(key: null | string, start: () => Promise<T>): Promise<T> {
+    if (!key) {
+      return start()
+    }
+
+    const existing = this.#inflight.get(key)
+
+    if (existing) {
+      existing.joined += 1
+
+      return existing.promise.then(value => copyOf(value as T))
+    }
+
+    const entry = { joined: 0, promise: Promise.resolve() as Promise<unknown> }
+
+    // Settled reads leave the map before any caller sees the answer, so a later read always asks again.
+    entry.promise = Promise.resolve()
+      .then(start)
+      .finally(() => {
+        if (this.#inflight.get(key) === entry) {
+          this.#inflight.delete(key)
+        }
+      })
+    this.#inflight.set(key, entry)
+
+    // The first caller keeps the original only when nobody joined; otherwise everyone works on a copy.
+    return entry.promise.then(value => (entry.joined > 0 ? copyOf(value as T) : (value as T)))
+  }
+
+  get inflight(): number {
+    return this.#inflight.size
+  }
+}
+
+export const backendReadCoalescer = new ReadCoalescer()
+
+export interface BackendReadDescriptor {
+  baseUrl?: null | string
+  authMode?: null | string
+  token?: null | string
+  headers?: unknown
+  gatewayEndpoint?: unknown
+}
+
+export interface BackendReadOpts extends CoalescibleRead {
+  timeoutMs?: number
+  // 'probe' = the dispatch health probe's dedicated socket pool (api-transport.ts).
+  pool?: 'json' | 'probe'
+  profileScoped?: boolean
+}
+
+/**
+ * fetchJsonForBackend's front door (main.ts): a write goes straight out and starts a new generation for its
+ * backend; a read shares an identical read still in flight. Everything that changes what goes on the wire, or what
+ * the caller is willing to wait, is in the key, so only truly identical requests share one answer.
+ */
+export function coalescedBackendRead<D extends BackendReadDescriptor, O extends BackendReadOpts, T>(
+  coalescer: ReadCoalescer,
+  descriptor: D,
+  path: string,
+  opts: O,
+  once: (descriptor: D, path: string, opts: O) => Promise<T>
+): Promise<T> {
+  const origin = String(descriptor?.baseUrl ?? '')
+
+  if (!ReadCoalescer.isRead(opts)) {
+    coalescer.noteWrite(origin)
+
+    return once(descriptor, path, opts)
+  }
+
+  const key = coalescer.keyFor(origin, [
+    descriptor?.authMode ?? '',
+    descriptor?.token ?? '',
+    descriptor?.headers ?? null,
+    Boolean(descriptor?.gatewayEndpoint),
+    path,
+    opts.timeoutMs ?? null,
+    opts.pool ?? '',
+    Boolean(opts.profileScoped)
+  ])
+
+  return coalescer.run(key, () => once(descriptor, path, opts))
+}
