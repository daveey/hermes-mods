From 41692a9e19fb2e3ed1b24f06329d85b0df1642b9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 8 Nov 2026 10:38:45 +0000
Subject: [PATCH] [daveey] use locked PM ripgrep in reusable test jobs

---
 .github/workflows/tests.yml | 54 ++++++++-----------------------------
 1 file changed, 11 insertions(+), 43 deletions(-)

diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index 7e3b546eed6..c3b0689cdbf 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -84,20 +84,6 @@ jobs:
         with:
           ref: ${{ inputs.commit }}
 
-      - name: Install ripgrep (prebuilt binary)
-        run: |
-          set -euo pipefail
-          RG_VERSION=15.1.0
-          RG_SHA256=1c9297be4a084eea7ecaedf93eb03d058d6faae29bbc57ecdaf5063921491599
-          RG_TARBALL=ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl.tar.gz
-          curl -sSfL --retry 3 --retry-delay 5 -o "$RG_TARBALL" \
-            "https://github.com/BurntSushi/ripgrep/releases/download/${RG_VERSION}/${RG_TARBALL}"
-          echo "${RG_SHA256}  ${RG_TARBALL}" | sha256sum -c -
-          tar -xzf "$RG_TARBALL"
-          sudo mv "ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl/rg" /usr/local/bin/rg
-          rm -rf "$RG_TARBALL" "ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl"
-          rg --version
-
       - name: Install tmux
         # tests/hermes_cli/test_gateway_chat_native.py and other platforms("linux") tests drive the
         # real CLI in tmux and fail (not skip) without it. Not every hermes-hub runner image ships it
@@ -110,6 +96,7 @@ jobs:
       - name: Set up locked Python and test dependencies
         uses: ./.github/actions/setup-pm
         with:
+          packages: ripgrep
           # Python tests need PM's Node for .ts/ESM subprocesses and pnpm for
           # the real scripts/build/node-deps.mjs; all supplies both toolchains.
           toolchain: all
@@ -288,6 +275,8 @@ jobs:
         uses: ./.github/actions/setup-pm
         with:
           toolchain: all
+          # Use the cached, checksum-verified PM pin rather than a separate release download.
+          packages: ripgrep
           # `messaging`: tests/e2e/core/platforms runs the real Telegram/Discord/Slack
           # adapters (their SDKs) against local stand-ins.
           extras: '["all", "anthropic", "bedrock", "mistral", "fal", "modal", "daytona", "parallel-web", "messaging"]'
@@ -301,19 +290,8 @@ jobs:
         with:
           command: pnpm install --frozen-lockfile --filter "{./ui-tui}..." --ignore-scripts && pnpm --dir ui-tui run build
 
-      - name: Install ripgrep (prebuilt binary)
-        run: |
-          set -euo pipefail
-          RG_VERSION=15.1.0
-          RG_SHA256=1c9297be4a084eea7ecaedf93eb03d058d6faae29bbc57ecdaf5063921491599
-          RG_TARBALL=ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl.tar.gz
-          curl -sSfL --retry 3 --retry-delay 5 -o "$RG_TARBALL" \
-            "https://github.com/BurntSushi/ripgrep/releases/download/${RG_VERSION}/${RG_TARBALL}"
-          echo "${RG_SHA256}  ${RG_TARBALL}" | sha256sum -c -
-          tar -xzf "$RG_TARBALL"
-          sudo mv "ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl/rg" /usr/local/bin/rg
-          rm -rf "$RG_TARBALL" "ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl"
-          rg --version
+      - name: Verify locked ripgrep
+        run: rg --version
 
       - name: Install tmux
         # tests/e2e/core/cli_tmux and the Vertex /bg CLI suite drive real CLIs in tmux. The runner
@@ -480,25 +458,15 @@ jobs:
           fi
           git describe --tags --abbrev=0 --match 'v20[0-9][0-9].*' HEAD~1
 
-      - name: Set up Node
+      - name: Set up locked Node and ripgrep
         # `hermes update` builds the web UI / TUI workspaces.
-        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # 7.1.0
+        uses: ./.github/actions/setup-pm
         with:
-          node-version: 26
+          toolchain: node
+          packages: ripgrep
 
-      - name: Install ripgrep (prebuilt binary)
-        run: |
-          set -euo pipefail
-          RG_VERSION=15.1.0
-          RG_SHA256=1c9297be4a084eea7ecaedf93eb03d058d6faae29bbc57ecdaf5063921491599
-          RG_TARBALL=ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl.tar.gz
-          curl -sSfL --retry 3 --retry-delay 5 -o "$RG_TARBALL" \
-            "https://github.com/BurntSushi/ripgrep/releases/download/${RG_VERSION}/${RG_TARBALL}"
-          echo "${RG_SHA256}  ${RG_TARBALL}" | sha256sum -c -
-          tar -xzf "$RG_TARBALL"
-          sudo mv "ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl/rg" /usr/local/bin/rg
-          rm -rf "$RG_TARBALL" "ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl"
-          rg --version
+      - name: Verify locked ripgrep
+        run: rg --version
 
       - name: Install uv
         uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # 8.2.0
-- 
2.55.0

