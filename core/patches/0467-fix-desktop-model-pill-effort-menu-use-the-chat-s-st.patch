+        ended_at: null,
+        id: 'stored-opus',
+        input_tokens: 0,
+        is_active: false,
+        last_active: 0,
+        message_count: 4,
+        model: 'claude-opus-5-5',
+        model_provider: 'anthropic',
+        output_tokens: 0
+      } as unknown as SessionInfo
