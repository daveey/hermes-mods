From b1d198ff652b718947eadc4a192ce61c5c1cee4c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 02:05:35 +0000
Subject: [PATCH] fix(kanban): retain legacy mirror schema compatibility
 [daveey]

Public mirror of the source commit; see the accompanying feature documentation.

---
 hermes_cli/kanban_db_parent_states.py                       | 6 ++++--
 .../hermes_cli/test_kanban_containment_terminal_parents.py  | 4 ++++
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_db_parent_states.py b/hermes_cli/kanban_db_parent_states.py
index bec5c9b04d6..1ea1fe132fc 100644
--- a/hermes_cli/kanban_db_parent_states.py
+++ b/hermes_cli/kanban_db_parent_states.py
@@ -9,8 +9,10 @@ def parent_blocks(conn: sqlite3.Connection, pid: str, status: str | None) -> boo
     if status not in ("done", "archived"):
         return True
     if status == "archived":
-        row = conn.execute("SELECT containment_episode FROM tasks WHERE id=?", (pid,)).fetchone()
-        if row is not None and row[0] is not None:
+        from hermes_cli.kanban_containment_terminal import parent_status_sql
+        projected = parent_status_sql(conn)
+        row = conn.execute(f"SELECT {projected} FROM tasks WHERE id=?", (pid,)).fetchone()
+        if row is not None and row[0] != "archived":
             return True
     from hermes_cli.kanban_spend_decision import execution_restricted
     return execution_restricted(conn, pid)
diff --git a/tests/hermes_cli/test_kanban_containment_terminal_parents.py b/tests/hermes_cli/test_kanban_containment_terminal_parents.py
index 67702a0c2bd..7b61fb4707f 100644
--- a/tests/hermes_cli/test_kanban_containment_terminal_parents.py
+++ b/tests/hermes_cli/test_kanban_containment_terminal_parents.py
@@ -23,6 +23,10 @@ def test_remote_mirror_terminal_archive_does_not_satisfy(incremental, legacy, mo
                            "INSERT INTO task_links VALUES ('held','child'),('ordinary','child');")
         marker = "" if legacy else ",containment_episode TEXT"
         replica.execute(f"CREATE TABLE tasks(id TEXT PRIMARY KEY,status TEXT{marker})")
+        # Dependency reads now inspect real restriction evidence as well as status.
+        replica.execute("CREATE TABLE task_events(id INTEGER PRIMARY KEY,task_id TEXT,kind TEXT,"
+                        "payload TEXT,created_at INTEGER)")
+        replica.row_factory = sqlite3.Row
         if legacy:
             replica.execute("INSERT INTO tasks VALUES ('held','archived'),('ordinary','archived')")
         else:
-- 
2.43.0

