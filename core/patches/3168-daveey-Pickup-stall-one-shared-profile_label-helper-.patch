From 7d5208951ca6532768119b0a2e194b87644e898c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 05:47:46 +0000
Subject: [PATCH] [daveey] Pickup-stall: one shared profile_label helper for
 the Board's profile:<assignee or 'default'> rule

kanban_repin_notice.profile_label is now the single copy; required_labels,
kanban_pickup_stall._profile_label and kanban_pickup_stall_repin._need call it.
Parity test pins None/''/'x' across all three sites. Behaviour unchanged.
---
 hermes_cli/kanban_pickup_stall.py             |  6 ++--
 hermes_cli/kanban_pickup_stall_repin.py       |  3 +-
 hermes_cli/kanban_repin_notice.py             |  8 ++++-
 .../test_kanban_profile_label_parity.py       | 35 +++++++++++++++++++
 4 files changed, 47 insertions(+), 5 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_profile_label_parity.py

diff --git a/hermes_cli/kanban_pickup_stall.py b/hermes_cli/kanban_pickup_stall.py
index da3e3ff927..167fbe88f1 100644
--- a/hermes_cli/kanban_pickup_stall.py
+++ b/hermes_cli/kanban_pickup_stall.py
@@ -299,9 +299,9 @@ def _ready_now(entry: Mapping[str, Any], now_ms: int) -> bool:
 
 
 def _profile_label(assignee: Optional[str]) -> str:
-    """``profile:<assignee>``, a NULL/empty assignee read as ``default`` like the Board's ``requiredLabels`` and
-    :func:`hermes_cli.kanban_repin_notice.required_labels` (never ``profile:None`` or ``profile:``)."""
-    return f"profile:{assignee or 'default'}"
+    """:func:`hermes_cli.kanban_repin_notice.profile_label`, the Board's ``profile:<assignee or 'default'>``."""
+    from hermes_cli import kanban_repin_notice
+    return kanban_repin_notice.profile_label(assignee)
 
 
 def alarm_placement(own: str, machines: Optional[Mapping[str, Mapping[str, Any]]], *, assignee: Optional[str],
diff --git a/hermes_cli/kanban_pickup_stall_repin.py b/hermes_cli/kanban_pickup_stall_repin.py
index 2f2bcf7d73..c09b4579bd 100644
--- a/hermes_cli/kanban_pickup_stall_repin.py
+++ b/hermes_cli/kanban_pickup_stall_repin.py
@@ -141,9 +141,10 @@ def malformed_skills(target: Any) -> Optional[str]:
 
 
 def _need(target: Any) -> set:
+    from hermes_cli import kanban_repin_notice
     from hermes_cli.kanban_placement_coordination import requirement_label
     # A NULL or empty assignee runs as ``default``, as in the Board's ``requiredLabels`` (``assignee || "default"``).
-    return {requirement_label(r) for r in _requires(target)} | {f"profile:{target['assignee'] or 'default'}"}
+    return {requirement_label(r) for r in _requires(target)} | {kanban_repin_notice.profile_label(target["assignee"])}
 
 
 def _pool_need(target: Any) -> set:
diff --git a/hermes_cli/kanban_repin_notice.py b/hermes_cli/kanban_repin_notice.py
index eddefe88b8..72f2e56def 100644
--- a/hermes_cli/kanban_repin_notice.py
+++ b/hermes_cli/kanban_repin_notice.py
@@ -32,11 +32,17 @@ def _json_list(text):
     return [v for v in value if isinstance(v, str) and v] if isinstance(value, list) else []
 
 
+def profile_label(assignee):
+    """``profile:<assignee>``, a NULL/empty assignee read as ``default`` like the Board's ``requiredLabels``
+    (``assignee || "default"``): never ``profile:None`` or ``profile:``. The one copy of this rule in core."""
+    return f"profile:{assignee or 'default'}"
+
+
 def required_labels(row):
     """The labels a pool worker must attest to run this card (mirrors the Board's ``requiredLabels``)."""
     from hermes_cli.kanban_placement_coordination import requirement_label
     row = dict(row)
-    return ([f"profile:{row.get('assignee') or 'default'}"]
+    return ([profile_label(row.get("assignee"))]
             + [requirement_label(r) for r in _json_list(row.get("requires"))]
             + [f"skill:{s}" for s in _json_list(row.get("skills"))])
 
diff --git a/tests/hermes_cli/test_kanban_profile_label_parity.py b/tests/hermes_cli/test_kanban_profile_label_parity.py
new file mode 100644
index 0000000000..bc4473ad32
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_profile_label_parity.py
@@ -0,0 +1,35 @@
+"""One ``profile:<assignee>`` rule for every pool-label site, mirroring the Board's ``requiredLabels``
+(``assignee || "default"``): a NULL/empty assignee is ``profile:default``, never ``profile:None``/``profile:``. [daveey]"""
+from __future__ import annotations
+
+import pytest
+
+from hermes_cli import kanban_pickup_stall as kps
+from hermes_cli import kanban_pickup_stall_repin as rp
+from hermes_cli import kanban_repin_notice as notice
+
+CASES = [(None, "profile:default"), ("", "profile:default"), ("x", "profile:x")]
+
+
+@pytest.mark.parametrize("assignee,label", CASES)
+def test_shared_helper_reads_null_and_empty_as_default(assignee, label):
+    assert notice.profile_label(assignee) == label
+
+
+@pytest.mark.parametrize("assignee,label", CASES)
+def test_all_three_sites_agree(assignee, label):
+    row = {"assignee": assignee, "requires": None, "skills": None}
+    assert notice.required_labels(row) == [label]
+    assert rp._need(row) == {label}
+    # The hub's unreadable-registry branch returns the need set itself.
+    runs_on, _ = kps.alarm_placement(kps.OPERATOR_LANE, None, assignee=assignee, requires=())
+    assert label in runs_on
+
+
+def test_every_site_routes_through_the_shared_helper(monkeypatch):
+    monkeypatch.setattr(notice, "profile_label", lambda assignee: "profile:SENTINEL")
+    row = {"assignee": "x", "requires": None, "skills": None}
+    assert notice.required_labels(row) == ["profile:SENTINEL"]
+    assert rp._need(row) == {"profile:SENTINEL"}
+    runs_on, _ = kps.alarm_placement(kps.OPERATOR_LANE, None, assignee="x", requires=())
+    assert "profile:SENTINEL" in runs_on
-- 
