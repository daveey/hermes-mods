From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 05:46:00 +0000
Subject: [PATCH] [daveey] hub claim screen: real previous_runs_on on a deny
 move; unjudged_claims gate counts created-payload verdicts

Rebased onto #1811, which landed the per-tick judge cap, dispatch-order judging and one-tick deferral; this PR's duplicate cap is dropped.
---
 hermes_cli/kanban_hub_admission_claim.py      | 11 ++++++---
 .../test_kanban_hub_admission_claim.py        | 24 ++++++++++++++++++-
 2 files changed, 31 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_hub_admission_claim.py b/hermes_cli/kanban_hub_admission_claim.py
index a7152ca595..a2345327e3 100644
--- a/hermes_cli/kanban_hub_admission_claim.py
+++ b/hermes_cli/kanban_hub_admission_claim.py
@@ -22,7 +22,8 @@ every hub run passes, so before the hub claims a ready, label-less card with no
   would hold that tick's claims for minutes). Neither is ever claimed unjudged.
 
 A card with any verdict (forced or skipped included) makes no model call. :func:`unjudged_claims` is the
-detector: this gateway's claims of a card that had no verdict yet (``hermes doctor`` reports it on the hub).
+detector: this gateway's claims of a card that had no verdict yet (``hermes doctor`` reports it on the hub). Its
+gate (the board's first verdict) counts audits riding a ``created`` payload as well as ``hub_admission`` events.
 """
 from __future__ import annotations
 
@@ -181,9 +182,10 @@ def _apply(conn: sqlite3.Connection, own: str, tid: str, audit: dict, target: Op
         kb._append_event(conn, tid, "hub_admission", audit)
         if target is None:
             return False
+        previous = wn._parse(row["runs_on"])  # None (NULL or '') or [] ('[]'): what the card carried
         wn.set_runs_on(conn, tid, target)
         kb._append_event(conn, tid, km.MOVED_EVENT, {
-            "from_machine": own, "runs_on": target, "previous_runs_on": None,
+            "from_machine": own, "runs_on": target, "previous_runs_on": previous,
             "reason": f"hub admission denied at claim: {str(audit.get('why') or '')[:300]}",
             "move_no": len(km.history(conn, tid)) + 1, "forced": False, "matches": [], "queued": True,
             "hub_admission": audit})
@@ -205,7 +207,10 @@ def unjudged_claims(conn: sqlite3.Connection, own: str, *, now: Optional[float]
     """``[(task_id, claimed_at)]``: claims by ``own`` in the last ``window`` seconds, after the board's first
     verdict (the gate's rollout), of a card with no verdict before that claim."""
     now = time.time() if now is None else now
-    gate = conn.execute("SELECT MIN(created_at) FROM task_events WHERE kind = 'hub_admission'").fetchone()[0]
+    gate = conn.execute(  # a verdict is a hub_admission event or an audit riding a created payload
+        "SELECT MIN(t) FROM (SELECT MIN(created_at) AS t FROM task_events WHERE kind = 'hub_admission' "
+        "UNION ALL SELECT MIN(created_at) FROM task_events WHERE kind = 'created' AND json_valid(payload) "
+        "AND json_type(payload, '$.hub_admission') = 'object')").fetchone()[0]
     if gate is None:
         return []
     rows = conn.execute(
diff --git a/tests/hermes_cli/test_kanban_hub_admission_claim.py b/tests/hermes_cli/test_kanban_hub_admission_claim.py
index c5967917a3..0b2fa81b32 100644
--- a/tests/hermes_cli/test_kanban_hub_admission_claim.py
+++ b/tests/hermes_cli/test_kanban_hub_admission_claim.py
@@ -232,7 +232,9 @@ def test_an_empty_label_list_is_screened_like_no_labels(gws, hub_judge):
     hub.conn.commit()
     hub.enter()
     assert hac.screen(hub.conn).moved == 1
-    assert _events(hub.conn, tid, "moved")[0]["runs_on"][0] == POOL
+    [moved] = _events(hub.conn, tid, "moved")
+    assert moved["runs_on"][0] == POOL
+    assert moved["previous_runs_on"] == []  # the card's real prior labels, not None
 
 
 def test_screen_makes_no_model_call_inside_a_write_transaction(gws, hub_judge):
@@ -405,6 +407,26 @@ def test_unjudged_claims_accepts_a_creation_time_verdict_without_an_admission_ev
     assert [tid for tid, _at in hac.unjudged_claims(hub.conn, HUB)] == [bare]
 
 
+def test_unjudged_claims_gate_opens_on_a_creation_payload_verdict(gws):
+    """A board whose only verdicts ride ``created`` payloads (synced creations) has a live gate: a later claim of
+    an unjudged card is reported, not hidden behind a missing ``hub_admission`` event."""
+    hub, _worker, _svc = gws
+    audited = _hub_card(hub, title="admitted at creation")
+    bare = _hub_card(hub, title="never judged")
+    with kb.write_txn(hub.conn):
+        hub.conn.execute(
+            "UPDATE task_events SET payload = json_set(COALESCE(payload, '{}'), '$.hub_admission', json(?)) "
+            "WHERE task_id = ? AND kind = 'created'",
+            (json.dumps({"admit": True, "entry": "create", "why": "ok"}), audited))
+        kb._append_event(hub.conn, bare, "claimed", {"holder": HUB})
+    assert hub.conn.execute("SELECT COUNT(*) FROM task_events WHERE kind = 'hub_admission'").fetchone()[0] == 0
+    assert [tid for tid, _at in hac.unjudged_claims(hub.conn, HUB)] == [bare]
+    with kb.write_txn(hub.conn):  # a claim before that creation-time verdict predates the gate
+        hub.conn.execute("UPDATE task_events SET created_at = created_at - 60 WHERE task_id = ? AND kind = 'claimed'",
+                         (bare,))
+    assert hac.unjudged_claims(hub.conn, HUB) == []
+
+
 def test_unjudged_claims_counts_hub_claims_without_a_prior_verdict(gws, hub_judge, monkeypatch):
     hub, _worker, _svc = gws
     judged = _hub_card(hub, title="judged")
