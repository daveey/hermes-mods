From 149c5981508fa9b04100fbf4330ce475cf7dd60c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 05:34:19 +0000
Subject: [PATCH] test(kanban): isolate owner-death fixtures from pytest PID
 aliases [daveey]

The board fixture called pytest's real PID alive while assigning fixed numbers
82001..82003 to synthetic dead submitters. If pytest received one of those
numbers, _worker_alive correctly skipped that row (legacy NULL fingerprint),
leaving running/0 and returning no crashes. This is fixture identity aliasing,
not a recovery-policy bug or evidence of CPU starvation.

Default every synthetic process to dead. Opt the live-owner control into its
real owner explicitly, with a distinct synthetic worker. Exercise no-ledger
recovery with both the original fixed range and a submitter equal to pytest.
Keep all original owner_exit=pid_changed, uncounted requeue, live-owner charge,
repeat-death charging and systemic-fix ownership assertions.

Proof (HERMES_TEST_FILE_RETRIES=0, canonical scripts/run_tests.sh):
- Historical c8e642c511: unchanged file 13 passed; exact ID 1 passed.
- Historical controlled fixture getpid=82001: unchanged original test RED,
  running/0 at line 120; same probe GREEN after default-dead fixture change.
- Current main 47ecb69e49: unchanged file 13 passed; exact ID 1 passed.
- New pytest-pid regression with old fixture: 1 failed, 13 passed.
- Fixed owning file: 14 passed. Seven recovery/receipt/crash suites: 105 passed.
- scripts/check --base origin/main: all 21 checks passed using the PM test venv.

Historical attribution is bounded: run 44856234216/job 136699102591 retained
13 collected, .F..........., running/0 and a green one-ID retry, but not the
pytest PID. The controlled alias reproduces that exact symptom; it is not
proof of the historical runner's PID.

Intake occurrence 69, t_eeeeee000000003a. No production policy, thresholds,
retry counts, cadence, producer journal or frozen manifest changed.
---
 tests/hermes_cli/test_kanban_owner_death.py | 18 ++++++++++++------
 1 file changed, 12 insertions(+), 6 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_owner_death.py b/tests/hermes_cli/test_kanban_owner_death.py
index 6a7ca72389..85aa259692 100644
--- a/tests/hermes_cli/test_kanban_owner_death.py
+++ b/tests/hermes_cli/test_kanban_owner_death.py
@@ -33,8 +33,9 @@ REFUSAL = "Kanban owner refused: Gateway inaccessible: service_identity_unverifi
 def board(tmp_path, monkeypatch):
     monkeypatch.setenv("HERMES_HOME", str(tmp_path))
     monkeypatch.setenv("HERMES_KANBAN_CRASH_GRACE_SECONDS", "0")
-    me = os.getpid()
-    monkeypatch.setattr(kb, "_pid_alive", lambda pid: pid == me)  # every worker and the old owner are dead
+    # All recorded processes are synthetic and dead, even if a number aliases pytest's PID.
+    # The live-owner control opts into its real process explicitly below.
+    monkeypatch.setattr(kb, "_pid_alive", lambda pid: False)
     output = {"text": REFUSAL}
     monkeypatch.setattr(kbd, "_worker_final_output", lambda *a, **kw: output["text"])
     owner_home = tmp_path / "owner"
@@ -110,9 +111,12 @@ def test_runs_lost_to_an_unclean_owner_death_requeue_uncounted(board, monkeypatc
         assert not conn.execute("SELECT 1 FROM tasks WHERE idempotency_key LIKE 'systemic-crash:%'").fetchone()
 
 
-def test_owner_pid_gone_without_a_ledger_record_requeues_too(board, monkeypatch):
+@pytest.mark.parametrize("submitter_is_pytest", [False, True], ids=["fixed-pids", "pytest-pid"])
+def test_owner_pid_gone_without_a_ledger_record_requeues_too(board, monkeypatch, submitter_is_pytest):
     with kbc.connect() as conn:
-        pids = [82001, 82002, 82003]
+        # A CI worker can itself receive one of the fixture's fixed PID numbers.
+        first = os.getpid() if submitter_is_pytest else 82001
+        pids = [first, first + 1, first + 2]
         tids = [_claim(conn, kb.create_task(conn, title=f"card {p}", assignee="default"), p, board) for p in pids]
         _reaped(monkeypatch, pids)
         assert kbd.detect_crashed_workers(conn) == []
@@ -140,10 +144,12 @@ def test_owner_still_alive_is_not_an_owner_death(board, monkeypatch):
     # Control: the admitting owner is this live process, so the refusal is not its death.
     from hermes_cli.process_identity import worker_birth
     me = os.getpid()
+    monkeypatch.setattr(kb, "_pid_alive", lambda pid: pid == me)
+    worker_pid = me + 1  # distinct from the real owner, including on busy CI hosts
     with kbc.connect() as conn:
-        tid = _claim(conn, kb.create_task(conn, title="card", assignee="default"), 83001, board,
+        tid = _claim(conn, kb.create_task(conn, title="card", assignee="default"), worker_pid, board,
                      owner_pid=me, birth=worker_birth(psutil.Process(me)))
-        _reaped(monkeypatch, [83001])
+        _reaped(monkeypatch, [worker_pid])
         assert kbd.detect_crashed_workers(conn) == [tid]
         assert _task(conn, tid).consecutive_failures == 1
         assert "owner_restart_lost" not in _kinds(conn, tid)
