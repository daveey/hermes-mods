Subject: [PATCH 6729] Sidebar filtered project overviews, queued CI waits and retained card timers

Public mirror of source commit 434d52146c08dc6605a7a7f4c8fbaca0ec628292.

---
diff --git a/apps/desktop/src/app/chat/sidebar/session-row-timer-memory.test.ts b/apps/desktop/src/app/chat/sidebar/session-row-timer-memory.test.ts
index ed6fc0f8490a0644cf0a6c5d348dc1af5c3535c7..8627157c2169fca4ac602ef6d37640b8e5179759 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row-timer-memory.test.ts
+++ b/apps/desktop/src/app/chat/sidebar/session-row-timer-memory.test.ts
@@ -19,6 +19,46 @@
   resetRowTimersForTests()
 })
 
+it('ignores empty identities rather than retaining an anonymous clock', () => {
+  vi.useFakeTimers({ now: NOW })
+  rememberRowTimers(known({ id: '' }))
+  expect(rowTimers(unknown({ id: '' })).cards).toEqual([])
+})
+
+it('retains only running and blocked cards in the memo itself', () => {
+  vi.useFakeTimers({ now: NOW })
+  rememberRowTimers(known({ kanban_timed_cards: [
+    ...cards,
+    { id: 'blocked', title: 'Blocked', state: 'blocked', since: NOW / 1000 },
+    { id: 'waiting', title: 'Waiting', state: 'waiting', since: NOW / 1000 }
+  ] }))
+  expect(rowTimers(unknown()).cards.map(c => c.state)).toEqual(['running', 'blocked'])
+})
+
+it('known zero deletes evidence without allocating an empty retained entry', () => {
+  vi.useFakeTimers({ now: NOW })
+  rememberRowTimers(known())
+  const writes = vi.spyOn(Map.prototype, 'set')
+  rememberRowTimers(row())
+  expect(writes).not.toHaveBeenCalled()
+  expect(rowTimers(unknown()).confirmedAt).toBe(0)
+})
+
+it('fresh cards are returned directly before any confirmation effect', () => {
+  expect(rowTimers(known({ kanban_timed_more: 3 }))).toEqual({ cards, more: 3, confirmedAt: 0 })
+})
+
+it('old observations shorten retention while nonfinite observations use receipt time', () => {
+  vi.useFakeTimers({ now: NOW })
+  rememberRowTimers(known({ kanban_observed_at: NOW / 1000 - 800 }))
+  expect(rowTimers(unknown()).confirmedAt).toBe(NOW - 800_000)
+  vi.advanceTimersByTime(100_000)
+  expect(rowTimers(unknown()).cards).toEqual([])
+  rememberRowTimers(known({ kanban_observed_at: Number.NaN }))
+  expect(rowTimers(unknown()).confirmedAt).toBe(NOW + 100_000)
+  expect(rowTimers(unknown()).cards).toEqual(cards)
+})
+
 it('offline evidence arriving late cannot renew the original confirmation', () => {
   vi.useFakeTimers({ now: NOW })
   rememberRowTimers(known())
@@ -47,6 +87,13 @@
   expect(rowTimers(unknown()).cards).toEqual([])
 })
 
+it('a wall clock stepped back never extends retention', () => {
+  vi.useFakeTimers({ now: NOW })
+  rememberRowTimers(known())
+  vi.setSystemTime(NOW - 3_600_000)
+  expect(rowTimers(unknown()).cards).toEqual([])
+})
+
 it('sweeps expired entries on the next confirmation, not only at capacity', () => {
   vi.useFakeTimers({ now: NOW })
   rememberRowTimers(known({ id: 'expired' }))
diff --git a/tests/hermes_cli/test_annotation_holder_fairness.py b/tests/hermes_cli/test_annotation_holder_fairness.py
index e2dc3fdd2819eef54aae0402c35e96e55cd907c7..35e08bb745f3a49db847d1f14a935b62e32e4e57 100644
--- a/tests/hermes_cli/test_annotation_holder_fairness.py
+++ b/tests/hermes_cli/test_annotation_holder_fairness.py
@@ -97,6 +97,28 @@
     assert [scope for scope, _ctx in ordered] == list(reversed(scopes))
 
 
+def test_aged_out_demand_sorts_as_idle(monkeypatch):
+    from hermes_cli.kanban_annotation_fairness import stalest_first
+
+    scopes = [('home', name) for name in ('stale-demand', 'demanded')]
+    ages = {scopes[0]: host.DEMAND_WINDOW_S + 1, scopes[1]: 0}
+    monkeypatch.setattr(host._disk, 'demand_age', lambda scope: ages[scope])
+    monkeypatch.setattr(host._disk, 'published_read_at', lambda scope: 1 if scope == scopes[0] else 100)
+    ordered = stalest_first([(scope, contextvars.copy_context()) for scope in scopes])
+    assert [scope for scope, _ctx in ordered] == list(reversed(scopes))
+
+
+@pytest.mark.parametrize('read_at', [None, 'invalid', float('nan'), float('inf')])
+def test_idle_invalid_publication_stays_idle_and_sorts_oldest(monkeypatch, read_at):
+    from hermes_cli.kanban_annotation_fairness import stalest_first
+
+    scopes = [('home', name) for name in ('invalid-idle', 'valid-idle', 'demanded')]
+    monkeypatch.setattr(host._disk, 'demand_age', lambda scope: 0 if scope == scopes[2] else None)
+    monkeypatch.setattr(host._disk, 'published_read_at', lambda scope: read_at if scope == scopes[0] else 100)
+    ordered = stalest_first([(scope, contextvars.copy_context()) for scope in scopes])
+    assert [scope for scope, _ctx in ordered] == [scopes[2], scopes[0], scopes[1]]
+
+
 def test_gate_runs_in_scope_context(monkeypatch):
     from hermes_cli.kanban_annotation_fairness import stalest_first
 
