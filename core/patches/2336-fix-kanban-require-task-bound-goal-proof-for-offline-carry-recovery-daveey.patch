From 81002cee786a5a530ca735f4a0afb5c79a61b9ec Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 20:20:52 +0000
Subject: [PATCH] fix(kanban): require task-bound goal proof for offline carry
 recovery [daveey]

---
 hermes_cli/kanban_terminal_carry.py            | 5 ++++-
 tests/hermes_cli/test_kanban_terminal_carry.py | 9 +++++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_terminal_carry.py b/hermes_cli/kanban_terminal_carry.py
index 756f7e0872e..5f283ac9f41 100644
--- a/hermes_cli/kanban_terminal_carry.py
+++ b/hermes_cli/kanban_terminal_carry.py
@@ -85,7 +85,10 @@ def _owner_proof(path: Path, expected_hash: str, identity: dict) -> dict:
             'SELECT binding_json FROM origin_creation_intents WHERE task_id=?', (identity['id'],))] if has_intents else []
         payload = {k: identity[k] for k in ('id', 'gateway', 'profile', 'board')}
         observed = observe_owner_task(conn, {**payload, 'status': row['status'], 'origin_bindings': bindings}, now=0)
-        if not _verified_terminal(observed):
+        # This explicit recovery path requires task-bound goal proof even on
+        # boards where ordinary legacy projection predates judge receipts.
+        if (not _verified_terminal(observed)
+                or (row['goal_mode'] and observed['origin_observation'].get('basis') == 'legacy_completed')):
             raise ValueError('terminal_carry_completion_unverified')
         run = conn.execute('SELECT profile FROM task_runs WHERE task_id=? ORDER BY id DESC LIMIT 1',
                            (identity['id'],)).fetchone()
diff --git a/tests/hermes_cli/test_kanban_terminal_carry.py b/tests/hermes_cli/test_kanban_terminal_carry.py
index 0994274ea27..3e9cc5ec72d 100644
--- a/tests/hermes_cli/test_kanban_terminal_carry.py
+++ b/tests/hermes_cli/test_kanban_terminal_carry.py
@@ -218,6 +218,15 @@ def test_board_path_traversal_refused(world):
         register(world, card=card)
 
 
+def test_receiptless_goal_mode_never_uses_other_tasks_judge_epoch(world):
+    for path in (world['owner'], world['replica']):
+        edit(path, 'UPDATE tasks SET goal_mode=1')
+        edit(path, "INSERT INTO task_events VALUES(1000,'other_task',8,'goal_verified',200,'{}','unrelated-judge')")
+    with pytest.raises(ValueError, match='completion_unverified'):
+        register(world)
+    assert not world['receipt'].exists()
+
+
 def test_standard_reconciler_captures_release_and_restores_on_reopen(world, monkeypatch):
     from hermes_cli import kanban_db_connect as kbc, kanban_chat_links as links
     from hermes_cli import kanban_sync_client as sync, kanban_session_activity as activity
