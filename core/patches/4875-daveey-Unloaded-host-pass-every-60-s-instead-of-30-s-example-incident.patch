From 18e237e450cb217a346c696dec179a70ce73d5e3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 20:11:50 +0000
Subject: [PATCH] [daveey] Unloaded host pass every 60 s instead of 30 s
 (t_48c41072e7cba68d)

---
 tests/tui_gateway/test_kanban_unloaded_host_lease.py | 8 ++++++++
 tui_gateway/kanban_unloaded.py                       | 2 +-
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_kanban_unloaded_host_lease.py b/tests/tui_gateway/test_kanban_unloaded_host_lease.py
index bd17eb2eba0bba1355cc3449dbe0b41eeda75fe4..3be5e2539c12a34f8a7f9a162991d2e02a202147 100644
--- a/tests/tui_gateway/test_kanban_unloaded_host_lease.py
+++ b/tests/tui_gateway/test_kanban_unloaded_host_lease.py
@@ -490,3 +490,11 @@ def test_notice_fanout_state_a_non_sqlite_error_mid_transaction_leaves_no_open_w
         assert nfs.load_remote() == {"chat": frozenset({("k", "done")})}
     finally:
         nfs.reset_for_tests()
+
+
+def test_host_pass_cadence_is_sixty_seconds_and_grace_unchanged(monkeypatch):
+    """t_48c41072e7cba68d: the hub host pass runs every 60 s (halves fixed per-pass CPU); the notice grace stays 30 s."""
+    monkeypatch.delenv("HERMES_KANBAN_UNLOADED_SWEEP_S", raising=False)
+    assert ku.INTERVAL_S == 60.0
+    assert ku.GRACE_S == 30.0
+    assert ku.make_lease().interval == 60.0
diff --git a/tui_gateway/kanban_unloaded.py b/tui_gateway/kanban_unloaded.py
index 4061c769ea31b0ea8022298f5a6c356129a38be5..f9fcdc2cf4f13fa1894176a53c9e6e6ef7b9292f 100644
--- a/tui_gateway/kanban_unloaded.py
+++ b/tui_gateway/kanban_unloaded.py
@@ -64,7 +64,7 @@ from hermes_cli import loop_accounting as _la
 logger = logging.getLogger(__name__)
 
 GRACE_S = 30.0
-INTERVAL_S = 30.0
+INTERVAL_S = 60.0  # [daveey] t_48c41072e7cba68d: halves fixed per-pass host_pass CPU (David-delegated cadence change)
 FIRST_RUN_DELAY_S = 20.0
 LEASE_NAME = "kanban-unloaded"
 
-- 
