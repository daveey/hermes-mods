Subject: [PATCH 6544] Release mandate and typed stop recovery

Public mirror of source commit ed17c2b5e83d058b6be4fc78c0ec5db3b841a5ea.

---
diff --git a/hermes_cli/kanban_stop_recovery.py b/hermes_cli/kanban_stop_recovery.py
index a5add83b557..dec51a298e8 100644
--- a/hermes_cli/kanban_stop_recovery.py
+++ b/hermes_cli/kanban_stop_recovery.py
@@ -44,17 +44,20 @@
             'recheck the existing spend window before changing any budget.')
     else:
         operation, instruction = 'inspect_stop', 'Read the exact current stop and restrictions before choosing recovery.'
+    from hermes_cli.kanban_hold_audience import describe as authority
     return {'version': 1, 'stop': evidence, 'next_operation': operation, 'instruction': instruction,
+            'recorded_authority': authority(conn, task_id),
             'expected_actor': ['owning_chat', 'authorized_operator'], 'authorization': 'not_granted'}
 
 
 def refusal_context(conn, task_id: str) -> tuple[dict, str]:
     """Structured and rendered advice for a refused release; no writes, grants or identity assertions."""
+    from hermes_cli.kanban_hold_audience import guidance
     recovery = describe(conn, task_id)
     stop = recovery['stop']
     cause = str(stop['cause']) if stop else 'no pending stop'
     text = (f" Current stop: {cause}; next guarded candidate: {recovery['next_operation']}. "
-            + recovery['instruction']
+            + recovery['instruction'] + ' ' + guidance(recovery['recorded_authority'])
             + ' Expected actor: the owning chat or an authorized operator, subject to that operation\'s guards. '
             'run_in_user_terminal remains agent-origin; opening a terminal or confirming its command is not '
             'human authentication. Use the original owning chat on its authenticated gateway, not an SSH '
diff --git a/tests/hermes_cli/test_kanban_stop_recovery.py b/tests/hermes_cli/test_kanban_stop_recovery.py
index a2e5ac22196..90eb03b7855 100644
--- a/tests/hermes_cli/test_kanban_stop_recovery.py
+++ b/tests/hermes_cli/test_kanban_stop_recovery.py
@@ -76,6 +76,19 @@
     assert recovery.describe(board, tid)['next_operation'] == 'promote'
 
 
+def test_refusal_names_fully_qualified_recorded_owner_not_observers(board):
+    tid = capability_stop(board)
+    scope.link(board, tid, gateway='owner-gateway', profile='default')
+    scope.link(board, tid, gateway='other-gateway', session='observer', kind='shepherd')
+    scope.link(board, tid, gateway='released-gateway', session='released', released=1)
+    out = refused(board, tid)
+    assert out['recovery']['recorded_authority']['chats'] == [
+        {'gateway': 'owner-gateway', 'profile': 'default', 'session': scope.CHAT}]
+    assert f'@session:default@owner-gateway/{scope.CHAT}' in out['message']
+    assert '@session:default@other-gateway/observer' not in out['message']
+    assert '@session:default@released-gateway/released' not in out['message']
+
+
 def test_malformed_stop_never_advises_ordinary_promote(board):
     from hermes_cli import kanban_stop_recovery as recovery
     tid = capability_stop(board)
