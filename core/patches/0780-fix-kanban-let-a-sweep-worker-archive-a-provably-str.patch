     if was_running:
         termination = _terminate_reclaimed_worker(prev_pid, prev_lock, signal_fn=signal_fn, started_at=prev_started)
         with write_txn(conn):
diff --git a/tests/tools/test_kanban_stranded_archive.py b/tests/tools/test_kanban_stranded_archive.py
new file mode 100644
index 0000000000..120fc721e0
--- /dev/null
+++ b/tests/tools/test_kanban_stranded_archive.py
@@ -0,0 +1,150 @@
+"""A sweep worker may archive a foreign card that is provably stranded. [daveey]
+
+A card pinned ``runs_on=[machine:<m>]`` to a machine that does not advertise pickup is never
+claimed. Once a sweep has re-filed it on that machine (and said so in a comment), no worker could
+archive the dead copy: the archive scope only lets the creator's task do it, and the creator may
+be done. The stranded case: ``ready``, never claimed, every ``machine:`` label names a machine
+``placement_runs_on`` refuses today, and a comment names the re-filed copy. Everything else is
+refused as before.
+"""
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_sync as sync
+from hermes_cli import kanban_sync_client as ksc
+from hermes_cli import kanban_worker_node as wn
+from hermes_cli.kanban_db_connect import connect
+
+MACHINES = [
+    {"name": "hub", "state": "active", "labels": ["linux"]},
+    {"name": "macbook", "state": "active", "labels": ["macos"], "pinned_only": True},  # no pickup
+    {"name": "worker-1", "state": "active", "labels": ["linux"], "pickup": "all"},
+]
+REFILED = "t_0123456789abcdef"
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    (home / "config.yaml").write_text("kanban:\n  sync:\n    enabled: true\n")
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HOME", str(tmp_path))
+    db = home / "kanban.db"
+    conn = connect(db)
+    ksc.ensure_identity(conn, "default", "hub")
+    sync.set_mode(conn, "primary")
+    wn.set_registry_fetch(lambda: {"me": "hub", "machines": MACHINES})
+    sweeper = kb.create_task(conn, title="sweeper")
+    monkeypatch.setenv("HERMES_KANBAN_DB", str(db))
+    monkeypatch.setenv("HERMES_KANBAN_BOARD", "default")
+    monkeypatch.setenv("HERMES_KANBAN_TASK", sweeper)
+    monkeypatch.setenv("HERMES_KANBAN_RUN_ID", "1")
+    monkeypatch.delenv("HERMES_DELEGATED_CHILD_CONTEXT", raising=False)
+    yield conn, sweeper
+    wn.set_registry_fetch(None)
+    conn.close()
+
+
+def _stranded(conn, runs_on=("machine:macbook",), comment=True):
+    other_creator = kb.create_task(conn, title="creator")
+    tid = kb.create_task(conn, title="stranded", creator_task_id=other_creator)
+    if runs_on is not None:
+        wn.set_runs_on(conn, tid, list(runs_on))
+    if comment:
+        kb.add_comment(conn, tid, "default", f"Stranded. Re-filed on macbook as {REFILED}. -- sweep")
+    assert kb.get_task(conn, tid).status == "ready"
+    return tid
+
+
+def _archive(tid):
+    from tools import kanban_tools as kt
+
+    return json.loads(kt._handle_archive({"task_id": tid}))
+
+
+def _archived_payload(conn, tid):
+    row = conn.execute("SELECT payload FROM task_events WHERE task_id = ? AND kind = 'archived' "
+                       "ORDER BY id DESC LIMIT 1", (tid,)).fetchone()
+    return json.loads(row[0]) if row and row[0] else None
+
+
+def test_sweep_worker_archives_a_provably_stranded_foreign_card(board):
+    conn, sweeper = board
+    tid = _stranded(conn)
+    out = _archive(tid)
+    assert out.get("ok") and out["task_id"] == tid, out
+    assert kb.get_task(conn, tid).status == "archived"
+    assert _archived_payload(conn, tid)["via"] == f"stranded-runs_on sweep by {sweeper}"
+
+
+def test_cli_archive_of_a_stranded_card_records_the_sweep(board, capsys):
+    from hermes_cli.kanban import _cmd_archive
+
+    conn, sweeper = board
+    tid = _stranded(conn)
+    assert _cmd_archive(SimpleNamespace(task_ids=[tid], purge_ids=[])) == 0, capsys.readouterr().err
+    assert kb.get_task(conn, tid).status == "archived"
+    assert _archived_payload(conn, tid)["via"] == f"stranded-runs_on sweep by {sweeper}"
+
+
+def test_stranded_card_with_a_claimed_event_is_refused(board):
+    conn, sweeper = board
+    tid = _stranded(conn)
+    with kb.write_txn(conn):
+        kb._append_event(conn, tid, "claimed", {"lock": "x"})
+    out = _archive(tid)
+    assert out.get("ok") is not True and sweeper in out["error"], out
+    assert kb.get_task(conn, tid).status == "ready"
+
+
+def test_running_stranded_card_is_refused(board):
+    conn, _ = board
+    tid = _stranded(conn)
+    conn.execute("UPDATE tasks SET status = 'running' WHERE id = ?", (tid,))
+    conn.commit()
+    out = _archive(tid)
+    assert out.get("ok") is not True, out
+    assert kb.get_task(conn, tid).status == "running"
+
+
+def test_card_for_a_machine_that_advertises_pickup_is_refused(board):
+    conn, _ = board
+    tid = _stranded(conn, runs_on=("machine:worker-1",))
+    out = _archive(tid)
+    assert out.get("ok") is not True, out
+    assert kb.get_task(conn, tid).status == "ready"
+
+
+def test_card_without_runs_on_is_refused(board):
+    conn, _ = board
+    tid = _stranded(conn, runs_on=None)
+    out = _archive(tid)
+    assert out.get("ok") is not True, out
+    assert kb.get_task(conn, tid).status == "ready"
+
+
+def test_stranded_card_without_a_refiled_comment_is_refused(board):
+    conn, _ = board
+    tid = _stranded(conn, comment=False)
+    out = _archive(tid)
+    assert out.get("ok") is not True, out
+    assert kb.get_task(conn, tid).status == "ready"
+
+
+def test_card_is_refused_when_the_machine_registry_is_unreachable(board):
+    conn, _ = board
+    tid = _stranded(conn)
+
+    def _down():
+        raise OSError("registry down")
+
+    wn.set_registry_fetch(_down)
+    out = _archive(tid)
+    assert out.get("ok") is not True, out
+    assert kb.get_task(conn, tid).status == "ready"
