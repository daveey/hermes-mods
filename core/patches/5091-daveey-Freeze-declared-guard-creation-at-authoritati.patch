diff --git a/tests/hermes_cli/test_kanban_selfwork_guard_entry.py b/tests/hermes_cli/test_kanban_selfwork_guard_entry.py
new file mode 100644
index 0000000000..1f120de115
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_selfwork_guard_entry.py
@@ -0,0 +1,40 @@
+"""Authenticated CLI and tool intake both enforce the authority's freeze."""
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli import config
+from hermes_cli.kanban_selfwork_receiver import receive
+from tests.hermes_cli import test_kanban_selfwork_nochat as support
+from tests.hermes_cli import test_kanban_selfwork_guards as guards
+
+world = support.world
+request_envelope = support.request_envelope
+
+
+@pytest.mark.parametrize('surface', ['cli', 'tool'])
+@pytest.mark.parametrize('mode', ['refuse', 'append', 'off', 'non-guard'])
+def test_guard_policy_at_entry(request_envelope, monkeypatch, capsys, surface, mode, caplog):
+    original = config.load_config
+    def configured(*args, **kwargs):
+        value = original(*args, **kwargs)
+        value['kanban']['self_work']['freeze_guards'] = mode != 'off'
+        return value
+    monkeypatch.setattr(config, 'load_config', configured)
+    request_envelope['args']['create']['self_work']['kind'] = 'sweep' if mode == 'non-guard' else 'guard'
+    with kbc.connect_closing() as conn:
+        tid = guards.seed(conn) if mode == 'append' else None
+    with caplog.at_level('INFO'):
+        result = (support.invoke(request_envelope, monkeypatch, capsys) if surface == 'cli'
+                  else receive(request_envelope))
+    with kbc.connect_closing() as conn:
+        if mode == 'refuse':
+            assert result['status'] == 'rejected', result
+            assert not kb.list_tasks(conn)
+        elif mode == 'append':
+            assert result['disposition'] == 'append', result
+            assert result['task_id'] == tid
+            assert len(kb.list_comments(conn, tid)) == 1
+            assert len(kb.list_tasks(conn)) == 1
+        else:
+            assert result.get('created') is True, result
+    assert len([r for r in caplog.records if 'guard creation frozen' in r.message]) == (mode in {'refuse', 'append'})
diff --git a/tests/hermes_cli/test_kanban_selfwork_guards.py b/tests/hermes_cli/test_kanban_selfwork_guards.py
new file mode 100644
index 0000000000..bd7fc23ebb
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_selfwork_guards.py
@@ -0,0 +1,105 @@
+"""Guard freezing acts only at intake, before generic area batching."""
+import logging
+
+import pytest
+
+from hermes_cli import config, kanban_db as kb, kanban_selfwork as policy
+from hermes_cli import kanban_selfwork_intake as intake
+from tests.hermes_cli import test_kanban_selfwork as support
+
+board = support.board
+
+
+@pytest.fixture
+def settings(monkeypatch):
+    value = {'kanban': {'self_work': {}}}
+    monkeypatch.setattr(config, 'load_config', lambda: value)
+    return value['kanban']['self_work']
+
+
+def admit(conn, request='guard-request-001', **options):
+    return intake.admit(conn, request_id=request, authority='home', local_gateway='home', now=1794690000,
+                        options={'title': 'Guard finding', 'self_work': support.declaration('guard'), **options})
+
+
+def seed(conn, **changes):
+    tid = kb.create_task(conn, title='Existing owner', tenant=changes.pop('tenant', None))
+    policy.record(conn, tid, support.declaration(changes.pop('kind', 'guard'), **changes), day='2020-01-01')
+    return tid
+
+
+def test_default_freeze_refuses_without_owner(board, settings, caplog):
+    with caplog.at_level(logging.INFO), pytest.raises(policy.SelfWorkError, match='freeze_guards'):
+        admit(board)
+    assert not kb.list_tasks(board)
+    assert len([r for r in caplog.records if 'guard creation frozen' in r.message]) == 1
+
+
+def test_append_old_guard_and_replay_once(board, settings, caplog):
+    tid = seed(board)
+    before = kb.get_task(board, tid)
+    with caplog.at_level(logging.INFO):
+        result = admit(board)
+        replay = admit(board)
+    assert result['disposition'] == 'append' and result['task_id'] == tid
+    assert replay['replayed'] is True
+    assert len(kb.list_comments(board, tid)) == 1
+    assert kb.get_task(board, tid).status == before.status
+    assert len([r for r in caplog.records if 'guard creation frozen' in r.message]) == 1
+
+
+@pytest.mark.parametrize('change', [{'kind': 'sweep'}, {'area': 'other'}, {'repository': 'hermes-state'},
+                                     {'tenant': 'other'}])
+def test_wrong_owner_cannot_receive_guard(board, settings, change):
+    seed(board, **change)
+    with pytest.raises(policy.SelfWorkError, match='freeze_guards'):
+        admit(board)
+    assert len(kb.list_tasks(board)) == 1
+
+
+@pytest.mark.parametrize('status', ['done', 'archived'])
+def test_closed_guards_not_reused(board, settings, status):
+    tid = seed(board)
+    board.execute('UPDATE tasks SET status=? WHERE id=?', (status, tid))
+    board.commit()
+    with pytest.raises(policy.SelfWorkError, match='freeze_guards'):
+        admit(board)
+
+
+def test_off_allows_create_and_existing_replay_after_freeze(board, settings):
+    settings['freeze_guards'] = False
+    first = admit(board)
+    assert first['created'] is True
+    settings['freeze_guards'] = True
+    assert admit(board)['replayed'] is True
+
+
+@pytest.mark.parametrize('kind', sorted(policy.KINDS - {'guard'}))
+def test_other_kinds_unchanged(board, settings, kind):
+    assert admit(board, self_work=support.declaration(kind))['created'] is True
+
+
+def test_product_unchanged(board, settings):
+    tid = kb.create_task(board, title='Product lifecycle guard')
+    assert policy.declared(board, tid) is None
+
+
+@pytest.mark.parametrize('owner', [False, True])
+def test_append_probe_agrees(board, settings, owner):
+    tid = seed(board) if owner else None
+    options = {'title': 'Guard finding', 'self_work': support.declaration('guard')}
+    def call():
+        return intake.append_existing(board, request_id='guard-probe-001', authority='home',
+                                      options=options, request=options, now=1794690000)
+    if owner:
+        assert call()['task_id'] == tid
+    else:
+        with pytest.raises(policy.SelfWorkError, match='freeze_guards'):
+            call()
+
+
+@pytest.mark.parametrize('bad', [None, 0, 'false', [], {}])
+def test_malformed_switch_does_not_unfreeze(board, settings, bad):
+    settings['freeze_guards'] = bad
+    with pytest.raises(policy.SelfWorkError, match='freeze_guards'):
+        admit(board)
diff --git a/website/docs/user-guide/configuration.md b/website/docs/user-guide/configuration.md
index 9b883c84a3..c764bd373e 100644
--- a/website/docs/user-guide/configuration.md
+++ b/website/docs/user-guide/configuration.md
@@ -3601,6 +3601,15 @@ dashboard:
 
 ## Hermes self-work spot checks
 
+`kanban.self_work.freeze_guards` defaults to `true`. At authoritative intake,
+explicit `self_work.kind: guard` requests append evidence to the oldest open guard
+owner in the same repository, area and tenant, even across UTC days. If none exists,
+creation is refused. Each new attempt logs one line; replayed receipts do not append
+again. Existing guards keep running. Set the key to `false` to restore ordinary
+area/day batching and creation. This switch does not infer guard work from titles:
+undeclared cards and other maintenance kinds are unaffected. Configure it at the
+intake authority; a sender cannot override it in a creation request.
+
 `kanban.self_work.sample_rate` sets the fraction of ordinary merged Hermes fixes
 selected for post-merge verification (default `0.2`). Set it to `1.0` to restore
 100% selection, or `0.0` to select only mandatory checks. Values must be finite
-- 
