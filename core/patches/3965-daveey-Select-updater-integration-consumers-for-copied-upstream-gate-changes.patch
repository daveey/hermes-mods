From 86ff23a411ed025eaecf1bae55c812aa94b5a78a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 23:44:24 +0000
Subject: [PATCH] [daveey] Select updater integration consumers for copied
 upstream gate changes

The AST graph cannot see FakeFork copying upstream_sync*.py into clones and launching subprocesses. Seed the fixture helper as a dependency root, retaining transitive consumers and suite filtering, including deleted and renamed gate paths.

Proof: selector regressions RED 6 failed/35 passed before fix; GREEN selector plus both updater integration suites 51 passed. Five mutants killed: omitted edge, facade-only, wrong directory, any extension, lost transitivity. scripts/check --base origin/main: 20 checks OK. No production updater or fixture behavior changed.
---
 scripts/ci/affected_tests.py    |  6 +++++
 tests/ci/test_affected_tests.py | 46 +++++++++++++++++++++++++++++++++
 2 files changed, 52 insertions(+)

diff --git a/scripts/ci/affected_tests.py b/scripts/ci/affected_tests.py
index 245a7e3805..742cf5a095 100755
--- a/scripts/ci/affected_tests.py
+++ b/scripts/ci/affected_tests.py
@@ -171,6 +171,12 @@ def plan(repo: Path, changed: list[str], full_reason: str | None = None) -> dict
     in_suite = set(universe)
     selected = {c for c in changed if c in in_suite}
     changed_modules = {m for c in changed if not c.startswith("tests/") and (m := module_name(c))}
+    # FakeFork copies upstream_sync*.py into fixture clones and executes the gate
+    # in a subprocess. AST imports cannot see that edge; seed its helper so all
+    # current/future consumers (including indirect imports) join the closure.
+    # Match changed paths, not existing files: deletions and renames count too.
+    if any(re.fullmatch(r"scripts/ci/upstream_sync[^/]*\.py", c) for c in changed):
+        changed_modules.add("tests.hermes_cli.upstream_gate_fake")
     selected |= importers(repo, changed_modules) & in_suite
     string_refs = [re.compile(rf"[\"']{re.escape(m)}([\"']|\.)") for m in changed_modules]
     path_refs = [re.escape(c) for c in changed if "/" in c and Path(c).name not in GENERIC]
diff --git a/tests/ci/test_affected_tests.py b/tests/ci/test_affected_tests.py
index ace6b7d278..cb0acc616f 100644
--- a/tests/ci/test_affected_tests.py
+++ b/tests/ci/test_affected_tests.py
@@ -80,6 +80,52 @@ def test_transitive_and_function_level_importers_run(repo):
     assert "tests/pkg/test_other.py" not in _files(repo, ["pkg/core.py"])
 
 
+@pytest.fixture
+def gate_repo(repo):
+    # The gate is copied/spawned, not imported. Consumers only import the fake.
+    _write(repo, {
+        "tests/hermes_cli/upstream_gate_fake.py": "class FakeFork: pass\n",
+        "tests/hermes_cli/gate_adapter.py": "from .upstream_gate_fake import FakeFork\n",
+        "tests/hermes_cli/test_direct.py": "from tests.hermes_cli.upstream_gate_fake import FakeFork\n",
+        "tests/hermes_cli/test_indirect.py": "from tests.hermes_cli.gate_adapter import FakeFork\n",
+        "tests/e2e/test_gate.py": "from tests.hermes_cli.upstream_gate_fake import FakeFork\n",
+    })
+    subprocess.run(["git", "-C", str(repo), "add", "-A"], check=True)
+    return repo
+
+
+@pytest.mark.parametrize("changed", [
+    "scripts/ci/upstream_sync.py",
+    "scripts/ci/upstream_sync_identity.py",
+    "scripts/ci/upstream_sync_future.py",  # also covers deleted/untracked gate siblings
+    "scripts/ci/upstream_sync_old.py\tscripts/ci/renamed_gate.py",
+    "scripts/ci/renamed_gate.py\tscripts/ci/upstream_sync_new.py",
+])
+def test_copied_gate_selects_direct_and_transitive_consumers(gate_repo, tmp_path, changed):
+    files_out = tmp_path / "gate-files.txt"
+    assert at.main(["--repo", str(gate_repo), "--changed", changed,
+                    "--files-out", str(files_out)]) == 0
+    assert set(files_out.read_text().splitlines()) == SMOKE | {
+        "tests/hermes_cli/test_direct.py", "tests/hermes_cli/test_indirect.py",
+    }
+
+
+@pytest.mark.parametrize("changed", [
+    "scripts/ci/other.py", "elsewhere/upstream_sync.py",
+    "scripts/ci/upstream_sync.md", "scripts/ci/upstream_sync/nested.py",
+])
+def test_unrelated_changes_do_not_select_gate_consumers(gate_repo, changed):
+    assert _files(gate_repo, [changed]) == SMOKE
+
+
+def test_real_updater_consumers_are_selected_for_gate_change():
+    selected = _files(_PATH.parents[2], ["scripts/ci/upstream_sync_identity.py"])
+    assert {
+        "tests/hermes_cli/test_update_fork_merge_upstream.py",
+        "tests/hermes_cli/test_update_fork_sync_identity.py",
+    } <= selected
+
+
 def test_string_patch_target_runs(repo):
     assert "tests/pkg/test_patch.py" in _files(repo, ["pkg/core.py"])
     assert "tests/pkg/test_patch.py" not in _files(repo, ["pkg/other.py"])
