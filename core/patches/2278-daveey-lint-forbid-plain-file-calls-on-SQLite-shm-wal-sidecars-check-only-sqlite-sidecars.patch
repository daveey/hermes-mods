+def test_a_variable_assigned_from_a_sidecar_path_is_followed():
+    src = textwrap.dedent("""\
+        wal = live.with_name(live.name + "-wal")
+        source = wal
+        if wal.exists():
+            shutil.copyfile(source, dest)
+        for shm in [p]:
+            pass
+        (a, b) = (f"{db}-shm", 1)
+        open(a)
+    """)
+    assert _load().sidecar_open_lines(src) == [4, 8]
