@@ -1,5 +1,5 @@
 import { execFile } from 'node:child_process'
-import { existsSync } from 'node:fs'
+import { existsSync, readFileSync } from 'node:fs'
 import path from 'node:path'
 import { promisify } from 'node:util'
 
@@ -30,6 +30,21 @@ export interface SourceUpdateProbe {
 const execute: typeof execFile.__promisify__ = promisify(execFile)
 
 /** The two channels a source checkout can select from Settings. */
+/** The Desktop's update-branch config (`desktop-update.json`): the chosen branch, else the default. */
+export function readDesktopUpdateConfig(
+  configPath: string,
+  defaultBranch: string
+): { branch: string; branchExplicit: boolean } {
+  try {
+    const parsed: { branch?: unknown } | null = JSON.parse(readFileSync(configPath, 'utf8'))
+    const branch: string = typeof parsed?.branch === 'string' ? parsed.branch.trim() : ''
+
+    return { branch: branch || defaultBranch, branchExplicit: branch.length > 0 }
+  } catch {
+    return { branch: defaultBranch, branchExplicit: false }
+  }
+}
+
 export function sourceChannelName(name: unknown): 'main' | 'stable' {
   if (name !== 'stable' && name !== 'main') {
     throw new Error('The update channel must be stable or main.')
diff --git a/apps/desktop/electron/updater/checkout.ts b/apps/desktop/electron/updater/checkout.ts
index 250f56f2c5..ecd22c4a97 100644
--- a/apps/desktop/electron/updater/checkout.ts
+++ b/apps/desktop/electron/updater/checkout.ts
@@ -66,6 +66,25 @@ function backupLogMessage(backup: UpdateBackupProgress): string {
   return `Backing up state.db (${backup.method}): ${gb(backup.doneBytes)} of ${gb(backup.totalBytes)} GB`
 }
 
+/**
+ * The update log's line for one progress event. Backup progress arrives twice
+ * a second for minutes and the in-memory log keeps 300 lines, so its ticks are
+ * left out: the log keeps a backup's start, its end and its check.
+ */
+export function updateProgressLogLine(merged: {
+  stage: string
+  message?: string
+  error?: string | null
+  percent?: number | null
+  backup?: UpdateBackupProgress
+}): string {
+  if (merged.stage === 'backup' && merged.backup?.phase === 'copy' && merged.percent !== 0 && merged.percent !== 100) {
+    return ''
+  }
+
+  return `[updates] ${merged.stage}: ${merged.message || merged.error || ''}`
+}
+
 /** Forward the pre-flight snapshot's reports to the update overlay as stage `backup`. */
 export function backupProgressEmitter(
   deps: Pick<CheckoutStrategyDeps, 'emitUpdateProgress'>
