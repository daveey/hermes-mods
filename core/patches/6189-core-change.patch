Subject: [PATCH 6189] Exact-request single-use self-work admission exception

Public mirror of source commit ebbe621e1c097c247cda1a1f127f3422e0253db7.

---
diff --git a/hermes_cli/kanban_card_answer_transport.py b/hermes_cli/kanban_card_answer_transport.py
index c953091303b..4cc8f07f729 100644
--- a/hermes_cli/kanban_card_answer_transport.py
+++ b/hermes_cli/kanban_card_answer_transport.py
@@ -38,8 +38,9 @@
         self._opener = urllib.request.build_opener(_NoRedirect())
 
     def read(self, request_id: str) -> dict:
+        raw = self.raw(request_id)
         try:
-            body = json.loads(self.raw(request_id))
+            body = json.loads(raw)
         except (ValueError, UnicodeError):
             raise AnswerRefused('courier_record_invalid') from None
         record = body.get('request') if isinstance(body, dict) else None
diff --git a/tests/hermes_cli/test_kanban_origin_envelope_corpus.py b/tests/hermes_cli/test_kanban_origin_envelope_corpus.py
index b7bef2d4a00..dad4583c65e 100644
--- a/tests/hermes_cli/test_kanban_origin_envelope_corpus.py
+++ b/tests/hermes_cli/test_kanban_origin_envelope_corpus.py
@@ -35,7 +35,8 @@
     # chat-bound. Freeze unrelated route/auth fixture evidence, not create data.
     request = {**world, 'args': {**world['args'], 'create': create}}
     expected = {'tool': 'kanban_create', 'args': {**create, 'board': 'default'}}
-    def capture(name, args, intent, selfwork_context=None):
+    def capture(name, args, intent, selfwork_context=None, selfwork_exception=None):
+        assert selfwork_exception is None
         assert intent['origin'] == world['args']['origin']
         return {'tool': name, 'args': args}
     monkeypatch.setattr(owner, '_dispatch_owner_tool', capture)
