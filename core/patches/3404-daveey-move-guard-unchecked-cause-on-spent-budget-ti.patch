 3 files changed, 205 insertions(+), 11 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_move_guard_review_nits.py

diff --git a/hermes_cli/kanban_move.py b/hermes_cli/kanban_move.py
index 16cebc7630..1cbc2f2690 100644
--- a/hermes_cli/kanban_move.py
+++ b/hermes_cli/kanban_move.py
@@ -30,7 +30,8 @@ Guards:
   and linked worktrees named in the body, the newest comment, the newest checkpoint or the move's own checkpoint
   (a text-named tree whose owner marker names another card is that card's work, not this one's). On 11-11 a hub
   card whose ``~/code/_wt`` trees held unpushed commits was moved to worker-2, which could not reach them and moved
-  it back. A worker-first card's Board repin to the worker queue takes the same guard. Limitations: only the host
+  it back. A worker-first card's Board repin to the worker queue takes the same guard, by the same leaving rule
+  (:func:`leaves_here`, matches from the registry). Limitations: only the host
   holding the trees can see them, so a move issued from another host is blind to them; and a move whose matches
   still include this host (``pool:worker`` issued on a pool worker, ``linux``) is not "leaving" and is not
   guarded, though another matching host may claim the card (intentional: this host may still run it).
@@ -195,13 +196,35 @@ def check(conn: sqlite3.Connection, task_id: str, runs_on: Any, *, force: bool =
     back = [m for m in matches if m in left]
     if back and len(back) == len(matches) and not force:
         raise MoveRefused("ping_pong", f"the card already left {', '.join(back)}; pass force to move it back")
-    if me not in matches:  # git reads: check() runs before every caller's write transaction
+    if leaves_here(me, matches):  # git reads: check() runs before every caller's write transaction
         if state := unpushed_here(conn, task_id, row["workspace_path"], me=me, force=force, checkpoint=checkpoint):
             host = {**host, "left_unpushed_state": state}
     return {"runs_on": labels, "previous": wn._parse(row["runs_on"]), "matches": matches, "move_no": len(past) + 1,
             "forced": bool(back and force), "me": me, "host": host}
 
 
+def leaves_here(me: str, matches: list[str]) -> bool:
+    """Whether a move leaves ``me`` (and so takes the unpushed-state guard): no machine that matches it is ``me``.
+    A running move's matches never include ``me``. The one rule :func:`check` and the worker-first repin share."""
+    return me not in matches
+
+
+def _repin_leaves(labels: list[str], me: str, machines: Optional[Mapping[str, Mapping[str, Any]]]) -> bool:
+    """:func:`leaves_here` for a worker-first Board repin, which skips :func:`check`: matches come from the
+    registry with ``me`` included (the card is queued). A repin to exactly ``machine:<me>`` stays (the origin need
+    not be registered); an unreadable registry counts as leaving, so the guard runs (fail safe)."""
+    from hermes_cli import kanban_worker_node as wn
+    if labels == [f"machine:{me}"]:
+        return False
+    pool: Mapping[str, Mapping[str, Any]] = machines or {}
+    if machines is None:
+        reg = wn.registry()
+        if reg is None:
+            return True
+        pool = reg.get("machines") or {}
+    return leaves_here(me, matching_machines(labels, pool, me=me, exclude_me=False))
+
+
 def unpushed_here(conn: sqlite3.Connection, task_id: str, workspace_path: Optional[str], *, me: str, force: bool,
                   checkpoint: Optional[str] = None) -> Optional[str]:
     """The card's unpushed state on this host (to record as ``left_unpushed_state`` under ``force``) or None;
@@ -318,7 +341,7 @@ def move_queued(conn: sqlite3.Connection, task_id: str, *, runs_on: Any, reason:
             return {"ok": False, "reason_code": "invalid_runs_on", "error": str(exc)}
         extra: dict[str, Any] = {}  # operator provenance rides a marker (kanban_operator_call), not this event
         origin = (sync.sync_state(conn) or {}).get("gateway_id")
-        if origin and list(labels or []) != [f"machine:{origin}"]:  # a repin to the worker queue leaves the origin
+        if origin and _repin_leaves(list(labels or []), str(origin), machines):  # the check() leaving rule
             row = conn.execute("SELECT workspace_path FROM tasks WHERE id = ?", (task_id,)).fetchone()
             try:
                 if state := unpushed_here(conn, task_id, row["workspace_path"] if row else None, me=str(origin),
diff --git a/hermes_cli/kanban_move_pool.py b/hermes_cli/kanban_move_pool.py
index 43a0510ae2..7aae8cb998 100644
--- a/hermes_cli/kanban_move_pool.py
+++ b/hermes_cli/kanban_move_pool.py
@@ -136,7 +136,8 @@ def pushed_on_remote(tree: str, *, deadline: Optional[float] = None) -> bool:
     branch past HEAD again. The local check then reports pushed work as unpushed, and the park pinned a card to
     its worker (11-12: t_01a1d0a1eaa00371 sat ready on ``machine:worker-2`` while worker-2 was on a Board hold).
     So ask the remote: HEAD is a remote branch tip, or a stale tracking ref HEAD builds on, once refreshed from
-    the remote, contains HEAD. Every git call ends by ``deadline`` (:func:`_clock`); past it the answer is False."""
+    the remote, contains HEAD. Every git call ends by ``deadline`` (:func:`_clock`); past it :class:`_BudgetSpent`
+    propagates, so :func:`tree_state` reports the tree as unchecked rather than unpushed."""
     from functools import partial
     from hermes_cli.worktree_ops import _git_out, _worktree_has_unpushed_commits
     # Keep credential helpers for private remotes, but never consume the caller's stdin.
@@ -212,8 +213,9 @@ def state_parts(state: str) -> tuple[str, str]:
 STATE_BUDGET_S = 20.0
 
 
-class _BudgetSpent(ValueError):
-    pass
+class _BudgetSpent(Exception):
+    """Git ran out of time for a tree. Not a ValueError: :func:`pushed_on_remote` swallows those (failing toward
+    False), which turned a spent budget into ``unpushed commits`` instead of ``unchecked worktree``."""
 
 
 def _clock() -> float:
@@ -232,20 +234,34 @@ def _within(deadline: float, cap: float, calls: int = 1) -> float:
 def tree_state(trees: Iterable[str], *, budget: float = STATE_BUDGET_S) -> Optional[str]:
     """``dirty worktree <p>`` / ``unpushed commits in <p>`` for the first tree with state, else None. Git runs at
     most ``budget`` seconds in all (per-call timeouts shrink to the time left); a tree it could not check reads
-    ``unchecked worktree <p>``, which callers treat as state (git timeouts already fail safe the same way)."""
+    ``unchecked worktree <p>``, which callers treat as state. So does a check whose git timed out (the
+    ``worktree_ops`` checks fail toward True on a timeout, which is no evidence of dirty or unpushed work)."""
     from hermes_cli.worktree_ops import _worktree_has_unpushed_commits, _worktree_is_dirty
     deadline = _clock() + budget
+
+    def found(check, calls: int) -> bool:
+        # The worktree_ops checks fail safe toward True on a git timeout: a True that took its whole timeout (or
+        # ran past the budget) is a timeout, not seen state, so it reads ``unchecked``, not ``dirty``/``unpushed``.
+        timeout, start = _within(deadline, 10, calls), _clock()
+        if not check(timeout):
+            return False
+        if _clock() - start >= timeout or _clock() >= deadline:
+            raise _BudgetSpent("git timed out")
+        return True
+
     for tree in trees:
         if not Path(tree).is_dir():
             continue
         try:
-            if _worktree_is_dirty(tree, tree, timeout=_within(deadline, 10, calls=2)):
+            if found(lambda t: _worktree_is_dirty(tree, tree, timeout=t), 2):
                 return f"{_DIRTY}{tree}"
-            if (_worktree_has_unpushed_commits(tree, timeout=_within(deadline, 10, calls=3))
+            if (found(lambda t: _worktree_has_unpushed_commits(tree, timeout=t), 3)
                     and not pushed_on_remote(tree, deadline=deadline)):
+                if _clock() >= deadline:  # its git calls failed toward False as the budget ran out
+                    raise _BudgetSpent("git budget spent")
                 return f"{_UNPUSHED}{tree}"
-        except _BudgetSpent:
-            return f"unchecked worktree {tree} (git checks of the card's trees took over {budget:g}s)"
+        except _BudgetSpent as exc:
+            return f"unchecked worktree {tree} ({exc}; git checks of the card's trees get {budget:g}s)"
     return None
 
 
diff --git a/tests/hermes_cli/test_kanban_move_guard_review_nits.py b/tests/hermes_cli/test_kanban_move_guard_review_nits.py
new file mode 100644
index 0000000000..bc8b64e1a2
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_move_guard_review_nits.py
@@ -0,0 +1,155 @@
+"""Move-guard follow-ups from PR #1792's review (5885034090, card t_01a1d2add77deeff). [daveey]
+
+1. A git budget spent inside ``pushed_on_remote``, or a git timeout in the dirty/unpushed checks, reads
+   ``unchecked worktree <p>``: neither is evidence of dirty or unpushed work.
+2. The worker-first queue repin uses ``check()``'s leaving rule: a repin whose matches include this machine is
+   not leaving, so it is not guarded.
+3. A park whose text names another card's tree does not pin this card (the ``card_trees`` owner filter).
+"""
+from __future__ import annotations
+
+import json
+import subprocess
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_sync as sync
+from hermes_cli import kanban_move as km
+from hermes_cli import kanban_move_pool as kmp
+from hermes_cli import worktree_ops
+from tests.hermes_cli import test_kanban_worker_policy_db as db_fixtures
+from tests.hermes_cli.test_kanban_move_unpushed import _commit, _git, _worktree
+from tests.hermes_cli.test_kanban_pool_queue import POOL, _placement_events, _run, _runs_on, svc, w2
+from tests.hermes_cli.test_kanban_worker_repin import NoCallHub, _acknowledged, _RecordHub
+
+conn = db_fixtures.conn
+__all__ = ["conn", "svc", "w2"]
+
+
+# --- 1: a spent budget or a git timeout reads unchecked ------------------------------------------------------------
+
+def _fake_clock(monkeypatch):
+    now = [0.0]
+    monkeypatch.setattr(kmp, "_clock", lambda: now[0])
+    return now
+
+
+def test_a_budget_spent_inside_pushed_on_remote_reads_unchecked(tmp_path, monkeypatch):
+    tree = _worktree(tmp_path, "budget-remote")
+    _commit(tree, "b.txt")  # unpushed locally: pushed_on_remote asks the remote
+    now, real = _fake_clock(monkeypatch), worktree_ops._git_out
+
+    def slow_remote(args, cwd, **kwargs):
+        if args[0] == "ls-remote":
+            now[0] += 60  # the remote answers after the whole budget is gone
+        return real(args, cwd, **kwargs)
+
+    monkeypatch.setattr(worktree_ops, "_git_out", slow_remote)
+    state = kmp.tree_state([str(tree)])
+    assert state is not None and state.startswith(f"unchecked worktree {tree}"), state
+
+
+def test_a_remote_timeout_that_spends_the_budget_reads_unchecked(tmp_path, monkeypatch):
+    tree = _worktree(tmp_path, "budget-timeout")
+    _commit(tree, "b.txt")
+    now, real = _fake_clock(monkeypatch), worktree_ops._git_out
+
+    def timing_out(args, cwd, timeout=10, **kwargs):
+        if args[0] == "ls-remote":
+            now[0] += timeout + 30
+            raise subprocess.TimeoutExpired(["git", *args], timeout)
+        return real(args, cwd, timeout=timeout, **kwargs)
+
+    monkeypatch.setattr(worktree_ops, "_git_out", timing_out)
+    assert kmp.tree_state([str(tree)]).startswith(f"unchecked worktree {tree}")
+
+
+def test_a_git_timeout_in_the_dirty_check_reads_unchecked_not_dirty(tmp_path, monkeypatch):
+    tree = _worktree(tmp_path, "dirty-timeout")
+    now, real = _fake_clock(monkeypatch), worktree_ops._git
+
+    def timing_out(args, cwd, timeout=10, **kwargs):
+        if args[0] == "status":
+            now[0] += timeout
+            raise subprocess.TimeoutExpired(["git", *args], timeout)
+        return real(args, cwd, timeout=timeout, **kwargs)
+
+    monkeypatch.setattr(worktree_ops, "_git", timing_out)
+    assert kmp.tree_state([str(tree)]).startswith(f"unchecked worktree {tree}")
+
+
+def test_seen_state_within_the_budget_keeps_its_cause(tmp_path):
+    tree = _worktree(tmp_path, "seen")
+    _commit(tree, "b.txt")
+    assert kmp.tree_state([str(tree)]) == f"unpushed commits in {tree}"
+    (tree / "wip.txt").write_text("wip\n")
+    assert kmp.tree_state([str(tree)]) == f"dirty worktree {tree}"
+
+
+# --- 2: the queue repin's leaving rule is check()'s ---------------------------------------------------------------
+
+def _registry(monkeypatch, machines):
+    from hermes_cli import kanban_worker_node as wn
+    monkeypatch.setattr(wn, "registry", lambda **kw: {"machines": machines})
+
+
+def _unpushed_worker_first_card(conn, tmp_path, monkeypatch, slug):
+    from pathlib import Path
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    tid = _acknowledged(conn, started_at=1)
+    tree = _worktree(tmp_path, slug, owner=tid)
+    _commit(tree, "b.txt")
+    return tid, tree
+
+
+def test_a_queue_repin_whose_matches_include_this_machine_is_unguarded(conn, tmp_path, monkeypatch):
+    origin = sync.sync_state(conn)["gateway_id"]
+    _registry(monkeypatch, {"worker-1": {"labels": [POOL]}, origin: {"labels": [POOL]}})
+    tid, _tree = _unpushed_worker_first_card(conn, tmp_path, monkeypatch, "repin-stays")
+    assert not km.leaves_here(origin, km.matching_machines([POOL], {origin: {"labels": [POOL]}}, me=origin,
+                                                           exclude_me=False))  # check()'s rule says: not leaving
+    hub = _RecordHub()
+    km.move_queued(conn, tid, runs_on=[POOL], reason="any worker, this one included", hub=hub)
+    assert [c["runs_on"] for c in hub.calls] == [[POOL]]  # reached the Board: no unpushed_state_here
+
+
+def test_a_queue_repin_that_leaves_this_machine_stays_guarded(conn, tmp_path, monkeypatch):
+    _registry(monkeypatch, {"worker-1": {"labels": [POOL]}})
+    tid, tree = _unpushed_worker_first_card(conn, tmp_path, monkeypatch, "repin-leaves")
+    res = km.move_queued(conn, tid, runs_on=[POOL], reason="any worker", hub=NoCallHub())
+    assert res["reason_code"] == "unpushed_state_here" and str(tree.resolve()) in res["error"], res
+
+
+def test_an_unreadable_registry_counts_the_queue_repin_as_leaving(conn, tmp_path, monkeypatch):
+    from hermes_cli import kanban_worker_node as wn
+    origin = sync.sync_state(conn)["gateway_id"]
+    monkeypatch.setattr(wn, "registry", lambda **kw: None)
+    assert km._repin_leaves([POOL], origin, None)
+    assert not km._repin_leaves([f"machine:{origin}"], origin, None)
+
+
+# --- 3: park pins follow the card_trees owner filter --------------------------------------------------------------
+
+def _park(kt, text):
+    return json.loads(kt._handle_block({"kind": "time", "clock_only": True, "reason": (
+        f"SCHEDULED_UNTIL=2099-01-01T00:00:00Z {text}")}))
+
+
+@pytest.mark.parametrize("owner", ["other", "self"])
+def test_a_park_naming_a_tree_pins_only_when_the_tree_is_this_cards(w2, tmp_path, monkeypatch, owner):
+    from tools import kanban_tools as kt
+    conn = w2.conn
+    impl = kb.create_task(conn, title="implementer", assignee="default", runs_on=[POOL])
+    tid = kb.create_task(conn, title="reviewer", assignee="default", runs_on=[POOL])
+    tree = _worktree(tmp_path, f"park-{owner}", owner=impl if owner == "other" else tid)
+    _commit(tree, "b.txt")  # unpushed commits in the named tree
+    _run(w2, monkeypatch, tid)
+    # UNPUBLISHED_WORK_REASON: the separate unpublished-workspace park guard would refuse first; this is the pin path.
+    out = _park(kt, f"waiting on CI for the head in {tree}.\nUNPUBLISHED_WORK_REASON=fixture tree")
+    assert out.get("ok"), out
+    if owner == "other":  # the implementer's state: its own park pins it, not this reviewer's
+        assert _runs_on(conn, tid) == [POOL] and _placement_events(conn, tid) == []
+    else:
+        assert _runs_on(conn, tid) == ["machine:worker-2"]
+        assert _placement_events(conn, tid)[-1][1]["unpushed_state"] == f"unpushed commits in {tree.resolve()}"
-- 
