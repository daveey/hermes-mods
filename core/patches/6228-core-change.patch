diff --git a/hermes_cli/kanban_annotation_host.py b/hermes_cli/kanban_annotation_host.py
index d6e59e4ab33..0c204c3ca81 100644
--- a/hermes_cli/kanban_annotation_host.py
+++ b/hermes_cli/kanban_annotation_host.py
@@ -360,12 +360,12 @@
     attention, frozen. Every helper is looked up on that module (tests replace them there)."""
     from hermes_cli import kanban_session_activity as _ksa
 
-    snapshot = _ksa._all_counts(include_snapshot=True)
+    snapshot = _parts.measured(_parts.COUNTS, lambda: _ksa._all_counts(include_snapshot=True))
     active, blocked, unseen, remote_stale, waiting, parked, held, stalled, remote_keys = snapshot[:9]
     execution = getattr(snapshot, "execution", {})
-    extra = _ksa._extra_waiting()
+    extra = _parts.measured("waiting", _ksa._extra_waiting)
     try:
-        attention = _ksa.attention_task_counts()
+        attention = _parts.measured(_parts.ATTENTION, _ksa.attention_task_counts)
     except Exception:
         log.debug("kanban attention unavailable", exc_info=True)
         attention = {}
diff --git a/hermes_cli/kanban_annotation_parts.py b/hermes_cli/kanban_annotation_parts.py
index 6d27ce48f7b..0ee0505e185 100644
--- a/hermes_cli/kanban_annotation_parts.py
+++ b/hermes_cli/kanban_annotation_parts.py
@@ -152,5 +152,19 @@
     _seen.pop(scope, None)
 
 
+def measured(part: str, read):
+    """Account inclusive part CPU without changing its cache policy or exception behavior.
+
+    ``served`` means cache-eligible, NOT a cache hit: TTL expiry can still read. Counts includes its nested
+    links work; do not add those counters together. Waiting sources have no force gate yet.
+    """
+    from hermes_cli import kanban_session_activity as ksa
+    from hermes_cli import loop_accounting as la
+
+    mode = "forced" if ksa._revalidate.forced(ksa._origin_scope(), part) else "served"
+    with la.pass_(f"annotation.part.{part}.{mode}"):
+        return read()
+
+
 def reset() -> None:
     _seen.clear()
diff --git a/tests/hermes_cli/test_kanban_annotation_part_accounting.py b/tests/hermes_cli/test_kanban_annotation_part_accounting.py
new file mode 100644
index 00000000000..145e59bade4
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_annotation_part_accounting.py
@@ -0,0 +1,53 @@
+"""Part costs distinguish a forced read from an ordinary cache-eligible call."""
+from __future__ import annotations
+
+import pytest
+
+from hermes_cli import kanban_annotation_parts as parts
+from hermes_cli import kanban_session_activity as ksa
+from hermes_cli import loop_accounting as la
+
+
+@pytest.mark.parametrize('forced', [True, False])
+def test_part_read_counts_and_preserves_result(monkeypatch, forced):
+    scope = ('part-accounting',)
+    monkeypatch.setattr(ksa, '_origin_scope', lambda: scope)
+    monkeypatch.setattr(ksa._revalidate.force_read, 'scope', scope, raising=False)
+    monkeypatch.setattr(ksa._revalidate.force_read, 'parts', {parts.COUNTS} if forced else set(), raising=False)
+    key = 'annotation.part.counts.' + ('forced' if forced else 'served')
+    before = la.counters().get(key, {}).get('runs', 0)
+    value = object()
+    assert parts.measured(parts.COUNTS, lambda: value) is value
+    assert la.counters()[key]['runs'] == before + 1
+
+
+def test_host_measures_each_part(monkeypatch):
+    from hermes_cli import kanban_annotation_host as host
+
+    monkeypatch.setattr(ksa, '_all_counts', lambda **kw: ({},) * 9)
+    monkeypatch.setattr(ksa, '_extra_waiting', dict)
+    monkeypatch.setattr(ksa, 'attention_task_counts', dict)
+    monkeypatch.setattr(ksa, '_origin_scope', lambda: ('host-accounting',))
+    calls = []
+
+    def measured(part, read):
+        calls.append(part)
+        return read()
+
+    monkeypatch.setattr(parts, 'measured', measured)
+    monkeypatch.setattr(host, 'frozen_parts', {})
+    assert len(host.read_annotation_parts()) == 12
+    assert calls == [parts.COUNTS, 'waiting', parts.ATTENTION]
+
+
+def test_part_read_accounts_failure_without_swallowing(monkeypatch):
+    monkeypatch.setattr(ksa, '_origin_scope', lambda: ('accounting-failure',))
+    key = 'annotation.part.attention.served'
+    before = la.counters().get(key, {}).get('errors', 0)
+
+    def failed():
+        raise ValueError('part unavailable')
+
+    with pytest.raises(ValueError, match='part unavailable'):
+        parts.measured(parts.ATTENTION, failed)
+    assert la.counters()[key]['errors'] == before + 1
