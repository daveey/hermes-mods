From e8273f12eca7bc2055f6af0b6b424a91f58f9238 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:11:42 +0000
Subject: [PATCH] [daveey] tests: resolve fd paths portably in the
 scratch-archive fsync tests

test_archive_fsyncs_all_artifacts_bottom_up_before_publication_and_detach
failed deterministically on macOS: its fsync spy resolved the descriptor via
os.readlink("/proc/self/fd/N"), macOS has no /proc, and the OSError raised
inside os.fsync made the archive fail closed (workspace kept), so the
`_gc() == 0 and not path.exists()` assertion went red.
test_fsync_failure_fails_closed_without_publication used the same helper and
passed on macOS only by accident (every fsync "failed" on the readlink).

_fd_path now uses fcntl F_GETPATH on darwin and /proc on Linux, both
realpath-resolved, and the expected paths are compared in resolved form
(macOS reports /private/var for /var). The fsync-order contract is now
covered on macOS too; no new skips.

Five whys: Mac run red -> spy raised ENOENT inside fsync -> helper read
/proc -> added on Linux-only CI (ae54bbc60d4) -> the file has no
macOS-reaching platforms marker, so the macOS lane never imported it.

Proof: Linux scripts/run_tests.sh on the file: 66 passed, 0 failed.
---
 .../test_kanban_scratch_gc_archive.py         | 21 ++++++++++++++-----
 1 file changed, 16 insertions(+), 5 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_scratch_gc_archive.py b/tests/hermes_cli/test_kanban_scratch_gc_archive.py
index ef01de8808..2c10e9218c 100644
--- a/tests/hermes_cli/test_kanban_scratch_gc_archive.py
+++ b/tests/hermes_cli/test_kanban_scratch_gc_archive.py
@@ -3,6 +3,7 @@ import argparse
 import json
 import os
 import subprocess
+import sys
 import tarfile
 import time
 from pathlib import Path
@@ -738,7 +739,17 @@ def test_root_replaced_after_scan_is_never_removed(board, monkeypatch, when):
 
 
 def _fd_path(fd):
-    return os.readlink(f"/proc/self/fd/{fd}")
+    """Resolved path of an open descriptor: /proc on Linux, F_GETPATH on macOS (which has no /proc)."""
+    if sys.platform == "darwin":
+        import fcntl
+
+        return os.path.realpath(fcntl.fcntl(fd, fcntl.F_GETPATH, bytes(1024)).rstrip(b"\0").decode())
+    return os.path.realpath(os.readlink(f"/proc/self/fd/{fd}"))
+
+
+def _real(path):
+    """Expected path in _fd_path's resolved form (macOS reports /private/var for /var)."""
+    return os.path.realpath(str(path))
 
 
 def test_archive_fsyncs_all_artifacts_bottom_up_before_publication_and_detach(board, monkeypatch):
@@ -772,9 +783,9 @@ def test_archive_fsyncs_all_artifacts_bottom_up_before_publication_and_detach(bo
     before = [p for k, p in events[:pub] if k == "fsync"]
     tree = next(i for i, p in enumerate(before) if p.endswith("tree.tar.gz"))
     manifest = next(i for i, p in enumerate(before) if p.endswith("manifest.json"))
-    payload_dir = before.index(str(Path(partial) / sa.PAYLOAD_DIR))
-    assert max(tree, manifest) < payload_dir < before.index(partial)  # files, then dir, then parent dir
-    assert str(_archive(tid).parent) in [p for k, p in events[pub:det] if k == "fsync"]
+    payload_dir = before.index(_real(Path(partial) / sa.PAYLOAD_DIR))
+    assert max(tree, manifest) < payload_dir < before.index(_real(partial))  # files, then dir, then parent dir
+    assert _real(_archive(tid).parent) in [p for k, p in events[pub:det] if k == "fsync"]
 
 
 @pytest.mark.parametrize("existing", [False, True], ids=["absent_root", "retry_existing_chain"])
@@ -833,7 +844,7 @@ def test_fsync_failure_fails_closed_without_publication(board, monkeypatch, targ
     def flaky(fd):
         link = _fd_path(fd)
         hit = {"file": link.endswith("manifest.json"), "directory": link.endswith(sa.PAYLOAD_DIR),
-               "publication_parent": link == str(_archive(tid).parent)}[target]
+               "publication_parent": link == _real(_archive(tid).parent)}[target]
         if hit:
             raise OSError(5, "EIO")
         return real_fsync(fd)
