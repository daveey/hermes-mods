From 7e69a7e684ff091bef4f6b19d69720e9e14869d5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:52:31 +0000
Subject: [PATCH] test(e2e): settle the streamed footer before the
 stream_accepted_unpersisted stall

Upstream #56039 (merged with 4932eea) withholds a still-arriving trailing
token from mid-stream frames, so the footer only reached the platform in
the final edit and the cell crashed at a different point (resumed answer
marked, 'unexpected extra marked copies'). A trailing newline settles the
footer so the preview again shows the complete answer while the stream
is open; the cell is back to its known-gap xfail.
---
 tests/e2e/core/delivery/test_messaging_exactly_once.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/tests/e2e/core/delivery/test_messaging_exactly_once.py b/tests/e2e/core/delivery/test_messaging_exactly_once.py
index 7319176526..b784a9b775 100644
--- a/tests/e2e/core/delivery/test_messaging_exactly_once.py
+++ b/tests/e2e/core/delivery/test_messaging_exactly_once.py
@@ -514,7 +514,11 @@ def test_crash_between_completion_and_send(fresh_gw, director, point, platform):
     aid = f"A-{token}"
     answer = Director.answer(aid, "answer computed before the crash.")
     if point == "stream_accepted_unpersisted":  # the whole answer streams, then the stream stays open
-        answer = StallMidStream(text=answer.text, after_chars=len(answer.text), seconds=60)
+        # The trailing newline settles the footer: a mid-stream frame withholds a still-arriving
+        # trailing token (it could grow into a secret, #56039), so without it the footer only
+        # shows in the final edit and this cell would crash at a different point.
+        text = answer.text + "\n"
+        answer = StallMidStream(text=text, after_chars=len(text), seconds=60)
     director.script(token, answer)
     gw.fault(platform=platform, op=op, kind=kind, contains=footer(aid), chat_id=chat)
     gw.inject(platform, f"[in:{token}] question", message_id=f"in-{token}", chat_id=chat)
-- 
