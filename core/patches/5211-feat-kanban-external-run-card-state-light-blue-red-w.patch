+def test_case5_6_two_5xx_are_red_with_one_blocker_for_five_cards_and_recovery_clears_it(kanban_home, gh, clock):
+    with kbc.connect_closing() as conn:
+        tids = [park(conn, 2000 + i) for i in range(5)]
+        tick(conn, gh, clock, 0)
