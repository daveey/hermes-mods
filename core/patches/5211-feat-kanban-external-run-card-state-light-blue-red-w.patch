+"""Watch adapters: one poll of an external system -> ``{job, service, detail, url, retry_after}``. [daveey]
+
+``github`` reads a GitHub Actions run or a PR's checks (wrapping ``kanban_ci_progress``); ``shell`` maps a legacy
+wake-check probe's exit code and optional ``HERMES_WATCH {json}`` line. The state machine that turns polls into a
+card state is ``hermes_cli.kanban_external_state``; the database side is ``hermes_cli.kanban_external_watch``.
+"""
diff --git a/hermes_cli/kanban_external_adapters/github.py b/hermes_cli/kanban_external_adapters/github.py
new file mode 100644
index 0000000000..e24a269f61
--- /dev/null
+++ b/hermes_cli/kanban_external_adapters/github.py
@@ -0,0 +1,196 @@
+"""GitHub Actions run / PR checks -> watch poll. [daveey]
+
+Wraps :func:`hermes_cli.kanban_ci_progress.ci_run_progress` and :func:`pr_progress` (keeping their ``fetch=``
+injection) and adds what a card needs to show light blue or red: the JOB's state (queued / running / succeeded /
+failed / cancelled) separately from the SERVICE's health (ok / degraded / down / unreachable / auth_failed /
+rate_limited). A GitHub error is no longer logged and forgotten: it becomes a health record.
+
+Cost: a run poll is one jobs read (shared with ``ci_run_progress``) plus one run read, only when every listed job is
+complete (to confirm the run's own conclusion: later jobs may not exist yet). A PR poll reads the PR and its head's
+runs again on top of ``pr_progress``'s own reads: three or four calls per PR poll.
+"""
+from __future__ import annotations
+
+import re
+import subprocess
+from dataclasses import dataclass
+from typing import Callable, Optional
+
+from hermes_cli import kanban_ci_progress as kcp
+
+SERVICE_NAME = "GitHub Actions"
+DEFAULT_RETRY_AFTER = 300
+DETAIL_MAX = 300
+_RETRY_AFTER = re.compile(r"retry[- _]after\D{0,3}(\d+)", re.IGNORECASE)
+_RATE = re.compile(r"http 429|rate limit|secondary rate|abuse detection", re.IGNORECASE)
+_AUTH = re.compile(r"http 401|bad credentials|authentication required|gh auth login", re.IGNORECASE)
+_UNREACHABLE = re.compile(r"timed out|timeout|no such host|could not resolve|temporary failure|connection (?:refused|reset)"
+                          r"|network is unreachable|dial tcp|\beof\b", re.IGNORECASE)
+_FAILED = ("failure", "timed_out", "startup_failure", "action_required")
+_PENDING = ("queued", "waiting", "requested", "pending")
+
+
+@dataclass
+class Watched:
+    """One adapter poll: ``poll`` is None when the sweep budget cut the read off (nothing to record yet)."""
+
+    poll: Optional[dict]
+    progress: kcp.Progress
+    adapter: str
+    scope: str
+    service_name: str = SERVICE_NAME
+
+
+def adapter_for(ref: str, hint: str = "") -> Optional[str]:
+    if kcp.run_target(ref, hint) is not None:
+        return "github_run"
+    if kcp.pr_target(ref, hint) is not None:
+        return "github_pr_checks"
+    return None
+
+
+def classify(detail: str, *, no_credential: bool = False, gh_missing: bool = False) -> tuple[str, Optional[int]]:
+    """``(health, retry_after)`` for a GitHub read that failed with ``detail``."""
+    text = detail or ""
+    if no_credential or _AUTH.search(text):
+        return "auth_failed", None
+    if gh_missing:
+        return "probe_broken", None
+    if _RATE.search(text):
+        m = _RETRY_AFTER.search(text)
+        return "rate_limited", int(m.group(1)) if m else DEFAULT_RETRY_AFTER
+    if _UNREACHABLE.search(text):
+        return "unreachable", None
+    return "down", None
+
+
+def _failed(p: kcp.Progress, adapter: str, scope: str, detail: Optional[str] = None) -> Watched:
+    health, retry = classify(detail if detail is not None else p.detail, no_credential=p.no_credential,
+                             gh_missing=p.gh_missing)
+    text = (detail if detail is not None else p.detail) or health
+    return Watched({"job": "unknown", "service": health, "detail": text[-DETAIL_MAX:], "url": None,
+                    "retry_after": retry}, p, adapter, scope)
+
+
+def _conclusion_job(conclusion: Optional[str]) -> str:
+    if conclusion in _FAILED:
+        return "failed"
+    if conclusion == "cancelled":
+        return "cancelled"
+    if conclusion in ("success", "neutral", "skipped"):
+        return "succeeded"
+    return "unknown"
+
+
+def _run_job(jobs: list, repo: str, run_id: str, fetch_run: Optional[Callable]) -> tuple[str, str]:
+    """``(job state, detail)`` of a run from its listed jobs; the run's own read confirms a finished one."""
+    running = [j for j in jobs if isinstance(j, dict) and j.get("status") == "in_progress"]
+    if running:
+        return "running", f"job '{running[0].get('name') or 'job'}' running"
+    unfinished = [j for j in jobs if isinstance(j, dict) and j.get("status") != "completed"]
+    if not jobs:
+        return "queued", "no jobs created yet"
+    if unfinished:
+        started = len(jobs) > len(unfinished)
+        return ("running", "waiting on later jobs") if started else ("queued", "queued, no runner yet")
+    run = (fetch_run or (lambda r, i: kcp._gh_api(f"repos/{r}/actions/runs/{i}")))(repo, run_id) or {}
+    if run.get("status") != "completed":
+        return "running", "finishing up"
+    job = _conclusion_job(run.get("conclusion"))
+    return job, f"run {run.get('conclusion') or 'finished'}"
+
+
+def poll(ref: str, hint: str = "", *, parked_at: Optional[float] = None, now: Optional[float] = None,
+         fetch: Optional[kcp.Fetch] = None, fetch_runners: Optional[kcp.FetchRunners] = None,
+         fetch_run: Optional[Callable[[str, str], dict]] = None,
+         deadline: Optional[float] = None) -> Optional[Watched]:
+    """Poll the GitHub run or PR ``ref`` names; None when it names neither. Never raises."""
+    adapter = adapter_for(ref, hint)
+    if adapter is None:
+        return None
+    try:
+        if adapter == "github_run":
+            return _poll_run(ref, hint, now, fetch, fetch_runners, fetch_run, deadline)
+        return _poll_pr(ref, hint, parked_at, now, fetch, fetch_runners, deadline)
+    except kcp.GhMissing as exc:
+        return _failed(kcp.Progress("unknown", gh_missing=True, detail=str(exc)), adapter, "")
+    except kcp.NoCredential as exc:
+        return _failed(kcp.Progress("unknown", no_credential=True, detail=str(exc)), adapter, "")
+    except (OSError, RuntimeError, ValueError, AttributeError, KeyError, TypeError, subprocess.TimeoutExpired) as exc:
+        return _failed(kcp.Progress("unknown", detail=str(exc)), adapter, "")
+
+
+def _poll_run(ref, hint, now, fetch, fetch_runners, fetch_run, deadline) -> Watched:
+    seen: dict = {}
+
+    def jobs_fetch(repo: str, run_id: str) -> dict:
+        data = (fetch or kcp._fetch_jobs)(repo, run_id)
+        seen["jobs"] = data
+        return data
+
+    p = kcp.ci_run_progress(ref, hint=hint, fetch=jobs_fetch, fetch_runners=fetch_runners, now=now,
+                            deadline=deadline)
+    scope = p.repo
+    if p.state == "unknown":
+        return Watched(None, p, "github_run", scope) if p.deferred else _failed(p, "github_run", scope)
+    url = f"https://github.com/{p.repo}/actions/runs/{p.run_id}"
+    if p.state in (kcp.NOT_STARTING, kcp.BUSY):
+        detail = kcp.describe(p) if p.state == kcp.NOT_STARTING else p.detail
+        return Watched({"job": "queued", "service": "degraded", "detail": detail[:DETAIL_MAX], "url": url,
+                        "retry_after": None}, p, "github_run", scope)
+    try:
+        job, detail = _run_job((seen.get("jobs") or {}).get("jobs") or [], p.repo, p.run_id, fetch_run)
+    except kcp.NoCredential as exc:
+        return _failed(kcp.Progress("unknown", p.repo, p.run_id, detail=str(exc), no_credential=True),
+                       "github_run", scope)
+    except kcp.GhMissing as exc:
+        return _failed(kcp.Progress("unknown", p.repo, p.run_id, detail=str(exc), gh_missing=True),
+                       "github_run", scope)
+    except (OSError, RuntimeError, ValueError, subprocess.TimeoutExpired) as exc:
+        return _failed(kcp.Progress("unknown", p.repo, p.run_id, detail=str(exc)), "github_run", scope)
+    return Watched({"job": job, "service": "ok", "detail": detail, "url": url, "retry_after": None}, p,
+                   "github_run", scope)
+
+
+def _poll_pr(ref, hint, parked_at, now, fetch, fetch_runners, deadline) -> Watched:
+    repo, number, sha = kcp.pr_target(ref, hint)  # type: ignore[misc]  # adapter_for proved it is a PR ref
+    url = f"https://github.com/{repo}/pull/{number}"
+    p = kcp.pr_progress(repo, number, sha, parked_at, fetch=fetch, fetch_runners=fetch_runners, now=now,
+                        deadline=deadline)
+    if p.state == "unknown" and not p.settling:
+        return Watched(None, p, "github_pr_checks", repo) if p.deferred else _failed(p, "github_pr_checks", repo)
+    if p.state == kcp.NOT_STARTING:
+        detail = p.detail if p.per_pr else kcp.describe(p)
+        return Watched({"job": "queued", "service": "degraded", "detail": detail[:DETAIL_MAX], "url": url,
+                        "retry_after": None}, p, "github_pr_checks", repo)
+    api = kcp._gh_api
+    try:
+        pr = api(f"repos/{repo}/pulls/{number}") or {}
+        if pr.get("state") != "open" or pr.get("merged"):
+            # The existing sweep contract (a finished or moved PR never wakes the park) is kept: the job is unknown.
+            return Watched({"job": "unknown", "service": "ok", "detail": "PR merged" if pr.get("merged") else "PR closed",
+                            "url": url, "retry_after": None}, p, "github_pr_checks", repo)
+        head = str((pr.get("head") or {}).get("sha") or "").lower()
+        if sha and not head.startswith(sha.lower()):
+            return Watched({"job": "unknown", "service": "ok", "detail": f"head moved off {sha[:10]}", "url": url,
+                            "retry_after": None}, p, "github_pr_checks", repo)
+        runs = [r for r in (api(f"repos/{repo}/actions/runs?head_sha={head}&per_page=100") or {}).get(
+            "workflow_runs") or [] if isinstance(r, dict)]
+    except kcp.NoCredential as exc:
+        return _failed(kcp.Progress("unknown", repo, no_credential=True, detail=str(exc)), "github_pr_checks", repo)
+    except kcp.GhMissing as exc:
+        return _failed(kcp.Progress("unknown", repo, gh_missing=True, detail=str(exc)), "github_pr_checks", repo)
+    except (OSError, RuntimeError, ValueError, AttributeError, subprocess.TimeoutExpired) as exc:
+        return _failed(kcp.Progress("unknown", repo, detail=str(exc)), "github_pr_checks", repo)
+    if not runs or any(r.get("status") in _PENDING for r in runs) and not any(
+            r.get("status") == "in_progress" for r in runs):
+        job, detail = "queued", "checks queued" if runs else "no checks started yet"
+    elif any(r.get("status") != "completed" for r in runs):
+        job, detail = "running", "checks running"
+    else:
+        concl = [r.get("conclusion") for r in runs]
+        job = ("failed" if any(c in _FAILED for c in concl) else "cancelled" if "cancelled" in concl
+               else "succeeded")
+        detail = f"checks {job}"
+    return Watched({"job": job, "service": "ok", "detail": detail, "url": url, "retry_after": None}, p,
+                   "github_pr_checks", repo)
diff --git a/hermes_cli/kanban_external_adapters/shell.py b/hermes_cli/kanban_external_adapters/shell.py
new file mode 100644
index 0000000000..23a68ff256
--- /dev/null
+++ b/hermes_cli/kanban_external_adapters/shell.py
@@ -0,0 +1,78 @@
+"""Legacy shell probe -> watch poll. [daveey]
+
+A park's ``wake_check`` is a shell probe: exit 0 = condition holds, 1 = not yet, 3 = unknown, anything else = the
+probe is broken. That cannot say whether a CI run passed or failed, or whether GitHub is down. A probe may print
+ONE line ``HERMES_WATCH {json}`` to give the full record (``job``, ``service``, ``detail``, ``url``,
+``retry_after``, ``service_name``): the cheap upgrade path for any script. Unknown or malformed fields are
+ignored, never trusted.
+"""
+from __future__ import annotations
+
+import json
+import re
+from typing import Any, Optional
+
+from hermes_cli.kanban_external_state import HEALTHS, JOBS, TERMINAL_JOBS
+
+_LINE = re.compile(r"^\s*HERMES_WATCH\s+(\{.*\})\s*$")
+DETAIL_MAX = 300
+
+
+def parse_watch(out: str) -> Optional[dict]:
+    """The last ``HERMES_WATCH {json}`` line of ``out`` that holds a JSON object, else None."""
+    found = None
+    for line in (out or "").splitlines():
+        m = _LINE.match(line)
+        if not m:
+            continue
+        try:
+            value = json.loads(m.group(1))
+        except ValueError:
+            continue
+        if isinstance(value, dict):
+            found = value
+    return found
+
+
+def _clean(watch: dict) -> dict:
+    out: dict[str, Any] = {}
+    if watch.get("job") in JOBS:
+        out["job"] = watch["job"]
+    if watch.get("service") in HEALTHS:
+        out["service"] = watch["service"]
+    for key, limit in (("detail", DETAIL_MAX), ("service_name", 60)):
+        if isinstance(watch.get(key), str) and watch[key].strip():
+            out[key] = watch[key].strip()[:limit]
+    url = watch.get("url")
+    if isinstance(url, str) and url.startswith(("http://", "https://")):
+        out["url"] = url[:500]
+    ra = watch.get("retry_after")
+    if isinstance(ra, int) and not isinstance(ra, bool) and ra >= 0:
+        out["retry_after"] = ra
+    return out
+
+
+def poll(rc: Any, out: str) -> dict:
+    """One probe result as a watch poll. ``terminal`` is set when the probe says the job finished (exit 0, or a
+    ``HERMES_WATCH`` line with a terminal job); ``outcome`` is then the job result or ``done_unknown``."""
+    from hermes_cli.kanban_wake_check import output_error
+
+    crashed = rc not in (0, 1, 3) or (rc == 1 and bool(output_error(out)))
+    if crashed:
+        why = output_error(out) or f"exit {rc}"
+        return {"job": "unknown", "service": "probe_broken", "detail": f"probe failed: {why}"[:DETAIL_MAX],
+                "url": None, "retry_after": None, "terminal": False, "outcome": None}
+    base = {"job": "unknown", "service": "ok", "detail": "", "url": None, "retry_after": None, "terminal": False,
+            "outcome": None}
+    if rc == 1:
+        base["job"] = "running"
+    if rc == 3:
+        base["detail"] = "probe could not tell (exit 3)"
+    watch = _clean(parse_watch(out) or {})
+    base.update({k: v for k, v in watch.items() if k != "service_name"})
+    if "service_name" in watch:
+        base["service_name"] = watch["service_name"]
+    base["terminal"] = rc == 0 or base["job"] in TERMINAL_JOBS
+    if base["terminal"]:
+        base["outcome"] = base["job"] if base["job"] in TERMINAL_JOBS else "done_unknown"
+    return base
diff --git a/hermes_cli/kanban_external_state.py b/hermes_cli/kanban_external_state.py
new file mode 100644
index 0000000000..b3b3cb08e9
--- /dev/null
+++ b/hermes_cli/kanban_external_state.py
@@ -0,0 +1,148 @@
+"""Card-level state of work that runs on another system: light blue (running externally) or red (service broke). [daveey]
+
+Pure and clock-injected: no database, no network, no ``time`` calls. A watch poll yields one record
+
+    {job: queued|running|succeeded|failed|cancelled|unknown,
+     service: ok|degraded|down|unreachable|auth_failed|rate_limited|probe_broken,   # the *health* of the service
+     detail, url, observed_at, retry_after}
+
+:func:`next_record` folds a poll into the card's stored record (failure streak, next due time with jitter and
+``retry_after``); :func:`derive` turns the stored record and the reader's own clock into the card state:
+
+* ``external_running``: last job queued/running, service ok/degraded, record fresh.
+* ``external_unknown``: one failed/missed poll, a rate limit, a job nobody could read, or a record older than one
+  interval. Light blue with a hollow glyph.
+* ``external_down`` (red): two consecutive down/unreachable polls, ``auth_failed`` at once (it never self-heals),
+  a probe that broke twice, a host silent for more than two intervals (only a host that advertises
+  ``external-watch-v1``: an older host's silence stays grey, ``derive`` returns None), or a ci/deploy/external park
+  with nothing watching it (``watch_missing``).
+* a terminal job (succeeded/failed/cancelled) sets ``wake``: the card is woken with ``external_result`` and the job
+  failing is NOT ``external_down``: that is the woken worker's business, not an outage.
+
+A 429 / rate limit never counts toward red (the GitHub quota livelock of t_eeeeee0000000011 must not repeat) and
+the next poll is never earlier than its ``retry_after``.
+"""
+from __future__ import annotations
+
+from typing import Any, Optional
+
+SCHEMA = 1
+CAPABILITY = "external-watch-v1"
+EXTERNAL_KINDS = ("ci", "deploy", "external")
+
+RUNNING = "external_running"
+UNKNOWN = "external_unknown"
+DOWN = "external_down"
+
+JOBS = ("queued", "running", "succeeded", "failed", "cancelled", "unknown")
+TERMINAL_JOBS = ("succeeded", "failed", "cancelled")
+HEALTHS = ("ok", "degraded", "down", "unreachable", "auth_failed", "rate_limited", "probe_broken")
+FAILING = ("down", "unreachable", "probe_broken")
+
+MIN_EVERY = 120
+MAX_EVERY = 6 * 3600
+DEFAULT_CI_EVERY = 300
+JITTER = 0.10
+DOWN_AFTER = 2  # consecutive failed polls before a down/unreachable service is red
+
+SERVICE_NAMES = {"github_run": "GitHub Actions", "github_pr_checks": "GitHub Actions", "shell": "external probe"}
+
+
+def clamp_every(value: Any, default: int = DEFAULT_CI_EVERY) -> int:
+    """A poll interval in seconds: ``default`` when absent or not a number, else within [MIN_EVERY, MAX_EVERY]."""
+    try:
+        every = int(value)
+    except (TypeError, ValueError):
+        every = int(default)
+    return max(MIN_EVERY, min(MAX_EVERY, every))
+
+
+def next_record(prev: Optional[dict], poll: dict, *, now: float, every: Any, adapter: str, scope: str = "",
+                rand: float = 0.5, host: Optional[str] = None) -> dict:
+    """Fold one poll into the card's record. ``rand`` in [0, 1] places the next poll within ±``JITTER`` of
+    ``every`` (never under ``MIN_EVERY``, never before the poll's ``retry_after``)."""
+    interval = clamp_every(every)
+    health = poll.get("service") if poll.get("service") in HEALTHS else "ok"
+    job = poll.get("job") if poll.get("job") in JOBS else "unknown"
+    streak = int((prev or {}).get("consecutive_failures") or 0)
+    if health in FAILING:
+        streak += 1
+    elif health != "rate_limited":
+        streak = 0
+    retry_after = poll.get("retry_after")
+    try:
+        retry_after = max(0, int(retry_after)) if retry_after is not None else None
+    except (TypeError, ValueError):
+        retry_after = None
+    factor = 1 + (min(1.0, max(0.0, float(rand))) - 0.5) * 2 * JITTER
+    wait = max(interval * factor, MIN_EVERY, retry_after or 0)
+    return {"schema": SCHEMA, "adapter": adapter, "scope": scope, "host": host, "job": job, "service": health,
+            "detail": str(poll.get("detail") or "")[:300], "url": poll.get("url") or None,
+            "observed_at": float(now), "next_due_at": float(now) + wait, "retry_after": retry_after,
+            "consecutive_failures": streak, "every": interval}
+
+
+def _external(rec: Optional[dict], *, health: str, job: str, reason: str, adapter: str, service_name: str) -> dict:
+    return {"service": service_name, "adapter": adapter, "job": job, "health": health, "reason": reason,
+            "url": (rec or {}).get("url") or None,
+            "observed_at": (rec or {}).get("observed_at"), "next_due_at": (rec or {}).get("next_due_at")}
+
+
+def _out(state: str, health: str, job: str, reason: str, rec: Optional[dict], adapter: str, service_name: str,
+         wake: bool = False) -> dict:
+    return {"state": state, "health": health, "job": job, "reason": reason, "wake": wake,
+            "external": _external(rec, health=health, job=job, reason=reason, adapter=adapter,
+                                  service_name=service_name)}
+
+
+def derive(rec: Optional[dict], *, now: float, every: Any, since: Optional[float] = None, advertises: bool = True,
+           watch_missing: bool = False, adapter: Optional[str] = None,
+           service_name: Optional[str] = None) -> Optional[dict]:
+    """The card's external state at ``now`` by the reader's own clock, or None (grey: nothing to say).
+
+    ``rec`` is the stored record (None before the first poll), ``since`` when the park began, ``advertises`` whether
+    the probe host writes records at all (False: silence proves nothing, so None)."""
+    interval = clamp_every(every)
+    adapter = adapter or (rec or {}).get("adapter") or "shell"
+    name = service_name or SERVICE_NAMES.get(adapter, "external service")
+    if watch_missing:
+        return _out(DOWN, "watch_missing", "unknown", "nothing is watching this wait: no adapter and no probe", rec,
+                    adapter, name)
+    if rec is None:
+        if not advertises:
+            return None
+        age = now - (since if since is not None else now)
+        if age > 2 * interval:
+            return _out(DOWN, "host_silent", "unknown", f"no check recorded {int(age // 60)} min after the park", rec,
+                        adapter, name)
+        if age > interval * (1 + JITTER):
+            return _out(UNKNOWN, "host_silent", "unknown", f"no check recorded {int(age // 60)} min after the park",
+                        rec, adapter, name)
+        return _out(UNKNOWN, "ok", "unknown", "not checked yet", rec, adapter, name)
+    job = rec.get("job") if rec.get("job") in JOBS else "unknown"
+    health = rec.get("service") if rec.get("service") in HEALTHS else "ok"
+    detail = str(rec.get("detail") or "")
+    fails = int(rec.get("consecutive_failures") or 0)
+    if job in TERMINAL_JOBS:
+        return _out(RUNNING, "ok" if health in ("ok", "degraded") else health, job, detail or f"job {job}", rec,
+                    adapter, name, wake=True)
+    if health == "auth_failed":
+        return _out(DOWN, health, job, detail or "authentication failed", rec, adapter, name)
+    if health in FAILING:
+        word = "probe failed" if health == "probe_broken" else f"{health}"
+        reason = f"{fails} failed check{'s' if fails != 1 else ''} ({word}){': ' + detail if detail else ''}"
+        return _out(DOWN if fails >= DOWN_AFTER else UNKNOWN, health, job, reason, rec, adapter, name)
+    limited = health == "rate_limited"
+    slack = float(rec.get("retry_after") or 0) if limited else 0.0
+    age = now - float(rec.get("observed_at") or now)
+    if age > 2 * interval + slack:
+        if not advertises:
+            return None
+        return _out(DOWN, "host_silent", job, f"no check for {int(age // 60)} min (host silent)", rec, adapter, name)
+    if limited:
+        return _out(UNKNOWN, health, job, detail or "rate limited", rec, adapter, name)
+    if age > interval * (1 + JITTER) + slack:
+        return _out(UNKNOWN, "host_silent", job, f"last check {int(age // 60)} min ago", rec, adapter, name)
+    if job == "unknown":
+        return _out(UNKNOWN, health, job, detail or "job status unknown", rec, adapter, name)
+    return _out(RUNNING, health, job, detail or f"job {job}", rec, adapter, name)
diff --git a/hermes_cli/kanban_external_watch.py b/hermes_cli/kanban_external_watch.py
new file mode 100644
index 0000000000..145e4b8574
--- /dev/null
+++ b/hermes_cli/kanban_external_watch.py
@@ -0,0 +1,351 @@
+"""External-run cards, database side: record polls, derive card state, wake, shared service-down blocker. [daveey]
+
+A card parked with ``awaiting.kind`` in ci/deploy/external waits on work that runs on another system. A watch poll
+(``kanban_external_adapters``) is recorded as an ``external_watch`` event on the card; ``derive_card`` turns the
+newest record into the state in ``kanban_external_state`` by the READER's own clock, so a dead probe host turns the
+card light-blue-unknown after one interval and red after two even though it wrote nothing.
+
+Why events: the Board sync carries ``task_events`` but no new table (``kanban_board_row_fields.json`` is the synced
+row contract), and ``task_wake_checks`` is machine-local, so a worker's poll would be invisible on the hub. One
+event per poll (state change or the heartbeat that keeps the record fresh) is the cost; the writer is
+:func:`write_record`, the one place to swap for a synced table.
+
+Mixed versions: a probe host that never wrote an ``external_watch`` event is an older host. Its silence stays grey
+(``advertises`` False); only a host seen writing records, or this one, can turn a card red by being silent.
+
+Service outage (not a failed job): the first card whose service goes red for a scope is woken as that scope's
+probe with the shared blocker ``service-down.<adapter>.<scope>`` (``kanban_shared_blockers``, as
+``runners-offline.*``); the other cards stay parked and red with the blocker named. The first ok poll of any card
+on that scope clears the blocker and writes one ``external_recovered`` event on each card that was red.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import random
+import sqlite3
+import time
+from typing import Any, Iterable, Optional
+
+from hermes_cli import kanban_external_state as ks
+
+logger = logging.getLogger(__name__)
+
+WATCH_EVENT = "external_watch"
+RECOVERED_EVENT = "external_recovered"
+SERVICE_DOWN = "external_service_down"
+BLOCKER_PREFIX = "service-down"
+AUTHOR = "kanban-dispatcher"
+ADVERTISED_SCAN = 2000  # newest watch events read to learn which hosts write records
+SHELL_DEFAULT_EVERY = 900
+
+
+def _json(raw: Any) -> dict:
+    try:
+        value = json.loads(raw) if isinstance(raw, (str, bytes)) else raw
+    except ValueError:
+        return {}
+    return value if isinstance(value, dict) else {}
+
+
+def park_context(conn: sqlite3.Connection, task_id: str) -> Optional[dict]:
+    """The card's latest park: ``{event_id, since, payload, awaiting}`` or None."""
+    row = conn.execute("SELECT id, payload, created_at FROM task_events WHERE task_id = ? AND kind IN "
+                       "('scheduled', 'continued') ORDER BY id DESC LIMIT 1", (task_id,)).fetchone()
+    if row is None:
+        return None
+    payload = _json(row[1])
+    awaiting = payload.get("awaiting") if isinstance(payload.get("awaiting"), dict) else None
+    return {"event_id": int(row[0]), "since": float(row[2]) if row[2] is not None else None, "payload": payload,
+            "awaiting": awaiting}
+
+
+def latest_record(conn: sqlite3.Connection, task_id: str, after_event: int = 0) -> Optional[dict]:
+    """The newest ``external_watch`` payload written after the card's latest park, else None."""
+    row = conn.execute("SELECT payload FROM task_events WHERE task_id = ? AND kind = ? AND id > ? "
+                       "ORDER BY id DESC LIMIT 1", (task_id, WATCH_EVENT, after_event)).fetchone()
+    return _json(row[0]) if row else None
+
+
+def advertising_hosts(conn: sqlite3.Connection) -> set[str]:
+    """Hosts seen writing watch records on this board (``external-watch-v1``)."""
+    try:
+        rows = conn.execute("SELECT payload FROM task_events WHERE kind = ? ORDER BY id DESC LIMIT ?",
+                            (WATCH_EVENT, ADVERTISED_SCAN)).fetchall()
+    except sqlite3.Error:
+        return set()
+    return {str(h) for h in (_json(r[0]).get("host") for r in rows) if h}
+
+
+def own_host(conn: Optional[sqlite3.Connection]) -> str:
+    from hermes_cli.kanban_wake_check import own_gateway
+    return own_gateway(conn) or "local"
+
+
+def plan(conn: sqlite3.Connection, task_id: str, ctx: dict) -> Optional[dict]:
+    """How the card is watched: ``{adapter, ref, every, hint}`` or None when nothing watches it. A declared
+    ``watch`` on the park wins, then a GitHub run/PR ref of a ``ci`` park, then the park's shell probe."""
+    from hermes_cli.kanban_external_adapters import github
+    payload, awaiting = ctx["payload"], ctx["awaiting"] or {}
+    watch = payload.get("watch") if isinstance(payload.get("watch"), dict) else {}
+    row = None
+    try:
+        row = conn.execute("SELECT cmd, every FROM task_wake_checks WHERE task_id = ?", (task_id,)).fetchone()
+    except sqlite3.Error:
+        pass
+    cmd = (row[0] if row else None) or payload.get("wake_check") or ""
+    hint = " ".join(x for x in (cmd, str(payload.get("reason") or "")) if x)
+    ref = str(watch.get("ref") or awaiting.get("ref") or "")
+    adapter = str(watch.get("adapter") or "") or None
+    if adapter not in ("github_run", "github_pr_checks", "shell"):
+        adapter = github.adapter_for(ref, hint) if awaiting.get("kind") == "ci" else None
+    if adapter is None and cmd:
+        adapter = "shell"
+    if adapter is None:
+        return None
+    default = ks.DEFAULT_CI_EVERY if adapter != "shell" else (
+        int(row[1]) if row and row[1] else int(payload.get("check_every") or SHELL_DEFAULT_EVERY))
+    return {"adapter": adapter, "ref": ref, "hint": hint, "every": ks.clamp_every(watch.get("every"), default)}
+
+
+def _shell_seen(conn: sqlite3.Connection, task_id: str, rec: dict, every: Any, local: bool) -> tuple[dict, Any]:
+    """A shell record is written on change only, so its freshness is the newest sign the probe still runs: the
+    check's own ``last_at`` on this host, the ``wake_check_alive`` a worker node sends every ``ALIVE_EVERY``. A
+    probe relayed from another host is judged against that slower heartbeat plus its interval, as the lost-probe
+    guard does, or a healthy remote probe would read as silent."""
+    from hermes_cli import kanban_wake_check as kwc
+    seen = float(rec.get("observed_at") or 0)
+    try:
+        row = conn.execute("SELECT last_at FROM task_wake_checks WHERE task_id = ?", (task_id,)).fetchone()
+        seen = max(seen, float(row[0] or 0) if row else 0.0)
+        alive = conn.execute("SELECT MAX(created_at) FROM task_events WHERE task_id = ? AND kind = ?",
+                             (task_id, kwc.ALIVE_EVENT)).fetchone()
+        seen = max(seen, float(alive[0] or 0) if alive else 0.0)
+    except sqlite3.Error:
+        pass
+    every = ks.clamp_every(every, SHELL_DEFAULT_EVERY)
+    if not local:
+        every = every + kwc.ALIVE_EVERY // 2
+    return dict(rec, observed_at=seen, next_due_at=seen + ks.clamp_every(rec.get("every"), SHELL_DEFAULT_EVERY)), every
+
+
+def card_state(conn: sqlite3.Connection, task_id: str, *, now: Optional[float] = None,
+               hosts: Optional[set[str]] = None, status: Optional[str] = None) -> Optional[dict]:
+    """The derived external state of one card (see ``kanban_external_state.derive``), or None: not a scheduled
+    ci/deploy/external park, an old host's silence, or a deadline-only wait. Adds ``blocker_id`` / ``triage_card``
+    to ``external`` while a service-down blocker holds the card."""
+    now = time.time() if now is None else float(now)
+    if status is None:
+        row = conn.execute("SELECT status FROM tasks WHERE id = ?", (task_id,)).fetchone()
+        status = row[0] if row else None
+    if status != "scheduled":
+        return None
+    ctx = park_context(conn, task_id)
+    if ctx is None or (ctx["awaiting"] or {}).get("kind") not in ks.EXTERNAL_KINDS:
+        return None
+    watch = plan(conn, task_id, ctx)
+    rec = latest_record(conn, task_id, ctx["event_id"])
+    probe_host = ctx["payload"].get("probe_host")
+    local = not probe_host or probe_host == own_host(conn) or probe_host == "local"
+    advertises = rec is not None or local or probe_host in (advertising_hosts(conn) if hosts is None else hosts)
+    if rec is None and watch is None:
+        derived = ks.derive(None, now=now, every=ks.DEFAULT_CI_EVERY, since=ctx["since"], watch_missing=local,
+                            advertises=advertises)
+    else:
+        every = (rec or {}).get("every") or (watch or {}).get("every")
+        if rec is not None and rec.get("adapter") == "shell":
+            rec, every = _shell_seen(conn, task_id, rec, every, local)
+        derived = ks.derive(rec, now=now, every=every, since=ctx["since"], advertises=advertises,
+                            adapter=(rec or {}).get("adapter") or (watch or {}).get("adapter"),
+                            service_name=(rec or {}).get("service_name"))
+    if derived is not None:
+        derived["adapter"] = derived["external"]["adapter"]
+        _name_blocker(conn, derived, rec)
+    return derived
+
+
+def _name_blocker(conn: sqlite3.Connection, derived: dict, rec: Optional[dict]) -> None:
+    if derived["state"] != ks.DOWN or not rec or not rec.get("adapter") or not rec.get("scope"):
+        return
+    if derived["health"] not in ("down", "unreachable", "auth_failed"):
+        return
+    bid = blocker_id(rec["adapter"], rec["scope"])
+    try:
+        from hermes_cli import kanban_shared_blockers as ksb
+        st = ksb.blocker_states(conn).get(bid)
+    except (sqlite3.Error, ValueError):
+        return
+    if st is not None and st.is_open:
+        derived["external"]["blocker_id"] = bid
+        derived["external"]["triage_card"] = next(iter(sorted(st.behind)), None)
+
+
+def card_states(conn: sqlite3.Connection, task_ids: Iterable[str], *, now: Optional[float] = None) -> dict[str, dict]:
+    """``{task id: derived state}`` for the scheduled external cards among ``task_ids``. Never raises."""
+    out: dict[str, dict] = {}
+    try:
+        hosts = advertising_hosts(conn)
+        for tid in dict.fromkeys(str(t) for t in task_ids):
+            derived = card_state(conn, tid, now=now, hosts=hosts)
+            if derived is not None:
+                out[tid] = derived
+    except sqlite3.Error:
+        logger.debug("external card states unavailable", exc_info=True)
+    return out
+
+
+def blocker_id(adapter: str, scope: str) -> str:
+    from hermes_cli.kanban_shared_blockers import normalize_blocker_id
+    return normalize_blocker_id(f"{BLOCKER_PREFIX}.{adapter}.{scope}") or f"{BLOCKER_PREFIX}.{adapter}"
+
+
+# --- writing -------------------------------------------------------------------------------------------------
+
+def write_record(conn: sqlite3.Connection, task_id: str, rec: dict, derived: dict) -> None:
+    """Append one watch event. In the caller's write txn. The single place to swap for a synced table."""
+    from hermes_cli import kanban_db as kb
+    kb._append_event(conn, task_id, WATCH_EVENT, {**rec, "state": derived["state"], "health": derived["health"],
+                                                  "service_name": derived["external"]["service"]})
+
+
+def record_poll(conn: sqlite3.Connection, task_id: str, poll: dict, *, now: float, adapter: str, scope: str = "",
+                every: Any = None, service_name: Optional[str] = None,
+                rand: Optional[float] = None) -> Optional[dict]:
+    """Fold ``poll`` into the card's record and write it when the state changed or the heartbeat is due. In the
+    caller's write txn. Returns ``{derived, prev_state, rec}``, or None when the park is gone or is not external."""
+    from hermes_cli import kanban_db as kb
+    ctx = park_context(conn, task_id)
+    if ctx is None or (ctx["awaiting"] or {}).get("kind") not in ks.EXTERNAL_KINDS:
+        return None
+    prev = latest_record(conn, task_id, ctx["event_id"])
+    watch = plan(conn, task_id, ctx) or {}
+    every = ks.clamp_every(every if every is not None else (prev or {}).get("every") or watch.get("every"))
+    rec = ks.next_record(prev, poll, now=now, every=every, adapter=adapter, scope=scope,
+                         rand=random.random() if rand is None else rand, host=own_host(conn))
+    name = service_name or poll.get("service_name") or ks.SERVICE_NAMES.get(adapter, "external service")
+    derived = ks.derive(rec, now=now, every=every, adapter=adapter, service_name=name) or {}
+    prev_written = (prev or {}).get("state")
+    changed = (prev is None or prev_written != derived["state"] or prev.get("job") != rec["job"]
+               or prev.get("service") != rec["service"])
+    due = prev is None or (adapter != "shell" and now - float(prev.get("observed_at") or 0) >= 0.9 * every)
+    # A shell probe's heartbeat is not an event per check (test_clean_checks_do_not_append_one_event_each): the
+    # check's own ``task_wake_checks.last_at`` (this host) and ``wake_check_alive`` (a worker node, every
+    # ALIVE_EVERY) carry it; ``_shell_seen`` reads them.
+    if changed or due:
+        write_record(conn, task_id, rec, derived)
+    was_down = prev_written == ks.DOWN
+    if was_down and derived["state"] != ks.DOWN:
+        kb._append_event(conn, task_id, RECOVERED_EVENT, {"adapter": adapter, "scope": scope, "job": rec["job"],
+                                                          "health": derived["health"]})
+    return {"derived": derived, "prev_state": prev_written, "rec": rec, "was_down": was_down}
+
+
+def _result(rec: dict, derived: dict) -> dict:
+    return {"job": rec["job"], "outcome": derived["job"] if derived["job"] in ks.TERMINAL_JOBS else "done_unknown",
+            "detail": rec.get("detail") or "", "url": rec.get("url"), "adapter": rec.get("adapter"),
+            "service": derived["external"]["service"], "observed_at": rec.get("observed_at")}
+
+
+def apply_poll(conn: sqlite3.Connection, task_id: str, poll: dict, *, now: float, adapter: str, scope: str = "",
+               every: Any = None, service_name: Optional[str] = None, rand: Optional[float] = None,
+               cmd: str = "", terminal: Optional[bool] = None) -> Optional[str]:
+    """Record one poll for a scheduled card and act on it: a finished job wakes the card with ``external_result``
+    (``condition_met``; a FAILED job wakes too and is not an outage); a service gone red asserts the shared
+    blocker; an ok poll clears it. Returns the event kind that woke the card, else None. Opens its own write txn."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_wake_check as kwc
+    with kb.write_txn(conn):
+        status = conn.execute("SELECT status FROM tasks WHERE id = ?", (task_id,)).fetchone()
+        if status is None or status[0] != "scheduled":
+            return None
+        got = record_poll(conn, task_id, poll, now=now, adapter=adapter, scope=scope, every=every,
+                          service_name=service_name, rand=rand)
+        if got is None:
+            return None
+        derived, rec = got["derived"], got["rec"]
+        finished = poll.get("terminal") if terminal is None else terminal
+        if finished or derived.get("wake"):
+            kwc.episode.reset(conn, task_id)
+            woke = kwc._wake(conn, task_id, kwc.CONDITION_MET_EVENT, {
+                "wake_check": cmd or None, "output": rec.get("detail") or "",
+                "external_result": _result(rec, derived)})
+            if woke:
+                kb.add_comment(conn, task_id, AUTHOR, _finished_note(rec, derived))
+            return woke
+        if derived["state"] == ks.DOWN and derived["health"] in ("down", "unreachable") and scope:
+            return _assert_blocker(conn, task_id, rec, derived)
+        if derived["health"] in ("ok", "degraded") and scope:
+            _clear_blocker(conn, rec)
+        return None
+
+
+def _finished_note(rec: dict, derived: dict) -> str:
+    res = _result(rec, derived)
+    where = f" ({res['url']})" if res.get("url") else ""
+    return (f"Woken: the job on {res['service']} finished: {res['outcome']}{where}. "
+            + ("A failed job is a result for this card, not an outage." if res["outcome"] == "failed" else ""))
+
+
+def _assert_blocker(conn: sqlite3.Connection, task_id: str, rec: dict, derived: dict) -> Optional[str]:
+    """The service is down. The first card for this scope is woken as its probe and the shared blocker is
+    asserted on it; a later card stays parked (red, blocker named)."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_shared_blockers as ksb
+    from hermes_cli.kanban_wake_check import _wake
+    bid = blocker_id(rec["adapter"], rec["scope"])
+    st = ksb.blocker_states(conn).get(bid)
+    if st is not None and st.is_open:
+        return None
+    note = (f"Woken: {derived['external']['service']} is {derived['health']} for {rec['scope']} "
+            f"({derived['reason']}). This card is the probe for shared blocker {bid}: triage the service (credential, "
+            "runner fleet, probe) and re-park; other cards on this scope stay parked and red behind it, and every "
+            "one clears on the first ok poll.")
+    woke = _wake(conn, task_id, SERVICE_DOWN, {"adapter": rec["adapter"], "scope": rec["scope"],
+                                               "health": derived["health"], "blocker_id": bid, "note": note})
+    if not woke:
+        return None
+    kb.add_comment(conn, task_id, AUTHOR, note)
+    run_id = kb._synthesize_ended_run(conn, task_id, outcome=SERVICE_DOWN, summary=derived["reason"][:300],
+                                      metadata={"blocker_id": bid, "adapter": rec["adapter"], "scope": rec["scope"]})
+    kb._append_event(conn, task_id, ksb.PROBE_RELEASED_EVENT, {"blocker_id": bid, "via": SERVICE_DOWN,
+                                                               "after_run": run_id})
+    return woke
+
+
+def _clear_blocker(conn: sqlite3.Connection, rec: dict) -> None:
+    """The first ok poll after an outage: clear the scope's blocker on every card behind it."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_shared_blockers as ksb
+    bid = blocker_id(rec["adapter"], rec["scope"])
+    st = ksb.blocker_states(conn).get(bid)
+    if st is None or not st.is_open:
+        return
+    for tid in sorted(st.behind):
+        kb._synthesize_ended_run(conn, tid, outcome="external_recovered", summary=f"{bid} cleared",
+                                 metadata={ksb.CLEAR_FLAG: True})
+
+
+def note_probe_result(conn: sqlite3.Connection, task_id: str, cmd: str, rc: Any, out: str, now: float,
+                      every: Any) -> Optional[dict]:
+    """A legacy wake-check probe's result as a watch record (``kanban_external_adapters.shell``), for a scheduled
+    ci/deploy/external park. In the caller's write txn; never raises. Returns the ``external_result`` to carry on
+    a wake (exit 0 or a ``HERMES_WATCH`` line with a terminal job), else None. A GitHub run/PR park is also
+    recorded by the CI sweep (the richer adapter); the later record wins."""
+    from hermes_cli.kanban_external_adapters import shell
+    try:
+        ctx = park_context(conn, task_id)
+        if ctx is None or (ctx["awaiting"] or {}).get("kind") not in ks.EXTERNAL_KINDS:
+            return None
+        if (plan(conn, task_id, ctx) or {}).get("adapter") != "shell":
+            return None  # a GitHub run/PR park is recorded by the CI sweep's richer adapter
+        poll = shell.poll(rc, out)
+        got = record_poll(conn, task_id, poll, now=now, adapter="shell", scope="", every=every,
+                          service_name=poll.get("service_name"))
+    except (sqlite3.Error, ValueError, KeyError, TypeError):
+        logger.warning("kanban external watch: could not record the probe result of %s", task_id, exc_info=True)
+        return None
+    if got is None or not poll.get("terminal"):
+        return None
+    result = _result(got["rec"], got["derived"])
+    result["outcome"] = poll.get("outcome") or result["outcome"]
+    return result
