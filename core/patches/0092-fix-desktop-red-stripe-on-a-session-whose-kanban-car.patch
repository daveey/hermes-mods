From 8ee72ae067c2cca8182c17d140611f6532502a13 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 15 Oct 2026 13:29:47 -0700
Subject: [PATCH] fix(desktop): red stripe on a session whose kanban cards are
 blocked [daveey]

---
 apps/desktop/src/app/chat/sidebar/session-row.test.tsx | 10 ++++++++++
 apps/desktop/src/app/chat/sidebar/session-row.tsx      |  5 +++--
 apps/desktop/src/store/session-dot-state.test.ts       | 10 ++++++++++
 apps/desktop/src/store/session-dot-state.ts            |  9 ++++++---
 apps/desktop/src/store/sidebar-visible-order.ts        |  9 +++++++--
 5 files changed, 36 insertions(+), 7 deletions(-)

diff --git a/apps/desktop/src/app/chat/sidebar/session-row.test.tsx b/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
index 8719388420..6ae7491f70 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
@@ -497,6 +497,16 @@ describe('SidebarSessionRow kanban counts', () => {
     expect(counts.querySelector('[data-kanban-count="blocked"]')?.textContent).toBe('2')
   })
 
+  it('paints the red (stuck) stripe while a kanban card it created is blocked', () => {
+    const { container } = renderRow(
+      makeSession({ kanban_blocked: 1, message_count: 4, title: 'Blocked' } as Partial<SessionInfo> & {
+        title: string
+      })
+    )
+
+    expect(container.querySelector('[data-sidebar-stripe]')?.getAttribute('data-sidebar-stripe')).toBe('stuck')
+  })
+
   it('renders nothing when the session has no kanban work', () => {
     renderRow(makeSession({ title: 'Idle' }))
 
diff --git a/apps/desktop/src/app/chat/sidebar/session-row.tsx b/apps/desktop/src/app/chat/sidebar/session-row.tsx
index 7767d2c34c..88badb289c 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row.tsx
@@ -319,13 +319,14 @@ function SidebarSessionRowImpl({
   const liveTurn = hasLiveTurn(dotState)
   // [daveey] The left stripe is the session's status: green = its turn is done
   // and waiting on you (stays after you open it); red = not done but stuck
-  // (blocked on a prompt, or gone quiet mid-turn). Working: no stripe.
+  // (blocked on a prompt, or gone quiet mid-turn, or kanban cards it made are
+  // blocked on a human). Working: no stripe.
   // ⌘B parks a session as blocked: grey stripe, skipped by ⌘] / ⌘[.
   const userBlocked = useStoreSelector($blockedSessionIds, ids => isSessionBlocked(session.id, ids))
 
   const statusStripe = session.archived
     ? null
-    : sessionStatusStripe(dotState, session.message_count > 0, userBlocked)
+    : sessionStatusStripe(dotState, session.message_count > 0, userBlocked, kanbanBlocked)
 
   // Card header line: the workspace this belongs to — the project when it
   // resolves (same function the session color reads, so name and tint agree;
diff --git a/apps/desktop/src/store/session-dot-state.test.ts b/apps/desktop/src/store/session-dot-state.test.ts
index 8a15c6a0d4..80727a9dbc 100644
--- a/apps/desktop/src/store/session-dot-state.test.ts
+++ b/apps/desktop/src/store/session-dot-state.test.ts
@@ -70,6 +70,16 @@ describe('sessionStatusStripe', () => {
 
     expect(sessionStatusStripe('idle', false)).toBeNull()
   })
+
+  it('paints stuck (red) when kanban cards the session created are blocked, unless a turn is working', () => {
+    for (const state of ['idle', 'unread', 'background', 'draft'] as const) {
+      expect(sessionStatusStripe(state, true, false, 2)).toBe('stuck')
+    }
+
+    expect(sessionStatusStripe('working', true, false, 1)).toBeNull()
+    expect(sessionStatusStripe('idle', true, true, 1)).toBe('blocked')
+    expect(sessionStatusStripe('idle', true, false, 0)).toBe('done')
+  })
 })
 
 describe('hasLiveTurn', () => {
diff --git a/apps/desktop/src/store/session-dot-state.ts b/apps/desktop/src/store/session-dot-state.ts
index d9f5cde691..3141db7c87 100644
--- a/apps/desktop/src/store/session-dot-state.ts
+++ b/apps/desktop/src/store/session-dot-state.ts
@@ -140,17 +140,20 @@ export const showsRunningArc = (state: SessionDotState): boolean => state === 's
  *  after the row is opened; `stuck` (red) when an unfinished turn needs help —
  *  blocked on a prompt or gone quiet; `blocked` (grey) when the user parked
  *  it with ⌘B, which wins over everything. Working, background and drafts (no
- *  turn yet) get none. */
+ *  turn yet) get none — except that a session with kanban cards it created
+ *  sitting `blocked` (waiting on a human) is `stuck` too unless a turn is
+ *  actively working: it can't finish until someone unblocks them. */
 export type SessionStatusStripe = 'blocked' | 'done' | 'stuck'
 
 export const sessionStatusStripe = (
   state: SessionDotState,
   hasTurns: boolean,
-  userBlocked = false
+  userBlocked = false,
+  kanbanBlocked = 0
 ): null | SessionStatusStripe =>
   userBlocked
     ? 'blocked'
-    : state === 'needs-input' || state === 'stalled'
+    : state === 'needs-input' || state === 'stalled' || (kanbanBlocked > 0 && state !== 'working')
     ? 'stuck'
     : state === 'unread' || (state === 'idle' && hasTurns)
       ? 'done'
diff --git a/apps/desktop/src/store/sidebar-visible-order.ts b/apps/desktop/src/store/sidebar-visible-order.ts
index 7ba31c0a3e..f73a85dd39 100644
--- a/apps/desktop/src/store/sidebar-visible-order.ts
+++ b/apps/desktop/src/store/sidebar-visible-order.ts
@@ -109,11 +109,16 @@ export function sessionHasStatusStripe(id: string): boolean {
     }
   }
 
+  const session = $sessions.get().find(s => s.id === id)
+
   if (!hasTurns) {
-    hasTurns = ($sessions.get().find(session => session.id === id)?.message_count ?? 0) > 0
+    hasTurns = (session?.message_count ?? 0) > 0
   }
 
-  return sessionStatusStripe($sessionDotStateById.get()[id] ?? 'idle', hasTurns) !== null
+  return (
+    sessionStatusStripe($sessionDotStateById.get()[id] ?? 'idle', hasTurns, false, session?.kanban_blocked ?? 0) !==
+    null
+  )
 }
 
 /**
