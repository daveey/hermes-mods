diff --git a/hermes_cli/kanban_lanes_flow_pr.py b/hermes_cli/kanban_lanes_flow_pr.py
index bc20b1c11c..6e9a8ecafe 100644
--- a/hermes_cli/kanban_lanes_flow_pr.py
