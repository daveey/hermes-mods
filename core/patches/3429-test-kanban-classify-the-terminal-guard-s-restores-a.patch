From 4a0d94a83b192dc359d9beab2e7391b177a94fcb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 09:44:38 +0000
Subject: [PATCH] test(kanban): classify the terminal guard's restores as
 NOT_FROM_RUNNING [daveey]

main's source-receipt site guard (6c0b3a9dff) enumerates every status-leaving UPDATE.
enforce_after_apply skips running rows and _restore_held only touches done/archived
rows, so neither can end a running card.
---
 tests/hermes_cli/test_kanban_source_receipt_sites.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_source_receipt_sites.py b/tests/hermes_cli/test_kanban_source_receipt_sites.py
index ded0920142..edc5cfad44 100644
--- a/tests/hermes_cli/test_kanban_source_receipt_sites.py
+++ b/tests/hermes_cli/test_kanban_source_receipt_sites.py
@@ -313,6 +313,8 @@ INVOLUNTARY = {  # no receipt: custody becomes ``retained`` (fail closed)
 NOT_FROM_RUNNING = {
     "hermes_cli/kanban_assignment_routing.py::route": "runs inside block_task after apply_block_update left running",
     "hermes_cli/kanban_db.py::recompute_ready": "re-promotes todo/blocked/scheduled cards only",
+    "hermes_cli/kanban_terminal_guard.py::enforce_after_apply": "puts a held card back to done/archived; skips running",
+    "hermes_cli/kanban_terminal_guard.py::_restore_held": "only moves a done/archived row back to its held status",
 }
 
 
