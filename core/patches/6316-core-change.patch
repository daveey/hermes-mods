From f4bdb8c2e75ade6f69d70ced394ec4a3294ac099 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 03:14:06 +0000
Subject: [PATCH 6316] Immutable historical rejection observations and fresh audit cuts

Public mirror of source commit f4bdb8c2e75ade6f69d70ced394ec4a3294ac099.

---
diff --git a/hermes_cli/kanban_history_residue_board.py b/hermes_cli/kanban_history_residue_board.py
index a45d3ec2022..cb74aa6e83e 100644
--- a/hermes_cli/kanban_history_residue_board.py
+++ b/hermes_cli/kanban_history_residue_board.py
@@ -38,7 +38,8 @@
             path.chmod(0o600)
         except FileExistsError:
             pass
-    return sqlite3.connect(path.resolve().as_uri() + '?mode=rw', uri=True, isolation_level=None, timeout=0)
+    # Separate custody journal, never the live board or replica; no board lifecycle hooks.
+    return sqlite3.connect(path.resolve().as_uri() + '?mode=rw', uri=True, isolation_level=None, timeout=0)  # noqa: kanban-lockguard
 
 
 def audit_diff(live, shadow, hub, board, *, pulled, started):
diff --git a/tests/hermes_cli/test_kanban_history_residue_board.py b/tests/hermes_cli/test_kanban_history_residue_board.py
index 58c76d9af72..eabcabd7014 100644
--- a/tests/hermes_cli/test_kanban_history_residue_board.py
+++ b/tests/hermes_cli/test_kanban_history_residue_board.py
@@ -77,6 +77,24 @@
         conn.close()
 
 
+def test_custody_ledger_is_separate_from_live_board_and_replica(configured):
+    paths, _hub, _calls, _state, connect = configured
+    live, shadow = (connect(path) for path in paths)
+    before = [list(conn.iterdump()) for conn in (live, shadow)]
+    with board.closing(board._ledger('default', create=True)) as ledger:
+        opened = ledger.execute('PRAGMA database_list').fetchone()[2]
+        assert opened == str(paths[1].with_suffix('.history-residue.db'))
+        assert opened not in {str(path) for path in paths}
+        assert type(ledger) is sqlite3.Connection
+        assert ledger.isolation_level is None
+        assert ledger.execute('PRAGMA busy_timeout').fetchone()[0] == 0
+        ledger.execute('CREATE TABLE custody_probe (value TEXT)')
+        ledger.execute("INSERT INTO custody_probe VALUES ('receipt')")
+    assert [list(conn.iterdump()) for conn in (live, shadow)] == before
+    with board.closing(board._ledger('default')) as ledger:
+        assert ledger.execute('SELECT value FROM custody_probe').fetchall() == [('receipt',)]
+
+
 def test_observe_then_fresh_diff_preserves_all_original_bytes(configured):
     paths, hub, calls, _state, connect = configured
     live, shadow = (connect(path) for path in paths)
