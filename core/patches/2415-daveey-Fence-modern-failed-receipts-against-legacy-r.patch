From c61fc569b89cedf78bfbdc850be286cfeac8b831 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 21:30:36 +0000
Subject: [PATCH] [daveey] Fence modern failed receipts against legacy reclaim
 fallback

---
 gateway/session_kanban.py                     |  16 +--
 hermes_cli/kanban_db_dispatch.py              |   8 +-
 hermes_cli/kanban_failed_result.py            |  44 ++++++--
 .../test_kanban_failed_result_reconcile.py    | 101 +++++++++++++++++-
 4 files changed, 154 insertions(+), 15 deletions(-)

diff --git a/gateway/session_kanban.py b/gateway/session_kanban.py
index 0b7d6d5bdd..ddc19c9087 100644
--- a/gateway/session_kanban.py
+++ b/gateway/session_kanban.py
@@ -407,15 +407,19 @@ def _record_worker_result(context, code, last_output, failure=None, extra=None,
     from hermes_cli import kanban_db as kb
     from hermes_cli.kanban_quota_receipt import quota_fields, route_fields
     observer_error = None
+    strict_death_proof = False
     if code and not (extra or {}).get('continuable'):
+        from hermes_cli.kanban_failed_result import recorded_process_witnesses
         with connect_closing(Path(context['db'])) as conn:
             if not _bound_worker_matches(conn, context):
                 return
-        from hermes_cli.kanban_failed_result_observer import arm
-        try:
-            arm(context)
-        except (OSError, RuntimeError) as exc:
-            observer_error = str(exc)[:300]
+            strict_death_proof = recorded_process_witnesses(conn, context)
+        if strict_death_proof:
+            from hermes_cli.kanban_failed_result_observer import arm
+            try:
+                arm(context)
+            except (OSError, RuntimeError) as exc:
+                observer_error = str(exc)[:300]
     with connect_closing(Path(context['db'])) as conn, kb.write_txn(conn):
         if _bound_worker_matches(conn, context):
             if observer_error:
@@ -426,7 +430,7 @@ def _record_worker_result(context, code, last_output, failure=None, extra=None,
             kb._append_event(conn, context['task_id'], 'worker_result',
                 {'pid': os.getpid(), 'claim_lock': context['claim_lock'], 'exit_code': code,
                  'last_output': last_output, **quota_fields(failure), **route_fields(failure, agent),
-                 **(extra or {})},
+                 **(extra or {}), **({'death_proof_version': 1} if strict_death_proof else {})},
                 run_id=context['run_id'])
 
 
diff --git a/hermes_cli/kanban_db_dispatch.py b/hermes_cli/kanban_db_dispatch.py
index 4fb7b6d610..756df23161 100644
--- a/hermes_cli/kanban_db_dispatch.py
+++ b/hermes_cli/kanban_db_dispatch.py
@@ -1328,9 +1328,13 @@ def _reclaim_dead_workers(conn: sqlite3.Connection, board: Optional[str] = None,
                 continue
             # An ambiguous receipt holds the card while the attempt may still run; once nothing
             # can be executing it (a dead bound interpreter, or a run that never bound one): crash.
-            from hermes_cli.kanban_failed_result import failed_result_proof
+            from hermes_cli.kanban_failed_result import failed_result_proof, failed_result_receipt
             proof = failed_result_proof(conn, row['id'], row['current_run_id'], row['claim_lock'])
-            if failed_results_only and proof is None:
+            receipt = failed_result_receipt(conn, row['id'], row['current_run_id'], row['claim_lock'])
+            if proof is None and (failed_results_only or (
+                    receipt is not None and receipt['result'].get('death_proof_version') == 1)):
+                # Versioned receipts require the two-process fence even during
+                # ordinary dispatch. Historical receipts retain legacy recovery.
                 continue
             if proof is None and owner_reclaim_blocked(conn, row["id"], crash_sweep=True):
                 continue
diff --git a/hermes_cli/kanban_failed_result.py b/hermes_cli/kanban_failed_result.py
index 4ca553e77d..a0cf94fc41 100644
--- a/hermes_cli/kanban_failed_result.py
+++ b/hermes_cli/kanban_failed_result.py
@@ -51,8 +51,32 @@ def process_gone(pid, birth) -> bool:
     return False
 
 
-def failed_result_proof(conn, task_id, run_id, claim_lock):
-    """Return latest attributable failed result only after both processes exit."""
+def recorded_process_witnesses(conn, context):
+    """Whether this claim was launched with the modern two-process identity contract.
+
+    Legacy imports and unverified launches cannot opt into bounded reconciliation;
+    their pre-existing dispatcher policy is intentionally unchanged.
+    """
+    row = conn.execute('SELECT worker_started_at FROM tasks WHERE id=? AND current_run_id=? AND claim_lock=?',
+                       (context['task_id'], context['run_id'], context['claim_lock'])).fetchone()
+    bound = conn.execute("SELECT payload FROM task_events WHERE task_id=? AND run_id=? "
+                         "AND kind='worker_bound' ORDER BY id DESC LIMIT 1",
+                         (context['task_id'], context['run_id'])).fetchone()
+    if row is None or bound is None:
+        return False
+    try:
+        birth = json.loads(bound['payload']).get('started_at')
+    except (TypeError, ValueError, AttributeError):
+        return False
+    return all(isinstance(value, str) and '|' in value for value in (row['worker_started_at'], birth))
+
+
+def failed_result_receipt(conn, task_id, run_id, claim_lock):
+    """Return an attributable failure independently of its process death proof.
+
+    A receipt with an unproven death must veto legacy reclaim, not fall through
+    to its weaker outer-process-only checks.
+    """
     from hermes_cli import kanban_db as kb
 
     row = conn.execute(
@@ -90,9 +114,17 @@ def failed_result_proof(conn, task_id, run_id, claim_lock):
             or result.get('continuable') or result_event['id'] <= bound_event['id']
             or result.get('pid') != bound.get('pid')):
         return None
-    if not process_gone(row['worker_pid'], row['worker_started_at']):
+    return {'source_result_event_id': result_event['id'],
+            'result_recorded_at': result_event['created_at'], 'result': result,
+            'outer': (row['worker_pid'], row['worker_started_at']),
+            'bound': (bound.get('pid'), bound.get('started_at'))}
+
+
+def failed_result_proof(conn, task_id, run_id, claim_lock):
+    """Return latest attributable failed result only after both processes exit."""
+    receipt = failed_result_receipt(conn, task_id, run_id, claim_lock)
+    if receipt is None:
         return None
-    if not process_gone(bound.get('pid'), bound.get('started_at')):
+    if not process_gone(*receipt.pop('outer')) or not process_gone(*receipt.pop('bound')):
         return None
-    return {'source_result_event_id': result_event['id'],
-            'result_recorded_at': result_event['created_at'], 'result': result}
+    return receipt
diff --git a/tests/hermes_cli/test_kanban_failed_result_reconcile.py b/tests/hermes_cli/test_kanban_failed_result_reconcile.py
index 1258c085b9..3a47ffe465 100644
--- a/tests/hermes_cli/test_kanban_failed_result_reconcile.py
+++ b/tests/hermes_cli/test_kanban_failed_result_reconcile.py
@@ -96,9 +96,33 @@ def test_failed_child_reconciles_without_owner_progress(board, entry):
     assert run['ended_at'] >= result['created_at']
     # A subsequent healthy tick cannot close/account the same failed run twice.
     kbd.detect_crashed_workers(conn)
-    crashes = conn.execute("SELECT id FROM task_events WHERE run_id=? AND kind='crashed'",
+    crashes = conn.execute("SELECT id, payload FROM task_events WHERE run_id=? AND kind='crashed'",
                            (context['run_id'],)).fetchall()
     assert len(crashes) == 1
+    payload = json.loads(crashes[0]['payload'])
+    assert payload['source_result_event_id'] == result['id']
+    assert payload['result_recorded_at'] == result['created_at']
+    assert payload['reconciled_at'] >= result['created_at']
+    assert payload['reconciled_by'] == ('dispatcher' if entry == 'dispatcher' else 'observer')
+
+
+def test_observer_dispatcher_race_closes_and_accounts_once(board):
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier
+    conn, context = board
+    _failed_child(conn, context)
+    barrier = Barrier(2)
+    def sweep(observer):
+        with connect_closing(Path(context['db'])) as connection:
+            barrier.wait(timeout=10)
+            return kbd.detect_crashed_workers(connection, failed_results_only=observer)
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(sweep, [False, True]))
+    assert sum(len(result) for result in results) == 1
+    assert conn.execute('SELECT consecutive_failures FROM tasks WHERE id=?',
+                        (context['task_id'],)).fetchone()[0] == 1
+    assert len(conn.execute("SELECT 1 FROM task_events WHERE run_id=? AND kind='crashed'",
+                            (context['run_id'],)).fetchall()) == 1
 
 
 def test_board_only_proof_accepts_real_dead_child(board):
@@ -183,6 +207,81 @@ def test_observer_waits_for_distinct_outer_process(board):
             outer.wait()
 
 
+@pytest.mark.parametrize('entry', ['dispatcher', 'observer'])
+def test_failed_receipt_waits_for_real_bound_process(board, entry):
+    conn, context = board
+    outer = subprocess.Popen([sys.executable, '-c', 'import sys; sys.stdin.read(1)'],
+                             stdin=subprocess.PIPE, env=build_subprocess_env())
+    child = None
+    try:
+        kbd._set_worker_pid(conn, context['task_id'], outer.pid)
+        assert outer.stdin is not None
+        outer.stdin.close()
+        outer.wait(timeout=5)
+        script = _CHILD.replace('sys.stdin.read(1)', 'pass').replace(
+            'raise SystemExit(1)', "print('RESULT_COMMITTED', flush=True)\nsys.stdin.read(1)\nraise SystemExit(1)")
+        child = subprocess.Popen(
+            [sys.executable, '-c', script, json.dumps(context),
+             'observe' if entry == 'observer' else 'unit'],
+            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            env=build_subprocess_env(), text=True, encoding='utf-8',
+            cwd=str(Path(__file__).resolve().parents[2]))
+        assert child.stdout is not None
+        import select
+        ready, _, _ = select.select([child.stdout], [], [], 15)
+        assert ready, 'child did not commit its result'
+        assert child.stdout.readline().strip() == 'RESULT_COMMITTED'
+        hold_until = time.monotonic() + 1
+        while time.monotonic() < hold_until:
+            if entry == 'dispatcher':
+                kbd.detect_crashed_workers(conn)
+            assert child.poll() is None
+            assert conn.execute('SELECT status FROM task_runs WHERE id=?',
+                                (context['run_id'],)).fetchone()[0] == 'running'
+            time.sleep(.05)
+        child.communicate('x', timeout=5)
+        deadline = time.monotonic() + 5
+        state = 'running'
+        while time.monotonic() < deadline:
+            if entry == 'dispatcher':
+                kbd.detect_crashed_workers(conn)
+            state = conn.execute('SELECT status FROM task_runs WHERE id=?',
+                                 (context['run_id'],)).fetchone()[0]
+            if state != 'running':
+                break
+            time.sleep(.05)
+        assert state == 'crashed'
+    finally:
+        for proc in (child, outer):
+            if proc is not None and proc.poll() is None:
+                proc.kill()
+                proc.wait()
+
+
+@pytest.mark.parametrize('entry', ['dispatcher', 'observer'])
+@pytest.mark.parametrize('veto', ['bound_live', 'outer_recycled', 'bound_recycled', 'unknown_birth'])
+def test_failed_receipt_veto_cannot_fall_back_to_legacy_reclaim(board, monkeypatch, entry, veto):
+    from hermes_cli import kanban_failed_result as reconcile
+    from hermes_cli import kanban_owner_recovery as owner
+    conn, context = board
+    _failed_child(conn, context)
+    calls = []
+    def gone(pid, birth):
+        calls.append((pid, birth))
+        return len(calls) == 1 if veto.startswith('bound') else False
+    monkeypatch.setattr(reconcile, 'process_gone', gone)
+    # Model legacy liveness accepting dead/recycled outer identity. It must not
+    # override the stronger two-process failed-result veto, or consult state.db.
+    monkeypatch.setattr(kbd, '_worker_alive', lambda *args: False)
+    monkeypatch.setattr(owner, 'owner_reclaim_blocked', lambda *a, **k: False)
+    monkeypatch.setattr(owner, 'apply_attempt_note', lambda *a, **k: None)
+    kbd.detect_crashed_workers(conn, failed_results_only=entry == 'observer')
+    assert conn.execute('SELECT status FROM task_runs WHERE id=?',
+                        (context['run_id'],)).fetchone()[0] == 'running'
+    assert not conn.execute("SELECT 1 FROM task_events WHERE run_id=? AND kind='crashed'",
+                            (context['run_id'],)).fetchone()
+
+
 @pytest.mark.skipif(sys.platform != 'linux', reason='Linux zombie identity proof')
 def test_real_zombie_is_dead_only_with_matching_birth():
