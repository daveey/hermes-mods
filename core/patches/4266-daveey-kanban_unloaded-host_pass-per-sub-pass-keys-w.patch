+    assert len(keys[0]) == 1 and keys[0] == keys[1] == keys[2]  # same kept reader: one entry, never a fresh key
+    [(key_db, _conn, _sql)] = keys[0]
+    assert not isinstance(key_db, NoticeSessionStore)
