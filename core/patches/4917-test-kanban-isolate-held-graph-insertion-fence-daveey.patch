Date: Thu, 19 Nov 2026 00:28:46 +0000
Subject: [PATCH] test(kanban): isolate held graph insertion fence [daveey]

The SQL-only mutation batch exposed a surviving trigger-removal gap: replica insertion coverage did not exercise an ordinary insert. Assert both held endpoints refuse without a replica permit and an independent edge remains legal. Canonical test file passes with the new control.
---
 .../test_kanban_containment_sql_adjacent.py          | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_containment_sql_adjacent.py b/tests/hermes_cli/test_kanban_containment_sql_adjacent.py
index 1541d4d755328461b0d79204ab79ac435aa389b8..16628e3426296cc675101442a8e1c9aa9480820d 100644
--- a/tests/hermes_cli/test_kanban_containment_sql_adjacent.py
+++ b/tests/hermes_cli/test_kanban_containment_sql_adjacent.py
@@ -81,6 +81,18 @@ def test_replica_edge_permit_is_insert_only(board):
             board.execute("UPDATE task_links SET parent_id=? WHERE parent_id=? AND child_id=?", (other, task, other))
 
 
+def test_ordinary_edge_insert_cannot_extend_held_graph(board):
+    task = _held(board)
+    other = kb.create_task(board, title="Fixture peer", assignee="default")
+    independent = kb.create_task(board, title="Fixture control", assignee="default")
+    with kb.write_txn(board):
+        with pytest.raises(sqlite3.IntegrityError, match="containment_pending"):
+            board.execute("INSERT INTO task_links(parent_id,child_id) VALUES (?,?)", (task, other))
+        with pytest.raises(sqlite3.IntegrityError, match="containment_pending"):
+            board.execute("INSERT INTO task_links(parent_id,child_id) VALUES (?,?)", (other, task))
+        board.execute("INSERT INTO task_links(parent_id,child_id) VALUES (?,?)", (independent, other))
+
+
 def test_attestation_insert_and_update_are_fenced(board):
     task = _held(board)
     values = (task, "fixture-receipt", "fixture-episode", "a" * 64, "b" * 64)
