From 3f9469e38a742e343306420940aff89a39a32dae Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:57:06 +0000
Subject: [PATCH] fix(kanban): capability-owner parks declare their producer to
 the no-producer-no-park gate [daveey]

57094b7a60 refuses a park whose reason reads like an agent wall ('denied') unless a producing
card is declared. A capability route now parks with awaiting={kind:'card', ref:<hermes-hub
request id>, gateway:<holder>}; kanban_awaiting accepts a capability-owner request ref while
the request is pending or its owner card is live (owner_status rc 0/1), and refuses a rejected
or unknown one.
---
 hermes_cli/kanban_awaiting.py                      | 9 +++++++++
 hermes_cli/kanban_capability_routing.py            | 5 ++++-
 tests/hermes_cli/test_kanban_capability_routing.py | 4 ++++
 3 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_awaiting.py b/hermes_cli/kanban_awaiting.py
index 01b0e02bbe..5205c5b7fe 100644
--- a/hermes_cli/kanban_awaiting.py
+++ b/hermes_cli/kanban_awaiting.py
@@ -239,6 +239,15 @@ def confirm_remote(awaiting: Optional[dict]) -> None:
 
 def _check_card(conn: sqlite3.Connection, task_id: str, awaiting: dict, text: str) -> None:
     ref = awaiting.get("ref") or ""
+    if ref.startswith("capability-owner:"):
+        # A cross-gateway capability owner card, named by its hermes-hub request id until the holder
+        # applies it (kanban_capability_routing). Live while the request is pending or the card runs.
+        from hermes_cli.kanban_capability_routing import owner_status
+        rc, out = owner_status(ref)
+        if rc == 2:
+            raise AwaitingError(INVALID_AWAITING, f"capability owner request is not live: {out[-200:]}")
+        awaiting["observed"] = out[-120:]
+        return
     if not _TASK_ID.fullmatch(ref):
         raise AwaitingError(INVALID_AWAITING, f"awaiting kind='card' needs ref=<task id> (got {ref!r})")
     if ref == task_id:
diff --git a/hermes_cli/kanban_capability_routing.py b/hermes_cli/kanban_capability_routing.py
index 72a6e00d2a..c07639c2da 100644
--- a/hermes_cli/kanban_capability_routing.py
+++ b/hermes_cli/kanban_capability_routing.py
@@ -319,8 +319,11 @@ def route(conn, task_id: str, needs, *, reason: str, expected_run_id: Optional[i
                 "worker will hit the wall and can block with needs (the same owner request is reused).",
                 details={"routes": routes})
         source = kb._retry_status_for_run(conn, task_id) if cur and cur[0] == "running" else "ready"
+        first = routes[0]
         ok = ktp.park(conn, task_id, reason=park_reason, requested_kind="capability", source_status=source,
-                      expected_run_id=expected_run_id, wake_check=wake_check, check_every=WAKE_EVERY)
+                      expected_run_id=expected_run_id, wake_check=wake_check, check_every=WAKE_EVERY,
+                      awaiting={"kind": "card", "ref": first["request_id"], "gateway": first["gateway"],
+                                "why": f"capability owner for {', '.join(x['need'] for x in routes)}"})
         if not ok:
             raise CapabilityRouteError(
                 "capability_route_invalid_state",
diff --git a/tests/hermes_cli/test_kanban_capability_routing.py b/tests/hermes_cli/test_kanban_capability_routing.py
index ce522c6fe3..7262bcc6c1 100644
--- a/tests/hermes_cli/test_kanban_capability_routing.py
+++ b/tests/hermes_cli/test_kanban_capability_routing.py
@@ -165,6 +165,10 @@ def test_replay_t5bc8e125_block_opens_macbook_owner_card_and_parks(env, monkeypa
         assert routed["routes"][0]["request_id"] == rid
         assert routed["awaiting"][0] == {"kind": "card", "ref": f"macbook/request/{rid}",
                                          "why": f"capability {NEED}"}
+        # The no-producer-no-park contract sees a declared, live producer card.
+        parked = [e for e in kb.list_events(conn, tid) if e.kind == "scheduled"][-1].payload
+        assert parked["awaiting"]["kind"] == "card" and parked["awaiting"]["ref"] == rid
+        assert parked["awaiting"]["gateway"] == "macbook" and "request local" in parked["awaiting"]["observed"]
 
     # The hub card waits on the owner card: pending -> running -> done wakes it.
     assert kcr.wait_check(rid)[0] == 1
-- 
2.55.0

