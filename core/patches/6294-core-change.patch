Subject: [PATCH 6294] Fail-closed startup readiness and natural controller rollover

Public mirror of source commit 81b44acafd416b7d0c4c67a6e24b13ea172a4a27.

---
diff --git a/hermes_cli/always_on_deployment.py b/hermes_cli/always_on_deployment.py
new file mode 100644
index 00000000000..0f70acb6b6b
--- /dev/null
+++ b/hermes_cli/always_on_deployment.py
@@ -0,0 +1,39 @@
+"""Migrate legacy standalone controllers to a checkout-backed stdlib loader. [daveey]
+
+The backend launcher follows the installed checkout, but early Linux installs copied the controller
+and roller beside each other. Updating core and naturally restarting that controller then retained
+obsolete drain policy. Update only that known legacy entrypoint, before the normal warm-roll request;
+no unit/template rewrite, service action or backend signal belongs here.
+"""
+from pathlib import Path
+
+from hermes_cli import always_on_dashboard as aod
+from hermes_cli._startup_fast import project_root_str
+
+_MARKER = '# Hermes installed-checkout controller loader v1'
+
+
+def refresh_standalone_controller() -> None:
+    entry = Path.home() / '.local/share/hermes-always-on/always_on_dashboard.py'
+    if not entry.exists():
+        return
+    if entry.is_symlink():
+        raise OSError(f'refusing symlink controller entrypoint: {entry}')
+    previous = entry.read_text(encoding='utf-8-sig')
+    if _MARKER not in previous and 'def _interim_main()' not in previous:
+        raise OSError(f'unrecognized standalone controller: {entry}')
+    # This module is imported from the installed core during the updater's dashboard refresh.
+    # Resolve the root, not the interpreter/venv: all three controller actions are stdlib-only.
+    root = project_root_str()
+    source = f'''{_MARKER}
+import argparse
+import sys
+sys.path.insert(0, {root!r})
+from hermes_cli.always_on_dashboard import build_always_on_dashboard_parser
+parser = argparse.ArgumentParser()
+build_always_on_dashboard_parser(parser.add_subparsers())
+args = parser.parse_args(['always-on-dashboard', *sys.argv[1:]])
+raise SystemExit(args.func(args))
+'''
+    if previous != source:
+        aod._write_private(entry, source)
diff --git a/hermes_cli/always_on_rollover.py b/hermes_cli/always_on_rollover.py
index 144730d4730..524ec0fc5a5 100644
--- a/hermes_cli/always_on_rollover.py
+++ b/hermes_cli/always_on_rollover.py
@@ -262,9 +262,12 @@
 def request_roll(run: Callable = subprocess.run) -> bool:
     """Ask the roller unit for a warm roll without waiting for it (``hermes update``'s dashboard refresh)."""
     try:
+        from hermes_cli.always_on_deployment import refresh_standalone_controller
+        refresh_standalone_controller()
         return run(["systemctl", "--user", "restart", "--no-block", ROLLER_UNIT], capture_output=True,
                    text=True, encoding="utf-8", errors="replace", timeout=15).returncode == 0
-    except (OSError, subprocess.SubprocessError):
+    except (OSError, subprocess.SubprocessError) as exc:
+        log(f"warm roll request failed: {exc}")
         return False
 
 
diff --git a/tests/hermes_cli/test_always_on_deployment.py b/tests/hermes_cli/test_always_on_deployment.py
new file mode 100644
index 00000000000..5ea1e0f00fa
--- /dev/null
+++ b/tests/hermes_cli/test_always_on_deployment.py
@@ -0,0 +1,112 @@
+"""A natural update must refresh the controller consumer, not just backend code."""
+from __future__ import annotations
+
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import always_on_deployment as deployment
+from hermes_cli import always_on_rollover as ro
+
+
+def test_natural_roll_replaces_legacy_entrypoint_before_restart(tmp_path, monkeypatch):
+    monkeypatch.setenv('HOME', str(tmp_path))
+    entry = tmp_path / '.local/share/hermes-always-on/always_on_dashboard.py'
+    entry.parent.mkdir(parents=True)
+    entry.write_text('def _interim_main():\n    return 0\n')
+    calls = []
+
+    def run(argv, **kwargs):
+        calls.append(argv)
+        # A natural controller restart must no longer execute the copied implementation.
+        assert '_interim_main' not in entry.read_text()
+        assert 'hermes_cli' in entry.read_text()
+        return subprocess.CompletedProcess(argv, 0)
+
+    assert ro.request_roll(run=run)
+    assert calls == [['systemctl', '--user', 'restart', '--no-block', ro.ROLLER_UNIT]]
+    # Same command shape as the deployed unit, without starting a controller or touching services.
+    result = subprocess.run([sys.executable, '-S', str(entry), 'run', '--help'],
+                            capture_output=True, text=True, check=False)
+    assert result.returncode == 0, result.stderr
+    assert '--port' in result.stdout
+    assert ro.request_roll(run=run)  # idempotent after migration
+
+
+def test_no_standalone_install_does_not_create_one(tmp_path, monkeypatch):
+    monkeypatch.setenv('HOME', str(tmp_path))
+    calls = []
+    assert ro.request_roll(run=lambda argv, **kw: calls.append(argv) or subprocess.CompletedProcess(argv, 0))
+    assert len(calls) == 1
+    assert not (tmp_path / '.local/share/hermes-always-on').exists()
+
+
+@pytest.mark.parametrize('symlink', [False, True])
+def test_unknown_or_symlink_entrypoint_is_preserved_without_restart(tmp_path, monkeypatch, symlink):
+    monkeypatch.setenv('HOME', str(tmp_path))
+    entry = tmp_path / '.local/share/hermes-always-on/always_on_dashboard.py'
+    entry.parent.mkdir(parents=True)
+    original = 'raise RuntimeError("custom controller")\n'
+    if symlink:
+        target = tmp_path / 'custom.py'
+        target.write_text(original)
+        entry.symlink_to(target)
+    else:
+        entry.write_text(original)
+    calls = []
+    assert not ro.request_roll(run=lambda argv, **kw: calls.append(argv))
+    assert not calls
+    assert entry.read_text() == original
+
+
+def test_loader_uses_current_checkout_not_adjacent_stale_roller(tmp_path, monkeypatch):
+    monkeypatch.setenv('HOME', str(tmp_path))
+    core = tmp_path / 'installed core'
+    package = core / 'hermes_cli'
+    package.mkdir(parents=True)
+    (package / '__init__.py').write_text('')
+    (package / 'always_on_rollover.py').write_text('SUPERSEDED_GRACE_S = 30\n')
+    (package / 'always_on_dashboard.py').write_text('''from .always_on_rollover import SUPERSEDED_GRACE_S
+
+def build_always_on_dashboard_parser(subparsers):
+    parser = subparsers.add_parser('always-on-dashboard')
+    parser.add_argument('action')
+    parser.add_argument('--port')
+    parser.add_argument('--hermes')
+    parser.set_defaults(func=lambda args: print(args.action, args.port, args.hermes, SUPERSEDED_GRACE_S) or 0)
+''')
+    monkeypatch.setattr(deployment, 'project_root_str', lambda: str(core))
+    entry = tmp_path / '.local/share/hermes-always-on/always_on_dashboard.py'
+    entry.parent.mkdir(parents=True)
+    entry.write_text('def _interim_main():\n    return 0\n')
+    stale = entry.with_name('always_on_rollover.py')
+    stale.write_text('raise RuntimeError("stale roller imported")\n')
+    deployment.refresh_standalone_controller()
+    inode = entry.stat().st_ino
+    deployment.refresh_standalone_controller()
+    assert entry.stat().st_ino == inode  # no-op refresh, not an unnecessary replace
+    result = subprocess.run([sys.executable, '-S', str(entry), 'backend', '--port', '9150', '--hermes', '/a b/hermes'],
+                            capture_output=True, text=True, check=False)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.strip() == 'backend 9150 /a b/hermes 30'
+    assert stale.read_text() == 'raise RuntimeError("stale roller imported")\n'
+    assert entry.stat().st_mode & 0o777 == 0o600
+
+
+def test_failed_entrypoint_publication_does_not_restart(tmp_path, monkeypatch):
+    monkeypatch.setenv('HOME', str(tmp_path))
+    entry = tmp_path / '.local/share/hermes-always-on/always_on_dashboard.py'
+    entry.parent.mkdir(parents=True)
+    original = 'def _interim_main():\n    return 0\n'
+    entry.write_text(original)
+
+    def fail(*args):
+        raise OSError('publication failed')
+
+    monkeypatch.setattr(deployment.aod, '_write_private', fail)
+    calls = []
+    assert not ro.request_roll(run=lambda argv, **kw: calls.append(argv))
+    assert not calls
+    assert entry.read_text() == original
