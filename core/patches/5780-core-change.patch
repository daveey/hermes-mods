From 09a7eb90c69bf2142f83e22058705f1ef3e88ff8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 19:24:07 +0000
Subject: [PATCH] docs(kanban): clarify exact alias and partition resolution
 [daveey]

---
 hermes_cli/kanban_comment_origin.py | 2 +-
 hermes_cli/kanban_wait_check.py     | 5 +++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_comment_origin.py b/hermes_cli/kanban_comment_origin.py
index 58f35a6486..02f785d79b 100644
--- a/hermes_cli/kanban_comment_origin.py
+++ b/hermes_cli/kanban_comment_origin.py
@@ -9,7 +9,7 @@ comments ``WHERE author = 'macbook'`` therefore never sees the relay's ``hub:gw:
   an author spelling names (``hub:gw:<x>``, ``<x>/t_...``), else this gateway's own name;
 * ``hermes kanban wait-comment <task> --after-id N [--from-gateway X] [--contains TEXT]``: the wake probe
   for "a reply arrived": exit 0 on a match, 1 not yet, 2 cannot tell. A gateway matches on
-  ``origin_gateway`` or on any author spelling containing it;
+  ``origin_gateway`` or an exact supported author spelling (relay, card, bare gateway, or gateway-chat);
 * ``author_probe``: the park guard refuses a wake check that filters ``task_comments`` by author
   (``=``, ``like``, ``glob``, ``in``; ``!=`` to skip one's own notes is fine) and names the wait-comment
   command to use. Off switch: ``kanban.author_probe_guard: false``;
diff --git a/hermes_cli/kanban_wait_check.py b/hermes_cli/kanban_wait_check.py
index 645355ac35..72a137a8db 100644
--- a/hermes_cli/kanban_wait_check.py
+++ b/hermes_cli/kanban_wait_check.py
@@ -152,8 +152,9 @@ def _unreachable_task(gateway, target, *, board, until, since, live_timeout) ->
 def current_gateway(gateway: str) -> str:
     """``gateway`` as this host's hub.db knows it today: a probe parked before an in-place rename still names
     the old gateway (``--gateway mini``), and the owner's records now sit under the new name. Resolved from
-    ``kanban.placement.aliases`` and the local hub.db only (``kanban_gateway_alias.current``): no network, and
-    the name is unchanged until the new one has records here. Never raises."""
+    ``kanban.placement.aliases`` and the local hub.db only (``kanban_gateway_alias.current``): no network.
+    A present explicit partition is never overridden; an absent one needs a unique known equivalent.
+    Map direction can lag feed delivery. Never raises."""
     try:
         from hermes_cli import kanban_gateway_alias
         if len(kanban_gateway_alias.spellings(gateway)) < 2:
-- 
