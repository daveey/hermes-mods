From fa8d499d391a8476fd1a6fc195245e81f7bdd8ae Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 08:18:00 +0000
Subject: [PATCH] [daveey] Hold the registry lock itself in the finalizer
 collection and exit tests

offline_file_access now reserves a path and releases _live_lock across its body, so the two
tests that used it as a stand-in lock holder no longer held the lock. They hold _live_lock
directly, as test_kanban_reader_close_isolation already does.
---
 tests/hermes_cli/test_sqlite_safe_read_finalizer.py | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_sqlite_safe_read_finalizer.py b/tests/hermes_cli/test_sqlite_safe_read_finalizer.py
index e2448cd419..ea0ff02135 100644
--- a/tests/hermes_cli/test_sqlite_safe_read_finalizer.py
+++ b/tests/hermes_cli/test_sqlite_safe_read_finalizer.py
@@ -224,7 +224,9 @@ def test_collection_never_waits_for_the_guard(db, tmp_path):
         holding, done = threading.Event(), threading.Event()
 
         def hold():
-            with offline_file_access(tmp_path / "other.db"):
+            # Hold the registry lock itself: offline_file_access only reserves a path and
+            # releases the lock across its body, so it no longer stands in for a lock holder.
+            with sr._live_lock:
                 holding.set()
                 done.wait(10)
 
@@ -347,7 +349,8 @@ def test_exit_with_a_leaked_connection_is_clean(tmp_path):
         del h
         held = threading.Event()
         def worker():
-            with sr.offline_file_access(other):
+            # The registry lock itself: offline_file_access releases it across its body.
+            with sr._live_lock:
                 held.set(); time.sleep(60)
         threading.Thread(target=worker, daemon=True).start()
         held.wait()
-- 
