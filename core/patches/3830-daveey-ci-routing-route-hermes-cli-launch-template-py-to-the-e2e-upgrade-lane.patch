From b189612113f64255ae848d5e2dcb059d623c4754 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:19:40 +0000
Subject: [PATCH] [daveey] ci routing: route hermes_cli/_launch_template.py to
 the e2e-upgrade lane

venv_sync.relaunch_command now builds its relaunch prefix from
hermes_cli/_launch_template.relaunch_prefix, so the update entry point
imports _launch_template. tests/ci/test_update_ci_routing.py
(test_every_module_an_update_entry_point_imports_starts_its_suite[e2e_upgrade])
went red on bca220a554 in CI run 43495066100; list the module in
_UPDATE_PIPELINE next to venv_sync.
---
 scripts/ci/classify_changes.py | 1 +
 1 file changed, 1 insertion(+)

diff --git a/scripts/ci/classify_changes.py b/scripts/ci/classify_changes.py
index a0a1dc41c0..102865e695 100644
--- a/scripts/ci/classify_changes.py
+++ b/scripts/ci/classify_changes.py
@@ -382,6 +382,7 @@ _UPDATE_PIPELINE = (
     # Prefix: _early_recovery.py and its _early_recovery_* siblings (ZIP swap journal).
     "hermes_cli/_early_recovery",  # interrupted pull / shim restore at launch
     "hermes_cli/venv_sync.py",  # completion obligation + launch-time tail
+    "hermes_cli/_launch_template.py",  # venv_sync's relaunch prefix text
     "hermes_cli/launch_probe.py",  # venv_sync's bounded launch-time currency probe
     "hermes_cli/source_",  # source_completion/_build/_releases/_check/_stamp
     "hermes_cli/_launchers.py",
-- 
