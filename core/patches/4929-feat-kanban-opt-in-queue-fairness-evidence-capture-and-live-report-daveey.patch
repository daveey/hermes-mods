diff --git a/hermes_cli/kanban_fairness_inventory.py b/hermes_cli/kanban_fairness_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..4ef79f81333051029af126af8d00d2ec55d1947e
--- /dev/null
+++ b/hermes_cli/kanban_fairness_inventory.py
@@ -0,0 +1,91 @@
+"""Finite producer and alarm inventory for the queue-fairness evidence. [daveey]
+
+``scan`` walks named source trees once and returns every line that sets a flat top priority
+(``priority=1000``, ``"priority": 1000``, ``p1000``) or mentions an alarm key prefix, plus a hash of each tree.
+``check`` compares those matches with a hand-written classification: one row per match saying what the
+producer or detector is and how it is disposed. A match with no row, or a row whose match is gone, makes the
+inventory incomplete; nothing is classified by its title or guessed. Trees differ per executor, so the
+operator runs ``scan`` on each one and ``check`` once per distinct tree hash.
+"""
+from __future__ import annotations
+
+import hashlib
+import re
+from pathlib import Path
+from typing import Iterable
+
+from hermes_cli.kanban_admission_score import ALARM_KEY_PREFIXES
+from hermes_cli.kanban_fairness_schema import VERSION
+
+# Keys that look like alarms but that the scorer does not floor: they must be classified, not assumed.
+ALARM_CANDIDATE_PREFIXES = ("worker-resources-unknown:", "turn-urgency-health:")
+_PRIORITY = re.compile(r"""priority["']?\s*[=:]\s*["']?1000\b|\bp1000\b""", re.IGNORECASE)
+_SUFFIXES = {".py", ".md", ".json", ".yaml", ".yml", ".toml", ".sh", ""}
+_SKIP_DIRS = {".git", "node_modules", "__pycache__", ".venv", ".worktrees", "dist", "build"}
+_MAX_FILE_BYTES = 2 * 1024 * 1024
+DISPOSITIONS = ("inherits_parent", "explicit_user_urgency", "flat_default", "not_a_producer", "floored",
+                "not_floored")
+
+
+def _files(root: Path) -> Iterable[Path]:
+    for path in sorted(root.rglob("*")):
+        if path.is_file() and path.suffix in _SUFFIXES and not _SKIP_DIRS.intersection(path.parts) \
+                and path.stat().st_size <= _MAX_FILE_BYTES:
+            yield path
+
+
+def match_id(tree: str, path: str, text: str) -> str:
+    """Stable across line moves: the tree's name, the file and the matched line's text."""
+    return hashlib.sha256(f"{tree}\0{path}\0{text}".encode()).hexdigest()[:16]
+
+
+def scan(trees: dict[str, Path]) -> dict:
+    """``{"trees": {name: {root, sha256, files}}, "producers": [...], "alarms": [...]}``."""
+    prefixes = ALARM_KEY_PREFIXES + ALARM_CANDIDATE_PREFIXES
+    out: dict = {"version": VERSION, "trees": {}, "producers": [], "alarms": []}
+    for name, root in sorted(trees.items()):
+        digest, count = hashlib.sha256(), 0
+        for path in _files(root):
+            data = path.read_bytes()
+            rel = path.relative_to(root).as_posix()
+            digest.update(f"{rel}\0{hashlib.sha256(data).hexdigest()}\n".encode())
+            count += 1
+            for number, line in enumerate(data.decode("utf-8", "replace").splitlines(), 1):
+                text = line.strip()
+                row = {"tree": name, "path": rel, "line": number, "text": text[:240],
+                       "id": match_id(name, rel, text)}
+                if _PRIORITY.search(line):
+                    out["producers"].append(row)
+                found = [p for p in prefixes if p in line]
+                if found:
+                    out["alarms"].append({**row, "prefixes": found})
+        out["trees"][name] = {"root": str(root), "sha256": digest.hexdigest(), "files": count}
+    return out
+
+
+def check(scanned: dict, classification: dict) -> dict:
+    """Every match needs exactly one valid classification row, and every row a live match."""
+    problems: list[dict] = []
+    result = {"version": VERSION, "trees": scanned["trees"], "problems": problems}
+    for kind in ("producers", "alarms"):
+        rows, seen = {}, set()
+        for row in classification.get(kind) or []:
+            if not isinstance(row, dict) or row.get("disposition") not in DISPOSITIONS \
+                    or not row.get("family") or not row.get("id"):
+                problems.append({"kind": kind, "problem": "invalid_row", "row": row})
+                continue
+            rows[row["id"]] = row
+        classified = []
+        for match in scanned[kind]:
+            row = rows.get(match["id"])
+            if row is None:
+                problems.append({"kind": kind, "problem": "unclassified", "match": match})
+                continue
+            seen.add(match["id"])
+            classified.append({**match, "family": row["family"], "disposition": row["disposition"],
+                               "note": row.get("note")})
+        for missing in sorted(set(rows) - seen):
+            problems.append({"kind": kind, "problem": "stale_row", "row": rows[missing]})
+        result[kind] = classified
+    result["complete"] = not problems
+    return result
diff --git a/hermes_cli/kanban_fairness_journal.py b/hermes_cli/kanban_fairness_journal.py
new file mode 100644
index 0000000000000000000000000000000000000000..a1b4f7fcb2bbe635e959bb9ecfbd2b7501317640
--- /dev/null
+++ b/hermes_cli/kanban_fairness_journal.py
@@ -0,0 +1,181 @@
+"""Opt-in SQLite change journal for the queue-fairness capture. [daveey]
+
+``arm`` installs, in one write transaction, two feature-owned tables, an opening snapshot of every open card
+and ``kanban_fairness_*`` triggers on ``tasks`` and ``task_events``. From then on every row version that
+changes a queue-relevant field, and every lifecycle event, is appended with the database host's wall clock;
+changes a sync apply writes are recorded too (the sync capture triggers skip those). Nothing here runs unless
+an operator arms it, and no scheduler code reads it.
+
+A journal row is written inside the writer's own transaction, so a rollback removes it and the writer never
+waits on a file. The journal is bounded: past ``max_records`` or ``max_bytes`` the triggers only count what
+they dropped, which the reader treats as a coverage gap. ``seal`` stops the capture and removes the triggers;
+the rows stay until ``clear`` so they can be drained again.
+"""
+from __future__ import annotations
+
+import os
+import sqlite3
+from typing import Iterator, Optional
+
+from hermes_cli.kanban_fairness_schema import EVENT_KINDS, MAX_BYTES, MAX_RECORDS, TASK_FIELDS
+
+JOURNAL, SESSION = "kanban_fairness_journal", "kanban_fairness_session"
+_NOW_MS = "CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER)"
+_WATCHED = ("status", "priority", "idempotency_key", "assignee", "ready_since", "lease_holder")
+_SCHEMA = (
+    f"CREATE TABLE {JOURNAL} (seq INTEGER PRIMARY KEY AUTOINCREMENT, kind TEXT NOT NULL, "
+    "wall_ms INTEGER NOT NULL, task_id TEXT NOT NULL, op TEXT, fields TEXT NOT NULL)",
+    f"CREATE TABLE {SESSION} (id INTEGER PRIMARY KEY CHECK (id = 1), capture_id TEXT NOT NULL, "
+    "armed_ms INTEGER NOT NULL, sealed_ms INTEGER, max_records INTEGER NOT NULL, max_bytes INTEGER NOT NULL, "
+    "stored INTEGER NOT NULL DEFAULT 0, bytes INTEGER NOT NULL DEFAULT 0, dropped INTEGER NOT NULL DEFAULT 0, "
+    "first_drop_ms INTEGER, last_drop_ms INTEGER, admit INTEGER NOT NULL DEFAULT 1)",
+)
+
+
+class JournalError(RuntimeError):
+    """The journal is not in the state the caller needs (already armed, never armed, sealed)."""
+
+
+def _fields_sql(columns: list[str], ref: str) -> str:
+    return "json_object(" + ", ".join(f"'{c}', {ref}.{c}" for c in columns) + ")"
+
+
+def _append(kind: str, task_id: str, op: Optional[str], fields: str) -> str:
+    """Count the change, then store it only while the session is open and under both bounds."""
+    full = "(stored >= max_records OR bytes >= max_bytes)"
+    op_sql = "NULL" if op is None else f"'{op}'"
+    return (
+        f"UPDATE {SESSION} SET admit = NOT {full}, dropped = dropped + {full}, "
+        f"first_drop_ms = CASE WHEN {full} THEN COALESCE(first_drop_ms, {_NOW_MS}) ELSE first_drop_ms END, "
+        f"last_drop_ms = CASE WHEN {full} THEN {_NOW_MS} ELSE last_drop_ms END, "
+        f"bytes = bytes + CASE WHEN {full} THEN 0 ELSE length({fields}) END, stored = stored + NOT {full} "
+        "WHERE id = 1 AND sealed_ms IS NULL; "
+        f"INSERT INTO {JOURNAL} (kind, wall_ms, task_id, op, fields) "
+        f"SELECT '{kind}', {_NOW_MS}, {task_id}, {op_sql}, {fields} FROM {SESSION} "
+        "WHERE id = 1 AND sealed_ms IS NULL AND admit = 1;"
+    )
+
+
+def _triggers(conn: sqlite3.Connection) -> dict[str, str]:
+    present = [r[1] for r in conn.execute("PRAGMA table_info(tasks)")]
+    columns = [c for c in TASK_FIELDS if c in present]
+    changed = " OR ".join(f"OLD.{c} IS NOT NEW.{c}" for c in _WATCHED if c in present)
+    kinds = ", ".join(f"'{k}'" for k in EVENT_KINDS)
+    event = "json_object('kind', NEW.kind, 'created_at', NEW.created_at)"
+    return {
+        "kanban_fairness_tasks_ins": "CREATE TRIGGER kanban_fairness_tasks_ins AFTER INSERT ON tasks BEGIN "
+        + _append("task", "NEW.id", "insert", _fields_sql(columns, "NEW")) + " END",
+        "kanban_fairness_tasks_upd": "CREATE TRIGGER kanban_fairness_tasks_upd AFTER UPDATE ON tasks "
+        f"WHEN {changed} BEGIN " + _append("task", "NEW.id", "update", _fields_sql(columns, "NEW")) + " END",
+        "kanban_fairness_tasks_del": "CREATE TRIGGER kanban_fairness_tasks_del AFTER DELETE ON tasks BEGIN "
+        + _append("task", "OLD.id", "delete", "'{}'") + " END",
+        "kanban_fairness_events_ins": "CREATE TRIGGER kanban_fairness_events_ins AFTER INSERT ON task_events "
+        f"WHEN NEW.kind IN ({kinds}) BEGIN " + _append("event", "NEW.task_id", None, event) + " END",
+    }
+
+
+def _has(conn: sqlite3.Connection, name: str) -> bool:
+    return conn.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?",
+                        (name,)).fetchone() is not None
+
+
+def _drop_triggers(conn: sqlite3.Connection) -> None:
+    for (name,) in conn.execute(
+            "SELECT name FROM sqlite_master WHERE type = 'trigger' AND name GLOB 'kanban_fairness_*'").fetchall():
+        conn.execute(f"DROP TRIGGER IF EXISTS {name}")
+
+
+def identity(conn: sqlite3.Connection) -> dict:
+    """The database file behind ``conn``: a replaced file (a replica rebuild) has another inode."""
+    path = conn.execute("PRAGMA database_list").fetchone()[2]
+    stat = os.stat(path)
+    return {"path": path, "dev": stat.st_dev, "ino": stat.st_ino}
+
+
+def status(conn: sqlite3.Connection) -> Optional[dict]:
+    """The session row plus trigger presence, or None on a database that was never armed."""
+    if not _has(conn, SESSION):
+        return None
+    row = conn.execute(
+        f"SELECT capture_id, armed_ms, sealed_ms, max_records, max_bytes, stored, bytes, dropped, "
+        f"first_drop_ms, last_drop_ms FROM {SESSION} WHERE id = 1").fetchone()
+    if row is None:
+        return None
+    names = ("capture_id", "armed_ms", "sealed_ms", "max_records", "max_bytes", "stored", "bytes", "dropped",
+             "first_drop_ms", "last_drop_ms")
+    installed = {r[0] for r in conn.execute(
+        "SELECT name FROM sqlite_master WHERE type = 'trigger' AND name GLOB 'kanban_fairness_*'")}
+    last = conn.execute(f"SELECT MAX(seq) FROM {JOURNAL}").fetchone()[0]
+    return {**dict(zip(names, row)), "last_seq": last or 0, "db": identity(conn),
+            "triggers": sorted(installed), "triggers_complete": installed == set(_triggers(conn))}
+
+
+def arm(conn: sqlite3.Connection, capture_id: str, *, max_records: int = MAX_RECORDS,
+        max_bytes: int = MAX_BYTES, replace: bool = False) -> dict:
+    """Start a capture on this database: tables, opening snapshot and triggers in one transaction."""
+    from hermes_cli.kanban_db_connect import write_txn
+
+    if not capture_id or not all(c.isalnum() or c in "-_." for c in capture_id):
+        raise JournalError("capture id must be letters, digits, '-', '_' or '.'")
+    with write_txn(conn):
+        if _has(conn, SESSION):
+            if not replace:
+                raise JournalError("a fairness capture already exists on this database; seal and clear it, "
+                                   "or pass replace")
+            _drop_triggers(conn)
+            conn.execute(f"DROP TABLE IF EXISTS {JOURNAL}")
+            conn.execute(f"DROP TABLE IF EXISTS {SESSION}")
+        for ddl in _SCHEMA:
+            conn.execute(ddl)
+        conn.execute(f"INSERT INTO {SESSION} (id, capture_id, armed_ms, max_records, max_bytes) "
+                     f"VALUES (1, ?, {_NOW_MS}, ?, ?)", (capture_id, max_records, max_bytes))
+        present = [r[1] for r in conn.execute("PRAGMA table_info(tasks)")]
+        fields = _fields_sql([c for c in TASK_FIELDS if c in present], "s")
+        # The opening snapshot is not optional evidence: an armed session that could not hold it is a gap.
+        conn.execute(
+            f"INSERT INTO {JOURNAL} (kind, wall_ms, task_id, op, fields) SELECT 'opening', {_NOW_MS}, s.id, NULL, "
+            f"{fields} FROM tasks AS s WHERE s.status NOT IN ('done', 'archived') ORDER BY s.id LIMIT ?",
+            (max_records,))
+        conn.execute(
+            f"UPDATE {SESSION} SET stored = (SELECT COUNT(*) FROM {JOURNAL}), "
+            f"bytes = (SELECT COALESCE(SUM(length(fields)), 0) FROM {JOURNAL}), "
+            "dropped = MAX(0, (SELECT COUNT(*) FROM tasks WHERE status NOT IN ('done', 'archived')) - "
+            f"(SELECT COUNT(*) FROM {JOURNAL})) WHERE id = 1")
+        for ddl in _triggers(conn).values():
+            conn.execute(ddl)
+    return _open_status(conn)
+
+
+def _open_status(conn: sqlite3.Connection) -> dict:
+    state = status(conn)
+    if state is None:
+        raise JournalError("no fairness capture on this database")
+    return state
+
+
+def seal(conn: sqlite3.Connection) -> dict:
+    """Close the capture: stamp the end and remove the triggers. Rows stay for draining."""
+    from hermes_cli.kanban_db_connect import write_txn
+
+    with write_txn(conn):
+        _open_status(conn)
+        conn.execute(f"UPDATE {SESSION} SET sealed_ms = COALESCE(sealed_ms, {_NOW_MS}) WHERE id = 1")
+        _drop_triggers(conn)
+    return _open_status(conn)
+
+
+def clear(conn: sqlite3.Connection) -> None:
+    """Remove every trace of the capture from this database."""
+    from hermes_cli.kanban_db_connect import write_txn
+
+    with write_txn(conn):
+        _drop_triggers(conn)
+        conn.execute(f"DROP TABLE IF EXISTS {JOURNAL}")
+        conn.execute(f"DROP TABLE IF EXISTS {SESSION}")
+
+
+def rows(conn: sqlite3.Connection, after_seq: int = 0, limit: int = 5000) -> Iterator[tuple]:
+    """``(seq, kind, wall_ms, task_id, op, fields_json)`` after ``after_seq``, in commit order."""
+    yield from conn.execute(
+        f"SELECT seq, kind, wall_ms, task_id, op, fields FROM {JOURNAL} WHERE seq > ? ORDER BY seq LIMIT ?",
+        (after_seq, limit))
diff --git a/hermes_cli/kanban_fairness_metrics.py b/hermes_cli/kanban_fairness_metrics.py
new file mode 100644
index 0000000000000000000000000000000000000000..8d2d4fbdc71f58946ad4d793e547cf46ba435b20
--- /dev/null
+++ b/hermes_cli/kanban_fairness_metrics.py
@@ -0,0 +1,298 @@
+"""Ready-wait cohorts and acceptance gates from one queue-fairness capture. [daveey]
+
+Pure: records in, verdict out. An *episode* is one stay of one card in ``ready``. Every time in it is an
+interval, because the capture sees a change when the database applies it, not when it happened:
+
+* the start is the Board's ``ready_since`` when the row carries a believable one, else the sighting that
+  showed it ready;
+* a claim ends it at the origin's ``claimed`` event second when one was journaled, else at the sighting of the
+  ``running`` row; a card first sighted ``running`` with a new ``ready_since`` was ready and claimed between
+  two sightings, and still counts;
+* a card that leaves ``ready`` any other way (blocked, archived, parked) has only a lower bound, unless the
+  capture was armed with ``unclaimed_exit = "elapsed_ready"`` (it then waited exactly as long as it sat
+  there); one still ready at the close always has only a lower bound.
+
+``clock_error_s`` widens every wait by the assumed disagreement between the clocks involved, and
+``apply_lag_s`` is how long a change may take to reach the captured database (a replica's pull lag; 0 for a
+board's own file): a sighting at ``t`` proves the change happened in ``t - lag .. t``. A gate passes
+only on its upper bound, fails only on its lower bound, and is INDETERMINATE in between, with an empty
+cohort, or when the capture has a coverage gap. Nothing is excluded from a cohort to make a gate pass.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Iterable, NamedTuple, Optional
+
+from hermes_cli.kanban_fairness_schema import (
+    FAIL,
+    INDETERMINATE,
+    MAX_WAIT_S,
+    OWNER_SOURCES,
+    P0_MEDIAN_S,
+    PASS,
+    URGENT_WAIT_S,
+    VERSION,
+)
+
+
+@dataclass
+class Episode:
+    task_id: str
+    priority: int
+    key: Optional[str]
+    start_lo: float
+    start_hi: float
+    ready_since: Optional[float]
+    last_seen: float
+    opening: bool = False
+    end: str = "open"  # open | claimed | left:<status> | requeued
+    end_lo: float = 0.0  # meaningful once ``end`` is not "open"
+    end_hi: float = 0.0
+    priorities: list = field(default_factory=list)
+
+    def wait(self, clock: Clock) -> tuple[float, Optional[float]]:
+        """``(lower, upper)`` seconds in ready; upper is None while the card is still ready at the close."""
+        if self.end == "open":
+            return max(0.0, clock.close_s - clock.lag - self.start_hi - clock.err), None
+        lo = max(0.0, self.end_lo - self.start_hi - clock.err)
+        if self.end != "claimed" and not clock.unclaimed_elapsed:
+            return lo, None
+        return lo, max(0.0, self.end_hi - self.start_lo + clock.err)
+
+    def elapsed_hi(self, clock: Clock) -> float:
+        """The longest this episode can have been ready inside the window."""
+        return max(0.0, (clock.close_s if self.end == "open" else self.end_hi) - self.start_lo + clock.err)
+
+    def changed_priority(self) -> bool:
+        return len(set(self.priorities)) > 1
+
+
+class Clock(NamedTuple):
+    close_s: float
+    err: float
+    lag: float
+    unclaimed_elapsed: bool = False
+
+
+def episodes(records: Iterable[dict], *, armed_s: float, err: float, lag: float = 0.0) -> list[Episode]:
+    """Every ready episode the records show, oldest first; ``claimed`` events tighten claim times."""
+    seen: dict[str, tuple[str, float]] = {}  # task -> (status, wall of the latest sighting)
+    counted: dict[str, Optional[float]] = {}  # task -> ready_since of its latest episode
+    live: dict[str, Episode] = {}
+    done: list[Episode] = []
+    claims: dict[str, list[int]] = {}
+    for rec in records:
+        tid, wall, fields = rec["task_id"], rec["wall_ms"] / 1000, rec["fields"]
+        if rec["kind"] == "event":
+            if fields["kind"] == "claimed":
+                claims.setdefault(tid, []).append(fields["created_at"])
+            continue
+        status = "deleted" if rec["op"] == "delete" else fields["status"]
+        ep = live.get(tid)
+        since = fields.get("ready_since")
+        since = None if since is None else since / 1000
+        if status != "ready":
+            if ep is not None:
+                ep.end = "claimed" if status == "running" else f"left:{status}"
+                ep.end_lo, ep.end_hi = max(ep.start_lo, wall - lag), wall
+                done.append(live.pop(tid))
+            elif (status == "running" and rec["kind"] != "opening" and since is not None and since <= wall + err
+                  and since != counted.get(tid, since if tid in seen else None)):
+                # Ready and claimed between two sightings (a replica's pull): the row still says since when.
+                done.append(Episode(tid, fields.get("priority") or 0, fields.get("idempotency_key"), since,
+                                    since, since, wall, end="claimed", end_lo=max(since, wall - lag),
+                                    end_hi=wall, priorities=[fields.get("priority") or 0]))
+            counted[tid] = since
+            seen[tid] = (status, wall)
+            continue
+        if ep is not None and since is not None and ep.ready_since is not None and since > ep.ready_since:
+            # The card left ready and came back between two sightings: the first stay ended unseen.
+            ep.end, ep.end_lo, ep.end_hi = "requeued", max(ep.start_lo, ep.last_seen - lag), since
+            done.append(live.pop(tid))
+            ep = None
+        if ep is None:
+            before = seen.get(tid)
+            floor = wall - lag
+            # A ready_since older than a sighting of the card out of ready belongs to an earlier stay.
+            stale = since is None or since > wall + err or (
+                before is not None and since < before[1] - lag - err)
+            if stale and rec["kind"] == "opening":  # ready before the window, since when is not on the row
+                floor = float(fields.get("created_at") or 0)
+            start = (floor, wall) if stale or since is None else (since, since)
+            ep = live[tid] = Episode(tid, fields.get("priority") or 0, fields.get("idempotency_key"), *start,
+                                     None if stale else since, wall, opening=rec["kind"] == "opening")
+        ep.last_seen = wall
+        counted[tid] = ep.ready_since
+        ep.priorities.append(fields.get("priority") or 0)
+        seen[tid] = (status, wall)
+    out = done + list(live.values())
+    for ep in out:
+        if ep.end != "claimed":
+            continue
+        stamps = [c for c in claims.get(ep.task_id, ()) if ep.start_lo - err - 1 <= c <= ep.end_hi + err]
+        if stamps:
+            ep.end_lo = max(ep.start_lo, float(min(stamps)))
+            ep.end_hi = max(ep.end_lo, min(ep.end_hi, min(stamps) + 1.0))
+    return sorted(out, key=lambda e: (e.start_lo, e.task_id))
+
+
+def _median(values: list[float]) -> float:
+    ordered = sorted(values)
+    mid = len(ordered) // 2
+    return ordered[mid] if len(ordered) % 2 else (ordered[mid - 1] + ordered[mid]) / 2
+
+
+def _counts(cohort: list[Episode]) -> dict:
+    out = {"episodes": len(cohort), "opening_backlog": sum(e.opening for e in cohort), "claimed": 0, "open": 0,
+           "left_unclaimed": 0, "requeued": 0, "priority_changed": sum(e.changed_priority() for e in cohort)}
+    for ep in cohort:
+        name = ep.end if ep.end in ("claimed", "open", "requeued") else "left_unclaimed"
+        out[name] += 1
+    return out
+
+
+def _median_gate(cohort: list[Episode], clock: Clock) -> dict:
+    out = {"threshold_s": P0_MEDIAN_S, **_counts(cohort), "median_lo_s": None, "median_hi_s": None}
+    if not cohort:
+        return {**out, "status": INDETERMINATE, "reason": "no stored-priority-0 ready episode in the window"}
+    waits = [ep.wait(clock) for ep in cohort]
+    lo = _median([w[0] for w in waits])
+    hi = _median([float("inf") if w[1] is None else w[1] for w in waits])
+    out.update(median_lo_s=round(lo, 3), median_hi_s=None if hi == float("inf") else round(hi, 3))
+    if hi <= P0_MEDIAN_S:
+        return {**out, "status": PASS}
+    if lo > P0_MEDIAN_S:
+        return {**out, "status": FAIL}
+    return {**out, "status": INDETERMINATE, "reason": "the median's bounds straddle the threshold"}
+
+
+def _max_gate(eps: list[Episode], clock: Clock) -> dict:
+    """No card waits past ``MAX_WAIT_S`` while claims happen: an overdue card is a breach only when some
+    claim was witnessed during its overtime (its own late claim counts)."""
+    claim_times = sorted(ep.end_hi for ep in eps if ep.end == "claimed")
+    out = {"threshold_s": MAX_WAIT_S, "episodes": len(eps), "claims_witnessed": len(claim_times),
+           "raw_max_lo_s": None, "raw_max_hi_s": None, "breaches": [], "possible": []}
+    if eps:
+        out["raw_max_lo_s"] = round(max(ep.wait(clock)[0] for ep in eps), 3)
+        out["raw_max_hi_s"] = round(max(ep.elapsed_hi(clock) for ep in eps), 3)
+    for ep in eps:
+        lo = ep.wait(clock)[0]
+        until = clock.close_s if ep.end == "open" else ep.end_hi
+        if lo > MAX_WAIT_S and any(ep.start_hi + MAX_WAIT_S + clock.err < t <= until for t in claim_times):
+            out["breaches"].append({"task_id": ep.task_id, "wait_lo_s": round(lo, 3), "end": ep.end})
+        elif ep.elapsed_hi(clock) > MAX_WAIT_S and any(
+                ep.start_lo + MAX_WAIT_S - clock.err < t <= until for t in claim_times):
+            out["possible"].append({"task_id": ep.task_id, "end": ep.end,
+                                    "wait_hi_s": round(ep.elapsed_hi(clock), 3)})
+    if out["breaches"]:
+        return {**out, "status": FAIL}
+    if not claim_times:
+        return {**out, "status": INDETERMINATE, "reason": "no claim was witnessed in the window"}
+    if out["possible"]:
+        return {**out, "status": INDETERMINATE, "reason": "an episode's bounds straddle the threshold"}
+    return {**out, "status": PASS}
+
+
+def _urgent_gate(cohort: list[Episode], clock: Clock, empty: str) -> dict:
+    out = {"threshold_s": URGENT_WAIT_S, **_counts(cohort), "worst_lo_s": None, "worst_hi_s": None, "late": [],
+           "undecided": []}
+    if not cohort:
+        return {**out, "status": INDETERMINATE, "reason": empty}
+    out["worst_lo_s"] = round(max(ep.wait(clock)[0] for ep in cohort), 3)
+    out["worst_hi_s"] = round(max(ep.elapsed_hi(clock) for ep in cohort), 3)
+    for ep in cohort:
+        lo, hi = ep.wait(clock)
+        row = {"task_id": ep.task_id, "end": ep.end, "wait_lo_s": round(lo, 3),
+               "wait_hi_s": None if hi is None else round(hi, 3)}
+        if lo > URGENT_WAIT_S:
+            out["late"].append(row)
+        elif hi is None or hi > URGENT_WAIT_S:
+            out["undecided"].append(row)
+    if out["late"]:
+        return {**out, "status": FAIL}
+    if out["undecided"]:
+        return {**out, "status": INDETERMINATE,
+                "reason": "an episode has no upper bound (still ready, or left unclaimed) or straddles the threshold"}
+    return {**out, "status": PASS}
+
+
+def _owner_coverage(owners: Optional[list[dict]], armed_s: float, close_s: float) -> Optional[str]:
+    """Why the owner journal cannot vouch for the whole window, or None when it does."""
+    if owners is None:
+        return "no owner_authority.jsonl: land-turn owner history was not journaled for this window"
+    for source in OWNER_SOURCES:
+        spans = sorted((o["from_s"], o["to_s"], o["complete"]) for o in owners
+                       if o["kind"] == "coverage" and o["source"] == source
+                       and o["to_s"] > armed_s and o["from_s"] < close_s)
+        reached = armed_s
+        for start, end, complete in spans:
+            if not complete:
+                return f"{source} owner history has a recorded break inside the window"
+            if start > reached:
+                break
+            reached = max(reached, end)
+        if reached < close_s:
+            return f"{source} owner history does not cover the whole window"
+    return None
+
+
+def _owner_episodes(eps: list[Episode], owners: Optional[list[dict]], close_s: float) -> list[Episode]:
+    held: dict[str, list[tuple[float, float]]] = {}
+    for o in owners or ():
+        if o["kind"] == "interval":
+            held.setdefault(o["task_id"], []).append(
+                (o["start_s"], float("inf") if o["end_s"] is None else o["end_s"]))
+    out = []
+    for ep in eps:
+        until = close_s if ep.end == "open" else ep.end_hi
+        if any(start < until and end > ep.start_lo for start, end in held.get(ep.task_id, ())):
+            out.append(ep)
+    return out
+
+
+def verdict(capture: dict, *, alarm_prefixes: tuple, min_window_s: float = 0) -> dict:
+    """The live report for a loaded capture (:func:`kanban_fairness_store.load`)."""
+    manifest = capture["manifest"]
+    gaps = list(capture["gaps"])
+    window = manifest.get("window") or {}
+    records = capture["records"]
+    armed_ms = window.get("armed_ms") or (records[0]["wall_ms"] if records else 0)
+    close_ms = window.get("sealed_ms") or (records[-1]["wall_ms"] if records else armed_ms)
+    armed_s, close_s = armed_ms / 1000, close_ms / 1000
+    assumed = manifest.get("assumptions") or {}
+    err, lag = float(assumed.get("clock_error_s", 2.0)), float(assumed.get("apply_lag_s", 0.0))
+    unclaimed = assumed.get("unclaimed_exit", "unknown")
+    clock = Clock(close_s, err, lag, unclaimed == "elapsed_ready")
+    if close_s - armed_s < min_window_s:
+        gaps.append({"code": "window_short",
+                     "detail": f"window is {close_s - armed_s:.0f} s, the report needs {min_window_s:.0f} s"})
+    eps = episodes(records, armed_s=armed_s, err=err, lag=lag)
+    p0 = [ep for ep in eps if ep.priority == 0]
+    alarms = [ep for ep in eps if isinstance(ep.key, str) and ep.key.startswith(tuple(alarm_prefixes))]
+    owner_gap = _owner_coverage(capture["owners"], armed_s, close_s)
+    gates = {
+        "p0_median_wait": _median_gate(p0, clock),
+        "max_wait_while_claims": _max_gate(eps, clock),
+        "alarm_wait": _urgent_gate(alarms, clock, "no alarm card was ready in the window"),
+        "owner_wait": _urgent_gate(_owner_episodes(eps, capture["owners"], close_s), clock,
+                                   "no land-turn owner card was ready in the window"),
+    }
+    if owner_gap and gates["owner_wait"]["status"] != FAIL:
+        gates["owner_wait"].update(status=INDETERMINATE, reason=owner_gap)
+    if gaps:  # a proven failure stands on incomplete evidence; a pass does not
+        for gate in gates.values():
+            if gate["status"] == PASS:
+                gate.update(status=INDETERMINATE, reason="capture coverage is incomplete")
+    states = {gate["status"] for gate in gates.values()}
+    overall = FAIL if FAIL in states else PASS if states == {PASS} else INDETERMINATE
+    return {
+        "version": VERSION, "mode": "live", "capture_id": manifest.get("capture_id"),
+        "board": manifest.get("board"),
+        "window": {"armed_ms": armed_ms, "close_ms": close_ms, "seconds": round(close_s - armed_s, 3),
+                   "min_seconds": min_window_s},
+        "assumptions": {"clock_error_s": err, "apply_lag_s": lag, "unclaimed_exit": unclaimed,
+                        "alarm_prefixes": list(alarm_prefixes)},
+        "coverage": {"complete": not gaps, "gaps": gaps},
+        "cohorts": {"all": _counts(eps), "p0": _counts(p0), "alarm": _counts(alarms)},
+        "gates": gates, "overall": overall, "policy": manifest.get("policy") or {},
+    }
diff --git a/hermes_cli/kanban_fairness_schema.py b/hermes_cli/kanban_fairness_schema.py
