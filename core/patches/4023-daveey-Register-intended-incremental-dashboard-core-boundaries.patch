From 4d21b26801385f8b5f213c4f6bbcb63f2263831a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 01:41:14 +0000
Subject: [PATCH] [daveey] Register intended incremental dashboard core
 boundaries

The bundled dashboard already reads kanban_db through its adapter. Its extracted incremental materializer intentionally retains that dependency, while board_rows consumes card K kanban_task_change for the cursor and FULL sentinel. These internal APIs are not promoted to the public third-party plugin contract. Record only those two intended crossings.

Proof: exact PR CI run 43536540453 failed this guard; canonical test_boundary_lint.py reproduced RED before the baseline change and all seven tests passed afterward. Full scripts/check passes. Runtime behavior unchanged.
---
 scripts/boundary_lint_baseline.json | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/scripts/boundary_lint_baseline.json b/scripts/boundary_lint_baseline.json
index 1eaa950d24..6382c9db93 100644
--- a/scripts/boundary_lint_baseline.json
+++ b/scripts/boundary_lint_baseline.json
@@ -177,6 +177,7 @@
     "plugins/kanban/dashboard/board_counts.py hermes_cli.kanban_db": 1,
     "plugins/kanban/dashboard/board_counts.py hermes_cli.kanban_generation.open_ro": 1,
     "plugins/kanban/dashboard/board_diagnostics.py hermes_cli.kanban_diagnostics": 1,
+    "plugins/kanban/dashboard/board_incremental.py hermes_cli.kanban_db": 1,
     "plugins/kanban/dashboard/board_prewarm.py hermes_cli.kanban_db": 1,
     "plugins/kanban/dashboard/board_read.py hermes_cli.kanban_db": 1,
     "plugins/kanban/dashboard/board_read.py hermes_cli.kanban_diagnostics": 1,
@@ -186,6 +187,7 @@
     "plugins/kanban/dashboard/board_rows.py hermes_cli.kanban_generation.open_ro": 1,
     "plugins/kanban/dashboard/board_rows.py hermes_cli.kanban_generation.register_reader_cache": 1,
     "plugins/kanban/dashboard/board_rows.py hermes_cli.kanban_lockguard.shm_identity": 1,
+    "plugins/kanban/dashboard/board_rows.py hermes_cli.kanban_task_change": 2,
     "plugins/kanban/dashboard/board_rows.py hermes_state_guard.ensure_kanban_test_isolation": 1,
     "plugins/kanban/dashboard/plugin_api.py agent.auxiliary_client.call_llm": 1,
     "plugins/kanban/dashboard/plugin_api.py agent.portal_tags.get_affinity_scope": 1,
