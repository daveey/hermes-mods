From 7ac31b221031fbf3129c3d62b789f41f422abe17 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 20:01:45 +0000
Subject: [PATCH] [daveey] pacing tests: BOM-tolerant reads (Windows footgun
 lint on the touched files)

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 tests/hermes_cli/test_kanban_llm_pacing.py             | 4 ++--
 tests/hermes_cli/test_kanban_llm_pacing_persistence.py | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_llm_pacing.py b/tests/hermes_cli/test_kanban_llm_pacing.py
index 8cb63f5e1fe37ef661de15cf7d1c6e2281126680..c369351e5f27b44f472403f8d060d341bf0979b3 100644
--- a/tests/hermes_cli/test_kanban_llm_pacing.py
+++ b/tests/hermes_cli/test_kanban_llm_pacing.py
@@ -310,7 +310,7 @@ def test_only_kanban_dispatch_consults_the_governor():
     root = pathlib.Path(pd.__file__).resolve().parents[1]
     users = sorted(str(p.relative_to(root)) for top in ("agent", "gateway", "cron", "hermes_cli", "tui_gateway")
                    if (root / top).is_dir() for p in (root / top).rglob("*.py")
-                   if "kanban_llm_pacing" in p.read_text(encoding="utf-8", errors="ignore"))
+                   if "kanban_llm_pacing" in p.read_text(encoding="utf-8-sig", errors="ignore"))
     assert users == ["hermes_cli/kanban_db_dispatch.py", "hermes_cli/kanban_db_edit.py",
                      "hermes_cli/kanban_dispatch_maintenance.py",
                      "hermes_cli/kanban_llm_pacing.py", "hermes_cli/kanban_llm_pacing_dispatch.py",
@@ -338,7 +338,7 @@ REROUTE_VIEW = {"kanban_llm_pacing_dispatch": {"held_pools"}}
 def _governor_names(path: pathlib.Path) -> dict[str, set[str]]:
     """Each governor module ``path`` imports, with every name it imports from it or reads off it as ``alias.name``.
     A dotted ``import`` of one, or its alias used any other way (passed on, stored), is listed as such."""
-    tree = ast.parse(path.read_text(encoding="utf-8"))
+    tree = ast.parse(path.read_text(encoding="utf-8-sig"))
     parents = {child: node for node in ast.walk(tree) for child in ast.iter_child_nodes(node)}
     aliases: dict[str, str] = {}
     names: dict[str, set[str]] = {}
diff --git a/tests/hermes_cli/test_kanban_llm_pacing_persistence.py b/tests/hermes_cli/test_kanban_llm_pacing_persistence.py
index c2c206f52c1aa9352f85e5379cd431c7330e2ab5..b4613cd7f8f618d5514acb27fcaf476a25f8b9b5 100644
--- a/tests/hermes_cli/test_kanban_llm_pacing_persistence.py
+++ b/tests/hermes_cli/test_kanban_llm_pacing_persistence.py
@@ -64,7 +64,7 @@ def test_dispatch_rate_history_survives_process_restart(tmp_path):
     assert restarted['pace']['factor'] == pytest.approx(0.5833)
     assert restarted['average'] == 4
     assert restarted['limit'] == 2
-    saved = json.loads((state / 'llm_pacing.json').read_text())['anthropic']
+    saved = json.loads((state / 'llm_pacing.json').read_text(encoding='utf-8-sig'))['anthropic']
     assert saved['samples'] == [
         [1799996400, 'a', 'seven_day', 54, 1800036000],
         [1800000000, 'a', 'seven_day', 60, 1800036000],
-- 
2.43.0

