             platform: linux/amd64
     runs-on: ${{ matrix.runner }}
     timeout-minutes: 120  # fork: shared hub runner
@@ -80,7 +80,7 @@ jobs:
       matrix:
         include:
           - arch: amd64
-            runner: blacksmith-8vcpu-ubuntu-2404
+            runner: blacksmith-4vcpu-ubuntu-2404
             platform: linux/amd64
     runs-on: ${{ matrix.runner }}
     timeout-minutes: 30
@@ -126,7 +126,7 @@ jobs:
   merge:
     if: ${{ !cancelled() && github.repository == 'NousResearch/hermes-agent' && (github.event_name == 'release' || (github.event_name == 'workflow_dispatch' && inputs.publish)) }}
     needs: [publish]
-    runs-on: blacksmith-8vcpu-ubuntu-2404
+    runs-on: blacksmith-4vcpu-ubuntu-2404
     timeout-minutes: 10
     environment: container-publish
     steps:
diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index 16ff6d7645..db55493ba4 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -71,7 +71,7 @@ jobs:
     # matrix, scripts/ci/affected_tests.py); every other event runs all eight.
     if: inputs.python
     name: Run tests (${{ inputs.python_changed != '' && 'affected, ' || '' }}${{ matrix.slice }}/${{ strategy.job-total }})
-    runs-on: blacksmith-8vcpu-ubuntu-2404
+    runs-on: blacksmith-4vcpu-ubuntu-2404
     # ~10 min expected; 30 leaves room for a cold cache or a dilated file.
     timeout-minutes: 30
     strategy:
@@ -429,7 +429,7 @@ jobs:
     needs: e2e-upgrade-plan
     # [daveey] Blacksmith VM per shard; the "Install bubblewrap" step lifts Ubuntu 24.04's
     # AppArmor userns restriction (the old tfgar AMI baked that in).
-    runs-on: blacksmith-8vcpu-ubuntu-2404
+    runs-on: blacksmith-4vcpu-ubuntu-2404
     timeout-minutes: 60
     strategy:
       fail-fast: false
diff --git a/scripts/fork-ci-runner.sh b/scripts/fork-ci-runner.sh
index 8f1e346b0b..4f7f1296b6 100755
--- a/scripts/fork-ci-runner.sh
+++ b/scripts/fork-ci-runner.sh
@@ -69,7 +69,7 @@ for f in sorted(set(COMPLETION) | set(FAST)):
 PY
 
 # The Python test slices and the bubblewrap e2e-upgrade shards are the heavy
-# lanes (8 vCPU, as on the old tfgar-tests/ci-bwrap VMs).
+# lanes (4 vCPU: blacksmith-8vcpu jobs never got a runner on example-org, PR #1077).
 python3 - <<'PY'
 import re
 f = 'tests.yml'; t = open(f).read()
@@ -77,7 +77,7 @@ for name in ('test', 'e2e-upgrade'):
     m = re.search(r'(?m)^  ' + re.escape(name) + r':\n(?:(?!  \S).*\n)*', t)
     assert m, (f, name)
     block = m.group(0)
-    t = t.replace(block, re.sub(r'(?m)^(    runs-on: )blacksmith-[0-9]+vcpu-ubuntu-2404$', r'\1blacksmith-8vcpu-ubuntu-2404', block))
+    t = t.replace(block, re.sub(r'(?m)^(    runs-on: )blacksmith-[0-9]+vcpu-ubuntu-2404$', r'\1blacksmith-4vcpu-ubuntu-2404', block))
 open(f, 'w').write(t)
 PY
 
@@ -86,7 +86,7 @@ PY
 # hosts/hermes-hub/gh-runner/setup-ci-docker.sh). Plain ubuntu jobs above stay
 # on the socket-less runners.
 DOCKER_FILES=(repo-guards.yml remote-backends.yml docker.yml nix.yml sandbox-image.yml)
-sed -i.bak -E "s/^([[:space:]]*runs-on:[[:space:]]*)(\\[self-hosted, hermes-hub(, docker)?\\]|${UPSTREAM_LINUX})[[:space:]]*\$/\\1blacksmith-8vcpu-ubuntu-2404/" "${DOCKER_FILES[@]}"
+sed -i.bak -E "s/^([[:space:]]*runs-on:[[:space:]]*)(\\[self-hosted, hermes-hub(, docker)?\\]|${UPSTREAM_LINUX})[[:space:]]*\$/\\1blacksmith-4vcpu-ubuntu-2404/" "${DOCKER_FILES[@]}"
 # Matrix-driven image builds: amd64 -> docker-ci runner; no arm64 runner, so
 # drop the arm64 leg; let the secret-free build/test jobs run on the fork
 # (publish/merge jobs stay NousResearch-only: they need Docker Hub secrets).
@@ -94,7 +94,7 @@ python3 - <<'PY'
 import re
 for f in ('docker.yml', 'sandbox-image.yml'):
     t = open(f).read()
-    t = re.sub(r"runner: (?:ubuntu-latest-32-core|blacksmith-[0-9]+vcpu-ubuntu-2404)\n", "runner: blacksmith-8vcpu-ubuntu-2404\n", t)
+    t = re.sub(r"runner: (?:ubuntu-latest-32-core|blacksmith-[0-9]+vcpu-ubuntu-2404)\n", "runner: blacksmith-4vcpu-ubuntu-2404\n", t)
     t = re.sub(r"( *)arch: \[amd64, arm64\]\n", r"\1arch: [amd64]  # fork: no arm64 runner\n", t)
     t = re.sub(r"(?:          #[^\n]*\n)*          - arch: arm64\n            runner: (?:ubuntu-latest-32-arm-core|blacksmith-[0-9]+vcpu-ubuntu-2404-arm)\n            platform: linux/arm64\n", "", t)
     t = re.sub(r"\(\(needs\.mode\.outputs\.release != 'true' && github\.repository == 'NousResearch/hermes-agent' && needs\.(detect|mode)\.outputs\.build",
@@ -105,6 +105,10 @@ for f in ('docker.yml', 'sandbox-image.yml'):
     # takes ~50 min there, past the upstream 45 min cap.
     t = t.replace("    runs-on: ${{ matrix.runner }}\n    timeout-minutes: 45\n",
                   "    runs-on: ${{ matrix.runner }}\n    timeout-minutes: 120  # fork: shared hub runner\n")
+    if f == 'docker.yml':
+        # The always() phase gate only reads needs results: the light 2 vCPU size.
+        t = re.sub(r"(  release-phase-gate:\n(?:(?!  \S).*\n)*?    runs-on: )blacksmith-[0-9]+vcpu-ubuntu-2404\n",
+                   r"\1blacksmith-2vcpu-ubuntu-2404\n", t)
     open(f, 'w').write(t)
 PY
 rm -f ./*.bak
diff --git a/tests/ci/test_fast_runner_routing.py b/tests/ci/test_fast_runner_routing.py
index 621d4f2005..d142bd6078 100644
--- a/tests/ci/test_fast_runner_routing.py
+++ b/tests/ci/test_fast_runner_routing.py
@@ -18,10 +18,11 @@ from ruamel.yaml import YAML
 pytestmark = pytest.mark.fork_guard
 
 ROOT = pathlib.Path(__file__).resolve().parents[2]
-# Blacksmith sizes since 2026-11-11 (example-org): the light lane is 2 vCPU, suites 4, Docker/heavy 8.
+# Blacksmith sizes since 2026-11-11 (example-org): the light lane is 2 vCPU, everything else 4
+# (blacksmith-8vcpu jobs sat queued with no runner on the org, PR #1077).
 FAST_LABEL = "blacksmith-2vcpu-ubuntu-2404"
 HEAVY_LABEL = "blacksmith-4vcpu-ubuntu-2404"
-BIG_LABEL = "blacksmith-8vcpu-ubuntu-2404"
+BIG_LABEL = "blacksmith-4vcpu-ubuntu-2404"
 POLL_LABEL = "blacksmith-2vcpu-ubuntu-2404"
 WORKFLOWS = ROOT / ".github" / "workflows"
 FAST = {
@@ -43,6 +44,10 @@ FAST = {
     # when the lane is skipped or cancelled), and an always() job may not wait
     # on hermes-hub (test_fork_runner_routing), so it cannot go back there.
     ("ci.yaml", "macos-state-required"),
+    # Fourth admission (November 11, 2026, Blacksmith cutover): the Docker release-phase gate.
+    # It only reads its needs' results (5-min cap, no checkout or build); its always()
+    # may not wait on the heavy size (test_fork_runner_routing).
+    ("docker.yml", "release-phase-gate"),
 }
 # Completion job in the orchestrator itself: the gate (the advisory timing report
 # runs as its trailing steps). It cannot be one of its own needs.
@@ -204,6 +209,9 @@ def test_fast_label_is_known_and_checks_cannot_bypass_the_gate():
             assert job["name"] == title
             assert set(job["needs"]) == needs
             assert job["if"] == "${{ always() }}"
+        elif (wf, name) == ("docker.yml", "release-phase-gate"):
+            # The release orchestrator's phase check, not part of the PR gate.
+            assert "always()" in job["if"] and "inputs.release-phase" in job["if"]
         elif wf == "ci.yaml":
             assert name in gate["needs"]
         else:
-- 
