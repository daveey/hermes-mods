From 2d63550d7b5fe855fac505466f1d17aabb18e934 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 06:04:30 +0000
Subject: [PATCH] ci: blacksmith-8vcpu never scheduled on example-org; use
 4vcpu; cache smoke on GitHub-hosted [daveey]

The 8 vCPU jobs on PR #1077 sat queued with no runner for 6+ min while 2/4 vCPU
jobs started in seconds, so every heavy lane now uses blacksmith-4vcpu. The
Docker release-phase gate (reads needs only) moves to the 2 vCPU lane. The
stalled-cache-save smoke runs on ubuntu-24.04: Blacksmith serves actions/cache
from its own service, so the smoke's blackhole endpoint is never reached.
---
 .github/workflows/cache-save-timeout-smoke.yml |  4 +++-
 .github/workflows/docker.yml                   | 14 +++++++-------
 .github/workflows/nix.yml                      |  6 +++---
 .github/workflows/remote-backends.yml          |  2 +-
 .github/workflows/repo-guards.yml              |  2 +-
 .github/workflows/sandbox-image.yml            |  6 +++---
 .github/workflows/tests.yml                    |  4 ++--
 scripts/fork-ci-runner.sh                      | 12 ++++++++----
 tests/ci/test_fast_runner_routing.py           | 12 ++++++++++--
 9 files changed, 38 insertions(+), 24 deletions(-)

diff --git a/.github/workflows/cache-save-timeout-smoke.yml b/.github/workflows/cache-save-timeout-smoke.yml
index 7192483a9b..b41c93099c 100644
--- a/.github/workflows/cache-save-timeout-smoke.yml
+++ b/.github/workflows/cache-save-timeout-smoke.yml
@@ -19,7 +19,9 @@ permissions:
 
 jobs:
   stalled-save:
-    runs-on: blacksmith-4vcpu-ubuntu-2404
+    # GitHub-hosted on purpose: Blacksmith routes actions/cache to its own cache
+    # service, so the step's blackhole endpoint is never reached there.
+    runs-on: ubuntu-24.04
     timeout-minutes: 4
     steps:
       - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
diff --git a/.github/workflows/docker.yml b/.github/workflows/docker.yml
index 0a19149fe5..ddf7561c1f 100644
--- a/.github/workflows/docker.yml
+++ b/.github/workflows/docker.yml
@@ -88,7 +88,7 @@ jobs:
   # never weakened.
   mode:
     name: Resolve release phase and affected areas
-    runs-on: blacksmith-8vcpu-ubuntu-2404
+    runs-on: blacksmith-4vcpu-ubuntu-2404
     timeout-minutes: 10
     outputs:
       phase: ${{ steps.resolve.outputs.phase }}
@@ -163,7 +163,7 @@ jobs:
         variant: [slim, desktop]
         include:
           - arch: amd64
-            runner: blacksmith-8vcpu-ubuntu-2404
+            runner: blacksmith-4vcpu-ubuntu-2404
             platform: linux/amd64
 
     runs-on: ${{ matrix.runner }}
@@ -351,7 +351,7 @@ jobs:
         variant: [slim, desktop]
         include:
           - arch: amd64
-            runner: blacksmith-8vcpu-ubuntu-2404
+            runner: blacksmith-4vcpu-ubuntu-2404
             platform: linux/amd64
     runs-on: ${{ matrix.runner }}
     timeout-minutes: 30
@@ -443,7 +443,7 @@ jobs:
     # `needs` is the whole 4-leg matrix: only publish both :main variants
     # after every arch and variant publisher succeeds.
     if: ${{ !cancelled() && needs.mode.outputs.release != 'true' && github.repository == 'NousResearch/hermes-agent' && github.event_name == 'push' && github.ref == 'refs/heads/main' }}
-    runs-on: blacksmith-8vcpu-ubuntu-2404
+    runs-on: blacksmith-4vcpu-ubuntu-2404
     needs: [mode, publish]
     timeout-minutes: 10
     environment: container-publish
@@ -537,7 +537,7 @@ jobs:
       matrix:
         arch: [amd64]  # fork: no arm64 runner
         variant: [slim, desktop]
-    runs-on: blacksmith-8vcpu-ubuntu-2404
+    runs-on: blacksmith-4vcpu-ubuntu-2404
     timeout-minutes: 45
     env:
       ARCH: ${{ matrix.arch }}
@@ -629,7 +629,7 @@ jobs:
     name: Assemble versioned manifest and digest receipt
     if: needs.mode.outputs.phase == 'publish'
     needs: [mode, release-publish]
-    runs-on: blacksmith-8vcpu-ubuntu-2404
+    runs-on: blacksmith-4vcpu-ubuntu-2404
     outputs:
       digest: ${{ steps.list.outputs.digest }}
     timeout-minutes: 15
@@ -762,7 +762,7 @@ jobs:
     name: Docker phase requirements met
     if: always() && inputs.release-phase != ''
     needs: [mode, build, release-publish, release-publish-manifest]
-    runs-on: blacksmith-8vcpu-ubuntu-2404
+    runs-on: blacksmith-2vcpu-ubuntu-2404
     timeout-minutes: 5
     steps:
       - name: Validate phase job results
diff --git a/.github/workflows/nix.yml b/.github/workflows/nix.yml
index 696e2de4f7..6a067ae0e4 100644
--- a/.github/workflows/nix.yml
+++ b/.github/workflows/nix.yml
@@ -60,7 +60,7 @@ jobs:
   # flake turns main red after the merge.
   detect:
     name: Detect affected areas
-    runs-on: blacksmith-8vcpu-ubuntu-2404
+    runs-on: blacksmith-4vcpu-ubuntu-2404
     timeout-minutes: 10
     outputs:
       nix: ${{ steps.classify.outputs.nix }}
@@ -80,7 +80,7 @@ jobs:
     name: pnpm deps hash
     needs: [detect]
     if: needs.detect.outputs.nix == 'true' || inputs.release == true
-    runs-on: blacksmith-8vcpu-ubuntu-2404
+    runs-on: blacksmith-4vcpu-ubuntu-2404
     timeout-minutes: 20
     steps:
       - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a  # v7.0.1 (fork: upstream uses useblacksmith/checkout)
@@ -113,7 +113,7 @@ jobs:
     # takes minutes and not seconds when the cache misses. `nix flake check`
     # builds 21 checks, and --max-jobs defaults to the core count. It uses the
     # wider runner with no more configuration.
-    runs-on: blacksmith-8vcpu-ubuntu-2404
+    runs-on: blacksmith-4vcpu-ubuntu-2404
     timeout-minutes: 60
     steps:
       - name: Checkout code
diff --git a/.github/workflows/remote-backends.yml b/.github/workflows/remote-backends.yml
