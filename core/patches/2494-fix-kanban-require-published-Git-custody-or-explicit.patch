+def _publish(git_task, tmp_path):
+    _, _, git = git_task
+    remote = tmp_path / 'origin.git'
+    subprocess.check_call(['git', 'init', '--bare', str(remote)], stdout=subprocess.DEVNULL)
+    git('remote', 'add', 'origin', str(remote))
+    git('push', 'origin', 'HEAD')
+    return remote
