+                if _hold_route:
+                    job[ROUTE_FLAG] = _hold_route
         except Exception:  # classification must never mask the real failure
             logger.debug("Job '%s': unreachable-failure classification failed", job_id)
         # No audit row when we failed before the agent existed; the audit write must never raise.
diff --git a/cron/scheduler_bookkeeping.py b/cron/scheduler_bookkeeping.py
index 09121bf6e3c..3369ad2f3da 100644
--- a/cron/scheduler_bookkeeping.py
+++ b/cron/scheduler_bookkeeping.py
@@ -74,9 +74,12 @@ def finish_completed_run(d, fire_owner: Optional[str], execution_id: str, *, rec
         # A re-run of an occurrence that already counted: must not spend another repeat slot.
         mark_kwargs["ladder_rung"] = True
     _hold_s = job.pop("_quota_hold_seconds", None)
+    _hold_route = job.pop("_quota_hold_route", None)
     if not d.success and _hold_s:
         # Provider window closed for a known duration: park past it (cron/quota_hold.py, #89376).
         mark_kwargs["quota_hold_seconds"] = _hold_s
+        if _hold_route:
+            mark_kwargs["quota_hold_route"] = _hold_route
         mark_kwargs["recover_consumed_fire"] = bool(job.get("_scheduled_instant"))
     if d.success and not d.delivery_error and d.should_deliver and job.get("last_delivery_queued"):
         mark_kwargs["status"] = "delivery_queued"
diff --git a/gateway/session_cron.py b/gateway/session_cron.py
index 43e7ecc9a56..00a954ee324 100644
--- a/gateway/session_cron.py
+++ b/gateway/session_cron.py
@@ -159,7 +159,7 @@ CRON_SESSION_READ_ONLY_SURFACE = {'layer': 'gateway', 'code': 'cron_session_read
 # keeps the job's last real verdict (failure streak, alert-once marker) instead of resetting it.
