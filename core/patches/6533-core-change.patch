diff --git a/hermes_cli/kanban_owner_reassessment.py b/hermes_cli/kanban_owner_reassessment.py
new file mode 100644
index 00000000000..2b82bf2ee18
--- /dev/null
+++ b/hermes_cli/kanban_owner_reassessment.py
@@ -0,0 +1,294 @@
+"""Opt-in bounded owner reassessment; never evidence of producer health.
+
+The schedule/continue lifecycle creates a pending journal record here, but no
+scanner path reads it as an exemption until canonical proof is installed.
+Shape validation alone grants no authority; the record has execution_authority false.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+import json
+import re
+import sqlite3
+import time
+
+_UID = re.compile(r'[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}')
+_REQUEST = {'version', 'reassess_at', 'target', 'evidence_refs'}
+
+
+class ReassessmentRefused(ValueError):
+    """No effective deferral may be recorded for this request."""
+
+
+def _keys(value, required, optional=()):
+    return isinstance(value, dict) and required <= value.keys() <= required | set(optional)
+
+
+def _text(value, maximum):
+    return isinstance(value, str) and bool(value.strip()) and len(value) <= maximum
+
+
+def _uid(value):
+    return isinstance(value, str) and _UID.fullmatch(value) is not None
+
+
+def request(value):
+    """Validate opt-in input without accepting caller-supplied authority fields."""
+    if not _keys(value, _REQUEST) or type(value['version']) is not int or value['version'] != 1:
+        raise ReassessmentRefused('invalid owner reassessment request')
+    target, refs = value['target'], value['evidence_refs']
+    if (type(value['reassess_at']) is not int or value['reassess_at'] <= 0
+            or not _keys(target, {'kind', 'identity', 'revision'})
+            or target['kind'] not in ('queue', 'update', 'external')
+            or not _text(target['identity'], 512) or not _text(target['revision'], 256)
+            or not isinstance(refs, list) or not 1 <= len(refs) <= 16
+            or not all(_keys(r, {'table', 'uid'}) and r['table'] == 'task_events' and _uid(r['uid']) for r in refs)
+            or len({r['uid'] for r in refs}) != len(refs)):
+        raise ReassessmentRefused('invalid target, deadline or portable evidence')
+    return deepcopy(value)
+
+
+def issuer(captured, conn, task_id):
+    """Revalidate actual private owner custody in the caller's park transaction.
+
+    Environment pins, dictionaries and injected projection objects are not issuers.
+    The portable event references must already exist; legacy prose is not upgraded.
+    """
+    from agent.origin_worker_custody import CapturedWorkerOrigin
+
+    if not conn.in_transaction or type(captured) is not CapturedWorkerOrigin:
+        raise ReassessmentRefused('reassessment requires private admitted owner custody')
+    # The capability rechecks both task/run claims and the actual facade turn lease.
+    if captured.validated(conn) != {'creator': task_id}:
+        raise ReassessmentRefused('owner custody is no longer current')
+    capability = captured._capability
+    run = conn.execute('SELECT uid FROM task_runs WHERE id=? AND task_id=?',
+                       (capability.run_id, task_id)).fetchone()
+    events = {}
+    for kind in ('owner_admitted', 'worker_bound'):
+        row = conn.execute('SELECT uid,payload FROM task_events WHERE task_id=? AND run_id=? '
+                           'AND kind=? ORDER BY id DESC LIMIT 1', (task_id, capability.run_id, kind)).fetchone()
+        if row is None or not _uid(row[0]):
+            raise ReassessmentRefused('portable owner admission evidence is missing')
+        try:
+            payload = json.loads(row[1])
+        except (TypeError, ValueError) as exc:
+            raise ReassessmentRefused('owner admission evidence is malformed') from exc
+        if not isinstance(payload, dict):
+            raise ReassessmentRefused('owner admission evidence is malformed')
+        events[kind] = (row[0], payload)
+    if (run is None or not _uid(run[0])
+            or events['owner_admitted'][1].get('session_id') != capability.session_id
+            or events['worker_bound'][1].get('pid') != capability.pid
+            or events['worker_bound'][1].get('claim_lock') != capability.claim_lock
+            or captured.validated(conn) != {'creator': task_id}):
+        raise ReassessmentRefused('owner admission identity changed')
+    return {'task_id': task_id, 'session_id': capability.session_id, 'profile': capability.profile, 'run_uid': run[0],
+            'owner_admitted_uid': events['owner_admitted'][0], 'worker_bound_uid': events['worker_bound'][0]}
+
+
+def plan(value, *, now, final_backstop, awaiting, payload):
+    """Shorten, never extend, the admitted wake; preserve the original backstop.
+
+    Called only after ordinary awaiting/deploy-window/probe gates. This pure plan
+    neither authenticates an owner nor writes a receipt. Expiry uses the existing
+    dispatcher deadline, rather than an additional polling service.
+    """
+    value = request(value)
+    if (type(now) is not int or type(final_backstop) is not int
+            or not now < value['reassess_at'] <= final_backstop):
+        raise ReassessmentRefused('reassessment must precede the admitted backstop')
+    if (not _keys(awaiting, {'kind', 'ref'}, ('gateway', 'board', 'why'))
+            or awaiting['kind'] not in ('card', 'ci', 'deploy', 'external')
+            or not _text(awaiting['ref'], 512)
+            or ('gateway' in awaiting and not _text(awaiting['gateway'], 200))
+            or ('board' in awaiting and not _text(awaiting['board'], 200))
+            or ('why' in awaiting and not _text(awaiting['why'], 2000))):
+        raise ReassessmentRefused('an exact structured producer is required')
+    if not isinstance(payload, dict) or payload.get('wake_at') != final_backstop:
+        raise ReassessmentRefused('final admitted park plan changed')
+    return {**deepcopy(payload), 'wake_at': value['reassess_at'], 'awaiting': deepcopy(awaiting)}, final_backstop
+
+
+PENDING_TABLE = 'kanban_owner_reassessment_pending'
+_PRODUCER_KEYS = ('kind', 'ref', 'gateway', 'board', 'why')
+
+
+def producer(record):
+    """Project the admitted normalized identity, not gate/probe diagnostic fields.
+
+    Preserve board as well as gateway: the same task ref on a different board is
+    not the same producer. Inferred and shared-blocker waits are never opt-ins.
+    """
+    if not isinstance(record, dict) or record.get('shared_blocker') or record.get('inferred'):
+        return None
+    return {k: deepcopy(record[k]) for k in _PRODUCER_KEYS if k in record}
+
+
+def _refuse(message):
+    raise ReassessmentRefused(message)
+
+
+def ensure_schema(conn):
+    """Internal immutable journal; created inside the caller's park transaction."""
+    conn.execute(f'CREATE TABLE IF NOT EXISTS {PENDING_TABLE} (event_uid TEXT PRIMARY KEY, '
+                 'task_id TEXT NOT NULL, episode_uid TEXT NOT NULL UNIQUE, '
+                 'receipt TEXT NOT NULL, created_at INTEGER NOT NULL)')
+    conn.execute(f'CREATE TRIGGER IF NOT EXISTS {PENDING_TABLE}_immutable BEFORE UPDATE ON {PENDING_TABLE} '
+                 "BEGIN SELECT RAISE(ABORT, 'owner reassessment receipt is immutable'); END")
+    conn.execute(f'CREATE TRIGGER IF NOT EXISTS {PENDING_TABLE}_no_delete BEFORE DELETE ON {PENDING_TABLE} '
+                 "BEGIN SELECT RAISE(ABORT, 'owner reassessment receipt is immutable'); END")
+    # REPLACE may delete without firing DELETE triggers (recursive_triggers OFF).
+    # Intercept unique-key AND explicit rowid conflicts before conflict handling.
+    conn.execute(f'CREATE TRIGGER IF NOT EXISTS {PENDING_TABLE}_no_replace BEFORE INSERT ON {PENDING_TABLE} '
+                 f'WHEN EXISTS (SELECT 1 FROM {PENDING_TABLE} WHERE event_uid=NEW.event_uid '
+                 'OR episode_uid=NEW.episode_uid OR rowid=NEW.rowid) '
+                 "BEGIN SELECT RAISE(ABORT, 'owner reassessment receipt is immutable'); END")
+
+
+def pending(conn, task_id=None):
+    """Parent accessor: exact journal rows ``{event_uid, task_id, episode_uid, receipt}`` (receipt is
+    the stored JSON string, byte-for-byte). An absent table means nothing was ever recorded."""
+    if conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (PENDING_TABLE,)).fetchone() is None:
+        return []
+    sql, args = f'SELECT event_uid,task_id,episode_uid,receipt FROM {PENDING_TABLE}', ()
+    if task_id is not None:
+        sql, args = sql + ' WHERE task_id=?', (task_id,)
+    return [dict(zip(('event_uid', 'task_id', 'episode_uid', 'receipt'), row))
+            for row in conn.execute(sql + ' ORDER BY rowid', args).fetchall()]
+
+
+def prepare(conn, task_id, value, *, captured, record, op, expected_run_id, now, final_backstop,
+            immediate=False, clock_only=False, blocker_id=None, declared=False):
+    """Validate an opt-in against the FINAL admitted park, before claims are cleared.
+
+    Call after every ordinary awaiting/deploy-window/probe/escalation gate and before the
+    task/run UPDATE. Raises without private captured authority, a structured supported
+    producer, an admitted future wake, or evidence that already exists on this card.
+    Writes nothing.
+    """
+    if immediate or clock_only or blocker_id or not declared:
+        _refuse('reassessment needs a timed park on an exact producer')
+    request(value)
+    if isinstance(final_backstop, float) and final_backstop.is_integer():
+        final_backstop = int(final_backstop)
+    normalized = producer(record)
+    result, backstop = plan(value, now=now, final_backstop=final_backstop, awaiting=normalized,
+                            payload={'wake_at': final_backstop})
+    try:
+        who = issuer(captured, conn, task_id)
+        capability = captured._capability
+        for ref in request(value)['evidence_refs']:
+            if conn.execute('SELECT 1 FROM task_events WHERE uid=? AND task_id=? AND run_id=?',
+                            (ref['uid'], task_id, capability.run_id)).fetchone() is None:
+                _refuse('portable evidence is not on this owner run')
+    except sqlite3.OperationalError as exc:  # a board without portable uids cannot carry a receipt
+        raise ReassessmentRefused('board has no portable event identities') from exc
+    capability = captured._capability
+    if expected_run_id is None or int(expected_run_id) != capability.run_id:
+        _refuse('reassessment must come from the admitted owner run')
+    from hermes_cli.kanban_db_sync import uuid7
+    return {'request': request(value), 'issuer': who, 'producer': normalized, 'op': op,
+            'wake_at': result['wake_at'], 'backstop_at': backstop, 'issued_at': now,
+            'episode_uid': uuid7(), 'board': capability.board, 'gateway': capability.gateway,
+            'run_id': capability.run_id}
+
+
+def continuation_park(conn, task_id, *, checkpoint, wake_at, resume_after, wake_check, check_every,
+                      clock_only, awaiting, blocker_id, metadata, owner_reassessment, owner_origin,
+                      expected_run_id, current_run_id, streak, now):
+    """Admit the ordinary continue park before shortening it for owner reassessment.
+
+    Return (plan, terminal_result); refusals and repeated-park escalations terminate
+    the caller unchanged. All gates run in its existing write transaction, before
+    claims clear. Only reassessment refusals are converted at the prepare boundary.
+    """
+    from hermes_cli import kanban_wake_check as kwc
+
+    record = None
+    reassess = None
+    if wake_at is None and owner_reassessment is not None:
+        return None, {"ok": False, "reason_code": "owner_reassessment_refused",
+                      "error": "owner reassessment needs a delayed continue"}
+    if wake_at is not None:
+        from hermes_cli import kanban_awaiting as kaw
+        try:
+            record = kaw.gate(conn, task_id, awaiting=awaiting, reason=checkpoint, wake_check=wake_check,
+                              clock_only=clock_only, op="continue", wake_in=resume_after,
+                              blocker_id=blocker_id or (metadata or {}).get("blocker_id"))
+        except kaw.AwaitingError as exc:
+            return None, {"ok": False, "error": str(exc), "reason_code": exc.code}
+        except kaw.RepeatedPark as rp:
+            owner = kaw.escalate(conn, task_id, record=rp.record, reason=checkpoint,
+                                 expected_run_id=int(current_run_id))
+            if owner is None:
+                return None, {"ok": False, "error": "task changed state concurrently"}
+            return None, {"ok": True, "status": "todo", "run_id": None, "continuation": streak,
+                          "wake_at": None, "escalated_to": owner}
+        from hermes_cli import kanban_deploy_window as kdw
+        wake_at, noted = kdw.apply(record, wake_at, checkpoint, now=now)
+        checkpoint = noted or checkpoint
+        noted, check_every = kaw.resource_apply(record, checkpoint, check_every)
+        checkpoint = noted or checkpoint
+        wake_check, clock_only = kaw.park_probe(conn, task_id, record, wake_check, clock_only)
+        why = kaw.park_cycle_error(conn, task_id, record, wake_check)
+        if why:
+            return None, {"ok": False, "error": why, "reason_code": kaw.INVALID_AWAITING}
+    try:
+        wake_check, check_every = kwc.validate_park(
+            wake_at=wake_at, wake_check=wake_check,
+            check_every=check_every, clock_only=clock_only)
+    except ValueError as exc:
+        return None, {"ok": False, "error": str(exc)}
+    if owner_reassessment is not None and wake_at is not None:
+        # Every ordinary gate above judged the ORIGINAL admitted wake; only now is it shortened.
+        try:
+            reassess = prepare(
+                conn, task_id, owner_reassessment, captured=owner_origin, record=record, op="continue",
+                expected_run_id=expected_run_id, now=now, final_backstop=wake_at, clock_only=clock_only,
+                blocker_id=blocker_id or (metadata or {}).get("blocker_id"),
+                declared=bool(awaiting))
+        except ReassessmentRefused as exc:
+            return None, {"ok": False, "error": str(exc), "reason_code": "owner_reassessment_refused"}
+        wake_at = reassess["wake_at"]
+        resume_after = wake_at - now
+    return (record, checkpoint, wake_at, wake_check, check_every, clock_only, reassess, resume_after), None
+
+
+def commit(conn, prepared, *, kind, run_id):
+    """After the park event is appended in the same txn: record the exact immutable receipt."""
+    if run_id != prepared['run_id']:
+        _refuse('park did not end the admitted owner run')
+    task_id = prepared['issuer']['task_id']
+    row = conn.execute('SELECT id,uid,payload,created_at,run_id FROM task_events WHERE task_id=? '
+                       'AND kind=? ORDER BY id DESC LIMIT 1', (task_id, kind)).fetchone()
+    try:
+        data = json.loads(row[2]) if row else None
+    except (TypeError, ValueError):
+        data = None
+    awaiting = data.get('awaiting') if isinstance(data, dict) else None
+    if (row is None or not _uid(row[1]) or row[4] != run_id or not isinstance(awaiting, dict)
+            or data.get('owner_reassessment_episode_uid') != prepared['episode_uid']
+            or data.get('wake_at') != prepared['wake_at']
+            or producer(awaiting) != prepared['producer']):
+        _refuse('park event does not carry the planned reassessment')
+    run = conn.execute('SELECT uid FROM task_runs WHERE id=?', (run_id,)).fetchone()
+    if run is None or run[0] != prepared['issuer']['run_uid']:
+        _refuse('park run identity changed')
+    req = prepared['request']
+    receipt = {'version': 1, 'board': prepared['board'], 'task_id': task_id,
+               'gateway': prepared['gateway'], 'episode_uid': prepared['episode_uid'],
+               'park_event': {'uid': row[1], 'run_uid': run[0], 'kind': kind,
+                              'created_at': row[3], 'payload': row[2]},
+               'issuer': {k: v for k, v in prepared['issuer'].items() if k != 'task_id'},
+               'producer': prepared['producer'], 'target': req['target'],
+               'issued_at': prepared['issued_at'], 'reassess_at': prepared['wake_at'],
+               'backstop_at': prepared['backstop_at'], 'evidence_refs': req['evidence_refs'],
+               'suppresses': ['too_long'], 'execution_authority': False}
+    ensure_schema(conn)
+    conn.execute(f'INSERT INTO {PENDING_TABLE} (event_uid,task_id,episode_uid,receipt,created_at) VALUES (?,?,?,?,?)',
+                 (row[1], task_id, receipt['episode_uid'],
+                  json.dumps(receipt, sort_keys=True, separators=(',', ':'), ensure_ascii=False), int(time.time())))
+    from hermes_cli.kanban_owner_reassessment_transport import capture
+    capture(conn, receipt)
+    return receipt
diff --git a/hermes_cli/kanban_owner_reassessment_canonical.py b/hermes_cli/kanban_owner_reassessment_canonical.py
new file mode 100644
index 00000000000..b8e03d4f7f4
--- /dev/null
+++ b/hermes_cli/kanban_owner_reassessment_canonical.py
@@ -0,0 +1,162 @@
+"""Canonical Board certification of an owner reassessment receipt.
+
+Pure verifier over an authenticated Board ``/evidence?table=task_events`` response
+(``Hub.row_evidence``). Neither the sender's pending journal, a replica event, nor any
+self-asserted JSON grants anything: the Board's own ``owner_reassessment_v1``
+attestation must agree, field by field, with the canonical park event row it carries.
+Unknown, missing or unavailable proof is a refusal. The receipt always has
+``execution_authority`` false; this module installs no suppression or capability.
+"""
+from __future__ import annotations
+
+import json
+from collections.abc import Mapping
+from copy import deepcopy
+from typing import Any
+
+from hermes_cli.kanban_owner_reassessment import ReassessmentRefused, _uid, producer, request
+
+MAX_EVIDENCE_BYTES = 256 * 1024
+PARK_KINDS = ("scheduled", "continued")
+_RECEIPT = {"version", "board", "task_id", "gateway", "episode_uid", "park_event", "issuer", "producer",
+            "target", "issued_at", "reassess_at", "backstop_at", "evidence_refs", "suppresses",
+            "execution_authority"}
+_PARK = {"uid", "run_uid", "kind", "created_at", "payload"}
+_ISSUER = {"owner_admitted_uid", "profile", "run_uid", "session_id", "worker_bound_uid"}
+# Board re-stamps these on an unchanged row; they are not certified identity.
+ROW_BOOKKEEPING = frozenset({"seq", "hlc", "updated_at", "version"})
+
+
+def _int(v: Any) -> bool:
+    return type(v) is int and v > 0
+
+
+def _str(v: Any) -> bool:
+    return isinstance(v, str) and bool(v)
+
+
+def _no_dupes(pairs):
+    out = {}
+    for k, v in pairs:
+        if k in out:
+            raise ValueError("duplicate JSON key")
+        out[k] = v
+    return out
+
+
+def _refuse_const(name):
+    raise ValueError(f"non-finite JSON constant {name}")
+
+
+def parse_evidence(raw: str | bytes) -> Any:
+    """Bounded parse of serialized evidence: size is checked *before* json parsing.
+
+    Duplicate keys and NaN/Infinity are refused. This bounds stored/pickup text only; the Hub
+    transport's own raw-response read is a separate seam (see ``Hub._call``).
+    """
+    if not isinstance(raw, (str, bytes)) or len(raw) > MAX_EVIDENCE_BYTES:  # chars <= bytes
+        raise ReassessmentRefused("canonical reassessment evidence is too large or not text")
+    if isinstance(raw, str) and len(raw.encode()) > MAX_EVIDENCE_BYTES:
+        raise ReassessmentRefused("canonical reassessment evidence is too large")
+    try:
+        return json.loads(raw, object_pairs_hook=_no_dupes, parse_constant=_refuse_const)
+    except (ValueError, RecursionError) as exc:
+        raise ReassessmentRefused("canonical reassessment evidence is not valid JSON") from exc
+
+
+def canonical_bytes(evidence: Any) -> str:
+    """Serialized evidence, bounded; raises before any storage on oversize/non-finite."""
+    try:
+        raw = json.dumps(evidence, sort_keys=True, separators=(",", ":"), allow_nan=False)
+    except (TypeError, ValueError) as exc:
+        raise ReassessmentRefused("canonical reassessment evidence is not JSON") from exc
+    if len(raw.encode()) > MAX_EVIDENCE_BYTES:
+        raise ReassessmentRefused("canonical reassessment evidence is too large")
+    return raw
+
+
+def certified_receipt(evidence: Any, *, board: str, task: str, uid: str, sender: Mapping | None = None) -> dict:
+    """Return the Board-attested receipt for park event ``uid`` or raise ReassessmentRefused.
+
+    ``sender`` (optional) is the sending side's receipt; it must equal the Board's
+    attestation exactly, so a sender can never widen what the Board attested.
+    """
+    canonical_bytes(evidence)
+    bad = ReassessmentRefused
+    if (not isinstance(evidence, Mapping) or evidence.get("board") != board or evidence.get("table") != "task_events"
+            or evidence.get("uid") != uid or evidence.get("state") != "live" or not _uid(uid)):
+        raise bad("canonical reassessment event identity is unproven")
+    row, r = evidence.get("row"), evidence.get("owner_reassessment_v1")
+    if not isinstance(row, Mapping) or not isinstance(r, Mapping) or set(r) != _RECEIPT:
+        raise bad("canonical reassessment attestation is missing or malformed")
+    park, issuer = r["park_event"], r["issuer"]
+    if (not isinstance(park, Mapping) or set(park) != _PARK or not isinstance(issuer, Mapping)
+            or set(issuer) != _ISSUER):
+        raise bad("canonical reassessment attestation is malformed")
+    try:
+        payload = parse_evidence(park["payload"]) if isinstance(park["payload"], str) else None
+    except ReassessmentRefused:
+        payload = None
+    try:  # exact target / deadline / evidence refs: the same validator the sender used
+        request({"version": 1, "reassess_at": r["reassess_at"], "target": r["target"],
+                 "evidence_refs": r["evidence_refs"]})
+    except ReassessmentRefused as exc:
+        raise bad("canonical reassessment target, deadline or evidence refs are invalid") from exc
+    awaiting = payload.get("awaiting") if isinstance(payload, dict) else None
+    ok = (
+        type(r["version"]) is int and r["version"] == 1 and r["board"] == board and r["task_id"] == task
+        and _str(r["gateway"]) and _uid(r["episode_uid"]) and r["episode_uid"] != uid
+        and _str(issuer["profile"]) and _str(issuer["session_id"]) and r["execution_authority"] is False
+        and r["suppresses"] == ["too_long"]
+        and park["uid"] == uid and _uid(park["run_uid"]) and park["kind"] in PARK_KINDS
+        and _int(park["created_at"]) and isinstance(park["payload"], str)
+        and issuer["run_uid"] == park["run_uid"] and _uid(issuer["owner_admitted_uid"])
+        and _uid(issuer["worker_bound_uid"])
+        and all(_int(r[k]) for k in ("issued_at", "reassess_at", "backstop_at"))
+        and r["issued_at"] < r["reassess_at"] <= r["backstop_at"]
+        and isinstance(payload, dict) and payload.get("owner_reassessment_episode_uid") == r["episode_uid"]
+        and payload.get("wake_at") == r["reassess_at"]
+        and (park["kind"] == "scheduled" or payload.get("status") == "scheduled")
+        and isinstance(awaiting, dict) and r["producer"] is not None and producer(awaiting) == r["producer"]
+        and producer(r["producer"]) == r["producer"]
+        # the canonical row, not the attestation, must carry the same bytes and identity
+        and row.get("uid") == uid and row.get("task_id") == task and row.get("kind") == park["kind"]
+        and row.get("payload") == park["payload"] and row.get("run_uid") == park["run_uid"]
+        and row.get("created_at") == park["created_at"] and row.get("origin_gateway") == r["gateway"]
+        and row.get("deleted_at") is None
+    )
+    if not ok:
+        raise bad("canonical reassessment attestation does not match the canonical park event")
+    if sender is not None and dict(sender) != dict(r):
+        raise bad("sender receipt differs from the Board attestation")
+    return deepcopy(dict(r))
+
+
+def certified_identity(evidence: Mapping) -> str:
+    """Certified fields only: the row without server bookkeeping, plus the attestation."""
+    row = {k: v for k, v in evidence["row"].items() if k not in ROW_BOOKKEEPING}
+    return json.dumps([row, evidence["owner_reassessment_v1"]], sort_keys=True, separators=(",", ":"))
+
+
+def event_matches(event: Mapping, receipt: Mapping) -> bool:
+    """Does a local/replica event row equal the attested park event?"""
+    p = receipt["park_event"]
+    return (event.get("uid") == p["uid"] and event.get("task_id") == receipt["task_id"]
+            and event.get("kind") == p["kind"] and event.get("payload") == p["payload"]
+            and event.get("created_at") == p["created_at"]
+            and (event.get("origin_gateway") in (None, receipt["gateway"])))
+
+
+def current_matches(receipt: Mapping, task: Mapping, *, latest_park_uid: str | None, now: int) -> bool:
+    """Is *this* receipt still the live park? Historical receipts for the same card never match.
+
+    ``latest_park_uid`` is the uid of the card's newest park event (see
+    ``replica.latest_park_uid``); a later park/continue, however similar, supersedes the receipt.
+    ``now`` must be before the receipt's own backstop. A task ``wake_at``, when supplied, must equal
+    the attested ``reassess_at``.
+    """
+    return (task.get("id") == receipt["task_id"] and task.get("status") == "scheduled"
+            and task.get("current_run_id") is None
+            and latest_park_uid == receipt["park_event"]["uid"]
+            and type(now) is int and now < receipt["backstop_at"]
+            and ("wake_at" not in task or task["wake_at"] == receipt["reassess_at"]))
diff --git a/hermes_cli/kanban_owner_reassessment_replica.py b/hermes_cli/kanban_owner_reassessment_replica.py
new file mode 100644
index 00000000000..be7950f0440
--- /dev/null
+++ b/hermes_cli/kanban_owner_reassessment_replica.py
@@ -0,0 +1,214 @@
+"""Durable, append-only replica of Board-certified owner reassessment receipts.
+
+Host-local, never synced. Only a ``Hub.row_evidence`` read performed *here* (or, for
+offline pickup copies, an already-certified row re-certified from the source replica)
+is stored; payload projections, sender journals and request JSON are never inputs.
+A stored receipt is re-certified from its own evidence on every read. Nothing here
+suppresses a detector or advertises a capability.
+"""
+from __future__ import annotations
+
+import contextvars
+import sqlite3
+
+from hermes_cli import kanban_owner_reassessment_canonical as canonical
+from hermes_cli.kanban_containment_functions import register as register_function
+from hermes_cli.kanban_owner_reassessment import ReassessmentRefused
+
+TABLE = "owner_reassessment_canonical_receipts"
+_PERMIT: contextvars.ContextVar[sqlite3.Connection | None] = contextvars.ContextVar("owner_reassessment_cache_write", default=None)
+
+
+class ReassessmentConflict(ReassessmentRefused):
+    """A different canonical identity arrived for an already-recorded receipt."""
+
+
+def register(conn: sqlite3.Connection) -> None:
+    register_function(conn, "kanban_owner_reassessment_cache_write", 0,
+                      lambda: int(_PERMIT.get() is conn and conn.in_transaction))
+
+
+def install(conn: sqlite3.Connection) -> None:
+    register(conn)
+    conn.execute(f"CREATE TABLE IF NOT EXISTS {TABLE} (event_uid TEXT PRIMARY KEY, board TEXT NOT NULL, "
+                 "task_id TEXT NOT NULL, episode_uid TEXT NOT NULL UNIQUE, run_uid TEXT NOT NULL, "
+                 "gateway TEXT NOT NULL, evidence TEXT NOT NULL)")
+    abort = "BEGIN SELECT RAISE(ABORT,'owner reassessment canonical receipt is immutable'); END"
+    for op in ("UPDATE", "DELETE"):
+        conn.execute(f"CREATE TRIGGER IF NOT EXISTS {TABLE}_{op.lower()} BEFORE {op} ON {TABLE} {abort}")
+    conn.execute(f"CREATE TRIGGER IF NOT EXISTS {TABLE}_insert BEFORE INSERT ON {TABLE} "
+                 f"WHEN NOT kanban_owner_reassessment_cache_write() {abort}")
+    # REPLACE deletes without DELETE triggers: refuse every key/rowid conflict before it resolves.
+    conn.execute(f"CREATE TRIGGER IF NOT EXISTS {TABLE}_no_replace BEFORE INSERT ON {TABLE} "
+                 f"WHEN EXISTS (SELECT 1 FROM {TABLE} WHERE event_uid=NEW.event_uid "
+                 f"OR episode_uid=NEW.episode_uid OR rowid=NEW.rowid) {abort}")
+
+
+def _board(conn: sqlite3.Connection) -> str | None:
+    if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='kanban_sync_state'").fetchone():
+        return None
+    row = conn.execute("SELECT board_id FROM kanban_sync_state LIMIT 1").fetchone()
+    return row[0] if row else None
+
+
+def _store(conn: sqlite3.Connection, evidence: dict, receipt: dict) -> None:
+    """Insert exact evidence. Private: callers certify first (see :func:`certify`)."""
+    if _board(conn) != receipt["board"]:
+        raise ReassessmentRefused("canonical reassessment receipt belongs to a different board")
+    raw = canonical.canonical_bytes(evidence)
+    install(conn)
+    from hermes_cli import kanban_db as kb
+    uid = receipt["park_event"]["uid"]
+    values = (uid, receipt["board"], receipt["task_id"], receipt["episode_uid"],
+              receipt["park_event"]["run_uid"], receipt["gateway"], raw)
+    with kb.write_txn(conn, allow_nested=True):
+        prior = conn.execute(f"SELECT event_uid,board,task_id,episode_uid,run_uid,gateway,evidence FROM {TABLE} "
+                             "WHERE event_uid=? OR episode_uid=?", (uid, receipt["episode_uid"])).fetchall()
+        if prior:
+            import json
+            if (len(prior) != 1 or tuple(prior[0])[:6] != values[:6]
+                    or canonical.certified_identity(canonical.parse_evidence(prior[0][6])) != canonical.certified_identity(evidence)):
+                raise ReassessmentConflict("canonical reassessment identity changed")
+            return  # append-only: the first observation is kept
+        token = _PERMIT.set(conn)
+        try:
+            conn.execute(f"INSERT INTO {TABLE} VALUES (?,?,?,?,?,?,?)", values)
+        finally:
+            _PERMIT.reset(token)
+
+
+def certify(conn: sqlite3.Connection, hub, board: str, *, task: str, uid: str, sender=None) -> dict:
+    """Fetch the Board's own evidence (outside any writer transaction), certify, then record.
+
+    Any transport error propagates and records nothing: unavailable proof never authorizes.
+    ``sender`` is the sender's receipt; direct delivery certification passes it so the Board's
+    attestation must equal it exactly and the enrolled sender gateway must be the original one.
+    """
+    if conn.in_transaction:
+        raise ReassessmentRefused("canonical reassessment fetch cannot run inside a writer transaction")
+    evidence = hub.row_evidence(board, "task_events", uid, max_response_bytes=canonical.MAX_EVIDENCE_BYTES)
+    receipt = canonical.certified_receipt(evidence, board=board, task=task, uid=uid, sender=sender)
+    if sender is not None and getattr(getattr(hub, "ident", None), "gateway", None) != receipt["gateway"]:
+        raise ReassessmentRefused("receipt was not originally admitted through this enrolled gateway")
+    _store(conn, evidence, receipt)
+    return receipt
+
+
+def verified_receipt(conn: sqlite3.Connection, event_uid: str | None) -> dict | None:
+    """Reopened durable proof, re-certified from stored evidence; None when absent or invalid.
+
+    Callers must still check :func:`canonical.event_matches` against their event row and
+    :func:`canonical.current_matches` against the current task before relying on it.
+    """
+    import json
+    if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (TABLE,)).fetchone():
+        return None
+    row = conn.execute(f"SELECT board,task_id,episode_uid,run_uid,gateway,evidence FROM {TABLE} WHERE event_uid=?",
+                       (event_uid,)).fetchone()
+    if row is None or row[0] != _board(conn):
+        return None
+    try:
+        receipt = canonical.certified_receipt(canonical.parse_evidence(row[5]), board=row[0], task=row[1], uid=event_uid)
+    except ReassessmentRefused:
+        return None
+    if (row[2], row[3], row[4]) != (receipt["episode_uid"], receipt["park_event"]["run_uid"], receipt["gateway"]):
+        return None
+    return receipt
+
+
+def latest_park_uid(conn: sqlite3.Connection, task_id: str) -> str | None:
+    """Newest live park event uid of the card in this replica; None when unreadable (fail closed)."""
+    try:
+        # Local execution DBs physically remove tombstones and have no deleted_at;
+        # shadow replicas may retain that column. Never require one schema's shape.
+        columns = {r[1] for r in conn.execute('PRAGMA table_info(task_events)')}
+        live = ' AND deleted_at IS NULL' if 'deleted_at' in columns else ''
+        rows = conn.execute('SELECT uid,created_at,id FROM task_events WHERE task_id=? '
+                            'AND kind IN (?,?)' + live + ' ORDER BY created_at DESC LIMIT 129',
+                            (task_id, *canonical.PARK_KINDS)).fetchall()
+        if not rows:
+            return None
+        newest_second = rows[0][1]
+        candidates = [dict(zip(('uid', 'created_at', 'id'), r)) for r in rows if r[1] == newest_second]
+        if len(candidates) > 128:
+            return None  # ambiguous over-bound tie, never guess from arrival order
+        from hermes_cli.kanban_sync_divergence import _event_order
+        # Local ids are arrival order, not portable authority. Even v7 events
+        # can share one millisecond: ambiguity must never select an old park.
+        ordered = [(_event_order(row)[:2], row['uid']) for row in candidates]
+        top = max(key for key, _uid in ordered)
+        winners = [uid for key, uid in ordered if key == top]
+        return winners[0] if len(winners) == 1 else None
+    except (sqlite3.Error, TypeError, ValueError):
+        return None
+
+
+def verified_for_event(conn: sqlite3.Connection, event: dict, task: dict | None = None,
+                       *, now: int | None = None) -> dict | None:
+    """Accessor for the scanner: receipt only if the event matches it.
+
+    With ``task`` (and ``now``) the receipt must also be the card's *current* park: newest park
+    event in this replica, scheduled without a run, before its backstop. Without ``task`` the
+    result is historical proof only and must not suppress anything.
+    """
+    receipt = verified_receipt(conn, event.get("uid")) if isinstance(event, dict) else None
+    if receipt is None or not canonical.event_matches(event, receipt):
+        return None
+    if task is not None and not canonical.current_matches(
+            receipt, task, latest_park_uid=latest_park_uid(conn, receipt["task_id"]), now=now):
+        return None
+    return receipt
+
+
+def _is_candidate(ch) -> bool:
+    import json
+    if ch.table != "task_events" or ch.op != "upsert" or ch.fields.get("kind") not in canonical.PARK_KINDS:
+        return False
+    try:
+        payload = canonical.parse_evidence(ch.fields.get("payload") or "")
+    except ReassessmentRefused:
+        return False
+    return isinstance(payload, dict) and "owner_reassessment_episode_uid" in payload
+
+
+def certify_page(conn: sqlite3.Connection, hub, board: str, changes) -> None:
+    """Prewriter seam (same signature as containment's). Fetch before the writer transaction.
+
+    A park event merely *claiming* an episode is ordinary history: if the Board attests nothing
+    for it, nothing is recorded and nothing is authorized (page still applies). Transport errors
+    abort the page; an attestation that contradicts the feed row or a recorded receipt raises.
+    """
+    for ch in changes:
+        if not _is_candidate(ch):
+            continue
+        evidence = hub.row_evidence(board, "task_events", ch.uid, max_response_bytes=canonical.MAX_EVIDENCE_BYTES)
+        if not isinstance(evidence, dict) or "owner_reassessment_v1" not in evidence:
+            continue
+        try:
+            receipt = canonical.certified_receipt(evidence, board=board, task=ch.fields.get("task_id"), uid=ch.uid)
+        except ReassessmentRefused:
+            continue  # malformed/lookalike attestation: no proof, no authority
+        if not canonical.event_matches({**ch.fields, "uid": ch.uid, "origin_gateway": ch.origin_gateway}, receipt):
+            raise ReassessmentConflict("replica event differs from its canonical reassessment receipt")
+        _store(conn, evidence, receipt)
+
+
+def adopt_receipts(conn: sqlite3.Connection, source: sqlite3.Connection, changes) -> None:
+    """Offline pickup: carry already-recorded receipts from the pulled replica, re-certified."""
+    import json
+    for ch in changes:
+        if not _is_candidate(ch):
+            continue
+        row = source.execute(f"SELECT evidence FROM {TABLE} WHERE event_uid=?", (ch.uid,)).fetchone() \
+            if source.execute("SELECT 1 FROM sqlite_master WHERE name=?", (TABLE,)).fetchone() else None
+        if row is None:
+            continue
+        try:
+            evidence = canonical.parse_evidence(row[0])
+            receipt = canonical.certified_receipt(evidence, board=evidence.get("board"), task=ch.fields.get("task_id"),
+                                                  uid=ch.uid)
+        except (ReassessmentRefused, AttributeError):
+            continue  # corrupt/foreign source row: carry nothing
+        if not canonical.event_matches({**ch.fields, "uid": ch.uid, "origin_gateway": ch.origin_gateway}, receipt):
+            raise ReassessmentConflict("replica event differs from its canonical reassessment receipt")
+        _store(conn, evidence, receipt)
diff --git a/hermes_cli/kanban_owner_reassessment_transport.py b/hermes_cli/kanban_owner_reassessment_transport.py
new file mode 100644
index 00000000000..288b9d79d19
--- /dev/null
+++ b/hermes_cli/kanban_owner_reassessment_transport.py
@@ -0,0 +1,77 @@
+"""Bind opt-in reassessment to its exact captured park op, never latest at send."""
+from __future__ import annotations
+
+import json
+
+from hermes_cli.kanban_owner_reassessment import PENDING_TABLE, ReassessmentRefused
+
+
+def capture(conn, receipt):
+    """Bind while the park transaction and its single status capture are live."""
+    task = receipt['task_id']
+    if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='kanban_sync_outbox'").fetchone():
+        return
+    changed = conn.execute('SELECT status,n FROM temp.kanban_status_changes WHERE task_id=?', (task,)).fetchone()
+    rows = conn.execute('SELECT op_id FROM temp.kanban_status_capture WHERE task_id=?', (task,)).fetchall()
+    if changed is None or tuple(changed) != ('scheduled', 1) or len(rows) != 1:
+        raise ReassessmentRefused('reassessment needs one exact status capture')
+    op_id = rows[0][0]
+    from hermes_cli.kanban_sync_status_origin import current_origin
+    ordinary_origin = current_origin(conn, task)
+    if ordinary_origin is None:
+        raise ReassessmentRefused('reassessment ordinary capture origin unavailable')
+    original = conn.execute('SELECT fields,wire_json FROM kanban_sync_outbox WHERE op_id=?', (op_id,)).fetchone()
+    if original is None or original[1] is not None:
+        raise ReassessmentRefused('reassessment ordinary capture already frozen')
+    fields = json.loads(original[0])
+    fields['owner_reassessment_fallback_status_origin'] = ordinary_origin
+    conn.execute('UPDATE kanban_sync_outbox SET fields=? WHERE op_id=? AND wire_json IS NULL',
+                 (json.dumps(fields, ensure_ascii=False, separators=(',', ':')), op_id))
+    conn.execute('UPDATE kanban_sync_outbox SET status_origin=? WHERE op_id=? AND wire_json IS NULL',
+                 (receipt['park_event']['uid'], op_id))
+    bind(conn, op_id=op_id, task_id=task, event_uid=receipt['park_event']['uid'])
+
+
+def captured_origin(conn, op_id, fallback):
+    """Read only this op's transaction-captured binding; never search latest task."""
+    row = conn.execute('SELECT fields,status_origin FROM kanban_sync_outbox WHERE op_id=?', (op_id,)).fetchone()
+    if row is None:
+        return fallback
+    fields = json.loads(row[0])
+    receipt = fields.get('owner_reassessment_v1')
+    if receipt is None:
+        return fallback
+    saved = conn.execute(f'SELECT receipt FROM {PENDING_TABLE} WHERE event_uid=? AND task_id=?',
+                         (row[1], receipt['task_id'])).fetchone()
+    if saved is None or json.loads(saved[0]) != receipt or receipt['park_event']['uid'] != row[1]:
+        raise ReassessmentRefused('reassessment exact capture changed')
+    return row[1]
+
+
+def bind(conn, *, op_id, task_id, event_uid):
+    """Called only for a transaction's single unambiguous status transition.
+
+    An absent journal is the legacy case. A recorded receipt cannot be silently
+    attached to a synthesized parent, another transition, or a frozen envelope.
+    Board still requires the matching live lease at actual delivery.
+    """
+    if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (PENDING_TABLE,)).fetchone():
+        return
+    saved = conn.execute(f'SELECT receipt FROM {PENDING_TABLE} WHERE task_id=? AND event_uid=?',
+                         (task_id, event_uid)).fetchone()
+    if saved is None:
+        return
+    receipt = json.loads(saved[0])
+    row = conn.execute('SELECT fields,wire_json,status_origin FROM kanban_sync_outbox '
+                       "WHERE op_id=? AND row_uid=? AND table_name='tasks' AND op='upsert'",
+                       (op_id, task_id)).fetchone()
+    if row is None or row[1] is not None or row[2] != event_uid:
+        raise ReassessmentRefused('reassessment capture is not the exact unfrozen park op')
+    fields = json.loads(row[0])
+    if fields.get('status') != 'scheduled' or receipt['park_event']['uid'] != event_uid:
+        raise ReassessmentRefused('reassessment capture does not carry the park transition')
+    if 'owner_reassessment_v1' in fields and fields['owner_reassessment_v1'] != receipt:
+        raise ReassessmentRefused('reassessment capture identity changed')
+    fields['owner_reassessment_v1'] = receipt
+    conn.execute('UPDATE kanban_sync_outbox SET fields=? WHERE op_id=? AND wire_json IS NULL',
+                 (json.dumps(fields, ensure_ascii=False, separators=(',', ':')), op_id))
diff --git a/hermes_cli/kanban_owner_target.py b/hermes_cli/kanban_owner_target.py
new file mode 100644
index 00000000000..fb3919335be
--- /dev/null
+++ b/hermes_cli/kanban_owner_target.py
@@ -0,0 +1,286 @@
+"""Read-only source-host observations, never health attestations or receipts.
+
+The local administrator owns session-repair/target-sources.json under Hermes home.
+Selectors cannot provide paths, commands or identity overrides. Queue sources require
+kind, queue_path, repository, pr, observation_path, train_path and pause_path. Update
+sources require kind, repo_path, repository (origin URL), channel, remote_ref,
+target_ref, observation_path, stamp_path and stamp_sha_key
+(commit/core_sha/full_sha/serves_sha/sha). The current producer supports main only.
+Desktop's installed Contents/Resources/install-stamp.json uses commit. A stamp
+must describe the *installed* build, not core-update state.json's prebuild offer.
+hermes-sync publishes cache/core-update/target-observation.json around its own
+successful origin fetch. A scanner or generic file touch cannot renew that fact.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import selectors
+import socket
+import stat
+import subprocess
+import time
+
+_SELECTOR = re.compile(r"owner-target:([A-Za-z0-9_.-]{1,64})/([A-Za-z0-9_.-]{1,64})\Z")
+_SHA = re.compile(r"[0-9a-f]{40}\Z")
+_LABEL = re.compile(r"[A-Za-z0-9_.-]{1,64}\Z")
+MAX_BYTES = 1024 * 1024
+MAX_AGE = 1200
+GIT_TIMEOUT = 3
+
+
+class Unavailable(ValueError):
+    """The trusted source cannot currently prove a disposition."""
+
+
+def _pairs(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise Unavailable("duplicate JSON key")
+        result[key] = value
+    return result
+
+
+def _constant(value):
+    raise Unavailable('nonfinite JSON constant')
+
+
+def _path(value):
+    if not isinstance(value, str) or not value or len(value) > 4096:
+        raise Unavailable("invalid configured path")
+    path = Path(value).expanduser()
+    if not path.is_absolute():
+        raise Unavailable("configured path must be absolute")
+    return path
+
+
+def _fresh(info, now):
+    if not stat.S_ISREG(info.st_mode) or not 0 <= now - info.st_mtime <= MAX_AGE:
+        raise Unavailable("stale, future or nonregular source")
+
+
+def _json(path, now=None, max_bytes=MAX_BYTES):
+    # Nonblocking open also prevents a misconfigured FIFO from hanging this CLI.
+    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
+    with os.fdopen(fd, "rb") as stream:
+        before = os.fstat(stream.fileno())
+        if not stat.S_ISREG(before.st_mode) or before.st_size > max_bytes:
+            raise Unavailable("not a bounded regular source")
+        if now is not None:
+            _fresh(before, now)
+        raw = stream.read(max_bytes + 1)
+        after = os.fstat(stream.fileno())
+        if len(raw) > max_bytes or (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
+            raise Unavailable("source changed or exceeded bound")
+    value = json.loads(raw, object_pairs_hook=_pairs, parse_constant=_constant)
+    if not isinstance(value, dict):
+        raise Unavailable("expected JSON object")
+    return value
+
+
+def _git(repo, *args):
+    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
+    env.update(GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL=os.devnull,
+               GIT_NO_REPLACE_OBJECTS="1", GIT_OPTIONAL_LOCKS="0",
+               GIT_NO_LAZY_FETCH="1", GIT_TERMINAL_PROMPT="0")
+    proc = subprocess.Popen(["git", "--no-pager", "-C", str(repo), *args],
+                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env)
+    assert proc.stdout is not None  # stdout=PIPE above is invariant.
+    output = bytearray()
+    deadline = time.monotonic() + GIT_TIMEOUT
+    try:
+        with selectors.DefaultSelector() as poll:
+            poll.register(proc.stdout, selectors.EVENT_READ)
+            while True:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0 or not poll.select(remaining):
+                    raise Unavailable("git timeout")
+                block = os.read(proc.stdout.fileno(), 1025 - len(output))
+                if not block:
+                    break
+                output.extend(block)
+                if len(output) > 1024:
+                    raise Unavailable("git output exceeded bound")
+        code = proc.wait(timeout=max(0.001, deadline - time.monotonic()))
+        return code, output.decode("ascii").strip()
+    finally:
+        if proc.poll() is None:
+            proc.kill()
+        try:
+            proc.wait(timeout=GIT_TIMEOUT)
+        finally:
+            proc.stdout.close()
+
+
+def _ref(repo, ref):
+    if not isinstance(ref, str) or not ref.startswith("refs/") or len(ref) > 256:
+        raise Unavailable("explicit git ref required")
+    code, _ = _git(repo, "check-ref-format", ref)
+    if code:
+        raise Unavailable("invalid git ref")
+    code, head = _git(repo, "rev-parse", "--verify", "--end-of-options", ref + "^{commit}")
+    if code or not _SHA.fullmatch(head):
+        raise Unavailable("missing full commit")
+    return head
+
+
+def _ancestry(repo, older, newer):
+    code, _ = _git(repo, "merge-base", "--is-ancestor", older, newer)
+    if code not in (0, 1):
+        raise Unavailable("ancestry unavailable")
+    return code == 0
+
+
+def _queue(config, now):
+    required = {"kind", "queue_path", "repository", "pr", "observation_path", "pause_path", "train_path"}
+    if (set(config) != required or type(config["pr"]) is not int or config["pr"] <= 0
+            or not isinstance(config["repository"], str)
+            or not re.fullmatch(r"[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}", config["repository"])):
+        raise Unavailable("invalid queue config")
+    queue = _json(_path(config["queue_path"]), now)
+    entries = queue.get("entries")
+    if not isinstance(entries, list) or not all(isinstance(e, dict) for e in entries):
+        raise Unavailable("invalid queue entries")
+    matches = [e for e in entries if type(e.get("pr")) is int and e["pr"] == config["pr"]]
+    # Historical terminal entries may coexist with the one live enqueue generation.
+    live = [e for e in matches if e.get("state") == "queued"]
+    if len(live) != 1:
+        raise Unavailable("missing or ambiguous live queue entry")
+    entry = live[0]
+    ident = entry.get("id")
+    vet = entry.get("vet")
+    if not isinstance(ident, str) or not _LABEL.fullmatch(ident) or not isinstance(vet, dict):
+        raise Unavailable("missing queue generation or vet")
+    head = vet.get("head")
+    if not isinstance(head, str) or not _SHA.fullmatch(head) or entry.get("judged_head", head) != head:
+        raise Unavailable("missing or inconsistent reviewed head")
+    revision = ident + ":" + head
+    observation = _json(_path(config["observation_path"]), now, max_bytes=4096)
+    if (set(observation) != {"version", "repository", "pr", "enqueue_generation", "head", "observed_at", "state"}
+            or type(observation["version"]) is not int or observation["version"] != 1
+            or observation["repository"] != config["repository"]
+            or type(observation["pr"]) is not int or observation["pr"] != config["pr"]
+            or observation["enqueue_generation"] != ident or observation["head"] != head
+            or observation["state"] != "current"
+            or type(observation["observed_at"]) not in (int, float)
+            or not 0 <= now - observation["observed_at"] <= MAX_AGE):
+        raise Unavailable("missing, stale or mismatched authenticated PR observation")
+    pause = _path(config["pause_path"])
+    # lstat distinguishes an absent marker from unreadability or broken symlinks.
+    try:
+        pause.lstat()
+        paused = True
+    except FileNotFoundError:
+        paused = False
+    train = _json(_path(config['train_path']), now)
+    skip = train.get('skip') or {}
+    if not isinstance(skip, dict):
+        raise Unavailable('invalid train skip state')
+    skip_until = skip.get(ident, 0)
+    if type(skip_until) not in (int, float) or not 0 <= skip_until < float('inf'):
+        raise Unavailable('invalid train skip deadline')
+    alone = any(isinstance(text,str) and re.search(
+        r'validate failed on train candidate [0-9a-f]{7,40} with this PR alone on main', text)
+        for text in (entry.get('hold_noted'), entry.get('hold_reason')))
+    adverse = (paused or queue.get("paused", False) is not False
+               or entry.get("paused", False) is not False
+               or entry.get("hold_reason") or entry.get("vet_reason")
+               or entry.get('hold_candidate') or alone or skip_until > now
+               or vet.get("state") != "ready")
+    return revision, "failed" if adverse else "pending"
+
+
+def _update(config, now):
+    required = {"kind", "repo_path", "repository", "channel", "remote_ref", "target_ref",
+                "observation_path", "stamp_path", "stamp_sha_key"}
+    if (set(config) != required or config["stamp_sha_key"] not in {"commit", "core_sha", "full_sha", "serves_sha", "sha"}
+            or config["channel"] != "main" or config["remote_ref"] != "refs/heads/main"
+            or config["target_ref"] != "refs/remotes/origin/main"
+            or not isinstance(config["repository"], str) or not config["repository"]):
+        raise Unavailable("invalid update config")
+    repo = _path(config["repo_path"])
+    fact = _json(_path(config["observation_path"]), now, max_bytes=16384)
+    if (set(fact) != {"version", "host", "repo_path", "repository", "channel", "remote_ref",
+                      "target_ref", "head", "observed_at", "state"}
+            or type(fact["version"]) is not int or fact["version"] != 1
+            or fact["host"] != socket.gethostname() or fact["repo_path"] != str(repo.resolve())
+            or any(fact[key] != config[key] for key in ("repository", "channel", "remote_ref", "target_ref"))
+            or fact["state"] != "current" or type(fact["observed_at"]) not in (int, float)
+            or not 0 <= now - fact["observed_at"] <= MAX_AGE
+            or not isinstance(fact["head"], str) or not _SHA.fullmatch(fact["head"])):
+        raise Unavailable("missing, stale or mismatched updater fetch observation")
+    code, origin = _git(repo, "remote", "get-url", "origin")
+    target = _ref(repo, config["target_ref"])
+    if code or origin != config["repository"] or target != fact["head"]:
+        raise Unavailable("updater target changed since fetch")
+    stamp = _json(_path(config["stamp_path"]))
+    installed = stamp.get(config["stamp_sha_key"])
+    if not isinstance(installed, str) or not _SHA.fullmatch(installed):
+        raise Unavailable("missing installed full SHA")
+    if _ancestry(repo, target, installed):
+        disposition = "satisfied"
+    elif _ancestry(repo, installed, target):
+        disposition = "pending"
+    else:
+        disposition = "failed"
+    final_code, final_origin = _git(repo, "remote", "get-url", "origin")
+    if (final_code or final_origin != origin
+            or _json(_path(config["stamp_path"])) != stamp
+            or _ref(repo, config["target_ref"]) != target
+            or _json(_path(config["observation_path"]), now, max_bytes=16384) != fact):
+        raise Unavailable("updater observation changed during read")
+    return target, disposition
+
+
+def observe(selector: str, *, registry_path: Path | None = None, now: float | None = None) -> dict:
+    """Observe one registered target; registry_path is a local-admin/test API only."""
+    now = time.time() if now is None else now
+    result = {"version": 1, "observed_at": now, "selector": selector,
+              "target": {"kind": "unavailable", "identity": selector, "revision": ""},
+              "disposition": "unavailable"}
+    try:
+        match = _SELECTOR.fullmatch(selector)
+        if not match:
+            raise Unavailable("invalid selector")
+        if registry_path is None:
+            from hermes_constants import get_hermes_home
+            registry_path = get_hermes_home() / "session-repair" / "target-sources.json"
+        registry = _json(registry_path)
+        if (set(registry) != {"version", "authority", "sources"}
+                or type(registry["version"]) is not int or registry["version"] != 1
+                or registry["authority"] != match[1] or not isinstance(registry["sources"], dict)):
+            raise Unavailable("registry authority/schema mismatch")
+        config = registry["sources"].get(match[2])
+        if not isinstance(config, dict) or config.get("kind") not in {"queue", "update"}:
+            raise Unavailable("unknown source")
+        # Bind actual host and configured component/channel/paths into the target
+        # identity. Reusing a registry key for another scope must invalidate old
+        # receipts even when both sources happen to offer the same commit.
+        scope = json.dumps([socket.gethostname(), config], sort_keys=True, separators=(',', ':'), allow_nan=False)
+        result['target']['identity'] = selector + '@' + hashlib.sha256(scope.encode()).hexdigest()
+        result["target"]["kind"] = config["kind"]
+        reader = _queue if config["kind"] == "queue" else _update
+        revision, disposition = reader(config, now)
+        result["target"]["revision"] = revision
+        result["disposition"] = disposition
+    except (OSError, ValueError, TypeError, RecursionError, subprocess.SubprocessError):
+        pass  # No source details/paths or arbitrary exception text cross the boundary.
+    return result
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("action", choices=["observe"])
+    parser.add_argument("--selector", required=True)
+    args = parser.parse_args(argv)
+    print(json.dumps(observe(args.selector), allow_nan=False, separators=(",", ":")))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
