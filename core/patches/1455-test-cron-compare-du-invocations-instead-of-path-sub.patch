From bd35125c9554e5e41d81cf43f5629e1a3dd35a2c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 19:36:00 +0000
Subject: [PATCH] test(cron): compare du invocations instead of path substrings
 [daveey] (#454)

---
 tests/cron/test_worktree_maintenance_once_per_repo.py | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/tests/cron/test_worktree_maintenance_once_per_repo.py b/tests/cron/test_worktree_maintenance_once_per_repo.py
index 96c4804005b..5adc9a56837 100644
--- a/tests/cron/test_worktree_maintenance_once_per_repo.py
+++ b/tests/cron/test_worktree_maintenance_once_per_repo.py
@@ -83,7 +83,8 @@ def test_footprint_warning_sizes_the_tree_only_when_the_count_does_not_decide(
     crowded = _git_repo(tmp_path / "crowded")
     for i in range(10):
         (crowded / ".worktrees" / f"lane-{i}").mkdir()
-    sparse = _git_repo(tmp_path / "sparse")
+    # A path can contain the du flag text (including in CI's random temp prefix).
+    sparse = _git_repo(tmp_path / "sparse -sm tree")
     for i in range(2):
         (sparse / ".worktrees" / f"lane-{i}").mkdir()
 
@@ -94,5 +95,5 @@ def test_footprint_warning_sizes_the_tree_only_when_the_count_does_not_decide(
 
         caplog.clear()
         worktree_ops._warn_worktree_footprint(str(sparse))
-    assert du_log.read_text().count("-sm") == 1
+    assert du_log.read_text().splitlines() == [f"-sm {sparse / '.worktrees'}"]
     assert "holds 2 tree(s) (5.9GB)" in caplog.text
-- 
