From c4a4fcc624a318ce47e2ff2e1daaca1a68ad6bfc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 10:37:01 +0000
Subject: [PATCH] test(kanban): retain spend and PR hold semantics under class
 admission [daveey]

---
 tests/hermes_cli/test_kanban_park_invariants.py   | 8 ++++++++
 tests/hermes_cli/test_kanban_spend_budget.py      | 7 +++++++
 tests/hermes_cli/test_kanban_stuck_clock_holds.py | 5 +++++
 3 files changed, 20 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_park_invariants.py b/tests/hermes_cli/test_kanban_park_invariants.py
index 20c3b1ed17..a2af4619d6 100644
--- a/tests/hermes_cli/test_kanban_park_invariants.py
+++ b/tests/hermes_cli/test_kanban_park_invariants.py
@@ -28,6 +28,14 @@ def kanban_home(tmp_path, monkeypatch):
     home.mkdir()
     monkeypatch.setenv("HERMES_HOME", str(home))
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    from hermes_cli.kanban_model_assignment import _assignee_config
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    assert _assignee_config("a") is None
+    profile = home / "profiles" / "a"
+    profile.mkdir(parents=True)
+    (profile / "config.yaml").write_text(_managed_yaml())
+    config = _assignee_config("a")
+    assert config is not None and config["model_routing"]["enabled"]
     for key in ("HERMES_KANBAN_TASK", "HERMES_KANBAN_DB", "HERMES_KANBAN_BOARD",
                 "HERMES_KANBAN_WORKSPACES_ROOT", "HERMES_DELEGATED_CHILD_CONTEXT"):
         monkeypatch.delenv(key, raising=False)
diff --git a/tests/hermes_cli/test_kanban_spend_budget.py b/tests/hermes_cli/test_kanban_spend_budget.py
index 729183e673..b06af0d268 100644
--- a/tests/hermes_cli/test_kanban_spend_budget.py
+++ b/tests/hermes_cli/test_kanban_spend_budget.py
@@ -36,6 +36,13 @@ def kanban_home(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
                 "HERMES_KANBAN_RUN_ID"):
         monkeypatch.delenv(var, raising=False)
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    from hermes_cli.kanban_model_assignment import _assignee_config
+    from hermes_cli.kanban_model_tier import class_unroutable_reason
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    assert class_unroutable_reason("class:standard", _assignee_config("default")) == "routing_disabled"
+    (home / "config.yaml").write_text(_managed_yaml())
+    config = _assignee_config("default")
+    assert config is not None and config["model_routing"]["enabled"]
     monkeypatch.setattr(kwc, "run_due_wake_checks", lambda conn, *a, **k: [])
     monkeypatch.setattr(kcr, "maybe_refresh_async", lambda *a, **k: None)
     monkeypatch.setattr(ksb, "limits", lambda cfg=None: LIMITS)
diff --git a/tests/hermes_cli/test_kanban_stuck_clock_holds.py b/tests/hermes_cli/test_kanban_stuck_clock_holds.py
index 750ad0c460..fd0f17fe7b 100644
--- a/tests/hermes_cli/test_kanban_stuck_clock_holds.py
+++ b/tests/hermes_cli/test_kanban_stuck_clock_holds.py
@@ -41,6 +41,11 @@ def home(tmp_path, monkeypatch):
     monkeypatch.delenv("HERMES_KANBAN_DB", raising=False)
     monkeypatch.delenv("HERMES_KANBAN_BOARD", raising=False)
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    from hermes_cli.kanban_model_assignment import _assignee_config
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    (home / "config.yaml").write_text(_managed_yaml())
+    config = _assignee_config("default")
+    assert config is not None and config["model_routing"]["enabled"]
     monkeypatch.setattr("hermes_cli.profiles.list_profiles", lambda **kw: [SimpleNamespace(name="default")])
     monkeypatch.setattr(kbd, "_profile_exists_fn", lambda: lambda name: name == "default")
     monkeypatch.setattr(kbd, "review_dispatch_enabled", lambda: False)
-- 
2.43.0

