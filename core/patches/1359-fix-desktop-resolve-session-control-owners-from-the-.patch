 import { JsonRpcGatewayError } from '@hermes/shared'
 import { atom } from 'nanostores'
 
+import { $connectionsRegistry } from './connection-registry-state'
 import { $gateway } from './gateway'
 import { refreshSessionGoal } from './goals'
