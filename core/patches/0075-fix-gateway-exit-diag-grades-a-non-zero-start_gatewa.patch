From 00bf01956e7334633ecc1a4d131a4da637633048 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 14 Oct 2026 19:16:35 -0700
Subject: [PATCH] fix(gateway): exit-diag grades a non-zero start_gateway
 return as warning

A SIGTERM stop (launchctl bootout / systemctl stop) returns False from start_gateway too, so
gateway.exit_nonzero is routine on every service stop; only an escaped exception or a failing
SystemExit code is an error.

Burndown: hermes-gateway-mini
Fixes BB-59

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/gateway_exit_diag.py            | 10 ++++++----
 tests/hermes_cli/test_gateway_exit_diag.py |  2 +-
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/gateway_exit_diag.py b/hermes_cli/gateway_exit_diag.py
index 1acf7d230e..203b14cb64 100644
--- a/hermes_cli/gateway_exit_diag.py
+++ b/hermes_cli/gateway_exit_diag.py
@@ -2,7 +2,7 @@
 
 Each record carries a ``level`` so log shippers grade it by intent rather than by its words: a
 supervised restart (exit 75 back to launchd/systemd after a SIGUSR1 drain, ``hermes update`` or
-``/restart``) is routine, while a crash or a non-zero exit is an error.
+``/restart``) is routine, a non-zero return a warning, and a crash or failing exit code an error.
 """
 
 from __future__ import annotations
@@ -13,12 +13,14 @@ import os
 import sys
 from datetime import UTC, datetime
 
-_ERROR_TAGS = frozenset({"asyncio.run.exception", "gateway.exit_nonzero"})
+# start_gateway() also returns False for a SIGTERM stop (launchctl bootout, systemctl stop), so a
+# non-zero return is a warning; only an escaped exception or a failing SystemExit is an error.
+_TAG_LEVELS = {"asyncio.run.exception": "error", "gateway.exit_nonzero": "warning"}
 
 
 def _record_level(tag: str, extra: dict[str, object]) -> str:
-    if tag in _ERROR_TAGS:
-        return "error"
+    if tag in _TAG_LEVELS:
+        return _TAG_LEVELS[tag]
     if tag == "asyncio.run.SystemExit":
         from gateway.restart import GATEWAY_SERVICE_RESTART_EXIT_CODE
         return "info" if extra.get("code") in (None, 0, GATEWAY_SERVICE_RESTART_EXIT_CODE) else "error"
diff --git a/tests/hermes_cli/test_gateway_exit_diag.py b/tests/hermes_cli/test_gateway_exit_diag.py
index 2ca53130b1..98da21b6a7 100644
--- a/tests/hermes_cli/test_gateway_exit_diag.py
+++ b/tests/hermes_cli/test_gateway_exit_diag.py
@@ -41,7 +41,7 @@ def test_failing_system_exit_is_error(code):
         ("asyncio.run.returned", "info"),
         ("gateway.exit_clean", "info"),
         ("atexit.hook", "info"),
-        ("gateway.exit_nonzero", "error"),
+        ("gateway.exit_nonzero", "warning"),
         ("asyncio.run.exception", "error"),
     ],
 )
