Subject: [PATCH] fix(ci): provision isolated native test tools and messaging
 [daveey]

---
 .github/workflows/macos-os-tests.yml          |  9 +++++++++
 tests/ci/test_macos_os_tests_workflow.py      | 14 ++++++++++++++
 tests/hermes_cli/test_kanban_pr_acceptance.py |  4 ++++
 tests/hermes_cli/test_kanban_pr_transport.py  |  1 +
 tests/tools/test_browser_launcher.py          | 18 +++++++++++++++---
 5 files changed, 43 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/macos-os-tests.yml b/.github/workflows/macos-os-tests.yml
index 6f9a4c4204..379ec89068 100644
--- a/.github/workflows/macos-os-tests.yml
+++ b/.github/workflows/macos-os-tests.yml
@@ -79,6 +79,15 @@ jobs:
         with:
           fetch-depth: 1
 
+      - name: Set up isolated locked test tools and dependencies
+        uses: ./.github/actions/setup-pm
+        with:
+          # Real uv, Node and npm must live outside the runner's protected home.
+          toolchain: all
+          test-environment: 'true'
+          # `all` intentionally excludes messaging; platform tests need its SDKs.
+          extras: '["all", "messaging"]'
+
       - name: Run macOS-marked tests
         # Same selection as tests-os.yml's macOS row: the helper narrows which
         # files are imported; `-m "platforms and not integration"` decides which
diff --git a/tests/ci/test_macos_os_tests_workflow.py b/tests/ci/test_macos_os_tests_workflow.py
index b2f57a01ef..d06059ebad 100644
--- a/tests/ci/test_macos_os_tests_workflow.py
+++ b/tests/ci/test_macos_os_tests_workflow.py
@@ -62,6 +62,20 @@ def test_test_job_waits_for_the_gate_and_runs_the_marked_selection_on_the_mini()
     assert '-m "platforms and not integration"' in command
 
 
+def test_native_lane_provisions_real_tools_and_messaging_before_tests():
+    import json
+
+    steps = _workflow()["jobs"]["macos-os-tests"]["steps"]
+    setup_index = next(i for i, step in enumerate(steps)
+                       if step.get("uses") == "./.github/actions/setup-pm")
+    options = steps[setup_index]["with"]
+    assert options["toolchain"] == "all"  # includes real uv, Node and paired npm
+    assert options["test-environment"] == "true"
+    assert {"all", "messaging"} <= set(json.loads(options["extras"]))
+    assert setup_index < next(i for i, step in enumerate(steps)
+                              if "scripts/run_tests.sh" in step.get("run", ""))
+
+
 def _api(runs: dict[str, list[dict]], jobs: dict[int, list[dict]], calls: list[str] | None = None):
     def api(path: str):
         if calls is not None:
