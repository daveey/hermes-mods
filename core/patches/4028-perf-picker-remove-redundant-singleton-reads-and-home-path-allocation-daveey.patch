diff --git a/tests/agent/test_pool_singleton_lazy_read.py b/tests/agent/test_pool_singleton_lazy_read.py
new file mode 100644
index 0000000000..4061320ba4
--- /dev/null
+++ b/tests/agent/test_pool_singleton_lazy_read.py
@@ -0,0 +1,33 @@
+"""Singleton dispatch must not load auth.json when the selected seeder does not use it."""
+import pytest
+
+from agent import credential_pool as cp
+
+
+@pytest.mark.parametrize('provider,seeder', [
+    ('openrouter', '_seed_profile_singleton'),
+    ('anthropic', '_seed_anthropic_singletons'),
+    ('qwen-oauth', '_seed_qwen_singleton'),
+    ('minimax-oauth', '_seed_minimax_singleton'),
+])
+def test_dispatch_does_not_read_unused_auth(monkeypatch, provider, seeder):
+    calls = []
+    monkeypatch.setattr(cp, seeder, lambda seed: calls.append(seed.provider))
+    def unexpected():
+        pytest.fail('dispatch read an auth store its seeder does not consume')
+    monkeypatch.setattr(cp, '_load_auth_store', unexpected)
+    assert cp._seed_from_singletons(provider, []) == (False, set())
+    assert calls == [provider]
+
+
+@pytest.mark.parametrize('provider,seeder', [('nous', '_seed_nous_singleton'), ('openai-codex', '_seed_tokens_singleton')])
+def test_dispatch_reads_current_auth_for_consumers(monkeypatch, provider, seeder):
+    state = {'generation': 1}
+    seen = []
+    monkeypatch.setattr(cp, '_is_source_suppressed_fn', lambda: lambda *args: False)
+    monkeypatch.setattr(cp, '_load_auth_store', lambda: dict(state))
+    monkeypatch.setattr(cp, seeder, lambda seed, store: seen.append(store))
+    cp._seed_from_singletons(provider, [])
+    state['generation'] = 2
+    cp._seed_from_singletons(provider, [])
+    assert seen == [{'generation': 1}, {'generation': 2}]
diff --git a/tests/test_home_key_fast_hit.py b/tests/test_home_key_fast_hit.py
new file mode 100644
index 0000000000..5b399f0509
--- /dev/null
+++ b/tests/test_home_key_fast_hit.py
@@ -0,0 +1,12 @@
+"""A warm home key need not allocate/reparse another Path."""
+import hermes_constants as hc
+
+
+def test_warm_key_uses_input_string_without_reconstructing_path(monkeypatch, tmp_path):
+    hc.reset_hermes_home_key_cache()
+    key = hc.hermes_home_key(tmp_path)
+    def unexpected(*args):
+        raise AssertionError('a warm key reconstructed a Path')
+    monkeypatch.setattr(hc, 'Path', unexpected)
+    assert hc.hermes_home_key(tmp_path) == key
+    assert hc.hermes_home_key(str(tmp_path)) == key
diff --git a/tests/test_home_path_construction.py b/tests/test_home_path_construction.py
new file mode 100644
index 0000000000..3b52dcf1c3
--- /dev/null
+++ b/tests/test_home_path_construction.py
@@ -0,0 +1,47 @@
+"""Only immutable Path construction is memoized; home selection/expansion remains live."""
+from pathlib import Path
+
+import hermes_constants as hc
+
+
+def test_reuses_expanded_path_without_freezing_environment(monkeypatch, tmp_path):
+    monkeypatch.setenv('PICKER_HOME_ROOT', str(tmp_path / 'one'))
+    first = hc._expand_hermes_home('$PICKER_HOME_ROOT/profile')
+    assert hc._expand_hermes_home('$PICKER_HOME_ROOT/profile') is first
+    monkeypatch.setenv('PICKER_HOME_ROOT', str(tmp_path / 'two'))
+    assert hc._expand_hermes_home('$PICKER_HOME_ROOT/profile') == tmp_path / 'two/profile'
+    assert hc._expand_hermes_home('$PICKER_HOME_ROOT/profile') is not first
+
+
+def test_tilde_expansion_is_live(monkeypatch, tmp_path):
+    monkeypatch.setenv('HOME', str(tmp_path / 'first'))
+    monkeypatch.setenv('USERPROFILE', str(tmp_path / 'first'))
+    assert hc._expand_hermes_home('~/profile') == tmp_path / 'first/profile'
+    monkeypatch.setenv('HOME', str(tmp_path / 'second'))
+    monkeypatch.setenv('USERPROFILE', str(tmp_path / 'second'))
+    assert hc._expand_hermes_home('~/profile') == tmp_path / 'second/profile'
+
+
+def test_process_and_nested_context_home_changes_are_immediate(monkeypatch, tmp_path):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path / 'process'))
+    assert hc.get_hermes_home() == tmp_path / 'process'
+    token = hc.set_hermes_home_override(tmp_path / 'outer')
+    try:
+        assert hc.get_hermes_home() == tmp_path / 'outer'
+        nested = hc.set_hermes_home_override(tmp_path / 'inner')
+        try:
+            assert hc.get_hermes_home() == tmp_path / 'inner'
+        finally:
+            hc.reset_hermes_home_override(nested)
+        assert hc.get_hermes_home() == tmp_path / 'outer'
+    finally:
+        hc.reset_hermes_home_override(token)
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path / 'next'))
+    assert hc.get_hermes_home() == tmp_path / 'next'
+
+
+def test_relative_path_does_not_freeze_working_directory(monkeypatch, tmp_path):
+    relative = hc._expand_hermes_home('relative-home')
+    monkeypatch.chdir(tmp_path)
+    assert relative.resolve() == tmp_path / 'relative-home'
+    assert relative == Path('relative-home')
