+    async def stubborn():
+        park = asyncio.Event()
+        loop = asyncio.get_running_loop()
+        wake.append(lambda: loop.call_soon_threadsafe(park.set))
+        entered.set()
+        while not park.is_set():
+            try:
+                await park.wait()
+            except asyncio.CancelledError:
