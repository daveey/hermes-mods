+    assert_supported(probe, core, code_attestation.BACKUP_STUB_HEAD_DIGEST)
+    assert code_attestation.BACKUP_STUB_HEAD_DIGEST != code_attestation.CURRENT_TEMPLATE_HEAD_DIGEST
+
