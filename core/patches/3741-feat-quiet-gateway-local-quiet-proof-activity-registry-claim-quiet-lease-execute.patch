+def test_a_replaced_parent_directory_is_detected_by_both_sides(home):
+    clock = FakeClock()
+    owner = cq.acquire(max_s=60, reason="r", clock=clock)
+    paths = cq.quiet_paths()
+    kanban = paths.directory.parent
+    kanban.rename(home / "kanban-old")
