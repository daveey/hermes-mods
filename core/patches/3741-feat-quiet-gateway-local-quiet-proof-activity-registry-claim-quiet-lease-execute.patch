+    # -- measurement -------------------------------------------------------------------------
+
+    def _measure(self, episode_id: str, phase: str, *, full: bool = True) -> dict[str, Any]:
+        """One snapshot: reads outside the registry lock, epoch/generation checked before and after."""
+        registry = self._registry()
+        reasons: list[str] = []
+        if registry is None:
