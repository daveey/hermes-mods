+    return _installed
+
+
+def route_report():
+    return _ledger().route_report()
+
+
+def trusted_bootstrap_seed():
+    return _ledger().trusted_bootstrap_seed()
+
+
+def _ledger():
+    if _installed is None:
+        raise RuntimeError("code attestation not installed")
+    return _installed
+
+
