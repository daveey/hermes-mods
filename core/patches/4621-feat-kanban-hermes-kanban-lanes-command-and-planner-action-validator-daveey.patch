diff --git a/hermes_cli/kanban_lanes_cli.py b/hermes_cli/kanban_lanes_cli.py
new file mode 100644
index 0000000000000000000000000000000000000000..bd18caff06587655e9f4c059903993b81d644846
--- /dev/null
+++ b/hermes_cli/kanban_lanes_cli.py
@@ -0,0 +1,205 @@
+"""``hermes kanban lanes``: see and steer the split of worker time between project lanes. [daveey]
+
+``show`` (the default) prints target against actual share and what is backed up per lane; ``held`` and
+``unclassified`` list the cards a planner decides about; ``assign``, ``admit``, ``pin`` and ``set`` are the user's
+controls; ``apply`` runs a planner's action list through ``kanban_lanes_plan.apply``.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_lanes as lanes
+from hermes_cli.kanban_output import _json_out
+
+
+def _fleet(conn, local: bool):
+    """The connection the report reads: the board's full replica when there is one (fleet-wide), else ``conn``."""
+    if local:
+        return None
+    from hermes_cli import kanban_worker_node as wn
+
+    try:
+        return wn.open_replica(conn)
+    except RuntimeError:
+        return None
+
+
+def snapshot(conn, *, hours: float, local: bool = False) -> dict:
+    from hermes_cli import kanban_lanes_plan as plan
+
+    pol = lanes.policy()
+    if pol is None:
+        return {"configured": False}
+    replica = _fleet(conn, local)
+    try:
+        rows = lanes.usage(replica or conn, pol, window_s=int(hours * 3600))
+    finally:
+        if replica is not None:
+            replica.close()
+    for name, lane in pol.lanes.items():
+        rows[name]["describe"] = lane.describe
+    return {"configured": True, "window_hours": hours, "scope": "fleet" if replica is not None else "local",
+            "default": pol.default, "agent_priority_cap": pol.priority_cap, "lanes": rows,
+            "planner": plan.read_notes()}
+
+
+def _pct(value: float) -> str:
+    return f"{round(value * 100):3d}%"
+
+
+def render(snap: dict) -> str:
+    if not snap["configured"]:
+        return "no lanes configured (kanban.admission.lanes)"
+    lines = [f"lanes over the last {snap['window_hours']:g} h ({snap['scope']})",
+             f"{'lane':12} {'target':>6} {'actual':>6} {'run-h':>7} {'running':>7} {'ready':>5} {'held':>5} "
+             f"{'open':>5}  notes"]
+    for name, row in snap["lanes"].items():
+        notes = []
+        if row["paused"]:
+            notes.append("paused")
+        if row["gated"]:
+            budget = "no limit" if row["admit_per_day"] is None else f"{row['admitted_today']}/{row['admit_per_day']}"
+            notes.append(f"gated, admitted today {budget}")
+        if row["ready"] == 0 and row["target"] > row["actual"]:
+            notes.append("under target: nothing ready")
+        lines.append(f"{name:12} {_pct(row['target']):>6} {_pct(row['actual']):>6} "
+                     f"{row['run_seconds'] / 3600:7.1f} {row['running']:7d} {row['ready']:5d} {row['held']:5d} "
+                     f"{row['open']:5d}  {'; '.join(notes)}")
+    return "\n".join(lines)
+
+
+def _show(args) -> int:
+    with kbc.connect_closing() as conn:
+        snap = snapshot(conn, hours=args.hours, local=args.local)
+    if not _json_out(args, snap):
+        print(render(snap))
+    return 0
+
+
+def _cards(args, rows) -> int:
+    data = [{"id": r["id"], "title": r["title"], "lane": r["tenant"], "priority": r["priority"],
+             "created_at": r["created_at"], "created_by": r["created_by"]} for r in rows]
+    if not _json_out(args, data):
+        print("\n".join(f"{c['id']}  [{c['lane']}]  {c['title']}" for c in data) or "none")
+    return 0
+
+
+def _held(args) -> int:
+    with kbc.connect_closing() as conn:
+        return _cards(args, lanes.held(conn, args.lane)[:args.limit])
+
+
+def _unclassified(args) -> int:
+    with kbc.connect_closing() as conn:
+        rows = conn.execute(
+            "SELECT t.id, t.title, t.tenant, t.priority, t.created_at, t.created_by FROM tasks t "
+            "WHERE t.status NOT IN ('done', 'archived') AND ? = (SELECT json_extract(e.payload, '$.source') "
+            "FROM task_events e WHERE e.task_id = t.id AND e.kind = ? ORDER BY e.id DESC LIMIT 1) "
+            "ORDER BY t.created_at LIMIT ?", ("unclassified", lanes.ASSIGNED, args.limit)).fetchall()
+        return _cards(args, rows)
+
+
+def _assign(args) -> int:
+    with kbc.connect_closing() as conn:
+        lanes.assign(conn, args.task_id, args.lane, source=args.source, reason=args.reason or "")
+    print(f"{args.task_id}: lane {args.lane}")
+    return 0
+
+
+def _admit(args) -> int:
+    from hermes_cli.kanban_cli_actor import cli_actor
+
+    with kbc.connect_closing() as conn:
+        done = lanes.admit(conn, args.task_id, actor=cli_actor(), reason=args.reason or "")
+    print(f"{args.task_id}: {'admitted' if done else 'not held at a lane gate'}")
+    return 0 if done else 1
+
+
+def _pin(args) -> int:
+    from hermes_cli import kanban_lanes_plan as plan
+    from hermes_cli.kanban_cli_actor import cli_actor
+
+    with kbc.connect_closing() as conn:
+        plan.set_pin(conn, args.task_id, not args.off, actor=cli_actor())
+    print(f"{args.task_id}: {'unpinned' if args.off else 'pinned'}")
+    return 0
+
+
+def _set(args) -> int:
+    from hermes_cli.config import set_config_value
+
+    pol = lanes.policy()
+    if pol is None or args.lane not in pol.lanes:
+        print(f"unknown lane: {args.lane}", file=sys.stderr)
+        return 2
+    changes = {"share": args.share, "admit_per_day": args.admit_per_day,
+               "paused": True if args.pause else False if args.resume else None}
+    changes = {key: value for key, value in changes.items() if value is not None}
+    if not changes:
+        print("nothing to set: give --share, --admit-per-day, --pause or --resume", file=sys.stderr)
+        return 2
+    for key, value in changes.items():
+        set_config_value(f"kanban.admission.lanes.{args.lane}.{key}", str(value).lower())
+    lanes.policy()  # a write that left the mapping malformed fails here, loudly
+    return 0
+
+
+def _apply(args) -> int:
+    from hermes_cli import kanban_lanes_plan as plan
+
+    raw = sys.stdin.read() if args.file == "-" else open(args.file, encoding="utf-8").read()
+    with kbc.connect_closing() as conn:
+        result = plan.apply(conn, json.loads(raw), dry_run=args.dry_run)
+    if not args.dry_run:
+        plan.save_notes(result)
+    if not _json_out(args, result):
+        print(f"applied {len(result['applied'])}, rejected {len(result['rejected'])}, "
+              f"notes {len(result['notes'])}")
+        for item in result["rejected"]:
+            print(f"  rejected: {item['why']}: {json.dumps(item['action'])[:160]}")
+    return 0
+
+
+def _explain(args) -> int:
+    from hermes_cli import kanban_lanes_plan as plan
+
+    with kbc.connect_closing() as conn:
+        pol = lanes.policy()
+        row = conn.execute("SELECT id, title, tenant, status, block_kind FROM tasks WHERE id = ?",
+                           (args.task_id,)).fetchone()
+        if pol is None or row is None:
+            print("no lanes configured" if pol is None else f"no such task: {args.task_id}")
+            return 1
+        lane = pol.lanes[pol.lane_of(row["tenant"])]
+        load = lanes._running(conn, pol)
+        data = {"id": row["id"], "lane": lane.name, "source": plan.lane_source(conn, row["id"]),
+                "status": row["status"], "held_at_gate": row["block_kind"] == lanes.GATE_KIND,
+                "paused": lane.paused, "pinned": plan.pinned(conn, row["id"]),
+                "running_per_share": {name: (round(load[name] / spec.share, 3) if spec.share else None)
+                                      for name, spec in pol.lanes.items()}}
+    if not _json_out(args, data):
+        state = ("held at the lane gate until admitted" if data["held_at_gate"] else
+                 "lane is paused" if lane.paused else f"status {row['status']}")
+        ratios = ", ".join(f"{name} {'-' if value is None else value}"
+                           for name, value in data["running_per_share"].items())
+        print(f"{row['id']}: lane {lane.name} (source {data['source'] or 'none'}); {state}\n"
+              f"next free slot goes to the lowest running/share with ready work: {ratios}")
+    return 0
+
+
+_ACTIONS = {None: _show, "show": _show, "held": _held, "unclassified": _unclassified, "assign": _assign,
+            "admit": _admit, "pin": _pin, "set": _set, "apply": _apply, "explain": _explain}
+
+
+def command(args: argparse.Namespace) -> int:
+    action = getattr(args, "lanes_action", None)
+    if action is None:
+        args.hours, args.local = 6.0, False
+    try:
+        return _ACTIONS[action](args)
+    except ValueError as exc:
+        print(f"lanes: {exc}", file=sys.stderr)
+        return 2
diff --git a/hermes_cli/kanban_lanes_plan.py b/hermes_cli/kanban_lanes_plan.py
new file mode 100644
index 0000000000000000000000000000000000000000..bcdb9c01951abb9bbb7d394acac7aa72d76f5baa
--- /dev/null
+++ b/hermes_cli/kanban_lanes_plan.py
@@ -0,0 +1,194 @@
+"""Validate and apply a lane planner's action list. [daveey]
+
+The planner is an LLM run (a cron job or a chat) that reads ``hermes kanban lanes show --json`` and proposes actions;
+nothing it says is trusted. :func:`apply` is the only writer: it applies the actions below within fixed limits and
+refuses everything else, one refusal per action, so a bad plan degrades to its valid part.
+
+==============  ==================================================================================
+``admit``       a gate-held card to ready, at most the lane's ``admit_per_day`` per local day, never a
+                title matching the lane's ``never_admit``
+``merge``       a gate-held card into an open card of the same lane: a link and a comment; the merged
+                card stays held and is never archived
+``reprioritize``  0..1000, never a pinned card
+``relane``      only a card whose lane came from ``inherited``, ``unclassified`` or ``llm``
+``note``        one line per lane, kept for the panel
+==============  ==================================================================================
+"""
+from __future__ import annotations
+
+import json
+import time
+from pathlib import Path
+from typing import Optional
+
+from hermes_cli import kanban_lanes as lanes
+
+PINNED, UNPINNED, MERGED = "lane_pinned", "lane_unpinned", "lane_merged"
+MAX_ACTIONS = 50
+ACTOR = "lane-planner"
+_MOVABLE = ("inherited", "unclassified", "llm")
+_OPEN = ("triage", "todo", "scheduled", "ready", "running", "blocked", "review")
+
+
+def notes_path() -> Path:
+    from hermes_constants import get_default_hermes_root
+
+    return Path(get_default_hermes_root()) / "kanban" / "lanes-planner.json"
+
+
+def pinned(conn, task_id: str) -> bool:
+    row = conn.execute(
+        "SELECT kind FROM task_events WHERE task_id = ? AND kind IN (?, ?) ORDER BY id DESC LIMIT 1",
+        (task_id, PINNED, UNPINNED)).fetchone()
+    return row is not None and row[0] == PINNED
+
+
+def set_pin(conn, task_id: str, on: bool, *, actor: str) -> None:
+    from hermes_cli import kanban_db as kb
+
+    with kb.write_txn(conn):
+        if kb._task_status(conn, task_id) is None:
+            raise ValueError(f"no such task: {task_id}")
+        kb._append_event(conn, task_id, PINNED if on else UNPINNED, {"actor": actor})
+
+
+def lane_source(conn, task_id: str) -> Optional[str]:
+    row = conn.execute("SELECT payload FROM task_events WHERE task_id = ? AND kind = ? ORDER BY id DESC LIMIT 1",
+                       (task_id, lanes.ASSIGNED)).fetchone()
+    return None if row is None else json.loads(row[0] or "{}").get("source")
+
+
+def _card(conn, task_id):
+    if not isinstance(task_id, str):
+        return None
+    return conn.execute("SELECT id, title, tenant, status, block_kind, priority FROM tasks WHERE id = ?",
+                        (task_id,)).fetchone()
+
+
+def _held(row) -> bool:
+    return row["status"] == "triage" and row["block_kind"] == lanes.GATE_KIND
+
+
+def _admit(conn, pol, action, row, state) -> Optional[str]:
+    if not _held(row):
+        return "card is not held at a lane gate"
+    lane = pol.lanes[pol.lane_of(row["tenant"])]
+    if any(p.search(row["title"] or "") for p in lane.never_admit):
+        return f"lane {lane.name} never auto-admits this kind of card"
+    used = state.setdefault(lane.name, lanes.admitted_today(conn, lane.name, now=state["now"]))
+    if lane.admit_per_day is not None and used >= lane.admit_per_day:
+        return f"lane {lane.name} admit budget spent ({used}/{lane.admit_per_day} today)"
+    lanes.admit(conn, row["id"], actor=ACTOR, reason=action["reason"])
+    state[lane.name] = used + 1
+    return None
+
+
+def _merge(conn, pol, action, row, _state) -> Optional[str]:
+    from hermes_cli import kanban_db as kb
+
+    target = _card(conn, action.get("into"))
+    if not _held(row):
+        return "only a gate-held card can be merged"
+    if target is None or target["id"] == row["id"] or target["status"] not in _OPEN:
+        return "merge target must be another open card"
+    if pol.lane_of(target["tenant"]) != pol.lane_of(row["tenant"]):
+        return "merge target is in another lane"
+    with kb.write_txn(conn):
+        kb.link_tasks(conn, target["id"], row["id"], allow_nested=True)
+        kb._append_event(conn, row["id"], MERGED, {"into": target["id"], "reason": action["reason"]})
+    kb.add_comment(conn, target["id"], ACTOR, f"Also covers {row['id']} ({row['title']}): {action['reason']}",
+                   system=True)
+    return None
+
+
+def _reprioritize(conn, _pol, action, row, _state) -> Optional[str]:
+    from hermes_cli import kanban_db as kb
+
+    value = action.get("priority")
+    if type(value) is not int or not 0 <= value <= 1000:
+        return "priority must be an integer from 0 to 1000"
+    if row["status"] not in _OPEN:
+        return "card is not open"
+    if pinned(conn, row["id"]):
+        return "card is pinned"
+    kb.edit_task(conn, row["id"], priority=value, priority_reason=f"{ACTOR}: {action['reason']}")
+    return None
+
+
+def _relane(conn, pol, action, row, _state) -> Optional[str]:
+    lane = action.get("lane")
+    if lane not in pol.lanes:
+        return f"unknown lane: {lane}"
+    if lane_source(conn, row["id"]) not in _MOVABLE:
+        return "lane was given or set by a rule; only the user moves it"
+    if _held(row) or pol.lanes[lane].gated:
+        return "a move into or out of a gated lane is the user's"
+    lanes.assign(conn, row["id"], lane, source="llm", reason=action["reason"], pol=pol)
+    return None
+
+
+_HANDLERS = {"admit": _admit, "merge": _merge, "reprioritize": _reprioritize, "relane": _relane}
+
+
+def apply(conn, actions, *, now: Optional[float] = None, dry_run: bool = False) -> dict:
+    """Apply a planner's ``actions``; returns ``{"applied": [...], "rejected": [{..., "why"}], "notes": [...]}``.
+
+    ``dry_run`` validates the shape only (budget and card checks need the writes of earlier actions).
+    """
+    pol = lanes.policy()
+    if pol is None:
+        raise ValueError("no lanes are configured (kanban.admission.lanes)")
+    if not isinstance(actions, list):
+        raise ValueError("actions must be a list")
+    out: dict = {"applied": [], "rejected": [], "notes": []}
+    state: dict = {"now": time.time() if now is None else now}
+    for index, action in enumerate(actions):
+        why = _refusal(conn, pol, action, index, state, out, dry_run)
+        if why:
+            out["rejected"].append({"action": action, "why": why})
+    return out
+
+
+def _refusal(conn, pol, action, index, state, out, dry_run) -> Optional[str]:
+    if index >= MAX_ACTIONS:
+        return f"over the {MAX_ACTIONS}-action limit for one plan"
+    if not isinstance(action, dict):
+        return "an action must be an object"
+    kind = action.get("action")
+    reason = action.get("reason")
+    if kind == "note":
+        if action.get("lane") not in pol.lanes or not isinstance(action.get("text"), str):
+            return "a note names a configured lane and carries text"
+        out["notes"].append({"lane": action["lane"], "text": action["text"][:300]})
+        return None
+    if kind not in _HANDLERS:
+        return f"unknown action: {kind}"
+    if not isinstance(reason, str) or not reason.strip():
+        return "a one-line reason is required"
+    row = _card(conn, action.get("card"))
+    if row is None:
+        return "no such card"
+    if not dry_run:
+        why = _HANDLERS[kind](conn, pol, action, row, state)
+        if why:
+            return why
+    out["applied"].append(action)
+    return None
+
+
+def save_notes(result: dict, *, now: Optional[float] = None) -> None:
+    """Keep the latest plan's notes and counts where the panel reads them."""
+    path = notes_path()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    doc = {"at": int(time.time() if now is None else now), "notes": result["notes"],
+           "applied": len(result["applied"]), "rejected": len(result["rejected"])}
+    tmp = path.with_suffix(".tmp")
+    tmp.write_text(json.dumps(doc))
+    tmp.replace(path)
+
+
+def read_notes() -> Optional[dict]:
+    try:
+        return json.loads(notes_path().read_text())
+    except (OSError, ValueError):
+        return None
