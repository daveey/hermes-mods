From bb0ebe5dc7225b23b917feea1a17460a347b6fca Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 01:56:03 +0000
Subject: [PATCH] [daveey] fix(hub-admission): only letter-dot abbreviations
 extend a pin's span; a filename, version, URL, no. or ellipsis ends it

Review 5884844910 nit on #1813: the '"." in word' rule skipped any dotted token, so a pin ending in foo.py./v1.2./a URL/no./an ellipsis ran onto the next line and genuine evidence there was denied as self-assertion. Only a listed abbreviation or a single-letter dotted run (e.g./i.e./U.S.) now skips; 'no' is dropped from the list.
---
 hermes_cli/kanban_hub_admission.py | 11 +++++++----
 tests/test_kanban_hub_admission.py | 13 +++++++++++++
 2 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_hub_admission.py b/hermes_cli/kanban_hub_admission.py
index 4e76acc37c..a1e79196d4 100644
--- a/hermes_cli/kanban_hub_admission.py
+++ b/hermes_cli/kanban_hub_admission.py
@@ -66,10 +66,13 @@ def self_assertion(quote):
 
 _PIN = re.compile("|".join(r"\s+".join(map(re.escape, m.split())) for m in SELF_ASSERTIONS), re.IGNORECASE)
 _SENTENCE_END = re.compile(r"[.!?](?=\s|$)|\n[ \t]*\n")
-# A "." ending one of these words, or a dotted token ("e.g", "U.S"), abbreviates rather than ends the sentence:
-# stopping there let the wrapped rest of a pin escape its span (review 5884663184). [daveey]
-_ABBREVIATIONS = frozenset({"e.g", "i.e", "etc", "vs", "cf", "viz", "approx", "incl", "esp", "al", "no", "mr", "mrs",
+# A "." ending one of these words, or a dotted run of single letters ("e.g", "U.S"), abbreviates rather than ends
+# the sentence: stopping there let the wrapped rest of a pin escape its span (review 5884663184). Any other dotted
+# token (a filename, version, URL or ellipsis) and "no." do end it, or real evidence on the next line would be
+# denied as pin text (review 5884844910). [daveey]
+_ABBREVIATIONS = frozenset({"e.g", "i.e", "etc", "vs", "cf", "viz", "approx", "incl", "esp", "al", "mr", "mrs",
                             "ms", "dr", "st"})
+_LETTER_DOTS = re.compile(r"(?:[^\W\d_]\.)+[^\W\d_]")
 _LAST_WORD = re.compile(r"[\w.]*$")
 
 
@@ -79,7 +82,7 @@ def _sentence_end(text, pos):
         if text[stop.start()] == ".":
             last = _LAST_WORD.search(text, max(0, stop.start() - 32), stop.start())
             word = last.group().lower() if last else ""
-            if word in _ABBREVIATIONS or "." in word:
+            if word in _ABBREVIATIONS or _LETTER_DOTS.fullmatch(word):
                 continue
         return stop
     return None
diff --git a/tests/test_kanban_hub_admission.py b/tests/test_kanban_hub_admission.py
index 824b4a9f68..e8a17697dc 100644
--- a/tests/test_kanban_hub_admission.py
+++ b/tests/test_kanban_hub_admission.py
@@ -292,6 +292,19 @@ def test_quote_from_inside_a_pin_line_is_not_admission_evidence(judge, body, quo
     assert verdict.admit is False and gate.SELF_ASSERTION_WHY in verdict.why
 
 
+# Only abbreviations extend a pin's span: a pin sentence ending in a filename, version, URL, "no." or an ellipsis
+# stops at that line, so evidence the next line states is judged on its own text (review 5884844910).
+@pytest.mark.parametrize("ending", [
+    "it reads foo.py.", "it needs v1.2.", "it reads https://example.com.", "worker access: no.", "it waits...",
+], ids=["filename", "version", "url", "no", "ellipsis"])
+def test_pin_ending_in_a_dotted_token_does_not_swallow_the_next_line(judge, ending):
+    gate, _, reply, _ = judge
+    reply.update(admit=True, need="hub_chrome", evidence="Renew it in the hub's signed-in Chrome.", why="Browser.")
+    body = (f"Pinned to the gateway that filed it: {ending}\n"
+            "Renew it in the hub's signed-in Chrome. Then report back.")
+    assert gate.admit({"title": "renew", "body": body}).admit is True
+
+
 def test_quote_also_found_outside_the_pin_line_is_judged_on_that_text(judge):
     gate, _, reply, _ = judge
     reply.update(admit=True, need="hub_chrome", evidence="signed-in Chrome", why="Browser.")
-- 
2.51.0

