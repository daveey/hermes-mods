+def test_idle_account_without_a_five_hour_reading_adds_a_full_window_of_headroom():
+    """The 11-14 16:57Z pool, reduced: account-primary burns its 5h window; account-secondary has 7d headroom and an
+    idle (``null``) five_hour. Before the fix the 5h sustainable rate was 0 -> factor 0 -> PACED, limit 0."""
+    now = 1794675425.0
+    current = [lp.Reading(now, "account-primary", lp.FIVE_HOUR, 78, 1794687600.0),  # 19:20Z
+               lp.Reading(now, "account-primary", lp.SEVEN_DAY, 100, 1794700800.0),
+               lp.Reading(now, "account-secondary", lp.SEVEN_DAY, 34, 1795276800.0)]  # 11-21 16:00Z
+    history = [lp.Reading(now - HOUR, "account-primary", lp.FIVE_HOUR, 70, 1794687600.0),
+               lp.Reading(now - HOUR, "account-secondary", lp.SEVEN_DAY, 34, 1795276800.0)]  # 7d flat: 5h decides
+    pace = lp.pool_pace("anthropic", current, history, CFG)
+    five_hour = (95 / lp.WINDOW_SECONDS[lp.FIVE_HOUR]) / (8 / HOUR)  # account-secondary's fresh window vs 8%/h
+    assert pace.factor == pytest.approx(five_hour, abs=1e-4)
+    assert pace.state == lp.OPEN  # was PACED at factor 0, limit 0
+    assert lp.admit_limit(pace, 4, deferrable=False, cfg=CFG) is None
