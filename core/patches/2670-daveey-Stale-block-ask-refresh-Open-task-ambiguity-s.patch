From 2c24892027be9a7ce05faab2092fa9901d9fdf48 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:28:07 -0800
Subject: [PATCH] [daveey] Stale block-ask refresh: Open-task ambiguity scan
 runs to the next notice head, not a blank line (review F2)

---
 hermes_cli/kanban_stale_ask.py               |  9 ++++++---
 tests/gateway/test_kanban_stale_block_ask.py | 13 +++++++++++++
 2 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_stale_ask.py b/hermes_cli/kanban_stale_ask.py
index 8bc059e2ca..dabdb0a6a4 100644
--- a/hermes_cli/kanban_stale_ask.py
+++ b/hermes_cli/kanban_stale_ask.py
@@ -40,8 +40,10 @@ _ASK = re.compile(
     r"Why only the user: " + _field("\nScope: ") + r"\n"
     r"(?P<rest>Scope: (?P<scope>" + _field("\nOpen task: ") + r")\nOpen task: @task:(?P<board>[^/@\s]+)(?:@(?P<gw>[^/\s]+))?/(?P<tid>[A-Za-z0-9_-]+))"
     r"(?P<hint>" + re.escape(TERMINAL_HINT) + r")?"
-    # A second "Open task:" line before the notice ends means a field quoted one: ambiguous, leave it.
-    r"(?!(?:(?!\n\n|blocked — actor: ).)*\nOpen task: )",
+    # A second "Open task:" line before the next notice's actor line (or the end of the text) means a
+    # field quoted one, so the matched Open task may be a quote: ambiguous, leave it. The scan does not
+    # stop at a blank line, since a human_request field may contain one (review F1/F2).
+    r"(?!(?:(?!blocked — actor: ).)*\nOpen task: )",
     re.DOTALL)
 logger = logging.getLogger(__name__)
 _PT = "America/Los_Angeles"
@@ -88,7 +90,8 @@ def _anchor(events, action: str, scope: str) -> Optional[int]:
     The read is bound to the notice: some event of the card must carry a human_request whose action AND
     scope equal the notice's (a scope that quotes another card's "Open task:" line makes the regex read
     that other card, whose asks then do not match). The anchor is the newest ``blocked`` event at or
-    before the newest such event, so an ask amended after its block still anchors on that block."""
+    before the newest such event (a metadata-only amendment is itself a ``blocked`` event, so an
+    amended ask anchors on the amendment; no labelled transition can sit between the two)."""
     for i in range(len(events) - 1, -1, -1):
         request = events[i][3].get("human_request")
         if (isinstance(request, dict) and _norm(request.get("action")) == action
diff --git a/tests/gateway/test_kanban_stale_block_ask.py b/tests/gateway/test_kanban_stale_block_ask.py
index 00d019603f..76feb1f004 100644
--- a/tests/gateway/test_kanban_stale_block_ask.py
+++ b/tests/gateway/test_kanban_stale_block_ask.py
@@ -208,6 +208,19 @@ def test_open_task_line_inside_scope_does_not_redirect_the_read(tmp_path, monkey
         assert refresh_stale_ask(text) == text  # still blocked on this very ask: byte-identical
 
 
+def test_scope_copied_from_a_done_cards_notice_keeps_the_ask(tmp_path, monkeypatch):
+    """Review F2: an ask copied from done card C's notice (same action, scope = C's scope + C's Open task
+    line + more) on still-blocked B must keep B's ask, whatever blank lines follow the quote."""
+    from hermes_cli.kanban_stale_ask import refresh_stale_ask
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    copied, _task = _card_with_scope("Only this card.")
+    _finish(copied)
+    for tail in ("\n\nand more.", "\nand more.", "\n\n\nblank lines, then more."):
+        tid, task = _card_with_scope(f"Only this card.\nOpen task: @task:default/{copied}{tail}")
+        text = _wake_text(tid, task)
+        assert refresh_stale_ask(text) == text, tail
+
+
 def test_open_task_line_inside_scope_of_a_done_card_is_left_alone(tmp_path, monkeypatch):
     """Ambiguous notice (two Open task lines): unchanged, never guessed."""
     from hermes_cli.kanban_stale_ask import refresh_stale_ask
