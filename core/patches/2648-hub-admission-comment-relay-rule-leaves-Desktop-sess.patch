From 3935e8f0c55a01bcea95f0672c579eb0bac2fd0e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 11:07:55 +0000
Subject: [PATCH] hub admission: comment-relay rule leaves Desktop-session and
 the remaining literal allowlist IDs to the judge

---
 hermes_cli/kanban_comment_relay.py |  5 ++++-
 tests/test_kanban_comment_relay.py | 12 ++++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_comment_relay.py b/hermes_cli/kanban_comment_relay.py
index 0c0d4913ef..b7614b96c7 100644
--- a/hermes_cli/kanban_comment_relay.py
+++ b/hermes_cli/kanban_comment_relay.py
@@ -37,7 +37,10 @@ _HUB_CONTEXT = re.compile(r"chrome|cloudflare access|admin key|instance[- ]role|
                           r"gateway_key_cli|hermes-hub\b|(?:gateway|hub)(?:'s|s)? (?:own )?key|"
                           r"hub-admin (?:cannot|can't|can not|is insufficient)|"
                           # hub_live_process: in-process hub gateway/serve state.
-                          r"hub_live_process|in-process|live process", re.IGNORECASE)
+                          r"hub_live_process|in-process|live process|"
+                          # The hub_reason schema's wording and the remaining literal allowlist IDs.
+                          r"desktop[- ]session|signed-in browser|board admin (?:credential|token)|"
+                          r"hub_chrome|board_admin_key|instance_role_ssm|user_terminal|hub_worktree", re.IGNORECASE)
 
 WHY = ("comment relay: a card that only posts a comment on another card never needs the hub. Post it from your "
        "own card: kanban_supervisor_request(ops=[{'op': 'operator', 'action': 'comment', 'task_id': <card>, "
diff --git a/tests/test_kanban_comment_relay.py b/tests/test_kanban_comment_relay.py
index 7ac6e28373..bc80856db1 100644
--- a/tests/test_kanban_comment_relay.py
+++ b/tests/test_kanban_comment_relay.py
@@ -92,6 +92,18 @@ def test_other_cards_still_go_to_the_judge(judge, title, body):
     assert len(calls) == 1
 
 
+@pytest.mark.parametrize("hub_reason", [
+    "a Desktop-session interaction",  # tools/kanban_tools_schemas.py hub_reason wording for user_terminal
+    "board_admin_key", "instance_role_ssm", "user_terminal", "hub_worktree", "hub_chrome",
+    "gateway_key_cli", "hub_live_process",
+])
+def test_relay_shaped_card_with_an_allowlist_hub_reason_goes_to_the_judge(judge, hub_reason):
+    gate, calls = judge
+    title, body = RELAYS[3]
+    assert gate.admit({"title": title, "body": body}, hub_reason=hub_reason).admit is True
+    assert len(calls) == 1
+
+
 @pytest.mark.parametrize("title,body", RELAYS)
 def test_worker_machine_hub_pin_for_a_relay_is_refused_with_the_route(judge, monkeypatch, title, body):
     """kanban_create on a worker with ``runs_on=['machine:hub']`` (how all four were filed) is refused."""
-- 
