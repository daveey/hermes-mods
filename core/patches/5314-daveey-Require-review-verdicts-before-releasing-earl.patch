From cf485278e0b542a2f894c735d53f6bd1d208724a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 13:56:21 +0000
Subject: [PATCH] [daveey] Require review verdicts before releasing earlier
 head authors

Keep unknown authors conservative even in mixed concrete epochs. Reproduce scheduled, blocked and crashed reviewers through real lifecycle APIs, with a request_changes control.

Proof: 40 consumer files, 1096 tests pass; 8 mutants killed, including a14 launch-as-verdict regression (five assertion failures). Four focused regressions red on a14 before fix. Read-only replay: 850 ordinary review histories, 17 changed exclusion sets versus full history, all nonempty with actual verdict boundaries. Independent exact-head re-review required.
---
 hermes_cli/kanban_review_model.py             | 13 +++-
 .../test_kanban_review_model_cycles.py        | 65 +++++++++++++++++--
 2 files changed, 69 insertions(+), 9 deletions(-)

diff --git a/hermes_cli/kanban_review_model.py b/hermes_cli/kanban_review_model.py
index 0ac6029968..bf7c829667 100644
--- a/hermes_cli/kanban_review_model.py
+++ b/hermes_cli/kanban_review_model.py
@@ -125,15 +125,18 @@ def _current_authors(conn, task_id):
     from hermes_cli.kanban_review_retry import rehandoff_runs
     repeats = rehandoff_runs(conn, task_id)
     models = set()
-    for row in conn.execute("SELECT id FROM task_runs WHERE task_id=? ORDER BY id DESC",
+    unknown_author = False
+    for row in conn.execute("SELECT id, outcome FROM task_runs WHERE task_id=? ORDER BY id DESC",
                             (task_id,)).fetchall():
         events = conn.execute("SELECT kind, payload FROM task_events WHERE task_id=? AND run_id=? "
                               "ORDER BY id DESC", (task_id, row[0])).fetchall()
         reviewing = any(event[0] in ("model_tier", "run_route") and
                         _payload(event[1]).get("lane") == "review" for event in events)
         if reviewing:
-            ran = any(event[0] in ("worker_result", "spawned") for event in events)
-            if ran and models:
+            # Launch/result receipts prove execution, not that anyone judged the
+            # head. Parked and crashed reviewers must not release its authors.
+            verdict = row[1] in ("changes_requested", "completed")
+            if verdict and models and not unknown_author:
                 return models, True
             continue
         if row[0] in repeats:
@@ -142,6 +145,10 @@ def _current_authors(conn, task_id):
                  or _run_model(conn, task_id, row[0], "run_route", "model"))
         if model:
             models.add(model)
+        else:
+            # An unknown author anywhere in this epoch retains earlier evidence
+            # and the concrete pin, even alongside known current authors.
+            unknown_author = True
     return models, False
 
 
diff --git a/tests/hermes_cli/test_kanban_review_model_cycles.py b/tests/hermes_cli/test_kanban_review_model_cycles.py
index bb9728f079..50d4cc6bab 100644
--- a/tests/hermes_cli/test_kanban_review_model_cycles.py
