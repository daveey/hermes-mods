 tests/gateway/test_stack_dump_daemon.py       | 67 +++++++++++++++++++
 .../test_unified_gateway_native_live.py       |  2 +-
 3 files changed, 97 insertions(+), 6 deletions(-)
 create mode 100644 tests/gateway/test_stack_dump_daemon.py

diff --git a/tests/gateway/fixtures/stack_dump_daemon.py b/tests/gateway/fixtures/stack_dump_daemon.py
