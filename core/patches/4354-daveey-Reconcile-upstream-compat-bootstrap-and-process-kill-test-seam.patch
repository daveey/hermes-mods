Subject: [PATCH] [daveey] Reconcile upstream compat bootstrap and process kill
 test seam

---
 hermes_bootstrap.py                              | 12 ++++++------
 tests/gateway/test_process_completion_custody.py |  2 +-
 2 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/hermes_bootstrap.py b/hermes_bootstrap.py
index 64459caa6a4bc519cf4ac12473d790ddf603605e..c6d869db69f757c38d20159a652fd162ecb47065 100644
--- a/hermes_bootstrap.py
+++ b/hermes_bootstrap.py
@@ -542,12 +542,6 @@ def _settle_interrupted_update() -> None:
 
 _settle_interrupted_update()
 
-# After the repair above: a merge killed while writing hermes_agent/ must not keep the repair from running.
-from hermes_agent.compat import install as _install_compat
-
-_install_compat()
-
-
 def _record_boot_revision() -> None:
     """Read the checkout revision before the rest of the tree is imported. The boot-pin guard
     (``gateway.code_skew``) installs much later, in ``start_gateway``/the serve lifespan; a
@@ -586,6 +580,12 @@ def _install_code_attestation() -> None:
 
 _install_code_attestation()
 
+# Keep compat after interrupted-update repair and audit installation: its modules
+# must be observed as executed code, not silently added to the trusted seed.
+from hermes_agent.compat import install as _install_compat
+
+_install_compat()
+
 
 def _pin_launcher_home() -> None:
     """A minted launcher (``hermes_cli._launchers``) pins ``HERMES_HOME`` to the install's default
diff --git a/tests/gateway/test_process_completion_custody.py b/tests/gateway/test_process_completion_custody.py
index 4cfcd299344c300c2d37ba340efb411527000bc0..da37ea13252c3cb6ee379b93941faa7248608a41 100644
--- a/tests/gateway/test_process_completion_custody.py
+++ b/tests/gateway/test_process_completion_custody.py
@@ -194,7 +194,7 @@ async def test_kill_that_races_the_reader_exit_settles_only_an_explicit_kill(rig
     h = await rig["setup"]()
     registry, session = _job(h)
 
-    def reader_exits_mid_signal(sess, sid, consume):
+    def reader_exits_mid_signal(sess, consume):
         _settle_exit(registry, sess, 0)
         assert OBLIGATION_KEY in _receipt(h)
     registry._signal_kill = reader_exits_mid_signal
