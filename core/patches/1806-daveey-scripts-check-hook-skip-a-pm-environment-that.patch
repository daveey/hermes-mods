From df6afc042080f3d78b17e9b9c71e5397494ad988 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 20:10:07 -0800
Subject: [PATCH] [daveey] scripts/check hook: skip a pm environment that
 yields no JSON without a traceback

On a checkout with no virtualenv the hook's python can be the CLT python3.9, which cannot run
pm.environments; it printed nothing and the inline parser raised JSONDecodeError on every push
(the push still succeeded, but agents read the traceback as a failure). Empty or non-object
output now exits 1 quietly, so the existing '|| continue' skips that composing checkout.
---
 scripts/check                         | 10 +++++++++-
 tests/scripts/test_code_health_cli.py | 19 +++++++++++++++++++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/scripts/check b/scripts/check
index 54089a13ffe..ba5323ba684 100755
--- a/scripts/check
+++ b/scripts/check
@@ -70,7 +70,15 @@ for pm_root in "$common" "${HERMES_HOME:-$HOME/.hermes}/hermes-agent"; do
   pm_env="$(cd "$pm_root" && PYTHONHOME= PYTHONPATH="$pm_root" "$py" -m pm.environments --format json \
       2>/dev/null | "$py" -c '
 import json, os, shlex, sys
-env, root = json.load(sys.stdin), os.path.realpath(sys.argv[1])
+# empty or non-object output = this python cannot compose the environment (e.g. a 3.9
+# python3 in a checkout with no virtualenv): skip it quietly, a traceback reads as a failed push
+try:
+    env = json.load(sys.stdin)
+except ValueError:
+    sys.exit(1)
+if not isinstance(env, dict):
+    sys.exit(1)
+root = os.path.realpath(sys.argv[1])
 pp = [p for p in env.get("PYTHONPATH", "").split(os.pathsep) if p and os.path.realpath(p) != root]
 if env.get("PATH") and pp:
     print("export PATH=" + shlex.quote(env["PATH"]))
diff --git a/tests/scripts/test_code_health_cli.py b/tests/scripts/test_code_health_cli.py
index 9e7f12bc59c..c991b49f624 100644
--- a/tests/scripts/test_code_health_cli.py
+++ b/tests/scripts/test_code_health_cli.py
@@ -368,6 +368,25 @@ def test_hooks_take_the_pm_composed_environment_minus_its_checkout(tmp_path, whe
     assert not record.exists()
 
 
+@pytest.mark.parametrize("output", ["", "not json\n", "[1, 2]\n"])
+def test_hooks_skip_a_pm_environment_that_yields_no_json_without_a_traceback(tmp_path, output):
+    """An interpreter that cannot run pm.environments (the mini's CLT python3.9 in a checkout
+    with no virtualenv) prints nothing, or garbage: the hook skips that composing checkout
+    quietly instead of printing a JSONDecodeError traceback that reads as a failed push."""
+    repo = _engine_repo(tmp_path)
+    assert _check(repo, "--install-hook", "pre-commit").returncode == 0
+    (repo / ".venv").symlink_to(Path(sys.prefix), target_is_directory=True)
+    env = _env()
+    env["HERMES_HOME"] = str(tmp_path / "hermes-home")
+    _write(repo, {"pm/environments.py": (
+        f"import sys\nsys.stdout.write({output!r})\nraise SystemExit(1)\n")})
+    _write(repo, {"pkg/b.py": "def b():\n    return 2\n"})
+    _git(repo, "add", "--", "pkg/b.py")
+    proc = _sh(repo, "git", "commit", "-q", "-m", "pm", env=env)
+    assert proc.returncode == 0, proc.stdout + proc.stderr
+    assert "Traceback" not in proc.stderr and "Error" not in proc.stderr, proc.stderr
+
+
 def test_check_refuses_old_python_before_importing_anything():
     # The guard reads sys.version_info; a 3.10 interpreter is emulated by overriding it before
     # scripts/check runs (tomllib, imported via ruff_runner, would otherwise crash it).
-- 
