From 4c2aa2a801ddb1c9958576d05502e8e011da760d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 21:29:27 +0000
Subject: [PATCH] [daveey] test(tui_gateway): intercept the prompt-turn spawn
 at its new prepare seam

---
 tests/tui_gateway/test_prompt_start_lock_order.py | 2 +-
 tests/tui_gateway/test_session_start_requests.py  | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_prompt_start_lock_order.py b/tests/tui_gateway/test_prompt_start_lock_order.py
index 051bfb8f168..8626fdb232e 100644
--- a/tests/tui_gateway/test_prompt_start_lock_order.py
+++ b/tests/tui_gateway/test_prompt_start_lock_order.py
@@ -220,7 +220,7 @@ def test_turn_start_failure_releases_the_prepared_admission_outside_sessions_loc
         turn_env, request, tmp_path, monkeypatch, failure):
     """A failure under ``_sessions_lock`` (routing-row reopen, or the thread spawn itself) propagates and
     gives the prepared admission back, taking ``history_lock`` only after ``_sessions_lock`` is released."""
-    import agent.memory_provider as memory_provider
+    from agent import memory_provider
     from hermes_cli import backend_retirement
 
     monkeypatch.setenv("HERMES_HOME", str(tmp_path))
diff --git a/tests/tui_gateway/test_session_start_requests.py b/tests/tui_gateway/test_session_start_requests.py
index 0e9868f8eed..90346e52bb1 100644
--- a/tests/tui_gateway/test_session_start_requests.py
+++ b/tests/tui_gateway/test_session_start_requests.py
@@ -154,6 +154,8 @@ def test_real_turn_adopts_first_user_row_and_commits_receipt(db, monkeypatch, tm
     monkeypatch.setattr(server, "_session_cwd", lambda record: str(tmp_path))
     monkeypatch.setattr(server, "_register_session_cwd", lambda record: None)
     monkeypatch.setattr(server, "_start_session_work", lambda fn, **kw: fn())
+    monkeypatch.setattr(server, "_prepare_session_work", lambda fn, **kw: SimpleNamespace(
+        start=lambda **_: fn(), cancel=lambda: None, abort=lambda: None))
     monkeypatch.setattr(server, "_wire_callbacks", lambda sid: None)
     monkeypatch.setattr(server, "_sync_agent_model_with_config", lambda *args: None)
     monkeypatch.setattr(server, "_tts_stream_begin", lambda: None)
-- 
2.55.0

