diff --git a/hermes_cli/kanban_home_schema.py b/hermes_cli/kanban_home_schema.py
new file mode 100644
index 0000000000000000000000000000000000000000..337e6028c252297231491237c7a11bbab7c3e3ea
--- /dev/null
+++ b/hermes_cli/kanban_home_schema.py
@@ -0,0 +1,122 @@
+"""Atomic lazy-schema coverage for dormant home preparation. [daveey]
+
+Native outer write_txn owns persistent custody DDL as well as DML. Existing
+per-table SQL triggers still reject ordinary statements, including raw clients.
+For a newly created table, this boundary rejects protected rows before COMMIT
+and installs durable triggers on empty/healthy-only tables in that same writer.
+
+This is cooperative committed-state fencing, not hostile-SQL sandboxing. Native
+writers must not end their own transaction, manipulate schema_version, remove
+and recreate guards, or publish effects from uncommitted work. TEMP/attached
+custody and arbitrary external DDL writers are outside this protocol.
+"""
+from __future__ import annotations
+
+import sqlite3
+
+from hermes_cli import kanban_home_abort as abort
+from hermes_cli import kanban_home_finalized as finalized
+
+_TABLE = 'kanban_home_prepared1'
+_EXEMPT = {_TABLE, 'kanban_home_finalized1', 'kanban_home_aborted1',
+           'containment_canonical_receipts'}
+_RESTRICTIVE = {'containment_sync_quarantine', 'containment_sync_quarantine_tasks'}
+
+
+def _quote(name):
+    return '"' + name.replace('"', '""') + '"'
+
+
+def _installed(conn):
+    return bool(conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (_TABLE,)).fetchone())
+
+
+def _active(conn):
+    valid = finalized.predicate('p')
+    return (f'SELECT p.task_id FROM {_TABLE} p WHERE NOT EXISTS('
+            f'SELECT 1 FROM kanban_home_finalized1 f WHERE {valid}) AND NOT EXISTS('
+            f'SELECT 1 FROM kanban_home_aborted1 a WHERE {abort.predicate("p")})')
+
+
+def _tables(conn):
+    tables = {}
+    names = list(conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"))
+    for (name,) in names:
+        if name in _EXEMPT:
+            continue
+        columns = {r[1] for r in conn.execute(f'PRAGMA table_info({_quote(name)})')}
+        if name in ('tasks', 'task_links') or 'task_id' in columns:
+            tables[name] = columns
+    return tables
+
+
+def _covered(conn, table):
+    actions = ('update', 'delete') if table in _RESTRICTIVE else ('insert', 'update', 'delete')
+    return all(conn.execute("SELECT 1 FROM sqlite_master WHERE type='trigger' AND tbl_name=? AND name=?",
+                            (table, f'home_prepared1_{table}_{action}')).fetchone() for action in actions)
+
+
+def _identities(conn, tables):
+    # Index definitions matter: a new UNIQUE key changes REPLACE's deletion set.
+    # Auto-index SQL is NULL, but table SQL carries its declared constraints.
+    guards = {f'home_prepared1_{table}_{action}' for table in tables
+              for action in ('insert', 'update', 'delete')}
+    return {(r[0], r[1]): (r[2], r[3]) for r in conn.execute(
+        "SELECT type,name,tbl_name,sql FROM sqlite_master WHERE type IN ('table','index','trigger')")
+        if r[2] in tables and (r[0] != 'trigger' or r[1] in guards)}
+
+
+def _cover(conn):
+    tables = _tables(conn)
+    missing = [name for name in tables if not _covered(conn, name)]
+    active = _active(conn)
+    for name in missing:
+        if name in _RESTRICTIVE:
+            continue  # restrictive append is deliberately allowed; its immutable guard still installs
+        columns = ('id',) if name == 'tasks' else ('parent_id', 'child_id') if name == 'task_links' else ('task_id',)
+        condition = ' OR '.join(f'{_quote(col)} IN ({active})' for col in columns)
+        if conn.execute(f'SELECT 1 FROM {_quote(name)} WHERE {condition} LIMIT 1').fetchone():
+            raise sqlite3.IntegrityError('home transfer prepared: uncovered custody table')
+    if missing:
+        from hermes_cli.kanban_home_transfer import _install
+        _install(conn)
+    return tables
+
+
+def begin(conn):
+    """Called under the outer BEGIN reservation, before application statements."""
+    if not _installed(conn):
+        return None
+    version = conn.execute('PRAGMA schema_version').fetchone()[0]
+    cached = getattr(conn, '_home_schema_committed', None)
+    if cached is not None and cached[0] == version:
+        return cached
+    tables = _cover(conn)
+    return conn.execute('PRAGMA schema_version').fetchone()[0], _identities(conn, tables)
+
+
+def finish(conn, before):
+    """Fail closed before COMMIT; all failures use write_txn's ordinary rollback."""
+    if not _installed(conn):
+        if before is not None:
+            raise sqlite3.IntegrityError('home transfer prepared: preparation schema removed')
+        return
+    version = conn.execute('PRAGMA schema_version').fetchone()[0]
+    if before is not None and before[0] == version:
+        return before
+    tables = _tables(conn)
+    if before is not None and conn.execute(_active(conn) + ' LIMIT 1').fetchone():
+        current = _identities(conn, tables)
+        if any(current.get(key) != value for key, value in before[1].items()):
+            raise sqlite3.IntegrityError('home transfer prepared: guarded schema changed')
+        old_tables = {value[0] for value in before[1].values()}
+        if any(key not in before[1] and value[0] in old_tables for key, value in current.items()):
+            raise sqlite3.IntegrityError('home transfer prepared: guarded identity changed')
+    tables = _cover(conn)
+    return conn.execute('PRAGMA schema_version').fetchone()[0], _identities(conn, tables)
+
+
+def committed(conn, snapshot):
+    """Cache only a successful COMMIT, never speculative/savepoint schema cookies."""
+    if hasattr(conn, '__dict__'):
+        conn._home_schema_committed = snapshot
diff --git a/hermes_cli/kanban_home_transfer.py b/hermes_cli/kanban_home_transfer.py
index 69619aea0db38a5917d4b95d8533257dbbfe578a..70284a68c4291e856bf1cd251e3af2215044fb8a 100644
--- a/hermes_cli/kanban_home_transfer.py
+++ b/hermes_cli/kanban_home_transfer.py
@@ -159,6 +159,10 @@
     Refusals roll back this helper even when caught by a caller which commits.
     Outbox drainage is conservative across the entire board, including rejected
     custody and synthetic parents. This does not attest remote receipt/drainage.
+    Persistent schema and custody writers use native outer write_txn: its lazy
+    schema boundary registers later tables atomically or rejects their prepared
+    rows before COMMIT. See kanban_home_schema for the cooperative DDL contract;
+    this helper does not sandbox arbitrary SQLite schema-changing clients.
     """
     if not conn.in_transaction:
         raise ValueError("home preparation requires a write transaction")
diff --git a/tests/hermes_cli/test_home_lazy_schema_boundary.py b/tests/hermes_cli/test_home_lazy_schema_boundary.py
new file mode 100644
index 0000000000000000000000000000000000000000..0b38c0e93d50f7a59462ee6aa0c3a401a39678df
--- /dev/null
+++ b/tests/hermes_cli/test_home_lazy_schema_boundary.py
@@ -0,0 +1,117 @@
+"""Writer/savepoint/rollback controls for dormant late-schema registration. [daveey]"""
+import sqlite3
+
+import pytest
+from hermes_cli import kanban_db_connect as dbc
+from tests.hermes_cli import test_home_lazy_schema_custody as lazy
+from tests.hermes_cli import test_kanban_home_transfer_fence as support
+from tests.hermes_cli import test_kanban_home_source_stop as stop
+
+board = support.board
+
+
+def test_nested_late_insert_cannot_escape_outer_commit(board):
+    task = support.seed(board)
+    with dbc.write_txn(board):
+        support.prepare(board, task)
+    with pytest.raises(sqlite3.IntegrityError, match='home transfer prepared'):
+        with dbc.write_txn(board):
+            with dbc.write_txn(board, allow_nested=True):
+                lazy.late(board)
+                board.execute('INSERT INTO late_custody VALUES (?,?,?)', ('nested', task, 'late'))
+    assert not board.execute("SELECT 1 FROM sqlite_master WHERE name='late_custody'").fetchone()
+    assert not board.in_transaction
+
+
+def test_nested_schema_rollback_does_not_leave_speculative_coverage(board):
+    task = support.seed(board)
+    with dbc.write_txn(board):
+        support.prepare(board, task)
+        with pytest.raises(ValueError, match='fixture rollback'):
+            with dbc.write_txn(board, allow_nested=True):
+                lazy.late(board)
+                raise ValueError('fixture rollback')
+    # Reusing the rolled-back schema cookie for a different table is not a cache hit.
+    with dbc.write_txn(board):
+        lazy.late(board, 'other_custody')
+    with pytest.raises(sqlite3.IntegrityError, match='home transfer prepared'):
+        with dbc.write_txn(board):
+            board.execute('INSERT INTO other_custody VALUES (?,?,?)', ('protected', task, 'late'))
+
+
+def test_rolled_back_first_install_does_not_poison_next_schema(board):
+    task = support.seed(board)
+    with pytest.raises(ValueError, match='fixture rollback'):
+        with dbc.write_txn(board):
+            support.prepare(board, task)
+            lazy.late(board)
+            raise ValueError('fixture rollback')
+    with dbc.write_txn(board):
+        support.prepare(board, task)
+        lazy.late(board, 'other_custody')
+    with pytest.raises(sqlite3.IntegrityError, match='home transfer prepared'):
+        with dbc.write_txn(board):
+            board.execute('INSERT INTO other_custody VALUES (?,?,?)', ('protected', task, 'late'))
+
+
+@pytest.mark.parametrize('settle', ['abort', 'finalize'])
+def test_exact_settlement_allows_new_custody_table(board, settle):
+    from hermes_cli import kanban_home_transfer as transfer
+    task = support.seed(board)
+    record = stop.record(board, task)
+    with dbc.write_txn(board):
+        support.prepare(board, task, nonce=record['nonce'])
+    with dbc.write_txn(board):
+        if settle == 'abort':
+            transfer.abort_source(board, {**record, 'phase': 'aborted', 'rows': []})
+        else:
+            transfer.finalize_source(board, record)
+        lazy.late(board)
+        board.execute('INSERT INTO late_custody VALUES (?,?,?)', ('settled', task, 'allowed'))
+    assert board.execute('SELECT value FROM late_custody').fetchone()[0] == 'allowed'
+
+
+def test_healthy_new_table_has_replace_and_update_sql_guards(board):
+    task = support.seed(board)
+    with dbc.write_txn(board):
+        support.prepare(board, task)
+        lazy.late(board)
+    # No native wrapper is needed after registration: the durable SQL fence acts.
+    with pytest.raises(sqlite3.IntegrityError, match='home transfer prepared'):
+        board.execute('INSERT INTO late_custody VALUES (?,?,?)', ('protected', task, 'late'))
+    with dbc.write_txn(board):
+        board.execute('INSERT INTO late_custody VALUES (?,?,?)', ('healthy', 'other-task', 'original'))
+    with pytest.raises(sqlite3.IntegrityError, match='home transfer prepared'):
+        board.execute('INSERT OR REPLACE INTO late_custody VALUES (?,?,?)', ('healthy', task, 'late'))
+    assert tuple(board.execute('SELECT * FROM late_custody').fetchone()) == ('healthy', 'other-task', 'original')
+
+
+def test_noop_writer_does_not_reinstall_schema_or_scan_custody(board, monkeypatch):
+    from hermes_cli import kanban_home_schema as schema
+    task = support.seed(board)
+    with dbc.write_txn(board):
+        support.prepare(board, task)
+    version = board.execute('PRAGMA schema_version').fetchone()[0]
+    def unexpected(*args):
+        raise AssertionError('unchanged committed schema must not be rediscovered')
+    monkeypatch.setattr(schema, '_tables', unexpected)
+    with dbc.write_txn(board):
+        board.execute('SELECT 1')
+    assert board.execute('PRAGMA schema_version').fetchone()[0] == version
+
+
+@pytest.mark.parametrize('action', ['update', 'delete'])
+def test_removed_existing_custody_trigger_is_not_silently_adopted(board, action):
+    task = support.seed(board)
+    with dbc.write_txn(board):
+        lazy.late(board)
+        board.execute('INSERT INTO late_custody VALUES (?,?,?)', ('protected', task, 'original'))
+        support.prepare(board, task)
+    with pytest.raises(sqlite3.IntegrityError, match='home transfer prepared'):
+        with dbc.write_txn(board):
+            board.execute(f'DROP TRIGGER home_prepared1_late_custody_{action}')
+            if action == 'delete':
+                board.execute('DELETE FROM late_custody')
+    with pytest.raises(sqlite3.IntegrityError, match='home transfer prepared'):
+        board.execute("UPDATE late_custody SET value='late'")
+    assert tuple(board.execute('SELECT * FROM late_custody').fetchone()) == ('protected', task, 'original')
diff --git a/tests/hermes_cli/test_home_lazy_schema_custody.py b/tests/hermes_cli/test_home_lazy_schema_custody.py
