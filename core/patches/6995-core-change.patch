+"""Shared home invariant: latest late-writer review families; run every partition."""
+from tests.hermes_cli import test_home_review_late_wakes as late
+from tests.hermes_cli import test_home_review_wake_producers as producers
+from tests.hermes_cli import test_home_review_ci_sweep as ci
+from tests.hermes_cli import test_home_review_block_branches as block
+from tests.hermes_cli import test_home_review_protect_drain as protect
+from tests.hermes_cli import test_home_review_label_capture as label
+from tests.hermes_cli import test_home_review_epoch_replace as epoch
+
+board = late.board
+live = epoch.live
