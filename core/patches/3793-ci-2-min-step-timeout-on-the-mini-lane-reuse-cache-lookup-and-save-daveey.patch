From 0c5820fd8ce5b5bebc6c6b65bae86faef499f474 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:35:28 +0000
Subject: [PATCH] ci: 2-min step timeout on the mini lane reuse cache lookup
 and save [daveey]

Follow-up to PR #2423 review 5896075790 (card t_01a1d62aa1988b17).

The state-reuse `actions/cache/restore` lookup in `detect` and the
`actions/cache/save` in `macOS state required (v1)` had no step
timeout-minutes. A stalled cache endpoint would hold detect until its
5-min job timeout (failing the whole CI run) or hold the required check
until its 10-min job timeout. Both now carry the repo's cache-step
convention `timeout-minutes: 2`; both already had continue-on-error, so a
timed-out lookup is a miss (the lane runs) and a timed-out save only
loses a later skip.

tests/ci/test_macos_state_reuse.py asserts both timeouts (RED on the
old ci.yaml, GREEN now). The macos_state_reuse.py docstring now says
ci.yaml is in the reuse key only when the PR changes it, deliberately,
matching the routing contract.
---
 .github/workflows/ci.yaml          | 2 ++
 scripts/ci/macos_state_reuse.py    | 4 +++-
 tests/ci/test_macos_state_reuse.py | 3 +++
 3 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/ci.yaml b/.github/workflows/ci.yaml
index 806a41de92..5543d8e0f1 100644
--- a/.github/workflows/ci.yaml
+++ b/.github/workflows/ci.yaml
@@ -142,6 +142,7 @@ jobs:
         id: state-reuse
         if: steps.state-reuse-key.outputs.key != ''
         continue-on-error: true
+        timeout-minutes: 2
         uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
         with:
           path: /tmp/hermes-state-macos-pass
@@ -684,6 +685,7 @@ jobs:
       - name: Save the mini lane pass
         if: steps.state-pass.outcome == 'success'
         continue-on-error: true
+        timeout-minutes: 2
         uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
         with:
           path: /tmp/hermes-state-macos-pass
diff --git a/scripts/ci/macos_state_reuse.py b/scripts/ci/macos_state_reuse.py
index 04944c6126..3c33dbaacb 100644
--- a/scripts/ci/macos_state_reuse.py
+++ b/scripts/ci/macos_state_reuse.py
@@ -18,7 +18,9 @@ of every changed file that routes the lane plus the lane workflow itself. So any
 routing file, a routing file added to or dropped from the diff, a main change to one of those files
 or a lane workflow change gives a new key. Main changes to other surface files do not: the routing
 contract already leaves those to their own PRs and the 4-hourly main schedule
-(classify_changes.py). An empty or capped file list (the lane runs whatever it touched) has no key.
+(classify_changes.py). For the same reason ``.github/workflows/ci.yaml`` is in the key only when this
+PR changes it (it then routes the lane as ``HERMES_STATE_WIRING``): a main edit to ci.yaml alone keeps
+the key, deliberately. An empty or capped file list (the lane runs whatever it touched) has no key.
 """
 from __future__ import annotations
 
diff --git a/tests/ci/test_macos_state_reuse.py b/tests/ci/test_macos_state_reuse.py
index 13e2340b34..137e7ef4ac 100644
--- a/tests/ci/test_macos_state_reuse.py
+++ b/tests/ci/test_macos_state_reuse.py
@@ -137,6 +137,9 @@ def test_lookup_and_save_share_key_and_path_and_never_fail_the_gate():
     assert workflow("ci.yaml")["jobs"]["detect"]["outputs"]["hermes_state_reuse_key"] == \
         "${{ steps.state-reuse-key.outputs.key }}"
     assert all(step.get("continue-on-error") is True for step in (lookup, record, save))
+    # A stalled cache endpoint must not hold detect (5 min) or the required check (10 min) until
+    # its job timeout: both cache steps give up after 2 min, and a timed-out lookup is a miss.
+    assert lookup.get("timeout-minutes") == 2 and save.get("timeout-minutes") == 2
     assert lookup["uses"].split("@")[1] == save["uses"].split("@")[1]
 
 
-- 
