From 12d3875604a1036ae9e9a8e15d7d06e8e3e8d297 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 13:05:46 +0000
Subject: [PATCH] test(kanban): separate preclaim review history from actual
 admission [daveey]

Never-claimed downstream reviews omit summary so request_review does not synthesize a run before pool/order/no-attempt controls. Retained whole hub/fair receipt155/0 retriesOFF. Replace obsolete exact reviewer choice with actual qualified registry membership and distinct admitted run; WIP assignment file remains11/1 at conservative author-set assertion, awaiting bounded disposition after two iterations. Authentic old recovery producer mutation fails intended body assertion; current whole goal file12/0. Full scripts/check green. Not broad/CI/live or landing readiness.
---
 tests/hermes_cli/kanban_review_fixture.py     |  6 +++++-
 .../test_kanban_model_assignment.py           | 20 +++++++++++++++++--
 2 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/tests/hermes_cli/kanban_review_fixture.py b/tests/hermes_cli/kanban_review_fixture.py
index 21dc7b1261..014e4b3502 100644
--- a/tests/hermes_cli/kanban_review_fixture.py
+++ b/tests/hermes_cli/kanban_review_fixture.py
@@ -53,7 +53,11 @@ def source_id(conn):
 def create_review(conn, title, assignee, **kwargs):
     tid = kb.create_task(conn, title=f"Independent review of {title}", assignee=assignee,
                          creator_task_id=source_id(conn), **kwargs)
-    assert kb.request_review(conn, tid, summary="Review the completed source")
+    # A never-claimed downstream review has no implementation run to close.
+    # A summary would synthesize a historical run, polluting no-attempt and
+    # readiness-age controls before the scheduler has admitted this target.
+    assert kb.request_review(conn, tid)
+    assert conn.execute("SELECT count(*) FROM task_runs WHERE task_id=?", (tid,)).fetchone()[0] == 0
     task = kb.get_task(conn, tid)
     assert implementer_models(conn, task) == {AUTHOR}
     assert (task.model_override, task.provider_override) == (None, None)
diff --git a/tests/hermes_cli/test_kanban_model_assignment.py b/tests/hermes_cli/test_kanban_model_assignment.py
index 8b25919895..0016ac6b24 100644
--- a/tests/hermes_cli/test_kanban_model_assignment.py
+++ b/tests/hermes_cli/test_kanban_model_assignment.py
@@ -72,16 +72,32 @@ def test_dispatch_routes_legacy_incompatible_pin_without_spawning(board, monkeyp
     from hermes_cli.kanban_review_model import implementer_models
     conn, _ = board
     tid = kb.create_task(conn, title='Legacy review', assignee='worker', session_id='chat')
+    source_run = None
     if lane == 'review':
         _review_source(conn, tid)
+        source_run = conn.execute(
+            'SELECT id FROM task_runs WHERE task_id=? ORDER BY id DESC LIMIT 1', (tid,)).fetchone()[0]
     # Historical rows remain audit evidence, not an ingress path to create pins.
     conn.execute('UPDATE tasks SET model_override=?, status=? WHERE id=?', ('claude-opus-5-5', lane, tid))
     conn.commit()
     spawned = []
     result = dispatch_once(conn, spawn_fn=lambda task, *args: spawned.append(
         (task.id, task.model_override, task.provider_override)), max_spawn=1)
-    expected = ('claude-opus-5-5', 'anthropic') if lane == 'review' else ('class:standard', 'auto')
-    assert spawned == [(tid, *expected)], repr(result)
+    if lane == 'review':
+        from agent.model_routing import eligible_routes, validate_policy
+        from agent.model_routing_agent import class_requirements
+        from hermes_cli.kanban_model_assignment import _assignee_config
+        config = _assignee_config('worker')
+        assert config is not None
+        validate_policy(config['model_routing'])
+        qualified = {(route['model'], route['provider'])
+                     for route in eligible_routes(config['model_routing'], 'standard', class_requirements(config))}
+        assert len(spawned) == 1 and spawned[0][0] == tid, repr(result)
+        assert spawned[0][1:] in qualified
+        assert kb.get_task(conn, tid).current_run_id != source_run
+        assert conn.execute('SELECT outcome FROM task_runs WHERE id=?', (source_run,)).fetchone()[0] == 'review_requested'
+    else:
+        assert spawned == [(tid, 'class:standard', 'auto')], repr(result)
     task = kb.get_task(conn, tid)
     assert task.status == 'running' and task.assignee == 'worker' and task.block_kind is None
     assert task.model_override == 'claude-opus-5-5'  # never rewrite historical row
-- 
