-        if ((p.get("writer_kind") == "human" or p.get("relayed_human") is not None) and _event_order(event) > after
+        if (by_person(p) and _event_order(event) > after
                 and isinstance(cid, int) and cid > (seen or 0)):
             out.append(cid)
