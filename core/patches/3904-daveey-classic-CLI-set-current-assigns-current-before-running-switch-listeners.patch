From 5e87b950851d8b04382e17edcd7879d38fa8ba53 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 21:48:39 +0000
Subject: [PATCH] [daveey] classic CLI: set_current assigns current before
 running switch listeners

GatewaySessionStore.set_current() (#2648) ran switch_listeners before it
assigned self.current. If the gateway pump thread applied the left session's
late inventory_pending:false session.info between the listener-list swap and
left(), settled() claimed the wait, still saw store.current is snapshot, and
printed the left session's unknown-toolset / tool-availability warnings on the
new session (and adopted its enabled_toolsets when unset).

Fix: assign current first, then swap and run the listeners. The only
production listener (cli_init_mixin left) never reads current.

Proof: test_a_settle_racing_the_switch_listeners_sees_the_new_session puts a
switch listener ahead of left that applies the LATE settled frame on the pump
thread (the reviewer's probe from review 5898028266 on #2648). RED on main
(prints the 3 notice lines), GREEN with the fix. Every hermes_cli suite that
imports the store or calls set_current: 28 files, 391 passed; gateway/state
importers: 7 files, 41 passed.
---
 hermes_cli/gateway_session_store.py                |  7 ++++---
 .../test_cli_gateway_inventory_pending.py          | 14 ++++++++++++++
 2 files changed, 18 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/gateway_session_store.py b/hermes_cli/gateway_session_store.py
index 78a98ab727..e61ec61abd 100644
--- a/hermes_cli/gateway_session_store.py
+++ b/hermes_cli/gateway_session_store.py
@@ -142,12 +142,13 @@ class GatewaySessionStore:
         return sid
 
     def set_current(self, snapshot):
-        """Open ``snapshot`` (``None``: none); a move off the current one runs the switch listeners."""
-        if snapshot is not self.current:
+        """Open ``snapshot`` (``None``: none); a move off the current one runs the switch listeners. The
+        new session is current before they run, so a pump-thread settle racing them sees the move."""
+        moved, self.current = snapshot is not self.current, snapshot
+        if moved:
             listeners, self.switch_listeners = self.switch_listeners, []
             for listener in listeners:
                 listener()
-        self.current = snapshot
 
     def attach(self, session_id, *, typed=False):
         """``session.resume`` once per session id this viewer uses (idempotent), carrying this CLI's launch
diff --git a/tests/hermes_cli/test_cli_gateway_inventory_pending.py b/tests/hermes_cli/test_cli_gateway_inventory_pending.py
index c9996db11f..31ad65efb4 100644
--- a/tests/hermes_cli/test_cli_gateway_inventory_pending.py
+++ b/tests/hermes_cli/test_cli_gateway_inventory_pending.py
@@ -107,6 +107,20 @@ def test_a_switch_while_pending_never_prints_the_left_sessions_notices(pending_s
     assert host.enabled_toolsets is None  # nor is the left session's toolset list adopted
 
 
+def test_a_settle_racing_the_switch_listeners_sees_the_new_session(pending_store, monkeypatch):
+    """The pump thread can apply the left session's late settled frame while ``set_current`` is still
+    running the switch listeners, before ``left`` claims the wait: the switch must already show the new
+    session as current, so that settle prints nothing and adopts nothing."""
+    db, client = pending_store
+    host, printed = _launch(monkeypatch, db)
+    db.switch_listeners.insert(0, lambda: _settle_after_switch(db, client))  # runs before ``left``
+    db.attach("local-old")
+    assert printed == [], printed
+    assert host.enabled_toolsets is None
+    assert db.connection.state("local-new").info_listeners == []
+    assert db.switch_listeners == []
+
+
 def test_the_wait_is_dropped_when_the_cli_switches_session(pending_store, monkeypatch):
     db, _client = pending_store
     _launch(monkeypatch, db)
