From faa9164c439bbe2e65f5a2dde319571d424d96a4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 01:22:05 +0000
Subject: [PATCH] fix(kanban placement): a Baby Bear title on Linux/CI-only
 work no longer pins the card local [daveey]

The product-name marker treated 'myapp' in a title as an Apple/local need. A
David-MBP card moving the linux-pod-release smoke job to self-hosted Linux runners
(t_01a188a358643778) stayed on the MacBook for that reason alone.

With the built-in marker list, a product-name hit (PRODUCT_NAME_MARKERS) is now
skipped when the card names Linux/Ubuntu and nothing Apple- or device-bound
(Xcode/xcodebuild/xcrun/fastlane, simulator, signing/provisioning/notarization,
TestFlight/App Store, iOS/iPhone/iPad/watch, Swift, CoreML, AVFoundation, .app,
Mac/macOS/MacBook/the mini, Keychain/TCC). self-hosted/runs-on/docker alone are not
Linux evidence (Mac runners use them too). Every other marker is unchanged; a
replaced local_markers list keeps full control.

Tests: the exact observed title/body goes to the hub (fails before); Apple/device
counterexamples stay local, and seven of them fail under a looser exemption
(Linux evidence alone, or the first-draft Apple list). Reviewed by an independent
pass whose findings (xcodebuild/fastlane/Mac-client gaps, non-Linux CI words) are
fixed here.
---
 hermes_cli/kanban_placement.py            | 25 +++++++++-
 tests/hermes_cli/test_kanban_placement.py | 61 +++++++++++++++++++++++
 2 files changed, 84 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 76d9d426abd..5f19682ef57 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -35,7 +35,8 @@ A card stays local when any of these holds:
   built-in list, ``extra_local_markers`` extends it): Chrome, Keychain, TCC, Apple apps, launchd,
   the Desktop app, a Desktop DOM/CDP readback, this Mac's Keychain... A bare host name (MacBook,
   the mini) pins only when it is the subject of the title. A body mention — a repro, or "verify
-  live on the hub and the MacBook" — is not a local-only need;
+  live on the hub and the MacBook" — is not a local-only need. A product name (Baby Bear) in the
+  title pins only when the card names no Linux, or also names Apple/device work;
 * the target is not live: this gateway's hermes-hub sync has not succeeded recently, or the
   target's capability record is stale.
 
@@ -102,6 +103,19 @@ DEFAULT_LOCAL_MARKERS = (
 TITLE_ONLY_LOCAL_MARKERS = frozenset({
     r"\bmacbook\b", r"\bmac ?mini\b", r"\bthe mini\b", r"\bdavids-mac-mini\b", BABYBEAR_MARKER,
 })
+# Product names (not hosts, not Apple tech): a product with Linux parts (BB pods, their CI on
+# self-hosted Linux runners) is not an Apple/local need by name alone. With the built-in list, a
+# product-name hit is skipped when the card names Linux and nothing Apple- or device-bound.
+PRODUCT_NAME_MARKERS = frozenset({BABYBEAR_MARKER})
+# Linux named outright: self-hosted runners, runs-on, docker and containers exist on Macs too.
+LINUX_CONTEXT_MARKERS = (r"\blinux\b", r"\bubuntu\b")
+APPLE_CONTEXT_MARKERS = (
+    r"\bxcode", r"\bxcrun\b", r"\bfastlane\b", r"\bsimulator\b", r"\bcodesign", r"\bcode ?signing\b",
+    r"\bsigning identit", r"\bdeveloper id\b", r"\bprovisioning\b", r"\bnotari[sz]", r"\btestflight\b",
+    r"\bapp store\b", r"\bios\b", r"\biphone\b", r"\bipad\b", r"\bwatchos\b", r"\bswift(ui)?\b", r"\.app\b",
+    r"\bcatalyst\b", r"\bcore ?ml\b", r"\bwatch app\b", r"\bav(foundation|audiosession)\b", r"\bapple\b",
+    r"\bmac\b", MACOS_MARKER, r"\bmacbook\b", r"\bmac ?mini\b", r"\bthe mini\b", r"\bkeychain\b", r"\btcc\b",
+)
 LOCAL_MARKER_REMEDY = (
     "if the work doesn't need this machine, archive and re-create with placement='hub'")
 DEFAULT_LOCAL_SKILL_MARKERS = (
@@ -246,10 +260,17 @@ def is_placeholder_session(value: str) -> bool:
 
 def _local_marker(title: str, body: str, skills, cfg: _Cfg) -> Optional[str]:
     """The first local-only hit, or None. Host-name markers (see
-    :data:`TITLE_ONLY_LOCAL_MARKERS`) scan the title only, unless the caller replaced the list."""
+    :data:`TITLE_ONLY_LOCAL_MARKERS`) scan the title only, unless the caller replaced the list.
+    A product name (:data:`PRODUCT_NAME_MARKERS`) does not pin a card whose text names Linux
+    and no Apple or device-bound work (same exception: not with a replaced list)."""
     full = f"{title or ''}\n{body or ''}"
     replaced = isinstance(cfg.raw.get("local_markers"), list)
+    linux_only = (not replaced
+                  and any(re.search(p, full, re.IGNORECASE) for p in LINUX_CONTEXT_MARKERS)
+                  and not any(re.search(p, full, re.IGNORECASE) for p in APPLE_CONTEXT_MARKERS))
     for rx in cfg.markers():
+        if linux_only and rx.pattern in PRODUCT_NAME_MARKERS:
+            continue
         text = (title or "") if (not replaced and rx.pattern in TITLE_ONLY_LOCAL_MARKERS) else full
         m = rx.search(text)
         if m:
diff --git a/tests/hermes_cli/test_kanban_placement.py b/tests/hermes_cli/test_kanban_placement.py
index 096ba4b2ffe..e6c04ad05c8 100644
--- a/tests/hermes_cli/test_kanban_placement.py
+++ b/tests/hermes_cli/test_kanban_placement.py
@@ -308,6 +308,67 @@ def test_myapp_skill_or_repo_in_the_body_does_not_pin_the_card():
     assert d["where"] == "local" and "baby bear" in d["why"], d
 
 
+# t_01a188a358643778 (David-MBP board, exact title and body): placed local by "mentions 'myapp'"
+# and claimed by the MacBook, though the whole job is a Linux CI workflow on self-hosted runners.
+BB_LINUX_CI_TITLE = ("myapp: move linux-pod-release `smoke` job off GitHub-hosted ubuntu-24.04 "
+                     "(Actions billing-blocked)")
+BB_LINUX_CI_BODY = (
+    "GitHub-hosted Actions on daveey's private repos have been refused for billing since 2026-10-17 "
+    "(ticket https://support.github.com/ticket/personal/0/4874098, still no reply). Re-verified "
+    "2026-10-29 17:06 UTC: rerun of https://github.com/me/myapp/actions/runs/40905061318 smoke "
+    "job refused at dispatch.\n\nThe ONLY remaining hosted job in me/myapp is `smoke` in "
+    ".github/workflows/linux-pod-release.yml (runs-on: ubuntu-24.04). Every other job already targets "
+    "self-hosted labels.\n\nDo:\n- Move `smoke` to `[self-hosted, Linux, X64, bb-linux]`, running "
+    "pods/linux/tools/smoke_test.sh inside a privileged ubuntu:24.04 container booted with /sbin/init "
+    "(the script header says it supports this). Must not install/purge packages on the runner host "
+    "itself; clean up the container always.\n- Check the bb-linux runners (metta0*/metta1*) can run "
+    "privileged docker; if not, pick another self-hosted option and say why.\n\nAcceptance:\n- PR "
+    "merged to main (standing approval) with CI green.\n- A real linux-pod-release run "
+    "(workflow_dispatch or rerun of an existing release) shows `smoke` executing on a self-hosted "
+    "runner and passing; link the run.\n- `grep -rn runs-on .github/workflows` shows no GitHub-hosted "
+    "labels left.")
+
+
+def test_myapp_title_with_linux_ci_only_work_goes_to_the_target():
+    d = decide({"title": BB_LINUX_CI_TITLE, "body": BB_LINUX_CI_BODY, "assignee": "default",
+                "requires": ["terminal", "file", "git", "kanban"]}, carries=True)
+    assert d["where"] == "hub", d
+    d = decide({"title": "Baby Bear: linux pod OTA fails on ubuntu runners", "body": "x"})
+    assert d["where"] == "hub", d
+
+
+@pytest.mark.parametrize("title,body", [
+    # Apple-only work under a Baby Bear title stays here even when Linux is also named.
+    ("myapp: Xcode archive fails after linux-pod-release split", "runs-on: [self-hosted, Linux]"),
+    ("myapp: iOS app crashes in the simulator", "Linux pods are fine."),
+    ("myapp: TestFlight upload stuck", "The linux-pod-release workflow is green."),
+    ("myapp: release signing identity expired", "docker smoke on ubuntu passes; signing identity "
+                                                   "for the iOS app expired"),
+    ("myapp: macOS client release", ".github/workflows/linux-pod-release.yml is unaffected"),
+    ("myapp: provisioning profile for the iPhone build", "ubuntu runners unaffected"),
+    # Review counterexamples: Mac CI on self-hosted runners and Mac-client work.
+    ("myapp: xcodebuild archive fails on self-hosted runner",
+     "runs-on: [self-hosted, bb-mac]; xcodebuild -scheme BabyBear archive; linux jobs green"),
+    ("myapp: fix fastlane match step", "linux runners fine; fastlane match + xcrun altool"),
+    ("Baby Bear: Mac app wake word broken", "linux pods are fine; only the Mac client"),
+    ("myapp: CoreML model in the watch app", "docker image for training on linux is fine"),
+    # A device reached through the mini.
+    ("Baby Bear: restart the pod runtime on the mini", "the linux pods are behind the mini"),
+    # No Linux evidence at all: the product title still pins (unchanged).
+    ("Baby Bear voice listening regressed", "x"),
+])
+def test_myapp_title_with_apple_or_device_work_stays_local(title, body):
+    d = decide({"title": title, "body": body})
+    assert d["where"] == "local" and d["why"].startswith("local marker"), d
+
+
+def test_replaced_marker_list_keeps_product_name_pinning():
+    # A caller who replaces local_markers owns the list: no Linux-context exemption is applied.
+    cfg = {**ROUTE, "local_markers": [kp.BABYBEAR_MARKER]}
+    d = decide({"title": BB_LINUX_CI_TITLE, "body": BB_LINUX_CI_BODY}, cfg=cfg)
+    assert d["where"] == "local", d
+
+
 def test_macos_ci_runner_labels_do_not_pin_the_card():
     d = decide({"title": "Move hermes-state CI to GitHub-hosted runners",
                 "body": "runs-on: macos-latest; see .github/workflows/hermes-state-macos.yml"})
-- 
