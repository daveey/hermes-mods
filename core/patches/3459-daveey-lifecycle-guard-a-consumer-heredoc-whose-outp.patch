From 3517fbe8d61bdeb488c75a33b84980c72ccff15c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:03:02 +0000
Subject: [PATCH] [daveey] lifecycle guard: a consumer heredoc whose output a
 shell runs is not data (review 5888336995 nit 3)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

`python3 - <<'PY' | bash` printing `bash /x/huge.sh` runs that script, but the
guard treated the printed path as a mention: either the consumer body was masked
(`f() { python3 - <<'PY' … }; f | bash` under nested=True, `( … ) | bash`,
`{ cat <<'PY' … } | bash`, `o=$( … ); eval "$o"`), or the path sat inside an
interpreter string literal the walk never reads as a command. An oversized
script named there was allowed instead of failing closed. Same on main before
and after #1671 (pre-existing gap).

Fix:
- tools/shell_heredoc.py: `output_reaches_shell()` recognises shapes that run
  some command's output as shell code (`| [wrappers] bash|sh|sudo bash|ssh h`,
  `eval`, `. <(…)`/`source /dev/stdin`, `bash <(…)`/`<<<`, `sh -c "$(…)"`,
  `$(…)` as a command word). `strip_inert_heredoc_bodies` masks nothing when one
  is present (both views), so the direct text scan sees a printed restart too.
- cron/lifecycle_guard.py: with such a sink, every quoted string literal in the
  walked text is recursed as an executed command (`print('bash /x/huge.sh')`
  -> fail closed on the scan cap). Without a sink nothing changes: data mentions
  (`connect('/d/big.db')`, `| grep`, `|| true`, `o=$(…); echo`) stay allowed.

Corpus: new generator family `s_position == "sink"` in
tests/cron/heredoc_shape_corpus.py: 7 sinks (`| bash`, `| sh -s`, `| sudo bash`,
`| ssh h bash`, `eval "$(…)"`, `bash <(…)`, `. <(…)`) x 7 stdin wrappers x 6
nestings (plain, function, subshell, group, outer bash -s, ssh 'bash -s') x 2
consumers (python3 print, cat) x 2 printed lines (`bash ./big.sh` over the scan
cap, the restart) = 1176 cases, real bash runs each (fake sudo added). Property
for the family: bash ran it => tree refuses (main allows most). The sample
covers every sink x nesting x consumer x line and every wrapper per sink and
nesting. main_verdicts.json regenerated with the CLI against the same pre-#1671
baseline da52aff8f4 (18586 cases; the 18 old allows kept, 626 sink allows added).

Proof:
- `heredoc_shape_corpus.py report --full`: cases=18586 bash_ran=3428 violations=0
- sink family alone: 1176 ran, 1176 refused; mutant keeping consumer bodies
  masked under a sink: 546 violations; mutant with sink detection off: 854
- tests/cron/test_lifecycle_guard_output_sink.py pins both reviewer repros
  (unsafe True, refusal names the scan cap), the other sinks, allowed controls,
  and a corpus mutant check
- tests/cron + every tests/tools, tests/hermes_cli file importing the guard or
  shell_heredoc: 2702 passed, 0 failed
---
 cron/lifecycle_guard.py                       |  30 +-
 .../main_verdicts.json                        | 632 +++++++++++++++++-
 tests/cron/heredoc_shape_corpus.py            |  71 +-
 .../cron/test_lifecycle_guard_heredoc_walk.py |   8 +
 .../cron/test_lifecycle_guard_output_sink.py  | 116 ++++
 tools/shell_heredoc.py                        |  26 +
 6 files changed, 873 insertions(+), 10 deletions(-)
 create mode 100644 tests/cron/test_lifecycle_guard_output_sink.py

diff --git a/cron/lifecycle_guard.py b/cron/lifecycle_guard.py
index 5f438e0d98..23c7edb6e6 100644
--- a/cron/lifecycle_guard.py
+++ b/cron/lifecycle_guard.py
@@ -9,6 +9,7 @@ anchored on concrete command identifiers — so they cannot fire on prose. Defen
 
 from __future__ import annotations
 
+import itertools
 import logging
 import os
 import re
@@ -1186,6 +1187,29 @@ def _iter_shell_command_payloads(command: str) -> Iterator[str]:
                 break
 
 
+# Quoted string literals (shell or interpreter quoting alike), each kind on its own; a literal may
+# span lines (`eval "$( cat <<'PY'` … `)"`).
+_QUOTED_LITERAL_RES = (re.compile(r"'([^']+)'"), re.compile(r"\"([^\"]+)\""))
+
+
+def _iter_printed_shell_payloads(command: str) -> Iterator[str]:
+    """When some output in *command* is run as shell code (``python3 - <<'PY' | bash``,
+    ``eval "$(…)"``, ``bash <(…)``), yield every quoted string literal in it: the producer may
+    print one as the shell's command (``print('bash /x/big.sh')``), so its paths are executed,
+    not mentions. Single and double quotes are matched independently, so a literal nested in the
+    other kind (``python3 -c "print('bash x')"``) is yielded too."""
+    from tools.shell_heredoc import output_reaches_shell
+
+    if not output_reaches_shell(command):
+        return
+    seen: set[str] = set()
+    for pattern in _QUOTED_LITERAL_RES:
+        for match in pattern.finditer(command):
+            if match[1] not in seen:
+                seen.add(match[1])
+                yield match[1]
+
+
 # --- referenced-script reading ----------------------------------------------------------------
 
 def _has_binary_magic(data: bytes) -> bool:
@@ -1414,8 +1438,10 @@ def _contains_unsafe_gateway_action(
     walk_command = (strip_inert_heredoc_bodies(command, nested=True) if budget.mask_heredocs
                     else command)
 
-    for payload in _iter_shell_command_payloads(walk_command):
-        # An `sh -c` payload is text of the same file (or command) it appears in.
+    for payload in itertools.chain(_iter_shell_command_payloads(walk_command),
+                                   _iter_printed_shell_payloads(walk_command)):
+        # An `sh -c` payload is text of the same file (or command) it appears in; so is a string
+        # an interpreter prints when its output is fed to a shell.
         if recurse(payload, cwd, executed, source):
             return True
 
