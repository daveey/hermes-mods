From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 22:43:44 +0000
Subject: [PATCH] [daveey] Validate rendered Kanban mandates and bounded
 provenance

Fix review6008621485: normalize inline Markdown in the validation view, recognize provider-only routing obligations without classifying API implementation and historical receipts as mandates, and remove only complete provenance comments before validating remaining text. Stored text and author exclusions remain unchanged.

Root happened: token-only matching and whole-line comment exemption left active restrictions unvalidated. Root not caught: no create/edit controls for inline route formatting, provider-only obligations or provenance suffixes. Reproduced unchanged review probe 2 passed/10 failed; final five whole files 125/0, earlier eleven importing/facade consumers 297/0, retries disabled; full static 21 checks green. Read-only seven-database compatibility delta 205706 distinct lines zero changed; this is not the required fleet inventory or deployment proof. All fleet delivery acceptance remains open.
---
 hermes_cli/kanban_model_neutral.py            | 24 +++++--
 tests/hermes_cli/test_kanban_text_review58.py | 67 +++++++++++++++++++
 2 files changed, 87 insertions(+), 4 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_text_review58.py

diff --git a/hermes_cli/kanban_model_neutral.py b/hermes_cli/kanban_model_neutral.py
index a011189533..8ff72aab93 100644
--- a/hermes_cli/kanban_model_neutral.py
+++ b/hermes_cli/kanban_model_neutral.py
@@ -9,6 +9,7 @@ from __future__ import annotations
 import json
 import re
 from agent.model_routing import is_class_selector
+from hermes_cli.models_catalog_static import _PROVIDER_MODELS
 
 ERROR = 'Kanban is model-neutral: use a class/tier or capability requirement, not a concrete model/provider or mandatory pin'
 # Match directives, not incidental named execution evidence or author exclusions.
@@ -38,6 +39,19 @@ _DIRECTIVE = re.compile(
     + r'|' + _ROUTE_NAME + r'(?:/[\w-]+)?\s+(?:(?:review\s+|is\s+)?(?:required|mandatory|only)\b|must\s+be\s+used\b)',
     re.IGNORECASE,
 )
+# Provider identities are routing restrictions only in an obligation's route slot,
+# not incidental provider/API implementation work.
+_PROVIDER_NAME = r'\b(?:' + '|'.join(re.escape(p) for p in sorted(_PROVIDER_MODELS, key=lambda p: (-len(p), p))) + r')\b'
+_PROVIDER_DIRECTIVE = re.compile(
+    r'(?:\b(?:must|require|requires|required|mandatory|no fallback for)\s+'
+    r'|(?:^|:)\s*(?:[-*]\s*)?(?:use|pin|restrict|select only|choose only)\s+)'
+    + _QUALIFIER + _PROVIDER_NAME
+    + r'(?:\s+(?:provider|route|reviewer))?(?=\s*(?:[.!?;,]|$|for (?:this|the) (?:review|task|card|run)\b))'
+    + r'|(?:^|:)\s*' + _PROVIDER_NAME + r'\s+(?:(?:provider|route|reviewer)\s+)?'
+    r'(?:(?:is\s+)?(?:required|mandatory|only)|must\s+be\s+used)'
+    r'(?=\s*(?:[.!?;,]|$|for (?:this|the) (?:review|task|card|run)\b))',
+    re.IGNORECASE,
+)
 _EVIDENCE = 'Historical run instruction (superseded and not active): '
 _TEXT_GUIDANCE = ('; for superseded historical evidence only, put the unchanged line in a JSON string after '
                   + _EVIDENCE + '(do not quote active instructions)')
@@ -88,8 +102,10 @@ def validate_text(*values):
             line = _active_text(line)
             if _REQUIRED.search(line):
                 raise ValueError(f'{ERROR}; refused line: {line}{_TEXT_GUIDANCE}')
-            if line.lstrip().startswith('<!-- implementer-models:'):
-                continue
+            # Comments carry authorship, not authority over text after their end.
+            line = re.sub(r'<!-- implementer-models:.*?-->', '', line)
+            # Inspect rendered inline identities, retaining the original stored bytes.
+            line = re.sub(r'(`+|\*\*|__|\*|_)(.+?)\1', r'\2', line)
             for clause in re.split(r'(?<=[.!?;])\s+', line):
                 clause = _NEGATED_OBLIGATION.sub('optional', clause)
                 clause = _REMOVED_OBLIGATION.sub(r'\1mentions', clause)
@@ -97,7 +113,7 @@ def validate_text(*values):
                 # mandate ("...unavailable; use only <model>" still refuses).
                 clause = re.sub(r'\bPinned route\s+' + _ROUTE_NAME + r'\s+is unavailable\b',
                                 'Observed unavailable route', clause, flags=re.IGNORECASE)
-                if not _MODEL.search(clause):
+                if not (_MODEL.search(clause) or _PROVIDER_DIRECTIVE.search(clause)):
                     continue
                 # Mask only negative/exclusion wording up to a new positive
                 # obligation, never the rest of a clause containing that mandate.
@@ -126,7 +142,7 @@ def validate_text(*values):
                     r'\b(?:needs?|requires?|must get)\s+(?:a\s+)?(?:fresh\s+)?'
                     r'(?:independent\s+)?review\s*\(\s*' + _ROUTE_NAME,
                     clause, re.IGNORECASE)
-                if _DIRECTIVE.search(clause) or named_review or required_review:
+                if _DIRECTIVE.search(clause) or _PROVIDER_DIRECTIVE.search(clause) or named_review or required_review:
                     raise ValueError(f'{ERROR}; refused line: {line}{_TEXT_GUIDANCE}')
 
 
diff --git a/tests/hermes_cli/test_kanban_text_review58.py b/tests/hermes_cli/test_kanban_text_review58.py
new file mode 100644
index 0000000000..808d388375
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_text_review58.py
@@ -0,0 +1,67 @@
+"""Independent review: active restrictions at common mutation boundaries."""
+import pytest
+from hermes_cli import kanban_db as kb
+from tests.hermes_cli import test_kanban_managed_pin_policy as support
+
+board = support.board
+
+@pytest.mark.parametrize('body', [
+    'Must use opus',
+    'Must use `opus`',
+    'Must use **opus**',
+    'Must use anthropic',
+    'Use only the anthropic provider.',
+    '<!-- implementer-models: sonnet --> Must use opus',
+    'Must use *opus*',
+    'Must use __opus__',
+    'Must use ``claude-opus-5-5``',
+    'Must use **anthropic**',
+    'Use only the openai-codex provider.',
+    'anthropic provider is required.',
+    '<!-- implementer-models: opus --> <!-- implementer-models: sonnet --> Must use `opus`',
+    'Do not restrict to anthropic; Must use `opus`',
+])
+@pytest.mark.parametrize('entry', ['create', 'edit'])
+def test_active_restriction_refuses_without_write(board, body, entry):
+    conn, _ = board
+    tid = kb.create_task(conn, title='Review fixture', body='Neutral work', assignee='worker')
+    before = conn.execute('SELECT count(*) FROM tasks').fetchone()[0]
+    with pytest.raises(ValueError, match='model-neutral'):
+        if entry == 'create':
+            kb.create_task(conn, title='New work', body=body, assignee='worker')
+        else:
+            kb.edit_task(conn, tid, body=body)
+    assert conn.execute('SELECT count(*) FROM tasks').fetchone()[0] == before
+    assert kb.get_task(conn, tid).body == 'Neutral work'
+
+
+@pytest.mark.parametrize('body', [
+    '<!-- implementer-models: sonnet -->',
+    '<!-- implementer-models: opus --> Preserve independent execution.',
+    'Implement the anthropic provider. Required CI must pass.',
+    'The xai-oauth route only emits declared keys. Confirm the mechanism first.',
+    'The wall file now lists openai-codex only. Anthropic serves.',
+    'Gemini only if its key is subscription-funded (verify funding; metered API = skip and say so).',
+    'The only rule covers xAI only (the runbook).',
+    'Checked: routing_inventory.py executed; xai-oauth only on the laptop.',
+    'This is the second time: the xAI case was fixed for xAI only.',
+    'Scenario: config.yaml model.default; choose Anthropic; click sign in; then dismiss.',
+    'Must use anthropic API headers for the authentication probe.',
+    'Use only the anthropic provider fixture for this unit test.',
+    'The completed review used `opus`; required CI passed.',
+    'No longer requires **opus**.',
+    'Do not restrict to anthropic.',
+    'This review does not require anthropic.',
+    'Historical run instruction (superseded and not active): "Must use **opus**"',
+    'Historical run instruction (superseded and not active): "Use only the anthropic provider."',
+])
+@pytest.mark.parametrize('entry', ['create', 'edit'])
+def test_nonmandate_text_retained_unchanged(board, body, entry):
+    conn, _ = board
+    tid = kb.create_task(conn, title='Neutral fixture', body='Neutral work', assignee='worker')
+    if entry == 'create':
+        tid = kb.create_task(conn, title='Provider implementation', body=body, assignee='worker')
+    else:
+        assert kb.edit_task(conn, tid, body=body)
+    assert kb.get_task(conn, tid).body == body
+
