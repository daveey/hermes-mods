From 5cb009151c08778971c959b7d3f284e7efd09ee0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 23:15:21 +0000
Subject: [PATCH] ci(flaky_kanban): Deflake card is done when the PR is merged
 and green on main, not when the PR opens

---
 scripts/ci/flaky_kanban.py    | 9 +++++++++
 tests/ci/test_flaky_kanban.py | 7 +++++++
 2 files changed, 16 insertions(+)

diff --git a/scripts/ci/flaky_kanban.py b/scripts/ci/flaky_kanban.py
index 1b90788d756..9ea37020314 100644
--- a/scripts/ci/flaky_kanban.py
+++ b/scripts/ci/flaky_kanban.py
@@ -231,6 +231,9 @@ def save_state(path: Path, state: dict[str, Any]) -> None:
     tmp.replace(path)
 
 
+DONE_WHEN = "Done when the PR is merged to main and the test passes on main's next CI run."
+
+
 def _card_body(entry: dict[str, str], run_url: str, branch: str, previous: str | None) -> str:
     excerpt = (entry.get("first_attempt_excerpt") or "")[-EXCERPT_LIMIT:]
     lines = [
@@ -243,6 +246,12 @@ def _card_body(entry: dict[str, str], run_url: str, branch: str, previous: str |
         "lease) that a CPU-throttled container misses. Wait on events or use generous timeouts that return",
         "as soon as the condition holds. Reproduce by starving the process (SIGSTOP/SIGCONT duty cycle) rather",
         "than on a quiet laptop.",
+        "",
+        DONE_WHEN,
+        "Opening a PR is not done. Once the PR is open, stay on the card: kanban_block(kind='dependency'/",
+        "'time') or kanban_continue until the PR is merged (merge it yourself once its required checks are",
+        "green on the current head), then confirm the test passes on main's next CI run. Do not call",
+        "kanban_complete while the PR is open.",
     ]
     if previous:
         lines += ["", f"An earlier deflake card {previous} was closed, but the test flaked again."]
diff --git a/tests/ci/test_flaky_kanban.py b/tests/ci/test_flaky_kanban.py
index f7e0d357316..3bacd6bf6d0 100644
--- a/tests/ci/test_flaky_kanban.py
+++ b/tests/ci/test_flaky_kanban.py
@@ -370,3 +370,10 @@ def test_flaky_test_passes_and_files_a_card_while_a_hard_failure_stays_red(tmp_p
         [sys.executable, "-m", "hermes_cli.main", "kanban", "show", cards[0]["id"], "--json"],
         capture_output=True, text=True, timeout=120, check=True, cwd=_ROOT).stdout)
     assert any("https://ci/run/2" in c["body"] for c in shown["comments"])
+
+
+def test_card_body_requires_merge_before_done():
+    """A deflake card is done when the fix is merged and green on main, not when a PR is opened."""
+    body = fk._card_body({"test_id": "tests/x.py::test_a", "first_attempt_excerpt": "boom"}, "https://r/1", "main", None)
+    assert "Done when the PR is merged to main and the test passes on main's next CI run." in body
+    assert "Do not call\nkanban_complete while the PR is open." in body
-- 
2.55.0

