+def _fetch_jobs(repo: str, run_id: str) -> dict:
+    """The run's jobs from the GitHub API through ``gh``. Raises on any failure."""
+    return _gh_api(f"repos/{repo}/actions/runs/{run_id}/jobs?per_page=100")
