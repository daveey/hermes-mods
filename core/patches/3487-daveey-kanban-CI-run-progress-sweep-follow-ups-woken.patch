+def _record_scans(monkeypatch) -> list[threading.Thread]:
+    seen: list[threading.Thread] = []
+    real = kcp._ci_waits
+
+    def scan(conn):
+        seen.append(threading.current_thread())
+        return real(conn)
+
+    monkeypatch.setattr(kcp, "_ci_waits", scan)
+    return seen
+
