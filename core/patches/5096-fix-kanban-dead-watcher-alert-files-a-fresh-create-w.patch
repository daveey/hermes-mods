From 4f19bf57f321ea33560845be2d50673faa3d9fa0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 09:21:07 +0000
Subject: [PATCH] fix(kanban): dead-watcher alert files a fresh create when the
 first create ended rejected/expired/failed [daveey]

---
 hermes_cli/kanban_sync_watcher_alert.py            | 12 +++++++++++-
 tests/hermes_cli/test_kanban_sync_watcher_alert.py | 13 +++++++++++++
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_sync_watcher_alert.py b/hermes_cli/kanban_sync_watcher_alert.py
index 532af72d8d..bac75c064c 100644
--- a/hermes_cli/kanban_sync_watcher_alert.py
+++ b/hermes_cli/kanban_sync_watcher_alert.py
@@ -102,6 +102,15 @@ def _replica_rows(hub_cli: str, runner) -> list[dict]:
     return [r for r in rows if isinstance(r, dict)]
 
 
+def _create_failed(request_id: str) -> bool:
+    """True when the courier ended the create as rejected/expired/failed: no card will ever exist for it."""
+    try:
+        from hermes_cli import kanban_placement as kp
+        return kp.remote_state(request_id) in kp.FAILED_STATES
+    except Exception:  # health: allow BLE001 -- an unreadable courier db means "not known yet"
+        return False
+
+
 def _open_card(host: str, state: dict, hub_cli: str, runner, now: float) -> Optional[str]:
     prefix = f"{KEY_PREFIX}:{host}:"
     rows = _replica_rows(hub_cli, runner)
@@ -123,7 +132,8 @@ def _open_card(host: str, state: dict, hub_cli: str, runner, now: float) -> Opti
         if now - float(state.get("filed_at") or 0) < _FRESH_S:
             return str(tid)
     elif (state.get("request_id") and now - float(state.get("filed_at") or 0) < _FRESH_S
-          and not any(r.get("idempotency_key") == state["request_id"] for r in rows)):
+          and not any(r.get("idempotency_key") == state["request_id"] for r in rows)
+          and not _create_failed(state["request_id"])):
         # The first create is queued but neither the courier nor the replica knows its card yet. That is
         # "unknown", not "no open card": a second create would carry a different request id and could
         # file a duplicate card once delivery catches up.
diff --git a/tests/hermes_cli/test_kanban_sync_watcher_alert.py b/tests/hermes_cli/test_kanban_sync_watcher_alert.py
index a6c7918af2..19cd45fc64 100644
--- a/tests/hermes_cli/test_kanban_sync_watcher_alert.py
+++ b/tests/hermes_cli/test_kanban_sync_watcher_alert.py
@@ -286,3 +286,16 @@ def test_an_unresolved_create_older_than_six_hours_is_not_waited_on_forever(home
     _crash(since=later)
     assert _check(hub, later + 300) == f"kanban-sync-watcher-dead:worker-1:{int(later)}"
     assert len(hub.sent("create-task")) == 2
+
+
+def test_a_create_the_courier_rejected_is_not_waited_on(home, monkeypatch):
+    from hermes_cli import kanban_placement as kp
+    _crash()
+    hub = FakeHubCli()
+    _check(hub, SINCE + 300)
+    _round_completed()
+    _check(hub, 1_900.0)
+    monkeypatch.setattr(kp, "remote_state", lambda rid: "rejected")
+    _crash(since=2_000.0)
+    assert _check(hub, 2_300.0) == "kanban-sync-watcher-dead:worker-1:2000"
+    assert len(hub.sent("create-task")) == 2
-- 
2.43.0

