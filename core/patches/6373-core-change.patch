Subject: [PATCH 6373] Durable send outcomes and accurate composer recovery

Public mirror of source commit a28d18f82c93adde03d725cbe85b37723c941dd1.

---
diff --git a/apps/desktop/src/app/session/hooks/use-prompt-actions/submission-outcome-read-failure.test.ts b/apps/desktop/src/app/session/hooks/use-prompt-actions/submission-outcome-read-failure.test.ts
new file mode 100644
index 00000000000..a270494cbad
--- /dev/null
+++ b/apps/desktop/src/app/session/hooks/use-prompt-actions/submission-outcome-read-failure.test.ts
@@ -0,0 +1,42 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+import * as journal from './prepared-submissions'
+import type { PreparedSubmission } from './prepared-submissions'
+import { clearStoredJournal, storedJournal } from './prepared-submissions-test-utils'
+import { submissionAborted, submissionFailed, writeInFlightSubmission } from './submission-outcome'
+
+vi.mock('./prepared-submissions', async importOriginal => {
+  const actual = await importOriginal<typeof journal>()
+
+  return { ...actual, readPreparedSubmission: vi.fn(actual.readPreparedSubmission) }
+})
+
+const entry = (): PreparedSubmission => ({ id: 'sub-1', owner: null as never, attachments: [], text: 'hello', params: {} })
+const definite = () => true
+
+beforeEach(() => clearStoredJournal())
+
+describe('the in-flight write when the journal cannot be read', () => {
+  it('keeps an earlier unknown attempt from the retained entry it holds, so a later abort stays unknown', async () => {
+    const first = entry()
+    await writeInFlightSubmission('k', first)
+    await submissionFailed('k', first, new Error('request timed out'), { definite: () => false, replayUncertain: false })
+
+    // The retry holds the retained entry as adopted; reading the journal again now fails.
+    const retry = { ...storedJournal().k }
+    vi.mocked(journal.readPreparedSubmission).mockRejectedValueOnce(new Error('EIO: journal unreadable'))
+    await writeInFlightSubmission('k', retry)
+    await submissionAborted('k', retry, () => false)
+
+    expect(storedJournal().k.outcome).toBe('unknown')
+  })
+
+  it('a fresh send (nothing retained) is not made unknown by the failed read', async () => {
+    const fresh = entry()
+    vi.mocked(journal.readPreparedSubmission).mockRejectedValueOnce(new Error('EIO: journal unreadable'))
+    await writeInFlightSubmission('k', fresh)
+    await submissionFailed('k', fresh, new Error('refused'), { definite, replayUncertain: false })
+
+    expect(storedJournal().k.outcome).toBe('refused')
+  })
+})
diff --git a/apps/desktop/src/app/session/hooks/use-prompt-actions/submission-outcome.ts b/apps/desktop/src/app/session/hooks/use-prompt-actions/submission-outcome.ts
index b112dc76ecc..90a2d1f45e8 100644
--- a/apps/desktop/src/app/session/hooks/use-prompt-actions/submission-outcome.ts
+++ b/apps/desktop/src/app/session/hooks/use-prompt-actions/submission-outcome.ts
@@ -19,7 +19,10 @@
  *  attempt of the same send journaled under `key` that ended unknown (or never recorded an end) stays
  *  counted: `earlierUnknown` keeps every later outcome `unknown`. */
 export async function writeInFlightSubmission(key: string, entry: PreparedSubmission): Promise<void> {
-  const earlier = await readPreparedSubmission(key).catch(() => undefined)
+  // A journal that cannot be read falls back to what this window holds: the retained entry it adopted
+  // carries the outcome recorded for the earlier attempts (a fresh send carries none).
+  const earlier = await readPreparedSubmission(key).catch(() =>
+    entry.earlierUnknown || entry.outcome === 'unknown' ? entry : undefined)
 
   if (earlier?.id === entry.id && (earlier.earlierUnknown || sendUnconfirmed(earlier))) {
     entry.earlierUnknown = true
