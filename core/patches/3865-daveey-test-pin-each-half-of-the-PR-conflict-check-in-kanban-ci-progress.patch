From e8de46dc1d4c630397e0eb84d13f96c073321942 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 21:14:48 +0000
Subject: [PATCH] [daveey] test: pin each half of the PR conflict check in
 kanban_ci_progress

pr_progress treats a PR as conflicting when `mergeable is False or
mergeable_state == "dirty"`. Every conflicting fixture set both fields
together, so mutation sweep-1930 A (post-merge check of PR #2572) found
that dropping either half survived both test files (M5b2: only the
`dirty` half; M5b3: only `mergeable is False`). GitHub does report them
apart: the live proof's first read of PR #2149 gave mergeable=None
mergeable_state=unknown while `gh pr list` showed it CONFLICTING/DIRTY.

Parametrise the park-refusal and sweep-wake conflict tests over
(False, "dirty"), (False, "unknown") and (None, "dirty"). Tests only.

Proof (scripts/run_tests.sh, worker-4):
- main source: test_kanban_ci_progress_pr.py 30 passed (was 26),
  test_kanban_ci_progress.py 78 passed, 0 skipped.
- M5b2 source: exactly the 2 [mergeable_false] params fail.
- M5b3 source: exactly the 2 [state_dirty] params fail.

Card: t_01a1d6bb80533435
---
 .../hermes_cli/test_kanban_ci_progress_pr.py  | 21 ++++++++++++-------
 1 file changed, 14 insertions(+), 7 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_ci_progress_pr.py b/tests/hermes_cli/test_kanban_ci_progress_pr.py
index bf068c9bf4..3b5cc18641 100644
--- a/tests/hermes_cli/test_kanban_ci_progress_pr.py
+++ b/tests/hermes_cli/test_kanban_ci_progress_pr.py
@@ -30,6 +30,10 @@ BASE = "aaaf75adb60000000000000000000000000000cd"
 REF = f"https://github.com/{REPO}/pull/{PR} checks @{HEAD}"  # verbatim from the incident's park
 RUN_ID = "43400000001"
 LABELS = ["self-hosted", "ci-fast"]
+# GitHub can report a conflict in either field while the other is still settling (PR #2149's first read gave
+# mergeable=None mergeable_state=unknown while gh pr list showed it CONFLICTING/DIRTY), so each half must count.
+CONFLICTS = pytest.mark.parametrize("mergeable,state", [(False, "dirty"), (False, "unknown"), (None, "dirty")],
+                                    ids=["both", "mergeable_false", "state_dirty"])
 
 
 def _iso(age: int) -> str:
@@ -64,8 +68,8 @@ class Api:
         self.fail = False
         self.calls: list[str] = []
 
-    def dirty(self) -> None:
-        self.pr.update(mergeable=False, mergeable_state="dirty")
+    def dirty(self, mergeable: bool | None = False, state: str = "dirty") -> None:
+        self.pr.update(mergeable=mergeable, mergeable_state=state)
 
     def run(self, status: str, *, age: int, runner: str | None = None) -> None:
         self.runs = [{"id": int(RUN_ID), "status": status, "event": "pull_request", "head_sha": HEAD,
@@ -166,8 +170,10 @@ def test_pr_target(ref, hint, want) -> None:
 
 # --- a. park time -------------------------------------------------------------------------------------------------
 
-def test_park_on_a_conflicting_pr_is_refused_naming_the_pr_and_rebase(kanban_home, api, monkeypatch) -> None:
-    api.dirty()
+@CONFLICTS
+def test_park_on_a_conflicting_pr_is_refused_naming_the_pr_and_rebase(kanban_home, api, monkeypatch, mergeable,
+                                                                      state) -> None:
+    api.dirty(mergeable, state)
     with kbc.connect_closing() as conn:
         tid = _running(conn)
         out = _park(monkeypatch, conn, tid)
@@ -186,12 +192,13 @@ def test_park_on_a_fresh_head_with_no_runs_yet_is_allowed(kanban_home, api, monk
 
 # --- b. the PR turns dirty while parked ---------------------------------------------------------------------------
 
-def test_sweep_wakes_a_card_whose_pr_turns_dirty_once_and_asserts_no_runner_blocker(kanban_home, api,
-                                                                                     monkeypatch) -> None:
+@CONFLICTS
+def test_sweep_wakes_a_card_whose_pr_turns_dirty_once_and_asserts_no_runner_blocker(kanban_home, api, monkeypatch,
+                                                                                     mergeable, state) -> None:
     api.run("in_progress", age=60, runner="ci-fast-1")
     with kbc.connect_closing() as conn:
         tid = _parked(conn, monkeypatch)
-        api.dirty()
+        api.dirty(mergeable, state)
         assert kcp.sweep(conn) == [tid]
         assert kb.get_task(conn, tid).status == "ready"
         notes = _notes(conn, tid)
