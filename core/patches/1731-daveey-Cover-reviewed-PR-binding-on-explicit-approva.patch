From f3e6cc37a108db1e0ef35292c65cc7f8bb70095e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 19:15:18 +0000
Subject: [PATCH] [daveey] Cover reviewed PR binding on explicit approval paths

---
 hermes_cli/kanban_dependency_review.py                      | 6 +++---
 .../hermes_cli/test_kanban_dependency_review_no_verdict.py  | 5 +++--
 2 files changed, 6 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_dependency_review.py b/hermes_cli/kanban_dependency_review.py
index 4586b62aa6c..8519a805f42 100644
--- a/hermes_cli/kanban_dependency_review.py
+++ b/hermes_cli/kanban_dependency_review.py
@@ -170,9 +170,9 @@ def _reviewed_prs(conn, parent_id, parked_at, owner_run_id, captured: set[str])
 def _approval_prs(conn, parent_id, parked_at, owner_run_id, captured: set[str]) -> set[str]:
     """PRs an exact-head approval authorizes, or empty.
 
-    A named ``pr`` is the only PR that approval covers. With no ``pr``, the
-    authenticated checkpoint is the binding: the review did not name a
-    different head. A short ``head`` is not exact.
+    A named ``pr`` (or ``reviewed_pr`` fallback) is the only PR that approval
+    covers. With neither key, the authenticated checkpoint supplies the PR scope.
+    A short ``head`` is not exact.
     """
     from hermes_cli import kanban_db as kb
 
diff --git a/tests/hermes_cli/test_kanban_dependency_review_no_verdict.py b/tests/hermes_cli/test_kanban_dependency_review_no_verdict.py
index 5318eec770d..ddecee01939 100644
--- a/tests/hermes_cli/test_kanban_dependency_review_no_verdict.py
+++ b/tests/hermes_cli/test_kanban_dependency_review_no_verdict.py
@@ -50,9 +50,10 @@ def test_unrecognised_verdict_is_repair_not_approval(board, monkeypatch, extra,
     assert dispatch.check_respawn_guard(board, task) is None
 
 
+@pytest.mark.parametrize("verdict", [None, "approve", "approved"])
 @pytest.mark.parametrize("named", [PR, "https://github.com/daveey/hermes/pull/999"])
-def test_reviewed_pr_binds_without_summary_number(board, monkeypatch, named):
-    task, _ = incident(board, monkeypatch, metadata={"reviewed_sha": SHA, "reviewed_pr": named},
+def test_reviewed_pr_binds_without_summary_number(board, monkeypatch, named, verdict):
+    task, _ = incident(board, monkeypatch, metadata={"reviewed_sha": SHA, "reviewed_pr": named, "verdict": verdict},
                        summary="No blocking defects")
     assert dispatch.check_respawn_guard(board, task) == (None if named == PR else "active_pr")
 
-- 
