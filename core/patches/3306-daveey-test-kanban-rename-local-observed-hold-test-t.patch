From 5ed54700ea72f3887f2b49ddf296fddd251e9766 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 08:58:37 +0000
Subject: [PATCH] [daveey] test(kanban): rename local observed-hold test to the
 hold-after-latest-boundary rule

Follow-up to #2012 review (t_01a1d413105c0624): the 'parked' case now covers a
hold seen before a later park, so 'requires_ready_boundary' no longer described
the rule. Test-only rename; 19/19 pass in test_kanban_observed_pr_hold_boundaries.py.
---
 tests/hermes_cli/test_kanban_observed_pr_hold_boundaries.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_observed_pr_hold_boundaries.py b/tests/hermes_cli/test_kanban_observed_pr_hold_boundaries.py
index a4637e2538..4353a66006 100644
--- a/tests/hermes_cli/test_kanban_observed_pr_hold_boundaries.py
+++ b/tests/hermes_cli/test_kanban_observed_pr_hold_boundaries.py
@@ -47,7 +47,7 @@ def test_fresh_replica_must_match_home_episode(stores, monkeypatch, case):
 
 @pytest.mark.parametrize("case", ["no_boundary", "bad_clock", "diagnostic", "wrong_reason", "before_boundary",
                                   "parked"])
-def test_local_observation_requires_ready_boundary(stores, monkeypatch, case):
+def test_local_observation_requires_a_hold_after_the_latest_boundary(stores, monkeypatch, case):
     home, _ = stores
     home.execute("INSERT INTO task_events VALUES (2,'task','respawn_guarded',"
                  "'2026-01-01T00:00:01Z','{\"reason\":\"active_pr\"}','hold')")
-- 
