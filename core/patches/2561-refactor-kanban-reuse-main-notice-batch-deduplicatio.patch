Subject: [PATCH] refactor(kanban): reuse main notice batch deduplication
 [daveey]

---
 hermes_cli/kanban_failure_notice.py | 13 -------------
 1 file changed, 13 deletions(-)

diff --git a/hermes_cli/kanban_failure_notice.py b/hermes_cli/kanban_failure_notice.py
index d6fe14cbf7..1ca4c67837 100644
--- a/hermes_cli/kanban_failure_notice.py
+++ b/hermes_cli/kanban_failure_notice.py
@@ -36,16 +36,3 @@ def fresh_events(events, delivered):
         if uid:
             seen.add(uid)
     return result
-
-
-def fresh_texts(batch, delivered):
-    """Deduplicate both persisted keys and repeats within one delivery batch."""
-    seen = set(delivered)
-    fresh = []
-    for text in batch:
-        keys = set(getattr(text, "_kb_keys", ()) or ())
-        if keys and keys <= seen:
-            continue
-        fresh.append(text)
-        seen.update(keys)
-    return fresh
