From 7813e50fa2c60bd34139f75ce8c76d47cfb78449 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 08:06:56 +0000
Subject: [PATCH] [daveey] execute_code: report truncated=True for a windowed
 terminal() output with no spill

Review t_01a1d3eb65cb70e2: without a readable full_output_path (managed_modal,
tool_host_artifacts off, a dropped spill handle, a suffix over the limit) the
window was reported truncated: False. Fall back to the truncation marker,
truncation_note and output_total_chars. Document that post-collection notes are
not carried when the spill replaces the window.
---
 ...est_code_execution_terminal_full_output.py | 11 ++++++++++
 tools/code_execution_rpc.py                   | 22 +++++++++++++++++--
 2 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/tests/tools/test_code_execution_terminal_full_output.py b/tests/tools/test_code_execution_terminal_full_output.py
index 0ae8184eee..291e87256e 100644
--- a/tests/tools/test_code_execution_terminal_full_output.py
+++ b/tests/tools/test_code_execution_terminal_full_output.py
@@ -101,6 +101,17 @@ def test_capped_spill_reports_truncated(tmp_path):
     assert r["truncated"] is True
 
 
+def test_window_without_spill_reports_truncated():
+    """managed_modal / artifacts off / dropped spill handle: no full_output_path, yet the
+    output is a cut window, so it must not be reported complete."""
+    window = "AAA\n\n... [OUTPUT TRUNCATED - 1,500 chars omitted out of 2,006 total] ...\n\nBBB"
+    r = _rpc({"output": window, "exit_code": 0, "error": None})
+    assert r["output"] == window
+    assert r["truncated"] is True
+    r = _rpc({"output": "short head", "exit_code": 0, "error": None, "output_total_chars": 50_074})
+    assert r["truncated"] is True
+
+
 def test_short_output_is_marked_complete():
     r = _rpc({"output": "hello", "exit_code": 0, "error": None})
     assert r["output"] == "hello"
diff --git a/tools/code_execution_rpc.py b/tools/code_execution_rpc.py
index b1cf85e6e3..7f9a088211 100644
--- a/tools/code_execution_rpc.py
+++ b/tools/code_execution_rpc.py
@@ -142,12 +142,28 @@ def _read_full_output(path) -> str | None:
     return None if _SPILL_CAPPED_MARK in text[-200:] else text.strip()
 
 
+def _looks_windowed(body: dict) -> bool:
+    """True when a terminal result's ``output`` is a cut window even though no spill file
+    came with it: it carries the truncation marker, or the reported total exceeds it."""
+    from tools.tool_output_truncate import contains_truncation_notice
+    output = body["output"]
+    total = body.get("output_total_chars")
+    if isinstance(total, int) and not isinstance(total, bool) and total > len(output):
+        return True
+    return bool(body.get("truncation_note")) or contains_truncation_notice(output)
+
+
 def _complete_terminal_output(result):
     """Give code the complete stdout of a sandbox ``terminal()`` call. The terminal tool
     renders a head+tail window sized for the chat; a script that writes ``output`` to disk
     as data must not get that window (defect agent-7ac9c5fa93: a checksum manifest shipped
     the truncation marker). The spill file is already ANSI-stripped and redacted by the
-    terminal tool. ``truncated`` tells the script whether ``output`` is whole."""
+    terminal tool. ``truncated`` tells the script whether ``output`` is whole: without a
+    readable spill (managed_modal, artifacts off, a failed spill redaction, a suffix that
+    pushed the text over the limit) a windowed ``output`` still reports ``truncated: True``.
+    When the spill replaces the window, notes the terminal tool appended after collection
+    (timeout/interrupt text, the sudo notice, a transform hook's rewrite) are not carried;
+    ``exit_code`` and ``exit_code_meaning`` still report a timeout or interrupt."""
     try:
         body = json.loads(result)
     except (TypeError, ValueError):
@@ -161,7 +177,9 @@ def _complete_terminal_output(result):
     if full is not None:
         body["output"] = full
         body.pop("truncation_note", None)
-    body["truncated"] = bool(spill_path) and full is None
+        body["truncated"] = False
+    else:
+        body["truncated"] = bool(spill_path) or _looks_windowed(body)
     return json.dumps(body, ensure_ascii=False)
 
 
-- 
2.51.0

