From d6aa991306d9a1d9926d0c414e64cd4932ffcf18 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 05:20:21 +0000
Subject: [PATCH] [daveey] Test that a gate without buffer attributes streams
 ordinary turns

needs_buffer() must default a missing legacy needs_buffer attribute to False. An audit mutant
(getattr(cb, "needs_buffer", True)) survived the landed tests from 3c0d856312: a pre_final_gate
callback that declares neither needs_buffer_for_session nor needs_buffer would buffer every
ordinary turn, so nothing streams until finalization.

The new test registers such a plain gate, drives a real ordinary turn through the stream sink and
asserts the reply reached the screen at emit time, with no buffer allocated.

Proof: canonical sdlc-review mutants.py, baseline 19 passed 0 skipped; mutant
getattr(cb, "needs_buffer", True) killed by exactly the new test (1 failed).
---
 tests/agent/test_session_final_buffer.py | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/tests/agent/test_session_final_buffer.py b/tests/agent/test_session_final_buffer.py
index a2d65acaa3..693c40a7df 100644
--- a/tests/agent/test_session_final_buffer.py
+++ b/tests/agent/test_session_final_buffer.py
@@ -201,6 +201,24 @@ def test_scope_exclusion_applies_before_predicate(agent, hooks, kind):
     assert calls == [{"session_id": agent.session_id}]
 
 
+def test_gate_without_buffer_attributes_streams_ordinary_turn(agent, hooks):
+    # A legacy gate that declares neither predicate nor needs_buffer must not
+    # buffer: the missing flag defaults to False, so ordinary text streams live.
+    seen = []
+
+    def plain_gate(session_id, turn_messages, **kwargs):
+        seen.append(session_id)  # no verdict: let the reply through
+
+    hooks._hooks["pre_final_gate"] = [plain_gate]
+    assert needs_buffer(agent) is False
+    run = Script(agent, ["Hello."])
+    result = agent.run_conversation("hello")
+    assert result["final_response"] == "Hello."
+    assert run.immediate == [["Hello."]]
+    assert agent._final_gate_buffer is None
+    assert seen  # the gate itself still ran at finalization
+
+
 def test_last_pre_hook_controls_buffer(agent, hooks):
     gate = hooks._hooks["pre_final_gate"][0]
     # Legacy dynamic gates are also armed after *all* hooks, not just the first.
