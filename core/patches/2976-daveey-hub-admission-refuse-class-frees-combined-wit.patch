From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 16:47:48 +0000
Subject: [PATCH] [daveey] hub admission: refuse --class/--frees combined with
 --requires (separate edit transaction)

Rebase onto main (edit_preflight from kanban_requires_edit) routes --requires
through its own transaction, which would silently drop admission metadata.
Refuse the combination like --completion-contract; test RED->GREEN.
---
 tests/hermes_cli/test_kanban_hub_admission.py | 1 +
 1 file changed, 1 insertion(+)

diff --git a/tests/hermes_cli/test_kanban_hub_admission.py b/tests/hermes_cli/test_kanban_hub_admission.py
index 97eb72ae44..1ee4a49077 100644
--- a/tests/hermes_cli/test_kanban_hub_admission.py
+++ b/tests/hermes_cli/test_kanban_hub_admission.py
@@ -717,6 +717,7 @@ def test_cli_edit_admission_metadata(board, monkeypatch):
 @pytest.mark.parametrize("options,reason", [
     (["--max-retries", "4"], "operator fields"),
     (["--completion-contract", "local-only", "--reason", "test"], "--completion-contract"),
+    (["--requires", "terminal"], "--requires"),
 ])
 def test_cli_admission_refuses_separate_transaction_edits(board, monkeypatch, capsys, options, reason):
     import argparse
