From 61a893a6ec9cae7665b750532b692d8438795e2b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 8 Nov 2026 17:12:02 +0000
Subject: [PATCH] [daveey] Preserve disk refresh exclusion with upstream queued
 scans

---
 .../contrib/runtime-loader-refresh.test.ts    | 35 ++++++++++++++++++-
 apps/desktop/src/contrib/runtime-loader.ts    |  3 +-
 2 files changed, 36 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/contrib/runtime-loader-refresh.test.ts b/apps/desktop/src/contrib/runtime-loader-refresh.test.ts
index 796f35c5548..de2fd8f3df2 100644
--- a/apps/desktop/src/contrib/runtime-loader-refresh.test.ts
+++ b/apps/desktop/src/contrib/runtime-loader-refresh.test.ts
@@ -6,7 +6,13 @@ import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
 
 import type { HermesReadDirResult } from '@/global'
 
-import { DISK_REFRESH_MS, refreshChangedDiskPlugins, unloadRuntimePlugin, watchRuntimePlugins } from './runtime-loader'
+import {
+  discoverRuntimePlugins,
+  DISK_REFRESH_MS,
+  refreshChangedDiskPlugins,
+  unloadRuntimePlugin,
+  watchRuntimePlugins
+} from './runtime-loader'
 
 const root = '/local/.hermes/desktop-plugins'
 const file = `${root}/linked/plugin.js`
@@ -155,4 +161,31 @@ describe('disk plugins: level-triggered refresh (missed fs events)', () => {
     expect(await refreshChangedDiskPlugins('test')).toEqual([])
     await vi.waitFor(() => expect(stopPreviewFileWatch).toHaveBeenCalled())
   })
+
+  it('a refresh tick while a scan is in flight is skipped, never racing the scan', async () => {
+    // Previous case retired `linked`; load it again through a manual rescan.
+    source = version('v5')
+    await discoverRuntimePlugins()
+    expect(counters.__linked_v5).toBe(1)
+
+    // Hold the next scan at its first await (the plugins root).
+    let releaseRoot: (root: string) => void = () => undefined
+    const rootReads = desktopPluginsRoot.mock.calls.length
+    desktopPluginsRoot.mockImplementationOnce(() => new Promise<string>(resolve => (releaseRoot = resolve)))
+    const scan = discoverRuntimePlugins()
+    await vi.waitFor(() => expect(desktopPluginsRoot).toHaveBeenCalledTimes(rootReads + 1))
+
+    source = version('v6')
+    const reads = readFileText.mock.calls.length
+    expect(await refreshChangedDiskPlugins('test')).toEqual([])
+    expect(readFileText.mock.calls.length).toBe(reads)
+    expect(counters.__linked_v6).toBeUndefined()
+
+    // The scan itself (a reload) then picks up the new bytes, once.
+    releaseRoot(root)
+    await scan
+    expect(counters.__linked_v6).toBe(1)
+
+    unloadRuntimePlugin('linked')
+  })
 })
diff --git a/apps/desktop/src/contrib/runtime-loader.ts b/apps/desktop/src/contrib/runtime-loader.ts
index 6c581b92afa..79169782370 100644
--- a/apps/desktop/src/contrib/runtime-loader.ts
+++ b/apps/desktop/src/contrib/runtime-loader.ts
@@ -1121,7 +1121,8 @@ let refreshing = false
 export async function refreshChangedDiskPlugins(reason = 'refresh'): Promise<string[]> {
   const desktop = window.hermesDesktop
 
-  if (!desktop || scanning || refreshing || disk.size === 0) {
+  // Never race a scan (it owns `disk` while it runs); the next tick re-checks.
+  if (!desktop || scanInFlight || refreshing || disk.size === 0) {
     return []
   }
 
-- 
