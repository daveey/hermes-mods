From 0d1195bac680464d99220e38a37627317f0c3265 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 14:56:13 -0700
Subject: [PATCH] fix(kanban): a dry-run dispatch writes no suspend-ledger
 stamp [daveey]

bc67ee012f stamps kanban_dispatch_stamp on every reclaim phase, including
dispatch_once(dry_run=True), so dry runs created two tables in kanban.db and
four 'dry run changes nothing' tests went red on main (test_kanban_refused_pin_clear,
_managed_pin_policy, _model_assignment). A dry-run stamp would also hide a real
suspend gap from the next pass. record_dispatch_pass(dry_run=True) is a no-op;
the reclaim phase passes dispatch_once's dry_run through.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/kanban_db_dispatch.py               |  6 +++---
 hermes_cli/kanban_suspend_ledger.py            |  6 +++++-
 tests/hermes_cli/test_kanban_suspend_ledger.py | 17 +++++++++++++++++
 3 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_db_dispatch.py b/hermes_cli/kanban_db_dispatch.py
index 857bbfe7a1c..2ff78029010 100644
--- a/hermes_cli/kanban_db_dispatch.py
+++ b/hermes_cli/kanban_db_dispatch.py
@@ -2443,7 +2443,7 @@ def _run_reclaim_phase(
     stale_timeout_seconds: int,
     failure_limit: int,
     reconcile_orphans: bool,
-    board: Optional[str] = None,
+    board: Optional[str] = None, dry_run: bool = False,
 ) -> None:
     """Reclaim stale/orphaned/crashed/timed-out running tasks, then promote."""
     reap_worker_zombies()
@@ -2458,7 +2458,7 @@ def _run_reclaim_phase(
         _kb._log.warning("kanban: applying remote stop requests failed", exc_info=True)
     # [daveey] Before any stale check: a long gap since the last pass is a host suspend, which the
     # heartbeat backstop, the stale sweep and max_runtime must not count (``kanban_suspend_ledger``).
-    _record_dispatch_pass(conn)
+    _record_dispatch_pass(conn, dry_run=dry_run)
     result.reclaimed = _kb.release_stale_claims(conn, failure_limit=failure_limit)
     if reconcile_orphans:
         result.reconciled_orphans = reconcile_orphaned_running(conn)
@@ -2672,7 +2672,7 @@ def _dispatch_once_locked(
     result = DispatchResult()
     _run_reclaim_phase(
         conn, result, stale_timeout_seconds=stale_timeout_seconds,
-        failure_limit=failure_limit, reconcile_orphans=reconcile_orphans, board=board,
+        failure_limit=failure_limit, reconcile_orphans=reconcile_orphans, board=board, dry_run=dry_run,
     )
     if not dry_run:
         # Agent-owned blocks (no human ask / wake probe) get one triage respawn after 2h.
diff --git a/hermes_cli/kanban_suspend_ledger.py b/hermes_cli/kanban_suspend_ledger.py
index bda16bcbc21..159b6a0a47e 100644
--- a/hermes_cli/kanban_suspend_ledger.py
+++ b/hermes_cli/kanban_suspend_ledger.py
@@ -60,12 +60,16 @@ def _configured_interval_seconds() -> float:
 
 def record_dispatch_pass(
     conn: sqlite3.Connection, *, now: Optional[int] = None, interval_seconds: Optional[float] = None,
+    dry_run: bool = False,
 ) -> Optional[tuple[int, int]]:
     """Stamp this pass; record ``[previous, now]`` as suspended when the gap is over the threshold.
 
     Returns the recorded span, else ``None``. Never raises: a failure leaves the checks on wall-clock
-    time, which is the pre-ledger behaviour.
+    time, which is the pre-ledger behaviour. A dry run (``dispatch_once(dry_run=True)``) is not a pass:
+    it writes nothing, and its stamp would hide a real suspend gap from the next pass.
     """
+    if dry_run:
+        return None
     from hermes_cli.kanban_db import write_txn
 
     now = int(time.time()) if now is None else int(now)
diff --git a/tests/hermes_cli/test_kanban_suspend_ledger.py b/tests/hermes_cli/test_kanban_suspend_ledger.py
index b6eea71cf4c..c0c75d02945 100644
--- a/tests/hermes_cli/test_kanban_suspend_ledger.py
+++ b/tests/hermes_cli/test_kanban_suspend_ledger.py
@@ -224,3 +224,20 @@ def test_fresh_run_is_not_stale_against_its_predecessors_heartbeat(board, child)
     kinds = [e.kind for e in kb.list_events(board, tid)]
     assert "reclaimed" not in kinds and "claim_extended" in kinds
     assert kb.get_task(board, tid).claim_expires > now
+
+
+def test_dry_run_dispatch_writes_no_stamp_and_keeps_the_gap(board, monkeypatch):
+    """A dry run is not a pass: no ledger table, and the next real pass still sees the suspend gap."""
+    now = int(time.time())
+    monkeypatch.setattr(ledger, "_configured_interval_seconds", lambda: 60)
+    before = list(board.iterdump())
+    kbd.dispatch_once(board, dry_run=True)
+    assert list(board.iterdump()) == before
+    assert ledger.record_dispatch_pass(board, now=now - 3600, dry_run=True) is None
+    assert list(board.iterdump()) == before
+
+    ledger.record_dispatch_pass(board, now=now - 3600, interval_seconds=60)
+    kbd._run_reclaim_phase(board, kbd.DispatchResult(), stale_timeout_seconds=0, failure_limit=2,
+                           reconcile_orphans=False, dry_run=True)
+    ledger.record_dispatch_pass(board, now=now, interval_seconds=60)
+    assert ledger.suspended_intervals(board) == [(now - 3600, now)]
-- 
