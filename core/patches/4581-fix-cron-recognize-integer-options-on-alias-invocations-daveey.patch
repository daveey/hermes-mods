From 366660f55bfb7681e15349cc6c3dc01ae75f2a52 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 15:32:10 +0000
Subject: [PATCH] fix(cron): recognize integer options on alias invocations
 [daveey]

Address PR3305 review: alias values can hide a declaration while invocation arguments supply -i. Carry the sticky alias-definition hint into integer option and opaque option detection without evaluating aliases. Preserve no-i and +i controls. Real Bash RED: three missed declaration forms; GREEN: 31 tests including eval and expanded options. scripts/check: all 20 checks pass.
---
 cron/lifecycle_guard_arith_words.py                 | 13 ++++++++++---
 cron/lifecycle_guard_output.py                      |  4 +++-
 .../cron/test_lifecycle_guard_arith_int_context.py  |  7 +++++++
 3 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/cron/lifecycle_guard_arith_words.py b/cron/lifecycle_guard_arith_words.py
index a1a93cab2712b1276696c5b707cf47ce3e2e7f3e..bb8eee37e09c2961928cbb80666aa0728f0d7157 100644
--- a/cron/lifecycle_guard_arith_words.py
+++ b/cron/lifecycle_guard_arith_words.py
@@ -155,11 +155,13 @@ def _implicit_arithmetic_expansion(command: str) -> bool:
     return False
 
 
-def may_set_integer_attributes(command: str) -> bool:
+def may_set_integer_attributes(command: str, *, aliases_defined: bool = False) -> bool:
     """Conservative attribute hint, including declarations without a substitution."""
     from cron import lifecycle_guard as guard
 
-    if not any(hint in command for hint in (*_INTEGER_DECLARERS, "source", ".", "$", "`")):
+    if not aliases_defined and not any(
+        hint in command for hint in (*_INTEGER_DECLARERS, "source", ".", "$", "`")
+    ):
         return False
     for segment in guard._iter_command_segments(command):
         if _INTEGER_DECLARATION_RE.search(" ".join(segment)):
@@ -185,7 +187,12 @@ def may_set_integer_attributes(command: str) -> bool:
             and not _ASSIGNMENT_WORD_RE.match(words[index])
         ):
             return True
-        if name in _INTEGER_DECLARERS and any(
+        # With aliases in walked text, a plain command name may hide a declarer.
+        # Its invocation can supply -i even when the alias value does not. Keep
+        # no-i/+i data controls; unknown expanded options fail towards scanning.
+        if aliases_defined and _integer_declaration(words[index + 1:]):
+            return True
+        if (name in _INTEGER_DECLARERS or aliases_defined) and any(
             ("$" in word or "`" in word) and not _ASSIGNMENT_WORD_RE.match(word)
             for word in words[index + 1:]
         ):
diff --git a/cron/lifecycle_guard_output.py b/cron/lifecycle_guard_output.py
index 6c4bd64bce17440af98df5626abf4f2f8458ae07..4f5cbdc282b84ad246aa86607d106694d099a144 100644
--- a/cron/lifecycle_guard_output.py
+++ b/cron/lifecycle_guard_output.py
@@ -31,7 +31,9 @@ def iter_recursive_payloads(command, nested_texts, *, cwd, executed, budget, cov
     """
     from cron import lifecycle_guard as guard
 
-    budget.integer_context = budget.integer_context or may_set_integer_attributes(command)
+    budget.integer_context = budget.integer_context or may_set_integer_attributes(
+        command, aliases_defined=budget.aliases_defined,
+    )
     for payload in nested_texts:
         yield payload, True, None, True
     for payload in guard._iter_shell_command_payloads(command):
diff --git a/tests/cron/test_lifecycle_guard_arith_int_context.py b/tests/cron/test_lifecycle_guard_arith_int_context.py
index b0e3c0b28f167f2d086ae67c683fb9840f7bf33d..fb20c81c709b81c00e13b583702564b086b80b86 100644
--- a/tests/cron/test_lifecycle_guard_arith_int_context.py
+++ b/tests/cron/test_lifecycle_guard_arith_int_context.py
@@ -9,6 +9,11 @@ from cron.lifecycle_guard import scan_gateway_lifecycle
 
 
 SHAPES = [
+    "shopt -s expand_aliases\nalias d='declare'\no=-i\nd $o x\nx=a[\\$\\(SCRIPT\\)]",
+    "shopt -s expand_aliases\nalias d='declare'\neval 'd -i x'\nx=a[\\$\\(SCRIPT\\)]",
+    "shopt -s expand_aliases\nalias d='declare'\nd -i x\nx=a[\\$\\(SCRIPT\\)]",
+    "shopt -s expand_aliases\nalias d='typeset'\nd -i x\nx=a[\\$\\(SCRIPT\\)]",
+    "shopt -s expand_aliases\nalias d='builtin declare'\nd -xi x\nx=a[\\$\\(SCRIPT\\)]",
     "shopt -s expand_aliases\nalias d='declare -i'\nd x\nx=a[\\$\\(SCRIPT\\)]",
     "shopt -s expand_aliases\nalias d='typeset -i'\nd x\nx=a[\\$\\(SCRIPT\\)]",
     r'let "a[\`SCRIPT\`]=1"',
@@ -28,6 +33,8 @@ SHAPES = [
     r". ./decl.sh; eval 'x=a[\$\(SCRIPT\)]'",
 ]
 CONTROLS = [
+    "shopt -s expand_aliases\nalias d='declare'\nd +i x\nx=a[\\$\\(SCRIPT\\)]",
+    "shopt -s expand_aliases\nalias d='typeset'\nd x\nx=a[\\$\\(SCRIPT\\)]",
     "shopt -s expand_aliases\nalias d='declare'\nd x\nx=a[\\$\\(SCRIPT\\)]",
     "shopt -s expand_aliases\nalias d='declare +i'\nd x\nx=a[\\$\\(SCRIPT\\)]",
     r"eval 'x=a[\$\(SCRIPT\)]'",
