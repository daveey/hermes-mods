From a7caf2ddb79a3bd9f79f4e3bb2b5f173785a496c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 00:57:16 -0700
Subject: [PATCH] fix(kanban-sync): build the lease client from the hub
 enrollment in any process [daveey]

Workers renew their lease from their own process (the kanban_heartbeat tool
calls heartbeat_claim); only the gateway's sync thread registered a lease
client, so on a primary board every worker's renewal would have failed and
the worker been stopped at its first lease deadline. _client() now builds a
HubLeaseClient on first use when sync is on; without an enrollment it still
fails closed.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 hermes_cli/kanban_db_sync.py                |  9 +++++++++
 tests/hermes_cli/test_kanban_sync_client.py | 18 ++++++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/hermes_cli/kanban_db_sync.py b/hermes_cli/kanban_db_sync.py
index fd10334189..50417423ab 100644
--- a/hermes_cli/kanban_db_sync.py
+++ b/hermes_cli/kanban_db_sync.py
@@ -474,6 +474,15 @@ def set_lease_client(client: Optional[LeaseClient]) -> Optional[LeaseClient]:
 
 
 def _client() -> LeaseClient:
+    """The registered lease client, or one built from this host's hub enrollment on first use: workers renew
+    their lease from their own process (the ``kanban_heartbeat`` tool), not the gateway's."""
+    global _LEASE_CLIENT
+    if _LEASE_CLIENT is None and sync_enabled():
+        try:
+            from hermes_cli import kanban_sync_client as ksc
+            _LEASE_CLIENT = ksc.HubLeaseClient(ksc.Hub(ksc.load_identity()))
+        except Exception as exc:  # health: allow BLE001 -- no enrollment / bad config: claims fail closed below
+            _log.info("kanban sync: no lease client (%s: %s)", type(exc).__name__, exc)
     if _LEASE_CLIENT is None:
         raise LeaseUnavailable("no lease client registered")
     return _LEASE_CLIENT
diff --git a/tests/hermes_cli/test_kanban_sync_client.py b/tests/hermes_cli/test_kanban_sync_client.py
index 094dcf57d8..203e2ce610 100644
--- a/tests/hermes_cli/test_kanban_sync_client.py
+++ b/tests/hermes_cli/test_kanban_sync_client.py
@@ -522,3 +522,21 @@ def test_sync_config_does_not_need_pyyaml(kanban_home, monkeypatch):
     support.write_sync_config(kanban_home, True)
     monkeypatch.setattr(builtins, "__import__", no_pyyaml)
     assert sync.sync_enabled()
+
+
+def test_a_worker_process_builds_its_own_lease_client_from_the_hub_enrollment(kanban_home, monkeypatch):
+    """Lease renewals happen in the worker (kanban_heartbeat), not the gateway: with sync on, the first lease
+    call builds a hub client from this host's enrollment; without one it fails closed."""
+    support.write_sync_config(kanban_home, True)
+    previous = sync.set_lease_client(None)
+    try:
+        with pytest.raises(sync.LeaseUnavailable):
+            sync._client()  # no enrollment files in this test home
+        mail = kanban_home.parent / ".config" / "hermes-mail"
+        mail.mkdir(parents=True)
+        (mail / "config.json").write_text(json.dumps({"url": "https://hub.test", "gateway": ME}))
+        (mail / "gateway.key").write_text("k\n")
+        client = sync._client()
+        assert isinstance(client, ksc.HubLeaseClient) and client.hub.ident.gateway == ME
+    finally:
+        sync.set_lease_client(previous)
-- 
