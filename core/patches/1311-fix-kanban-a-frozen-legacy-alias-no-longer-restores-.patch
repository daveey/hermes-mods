From 7af0b824117f2aa6c37af4b80364f608588e3faa Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 11:43:35 -0700
Subject: [PATCH] fix(kanban): a frozen legacy alias no longer restores links
 on an open card [daveey]

Removing a shepherd subscription on the owner did nothing: the pre-qualification
copy of the card stays in the replica forever and the fold copied its links back
(109 of them on one card), so a chat stayed tied to a card it had only read. An
open twin publishes every live link itself; only a finished twin still takes the
alias's links, for the terminal release.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/kanban_session_activity_records.py      | 14 ++++++++------
 .../test_kanban_remote_terminal_release.py         |  8 ++++++++
 2 files changed, 16 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_session_activity_records.py b/hermes_cli/kanban_session_activity_records.py
index 27405821a0..e4a5420899 100644
--- a/hermes_cli/kanban_session_activity_records.py
+++ b/hermes_cli/kanban_session_activity_records.py
@@ -46,9 +46,10 @@ def _fold_legacy_aliases(tasks: dict[tuple, dict[str, Any]], raw: dict[tuple, di
     Hub-sync used to key records ``board/id``; it now publishes ``profile/board/id`` and the old rows linger,
     so every pre-qualification card was both counted twice and stuck ``unknown`` forever. A legacy record is
     folded only when exactly one profile on the same owner gateway publishes that board/id AND both records
-    carry the same non-null ``created_at`` and ``created_by`` (identity, not an ID match). Its shepherd links
-    move onto the twin, so no session loses the association; anything ambiguous stays a separate ``unknown``
-    obligation. [daveey]
+    carry the same non-null ``created_at`` and ``created_by`` (identity, not an ID match). A finished twin takes its
+    shepherd links, so no session misses the terminal release. A twin still open publishes every live link itself:
+    the frozen record's extra links are ones the owner released, and folding them would keep those chats waiting on
+    the card for good. Anything ambiguous stays a separate ``unknown`` obligation. [daveey]
     """
     qualified: dict[tuple[str, str, str], list[tuple]] = {}
     for key in tasks:
@@ -65,8 +66,9 @@ def _fold_legacy_aliases(tasks: dict[tuple, dict[str, Any]], raw: dict[tuple, di
                 or old.get('created_by') != new.get('created_by')):
             continue
         twin = tasks[twins[0]]
-        links = [*(twin.get('sessions') if isinstance(twin.get('sessions'), list) else []),
-                 *(link for link in (old.get('sessions') if isinstance(old.get('sessions'), list) else [])
-                   if isinstance(link, dict) and link.get('rel') == 'shepherd')]
+        links = [*(twin.get('sessions') if isinstance(twin.get('sessions'), list) else [])]
+        if twin.get('status') in ('done', 'archived'):
+            links += [link for link in (old.get('sessions') if isinstance(old.get('sessions'), list) else [])
+                      if isinstance(link, dict) and link.get('rel') == 'shepherd']
         tasks[twins[0]] = {**twin, 'sessions': links, '_legacy_key': f'{gw}/{board}/{tid}'}
         del tasks[key]
diff --git a/tests/hermes_cli/test_kanban_remote_terminal_release.py b/tests/hermes_cli/test_kanban_remote_terminal_release.py
index 581eba2c25..9460288eee 100644
--- a/tests/hermes_cli/test_kanban_remote_terminal_release.py
+++ b/tests/hermes_cli/test_kanban_remote_terminal_release.py
@@ -98,6 +98,14 @@ def test_legacy_alias_folds_into_its_proven_twin(tmp_path):
     assert counted(rows) == []
 
 
+def test_a_link_the_owner_released_does_not_come_back_from_a_frozen_alias(tmp_path):
+    legacy_link = {**LINK, 'session': 's_old'}
+    legacy = {k: v for k, v in card('todo', sessions=[legacy_link, LINK]).items() if k not in ('gateway', 'profile')}
+    path = replica(tmp_path, [('default/t_1', legacy), ('default/default/t_1', observed(card('scheduled')))])
+    rows = activity._read_remote_links(path, now=NOW)
+    assert [r['session'] for r in rows] == [LINK['session']]
+
+
 def test_open_legacy_alias_is_counted_once_under_the_qualified_key(tmp_path):
     legacy = {k: v for k, v in card('todo').items() if k not in ('gateway', 'profile')}
     path = replica(tmp_path, [('default/t_1', legacy), ('default/default/t_1', observed(card('todo')))])
