From 3ddd28f3f003754df92dc932347cbdb40a8f65f3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 04:42:11 +0000
Subject: [PATCH] [daveey] Test ANSI-C words alongside descriptor ampersand
 protection

---
 tests/cron/test_lifecycle_guard_nested_comments.py | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/tests/cron/test_lifecycle_guard_nested_comments.py b/tests/cron/test_lifecycle_guard_nested_comments.py
index 25f0e5da404375adaf64534b0848e936afc17aab..3d1d30d2b92ce17a012089ae30a6ea0ec72b8f6e 100644
--- a/tests/cron/test_lifecycle_guard_nested_comments.py
+++ b/tests/cron/test_lifecycle_guard_nested_comments.py
@@ -2,10 +2,13 @@
 
 import pytest
 
-from cron.lifecycle_guard import scan_gateway_lifecycle
+from cron.lifecycle_guard import _shlex_tokens, scan_gateway_lifecycle
 from tests.cron import test_lifecycle_guard_comment_words as helpers
 
 PREFIXES = [
+    "echo $'a>&b' 2>&1",
+    r"echo $'a>\x26b' 2>&1",
+    r"echo $'it\'s>&b' 2>&1",
     'echo ${x:-"$(echo $\'it\\\'s\' #say "x\n)"}',
     'echo "${x:-$(echo $\'it\\\'s\' #say "x\n)}"',
     'echo ${x:-"$(echo #say "x\n)"}',
@@ -41,6 +44,15 @@ PREFIXES = [
 ]
 
 
+@pytest.mark.parametrize("word, literal", [
+    ("$'a>&b'", "a>&b"),
+    (r"$'a>\x26b'", "a>&b"),
+    (r"$'it\'s>&b'", "it's>&b"),
+])
+def test_ansi_ampersands_preserve_words_and_descriptor_redirects(word, literal):
+    assert _shlex_tokens(f"echo {word} 2>&1") == ["echo", literal, "2>&1"]
+
+
 @pytest.mark.parametrize("prefix", PREFIXES)
 @pytest.mark.parametrize("dangerous", [True, False], ids=["RUN", "clean"])
 def test_nested_context_does_not_hide_following_command(tmp_path, prefix, dangerous):
