diff --git a/tests/hermes_cli/test_kanban_lifecycle_serialization.py b/tests/hermes_cli/test_kanban_lifecycle_serialization.py
new file mode 100644
index 00000000000..ba3a40638ef
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_lifecycle_serialization.py
@@ -0,0 +1,78 @@
+"""Healthy WAL generation transitions stay atomic against same-board opens."""
+from concurrent.futures import ThreadPoolExecutor
+import sqlite3
+import threading
+
+import pytest
+
+from hermes_cli import kanban_db_connect as kb
+from hermes_cli import kanban_lockguard as guard
+from hermes_cli.sqlite_safe_read import has_live_connection
+
+
+@pytest.mark.platforms("linux", "macos")
+@pytest.mark.parametrize("mixed", [False, True])
+def test_same_board_open_close_churn(tmp_path, mixed):
+    path = tmp_path / "board.db"
+    seed = sqlite3.connect(path)
+    seed.execute("PRAGMA journal_mode=WAL")
+    seed.execute("CREATE TABLE marker(value)")
+    seed.execute("INSERT INTO marker VALUES (42)")
+    seed.commit()
+    seed.close()
+    alias = tmp_path / "alias.db"
+    alias.symlink_to(path)
+    start = threading.Barrier(4)
+
+    def churn(worker):
+        start.wait(timeout=10)
+        errors = []
+        for _ in range(500):
+            try:
+                if mixed and worker % 2:
+                    conn = guard.connect(alias.as_uri() + "?mode=rw", uri=True)
+                else:
+                    conn = kb._sqlite_connect(path)
+                try:
+                    assert conn.execute("SELECT value FROM marker").fetchone() == (42,)
+                finally:
+                    conn.close()
+            except Exception as exc:
+                errors.append(f"{type(exc).__name__}: {exc}")
+        return errors
+
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        batches = list(pool.map(churn, range(4)))
+    errors = [error for batch in batches for error in batch]
+    assert not errors, (len(errors), errors[:3])
+    assert not has_live_connection(path)
+
+
+def test_guarded_custom_factory_close_waits_outside_tracking_lock(tmp_path):
+    from hermes_cli.kanban_dispatch_owner import connect_with_identity
+    from hermes_cli.sqlite_safe_read import _live_lock
+
+    entered = threading.Event()
+    path = tmp_path / "board.db"
+    conn = connect_with_identity(path, factory=guard.GuardedConnection, check_same_thread=False)
+
+    class ObservedLock:
+        def __enter__(self):
+            entered.set()
+            conn_lock.acquire()
+
+        def __exit__(self, *args):
+            conn_lock.release()
+
+    conn_lock = conn._hermes_lifecycle_lock
+    conn._hermes_lifecycle_lock = ObservedLock()
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        with conn_lock:
+            pending = pool.submit(conn.close)
+            assert entered.wait(10)
+            acquired = _live_lock.acquire(timeout=2)
+            if acquired:
+                _live_lock.release()
+            assert acquired, "close waits for a board while holding the global tracking lock"
+        pending.result(timeout=10)
+    assert not has_live_connection(path)
diff --git a/tests/hermes_cli/test_kanban_reader_lifecycle.py b/tests/hermes_cli/test_kanban_reader_lifecycle.py
new file mode 100644
index 00000000000..9da9dd36813
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_reader_lifecycle.py
@@ -0,0 +1,87 @@
+"""A board lifecycle transition must not hold the cross-board reader-cache lock."""
+from concurrent.futures import ThreadPoolExecutor
+import os
+import sqlite3
+import threading
+
+import pytest
+
+from hermes_cli import kanban_session_activity as activity
+
+
+def _seed(path):
+    conn = sqlite3.connect(path)
+    conn.execute("CREATE TABLE marker(value)")
+    conn.execute("INSERT INTO marker VALUES (42)")
+    conn.commit()
+    conn.close()
+
+
+@pytest.mark.parametrize("phase", ["open", "close"])
+def test_cache_registry_is_available_during_board_io(tmp_path, monkeypatch, phase):
+    path = tmp_path / "board.db"
+    _seed(path)
+    if phase == "close":
+        with activity.cached_ro(path):
+            pass
+        replacement = tmp_path / "replacement.db"
+        _seed(replacement)
+        os.replace(replacement, path)
+    entered, release = threading.Event(), threading.Event()
+    seam = "_open_ro" if phase == "open" else "_close_quietly"
+    original = getattr(activity, seam)
+
+    def paused(*args, **kwargs):
+        entered.set()
+        assert release.wait(10)
+        return original(*args, **kwargs)
+
+    monkeypatch.setattr(activity, seam, paused)
+
+    def read():
+        with activity.cached_ro(path) as conn:
+            return conn.execute("SELECT value FROM marker").fetchone()[0]
+
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        pending = pool.submit(read)
+        try:
+            assert entered.wait(10)
+            acquired = activity._RO_CACHE_LOCK.acquire(timeout=2)
+            if acquired:
+                activity._RO_CACHE_LOCK.release()
+            assert acquired, "board I/O holds the global reader registry lock"
+        finally:
+            release.set()
+            pending.result(timeout=10)
+            activity._reset_cache_for_tests()
+
+
+def test_recovery_refuses_busy_cache_registry(tmp_path):
+    from hermes_cli.kanban_generation import DeletedWalGenerationError, evict_readers
+
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        with activity._RO_CACHE_LOCK:
+            pending = pool.submit(evict_readers, str(tmp_path / "board.db"))
+            with pytest.raises(DeletedWalGenerationError, match="registry is busy"):
+                pending.result(timeout=3)
+
+
+def test_replaced_reader_is_not_closed_under_borrower(tmp_path):
+    from hermes_cli.kanban_generation import DeletedWalGenerationError
+
+    path = tmp_path / "board.db"
+    _seed(path)
+    try:
+        with activity.cached_ro(path) as held:
+            replacement = tmp_path / "new.db"
+            _seed(replacement)
+            os.replace(replacement, path)
+            with pytest.raises(DeletedWalGenerationError, match="still borrowed"):
+                with activity.cached_ro(path):
+                    pass
+            assert held.execute("SELECT value FROM marker").fetchone() == (42,)
+        with activity.cached_ro(path) as fresh:
+            assert fresh is not held
+            assert fresh.execute("SELECT value FROM marker").fetchone() == (42,)
+    finally:
+        activity._reset_cache_for_tests()
