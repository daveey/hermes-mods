From aa5cef825f3b62a4a5b2f561029a4dd65a5061c5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:36:40 +0000
Subject: [PATCH] [daveey] placement: home-relative span ends only at a cd of
 this shell; cd ~/.hermes && cd hermes-agent is the code tree

PR #2585 review 5897242912 nits 1-2 (card t_01a1d684e94a476d), on top of c0bf2d0f0b3.

1. Fail-open (regression vs b22e3019a3): every lowercase cd/pushd/popd word ended
   the home-relative `.hermes` span, so `cd ~ && (cd repo && make) && cat
   .hermes/.env` pinned on b22e3019a3 and went portable after #2585. Now only a
   cd/pushd in a command position of this shell (line start, `&&`, `||`, `;`,
   `{`, backtick) ends the span. A subshell `(cd ..)`/`$(cd ..)`, a pipeline
   stage `| cd x` (a subshell in bash) and a prose "cd" do not; `cd -`, `popd`
   and a bare/rotating `pushd` go somewhere unknown and keep the span open
   (fail toward the pin). Single `|` is deliberately not a stop context (the card
   listed it): the conservative reading of a pipeline stage keeps the pin.
   Any later cd home still ends the span: that cd starts its own span over the
   same tail, so spans stay disjoint and the scan linear even with no shell
   context (new row: 5000 `(cd ~) ... cd ...` prose items on one 180 KB line,
   < 1 s; adversarial probes of 160-330 KB bodies of whitespace, `&&`, `;`,
   `{`, backticks, `pushd +1`, `cd -` all run in <= 0.08 s).
2. Over-pin: `cd ~/.hermes && cd hermes-agent && git pull` pinned as state
   (class b, hub:write) while `cd ~/.hermes/hermes-agent && ...` stayed
   portable, against 9328cbc2d9b's worker-first rule for the hermes-agent tree.
   A cd/pushd into ~/.hermes (or `cd .hermes` after a cd home) that is followed
   at once (`&&`, `;`, newline, optional comment) by a cd/pushd into the code
   tree (`hermes-agent`, `repos`, `bin`: the same set _STATE_SUB already
   excludes) no longer counts as the state directory. Anything else after it
   (`echo cd hermes-agent`, `cd hermes-agent-old`) still pins.

Tests: rows in test_kanban_placement_home_spellings.py (12 pin, 12 portable, a
prose-cd timing row) and three nit-2 rows in test_ordinary_repo_work_enrolls_worker_first.
RED on main 75c54c9f807: 17 failed / 129 passed across the two files.
GREEN: same two files 146 passed; every test_*.py naming kanban_placement /
kanban_home_marker_placement / HERMES_STATE_PATH (95 files):
2712 passed, 0 failed. scripts/check --base
origin/main: 20 checks ok. The existing 5000-line no-match timing row stays green.
---
 hermes_cli/kanban_placement.py                | 17 ++++--
 .../test_kanban_placement_home_spellings.py   | 52 +++++++++++++++++++
 .../test_kanban_worker_placement.py           |  5 ++
 3 files changed, 71 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 9b723dc953..a57162e42a 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -585,14 +585,25 @@ def _heavy_marker(title: str, body: str, cfg: _Cfg) -> Optional[str]:
 # the span ran to the end of the text). A cd/pushd into the state directory itself (``cd ~/.hermes && cat .env``,
 # or ``cd .hermes`` after a cd home) counts too (review 5895947424). A bare ``~/.hermes`` anywhere else does not:
 # "the hermes-agent tree under ~/.hermes" is ordinary repo work and must reach the worker pool (9328cbc2d9b).
+# PR #2585 review 5897242912: only a cd/pushd in a command position of this shell (line start, ``&&``, ``||``,
+# ``;``, ``{``, backtick) ends the span. A subshell ``(cd repo && make)``/``$(cd ..)``, a pipeline stage
+# ``| cd x`` and a prose "cd" change no cwd here; ``cd -``, ``popd`` and a bare/rotating ``pushd`` go somewhere
+# unknown. Those keep the span open, failing toward the pin. Any later cd home still ends it (that cd starts its
+# own span over the same tail), which keeps spans disjoint and the scan linear. A cd into ~/.hermes followed at
+# once by a cd into its code tree (``cd ~/.hermes && cd hermes-agent``) is that tree, like ``cd
+# ~/.hermes/hermes-agent``, not the state directory (nit 2).
 HOME_PREFIX = r"(?:~|/home/[^/\s]+|\$HOME\b|\$\{HOME\}|\"\$HOME\"|\"\$\{HOME\}\")"
 # ``cd ~ 2>/dev/null`` ends the cd too (an fd-numbered redirect); ``cd ~2>x`` is a dir word, not a redirect.
 _CMD_END = r"(?=[ \t]*(?:$|[\n;&|)>])|[ \t]+(?:#|\d+>))"
 _CD_HOME = (r"(?<![\w./-])(?-i:cd(?:[ \t]+" + HOME_PREFIX + r"/?)?|pushd[ \t]+" + HOME_PREFIX + r"/?)" + _CMD_END)
-_CHDIR = r"(?<![\w./-])(?-i:cd|pushd|popd)(?![\w.-])(?![ \t]+[\"']?(?:\./)?\.hermes(?![\w.-]))"
+_CHDIR = (r"(?:" + _CD_HOME + r"|(?:(?<=\n)|&&|\|\||;|`|\{)[ \t]*"
+          r"(?-i:cd(?![\w.-])(?![ \t]+-" + _CMD_END + r")|pushd(?![\w.-])(?![ \t]+[+-]\d+" + _CMD_END + r")(?!"
+          + _CMD_END + r"))(?![ \t]+[\"']?(?:\./)?\.hermes(?![\w.-])))")
 _CD_INTO = r"(?<![\w./-])(?-i:cd|pushd)[ \t]+[\"']?"
-_STATE_SUB = r"\.hermes/(?!(?:hermes-agent|repos|bin)(?:/|\b))[\w.-]"
-_STATE_DIR = r"\.hermes/?[\"']?" + _CMD_END
+_CODE_TREE = r"(?:hermes-agent|repos|bin)"
+_STATE_SUB = r"\.hermes/(?!" + _CODE_TREE + r"(?:/|\b))[\w.-]"
+_STATE_DIR = (r"\.hermes/?[\"']?" + _CMD_END + r"(?![ \t]*(?:#[^\n]*)?(?:&&|;|\n)\s*(?-i:cd|pushd)[ \t]+[\"']?(?:\./)?"
+              + _CODE_TREE + r"(?![\w.-]))")
 HERMES_STATE_PATH = (r"(?:" + HOME_PREFIX + r"/" + _STATE_SUB + r"|" + _CD_INTO + HOME_PREFIX + r"/" + _STATE_DIR +
                      r"|" + _CD_HOME + r"(?:(?!" + _CHDIR + r")[\s\S])*?"
                      r"(?:(?<![\w./~$}-])(?:\./)?" + _STATE_SUB + r"|" + _CD_INTO + r"(?:\./)?" + _STATE_DIR + r"))")
diff --git a/tests/hermes_cli/test_kanban_placement_home_spellings.py b/tests/hermes_cli/test_kanban_placement_home_spellings.py
index e8d6bb0291..881c54b729 100644
--- a/tests/hermes_cli/test_kanban_placement_home_spellings.py
+++ b/tests/hermes_cli/test_kanban_placement_home_spellings.py
@@ -72,6 +72,58 @@ def test_a_later_cd_elsewhere_ends_the_home_relative_span(body):
     assert helpers._hub({"title": "Maintenance", "body": body})["runs_on"] == ["machine:worker-1"]
 
 
+# PR #2585 review 5897242912 nit 1: only a cd that changes this shell's directory ends the span. A subshell
+# ``(cd repo ...)`` does not; ``cd -``/``popd``/a bare ``pushd`` go somewhere unknown, so the span stays open (fails
+# toward the pin); a prose "cd" outside a command position does not end it either.
+@pytest.mark.parametrize("body", [
+    "Run pytest, then cd ~ && (cd repo && make) && cat .hermes/.env",
+    "Run pytest, then cd ~\n(cd repo && make)\ncat .hermes/.env",
+    "Run pytest, then cd ~ && x=$(cd repo && pwd) && cat .hermes/.env",
+    "Run pytest, then cd ~ && cd - && cat .hermes/.env",
+    "Run pytest, then pushd ~ && popd && cat .hermes/.env",
+    "Run pytest, then cd ~ && pushd && cat .hermes/.env",
+    "Run pytest, then cd ~ && echo you can cd later && cat .hermes/.env",
+    "Run pytest, then cd ~  # no need to cd anywhere else\ncat .hermes/.env",
+    "Run pytest, then cd ~ && ls | cd repo && cat .hermes/.env",
+    "Run pytest, then cd ~ && (cd repo && cat .hermes/.env)",
+    "Run pytest, then cd ~/.hermes && cd hermes-agent-old && cat ../.env",
+    "Run pytest, then cd ~/.hermes && echo cd hermes-agent && cat .env",
+])
+def test_only_a_cd_of_this_shell_ends_the_span(body):
+    d = helpers._hub({"title": "Maintenance", "body": body})
+    assert d["where"] == "local" and "runs_on" not in d, d
+
+
+@pytest.mark.parametrize("body", [
+    "Run pytest, then cd ~ && cd repo && cat .hermes/notes.md",
+    "Run pytest, then cd ~ || cd repo && cat .hermes/notes.md",
+    "Run pytest, then cd ~; cd repo; cat .hermes/notes.md",
+    "Run pytest, then cd ~\n  cd repo\ncat .hermes/notes.md",
+    "Run pytest, then cd ~ and run `cd repo && cat .hermes/notes.md`",
+    "Run pytest, then cd ~ && { cd repo; cat .hermes/notes.md; }",
+    "Run pytest, then cd ~ && pushd repo && cat .hermes/notes.md",
+    "Run pytest, then cd ~ && cd .. && cat .hermes/notes.md",
+    # PR #2585 review 5897242912 nit 2: ~/.hermes then its code tree is the code tree, not state.
+    "Run pytest, then cd ~/.hermes && cd hermes-agent && git pull",
+    "Run pytest, then cd \"$HOME/.hermes\"  # state root\ncd 'hermes-agent' && git pull",
+    "Run pytest, then pushd ~/.hermes; pushd repos/x && git pull",
+    "Run pytest, then cd ~ && cd .hermes && cd hermes-agent/scripts && ls",
+])
+def test_a_cd_of_this_shell_still_ends_the_span(body):
+    assert helpers._hub({"title": "Maintenance", "body": body})["runs_on"] == ["machine:worker-1"]
+
+
+def test_a_large_no_match_prose_cd_body_is_linear():
+    """Spans no longer end at a prose cd, so a later cd home must still end one: no O(n^2) on one long line."""
+    from hermes_cli import kanban_placement as kp
+    body = "Run pytest, then " + "".join(
+        f"(cd ~) then say cd somewhere in prose, step {i} padded to a realistic length " for i in range(5000))
+    assert len(body) > 180_000
+    start = time.monotonic()
+    assert re.search(kp.HERMES_STATE_PATH, body, re.IGNORECASE) is None
+    assert time.monotonic() - start < 1.0
+
+
 def test_a_large_no_match_body_is_linear():
     """(2) Before, each qualifying cd ran a lazy span to the end of the text: 16.9 s at 180 KB / 5000 cd lines."""
     from hermes_cli import kanban_placement as kp
diff --git a/tests/hermes_cli/test_kanban_worker_placement.py b/tests/hermes_cli/test_kanban_worker_placement.py
index 2442326468..3a7ee0a2cc 100644
--- a/tests/hermes_cli/test_kanban_worker_placement.py
+++ b/tests/hermes_cli/test_kanban_worker_placement.py
@@ -112,6 +112,11 @@ def test_courier_and_host_work_bypass_worker_policy(hub_judge):
     "hermes-hub client: retry a 409 from the Board",
     "Fix a typo in ~/code/_wtf/notes.md",
     "Read the hermes-agent tree under ~/.hermes for context",
+    # A cd into ~/.hermes then into its code tree is the hermes-agent tree, like cd ~/.hermes/hermes-agent
+    # (PR #2585 review 5897242912 nit 2).
+    "cd ~/.hermes && cd hermes-agent && git fetch -q origin && git log -1 origin/main",
+    "cd ~/.hermes; cd ./hermes-agent/ && git pull --ff-only",
+    "cd ~ && cd .hermes && cd hermes-agent && git status",
     # Near-misses of the home-rooted .worktrees marker stay portable.
     "Fix the parser bug in ~/code/myapp/src/parser.py and open a PR",
     "Patch /home/ubuntu/code/askeve/app/routes.py and push",
