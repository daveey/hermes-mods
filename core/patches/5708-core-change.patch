From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 07:54:50 +0000
Subject: [PATCH] fix(kanban): fence origin courier and inventory its spawn
 [daveey]

CI exposed the spawn-inventory and board-connection ratchets. Hold a real drain lease for the courier operation and annotate the origin-only read-only ledger. Regression exercises an open lease and refused closed latch; targeted origin/lockguard/source-scan suites pass.
---
 hermes_cli/kanban_origin_comment.py            |  6 +++++-
 hermes_cli/worker_drain_spawn_inventory.json   |  5 +++++
 tests/hermes_cli/test_kanban_origin_comment.py | 18 ++++++++++++++++++
 3 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_origin_comment.py b/hermes_cli/kanban_origin_comment.py
index 1685bbd6b4..1265266225 100644
--- a/hermes_cli/kanban_origin_comment.py
+++ b/hermes_cli/kanban_origin_comment.py
@@ -13,6 +13,8 @@ import subprocess
 from contextlib import closing
 from pathlib import Path
 
+from hermes_cli.worker_drain_fence import fenced
+
 
 def bound_owner(path: Path, *, task_id: str, board: str, gateway: str,
                 profile: str, session: str, resolve_session) -> dict | None:
@@ -23,7 +25,8 @@ def bound_owner(path: Path, *, task_id: str, board: str, gateway: str,
     except FileNotFoundError:
         return None
     matches = {}
-    with closing(sqlite3.connect(path.resolve().as_uri() + '?mode=ro', uri=True)) as db:
+    # Origin-local ledger, not a Kanban board connection.
+    with closing(sqlite3.connect(path.resolve().as_uri() + '?mode=ro', uri=True)) as db:  # noqa: kanban-lockguard
         for key, digest, raw, task_raw in db.execute(
                 'SELECT binding_id,binding_hash,binding_json,task_json FROM origin_obligations WHERE released=0'):
             binding = json.loads(raw)
@@ -46,6 +49,7 @@ def bound_owner(path: Path, *, task_id: str, board: str, gateway: str,
     return next(iter(matches.values()), None)
 
 
+@fenced('kanban.origin_comment')
 def send(route: dict, *, session: str, body: str) -> dict:
     """Queue exactly once. Submission is not application; only owner outcomes confirm it."""
     from hermes_cli import kanban_capability_registry as reg
