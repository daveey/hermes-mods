---
diff --git a/tests/gateway/test_reconcile_recovered_store.py b/tests/gateway/test_reconcile_recovered_store.py
index 6f752effc4ffe466e199d57ffcf37e12d1f0edd6..be016b7db377460235a9691c5accf6b8816f6ed5 100644
--- a/tests/gateway/test_reconcile_recovered_store.py
+++ b/tests/gateway/test_reconcile_recovered_store.py
@@ -27,9 +27,16 @@
         first = await runner.reconcile_served_profiles(reason='control-socket')
         assert set(first['parked']) == {'recovering', 'fatal'}
         recovery = True
+        passive = await runner.reconcile_served_profiles(reason='request')
+        assert passive['added'] == []
+        assert calls.count('recovering') == 1
         second = await runner.reconcile_served_profiles(reason='watcher')
         assert second['added'] == ['recovering']
         assert calls.count('recovering') == 2
         assert calls.count('fatal') == 1
         assert 'fatal' in runner.session_runtime_descriptor['parked_profiles']
         assert 'recovering' not in runner.session_runtime_descriptor['parked_profiles']
+        # Watcher recovery must not swallow the explicit control-socket retry.
+        third = await runner.reconcile_served_profiles(reason='control-socket')
+        assert third['added'] == ['fatal']
+        assert calls.count('fatal') == 2
diff --git a/tests/hermes_state/test_profile_delete_ownership_gate.py b/tests/hermes_state/test_profile_delete_ownership_gate.py
new file mode 100644
index 0000000000000000000000000000000000000000..33ee1a67553736e01cbb6f60e243c2ef107f30ba
--- /dev/null
+++ b/tests/hermes_state/test_profile_delete_ownership_gate.py
@@ -0,0 +1,34 @@
+"""Deletion's public ownership gate must include profile resource custody."""
+from contextlib import contextmanager
+
+import pytest
+
+from hermes_cli.profiles_remove import wait_profile_unowned
+from hermes_constants import mark_named_profile_deleted
+
+
+@pytest.mark.parametrize('deleted,drained,expected', [(False, False, True), (True, False, False), (True, True, True)])
+def test_delete_checks_resources_before_gateway_lock(tmp_path, monkeypatch, deleted, drained, expected):
+    home = tmp_path / '.hermes' / 'profiles' / 'retiring'
+    home.mkdir(parents=True)
+    (home / 'config.yaml').write_text('{}')
+    if deleted:
+        mark_named_profile_deleted(home)
+    calls = []
+
+    def resources(path, *, timeout):
+        assert path == home
+        assert timeout >= 0
+        calls.append('resources')
+        return drained
+
+    @contextmanager
+    def maintenance(homes):
+        assert homes == [home]
+        calls.append('gateway')
+        yield
+
+    monkeypatch.setattr('hermes_profile_resources.wait_profile_resources', resources)
+    monkeypatch.setattr('gateway.runtime_ownership.exclusive_maintenance', maintenance)
+    assert wait_profile_unowned(home, timeout=1) is expected
+    assert calls == (['gateway'] if not deleted else ['resources', 'gateway'] if drained else ['resources'])
diff --git a/tests/tui_gateway/conftest.py b/tests/tui_gateway/conftest.py
index 8fe149258921b27071a44947c7d49423703a46c5..3179dc84662321801b570275021e908bba42c3ce 100644
--- a/tests/tui_gateway/conftest.py
+++ b/tests/tui_gateway/conftest.py
@@ -9,6 +9,7 @@
 
 import threading
 import time
+from types import SimpleNamespace
 
 import hermes_bootstrap
 import pytest
@@ -16,6 +17,20 @@
 from tests.waiting import DEFAULT_TIMEOUT
 
 
+@pytest.fixture(autouse=True)
+def _profile_lifetime_thread_isolation(monkeypatch, request):
+    """Prompt-worker fakes must not synchronously run the lifetime monitor.
+
+    These two files replace the shared threading.Thread with an immediate worker
+    across the server's helper graph. Preserve that contract, but keep the real
+    process-lifetime profile monitor on its own unmodified threading namespace.
+    """
+    if request.node.path.name not in {"test_tui_gateway_server.py", "test_profile_resume_cwd.py"}:
+        return
+    import hermes_profile_resources
+    monkeypatch.setattr(hermes_profile_resources, "threading", SimpleNamespace(**vars(threading)))
+
+
 @pytest.fixture(autouse=True)
 def _no_refused_turn_replay(monkeypatch):
     """A real 45 s timer would outlive its test and replay into the next one; ``test_refused_turn_retry`` turns it on."""
