From 0bc5626cfeb13aac75eed2c12793680cba8ad4c5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 09:23:58 +0000
Subject: [PATCH] fix(kanban): placement=<live gateway> reaches any gateway,
 not only the routed target; refusal message updated [daveey]

---
 hermes_cli/kanban_placement.py            | 15 ++++---
 hermes_cli/kanban_worker_node.py          |  4 +-
 tests/hermes_cli/test_kanban_placement.py | 55 +++++++++++++++++++++--
 tools/kanban_tools_schemas.py             |  2 +-
 4 files changed, 62 insertions(+), 14 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index b4f7f530c2..5455f430f0 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -484,18 +484,19 @@ def _decide(args: dict, *, origin_intent=None, now: Optional[float] = None, cfg:
     worker is ``{"where": "local", "runs_on": [machine:<worker>], "why": ...}``. Never raises."""
     try:
         c = _Cfg(config() if cfg is None else cfg)
-        if not isinstance(c.raw.get("route"), dict) or not c.raw["route"]:
-            return {"where": "local", "why": "no placement route for this gateway"}
         self_gw = reg.self_gateway() if self_gw is None else self_gw
-        target = c.target(self_gw)
-        if not target:
-            return {"where": "local", "why": "no placement route for this gateway"}
         pin = canonical_pin(args.get("placement") or "auto", self_gw, c.raw)
         if pin in ("local", "here", (self_gw or "").lower()):
             return {"where": "local", "why": "placement pinned local by the caller"}
         explicit = pin not in ("", "auto")
-        if explicit and pin != target.lower():
-            return {"where": "local", "why": f"placement {pin!r} is not a routed gateway (only {target!r})"}
+        target = c.target(self_gw)
+        if explicit and (not target or pin != target.lower()):
+            # An explicit pin to another gateway does not need a route entry for it: it takes the same
+            # create_remote path as the routed target (same structural refusals below), and the
+            # liveness check below refuses a gateway that is unknown or not live.
+            target = pin
+        if not target:
+            return {"where": "local", "why": "no placement route for this gateway"}
         if origin_intent is not None:
             return {"where": "local", "why": "courier creation for another gateway"}
         # Parents are local links, so the card is created here; with ``defer_parents`` (default on) it
diff --git a/hermes_cli/kanban_worker_node.py b/hermes_cli/kanban_worker_node.py
index 399e9de981..550ecc3745 100644
--- a/hermes_cli/kanban_worker_node.py
+++ b/hermes_cli/kanban_worker_node.py
@@ -95,8 +95,8 @@ class MachinePinRefused(Exception):  # not ValueError: label-syntax handlers mus
         super().__init__(
             f"runs_on names machine:{machine}, but {why}, so no worker would ever claim the card on this board. "
             f"Nothing was written. Create it on that machine's own gateway instead (a cross-gateway create): "
-            f"kanban_create(placement=\"{machine}\") when this gateway's kanban.placement route targets "
-            f"{machine}, otherwise `hermes-hub create-task {machine} <title> --body ...`.")
+            f"kanban_create(placement=\"{machine}\") (works for any live gateway, routed or not), or "
+            f"`hermes-hub create-task {machine} <title> --body ...`.")
 
     @property
     def tool_error_fields(self) -> dict:
diff --git a/tests/hermes_cli/test_kanban_placement.py b/tests/hermes_cli/test_kanban_placement.py
index 18f843bafa..096ba4b2ff 100644
--- a/tests/hermes_cli/test_kanban_placement.py
+++ b/tests/hermes_cli/test_kanban_placement.py
@@ -167,8 +167,8 @@ def test_caller_pin_wins_both_ways():
     # Parents no longer keep a hub-pinned card from the hub: it is deferred there (not refused).
     assert decide({"title": "x", "placement": "hub", "parents": ["t_1"]}).get("defer") == "hub"
     # A gateway with no route is not a destination, and never silently becomes a local card.
-    assert decide({"title": "x", "placement": "mini"})["where"] == "refuse"
-    assert decide({"title": "x", "placement": "mini"}, cfg={})["where"] == "refuse"
+    assert decide({"title": "x", "placement": "mini"}, live=lambda t: f"{t} record missing")["where"] == "refuse"
+    assert decide({"title": "x", "placement": "mini"}, cfg={}, live=lambda t: f"{t} record missing")["where"] == "refuse"
     # Own gateway name and 'here' still mean local, with or without a route.
     assert decide({"title": "x", "placement": "macbook"})["where"] == "local"
     assert decide({"title": "x", "placement": "macbook"}, cfg={})["where"] == "local"
@@ -1120,9 +1120,9 @@ def test_configured_alias_maps_any_name_and_unknown_names_still_refuse():
     cfg = {**ROUTE, "aliases": {"ec2-hub": "hub"}}
     assert decide({"title": "x", "placement": "ec2-hub"}, cfg=cfg)["where"] == "hub"
     # Only a known gateway behind the 'hermes-' prefix resolves; anything else is refused as before.
-    d = decide({"title": "x", "placement": "hermes-mini"})
+    d = decide({"title": "x", "placement": "hermes-mini"}, live=lambda t: f"{t} record missing")
     assert d["where"] == "refuse" and d["pin"] == "hermes-mini", d
-    assert decide({"title": "x", "placement": "hermes"})["where"] == "refuse"
+    assert decide({"title": "x", "placement": "hermes"}, live=lambda t: f"{t} record missing")["where"] == "refuse"
 
 
 def test_hermes_hub_pin_through_the_tool_creates_on_the_hub_not_refused(mac):
@@ -1214,3 +1214,50 @@ def test_heavy_route_machine_check_reads_the_board_registry(monkeypatch, entry,
     machines = {"worker-1": entry} if entry else {}
     monkeypatch.setattr(wn, "registry", lambda: {"me": "macbook", "machines": machines})
     assert kp._machine_picks_up("worker-1") is ok
+
+
+# --- explicit pin to a live gateway that is not this gateway's route target ---------------------------
+# From the hub (no route entry) placement='macbook' was refused "no placement route for this gateway", so
+# kanban_create could not reach the MacBook at all. [daveey]
+
+HUB_CFG = {"route": {"macbook": "hub"}}
+NOT_LIVE = lambda target: f"{target}'s capability record is stale or missing"
+
+
+def test_pin_to_a_live_gateway_without_a_route_entry_goes_there():
+    d = decide({"title": "scratch", "placement": "macbook"}, cfg=HUB_CFG, self_gw="hub")
+    assert d["where"] == "macbook", d
+
+
+def test_pin_to_a_non_routed_gateway_goes_there_even_with_a_route_of_its_own():
+    d = decide({"title": "scratch", "placement": "mini"})  # self macbook routes to hub; mini is another
+    assert d["where"] == "mini", d
+
+
+def test_pin_without_any_route_config_goes_to_a_live_gateway():
+    assert decide({"title": "x", "placement": "macbook"}, cfg={}, self_gw="hub")["where"] == "macbook"
+
+
+def test_pin_to_an_unknown_or_not_live_gateway_is_still_refused():
+    d = decide({"title": "x", "placement": "nowhere"}, cfg=HUB_CFG, self_gw="hub", live=NOT_LIVE)
+    assert d["where"] == "refuse" and d["pin"] == "nowhere" and "not live" in d["why"], d
+
+
+@pytest.mark.parametrize("extra", [
+    {"workspace_kind": "dir", "workspace_path": "/tmp/x"},
+    {"board": "links"},
+    {"assignee": "links"},
+])
+def test_foreign_pin_keeps_the_structural_refusals(extra):
+    d = decide({"title": "x", "placement": "macbook", **extra}, cfg=HUB_CFG, self_gw="hub")
+    assert d["where"] == "refuse" and d["pin"] == "macbook", d
+
+
+def test_foreign_pin_with_parents_is_deferred_to_the_pinned_gateway():
+    d = decide({"title": "x", "placement": "macbook", "parents": ["t_1"]}, cfg=HUB_CFG, self_gw="hub")
+    assert d["where"] == "local" and d["defer"] == "macbook", d
+
+
+def test_foreign_pin_for_an_origin_bound_card_is_not_forwarded():
+    d = decide({"title": "x", "placement": "macbook"}, cfg=HUB_CFG, self_gw="hub", origin_intent="chat")
+    assert d["where"] == "local", d
diff --git a/tools/kanban_tools_schemas.py b/tools/kanban_tools_schemas.py
index 98dd8033ba..3dde14faae 100644
--- a/tools/kanban_tools_schemas.py
+++ b/tools/kanban_tools_schemas.py
@@ -744,7 +744,7 @@ KANBAN_CREATE_SCHEMA = _schema(
                 "(use it when the work needs this machine: its Chrome, "
                 "Keychain, Apple apps, launchd/Desktop state, local "
                 "checkouts). A gateway name pins it there; if the card cannot be "
-                "placed there (no placement route to it, a parent link, a "
+                "placed there (it is not live, a parent link, a "
                 "non-scratch workspace, a non-default board, an origin-bound "
                 "card, target not live, ...) the call fails with code "
                 "placement_unavailable and creates nothing (never a silent "
