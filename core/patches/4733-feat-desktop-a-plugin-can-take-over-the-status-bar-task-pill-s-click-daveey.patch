From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 21:06:19 -0800
Subject: [PATCH] feat(desktop): a plugin can take over the status-bar task
 pill's click [daveey]

The pill fires a cancellable hermes-kanban-chip window event and opens the board only if nobody prevented it.
Core names no plugin; the lanes panel uses it to open from the pill where lanes are configured.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 .../src/plugins/kanban/chip-click.test.ts     | 27 +++++++++++++++++++
 apps/desktop/src/plugins/kanban/chip-click.ts | 10 +++++++
 apps/desktop/src/plugins/kanban/plugin.tsx    | 10 +++++--
 3 files changed, 45 insertions(+), 2 deletions(-)
 create mode 100644 apps/desktop/src/plugins/kanban/chip-click.test.ts
 create mode 100644 apps/desktop/src/plugins/kanban/chip-click.ts

diff --git a/apps/desktop/src/plugins/kanban/chip-click.test.ts b/apps/desktop/src/plugins/kanban/chip-click.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..037fe0bc4773ad66862e51d3c75acb60229d294a
--- /dev/null
+++ b/apps/desktop/src/plugins/kanban/chip-click.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, it } from 'vitest'
+
+import { chipClickOpensBoard, KANBAN_CHIP_EVENT } from './chip-click'
+
+describe('status-bar task pill click', () => {
+  it('opens the board when nobody takes the click over', () => {
+    const target = new EventTarget()
+    let seen = 0
+    target.addEventListener(KANBAN_CHIP_EVENT, () => { seen += 1 })
+    expect(chipClickOpensBoard(target)).toBe(true)
+    expect(seen).toBe(1)
+  })
+
+  it('does not open the board when a listener prevents the default', () => {
+    const target = new EventTarget()
+    target.addEventListener(KANBAN_CHIP_EVENT, event => event.preventDefault())
+    expect(chipClickOpensBoard(target)).toBe(false)
+  })
+
+  it('opens the board again once that listener is gone', () => {
+    const target = new EventTarget()
+    const take = (event: Event) => event.preventDefault()
+    target.addEventListener(KANBAN_CHIP_EVENT, take)
+    target.removeEventListener(KANBAN_CHIP_EVENT, take)
+    expect(chipClickOpensBoard(target)).toBe(true)
+  })
+})
diff --git a/apps/desktop/src/plugins/kanban/chip-click.ts b/apps/desktop/src/plugins/kanban/chip-click.ts
new file mode 100644
index 0000000000000000000000000000000000000000..592304387daffd4e8f8b9976386ca758d539a74b
--- /dev/null
+++ b/apps/desktop/src/plugins/kanban/chip-click.ts
@@ -0,0 +1,10 @@
+// The status-bar task pill opens the board. A plugin that has something better to show for that click (a panel
+// about the same cards) can take it over: the pill first fires a cancellable window event, and opens the board
+// only if nobody called preventDefault(). Core names no plugin; a plugin that takes the click over is expected to
+// offer its own way to the board.
+export const KANBAN_CHIP_EVENT = 'hermes-kanban-chip'
+
+/** Fire the event; true = nobody took the click over, so the caller opens the board. */
+export function chipClickOpensBoard(target: EventTarget = window): boolean {
+  return target.dispatchEvent(new Event(KANBAN_CHIP_EVENT, { cancelable: true }))
+}
