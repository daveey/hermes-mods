+    await vi.waitFor(() => expect(progressSpy).toHaveBeenCalledWith(undefined))
+    await updates.pollUpdateProgress()
+    expect(progressSpy.mock.calls.filter(([scope]) => scope === undefined).length).toBeGreaterThanOrEqual(1)
 
