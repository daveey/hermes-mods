From de5da6292dae5ec1a6664e2b42c0c4a33fb1fdbe Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 17:06:44 -0800
Subject: [PATCH] [daveey] Version pill tests: no cascade, real switch order,
 batched drop

Review of the stale-refresh fix (subagent, APPROVE with test findings):
- afterEach stops the poller, restores Date.now and clears kept/dropped
  state with one answered round, so a failing test no longer fails the
  tests after it.
- The remote-switch test runs the real order (poller running, drop, then
  switch) and waits for the switch's own poll to land.
- New test: a dropped `batching` state never triggers the refresh.
Each of the three guarded lines, when mutated, now fails exactly its test.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../src/store/updates-progress.test.ts        | 77 +++++++++++++------
 1 file changed, 52 insertions(+), 25 deletions(-)

diff --git a/apps/desktop/src/store/updates-progress.test.ts b/apps/desktop/src/store/updates-progress.test.ts
index b821ede5093..3eee3931d35 100644
--- a/apps/desktop/src/store/updates-progress.test.ts
+++ b/apps/desktop/src/store/updates-progress.test.ts
@@ -55,7 +55,17 @@ beforeEach(() => {
   updates.$backendUpdateProgress.set(null)
 })
 
-afterEach(() => setConnection(null as never))
+afterEach(async () => {
+  // Module state outlives a test: stop the poller, unfreeze the clock, and let one answered round clear any
+  // kept/dropped state, so a failure here never cascades into the next test.
+  updates.stopUpdatePoller()
+  vi.restoreAllMocks()
+  progressSpy.mockReset()
+  progressSpy.mockResolvedValue({ progress: null })
+  setConnection(remote)
+  await updates.pollUpdateProgress()
+  setConnection(null as never)
+})
 
 describe('pollUpdateProgress', () => {
   it('pins the client pill to this machine and reads the remote host for the backend pill', async () => {
@@ -121,24 +131,16 @@ describe('pollUpdateProgress', () => {
     progressSpy.mockImplementation(async (scope?: { connectionId?: string }) => (scope ? { progress: null } : applying))
     await updates.pollUpdateProgress()
 
-    const now = Date.now()
-    const clock = vi.spyOn(Date, 'now').mockReturnValue(now + updates.UPDATE_PROGRESS_STALE_MS + 1)
-
-    progressSpy.mockImplementation(async (scope?: { connectionId?: string }) => {
-      if (scope) {
-        return { progress: null }
-      }
-
-      throw new Error('gone')
-    })
+    pastStaleBound()
+    progressSpy.mockImplementation(failRemote)
     await updates.pollUpdateProgress()
+    vi.restoreAllMocks()
 
     expect(updates.$backendUpdateProgress.get()).toBeNull()
     expect(checkHermesUpdateSpy).not.toHaveBeenCalled()
 
     progressSpy.mockImplementation(async () => ({ progress: null }))
     await updates.pollUpdateProgress()
-    clock.mockRestore()
 
     await vi.waitFor(() => expect(checkHermesUpdateSpy).toHaveBeenCalledWith(true))
     expect(checkHermesUpdateSpy).toHaveBeenCalledTimes(1)
@@ -148,31 +150,56 @@ describe('pollUpdateProgress', () => {
     expect(checkHermesUpdateSpy).toHaveBeenCalledTimes(1)
   })
 
+  const failRemote = async (scope?: { connectionId?: string }) => {
+    if (scope) {
+      return { progress: null }
+    }
+
+    throw new Error('gone')
+  }
+
+  const pastStaleBound = () => vi.spyOn(Date, 'now').mockReturnValue(Date.now() + updates.UPDATE_PROGRESS_STALE_MS + 1)
+
   it('a dropped update on one remote never refreshes the next remote', async () => {
     setConnection(remote)
     progressSpy.mockImplementation(async (scope?: { connectionId?: string }) => (scope ? { progress: null } : applying))
