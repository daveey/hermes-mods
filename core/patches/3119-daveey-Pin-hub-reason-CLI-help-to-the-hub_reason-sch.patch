From 6768f8aa3247bae044710cd4b17fe7fa1e36d291 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 03:48:23 +0000
Subject: [PATCH] [daveey] Pin --hub-reason CLI help to the hub_reason schema
 description

A parity test fails when the kanban create --hub-reason help and the kanban_create hub_reason description drift apart (follow-up to the PR #1761 review nit). Behavior unchanged.
---
 tests/test_kanban_hub_admission_entry.py | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/tests/test_kanban_hub_admission_entry.py b/tests/test_kanban_hub_admission_entry.py
index 8c47b8d1b6..cf7c821ec9 100644
--- a/tests/test_kanban_hub_admission_entry.py
+++ b/tests/test_kanban_hub_admission_entry.py
@@ -113,6 +113,22 @@ def test_cli_runs_on_machine_hub(hub_cli, monkeypatch, admit):
             assert rc == 2 and tasks == []  # refused: the creator re-places it
 
 
+def test_cli_hub_reason_help_matches_tool_schema():
+    """`--hub-reason` help and the kanban_create `hub_reason` description must not drift apart."""
+    from hermes_cli.kanban_parser import build_parser
+    from tools.kanban_tools_schemas import KANBAN_CREATE_SCHEMA
+
+    def sub(parser, name):
+        action = next(a for a in parser._actions if isinstance(a, argparse._SubParsersAction))
+        return action.choices[name]
+
+    root = argparse.ArgumentParser()
+    build_parser(root.add_subparsers())
+    create = sub(sub(root, "kanban"), "create")
+    (help_text,) = [a.help for a in create._actions if a.dest == "hub_reason"]
+    assert help_text == KANBAN_CREATE_SCHEMA["parameters"]["properties"]["hub_reason"]["description"]
+
+
 def test_cli_force_hub_outside_worker_is_recorded(hub_cli):
     assert _cli_create(MARKED, "--force-hub") == 0
     assert hub_cli.calls == []
