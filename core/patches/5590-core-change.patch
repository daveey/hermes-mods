From 9899612e2a9857c95765c66dc61a1d0d7c53f83b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 10:31:21 +0000
Subject: [PATCH] test(kanban): exercise capacity limits with eligible profile
 registries [daveey]

---
 tests/hermes_cli/test_kanban_memory_guard.py    | 8 ++++++++
 tests/hermes_cli/test_kanban_per_profile_cap.py | 7 ++++++-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_memory_guard.py b/tests/hermes_cli/test_kanban_memory_guard.py
index 3b2de741e7..7a183c7a55 100644
--- a/tests/hermes_cli/test_kanban_memory_guard.py
+++ b/tests/hermes_cli/test_kanban_memory_guard.py
@@ -33,6 +33,14 @@ def kanban_home(tmp_path, monkeypatch):
     home.mkdir()
     monkeypatch.setenv("HERMES_HOME", str(home))
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    from hermes_cli.kanban_model_assignment import _assignee_config
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    assert _assignee_config("alice") is None
+    profile = home / "profiles" / "alice"
+    profile.mkdir(parents=True)
+    (profile / "config.yaml").write_text(_managed_yaml())
+    config = _assignee_config("alice")
+    assert config is not None and config["model_routing"]["enabled"]
     kb.init_db()
     return home
 
diff --git a/tests/hermes_cli/test_kanban_per_profile_cap.py b/tests/hermes_cli/test_kanban_per_profile_cap.py
index fdbcd861a9..ceccef5de5 100644
--- a/tests/hermes_cli/test_kanban_per_profile_cap.py
+++ b/tests/hermes_cli/test_kanban_per_profile_cap.py
@@ -19,10 +19,11 @@ import pytest
 def isolated_kanban_home_with_profiles(monkeypatch):
     """Spin up a fresh HERMES_HOME with kanban DB + alpha/beta profiles."""
     test_home = tempfile.mkdtemp(prefix="kanban_per_profile_cap_test_")
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
     for prof in ("alpha", "beta", "default"):
         os.makedirs(os.path.join(test_home, "profiles", prof), exist_ok=True)
         with open(os.path.join(test_home, "profiles", prof, "config.yaml"), "w") as fh:
-            fh.write("{}\n")  # identity marker: a bare dir is not a profile
+            fh.write(_managed_yaml())  # real class eligibility as well as profile identity
     monkeypatch.setenv("HERMES_HOME", test_home)
     # Same restore as isolated_kanban_home: a wipe that is not undone poisons
     # every later file in the process (they patch one module object, code runs another).
@@ -34,6 +35,10 @@ def isolated_kanban_home_with_profiles(monkeypatch):
         del sys.modules[name]
     try:
         from hermes_cli import kanban_db
+        from hermes_cli.kanban_model_assignment import _assignee_config
+        for prof in ("alpha", "beta"):
+            config = _assignee_config(prof)
+            assert config is not None and config["model_routing"]["enabled"]
         # conftest guard patches _system_memory_sample only on the module object
         # imported before the purge above; dispatch uses the reimported module,
         # which would read live host memory and flake under pressure.
-- 
