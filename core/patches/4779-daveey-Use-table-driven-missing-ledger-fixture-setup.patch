From 4e092e6b263ff7e2bae7aaca02c880ee2ddc87b7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 06:39:15 +0000
Subject: [PATCH] [daveey] Use table-driven missing-ledger fixture setup

---
 .../test_origin_forward_missing_ledger.py       | 17 +++++++++--------
 1 file changed, 9 insertions(+), 8 deletions(-)

diff --git a/tests/hermes_cli/test_origin_forward_missing_ledger.py b/tests/hermes_cli/test_origin_forward_missing_ledger.py
index 85fecc66f3329e10317daac0ae81dec2f3e928a0..5427f4de1de2707e0fd891bce2310ccec7c78676 100644
--- a/tests/hermes_cli/test_origin_forward_missing_ledger.py
+++ b/tests/hermes_cli/test_origin_forward_missing_ledger.py
@@ -27,14 +27,15 @@ def test_adapter_missing_vs_unavailable(forwarding, authority, tmp_path, monkeyp
     ledger = home / "kanban/origin-ledger.db"
     if case != "absent_parent":
         ledger.parent.mkdir()
-    if case == "dangling":
-        ledger.symlink_to(home / "missing-target")
-    elif case == "directory":
-        ledger.mkdir()
-    elif case == "corrupt":
-        ledger.write_bytes(b"not a SQLite database" * 20)
-    elif case in ("permission", "open_race"):
-        ledger.write_bytes(authority[0].read_bytes())
+    setup = {
+        "dangling": lambda: ledger.symlink_to(home / "missing-target"),
+        "directory": ledger.mkdir,
+        "corrupt": lambda: ledger.write_bytes(b"not a SQLite database" * 20),
+        "permission": lambda: ledger.write_bytes(authority[0].read_bytes()),
+        "open_race": lambda: ledger.write_bytes(authority[0].read_bytes()),
+    }
+    if case in setup:
+        setup[case]()
 
     monkeypatch.setattr(hermes_constants, "get_hermes_home", lambda: home)
     monkeypatch.setattr(profiles, "get_active_profile_name", lambda: "default")
-- 
