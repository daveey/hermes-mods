From 8ca245d223968549627f8540bb17f912e5292d5c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 08:30:54 +0000
Subject: [PATCH] fix(gateway): a supervised start that attaches to an
 unsupervised owner of its own home hands the home back [daveey]

Self-heal defect gateway-e2cd786685, second pass. 0e47c674ec put the handback in start_gateway's
duplicate guard, but once the unsupervised owner publishes its host record the KeepAlive job's
retries stop earlier, in the CLI's host-attach guard ("nothing to start", exit 75), before
start_gateway runs. On the mini, hermes update (via hermes-sync) relaunched a manual gateway for
~/.bb-hermes at 00:40 PDT and com.daveey.myapp.hermes looped exit 75 with no handback and no
gateway-exit-diag row at all, so the coach wedge detector never saw it.

_attach_to_host_gateway_or_guard: under a supervisor, an ATTACH to a live owner launched from THIS
home now records gateway.start_refused (already_running, detail host_attach, external_supervisor)
and runs the same handback (planned-stop marker for a manual owner only). Exit code unchanged. A
profile unit attaching to a host multiplexer from another home, and an unsupervised gateway run,
are untouched.

Tests: test_gateway_start_refused.py: real run_gateway entry through the attach guard (manual /
launchd / unknown owner), other-home attach, unsupervised attach.
---
 hermes_cli/gateway.py                         | 30 +++++++
 .../hermes_cli/test_gateway_start_refused.py  | 87 +++++++++++++++++++
 2 files changed, 117 insertions(+)

diff --git a/hermes_cli/gateway.py b/hermes_cli/gateway.py
index 1c951bea8b2..7e1d1850405 100644
--- a/hermes_cli/gateway.py
+++ b/hermes_cli/gateway.py
@@ -4334,6 +4334,35 @@ def _host_decision_exit_code(decision) -> int:
     return GATEWAY_FATAL_CONFIG_EXIT_CODE
 
 
+def _supervised_attach_to_owner_of_this_home(decision) -> None:
+    """[daveey] A supervised start that ATTACHES to a live gateway launched from THIS home is a refusal.
+
+    gateway-e2cd786685: ``hermes update`` (run by hermes-sync) relaunched an unsupervised gateway for
+    the home that the mini's KeepAlive job supervises. Once that gateway published its host record,
+    every KeepAlive retry stopped here ("nothing to start", exit 75) before ``start_gateway`` ran, so
+    neither the duplicate guard's handback (``run_bootstrap._hand_home_back_to_supervisor``) nor any
+    exit-diag row ever happened, and the job looped for hours with no signal. Record the refusal in
+    ``gateway-exit-diag.log`` (the coach's wedge detector reads it) and ask a MANUAL owner to drain;
+    the exit code stays the caller's. A profile unit attaching to a host multiplexer launched from
+    another home is a real attach and is left alone.
+    """
+    owner = getattr(decision, "owner", None)
+    if owner is None:
+        return
+    try:
+        if Path(owner.home).expanduser().resolve() != Path(get_hermes_home()).expanduser().resolve():
+            return
+        from gateway.run_bootstrap import _hand_home_back_to_supervisor
+        from gateway.run_exit_reason import note_start_refused
+        from hermes_cli.gateway_exit_diag import make_exit_diag, nonzero_exit_record
+        note_start_refused("already_running", owner_pid=owner.pid, detail="host_attach")
+        _hand_home_back_to_supervisor(owner.pid)
+        tag, extra = nonzero_exit_record()
+        make_exit_diag()(tag, **extra)
+    except Exception:  # health: allow BLE001 -- recording/handback is best-effort; the attach exit stands
+        logger.debug("Supervised attach refusal record failed", exc_info=True)
+
+
 def _attach_to_host_gateway_or_guard(force: bool = False, replace: bool = False) -> None:
     """``gateway run`` against the ONE host gateway: attach, rescan-then-attach, replace, or refuse.
 
@@ -4364,6 +4393,7 @@ def _attach_to_host_gateway_or_guard(force: bool = False, replace: bool = False)
             logger.warning("gateway run refused (exit %d): %s", code, decision.message)
             sys.exit(code)
         if _running_under_gateway_supervisor():
+            _supervised_attach_to_owner_of_this_home(decision)
             sys.exit(_host_decision_exit_code(decision))
         sys.exit(0)
     # No host record (older gateway, unwritable lock dir): the config-derived refusal still applies.
diff --git a/tests/hermes_cli/test_gateway_start_refused.py b/tests/hermes_cli/test_gateway_start_refused.py
index e66e03c39a0..a557b27c208 100644
--- a/tests/hermes_cli/test_gateway_start_refused.py
+++ b/tests/hermes_cli/test_gateway_start_refused.py
@@ -214,3 +214,90 @@ def test_supervised_start_refused_by_manual_owner_hands_the_home_back(
     else:
         assert marked == []
         assert "handback" not in row
+
+
+# [daveey] gateway-e2cd786685 (second pass): once the unsupervised owner has published its host record,
+# the supervisor's retries never reach start_gateway's duplicate guard. The CLI's host-attach guard
+# answers ATTACH ("nothing to start") and exits 75 first, so the handback above never ran and no
+# exit-diag row was written: the mini looped `- 75` for hours with no signal. A supervised start that
+# attaches to a live owner of ITS OWN home is the same refusal: it is recorded and handed back.
+def _attach_decision(monkeypatch, owner_pid: int, owner_home: Path):
+    from gateway import host_attach
+
+    owner = host_attach.HostGateway(owner_pid, owner_home, ("default",))
+    decision = host_attach.HostAttachDecision(host_attach.ATTACH, "nothing to start", owner, transient=True)
+    monkeypatch.setattr(host_attach, "decide", lambda home, replace=False: decision)
+
+
+def _prepare_attach_cli(monkeypatch, supervised_start):
+    import hermes_cli.gateway as gateway_cli_module
+
+    real_guard = gateway_cli_module._attach_to_host_gateway_or_guard  # _prepare_cli stubs it out
+    gateway_cli, _ = _prepare_cli(monkeypatch)
+    monkeypatch.setattr(gateway_cli, "_attach_to_host_gateway_or_guard", real_guard)
+    from gateway import control_socket, status
+    marked: list[int] = []
+    monkeypatch.setattr(status, "write_planned_stop_marker", lambda pid: marked.append(pid) or True)
+    monkeypatch.setattr(sys, "argv", ["hermes", "gateway", "run", *(["--external-supervisor"] if supervised_start else [])])
+    # What gateway_command() exports for --external-supervisor before run_gateway().
+    for var in ("INVOCATION_ID", "XPC_SERVICE_NAME", "HERMES_LAUNCHD_LABEL", "HERMES_S6_SUPERVISED_CHILD"):
+        monkeypatch.delenv(var, raising=False)
+    if supervised_start:
+        monkeypatch.setenv("HERMES_GATEWAY_EXTERNAL_SUPERVISOR", "1")
+    else:
+        monkeypatch.delenv("HERMES_GATEWAY_EXTERNAL_SUPERVISOR", raising=False)
+    return gateway_cli, control_socket, marked
+
+
+@pytest.mark.parametrize("owner_supervisor,expect_handback", [
+    ("manual", True),     # the live failure: a client-spawned gateway holds the job's home
+    ("launchd", False),   # a supervised copy still draining is waited for, never stopped
+    (None, False),        # owner did not answer identify
+])
+def test_supervised_attach_to_owner_of_this_home_is_a_recorded_refusal_with_handback(
+        monkeypatch, live_pid, owner_supervisor, expect_handback):
+    gateway_cli, control_socket, marked = _prepare_attach_cli(monkeypatch, True)
+    home = Path(os.environ["HERMES_HOME"])
+    _attach_decision(monkeypatch, live_pid, home)
+    identity = {} if owner_supervisor is None else {"pid": live_pid, "launch_supervisor": owner_supervisor}
+    monkeypatch.setattr(control_socket, "identify_gateway", lambda *a, **k: identity)
+
+    with pytest.raises(SystemExit) as exc:
+        gateway_cli.run_gateway()
+    assert exc.value.code == 75  # unchanged: launchd retries, and the retry takes the drained home
+    row = _assert_refused("already_running", live_pid, True)
+    assert row["external_supervisor"] is True
+    assert row["detail"] == "host_attach"
+    if expect_handback:
+        assert marked == [live_pid]
+        assert row["handback"] == "planned_stop_requested"
+    else:
+        assert marked == []
+        assert "handback" not in row
+
+
+def test_supervised_attach_to_a_host_gateway_of_another_home_is_not_a_refusal(monkeypatch, live_pid, tmp_path):
+    """A profile unit whose profile the host multiplexer (launched from another home) serves: a real attach."""
+    gateway_cli, control_socket, marked = _prepare_attach_cli(monkeypatch, True)
+    _attach_decision(monkeypatch, live_pid, tmp_path / "other-home")
+    monkeypatch.setattr(control_socket, "identify_gateway",
+                        lambda *a, **k: {"pid": live_pid, "launch_supervisor": "manual"})
+    with pytest.raises(SystemExit) as exc:
+        gateway_cli.run_gateway()
+    assert exc.value.code == 75
+    assert marked == []
+    log = Path(os.environ["HERMES_HOME"]) / "logs" / "gateway-exit-diag.log"
+    assert not log.exists() or "gateway.start_refused" not in log.read_text(encoding="utf-8")
+
+
+def test_unsupervised_attach_stays_a_clean_attach(monkeypatch, live_pid):
+    """A plain `hermes gateway run` beside the live owner still prints who serves it and exits 0."""
+    gateway_cli, control_socket, marked = _prepare_attach_cli(monkeypatch, False)
+    _attach_decision(monkeypatch, live_pid, Path(os.environ["HERMES_HOME"]))
+    monkeypatch.setattr(control_socket, "identify_gateway",
+                        lambda *a, **k: {"pid": live_pid, "launch_supervisor": "manual"})
+    monkeypatch.setattr(gateway_cli, "_running_under_gateway_supervisor", lambda: False)
+    with pytest.raises(SystemExit) as exc:
+        gateway_cli.run_gateway()
+    assert exc.value.code == 0
+    assert marked == []
