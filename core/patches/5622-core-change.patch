From 4d5c86da1a337c9f054d4734e48557e511002284 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 17:37:03 +0000
Subject: [PATCH] fix(kanban): exclude catalog routing sentinels from model
 identity [daveey]

CI44929226753 exposed112 failures in10 owner-wake and hold-release consumer files: offline catalog moa/default was treated as a concrete model and ordinary default/task context as a mandate. Exclude transport sentinels rather than exempting supervision bodies. Preserve actual model obligations and appended active-directive no-write refusal. Focused baseline reproduced refusal; first focused4files green, retained importer/facade plus all failed CI consumers green with retries OFF. Independent exact-head review, required CI, canonical landing and all fleet acceptance remain owed.
---
 hermes_cli/kanban_model_neutral.py            |  3 ++
 .../test_kanban_model_neutral_sentinels.py    | 35 +++++++++++++++++++
 2 files changed, 38 insertions(+)
 create mode 100644 tests/hermes_cli/test_kanban_model_neutral_sentinels.py

diff --git a/hermes_cli/kanban_model_neutral.py b/hermes_cli/kanban_model_neutral.py
index a16f0f2bb7..4937146725 100644
--- a/hermes_cli/kanban_model_neutral.py
+++ b/hermes_cli/kanban_model_neutral.py
@@ -17,6 +17,9 @@ def _model_names():
     """Offline catalog identity, not vendor-prefix guesses or live entitlement."""
     from hermes_cli.models_catalog_static import _PROVIDER_MODELS
     names = {name.lower().rsplit('/', 1)[-1] for rows in _PROVIDER_MODELS.values() for name in rows}
+    # Catalog transport selectors (e.g. moa/default) are not model identities.
+    # Otherwise ordinary board/profile references such as default/task become pins.
+    names.difference_update({'default', 'auto'})
     # These are human shorthand for catalog families, not arbitrary claude-* tools.
     aliases = {alias for alias in ('opus', 'sonnet', 'fable', 'astra', 'luna', 'sol')
                if any(alias in re.split(r'[-.]', name) for name in names)}
diff --git a/tests/hermes_cli/test_kanban_model_neutral_sentinels.py b/tests/hermes_cli/test_kanban_model_neutral_sentinels.py
new file mode 100644
index 0000000000..bde503571a
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_model_neutral_sentinels.py
@@ -0,0 +1,35 @@
+"""Catalog routing sentinels must not turn board references into model pins."""
+import pytest
+
+from hermes_cli import kanban_db as kb
+from tests.hermes_cli import test_kanban_containment_lifecycle as chelpers
+
+board = chelpers.board
+
+
+@pytest.mark.parametrize('text', [
+    'Supervise each: read the card ... - default/t_ffffffffffffffff is only context here. Complete this card with what you changed.',
+    'Use default board for this card.',
+    'Use auto placement and preserve independent review.',
+    'The default profile is required for the fixture.',
+    'default/t_ffffffffffffffff is only context here.',
+])
+def test_routing_sentinel_context_creates_unchanged(board, text):
+    tid = kb.create_task(board, title='Supervision context', body=text)
+    task = kb.get_task(board, tid)
+    assert task is not None
+    assert task.body == text
+    assert task.model_override is None and task.provider_override is None
+
+
+@pytest.mark.parametrize('directive', [
+    'Use claude-opus-5-5.',
+    'Use gpt-6-luna.',
+    'require_model: true',
+])
+def test_sentinel_context_does_not_hide_active_mandate(board, directive):
+    text = 'default/t_ffffffffffffffff is only context here.\n' + directive
+    before = board.execute('SELECT COUNT(*) FROM tasks').fetchone()[0]
+    with pytest.raises(ValueError, match='refused line:'):
+        kb.create_task(board, title='Supervision context', body=text)
+    assert board.execute('SELECT COUNT(*) FROM tasks').fetchone()[0] == before
