 # The CI run the park names has a job queued past the limit with no runner (``kanban_ci_progress``).
 CI_RUN_UNSTARTABLE = "ci_run_unstartable"
 SOAK_WAIT = "soak_wait"
+NO_CHAT_SUBSCRIBER = "no_chat_subscriber"
