From 09ee730d4613a66148d0d11cbfa16052e8887bb1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:39:58 +0000
Subject: [PATCH] fix(kanban): keep deflake guidance independent of home
 runners [daveey]

---
 scripts/ci/flaky_kanban.py       |  2 +-
 tests/ci/test_flaky_placement.py | 10 ++++++++++
 2 files changed, 11 insertions(+), 1 deletion(-)
 create mode 100644 tests/ci/test_flaky_placement.py

diff --git a/scripts/ci/flaky_kanban.py b/scripts/ci/flaky_kanban.py
index 4d744b9e39..8704e7d5d0 100644
--- a/scripts/ci/flaky_kanban.py
+++ b/scripts/ci/flaky_kanban.py
@@ -255,7 +255,7 @@ def _card_body(entry: dict[str, str], run_url: str, branch: str, previous: str |
         f"It failed on its first attempt and passed when CI retried it ({run_url}, branch `{branch}`).",
         "The retry keeps the job green, so this card is the only signal. Fix the cause, don't widen the retry.",
         "",
-        "Usual cause on the hub runners: a fixed wall-clock deadline (sleep, short wait/join timeout, short",
+        "Usual cause on the CI runners: a fixed wall-clock deadline (sleep, short wait/join timeout, short",
         "lease) that a CPU-throttled container misses. Wait on events or use generous timeouts that return",
         "as soon as the condition holds. Reproduce by starving the process (SIGSTOP/SIGCONT duty cycle) rather",
         "than on a quiet laptop.",
diff --git a/tests/ci/test_flaky_placement.py b/tests/ci/test_flaky_placement.py
new file mode 100644
index 0000000000..92e6a19fbc
--- /dev/null
+++ b/tests/ci/test_flaky_placement.py
@@ -0,0 +1,10 @@
+"""Deflake guidance must not imply that the work needs the creator's host."""
+from hermes_cli import kanban_placement as placement
+from scripts.ci import flaky_kanban
+
+
+def test_deflake_template_is_portable():
+    body = flaky_kanban._card_body({"test_id": "tests/test_example.py::test_wait"},
+                                   "https://github.com/example/project/actions/runs/1", "main", None)
+    assert "Usual cause on the CI runners" in body
+    assert placement.portable_reason({"title": "Deflake test_wait", "body": body}, {}) is None
-- 
2.43.0

