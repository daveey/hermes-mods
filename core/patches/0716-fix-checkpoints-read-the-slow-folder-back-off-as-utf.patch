From 95568533b461bf9e1db4aa13b136d5033018cae8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 03:52:49 -0700
Subject: [PATCH] fix(checkpoints): read the slow-folder back-off as utf-8-sig
 (Windows footgun red on main) [daveey]

---
 tests/tools/test_checkpoint_manager.py | 11 +++++++++++
 tools/checkpoint_staging.py            |  2 +-
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/tests/tools/test_checkpoint_manager.py b/tests/tools/test_checkpoint_manager.py
index 9d91484eb4..8565595909 100644
--- a/tests/tools/test_checkpoint_manager.py
+++ b/tests/tools/test_checkpoint_manager.py
@@ -1696,3 +1696,14 @@ class TestStagingBudget:
         assert out.returncode == 0, out.stderr
         result = json.loads(out.stdout.strip().splitlines()[-1])
         assert result == {"took": False, "adds": 0}, (result, out.stderr[-2000:])
+
+
+def test_slow_dir_backoff_file_with_bom_is_read(tmp_path):
+    """Windows tools BOM files they touch; the persisted back-off must still load."""
+    import tools.checkpoint_staging as staging
+
+    store = tmp_path / "store"
+    path = staging._slow_file(store)
+    path.parent.mkdir(parents=True)
+    path.write_bytes(b"\xef\xbb\xbf" + json.dumps({"/w": 123.0}).encode())
+    assert staging._read_slow(store) == {"/w": 123.0}
diff --git a/tools/checkpoint_staging.py b/tools/checkpoint_staging.py
index 4e800db246..9aeffd6c9f 100644
--- a/tools/checkpoint_staging.py
+++ b/tools/checkpoint_staging.py
@@ -219,7 +219,7 @@ def _slow_file(store: Path) -> Path:
 
 def _read_slow(store: Path) -> dict[str, float]:
     try:
-        data = json.loads(_slow_file(store).read_text(encoding="utf-8"))
+        data = json.loads(_slow_file(store).read_text(encoding="utf-8-sig"))
     except (OSError, ValueError):
         return {}
     if not isinstance(data, dict):
-- 
