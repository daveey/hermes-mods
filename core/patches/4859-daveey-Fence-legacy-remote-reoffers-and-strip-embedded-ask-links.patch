From 014646565b87ec7011f8c475614052005f62013f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 11:50:21 +0000
Subject: [PATCH] [daveey] Fence legacy remote reoffers and strip embedded ask
 links

---
 gateway/kanban_wake_fold.py                   |  4 +++-
 .../test_kanban_remote_owner_delivery.py      |  5 ++++-
 .../tui_gateway/test_kanban_remote_rehome.py  | 19 +++++++++++++++++
 tui_gateway/kanban_remote_notices.py          | 21 +++++++++++++------
 4 files changed, 41 insertions(+), 8 deletions(-)

diff --git a/gateway/kanban_wake_fold.py b/gateway/kanban_wake_fold.py
index d5ab1332856a40960d29db38f854d4d966157f8a..a582e2f582729132da5008cfee6fbd332002a50f 100644
--- a/gateway/kanban_wake_fold.py
+++ b/gateway/kanban_wake_fold.py
@@ -208,7 +208,9 @@ def _live_task(card):
 def _without_superseded_ask(lines):
     """Remove the formatter's whole ask block, including multiline field values."""
     start = next((i for i, line in enumerate(lines) if line.startswith('Next action for the user:')), None)
-    end = next((i for i, line in enumerate(lines) if line.startswith('Open task:')
+    # Field values may themselves contain an Open task line; the formatter's
+    # closing link follows all multiline fields, not their first embedded link.
+    end = next((i for i in range(len(lines) - 1, -1, -1) if lines[i].startswith('Open task:')
                 and start is not None and i > start), None)
     if start is not None and end is not None:
         lines = lines[:start] + lines[end + 1:]
diff --git a/tests/gateway/test_kanban_remote_owner_delivery.py b/tests/gateway/test_kanban_remote_owner_delivery.py
index 13277fb4d9b650282a48b33824204e591140ca09..a3f046293f4f2897a764ef863a749f79bf43964d 100644
--- a/tests/gateway/test_kanban_remote_owner_delivery.py
+++ b/tests/gateway/test_kanban_remote_owner_delivery.py
@@ -65,13 +65,16 @@ def test_remote_blocked_notice_refreshes_replica_only_card(monkeypatch, status):
         assert 'Result: Waiver completed' in text
 
 
+@pytest.mark.parametrize('embedded_link', [False, True])
 @pytest.mark.parametrize('dropped', [False, True])
-def test_resolved_real_notice_drops_multiline_ask_presentation(monkeypatch, dropped):
+def test_resolved_real_notice_drops_multiline_ask_presentation(monkeypatch, dropped, embedded_link):
     from hermes_cli.kanban_block_notice import block_notice
     tid = 't_78d2b488ee11aa70'
     request: dict = {'action': 'Choose A\nThen unblock this card', 'why_human': 'Only you\ncan grant access',
                'scope': 'One machine\nand its credentials', 'interaction': 'user_terminal',
                'evidence': 'Access denied'}
+    if embedded_link:
+        request['scope'] = f'One machine\nOpen task: @task:default/{tid}\nand its credentials'
     if dropped:
         request['resolved_check_dropped_at'] = 10
     text = block_notice({'status': 'blocked', 'block_kind': 'needs_input', 'human_request': request,
diff --git a/tests/tui_gateway/test_kanban_remote_rehome.py b/tests/tui_gateway/test_kanban_remote_rehome.py
index 386f6981acd88a6407cfc73b9362e045b3716687..d725f4913b333ff5830ee795f8d234d74d01b4ac 100644
--- a/tests/tui_gateway/test_kanban_remote_rehome.py
+++ b/tests/tui_gateway/test_kanban_remote_rehome.py
@@ -188,6 +188,25 @@ def test_unconfirmed_legacy_delivery_does_not_suppress_moved_state(tmp_path):
     assert len(offered) == 1
 
 
+def test_legacy_returning_home_respects_live_successor(tmp_path):
+    now = time.time()
+    hub = once._hub(tmp_path, now)
+    ledger = tmp_path / 'ledger.db'
+    _move(hub, 'worker-6')
+    krn.collect(once.CHAT, 'default', hub_db=hub, ledger=ledger, now=now)
+    with sqlite3.connect(ledger) as conn:
+        conn.execute('UPDATE notices SET delivered=1, notice_key=NULL, legacy_seen=0')
+    _move(hub, 'hub')
+    with once._chat(tmp_path) as (_db, opener):
+        waker = once._Waker('started')
+        krn.sweep_remote_notices(replica_path=hub, gateway='macbook', session_db=opener,
+                                 ledger=ledger, now=now + 10, waker=waker)
+        assert waker.calls == 1
+        _move(hub, 'worker-6')
+        assert krn.collect(once.CHAT, 'default', hub_db=hub, ledger=ledger, now=now + 20,
+                           transcript_has=lambda *_: False) == []
+
+
 @pytest.mark.parametrize('running', [False, True])
 def test_moved_woken_claim_recovers_only_after_turn_ends(tmp_path, running):
     now = time.time()
diff --git a/tui_gateway/kanban_remote_notices.py b/tui_gateway/kanban_remote_notices.py
index 637bffd02b017f10f951035e88f66de337ea98bc..e2afef2bf39a0e32272658e8217d18910c9fa441 100644
--- a/tui_gateway/kanban_remote_notices.py
+++ b/tui_gateway/kanban_remote_notices.py
@@ -521,12 +521,21 @@ def _reconcile_legacy(conn, session_key: str, cards: list, now: float, transcrip
             conn.execute("UPDATE notices SET legacy_seen=1, notice_key=? WHERE session=? AND ref=? AND state=?",
                          (key, session_key, row["ref"], row["state"]))
             continue
-        cur = conn.execute(
-            "UPDATE notices SET delivered=0, holder_pid=?, holder_start=?, notice_key=?, legacy_seen=1 "
-            "WHERE session=? AND ref=? AND state=? AND delivered=1 AND IFNULL(legacy_seen,0)=0",
-            (pid, start, key, session_key, row["ref"], row["state"]))
-        if cur.rowcount == 1:
-            out.append(_notice_item(card, session_key, me, profile, now))
+        with conn:
+            if not conn.in_transaction:
+                conn.execute('BEGIN IMMEDIATE')
+            from tui_gateway.kanban_remote_identity import moved_claim
+            moved = moved_claim(conn, session=session_key, ref=row['ref'], state=row['state'],
+                                now=now, notice_key=key, swept_key=None, transcript_has=transcript_has)
+            if moved is not None:
+                continue
+            cur = conn.execute(
+                "UPDATE notices SET delivered=0, holder_pid=?, holder_start=?, notice_key=?, legacy_seen=1 "
+                "WHERE session=? AND ref=? AND state=? AND delivered=1 AND IFNULL(legacy_seen,0)=0 "
+                "AND notice_key IS NULL",
+                (pid, start, key, session_key, row["ref"], row["state"]))
+            if cur.rowcount == 1:
+                out.append(_notice_item(card, session_key, me, profile, now))
     if stale:
         logger.info("remote kanban: left %d delivered notice(s) unreoffered "
                     "(older than %.0fh, or not in the replica)", stale, FRESH_S / 3600)
