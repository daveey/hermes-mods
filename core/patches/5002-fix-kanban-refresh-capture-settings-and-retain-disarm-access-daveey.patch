@@ -101,6 +101,26 @@ def test_real_daemon_binds_before_dispatch_and_closes(tmp_path, monkeypatch, ena
         assert not (tmp_path / "capture").exists()
 
 
+def test_disarm_after_config_reset_uses_existing_directory(tmp_path):
+    from hermes_cli import kanban_fairness_activation as activation
+    cfg = config(tmp_path)
+    activation.arm(cfg, home=tmp_path, board="default", source_gateway="gw", board_uid="board")
+    root = tmp_path / "capture"
+    original = (root / activation.NAME).read_bytes()
+    activation.disarm({}, home=tmp_path, directory=root)
+    assert not (root / activation.NAME).exists()
+    assert (root / activation.DISARMED).read_bytes() == original
+    activation.disarm({}, home=tmp_path, directory=root)
+
+
+def test_explicit_disarm_refuses_other_profile(tmp_path):
+    from hermes_cli import kanban_fairness_activation as activation
+    activation.arm(config(tmp_path), home=tmp_path, board="default", source_gateway="gw", board_uid="board")
+    with pytest.raises(ValueError):
+        activation.disarm({}, home=tmp_path / "other", directory=tmp_path / "capture")
+    assert (tmp_path / "capture" / activation.NAME).exists()
+
+
 def test_disarm_does_not_require_enabled_config(tmp_path):
     from hermes_cli import kanban_fairness_activation as activation
     cfg = config(tmp_path)
@@ -108,3 +128,22 @@ def test_disarm_does_not_require_enabled_config(tmp_path):
     cfg["kanban"]["fairness_capture"]["enabled"] = False
     activation.disarm(cfg, home=tmp_path)
     assert not (tmp_path / "capture" / activation.NAME).exists()
+
+
+def test_real_cli_disarm_after_reset(tmp_path, monkeypatch):
+    import os
+    from pathlib import Path
+    import subprocess
+    import sys
+    from hermes_cli import kanban_fairness_activation as activation
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    activation.arm(config(tmp_path), home=tmp_path, board="default", source_gateway="gw", board_uid="board")
+    repo = Path(__file__).resolve().parents[2]
+    result = subprocess.run(
+        [sys.executable, str(repo / "scripts" / "kanban_fairness.py"), "runtime", "disarm",
+         "--directory", str(tmp_path / "capture")],
+        cwd=repo, env=dict(os.environ), capture_output=True, text=True, timeout=30, check=False)
+    assert result.returncode == 0, result.stderr
+    assert json.loads(result.stdout)["runtime"] == "disarm"
+    assert (tmp_path / "capture" / activation.DISARMED).is_file()
+    assert not (tmp_path / "capture" / activation.NAME).exists()
diff --git a/tests/hermes_cli/test_kanban_fairness_worker.py b/tests/hermes_cli/test_kanban_fairness_worker.py
new file mode 100644
index 0000000000000000000000000000000000000000..3409a52857e916b0a567a58865b667b9ebfe3018
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_fairness_worker.py
@@ -0,0 +1,24 @@
+"""Only capture observation settings refresh at ordinary worker turn admission."""
+from types import SimpleNamespace
+
+import pytest
+
+
+@pytest.mark.parametrize("live", [{}, {"enabled": False}, {"enabled": True, "capture_id": "new"}])
+def test_owner_hydrates_capture_without_changing_scheduler(tmp_path, monkeypatch, live):
+    from gateway.session_managed_worker import _worker_config
+    from gateway import run
+    frozen = {"kanban": {"fairness_capture": {"enabled": True, "capture_id": "old"}, "max_running": 2}}
+    policy = SimpleNamespace(ignore_user_config=False, config=lambda authority: frozen)
+    monkeypatch.setattr(run, "_load_gateway_config", lambda path: {"kanban": {"fairness_capture": live, "max_running": 99}})
+    result = _worker_config(SimpleNamespace(profile_id=str(tmp_path)), policy)
+    assert result["kanban"]["fairness_capture"] == live
+    assert result["kanban"]["max_running"] == 2
+
+
+def test_bypass_worker_never_loads_live_capture(tmp_path, monkeypatch):
+    from gateway.session_managed_worker import _worker_config
+    from gateway import run
+    policy = SimpleNamespace(ignore_user_config=True, config=lambda authority: {})
+    monkeypatch.setattr(run, "_load_gateway_config", lambda path: pytest.fail("bypass profile read"))
+    assert _worker_config(SimpleNamespace(profile_id=str(tmp_path)), policy) == {}
