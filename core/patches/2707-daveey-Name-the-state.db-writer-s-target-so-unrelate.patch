From adffe4b02287be81f6c7072a84869cfadfe6df92 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 09:06:47 +0000
Subject: [PATCH] [daveey] Name the state.db writer's target so unrelated
 offline reservations cannot starve it

A connect_fn without tracking_path is an unknown target and waits for a moment with no
raw-I/O reservation anywhere. Reservations on different files overlap, so that wait had
no bound while SessionDB held its startup or write lock.
---
 hermes_state.py                                  |  3 ++-
 .../test_sqlite_reservation_adversarial.py       | 16 ++++++++++++++++
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/hermes_state.py b/hermes_state.py
index 75803258d8..a2b8f4e86b 100644
--- a/hermes_state.py
+++ b/hermes_state.py
@@ -847,7 +847,8 @@ class SessionDB(
         jittered application-level retry handles contention, not SQLite's busy handler;
         isolation_level=None: explicit BEGIN IMMEDIATE."""
         conn = _connect_tracked_db(
-            str(self.db_path), check_same_thread=False, timeout=1.0, isolation_level=None,
+            str(self.db_path), tracking_path=self.db_path,  # named: waits only on its own reservations
+            check_same_thread=False, timeout=1.0, isolation_level=None,
             factory=_corrupt_confirm.ScopedAuthorizerConnection,  # composes the corruption-scope recorder
         )
         try:
diff --git a/tests/hermes_cli/test_sqlite_reservation_adversarial.py b/tests/hermes_cli/test_sqlite_reservation_adversarial.py
index 2b5e506663..7fdc81b804 100644
--- a/tests/hermes_cli/test_sqlite_reservation_adversarial.py
+++ b/tests/hermes_cli/test_sqlite_reservation_adversarial.py
@@ -248,3 +248,19 @@ def test_waiting_manual_registration_follows_reservation(tmp_path, monkeypatch):
         pending.result(3)
     assert tracking.has_live_connection(path)
     tracking.untrack_connection(path)
+
+
+def test_state_writer_open_ignores_unrelated_reservations(tmp_path):
+    """Reservations on other files can overlap without end; the state.db writer open (held
+    under SessionDB's startup and write locks) must not wait for a moment with none."""
+    from hermes_state import SessionDB
+
+    def open_close():
+        SessionDB(db_path=tmp_path / "state.db").close()
+
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        with tracking.offline_file_access(tmp_path / "unrelated.bin"):
+            pool.submit(open_close).result(10)
+            with pytest.raises(sqlite3.OperationalError) as caught:
+                tracking.connect_tracked(tmp_path / "x.db", connect_fn=sqlite3.connect)
+            assert caught.value.sqlite_errorcode == sqlite3.SQLITE_BUSY
