Subject: [PATCH] [daveey] Keep housekeeping custody implementation outside
 gateway facade

---
 gateway/run.py            | 16 ++--------------
 gateway/run_drain_work.py | 16 ++++++++++++++++
 2 files changed, 18 insertions(+), 14 deletions(-)

diff --git a/gateway/run.py b/gateway/run.py
index 75614e2ce3..1ce5624e75 100644
--- a/gateway/run.py
+++ b/gateway/run.py
@@ -4161,20 +4161,8 @@ def _run_planned_stop_watcher(
 
 
 def _housekeeping_chore(label: str, fn, *args, **kwargs) -> None:
-    """Run one housekeeping chore; failures log at debug (a persistent failure such as a broken
-    import after a partial update would otherwise warn every tick forever) and never stop the loop."""
-    from hermes_cli.worker_drain_fence import admit, lease_scope
-
-    lease = None
-    try:
-        lease = admit('gateway.housekeeping')
-        with lease_scope(lease):
-            fn(*args, **kwargs)
-    except Exception as exc:
-        logger.debug("%s error: %s", label, exc)
-    finally:
-        if lease is not None:
-            lease.close()
+    from gateway.run_drain_work import run_chore
+    run_chore(logger, label, fn, *args, **kwargs)
 
 
 def _housekeeping_channel_directory(adapters, loop) -> None:
diff --git a/gateway/run_drain_work.py b/gateway/run_drain_work.py
index 3d32669a7d..25287bde24 100644
--- a/gateway/run_drain_work.py
+++ b/gateway/run_drain_work.py
@@ -2,6 +2,22 @@
 from __future__ import annotations
 
 
+def run_chore(logger, label, fn, *args, **kwargs) -> None:
+    """Fence one pass, not the infrastructure loop; log failures without killing it."""
+    from hermes_cli.worker_drain_fence import admit, lease_scope
+
+    lease = None
+    try:
+        lease = admit('gateway.housekeeping')
+        with lease_scope(lease):
+            fn(*args, **kwargs)
+    except Exception as exc:  # health: allow BLE001 -- chore failures are isolated and logged
+        logger.debug('%s error: %s', label, exc)
+    finally:
+        if lease is not None:
+            lease.close()
+
+
 def schedule_chore(factory, loop, **kwargs):
     """Retain independent custody until the scheduled coroutine really completes.
 
