From b1eae743799878eeca9f6def5245063b2539bb3c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:38:02 +0000
Subject: [PATCH] [daveey] bind structural memos to connection open-time file
 identity

Fix review 5907846011: a retained SQLite connection must not publish old-file values under a replacement pathname inode. Attest across managed factory open, read through for raw/new/stale handles, and reject publication after replacement during scanning. Retained-connection tests fail before this fix and pass after for both raw and managed connections and both consumers. 166 focused tests pass; scripts/check 20 checks OK.
---
 hermes_cli/kanban_lockguard.py                | 10 +++
 hermes_cli/kanban_task_memo.py                |  9 ++-
 tests/hermes_cli/test_kanban_task_memo.py     | 78 ++++++++++++++++++-
 .../test_kanban_watcher_idle_work.py          |  2 +
 4 files changed, 97 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_lockguard.py b/hermes_cli/kanban_lockguard.py
index 0f88522455..c9c3447345 100644
--- a/hermes_cli/kanban_lockguard.py
+++ b/hermes_cli/kanban_lockguard.py
@@ -81,6 +81,16 @@ class _GuardMixin:
     """Lift the OFD guard immediately before the real close (see ``hermes_state_lockguard.release``);
     a connection that is garbage-collected unclosed releases through its finalizer instead."""
 
+    def __init__(self, database, *args, **kwargs):
+        from hermes_cli.kanban_generation import _file_identity, _path
+        path = _path(database)
+        before = _file_identity(path) if path is not None else None
+        super().__init__(database, *args, **kwargs)
+        # Attest at open, including connect_tracked's composed factory. Never
+        # infer this at first memo use: the pathname may already be replaced.
+        after = _file_identity(path) if path is not None else None
+        self._hermes_open_identity = before if before == after else None
+
     _hermes_lockguard: Optional[dict] = None
     _hermes_lockguard_finalizer: Any = None
 
diff --git a/hermes_cli/kanban_task_memo.py b/hermes_cli/kanban_task_memo.py
index b3aed6b387..9e3501febc 100644
--- a/hermes_cli/kanban_task_memo.py
+++ b/hermes_cli/kanban_task_memo.py
@@ -18,6 +18,9 @@ State per (file identity, name, extra key) is one immutable ``(Cursor, mapping t
   writes, which ``partial`` sees) but never stores: the caller may roll back and the revision it bumped to can be
   reused by other rows (as ``kanban_sweep_gate.memo``);
 * nothing is stored without a cursor (in-memory file, untrusted coverage, a file swapped while reading);
+* reuse/publication requires the managed connection factory's open-time inode attestation. Raw connections,
+  newly created files (absent before open), and retained handles to replaced files read through without caching;
+  a pathname stat at first memo use cannot establish which inode SQLite actually opened;
 * only tasks whose value is truthy are stored, and memory is bounded (``MAX_SLOTS`` slots, ``MAX_ENTRIES`` per slot).
 
 Values must be functions of the task's OWN rows only (its ``tasks`` row and rows keyed by its ``task_id`` in the
@@ -150,7 +153,9 @@ def state(name: str, conn: sqlite3.Connection, *,
     tables = tuple(table for table, _cols in watched)
     from hermes_cli.kanban_sweep_gate import file_identity
     ident = file_identity(conn)
-    if ident is None:
+    if ident is None or getattr(conn, "_hermes_open_identity", None) != ident[1:]:
+        # Raw connections (and files created by this open) have no open-time
+        # attestation. A pathname stat cannot identify the inode they read.
         return _State(None, _clean(full(conn)))
     slot = (ident, name, extra)
     held = _STATES.get(slot)
@@ -187,6 +192,8 @@ def state(name: str, conn: sqlite3.Connection, *,
     finally:
         if own:
             conn.execute("COMMIT")
+    if file_identity(conn) != ident or (fresh is not None and (fresh.dev, fresh.ino) != ident[1:]):
+        fresh = None  # replacement during cursor/full/partial reads: never publish under either file
     if held is not None and values is held.values:
         if fresh == held.cursor:
             return held
