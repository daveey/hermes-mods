Subject: [PATCH] test(cron): synchronize terminal fire-fence revocation
 [daveey]

---
 tests/cron/test_claim_job_for_fire.py | 50 ++++++++++++++++++++-------
 1 file changed, 38 insertions(+), 12 deletions(-)

diff --git a/tests/cron/test_claim_job_for_fire.py b/tests/cron/test_claim_job_for_fire.py
index d4bf696eb92..4d4a674f4aa 100644
--- a/tests/cron/test_claim_job_for_fire.py
+++ b/tests/cron/test_claim_job_for_fire.py
@@ -8,7 +8,6 @@ These exercise the real store against a temp HERMES_HOME (no mocks) per the
 E2E-over-mocks discipline for file-touching code.
 """
 import threading
-import time
 
 import pytest
 from datetime import UTC
@@ -178,12 +177,14 @@ def test_stale_fire_owner_cannot_mark_replacement_run(temp_home):
     assert persisted.get("last_run_at") is None
 
 
-def test_fire_claim_fence_serializes_terminal_revocation(temp_home):
+def test_fire_claim_fence_serializes_terminal_revocation(temp_home, monkeypatch):
     """A side effect authorized by owner linearizes before terminal revocation."""
+    from cron import jobs
     from cron.jobs import (
         claim_job_for_fire,
         create_job,
         fire_claim_fence,
+        get_job,
         mark_job_run,
     )
 
@@ -192,20 +193,45 @@ def test_fire_claim_fence_serializes_terminal_revocation(temp_home):
     assert isinstance(claimed, dict)
     owner = claimed["fire_claim"]["by"]
     terminal_done = threading.Event()
+    contended = threading.Event()
+    result = {}
+    lock_key = f"{jobs._current_cron_store().cron_dir.resolve()}::{job['id']}"
+    real_lock = jobs._fire_fence_locks[lock_key]
+
+    class ObservedLock:
+        def acquire(self, *, timeout):
+            if real_lock.acquire(blocking=False):
+                return True
+            # Signal only after the real lock denied this thread: a started
+            # thread alone does not prove terminal revocation reached the fence.
+            contended.set()
+            return real_lock.acquire(timeout=timeout)
+
+        def release(self):
+            real_lock.release()
+
+    monkeypatch.setitem(jobs._fire_fence_locks, lock_key, ObservedLock())
 
     def finish_run():
-        mark_job_run(job["id"], True, expected_fire_owner=owner)
+        result["marked"] = mark_job_run(job["id"], True, expected_fire_owner=owner)
         terminal_done.set()
 
-    with fire_claim_fence(job["id"], expected_owner=owner) as owns_claim:
-        assert owns_claim is True
-        thread = threading.Thread(target=finish_run)
-        thread.start()
-        time.sleep(0.05)
-        assert terminal_done.is_set() is False
-
-    thread.join(timeout=1)
-    assert terminal_done.is_set() is True
+    thread = threading.Thread(target=finish_run, daemon=True)
+    try:
+        with fire_claim_fence(job["id"], expected_owner=owner) as owns_claim:
+            assert owns_claim is True
+            thread.start()
+            assert contended.wait(timeout=30), "terminal revocation never reached the held fence"
+            assert terminal_done.is_set() is False
+            assert get_job(job["id"])["fire_claim"]["by"] == owner
+
+        assert terminal_done.wait(timeout=30), "terminal revocation did not finish after fence release"
+    finally:
+        if thread.ident is not None:
+            thread.join(timeout=30)
+    assert thread.is_alive() is False
+    assert result["marked"] is True
+    assert get_job(job["id"])["fire_claim"] is None
 
 
 def test_fire_claim_fence_rejects_stale_owner(temp_home):
