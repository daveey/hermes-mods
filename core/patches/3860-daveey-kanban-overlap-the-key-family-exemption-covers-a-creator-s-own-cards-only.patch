 .../kanban_overlap_same_creator_replay.json   | 148 +++++++++++++++++-
 ...test_kanban_create_overlap_same_creator.py |  33 +++-
 4 files changed, 201 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban_overlap.py b/hermes_cli/kanban_overlap.py
index e25f6799b7..f2a15c14a1 100644
--- a/hermes_cli/kanban_overlap.py
+++ b/hermes_cli/kanban_overlap.py
@@ -698,7 +698,8 @@ def _sibling_owner(card_title: str, waiting_id: str) -> bool:
 def find(*, title: str, body: str, target_board: str, session_id: Optional[str], self_tid: Optional[str],
          parents: Iterable[str], family: Optional[str] = None) -> list[dict]:
     """Open cards elsewhere that already cover this work, best match first. Never raises. ``family`` (the new
-    card's idempotency-key family) skips cards from the same keyed creator, except singleton jobs."""
+    card's idempotency-key family) skips cards from the same keyed creator, except singleton jobs and the
+    creator task's own keyed cards from an earlier run (:func:`kanban_overlap_own.earlier_run`)."""
     try:
         from hermes_cli import kanban_capability_registry as reg
         return _find(title=title, body=body, target_board=target_board, session_id=session_id, self_tid=self_tid,
@@ -744,7 +745,8 @@ def _find(*, title: str, body: str, target_board: str, session_id: Optional[str]
         if not singleton and (card["id"] in skip
                 or (waiting and _sibling_owner(card.get("title") or "", waiting))
                 or (session_id and card["session_id"] == session_id and not own)
-                or (family and card.get("key_family") == family)):
+                or (family and card.get("key_family") == family
+                    and not (own and _own.earlier_run(card, run_started)))):
             continue
         seen.add((card["gateway"], card["id"]))
         reasons, score = _reasons(card, new_words, title, body, target_board, gateways, failure)
diff --git a/hermes_cli/kanban_overlap_own.py b/hermes_cli/kanban_overlap_own.py
index d518d1d161..6301279177 100644
--- a/hermes_cli/kanban_overlap_own.py
+++ b/hermes_cli/kanban_overlap_own.py
@@ -34,6 +34,13 @@ Removing the exemption outright would have refused 517 pairs.
 
 A card from the same chat but another creator (the session match) keeps the old exemption. Every card in a chat's
 tree inherits that session, and the 10-11 race of two creators is another cause.
+
+The idempotency-key family exemption (one keyed creator's batch) covers the creator's own cards only from its
+current run (:func:`earlier_run`). Replay of 14 days (hub 1721 and macbook 6 same-creator same-family pairs, the
+first card open): 74 had the first card from an earlier run; comparing those refuses the macbook duplicate
+t_01a1d6505a3d1591 -> t_01a1d6546c5bcdd9 and 1 false pair (two ``[selfheal-probe]`` live checks, which
+``distinct_from`` overrides). Comparing every same-family own card instead would have refused 26 more hub
+pairs, nearly all legs of one run's keyed batch.
 """
 
 from __future__ import annotations
@@ -219,6 +226,20 @@ def reissue(card: dict, self_tid: Optional[str], run_started: Optional[int], sco
                 and (_epoch(card.get("created_at")) or 0) >= started and score >= REISSUE_SCORE)
 
 
+def earlier_run(card: dict, run_started: Optional[int]) -> bool:
+    """The creator made ``card`` in an EARLIER run than the current one (the key-family exemption's limit).
+
+    One creator keys a batch in one family (``rollout:<card>:<leg>``, ``plugin-suites-red:plugins/<name>``,
+    ``review:<card>:<model>:<sha>``) and files it in one run, knowing every leg: those stay exempt. A keyed card
+    from an earlier run is not known to this run (a reclaim or restart drops the transcript), so it is compared:
+    11-13 macbook t_01a1d6505a3d1591 (``followup:t_01a1d6354e5847dd:pr2545-nits``, run reclaimed by a core update)
+    was filed again by the creator's next run as t_01a1d6546c5bcdd9 (``followup:...:pause-config-bounds``).
+    An unknown run start keeps the exemption."""
+    started = _epoch(run_started)
+    created = _epoch(card.get("created_at"))
+    return started is not None and created is not None and created < started
+
+
 def _epoch(value) -> Optional[int]:
     try:
         return int(value) if value is not None else None
