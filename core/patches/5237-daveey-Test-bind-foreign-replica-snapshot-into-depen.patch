From 146b1893a0e4731b767698fff12ae9b3339e5d7b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 16:02:08 +0000
Subject: [PATCH] [daveey] Test: bind foreign replica snapshot into
 dependency-delete preview token

Review t_eeeeee000000002a nit: no test failed when 'foreign' was dropped from _token.
Adds preview -> unrelated feed advance -> old-token apply case asserting preview_token_changed.
RED proven with foreign removed from _token (applied instead of refused); GREEN restored (134 tests, scripts/check 21 ok).
---
 .../test_kanban_sync_dependency_foreign.py        | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_sync_dependency_foreign.py b/tests/hermes_cli/test_kanban_sync_dependency_foreign.py
index 3e962ba6dc..a8f09f38e7 100644
--- a/tests/hermes_cli/test_kanban_sync_dependency_foreign.py
+++ b/tests/hermes_cli/test_kanban_sync_dependency_foreign.py
@@ -270,3 +270,18 @@ def test_foreign_endpoint_work_and_lease_races_refuse_old_preview(foreign, monke
     assert result["action"] == "refused", result
     assert rows(live, "kanban_sync_tombstones")
     assert len(rows(live, "kanban_sync_outbox")) >= 3
+
+
+def test_foreign_replica_snapshot_is_bound_into_preview_token(foreign):
+    live, hub, svc, uid, _parent, _ = foreign
+    p = r.plan(live, hub, BOARD, uid, REASON)
+    assert p["eligible"], p
+    svc._put(svc.board(BOARD), "tasks", "t_unrelated", {"status": "done", "title": "unrelated", "created_by": "fixture", "created_at": 0, "created_on": FOREIGN}, FOREIGN,
+             None, "9999999999999-0002-worker-1")
+    before = protected(live)
+    result = r.apply(live, hub, BOARD, uid, p["token"], REASON)
+    assert result["action"] == "refused" and result["reason"] == "preview_token_changed", result
+    assert protected(live) == before
+    assert len(rows(live, "kanban_sync_outbox")) == 3
+    fresh = r.plan(live, hub, BOARD, uid, REASON)
+    assert fresh["eligible"] and fresh["token"] != p["token"]
