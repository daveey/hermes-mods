From 3d9c7a13257e6f84e23b28aa4d0ec4be14f17807 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 07:30:01 +0000
Subject: [PATCH] test(tui): assert full-row watcher output on every peer
 [daveey]

The J replay recorded only peer zero's frame count and asserted CPU, notices,
mutations and fallbacks. A stopped watcher could therefore get cheaper and pass.
Record every transport's total and event histogram and require the measured
104 sessions.changed broadcasts on all ten peers after warm-up. chg1 contributes
85 visible changes; persisted notices contribute 19 additional broadcast windows
under the existing coalescing floor. Activity-only writes stay silent.

No production code, replay inputs, CPU/growth limits or notice deadlines change.
Baseline and semantic mutants run with isolated HOME/HERMES_HOME using
sdlc-review/scripts/mutants.py: base passes; stopped watcher and one-peer fanout
both fail the new event-count assertion, despite staying under the CPU limit.
Raw logs, XML and per-peer JSONL belong to Kanban t_677a208d1fd41dc6.
---
 tests/tui_gateway/test_j_nonrpc_rows.py | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_j_nonrpc_rows.py b/tests/tui_gateway/test_j_nonrpc_rows.py
index 47f8c4b22ffa5b477586bacfe64fa041960edc98..e32d5779e49611459ece7bc7105d710c8d42545c 100644
--- a/tests/tui_gateway/test_j_nonrpc_rows.py
+++ b/tests/tui_gateway/test_j_nonrpc_rows.py
@@ -521,9 +521,21 @@ def _run_cell(home, peers, monkeypatch, cell, reader_defers=True):
                 "holder_cpu_s": cx.holder_cpu, "row_core": (cx.watcher_cpu + poller_cpu) / SECONDS,
                 "holder_core": cx.holder_cpu / SECONDS, "latency_s": latency,
                 "max_latency_s": max(latency.values()) if latency else None,
-                "frames_per_peer": len(peers[0].frames), "wal_bytes": wal_bytes,
+                "frames_per_peer": [len(peer.frames) for peer in peers],
+                "watcher_events_per_peer": [dict(Counter(frame["params"]["type"] for frame in peer.frames))
+                                            for peer in peers], "wal_bytes": wal_bytes,
                 "skill_roots": len(skill_roots)}
     _write_evidence(evidence)
+    # Measured chg1 + notice stream: 83 message + 2 title updates and 24 persisted
+    # notices yield 104 sessions.changed broadcasts (five notice updates coalesce
+    # with chg1 under the 2 s floor). The pre-fix reader delivers notices sooner:
+    # only three coalesce, yielding 106. The 55 activity-only commits stay silent;
+    # warm-up frames were cleared and the other watched inputs stay unchanged.
+    # All ten peers must receive the work whose CPU we charge, not just peer zero.
+    expected_frames = 104 if reader_defers else 106
+    assert len(peers) == 10, evidence
+    assert evidence["watcher_events_per_peer"] == [{"sessions.changed": expected_frames}] * 10, evidence
+    assert evidence["frames_per_peer"] == [expected_frames] * 10, evidence
     assert not ins.errors, (ins.errors, evidence)
     assert not scheduler.errors
     if cell["large_wal"]:  # the WAL stayed past 400 MiB through the measured window
-- 
