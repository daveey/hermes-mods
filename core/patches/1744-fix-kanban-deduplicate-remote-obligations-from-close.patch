From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 13:24:46 -0800
Subject: [PATCH] fix(kanban): deduplicate remote obligations from closeout
 counts [daveey]

---
 hermes_cli/kanban_session_activity.py         |  9 ++-
 .../test_kanban_remote_waiting_overlap.py     | 64 +++++++++++++++++++
 2 files changed, 70 insertions(+), 3 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_remote_waiting_overlap.py

diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index 337a4a44f90..1cdf53ad200 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -1932,8 +1932,11 @@ def annotate_kanban_activity(rows: list[dict[str, Any]]) -> list[dict[str, Any]]
                 row.pop(key, None)
         # [daveey] The open card ids the chat waits on (lineage-wide, capped): the sidebar's "waiting on N cards".
         open_ids = {tid for sid in ids for tid in waiting.get(sid, ())}
-        # Plugin sources (pending close-outs): count the ids the boards don't already count as open.
-        pending = {tid for sid in ids for tid in extra.get(sid, ())} - open_ids
+        # Plugin sources (pending close-outs) must not recount local OR scoped remote obligations.
+        extra_ids = {tid for sid in ids for tid in extra.get(sid, ())}
+        counted_remote = {key for sid in ids for key, bucket, _ in remote_keys.get(sid, ())
+                          if bucket in ("active", "blocked")}
+        pending = extra_ids - open_ids - counted_remote
         if pending:
             row["kanban_active"] = int(row.get("kanban_active") or 0) + len(pending)
         # [daveey] Parked/held are subsets of kanban_active. kanban_parked is stamped (even 0) whenever there is open
@@ -1954,7 +1957,7 @@ def annotate_kanban_activity(rows: list[dict[str, Any]]) -> list[dict[str, Any]]
             row["kanban_stalled"] = n_stalled
         else:
             row.pop("kanban_stalled", None)
-        ids_waiting = sorted(open_ids | pending)
+        ids_waiting = sorted(open_ids | extra_ids)
         if ids_waiting:
             row["kanban_waiting_on"] = ids_waiting[:WAITING_ON_CAP]
         else:
diff --git a/tests/hermes_cli/test_kanban_remote_waiting_overlap.py b/tests/hermes_cli/test_kanban_remote_waiting_overlap.py
new file mode 100644
index 00000000000..2f879b8673b
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_remote_waiting_overlap.py
@@ -0,0 +1,64 @@
+"""Remote board obligations and plugin closeouts share canonical card identity."""
+
+import pytest
+
+from hermes_cli import kanban_session_activity as ksa
+
+
+@pytest.fixture
+def remote_projection(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_HUB_STATE", str(tmp_path / "hub-state"))
+    monkeypatch.setattr(ksa, "_waiting_sources", {})
+    monkeypatch.setattr(ksa, "_remote_wait", lambda card: None)
+    ksa._reset_cache_for_tests()
+    yield
+    ksa._reset_cache_for_tests()
+
+
+@pytest.mark.parametrize("status,active,blocked,parked", [
+    ("running", 1, 0, 0),
+    ("scheduled", 1, 0, 1),
+    ("unknown", 1, 0, 1),
+    ("blocked", 0, 1, 0),
+])
+@pytest.mark.parametrize("extra_closeout", [False, True])
+def test_remote_closeout_overlap_counts_once(
+    remote_projection, monkeypatch, status, active, blocked, parked, extra_closeout,
+):
+    key = "hub/default/default/t_shared"
+    cards = [{
+        "key": key, "id": "t_shared", "session": sid, "status": status,
+        "gateway": "hub", "board": "default", "profile": "default", "unfinished": True,
+        "block_kind": "needs_input",
+        "human_request": {
+            "action": "Choose a release window.", "why_human": "Only the owner can choose downtime.",
+            "interaction": "reply", "scope": "Staging release", "evidence": "No release window selected.",
+        },
+    } for sid in ("s_root", "s_tip")]
+    monkeypatch.setattr(ksa, "_remote_cards", lambda *args: cards)
+    pending = [key] + (["hub/default/default/t_finished"] if extra_closeout else [])
+    ksa.register_waiting_source("closeout", lambda: {"s_tip": pending})
+    for _ in range(2):  # fresh and cached annotation, including compression aliases
+        row = ksa.annotate_kanban_activity([{
+            "id": "s_tip", "_lineage_ids": ["s_root", "s_tip"],
+        }])[0]
+        assert row.get("kanban_active", 0) == active + int(extra_closeout)
+        assert row.get("kanban_blocked", 0) == blocked
+        assert row.get("kanban_parked", 0) == parked
+        assert row["kanban_waiting_on"] == sorted(pending)
+    # The board-only waiting API remains local-only; scoped closeout ids stay in the row.
+    assert ksa.waiting_on_task_ids() == {}
+
+
+def test_remote_waiting_identity_does_not_collapse_another_gateway(remote_projection, monkeypatch):
+    key = "hub/default/default/t_shared"
+    other_key = "other/default/default/t_shared"
+    monkeypatch.setattr(ksa, "_remote_cards", lambda *args: [{
+        "key": key, "id": "t_shared", "session": "s", "status": "running",
+        "gateway": "hub", "board": "default",
+    }])
+    ksa.register_waiting_source("closeout", lambda: {"s": [other_key]})
+    row = ksa.annotate_kanban_activity([{"id": "s"}])[0]
+    assert row["kanban_active"] == 2
+    assert row["kanban_waiting_on"] == [other_key]
-- 
