From d72202494966a92e772ebe5546beba613de2504c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 04:30:32 +0000
Subject: [PATCH] perf(memory): skip ast.parse of plugin modules that never
 name the provider contract

list_memory_provider_names() runs at hermes_cli.web_server_config import and
ast-parsed every top-level module of every non-provider user plugin dir
(~1.4 cpu-s on a 61-plugin home). Both detection branches need
'MemoryProvider' or 'register_memory_provider' in the text, so a substring
precheck is semantics-preserving. Tests: aliased-import provider past 8 KB
still found; non-provider dirs are never parsed.
---
 plugins/memory/__init__.py                    |  7 +++-
 .../plugins/memory/test_discovery_sources.py  | 40 +++++++++++++++++++
 2 files changed, 46 insertions(+), 1 deletion(-)

diff --git a/plugins/memory/__init__.py b/plugins/memory/__init__.py
index 8a645f6f2b6..b493c8616a1 100644
--- a/plugins/memory/__init__.py
+++ b/plugins/memory/__init__.py
@@ -82,7 +82,12 @@ def _defines_memory_provider(path: Path) -> bool:
     heuristic, a docstring or comment naming the contract does not count."""
     for module in sorted(path.glob("*.py")):
         try:
-            tree = ast.parse(module.read_text(errors="replace", encoding="utf-8-sig"))
+            source = module.read_text(errors="replace", encoding="utf-8-sig")
+            # Both checks below need one of these names in the text (an `import MemoryProvider as X`
+            # alias and `mod.MemoryProvider` bases included), so skip the costly parse without them.
+            if "MemoryProvider" not in source and "register_memory_provider" not in source:
+                continue
+            tree = ast.parse(source)
         except (OSError, SyntaxError, ValueError):
             continue
         bases = {"MemoryProvider"} | {a.asname for n in ast.walk(tree) if isinstance(n, ast.ImportFrom)
diff --git a/tests/plugins/memory/test_discovery_sources.py b/tests/plugins/memory/test_discovery_sources.py
index 72f47d33ed3..c36bb303bf9 100644
--- a/tests/plugins/memory/test_discovery_sources.py
+++ b/tests/plugins/memory/test_discovery_sources.py
@@ -255,3 +255,43 @@ def test_unreadable_user_plugin_does_not_abort_memory_discovery(tmp_path, monkey
     assert "goodmem" in names
     assert "denied" not in names
     assert memory_plugins.find_provider_dir("denied") is None
+
+
+def test_provider_via_aliased_import_past_8kb_is_still_discovered(tmp_path, monkeypatch):
+    """The parse fallback's substring precheck must not hide a provider whose only base is an
+    ``import MemoryProvider as X`` alias and whose contract names sit past the first 8 KB."""
+    provider = tmp_path / "plugins" / "aliasmem"
+    provider.mkdir(parents=True)
+    docstring = '"""' + "Plain prose about storage.\n" * 400 + '"""\n'  # pushes every token past 8 KB
+    (provider / "__init__.py").write_text(
+        docstring
+        + "from agent.memory_provider import MemoryProvider as Base\n\n\n"
+        + "class Provider(Base):\n    pass\n",
+        encoding="utf-8",
+    )
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+
+    assert "aliasmem" in memory_plugins.list_memory_provider_names()
+
+
+def test_non_provider_plugin_dirs_are_not_ast_parsed(tmp_path, monkeypatch):
+    """Discovery runs at dashboard/web_server_config import; ast-parsing every module of every
+    ordinary user plugin cost ~1.4 cpu-s per import on a 61-plugin home (t_01a18b118d75b278)."""
+    import ast
+
+    plugins_root = tmp_path / "plugins"
+    for i in range(3):
+        plain = plugins_root / f"plain{i}"
+        plain.mkdir(parents=True)
+        body = "".join(f"def f{n}(x):\n    return x + {n}\n\n" for n in range(2000))  # ~60 KB
+        (plain / "__init__.py").write_text(body, encoding="utf-8")
+        (plain / "helpers.py").write_text(body, encoding="utf-8")
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    calls = []
+    real_parse = ast.parse
+    monkeypatch.setattr(ast, "parse", lambda *a, **kw: calls.append(a) or real_parse(*a, **kw))
+
+    names = memory_plugins.list_memory_provider_names()
+
+    assert not any(n.startswith("plain") for n in names)
+    assert calls == []
-- 
