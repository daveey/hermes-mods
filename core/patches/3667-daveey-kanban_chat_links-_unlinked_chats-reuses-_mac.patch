From fcbffc42723d2b223238ed121fb830b72e81785e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:16:33 +0000
Subject: [PATCH] [daveey] kanban_chat_links: _unlinked_chats reuses
 _machine_by_profile; pin links_diff machine-chat pop order

Follow-up to the non-blocking nits in review 5890421655 on PR #2163 (card t_01a1d4bde1a32381).

1. `_unlinked_chats` repeated the `(type(profile), profile)` grouping that `_machine_by_profile` already does and
   called `machine_sessions` once per profile without `prefetch_sources`. It now builds the `(profile, session)`
   rows (placeholders filtered first, as before) and classifies them through `_machine_by_profile`, so several
   profiles go through the batched path. The returned set is unchanged: placeholder ids plus `str(session)` of
   every session that is machine under any of its origin profiles.
2. `links_diff` pops the unlinked chats before computing `ledger_boards`. A comment now says why that is
   intended: a missing replica whose only ledger cards are machine chats leaves the diff clean, and a session that
   is machine under any one of its origin profiles is dropped as a whole (the writer never links those sessions).
   New test `test_links_diff_a_missing_replica_with_only_machine_ledger_cards_stays_clean` pins (a), with a human
   chat on the same board as the control that keeps the diff unclean (`unreadable == ["runners"]`).

Proof: 30 test files importing kanban_chat_links (incl. all test_kanban_chat_links*.py): 634 passed, 0 failed.
scripts/check --base origin/main: 19 checks, ok.
---
 hermes_cli/kanban_chat_links.py               | 19 ++++++++-----------
 .../test_kanban_chat_links_parity.py          | 14 ++++++++++++++
 2 files changed, 22 insertions(+), 11 deletions(-)

diff --git a/hermes_cli/kanban_chat_links.py b/hermes_cli/kanban_chat_links.py
index 10a43e2e35..89ea443c0f 100644
--- a/hermes_cli/kanban_chat_links.py
+++ b/hermes_cli/kanban_chat_links.py
@@ -828,19 +828,13 @@ def _ledger_obligation(card: dict[str, Any], statuses: tuple[str, ...]) -> bool:
 
 def _unlinked_chats(gateway: str, profiles: dict[str, set[Any]]) -> set[str]:
     """The chats (``session -> origin profiles``) the link writer never links: a placeholder id, or a machine
-    session of this gateway (``_ledger_links`` skips them, ``reconcile`` releases them). Classified once per
-    profile, as ``_ledger_links`` does."""
-    from hermes_cli.kanban_db_notify import machine_sessions
+    session of this gateway under any of its origin profiles (``_ledger_links`` skips them, ``reconcile``
+    releases them), classified through :func:`_machine_by_profile` as ``_ledger_links`` does."""
     from hermes_cli.kanban_placement import is_placeholder_session
     out = {s for s in profiles if is_placeholder_session(s)}
-    groups: dict[tuple, tuple[Any, list[str]]] = {}
-    for session, names in profiles.items():
-        if session not in out:
-            for name in names:
-                groups.setdefault((type(name), name), (name, []))[1].append(session)
-    for name, refs in groups.values():
-        out |= {str(s) for s in machine_sessions(gateway, refs, local_gateway=gateway, profile=name)}
-    return out
+    rows = [(name, s) for s, names in profiles.items() if s not in out for name in names]
+    machine = _machine_by_profile(gateway, rows)
+    return out | {str(s) for name, s in rows if str(s or "") in machine[(type(name), name)]}
 
 
 def links_diff(gateway: str, statuses: tuple[str, ...] = OPEN_STATUSES) -> dict[str, Any]:
@@ -877,6 +871,9 @@ def links_diff(gateway: str, statuses: tuple[str, ...] = OPEN_STATUSES) -> dict[
         if card.get("source") == PROFILE_BOARD_SOURCE:
             profile_board.setdefault(card["session"], set()).add((card["gateway"], card["board"], card["id"]))
     skipped = _unlinked_chats(gateway, profiles)
+    # Popped before ``ledger_boards`` on purpose (the writer never links these chats): a missing replica whose
+    # only ledger cards are unlinked chats leaves the diff clean, and a session that is machine under any one of
+    # its origin profiles is dropped as a whole.
     machine_links = sum(len(side.pop(s, ())) for side in (ledger, replica) for s in skipped)
     for s in skipped:
         profile_board.pop(s, None)
diff --git a/tests/hermes_cli/test_kanban_chat_links_parity.py b/tests/hermes_cli/test_kanban_chat_links_parity.py
index 908e470b4d..ca808fd624 100644
--- a/tests/hermes_cli/test_kanban_chat_links_parity.py
+++ b/tests/hermes_cli/test_kanban_chat_links_parity.py
@@ -336,6 +336,20 @@ def test_links_diff_leaves_out_chats_the_link_writer_never_links(env):
     assert not report["clean"] and report["chats"] == 1
 
 
+def test_links_diff_a_missing_replica_with_only_machine_ledger_cards_stays_clean(env):
+    """[daveey] Machine chats are popped before ``ledger_boards``: a missing replica whose only ledger cards are
+    machine chats has nothing the writer would compare, so it never keeps the diff unclean. A human chat's card
+    on that board still does (review 5890421655)."""
+    replica(env, [], [])
+    env["replicas"]["runners"] = True  # listed by board_paths, its shadow never pulled
+    env["ledger"].append({**_unknown_row("t_cron", "cron_job_1", "shepherd"), "board": "runners"})
+    report = links.links_diff(ME)
+    assert (report["clean"], report["unreadable"], report["machine_links"]) == (True, [], 1), report
+    env["ledger"].append({**_unknown_row("t_human", "s_human"), "board": "runners"})
+    report = links.links_diff(ME)
+    assert not report["clean"] and report["unreadable"] == ["runners"]
+
+
 _ASK = {"action": "Name the build host or say wait", "why_human": "new runner registrations are approval-gated",
         "interaction": "reply", "scope": "one runner registration", "evidence": "runners API lists no canary"}
 
