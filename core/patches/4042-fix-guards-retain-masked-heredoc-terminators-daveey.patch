From a2269b5dab401e4816722fed30a402b94aebe6a9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 00:01:56 +0000
Subject: [PATCH] fix(guards): retain masked heredoc terminators [daveey]

Address blocking review 5899656664: masking the terminator let arithmetic scanning close at a later reused delimiter and skip a real sink. Retain each exact closer while blanking only body text. RED: two failures at 00c9bbd489; GREEN: 1334 guard tests including generated shape corpus and date watcher controls. Includes later <<-EOF regression.
---
 tests/cron/test_arith_quote_desync.py | 20 +++++++++++++++++++-
 tools/shell_heredoc.py                |  6 ++++--
 2 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/tests/cron/test_arith_quote_desync.py b/tests/cron/test_arith_quote_desync.py
index 24b141fbcb..39745b2f15 100644
--- a/tests/cron/test_arith_quote_desync.py
+++ b/tests/cron/test_arith_quote_desync.py
@@ -2,8 +2,26 @@
 
 import pytest
 
+from cron.lifecycle_guard import scan_gateway_lifecycle
 from tools.shell_arith_sink import substitution_in_arithmetic
-from tools.shell_heredoc import output_reaches_shell
+from tools.shell_heredoc import output_reaches_shell, strip_inert_heredoc_bodies
+
+
+@pytest.mark.parametrize("later", ["cat <<EOF\nplain\nEOF\n", "cat <<-EOF\n\tplain\n\tEOF\n"])
+def test_reused_delimiter_cannot_hide_intervening_sink(tmp_path, later):
+    big = tmp_path / "BIG"
+    big.write_text("# padding\n" * 150000, encoding="utf-8")
+    command = "cat <<'EOF'\nhello\nEOF\n" + SINK.replace("BIG", str(big)) + "\n" + later
+    # A detected sink must cancel masking, including when a later heredoc reuses EOF.
+    assert strip_inert_heredoc_bodies(command) == command
+    unsafe, reason = scan_gateway_lifecycle(command, cwd=str(tmp_path))
+    assert unsafe
+    assert reason and "larger than the scan cap" in reason
+
+
+def test_masked_body_retains_its_own_terminator():
+    command = "cat <<'EOF'\ndon't\nEOF\necho ok\n"
+    assert strip_inert_heredoc_bodies(command) == "cat <<'EOF'\n\nEOF\necho ok\n"
 
 SINK = r'''x=$(( 1 + $(echo "b[\$(bash BIG)]") ))'''
 
diff --git a/tools/shell_heredoc.py b/tools/shell_heredoc.py
index 653aa5f6fa..0ecdf53c9e 100644
--- a/tools/shell_heredoc.py
+++ b/tools/shell_heredoc.py
@@ -675,8 +675,10 @@ def strip_inert_heredoc_bodies(command: str, *, nested: bool = False, _depth: in
                 if not stdin.begin_function(command, command_start, command_end):
                     return command
             function_masks += consumer == "function"
-            replacements += [(start, end, "\n" * command.count("\n", start, end), consumer)
-                             for start, _terminator, end in bodies]
+            # Keep each closer: downstream scanners must not close this opener
+            # at a later same-delimiter heredoc and skip intervening commands.
+            replacements += [(start, terminator, "\n" * command.count("\n", start, terminator), consumer)
+                             for start, terminator, _end in bodies]
         elif nested and prefix_intact and _depth < _MAX_NESTED_HEREDOC_DEPTH and all(quoted) and _owner_feeds_shell(
                 command, command_start, owner_start, specs):
             # An unquoted outer body expands locally first (`$(…)` runs here), and any owner but a
