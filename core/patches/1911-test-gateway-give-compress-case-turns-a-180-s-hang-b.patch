From 5d2c46c26f5af03210b23d9f6b6a66988f0acc65 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 4 Nov 2026 02:15:45 +0000
Subject: [PATCH] test(gateway): give compress-case turns a 180 s hang bound,
 not 30 s

A managed_workers turn spawns a fresh agent.managed_worker interpreter, so its
wall time is CPU-bound: ~7-14 s per turn on a loaded hub and 25-28 s when the
process tree only gets 25% of the CPU (SIGSTOP/SIGCONT 0.3 s/0.1 s duty cycle).
The 30 s per-turn deadline then expires, exactly as on CI run 41627985551
("timed out after 30s waiting for HISTORY_3 terminal"). The poll returns as soon
as the admission is terminal, so the larger bound only matters on a hang.
---
 tests/gateway/test_session_mutation_compress.py | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/tests/gateway/test_session_mutation_compress.py b/tests/gateway/test_session_mutation_compress.py
index d15ecb72207..d00d70604ae 100644
--- a/tests/gateway/test_session_mutation_compress.py
+++ b/tests/gateway/test_session_mutation_compress.py
@@ -44,6 +44,12 @@ def test_compress_preserves_configured_history_and_admission_owner(tmp_path, mod
     run_compress_case(tmp_path, mode, in_place)
 
 
+# A hang bound, not a delay: the poll returns as soon as the admission is terminal. A managed turn
+# spawns a fresh agent.managed_worker interpreter, which is CPU-bound: ~7-14 s per turn on a loaded
+# hub, 25-28 s when the tree only gets 25% of the CPU, so a 30 s bound flaked on throttled runners.
+TURN_DEADLINE = 180
+
+
 def run_compress_case(tmp_path, mode, in_place):
     root = Path(__file__).resolve().parents[2]
     home, user = tmp_path / 'state', tmp_path / 'user'
@@ -92,7 +98,7 @@ def run_compress_case(tmp_path, mode, in_place):
                     with closing(sqlite3.connect(f'file:{home / "state.db"}?mode=ro', uri=True)) as db:
                         row = db.execute('SELECT status FROM session_admissions WHERE request_id=?', (text,)).fetchone()
                     return row and row[0] == 'terminal'
-                await async_wait_until(terminal, timeout=30, what=f'{text} terminal')
+                await async_wait_until(terminal, timeout=TURN_DEADLINE, what=f'{text} terminal')
                 return await call('session.resume', session_id=sid)
             history_count = 16
             for i in range(history_count):
