From f17130ba847dcb4ec22e0287a2c973ae0f0906c0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 21:44:57 +0000
Subject: [PATCH] fix(cron): keep $'/$" adjacent through quote-boundary tagging
 [daveey]

Main's quote-boundary tag (3f135289) is inserted before every opening
quote, which split `$'...'` into `$` + `'...'`. Later ANSI-C normalization
then no longer saw the `$'` pair, so `bash $'./r\0ignored'.sh` (Bash runs
./r.sh after NUL truncation) scanned as a different path and was allowed.
Place the tag before the `$` instead. Also mark `${...}` frames carrying
quotes as quoted words, matching main's per-character tagging.

Caught by test_ansi_nul_truncates_only_quoted_span[RUN-*] after rebasing
PR #2925 onto main 5d9e537979.

test_lifecycle_guard_token_dedupe's two ANSI-C evidence tests pinned the
split-pair artefact (`$'ok'` read as `$ok`). They now use `$'..\xNN'`
spans, where the raw (decoding) and normalized (literal) readings still
differ, so they keep checking that distinct readings both survive dedupe.
---
 cron/lifecycle_guard_words.py                   | 11 +++++++++--
 tests/cron/test_lifecycle_guard_token_dedupe.py | 15 ++++++++-------
 2 files changed, 17 insertions(+), 9 deletions(-)

diff --git a/cron/lifecycle_guard_words.py b/cron/lifecycle_guard_words.py
index 6b36ddc90c3a6473478e51fd0561b8d5807a3923..508a60976172fc27a51ba325c8a8df80982e39b8 100644
--- a/cron/lifecycle_guard_words.py
+++ b/cron/lifecycle_guard_words.py
@@ -41,7 +41,7 @@ def tokenize_redirections(line: str, tokenize: Callable[[str], list[str]],
     alphabet = "<>&|" + marker
     replacements = {ch: f"{marker}{index}{marker}" for index, ch in enumerate(alphabet)}
     protected: list[str] = []
-    single = double = escaped = False
+    single = double = escaped = dollar_live = False
     quote_marker = marker + "5" + marker
     end = 0
     for pos, ch in enumerate(line):
@@ -54,13 +54,20 @@ def tokenize_redirections(line: str, tokenize: Callable[[str], list[str]],
                 # Quoting inside the frame still makes the word quoted.
                 protected.append(quote_marker)
             protected.append(span.replace(marker, replacements[marker]))
+            dollar_live = False
             continue
         literal = single or double or escaped
         # Mark the boundary, including empty quoted pieces. The escape marker
         # itself is encoded below, so literal input cannot synthesize this tag.
         if not escaped and (ch == "\\" and not single
                             or ch == "'" and not double or ch == '"' and not single):
-            protected.append(quote_marker)
+            if ch != "\\" and not (single or double) and dollar_live:
+                # Tag before `$'`/`$"`: splitting the pair would hide ANSI-C
+                # quoting (and its NUL truncation) from later normalization.
+                protected.insert(len(protected) - 1, quote_marker)
+            else:
+                protected.append(quote_marker)
+        dollar_live = ch == "$" and not (single or double or escaped)
         if escaped:
             escaped = False
         elif ch == "\\" and not single:
diff --git a/tests/cron/test_lifecycle_guard_token_dedupe.py b/tests/cron/test_lifecycle_guard_token_dedupe.py
index 7f703466a09e75bee157dc6b9bbfc37b030026d0..513bfa882e3048a1f4e1be59e5bd463aad7888e9 100644
--- a/tests/cron/test_lifecycle_guard_token_dedupe.py
+++ b/tests/cron/test_lifecycle_guard_token_dedupe.py
@@ -44,13 +44,14 @@ def test_convergent_readings_are_tokenized_once(monkeypatch):
 
 
 def test_distinct_readings_and_ansi_normalization_survive(monkeypatch):
+    # The raw reading decodes ANSI-C escapes; normalization keeps them literal.
     monkeypatch.setattr(tokens, 'separate_substitutions', lambda command, **kw:
-                        ("echo $'empty'" if kw else "echo $'outer'", []))
-    result = list(tokens._iter_command_token_lists("echo $'original'"))
+                        ("echo $'empty\\x41'" if kw else "echo $'outer\\x41'", []))
+    result = list(tokens._iter_command_token_lists("echo $'original\\x41'"))
     assert {tuple(row) for row in result} == {
-        ('echo', '$original'), ('echo', 'original'),
-        ('echo', '$empty'), ('echo', 'empty'),
-        ('echo', '$outer'), ('echo', 'outer'),
+        ('echo', 'originalA'), ('echo', 'original\\x41'),
+        ('echo', 'emptyA'), ('echo', 'empty\\x41'),
+        ('echo', 'outerA'), ('echo', 'outer\\x41'),
     }
 
 
@@ -64,8 +65,8 @@ def test_cached_occurrences_preserve_order_and_list_isolation():
 
 
 def test_plain_readings_default_keeps_distinct_ansi_evidence():
-    assert list(tokens._iter_plain_token_lists("echo $'ok'")) == [
-        ['echo', '$ok'], ['echo', 'ok'],
+    assert list(tokens._iter_plain_token_lists("echo $'o\\x6b'")) == [
+        ['echo', 'ok'], ['echo', 'o\\x6b'],
     ]
 
 
