From 74c5d8f71f63ce1989d12440d5c1d792cce76cd0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 01:38:16 -0700
Subject: [PATCH] ci: run e2e-upgrade on bwrap-capable hub slots (ci-bwrap)
 [daveey]

Plain hermes-hub slots are rootful Docker containers: Docker's default seccomp
(unshare gated on CAP_SYS_ADMIN), docker-default AppArmor (no mount), the masked
/proc paths, and the host's apparmor_restrict_unprivileged_userns=1 each stop
bubblewrap, so the suite's own probe failed with 'bwrap unusable' on all six
shards (run 40637455814). ci-bwrap slots run on a userns-remapped daemon with a
host AppArmor profile for /usr/bin/bwrap only, Docker's seccomp plus the
namespace syscalls, and unmasked /proc (hosts/hermes-ci-capacity/BWRAP.md in
the hermes-sync repo). The probe is unchanged.
---
diff --git a/.github/actionlint.yaml b/.github/actionlint.yaml
index 811f482ccd0142167cd750053b0c8e862be9d42b..00e270ac70a806fa7ca27d0c10bbc7beb1b7ccb3 100644
--- a/.github/actionlint.yaml
+++ b/.github/actionlint.yaml
@@ -21,6 +21,8 @@ self-hosted-runner:
     - docker-ci
     - hermes-hub-poll
     - ci-fast
+    # bubblewrap-capable hub slots (tests.yml e2e-upgrade).
+    - ci-bwrap
 
 # fork (daveey/hermes): known findings that are not bugs. The lint runs in
 # .github/workflows/actionlint.yml. Keep each pattern narrow.
diff --git a/tests/ci/test_fast_runner_routing.py b/tests/ci/test_fast_runner_routing.py
index 18269f6e68b61ee07ae3d820e81fe71ac13b0e42..ae160361c4730da50a79b794e7edf7d7a9dab33a 100644
--- a/tests/ci/test_fast_runner_routing.py
+++ b/tests/ci/test_fast_runner_routing.py
@@ -89,3 +89,19 @@ def test_fast_label_is_known_and_checks_cannot_bypass_the_gate():
             callers = {key for key, value in workflows["ci.yaml"]["jobs"].items()
                        if value.get("uses") == f"./.github/workflows/{wf}"}
             assert callers and callers <= set(gate["needs"])
+
+
+def test_e2e_upgrade_runs_only_on_bwrap_capable_slots():
+    # Its probe step refuses to run the updater unsandboxed; a plain hermes-hub slot cannot
+    # start bubblewrap (Docker seccomp/AppArmor, masked /proc, host userns restriction).
+    workflows = _workflows()
+    job = workflows["tests.yml"]["jobs"]["e2e-upgrade"]
+    assert _labels(job) == ["self-hosted", "hermes-hub", "ci-bwrap"]
+    probe = [s for s in job["steps"] if s.get("name") == "Install bubblewrap"]
+    assert probe and "assert BWRAP_OK" in probe[0]["run"]
+    labels = YAML(typ="safe").load((ROOT / ".github" / "actionlint.yaml").read_text(encoding="utf-8"))
+    assert "ci-bwrap" in labels["self-hosted-runner"]["labels"]
+    for wf, data in workflows.items():
+        for name, j in data.get("jobs", {}).items():
+            if "ci-bwrap" in _labels(j):
+                assert (wf, name) == ("tests.yml", "e2e-upgrade")
-- 
