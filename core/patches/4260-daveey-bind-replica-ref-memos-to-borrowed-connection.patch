From 968ea1efeba131618047021706f4349698c500e0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 22:43:43 +0000
Subject: [PATCH] [daveey] bind replica ref memos to borrowed connection
 generation

Fix review finding on PR #3096: a pathname replacement after metadata reads could stamp old answers with the replacement inode. Include the actual connection object in the memo key, so reopened readers cannot adopt another snapshot generation. Real same-probe SQLite replacements during metadata and lookup cover both false-present and false-absent answers. RED: metadata replacement fails on prior head. GREEN: 26 replica-ref tests pass.
---
 hermes_cli/kanban_board_replica_refs.py       |  6 +++
 .../test_kanban_replica_refs_kept_readers.py  | 40 +++++++++++++++++++
 2 files changed, 46 insertions(+)

diff --git a/hermes_cli/kanban_board_replica_refs.py b/hermes_cli/kanban_board_replica_refs.py
index 8b112a09c7..d2ee359f49 100644
--- a/hermes_cli/kanban_board_replica_refs.py
+++ b/hermes_cli/kanban_board_replica_refs.py
@@ -125,6 +125,12 @@ def hub_tasks_found(conn: sqlite3.Connection, path: Path, ids: list[str]) -> set
         probe = None
     if ident is None or probe is None or probe[0] != probe[1] or probe[2] is None:
         return {tid for tid, hit in lookup(ids).items() if hit}
+    # The pathname may have been replaced after this connection opened its
+    # snapshot (including before the stat above). Bind answers to the actual
+    # borrowed connection too: a reopened reader must never adopt old answers
+    # even when both files have identical probe tuples. Keep the object itself,
+    # not id(conn), so a later connection cannot reuse a recycled identity.
+    ident = (conn, ident)
     key, tag = (ident, probe), str(path)
     with _hub_lock:
         memo = _hub_memo.get(tag)
diff --git a/tests/hermes_cli/test_kanban_replica_refs_kept_readers.py b/tests/hermes_cli/test_kanban_replica_refs_kept_readers.py
index f5427bf798..218c30c77b 100644
--- a/tests/hermes_cli/test_kanban_replica_refs_kept_readers.py
+++ b/tests/hermes_cli/test_kanban_replica_refs_kept_readers.py
@@ -210,6 +210,46 @@ def test_a_replaced_hub_file_is_reread(host, tmp_path):
     assert refs.unresolved_after_replica([HUB_ONLY]) == [HUB_ONLY]
 
 
+@pytest.mark.parametrize("seam", ["metadata", "lookup"])
+def test_replacement_during_read_does_not_poison_next_generation(host, tmp_path, monkeypatch, seam):
+    replacement = _hub(tmp_path / "replacement", [
+        ("gw-a", f"default/{NOWHERE}"), ("gw-b", "p/default/t_01a1cf0000000001")])
+    original_ident = refs._file_ident(host)
+    replaced = False
+
+    def replace_once():
+        nonlocal replaced
+        if not replaced:
+            replacement.replace(host)
+            replaced = True
+            assert refs._file_ident(host) != original_ident
+
+    if seam == "metadata":
+        original = ksa._meta_float
+
+        def meta(conn, key):
+            result = original(conn, key)
+            if key == "last_digest":
+                replace_once()
+            return result
+
+        monkeypatch.setattr(ksa, "_meta_float", meta)
+    else:
+        original = kanban_prose_refs.hub_replica_lookup
+
+        def lookup(*args):
+            replace_once()
+            return original(*args)
+
+        monkeypatch.setattr(kanban_prose_refs, "hub_replica_lookup", lookup)
+
+    # The in-flight snapshot may answer from the old file, but cannot poison
+    # the next borrowed generation with either a false positive or negative.
+    assert ksa.replica_task_resolution([HUB_ONLY, NOWHERE]) == ({HUB_ONLY}, True)
+    assert replaced
+    assert ksa.replica_task_resolution([HUB_ONLY, NOWHERE]) == ({NOWHERE}, True)
+
+
 def test_a_board_replica_row_landing_later_is_seen_through_the_kept_reader(host):
     assert refs.unresolved_after_replica([NOWHERE]) == [NOWHERE]
     replica = kbc.connect(ksc.shadow_path("bb"))
