         if reason is None:
@@ -624,13 +637,15 @@ def pickup(conn: sqlite3.Connection, *, budget: Optional[int],
     if replica is None:
         return []
     from hermes_cli import kanban_hub_admission_pickup as admission
+    from hermes_cli import kanban_pickup_held as kph
     own = _own(conn)
