+from hermes_cli.worker_drain_fence import popen_worker
+from tools.environments.local import build_subprocess_env
+
+
+def run_command(command, *, timeout, env=None, check=False, **kwargs):
+    """Retain a drain lease in the real child through exit, including parent loss.
+
+    Like subprocess.run, kill/reap the direct child on timeout or interruption.
+    Descendants retaining the inherited descriptor remain visible to the drain.
+    """
+    child_env = build_subprocess_env(scrub_secrets=True)
+    child_env.update(env or {})
+    with popen_worker(subprocess.Popen, command, env=child_env,
+                      drain_purpose='desktop.k01-mutants', **kwargs) as process:
+        try:
+            stdout, stderr = process.communicate(timeout=timeout)
+        except BaseException:
+            process.kill()
+            process.wait()
+            raise
+        result = subprocess.CompletedProcess(command, process.returncode, stdout, stderr)
+        if check:
+            result.check_returncode()
+        return result
+
+
