From 41714d589afc402ded558744d8178a94a3c87a21 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 14:31:55 +0000
Subject: [PATCH] fix(routing): reselect or type a rotated-off subscription
 pool before the retry [daveey]

Hub 2026-11-14 05:40Z (sessions 20000101_010000_000001, 20000101_010000_000002, both
anthropic/claude-sonnet-5-5): a 429 benched account-primary for that model only ("other models
stay available"), the pool had no other entry for it, so `pool.current()` stayed empty and the
turn waited 600 s. Attempt 2 died in `verify_class_runtime` on the non-retryable
"Subscription OAuth credential is unavailable; no selected pool entry". The opus sibling
(20000101_010000_000003) hit the same bench and got the typed SubscriptionQuotaUnavailable,
so the difference was the pool's state for sonnet after the wait, not the 429 itself.

Five whys:
1. Why non-retryable? verify_class_runtime only typed the empty selection when
   quota_unavailable() returned a wall; otherwise it raised the generic ModelRoutingError.
2. Why no wall? quota_unavailable() returns None when (a) some OAuth row has room for the
   model again (a sibling's model cooldown lapsed during the 600 s wait), or (b) a live row
   sits on an auth (401) bench with no cooldown of its own for the model (quota unproven).
3. Why was room not used? Nothing re-selected the pool between the failed rotation and the
   retry: the retry reused the benched key with `current` empty.
4. Why not the auth wall? verify_class_runtime lacked the auth_churned() rung that
   resolve_class_runtime already has.
5. Fix both: build_request_payload re-selects a subscription entry for the model when a
   rotation left none (reselect_class_credential, swaps the agent onto it), and
   verify_class_runtime raises SubscriptionAuthUnavailable for an auth-churned pool, the same
   ladder as resolution. The generic error remains only for a pool with neither room nor typed
   evidence, and for a foreign runtime key.

Tests (tests/agent/test_model_bench_wait_verify.py, real pool/runtime, HTTP mocked):
- sole model bench -> SubscriptionQuotaUnavailable (guard, green on base)
- 401-benched sibling w/o this model's cooldown -> SubscriptionAuthUnavailable (RED on base:
  "no selected pool entry")
- full agent wire: 200, 429 (13150 s window), 600 s wait during which the sibling's cooldown
  lapses -> third request goes out on the sibling token and the turn answers "ok" (RED on
  base with the exact hub sequence: attempt 1 RateLimitError, attempt 2 "no selected pool
  entry").
---
 agent/model_routing_runtime.py              |  27 ++++-
 agent/turn_api_request.py                   |   2 +
 tests/agent/test_model_bench_wait_verify.py | 119 ++++++++++++++++++++
 3 files changed, 145 insertions(+), 3 deletions(-)
 create mode 100644 tests/agent/test_model_bench_wait_verify.py

diff --git a/agent/model_routing_runtime.py b/agent/model_routing_runtime.py
index 770e9f14c7..c9772124bb 100644
--- a/agent/model_routing_runtime.py
+++ b/agent/model_routing_runtime.py
@@ -219,6 +219,22 @@ def refresh_class_responses_token(agent):
                                             reason='class_oauth_refresh')
 
 
+def reselect_class_credential(agent):
+    """[daveey] Re-adopt a subscription pool entry a rotation left unselected, before the next attempt.
+
+    A 429 that benches the last row for this model leaves ``pool.current()`` empty and the turn waits
+    (up to 600 s). A sibling row whose cooldown lapsed meanwhile is room, yet nothing reselected it, so
+    the pre-send check refused the retry as "no selected pool entry" (hub 2026-11-14 05:50Z)."""
+    metadata = getattr(agent, "model_routing", None)
+    pool = getattr(agent, "_credential_pool", None)
+    if not metadata or metadata.get("billing_group") != "subscription" or pool is None or pool.current():
+        return
+    entry = pool.select(model=agent.model)
+    if entry is not None and agent._swap_credential(entry) is not False:
+        logger.info("Class route re-selected pool entry %s for %s after a rotation left none",
+                    entry.label or entry.id[:8], agent.model)
+
+
 def verify_agent_class_credentials(agent):
     """Recheck the actual native credential immediately before client checkout."""
     metadata = getattr(agent, "model_routing", None)
@@ -243,12 +259,17 @@ def verify_class_runtime(runtime, metadata):
     pool = runtime.get("credential_pool")
     entry = pool.current() if pool else None
     if entry is None:
-        from agent.model_routing_unavailable import quota_unavailable
+        from agent.model_routing_unavailable import SubscriptionAuthUnavailable, auth_churned, quota_unavailable
+        model = metadata["selected_model"]
         if pool is not None and any(
             candidate.auth_type == "oauth" and candidate.runtime_api_key == runtime["api_key"]
             for candidate in pool.entries()
-        ) and (unavailable := quota_unavailable(pool, metadata["selected_model"])):
-            raise unavailable
+        ):
+            # [daveey] Same ladder as resolution: a rotated-off pool's own state types the refusal.
+            if unavailable := quota_unavailable(pool, model):
+                raise unavailable
+            if auth_churned(pool, model):
+                raise SubscriptionAuthUnavailable(metadata["selected_provider"], model)
         raise ModelRoutingError("Subscription OAuth credential is unavailable; no selected pool entry")
     if entry.auth_type != "oauth":
         raise ModelRoutingError("Subscription routing requires an OAuth credential, never a paid API key")
diff --git a/agent/turn_api_request.py b/agent/turn_api_request.py
index ead643a0b3..924e2e878d 100644
--- a/agent/turn_api_request.py
