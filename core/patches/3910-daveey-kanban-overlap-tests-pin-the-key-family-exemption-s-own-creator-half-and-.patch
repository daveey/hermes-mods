From 4dc17201a9c853a3618a7a58f715e22a1089bf6b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:23:05 +0000
Subject: [PATCH] [daveey] kanban overlap tests: pin the key-family exemption's
 own-creator half and unknown created_at

Post-merge check of PR #2605 (card t_01a1d6de4296483b) found two surviving mutants against
tests/tools/test_kanban_create_overlap_same_creator.py:

- D2 hermes_cli/kanban_overlap.py _find:
  `and not (own and _own.earlier_run(card, run_started))` -> `and not (_own.earlier_run(card, run_started))`.
  Another creator's same-family card from before this run would then be compared, so any keyed batch of
  another creator becomes a refusal source.
- D5 hermes_cli/kanban_overlap_own.py earlier_run:
  `created is not None and created < started` -> `(created is None or created < started)`.
  A card with no created_at would lose the exemption, against the docstring.

Two replay cases on the macbook incident fixture:
- test_another_creators_same_family_card_from_before_this_run_stays_exempt: the own earlier-run card is
  compared; the same card from another creator stays skipped (kills D2).
- test_an_own_same_family_card_with_no_created_at_stays_exempt: an own same-family card with created_at None
  stays exempt (kills D5).

Proof (sdlc-review scripts/mutants.py, worker-2):
- origin/main test file: baseline 62 passed; D2 SURVIVED, D5 SURVIVED.
- this commit: baseline 64 passed, 0 skipped; D2 killed (1 failed: the D2 test), D5 killed (1 failed: the D5 test).

Test-only; no production code changes.
---
 ...test_kanban_create_overlap_same_creator.py | 23 ++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

diff --git a/tests/tools/test_kanban_create_overlap_same_creator.py b/tests/tools/test_kanban_create_overlap_same_creator.py
index 4c159c3871..e43dfea3c5 100644
--- a/tests/tools/test_kanban_create_overlap_same_creator.py
+++ b/tests/tools/test_kanban_create_overlap_same_creator.py
@@ -42,7 +42,7 @@ def _card(c: dict, *, creator, local=True, status="running") -> dict:
 
 
 def _replay(case: dict):
-    a = _card(case["a"], creator=case["creator"])
+    a = _card(case["a"], creator=case.get("a_creator", case["creator"]))
     background = [_card({"id": f"t_bg{i:012x}", "title": "background", "body": body}, creator=None, local=False)
                   for i, body in enumerate(case["background"])]
     b = case["b"]
@@ -89,6 +89,27 @@ def test_same_key_family_from_an_earlier_run_is_compared():
     assert _replay(unknown) is None, "an unknown run start keeps the exemption"
 
 
+def test_another_creators_same_family_card_from_before_this_run_stays_exempt():
+    """Only the creator's OWN keyed cards from an earlier run lose the key-family exemption. Another creator's
+    same-family card from before this run stays skipped, or any keyed batch of another creator would become a
+    refusal source (post-merge check of PR #2605, mutant D2)."""
+    case = _incident()
+    assert _replay(case) is not None, "the creator's own earlier-run card is compared"
+    other = {**case, "a_creator": "t_0000000000000000"}
+    assert other["a_creator"] != case["creator"]
+    assert _replay(other) is None, "another creator's same-family card stays exempt"
+
+
+def test_an_own_same_family_card_with_no_created_at_stays_exempt():
+    """An own same-family card whose created_at is unknown is not provably from an earlier run, so it keeps the
+    exemption, as :func:`kanban_overlap_own.earlier_run` documents (post-merge check of PR #2605, mutant D5)."""
+    case = _incident()
+    no_time = {**case, "a": {**case["a"], "created_at": None}}
+    assert _replay(no_time) is None, "an own card with no created_at stays exempt by family"
+    assert not ko._own.earlier_run({"created_at": None}, case["run_started"])
+    assert ko._own.earlier_run({"created_at": case["a"]["created_at"]}, case["run_started"])
+
+
 @pytest.mark.parametrize("case", [c for c in CASES if c["kind"] == "duplicate"], ids=_cid)
 def test_recorded_same_creator_duplicate_is_refused(case):
     match = _replay(case)
