+            )
+            assert consumer._reopen_seeded_eagerly is True
+            assert consumer._awaiting_reopen_after_boundary is False
+            assert len(expired_drains) == int(expired_second_drain)
+        finally:
+            consumer.finish()
+            await asyncio.wait_for(task, timeout=2.0)
 
 
