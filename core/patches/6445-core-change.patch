@@ -1004,53 +1005,66 @@
         consumer = GatewayStreamConsumer(adapter, "chat-1", cfg)
 
         # 第一轮：boundary → eager seed → 内容。
+        expired_drains = []
+        if expired_second_drain:
+            original_drain = self._drain
+
+            async def drain(consumer, seconds=0.15):
+                if consumer._awaiting_reopen_after_boundary and consumer._reopen_seeded_eagerly:
+                    # A descheduled waiter can return from _drain after its wall
+                    # deadline without giving the consumer another poll. Force that order.
+                    expired_drains.append(True)
+                    return
+                await original_drain(consumer, seconds)
+
+            monkeypatch.setattr(self, "_drain", drain)
         task = await self._to_reopen_pending(consumer, adapter)
-        consumer.request_reopen_seed()
