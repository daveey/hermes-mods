diff --git a/scripts/code_health/py_rules_websockets.py b/scripts/code_health/py_rules_websockets.py
new file mode 100644
index 0000000000000000000000000000000000000000..9aaffac699edf3b7d5cc744a388ca3fbeb5d23fc
--- /dev/null
+++ b/scripts/code_health/py_rules_websockets.py
@@ -0,0 +1,43 @@
+"""HX015: a websockets connection opened without ``logger=`` (registered in ``py_rules.CHECKERS``).
+
+websockets logs a peer that stops answering pings as ``ERROR keepalive ping failed`` + traceback from its own
+keepalive thread, even when the caller handles the drop (reconnect, end the stream). Every Hermes call site
+passes ``logger=hermes_cli.ws_logging.ws_logger()`` so that handled drop is one INFO line.
+"""
+
+from __future__ import annotations
+
+import ast
+from collections.abc import Iterable
+
+from scripts.code_health.py_ast import Ctx, _call_name
+
+# Canonical names (``canonical_tree`` resolves import aliases) of the calls that open a websockets connection.
+_OPENERS = frozenset({
+    "websockets.connect", "websockets.serve",
+    "websockets.client.connect", "websockets.server.serve",
+    "websockets.sync.client.connect", "websockets.sync.server.serve",
+    "websockets.asyncio.client.connect", "websockets.asyncio.server.serve",
+    "websockets.legacy.client.connect", "websockets.legacy.server.serve",
+})
+
+
+def _imported_openers(tree: ast.Module) -> dict[str, str]:
+    """Local names bound by ``from websockets... import connect/serve``. ``canonical_tree`` leaves a name alone
+    when the module also rebinds it (``except ImportError: connect = None``), so match those by name."""
+    names: dict[str, str] = {}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.ImportFrom) and (node.module or "").split(".")[0] == "websockets":
+            for alias in node.names:
+                if f"{node.module}.{alias.name}" in _OPENERS:
+                    names[alias.asname or alias.name] = f"{node.module}.{alias.name}"
+    return names
+
+
+def ws_without_logger(tree: ast.Module, ctx: Ctx) -> Iterable[int]:
+    local = _imported_openers(tree)
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.Call) or any(kw.arg == "logger" for kw in node.keywords):
+            continue
+        if _call_name(node) in _OPENERS or (isinstance(node.func, ast.Name) and node.func.id in local):
+            yield node.lineno
diff --git a/tests/hermes_cli/test_kanban_feed_keepalive.py b/tests/hermes_cli/test_kanban_feed_keepalive.py
new file mode 100644
index 0000000000000000000000000000000000000000..670bb9c302e4942c740996c7b07b4f909ceb1419
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_feed_keepalive.py
@@ -0,0 +1,124 @@
+"""A Board feed socket that goes silent is a handled drop: FeedWatcher reconnects, and nothing logs at ERROR.
+
+Regression for self-heal defect agent-ac35b4d534: websockets' sync keepalive thread logged
+``ERROR websockets.client: keepalive ping failed`` + traceback when the Board stopped answering pings, one
+millisecond before FeedWatcher's own INFO "feed socket closed ... reconnecting" line. errors.log then read like an
+unhandled crash and self-heal filed it as a defect. Hermes now passes its own logger (``hermes_cli.ws_logging``),
+so that case is one INFO line.
+"""
+
+from __future__ import annotations
+
+import functools
+import logging
+import socket
+import threading
+
+import pytest
+
+from hermes_cli import kanban_sync_client as ksc
+from tests.waiting import wait_until
+
+pytest.importorskip("websockets")
+
+
+class _SilentRelay:
+    """TCP relay in front of a real websocket server: forwards the HTTP upgrade both ways, then reads and drops
+    every later byte, like a Board that stops answering pings without closing the socket."""
+
+    def __init__(self, upstream_port: int) -> None:
+        self.upstream_port = upstream_port
+        self.listener = socket.create_server(("127.0.0.1", 0))
+        self.listener.settimeout(0.1)
+        self.port = self.listener.getsockname()[1]
+        self.connections = 0
+        self._stop = threading.Event()
+        self._socks: list[socket.socket] = []
+        threading.Thread(target=self._accept, daemon=True).start()
+
+    def _accept(self) -> None:
+        while not self._stop.is_set():
+            try:
+                client, _ = self.listener.accept()
+            except OSError:  # accept timeout (TimeoutError is an OSError) or the listener closed
+                continue
+            self.connections += 1
+            upstream = socket.create_connection(("127.0.0.1", self.upstream_port))
+            self._socks += [client, upstream]
+            for src, dst in ((client, upstream), (upstream, client)):
+                threading.Thread(target=self._pipe, args=(src, dst), daemon=True).start()
+
+    def _pipe(self, src: socket.socket, dst: socket.socket) -> None:
+        head = b""  # bytes seen so far while the HTTP upgrade is still in flight
+        while not self._stop.is_set():
+            try:
+                data = src.recv(65536)
+            except OSError:
+                return
+            if not data:
+                return
+            if head is None:
+                continue  # upgraded: swallow the frame
+            seen, head = len(head), head + data
+            end = head.find(b"\r\n\r\n")
+            upto = len(head) if end < 0 else end + 4
+            try:
+                dst.sendall(head[seen:upto])
+            except OSError:
+                return
+            if end >= 0:
+                head = None
+
+    def close(self) -> None:
+        self._stop.set()
+        for s in [self.listener, *self._socks]:
+            s.close()
+
+
+def test_silent_board_socket_reconnects_without_an_error_record(monkeypatch, caplog):
+    import websockets.sync.client as ws_client
+    from websockets.sync.server import serve
+
+    # Library keepalive at 0.3 s (production keeps the library's 20 s default). Every other kwarg, logger
+    # included, is whatever FeedWatcher passes.
+    monkeypatch.setattr(ws_client, "connect", functools.partial(ws_client.connect, ping_interval=0.3,
+                                                                ping_timeout=0.3, close_timeout=0.3))
+    stop = threading.Event()
+
+    def handler(ws):
+        ws.send('{"type": "hello", "head": 1}')
+        while not stop.is_set():
+            try:
+                ws.recv(timeout=0.2)
+            except TimeoutError:
+                continue
+            except Exception:  # the client dropped the socket; the test server just ends
+                return
+
+    caplog.set_level(logging.DEBUG)
+    caplog.set_level(logging.DEBUG, logger="websockets.client")  # hermes_logging pins it at WARNING in production
+    with serve(handler, "127.0.0.1", 0, logger=logging.getLogger("test.board_server")) as server:
+        threading.Thread(target=server.serve_forever, daemon=True).start()
+        relay = _SilentRelay(server.socket.getsockname()[1])
+        ident = ksc.Identity(url=f"http://127.0.0.1:{relay.port}", key="gw-key", gateway="gw-test")
+        watcher = ksc.FeedWatcher(ident, "keepalive-board", threading.Event(), lambda: not stop.is_set(), ping_s=0.5)
+        t = threading.Thread(target=watcher.run, daemon=True)
+        t.start()
+        try:
+            wait_until(lambda: relay.connections >= 2, timeout=15, what="the silent socket dropped and reconnected")
+            wait_until(lambda: any("keepalive ping failed" in r.getMessage() for r in caplog.records), timeout=5,
+                       what="the library's keepalive failure record")
+        finally:
+            stop.set()
+            relay.close()
+            server.shutdown()
+            t.join(timeout=5)
+
+    closed = [r for r in caplog.records if "feed socket closed" in r.getMessage()]
+    assert closed and all(r.levelno == logging.INFO for r in closed), "FeedWatcher logs the drop at INFO"
+    errors = [f"{r.name}: {r.getMessage()}" for r in caplog.records
+              if r.levelno >= logging.ERROR and not r.name.startswith("test.")]
+    assert errors == [], f"a handled keepalive drop must not log at ERROR: {errors}"
+    keepalive = [r for r in caplog.records if "keepalive ping failed" in r.getMessage()]
+    assert all(r.levelno == logging.INFO and not r.exc_info for r in keepalive), \
+        "the keepalive failure is one INFO line without a traceback"
diff --git a/tests/hermes_cli/test_ws_logging.py b/tests/hermes_cli/test_ws_logging.py
new file mode 100644
index 0000000000000000000000000000000000000000..a0be87abd723027ee7ccb56dbc95c519a252edda
--- /dev/null
+++ b/tests/hermes_cli/test_ws_logging.py
@@ -0,0 +1,46 @@
+"""hermes_cli.ws_logging: the one handled websockets failure becomes an INFO line; everything else keeps its level."""
+
+from __future__ import annotations
+
+import logging
+
+from hermes_cli.ws_logging import ws_logger
+
+
+def _raise_and_log(log, msg):
+    try:
+        raise TimeoutError("timed out while closing connection")
+    except TimeoutError:
+        log.error(msg, exc_info=True)
+
+
+def test_keepalive_failure_is_one_info_line_naming_the_cause(caplog):
+    caplog.set_level(logging.DEBUG, logger="websockets.client")
+    _raise_and_log(ws_logger(), "keepalive ping failed")
+    [rec] = caplog.records
+    assert rec.name == "websockets.client" and rec.levelno == logging.INFO and not rec.exc_info
+    assert "keepalive ping failed (TimeoutError: timed out while closing connection)" in rec.getMessage()
+
+
+def test_other_errors_keep_their_level_and_traceback(caplog):
+    caplog.set_level(logging.DEBUG)
+    caplog.set_level(logging.DEBUG, logger="websockets")  # hermes_logging pins it at WARNING
+    _raise_and_log(ws_logger("server"), "unexpected internal error")
+    log = ws_logger()
+    log.warning("keepalive ping failed")  # below ERROR: untouched
+    log.debug("% sent keepalive ping")
+    recs = [(r.name, r.levelno, bool(r.exc_info)) for r in caplog.records]
+    assert recs == [("websockets.server", logging.ERROR, True), ("websockets.client", logging.WARNING, False),
+                    ("websockets.client", logging.DEBUG, False)]
+
+
+def test_level_config_of_the_library_logger_still_applies(caplog):
+    caplog.set_level(logging.DEBUG)
+    logging.getLogger("websockets.client").setLevel(logging.WARNING)
+    try:
+        log = ws_logger()
+        assert not log.isEnabledFor(logging.INFO)  # websockets reads this to decide on debug output
+        _raise_and_log(log, "keepalive ping failed")
+        assert caplog.records == []  # demoted to INFO, below the library logger's WARNING floor
+    finally:
+        logging.getLogger("websockets.client").setLevel(logging.NOTSET)
diff --git a/tests/scripts/test_code_health_ws_rule.py b/tests/scripts/test_code_health_ws_rule.py
new file mode 100644
index 0000000000000000000000000000000000000000..8bf2c4fe52562347d4fe0ff92bc40d6fcb17c12f
--- /dev/null
+++ b/tests/scripts/test_code_health_ws_rule.py
@@ -0,0 +1,46 @@
+"""HX015: a websockets connection opened without ``logger=`` (the library then logs a handled keepalive drop as
+ERROR + traceback; regression for self-heal defect agent-ac35b4d534)."""
+
+from __future__ import annotations
+
+import ast
+
+import pytest
+
+from scripts.code_health.config import RULES_BY_ID, rule_applies
+from scripts.code_health.py_rules import CHECKERS, Ctx, canonical_tree
+
+
+def _hits(src: str) -> list[int]:
+    return sorted(set(CHECKERS["HX015"](canonical_tree(ast.parse(src)), Ctx())))
+
+
+@pytest.mark.parametrize("src, flagged", [
+    ("from websockets.sync.client import connect\nconnect('ws://x')\n", True),
+    ("def f():\n    from websockets.sync.client import connect\n    with connect('ws://x') as ws:\n        pass\n", True),
+    ("import websockets\nasync def f():\n    async with websockets.connect('ws://x') as ws:\n        pass\n", True),
+    ("import websockets as w\nasync def f():\n    await w.connect('ws://x', **kw)\n", True),  # a splat is not a logger
+    ("import websockets.asyncio.client as c\nasync def f():\n    await c.connect('ws://x')\n", True),
+    ("import websockets\nasync def f():\n    async with websockets.serve(h, 'h', 1):\n        pass\n", True),
+    ("from websockets.sync.server import serve\nserve(h, 'h', 1)\n", True),
+    # optional import with a None fallback: the name is rebound, still the library's connect
+    ("try:\n    from websockets.sync.client import connect as ws_connect\nexcept ImportError:\n"
+     "    ws_connect = None\nws_connect('ws://x')\n", True),
+    # the fix shape
+    ("from websockets.sync.client import connect\nconnect('ws://x', logger=ws_logger())\n", False),
+    ("import websockets\nasync def f():\n    await websockets.connect('ws://x', logger=lg, **kw)\n", False),
+    ("from websockets.sync.server import serve\nserve(h, 'h', 1, logger=ws_logger('server'))\n", False),
+    # not websockets
+    ("import sqlite3\nsqlite3.connect('db')\n", False),
+    ("def connect(u):\n    return u\nconnect('ws://x')\n", False),
+])
+def test_ws_without_logger_shapes(src, flagged):
+    assert bool(_hits(src)) is flagged, src
+
+
+def test_scope_is_production_code():
+    rule = RULES_BY_ID["HX015"]
+    assert rule_applies(rule, "hermes_cli/kanban_sync_client.py")
+    assert rule_applies(rule, "plugins/platforms/buzz/adapter.py")
+    assert not rule_applies(rule, "tests/hermes_cli/test_kanban_feed_keepalive.py")
+    assert not rule_applies(rule, "evals/liveness/ws_orphan_reconnect.py")
