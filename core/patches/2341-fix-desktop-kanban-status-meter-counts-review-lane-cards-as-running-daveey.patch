From 9eed89dbd323f2db07d51b6a55fd8bfffdf92c0e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:28:07 +0000
Subject: [PATCH] fix(desktop/kanban): status meter counts review-lane cards as
 running [daveey]

Review is nonterminal work (an agent is checking it); omitting it hid the pill
on a review-only board. Adds review-only and running->review conservation tests.
Addresses review t_01a1cc9171ed4dc1 on PR #1147.
---
 .../src/plugins/kanban/status-meter.test.tsx       | 14 +++++++++++---
 apps/desktop/src/plugins/kanban/status-meter.tsx   |  6 ++++--
 2 files changed, 15 insertions(+), 5 deletions(-)

diff --git a/apps/desktop/src/plugins/kanban/status-meter.test.tsx b/apps/desktop/src/plugins/kanban/status-meter.test.tsx
index ef2cd9a6486..dc89e243e32 100644
--- a/apps/desktop/src/plugins/kanban/status-meter.test.tsx
+++ b/apps/desktop/src/plugins/kanban/status-meter.test.tsx
@@ -10,7 +10,7 @@ const col = (name: string, n: number) => ({ name, tasks: Array.from({ length: n
 afterEach(cleanup)
 
 describe('kanban status meter', () => {
-  it('maps lanes to segments: triage/todo/scheduled are not ready; review/done/archived are left out', () => {
+  it('maps lanes to segments: triage/todo/scheduled are not ready, review runs; done/archived are left out', () => {
     const counts = meterCounts({
       columns: [
         col('triage', 1),
@@ -25,8 +25,16 @@ describe('kanban status meter', () => {
       ]
     })
 
-    expect(counts).toEqual({ blocked: 6, notReady: 6, ready: 4, running: 5 })
-    expect(meterTotal(counts)).toBe(21)
+    expect(counts).toEqual({ blocked: 6, notReady: 6, ready: 4, running: 12 })
+    expect(meterTotal(counts)).toBe(28)
+  })
+
+  it('a review-only board still counts (the pill must not vanish), and running -> review keeps the total', () => {
+    expect(meterTotal(meterCounts({ columns: [col('review', 1)] }))).toBe(1)
+    const before = meterCounts({ columns: [col('running', 2), col('ready', 1)] })
+    const after = meterCounts({ columns: [col('running', 1), col('review', 1), col('ready', 1)] })
+    expect(meterTotal(after)).toBe(meterTotal(before))
+    expect(after.running).toBe(before.running)
   })
 
   it('draws one coloured segment per non-empty state, widths proportional to the counts', () => {
diff --git a/apps/desktop/src/plugins/kanban/status-meter.tsx b/apps/desktop/src/plugins/kanban/status-meter.tsx
index 255fc028c91..8cf7ebcdecb 100644
--- a/apps/desktop/src/plugins/kanban/status-meter.tsx
+++ b/apps/desktop/src/plugins/kanban/status-meter.tsx
@@ -1,8 +1,9 @@
 /**
  * [daveey] Status-bar task meter: one bar split by where open cards stand.
  * yellow = not ready yet (triage/todo/scheduled), green = ready, red = blocked
- * (waiting on the user), blue = running. Segment widths are proportional to
- * the counts; review/done/archived cards are not open work and are left out.
+ * (waiting on the user), blue = running (review counts as running: an agent is
+ * still working it). Segment widths are proportional to the counts; only
+ * done/archived cards are left out.
  */
 
 import type { KanbanBoard } from './types'
@@ -23,6 +24,7 @@ export const METER_COLORS: Record<MeterSegment, string> = {
 const SEGMENT_OF: Record<string, MeterSegment> = {
   blocked: 'blocked',
   ready: 'ready',
+  review: 'running',
   running: 'running',
   scheduled: 'notReady',
   todo: 'notReady',
-- 
