From 0374aa8e810995aa21b3155445ae71b47245abf9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 11:51:33 +0000
Subject: [PATCH] fix(ci): resolve upstream sync gh under service PATH [daveey]

---
 scripts/ci/upstream_sync.py            | 11 ++++--
 tests/scripts/ci/test_upstream_sync.py | 49 ++++++++++++++++++++++++++
 2 files changed, 58 insertions(+), 2 deletions(-)

diff --git a/scripts/ci/upstream_sync.py b/scripts/ci/upstream_sync.py
index a72d5695fdc..f83261ca8b7 100644
--- a/scripts/ci/upstream_sync.py
+++ b/scripts/ci/upstream_sync.py
@@ -76,8 +76,15 @@ def _gate_env(stage: str) -> dict:
 
 def github_pages(endpoint):
     """Every page of a GitHub API GET: the logged-in gh, else the broker's ``user/github`` scope."""
-    argv = ["gh", "api", "--paginate", "--slurp", endpoint]
-    proc = subprocess.run(argv, capture_output=True, text=True, encoding="utf-8", timeout=120, check=False)
+    # This standalone gate also runs before the core environment is activated, under systemd's PATH.
+    install_dirs = (Path.home() / "bin", Path.home() / ".local/bin", Path("/opt/homebrew/bin"), Path("/usr/local/bin"))
+    gh = shutil.which("gh") or shutil.which("gh", path=os.pathsep.join(map(str, install_dirs)))
+    argv = [gh or "gh", "api", "--paginate", "--slurp", endpoint]
+    try:
+        proc = subprocess.run(argv, capture_output=True, text=True, encoding="utf-8", timeout=120, check=False)
+    except FileNotFoundError:
+        # A broker may supply its own PATH; missing locally must not skip that recovery path.
+        proc = subprocess.CompletedProcess(argv, 127, "", "gh not found in PATH or known install directories")
     broker = shutil.which("token-broker") or str(Path.home() / ".local/bin/token-broker")
     if proc.returncode and Path(broker).exists():
         proc = subprocess.run([broker, "exec", "--scope", "user/github", "--reason",
diff --git a/tests/scripts/ci/test_upstream_sync.py b/tests/scripts/ci/test_upstream_sync.py
index 1d35e975068..a8f2593e471 100644
--- a/tests/scripts/ci/test_upstream_sync.py
+++ b/tests/scripts/ci/test_upstream_sync.py
@@ -304,8 +304,57 @@ def test_pre_push_guard_refuses_a_hand_pushed_sync_and_allows_fork_work(world):
 
 
 def test_github_transport_reads_all_pages(monkeypatch):
+    monkeypatch.setattr(sync.shutil, "which", lambda *a, **kw: "gh")
+
     def run(command, **kwargs):
         assert command[:4] == ["gh", "api", "--paginate", "--slurp"]
         return subprocess.CompletedProcess(command, 0, json.dumps([{"jobs": []}, {"jobs": []}]), "")
     monkeypatch.setattr(subprocess, "run", run)
     assert len(sync.github_pages("repos/example/fork/actions/runs/1/jobs?per_page=100")) == 2
+
+
+def executable(path, body):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(f"#!{sys.executable}\n" + body)
+    path.chmod(0o755)
+
+
+@pytest.mark.parametrize("broker", [False, True])
+def test_github_transport_finds_home_bin_with_updater_path(tmp_path, monkeypatch, broker):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("PATH", "/usr/local/bin:/usr/bin:/bin")
+    which = sync.shutil.which
+    monkeypatch.setattr(sync.shutil, "which",
+                        lambda name, **kw: None if name == "gh" and not kw else which(name, **kw))
+    executable(tmp_path / "bin/gh", "import os, sys\n"
+               + ("if not os.environ.get('BROKER_TEST'): sys.exit(1)\n" if broker else "")
+               + "print('[{\"jobs\": []}, {\"jobs\": []}]')\n")
+    if broker:
+        executable(tmp_path / ".local/bin/token-broker",
+                   "import os, sys\nos.environ['BROKER_TEST']='1'\n"
+                   "args=sys.argv[sys.argv.index('--')+1:]\nos.execv(args[0], args)\n")
+    assert sync.github_pages("repos/example/fork/jobs") == [{"jobs": []}, {"jobs": []}]
+
+
+def test_github_transport_missing_locally_can_use_broker(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("PATH", str(tmp_path / "empty"))
+    monkeypatch.setattr(sync.shutil, "which", lambda *a, **kw: None)
+    executable(tmp_path / ".local/bin/token-broker",
+               "import sys\nassert sys.argv[sys.argv.index('--')+1:] == "
+               "['gh', 'api', '--paginate', '--slurp', 'repos/example/fork/jobs']\n"
+               "print('[{\"jobs\": []}]')\n")
+    assert sync.github_pages("repos/example/fork/jobs") == [{"jobs": []}]
+
+
+def test_github_transport_missing_everywhere_refuses_cleanly(tmp_path, monkeypatch, capsys):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("PATH", str(tmp_path / "empty"))
+    monkeypatch.setattr(sync.shutil, "which", lambda *a, **kw: None)
+    assert sync.advance(tmp_path, None, gh_repo="example/fork", request=sync.github_pages) == sync.REFUSED
+    output = capsys.readouterr().out
+    assert "REFUSED:" in output and "gh not found" in output
+    assert "Traceback" not in output
-- 
