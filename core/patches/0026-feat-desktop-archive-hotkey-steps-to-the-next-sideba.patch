---
 apps/desktop/src/app/contrib/wiring.tsx       | 13 +++--
 .../hooks/use-session-actions.test.tsx        | 47 +++++++++++++++++++
 .../hooks/use-session-actions/index.ts        | 10 +++-
 3 files changed, 65 insertions(+), 5 deletions(-)

diff --git a/apps/desktop/src/app/contrib/wiring.tsx b/apps/desktop/src/app/contrib/wiring.tsx
index 4e54d456e2..4099a86683 100644
--- a/apps/desktop/src/app/contrib/wiring.tsx
+++ b/apps/desktop/src/app/contrib/wiring.tsx
@@ -89,6 +89,7 @@ import {
 import { $focusedStoredSessionId } from '@/store/session-focus'
 import { reportPendingUpdateRun } from '@/store/shared-metrics'
 import { $archivedSessions } from '@/store/sidebar-archive'
+import { nextSidebarSessionId } from '@/store/sidebar-visible-order'
 import { $titlebarAppActionsSide, titlebarAppActionsClusterCounts } from '@/store/titlebar-app-actions'
 import { armWakeWord, stopClientCapture } from '@/store/wake-word'
 import { isAuxiliaryWindow, isBrowserWindow, isHudWindow, isMainWindow } from '@/store/windows'
@@ -1003,7 +1004,10 @@ export function ContribWiring({ children }: { children: ReactNode }) {
     void openNewSessionTile('center', { listed: false })
   }, [openNewSessionTile])
 
-  // Archive the selected session (rebindable `session.archive` hotkey).
+  // Archive the selected session (rebindable `session.archive` hotkey), then
+  // step to the next sidebar session exactly like ⌘] (needs-you first, else
+  // the plain neighbour) instead of dropping to a fresh draft. The target is
+  // computed BEFORE the row leaves the sidebar so its position is still known.
   const archiveSelectedSession = useCallback(() => {
     // The clicked row, else the chat that's open.
     const sessionId = $selectedStoredSessionId.get() || $focusedStoredSessionId.get()
@@ -1012,8 +1016,11 @@ export function ContribWiring({ children }: { children: ReactNode }) {
       return
     }
 
-    void archiveSession(sessionId)
-  }, [archiveSession])
+    const next = nextSidebarSessionId(sessionId, 1, false)
+    const onDeselect = next && next !== sessionId ? () => openSession(next, navigate) : undefined
+
+    void archiveSession(sessionId, { onDeselect })
+  }, [archiveSession, navigate])
 
   // Single global listener for every rebindable hotkey plus the on-screen
   // keybind editor's capture mode (same as DesktopController).
diff --git a/apps/desktop/src/app/session/hooks/use-session-actions.test.tsx b/apps/desktop/src/app/session/hooks/use-session-actions.test.tsx
index d3d57a9830..4a1a3c066b 100644
--- a/apps/desktop/src/app/session/hooks/use-session-actions.test.tsx
+++ b/apps/desktop/src/app/session/hooks/use-session-actions.test.tsx
@@ -6638,6 +6638,53 @@ describe('removeSession / archiveSession profile routing (#78836)', () => {
     expect($messagingSessions.get()).toEqual([])
   })
 
+  it('archiving the open session hands off to onDeselect instead of a fresh draft', async () => {
+    mockSetSessionArchived.mockResolvedValue({ ok: true })
+    setMessagingSessions([storedSession({ id: 'tg-open', profile: 'winefox', source: 'telegram' })])
+    const navigate = vi.fn()
+    const onDeselect = vi.fn()
+    let handle: HarnessHandle | null = null
+    render(
+      <Harness
+        navigate={navigate}
+        onReady={value => (handle = value)}
+        requestGateway={vi.fn(async () => ({}) as never)}
+        selectedStoredSessionId="tg-open"
+      />
+    )
+    await waitFor(() => expect(handle).not.toBeNull())
+
+    await act(async () => {
+      await handle!.archiveSession('tg-open', { onDeselect })
+    })
+
+    expect(onDeselect).toHaveBeenCalledTimes(1)
+    expect(navigate).not.toHaveBeenCalled()
+    expect(mockSetSessionArchived).toHaveBeenCalledWith('tg-open', true, 'winefox')
+  })
+
+  it('archiving the open session without onDeselect still drops to a fresh draft', async () => {
+    mockSetSessionArchived.mockResolvedValue({ ok: true })
+    setMessagingSessions([storedSession({ id: 'tg-open-2', profile: 'winefox', source: 'telegram' })])
+    const navigate = vi.fn()
+    let handle: HarnessHandle | null = null
+    render(
+      <Harness
+        navigate={navigate}
+        onReady={value => (handle = value)}
+        requestGateway={vi.fn(async () => ({}) as never)}
+        selectedStoredSessionId="tg-open-2"
+      />
+    )
+    await waitFor(() => expect(handle).not.toBeNull())
+
+    await act(async () => {
+      await handle!.archiveSession('tg-open-2')
+    })
+
+    expect(navigate).toHaveBeenCalled()
+  })
+
   it('restores a failed archive to the messaging slice', async () => {
     setMessagingSessions([storedSession({ id: 'tg-arch-fail', profile: 'winefox', source: 'telegram' })])
     mockSetSessionArchived.mockRejectedValue(new Error('archive failed'))
diff --git a/apps/desktop/src/app/session/hooks/use-session-actions/index.ts b/apps/desktop/src/app/session/hooks/use-session-actions/index.ts
index 7635e7e27d..6f2c284c0e 100644
--- a/apps/desktop/src/app/session/hooks/use-session-actions/index.ts
+++ b/apps/desktop/src/app/session/hooks/use-session-actions/index.ts
@@ -3332,7 +3332,9 @@ export function useSessionActions({
   )
 
   const archiveSession = useCallback(
-    async (storedSessionId: string) => {
+    // `onDeselect` replaces the fresh-draft fallback when the archived session
+    // was the open one (the ⌘⇧A hotkey steps to the next sidebar session).
+    async (storedSessionId: string, options?: { onDeselect?: () => void }) => {
       clearNotifications()
 
       const listed = findListedSession(storedSessionId)
@@ -3365,7 +3367,11 @@ export function useSessionActions({
       $pinnedSessionIds.set(previousPinned.filter(id => id !== storedSessionId && id !== archivedPinId))
 
       if (wasSelected) {
-        startFreshSessionDraft(true)
+        if (options?.onDeselect) {
+          options.onDeselect()
+        } else {
+          startFreshSessionDraft(true)
+        }
       }
 
       try {
