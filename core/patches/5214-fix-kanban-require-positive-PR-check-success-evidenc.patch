From 0efafb5f2854958effc1974675790b1691aac10a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 11:34:33 +0000
Subject: [PATCH] fix(kanban): require positive PR check success evidence
 [daveey]

Completed checks can carry stale, missing or future conclusions. The PR reducer rejected only failure/cancelled and certified every other value as success, releasing scheduled cards incorrectly. Classify stale as failed and retain unknown conclusions without waking. Success, neutral and skipped remain supported. Proof: 18 public-adapter and real apply_poll cases; 8 red on 4a370020, all 18 green after fix.
---
 hermes_cli/kanban_external_adapters/github.py |  4 +-
 .../test_kanban_external_review3.py           | 37 +++++++++++++++++++
 2 files changed, 40 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_cli/test_kanban_external_review3.py

diff --git a/hermes_cli/kanban_external_adapters/github.py b/hermes_cli/kanban_external_adapters/github.py
index 71533094e6..a44ecb4186 100644
--- a/hermes_cli/kanban_external_adapters/github.py
+++ b/hermes_cli/kanban_external_adapters/github.py
@@ -282,10 +282,12 @@ def _pr_verdict(api: Callable[[str], dict], repo: str, head: str, base: str, now
         if any(r.get("status") != "completed" for r in runs):
             return "running", "checks running"
         concl = [r.get("conclusion") for r in runs]
-    if any(c in _FAILED for c in concl):
+    if any(c in (*_FAILED, "stale") for c in concl):
         return "failed", "checks failed"
     if "cancelled" in concl:
         return "cancelled", "checks cancelled"
+    if any(c not in ("success", "neutral", "skipped") for c in concl):
+        return "unknown", "checks completed without a known conclusion"
     if not required:
         newest = max((kcp._epoch(r.get("updated_at")) or 0) for r in runs)
         if (time.time() if now is None else float(now)) - newest < SETTLE_SECONDS:
diff --git a/tests/hermes_cli/test_kanban_external_review3.py b/tests/hermes_cli/test_kanban_external_review3.py
new file mode 100644
index 0000000000..2f1d0c345c
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_external_review3.py
@@ -0,0 +1,37 @@
+"""PR verdicts require positive success evidence, including real parked-card wakes."""
+import pytest
+
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_external_watch as kew
+from hermes_cli import kanban_wake_check as kwc
+from tests.hermes_cli import test_kanban_external_review as r
+from tests.hermes_cli import test_kanban_external_watch as h
+
+kanban_home = h.kanban_home
+
+
+@pytest.mark.parametrize("required", [True, False])
+@pytest.mark.parametrize("conclusion,outcome", [
+    ("stale", "failed"), (None, "unknown"), ("", "unknown"), ("future_result", "unknown"),
+    ("success", "succeeded"), ("neutral", "succeeded"), ("skipped", "succeeded"),
+    ("failure", "failed"), ("cancelled", "cancelled"),
+])
+def test_pr_conclusion_controls_real_wake(monkeypatch, kanban_home, required, conclusion, outcome):
+    """A completed check is not necessarily successful; unknown results retain the park."""
+    runs = [r._run(1, "completed", "success" if required else conclusion)]
+    kw = {"required": {"required"}, "checks": [r._check(1, "required", conclusion=conclusion)]} if required else {}
+    poll = r._pr(monkeypatch, runs, **kw)
+    with kbc.connect_closing() as conn:
+        tid = h.park(conn, ref=f"https://github.com/{h.REPO}/pull/9")
+        kew.apply_poll(conn, tid, poll, now=h.T0, adapter="github_pr_checks", scope=h.REPO)
+        wakes = h.events(conn, tid, kwc.CONDITION_MET_EVENT)
+        assert poll["job"] == outcome
+        assert poll["service"] == "ok"
+        if outcome == "unknown":
+            assert not wakes
+            assert h.status(conn, tid) == "scheduled"
+            assert kew.card_state(conn, tid, now=h.T0)["state"] == "external_unknown"
+        else:
+            assert len(wakes) == 1
+            assert wakes[0]["external_result"]["outcome"] == outcome
+            assert h.status(conn, tid) == "ready"
