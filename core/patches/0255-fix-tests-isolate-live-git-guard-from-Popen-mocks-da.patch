From 0d1cfac0651c714313ff5a0d0953ba0397864996 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 24 Oct 2026 04:09:40 +0000
Subject: [PATCH] fix(tests): isolate live git guard from Popen mocks [daveey]

---
 tests/conftest.py                   |  7 ++++--
 tests/test_live_git_config_guard.py | 37 +++++++++++++++++++++++++++++
 2 files changed, 42 insertions(+), 2 deletions(-)

diff --git a/tests/conftest.py b/tests/conftest.py
index 838a7276a5..9006dfc4c8 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -27,6 +27,7 @@ import sqlite3
 import sys
 import tempfile
 from pathlib import Path
+from subprocess import Popen as _GUARD_POPEN
 
 import pytest
 
@@ -497,10 +498,12 @@ def _live_git_config_paths() -> list:
 
 
 def _plain_run(argv: list):
-    """``(returncode, stdout)`` via Popen, immune to tests that fake ``subprocess.run``."""
+    """``(returncode, stdout)`` independent of per-test subprocess mocks."""
     import subprocess
 
-    proc = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
+    # Capture Popen at conftest import: teardown can precede monkeypatch undo.
+    # Capturing subprocess.run instead would still look up the mocked Popen.
+    proc = _GUARD_POPEN(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
     out, _ = proc.communicate()
     return proc.returncode, out
 
diff --git a/tests/test_live_git_config_guard.py b/tests/test_live_git_config_guard.py
index df9fae91ed..b4f1adce57 100644
--- a/tests/test_live_git_config_guard.py
+++ b/tests/test_live_git_config_guard.py
@@ -1,6 +1,9 @@
 """Regression: the conftest guard catches writes to a checkout's shared .git/config."""
 
 import subprocess
+from types import SimpleNamespace
+
+from tests import conftest as guard
 
 import pytest
 
@@ -12,6 +15,40 @@ def _init(path):
     return path / ".git" / "config"
 
 
+@pytest.mark.parametrize("fake_kind", ["incomplete", "none", "refused"])
+@pytest.mark.parametrize("mutate", [False, True])
+def test_guard_teardown_with_mocked_popen(tmp_path, monkeypatch, fake_kind, mutate):
+    cfg = _init(tmp_path)
+    monkeypatch.setattr(guard, "_live_git_config_paths", lambda: [cfg])
+    request = SimpleNamespace(node=SimpleNamespace(get_closest_marker=lambda name: None))
+    fixture = guard._live_git_config_guard.__wrapped__(request)
+    next(fixture)
+    if mutate:
+        subprocess.run([
+            "git", "config", "--file", str(cfg), "user.email", "fixture@example.invalid",
+        ], check=True)
+
+    def fake_popen(*args, **kwargs):
+        if fake_kind == "refused":
+            pytest.fail("test forbids application subprocesses")
+        return SimpleNamespace(pid=123) if fake_kind == "incomplete" else None
+
+    def fake_run(*args, **kwargs):
+        pytest.fail("guard must not call mocked subprocess.run")
+
+    # Restore mocks even on failure so pytest can render the regression report.
+    with monkeypatch.context() as mocks:
+        mocks.setattr(subprocess, "Popen", fake_popen)
+        mocks.setattr(subprocess, "run", fake_run)
+        if mutate:
+            with pytest.raises(pytest.fail.Exception, match="test wrote user.* into a live checkout"):
+                next(fixture)
+            assert guard._read_bytes_or_none(cfg) == b""
+        else:
+            with pytest.raises(StopIteration):
+                next(fixture)
+
+
 def test_guard_watches_the_checkout_under_test():
     assert _live_git_config_paths()
 
-- 
