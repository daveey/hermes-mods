From 989596b5ca6c3bec3a38e7beb6c56b870438d842 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 11:29:45 +0000
Subject: [PATCH] test(e2e): seed public fake-model metadata before catalog
 routing checks [daveey]

---
 tests/e2e/core/providers/_catalog_helpers.py  |  8 ++++++
 .../test_catalog_metadata_isolation.py        | 28 +++++++++++++++++++
 2 files changed, 36 insertions(+)
 create mode 100644 tests/e2e/core/providers/test_catalog_metadata_isolation.py

diff --git a/tests/e2e/core/providers/_catalog_helpers.py b/tests/e2e/core/providers/_catalog_helpers.py
index 77cd59dc7f7..7fcf7f89888 100644
--- a/tests/e2e/core/providers/_catalog_helpers.py
+++ b/tests/e2e/core/providers/_catalog_helpers.py
@@ -217,6 +217,14 @@ def write_home(root: Path, model: dict[str, Any], extra_cfg: dict[str, Any] | No
            **(extra_cfg or {})}
     (home / ".hermes" / "config.yaml").write_text(yaml.safe_dump(cfg, sort_keys=False), encoding="utf-8")
     select_test_dependencies(home / ".hermes", REPO_ROOT)
+    # The fake model has public metadata too. Seed it so a cold cache cannot make an
+    # unrelated OpenRouter catalog refresh look like foreign inference routing.
+    cache = home / ".hermes" / "cache"
+    cache.mkdir(exist_ok=True)
+    (cache / "openrouter_model_metadata.json").write_text(json.dumps({
+        "catalog-model-a": {"context_length": 128000, "max_completion_tokens": 4096,
+                            "name": "catalog-model-a", "pricing": {}},
+    }), encoding="utf-8")
     return home
 
 
diff --git a/tests/e2e/core/providers/test_catalog_metadata_isolation.py b/tests/e2e/core/providers/test_catalog_metadata_isolation.py
new file mode 100644
index 00000000000..38cd4da1f5d
--- /dev/null
+++ b/tests/e2e/core/providers/test_catalog_metadata_isolation.py
@@ -0,0 +1,28 @@
+"""Public metadata is local; the foreign-provider routing sentinel stays strict."""
+from dataclasses import replace
+
+from tests.e2e.core.providers._catalog_helpers import Row, TurnResult, evaluate, write_home
+
+
+def test_catalog_home_has_offline_public_metadata(tmp_path, monkeypatch):
+    home = write_home(tmp_path, {"provider": "zai"})
+    monkeypatch.setenv("HERMES_HOME", str(home / ".hermes"))
+    from agent import model_metadata as metadata
+
+    monkeypatch.setattr(metadata, "_model_metadata_cache", {})
+    monkeypatch.setattr(metadata, "_model_metadata_cache_time", 0)
+
+    def no_network(*args, **kwargs):
+        raise AssertionError("public catalog must be available without network")
+
+    monkeypatch.setattr(metadata.model_metadata_http, "get", no_network)
+    model = metadata.fetch_model_metadata()["catalog-model-a"]
+    assert model["context_length"] == 128000
+    assert model["pricing"] == {}  # unknown prices must not become invented charges
+
+
+def test_catalog_sentinel_still_rejects_foreign_provider_egress():
+    own = Row("own", "chat_completions", "api_key", "OWN_API_KEY", "https://own.example/v1", (), True)
+    other = replace(own, name="other", base_url="https://other.example/v1")
+    result = TurnResult(own, 0, "", "", [], ["other.example:443"], "own-key", {"own-key"}, None, "", 0)
+    assert not evaluate(result, [own, other])["no_egress_to_foreign_provider_hosts"]
-- 
