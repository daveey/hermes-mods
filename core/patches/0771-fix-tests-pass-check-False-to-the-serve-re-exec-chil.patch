From f0845d0b7977c1d3864f979074d8e99cdc2681dd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 08:28:04 -0700
Subject: [PATCH] fix(tests): pass check=False to the serve re-exec child run
 (ruff PLW1510 red on main) [daveey]

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/hermes_cli/test_serve_update_wait_reexec.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_serve_update_wait_reexec.py b/tests/hermes_cli/test_serve_update_wait_reexec.py
index 809f159928..f250cbfe44 100644
--- a/tests/hermes_cli/test_serve_update_wait_reexec.py
+++ b/tests/hermes_cli/test_serve_update_wait_reexec.py
@@ -121,7 +121,7 @@ def _run_serve(tmp_path, *, update_running: bool, new: str = NEW):
     env = {k: v for k, v in os.environ.items() if k != "HERMES_SERVE_REEXEC_COUNT"}
     env.update(HERMES_HOME=str(home), HERMES_SERVE_UPDATE_POLL_S="0.05")
     proc = subprocess.run([sys.executable, str(script), str(REPO), str(state), new],
-                          env=env, capture_output=True, text=True, timeout=120)
+                          env=env, capture_output=True, text=True, timeout=120, check=False)
     assert proc.returncode == 0, proc.stderr[-4000:]
     result = json.loads((state / "result.json").read_text())
     incarnations = (state / "incarnations").read_text().split()
