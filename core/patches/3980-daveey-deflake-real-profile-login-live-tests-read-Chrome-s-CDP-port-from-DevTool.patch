From bda85277a0ea599d9f1bda5cabe5a082cca76e42 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:21:42 +0000
Subject: [PATCH] [daveey] deflake real-profile login live tests: read Chrome's
 CDP port from DevToolsActivePort, 120 s start deadline

test_name_login_text_field_resolves failed in CI run 43512196109 (slice 5, 16 files in parallel)
with "timed out after 20s waiting for chrome CDP endpoint" (call 20.53 s), then passed alone on
retry in 2.13 s. _launch_chrome gave headless Chrome a fixed 20 s to answer /json/version; a cold
Chrome start on a CPU-throttled runner can miss that.

_launch_chrome now:
- starts Chrome with --remote-debugging-port=0 and reads the port and browser path from
  <user-data-dir>/DevToolsActivePort, which Chrome writes once the endpoint listens. The port
  pre-picked by _free_port was closed before Chrome bound it, so another process on a busy runner
  could take it and Chrome would never answer there.
- waits up to 120 s. The wait returns as soon as the file is there (about 1 s on a quiet host),
  and a Chrome that exits early still fails at once.

RED on main: a chromium wrapper that sleeps 22 s before exec'ing Chrome fails the test with the
CI message ("timed out after 20s waiting for chrome CDP endpoint", setup 20.00 s). GREEN with this
change: the same 22 s start passes (1 passed in 45.99 s), the whole file passes (8 passed), and it
passes under a 2% SIGSTOP/SIGCONT duty cycle on the pytest process group.
---
 .../test_browser_real_profile_logins_live.py  | 27 ++++++++++++-------
 1 file changed, 17 insertions(+), 10 deletions(-)

diff --git a/tests/tools/test_browser_real_profile_logins_live.py b/tests/tools/test_browser_real_profile_logins_live.py
index 67d380a02d..1116fbf445 100644
--- a/tests/tools/test_browser_real_profile_logins_live.py
+++ b/tests/tools/test_browser_real_profile_logins_live.py
@@ -16,14 +16,12 @@ from __future__ import annotations
 
 import hashlib
 import http.server
-import json
 import os
 import shutil
 import socket
 import sqlite3
 import subprocess
 import threading
-import urllib.request
 from pathlib import Path
 
 import pytest
@@ -65,11 +63,19 @@ def _free_port() -> int:
 
 
 def _launch_chrome(profile_root: Path) -> tuple[subprocess.Popen, str]:
-    """Launch headless Chrome on ``profile_root`` with a CDP port; return (proc, browser ws URL)."""
-    port = _free_port()
+    """Launch headless Chrome on ``profile_root`` with a CDP port; return (proc, browser ws URL).
+
+    Chrome picks its own CDP port (``--remote-debugging-port=0``) and writes it to
+    ``<user-data-dir>/DevToolsActivePort`` once the endpoint is listening. A port pre-picked by
+    ``_free_port`` is closed again before Chrome binds it, so on a busy runner another process can
+    take it and Chrome never answers there. The deadline is generous because a cold Chrome start on
+    a CPU-throttled runner can take well over 20 s; a healthy start still returns in about a second.
+    """
+    active_port = profile_root / "DevToolsActivePort"
+    active_port.unlink(missing_ok=True)
     proc = subprocess.Popen(
         [_CHROME, f"--user-data-dir={profile_root}", "--password-store=basic", "--headless=new",
-         "--no-first-run", "--no-default-browser-check", f"--remote-debugging-port={port}",
+         "--no-first-run", "--no-default-browser-check", "--remote-debugging-port=0",
          "--disable-gpu", "about:blank"],
         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
 
@@ -79,13 +85,14 @@ def _launch_chrome(profile_root: Path) -> tuple[subprocess.Popen, str]:
         if proc.poll() is not None:
             raise RuntimeError("chrome exited before opening its CDP port")
         try:
-            info = json.load(urllib.request.urlopen(f"http://127.0.0.1:{port}/json/version"))
-            return info["webSocketDebuggerUrl"]
-        except Exception:
-            return None
+            lines = active_port.read_text().splitlines()
+            port, path = int(lines[0]), lines[1]
+        except (OSError, ValueError, IndexError):
+            return ""  # not written yet, or caught mid-write
+        return f"ws://127.0.0.1:{port}{path}"
 
     try:
-        ws_url = wait_until(_devtools_ws, timeout=20, interval=0.1,
+        ws_url = wait_until(_devtools_ws, timeout=120, interval=0.1,
                             what="chrome CDP endpoint")
     except Exception:
         # The caller registers proc for cleanup only once we return, so a startup that never opens
