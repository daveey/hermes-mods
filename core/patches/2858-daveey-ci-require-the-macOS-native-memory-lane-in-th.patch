+  group: ${{ github.workflow == 'Native memory (macOS)' && github.event_name == 'push' && format('native-memory-push-{0}', github.ref) || format('native-memory-{0}-{1}-{2}', github.run_id, github.run_attempt, inputs.commit || github.sha) }}
   cancel-in-progress: false
 
 jobs:
   native-memory:
     name: Native memory ABI and no-fork tests
+    # Defense in depth for other callers: fork PR code never reaches the mini.
