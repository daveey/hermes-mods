From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 07:04:52 +0000
Subject: [PATCH] refactor(desktop): share stored-session tile close so
 use-session-actions/index.ts shrinks under its health cap

---
 .../use-session-actions/close-stored-tile.ts  | 27 ++++++++++++++++++
 .../hooks/use-session-actions/index.ts        | 28 ++++++-------------
 2 files changed, 35 insertions(+), 20 deletions(-)
 create mode 100644 apps/desktop/src/app/session/hooks/use-session-actions/close-stored-tile.ts

diff --git a/apps/desktop/src/app/session/hooks/use-session-actions/close-stored-tile.ts b/apps/desktop/src/app/session/hooks/use-session-actions/close-stored-tile.ts
new file mode 100644
index 0000000000..3d1004b517
--- /dev/null
+++ b/apps/desktop/src/app/session/hooks/use-session-actions/close-stored-tile.ts
@@ -0,0 +1,27 @@
+import type { MutableRefObject } from 'react'
+
+import { closeSessionTile, dropSessionState } from '@/store/session-states'
+
+import type { ClientSessionState } from '../../../types'
+
+/**
+ * [daveey] A tiled copy of a deleted or archived session must not outlive it: collapse the
+ * pane and evict its mirrored runtime state so nothing submits to (or renders) that session.
+ * Returns the tile's runtime id, if it had one.
+ */
+export function closeStoredSessionTile(
+  storedSessionId: string,
+  runtimeIdByStoredSessionIdRef: MutableRefObject<Map<string, string>>,
+  sessionStateByRuntimeIdRef: MutableRefObject<Map<string, ClientSessionState>>
+): string | undefined {
+  const tiledRuntimeId = runtimeIdByStoredSessionIdRef.current.get(storedSessionId)
+  closeSessionTile(storedSessionId)
+
+  if (tiledRuntimeId) {
+    runtimeIdByStoredSessionIdRef.current.delete(storedSessionId)
+    sessionStateByRuntimeIdRef.current.delete(tiledRuntimeId)
+    dropSessionState(tiledRuntimeId)
+  }
+
+  return tiledRuntimeId
+}
diff --git a/apps/desktop/src/app/session/hooks/use-session-actions/index.ts b/apps/desktop/src/app/session/hooks/use-session-actions/index.ts
index 795f628094..5d0b3fce58 100644
--- a/apps/desktop/src/app/session/hooks/use-session-actions/index.ts
+++ b/apps/desktop/src/app/session/hooks/use-session-actions/index.ts
@@ -173,6 +173,7 @@ import { archiveOwnerRow } from './archive-owner'
 import { archivePreflight, softHideArchivedRow } from './archive-soft-hide'
 import { branchThroughRowId } from './branch-boundary'
 import { branchCreateKey } from './branch-create-key'
+import { closeStoredSessionTile } from './close-stored-tile'
 import type { SessionCreateOverrides } from './create-overrides'
 import { markSessionCreatedThisRun, sessionCreatedThisRun } from './created-this-run'
 import { graftEarlySegmentDeltas, mergeSegmentSnapshotIntoLiveRow } from './current-segment'
@@ -3360,17 +3361,12 @@ export function useSessionActions({
           clearSessionControl(closingRuntimeId)
         }
 
-        // A tiled copy of this session must not outlive it: collapse the pane
-        // and evict its mirrored runtime state so nothing submits to (or renders)
-        // a deleted session.
-        const tiledRuntimeId = runtimeIdByStoredSessionIdRef.current.get(storedSessionId)
-        closeSessionTile(storedSessionId)
-
-        if (tiledRuntimeId) {
-          runtimeIdByStoredSessionIdRef.current.delete(storedSessionId)
-          sessionStateByRuntimeIdRef.current.delete(tiledRuntimeId)
-          dropSessionState(tiledRuntimeId)
-        }
+        // A tiled copy of this session must not outlive it.
+        const tiledRuntimeId = closeStoredSessionTile(
+          storedSessionId,
+          runtimeIdByStoredSessionIdRef,
+          sessionStateByRuntimeIdRef
+        )
 
         // Live per-session stores (the same four the stop paths clear) key on
         // the gateway event's session_id, i.e. the runtime id. When the deleted
@@ -3500,15 +3496,7 @@ export function useSessionActions({
           // only rot. Dropped after the RPC so a failed archive keeps it.
           forgetSessionUnread(archivedIds, profile)
           // An archived session is hidden from the sidebar; its tile must go too.
-          const tiledRuntimeId = runtimeIdByStoredSessionIdRef.current.get(storedSessionId)
-          closeSessionTile(storedSessionId)
-
-          if (tiledRuntimeId) {
-            runtimeIdByStoredSessionIdRef.current.delete(storedSessionId)
-            sessionStateByRuntimeIdRef.current.delete(tiledRuntimeId)
-            dropSessionState(tiledRuntimeId)
-          }
-
+          closeStoredSessionTile(storedSessionId, runtimeIdByStoredSessionIdRef, sessionStateByRuntimeIdRef)
           notify({ durationMs: 2_000, kind: 'success', message: copy.archived })
         }
       })
