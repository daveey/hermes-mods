From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 10:43:07 +0000
Subject: [PATCH] test(facts): await scoped native tree demand and fence
 providers [daveey]

---
 tests/gateway/test_native_http_auth.py     | 14 ++++++++++++--
 tests/hermes_cli/test_fact_tree_startup.py | 22 ++++++++++++++++++++++
 tests/plugins/test_board_startup.py        | 17 +++++++++++++++++
 3 files changed, 51 insertions(+), 2 deletions(-)

diff --git a/tests/gateway/test_native_http_auth.py b/tests/gateway/test_native_http_auth.py
index c51a876bad..c36fc1f9c4 100644
--- a/tests/gateway/test_native_http_auth.py
+++ b/tests/gateway/test_native_http_auth.py
@@ -140,8 +140,18 @@ def test_native_http_grants_are_single_use_and_bound_to_daemon(tmp_path):
 
         assert wait_until(sidebar_ready, timeout=10)
         # The cross-profile project tree and PR scan answer one grant for its own profile only.
-        assert client.get('/api/profiles/projects/tree?profile=default',
-                          headers=headers(ticket(home, descriptor))).status_code == 200
+        def tree_ready():
+            # A scoped selector is demanded off-request; never replay a redeemed grant.
+            response = client.get('/api/profiles/projects/tree?profile=default',
+                                  headers=headers(ticket(home, descriptor)))
+            assert response.status_code in (200, 503), response.text
+            if response.status_code == 503:
+                detail = response.json()['detail']
+                assert detail['code'] == 'facts_unavailable', response.text
+                assert response.headers['Retry-After'] == '1'
+            return response.status_code == 200
+
+        assert wait_until(tree_ready, timeout=10)
         assert client.post('/api/profiles/sessions/pull-requests?profile=default', json={'ids': ['x']},
                            headers=headers(ticket(home, descriptor))).status_code == 200
         for scope in ('', '?profile=all', '?profile=other', '?profile=default&profile=other'):
diff --git a/tests/hermes_cli/test_fact_tree_startup.py b/tests/hermes_cli/test_fact_tree_startup.py
index 2e6f282a2f..490d5d7d70 100644
--- a/tests/hermes_cli/test_fact_tree_startup.py
+++ b/tests/hermes_cli/test_fact_tree_startup.py
@@ -81,6 +81,28 @@ def test_tree_foreign_profile_never_falls_back(profiles_on_disk):
     runtime.close()
 
 
+def test_tree_provider_binds_authenticated_home_and_rejects_escape(profiles_on_disk, monkeypatch):
+    from hermes_cli import config
+    from hermes_cli.fact_tree_startup import TreeRuntime, TreeBinding
+    from hermes_cli.fact_contract import Unavailable
+    runtime = TreeRuntime(targets=tuple(profiles_on_disk.items()))
+    try:
+        assert isinstance(runtime.provider(None), TreeBinding)
+        assert runtime.provider(None).profile is None
+        monkeypatch.setattr(config, 'get_hermes_home', lambda: profiles_on_disk['worker'])
+        assert runtime.provider(None).profile == 'worker'
+        assert runtime.provider('worker').profile == 'worker'
+        assert isinstance(runtime.provider('default'), Unavailable)
+        monkeypatch.setattr(config, 'get_hermes_home', lambda: profiles_on_disk['worker'] / 'foreign')
+        assert isinstance(runtime.provider('worker'), Unavailable)
+        monkeypatch.setattr(config, 'get_hermes_home', lambda: profiles_on_disk['default'])
+        assert isinstance(runtime.provider('unknown'), Unavailable)
+        runtime.closed = True
+        assert isinstance(runtime.provider(None), Unavailable)
+    finally:
+        runtime.close()
+
+
 @pytest.mark.parametrize('flag,platform', [('off', 'linux'), ('1', 'darwin'), ('1', 'win32')])
 def test_rollback_and_unsupported_native_backend_skip_tree(monkeypatch, flag, platform):
     from types import SimpleNamespace
diff --git a/tests/plugins/test_board_startup.py b/tests/plugins/test_board_startup.py
index 91f6262625..5486fa9fff 100644
--- a/tests/plugins/test_board_startup.py
+++ b/tests/plugins/test_board_startup.py
@@ -64,6 +64,23 @@ def test_current_selection_reads_published_catalog_only(shadow_board, monkeypatc
     assert isinstance(runtime.provider(None), Unavailable)
 
 
+def test_board_provider_rejects_foreign_home_and_closed_owner(shadow_board, monkeypatch):
+    from hermes_cli import config
+    from hermes_cli.fact_board_startup import BoardRuntime
+    from hermes_cli.fact_contract import Unavailable
+    from pathlib import Path
+    runtime = BoardRuntime(shadow_board['mod'], boards=('default',))
+    selected = object()
+    runtime.views = {'default': selected}
+    assert runtime.provider('default') is selected
+    monkeypatch.setattr(config, 'get_hermes_home', lambda: Path(runtime.home) / 'foreign')
+    assert isinstance(runtime.provider('default'), Unavailable)
+    monkeypatch.setattr(config, 'get_hermes_home', lambda: Path(runtime.home))
+    assert isinstance(runtime.provider('unknown'), Unavailable)
+    runtime._closed = True
+    assert isinstance(runtime.provider('default'), Unavailable)
+
+
 def test_actual_mount_entry_selects_native_runtime(shadow_board, monkeypatch):
