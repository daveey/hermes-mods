From 2ef88df0612692e0dc1838b39e5bf0e6aad1cf46 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:28:37 +0000
Subject: [PATCH] fix(cron): keep declare assignment words inert without
 attributes [daveey]

Exclude syntactic assignment words from opaque command/option hints. Promote the double-quoted escaped-backtick let regression that the conservative recursive hint now catches; real Bash execution and clean twin pass. Focused GREEN: 111 tests.
---
 cron/lifecycle_guard_arith_words.py                |  8 ++++++--
 .../cron/test_lifecycle_guard_arith_int_context.py |  1 +
 .../cron/test_lifecycle_guard_arith_word_quotes.py | 14 +-------------
 3 files changed, 8 insertions(+), 15 deletions(-)

diff --git a/cron/lifecycle_guard_arith_words.py b/cron/lifecycle_guard_arith_words.py
index aa9bbe6d3f2d60f2914a5eaa1eaf1508f0609278..fcc2fdfe55f79c4e16160e417c429aa199cd0eb9 100644
--- a/cron/lifecycle_guard_arith_words.py
+++ b/cron/lifecycle_guard_arith_words.py
@@ -36,6 +36,7 @@ _INT_OPERATORS = frozenset({"-eq", "-ne", "-lt", "-le", "-gt", "-ge"})
 _INTEGER_DECLARERS = frozenset({"declare", "typeset", "local", "readonly", "export"})
 _BACKTICK_SPAN_RE = re.compile(r"`([^`]*)`")
 _SUBSTITUTION_OPENERS = ("$(", "`")
+_ASSIGNMENT_WORD_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*(?:\[.*\])?\+?=", re.DOTALL)
 # A declare-family name followed, anywhere later in the dequoted segment, by an option word
 # carrying ``i``. Matched on the joined words so ``eval "declare -i x"`` and
 # ``builtin declare -xi x`` count; over-matching only makes the walk read more files.
@@ -164,10 +165,13 @@ def may_set_integer_attributes(command: str) -> bool:
         # Do not evaluate expansions or source files to discover attributes. Either
         # can introduce an integer declaration; allow the later subscript walk now,
         # before referenced files are traversed. Unknown commands may be declare.
-        if name in {"source", "."} or any(char in name for char in "$`"):
+        if name in {"source", "."} or (
+            any(char in name for char in "$`") and not _ASSIGNMENT_WORD_RE.match(words[index])
+        ):
             return True
         if name in _INTEGER_DECLARERS and any(
-            "$" in word or "`" in word for word in words[index + 1:]
+            ("$" in word or "`" in word) and not _ASSIGNMENT_WORD_RE.match(word)
+            for word in words[index + 1:]
         ):
             return True
     return False
diff --git a/tests/cron/test_lifecycle_guard_arith_int_context.py b/tests/cron/test_lifecycle_guard_arith_int_context.py
index 8fba38b6c3cf034afb17f9c4fdf53e1090e66de3..b669788b9bf8949df3a53387c41f507f7a18b27b 100644
--- a/tests/cron/test_lifecycle_guard_arith_int_context.py
+++ b/tests/cron/test_lifecycle_guard_arith_int_context.py
@@ -9,6 +9,7 @@ from cron.lifecycle_guard import scan_gateway_lifecycle
 
 
 SHAPES = [
+    r'let "a[\`SCRIPT\`]=1"',
     r"declare -i x; eval 'x=a[\$\(SCRIPT\)]'",
     r"declare -i x; eval 'x=a[\`SCRIPT\`]'",
     r"typeset -i x; eval 'x+=a[\$\(SCRIPT\)]'",
diff --git a/tests/cron/test_lifecycle_guard_arith_word_quotes.py b/tests/cron/test_lifecycle_guard_arith_word_quotes.py
index b85318a0cbc1b5f53c3735c0cc820edf66e867c8..d2a743cbf5dd30ac4b0791a1cc4729eaa45ca019 100644
--- a/tests/cron/test_lifecycle_guard_arith_word_quotes.py
+++ b/tests/cron/test_lifecycle_guard_arith_word_quotes.py
@@ -85,20 +85,8 @@ def test_quoted_word_arithmetic_subscripts_are_sinks(tmp_path, shape):
     assert output_reaches_shell(command)
 
 
-# The guard does not yet follow a script behind an escaped backtick inside a
-# double-quoted `let` operand (t_01a1db0c38d72914); the scanner above already flags
-# that sink.
-_GUARD_GAPS = {
-    r'let "a[\`SCRIPT\`]=1"': "t_01a1db0c38d72914",
-}
-
-
 @pytest.mark.platforms("posix")
-@pytest.mark.parametrize("shape", [
-    pytest.param(shape, marks=pytest.mark.xfail(strict=True, reason=_GUARD_GAPS[shape]))
-    if shape in _GUARD_GAPS else shape
-    for shape in SINKS
-])
+@pytest.mark.parametrize("shape", SINKS)
 def test_lifecycle_guard_scans_the_quoted_subscript_payload(tmp_path, shape):
     script = tmp_path / "payload.sh"
     script.write_text("# padding\n" * 150000, encoding="utf-8")  # past the scan cap
