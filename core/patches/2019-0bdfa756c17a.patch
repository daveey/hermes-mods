From 0bdfa756c17ab33909914215cd68619900e970b4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 6 Nov 2026 11:48:31 +0000
Subject: [PATCH] fix(checkpoint): fail closed when oversize/excluded paths
 stay staged [daveey]

Restore the fail-closed guards main had in tools/checkpoint_manager_staging.py
(b45f3ad7cff) that the 178fbdc reconcile merge dropped with that module.

- _stage_all: `if not _unstage(...oversize): return False, "", "could not drop
  oversize paths"` before `add -A`.
- _seed_from_repo_index: abandon the seed when excluded entries cannot be
  dropped (main: "could not drop excluded paths").
- diff / _safe_restore_plan: refuse (success False, index reset to the ref)
  when _stage_all fails, instead of reporting from a partial index.

Problem: with a 1 MB cap, a tracked file grown to 2 MB of random bytes and only
the first `update-index --force-remove` failing, ensure_checkpoint returned
True and the store held 2,098,765 bytes of objects (diff: 2,098,528;
safe_restore plan: 2,098,529): the oversize blob was hashed into the store.
Why 1: add -A re-read grows.bin; excludes do not apply to a path already in
  the index - tools/checkpoint_snapshot.py _stage_all.
Why 2: _stage_all called self._unstage(...scan.oversize) and discarded the
  False - 178fbdc:tools/checkpoint_snapshot.py:302.
Why 3: the reconcile kept the candidate's SnapshotMixin and dropped main's
  CheckpointStagingMixin as a "duplicate" (178fbdc message); the guard existed
  only in the dropped copy (d84d70b4:tools/checkpoint_manager_staging.py:185,
  :268), so it was not ported. Same loss in _seed_from_repo_index.
Root (happened): the merge resolution diffed the two mixins by structure, not
  by fail-closed behaviour, and no test pinned the pre-add guard alone.
Root (not caught): test_failed_oversize_removal_aborts_snapshot fails EVERY
  force-remove, so the post-add _drop_oversize_from_index also failed and the
  snapshot still refused; it never checks store bytes, so the blob that add -A
  had already written went unseen. diff/safe_restore discarded _stage_all's
  result, so no entry point surfaced the failure.
Recurrence: first time for this guard; guard introduced on main in b45f3ad7cff.
Countermeasures:
- symptom+root: the guards above.
- detection: test_first_oversize_removal_failure_refuses_without_reading_blob
  [checkpoint|diff|safe_restore] (first failure only; asserts refusal and store
  objects < 1 MB) and test_failed_excluded_drop_abandons_the_seed - all 4 RED
  on 178fbdc, GREEN here; existing assertions unchanged.
---
 tests/tools/test_checkpoint_merge_staging.py | 85 ++++++++++++++++++++
 tools/checkpoint_manager.py                  | 14 +++-
 tools/checkpoint_snapshot.py                 |  9 ++-
 3 files changed, 103 insertions(+), 5 deletions(-)

diff --git a/tests/tools/test_checkpoint_merge_staging.py b/tests/tools/test_checkpoint_merge_staging.py
index 3b1d8c8a50c..daa2110827e 100644
--- a/tests/tools/test_checkpoint_merge_staging.py
+++ b/tests/tools/test_checkpoint_merge_staging.py
@@ -82,3 +82,88 @@ def test_failed_oversize_removal_aborts_snapshot(project, monkeypatch):
     mgr.new_turn()
     assert not mgr.ensure_checkpoint(str(project), "must fail")
     assert mgr.list_checkpoints(str(project))[0]["hash"] == before
+
+
+@pytest.mark.parametrize("entry", ["checkpoint", "diff", "safe_restore"])
+def test_first_oversize_removal_failure_refuses_without_reading_blob(project, monkeypatch, entry):
+    """Only the FIRST ``update-index --force-remove`` fails (the pre-add oversize unstage).
+
+    An always-failing removal also trips the post-add oversize drop, so the snapshot
+    still refused even when ``_stage_all`` ignored its own unstage result; meanwhile
+    ``add -A`` had already hashed the grown file into the store as a dangling blob.
+    Failing once and succeeding afterwards isolates the pre-add guard.
+    """
+    mgr = cm.CheckpointManager(enabled=True, max_file_size_mb=1)
+    (project / "grows.bin").write_bytes(b"small")
+    assert mgr.ensure_checkpoint(str(project), "baseline")
+    before = mgr.list_checkpoints(str(project))[0]["hash"]
+    (project / "grows.bin").write_bytes(os.urandom(2 * 1024 * 1024))
+    (project / "source.py").write_text("after\n")
+    mgr.record_agent_write(str(project / "source.py"))
+    real_run = cm._run_git
+    removals = []
+
+    def fail_first_remove(args, *a, **kw):
+        if args[:2] == ["update-index", "--force-remove"]:
+            removals.append(list(args))
+            if len(removals) == 1:
+                return False, "", "injected first removal failure"
+        return real_run(args, *a, **kw)
+
+    monkeypatch.setattr(cm, "_run_git", fail_first_remove)
+    if entry == "checkpoint":
+        mgr.new_turn()
+        assert not mgr.ensure_checkpoint(str(project), "must fail")
+        assert mgr.list_checkpoints(str(project))[0]["hash"] == before
+    elif entry == "diff":
+        assert not mgr.diff(str(project), before)["success"]
+    else:
+        assert not mgr._safe_restore_plan(str(project), before)["success"]
+    assert removals and "grows.bin" in removals[0]
+    store = cm._store_path()
+    # The grown, incompressible file must never enter the store, not even dangling.
+    assert sum(p.stat().st_size for p in (store / "objects").rglob("*") if p.is_file()) < 1024 * 1024
+
+
+def test_failed_excluded_drop_abandons_the_seed(tmp_path, monkeypatch):
+    """A seeded index whose excluded entries could not be dropped is abandoned (no index
+    left), so the cold path stages instead of trusting an index still holding them."""
+    import subprocess
+
+    monkeypatch.setattr(cm, "CHECKPOINT_BASE", tmp_path / "checkpoints")
+    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
+    env.update(GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_SYSTEM=os.devnull, GIT_CONFIG_NOSYSTEM="1")
+
+    def git(cwd, *args):
+        subprocess.run(["git", "-c", "user.email=t@t", "-c", "user.name=t", *args],
+                       cwd=str(cwd), env=env, check=True, capture_output=True)
+
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    git(repo, "init", "-q", "-b", "main")
+    (repo / "main.py").write_text("print('hi')\n")
+    (repo / ".gitignore").write_text("secret.txt\n")
+    (repo / "secret.txt").write_text("force-added\n")
+    git(repo, "add", "-A")
+    git(repo, "add", "-f", "secret.txt")
+    git(repo, "commit", "-q", "-m", "init")
+    wt = tmp_path / "wt"
+    git(repo, "worktree", "add", "-q", str(wt), "HEAD")
+    abs_wt = str(cm._normalize_path(str(wt)))
+    store = cm._store_path()
+    cm._init_store(store, abs_wt)
+    index_file = cm._index_path(store, cm._project_hash(abs_wt))
+    real_run = cm._run_git
+    removals = []
+
+    def fail_first_remove(args, *a, **kw):
+        if args[:2] == ["update-index", "--force-remove"]:
+            removals.append(list(args))
+            if len(removals) == 1:
+                return False, "", "injected first removal failure"
+        return real_run(args, *a, **kw)
+
+    monkeypatch.setattr(cm, "_run_git", fail_first_remove)
+    assert cm.CheckpointManager(enabled=True)._seed_from_repo_index(store, abs_wt, index_file) is False
+    assert removals and "secret.txt" in removals[0]
+    assert not index_file.exists()
diff --git a/tools/checkpoint_manager.py b/tools/checkpoint_manager.py
index d344e0cd780..e89117d0bb9 100644
--- a/tools/checkpoint_manager.py
+++ b/tools/checkpoint_manager.py
@@ -1160,7 +1160,12 @@ class CheckpointManager(SnapshotMixin):
         # Oversize files are excluded from staging (git never reads them) and
         # no checkpoint holds them, so they count as changed by definition.
         scan = _staging_scan(abs_dir, self.max_file_size_mb * 1024 * 1024, store, index_file)
-        self._stage_all(store, abs_dir, index_file, scan)
+        staged, _, stage_err = self._stage_all(store, abs_dir, index_file, scan)
+        if not staged:
+            # A partial index would under-report changes; refuse rather than plan from it.
+            _run_git(["read-tree", _ref_name(dir_hash)], store, abs_dir,
+                     index_file=index_file, allowed_returncodes={128})
+            return {"success": False, "error": f"Could not stage the working tree: {stage_err}"}
         ok, names_out, err = _run_git(
             ["diff", "--name-only", "-z", commit_hash, "--cached",
              *_exclude_store_args(store.parent, abs_dir)],
@@ -1346,7 +1351,12 @@ class CheckpointManager(SnapshotMixin):
         index_file = _index_path(store, dir_hash)
 
         # Stage current state into the per-project index to compare.
-        self._stage_all(store, abs_dir, index_file)
+        staged, _, stage_err = self._stage_all(store, abs_dir, index_file)
+        if not staged:
+            # A partial index would show a wrong diff; refuse and keep the index on the ref.
+            _run_git(["read-tree", _ref_name(dir_hash)], store, abs_dir,
+                     index_file=index_file, allowed_returncodes={128})
+            return {"success": False, "error": f"Could not stage the working tree: {stage_err}"}
 
         # A checkpoint taken before the store was excluded may still contain it; never
         # report the store as a change against such a checkpoint.
diff --git a/tools/checkpoint_snapshot.py b/tools/checkpoint_snapshot.py
index 3a53b443a02..2c2ee71b341 100644
--- a/tools/checkpoint_snapshot.py
+++ b/tools/checkpoint_snapshot.py
@@ -299,7 +299,10 @@ class SnapshotMixin:
             # git refuses command-line pathspecs beside --pathspec-from-file, so the store
             # self-exclusion rides in the same file. git add fails on an exclude pathspec
             # naming an ignored path, so only paths the ignore rules miss go in it.
-            self._unstage(store, working_dir, index_file, scan.oversize)
+            # Fail closed: an oversize path left in the index is re-read by ``add -A``
+            # (excludes do not apply to tracked paths), hashing it into the store.
+            if not self._unstage(store, working_dir, index_file, scan.oversize):
+                return False, "", "could not drop oversize paths"
             store_specs = cm._store_pathspecs(store.parent, working_dir)
             unignored = self._not_ignored(store, working_dir, config, scan.oversize + store_specs)
             if unignored is None:
@@ -379,8 +382,8 @@ class SnapshotMixin:
         if not ok:
             return abandon(err or "ls-files failed")
         excluded = [p for p in out.split("\x00") if p]
-        if excluded:
-            self._unstage(store, working_dir, index_file, excluded)
+        if excluded and not self._unstage(store, working_dir, index_file, excluded):
+            return abandon("could not drop excluded paths")
 
         ok, out, err = cm._run_git(
             ["ls-files", "-z", "-v", "--stage"],
-- 
