From e574134ce70f0d126c67e3beddb5b9ee56e7b9b6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 23:27:09 +0000
Subject: [PATCH] [daveey] cron: type shutdown-interrupted last_failure as
 kind=lifecycle_interrupt

A run its owner gateway's shutdown or restart stopped (settle_restart_cut,
mark_running_jobs_interrupted: mark_job_run shutdown_interrupted=True) now
stamps last_failure.kind='lifecycle_interrupt', so consumers such as the
coach's cron_lifecycle_interrupt signal stop matching on the prose detail.
An ordinary failure's last_failure carries no kind (cron-70b179cf31).
---
 cron/jobs.py                          | 8 ++++++--
 tests/cron/test_restart_cut.py        | 3 +++
 tests/cron/test_shutdown_interrupt.py | 2 ++
 3 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/cron/jobs.py b/cron/jobs.py
index b8c16d62c3..7b4ddca92e 100644
--- a/cron/jobs.py
+++ b/cron/jobs.py
@@ -2442,6 +2442,8 @@ def release_unadmitted_fire(
 
 # Failure kinds that never reached the agent: a later gate tick may clear a streak made only of them.
 _PRE_AGENT_ERROR_KINDS = ("fire", "gate")
+# ``last_failure.kind`` of a run its owner gateway's shutdown/restart stopped (shutdown_interrupted).
+LIFECYCLE_INTERRUPT_KIND = "lifecycle_interrupt"
 
 
 def _record_run_outcome(
@@ -2481,8 +2483,10 @@ def _record_run_outcome(
         job["failure_streak"] = 0
         job.pop("last_error_kind", None)
     elif shutdown_interrupted:
-        # Preserve diagnostic evidence without blaming the job for its owner's shutdown.
-        job["last_failure"] = {"at": now, "detail": error or (status or "run failed")}
+        # Preserve diagnostic evidence without blaming the job for its owner's shutdown. The typed
+        # ``kind`` lets consumers tell this apart without matching the prose detail.
+        job["last_failure"] = {"at": now, "detail": error or (status or "run failed"),
+                               "kind": LIFECYCLE_INTERRUPT_KIND}
     elif not cancelled:
         prior = job.get("last_error_kind") if int(job.get("failure_streak") or 0) else None
         if not (fire_error or gate_error) or prior not in (None, *_PRE_AGENT_ERROR_KINDS):
diff --git a/tests/cron/test_restart_cut.py b/tests/cron/test_restart_cut.py
index 48ef9a0da7..c9c8102abe 100644
--- a/tests/cron/test_restart_cut.py
+++ b/tests/cron/test_restart_cut.py
@@ -77,6 +77,8 @@ def test_direct_run_cut_by_owner_restart_reruns_once_without_a_failure(home, mon
     assert row["status"] == "failed" and "gateway restart" in row["error"]
     assert row["delivery_outcome"] == "suppressed"
     assert delivered == [] and scheduler.drain_delivery_queue({}, None) == 0, "no failure notice"
+    # Typed, so consumers (the coach) need not match the prose detail.
+    assert jobs.get_job(job["id"])["last_failure"]["kind"] == "lifecycle_interrupt"
     _assert_rerun_once(job["id"], execution_id, natural_next=natural_next)
 
 
@@ -112,6 +114,7 @@ def test_an_ordinary_failure_still_counts(home, monkeypatch):
     assert scheduler.run_one_job(claimed) is True
     saved = jobs.get_job(job["id"])
     assert saved["failure_streak"] == 1 and saved.get("restart_rerun") is None
+    assert "kind" not in saved["last_failure"], "an ordinary failure is not a lifecycle interrupt"
     assert not _due(job["id"])
 
 
diff --git a/tests/cron/test_shutdown_interrupt.py b/tests/cron/test_shutdown_interrupt.py
index 5f78b7cdea..b8801ad5ee 100644
--- a/tests/cron/test_shutdown_interrupt.py
+++ b/tests/cron/test_shutdown_interrupt.py
@@ -81,12 +81,14 @@ class TestMarkRunningJobsInterrupted:
             saved = jobs.load_jobs()[0]
             assert saved["last_status"] == "error"
             assert saved["last_failure"]["detail"] == reason
+            assert saved["last_failure"]["kind"] == "lifecycle_interrupt"
             assert saved["failure_streak"] == streak
             assert saved.get("last_error_kind") == kind
             assert jobs.mark_job_run(job["id"], False, "real agent failure")
             saved = jobs.load_jobs()[0]
             assert saved["failure_streak"] == streak + 1
             assert saved["last_error_kind"] == "agent"
+            assert "kind" not in saved["last_failure"], "a real failure replaces the typed interrupt"
 
     def test_no_op_when_nothing_running(self):
         import cron.scheduler as sched
