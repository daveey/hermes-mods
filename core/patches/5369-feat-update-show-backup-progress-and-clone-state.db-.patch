+
+
+def _discard_sidecars(staged: Path, suffixes=("-wal", "-shm", "-journal")) -> None:
+    for suffix in suffixes:
+        Path(f"{staged}{suffix}").unlink(missing_ok=True)
+
+
+def _quick_check(staged: Path, reporter: Optional[_ProgressReporter]) -> None:
