+    assert result["method"] == "copy" and "locked" in result["clone_error"]
+    assert _snapshot_rows(result["path"])[-1] == ("committed",)
+    assert {e.get("method") for e in events if e["event"] == "backup_progress"} == {"copy"}
+    assert _lock_is_free(db)
