From fa2df10b6b30b0f9cd41aca0548ba3bb287307c4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 07:36:22 +0000
Subject: [PATCH] fix(kanban): require nonfailed registry evidence for dead-pin
 moves [daveey]

Review 5915521688 found last-good registry membership surviving a failed refresh could grant the capped move exception. The move validation now uses registry(require_fresh=True), refusing both the failed refresh and its retry-TTL cache. Regression exercises real move_queued after a successful fetch, expiry and OSError, plus successful refresh control. RED: 19 passed/1 failed; GREEN focused 20 passed; all 32 consumer files passed. Board automatic recovery is separately owned; its recover route already includes inactive machines (prior commit diagnosis was inaccurate for that route).
---
 hermes_cli/kanban_move.py            |  2 +-
 tests/hermes_cli/test_kanban_move.py | 31 ++++++++++++++++++++++++++++
 2 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_move.py b/hermes_cli/kanban_move.py
index 08d23b43ddd580338ca1cb592002eb448c4022f5..62b7ae25538e3b06c0f5f7c1a412ac66eb7fceee 100644
--- a/hermes_cli/kanban_move.py
+++ b/hermes_cli/kanban_move.py
@@ -172,7 +172,7 @@ def check(conn: sqlite3.Connection, task_id: str, runs_on: Any, *, force: bool =
     labels = carry(labels, dict(row), me=me)
     from hermes_cli import kanban_label_backlog as klb
     if machines is None:
-        reg = wn.registry()
+        reg = wn.registry(require_fresh=True)
         if reg is None:
             raise MoveRefused("registry_unavailable", "the Board machine registry is unreachable; try again")
         machines = reg.get("machines") or {}
diff --git a/tests/hermes_cli/test_kanban_move.py b/tests/hermes_cli/test_kanban_move.py
index fd7508ecf5398f9c7e70759cb92fffaf915f10b9..e304e6c557935c20675be3d30cee524ccdc4eb26 100644
--- a/tests/hermes_cli/test_kanban_move.py
+++ b/tests/hermes_cli/test_kanban_move.py
@@ -189,6 +189,37 @@ def test_a_capped_move_off_a_retired_pinned_machine_is_allowed_and_audited(gws,
     assert res["reason_code"] == "move_limit", res
 
 
+@pytest.mark.parametrize("outage", [False, True], ids=["fresh", "failed-refresh"])
+def test_dead_pin_budget_requires_nonfailed_registry_read(gws, monkeypatch, outage):
+    hub, _ = gws
+    tid = _capped_card_pinned_to(hub, "worker-6")
+    calls = []
+
+    def fetch():
+        calls.append(True)
+        if outage and len(calls) > 1:
+            raise OSError("registry offline")
+        return {"me": HUB, "machines": list(LIVE.values())}
+
+    wn.set_registry_fetch(fetch)
+    assert wn.registry()["machines"] == LIVE
+    monkeypatch.setitem(wn._REGISTRY, "at", -1e9)
+    before = _events(hub.conn, tid)
+    res = km.move_queued(hub.conn, tid, runs_on=["linux"], reason="retired pin", me=HUB)
+    assert len(calls) == 2
+    if outage:
+        assert res["reason_code"] == "registry_unavailable", res
+        assert _events(hub.conn, tid) == before
+        assert json.loads(hub.conn.execute("SELECT runs_on FROM tasks WHERE id = ?", (tid,)).fetchone()[0]) == ["machine:worker-6"]
+        # A retry inside the failed-fetch TTL must refuse too, not use last-good membership.
+        again = km.move_queued(hub.conn, tid, runs_on=["linux"], reason="retry", me=HUB)
+        assert again["reason_code"] == "registry_unavailable"
+        assert len(calls) == 2
+    else:
+        assert res["ok"] and res["move_no"] == 4, res
+        assert _events(hub.conn, tid)[-1]["dead_pin"] == "worker-6"
+
+
 @pytest.mark.parametrize("entry", [
     {"state": "active", "hold": True},  # held: drains and comes back
     {"state": "active", "hold": False, "last_seen": 1},  # stale telemetry: maybe asleep, not retired
