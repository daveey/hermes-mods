From c9c1dc5135eeebe5afb801729f47f60de13d9aea Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 07:44:11 +0000
Subject: [PATCH] [daveey] ci(macos): isolate login-session tests from hidden
 room runners

---
 .github/workflows/macos-os-tests.yml          | 49 +++++++++++++++++--
 tests/ci/test_macos_os_tests_workflow.py      | 27 +++++++++-
 tests/conftest.py                             |  5 ++
 .../test_gateway_launchd_runtime.py           |  1 +
 .../test_gateway_snapshot_restore_live.py     |  1 +
 tests/hermes_cli/test_update_posix_pause.py   |  1 +
 6 files changed, 80 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/macos-os-tests.yml b/.github/workflows/macos-os-tests.yml
index 2023d8ed53f0e5e400683e107d7615cf02bee709..eba47faf65818c1b7fd3af5b0423316a2f885b0e 100644
--- a/.github/workflows/macos-os-tests.yml
+++ b/.github/workflows/macos-os-tests.yml
@@ -8,8 +8,11 @@ name: macOS OS-marked tests (scheduled)
 # (scheduled, non-required; not a PR lane).
 #
 # Runners: the self-hosted macOS runners (labels self-hosted, macOS,
-# hermes-state: the room minis and the Mac mini), the same ones that serve the
-# REQUIRED hermes_state (macOS) and Native memory PR lanes. So this lane:
+# hermes-state: the room minis), the same ones that serve the
+# REQUIRED hermes_state (macOS) and Native memory PR lanes. Tests requiring
+# a GUI launchd domain run separately on hermes-mac-session (the console-user
+# Mac mini); hidden room-mini users stay isolated from meeting-room sessions.
+# Neither selection silently skips login-session requirements. So this lane:
 #   * never runs on a pull request and is not part of "All required checks
 #     pass (v2)";
 #   * runs twice a day, 00:37 and 12:37 UTC (00-01 UTC had the fewest PR runs
@@ -105,7 +108,47 @@ jobs:
           test -s "$LIST"
           echo "selected $(wc -l < "$LIST" | tr -d ' ') file(s)"
           taskpolicy -c utility scripts/run_tests.sh --files-from "$LIST" -j 2 -- \
-            -m "platforms and not integration" --tb=short
+            -m "platforms and not integration and not macos_login_session" --tb=short
+        env:
+          OPENROUTER_API_KEY: ''
+          OPENAI_API_KEY: ''
+          NOUS_API_KEY: ''
+
+  macos-login-session-tests:
+    name: macOS login-session tests (mini)
+    needs: gate
+    if: needs.gate.outputs.run == 'true' && github.repository == 'example-org/hermes'
+    runs-on: [self-hosted, macOS, hermes-mac-session]
+    timeout-minutes: 30
+    steps:
+      # Hidden ci users have no login session. Fail on misrouting, never skip.
+      - name: Require the runner user's GUI launchd domain
+        shell: bash
+        run: |
+          set -euo pipefail
+          launchctl print "gui/$(id -u)" > /dev/null
+      - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          fetch-depth: 1
+      - name: Set up isolated locked test tools and dependencies
+        uses: ./.github/actions/setup-pm
+        with:
+          toolchain: all
+          test-environment: 'true'
+          extras: '["all", "messaging"]'
+      - name: Run login-session tests
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 -c "import sys; assert sys.platform == 'darwin'"
+          HERMES_HOME="$(mktemp -d "${RUNNER_TEMP:-/tmp}/macos-session-home.XXXXXX")"
+          export HERMES_HOME
+          LIST="$(mktemp "${RUNNER_TEMP:-/tmp}/macos-session-files.XXXXXX")"
+          trap 'rm -rf "$HERMES_HOME" "$LIST"' EXIT
+          /usr/bin/python3 scripts/ci/list_os_marked_tests.py macos > "$LIST"
+          test -s "$LIST"
+          taskpolicy -c utility scripts/run_tests.sh --files-from "$LIST" -j 2 -- \
+            -m "macos_login_session" --tb=short
         env:
           OPENROUTER_API_KEY: ''
           OPENAI_API_KEY: ''
diff --git a/tests/ci/test_macos_os_tests_workflow.py b/tests/ci/test_macos_os_tests_workflow.py
index d06059ebadbb52ab9aaeed08d29b66dad6a76b70..3d9a0550f03bd03e7e74fdbfc571bd12012122d5 100644
--- a/tests/ci/test_macos_os_tests_workflow.py
+++ b/tests/ci/test_macos_os_tests_workflow.py
@@ -59,7 +59,32 @@ def test_test_job_waits_for_the_gate_and_runs_the_marked_selection_on_the_mini()
     assert "scripts/ci/list_os_marked_tests.py macos" in command
     assert 'test -s "$LIST"' in command
     assert "taskpolicy -c utility scripts/run_tests.sh --files-from \"$LIST\" -j 2" in command
-    assert '-m "platforms and not integration"' in command
+    assert '-m "platforms and not integration and not macos_login_session"' in command
+
+
+@pytest.mark.parametrize("domain_status", [0, 125])
+def test_login_session_job_is_gated_and_requires_a_real_gui_domain(domain_status):
+    job = _workflow()["jobs"]["macos-login-session-tests"]
+    assert job["runs-on"] == ["self-hosted", "macOS", "hermes-mac-session"]
+    assert job["needs"] == "gate"
+    assert "needs.gate.outputs.run == 'true'" in job["if"]
+    assert f"github.repository == '{REPO}'" in job["if"]
+    guard = job["steps"][0]["run"]
+    assert 'launchctl print "gui/$(id -u)"' in guard
+    assert "set -euo pipefail" in guard
+    assert "|| true" not in guard
+    # Execute the workflow's shell contract with a controlled launchctl boundary.
+    probe = subprocess.run(
+        ["bash", "-c", f'launchctl() {{ printf "%s\\n" "$*" >&2; return {domain_status}; }}\n{guard}'],
+        capture_output=True, text=True, encoding="utf-8", check=False,
+    )
+    assert probe.returncode == domain_status
+    assert "print gui/" in probe.stderr
+    command = job["steps"][-1]["run"]
+    assert '-m "macos_login_session"' in command
+    assert 'test -s "$LIST"' in command
+    assert "taskpolicy -c utility scripts/run_tests.sh" in command
+    assert any(step.get("uses") == "./.github/actions/setup-pm" for step in job["steps"])
 
 
 def test_native_lane_provisions_real_tools_and_messaging_before_tests():
diff --git a/tests/conftest.py b/tests/conftest.py
index b085fbbafd678502c7782e9af656c5f96c50174e..6ebd5e116ef3c6648974f0f51cfa667af26a350d 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -1501,6 +1501,11 @@ def pytest_configure(config):
     """Register markers used by hermetic conftest."""
     _take_host_test_slot(config)
     _relocate_basetemp_outside_operator_home(config)
+    config.addinivalue_line(
+        "markers",
+        "macos_login_session: on macOS requires the runner user's GUI launchd domain; "
+        "routed to the dedicated login-session lane, without changing Linux selection.",
+    )
     config.addinivalue_line(
         "markers",
         f"{_LIVE_SYSTEM_GUARD_BYPASS_MARK}: bypass the live-system guard "
diff --git a/tests/hermes_cli/test_gateway_launchd_runtime.py b/tests/hermes_cli/test_gateway_launchd_runtime.py
index 92a6994241890080c33df22fddac2af1f6693a3e..92045e460b94defee248f6729c096ac8776eef48 100644
--- a/tests/hermes_cli/test_gateway_launchd_runtime.py
+++ b/tests/hermes_cli/test_gateway_launchd_runtime.py
@@ -28,6 +28,7 @@ def _command_of(pid: int) -> str:
 
 
