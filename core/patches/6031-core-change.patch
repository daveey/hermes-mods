--- /dev/null
+++ b/tests/hermes_cli/test_subagent_page_scope.py
@@ -0,0 +1,53 @@
+"""Page-scoped subagent discovery must not scan unrelated profile inventories."""
+import sqlite3
+
+from hermes_cli import subagent_session_activity as activity
+from hermes_state import SessionDB
+
+
+def test_discovery_reads_only_the_page_profiles_and_parents(tmp_path, monkeypatch):
+    home = tmp_path / 'home'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    db = SessionDB(home / 'state.db')
+    now = 1700000000
+    try:
+        def seed(conn):
+            conn.executemany("INSERT INTO sessions(id,source,started_at) VALUES (?,'cli',?)",
+                             [('parent', now)] + [(f'foreign{i}', now) for i in range(3000)])
+            conn.executemany('INSERT INTO sessions(id,source,started_at,parent_session_id) VALUES (?, ?, ?, ?)',
+                             [('wanted', 'subagent', now, 'parent')] +
+                             [(f'other{i}', 'subagent', now, f'foreign{i}') for i in range(3000)])
+        db._execute_write(seed)
+        # It is discoverable, but the page does not request it. Opening its store
+        # would make an unrelated outage/workload part of this request.
+        unrelated = home / 'profiles' / 'other'
+        unrelated.mkdir(parents=True)
+        (unrelated / 'state.db').touch()
+        real = sqlite3.connect
+        counts = {'steps': 0, 'queries': 0, 'opens': 0}
+
+        def connect(path, **kwargs):
+            assert '/profiles/other/' not in str(path)
+            counts['opens'] += 1
+            conn = real(path, **kwargs)
+            conn.set_progress_handler(lambda: counts.__setitem__('steps', counts['steps'] + 100) or 0, 100)
+            conn.set_trace_callback(lambda sql: counts.__setitem__('queries', counts['queries'] + 1))
+            return conn
+
+        monkeypatch.setattr(activity.sqlite3, 'connect', connect)
+        monkeypatch.setattr(activity.time, 'time', lambda: now + 10)
+        monkeypatch.setattr(activity, 'local_scope', lambda: ('edge', 'default'))
+        activity._reset_cache_for_tests()
+        rows = activity.annotate_subagent_activity([{'id': 'tip', '_lineage_ids': ['parent']}])
+        observed = rows[0]['execution_observations']
+        assert [o['identity']['generation'] for o in observed] == ['session=wanted']
+        assert counts['opens'] == 1
+        assert counts['queries'] <= 2
+        assert counts['steps'] < 2000, counts
+        # A new parent set must not hit the prior page's cached subset.
+        rows = activity.annotate_subagent_activity([{'id': 'foreign0'}])
+        assert rows[0]['execution_observations'][0]['identity']['generation'] == 'session=other0'
+    finally:
+        activity._reset_cache_for_tests()
+        db.close()
diff --git a/tests/hermes_state/test_rank_projection_transport.py b/tests/hermes_state/test_rank_projection_transport.py
new file mode 100644
index 00000000000..c96cc472224
--- /dev/null
+++ b/tests/hermes_state/test_rank_projection_transport.py
@@ -0,0 +1,82 @@
+"""Bound SQLite/Python page handoffs without changing SQLite value semantics."""
+import math
+import random
+import sqlite3
+import struct
+import threading
+
+import pytest
+
+import hermes_state_rank_memo as memo
+
+
+class RecordingConnection:
+    def __init__(self, conn):
+        self.conn = conn
+        self.returned = 0
+        self.statements = 0
+
+    def execute(self, sql, params=()):
+        self.statements += 1
+        cursor = self.conn.execute(sql, params)
+        owner = self
+
+        class Cursor:
+            description = cursor.description
+
+            def fetchall(self):
+                rows = cursor.fetchall()
+                owner.returned += len(rows)
+                return rows
+
+            def fetchone(self):
+                row = cursor.fetchone()
+                owner.returned += row is not None
+                return row
+
+        return Cursor()
+
+
+@pytest.mark.parametrize('count', [1, 200, 2000])
+def test_project_has_constant_python_row_handoffs(count):
+    conn = sqlite3.connect(':memory:')
+    conn.row_factory = sqlite3.Row
+    conn.execute('CREATE TABLE sessions(id TEXT PRIMARY KEY, started REAL)')
+    conn.executemany('INSERT INTO sessions VALUES (?, ?)', [(str(i), 1700000000.125) for i in range(count)])
+    measured = RecordingConnection(conn)
+    try:
+        steps = [0]
+        conn.set_progress_handler(lambda: steps.__setitem__(0, steps[0] + 100) or 0, 100)
+        rows = memo.project(measured, memo.RankMemo(threading.Lock()),
+                            [(str(i), None, None, i) for i in range(count)],
+                            'SELECT s.id, s.started, ', '', 'unused', 's.started', 0)
+        assert [r['id'] for r in rows] == [str(i) for i in range(count)]
+        assert measured.statements <= 2
+        assert steps[0] <= 150 * count + 1000, steps
+        assert measured.returned <= 1, 'page must cross SQLite/Python as one packed row'
+    finally:
+        conn.close()
+
+
+def test_packed_page_preserves_values_and_column_names():
+    from hermes_state_page_pack import read_page
+    conn = sqlite3.connect(':memory:')
+    conn.row_factory = sqlite3.Row
+    conn.execute('CREATE TABLE cells(value)')
+    values = [None, 0, 2**63 - 1, -(2**63), 'a\x00b\n"é', b'\x00\xff', 1.0000000000000002,
+              1700000000.1234567, -0.0000000000000001, 5e-324, float('inf'), -float('inf')]
+    randoms = random.Random(42)
+    for _ in range(1000):
+        value = struct.unpack('!d', randoms.getrandbits(64).to_bytes(8, 'big'))[0]
+        if math.isfinite(value):
+            values.append(value)
+    conn.executemany('INSERT INTO cells VALUES (?)', [(v,) for v in values])
+    try:
+        rows = read_page(conn, 'SELECT value AS "a""b" FROM cells ORDER BY rowid', ())
+        actual = [r['a"b'] for r in rows]
+        assert actual == values
+        assert [type(v) for v in actual] == [type(v) for v in values]
+        assert math.isinf(actual[11])
+        assert read_page(conn, 'SELECT value FROM cells WHERE 0', ()) == []
+    finally:
+        conn.close()
