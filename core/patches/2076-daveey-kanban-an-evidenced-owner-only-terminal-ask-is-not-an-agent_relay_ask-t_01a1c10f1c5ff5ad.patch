From ad07edebae88a283e9a50a09b61be9dc93f28ff3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 9 Nov 2026 16:21:24 +0000
Subject: [PATCH] [daveey] kanban: an evidenced owner-only terminal ask is not
 an agent_relay_ask (t_01a1c10f1c5ff5ad)

run_in_user_terminal refuses Kanban callers (ask from your own chat); cross_session refuses the send; kanban_block then rejected that ask as agent_relay_ask. interaction=user_terminal asks whose evidence quotes both refusals now pass the lint and standing-ask sweep. True relays still refuse. Proof: new test file red 4 failed before, 93 passed after.
---
 hermes_cli/kanban_block_policy.py         | 35 +++++++++--
 tests/tools/test_kanban_owner_only_ask.py | 72 +++++++++++++++++++++++
 2 files changed, 102 insertions(+), 5 deletions(-)
 create mode 100644 tests/tools/test_kanban_owner_only_ask.py

diff --git a/hermes_cli/kanban_block_policy.py b/hermes_cli/kanban_block_policy.py
index c8e408ba784..99f431bd68c 100644
--- a/hermes_cli/kanban_block_policy.py
+++ b/hermes_cli/kanban_block_policy.py
@@ -155,21 +155,46 @@ def agent_route_gap_error(human_request) -> Optional[str]:
             "on that card. Keep human_request for what only David can do: approve, pay, sign in, a physical step.")
 
 
-def agent_relay_ask_error(action: str) -> Optional[str]:
+# An owner-only terminal step is evidenced when BOTH agent routes to it were refused for a Kanban caller:
+# run_in_user_terminal (owner chats only; its refusal says "ask from your own Hermes chat") and cross_session send
+# (no Kanban-to-human-chat injection). With both closed, that ask is the human's own step, not a relay. [daveey]
+_UT_REFUSED = re.compile(r"\brun_in_user_terminal\b[^\n]{0,160}?\brefus|\brefus[^\n]{0,160}?\brun_in_user_terminal\b",
+                         re.IGNORECASE)
+_XS_REFUSED = re.compile(r"\bcross_session\b[^\n]{0,160}?\brefus|\brefus[^\n]{0,160}?\bcross_session\b",
+                         re.IGNORECASE)
+
+
+def owner_only_action_evidenced(human_request) -> bool:
+    """True for an ``interaction=user_terminal`` ask whose evidence quotes both the run_in_user_terminal and the
+    cross_session refusal.
+
+    Hub t_01a1c0d75a11b3cd: run_in_user_terminal refused the Kanban caller ("ask from your own Hermes chat"),
+    cross_session refused the send, and kanban_block then rejected that same ask as agent_relay_ask. No agent
+    route is left, so the ask stands. An ask without both refusals still hits the relay lint.
+    """
+    if not isinstance(human_request, dict) or str(human_request.get("interaction") or "") != "user_terminal":
+        return False
+    evidence = str(human_request.get("evidence") or "")
+    return bool(_UT_REFUSED.search(evidence) and _XS_REFUSED.search(evidence))
+
+
+def agent_relay_ask_error(action: str, human_request=None) -> Optional[str]:
     """Typed refusal for an ask that only relays a message from David to an agent (self-heal agent-c03353a3cf).
 
     Hub t_01a188c8ddf998ac asked David to "ask for the broker Gemini secret repair from your own Hermes chat on
     the AWS-authorized Mac"; that chat did it itself in 10 minutes. Such a block is a routing gap shown to David
     as his task, so the worker must route it to an agent instead.
     """
-    if not _RELAY.search(action):
+    if not _RELAY.search(action) or owner_only_action_evidenced(human_request):
         return None
     return (f"{RELAY_ASK_CODE}: human_request.action asks David to pass a message to an agent or chat "
             "(\"from your own Hermes chat\", \"ask your agent to ...\"). Agents can do that without him: "
             "(1) declare the capability the other gateway holds with kanban_block(needs=['aws:<account>:<scope>' "
             "| 'ssh:<host>' | 'host:<gateway>']) so an owner card opens there; or (2) kanban_comment the exact "
             "request and send it to the owning chat with cross_session (action='send'), or kanban_create the "
-            "owner card on that gateway (placement='<gateway>') and park on it. If no gateway holds the "
+            "owner card on that gateway (placement='<gateway>') and park on it. For an owner-only terminal step "
+            "that run_in_user_terminal AND cross_session both refused for a Kanban caller, file "
+            "interaction='user_terminal' with evidence quoting both refusals: that ask is allowed. If no gateway holds the "
             "capability, the gap is the capability registry: fix the probe config (kanban.capabilities.probes) "
             "on the host that has the access. Keep human_request for what only David can do: approve, pay, "
             "sign in, a physical step.")
@@ -187,7 +212,7 @@ def user_ask_lint_error(human_request) -> Optional[str]:
     if not isinstance(human_request, dict):
         return None
     action = " ".join(str(human_request.get("action") or "").split())
-    relay = agent_relay_ask_error(action) or agent_route_gap_error(human_request)
+    relay = agent_relay_ask_error(action, human_request) or agent_route_gap_error(human_request)
     if relay:
         return relay
     missing = [label for label, rx in (("what unblocking the card does", _UNBLOCK),
@@ -298,7 +323,7 @@ def standing_ask_error(conn: sqlite3.Connection, task_id: str, title, request) -
     """
     if not isinstance(request, dict):
         return None
-    err = agent_relay_ask_error(_action_line(request)) or agent_route_gap_error(request)
+    err = agent_relay_ask_error(_action_line(request), request) or agent_route_gap_error(request)
     if err:
         return (RELAY_ASK_CODE if err.startswith(RELAY_ASK_CODE) else ROUTE_GAP_CODE), err, {}
     named = _named_task_ids(title, request, task_id)
diff --git a/tests/tools/test_kanban_owner_only_ask.py b/tests/tools/test_kanban_owner_only_ask.py
new file mode 100644
index 00000000000..533a855b189
--- /dev/null
+++ b/tests/tools/test_kanban_owner_only_ask.py
@@ -0,0 +1,72 @@
+"""An owner-only terminal step is a human ask, not an agent relay (hub t_01a1c0d75a11b3cd).
+
+run_in_user_terminal refuses a Kanban caller ("ask from your own Hermes chat"), cross_session refuses the
+send, and kanban_block then rejected that same ask as agent_relay_ask. When both refusals are quoted as
+evidence on an interaction=user_terminal ask there is no agent route left, so the ask must stand. A true
+agent relay (no evidence of both refusals, or another interaction) is still refused.
+"""
+import json
+
+import pytest
+
+from tests.tools import test_kanban_agent_relay_ask as helpers
+
+RELAY_81905 = helpers.RELAY_81905
+_status = helpers._status
+worker_env = helpers.worker_env
+
+OWNER_ACTION = ("From your own Hermes chat run `aws kms create-grant ...` in your terminal. "
+                "Unblock = the agent verifies the grant; archive = drop the grant.")
+BOTH_REFUSALS = ("run_in_user_terminal refused: Kanban caller, owner chats only. "
+                 "cross_session send refused: Kanban worker cannot send into a human chat.")
+OWNER_ONLY = {**RELAY_81905, "interaction": "user_terminal", "action": OWNER_ACTION, "evidence": BOTH_REFUSALS,
+              "why_human": "host_only boundary: only the owner's Desktop chat may open a terminal"}
+
+
+def test_owner_only_ask_with_both_refusals_passes_lint():
+    from hermes_cli.kanban_block_policy import owner_only_action_evidenced, user_ask_lint_error
+    assert owner_only_action_evidenced(OWNER_ONLY)
+    assert user_ask_lint_error(OWNER_ONLY) is None
+
+
+@pytest.mark.parametrize("override", [
+    {"evidence": "run_in_user_terminal refused for a Kanban caller"},         # cross_session not tried
+    {"evidence": "cross_session send refused for a Kanban caller"},           # terminal not tried
+    {"evidence": "capability routing returned no_capability_holder"},         # true agent relay
+    {"evidence": ""},
+    {"interaction": "external"},                                              # not a terminal step
+    {"interaction": "approval"},
+])
+def test_relay_ask_without_both_refusals_is_still_refused(override):
+    from hermes_cli.kanban_block_policy import user_ask_lint_error
+    err = user_ask_lint_error({**OWNER_ONLY, **override})
+    assert err and err.startswith("agent_relay_ask"), err
+
+
+def test_non_dict_is_not_owner_only():
+    from hermes_cli.kanban_block_policy import owner_only_action_evidenced
+    assert not owner_only_action_evidenced(None)
+    assert not owner_only_action_evidenced("run_in_user_terminal refused cross_session refused")
+
+
+def test_block_entry_accepts_evidenced_owner_only_ask(worker_env):
+    from tools import kanban_tools as kt
+    d = json.loads(kt._handle_block({"reason": "owner-only terminal step", "kind": "capability",
+                                     "human_request": OWNER_ONLY}))
+    assert d.get("ok") is True, d
+    assert _status(worker_env) == "blocked"
+
+
+def test_block_entry_still_refuses_true_relay(worker_env):
+    from tools import kanban_tools as kt
+    d = json.loads(kt._handle_block({"reason": "x", "kind": "capability",
+                                     "human_request": {**OWNER_ONLY, "evidence": "no_capability_holder"}}))
+    assert d.get("rejection") == "agent_relay_ask", d
+    assert _status(worker_env) == "running"
+
+
+def test_standing_ask_sweep_keeps_evidenced_owner_only_ask():
+    from hermes_cli.kanban_block_policy import standing_ask_error
+    assert standing_ask_error(None, "t_x", "title", OWNER_ONLY) is None
+    err = standing_ask_error(None, "t_x", "title", {**OWNER_ONLY, "evidence": "none"})
+    assert err and err[0] == "agent_relay_ask"
-- 
