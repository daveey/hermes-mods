 .../test_background_review_memory_scope.py    | 35 ++++++++++++++++++-
 tests/tools/test_skill_manager_tool.py        | 26 +++++++++++++-
 tools/skill_manager_guards.py                 | 26 +++++++++++---
 4 files changed, 91 insertions(+), 10 deletions(-)

