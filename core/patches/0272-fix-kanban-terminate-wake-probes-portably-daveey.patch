---
 hermes_cli/kanban_wake_check.py              |  7 ++---
 tests/hermes_cli/test_kanban_wake_cleanup.py | 31 ++++++++++++++++++++
 2 files changed, 34 insertions(+), 4 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_wake_cleanup.py

diff --git a/hermes_cli/kanban_wake_check.py b/hermes_cli/kanban_wake_check.py
index f847d37b3b..7c28c07c1b 100644
--- a/hermes_cli/kanban_wake_check.py
+++ b/hermes_cli/kanban_wake_check.py
@@ -27,7 +27,6 @@ from __future__ import annotations
 
 import logging
 import os
-import signal
 import sqlite3
 import subprocess
 import threading
@@ -232,9 +231,9 @@ def _shutdown_for_tests() -> None:
 
 
 def _kill(proc: subprocess.Popen) -> None:
-    try:
-        os.killpg(proc.pid, signal.SIGKILL)
-    except (ProcessLookupError, PermissionError, OSError):
+    from agent.deadline import kill_process_tree
+
+    if not kill_process_tree(proc.pid):
         try:
             proc.kill()
         except OSError:
diff --git a/tests/hermes_cli/test_kanban_wake_cleanup.py b/tests/hermes_cli/test_kanban_wake_cleanup.py
new file mode 100644
index 0000000000..21102c0c8c
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_wake_cleanup.py
@@ -0,0 +1,31 @@
+"""Wake probe cleanup delegates tree termination to the portable process helper."""
+from unittest.mock import Mock
+
+import pytest
+
+from agent import deadline
+from hermes_cli import kanban_wake_check as kwc
+
+
+@pytest.mark.parametrize("terminated", [True, False])
+def test_kill_probe_uses_portable_tree_cleanup(monkeypatch, terminated):
+    proc = Mock(pid=999999999)
+    kill_tree = Mock(return_value=terminated)
+    monkeypatch.setattr(deadline, "kill_process_tree", kill_tree)
+
+    kwc._kill(proc)
+
+    kill_tree.assert_called_once_with(proc.pid)
+    assert proc.kill.call_count == (0 if terminated else 1)
+
+
+def test_kill_probe_tolerates_parent_already_gone(monkeypatch):
+    proc = Mock(pid=999999999)
+    proc.kill.side_effect = ProcessLookupError
+    kill_tree = Mock(return_value=False)
+    monkeypatch.setattr(deadline, "kill_process_tree", kill_tree)
+
+    kwc._kill(proc)
+
+    kill_tree.assert_called_once_with(proc.pid)
+    proc.kill.assert_called_once_with()
