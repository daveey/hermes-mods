From 01a16e978ccff585e52e53d9131a339b7f3d60c1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 15:25:45 +0000
Subject: [PATCH] [daveey] fix(kanban): quota-release maps the released run to
 this replica's run id

A stored quota_episode payload keeps the recording gateway's run ids (worker-2's 2392) while
task_runs and the event row use this replica's (the hub's 173967). The release copied the payload id,
so episode() compared 173967 <= 2392, found the runs unreleased and the hub's 15:14Z release of 4
hub-write cards held them on the hub and every worker replica (t_01a1d052f773722d). released_run and
covers_latest now resolve the id through the stored episode event's own run_id.
---
 hermes_cli/kanban_quota_episode_release.py    | 28 ++++++--
 ...anban_quota_episode_release_foreign_ids.py | 68 +++++++++++++++++++
 2 files changed, 91 insertions(+), 5 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_quota_episode_release_foreign_ids.py

diff --git a/hermes_cli/kanban_quota_episode_release.py b/hermes_cli/kanban_quota_episode_release.py
index 74e0222803..f498452b00 100644
--- a/hermes_cli/kanban_quota_episode_release.py
+++ b/hermes_cli/kanban_quota_episode_release.py
@@ -34,17 +34,35 @@ def _latest(conn, task_id):
     return kb._json_dict(row[0]) if row else None
 
 
+def _local_run(conn, task_id, payload):
+    """This replica's id for the run the release *payload* closed, or None.
+
+    The payload copies the released episode's ``run_id``/``episode_id``, and a stored ``quota_episode``
+    payload keeps the recording gateway's run ids while its event row's ``run_id`` is this replica's
+    (``kanban_quota_episode._wall_origin``). Read raw, a worker's id (2392) never covers the home's run
+    (173967): the hub's 15:14Z release of 4 cards left them held on every replica (t_01a1d052f773722d)."""
+    run = (payload or {}).get("run_id")
+    if type(run) is not int:
+        return None
+    row = conn.execute(
+        "SELECT run_id FROM task_events WHERE task_id=? AND kind='quota_episode' AND json_valid(payload) "
+        "AND json_extract(payload, '$.run_id') IS ? AND json_extract(payload, '$.episode_id') IS ? "
+        "ORDER BY id DESC LIMIT 1", (task_id, run, payload.get("episode_id"))).fetchone()
+    local = row[0] if row is not None else None
+    # No stored episode names it: a computed episode, whose run ids are already this replica's.
+    return local if type(local) is int else run
+
+
 def released_run(conn, task_id):
-    """Run id the latest release closed (runs up to it form no episode), or None."""
-    run = (_latest(conn, task_id) or {}).get("run_id")
-    return run if type(run) is int else None
+    """This replica's run id the latest release closed (runs up to it form no episode), or None."""
+    return _local_run(conn, task_id, _latest(conn, task_id))
 
 
 def covers_latest(conn, task_id) -> dict | None:
     """The latest release's payload while no run has ended after it, else None (queue notes, clocks)."""
     payload = _latest(conn, task_id)
-    run = (payload or {}).get("run_id")
-    if type(run) is not int:
+    run = _local_run(conn, task_id, payload)
+    if run is None:
         return None
     later = conn.execute("SELECT 1 FROM task_runs WHERE task_id=? AND id>? LIMIT 1", (task_id, run)).fetchone()
     return None if later else payload
diff --git a/tests/hermes_cli/test_kanban_quota_episode_release_foreign_ids.py b/tests/hermes_cli/test_kanban_quota_episode_release_foreign_ids.py
new file mode 100644
index 0000000000..c46a1f2e85
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_quota_episode_release_foreign_ids.py
@@ -0,0 +1,68 @@
+"""``quota-release`` closes an episode whose stored payload carries another gateway's run ids. [daveey]
+
+t_01a1d052f773722d: a stored ``quota_episode`` payload keeps the run ids of the gateway that recorded it
+(worker-2's run 2392) while the event row and ``task_runs`` use this replica's (the hub's 173967). The
+release copied the payload's id, so ``episode()`` compared 173967 <= 2392, found the runs unreleased and
+kept the 4 released cards held on the hub and every worker replica.
+"""
+import argparse
+import json
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as dispatch
+from hermes_cli import kanban_quota_episode_release as release
+from hermes_cli import kanban_queue_position as queue
+from hermes_cli.kanban_quota_episode import episode
+from tests.hermes_cli.test_kanban_quota_episode import board as board, routing  # noqa: PLC0414 -- fixture re-export
+from tests.hermes_cli.test_kanban_quota_episode_live_release import NOW, DAYS, _entry, _reap, pool as pool  # noqa: PLC0414 -- fixture re-export
+
+FOREIGN_RUN = 2  # the recording worker's run id, lower than this replica's
+
+
+def _as_recorded_elsewhere(conn, tid):
+    """Rewrite the stored episode as a synced copy: the payload names the recording gateway's run ids."""
+    row = conn.execute("SELECT id, payload, run_id FROM task_events WHERE task_id=? AND kind='quota_episode' "
+                       "ORDER BY id DESC LIMIT 1", (tid,)).fetchone()
+    payload = json.loads(row['payload'])
+    payload.update(run_id=FOREIGN_RUN, episode_id=FOREIGN_RUN)
+    conn.execute("UPDATE task_events SET payload=? WHERE id=?", (json.dumps(payload), row['id']))
+    conn.commit()
+    assert row['run_id'] > FOREIGN_RUN  # this replica's id for the same run
+    return row['run_id']
+
+
+def test_release_of_an_episode_recorded_on_another_gateway_ends_the_hold(board, pool, capsys):
+    entries, _ = pool
+    entries.append(_entry(1, exhausted_until=NOW + 3 * DAYS))  # the live pool still says walled
+    with kbc.connect() as conn:
+        for i in range(4):  # earlier runs on this replica: its ids run ahead of the recording worker's
+            kb.claim_task(conn, kb.create_task(conn, title=f'other {i}', assignee='a'), claimer=kb._claimer_id())
+        tid = kb.create_task(conn, title='released on the home', assignee='a')
+        _reap(conn, tid)
+        local = _as_recorded_elsewhere(conn, tid)
+        assert episode(conn, tid)['run_id'] == FOREIGN_RUN
+        assert dispatch.check_respawn_guard(conn, tid) == 'subscription_quota_reset'
+    assert release.cmd(argparse.Namespace(task_id=tid, reason='stale outage hint')) == 0
+    assert 'Released' in capsys.readouterr().out
+    with kbc.connect() as conn:
+        assert release.released_run(conn, tid) == local
+        assert episode(conn, tid) is None
+        assert dispatch.check_respawn_guard(conn, tid) is None
+        assert 'quota hold released (stale outage hint, via operator)' in queue.describe(
+            queue.position(conn, kb.get_task(conn, tid)))
+
+
+def test_a_computed_episode_keeps_its_own_run_id(board, pool, capsys):
+    """No stored payload names the released run: its id is this replica's already."""
+    entries, _ = pool
+    entries.append(_entry(1, exhausted_until=NOW + 3 * DAYS))
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title='computed', assignee='a')
+        state = _reap(conn, tid)
+        conn.execute("DELETE FROM task_events WHERE task_id=? AND kind='quota_episode'", (tid,))
+        conn.commit()
+    assert release.cmd(argparse.Namespace(task_id=tid, reason='x')) == 0
+    with kbc.connect() as conn:
+        assert release.released_run(conn, tid) == state['run_id']
+        assert episode(conn, tid) is None
