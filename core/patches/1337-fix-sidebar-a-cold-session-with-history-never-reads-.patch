 apps/desktop/src/app/types.ts                 |  3 ++
 .../src/store/session-dot-state.test.ts       | 33 ++++++++++++++++++-
 apps/desktop/src/store/session-dot-state.ts   | 11 +++++--
 apps/desktop/src/store/session-states.test.ts |  2 +-
 apps/desktop/src/store/session-states.ts      |  5 ++-
 6 files changed, 48 insertions(+), 9 deletions(-)

