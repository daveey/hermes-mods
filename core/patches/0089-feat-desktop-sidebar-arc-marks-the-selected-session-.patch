From fbf02d6c8a4aaf486ba7a34e035eda2e2f21be28 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 15 Oct 2026 12:31:20 -0700
Subject: [PATCH] feat(desktop): sidebar arc marks the selected session, not
 working ones [daveey]

With several sessions busy, the travelling arc on every working row drowned
out the current task. The arc now paints only on the selected row; working
state stays on the status dot.
---
 .../src/app/chat/sidebar/session-row.test.tsx | 23 +++++++++++--------
 .../src/app/chat/sidebar/session-row.tsx      |  7 ++++--
 2 files changed, 19 insertions(+), 11 deletions(-)

diff --git a/apps/desktop/src/app/chat/sidebar/session-row.test.tsx b/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
index 2ad13e51ba..8719388420 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
@@ -162,12 +162,12 @@ function makeSession(overrides: Partial<SessionInfo> & { title: string }): Sessi
 
 const noop = vi.fn()
 
-const renderRow = (session: SessionInfo, extra?: { card?: boolean }) =>
+const renderRow = (session: SessionInfo, extra?: { card?: boolean; selected?: boolean }) =>
   render(
     <SidebarSessionRow
       card={extra?.card}
       isPinned={false}
-      isSelected={false}
+      isSelected={extra?.selected ?? false}
       onArchive={noop}
       onDelete={noop}
       onPin={noop}
@@ -178,28 +178,33 @@ const renderRow = (session: SessionInfo, extra?: { card?: boolean }) =>
     />
   )
 
-// The row no longer takes its running state as a prop, so this drives the real
-// store the way the app does. $workingSessionIds is the actual computed here
-// (the mock above only overrides its siblings), which is what makes this cover
-// the wiring rather than the predicate — the arc has gone missing before.
-describe('SidebarSessionRow running arc', () => {
+// The arc marks the SELECTED row — the one the pane shows — not a working
+// one. Working state stays on the status dot; the sidebar's busiest rows used
+// to wear the arc and the current task got lost among them.
+describe('SidebarSessionRow selection arc', () => {
   afterEach(() => {
     clearAllSessionStates()
   })
 
   const arc = (container: HTMLElement) => container.querySelector('.arc-row')
 
-  it('paints no arc for a settled session', () => {
+  it('paints no arc on an unselected settled session', () => {
     const { container } = renderRow(makeSession({ title: 'Settled' }))
 
     expect(arc(container)).toBeNull()
   })
 
-  it('paints the arc while the session is running', () => {
+  it('paints no arc on an unselected running session', () => {
     publishSessionState('rt1', { ...createClientSessionState('s1'), busy: true })
 
     const { container } = renderRow(makeSession({ title: 'Running' }))
 
+    expect(arc(container)).toBeNull()
+  })
+
+  it('paints the arc on the selected session, idle or not', () => {
+    const { container } = renderRow(makeSession({ title: 'Current' }), { selected: true })
+
     expect(arc(container)).toBeTruthy()
   })
 })
diff --git a/apps/desktop/src/app/chat/sidebar/session-row.tsx b/apps/desktop/src/app/chat/sidebar/session-row.tsx
index 06c31a4d04..7767d2c34c 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row.tsx
@@ -34,7 +34,7 @@ import { $projects } from '@/store/projects'
 import { $pullRequestsByBranch, sessionPrKey } from '@/store/pull-requests'
 import { sessionPinId } from '@/store/session'
 import { $blockedSessionIds, isSessionBlocked } from '@/store/session-blocked'
-import { $sessionDotStateById, hasLiveTurn, sessionStatusStripe, showsRunningArc } from '@/store/session-dot-state'
+import { $sessionDotStateById, hasLiveTurn, sessionStatusStripe } from '@/store/session-dot-state'
 import { $sessionListDensity } from '@/store/session-list-density'
 import { $openStoredSessionIds } from '@/store/session-states'
 import { sessionCostUsd } from '@/store/sidebar-archive'
@@ -498,7 +498,10 @@ function SidebarSessionRowImpl({
         style={style}
         {...rest}
       >
-        {showsRunningArc(dotState) && <span aria-hidden="true" className="arc-border arc-row" />}
+        {/* The travelling arc marks the SELECTED row (what the pane shows),
+            not a working one: with several sessions busy the arcs drowned out
+            the current task. Working state stays on the status dot [daveey]. */}
+        {isSelected && <span aria-hidden="true" className="arc-border arc-row" />}
         {statusStripe && (
           <span
             aria-hidden="true"
-- 
