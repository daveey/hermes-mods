From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 18:09:22 +0000
Subject: [PATCH] [daveey] Desktop poll cost: drain timeout reads the read-only
 raw config; board_paths reads kanban.sync once

/api/status resolved the restart drain timeout through read_raw_config(), which deep-copies the whole user config
(~2.6 ms per poll on laptop-1); board_paths() re-read kanban.sync once per board on every session-list poll.
Tests RED first.
---
 hermes_cli/gateway.py                         |  5 +-
 hermes_cli/kanban_db_sync.py                  |  6 +-
 hermes_cli/kanban_sync_client.py              |  3 +-
 tests/hermes_cli/test_kanban_sync_client.py   | 18 ++++++
 .../test_restart_drain_timeout_readonly.py    | 62 +++++++++++++++++++
 5 files changed, 89 insertions(+), 5 deletions(-)
 create mode 100644 tests/hermes_cli/test_restart_drain_timeout_readonly.py

diff --git a/hermes_cli/gateway.py b/hermes_cli/gateway.py
index 23b0548baad..dcbb6114522 100644
--- a/hermes_cli/gateway.py
+++ b/hermes_cli/gateway.py
@@ -53,6 +53,7 @@ from hermes_cli.config import (
     is_managed,
     managed_error,
     read_raw_config,
+    read_raw_config_readonly,
     save_env_value,
     write_platform_config_field,
 )
@@ -3544,7 +3545,9 @@ def _get_restart_drain_timeout() -> float:
     """Return the configured gateway restart drain timeout in seconds."""
     raw = os.getenv("HERMES_RESTART_DRAIN_TIMEOUT", "").strip()
     if not raw:
-        cfg = read_raw_config()
+        # [daveey] Read-only view: every Desktop /api/status poll lands here, and read_raw_config() deep-copies the
+        # whole config for this one key.
+        cfg = read_raw_config_readonly()
         agent_cfg = cfg.get("agent", {}) if isinstance(cfg, dict) else {}
         raw = str(agent_cfg.get("restart_drain_timeout", DEFAULT_GATEWAY_RESTART_DRAIN_TIMEOUT))
     return parse_restart_drain_timeout(raw)
diff --git a/hermes_cli/kanban_db_sync.py b/hermes_cli/kanban_db_sync.py
index 9187ebea9f0..99133669900 100644
--- a/hermes_cli/kanban_db_sync.py
+++ b/hermes_cli/kanban_db_sync.py
@@ -298,13 +298,13 @@ def board_slug_for_path(db_path: str) -> str:
     return "default"
 
 
-def board_selected(db_path: str) -> bool:
+def board_selected(db_path: str, config: Optional[Mapping[str, Any]] = None) -> bool:
     """``kanban.sync.boards`` lists the boards that sync (absent = every board). A shadow copy and a link-only board
-    always do."""
+    always do. ``config``: an already-read ``sync_config()`` (a caller checking many boards reads it once)."""
     from pathlib import Path
     if Path(db_path).parent.name in (SHADOW_DIR, LINKS_DIR):
         return True
-    boards = sync_config().get("boards")
+    boards = (sync_config() if config is None else config).get("boards")
     if not isinstance(boards, (list, tuple)):
         return True
     return board_slug_for_path(db_path) in {str(b) for b in boards}
