From 1482c3589ee60ec8babc3d0b3448cbd2e38675f9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 03:52:12 +0000
Subject: [PATCH] fix(kanban): pin replica stamp precedence and eligibility
 [daveey]

---
 hermes_cli/kanban_replica_upstream.py         |  5 ++++-
 .../test_kanban_blocked_upstream_remote.py    | 19 +++++++++++++++++++
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_replica_upstream.py b/hermes_cli/kanban_replica_upstream.py
index 9d5247bbf5..606a336ea0 100644
--- a/hermes_cli/kanban_replica_upstream.py
+++ b/hermes_cli/kanban_replica_upstream.py
@@ -21,7 +21,10 @@ def enrich(conn: sqlite3.Connection, rows: list[dict]) -> list[dict]:
     for row in rows:
         stamp = _decoded_request(row.get("blocked_upstream"))
         row.pop("blocked_upstream", None)
-        ancestor = stamp or cards[row["id"]].get("blocked_upstream")
+        # Match owner publication eligibility even for optional stored stamps.
+        ancestor = None
+        if row["status"] not in {"done", "archived", "blocked", "triage"}:
+            ancestor = stamp or cards[row["id"]].get("blocked_upstream")
         if ancestor:
             row["blocked_upstream"] = ancestor
     return rows
diff --git a/tests/hermes_cli/test_kanban_blocked_upstream_remote.py b/tests/hermes_cli/test_kanban_blocked_upstream_remote.py
index 1c06ef4890..df917c2632 100644
--- a/tests/hermes_cli/test_kanban_blocked_upstream_remote.py
+++ b/tests/hermes_cli/test_kanban_blocked_upstream_remote.py
@@ -52,6 +52,25 @@ def test_owner_publication_stamps_current_ancestor(tmp_path, monkeypatch, status
         conn.close()
 
 
+@pytest.mark.parametrize("status", ["todo", "done", "archived", "blocked", "triage"])
+def test_replica_stamp_precedence_and_ineligible_cards(status):
+    from hermes_cli.kanban_replica_upstream import enrich
+
+    with sqlite3.connect(":memory:") as conn:
+        conn.executescript("CREATE TABLE tasks(id TEXT, status TEXT);"
+                           "CREATE TABLE task_links(parent_id TEXT, child_id TEXT);"
+                           "INSERT INTO tasks VALUES ('graph-parent', 'triage');"
+                           "INSERT INTO task_links VALUES ('graph-parent', 'child');")
+        conn.execute("INSERT INTO tasks VALUES ('child', ?)", (status,))
+        stamp = {"id": "owner-parent", "status": "blocked"}
+        row = {"id": "child", "status": status, "blocked_upstream": json.dumps(stamp)}
+        result = enrich(conn, [row])[0]
+    if status == "todo":
+        assert result["blocked_upstream"] == stamp
+    else:
+        assert "blocked_upstream" not in result
+
+
 @pytest.mark.parametrize("transport", ["stamped", "graph", "old"])
 def test_replica_session_tasks_preserves_optional_ancestor(tmp_path, monkeypatch, transport):
     path = tmp_path / "replica.db"
