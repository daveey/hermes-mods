From e3eaa134969a62fa64f3268e34e226108ae1afe1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 10:14:53 +0000
Subject: [PATCH] [daveey] kanban edit:
 --requires/--completion-contract/--reason preflight in kanban_requires_edit;
 kanban.py back to the 2000-line cap

---
 hermes_cli/kanban.py               | 10 +++-------
 hermes_cli/kanban_requires_edit.py | 15 +++++++++++++++
 2 files changed, 18 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban.py b/hermes_cli/kanban.py
index 166b2e1abc..17abdd0989 100644
--- a/hermes_cli/kanban.py
+++ b/hermes_cli/kanban.py
@@ -1320,14 +1320,10 @@ _OPERATOR_EDIT_FLAGS = ("max_retries", "goal_mode", "goal_max_turns", "max_runti
 
 
 def _cmd_edit(args: argparse.Namespace) -> int:
-    if getattr(args, "requires", None) is not None:
-        from hermes_cli.kanban_requires_edit import cmd_edit_requires
-        return cmd_edit_requires(args)
-    if getattr(args, "completion_contract", None) is not None:
-        return _contract_cli.cmd_edit_contract(args)
+    from hermes_cli.kanban_requires_edit import edit_preflight  # --requires / --completion-contract / --reason
+    if (rc := edit_preflight(args)) is not None:
+        return rc
     reason = getattr(args, "reason", None)
-    if reason is not None and getattr(args, "priority", None) is None and getattr(args, "priority_bump", None) is None:
-        return _err("kanban edit: --reason only applies to --completion-contract or --priority", 2)
     result = getattr(args, "result", None)
     raw_metadata = getattr(args, "metadata", None)
     summary = getattr(args, "summary", None)
diff --git a/hermes_cli/kanban_requires_edit.py b/hermes_cli/kanban_requires_edit.py
index ebe3355f5e..5b09e14128 100644
--- a/hermes_cli/kanban_requires_edit.py
+++ b/hermes_cli/kanban_requires_edit.py
@@ -36,6 +36,21 @@ def set_requires(conn, task_id, requires):
     return changes
 
 
+def edit_preflight(args):
+    """Dispatch `kanban edit` flags with their own transaction; None means run the ordinary edit."""
+    from hermes_cli import kanban_contract_cli
+    from hermes_cli.kanban import _err
+
+    if getattr(args, "requires", None) is not None:
+        return cmd_edit_requires(args)
+    if getattr(args, "completion_contract", None) is not None:
+        return kanban_contract_cli.cmd_edit_contract(args)
+    if getattr(args, "reason", None) is not None and getattr(args, "priority", None) is None \
+            and getattr(args, "priority_bump", None) is None:
+        return _err("kanban edit: --reason only applies to --completion-contract or --priority", 2)
+    return None
+
+
 def cmd_edit_requires(args):
     """Separate edit transaction: reject mixed flags rather than partially applying an edit."""
     from hermes_cli.kanban import _OPERATOR_EDIT_FLAGS, _err
-- 
2.43.0

