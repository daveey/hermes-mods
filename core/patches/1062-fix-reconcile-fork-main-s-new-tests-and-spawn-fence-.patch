From 236b1075db504240ba927bed8a4d654e1dba83ac Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 23:28:11 +0000
Subject: [PATCH] fix: reconcile fork main's new tests and spawn fence with the
 upstream merge [daveey]

- _set_worker_pid keeps upstream's publish guard but always records the claimed run's
  worker, and treats a current_run_id a sync pull blanked as this claim's.
- Tests stubbing _profile_capabilities accept the fork's new required arg.
- Stamp-cache test counts parses through upstream's config backend.
- Frontmatter-index test uses upstream's renamed locate_skill/skill_search_dirs.
---
 hermes_cli/kanban_db_dispatch.py                 | 16 +++++++++++-----
 tests/gateway/fixtures/kanban_recovery_probe.py  |  4 ++--
 ...est_bare_custom_launch_keeps_profile_route.py |  2 +-
 tests/gateway/test_kanban_finite_admission.py    |  4 ++--
 tests/gateway/test_session_kanban.py             |  4 ++--
 .../gateway/test_session_kanban_run_off_loop.py  |  2 +-
 .../test_config_version_stamp_cache.py           | 11 ++++++-----
 .../test_kanban_worker_spawn_toolsets.py         |  2 +-
 tests/hermes_cli/test_welcome_trial.py           |  2 +-
 tests/tools/test_skill_frontmatter_index.py      |  8 ++++----
 10 files changed, 31 insertions(+), 24 deletions(-)

diff --git a/hermes_cli/kanban_db_dispatch.py b/hermes_cli/kanban_db_dispatch.py
index 2bc8fa0ea94..0ada0cf5250 100644
--- a/hermes_cli/kanban_db_dispatch.py
+++ b/hermes_cli/kanban_db_dispatch.py
@@ -1719,18 +1719,24 @@ def _set_worker_pid(conn: sqlite3.Connection, task_id: str, pid: int, *, run_id=
     fingerprint is what lets every later liveness/kill decision tell OUR worker from a process that
     recycled the PID after a reboot. A failed capture is persisted as ``UNVERIFIED_WORKER_FINGERPRINT``,
     never NULL: NULL is the legacy pre-fingerprint row whose bare-PID kill authority a new spawn must
-    not inherit."""
+    not inherit.
+
+    [daveey] ``run_id`` is the claimed run (HERMES_KANBAN_RUN_ID): its run row always records the
+    worker it launched, and a ``current_run_id`` a sync pull blanked mid-spawn (t_01a189343dd2f6ac)
+    still counts as this claim's for the task row. A card that moved on to a newer run keeps that
+    run's task fields untouched."""
     started_at = _process_fingerprint(int(pid)) or UNVERIFIED_WORKER_FINGERPRINT
     with _kb.write_txn(conn):
         if run_id is None:
             run_id = _kb._current_run_id(conn, task_id)
-        cur = conn.execute(
+        conn.execute(
             "UPDATE tasks SET worker_pid = ?, worker_started_at = ? WHERE id = ? AND status = 'running' "
-            "AND current_run_id IS ? AND worker_pid IS NULL "
+            "AND (current_run_id IS ? OR current_run_id IS NULL) AND worker_pid IS NULL "
             "AND (? IS NULL OR claim_lock = ?)",
             (int(pid), started_at, task_id, run_id, claim_lock, claim_lock))
-        if cur.rowcount:
-            conn.execute("UPDATE task_runs SET worker_pid = ?, worker_started_at = ? WHERE id = ?",
+        if run_id is not None:
+            conn.execute("UPDATE task_runs SET worker_pid = ?, worker_started_at = ? WHERE id = ? "
+                         "AND worker_pid IS NULL",
                          (int(pid), started_at, run_id))
         _kb._append_event(conn, task_id, "spawned", {"pid": int(pid), "started_at": started_at}, run_id=run_id)
 
