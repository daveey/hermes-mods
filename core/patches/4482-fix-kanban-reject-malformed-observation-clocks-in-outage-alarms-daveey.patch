From 10fa0a4a1802077b86666767ba765ca8cd35ed03 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 13:06:03 +0000
Subject: [PATCH] fix(kanban): reject malformed observation clocks in outage
 alarms [daveey]

---
 hermes_cli/turn_urgency_status_alarm.py          | 10 +++++-----
 .../hermes_cli/test_turn_urgency_status_alarm.py | 16 ++++++++++++++++
 2 files changed, 21 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/turn_urgency_status_alarm.py b/hermes_cli/turn_urgency_status_alarm.py
index d1cfc5f73a80459baa4aa6e2fa8c7dc262d16649..a9d3ad6229e6a2ddb29513fd59a57b114ec7aecf 100644
--- a/hermes_cli/turn_urgency_status_alarm.py
+++ b/hermes_cli/turn_urgency_status_alarm.py
@@ -84,7 +84,7 @@ def _health(home, now):
              and cache.get('board') == 'default'
              and isinstance(cache.get('source_revision'), str) and bool(cache['source_revision'].strip())
              and observed is not None and _finite_clock(until)
-             and observed <= now < until <= observed + 120
+             and observed < until <= observed + 120
              and isinstance(cache.get('owners'), list) and len(cache['owners']) <= 4096)
     if valid:
         for owner in cache['owners']:
@@ -92,16 +92,16 @@ def _health(home, now):
                     or not all(isinstance(owner.get(k), str) and owner[k].strip()
                                for k in ('task_id', 'source', 'ref', 'head'))
                     or owner['source'] not in ('core-lane', 'state-turn')
-                    or not _finite_clock(owner.get('expires_at')) or owner['expires_at'] <= now):
+                    or not _finite_clock(owner.get('expires_at')) or owner['expires_at'] < until):
                 valid = False
                 break
     success = _clock(status.get('last_success_at'), now)
     first = _clock(status.get('first_failure_at'), now)
     # A started/in-flight tick does not invalidate a previous fresh observation.
-    if valid:
+    if valid and now < until:
         return True, observed, None
-    # A cache published before a status-write crash is still a successful observation.
-    successes = [value for value in (success, observed) if value is not None]
+    # Only structurally valid publications prove success, even after expiry.
+    successes = [value for value in (success, observed if valid else None) if value is not None]
     since = max(successes) if successes else first
     error = status.get('last_error')
     if not isinstance(error, str) or not error:
diff --git a/tests/hermes_cli/test_turn_urgency_status_alarm.py b/tests/hermes_cli/test_turn_urgency_status_alarm.py
index de994239467e873242036cb3b12d59c03f3aca19..ae6912b726125e1d5b5cbeea5cf0dae3fbd39f53 100644
--- a/tests/hermes_cli/test_turn_urgency_status_alarm.py
+++ b/tests/hermes_cli/test_turn_urgency_status_alarm.py
@@ -134,6 +134,22 @@ def test_cache_publish_crash_does_not_roll_back_success(rig):
     assert alarm.sweep(conn, now=1600.125)
 
 
+@pytest.mark.parametrize('bad', [{'owners': [{}]}, {'version': 2},
+                                {'valid_until': 9999999999}, {'source_revision': ''}])
+def test_invalid_publications_cannot_reset_grace(rig, bad):
+    conn, home = rig
+    first = 1000.125
+    for elapsed in (0, 300, 599.999, 600):
+        cache(home, first + elapsed)
+        path = home / 'cache/kanban-turn-urgency.json'
+        doc = json.loads(path.read_text())
+        doc.update(bad)
+        path.write_text(json.dumps(doc))
+        result = alarm.sweep(conn, now=first + elapsed)
+        assert bool(result) == (elapsed == 600)
+    assert len(cards(conn)) == 1
+
+
 def test_second_recovery_inside_hour_is_not_lost(rig):
     conn, home = rig
     status(home, 1000.125)
