diff --git a/hermes_cli/kanban_source_cli.py b/hermes_cli/kanban_source_cli.py
new file mode 100644
index 0000000000..33c67b8c6a
--- /dev/null
+++ b/hermes_cli/kanban_source_cli.py
@@ -0,0 +1,110 @@
+"""workspace_source v1 CLI (core PR-2; v4.1 R3-a, v4 §2.3).
+
+* ``hermes kanban claim`` never takes a card with workspace_source custody or a manifest
+  (``source_cli_claim_refused``): a CLI claim sends no ``source_protocol`` and would run outside custody.
+* ``hermes kanban source-release <task> --to published|unchanged``: the operator frees a card whose source holder
+  is decommissioned or disabled. It first verifies that GitHub's branch head equals ``manifest.commit`` (``git
+  ls-remote``), then sends the admin-key-only ``/leases source_release`` with the manifest revision as CAS. The
+  Board refuses while a lease is live.
+"""
+
+from __future__ import annotations
+
+import argparse
+import sqlite3
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any, Callable, Optional
+
+from hermes_cli import kanban_workspace_source as ws
+
+ADMIN_KEY = "~/.config/hermes-mail/admin.key"
+CLAIM_REFUSED = "source_cli_claim_refused"
+
+
+def claim_refusal(conn: sqlite3.Connection, task_id: str) -> Optional[str]:
+    row = conn.execute("SELECT workspace_source, workspace_custody FROM tasks WHERE id = ?", (task_id,)).fetchone()
+    if row is None:
+        return None
+    if row[0] is not None or ws.parse_custody(row[1]) is not None:
+        return (f"{CLAIM_REFUSED}: {task_id} carries workspace_source custody; only the dispatcher may claim it "
+                "(it attaches the run to custody). Let the dispatcher run it, or move it.")
+    return None
+
+
+def remote_head(url: str, branch: str, *, timeout: float = 30.0) -> Optional[str]:
+    """``git ls-remote <url> <branch>`` (the manifest's branch ref), None when absent."""
+    out = subprocess.run(["git", "-c", "core.hooksPath=/dev/null", "ls-remote", url, branch], capture_output=True,
+                         text=True, encoding="utf-8", errors="replace", timeout=timeout, stdin=subprocess.DEVNULL,
+                         check=False)
+    if out.returncode != 0:
+        raise RuntimeError(f"git ls-remote {url} failed: {out.stderr.strip()[-200:]}")
+    for line in out.stdout.splitlines():
+        sha, _, ref = line.partition("\t")
+        if ref == branch:
+            return sha
+    return None
+
+
+def _admin_hub() -> Any:
+    from hermes_cli import kanban_sync_client as client
+    key_path = Path(ADMIN_KEY).expanduser()
+    if not key_path.is_file():
+        raise PermissionError(f"no admin key at {ADMIN_KEY}: source-release runs on the hub (Board admin key)")
+    ident = client.load_identity()
+    key = key_path.read_text(encoding="utf-8").strip()
+    return client.Hub(client.Identity(url=ident.url, key=key, gateway=ident.gateway))
+
+
+def source_release(conn: sqlite3.Connection, task_id: str, to_state: str, *, by: str,
+                   head: Callable[[str, str], Optional[str]] = remote_head,
+                   hub: Any = None) -> dict:
+    if to_state not in ("published", "unchanged"):
+        return {"ok": False, "reason_code": "invalid", "error": "--to must be published or unchanged"}
+    row = conn.execute("SELECT workspace_source FROM tasks WHERE id = ?", (task_id,)).fetchone()
+    if row is None:
+        return {"ok": False, "reason_code": "not_found", "error": f"no such task: {task_id}"}
+    try:
+        manifest = ws.parse_manifest(row[0])
+    except ws.ManifestInvalid as exc:
+        return {"ok": False, "reason_code": "workspace_source_unavailable", "error": f"no valid manifest: {exc}"}
+    try:
+        seen = head(manifest.url, manifest.branch)
+    except (RuntimeError, OSError, subprocess.TimeoutExpired) as exc:
+        return {"ok": False, "reason_code": "remote_unreadable", "error": str(exc)}
+    if seen != manifest.commit:
+        return {"ok": False, "reason_code": "remote_drift" if seen else "remote_branch_missing",
+                "error": f"{manifest.branch} on GitHub is {seen or 'missing'}, the manifest pins {manifest.commit}; "
+                         "the branch must match before custody can be released"}
+    from hermes_cli import kanban_db_sync as sync
+    try:
+        hub = hub or _admin_hub()
+        res = hub.leases(sync._state(conn)["board_id"], {
+            "action": "source_release", "task": task_id, "to_state": to_state,
+            "expected_revision": manifest.manifest_revision, "by": by[:100], "client_op_id": sync.uuid7()})
+    except Exception as exc:  # health: allow BLE001 -- an operator CLI reports every failure
+        return {"ok": False, "reason_code": "board_unavailable", "error": str(exc)[:300]}
+    if not isinstance(res, dict) or res.get("status") != "applied":
+        res = res if isinstance(res, dict) else {}
+        return {"ok": False, "reason_code": str(res.get("reason") or "rejected"), "error": str(res.get("detail") or "")}
+    return {"ok": True, "task": task_id, "to_state": to_state, "manifest_revision": manifest.manifest_revision,
+            "commit": manifest.commit}
+
+
+def cmd_source_release(args: argparse.Namespace) -> int:
+    import json
+
+    from hermes_cli import kanban_db_connect as kbc
+    from hermes_cli.profiles import current_profile_name
+    with kbc.connect_closing() as conn:
+        res = source_release(conn, args.task_id, args.to, by=getattr(args, "by", None) or current_profile_name("user")
+                             or "operator")
+    if getattr(args, "json", False):
+        print(json.dumps(res))
+    elif res["ok"]:
+        print(f"Released workspace_source custody of {res['task']} -> {res['to_state']} "
+              f"(revision {res['manifest_revision']}, {res['commit'][:12]})")
+    else:
+        print(f"source-release refused ({res['reason_code']}): {res['error']}", file=sys.stderr)
+    return 0 if res["ok"] else 1
diff --git a/hermes_cli/kanban_source_move.py b/hermes_cli/kanban_source_move.py
new file mode 100644
index 0000000000..62b46f2b55
--- /dev/null
+++ b/hermes_cli/kanban_source_move.py
@@ -0,0 +1,112 @@
+"""workspace_source v1 move / reservation (core PR-2; plan v2 §7, v3 §9, v4 S5).
+
+* ``dir`` stays ``workspace_bound`` forever.
+* A worktree card moves only with **portable custody**: feature enabled, a valid replica manifest, Board custody
+  ``published``/``unchanged`` at the manifest's revision and, when this host holds the source, a clean local worktree
+  with ``HEAD == manifest.commit`` (:func:`parked_refusal`).
+* A RUNNING card publishes first (§4 steps 1-8) and is checked against that fresh result (:func:`publish_for_move`);
+  the ``continue_task`` that ends the run carries the receipt.
+* ``--reclaim`` refuses worktree cards and manifest-bearing cards (``reclaim_source_unsupported``).
+* A portable worktree card is not host-only: its capability needs drop the implicit ``host_repo``
+  (:func:`capability_kind`); an explicit ``host_repo`` in ``requires`` is unchanged.
+"""
+
+from __future__ import annotations
+
+import sqlite3
+from typing import Any, Mapping, Optional
+
+from hermes_cli import kanban_workspace_source as ws
+
+PORTABLE_STATES = ("published", "unchanged")
+
+
+def _row(conn: sqlite3.Connection, task_id: str) -> Optional[sqlite3.Row]:
+    return conn.execute("SELECT workspace_kind, workspace_path, workspace_source, workspace_custody FROM tasks "
+                        "WHERE id = ?", (task_id,)).fetchone()
+
+
+def _local_matches(path: Optional[str], commit: str) -> bool:
+    from hermes_cli.kanban_source_launch import observe
+    seen = observe(path, None)
+    return bool(seen["clean"] and seen["head"] == commit)
+
+
+def portable(manifest_value: Any, custody_value: Any) -> Optional[str]:
+    """None when (manifest, custody) is portable, else the refusal code (no local check)."""
+    if not ws.settings().enabled:
+        return "source_disabled"
+    if manifest_value is None:
+        return "workspace_source_unpublished"
+    try:
+        manifest = ws.parse_manifest(manifest_value)
+    except ws.ManifestInvalid:
+        return "manifest_invalid"
+    custody = custody_value if isinstance(custody_value, ws.Custody) else ws.parse_custody(custody_value)
+    if custody is None:
+        return "workspace_source_not_on_board"
+    if custody.state not in PORTABLE_STATES or custody.manifest_revision != manifest.manifest_revision:
+        return "custody_retained"
+    return None
+
+
+def parked_refusal(conn: sqlite3.Connection, task_id: str, *, me: str,
+                   fresh: Optional[tuple[Any, Any]] = None) -> Optional[tuple[str, str]]:
+    """``(code, message)`` when this card may not move, None when it may. ``fresh`` is a just-published
+    ``(manifest, custody)`` that replaces the (possibly stale) replica columns."""
+    row = _row(conn, task_id)
+    if row is None:
+        return None
+    kind = row["workspace_kind"]
+    if kind == "dir":
+        return "workspace_bound", "a dir card runs only where its workspace is"
+    if kind != "worktree":
+        return None
+    manifest_value, custody_value = fresh or (row["workspace_source"], row["workspace_custody"])
+    code = portable(manifest_value, custody_value)
+    if code == "source_disabled":
+        return "workspace_bound", "a worktree card runs only where its workspace is (workspace_source disabled)"
+    if code:
+        return code, f"a worktree card moves only with portable custody ({code})"
+    custody = custody_value if isinstance(custody_value, ws.Custody) else ws.parse_custody(custody_value)
+    commit = ws.parse_manifest(manifest_value).commit
+    if custody is not None and custody.source_holder == me and not _local_matches(row["workspace_path"], commit):
+        return ("workspace_source_unpublished",
+                f"the local worktree is not clean at the published commit {commit[:12]}; let a run publish it")
+    return None
+
+
+def reclaim_refusal(conn: sqlite3.Connection, task_id: str) -> Optional[str]:
+    row = _row(conn, task_id)
+    if row is None:
+        return None
+    if row["workspace_kind"] == "worktree" or row["workspace_source"] is not None:
+        return "reclaim_source_unsupported"
+    return None
+
+
+def publish_for_move(conn: sqlite3.Connection, task_id: str) -> tuple[Optional[dict], Optional[tuple[Any, Any]], str]:
+    """Publish a running card before its move check: ``(receipt, (manifest, custody), "")`` or
+    ``(None, None, refusal_code)``. A run that never attached returns ``(None, None, "")`` (nothing to publish)."""
+    row = _row(conn, task_id)
+    if row is None or row["workspace_kind"] != "worktree":
+        return None, None, ""
+    from hermes_cli import kanban_source_board as board_calls
+    from hermes_cli.kanban_source_preflight import receipt_for_current_run
+    run_id, receipt = receipt_for_current_run(conn, task_id, publish=True)
+    if receipt is None:
+        return None, None, ""
+    if receipt["state"] == "retained":
+        return None, None, str(receipt.get("reason") or "custody_retained").removeprefix("publish_error=")
+    run = board_calls.attached_run(conn, run_id)
+    manifest = run.manifest if run is not None else None
+    custody = ws.Custody(source_holder=None, state=receipt["state"], manifest_revision=receipt["manifest_revision"])
+    return receipt, (manifest, custody), ""
+
+
+def capability_kind(card: Mapping[str, Any]) -> str:
+    """The workspace kind capability checks use: a portable worktree card needs no host checkout."""
+    kind = card.get("workspace_kind") or "scratch"
+    if kind == "worktree" and portable(card.get("workspace_source"), card.get("workspace_custody")) is None:
+        return "worktree_source"
+    return kind
