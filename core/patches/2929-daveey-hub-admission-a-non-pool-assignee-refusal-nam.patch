From 109b23da074a9cb909188e823cc493f2a67ff33f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 16:49:23 +0000
Subject: [PATCH] [daveey] hub admission: a non-pool assignee refusal names the
 profile and the pool route

A hub chat filed Mac-only tailnet_exec work as assignee mac-ops, a profile no pool worker
runs, and the card sat in the hub's own queue (sweep slug profile-not-in-pool, evidence
t_01a1cde9714608c4, card t_01a1d09e42e2c4fd). Hub admission now judges that structural keep and
refuses a deny, but the remedy only said "remove what keeps it on this host (assignee not
allowlisted)", which does not tell the agent which field to change or where the work goes.

hub_stay_remedy now names the assignee, the pool profiles (kanban.placement.assignees) and the
route: a pool assignee, no placement, runs_on capability:<label> (tailnet-exec for a Mac,
hub-write, hub-read). Other structural keeps keep the old text.

Tests: a tool-level create with assignee mac-ops on the hub (fake judge denies) asserts the
refusal names 'mac-ops', the pool profiles, assignee='default' and capability:tailnet-exec; a
unit test pins ASSIGNEE_KEEP to structural_reason's text. Both fail on the old code.
---
 hermes_cli/kanban_hub_admission_placement.py  | 24 +++++++++++++++----
 tests/test_kanban_hub_admission_placement.py  |  9 +++++++
 tests/tools/test_kanban_hub_admission_tool.py | 19 +++++++++++++++
 3 files changed, 48 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_hub_admission_placement.py b/hermes_cli/kanban_hub_admission_placement.py
index edb9ea35d1..957af55581 100644
--- a/hermes_cli/kanban_hub_admission_placement.py
+++ b/hermes_cli/kanban_hub_admission_placement.py
@@ -443,10 +443,11 @@ def _decision_shortcut(args, decision, gateway, cfg, *, labels, machine_hub, pin
 
 def _refusal(args, verdict, audit, cfg, *, on_hub, machine_hub, pin, labels):
     """A denied explicit hub card; a hub-origin stay-here refusal carries alternatives that work on the hub."""
-    from hermes_cli.kanban_placement import structural_reason
+    from hermes_cli.kanban_placement import _Cfg, structural_reason
     out = {"where": "refuse", "why": verdict.why, "hub_admission": audit, "pin": "hub"}
     if on_hub and not machine_hub and not is_hub(pin, cfg):
-        out["remedy"] = hub_stay_remedy(structural_reason({**args, "runs_on": None}, cfg), labels)
+        out["remedy"] = hub_stay_remedy(structural_reason({**args, "runs_on": None}, cfg), labels,
+                                        assignee=args.get("assignee"), pool_profiles=_Cfg(cfg).assignees())
     return out
 
 
@@ -490,10 +491,25 @@ def decision_card_route(args, decision, gateway, cfg, *, queue=True, machine_ok=
     return out
 
 
-def hub_stay_remedy(structural, labels):
-    """Refusal text for a hub-origin card the judge denied: alternatives that work here, never ``placement='local'``."""
+ASSIGNEE_KEEP = "assignee not allowlisted"
+
+
+def hub_stay_remedy(structural, labels, *, assignee=None, pool_profiles=()):
+    """Refusal text for a hub-origin card the judge denied: alternatives that work here, never ``placement='local'``.
+
+    A profile the pool does not run names that profile and the pool route: a hub chat filed Mac-only
+    tailnet work as ``mac-ops`` and, told only "assignee not allowlisted", kept the hub-only profile
+    (sweep slug profile-not-in-pool, t_01a1d09e42e2c4fd). [daveey]
+    """
     if labels is not None:
         first = "drop runs_on (or name labels a pool worker carries) so the card joins the worker pool"
+    elif structural == ASSIGNEE_KEEP:
+        pool = sorted(pool_profiles) or ["default"]
+        pick = "default" if "default" in pool else pool[0]
+        first = (f"assignee {assignee!r} is a profile no pool worker runs (pool profiles: {', '.join(pool)}); "
+                 f"re-create it with assignee={pick!r}, no placement, and runs_on=['capability:<label>'] for the "
+                 "access the work needs (capability:tailnet-exec for commands on a Mac, capability:hub-write "
+                 "for hub-admin changes, capability:hub-read for hub logs and DBs)")
     elif structural:
         first = (f"remove what keeps it on this host ({structural}) and omit placement so the card joins the "
                  "worker pool")
diff --git a/tests/test_kanban_hub_admission_placement.py b/tests/test_kanban_hub_admission_placement.py
index 5794b596e1..2a7764fe84 100644
--- a/tests/test_kanban_hub_admission_placement.py
+++ b/tests/test_kanban_hub_admission_placement.py
@@ -202,3 +202,12 @@ def test_origin_and_courier_denies_never_queue(gate, monkeypatch):
     audit = {"admit": False}
     assert "runs_on" not in hap.pool_route({"title": "x"}, QUEUE_CFG, "hub", audit, ["hub:write"], queue=False)
     assert hap.pool_route({"title": "x"}, QUEUE_CFG, "hub", audit, ["hub:write"])["runs_on"][0] == "pool:worker"
+
+
+def test_assignee_keep_remedy_tracks_structural_reason():
+    """The remedy keys on structural_reason's exact text; a reworded reason must not silently drop it."""
+    from hermes_cli import kanban_hub_admission_placement as hap
+    cfg = {"worker_pools": {"hub": ["worker-1"]}, "assignees": ["default", "bb-tuner"]}
+    assert placement.structural_reason({"assignee": "mac-ops"}, cfg) == hap.ASSIGNEE_KEEP
+    text = hap.hub_stay_remedy(hap.ASSIGNEE_KEEP, None, assignee="mac-ops", pool_profiles={"default", "bb-tuner"})
+    assert "'mac-ops'" in text and "pool profiles: bb-tuner, default" in text and "assignee='default'" in text
diff --git a/tests/tools/test_kanban_hub_admission_tool.py b/tests/tools/test_kanban_hub_admission_tool.py
index a3b599cb70..b3fbfb1c5b 100644
--- a/tests/tools/test_kanban_hub_admission_tool.py
+++ b/tests/tools/test_kanban_hub_admission_tool.py
@@ -202,3 +202,22 @@ def test_tool_placement_hub_from_another_gateway(on_gateway, monkeypatch, admit)
     else:
         assert sent == [] and not result.get("ok")
         assert result["hub_admission"]["admit"] is False
+
+
+def test_tool_non_pool_assignee_refusal_names_the_pool_route(on_gateway):
+    """t_01a1d09e42e2c4fd (sweep slug profile-not-in-pool, evidence t_01a1cde9714608c4): a hub chat filed
+    Mac-only tailnet_exec work as assignee mac-ops, a profile no pool worker runs, so the card sat in the
+    hub's own queue. Admission now refuses it; the refusal must name the assignee as the pin and the pool
+    route (a pool profile plus runs_on capability:tailnet-exec), not just "assignee not allowlisted"."""
+    judge = on_gateway("hub")
+    judge.admit_next = False
+    result = json.loads(kt._handle_create({
+        "title": "Mini disk: durable headroom so the governor disk hold releases", "assignee": "mac-ops",
+        "requires": [], "body": "Do, via tailnet_exec host=mini: audit the CI runner work dir and free space."}))
+    assert not result.get("ok") and result.get("created") is False, result
+    assert len(judge.calls) == 1
+    text = result["error"]
+    assert "'mac-ops'" in text and "pool profiles: default" in text, text
+    assert "assignee='default'" in text and "capability:tailnet-exec" in text, text
+    with kbc.connect() as conn:
+        assert kb.list_tasks(conn) == []
