From cee44ce579034d6a64b5ef6655be934b33e1b54e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 19:54:27 +0000
Subject: [PATCH] fix(kanban): retain external Git custody across checkpoint
 rollover [daveey]

---
 hermes_cli/kanban_workspace_publication.py      |  8 ++++++++
 .../test_kanban_workspace_publication.py        | 17 +++++++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/hermes_cli/kanban_workspace_publication.py b/hermes_cli/kanban_workspace_publication.py
index c99bbfa57b..8898692458 100644
--- a/hermes_cli/kanban_workspace_publication.py
+++ b/hermes_cli/kanban_workspace_publication.py
@@ -72,6 +72,14 @@ def _paths(conn, task_id, text=''):
             continue
         if isinstance(data, dict):
             texts.extend(str(data.get(key) or '') for key in ('checkpoint', 'worktree', 'worktrees'))
+            # Carry server-observed custody forward even after checkpoint prose
+            # rolls out of the bounded history window or the worktree disappears.
+            receipts = data.get('workspace_publications')
+            if isinstance(receipts, list):
+                for receipt in receipts:
+                    raw = receipt.get('path') if isinstance(receipt, dict) else None
+                    if isinstance(raw, str) and Path(raw).is_absolute():
+                        found[raw] = Path(raw)
     for value in texts:
         for raw in re.findall(r"(?:/|~/)[^\s`'\"<>;,()\[\]]+", value):
             path = Path(raw.rstrip('.')).expanduser()
diff --git a/tests/hermes_cli/test_kanban_workspace_publication.py b/tests/hermes_cli/test_kanban_workspace_publication.py
index 551a81b80d..345a792172 100644
--- a/tests/hermes_cli/test_kanban_workspace_publication.py
+++ b/tests/hermes_cli/test_kanban_workspace_publication.py
@@ -155,6 +155,23 @@ def test_explicit_retention_reason_records_host_custody(git_task):
         assert receipt['workspace_publication']['retention_reason'] == 'contains private evidence'
 
 
+def test_external_custody_survives_repeated_checkpoint_rollover(git_task, tmp_path):
+    tid, _, git = git_task
+    repo = tmp_path / 'retained-worktree'
+    git('worktree', 'add', '-b', 'retained-implementation', str(repo))
+    scratch = tmp_path / 'scratch'
+    scratch.mkdir()
+    with kbc.connect_closing() as conn:
+        kw.set_workspace_path(conn, tid, scratch)
+        checkpoint = f'Worktree {repo}\nUNPUBLISHED_WORK_REASON=review corrections pending'
+        for _ in range(4):
+            assert kc.continue_task(conn, tid, checkpoint=checkpoint)['ok']
+            assert kb.claim_task(conn, tid)
+            checkpoint = 'UNPUBLISHED_WORK_REASON=review corrections still pending'
+        with pytest.raises(ValueError, match='unpublished_workspace'):
+            kc.continue_task(conn, tid, checkpoint='Resume from prior state')
+
+
 def test_crash_records_unknown_custody_without_network(git_task, monkeypatch):
     import json
     from hermes_cli import kanban_workspace_publication as pub
