+                      "first_at": (NOW - 1200) * 1000, "last_at": NOW * 1000, "passes": 1}}
+    monkeypatch.setattr(kps, "stalled", lambda *a, **kw: [ready])
+
+    def fail(*a, **kw):
+        raise RuntimeError("observer unavailable")
+
+    if failure == "open":
+        original_open = wn.open_replica
+        calls = []
+
+        def fail_first(conn):
+            calls.append(conn)
