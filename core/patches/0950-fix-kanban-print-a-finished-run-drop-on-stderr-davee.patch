From 48f310fd7b08f6a9f2f89a4c7260128226ab24e0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 02:50:19 -0700
Subject: [PATCH] fix(kanban): print a finished-run drop on stderr [daveey]

A one-shot hermes process only has a queue log handler, so the info
line never reaches the operator before --version exits.
---
 hermes_cli/kanban_identity.py                  | 18 +++---------------
 tests/hermes_cli/test_stale_kanban_identity.py | 17 +++++++++++++++++
 2 files changed, 20 insertions(+), 15 deletions(-)

diff --git a/hermes_cli/kanban_identity.py b/hermes_cli/kanban_identity.py
index 2dce37c905..4f4a2cbdf7 100644
--- a/hermes_cli/kanban_identity.py
+++ b/hermes_cli/kanban_identity.py
@@ -84,23 +84,11 @@ def run_is_live(env: Mapping[str, str], task: str, run_id: int) -> Optional[bool
     return row is not None
 
 
-def _info_visible() -> bool:
-    current = log
-    seen = set()
-    while current is not None and id(current) not in seen:
-        seen.add(id(current))
-        if any(getattr(h, "level", logging.NOTSET) <= logging.INFO for h in current.handlers):
-            return True
-        if not current.propagate:
-            return False
-        current = current.parent
-    return False
-
-
 def _emit(msg: str) -> None:
     log.info(msg)
-    if not _info_visible():
-        print(msg, file=sys.stderr)
+    # A one-shot process often has only a queue handler, which has not flushed
+    # by the time --version exits. stderr is the line the operator can see.
+    print(msg, file=sys.stderr)
 
 
 def drop_finished_kanban_identity(
diff --git a/tests/hermes_cli/test_stale_kanban_identity.py b/tests/hermes_cli/test_stale_kanban_identity.py
index 59b675dcaf..23a6e21786 100644
--- a/tests/hermes_cli/test_stale_kanban_identity.py
+++ b/tests/hermes_cli/test_stale_kanban_identity.py
@@ -131,6 +131,23 @@ def test_noop_when_unset(monkeypatch):
     assert drop_finished_kanban_identity() == []
 
 
+def test_drop_line_is_on_stderr_even_when_a_handler_exists(monkeypatch, tmp_path, capsys):
+    """A one-shot process often has only a queue handler. The drop line must still be visible."""
+    db = _board(tmp_path / "kanban.db", live=False)
+    _pin(monkeypatch, db)
+    root = logging.getLogger()
+    handler = logging.NullHandler()
+    root.addHandler(handler)
+    try:
+        drop_finished_kanban_identity()
+    finally:
+        root.removeHandler(handler)
+    err = capsys.readouterr().err
+    assert "dropped finished kanban identity" in err
+    assert f"HERMES_KANBAN_TASK={TASK}" in err
+    assert f"HERMES_KANBAN_RUN_ID={RUN}" in err
+
+
 def test_main_drops_identity_before_plugins_load():
     from hermes_cli.main import main
     src = inspect.getsource(main)
