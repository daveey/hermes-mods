@@ -46,13 +46,13 @@ def test_gateway_checks_identity_after_lock_acquisition(board, monkeypatch):
     replaced = False
 
     @contextmanager
-    def interleave(path):
+    def interleave(path, **kwargs):
         nonlocal replaced
         if not replaced:
             replaced = True
             kb.remove_board("sample")
             kb.create_board("sample")
-        with original(path) as held:
+        with original(path, **kwargs) as held:
             yield held
 
     dispatcher = _KanbanDispatcher.__new__(_KanbanDispatcher)
@@ -74,7 +74,8 @@ def test_contended_open_requires_reconnect_before_dispatch(board):
     with closing(conn):
         callback = Mock(return_value=DispatchResult())
         result = run_owned_tick(conn, callback, "dedicated", "sample", False)
-        assert result.skipped_owned and result.ownership_error
+        assert result.skipped_locked
+        assert not result.skipped_owned and not result.ownership_error
         callback.assert_not_called()
     with closing(kbc.connect(board)) as fresh:
         callback = Mock(return_value=DispatchResult())
diff --git a/tests/plugins/test_kanban_board_lifecycle_api.py b/tests/plugins/test_kanban_board_lifecycle_api.py
index f1072f08ca..a3adc27f5d 100644
--- a/tests/plugins/test_kanban_board_lifecycle_api.py
+++ b/tests/plugins/test_kanban_board_lifecycle_api.py
@@ -88,3 +88,23 @@ def test_delete_default_board_is_refused(client):
     r = client.delete("/api/plugins/kanban/boards/default")
     assert r.status_code == 400
     assert "default" in r.json()["detail"]
+
+
+@pytest.mark.parametrize("method", ["post", "patch"])
+def test_busy_board_metadata_returns_conflict(client, method):
+    from hermes_cli import kanban_db_connect as kbc
+    kb.create_board("sample")
+    path = kb.board_dir("sample") / "kanban.db"
+    url = "/api/plugins/kanban/boards" + ("/sample" if method == "patch" else "")
+    with kbc._dispatch_tick_lock(path) as held:
+        assert held
+        response = getattr(client, method)(url, json={"slug": "sample", "name": "New"})
+    assert response.status_code == 409
+    assert "busy" in response.json()["detail"]
+    assert kb.read_board_metadata("sample")["name"] != "New"
+
+
+def test_missing_board_delete_is_refused_without_stub(client):
+    response = client.delete("/api/plugins/kanban/boards/missing")
+    assert response.status_code == 400
+    assert not kb.board_dir("missing").exists()
diff --git a/website/docs/developer-guide/kanban-dispatch-ownership.md b/website/docs/developer-guide/kanban-dispatch-ownership.md
index 252f777b3e..ee09007b05 100644
--- a/website/docs/developer-guide/kanban-dispatch-ownership.md
+++ b/website/docs/developer-guide/kanban-dispatch-ownership.md
@@ -99,7 +99,12 @@ an identity implicitly.
   replacement's owner. Raw SQLite and in-memory handles fail closed. A native
   connection opened while that lock is busy remains usable for ordinary task
   APIs, but must be closed and reopened before dispatch (even after contention
-  clears). This intentional API tightening applies to unowned boards too.
+  clears). This returns `skipped_locked`, not an ownership error. Native opens
+  briefly take the same nonblocking lock as ticks and edits; under heavy connection
+  traffic even an unowned board can report busy. This intentional serialization
+  prevents stale-handle ownership bypasses and applies to unowned boards too.
+  CLI metadata commands report a retryable error rather than a traceback; dashboard
+  create/update returns HTTP 409 on lock contention. Retry with a fresh connection.
 * Direct task APIs are not changed: this coordinates dispatchers, not arbitrary
   same-UID database writers. Replacing a DB manually without removing its sidecar
   retains ownership, including corruption recovery; clear ownership explicitly
