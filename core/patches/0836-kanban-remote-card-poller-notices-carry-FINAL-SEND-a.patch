From 80012e85fe8c557ee835125a8b6f4b1655ba2a7a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 22:46:13 +0000
Subject: [PATCH] kanban: remote-card poller notices carry FINAL SEND and share
 event identity with the sweeper

The live poller (collect) delivered the generic 'ran on <gw>' notice for a remote done card, which drops the
FINAL SEND text; the sweeper's FINAL SEND notice then deduped on a different id. collect now formats from the
owner's completion_notice and both paths record the same kanban_event_keys. [daveey]
---
diff --git a/tests/tui_gateway/test_kanban_remote_notices.py b/tests/tui_gateway/test_kanban_remote_notices.py
index 7abc5add43dfbf76f8344d1d97a17a75a626c241..ed3f40e7d1805009dc77ee12d346414f4b4d2898 100644
--- a/tests/tui_gateway/test_kanban_remote_notices.py
+++ b/tests/tui_gateway/test_kanban_remote_notices.py
@@ -91,6 +91,39 @@ def test_legacy_done_cards_are_not_replayed_on_rollout(tmp_path):
         assert "completion_notice" not in task
 
 
+def test_poller_collect_delivers_final_send_and_sweeper_dedupes(tmp_path):
+    import time
+    from tui_gateway import kanban_remote_notices as krn
+
+    tid, replica = _replicate(tmp_path, f"proof prose\nFINAL SEND for @session:default@macbook/{CHAT}: poller proof")
+    with sqlite3.connect(replica) as conn:
+        data = json.loads(conn.execute("SELECT data FROM replica").fetchone()[0])
+        data["completed_at"] = time.time()
+        conn.execute("DROP TABLE replica")
+        conn.execute("CREATE TABLE replica(gw TEXT,coll TEXT,key TEXT,data TEXT,seq INTEGER)")
+        conn.execute("CREATE TABLE meta(k TEXT,v TEXT)")
+        conn.execute("INSERT INTO meta VALUES ('gateway','macbook')")
+        conn.execute("INSERT INTO replica VALUES (?,?,?,?,1)", ("hub", "tasks", f"default/default/{tid}", json.dumps(data)))
+    krn._reset_for_tests()
+    ledger = tmp_path / "ledger.db"
+    got = krn.collect(CHAT, "default", hub_db=replica, ledger=ledger)
+    assert len(got) == 1
+    assert "poller proof" in got[0]["text"] and "ran on hub" not in got[0]["text"]
+    assert "FINAL SEND" not in got[0]["text"]
+    other = krn.collect(OTHER, "default", hub_db=replica, ledger=ledger)
+    assert "poller proof" not in other[0]["text"]
+    with SessionDB(tmp_path / "state.db") as db:
+        db.create_session(CHAT, "desktop")
+        db.record_kanban_notice(CHAT, got[0]["text"], {"notice_id": "live:x", "kanban_event_keys": [got[0]["event_key"]]})
+
+        @contextlib.contextmanager
+        def opener(profile, sid):
+            yield (db, sid) if sid == CHAT else (None, None)
+
+        sweep_remote_notices(replica_path=replica, gateway="macbook", session_db=opener)
+        assert len(db.get_messages(CHAT)) == 1
+
+
 def test_absent_replica_is_read_only_and_not_created(tmp_path):
     path = tmp_path / "absent.db"
     assert sweep_remote_notices(replica_path=path, gateway="macbook") == []
diff --git a/tui_gateway/kanban_remote_notices.py b/tui_gateway/kanban_remote_notices.py
index 563f3d3cfd914ca6c51c028c52e6ddd5cdd1ed21..1a1d8b0841485785d31783283e342660913382e5 100644
--- a/tui_gateway/kanban_remote_notices.py
+++ b/tui_gateway/kanban_remote_notices.py
@@ -134,6 +134,22 @@ def format_notice(gw: str, key: str, task: dict) -> str:
             + f" — {title}\n(on {gw}; read it with cross_task @task:{board}@{gw}/{tid})")
 
 
+def _event_key(owner: str, key: str, notice: dict) -> str:
+    """Event identity shared by the poller (``collect``) and the sweeper, so a chat gets one notice per event."""
+    return f"remote:{owner}:{key}:{notice['event_id']}"
+
+
+def _completion_text(gw: str, key: str, task: dict, me: str, profile: str, sid: str) -> Optional[str]:
+    """Standard done notice from the owner's published ``completion_notice`` (FINAL SEND aware), else None."""
+    notice = task.get("completion_notice")
+    if task.get("status") != "done" or not isinstance(notice, dict) or "event_id" not in notice:
+        return None
+    from tui_gateway.session_notifications import _format_kanban_event_text
+    sub = {"task_id": task["id"], "chat_id": f"{me}/{profile}/{sid}"}
+    ev = SimpleNamespace(kind="completed", payload=notice.get("payload"))
+    return _format_kanban_event_text(sub, SimpleNamespace(**task), ev, task.get("board", "default"))
+
+
 def collect(session_key: str, profile: str, *, hub_db: Optional[Path] = None, ledger: Optional[Path] = None,
             now: Optional[float] = None, lineage: tuple[str, ...] = (),
             skip: Optional[Callable[[str], bool]] = None) -> list[dict]:
@@ -148,10 +164,10 @@ def collect(session_key: str, profile: str, *, hub_db: Optional[Path] = None, le
     now = time.time() if now is None else now
     try:
         with _lock:
-            _, index = _index(path)
+            me, index = _index(path)
         cards = []
         for sid in (session_key, *lineage):
-            cards.extend(index.get((profile or "default", sid), ()))
+            cards.extend(dict(c, sid=sid) for c in index.get((profile or "default", sid), ()))
         if not cards:
             return []
         out: list[dict] = []
@@ -171,8 +187,12 @@ def collect(session_key: str, profile: str, *, hub_db: Optional[Path] = None, le
                     cur = conn.execute("INSERT OR IGNORE INTO notices VALUES (?,?,?,?,?)",
                                        (session_key, ref, state, now, 1 if fresh else 0))
                 if cur.rowcount == 1 and fresh:
-                    out.append({"text": format_notice(card["gw"], card["key"], task), "session": session_key,
-                                "ref": ref, "state": state})
+                    text = _completion_text(card["gw"], card["key"], task, me, profile or "default", card["sid"])
+                    item = {"text": text or format_notice(card["gw"], card["key"], task), "session": session_key,
+                            "ref": ref, "state": state}
+                    if text:
+                        item["event_key"] = _event_key(card["gw"], card["key"], task["completion_notice"])
+                    out.append(item)
                     if len(out) >= MAX_PER_POLL:
                         break
         finally:
@@ -230,7 +250,6 @@ def sweep_remote_notices(*, replica_path=None, gateway=None, session_db=_session
     delivers FINAL SEND lines when no chat is polling.
     """
     from hermes_cli.kanban_origin import _hub_db, gateway_names
-    from tui_gateway.session_notifications import _format_kanban_event_text
 
     path = replica_path if replica_path is not None else _hub_db()
     if path is None:
@@ -260,10 +279,9 @@ def sweep_remote_notices(*, replica_path=None, gateway=None, session_db=_session
                 event_id = notice["event_id"]
                 metadata = {"notice_id": f"remote:{owner}:{key}:{event_id}:{profile}:{sid}",
                             "board": task.get("board", "default"), "task_id": task["id"],
-                            "gateway": owner, "event_ids": [event_id]}
-                sub = {"task_id": task["id"], "chat_id": f"{me}/{profile}/{sid}"}
-                ev = SimpleNamespace(kind="completed", payload=notice["payload"])
-                text = _format_kanban_event_text(sub, SimpleNamespace(**task), ev, metadata["board"])
+                            "gateway": owner, "event_ids": [event_id],
+                            "kanban_event_keys": [_event_key(owner, key, notice)]}
+                text = _completion_text(owner, key, task, me, profile, sid)
                 with session_db(profile, sid) as (db, tip):
                     if db is not None:
                         row_id = db.append_kanban_notice(tip, text, metadata)
