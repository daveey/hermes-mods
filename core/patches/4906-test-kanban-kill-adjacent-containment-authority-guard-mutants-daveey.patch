From 972f4c8bf8f80edd4e1e408fcc90e413e0769ed8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 13:59:43 +0000
Subject: [PATCH] test(kanban): kill adjacent containment authority guard
 mutants [daveey]

---
 tests/hermes_cli/test_kanban_containment_envelope.py  | 3 +++
 tests/hermes_cli/test_kanban_containment_lifecycle.py | 6 +++++-
 tests/hermes_cli/test_kanban_containment_scope.py     | 6 ++++++
 3 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_containment_envelope.py b/tests/hermes_cli/test_kanban_containment_envelope.py
index 9b155862e70ef710e44e869df287b832c1127845..e785f855bc4bbd47a4182846085379057519a9b8 100644
--- a/tests/hermes_cli/test_kanban_containment_envelope.py
+++ b/tests/hermes_cli/test_kanban_containment_envelope.py
@@ -56,6 +56,9 @@ def test_old_review_resume_cannot_survive_a_containment_episode(board, phase):
     stop = board.execute("SELECT * FROM task_events WHERE uid=?", (episode,)).fetchone()
     assert "_recovery_history_v1" in json.loads(stop["payload"])
     if phase == "containment_released":
+        with kb.write_txn(board):
+            kb._append_event(board, relay, "blocked", {"resume_status": "review"})
+        assert kb._resume_status_from_events(board, relay) == "review"
         lifecycle.release(board, target, episode, authority)
         assert kb._resume_status_from_events(board, relay) == "ready"
     from hermes_cli.kanban_recovery_history import head
diff --git a/tests/hermes_cli/test_kanban_containment_lifecycle.py b/tests/hermes_cli/test_kanban_containment_lifecycle.py
index 1dcb0875157fd1d9323b0e4f160cefe91130a839..83c0754756d615b45d9e66499cab2c24c9e56701 100644
--- a/tests/hermes_cli/test_kanban_containment_lifecycle.py
+++ b/tests/hermes_cli/test_kanban_containment_lifecycle.py
@@ -80,7 +80,11 @@ def test_resume_rejects_unauthorized_stale_or_tampered_evidence(board, case):
     episode = contain(board, relay, target, spec)["episode"]
     actor, uid = authority, run_uid(board, authority)
     if case == "wrong_actor":
-        actor = consumer
+        actor = kb.create_task(board, title="Unrelated live actor fixture", assignee="default")
+        assert kb.claim_task(board, actor, claimer="default")
+        from hermes_cli.kanban_db_sync import uuid7
+        uid = uuid7()
+        board.execute("UPDATE task_runs SET uid=? WHERE id=(SELECT current_run_id FROM tasks WHERE id=?)", (uid, actor))
     elif case == "stale_run":
         from hermes_cli.kanban_db_sync import uuid7
         uid = uuid7()
diff --git a/tests/hermes_cli/test_kanban_containment_scope.py b/tests/hermes_cli/test_kanban_containment_scope.py
index 1ae6bd69e0930391d3fe5166ebf6e75c7df81d01..047c71631e7e1c2d2fecac0c766ca870213d9445 100644
--- a/tests/hermes_cli/test_kanban_containment_scope.py
+++ b/tests/hermes_cli/test_kanban_containment_scope.py
@@ -21,6 +21,7 @@ board = helpers.board
     ("task_expired", "UPDATE tasks SET claim_expires=1 WHERE current_run_id=?"),
     ("task_no_expiry", "UPDATE tasks SET claim_expires=NULL WHERE current_run_id=?"),
     ("task_no_lock", "UPDATE tasks SET claim_lock=NULL WHERE current_run_id=?"),
+    ("both_no_lock", "UPDATE tasks SET claim_lock=NULL WHERE current_run_id=?"),
     ("task_wrong_lock", "UPDATE tasks SET claim_lock='another-holder' WHERE current_run_id=?"),
     ("task_not_running", "UPDATE tasks SET status='ready' WHERE current_run_id=?"),
     ("different_current", "UPDATE tasks SET current_run_id=NULL WHERE current_run_id=?"),
@@ -32,6 +33,10 @@ def test_actor_must_be_current_live_lease_not_just_a_run_record(board, mutation,
     rid = kb.get_task(board, relay).current_run_id
     if sql is not None:
         board.execute(sql, (rid,))
+    if mutation == "malformed_uid":
+        board.execute("UPDATE task_runs SET uid=? WHERE id=?", (uid, rid))
+    if mutation == "both_no_lock":
+        board.execute("UPDATE task_runs SET claim_lock=NULL WHERE id=?", (rid,))
     with pytest.raises(lifecycle.ContainmentRefused, match="actor"):
         lifecycle.contain_local(board, target=target, resume_policy=spec, actor_task=relay,
                                 actor_run_uid=uid, summary="Fixture")
@@ -72,6 +77,7 @@ def test_foreign_containment_does_not_overwrite_human_or_terminal_custody(board,
     relay, _, authority, target, spec = helpers.setup(board)
     assert kb.block_task(board, relay, reason="Fixture release")
     kb.link_tasks(board, authority, relay)
+    board.execute("UPDATE tasks SET status='todo' WHERE id=?", (relay,))
     board.execute(f"UPDATE tasks SET {field}=? WHERE id=?", (value, relay))
     with pytest.raises(lifecycle.ContainmentRefused):
         lifecycle.contain_local(board, target=target, resume_policy=spec, actor_task=authority,
