From 0a88c47c8065571d70bad9cf304b07df25a671ea Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 27 Nov 2026 18:02:13 +0000
Subject: [PATCH 6838] PR-guard comment provenance and soft duplicate check handling

Public mirror of source commit 0a88c47c8065571d70bad9cf304b07df25a671ea.

---
diff --git a/tests/hermes_cli/test_kanban_pr_acceptance_duplicates.py b/tests/hermes_cli/test_kanban_pr_acceptance_duplicates.py
index 0dfeb1929ef8adefb477cc1ab0b06eb8ec9faf64..520ebe2f2ddcd6f92dc998958049e49933573c04 100644
--- a/tests/hermes_cli/test_kanban_pr_acceptance_duplicates.py
+++ b/tests/hermes_cli/test_kanban_pr_acceptance_duplicates.py
@@ -72,7 +72,7 @@
     assert {c["id"] for c in receipt["checks"]} == {success["id"], skipped["id"]}
 
 
-@pytest.mark.parametrize("fault", ["foreign_app", "stale", "pending", "post_merge", "missing_completion"])
+@pytest.mark.parametrize("fault", ["foreign_app", "stale", "pending", "post_merge"])
 def test_soft_conclusion_cannot_borrow_invalid_success(monkeypatch, fault):
     success = run(1, "success")
     if fault == "foreign_app":
@@ -81,14 +81,19 @@
         success["head_sha"] = "b" * 40
     elif fault == "pending":
         success["status"] = "in_progress"
-    elif fault == "missing_completion":
-        success["completed_at"] = None
     else:
         success.update(started_at="2099-01-01T16:00:00Z", completed_at="2099-01-01T16:01:00Z")
     receipt = collect(monkeypatch, [success, run(2, "skipped")], app=None)
     assert not receipt["ok"], receipt
 
 
+def test_merged_soft_run_cannot_borrow_success_without_completion(monkeypatch):
+    success = {**run(1, "success"), "completed_at": None}
+    receipt = collect(monkeypatch, [success, run(2, "skipped")])
+    assert receipt["classification"] == "infra", receipt
+    assert not receipt["ok"], receipt
+
+
 @pytest.mark.parametrize("conclusion", ["failure", "cancelled", "timed_out", "action_required", None])
 def test_merged_soft_run_never_resurrects_superseded_success(monkeypatch, conclusion):
     receipt = collect(monkeypatch, [run(1, "success"), run(2, conclusion), run(3, "skipped")])
-- 
