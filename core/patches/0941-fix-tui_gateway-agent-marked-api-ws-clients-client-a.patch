             "seeded": bool(history),  # gates _persist_branch_seed: only create-time history is unpersisted
             "cwd": session_cwd, "inflight_turn": None, "last_active": now,
@@ -422,7 +423,7 @@ def _create_session(rid, params: dict, *, copy_parent_history: bool = False) ->
             "create_reasoning_override": create_reasoning_override,
             "create_service_tier_override": create_service_tier_override,
             "parent_session_id": parent_session_id, "pending_title": _str_param(params, "title") or None,
-            "pending_hidden": create_hidden(params), "room_plumbing": _flag(params, "room_plumbing"),
+            "pending_hidden": create_hidden(params), "agent_created": agent_created, "room_plumbing": _flag(params, "room_plumbing"),
             "follow_profile_config": _flag(params, "follow_profile_config"),
             "profile_home": str(profile_home) if profile_home is not None else None,
             "running": False, "session_key": key, "show_reasoning": _load_show_reasoning(), "source": source,
diff --git a/tui_gateway/transport.py b/tui_gateway/transport.py
index 376a986c7a..5c37f2d847 100644
--- a/tui_gateway/transport.py
+++ b/tui_gateway/transport.py
@@ -79,6 +79,16 @@ def reset_transport(token) -> None:
     _current_transport.reset(token)
 
 
+#: ``/api/ws?client=agent`` marks a connection an agent script opened (gateway_rpc.py and kin), not a person's
+#: client. [daveey]
+AGENT_CLIENT_KIND = "agent"
+
+
+def is_agent_transport(transport: Optional[Transport]) -> bool:
+    """True when *transport* is a websocket an agent opened with the ``client=agent`` marker. [daveey]"""
+    return getattr(transport, "client_kind", None) == AGENT_CLIENT_KIND
+
+
 def _raise_unless_peer_gone(exc: Exception, what: str) -> None:
     """Return when *exc* from a stream write/flush means the peer is gone; re-raise anything else.
     ``False`` from :meth:`StdioTransport.write` is the dispatcher's "broken stdout pipe" signal (``entry.py``
diff --git a/tui_gateway/ws.py b/tui_gateway/ws.py
index cc4626135b..e94295c0ec 100644
--- a/tui_gateway/ws.py
+++ b/tui_gateway/ws.py
@@ -97,6 +97,10 @@ class WSTransport:
     def __init__(self, ws: Any, loop: asyncio.AbstractEventLoop, *, peer: str = "unknown",
                  auth_identity: dict | None = None, client_kind: str | None = None) -> None:
         self._ws = ws
+        #: ``/api/ws?client=<kind>`` as the client sent it (``"agent"`` for agent scripts, else None). Advisory, not an
+        #: auth fact: it only lets agent traffic opt OUT of the human-presence stamp (``human_input``) and defaults
+        #: its new chats to hidden. [daveey]
+        self.client_kind = client_kind
         self._loop = loop
         self._peer = peer
         #: Server-verified identity from the WS-upgrade credential, stamped by ``web_server_chat._ws_auth_reason``; None
@@ -304,6 +308,20 @@ def _disable_nagle(ws: Any) -> None:
         _log.debug("ws TCP_NODELAY skip: %s", exc)
 
 
+def _ws_client_kind(ws: Any) -> str | None:
+    """The upgrade request's ``client`` query marker (``?client=agent``), lower-cased; None when absent. [daveey]"""
+    from urllib.parse import parse_qs
+
+    scope = getattr(ws, "scope", None)
+    if isinstance(scope, dict):  # real ASGI websockets (a harness scope may lack query_string)
+        raw = scope.get("query_string") or b""
+        params = {k: v[0] for k, v in parse_qs(raw.decode("latin-1") if isinstance(raw, bytes) else str(raw)).items()}
+    else:
+        params = getattr(ws, "query_params", None) or {}
+    kind = str(params.get("client", "") or "").strip().lower()
+    return kind or None
+
+
 class _SendFailed(Exception):
     """Raised by handle_ws._reply when a reply could not be written: ends the read loop."""
 

