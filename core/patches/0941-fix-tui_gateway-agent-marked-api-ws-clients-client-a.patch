     now = time.time()
     with _sessions_lock:
         _sessions[sid] = {
@@ -414,7 +415,7 @@ def _create_session(rid, params: dict, *, copy_parent_history: bool = False) ->
             "close_on_disconnect": _flag(params, "close_on_disconnect"),
