From b96b102eb07e50ac41d1c1821f364b536a6ec03c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 00:31:19 +0000
Subject: [PATCH] [daveey] Key agent proof refusal on Desktop backend
 ownership, not inherited HERMES_DESKTOP

A Desktop chat's tool children inherit HERMES_DESKTOP=1 and now carry the
agent tool stamp, so a plain production 'hermes dashboard' they run (or an
update's dashboard respawn) was refused. The restart-proof shape is now
--isolated or a Desktop-owned backend shape (HERMES_DESKTOP=1 plus the
session token env or the SSH token-file argv), as is_desktop_owned_backend.
Drop the Python test that read Electron .ts source; vitest pins the keys.
---
 hermes_cli/proof_home.py                  | 29 ++++++++++++++++++-----
 tests/hermes_cli/test_serve_proof_home.py | 28 +++++++++++++---------
 2 files changed, 40 insertions(+), 17 deletions(-)

diff --git a/hermes_cli/proof_home.py b/hermes_cli/proof_home.py
index 42d182e917..085abfde17 100644
--- a/hermes_cli/proof_home.py
+++ b/hermes_cli/proof_home.py
@@ -8,8 +8,9 @@ background consumer imports, and re-checked in ``web_server`` before the server
 * ``hermes serve|dashboard --proof-home DIR`` (or ``HERMES_PROOF_HOME``) selects ``HERMES_HOME``.
   DIR must be an existing disposable directory: never the production root, ``<root>/profiles/*``
   or the launching agent's home (``HERMES_AGENT_HOME``), resolved through aliases and symlinks.
-* An agent-originated restart-proof shape (``--isolated`` or ``HERMES_DESKTOP=1``) on a
-  production home exits 2 with a safe recipe.
+* An agent-originated restart-proof shape (``--isolated``, or a Desktop-owned backend shape:
+  ``HERMES_DESKTOP=1`` plus its session token or SSH token-file argv) on a production home exits 2
+  with a safe recipe. An inherited ``HERMES_DESKTOP=1`` alone is not that shape.
 
 Agent origin is any stamp below. Tool spawners stamp it after their env scrubbing; the SSH terminal
 backend re-exports it remotely; the hub-admin forced command stamps every call. Stamps are
@@ -133,8 +134,24 @@ def requested_proof_home(flags: Sequence[str]) -> Optional[str]:
     return selected
 
 
-def _enforce_agent_shape(isolated: bool) -> None:
-    if agent_origin() and (isolated or os.environ.get("HERMES_DESKTOP") == "1"):
+def _desktop_backend_shape(argv: Sequence[str]) -> bool:
+    """Shaped like the backend Desktop owns, not merely run under an inherited ``HERMES_DESKTOP=1``.
+
+    Every Desktop chat's tool children inherit ``HERMES_DESKTOP=1``, so the flag alone would refuse a
+    plain ``hermes dashboard`` an agent runs. Mirrors ``process_identity.is_desktop_owned_backend``
+    (session-token env, or the SSH token-file argv), without its imports on the bootstrap path.
+    """
+    if os.environ.get("HERMES_DESKTOP") != "1":
+        return False
+    if os.environ.get("HERMES_DASHBOARD_SESSION_TOKEN", "") != "":
+        return True
+    from hermes_cli._startup_fast import is_desktop_ssh_backend_argv
+
+    return is_desktop_ssh_backend_argv(list(argv))
+
+
+def _enforce_agent_shape(isolated: bool, flags: Sequence[str]) -> None:
+    if agent_origin() and (isolated or _desktop_backend_shape(flags)):
         if _production_or_unknown(_current_home()):
             _refuse("an agent-launched restart-proof backend cannot use production recovery state")
 
@@ -151,7 +168,7 @@ def prepare_backend_argv(argv: Optional[Sequence[str]] = None) -> None:
     if selected is None:
         selected = os.environ.get(PROOF_HOME_ENV)
     if selected is None:
-        _enforce_agent_shape("--isolated" in flags)
+        _enforce_agent_shape("--isolated" in flags, flags)
         return
     if not selected.strip():
         _refuse("--proof-home is empty")
@@ -172,7 +189,7 @@ def assert_backend_home(*, isolated: bool, argv: Optional[Sequence[str]] = None)
     flagged = requested_proof_home(scanned[1]) if scanned else None
     selected = flagged if flagged is not None else os.environ.get(PROOF_HOME_ENV)
     if selected is None:
-        _enforce_agent_shape(isolated)
+        _enforce_agent_shape(isolated, scanned[1] if scanned else ())
         return
     home = validate_proof_home(selected)
     try:
diff --git a/tests/hermes_cli/test_serve_proof_home.py b/tests/hermes_cli/test_serve_proof_home.py
index 443710f824..e00a3cc0de 100644
--- a/tests/hermes_cli/test_serve_proof_home.py
+++ b/tests/hermes_cli/test_serve_proof_home.py
@@ -121,12 +121,25 @@ def test_wrapped_tool_origin_rejected_without_worker_vars(sentinel, wrapper):
     _assert_refused(result, sentinel, before)
 
 
-def test_desktop_env_without_isolated_still_rejected(sentinel):
+@pytest.mark.parametrize('extra,args', [
+    ({'HERMES_DESKTOP': '1', 'HERMES_DASHBOARD_SESSION_TOKEN': 'fixture-only'}, ['serve']),
+    ({'HERMES_DESKTOP': '1'}, ['serve', '--ssh-session-token-file', '/fixture/token']),
+])
+def test_desktop_backend_shape_without_isolated_still_rejected(sentinel, extra, args):
     before = _snapshot(sentinel)
-    result = _launch(sentinel, ['serve'], 'HERMES_AGENT_TOOL_CALL', extra={'HERMES_DESKTOP': '1'})
+    result = _launch(sentinel, args, 'HERMES_AGENT_TOOL_CALL', extra=extra)
     _assert_refused(result, sentinel, before)
 
 
+@pytest.mark.parametrize('args', [['dashboard', '--port', '0', '--no-open'], ['serve', '--port', '0']])
+def test_desktop_chat_tool_child_may_run_plain_backend(sentinel, args):
+    """A Desktop chat's tool children inherit HERMES_DESKTOP=1 (and never the session token):
+    that alone is not a Desktop-owned backend, so a plain production dashboard still starts."""
+    result = _launch(sentinel, args, 'HERMES_AGENT_TOOL_CALL', extra={'HERMES_DESKTOP': '1'})
+    assert result.returncode == 87, (result.stdout, result.stderr)
+    assert 'Refused proof backend' not in result.stderr
+
+
 def test_profile_alias_of_production_rejected(sentinel, tmp_path):
     (sentinel / 'profiles' / 'work').mkdir(parents=True)
     alias = tmp_path / 'work-alias'
@@ -341,15 +354,8 @@ def test_backend_launch_keeps_tool_stamps(monkeypatch):
     assert set(_PROVENANCE) <= set(os.environ)
 
 
-def test_electron_drops_the_same_provenance_stamps_at_startup():
-    import re
-
+def test_desktop_drop_list_is_the_provenance_stamps():
