-    assert set(re.findall(r"'([A-Z0-9_]+)'", m.group(1))) == set(PROVENANCE_KEYS)
-    main = (ROOT / 'apps/desktop/electron/main.ts').read_text()
-    assert re.search(r'dropAgentProvenance\(\)', main), 'main.ts must drop the stamps at startup'
