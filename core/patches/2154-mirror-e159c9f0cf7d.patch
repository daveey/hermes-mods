From e159c9f0cf7d1753a1af3e39eddb9f72d4fcb9fc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 00:35:50 +0000
Subject: [PATCH] fix(kanban): keep capable remote candidates when local
 profile is absent [daveey]

---
 hermes_cli/kanban_move.py                       | 10 +++++++---
 tests/hermes_cli/test_kanban_move_validation.py | 17 +++++++++++++++++
 2 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_move.py b/hermes_cli/kanban_move.py
index 821de1d6e81..565958d752a 100644
--- a/hermes_cli/kanban_move.py
+++ b/hermes_cli/kanban_move.py
@@ -93,9 +93,13 @@ def _requirement_matches(matches, machines, requires, skills, *, me=None, assign
         # The origin need not advertise worker-pickup labels. Read its actual profile rather than
         # rejecting a return home because the worker registry omits local checkout/skill inventory.
         from hermes_cli import kanban_capabilities as caps
-        available = {f"capability:{c}" for c in caps._profile_capabilities(assignee)}
-        with caps._profile_policy(assignee):
-            available.update(f"skill:{pin}" for pin in skills if caps._skill_frontmatter(pin) is not None)
+        available = set()
+        try:
+            available = {f"capability:{c}" for c in caps._profile_capabilities(assignee)}
+            with caps._profile_policy(assignee):
+                available.update(f"skill:{pin}" for pin in skills if caps._skill_frontmatter(pin) is not None)
+        except (OSError, ValueError):
+            available = set()  # unknown local inventory cannot veto a capable remote candidate
         lacking[me] = sorted(required - available)
     capable = [name for name in matches if not lacking[name]]
     if not capable:
diff --git a/tests/hermes_cli/test_kanban_move_validation.py b/tests/hermes_cli/test_kanban_move_validation.py
index ce4e3bfd361..c2168d0a36d 100644
--- a/tests/hermes_cli/test_kanban_move_validation.py
+++ b/tests/hermes_cli/test_kanban_move_validation.py
@@ -126,3 +126,20 @@ def test_queued_return_uses_local_inventory_not_worker_labels(gws, monkeypatch,
     result = km.move_queued(hub.conn, tid, runs_on=['machine:hub'], reason='return home',
                             machines={'hub': {'state': 'active'}}, me='hub')
     assert result['ok'] is (missing is None), result
+
+
+@pytest.mark.parametrize('remote', [False, True])
+def test_missing_local_profile_does_not_veto_capable_remote(gws, monkeypatch, remote):
+    hub, _ = gws
+    tid = _card(hub, requires=['host_repo'], skills=['plan'])
+    hub.conn.execute("UPDATE tasks SET assignee = 'remote-only' WHERE id = ?", (tid,))
+    machines = {'hub': {'state': 'active', 'labels': ['linux']}}
+    if remote:
+        machines.update(_machines('linux', 'capability:host_repo', 'skill:plan'))
+    result = km.move_queued(hub.conn, tid, runs_on=['linux'], reason='remote profile',
+                            machines=machines, me='hub')
+    assert result['ok'] is remote, result
+    if remote:
+        assert result['matches'] == ['worker-1']
+    else:
+        assert result['reason_code'] == 'capability_mismatch'
-- 
2.55.0

