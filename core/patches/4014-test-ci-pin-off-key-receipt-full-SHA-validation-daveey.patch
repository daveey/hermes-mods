From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 01:58:23 +0000
Subject: [PATCH] test(ci): pin off-key receipt full SHA validation [daveey]

Match malformed caller SHA and receipt metadata so equality cannot hide the entry guard. Cover short, long, uppercase, nonhex and trailing-newline values with a valid full lowercase control.

Proof: canonical three-file upstream-sync suite GREEN 97 passed; exact full-SHA guard mutant RED 5 failed / 92 passed (only new malformed cases), zero skips. scripts/check --base origin/main: 20 checks ok. Production unchanged.
---
 .../ci/test_upstream_sync_offkey_review.py       | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/tests/scripts/ci/test_upstream_sync_offkey_review.py b/tests/scripts/ci/test_upstream_sync_offkey_review.py
index 53762f2e23..c4b6522aa2 100644
--- a/tests/scripts/ci/test_upstream_sync_offkey_review.py
+++ b/tests/scripts/ci/test_upstream_sync_offkey_review.py
@@ -76,6 +76,22 @@ def test_offkey_full_sha_and_replica_dedup(tmp_path):
     assert review.off_key_review_cards(mod, "example/fork", 7, SHA) == []
 
 
+@pytest.mark.parametrize("sha, expected", [
+    pytest.param(SHA, [CARD], id="full-lowercase-control"),
+    pytest.param(SHA[:10], [], id="short"),
+    pytest.param(SHA + "a", [], id="long"),
+    pytest.param(SHA.upper(), [], id="uppercase"),
+    pytest.param("g" * 40, [], id="nonhex"),
+    pytest.param(SHA + "\n", [], id="trailing-newline"),
+])
+def test_offkey_sha_shape_with_matching_receipt(tmp_path, sha, expected):
+    # Match both sides so receipt equality cannot mask a missing caller-shape guard.
+    mod = board(tmp_path / "board.db", metadata={
+        "verdict": "approve", "reviewed_sha": sha, "reviewed_pr": URL,
+    })
+    assert review.off_key_review_cards(mod, "example/fork", 7, sha) == expected
+
+
 def test_offkey_discovery_is_not_approval_and_preserves_impl_identity(land_stub, tmp_path):
     board(tmp_path / "land-state.db")
     checker = review.ShipReview(tmp_path, impl_task="t_implementer")
