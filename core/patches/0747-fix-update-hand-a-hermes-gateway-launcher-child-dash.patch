     pid_cmdline: dict[int, list[str]] = {}
     pid_home: dict[int, str | None] = {}
+    pid_launcher: dict[int, tuple[int, tuple[str, ...]]] = {}
     # macOS: a backend supervised by a launchd job (LaunchAgent / LaunchDaemon) must come back
     # through launchd, never as a detached argv respawn — the respawn holds the job's port, the
     # job then fails every KeepAlive restart with "port already in use", and the running backend
@@ -661,7 +662,11 @@ def _kill_stale_dashboard_processes(
             if pid_service[pid]:
                 continue
             cmdline = _dash._dashboard_cmdline_for_pid(pid)
-            if job := _launchd_owner(pid, cmdline):
+            if supervisor := _launcher_supervisor(pid):
+                # [daveey] Checked before launchd: the job's live pid is the LAUNCHER, so a fresh launchd
+                # pid proves nothing about the backend, and an argv replay races the launcher's own child.
+                pid_launcher[pid] = supervisor
+            elif job := _launchd_owner(pid, cmdline):
                 pid_launchd[pid] = job
             elif cmdline:
                 # Manual process: exact argv + HERMES_HOME for the respawn and its profile cap.
@@ -689,7 +694,8 @@ def _kill_stale_dashboard_processes(
         print(f"    ✗ failed to stop PID {pid}: {err_msg}")
     if killed and restart_managed:
         unrecovered = _restart_killed_backends(
-            killed, pid_service, pid_cgroup, pid_cmdline, pid_home, pid_launchd=pid_launchd)
+            killed, pid_service, pid_cgroup, pid_cmdline, pid_home, pid_launchd=pid_launchd,
+            pid_launcher=pid_launcher)
     else:
         unrecovered = list(killed)
         # A stopped launchd job with KeepAlive restarts itself: say so instead of a misleading
@@ -706,8 +712,10 @@ def _kill_stale_dashboard_processes(
 def _restart_killed_backends(
     killed: list[int], pid_service: dict[int, str | None], pid_cgroup: dict[int, str | None],
     pid_cmdline: dict[int, list[str]], pid_home: dict[int, str | None], *,
-    pid_launchd: dict[int, tuple[str, str, int | None]] | None = None) -> list[int]:
-    """Update path: restart systemd units, kickstart launchd jobs (macOS), respawn manual argv
+    pid_launchd: dict[int, tuple[str, str, int | None]] | None = None,
+    pid_launcher: dict[int, tuple[int, tuple[str, ...]]] | None = None) -> list[int]:
+    """Update path: restart systemd units, kickstart launchd jobs (macOS), wait for a
+    ``hermes-gateway-launcher``'s successor child, respawn manual argv
     (detached, headless, logged to logs/dashboard-restart.log; one per profile, no ``--port 0``).
     Returns PIDs not brought back."""
     # Two categories: Without this, a remote backend (hermes serve) under Restart=on-failure never comes
@@ -719,10 +727,15 @@ def _restart_killed_backends(
     failed_restarts: list[tuple[str, str]] = []
     seen_services: set[str] = set()
     respawn_candidates: list[tuple[int, list[str], str | None]] = []
+    launcher_waits: dict[tuple[str, ...], list[int]] = {}
     for pid in killed:
         svc_name = pid_service.get(pid)
         launchd_job = (pid_launchd or {}).get(pid)
-        if svc_name:
+        if supervisor := (pid_launcher or {}).get(pid):
+            # [daveey] The launcher brings its child back (it exits with the child; launchd KeepAlive
+            # restarts it and it spawns a fresh child from the updated checkout). Never argv-respawn.
+            launcher_waits.setdefault(supervisor[1], []).append(pid)
+        elif svc_name:
             if svc_name in seen_services:
                 continue
             seen_services.add(svc_name)
@@ -753,6 +766,8 @@ def _restart_killed_backends(
             respawn_candidates.append((pid, pid_cmdline[pid], pid_home.get(pid)))
         else:
             unrecovered.append(pid)
+    if launcher_waits:
+        unrecovered.extend(_await_launcher_successors(launcher_waits, set(killed)))
     for svc, err in failed_restarts:
         print(f"    ⚠ {svc}: {err}")
     respawn_cmds = _filter_dashboard_respawn_candidates(respawn_candidates)
@@ -764,6 +779,98 @@ def _restart_killed_backends(
     return unrecovered
 
 
+# [daveey] Backends supervised by the core-update launcher (hermes-sync ``hermes-gateway-launcher``,
+# docs/core-update-safety.md). A launchd plist runs ``hermes-gateway-launcher --home H -- <cmd>``; the
+# launcher spawns <cmd> (e.g. ``redde-serve``, which execs ``hermes dashboard --port 9119``) and exits
+# with it, and KeepAlive restarts the launcher, which spawns a fresh child. Neither launchd lookup sees
+# the backend (the plist's ProgramArguments is the launcher; the child's XPC_SERVICE_NAME is ``0``), so
+# an unfenced ``hermes update`` replayed its argv detached on the job's port while the launcher brought
+# its own child up: EADDRINUSE or a duplicate, unsupervised backend (David-MBP 2026-10-28).
+# Successor wait: launchd ThrottleInterval (redde-serve: 15 s) + the launcher's 2 s lock poll + startup.
+_LAUNCHER_SUCCESSOR_TIMEOUT_SECONDS = 60.0
+_LAUNCHER_SUCCESSOR_POLL_SECONDS = 1.0
+_WRAPPER_SHELLS = frozenset({"sh", "bash", "zsh", "dash", "ksh"})
+
+
+def _launcher_argv_tail(argv: list[str] | None) -> tuple[str, ...] | None:
+    """The supervised command (argv after ``--``) when *argv* runs ``hermes-gateway-launcher``, else None."""
+    from hermes_cli.gateway_launchd import GATEWAY_LAUNCHER_NAME
+    if not argv or "--" not in argv:
+        return None
+    split = argv.index("--")
+    if not any(os.path.basename(arg) == GATEWAY_LAUNCHER_NAME for arg in argv[:min(split, 3)]):
+        return None
+    return tuple(argv[split + 1:]) or None
+
+
+def _launcher_supervisor(pid: int) -> tuple[int, tuple[str, ...]] | None:
+    """``(launcher_pid, supervised_cmd)`` when *pid*'s death makes a live launcher exit and respawn it:
+    the launcher is its parent, or is reached through exec-less wrapper shells only. A backend some
+    other long-lived process spawned under a launcher-supervised tree (a gateway's child) is not
+    respawned by the launcher, so it is not claimed here."""
+    if sys.platform == "win32":
+        return None
+    from hermes_cli import main_dashboard as _dash
+    for ancestor in _process_ancestors(pid):
+        argv = _dash._dashboard_cmdline_for_pid(ancestor)
+        if tail := _launcher_argv_tail(argv):
+            return (ancestor, tail)
+        if not argv or os.path.basename(argv[0]).lstrip("-") not in _WRAPPER_SHELLS:
+            return None
+    return None
+
+
+def _launcher_children(tail: tuple[str, ...]) -> list[int]:
+    """Live children of every ``hermes-gateway-launcher`` process supervising *tail*."""
+    from hermes_cli import main_dashboard as _dash
+    from hermes_cli.gateway_launchd import GATEWAY_LAUNCHER_NAME
+    try:
+        result = subprocess.run(["ps", "-A", "-o", "pid=,ppid=,command="], timeout=10, **_PS_RUN_KWARGS,
+                                check=False)
+    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
+        return []
+    rows: list[tuple[int, int, str]] = []
+    for line in (result.stdout or "").splitlines():
+        parts = line.split(None, 2)
+        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
+            rows.append((int(parts[0]), int(parts[1]), parts[2]))
+    launchers = {pid for pid, _ppid, command in rows if GATEWAY_LAUNCHER_NAME in command
+                 and _launcher_argv_tail(_dash._dashboard_cmdline_for_pid(pid)) == tail}
+    return [pid for pid, ppid, _command in rows if ppid in launchers]
+
+
+def _await_launcher_successors(waits: dict[tuple[str, ...], list[int]], stopped: set[int]) -> list[int]:
+    """Wait (bounded) until each launcher-supervised command has a fresh child; return the stopped
+    PIDs whose command never came back. Inside a core-update fence held by an ancestor of this
+    update every launcher is parked until the fence owner releases it after this process exits, so
+    nothing can come back yet: recovery is the fence owner's to verify, not a failure here."""
+    import time as _time
+
+    from hermes_cli.update_gateway_fence import ancestor_fence_owner
+    if (owner := ancestor_fence_owner()) is not None:
+        for tail in waits:
+            print(f"    ⏸ {os.path.basename(tail[0])}: hermes-gateway-launcher restarts it when the "
+                  f"core-update fence (pid {owner}) is released")
+        return []
+    pending = dict(waits)
+    deadline = _time.monotonic() + _LAUNCHER_SUCCESSOR_TIMEOUT_SECONDS
+    while True:
+        for tail in list(pending):
+            fresh = [pid for pid in _launcher_children(tail) if pid not in stopped]
+            if fresh:
+                print(f"    ✓ hermes-gateway-launcher restarted {os.path.basename(tail[0])} (PID {fresh[0]})")
+                del pending[tail]
+        if not pending or _time.monotonic() >= deadline:
+            break
+        _time.sleep(_LAUNCHER_SUCCESSOR_POLL_SECONDS)
+    unrecovered: list[int] = []
+    for tail, pids in pending.items():
+        print(f"    ⚠ {os.path.basename(tail[0])}: hermes-gateway-launcher brought no fresh child up within "
+              f"{int(_LAUNCHER_SUCCESSOR_TIMEOUT_SECONDS)}s; check its launchd job (KeepAlive) and log")
+        unrecovered.extend(pids)
+    return unrecovered
+
+
 def _norm_exe(path) -> str:
     """Canonical lower-cased executable path for comparison."""
     try:
diff --git a/tests/hermes_cli/test_update_dashboard_launchd_wrapper.py b/tests/hermes_cli/test_update_dashboard_launchd_wrapper.py
index db4e34cfb2..646775dfa1 100644
--- a/tests/hermes_cli/test_update_dashboard_launchd_wrapper.py
+++ b/tests/hermes_cli/test_update_dashboard_launchd_wrapper.py
@@ -216,3 +216,144 @@ def test_killed_desktop_bootstrap_backend_is_never_respawned():
     # control: a fixed-port backend in the same shape is still replayed
     assert dashboard_procs._filter_dashboard_respawn_candidates(
         [(87774, _desktop_bootstrap("9119"), None)], own_home="/Users/me/.hermes") == [_desktop_bootstrap("9119")]
+
+
+# --- [daveey] backend supervised by hermes-gateway-launcher (David-MBP 2026-10-28 04:45 PDT) -----------
+# launchd job com.daveey.hermes-redde-serve runs ``hermes-gateway-launcher --home ~/.hermes --
+# ~/.hermes/bin/redde-serve``; redde-serve execs the dashboard, whose XPC_SERVICE_NAME is ``0`` and whose
+# plist ProgramArguments is the launcher. Neither launchd lookup claimed it, so an unfenced update replayed
+# its argv detached on :9119 while the launcher (exiting with its child, restarted by KeepAlive) brought its
+# own child up: EADDRINUSE or a duplicate unsupervised backend.
+
+_LAUNCHER_PID = 85469
+_BACKEND_PID = 87824
+_TAIL = ["/Users/me/.hermes/bin/redde-serve"]
+_LAUNCHER_ARGV = ["/opt/homebrew/bin/python3", "/Users/me/.hermes/bin/hermes-gateway-launcher",
+                  "--home", "/Users/me/.hermes", "--", *_TAIL]
+
+
+class _Clock:
+    def __init__(self):
+        self.now = 1000.0
+
+    def monotonic(self):
+        return self.now
+
+    def sleep(self, seconds):
+        self.now += max(float(seconds), 0.01)
+
+
+def _run_launcher_child_update(monkeypatch, successor_after, *, fence_owner=None, ancestors=None,
+                               parent_argv=None):
+    """Run the update stop/restart against a launcher-child backend. The launcher's successor child
+    (pid 99001 under a respawned launcher 99000) appears *successor_after* seconds after the kill, or
+    never when None. Returns (result, respawn mock, launchd restart mock, clock)."""
+    monkeypatch.setitem(sys.modules, "psutil", _fake_psutil(argv=ARGV, env={"XPC_SERVICE_NAME": "0"}))
+    clock = _Clock()
+    killed_at = {}
+    parent_argv = parent_argv or _LAUNCHER_ARGV
+    ancestors = ancestors if ancestors is not None else [_LAUNCHER_PID, 1]
+
+    def _cmdline(pid):
+        if pid == _BACKEND_PID:
+            return ARGV
+        if pid in (_LAUNCHER_PID, 99000):
+            return parent_argv if pid == _LAUNCHER_PID else _LAUNCHER_ARGV
+        return None
+
+    def _fake_kill(pid, sig):
+        killed_at.setdefault(pid, clock.now)
+        if sig == 0:
+            raise ProcessLookupError
+
+    def _children(tail):
+        assert tail == tuple(_TAIL)
+        start = killed_at.get(_BACKEND_PID)
+        if start is None:
+            return [_BACKEND_PID]
+        if successor_after is not None and clock.now - start >= successor_after:
+            return [99001]
+        return []
+
+    with patch.object(main_dashboard, "_restart_managed_dashboard_service", return_value=False), \
+         patch.object(main_dashboard, "_find_stale_dashboard_pids", return_value=[_BACKEND_PID]), \
+         patch.object(main_dashboard, "_get_pid_cgroup_path", return_value=None), \
+         patch.object(main_dashboard, "_get_systemd_service_for_pid", return_value=None), \
+         patch.object(main_dashboard, "_loaded_launchd_backend_jobs", return_value=[]), \
+         patch.object(main_dashboard, "_dashboard_cmdline_for_pid", side_effect=_cmdline), \
+         patch("hermes_cli.gateway._launchd_print_service_pid", return_value=(True, _LAUNCHER_PID)), \
+         patch.object(main_dashboard, "_restart_launchd_job", return_value=True) as restart, \
+         patch.object(main_dashboard, "_respawn_dashboard_processes", return_value=[]) as respawn, \
+         patch("hermes_cli.dashboard_procs._process_ancestors", return_value=ancestors), \
+         patch("hermes_cli.dashboard_procs._posix_descendants", return_value={}), \
+         patch("hermes_cli.dashboard_procs._hermes_home_for_pid", return_value=None), \
+         patch("hermes_cli.dashboard_procs._launcher_children", side_effect=_children, create=True), \
+         patch("hermes_cli.update_gateway_fence.ancestor_fence_owner", return_value=fence_owner), \
+         patch("os.kill", side_effect=_fake_kill), \
+         patch("time.monotonic", side_effect=clock.monotonic), \
+         patch("time.sleep", side_effect=clock.sleep):
+        result = dashboard_procs._kill_stale_dashboard_processes(restart_managed=True)
+    return result, respawn, restart, clock
+
+
+@pytest.mark.platforms("macos")
+def test_launcher_child_dashboard_is_not_respawned_and_recovers_on_successor(monkeypatch):
+    result, respawn, restart, _clock = _run_launcher_child_update(monkeypatch, successor_after=20)
+    respawn.assert_not_called()  # an argv replay would sit on :9119 beside the launcher's own child
+    restart.assert_not_called()
+    assert result["killed"] == [_BACKEND_PID] and result["unrecovered"] == []
+
+
+@pytest.mark.platforms("macos")
+def test_launcher_child_that_never_returns_stays_unrecovered(monkeypatch):
+    """Control: no successor child within the bounded wait is booked unrecovered (the update keeps
+    warning), still without an argv respawn."""
+    result, respawn, _restart, clock = _run_launcher_child_update(monkeypatch, successor_after=None)
+    respawn.assert_not_called()
+    assert result["unrecovered"] == [_BACKEND_PID]
+    assert clock.now - 1000.0 <= dashboard_procs._LAUNCHER_SUCCESSOR_TIMEOUT_SECONDS + 15  # bounded
+
+
+@pytest.mark.platforms("macos")
+def test_launcher_child_inside_ancestor_fence_is_deferred_not_waited(monkeypatch):
+    """Inside a core-update fence held by an ancestor every launcher is parked until this update exits:
+    don't wait for a successor that cannot come, and don't book it unrecovered."""
+    result, respawn, _restart, clock = _run_launcher_child_update(
+        monkeypatch, successor_after=None, fence_owner=4321)
+    respawn.assert_not_called()
+    assert result["unrecovered"] == []
+    assert clock.now - 1000.0 < 5  # no successor wait
+
+
+@pytest.mark.platforms("macos")
+def test_launcher_tree_backend_behind_a_non_shell_parent_is_not_claimed(monkeypatch):
+    """Control: a dashboard some long-lived process (a gateway) spawned under a launcher-supervised tree
+    does not make the launcher respawn anything, so it keeps the argv respawn."""
+    gateway_pid = 70000
+    gateway_argv = [_PY, "-I", "-c", "gateway run"]
+
+    def _ancestors_cmdline(pid):
+        return {gateway_pid: gateway_argv, _LAUNCHER_PID: _LAUNCHER_ARGV}.get(pid, ARGV)
+
+    with patch.object(main_dashboard, "_dashboard_cmdline_for_pid", side_effect=_ancestors_cmdline), \
+         patch("hermes_cli.dashboard_procs._process_ancestors", return_value=[gateway_pid, _LAUNCHER_PID, 1]):
+        assert dashboard_procs._launcher_supervisor(_BACKEND_PID) is None
+    # through an exec-less shell wrapper the launcher still owns it
+    with patch.object(main_dashboard, "_dashboard_cmdline_for_pid",
+                      side_effect=lambda pid: {gateway_pid: ["/bin/sh", "-c", "x"]}.get(pid, _LAUNCHER_ARGV)), \
+         patch("hermes_cli.dashboard_procs._process_ancestors", return_value=[gateway_pid, _LAUNCHER_PID, 1]):
+        assert dashboard_procs._launcher_supervisor(_BACKEND_PID) == (_LAUNCHER_PID, tuple(_TAIL))
+
+
+def test_launcher_children_reads_the_process_table(monkeypatch):
+    """``_launcher_children`` matches launchers by their exact supervised command and returns their kids."""
+    table = "\n".join([
+        f"  {_LAUNCHER_PID}     1 python3 /x/hermes-gateway-launcher --home /h -- {_TAIL[0]}",
+        f"  {_BACKEND_PID} {_LAUNCHER_PID} python3.14 -I -c dashboard",
+        "  500     1 python3 /x/hermes-gateway-launcher --home /h -- /x/gateway",
+        "  501   500 gateway",
+    ])
+    argv = {_LAUNCHER_PID: _LAUNCHER_ARGV, 500: [*_LAUNCHER_ARGV[:-1], "/x/gateway"]}
+    with patch("subprocess.run", return_value=types.SimpleNamespace(returncode=0, stdout=table)), \
+         patch.object(main_dashboard, "_dashboard_cmdline_for_pid", side_effect=argv.get):
+        assert dashboard_procs._launcher_children(tuple(_TAIL)) == [_BACKEND_PID]
