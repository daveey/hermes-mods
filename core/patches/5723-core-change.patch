From 5529f3b3b65b546b44131f4acd0c81ebcbad1acd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 09:48:18 +0000
Subject: [PATCH] test(ownership): keep transient custody doubles
 signature-correct [daveey]

Problem: PR4026 CI45008369222 failed four transient owner tests with
TypeError: unexpected keyword argument allow_takeover.
Why 1: lock-order correction explicitly passed allow_takeover=False.
Why 2: two queue-path test doubles still accepted positional arguments only.
Root (happened): changed helper contract was not reflected in its consumers.
Root (not caught): last focused sweep omitted test_transient_lease_owner.py,
even though it was part of this PR. Exact-head required CI caught the gap.
Recurrence: follow-up to the prelanding lock-order correction, not a live
red-card recurrence. CI failure reproduced locally before editing.
Countermeasure: update both local doubles with the real keyword signature
and assert queued custody checks cannot request takeover; preserve all
existing queue retention/one-dispatch assertions and the real-helper lock
test. Proof: 138 tests across all four transient/update queue files pass
with per-file retries disabled; full scripts/check run separately.
---
 tests/tui_gateway/test_transient_lease_owner.py | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_transient_lease_owner.py b/tests/tui_gateway/test_transient_lease_owner.py
index 8de3016490..40e2a558d1 100644
--- a/tests/tui_gateway/test_transient_lease_owner.py
+++ b/tests/tui_gateway/test_transient_lease_owner.py
@@ -69,7 +69,12 @@ def test_real_submit_keeps_queue_until_holder_clears(held, monkeypatch, cause):
     refusal = active_sessions.ActiveSessionRefusal('owned', 'SESSION_NOT_OWNED')
     refusal.ownership_cause = cause
     state = [refusal]
-    monkeypatch.setattr(server, '_ensure_active_session_slot', lambda *a: state[0])
+    def slot(*args, allow_takeover=True):
+        if held.session.get('queued_prompt'):
+            assert allow_takeover is False
+        return state[0]
+
+    monkeypatch.setattr(server, '_ensure_active_session_slot', slot)
     reply = queue_tests._submit()
     assert reply['result']['status'] == 'queued'
     assert held.persisted == [('hello there', None)]
@@ -90,6 +95,11 @@ def test_drain_rechecks_fence_before_consuming_queue(admission, monkeypatch):
     admission.session.update(running=False, queued_prompt=head)
     admission.refusal = SimpleNamespace(reason='SESSION_NOT_OWNED', ownership_cause='lease_unknown')
     monkeypatch.setattr(server, '_session_turn_admission', lambda _: nullcontext(True))
+    def slot(*args, allow_takeover=True):
+        assert allow_takeover is False
+        return admission.refusal
+
+    monkeypatch.setattr(server, '_ensure_active_session_slot', slot)
     retries = []
     from tui_gateway import admission_retry
     monkeypatch.setattr(admission_retry, 'retry_queued_prompt', lambda *a: retries.append(a) or True)
