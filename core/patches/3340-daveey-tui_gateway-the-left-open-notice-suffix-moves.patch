From f01b5461cc892b7043fb3e12d7e84e68255d1b7c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 06:50:29 +0000
Subject: [PATCH] [daveey] tui_gateway: the left-open notice suffix moves to
 kanban_notice_text; the poller's lineage read is one helper
 (session_notifications line cap)

---
 tui_gateway/kanban_leg_custody.py    |  6 ++++++
 tui_gateway/kanban_notice_text.py    |  6 ++++++
 tui_gateway/session_notifications.py | 12 +++---------
 3 files changed, 15 insertions(+), 9 deletions(-)

diff --git a/tui_gateway/kanban_leg_custody.py b/tui_gateway/kanban_leg_custody.py
index 6d6f11b2f4..9b13246617 100644
--- a/tui_gateway/kanban_leg_custody.py
+++ b/tui_gateway/kanban_leg_custody.py
@@ -53,6 +53,12 @@ def _lineage(session: dict, session_lineage) -> tuple:
         return ()
 
 
+def chat_lineage(session_key: str, session_lineage) -> tuple:
+    """The chat and its compaction parents (``sibling_chats`` for its tui rows): its ``local`` rows sit on the
+    lineage root. An unreadable lineage leaves the chat's own id."""
+    return (session_key, *_lineage({"session_key": session_key}, session_lineage))
+
+
 def legacy_gateway_owns(session: dict, ledger_refusal, session_lineage, session_db) -> bool:
     """:func:`gateway_owns` for a legacy backend's session: its compaction parents (``session_lineage``) and the
     turn-lease holder read through the session's own store (``session_db``)."""
diff --git a/tui_gateway/kanban_notice_text.py b/tui_gateway/kanban_notice_text.py
index 92973a0295..dc60b61f26 100644
--- a/tui_gateway/kanban_notice_text.py
+++ b/tui_gateway/kanban_notice_text.py
@@ -23,6 +23,12 @@ def timed_out_suffix(task, payload: dict, title: str) -> str:
     return f" timed out (max_runtime={limit}s){tail}"
 
 
+def left_open_suffix(payload: dict) -> str:
+    from hermes_cli.kanban_pr_landing import left_open_notice
+    notice = left_open_notice(payload)
+    return f"\n{notice}" if notice else ""
+
+
 def quota_episode_suffix(payload: dict) -> str:
     from hermes_cli.kanban_quota_episode import notice_text
     return notice_text(payload)
diff --git a/tui_gateway/session_notifications.py b/tui_gateway/session_notifications.py
index 5b3457c4cd..25869fd765 100644
--- a/tui_gateway/session_notifications.py
+++ b/tui_gateway/session_notifications.py
@@ -12,6 +12,7 @@ from . import session_notifications_surface as _surface
 from .kanban_notice_text import chat_wait_suffix as _kb_chat_wait, failure_suffix as _kb_failure
 from .kanban_notice_text import parent_unclaimed_suffix as _kb_parent_unclaimed, quota_episode_suffix as _kb_quota_episode
 from .kanban_notice_text import repin_suffix as _kb_repin_notice, timed_out_suffix as _kb_timed_out
+from .kanban_notice_text import left_open_suffix as _kb_left_open
 
 
 def _notif_locked_sessions(fn, default):
@@ -592,12 +593,6 @@ def _kb_completed(task, payload: dict, title: str) -> str:
     return f" done — {title}{handoff}{_kb_left_open(payload)}"
 
 
-def _kb_left_open(payload: dict) -> str:
-    from hermes_cli.kanban_pr_landing import left_open_notice
-    notice = left_open_notice(payload)
-    return f"\n{notice}" if notice else ""
-
-
 # kind -> (glyph, suffix after "Kanban <id>"); silent kinds (archived/unblocked) are absent → None.
 _KANBAN_EVENT_FORMATTERS = {
     "request_withdrawn": ("ℹ", lambda t, p, title: " request withdrawn: the card was archived. "
@@ -754,9 +749,8 @@ def _kb_poll_board_now(_kb, _kbc, _kbn, slug: str, session_key: str, claims: lis
     except Exception:
         return []
     texts: list = []
-    chats: tuple = (session_key,)
-    with contextlib.suppress(Exception):  # the chat's compaction parents: its local rows may sit on the root
-        chats = (session_key, *_session_lineage(session_key))
+    from tui_gateway.kanban_leg_custody import chat_lineage
+    chats = chat_lineage(session_key, _session_lineage)  # its local rows may sit on the lineage root
     with contextlib.closing(conn):
         try:
             subs = _kbn.list_notify_subs(conn, platform="tui", chat_id=session_key)
-- 
2.51.0

