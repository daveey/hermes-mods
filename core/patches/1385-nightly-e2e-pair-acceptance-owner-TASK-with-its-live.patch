From 8092734fd79e1f0265ebf1aecff988d169ab94c3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 02:41:36 +0000
Subject: [PATCH] nightly e2e: pair acceptance owner TASK with its live RUN_ID
 so the CLI keeps the attribution

---
 scripts/ci/flaky_kanban.py   |  2 +-
 scripts/ci/nightly_e2e.py    | 11 ++++++++++-
 tests/ci/test_nightly_e2e.py | 13 ++++++++++---
 3 files changed, 21 insertions(+), 5 deletions(-)

diff --git a/scripts/ci/flaky_kanban.py b/scripts/ci/flaky_kanban.py
index 1fcd4275a81..5f22569c3b2 100644
--- a/scripts/ci/flaky_kanban.py
+++ b/scripts/ci/flaky_kanban.py
@@ -89,7 +89,7 @@ class CliBoard:
         env = {**os.environ, **extra_env} if extra_env else None
         if args[:1] == ("create",) and not (extra_env and "HERMES_KANBAN_TASK" in extra_env):
             # A production create must not inherit a running worker's task as creator_task_id.
-            env = {k: v for k, v in (env or os.environ).items() if k != "HERMES_KANBAN_TASK"}
+            env = {k: v for k, v in (env or os.environ).items() if k not in ("HERMES_KANBAN_TASK", "HERMES_KANBAN_RUN_ID")}
         proc = subprocess.run([*self.hermes, "kanban", *scope, *args], input=stdin, capture_output=True,
                               text=True, timeout=120, check=False, env=env)
         if proc.returncode == 2 and args[0] == "create":
diff --git a/scripts/ci/nightly_e2e.py b/scripts/ci/nightly_e2e.py
index 06c937b095f..502a66fd8e7 100644
--- a/scripts/ci/nightly_e2e.py
+++ b/scripts/ci/nightly_e2e.py
@@ -179,7 +179,16 @@ class NightlyBoard(CliBoard):
             ]
         # `hermes kanban create` records creator_task_id from HERMES_KANBAN_TASK (the supported attribution path).
         # Only an explicit acceptance run sets it; production cards keep creator_task_id None.
-        extra_env = {"HERMES_KANBAN_TASK": creator_task_id} if creator_task_id else None
+        # The CLI drops a TASK identity that has no live RUN_ID, so pair them from the owner's live run.
+        extra_env = None
+        if creator_task_id:
+            live = [
+                r for r in ((self._show(creator_task_id) or {}).get("runs") or [])
+                if r.get("status") == "running" and not r.get("ended_at")
+            ]
+            if not live:
+                raise RuntimeError(f"acceptance owner {creator_task_id} has no live run to attribute cards to")
+            extra_env = {"HERMES_KANBAN_TASK": creator_task_id, "HERMES_KANBAN_RUN_ID": str(live[-1]["id"])}
         out = self._run(
             "create",
             title,
diff --git a/tests/ci/test_nightly_e2e.py b/tests/ci/test_nightly_e2e.py
index f55644998e4..694b0d1ef7b 100644
--- a/tests/ci/test_nightly_e2e.py
+++ b/tests/ci/test_nightly_e2e.py
@@ -582,9 +582,14 @@ def test_nightly_board_stamps_creator_only_for_acceptance(monkeypatch):
     envs = []
     board = ne.NightlyBoard("hermes")
     monkeypatch.setattr(board, "_run", lambda *a, **k: envs.append(k.get("extra_env")) or '{"id":"t_x"}')
+    live = {"runs": [{"id": 6, "status": "ended", "ended_at": 1}, {"id": 7, "status": "running", "ended_at": None}]}
+    monkeypatch.setattr(board, "_show", lambda *a, **k: live)
     board.create("t", "b", "k")
     board.create("t", "b", "k", creator_task_id=OWNER)
-    assert envs == [None, {"HERMES_KANBAN_TASK": OWNER}]
+    assert envs == [None, {"HERMES_KANBAN_TASK": OWNER, "HERMES_KANBAN_RUN_ID": "7"}]
+    live["runs"].pop()
+    with pytest.raises(RuntimeError, match="no live run"):
+        board.create("t", "b", "k", creator_task_id=OWNER)
 
 
 def test_cli_create_env_only_carries_worker_task_in_acceptance(monkeypatch):
@@ -595,9 +600,11 @@ def test_cli_create_env_only_carries_worker_task_in_acceptance(monkeypatch):
         return subprocess.CompletedProcess(cmd, 0, '{"id":"t_x"}', "")
 
     monkeypatch.setenv("HERMES_KANBAN_TASK", "t_ffffffffffffffff")
+    monkeypatch.setenv("HERMES_KANBAN_RUN_ID", "99")
     monkeypatch.setattr(subprocess, "run", fake_run)
     board = ne.NightlyBoard("hermes")
+    monkeypatch.setattr(board, "_show", lambda *a, **k: {"runs": [{"id": 7, "status": "running", "ended_at": None}]})
     board.create("t", "b", "k")
     board.create("t", "b", "k", creator_task_id=OWNER)
-    assert "HERMES_KANBAN_TASK" not in seen[0]
-    assert seen[1]["HERMES_KANBAN_TASK"] == OWNER
+    assert "HERMES_KANBAN_TASK" not in seen[0] and "HERMES_KANBAN_RUN_ID" not in seen[0]
+    assert seen[1]["HERMES_KANBAN_TASK"] == OWNER and seen[1]["HERMES_KANBAN_RUN_ID"] == "7"
-- 
