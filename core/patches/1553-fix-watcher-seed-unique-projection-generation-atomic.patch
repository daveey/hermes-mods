 .../test_session_projection_revision.py       | 66 +++++++++++++++++--
 3 files changed, 112 insertions(+), 13 deletions(-)

diff --git a/hermes_state_projection.py b/hermes_state_projection.py
index 1140d3656a1..1f69acfe796 100644
--- a/hermes_state_projection.py
+++ b/hermes_state_projection.py
@@ -29,17 +29,29 @@ SESSION_PROJECTION_SQL = "\n".join(
 )
 
 
-def session_projection_revision(conn):
-    """Return a revision only when all current triggers are installed.
+# Installation and replacement of the triggers seed a fresh generation in the
+# same write transaction, so stores upgraded without later session writes never
+# share a value. Settled opens skip installation and therefore write nothing.
+SEED_SESSION_PROJECTION_SQL = _CHANGE_SQL
 
-    An absent counter means zero on first installation, not missing capability.
-    The caller holds a read transaction across capability and counter probes.
-    """
+
+def session_projection_installed(conn) -> bool:
+    """True when all three projection triggers exist with the current bodies."""
     names = tuple(SESSION_PROJECTION_TRIGGERS)
     rows = conn.execute(
         "SELECT name, sql FROM sqlite_master WHERE type='trigger' AND name IN (?, ?, ?)", names,
     ).fetchall()
-    if dict(rows) != SESSION_PROJECTION_TRIGGERS:
+    return dict(rows) == SESSION_PROJECTION_TRIGGERS
+
+
+def session_projection_revision(conn):
+    """Return the generation only when all current triggers and a generation exist.
+
+    A missing generation is unavailable capability (None), never a shared zero:
+    two stores without one cannot be told apart. The caller holds a read
+    transaction across capability and generation probes.
+    """
+    if not session_projection_installed(conn):
         return None
     row = conn.execute("SELECT value FROM state_meta WHERE key='sessions_change_seq'").fetchone()
-    return row[0] if row else 0
+    return row[0] if row else None
diff --git a/hermes_state_schema.py b/hermes_state_schema.py
index dfc16027f74..a56313c6e0a 100644
--- a/hermes_state_schema.py
+++ b/hermes_state_schema.py
@@ -336,6 +336,36 @@ class SessionSchemaMixin:
         if statement.strip():
             raise sqlite3.OperationalError("incomplete DDL statement")
 
+    @staticmethod
+    def _ensure_session_projection(cursor: sqlite3.Cursor) -> None:
+        """Install/replace the session projection triggers and seed a fresh random generation
+        in ONE write transaction; a settled store is detected by a read probe and not written.
+
+        Seeding only here (never per open or on a timer) keeps settled opens lock-free while
+        guaranteeing every installed store carries a generation unique to it, so an in-place
+        restore of another upgraded store is visible even before any session write. The probe
+        is repeated under BEGIN IMMEDIATE so a sibling that installed first is not reseeded.
+        """
+        from hermes_state_projection import (
+            SEED_SESSION_PROJECTION_SQL, SESSION_PROJECTION_SQL, session_projection_installed,
+        )
+
+        if session_projection_installed(cursor):
+            return
+        owns = not cursor.connection.in_transaction
+        if owns:
+            cursor.execute("BEGIN IMMEDIATE")
+        try:
+            if not session_projection_installed(cursor):
+                SessionSchemaMixin._execute_ddl_skipping_settled_triggers(cursor, SESSION_PROJECTION_SQL)
+                cursor.execute(SEED_SESSION_PROJECTION_SQL)
+        except BaseException:
+            if owns:
+                cursor.execute("ROLLBACK")
+            raise
+        if owns:
+            cursor.execute("COMMIT")
+
     @staticmethod
     def _execute_ddl_script_transactional(cursor: sqlite3.Cursor, ddl: str) -> None:
         """Execute a DDL script without ``executescript``'s implicit commit."""
@@ -980,8 +1010,7 @@ class SessionSchemaMixin:
         except sqlite3.OperationalError as exc:
             logger.debug("idx_messages_platform_msg_id create skipped: %s", exc)
         self._execute_ddl_skipping_settled_triggers(cursor, DEFERRED_INDEX_SQL)  # same ordering constraint (``active``)
-        from hermes_state_projection import SESSION_PROJECTION_SQL
-        self._execute_ddl_skipping_settled_triggers(cursor, SESSION_PROJECTION_SQL)
+        self._ensure_session_projection(cursor)
 
         # Heal NULL ``active`` rows on every startup: older reconciler builds added ``active``
         # without NOT NULL DEFAULT 1, so ``WHERE active = 1`` loaders hid whole histories. A
