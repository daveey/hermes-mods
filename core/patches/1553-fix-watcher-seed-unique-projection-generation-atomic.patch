@@ -193,13 +194,70 @@ def test_upgrade_populated_store_without_counter(store):
     upgraded.close()
     before = server._session_db_content_sig(path)
     assert before[0] == "revision"
-    assert before[-1] == 0
+    assert before[-1] not in (None, 0)
     with sqlite3.connect(path) as writer:
