From b398342d11cdbaf691e499ca39604c5d735cdd71 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 09:43:30 +0000
Subject: [PATCH] [daveey] kanban provenance: reads_local_store resolves
 local_gateway=None like scoped_sources

reads_local_store(local_gateway=None) treated None as an unnamed host while scoped_sources resolved it to
gateway_names()[0], so the parity pinned by test_reads_local_store_is_exactly_when_scoped_sources_reads held only
for explicit names. scoped_sources, prefetch_sources and reads_local_store now share one resolver
(_resolve_local), and the parity test also runs local_gateway=None on a named host (6 cases RED before).
No live impact: both callers pass an explicit name. PR #2044 review nit; t_01a1d44128e287b9.
---
 hermes_cli/kanban_session_provenance.py       | 23 ++++++++++++-------
 .../test_kanban_chat_links_bulk_provenance.py | 10 ++++----
 2 files changed, 21 insertions(+), 12 deletions(-)

diff --git a/hermes_cli/kanban_session_provenance.py b/hermes_cli/kanban_session_provenance.py
index 711c4419d1..19dff12643 100644
--- a/hermes_cli/kanban_session_provenance.py
+++ b/hermes_cli/kanban_session_provenance.py
@@ -103,10 +103,18 @@ def _local_scope(gateway: Any, profile: Any, ref: str, me: Any) -> Optional[tupl
     return prof, sid
 
 
+def _resolve_local(local_gateway: Any) -> Any:
+    """This host's gateway name when ``local_gateway`` is None, else ``local_gateway`` unchanged ("" = unnamed host).
+    The one rule every local-scope check here resolves None by, so their answers agree for the same call. [daveey]"""
+    if local_gateway is not None:
+        return local_gateway
+    from hermes_cli.kanban_origin import gateway_names
+    return gateway_names()[0]
+
+
 def scoped_sources(gateway: Any, sessions: Iterable[Any], *, local_gateway=None, profile=None) -> dict[str, Optional[str]]:
     """No network lookup: foreign/ambiguous provenance is unknown, never human proof."""
-    from hermes_cli.kanban_origin import gateway_names
-    me = local_gateway if local_gateway is not None else gateway_names()[0]
+    me = _resolve_local(local_gateway)
     grouped: dict[Optional[str], dict[str, str]] = {}
     out: dict[str, Optional[str]] = {str(s or ""): None for s in sessions}
     for ref in out:
@@ -127,8 +135,7 @@ def prefetch_sources(refs: Iterable[Any], *, local_gateway=None) -> None:
     filling the source cache so the classifications that follow in the same pass are cache hits, whatever profile
     they scope to. Verdicts are unchanged: an entry that expires before use only costs a read. A qualified ref of
     another gateway is skipped: :func:`scoped_sources` never looks it up locally. [daveey]"""
-    from hermes_cli.kanban_origin import gateway_names
-    me = local_gateway if local_gateway is not None else gateway_names()[0]
+    me = _resolve_local(local_gateway)
     sids = [p[-1] for r in dict.fromkeys(str(r or "") for r in refs)
             if (len(p := r.split("/")) == 1 or (len(p) == 3 and me and p[0] == me)) and p[-1]]
     if sids:
@@ -138,10 +145,10 @@ def prefetch_sources(refs: Iterable[Any], *, local_gateway=None) -> None:
 
 def reads_local_store(gateway: Any, session: Any, *, local_gateway: Any, profile: Any = None) -> bool:
     """Whether :func:`scoped_sources` (``local_gateway=local_gateway, profile=profile``) may open a state.db for
-    ``session`` scoped to ``gateway``. It shares that function's routing (:func:`_local_scope`), so a ref answered
-    unknown without a read (another gateway's, or a qualified ref whose outer gateway/profile contradicts the
-    scope) is never reported as a read. [daveey]"""
-    return _local_scope(gateway, profile, str(session or ""), local_gateway) is not None
+    ``session`` scoped to ``gateway``. It shares that function's routing (:func:`_local_scope`) and None
+    resolution (:func:`_resolve_local`), so a ref answered unknown without a read (another gateway's, or a
+    qualified ref whose outer gateway/profile contradicts the scope) is never reported as a read. [daveey]"""
+    return _local_scope(gateway, profile, str(session or ""), _resolve_local(local_gateway)) is not None
 
 
 def machine_verdicts(keys: Iterable[tuple[Any, Any, Any]], *, local_gateway) -> dict[tuple, bool]:
diff --git a/tests/hermes_cli/test_kanban_chat_links_bulk_provenance.py b/tests/hermes_cli/test_kanban_chat_links_bulk_provenance.py
index 1e50336463..a575b6a0c5 100644
--- a/tests/hermes_cli/test_kanban_chat_links_bulk_provenance.py
+++ b/tests/hermes_cli/test_kanban_chat_links_bulk_provenance.py
@@ -641,13 +641,15 @@ _SCOPE_REFS = [*MIXED, f"{GW}/research/{RCHAT}", f"away/research/{RCHAT}", f"{GW
                "", "x/y/z/w"]
 
 
-@pytest.mark.parametrize("local_gateway", [GW, ""])
+@pytest.mark.parametrize("local_gateway", [GW, "", None])
 @pytest.mark.parametrize("gateway", [None, GW, "away"])
 @pytest.mark.parametrize("profile", [None, "default", "research"])
 def test_reads_local_store_is_exactly_when_scoped_sources_reads(home, monkeypatch, local_gateway, gateway, profile):
     """t_01a1d41a82ced7d9 (PR #2013 review nit 2): ``reads_local_store`` answers the same rule as ``scoped_sources``,
     including a qualified ``gw/profile/sid`` ref whose outer gateway or profile contradicts the scope (answered
-    unknown without a read, so not reported as a read either)."""
+    unknown without a read, so not reported as a read either). ``local_gateway=None`` on this named host resolves
+    to its name in both (t_01a1d44128e287b9, PR #2044 review nit)."""
+    me = GW if local_gateway is None else local_gateway
     real = provenance._local_homes
     reads: list[Any] = []
 
@@ -662,7 +664,7 @@ def test_reads_local_store_is_exactly_when_scoped_sources_reads(home, monkeypatc
         claim = provenance.reads_local_store(gateway, ref, local_gateway=local_gateway, profile=profile)
         assert claim == bool(reads), (ref, claim, reads)
         parts = ref.split("/")
-        mismatched += len(parts) == 3 and parts[0] == local_gateway and (
+        mismatched += len(parts) == 3 and parts[0] == me and (
             (gateway is not None and gateway != parts[0]) or (profile is not None and profile != parts[1]))
-    if local_gateway and (gateway == "away" or profile is not None):
+    if me and (gateway == "away" or profile is not None):
         assert mismatched  # the corpus holds the over-approximated case for this scope
-- 
