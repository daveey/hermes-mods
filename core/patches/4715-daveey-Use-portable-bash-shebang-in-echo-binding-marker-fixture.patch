From 887ba8af2b4a05f6a36195392c3c0e1a01d57739 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 21:57:53 +0000
Subject: [PATCH] [daveey] Use portable bash shebang in echo binding marker
 fixture

---
 tests/cron/test_lifecycle_guard_echo_binding.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/cron/test_lifecycle_guard_echo_binding.py b/tests/cron/test_lifecycle_guard_echo_binding.py
index 3f2bbcb5e5fc397d3fb3f8216d484bc7e72490f6..7049ee30f32260fcb3e869305acaf6bbf313c73b 100644
--- a/tests/cron/test_lifecycle_guard_echo_binding.py
+++ b/tests/cron/test_lifecycle_guard_echo_binding.py
@@ -28,7 +28,7 @@ _DEFINITIONS = [
 def test_rebound_echo_real_shell_and_public_scanner(tmp_path, definition, producer):
     marker = tmp_path / "marker"
     payload = tmp_path / "payload"
-    payload.write_text("#!/bin/bash\nprintf reached > " + shlex.quote(str(marker)) + "\n", encoding="utf-8")
+    payload.write_text("#!/usr/bin/env bash\nprintf reached > " + shlex.quote(str(marker)) + "\n", encoding="utf-8")
     payload.chmod(0o700)
     definitions = tmp_path / "definitions"
     definitions.write_text('echo() { bash -c "$1"; }\n', encoding="utf-8")
-- 
