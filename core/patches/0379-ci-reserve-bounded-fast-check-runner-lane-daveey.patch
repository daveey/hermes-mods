+++ b/.github/actionlint.yaml
@@ -20,6 +20,7 @@ self-hosted-runner:
     - hermes-hub
     - docker-ci
     - hermes-hub-poll
+    - ci-fast
 
 # fork (daveey/hermes): known findings that are not bugs. The lint runs in
 # .github/workflows/actionlint.yml. Keep each pattern narrow.
diff --git a/.github/workflows/actionlint.yml b/.github/workflows/actionlint.yml
index 436a6df4732bf962fe60cdb12d0ff9005a6d261d..1fcd815490dc731a212d18c1ae129a47c53d9fa6 100644
--- a/.github/workflows/actionlint.yml
+++ b/.github/workflows/actionlint.yml
@@ -30,7 +30,7 @@ concurrency:
 jobs:
   actionlint:
