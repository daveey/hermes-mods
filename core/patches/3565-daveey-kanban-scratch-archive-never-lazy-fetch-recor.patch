@@ -147,10 +153,21 @@ def _find_repos(root: Path) -> tuple[list[Path], dict[str, list[int]]]:
 
 
 def _env(repo: Path) -> dict[str, str]:
-    from hermes_cli._subprocess_compat import noninteractive_repo_git_env
+    """Hardened, offline git env: archiving reads local objects only and never fetches.
+
+    A partial clone's missing objects would otherwise be lazily fetched from its
+    promisor remote (unbounded network, or a credential failure on workers). Git
+    >= 2.44 honours ``GIT_NO_LAZY_FETCH``; ``protocol.allow=never`` also fails
+    every transport on older git (2.43 on the pool workers) before it connects.
+    """
+    from hermes_cli._subprocess_compat import NO_LAZY_FETCH_ENV, noninteractive_repo_git_env
     env = noninteractive_repo_git_env(repo)
     if env is None:
         raise ArchiveRefused(f"cannot harden git for {repo} (filter discovery failed)")
+    count = int(env.get("GIT_CONFIG_COUNT") or 0)
+    env.update(NO_LAZY_FETCH_ENV)
+    env.update({f"GIT_CONFIG_KEY_{count}": "protocol.allow", f"GIT_CONFIG_VALUE_{count}": "never",
+                "GIT_CONFIG_COUNT": str(count + 1)})
     return env
 
 
@@ -169,6 +186,66 @@ def _text(proc: subprocess.CompletedProcess) -> str:
     return proc.stdout.decode("utf-8", "replace").strip()
 
 
+def _is_partial_clone(repo: Path, env: dict[str, str]) -> bool:
+    """Whether *repo* has a promisor remote (objects it may lack are promised, not lost)."""
+    proc = _git(repo, env, "config", "--get-regexp", r"^(remote\..*\.promisor|extensions\.partialclone)$",
+                ok=(0, 1))
+    return any(line.split()[-1].lower() not in ("false", "no", "off", "0")
+               for line in _text(proc).splitlines())
+
+
+def _raw_changes(repo: Path, env: dict[str, str], base: str) -> list[dict]:
+    """``git diff --raw`` of *base* against the worktree: reads no blob content, so it never fetches."""
+    out = _git(repo, env, "diff", "--raw", "-z", "--no-renames", "--no-abbrev", "--no-ext-diff", base).stdout
+    fields = out.split(b"\0")
+    changes = []
+    for info, path in zip(fields[0::2], fields[1::2]):
+        # ":<old mode> <new mode> <old oid> <new oid> <status>"; anything else raises ValueError (kept).
+        old_mode, _new_mode, old_oid, _new_oid, status = info[1:].decode("ascii").split()
+        changes.append({"status": status, "old_mode": old_mode, "old_oid": old_oid,
+                        "path": os.fsdecode(path)})
+    return changes
+
+
+def _missing_objects(repo: Path, env: dict[str, str]) -> set[str]:
+    """Objects of HEAD's tree absent locally (left on the promisor remote), listed without fetching."""
+    out = _text(_git(repo, env, "rev-list", "--objects", "--missing=print", "--no-walk", "HEAD"))
+    return {line[1:].split()[0] for line in out.splitlines() if line.startswith("?")}
+
+
+def _batches(paths: list[str], limit: int = 64 * 1024) -> list[list[str]]:
+    """Split *paths* into argv-sized batches (well under ARG_MAX)."""
+    out: list[list[str]] = []
+    size = limit
+    for path in paths:
+        if size + len(path) + 1 > limit:
+            out.append([])
+            size = 0
+        out[-1].append(path)
+        size += len(path) + 1
+    return out
+
+
+def _write_remote_base(repo: Path, dest: Path, entries: list[dict]) -> list[str]:
+    """Record paths whose HEAD blob only the promisor remote holds; keep their worktree side.
+
+    Their base is not local work (git promises it is on the remote), so it is not
+    fetched. Whatever the worktree holds at such a path is local and goes into
+    ``remote_base.tar`` (stored as is, symlinks never followed).
+    """
+    (dest / "remote_base.json").write_text(json.dumps({
+        "note": "HEAD-side blobs of these paths are only on the promisor remote; not fetched",
+        "entries": entries,
+    }, indent=1) + "\n", encoding="utf-8")
+    present = [e["path"] for e in entries if os.path.lexists(repo / e["path"])]
+    if not present:
+        return ["remote_base.json"]
+    with tarfile.open(dest / "remote_base.tar", "w") as tar:
+        for rel in present:
+            tar.add(str(repo / rel), arcname=rel, recursive=False)
+    return ["remote_base.json", "remote_base.tar"]
+
+
 def archive_repo(repo: Path, dest: Path, *, task_id: str, completed_at: Optional[int]) -> dict:
     """Write one repo's archive into *dest* (created). Raises on any failure."""
     env = _env(repo)
@@ -196,10 +273,26 @@ def archive_repo(repo: Path, dest: Path, *, task_id: str, completed_at: Optional
         files.append(bundle.name)
 
     base = head or _text(_git(repo, env, "hash-object", "-t", "tree", "--stdin"))
-    diff = _git(repo, env, "diff", "--binary", "--no-ext-diff", "--no-textconv", "--no-color", base).stdout
+    changes = _raw_changes(repo, env, base) if head and _is_partial_clone(repo, env) else []
+    missing = _missing_objects(repo, env) if changes else set()
+    remote_base = [c for c in changes if c["old_oid"] in missing]
+    diff_args = ["diff", "--binary", "--no-ext-diff", "--no-textconv", "--no-color", base]
+    if not remote_base:
+        diff = _git(repo, env, *diff_args).stdout
+    else:
+        # Only paths whose base blob is local, literal pathspecs in bounded batches (no renames
+        # across batches); the rest are recorded below, never fetched.
+        keep = [c["path"] for c in changes if c["old_oid"] not in missing]
+        literal = dict(env, GIT_LITERAL_PATHSPECS="1")
+        diff = b"".join(_git(repo, literal, *diff_args, "--no-renames", "--", *batch).stdout
+                        for batch in _batches(keep))
     if diff:
         (dest / "tracked.diff").write_bytes(diff)
         files.append("tracked.diff")
+    extra: dict = {}
+    if remote_base:
+        files.extend(_write_remote_base(repo, dest, remote_base))
+        extra["remote_base_count"] = len(remote_base)
 
     raw = _git(repo, env, "ls-files", "--others", "--exclude-standard", "-z").stdout
     untracked = [os.fsdecode(p) for p in raw.split(b"\0") if p]
@@ -213,7 +306,7 @@ def archive_repo(repo: Path, dest: Path, *, task_id: str, completed_at: Optional
     meta = {
         "task_id": task_id, "completed_at": completed_at, "source": str(repo),
         "head": head, "branch": branch, "remotes": remotes, "unpushed_refs": unpushed,
-        "untracked_count": len(untracked), "files": files, "archived_at": int(time.time()),
+        "untracked_count": len(untracked), "files": files, "archived_at": int(time.time()), **extra,
     }
     (dest / "meta.json").write_text(json.dumps(meta, indent=2) + "\n", encoding="utf-8")
     return meta
diff --git a/tests/hermes_cli/test_kanban_scratch_archive_partial_clone.py b/tests/hermes_cli/test_kanban_scratch_archive_partial_clone.py
new file mode 100644
index 0000000000..e39aaa8294
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_scratch_archive_partial_clone.py
@@ -0,0 +1,182 @@
+"""Scratch archive of partial (blobless) clones never lazily fetches. [daveey]
+
+A blobless clone keeps HEAD's blobs on its promisor remote until checkout needs
+them. ``git diff --binary HEAD`` lazily fetched every missing base blob, so on a
+worker with no GitHub credential each such tree (e.g. a ``--no-checkout`` clone,
+whose whole tree reads as staged deletions) was refused forever and never
+reclaimed. The archive now records those paths as remote-base entries, keeps the
+worktree side of any that still exist, and diffs only paths whose base is local.
+"""
+import json
+import os
+import shutil
+import subprocess
+import tarfile
+
+import pytest
+
+from tests.hermes_cli import test_kanban_scratch_gc_archive as base
+
+board = base.board
+_run = base._run
+_task = base._task
+_gc = base._gc
+_archive = base._archive
+
+
+@pytest.fixture
+def promisor(tmp_path):
+    """Bare remote serving filters: branch ``old`` = c1, ``main`` = c2 (new blobs)."""
+    src = tmp_path / "pseed"
+    src.mkdir()
+    _run("init", "-q", cwd=src)
+    (src / "tracked.txt").write_text("one\n")
+    (src / "same.txt").write_text("same\n")
+    _run("add", ".", cwd=src)
+    _run("commit", "-q", "-m", "c1", cwd=src)
+    _run("branch", "old", cwd=src)
+    (src / "tracked.txt").write_text("two\n")
+    (src / "other.txt").write_text("other\n")
+    _run("add", ".", cwd=src)
+    _run("commit", "-q", "-m", "c2", cwd=src)
+    bare = tmp_path / "promisor.git"
+    _run("clone", "-q", "--bare", str(src), str(bare))
+    _run("config", "uploadpack.allowFilter", "true", cwd=bare)
+    return bare
+
+
+def _clone(remote, dest, *extra):
+    _run("clone", "-q", "--filter=blob:none", *extra, f"file://{remote}", str(dest))
+    assert _run("config", "--get", "remote.origin.promisor", cwd=dest) == "true"
+
+
+def _missing(repo):
+    walk = subprocess.run(["git", "rev-list", "--objects", "--missing=print", "--no-walk", "HEAD"],
+                          cwd=repo, capture_output=True, text=True, check=True,
+                          env={**os.environ, "GIT_NO_LAZY_FETCH": "1"})
+    return {line[1:] for line in walk.stdout.splitlines() if line.startswith("?")}
+
+
+def test_no_checkout_blobless_clone_is_archived_without_credentials(board, promisor):
+    tid, path = _task()
+    _clone(promisor, path / "repo", "--no-checkout")
+    assert _missing(path / "repo")  # every base blob lives on the promisor only
+    shutil.move(promisor, promisor.with_name("gone.git"))  # lazy fetch now fails, like no creds
+    assert _gc() == 0
+    assert not path.exists()
+    dest = _archive(tid) / "repo"
+    meta = json.loads((dest / "meta.json").read_text())
+    assert not (dest / "tracked.diff").exists()
+    assert meta["remote_base_count"] == 3 and "remote_base.json" in meta["files"]
+    entries = json.loads((dest / "remote_base.json").read_text())["entries"]
+    assert sorted((e["status"], e["path"]) for e in entries) == [
+        ("D", "other.txt"), ("D", "same.txt"), ("D", "tracked.txt")]
+    assert not (dest / "remote_base.tar").exists()
+
+
+def test_missing_base_keeps_worktree_side_diffs_the_rest_and_never_fetches(board, promisor, tmp_path):
+    from hermes_cli import kanban_scratch_archive as sa
+
+    repo = tmp_path / "w" / "repo"
+    _clone(promisor, repo, "-b", "old")
+    _run("reset", "-q", "--soft", "origin/main", cwd=repo)  # HEAD's tracked/other blobs: remote only
+    (repo / "same.txt").write_text("same\nlocal edit\n")
+    before = _missing(repo)
+    assert len(before) == 2
+    dest = tmp_path / "out"
+    meta = sa.archive_repo(repo, dest, task_id="t_x", completed_at=None)
+    assert _missing(repo) == before  # nothing was fetched although the remote is reachable
+    diff = (dest / "tracked.diff").read_text()
+    assert "+local edit" in diff and "tracked.txt" not in diff and "other.txt" not in diff
+    entries = {e["path"]: e for e in json.loads((dest / "remote_base.json").read_text())["entries"]}
+    assert {p: e["status"] for p, e in entries.items()} == {"tracked.txt": "M", "other.txt": "D"}
+    assert {e["old_oid"] for e in entries.values()} == before
+    with tarfile.open(dest / "remote_base.tar") as tar:
+        assert tar.getnames() == ["tracked.txt"]
+        assert tar.extractfile("tracked.txt").read() == b"one\n"  # the local side survives
+    assert meta["remote_base_count"] == 2
+    assert {"tracked.diff", "remote_base.json", "remote_base.tar"} <= set(meta["files"])
+
+
+def test_kept_paths_diff_in_batches_with_literal_pathspecs(board, promisor, tmp_path, monkeypatch):
+    import functools
+
+    from hermes_cli import kanban_scratch_archive as sa
+
+    repo = tmp_path / "w" / "repo"
+    _clone(promisor, repo, "-b", "old")
+    (repo / "s*.txt").write_text("glob-looking name\n")
+    _run("add", "s*.txt", cwd=repo)
+    _run("reset", "-q", "--soft", "origin/main", cwd=repo)
+    (repo / "same.txt").write_text("same\nlocal edit\n")
+    monkeypatch.setattr(sa, "_batches", functools.partial(sa._batches, limit=1))  # one path per call
+    sa.archive_repo(repo, tmp_path / "out", task_id="t_x", completed_at=None)
+    diff = (tmp_path / "out" / "tracked.diff").read_text()
+    assert diff.count("diff --git") == 2  # same.txt once, s*.txt once (literal, not a glob)
+    assert "+local edit" in diff and "+glob-looking name" in diff
+    assert sa._batches(["a", "bb", "c"], limit=5) == [["a", "bb"], ["c"]]
+
+
+def test_complete_blobless_clone_archives_like_a_full_one(board, promisor, tmp_path):
+    from hermes_cli import kanban_scratch_archive as sa
+
+    repo = tmp_path / "w" / "repo"
+    _clone(promisor, repo)
+    (repo / "tracked.txt").write_text("two\nlocal edit\n")
+    dest = tmp_path / "out"
+    meta = sa.archive_repo(repo, dest, task_id="t_x", completed_at=None)
+    assert "+local edit" in (dest / "tracked.diff").read_text()
+    assert "remote_base_count" not in meta
+    assert not (dest / "remote_base.json").exists()
+
+
+@pytest.mark.parametrize("promisor_value", [None, "false"])
+def test_missing_object_in_a_full_clone_still_refuses(board, tmp_path, promisor_value):
+    from hermes_cli import kanban_scratch_archive as sa
+
+    repo = tmp_path / "w" / "repo"
+    repo.mkdir(parents=True)
+    _run("init", "-q", cwd=repo)
+    if promisor_value is not None:  # a remote explicitly NOT a promisor vouches for nothing
+        _run("config", "remote.origin.promisor", promisor_value, cwd=repo)
+    (repo / "f.txt").write_text("base\n")
+    _run("add", ".", cwd=repo)
+    _run("commit", "-q", "-m", "c", cwd=repo)
+    _run("update-ref", "refs/remotes/origin/main", "HEAD", cwd=repo)  # pushed: no bundle step
+    blob = _run("rev-parse", "HEAD:f.txt", cwd=repo)
+    loose = repo / ".git" / "objects" / blob[:2] / blob[2:]
+    loose.chmod(0o600)
+    loose.unlink()  # corruption, not a promise: nothing vouches for it remotely
+    (repo / "f.txt").unlink()  # deleted: `diff --raw` still lists it, only the patch needs the blob
+    with pytest.raises(sa.ArchiveRefused, match="unable to read"):
+        sa.archive_repo(repo, tmp_path / "out", task_id="t_x", completed_at=None)
+
+
+def test_unborn_partial_clone_archives_its_files(board, tmp_path):
+    from hermes_cli import kanban_scratch_archive as sa
+
+    repo = tmp_path / "w" / "repo"
+    repo.mkdir(parents=True)
+    _run("init", "-q", cwd=repo)
+    _run("config", "remote.origin.promisor", "true", cwd=repo)  # e.g. a filtered clone of an empty repo
+    (repo / "new.txt").write_text("fresh\n")
+    _run("add", "new.txt", cwd=repo)  # staged against the empty tree: a raw change, but no HEAD to walk
+    meta = sa.archive_repo(repo, tmp_path / "out", task_id="t_x", completed_at=None)
+    assert meta["head"] is None and "+fresh" in (tmp_path / "out" / "tracked.diff").read_text()
+    assert "remote_base_count" not in meta
+
+
+def test_archive_git_never_reaches_the_network(board, tmp_path):
+    from hermes_cli import kanban_scratch_archive as sa
+
+    repo = tmp_path / "r"
+    repo.mkdir()
+    _run("init", "-q", cwd=repo)
+    env = sa._env(repo)
+    assert env["GIT_NO_LAZY_FETCH"] == "1"
+    count = int(env["GIT_CONFIG_COUNT"])
+    pairs = {env[f"GIT_CONFIG_KEY_{i}"]: env[f"GIT_CONFIG_VALUE_{i}"] for i in range(count)}
+    assert pairs["protocol.allow"] == "never"
+    probe = subprocess.run(["git", "-C", str(repo), "config", "--get", "protocol.allow"],
+                           env=env, capture_output=True, text=True, check=True)
+    assert probe.stdout.strip() == "never"
