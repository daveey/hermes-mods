From e17f4285f2ce15e85744a7c4aacb6a45a194db4e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:55:21 +0000
Subject: [PATCH] [daveey] code_execution_rpc: _wire_bytes pair note says what
 changes remotely; drop wording-only test assert

Review 5890490597 nits on 4ad76dc873:
1. 'lossless join' was inaccurate: the remote str holds one astral char where
   this side held two code points (len 2 -> 1, unequal). The comment now says
   the UTF-16 meaning survives and the code-point sequence does not; the
   docstring's 'decodes back to the same text' notes the pair caveat.
2. Drop the assert that the old phrase is absent (a change detector); the
   positive conditional-clause assert carries the contract.
---
 tests/tools/test_code_execution_terminal_full_output.py | 1 -
 tools/code_execution_rpc.py                             | 8 +++++---
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/tests/tools/test_code_execution_terminal_full_output.py b/tests/tools/test_code_execution_terminal_full_output.py
index 18dc005374..6fee1def80 100644
--- a/tests/tools/test_code_execution_terminal_full_output.py
+++ b/tests/tools/test_code_execution_terminal_full_output.py
@@ -186,7 +186,6 @@ def test_remote_file_rpc_bounds_a_large_non_terminal_result(monkeypatch):
     assert "do not repeat" in r["error"]
     # Read-only tools change nothing, so the side-effect clause is conditional, not asserted.
     assert "if the call changed anything, that change stands" in r["error"]
-    assert "any change the call made stands" not in r["error"]
     assert shipped < 2 * 1024 * 1024
     assert log[-1]["tool"] == "read_file" and "limit" in log[-1]["error"]
     # A result within the cap ships unchanged.
diff --git a/tools/code_execution_rpc.py b/tools/code_execution_rpc.py
index 4f336beff4..12d4a32f70 100644
--- a/tools/code_execution_rpc.py
+++ b/tools/code_execution_rpc.py
@@ -64,12 +64,14 @@ def _wire_bytes(text: str) -> bytes:
     a size cap must measure. Tool results can hold lone surrogates (file reads decode
     undecodable bytes with surrogateescape), which strict UTF-8 refuses: each becomes its
     ``\\uXXXX`` escape, which inside a JSON string (where ``json.dumps`` puts every one)
-    decodes back to the same text. Only for RPC results: a shipped file (script, env file)
-    stays strict, since there the escape would be literal text."""
+    decodes back to the same text (a lone surrogate exactly; a high+low pair, see below).
+    Only for RPC results: a shipped file (script, env file) stays strict, since there the
+    escape would be literal text."""
     # Exact for lone surrogates only: a high+low pair held as two code points ships as two
     # escapes that json.loads joins into one astral char. A file read never holds such a
     # pair (surrogateescape yields only low surrogates, U+DC80..U+DCFF), but an MCP or
-    # plugin tool result could; the only effect is that lossless join on the remote side.
+    # plugin tool result could. The remote str then holds one char where this side held two:
+    # the UTF-16 meaning survives, the code-point sequence (and len) does not.
     return text.encode("utf-8", "backslashreplace")
 
 
-- 
2.51.0

