From 2354ecdd51ed43ce6cfd7ad7e845de76434110f2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 06:06:35 +0000
Subject: [PATCH] [daveey] fix(auth): disables never stick to a reused
 counter/slot label; remove forgets; wake times skip disabled rows

>From the review of 5dd6e6063d8 (items not covered by the later commits):
- labels that name a slot or a counter (api-key-N, env-var/slot names like claude_code,
  hermes_pkce, device_code, env:...) never match by label, so a new row reusing one is not
  born disabled; matching then goes by id (+ JWT account);
- hermes auth remove drops the disable records of the removed row unless another remaining row
  of that account still matches them;
- next_available_at ignores disabled rows (fallback-restore gate and 'available at' messages).

Proof: 4 new tests RED with the fixes reverted, GREEN with them.
---
 agent/credential_pool.py                      |  4 +--
 agent/credential_pool_disabled.py             | 33 +++++++++++++++++-
 hermes_cli/auth_commands.py                   |  2 ++
 .../test_credential_pool_disabled_paths.py    | 34 +++++++++++++++++++
 tests/hermes_cli/test_auth_disable_command.py |  7 ++++
 5 files changed, 77 insertions(+), 3 deletions(-)

diff --git a/agent/credential_pool.py b/agent/credential_pool.py
index cca2172328f..36112c45f15 100644
--- a/agent/credential_pool.py
+++ b/agent/credential_pool.py
@@ -1008,14 +1008,14 @@ class CredentialPool(CredentialPoolAdminMixin, CredentialPoolModelCooldownMixin)
                 until
                 for until in (
                     _exhausted_until(entry, sole_credential=sole_credential)
-                    for entry in self._entries
+                    for entry in self._enabled_entries()
                     if entry.last_status == STATUS_EXHAUSTED
                 )
                 if until is not None
             ]
             candidates.extend(
                 until
-                for entry in self._entries
+                for entry in self._enabled_entries()
                 if entry.last_status != STATUS_DEAD
                 for until in (model_cooldown_until(entry, model),)
                 if until is not None
diff --git a/agent/credential_pool_disabled.py b/agent/credential_pool_disabled.py
index cc5c31d9e80..9c363ee4bb8 100644
--- a/agent/credential_pool_disabled.py
+++ b/agent/credential_pool_disabled.py
@@ -20,6 +20,7 @@ applies to every profile on the host. Reads are cached by each file's (mtime, si
 from __future__ import annotations
 
 import json
+import re
 import logging
 import os
 import threading
@@ -48,8 +49,13 @@ def _records(store: dict[str, Any], provider: str) -> list[dict[str, Any]]:
     return [r for r in rows if isinstance(r, dict)] if isinstance(rows, list) else []
 
 
+_GENERIC_RE = re.compile(r"api-key-\d+|[a-z][a-z0-9]*(_[a-z0-9]+)+")  # numbered keys, env-var/slot names
+
+
 def _generic(label: str) -> bool:
-    return label in _GENERIC_LABELS or label.startswith(("env:", "env ")) or not label
+    """Labels naming a slot or a counter, not an account: reused by unrelated rows, so never matched."""
+    return not label or label in _GENERIC_LABELS or label.startswith(("env:", "env ")) or bool(
+        _GENERIC_RE.fullmatch(label))
 
 
 def account_of(entry: Any) -> Optional[str]:
@@ -189,6 +195,31 @@ def set_credential_disabled(provider: str, entry: Any, disabled: bool) -> bool:
     return True
 
 
+def forget_removed(provider: str, removed: Any, remaining: Iterable[Any]) -> bool:
+    """After ``hermes auth remove``: drop the records that disabled *removed* and match no remaining row,
+    so a later row reusing its id or label is not born disabled. Active store only."""
+    from hermes_cli import auth as auth_mod
+    remaining = list(remaining)
+    with auth_mod._auth_store_lock():
+        store = auth_mod._load_auth_store()
+        records = _records(store, provider)
+        keep = [r for r in records if not matches(removed, _keys_from_records([r]))
+                or any(matches(e, _keys_from_records([r])) for e in remaining)]
+        if len(keep) == len(records):
+            return False
+        section = store.get(SECTION) if isinstance(store.get(SECTION), dict) else {}
+        if keep:
+            section[provider] = keep
+        else:
+            section.pop(provider, None)
+        if section:
+            store[SECTION] = section
+        else:
+            store.pop(SECTION, None)
+        auth_mod._save_auth_store(store)
+    return True
+
+
 def disabled_by_root(provider: str, entry: Any) -> bool:
     """True when the global root (not the active profile) holds a record disabling *entry*."""
     from hermes_cli import auth as auth_mod
