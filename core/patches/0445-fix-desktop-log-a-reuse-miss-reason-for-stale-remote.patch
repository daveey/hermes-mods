From c35f241409fd03f7bee3e90bb25a3347623e9dea Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 26 Oct 2026 21:16:49 -0700
Subject: [PATCH 445/453] fix(desktop): log a reuse-miss reason for stale
 remote backends [daveey]

W0 logs why a present remote backend is not reused, but the path where the
backend is alive and ours yet runs a replaced runtime (stale after an
update) logged nothing, so the most common post-update miss was invisible.

Test: remote-lifecycle-release.test.ts stale-proof case (red on base).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 6f9a0bc29b90b5ec4b78179d10c251f97638979e)
---
 .../electron/remote-lifecycle-release.test.ts | 24 +++++++++++++++++++
 apps/desktop/electron/remote-lifecycle.ts     |  1 +
 2 files changed, 25 insertions(+)

diff --git a/apps/desktop/electron/remote-lifecycle-release.test.ts b/apps/desktop/electron/remote-lifecycle-release.test.ts
index 071ce69062..840adcc8a5 100644
--- a/apps/desktop/electron/remote-lifecycle-release.test.ts
+++ b/apps/desktop/electron/remote-lifecycle-release.test.ts
@@ -165,3 +165,27 @@ test('teardown policy: normal disconnects release, deliberate ones terminate, un
   assert.equal(remoteTeardownAction('something-new' as any, 'Linux'), 'terminate')
   assert.equal(remoteTeardownAction('quit', 'Windows'), 'skip-windows')
 })
+
+test('connect() logs a reason when the backend is alive and ours but its runtime was replaced', async () => {
+  const logs: string[] = []
+
+  const ssh = fakeRemote(ownedLock(), [
+    [/grep -q ssh-session-token-file/, 'YES\n'],
+    [/setsid/, '777\n'],
+    [/cat .*\.log/, 'HERMES_DASHBOARD_READY port=51999\n']
+  ])
+
+  try {
+    await connect(
+      connectDeps(ssh, {
+        reuseToken: 'stored-token',
+        probeReuseProof: async () => 'authenticated-stale',
+        rememberLog: line => logs.push(line)
+      })
+    )
+  } catch {
+    // Replacing the stale backend may fail in this double; only the logged reason matters here.
+  }
+
+  assert.ok(logs.some(line => /reuse miss: pid 333 runs a replaced runtime/.test(line)), logs.join('\n'))
+})
diff --git a/apps/desktop/electron/remote-lifecycle.ts b/apps/desktop/electron/remote-lifecycle.ts
index 2e82c48bfc..c96e27f466 100644
--- a/apps/desktop/electron/remote-lifecycle.ts
+++ b/apps/desktop/electron/remote-lifecycle.ts
@@ -1707,6 +1707,7 @@ async function connect(deps) {
         }
 
         if (reuseClassification === 'authenticated-stale') {
+          log(`reuse miss: pid ${lock.pid} runs a replaced runtime (stale after an update)`)
           assertBootstrapNotSuperseded(signal)
           await cancelForwardSafe(deps, localPort, lock.port)
           await assertRemoteInstallUpdateClear(ssh, hermesHome, hermesPath)
