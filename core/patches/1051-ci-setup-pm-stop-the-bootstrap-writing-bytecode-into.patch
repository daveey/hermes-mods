From 366f8678315a2c0c14a97575d0ac493883af9c20 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 23:48:56 +0000
Subject: [PATCH] ci(setup-pm): stop the bootstrap writing bytecode into the
 cache-key inputs

The PM tools cache key hashes pm/** after 'setup_toolchain.py prepare' ran. prepare imported pm
from the checkout and wrote pm/__pycache__ (a .pyc embeds the source mtime), so the key was
unique per job: 0 hits, and every lint job saved a ~114 MB cache in its post hook. Two of those
hooks (PR178 run 40971717382, ruff + Windows footguns) never completed and the jobs were
cancelled after validation had passed. Keys now stay stable, so a post save only runs when the
inputs really change.
---
 scripts/ci/setup_toolchain.py         |  5 ++++
 tests/scripts/test_setup_toolchain.py | 34 +++++++++++++++++++++++++++
 2 files changed, 39 insertions(+)

diff --git a/scripts/ci/setup_toolchain.py b/scripts/ci/setup_toolchain.py
index d47589a8a3b..4c4fc2cfdad 100644
--- a/scripts/ci/setup_toolchain.py
+++ b/scripts/ci/setup_toolchain.py
@@ -9,6 +9,11 @@ import platform
 import re
 import sys
 
+# The cache key hashes pm/** after this bootstrap ran. A .pyc embeds its source's mtime, so
+# bytecode written here made the key differ on every checkout: no job ever hit the PM tools
+# cache, and each one re-uploaded ~114 MB in its post hook (the step that stalled lint jobs).
+sys.dont_write_bytecode = True
+
 # The runner invokes this file before the checkout has been installed.
 if __package__ in (None, ""):
     sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
diff --git a/tests/scripts/test_setup_toolchain.py b/tests/scripts/test_setup_toolchain.py
index 7c763f25ede..9141fb00351 100644
--- a/tests/scripts/test_setup_toolchain.py
+++ b/tests/scripts/test_setup_toolchain.py
@@ -114,6 +114,40 @@ def test_stdlib_bootstrap_exports_the_pm_lock(toolchain, names, tmp_path):
     assert not Path(exported["HERMES_RUNTIME_DIR"]).exists(), "prepare must not provision before cache restore"
 
 
+def test_bootstrap_leaves_cache_key_inputs_unchanged(tmp_path):
+    """The PM tools cache key hashes pm/** and the setup-pm action after `prepare`.
+
+    Bytecode written by the bootstrap (a .pyc embeds the source mtime) made that hash unique per
+    checkout, so every job missed the cache and ran a ~114 MB save in its post hook; two such
+    hooks stalled past the job timeout. The key inputs must be identical before and after.
+    """
+    import shutil
+
+    root = Path(__file__).resolve().parents[2]
+    checkout = tmp_path / "checkout"
+    ignore = shutil.ignore_patterns("__pycache__", "*.pyc")
+    shutil.copytree(root / "pm", checkout / "pm", ignore=ignore)
+    shutil.copytree(root / "scripts" / "ci", checkout / "scripts" / "ci", ignore=ignore)
+    (checkout / "scripts" / "__init__.py").touch()
+
+    def snapshot():
+        return sorted(
+            str(path.relative_to(checkout)) for tree in ("pm", "scripts")
+            for path in (checkout / tree).rglob("*") if path.is_file()
+        )
+
+    before = snapshot()
+    env = {k: v for k, v in os.environ.items() if k != "PYTHONDONTWRITEBYTECODE"}
+    env.update(GITHUB_OUTPUT=str(tmp_path / "output"), GITHUB_ENV=str(tmp_path / "environment"))
+    result = subprocess.run(
+        [sys.executable, "-S", str(checkout / "scripts/ci/setup_toolchain.py"), "prepare",
+         "--toolchain", "python", "--home", str(tmp_path / "state")],
+        cwd=tmp_path, env=env, capture_output=True, text=True, encoding="utf-8", timeout=30, check=False,
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert snapshot() == before, "the bootstrap wrote files the cache key hashes (bytecode?)"
+
+
 @pytest.mark.parametrize("extras", ['"dev"', '{}', '[1]', '["dev\\nHERMES_HOME=bad"]', '["--all"]'])
 def test_invalid_extras_do_not_export_or_install(extras, tmp_path):
     root = Path(__file__).resolve().parents[2]
