From ee0f2cd1cd975bcf9b50a7fea256a475a4805906 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 03:55:14 +0000
Subject: [PATCH] fix(desktop): keep every Browser tab in preview-only zones
 under Single [daveey]

Shared isPreviewOnlyZone predicate now gates singleMainTabPanes, the tree
collapse and tab-strip visibility, so a zone of only Browser tabs keeps all
its chips in Single. Red-first test at singleMainTabPanes.
---
 .../components/pane-shell/tree/main-tab-policy.test.ts |  7 +++++++
 .../src/components/pane-shell/tree/main-tab-policy.ts  | 10 ++++++++++
 .../pane-shell/tree/renderer/strip-visibility.ts       |  3 ++-
 .../src/components/pane-shell/tree/single-tab-state.ts |  3 ++-
 4 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/components/pane-shell/tree/main-tab-policy.test.ts b/apps/desktop/src/components/pane-shell/tree/main-tab-policy.test.ts
index 7b28942e60..98a4ae93bc 100644
--- a/apps/desktop/src/components/pane-shell/tree/main-tab-policy.test.ts
+++ b/apps/desktop/src/components/pane-shell/tree/main-tab-policy.test.ts
@@ -117,3 +117,10 @@ describe('Single main slots through the actual tree store', () => {
     expect(shown()).toContain('files')
   })
 })
+
+it("keeps every Browser tab in a preview-only zone under Single", () => {
+  const previews = ["preview-tile:url:one", "preview-tile:url:two"]
+  const all = (id: string) => id.startsWith("preview-tile:")
+
+  expect(singleMainTabPanes({ active: previews[1]!, panes: previews }, previews, all, true)).toEqual(previews)
+})
diff --git a/apps/desktop/src/components/pane-shell/tree/main-tab-policy.ts b/apps/desktop/src/components/pane-shell/tree/main-tab-policy.ts
index c7854c2c98..8d31137731 100644
--- a/apps/desktop/src/components/pane-shell/tree/main-tab-policy.ts
+++ b/apps/desktop/src/components/pane-shell/tree/main-tab-policy.ts
@@ -2,6 +2,11 @@ import type { Contribution } from '@/contrib/types'
 
 import type { GroupNode } from './model'
 
+/** A zone whose main tabs are all Browser previews is not the session tab slot. */
+export function isPreviewOnlyZone(mains: readonly string[]): boolean {
+  return mains.length > 0 && mains.every(id => id.startsWith('preview-tile:'))
+}
+
 /** Visibility eligibility shared by store/keyboard policy. */
 export function shownGroupPanes(
   group: { active?: string; panes: readonly string[] },
@@ -44,6 +49,11 @@ export function singleMainTabPanes(
   }
 
   const main = shown.filter(isMain)
+
+  if (isPreviewOnlyZone(main)) {
+    return [...shown]
+  }
+
   const retained = main.includes(group.active) ? group.active : main[0]
 
   return shown.filter(id => !isMain(id) || id === retained)
diff --git a/apps/desktop/src/components/pane-shell/tree/renderer/strip-visibility.ts b/apps/desktop/src/components/pane-shell/tree/renderer/strip-visibility.ts
index 95b2a64fb6..650696eff7 100644
--- a/apps/desktop/src/components/pane-shell/tree/renderer/strip-visibility.ts
+++ b/apps/desktop/src/components/pane-shell/tree/renderer/strip-visibility.ts
@@ -12,6 +12,7 @@
 import type { Contribution } from '@/contrib/types'
 import { $tabStripDefault, effectiveTabStripMode } from '@/store/tabstrip-prefs'
 
+import { isPreviewOnlyZone } from '../main-tab-policy'
 import type { TabStripMode } from '../model'
 
 import { paneChrome } from './track-model'
@@ -117,7 +118,7 @@ export function tabStripVisibleForZone(zone: {
     $tabStripDefault.get() === 'single' &&
     zone.shown.length > 0 &&
     zone.shown.every(id => paneChrome(zone.paneFor(id)).placement === 'main') &&
-    !zone.shown.every(id => id.startsWith('preview-tile:'))
+    !isPreviewOnlyZone(zone.shown)
   ) {
     return false
   }
diff --git a/apps/desktop/src/components/pane-shell/tree/single-tab-state.ts b/apps/desktop/src/components/pane-shell/tree/single-tab-state.ts
index fb144d8869..03c4cb133e 100644
--- a/apps/desktop/src/components/pane-shell/tree/single-tab-state.ts
+++ b/apps/desktop/src/components/pane-shell/tree/single-tab-state.ts
@@ -1,6 +1,7 @@
 import { registry } from '@/contrib/registry'
 import { $tabStripDefault } from '@/store/tabstrip-prefs'
 
+import { isPreviewOnlyZone } from './main-tab-policy'
 import { allPaneIds, findGroup, findGroupOfPane, type LayoutNode, removePane } from './model'
 import { isTreePaneParked, isTreePaneParkedByOthers, setTreePaneParked, TREE_PARK_SINGLE } from './parked-panes'
 import { singleTabMemory as memory, type ParkedTab } from './single-tab-memory'
@@ -25,7 +26,7 @@ function enforce(tree: LayoutNode): LayoutNode {
     const mains = node.panes.filter(isMain)
 
     // A preview-only zone is not the session tab slot: keep every Browser tab.
-    if (mains.length < 2 || mains.every(id => id.startsWith('preview-tile:'))) {
+    if (mains.length < 2 || isPreviewOnlyZone(mains)) {
       return node
     }
 
-- 
