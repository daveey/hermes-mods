From bdf9fad21f0129283be619eff31b731971b5fec4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 26 Oct 2026 03:27:11 +0000
Subject: [PATCH] fix(nix): mirror libtirpc archive without changing pinned
 hash [daveey]

---
 flake.nix              |  1 +
 nix/source-mirrors.nix | 26 ++++++++++++++++++++++++++
 2 files changed, 27 insertions(+)
 create mode 100644 nix/source-mirrors.nix

diff --git a/flake.nix b/flake.nix
index 46e1f3d4ff..561ac2f4bf 100644
--- a/flake.nix
+++ b/flake.nix
@@ -46,6 +46,7 @@
       ];
 
       imports = [
+        ./nix/source-mirrors.nix
         ./nix/packages.nix
         ./nix/overlays.nix
         ./nix/nixosModules.nix
diff --git a/nix/source-mirrors.nix b/nix/source-mirrors.nix
new file mode 100644
index 0000000000..1f58e1df57
--- /dev/null
+++ b/nix/source-mirrors.nix
@@ -0,0 +1,26 @@
+# Keep the locked source bytes when upstream download endpoints disappear.
+{ inputs, ... }:
+{
+  perSystem =
+    { system, ... }:
+    {
+      _module.args.pkgs = import inputs.nixpkgs {
+        inherit system;
+        overlays = [
+          (final: prev: {
+            # linux-nfs.org migrated from gitweb to cgit: the old snapshot
+            # query now returns HTML. This content-addressed NixOS mirror
+            # serves the identical archive, verified against the original hash.
+            libtirpc = prev.libtirpc.overrideAttrs (
+              old:
+              final.lib.optionalAttrs (old.version == "1.3.7") {
+                src = old.src.override {
+                  url = "https://tarballs.nixos.org/sha256/5467ed12bdf1cc2a7c3b7a2a0a3219a3396ae7df60c4de48b07051686dfb18fe";
+                };
+              }
+            );
+          })
+        ];
+      };
+    };
+}
-- 
