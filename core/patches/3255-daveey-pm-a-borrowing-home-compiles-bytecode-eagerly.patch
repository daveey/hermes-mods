From 68763680af2f79eb788f20d47eab702bedcbdaab Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 08:09:31 +0000
Subject: [PATCH] [daveey] pm: a borrowing home compiles bytecode eagerly under
 PYTHONDONTWRITEBYTECODE

487ccc22e5 skips --compile-bytecode for a borrowing home's installs/
environments, leaving modules to compile on first import. Under
PYTHONDONTWRITEBYTECODE=1 (the Docker image sets it) that lazy bytecode is
never written, so every start would recompile every import (#100461). Keep
the eager compile when the variable is set. It is read from os.environ:
PythonEnvironment.env drops every PYTHON* key.

The docstring now says the environment's files are hard links (APFS clones
on macOS) into the account's uv cache, and that the PM runtime under
installs/<key>/pm-runtime follows the same rule; a test pins that.

Follow-up to review 5887018818 on PR #1910 (superseded by #1895).
---
 pm/environment.py             | 13 +++++++++----
 tests/pm/test_account_seed.py | 11 +++++++++++
 2 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/pm/environment.py b/pm/environment.py
index d99b2ce30d..49b085465f 100644
--- a/pm/environment.py
+++ b/pm/environment.py
@@ -465,12 +465,17 @@ class PythonEnvironment:
     def _compile_bytecode(self) -> bool:
         """Compile eagerly, except an environment of a home that borrows the account's state.
 
-        Every other file of such an environment is a link into the account's uv cache; its
-        bytecode is the one copy it would own, ~70 MiB per environment, mostly for modules a
-        test or review run never imports. Those compile on first import instead."""
+        Every other file of such an environment is a hard link (an APFS clone on macOS) into the
+        account's uv cache; its bytecode is the one copy it would own, ~70 MiB per environment,
+        mostly for modules a test or review run never imports. Those compile on first import
+        instead. The PM runtime (``installs/<key>/pm-runtime``) follows the same rule.
+
+        Under ``PYTHONDONTWRITEBYTECODE`` (the Docker image sets it) a lazy compile is never
+        written, so every start would recompile every import: compile eagerly there. Read from
+        ``os.environ``: ``self.env`` drops every ``PYTHON*`` key (``_base_environment``)."""
         from pm.environments import account_home_root, installs_root
 
-        if account_home_root() is None:
+        if os.environ.get("PYTHONDONTWRITEBYTECODE") or account_home_root() is None:
             return True
         try:
             return not self.destination.resolve().is_relative_to(installs_root().resolve())
diff --git a/tests/pm/test_account_seed.py b/tests/pm/test_account_seed.py
index 19a9edfb44..eae3317f02 100644
--- a/tests/pm/test_account_seed.py
+++ b/tests/pm/test_account_seed.py
@@ -221,12 +221,23 @@ def _environment(destination: Path):
 def test_borrowing_home_environments_compile_bytecode_lazily(tmp_path, monkeypatch):
     from pm.environments import installs_root
 
+    monkeypatch.delenv("PYTHONDONTWRITEBYTECODE", raising=False)
     assert _environment(installs_root() / "k" / "environments" / "g" / "venv")._compile_bytecode()
     monkeypatch.setenv("HERMES_HOME", str(tmp_path / "fresh"))
     assert not _environment(installs_root() / "k" / "environments" / "g" / "venv")._compile_bytecode()
+    assert not _environment(installs_root() / "k" / "pm-runtime" / "generations" / "g")._compile_bytecode()
     assert _environment(tmp_path / "payload" / "venv")._compile_bytecode()  # a bundle build keeps it
 
 
+def test_borrowing_home_compiles_eagerly_when_lazy_bytecode_is_never_written(tmp_path, monkeypatch):
+    """PYTHONDONTWRITEBYTECODE (the Docker image) drops lazy pyc: each start would recompile."""
+    from pm.environments import installs_root
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "fresh"))
+    monkeypatch.setenv("PYTHONDONTWRITEBYTECODE", "1")
+    assert _environment(installs_root() / "k" / "environments" / "g" / "venv")._compile_bytecode()
+
+
 def test_sync_passes_compile_bytecode_only_when_wanted(tmp_path, monkeypatch):
     import subprocess
 
