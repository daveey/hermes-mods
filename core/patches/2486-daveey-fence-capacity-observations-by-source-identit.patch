diff --git a/schemas/kanban-capacity-evidence-v1.schema.json b/schemas/kanban-capacity-evidence-v1.schema.json
new file mode 100644
index 0000000000..5b5da11517
--- /dev/null
+++ b/schemas/kanban-capacity-evidence-v1.schema.json
@@ -0,0 +1,49 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "urn:hermes:kanban-capacity-evidence:v1",
+  "title": "Advisory task capacity evidence v1",
+  "type": "object",
+  "required": ["version", "freshness", "reasons", "eligible_backlog", "admissible_slots", "unknown_coverage"],
+  "properties": {
+    "version": {"const": 1},
+    "freshness": {"enum": ["current", "stale", "unknown"]},
+    "unknown_reason": {"type": "string", "minLength": 1},
+    "observed_at_ms": {"type": "number", "minimum": 0},
+    "valid_until_ms": {"type": "number", "minimum": 0},
+    "source": {"const": "kanban.dispatch"},
+    "source_revision": {"type": "string", "minLength": 1},
+    "machine": {"type": "string", "minLength": 1},
+    "board": {"type": "string", "minLength": 1},
+    "task_id": {"type": "string", "minLength": 1},
+    "evidence_ref": {"type": "string", "minLength": 1},
+    "lifecycle": {"type": "object", "required": ["status", "run_id", "run_count", "assignee", "parents"], "properties": {
+      "status": {"type": "string"}, "run_id": {"type": ["integer", "null"]},
+      "run_count": {"type": "integer", "minimum": 0}, "assignee": {"type": ["string", "null"]},
+      "parents": {"type": "array"}
+    }},
+    "reasons": {"type": "array", "items": {"$ref": "#/$defs/reason"}},
+    "machine_reasons": {"type": "array", "items": {"$ref": "#/$defs/reason"}},
+    "native_restrictions": {"type": "array", "items": {
+      "type": "object", "required": ["source_field", "native_code", "evidence_ref"],
+      "properties": {"source_field": {"type": "string"}, "native_code": {"type": "string"}, "evidence_ref": {"type": "string"}}
+    }},
+    "eligible_backlog": {"type": ["boolean", "null"]},
+    "admissible_slots": {"type": ["integer", "null"], "minimum": 0},
+    "unknown_coverage": {"type": "array", "items": {"type": "string"}},
+    "coverage_truncated": {"type": "boolean"},
+    "execution_observation": {"type": "object"}
+  },
+  "allOf": [{"if": {"properties": {"freshness": {"enum": ["current", "stale"]}}}, "then": {
+    "required": ["observed_at_ms", "valid_until_ms", "source", "source_revision", "machine", "board", "task_id", "evidence_ref", "lifecycle"]
+  }}],
+  "$defs": {"reason": {
+    "type": "object", "required": ["code", "native_code", "phase", "evidence_ref"],
+    "properties": {
+      "code": {"enum": ["capacity.memory_pressure", "capacity.provider_limit", "capacity.placement", "capacity.dependency", "capacity.update_drain"]},
+      "native_code": {"type": "string", "minLength": 1},
+      "phase": {"enum": ["pre_claim", "post_claim", "post_start"]},
+      "evidence_ref": {"type": "string", "minLength": 1}
+    }
+  }},
+  "$comment": "Optional additive evidence only. Unknown/stale is never admissible capacity. An unknown execution adapter may lack a producer-complete identity. Current capacity evidence does not imply current execution or complete admission coverage."
+}
diff --git a/tests/hermes_cli/test_execution_observations.py b/tests/hermes_cli/test_execution_observations.py
index 75628c47af..b17db4b39d 100644
--- a/tests/hermes_cli/test_execution_observations.py
+++ b/tests/hermes_cli/test_execution_observations.py
@@ -113,5 +113,42 @@ def test_provider_after_start_stays_after_start():
     assert reason["phase"] == "post_start"
 
 
+@pytest.mark.parametrize("field,value", [
+    ("owner", None), ("owner", {}), ("owner", {"gateway": "g"}),
+    ("owner", {"gateway": "g", "profile": False}),
+    ("evidence_refs", None), ("evidence_refs", []), ("evidence_refs", [""]),
+    ("evidence_refs", "event:31"), ("evidence_refs", [True]),
+])
+def test_missing_owner_or_evidence_is_unknown(field, value):
+    raw = observation()
+    raw[field] = value
+    out = adapt(raw, now=1100, source_class="sidebar")
+    assert out["state"] == "unknown"
+    assert out["last_known_state"] == "queued"
+
+
+@pytest.mark.parametrize("attempt", [-1, 0, True, "", [], {}])
+def test_invalid_attempt_identity_is_unknown(attempt):
+    raw = observation()
+    raw["identity"]["run_id"] = attempt
+    assert adapt(raw, now=1100, source_class="sidebar")["state"] == "unknown"
+
+
+def test_required_source_retains_its_own_shorter_ttl():
+    raw = observation()
+    raw["valid_until"] = 1600
+    raw["required_sources"] = [{"observed_at": 990, "valid_until": 5000,
+                                "source_class": "sidebar"}]
+    out = adapt(raw, now=1200, source_class="imported_owner")
+    assert out["state"] == "unknown" and out["valid_until"] == 1170
+
+
+def test_unknown_required_source_class_is_unknown():
+    raw = observation()
+    raw["required_sources"] = [{"observed_at": 990, "valid_until": 1180,
+                                "source_class": "invented"}]
+    assert adapt(raw, now=1100, source_class="sidebar")["state"] == "unknown"
+
+
 def test_unknown_source_class_cannot_manufacture_validity():
     assert adapt(observation(), now=1100, source_class="invented")["state"] == "unknown"
