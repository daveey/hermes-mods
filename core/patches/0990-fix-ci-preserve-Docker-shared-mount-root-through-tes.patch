From 0a60ad32a4ebfaccaefc3b38ad2742f740a67b9a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 19:12:40 +0000
Subject: [PATCH] fix(ci): preserve Docker shared mount root through test
 runner

---
 .github/workflows/tests.yml           | 15 ---------------
 scripts/run_tests.sh                  |  2 +-
 tests/scripts/test_run_tests_shell.py | 23 +++++++++++++++++++++++
 3 files changed, 24 insertions(+), 16 deletions(-)

diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index 7525322695d..bade4c65584 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -195,21 +195,6 @@ jobs:
           test-environment: 'true'
           prune-python-cache: true
 
-      - name: Diagnose bind-mount visibility
-        if: always()
-        env:
-          HERMES_TEST_DOCKER_MOUNT_ROOT: ${{ runner.temp }}/termux-assembly
-        run: |
-          set +e
-          IMG=python@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a
-          P="$HERMES_TEST_DOCKER_MOUNT_ROOT/diag2"; mkdir -p "$P"
-          A="$(mktemp -d "$P/.environments-XXXXXX")"; mkdir "$A/tools"
-          ls -lad "$A" "$A/tools"
-          docker run --rm --user 0:0 --entrypoint sh -v "$A:/assembly" $IMG -c 'id; ls -lan /assembly; stat /assembly/tools; chown 1000:1000 /assembly /assembly/tools; echo rc=$?'
-          chmod 755 "$A"
-          docker run --rm --user 0:0 --entrypoint sh -v "$A:/assembly" $IMG -c 'ls -lan /assembly; chown 1000:1000 /assembly /assembly/tools; echo rc755=$?'
-          true
-
       - name: Run assembly permission tests
         # --fail-on-skip: a missing daemon or image must not go green.
         # Bind-mount sources must live where the docker daemon can see them.
diff --git a/scripts/run_tests.sh b/scripts/run_tests.sh
index 32bee5a9f11..05e4ecb88b6 100755
--- a/scripts/run_tests.sh
+++ b/scripts/run_tests.sh
@@ -166,7 +166,7 @@ for _test_var in HERMES_TEST_IMAGE HERMES_TEST_WORKERS HERMES_TEST_PATHS \
   SSL_CERT_FILE SSL_CERT_DIR HERMES_GATEWAY_LOCK_DIR HERMES_E2E_REQUIRE_TUI CI GITHUB_ACTIONS \
   HERMES_E2E_WINDOWS_INSTALL HERMES_E2E_MACHINE_ROOT HERMES_E2E_PROFILES_ROOT HERMES_E2E_ARTIFACTS \
   HERMES_E2E_STRICT_ACCEPTANCE HERMES_TEST_SSH_HOST HERMES_TEST_SSH_USER HERMES_TEST_SSH_PORT \
-  HERMES_TEST_SSH_KEY HERMES_TEST_DOCKER_IMAGE; do
+  HERMES_TEST_SSH_KEY HERMES_TEST_DOCKER_IMAGE HERMES_TEST_DOCKER_MOUNT_ROOT; do
   if [ -n "${!_test_var:-}" ]; then
     TEST_ENV+=("$_test_var=${!_test_var}")
   fi
diff --git a/tests/scripts/test_run_tests_shell.py b/tests/scripts/test_run_tests_shell.py
index bed3c74beb5..85a69075e39 100644
--- a/tests/scripts/test_run_tests_shell.py
+++ b/tests/scripts/test_run_tests_shell.py
@@ -80,3 +80,26 @@ def test_shell_runner_forwards_host_slot_settings(tmp_path):
     assert result.returncode == 0, result.stdout + result.stderr
     names = {p.name for p in slot_dir.iterdir()}
     assert names and names <= {"0.lock", "1.lock", "2.lock"}, names
+
+
+@pytest.mark.platforms("posix")
+def test_shell_runner_forwards_docker_mount_root(tmp_path):
+    """A remote daemon must receive bind sources from its shared filesystem."""
+    mount_root = tmp_path / "shared docker mounts"
+    case = tmp_path / "test_mount_canary.py"
+    case.write_text(
+        "import os\n"
+        "def test_mount_canary():\n"
+        f"    assert os.environ.get('HERMES_TEST_DOCKER_MOUNT_ROOT') == {str(mount_root)!r}\n",
+        encoding="utf-8",
+    )
+    root = Path(__file__).resolve().parents[2]
+    result = subprocess.run(
+        ["bash", str(root / "scripts/run_tests.sh"), "-j", "1", str(case)],
+        cwd=tmp_path, capture_output=True, text=True, timeout=180,
+        env={**os.environ, "HERMES_PYTHON": sys.executable,
+             "HERMES_TEST_FILE_RETRIES": "0",
+             "HERMES_TEST_DOCKER_MOUNT_ROOT": str(mount_root)},
+        check=False,
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
-- 
2.55.0

