From 5f1adfe86b3ef73e27e53246b6e4574bf6e470db Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 22:56:02 -0700
Subject: [PATCH] fix(tests): preserve git guard PATH through teardown [daveey]

---
 tests/conftest.py                   |  7 ++++++-
 tests/test_live_git_config_guard.py | 18 ++++++++++++++++++
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/tests/conftest.py b/tests/conftest.py
index 9006dfc4c8..9eb415cd60 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -470,6 +470,8 @@ def _neutralize_kanban_memory_guard(request, monkeypatch):
 
 
 _LIVE_GIT_CONFIGS: list | None = None
+# Teardown may run before monkeypatch restores a test's deliberately empty PATH.
+_GUARD_PATH = os.environ.get("PATH", os.defpath)
 
 
 def _live_git_config_paths() -> list:
@@ -503,7 +505,10 @@ def _plain_run(argv: list):
 
     # Capture Popen at conftest import: teardown can precede monkeypatch undo.
     # Capturing subprocess.run instead would still look up the mocked Popen.
-    proc = _GUARD_POPEN(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
+    proc = _GUARD_POPEN(
+        argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+        env={**os.environ, "PATH": _GUARD_PATH},
+    )
     out, _ = proc.communicate()
     return proc.returncode, out
 
diff --git a/tests/test_live_git_config_guard.py b/tests/test_live_git_config_guard.py
index b4f1adce57..a7ac187937 100644
--- a/tests/test_live_git_config_guard.py
+++ b/tests/test_live_git_config_guard.py
@@ -49,6 +49,24 @@ def test_guard_teardown_with_mocked_popen(tmp_path, monkeypatch, fake_kind, muta
                 next(fixture)
 
 
+@pytest.mark.parametrize("mutate", [False, True])
+def test_guard_teardown_survives_empty_path(tmp_path, monkeypatch, mutate):
+    cfg = _init(tmp_path)
+    snapshots = {cfg: _read_bytes_or_none(cfg)}
+    if mutate:
+        subprocess.run([
+            "git", "config", "--file", str(cfg), "user.email", "fixture@example.invalid",
+        ], check=True)
+    with monkeypatch.context() as mocks:
+        mocks.setenv("PATH", "")
+        if mutate:
+            with pytest.raises(pytest.fail.Exception, match="test wrote user"):
+                _assert_git_configs_unchanged(snapshots)
+            assert _read_bytes_or_none(cfg) == b""
+        else:
+            _assert_git_configs_unchanged(snapshots)
+
+
 def test_guard_watches_the_checkout_under_test():
     assert _live_git_config_paths()
 
-- 
