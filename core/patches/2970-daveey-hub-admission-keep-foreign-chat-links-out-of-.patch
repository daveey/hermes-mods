From 623ee8941a5adf4049ba2f54d1e0aba4efe8cf61 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 07:17:16 +0000
Subject: [PATCH] [daveey] hub admission: keep foreign chat links out of pickup
 copies (local origin column); courier create envelope stays JSON and
 retry-compatible

---
 hermes_cli/kanban_admission_origin.py         | 24 ++++++++++++-------
 hermes_cli/kanban_db.py                       |  2 +-
 hermes_cli/kanban_db_connect.py               |  2 ++
 hermes_cli/kanban_db_sync.py                  |  2 +-
 hermes_cli/kanban_origin_creation.py          |  4 +++-
 hermes_cli/kanban_worker_node.py              |  4 ++--
 .../test_kanban_admission_origin.py           |  4 +++-
 .../hermes_cli/test_kanban_origin_creation.py | 22 ++++++++++++++++-
 8 files changed, 49 insertions(+), 15 deletions(-)

diff --git a/hermes_cli/kanban_admission_origin.py b/hermes_cli/kanban_admission_origin.py
index ccced22fc5..7303710143 100644
--- a/hermes_cli/kanban_admission_origin.py
+++ b/hermes_cli/kanban_admission_origin.py
@@ -2,17 +2,26 @@
 import json
 
 
-def pickup_links(replica, task_id):
-    """Carry original chat custody before claim, using pickup's already-open replica."""
-    from hermes_cli import kanban_db_sync as sync, kanban_sync_client as ksc
+def record_pickup_origins(conn, replica, task_ids):
+    """Store each picked-up foreign card's origin, read from pickup's already-open replica, in the local-only
+    ``tasks.admission_origin``: another gateway's chat links never enter the live copy, and the claim gate must not
+    open a replica under ``admission.lock``."""
+    from hermes_cli.kanban_db_connect import write_txn
 
-    return [sync.RemoteChange(0, "task_chat_links", row["uid"], "upsert",
-                              ksc._row_fields(replica, "task_chat_links", row), 0, "", "")
-            for row in replica.execute("SELECT * FROM task_chat_links WHERE task_id=?", (task_id,))]
+    keys = [(origin_key(replica, tid), tid) for tid in task_ids]
+    if keys:
+        with write_txn(conn):
+            conn.executemany("UPDATE tasks SET admission_origin=? WHERE id=?", keys)
 
 
 def origin_key(conn, task_id):
-    """Use the original created chat, including released links, then creating gateway/creator."""
+    """Use the pickup-time origin, else the original created chat (released links included), else creating
+    gateway/creator."""
+    cols = {row[1] for row in conn.execute("PRAGMA table_info(tasks)")}
+    if "admission_origin" in cols:
+        row = conn.execute("SELECT admission_origin FROM tasks WHERE id=?", (task_id,)).fetchone()
+        if row and row[0]:
+            return row[0]
     if conn.execute("SELECT 1 FROM sqlite_master WHERE name='task_chat_links'").fetchone():
         row = conn.execute(
             "SELECT chat_gateway, chat_profile, chat_session FROM task_chat_links "
@@ -20,7 +29,6 @@ def origin_key(conn, task_id):
         ).fetchone()
         if row:
             return json.dumps(["chat", row[0], row[1] or "default", row[2]], separators=(",", ":"))
-    cols = {row[1] for row in conn.execute("PRAGMA table_info(tasks)")}
     gateway = "created_on" if "created_on" in cols else "NULL"
     row = conn.execute(f"SELECT {gateway}, created_by FROM tasks WHERE id=?", (task_id,)).fetchone()
     return json.dumps(["creator", row[0] or "local", row[1] or "unknown"], separators=(",", ":"))
diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index cb26c487ba..324d77871c 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -50,6 +50,7 @@ _log = logging.getLogger(__name__)
 # --- Shared micro-helpers (row access, JSON, env, git) ---
 
 from hermes_cli.kanban_db_values import _lossy_text
+from hermes_cli.kanban_admission_class import validate as validate_admission_class  # module scope: not in locals()
 
 
 def _row_get(row: Any, col: str, default: Any = None) -> Any:
@@ -1228,7 +1229,6 @@ def create_task(
     ``workspace_kind=None`` (omitted) inherits a project-scoped board's project;
     an explicit ``"scratch"`` or ``project_id=""`` is a request for no project.
     """
-    from hermes_cli.kanban_admission_class import validate as validate_admission_class
     validate_admission_class(admission_class, admission_frees)
     validate_creation(placement_policy, runs_on=runs_on, workspace_kind=workspace_kind,
                       workspace_path=workspace_path, project=project_id,
diff --git a/hermes_cli/kanban_db_connect.py b/hermes_cli/kanban_db_connect.py
index 257d96fd3e..7e49982776 100644
--- a/hermes_cli/kanban_db_connect.py
+++ b/hermes_cli/kanban_db_connect.py
@@ -1080,6 +1080,8 @@ _LATER_TASK_COLUMNS = (
     ("placement_policy", "placement_policy TEXT"),
     ("admission_class", "admission_class TEXT NOT NULL DEFAULT 'normal'"),
     ("admission_frees", "admission_frees TEXT"),
+    # Local-only: a picked-up foreign card's origin, read from the replica at pickup (its chat links stay out).
+    ("admission_origin", "admission_origin TEXT"),
     ("session_id", "session_id TEXT"),
     # Typed operational reason; neither NULL nor capability implies a human ask.
     ("block_kind", "block_kind TEXT"),
diff --git a/hermes_cli/kanban_db_sync.py b/hermes_cli/kanban_db_sync.py
index e406a1f5f2..4acb33365d 100644
--- a/hermes_cli/kanban_db_sync.py
+++ b/hermes_cli/kanban_db_sync.py
@@ -82,7 +82,7 @@ LOCAL_COLUMNS: dict[str, frozenset[str]] = {
     "tasks": frozenset({
         "claim_lock", "claim_expires", "worker_pid", "worker_started_at", "last_heartbeat_at",
         "workspace_path", "session_id", "project_id", "sync_version", "field_hlc", "lease_holder",
-        "lease_expires", "lease_version",
+        "lease_expires", "lease_version", "admission_origin",
     }),
     "task_links": frozenset(),
     # ``origin_gateway``: the sending gateway as this gateway saw it (relay sender); peers keep their own.
diff --git a/hermes_cli/kanban_origin_creation.py b/hermes_cli/kanban_origin_creation.py
index be04ac9fcf..84cc48faff 100644
--- a/hermes_cli/kanban_origin_creation.py
+++ b/hermes_cli/kanban_origin_creation.py
@@ -74,9 +74,11 @@ def create_with_origin(conn, intent: dict, options: dict) -> str:
     # Options added after intents were first stored: omit them while at their default (None) so an
     # intent stored before the option existed still matches on retry; a real value stays in the
     # envelope and a differing one remains a conflict.
-    for _late in ("chat_origin", "placement_policy"):
+    for _late in ("chat_origin", "placement_policy", "admission_frees"):
         if options.get(_late) is None:
             options.pop(_late, None)
+    if options.get("admission_class") == "normal":
+        options.pop("admission_class")
     options["parents"] = list(options["parents"])
     if options["skills"] is not None:
         options["skills"] = list(options["skills"])
diff --git a/hermes_cli/kanban_worker_node.py b/hermes_cli/kanban_worker_node.py
index 834695119f..dfce743ff6 100644
--- a/hermes_cli/kanban_worker_node.py
+++ b/hermes_cli/kanban_worker_node.py
@@ -467,8 +467,6 @@ def _changes_for(replica: sqlite3.Connection, tid: str, card: sqlite3.Row) -> li
             sender = (row["origin_gateway"] or "") if table == "task_comments" and "origin_gateway" in row.keys() else ""
             out.append(sync.RemoteChange(0, table, row["uid"], "upsert", ksc._row_fields(replica, table, row),
                                          version, "", sender))
-    from hermes_cli.kanban_admission_origin import pickup_links
-    out.extend(pickup_links(replica, tid))
     # Its parent edges too: once the copy is here the feed applies its later links (own_partition), so a copy
     # without the earlier ones disagreed with the Board for as long as it ran.
     for row in replica.execute("SELECT * FROM task_links WHERE child_id = ? ORDER BY parent_id", (tid,)).fetchall():
@@ -493,6 +491,8 @@ def import_cards(conn: sqlite3.Connection, replica: sqlite3.Connection, ids: Ite
         # The copy's foreign parents are gated by the mirror; filled only in the sync round, a parent read as
         # missing in this tick would demote the ready copy to todo and push that to the Board.
         sync.refresh_remote_parents(conn, replica)
+        from hermes_cli.kanban_admission_origin import record_pickup_origins
+        record_pickup_origins(conn, replica, done)
     return done
 
 
diff --git a/tests/hermes_cli/test_kanban_admission_origin.py b/tests/hermes_cli/test_kanban_admission_origin.py
index b58a90d21c..e7f37ed9f2 100644
--- a/tests/hermes_cli/test_kanban_admission_origin.py
+++ b/tests/hermes_cli/test_kanban_admission_origin.py
@@ -34,7 +34,9 @@ def test_pickup_carries_original_chat_without_outbox(live, svc, kanban_home, pro
     for _ in range(2):
         _import(live, "t_copy")
         assert json.loads(origin_key(live, "t_copy")) == ["chat", "source", profile or "default", "original"]
-        assert live.execute("SELECT count(*) FROM task_chat_links WHERE task_id='t_copy'").fetchone()[0] == 3
+        # The origin rides a local-only column: another gateway's chat links never enter the live copy
+        # (test_kanban_sync_foreign_chat_links), so the pickup must not import them to attribute the card.
+        assert not live.execute("SELECT 1 FROM task_chat_links WHERE task_id='t_copy'").fetchone()
         assert not live.execute("SELECT 1 FROM kanban_sync_outbox").fetchone()
         assert wn.evict(live) == ["t_copy"]
         assert not live.execute("SELECT 1 FROM task_chat_links WHERE task_id='t_copy'").fetchone()
diff --git a/tests/hermes_cli/test_kanban_origin_creation.py b/tests/hermes_cli/test_kanban_origin_creation.py
index 043e330be0..1ebc6829fe 100644
--- a/tests/hermes_cli/test_kanban_origin_creation.py
+++ b/tests/hermes_cli/test_kanban_origin_creation.py
@@ -120,7 +120,7 @@ def test_failed_intent_insert_rolls_back_task_and_events(board):
 def _strip_late_options(conn):
     row = conn.execute("SELECT request_id,intent_json FROM origin_creation_intents").fetchone()
     env = json.loads(row["intent_json"])
-    for k in ("chat_origin", "placement_policy"):
+    for k in ("chat_origin", "placement_policy", "admission_class", "admission_frees"):
         env["options"].pop(k, None)
     conn.execute("UPDATE origin_creation_intents SET intent_json=? WHERE request_id=?",
                  (json.dumps(env, sort_keys=True, separators=(",", ":")), row["request_id"]))
@@ -177,3 +177,23 @@ def test_key_held_only_by_an_archived_card_is_reused(board):
         tid = kb.create_task(conn, title="Build", idempotency_key=KEY, origin_intent=intent())
         assert tid != old
         assert kb.get_task(conn, tid).idempotency_key == KEY
+
+
+def test_retry_with_capacity_class_after_pre_admission_intent_conflicts(board):
+    with kbc.connect_closing() as conn:
+        kb.create_task(conn, title="Build", origin_intent=intent())
+        _strip_late_options(conn)
+        with pytest.raises(OriginError) as err:
+            kb.create_task(conn, title="Build", origin_intent=intent(), admission_class="capacity",
+                           admission_frees="frees: worker slots")
+        assert err.value.code == "origin_creation_conflict"
+
+
+def test_courier_create_keeps_capacity_class_and_retry_matches(board):
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="Build", origin_intent=intent(), admission_class="capacity",
+                             admission_frees="frees: worker slots")
+        task = kb.get_task(conn, tid)
+        assert (task.admission_class, task.admission_frees) == ("capacity", "frees: worker slots")
+        assert kb.create_task(conn, title="Build", origin_intent=intent(), admission_class="capacity",
+                              admission_frees="frees: worker slots") == tid
