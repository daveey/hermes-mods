                 raise
-            deferred = gateway_deferral(wall, model or (frozen.get('model') or {}).get('default'),
-                                        (frozen.get('model') or {}).get('provider'), None)
+            deferred = gateway_deferral(wall, model or (frozen.get('model') or {}).get('default'), provider, None)
             if deferred is None:
