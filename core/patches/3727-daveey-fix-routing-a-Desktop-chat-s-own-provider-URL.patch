From 78c49a510ba5442d3b72b5bec6d96107f667dc39 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 17:59:48 +0000
Subject: [PATCH] [daveey] fix(routing): a Desktop chat's own provider URL does
 not block the walled-pin reroute

route_runtime re-raised every SubscriptionQuotaUnavailable whose creation request had any
base_url. Every Desktop GUI chat freezes its provider's own endpoint into that request, so a
walled Codex default pin refused each turn (MacBook chat 20261025_104956_99e2e1, 11-13) instead
of deferring to the agent build's in-class reroute. Use overrides_endpoint(), as the managed
resolver does; a launch key or a foreign endpoint still refuses.

Detection: one WARNING per wall episode and reason when a wall of 6 h or more is not deferred
(routing: walled pin not deferred (reason=key|endpoint|explicit|no-target|no-session)).
Gateway tests now build the policy through build_policy, with the real GUI request shape.

Self-heal t_01a1d5fbc022d996 (defect agent-13b91b3e1b).

Proof: RED on 170ddf9da2 (new tests, old code): 3 failed. GREEN: 20/20 in the file; 483/483 across
the 33 test files that import session_worker_construct / model_routing_walls / model_routing_managed.
Mutants (sdlc-review mutants.py, 9 by exact anchor: endpoint/key checks dropped, reason label swapped,
6 h threshold dropped, non-numeric reset guard, per-episode dedup, each no-session / no-target / explicit
log): 9 killed. A foreign base_url is normally refused earlier by the managed resolver, so its route_runtime
branch is pinned by an injected-wall test alongside the launch-key one.
---
 agent/model_routing_walls.py           |  22 +++++
 gateway/session_worker_construct.py    |  12 ++-
 tests/agent/test_walled_default_pin.py | 132 +++++++++++++++++++++++--
 3 files changed, 152 insertions(+), 14 deletions(-)

diff --git a/agent/model_routing_walls.py b/agent/model_routing_walls.py
index 4df0329dcd..70e2fbe0cb 100644
--- a/agent/model_routing_walls.py
+++ b/agent/model_routing_walls.py
@@ -110,6 +110,25 @@ def log_reroute(wall, metadata):
                    metadata["selected_provider"], metadata["selected_model"], reset_pt(wall.resets_at))
 
 
+_NOT_DEFERRED_SEEN: set = set()
+
+
+def log_not_deferred(wall, reason):
+    """One WARNING per wall episode and reason when the pre-build lookup keeps a far wall's refusal.
+
+    A wall under ``WALL_REROUTE_MIN_SECONDS`` is meant to hold, so it stays quiet; a far one that
+    refuses every turn names why (``key``, ``endpoint``, ``explicit``, ``no-target``, ``no-session``)."""
+    reset = getattr(wall, "resets_at", None)
+    if not isinstance(reset, (int, float)) or reset - time.time() < WALL_REROUTE_MIN_SECONDS:
+        return
+    episode = (getattr(wall, "provider", None), getattr(wall, "model", None), int(reset), reason)
+    if episode in _NOT_DEFERRED_SEEN:
+        return
+    _NOT_DEFERRED_SEEN.add(episode)
+    logger.warning("routing: walled pin not deferred (reason=%s) %s/%s until %s", reason, wall.provider,
+                   wall.model, reset_pt(reset))
+
+
 def predicted_target(config, level, wall):
     """Other ``(provider, model)`` routes that can serve *level* now (the allocator picks among them)."""
     from agent.credential_pool import load_pool
@@ -136,6 +155,7 @@ def gateway_deferral(wall, model, provider, config):
     from agent.model_routing_runtime import current_routing_session
     session_id = current_routing_session()
     if not session_id:
+        log_not_deferred(wall, "no-session")
         return None
     managed = managed_config(config)
     if managed is None:
@@ -147,10 +167,12 @@ def gateway_deferral(wall, model, provider, config):
     row = peek_route(session_id, level)
     followed = follows_reroute(row, model)
     if followed is None and not may_reroute(wall, row, request_pin_source(model, provider, managed)):
+        log_not_deferred(wall, "explicit")
         return None
     if followed is None:
         targets = predicted_target(managed, level, wall)
         if not targets:
+            log_not_deferred(wall, "no-target")
             return None  # nothing else in the class can serve: the refusal stands
         notice = reroute_notice(wall, targets[0][1] if len({p for p, _ in targets}) == 1 else None)
     else:
