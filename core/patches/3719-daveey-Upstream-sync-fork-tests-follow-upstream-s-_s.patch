From 254119c6f5bba117b32b325cb88a978af2ec5180 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 17:18:09 +0000
Subject: [PATCH] [daveey] Upstream sync: fork tests follow upstream's
 _seed_tree root arg and delegation explicit_base_url

---
 tests/pm/test_account_seed.py               | 4 ++--
 tests/tools/test_delegate_route_conflict.py | 5 +++--
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/tests/pm/test_account_seed.py b/tests/pm/test_account_seed.py
index e6b76011e8..32e126c6a0 100644
--- a/tests/pm/test_account_seed.py
+++ b/tests/pm/test_account_seed.py
@@ -392,10 +392,10 @@ def test_homes_on_different_locks_do_not_rerun_each_others_seed(tmp_path, monkey
     merges = []
     real_seed_tree = packages._seed_tree
 
-    def counting_seed_tree(src, dst):
+    def counting_seed_tree(src, dst, *rest):  # upstream added the cache ``root`` argument
         if src.parent.name == "uv-cache":  # one payload bucket merged; nested calls recurse
             merges.append(src)
-        real_seed_tree(src, dst)
+        real_seed_tree(src, dst, *rest)
 
     monkeypatch.setattr(packages, "_seed_tree", counting_seed_tree)
 
diff --git a/tests/tools/test_delegate_route_conflict.py b/tests/tools/test_delegate_route_conflict.py
index cfb3530697..437807c507 100644
--- a/tests/tools/test_delegate_route_conflict.py
+++ b/tests/tools/test_delegate_route_conflict.py
@@ -24,12 +24,13 @@ def route_call():
         children.append(child)
         return child
 
-    def runtime(*, requested, target_model):
+    def runtime(*, requested, target_model, explicit_base_url=None):
+        # Upstream hands delegation.base_url through as explicit_base_url; the resolver keeps it.
         endpoints = {"openai-codex": "https://chatgpt.com/backend-api/codex",
                      "anthropic": "https://api.anthropic.com",
                      "gemini": "https://generativelanguage.googleapis.com"}
         return {"provider": requested, "model": target_model,
-                "base_url": endpoints.get(requested, "https://relay.example.com/v1"),
+                "base_url": explicit_base_url or endpoints.get(requested, "https://relay.example.com/v1"),
                 "api_key": "synthetic-token",
                 "api_mode": "anthropic_messages"}
 
-- 
2.43.0

