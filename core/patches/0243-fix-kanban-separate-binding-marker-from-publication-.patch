From fdc1c5b138ab902fd0e2cf0efe70bae9fc551ec2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 11:53:57 +0000
Subject: [PATCH] fix(kanban): separate binding marker from publication version
 [daveey]

---
 hermes_cli/kanban_origin_ledger.py            | 7 ++++++-
 tests/hermes_cli/test_kanban_origin_ledger.py | 7 +++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_origin_ledger.py b/hermes_cli/kanban_origin_ledger.py
index c1fe05289b..62f18da556 100644
--- a/hermes_cli/kanban_origin_ledger.py
+++ b/hermes_cli/kanban_origin_ledger.py
@@ -135,7 +135,12 @@ def accept_binding(*, path: Path, replica: Path, binding: dict, request_id: str,
     owner = binding["owner"]
     if any(task.get(field) != owner[field] for field in ("gateway", "profile", "board")) or task.get("id") != owner["task_id"]:
         raise ValueError("origin_publication_mismatch")
-    if binding not in task.get("origin_bindings", []):
+    # The immutable marker is published BEFORE the server assigns a record
+    # version. Only the courier envelope adds that publication lower bound.
+    marker = {k: v for k, v in binding.items() if k != "publication_version"}
+    markers = [{k: v for k, v in m.items() if k != "publication_version"}
+               for m in task.get("origin_bindings", []) if isinstance(m, dict)]
+    if marker not in markers:
         return {"status": "pending", "code": "origin_publication_pending"}
     resolved = resolve_session(binding["origin"]["session"])
     if not isinstance(resolved, str) or not resolved:
diff --git a/tests/hermes_cli/test_kanban_origin_ledger.py b/tests/hermes_cli/test_kanban_origin_ledger.py
index 51b0436a6a..d74673e82f 100644
--- a/tests/hermes_cli/test_kanban_origin_ledger.py
+++ b/tests/hermes_cli/test_kanban_origin_ledger.py
@@ -145,6 +145,13 @@ def test_different_owners_can_reuse_binding_id(world):
     assert len(ledger.obligations(world[0], gateway="origin", profile="default", sessions=["s_old"])) == 2
 
 
+def test_publication_marker_does_not_need_future_server_version(world):
+    _path, replica, binding = world
+    marker = {k: v for k, v in binding.items() if k != "publication_version"}
+    publish(replica, binding, origin_bindings=[marker])
+    assert accept(world)["status"] == "accepted"
+
+
 def test_receipt_requires_publication_and_survives_replica_loss(world):
     path, replica, binding = world
     assert accept(world) == {"status": "pending", "code": "origin_publication_pending"}
-- 
