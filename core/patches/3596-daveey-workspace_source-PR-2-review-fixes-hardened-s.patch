diff --git a/tests/hermes_cli/test_kanban_source_launch.py b/tests/hermes_cli/test_kanban_source_launch.py
index 1c676c2bb8..60e341f4ec 100644
--- a/tests/hermes_cli/test_kanban_source_launch.py
+++ b/tests/hermes_cli/test_kanban_source_launch.py
@@ -271,6 +271,38 @@ def test_old_board_skips_card_with_replica_custody(conn, board, dispatcher):
     assert spawned == [] and kbs.board_lacks_source()
 
 
+def _custody_card(conn, title):
+    tid = kb.create_task(conn, title=title, assignee="worker")
+    with kbc.write_txn(conn):
+        conn.execute("UPDATE kanban_sync_state SET applying=1")
+        conn.execute("UPDATE tasks SET workspace_kind='worktree', workspace_source=?, workspace_custody=? WHERE id=?",
+                     (json.dumps(manifest()), json.dumps({"source_holder": "hub", "state": "published",
+                                                          "manifest_revision": 3}), tid))
+        conn.execute("UPDATE kanban_sync_state SET applying=0")
+    return tid
+
+
+def test_old_board_skips_every_later_card_with_replica_custody(conn, board, dispatcher, monkeypatch):
+    """Once this process knows the Board is old, EVERY later custody card is refused too (not only the first one
+    that tripped the detection), and none reaches the legacy resolver."""
+    from hermes_cli import kanban_db_dispatch as d
+    dispatcher.snapshot = None
+    legacy, spawned = [], []
+    monkeypatch.setattr(d._kbw, "resolve_worktree_for_dispatch",
+                        lambda *a, **kw: legacy.append(a[1].id) or (dispatcher.path, "wt/legacy"))
+    for title in ("first", "second", "third"):
+        tid = _custody_card(conn, title)
+        row = conn.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone()
+        d._dispatch_lane_task(conn, row, "worker", d.DispatchResult(), lane="ready", dry_run=False, ttl_seconds=900,
+                              board=None, failure_limit=3, spawn_fn=lambda task, path: spawned.append(task.id),
+                              per_profile_cap=None, per_profile_running={})
+        refused = conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='workspace_source_refused'",
+                               (tid,)).fetchone()
+        assert refused is not None and json.loads(refused[0])["code"] == "board_lacks_source", title
+    assert spawned == [] and legacy == [] and kbs.board_lacks_source()
+    assert launch._GRANTS == {}
+
+
 def test_snapshot_present_null_is_no_custody():
     snap = kws.snapshot_from_row({"workspace_source": None, "workspace_custody": None})
     assert snap is not None and not snap.has_source
diff --git a/tests/hermes_cli/test_kanban_source_publish.py b/tests/hermes_cli/test_kanban_source_publish.py
index 5ce10c19de..1ae13329fa 100644
--- a/tests/hermes_cli/test_kanban_source_publish.py
+++ b/tests/hermes_cli/test_kanban_source_publish.py
@@ -173,6 +173,38 @@ def test_secret_scan_ignores_display_redaction_setting(card, monkeypatch):
     _refused(card, "secret_scan_refused")
 
 
+def test_secret_scan_survives_hostile_diff_config(card):
+    """The clone's own config must not blind the scan: colour codes, missing a/ b/ prefixes, external diff drivers."""
+    for key, value in (("color.ui", "always"), ("color.diff", "always"), ("diff.noprefix", "true"),
+                       ("diff.mnemonicPrefix", "true"), ("diff.external", "/bin/true"), ("core.quotePath", "true")):
+        git(card.path, "config", key, value)
+    commit(card.path, "config.py", f"KEY = '{SECRET}'\n")
+    _refused(card, "secret_scan_refused")
+
+
+def test_secret_in_nondiff_attribute_file_refused(card):
+    """``-diff`` / ``binary`` attributes hide content from a plain patch; the scan reads it as text anyway."""
+    commit(card.path, ".gitattributes", "*.cfg -diff\n*.dat binary\n")
+    commit(card.path, "app.cfg", f"token = {SECRET}\n")
+    _refused(card, "secret_scan_refused")
+
+
+def _pem(kind: str) -> str:
+    body = "\n".join(["b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW"] * 5)
+    return f"-----BEGIN {kind}PRIVATE KEY-----\n{body}\n-----END {kind}PRIVATE KEY-----\n"
+
+
+@pytest.mark.parametrize("name", ["deploy/id_ed25519", "deploy/notes.txt", "deploy/server.cert"])
+def test_multiline_private_key_refused(card, name):
+    commit(card.path, name, _pem("OPENSSH "))
+    _refused(card, "secret_scan_refused")
+
+
+def test_denylisted_non_ascii_path_refused(card):
+    commit(card.path, "dé/server.pem", "not even a key\n")
+    _refused(card, "secret_scan_refused")
+
+
 def test_lfs_and_submodules_refused(card):
     commit(card.path, ".gitattributes", "*.bin filter=lfs diff=lfs merge=lfs -text\n")
     _refused(card, "source_lfs_unsupported")
