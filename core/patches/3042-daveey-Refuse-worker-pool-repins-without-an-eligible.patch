 .../test_kanban_pool_carried_inputs.py        |  2 +-
 tests/hermes_cli/test_kanban_pool_queue.py    |  2 +-
 tests/hermes_cli/test_kanban_worker_repin.py  | 61 ++++++++++++++++++-
 5 files changed, 76 insertions(+), 8 deletions(-)

