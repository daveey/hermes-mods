From a13f8cbb6ee2d1a74d5acf4c2c50b1723f5003ff Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 18:12:47 -0800
Subject: [PATCH] fix(doctor): plural secret flags and NAME=value assignments
 in the argv mask

Review follow-up, failing closed where the last round left gaps:
- plural secret words count (--github-tokens, --bot-tokens); count flags
  like --max-tokens are already public
- boolean secret-named flags (--isolated-auth, --no-credentials,
  --no-ask-password) are public, so they no longer hide the profile name
  after them
- NAME=value tokens (ssh -o ServerAliveInterval=15, API_TOKEN=...) are
  judged like --flag=value: the value under its name, not the whole token as
  one random-looking word

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_state_argv_secrets.py            | 13 ++++++++++---
 tests/hermes_state/test_argv_secrets.py | 18 ++++++++++++++++++
 2 files changed, 28 insertions(+), 3 deletions(-)

diff --git a/hermes_state_argv_secrets.py b/hermes_state_argv_secrets.py
index b1cc43dd65e..3b327073d50 100644
--- a/hermes_state_argv_secrets.py
+++ b/hermes_state_argv_secrets.py
@@ -17,21 +17,24 @@ MASK = "***"
 # A flag is secret-named when a part of its name is, or ends with, a secret word (--api-key, --apikey,
 # --client-secret-value, --token-b64, --auth-header) -- fail closed: a new suffix stays secret -- unless its LAST
 # part names a setting about the secret rather than the secret (--api-key-timeout, --token-env, --key-file).
-_SECRET_WORD = re.compile(r"(?:key|token|secret|passw(?:or)?d|passwd|pwd|auth|credentials?|cookie|bearer)$",
+_SECRET_WORD = re.compile(r"(?:key|token|secret|passw(?:or)?d|passwd|pwd|auth|credential|cookie|bearer)s?$",
                           re.IGNORECASE)
 _SETTING_SUFFIXES = frozenset({
     "file", "files", "env", "timeout", "ttl", "name", "names", "id", "ids", "path", "paths", "dir", "url", "uri",
     "host", "port", "count", "limit", "size", "length", "len", "mode", "type", "kind", "format", "store", "backend",
-    "provider", "browser", "helper", "cmd", "command", "tokens", "keys", "enabled", "required", "only",
+    "provider", "browser", "helper", "cmd", "command", "enabled", "required", "only",
 })
 # Flags that LOOK secret-named but carry public, identifying values.
 _PUBLIC_FLAGS = frozenset({"--ssh-session-token-file", "--token-file", "--key-file", "--auth-file",
                            "--keychain", "--monkey", "--keyboard", "--author", "--authority",
                            "--max-tokens", "--min-tokens", "--cache-read-tokens", "--token-env",
-                           "--idempotency-key", "--step-key", "--passkey-browser"})
+                           "--idempotency-key", "--step-key", "--passkey-browser",
+                           # booleans: they take no value, so the next positional (a profile name) is not theirs
+                           "--isolated-auth", "--no-credentials", "--no-ask-password"})
 _TOKEN_CHARS = re.compile(r"^[A-Za-z0-9_+=.~-]+$")
 _HEX = re.compile(r"^[0-9a-fA-F-]+$")
 _HERMES_ID = re.compile(r"^(?:t_[0-9a-f]+|\d{8}_\d{6}_[0-9a-z]+|[a-z]+(?:[-_][a-z]+)+)$")
+_ASSIGNMENT = re.compile(r"^([A-Za-z][A-Za-z0-9_.-]*)=")
 _NUMBER = re.compile(r"^[+-]?\d+(?:\.\d+)?$")
 _PATH_START = re.compile(r"^(?:/|~|\.{1,2}/|\\|[A-Za-z]:[\\/])")
 _MIN_BARE_SECRET = 20
@@ -97,5 +100,9 @@ def mask_argv_secrets(argv: list[str]) -> list[str]:
                 out.append(token)
                 mask_next = secret_named
             continue
+        if assignment := _ASSIGNMENT.match(token):  # ssh -o ServerAliveInterval=15, env-style NAME=value
+            name, value = assignment.group(1), token[assignment.end():]
+            out.append(f"{name}={_mask_value(value, secret_named=_is_secret_flag('--' + name))}")
+            continue
         out.append(_mask_value(token, secret_named=False))
     return out
diff --git a/tests/hermes_state/test_argv_secrets.py b/tests/hermes_state/test_argv_secrets.py
index 5963ed0d4d2..23454051732 100644
--- a/tests/hermes_state/test_argv_secrets.py
+++ b/tests/hermes_state/test_argv_secrets.py
@@ -57,6 +57,16 @@ KEY = "q8ZpL2vXk9RtYwB4mN7cQ1sD5fH3jK6g"
             ],
             ["--auth-header", MASK, f"--private-key-pem={MASK}", "--apikey", MASK],
         ),
+        # NAME=value assignments: the value is judged under its name
+        (
+            ["API_TOKEN=abc123", "Config=" + KEY],
+            [f"API_TOKEN={MASK}", f"Config={MASK}"],
+        ),
+        # plural secret lists are secrets too
+        (
+            ["--github-tokens", "Qx7Lm2Zp/w", "--bot-tokens=abc"],
+            ["--github-tokens", MASK, f"--bot-tokens={MASK}"],
+        ),
         # a numeric value after a secret-named flag is the secret
         (
             ["--webhook-secret", "12345678901234567890", "--signing-key=4242424242"],
@@ -120,6 +130,14 @@ def test_secrets_are_masked(argv, expected):
         ],
         ["--model", "Qwen3-Coder-480B-A35B-Instruct"],
         ["--api-key-timeout", "30"],
+        ["profile", "create", "--isolated-auth", "work", "--no-credentials", "scratch"],
+        [
+            "-o",
+            "ServerAliveInterval=15",
+            "-o",
+            "NumberOfPasswordPrompts=0",
+            "HERMES_PROFILE=coder",
+        ],
         # settings about a secret, not the secret: deliberate (an id, a name, an env var, a store, a jar path)
         [
             "--access-key-id",
-- 
