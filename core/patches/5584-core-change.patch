From 5b45a7c56baf641832e4e2e78c8a39c7f2ed3fa9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 09:55:14 +0000
Subject: [PATCH] test(kanban): merge replica route policy without duplicate
 YAML keys [daveey]

Strict config reader rejected appended second model_routing mapping, hiding Board sync and preventing authenticated replica review tests from reaching their original custody assertions. Merge route mapping structurally and read effective sync/config back. Replica file13RED to mandatory+replica files26/0, retries disabled. No production config parser or provenance policy change.
---
 tests/hermes_cli/test_kanban_mandatory_pin.py | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_mandatory_pin.py b/tests/hermes_cli/test_kanban_mandatory_pin.py
index 4878f4ef7e..e7aaed811e 100644
--- a/tests/hermes_cli/test_kanban_mandatory_pin.py
+++ b/tests/hermes_cli/test_kanban_mandatory_pin.py
@@ -122,9 +122,17 @@ def gws(tmp_path, monkeypatch, svc):
         policy += (f"      - model: {model}\n        provider: anthropic\n        billing: subscription\n"
                    "        weight: 1\n        eligible: true\n        funding_verified: true\n"
                    "        capabilities: {tools: true, streaming: true}\n")
+    import hermes_yaml as yaml
     for gateway in (hub, worker):
         path = gateway.home / "config.yaml"
-        path.write_text(path.read_text() + policy)
+        config = yaml.safe_load(path.read_text())
+        config["model_routing"] = yaml.safe_load(policy)["model_routing"]
+        path.write_text(json.dumps(config))
+        # The same strict reader the sync/dispatch path uses must retain sync.
+        from hermes_cli.config_effective import load_profile_config_effective
+        effective = load_profile_config_effective(path, fail_closed=True)
+        assert effective["kanban"]["sync"]["enabled"] is True
+        assert effective["model_routing"]["routes"]["deep"][0]["model"] == PIN["model"]
     yield hub, worker
     for gateway in (hub, worker):
         gateway.conn.close()
