From 993b62c3fd04470f4c52754f2ebfaf5bbebfa855 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 23:03:08 +0000
Subject: [PATCH] fix(desktop): reconcile stable mute agreement at guard
 deadline [daveey]

---
 .../src/lib/use-session-parked.test.ts        | 33 +++++++++++++++++++
 apps/desktop/src/lib/use-session-parked.ts    | 22 ++++++++++---
 2 files changed, 51 insertions(+), 4 deletions(-)

diff --git a/apps/desktop/src/lib/use-session-parked.test.ts b/apps/desktop/src/lib/use-session-parked.test.ts
index c6a7a9112f7..8f1874c2913 100644
--- a/apps/desktop/src/lib/use-session-parked.test.ts
+++ b/apps/desktop/src/lib/use-session-parked.test.ts
@@ -32,6 +32,39 @@ it('keeps the stale-page guard after a rendered listed row acknowledges the writ
   expect($muteWriteGuard.get().has(row.id)).toBe(false)
 })
 
+it('reconsiders stable agreement after the stale-page window before a remote unpark', async () => {
+  vi.useFakeTimers()
+  const row = { id: 'stable-agreement', muted: false, profile: 'default' } as SessionInfo
+  setSessions([row])
+
+  const { result } = renderHook(() => {
+    const rows = useStore($sessions)
+
+    return useSessionParked(row.id, rows[0])
+  })
+
+  await act(async () => writeSessionMuted(row, true, async () => ({})))
+  await act(async () => vi.advanceTimersByTimeAsync(2_000))
+  act(() => setSessions([{ ...row, muted: true }]))
+  expect($muteWriteGuard.get().has(row.id)).toBe(true)
+  await act(async () => vi.advanceTimersByTimeAsync(MUTE_WRITE_GUARD_MS - 2_000))
+  expect($muteWriteGuard.get().has(row.id)).toBe(false)
+  await act(async () => vi.advanceTimersByTimeAsync(110_000))
+  act(() => setSessions([{ ...row, muted: false }]))
+  expect(result.current).toBe(false)
+})
+
+it('cancels the agreement deadline when the drawn row unmounts', async () => {
+  vi.useFakeTimers()
+  const row = { id: 'unmounted', muted: true, profile: 'default' }
+  const { unmount } = renderHook(() => useSessionParked(row.id, row))
+
+  await act(async () => writeSessionMuted(row, true, async () => ({})))
+  unmount()
+  await act(async () => vi.advanceTimersByTimeAsync(MUTE_WRITE_GUARD_MS))
+  expect($muteWriteGuard.get().has(row.id)).toBe(true)
+})
+
 it('remembers the drawn row and refreshes its owner and muted state', () => {
   const row = { id: 'drawn-only', connection_id: 'remote', profile: 'work', muted: false }
 
diff --git a/apps/desktop/src/lib/use-session-parked.ts b/apps/desktop/src/lib/use-session-parked.ts
index bf9e57b24f7..3fc5302e287 100644
--- a/apps/desktop/src/lib/use-session-parked.ts
+++ b/apps/desktop/src/lib/use-session-parked.ts
@@ -5,6 +5,7 @@ import {
   $blockedSessionIds,
   $muteWriteGuard,
   isSessionBlocked,
+  MUTE_WRITE_GUARD_MS,
   type MuteRow,
   muteWriteFor,
   rememberParkRow,
@@ -14,13 +15,26 @@ import {
 import { useStoresSelector } from './use-session-slice'
 
 /** [daveey] Whether a row is parked (⌘B): a fresh ⌘B write, else the backend's `row.muted`, else the local list.
- *  Re-renders only when that boolean flips. */
+ *  Selects this session's park boolean and write lifecycle, not unrelated rows' writes. */
 export function useSessionParked(id: null | string | undefined, row: MuteRow | null | undefined): boolean {
+  const write = useStoresSelector([$muteWriteGuard, $sessions], () => (id ? muteWriteFor(id) : undefined))
+
   useEffect(() => {
-    if (row) {
-      rememberParkRow(row)
+    if (!row) {
+      return
+    }
+
+    rememberParkRow(row)
+    const remaining = write ? write.at + MUTE_WRITE_GUARD_MS - Date.now() : 0
+
+    // A signature-stable agreeing page may never render again. Reconcile once
+    // the stale-page window closes, cancelling if the row or write changes.
+    if (write?.acked && row.muted === write.value && remaining > 0) {
+      const timer = setTimeout(() => rememberParkRow(row), remaining)
+
+      return () => clearTimeout(timer)
     }
-  }, [row])
+  }, [row, write])
 
   return useStoresSelector([$blockedSessionIds, $muteWriteGuard, $sessions], () =>
     id
-- 
2.43.0

