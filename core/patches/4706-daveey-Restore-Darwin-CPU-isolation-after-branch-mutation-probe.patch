From d1dcbfe266ff549277b466ec34f542cb03deda09 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 01:35:58 +0000
Subject: [PATCH] [daveey] Restore Darwin CPU isolation after branch mutation
 probe

---
 tests/hermes_cli/test_loop_accounting.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_loop_accounting.py b/tests/hermes_cli/test_loop_accounting.py
index 1fabd8b51cdeb0ff83d1ef325f53577973a445cc..de0012d9461ff144cfab78fbc0587dd5ccc92ddf 100644
--- a/tests/hermes_cli/test_loop_accounting.py
+++ b/tests/hermes_cli/test_loop_accounting.py
@@ -327,7 +327,8 @@ def test_without_procfs_snapshot_folds_exited_threads(monkeypatch):
         return real_listdir(path)
 
     monkeypatch.setattr(la.os, "listdir", no_procfs)
-    # Mutation probe: intentionally leave Darwin's native CPU source live.
+    # Hiding /proc alone leaves macOS's proc_pidinfo source live (80c0c4c277e6), so its rows carry CPU.
+    monkeypatch.setattr(la, "_darwin_thread_cpu", list)
 
     def worker():
         with la.pass_("short-lived"):
