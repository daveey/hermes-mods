diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index f0aa5ba6ab6..8f9879a164e 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -1308,10 +1308,10 @@
     transport_args = {**args, "idempotency_key": transport_key} if transport_key else args
     rid = request_id(self_gw, transport_args, origin_session or "", options)
     prior = remote_state(rid)
-    if foreign_origin and prior in FAILED_STATES:
-        # A forwarded envelope carries the creating run's uid, and a terminally failed request is immutable, so a
-        # later run's retry of the same product key would only collide (request_id_conflict). Give that run its own
-        # transport identity. The product idempotency_key still travels in ``options``, so the receiver dedupes.
+    if foreign_origin and prior == "rejected" and _forward_binding_retry(rid, options, origin_gateway, origin_profile, origin_session,
+                                                creator, run_uid):
+        # Only a definitive pre-create binding refusal permits a later authenticated run's new envelope.
+        # Keep the product key on the wire; receiver creation idempotency still arbitrates duplicate deliveries.
         rid = request_id(self_gw, {**transport_args, "idempotency_key": f"{transport_args.get('idempotency_key') or rid}:run:{run_uid}"},
                          origin_session or "", options)
         prior = remote_state(rid)
@@ -1349,13 +1349,39 @@
             "error": (err or out)[-400:]}
 
 
+def _forward_binding_retry(rid, options, gateway, profile, session, creator, run_uid) -> bool:
+    """A new transport is allowed only for a later run after the exact pre-create binding refusal.
+
+    This is identity selection, not authority: the courier still authenticates the current run and origin.
+    Missing/malformed history, ambiguous failures and keyless creates must retain the original obligation.
+    """
+    if not options.get("idempotency_key"):
+        return False
+    row = _sent_row(rid)
+    try:
+        if not row or row[0] != "rejected":
+            return False
+        result, body = json.loads(row[1]), json.loads(row[2])
+        args = body["args"]
+        return (result.get("code") == "origin_forward_binding_missing"
+                and result.get("status") == "rejected" and result.get("handoff_complete") is False
+                and body.get("action") == "origin-forward" and body.get("coll") == "sessions"
+                and args.get("origin") == {"gateway": gateway, "profile": profile, "session": session}
+                and args.get("creator") == creator
+                and isinstance(args.get("run_uid"), str) and bool(args["run_uid"])
+                and args["run_uid"] != run_uid
+                and args.get("create", {}).get("idempotency_key") == options["idempotency_key"])
+    except (ValueError, TypeError, KeyError, IndexError, AttributeError):
+        return False
+
+
 def _sent_row(rid: str) -> Optional[tuple]:
     try:
         db = reg._ro(reg.hub_db_path())
     except Exception:
         return None
     try:
-        return db.execute("SELECT state, result FROM sent WHERE id = ?", (rid,)).fetchone()
+        return db.execute("SELECT state, result, body FROM sent WHERE id = ?", (rid,)).fetchone()
     except Exception:
         return None
     finally:
diff --git a/tests/hermes_cli/test_kanban_forward_retry_boundary.py b/tests/hermes_cli/test_kanban_forward_retry_boundary.py
new file mode 100644
index 00000000000..7784b0c8961
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_forward_retry_boundary.py
@@ -0,0 +1,67 @@
+"""Fail-closed transport recovery after a definitive binding refusal."""
+import json
+
+import pytest
+
+from hermes_cli import kanban_placement as kp
+
+CREATOR = {"gateway": "w", "profile": "default", "board": "default", "task_id": "t_0123456789abcdef"}
+ORIGIN = {"gateway": "hub", "profile": "default", "session": "s1"}
+
+
+def _history():
+    return {"status": "rejected", "code": "origin_forward_binding_missing", "handoff_complete": False}, {
+        "coll": "sessions", "action": "origin-forward", "args": {
+            "origin": ORIGIN, "creator": CREATOR, "run_uid": "run-1", "create": {"idempotency_key": "product-key"}}}
+
+
+@pytest.mark.parametrize("case", [
+    "valid", "same-run", "keyless", "wrong-key", "wrong-creator", "wrong-origin", "missing-run",
+    "done", "sent", "queued", "failed", "expired", "unknown", "other-code", "handoff", "missing-handoff",
+    "wrong-status", "wrong-action", "wrong-collection", "malformed-body", "malformed-result", "absent", "legacy-row",
+])
+def test_binding_retry_boundary(monkeypatch, case):
+    result, body = _history()
+    options, state, run = {"idempotency_key": "product-key"}, "rejected", "run-2"
+    mutations = {
+        "wrong-key": lambda: options.update(idempotency_key="different"),
+        "wrong-creator": lambda: body["args"].update(creator={**CREATOR, "task_id": "t_abcdef0123456789"}),
+        "wrong-origin": lambda: body["args"].update(origin={**ORIGIN, "session": "elsewhere"}),
+        "missing-run": lambda: body["args"].pop("run_uid"),
+        "other-code": lambda: result.update(code="self_work_refused"),
+        "handoff": lambda: result.update(handoff_complete=True),
+        "missing-handoff": lambda: result.pop("handoff_complete"),
+        "wrong-status": lambda: result.update(status="failed"),
+        "wrong-action": lambda: body.update(action="create"),
+        "wrong-collection": lambda: body.update(coll="tasks"),
+    }
+    mutations.get(case, lambda: None)()
+    if case == "same-run":
+        run = "run-1"
+    if case == "keyless":
+        options = {}
+    if case in ("done", "sent", "queued", "failed", "expired", "unknown"):
+        state = None if case == "unknown" else case
+    row = (state, "{" if case == "malformed-result" else json.dumps(result),
+           "{" if case == "malformed-body" else json.dumps(body))
+    if case == "absent":
+        row = None
+    elif case == "legacy-row":
+        row = row[:2]
+    monkeypatch.setattr(kp, "_sent_row", lambda rid: row)
+    assert kp._forward_binding_retry("rid", options, "hub", "default", "s1", CREATOR, run) == (case == "valid")
+
+
+def test_retry_reads_real_immutable_history(monkeypatch, tmp_path):
+    import sqlite3
+
+    path = tmp_path / "courier.db"
+    result, body = _history()
+    with sqlite3.connect(path) as db:
+        db.execute("CREATE TABLE sent (id TEXT PRIMARY KEY, state TEXT, result TEXT, body TEXT)")
+        db.execute("INSERT INTO sent VALUES (?, ?, ?, ?)", ("original", "rejected", json.dumps(result), json.dumps(body)))
+    monkeypatch.setattr(kp.reg, "hub_db_path", lambda: path)
+    before = path.read_bytes()
+    assert kp._forward_binding_retry("original", {"idempotency_key": "product-key"}, "hub", "default", "s1", CREATOR, "run-2")
+    assert not kp._forward_binding_retry("original", {"idempotency_key": "product-key"}, "hub", "default", "s1", CREATOR, "run-1")
+    assert path.read_bytes() == before
