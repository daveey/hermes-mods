index 00000000000..7417d55b107
--- /dev/null
+++ b/tests/tools/test_kanban_hold_release_safety.py
@@ -0,0 +1,89 @@
+"""Fail-closed park and receipt boundary cases."""
+import json
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_hold_release as release
+from tests.tools import test_kanban_owner_wake_hold_release as cases
+from tests.tools import test_kanban_owner_wake_requeue as wake
+
+board = wake.board
+
+
+@pytest.mark.parametrize("field,value,reason", [
+    ("review_checkpoint", None, "authenticated dependency checkpoint"),
+    ("kind", "time", "authenticated dependency checkpoint"),
+    ("source_status", "triage", "authenticated dependency checkpoint"),
+    ("parents", [], "retained satisfied dependencies"),
+    ("prs", [], "captured PR scope"),
+])
+def test_malformed_park_refused(board, monkeypatch, field, value, reason):
+    with kbc.connect() as conn:
+        task, _, _ = cases.held(conn, monkeypatch)
+        now = int(time.time()) + 2
+        monkeypatch.setattr(time, "time", lambda: now)
+        park = conn.execute("SELECT id,payload FROM task_events WHERE task_id=? AND kind='dependency_wait'",
+                            (task,)).fetchone()
+        payload = json.loads(park["payload"])
+        target = payload["review_checkpoint"] if field in {"parents", "prs"} else payload
+        target[field] = value
+        conn.execute("UPDATE task_events SET payload=? WHERE id=?", (json.dumps(payload), park["id"]))
+        conn.commit()
+        out = wake._unblock(task)
+        assert reason in out.get("error", ""), out
+        assert not any(e.kind == "hold_released" for e in kb.list_events(conn, task))
+
+
+def test_same_second_publication_does_not_burn_receipt(board, monkeypatch):
+    from tests.hermes_cli.kanban_guard_helpers import worker_comment
+    with kbc.connect() as conn:
+        task, _, _ = cases.held(conn, monkeypatch)
+        now = int(time.time()) + 2
+        monkeypatch.setattr(time, "time", lambda: now)
+        worker_comment(conn, task, "dev", cases.reviews.PR)
+        out = wake._unblock(task)
+        assert "strictly follow" in out.get("error", ""), out
+        monkeypatch.setattr(time, "time", lambda: now + 1)
+        assert wake._unblock(task).get("ok")
+
+
+def test_replayed_release_refused_after_new_publication(board, monkeypatch):
+    from tests.hermes_cli.kanban_guard_helpers import worker_comment
+    with kbc.connect() as conn:
+        task, _, _ = cases.held(conn, monkeypatch)
+        now = int(time.time()) + 2
+        monkeypatch.setattr(time, "time", lambda: now)
+        assert wake._unblock(task).get("ok")
+        monkeypatch.setattr(time, "time", lambda: now + 1)
+        worker_comment(conn, task, "dev", cases.reviews.PR)
+        monkeypatch.setattr(time, "time", lambda: now + 2)
+        out = wake._unblock(task)
+        assert "already used" in out.get("error", ""), out
+
+
+@pytest.mark.parametrize("field,value", [("scope", "all"), ("merge_authorized", True),
+                                       ("via", "unblocked"), ("park", {"run_uid": "wrong"}),
+                                       ("prs", []), ("prs", [None])])
+def test_invalid_receipt_never_releases(board, monkeypatch, field, value):
+    with kbc.connect() as conn:
+        task, _, _ = cases.held(conn, monkeypatch)
+        now = int(time.time()) + 2
+        monkeypatch.setattr(time, "time", lambda: now)
+        assert wake._unblock(task).get("ok")
+        event = conn.execute("SELECT id,payload FROM task_events WHERE task_id=? AND kind='hold_released'",
+                             (task,)).fetchone()
+        payload = json.loads(event["payload"])
+        payload[field] = value
+        conn.execute("UPDATE task_events SET payload=? WHERE id=?", (json.dumps(payload), event["id"]))
+        conn.commit()
+        assert release.released_after(conn, task, now - 1, [cases.reviews.PR]) is False
+
+
+def test_generic_unblock_still_refuses_ready(board, monkeypatch):
+    with kbc.connect() as conn:
+        task, _, _ = cases.held(conn, monkeypatch)
+        assert kb.unblock_task(conn, task) is False
+        assert not any(e.kind == "unblocked" for e in kb.list_events(conn, task))
