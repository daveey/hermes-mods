From abb17e80bfe4368acde2a0430170a19c28e97f23 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:20:20 +0000
Subject: [PATCH] fix(tui_gateway): a remote Stop names the login that pressed
 it again, not the host owner [daveey]

The merge made _transport_auth_user_id return the host owner's OS subject for every login (upstream
8497ce93189), so the fork's turn_stopped notice read 'Stopped by 1000' for the Redde app. The label now
reads the transport's own authenticated login; row ownership keeps upstream's owner subject.
---
 tui_gateway/methods_session_interrupt.py | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/tui_gateway/methods_session_interrupt.py b/tui_gateway/methods_session_interrupt.py
index d239c4dfb9c..5d4c4a52ea5 100644
--- a/tui_gateway/methods_session_interrupt.py
+++ b/tui_gateway/methods_session_interrupt.py
@@ -37,9 +37,16 @@ _STOP_NOTICE_KIND = "turn_stopped"
 
 
 def _stop_issuer_label(transport) -> str:
-    """The login that sent a Stop (``basic:redde`` -> ``redde``), or ``Desktop`` for the local credential."""
-    auth = _transport_auth_user_id(transport)
-    return auth.split(":", 1)[-1] if auth else "Desktop"
+    """The login that sent a Stop (``basic:redde`` -> ``redde``), or ``Desktop`` for the local credential.
+
+    Read from the transport's own login, not ``_transport_auth_user_id``: since the upstream merge that
+    names the row OWNER (the host owner's OS subject for every login), which would label every remote
+    Stop ``uid:<n>`` instead of the person who pressed it."""
+    from gateway.session_identity import is_authenticated_identity
+    identity = getattr(transport, "auth_identity", None)
+    if not is_authenticated_identity(identity):
+        return "Desktop"
+    return str((identity or {}).get("user_id")).strip()
 
 
 def _note_stop_issuer(sid: str, session: dict, transport) -> None:
-- 
