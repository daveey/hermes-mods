From feab1a4d99cf0b531b3d5429ec075629f4fa75dc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 06:54:10 +0000
Subject: [PATCH] fix(kanban): retain review-owned class preclaim accounting
 [daveey]

Problem: generic unroutable-class preflight resolved review routes before the existing bounded refusal handler, leaking unknown-author ReviewModelUnavailable out of dispatch ticks.
Root happened: generic class admission did not honor is_review_run, including skill-classified ready retries. Root not caught: original class preclaim tests covered implementation lanes, not review-owned admission composition.
Fix: leave review-owned route eligibility and structural refusal/escalation to the existing review path; no broad exception swallowing, author fabrication, quota bypass or model pins.
Proof: new helper review+ready cases and original escalation reproduced three failures before fix. Corrected saved12-file combined canonical run290passed0failed, retries disabled. Extended actual ready-retry escalation integration reveals a remaining distinct generic quota preflight caller invoking review resolution before claim; final focused file25passed1failed. Preserved failing regression; this increment is NOT review/landing ready. Existing review refusal accounting is post-claim; full-dispatch zero-claim acceptance remains unresolved. No broad consumer run or fleet mutations.
---
 hermes_cli/kanban_class_walls.py              |  3 ++
 .../test_kanban_managed_pin_policy.py         | 33 +++++++++++++++++--
 2 files changed, 33 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_class_walls.py b/hermes_cli/kanban_class_walls.py
index fd2fbfa2a8..aff3759059 100644
--- a/hermes_cli/kanban_class_walls.py
+++ b/hermes_cli/kanban_class_walls.py
@@ -16,8 +16,11 @@ def unroutable_class(conn, task_id, *, lane):
 
     task = kb.get_task(conn, task_id)
     from hermes_cli.kanban_quota_episode import active
+    from hermes_cli.kanban_review_model import is_review_run
     if task is None or active(conn, task_id):
         return None  # the existing episode owns its typed hold and reset deadline
+    if is_review_run(conn, task, lane):
+        return None  # review owns provenance refusal, bounded escalation and route eligibility
     model, _, _ = resolve_model_tier(conn, routing_view(task), lane=lane)
     if not is_class_selector(model):
         return None
diff --git a/tests/hermes_cli/test_kanban_managed_pin_policy.py b/tests/hermes_cli/test_kanban_managed_pin_policy.py
index 04bafa55d8..e4fd2f4059 100644
--- a/tests/hermes_cli/test_kanban_managed_pin_policy.py
+++ b/tests/hermes_cli/test_kanban_managed_pin_policy.py
@@ -329,14 +329,41 @@ def test_class_routed_implementer_receipts_do_not_gate_review_admission(board):
         'review_unpinned')
 
 
-def test_repeated_identical_review_refusal_moves_to_a_visible_block(board, monkeypatch):
-    """An unroutable review class (its registry pool unavailable) defers, and the third identical refusal stops
-    deferring silently."""
+@pytest.mark.parametrize('lane', ['review', 'ready'])
+def test_review_owned_preclaim_does_not_resolve_generic_class(board, monkeypatch, lane):
+    """Review lanes and skill-classified ready retries retain review-owned refusal accounting."""
+    from hermes_cli.kanban_class_walls import unroutable_class
+    from hermes_cli import kanban_model_tier as tier
+    from hermes_cli.kanban_review_model import is_review_run
+    conn, _ = board
+    tid = _hand_off_for_review(conn, {'review_model': FABLE})
+    _receipts(conn, tid, route=('class:deep', None))
+    if lane == 'ready':
+        conn.execute("UPDATE tasks SET status='ready', skills=? WHERE id=?", ('["sdlc-review"]', tid))
+        conn.commit()
+    assert is_review_run(conn, kb.get_task(conn, tid), lane)
+    before = list(conn.iterdump())
+
+    def generic_resolution_forbidden(*args, **kwargs):
+        pytest.fail('generic preclaim must not resolve a review route')
+
+    monkeypatch.setattr(tier, 'resolve_model_tier', generic_resolution_forbidden)
+    assert unroutable_class(conn, tid, lane=lane) is None
+    assert list(conn.iterdump()) == before  # no claim, run, receipt or author changes
+
+
+@pytest.mark.parametrize('lane', ['review', 'ready'])
+def test_repeated_identical_review_refusal_moves_to_a_visible_block(board, monkeypatch, lane):
+    """With no eligible class route, the third identical refusal stops deferring silently."""
     from hermes_cli.kanban_db_dispatch import dispatch_once
     DEFERRAL_LIMIT = 3  # hermes_cli.kanban_review_model.DEFERRAL_LIMIT
     monkeypatch.setenv('HERMES_KANBAN_RATE_LIMIT_COOLDOWN_SECONDS', '0')
     conn, _ = board
     tid = _hand_off_for_review(conn, {'review_model': 'class:deep'})
+    _receipts(conn, tid, route=('class:deep', None))
+    if lane == 'ready':
+        conn.execute("UPDATE tasks SET status='ready', skills=? WHERE id=?", ('["sdlc-review"]', tid))
+        conn.commit()
     _disable_anthropic()
     seen = []
     for attempt in range(1, DEFERRAL_LIMIT + 1):
