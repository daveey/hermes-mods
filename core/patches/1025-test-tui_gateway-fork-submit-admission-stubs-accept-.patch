From aa8745f14dfe72c587b73b7accffff7ee0161974 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:16:11 +0000
Subject: [PATCH] test(tui_gateway): fork submit/admission stubs accept
 upstream's report_ownership_refusal kwarg [daveey]

---
 tests/tui_gateway/test_kanban_notify_poller.py    | 3 ++-
 tests/tui_gateway/test_update_admission_caller.py | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/tests/tui_gateway/test_kanban_notify_poller.py b/tests/tui_gateway/test_kanban_notify_poller.py
index 3ea2cd99505..3f88dcdd2b0 100644
--- a/tests/tui_gateway/test_kanban_notify_poller.py
+++ b/tests/tui_gateway/test_kanban_notify_poller.py
@@ -268,7 +268,8 @@ class TestNotificationPollerLoopKanbanWiring:
         monkeypatch.setattr(
             server, "_emit", lambda event, sid, payload=None: emits.append((event, payload))
         )
-        def accept(rid, sid, sess, text):
+        # Fork: upstream's submit path now passes report_ownership_refusal (and other kwargs) through.
+        def accept(rid, sid, sess, text, **_kwargs):
             # Model execution is replaced, including its concrete admission receipt.
             server._emit("message.start", sid)
             submits.append(text)
diff --git a/tests/tui_gateway/test_update_admission_caller.py b/tests/tui_gateway/test_update_admission_caller.py
index a727d73ded2..c67a0172bb5 100644
--- a/tests/tui_gateway/test_update_admission_caller.py
+++ b/tests/tui_gateway/test_update_admission_caller.py
@@ -20,7 +20,8 @@ def test_prompt_worker_refusal_preserves_replacement_turn(tmp_path, monkeypatch)
         assert accepted
         session["running"] = True
     monkeypatch.setattr(server, "_ensure_session_db_row", lambda *a: True)
-    monkeypatch.setattr(server, "_admit_prompt_turn", lambda *a: ([], SimpleNamespace()))
+    # Fork: upstream's _admit_prompt_turn takes a keyword-only report_ownership_refusal.
+    monkeypatch.setattr(server, "_admit_prompt_turn", lambda *a, **kw: ([], SimpleNamespace()))
     monkeypatch.setattr(server, "_session_profile_runtime_scope", lambda *a: nullcontext())
     monkeypatch.setattr(server, "_routing_provenance_db", lambda *a: nullcontext(None))
     monkeypatch.setattr(server, "_sessions", {})
-- 
2.55.0

