From 472e0e5ae42c3451a6ec40822a83c465eca0c65d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 02:29:54 +0000
Subject: [PATCH] fix(desktop): settle plugin filter clearing before restoring
 paging [daveey]

---
 .../hooks/session-filter-paging.test.ts       | 13 +++++++
 .../session/hooks/use-session-list-actions.ts | 39 +++++++++++++------
 2 files changed, 40 insertions(+), 12 deletions(-)

diff --git a/apps/desktop/src/app/session/hooks/session-filter-paging.test.ts b/apps/desktop/src/app/session/hooks/session-filter-paging.test.ts
index b63812e946..d743b7a00e 100644
--- a/apps/desktop/src/app/session/hooks/session-filter-paging.test.ts
+++ b/apps/desktop/src/app/session/hooks/session-filter-paging.test.ts
@@ -39,6 +39,19 @@ it('deepens the page for a plugin-only filter and restores it on disposal', asyn
     })
     expect($sessionsLimit.get()).toBe(300)
     expect(listSidebarSessions).toHaveBeenCalledTimes(1)
+
+    // React effect cleanup + setup replaces the contribution in one tick.
+    // Selection/session-map updates must not shrink and reload the page.
+    for (let update = 0; update < 2; update++) {
+      await act(async () => {
+        dispose()
+        dispose = registry.register({ area: SESSION_FILTER_AREA, id: 'paging-lane', data: { match: () => false } })
+        expect($sessionsLimit.get()).toBe(300)
+      })
+      expect($sessionsLimit.get()).toBe(300)
+      expect(listSidebarSessions).toHaveBeenCalledTimes(1)
+    }
+
     await act(async () => dispose())
     expect($sessionsLimit.get()).toBe(50)
     expect(listSidebarSessions).toHaveBeenCalledTimes(2)
diff --git a/apps/desktop/src/app/session/hooks/use-session-list-actions.ts b/apps/desktop/src/app/session/hooks/use-session-list-actions.ts
index c87c952198..003dcfec67 100644
--- a/apps/desktop/src/app/session/hooks/use-session-list-actions.ts
+++ b/apps/desktop/src/app/session/hooks/use-session-list-actions.ts
@@ -603,16 +603,26 @@ export function useSessionListActions({ profileScope }: UseSessionListActionsArg
   // paged to by hand is what it returns to.
   const unfilteredLimit = useRef<null | number>(null)
 
-  useEffect(
-    () =>
-      $sidebarFiltersActive.subscribe(active => {
-        if (active) {
-          unfilteredLimit.current ??= $sessionsLimit.get()
+  // This ref retains the user's pre-filter page size; it does not mirror an atom.
+  // eslint-disable-next-line no-restricted-syntax
+  useEffect(() => {
+    let disposed = false
 
-          if (raiseSessionsLimit(SIDEBAR_FILTERED_PAGE_SIZE)) {
-            void refreshSessions()
+    const unsubscribe = $sidebarFiltersActive.subscribe(active => {
+      if (active) {
+        unfilteredLimit.current ??= $sessionsLimit.get()
+
+        if (raiseSessionsLimit(SIDEBAR_FILTERED_PAGE_SIZE)) {
+          void refreshSessions()
+        }
+      } else {
+        // Plugins replace contributions during effect cleanup/setup. Only a
+        // settled clear should shrink the page, not that synchronous gap.
+        queueMicrotask(() => {
+          if (disposed || $sidebarFiltersActive.get() || unfilteredLimit.current === null) {
+            return
           }
-        } else if (unfilteredLimit.current !== null) {
+
           const restored = unfilteredLimit.current
           unfilteredLimit.current = null
 
@@ -620,10 +630,15 @@ export function useSessionListActions({ profileScope }: UseSessionListActionsArg
             $sessionsLimit.set(restored)
             void refreshSessions()
           }
-        }
-      }),
-    [refreshSessions]
-  )
+        })
+      }
+    })
+
+    return () => {
+      disposed = true
+      unsubscribe()
+    }
+  }, [refreshSessions])
 
   // [daveey] A failed list leaves its owners stale: their rows paint as cached copies (no red/grey stripe, 0/0 kanban
   // badge) and only a SUCCESSFUL list makes them live again. Nothing used to re-list on its own: after a Desktop
-- 
2.43.0

