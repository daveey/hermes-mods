 tests/cron/test_drain_hold_defers_tick.py  | 139 +++++++++++++++++++++
 tests/gateway/test_core_update_cron_cut.py |  98 +++++++++++++++
 4 files changed, 333 insertions(+), 4 deletions(-)
 create mode 100644 tests/cron/test_drain_hold_defers_tick.py
 create mode 100644 tests/gateway/test_core_update_cron_cut.py

