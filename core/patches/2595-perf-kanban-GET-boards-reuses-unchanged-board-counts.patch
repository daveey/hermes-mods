From d29b70bd0f3ba1a459b39c306be8c67ad68f89ea Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 10:02:52 +0000
Subject: [PATCH] perf(kanban): GET /boards reuses unchanged board counts and
 skips the projects db [daveey]

The Desktop polls GET /api/plugins/kanban/boards about 0.29 times/s. Every call
opened a fresh guarded read-only connection per board for
`SELECT status, COUNT(*) FROM tasks GROUP BY status`, and opened the projects db
although no listed board had a project_id (21-28 CPU-ms per unchanged call on the
captured Mac stores).

- board_counts: keep the last counts per board db path, keyed on
  board_rows.version(path) = (observer generation, dev, ino, schema_version,
  data_version). The version is read before the count query, so a commit during
  the query is re-read next poll. version() None (unobservable board) reads
  uncached and stores nothing; a failed query stores nothing; a hit returns a
  copy. No timer or TTL.
- board_rows.MAX_OBSERVERS 4 -> 16: with 5+ live boards an observer would
  otherwise be evicted and reopened every poll (new generation = permanent miss,
  and it would evict the /board rows observer too). OBSERVER_IDLE_S unchanged.
- list_boards: call _projects_by_id() only when a listed board has a truthy
  project_id. Response shape unchanged.

/board, board_snapshot, board_prewarm behaviour and every cadence are unchanged.

Tests: tests/plugins/test_kanban_boards_poll_counts.py (8). On the parent
f9565195f3, 3 fail: the unchanged-poll test (6 count connections opened on the
second call), the commit test and the bookkeeping-commit test (all 6 boards
re-read instead of only the changed one). Mutants killed: always hit, key without
data_version, store on failed query, no copy on hit.

Benchmark (local fixture on a Linux pool worker, not a Mac number): 6 boards
(default + 5 named), one with 20,001 tasks; parent and candidate in separate
processes, each on a fresh copy of the same fixture at the same path; median
time.process_time over 20 calls after one warm-up, two rounds:
- unchanged list_boards(): parent 15.8 / 17.5 ms, candidate 4.5 / 3.3 ms
- after one status commit to the 20k board (per call): parent 14.6 / 13.5 ms,
  candidate 4.2 / 4.3 ms
- with a project-scoped board added (unchanged): parent 8.8 / 8.2 ms,
  candidate 3.2 / 3.3 ms
JSON responses byte-equal between parent and candidate for the unchanged,
changed and project_id cases (2394 / 2394 / 2795 bytes). The captured Mac stores
are replayed by the owner card after the merge.
---
 plugins/kanban/dashboard/board_counts.py      |  53 ++++-
 plugins/kanban/dashboard/board_rows.py        |   2 +-
 plugins/kanban/dashboard/plugin_api.py        |   3 +-
 .../plugins/test_kanban_boards_poll_counts.py | 209 ++++++++++++++++++
 4 files changed, 261 insertions(+), 6 deletions(-)
 create mode 100644 tests/plugins/test_kanban_boards_poll_counts.py

diff --git a/plugins/kanban/dashboard/board_counts.py b/plugins/kanban/dashboard/board_counts.py
index 0b4896d2e5..1224140d15 100644
--- a/plugins/kanban/dashboard/board_counts.py
+++ b/plugins/kanban/dashboard/board_counts.py
@@ -1,9 +1,31 @@
-"""Switcher counts need no schema reconciliation or writer initialization."""
+"""Switcher counts need no schema reconciliation or writer initialization.
+
+GET /boards is polled continuously, and every board's count query used to open a
+fresh guarded connection. The last counts per board file are kept, keyed on
+``board_rows.version`` (observer generation, file identity, schema_version and
+``PRAGMA data_version``). Any commit by another connection moves that version, so
+an unchanged board costs two PRAGMAs on a retained connection and a changed board
+is read again on the next poll. There is no timer: the key alone decides.
+"""
+from collections import OrderedDict
 from contextlib import closing
 import sqlite3
+import threading
 
 from hermes_cli import kanban_db
 from hermes_cli.kanban_generation import open_ro
+from plugins.kanban.dashboard import board_rows
+
+MAX_CACHED = 64  # board files with remembered counts (one small dict each)
+
+_lock = threading.Lock()
+_cached: "OrderedDict[str, tuple[tuple, dict[str, int]]]" = OrderedDict()
+
+
+def _query(path) -> dict[str, int]:
+    with closing(open_ro(path)) as conn:
+        return {status: int(count) for status, count in conn.execute(
+            "SELECT status, COUNT(*) FROM tasks GROUP BY status")}
 
 
 def board_counts(slug: str) -> dict[str, int]:
@@ -11,10 +33,33 @@ def board_counts(slug: str) -> dict[str, int]:
 
     Use the generation-guarded query-only connection, including its missing WAL
     sidecar fallback. Writer connect still owns integrity checks and migrations.
+    The version is read before the query, so a commit that lands during the query
+    is read again next time. An unobservable board (version None) and a failed
+    query store nothing. A hit returns a copy: callers mutate and serialize it.
     """
     try:
-        with closing(open_ro(kanban_db.kanban_db_path(board=slug))) as conn:
-            return {status: int(count) for status, count in conn.execute(
-                "SELECT status, COUNT(*) FROM tasks GROUP BY status")}
+        path = kanban_db.kanban_db_path(board=slug)
+        key = str(path)
+        ver = board_rows.version(key)
+        if ver is not None:
+            with _lock:
+                hit = _cached.get(key)
+                if hit is not None and hit[0] == ver:
+                    _cached.move_to_end(key)
+                    return dict(hit[1])
+        counts = _query(path)
     except (OSError, ValueError, sqlite3.Error):
         return {}
+    if ver is not None:
+        with _lock:
+            _cached[key] = (ver, dict(counts))
+            _cached.move_to_end(key)
+            while len(_cached) > MAX_CACHED:
+                _cached.popitem(last=False)
+    return counts
+
+
+def clear() -> None:
+    """Forget every remembered count (tests)."""
+    with _lock:
+        _cached.clear()
diff --git a/plugins/kanban/dashboard/board_rows.py b/plugins/kanban/dashboard/board_rows.py
index 3fe72d2d95..51cb357af5 100644
--- a/plugins/kanban/dashboard/board_rows.py
+++ b/plugins/kanban/dashboard/board_rows.py
@@ -46,7 +46,7 @@ log = logging.getLogger(__name__)
 
 T = TypeVar("T")
 
-MAX_OBSERVERS = 4  # board files with a retained observer connection
+MAX_OBSERVERS = 16  # board files with a retained observer (GET /boards observes every live board)
 MAX_ENTRIES = 8  # materialized row sets (board x query params)
 OBSERVER_IDLE_S = 600.0  # an observer unused this long is closed (archived/removed boards)
 
