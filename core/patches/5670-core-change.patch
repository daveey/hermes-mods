From 2170ad6f03f72d04f80865977ee2515efd2e975f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 22:32:37 +0000
Subject: [PATCH] [daveey] Read enrolled courier key with explicit UTF-8
 encoding

---
 hermes_cli/kanban_card_answer_transport.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_card_answer_transport.py b/hermes_cli/kanban_card_answer_transport.py
index 29d3b49ee3..edbf4ce83d 100644
--- a/hermes_cli/kanban_card_answer_transport.py
+++ b/hermes_cli/kanban_card_answer_transport.py
@@ -32,7 +32,7 @@ class Records:
         if (parsed.scheme != 'https' or not parsed.hostname or parsed.username or parsed.password
                 or parsed.query or parsed.fragment):
             raise AnswerRefused('hub_endpoint_invalid')
-        self._key = (path.parent / 'gateway.key').read_text().strip()
+        self._key = (path.parent / 'gateway.key').read_text(encoding='utf-8-sig').strip()
         if not self._key or '\n' in self._key or '\r' in self._key:
             raise AnswerRefused('hub_credential_invalid')
         self._opener = urllib.request.build_opener(_NoRedirect())
