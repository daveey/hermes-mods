From f17d732439b37babb65b2fc05656ba239ecf5373 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 22:35:30 +0000
Subject: [PATCH] [daveey] fix(kanban): ready-wait alerts count from the last
 run's end and name an active clock hold

A run lost to a gateway restart is booked owner_restart_lost, which was not a ready-entry floor, so
chat_wait_unclaimed and held_in_ready measured the wait from the run's claimed event: t_01a1a1dea9c64d6a's
80-min run 163883 read as "ready 80 min with no worker" during its 120 s owner_restart_cooldown (twice on
2026-11-10, after runs 163575 and 163883). The floor now adds owner_restart_lost and the latest
task_runs.ended_at (events and runs paths; the chat-notice SQL prefilter derives from the same constant).
held_in_ready names this episode's guard reason and its run-end clock (until/expired); chat_wait_unclaimed
carries hold_reason/hold_until while a clock guard holds the card, and a failed lookup drops only the hold.
Dispatch and the respawn guard are unchanged (read-only alerting).
---
 hermes_cli/kanban_chat_wait.py                |  55 ++++-
 hermes_cli/kanban_diagnostics.py              |  59 ++++-
 hermes_cli/kanban_parent_unclaimed.py         |  14 +-
 .../test_kanban_ready_wait_restart_floor.py   | 228 ++++++++++++++++++
 tests/tools/test_kanban_unblock_queue.py      |   3 +
 5 files changed, 340 insertions(+), 19 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_ready_wait_restart_floor.py

diff --git a/hermes_cli/kanban_chat_wait.py b/hermes_cli/kanban_chat_wait.py
index 7917de1a787..5839e224117 100644
--- a/hermes_cli/kanban_chat_wait.py
+++ b/hermes_cli/kanban_chat_wait.py
@@ -88,21 +88,63 @@ def notice_text(payload: Any) -> str:
     tid = str(payload.get("parent") or "<card>")[:64]
     title = str(payload.get("parent_title") or "").strip()[:120]
     named = f"{tid} ({title})" if title else tid
+    hold = ""
+    if payload.get("hold_reason") and payload.get("hold_until"):
+        stamp = time.strftime("%H:%M:%SZ", time.gmtime(int(payload["hold_until"])))
+        hold = f"; dispatcher hold {payload['hold_reason']} until {stamp}"
     return (f"{named}, which this chat waits on, has been ready {payload.get('ready_minutes', '?')} min with no "
-            f"worker ({payload.get('queue') or 'queue place unknown'}). " + pu._options(tid) + ".")
+            f"worker ({payload.get('queue') or 'queue place unknown'}{hold}). " + pu._options(tid) + ".")
 
 
-_FLOOR = ", ".join(f"'{k}'" for k in sorted({"created", "promoted", "reclaimed", "unblocked", "claimed",
-                                              "spawned", "continuation_woken", "condition_met", "continued"}))
+def _floor_kinds() -> str:
+    from hermes_cli.kanban_diagnostics import _READY_WAIT_FLOOR_KINDS
+    return ", ".join(f"'{k}'" for k in sorted({*_READY_WAIT_FLOOR_KINDS, "continued"}))
+
+
+# Prefilter only (``pu.ready_since`` decides): the same event floor as the diagnostic, and the latest run's end,
+# so a long run that a restart requeued never counts as ready time. [daveey]
 _CANDIDATES = (
     "SELECT t.id, t.title, t.created_at FROM tasks t "
     "WHERE t.status = 'ready' AND t.claim_lock IS NULL "
     "AND (t.session_id IS NOT NULL OR EXISTS (SELECT 1 FROM kanban_notify_subs s WHERE s.task_id = t.id)) "
-    f"AND COALESCE((SELECT MAX(e.created_at) FROM task_events e WHERE e.task_id = t.id AND e.kind IN ({_FLOOR})), "
-    "t.created_at) BETWEEN ? AND ? ORDER BY t.id"
+    f"AND MAX(COALESCE((SELECT MAX(e.created_at) FROM task_events e WHERE e.task_id = t.id AND e.kind IN "
+    f"({_floor_kinds()})), t.created_at), "
+    "COALESCE((SELECT MAX(r.ended_at) FROM task_runs r WHERE r.task_id = t.id), 0)) "
+    "BETWEEN ? AND ? ORDER BY t.id"
 )
 
 
+def _clock_hold(conn, task_id: str, since: int, now: float) -> dict[str, Any]:
+    """``{"hold_reason", "hold_until"}`` while a clock guard still holds ``task_id``, else ``{}``.
+
+    The reason of this ready episode's latest ``respawn_guarded`` event (at or after ``since``); a latest run
+    lost to an owner restart is the owner-restart cooldown even before the tick that records the guard.
+    Advisory only: a failed lookup drops the hold from the notice, never the notice."""
+    try:
+        return _clock_hold_unchecked(conn, task_id, since, now)
+    except Exception:  # health: allow BLE001 -- the hold is advisory; the notice must still go out
+        _log.debug("chat-wait: clock hold lookup failed for %s", task_id, exc_info=True)
+        return {}
+
+
+def _clock_hold_unchecked(conn, task_id: str, since: int, now: float) -> dict[str, Any]:
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_db_dispatch import _is_owner_restart_run
+    from hermes_cli.kanban_db_dispatch_clock import guard_hold_until
+    reason = None
+    row = conn.execute("SELECT payload FROM task_events WHERE task_id = ? AND kind = 'respawn_guarded' "
+                       "AND created_at >= ? ORDER BY created_at DESC, id DESC LIMIT 1", (task_id, int(since))).fetchone()
+    if row is not None:
+        reason = kb._json_dict(row[0]).get("reason")
+    if not reason:
+        run = conn.execute("SELECT outcome, metadata FROM task_runs WHERE task_id = ? AND ended_at IS NOT NULL "
+                           "ORDER BY ended_at DESC LIMIT 1", (task_id,)).fetchone()
+        if run is not None and _is_owner_restart_run(run):
+            reason = "owner_restart_cooldown"
+    until = guard_hold_until(conn, task_id, str(reason), int(now)) if reason else None
+    return {"hold_reason": str(reason), "hold_until": int(until)} if until else {}
+
+
 def sweep(conn, *, now: Optional[float] = None) -> int:
     """Append the once-per-ready-episode notice for every qualifying card; returns how many were appended."""
     now = time.time() if now is None else now
@@ -114,7 +156,8 @@ def sweep(conn, *, now: Optional[float] = None) -> int:
         if ready_for < THRESHOLD_SECONDS or ready_for > MAX_EPISODE_SECONDS:
             continue
         if pu.post_notice(conn, row["id"], row["id"], wait_key=f"ready@{since}", waited_seconds=ready_for,
-                          ready_seconds=ready_for, parent_title=row["title"], kind=NOTICE_KIND):
+                          ready_seconds=ready_for, parent_title=row["title"], kind=NOTICE_KIND,
+                          extra=_clock_hold(conn, row["id"], since, now)):
             posted += 1
     return posted
 
diff --git a/hermes_cli/kanban_diagnostics.py b/hermes_cli/kanban_diagnostics.py
index 1db4166fe05..b2546617c9e 100644
--- a/hermes_cli/kanban_diagnostics.py
+++ b/hermes_cli/kanban_diagnostics.py
@@ -702,20 +702,56 @@ def _rule_block_unblock_cycling(task, events, runs, now, cfg) -> list[Diagnostic
 
 
 # Events after which a now-ready, unclaimed task must have (re-)entered ready:
-# the classic ready transitions plus every claim/park/wake on the way back.
+# the classic ready transitions plus every claim/park/wake on the way back, and a run lost
+# to a gateway restart (booked ``owner_restart_lost``, not ``reclaimed``: without it an 80-min
+# run read as 80 min ready, hermes-hub 2026-11-10). Other run-ending requeues are bounded by
+# the run's ``ended_at`` (``_last_run_end_ts``), never by kinds a pre-claim check may write. [daveey]
 _READY_WAIT_FLOOR_KINDS = frozenset({
     "created", "promoted", "reclaimed", "unblocked",
     "claimed", "spawned", "continuation_woken", "condition_met", "wake_probe_stale",
     "wake_check_stale",
+    "owner_restart_lost",
 })
 
 
-def _last_ready_entry_ts(events: Iterable[Any]) -> int:
-    """Latest ready-entry floor; a ``continued`` checkpoint counts only when it resumed straight to ready."""
+def _last_run_end_ts(runs: Iterable[Any]) -> int:
+    """Latest ``ended_at`` over ``runs`` (0 if none): a card is never unclaimed-ready while a run is open."""
+    from hermes_cli import kanban_db as kb
+    ends = [kb._to_epoch(_task_field(r, "ended_at", None)) for r in (runs or [])]
+    return int(max([0, *(e for e in ends if e)]))
+
+
+def _last_ready_entry_ts(events: Iterable[Any], runs: Iterable[Any] = ()) -> int:
+    """Latest ready-entry floor; a ``continued`` checkpoint counts only when it resumed straight to ready.
+    The latest run's end bounds it too, whatever event (if any) the requeue left."""
     events = list(events)
     continued_ready = [_event_ts(ev) for ev in events
                        if _event_kind(ev) == "continued" and _parse_payload(ev).get("status") == "ready"]
-    return max([_latest_event_ts(events, _READY_WAIT_FLOOR_KINDS), *continued_ready])
+    return max([_latest_event_ts(events, _READY_WAIT_FLOOR_KINDS), *continued_ready, _last_run_end_ts(runs)])
+
+
+def _guard_clock(events: Iterable[Any], runs: Iterable[Any], cfg,
+                 since: int = 0) -> tuple[Optional[str], Optional[int]]:
+    """``(guard reason, hold-until epoch)`` from the latest ``respawn_guarded`` event of this ready episode
+    (at or after ``since``); the epoch only for a run-end clock hold (owner-restart / rate-limit /
+    infrastructure cooldown), computed like ``kanban_db_dispatch_clock.guard_hold_until`` (quota-episode
+    backoffs are not modelled). Advisory: the live verdict is the dispatcher's."""
+    guarded = [ev for ev in (events or []) if _event_kind(ev) == "respawn_guarded" and _event_ts(ev) >= since]
+    if not guarded:
+        return None, None
+    reason = _parse_payload(max(guarded, key=_event_ts)).get("reason")
+    reason = str(reason) if reason else None
+    end = _last_run_end_ts(runs)
+    if not end or reason not in ("owner_restart_cooldown", "rate_limit_cooldown", "infrastructure_cooldown"):
+        return reason, None
+    from hermes_cli import kanban_db as kb
+    if reason == "owner_restart_cooldown":
+        from hermes_cli.kanban_db_dispatch import OWNER_RESTART_COOLDOWN_SECONDS
+        cooldown = cfg.get("owner_restart_cooldown_seconds") or kb._env_int(
+            "HERMES_KANBAN_OWNER_RESTART_COOLDOWN_SECONDS", OWNER_RESTART_COOLDOWN_SECONDS)
+    else:
+        cooldown = cfg.get("rate_limit_cooldown_seconds") or kb._resolve_rate_limit_cooldown_seconds()
+    return reason, end + int(cooldown)
 
 
 def _foreign_machines(task, cfg) -> list[str]:
@@ -772,7 +808,7 @@ def _rule_stranded_in_ready(task, events, runs, now, cfg) -> list[Diagnostic]:
     # claim/park, so those events bound the wait from below too. Without them a
     # card cycling claim -> scheduled -> condition_met -> ready all day read as
     # "ready 18h with no worker" from its first promotion. [daveey]
-    last_ready_ts = _last_ready_entry_ts(events)
+    last_ready_ts = _last_ready_entry_ts(events, runs)
     if last_ready_ts == 0:
         last_ready_ts = int(_task_field(task, "created_at", default=0) or 0)
     if last_ready_ts == 0:
@@ -821,13 +857,18 @@ def _rule_held_in_ready(task, events, runs, now, cfg) -> list[Diagnostic]:
     reason = _ready_hold_reason(task, events, cfg)
     if not reason:
         return []
-    since = _last_ready_entry_ts(events) or int(_task_field(task, "created_at", 0) or 0)
+    since = _last_ready_entry_ts(events, runs) or int(_task_field(task, "created_at", 0) or 0)
     age = now - since
     if not since or age < float(cfg.get("stranded_threshold_seconds", 30 * 60)):
         return []
+    guard_reason, hold_until = _guard_clock(events, runs, cfg, since) if reason == "respawn_guarded" else (None, None)
+    hold = f"{reason}: {guard_reason}" if guard_reason else reason
+    if hold_until:
+        stamp = time.strftime("%H:%M:%SZ", time.gmtime(hold_until))
+        hold += f", until {stamp}" if hold_until > now else f", expired {stamp}"
     return [Diagnostic(
         kind="held_in_ready", severity="warning",
-        title=(f"Ready {int(age / 60)}m, last observed hold ({reason})" if reason == "respawn_guarded"
+        title=(f"Ready {int(age / 60)}m, last observed hold ({hold})" if reason == "respawn_guarded"
                else f"Ready {int(age / 60)}m, held ({reason})"),
         detail=("The last recorded dispatch decision was a guard hold; the current hold is not verified. "
                 "A cleared blocker, capacity limit, or missing pickup can leave this historical event "
@@ -837,7 +878,9 @@ def _rule_held_in_ready(task, events, runs, now, cfg) -> list[Diagnostic]:
         actions=[_cli_hint("Check dispatcher status", "hermes kanban diagnostics")],
         first_seen_at=since, last_seen_at=since, count=1,
         data={"ready_since": since, "age_seconds": int(age), "hold_reason": reason,
-              "foreign_machines": _foreign_machines(task, cfg)},
+              "foreign_machines": _foreign_machines(task, cfg),
+              **({"guard_reason": guard_reason} if guard_reason else {}),
+              **({"hold_until": hold_until} if hold_until else {})},
     )]
 
 
