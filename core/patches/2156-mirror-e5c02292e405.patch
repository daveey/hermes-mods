From e5c02292e40506da22ab96b09215ca1c1d56ebb2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 00:31:09 +0000
Subject: [PATCH] test(tui): await external draft commit before burst timer
 [daveey]

---
 .../textInputStaleParentEcho.test.tsx         | 68 ++++++++++++-------
 1 file changed, 42 insertions(+), 26 deletions(-)

diff --git a/ui-tui/src/__tests__/textInputStaleParentEcho.test.tsx b/ui-tui/src/__tests__/textInputStaleParentEcho.test.tsx
index e811f2329d2..633bc2c5747 100644
--- a/ui-tui/src/__tests__/textInputStaleParentEcho.test.tsx
+++ b/ui-tui/src/__tests__/textInputStaleParentEcho.test.tsx
@@ -1,7 +1,7 @@
 import { EventEmitter } from 'events'
 
 import { renderSync } from '@hermes/ink'
-import React, { useState } from 'react'
+import React, { act, useState } from 'react'
 import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
 
 import { TextInput } from '../components/textInput.js'
@@ -159,43 +159,59 @@ describe('stale parent own-echo during deferred key-burst flush', () => {
     const snapshotRef = useRefBridge()
     const setValueRef: React.MutableRefObject<((next: string) => void) | null> = { current: null }
 
-    const instance = renderSync(
-      React.createElement(Harness, { onValue: v => values.push(v), setValueRef, snapshotRef }),
-      {
-        patchConsole: false,
-        stderr: stderr as unknown as NodeJS.WriteStream,
-        stdin: stdin as unknown as NodeJS.ReadStream,
-        stdout: stdout as unknown as NodeJS.WriteStream
-      }
-    )
+    vi.stubGlobal('IS_REACT_ACT_ENVIRONMENT', true)
+    let instance!: ReturnType<typeof renderSync>
 
     try {
-      await tick()
+      await act(async () => {
+        instance = renderSync(
+          React.createElement(Harness, { onValue: v => values.push(v), setValueRef, snapshotRef }),
+          {
+            patchConsole: false,
+            stderr: stderr as unknown as NodeJS.WriteStream,
+            stdin: stdin as unknown as NodeJS.ReadStream,
+            stdout: stdout as unknown as NodeJS.WriteStream
+          }
+        )
+      })
 
       for (const ch of ['a', 'b', 'c']) {
-        stdin.send(ch)
-        await tick()
+        await act(async () => {
+          stdin.send(ch)
+        })
       }
 
-      vi.advanceTimersByTime(16)
-      await tick()
-      await tick()
+      await act(async () => {
+        vi.advanceTimersByTime(16)
+      })
+      expect(values).toEqual(['a', 'abc'])
 
       // "d" arms a new deferred flush; history navigation then replaces the
       // draft before that flush fires.
-      stdin.send('d')
-      await tick()
-      setValueRef.current?.('history draft')
-      await tick()
-      await tick()
+      await act(async () => {
+        stdin.send('d')
+      })
+      expect(values).toEqual(['a', 'abc'])
+
+      // Force React's real scheduler past its yield budget. Two setImmediate
+      // ticks are not a commit barrier on a busy runner; act drains the external
+      // replacement and its value-sync effect before we advance the burst clock.
+      let schedulerTime = performance.now()
+      vi.spyOn(performance, 'now').mockImplementation(() => (schedulerTime += 10))
+      await act(async () => {
+        setValueRef.current!('history draft')
+      })
 
       // The stale burst must not be handed to the parent 16ms later.
-      vi.advanceTimersByTime(16)
-      await tick()
-      await tick()
+      await act(async () => {
+        vi.advanceTimersByTime(16)
+      })
     } finally {
-      instance.unmount()
-      instance.cleanup()
+      await act(async () => {
+        instance?.unmount()
+        instance?.cleanup()
+      })
+      vi.unstubAllGlobals()
     }
 
     expect(values).toEqual(['a', 'abc'])
-- 
2.55.0

