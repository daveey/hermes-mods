Subject: [PATCH] test(e2e): keep attach probe off unrelated PM provisioning
 [daveey]

---
 .../core/security/test_attach_handshake.py    |  5 ++-
 .../security/test_attach_runtime_isolation.py | 45 +++++++++++++++++++
 2 files changed, 49 insertions(+), 1 deletion(-)
 create mode 100644 tests/e2e/core/security/test_attach_runtime_isolation.py

diff --git a/tests/e2e/core/security/test_attach_handshake.py b/tests/e2e/core/security/test_attach_handshake.py
index c8a785100f..6eae5dd3e5 100644
--- a/tests/e2e/core/security/test_attach_handshake.py
+++ b/tests/e2e/core/security/test_attach_handshake.py
@@ -247,9 +247,12 @@ def home(tmp_path: Path) -> Path:
 def _resume(home: Path, sid: str) -> tuple[subprocess.CompletedProcess, dict | None]:
     """Run ``hermes --tui --resume SID``; return the process result and what the TUI child received."""
     out = home.parent / f"handoff-{uuid.uuid4().hex}.json"
+    node = shutil.which("node")
+    assert node is not None, "the TUI hand-off requires installed Node"
     result = run_hermes(
         ["--tui", "--resume", sid], home, timeout=90,
-        extra_env={"HERMES_TUI_DIR": str(home.parent / "tui-probe"), "HERMES_SKIP_NODE_BOOTSTRAP": "1",
+        # This tests attachment, not PM acquisition; use the Node already required by pytestmark.
+        extra_env={"HERMES_TUI_DIR": str(home.parent / "tui-probe"), "HERMES_NODE": node,
                    "ATTACH_PROBE_OUT": str(out)})
     handoff = json.loads(out.read_text(encoding="utf-8")) if out.exists() else None
     return result, handoff
diff --git a/tests/e2e/core/security/test_attach_runtime_isolation.py b/tests/e2e/core/security/test_attach_runtime_isolation.py
new file mode 100644
index 0000000000..b9ef72a3c9
--- /dev/null
+++ b/tests/e2e/core/security/test_attach_runtime_isolation.py
@@ -0,0 +1,45 @@
+"""The attach-only probe must use installed Node, not provision an unrelated PM runtime."""
+
+from __future__ import annotations
+
+import subprocess
+import sys
+
+from tests.e2e.core.security import test_attach_handshake as attach
+from tests.e2e.core.security._helpers import hermetic_env, kill_group
+
+pytestmark = attach.pytestmark
+home = attach.home
+
+_NO_PROVISION = """
+import runpy, sys
+import pm
+
+def refuse_provision(*args, **kwargs):
+    raise AssertionError(f"attach probe attempted PM provisioning: {args}")
+
+pm.ensure = refuse_provision
+sys.argv = ["hermes", *sys.argv[1:]]
+runpy.run_module("hermes_cli.main", run_name="__main__")
+"""
+
+
+def test_attach_control_needs_no_pm_provisioning(home, monkeypatch):
+    """Exercise the real CLI, lease holder and Node probe with PM acquisition forbidden."""
+    def run_without_provision(argv, home, *, timeout, extra_env):
+        proc = subprocess.Popen(
+            [sys.executable, "-c", _NO_PROVISION, *argv],
+            cwd=home, env=hermetic_env(home, extra_env),
+            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            text=True, start_new_session=True,
+        )
+        try:
+            out, err = proc.communicate(timeout=timeout)
+        finally:
+            kill_group(proc)
+            proc.wait(timeout=10)
+        return subprocess.CompletedProcess(argv, proc.returncode, out, err)
+
+    monkeypatch.setattr(attach, "run_hermes", run_without_provision)
+    # Reuse all control assertions: exact socket, resume id and unchanged lease ownership.
+    attach.test_genuine_owner_is_attached(home)
