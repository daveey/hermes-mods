From e572a3832043fdfc39bd5e43685e666852f94989 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 23:22:28 -0700
Subject: [PATCH] fix(kanban): compose metadata classification with audit
 writes [daveey]

---
 hermes_cli/kanban_human_request_migration.py  |  4 ++-
 .../test_kanban_human_request_entries.py      | 29 +++++++++++++++++++
 2 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_human_request_migration.py b/hermes_cli/kanban_human_request_migration.py
index bb206c5373..bef0b1ff6b 100644
--- a/hermes_cli/kanban_human_request_migration.py
+++ b/hermes_cli/kanban_human_request_migration.py
@@ -24,7 +24,9 @@ def classify_parked_request(conn, task_id: str, *, human_request: dict | None,
         raise PermissionError("legacy classification is orchestrator-only")
     if not isinstance(actor, str) or not actor.strip() or not reason.strip():
         raise ValueError("classification requires actor and reason")
-    with db.write_txn(conn):
+    # Metadata/event writes have no post-commit effects: compose atomically with
+    # the caller's eligibility check and audit comment (outer rollback owns both).
+    with db.write_txn(conn, allow_nested=True):
         row = conn.execute(
             "SELECT status, block_kind, current_run_id FROM tasks WHERE id = ?", (task_id,)
         ).fetchone()
diff --git a/tests/hermes_cli/test_kanban_human_request_entries.py b/tests/hermes_cli/test_kanban_human_request_entries.py
index d91f30e9d4..7110f2b4ab 100644
--- a/tests/hermes_cli/test_kanban_human_request_entries.py
+++ b/tests/hermes_cli/test_kanban_human_request_entries.py
@@ -183,6 +183,35 @@ def test_classification_refuses_execution_state(client, state):
     assert snapshot(tid) == before
 
 
+@pytest.mark.parametrize("rollback", [False, True])
+def test_classification_and_comment_share_outer_transaction(rollback):
+    from hermes_cli.kanban_human_request_migration import classify_parked_request
+
+    tid = parked()
+    before = snapshot(tid)
+    with connect_closing() as conn:
+        before_events = len(db.list_events(conn, tid))
+        try:
+            with db.write_txn(conn):
+                assert classify_parked_request(conn, tid, human_request=REQUEST,
+                                               actor="user-terminal", reason="Window closed")
+                db.add_comment(conn, tid, "user-terminal", "Closed job audit")
+                if rollback:
+                    raise ValueError("injected failure")
+        except ValueError as exc:
+            assert rollback and str(exc) == "injected failure"
+        count = conn.execute("SELECT count(*) FROM task_comments WHERE task_id=?", (tid,)).fetchone()[0]
+        assert count == (0 if rollback else 1)
+        assert len(db.list_events(conn, tid)) == before_events + (0 if rollback else 2)
+    after = snapshot(tid)
+    if rollback:
+        assert after == before
+    else:
+        assert json.loads(after.pop("human_request")) == REQUEST
+        before.pop("human_request")
+        assert after == before
+
+
 def test_worker_cannot_classify_legacy_card(monkeypatch):
     from hermes_cli.kanban_human_request_migration import classify_parked_request
 
