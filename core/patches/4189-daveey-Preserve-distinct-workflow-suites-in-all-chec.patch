From 55953071ef713ac5f664314ff8e7cedfd9bae0a9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 00:20:15 +0000
Subject: [PATCH] [daveey] Preserve distinct workflow suites in all-check merge
 evidence

Live audit replay exposed same-name jobs from different suites being collapsed by the existing required-context grouping. Opt the all-check fallback into suite identity; leave configured-required semantics unchanged. Regression asserts both same-name rows and failure refusal. Canonical consumer tests and whole-tree check pass.
---
 hermes_cli/kanban_pr_acceptance.py          | 2 +-
 hermes_cli/kanban_pr_merge_time.py          | 8 +++++---
 tests/hermes_cli/test_kanban_pr_fallback.py | 9 +++++++++
 3 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_pr_acceptance.py b/hermes_cli/kanban_pr_acceptance.py
index 6b10449c3e..254c289707 100644
--- a/hermes_cli/kanban_pr_acceptance.py
+++ b/hermes_cli/kanban_pr_acceptance.py
@@ -258,7 +258,7 @@ def collect_acceptance(contract: str, published_pr: str | None,
         statuses = complete_statuses(_api(f"repos/{repo}/commits/{sha}/statuses?per_page=100",
                                           paginate=True, profile_home=profile_home), sha)
         phase = "selecting merge-time evidence"
-        runs, statuses = merge_evidence(receipt, pr, repo, runs, statuses)
+        runs, statuses = merge_evidence(receipt, pr, repo, runs, statuses, distinct_suites=not required)
         outcomes = []
         app_of_bot: dict[str, int | None] = {}
         for context, app_id in sorted(required, key=str):
diff --git a/hermes_cli/kanban_pr_merge_time.py b/hermes_cli/kanban_pr_merge_time.py
index 8a68f4172e..0f8abc9daa 100644
--- a/hermes_cli/kanban_pr_merge_time.py
+++ b/hermes_cli/kanban_pr_merge_time.py
@@ -27,7 +27,7 @@ def check_receipt(check, sha):
             "classification": _classify(check, sha, outcome, is_run), "conclusion": outcome}
 
 
-def partition_at_merge(checks, merged_at, *, runs):
+def partition_at_merge(checks, merged_at, *, runs, distinct_suites=False):
     """Latest pre-merge execution per producer, plus every later execution.
 
     App identities stay distinct: an unpinned context must not hide another app's
@@ -41,6 +41,8 @@ def partition_at_merge(checks, merged_at, *, runs):
 
     def key_of(check):
         if runs:
+            if distinct_suites:
+                return (check["name"], check["app"]["id"], check["check_suite"]["id"])
             return (check["name"], check["app"]["id"])
         return (check["context"], (check.get("creator") or {}).get("id"))
 
@@ -72,12 +74,12 @@ def partition_at_merge(checks, merged_at, *, runs):
     return [entry[1] for entry in latest.values()], post
 
 
-def merge_evidence(receipt, pr, repo, runs, statuses):
+def merge_evidence(receipt, pr, repo, runs, statuses, *, distinct_suites=False):
     if pr["state"] != "MERGED":
         return runs, statuses
     merged_at = pr["mergedAt"]
     receipt["merged_at"] = merged_at
-    runs, post_runs = partition_at_merge(runs, merged_at, runs=True)
+    runs, post_runs = partition_at_merge(runs, merged_at, runs=True, distinct_suites=distinct_suites)
     statuses, post_statuses = partition_at_merge(statuses, merged_at, runs=False)
     sha = receipt["head_sha"]
     receipt["post_merge_checks"] = [check_receipt(c, sha) for c in post_runs + post_statuses]
diff --git a/tests/hermes_cli/test_kanban_pr_fallback.py b/tests/hermes_cli/test_kanban_pr_fallback.py
index 3740746dfc..3f01e7ba69 100644
--- a/tests/hermes_cli/test_kanban_pr_fallback.py
+++ b/tests/hermes_cli/test_kanban_pr_fallback.py
@@ -103,6 +103,15 @@ def test_post_merge_evidence_is_not_absence_after_suite_disappears():
     assert receipt["classification"] == "missing"
 
 
+def test_merged_fallback_keeps_same_name_workflows_distinct(evidence):
+    failed = run("failure")
+    passed = {**run("success", id=2), "check_suite": {"id": 8}}
+    evidence.update(merged=True, runs=[failed, passed])
+    receipt = gate.collect_acceptance(URL, None)
+    assert receipt["classification"] == "failure"
+    assert [c["id"] for c in receipt["checks"]] == [1, 2]
+
+
 def test_fallback_merge_cutoff(evidence):
     evidence.update(merged=True, runs=[run("failure"), run("success", id=2, started="2026-11-02T14:00:00Z")])
     receipt = gate.collect_acceptance(URL, None)
-- 
