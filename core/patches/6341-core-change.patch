From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 07:06:02 +0000
Subject: [PATCH 6341] Explicit Carbon routing and model-neutral obligations

Public mirror of source commit 81d090cdeeaa6af1cef5194f2dcb741a531327a8.

---
diff --git a/tests/hermes_cli/test_kanban_model_neutral_courier.py b/tests/hermes_cli/test_kanban_model_neutral_courier.py
new file mode 100644
index 00000000000..babff698d2e
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_model_neutral_courier.py
@@ -0,0 +1,53 @@
+"""Owner couriers retain pre-write model-policy refusals, not unknown outcomes."""
+import json
+
+import pytest
+
+from hermes_cli import kanban_db_connect as kbc
+from tests.hermes_cli import test_kanban_origin_owner as courier
+from tests.hermes_cli import test_kanban_selfwork_nochat as selfwork
+from tools.kanban_tools_model_neutral import model_neutral_create
+from tools.registry import tool_error
+
+world = courier.world
+request_envelope = selfwork.request_envelope
+
+
+@pytest.mark.parametrize('kind', ['origin', 'selfwork'])
+@pytest.mark.parametrize('options', [
+    {'model': 'gpt-6-astra'}, {'provider': 'anthropic'}, {'pin_mandatory': True},
+    {'body': 'Use only claude-opus-5-5 for this review.'},
+])
+def test_owner_cli_rejects_model_policy_without_creation(request, kind, options, monkeypatch, capsys):
+    envelope = request.getfixturevalue('world' if kind == 'origin' else 'request_envelope')
+    envelope['args']['create'].update(options)
+    invoke = courier.invoke if kind == 'origin' else selfwork.invoke
+    result = invoke(envelope, monkeypatch, capsys)
+    with kbc.connect_closing() as conn:
+        assert conn.execute('SELECT COUNT(*) FROM tasks').fetchone()[0] == 0
+    assert result['status'] == 'rejected', result
+    assert result['created'] is False
+    assert result['handoff_complete'] is False
+    assert result['code'] == 'kanban_model_restriction'
+    assert 'model-neutral' in result['error']
+
+
+@pytest.mark.parametrize('kind', ['origin', 'selfwork'])
+def test_owner_cli_accepts_class(request, kind, monkeypatch, capsys):
+    envelope = request.getfixturevalue('world' if kind == 'origin' else 'request_envelope')
+    envelope['args']['create']['model'] = 'class:deep'
+    invoke = courier.invoke if kind == 'origin' else selfwork.invoke
+    result = invoke(envelope, monkeypatch, capsys)
+    assert result.get('created') is True, result
+    with kbc.connect_closing() as conn:
+        row = conn.execute('SELECT model_override,provider_override FROM tasks WHERE id=?',
+                           (result['task_id'],)).fetchone()
+        assert tuple(row) == ('class:deep', 'auto')
+
+
+def test_downstream_untyped_error_is_not_promoted_to_no_write():
+    @model_neutral_create
+    def after_write(args):
+        return tool_error('storage response unavailable after commit')
+    result = json.loads(after_write({'title': 'Work', 'model': 'class:deep'}))
+    assert result == {'error': 'storage response unavailable after commit'}
diff --git a/tests/test_kanban_extraction141_selectors.py b/tests/test_kanban_extraction141_selectors.py
index 4b0595b7322..2add3810bfe 100644
--- a/tests/test_kanban_extraction141_selectors.py
+++ b/tests/test_kanban_extraction141_selectors.py
@@ -80,4 +80,9 @@
     assert seen == [args]
     result = json.loads(handler({'model': 'concrete'}))
     assert 'model-neutral' in result['error']
-    assert 'code' not in result
+    # Concrete selectors are still refused before handler admission; the owner
+    # courier now receives an explicit no-write result instead of unknown/pending.
+    assert result['code'] == 'kanban_model_restriction'
+    assert result['created'] is False and result['handoff_complete'] is False
+    assert result['status'] == 'rejected'
+    assert seen == [args]
diff --git a/tools/kanban_tools_model_neutral.py b/tools/kanban_tools_model_neutral.py
index e38fa3e74b6..4213f441de1 100644
--- a/tools/kanban_tools_model_neutral.py
+++ b/tools/kanban_tools_model_neutral.py
@@ -12,7 +12,10 @@
             validate_selector(args.get('model'), args.get('provider'), mandatory=args.get('pin_mandatory'))
             validate_text(args.get('title'), args.get('body'))
         except ValueError as exc:
-            return tool_error(str(exc))
+            # Only pure pre-dispatch validation proves that no creation occurred.
+            # Couriers must not retry this immutable request as an unknown write.
+            return tool_error(str(exc), code='kanban_model_restriction', created=False,
+                              status='rejected', handoff_complete=False)
         return fn(args, **kwargs)
     return create
 
