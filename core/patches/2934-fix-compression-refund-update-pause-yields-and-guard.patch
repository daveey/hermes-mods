From 714a58133791d6755e9b5053583b7693e2e33301 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 19:37:28 +0000
Subject: [PATCH] fix(compression): refund update-pause yields and guard
 scripted preludes [daveey]

---
 agent/compression_facade.py                   |   4 +-
 agent/turn_preflight.py                       |  13 +-
 agent/update_pause_cancel.py                  |   6 +-
 .../test_update_pause_compression.py          | 118 +++++++++++++++++-
 4 files changed, 133 insertions(+), 8 deletions(-)

diff --git a/agent/compression_facade.py b/agent/compression_facade.py
index 832dd99d4b..59d5f3a3bb 100644
--- a/agent/compression_facade.py
+++ b/agent/compression_facade.py
@@ -188,7 +188,9 @@ def _run_under_progress_timeout(
         )
 
     from agent import update_pause_cancel
-    if not update_pause_cancel.compression_can_yield(trigger, messages):
+    if not update_pause_cancel.compression_can_yield(
+        trigger, messages, api_call_count=getattr(agent, "_api_call_count", 0),
+    ):
         return _wait()
     # A core-update pause's cancel covers this wait like a running tool call (t_01a1d0aa52ee1404), only where
     # the yield's unchanged transcript reaches a step boundary the pause lands on.
diff --git a/agent/turn_preflight.py b/agent/turn_preflight.py
index 2131b9b16f..52f5a0513d 100644
--- a/agent/turn_preflight.py
+++ b/agent/turn_preflight.py
@@ -14,6 +14,7 @@ from dataclasses import dataclass
 from typing import Any, Dict, List, Optional
 
 from agent.context_engine import automatic_compaction_status_message
+from agent.update_pause_cancel import compression_yield_requested
 from agent.conversation_compression import (
     PRE_API_COMPRESSION_STATUS_TEMPLATE, _reset_read_dedup_caches, compression_blocked_transiently,
     compression_skipped_due_to_lock, context_compression_timed_out, conversation_history_after_compression,
@@ -149,6 +150,13 @@ def run_preflight_compression(
             v.messages, system_message, approx_tokens=request_pressure_tokens,
             task_id=effective_task_id, trigger="pre_api",
         )
+        if v.messages is _pre_api_input and compression_yield_requested(agent):
+            # A discarded summary did not spend recovery budget. Re-enter the loop
+            # so the boundary hook can pause (or decline if the hold was released).
+            v.compression_attempts -= 1
+            v._last_preflight_pressure = None
+            v.api_call_count = _refund_api_call(agent, v.api_call_count)
+            return _done("continue")
         if context_compression_timed_out(agent):
             # Progress-aware timeout: never reached the provider — refund the
             # call/budget and stop; an overflow retry would only re-compress.
@@ -316,7 +324,10 @@ def compress_after_tool_results(
         messages, active_system_prompt = agent._compress_context(
             messages, system_message, approx_tokens=_real_tokens, task_id=effective_task_id, trigger="post_tool",
         )
-        if messages is _post_tool_input and compression_skipped_due_to_lock(agent):
+        if messages is _post_tool_input and compression_yield_requested(agent):
+            # The summary was discarded for a pause, not a failed compression.
+            compression_attempts -= 1
+        elif messages is _post_tool_input and compression_skipped_due_to_lock(agent):
             # Lock-skip no-op is a temporary defer, not evidence about compressibility:
             # refund so a lock-loser loop doesn't burn the budget toward exhausted.
             # #69870 lock-skip / #97488 transient-block: this pass no-oped for a TEMPORARY reason (another
diff --git a/agent/update_pause_cancel.py b/agent/update_pause_cancel.py
index 0cb2d24189..b8d5fc6c59 100644
--- a/agent/update_pause_cancel.py
+++ b/agent/update_pause_cancel.py
@@ -103,10 +103,12 @@ def compression_in_flight(agent: Any) -> Iterator[None]:
 _YIELDABLE_TRIGGERS = frozenset({"post_tool", "pre_api"})
 
 
-def compression_can_yield(trigger: Any, messages: Any) -> bool:
+def compression_can_yield(trigger: Any, messages: Any, *, api_call_count: int) -> bool:
     """A compression may yield to the update pause only where the pause can land: a post-tool or pre-API
     compression over a transcript that ends on a tool result (``_step_boundary_pause``'s own precondition; a
-    tool result inside the turn implies a model call ran)."""
+    scripted prelude tool results do not imply a model call ran)."""
+    if api_call_count <= 0:
+        return False
     if trigger not in _YIELDABLE_TRIGGERS or not isinstance(messages, list) or not messages:
         return False
     last = messages[-1]
diff --git a/tests/tui_gateway/test_update_pause_compression.py b/tests/tui_gateway/test_update_pause_compression.py
index 841bcc0a82..d142eaccda 100644
--- a/tests/tui_gateway/test_update_pause_compression.py
+++ b/tests/tui_gateway/test_update_pause_compression.py
@@ -291,11 +291,121 @@ def test_an_overflow_recovery_compression_never_yields(home, tmp_path, monkeypat
     assert update_pause_cancel.in_flight(agent) == {}
 
 
+@pytest.mark.parametrize("trigger", ["post_tool", "pre_api"])
+def test_scripted_tool_tail_before_any_api_call_cannot_yield(tmp_path, monkeypatch, trigger):
+    agent = _make_agent(tmp_path)
+    agent._api_call_count = 0
+    observed = []
+
+    def summary(_agent, messages, system_message, **kwargs):
+        observed.append(update_pause_cancel.in_flight(agent))
+        return messages, system_message
+
+    monkeypatch.setattr(cc, "compress_context", summary)
+    agent._compress_context(
+        [{"role": "tool", "tool_call_id": "prelude", "content": "opening"}],
+        "system", trigger=trigger,
+    )
+    assert observed == [{}]
+
+
+def _release_pause_at_boundary(home, streaming, monkeypatch):
+    original = up.boundary_pause_hook
+
+    def factory(*args):
+        hook = original(*args)
+
+        def released(**kwargs):
+            if streaming.outcome == "cancelled":
+                af.clear_pause_request(home)
+                af.clear_hold(home)
+            return hook(**kwargs)
+
+        return released
+
+    monkeypatch.setattr(up, "boundary_pause_hook", factory)
+
+
+@pytest.mark.parametrize("decline_pause", [False, True])
+def test_forced_overflow_preflight_yields_without_spending_attempt(home, tmp_path, monkeypatch, decline_pause):
+    import agent.turn_preflight as preflight
+
+    record_turn_start(home, "session-key", "run the quick job")
+    agent = _make_agent(tmp_path)
+    session = {"agent": agent, "session_key": "session-key", "profile_home": str(home),
+               "history_lock": threading.RLock()}
+    streaming = _StreamingSummary()
+    summaries, attempts = [], []
+
+    def summary(worker_agent, messages, system_message, **kwargs):
+        if not summaries:
+            assert kwargs["trigger"] == "overflow"
+            summaries.append("committed")
+            return [dict(m, content="short") if m.get("role") == "tool" else m for m in messages], system_message
+        assert kwargs["trigger"] == "pre_api"
+        result = streaming(worker_agent, messages, system_message, **kwargs)
+        summaries.append(streaming.outcome)
+        return result
+
+    original = preflight.run_preflight_compression
+
+    def capture(*args, **kwargs):
+        before = args[1].compression_attempts
+        result = original(*args, **kwargs)
+        if streaming.started.is_set():
+            attempts.append((before, result.compression_attempts))
+        return result
+
+    monkeypatch.setattr("agent.turn_preflight_gate.run_preflight_compression", capture)
+    monkeypatch.setattr(cc, "compress_context", summary)
+    monkeypatch.setattr(agent.context_compressor, "should_compress", lambda *a, **k: summaries == ["committed"])
+    monkeypatch.setattr("model_tools.handle_function_call", lambda *a, **k: "large result " * 10000)
+    if decline_pause:
+        _release_pause_at_boundary(home, streaming, monkeypatch)
+    _pause_once_summary_streams(home, streaming)
+    result = _run_turn(agent, session, [_response(_call("call_1")), _overflow_error(), _response()])
+    assert summaries == ["committed", "cancelled"]
+    assert not result.get("failed") and not result.get("compression_exhausted")
+    if decline_pause:
+        assert result["final_response"] == "done"
+        assert attempts and all(before == after for before, after in attempts)
+    else:
+        assert result["paused_for_update"] == up.PAUSE_REASON
+
+
+def test_declined_post_tool_pause_refunds_attempt(home, tmp_path, monkeypatch):
+    import agent.turn_preflight as preflight
+
+    record_turn_start(home, "session-key", "run the quick job")
+    agent = _make_agent(tmp_path)
+    session = {"agent": agent, "session_key": "session-key", "profile_home": str(home),
+               "history_lock": threading.RLock()}
+    streaming = _StreamingSummary()
+    attempts = []
+    original = preflight.compress_after_tool_results
+
+    def capture(*args, **kwargs):
+        result = original(*args, **kwargs)
+        attempts.append((kwargs["compression_attempts"], result.compression_attempts))
+        return result
+
+    monkeypatch.setattr("agent.turn_tool_round.compress_after_tool_results", capture)
+    monkeypatch.setattr(cc, "compress_context", streaming)
+    monkeypatch.setattr(agent.context_compressor, "should_compress", lambda *a, **k: not streaming.started.is_set())
+    monkeypatch.setattr("model_tools.handle_function_call", lambda *a, **k: "quick result")
+    _release_pause_at_boundary(home, streaming, monkeypatch)
+    _pause_once_summary_streams(home, streaming)
+    result = _run_turn(agent, session, [_response(_call("call_1")), _response()])
+    assert streaming.outcome == "cancelled"
+    assert result["final_response"] == "done" and not result.get("failed")
+    assert attempts == [(0, 0)]
+
+
 def test_only_a_tool_result_boundary_compression_can_yield():
     tool_tail = [{"role": "user", "content": "go"}, {"role": "tool", "tool_call_id": "c", "content": "ok"}]
     user_tail = [{"role": "user", "content": "go"}]
-    assert update_pause_cancel.compression_can_yield("post_tool", tool_tail)
-    assert update_pause_cancel.compression_can_yield("pre_api", tool_tail)
-    assert not update_pause_cancel.compression_can_yield("pre_api", user_tail)
+    assert update_pause_cancel.compression_can_yield("post_tool", tool_tail, api_call_count=1)
+    assert update_pause_cancel.compression_can_yield("pre_api", tool_tail, api_call_count=1)
+    assert not update_pause_cancel.compression_can_yield("pre_api", user_tail, api_call_count=1)
     for trigger in ("overflow", "turn_start_threshold", "engine_preflight", "idle", "gateway_hygiene", None):
-        assert not update_pause_cancel.compression_can_yield(trigger, tool_tail)
+        assert not update_pause_cancel.compression_can_yield(trigger, tool_tail, api_call_count=1)
