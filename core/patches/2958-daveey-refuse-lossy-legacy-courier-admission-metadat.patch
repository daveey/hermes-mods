From e9550bb837ce9ef273b2e29f456cc723cda92eb1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 06:16:30 +0000
Subject: [PATCH] [daveey] refuse lossy legacy courier admission metadata

---
 hermes_cli/kanban_placement.py                | 3 ++-
 tests/hermes_cli/test_kanban_hub_admission.py | 7 +++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 44b9d21bb8..20acfec940 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -215,7 +215,8 @@ CARRIED_OPTIONS = ("skills", "max_runtime_seconds", "priority", "model", "provid
                    "distinct_from", "distinct_reason", "admission_class", "admission_frees")
 IDENTITY_OPTIONS = ("idempotency_key", "distinct_from", "distinct_reason")
 # Of those, the ones an older client (no --option) cannot express at all: the card stays local.
-LEGACY_UNCARRIED = ("model", "provider", "goal_mode", "triage", *IDENTITY_OPTIONS)
+LEGACY_UNCARRIED = ("model", "provider", "goal_mode", "triage", *IDENTITY_OPTIONS,
+                    "admission_class", "admission_frees")
 HELP_CACHE_SECONDS = 600
 # Profile tools (``requires`` entries) a target can satisfy when it does not publish its profiles'
 # tools: what the hub's default profile has. host_repo never travels: it means a checkout on THIS host.
diff --git a/tests/hermes_cli/test_kanban_hub_admission.py b/tests/hermes_cli/test_kanban_hub_admission.py
index 0133965ebf..de5a952868 100644
--- a/tests/hermes_cli/test_kanban_hub_admission.py
+++ b/tests/hermes_cli/test_kanban_hub_admission.py
@@ -106,6 +106,13 @@ def test_admission_metadata_survives_remote_option_encoding():
     assert placement.carried_options(args) == args
 
 
+@pytest.mark.parametrize("field,value", [("admission_class", "capacity"),
+                                         ("admission_frees", "frees: worker slots")])
+def test_legacy_courier_cannot_silently_drop_admission_metadata(field, value):
+    from hermes_cli import kanban_placement as placement
+    assert placement._uncarried({field: value}, placement._Cfg({}), False) == [field]
+
+
 def test_claim_persists_immutable_regular_receipt(board):
     conn, home = board
     configure(home, limit=None)
-- 
2.51.0

