@@ -0,0 +1,82 @@
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { isFileDrag, useFileDrop } from './attach-drop'
+
+const fileTransfer = (files: File[]) => ({ types: ['Files'], files, dropEffect: 'none' })
+const cardTransfer = () => ({ types: ['text/plain'], files: [], dropEffect: 'none', getData: () => 't_1' })
+
+function Zone({ onFiles, enabled = true }: { onFiles: (files: File[]) => void; enabled?: boolean }) {
+  const drop = useFileDrop(onFiles, enabled)
+
+  return (
+    <div data-over={drop.over ? 'yes' : 'no'} data-testid="zone" {...drop.handlers}>
+      <span data-testid="child">child</span>
+    </div>
+  )
+}
+
+afterEach(cleanup)
+
+describe('isFileDrag', () => {
+  it('accepts OS file drags and rejects card moves', () => {
+    expect(isFileDrag({ types: ['Files'] } as unknown as DataTransfer)).toBe(true)
+    expect(isFileDrag({ types: ['text/plain'] } as unknown as DataTransfer)).toBe(false)
+    expect(isFileDrag(null)).toBe(false)
+  })
+})
+
+describe('useFileDrop', () => {
+  it('highlights while files hover (child crossings included) and hands over dropped files', () => {
+    const onFiles = vi.fn()
+    render(<Zone onFiles={onFiles} />)
+    const zone = screen.getByTestId('zone')
+    const file = new File(['x'], 'a.txt')
+
+    fireEvent.dragEnter(zone, { dataTransfer: fileTransfer([file]) })
+    fireEvent.dragEnter(screen.getByTestId('child'), { dataTransfer: fileTransfer([file]) })
+    fireEvent.dragLeave(zone, { dataTransfer: fileTransfer([file]) })
+    expect(zone.dataset.over).toBe('yes')
+
+    act(() => {
+      fireEvent.drop(zone, { dataTransfer: fileTransfer([file]) })
+    })
+    expect(zone.dataset.over).toBe('no')
+    expect(onFiles).toHaveBeenCalledWith([file])
+  })
+
+  it('ignores card moves so lane drops still reach the column', () => {
+    const onFiles = vi.fn()
+    const laneDrop = vi.fn()
+    render(
+      <div onDrop={laneDrop}>
+        <Zone onFiles={onFiles} />
+      </div>
+    )
+    const zone = screen.getByTestId('zone')
+
+    fireEvent.dragEnter(zone, { dataTransfer: cardTransfer() })
+    expect(zone.dataset.over).toBe('no')
+    fireEvent.drop(zone, { dataTransfer: cardTransfer() })
+    expect(onFiles).not.toHaveBeenCalled()
+    expect(laneDrop).toHaveBeenCalledOnce()
+  })
+
+  it('stops file drops from bubbling to the lane', () => {
+    const laneDrop = vi.fn()
+    render(
+      <div onDrop={laneDrop}>
+        <Zone onFiles={vi.fn()} />
+      </div>
+    )
+    fireEvent.drop(screen.getByTestId('zone'), { dataTransfer: fileTransfer([new File(['x'], 'a.txt')]) })
+    expect(laneDrop).not.toHaveBeenCalled()
+  })
+
+  it('does nothing while disabled', () => {
+    const onFiles = vi.fn()
+    render(<Zone enabled={false} onFiles={onFiles} />)
+    fireEvent.drop(screen.getByTestId('zone'), { dataTransfer: fileTransfer([new File(['x'], 'a.txt')]) })
+    expect(onFiles).not.toHaveBeenCalled()
+  })
+})
diff --git a/apps/desktop/src/plugins/kanban/attach-drop.ts b/apps/desktop/src/plugins/kanban/attach-drop.ts
new file mode 100644
index 0000000000..7f24a39af6
--- /dev/null
+++ b/apps/desktop/src/plugins/kanban/attach-drop.ts
@@ -0,0 +1,91 @@
+/** Drop OS files onto a task (board card or open task dialog) to attach them.
+ *  Only real file drags count — a card being moved between lanes carries
+ *  `text/plain`, never `Files` — so lane moves and attachment drops never
+ *  collide. Uploads go one at a time through the existing attachment endpoint,
+ *  so the backend's per-file size cap and name sanitising still apply. */
+
+import { type DragEvent as ReactDragEvent, useRef, useState } from 'react'
+
+import { uploadAttachment } from './api'
+
+export const isFileDrag = (dt: DataTransfer | null | undefined) => !!dt && Array.from(dt.types ?? []).includes('Files')
+
+/** Sequential uploads; resolves with the count stored. The first failure
+ *  rejects (earlier files stay attached — the caller's refresh shows them). */
+export async function uploadFiles(taskId: string, files: readonly File[]): Promise<number> {
+  let stored = 0
+
+  for (const file of files) {
+    await uploadAttachment(taskId, {
+      bytes: await file.arrayBuffer(),
+      contentType: file.type || undefined,
+      filename: file.name
+    })
+    stored += 1
+  }
+
+  return stored
+}
+
+/** Drag handlers + hover state for a file drop zone. Enter/leave are counted
+ *  so crossing child elements doesn't flicker the highlight. Handlers stop
+ *  propagation on file drags so an enclosing lane never sees them. */
+export function useFileDrop(onFiles: (files: File[]) => void, enabled = true) {
+  const [over, setOver] = useState(false)
+  const depth = useRef(0)
+
+  const reset = () => {
+    depth.current = 0
+    setOver(false)
+  }
+
+  const handlers = {
+    onDragEnter: (event: ReactDragEvent<HTMLElement>) => {
+      if (!enabled || !isFileDrag(event.dataTransfer)) {
+        return
+      }
+
+      event.preventDefault()
+      event.stopPropagation()
+      depth.current += 1
+      setOver(true)
+    },
+    onDragLeave: (event: ReactDragEvent<HTMLElement>) => {
+      if (!enabled || !isFileDrag(event.dataTransfer)) {
+        return
+      }
+
+      event.stopPropagation()
+      depth.current = Math.max(0, depth.current - 1)
+
+      if (depth.current === 0) {
+        setOver(false)
+      }
+    },
+    onDragOver: (event: ReactDragEvent<HTMLElement>) => {
+      if (!enabled || !isFileDrag(event.dataTransfer)) {
+        return
+      }
+
+      event.preventDefault()
+      event.stopPropagation()
+      event.dataTransfer.dropEffect = 'copy'
+    },
+    onDrop: (event: ReactDragEvent<HTMLElement>) => {
+      if (!enabled || !isFileDrag(event.dataTransfer)) {
+        return
+      }
+
+      event.preventDefault()
+      event.stopPropagation()
+      reset()
+      const files = Array.from(event.dataTransfer.files ?? [])
+
+      if (files.length > 0) {
+        onFiles(files)
+      }
+    }
+  }
+
+  return { handlers, over }
+}
