@@ -6,7 +6,10 @@ import json
 import pytest
 
 from agent import core_update_drain as drain
+from hermes_cli import kanban_chat_wait as kcw
+from hermes_cli import kanban_db as kb
 from hermes_cli import kanban_db_sync as sync
