diff --git a/hermes_cli/models.py b/hermes_cli/models.py
index d01a44bc32..c0d4854e3b 100644
--- a/hermes_cli/models.py
+++ b/hermes_cli/models.py
@@ -1130,6 +1130,13 @@ def detect_provider_for_model(
     if not name:
         return None
 
+    # An unqualified choice prefers the subscription over the billed first-party API.
+    # Explicit provider choices bypass this detector in switch_model.
+    from hermes_cli.models_detect import preferred_subscription_model
+    if current_provider in {"", "auto", "openai", "openai-api", "anthropic", "openrouter"}:
+        if subscription_model := preferred_subscription_model(name):
+            return ("openai-codex", subscription_model)
+
     # The current provider's LIVE catalog outranks every static guess: a model it already serves
     # (Codex early-access ids, Portal-only slugs, Ollama Cloud models absent from _PROVIDER_MODELS)
     # must never re-route the session to another vendor or to metered OpenRouter.
diff --git a/hermes_cli/models_detect.py b/hermes_cli/models_detect.py
index a0fd288e7b..81182c8033 100644
--- a/hermes_cli/models_detect.py
+++ b/hermes_cli/models_detect.py
@@ -71,6 +71,16 @@ def current_provider_owns_vendor(model_name: str, current_provider: str) -> bool
     return native == {vendor}
 
 
+def preferred_subscription_model(model: str) -> Optional[str]:
+    """Exact account-discovered match for an unqualified model choice; never guess entitlement."""
+    name = (model or "").strip()
+    if not name or "/" in name or not name.lower().startswith(("gpt-", "o1", "o3", "o4")):
+        return None
+    if not provider_has_credentials("openai-codex"):
+        return None
+    return current_provider_catalog_match(name, "openai-codex")
+
+
 def provider_has_credentials(provider: str) -> bool:
     """Whether *provider* can be switched to without the user typing a key: env/.env key, auth
     store login, or a usable credential-pool entry. ``custom``/``custom:*`` targets only come out
