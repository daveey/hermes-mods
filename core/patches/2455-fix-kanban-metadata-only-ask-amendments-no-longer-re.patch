diff --git a/hermes_cli/kanban_block_notice.py b/hermes_cli/kanban_block_notice.py
index 8414a86a31..99854e27bc 100644
--- a/hermes_cli/kanban_block_notice.py
+++ b/hermes_cli/kanban_block_notice.py
@@ -13,6 +13,59 @@ def blocked_actor_fields(conn, task_id: str) -> dict:
     return {"block_actor": actor} if isinstance(actor, str) and actor else {}
 
 
+def _actor_session(actor) -> str:
+    """The chat session id an ``agent (chat <id>)`` audit label names, else ``""``."""
+    if not isinstance(actor, str) or not actor.startswith("agent (chat ") or not actor.endswith(")"):
+        return ""
+    return actor[len("agent (chat "):-1].strip()
+
+
+def actor_is_chat(actor, chat_id) -> bool:
+    """Whether the audit actor is the subscriber chat ``chat_id``.
+
+    The actor carries either the raw session id or the gateway session key
+    (``agent:<ns>:<platform>:dm:<id>``); subscriptions store the bare ``<id>``.
+    Only DM keys are reduced to their chat id: group/thread keys append thread
+    and participant segments, so they never match by suffix. [daveey]
+    """
+    session, chat = _actor_session(actor), str(chat_id or "").strip()
+    if not session or not chat:
+        return False
+    if session == chat:
+        return True
+    parts = session.split(":")
+    return len(parts) >= 5 and parts[0] == "agent" and parts[3] == "dm" and ":".join(parts[4:]) == chat
+
+
+def is_metadata_only(payload) -> bool:
+    """A ``blocked`` event that amended a parked card's ask without a new block transition."""
+    return isinstance(payload, dict) and payload.get("metadata_only") is True
+
+
+def ask_update_notice(task, task_id: str, board: str, payload, *, chat_id: str | None = "", gateway: str = "") -> str | None:
+    """Notice text for a metadata-only ask amendment; ``None`` = silent for this chat.
+
+    The chat that made the edit already knows it, so it gets nothing. Other
+    subscribers get one line with the new action, not a fresh "blocked —"
+    notice: the card did not block again. [daveey]
+    """
+    if actor_is_chat(payload.get("actor"), chat_id):
+        return None
+
+    def get(key, default=None):
+        return task.get(key, default) if isinstance(task, dict) else getattr(task, key, default)
+
+    status = get("status")
+    if status and status not in {"blocked", "triage"}:
+        return block_notice(task, task_id, board, gateway=gateway, reason=str(payload.get("reason") or ""),
+                            actor=str(payload.get("actor") or ""))
+    request = payload.get("human_request")
+    action = request.get("action") if isinstance(request, dict) else None
+    link = f"@task:{board or 'default'}{'@' + gateway if gateway else ''}/{task_id}"
+    text = " ".join(str(action).split()) if action else "no human action recorded"
+    return f"ask updated (card still blocked): {text} — open task: {link}"
+
+
 def block_notice(task, task_id: str, board: str, *, gateway: str = "", reason: str = "", actor: str = "") -> str:
     """Use current card evidence, never event prose, to assign a human action.
 
diff --git a/tests/gateway/test_kanban_notifier.py b/tests/gateway/test_kanban_notifier.py
index 6cb9054057..1fa1172b3a 100644
--- a/tests/gateway/test_kanban_notifier.py
+++ b/tests/gateway/test_kanban_notifier.py
@@ -796,3 +796,80 @@ def test_review_requested_does_not_wake_a_notify_only_subscription(
     assert adapter.handled == [], (
         "notify-only subscriptions must not be woken by a review handoff"
     )
+
+
+_ASK = dict(action="Choose A. Unblock = proceed; archive = drop it.", why_human="Owner decision",
+            interaction="reply", scope="Fixture", evidence="Fixture decision")
+_EDITOR = "agent (chat agent:main:telegram:dm:chat-1)"
+
+
+def _amend_fixture(monkeypatch, tmp_path, *, metadata_only):
+    """Two notify+wake subs on a parked card; chat-1 then amends (or really blocks) it."""
+    from hermes_cli.kanban_human_request_migration import classify_parked_request
+    monkeypatch.setenv("HERMES_KANBAN_DB", str(tmp_path / "ask-amend.db"))
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    kb.init_db()
+    conn = kbc.connect()
+    try:
+        tid = kb.create_task(conn, title="ask amend", assignee="worker")
+        for chat in ("chat-1", "chat-2"):
+            kbn.add_notify_sub(conn, task_id=tid, platform="telegram", chat_id=chat,
+                               chat_type="dm", delivery_mode="notify+wake")
+        if not metadata_only:
+            assert kb.block_task(conn, tid, reason="decide", kind="needs_input", human_request=_ASK, actor=_EDITOR)
+        else:
+            assert kb.block_task(conn, tid, reason="decide", kind="needs_input",
+                                 human_request={**_ASK, "action": "Choose A."}, actor="user")
+    finally:
+        conn.close()
+    adapter = RecordingAdapter()
+    runner = _make_runner(adapter)
+    if metadata_only:
+        asyncio.run(_run_one_notifier_tick(monkeypatch, runner))  # drain the original block
+        adapter.sent.clear()
+        adapter.handled.clear()
+        conn = kbc.connect()
+        try:
+            assert classify_parked_request(conn, tid, human_request=_ASK, actor=_EDITOR, reason="decide")
+        finally:
+            conn.close()
+        runner._running = True
+    asyncio.run(_run_one_notifier_tick(monkeypatch, runner))
+    return tid, adapter
+
+
+def _cursor_passes_last_event(tid, chat):
+    conn = kbc.connect()
+    try:
+        _, events = kbn.unseen_events_for_sub(conn, task_id=tid, platform="telegram", chat_id=chat, kinds=["blocked"])
+        return events == []
+    finally:
+        conn.close()
+
+
+def test_metadata_only_ask_amend_is_silent_for_the_editing_chat(tmp_path, monkeypatch):
+    """(a) The chat that amended the ask gets no ping and no wake; its cursor still passes the event."""
+    tid, adapter = _amend_fixture(monkeypatch, tmp_path, metadata_only=True)
+    assert [m["chat_id"] for m in adapter.sent] == ["chat-2"]
+    assert all(e.source.chat_id != "chat-1" for e in adapter.handled)
+    assert _cursor_passes_last_event(tid, "chat-1")
+
+
+def test_metadata_only_ask_amend_tells_other_subscribers_ask_updated(tmp_path, monkeypatch):
+    """(b) Another subscriber gets one "ask updated" line carrying the new action, no "blocked —" notice."""
+    tid, adapter = _amend_fixture(monkeypatch, tmp_path, metadata_only=True)
+    (text,) = [m["text"] for m in adapter.sent if m["chat_id"] == "chat-2"]
+    assert "ask updated (card still blocked): " + _ASK["action"] in text
+    assert "blocked —" not in text and "Next action for the user" not in text
+    assert len(text.splitlines()) == 1
+    assert _cursor_passes_last_event(tid, "chat-2")
+
+
+def test_real_block_by_the_same_chat_still_notifies_it(tmp_path, monkeypatch):
+    """(c) Current policy: a real block transition notifies every subscriber, its own actor chat included."""
+    _, adapter = _amend_fixture(monkeypatch, tmp_path, metadata_only=False)
+    assert sorted(m["chat_id"] for m in adapter.sent) == ["chat-1", "chat-2"]
+    for m in adapter.sent:
+        assert f"blocked — actor: {_EDITOR}" in m["text"]
+        assert "Next action for the user: " + _ASK["action"] in m["text"]
+    assert sorted(e.source.chat_id for e in adapter.handled) == ["chat-1", "chat-2"]
