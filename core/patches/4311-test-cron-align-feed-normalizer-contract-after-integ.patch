From e155c384ba6e3923e0741f904e265355178fae38 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 04:13:02 +0000
Subject: [PATCH] test(cron): align feed normalizer contract after integration
 [daveey]

The redirection ampersand normalizer now escapes amp-prefix punctuation before shlex, just as it already does descriptor copies. Retain main feed-routing behavioral tests and update only the two raw intermediate-text expectations. Rebased consumer suite and full scripts/check --base origin/main pass.
---
 tests/cron/test_lifecycle_guard_feed_routing.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/cron/test_lifecycle_guard_feed_routing.py b/tests/cron/test_lifecycle_guard_feed_routing.py
index c6f5704c57..2321267fbc 100644
--- a/tests/cron/test_lifecycle_guard_feed_routing.py
+++ b/tests/cron/test_lifecycle_guard_feed_routing.py
@@ -223,8 +223,8 @@ def test_redirection_ampersands_survive_tokenizing():
 def test_glued_ampersand_redirection_splits_from_its_word():
     from cron.lifecycle_guard_groups import split_glued_redirections as split
 
-    assert split("python3 f.py&>x") == "python3 f.py &>x"
-    assert split("a 'b'&>>y") == "a 'b' &>>y"
+    assert split("python3 f.py&>x") == r"python3 f.py \&>x"
+    assert split("a 'b'&>>y") == r"a 'b' \&>>y"
     # Main's fd normalizer escapes duplication punctuation for shlex; it stays one token.
     assert split("a 2>&1 >&2") == r"a 2>\&1 >\&2"
     # Control operators, quoted ampersands and lone `&` remain unchanged. An escaped `&`
