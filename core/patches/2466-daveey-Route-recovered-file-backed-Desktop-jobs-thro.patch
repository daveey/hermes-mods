From b673b14ae2fdedda3e048c34919801506ac6e48f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 02:42:03 +0000
Subject: [PATCH] [daveey] Route recovered file-backed Desktop jobs through
 chat wake sink

---
 .../tools/test_process_readopt_output_log.py  | 55 +++++++++++++++++++
 tools/process_registry_checkpoint.py          |  3 +
 2 files changed, 58 insertions(+)
 create mode 100644 tests/tools/test_process_readopt_output_log.py

diff --git a/tests/tools/test_process_readopt_output_log.py b/tests/tools/test_process_readopt_output_log.py
new file mode 100644
index 0000000000..989cf62280
--- /dev/null
+++ b/tests/tools/test_process_readopt_output_log.py
@@ -0,0 +1,55 @@
+"""A Desktop restart must route file-backed completions to unopened chats."""
+import json
+import threading
+
+import pytest
+
+from tools.process_registry import ProcessRegistry
+from tests.tools import test_process_orphan_readopt_tui as helpers
+
+TUI_KEY = helpers.TUI_KEY
+_entry = helpers._entry
+_kill = helpers._kill
+checkpoint = helpers.checkpoint
+procs = helpers.procs
+
+
+@pytest.mark.parametrize("exit_before_recovery", [False, True])
+def test_readopted_log_wakes_owning_chat_once(
+    checkpoint, procs, tmp_path, monkeypatch, exit_before_recovery,
+):
+    child = procs()
+    log = tmp_path / "proc_restart.log"
+    log.write_text("finished persisted work\n")
+    monkeypatch.setattr("tools.process_registry_output_log.output_dir", lambda: tmp_path)
+    entry = _entry("proc_restart", child.pid, TUI_KEY)
+    entry.update(output_log=str(log), persist_on_release=True)
+    checkpoint.write_text(json.dumps([entry]))
+    if exit_before_recovery:
+        log.with_suffix(".exit").write_text("0\n")
+        _kill(child)
+    registry = ProcessRegistry()
+    delivered = []
+    ready = threading.Event()
+
+    def wake(event):
+        delivered.append(event)
+        ready.set()
+
+    registry.on_unknown_exit = wake
+    assert registry.recover_from_checkpoint(owner="tui") == 1
+    session = registry.get("proc_restart")
+    assert session is not None
+    if not exit_before_recovery:
+        log.with_suffix(".exit").write_text("0\n")
+        _kill(child)
+    assert session._completion_event.wait(5)
+    assert ready.wait(1), "completion never reached the unopened chat's wake sink"
+    assert len(delivered) == 1
+    assert delivered[0]["session_key"] == TUI_KEY
+    assert delivered[0]["exit_code"] == 0
+    assert "finished persisted work" in delivered[0]["output"]
+    registry.sweep_detached_once()
+    registry.recover_from_checkpoint(owner="tui")
+    assert len(delivered) == 1
+    assert registry.completion_queue.empty()
diff --git a/tools/process_registry_checkpoint.py b/tools/process_registry_checkpoint.py
index 196864a07a..d38a149797 100644
--- a/tools/process_registry_checkpoint.py
+++ b/tools/process_registry_checkpoint.py
@@ -376,6 +376,9 @@ class ProcessCheckpointMixin:
             # A TUI backend reports the eventual exit (status unknown) to the owning chat; a gateway keeps the
             # exited session for its recovered watcher to deliver. [daveey]
             session._report_lost_exit = owner == OWNER_TUI
+            # File-backed host jobs collect a real exit, just like re-attached sandbox jobs.
+            # Route it to the Desktop waker even when the owning chat is not loaded.
+            session._completion_via_readopt_sink = owner == OWNER_TUI
             session._lost_exit_via_watcher = owner != OWNER_TUI and session.watcher_interval > 0
             if session.output_log:
                 self._track_started(session, self._log_reader_loop, f"proc-log-reader-{session.id}")
