 .../test_kanban_agent_stop_routing.py           |  2 ++
 tests/hermes_cli/test_kanban_park_invariants.py |  9 ++++-----
 .../test_kanban_review_lifecycle_complete.py    |  4 ++--
 .../test_kanban_worker_exit_trailer.py          |  6 +++---
