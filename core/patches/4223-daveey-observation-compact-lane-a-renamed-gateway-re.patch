From fc79071a435ca886bd398c6ce9b5567d21a1d337 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 16:59:57 +0000
Subject: [PATCH] [daveey] observation compact lane: a renamed gateway
 re-classifies every replica row

Follow-up to PR #3035 (review t_01a1daf143756f46, card t_01a1dafad397d653).

`compact.scan` skipped a row whose (hash(owner, key), seq) was already in `lane.table` and never re-ran
`compactable(...)` for it. The table was bound to the replica flight and the ledger, not to `me` (the replica's
`meta.gateway`). After an in-place rename, a row that was a bystander for the old name but is linked to the new
one stayed compact until its seq moved, so `observe()` left it out of the fresh map and collect/sweep treated it
as not yet observed. Main decodes every row, so the card was present there.

`Lane.me` now records the gateway the table was classified for. When `me` differs, the table is marked untrusted
(every row is re-read and re-classified; its state hashes still hold, so unchanged terminal bystanders are not
re-queued to the ledger) and the flight's decoded entries for this replica are dropped.

Proof: new test_bystander_linked_after_an_in_place_gateway_rename_is_observed is RED on b71d8987db
(`'default/default/t_b' in set()`) and GREEN here.
---
 .../test_remote_projection_bystander_memory.py | 18 ++++++++++++++++++
 .../kanban_remote_observation_compact.py       |  9 ++++++++-
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_remote_projection_bystander_memory.py b/tests/tui_gateway/test_remote_projection_bystander_memory.py
index 6b43a05869..8d3f0b28dd 100644
--- a/tests/tui_gateway/test_remote_projection_bystander_memory.py
+++ b/tests/tui_gateway/test_remote_projection_bystander_memory.py
@@ -217,3 +217,21 @@ def test_observation_lane_keeps_bystanders_in_fixed_width_columns(tmp_path):
     with sqlite3.connect(ledger) as conn:  # bystander terminal states still reach the ledger, as on main
         refs = {ref for (ref,) in conn.execute("SELECT ref FROM observations")}
     assert refs == {f"hub/{_relevant(0)['key']}"} | {f"hub/{_bystander(i)['key']}" for i in range(50)}
+
+
+def test_bystander_linked_after_an_in_place_gateway_rename_is_observed(tmp_path):
+    # The replica's meta.gateway changes in place: a row that was a bystander for the old name and is linked to the
+    # new one must be re-classified at once (as main decodes every row), not stay compact until its seq moves.
+    card = _card("t_b", "chat_x", status="done", at=NOW - 60)
+    card["task"]["sessions"][0]["gw"] = "otherbox"
+    replica = _hub(tmp_path, [card])
+    ledger = tmp_path / "remote-notices.db"
+    remote._reset_for_tests()
+    assert obs.observe(replica, ledger, NOW) == {}
+    with sqlite3.connect(replica) as conn:
+        conn.execute("UPDATE meta SET v = 'otherbox' WHERE k = 'gateway'")
+        conn.execute("UPDATE meta SET v = '101' WHERE k IN ('cursor', 'head')")
+    fresh = obs.observe(replica, ledger, NOW + 5)
+    assert card["key"] in {key for (_gw, key, _state) in fresh}
+    (flight,) = obs._retained.values()
+    assert len(flight.lane.table) == 0 and flight.lane.me == "otherbox"
diff --git a/tui_gateway/kanban_remote_observation_compact.py b/tui_gateway/kanban_remote_observation_compact.py
index b8fc238db9..5635daf111 100644
--- a/tui_gateway/kanban_remote_observation_compact.py
+++ b/tui_gateway/kanban_remote_observation_compact.py
@@ -6,7 +6,8 @@ row. A bystander (``remote_sweep_projection.compactable``) is never offered to a
 states still reach the observation ledger (a card linked later must keep main's ``first_seen``): a re-decoded
 row whose ``(ref, state)`` was not yet queued goes to ``Lane.pending``, which ``observe`` persists with the
 relevant cards. The table belongs to one ledger file; a second ledger path turns the lane off (full form, one
-cold re-read), a replaced ledger file re-reads so every terminal bystander is written to it.
+cold re-read), a replaced ledger file re-reads so every terminal bystander is written to it. The table also
+belongs to one ``me`` (the replica's ``meta.gateway``): a renamed gateway re-classifies every row.
 """
 from __future__ import annotations
 
@@ -50,6 +51,7 @@ class Lane:
         self.table = Table()
         self.home: tuple | None = None  # (ledger path, ledger file id) | _MULTI
         self.pending: list[tuple] = []  # (owner, key, summary) not yet written to the home ledger
+        self.me = None  # the gateway the table's rows were classified for
 
     @property
     def enabled(self) -> bool:
@@ -93,6 +95,11 @@ def scan(conn, rows, tag: str, me, decoded: dict, lane: Lane, summarize) -> list
     collide = {a for a, b in pairwise(ordered) if a == b}
     del ordered
     seen, cards, entries = set(), [], []
+    if lane.me != me:  # a bystander for the old name may be linked to this one: re-read and re-classify every row
+        lane.table.trusted = False  # its state hashes still hold, so unchanged terminal states are not re-queued
+        for ident in [ident for ident in decoded if ident[0] == tag]:
+            del decoded[ident]
+        lane.me = me
     old = lane.table
     for (owner, key, seq, _), row_hash in zip(canonical, hashes):
         ident = (tag, owner, key)
