From 3b89a276be305c9d42f63386d807068baf1f30a5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 26 Nov 2026 08:01:28 +0000
Subject: [PATCH 6587] Desktop kanban model-requirement and recovery transport test harnesses

Public mirror of source commit 3b89a276be305c9d42f63386d807068baf1f30a5.

---
diff --git a/.github/workflows/e2e-desktop-core.yml b/.github/workflows/e2e-desktop-core.yml
index 9e8f5c55b43..c66ae2a066a 100644
--- a/.github/workflows/e2e-desktop-core.yml
+++ b/.github/workflows/e2e-desktop-core.yml
@@ -12,6 +12,9 @@
 # it was wired in.
 
 on:
+  # Ordinary PR CI deliberately masks E2E lanes. This runs the same isolated
+  # Linux job on the selected branch without dispatching every release lane.
+  workflow_dispatch:
   workflow_call:
     inputs:
       commit:
diff --git a/tests/ci/test_desktop_core_dispatch.py b/tests/ci/test_desktop_core_dispatch.py
new file mode 100644
index 00000000000..b498e41ec32
--- /dev/null
+++ b/tests/ci/test_desktop_core_dispatch.py
@@ -0,0 +1,26 @@
+"""A scoped manual Linux run exercises Desktop specs masked in ordinary PR CI."""
+from pathlib import Path
+
+import hermes_yaml
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def test_manual_desktop_core_uses_existing_isolated_linux_job():
+    workflow = hermes_yaml.safe_load(
+        (ROOT / '.github/workflows/e2e-desktop-core.yml').read_text())
+    triggers = workflow.get('on', workflow.get(True))
+    assert 'workflow_dispatch' in triggers
+    assert 'workflow_call' in triggers
+    assert set(triggers) == {'workflow_dispatch', 'workflow_call'}
+    assert workflow['permissions'] == {'contents': 'read'}
+    assert set(workflow['jobs']) == {'core'}
+    job = workflow['jobs']['core']
+    assert job['runs-on'] == 'blacksmith-4vcpu-ubuntu-2404'
+    checkout = job['steps'][0]
+    assert checkout['with']['ref'] == '${{ inputs.commit }}'
+    run = next(step for step in job['steps'] if step.get('name') == 'Run the core suite under xvfb')
+    assert 'playwright test -c e2e/core/playwright.config.ts' in run['run']
+    assert run['env']['HERMES_E2E_PYTHON'] == '${{ steps.pm.outputs.python-path }}'
+    for key in ('OPENROUTER_API_KEY', 'OPENAI_API_KEY', 'NOUS_API_KEY', 'ANTHROPIC_API_KEY'):
+        assert run['env'][key] == ''
