From 7bf2b7a534dc4a949ad92e880805d179ab68fe2d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 18:27:39 +0000
Subject: [PATCH] [daveey] D2 benchmark: write JSON as utf-8

---
 scripts/benchmark_rank_memo.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/scripts/benchmark_rank_memo.py b/scripts/benchmark_rank_memo.py
index 6d669cc80f..313f604060 100644
--- a/scripts/benchmark_rank_memo.py
+++ b/scripts/benchmark_rank_memo.py
@@ -181,7 +181,7 @@ def main() -> int:
         result = {"replay": replay(0, a.rounds, a.store)}
         print(json.dumps(result, indent=1))
         if a.json:
-            Path(a.json).write_text(json.dumps(result, indent=1))
+            Path(a.json).write_text(json.dumps(result, indent=1), encoding="utf-8")
         return 0
     sizes = [int(s) for s in a.sizes.split(",")]
     result: dict = {"scale": [scale(n) for n in sizes]}
@@ -191,7 +191,7 @@ def main() -> int:
     result["replay"] = replay(a.replay_size, a.rounds)
     print(json.dumps(result, indent=1))
     if a.json:
-        Path(a.json).write_text(json.dumps(result, indent=1))
+        Path(a.json).write_text(json.dumps(result, indent=1), encoding="utf-8")
     worst = max(result["growth"].get(k, 0) for k in ("served_ms", "heartbeat_rerank_ms", "message_rerank_ms"))
     return 0 if worst <= 1.5 else 1
 
-- 
2.43.0

