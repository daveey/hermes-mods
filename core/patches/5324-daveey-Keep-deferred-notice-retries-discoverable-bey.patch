From 8200ea31e5d2c8f0f3c6dcaf64f30a31fe355898 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 22:54:11 +0000
Subject: [PATCH] [daveey] Keep deferred notice retries discoverable beyond
 lookback

Apply expiry only after bounded settled-tail traversal. The physical superseded row has no deferred receipt; filtering it first stranded the durable retry beneath it after a long quota reset.

Proof: reviewer finding reproduced with real SessionDB and locally rendered settlement: two discovery-route regressions fail on the old source, both no-tail controls pass. Removing only the premature filter yields 151 passing notice/retry/outcome/split-module tests. Not-yet-due controls remain excluded. Full check requires fresh main to remove unrelated stale-base desktop health violations.
---
 tests/tui_gateway/test_notice_supersession.py | 15 +++++++++++++++
 tui_gateway/notice_guarantee.py               |  5 ++---
 2 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/tests/tui_gateway/test_notice_supersession.py b/tests/tui_gateway/test_notice_supersession.py
index eeae511cf8..f8daa8cffb 100644
--- a/tests/tui_gateway/test_notice_supersession.py
+++ b/tests/tui_gateway/test_notice_supersession.py
@@ -93,6 +93,21 @@ def test_preceding_deferred_notice_is_retried_beneath_superseded_tail(db):
     assert calls == [(CHAT, old)]
 
 
+@pytest.mark.parametrize("only", [None, {CHAT}])
+@pytest.mark.parametrize("settled_tail", [False, True])
+def test_long_deferred_retry_survives_discovery_lookback(db, only, settled_tail):
+    now = time.time()
+    retry_at = now + ng.LOOKBACK_S + 3600
+    old = _notice(db, "A durable close-out awaits quota reset.",
+                  closeout={"state": "deferred", "retry_at": retry_at, "attempts": 1})
+    if settled_tail:
+        _retired_block(db)
+        out, calls = _run(db, now=now)
+        assert calls == [] and out[0]["result"] == "superseded"
+    assert ng.candidates(db, retry_at - 1, only=only) == []
+    assert [c["msg_id"] for c in ng.candidates(db, retry_at + 1, only=only)] == [old]
+
+
 @pytest.mark.parametrize("case", ["ci", "running", "chat", "composite", "remote", "missing", "wrong_kind", "bad_id",
                                   "missing_park", "missing_awaiting", "malformed_park", "missing_event", "missing_board", "old_park"])
 def test_creator_decision_supersession_requires_current_local_proof(db, case):
diff --git a/tui_gateway/notice_guarantee.py b/tui_gateway/notice_guarantee.py
index 40aa5f7f5d..390b400002 100644
--- a/tui_gateway/notice_guarantee.py
+++ b/tui_gateway/notice_guarantee.py
@@ -165,9 +165,8 @@ def candidates(db: Any, now: float, only: Optional[set[str]] = None) -> list[dic
     from tui_gateway.notice_history import preceding_candidate, settled_notice, whole_row_settled
 
     for row in rows:
-        if row["last_active"] is not None and row["last_active"] < now - LOOKBACK_S and not _deferred_due(
-                _decode(row["display_metadata"]), now):
-            continue
+        # Expire the effective obligation, not a settled physical tail: an older
+        # notice beneath it may hold a durable retry beyond the discovery window.
         row = preceding_candidate(db, row)
         # Cache structure, not age: a notice can become due (or expire) without a commit.
         meta = _decode(row["display_metadata"])
-- 
