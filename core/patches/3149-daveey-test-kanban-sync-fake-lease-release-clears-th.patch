From 2968696a84d2ddd927a2831cff52a2925b9dc1b4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 05:03:11 +0000
Subject: [PATCH] [daveey] test(kanban-sync): fake lease release clears the
 card's lease mirror after the run ended

Review 5886375416 on PR #1880 (nits 1, 3): FakeHub.leases action=release
dropped lease_run_uid only while the run row was still open, but hermes-hub
releaseTask's clearLease clears lease_holder/lease_run_uid/lease_expires
whenever the holder's lease ends. Mirror that, with a test (RED without the
fake change: mirror stayed set). The end-to-end veto test's docstring now says
the rejected local release op is still inserted by hand.
---
 tests/hermes_cli/kanban_sync_fake_board.py     |  4 ++++
 .../hermes_cli/test_kanban_sync_rejections.py  | 18 +++++++++++++++++-
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/kanban_sync_fake_board.py b/tests/hermes_cli/kanban_sync_fake_board.py
index 989cb2e5a6..cba715f9b8 100644
--- a/tests/hermes_cli/kanban_sync_fake_board.py
+++ b/tests/hermes_cli/kanban_sync_fake_board.py
@@ -274,6 +274,10 @@ class FakeHub:
                                    "created_at": int(time.time())}, gw, op_id, hlc)
                 self.svc._put(b, "tasks", task, {"status": "ready", "current_run_uid": None, "lease_holder": None,
                                                  "lease_run_uid": None, "lease_expires": None}, gw, op_id, hlc)
+            elif self.svc.lease_runs and cur and task in b["rows"].get("tasks", {}):
+                # releaseTask's clearLease drops the card's lease mirror even when the holder already ended its run.
+                self.svc._put(b, "tasks", task, {"lease_holder": None, "lease_run_uid": None, "lease_expires": None},
+                              gw, op_id, hlc)
             return {"status": "applied", "lease": None}
         return {"status": "applied", "lease": b["leases"][task], "version": version}
 
diff --git a/tests/hermes_cli/test_kanban_sync_rejections.py b/tests/hermes_cli/test_kanban_sync_rejections.py
index e5d93e8258..26f89c9fc6 100644
--- a/tests/hermes_cli/test_kanban_sync_rejections.py
+++ b/tests/hermes_cli/test_kanban_sync_rejections.py
@@ -271,7 +271,7 @@ def test_live_lease_by_the_run_keeps_release_end_to_end(live, kanban_home):
     """The ``lease_held`` veto through real Board transitions, not a hand-set row: the grant mirrors the lease
     onto the card (setLease), the holder then ends its run row and drops ``current_run_uid`` while keeping the
     lease, so only ``lease_run_uid`` still names the run. Once the holder leaves ``running`` (clearLease), the same
-    release is moot."""
+    release is moot. End-to-end on the Board side only: the rejected local release op is still inserted by hand."""
     svc = FakeService(lease_runs=True)
     hub = svc.hub(ME)
     tid = kb.create_task(live, title="leased", assignee="worker")
@@ -308,6 +308,22 @@ def test_live_lease_by_the_run_keeps_release_end_to_end(live, kanban_home):
     assert client.status(live)["rejected"] == 0
 
 
+def test_fake_lease_release_after_run_end_clears_mirror(live, kanban_home):
+    """As releaseTask's clearLease: releasing a lease whose run row already ended still drops lease_run_uid."""
+    svc = FakeService(lease_runs=True)
+    hub = svc.hub(ME)
+    tid = kb.create_task(live, title="leased", assignee="worker")
+    client.push(live, hub, BOARD, ME, primary=False)
+    assert hub.leases(BOARD, {"action": "grant", "task": tid, "run_uid": RUN, "client_op_id": "g"})["status"] == "applied"
+    res = hub.ops(BOARD, [{"client_op_id": "end", "table": "task_runs", "uid": RUN, "op": "upsert",
+                           "fields": {"ended_at": 1794527437, "status": "crashed", "outcome": "crashed"},
+                           "hlc": f"{9_999_999_999_999:013d}-0001-{ME}"}])["results"][0]
+    assert res["status"] == "applied", res
+    assert hub.leases(BOARD, {"action": "release", "task": tid, "run_uid": RUN, "client_op_id": "r"})["status"] == "applied"
+    card = svc.board(BOARD)["rows"]["tasks"][tid]
+    assert (card["lease_holder"], card["lease_run_uid"], card["lease_expires"]) == (None, None, None)
+
+
 def test_release_local_change_during_read_vetoes(live, svc, monkeypatch):
     lost_release(live, svc)
     hub = svc.hub(ME)
