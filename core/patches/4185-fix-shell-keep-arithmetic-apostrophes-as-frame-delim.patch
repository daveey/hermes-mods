From db8d6754b56aa3ebb612423d0c1287cca7260814 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 14:23:45 +0000
Subject: [PATCH] fix(shell): keep arithmetic apostrophes as frame delimiters
 [daveey]

Review of #2981 at ff96c44e63 (request_changes): treating apostrophes as
literal inside a[...], ${h[...]} and (( )) frames let a quoted `]` or `)`
(`h[']']`, `${h[']']}`, `h['x]y']`, `(( ')' ))`) close the scanner's frame
early; the leftover apostrophe then opened a phantom command-context quote
that hid every later arithmetic sink. Real bash 5.2.21 ran the marker in
all five shapes while head returned False (base c4e1d331 returned True).

Why: bash uses the apostrophes to find the frame closer, then evaluates the
text with double-quote semantics. The scanner modeled only the second step.

Fix: always match the apostrophe span with _quote_close so delimiters stay
correct, and fail closed (sink) when an apostrophe span inside an
arithmetic frame holds `$(` (including `$((`, which may be `$( (...) )`)
or a backtick; the date producer exemption still applies.

RED (ff96c44e63 + new tests): test_lifecycle_guard_arith_lexical.py
7 failed / 22 passed (5 real-bash marker shapes + 2 literal-data cases).
GREEN: same file 29 passed; 37-file lifecycle/shell family 2712 passed,
0 failed; test_shell_guard_mutation_regressions 5 passed; scripts/check
20 ok. Mutant (_span_substitutes -> False) fails 3 tests.
---
 .../test_lifecycle_guard_arith_lexical.py     | 11 ++++++++++
 tools/shell_arith_sink.py                     | 21 +++++++++++++++----
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/tests/cron/test_lifecycle_guard_arith_lexical.py b/tests/cron/test_lifecycle_guard_arith_lexical.py
index 09a5286591..7120a524fc 100644
--- a/tests/cron/test_lifecycle_guard_arith_lexical.py
+++ b/tests/cron/test_lifecycle_guard_arith_lexical.py
@@ -18,6 +18,14 @@ SHAPES = [
     "unset v; x=$(( ${v:-`echo 'b[$(bash SCRIPT)]'`} ))",
     "x=$(( '0+$(bash SCRIPT)' ))",
     "unset v; x=$(( ${v:-'0+$(bash SCRIPT)'} ))",
+    "a['$(bash SCRIPT)']=1",
+    # Bash finds subscript and (( )) closers past quoted delimiters; a quoted
+    # `]` or `)` must not close the frame and leave a phantom command quote.
+    r"declare -A h; h[']']=1; a[$(echo b[\$\(bash SCRIPT\)])]=1; echo \'",
+    r"declare -A h; echo ${h[']']}; a[$(echo b[\$\(bash SCRIPT\)])]=1; echo \'",
+    r"declare -A h; h['x]y']=1; a[$(echo b[\$\(bash SCRIPT\)])]=1; echo \'",
+    r"(( ')' )); a[$(echo b[\$\(bash SCRIPT\)])]=1; echo \'",
+    "(( ')' ))\n" r"a[$(echo b[\$\(bash SCRIPT\)])]=1; echo \'",
 ]
 
 
@@ -66,6 +74,9 @@ def test_backtick_output_is_an_arithmetic_sink(command):
     r"echo \$\{; echo $(printf 0)",
     "echo $$$${; echo $(printf 0)",
     "echo $$'${'; echo $(printf 0)",
+    "declare -A h; h[']']=1; echo $(printf 0)",
+    "(( ')' + 0 )); echo $(printf 0)",
+    "x=$(( a[')'] )); echo $(printf 0)",
 ])
 def test_literal_or_nonarithmetic_substitutions_remain_data(command):
     assert not substitution_in_arithmetic(command, date_exempt=True)
diff --git a/tools/shell_arith_sink.py b/tools/shell_arith_sink.py
index 782662c35e..90359aa618 100644
--- a/tools/shell_arith_sink.py
+++ b/tools/shell_arith_sink.py
@@ -143,15 +143,28 @@ def _arithmetic_quotes(stack) -> bool:
     return False
 
 
+def _span_substitutes(span: str, date_exempt: bool) -> bool:
+    """Whether an apostrophe span evaluated as arithmetic holds a command substitution."""
+    if "`" in span:
+        return True
+    return any(not (date_exempt and _DATE_PRODUCER_RE.match(span, m.end()))
+               for m in re.finditer(r"\$\(", span))  # `$((` too: it may be `$( (…)…)`
+
+
 def _skip_data(command, token, start, pos, quoted, stack, pending, date_exempt, depth) -> int | None:
     """Skip literal spans; None means a normal token, -1 means fail closed."""
     kind = stack[-1][0]
     if token in ("'", "$'"):
-        # Arithmetic expansion has double-quote semantics: apostrophes do not
-        # suppress expansion, including in parameter words feeding arithmetic.
-        if quoted or _arithmetic_quotes(stack):
+        if quoted:
             return pos
-        return _quote_close(command, pos, ansi=token == "$'") or -1
+        close = _quote_close(command, pos, ansi=token == "$'")
+        if close is None:
+            return -1
+        if _arithmetic_quotes(stack) and _span_substitutes(command[pos:close], date_exempt):
+            # Bash still uses the apostrophes to find the frame's closer, but then
+            # evaluates the text with double-quote semantics, so `$(`/backticks run.
+            return -1
+        return close
     if quoted:
         return None
     # Lazy import: shell_heredoc calls this scanner, but owns delimiter parsing.
