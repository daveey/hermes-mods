@@ -0,0 +1,46 @@
+import { expect, test, vi } from 'vitest'
+
+import { createRegistryRetirementClient } from './registry-retirement-http'
+
+const descriptor = { baseUrl: 'http://127.0.0.1:31000', token: 'synthetic-token' }
+
+test('ownership remains provable for a deleted runtime without treating it as reusable', async () => {
+  const request = vi.fn(async () => ({ ok: true, protocolVersion: 1, sshOwnerNonce: 'nonce', runtimeIntact: false }))
+  const client = createRegistryRetirementClient(request)
+  expect(await client.proveOwned(descriptor, 'nonce')).toBe(true)
+  expect(await client.proveOwned(descriptor, 'other')).toBe(false)
+  expect(request).toHaveBeenCalledWith(descriptor, '/api/ssh/ownership', { timeoutMs: 3000 })
+})
+
+test.each([null, {}, { ok: true, idle: null }, { ok: true, idle: false, token: 'permit' }, { ok: true, idle: true }])(
+  'unknown or busy preparation grants no permit: %j', async reply => {
+    const client = createRegistryRetirementClient(vi.fn(async () => reply))
+    expect(await client.prepare(descriptor)).toBeNull()
+  }
+)
+
+test('uses the exact authenticated descriptor for prepare, commit and cancellation', async () => {
+  const request = vi.fn(async () => ({ ok: true, idle: true, token: 'permit' }))
+  const client = createRegistryRetirementClient(request)
+  expect(await client.prepare(descriptor)).toBe('permit')
+  expect(await client.commit(descriptor, 'permit')).toBe(true)
+  await client.cancel(descriptor, 'permit')
+  expect(request.mock.calls).toEqual(['prepare', 'commit', 'cancel'].map(action => [
+    descriptor, '/api/health/retirement', {
+      method: 'POST', timeoutMs: 3000,
+      body: { action, ...(action === 'prepare' ? {} : { token: 'permit' }) }
+    }
+  ]))
+})
+
+test.each([null, {}, { ok: 'true' }])('ambiguous commit response throws rather than releasing the fence: %j', async reply => {
+  const client = createRegistryRetirementClient(vi.fn(async () => reply))
+  await expect(client.commit(descriptor, 'permit')).rejects.toThrow('Unknown retirement commit outcome')
+})
+
+test('transport loss at commit propagates while a definite refusal returns false', async () => {
+  const request = vi.fn().mockRejectedValueOnce(new Error('lost response')).mockResolvedValueOnce({ ok: false })
+  const client = createRegistryRetirementClient(request)
+  await expect(client.commit(descriptor, 'permit')).rejects.toThrow('lost response')
+  expect(await client.commit(descriptor, 'permit')).toBe(false)
+})
diff --git a/apps/desktop/electron/registry-retirement-http.ts b/apps/desktop/electron/registry-retirement-http.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d2b1cd9d17d28c48e6308774a553197596180525
--- /dev/null
+++ b/apps/desktop/electron/registry-retirement-http.ts
@@ -0,0 +1,53 @@
+interface RetirementReply {
+  ok?: boolean
+  idle?: boolean | null
+  token?: string
+  sshOwnerNonce?: string
+  protocolVersion?: number
+}
+
+type RequestJson<D> = (
+  descriptor: D,
+  path: string,
+  options: { method?: string; body?: Record<string, string>; timeoutMs: number }
+) => Promise<unknown>
+
+/** Remote descriptors must use the bearer-aware authenticated transport.
+ * Unlike the local pool client, an unknown commit result must propagate: the
+ * coordinator must retain its gate until the exact resident is reconciled.
+ */
+export function createRegistryRetirementClient<D>(requestJson: RequestJson<D>) {
+  async function request(descriptor: D, action: string, token?: string) {
+    return await requestJson(descriptor, '/api/health/retirement', {
+      method: 'POST', body: { action, ...(token ? { token } : {}) }, timeoutMs: 3000
+    }) as RetirementReply | null
+  }
+
+  return {
+    proveOwned: async (descriptor: D, nonce: string): Promise<boolean> => {
+      const proof = await requestJson(descriptor, '/api/ssh/ownership', { timeoutMs: 3000 }) as RetirementReply | null
+
+      // runtimeIntact is deliberately NOT a prerequisite for retirement. A
+      // deleted managed Python runtime is precisely what reconnect repairs.
+      return Boolean(nonce) && proof?.ok === true && proof.protocolVersion === 1 && proof.sshOwnerNonce === nonce
+    },
+    prepare: async (descriptor: D): Promise<string | null> => {
+      const reply = await request(descriptor, 'prepare')
+
+      return reply?.ok === true && reply.idle === true && typeof reply.token === 'string' && reply.token
+        ? reply.token : null
+    },
+    commit: async (descriptor: D, token: string): Promise<boolean> => {
+      const reply = await request(descriptor, 'commit', token)
+
+      if (reply?.ok !== true && reply?.ok !== false) {
+        throw new Error('Unknown retirement commit outcome')
+      }
+
+      return reply.ok
+    },
+    cancel: async (descriptor: D, token: string): Promise<void> => {
+      await request(descriptor, 'cancel', token)
+    }
+  }
+}
