diff --git a/apps/desktop/electron/registry-reconnect-service.test.ts b/apps/desktop/electron/registry-reconnect-service.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1dcdfa61be554401397c2947ca0e568257097b96
--- /dev/null
+++ b/apps/desktop/electron/registry-reconnect-service.test.ts
@@ -0,0 +1,128 @@
+import { expect, test, vi } from 'vitest'
+
+import { ManagedConnectionUpdateGate } from './managed-ssh-update'
+import { createRegistryReconnectService } from './registry-reconnect-service'
+
+function fixture() {
+  const descriptor = { baseUrl: 'http://hub', token: 'synthetic' }
+  const primary = { connectionPromise: Promise.resolve({ baseUrl: 'http://local' }) }
+  const entry = { connectionPromise: Promise.resolve(descriptor) }
+  const state = { registryConnectionId: 'hub', primaryRegistryScope: false, spawnNonce: 'owned', remotePlatform: 'Linux' }
+  const pool = new Map([['default', primary], ['conn:hub::default', entry]])
+  const states = new Map([['conn:hub::default', state]])
+  const gate = new ManagedConnectionUpdateGate()
+
+  const request = vi.fn(async (_descriptor, path, options) => path === '/api/ssh/ownership'
+    ? { ok: true, protocolVersion: 1, sshOwnerNonce: 'owned', runtimeIntact: false }
+    : { ok: true, idle: true, token: 'permit', action: options.body?.action })
+
+  const terminate = vi.fn(async () => {})
+  const close = vi.fn(async () => {})
+
+  const reopen = vi.fn(async (id, profile, correlation) => {
+    gate.assertCanDial(id, correlation)
+    pool.set(`conn:${id}::${profile}`, { connectionPromise: Promise.resolve(descriptor) })
+    states.set(`conn:${id}::${profile}`, { ...state, spawnNonce: 'new-owned' })
+  })
+
+  const service = createRegistryReconnectService({
+    pool, states, gate, request, terminate, close, reopen,
+    onCleanupError: vi.fn(),
+    key: (id, profile) => `conn:${id}::${profile}`,
+    isSsh: id => id === 'hub',
+    inFlight: () => false
+  })
+
+  return { service, pool, states, entry, state, primary, gate, request, terminate, reopen, close }
+}
+
+test('composed reconnect repairs a deleted runtime without touching local default', async () => {
+  const f = fixture()
+  const target = f.service.target('hub', 'default')!
+  expect(target.generation).toBeTruthy()
+  const result = await f.service.run(target)
+  expect(result.ok).toBe(true)
+  expect(result.generation).not.toBe(target.generation)
+  expect(f.terminate).toHaveBeenCalledWith(f.state)
+  expect(f.pool.get('default')).toBe(f.primary)
+  expect(f.request.mock.calls.map(call => call[2].body?.action).filter(Boolean)).toEqual(['prepare', 'commit'])
+  expect(f.gate.owner('hub')).toBeNull()
+})
+
+test('a second profile cannot borrow a pending reconnect claim', async () => {
+  const f = fixture()
+  f.pool.set('conn:hub::other', { connectionPromise: f.entry.connectionPromise })
+  f.states.set('conn:hub::other', { ...f.state })
+  const first = f.service.target('hub', 'default')!
+  const second = f.service.target('hub', 'other')!
+  let finish!: () => void
+  f.terminate.mockImplementationOnce(() => new Promise<void>(resolve => { finish = resolve }))
+  const running = f.service.run(first)
+  await vi.waitFor(() => expect(f.terminate).toHaveBeenCalledOnce())
+  expect(await f.service.run(second)).toEqual({ ok: false })
+  expect(() => f.gate.assertCanDial('hub')).toThrow()
+  finish()
+  await running
+})
+
+test('a primary alias cannot acquire retirement authority', async () => {
+  const f = fixture()
+  f.state.primaryRegistryScope = true
+  expect(f.service.target('hub', 'default')).toBeNull()
+  expect(await f.service.run({ connectionId: 'hub', profile: 'default', generation: 'invented' })).toEqual({ ok: false })
+  expect(f.request).not.toHaveBeenCalled()
+  expect(f.terminate).not.toHaveBeenCalled()
+})
+
+test('busy backend releases the connection gate without tearing down its transport', async () => {
+  const f = fixture()
+  const target = f.service.target('hub', 'default')!
+  f.request.mockImplementation(async (_d, path) => path === '/api/ssh/ownership'
+    ? { ok: true, protocolVersion: 1, sshOwnerNonce: 'owned' } : { ok: false, idle: false })
+  expect(await f.service.run(target)).toEqual({ ok: false })
+  expect(f.terminate).not.toHaveBeenCalled()
+  expect(f.close).not.toHaveBeenCalled()
+  expect(f.gate.owner('hub')).toBeNull()
+})
+
+test('unsupported termination platform is refused before retirement', async () => {
+  const f = fixture()
+  const target = f.service.target('hub', 'default')!
+  f.state.remotePlatform = 'Darwin'
+  expect(await f.service.run(target)).toEqual({ ok: false })
+  expect(f.request).not.toHaveBeenCalled()
+  expect(f.terminate).not.toHaveBeenCalled()
+  expect(f.gate.owner('hub')).toBeNull()
+})
+
+test('descriptor replacement invalidates a previously discovered generation', async () => {
+  const f = fixture()
+  const target = f.service.target('hub', 'default')!
+  f.entry.connectionPromise = Promise.resolve({ baseUrl: 'http://replacement', token: 'replacement' })
+  expect(f.service.target('hub', 'default')!.generation).not.toBe(target.generation)
+  expect(await f.service.run(target)).toEqual({ ok: false })
+  expect(f.request).not.toHaveBeenCalled()
+  expect(f.terminate).not.toHaveBeenCalled()
+})
+
+test('transport cleanup failure after confirmed exit does not strand admission', async () => {
+  const f = fixture()
+  const target = f.service.target('hub', 'default')!
+  f.close.mockRejectedValueOnce(new Error('transport already closed'))
+  expect((await f.service.run(target)).ok).toBe(true)
+  expect(f.reopen).toHaveBeenCalledOnce()
+  expect(f.gate.owner('hub')).toBeNull()
+})
+
+test('ambiguous termination retains both gates and exact-generation retry can recover', async () => {
+  const f = fixture()
+  const target = f.service.target('hub', 'default')!
+  f.terminate.mockRejectedValueOnce(new Error('lost transport'))
+  await expect(f.service.run(target)).rejects.toThrow('lost transport')
+  expect(() => f.gate.assertCanDial('hub')).toThrow()
+  expect(() => f.service.assertCanStop('conn:hub::default')).toThrow()
+  expect(() => f.service.assertCanStop('default')).not.toThrow()
+  expect(f.close).not.toHaveBeenCalled()
+  expect((await f.service.run(target)).ok).toBe(true)
+  expect(f.gate.owner('hub')).toBeNull()
+})
diff --git a/apps/desktop/electron/registry-reconnect-service.ts b/apps/desktop/electron/registry-reconnect-service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fc1abfd8e5c05526d64ee8c7c29a796d05ad03f6
--- /dev/null
+++ b/apps/desktop/electron/registry-reconnect-service.ts
@@ -0,0 +1,153 @@
+import { randomUUID } from 'node:crypto'
+
+import type { ManagedConnectionUpdateGate } from './managed-ssh-update'
+import { createRegistryReconnector, type RegistryReconnectTarget } from './registry-reconnect'
+import { createRegistryRetirementClient } from './registry-retirement-http'
+
+interface PoolEntry<D> { connectionPromise: Promise<D> }
+interface OwnedState {
+  registryConnectionId: string
+  primaryRegistryScope?: boolean
+  spawnNonce: string
+  remotePlatform: string
+}
+interface ServiceDeps<D, E extends PoolEntry<D>, S extends OwnedState> {
+  pool: Map<string, E>
+  states: Map<string, S>
+  gate: ManagedConnectionUpdateGate
+  key: (connectionId: string, profile: string) => string
+  isSsh: (connectionId: string) => boolean
+  inFlight: (key: string) => boolean
+  request: Parameters<typeof createRegistryRetirementClient<D>>[0]
+  terminate: (state: S) => Promise<void>
+  close: (key: string, state: S) => Promise<void>
+  onCleanupError: (error: unknown) => void
+  reopen: (connectionId: string, profile: string, correlation: string) => Promise<unknown>
+}
+
+/** The connection gate fences registry edits and all bootstrap publications;
+ * the coordinator fences only this resident's teardown and uncertain retries.
+ */
+export function createRegistryReconnectService<D, E extends PoolEntry<D>, S extends OwnedState>(deps: ServiceDeps<D, E, S>) {
+  interface Resident { entry: E; state: S; descriptor: Promise<D>; generation: string; key: string }
+  const residents = new WeakMap<E, Resident>()
+  const correlations = new Map<string, string>()
+  const claimedProfiles = new Map<string, string>()
+  const client = createRegistryRetirementClient(deps.request)
+
+  function current(connectionId: string, profile: string): Resident | undefined {
+    const key = deps.key(connectionId, profile)
+    const entry = deps.pool.get(key)
+    const state = deps.states.get(key)
+
+    // POSIX owned termination deliberately refuses Darwin (no pidfd).
+    // Refuse here, before committing an irreversible backend admission fence.
+    if (!state || !['Linux', 'Windows'].includes(state.remotePlatform)) { return undefined }
+
+    if (!deps.isSsh(connectionId) || !entry || !state || state.primaryRegistryScope ||
+        state.registryConnectionId !== connectionId || !state.spawnNonce || deps.inFlight(key)) {
+      return undefined
+    }
+
+    let resident = residents.get(entry)
+
+    if (!resident || resident.state !== state || resident.descriptor !== entry.connectionPromise) {
+      resident = { entry, state, descriptor: entry.connectionPromise, key, generation: randomUUID() }
+      residents.set(entry, resident)
+    }
+
+    return resident
+  }
+
+  const coordinator = createRegistryReconnector<Resident>({
+    current,
+    generation: resident => resident.generation,
+    proveOwned: async resident => client.proveOwned(await resident.descriptor, resident.state.spawnNonce),
+    prepare: async resident => client.prepare(await resident.descriptor),
+    commit: async (resident, token) => client.commit(await resident.descriptor, token),
+    cancel: async (resident, token) => client.cancel(await resident.descriptor, token),
+    terminate: async resident => {
+      await deps.terminate(resident.state)
+
+      // Only remove the captured resident. Close is transport-only, never a
+      // generic teardown that could signal a replacement process.
+      if (deps.pool.get(resident.key) !== resident.entry || deps.states.get(resident.key) !== resident.state) {
+        throw new Error('Registry backend changed during termination')
+      }
+
+      deps.pool.delete(resident.key)
+      deps.states.delete(resident.key)
+
+      // Exit is already confirmed. A transport-only cleanup error cannot
+      // retain an uncertain-process fence after its resident was removed.
+      try {
+        await deps.close(resident.key, resident.state)
+      } catch (error) {
+        deps.onCleanupError(error)
+      }
+    },
+    reopen: async (connectionId, profile) => {
+      await deps.reopen(connectionId, profile, correlations.get(connectionId)!)
+      const replacement = current(connectionId, profile)
+
+      if (!replacement) { throw new Error('Registry backend reconnect did not publish an owned resident') }
+
+      return replacement.generation
+    }
+  })
+
+  return {
+    target: (connectionId: string, profile: string): RegistryReconnectTarget | null => {
+      const resident = current(connectionId, profile)
+
+      return resident ? { connectionId, profile, generation: resident.generation } : null
+    },
+    assertCanStop: (key: string) => {
+      const entry = deps.pool.get(key)
+      const resident = entry && residents.get(entry)
+
+      if (resident) {
+        // The key is opaque; retain the exact route instead of parsing ids.
+        for (const [connectionId] of correlations) {
+          if (resident.state.registryConnectionId === connectionId) {
+            throw new Error('Registry backend reconnect in progress')
+          }
+        }
+      }
+    },
+    run: async (target: RegistryReconnectTarget) => {
+      if (!target || typeof target.connectionId !== 'string' || typeof target.profile !== 'string' ||
+          typeof target.generation !== 'string') { return { ok: false } }
+
+      const resident = current(target.connectionId, target.profile)
+
+      if (!resident || resident.generation !== target.generation) { return { ok: false } }
+      const held = correlations.get(target.connectionId)
+
+      if (held && claimedProfiles.get(target.connectionId) !== target.profile) { return { ok: false } }
+      const correlation: string = held || randomUUID()
+
+      if (!held) {
+        if (!deps.gate.claim(target.connectionId, correlation)) { return { ok: false } }
+        correlations.set(target.connectionId, correlation)
+        claimedProfiles.set(target.connectionId, target.profile)
+      }
+
+      try {
+        return await coordinator.run(target)
+      } finally {
+        // A failed/unknown commit must not reopen normal admission. Only the
+        // exact-generation retry can reconcile it; never cancel on ambiguity.
+        let clear = false
+
+        try { coordinator.assertCanDial(target.connectionId, target.profile); clear = true } catch { /* fenced */ }
+
+        if (clear) {
+          correlations.delete(target.connectionId)
+          claimedProfiles.delete(target.connectionId)
+          deps.gate.release(target.connectionId, correlation)
+        }
+      }
+    }
+  }
+}
diff --git a/apps/desktop/electron/registry-reconnect.test.ts b/apps/desktop/electron/registry-reconnect.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d1f7304b155aebeceb3eb4b5d51c6726450c9e7e
--- /dev/null
+++ b/apps/desktop/electron/registry-reconnect.test.ts
@@ -0,0 +1,171 @@
+import { expect, test, vi } from 'vitest'
+
+import { createRegistryReconnector } from './registry-reconnect'
+
+function fixture() {
+  let entry = { generation: 'hub-1' }
+
+  const deps = {
+    current: vi.fn(() => entry),
+    generation: (value: typeof entry) => value.generation,
+    proveOwned: vi.fn(async () => true),
+    prepare: vi.fn(async (): Promise<string | null> => 'permit'),
+    commit: vi.fn(async () => true),
+    cancel: vi.fn(async () => {}),
+    terminate: vi.fn(async () => {}),
+    reopen: vi.fn(async () => 'hub-2')
+  }
+
+  return { deps, reconnect: createRegistryReconnector(deps), replace: () => { entry = { generation: 'hub-new' } } }
+}
+
+const target = { connectionId: 'hub', profile: 'default', generation: 'hub-1' }
+
+test.each([
+  { connectionId: '', profile: 'default', generation: 'hub-1' },
+  { connectionId: 'hub', profile: '', generation: 'hub-1' },
+  { connectionId: 'hub', profile: 'default', generation: '' },
+  { connectionId: ' hub', profile: 'default', generation: 'hub-1' }
+])('refuses incomplete or implicitly normalized target %j', async invalid => {
+  const { deps, reconnect } = fixture()
+  expect(await reconnect.run(invalid)).toEqual({ ok: false })
+  expect(deps.proveOwned).not.toHaveBeenCalled()
+  expect(deps.prepare).not.toHaveBeenCalled()
+})
+
+test.each(['busy', 'unowned', 'stale'] as const)('fails closed for %s without terminating', async refusal => {
+  const { deps, reconnect } = fixture()
+
+  if (refusal === 'busy') {deps.prepare.mockResolvedValue(null)}
+
+  if (refusal === 'unowned') {deps.proveOwned.mockResolvedValue(false)}
+  expect(await reconnect.run({ ...target, generation: refusal === 'stale' ? 'old' : target.generation })).toEqual({ ok: false })
+  expect(deps.terminate).not.toHaveBeenCalled()
+  expect(deps.reopen).not.toHaveBeenCalled()
+  expect(() => reconnect.assertCanDial('hub', 'default')).not.toThrow()
+})
+
+test('a refused commit cancels preparation and releases the local dial gate', async () => {
+  const { deps, reconnect } = fixture()
+  deps.commit.mockResolvedValue(false)
+  expect(await reconnect.run(target)).toEqual({ ok: false })
+  expect(deps.cancel).toHaveBeenCalledWith(expect.anything(), 'permit')
+  expect(deps.terminate).not.toHaveBeenCalled()
+  expect(() => reconnect.assertCanDial('hub', 'default')).not.toThrow()
+})
+
+test('termination failure retains the committed fence for an exact-generation retry', async () => {
+  const { deps, reconnect } = fixture()
+  deps.terminate.mockRejectedValueOnce(new Error('transport lost'))
+  await expect(reconnect.run(target)).rejects.toThrow('transport lost')
+  expect(deps.cancel).not.toHaveBeenCalled()
+  expect(deps.reopen).not.toHaveBeenCalled()
+  expect(() => reconnect.assertCanDial('hub', 'default')).toThrow('reconnect')
+  // The signal may have succeeded before its response was lost. Recovery
+  // must use exact SSH process identity, not the now-dead HTTP server.
+  deps.proveOwned.mockRejectedValue(new Error('serve already stopped'))
+  deps.prepare.mockRejectedValue(new Error('serve already stopped'))
+  expect(await reconnect.run(target)).toEqual({ ok: true, generation: 'hub-2' })
+})
+
+test('a replacement during prepare cancels only the old permit without committing or terminating', async () => {
+  const { deps, reconnect, replace } = fixture()
+  deps.prepare.mockImplementation(async () => { replace();
+
+ return 'permit' })
+  expect(await reconnect.run(target)).toEqual({ ok: false })
+  expect(deps.cancel).toHaveBeenCalledOnce()
+  expect(deps.commit).not.toHaveBeenCalled()
+  expect(deps.terminate).not.toHaveBeenCalled()
+})
+
+test('freezes same-scope dials and duplicate reconnects before the first async ownership probe', async () => {
+  const { deps, reconnect } = fixture()
+  let resolve!: (value: boolean) => void
+  deps.proveOwned.mockImplementation(() => new Promise<boolean>(done => { resolve = done }))
+  const first = reconnect.run(target)
+  expect(() => reconnect.assertCanDial('hub', 'default')).toThrow('reconnect')
+  expect(() => reconnect.assertCanDial('hub', 'reviewer')).not.toThrow()
+  expect(() => reconnect.assertCanDial('other', 'default')).not.toThrow()
+  expect(await reconnect.run(target)).toEqual({ ok: false })
+  resolve(false)
+  expect(await first).toEqual({ ok: false })
+  expect(() => reconnect.assertCanDial('hub', 'default')).not.toThrow()
+  expect(deps.terminate).not.toHaveBeenCalled()
+})
+
+test('an ambiguous commit keeps the scope fenced for retry, never cancelling a possibly committed permit', async () => {
+  const { deps, reconnect } = fixture()
+  deps.commit.mockRejectedValueOnce(new Error('response lost'))
+  await expect(reconnect.run(target)).rejects.toThrow('response lost')
+  expect(deps.cancel).not.toHaveBeenCalled()
+  expect(deps.terminate).not.toHaveBeenCalled()
+  expect(() => reconnect.assertCanDial('hub', 'default')).toThrow('reconnect')
+  expect(await reconnect.run(target)).toEqual({ ok: true, generation: 'hub-2' })
+  expect(() => reconnect.assertCanDial('hub', 'default')).not.toThrow()
+})
+
+test('an uncertain committed resident cannot grant retry authority over a replacement', async () => {
+  const { deps, reconnect, replace } = fixture()
+  deps.commit.mockRejectedValueOnce(new Error('response lost'))
+  await expect(reconnect.run(target)).rejects.toThrow('response lost')
+  replace()
+  expect(await reconnect.run({ ...target, generation: 'hub-new' })).toEqual({ ok: false })
+  expect(deps.prepare).toHaveBeenCalledOnce()
+  expect(deps.terminate).not.toHaveBeenCalled()
+  expect(() => reconnect.assertCanDial('hub', 'default')).toThrow('reconnect')
+})
+
+test('replacement during commit cannot terminate or reopen a newer resident', async () => {
+  const { deps, reconnect, replace } = fixture()
+  deps.commit.mockImplementation(async () => { replace();
+
+ return true })
+  expect(await reconnect.run(target)).toEqual({ ok: false })
+  expect(deps.terminate).not.toHaveBeenCalled()
+  expect(deps.reopen).not.toHaveBeenCalled()
+  expect(() => reconnect.assertCanDial('hub', 'default')).toThrow('reconnect')
+})
+
+test('replacement while termination is pending cannot be reopened by the old request', async () => {
+  const { deps, reconnect, replace } = fixture()
+  deps.terminate.mockImplementation(async () => { replace() })
+  expect(await reconnect.run(target)).toEqual({ ok: false })
+  expect(deps.reopen).not.toHaveBeenCalled()
+  expect(() => reconnect.assertCanDial('hub', 'default')).not.toThrow()
+})
+
+test('reconnects only the generation-qualified registry default, never the primary default', async () => {
+  const primary = { generation: 'primary' }
+  const target = { generation: 'hub-1' }
+  const other = { generation: 'other-1' }
+  const entries = new Map([['default', primary], ['conn:hub::default', target], ['conn:other::default', other]])
+  const prepare = vi.fn(async () => 'permit')
+  const cancel = vi.fn(async () => {})
+  const commit = vi.fn(async () => true)
+
+  const terminate = vi.fn(async (entry: typeof target) => {
+    expect(entry).toBe(target)
+  })
+
+  const reopen = vi.fn(async () => 'hub-2')
+
+  const reconnect = createRegistryReconnector({
+    current: (connectionId: string, profile: string) => entries.get(`conn:${connectionId}::${profile}`),
+    generation: (entry: typeof target) => entry.generation,
+    proveOwned: async () => true,
+    prepare, commit, cancel, terminate,
+    reopen
+  })
+
+  expect(await reconnect.run({ connectionId: 'hub', profile: 'default', generation: 'hub-1' })).toEqual({
+    ok: true, generation: 'hub-2'
+  })
+  expect(prepare).toHaveBeenCalledWith(target)
+  expect(commit).toHaveBeenCalledWith(target, 'permit')
+  expect(terminate).toHaveBeenCalledOnce()
+  expect(reopen).toHaveBeenCalledWith('hub', 'default', target)
+  expect(cancel).not.toHaveBeenCalled()
+  expect(entries.get('default')).toBe(primary)
+  expect(entries.get('conn:other::default')).toBe(other)
+})
diff --git a/apps/desktop/electron/registry-reconnect.ts b/apps/desktop/electron/registry-reconnect.ts
new file mode 100644
index 0000000000000000000000000000000000000000..635552c096035c5fee1049c81837f87c2dd9d070
--- /dev/null
+++ b/apps/desktop/electron/registry-reconnect.ts
@@ -0,0 +1,125 @@
+export interface RegistryReconnectTarget {
+  connectionId: string
+  profile: string
+  generation: string
+}
+
+export interface RegistryReconnectDeps<E> {
+  current: (connectionId: string, profile: string) => E | undefined
+  generation: (entry: E) => string
+  proveOwned: (entry: E) => Promise<boolean>
+  prepare: (entry: E) => Promise<string | null>
+  commit: (entry: E, token: string) => Promise<boolean>
+  cancel: (entry: E, token: string) => Promise<void>
+  terminate: (entry: E) => Promise<void>
+  reopen: (connectionId: string, profile: string, entry: E) => Promise<string>
+}
+
+export function createRegistryReconnector<E>(deps: RegistryReconnectDeps<E>) {
+  const active = new Set<string>()
+  const uncertain = new Map<string, E>()
+  const committed = new Map<string, E>()
+  const keyFor = (connectionId: string, profile: string) => JSON.stringify([connectionId, profile])
+
+  async function finish(target: RegistryReconnectTarget, key: string, entry: E) {
+    await deps.terminate(entry)
+    uncertain.delete(key)
+    committed.delete(key)
+
+    // Remote termination awaits I/O; never reopen over a newer resident.
+    const current = deps.current(target.connectionId, target.profile)
+
+    if (current && (current !== entry || deps.generation(current) !== target.generation)) {
+      return { ok: false }
+    }
+
+    return { ok: true, generation: await deps.reopen(target.connectionId, target.profile, entry) }
+  }
+
+  async function recycle(target: RegistryReconnectTarget) {
+    const key = keyFor(target.connectionId, target.profile)
+    const entry = deps.current(target.connectionId, target.profile)
+
+    if (uncertain.has(key) && uncertain.get(key) !== entry) {
+      return { ok: false }
+    }
+
+    if (!entry || deps.generation(entry) !== target.generation) {
+      return { ok: false }
+    }
+
+    // A confirmed commit survives serve exit. The terminator re-proves the
+    // exact SSH process identity or confirms that captured owner has exited.
+    if (committed.get(key) === entry) { return finish(target, key, entry) }
+
+    if (!(await deps.proveOwned(entry))) { return { ok: false } }
+
+    const token = await deps.prepare(entry)
+
+    if (!token) {
+      return { ok: false }
+    }
+
+    let mayBeCommitted = false
+
+    try {
+      if (deps.current(target.connectionId, target.profile) !== entry || deps.generation(entry) !== target.generation) {
+        return { ok: false }
+      }
+
+      mayBeCommitted = true
+      uncertain.set(key, entry)
+      const didCommit = await deps.commit(entry, token)
+
+      if (!didCommit) {
+        mayBeCommitted = false
+        uncertain.delete(key)
+
+        return { ok: false }
+      }
+
+      committed.set(key, entry)
+
+      if (deps.current(target.connectionId, target.profile) !== entry || deps.generation(entry) !== target.generation) {
+        return { ok: false }
+      }
+
+      return await finish(target, key, entry)
+    } finally {
+      if (!mayBeCommitted) {
+        await deps.cancel(entry, token)
+      }
+    }
+  }
+
+  return {
+    assertCanDial: (connectionId: string, profile: string) => {
+      const key = keyFor(connectionId, profile)
+
+      if (active.has(key) || uncertain.has(key)) {
+        throw new Error('Registry backend reconnect in progress')
+      }
+    },
+    run: async (target: RegistryReconnectTarget) => {
+      if (![target?.connectionId, target?.profile, target?.generation].every(value =>
+        typeof value === 'string' && value.length > 0 && value.trim() === value
+      )) {
+        return { ok: false }
+      }
+
+      const key = keyFor(target.connectionId, target.profile)
+
+      if (active.has(key)) {
+        return { ok: false }
+      }
+
+      active.add(key)
+
+      try {
+        return await recycle(target)
+      } finally {
+        active.delete(key)
+      }
+    }
+  }
+}
diff --git a/apps/desktop/electron/registry-retirement-http.test.ts b/apps/desktop/electron/registry-retirement-http.test.ts
