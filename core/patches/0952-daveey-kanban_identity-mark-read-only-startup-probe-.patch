From a83962fbccc3e80d8c87b76d1f0eaf31e844acad Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 03:08:40 -0700
Subject: [PATCH] [daveey] kanban_identity: mark read-only startup probe as
 lockguard-exempt (fixes lockguard test)

---
 hermes_cli/kanban_identity.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_identity.py b/hermes_cli/kanban_identity.py
index 447d1fc59a..93147b4f59 100644
--- a/hermes_cli/kanban_identity.py
+++ b/hermes_cli/kanban_identity.py
@@ -58,11 +58,11 @@ def _connect(db: Path) -> sqlite3.Connection:
     if not db.is_file():
         raise sqlite3.OperationalError(f"not a readable board: {db}")
     try:
-        conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=2)
+        conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=2)  # noqa: kanban-lockguard (read-only, short-lived startup probe)
         conn.execute("select 1 from sqlite_master limit 1")
         return conn
     except sqlite3.OperationalError:
-        conn = sqlite3.connect(f"file:{db}?mode=rw", uri=True, timeout=2)
+        conn = sqlite3.connect(f"file:{db}?mode=rw", uri=True, timeout=2)  # noqa: kanban-lockguard (query_only)
         conn.execute("PRAGMA query_only=ON")
         return conn
 
-- 
2.55.0

