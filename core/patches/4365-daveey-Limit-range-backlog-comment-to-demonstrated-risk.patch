From fd604b605981987416f9414fb338614e8d01785a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:54:22 +0000
Subject: [PATCH] [daveey] Limit range backlog comment to demonstrated risk

---
 tests/pm/_range_server.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/pm/_range_server.py b/tests/pm/_range_server.py
index c5091b0f7939c6f0fbb76ea20c73d57a4af3a2da..6b5e7689c7a4c3361e06339b56814762c289e38c 100644
--- a/tests/pm/_range_server.py
+++ b/tests/pm/_range_server.py
@@ -112,7 +112,7 @@ class RangeHandler(BaseHTTPRequestHandler):
 class RangeHTTPServer(ThreadingHTTPServer):
     # The downloader fans out eight connections before any need be accepted.
     # Threading handlers do not enlarge TCPServer's default backlog of five;
-    # a descheduled acceptor can otherwise overflow it on Darwin (EINVAL).
+    # a descheduled acceptor can otherwise overflow it and force SYN retries.
     request_queue_size = 16
 
 
