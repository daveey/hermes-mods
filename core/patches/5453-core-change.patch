From 4b9c5fc1686c3269642c06afab9146320f3acf4b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 08:25:19 +0000
Subject: [PATCH] [daveey] bind update marker incarnation to contended checkout
 record

Five whys: a live updater marker alone cannot name the holder of a separately contended checkout lock; the proof combined those observations without comparing their recorded incarnations. Read the bounded identity record from the very descriptor used for the kernel contention probe and require matching PID/birth plus a valid update timestamp. No lease or update-lock semantics change.

Proof: canonical RED: four mismatched/missing checkout identity cases fail while 48 prior cases pass; GREEN: all 52 cases pass. Final consumer and mutation runs follow on the frozen source; independent exact-head review and required CI remain mandatory.
---
 tests/tui_gateway/test_update_marker_defer.py | 16 ++++++++++++++++
 tui_gateway/update_marker_owner.py            |  4 +++-
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_update_marker_defer.py b/tests/tui_gateway/test_update_marker_defer.py
index ea367181f4..eae45ee672 100644
--- a/tests/tui_gateway/test_update_marker_defer.py
+++ b/tests/tui_gateway/test_update_marker_defer.py
@@ -209,6 +209,22 @@ def test_real_other_process_marker_update_defers(tmp_path, monkeypatch, admissio
         proc.communicate(timeout=10)
 
 
+@pytest.mark.parametrize("defect", ["pid", "birth", "legacy", "malformed"])
+def test_updater_must_match_held_checkout_record(custody, defect):
+    path = update_lock.checkout_lock_path(custody.install)
+    lines = path.read_text().splitlines()
+    if defect == "pid":
+        lines[0] = str(os.getpid() + 1)
+    elif defect == "birth":
+        lines[2] = f"ct:{active_sessions._own_start_time() + 1:.3f}"
+    elif defect == "legacy":
+        lines = lines[:2]
+    else:
+        lines[1] = "not a recorded update time"
+    path.write_text("\n".join(lines) + "\n")
+    assert custody.classify() is custody.refusal
+
+
 @pytest.mark.parametrize("reason", ["SESSION_COORDINATION_UNAVAILABLE", "SESSION_MOVED", None])
 def test_other_refusal_codes_do_not_probe_markers(custody, monkeypatch, reason):
     custody.refusal.reason = reason
diff --git a/tui_gateway/update_marker_owner.py b/tui_gateway/update_marker_owner.py
index 196060d666..b48f6d12c2 100644
--- a/tui_gateway/update_marker_owner.py
+++ b/tui_gateway/update_marker_owner.py
@@ -41,10 +41,12 @@ def classify_refusal(home, key, refusal, *, install_root=None):
             return refusal
         fd = os.open(update_lock.checkout_lock_path(root), os.O_RDONLY)
         try:
+            checkout = update_lock._parse_marker(os.read(fd, 4096))
             held = not update_lock._try_shared_lock(fd)
         finally:
             os.close(fd)
-        if not held:
+        if (not held or checkout.started_at is None or checkout.pid != update.pid
+                or checkout.create_time != update.create_time):
             return refusal
         # Revalidate the writer after the update probes (no stale PID classification).
         if marker_writer_state(marker) != "alive" or read_turn_marker(home, key) != marker:
