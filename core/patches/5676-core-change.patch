From a8434c76bc220d93a4221bfa0b66940beafa0111 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 00:53:14 +0000
Subject: [PATCH] fix(kanban): separate install store owner from courier
 identity [daveey]

---
 hermes_cli/kanban_card_answer_source.py       | 11 ++++++++--
 .../test_card_answer_courier_integration.py   |  6 ++++--
 .../test_kanban_card_answer_source.py         | 20 ++++++++++++++++---
 3 files changed, 30 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban_card_answer_source.py b/hermes_cli/kanban_card_answer_source.py
index 5e289646b7..3efac1d6a3 100644
--- a/hermes_cli/kanban_card_answer_source.py
+++ b/hermes_cli/kanban_card_answer_source.py
@@ -38,7 +38,14 @@ def _recorded(path: Path, *, source: dict, owner_gateway: str, request_id: str,
     coordinates), and choiceValues (request choice ID -> exact owner choice).
     The ordinary projection row and immutable frozen request still apply.
     """
-    ns = json.dumps([source['gateway'], source['profile']], separators=(',', ':'), ensure_ascii=False)
+    # Courier authentication already bound source.gateway in runtime.source.
+    # ActionStore is instead owned by this install, shared across its profiles.
+    from hermes_cli.install_identity import get_install_id
+    install_id = get_install_id()
+    if not install_id:
+        raise AnswerRefused('source_install_identity_unavailable')
+    store_gateway = 'install:' + install_id
+    ns = json.dumps([store_gateway, source['profile']], separators=(',', ':'), ensure_ascii=False)
     # User-steps ActionStore, not a Kanban board; this adapter never opens board files.
     conn = sqlite3.connect(path.resolve().as_uri() + '?mode=ro', uri=True)  # noqa: kanban-lockguard
     conn.row_factory = sqlite3.Row
@@ -49,7 +56,7 @@ def _recorded(path: Path, *, source: dict, owner_gateway: str, request_id: str,
         if row is None:
             raise AnswerRefused('source_operation_missing')
         op = json.loads(row['body'])
-        expected_owner = dict(gatewayId=source['gateway'], profile=source['profile'], storedSessionId=source['session'])
+        expected_owner = dict(gatewayId=store_gateway, profile=source['profile'], storedSessionId=source['session'])
         if (op.get('owner') != expected_owner or op.get('operationId') != answer['operationId']
                 or op.get('dispatchState') == 'cancelled' or not op.get('recordedAt')):
             raise AnswerRefused('source_operation_mismatch')
diff --git a/tests/hermes_cli/test_card_answer_courier_integration.py b/tests/hermes_cli/test_card_answer_courier_integration.py
index 57c86dd834..9fe782f2a5 100644
--- a/tests/hermes_cli/test_card_answer_courier_integration.py
+++ b/tests/hermes_cli/test_card_answer_courier_integration.py
@@ -123,6 +123,8 @@ class World:
             p.setenv("HERMES_HOME", str(home))
             p.setenv("HERMES_HUB_STATE", str(home / "courier"))
             p.setenv("HERMES_MAIL_CONFIG", str(home / "mail.json"))
+            from hermes_cli import install_identity
+            p.setattr(install_identity, 'get_install_id', lambda: name + '-install')
             p.setattr(runtime, "Records", Records)
             p.setattr(runtime, "_profile", lambda: (profile, home))  # OS identity/root seam
             p.setattr(self.courier, "_home_for", lambda prof: home if prof == profile else None)
@@ -178,12 +180,12 @@ def record_operation(home, answer, source=SRC, op_id=None):
     path = home / "user-steps/actions.sqlite3"
     path.parent.mkdir(exist_ok=True)
     # Protocol-shaped fixture only; M2 separately exercises the real ActionStore producer.
-    ns = json.dumps([source["gateway"], source["profile"]], separators=(",", ":"))
+    ns = json.dumps(['install:source-install', source["profile"]], separators=(",", ":"))
     label = {"plan-a": "Apply plan A", "plan-b": "Apply plan B"}[answer["choice"]]
     cid = "a" if answer["choice"] == "plan-a" else "b"
     req = dict(requestId="request-one", revision=1, choices=[dict(id="a", effect="answer", label="Apply plan A"),
                                                             dict(id="b", effect="answer", label="Apply plan B")])
-    op = dict(owner=dict(gatewayId=source["gateway"], profile=source["profile"], storedSessionId=source["session"]),
+    op = dict(owner=dict(gatewayId='install:source-install', profile=source["profile"], storedSessionId=source["session"]),
               operationId=answer["operationId"], recordedAt="2026-01-01T00:00:00+00:00", requestId="request-one",
               revision=1, dispatchState="pending",
               decision=dict(requestId="request-one", expectedRevision=1, choiceId=cid),
diff --git a/tests/hermes_cli/test_kanban_card_answer_source.py b/tests/hermes_cli/test_kanban_card_answer_source.py
index e90ffcd612..145cccec3d 100644
--- a/tests/hermes_cli/test_kanban_card_answer_source.py
+++ b/tests/hermes_cli/test_kanban_card_answer_source.py
@@ -13,7 +13,11 @@ def fixture(tmp_path):
     answer = dict(ownerGateway='owner', ownerProfile='default', board='default', task='t_example',
                   generation='a' * 64, choice='plan-a', operationId='operation-one')
     origin = dict(gateway='origin', profile='work', session='chat-one')
-    owner = dict(gatewayId='origin', profile='work', storedSessionId='chat-one')
+    from hermes_cli.install_identity import get_install_id
+    install_id = get_install_id()
+    assert install_id
+    install_owner = 'install:' + install_id
+    owner = dict(gatewayId=install_owner, profile='work', storedSessionId='chat-one')
     request = dict(requestId='request-one', revision=1, choices=[dict(id='a', effect='answer', label='Apply A')])
     op = dict(owner=owner, operationId='operation-one', recordedAt='2026-01-01T00:00:00+00:00',
               requestId='request-one', revision=1, dispatchState='pending',
@@ -22,7 +26,7 @@ def fixture(tmp_path):
                           executionAuthorized=False, permissionGrants=[]))
     remote = dict(version=1, target={k: v for k, v in answer.items() if k not in ('choice', 'operationId')},
                   choiceValues={'a': 'plan-a'})
-    ns = json.dumps(['origin', 'work'], separators=(',', ':'))
+    ns = json.dumps([install_owner, 'work'], separators=(',', ':'))
     with sqlite3.connect(path) as conn:
         conn.execute('CREATE TABLE operations(namespace TEXT,session TEXT,id TEXT,body TEXT)')
         conn.execute('CREATE TABLE kanban_projections(namespace TEXT,session TEXT,request_id TEXT,board TEXT,task TEXT,snapshot TEXT,request TEXT)')
@@ -46,7 +50,7 @@ def test_exact_operation_and_binding_read_only(tmp_path):
     assert not (tmp_path / 'actions.sqlite3-shm').exists()
 
 
-@pytest.mark.parametrize('field', ['gateway', 'profile', 'session'])
+@pytest.mark.parametrize('field', ['profile', 'session'])
 def test_no_cross_namespace_search(tmp_path, field):
     path, answer, origin, _, _ = fixture(tmp_path)
     origin[field] = 'another'
@@ -94,6 +98,16 @@ def test_unbound_operation_is_not_authority(tmp_path):
         read(path, answer, origin)
 
 
+@pytest.mark.parametrize('install_id,code', [(None, 'source_install_identity_unavailable'),
+                                            ('another-install', 'source_operation_missing')])
+def test_local_install_identity_is_required(tmp_path, monkeypatch, install_id, code):
+    from hermes_cli import install_identity
+    path, answer, origin, _, _ = fixture(tmp_path)
+    monkeypatch.setattr(install_identity, 'get_install_id', lambda: install_id)
+    with pytest.raises(ca.AnswerRefused, match=code):
+        read(path, answer, origin)
+
+
 def test_missing_store_never_created(tmp_path):
     path = tmp_path / 'missing.sqlite3'
     with pytest.raises(ca.AnswerRefused, match='source_store_unavailable'):
-- 
