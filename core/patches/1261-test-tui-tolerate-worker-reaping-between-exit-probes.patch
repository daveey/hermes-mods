From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 07:06:16 -0700
Subject: [PATCH] test(tui): tolerate worker reaping between exit probes
 [daveey] (#308)

---
 tests/tui_gateway/test_slash_worker_owned.py | 39 +++++++++++++++++++-
 1 file changed, 38 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_slash_worker_owned.py b/tests/tui_gateway/test_slash_worker_owned.py
index a39c57128a3..5c732f1da48 100644
--- a/tests/tui_gateway/test_slash_worker_owned.py
+++ b/tests/tui_gateway/test_slash_worker_owned.py
@@ -19,6 +19,7 @@ import signal
 import subprocess
 import sys
 from pathlib import Path
+from unittest.mock import Mock
 
 import psutil
 import pytest
@@ -261,6 +262,42 @@ sys.stdin.read()
 '''
 
 
+def _worker_exited(worker: psutil.Process) -> bool:
+    try:
+        return not worker.is_running() or worker.status() == psutil.STATUS_ZOMBIE
+    except psutil.NoSuchProcess:
+        # The orphan can be reaped between is_running() and status(): that is success, too.
+        return True
+
+
+@pytest.mark.parametrize(("running", "status", "expected"), [
+    (False, None, True),
+    (True, psutil.STATUS_SLEEPING, False),
+    (True, psutil.STATUS_ZOMBIE, True),
+    (True, psutil.NoSuchProcess(424242), True),
+])
+def test_worker_exit_probe_handles_reaping_between_observations(running, status, expected):
+    worker = Mock(spec=psutil.Process)
+    worker.is_running.return_value = running
+    if isinstance(status, Exception):
+        worker.status.side_effect = status
+    else:
+        worker.status.return_value = status
+
+    assert _worker_exited(worker) is expected
+    if not running:
+        worker.status.assert_not_called()
+
+
+def test_worker_exit_probe_does_not_mistake_access_denied_for_exit():
+    worker = Mock(spec=psutil.Process)
+    worker.is_running.return_value = True
+    worker.status.side_effect = psutil.AccessDenied(424242)
+
+    with pytest.raises(psutil.AccessDenied):
+        _worker_exited(worker)
+
+
 @pytest.mark.platforms("posix")
 @pytest.mark.live_system_guard_bypass  # the worker reparents to init once its legacy owner dies
 def test_a_worker_launched_by_a_pre_update_gateway_still_dies_with_it(tmp_path):
@@ -275,7 +312,7 @@ def test_a_worker_launched_by_a_pre_update_gateway_still_dies_with_it(tmp_path):
         worker = psutil.Process(int(owner.stdout.readline()))
         owner.kill()
         owner.wait(timeout=10)
-        wait_until(lambda: not worker.is_running() or worker.status() == psutil.STATUS_ZOMBIE, timeout=30,
+        wait_until(lambda: _worker_exited(worker), timeout=30,
                    what="the legacy-launched worker to exit after its parent's kill -9")
     finally:
         os.close(w)
