From 4c42be25cc1d6f4762387ff6f905c901e346d32e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 18:38:14 +0000
Subject: [PATCH] [daveey] fix(auth): the Codex service-tier lookup refuses a
 passed-in disabled token too

Review of d32ee8296c1 (t_01a1cbba812bcee0): _account_catalog_token checked token_disabled only for the
stored-login fallback, so codex_account_offers_tier(..., access_token=<disabled JWT>) read the catalog
with it. The check now covers both.

Proof: new test RED with the fix reverted, GREEN with it (36 in test_credential_pool_disabled_paths).
---
 agent/codex_service_tiers.py                       |  6 +++---
 tests/agent/test_credential_pool_disabled_paths.py | 13 +++++++++++++
 2 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/agent/codex_service_tiers.py b/agent/codex_service_tiers.py
index 39c96771b3e..5f40ab9a6e4 100644
--- a/agent/codex_service_tiers.py
+++ b/agent/codex_service_tiers.py
@@ -99,9 +99,9 @@ def _account_catalog_token(access_token: Any) -> str | None:
             token = resolve_codex_runtime_credentials(read_only=True).get("api_key")
         except AuthError:  # no Codex login on this profile: unknown, never a refusal
             return None
-        from agent.credential_pool_disabled import token_disabled
-        if token_disabled("openai-codex", token):  # disabled account: its catalog is unknown, not read
-            return None
+    from agent.credential_pool_disabled import token_disabled
+    if token_disabled("openai-codex", token):  # disabled account, passed in or stored: catalog unknown, not read
+        return None
     return token if isinstance(token, str) and token else None
 
 
diff --git a/tests/agent/test_credential_pool_disabled_paths.py b/tests/agent/test_credential_pool_disabled_paths.py
index dbf96386d4e..4661e7b98fb 100644
--- a/tests/agent/test_credential_pool_disabled_paths.py
+++ b/tests/agent/test_credential_pool_disabled_paths.py
@@ -472,3 +472,16 @@ def test_an_env_var_source_is_not_disabled_as_a_slot(monkeypatch):
                                     "src": cpd._borrowed_source(row)}])
     other = SimpleNamespace(id="e0", label="anthropic_token", source="env:ANTHROPIC_TOKEN", access_token="fixture-env-2")
     assert cpd.matches(row, keys) and not cpd.matches(other, keys)
+
+
+def test_codex_service_tier_lookup_never_sends_a_passed_in_disabled_token(monkeypatch, _no_codex_env):
+    from agent import codex_service_tiers as cst
+    from agent import model_metadata_http
+    from agent.credential_pool import PooledCredential
+    (a,) = _codex_rows("a")
+    _disable("openai-codex", PooledCredential.from_dict("openai-codex", a))
+    sent = []
+    monkeypatch.setattr(model_metadata_http, "get", lambda *args, **kw: sent.append(kw) or None, raising=False)
+    assert cst._account_catalog_token(a["access_token"]) is None
+    cst.codex_account_offers_tier("gpt-5", "priority", access_token=a["access_token"])
+    assert not any(a["access_token"] in json.dumps(k, default=str) for k in sent)
-- 
2.55.0

