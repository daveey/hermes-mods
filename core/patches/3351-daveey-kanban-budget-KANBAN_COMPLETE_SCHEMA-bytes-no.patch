From aefd35f812420e6ad8f276a20550190ccdf763d4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 09:56:51 +0000
Subject: [PATCH] [daveey] kanban: budget KANBAN_COMPLETE_SCHEMA bytes, not
 TEXT_PATTERN length; correct the $ref cost note (PR #2055 review nits 2,3)

- tests: replace the len(TEXT_PATTERN) <= 115 change-detector with a byte budget on
  json.dumps(KANBAN_COMPLETE_SCHEMA) (10878 at PR #2055; budget 11000), with the reason in
  the assert message.
- hermes_completion_receipt: the cost note said Google rejects reference indirection.
  prepare_gemini_tool_parameters inlines same-document $ref on the parametersJsonSchema
  path; only the legacy parameters translator (sanitize_gemini_schema) drops $ref. Decision
  unchanged: the pattern stays inline.
---
 hermes_completion_receipt.py                       |  5 +++--
 tests/tools/test_kanban_complete_receipt_schema.py | 13 ++++++++++---
 2 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/hermes_completion_receipt.py b/hermes_completion_receipt.py
index 33f95a962a..19bb61e132 100644
--- a/hermes_completion_receipt.py
+++ b/hermes_completion_receipt.py
@@ -30,8 +30,9 @@ OPERATOR_DELIVERY_TEXT_MAX = 128
 # character classes and \x/\u escapes only, valid in Python re, ECMA-262 and llama.cpp's grammar converter.
 # Cost: the schema repeats it on 15 fields (~2.3 KB of KANBAN_COMPLETE_SCHEMA, sent on every worker request), so
 # keep it short: the nonblank class folds _CONTROL, tab, newline and space into one \x00-\x20 range. A shared
-# `$defs` + `$ref` would send it once, but Gemini's legacy `parameters` translator drops `$ref` (the field loses
-# its type) and Google rejects reference indirection, so every field carries the pattern inline.
+# `$defs` + `$ref` would send it once, but only the `parametersJsonSchema` path keeps it (agent/gemini_schema's
+# prepare_gemini_tool_parameters inlines same-document `$ref` there); the legacy `parameters` translator
+# (sanitize_gemini_schema) drops `$ref`, so the field loses its type. Every field carries the pattern inline.
 _CONTROL = "\\x00-\\x08\\x0b-\\x1f"
 _SPACE = "\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000"  # isspace() above \x20
 TEXT_PATTERN = f"^[^{_CONTROL}]*[^\\x00-\\x20{_SPACE}][^{_CONTROL}]*$"
diff --git a/tests/tools/test_kanban_complete_receipt_schema.py b/tests/tools/test_kanban_complete_receipt_schema.py
index e5e0e68cbb..570a18fed1 100644
--- a/tests/tools/test_kanban_complete_receipt_schema.py
+++ b/tests/tools/test_kanban_complete_receipt_schema.py
@@ -164,14 +164,21 @@ def test_text_fields_advertise_the_writers_nonblank_no_control_rule():
             "^[0-9a-f]{64}$" if path == "operator_delivery.content_sha256" else hcr.TEXT_PATTERN), path
 
 
+def test_kanban_complete_schema_stays_within_its_byte_budget():
+    # KANBAN_COMPLETE_SCHEMA goes out on every worker request, and completion_receipt repeats TEXT_PATTERN on 15
+    # fields (the cost note at TEXT_PATTERN). Budget the whole serialized schema, not the pattern's length, so
+    # growth anywhere is a decision: 10878 bytes at PR #2055, small headroom on top.
+    size = len(json.dumps(KANBAN_COMPLETE_SCHEMA).encode())
+    assert size <= 11000, (
+        f"KANBAN_COMPLETE_SCHEMA is {size} bytes, over its 11000-byte budget: every worker request carries it. "
+        "Trim it, or raise the budget deliberately and say why.")
+
+
 def test_text_pattern_is_exactly_the_writers_text_rule():
     # _text reads the same constant; prove it still means "no C0 control but tab/newline, not all str.isspace()"
     # for every BMP character, alone and padded, so the advertised pattern is the writer's real rule.
     import re
 
-    # PR #2031 review nit: the schema repeats the pattern on 15 fields of every worker request (the cost note at
-    # TEXT_PATTERN); the nonblank class folds control, tab, newline and space into one range. Don't regrow it.
-    assert len(hcr.TEXT_PATTERN) <= 115, len(hcr.TEXT_PATTERN)
     rule = re.compile(hcr.TEXT_PATTERN)
     for code in range(0x10000):
         c = chr(code)
-- 
