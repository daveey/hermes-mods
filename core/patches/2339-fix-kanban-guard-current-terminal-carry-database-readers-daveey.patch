From 6f988647c42c5524640461aed034decec19d8236 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:21:15 +0000
Subject: [PATCH] fix(kanban): guard current terminal carry database readers
 [daveey]

---
 hermes_cli/kanban_terminal_carry.py           | 10 ++++++--
 .../hermes_cli/test_kanban_terminal_carry.py  | 24 +++++++++++++++++++
 2 files changed, 32 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_terminal_carry.py b/hermes_cli/kanban_terminal_carry.py
index 79edd83eeb8..4b29289801c 100644
--- a/hermes_cli/kanban_terminal_carry.py
+++ b/hermes_cli/kanban_terminal_carry.py
@@ -36,8 +36,14 @@ def _identity(card: dict) -> dict:
 
 
 def _ro(path: Path, *, immutable: bool = False):
-    conn = sqlite3.connect(path.resolve().as_uri() + ('?mode=ro&immutable=1' if immutable else '?mode=ro'),
-                           uri=True, timeout=0.5)
+    from hermes_cli import kanban_lockguard
+
+    uri = path.resolve().as_uri()
+    if immutable:
+        # Offline hash-pinned evidence has no live WAL generation to guard/recover.
+        conn = sqlite3.connect(uri + '?mode=ro&immutable=1', uri=True, timeout=0.5)  # noqa: kanban-lockguard
+    else:
+        conn = kanban_lockguard.connect(uri + '?mode=ro', uri=True, timeout=0.5)
     conn.row_factory = sqlite3.Row
     conn.execute('PRAGMA query_only=ON')
     conn.execute('BEGIN')
diff --git a/tests/hermes_cli/test_kanban_terminal_carry.py b/tests/hermes_cli/test_kanban_terminal_carry.py
index 2e04d3dc206..8f40fc0fe93 100644
--- a/tests/hermes_cli/test_kanban_terminal_carry.py
+++ b/tests/hermes_cli/test_kanban_terminal_carry.py
@@ -10,6 +10,30 @@ import pytest
 from hermes_cli import kanban_terminal_carry as carry
 
 
+def test_readers_guard_current_databases_but_not_immutable_evidence(tmp_path, monkeypatch):
+    from hermes_cli import kanban_lockguard
+
+    path = tmp_path / 'readers.db'
+    with sqlite3.connect(path) as conn:
+        conn.execute('CREATE TABLE evidence(value TEXT)')
+    calls = []
+    original = kanban_lockguard.connect
+
+    def guarded(database, **kwargs):
+        calls.append(database)
+        return original(database, **kwargs)
+
+    monkeypatch.setattr(kanban_lockguard, 'connect', guarded)
+    for immutable in (False, True):
+        conn = carry._ro(path, immutable=immutable)
+        try:
+            assert conn.execute('PRAGMA query_only').fetchone()[0] == 1
+            assert conn.execute('SELECT count(*) FROM evidence').fetchone()[0] == 0
+        finally:
+            conn.close()
+    assert calls == [path.resolve().as_uri() + '?mode=ro']
+
+
 def digest(path):
     return hashlib.sha256(path.read_bytes()).hexdigest()
 
-- 
