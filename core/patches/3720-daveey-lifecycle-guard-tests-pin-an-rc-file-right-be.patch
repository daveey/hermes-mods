From 1b966bce19bc14208da7cda20b89c27370c337c6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 18:02:45 +0000
Subject: [PATCH] [daveey] lifecycle guard tests: pin an rc file right before
 the script operand and a trailing value-less --rcfile

Test-only. Two clauses of the rc-file loop in `_references_at` (#2388,
`for arg_index in range(min(operand_index, len(arguments)) - 1):`) had no
test, and both mutants survived all 18 lifecycle_guard test files (1105
passed under each, same as baseline; post-merge check t_01a1d5f0a8589561):

- M7 `- 1` -> `- 2`: the loop stops one token early and fails OPEN for an
  rc file that sits right before the script operand or `-c`
  (`bash --rcfile R clean.sh`, `bash --init-file R -c 'echo hi'`). The
  existing rows only put `-i` after the rc file.
- M8 drops the `len` clamp: a trailing value-less `--rcfile` raises
  IndexError, the walk falls back to the direct scan, and that fails open
  (`bash --rcfile R --rcfile`). The existing `bash --rcfile` row expects
  False, so it passed either way.

New rows in tests/cron/test_lifecycle_guard_interpreter_runners.py:
- refused `(True, None)`, at the end of the
  test_shell_specific_option_values_find_the_script list:
  `bash --rcfile {sh} {clean_sh}`, `bash --init-file {sh} -c 'echo hi'`,
  `bash --rcfile {sh} --rcfile`;
- test_trailing_valueless_rcfile_does_not_fail_the_walk: `bash --rcfile`
  and `bash -O extglob --rcfile` stay (False, None) and log no
  "referenced-script walk failed" record (caplog).

Proof (worker-3, this file):
- main: 77 passed; all 18 lifecycle_guard test files 1113 passed (1105 + 8).
- M7 alone: 2 failed (the --rcfile-before-operand and --init-file -c rows).
- M8 alone: 3 failed (the trailing --rcfile refused row and both caplog rows).
- scripts/check --base origin/main: 19 checks ok.
---
 .../test_lifecycle_guard_interpreter_runners.py    | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/tests/cron/test_lifecycle_guard_interpreter_runners.py b/tests/cron/test_lifecycle_guard_interpreter_runners.py
index b36a21ba06..84261d59fc 100644
--- a/tests/cron/test_lifecycle_guard_interpreter_runners.py
+++ b/tests/cron/test_lifecycle_guard_interpreter_runners.py
@@ -132,6 +132,11 @@ def test_mentions_and_data_stay_allowed(files, template):
         "zsh -o errexit {sh}",
         "zsh -eo errexit {sh}",
         "bash -eO extglob {sh}",
+        # An rc file right before the script operand or `-c`, and one before a trailing
+        # value-less `--rcfile`, is still sourced, so still scanned (PR #2388 mutants).
+        "bash --rcfile {sh} {clean_sh}",
+        "bash --init-file {sh} -c 'echo hi'",
+        "bash --rcfile {sh} --rcfile",
     ],
 )
 def test_shell_specific_option_values_find_the_script(files, template):
@@ -211,3 +216,12 @@ def test_data_sink_piped_into_python_is_not_masked(files):
         True, None)
     assert scan_gateway_lifecycle(f"grep -h '{LIFECYCLE}' {files['py']} | wc -l") == (False, None)
     assert scan_gateway_lifecycle(f"grep -h '{LIFECYCLE}' {files['py']} | pyright") == (False, None)
+
+
+@pytest.mark.parametrize("command", ["bash --rcfile", "bash -O extglob --rcfile"])
+def test_trailing_valueless_rcfile_does_not_fail_the_walk(caplog, command):
+    """A value-taking option last on the line is walked, not crashed on: the fallback after a
+    failed walk is the direct scan, which fails open on a sourced rc file (PR #2388 mutant)."""
+    with caplog.at_level("WARNING", logger=lifecycle_guard.logger.name):
+        assert scan_gateway_lifecycle(command) == (False, None)
+    assert not [r for r in caplog.records if "referenced-script walk failed" in r.getMessage()]
-- 
