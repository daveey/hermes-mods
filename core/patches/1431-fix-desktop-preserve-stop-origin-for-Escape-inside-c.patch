From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 04:40:41 -0700
Subject: [PATCH] fix(desktop): preserve stop origin for Escape inside composer
 [daveey]

---
 .../chat/composer/editor-esc-origin.test.tsx  | 68 +++++++++++++++++++
 apps/desktop/src/app/chat/composer/index.tsx  |  2 +-
 2 files changed, 69 insertions(+), 1 deletion(-)
 create mode 100644 apps/desktop/src/app/chat/composer/editor-esc-origin.test.tsx

diff --git a/apps/desktop/src/app/chat/composer/editor-esc-origin.test.tsx b/apps/desktop/src/app/chat/composer/editor-esc-origin.test.tsx
new file mode 100644
index 00000000000..b29b19d47fe
--- /dev/null
+++ b/apps/desktop/src/app/chat/composer/editor-esc-origin.test.tsx
@@ -0,0 +1,68 @@
+// @vitest-environment jsdom
+import { AssistantRuntimeProvider, useExternalStoreRuntime } from '@assistant-ui/react'
+import type { ThreadMessageLike } from '@assistant-ui/react'
+import { act, cleanup, fireEvent, render } from '@testing-library/react'
+import { MemoryRouter } from 'react-router'
+import { afterEach, expect, it, vi } from 'vitest'
+
+import { I18nProvider } from '@/i18n'
+import { mainComposerScope } from '@/store/composer'
+
+import { RICH_INPUT_SLOT } from './rich-editor'
+import type { ChatBarProps, ChatBarState } from './types'
+
+import { ChatBar } from './index'
+
+const state: ChatBarState = {
+  model: { canSwitch: false, model: '', provider: '' },
+  tools: { enabled: false, label: '' },
+  voice: { enabled: false, active: false }
+}
+
+function Harness({ busy, onCancel }: Pick<ChatBarProps, 'busy' | 'onCancel'>) {
+  const runtime = useExternalStoreRuntime({
+    convertMessage: (message: ThreadMessageLike) => message,
+    isRunning: busy,
+    messages: [] as ThreadMessageLike[],
+    onNew: async () => {}
+  })
+
+  return (
+    <AssistantRuntimeProvider runtime={runtime}>
+      <MemoryRouter>
+        <I18nProvider configClient={null} initialLocale="en">
+          <ChatBar busy={busy} disabled={false} gateway={null} onCancel={onCancel} onSubmit={() => true} state={state} />
+        </I18nProvider>
+      </MemoryRouter>
+    </AssistantRuntimeProvider>
+  )
+}
+
+afterEach(() => {
+  cleanup()
+  mainComposerScope.clear()
+})
+
+it('Escape inside the real composer editor forwards the esc origin exactly once', async () => {
+  const onCancel = vi.fn()
+  const { container } = render(<Harness busy onCancel={onCancel} />)
+  const editor = container.querySelector<HTMLElement>(`[data-slot="${RICH_INPUT_SLOT}"]`)!
+  editor.tabIndex = 0
+  await act(async () => {
+    editor.focus()
+    fireEvent.keyDown(editor, { key: 'Escape', code: 'Escape' })
+  })
+  expect(onCancel).toHaveBeenCalledExactlyOnceWith('esc')
+})
+
+it('Escape inside an idle composer does not cancel a turn', async () => {
+  const onCancel = vi.fn()
+  const { container } = render(<Harness busy={false} onCancel={onCancel} />)
+  const editor = container.querySelector<HTMLElement>(`[data-slot="${RICH_INPUT_SLOT}"]`)!
+  editor.tabIndex = 0
+  await act(async () => {
+    editor.focus()
+    fireEvent.keyDown(editor, { key: 'Escape', code: 'Escape' })
+  })
+  expect(onCancel).not.toHaveBeenCalled()
+})
diff --git a/apps/desktop/src/app/chat/composer/index.tsx b/apps/desktop/src/app/chat/composer/index.tsx
index dc0d2f214b3..b3ac609d388 100644
--- a/apps/desktop/src/app/chat/composer/index.tsx
+++ b/apps/desktop/src/app/chat/composer/index.tsx
@@ -1052,7 +1052,7 @@ export function ChatBar({
       if (busy && !awaitingInput) {
         event.preventDefault()
         triggerHaptic('cancel')
-        void Promise.resolve(haltRun())
+        void Promise.resolve(haltRun('esc'))
       }
     }
   }
