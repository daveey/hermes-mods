From f29ad1b71d2b905b13af2d3f9f4cca50fa744bb8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 09:55:13 +0000
Subject: [PATCH] [daveey] launch_profile_policy: profile_config_scope reuses
 launch_terminal_env(); drop stale "frozen" overlay wording

Follow-up to PR #2050 review nits 1-2 (t_01a1d4441916446d).

- profile_config_scope's bound-scope branch inlined the same TERMINAL_*
  filter over _launch_env() that launch_terminal_env() returns; call it.
  Pure refactor, no behaviour change.
- The _bind_whole_profile docstring and kanban_capabilities._profile_policy
  comment called the launch TERMINAL_* overlay "frozen"; since #2050 it is
  frozen once multiplexing is active, the live env before.
---
 agent/runtime_scope.py               | 7 ++++---
 hermes_cli/kanban_capabilities.py    | 9 +++++----
 tui_gateway/launch_profile_policy.py | 4 ++--
 3 files changed, 11 insertions(+), 9 deletions(-)

diff --git a/agent/runtime_scope.py b/agent/runtime_scope.py
index 475c69a9f7..f823353c43 100644
--- a/agent/runtime_scope.py
+++ b/agent/runtime_scope.py
@@ -150,9 +150,10 @@ def _bind_whole_profile(
     env_overlay: Optional[dict[str, str]] = None, defer_terminal: bool = False,
 ) -> StateToken:
     """Home, secrets and terminal policy for local *scope*, together. The process's own home keeps
-    its launch semantics (environment over ``.env``, the frozen launch ``TERMINAL_*`` overlay,
-    unstamped), so systemd / ``op run`` injection still resolves; any other home gets its own
-    ``.env`` and sources only, stamped as routed. A caller's *env_overlay* replaces the default."""
+    its launch semantics (environment over ``.env``, the launch ``TERMINAL_*`` overlay: frozen once
+    multiplexing is active, the live env before; unstamped), so systemd / ``op run`` injection
+    still resolves; any other home gets its own ``.env`` and sources only, stamped as routed. A
+    caller's *env_overlay* replaces the default."""
     from agent.secret_scope import _is_process_home
     if _is_process_home(Path(scope.agent)):  # the pinned launch identity, not a mirrored HERMES_HOME
         from tui_gateway.launch_profile_policy import launch_secret_scope, launch_terminal_env
diff --git a/hermes_cli/kanban_capabilities.py b/hermes_cli/kanban_capabilities.py
index 32bb1c9230..65567ccd36 100644
--- a/hermes_cli/kanban_capabilities.py
+++ b/hermes_cli/kanban_capabilities.py
@@ -308,10 +308,11 @@ def _profile_policy(assignee: str):
     # shared loader. That is fine for startup, but cannot establish assignment authority.
     _check_policy_shape(read_config_doc_readonly(config_path))
     scope = scope_for_profile(home)
-    # The process's own profile reads its launch secret scope and the frozen launch ``TERMINAL_*``
-    # overlay, as ``_bind_whole_profile`` binds it: a managed ``${VAR}`` or a ``TERMINAL_ENV`` that only
-    # systemd / ``op run`` injects has no file to rebuild from. Any other profile gets its own files
-    # only (t_01a1d3f89c1e13c6, t_01a1d4138fd1167a).
+    # The process's own profile reads its launch secret scope and the launch ``TERMINAL_*`` overlay
+    # (frozen once multiplexing is active, the live env before), as ``_bind_whole_profile`` binds
+    # it: a managed ``${VAR}`` or a ``TERMINAL_ENV`` that only systemd / ``op run`` injects has no
+    # file to rebuild from. Any other profile gets its own files only (t_01a1d3f89c1e13c6,
+    # t_01a1d4138fd1167a).
     secrets = owner_secret_scope(home)
     # Unstamped marks the process's own profile, as the legacy setter left it; any other home is routed.
     stamp = not _is_process_home(home)
diff --git a/tui_gateway/launch_profile_policy.py b/tui_gateway/launch_profile_policy.py
index b6ec4f25dc..6642ba1d91 100644
--- a/tui_gateway/launch_profile_policy.py
+++ b/tui_gateway/launch_profile_policy.py
@@ -237,10 +237,10 @@ def profile_config_scope(home: str | Path, *, launch_home: str | Path | None = N
             elif current_scope() is not None:
                 # A bound scope (kanban dispatch, a scoped turn) refuses the unbinds below: bind the
                 # launch profile whole instead, from the LIVE env (single-profile: freezing it here
-                # would capture it before activation, see ``_launch_env``).
+                # would capture it before activation, see ``launch_terminal_env``).
                 stack.enter_context(bind_state(
                     scope_for_profile(launch), secrets=launch_secret_scope(launch), stamp_home=False,
-                    env_overlay={k: v for k, v in _launch_env().items() if k.startswith("TERMINAL_")}))
+                    env_overlay=launch_terminal_env()))
             else:
                 # Unbind an enclosing secondary's home and terminal, or the launch secrets would
                 # pair with that profile's config. Unset resolves to the process home, which is the
