From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 10:14:50 +0000
Subject: [PATCH] fix(http): attribute five static sync and courier routes
 [daveey]

Five active static plugin endpoints were falling into other because the fixed allowlist omitted their verified method/path pairs. Add only those five pairs; retain the 64-key cap, matching, privacy, status and successful-send semantics.

Proof: full accounting suite on unchanged production base: 69 passed, 10 failed (all new positive cases). With five entries: 79 passed, 0 failed. Full scripts/check: 21 checks OK. ASGI regressions cover each route, trailing slash/query privacy, wrong method, 401/403/404 and nonliteral suffixes. Source-only; incident runtime attribution and latency acceptance remain separate.
---
 hermes_cli/http_body_accounting.py            |  5 ++
 tests/hermes_cli/test_http_body_accounting.py | 56 +++++++++++++++++++
 2 files changed, 61 insertions(+)

diff --git a/hermes_cli/http_body_accounting.py b/hermes_cli/http_body_accounting.py
index 6fa5b22c45d76689eb8417d6a8f1a27160833af4..abaec0ed8ba2474051c5cda58eb3cd364d6c1823 100644
--- a/hermes_cli/http_body_accounting.py
+++ b/hermes_cli/http_body_accounting.py
@@ -60,6 +60,11 @@ ROUTE_ALLOWLIST: tuple[tuple[str, str], ...] = (
     ("GET", "/api/plugins/user-steps/session-cards"),
     ("GET", "/api/plugins/user-steps/requests"),
     ("GET", "/api/plugins/hub-sync/status"),
+    ("GET", "/api/plugins/hub-sync/sessions"),
+    ("GET", "/api/plugins/hub-sync/inbox"),
+    ("GET", "/api/plugins/hub-sync/tasks"),
+    ("GET", "/api/plugins/session-mentions/outbox"),
+    ("POST", "/api/plugins/session-mentions/result"),
     ("GET", "/api/plugins/runners/v1/fleet"),
     ("GET", "/api/plugins/throughput/v1/series"),
     ("GET", "/api/plugins/hermes-monitor/workers"),
diff --git a/tests/hermes_cli/test_http_body_accounting.py b/tests/hermes_cli/test_http_body_accounting.py
index bf4c9905cf61a104db4765b9bbbb7e80a7eda177..8a33e704d5da4d0ff1fc74b77df746f1234c1661 100644
--- a/tests/hermes_cli/test_http_body_accounting.py
+++ b/tests/hermes_cli/test_http_body_accounting.py
@@ -146,6 +146,62 @@ def test_allowlist_is_bounded_and_has_inspected_desktop_poll_routes():
     assert hba.OTHER == "other"
 
 
+STATIC_SYNC_ROUTES = (
+    ("GET", "/api/plugins/hub-sync/sessions"),
+    ("GET", "/api/plugins/hub-sync/inbox"),
+    ("GET", "/api/plugins/hub-sync/tasks"),
+    ("GET", "/api/plugins/session-mentions/outbox"),
+    ("POST", "/api/plugins/session-mentions/result"),
+)
+
+
+@pytest.mark.parametrize("method,path", STATIC_SYNC_ROUTES)
+@pytest.mark.parametrize("suffix", ["", "/"])
+def test_static_sync_routes_attribute_asgi_bytes_without_query_values(method, path, suffix):
+    async def app(scope, receive, send):
+        await receive()
+        await _ok_app(scope, receive, send, chunks=[b"abc", b"de"])
+
+    _run(
+        _wrap(app),
+        _scope(method, path + suffix, query=b"cursor=private-cursor&user=private-user"),
+        _receive_body(b"request-private"),
+    )
+    snap = hba.snapshot()
+    key = f"{method} {path}"
+    assert set(snap["routes"]) == {hba.OTHER, key}
+    assert tuple(snap["routes"][key][k] for k in COUNTERS) == (
+        1, 1, 0, 0, 0, len(b"request-private"), 5,
+    )
+    assert snap["totals"] == snap["routes"][key]
+    assert all(value == 0 for value in snap["routes"][hba.OTHER].values())
+    assert snap["unclassified_inflight"] == 0
+    for private in ("private-cursor", "private-user", "request-private", "cursor=", "user="):
+        assert private not in repr(snap)
+
+
+@pytest.mark.parametrize("method,path", STATIC_SYNC_ROUTES)
+@pytest.mark.parametrize(
+    "variant,status",
+    [("wrong-method", 200), ("", 401), ("", 403), ("", 404),
+     ("/private-id", 200), ("-private-id", 200), ("//", 200), ("?private-query", 200)],
+)
+def test_static_sync_routes_reject_nonliteral_or_unsuccessful_asgi(method, path, variant, status):
+    request_method = ("POST" if method == "GET" else "GET") if variant == "wrong-method" else method
+    request_path = path if variant == "wrong-method" else path + variant
+
+    async def app(scope, receive, send):
+        await _ok_app(scope, receive, send, status=status, body=b"denied")
+
+    _run(_wrap(app), _scope(request_method, request_path, query=b"token=private-token"))
+    snap = hba.snapshot()
+    assert set(snap["routes"]) == {hba.OTHER}
+    assert tuple(snap["routes"][hba.OTHER][k] for k in COUNTERS) == (1, 1, 0, 0, 0, 0, 6)
+    assert snap["totals"] == snap["routes"][hba.OTHER]
+    for private in ("private-id", "private-query", "private-token"):
+        assert private not in repr(snap)
+
+
 def test_successful_2xx_matched_route_migrates_off_other():
     async def app(scope, receive, send):
         await _ok_app(scope, receive, send, body=b"hello")
