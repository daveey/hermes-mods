From 09d17edba21fdb37b04a83d4d6b7c243f2bacb5e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 10:10:41 +0000
Subject: [PATCH] fix(kanban): refuse courier loss of mandatory model pins
 [daveey]

---
 hermes_cli/kanban_placement.py                    | 2 +-
 tests/hermes_cli/test_kanban_placement_runs_on.py | 9 +++++++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 55be6278360..914133bf8d9 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -157,7 +157,7 @@ UNCARRIED_OPTIONS = ("initial_status", "human_request", "workspace_path", "proje
                      # nor machine labels: before this a courier create dropped them and the card ran on the
                      # target's own queue (11-11: placement="hub", runs_on=[machine:worker-1]). The labels work
                      # from the creating board (Board lease), so such a card stays here; with a pin it is refused.
-                     "runs_on")
+                     "runs_on", "pin_mandatory")  # courier cannot preserve mandatory model pins either
 # kanban_create options a hermes-hub client with `create-task --option KEY=JSON` carries to the card.
 # (hermes-hub also allows reasoning_effort, but kanban_create has no such parameter.)
 CARRIED_OPTIONS = ("skills", "max_runtime_seconds", "priority", "model", "provider", "goal_mode",
diff --git a/tests/hermes_cli/test_kanban_placement_runs_on.py b/tests/hermes_cli/test_kanban_placement_runs_on.py
index 4b9af1f264a..1c9b0c1f534 100644
--- a/tests/hermes_cli/test_kanban_placement_runs_on.py
+++ b/tests/hermes_cli/test_kanban_placement_runs_on.py
@@ -38,6 +38,15 @@ def test_runs_on_is_never_among_the_options_sent_to_the_target():
     assert "runs_on" not in kp.carried_options({"title": "t", "runs_on": ["machine:worker-1"]})
 
 
+def test_mandatory_model_pin_is_refused_not_silently_relaxed(mac):
+    from tools import kanban_tools as kt
+    mac["result"]["help"] = helpers.NEW_HELP
+    out = json.loads(kt._handle_create({"title": "Regenerate the plugin index", "placement": "hub",
+                                        "model": "example-model", "pin_mandatory": True}))
+    assert out.get("code") == "placement_unavailable" and "pin_mandatory" in out["error"], out
+    assert mac["calls"] == [] and helpers._local_count() == 0
+
+
 def test_runs_on_card_is_not_pool_portable():
     """A worker pool never re-places a card whose creator named its machines."""
     assert kp.portable_reason({"title": "Fix the flaky test", "runs_on": ["machine:worker-1"]},
-- 
2.55.0

