From 737b7f30765822beeaac05eafd6f4721be40b40a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 06:03:31 +0000
Subject: [PATCH] [daveey] Skip unused placement backlog ranking during
 dispatch

Why: each labels_mismatch ready card asked placement for a lane verdict but paid for a complete label backlog ranking. Add backlog=True keyword compatibility and opt out only in note_unplaceable. No event or eligibility semantics change.

Proof: real admitted primary-board ticks with 3 and 7 remote cards; parent fails with 3 backlog reads, candidate has zero and constant rank count. Unplaceable event dedup and missing-label changes pass. 21 focused tests pass. Separate-process 4000-task, 7-ready unchanged tick: parent 85.137741 CPU-ms, candidate 46.022652; exact DispatchResult, task_events and default placement dictionaries equal. RED and benchmark artifacts on task t_e05e35b4ba8605a3. No Mac actions.
---
 hermes_cli/kanban_db_dispatch_preclaim.py     |  2 +-
 hermes_cli/kanban_queue_position.py           | 14 ++--
 .../test_kanban_dispatch_placement_backlog.py | 76 +++++++++++++++++++
 3 files changed, 85 insertions(+), 7 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_dispatch_placement_backlog.py

diff --git a/hermes_cli/kanban_db_dispatch_preclaim.py b/hermes_cli/kanban_db_dispatch_preclaim.py
index 791bcad6abe5808ee72861858719e695830d8e38..4e4635ab8c7b3df0c7ee43c63627685f91cae258 100644
--- a/hermes_cli/kanban_db_dispatch_preclaim.py
+++ b/hermes_cli/kanban_db_dispatch_preclaim.py
@@ -52,7 +52,7 @@ def note_unplaceable(conn: sqlite3.Connection, task_id: str) -> None:
     from hermes_cli import kanban_db as kb
     from hermes_cli import kanban_queue_position as kqp
     try:
-        place = kqp.placement(conn, task_id)
+        place = kqp.placement(conn, task_id, backlog=False)
     except Exception:  # health: allow BLE001 -- the event is advisory; the skip itself already happened
         kb._log.debug("kanban dispatch: unplaceable check failed for %s", task_id, exc_info=True)
         return
