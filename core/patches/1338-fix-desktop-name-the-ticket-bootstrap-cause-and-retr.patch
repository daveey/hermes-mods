From 2946660645c06d7246049329fdce79760ee402c3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 22:09:36 +0000
Subject: [PATCH] fix(desktop): name the ticket bootstrap cause and retry one
 transient connect failure [daveey]

mintLocalGatewayTicket folded the 5 s deadline, ECONNREFUSED/EAGAIN on a full or
stalled listener and any other errno into one 'Gateway ticket bootstrap failed',
so desktop.log could not tell a stalled gateway loop from a dead socket. The
rejection now carries code (errno or 'deadline') and a message suffix, e.g.
'Gateway ticket bootstrap failed (deadline 5000ms)' / '(ECONNREFUSED)'; the
prefix callers match on (redial, session-mentions PRE_SEND_RE) is unchanged.

A transient failure (ECONNREFUSED, EAGAIN, deadline) is retried once after
300 ms, re-resolving the control socket first: a socket unlinked meanwhile stays
'Gateway ticket control socket missing' with no second dial.
---
 .../local-gateway-ticket-cause.test.ts        | 108 ++++++++++++++++++
 apps/desktop/electron/local-gateway.ts        |  60 ++++++++--
 2 files changed, 157 insertions(+), 11 deletions(-)
 create mode 100644 apps/desktop/electron/local-gateway-ticket-cause.test.ts

diff --git a/apps/desktop/electron/local-gateway-ticket-cause.test.ts b/apps/desktop/electron/local-gateway-ticket-cause.test.ts
new file mode 100644
index 00000000000..a779bb2ec7f
--- /dev/null
+++ b/apps/desktop/electron/local-gateway-ticket-cause.test.ts
@@ -0,0 +1,108 @@
+/**
+ * A ticket mint that fails names its cause (`code` + message suffix) and retries one transient
+ * connect failure: under Mac load the control socket refuses (full backlog) or misses the deadline,
+ * and a bare 'Gateway ticket bootstrap failed' hid which one it was.
+ */
+import fs from 'node:fs/promises'
+import net from 'node:net'
+import path from 'node:path'
+
+import { afterEach, beforeEach, expect, test } from 'vitest'
+
+import { gatewayTicketTiming, isStaleLocalGatewayError, mintLocalGatewayTicket } from './local-gateway'
+import { shortSocketTmpDir } from './local-gateway.test-helpers'
+
+const posix = process.platform !== 'win32'
+const saved = { ...gatewayTicketTiming }
+let home = ''
+let servers: net.Server[] = []
+
+const endpoint = () => ({ profile_id: home, instance_id: 'owner', authority_epoch: 1, runtime_protocol: 1, api_origin: 'http://127.0.0.1:1234', capabilities: ['session-authority-v1'], supervisor: 'none' })
+const socketPath = () => path.join(home, 'gateway.sock')
+const grant = (ticket: string) => JSON.stringify({ protocol: 1, id: 1, ok: true, result: { profile_id: home, instance_id: 'owner', ticket } }) + '\n'
+
+async function listen(at: string, onRequest: (socket: net.Socket, n: number) => void) {
+  let n = 0
+  const server = net.createServer(socket => socket.once('data', () => onRequest(socket, ++n)))
+  servers.push(server)
+  await new Promise<void>(resolve => server.listen(at, resolve))
+  await fs.chmod(at, 0o600)
+
+  return { connections: () => n, server }
+}
+
+/** A socket inode with no listener behind it: connect() answers ECONNREFUSED. */
+async function deadSocket() {
+  const scratch = path.join(home, 'dead.sock')
+  const server = net.createServer()
+  await new Promise<void>(resolve => server.listen(scratch, resolve))
+  await fs.rename(scratch, socketPath())
+  await new Promise<void>(resolve => server.close(() => resolve()))
+  await fs.chmod(socketPath(), 0o600)
+}
+
+beforeEach(async () => {
+  home = await shortSocketTmpDir('desktop-cause-')
+  await fs.chmod(home, 0o700)
+  Object.assign(gatewayTicketTiming, { deadlineMs: 150, retryDelayMs: 200 })
+})
+
+afterEach(async () => {
+  Object.assign(gatewayTicketTiming, saved)
+  await Promise.all(servers.map(s => new Promise<void>(resolve => s.close(() => resolve()))))
+  servers = []
+  await fs.rm(home, { recursive: true, force: true })
+})
+
+test.skipIf(!posix)('a stalled listener surfaces code "deadline", after one retry', async () => {
+  const silent = await listen(socketPath(), () => {})
+  const failure = await mintLocalGatewayTicket(endpoint()).catch(error => error)
+  expect(failure.code).toBe('deadline')
+  expect(failure.message).toBe('Gateway ticket bootstrap failed (deadline 150ms)')
+  expect(isStaleLocalGatewayError(failure)).toBe(true)
+  expect(silent.connections()).toBe(2)
+})
+
+test.skipIf(!posix)('a refused connect surfaces code ECONNREFUSED, after one retry', async () => {
+  await deadSocket()
+  const started = Date.now()
+  const failure = await mintLocalGatewayTicket(endpoint()).catch(error => error)
+  expect(failure.code).toBe('ECONNREFUSED')
+  expect(failure.message).toBe('Gateway ticket bootstrap failed (ECONNREFUSED)')
+  // The message prefix callers (redial, session-mentions PRE_SEND_RE) match on is kept.
+  expect(failure.message.startsWith('Gateway ticket bootstrap failed')).toBe(true)
+  expect(Date.now() - started).toBeGreaterThanOrEqual(180)
+})
+
+test.skipIf(!posix)('one refused connect followed by a live listener returns the ticket', async () => {
+  await deadSocket()
+  const minting = mintLocalGatewayTicket(endpoint())
+  // The first dial is refused at once; the owner republishes the socket inside the retry delay.
+  await new Promise(resolve => setTimeout(resolve, 60))
+  await fs.rm(socketPath())
+  const live = await listen(socketPath(), socket => socket.end(grant('after-refusal')))
+  expect(await minting).toBe('after-refusal')
+  expect(live.connections()).toBe(1)
+})
+
+test.skipIf(!posix)('one missed deadline followed by an answer returns the ticket', async () => {
+  const flaky = await listen(socketPath(), (socket, n) => { if (n > 1) {socket.end(grant('second-dial'))} })
+  expect(await mintLocalGatewayTicket(endpoint())).toBe('second-dial')
+  expect(flaky.connections()).toBe(2)
+})
+
+test.skipIf(!posix)('a missing socket is not retried', async () => {
+  const started = Date.now()
+  await expect(mintLocalGatewayTicket(endpoint())).rejects.toThrow('Gateway ticket control socket missing')
+  expect(Date.now() - started).toBeLessThan(150)
+})
+
+test.skipIf(!posix)('a socket unlinked after a refused dial reports missing, with no second dial', async () => {
+  await deadSocket()
+  const minting = mintLocalGatewayTicket(endpoint()).catch(error => error)
+  await new Promise(resolve => setTimeout(resolve, 60))
+  await fs.rm(socketPath())
+  const failure = await minting
+  expect(failure.message).toBe('Gateway ticket control socket missing')
+  expect(failure.code).toBeUndefined()
+})
diff --git a/apps/desktop/electron/local-gateway.ts b/apps/desktop/electron/local-gateway.ts
index 2ae46bc60a3..d6c1aaf88f8 100644
--- a/apps/desktop/electron/local-gateway.ts
+++ b/apps/desktop/electron/local-gateway.ts
@@ -643,26 +643,64 @@ export async function mintLocalGatewayTicket(endpoint: GatewayEndpoint, purpose:
 
   if (groupWritable.length) {return mintGroupWritableHome(endpoint, purpose, groupWritable)}
 
-  let socketPath: string
+  const controlSocket = async () => {
+    try { return await resolveControlSocket(controlHome) } catch (error) {
+      // `gateway stop` unlinks both the socket and its pointer: the owner is gone,
+      // which the redial must treat as stale rather than as a raw filesystem error.
+      if (isMissingNodeError(error)) {throw new Error('Gateway ticket control socket missing')}
+      throw error
+    }
+  }
 
-  try { socketPath = await resolveControlSocket(controlHome) } catch (error) {
-    // `gateway stop` unlinks both the socket and its pointer: the owner is gone,
-    // which the redial must treat as stale rather than as a raw filesystem error.
-    if (isMissingNodeError(error)) {throw new Error('Gateway ticket control socket missing')}
-    throw error
+  const request = { profile_id: home, instance_id: endpoint.instance_id, purpose, ...ticketScope(purpose) }
+
+  try {
+    return await requestGatewayTicket(await controlSocket(), request, endpoint.instance_id, home)
+  } catch (error) {
+    if (!TRANSIENT_TICKET_FAILURES.has((error as GatewayTicketError)?.code ?? '')) {throw error}
   }
 
+  // One retry for a listener that was momentarily full or stalled (load spikes on the Mac):
+  // a single stall otherwise fails every caller sharing this mint. A socket that vanished
+  // meanwhile is a stopped owner, reported as missing without a second dial.
+  await new Promise(resolve => setTimeout(resolve, gatewayTicketTiming.retryDelayMs))
+
+  return requestGatewayTicket(await controlSocket(), request, endpoint.instance_id, home)
+}
+
+/** Timing knobs for the control-socket ticket dial; tests shorten them. */
+export const gatewayTicketTiming = { deadlineMs: 5000, retryDelayMs: 300 }
+
+/** Connect failures worth one more dial: a full/stalled listener or a reply that missed the deadline. */
+const TRANSIENT_TICKET_FAILURES = new Set(['ECONNREFUSED', 'EAGAIN', 'deadline'])
+
+export type GatewayTicketError = Error & { code?: string }
+
+/** `Gateway ticket bootstrap failed (<cause>)` with `code` = the errno or 'deadline', so the log
+ *  tells a stalled gateway loop from a dead socket. The prefix stays what callers match on. */
+function ticketBootstrapFailure(code: string, detail = code): GatewayTicketError {
+  return Object.assign(new Error(`Gateway ticket bootstrap failed (${detail})`), { code })
+}
+
+function requestGatewayTicket(socketPath: string, params: Record<string, unknown>, instanceId: string, home: string): Promise<string> {
   return new Promise((resolve, reject) => {
     const socket = net.createConnection(socketPath)
+    const deadlineMs = gatewayTicketTiming.deadlineMs
     let buffer = ''
-    const deadline = setTimeout(() => socket.destroy(new Error('Gateway ticket deadline')), 5000)
-    socket.on('error', () => reject(new Error('Gateway ticket bootstrap failed')))
+
+    const deadline = setTimeout(() => socket.destroy(ticketBootstrapFailure('deadline', `deadline ${deadlineMs}ms`)), deadlineMs)
+
+    socket.on('error', error => {
+      const code = (error as GatewayTicketError).code
+
+      reject(error.message.startsWith('Gateway ticket bootstrap failed') ? error : ticketBootstrapFailure(code || 'unknown', code || error.message || 'unknown'))
+    })
     socket.on('close', () => { clearTimeout(deadline); reject(new Error('Gateway ticket connection closed')) })
-    socket.on('connect', () => socket.write(JSON.stringify({ protocol: 1, id: 1, verb: 'session-ticket', params: { profile_id: home, instance_id: endpoint.instance_id, purpose, ...ticketScope(purpose) } }) + '\n'))
+    socket.on('connect', () => socket.write(JSON.stringify({ protocol: 1, id: 1, verb: 'session-ticket', params }) + '\n'))
     socket.on('data', chunk => {
       buffer += chunk.toString()
 
-      if (buffer.length > 65536) {return socket.destroy(new Error('Oversized gateway ticket response'))}
+      if (buffer.length > 65536) {return socket.destroy(ticketBootstrapFailure('oversized', 'oversized response'))}
 
       if (!buffer.includes('\n')) {return}
 
@@ -670,7 +708,7 @@ export async function mintLocalGatewayTicket(endpoint: GatewayEndpoint, purpose:
         const reply = JSON.parse(buffer.split('\n')[0])
         const grant = reply.result
 
-        if (!reply.ok || reply.protocol !== 1 || reply.id !== 1 || grant?.instance_id !== endpoint.instance_id || grant?.profile_id !== home || typeof grant?.ticket !== 'string') {throw new Error('Invalid gateway ticket')}
+        if (!reply.ok || reply.protocol !== 1 || reply.id !== 1 || grant?.instance_id !== instanceId || grant?.profile_id !== home || typeof grant?.ticket !== 'string') {throw new Error('Invalid gateway ticket')}
         resolve(grant.ticket)
       } catch { reject(new Error('Invalid gateway ticket response')) }
 
-- 
