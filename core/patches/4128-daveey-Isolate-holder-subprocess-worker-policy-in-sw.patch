From db7f8153136c39d48ceecb1f7a24dddf0a3d0e99 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 03:31:13 +0000
Subject: [PATCH] [daveey] Isolate holder subprocess worker policy in sweep
 regression

---
 tests/scripts/test_runner_sweep_live_holder.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/tests/scripts/test_runner_sweep_live_holder.py b/tests/scripts/test_runner_sweep_live_holder.py
index e9130fdb0b..7565332ba9 100644
--- a/tests/scripts/test_runner_sweep_live_holder.py
+++ b/tests/scripts/test_runner_sweep_live_holder.py
@@ -19,6 +19,8 @@ pytestmark = pytest.mark.platforms("linux")
 @pytest.mark.parametrize("mode", ["fresh-runner", "aged-runner", "default-pruner"])
 def test_runner_sweep_deleted_cwd_scope(slot_env, monkeypatch, tmp_path, mode):
     monkeypatch.setenv("HERMES_TEST_HOST_SLOTS", "1")
+    # Match conftest's parent policy isolation in the fresh holder interpreter.
+    monkeypatch.setenv("HERMES_TEST_POLICY_ROOT", str(tmp_path / "hermes_test"))
     tree = tmp_path / "attempt" / "worktree"
     tree.mkdir(parents=True)
     child, _ = holders._spawn_holder(tree)
