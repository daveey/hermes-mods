From 7ab30da7378e892dc00c4115ab054177cd32cae6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 4 Nov 2026 10:57:44 +0000
Subject: [PATCH] [daveey] test: skip notification park cleanup during its
 first import

---
 tests/conftest.py                             |  5 +++-
 ...tui_server_reset_fixture_partial_import.py | 24 +++++++++++++++++++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/tests/conftest.py b/tests/conftest.py
index 1d4632f7bd0..c1ef1face02 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -1093,7 +1093,10 @@ def _reset_tui_gateway_server_state():
     # later test's session claim a stale event, or spend the cap and refuse its
     # own park.
     park = sys.modules.get("tui_gateway.notification_park")
-    if park is not None:
+    # A poller can still be executing this module's first import. Like the
+    # server above, a sys.modules entry does not imply its globals exist yet.
+    # No caller can park an event until that import finishes.
+    if park is not None and not _tui_server_importing(park):
         park.clear()
 
     if snapshot is not None:
diff --git a/tests/test_tui_server_reset_fixture_partial_import.py b/tests/test_tui_server_reset_fixture_partial_import.py
index 0959673748f..71bba602171 100644
--- a/tests/test_tui_server_reset_fixture_partial_import.py
+++ b/tests/test_tui_server_reset_fixture_partial_import.py
@@ -4,6 +4,9 @@ import importlib.machinery
 import sys
 import types
 
+import pytest
+from unittest.mock import Mock
+
 from tests import conftest as root_conftest
 
 
@@ -32,3 +35,24 @@ def test_fully_initialized_module_is_not_skipped():
     mod = types.ModuleType("x")
     mod.__spec__ = importlib.machinery.ModuleSpec("x", None)
     assert root_conftest._tui_server_importing(mod) is False
+
+
+@pytest.mark.parametrize("initializing", [True, False])
+def test_notification_park_cleanup_respects_import_state(monkeypatch, initializing):
+    server = types.SimpleNamespace(
+        _methods={}, _sessions={}, _cfg_cache=None, _cfg_sig=None, _cfg_path=None,
+        _db=None, _db_error=None, _real_stdout=None,
+    )
+    park = types.ModuleType("tui_gateway.notification_park")
+    park.__spec__ = importlib.machinery.ModuleSpec(park.__name__, None)
+    park.__spec__._initializing = initializing
+    clear = Mock()
+    if not initializing:
+        park.clear = clear
+    monkeypatch.setitem(sys.modules, "tui_gateway.server", server)
+    monkeypatch.setitem(sys.modules, park.__name__, park)
+    gen = _fixture_body()()
+    next(gen)
+    with pytest.raises(StopIteration):
+        next(gen)
+    assert clear.call_count == (0 if initializing else 1)
-- 
2.55.0

