From ef1f58eaeb8792d16f5b45b94dec4082cb6908ca Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 08:50:05 +0000
Subject: [PATCH] [daveey] Reject owner faults after park on the Board-replica
 review path; move kanban resume wiring out of kanban.py

_completed_review_run now checks owner crashed/reclaimed/timed_out after the park
before either foreign source (move-parent mirror or main's replica_review_run), so a
crashed owner stays held active_pr. kanban.py imports kanban_operator_resume.cmd
directly instead of a wrapper (FILE_LINES headroom).
---
 hermes_cli/kanban.py                      |  6 +-----
 hermes_cli/kanban_dependency_review.py    |  4 +++-
 hermes_cli/kanban_move_parent_evidence.py | 22 +++++++++++++++++-----
 3 files changed, 21 insertions(+), 11 deletions(-)

diff --git a/hermes_cli/kanban.py b/hermes_cli/kanban.py
index 58ec13d1f3..e573b51176 100644
--- a/hermes_cli/kanban.py
+++ b/hermes_cli/kanban.py
@@ -47,6 +47,7 @@ from hermes_cli.kanban_ops import (
 )
 from hermes_cli.kanban_parser import build_parser
 from hermes_cli.kanban_sync_cli import cmd_sync as _cmd_sync
+from hermes_cli.kanban_operator_resume import cmd as _cmd_resume
 from hermes_cli.kanban_archive_scope import (  # moved here from this module; re-exported for callers
     _capability_owner_waiting_card, _creator_task_id, _is_stranded_runs_on_copy,
     _worker_may_archive_capability_owner, _worker_may_archive_own,
@@ -1577,11 +1578,6 @@ def _cmd_reopen_review(args: argparse.Namespace) -> int:
                            lambda tid: f"cannot reopen {tid} (not in review?)")
 
 
-def _cmd_resume(args: argparse.Namespace) -> int:
-    from hermes_cli.kanban_operator_resume import cmd
-    return cmd(args)
-
-
 def _cmd_promote(args: argparse.Namespace) -> int:
     reason = _joined_words(args.reason)
     author = _profile_author()
diff --git a/hermes_cli/kanban_dependency_review.py b/hermes_cli/kanban_dependency_review.py
index c8eb864090..6c84f18360 100644
--- a/hermes_cli/kanban_dependency_review.py
+++ b/hermes_cli/kanban_dependency_review.py
@@ -94,8 +94,10 @@ def _completed_review_run(conn, parent_id, parked_at, owner_run_id):
         # A checkpointed move can leave the parent's run on another gateway.
         # Use the refreshed Board result, never a move-supplied verdict or a
         # source database's integer run ID as a local identity.
-        from hermes_cli.kanban_move_parent_evidence import result
+        from hermes_cli.kanban_move_parent_evidence import owner_faulted_since, result
         owner = conn.execute("SELECT task_id FROM task_runs WHERE id = ?", (owner_run_id,)).fetchone()
+        if owner and owner_faulted_since(conn, owner[0], parked_at):
+            return None  # Neither foreign source may release a crashed/reclaimed owner.
         mirrored = result(conn, owner[0], parent_id) if owner else None
         if (mirrored and mirrored.get("parent_status") == "done" and mirrored.get("was_claimed")
                 and mirrored.get("outcome") == "completed"
diff --git a/hermes_cli/kanban_move_parent_evidence.py b/hermes_cli/kanban_move_parent_evidence.py
index 1fc5fcfa3e..4e5ed85a14 100644
--- a/hermes_cli/kanban_move_parent_evidence.py
+++ b/hermes_cli/kanban_move_parent_evidence.py
@@ -117,6 +117,22 @@ def _checkpointed_move_after(conn, task_id, ended):
     return moved is not None and moved >= ended
 
 
+def owner_faulted_since(conn, task_id, since) -> bool:
+    """True when the owner crashed, was reclaimed or timed out at/after ``since``.
+
+    A park authorizes one continuation of an orderly owner only; a fault after it
+    re-arms the hold whichever foreign source (this mirror or the Board replica)
+    supplies the parent's result.
+    """
+    from hermes_cli import kanban_db as kb
+
+    faults = conn.execute(
+        "SELECT created_at FROM task_events WHERE task_id = ? "
+        "AND kind IN ('crashed', 'reclaimed', 'timed_out')", (task_id,),
+    )
+    return any((kb._to_epoch(e[0]) or 0) >= since for e in faults)
+
+
 def result(conn, task_id, parent_id):
     """Read only for an orderly parked owner: after a checkpointed queued move, or
     when the owner's own authenticated review park names this parent."""
@@ -137,11 +153,7 @@ def result(conn, task_id, parent_id):
         evidence = _parked_review_checkpoint(conn, task_id, run)
         if evidence is None or parent_id not in evidence["parents"]:
             return None
-    faults = conn.execute(
-        "SELECT created_at FROM task_events WHERE task_id = ? "
-        "AND kind IN ('crashed', 'reclaimed', 'timed_out')", (task_id,),
-    )
-    if any((kb._to_epoch(e[0]) or 0) >= ended for e in faults):
+    if owner_faulted_since(conn, task_id, ended):
         return None
     if not conn.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?", (_TABLE,)).fetchone():
         return None
