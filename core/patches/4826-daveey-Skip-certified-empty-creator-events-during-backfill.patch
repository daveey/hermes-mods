+# ---------------------------------------------------------------------------------------------
+# Order-preserving envelope (E1): literal rows in literal order, filtered inside one statement.
+# ---------------------------------------------------------------------------------------------
+def details(conn, sql):
+    return [r[3] for r in conn.execute('EXPLAIN QUERY PLAN ' + sql)]
+
