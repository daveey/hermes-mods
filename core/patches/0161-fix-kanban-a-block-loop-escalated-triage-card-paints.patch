From ac4156dbe6af0cfadb017e610de39fc506f6ddec Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 21 Oct 2026 14:10:54 -0700
Subject: [PATCH] fix(kanban): a block-loop-escalated triage card paints its
 session red [daveey]

---
 hermes_cli/kanban_session_activity.py         | 10 ++++--
 .../test_kanban_session_activity_triage.py    | 34 +++++++++++++++++++
 2 files changed, 42 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_session_activity_triage.py

diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index 88dcdb38d0..cccf620a26 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -30,7 +30,10 @@ ACTIVE_STATUSES = ("todo", "ready", "running", "scheduled")
 # Waiting on a human. These don't keep the session busy, but the sidebar row
 # shows how many there are next to the open count (``kanban_blocked``) and the
 # row paints red. [daveey]
-BLOCKED_STATUSES = ("blocked",)
+# ``triage`` joins it only for a card block-loop detection escalated there: it
+# keeps its human ``block_kind`` and still waits on the user. A card created
+# in triage for a specifier (``block_kind`` NULL) is not red. [daveey]
+BLOCKED_STATUSES = ("blocked", "triage")
 # A ``blocked`` card only waits on a human for these kinds (NULL = generic human
 # blocker). A ``transient``/``time`` block waits on a retry or a clock, so it
 # counts as in-progress work instead, like ``scheduled``. [daveey]
@@ -64,11 +67,14 @@ def _status_filter(conn: sqlite3.Connection, statuses: tuple[str, ...]) -> tuple
     gains the ``transient``/``time`` ones. A board without ``block_kind`` is unchanged."""
     ph = ",".join("?" for _ in statuses)
     if not {r[1] for r in conn.execute("PRAGMA table_info(tasks)")} >= {"block_kind"}:
+        if statuses == BLOCKED_STATUSES:
+            return "t.status = 'blocked'", ()
         return f"t.status IN ({ph})", statuses
     kinds = ",".join("?" for _ in HUMAN_BLOCK_KINDS)
     human = f"(t.block_kind IS NULL OR t.block_kind IN ({kinds}))"
     if statuses == BLOCKED_STATUSES:
-        return f"(t.status = 'blocked' AND {human})", HUMAN_BLOCK_KINDS
+        escalated = f"(t.status = 'triage' AND t.block_kind IN ({kinds}))"
+        return f"((t.status = 'blocked' AND {human}) OR {escalated})", (*HUMAN_BLOCK_KINDS, *HUMAN_BLOCK_KINDS)
     return f"(t.status IN ({ph}) OR (t.status = 'blocked' AND NOT {human}))", (*statuses, *HUMAN_BLOCK_KINDS)
 
 
diff --git a/tests/hermes_cli/test_kanban_session_activity_triage.py b/tests/hermes_cli/test_kanban_session_activity_triage.py
new file mode 100644
index 0000000000..02a9c954ac
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_session_activity_triage.py
@@ -0,0 +1,34 @@
+"""A card block-loop detection escalated to triage still waits on the user, so
+its session row paints red; a card created in triage for a specifier does not."""
+
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_session_activity as ksa
+
+
+@pytest.fixture
+def kanban_root(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    ksa._reset_cache_for_tests()
+    conn = sqlite3.connect(tmp_path / "kanban.db")
+    conn.execute("CREATE TABLE tasks (id TEXT PRIMARY KEY, status TEXT NOT NULL, session_id TEXT, block_kind TEXT)")
+    conn.executemany("INSERT INTO tasks VALUES (?, ?, ?, ?)", [
+        ("t_esc", "triage", "s_esc", "needs_input"),     # escalated by block_loop_detected
+        ("t_spec", "triage", "s_spec", None),            # born in triage, awaiting a specifier
+        ("t_time", "blocked", "s_time", "transient"),    # waits on a retry, not a human
+        ("t_human", "blocked", "s_human", "capability"),
+    ])
+    conn.commit()
+    conn.close()
+    yield tmp_path
+    ksa._reset_cache_for_tests()
+
+
+def test_escalated_triage_card_counts_as_waiting_on_the_user(kanban_root):
+    assert ksa.blocked_task_counts() == {"s_esc": 1, "s_human": 1}
+
+
+def test_escalated_triage_card_is_listed_on_its_session(kanban_root):
+    assert [t["id"] for t in ksa.session_tasks(["s_esc"])] == ["t_esc"]
