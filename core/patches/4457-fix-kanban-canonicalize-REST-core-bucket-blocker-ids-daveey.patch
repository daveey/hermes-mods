From 621bdd93069fc216d30c9af14aa9954ade018d00 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 10:34:41 +0000
Subject: [PATCH] fix(kanban): canonicalize REST core bucket blocker ids
 [daveey]

Bucket-derived quota wall names bypassed canonical checks and stale assertion fencing. Normalize login-core names while preserving unrelated outage identities. RED: 13 failures; GREEN: 49 tests including legacy stored runs and successful check release.
---
 hermes_cli/kanban_shared_blockers.py          |  3 +-
 .../test_kanban_shared_blocker_bucket_ids.py  | 40 +++++++++++++++++++
 2 files changed, 42 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_cli/test_kanban_shared_blocker_bucket_ids.py

diff --git a/hermes_cli/kanban_shared_blockers.py b/hermes_cli/kanban_shared_blockers.py
index 76dc262d393fd60d3a10851f40d6d12f0d7273f9..33fef460558df50b5f4a7dc30dfe064c792fbaaf 100644
--- a/hermes_cli/kanban_shared_blockers.py
+++ b/hermes_cli/kanban_shared_blockers.py
@@ -143,7 +143,8 @@ def normalize_blocker_id(raw, *, cfg=None) -> Optional[str]:
     if not isinstance(raw, str):
         return None
     slug = _blocker_slug(raw)
-    if re.fullmatch(r"github(-(shared|rest|core))*-quota(-reserve)?", slug):
+    if (re.fullmatch(r"github(-(shared|rest|core))*-quota(-reserve)?", slug)
+            or re.fullmatch(r"github-[a-z0-9]+(?:-[a-z0-9]+)*-core(?:-quota)?(?:-reserve)?", slug)):
         return "github-rest-quota"
     if cfg is None:
         from hermes_cli.config_backend import ConfigBackendUnavailable
diff --git a/tests/hermes_cli/test_kanban_shared_blocker_bucket_ids.py b/tests/hermes_cli/test_kanban_shared_blocker_bucket_ids.py
new file mode 100644
index 0000000000000000000000000000000000000000..fee903595f08e7a23d15c8990f125831fd475765
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_shared_blocker_bucket_ids.py
@@ -0,0 +1,40 @@
+"""Quota guard bucket-derived names must reach the canonical recovery check."""
+import pytest
+
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_shared_blocker_checks as checks
+from hermes_cli import kanban_shared_blockers as blockers
+from tests.hermes_cli import test_kanban_shared_blockers as helpers
+
+kanban_home = helpers.kanban_home
+
+
+@pytest.mark.parametrize('login', ['daveey', 'octo', 'octo-cat'])
+@pytest.mark.parametrize('suffix', ['', '-reserve', '-quota', '-quota-reserve'])
+def test_core_bucket_identity(login, suffix):
+    assert blockers.normalize_blocker_id(f'github-{login}-core{suffix}', cfg={}) == 'github-rest-quota'
+
+
+@pytest.mark.parametrize('slug', [
+    'github-daveey-graphql-reserve', 'github-octo-graphql-quota',
+    'github-git-ops-outage', 'github-api-rate-limit',
+    'github-actions-billing', 'github-actions-billing-outage',
+    'bb-tuner-github-token-stale',
+])
+def test_unrelated_walls_remain_distinct(slug):
+    assert blockers.normalize_blocker_id(slug, cfg={}) == slug
+
+
+def test_bucket_runs_coalesce_and_check_clears(kanban_home):
+    with kbc.connect_closing() as conn:
+        for slug in ['github-daveey-core-reserve', 'github-octo-core-quota']:
+            helpers._legacy_blocked_behind(conn, slug, blocker_id=slug)
+        states = blockers.blocker_states(conn)
+        assert set(states) == {'github-rest-quota'}
+        assert states['github-rest-quota'].is_open
+        assert len(states['github-rest-quota'].behind) == 2
+        cfg = {'kanban': {'shared_blocker_checks': {'github-rest-quota': 'exit 0'}}}
+        assert checks.run_due_checks(conn, cfg=cfg) == ['github-rest-quota']
+        checks.apply_check_clears(conn, states)
+        assert not states['github-rest-quota'].is_open
+        assert states['github-rest-quota'].cleared_via == 'check'
-- 
