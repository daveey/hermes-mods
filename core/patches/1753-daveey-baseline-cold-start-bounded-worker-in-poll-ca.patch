From 56ef77262bd87614bcd04aef2820e41d5a96b733 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 22:30:26 +0000
Subject: [PATCH] [daveey] baseline cold-start bounded worker in poll cache
 guarantee tests

---
 tests/hermes_cli/test_kanban_poll_cache_guarantees.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_poll_cache_guarantees.py b/tests/hermes_cli/test_kanban_poll_cache_guarantees.py
index 332c18700c1..5942ddf7f5e 100644
--- a/tests/hermes_cli/test_kanban_poll_cache_guarantees.py
+++ b/tests/hermes_cli/test_kanban_poll_cache_guarantees.py
@@ -64,10 +64,11 @@ def test_inline_poll_reads_each_board_revision_once(clock, spies, tmp_path, monk
         assert ksa._board_db_paths() == paths
         assert all(real(path)[0] == "revision" for path in paths)
         assert helpers._poll()["kanban_active"] == 2
+        cold_threads = spies["threads"]  # a cold start reads on a bounded worker
         reads.clear()
         helpers._advance(clock, ksa._CACHE_TTL_S + 0.5)
         assert helpers._poll()["kanban_active"] == 2
-        assert spies == {"recompute": 1, "threads": 0}
+        assert spies == {"recompute": 1, "threads": cold_threads}
         assert reads == Counter({path: 1 for path in paths})
     finally:
         for conn in conns:
@@ -81,6 +82,7 @@ def test_expired_attention_with_moved_key_requires_bounded_refresh(clock, spies,
     dispose = ksa.register_done_check("bounded", lambda card: checked.append(card["id"]) or True)
     try:
         assert helpers._poll()["kanban_attention"] == 1
+        cold_threads = spies["threads"]  # a cold start reads on a bounded worker
         helpers._advance(clock, ksa._ATTENTION_TTL_S + 1)
         conn.execute("INSERT INTO tasks VALUES ('t2', 'done', 's1', 'ship', ?, 'done')", (clock["wall"],))
         # Another consumer refreshes counts, not attention: only the latter is stale.
@@ -89,7 +91,7 @@ def test_expired_attention_with_moved_key_requires_bounded_refresh(clock, spies,
         assert ksa._revalidate.unchanged_inputs(scope) is None
         assert checked == ["t1"]
         assert helpers._poll()["kanban_attention"] == 2
-        assert spies["threads"] == 1
+        assert spies["threads"] == cold_threads + 1
         assert sorted(checked) == ["t1", "t1", "t2"]
     finally:
         dispose()
-- 
2.55.0

