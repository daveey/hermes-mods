From 8923eec005450a3fe750caba8d0b0843fa632a9a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 20:54:02 +0000
Subject: [PATCH] [daveey] Scope retained shell init policy to the config path

---
 .../test_local_shell_init_config_failure.py   | 26 ++++++++++++++++++-
 tools/environments/local.py                   | 13 +++++-----
 2 files changed, 32 insertions(+), 7 deletions(-)

diff --git a/tests/tools/test_local_shell_init_config_failure.py b/tests/tools/test_local_shell_init_config_failure.py
index 9c194348a84..f2a3e41c655 100644
--- a/tests/tools/test_local_shell_init_config_failure.py
+++ b/tests/tools/test_local_shell_init_config_failure.py
@@ -12,7 +12,7 @@ from tools.environments import local
 
 @pytest.fixture(autouse=True)
 def isolated_shell_init_cache(monkeypatch):
-    monkeypatch.setattr(local, "_shell_init_config_cache", None, raising=False)
+    monkeypatch.setattr(local, "_shell_init_config_cache", {}, raising=False)
     monkeypatch.setattr(local, "_shell_init_config_warned", set(), raising=False)
 
 
@@ -28,6 +28,30 @@ def test_read_error_keeps_previous_shell_init(caplog):
     assert caplog.records[-1].levelno == logging.WARNING
 
 
+def test_profile_first_failure_never_reuses_another_profiles_policy(tmp_path, caplog):
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+    token = set_hermes_home_override(tmp_path / "a")
+    try:
+        with patch("hermes_cli.config.load_config", return_value={
+            "terminal": {"shell_init_files": ["/custom/a.sh"], "auto_source_bashrc": False},
+        }):
+            assert local._read_terminal_shell_init_config() == (["/custom/a.sh"], False)
+        other = set_hermes_home_override(tmp_path / "b")
+        try:
+            with patch("hermes_cli.config.load_config", side_effect=OSError("profile B failed")):
+                assert local._read_terminal_shell_init_config() == ([], True)
+            assert "configured shell init was not applied" in caplog.text
+        finally:
+            reset_hermes_home_override(other)
+        caplog.clear()
+        with patch("hermes_cli.config.load_config", side_effect=OSError("profile A failed")):
+            assert local._read_terminal_shell_init_config() == (["/custom/a.sh"], False)
+        assert "previously resolved shell init is kept" in caplog.text
+    finally:
+        reset_hermes_home_override(token)
+
+
 def test_first_read_error_warns_about_default_home_profiles(caplog):
     with patch("hermes_cli.config.load_config", side_effect=OSError("injected config read failure")):
         assert local._read_terminal_shell_init_config() == ([], True)
diff --git a/tools/environments/local.py b/tools/environments/local.py
index 379e50e54ad..697ca8edec0 100644
--- a/tools/environments/local.py
+++ b/tools/environments/local.py
@@ -836,22 +836,23 @@ _hermes_site_packages: list[Path] | None = None  # lazily cached by local_python
 
 
 # --- Login-shell init files ---
-_shell_init_config_cache: tuple[tuple[str, ...], bool] | None = None
+_shell_init_config_cache: dict[str, tuple[tuple[str, ...], bool]] = {}
 _shell_init_config_warned: set[tuple[type[Exception], str]] = set()
 
 
 def _read_terminal_shell_init_config() -> tuple[list[str], bool]:
-    """Read startup policy, retaining the last successful process-local resolution on failure."""
-    global _shell_init_config_cache
+    """Retain the last successful policy for this config path on read failure."""
+    config_path = ""  # Unresolved paths have no cached policy.
     try:
-        from hermes_cli.config import load_config
+        from hermes_cli.config import get_config_path, load_config
+        config_path = str(get_config_path())
         terminal_cfg = (load_config() or {}).get("terminal") or {}
         files = terminal_cfg.get("shell_init_files") or []
         if not isinstance(files, list):
             files = []
         resolved = (tuple(str(f) for f in files if f), bool(terminal_cfg.get("auto_source_bashrc", True)))
     except Exception as exc:
-        resolved = _shell_init_config_cache
+        resolved = _shell_init_config_cache.get(config_path)
         key = (type(exc), str(exc))
         if key not in _shell_init_config_warned:
             _shell_init_config_warned.add(key)
@@ -862,7 +863,7 @@ def _read_terminal_shell_init_config() -> tuple[list[str], bool]:
         if resolved is None:
             return [], True
     else:
-        _shell_init_config_cache = resolved
+        _shell_init_config_cache[config_path] = resolved
     return list(resolved[0]), resolved[1]
 
 
-- 
2.55.0

