 locales/_keys.desktop.json | 1 +
 1 file changed, 1 insertion(+)

diff --git a/locales/_keys.desktop.json b/locales/_keys.desktop.json
index 56c3b27a6e..b042c2d47b 100644
--- a/locales/_keys.desktop.json
+++ b/locales/_keys.desktop.json
@@ -4191,6 +4191,7 @@
     "shell.statusbar.hideTerminal",
     "shell.statusbar.messagingDegraded",
     "shell.statusbar.messagingStopped",
+    "shell.statusbar.modelLoading",
     "shell.statusbar.modelNone",
     "shell.statusbar.modelPinned",
     "shell.statusbar.modelTitle",
