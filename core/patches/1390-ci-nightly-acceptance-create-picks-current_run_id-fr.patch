From 85ca95df9102fbdb1be0d48aff0d51c878e46f38 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 03:06:35 +0000
Subject: [PATCH] ci: nightly acceptance create picks current_run_id from show;
 skip CLI-shelling flaky tests in bare env

---
 scripts/ci/nightly_e2e.py     | 18 +++++++++++++-
 tests/ci/test_flaky_kanban.py |  4 ++++
 tests/ci/test_nightly_e2e.py  | 45 +++++++++++++++++++++++++++++++++++
 3 files changed, 66 insertions(+), 1 deletion(-)

diff --git a/scripts/ci/nightly_e2e.py b/scripts/ci/nightly_e2e.py
index 0342c961a8d..6069b990c49 100644
--- a/scripts/ci/nightly_e2e.py
+++ b/scripts/ci/nightly_e2e.py
@@ -182,12 +182,28 @@ class NightlyBoard(CliBoard):
         # The CLI drops a TASK identity that has no live RUN_ID, so pair them from the owner's live run.
         extra_env = None
         if creator_task_id:
+            shown = self._show(creator_task_id)
+            if shown is None:
+                raise RuntimeError(f"acceptance owner {creator_task_id} could not be read (kanban show failed)")
             live = [
-                r for r in ((self._show(creator_task_id) or {}).get("runs") or [])
+                r for r in (shown.get("runs") or [])
                 if r.get("status") == "running" and not r.get("ended_at")
             ]
             if not live:
                 raise RuntimeError(f"acceptance owner {creator_task_id} has no live run to attribute cards to")
+            # The CLI accepts only the task's current run; take it from the same payload as the run list.
+            current = (shown.get("task") or {}).get("current_run_id")
+            if current is not None:
+                match = [r for r in live if str(r.get("id")) == str(current)]
+                if not match:
+                    raise RuntimeError(
+                        f"acceptance owner {creator_task_id} current run {current} is not a live run"
+                    )
+                live = match
+            elif len(live) > 1:
+                raise RuntimeError(
+                    f"acceptance owner {creator_task_id} has {len(live)} running runs and no current_run_id"
+                )
             extra_env = {"HERMES_KANBAN_TASK": creator_task_id, "HERMES_KANBAN_RUN_ID": str(live[-1]["id"])}
         out = self._run(
             "create",
diff --git a/tests/ci/test_flaky_kanban.py b/tests/ci/test_flaky_kanban.py
index 3bacd6bf6d0..f502aea819b 100644
--- a/tests/ci/test_flaky_kanban.py
+++ b/tests/ci/test_flaky_kanban.py
@@ -270,6 +270,8 @@ def test_state_round_trips_and_rejects_unknown_report_versions(tmp_path):
 
 @pytest.mark.platforms("posix")
 def test_cli_board_skips_a_job_a_done_card_already_cites(tmp_path, monkeypatch):
+    # These shell out to `hermes kanban`, which needs the repo env; a bare `uv run --with pytest` lacks python-dotenv.
+    pytest.importorskip("dotenv", reason="needs the repo environment (hermes_cli imports python-dotenv)")
     """CliBoard.list_cards/comments on a real isolated board (through `hermes kanban`, not its DB)."""
     home = tmp_path / "hermes-home"
     home.mkdir()
@@ -307,6 +309,8 @@ def test_cli_board_skips_a_job_a_done_card_already_cites(tmp_path, monkeypatch):
 
 @pytest.mark.platforms("posix")
 def test_flaky_test_passes_and_files_a_card_while_a_hard_failure_stays_red(tmp_path, monkeypatch):
+    # These shell out to `hermes kanban`, which needs the repo env; a bare `uv run --with pytest` lacks python-dotenv.
+    pytest.importorskip("dotenv", reason="needs the repo environment (hermes_cli imports python-dotenv)")
     # Real runner: copy it the way tests/scripts/test_run_tests_parallel.py does.
     root = tmp_path / "runner-root"
     (root / "scripts" / "ci").mkdir(parents=True)
diff --git a/tests/ci/test_nightly_e2e.py b/tests/ci/test_nightly_e2e.py
index dbceed3f549..9773e02768b 100644
--- a/tests/ci/test_nightly_e2e.py
+++ b/tests/ci/test_nightly_e2e.py
@@ -594,6 +594,51 @@ def test_nightly_board_stamps_creator_only_for_acceptance(monkeypatch):
         board.create("t", "b", "k", creator_task_id=OWNER)
 
 
+def _acceptance_board(monkeypatch, shown):
+    board = ne.NightlyBoard("hermes")
+    envs = []
+    monkeypatch.setattr(board, "_show", lambda *a, **k: shown)
+    monkeypatch.setattr(board, "_run", lambda *a, **k: envs.append(k.get("extra_env")) or '{"id":"t_new"}')
+    return board, envs
+
+
+def test_acceptance_create_uses_current_run_id_from_show_payload(monkeypatch):
+    shown = {
+        "task": {"current_run_id": 8},
+        "runs": [
+            {"id": 7, "status": "running", "ended_at": None},
+            {"id": 8, "status": "running", "ended_at": None},
+            {"id": 9, "status": "running", "ended_at": None},
+        ],
+    }
+    board, envs = _acceptance_board(monkeypatch, shown)
+    board.create("t", "b", "k", creator_task_id=OWNER)
+    assert envs == [{"HERMES_KANBAN_TASK": OWNER, "HERMES_KANBAN_RUN_ID": "8"}]
+
+
+def test_acceptance_create_rejects_current_run_that_is_not_live(monkeypatch):
+    shown = {"task": {"current_run_id": 5}, "runs": [{"id": 7, "status": "running", "ended_at": None}]}
+    board, envs = _acceptance_board(monkeypatch, shown)
+    with pytest.raises(RuntimeError, match="current run 5 is not a live run"):
+        board.create("t", "b", "k", creator_task_id=OWNER)
+    assert envs == []
+
+
+def test_acceptance_create_refuses_to_guess_among_several_runs(monkeypatch):
+    shown = {"runs": [{"id": 7, "status": "running", "ended_at": None}, {"id": 8, "status": "running", "ended_at": None}]}
+    board, envs = _acceptance_board(monkeypatch, shown)
+    with pytest.raises(RuntimeError, match="2 running runs and no current_run_id"):
+        board.create("t", "b", "k", creator_task_id=OWNER)
+    assert envs == []
+
+
+def test_acceptance_create_clear_error_when_show_returns_none(monkeypatch):
+    board, envs = _acceptance_board(monkeypatch, None)
+    with pytest.raises(RuntimeError, match="could not be read"):
+        board.create("t", "b", "k", creator_task_id=OWNER)
+    assert envs == []
+
+
 def test_cli_create_env_only_carries_worker_task_in_acceptance(monkeypatch):
     seen = []
 
-- 
