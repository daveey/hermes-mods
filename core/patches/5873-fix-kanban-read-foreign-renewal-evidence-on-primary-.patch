Subject: [PATCH] fix(kanban): read foreign renewal evidence on primary boards
 [daveey]

Public mirror of the source commit; see the accompanying feature documentation.

---
 hermes_cli/kanban_scope_renewal_cli.py        | 19 +++++++++++++++++--
 .../test_kanban_scope_renewal_shadow.py       |  6 +++---
 2 files changed, 20 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_scope_renewal_cli.py b/hermes_cli/kanban_scope_renewal_cli.py
index b917f6ee62c..b5ed545a1e9 100644
--- a/hermes_cli/kanban_scope_renewal_cli.py
+++ b/hermes_cli/kanban_scope_renewal_cli.py
@@ -176,6 +176,22 @@ def _canonical(conn: sqlite3.Connection, board: str, task_id: str, payload: dict
         hub.close()
 
 
+def _evidence_connection(conn: sqlite3.Connection, scope: ExitStack, task_id: str) -> sqlite3.Connection:
+    """Read foreign evidence on primary AND shadow boards; never import it into the live board.
+
+    Unlike show's shadow-only view, renewal is a canonical Board operation even when the caller's
+    primary database contains only its own cards. Ordinary local write paths remain unchanged.
+    """
+    from hermes_cli import kanban_foreign_card as foreign
+    from hermes_cli.kanban_db_connect import _main_db_file
+    if conn.execute("SELECT 1 FROM tasks WHERE id=?", (task_id,)).fetchone():
+        return conn
+    replica = scope.enter_context(foreign.open_replica(_main_db_file(conn)))
+    if replica is not None and replica.execute("SELECT 1 FROM tasks WHERE id=?", (task_id,)).fetchone():
+        return replica
+    return conn
+
+
 def renew(conn: sqlite3.Connection, task_id: str, *, episode: str, comment_id: int, reason: str,
           board: Optional[str] = None, writer: Optional[tuple] = None,
           env: Optional[Mapping[str, str]] = None,
@@ -192,8 +208,7 @@ def renew(conn: sqlite3.Connection, task_id: str, *, episode: str, comment_id: i
         except Inconclusive as exc:
             raise RenewalRefused("identity_unavailable", f"the caller's process ancestry could not be read ({exc})")
     with ExitStack() as scope:
-        from hermes_cli.kanban_shadow_view import open_card
-        _, evidence, _ = open_card(conn, scope, task_id)
+        evidence = _evidence_connection(conn, scope, task_id)
         gateway, profile = gateway_names()[0], get_active_profile_name() or "default"
         actor = resolve_actor(evidence, task_id, writer=writer, environs=[*(ancestry or ()), env],
                               gateway=gateway, profile=profile,
diff --git a/tests/hermes_cli/test_kanban_scope_renewal_shadow.py b/tests/hermes_cli/test_kanban_scope_renewal_shadow.py
index a5f51ad995a..b31008bff27 100644
--- a/tests/hermes_cli/test_kanban_scope_renewal_shadow.py
+++ b/tests/hermes_cli/test_kanban_scope_renewal_shadow.py
@@ -17,8 +17,8 @@ from tests.hermes_cli import test_kanban_scope_renewal_synced as support
 live = support.live
 
 
-@pytest.fixture
-def foreign(live, monkeypatch, tmp_path):
+@pytest.fixture(params=['shadow', 'primary'])
+def foreign(live, monkeypatch, tmp_path, request):
     hub = support.Hub({'scope_renewal': 1})
     tid, episode, comment = support.stopped(live, monkeypatch, hub)
     # The worker's home has a created link to the hub chat, not to a worker-local chat.
@@ -30,7 +30,7 @@ def foreign(live, monkeypatch, tmp_path):
     monkeypatch.setattr(kanban_origin, 'gateway_names', lambda: ('hub',))
     primary = kbc.connect(tmp_path / 'hub.db')
     client.ensure_identity(primary, 'default', 'hub')
-    sync.set_mode(primary, 'shadow')
+    sync.set_mode(primary, request.param)
     path = tmp_path / 'replica.db'
 
     def snapshot():
