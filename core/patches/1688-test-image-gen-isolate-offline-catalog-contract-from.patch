From ccaa795b8f23ed6a2d146788f567911a79fc1658 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 13:41:03 +0000
Subject: [PATCH] test(image-gen): isolate offline catalog contract from live
 inventory [daveey]

---
 .../test_openrouter_compat_provider.py        | 27 ++++++++++++++++---
 1 file changed, 24 insertions(+), 3 deletions(-)

diff --git a/tests/plugins/image_gen/test_openrouter_compat_provider.py b/tests/plugins/image_gen/test_openrouter_compat_provider.py
index 5a933f6ca74..4f7ab1792f6 100644
--- a/tests/plugins/image_gen/test_openrouter_compat_provider.py
+++ b/tests/plugins/image_gen/test_openrouter_compat_provider.py
@@ -12,6 +12,15 @@ _RUNTIME = "hermes_cli.runtime_provider.resolve_runtime_provider"
 _PNG_DATA_URI = "data:image/png;base64,dGVzdC1pbWFnZS1kYXRh"  # "test-image-data"
 
 
+@pytest.fixture(autouse=True)
+def _no_unmocked_catalog_requests(monkeypatch):
+    """Public catalogs work without credentials; each test must control its HTTP input."""
+    def unexpected_get(*args, **kwargs):
+        pytest.fail("Mock catalog GET explicitly; unit tests must not use live model inventory")
+
+    monkeypatch.setattr("requests.get", unexpected_get)
+
+
 def _runtime_ok(**over):
     base = {
         "provider": "openrouter",
@@ -186,9 +195,10 @@ class TestLiveCatalog:
     def test_picker_merges_image_api_and_chat_catalogs(self):
         """OpenRouter picker = union of /images/models and image-output
         /models entries, deduped, defaults first."""
-        from plugins.image_gen.openrouter import _build_providers
+        from plugins.image_gen.openrouter import _IMAGE_API_MODELS, _build_providers
 
-        orp = {p.name: p for p in _build_providers()}["openrouter"]
+        by_name = {p.name: p for p in _build_providers()}
+        orp = by_name["openrouter"]
 
         def fake_get(url, **kw):
             resp = MagicMock()
@@ -213,8 +223,19 @@ class TestLiveCatalog:
                 ]}
             return resp
 
-        with patch(_RUNTIME, return_value=_runtime_ok()), patch("requests.get", side_effect=fake_get):
+        with patch(_RUNTIME, return_value=_runtime_ok()), patch("requests.get", side_effect=fake_get) as get:
             ids = [m["id"] for m in orp.list_models()]
+            get.reset_mock()
+            nous_ids = {m["id"] for m in by_name["nous"].list_models()}
+            assert [call.args[0] for call in get.call_args_list] == [
+                "https://openrouter.ai/api/v1/models"]
+        expected_live = {
+            "openai/gpt-5.4-image-2", "bytedance-seed/seedream-4.5", "google/gemini-3-pro-image"}
+        assert set(ids) == expected_live
+        # A successful live response must not resurrect snapshot-only (possibly retired) models.
+        assert set(_IMAGE_API_MODELS) - expected_live
+        assert not ((set(_IMAGE_API_MODELS) - expected_live) & set(ids))
+        assert nous_ids == {"openai/gpt-5.4-image-2", "google/gemini-3-pro-image"}
         assert ids[0] == "openai/gpt-5.4-image-2"          # default first
         assert "bytedance-seed/seedream-4.5" in ids        # Image-API-only model present
         assert "google/gemini-3-pro-image" in ids          # chat-catalog model present
-- 
