From b6292779630ef4ab0b3092d3861b47dc549f88a7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:40:22 +0000
Subject: [PATCH] test(delegation): model offer leases and fresh restart
 custody [daveey]

---
 .../test_watch_notification_reset_pin.py      | 10 +++++----
 .../test_restored_delegation_transport.py     | 22 ++++++++++++++++---
 2 files changed, 25 insertions(+), 7 deletions(-)

diff --git a/tests/gateway/test_watch_notification_reset_pin.py b/tests/gateway/test_watch_notification_reset_pin.py
index 6a524e440e6..a4f98a5a97f 100644
--- a/tests/gateway/test_watch_notification_reset_pin.py
+++ b/tests/gateway/test_watch_notification_reset_pin.py
@@ -232,8 +232,9 @@ async def test_permanently_refused_completion_converges_to_dropped_across_restar
         for _process in range(3):
             # Each process starts from the durable ledger alone: a fresh queue, replayed rows.
             monkeypatch.setattr(process_registry, 'completion_queue', queue.Queue())
-            delegation._offered.clear()
-            delegation.restore_undelivered_completions(process_registry.completion_queue)
+            # A restart loses ALL process-local custody, including the offer lease.
+            delegation._reset_for_tests()
+            assert delegation.restore_undelivered_completions(process_registry.completion_queue) == 1
             await _run_async_watcher(runner, monkeypatch, clock, ticks=150)
             row = delegation.get_durable_delegation('refused-1')
             if row['delivery_state'] != 'pending':
@@ -286,8 +287,9 @@ async def test_foreign_pinned_completion_spends_nothing_across_restarts(monkeypa
         clock = install_module_clock(monkeypatch, run_notifications)
         for _process in range(3):
             monkeypatch.setattr(process_registry, 'completion_queue', queue.Queue())
-            delegation._offered.clear()
-            delegation.restore_undelivered_completions(process_registry.completion_queue)
+            # A restart loses ALL process-local custody, including the offer lease.
+            delegation._reset_for_tests()
+            assert delegation.restore_undelivered_completions(process_registry.completion_queue) == 1
             await _run_async_watcher(runner, monkeypatch, clock, ticks=150)
         row = delegation.get_durable_delegation('foreign-1')
         assert (row['delivery_state'], row['delivery_attempts']) == ('pending', 0)
diff --git a/tests/tui_gateway/test_restored_delegation_transport.py b/tests/tui_gateway/test_restored_delegation_transport.py
index ba07d675333..fe2b8b08455 100644
--- a/tests/tui_gateway/test_restored_delegation_transport.py
+++ b/tests/tui_gateway/test_restored_delegation_transport.py
@@ -98,8 +98,24 @@ def test_startup_replay_requires_a_live_consumer(notification_env, monkeypatch,
     row = ad.get_durable_delegation(event["delegation_id"])
     assert (row["delivery_state"], row["delivery_attempts"]) == (("delivered", 1) if owns else ("pending", 0))
     if not owns:
-        # Refusal hands the offer back; the sweep's re-offer stays gated until a client attaches.
+        # Handback preserves the offer lease, then replays with the ownership gate intact.
         _orphan_owner(home)
         offered = queue.Queue()
-        assert ad.sweep_orphaned_completions(offered) == 1
-        assert offered.get_nowait()["startup_replay"] is True
+        now = time.time()
+        assert ad.sweep_orphaned_completions(offered, now=now) == 0
+        assert ad.sweep_orphaned_completions(offered, now=now + ad._CLAIM_LEASE_S + 1) == 1
+        replay = offered.get_nowait()
+        assert replay["startup_replay"] is True
+        server._notif_handle_ready(
+            "ui1", session, [replay], set(), process_registry, format_process_notification, None)
+        assert submit.call_count == 0
+        assert ad.get_durable_delegation(event["delegation_id"])["delivery_attempts"] == 0
+        # Once a real peer attaches, this same replay can be claimed exactly once.
+        session["transport"] = WSTransport(None, _loop)
+        server._notif_handle_ready(
+            "ui1", session, [replay], set(), process_registry, format_process_notification, None)
+        server._notif_handle_ready(
+            "ui1", session, [replay], set(), process_registry, format_process_notification, None)
+        assert submit.call_count == 1
+        row = ad.get_durable_delegation(event["delegation_id"])
+        assert (row["delivery_state"], row["delivery_attempts"]) == ("delivered", 1)
-- 
2.55.0

