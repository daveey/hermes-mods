From 5f7fa6b061ea3bea1da4914c2cc3591a0227cfdd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:31:23 +0000
Subject: [PATCH] workspace_source PR-2: source-release ls-remote env via
 build_subprocess_env (subprocess env guard)

---
 hermes_cli/kanban_source_cli.py | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_source_cli.py b/hermes_cli/kanban_source_cli.py
index 4229a7d903..f195216289 100644
--- a/hermes_cli/kanban_source_cli.py
+++ b/hermes_cli/kanban_source_cli.py
@@ -11,7 +11,6 @@
 from __future__ import annotations
 
 import argparse
-import os
 import sqlite3
 import subprocess
 import sys
@@ -37,9 +36,11 @@ def claim_refusal(conn: sqlite3.Connection, task_id: str) -> Optional[str]:
 def remote_head(url: str, branch: str, *, timeout: float = 30.0) -> Optional[str]:
     """``git ls-remote <url> <branch>`` (the manifest's branch ref), None when absent. Never prompts (batch env)."""
     from hermes_cli.kanban_source_clones import _BATCH_ENV
+    from tools.environments.local import build_subprocess_env
+    env = build_subprocess_env(scrub_secrets=False, inherit_profile_home=False, extra=_BATCH_ENV)
     out = subprocess.run(["git", "-c", "core.hooksPath=/dev/null", "ls-remote", url, branch], capture_output=True,
                          text=True, encoding="utf-8", errors="replace", timeout=timeout, stdin=subprocess.DEVNULL,
-                         check=False, env={**os.environ, **_BATCH_ENV})
+                         check=False, env=env)
     if out.returncode != 0:
         raise RuntimeError(f"git ls-remote {url} failed: {out.stderr.strip()[-200:]}")
     for line in out.stdout.splitlines():
-- 
