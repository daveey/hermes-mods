From 21acd343ff672213ecfabfc3ccf41c96a7337526 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 18:08:42 +0000
Subject: [PATCH] fix(routing): retain authorized class fallback on quota
 exhaustion [daveey]

---
 agent/turn_api_error.py                                  | 9 ++++++++-
 .../hermes_cli/test_kanban_worker_start_failure_cause.py | 8 ++++----
 2 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/agent/turn_api_error.py b/agent/turn_api_error.py
index 60ebc39cdab..797cecaa80b 100644
--- a/agent/turn_api_error.py
+++ b/agent/turn_api_error.py
@@ -148,9 +148,16 @@ def handle_api_error(
     )
 
     # A local quota refusal is not another provider response: rotating it would
-    # re-bench the last token and lose the original reset. Yield to the scheduler.
+    # re-bench the last token and lose the original reset.
     from agent.model_routing_unavailable import SubscriptionQuotaUnavailable
     if isinstance(api_error, SubscriptionQuotaUnavailable):
+        # Only this route's pool is exhausted. Class fallback retains the no-paid
+        # fence and exact pins; yield only when no authorized sibling remains.
+        if agent._try_activate_fallback(reason=classified.reason, reset_at=api_error.resets_at):
+            from agent.conversation_loop import _arm_fallback_restart
+            active_system_prompt = _arm_fallback_restart(agent, api_messages, active_system_prompt, _retry)
+            retry_count = compression_attempts = 0
+            return _verdict("break")
         return _verdict("return", max_retries_exhausted_result(
             agent, api_error, classified, attempts=retry_count, is_rate_limited=True,
             error_msg=str(api_error), api_kwargs=api_kwargs, api_messages=api_messages,
diff --git a/tests/hermes_cli/test_kanban_worker_start_failure_cause.py b/tests/hermes_cli/test_kanban_worker_start_failure_cause.py
index 348a953d56d..94463d3874a 100644
--- a/tests/hermes_cli/test_kanban_worker_start_failure_cause.py
+++ b/tests/hermes_cli/test_kanban_worker_start_failure_cause.py
@@ -12,7 +12,7 @@ def test_start_failure_books_a_redacted_one_line_cause(monkeypatch):
     from agent.model_routing import ModelRoutingError
     from gateway import session_kanban
     booked = []
-    monkeypatch.setattr(session_kanban, '_record_worker_result', lambda ctx, code, out: booked.append((code, out)))
+    monkeypatch.setattr(session_kanban, '_record_worker_result', lambda ctx, code, out, failure=None: booked.append((code, out)))
     frame = {'policy': {'kanban_json': json.dumps({'db': '/nonexistent', 'task_id': 't', 'run_id': 1})}}
     session_kanban.record_start_failure(frame, ModelRoutingError('Class selectors require provider auto;\nuse a concrete model'))
     (code, out), = booked
@@ -46,7 +46,7 @@ def test_worker_failure_after_the_turn_books_its_cause(monkeypatch):
     from agent.runtime_session_store import WorkerPersistenceError
     from gateway import session_kanban
     booked = []
-    monkeypatch.setattr(session_kanban, '_record_worker_result', lambda ctx, code, out: booked.append((code, out)))
+    monkeypatch.setattr(session_kanban, '_record_worker_result', lambda ctx, code, out, failure=None: booked.append((code, out)))
     frame = {'policy': {'kanban_json': json.dumps({'db': '/nonexistent', 'task_id': 't', 'run_id': 1})}}
     session_kanban.record_worker_failure(frame, WorkerPersistenceError('invalid_params'))
     assert booked == [(1, 'Worker failed: WorkerPersistenceError: invalid_params')]
@@ -56,7 +56,7 @@ def test_start_failure_is_not_booked_twice(monkeypatch):
     from agent.model_routing import ModelRoutingError
     from gateway import session_kanban
     booked = []
-    monkeypatch.setattr(session_kanban, '_record_worker_result', lambda ctx, code, out: booked.append(out))
+    monkeypatch.setattr(session_kanban, '_record_worker_result', lambda ctx, code, out, failure=None: booked.append(out))
     frame = {'policy': {'kanban_json': json.dumps({'db': '/nonexistent', 'task_id': 't', 'run_id': 1})}}
     exc = ModelRoutingError('boom')
     session_kanban.record_start_failure(frame, exc)
@@ -102,7 +102,7 @@ def test_managed_worker_main_books_the_cause_of_a_late_failure(monkeypatch):
         raise WorkerPersistenceError('invalid_params')
 
     monkeypatch.setattr(mw, 'execute', execute)
-    monkeypatch.setattr(session_kanban, '_record_worker_result', lambda ctx, code, out: booked.append(out))
+    monkeypatch.setattr(session_kanban, '_record_worker_result', lambda ctx, code, out, failure=None: booked.append(out))
     assert mw.main() == 1
     assert booked == ['Worker failed: WorkerPersistenceError: invalid_params']
     assert sent[-1] == 'error'
-- 
