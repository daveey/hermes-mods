From a2f093d04bd11032e7c638a9b2c8040916d8b86b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:30:59 +0000
Subject: [PATCH] fix(delegate): an unavailable default route no longer vetoes
 a per-task pin [daveey]

Upstream's backend routing (resolve_task_routes) resolved the default route's credentials for
every task before the fork's per-task model/provider pins were layered on, so a pinned task
was refused with 'Cannot resolve delegation provider anthropic' whenever the default had no
credentials: the merge lost 4961aff13f0 (resolve only the routes children actually use).
Pinned tasks now come back unresolved and resolve only their own route; a pinned batch is
still preflighted as a whole (a sibling whose used route fails refuses the call before spawn).
Red before: test_unavailable_default_does_not_block_explicit_provider; green after. The
resolver-call-order assertion is matched by content (backend routes resolve before pins).
---
diff --git a/tests/tools/test_delegate_per_task_model.py b/tests/tools/test_delegate_per_task_model.py
index 28ee36823219fd91e96a524acf417cc48228f3af..ecf95d7d2b5964599f6d92a0a55b7dc7eea2ede7 100644
--- a/tests/tools/test_delegate_per_task_model.py
+++ b/tests/tools/test_delegate_per_task_model.py
@@ -129,8 +129,14 @@ class TestDelegateToolPerTaskModel(unittest.TestCase):
             )
         self.assertEqual(models, ["z-ai/glm-5.3", "claude-sonnet-5-5"])
         self.assertEqual(providers, ["openrouter", "anthropic"])
-        self.assertEqual(seen[0]["provider"], "openrouter")
-        self.assertNotIn("provider", seen[1])
+        # Fork: upstream's delegation backends resolve the backend routes of unpinned tasks first and the
+        # pins after (tools.delegate_tool_routes.resolve_task_routes, then _apply_task_model_pins), so the
+        # resolver calls are matched by content, not call order. Each route resolves exactly once.
+        self.assertEqual(len(seen), 2)
+        pinned_cfg = [c for c in seen if c.get("model") == "z-ai/glm-5.3"]
+        default_cfg = [c for c in seen if c.get("model") == "claude-sonnet-5-5"]
+        self.assertEqual(pinned_cfg[0]["provider"], "openrouter")
+        self.assertNotIn("provider", default_cfg[0])
 
     def test_unavailable_default_does_not_block_explicit_provider(self):
         def resolve(*, requested, target_model):
diff --git a/tools/delegate_tool_routes.py b/tools/delegate_tool_routes.py
index a2dfcf3a5218ad536379493efbeb41feeee46ad2..d8f8d79e2d38872381fc227fecf2ab20e93bbc40 100644
--- a/tools/delegate_tool_routes.py
+++ b/tools/delegate_tool_routes.py
@@ -307,11 +307,15 @@ def _route_one(provider: DelegationProvider, declared: dict[str, dict[str, Any]]
 
 
 def resolve_task_routes(task_list: list[dict[str, Any]], config: Mapping[str, Any], parent_agent: Any,
-                        ) -> tuple[list[TaskRoute], Optional[str]]:
+                        unresolved: Optional[Any] = None) -> tuple[list[TaskRoute], Optional[str]]:
     """One :class:`TaskRoute` per task from the backend the session's ``delegate_task`` was built from (else
     ``delegation.backend``), or ``([], error)`` when that backend cannot run (fails closed, never another backend).
     A task the backend cannot route gets a route with ``error`` set; its siblings are unaffected. Identical routes
-    resolve credentials once per call (the default backend resolves exactly once)."""
+    resolve credentials once per call (the default backend resolves exactly once).
+
+    [daveey] ``unresolved(index)`` true marks a task whose credentials the caller resolves itself (a per-task
+    ``model``/``provider`` pin): its non-profile route comes back with empty ``creds`` and is never resolved here,
+    so an unused default route with missing credentials cannot veto the task's explicit route."""
     from agent.delegation_backends import pinned_backend
     if pinned := pinned_backend(parent_agent):
         config = {**config, "backend": pinned}
@@ -326,6 +330,11 @@ def resolve_task_routes(task_list: list[dict[str, Any]], config: Mapping[str, An
         try:
             route = _route_one(provider, declared, i, task, config)
             _check_backend_effort(i, route, config)
+            if unresolved is not None and not route.get("profile") and unresolved(i):
+                label = route.get("label") if isinstance(route.get("label"), str) else None
+                routes.append(TaskRoute({}, _with_inherited_fallback(route, config), route.get("reasoning_effort"),
+                                        None, label, provider.name))
+                continue
             routes.append(_route_to_task_route(route, parent_agent, cache, config, provider.name))
         except ValueError as exc:  # DelegationRouteError, the credential resolver's and the tier check's refusals
             routes.append(TaskRoute({}, {}, backend=provider.name, error=str(exc)))
