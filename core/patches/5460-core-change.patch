From 1f1bd2a3364f6974964e48a40b9caca3cb9a48d9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 08:33:04 +0000
Subject: [PATCH] [daveey] Preserve mandatory review pin without model
 provenance gate

Missing implementer model history is not a reason to reject a genuine review.
Assert that the mandatory pinned reviewer route still serves exactly its model
and provider, preserving disabled-provider and no-fallback controls.

Proof: tests/hermes_cli/test_kanban_mandatory_pin.py: 28 passed.
---
 tests/hermes_cli/test_kanban_mandatory_pin.py | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_mandatory_pin.py b/tests/hermes_cli/test_kanban_mandatory_pin.py
index 46218ba4c7..d999cbb0a6 100644
--- a/tests/hermes_cli/test_kanban_mandatory_pin.py
+++ b/tests/hermes_cli/test_kanban_mandatory_pin.py
@@ -124,10 +124,7 @@ def test_a_worker_that_serves_the_pin_claims_it_and_runs_exactly_that_model(
     worker.round()
     worker.tick()
     assert svc.board(BOARD)["leases"][tid]["holder"] == WORKER
-    if review_without_evidence:
-        # Pool pickup carries the pin, but cannot turn unknown authorship into independence.
-        assert _route(worker.conn, tid) == []
-        return
+    # Missing model attribution does not block a real review; the mandatory pin still must be served exactly.
     [route] = _route(worker.conn, tid)
     assert (route["model"], route["provider"]) == ("claude-opus-5-5", "anthropic"), route
     assert kb.get_task(worker.conn, tid).model_pin_mandatory == 1
-- 
