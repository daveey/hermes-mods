+import fs from 'node:fs/promises'
+import http from 'node:http'
+import type { AddressInfo } from 'node:net'
+import os from 'node:os'
+import path from 'node:path'
+
+import ts from 'typescript'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { destroyKeepaliveAgents, keepAliveAgent, sendWithRequestDeadline, startRequestDeadline } from './api-transport'
+import { fetchJsonWith, fetchPublicJsonWith } from './json-fetch'
+import * as tracing from './request-stages'
+
+const deps = { remoteHeaders: () => ({}), nativeHeaders: async () => null }
+const route = '/api/plugins/user-steps/requests'
+
+function capture() {
+  const rows: any[] = []
+  const buffer = new tracing.StageBuffer(async lines => { rows.push(...lines.trim().split('\n').map(line => JSON.parse(line))) })
+
+  return { rows, buffer }
+}
+
+async function serverFor(handler: http.RequestListener) {
+  const server = http.createServer(handler)
+  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve))
+  const base = `http://127.0.0.1:${(server.address() as AddressInfo).port}`
+
+  return { base, close: async () => {
+    server.closeAllConnections()
+    await new Promise<void>(resolve => server.close(() => resolve()))
+  } }
+}
+
+afterEach(() => { vi.restoreAllMocks(); destroyKeepaliveAgents() })
+
+describe('request-stage capture', () => {
+  it('executes the actual main dispatcher wrapper with trace and error identity intact', async () => {
+    const source = await fs.readFile(new URL('./main.ts', import.meta.url), 'utf8')
+    const ast = ts.createSourceFile('main.ts', source, ts.ScriptTarget.Latest, true)
+    const declaration = ast.statements.find(statement => ts.isFunctionDeclaration(statement) && statement.name?.text === 'handleHermesApiRequest')!
+    const { rows, buffer } = capture()
+    const failure = new Error('private')
+
+    const operation = vi.fn(async request => {
+      if (request.fail) { throw failure }
+
+      return 42
+    })
+
+    // Execute production declaration while isolating only Electron's heavy bootstrap.
+    const handle = new Function('withApiRequestStages', 'handleHermesApiRequestUntraced',
+      declaration.getText(ast) + '; return handleHermesApiRequest')(
+      (request, run) => tracing.withApiRequestStages(request, run, buffer), operation)
+
+    expect(await handle({ path: route })).toBe(42)
+    await expect(handle({ path: route, fail: true })).rejects.toBe(failure)
+    await buffer.flush()
+    expect(operation).toHaveBeenCalledTimes(2)
+    expect(rows.map(row => row.stage)).toEqual(['api_call', 'api_end', 'api_call', 'api_error'])
+  })
+
+  it('persists and rotates four bounded files using asynchronous IO', async () => {
+    const directory = await fs.mkdtemp(path.join(os.tmpdir(), 'request-stages-'))
+    const file = path.join(directory, 'capture.jsonl')
+
+    try {
+      const write = tracing.stageFileWriter(file, 60)
+
+      for (let i = 0; i < 40; i++) { await write(JSON.stringify({ seq: i }) + '\n') }
+      expect((await fs.readdir(directory)).sort()).toEqual(['capture.jsonl', 'capture.jsonl.1', 'capture.jsonl.2', 'capture.jsonl.3'])
+
+      for (const name of await fs.readdir(directory)) { expect((await fs.stat(path.join(directory, name))).size).toBeLessThanOrEqual(60) }
+      expect((await fs.readFile(file, 'utf8')).trim().split('\n').map(line => JSON.parse(line)).at(-1).seq).toBe(39)
+      // Reinitializing discovers the existing length rather than silently exceeding the cap.
+      const resumed = tracing.stageFileWriter(file, 60)
+      await resumed('{"seq":40}\n')
+      expect((await fs.stat(file)).size).toBeLessThanOrEqual(60)
+      const buffer = new tracing.StageBuffer(tracing.stageFileWriter(path.join(file, 'invalid')))
+      buffer.emit('lost')
+      await buffer.flush()
+      expect(buffer.ioLost).toBe(1)
+    } finally { await fs.rm(directory, { recursive: true, force: true }) }
+  })
+
+  it('records real JSON helper stages, header and logical gate wait without private data', async () => {
+    const { rows, buffer } = capture()
+    const real = tracing.requestStages
+    vi.spyOn(tracing, 'requestStages').mockImplementation((url, method) => real(url, method, buffer))
+    const ids: string[] = []
+
+    const server = await serverFor((req, res) => {
+      ids.push(String(req.headers['x-hermes-req-id']))
+      res.end('{"ok":true}')
+    })
+
+    try {
+      for (const fetch of [fetchJsonWith, (_deps, url) => fetchPublicJsonWith(_deps, url)]) {
+        const answer = await tracing.withApiRequestStages({ path: route + '?token=DO_NOT_LOG' }, async () => {
+          // Yield before fetch, as a real asynchronous dial/gate does.
+          await Promise.resolve()
+
+          return fetch(deps, server.base + route + '?token=DO_NOT_LOG', null)
+        }, buffer)
+
+        expect(answer).toEqual({ ok: true })
+      }
+
+      await buffer.flush()
+      expect(ids).toHaveLength(2)
+      expect(new Set(ids).size).toBe(2)
+
+      for (const id of ids) {
+        expect(id).toMatch(/^[a-f0-9]{32}$/)
+        const events = rows.filter(row => row.id === id)
+        const names = events.map(row => row.stage)
+
+        for (const stage of ['call', 'agent_queue', 'socket_assigned', 'connected', 'write_finished', 'response_start', 'response_end']) {
+          expect(names).toContain(stage)
+        }
+
+        expect(names.indexOf('socket_assigned')).toBeLessThan(names.indexOf('write_finished'))
+        expect(events.find(row => row.stage === 'response_end').bytes).toBe(11)
+        const call = rows.find(row => row.stage === 'api_call' && row.call_id === events[0].call_id)
+        expect(call.mono_ms).toBeLessThanOrEqual(events[0].mono_ms)
+      }
+
+      expect(JSON.stringify(rows)).not.toContain('DO_NOT_LOG')
+    } finally { await server.close() }
+  })
+
+  it('records Agent queue deadline before a socket and does not change POST replay policy', async () => {
+    const { rows, buffer } = capture()
+    const agent = keepAliveAgent(http, 1)
+    let arrived!: () => void
+    const firstArrived = new Promise<void>(resolve => { arrived = resolve })
+    let hits = 0
+    const server = await serverFor(() => { hits++; arrived() })
+    const first = http.get(server.base + route, { agent })
+    first.on('error', () => {})
+    await firstArrived
+
+    try {
+      const trace = tracing.requestStages(server.base + route, 'POST', buffer)!
+      const deadline = startRequestDeadline(50, Date.now, trace.deadline)
+
+      const error = await new Promise<Error>(resolve => {
+        sendWithRequestDeadline(deadline, () => http.request(server.base + route, { agent, method: 'POST' }),
+          { onError: resolve, observeRequest: trace.attach })
+      })
+
+      expect(error.message).toContain('Timed out connecting')
+      await buffer.flush()
+      const names = rows.filter(row => row.id === trace.id).map(row => row.stage)
+      expect(names).toContain('agent_queue')
+      expect(names).toContain('deadline')
+      expect(names).not.toContain('socket_assigned')
+      expect(hits).toBe(1)
+    } finally { first.destroy(); agent.destroy(); await server.close() }
+  })
+
+  it('does not duplicate an ambiguous mutation and assigns retries their own ids', async () => {
+    const { rows, buffer } = capture()
+    const real = tracing.requestStages
+    vi.spyOn(tracing, 'requestStages').mockImplementation((url, method) => real(url, method, buffer))
+    const ids: string[] = []
+
+    const server = await serverFor((req, res) => {
+      ids.push(String(req.headers['x-hermes-req-id']))
+      req.resume()
+      req.on('end', () => {
+        if (req.method === 'POST' || ids.length === 2) { req.socket.destroy() } else { res.end('{}') }
+      })
+    })
+
+    try {
+      await expect(fetchJsonWith(deps, server.base + route, null, { method: 'POST', body: { private: 'DO_NOT_LOG' } })).rejects.toThrow()
+      expect(ids).toHaveLength(1)
+      expect(await fetchJsonWith(deps, server.base + route, null)).toEqual({})
+      expect(ids).toHaveLength(3)
+      expect(new Set(ids).size).toBe(3)
+      await buffer.flush()
+      expect(JSON.stringify(rows)).not.toContain('DO_NOT_LOG')
+    } finally { await server.close() }
+  })
+
+  it('exposes overload and IO gaps while a writer is blocked, then recovers', async () => {
+    let release!: () => void
+    const blocked = new Promise<void>(resolve => { release = resolve })
+    const rows: any[] = []
+    let writes = 0
+
+    const buffer = new tracing.StageBuffer(async lines => {
+      if (++writes === 1) { await blocked; throw new Error('private') }
+      rows.push(...lines.trim().split('\n').map(line => JSON.parse(line)))
+    }, 2)
+
+    buffer.emit('first')
+    const pending = buffer.flush()
+    buffer.emit('second')
+    buffer.emit('third')
+    buffer.emit('drop')
+    expect(buffer.dropped).toBe(1)
+    release()
+    await pending
+    buffer.emit('coverage')
+    await buffer.flush()
+    expect(rows.at(-1)).toMatchObject({ stage: 'coverage', dropped: 1, io_lost: 1, seq: 5 })
+    expect(JSON.stringify(rows)).not.toContain('private')
+  })
+
+  it('skips private paths and preserves outer gate errors', async () => {
+    const { rows, buffer } = capture()
+    expect(tracing.requestStages('http://localhost/private?secret=x', 'GET', buffer)).toBeUndefined()
+    expect(tracing.requestStages('http://[invalid', 'GET', buffer)).toBeUndefined()
+    expect(await tracing.withApiRequestStages({ path: 'http://[invalid' }, async () => 7, buffer)).toBe(7)
+    expect(await tracing.withApiRequestStages({ path: '/private' }, async () => 2, buffer)).toBe(2)
+    const error = new Error('private')
+    await expect(tracing.withApiRequestStages({ path: route }, async () => { throw error }, buffer)).rejects.toBe(error)
+    await buffer.flush()
+    expect(rows.map(row => row.stage)).toEqual(['api_call', 'api_error'])
+  })
+})
diff --git a/apps/desktop/electron/request-stages.ts b/apps/desktop/electron/request-stages.ts
new file mode 100644
index 00000000000..0ef9e41fadf
--- /dev/null
+++ b/apps/desktop/electron/request-stages.ts
@@ -0,0 +1,192 @@
+import { AsyncLocalStorage } from 'node:async_hooks'
+// Local-only, bounded transport evidence. No URL queries, headers, bodies or error messages.
+import { randomUUID } from 'node:crypto'
+import fs from 'node:fs/promises'
+import type { ClientRequest } from 'node:http'
+import os from 'node:os'
+import path from 'node:path'
+
+import { resolveDesktopHermesHome } from './data-paths'
+
+const POLL_PATHS = new Set([
+  '/api/plugins/user-steps/requests', '/api/plugins/hub-sync/status',
+  '/api/plugins/kanban/board', '/api/sessions', '/api/health'
+])
+
+type Row = Record<string, string | number | boolean>
+
+/** Bounded admission while one async batch is writing. Never wait for IO in an HTTP callback. */
+export class StageBuffer {
+  private rows: Row[] = []
+  private writing = false
+  private scheduled = false
+  private seq = 0
+  dropped = 0
+  ioLost = 0
+  readonly boot = randomUUID().replaceAll('-', '')
+
+  constructor(private write: (lines: string) => Promise<void>, private capacity = 4096) {}
+
+  emit(stage: string, fields: Row = {}) {
+    const seq = ++this.seq
+
+    if (this.rows.length >= this.capacity) {
+      this.dropped++
+
+      return
+    }
+
+    this.rows.push({ ...fields, stage, seq, boot: this.boot, pid: process.pid,
+      utc_ms: Date.now(), mono_ms: performance.now(), dropped: this.dropped, io_lost: this.ioLost })
+
+    if (!this.scheduled && !this.writing) {
+      this.scheduled = true
+      setImmediate(() => { this.scheduled = false; void this.flush() })
+    }
+  }
+
+  async flush() {
+    if (this.writing) {
+      return
+    }
+
+    this.writing = true
+
+    try {
+      while (this.rows.length) {
+        const batch = this.rows.splice(0, 128)
+
+        try {
+          await this.write(batch.map(row => JSON.stringify(row)).join('\n') + '\n')
+        } catch {
+          // No raw exception text: paths and credentials may be in an IO error.
+          this.ioLost += batch.length
+        }
+      }
+    } finally {
+      this.writing = false
+    }
+  }
+}
+
+let sink: StageBuffer | undefined
+const calls = new AsyncLocalStorage<string>()
+
+function pollUrl(raw: string, base?: string): URL | undefined {
+  try {
+    const parsed = new URL(raw, base)
+
+    return POLL_PATHS.has(parsed.pathname) ? parsed : undefined
+  } catch {
+    // Leave malformed-input errors to the existing request validation boundary.
+    return undefined
+  }
+}
+
+/** Covers registry/gate/dial/coalescing waits before a request has an HTTP Agent. */
+export async function withApiRequestStages<T>(request: { path?: string; method?: string }, operation: () => Promise<T>, output?: StageBuffer): Promise<T> {
+  const parsed = pollUrl(request.path || '/', 'http://localhost')
+
+  if (!parsed) { return operation() }
+  const pathname = parsed.pathname
+  const callId = randomUUID().replaceAll('-', '')
+  const target = output || journal()
+  const fields = { call_id: callId, path: pathname }
+  target.emit('api_call', fields)
+
+  return calls.run(callId, async () => {
+    try {
+      const result = await operation()
+      target.emit('api_end', fields)
+
+      return result
+    } catch (error) {
+      target.emit('api_error', fields)
+      throw error
+    }
+  })
+}
+
+export function stageFileWriter(file: string, maxBytes = 16 * 1024 * 1024) {
+    let size = 0
+    let ready = false
+
+    return async (lines: string) => {
+      if (!ready) {
+        await fs.mkdir(path.dirname(file), { recursive: true })
+
+        try { size = (await fs.stat(file)).size } catch (error) {
+          if ((error as NodeJS.ErrnoException).code !== 'ENOENT') { throw error }
+        }
+
+        ready = true
+      }
+
+      if (size + Buffer.byteLength(lines) > maxBytes) {
+        for (let i = 2; i >= 0; i--) {
+          try { await fs.rename(i ? `${file}.${i}` : file, `${file}.${i + 1}`) } catch (error) {
+            if ((error as NodeJS.ErrnoException).code !== 'ENOENT') { throw error }
+          }
+        }
+
+        size = 0
+      }
+
+      await fs.appendFile(file, lines, { mode: 0o600 })
+      size += Buffer.byteLength(lines)
+    }
+}
+
+function journal(): StageBuffer {
+  if (!sink) {
+    const file = path.join(resolveDesktopHermesHome({ home: os.homedir() }), 'logs', `request-stages-desktop-${process.pid}.jsonl`)
+    sink = new StageBuffer(stageFileWriter(file))
+    const timer = setInterval(() => sink?.emit('coverage'), 1000)
+    timer.unref()
+  }
+
+  return sink
+}
+
+export function requestStages(url: string, method: string, output?: StageBuffer) {
+  const parsed = pollUrl(url)
+
+  if (!parsed) {
+    return undefined
+  }
+
+  const id = randomUUID().replaceAll('-', '')
+
+  const fields = { id, call_id: calls.getStore() || '', path: parsed.pathname,
+    method: /^(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS)$/.test(method) ? method : 'OTHER',
+    port: Number(parsed.port || (parsed.protocol === 'https:' ? 443 : 80)) }
+
+  const target = output || journal()
+  const emit = (stage: string, extras: Row = {}) => target.emit(stage, { ...fields, ...extras })
+  emit('call')
+
+  return {
+    id,
+    deadline: () => emit('deadline'),
+    attach(req: ClientRequest) {
+      emit('agent_queue')
+      req.once('socket', socket => {
+        emit('socket_assigned', { reused: req.reusedSocket })
+        const connected = () => emit('connected', { local_port: socket.localPort || 0, remote_port: socket.remotePort || 0 })
+
+        if (socket.connecting) { socket.once('connect', connected) } else { connected() }
+      })
+      // Node finish = flushed to the local socket, not acknowledgement by the hub.
+      req.once('finish', () => emit('write_finished'))
+      req.once('response', res => {
+        emit('response_start', { status: res.statusCode || 0 })
+        let bytes = 0
+        res.on('data', chunk => { bytes += chunk.length })
+        res.once('end', () => emit('response_end', { bytes }))
+        res.once('close', () => emit('response_close', { bytes, complete: res.complete }))
+      })
+      req.once('error', () => emit('error'))
+      req.once('close', () => emit('request_close'))
+    }
+  }
+}
