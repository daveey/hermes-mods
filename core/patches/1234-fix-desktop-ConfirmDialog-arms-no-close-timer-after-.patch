From a0aed8fa0465131076a9b042439ad116a7714637 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 11:50:39 +0000
Subject: [PATCH] fix(desktop): ConfirmDialog arms no close timer after unmount
 while onConfirm is pending

run() resumed after the await on an unmounted dialog and armed a fresh 600ms
timer that the unmount cleanup had already missed; it fired after the vitest
environment was torn down (window is not defined) in canonical-group-workspace.test.tsx.

Five whys: main CI uncaught ReferenceError <- onClose timer fired post-teardown <-
timer armed after unmount cleanup ran <- run() has no mounted guard after await
onConfirm <- earlier fix (969094e4d22) only covered unmount during the 600ms window,
and its test never unmounted during a pending confirm. Not caught: the workspace test
unmounts via parent state, passes locally since the timer rarely outlives teardown.
---
 .../ui/confirm-dialog-unmount.test.tsx        | 27 +++++++++++++++++++
 .../src/components/ui/confirm-dialog.tsx      | 12 +++++++++
 2 files changed, 39 insertions(+)

diff --git a/apps/desktop/src/components/ui/confirm-dialog-unmount.test.tsx b/apps/desktop/src/components/ui/confirm-dialog-unmount.test.tsx
index c2d1d587166..96c257f30cc 100644
--- a/apps/desktop/src/components/ui/confirm-dialog-unmount.test.tsx
+++ b/apps/desktop/src/components/ui/confirm-dialog-unmount.test.tsx
@@ -55,3 +55,30 @@ test('the close timer does not fire after unmount', async () => {
   expect(onClose).not.toHaveBeenCalled()
   vi.useRealTimers()
 })
+
+// Second hole in the same timer: unmounting while onConfirm is still pending.
+// The unmount cleanup above finds no timer yet. run() then resumes after the
+// await and arms a fresh 600ms timer on the dead tree, which is the leak that
+// failed main CI from canonical-group-workspace.test.tsx (the disband resolves
+// and the workspace unmounts the dialog before run() continues).
+test('no close timer is armed when the dialog unmounts while onConfirm is pending', async () => {
+  vi.useFakeTimers()
+  const onClose = vi.fn()
+
+  let resolveConfirm: () => void = () => {}
+  const onConfirm = vi.fn(() => new Promise<void>(resolve => { resolveConfirm = resolve }))
+
+  render(<ConfirmDialog confirmLabel="Delete" onClose={onClose} onConfirm={onConfirm} open title="Delete session" />)
+  fireEvent.click(screen.getByRole('button', { name: 'Delete' }))
+  await Promise.resolve()
+  expect(onConfirm).toHaveBeenCalled()
+
+  cleanup()
+  resolveConfirm()
+  await Promise.resolve()
+  await Promise.resolve()
+
+  vi.advanceTimersByTime(1000)
+  expect(onClose).not.toHaveBeenCalled()
+  vi.useRealTimers()
+})
diff --git a/apps/desktop/src/components/ui/confirm-dialog.tsx b/apps/desktop/src/components/ui/confirm-dialog.tsx
index 37f5a904617..ffc3d2fd96a 100644
--- a/apps/desktop/src/components/ui/confirm-dialog.tsx
+++ b/apps/desktop/src/components/ui/confirm-dialog.tsx
@@ -61,6 +61,7 @@ export function ConfirmDialog({
   const { t } = useI18n()
   const confirmRef = useRef<HTMLButtonElement>(null)
   const closeTimerRef = useRef<null | number>(null)
+  const unmountedRef = useRef(false)
   const [status, setStatus] = useState<'done' | 'idle' | 'saving'>('idle')
   const [error, setError] = useState<null | string>(null)
   const busy = status === 'saving' || status === 'done'
@@ -86,7 +87,13 @@ export function ConfirmDialog({
   // It happens on unmount only, and it clears the handle this component owns.
   // eslint-disable-next-line no-restricted-syntax
   useEffect(() => {
+    unmountedRef.current = false
+
     return () => {
+      // run() may still be awaiting onConfirm; it must not arm a new timer
+      // (or set state) once the dialog is gone.
+      unmountedRef.current = true
+
       if (closeTimerRef.current !== null) {
         window.clearTimeout(closeTimerRef.current)
         closeTimerRef.current = null
@@ -116,6 +123,11 @@ export function ConfirmDialog({
 
     try {
       await onConfirm()
+
+      if (unmountedRef.current) {
+        return
+      }
+
       setStatus('done')
       closeTimerRef.current = window.setTimeout(() => {
         closeTimerRef.current = null
-- 
