+def _tick_setup(monkeypatch, hub):
+    monkeypatch.setattr(ksc, "load_identity", lambda: ksc.Identity("http://unused", "synthetic", "hub"))
+    monkeypatch.setattr(ksc, "Hub", lambda *a, **kw: hub)
