+    rounds: list = [[]]
+    waits: list = []
+    monkeypatch.setattr(ksc, "load_identity", lambda: ksc.Identity("https://example.com", "test", "gateway"))
+    monkeypatch.setattr(ksc, "board_paths", lambda: boards)
+    monkeypatch.setattr(ksc.sync, "set_lease_client", lambda _: None)
