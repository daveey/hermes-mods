From 99aedab2aeaa271c4c1a669507b532b23fe7fd53 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 07:43:53 +0000
Subject: [PATCH] [daveey] fix(kanban): priority capture refuses snapshot page
 heads that decrease

_inventory checked each page head only against the first head and the
final head only against the last page head, so a malformed server that
returned page heads 1, 5, 2 with final 4 passed even though page 2 was
read above the final head that check_interval replays to. Refuse any
page head below the previous one; with the final >= last check this
bounds every page head by the final head.

Follow-up to the PR #1947 exact-head review nit (t_01a1d3d4a29dfdbd).
---
 hermes_cli/kanban_priority_prepare.py         |  7 ++-
 .../test_kanban_priority_page_heads.py        | 58 +++++++++++++++++++
 2 files changed, 63 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_priority_page_heads.py

diff --git a/hermes_cli/kanban_priority_prepare.py b/hermes_cli/kanban_priority_prepare.py
index a188df2bf7..9174a9e8a5 100644
--- a/hermes_cli/kanban_priority_prepare.py
+++ b/hermes_cli/kanban_priority_prepare.py
@@ -43,15 +43,18 @@ def _inventory(hub, board_id: str) -> list[dict]:
     """Read raw pages and validate their finite feed interval without clipping."""
     rows = []
     after = ""
-    head = None
+    head = last = None
     for _ in range(10000):
         page = hub.snapshot_page(board_id, "tasks", after=after)
         if page.get("table") != "tasks" or type(page.get("head")) is not int:
             raise ValueError("invalid canonical snapshot page")
         if head is None:
             head = page["head"]
-        if page["head"] < head:
+        # Heads never decrease: the final check below then bounds every page
+        # head, so check_interval's replay covers each page's read.
+        if last is not None and page["head"] < last:
             raise ValueError("canonical inventory changed; capture a new manifest")
+        last = page["head"]
         batch = page.get("rows")
         if not isinstance(batch, list) or type(page.get("more")) is not bool:
             raise ValueError("invalid canonical inventory")
diff --git a/tests/hermes_cli/test_kanban_priority_page_heads.py b/tests/hermes_cli/test_kanban_priority_page_heads.py
new file mode 100644
index 0000000000..afc0d786ba
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_priority_page_heads.py
@@ -0,0 +1,58 @@
+"""Capture/verify refuse snapshot page heads that ever decrease.
+
+``check_interval`` replays the feed from the first page head to the final
+head, so no snapshot page may have been read at a head above the final head.
+The hub head is a monotonic feed seq; a page head below an earlier page head
+(a malformed server) refuses even when it stays above the first head and the
+final head is above the last page head.
+"""
+import pytest
+
+from hermes_cli import kanban_priority_prepare as prepare
+from tests.hermes_cli.test_kanban_priority_feed import Busy
+
+ROWS = [{'id': 'a', 'priority': 10000, 'created_on': 'one', 'status': 'ready'},
+        {'id': 'b', 'priority': 50000, 'created_on': 'two', 'status': 'done'},
+        {'id': 'c', 'priority': 20000, 'created_on': 'one', 'status': 'ready'}]
+
+
+class ThreePages(Busy):
+    """Three one-row pages at the given heads, then the final read at ``final``."""
+
+    def __init__(self, heads, final=4):
+        super().__init__()
+        self.heads = heads
+        self.final = final
+
+    def snapshot_page(self, board, table, after='', limit=1000):
+        if limit == 1:
+            return {'table': 'tasks', 'head': self.final, 'rows': ROWS[:1], 'more': True, 'next': 'a'}
+        index = [''] + [r['id'] for r in ROWS]
+        i = index.index(after)
+        return {'table': 'tasks', 'head': self.heads[i], 'rows': ROWS[i:i + 1],
+                'more': i < 2, 'next': ROWS[i]['id']}
+
+
+def test_monotonic_page_heads_stay_accepted():
+    for heads in ([1, 2, 3], [1, 1, 1], [1, 3, 3], [1, 2, 4]):
+        manifest = prepare.capture(ThreePages(heads), board_id='board', exceptions=['b'])
+        assert [r['id'] for r in manifest['rows']] == ['a', 'c']
+        assert prepare.verify(ThreePages(heads), manifest, undo=True)['verified'] == 2
+
+
+@pytest.mark.parametrize('heads', [
+    pytest.param([1, 3, 2], id='decrease-above-first'),
+    pytest.param([1, 5, 2], id='middle-page-above-final'),
+    pytest.param([2, 3, 2], id='back-to-first'),
+])
+def test_non_monotonic_page_heads_refuse_capture_and_verify(heads):
+    with pytest.raises(ValueError, match='changed'):
+        prepare.capture(ThreePages(heads), board_id='board', exceptions=['b'])
+    manifest = prepare.capture(ThreePages([1, 2, 3]), board_id='board', exceptions=['b'])
+    with pytest.raises(ValueError, match='changed'):
+        prepare.verify(ThreePages(heads), manifest, undo=True)
+
+
+def test_page_head_above_final_head_refuses():
+    with pytest.raises(ValueError, match='changed'):
+        prepare.capture(ThreePages([1, 2, 5]), board_id='board', exceptions=['b'])
