diff --git a/hermes_cli/admission_fence.py b/hermes_cli/admission_fence.py
index 604f0a65ac..00c49d15bd 100644
--- a/hermes_cli/admission_fence.py
+++ b/hermes_cli/admission_fence.py
@@ -147,6 +147,45 @@ def clear_hold(home):
         (root / "holds" / "hermes-sync").unlink(missing_ok=True)
 
 
+# [daveey] Core-update pause request (t_01a1827558218fed). hermes-sync's drain window writes this JSON
+# file beside the hold ({"version": 1, "expires_at": <epoch s>, ...}) to ask turns the next backend can
+# auto-continue to end at their next step boundary. It counts only while the hold stands and before
+# expires_at, so a file a crashed drainer leaves behind never outlives its window. hermes-sync writes it
+# directly (no core call), so the format is the contract: keep it backward compatible.
+PAUSE_REQUEST = "pause-request"
+
+
+def pause_requested(home):
+    """Cheap boundary check: one stat when no request exists. Never raises."""
+    root = Path(home) / "core-update"
+    try:
+        (root / PAUSE_REQUEST).stat()
+    except OSError:
+        return False
+    try:
+        body = json.loads((root / PAUSE_REQUEST).read_text(encoding="utf-8"))
+        expires_at = float(body["expires_at"])
+    except (OSError, ValueError, TypeError, KeyError):
+        return False
+    try:
+        return expires_at > time.time() and is_held(root)
+    except OSError:
+        return False
+
+
+def request_pause(home, *, expires_at, pid=None):
+    root = Path(home) / "core-update"
+    root.mkdir(parents=True, exist_ok=True)
+    tmp = root / f".{PAUSE_REQUEST}.{os.getpid()}.tmp"
+    tmp.write_text(json.dumps({"version": 1, "pid": pid or os.getpid(), "requested_at": time.time(),
+                               "expires_at": float(expires_at)}) + "\n", encoding="utf-8")
+    os.replace(tmp, root / PAUSE_REQUEST)
+
+
+def clear_pause_request(home):
+    (Path(home) / "core-update" / PAUSE_REQUEST).unlink(missing_ok=True)
+
+
 def main():
     import argparse
 
diff --git a/tests/agent/test_step_boundary_pause.py b/tests/agent/test_step_boundary_pause.py
new file mode 100644
index 0000000000..8a9e353561
--- /dev/null
+++ b/tests/agent/test_step_boundary_pause.py
@@ -0,0 +1,159 @@
+"""[daveey] A core-update pause ends a turn only at a step boundary.
+
+The boundary is after every tool result of the step is appended and persisted, and before the next model
+call; never during a running tool or a model call. ``agent.step_boundary_pause`` (installed per turn by the
+Desktop/TUI gateway) is consulted there; a truthy reason ends the turn as an interrupt the gateway can
+auto-continue.
+"""
+
+from __future__ import annotations
+
+import threading
+import time
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+from run_agent import AIAgent
+
+
+def _tool_call(i: int) -> SimpleNamespace:
+    return SimpleNamespace(id=f"call_{i}", type="function",
+                           function=SimpleNamespace(name="web_search", arguments='{"query": "x"}'))
+
+
+def _tool_response(i: int) -> SimpleNamespace:
+    message = SimpleNamespace(content=None, reasoning_content=None, reasoning=None, tool_calls=[_tool_call(i)])
+    return SimpleNamespace(choices=[SimpleNamespace(message=message, finish_reason="tool_calls")],
+                           model="test/model", usage=None)
+
+
+def _final_response() -> SimpleNamespace:
+    message = SimpleNamespace(content="done", reasoning_content=None, reasoning=None, tool_calls=None)
+    return SimpleNamespace(choices=[SimpleNamespace(message=message, finish_reason="stop")],
+                           model="test/model", usage=None)
+
+
+def _tool_definition() -> dict:
+    return {"type": "function", "function": {
+        "name": "web_search", "description": "Search the web",
+        "parameters": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}}}
+
+
+def _make_agent(events: list, tool_seconds: float = 0.0, on_tool_start=None):
+    with (
+        patch("model_tools.get_tool_definitions", return_value=[_tool_definition()]),
+        patch("model_tools.check_toolset_requirements", return_value={}),
+        patch("agent.process_bootstrap.OpenAI"),
+        patch("agent.model_metadata.get_model_context_length", return_value=256_000),
+        patch("agent.context_compressor.get_model_context_length", return_value=256_000),
+    ):
+        agent = AIAgent(api_key="test", base_url="https://openrouter.ai/api/v1",
+                        model="test/model", quiet_mode=True, skip_context_files=True, skip_memory=True,
+                        max_iterations=10)
+    agent.client = MagicMock()
+    agent._cached_system_prompt = "You are helpful."
+    agent._use_prompt_caching = False
+    agent._disable_streaming = True
+    agent.tool_delay = 0
+    agent.save_trajectories = False
+    agent.max_compression_attempts = 1
+    compressor = MagicMock()
+    compressor.protect_first_n = 3
+    compressor.protect_last_n = 20
+    compressor.threshold_tokens = 999_999_999
+    compressor.context_length = 1_000_000_000
+    compressor.last_prompt_tokens = -1
+    compressor._verify_compaction_cleared_threshold = False
+    compressor.awaiting_real_usage_after_compression = False
+    compressor.should_compress.return_value = False
+    compressor.should_compress_info.return_value = (False, None)
+    compressor.should_compress_preflight.return_value = False
+    compressor.should_defer_preflight_to_real_usage.return_value = False
+    compressor.get_active_compression_failure_cooldown.return_value = None
+    compressor.select_context.return_value = None
+    compressor.get_automatic_compaction_status_message.return_value = ""
+    agent.compression_enabled = False
+    agent.context_compressor = compressor
+
+    def _execute(assistant_message, messages, *_args):
+        call = assistant_message.tool_calls[0]
+        events.append(("tool_start", call.id))
+        if on_tool_start is not None:
+            on_tool_start()
+        time.sleep(tool_seconds)
+        messages.append({"role": "tool", "name": call.function.name, "tool_call_id": call.id, "content": "ok"})
+        events.append(("tool_end", call.id))
+
+    agent._execute_tool_calls = _execute
+    return agent
+
+
+def _run(agent, responses, events):
+    agent.client.chat.completions.create.side_effect = responses
+
+    def _persist(messages, *_a, **_k):
+        events.append(("persist", [m.get("role") for m in messages]))
+
+    with (
+        patch.object(agent, "_flush_messages_to_session_db", return_value=True),
+        patch.object(agent, "_persist_session", side_effect=_persist),
+        patch.object(agent, "_save_trajectory"),
+        patch.object(agent, "_cleanup_task_resources"),
+    ):
+        return agent.run_conversation("do some tool work")
+
+
+def test_pause_requested_during_a_running_tool_ends_the_turn_after_it():
+    """The request lands while a 2-s tool runs: the tool finishes, its result is persisted, then the turn
+    ends with no further model call."""
+    events: list = []
+    requested = threading.Event()
+
+    def _hook():
+        events.append(("hook", requested.is_set()))
+        return "core_update_pause" if requested.is_set() else None
+
+    agent = _make_agent(events, tool_seconds=2.0, on_tool_start=requested.set)
+    agent.step_boundary_pause = _hook
+    started = time.monotonic()
+    result = _run(agent, [_tool_response(1), _tool_response(2), _final_response()], events)
+
+    assert time.monotonic() - started >= 2.0  # the tool ran to completion
+    assert agent.client.chat.completions.create.call_count == 1
+    assert result["interrupted"] is True
+    assert result["completed"] is False
+    assert result["paused_for_update"] == "core_update_pause"
+    names = [e[0] for e in events]
+    # Consulted only at the boundary: after the tool ended, never while it ran.
+    assert names.index("tool_end") < names.index("hook")
+    hook_at = names.index("hook")
+    # The tool result was persisted at the boundary, before the turn ended.
+    assert any(e[0] == "persist" and e[1][-1] == "tool" for e in events[hook_at:])
+
+
+def test_hook_declining_lets_the_turn_run_to_completion():
+    events: list = []
+    agent = _make_agent(events)
+    agent.step_boundary_pause = lambda: None
+    result = _run(agent, [_tool_response(1), _final_response()], events)
+    assert agent.client.chat.completions.create.call_count == 2
+    assert result["completed"] is True and result["final_response"] == "done"
+    assert not result.get("paused_for_update")
+
+
+def test_no_hook_is_unchanged():
+    events: list = []
+    agent = _make_agent(events)
+    result = _run(agent, [_tool_response(1), _final_response()], events)
+    assert result["completed"] is True
+    assert "paused_for_update" not in result
+
+
+def test_not_consulted_before_the_first_model_call():
+    """A turn that has not run a step yet has no boundary to pause at (nothing to continue from)."""
+    events: list = []
+    calls: list = []
+    agent = _make_agent(events)
+    agent.step_boundary_pause = lambda: calls.append(1) or None
+    _run(agent, [_final_response()], events)
+    assert calls == []
diff --git a/tests/hermes_cli/test_admission_fence_pause.py b/tests/hermes_cli/test_admission_fence_pause.py
new file mode 100644
index 0000000000..3992c64528
--- /dev/null
+++ b/tests/hermes_cli/test_admission_fence_pause.py
@@ -0,0 +1,53 @@
+"""[daveey] The core-update pause request: hermes-sync's drain window asks auto-continuable Desktop turns to
+pause at their next step boundary. The request is ``<root>/core-update/pause-request`` beside the admission
+hold, and it only counts while that hold stands and before its ``expires_at`` (scoped to one window)."""
+
+from __future__ import annotations
+
+import json
+import time
+
+from hermes_cli import admission_fence as af
+
+
+def _hold(root):
+    af.set_hold(root)
+
+
+def test_no_request_file_means_no_pause(tmp_path):
+    _hold(tmp_path)
+    assert af.pause_requested(tmp_path) is False
+
+
+def test_request_under_the_hold_is_active(tmp_path):
+    _hold(tmp_path)
+    af.request_pause(tmp_path, expires_at=time.time() + 60)
+    assert af.pause_requested(tmp_path) is True
+    body = json.loads((tmp_path / "core-update" / "pause-request").read_text())
+    assert body["version"] == 1 and body["expires_at"] > time.time()
+
+
+def test_request_without_the_hold_is_ignored(tmp_path):
+    """A stale file a crashed drainer left behind must not pause turns once its window is over."""
+    af.request_pause(tmp_path, expires_at=time.time() + 60)
+    assert af.pause_requested(tmp_path) is False
+
+
+def test_expired_request_is_ignored(tmp_path):
+    _hold(tmp_path)
+    af.request_pause(tmp_path, expires_at=time.time() - 1)
+    assert af.pause_requested(tmp_path) is False
+
+
+def test_unreadable_request_is_ignored(tmp_path):
+    _hold(tmp_path)
+    (tmp_path / "core-update" / "pause-request").write_text("{not json")
+    assert af.pause_requested(tmp_path) is False
+
+
+def test_clear_removes_the_request(tmp_path):
+    _hold(tmp_path)
+    af.request_pause(tmp_path, expires_at=time.time() + 60)
+    af.clear_pause_request(tmp_path)
+    assert af.pause_requested(tmp_path) is False
+    af.clear_pause_request(tmp_path)  # idempotent
diff --git a/tests/tui_gateway/test_update_pause.py b/tests/tui_gateway/test_update_pause.py
new file mode 100644
index 0000000000..aeb4315fc1
--- /dev/null
+++ b/tests/tui_gateway/test_update_pause.py
@@ -0,0 +1,294 @@
+"""[daveey] Core-update pause: a Desktop turn the restarted backend can auto-continue pauses at a step
+boundary when hermes-sync's drain window asks (``<root>/core-update/pause-request``), so a long turn no
+longer holds an update for a whole window. The turn keeps its interrupted-turn marker (``reason:
+core_update_pause``), releases its admission reservation, and the next backend continues it with a note
+that does not use up a crash-resume attempt. Turns that cannot be auto-continued are untouched.
+"""
+
+from __future__ import annotations
+
+import os
+import threading
+import time
+import types
+
+import pytest
+
+from hermes_cli import admission_fence as af
+from tui_gateway import server
+from tui_gateway import update_pause as up
+from tui_gateway.turn_marker import mark_turn_paused, read_turn_marker, record_turn_start
+
+CFG = {"desktop": {"auto_continue": {"enabled": True, "resume_on_startup": True, "freshness_minutes": 240,
+                                     "max_attempts": 2}}}
+
+
+class _InlineThread:
+    def __init__(self, target=None, daemon=None, args=(), kwargs=None, name=None):
+        self._target, self._args, self._kwargs = target, args, kwargs or {}
+
+    def start(self):
+        if self._target is not None:
+            self._target(*self._args, **self._kwargs)
+
+    def is_alive(self):
+        return False
+
+    def join(self, timeout=None):
+        return None
+
+
+def _session(agent=None, **extra):
+    return {"agent": agent if agent is not None else types.SimpleNamespace(), "session_key": "session-key",
+            "history": [], "history_lock": threading.RLock(), "history_version": 0, "running": False,
+            "attached_images": [], "image_counter": 0, "cols": 80, "slash_worker": None,
+            "show_reasoning": False, "tool_progress_mode": "all", "inflight_turn": None, **extra}
+
+
+@pytest.fixture()
+def home(monkeypatch, tmp_path):
+    monkeypatch.setattr(server, "_hermes_home", tmp_path)
+    monkeypatch.setattr(server, "_load_cfg", lambda: CFG)
+    return tmp_path
+
+
+def _request_pause(root):
+    af.set_hold(root)
+    af.request_pause(root, expires_at=time.time() + 120)
+
+
+# ── The boundary hook ────────────────────────────────────────────────────────────────────────────────
+
+
+def test_no_request_no_pause(home):
+    record_turn_start(home, "session-key", "the prompt")
+    assert up.boundary_pause_hook(_session(profile_home=str(home)), "session-key")() is None
+    assert "reason" not in read_turn_marker(home, "session-key")
+
+
+def test_resumable_turn_pauses_and_its_marker_survives_the_turn_end(home):
+    record_turn_start(home, "session-key", "the prompt")
+    session = _session(profile_home=str(home))
+    _request_pause(home)
+
+    assert up.boundary_pause_hook(session, "session-key")() == up.PAUSE_REASON
+
+    marker = read_turn_marker(home, "session-key")
+    assert marker["auto_continue"] is True
+    assert marker["reason"] == "core_update_pause"
+    assert marker["pauses"] == 1 and marker["attempts"] == 0
+    assert marker["prompt"] == "the prompt"
+    # The paused turn's terminal frame must not retire the marker: the next backend continues from it.
+    server._retire_turn_marker(session, "session-key")
+    assert read_turn_marker(home, "session-key") is not None
+
+
+@pytest.mark.parametrize("case", ["resume_on_startup_off", "auto_continue_disabled", "bot_room", "opted_out",
+                                  "attempts_used_up", "pauses_used_up", "stale", "no_marker"])
+def test_turn_that_cannot_be_auto_continued_is_untouched(home, monkeypatch, case):
+    cfg = {"desktop": {"auto_continue": dict(CFG["desktop"]["auto_continue"])}}
+    extra = {}
+    if case == "resume_on_startup_off":
+        cfg["desktop"]["auto_continue"]["resume_on_startup"] = False
+    if case == "auto_continue_disabled":
+        cfg["desktop"]["auto_continue"]["enabled"] = False
+    monkeypatch.setattr(server, "_load_cfg", lambda: cfg)
+    if case == "bot_room":
+        extra["source"] = "bot_room"
+    if case != "no_marker":
+        record_turn_start(home, "session-key", "the prompt", auto_continue=case != "opted_out",
+                          attempts=2 if case == "attempts_used_up" else 0,
+                          pauses=up.MAX_PAUSES if case == "pauses_used_up" else 0)
+    if case == "stale":
+        later = time.time() + 4 * 3600  # past the 240-min freshness window
+        monkeypatch.setattr(up, "_now", lambda: later)
+    _request_pause(home)
+
+    assert up.boundary_pause_hook(_session(profile_home=str(home), **extra), "session-key")() is None
+    marker = read_turn_marker(home, "session-key")
+    assert marker is None or "reason" not in marker
+
+
+# ── The whole turn ───────────────────────────────────────────────────────────────────────────────────
+
+
+@pytest.fixture()
+def turn_env(monkeypatch, tmp_path, home):
+    frames: list = []
+    watchers: list = []
+    monkeypatch.setattr(server.threading, "Thread", _InlineThread)
+    monkeypatch.setattr(server, "_emit", lambda event, sid, payload=None, *a, **k: frames.append((event, payload)))
+    monkeypatch.setattr(server, "_wire_callbacks", lambda sid: None)
+    monkeypatch.setattr(server, "_sync_agent_model_with_config", lambda sid, session: None)
+    monkeypatch.setattr(server, "_session_cwd", lambda session: str(tmp_path))
+    monkeypatch.setattr(server, "_register_session_cwd", lambda session: None)
+    monkeypatch.setattr(server, "_tts_stream_begin", lambda: None)
+    monkeypatch.setattr(server, "_sync_session_key_after_compress", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_get_usage", lambda agent: {})
+    monkeypatch.setattr(up, "start_in_place_watcher", lambda sid, session, key: watchers.append((sid, key)))
+    return types.SimpleNamespace(frames=frames, watchers=watchers)
+
+
+def test_paused_turn_releases_its_reservation_keeps_its_marker_and_says_so(turn_env, home):
+    seen = {}
+
+    def _run(message, **kwargs):
+        seen["reservations_in_turn"] = af.state(home)["reservations"]
+        _request_pause(home)  # the drain window asks while the turn is mid-step
+        reason = agent.step_boundary_pause()
+        return {"final_response": "", "messages": [], "interrupted": True, "completed": False,
+                "paused_for_update": reason}
+
+    agent = types.SimpleNamespace(session_id="session-key", run_conversation=_run, clear_interrupt=lambda: None)
+    session = _session(agent=agent, running=True, profile_home=str(home))
+    server._run_prompt_submit("rid", "ui-sid", session, "the prompt")
+
+    assert seen["reservations_in_turn"] == 1
+    assert af.state(home)["reservations"] == 0  # the drain can apply
+    marker = read_turn_marker(home, "session-key")
+    assert marker is not None and marker["reason"] == "core_update_pause" and marker["auto_continue"] is True
+    statuses = [p.get("text") for e, p in turn_env.frames if e == "status.update" and p]
+    assert up.PAUSE_STATUS_TEXT in statuses
+    (complete,) = [p for e, p in turn_env.frames if e == "message.complete"]
+    assert up.PAUSE_STATUS_TEXT in complete["text"]
+    assert session["running"] is False
+    assert agent.step_boundary_pause is None  # per-turn hook, never left on the cached agent
+    assert turn_env.watchers == [("ui-sid", "session-key")]
+
+
+def test_turn_without_a_request_ends_normally(turn_env, home):
+    def _run(message, **kwargs):
