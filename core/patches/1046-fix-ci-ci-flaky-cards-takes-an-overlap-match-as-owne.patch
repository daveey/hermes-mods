From d3850838b0d28dd47fd8241c276b3586b05b0f5e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:31:28 +0000
Subject: [PATCH] fix(ci): ci-flaky-cards takes an overlap match as owner only
 when its title or lead paragraph names this test and no other [daveey]

Live: during the state repair the overlap guard named t_01a189b2c78e9005, the card ABOUT
ci-flaky-cards dropping flakes, for all three tests its body lists in a table. A body that
quotes the id further down, or a lead naming several tests, is not the card that fixes it;
such matches now go to --distinct-from and the test gets its own deflake card.
---
 scripts/ci/flaky_kanban.py            | 10 ++++++++--
 tests/ci/test_flaky_kanban_overlap.py | 21 +++++++++++++++++++++
 2 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/scripts/ci/flaky_kanban.py b/scripts/ci/flaky_kanban.py
index 471490b59e7..f46daf03fa4 100644
--- a/scripts/ci/flaky_kanban.py
+++ b/scripts/ci/flaky_kanban.py
@@ -258,6 +258,7 @@ def _mentions(text: str, test_id: str) -> bool:
 
 
 _GH_JOB_URL = re.compile(r"(https://github\.com/[^/\s]+/[^/\s]+/actions/runs/\d+)/job/(\d+)")
+_TEST_ID = re.compile(r"tests/[\w./-]+\.py(?:::[\w\[\]./-]+)+")
 
 
 def _cites_job(text: str, url: str) -> bool:
@@ -367,11 +368,16 @@ class _Flake:
         return {**data, "id": card_id, "board": slug or "default", "gateway": gw} if data else None
 
     def owns(self, card: dict[str, Any]) -> bool:
-        """Open and about THIS test: its title/body names the test id, or its key is ``deflake:<id>[#n]``."""
+        """Open and about THIS test: its title or its body's lead paragraph names the test id and no other, or its
+        key is ``deflake:<id>[#n]``. A card that only quotes the id further down (a report about this cron that
+        lists several dropped tests, t_01a189b2c78e9005 itself) is not the card that fixes it."""
         if card.get("status") not in OPEN:
             return False
         key = str(card.get("idempotency_key") or "")
-        return (_mentions(f"{card.get('title') or ''}\n{card.get('body') or ''}", self.test_id)
+        lead = str(card.get("body") or "").strip().split("\n\n", 1)[0]
+        subject = f"{card.get('title') or ''}\n{lead}"
+        others = {t for t in _TEST_ID.findall(subject) if t != self.test_id and not self.test_id.startswith(t)}
+        return ((_mentions(subject, self.test_id) and not others)
                 or key == f"deflake:{self.test_id}" or key.startswith(f"deflake:{self.test_id}#"))
 
     def deliver(self, card: dict[str, Any]) -> tuple[bool | None, str]:
diff --git a/tests/ci/test_flaky_kanban_overlap.py b/tests/ci/test_flaky_kanban_overlap.py
index a191707f7a0..9ba25ec3882 100644
--- a/tests/ci/test_flaky_kanban_overlap.py
+++ b/tests/ci/test_flaky_kanban_overlap.py
@@ -287,3 +287,24 @@ def test_local_owner_about_the_test_gets_the_comment_read_back(env):
     assert any(RUN in c and TEST in c for c in env.kanban()["cards"]["t_owner"]["comments"])
     assert any(argv[:3] == ["--board", "ops", "comment"] for argv in env.kanban()["argv"])
     assert state["cards"][TEST] == {"card": "t_owner", "generation": 0, "board": "ops"}
+
+
+def test_a_card_that_only_quotes_the_test_id_among_others_is_not_its_owner(env):
+    """Live: the guard named t_01a189b2c78e9005 (a card ABOUT this cron) for all three tests its body
+    lists in a table. A lead paragraph naming several test ids is not the card that fixes this one."""
+    other = "tests/y.py::test_b"
+    # On another board here, so the default-board scan does not reach them and the refusal path decides.
+    env.card("t_report", "running", "ci-flaky-cards drops flaky tests when the overlap guard names an unrelated card",
+             f"Found while verifying the fix.\n\n| test | card |\n| {TEST} | t_1 |\n| {other} | t_2 |", board="ops")
+    env.card("t_pair", "ready", "triage", f"`{TEST}` and `{other}` both flake under load", board="ops")
+    env.refuse({"id": "t_report", "gateway": "hub", "board": "ops", "status": "running", "title": "r"},
+               {"id": "t_pair", "gateway": "hub", "board": "ops", "status": "ready", "title": "p"})
+    state = fk.load_state(env.tmp / "absent.json")
+
+    log = _file(env, state)
+
+    cards = env.kanban()["cards"]
+    assert cards["t_report"]["comments"] == [] and cards["t_pair"]["comments"] == []
+    new = [c for c in cards.values() if c["id"].startswith("t_new")]
+    assert len(new) == 1 and sorted(new[0]["distinct_from"]) == ["t_pair", "t_report"]
+    assert log == [f"opened {new[0]['id']} {TEST} (distinct from t_report, t_pair)"]
-- 
