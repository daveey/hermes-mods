From 9b6863cd14567fe1b0b78dd1cca77954557c2427 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 17:58:13 +0000
Subject: [PATCH] test(kanban): a local archive closes as closed_uncompleted,
 not unknown [daveey]

44f3ca1e39 made an owner-observed archive close the origin obligation as
closed_uncompleted: not unfinished, and never released or completed. The
local projection test from b47371bdf8 still expected archive to project
unknown, so main was red. A live local archive is not verified completion
evidence; it is a current owner close. Binding faults and a raw done status
still project unknown, and the ledger released flag stays 0.
---
 .../test_kanban_local_origin_projection.py         | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_local_origin_projection.py b/tests/hermes_cli/test_kanban_local_origin_projection.py
index 76b86e86e9..687d26d223 100644
--- a/tests/hermes_cli/test_kanban_local_origin_projection.py
+++ b/tests/hermes_cli/test_kanban_local_origin_projection.py
@@ -66,7 +66,19 @@ def test_local_unverified_terminal_or_binding_never_releases(world, board, monke
     if fault == 'missing_board':
         kb.kanban_db_path('default').rename(board / 'unavailable.db')
     row = projection(world)
-    assert row['status'] == 'unknown' and row['unfinished']
+    if fault == 'archive':
+        # A live local archive is owner-observed, so it closes the obligation as
+        # closed_uncompleted. It is not verified completion: the ledger stays
+        # unreleased, and the row is never done. Binding faults and a raw done
+        # status still project unknown.
+        assert row['status'] == 'archived' and row['unfinished'] is False and not row['stale']
+        assert row['closed_uncompleted'] is True and row['reported_status'] == 'archived'
+        with sqlite3.connect(world[0]) as conn:
+            assert conn.execute('SELECT released FROM origin_obligations').fetchone() == (0,)
+        assert ledger.obligations(
+            world[0], gateway='owner', profile='default', sessions=['s_current'])[0]['unfinished']
+    else:
+        assert row['status'] == 'unknown' and row['unfinished']
 
 
 def test_unreadable_local_owner_does_not_trust_fresh_terminal_replica(world, board, monkeypatch):
