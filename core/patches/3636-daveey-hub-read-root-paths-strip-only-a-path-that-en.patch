From adc335e3aa632f3c58a9d8a075256965619c7ffc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 15:48:41 +0000
Subject: [PATCH] [daveey] hub-read root paths: strip only a path that ends its
 shell word

Review 5877418508: the allow-list ended the match but not the shell word, so a quoted,
brace, $, backslash or glob remainder (logs/'..', logs/{..,x}, logs/$(echo ..)) hid a
'..' from _under_roots. Require a word-end lookahead; add the shapes as pin controls.
---
 hermes_cli/kanban_placement_coordination.py    |  7 ++++++-
 tests/hermes_cli/test_kanban_hub_read_roots.py | 13 +++++++++++++
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_placement_coordination.py b/hermes_cli/kanban_placement_coordination.py
index f729ce00af..31c40af584 100644
--- a/hermes_cli/kanban_placement_coordination.py
+++ b/hermes_cli/kanban_placement_coordination.py
@@ -100,7 +100,12 @@ _HUB_READ_SSH = re.compile(r"\bssh[ \t]+hermes-hub[ \t]+(?:" + "|".join(HUB_READ
                            re.IGNORECASE)
 # A Hermes state path (same roots as ``kanban_placement.HERMES_STATE_PATH``). The path is an allow-list of path
 # characters, so a shell operator glued to it (``&&``, ``;``, ``:``, ``|``, ``$(``) ends it and stays in the text.
-_STATE_PATH = re.compile(r"(?:~|/home/[^/\s]+)/\.hermes/([\w.@+%~/-]*)")
+# The match must also end the shell word: end of text, whitespace, a shell operator, or closing punctuation that is
+# itself followed by whitespace or the end. Otherwise a quoted, brace, ``$``, ``\`` or glob remainder (``logs/'..'``,
+# ``logs/{..,x}``, ``logs/$(echo ..)``) would hide a ``..`` from :func:`_under_roots` (review 5877418508).
+# ``%`` is literal in shell (``%2e%2e`` is a directory name, not ``..``).
+_STATE_PATH = re.compile(r"(?:~|/home/[^/\s]+)/\.hermes/([\w.@+%~/-]*)"
+                         r"(?=$|[\s&;|<>()]|[`'\",:!?)\]]+\.*(?:\s|$))")
 
 
 def hub_read_roots(cfg) -> tuple:
diff --git a/tests/hermes_cli/test_kanban_hub_read_roots.py b/tests/hermes_cli/test_kanban_hub_read_roots.py
index da84dd87e8..43616a0f6b 100644
--- a/tests/hermes_cli/test_kanban_hub_read_roots.py
+++ b/tests/hermes_cli/test_kanban_hub_read_roots.py
@@ -42,6 +42,9 @@ def test_declared_read_step_is_portable(attested):
     "read `~/.hermes/kanban/boards/x/kanban.db`.",
     "ssh hermes-hub grep X ~/.hermes/logs/hermes-sync.log.",
     "ssh hermes-hub cat ~/.hermes/config.yaml: check kanban.placement",
+    'ssh hermes-hub cat "~/.hermes/logs/x.log"',
+    "ssh hermes-hub tail '~/.hermes/logs/x.log'.",
+    "(evidence: ssh hermes-hub cat ~/.hermes/logs/x.log)",
 ])
 def test_other_hub_read_shapes_are_portable(attested, body):
     cfg, _, _ = attested
@@ -93,6 +96,16 @@ def test_malformed_roots_clear_nothing(attested, roots):
     "rm -rf ~/.hermes/logs/x/..",
     "rm -rf ~/.hermes/logs/.",
     "rm -rf ~/.hermes/logs/...",
+    # The path must end its shell word, or a quoted/brace/$/backslash/glob remainder hides `..` (review 5877418508).
+    "chmod -R 777 ~/.hermes/logs/'..'",
+    'chmod -R 777 ~/.hermes/logs/"../state.db"',
+    "chmod -R 777 ~/.hermes/logs/x'/../../state.db'",
+    "chmod -R 777 ~/.hermes/logs/{..,x}",
+    "chmod -R 777 ~/.hermes/logs/{x,..}/state.db",
+    "chmod -R 777 ~/.hermes/logs/$(echo ..)",
+    "chmod -R 777 ~/.hermes/logs/${D}",
+    "chmod -R 777 ~/.hermes/logs/\\..",
+    "chmod -R 777 ~/.hermes/logs/[.][.]",
 ])
 def test_controls_still_pin(attested, body):
     cfg, _, _ = attested
