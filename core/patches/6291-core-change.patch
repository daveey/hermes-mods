-        kb._append_event(board, tid, 'parent_held', {})
+        append_advisory(board, tid, advisory)
     assert guard.guard_hold_started_at(board, tid) == started
     assert guard.guard_hold_reason(board, tid) == 'active_pr'
     with kb.write_txn(board):
@@ -95,8 +126,8 @@
