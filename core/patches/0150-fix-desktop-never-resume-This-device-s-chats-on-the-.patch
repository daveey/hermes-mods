From 3eb91a3fa67f8ec11583ac2a500461112e3d0cac Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 19 Oct 2026 15:24:53 -0700
Subject: [PATCH] fix(desktop): never resume This device's chats on the
 selected remote gateway [daveey]

With a remote registry gateway selected (nous-1), the unified session list's
base is still the primary's own aggregate, returned with bare rows. The
renderer stamped them with the selected remote and resume sent session.resume
for local ids to nous-1, which materialized empty ghost rows (c48e05a9d0).
The project overview had the same hole: This device's tree, folded in as a
remote tree, kept its rows bare because the stamper skips 'local'.

- Electron tags the primary base rows of a registry-pinned aggregate with the
  primary id (primaryRowsOwnerTag), keeping explicit owners.
- mergeGatewayProjectTrees stamps 'local' explicitly on a remote tree.
---
diff --git a/apps/desktop/src/app/session/hooks/use-session-actions.owner-gateway.test.tsx b/apps/desktop/src/app/session/hooks/use-session-actions.owner-gateway.test.tsx
index d835622983de77198224e5979a703a66334c77bb..54aa015f6300ca6aed9d8bfccdfe10928e9983c8 100644
--- a/apps/desktop/src/app/session/hooks/use-session-actions.owner-gateway.test.tsx
+++ b/apps/desktop/src/app/session/hooks/use-session-actions.owner-gateway.test.tsx
@@ -76,7 +76,7 @@ type GatewayHandler = (method: string, params: Record<string, unknown>) => unkno
 /** Per-connection, per-method gateway mocks. `local` is the window primary
  *  (the ambient socket); every other id is a registry connection reached
  *  through requestGatewayForAgent. */
-function mockGateways(handlers: Record<string, GatewayHandler>) {
+function mockGateways(handlers: Record<string, GatewayHandler>, ambientConnection = 'local') {
   const calls: { connection: string; method: string; params: Record<string, unknown> }[] = []
 
   const dispatch = async (connection: string, method: string, params: Record<string, unknown> = {}) => {
@@ -91,7 +91,7 @@ function mockGateways(handlers: Record<string, GatewayHandler>) {
   }
 
   const ambient = vi.fn(
-    async (method: string, params?: Record<string, unknown>) => await dispatch('local', method, params)
+    async (method: string, params?: Record<string, unknown>) => await dispatch(ambientConnection, method, params)
   ) as unknown as <T>(method: string, params?: Record<string, unknown>) => Promise<T>
 
   vi.mocked(requestGatewayForAgent).mockImplementation(async (connectionId, _profile, method, params) =>
@@ -434,6 +434,41 @@ describe('resume routes by the session owner, not the selected gateway', () => {
     expect($activeConnectionId.get()).toBe('local')
   })
 
+  // Ghost-resume class [daveey]: with a remote gateway (nous-1) selected, the
+  // unified list still carries this Mac's own chats. Electron now names their
+  // owner (`local`) on the pinned aggregate; opening one must resume it here
+  // and send nothing to the selected remote, which would materialize an empty
+  // row for an id it never minted.
+  it('(e) opening a local row while a remote gateway is selected resumes ONLY on local', async () => {
+    const NOUS = 'skint-polycentrism'
+    $connectionsRegistry.set({
+      connections: [
+        { id: 'local', kind: 'local', label: 'This device' },
+        { id: NOUS, kind: 'remote', label: 'nous-1' }
+      ],
+      primary: 'local',
+      version: 2
+    } as never)
+    setConnection({ connectionId: NOUS, mode: 'remote', registryScoped: true } as never)
+    setSessions([storedSession({ connection_id: 'local', id: LOCAL_SESSION, profile: 'default' })])
+    vi.mocked(getLatestSessionMessages).mockResolvedValue({ ...TRANSCRIPT, session_id: LOCAL_SESSION } as never)
+
+    const gateways = mockGateways(
+      {
+        local: owningGateway([LOCAL_SESSION], 'rt-local'),
+        [NOUS]: owningGateway([], 'rt-nous')
+      },
+      NOUS
+    )
+
+    const resume = await mountResume(gateways.ambient)
+    await resume(LOCAL_SESSION, true)
+
+    expect(gateways.calls.filter(call => call.connection === NOUS)).toEqual([])
+    expect(gateways.resumesOn('local')).toHaveLength(1)
+    expect($activeConnectionId.get()).toBe('local')
+  })
+
   // The statusbar gateway switcher (use-statusbar-items.tsx StatusbarGatewaySwitcher
   // → connection-switcher.tsx) and the fleet profile rail ("All profiles on this
   // gateway") show the selected gateway in All-profiles mode too, so opening a
diff --git a/apps/desktop/src/store/gateway-project-merge.test.ts b/apps/desktop/src/store/gateway-project-merge.test.ts
index 68198650f346e94c006a2b9fdcf29ddae46c6cf1..d4710dea16855dfa13047355d2f024236eb025b0 100644
--- a/apps/desktop/src/store/gateway-project-merge.test.ts
+++ b/apps/desktop/src/store/gateway-project-merge.test.ts
@@ -16,6 +16,21 @@ const project = (over: Partial<SidebarProjectTree> & Pick<SidebarProjectTree, 'i
 })
 
 describe('mergeGatewayProjectTrees', () => {
+  // [daveey] With a remote gateway active, This device's tree arrives as a
+  // remote tree. A bare row there would resume on the ACTIVE remote (ghost row
+  // on nous-1), so `local` is stamped explicitly in a remote tree.
+  it("stamps This device's rows `local` when they arrive as another gateway's tree", () => {
+    const merged = mergeGatewayProjectTrees(
+      [project({ id: 'nous-home', label: 'Home', previewSessions: [row('n1', 10)] })],
+      [{ connectionId: 'local', projects: [project({ id: 'mbp-taxes', label: 'taxes', previewSessions: [row('t1', 5)] })] }],
+      3
+    )
+
+    const taxes = merged.find(node => node.label === 'taxes')
+
+    expect(taxes?.previewSessions?.map(s => [s.id, s.connection_id])).toEqual([['t1', 'local']])
+  })
+
   it('returns the base tree untouched when no remote answered', () => {
     const base = [project({ id: 'a', label: 'hermes' })]
 
diff --git a/apps/desktop/src/store/gateway-project-merge.ts b/apps/desktop/src/store/gateway-project-merge.ts
index 6bb00a565424782b3b5807545ae87673e823f27a..660dc25810931b12fbb43b57417bf98ac85e4897 100644
--- a/apps/desktop/src/store/gateway-project-merge.ts
+++ b/apps/desktop/src/store/gateway-project-merge.ts
@@ -26,17 +26,23 @@ const sessionRecency = (session: SessionInfo): number => Number(session.last_act
 const projectKey = (project: SidebarProjectTree): string =>
   project.isNoProject ? '\u0000home' : `label:${project.label.trim().toLowerCase()}`
 
+// A remote tree is never the active gateway's, so every row in it names its
+// owner — `local` included: when This device is not the active gateway a bare
+// row would resume on the active remote, which never minted it. [daveey]
+const stampOwner = (sessions: SessionInfo[], connectionId: string): SessionInfo[] =>
+  connectionId === 'local'
+    ? sessions.map(session => (session.connection_id?.trim() ? session : { ...session, connection_id: 'local' }))
+    : stampRowsWithOwningConnection(sessions, connectionId)
+
 function stampTree(project: SidebarProjectTree, connectionId: string): SidebarProjectTree {
   return {
     ...project,
-    ...(project.previewSessions
-      ? { previewSessions: stampRowsWithOwningConnection(project.previewSessions, connectionId) }
-      : {}),
+    ...(project.previewSessions ? { previewSessions: stampOwner(project.previewSessions, connectionId) } : {}),
     repos: (project.repos ?? []).map(repo => ({
       ...repo,
       groups: repo.groups.map(group => ({
         ...group,
-        sessions: stampRowsWithOwningConnection(group.sessions, connectionId)
+        sessions: stampOwner(group.sessions, connectionId)
       }))
     }))
   }
