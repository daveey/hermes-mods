From d4b9e5939b397e79a07b1c2a446daf3d62c43caa Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 26 Nov 2026 03:41:57 +0000
Subject: [PATCH 6542] Usage-accounting gate and pool pickup budgets

Public mirror of source commit d4b9e5939b397e79a07b1c2a446daf3d62c43caa.

---
diff --git a/hermes_cli/kanban_worker_node.py b/hermes_cli/kanban_worker_node.py
index 51a9d6e3ff2..c1b87f39a69 100644
--- a/hermes_cli/kanban_worker_node.py
+++ b/hermes_cli/kanban_worker_node.py
@@ -627,6 +627,7 @@
         tid: ("parents_incomplete", "a parent is not done") for tid in mine - {c["id"] for c in listed}}
     picked: list[str] = []
     free = 0  # guard-held copies take no budget: they `continue` before room.take
+    debt_free = 0  # usage-debt copies (``_usage_pending``) take no budget either, in their own slots
     from hermes_cli.kanban_admission_pools import PoolBudget, row_class
     room = PoolBudget(limit.regular, limit.priority, limit.limit) if isinstance(limit, PoolBudget) else \
         PoolBudget(limit, 0)  # an int is a classless budget; a hub's pool budget never copies unstartable work
@@ -656,11 +657,16 @@
             hold = debt
         if hold is not None:
             # A debt copy is not kept by evict (no guard holds it), so it is re-copied each tick, never
-            # remembered: the recheck window would evict it and leave its local guards unrun.
-            if held is not None and free < kph.FREE_PER_TICK and (
-                    debt is not None or not kph.recently_copied(card["id"], hold[1])):
-                if debt is None:
-                    held[card["id"]] = hold[1]
+            # remembered: the recheck window would evict it and leave its local guards unrun. Debts get their
+            # own FREE_PER_TICK slots: sharing the guard-hold slots let always-recopied debts ranked first
+            # crowd a guard-held copy out of every tick (review of 19bdb081, PR #4496).
+            if debt is not None:
+                if held is not None and debt_free < kph.FREE_PER_TICK:
+                    picked.append(card["id"])
+                    debt_free += 1
+                    continue
+            elif held is not None and free < kph.FREE_PER_TICK and not kph.recently_copied(card["id"], hold[1]):
+                held[card["id"]] = hold[1]
                 picked.append(card["id"])
                 free += 1
                 continue
diff --git a/tests/hermes_cli/test_kanban_pickup_usage_pending.py b/tests/hermes_cli/test_kanban_pickup_usage_pending.py
index 959da71f743..9ae8f794097 100644
--- a/tests/hermes_cli/test_kanban_pickup_usage_pending.py
+++ b/tests/hermes_cli/test_kanban_pickup_usage_pending.py
@@ -83,3 +83,20 @@
         assert wn._usage_pending(replica, card) is None
     finally:
         replica.close()
+
+
+def test_debts_do_not_take_the_guard_hold_slots(gws, imports):
+    """Review of 19bdb081: debts sharing the guard-hold slots crowded a guard-held copy out of every tick."""
+    from hermes_cli import kanban_pickup_held as kph
+    from tests.hermes_cli.test_kanban_pickup_held_budget import _held_on_board
+    kph.reset()
+    hub, worker = gws
+    debts = [_indebted(hub, title=f"debt {i}", priority=1000 - i, runs_on=PIN)
+             for i in range(kph.FREE_PER_TICK + 2)]
+    held = _held_on_board(hub, 0, runs_on=PIN)
+    worker.round()
+    worker.enter()
+    picked = wn.pickup(worker.conn, budget=1)
+    assert held in picked
+    assert len(set(picked) & set(debts)) == kph.FREE_PER_TICK
+    kph.reset()
-- 
