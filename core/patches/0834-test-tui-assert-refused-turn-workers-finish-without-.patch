From eae9120eebaa060c10702b0a17a83a544326e54e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 23:27:23 +0000
Subject: [PATCH] test(tui): assert refused-turn workers finish without errors
 [daveey]

---
 tests/tui_gateway/test_bot_live_owner_delivery.py | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_bot_live_owner_delivery.py b/tests/tui_gateway/test_bot_live_owner_delivery.py
index 0cabcd7644..3778ca3eae 100644
--- a/tests/tui_gateway/test_bot_live_owner_delivery.py
+++ b/tests/tui_gateway/test_bot_live_owner_delivery.py
@@ -25,9 +25,20 @@ def test_refused_input_commits_failed_mailbox_receipt(tmp_path):
     session = dict(agent=agent, session_key="chat", history_lock=threading.RLock(), running=True)
     retired = []
     noop = lambda *args, **kwargs: None
+    worker_errors = []
+    # server installs a process-wide excepthook during the worker's lazy import;
+    # capture at the worker boundary rather than relying on that mutable hook.
+    def start_work(target, **kwargs):
+        def run():
+            try:
+                target()
+            except BaseException as exc:
+                worker_errors.append(exc)
+        return _start_session_work(run, **kwargs)
+
     submit = rebind(prompt_turn._run_admitted_prompt, {
         "threading": threading, "time": time, "logger": logging.getLogger(__name__),
-        "_start_session_work": _start_session_work,
+        "_start_session_work": start_work,
         "_sessions_lock": threading.RLock(), "_sessions": {},
         "_admit_prompt_turn": lambda *args: ([], agent),
         "_session_profile_runtime_scope": lambda session: contextlib.nullcontext(),
@@ -37,6 +48,7 @@ def test_refused_input_commits_failed_mailbox_receipt(tmp_path):
         "_record_turn_marker": lambda *args, **kwargs: "marker",
         "_prepare_turn_input": lambda *args: None,
         "_release_turn_scopes": noop, "_post_turn_housekeeping": noop,
+        "_rearm_carried_pause_watcher": noop,
         "_clear_inflight_turn": noop,
         # Hosted room member sessions drop their bot_room slot at turn end (#106847); a canonical chat is not one.
         "_release_hosted_room_turn_slot": noop,
@@ -55,6 +67,7 @@ def test_refused_input_commits_failed_mailbox_receipt(tmp_path):
     # soon as it ends, and a timeout here would strand a half-imported module that errors every later fixture.
     session["_run_thread"].join(timeout=180)
     assert not session["_run_thread"].is_alive()
+    assert not worker_errors, [str(error) for error in worker_errors]
     assert mailbox.read_delivery_result(tmp_path, queued["id"])["status"] == "failed"
     assert retired and session["running"] is False
 
-- 
