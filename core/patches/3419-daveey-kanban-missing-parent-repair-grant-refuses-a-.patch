-    ev = conn.execute("SELECT payload FROM task_events WHERE task_id = ? AND kind = 'blocked' "
-                      "ORDER BY id DESC LIMIT 1", (target_id,)).fetchone()
-    try:
-        payload = json.loads(ev[0] or "{}") if ev else {}
