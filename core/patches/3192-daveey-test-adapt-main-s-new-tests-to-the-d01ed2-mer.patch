diff --git a/tests/gateway/test_local_review_without_cached_agent.py b/tests/gateway/test_local_review_without_cached_agent.py
index 7036df8f9f..c456392531 100644
--- a/tests/gateway/test_local_review_without_cached_agent.py
+++ b/tests/gateway/test_local_review_without_cached_agent.py
@@ -71,8 +71,10 @@ def test_local_review_reviews_the_stored_conversation_once_the_cached_agent_is_g
         assert 'Review started' in json.dumps(result), (focus, result)
 
         def reviewer(request):
-            # The reviewer's first user turn is the context the command passes, then its goal.
-            return any(str(m.get('content') or '').endswith('\n\nTASK:\nReview: ' + focus) for m in request.get('messages', []))
+            # The reviewer's first user turn is the context the command passes, then its goal, then the
+            # fork's private-scratch note on a fresh child (the excerpt can quote earlier ones). [daveey]
+            return any(str(m.get('content') or '').rsplit('\n\nPRIVATE SCRATCH: ', 1)[0].endswith('\n\nTASK:\nReview: ' + focus)
+                       for m in request.get('messages', []))
         await async_wait_until(lambda: any(reviewer(r) for r in peer.requests[before:]), timeout=45,
                                what=f'the {focus} reviewer reaching the model')
         request = next(r for r in peer.requests[before:] if reviewer(r))
diff --git a/tests/gateway/test_session_subagent_live.py b/tests/gateway/test_session_subagent_live.py
index ea22d05cc2..03fb058072 100644
--- a/tests/gateway/test_session_subagent_live.py
+++ b/tests/gateway/test_session_subagent_live.py
@@ -40,7 +40,9 @@ def test_a_running_child_shows_its_rows_so_far(receipt):
         reply = receipt[name]
         assert reply['available'] and reply['running'], (name, reply)
         # The pending tool-call turn has no text, so the display rows hold only the goal until it ends.
-        assert _shown(reply)[0] == ('user', goal) and not any(m['role'] == 'tool' for m in reply['rows']), reply
+        # The fork's private-scratch note follows the goal on a fresh child's first turn. [daveey]
+        role, text = _shown(reply)[0]
+        assert (role, text.split('\n\nPRIVATE SCRATCH: ')[0]) == ('user', goal) and not any(m['role'] == 'tool' for m in reply['rows']), reply
 
 
 def test_the_cursor_then_brings_the_result_and_the_answer(receipt):
