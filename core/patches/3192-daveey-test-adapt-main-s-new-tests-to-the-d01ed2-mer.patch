From d5c4c43ba14c29564e36e36b93b824908095cee0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 16:33:53 +0000
Subject: [PATCH] [daveey] test: adapt main's new tests to the d01ed2 merge
 (claimed admissions, resumes_parent, private-scratch note)

- test_kanban_stale_block_ask / test_kanban_wake_fold: execute_admission runs a CLAIMED row
  (upstream fences the turn by the claim's generation); claim via tests.gateway.session_claims.
- test_completion_note_turn_lease / test_completion_admission_reconcile: upstream runs an unviewed
  final result as the parent's turn (resumes_parent); these cover the note path, so keep it a note.
- test_session_subagent_live / test_local_review_without_cached_agent: the fork's PRIVATE SCRATCH
  note now follows a fresh child's goal in its first user turn.
---
 tests/gateway/test_completion_admission_reconcile.py    | 9 +++++++++
 tests/gateway/test_completion_note_turn_lease.py        | 9 +++++++++
 tests/gateway/test_kanban_stale_block_ask.py            | 3 ++-
 tests/gateway/test_kanban_wake_fold.py                  | 4 +++-
 tests/gateway/test_local_review_without_cached_agent.py | 6 ++++--
 tests/gateway/test_session_subagent_live.py             | 4 +++-
 6 files changed, 30 insertions(+), 5 deletions(-)

diff --git a/tests/gateway/test_completion_admission_reconcile.py b/tests/gateway/test_completion_admission_reconcile.py
index badbfb96bb..b314b10cc0 100644
--- a/tests/gateway/test_completion_admission_reconcile.py
+++ b/tests/gateway/test_completion_admission_reconcile.py
@@ -23,6 +23,15 @@ def _no_delegations():
     delegation._reset_for_tests()
 
 
+@pytest.fixture(autouse=True)
+def _completion_is_a_note(monkeypatch):
+    # Upstream runs an unviewed final result as the parent's turn (``resumes_parent``,
+    # test_unviewed_completion_resumes_parent.py). These cases cover the note path (a cron result, a
+    # chat the user closed), so keep the outcome a note.
+    import tools.process_registry_notifications as notifications
+    monkeypatch.setattr(notifications, 'completion_resumes_parent', lambda evt: False)
+
+
 def _target(runner, authority, ref):
     return runner.session_store.lookup_by_session_key(authority.sessions[ref.session_id].route).session_id
 
diff --git a/tests/gateway/test_completion_note_turn_lease.py b/tests/gateway/test_completion_note_turn_lease.py
index f9ec285445..2ec30a0ce6 100644
--- a/tests/gateway/test_completion_note_turn_lease.py
+++ b/tests/gateway/test_completion_note_turn_lease.py
@@ -23,6 +23,15 @@ def _no_delegations():
     delegation._reset_for_tests()
 
 
+@pytest.fixture(autouse=True)
+def _completion_is_a_note(monkeypatch):
+    # Upstream runs an unviewed final result as the parent's turn (``resumes_parent``,
+    # test_unviewed_completion_resumes_parent.py). These cases cover the note path (a cron result, a
+    # chat the user closed), so keep the outcome a note.
+    import tools.process_registry_notifications as notifications
+    monkeypatch.setattr(notifications, 'completion_resumes_parent', lambda evt: False)
+
+
 def _target(runner, authority, ref):
     return runner.session_store.lookup_by_session_key(authority.sessions[ref.session_id].route).session_id
 
diff --git a/tests/gateway/test_kanban_stale_block_ask.py b/tests/gateway/test_kanban_stale_block_ask.py
index 36ec7be0c5..cfec901f91 100644
--- a/tests/gateway/test_kanban_stale_block_ask.py
+++ b/tests/gateway/test_kanban_stale_block_ask.py
@@ -72,7 +72,8 @@ async def _deliver_later(tmp_path, monkeypatch, then):
         seen.append(event.text)
         return 'ok'
     monkeypatch.setattr(runner, '_handle_message', turn)
-    await execute_admission(authority, ref, row)
+    from tests.gateway.session_claims import claim
+    await execute_admission(authority, ref, claim(authority, ref, row))
     assert seen, 'the queued wake never ran as a turn'
     return text, seen[0]
 
diff --git a/tests/gateway/test_kanban_wake_fold.py b/tests/gateway/test_kanban_wake_fold.py
index fa0ec273bc..389baff175 100644
--- a/tests/gateway/test_kanban_wake_fold.py
+++ b/tests/gateway/test_kanban_wake_fold.py
@@ -290,7 +290,9 @@ async def _drain(authority, row, monkeypatch):
         return 'ok'
     monkeypatch.setattr(authority.runner, '_handle_message', turn)
     descriptor = kanban_wake_fold._descriptor(row['payload'])
-    await execute_admission(authority, SessionRef(authority.profile_id, descriptor['owner']), row)
+    from tests.gateway.session_claims import claim
+    ref = SessionRef(authority.profile_id, descriptor['owner'])
+    await execute_admission(authority, ref, claim(authority, ref, row))
     assert seen, 'the queued wake never ran as a turn'
