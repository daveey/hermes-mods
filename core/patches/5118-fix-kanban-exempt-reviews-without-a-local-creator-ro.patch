From 4a71c55062784696c40270aa9bbb420339b768b1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 09:13:02 +0000
Subject: [PATCH] fix(kanban): exempt reviews without a local creator row
 [daveey]

Allow gate-exempt reviews when the creating card has no local row,
unless a detector creator or idempotency namespace identifies the filing.
Keep gate-held local creators gated and preserve alarm/urgent handling.

The no-creator-ID chat case was already ungated. The regression is a
truthy creator ID with no local row; pin both cases and both detector
signals, including their unresolved-creator variants.

Proof: unchanged origin/main 4990c8adab26fbe99e535c3ed148101d85bf62cc
fails the unresolved-row chat case (1 failed, 3 passed). All four lane
consumer test files pass after the fix; full scripts/check passes.

Implemented-by: gpt-6.1-sol (openai-codex)
---
 hermes_cli/kanban_lanes.py            |  6 +++++-
 tests/hermes_cli/test_kanban_lanes.py | 23 +++++++++++++++++++++++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_lanes.py b/hermes_cli/kanban_lanes.py
index b61ae04a5c..a91fa319e5 100644
--- a/hermes_cli/kanban_lanes.py
+++ b/hermes_cli/kanban_lanes.py
@@ -342,7 +342,11 @@ def _gated(conn, pol: Policy, lane_name: str, opts: dict) -> bool:
     if any(p.search(title) for p in lane.gate_exempt):
         # Review and land work of an admitted card must be able to finish it.
         row = _creator_row(conn, opts)
-        if row is not None and not (row["status"] == "triage" and row["block_kind"] == GATE_KIND):
+        if row is None:
+            # Chat-filed reviews have no local creator row; detectors still need admission.
+            if opts.get("created_by") not in lane.creators and not _key_matches(lane, key):
+                return False
+        elif not (row["status"] == "triage" and row["block_kind"] == GATE_KIND):
             return False
     return True
 
diff --git a/tests/hermes_cli/test_kanban_lanes.py b/tests/hermes_cli/test_kanban_lanes.py
index 0d3619e1e3..6afff9a4e7 100644
--- a/tests/hermes_cli/test_kanban_lanes.py
+++ b/tests/hermes_cli/test_kanban_lanes.py
@@ -146,6 +146,29 @@ def test_review_card_of_admitted_creator_skips_gate_but_not_of_held_one(conn, co
     assert _task(conn, review2)["status"] == "triage"
 
 
+@pytest.mark.parametrize("creator", [None, "t_eeeeee0000000002"])
+def test_chat_exact_head_review_without_creator_row_skips_gate(conn, configured, creator):
+    configured({**LANES, "hermes": {**LANES["hermes"], "gate_exempt": ["independent.*review"]}})
+    opts = {"title": "Independent exact-head review PR #1", "created_by": "agent",
+            "creator_task_id": creator}
+    assert lanes._creator_row(conn, opts) is None
+    status, tenant, decision = lanes.initial_state(conn, [], "ready", False, "hermes", opts)
+    assert (status, tenant, decision.gated, decision.would_gate) == ("ready", "hermes", False, False)
+    assert lanes.admitted_today(conn, "hermes") == 0
+
+
+@pytest.mark.parametrize("creator", [None, "t_eeeeee0000000002"])
+@pytest.mark.parametrize("detector", [{"created_by": "self-heal"},
+                                      {"idempotency_key": "ci-main-watch:review"}])
+def test_detector_exact_head_review_without_creator_row_stays_gated(conn, configured, detector, creator):
+    configured({**LANES, "hermes": {**LANES["hermes"], "gate_exempt": ["independent.*review"]}})
+    opts = {"title": "Independent exact-head review PR #1", "created_by": "agent",
+            "creator_task_id": creator, **detector}
+    assert lanes._creator_row(conn, opts) is None
+    status, tenant, decision = lanes.initial_state(conn, [], "ready", False, "hermes", opts)
+    assert (status, tenant, decision.gated) == ("triage", "hermes", True)
+
+
 def test_triage_sweep_leaves_gate_held_card(conn, configured):
     from hermes_cli.kanban_triage_sweep import sweep_stale_triage
 
