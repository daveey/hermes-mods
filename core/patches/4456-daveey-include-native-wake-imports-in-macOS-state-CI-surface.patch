From 2131baaecf8c280b360923f4ed36823cd6a0f562 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 05:51:35 +0000
Subject: [PATCH] [daveey] include native wake imports in macOS state CI
 surface

Register the two new load-time imports so changes to the host wake source select the macOS state lane. Proof: existing import-surface suite reproduced three failures before the fix; import-surface, routing and classifier suites pass 308 tests afterward (one existing skip).
---
 scripts/ci/classify_changes.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/scripts/ci/classify_changes.py b/scripts/ci/classify_changes.py
index 1afab6147ea6b7e7851ce9b92c6c1b4a07e71fce..1d0a57d322a0d47eb47dff87b2fa0f8f7749eb63 100644
--- a/scripts/ci/classify_changes.py
+++ b/scripts/ci/classify_changes.py
@@ -308,6 +308,8 @@ HERMES_STATE_IMPORTS = (
     "hermes_cli/timefmt.py",
     "hermes_constants.py",
     "hermes_dir_acl.py",
+    "hermes_platform/__init__.py",
+    "hermes_platform/wake_clock.py",
     "hermes_startup_watchdog.py",
     "utils.py",
 )
