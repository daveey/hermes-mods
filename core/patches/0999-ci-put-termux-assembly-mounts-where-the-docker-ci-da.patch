From c8b952a9d6e24e0725131116898299da93b13dc8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 15:54:47 +0000
Subject: [PATCH] ci: put termux assembly mounts where the docker-ci daemon can
 see them

---
 .github/workflows/tests.yml                       |  4 ++++
 tests/scripts/test_termux_assembly_permissions.py | 11 +++++++++--
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index 51d204bd8ba..bade4c65584 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -197,7 +197,11 @@ jobs:
 
       - name: Run assembly permission tests
         # --fail-on-skip: a missing daemon or image must not go green.
+        # Bind-mount sources must live where the docker daemon can see them.
+        env:
+          HERMES_TEST_DOCKER_MOUNT_ROOT: ${{ runner.temp }}/termux-assembly
         run: |
+          mkdir -p "$HERMES_TEST_DOCKER_MOUNT_ROOT"
           if ! scripts/run_tests.sh --fail-on-skip \
               tests/scripts/test_termux_assembly_permissions.py; then
             echo "::error::termux assembly permission tests failed or skipped (a skip means docker or the pinned image was not available)"
diff --git a/tests/scripts/test_termux_assembly_permissions.py b/tests/scripts/test_termux_assembly_permissions.py
index 75241f8ceb3..f5b7f8171ea 100644
--- a/tests/scripts/test_termux_assembly_permissions.py
+++ b/tests/scripts/test_termux_assembly_permissions.py
@@ -37,8 +37,13 @@ def test_assembly_publishes_facts_as_termux_uid_and_returns_host_owned_output(tm
     if image.returncode:
         pytest.skip(f"Pre-pull the native Linux test image: docker pull {IMAGE}")
 
-    payload = tmp_path / "payload"
-    payload.mkdir()
+    # The docker daemon resolves bind-mount sources on ITS filesystem. On the
+    # docker-ci runner pytest's /var/tmp basetemp is not visible to the daemon
+    # (it mounts an empty dir, so chown /assembly/tools fails); the workflow
+    # points this at a runner-temp dir the daemon shares.
+    mount_root = os.environ.get("HERMES_TEST_DOCKER_MOUNT_ROOT")
+    payload = (Path(mount_root) / tmp_path.name if mount_root else tmp_path) / "payload"
+    payload.mkdir(parents=True)
     for name in ("python", "uv"):
         entry = payload / name
         entry.mkdir()
@@ -84,3 +89,5 @@ docker run --rm --user 1000:1000 --network none \
     assert {path: (path.stat().st_uid, path.stat().st_gid, path.stat().st_mode)
             for path in before} == before
     shutil.rmtree(assembly)
+    if mount_root:
+        shutil.rmtree(payload.parent, ignore_errors=True)
-- 
2.55.0

