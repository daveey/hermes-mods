From baed59f27c5f1bf1c9e2061a4c9be28ff3f631f8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 06:48:35 +0000
Subject: [PATCH] fix(kanban-recover): holder record carries the process start
 time; a reused pid is not reported as the holder [daveey]

A recovery killed by SIGKILL (spawn_recovery's timeout) leaves <db>.recover.pid behind. Liveness was
only os.kill(pid, 0), so a reused pid made busy messages, the sqlite-live-guard refusal and the
coach incident dedupe name a card that is not recovering anything. The record now stores
/proc/<pid>/stat starttime and readers drop records whose start time no longer matches (review of
t_01a180cfd048ffcc). Tests: reused-pid record ignored; record carries proc_start.
---
 hermes_cli/kanban_db_recover.py            | 16 ++++++++++++++--
 tests/hermes_cli/test_kanban_db_recover.py | 16 ++++++++++++++++
 2 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_db_recover.py b/hermes_cli/kanban_db_recover.py
index cb4f3a0b1f..f192196040 100644
--- a/hermes_cli/kanban_db_recover.py
+++ b/hermes_cli/kanban_db_recover.py
@@ -150,7 +150,7 @@ def recovery_lock(db_path: Path) -> Iterator[bool]:
         except OSError:
             yield False
             return
-        record = {"pid": os.getpid(), "started_at": time.time(),
+        record = {"pid": os.getpid(), "proc_start": _proc_start(os.getpid()), "started_at": time.time(),
                   "session_id": os.environ.get("HERMES_SESSION_ID") or None,
                   "task_id": os.environ.get(HOLDER_TASK_ENV) or os.environ.get("HERMES_KANBAN_TASK") or None}
         with contextlib.suppress(OSError):
@@ -203,7 +203,19 @@ def recovery_lock_holder_info(db_path: Path) -> Optional[dict]:
         info["pid"] = int(info.get("pid"))
     except (TypeError, ValueError):
         return None
-    return info if _pid_alive(info["pid"]) else None
+    if not _pid_alive(info["pid"]):
+        return None
+    if info.get("proc_start") and _proc_start(info["pid"]) not in (None, str(info["proc_start"])):
+        return None  # the recorded process died (e.g. SIGKILL at the spawn timeout) and its pid was reused
+    return info
+
+
+def _proc_start(pid: int) -> Optional[str]:
+    """Linux process start time in clock ticks (``/proc/<pid>/stat`` field 22); None elsewhere."""
+    try:
+        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
+    except (OSError, IndexError):
+        return None
 
 
 def describe_holder(info: Optional[dict]) -> str:
diff --git a/tests/hermes_cli/test_kanban_db_recover.py b/tests/hermes_cli/test_kanban_db_recover.py
index 47697432a1..7932414945 100644
--- a/tests/hermes_cli/test_kanban_db_recover.py
+++ b/tests/hermes_cli/test_kanban_db_recover.py
@@ -594,3 +594,19 @@ def test_spawned_recovery_records_the_callers_card_as_holder(home, monkeypatch):
     rec.spawn_recovery(home / "kanban.db", wait=True)
     assert "HERMES_KANBAN_TASK" not in seen["env"]
     assert seen["env"]["HERMES_RECOVERY_HOLDER_TASK"] == "t_holdercard03"
+
+
+def test_holder_info_ignores_a_reused_pid(home):
+    """A SIGKILLed recovery leaves its record; if the pid is reused, the start time no longer matches."""
+    path = home / "kanban.db"
+    path.with_name("kanban.db.recover.pid").write_text(json.dumps({"pid": os.getpid(), "proc_start": "1",
+                                                                    "task_id": "t_reused"}))
+    assert rec.recovery_lock_holder_info(path) is None
+
+
+def test_holder_record_carries_this_process_start_time(home):
+    path = home / "kanban.db"
+    path.write_bytes(b"")
+    with rec.recovery_lock(path):
+        raw = json.loads(path.with_name("kanban.db.recover.pid").read_text())
+        assert raw["proc_start"] and rec.recovery_lock_holder_info(path)["pid"] == os.getpid()
