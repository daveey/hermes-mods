From 22f9ac017d4206ba5506e1466390f9f27086f2d7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 00:04:43 +0000
Subject: [PATCH] fix(gateway): replay parked rows when unknown work settles
 [daveey]

---
 gateway/session_authority.py                  |  2 ++
 .../test_parked_automation_fence_settles.py   | 27 +++++++++++++++++++
 2 files changed, 29 insertions(+)

diff --git a/gateway/session_authority.py b/gateway/session_authority.py
index 65734c42d8..776342d361 100644
--- a/gateway/session_authority.py
+++ b/gateway/session_authority.py
@@ -924,6 +924,8 @@ class SessionAuthority:
 
     async def _resolved_unknown(self, ref, admission_id, prepared, captured, row):
         self.pending_results.pop(admission_id, None)
+        from gateway.session_settlement_recovery import drain_deferred_rows
+        await drain_deferred_rows(self, ref)
         # A resolution racing recovery leaves publication, delivery and collection to the drain. A
         # conversation idle retirement let go between the commit and this follow-up has no drain:
         # bring it back first, so the captured answer reaches its viewers.
diff --git a/tests/gateway/test_parked_automation_fence_settles.py b/tests/gateway/test_parked_automation_fence_settles.py
index 756c4662c2..9595f4020d 100644
--- a/tests/gateway/test_parked_automation_fence_settles.py
+++ b/tests/gateway/test_parked_automation_fence_settles.py
@@ -118,3 +118,30 @@ def test_every_pause_is_logged_at_warning(tmp_path, monkeypatch, caplog, reason)
     with db, caplog.at_level(logging.INFO, logger='gateway.session_authority'):
         owner._pause(REF, reason)
     assert [(r.getMessage(), r.levelno) for r in caplog.records] == [(f'Session s paused: {reason}', logging.WARNING)]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('invalid', [False, True])
+async def test_real_drain_delivers_spooled_row_before_follower(tmp_path, monkeypatch, invalid):
+    from gateway import session_finite, shutdown_flush
+    db, owner, _head, follower, calls = await _after_boot(tmp_path, monkeypatch, AUTOMATION)
+    monkeypatch.setattr(shutdown_flush, '_get_flush_dir', lambda: tmp_path / 'spool')
+    (tmp_path / 'spool').mkdir()
+    # TUI/headless owners have no messaging SessionStore: their DB is still the replay target.
+    monkeypatch.setattr(owner.runner, 'session_store', None, raising=False)
+    with db:
+        assert shutdown_flush.defer_row_for_parked_turn('s', {'role': 'user', 'content': 'DEFERRED'})
+        if invalid:
+            _void_proof(db)
+        previous = session_finite.execute_finite_admission
+
+        async def execute(authority, ref, row):
+            if row['payload']['text'] == 'FOLLOWER':
+                assert [m['content'] for m in db.get_messages('s')].count('DEFERRED') == 1
+            return await previous(authority, ref, row)
+
+        monkeypatch.setattr(session_finite, 'execute_finite_admission', execute)
+        await _drain(owner)
+        assert calls == (['FOLLOWER'] if invalid else ['resumed', 'FOLLOWER'])
+        assert _status(db, follower) == ('terminal', 'completed')
+        assert not list((tmp_path / 'spool').glob('pending-*.json'))
-- 
2.43.0

