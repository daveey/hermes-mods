From e38963e0358e484acfd4c8daca8a82b5bb22e569 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 14:32:00 +0000
Subject: [PATCH] ci: run termux assembly permissions on docker-ci

hermes-hub slices skip both success and failed-build parametrizations, so a
green Python shard is not evidence the ownership regression ran. Pull the
pinned image on a docker-ci runner and fail the lane on any skip.
---
 .github/workflows/tests.yml          | 35 ++++++++++++++++++++++++++++
 tests/ci/test_fast_runner_routing.py | 17 ++++++++++++++
 2 files changed, 52 insertions(+)

diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index 306cfddd97f..51d204bd8ba 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -172,6 +172,41 @@ jobs:
         # (a half-extracted download, a worktree its later cleanup never removed).
         uses: ./.github/actions/check-clean-worktree
 
+  termux-assembly-permissions:
+    # hermes-hub slices skip both parametrizations: no daemon, and the pinned
+    # native image is not pre-pulled. A green Python shard is not evidence the
+    # bind-mount ownership regression ran. This lane is that evidence.
+    name: Termux assembly permissions
+    runs-on: [self-hosted, docker-ci]
+    timeout-minutes: 20
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+
+      - name: Pull the native Linux test image
+        uses: ./.github/actions/retry
+        with:
+          command: docker pull -q python@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a
+
+      - name: Set up locked Python and test dependencies
+        uses: ./.github/actions/setup-pm
+        with:
+          extras: '[]'
+          test-environment: 'true'
+          prune-python-cache: true
+
+      - name: Run assembly permission tests
+        # --fail-on-skip: a missing daemon or image must not go green.
+        run: |
+          if ! scripts/run_tests.sh --fail-on-skip \
+              tests/scripts/test_termux_assembly_permissions.py; then
+            echo "::error::termux assembly permission tests failed or skipped (a skip means docker or the pinned image was not available)"
+            exit 1
+          fi
+
+      - name: Check the checkout is clean
+        uses: ./.github/actions/check-clean-worktree
+
   e2e:
     # The core suites spawn real serve / gateway / tui_gateway / MCP / SQLite
     # writer processes per test; a 4-vCPU runner serialises them into timeouts.
diff --git a/tests/ci/test_fast_runner_routing.py b/tests/ci/test_fast_runner_routing.py
index 01ba4f15c2f..de432522896 100644
--- a/tests/ci/test_fast_runner_routing.py
+++ b/tests/ci/test_fast_runner_routing.py
@@ -123,3 +123,20 @@ def test_e2e_upgrade_has_release_tags_for_n_minus_1():
     assert "refs/tags/v20*:refs/tags/v20*" in fetch["run"]
     # The step proves N-1 resolves instead of letting every N-1 test fail on its own.
     assert fetch["run"].rstrip().endswith("git describe --tags --abbrev=0 --match 'v20[0-9][0-9].*' HEAD~1")
+
+
+def test_termux_assembly_permissions_run_on_docker_ci_and_fail_on_skip():
+    # hermes-hub has no docker daemon, so the file's two parametrizations skip
+    # there. The ownership regression only counts if this lane runs it.
+    job = _workflows()["tests.yml"]["jobs"]["termux-assembly-permissions"]
+    assert _labels(job) == ["self-hosted", "docker-ci"]
+    assert "hermes-hub" not in _labels(job)
+    steps = job["steps"]
+    names = [s.get("name") for s in steps]
+    pull = steps[names.index("Pull the native Linux test image")]
+    run = steps[names.index("Run assembly permission tests")]
+    assert names.index("Pull the native Linux test image") < names.index("Run assembly permission tests")
+    assert "ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a" in pull["with"]["command"]
+    assert "--fail-on-skip" in run["run"]
+    assert "tests/scripts/test_termux_assembly_permissions.py" in run["run"]
+    assert steps[-1].get("uses") == "./.github/actions/check-clean-worktree"
-- 
2.55.0

