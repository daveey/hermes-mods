From 38b0017c43b64fbe86dc89ee2baa4a6cf7a233ea Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 02:53:26 +0000
Subject: [PATCH] [daveey] Consume exec -a argv0 before walking nested login
 shells

The transparent wrapper walker skipped -a but mistook its next token for the command. That hid login-shell stdin from the unknown-alias walk. Consume the argv0 operand just like the approval and self-repo scanners already do. Keep heredoc masking conservative: its exec wrapper rejects options rather than guessing the consumer.

Proof: four new nested-shell cases failed before the one-entry fix. Added non-login bash and shell-named cat argv0 controls. Canonical consumer suites: 70 files, 11077 tests passed, zero failed. Full scripts/check --base origin/main passed. Read-only hub history prefilter: 36212 matching message rows yielded 19395 unique terminal commands; direct shlex prefix-peel comparison found zero changed peels (parser-only sample, not a full referenced-file replay).
---
 cron/lifecycle_guard.py                            | 1 +
 tests/cron/test_lifecycle_guard_session_aliases.py | 7 +++++++
 2 files changed, 8 insertions(+)

diff --git a/cron/lifecycle_guard.py b/cron/lifecycle_guard.py
index 3a2d5029347f8d44dcb66ad9ebd3f76a9ad6d20c..72039f219841c404943e71cf54e38fc513f147f7 100644
--- a/cron/lifecycle_guard.py
+++ b/cron/lifecycle_guard.py
@@ -345,6 +345,7 @@ _TRANSPARENT_COMMAND_PREFIXES = frozenset({
 
 # Wrapper options that consume the NEXT token, so a value is never mistaken for the command.
 _TRANSPARENT_PREFIX_VALUE_OPTIONS = {
+    "exec": {"-a"},
     "sudo": {"-u", "-g", "-U", "-C", "-p", "-r", "-t", "-T", "--user", "--group", "--prompt"},
     "doas": {"-u", "-C"},
     "env": {"-u", "--unset", "-S", "--split-string", "-C", "--chdir"},
diff --git a/tests/cron/test_lifecycle_guard_session_aliases.py b/tests/cron/test_lifecycle_guard_session_aliases.py
index ff489722af56a0d0ff9a8eec44326cd15470a4b6..75ea32546c81d111d4150a3eec1cbbf57de91717 100644
--- a/tests/cron/test_lifecycle_guard_session_aliases.py
+++ b/tests/cron/test_lifecycle_guard_session_aliases.py
@@ -358,6 +358,10 @@ _NESTED_FOREIGN_SHELLS = [
     # word, so `env`/`exec`/`command`/`nice`/`timeout` hid `su` and its stdin was never walked.
     "env su -l bob < {script}",
     "exec su -l bob < {script}",
+    "exec -a x su -l bob < {script}",
+    "exec -a x bash -l < {script}",
+    "exec -a python3 bash -l < {script}",
+    "exec -cl -a x bash -l < {script}",
     "command su -l bob < {script}",
     "nice su -l bob < {script}",
     "timeout 5 su -l bob < {script}",
@@ -458,6 +462,9 @@ def test_nested_login_shell_body_treats_names_as_unknown(tmp_path, live_kanban_d
     "cat < <(cat {script})",
     "su -l bob -c true < <(cat {script})",
     "bash < {script}",
+    "exec -a x bash < {script}",
+    "exec -a bash cat < {script}",
+    "exec -a su cat < {script}",
     "bash -l 3<<< 't ( bash {db} )'",
     "ENV=x sh -c 't ( bash {db} )'",
     "BASH_ENV=x sh -c 't ( bash {db} )'",
