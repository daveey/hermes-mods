From b2a53ee6b8d1cfc6bcecb1332860a468131943ed Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 16:15:38 +0000
Subject: [PATCH] [daveey] relay re-pull: a Mac kickstarts its launchd
 hub-oauth-pull job (the 15:30Z burst hit the MacBook and mini too)

---
 agent/credential_relay_repull.py            | 21 +++++++---
 tests/agent/test_credential_relay_repull.py | 44 +++++++++++++++++++++
 2 files changed, 60 insertions(+), 5 deletions(-)

diff --git a/agent/credential_relay_repull.py b/agent/credential_relay_repull.py
index a570d144bf..78687d6428 100644
--- a/agent/credential_relay_repull.py
+++ b/agent/credential_relay_repull.py
@@ -23,6 +23,7 @@ from __future__ import annotations
 import os
 import shlex
 import subprocess
+import sys
 import time
 from pathlib import Path
 from typing import Any, Optional
@@ -69,23 +70,33 @@ def is_revoked_401(status_code: Optional[int], error_context: Optional[dict]) ->
     return "revoked" in text
 
 
+MAC_PULL_JOB = "com.daveey.hub-oauth-pull"
+
+
 def pull_command() -> Optional[list[str]]:
-    """The host's relay pull: ``oauth_relay.pull_command``, else the worker's ``~/bin/worker-oauth-pull``.
+    """The host's relay pull: ``oauth_relay.pull_command``, else the host's own pull job.
 
-    That script writes the default home's ``auth.json`` only, so it is used only for that home.
+    A worker node runs ``~/bin/worker-oauth-pull``; a Mac (MacBook, mini) runs the launchd job
+    ``com.daveey.hub-oauth-pull`` every 120 s, so it is kickstarted, which keeps the job's own
+    provider/skip environment. Both write the default home's ``auth.json`` only, so they are used
+    only for that home; any other home (the mini's ``~/.bb-hermes``) needs ``pull_command``.
     """
     configured = str(_settings().get("pull_command") or "").strip()
     if configured:
         return shlex.split(configured)
     from hermes_constants import get_hermes_home
-    home = Path.home()  # health: allow HX001 -- the worker pull script and its target live in the user's home
-    script = home / "bin" / "worker-oauth-pull"
+    home = Path.home()  # health: allow HX001 -- the host pull jobs and their target live in the user's home
     try:
         default_home = Path(get_hermes_home()).resolve() == (home / ".hermes").resolve()
     except OSError:
         return None
-    if default_home and script.is_file() and os.access(script, os.X_OK):
+    if not default_home:
+        return None
+    script = home / "bin" / "worker-oauth-pull"
+    if script.is_file() and os.access(script, os.X_OK):
         return [str(script)]
+    if sys.platform == "darwin" and (home / "Library" / "LaunchAgents" / f"{MAC_PULL_JOB}.plist").is_file():
+        return ["launchctl", "kickstart", f"gui/{os.getuid()}/{MAC_PULL_JOB}"]  # windows-footgun: ok -- darwin-gated
     return None
 
 
diff --git a/tests/agent/test_credential_relay_repull.py b/tests/agent/test_credential_relay_repull.py
index 11c0100536..b56fd8e5dd 100644
--- a/tests/agent/test_credential_relay_repull.py
+++ b/tests/agent/test_credential_relay_repull.py
@@ -162,3 +162,47 @@ def test_only_revoked_401s_on_relay_rows_take_the_re_pull_path():
     assert is_revoked_401(401, REVOKED)
     assert not is_revoked_401(401, {"message": "invalid x-api-key"})
     assert not is_revoked_401(403, REVOKED)
+
+
+
+@pytest.fixture
+def user_home(tmp_path, monkeypatch):
+    from agent import credential_relay_repull as rr
+
+    user = tmp_path / "user"
+    (user / ".hermes").mkdir(parents=True)
+    monkeypatch.setattr(rr, "_settings", dict)
+    monkeypatch.setattr(rr.Path, "home", classmethod(lambda cls: user))
+    monkeypatch.setenv("HERMES_HOME", str(user / ".hermes"))
+    return rr, user
+
+
+@pytest.mark.platforms("macos")
+def test_a_mac_kickstarts_its_launchd_pull_job(user_home):
+    """The 15:30Z burst hit the MacBook and the mini too: they pull through launchd, not the worker script."""
+    rr, user = user_home
+    assert rr.pull_command() is None  # no pull job on this host: the old re-read/rotate path decides
+    agents = user / "Library" / "LaunchAgents"
+    agents.mkdir(parents=True)
+    (agents / f"{rr.MAC_PULL_JOB}.plist").write_text("<plist/>")
+    assert rr.pull_command() == ["launchctl", "kickstart", f"gui/{rr.os.getuid()}/{rr.MAC_PULL_JOB}"]  # windows-footgun: ok -- macOS-only test
+
+
+@pytest.mark.platforms("linux")
+def test_a_worker_node_runs_its_pull_script_for_the_default_home_only(user_home, monkeypatch):
+    rr, user = user_home
+    agents = user / "Library" / "LaunchAgents"
+    agents.mkdir(parents=True)
+    (agents / f"{rr.MAC_PULL_JOB}.plist").write_text("<plist/>")
+    assert rr.pull_command() is None  # a stray plist off macOS is not a pull job
+    script = user / "bin" / "worker-oauth-pull"
+    script.parent.mkdir()
+    script.write_text("#!/bin/sh\n")
+    script.chmod(0o755)
+    assert rr.pull_command() == [str(script)]
+
+    (user / ".bb-hermes").mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(user / ".bb-hermes"))
+    assert rr.pull_command() is None  # that script writes ~/.hermes only
+    monkeypatch.setattr(rr, "_settings", lambda: {"pull_command": "hub-oauth-pull --home ~/.bb-hermes"})
+    assert rr.pull_command() == ["hub-oauth-pull", "--home", "~/.bb-hermes"]
-- 
2.43.0

