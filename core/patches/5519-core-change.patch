+@pytest.fixture(scope='module')
+def home_template(tmp_path_factory, session_schema_template):
+    """Snapshot a real synced home once, including committed SQLite WAL pages.
+
+    Schema/identity setup dominates this backfill matrix. Copies keep real on-disk
+    databases and all production backfill operations, but don't repeat migrations.
+    The fresh-home parity control below still exercises the original constructor.
+    """
+    root = tmp_path_factory.mktemp('backfill-home-template')
+    with pytest.MonkeyPatch.context() as patch:
+        import hermes_state
+
+        session_db = hermes_state.SessionDB
+
+        def with_empty_schema(*args, **kwargs):
+            db = session_db(*args, **kwargs)
+            with closing(sqlite3.connect(kwargs['db_path'])) as source, \
+                    closing(sqlite3.connect(session_schema_template)) as target:
                 source.backup(target)
-        return db
+            return db
+
+        patch.setattr(hermes_state, 'SessionDB', with_empty_schema)
+        home = make_home(root, patch)
+        snapshot = root / 'snapshot'
+        shutil.copytree(home, snapshot)
+        for source in home.rglob('*.db'):
+            target = snapshot / source.relative_to(home)
+            target.unlink()
+            with closing(sqlite3.connect(source)) as src, closing(sqlite3.connect(target)) as dst:
+                src.backup(dst)
+        for suffix in ('*-wal', '*-shm'):
+            for sidecar in snapshot.rglob(suffix):
+                sidecar.unlink()
+    return snapshot
+
+
+def copy_home(tmp_path, monkeypatch, home_template):
+    home = tmp_path / '.hermes'
+    shutil.copytree(home_template, home)
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_HUB_STATE', str(tmp_path / 'hub'))
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    for key in ('HERMES_KANBAN_TASK', 'HERMES_KANBAN_DB', 'HERMES_KANBAN_BOARD', 'HERMES_ORIGIN_SESSION',
+                'HERMES_SESSION_ID', 'HERMES_SESSION_KEY', 'HERMES_KANBAN_RUN_ID'):
+        monkeypatch.delenv(key, raising=False)
+    from hermes_cli import kanban_capability_registry as registry
+    from tools import kanban_tools as tools
+    from agent import delegation_context
+    monkeypatch.setattr(registry, 'self_gateway', lambda: 'here')
+    monkeypatch.setattr(tools, '_is_dispatcher_owned_worker', lambda: True)
+    monkeypatch.setattr(delegation_context, 'is_dispatcher_owned_worker_context', lambda: True)
+    return home
 
-    monkeypatch.setattr(hermes_state, 'SessionDB', with_empty_schema)
-    make_home(tmp_path, monkeypatch)
-    monkeypatch.setattr(hermes_state, 'SessionDB', session_db)
+
+@pytest.fixture
