     with kbc.connect_closing() as conn:
         yield conn
 
@@ -83,6 +117,48 @@ def seed(conn, payload, event_id=123):
     conn.commit()
 
 
+def test_home_template_preserves_real_schema_and_isolates_writes(tmp_path, home_template):
+    """Copies retain the real synced schema/session data without sharing mutations."""
+    roots = [tmp_path / name for name in ('fresh', 'first', 'second')]
+    for root in roots:
+        root.mkdir()
+    with pytest.MonkeyPatch.context() as patch:
+        fresh = make_home(roots[0], patch)  # retain a fresh-schema integration control
+    with pytest.MonkeyPatch.context() as patch:
+        first = copy_home(roots[1], patch, home_template)
+        with kbc.connect_closing() as conn:
+            seed(conn, '{}')
+            assert creator.backfill(conn) == {'attempted': [], 'unresolved': []}
+            assert conn.execute('SELECT COUNT(*) FROM tasks').fetchone()[0] == 1
+    with pytest.MonkeyPatch.context() as patch:
+        second = copy_home(roots[2], patch, home_template)
+        with kbc.connect_closing() as conn:
+            assert conn.execute('SELECT COUNT(*) FROM tasks').fetchone()[0] == 0
+            from hermes_cli import kanban_sync_client as sync
+            identity = sync.ensure_identity(conn, 'default', 'here')
+            assert identity['board_id'] == 'default' and identity['gateway_id'] == 'here'
+    databases = sorted(path.relative_to(home_template) for path in home_template.rglob('*.db'))
+    assert Path('state.db') in databases and len(databases) >= 2
+    for relative in databases:
+        with closing(sqlite3.connect(home_template / relative)) as template, \
+                closing(sqlite3.connect(second / relative)) as copied, \
+                closing(sqlite3.connect(fresh / relative)) as original:
+            schema = 'SELECT type,name,tbl_name,sql FROM sqlite_master ORDER BY type,name'
+            assert copied.execute(schema).fetchall() == original.execute(schema).fetchall()
+            assert list(copied.iterdump()) == list(template.iterdump())
+            assert (second / relative).stat().st_ino != (home_template / relative).stat().st_ino
+    with closing(sqlite3.connect(second / 'state.db')) as sessions:
+        from tests.tools.test_kanban_worker_created_chats import CHAT, WORKER
+        assert {row[0] for row in sessions.execute('SELECT id FROM sessions')} == {CHAT, WORKER}
+    with closing(sqlite3.connect(first / 'state.db')) as changed:
+        changed.execute('CREATE TABLE copy_only (value TEXT)')
+        changed.execute("INSERT INTO copy_only VALUES ('mutated')")
+        changed.commit()
+    for home in (home_template, second):
+        with closing(sqlite3.connect(home / 'state.db')) as untouched:
+            assert untouched.execute("SELECT name FROM sqlite_master WHERE name='copy_only'").fetchall() == []
+
+
 def decoded(monkeypatch, payload):
     original = json.loads
     calls = []
