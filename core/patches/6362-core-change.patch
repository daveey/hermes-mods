diff --git a/.github/workflows/origin-transport.yml b/.github/workflows/origin-transport.yml
new file mode 100644
index 00000000000..9ba56d015fc
--- /dev/null
+++ b/.github/workflows/origin-transport.yml
@@ -0,0 +1,87 @@
+name: Origin transport (pinned hermes-hub courier)
+
+# tests/origin_transport/ composes this core with hermes-hub's exact courier client
+# (client/hermes_hub.py). It skips without --courier-client, so the Python slices never
+# exercise it; before this workflow only hermes-hub's own core-observation job passed the
+# option, so a forwarding regression could stay green here.
+#
+# hermes-hub is private, so its checkout needs a read-only deploy key. ci.yaml runs
+# PR-controlled code and must not receive secrets (its SECURITY note), so this lane is its
+# own workflow, like docker.yml's publish jobs: the key is a secret of the `hermes-hub-read`
+# environment, resolved only on main pushes and manual dispatches. For that reason it is not
+# part of the required "All required checks pass" gate.
+#
+# Bump the hermes-hub ref when the courier client changes; it is the exact client bytes
+# this core is proven against. tests/ci/test_origin_transport_ci.py pins this shape.
+
+on:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  # Every main push keeps its own run, so a red one names its own commit.
+  group: origin-transport-${{ github.ref == 'refs/heads/main' && github.run_id || github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  composed:
+    name: Origin forwarding through the pinned hermes-hub courier
+    runs-on: blacksmith-2vcpu-ubuntu-2404
+    timeout-minutes: 20
+    environment: hermes-hub-read
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a  # v7.0.1 (fork: upstream uses useblacksmith/checkout)
+
+      - name: Require the hermes-hub read key
+        # Without it the checkout below would fail on an opaque auth error, or a later edit
+        # could turn it into a skip; name the missing provisioning instead.
+        env:
+          KEY_PRESENT: ${{ secrets.HERMES_HUB_READ_KEY != '' }}
+        run: |
+          if [ "$KEY_PRESENT" != true ]; then
+            echo "::error::HERMES_HUB_READ_KEY is not set on the hermes-hub-read environment (read-only deploy key on daveey/hermes-hub)"
+            exit 1
+          fi
+
+      - name: Checkout the pinned hermes-hub courier
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a  # v7.0.1
+        with:
+          repository: daveey/hermes-hub
+          # hermes-hub main undated representative observation (client 1.9.x), the client its core-observation job proves.
+          ref: f9554a2aea9748512fec16a27a86a09041021271
+          path: .composed-hub
+          fetch-depth: 1
+          # Repository-scoped read-only deploy key, never a user/account token.
+          ssh-key: ${{ secrets.HERMES_HUB_READ_KEY }}
+          persist-credentials: false
+
+      - name: Set up locked Python and test dependencies
+        uses: ./.github/actions/setup-pm
+        with:
+          extras: '[]'
+          test-environment: 'true'
+          prune-python-cache: true
+
+      - name: Run tests/origin_transport/ with the courier client
+        # Direct pytest, not scripts/run_tests.sh: the canonical runner starts each file from
+        # `env -i`, which would drop the canary env below (hermes-hub client-cli.yml sets the same).
+        env:
+          COURIER: ${{ github.workspace }}/.composed-hub/client/hermes_hub.py
+          HERMES_KANBAN_DB: /tmp/not-the-owner-board.db
+          HERMES_KANBAN_HOME: /tmp/not-the-owner-home
+          HERMES_DELEGATED_CHILD_CONTEXT: /tmp/not-the-owner-home
+          HERMES_DELEGATED_CHILD_OWNER: worker-must-not-own-the-suite
+          HERMES_SESSION_ID: worker-session-must-not-be-the-origin
+        shell: bash
+        run: |
+          scripts/run-in-hermes-env python -m pytest -q -p no:cacheprovider tests/origin_transport/ \
+            --courier-client="$COURIER" -rA --junitxml="$RUNNER_TEMP/origin-transport.xml"
+
+      - name: Fail on any skip or an empty run
+        if: ${{ !cancelled() }}
+        run: python3 scripts/ci/check_origin_transport_junit.py "$RUNNER_TEMP/origin-transport.xml"
diff --git a/scripts/ci/check_origin_transport_junit.py b/scripts/ci/check_origin_transport_junit.py
new file mode 100644
index 00000000000..e3c550fe6d4
--- /dev/null
+++ b/scripts/ci/check_origin_transport_junit.py
@@ -0,0 +1,42 @@
+#!/usr/bin/env python3
+"""Fail the origin-transport lane unless every collected case ran and passed.
+
+tests/origin_transport/ skips without ``--courier-client``; a green run over skipped or zero cases
+would be the silent gap this lane exists to close (.github/workflows/origin-transport.yml).
+Decided from pytest's JUnit counts, not its progress line.
+
+    python3 scripts/ci/check_origin_transport_junit.py JUNIT.xml
+"""
+from __future__ import annotations
+
+import sys
+import xml.etree.ElementTree as ET
+
+
+def verdict(xml_text: str) -> tuple[bool, str]:
+    root = ET.fromstring(xml_text)
+    suites = [root] if root.tag == "testsuite" else list(root.iter("testsuite"))
+    counts = {key: sum(int(s.get(key, 0)) for s in suites) for key in ("tests", "skipped", "failures", "errors")}
+    if counts["tests"] == 0:
+        return False, "no test ran (collection selected nothing)"
+    bad = {k: v for k, v in counts.items() if k != "tests" and v}
+    if bad:
+        return False, ", ".join(f"{v} {k}" for k, v in bad.items()) + f" of {counts['tests']}"
+    return True, f"{counts['tests']} passed"
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) != 2:
+        print(__doc__.strip().splitlines()[-1].strip(), file=sys.stderr)
+        return 2
+    with open(argv[1], encoding="utf-8-sig") as fh:
+        ok, reason = verdict(fh.read())
+    if ok:
+        print(f"origin transport: {reason}")
+        return 0
+    print(f"::error::origin transport: {reason}; a skip is not a pass")
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/tests/ci/test_origin_transport_ci.py b/tests/ci/test_origin_transport_ci.py
new file mode 100644
index 00000000000..df7a05b0f8a
--- /dev/null
+++ b/tests/ci/test_origin_transport_ci.py
@@ -0,0 +1,98 @@
+"""Core CI runs tests/origin_transport/ against a pinned hermes-hub courier and fails on any skip.
+
+The composed forwarding tests skip unless pytest gets ``--courier-client``; before this lane only
+hermes-hub's core-observation job passed it, so a core change that broke forwarding
+could stay green in core. hermes-hub is private and its checkout needs a
+read-only deploy key; ci.yaml runs PR-controlled code and must stay secret-free, so the lane is
+its own workflow whose key is an environment secret resolved only on trusted events.
+"""
+from __future__ import annotations
+
+import pathlib
+import re
+
+from ruamel.yaml import YAML
+
+_YAML = YAML(typ="safe")
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+WORKFLOWS = ROOT / ".github" / "workflows"
+WORKFLOW = WORKFLOWS / "origin-transport.yml"
+# The env hermes-hub's core-observation job sets for this suite (client-cli.yml): a worker's board
+# pin and session must never become the suite default.
+HUB_CANARY_ENV = {
+    "HERMES_KANBAN_DB": "/tmp/not-the-owner-board.db",
+    "HERMES_KANBAN_HOME": "/tmp/not-the-owner-home",
+    "HERMES_DELEGATED_CHILD_CONTEXT": "/tmp/not-the-owner-home",
+    "HERMES_DELEGATED_CHILD_OWNER": "worker-must-not-own-the-suite",
+    "HERMES_SESSION_ID": "worker-session-must-not-be-the-origin",
+}
+
+
+def _load(path: pathlib.Path) -> dict:
+    return _YAML.load(path.read_text(encoding="utf-8")) or {}
+
+
+def _job() -> dict:
+    jobs = _load(WORKFLOW)["jobs"]
+    assert list(jobs) == ["composed"], list(jobs)
+    return jobs["composed"]
+
+
+def _steps() -> list[dict]:
+    return _job()["steps"]
+
+
+def test_hub_checkout_is_pinned_read_only_and_never_persisted():
+    hub = [s for s in _steps() if (s.get("with") or {}).get("repository") == "daveey/hermes-hub"]
+    assert len(hub) == 1, hub
+    opts = hub[0]["with"]
+    assert re.fullmatch(r"[0-9a-f]{40}", str(opts["ref"])), opts["ref"]
+    assert opts["ssh-key"] == "${{ secrets.HERMES_HUB_READ_KEY }}"
+    assert opts["persist-credentials"] is False
+
+
+def test_the_whole_directory_runs_with_the_courier_client_and_the_hub_canary_env():
+    runs = [s for s in _steps() if "tests/origin_transport/" in str(s.get("run", ""))]
+    assert len(runs) == 1, runs
+    step = runs[0]
+    assert '--courier-client="$COURIER"' in step["run"]
+    assert step["env"]["COURIER"].endswith("/client/hermes_hub.py")
+    for key, value in HUB_CANARY_ENV.items():
+        assert step["env"].get(key) == value, key
+    # The canonical runner starts each file from `env -i`, which would drop the canary env.
+    assert "run_tests.sh" not in step["run"]
+    assert "--junitxml=" in step["run"]
+
+
+def test_a_skip_or_an_empty_run_fails_the_lane():
+    checks = [s for s in _steps() if "check_origin_transport_junit" in str(s.get("run", ""))]
+    assert len(checks) == 1, checks
+    import importlib.util
+
+    spec = importlib.util.spec_from_file_location(
+        "check_origin_transport_junit", ROOT / "scripts" / "ci" / "check_origin_transport_junit.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+
+    def suite(tests, skipped=0, failures=0, errors=0):
+        return (f'<testsuites><testsuite name="pytest" tests="{tests}" skipped="{skipped}" '
+                f'failures="{failures}" errors="{errors}"/></testsuites>')
+
+    assert mod.verdict(suite(8)) == (True, "8 passed")
+    assert mod.verdict(suite(8, skipped=1))[0] is False
+    assert mod.verdict(suite(0))[0] is False
+    assert mod.verdict(suite(8, failures=1))[0] is False
+    assert mod.verdict(suite(8, errors=1))[0] is False
+
+
+def test_key_is_environment_scoped_on_trusted_events_and_ci_yaml_stays_secret_free():
+    data = _load(WORKFLOW)
+    triggers = data.get("on") or data.get(True)
+    assert set(triggers) == {"push", "workflow_dispatch"}, triggers
+    assert triggers["push"]["branches"] == ["main"]
+    assert _job()["environment"] == "hermes-hub-read"
+    assert "HERMES_HUB_READ_KEY" not in (WORKFLOWS / "ci.yaml").read_text(encoding="utf-8")
+    assert "origin-transport" not in (WORKFLOWS / "ci.yaml").read_text(encoding="utf-8")
+    # A missing key fails loudly instead of skipping the checkout.
+    guard = [s for s in _steps() if "HERMES_HUB_READ_KEY" in str(s.get("env", ""))]
+    assert guard and "exit 1" in guard[0]["run"]
