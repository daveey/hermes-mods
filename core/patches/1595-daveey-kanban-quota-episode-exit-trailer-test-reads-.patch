From c7e32dd9d993e9dc7a576262607642db6fc5b77d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 00:25:11 +0000
Subject: [PATCH] [daveey] kanban quota episode: exit-trailer test reads the
 booking event past quota_episode; new default card after a known wall routes
 off it

CI on ad0d43dfdb17 failed test_fresh_process_sweep_books_the_logged_exit_code[75]: the
latest event is now the per-card quota_episode row recorded after rate_limited. Assert the
booking event and the single episode row separately.

Adds the hub 11-01 16:00 PST case (t_01a1998e7c300793): a brand-new unpinned card created
after the first reaped Codex wall is admitted on anthropic (default+wall:openai-codex) with
the live pool probe stubbed out, because the reaped receipt now persists provider_walls.json.
---
 tests/hermes_cli/test_kanban_quota_episode.py | 36 +++++++++++++++++++
 .../test_kanban_worker_exit_trailer.py        |  8 ++++-
 2 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_quota_episode.py b/tests/hermes_cli/test_kanban_quota_episode.py
index 8cd0f8358c9..599ac2bd6bc 100644
--- a/tests/hermes_cli/test_kanban_quota_episode.py
+++ b/tests/hermes_cli/test_kanban_quota_episode.py
@@ -249,6 +249,42 @@ def test_walled_concrete_default_model_reroutes_to_class_peer(board, monkeypatch
             assert '"provider": "anthropic"' in route and 'quota_reroute' in route
 
 
+def test_new_unpinned_card_created_after_a_known_wall_never_routes_to_it(board, monkeypatch, all_assignees_spawnable):
+    """Hub 11-01 16:00 PST (t_01a1998e7c300793): a brand-new unpinned card, created after the Codex wall
+    was already known, was admitted on the walled default (tier_reason: default) because no
+    provider_walls.json existed and the live pool probe missed. The first reaped wall must persist the
+    provider wall from its exact receipt, so every later default card skips the walled provider even
+    when the live pool probe sees nothing."""
+    from hermes_cli import kanban_provider_walls as walls
+    clock = [1_800_000_000]
+    monkeypatch.setattr(kb.time, 'time', lambda: clock[0])
+    monkeypatch.setattr(walls.time, 'time', lambda: clock[0])
+    monkeypatch.setattr(walls, 'live_quota_wall', lambda *_a, **_k: None)
+    routing(monkeypatch)
+    cfg = {'default_model': 'gpt-6-astra', 'default_provider': 'openai-codex',
+           'strong_model': 'claude-opus-5-5', 'strong_provider': 'anthropic'}
+    monkeypatch.setattr(tier, 'load_tier_config', lambda: cfg)
+    reset = clock[0] + 55 * 3600
+    with kbc.connect() as conn:
+        first = kb.create_task(conn, title='walled first', assignee='a')
+        reap(conn, first, admit=cfg, text=f'SubscriptionQuotaUnavailable: Subscription quota unavailable for '
+             f'openai-codex/gpt-6-astra; resets at {reset}.0',
+             fields={'failure_reason': 'rate_limit', 'failure_retryable': True, 'failure_resets_at': float(reset),
+                     'route_provider': 'openai-codex', 'route_model': 'gpt-6-astra'})
+        assert walls.active_walls(now=clock[0]).get('openai-codex') == pytest.approx(reset, abs=1)
+        # Hold the first card out of this tick so only the new one can be dispatched.
+        conn.execute("UPDATE tasks SET status='blocked' WHERE id=?", (first,))
+        clock[0] += 60
+        new = kb.create_task(conn, title='brand-new default card', assignee='a')
+        conn.commit()
+        seen = []
+        dispatch.dispatch_once(conn, spawn_fn=lambda task, ws: seen.append((task.id, task.provider_override)))
+        assert seen == [(new, 'anthropic')]
+        route = kb._json_dict(conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='run_route' "
+                                           "ORDER BY id DESC LIMIT 1", (new,)).fetchone()[0])
+        assert route['provider'] == 'anthropic' and route['tier_reason'] == 'default+wall:openai-codex'
+
+
 @pytest.mark.parametrize('reroute', [False, True])
 def test_real_dispatch_waits_or_uses_preview_route(board, monkeypatch, all_assignees_spawnable, reroute):
     clock = [1_800_000_000]
diff --git a/tests/hermes_cli/test_kanban_worker_exit_trailer.py b/tests/hermes_cli/test_kanban_worker_exit_trailer.py
index 459d554f6e0..3dda6f1e6ce 100644
--- a/tests/hermes_cli/test_kanban_worker_exit_trailer.py
+++ b/tests/hermes_cli/test_kanban_worker_exit_trailer.py
@@ -60,8 +60,14 @@ def test_fresh_process_sweep_books_the_logged_exit_code(kanban_home, rc, event,
 
         kbd.detect_crashed_workers(conn)
 
+        # The booking event; a 75 is followed by the per-card ``quota_episode`` bookkeeping
+        # row (kanban_quota_episode), which is asserted separately below.
         ev = conn.execute(
-            "SELECT kind FROM task_events WHERE task_id=? ORDER BY id DESC LIMIT 1", (tid,)).fetchone()
+            "SELECT kind FROM task_events WHERE task_id=? AND kind != 'quota_episode' "
+            "ORDER BY id DESC LIMIT 1", (tid,)).fetchone()
+        episodes = conn.execute(
+            "SELECT count(*) FROM task_events WHERE task_id=? AND kind='quota_episode'", (tid,)).fetchone()[0]
+        assert episodes == (1 if rc == kb.KANBAN_RATE_LIMIT_EXIT_CODE else 0)
         run = conn.execute(
             "SELECT outcome, error, metadata FROM task_runs WHERE task_id=? ORDER BY id DESC LIMIT 1",
             (tid,)).fetchone()
