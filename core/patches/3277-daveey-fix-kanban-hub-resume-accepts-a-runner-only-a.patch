diff --git a/hermes_cli/kanban_observed_pr_hold.py b/hermes_cli/kanban_observed_pr_hold.py
index e86ad1d880..7cc28dfb76 100644
--- a/hermes_cli/kanban_observed_pr_hold.py
+++ b/hermes_cli/kanban_observed_pr_hold.py
@@ -1,4 +1,13 @@
-"""Current-episode dispatcher observations for operator-only resume."""
+"""Current-episode dispatcher observations for operator-only resume.
+
+The episode starts at the card's latest lifecycle transition, of any kind. A dispatcher
+records ``respawn_guarded`` only for a card it finds in its ready (or review) lane, and
+records it again after every other event (``guard_hold_reason``). So an ``active_pr``
+observation after that transition shows the card is held now, also when it became
+ready again through an event that is no transition itself (a woken continuation or
+park, a released claim, a triage sweep) or through a same-profile reassign. The caller
+still requires an unclaimed READY card before it writes, which refuses review cards.
+"""
 from __future__ import annotations
 
 
@@ -10,7 +19,6 @@ _BOUNDARIES = frozenset({
     "crashed", "timed_out", "completed", "archived", "assigned", "review_requested",
     "review_reopened", "changes_requested", "operator_resumed",
 })
-_READY = frozenset({"promoted", "promoted_manual", "unblocked", "reopened", "reclaimed", "created"})
 
 
 def _episode(conn, task_id):
@@ -22,7 +30,7 @@ def _episode(conn, task_id):
         return None, False
     ordered = sorted(timed, key=lambda pair: (pair[0], pair[1]["id"]))
     boundary = next((e for _, e in reversed(ordered) if e["kind"] in _BOUNDARIES), None)
-    if boundary is None or boundary["kind"] not in _READY:
+    if boundary is None:
         return None, False
     point = (kb._to_epoch(boundary["created_at"]), boundary["id"])
     held = any((at, e["id"]) > point and e["kind"] == "respawn_guarded"
@@ -31,7 +39,7 @@ def _episode(conn, task_id):
 
 
 def observed(conn, task_id):
-    """Local or fresh Board evidence, bound to the home ready episode's UID."""
+    """Local or fresh Board evidence, bound to the home episode's UID."""
     from hermes_cli import kanban_db as kb
     from hermes_cli.kanban_dependency_history import _with_fresh_replica
 
diff --git a/tests/hermes_cli/test_kanban_observed_pr_hold_boundaries.py b/tests/hermes_cli/test_kanban_observed_pr_hold_boundaries.py
index fa68a4bf34..a4637e2538 100644
--- a/tests/hermes_cli/test_kanban_observed_pr_hold_boundaries.py
+++ b/tests/hermes_cli/test_kanban_observed_pr_hold_boundaries.py
@@ -57,9 +57,22 @@ def test_local_observation_requires_ready_boundary(stores, monkeypatch, case):
         "diagnostic": "UPDATE task_events SET kind='commented' WHERE id=2",
         "wrong_reason": "UPDATE task_events SET payload='{\"reason\":\"other\"}' WHERE id=2",
         "before_boundary": "UPDATE task_events SET created_at='2025-01-01T00:00:00Z' WHERE id=2",
-        # The latest lifecycle boundary is a park, not a ready transition.
-        "parked": "INSERT INTO task_events VALUES (3,'task','blocked','2026-01-01T00:00:00Z','{}','park')",
+        # The card was parked after the hold was seen: the observation is from an older episode.
+        "parked": "INSERT INTO task_events VALUES (3,'task','blocked','2026-01-01T00:00:02Z','{}','park')",
     }
     home.execute(mutations[case])
     monkeypatch.setattr(history, "_with_fresh_replica", lambda *args: False)
     assert not observed.observed(home, "task")
+
+
+@pytest.mark.parametrize("kind", ["blocked", "scheduled", "continued", "assigned", "claimed", "operator_resumed"])
+def test_a_hold_seen_after_any_latest_transition_counts(stores, monkeypatch, kind):
+    # A dispatcher records respawn_guarded only on a card it finds ready, so a hold after a park, a
+    # continuation, a reassign or a released claim shows the card left it through a non-transition event
+    # (a wake, a triage sweep, a release). resume() itself still requires an unclaimed READY card.
+    home, _ = stores
+    home.execute(f"INSERT INTO task_events VALUES (2,'task','{kind}','2026-01-01T00:00:01Z','{{}}','t')")
+    home.execute("INSERT INTO task_events VALUES (3,'task','respawn_guarded',"
+                 "'2026-01-01T00:00:02Z','{\"reason\":\"active_pr\"}','hold')")
+    monkeypatch.setattr(history, "_with_fresh_replica", lambda *args: False)
+    assert observed.observed(home, "task")
diff --git a/tests/hermes_cli/test_kanban_operator_resume_observed.py b/tests/hermes_cli/test_kanban_operator_resume_observed.py
index 7a4f041207..82e58f3b83 100644
--- a/tests/hermes_cli/test_kanban_operator_resume_observed.py
+++ b/tests/hermes_cli/test_kanban_operator_resume_observed.py
@@ -26,6 +26,46 @@ def test_current_observed_hold_allows_home_resume(kanban_home, clock, monkeypatc
         assert not resume.resumed_after(conn, task, helpers.T0)
 
 
+# 2026-11-12 t_01a1d120e7d7c686: pool workers held the card ``active_pr``; the hub's own guard said none. A
+# same-profile reassign wrote ``assigned`` and the workers re-held it 3 s later, yet hub ``resume`` still
+# refused, because only promoted/unblocked/... started an episode. Replayed Board history shows the same
+# for every way a card becomes ready again without such an event: a continuation that woke, a reviewer's
+# changes_requested, a released claim, a woken park, an earlier resume the runners never honoured.
+@pytest.mark.parametrize("boundary", [
+    "assigned", "continued", "changes_requested", "claimed", "scheduled", "operator_resumed", "blocked",
+])
+def test_observation_after_any_latest_transition_allows_home_resume(kanban_home, clock, monkeypatch, boundary):
+    with kbc.connect_closing() as conn:
+        task = helpers._held(conn)
+        clock[0] += 10
+        with kb.write_txn(conn):
+            kb._append_event(conn, task, "promoted")
+            kb._append_event(conn, task, "respawn_guarded", {"reason": "active_pr"})
+        clock[0] += 10
+        with kb.write_txn(conn):
+            kb._append_event(conn, task, boundary)
+            kb._append_event(conn, task, "respawn_guarded", {"reason": "active_pr"})
+        monkeypatch.setattr(dispatch, "check_respawn_guard", lambda *_: None)
+        receipt = resume.resume(conn, task, reason="runner-only hold", actor="operator")
+        assert receipt["scope"] == "one_continuation"
+        assert resume.resumed_after(conn, task, helpers.T0)
+
+
+@pytest.mark.parametrize("boundary", ["assigned", "continued", "changes_requested", "claimed"])
+def test_any_later_transition_invalidates_an_earlier_observation(kanban_home, clock, monkeypatch, boundary):
+    # The other half of the rule: a hold seen before the latest transition says nothing about now.
+    with kbc.connect_closing() as conn:
+        task = helpers._held(conn)
+        clock[0] += 10
+        with kb.write_txn(conn):
+            kb._append_event(conn, task, "promoted")
+            kb._append_event(conn, task, "respawn_guarded", {"reason": "active_pr"})
+            kb._append_event(conn, task, boundary)
+        monkeypatch.setattr(dispatch, "check_respawn_guard", lambda *_: None)
+        with pytest.raises(resume.ResumeRefused, match="guard: none"):
+            resume.resume(conn, task, reason="stale hold", actor="operator")
+
+
 @pytest.mark.parametrize("mode", ["absent", "old", "other", "claimed"])
 def test_observation_must_be_in_current_ready_episode(kanban_home, clock, monkeypatch, mode):
     with kbc.connect_closing() as conn:
diff --git a/tests/hermes_cli/test_kanban_operator_resume_worker_copy.py b/tests/hermes_cli/test_kanban_operator_resume_worker_copy.py
index 17caf657a4..0400b64952 100644
--- a/tests/hermes_cli/test_kanban_operator_resume_worker_copy.py
+++ b/tests/hermes_cli/test_kanban_operator_resume_worker_copy.py
@@ -133,6 +133,35 @@ def test_home_resume_accepts_worker_only_observation(gws, clock, monkeypatch):
     assert _status(worker.conn, tid) == "running"
 
 
+def test_home_resume_accepts_a_worker_hold_recorded_after_a_reassign(gws, clock, monkeypatch):
+    """t_01a1d120e7d7c686, 2026-11-12: a same-profile reassign on the hub, the workers re-held the card 3 s later,
+    and hub ``resume`` refused with "guard: none". The hub's DB holds only the replicated worker events."""
+    hub, worker = gws
+    tid = _held_on_worker(gws, clock)
+    hub.enter()
+    clock[0] += 30
+    assert kb.assign_task(hub.conn, tid, "default")
+    hub.round()
+    worker.round()
+    clock[0] += 3
+    worker.tick()  # the worker's own guard holds the copy again, after the reassign
+    assert _status(worker.conn, tid) == "ready"
+    worker.round()
+    hub.round()
+    hub.enter()
+    held_after = [e for e in kb.list_events(hub.conn, tid) if e.kind in ("assigned", "respawn_guarded")]
+    assert [e.kind for e in held_after][-2:] == ["assigned", "respawn_guarded"]  # replicated, not hub-written
+    clock[0] += 30
+    with monkeypatch.context() as patch:
+        patch.setattr(kbd, "check_respawn_guard", lambda *_: None)
+        resume.resume(hub.conn, tid, reason="runner-only hold after reassign", actor="operator")
+    hub.round()
+    worker.round()
+    clock[0] += 5
+    worker.tick()
+    assert _status(worker.conn, tid) == "running"
+
+
 def test_without_a_resume_the_kept_copy_stays_held(gws, clock):
     hub, worker = gws
     tid = _held_on_worker(gws, clock)
