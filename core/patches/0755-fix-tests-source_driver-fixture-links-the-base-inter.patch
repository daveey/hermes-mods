From 437b89b73e051425ffa6a741c3b8e69cc2e8d84e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 06:46:35 -0700
Subject: [PATCH] fix(tests): source_driver fixture links the base interpreter;
 packaged-launch test counts launches, not every subprocess.run [daveey]

Both failed on macOS only under a venv interpreter whose binary is a copy
(the checkout's venv/bin/python, 3.11, no psutil):
- test_source_driver pm_observer x7: the store python was a symlink to
  sys.executable; a copied venv binary finds its stdlib only via the
  pyvenv.cfg beside it, so the linked runtime died with 'No module named
  encodings' and the launcher's --print-runtime-command exited 1.
  Link the base interpreter (sys._base_executable) instead.
- test_current_packaged_launch_does_not_require_npm: without psutil,
  update_lock.process_create_time falls back to 'ps -o lstart=' on macOS
  through the same (mocked, module-global) subprocess.run, so
  assert_called_once saw 2 calls. Assert exactly one launch and no
  npm/npx/node instead.
---
 tests/hermes_cli/test_desktop_startup_cost.py |  7 ++++++-
 tests/scripts/test_source_driver.py           | 11 ++++++++---
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/tests/hermes_cli/test_desktop_startup_cost.py b/tests/hermes_cli/test_desktop_startup_cost.py
index fbe36d5a56..57500bed4d 100644
--- a/tests/hermes_cli/test_desktop_startup_cost.py
+++ b/tests/hermes_cli/test_desktop_startup_cost.py
@@ -42,5 +42,10 @@ def test_current_packaged_launch_does_not_require_npm(tmp_path, monkeypatch):
         desktop.cmd_gui(args)
     assert exited.value.code == 0
     npm.assert_not_called()
-    run.assert_called_once()
+    # subprocess.run is the shared module attribute, so it also sees helper probes that
+    # are not part of the launch (e.g. update_lock's `ps -o lstart=` start-time fallback
+    # on a macOS interpreter without psutil). The contract is one launch, no build tools.
+    argvs = [list(c.args[0]) for c in run.call_args_list]
+    assert argvs.count([str(executable)]) == 1, argvs
+    assert not any(Path(a[0]).name in {"npm", "npx", "node"} for a in argvs), argvs
 
diff --git a/tests/scripts/test_source_driver.py b/tests/scripts/test_source_driver.py
index 7816551b8b..21d8b3ff8c 100644
--- a/tests/scripts/test_source_driver.py
+++ b/tests/scripts/test_source_driver.py
@@ -167,7 +167,7 @@ def test_pm_observer_accepts_ready_fixture_and_leaves_failed_fixture_untouched(t
     assert node
     setup = '''import sys
 from pathlib import Path
-root, store, node, deps = map(Path, sys.argv[1:])
+root, store, node, deps, runtime = map(Path, sys.argv[1:])
 sys.path.insert(0, str(root))
 from pm.lock import Facts, Lockfile
 from pm.packages import Venv
@@ -176,7 +176,7 @@ from hermes_cli._launchers import ensure_install_launchers
 lock = Lockfile(root / 'pm/lock.json')
 lock.set_pin('node', 'fixture', {})
 lock.save()
-for name, executable in [('python', Path(sys.executable)), ('node', node)]:
+for name, executable in [('python', runtime), ('node', node)]:
     binary = store / name / 'bin' / ('python3' if name == 'python' else name)
     binary.parent.mkdir(parents=True)
     binary.symlink_to(executable)
@@ -190,8 +190,13 @@ site.symlink_to(deps, target_is_directory=True)
 Facts(runtime_facts_path(root)).record_state('venv', Venv(root).expected_stamp([]), [], environment=selected)
 ensure_install_launchers(root, root / '.hermes/bin')
 '''
+    # The store's python must be a self-contained runtime: a venv interpreter only finds its
+    # stdlib through the pyvenv.cfg beside it, and a copied venv binary (macOS) linked from
+    # the store has none, so link the base interpreter the venv was made from.
+    base = getattr(sys, "_base_executable", None)
+    runtime = os.path.realpath(base if base and os.path.isfile(base) else sys.executable)
     subprocess.run([sys.executable, "-I", "-B", "-c", setup, str(root), str(store), node,
-                    sysconfig.get_path("purelib")], env=env, cwd=tmp_path, check=True, timeout=60)
+                    sysconfig.get_path("purelib"), runtime], env=env, cwd=tmp_path, check=True, timeout=60)
     build = root / "scripts/build"
     build.mkdir(parents=True)
     for name in ("freshness.mjs", "frontend-common.mjs"):
