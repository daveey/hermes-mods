From 720953a4f56c9cc2b575a685467d90076e4c5825 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 24 Nov 2026 19:11:58 +0000
Subject: [PATCH 6211] Owning-chat stop-only control for ended shadow work

Public mirror of source commit 720953a4f56c9cc2b575a685467d90076e4c5825.

---
diff --git a/tests/hermes_cli/test_kanban_source_receipt_sites.py b/tests/hermes_cli/test_kanban_source_receipt_sites.py
index 857f323463e..203dac1df79 100644
--- a/tests/hermes_cli/test_kanban_source_receipt_sites.py
+++ b/tests/hermes_cli/test_kanban_source_receipt_sites.py
@@ -341,6 +341,7 @@
 }
 # Sites the scan cannot prove off-``running`` from SQL text alone, each checked by hand.
 NOT_FROM_RUNNING = {
+    "hermes_cli/kanban_stop_ended.py::apply": "owner stop requires non-running, unclaimed target with an ended run and no open runs under the writer transaction",
     "hermes_cli/kanban_protect_stopped.py::protect": "stop-only adoption requires an ended-run, unclaimed triage/archived target (no current run) under the writer transaction",
     "hermes_cli/kanban_review_admission.py::record_refusal": "only ready/review lanes; writer transaction requires matching unclaimed row",
     "hermes_cli/kanban_containment_lifecycle.py::resume_local": "requires unclaimed triage under the writer transaction",
diff --git a/tools/kanban_stop_ended_tools.py b/tools/kanban_stop_ended_tools.py
index d61ccabbefb..bc81d642505 100644
--- a/tools/kanban_stop_ended_tools.py
+++ b/tools/kanban_stop_ended_tools.py
@@ -16,8 +16,8 @@
                  'items': {'type': 'string', 'minLength': 1, 'maxLength': 512}},
     'escalate_at': {'type': 'integer', 'description': 'Fixed future Unix deadline, at most 14 days out; never renewed.'}}
 SCHEMA = _schema('kanban_stop_ended',
-    'Owning interactive chat only: stop an ENDED card on a local-executing shadow board, leaving it incomplete, '
-    'nonexecuting and in triage with dependencies unsatisfied. Without expected_digest returns a read-only '
+    'Owning chat: stop an ended shadow-board card without completing it. Leaves it nonexecuting in triage, '
+    'with dependencies unsatisfied. Without expected_digest returns a read-only '
     'snapshot/readback. Receipt is LOCAL-SHADOW-ONLY (canonical_protected false); published to the hub only '
     'through the ordinary outbox once the Board advertises admin_stop_ingress. Never a release or completion.',
     _PROPERTIES, ['task_id'])
