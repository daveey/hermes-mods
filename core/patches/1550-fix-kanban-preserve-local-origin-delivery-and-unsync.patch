Subject: [PATCH] fix(kanban): preserve local origin delivery and unsynced
 reads [daveey]

---
 hermes_cli/kanban_chat_links.py        | 13 +++++++------
 hermes_cli/kanban_creator_chats.py     |  8 ++++++--
 tests/hermes_cli/test_kanban_origin.py |  3 +++
 3 files changed, 16 insertions(+), 8 deletions(-)

diff --git a/hermes_cli/kanban_chat_links.py b/hermes_cli/kanban_chat_links.py
index ffb1c214fcf..02e5d27b777 100644
--- a/hermes_cli/kanban_chat_links.py
+++ b/hermes_cli/kanban_chat_links.py
@@ -54,12 +54,13 @@ def _local_links(conn: sqlite3.Connection, gateway: str) -> dict[str, dict[str,
         out[uid] = {"uid": uid, "task_id": task_id, "chat_gateway": gateway, "chat_profile": None,
                     "chat_session": session, "kind": kind, "released": 0, "created_at": int(created_at or now)}
 
-    for row in conn.execute(
-            "SELECT l.* FROM task_chat_links l WHERE l.chat_gateway=? AND l.kind='created' "
-            "AND EXISTS (SELECT 1 FROM task_events e WHERE e.task_id=l.task_id "
-            "AND e.kind='creator_chats_resolved')", (gateway,)):
-        if not _worker_shepherd(row["chat_session"], row["kind"]):
-            out[row["uid"]] = dict(row)
+    if conn.execute("SELECT 1 FROM sqlite_master WHERE name='task_chat_links'").fetchone():
+        for row in conn.execute(
+                "SELECT l.* FROM task_chat_links l WHERE l.chat_gateway=? AND l.kind='created' "
+                "AND EXISTS (SELECT 1 FROM task_events e WHERE e.task_id=l.task_id "
+                "AND e.kind='creator_chats_resolved')", (gateway,)):
+            if not _worker_shepherd(row["chat_session"], row["kind"]):
+                out[row["uid"]] = dict(row)
     for task_id, session, created_at in conn.execute(
             "SELECT id, session_id, created_at FROM tasks WHERE session_id IS NOT NULL AND session_id != ''"):
         add(task_id, session, "created", created_at)
diff --git a/hermes_cli/kanban_creator_chats.py b/hermes_cli/kanban_creator_chats.py
index 1c624e46aea..90c5216f9bd 100644
--- a/hermes_cli/kanban_creator_chats.py
+++ b/hermes_cli/kanban_creator_chats.py
@@ -24,11 +24,15 @@ def initialize_ownership(conn, task_id, creator_task_id, parents, created_at, ch
     _append_event(conn, task_id, "creator_chats_resolved", {"explicit_origin": origin.ref})
     if is_headless_session(origin.session):
         return
+    from hermes_cli.kanban_origin import gateway_names
+    from hermes_cli.profiles import get_active_profile_name
+    local = origin.gateway == gateway_names()[0] and origin.profile == get_active_profile_name()
+    platform, chat_id = ("tui", origin.session) if local else ("hub", origin.chat_id)
     conn.execute(
         "INSERT OR IGNORE INTO kanban_notify_subs "
         "(task_id,platform,chat_id,thread_id,delivery_mode,delivery_metadata,created_at,last_event_id) "
-        "VALUES (?,'hub',?,'','notify',?, ?, (SELECT COALESCE(MAX(id),0) FROM task_events WHERE task_id=?))",
-        (task_id, origin.chat_id, json.dumps({"reason": "origin"}), created_at, task_id))
+        "VALUES (?,?,?,'','notify',?, ?, (SELECT COALESCE(MAX(id),0) FROM task_events WHERE task_id=?))",
+        (task_id, platform, chat_id, json.dumps({"reason": "origin"}), created_at, task_id))
     if conn.execute("SELECT 1 FROM sqlite_master WHERE name='task_chat_links'").fetchone():
         conn.execute(
             "INSERT OR IGNORE INTO task_chat_links "
