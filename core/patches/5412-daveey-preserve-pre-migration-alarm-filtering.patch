From 7bb442ef2b68e12a224addaf9e79610f6b64ea49 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 05:57:37 +0000
Subject: [PATCH] [daveey] preserve pre-migration alarm filtering

Keep the original minimal-schema regression unchanged. Before sync migration, project NULL AS alarm_source so legacy provenance and source exclusion still apply. CI exposed the missing-column path; canonical source-exclusion, parity, sync and worker tests pass.
---
 hermes_cli/kanban_worker_node.py                        | 4 +++-
 tests/hermes_cli/test_kanban_pickup_source_exclusion.py | 6 +++---
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_worker_node.py b/hermes_cli/kanban_worker_node.py
index 1a2fa8d1d8..d9edeaa341 100644
--- a/hermes_cli/kanban_worker_node.py
+++ b/hermes_cli/kanban_worker_node.py
@@ -441,8 +441,10 @@ def local_refusals(conn: sqlite3.Connection, status: str) -> dict[str, str]:
     if sync.board_mode(conn) != "primary":
         return out
     own = _own(conn)
+    columns = {row[1] for row in conn.execute("PRAGMA table_info(tasks)")}
+    source = "alarm_source" if "alarm_source" in columns else "NULL AS alarm_source"
     rows = conn.execute(
-        "SELECT id, runs_on, created_on, alarm_source, created_by, idempotency_key, workspace_kind FROM tasks "
+        f"SELECT id, runs_on, created_on, {source}, created_by, idempotency_key, workspace_kind FROM tasks "
         "WHERE status = ? AND claim_lock IS NULL "
         "AND (runs_on IS NOT NULL OR (created_on IS NOT NULL AND created_on != ?) "
         "OR created_by = 'pickup-stall-detector' OR idempotency_key LIKE 'pickup-stall:%' "
diff --git a/tests/hermes_cli/test_kanban_pickup_source_exclusion.py b/tests/hermes_cli/test_kanban_pickup_source_exclusion.py
index 8c4d65996c..10c093f594 100644
--- a/tests/hermes_cli/test_kanban_pickup_source_exclusion.py
+++ b/tests/hermes_cli/test_kanban_pickup_source_exclusion.py
@@ -68,9 +68,9 @@ def test_local_dispatch_refuses_without_labels_or_registry(monkeypatch, origin,
     with sqlite3.connect(":memory:") as conn:
         conn.row_factory = sqlite3.Row
         conn.execute("CREATE TABLE tasks (id, runs_on, created_on, created_by, idempotency_key, "
-                     "workspace_kind, status, claim_lock, alarm_source)")
-        conn.execute("INSERT INTO tasks VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                     "workspace_kind, status, claim_lock)")
+        conn.execute("INSERT INTO tasks VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
                      ("alarm", None, origin, "pickup-stall-detector",
-                      "pickup-stall:worker-1:queue-full:1794700000000", "scratch", "ready", None, None))
+                      "pickup-stall:worker-1:queue-full:1794700000000", "scratch", "ready", None))
         assert wn.local_refusals(conn, "ready") == {"alarm": reason}
 
-- 
2.43.0

