From 69c52e94023cd3eefcebc8e77a6b24d5d194f631 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 01:19:21 -0700
Subject: [PATCH] fix(desktop): move-to-project creates the folder when the
 gateway lacks it [daveey]
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A merged project lane keeps the active gateway's row, which can belong to
another profile — e.g. hub's `alpha` "fabric" project rooted at the Docker
image's /opt/data/code/fabric-play. Moving a default-profile session there
took the fast path, sent that container path verbatim, and the host refused
it ("working directory does not exist").

Now a refused folder falls through to ensureProjectRootOn: the session's own
profile reuses its same-named project (making its folder if that is the
missing one) or gets the project created at the home-relative folder, with
/opt/data now mapped to ~ like /Users/<u>, /home/<u> and /root.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../store/projects-cross-gateway-move.test.ts | 95 +++++++++++++++++++
 apps/desktop/src/store/projects.ts            | 59 +++++++++---
 2 files changed, 142 insertions(+), 12 deletions(-)

diff --git a/apps/desktop/src/store/projects-cross-gateway-move.test.ts b/apps/desktop/src/store/projects-cross-gateway-move.test.ts
index c6109cad2f..6e5a584507 100644
--- a/apps/desktop/src/store/projects-cross-gateway-move.test.ts
+++ b/apps/desktop/src/store/projects-cross-gateway-move.test.ts
@@ -189,6 +189,99 @@ describe('moveSessionToProject across gateways', () => {
   })
 })
 
+describe('moveSessionToProject into a lane whose folder this gateway lacks', () => {
+  // Another profile on the active gateway (a Docker one) owns the lane, so its
+  // root is a container path the host refuses.
+  const DOCKER_PATH = '/opt/data/code/fabric-play'
+
+  const refusing =
+    (extra: Handler): Handler =>
+    (method, params) => {
+      if (method === 'session.workspace.move' && params.cwd === DOCKER_PATH) {
+        throw new Error(`working directory does not exist: ${DOCKER_PATH}`)
+      }
+
+      if (method === 'session.workspace.move') {
+        return { branch: null, cwd: params.cwd, git_repo_root: null }
+      }
+
+      return extra(method, params)
+    }
+
+  beforeEach(() => {
+    $projectTree.set([{ id: 'p_docker', label: 'fabric', path: DOCKER_PATH, repos: [], sessionCount: 1 }])
+  })
+
+  it("creates the project in the session's home instead of failing", async () => {
+    setup(
+      refusing(method =>
+        method === 'projects.list'
+          ? { active_id: null, projects: [] }
+          : method === 'shell.exec'
+            ? { code: 0, stderr: '', stdout: '' }
+            : method === 'projects.create'
+              ? { project: { id: 'p_new', name: 'fabric', primary_path: '/home/ubuntu/code/fabric-play' } }
+              : {}
+      ),
+      () => {
+        throw new Error('no remote call expected')
+      }
+    )
+
+    await moveSessionToProject('local-s', 'p_docker', 'default')
+
+    // Background refreshes (projects.tree, a post-create projects.list) interleave; only the move's own calls count.
+    const firstList = localCalls.findIndex(([m]) => m === 'projects.list')
+    const steps = localCalls.filter(([m], i) => m !== 'projects.tree' && (m !== 'projects.list' || i === firstList))
+
+    expect(steps.map(([m]) => m)).toEqual([
+      'session.workspace.move',
+      'projects.list',
+      'shell.exec',
+      'projects.create',
+      'session.workspace.move'
+    ])
+    expect(steps[2][1]).toMatchObject({ command: `mkdir -p "$HOME"/'code/fabric-play'` })
+    expect(steps[3][1]).toMatchObject({ name: 'fabric', primary_path: '~/code/fabric-play' })
+    expect(steps[4][1]).toMatchObject({ cwd: '/home/ubuntu/code/fabric-play', session_key: 'local-s' })
+  })
+
+  it("makes the folder of the session profile's own project at that path", async () => {
+    setup(
+      refusing(method =>
+        method === 'projects.list'
+          ? { active_id: null, projects: [{ id: 'p_docker', name: 'fabric', primary_path: DOCKER_PATH }] }
+          : method === 'shell.exec'
+            ? { code: 1, stderr: 'mkdir: /opt: Permission denied', stdout: '' }
+            : {}
+      ),
+      () => {
+        throw new Error('no remote call expected')
+      }
+    )
+
+    await expect(moveSessionToProject('local-s', 'p_docker', 'default')).rejects.toThrow(/Permission denied/)
+    expect(localCalls.map(([m]) => m)).toEqual(['session.workspace.move', 'projects.list', 'shell.exec'])
+    expect(localCalls.some(([m]) => m === 'projects.create')).toBe(false)
+  })
+
+  it('still surfaces any other move error', async () => {
+    setup(
+      method => {
+        if (method === 'session.workspace.move') {
+          throw new Error('session busy')
+        }
+
+        return {}
+      },
+      () => ({})
+    )
+
+    await expect(moveSessionToProject('local-s', 'p_docker', 'default')).rejects.toThrow(/session busy/)
+    expect(localCalls.map(([m]) => m)).toEqual(['session.workspace.move'])
+  })
+})
+
 describe('createProjectAndMoveSession', () => {
   it('creates an empty ~/code/<slug> folder + project, then moves the session', async () => {
     setup(
@@ -250,6 +343,8 @@ describe('cross-gateway move helpers', () => {
   it('maps home paths across hosts', () => {
     expect(homeRelativePath('/Users/me/code/myapp')).toBe('~/code/myapp')
     expect(homeRelativePath('/home/ubuntu/code/x')).toBe('~/code/x')
+    expect(homeRelativePath('/opt/data/code/fabric-play')).toBe('~/code/fabric-play')
+    expect(homeRelativePath('/opt/database')).toBe('/opt/database')
     expect(homeRelativePath('/srv/repo')).toBe('/srv/repo')
   })
 
diff --git a/apps/desktop/src/store/projects.ts b/apps/desktop/src/store/projects.ts
index 0c870b9bcd..08b0ffc105 100644
--- a/apps/desktop/src/store/projects.ts
+++ b/apps/desktop/src/store/projects.ts
@@ -1057,6 +1057,9 @@ function expireRemoteProjectTree(connectionId: string): void {
 
 const labelKey = (label: string): string => label.trim().toLowerCase()
 
+/** `session.workspace.move`'s refusal of a folder that doesn't exist on that host. */
+const MISSING_WORKDIR_RE = /working directory does not exist/
+
 /** Shell word for a path; a `~/` prefix stays expandable. */
 function shellPath(path: string): string {
   const quote = (s: string) => `'${s.replace(/'/g, `'\\''`)}'`
@@ -1064,9 +1067,12 @@ function shellPath(path: string): string {
   return path.startsWith('~/') ? `"$HOME"/${quote(path.slice(2))}` : quote(path)
 }
 
-/** `/Users/x/code/a` or `/home/x/code/a` → `~/code/a`, so it lands in the other host's home. */
+/**
+ * `/Users/x/code/a`, `/home/x/code/a`, `/root/code/a` or `/opt/data/code/a`
+ * (the Docker image's home) → `~/code/a`, so it lands in the other host's home.
+ */
 export function homeRelativePath(path: string): string {
-  const m = path.match(/^(?:\/Users|\/home)\/[^/]+(\/.*)?$/) ?? path.match(/^\/root(\/.*)?$/)
+  const m = path.match(/^(?:\/Users|\/home)\/[^/]+(\/.*)?$/) ?? path.match(/^\/(?:root|opt\/data)(\/.*)?$/)
 
   return m ? `~${m[1] ?? ''}` : path
 }
@@ -1107,9 +1113,15 @@ function projectSourceFor(node: SidebarProjectTree | undefined): null | { connec
 
 /**
  * The destination project's root folder ON `target`, creating the project
- * (and its folder) there when that gateway doesn't have it yet.
+ * (and its folder) there when that gateway doesn't have it yet. `missing` is a
+ * folder the target already refused: its own same-named project at that path
+ * gets the folder made instead of being returned again.
  */
-async function ensureProjectRootOn(target: MoveTarget, node: SidebarProjectTree | undefined): Promise<string> {
+async function ensureProjectRootOn(
+  target: MoveTarget,
+  node: SidebarProjectTree | undefined,
+  missing = ''
+): Promise<string> {
   if (!node || node.isNoProject) {
     return ''
   }
@@ -1125,6 +1137,12 @@ async function ensureProjectRootOn(target: MoveTarget, node: SidebarProjectTree
 
   const existingPath = existing?.primary_path || existing?.folders?.[0]?.path
 
+  if (existingPath && existingPath === missing) {
+    await makeFolderOn(target, existingPath)
+
+    return existingPath
+  }
+
   if (existingPath) {
     return existingPath
   }
@@ -1139,9 +1157,7 @@ async function ensureProjectRootOn(target: MoveTarget, node: SidebarProjectTree
   return createProjectFolderOn(target, node.label, homeRelativePath(source.path), profile)
 }
 
-/** `mkdir -p` the folder ON `target`, then register a project named `name` there. */
-async function createProjectFolderOn(target: MoveTarget, name: string, path: string, profile: string): Promise<string> {
-  // Projects only organize the sidebar here, so the folder just has to exist.
+async function makeFolderOn(target: MoveTarget, path: string): Promise<void> {
   const make = await moveTargetRequest<ShellResult>(target, 'shell.exec', {
     command: `mkdir -p ${shellPath(path)}`
   })
@@ -1149,6 +1165,12 @@ async function createProjectFolderOn(target: MoveTarget, name: string, path: str
   if (make.code !== 0) {
     throw new Error(`Could not create ${path} on ${target.connectionId}: ${(make.stderr || make.stdout).trim()}`)
   }
+}
+
+/** `mkdir -p` the folder ON `target`, then register a project named `name` there. */
+async function createProjectFolderOn(target: MoveTarget, name: string, path: string, profile: string): Promise<string> {
+  // Projects only organize the sidebar here, so the folder just has to exist.
+  await makeFolderOn(target, path)
 
   const created = await moveTargetRequest<{ project: null | ProjectInfo }>(target, 'projects.create', {
     name,
@@ -1182,11 +1204,24 @@ export async function moveSessionToProject(
   // [daveey] The session's OWN gateway does the move, and the destination is
   // that gateway's copy of the project — created there (folder cloned if
   // needed) when only another gateway has it. The fast path below is the
-  // original single-gateway behavior.
-  const cwd =
-    !target.remote && node && !isRemoteProjectId(node.id) && projectRootCwd(node)
-      ? projectRootCwd(node)
-      : await ensureProjectRootOn(target, node)
+  // original single-gateway behavior; a merged lane can carry another
+  // profile's folder (a Docker profile's `/opt/data/...`) that this host
+  // lacks, so a refused folder falls through to the create-it-here path.
+  const fast = !target.remote && node && !isRemoteProjectId(node.id) ? projectRootCwd(node) : ''
+
+  if (fast) {
+    try {
+      await moveSessionToCwd(target, sessionId, fast)
+
+      return
+    } catch (error) {
+      if (!MISSING_WORKDIR_RE.test(String((error as Error)?.message ?? error))) {
+        throw error
+      }
+    }
+  }
+
+  const cwd = await ensureProjectRootOn(target, node, fast)
 
   if (!cwd) {
     throw new Error(translateNow('sidebar.projects.moveNoFolder'))
