From b5575c95128825360bb403972a18528b8c0f31e1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:32:03 +0000
Subject: [PATCH] fix(kanban): preserve outbox ordering for failure releases
 [daveey]

---
 hermes_cli/kanban_failure_release.py           |  8 +++++---
 .../test_kanban_failure_release_order.py       | 18 ++++++++++++++++++
 2 files changed, 23 insertions(+), 3 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_failure_release_order.py

diff --git a/hermes_cli/kanban_failure_release.py b/hermes_cli/kanban_failure_release.py
index 64ea3881c1..69123c7379 100644
--- a/hermes_cli/kanban_failure_release.py
+++ b/hermes_cli/kanban_failure_release.py
@@ -8,7 +8,6 @@ from __future__ import annotations
 
 import json
 import sqlite3
-import time
 
 from hermes_cli import kanban_db_sync as sync
 
@@ -60,7 +59,10 @@ def queue(conn: sqlite3.Connection, task_id: str, run_id: int | None, *,
                             (uid, task_id, op_id)).rowcount
     if inserted:
         fields = {**policy, "run_uid": uid, "outcome": outcome, "error": error[:500]}
+        # Same millisecond clock as captured rows: a release may reference a
+        # systemic fix card created earlier in this transaction.
         conn.execute("INSERT INTO kanban_sync_outbox "
-                     "(op_id,table_name,row_uid,op,fields,hlc,created_at) VALUES (?, 'tasks', ?, 'release', ?, '', ?)",
-                     (op_id, task_id, json.dumps(fields), int(time.time())))
+                     "(op_id,table_name,row_uid,op,fields,hlc,created_at) "
+                     f"VALUES (?, 'tasks', ?, 'release', ?, '', {sync._NOW_MS_SQL})",
+                     (op_id, task_id, json.dumps(fields)))
     return True
diff --git a/tests/hermes_cli/test_kanban_failure_release_order.py b/tests/hermes_cli/test_kanban_failure_release_order.py
new file mode 100644
index 0000000000..650667330c
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_failure_release_order.py
@@ -0,0 +1,18 @@
+"""Release commands must not overtake the fix card they reference."""
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli import kanban_db_sync as sync, kanban_failure_release as release
+from tests.hermes_cli import test_kanban_failure_transport as support
+
+live = support.live
+
+
+def test_release_follows_same_transaction_fix_card(live):
+    tid, rid = support._running(live)
+    with kbc.write_txn(live):
+        fix = kb.create_task(live, title='systemic owner fixture', assignee='worker')
+        release.queue(live, tid, rid, outcome='crashed', error='fixture', extra={'fix_card': fix})
+    rows = sync.outbox(live)
+    parent = next(i for i, r in enumerate(rows) if r['table_name'] == 'tasks' and r['row_uid'] == fix)
+    command = next(i for i, r in enumerate(rows) if r['op'] == 'release')
+    assert parent < command, [(r['op'], r['row_uid'], r['created_at']) for r in rows]
+    assert rows[parent]['created_at'] <= rows[command]['created_at']
-- 
