From 80d22d01d9c1a688a9d6739fbd1e1cbb6e4c1e39 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 04:56:11 +0000
Subject: [PATCH] fix(kanban): filter remembered publication lookup eligibility
 [daveey]

---
 hermes_cli/kanban_replica_aggregates.py       | 16 +++++++++++++++-
 .../test_kanban_replica_bystander_memory.py   | 19 +++++++++++++++++++
 2 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_replica_aggregates.py b/hermes_cli/kanban_replica_aggregates.py
index 7f9698fd6f..ddb8208e04 100644
--- a/hermes_cli/kanban_replica_aggregates.py
+++ b/hermes_cli/kanban_replica_aggregates.py
@@ -61,7 +61,21 @@ class BorrowedSet:
 def remembered_publications(moved, previous):
     published = moved.get('published')
     if isinstance(published, Published):
-        keys = {(c.get('board'), c.get('id'), c.get('created_at')) for c in previous or ()}
+        keys = set()
+        for card in previous or ():
+            # Match _retire_moved's eligibility before touching publication keys.
+            if card.get('ownership_state') != 'qualified' or card.get('created_at') is None:
+                continue
+            scope = (card.get('gateway'), card.get('owner_profile'), card.get('board'))
+            if scope not in moved.get('live_scopes', ()):
+                continue
+            key = (card.get('board'), card.get('id'), card.get('created_at'))
+            try:
+                hash(key)
+            except TypeError:
+                # Leave malformed eligible cards to the original retirement path.
+                continue
+            keys.add(key)
         moved['published'] = published.lookup_many(keys)
 
 
diff --git a/tests/hermes_cli/test_kanban_replica_bystander_memory.py b/tests/hermes_cli/test_kanban_replica_bystander_memory.py
index 89cb69b24f..2e56708f13 100644
--- a/tests/hermes_cli/test_kanban_replica_bystander_memory.py
+++ b/tests/hermes_cli/test_kanban_replica_bystander_memory.py
@@ -388,6 +388,25 @@ def test_legacy_reader_borrows_closed_and_bulk_resolves_publications(hub, monkey
     activity._legacy_remote_links()
 
 
+@pytest.mark.parametrize('ownership,created', [('unknown', []), ('unknown', {}), ('qualified', [])])
+def test_ineligible_remembered_publication_does_not_poison_reads(hub, monkeypatch, ownership, created):
+    from hermes_cli import kanban_session_activity as activity
+    path, put, _, _ = hub
+    monkeypatch.setattr(activity, '_hub_db_path', lambda: path)
+    monkeypatch.setattr(activity, '_remote_snapshot', lambda *args: [])
+    put('t_current')
+    previous = [{'id': 't_old', 'key': 'absent/build/t_old', 'gateway': 'absent',
+                 'owner_profile': 'work', 'board': 'build', 'session': 's1',
+                 'created_at': created, 'ownership_state': ownership}]
+    activity._remote_last = previous
+    activity._remote_scope = activity._origin_scope()
+    first = activity._legacy_remote_links()
+    assert any(c['id'] == 't_current' and not c.get('stale') for c in first)
+    put('t_next')
+    second = activity._legacy_remote_links()
+    assert any(c['id'] == 't_next' and not c.get('stale') for c in second)
+
+
 @pytest.mark.parametrize('outcome', ['closed', 'moved', 'same-gateway-profile'])
 def test_remembered_bystander_retirement_matches_full_reader(hub, monkeypatch, outcome):
     import json
