+    def _state_gates(self, registry):
+        """Start's lease-independent gates after coverage, in start's order (one list each)."""
+        view, _ = self._registry_view(registry, inventory=True)
+        yield [f"unknown:{u}" for u in view["unknowns"]]
+        update, update_reasons = self._update_status()
+        yield [f"update:{r}" for r in update_reasons]
+        stale = update["window_age_s"] is None or update["window_age_s"] > UPDATE_WINDOW_MAX_AGE_S
+        yield ["update_window_stale"] if stale else []
+
+    def check(self, params, peer):
+        """Read-only preflight (``hermes kanban quiet-hold --check``): what ``start`` would refuse
+        apart from the lease and the observer's identity, without arming an episode, reading or
+        taking a lease, or reserving work (a bookkeeping verb: the registry epoch does not move)."""
+        if not isinstance(params, dict) or set(params) != {"schema"} or params["schema"] != SCHEMA:
+            raise ValueError(f"params fields must be exactly: schema (= {SCHEMA})")
+        registry = self._registry()
+        reasons = self._pending(registry)
+        unknowns: list[str] = []
+        if registry is not None:
+            for gate in self._state_gates(registry):
+                reasons += gate
+            unknowns = [r[len("unknown:"):] for r in reasons if r.startswith("unknown:")]
+        ledger = getattr(self._runner, "_quiet_code", None)
+        try:
+            route = ledger.route_report().get("route") if ledger is not None else None
+        except Exception:  # health: allow BLE001 -- an unreadable route is reported as none, never invented
+            route = None
+        return {"schema": SCHEMA, "phase": "check", "admitted": not reasons, "reasons": reasons,
+                "registry_unknowns": unknowns, "route": route,
+                "activity_epoch": registry.snapshot().epoch if registry is not None else None}
+
     def _follow(self, params, peer, phase):
         _check_params(params, _FOLLOW_KEYS)
         return self._authenticate(params, peer)
diff --git a/hermes_cli/_launch_template.py b/hermes_cli/_launch_template.py
index 4c0a8c3afd..8efab2d151 100644
--- a/hermes_cli/_launch_template.py
+++ b/hermes_cli/_launch_template.py
@@ -189,6 +189,32 @@ def render(root: str, module: str, func: str) -> str:
     )
 
 
+def relaunch_prefix(root: str, argv: list[str]) -> str:
+    """The single-line source ``venv_sync.relaunch_command`` puts before the re-entry body.
+
+    One stdlib-only definition shared by the producer (``venv_sync``) and the bootstrap-time
+    attestation, which compares a relaunched child's ``-c`` source to it byte for byte.
+    Selects deps before run_path: ``__setitem__`` returns None, so the ``or`` still execs the
+    module; registering it first keeps a later import from re-entering prepare_launch under a
+    HERMES_HOME the script has not set yet. ``_hermes_relaunched`` marks the child this starts
+    (not processes it spawns) for ``venv_sync._relaunch_target``.
+    """
+    return (
+        f"import sys, runpy; sys.path.insert(0, {root!r}); sys.argv = {argv!r}; "
+        "sys._hermes_relaunched = True; "
+        "import importlib.util as _iu, pathlib as _pl; "
+        f"_bp = _pl.Path({root!r}) / 'hermes_bootstrap.py'; "
+        "_spec = _iu.spec_from_file_location('hermes_bootstrap', _bp) if _bp.is_file() else None; "
+        "_mod = _iu.module_from_spec(_spec) if _spec is not None else None; "
+        "(sys.modules.__setitem__('hermes_bootstrap', _mod) or _spec.loader.exec_module(_mod)) "
+        "if _mod is not None else None; "
+    )
+
+
+# The fixed start of every relaunch source (the root literal follows it).
+RELAUNCH_HEAD = "import sys, runpy; sys.path.insert(0, "
+
+
 def split_pin_marker(script: str) -> tuple[str, str] | None:
     """Split at the single pin marker: (head, tail) both excluding the marker, else None."""
     if script.count(PIN_MARKER) != 1:
diff --git a/hermes_cli/code_attestation.py b/hermes_cli/code_attestation.py
