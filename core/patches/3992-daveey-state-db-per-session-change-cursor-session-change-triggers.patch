+    shutil.copy(path, tmp_path / "restored.db")
+    os.replace(tmp_path / "restored.db", path)  # new inode (c)
+    fresh_reader = sqlite3.connect(path, isolation_level=None)
+    try:
+        assert changed_since(fresh_reader, cur)[0] is FULL
+    finally:
+        fresh_reader.close()
