diff --git a/tests/hermes_cli/fixtures/t_01a180aae388e142_body.txt b/tests/hermes_cli/fixtures/t_01a180aae388e142_body.txt
new file mode 100644
index 0000000000..bf852593c8
--- /dev/null
+++ b/tests/hermes_cli/fixtures/t_01a180aae388e142_body.txt
@@ -0,0 +1,25 @@
+Found by the MacBook acceptance run for hub t_b11f0591 (card t_159f0063, run 5380, 2026-10-27 ~21:00 PDT). The evidence is on the hub at /home/ubuntu/.hermes/kanban/evidence/upkeep-system-20261022/t159f0063-run5380/ (READBACK.md first, neutral-review.log has the independent Opus confirmation).
+
+## Repro (live, MacBook, build 23b3a53bf3, which contains 236b07480e)
+- MacBook ~/.hermes/config.yaml has kanban.sync.links_reader: replica (RFC phase 5, core da1a3a8443).
+- Origin chat 20261022_204322_4d8ce1 (Upkeep): the sidebar row says kanban_active 14, "Waiting on 14 cards". GET /api/session-kanban-tasks returns 9 rows, and the session-tasks plugin's sessionTaskChips() turns those into 9 chips.
+- The 5 counted but unlisted cards are origin-ledger rows (via=origin, status unknown, reported_status done, unfinished=True, no verified release): hub t_ea3ff077, t_dcd9d210, t_23947fd6, t_1d83c05d, t_37fb8c09. All 5 are done on hub.
+- Read-only repro command on the MacBook: `cd ~/.hermes/hermes-agent && venv/bin/python -c "from hermes_cli import kanban_session_activity as k; s='20261022_204322_4d8ce1'; print(k._all_counts()[0].get(s), len(k.session_tasks([s])))"` prints `14 9`.
+- Fabric 20261023_231233_1ccf1c agrees (count 1+1 blocked, 2 rows). It has no done-unverified rows.
+- The neutral review counted 20 unknown+unfinished ledger rows across all chats. Each one is counted but never listed.
+
+## Root mechanism (file:line in core hermes_cli)
+1. kanban_session_activity._recompute_all_counts counts _remote_links(), the origin-ledger projection (~L1063). _replica_bucket counts unknown+unfinished as active (L466-467).
+2. session_tasks() reads _remote_cards() (L1347-1360). Under links_reader=replica, _remote_cards returns kanban_chat_links.replica_cards(), which filters `t.status IN (statuses)` (kanban_chat_links.py:135). A done-unverified card therefore never gets the `unknown` status that would keep it listed. The comment at L474-476 says both readers come from _remote_links and "can never disagree"; since da1a3a8443 that is false.
+3. Why it wasn't caught: links_diff (kanban_chat_links.py:167), the gate for switching the reader, skips ledger rows whose status is not open. It drops unknown+unfinished rows and reported clean (771/771). No test compares counts with the list in replica mode.
+4. Related replica-mode gaps, found by reading the source: replica_cards hard-codes stale=False and synced_at=now (L153), so an offline or old replica shows as fresh. It silently skips an unreadable replica (L136-138), so rows vanish instead of going stale. It hard-codes profile "default" in the key (L142), so the same id on two profiles of one gateway would collide.
+
+## Required fix (decided; do not re-litigate)
+- Counts and list must come from ONE projection for each links_reader mode. Either route the counts through the same reader, or keep the ledger's unknown+unfinished obligations in the replica path. The non-negotiable invariant: a done-without-verified-release card stays an `unknown` chip AND counts in both places, or (after verified release) disappears from both.
+- links_diff must compare unknown+unfinished rows, so it can't report clean while counts and list disagree.
+- replica_cards must mark rows stale from the replica's real sync age, mark an unreadable replica stale/unknown instead of dropping its rows, and carry the owner profile in the key.
+- Tests (RED first): counts vs session_tasks parity under links_reader=replica for every case: 1 active + 12 todo; blocked for review; done-unverified; offline/old replica; unreadable replica; same task id on two gateways and on two profiles; compression lineage; verified release; another chat still turns done.
+- Ship through the normal core patch-mirror/CI route and get the exact-head CI green. After it is installed on the MacBook, the readback must show the Upkeep count equal to the API row count.
+
+## After shipping
+Comment on t_159f0063 on the MacBook (cross_task) with the merged head, so the MacBook acceptance can rerun the live readback, the rendered-strip check and the final send. Do not close t_b11f0591 or tracker t_0d7a7294.
diff --git a/tests/hermes_cli/test_kanban_placement.py b/tests/hermes_cli/test_kanban_placement.py
index 80e921a1cf..b65f339eff 100644
--- a/tests/hermes_cli/test_kanban_placement.py
+++ b/tests/hermes_cli/test_kanban_placement.py
@@ -661,3 +661,55 @@ def test_identity_lookup_failure_without_a_pin_still_creates_locally(mac, monkey
     out = json.loads(kt._handle_create({"title": "unpinned card"}))
     assert out["ok"] and out["task_id"] and "placed" not in out, out
     assert _local_count() == 1
+
+
+# --- marker tuning: a passing MacBook mention is not a local-only need [daveey] ---
+
+_SIDEBAR_TITLE = (
+    "Fix sidebar count vs task strip split under kanban.sync.links_reader=replica (Upkeep 14 vs 9)")
+_SIDEBAR_BODY = (Path(__file__).parent / "fixtures" / "t_01a180aae388e142_body.txt").read_text()
+_MARKER_REMEDY = "if the work doesn't need this machine, archive and re-create with placement='hub'"
+
+
+def test_marker_cases_a_through_e():
+    """The five cases the marker tune is pinned to, verbatim."""
+    # (a) the work itself is a live verify on the MacBook.
+    a = decide({"title": "Verify 57094b7a60 live on the MacBook"})
+    assert a["where"] == "local" and a["why"].startswith("local marker"), a
+    assert "macbook" in a["why"].lower()
+    # (b) a hermes_cli fix that only names the MacBook as a verification step.
+    b = decide({"title": "Fix the hermes_cli session-activity projection",
+                "body": "Ship the hermes_cli fix, then verify live on the hub and the MacBook."})
+    assert b["where"] == "hub", b
+    # (c) Desktop DOM, CDP readback, or Chrome still needs this machine.
+    for text in ("Needs a Desktop DOM readback of the composer",
+                 "Needs a CDP readback of the sidebar",
+                 "Sign in with Chrome and read the cookie"):
+        c = decide({"title": "Read the live UI", "body": text})
+        assert c["where"] == "local" and c["why"].startswith("local marker"), (text, c)
+    # (d) t_01a180aae388e142 title and body, verbatim.
+    d = decide({"title": _SIDEBAR_TITLE, "body": _SIDEBAR_BODY})
+    assert d["where"] == "hub", d
+    # (e) a local-only skill still pins, even with no marker in the text.
+    e = decide({"title": "Weekly digest", "skills": ["apple-notes"]})
+    assert e["where"] == "local" and "skill apple-notes" in e["why"], e
+
+
+def test_local_marker_decision_is_in_the_create_result(mac):
+    """Auto-placement that stays local because of a text marker says so, with the remedy."""
+    from tools import kanban_tools as kt
+    out = json.loads(kt._handle_create({
+        "title": "Verify 57094b7a60 live on the MacBook",
+        "body": "Read the live sidebar on this machine.",
+    }))
+    assert out["ok"] and out.get("task_id") and _local_count() == 1, out
+    assert out["placement"] == {
+        "where": "local",
+        "why": "local marker: mentions 'macbook'",
+    }, out
+    assert out["remedy"] == _MARKER_REMEDY
+    # A card that goes to the hub, and one kept local for a structural reason, do not get that note.
+    hub = json.loads(kt._handle_create({"title": "Fix the flaky lint", "body": "Push it."}))
+    assert hub.get("placed", {}).get("gateway") == "hub" and "placement" not in hub, hub
+    structural = json.loads(kt._handle_create({"title": "Keep this one here", "goal_mode": True}))
+    assert structural["ok"] and "placed" not in structural and "placement" not in structural, structural
diff --git a/tests/tools/test_kanban_creator_archive.py b/tests/tools/test_kanban_creator_archive.py
new file mode 100644
index 0000000000..ad67bf30ff
--- /dev/null
+++ b/tests/tools/test_kanban_creator_archive.py
@@ -0,0 +1,88 @@
+"""A worker may archive an unclaimed card its own task created. [daveey]
+
+The scoped-worker mutation gate refuses every other task. That left a creator
+unable to delete a card kanban_create had just pinned local by mistake
+("the scoped worker can't archive it"). Archive is the exception: creator_task_id
+is the caller's task, and the card has not been claimed.
+"""
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli.kanban_db_connect import connect
+
+
+def _board(tmp_path, monkeypatch):
+    db = tmp_path / "board.db"
+    conn = connect(db)
+    owner = kb.create_task(conn, title="owner")
+    monkeypatch.setenv("HERMES_KANBAN_DB", str(db))
+    monkeypatch.setenv("HERMES_KANBAN_BOARD", "default")
+    monkeypatch.setenv("HERMES_KANBAN_TASK", owner)
+    monkeypatch.setenv("HERMES_KANBAN_RUN_ID", "1")
+    monkeypatch.delenv("HERMES_DELEGATED_CHILD_CONTEXT", raising=False)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    return conn, owner
+
+
+def _created(conn, owner, title="misplaced"):
+    return kb.create_task(conn, title=title, creator_task_id=owner)
+
+
+def test_worker_tool_archives_an_unclaimed_card_it_created(tmp_path, monkeypatch):
+    from tools import kanban_tools as kt
+
+    conn, owner = _board(tmp_path, monkeypatch)
+    child = _created(conn, owner)
+    assert kb.get_task(conn, child).claim_lock is None
+    out = json.loads(kt._handle_archive({"task_id": child}))
+    assert out["ok"] and out["task_id"] == child, out
+    assert kb.get_task(conn, child).status == "archived"
+    conn.close()
+
+
+def test_worker_tool_refuses_a_claimed_card_and_someone_elses(tmp_path, monkeypatch):
+    from tools import kanban_tools as kt
+
+    conn, owner = _board(tmp_path, monkeypatch)
+    claimed = _created(conn, owner, "claimed")
+    kb.claim_task(conn, claimed)
+    foreign = kb.create_task(conn, title="foreign")
+    claimed_out = json.loads(kt._handle_archive({"task_id": claimed}))
+    foreign_out = json.loads(kt._handle_archive({"task_id": foreign}))
+    assert claimed_out.get("ok") is not True and "claim" in claimed_out["error"].lower(), claimed_out
+    assert foreign_out.get("ok") is not True and owner in foreign_out["error"], foreign_out
+    assert kb.get_task(conn, claimed).status == "running"
+    assert kb.get_task(conn, foreign).status == "ready"
+    conn.close()
+
+
+def test_worker_cli_archives_only_an_unclaimed_card_it_created(tmp_path, monkeypatch, capsys):
+    from hermes_cli.kanban import _cmd_archive
+
+    conn, owner = _board(tmp_path, monkeypatch)
+    child = _created(conn, owner)
+    foreign = kb.create_task(conn, title="foreign")
+    assert _cmd_archive(SimpleNamespace(task_ids=[child], purge_ids=[])) == 0
+    assert kb.get_task(conn, child).status == "archived"
+    capsys.readouterr()
+    assert _cmd_archive(SimpleNamespace(task_ids=[foreign], purge_ids=[])) != 0
+    err = capsys.readouterr().err
+    assert owner in err and "archive" in err.lower()
+    assert kb.get_task(conn, foreign).status == "ready"
+    conn.close()
+
+
+def test_orchestrator_cli_can_still_archive_any_card(tmp_path, monkeypatch):
+    from hermes_cli.kanban import _cmd_archive
+
+    conn, _owner = _board(tmp_path, monkeypatch)
+    monkeypatch.delenv("HERMES_KANBAN_TASK")
+    foreign = kb.create_task(conn, title="foreign")
+    assert _cmd_archive(SimpleNamespace(task_ids=[foreign], purge_ids=[])) == 0
+    assert kb.get_task(conn, foreign).status == "archived"
+    conn.close()
