Subject: [PATCH] test(sidebar): migrate clock outcome consumers to light-blue
 state [daveey]

Public mirror of the source commit; see the accompanying feature documentation.

---
 tests/hermes_cli/test_kanban_session_outcome_tasks.py | 6 +++++-
 tests/tui_gateway/test_session_outcome_notices.py     | 3 ++-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_session_outcome_tasks.py b/tests/hermes_cli/test_kanban_session_outcome_tasks.py
index f9325e26e16..5d8762e19c8 100644
--- a/tests/hermes_cli/test_kanban_session_outcome_tasks.py
+++ b/tests/hermes_cli/test_kanban_session_outcome_tasks.py
@@ -242,7 +242,11 @@ def test_local_park_event_wait_is_derived(kanban_root):
     assert "clock" in cards["t_sched"]["wait"]["waiting_on"] or "slot" in cards["t_sched"]["wait"]["waiting_on"]
     decisions, waits = _items(["s1"])
     assert decisions == []
-    assert waits[0]["id"] == "t_sched" and waits[0]["state"] == "scheduled"
+    assert waits[0]["id"] == "t_sched" and waits[0]["state"] == "external_running"
+    assert waits[0]["wait_kind"] == "clock"
+    assert waits[0]["waited_since"] == 100.0
+    assert waits[0]["expected_s"] == 9_999_999_899.0
+    assert waits[0]["estimate_source"].startswith("wakes ")
 
 
 def test_fresh_and_stale_remote_waits_and_numeric_eta(kanban_root, monkeypatch):
diff --git a/tests/tui_gateway/test_session_outcome_notices.py b/tests/tui_gateway/test_session_outcome_notices.py
index 2dc42fd4702..9350e480c1d 100644
--- a/tests/tui_gateway/test_session_outcome_notices.py
+++ b/tests/tui_gateway/test_session_outcome_notices.py
@@ -110,7 +110,8 @@ def test_card_status_change_refreshes_and_marks_its_blocked_notice_stale(db):
 
     assert [(c["task_id"], c["status"], c["skipped"]) for c in changed] == [(tid, "scheduled", None)]
     stored = so.get_outcome(CHAT, db=db)
-    assert stored["kind"] == "waiting" and stored["on"][0]["state"] == "scheduled"
+    assert stored["kind"] == "waiting" and stored["on"][0]["state"] == "external_running"
+    assert stored["on"][0]["wait_kind"] == "clock"
     [row] = _notices(db)
     assert row["display_metadata"]["stale"] is True and row["display_metadata"]["stale_tasks"] == [tid]
 
