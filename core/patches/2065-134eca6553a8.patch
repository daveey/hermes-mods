diff --git a/agent/context_compressor_output_stubs.py b/agent/context_compressor_output_stubs.py
new file mode 100644
index 00000000000..20143e463d8
--- /dev/null
+++ b/agent/context_compressor_output_stubs.py
@@ -0,0 +1,86 @@
+"""Terminal/execute_code tool-result stubs for context compaction (split from context_compressor).
+
+Lossy stubs say so: a stub reading "1 lines output" for a 16-path listing let the post-compaction agent
+guess file names that were never written instead of re-listing the dir.
+"""
+
+import json
+import re
+from typing import Any
+
+
+def _json_dict(text: Any) -> dict:
+    """Parse ``text`` as a JSON object; ``{}`` for empty, invalid, or non-object input."""
+    try:
+        parsed = json.loads(text) if text else {}
+    except (json.JSONDecodeError, TypeError):
+        return {}
+    return parsed if isinstance(parsed, dict) else {}
+
+
+def _str_arg(args: dict, key: str, default: str = "") -> str:
+    """Coerce a parsed tool arg to ``str`` (models emit non-string values)."""
+    val = args.get(key, default)
+    return val if isinstance(val, str) else default if val is None else str(val)
+
+
+_OUTPUT_ELIDED_NOTE = "(output elided: re-run or list the dir to see it)"
+# Outputs this small stay verbatim through the ordinary prune pass (pressure demotion still stubs them).
+_KEEP_VERBATIM_MAX_LINES = 12
+_KEEP_VERBATIM_MAX_CHARS = 600
+_STUB_EDGE_LINE_CHARS = 80
+
+
+def _decoded_tool_output(content: str) -> str:
+    """The ``output`` text of a JSON terminal/execute_code result, else ``content`` itself. Counting
+    newlines in the JSON string saw only escaped newlines and reported every output as 1 line."""
+    parsed = _json_dict(content)
+    if not parsed:
+        return content
+    output = parsed.get("output")
+    return output if isinstance(output, str) else ""
+
+
+def _output_lines(content: str) -> list[str]:
+    text = _decoded_tool_output(content)
+    return text.splitlines() if text.strip() else []
+
+
+def _short_output_kept_verbatim(tool_name: str, content: str) -> bool:
+    """True when a terminal/execute_code result's output is a short listing worth keeping whole."""
+    if tool_name not in ("terminal", "execute_code"):
+        return False
+    lines = _output_lines(content)
+    return 0 < len(lines) <= _KEEP_VERBATIM_MAX_LINES and sum(len(x) for x in lines) <= _KEEP_VERBATIM_MAX_CHARS
+
+
+def _output_edges(content: str, content_len: int) -> str:
+    """`` (N chars); first: ...; last: ... (output elided ...)``: the stub keeps the output's first and last
+    non-blank lines and says the rest was dropped. Contains `` chars)`` so later passes see a stub."""
+    lines = [x.strip() for x in _output_lines(content) if x.strip()]
+
+    def clip(x: str) -> str:
+        return x if len(x) <= _STUB_EDGE_LINE_CHARS else x[:_STUB_EDGE_LINE_CHARS - 3] + "..."
+
+    if not lines:
+        return ""
+    edges = f"; first: {clip(lines[0])}"
+    if len(lines) > 1:
+        edges += f"; last: {clip(lines[-1])}"
+    return f" ({content_len:,} chars){edges} {_OUTPUT_ELIDED_NOTE}"
+
+
+def _sum_terminal(name, args, content, content_len, line_count):
+    cmd = _str_arg(args, "command")
+    cmd = cmd if len(cmd) <= 80 else cmd[:77] + "..."
+    exit_code = m.group(1) if (m := re.search(r'"exit_code"\s*:\s*(-?\d+)', content)) else "?"
+    return (
+        f"[terminal] ran `{cmd}` -> exit {exit_code}, {line_count} lines output"
+        + _output_edges(content, content_len)
+    )
+
+
+def _sum_execute_code(name, args, content, content_len, line_count):
+    code_str = _str_arg(args, "code")
+    code_preview = code_str[:60].replace("\n", " ") + ("..." if len(code_str) > 60 else "")
+    return f"[execute_code] `{code_preview}` ({line_count} lines output)" + _output_edges(content, content_len)
diff --git a/tests/agent/test_tool_result_summaries.py b/tests/agent/test_tool_result_summaries.py
new file mode 100644
index 00000000000..afb98c8a59e
--- /dev/null
+++ b/tests/agent/test_tool_result_summaries.py
@@ -0,0 +1,79 @@
+"""Compaction stubs for terminal/execute_code results must say what they dropped.
+
+Regression for a hub session where 16 extracted figure paths compacted to
+"[terminal] ran ... -> exit 0, 1 lines output": the line count read the JSON-escaped
+newlines and no path survived, so the agent guessed four file names that never existed.
+"""
+
+import json
+
+from agent.context_compressor import (
+    ContextCompressor,
+    _is_summary_stub,
+    _summarize_tool_result,
+)
+
+PATHS = [f"/home/ubuntu/scratch/beam/figure-page-{n}-0.png" for n in range(3, 150, 9)][:16]
+ELIDED = "(output elided: re-run or list the dir to see it)"
+
+
+def _terminal_result(lines):
+    return json.dumps({"output": "\n".join(lines), "exit_code": 0, "error": None})
+
+
+def _demote(tool_name, args, content):
+    call = {"id": "c1", "type": "function", "function": {"name": tool_name, "arguments": json.dumps(args)}}
+    result = [
+        {"role": "assistant", "content": "", "tool_calls": [call]},
+        {"role": "tool", "tool_call_id": "c1", "content": content},
+    ]
+    changed = ContextCompressor._demote_tool_result_at(
+        result, 1, {"c1": (tool_name, json.dumps(args))}, 200, set(),
+    )
+    return changed, result[1]["content"]
+
+
+def test_terminal_stub_counts_decoded_output_lines_and_keeps_first_and_last():
+    assert len(PATHS) == 16
+    stub = _summarize_tool_result("terminal", json.dumps({"command": "python3 extract.py"}), _terminal_result(PATHS))
+    assert "16 lines output" in stub
+    assert PATHS[0] in stub
+    assert PATHS[-1] in stub
+    assert stub.endswith(ELIDED)
+    assert len(stub) < 400 and _is_summary_stub(stub), "a later pass must recognize the stub, not re-summarize it"
+
+
+def test_execute_code_stub_counts_decoded_lines_and_says_output_was_elided():
+    content = json.dumps({"status": "success", "output": "\n".join(PATHS), "tool_calls_made": 0})
+    stub = _summarize_tool_result("execute_code", json.dumps({"code": "print(paths)"}), content)
+    assert "16 lines output" in stub
+    assert PATHS[0] in stub and PATHS[-1] in stub
+    assert stub.endswith(ELIDED)
+
+
+def test_non_json_terminal_content_falls_back_to_raw_text():
+    stub = _summarize_tool_result("terminal", json.dumps({"command": "ls"}), "a\nb\nc")
+    assert "3 lines output" in stub
+
+
+def test_short_terminal_listing_is_kept_verbatim_by_the_ordinary_prune_pass():
+    short = PATHS[:6]
+    content = _terminal_result(short)
+    assert len(content) > 200
+    changed, kept = _demote("terminal", {"command": "ls figures"}, content)
+    assert not changed
+    assert kept == content
+
+
+def test_long_terminal_listing_is_demoted_to_an_honest_stub():
+    changed, stub = _demote("terminal", {"command": "ls figures"}, _terminal_result(PATHS))
+    assert changed
+    assert "16 lines output" in stub and PATHS[0] in stub and PATHS[-1] in stub
+    assert stub.endswith(ELIDED)
+
+
+def test_json_result_without_output_field_is_not_reported_as_output():
+    stub = _summarize_tool_result("terminal", json.dumps({"command": "true"}), '{"exit_code": 0}')
+    assert "0 lines output" in stub
+    assert "exit_code" not in stub.split("->", 1)[1]
+    assert ELIDED not in stub
diff --git a/tests/tools/test_image_source_not_found.py b/tests/tools/test_image_source_not_found.py
new file mode 100644
index 00000000000..f679bcbc3d9
--- /dev/null
+++ b/tests/tools/test_image_source_not_found.py
@@ -0,0 +1,62 @@
+"""A local-backend miss names the real files beside the missing one.
+
+Regression: an agent that lost a figure list to compaction asked vision_analyze for four
+invented ``figure-page-N-0.png`` names; each miss said only "media file not found", so it
+kept guessing until the loop guard fired.
+"""
+
+import importlib
+from pathlib import Path
+
+import pytest
+
+
+def _reload(monkeypatch, hermes_home: Path):
+    monkeypatch.setenv("HERMES_HOME", str(hermes_home))
+    monkeypatch.setenv("TERMINAL_ENV", "local")
+    import hermes_constants
+    importlib.reload(hermes_constants)
+    import tools.image_source as isrc
+    importlib.reload(isrc)
+    return isrc
+
+
+@pytest.mark.asyncio
+async def test_miss_lists_matching_siblings(tmp_path, monkeypatch):
+    isrc = _reload(monkeypatch, tmp_path / "hermes")
+    figs = tmp_path / "figs"
+    figs.mkdir()
+    real = [f"figure-page-{n}-0.png" for n in (3, 12, 75, 88)]
+    for name in real + ["notes.txt"]:
+        (figs / name).write_bytes(b"x")
+    with pytest.raises(isrc.SourceNotFound) as excinfo:
+        await isrc.resolve_image_source(str(figs / "figure-page-79-0.png"), isrc.ResolveContext())
+    msg = str(excinfo.value)
+    assert msg.startswith(f"media file not found: '{figs / 'figure-page-79-0.png'}'")
+    assert "files in that dir:" in msg
+    for name in real:
+        assert name in msg
+    assert "notes.txt" not in msg
+
+
+@pytest.mark.asyncio
+async def test_miss_caps_sibling_list_at_ten(tmp_path, monkeypatch):
+    isrc = _reload(monkeypatch, tmp_path / "hermes")
+    figs = tmp_path / "figs"
+    figs.mkdir()
+    for n in range(30):
+        (figs / f"figure-page-{n}-0.png").write_bytes(b"x")
+    with pytest.raises(isrc.SourceNotFound) as excinfo:
+        await isrc.resolve_image_source(str(figs / "figure-page-99-0.png"), isrc.ResolveContext())
+    listed = str(excinfo.value).split("files in that dir:", 1)[1]
+    assert listed.count("figure-page-") == 10
+    assert "(+20 more)" in listed
+
+
+@pytest.mark.asyncio
+async def test_miss_in_missing_dir_keeps_plain_message(tmp_path, monkeypatch):
+    isrc = _reload(monkeypatch, tmp_path / "hermes")
+    target = tmp_path / "nope" / "figure-page-1-0.png"
+    with pytest.raises(isrc.SourceNotFound) as excinfo:
+        await isrc.resolve_image_source(str(target), isrc.ResolveContext())
+    assert str(excinfo.value) == f"media file not found: '{target}'"
diff --git a/tools/image_source.py b/tools/image_source.py
index ac72704e696..aef740a143c 100644
--- a/tools/image_source.py
+++ b/tools/image_source.py
@@ -89,10 +89,37 @@ async def resolve_image_source(
         return _finalize(data, "", "file", s, permitted)
     if _is_local_terminal_backend():
         # Any path was host-readable, so a miss means the file doesn't exist.
-        raise SourceNotFound(f"media file not found: '{p}'", src=s, origin="file")
+        raise SourceNotFound(f"media file not found: '{p}'{_sibling_hint(p)}", src=s, origin="file")
     return await _resolve_container_fallback(p, ctx, s, permitted)
 
 
+_SIBLING_HINT_MAX = 10
+_SIBLING_SCAN_MAX = 5000  # a miss in a huge dir must not stall on a full listing
+
+
+def _sibling_hint(p: Path) -> str:
+    """``; files in that dir: a.png, b.png (+N more)`` naming real files that share the missing name's
+    non-digit stem prefix and suffix (``figure-page-79-0.png`` -> ``figure-page-*.png``), else "".
+    An agent that lost a file list to compaction otherwise guesses names until a loop guard fires."""
+    try:
+        parent = p.expanduser().parent
+        prefix = re.split(r"\d", p.stem, maxsplit=1)[0]
+        suffix = p.suffix.lower()
+        with os.scandir(parent) as it:
+            entries = [e for _, e in zip(range(_SIBLING_SCAN_MAX), it)]
+        names = sorted(
+            (e.name for e in entries
+             if e.name.startswith(prefix) and e.name.lower().endswith(suffix) and e.is_file()),
+            key=lambda n: [int(t) if t.isdigit() else t for t in re.split(r"(\d+)", n)],
+        )
+    except OSError:
+        return ""
+    if not names:
+        return ""
+    more = f" (+{len(names) - _SIBLING_HINT_MAX} more)" if len(names) > _SIBLING_HINT_MAX else ""
+    return f"; files in that dir: {', '.join(names[:_SIBLING_HINT_MAX])}{more}"
+
+
