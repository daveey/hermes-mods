From bb47f681ec97d11eee39131385bca58918ae667a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 00:01:02 +0000
Subject: [PATCH] [daveey] Exclude disabled credentials from quota and
 auth-wall classification

Why: selection excludes user-disabled rows but quota scans included them. A healthy disabled spare hid exhaustion of every enabled account, causing generic credential failures instead of retryable quota exit 75. Disabled 401 rows similarly poisoned auth-churn classification. Reuse the selection disable policy in both scans; all-disabled remains unknown, not a quota wall.

Proof: eight new regression cases fail before and pass after. All 341 tests across 16 direct consumer suites pass; scripts/check passes all 20 checks. Cases cover earliest enabled reset, disabled healthy/walled/auth-benched rows, all-disabled, same-pool re-enable, and verify_class_runtime through worker exit mapping. Detection gap: existing auth-bench tests did not compose persisted user disables with quota evidence.
---
 agent/model_routing_unavailable.py            |  7 +-
 .../test_quota_unavailable_auth_bench.py      | 65 ++++++++++++++++++-
 2 files changed, 69 insertions(+), 3 deletions(-)

diff --git a/agent/model_routing_unavailable.py b/agent/model_routing_unavailable.py
index 2426255cde..961205f7b1 100644
--- a/agent/model_routing_unavailable.py
+++ b/agent/model_routing_unavailable.py
@@ -1,5 +1,6 @@
 """Recoverable subscription capacity refusals without entering legacy paid fallback."""
 from agent.model_routing import ModelRoutingError
+from agent.credential_pool_disabled import enabled_entries
 
 
 class SubscriptionQuotaUnavailable(ModelRoutingError):
@@ -55,7 +56,7 @@ def auth_churned(pool, model):
         return False
     now = time.time()
     return any(entry.auth_type == "oauth" and entry.last_status != STATUS_DEAD and auth_benched(entry, model, now)
-               for entry in pool.entries())
+               for entry in enabled_entries(pool.provider, pool.entries()))
 
 
 def _quota_scan(pool, model):
@@ -70,7 +71,9 @@ def _quota_scan(pool, model):
     if pool is None:
         return False, []
     now = time.time()
-    entries = [entry for entry in pool.entries() if entry.auth_type == "oauth" and entry.last_status != STATUS_DEAD]
+    # Disabled rows are neither usable capacity nor evidence of a quota/auth wall.
+    entries = [entry for entry in enabled_entries(pool.provider, pool.entries())
+               if entry.auth_type == "oauth" and entry.last_status != STATUS_DEAD]
     waits, unproven = [], False
     for entry in entries:
         account = _exhausted_until(entry, sole_credential=len(entries) <= 1)
diff --git a/tests/agent/test_quota_unavailable_auth_bench.py b/tests/agent/test_quota_unavailable_auth_bench.py
index 7696bff157..742d7ec794 100644
--- a/tests/agent/test_quota_unavailable_auth_bench.py
+++ b/tests/agent/test_quota_unavailable_auth_bench.py
@@ -4,7 +4,10 @@ import time
 import pytest
 
 from agent.credential_pool import CredentialPool, PooledCredential
-from agent.model_routing_unavailable import quota_unavailable
+from agent.credential_pool_disabled import set_credential_disabled
+from agent.model_routing_unavailable import (
+    SubscriptionQuotaUnavailable, auth_churned, quota_room, quota_unavailable,
+)
 
 MODEL = "claude-opus-5-5"
 
@@ -64,3 +67,63 @@ def test_dead_and_entitlement_benched_entries_stay_excluded():
     wall = quota_unavailable(CredentialPool("anthropic", entries), MODEL)
     assert wall is not None
     assert wall.resets_at == pytest.approx(now + 3 * 86400, abs=1)
+
+
+@pytest.fixture
+def disabled_home(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "auth.json").write_text('{"version": 1}', encoding="utf-8")
+    return tmp_path
+
+
+@pytest.mark.parametrize("disabled_kind", ["healthy", "earlier_wall", "auth_bench"])
+def test_disabled_rows_are_neither_room_nor_wall_evidence(disabled_home, disabled_kind):
+    now = time.time()
+    disabled = {"healthy": _entry(0), "earlier_wall": _walled(0, now, 1),
+                "auth_bench": _auth_benched(0, now)}[disabled_kind]
+    pool = CredentialPool("anthropic", [disabled, _walled(1, now, 2), _walled(2, now, 3)])
+    assert set_credential_disabled(pool.provider, disabled, True)
+    wall = quota_unavailable(pool, MODEL)
+    assert isinstance(wall, SubscriptionQuotaUnavailable)
+    assert wall.resets_at == now + 2 * 86400
+    assert quota_room(pool, MODEL) is False
+    assert auth_churned(pool, MODEL) is False
+
+
+@pytest.mark.parametrize("kind", ["healthy", "wall", "auth_bench"])
+def test_all_disabled_is_not_quota_or_auth_churn(disabled_home, kind):
+    now = time.time()
+    entry = {"healthy": _entry(0), "wall": _walled(0, now, 1),
+             "auth_bench": _auth_benched(0, now)}[kind]
+    pool = CredentialPool("anthropic", [entry])
+    set_credential_disabled(pool.provider, entry, True)
+    assert quota_unavailable(pool, MODEL) is None
+    assert quota_room(pool, MODEL) is False
+    assert auth_churned(pool, MODEL) is False
+
+
+def test_disabled_spare_preserves_retryable_subscription_refusal(disabled_home):
+    from agent.model_routing_runtime import verify_class_runtime
+    from hermes_cli.turn_exit import credential_failure_flags, turn_exit_code
+
+    now = time.time()
+    spare, walled = _entry(0), _walled(1, now, 2)
+    pool = CredentialPool("anthropic", [spare, walled])
+    set_credential_disabled(pool.provider, spare, True)
+    assert pool.current() is None
+    runtime = {"provider": "anthropic", "api_key": walled.runtime_api_key, "credential_pool": pool}
+    metadata = {"selected_provider": "anthropic", "selected_model": MODEL, "billing_group": "subscription"}
+    with pytest.raises(SubscriptionQuotaUnavailable) as caught:
+        verify_class_runtime(runtime, metadata)
+    assert caught.value.resets_at == now + 2 * 86400
+    assert turn_exit_code(None, kanban_worker=True, **credential_failure_flags(caught.value)) == 75
+
+
+def test_enable_transition_rechecks_same_pool(disabled_home):
+    spare = _entry(0)
+    pool = CredentialPool("anthropic", [spare, _walled(1, time.time(), 2)])
+    set_credential_disabled(pool.provider, spare, True)
+    assert quota_room(pool, MODEL) is False
+    set_credential_disabled(pool.provider, spare, False)
+    assert quota_room(pool, MODEL) is True
+    assert quota_unavailable(pool, MODEL) is None
