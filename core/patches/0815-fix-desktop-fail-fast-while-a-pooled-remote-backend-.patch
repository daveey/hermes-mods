diff --git a/apps/desktop/electron/remote-down-gate.test.ts b/apps/desktop/electron/remote-down-gate.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..486f8d356ac7db1b1e67ed84dd0608d2e06605ad
--- /dev/null
+++ b/apps/desktop/electron/remote-down-gate.test.ts
@@ -0,0 +1,183 @@
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+
+import { describe, expect, it, vi } from 'vitest'
+
+import {
+  dispatchThroughRemoteDownGate,
+  isRemoteBackendDownError,
+  isRemoteTransportFailure,
+  REMOTE_DOWN_INITIAL_BACKOFF_MS,
+  REMOTE_DOWN_MAX_BACKOFF_MS,
+  RemoteDownGate
+} from './remote-down-gate'
+
+// 2026-10-28: a hub/mini `hermes update` restarts the remote serve backend; the Desktop kept dialing the dead tunnel
+// and every renderer poll burned a 4-10 s "Timed out connecting to Hermes backend". While a pooled remote is known
+// down its requests must fail fast, with one backoff trial at a time reopening the gate.
+
+const KEY = 'conn:hermes-hub::default'
+const BASE_URL = 'http://127.0.0.1:62511'
+
+function reset(): Error {
+  return Object.assign(new Error('read ECONNRESET'), { code: 'ECONNRESET' })
+}
+
+function clock(start = 1_000_000) {
+  let now = start
+
+  return {
+    now: () => now,
+    advance: (ms: number) => {
+      now += ms
+    }
+  }
+}
+
+function harness() {
+  const time = clock()
+  const gate = new RemoteDownGate(time.now)
+  const connection = { baseUrl: BASE_URL }
+  const connect = vi.fn(async () => connection)
+  const forgetAnswer = vi.fn()
+  const log = vi.fn()
+
+  const run = (request: () => Promise<unknown>) =>
+    dispatchThroughRemoteDownGate({ gate, key: KEY, connect, request, forgetAnswer, log })
+
+  return { connect, forgetAnswer, gate, log, run, time }
+}
+
+describe('remote down gate', () => {
+  it('fails requests fast after the remote resets, without dialing or waiting for a timeout', async () => {
+    const h = harness()
+
+    await expect(h.run(async () => Promise.reject(reset()))).rejects.toThrow('ECONNRESET')
+    expect(h.forgetAnswer).toHaveBeenCalledWith(BASE_URL)
+    expect(h.gate.isDown(KEY)).toBe(true)
+    expect(h.log).toHaveBeenCalledWith(expect.stringContaining(`[remote-down] ${KEY} marked down`))
+
+    const request = vi.fn(async () => ({ ok: true }))
+    h.connect.mockClear()
+
+    const startedAt = performance.now()
+    const error = await h.run(request).catch(e => e)
+
+    expect(isRemoteBackendDownError(error)).toBe(true)
+    expect(String(error.message)).toContain(KEY)
+    expect(performance.now() - startedAt).toBeLessThan(50)
+    expect(h.connect).not.toHaveBeenCalled()
+    expect(request).not.toHaveBeenCalled()
+  })
+
+  it('lets one trial through after the backoff; its answer reopens the gate', async () => {
+    const h = harness()
+
+    await h.run(async () => Promise.reject(reset())).catch(() => {})
+    h.time.advance(REMOTE_DOWN_INITIAL_BACKOFF_MS)
+
+    let finishTrial: (value: unknown) => void = () => {}
+    const trial = h.run(() => new Promise(resolve => (finishTrial = resolve)))
+
+    // While the trial (which may be a full SSH redial) is in flight, everything else still fails fast.
+    await vi.waitFor(() => expect(h.connect).toHaveBeenCalledTimes(2))
+    await expect(h.run(async () => 'other')).rejects.toSatisfy(isRemoteBackendDownError)
+
+    finishTrial({ ok: true })
+    await expect(trial).resolves.toEqual({ ok: true })
+    expect(h.gate.isDown(KEY)).toBe(false)
+    await expect(h.run(async () => 'after')).resolves.toBe('after')
+  })
+
+  it('a failed trial doubles the backoff, capped', async () => {
+    const h = harness()
+
+    await h.run(async () => Promise.reject(reset())).catch(() => {})
+    h.time.advance(REMOTE_DOWN_INITIAL_BACKOFF_MS)
+    h.connect.mockRejectedValueOnce(new Error('ssh: connect to host 192.0.2.10 port 22: Operation timed out'))
+    await expect(h.run(async () => 'x')).rejects.toThrow('ssh: connect')
+
+    // Second failure: 2x backoff. Halfway through it the gate is still shut.
+    h.time.advance(REMOTE_DOWN_INITIAL_BACKOFF_MS)
+    await expect(h.run(async () => 'x')).rejects.toSatisfy(isRemoteBackendDownError)
+    h.time.advance(REMOTE_DOWN_INITIAL_BACKOFF_MS)
+    await expect(h.run(async () => 'back')).resolves.toBe('back')
+
+    const capped = new RemoteDownGate(h.time.now)
+
+    for (let i = 0; i < 20; i++) {
+      capped.markDown(KEY, 'reset')
+    }
+
+    h.time.advance(REMOTE_DOWN_MAX_BACKOFF_MS - 1)
+    expect(() => capped.admit(KEY)).toThrow()
+    h.time.advance(1)
+    expect(capped.admit(KEY)).toEqual({ trial: true })
+  })
+
+  it('an HTTP error is an answer: it does not mark the remote down, and it reopens a down gate', async () => {
+    const h = harness()
+
+    await expect(h.run(async () => Promise.reject(new Error('500: boom')))).rejects.toThrow('500')
+    expect(h.gate.isDown(KEY)).toBe(false)
+
+    h.gate.markDown(KEY, 'reset')
+    h.time.advance(REMOTE_DOWN_INITIAL_BACKOFF_MS)
+    await expect(h.run(async () => Promise.reject(new Error('401: unauthorized')))).rejects.toThrow('401')
+    expect(h.gate.isDown(KEY)).toBe(false)
+  })
+
+  it('a slow endpoint timing out does not take the whole remote down, but forces the next dispatch to re-probe', async () => {
+    const h = harness()
+    const timeout = new Error('Timed out connecting to Hermes backend after 4000ms')
+
+    await expect(h.run(async () => Promise.reject(timeout))).rejects.toThrow('Timed out')
+    expect(h.gate.isDown(KEY)).toBe(false)
+    expect(h.forgetAnswer).toHaveBeenCalledWith(BASE_URL)
+
+    // ...but a trial that times out keeps it down.
+    h.gate.markDown(KEY, 'reset')
+    h.time.advance(REMOTE_DOWN_INITIAL_BACKOFF_MS)
+    await expect(h.run(async () => Promise.reject(timeout))).rejects.toThrow('Timed out')
+    expect(h.gate.isDown(KEY)).toBe(true)
+  })
+
+  it('config refusals say nothing about remote health', async () => {
+    const h = harness()
+
+    h.connect.mockRejectedValueOnce(new Error('Passive read: no warm backend for "conn:hermes-hub::default"'))
+    await expect(h.run(async () => 'x')).rejects.toThrow('Passive read')
+    h.connect.mockRejectedValueOnce(new Error("Profile 'x@hub' does not exist."))
+    await expect(h.run(async () => 'x')).rejects.toThrow('does not exist')
+    expect(h.gate.isDown(KEY)).toBe(false)
+  })
+
+  it('keys are independent: a down hub does not gate mac-mini', async () => {
+    const h = harness()
+
+    h.gate.markDown(KEY, 'reset')
+    expect(() => h.gate.admit('conn:mac-mini::default')).not.toThrow()
+  })
+
+  it('classifies transport failures', () => {
+    expect(isRemoteTransportFailure(reset())).toBe(true)
+    expect(isRemoteTransportFailure(new Error('socket hang up'))).toBe(true)
+    expect(isRemoteTransportFailure(new Error('connect ECONNREFUSED 127.0.0.1:62511'))).toBe(true)
+    expect(isRemoteTransportFailure(new Error('Timed out connecting to Hermes backend after 4000ms'))).toBe(false)
+    expect(isRemoteTransportFailure(new Error('500: boom'))).toBe(false)
+  })
+})
+
+describe('main.ts wiring', () => {
+  const main = readFileSync(join(__dirname, 'main.ts'), 'utf8')
+
+  it('routes registry requests to remote connections through the gate', () => {
+    const body = main.slice(main.indexOf('async function dispatchRegistryApiRequest('))
+
+    expect(body.slice(0, 4000)).toMatch(/dispatchThroughRemoteDownGate\(\{\s*gate: remoteDownGate,\s*key: gateKey/)
+  })
+
+  it('a failed dispatch probe marks the pool key down', () => {
+    expect(main).toMatch(/failed its dispatch probe[\s\S]{0,200}remoteDownGate\.markDown\(key,/)
+  })
+})
diff --git a/apps/desktop/electron/remote-down-gate.ts b/apps/desktop/electron/remote-down-gate.ts
new file mode 100644
index 0000000000000000000000000000000000000000..56c6d64c675684b65c10f22030df286a2775f4c5
--- /dev/null
+++ b/apps/desktop/electron/remote-down-gate.ts
@@ -0,0 +1,238 @@
+// [daveey] Fail fast while a pooled remote backend is known to be down.
+//
+// A remote Hermes backend (hub, mini) restarts several times a day: every `hermes update` on that host retires its
+// SSH-isolated serve/dashboard processes (web_server_skew_exit), and the tunnel then answers ECONNRESET / socket hang
+// up until the Desktop redials. On 2026-10-28 every mac-mini "dial failed" cluster (11 of 11) and both hermes-hub
+// ECONNRESET bursts lined up with a core update on that host, not with sleep, Tailscale or sshd keepalive.
+//
+// During that window each renderer poll (hub-sync/status, kanban/board, runners enrollment, ...) still dialed the dead
+// descriptor or queued behind the redial, so the outage surfaced as a stream of 4-10 s "Timed out connecting to Hermes
+// backend" errors and blocked UI work behind them. This gate records the outage per pool key
+// (`conn:<id>::<profile>`) and, while it lasts, rejects requests at once with RemoteBackendDownError. After a short
+// backoff ONE request is let through as the trial: it reprobes/redials; its success reopens the gate, its failure
+// doubles the backoff. Requests that arrive while the trial is in flight fail fast too.
+
+export const REMOTE_DOWN_INITIAL_BACKOFF_MS = 2_000
+export const REMOTE_DOWN_MAX_BACKOFF_MS = 30_000
+
+export const REMOTE_BACKEND_DOWN_CODE = 'REMOTE_BACKEND_DOWN'
+
+export class RemoteBackendDownError extends Error {
+  readonly code = REMOTE_BACKEND_DOWN_CODE
+  readonly key: string
+  readonly retryInMs: number
+
+  constructor(key: string, reason: string, downForMs: number, retryInMs: number) {
+    const retry = retryInMs > 0 ? `next try in ${Math.ceil(retryInMs / 1000)}s` : 'reconnect in progress'
+
+    super(
+      `Remote backend "${key}" is down (${reason}, ${Math.round(downForMs / 1000)}s ago); ${retry}. Failing fast instead of waiting for a timeout.`
+    )
+    this.name = 'RemoteBackendDownError'
+    this.key = key
+    this.retryInMs = retryInMs
+  }
+}
+
+export function isRemoteBackendDownError(error: unknown): error is RemoteBackendDownError {
+  return (error as { code?: unknown } | null)?.code === REMOTE_BACKEND_DOWN_CODE
+}
+
+const TRANSPORT_CODES = new Set([
+  'ECONNABORTED',
+  'ECONNREFUSED',
+  'ECONNRESET',
+  'EHOSTDOWN',
+  'EHOSTUNREACH',
+  'ENETUNREACH',
+  'EPIPE'
+])
+
+const TRANSPORT_MESSAGE_RE = /\b(?:ECONNRESET|ECONNREFUSED|ECONNABORTED|EPIPE|EHOSTUNREACH|ENETUNREACH|EHOSTDOWN)\b|socket hang up/i
+const TIMEOUT_MESSAGE_RE = /Timed out connecting to Hermes backend/i
+
+/** The connection itself broke (reset, refused, hung up): the backend behind the tunnel is gone. */
+export function isRemoteTransportFailure(error: unknown): boolean {
+  const code = (error as { code?: unknown } | null)?.code
+
+  if (typeof code === 'string' && TRANSPORT_CODES.has(code)) {
+    return true
+  }
+
+  return TRANSPORT_MESSAGE_RE.test(String((error as { message?: unknown } | null)?.message ?? error ?? ''))
+}
+
+export function isRemoteTimeout(error: unknown): boolean {
+  return TIMEOUT_MESSAGE_RE.test(String((error as { message?: unknown } | null)?.message ?? error ?? ''))
+}
+
+interface DownState {
+  failures: number
+  reason: string
+  since: number
+  retryAt: number
+  trialInFlight: boolean
+}
+
+export interface RemoteDownAdmission {
+  trial: boolean
+}
+
+export class RemoteDownGate {
+  readonly #down = new Map<string, DownState>()
+  readonly #now: () => number
+  readonly #initialBackoffMs: number
+  readonly #maxBackoffMs: number
+
+  constructor(
+    now: () => number = Date.now,
+    initialBackoffMs = REMOTE_DOWN_INITIAL_BACKOFF_MS,
+    maxBackoffMs = REMOTE_DOWN_MAX_BACKOFF_MS
+  ) {
+    this.#now = now
+    this.#initialBackoffMs = initialBackoffMs
+    this.#maxBackoffMs = maxBackoffMs
+  }
+
+  isDown(key: string): boolean {
+    return this.#down.has(key)
+  }
+
+  /** Throws RemoteBackendDownError while `key` is down; otherwise admits the request (as the trial when down). */
+  admit(key: string): RemoteDownAdmission {
+    const state = this.#down.get(key)
+
+    if (!state) {
+      return { trial: false }
+    }
+
+    const now = this.#now()
+
+    if (state.trialInFlight || now < state.retryAt) {
+      throw new RemoteBackendDownError(key, state.reason, now - state.since, Math.max(0, state.retryAt - now))
+    }
+
+    state.trialInFlight = true
+
+    return { trial: true }
+  }
+
+  markDown(key: string, reason: string): void {
+    const now = this.#now()
+    const previous = this.#down.get(key)
+    const failures = (previous?.failures ?? 0) + 1
+    const backoff = Math.min(this.#initialBackoffMs * 2 ** (failures - 1), this.#maxBackoffMs)
+
+    this.#down.set(key, {
+      failures,
+      reason: String(reason || 'unreachable').slice(0, 160),
+      since: previous?.since ?? now,
+      retryAt: now + backoff,
+      trialInFlight: false
+    })
+  }
+
+  markUp(key: string): boolean {
+    return this.#down.delete(key)
+  }
+
+  /** A trial that ended without a verdict (e.g. a slow endpoint) hands the trial slot back. */
+  releaseTrial(key: string): void {
+    const state = this.#down.get(key)
+
+    if (state) {
+      state.trialInFlight = false
+    }
+  }
+}
+
+export interface GatedRemoteDispatchOptions<TConnection extends { baseUrl?: null | string }, TResult> {
+  gate: RemoteDownGate
+  key: string
+  connect: () => Promise<TConnection>
+  request: (connection: TConnection) => Promise<TResult>
+  // Drop the "answered recently" mark so the next dispatch re-probes /api/health instead of trusting a dead tunnel.
+  forgetAnswer?: (baseUrl: null | string | undefined) => void
+  log?: (message: string) => void
+}
+
+/**
+ * Run one registry request through the down gate.
+ *
+ * - known down → RemoteBackendDownError immediately (no dial, no timeout wait);
+ * - the connection breaks (connect fails, or the request resets/refuses/hangs up) → mark down;
+ * - any answer from the backend, HTTP errors included → mark up;
+ * - a request timeout → forget the answer mark (next dispatch re-probes) and, if it was the trial, stay down.
+ */
+export async function dispatchThroughRemoteDownGate<TConnection extends { baseUrl?: null | string }, TResult>({
+  gate,
+  key,
+  connect,
+  request,
+  forgetAnswer,
+  log
+}: GatedRemoteDispatchOptions<TConnection, TResult>): Promise<TResult> {
+  const { trial } = gate.admit(key)
+  let connection: TConnection
+
+  try {
+    connection = await connect()
+  } catch (error) {
+    if (isRemoteBackendDownError(error)) {
+      throw error
+    }
+
+    // Config refusals ("No connection with id", bad profile, passive read with no warm backend) say nothing
+    // about the remote's health.
+    const message = String((error as { message?: unknown } | null)?.message ?? error)
+
+    if (/^No connection with id|does not exist|^Passive read: no warm backend/.test(message)) {
+      if (trial) {
+        gate.releaseTrial(key)
+      }
+
+      throw error
+    }
+
+    const wasUp = !gate.isDown(key)
+    gate.markDown(key, `connect failed: ${message}`)
+
+    if (wasUp) {
+      log?.(`[remote-down] ${key} marked down (connect failed: ${message.slice(0, 160)}); failing fast until it answers`)
+    }
+
+    throw error
+  }
+
+  try {
+    const result = await request(connection)
+
+    if (gate.markUp(key)) {
+      log?.(`[remote-down] ${key} answered again; gate open`)
+    }
+
+    return result
+  } catch (error) {
+    if (isRemoteTransportFailure(error)) {
+      forgetAnswer?.(connection?.baseUrl)
+      const wasUp = !gate.isDown(key)
+      const message = String((error as { message?: unknown } | null)?.message ?? error)
+      gate.markDown(key, message)
+
+      if (wasUp) {
+        log?.(`[remote-down] ${key} marked down (${message.slice(0, 160)}); failing fast until it answers`)
+      }
+    } else if (isRemoteTimeout(error)) {
+      forgetAnswer?.(connection?.baseUrl)
+
+      if (trial) {
+        gate.markDown(key, 'trial request timed out')
+      }
+    } else if (gate.markUp(key)) {
+      // An HTTP status error (4xx/5xx) or a bad payload is still an answer: the backend is reachable.
+      log?.(`[remote-down] ${key} answered again; gate open`)
+    }
+
+    throw error
+  }
+}
-- 
