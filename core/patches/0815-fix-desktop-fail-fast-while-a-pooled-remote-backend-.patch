+    const line = formatApiRequestFailure({ connectionId: 'hermes-hub', path: '/api/plugins/hub-sync/status' } as any, fastFail)
+
+    expect(line).toContain('conn=hermes-hub Remote backend "conn:hermes-hub::default" is down')
