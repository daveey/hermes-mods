diff --git a/tests/hermes_cli/test_kanban_shared_blocker_hardening.py b/tests/hermes_cli/test_kanban_shared_blocker_hardening.py
new file mode 100644
index 0000000000..825c65f97f
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_shared_blocker_hardening.py
@@ -0,0 +1,96 @@
+"""Independent maintenance lanes and deterministic configured alias identities."""
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_shared_blockers as blockers
+from tests.hermes_cli import test_kanban_shared_blockers as helpers
+
+kanban_home = helpers.kanban_home
+
+
+def test_unexpected_check_failure_leaves_reclaim_lanes_alive(kanban_home, monkeypatch, caplog):
+    from hermes_cli import kanban_db_dispatch as dispatch
+    from hermes_cli import kanban_shared_blocker_checks as checks
+    from hermes_cli import kanban_sweep_gate as gate
+
+    calls = []
+
+    def fail_check(conn, **kwargs):
+        calls.append('check')
+        raise RuntimeError('injected check failure')
+
+    def release(conn, **kwargs):
+        calls.append('release')
+        return ['released']
+
+    def probe(conn, **kwargs):
+        calls.append('probe')
+        return ['probed']
+
+    def timed(name, handler, *args, **kwargs):
+        # Exercise real reclaim ordering, isolating unrelated process maintenance.
+        if name == 'dispatch.sweep_shared_blockers':
+            return handler(*args, **kwargs)
+        if name == 'dispatch.tick_upkeep':
+            calls.append('upkeep')
+        return []
+
+    monkeypatch.setattr(checks, 'run_due_checks', fail_check)
+    monkeypatch.setattr(blockers, 'release_cleared_blockers', release)
+    monkeypatch.setattr(blockers, 'probe_stranded_blockers', probe)
+    monkeypatch.setattr(gate, 'gated', lambda name, conn, fn, *args, **kw: fn(*args))
+    monkeypatch.setattr(dispatch._la, 'timed', timed)
+    monkeypatch.setattr(dispatch, '_record_dispatch_pass', lambda *a, **kw: None)
+    with kbc.connect_closing() as conn:
+        helpers._legacy_blocked_behind(conn, 'waiting', blocker_id='test-wall')
+        result = SimpleNamespace()
+        dispatch._run_reclaim_phase(conn, result, stale_timeout_seconds=3600,
+                                    failure_limit=2, reconcile_orphans=False, dry_run=True)
+    assert calls == ['check', 'release', 'probe', 'upkeep']
+    assert result.shared_blocker_released == ['released']
+    assert result.shared_blocker_probed == ['probed']
+    assert 'shared blocker checks failed' in caplog.text
+    assert 'injected check failure' in caplog.text
+
+
+@pytest.mark.parametrize('key', [' Quota Limited! ', 'QUOTA-LIMITED', '.quota-limited_'])
+def test_alias_keys_use_input_slugging(key):
+    cfg = {'kanban': {'shared_blocker_aliases': {key: 'github-quota-reserve'}}}
+    assert blockers.normalize_blocker_id('quota-limited', cfg=cfg) == 'github-rest-quota'
+    assert blockers.normalize_blocker_id(key, cfg=cfg) == 'github-rest-quota'
+
+
+@pytest.mark.parametrize('reverse', [False, True])
+def test_alias_collisions_are_order_independent_and_one_hop(reverse):
+    entries = [('QUOTA LIMITED', 'first-wall'), ('quota-limited', 'second-wall'),
+               ('first-wall', 'third-wall'), (7, 'bad-wall'), ('!!!', 'bad-wall')]
+    cfg = {'kanban': {'shared_blocker_aliases': dict(reversed(entries) if reverse else entries)}}
+    assert blockers.normalize_blocker_id('quota limited', cfg=cfg) == 'first-wall'
+    assert blockers.normalize_blocker_id('!!!', cfg=cfg) is None
+
+
+@pytest.mark.parametrize('key', ['github-rest-quota', ' GITHUB QUOTA RESERVE! '])
+def test_builtin_family_cannot_be_overridden(key):
+    cfg = {'kanban': {'shared_blocker_aliases': {key: 'other-wall'}}}
+    assert blockers.normalize_blocker_id(key, cfg=cfg) == 'github-rest-quota'
+
+
+def test_invalid_aliases_do_not_mask_valid_collisions():
+    cfg = {'kanban': {'shared_blocker_aliases': {
+        'WALL': None, 'Wall': '!!!', 'wall': 'target', 'unused': 7}}}
+    assert blockers.normalize_blocker_id('wall', cfg=cfg) == 'target'
+    assert blockers.normalize_blocker_id('unused', cfg=cfg) == 'unused'
+
+
+@pytest.mark.parametrize('aliases', [None, [], 'wall'])
+def test_non_mapping_aliases_are_ignored(aliases):
+    assert blockers.normalize_blocker_id('wall', cfg={
+        'kanban': {'shared_blocker_aliases': aliases}}) == 'wall'
+
+
+def test_alias_keys_share_input_length_limit():
+    key = 'x' * (blockers.MAX_BLOCKER_ID_CHARS + 10)
+    assert blockers.normalize_blocker_id(key, cfg={
+        'kanban': {'shared_blocker_aliases': {key: 'target'}}}) == 'target'
