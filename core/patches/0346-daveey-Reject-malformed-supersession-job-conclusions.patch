From 8d944b6b426623000b898865adf5286fc73c362a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 26 Oct 2026 01:06:29 +0000
Subject: [PATCH] [daveey] Reject malformed supersession job conclusions

---
 hermes_cli/kanban_pr_wake.py                    | 4 +++-
 tests/hermes_cli/test_kanban_pr_supersession.py | 6 ++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_pr_wake.py b/hermes_cli/kanban_pr_wake.py
index d002ac672a..8a06f9243f 100644
--- a/hermes_cli/kanban_pr_wake.py
+++ b/hermes_cli/kanban_pr_wake.py
@@ -18,7 +18,9 @@ def _supersession(api, repo: str, sha: str, job: str, home: str) -> tuple[int, s
             or not isinstance(evidence.get("head_sha"), str)
             or not re.fullmatch(r"[0-9a-f]{40}", evidence["head_sha"])
             or evidence.get("status") not in {"queued", "in_progress", "completed", "waiting", "pending", "requested"}
-            or (evidence["status"] == "completed" and not isinstance(evidence.get("conclusion"), str))):
+            or (evidence["status"] == "completed" and evidence.get("conclusion") not in (
+                "success", "failure", "neutral", "cancelled", "skipped", "timed_out",
+                "action_required", "stale", "startup_failure"))):
         raise ValueError("incomplete job evidence")
     if (evidence["head_sha"] != sha or evidence.get("status") != "completed"
             or evidence.get("conclusion") != "success"):
diff --git a/tests/hermes_cli/test_kanban_pr_supersession.py b/tests/hermes_cli/test_kanban_pr_supersession.py
index 0d6df70878..8e43f00010 100644
--- a/tests/hermes_cli/test_kanban_pr_supersession.py
+++ b/tests/hermes_cli/test_kanban_pr_supersession.py
@@ -68,6 +68,12 @@ def test_malformed_job_is_error(evidence, value):
     assert inspect_pr(URL, SHA, "123")[0] == 2
 
 
+@pytest.mark.parametrize("conclusion", ["", "unknown", None, [], {}])
+def test_completed_job_invalid_conclusion_is_error(evidence, conclusion):
+    evidence["repos/example/project/actions/jobs/123"]["conclusion"] = conclusion
+    assert inspect_pr(URL, SHA, "123")[0] == 2
+
+
 def test_closed_abandoned_pr_never_claims_verified_supersession(evidence):
     evidence["repos/example/project/pulls/44"]["state"] = "closed"
     evidence["repos/example/project/actions/jobs/123"]["conclusion"] = "failure"
-- 
2.55.0

