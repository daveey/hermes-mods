From 142d4dfb732043017bf67b96165c842fd9539c18 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 21:57:22 -0700
Subject: [PATCH] perf(kanban): GET /board reuses its read while the board
 files are unchanged [daveey]

Desktop polls /api/plugins/kanban/board continuously; on the live default
board one read cost ~1 s CPU (task diagnostics over every task's events
and runs, init_db's health guard, a 6.5 MB payload walked by FastAPI's
jsonable_encoder). It was the top REST cost of the Desktop backend after
the chat-closeout fix (2026-10-27).

- Cache get_board per board path + query, keyed by kanban.db/-wal
  (mtime_ns, size, inode) taken before the read, at most 15 s old
  (diagnostics also depend on clock and config). A hit returns a shallow
  copy with a fresh "now".
- The endpoint returns json.dumps of the (JSON-native) board directly:
  byte-identical to jsonable_encoder's output, 16 ms instead of ~275 ms.

Live replay, one poll every 2 s for 30 s: 981 -> 199 ms CPU per poll.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugins/kanban/dashboard/plugin_api.py        | 51 ++++++++++-
 tests/plugins/test_kanban_board_read_cache.py | 88 +++++++++++++++++++
 2 files changed, 137 insertions(+), 2 deletions(-)
 create mode 100644 tests/plugins/test_kanban_board_read_cache.py

diff --git a/plugins/kanban/dashboard/plugin_api.py b/plugins/kanban/dashboard/plugin_api.py
index 9dd1d8b849..647177866c 100644
--- a/plugins/kanban/dashboard/plugin_api.py
+++ b/plugins/kanban/dashboard/plugin_api.py
@@ -15,6 +15,7 @@ import json
 import logging
 import re
 import sqlite3
+import threading
 import time
 from concurrent.futures import ThreadPoolExecutor
 from contextlib import closing, contextmanager
@@ -25,7 +26,7 @@ from typing import Any, Callable, Iterator, Optional
 
 from fastapi import (
     APIRouter, File, Form, HTTPException, Query, Request, UploadFile, WebSocket, WebSocketDisconnect, status as http_status)
-from fastapi.responses import FileResponse
+from fastapi.responses import FileResponse, Response
 from pydantic import BaseModel, Field
 
 from hermes_cli import kanban_db
@@ -304,6 +305,27 @@ def _managing_sessions(conn: sqlite3.Connection) -> dict[str, str]:
     return {str(r[0]): str(r[1]) for r in rows}
 
 
+# Desktop polls GET /board continuously; on a busy board one read is ~1.3 s CPU (diagnostics over every task's
+# events and runs, init_db's health guard, a 6.5 MB payload) and kept the Desktop backend near a core on 2026-10-27.
+# Reuse the last result while the board's kanban.db and -wal are unchanged (every commit moves their mtime_ns, size
+# or inode), at most _BOARD_CACHE_TTL_S old: diagnostics also depend on the clock and config.
+_BOARD_CACHE_TTL_S = 15.0
+_board_cache: dict[tuple, tuple] = {}
+_board_cache_lock = threading.Lock()
+
+
+def _board_file_sig(path: str) -> Optional[tuple]:
+    out = []
+    for candidate in (path, f"{path}-wal"):
+        try:
+            st = Path(candidate).stat()
+        except OSError:
+            out.append(None)
+            continue
+        out.append((st.st_mtime_ns, st.st_size, st.st_ino))
+    return tuple(out) if out[0] is not None else None
+
+
 def get_board(
     tenant: Optional[str] = Query(None, description="Filter to a single tenant"),
     include_archived: bool = Query(False),
@@ -312,6 +334,28 @@ def get_board(
     current_step_key: Optional[str] = Query(None, description="Restrict to tasks at this workflow step key")):
     """Full board grouped by status column; omitting ``board`` uses the active board
     (``HERMES_KANBAN_BOARD`` env → on-disk ``current`` pointer → ``default``)."""
+    resolved = _resolve_board(board)
+    sig = key = None
+    try:
+        path = str(kanban_db.kanban_db_path(board=resolved))
+        key = (path, tenant, include_archived, workflow_template_id, current_step_key)
+        sig = _board_file_sig(path)  # before the read: a commit during it is read again next time
+    except Exception:
+        pass
+    now = time.monotonic()
+    if sig is not None:
+        with _board_cache_lock:
+            hit = _board_cache.get(key)
+        if hit is not None and hit[0] == sig and now - hit[1] < _BOARD_CACHE_TTL_S:
+            return dict(hit[2], now=int(time.time()))
+    result = _get_board_uncached(tenant, include_archived, resolved, workflow_template_id, current_step_key)
+    if sig is not None:
+        with _board_cache_lock:
+            _board_cache[key] = (sig, now, result)
+    return result
+
+
+def _get_board_uncached(tenant, include_archived, board, workflow_template_id, current_step_key):
     with _board_conn(board) as (board, conn):
         tasks = kanban_db.list_tasks(
             conn, tenant=tenant, include_archived=include_archived,
@@ -421,13 +465,16 @@ async def get_board_endpoint(
     current_step_key: Optional[str] = Query(None, description="Restrict to tasks at this workflow step key"),
 ):
     # Resolve selection before keying so a board switch cannot join an older read.
-    return await _read_board(
+    result = await _read_board(
         tenant=tenant,
         include_archived=include_archived,
         board=board or kanban_db.get_current_board(),
         workflow_template_id=workflow_template_id,
         current_step_key=current_step_key,
     )
+    # The board is plain JSON data (multi-MB on a busy board): json.dumps it directly. FastAPI's jsonable_encoder
+    # walked ~190k objects per poll (~275 ms) for byte-identical output.
+    return Response(content=json.dumps(result), media_type="application/json")
 
 
 # --- GET /tasks/:id ---------------------------------------------------------
diff --git a/tests/plugins/test_kanban_board_read_cache.py b/tests/plugins/test_kanban_board_read_cache.py
new file mode 100644
index 0000000000..0c114635d5
--- /dev/null
+++ b/tests/plugins/test_kanban_board_read_cache.py
@@ -0,0 +1,88 @@
+"""Kanban dashboard plugin: GET /board reuses its last result while the board's files are unchanged.
+
+Desktop polls the board continuously and one read of a busy board cost ~1.3 s CPU, so the read is cached per
+board + query, keyed by the kanban.db/-wal file signature and at most ``_BOARD_CACHE_TTL_S`` old.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+
+
+def _load_plugin():
+    repo_root = Path(__file__).resolve().parents[2]
+    plugin_file = repo_root / "plugins" / "kanban" / "dashboard" / "plugin_api.py"
+    spec = importlib.util.spec_from_file_location("hermes_kanban_plugin_board_cache_test", plugin_file)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    kb.init_db()
+    mod = _load_plugin()
+    app = FastAPI()
+    app.include_router(mod.router, prefix="/api/plugins/kanban")
+    reads = []
+    real = mod._get_board_uncached
+    monkeypatch.setattr(mod, "_get_board_uncached", lambda *a: reads.append(a) or real(*a))
+    return mod, TestClient(app), reads
+
+
+def _titles(body: dict) -> set[str]:
+    return {t["title"] for col in body["columns"] for t in col["tasks"]}
+
+
+def _create(title: str) -> None:
+    conn = kbc.connect()
+    try:
+        kb.create_task(conn, title=title, assignee="worker")
+    finally:
+        conn.close()
+
+
+def test_unchanged_board_is_read_once_and_a_write_is_seen(board):
+    _mod, client, reads = board
+    _create("first")
+    one = client.get("/api/plugins/kanban/board").json()
+    two = client.get("/api/plugins/kanban/board").json()
+    assert len(reads) == 1 and _titles(one) == _titles(two) == {"first"}
+    assert two["now"] >= one["now"]
+    _create("second")
+    three = client.get("/api/plugins/kanban/board").json()
+    assert len(reads) == 2 and _titles(three) == {"first", "second"}
+
+
+def test_query_params_are_cached_separately(board):
+    _mod, client, reads = board
+    client.get("/api/plugins/kanban/board")
+    client.get("/api/plugins/kanban/board?include_archived=true")
+    assert len(reads) == 2
+
+
+def test_cache_expires_after_ttl(board, monkeypatch):
+    mod, client, reads = board
+    clock = {"t": 1000.0}
+    monkeypatch.setattr(mod.time, "monotonic", lambda: clock["t"])
+    client.get("/api/plugins/kanban/board")
+    clock["t"] += mod._BOARD_CACHE_TTL_S - 1
+    client.get("/api/plugins/kanban/board")
+    assert len(reads) == 1
+    clock["t"] += 2
+    client.get("/api/plugins/kanban/board")
+    assert len(reads) == 2
