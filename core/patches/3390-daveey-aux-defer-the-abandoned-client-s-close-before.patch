+@pytest.mark.parametrize("streamed", [False, True], ids=["complete", "native-adapter-stream"])
 def test_cancelled_class_call_never_hands_the_daemons_tls_fd_to_sqlite(stalling_stream, tmp_path, monkeypatch,
-                                                                       caplog):
