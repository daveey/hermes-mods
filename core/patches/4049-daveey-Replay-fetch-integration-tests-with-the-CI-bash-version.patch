From 6825785665f98163977037f5bb9789691e81348e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 02:26:01 +0000
Subject: [PATCH] [daveey] Replay fetch integration tests with the CI bash
 version

The macOS scheduled lane failed ten cases with mapfile: command not found because these integration helpers selected system bash 3.2, unlike the existing workflow replay harness. Reuse replay_bash for direct invocations and provide the selected shell to nested workflow commands through the fixture bin directory. Keep all fetch fallback and lazy tree assertions intact.

Proof: failed macOS run 43536374733 establishes the old-shell regression; canonical Linux run passes all 22 tests in test_fetch_merge_base, test_lint_advisory_fetch and test_workflow_steps_bash. scripts/check: 20 checks, ok. Native scheduled workflow verification remains required.
---
 tests/ci/test_fetch_merge_base.py    | 4 +++-
 tests/ci/test_lint_advisory_fetch.py | 7 +++++--
 2 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/tests/ci/test_fetch_merge_base.py b/tests/ci/test_fetch_merge_base.py
index 775fb19bf8..4ed3828e76 100644
--- a/tests/ci/test_fetch_merge_base.py
+++ b/tests/ci/test_fetch_merge_base.py
@@ -15,6 +15,8 @@ from pathlib import Path
 
 import pytest
 
+from tests.ci.workflow_steps import replay_bash
+
 ROOT = Path(__file__).resolve().parents[2]
 SCRIPT = ROOT / ".github/actions/fetch-merge-base/fetch-merge-base.sh"
 
@@ -47,7 +49,7 @@ def run_script(cwd: Path, *args: str, path_prefix: Path | None = None,
     env = {**os.environ, **GIT_ENV, **(extra_env or {})}
     if path_prefix is not None:
         env["PATH"] = f"{path_prefix}{os.pathsep}{env.get('PATH', '')}"
-    return subprocess.run(["bash", str(SCRIPT), *args], cwd=cwd, env=env, capture_output=True,
+    return subprocess.run([replay_bash(), str(SCRIPT), *args], cwd=cwd, env=env, capture_output=True,
                           encoding="utf-8", timeout=120, check=False)
 
 
diff --git a/tests/ci/test_lint_advisory_fetch.py b/tests/ci/test_lint_advisory_fetch.py
index d3a2b9e630..fb6494661a 100644
--- a/tests/ci/test_lint_advisory_fetch.py
+++ b/tests/ci/test_lint_advisory_fetch.py
@@ -19,6 +19,7 @@ import pytest
 from ruamel.yaml import YAML
 
 from tests.ci import _gha_expr as gha
+from tests.ci.workflow_steps import replay_bash
 from tests.ci.test_fetch_merge_base import GIT_255_BUG, GIT_ENV, PARTIAL_CLONE_KEYS, commit, git
 
 ROOT = Path(__file__).resolve().parents[2]
@@ -121,7 +122,7 @@ def pr_checkout(origin: Path, tmp_path: Path) -> Path:
     git(work, "fetch", "-q", "--no-tags", "--depth=2", "origin",
         "+refs/pull/7/merge:refs/remotes/pull/7/merge")
     git(work, "checkout", "-q", "--detach", "refs/remotes/pull/7/merge")
-    first = subprocess.run(["bash", str(SCRIPT), "main"], cwd=work, env={**os.environ, **GIT_ENV},
+    first = subprocess.run([replay_bash(), str(SCRIPT), "main"], cwd=work, env={**os.environ, **GIT_ENV},
                            capture_output=True, encoding="utf-8", timeout=120, check=False)
     assert first.returncode == 0, first.stderr
     assert git(work, "config", "--get", "remote.origin.promisor") == "true"
@@ -145,6 +146,8 @@ def run_step(name: str, work: Path, tmp_path: Path, fail: str) -> tuple[subproce
     assert gha.condition(step["if"], ctx), f"{name}: disabled for a Python pull request"
     bins = tmp_path / f"bin-{fail or 'ok'}-{STEPS.index(name)}"
     bins.mkdir()
+    # Nested workflow commands and env-bash shims need the same modern shell.
+    (bins / "bash").symlink_to(replay_bash())
     for tool, text in (("git", SHIM), ("python", FAKE_PYTHON)):
         (bins / tool).write_text(text, encoding="utf-8")
         (bins / tool).chmod(0o755)
@@ -156,7 +159,7 @@ def run_step(name: str, work: Path, tmp_path: Path, fail: str) -> tuple[subproce
            "PATH": f"{bins}{os.pathsep}{os.environ['PATH']}", "LINT_REAL_GIT": shutil.which("git"),
            "LINT_FAIL": fail, "LINT_ARGV_LOG": str(argv_log), "LINT_PYTHON_LOG": str(python_log),
            "LINT_BUG_TEXT": str(bug)}
-    result = subprocess.run(["bash", "--noprofile", "--norc", "-eo", "pipefail", "-c",
+    result = subprocess.run([replay_bash(), "--noprofile", "--norc", "-eo", "pipefail", "-c",
                              gha.render(step["run"], ctx)],
                             cwd=work, env=env, capture_output=True, encoding="utf-8", timeout=120,
                             check=False)
-- 
