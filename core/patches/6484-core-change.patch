+                           (context['run_id'],)).fetchone()
+        assert json.loads(row[0])['usage']['cache_read_tokens'] == 0
+        assert kb.claim_task(conn, tid) is not None
+
+
+def test_restart_and_renewed_window_do_not_erase_accounting_debt(kanban_home):
