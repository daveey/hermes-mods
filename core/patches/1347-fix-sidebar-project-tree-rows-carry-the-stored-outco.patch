From d868572385d78c7e8f49bcb6b178f0cec8c99b74 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 22:25:06 +0000
Subject: [PATCH] fix(sidebar): project-tree rows carry the stored outcome and
 mute, so the stripe stops flapping done<->attention [daveey]

/api/profiles/projects/tree previews (methods_projects._project_tree_row) dropped
outcome/muted while /api/profiles/sessions list rows carried them, so a chat with a
stored 'unresolved' outcome painted green from the tree and amber from the list,
flipping on every refresh (desktop.log stripe-transition source=project-tree vs
list-refetch). Stamp both fields on tree rows; test asserts every
sessionStatusStripe input is identical on a tree row and a list row of one chat.
---
 .../test_session_outcome_surfaces.py          | 41 +++++++++++++++++++
 tui_gateway/methods_projects.py               |  6 ++-
 2 files changed, 46 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_session_outcome_surfaces.py b/tests/hermes_cli/test_session_outcome_surfaces.py
index 5c5ca2f6e7a..47bb0500685 100644
--- a/tests/hermes_cli/test_session_outcome_surfaces.py
+++ b/tests/hermes_cli/test_session_outcome_surfaces.py
@@ -196,3 +196,44 @@ def test_cli_refresh_loads_plugin_providers(homes, probe_plugin, capsys):
 def test_web_refresh_loads_plugin_providers(client, homes, probe_plugin):
     seed(homes["default"])
     assert client.get("/api/sessions/chat/outcome?refresh=1").json()["outcome"]["kind"] == "decision"
+
+
+# ── tree rows match list rows ────────────────────────────────────────────
+
+# Every row field the Desktop's sessionStatusStripe reads (via session-row-stripe.tsx).
+_STRIPE_FIELDS = ("outcome", "muted", "message_count", "kanban_active", "kanban_blocked", "kanban_held", "kanban_parked",
+                  "kanban_stalled", "kanban_waiting_on", "kanban_attention", "goal_active", "cron_active", "background_active",
+                  "turn_live", "review_wait")
+
+
+def _tree_rows(node):
+    """Every session row anywhere in a projects-tree payload (rows are the dicts with a ``message_count``)."""
+    if isinstance(node, list):
+        for item in node:
+            yield from _tree_rows(item)
+    elif isinstance(node, dict):
+        if "message_count" in node and "id" in node:
+            yield node
+        for value in node.values():
+            yield from _tree_rows(value)
+
+
+def test_project_tree_rows_carry_the_list_rows_outcome_and_mute(client, homes):
+    """[daveey] A tree preview and a list row of one chat paint the same stripe: the tree used to drop
+    ``outcome``/``muted``, so an ``unresolved`` chat flapped green (tree) <-> amber (list) on every refresh."""
+    seed(homes["default"], "open-chat", reply="Should I also bump the version?")
+    seed(homes["default"], "done-chat")
+    seed(homes["default"], "muted-chat")
+    for sid in ("open-chat", "done-chat"):
+        client.get(f"/api/sessions/{sid}/outcome?refresh=1")
+    client.post("/api/sessions/muted-chat/mute", json={"muted": True})
+
+    listed = {r["id"]: r for r in client.get("/api/profiles/sessions?profile=all&limit=50").json()["sessions"]}
+    tree = client.get("/api/profiles/projects/tree", params={"preview_limit": 50}).json()
+    treed = {r["id"]: r for r in _tree_rows(tree)}
+    assert {"open-chat", "done-chat", "muted-chat"} <= set(treed) & set(listed)
+    assert listed["open-chat"]["outcome"]["kind"] == "unresolved"
+    assert (listed["done-chat"]["outcome"]["kind"], listed["muted-chat"]["muted"]) == ("done", True)
+    for sid in ("open-chat", "done-chat", "muted-chat"):
+        for field in _STRIPE_FIELDS:
+            assert treed[sid].get(field) == listed[sid].get(field), (sid, field)
diff --git a/tui_gateway/methods_projects.py b/tui_gateway/methods_projects.py
index f281373be4f..9099a5639cf 100644
--- a/tui_gateway/methods_projects.py
+++ b/tui_gateway/methods_projects.py
@@ -354,7 +354,11 @@ def _project_tree_row(r: dict, automated_sources: list[str] | None = None) -> di
             "message_count", "tool_call_count", "input_tokens", "output_tokens")},
         **{k: r.get(k) for k in ("actual_cost_usd", "estimated_cost_usd", "model")},
         is_active=False, **{k: r.get(k) for k in ("cwd", "git_branch", "git_repo_root")},
-        automated=is_automated_source(r.get("source"), automated_sources or []))
+        automated=is_automated_source(r.get("source"), automated_sources or []),
+        # [daveey] The stored outcome + mute, as list_sessions_rich stamped them on the list rows. Without them a
+        # tree row painted green from idleness while the list row painted amber (`unresolved`), and the sidebar
+        # stripe flapped done<->attention on every refresh depending on which source wrote last.
+        outcome=r.get("outcome"), muted=bool(r.get("muted")))
     return row
 
 
