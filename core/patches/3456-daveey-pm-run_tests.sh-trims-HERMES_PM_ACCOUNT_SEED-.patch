From 61d89371e3e0d3d996389751abd3739460d6f577 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:14:50 +0000
Subject: [PATCH] [daveey] pm: run_tests.sh trims HERMES_PM_ACCOUNT_SEED like
 pm; seed marker is a hint; justify the env var

Follow-up to PR #1994's exact-head review (t_01a1d46f36706cd5, GitHub review 5889500459), three
non-blocking nits (card t_01a1d478e27d689f):

1. scripts/run_tests.sh matched HERMES_PM_ACCOUNT_SEED with a bare `case`, while
   pm.environments.account_seed_enabled() strips whitespace first. So ' no ' turned off pm
   borrowing but not run_tests.sh tool-store borrowing. The check moves into
   `_account_seed_enabled`, which trims leading/trailing whitespace before the same
   case-insensitive match. tests/pm/test_account_seed.py::test_run_tests_opt_out_matches_pm runs
   that shell function against account_seed_enabled() for 12 values (and asserts
   _account_tool_store calls it). RED without the trim: ' no ', '\toff\n', '  0' fail; GREEN with it.
2. pm/packages.py: comment by _SEED_MARKER_LOCKS that the .seeded marker is a hint, not exact
   (unlocked read-modify-write; an older Hermes rewrites it as one line); both only cost an
   idempotent re-merge.
3. pm/AGENTS.md: why HERMES_PM_ACCOUNT_SEED is an env var despite root AGENTS.md's rule against new
   non-secret HERMES_* vars: per-process, set by CI before any home/config exists, read by
   run_tests.sh without starting Python.

Tests: tests/pm/test_account_seed.py 43 passed; scripts/check --base origin/main ok.
---
 pm/AGENTS.md                  |  5 ++++-
 pm/packages.py                |  5 ++++-
 scripts/run_tests.sh          | 11 +++++++++--
 tests/pm/test_account_seed.py | 29 +++++++++++++++++++++++++++++
 4 files changed, 46 insertions(+), 4 deletions(-)

diff --git a/pm/AGENTS.md b/pm/AGENTS.md
index 60d0e66867..7854e78335 100644
--- a/pm/AGENTS.md
+++ b/pm/AGENTS.md
@@ -53,4 +53,7 @@ bytes of an account inode.
 `HERMES_PM_ACCOUNT_SEED=0` turns borrowing off. CI sets it (`setup-pm`, whose `actions/cache`
 save/restore and `--exact-lock` prune act on the uv cache path), and so should a primary home kept
 outside `~/.hermes` beside a stale `~/.hermes`: it would otherwise share that home's uv cache and
-compile bytecode on first import instead of eagerly.
+compile bytecode on first import instead of eagerly. It is an environment variable, not a config
+key (root AGENTS.md otherwise rejects new non-secret `HERMES_*` variables), because it is
+per-process, CI sets it before any home or config exists, and `scripts/run_tests.sh` reads it
+(trimmed and case-folded the same way) to decide tool-store borrowing without starting Python.
diff --git a/pm/packages.py b/pm/packages.py
index 2833034677..69fd3467ce 100644
--- a/pm/packages.py
+++ b/pm/packages.py
@@ -496,7 +496,10 @@ def uv_cache_dir() -> Path:
 
 # One line per lock whose seed this cache holds. Homes on different locks share one cache (a
 # borrowing home uses the account's, ``uv_cache_path``); a single-value marker flipped between
-# them and made each re-run its payload merge after the other.
+# them and made each re-run its payload merge after the other. The marker is a hint, not an exact
+# record: its read-modify-write takes no lock, so two homes on different locks writing at once can
+# drop one line, and an older Hermes sharing the cache (single-value marker) rewrites it as one line.
+# Either only costs an idempotent re-merge of that lock's payload on its next call.
 _SEED_MARKER_LOCKS = 8
 
 
diff --git a/scripts/run_tests.sh b/scripts/run_tests.sh
index 5c6f110f1f..ca68574e7f 100755
--- a/scripts/run_tests.sh
+++ b/scripts/run_tests.sh
@@ -76,8 +76,7 @@ _has_pytest() { [ -n "$1" ] && [ -x "$1" ] && "$1" -c 'import pytest' 2>/dev/nul
 _account_tool_store() {
   local account py_minor
   [ -z "${HERMES_RUNTIME_DIR:-}" ] || return 1
-  # The same opt-out as pm.environments.account_seed_enabled (pm/AGENTS.md).
-  case "${HERMES_PM_ACCOUNT_SEED:-}" in 0|[Ff][Aa][Ll][Ss][Ee]|[Nn][Oo]|[Oo][Ff][Ff]) return 1 ;; esac
+  _account_seed_enabled || return 1
   account="$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)"
   [ -n "$account" ] || account="$(dscl . -read "/Users/$(id -un)" NFSHomeDirectory 2>/dev/null | sed -n 's/^NFSHomeDirectory: *//p')"
   [ -n "$account" ] && [ -d "$account" ] || return 1
@@ -91,6 +90,14 @@ _account_tool_store() {
   py_minor="$(_store_has_pins "$account/.hermes/tools")" || return 1
   printf '%s\n%s\n' "$account" "$py_minor"
 }
+# The same opt-out as pm.environments.account_seed_enabled (pm/AGENTS.md),
+# which strips surrounding whitespace and ignores case before matching.
+_account_seed_enabled() {
+  local value="${HERMES_PM_ACCOUNT_SEED:-}"
+  value="${value#"${value%%[![:space:]]*}"}"
+  value="${value%"${value##*[![:space:]]}"}"
+  case "$value" in 0|[Ff][Aa][Ll][Ss][Ee]|[Nn][Oo]|[Oo][Ff][Ff]) return 1 ;; esac
+}
 # Check, read-only for the store, that it already records this checkout's pins
 # (scripts/tool_store_pins.py says why and what counts, and the one write: the
 # borrower's own decline record); prints the Python minor.
diff --git a/tests/pm/test_account_seed.py b/tests/pm/test_account_seed.py
index 73f5a1e502..e6b76011e8 100644
--- a/tests/pm/test_account_seed.py
+++ b/tests/pm/test_account_seed.py
@@ -8,6 +8,7 @@ import io
 import json
 import os
 from pathlib import Path
+import subprocess
 from types import SimpleNamespace
 import zipfile
 
@@ -340,6 +341,34 @@ def test_other_opt_out_values_keep_borrowing(tmp_path, monkeypatch, value):
     assert environments.account_home_root() == tmp_path / ".hermes"
 
 
+def _run_tests_seed_function() -> str:
+    script = (Path(__file__).resolve().parents[2] / "scripts" / "run_tests.sh").read_text(encoding="utf-8")
+    store = script[script.index("_account_tool_store() {") :]
+    assert "  _account_seed_enabled || return 1\n" in store[: store.index("\n}\n")]
+    start = script.index("_account_seed_enabled() {")
+    return script[start : script.index("\n}\n", start) + 3]
+
+
+@pytest.mark.parametrize(
+    "value", ["", "1", "yes", "0", "off", "False", "NO", " no ", "\toff\n", "  0", "n o", "0x"]
+)
+def test_run_tests_opt_out_matches_pm(monkeypatch, value):
+    """scripts/run_tests.sh decides tool-store borrowing with the same opt-out pm uses.
+
+    Regression: its ``case`` skipped pm's whitespace strip, so ``' no '`` stopped pm borrowing
+    but not run_tests.sh's."""
+    from pm import environments
+
+    monkeypatch.setenv("HERMES_PM_ACCOUNT_SEED", value)
+    shell = subprocess.run(
+        ["bash", "-c", _run_tests_seed_function() + "_account_seed_enabled"],
+        env={"PATH": os.environ.get("PATH", ""), "HERMES_PM_ACCOUNT_SEED": value},
+        check=False,
+    )
+    assert shell.returncode in (0, 1)
+    assert (shell.returncode == 0) is environments.account_seed_enabled()
+
+
 # --- seed marker ------------------------------------------------------------------------------
 
 def test_homes_on_different_locks_do_not_rerun_each_others_seed(tmp_path, monkeypatch):
