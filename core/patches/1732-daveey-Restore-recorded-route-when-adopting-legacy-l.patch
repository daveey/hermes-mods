From 6f42180d3c062e46801f9d54f4452f90def8c2b3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 18:17:28 +0000
Subject: [PATCH] [daveey] Restore recorded route when adopting legacy local
 sessions

---
 gateway/session_local_migration.py            |  9 ++++
 .../test_legacy_launch_recorded_route.py      | 44 +++++++++++++++++++
 2 files changed, 53 insertions(+)
 create mode 100644 tests/gateway/test_legacy_launch_recorded_route.py

diff --git a/gateway/session_local_migration.py b/gateway/session_local_migration.py
index 99e0e2c7e25..faa5e6e2b70 100644
--- a/gateway/session_local_migration.py
+++ b/gateway/session_local_migration.py
@@ -97,6 +97,15 @@ def legacy_launch_params(row):
         route.setdefault('provider', 'custom')
     if row['source'] == 'acp' and 'cwd' not in params and Path(str(saved.get('cwd') or '')).is_absolute():
         params['cwd'] = saved['cwd']
+    from agent.model_routing_restore import restore_route
+    restored = restore_route(row.get('model'), saved)
+    if restored:
+        model, provider = restored
+        if (model, provider) != (row.get('model'), route.get('provider')):
+            # The recorded route wins, but the displaced provider's endpoint and
+            # wire protocol must not travel with it.
+            route = {'provider': provider}
+        params['model'] = model
     params.update({key: route[key] for key in ('provider', 'base_url') if key in route})
     reasoning = saved.get('reasoning_config')
     if isinstance(reasoning, dict):
diff --git a/tests/gateway/test_legacy_launch_recorded_route.py b/tests/gateway/test_legacy_launch_recorded_route.py
new file mode 100644
index 00000000000..56bc08aff33
--- /dev/null
+++ b/tests/gateway/test_legacy_launch_recorded_route.py
@@ -0,0 +1,44 @@
+"""Adoption must not reinterpret persisted routing provenance as a new pin."""
+import json
+
+import pytest
+
+from gateway.session_local_migration import legacy_launch_params
+
+
+@pytest.mark.parametrize('reason', ['allocation', 'explicit-switch'])
+def test_legacy_launch_keeps_recorded_exact_pin(monkeypatch, reason):
+    monkeypatch.setattr('agent.model_routing_restore.stale_managed_pin', lambda *args: False)
+    row = {
+        'id': 'legacy', 'source': 'desktop', 'cwd': '/workspace',
+        'model': 'gpt-6-astra', 'billing_provider': 'openai-codex',
+        'billing_base_url': 'https://chatgpt.com/backend-api/codex',
+        'model_config': json.dumps({
+            'provider': 'openai-codex', 'base_url': 'https://chatgpt.com/backend-api/codex',
+            'api_mode': 'codex_responses', 'reasoning_config': {'effort': 'high'},
+            'model_routing': {
+                'exact_pin': True, 'selected_model': 'claude-opus-5-5',
+                'selected_provider': 'anthropic', 'requested_class': 'deep', 'reason': reason,
+            },
+        }),
+    }
+    params, mode = legacy_launch_params(row)
+    assert params == {'cwd': '/workspace', 'model': 'claude-opus-5-5',
+                      'provider': 'anthropic', 'reasoning': 'high'}
+    assert mode is None  # the old provider's endpoint and wire mode must not follow
+
+
+def test_legacy_launch_retains_matching_route_endpoint(monkeypatch):
+    monkeypatch.setattr('agent.model_routing_restore.stale_managed_pin', lambda *args: False)
+    row = {'source': 'desktop', 'model': 'gpt-6-astra', 'model_config': {
+        'provider': 'openai-codex', 'base_url': 'https://chatgpt.com/backend-api/codex',
+        'api_mode': 'codex_responses', 'model_routing': {
+            'exact_pin': True, 'selected_model': 'gpt-6-astra',
+            'selected_provider': 'openai-codex', 'reason': 'explicit-switch',
+        },
+    }}
+    params, mode = legacy_launch_params(row)
+    assert params['model'] == 'gpt-6-astra'
+    assert params['provider'] == 'openai-codex'
+    assert params['base_url'] == 'https://chatgpt.com/backend-api/codex'
+    assert mode == 'codex_responses'
-- 
