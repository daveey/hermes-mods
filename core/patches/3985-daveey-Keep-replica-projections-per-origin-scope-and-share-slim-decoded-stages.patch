@@ -298,6 +347,11 @@ def _advance(s: _State, view, me: str, origin_profile: str) -> None:
     else:  # not the view ``s`` was advanced from: compare every row (no decode for unchanged ones)
         removed = s.stages.keys() - view.by_key.keys()
