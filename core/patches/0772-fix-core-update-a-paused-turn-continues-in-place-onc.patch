+def test_watchdog_reports_armed_while_polling_and_not_after_it_stops():
+    """A core-update-paused turn asks whether anything will retire this backend (update_pause)."""
+    import threading
+
+    from hermes_cli import web_server_skew_exit as m
+    from hermes_cli.backend_retirement import RetirementFence
+
+    release = threading.Event()
+    server = _Server()
+    thread = start_code_skew_watchdog(server, skew_fn=lambda: (release.wait(5), None)[1],
+                                      update_probe=lambda: False, fence=_Fence(idle=False),
+                                      poll_s=0.01, max_polls=1)
+    assert m.skew_watchdog_armed() is True
+    release.set()
+    thread.join(5)
+    assert m.skew_watchdog_armed() is False
+    # The fence says when a retirement is under way, so the paused turn hands off instead.
+    fence = RetirementFence()
+    assert fence.retiring() is False
+    fence._now = lambda: 0.0
+    with fence._lock:
+        fence._token, fence._expires_at = "t", 30.0
+    assert fence.retiring() is True
+    assert fence.commit("t")["ok"] and fence.retiring() is True
diff --git a/tests/tui_gateway/test_update_pause_recovery.py b/tests/tui_gateway/test_update_pause_recovery.py
index 1e1dfd67809..6302245a0ba 100644
--- a/tests/tui_gateway/test_update_pause_recovery.py
+++ b/tests/tui_gateway/test_update_pause_recovery.py
@@ -180,3 +180,98 @@ def test_in_place_watcher_retries_until_hold_lifts(recovery, monkeypatch):
     assert not watcher.is_alive()
     assert len(ticks) >= 2
     assert_continued(recovery)
+
+
+# ── The checkout moved: hand off to a successor only while one is actually coming (t_01a18300e42c3364) ──
+
+
+class _VirtualClock:
+    """Monotonic time that only moves when the watcher sleeps; ``on_tick`` runs after each sleep."""
+
+    def __init__(self, on_tick=None):
+        self.now, self.on_tick = 0.0, on_tick
+
+    def sleep(self, seconds):
+        self.now += seconds
+        if self.on_tick is not None:
+            self.on_tick(self.now)
+
+    def monotonic(self):
+        return self.now
+
+
+@pytest.fixture
+def skewed(recovery, monkeypatch):
+    """A paused turn on a backend whose checkout moved, with a fresh retirement fence per test."""
+    from hermes_cli import backend_retirement, web_server_idle_proof, web_server_skew_exit
+    fence = backend_retirement.RetirementFence()
+    monkeypatch.setattr(backend_retirement, "retirement", fence)
+    monkeypatch.setattr(up, "_detect_skew", lambda: ("boot-rev", "disk-rev"))
+    monkeypatch.setattr(web_server_skew_exit, "_update_in_progress", lambda: False)
+    state = types.SimpleNamespace(armed=True, idle=True, fence=fence)
+    monkeypatch.setattr(web_server_skew_exit, "skew_watchdog_armed", lambda: state.armed)
+    monkeypatch.setattr(web_server_idle_proof, "idle_proof", lambda *a, **kw: {"idle": state.idle})
+    return state
+
+
+def _watch(monkeypatch, recovery, clock, *, max_s=None):
+    if max_s is not None:
+        monkeypatch.setattr(up, "WATCH_MAX_S", max_s)
+    monkeypatch.setattr(up, "time", types.SimpleNamespace(sleep=clock.sleep, monotonic=clock.monotonic,
+                                                          time=time.time))
+    af.set_hold(recovery.home)  # a live backend's paused session: mounting it must not continue it yet
+    result = mount()
+    af.clear_hold(recovery.home)
+    session = server._sessions[result["session_id"]]
+    watcher = up.start_in_place_watcher(result["session_id"], session, "paused")
+    watcher.join(10)
+    assert not watcher.is_alive()
+    return result["session_id"]
+
+
+def test_no_replacement_coming_continues_in_place_within_the_bound(recovery, skewed, monkeypatch):
+    # Another chat keeps this backend busy, so its skew watchdog cannot retire it: nobody replaces it.
+    skewed.idle = False
+    clock = _VirtualClock()
+    _watch(monkeypatch, recovery, clock)
+    assert_continued(recovery)
+    # The first poll saw the move; the turn continued one bound later, not after the old 900 s grace.
+    assert clock.now <= up.WATCH_POLL_S + up.NO_REPLACEMENT_S + up.WATCH_POLL_S
+    assert clock.now < up.LEAVE_GRACE_S
+
+
+def test_no_retirement_watchdog_continues_in_place_at_once(recovery, skewed, monkeypatch):
+    skewed.armed = False  # e.g. a stdio TUI: nothing in this process ever retires it
+    clock = _VirtualClock()
+    _watch(monkeypatch, recovery, clock)
+    assert_continued(recovery)
+    assert clock.now == up.WATCH_POLL_S
+
+
+def test_skew_with_a_replacement_coming_does_not_continue_in_place(recovery, skewed, monkeypatch):
+    # Idle with a live watchdog: retirement is imminent, so the successor owns the continuation.
+    clock = _VirtualClock()
+    _watch(monkeypatch, recovery, clock, max_s=up.LEAVE_GRACE_S - up.WATCH_POLL_S)
+    assert clock.now >= up.NO_REPLACEMENT_S * 3
+    assert recovery.calls == [] and not recovery.done.is_set()
+
+
+def test_requested_replacement_hands_off_and_the_successor_continues_once(recovery, skewed, monkeypatch):
+    # The watchdog proves this backend idle and commits retirement: admission closes for good.
+    def retire(now):
+        if now >= 3 * up.WATCH_POLL_S and not skewed.fence.retiring():
+            permit = skewed.fence.prepare()
+            assert permit["ok"] and skewed.fence.commit(permit["token"])["ok"]
+            skewed.idle = False  # a busy-looking ledger must not make the watcher grab the turn back
+    clock = _VirtualClock(on_tick=retire)
+    sid = _watch(monkeypatch, recovery, clock, max_s=up.LEAVE_GRACE_S * 2)
+    # Even past every bound the retired backend never continued the turn here.
+    assert recovery.calls == [] and not recovery.done.is_set()
+    # The successor process: fresh fence, no live session, its startup sweep continues the turn once.
+    from hermes_cli import backend_retirement
+    monkeypatch.setattr(backend_retirement, "retirement", backend_retirement.RetirementFence())
+    server._sessions.pop(sid, None)
+    monkeypatch.setattr(up, "_detect_skew", lambda: None)
+    resumed = sr.resume_interrupted_sessions(server._methods["session.resume"], recovery.home, CFG)
+    assert resumed[0]["scheduled"] is True
+    assert_continued(recovery)
diff --git a/tui_gateway/update_pause.py b/tui_gateway/update_pause.py
index 3e8fb008ead..6bbd29f7d85 100644
--- a/tui_gateway/update_pause.py
+++ b/tui_gateway/update_pause.py
@@ -11,6 +11,11 @@ crash-resume attempt is used. Pauses are counted apart (``MAX_PAUSES`` per turn)
 
 A turn the next backend would not auto-continue is never paused. A paused turn whose window ends without
 an update (expired, apply refused) continues in place (``start_in_place_watcher``), so it never hangs.
+When the update did move the checkout, the turn is left for a successor only while one is coming: this
+process's skew watchdog runs and its idle proof holds (or a retirement is already under way). A backend
+kept busy by other work for ``NO_REPLACEMENT_S``, or one no watchdog retires, continues the turn here.
+The retirement fence makes the two exclusive: in-place work is admitted through it, so once retirement
+prepares or commits, the turn is left to the successor's startup sweep.
 """
 
 from __future__ import annotations
@@ -32,8 +37,14 @@ UPDATE_MARGIN_S = 600.0
 WATCH_POLL_S = 5.0
 WATCH_MAX_S = 6 * 3600.0
 # A skewed backend normally retires once idle and its successor continues the turn. One that is still
-# here this long after the checkout moved has no retirement path (e.g. a stdio TUI): continue in place.
-LEAVE_GRACE_S = 900.0
+# here this long after the checkout moved has no working retirement path: continue in place (backstop).
+LEAVE_GRACE_S = 300.0
+# [daveey] t_01a18300e42c3364: the skew watchdog retires a backend only through the idle proof, so a
+# backend with other work in flight (another chat's turn, a pending prompt, an unreadable ledger) is
+# not replaced while that lasts, and one with no watchdog (a stdio TUI) is never replaced. A paused
+# turn used to wait the whole grace (900 s) for that successor. Now it waits only while a replacement
+# is actually on its way; once none has been for this long, it continues here.
+NO_REPLACEMENT_S = 60.0
 
 
 def _now() -> float:
@@ -145,37 +156,74 @@ def in_place_resume_action(session: dict, marker_key: str, *, skew: Callable[[],
         held = True
     if held:
         return "wait"
-    if (skew or _detect_skew)() is not None:
-        return "leave"
+    # Settled first: a turn the user (or another path) already moved on is never handed off or resumed.
     with session["history_lock"]:
-        busy = bool(session.get("running") or session.get("_closing") or session.get("_finalized"))
+        busy = bool(session.get("running") or session.get("_closing") or session.get("_finalized")
+                    or session.get("_auto_continue_scheduled"))
     if busy:
         return "done"
     marker = read_turn_marker(_home(session), marker_key)
     if not marker or marker.get("reason") != PAUSE_REASON:
         return "done"
+    if (skew or _detect_skew)() is not None:
+        return "leave"
     return "resume"
 
 
+def replacement_outlook() -> str:
+    """Whether a successor backend is on its way for a skewed process: ``coming`` (a retirement is
+    preparing/committed, or the skew watchdog runs and the idle proof it retires through holds),
+    ``blocked`` (the watchdog runs but other work or an unreadable ledger keeps this process up) or
+    ``none`` (nothing in this process will retire it)."""
+    from hermes_cli.backend_retirement import retirement
+    from hermes_cli.web_server_skew_exit import skew_watchdog_armed
+    if retirement.retiring():
+        return "coming"
+    if not skew_watchdog_armed():
+        return "none"
+    from hermes_cli.web_server_skew_exit import _update_in_progress
+    if _update_in_progress():
+        return "blocked"  # the watchdog never retires while an update marker or checkout lock is live
+    from hermes_cli.web_server_idle_proof import idle_proof
+    try:
+        idle = idle_proof()["idle"]
+    except Exception:
+        idle = None
+    return "coming" if idle is True else "blocked"
+
+
 def start_in_place_watcher(sid: str, session: dict, marker_key: str) -> threading.Thread:
-    """Bounded daemon: continue the paused turn here when its window ends without an update."""
+    """Bounded daemon: continue the paused turn here when its window ends without an update, or when
+    the checkout moved but no successor backend is coming to continue it."""
 
     def run() -> None:
         from tui_gateway import server
-        started, left_at = time.monotonic(), None
+        started, left_at, blocked_since = time.monotonic(), None, None
         while time.monotonic() - started < WATCH_MAX_S:
             time.sleep(WATCH_POLL_S)
             try:
                 action = in_place_resume_action(session, marker_key)
                 if action == "leave":
+                    now = time.monotonic()
                     if left_at is None:
-                        left_at = time.monotonic()
+                        left_at = now
                         logger.info("core-update pause: checkout moved; session %s continues on the next backend",
                                     marker_key)
-                    if time.monotonic() - left_at < LEAVE_GRACE_S:
+                    outlook = replacement_outlook()
+                    if outlook == "coming":
+                        blocked_since = None
+                    elif blocked_since is None:
+                        blocked_since = now
+                    blocked_for = 0.0 if blocked_since is None else now - blocked_since
+                    if outlook == "none" or blocked_for >= NO_REPLACEMENT_S:
+                        logger.info("core-update pause: no backend replacement is coming (%s); continuing session "
+                                    "%s here", "no retirement watchdog" if outlook == "none" else
+                                    f"backend kept busy for {blocked_for:.0f}s", marker_key)
+                    elif now - left_at >= LEAVE_GRACE_S:
+                        logger.info("core-update pause: backend still not replaced after %.0fs; continuing session "
+                                    "%s here", LEAVE_GRACE_S, marker_key)
+                    else:
                         continue
-                    logger.info("core-update pause: backend still not replaced after %.0fs; continuing session "
-                                "%s here", LEAVE_GRACE_S, marker_key)
                     action = "resume"
                 if action == "wait":
                     continue
