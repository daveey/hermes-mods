From dd687376b0825cf617aaff657f1a39051290ce45 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 19:40:25 +0000
Subject: [PATCH] [daveey] Retain closed containment archive history through
 local event GC

---
 hermes_cli/kanban_db.py                        |  3 ++-
 ...test_kanban_containment_terminal_archive.py | 18 ++++++++++++++++++
 2 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index f8d438fcae..bc177ece71 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -3670,12 +3670,13 @@ def gc_events(conn: sqlite3.Connection, *, older_than_seconds: int = 30 * 24 * 3
     ``older_than_seconds=0`` means everything older than now; the CLI maps
     ``--event-retention-days 0`` to "disabled" before calling this.
     """
+    from hermes_cli.kanban_containment_terminal import parent_status_sql
     cutoff = int(time.time()) - _retention_seconds(older_than_seconds)
     with write_txn(conn):
         cur = conn.execute(
             "DELETE FROM task_events WHERE created_at < ? AND kind NOT IN ('decomposed', 'origin_intent_recorded', "
             "'contained', 'containment_released', 'containment_closed') "
-            "AND task_id IN (SELECT id FROM tasks WHERE status IN ('done', 'archived'))", (cutoff,),
+            f"AND task_id IN (SELECT id FROM tasks WHERE {parent_status_sql(conn)} IN ('done', 'archived'))", (cutoff,),
         )
     return int(cur.rowcount or 0)
 
diff --git a/tests/hermes_cli/test_kanban_containment_terminal_archive.py b/tests/hermes_cli/test_kanban_containment_terminal_archive.py
index b6bf4d47f6..7d557de2c4 100644
--- a/tests/hermes_cli/test_kanban_containment_terminal_archive.py
+++ b/tests/hermes_cli/test_kanban_containment_terminal_archive.py
@@ -61,6 +61,24 @@ def test_authority_terminal_policy(board, authority_status, producer, allowed):
     assert kb.get_task(board, consumer).status == "todo"
 
 
+def test_gc_preserves_closed_history_without_stopping_other_events(board, monkeypatch):
+    relay, _, authority, target, spec = lifecycle.setup(board)
+    lifecycle.contain(board, relay, target, spec)
+    assert kb.archive_task(board, authority)
+    assert kb.archive_task(board, relay)
+    held_ids = [r[0] for r in board.execute("SELECT uid FROM task_events WHERE task_id=?", (relay,))]
+    normal = kb.create_task(board, title="Ordinary archived card", assignee="default")
+    assert kb.archive_task(board, normal)
+    assert board.execute("SELECT 1 FROM task_events WHERE task_id=?", (normal,)).fetchone()
+    future = kb.time.time() + 31 * 24 * 3600
+    monkeypatch.setattr(kb.time, "time", lambda: future)
+    assert kb.gc_events(board) > 0
+    assert not board.execute("SELECT 1 FROM task_events WHERE task_id=?", (normal,)).fetchone()
+    assert [r[0] for r in board.execute("SELECT uid FROM task_events WHERE task_id=?", (relay,))] == held_ids
+    assert connections.held(board, relay)
+    assert kb.get_task(board, relay).status == "archived"
+
+
 def test_terminal_writer_does_not_grant_ready_permission(board):
     from hermes_cli.kanban_containment_terminal import writer
     relay, _, _, target, spec = lifecycle.setup(board)
