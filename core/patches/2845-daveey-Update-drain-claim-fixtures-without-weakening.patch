From f7c08f11af7ebfd300838f8a96c1b3364218c3da Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 02:17:45 +0000
Subject: [PATCH] [daveey] Update drain claim fixtures without weakening
 retirement checks

Proof: original head reproduces four failures; base retirement file passes all nine tests. Both retirement timeouts are drain-task TypeErrors in old two-argument claim wrappers, not production stranding. Forward attempted identity and model claim_changed; preserve every assertion and timeout. Six targeted files pass 40 tests.
---
 tests/gateway/test_hosted_room_retired_admission.py | 4 ++--
 tests/gateway/test_local_closed_retirement.py       | 8 ++++----
 tests/gateway/test_runtime_worker_shutdown.py       | 3 ++-
 3 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/tests/gateway/test_hosted_room_retired_admission.py b/tests/gateway/test_hosted_room_retired_admission.py
index b1461b0cbc..36378a3867 100644
--- a/tests/gateway/test_hosted_room_retired_admission.py
+++ b/tests/gateway/test_hosted_room_retired_admission.py
@@ -57,8 +57,8 @@ def test_a_deferred_turn_s_queued_input_is_refused_and_the_next_turn_runs(hosted
     claimed = []
     original = session_authority.SessionAuthority._claim_next
 
-    async def claim(self, ref, live):
-        result = await original(self, ref, live)
+    async def claim(self, ref, live, attempted=None):
+        result = await original(self, ref, live, attempted)
         claimed.append(result[1]['payload']['text'] if result and result[1] else None)
         raise asyncio.CancelledError  # stop at the first real claim: the head it reached is the proof
     monkeypatch.setattr(session_authority.SessionAuthority, '_claim_next', claim)
diff --git a/tests/gateway/test_local_closed_retirement.py b/tests/gateway/test_local_closed_retirement.py
index f48fc4e231..177687bc83 100644
--- a/tests/gateway/test_local_closed_retirement.py
+++ b/tests/gateway/test_local_closed_retirement.py
@@ -92,12 +92,12 @@ async def test_prompt_admitted_while_the_close_runs_is_never_stranded(tmp_path,
 
     original_claim = authority._claim_next
 
-    async def held_claim(ref, live):
+    async def held_claim(ref, live, attempted=None):
         if replies == [] and not release_claim.is_set():
             async with live.claim_gate:  # parked mid-claim, as a drain awaiting the claim's write is
                 claim_started.set()
                 await release_claim.wait()
-        return await original_claim(ref, live)
+        return await original_claim(ref, live, attempted)
 
     async def finalize(**_kwargs):
         # The lifecycle's await: a prompt arrives and its drain starts claiming meanwhile.
@@ -162,12 +162,12 @@ async def test_prompt_parked_behind_a_busy_head_while_the_close_runs_is_never_st
 
     original_claim = authority._claim_next
 
-    async def busy_claim(ref, live):
+    async def busy_claim(ref, live, attempted=None):
         if not parked.is_set():  # the head is held by a worker: the drain pauses ``session_busy``
             live.rescan = False
             parked.set()
             return None, {"admission_id": "held"}
-        return await original_claim(ref, live)
+        return await original_claim(ref, live, attempted)
 
     async def finalize(**_kwargs):
         await authority.submit(_viewer(), Submission("parked", ref, {"text": "parked"}, "queue"))
diff --git a/tests/gateway/test_runtime_worker_shutdown.py b/tests/gateway/test_runtime_worker_shutdown.py
index 8a3e4e67a2..eced488ec2 100644
--- a/tests/gateway/test_runtime_worker_shutdown.py
+++ b/tests/gateway/test_runtime_worker_shutdown.py
@@ -153,7 +153,8 @@ async def test_persisted_work_count_returns_to_zero_when_the_drain_ends():
     authority = SessionAuthority.__new__(SessionAuthority)
     runner = SimpleNamespace(_running_agents={}, session_authority=authority,
                              _persist_active_agents=lambda: persisted.append(uncounted_runtime_work(runner)))
-    live = SimpleNamespace(task=None, route='route', event_stream=SimpleNamespace(execution={'execution_generation': 1}))
+    live = SimpleNamespace(task=None, route='route', claim_changed=asyncio.Event(),
+                           event_stream=SimpleNamespace(execution={'execution_generation': 1}))
     authority.runner, authority.sessions, authority._managed_workers = runner, {'s': live}, {}
 
     async def drain(_ref):
-- 
2.43.0

