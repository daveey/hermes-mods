From 2f3245821fe52c4a2953667cd50fdca5ab771396 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 22:56:31 +0000
Subject: [PATCH] [daveey] kanban release: legacy own-write binding tolerates
 stripped padding

add_comment records len(body) but stores body.strip(), so a legacy
kanban_comment body ending in a newline has payload len = stored length + 1
and #3635's exact length check left it "Comment data unavailable" (review
finding on #3635).

On the hub board 5901 of 5907 comments with a provable comment_uid differ by
0 and 6 by 1; the binding now accepts 0..2 stripped characters (2 admits
"\r\n"). The row's id, author and write clocks must still match as before.
Also corrects the _resolve docstring about body length.

Tests: "\n", "\r\n" and " \n" padding on promote, unblock and the agent tool
fail without the change; a gap of 3 or a stored body longer than recorded
stays unavailable.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/kanban_release_comments.py         | 13 ++++---
 .../test_kanban_release_imported_comments.py  | 36 +++++++++++++++++--
 2 files changed, 43 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_release_comments.py b/hermes_cli/kanban_release_comments.py
index e7fdc39c6c028786559fce2864e7893c95b19831..93f5fceb55f5e41a435551ca4cc765e325c6f2a0 100644
--- a/hermes_cli/kanban_release_comments.py
+++ b/hermes_cli/kanban_release_comments.py
@@ -156,7 +156,9 @@ def _resolve(rows, event, payload, *, local_writer=False):
     Legacy synced events have no portable reference. Require acknowledgement of
     every plausible same-time/author row rather than guess among collisions.
     The timestamp tolerance covers the writer crossing a second between inserts;
-    body length cannot disambiguate because add_comment strips stored text.
+    body length alone cannot disambiguate (add_comment stores stripped text and
+    records the unstripped length); ``_own_write`` uses it only alongside the
+    event's own integer, author and write clocks.
     """
     if payload.get("comment_uid"):
         return [r for r in rows if "uid" in r.keys() and r["uid"] == payload["comment_uid"]]
@@ -173,6 +175,9 @@ def _resolve(rows, event, payload, *, local_writer=False):
 
 
 _LOCK_WAIT = 60  # seconds a legacy row stamp may precede its event (add_comment stamped it before the lock)
+# add_comment records len(body) but stores body.strip(): on the hub board 5901 of 5907 provable comments differ by
+# 0 and 6 by 1 (a trailing newline). 2 also admits "\r\n"; anything longer is a different text.
+_STRIPPED = 2
 
 
 def _uuid7_ms(uid):
@@ -191,8 +196,8 @@ def _own_write(rows, event, payload):
     the row's ``created_at`` seconds before its event's (5 s and 7 s on
     t_0b716b01a47db7f6), outside the one-second rule above. The row the event
     names is then bound only when all of these hold: its id is the event's
-    ``comment_id`` and its author and stored length are the event's ``author``
-    and ``len``; both uids are UUIDv7 within a second of each other; the
+    ``comment_id``, its author is the event's ``author`` and its stored length is
+    the event's ``len`` less at most ``_STRIPPED`` stripped characters; both uids are UUIDv7 within a second of each other; the
     event's uid was minted at its write (within 2 s of its own ``created_at``,
     which a sync-enable backfill days later is not); and the row stamp precedes
     the event by at most ``_LOCK_WAIT``.
@@ -212,7 +217,7 @@ def _own_write(rows, event, payload):
             continue
         row_ms = _uuid7_ms(row["uid"]) if "uid" in row.keys() else None
         if (row_ms is not None and abs(row_ms - event_ms) <= 1000
-                and row["author"] == author.strip() and len(row["body"]) == length
+                and row["author"] == author.strip() and 0 <= length - len(row["body"]) <= _STRIPPED
                 and 0 <= event["created_at"] - row["created_at"] <= _LOCK_WAIT):
             return [row]
     return []
diff --git a/tests/hermes_cli/test_kanban_release_imported_comments.py b/tests/hermes_cli/test_kanban_release_imported_comments.py
index e3e8ac0e7ff322cc05b13264fe2d9a0c9857206e..a167a3c83a1b76c0b90dd45d0c0a33754fde354c 100644
--- a/tests/hermes_cli/test_kanban_release_imported_comments.py
+++ b/tests/hermes_cli/test_kanban_release_imported_comments.py
@@ -240,12 +240,13 @@ def _uid_ms(ms, salt):
 
 
 def _legacy_own_write(tid, *, drift_s=5, uid_gap_ms=6, mint_offset_ms=57, author=None, length=None,
-                      comment_id=None, event_uid=None, row_uid=None):
+                      comment_id=None, event_uid=None, row_uid=None, padding=""):
     """t_0b716b01a47db7f6 shape (live: 5 s / 6 ms and 7 s / 1 ms): an add_comment row stamped before the
     write lock, its event after, no comment_uid, no run provenance, no transcript."""
     enable_sync(tid)
     body = "SOURCE-ONLY next-prefix manifest (subagent; no live DB)"
-    cid = comment(tid, session="20261111_193650_c64738", age=8 * 86400, body=body)
+    cid = comment(tid, session="20261111_193650_c64738", age=8 * 86400, body=body + padding)
+    body += padding  # the payload's len counts what the caller passed; the row stores it stripped
     with kbc.connect_closing() as conn:
         row = conn.execute("SELECT * FROM task_comments WHERE id=?", (cid,)).fetchone()
         ev_at = row["created_at"] + drift_s
@@ -325,3 +326,34 @@ def test_backfill_race_spare_row_cannot_stand_in(board, entry, capsys):
             conn.execute("DELETE FROM task_comments WHERE id=?", (cid,))  # not synced to this reader yet
     ok, output = release(board, entry, capsys, spare_id)
     assert not ok and "Comment data unavailable" in output, output
+
+
+@pytest.mark.parametrize("entry", ["promote", "unblock", "tool"])
+@pytest.mark.parametrize("padding", ["\n", "\r\n", " \n"])
+def test_legacy_own_write_with_stripped_padding(board, entry, padding, capsys):
+    """A legacy kanban_comment body ending in whitespace: payload len counts it, the row stores it stripped."""
+    cid = _legacy_own_write(board, padding=padding)
+    with kbc.connect_closing() as conn:
+        stored = conn.execute("SELECT body FROM task_comments WHERE id=?", (cid,)).fetchone()[0]
+    assert not stored.endswith(("\n", " "))
+    ok, output = release(board, entry, capsys, cid - 1)
+    assert not ok and "SOURCE-ONLY next-prefix" in output and "data unavailable" not in output, output
+    ok, output = release(board, entry, capsys, cid)
+    assert ok, output
+
+
+@pytest.mark.parametrize("entry", ["promote", "unblock", "tool"])
+@pytest.mark.parametrize("delta", [3, -1])
+def test_legacy_own_write_length_bound(board, entry, delta, capsys):
+    """Three or more extra characters, or a stored body longer than recorded, is a different text."""
+    import re
+    cid = _legacy_own_write(board)
+    with kbc.connect_closing() as conn:
+        with kbc.write_txn(conn):
+            ev = conn.execute("SELECT id, payload FROM task_events WHERE task_id=? AND kind='commented' "
+                              "AND json_extract(payload, '$.comment_id')=?", (board, cid)).fetchone()
+            payload = json.loads(ev["payload"])
+            payload["len"] += delta
+            conn.execute("UPDATE task_events SET payload=? WHERE id=?", (json.dumps(payload), ev["id"]))
+    ok, output = release(board, entry, capsys, cid + 1000)
+    assert not ok and "data unavailable" in output, re.sub(r"\s+", " ", output)[:300]
-- 
