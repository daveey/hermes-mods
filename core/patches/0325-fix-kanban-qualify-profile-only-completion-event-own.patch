From e4ff832a8937d23851d8e637685c37ad617a3033 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 25 Oct 2026 19:35:58 +0000
Subject: [PATCH] fix(kanban): qualify profile-only completion event owners
 [daveey]

---
 .../src/store/native-notifications.test.ts    | 23 +++++++++++++++++++
 .../desktop/src/store/native-notifications.ts |  8 +++----
 2 files changed, 27 insertions(+), 4 deletions(-)

diff --git a/apps/desktop/src/store/native-notifications.test.ts b/apps/desktop/src/store/native-notifications.test.ts
index ddd40d5bc1..3dba369724 100644
--- a/apps/desktop/src/store/native-notifications.test.ts
+++ b/apps/desktop/src/store/native-notifications.test.ts
@@ -19,6 +19,7 @@ import { __resetNativeNotifyBaselineForTests, markNativeNotifyBaseline } from '.
 import { $approvalRequest, APPROVAL_RESPOND_REQUEST_TIMEOUT_MS, clearAllPrompts, setApprovalRequest } from './prompts'
 import { markSessionGone, resetBackgroundPollingGuard } from './runtime-gone'
 import { setActiveSessionId, setSessions } from './session'
+import { stampSecondaryProfileOwner } from './session-event-provenance'
 import { dropSessionState, publishSessionState, recordSessionEventScope } from './session-states'
 
 const desktopWindow = window as unknown as { hermesDesktop?: Window['hermesDesktop'] }
@@ -226,6 +227,28 @@ describe('dispatchNativeNotification focus gating', () => {
     }
   })
 
+  it('keeps a proven profile-only event on the primary owner', () => {
+    const runtime = freshSession()
+    const stored = `${runtime}-stored`
+    setPrimaryGatewayConnectionId('owner-a')
+    publishSessionState(runtime, createClientSessionState(stored))
+    recordSessionEventScope(stampSecondaryProfileOwner({ session_id: runtime } as never, 'work'))
+    setActiveSessionId(runtime)
+    const endedAt = Date.now() / 1000
+
+    try {
+      setSessions([{ id: stored, profile: 'work', connection_id: 'owner-b', kanban_observed_at: endedAt } as never])
+      expect(dispatchNativeNotification({ kind: 'turnDone', sessionId: runtime, title: 'done',
+        projectionAfter: endedAt })).toBe(false)
+      setSessions([{ id: stored, profile: 'work', kanban_observed_at: endedAt } as never])
+      expect(notify).toHaveBeenCalledTimes(1)
+    } finally {
+      dropSessionState(runtime)
+      setSessions([])
+      setPrimaryGatewayConnectionId(null)
+    }
+  })
+
   it('retains a missing projection using the independently recorded runtime owner', () => {
     const runtime = freshSession()
     const stored = `${runtime}-stored`
diff --git a/apps/desktop/src/store/native-notifications.ts b/apps/desktop/src/store/native-notifications.ts
index 6e3debbb7b..31940cf0b7 100644
--- a/apps/desktop/src/store/native-notifications.ts
+++ b/apps/desktop/src/store/native-notifications.ts
@@ -266,8 +266,8 @@ function deferCompletion(input: NativeNotificationInput, storedId: string, owner
       const currentId = storedSessionIdForRuntimeId(id)
       const owner = runtimeSessionOwner(id)
 
-      const runtimePin = owner && typeof owner === 'object'
-        ? projectionOwner({ connection_id: owner.connectionId, profile: owner.profile }) : undefined
+      const runtimePin = typeof owner === 'string' ? projectionOwner({ profile: owner })
+        : owner ? projectionOwner({ connection_id: owner.connectionId, profile: owner.profile }) : undefined
 
       if (runtimePin !== undefined && runtimePin !== pending.owner) {
         deferredCompletions.delete(id)
@@ -370,8 +370,8 @@ export function dispatchNativeNotification(input: NativeNotificationInput): bool
     const storedId = storedSessionIdForRuntimeId(input.sessionId) ?? input.sessionId
     const owner = runtimeSessionOwner(input.sessionId) ?? knownOwnerForSession(input.sessionId)
 
-    const ownerPin = owner && typeof owner === 'object'
-      ? projectionOwner({ connection_id: owner.connectionId, profile: owner.profile }) : undefined
+    const ownerPin = typeof owner === 'string' ? projectionOwner({ profile: owner })
+      : owner ? projectionOwner({ connection_id: owner.connectionId, profile: owner.profile }) : undefined
 
     const rows = ownerLookupSessionRows().filter(row => sessionMatchesStoredId(row, storedId) &&
       (ownerPin === undefined || projectionOwner(row) === ownerPin))
-- 
