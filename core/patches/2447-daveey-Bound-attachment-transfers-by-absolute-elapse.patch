new file mode 100644
index 0000000000..ffdc73208c
--- /dev/null
+++ b/hermes_cli/kanban_sync_attachment_deadline.py
@@ -0,0 +1,81 @@
+"""Absolute attachment transfer budget, including headers and body. [daveey]"""
+from __future__ import annotations
+
+import http.client
+import socket
+import threading
+import time
+import urllib.request
+
+
+class Transfer:
+    """Own the transport sockets so expiry cancels a trickling urllib reader.
+
+    DNS cannot be interrupted; a connection completing after expiry is shut down
+    before it can send credentials. No retries or redirects occur here.
+    """
+
+    def __init__(self, budget: float):
+        self.deadline = time.monotonic() + budget
+        self.lock = threading.Lock()
+        self.expired = False
+        self.sockets = []
+
+    @staticmethod
+    def cut(sock):
+        try:
+            # Bypass SSLSocket methods while its owner may be inside SSL_read.
+            socket.socket.shutdown(sock, socket.SHUT_RDWR)
+        except OSError:
+            pass
+
+    def connection(self, base):
+        transfer = self
+
+        class Connection(base):
+            def connect(self):
+                super().connect()
+                with transfer.lock:
+                    if transfer.expired:
+                        transfer.cut(self.sock)
+                        self.close()
+                        raise TimeoutError("attachment transfer deadline exceeded")
+                    transfer.sockets.append(self.sock)
+
+        return Connection
+
+    def handlers(self):
+        http_connection = self.connection(http.client.HTTPConnection)
+        https_connection = self.connection(http.client.HTTPSConnection)
+
+        class HTTP(urllib.request.HTTPHandler):
+            def http_open(self, req):
+                return self.do_open(http_connection, req)
+
+        class HTTPS(urllib.request.HTTPSHandler):
+            def https_open(self, req):
+                return self.do_open(https_connection, req, context=self._context)
+
+        return HTTP(), HTTPS()
+
+    def run(self, operation):
+        box = {}
+
+        def worker():
+            try:
+                box["result"] = operation()
+            except BaseException as exc:  # health: allow BLE001 -- re-raised on calling thread
+                box["error"] = exc
+
+        thread = threading.Thread(target=worker, daemon=True, name="kanban-attachment-transfer")
+        thread.start()
+        thread.join(max(0.0, self.deadline - time.monotonic()))
+        if thread.is_alive() or time.monotonic() >= self.deadline:
+            with self.lock:
+                self.expired = True
+                for sock in self.sockets:
+                    self.cut(sock)
+            raise TimeoutError("attachment transfer deadline exceeded")
+        if "error" in box:
+            raise box["error"]
+        return box["result"]
diff --git a/hermes_cli/kanban_sync_attachment_http.py b/hermes_cli/kanban_sync_attachment_http.py
index 2f0a47a170..25ec86cdf3 100644
--- a/hermes_cli/kanban_sync_attachment_http.py
+++ b/hermes_cli/kanban_sync_attachment_http.py
@@ -17,16 +17,25 @@ class _NoRedirect(urllib.request.HTTPRedirectHandler):
 
 def _request(hub, method: str, path: str, data: bytes | None, cap: int) -> bytes:
     from hermes_cli.kanban_sync_client import HubError
+    from hermes_cli.kanban_sync_attachment_deadline import Transfer
     headers = {**hub._headers(), "content-type": "application/octet-stream"}
     request = urllib.request.Request(hub.ident.url + path, data=data, headers=headers, method=method)
-    try:
-        with urllib.request.build_opener(_NoRedirect()).open(request, timeout=hub._remaining(5.0)) as response:
+    budget = hub._remaining(5.0)
+    transfer = Transfer(budget)
+
+    def read():
+        opener = urllib.request.build_opener(_NoRedirect(), *transfer.handlers())
+        with opener.open(request, timeout=budget) as response:
             body = response.read(cap + 1)
             if len(body) > cap:
                 raise ValueError("attachment response exceeds size limit")
             return body
+
+    try:
+        return transfer.run(read)
     except urllib.error.HTTPError as exc:
         # Do not persist response bodies, URLs or gateway keys in retry diagnostics.
+        exc.close()
         raise HubError(exc.code, "attachment transfer refused") from exc
     except http.client.HTTPException as exc:
         raise OSError("incomplete attachment response") from exc
