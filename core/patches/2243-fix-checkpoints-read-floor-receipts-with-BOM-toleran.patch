From 29a77481a3cdb3d44abe4410fe47ee94aea49e48 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 07:57:08 +0000
Subject: [PATCH] fix(checkpoints): read floor receipts with BOM tolerant
 encoding [daveey]

---
 tools/checkpoint_health.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tools/checkpoint_health.py b/tools/checkpoint_health.py
index 8a14fd9c1b0..36ce940eca9 100644
--- a/tools/checkpoint_health.py
+++ b/tools/checkpoint_health.py
@@ -40,7 +40,7 @@ def protected_floor(store: Path, size: int) -> bool:
     if (store / GC_PENDING_NAME).exists():
         return False
     try:
-        receipt = json.loads((store.parent / FLOOR_MARKER).read_text(encoding="utf-8"))
+        receipt = json.loads((store.parent / FLOOR_MARKER).read_text(encoding="utf-8-sig"))
     except (OSError, ValueError):
         return False
     if not isinstance(receipt, dict) or receipt.get("size") != size:
-- 
