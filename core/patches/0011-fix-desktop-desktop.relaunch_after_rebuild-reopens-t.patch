From 07a482c8a83682952e1d610e75f5df77b89f410e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 11 Oct 2026 17:17:16 -0700
Subject: [PATCH] fix(desktop): desktop.relaunch_after_rebuild reopens the app
 a headless update stopped for the bundle swap [daveey]

---
 hermes_cli/config_defaults.py                 |   4 +
 hermes_cli/main_desktop.py                    |  75 ++++++++++
 .../hermes_cli/test_desktop_swap_relaunch.py  | 131 ++++++++++++++++++
 3 files changed, 210 insertions(+)
 create mode 100644 tests/hermes_cli/test_desktop_swap_relaunch.py

diff --git a/hermes_cli/config_defaults.py b/hermes_cli/config_defaults.py
index 0d26efc903..cd580af266 100644
--- a/hermes_cli/config_defaults.py
+++ b/hermes_cli/config_defaults.py
@@ -2675,6 +2675,10 @@ DEFAULT_CONFIG = {
             # not only the ones the user re-opens. Same freshness/attempt guards apply.
             "resume_on_startup": False,
         },
+        # Reopen a desktop app that `hermes update` / `hermes desktop --build-only` had to stop to
+        # swap in the rebuilt bundle (macOS/Linux). Off = upstream behaviour: a headless update
+        # (CLI, launchd, cron) leaves the app closed; only the in-app Update hand-off reopens it.
+        "relaunch_after_rebuild": False,
     },
 
     "nous": {
diff --git a/hermes_cli/main_desktop.py b/hermes_cli/main_desktop.py
index 2326a395b9..9d20d012e8 100644
--- a/hermes_cli/main_desktop.py
+++ b/hermes_cli/main_desktop.py
@@ -262,6 +262,7 @@ def _swap_staged_desktop_app(desktop_dir: Path, staging_dir: Path) -> Optional[P
         shutil.rmtree(staging_dir, ignore_errors=True)
         return None
     release_dir = desktop_dir / "release"
+    relaunch: list[list[str]] = []
     try:
         staged_root = _desktop_unpacked_root(staged_exe, staging_dir)
         live_root = release_dir / staged_root.name
@@ -275,9 +276,11 @@ def _swap_staged_desktop_app(desktop_dir: Path, staging_dir: Path) -> Optional[P
             # wait for it — only the update hand-offs do). Either way a renderer alive
             # past the rename below keeps fetching its old hashed chunks from disk and
             # dies on the next lazy import, so stop it on every platform (#109643).
+            launches = _desktop_main_launches(desktop_dir)
             stopped = _stop_desktop_processes_locking_build(desktop_dir, also_posix=True)
             if stopped:
                 logger.info("stopped desktop processes before staged app promotion: %s", stopped)
+                relaunch = [argv for pid, argv in launches.items() if pid in stopped]
             _rename_riding_out_file_lock(live_root, previous)
         try:
             _rename_riding_out_file_lock(staged_root, live_root)
@@ -289,12 +292,84 @@ def _swap_staged_desktop_app(desktop_dir: Path, staging_dir: Path) -> Optional[P
             shutil.rmtree(previous, ignore_errors=True)
     except (OSError, ValueError) as exc:
         logger.warning("desktop stage-and-swap failed, live app kept: %s", exc)
+        _relaunch_stopped_desktops(desktop_dir, relaunch)  # whatever is live now, the user had it open
         return None
     finally:
         shutil.rmtree(staging_dir, ignore_errors=True)
+    _relaunch_stopped_desktops(desktop_dir, relaunch)
     return live_root / staged_exe.relative_to(staged_root)
 
 
+def _desktop_main_launches(desktop_dir: Path) -> dict[int, list[str]]:
+    """``{pid: argv[1:]}`` of desktop MAIN processes running from this build's ``release`` tree.
+
+    Electron helpers (renderer/GPU/utility/zygote) run the same exe but carry ``--type=``; only the
+    main process is worth reopening. POSIX only; never raises."""
+    if sys.platform == "win32":
+        return {}
+    try:
+        import psutil
+        release_dir = (desktop_dir / "release").resolve()
+        procs = list(psutil.process_iter(["pid", "exe", "cmdline"]))
+    except Exception:
+        return {}
+    launches: dict[int, list[str]] = {}
+    for proc in procs:
+        try:
+            info = proc.info
+            exe, cmdline = info.get("exe"), info.get("cmdline") or []
+            if not exe or release_dir not in Path(exe).resolve().parents:
+                continue
+            if any(str(arg).startswith("--type=") for arg in cmdline[1:]):
+                continue
+            launches[int(info["pid"])] = [str(arg) for arg in cmdline[1:]]
+        except Exception:
+            continue
+    return launches
+
+
+def _desktop_relaunch_after_rebuild_enabled() -> bool:
+    try:
+        from hermes_cli.config import load_config
+        desktop = (load_config() or {}).get("desktop") or {}
+        return bool(isinstance(desktop, dict) and desktop.get("relaunch_after_rebuild"))
+    except Exception:
+        return False
+
+
+def _relaunch_stopped_desktops(desktop_dir: Path, launches: list[list[str]]) -> list[list[str]]:
+    """Reopen desktop apps the swap stopped (``desktop.relaunch_after_rebuild``). A headless update has
+    no other party that will: the in-app Update hand-off already quit the app before we got here, so
+    nothing is ever stopped (and reopened) twice. Detached; never raises. Returns the argv tails opened."""
+    if not launches or sys.platform == "win32" or not _desktop_relaunch_after_rebuild_enabled():
+        return []
+    exe = _desktop_packaged_executable(desktop_dir)
+    if exe is None:
+        logger.warning("desktop app was stopped for the rebuild but no launchable app is left to reopen")
+        return []
+    opened: list[list[str]] = []
+    seen: set[tuple[str, ...]] = set()
+    for args in launches:
+        if tuple(args) in seen:  # the single-instance lock would only focus a duplicate
+            continue
+        seen.add(tuple(args))
+        if sys.platform == "darwin":
+            bundle = exe.parents[2]  # Hermes.app/Contents/MacOS/Hermes
+            cmd = ["/usr/bin/open", str(bundle)] + (["--args", *args] if args else [])
+        else:
+            cmd = [str(exe), *args]
+        try:
+            subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+                             stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
+        except OSError as exc:
+            logger.warning("could not reopen the desktop app after the rebuild: %s", exc)
+            continue
+        logger.info("reopened the desktop app stopped for the rebuild: %s", cmd)
+        print(f"  ✓ Reopened the desktop app that was stopped for the rebuild ({bundle if sys.platform == 'darwin' else exe})")
+        opened.append(args)
+    return opened
+
+
 def _discard_desktop_staging(staging_dir: Path) -> None:
     shutil.rmtree(staging_dir, ignore_errors=True)
 
diff --git a/tests/hermes_cli/test_desktop_swap_relaunch.py b/tests/hermes_cli/test_desktop_swap_relaunch.py
new file mode 100644
index 0000000000..f7b4f022cb
--- /dev/null
+++ b/tests/hermes_cli/test_desktop_swap_relaunch.py
@@ -0,0 +1,131 @@
+"""A desktop app stopped for the stage-and-swap promotion is reopened (desktop.relaunch_after_rebuild).
+
+A headless `hermes update` (CLI, launchd, hermes-sync) stops the running Hermes.app so its renderer
+cannot fetch stale chunks after the swap, and nothing used to reopen it: the app simply vanished.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import types
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import main_desktop
+
+pytestmark = pytest.mark.skipif(sys.platform == "win32", reason="POSIX relaunch only")
+
+
+def _packaged_exe_rel() -> Path:
+    if sys.platform == "darwin":
+        return Path("mac-arm64") / "Hermes.app" / "Contents" / "MacOS" / "Hermes"
+    return Path("linux-unpacked") / "hermes"
+
+
+@pytest.fixture
+def swap(tmp_path, monkeypatch):
+    desktop_dir = tmp_path / "apps" / "desktop"
+    live_exe = desktop_dir / "release" / _packaged_exe_rel()
+    live_exe.parent.mkdir(parents=True)
+    live_exe.write_text("old", encoding="utf-8")
+    staging = main_desktop._desktop_staging_dir(desktop_dir)
+    staged_exe = staging / _packaged_exe_rel()
+    staged_exe.parent.mkdir(parents=True)
+    staged_exe.write_text("new", encoding="utf-8")
+
+    state = {"enabled": True, "stopped": [101, 102], "launches": {101: [], 102: []}, "popen": []}
+    monkeypatch.setattr(main_desktop, "_desktop_main_launches", lambda d: dict(state["launches"]))
+    monkeypatch.setattr(main_desktop, "_stop_desktop_processes_locking_build",
+                        lambda d, **kw: list(state["stopped"]))
+    monkeypatch.setattr(main_desktop, "_desktop_relaunch_after_rebuild_enabled", lambda: state["enabled"])
+    monkeypatch.setattr(main_desktop.subprocess, "Popen", lambda cmd, **kw: state["popen"].append((cmd, kw)))
+    return desktop_dir, staging, live_exe, state
+
+
+def _expected_cmd(live_exe: Path) -> list[str]:
+    if sys.platform == "darwin":
+        return ["/usr/bin/open", str(live_exe.parents[2])]
+    return [str(live_exe)]
+
+
+def test_stopped_desktop_is_reopened_from_the_new_bundle(swap):
+    desktop_dir, staging, live_exe, state = swap
+    state["launches"] = {101: []}  # 102 was a helper: not a main process
+
+    assert main_desktop._swap_staged_desktop_app(desktop_dir, staging) == live_exe
+
+    assert live_exe.read_text(encoding="utf-8") == "new"
+    assert [cmd for cmd, _ in state["popen"]] == [_expected_cmd(live_exe)]
+    assert state["popen"][0][1]["start_new_session"] is True
+
+
+def test_launch_args_are_preserved(swap):
+    desktop_dir, staging, live_exe, state = swap
+    state["launches"] = {101: ["--hermes-flag"]}
+
+    main_desktop._swap_staged_desktop_app(desktop_dir, staging)
+
+    cmd = state["popen"][0][0]
+    assert cmd[-1] == "--hermes-flag"
+    if sys.platform == "darwin":
+        assert cmd[-2] == "--args"
+
+
+def test_setting_off_keeps_upstream_behaviour(swap):
+    desktop_dir, staging, live_exe, state = swap
+    state["enabled"] = False
+
+    assert main_desktop._swap_staged_desktop_app(desktop_dir, staging) == live_exe
+    assert state["popen"] == []
+
+
+def test_desktop_not_stopped_is_not_reopened(swap):
+    """An ancestor Desktop (in-app update) is spared by the stop, so it is not in `stopped`."""
+    desktop_dir, staging, live_exe, state = swap
+    state["launches"] = {101: []}
+    state["stopped"] = []
+
+    main_desktop._swap_staged_desktop_app(desktop_dir, staging)
+    assert state["popen"] == []
+
+
+def test_failed_swap_still_reopens_the_kept_app(swap, monkeypatch):
+    desktop_dir, staging, live_exe, state = swap
+    state["launches"] = {101: []}
+    real_rename = os.rename
+
+    def fail_promotion(src, dst):
+        if Path(src) == staging / _packaged_exe_rel().parts[0]:
+            raise OSError(18, "cross-device link")
+        return real_rename(src, dst)
+
+    monkeypatch.setattr(main_desktop.os, "rename", fail_promotion)
+    assert main_desktop._swap_staged_desktop_app(desktop_dir, staging) is None
+
+    assert live_exe.read_text(encoding="utf-8") == "old"
+    assert [cmd for cmd, _ in state["popen"]] == [_expected_cmd(live_exe)]
+
+
+def test_main_launches_skip_electron_helpers(tmp_path, monkeypatch):
+    desktop_dir = tmp_path / "apps" / "desktop"
+    exe = desktop_dir / "release" / _packaged_exe_rel()
+    exe.parent.mkdir(parents=True)
+    exe.write_text("x", encoding="utf-8")
+    other = tmp_path / "elsewhere" / "Hermes"
+    other.parent.mkdir(parents=True)
+    other.write_text("x", encoding="utf-8")
+
+    def proc(pid, exe_path, cmdline):
+        return types.SimpleNamespace(info={"pid": pid, "exe": str(exe_path), "cmdline": cmdline})
+
+    fake_psutil = types.SimpleNamespace(process_iter=lambda attrs: [
+        proc(1, exe, [str(exe)]),
+        proc(2, exe, [str(exe), "--type=renderer"]),
+        proc(3, other, [str(other)]),
+        proc(4, exe, [str(exe), "--some-flag"]),
+    ])
+    monkeypatch.setitem(sys.modules, "psutil", fake_psutil)
+
+    assert main_desktop._desktop_main_launches(desktop_dir) == {1: [], 4: ["--some-flag"]}
-- 
