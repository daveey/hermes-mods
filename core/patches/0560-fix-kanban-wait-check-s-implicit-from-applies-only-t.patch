From 2a1e556192dc3cb0b84752f88e64ada67ef83fb9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:55:53 +0000
Subject: [PATCH] fix(kanban): wait-check's implicit --from applies only to
 dispatcher probe runs (HERMES_KANBAN_WAKE_PROBE) [daveey]

A worker running `hermes kanban wait-check task <owner>` by hand (HERMES_KANBAN_TASK is set for every worker) sees
the plain status, not "unchanged since park".
---
 hermes_cli/kanban_wait_check.py           | 5 +++--
 hermes_cli/kanban_wake_check.py           | 1 +
 tests/hermes_cli/test_kanban_wait_info.py | 5 ++++-
 3 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_wait_check.py b/hermes_cli/kanban_wait_check.py
index 78f239fbb3..ea8029c3a8 100644
--- a/hermes_cli/kanban_wait_check.py
+++ b/hermes_cli/kanban_wait_check.py
@@ -145,8 +145,9 @@ def handled_status(waiter: Optional[str], db_path: Optional[str], target: str) -
 def run(args) -> int:
     until = tuple(u for u in (args.until or "").split(",") if u) or DEFAULT_UNTIL
     since = tuple(u for u in (getattr(args, "since", None) or "").split(",") if u)
-    if not since and args.check == "task":
-        # Implicit --from: the status the waiter already handled (see handled_status).
+    if not since and args.check == "task" and os.environ.get("HERMES_KANBAN_WAKE_PROBE") == "1":
+        # Implicit --from, for dispatcher probe runs only (a worker running wait-check by hand sees the plain
+        # status): the status the waiter already handled (see handled_status).
         seen = handled_status(os.environ.get("HERMES_KANBAN_TASK"), os.environ.get("HERMES_KANBAN_DB"), args.target)
         since = (seen,) if seen else ()
     gw = getattr(args, "gateway", None)
diff --git a/hermes_cli/kanban_wake_check.py b/hermes_cli/kanban_wake_check.py
index ccdaa1d702..6692676834 100644
--- a/hermes_cli/kanban_wake_check.py
+++ b/hermes_cli/kanban_wake_check.py
@@ -327,6 +327,7 @@ def _probe_env(task, db_path: str) -> dict:
         env.pop(key, None)
     env["HERMES_KANBAN_TASK"] = task.id
     env["HERMES_KANBAN_DB"] = db_path
+    env["HERMES_KANBAN_WAKE_PROBE"] = "1"  # wait-check's implicit --from applies only to probe runs [daveey]
     return env
 
 
diff --git a/tests/hermes_cli/test_kanban_wait_info.py b/tests/hermes_cli/test_kanban_wait_info.py
index ce945cd714..37f1f700b3 100644
--- a/tests/hermes_cli/test_kanban_wait_info.py
+++ b/tests/hermes_cli/test_kanban_wait_info.py
@@ -24,6 +24,7 @@ H = 3600
 def _not_a_probe_run(monkeypatch):
     # wait-check reads the waiter from HERMES_KANBAN_TASK (set for dispatcher probes and kanban workers).
     monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    monkeypatch.delenv("HERMES_KANBAN_WAKE_PROBE", raising=False)
 
 
 def d(status, **kw) -> dict:
@@ -399,7 +400,9 @@ def test_tracker_does_not_rewake_for_a_status_it_already_handled(tmp_path, monke
     monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
     assert kwc.run(ns) == 0  # not a probe run: plain default
     monkeypatch.setenv("HERMES_KANBAN_TASK", "t_tracker")
-    assert kwc.run(ns) == 1  # same status the tracker already handled
+    assert kwc.run(ns) == 0  # a worker running wait-check by hand: plain status
+    monkeypatch.setenv("HERMES_KANBAN_WAKE_PROBE", "1")
+    assert kwc.run(ns) == 1  # the dispatcher's probe run: same status the tracker already handled
     with sqlite3.connect(db) as c:
         c.execute("UPDATE tasks SET status='triage' WHERE id='t_owner'")
     assert kwc.run(ns) == 0  # a new status wakes it
-- 
