@@ -536,6 +584,10 @@ class HostLoopLease:
                 return
             self._waiting = False
             self._stop_want_refresher()
+            if _RETIRED:  # retired while the hand-off waited: the lock goes straight back
+                self._clear_own_want()
+                fcntl.flock(fd, fcntl.LOCK_UN)
+                return
             self._become_holder()
