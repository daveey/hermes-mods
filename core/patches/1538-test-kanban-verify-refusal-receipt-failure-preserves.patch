From 8688b266362e644ee8d257fe186f529af4fac2f2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 19:02:30 +0000
Subject: [PATCH] test(kanban): verify refusal receipt failure preserves exit
 [daveey]

---
 hermes_cli/kanban_worker_client.py          |  4 ++--
 tests/hermes_cli/test_kanban_owner_death.py | 22 +++++++++++++++++++++
 2 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_worker_client.py b/hermes_cli/kanban_worker_client.py
index 8ac840ce0e0..35519b0da2c 100644
--- a/hermes_cli/kanban_worker_client.py
+++ b/hermes_cli/kanban_worker_client.py
@@ -272,8 +272,8 @@ def _book_refusal(params, board_db, rc, line):
         from hermes_cli.kanban_worker_log import record_submitter_result
         with connect_closing(Path(board_db)) as conn, kb.write_txn(conn):
             record_submitter_result(conn, params, os.getpid(), rc, line)
-    except Exception:  # health: allow BLE001 -- the receipt is best effort; the log line and exit trailer stand
-        pass
+    except Exception as exc:  # health: allow BLE001 -- preserve the original refusal exit on receipt-store failure
+        print(f'Kanban refusal receipt could not be recorded: {type(exc).__name__}', file=sys.stderr)
 
 
 def _submit():
diff --git a/tests/hermes_cli/test_kanban_owner_death.py b/tests/hermes_cli/test_kanban_owner_death.py
index c530aacb9f0..6a7ca723895 100644
--- a/tests/hermes_cli/test_kanban_owner_death.py
+++ b/tests/hermes_cli/test_kanban_owner_death.py
@@ -275,6 +275,28 @@ def test_the_refused_submitter_books_its_own_run_qualified_receipt(board, monkey
             "pid": me, "claim_lock": task.claim_lock, "exit_code": 1, "last_output": REFUSAL, "submitter": True})]
 
 
+def test_refusal_receipt_store_failure_preserves_exit_without_leaking_details(board, monkeypatch, capsys):
+    from hermes_cli import kanban_worker_log
+    from hermes_cli.quiet_single_query import KANBAN_WORKER_EXIT_TRAILER
+    with kbc.connect() as conn:
+        tid = _claim(conn, kb.create_task(conn, title="card", assignee="default"), os.getpid(), board, refused=False)
+        _submitter_env(monkeypatch, tid, conn)
+    client = _refused_by_dead_owner(monkeypatch)
+
+    def fail_store(*args):
+        raise PermissionError("private database details")
+
+    monkeypatch.setattr(kanban_worker_log, "record_submitter_result", fail_store)
+    assert client.main() == 1
+    stderr = capsys.readouterr().err
+    assert REFUSAL in stderr
+    assert "Kanban refusal receipt could not be recorded: PermissionError" in stderr
+    assert "private database details" not in stderr
+    assert stderr.rstrip().endswith(f"{KANBAN_WORKER_EXIT_TRAILER}1")
+    with kbc.connect() as conn:
+        assert _results(conn, tid) == []
+
+
 def test_a_real_submitter_refusal_at_an_owner_death_requeues_uncounted_end_to_end(board, monkeypatch, capsys):
     """``main`` -> ``_submit`` -> the refusal receipt -> the dead-worker sweep -> ``owner_restart_lost``."""
     from hermes_cli.quiet_single_query import KANBAN_WORKER_EXIT_TRAILER
-- 
