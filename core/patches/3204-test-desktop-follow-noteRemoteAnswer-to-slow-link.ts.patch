From 34d8a9120ac42d456c6b3185a0f0a4fbc4edd6ad Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 22:49:44 -0800
Subject: [PATCH] test(desktop): follow noteRemoteAnswer to slow-link.ts in the
 warm-dispatch pin; execute it [daveey]

CI on 70e8bc6afa failed electron/remote-warm-dispatch.test.ts: it pinned `function noteRemoteAnswer` in main.ts by
source text, and the previous commit moved that helper to slow-link.ts to keep main.ts under its line cap. The pin
now checks that fetchJsonForBackend still calls it on both answer paths and that it still feeds the shared answer
ledger first, in its new file. slow-link.test.ts also runs it: the ledger is fed and the first-request
`[remote-timing]` line is logged once.

I had run only the six suites I touched before pushing; every desktop test file that mentions main.ts (52 files)
now passes locally.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 .../electron/remote-warm-dispatch.test.ts     |  7 +++++-
 apps/desktop/electron/slow-link.test.ts       | 24 ++++++++++++++++++-
 2 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/electron/remote-warm-dispatch.test.ts b/apps/desktop/electron/remote-warm-dispatch.test.ts
index 4e690e1e52..e6009034f5 100644
--- a/apps/desktop/electron/remote-warm-dispatch.test.ts
+++ b/apps/desktop/electron/remote-warm-dispatch.test.ts
@@ -280,6 +280,11 @@ describe('main.ts wiring', () => {
 
   it('pooled dispatch skips the probe from the shared answer ledger unless forced', () => {
     expect(main).toMatch(/answers: remoteAnswerLedger,\n\s+skipWindowMs: opts\.forceProbe \? 0 : DISPATCH_PROBE_SKIP_WINDOW_MS/)
-    expect(main).toMatch(/function noteRemoteAnswer\(baseUrl: string, path: string\) \{\n\s+remoteAnswerLedger\.recordAnswer\(baseUrl\)/)
+    // noteRemoteAnswer moved to slow-link.ts (main.ts is over its line cap); fetchJsonForBackend still calls it on
+    // every answer, and it still feeds the shared ledger first.
+    expect(main.match(/noteRemoteAnswer\(descriptor\.baseUrl, path, Date\.now\(\) - startedAt, rememberLog\)/g)).toHaveLength(2)
+    expect(readFileSync(join(__dirname, 'slow-link.ts'), 'utf8')).toMatch(
+      /export function noteRemoteAnswer\(.*\): void \{\n\s+remoteAnswerLedger\.recordAnswer\(baseUrl\)/
+    )
   })
 })
diff --git a/apps/desktop/electron/slow-link.test.ts b/apps/desktop/electron/slow-link.test.ts
index 08c7f6e2da..e30153afef 100644
--- a/apps/desktop/electron/slow-link.test.ts
+++ b/apps/desktop/electron/slow-link.test.ts
@@ -8,11 +8,14 @@ import { isRemoteTimeout } from './remote-down-gate'
 import {
   ensureHealthyPooledRemoteBackendForDispatch,
   POOLED_REMOTE_DISPATCH_PROBE_TIMEOUT_MS,
-  RemoteAnswerLedger
+  RemoteAnswerLedger,
+  remoteAnswerLedger
 } from './remote-liveness'
 import {
   dispatchSlowLink,
   isThinnedPollPath,
+  noteRemoteAnswer,
+  noteRemoteConnect,
   SLOW_LINK_BACKGROUND_GAP_MS,
   SLOW_LINK_EXIT_SAMPLES,
   SLOW_LINK_FAST_MS,
@@ -384,6 +387,25 @@ describe('main.ts wiring helpers', () => {
   })
 })
 
+describe('noteRemoteAnswer', () => {
+  it('feeds the shared answer ledger and logs the first request a new descriptor serves, once', () => {
+    const url = 'http://127.0.0.1:50999'
+    const lines: string[] = []
+    const log = (line: string) => lines.push(line)
+
+    remoteAnswerLedger.forget(url)
+    noteRemoteConnect(url, 'conn:hermes-hub::default', Date.now() - 250)
+    noteRemoteAnswer(url, '/api/status', 40, log)
+    noteRemoteAnswer(url, '/api/profiles', 40, log)
+
+    expect(remoteAnswerLedger.answeredWithin(url, 30_000)).toBe(true)
+    expect(lines).toHaveLength(1)
+    expect(lines[0]).toMatch(/^\[remote-timing\] conn:hermes-hub::default first-request \/api\/status served \+\d+ ms$/)
+
+    remoteAnswerLedger.forget(url)
+  })
+})
+
 describe('main.ts wiring', () => {
   const main = readFileSync(join(__dirname, 'main.ts'), 'utf8')
 
