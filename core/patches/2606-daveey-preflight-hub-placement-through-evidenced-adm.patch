@@ -673,7 +701,7 @@ def canonical_pin(pin, self_gw: Optional[str] = None, cfg: Optional[dict] = None
             hit = {str(k).strip().lower(): str(v).strip().lower() for k, v in aliases.items()}.get(p)
             if hit:
                 return hit
