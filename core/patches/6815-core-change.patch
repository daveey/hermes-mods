diff --git a/hermes_cli/kanban_origin_forward_wait.py b/hermes_cli/kanban_origin_forward_wait.py
index 7ef4c705045fb21e8cae60e1d11b330e13c6de88..cd045a6e582403114c8e8f4292edf239ee251702 100644
--- a/hermes_cli/kanban_origin_forward_wait.py
+++ b/hermes_cli/kanban_origin_forward_wait.py
@@ -14,30 +14,57 @@
 
 from contextlib import closing
 import json
+import re
 import shlex
 import sqlite3
+import string
 from typing import Optional
 
 CODE = "origin_forward_rejected_wait"
 _REFUSED = "origin_forward_binding_missing"
 
 
+_REDIRECT = re.compile(r"^[<>&]*[<>][<>&]*$")  # changes no exit status: ``> f``, ``2>&1``, ``&> f``
+_SEQUENCE = {";", ";;", "\n"}  # the probe fires on the exit status of its last command
+_WORD_CHARS = "".join(c for c in string.printable if not c.isspace() and c not in "();<>|&'\"\\")
+
+
+def _words(wake_check: str) -> list[str]:
+    """Shell words of ``wake_check`` with every operator its own word, however it is spaced."""
+    lexer = shlex.shlex(wake_check, posix=True, punctuation_chars=True)
+    lexer.whitespace = " \t\r"  # a newline separates commands: keep it as a word
+    lexer.wordchars = _WORD_CHARS  # keys like ``bb-land:817:ab`` stay one word
+    lexer.commenters = ""
+    return list(lexer)
+
+
 def wait_keys(wake_check: Optional[str]) -> list[str]:
-    """Every product key a ``hermes kanban wait-check key <KEY> ...`` probe waits on, in order.
+    """Every product key the probe's exit status depends on, from ``hermes kanban wait-check key <KEY>``.
 
-    A probe that offers an alternative (``||``, ``;``, ``|``) can fire without the lost key, so
-    it is "cannot tell" and yields no keys; only a conjunction (or a lone probe) is judged.
+    ``a && b`` fires only when both do, so every key of the final command sequence is judged
+    (``;`` and newline: only the last command decides).  Anything that lets the probe fire without
+    one of its keys (``||``, ``|``, ``&``, subshells) is "cannot tell" and yields no keys.
+    Operators are recognised with or without surrounding spaces.
     """
     try:
-        words = shlex.split(wake_check or "")
+        words = _words(wake_check or "")
     except ValueError:
         return []
-    if any(w in ("||", ";", "|", "&") for w in words):
-        return []
+    commands: list[list[str]] = [[]]
+    for word in words:
+        if word in _SEQUENCE:
+            commands.append([])
+        elif word == "&&" or _REDIRECT.match(word):
+            commands[-1].append(word)
+        elif word and set(word) <= set("();<>|&"):
+            return []  # ``||``, ``|``, ``&``, ``(``, ``)``: the probe can fire without the key
+        else:
+            commands[-1].append(word)
+    last = next((c for c in reversed(commands) if c), [])  # a trailing ``;`` or blank line decides nothing
     keys = []
-    for i in range(len(words) - 4):
-        if words[i:i + 3] == ["hermes", "kanban", "wait-check"] and words[i + 3] == "key":
-            key = words[i + 4]
+    for i in range(len(last) - 4):
+        if last[i:i + 3] == ["hermes", "kanban", "wait-check"] and last[i + 3] == "key":
+            key = last[i + 4]
             if key and not key.startswith("-"):
                 keys.append(key)
     return keys
diff --git a/tests/hermes_cli/test_origin_forward_rejected_wait.py b/tests/hermes_cli/test_origin_forward_rejected_wait.py
index 08eda2e8a72933c1d9bf2ab08439539c949943db..e7271708b56e677165a42caa3ed5e3c7a051503a 100644
--- a/tests/hermes_cli/test_origin_forward_rejected_wait.py
+++ b/tests/hermes_cli/test_origin_forward_rejected_wait.py
@@ -14,6 +14,7 @@
 
 from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
 from hermes_cli import kanban_continuation as continuation
+from hermes_cli.kanban_origin_forward_wait import wait_keys
 from tests.hermes_cli.test_origin_forward_run_end import pending as pending  # noqa: PLC0414 -- pytest fixture reexport
 from tests.hermes_cli.test_kanban_continuation import home as home  # noqa: PLC0414 -- pytest fixture reexport
 
@@ -211,14 +212,73 @@
         assert_still_running(conn, task, run)
 
 
-@pytest.mark.parametrize('joiner', ['||', ';', '|'])
-def test_a_probe_with_an_alternative_can_fire_without_the_lost_key_so_it_still_parks(refused, joiner):
+SPACING = [('{a} {op} {b}'), ('{a}{op} {b}'), ('{a} {op}{b}'), ('{a}{op}{b}')]
+
+
+@pytest.mark.parametrize('order', ['lost-first', 'lost-last'])
+@pytest.mark.parametrize('spacing', SPACING, ids=['both', 'left', 'right', 'none'])
+@pytest.mark.parametrize('joiner', ['||', '|', '&'])
+def test_a_probe_with_an_alternative_can_fire_without_the_lost_key_so_it_still_parks(refused, joiner, spacing, order):
+    """``||``, ``|`` and ``&`` can fire without the lost key, whichever side it is on and however spaced."""
     task, run, _ = refused
+    first, second = (KEY, OTHER_KEY) if order == 'lost-first' else (OTHER_KEY, KEY)
+    probe = spacing.format(a=wake(first), op=joiner, b=wake(second))
+    assert wait_keys(probe) == [], probe
     with kbc.connect_closing() as conn:
-        assert refusal('schedule', conn, task, run, wake_check=f'{wake(OTHER_KEY)} {joiner} {wake()}') is None
+        assert refusal('schedule', conn, task, run, wake_check=probe) is None, probe
         assert kb.get_task(conn, task).status == 'scheduled'
 
 
+@pytest.mark.parametrize('spacing', SPACING, ids=['both', 'left', 'right', 'none'])
+def test_a_conjunction_is_judged_on_every_key_however_it_is_spaced(spacing):
+    probe = spacing.format(a=wake(OTHER_KEY), op='&&', b=wake())
+    assert wait_keys(probe) == [OTHER_KEY, KEY], probe
+    assert wait_keys(spacing.format(a=wake(), op='&&', b=wake(OTHER_KEY))) == [KEY, OTHER_KEY]
+
+
+@pytest.mark.parametrize('probe, keys', [
+    (f'{wake(OTHER_KEY)}; {wake()}', [KEY]),                      # the exit status is the last command's
+    (f'{wake(OTHER_KEY)};{wake()}', [KEY]),
+    (f'{wake(OTHER_KEY)}\n{wake()}', [KEY]),
+    (f'{wake()}; {wake(OTHER_KEY)}', [OTHER_KEY]),
+    (f'{wake()};{wake(OTHER_KEY)}', [OTHER_KEY]),
+    (f'{wake()}\n{wake(OTHER_KEY)}', [OTHER_KEY]),
+    (f'{wake()}; true', []),
+    (f'{wake()};', [KEY]),                                        # a trailing separator decides nothing
+    (f'{wake()}\n', [KEY]),
+    (f'{wake()} && {wake(OTHER_KEY)}; {wake(OTHER_KEY)} && {wake()}', [OTHER_KEY, KEY]),
+    (f'{wake()} > /dev/null 2>&1', [KEY]),                        # redirects change no exit status
+    (f'{wake()} &> /dev/null', [KEY]),
+    (f'{wake()}||true', []),
+    (f'({wake()})', []),
+    (f"{wake()} || true", []),
+    (f'{wake()} && true', [KEY]),
+])
+def test_wait_keys_reads_the_keys_the_exit_status_depends_on(probe, keys):
+    assert wait_keys(probe) == keys, probe
+
+
+def test_a_quoted_operator_in_a_key_is_one_word():
+    assert wait_keys("hermes kanban wait-check key 'a;b' --gateway hub") == ['a;b']
+    assert wait_keys('hermes kanban wait-check key a#b --gateway hub') == ['a#b']
+
+
+@pytest.mark.parametrize('joiner', ['; ', '\n', ';'])
+def test_the_lost_key_before_a_separator_does_not_refuse_but_after_it_does(refused, joiner):
+    task, run, _ = refused
+    with kbc.connect_closing() as conn:
+        assert refusal('schedule', conn, task, run, wake_check=f'{wake()}{joiner}{wake(OTHER_KEY)}') is None
+        assert kb.get_task(conn, task).status == 'scheduled'
+
+
+@pytest.mark.parametrize('joiner', ['; ', '\n', ';', ' &&', '&& ', '&&'])
+def test_the_lost_key_after_a_separator_or_conjunction_refuses(refused, joiner):
+    task, run, _ = refused
+    with kbc.connect_closing() as conn:
+        why = refusal('schedule', conn, task, run, wake_check=f'{wake(OTHER_KEY)}{joiner}{wake()}')
+        assert 'origin_forward_rejected_wait' in (why or ''), why
+
+
 def test_another_creators_completed_request_for_the_key_lifts_the_refusal(refused):
     """The key may exist (another creator made it): never claim ``wait-check key`` can not see it."""
     task, run, path = refused
