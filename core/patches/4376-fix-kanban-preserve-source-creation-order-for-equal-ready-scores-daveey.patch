     q = api.get(f"/api/plugins/kanban/tasks/{new}").json()["queue"]
     assert isinstance(q.pop("observed_at"), int)
     assert q == {"lane": "local", "ahead": 2, "running": 3, "limit": 6, "approximate": True, "board": "default"}
