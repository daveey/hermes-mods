diff --git a/tests/hermes_cli/test_kanban_outside_park_board_claim.py b/tests/hermes_cli/test_kanban_outside_park_board_claim.py
new file mode 100644
index 0000000000..d16fcdacfe
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_outside_park_board_claim.py
@@ -0,0 +1,58 @@
+"""The incident shape on the Board: the creator parks a card another machine claimed before its lease mirror
+arrived (t_01a1d01a0a065d6b). [daveey]
+
+On 2026-11-12 the MacBook's copy of t_01a1d017f26dc827 already had worker-2's open run and the Board's ``claimed``
+event (holder worker-2) but no mirrored lease, so ``remote_live_lease`` did not fire. The park closed that run;
+the close synced to worker-2, its worker exited without a terminal call and was booked a protocol violation.
+Now the Board claim event alone is enough to refuse.
+"""
+from __future__ import annotations
+
+import json
+
+from hermes_cli import kanban_db as kb
+from tests.hermes_cli.test_kanban_remote_archive import _running_on_worker, _tool
+from tests.hermes_cli.test_kanban_worker_node import WORKER
+
+pytest_plugins = ["tests.hermes_cli.test_kanban_remote_archive"]  # gws, svc, kills
+
+
+def _drop_lease_mirror(conn, tid):
+    """The feed applied the run and the claim event; the lease mirror has not arrived."""
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET lease_holder = NULL, lease_expires = NULL WHERE id = ?", (tid,))
+
+
+def test_creator_park_before_the_lease_mirror_arrives_is_refused_naming_the_claimer(gws, svc, kills):
+    hub, worker = gws
+    tid = _running_on_worker(hub, worker, svc)
+    hub.enter()
+    _drop_lease_mirror(hub.conn, tid)
+    run_id = kb._current_run_id(hub.conn, tid)
+    claim = hub.conn.execute("SELECT payload FROM task_events WHERE task_id = ? AND run_id = ? AND kind = 'claimed' "
+                             "AND json_extract(payload, '$.holder') IS NOT NULL", (tid, run_id)).fetchone()
+    assert claim is not None and json.loads(claim[0])["holder"] == WORKER  # the fixture carries the incident's event
+    out = _tool("_handle_schedule", {"task_id": tid, "reason": "SCHEDULED_UNTIL=2099-01-01T00:00:00Z soak",
+                                     "clock_only": True})
+    assert out.get("code") == "live_claim_park" and out.get("holder") == WORKER, out
+    assert out.get("claim_via") == "board_claim", out
+    assert kb.get_task(hub.conn, tid).status == "running"
+    assert hub.conn.execute("SELECT ended_at FROM task_runs WHERE id = ?", (run_id,)).fetchone()[0] is None
+    hub.round()
+    worker.round()
+    worker.enter()
+    wrun = kb._current_run_id(worker.conn, tid)
+    assert worker.conn.execute("SELECT ended_at FROM task_runs WHERE id = ?", (wrun,)).fetchone()[0] is None
+
+
+def test_an_expired_board_claim_does_not_hold_off_an_outside_park(gws, svc, kills):
+    hub, worker = gws
+    tid = _running_on_worker(hub, worker, svc)
+    hub.enter()
+    _drop_lease_mirror(hub.conn, tid)
+    from tools.kanban_tools_live_park import live_claim
+    payload = json.loads(hub.conn.execute(
+        "SELECT payload FROM task_events WHERE task_id = ? AND kind = 'claimed' "
+        "AND json_extract(payload, '$.holder') IS NOT NULL ORDER BY id DESC LIMIT 1", (tid,)).fetchone()[0])
+    assert live_claim(hub.conn, tid, now=payload["expires"] / 1000 + 1) is None
+    assert live_claim(hub.conn, tid)["holder"] == WORKER
diff --git a/tests/tools/test_kanban_outside_park_live_claim.py b/tests/tools/test_kanban_outside_park_live_claim.py
new file mode 100644
index 0000000000..b45f162c44
--- /dev/null
+++ b/tests/tools/test_kanban_outside_park_live_claim.py
@@ -0,0 +1,110 @@
+"""An outside kanban_schedule/kanban_block on a card a live worker owns is refused (t_01a1d01a0a065d6b). [daveey]
+
+Incident 2026-11-12 (card t_01a1d017f26dc827): an orchestrating chat parked a card worker-2 had claimed seconds
+earlier. The park closed the worker's open run underneath it; the worker exited rc=0 with no terminal kanban call
+and the dispatcher booked a protocol violation. Now the outside park is refused with ``code=live_claim_park``
+naming the claimer, and the worker's run stays open, so it can still park its own card.
+"""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    h = tmp_path / ".hermes"
+    h.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(h))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    for var in ("HERMES_KANBAN_TASK", "HERMES_KANBAN_RUN_ID", "HERMES_KANBAN_CLAIM_LOCK", "HERMES_KANBAN_BOARD",
+                "HERMES_KANBAN_DB", "HERMES_SESSION_ID"):
+        monkeypatch.delenv(var, raising=False)
+    from hermes_cli import kanban_db as kb
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    return h
+
+
+def _conn():
+    from hermes_cli import kanban_db_connect as kbc
+    return kbc.connect()
+
+
+def _claimed(live: bool = True) -> tuple[str, int]:
+    """A card the dispatcher claimed; with ``live`` this test process stands in for its spawned worker."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_dispatch as kbd
+    with _conn() as conn:
+        tid = kb.create_task(conn, title="verify after owner lands", assignee="default")
+        assert kb.claim_task(conn, tid, claimer=kb._claimer_id()) is not None
+        if live:
+            kbd._set_worker_pid(conn, tid, os.getpid())
+        return tid, kb._current_run_id(conn, tid)
+
+
+def _run(run_id: int):
+    with _conn() as conn:
+        return conn.execute("SELECT ended_at, outcome FROM task_runs WHERE id = ?", (run_id,)).fetchone()
+
+
+def _status(tid: str) -> str:
+    from hermes_cli import kanban_db as kb
+    with _conn() as conn:
+        return kb.get_task(conn, tid).status
+
+
+def _tool(name: str, args: dict) -> dict:
+    from tools import kanban_tools as kt
+    return json.loads(getattr(kt, name)(args))
+
+
+def test_outside_schedule_of_a_live_claimed_card_is_refused_and_the_run_stays_open(home):
+    tid, run_id = _claimed()
+    out = _tool("_handle_schedule", {"task_id": tid, "reason": "SCHEDULED_UNTIL=2099-01-01T00:00:00Z soak",
+                                     "clock_only": True})
+    assert out.get("code") == "live_claim_park", out
+    assert out.get("rejection") == "live_claim" and out.get("run_id") == run_id, out
+    assert out.get("holder") and out["holder"] in out["error"], out
+    assert "kanban_comment" in out["error"] and "Nothing changed" in out["error"], out
+    assert _status(tid) == "running"
+    assert _run(run_id)["ended_at"] is None  # the worker's run was not ended underneath it
+
+
+def test_outside_block_of_a_live_claimed_card_is_refused(home):
+    tid, run_id = _claimed()
+    out = _tool("_handle_block", {"task_id": tid, "kind": "time", "reason": "SCHEDULED_UNTIL=2099-01-01T00:00:00Z",
+                                  "clock_only": True})
+    assert out.get("code") == "live_claim_park", out
+    assert _status(tid) == "running" and _run(run_id)["ended_at"] is None
+
+
+def test_the_worker_still_parks_its_own_live_card(home, monkeypatch):
+    tid, run_id = _claimed()
+    monkeypatch.setenv("HERMES_KANBAN_TASK", tid)
+    monkeypatch.setenv("HERMES_KANBAN_RUN_ID", str(run_id))
+    out = _tool("_handle_schedule", {"reason": "SCHEDULED_UNTIL=2099-01-01T00:00:00Z soak", "clock_only": True})
+    assert out.get("ok") is True and out["status"] == "scheduled", out
+    assert _run(run_id)["outcome"] == "scheduled"
+
+
+def test_an_unclaimed_ready_card_is_still_parked_from_outside(home):
+    from hermes_cli import kanban_db as kb
+    with _conn() as conn:
+        tid = kb.create_task(conn, title="not started", assignee="default")
+    assert _status(tid) == "ready"
+    out = _tool("_handle_schedule", {"task_id": tid, "reason": "SCHEDULED_UNTIL=2099-01-01T00:00:00Z soak",
+                                     "clock_only": True})
+    assert out.get("ok") is True and out["status"] == "scheduled", out
+
+
+def test_a_claim_whose_worker_is_gone_can_still_be_parked_from_outside(home):
+    """A claim with no live worker protects no run (the same rule ``complete_task`` applies)."""
+    tid, run_id = _claimed(live=False)
+    out = _tool("_handle_schedule", {"task_id": tid, "reason": "SCHEDULED_UNTIL=2099-01-01T00:00:00Z soak",
+                                     "clock_only": True})
+    assert out.get("ok") is True and out["status"] == "scheduled", out
+    assert _run(run_id)["outcome"] == "scheduled"
diff --git a/tools/kanban_tools_live_park.py b/tools/kanban_tools_live_park.py
new file mode 100644
index 0000000000..6ecec0d492
--- /dev/null
+++ b/tools/kanban_tools_live_park.py
@@ -0,0 +1,91 @@
+"""Refuse an outside park of a card a live worker owns (t_01a1d01a0a065d6b). [daveey]
+
+Incident 2026-11-12: an orchestrating chat called ``kanban_schedule(task_id=...)`` on a card worker-2 had claimed
+3 s earlier. ``schedule_task`` without ``expected_run_id`` closed the card's open run under the worker; the
+worker found its run ended, exited rc=0 without a terminal kanban call, and the dispatcher booked a protocol
+violation, re-queued the card and sent the chat a failure notice.
+
+Choice: refuse (option a), not queue the park for the worker (option b). The worker owns its run, and a refusal
+keeps that single-writer rule: nothing is ended under a live process, so its clean exit is never misread as a
+failure. The steer the refusal names already exists: a ``kanban_comment`` reaches a live worker as an
+out-of-band message at its next model call, and the worker parks its own card. A queued park would need a new
+pending-park store, a check in every worker tool call, and expiry rules for a worker that never calls a tool.
+
+A card counts as live-claimed when it is ``running`` and one of these holds:
+
+- this host's claim and its worker process is alive (``kanban_db._claim_is_live``);
+- another gateway holds an unexpired Board lease (``kanban_db_sync.foreign_live_lease``);
+- the Board's ``claimed`` event for the card's open current run names another gateway and has not expired, while
+  the lease mirror has not arrived yet. This was the incident: the creator's copy had the run and the claim
+  event but no mirrored lease, so the existing ``remote_live_lease`` refusal did not fire.
+
+Applies only to a caller that does not own the run (no ``HERMES_KANBAN_TASK``/``HERMES_KANBAN_RUN_ID`` for the
+card): a worker parking its own card is unaffected, and so is a ready, todo or blocked card.
+"""
+from __future__ import annotations
+
+import json
+import time
+from typing import Optional
+
+CODE = "live_claim_park"
+FENCED_TOOLS = frozenset({"kanban_schedule", "kanban_block"})
+
+
+def live_claim(conn, task_id: str, now: Optional[float] = None) -> Optional[dict]:
+    """``{holder, run_id, via[, pid]}`` when a live worker owns ``task_id``'s current run, else None."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_sync as sync
+    row = conn.execute("SELECT status, claim_lock, worker_pid, worker_started_at, current_run_id FROM tasks "
+                       "WHERE id = ?", (task_id,)).fetchone()
+    if row is None or row["status"] != "running":
+        return None
+    run_id = row["current_run_id"]
+    if kb._claim_is_live(row):
+        return {"holder": row["claim_lock"], "pid": row["worker_pid"], "run_id": run_id, "via": "local_worker"}
+    holder = sync.foreign_live_lease(conn, task_id, now)
+    if holder:
+        return {"holder": holder, "run_id": run_id, "via": "board_lease"}
+    if run_id is None or row["claim_lock"] is not None or sync.board_mode(conn) != "primary":
+        return None
+    run = conn.execute("SELECT ended_at FROM task_runs WHERE id = ? AND task_id = ?", (run_id, task_id)).fetchone()
+    if run is None or run["ended_at"] is not None:
+        return None
+    claim = conn.execute(
+        "SELECT payload FROM task_events WHERE task_id = ? AND run_id = ? AND kind = 'claimed' "
+        "AND json_valid(payload) AND json_extract(payload, '$.holder') IS NOT NULL ORDER BY id DESC LIMIT 1",
+        (task_id, run_id)).fetchone()
+    if claim is None:
+        return None
+    payload = json.loads(claim[0])
+    holder, expires = payload.get("holder"), payload.get("expires")
+    own = str(sync._state(conn)["gateway_id"])
+    now_ms = int((time.time() if now is None else now) * 1000)
+    if not holder or holder == own or not isinstance(expires, (int, float)) or int(expires) <= now_ms:
+        return None
+    return {"holder": str(holder), "run_id": run_id, "via": "board_claim"}
+
+
+def refusal(conn, tool_name: str, task_id: str) -> Optional[str]:
+    """A typed ``live_claim_park`` tool error when ``task_id`` holds a live claim, else None. Nothing changes."""
+    claim = live_claim(conn, task_id)
+    if claim is None:
+        return None
+    from tools.registry import tool_error
+    holder = claim["holder"]
+    return tool_error(
+        f"{tool_name} refused: {task_id} is running under a live worker claim ({holder}, run {claim['run_id']}). "
+        "Parking it from here would end that run underneath the worker, whose clean exit is then booked as a "
+        f"failure. Nothing changed. Steer the worker instead: kanban_comment(task_id='{task_id}', body='<what to "
+        "do, e.g. park with kanban_schedule(awaiting=...) and end the run>') reaches it at its next model call, "
+        "and it parks its own card. To stop the run outright use kanban_archive.",
+        code=CODE, rejection="live_claim", task_id=task_id, holder=holder, run_id=claim["run_id"],
+        claim_via=claim["via"], handoff_complete=False)
+
+
+def guard_refusal(board, args: dict, tool_name: str, task_id: str) -> Optional[str]:
+    """``refusal`` for an outside caller of a fenced tool (``_worker_guard``); None for anything else."""
+    if tool_name not in FENCED_TOOLS:
+        return None
+    with board(args.get("board")) as (_kb, conn):
+        return refusal(conn, tool_name, task_id)
