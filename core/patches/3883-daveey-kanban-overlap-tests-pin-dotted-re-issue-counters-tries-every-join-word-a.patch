From 44fced826ddb5b09fcf302b4acf4d783242dc2f1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:15:02 +0000
Subject: [PATCH] [daveey] kanban overlap tests: pin dotted re-issue counters,
 "tries", every join word and judging verb

Post-merge check of PR #2535 (t_01a1d666580d271c) found four mutants of the overlap guards that the
existing tests did not kill, each non-equivalent:

- O4 `_COUNT` -> r"\d+": "attempt 2.1"/"attempt 2.2" read as a leg (fail-open).
- O9 `_TRY_WORD` without "tries": "tries 2"/"tries 3" read as a leg.
- D2 `_JOIN` without since|so|but|due|hence|thus: "Not started since duplicate of t_X" denied.
- D4 `_JUDGED` cut to marked|considered|flagged|closed: "Not treated as a duplicate of t_X" counted.

Test-only. New cases:
- test_a_dotted_or_tries_reissue_counter_is_not_an_enumeration (3 cases)
- test_every_joining_word_stops_the_negator_reaching_the_keyword (one case per word after
  "because"; no comma, since a comma ends the clause and would pass regardless of the word)
- test_every_judging_verb_after_a_negator_denies_the_keyword (every _JUDGED verb x "Not ... as a" /
  "Never ... as")

Proof (scripts/run_tests.sh on the two files, worker-4):
- unmutated: 140 passed, 0 failed (90 before + 50 new)
- O4: 2 failed; O9: 1 failed; D2: 6 failed; D4: 32 failed
- each _JOIN word dropped alone (with, since, so, but, due, hence, thus): exactly 1 failed each

New cases are separate functions, so they do not touch the parametrize list PR #2577 extends.
---
 tests/hermes_cli/test_kanban_dup_detector.py  | 27 +++++++++++++++++++
 ...test_kanban_create_overlap_same_creator.py | 16 +++++++++++
 2 files changed, 43 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_dup_detector.py b/tests/hermes_cli/test_kanban_dup_detector.py
index e7f67ccb88..abc62453fa 100644
--- a/tests/hermes_cli/test_kanban_dup_detector.py
+++ b/tests/hermes_cli/test_kanban_dup_detector.py
@@ -180,3 +180,30 @@ def test_never_denies_the_keyword():
 def test_a_contraction_with_a_typographic_apostrophe_denies_the_keyword():
     """U+2019, as pasted from rendered markdown, denies like the ASCII apostrophe."""
     assert dd.sibling_named("Isn\u2019t a duplicate of t_0123456789abcdef.") == []
+
+
+@pytest.mark.parametrize("summary", [
+    "Not started since duplicate of t_0123456789abcdef.",
+    "Never run so duplicate of t_0123456789abcdef.",
+    "Not done but duplicate of t_0123456789abcdef.",
+    "No work due duplicate of t_0123456789abcdef.",
+    "Not started hence duplicate of t_0123456789abcdef.",
+    "Not run thus duplicate of t_0123456789abcdef.",
+    "Not run with duplicate of t_0123456789abcdef.",
+])
+def test_every_joining_word_stops_the_negator_reaching_the_keyword(summary):
+    """Post-merge check of PR #2535: each ``_JOIN`` word means the negator governs another word, not the keyword.
+    ``as`` and ``because`` are pinned by the not-denied cases earlier in this file."""
+    assert dd.sibling_named(summary) == ["t_0123456789abcdef"]
+
+
+@pytest.mark.parametrize("verb", [
+    "marked", "considered", "flagged", "treated", "closed", "counted", "filed", "labeled", "labelled", "tagged",
+    "reported", "listed", "deemed", "regarded", "classified", "recorded", "identified", "confirmed", "resolved",
+    "seen",
+])
+@pytest.mark.parametrize("template", ["Not {} as a duplicate of t_0123456789abcdef.",
+                                      "Never {} as duplicate of t_0123456789abcdef."])
+def test_every_judging_verb_after_a_negator_denies_the_keyword(verb, template):
+    """Post-merge check of PR #2535: each ``_JUDGED`` verb keeps the denial across "as"."""
+    assert dd.sibling_named(template.format(verb)) == []
diff --git a/tests/tools/test_kanban_create_overlap_same_creator.py b/tests/tools/test_kanban_create_overlap_same_creator.py
index 826b8e5306..4c159c3871 100644
--- a/tests/tools/test_kanban_create_overlap_same_creator.py
+++ b/tests/tools/test_kanban_create_overlap_same_creator.py
@@ -262,3 +262,19 @@ def test_a_moved_marker_beside_a_one_sided_marker_is_not_an_enumeration(mine, th
     card = {"title": theirs, "assignee": "default"}
     assert own.enumerated(mine, theirs) is None
     assert own.own_distinct(mine, "default", card) is None
+
+
+@pytest.mark.parametrize("mine, theirs", [
+    # A dotted counter after a re-issue word is one counter, not a number plus a "1"/"2" index.
+    ("Fix guard, attempt 2.1", "Fix guard, attempt 2.2"),
+    ("Fix guard round 1.1", "Fix guard round 1.2"),
+    # "tries" is a try word like "try"/"take".
+    ("Fix guard, tries 2", "Fix guard, tries 3"),
+])
+def test_a_dotted_or_tries_reissue_counter_is_not_an_enumeration(mine, theirs):
+    """Post-merge check of PR #2535: the dotted cases pin the optional ``.N`` tail of ``_COUNT``; the
+    ``tries`` case pins that alternative of ``_TRY_WORD``."""
+    from hermes_cli import kanban_overlap_own as own
+    card = {"title": theirs, "assignee": "default"}
+    assert own.enumerated(mine, theirs) is None
+    assert own.own_distinct(mine, "default", card) is None
-- 
