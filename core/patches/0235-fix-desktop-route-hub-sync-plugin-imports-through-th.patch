diff --git a/apps/desktop/src/sdk/gateways.ts b/apps/desktop/src/sdk/gateways.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1014a0009174967b438a6e9f7c56a73a8b4efa82
--- /dev/null
+++ b/apps/desktop/src/sdk/gateways.ts
@@ -0,0 +1,16 @@
+import { computed } from 'nanostores'
+
+import { $connectionsRegistry } from '@/store/connection-registry-state'
+
+/** [daveey] Every registered gateway (id, kind, label), registry order. Token
+ *  bytes and ssh details never cross into plugins. Empty on legacy
+ *  profile-only Desktop builds. */
+export interface PluginGateway {
+  id: string
+  kind: string
+  label: string
+}
+
+export const $gateways = computed($connectionsRegistry, (registry): PluginGateway[] =>
+  (registry?.connections ?? []).map(({ id, kind, label }) => ({ id, kind, label }))
+)
diff --git a/apps/desktop/src/sdk/hub-sync.ts b/apps/desktop/src/sdk/hub-sync.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bda560ee8e6d3032f3582c413f8d531c5596da4b
--- /dev/null
+++ b/apps/desktop/src/sdk/hub-sync.ts
@@ -0,0 +1,13 @@
+/** hermes-hub replica access (hub-sync): replica reads, gateway-name mapping and
+ *  owner requests. Best-effort: every read answers null/[] when hub-sync or the
+ *  hub is missing, so callers must keep their live path authoritative. */
+export {
+  connectionForHubGateway,
+  hubGatewayForConnection,
+  hubGatewayTasks,
+  hubGet,
+  hubReplicaConnectionId,
+  hubRequest,
+  learnHubGatewayName
+} from '@/store/hub-sync'
+export type { HubPending, HubRecord, HubRequestBody, HubRequestResult, HubTask } from '@/store/hub-sync'
