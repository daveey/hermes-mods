-    '  print("FOREIGN");sys.exit(0)\n' +
-    ' args=shlex.split(line)\n' +
+    '  raw=open(f"/proc/{pid}/cmdline","rb").read()\n' +
+    '  return [x.decode("utf-8","surrogateescape") for x in raw.split(b"\\0") if x]\n' +
+    ' except OSError:pass\n' +
+    ' if sys.platform=="darwin":\n' +
