From 75c54c9f807946a8d064c2715fe66ab284607216 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:16:56 +0000
Subject: [PATCH] [daveey] auto-resume silent test: wait on the mixed batch's
 queued completion, not its ledger row

test_a_mixed_batch_reports_each_child_once_and_no_early_failure_for_the_waiting_one flaked on CI
(run 43484917888, `assert [] == [None]`): it polled the async_delegations row until it left
`running`, then drained the completion queue. `_push_completion_event` writes that row
(`_persist_completion`) BEFORE it puts the event on `process_registry.completion_queue`, so a
test thread scheduled in that window reads an empty queue.

The test now drains the queue until the unit's own (non-notice) completion arrives. An early
per-task failure notice is queued while the unit still runs, so it is always collected before
that completion and the "no early notice" assertion keeps its strength.

Proof: with a 0.5 s sleep injected between the ledger write and the queue put, the old test
fails with the exact CI assertion (`assert [] == [None]`); the new one passes. Without the
injection the whole file passes (26 tests).
---
 tests/tools/test_delegate_auto_resume_silent.py | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/tests/tools/test_delegate_auto_resume_silent.py b/tests/tools/test_delegate_auto_resume_silent.py
index e5ad20bdb7..9d658b18a2 100644
--- a/tests/tools/test_delegate_auto_resume_silent.py
+++ b/tests/tools/test_delegate_auto_resume_silent.py
@@ -26,6 +26,19 @@ def _events(delegation_id):
     return got
 
 
+def _until_completion(delegation_id):
+    """The queued events of a non-silent unit up to its own completion. Its worker writes the ledger row before it
+    queues that completion, so a finished row does not mean the event is there yet; any early per-task notice is
+    queued before it, while the unit still runs."""
+    got = []
+
+    def completed():
+        got.extend(_events(delegation_id))
+        return any(not e.get("task_failure_notice") for e in got)
+    wait_until(completed, what="the unit's completion to be queued")
+    return got
+
+
 def _ledger(parent, delegation_id):
     import sqlite3
     conn = sqlite3.connect(parent._session_db.db_path)  # health: allow HX015 -- test reads a temp-home store
@@ -199,8 +212,7 @@ def test_a_mixed_batch_reports_each_child_once_and_no_early_failure_for_the_wait
     with patch("run_agent.AIAgent", side_effect=_LimitedWhenSlow()):
         out = json.loads(delegate_task(tasks=[{"goal": "write the parser"}, {"goal": "slow: write the tests"}],
                                        background=True, parent_agent=parent))
-        wait_until(lambda: (_ledger(parent, out["delegation_id"]) or ("running",))[0] != "running", what="the unit")
-    first = _events(out["delegation_id"])
+        first = _until_completion(out["delegation_id"])
     assert [e.get("task_failure_notice") for e in first] == [None], first  # the batch result only, no early notice
     _deadline(1)
     for _ in range(3):
