From 653386ca435255dc0340582be15e0c5e20f38461 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:39:45 -0700
Subject: [PATCH] fix(kanban): refuse a park on the card's own child or
 descendant [daveey]

Problem: on 2026-10-27 a parent parked awaiting its own child. The child stays
todo until the parent finishes, and session-idle walks that edge back into a cycle.
Why 1: kanban_continue inferred awaiting=card from a checkpoint that named the child.
Why 2: inference and schedule accepted any live card id, including descendants and a card that already waits back.
Root (happened): a declared producer and an inferred one were not checked against the task graph.
Root (not caught): no test covered continue or schedule naming the card's own child.
Countermeasures: dependency_cycle_reason at inference and at schedule/continue.
Proof: the new tests fail with inferred kind=card on the child when the guard is reverted, and pass with it.
---
 hermes_cli/kanban_awaiting.py            | 103 ++++++++++++++++++++++-
 hermes_cli/kanban_continuation.py        |   3 +
 hermes_cli/kanban_db_schedule.py         |   3 +
 tests/hermes_cli/test_kanban_awaiting.py |  89 ++++++++++++++++++++
 4 files changed, 196 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_awaiting.py b/hermes_cli/kanban_awaiting.py
index 775d29794c..82decec937 100644
--- a/hermes_cli/kanban_awaiting.py
+++ b/hermes_cli/kanban_awaiting.py
@@ -28,7 +28,10 @@ refused too
 (``kanban_wait_info``) already reports as a stall; on 10-27 a card waited 9 h on a KeepAlive browser
 nobody would stop. Short continues (<= 2 h, pacing a job) are exempt. Anything else is recorded
 as an inferred ``clock`` / ``external`` wait so the checker can tell legacy guesses from declared
-producers. The third park in a row on one premise is not parked again: it becomes one
+producers. Inference never names the card's own children or descendants: a parent parked on its
+child cycles (the child stays todo until the parent finishes, and the checker walks that edge
+back). A declared producer or wake probe that would cycle the same way is refused at schedule
+time. The third park in a row on one premise is not parked again: it becomes one
 agent-owned owner card for a supervisor and the card waits on it (``repark_escalated``). A park
 on the same opaque probe counts as the same premise however its reason is worded.
 """
@@ -201,6 +204,96 @@ def _latest_park(conn: sqlite3.Connection, task_id: str) -> tuple[Optional[dict]
     return payload.get("awaiting"), str(payload.get("reason") or "")
 
 
+def _descendant_ids(conn: sqlite3.Connection, task_id: str) -> set[str]:
+    """Child ids reachable from ``task_id`` (the card cannot wait on these)."""
+    seen: set[str] = set()
+    stack = [task_id]
+    while stack:
+        node = stack.pop()
+        for (cid,) in conn.execute(
+                "SELECT child_id FROM task_links WHERE parent_id = ?", (node,)):
+            if cid and cid not in seen:
+                seen.add(cid)
+                stack.append(cid)
+    return seen
+
+
+def _scheduled_probe_ids(conn: sqlite3.Connection, task_id: str) -> list[str]:
+    """Task ids named by the latest park's wake probe, if that park is still the wait."""
+    row = conn.execute(
+        "SELECT payload FROM task_events WHERE task_id = ? AND kind IN ('scheduled','continued') "
+        "ORDER BY id DESC LIMIT 1", (task_id,)).fetchone()
+    if not row:
+        return []
+    try:
+        payload = json.loads(row[0] or "{}")
+    except ValueError:
+        return []
+    probe = payload.get("wake_check")
+    if isinstance(probe, dict):
+        probe = probe.get("cmd") or ""
+    return _TASK_ID.findall(probe or "")
+
+
+def dependency_cycle_reason(conn: sqlite3.Connection, task_id: str, ref: str) -> Optional[str]:
+    """Why parking ``task_id`` on ``ref`` would cycle, or None.
+
+    Own children and deeper descendants always cycle: they stay gated until this card
+    finishes, and the idle checker walks that parent edge back. A card that is not a
+    descendant still cycles when the edges the checker walks (todo parents, a scheduled
+    card-await, a wake probe's task ids) lead back here.
+    """
+    if not ref or not _TASK_ID.fullmatch(str(ref)):
+        return None
+    if ref == task_id:
+        return f"{task_id} cannot wait on itself"
+    if ref in _descendant_ids(conn, task_id):
+        return (f"{ref} is a descendant of {task_id}; a card must not wait on its own child "
+                "(the child cannot finish until this card does, so the wait never ends)")
+    seen: set[str] = set()
+    stack = [ref]
+    while stack and len(seen) < 32:
+        node = stack.pop()
+        if node == task_id:
+            return f"waiting on {ref} cycles back to {task_id}"
+        if not node or node in seen:
+            continue
+        seen.add(node)
+        row = conn.execute("SELECT status FROM tasks WHERE id = ?", (node,)).fetchone()
+        if row is None:
+            continue
+        status = row[0]
+        if status == "todo":
+            stack.extend(parent for (parent,) in conn.execute(
+                "SELECT parent_id FROM task_links WHERE child_id = ?", (node,)))
+        elif status == "scheduled":
+            awaiting, _reason = _latest_park(conn, node)
+            if isinstance(awaiting, dict) and awaiting.get("kind") == "card" and not awaiting.get("gateway"):
+                pref = awaiting.get("ref") or ""
+                if _TASK_ID.fullmatch(pref):
+                    stack.append(pref)
+            stack.extend(_scheduled_probe_ids(conn, node))
+    return None
+
+
+def park_cycle_error(conn: sqlite3.Connection, task_id: str, record: Optional[dict],
+                     wake_check: Optional[str]) -> Optional[str]:
+    """Refusal text when this park's producer or wake probe would cycle, else None."""
+    refs: list[str] = []
+    if isinstance(record, dict) and record.get("kind") == "card" and not record.get("gateway"):
+        ref = record.get("ref") or ""
+        if _TASK_ID.fullmatch(ref):
+            refs.append(ref)
+    refs.extend(_TASK_ID.findall(wake_check or ""))
+    for ref in dict.fromkeys(refs):
+        if ref == task_id:
+            continue
+        why = dependency_cycle_reason(conn, task_id, ref)
+        if why:
+            return why
+    return None
+
+
 def card_orphan_reason(conn: sqlite3.Connection, task_id: str, *, _depth: int = 0) -> Optional[str]:
     """Why a local card cannot produce anything (None when it is a live producer)."""
     row = conn.execute("SELECT status, human_request, block_kind FROM tasks WHERE id = ?", (task_id,)).fetchone()
@@ -261,6 +354,10 @@ def _check_card(conn: sqlite3.Connection, task_id: str, awaiting: dict, text: st
     if ref == task_id:
         raise AwaitingError(INVALID_AWAITING, "a card cannot wait on itself")
     gateway = awaiting.get("gateway")
+    if not gateway:
+        why = dependency_cycle_reason(conn, task_id, ref)
+        if why:
+            raise AwaitingError(INVALID_AWAITING, why)
     if gateway:
         seen = _REMOTE_CONFIRMED.get((gateway, ref))
         if not seen or time.monotonic() - seen[0] > REMOTE_CONFIRM_TTL:
@@ -373,7 +470,9 @@ def resolve(conn: sqlite3.Connection, task_id: str, *, awaiting: Any, reason: Op
 
 def _live_card_ref(conn: sqlite3.Connection, task_id: str, text: str) -> Optional[str]:
     for ref in dict.fromkeys(_TASK_ID.findall(text or "")):
-        if ref != task_id and card_orphan_reason(conn, ref) is None:
+        if ref == task_id or dependency_cycle_reason(conn, task_id, ref):
+            continue  # self, own child/descendant, or a card that already waits back
+        if card_orphan_reason(conn, ref) is None:
             return ref
     return None
 
diff --git a/hermes_cli/kanban_continuation.py b/hermes_cli/kanban_continuation.py
index 98ce5c3036..2ad90bedf3 100644
--- a/hermes_cli/kanban_continuation.py
+++ b/hermes_cli/kanban_continuation.py
@@ -152,6 +152,9 @@ def continue_task(
                 return {"ok": True, "status": "todo", "run_id": None, "continuation": streak,
                         "wake_at": None, "escalated_to": owner}
             wake_check = wake_check or kaw.card_probe(record)
+            why = kaw.park_cycle_error(conn, task_id, record, wake_check)
+            if why:
+                return {"ok": False, "error": why, "reason_code": kaw.INVALID_AWAITING}
         try:
             wake_check, check_every = kwc.validate_park(
                 wake_at=wake_at, wake_check=wake_check,
diff --git a/hermes_cli/kanban_db_schedule.py b/hermes_cli/kanban_db_schedule.py
index c66c31ee98..f886ba833e 100644
--- a/hermes_cli/kanban_db_schedule.py
+++ b/hermes_cli/kanban_db_schedule.py
@@ -36,6 +36,9 @@ def schedule_task(
             return kaw.escalate(conn, task_id, record=rp.record, reason=reason,
                                 expected_run_id=expected_run_id) is not None
         wake_check = wake_check or kaw.card_probe(record)
+        why = kaw.park_cycle_error(conn, task_id, record, wake_check)
+        if why:
+            raise kaw.AwaitingError(kaw.INVALID_AWAITING, why)
         payload = scheduled_payload(reason)
         wake_check, check_every = kwc.validate_park(
             wake_at=payload["wake_at"], wake_check=wake_check,
diff --git a/tests/hermes_cli/test_kanban_awaiting.py b/tests/hermes_cli/test_kanban_awaiting.py
index 881578382b..5b50a97a15 100644
--- a/tests/hermes_cli/test_kanban_awaiting.py
+++ b/tests/hermes_cli/test_kanban_awaiting.py
@@ -559,3 +559,92 @@ def test_worker_cli_park_on_its_own_card_is_refused_but_an_operator_park_is_not(
         assert kb.schedule_task(conn, other, reason=CHROME_PROBE_REASON, wake_check=CHROME_PROBE)
         rec = _park_payload(conn, other)["awaiting"]
         assert rec["kind"] == "external" and rec["inferred"] is True
+
+
+# -- own children are not producers (t_01a180e1189d7ec3) ------------------------------------
+
+def _linked_child(conn, parent: str) -> str:
+    return kb.create_task(conn, title="child", assignee="worker", parents=[parent])
+
+
+def test_continue_does_not_infer_awaiting_from_own_child(kanban_home, monkeypatch) -> None:
+    """10-27: a continue whose checkpoint named its own child inferred awaiting=card on that
+    child. The child stays todo until the parent finishes, so the wait cycles."""
+    with kbc.connect_closing() as conn:
+        parent = _running(conn)
+        child = _linked_child(conn, parent)
+        grand = _linked_child(conn, child)
+        _as_worker(monkeypatch, conn, parent)
+        out = _tool("continue", {"checkpoint": f"child {child} still building; grandchild {grand} queued",
+                                 "resume_after_seconds": 300})
+        assert out.get("status") == "scheduled", out
+        awaiting = _park_payload(conn, parent)["awaiting"]
+        assert awaiting == {"kind": "clock", "inferred": True}, awaiting
+        assert kb.get_task(conn, child).status == "todo"
+
+
+def test_long_continue_on_a_descendant_does_not_install_a_child_probe(kanban_home, monkeypatch) -> None:
+    """A long continue used to infer the child and install `wait-check task <child>` as the probe,
+    which is the edge session-idle walks into a cycle. clock_only parks as a clock instead."""
+    with kbc.connect_closing() as conn:
+        parent = _running(conn)
+        child = _linked_child(conn, parent)
+        _as_worker(monkeypatch, conn, parent)
+        out = _tool("continue", {"checkpoint": f"waiting on child {child} to finish the build",
+                                 "resume_after_seconds": 20000, "clock_only": True})
+        assert out.get("status") == "scheduled", out
+        payload = _park_payload(conn, parent)
+        assert payload["awaiting"]["kind"] == "clock"
+        assert child not in json.dumps(payload.get("wake_check") or "")
+
+
+def test_continue_still_infers_an_unrelated_live_card(kanban_home, monkeypatch) -> None:
+    with kbc.connect_closing() as conn:
+        parent = _running(conn)
+        child = _linked_child(conn, parent)
+        other = _running(conn)
+        _as_worker(monkeypatch, conn, parent)
+        out = _tool("continue", {"checkpoint": f"child {child} is todo; producer is {other}",
+                                 "resume_after_seconds": 300})
+        assert out.get("status") == "scheduled", out
+        awaiting = _park_payload(conn, parent)["awaiting"]
+        assert awaiting == {"kind": "card", "ref": other, "inferred": True}, awaiting
+
+
+def test_declared_wait_on_a_descendant_is_refused(kanban_home, monkeypatch) -> None:
+    with kbc.connect_closing() as conn:
+        parent = _running(conn)
+        child = _linked_child(conn, parent)
+        _as_worker(monkeypatch, conn, parent)
+        out = _tool("continue", {"checkpoint": "park on the child", "resume_after_seconds": 300,
+                                 "awaiting": {"kind": "card", "ref": child}})
+        assert out.get("rejection") == kaw.INVALID_AWAITING or out.get("code") == kaw.INVALID_AWAITING, out
+        assert "descendant" in (out.get("error") or "")
+        assert kb.get_task(conn, parent).status == "running"
+
+
+def test_wake_probe_naming_a_descendant_is_refused(kanban_home, monkeypatch) -> None:
+    with kbc.connect_closing() as conn:
+        parent = _running(conn)
+        child = _linked_child(conn, parent)
+        _as_worker(monkeypatch, conn, parent)
+        out = _tool("schedule", {"reason": "soak", "clock_only": True,
+                                 "wake_check": f"hermes kanban wait-check task {child}",
+                                 "awaiting": {"kind": "clock", "why": "24h soak"}})
+        assert out.get("rejection") == kaw.INVALID_AWAITING or out.get("code") == kaw.INVALID_AWAITING, out
+        assert "descendant" in (out.get("error") or "")
+        assert kb.get_task(conn, parent).status == "running"
+
+
+def test_mutual_card_wait_is_refused(kanban_home, monkeypatch) -> None:
+    with kbc.connect_closing() as conn:
+        a, b = _running(conn), _running(conn)
+        _as_worker(monkeypatch, conn, b)
+        out = _tool("schedule", {"reason": f"waiting on {a}", "awaiting": {"kind": "card", "ref": a}})
+        assert out.get("status") == "scheduled", out
+        _as_worker(monkeypatch, conn, a)
+        out = _tool("schedule", {"reason": f"waiting on {b}", "awaiting": {"kind": "card", "ref": b}})
+        assert (out.get("rejection") == kaw.INVALID_AWAITING or out.get("code") == kaw.INVALID_AWAITING), out
+        assert "cycles" in (out.get("error") or "")
+        assert kb.get_task(conn, a).status == "running"
+
