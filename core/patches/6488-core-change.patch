From ba7bc0268381d98defda9c1a0e1931c0c37aebc0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 18:05:15 +0000
Subject: [PATCH 6488] Lane PR observations and CI park whole-commit wait

Public mirror of source commit ba7bc0268381d98defda9c1a0e1931c0c37aebc0.

---
diff --git a/hermes_cli/kanban_lanes_flow_pr_snapshot.py b/hermes_cli/kanban_lanes_flow_pr_snapshot.py
index efd45193cd8..3e61e8f5110 100644
--- a/hermes_cli/kanban_lanes_flow_pr_snapshot.py
+++ b/hermes_cli/kanban_lanes_flow_pr_snapshot.py
@@ -72,7 +72,12 @@
         commits = data["commits"]["nodes"]
         if len(commits) != 1 or commits[0]["commit"]["oid"] != data["headRefOid"]:
             return None
-        contexts = commits[0]["commit"]["statusCheckRollup"]["contexts"]
+        rollup = commits[0]["commit"]["statusCheckRollup"]
+        # GitHub returns explicit null when this head has no check/status runs.
+        # It is a valid OPEN observation, not green checks or a failed read.
+        if rollup is None:
+            return data, []
+        contexts = rollup["contexts"]
         if contexts["pageInfo"]["hasNextPage"] is not False or not isinstance(contexts["nodes"], list):
             return None
         buckets = []
diff --git a/tests/hermes_cli/test_kanban_lanes_flow_pr_snapshot.py b/tests/hermes_cli/test_kanban_lanes_flow_pr_snapshot.py
index 2580991944a..96f13b497dc 100644
--- a/tests/hermes_cli/test_kanban_lanes_flow_pr_snapshot.py
+++ b/tests/hermes_cli/test_kanban_lanes_flow_pr_snapshot.py
@@ -53,7 +53,7 @@
     ((*CONTEXT_PATH, "pageInfo", "hasNextPage"), True),
     ((*COMMIT_PATH, "oid"), "b" * 40),
     ((*CONTEXT_PATH, "pageInfo"), {}),
-    ((*COMMIT_PATH, "statusCheckRollup"), None),
+    ((*COMMIT_PATH, "statusCheckRollup"), {}),
 ])
 def test_incomplete_or_wrong_head_snapshot_never_reports_success(monkeypatch, path, value):
     payload = snapshot()
@@ -97,6 +97,37 @@
     assert Reader().get(URL)["approved"] is False
 
 
+@pytest.mark.parametrize("confirm_ok", [True, False])
+def test_null_rollup_is_observed_without_green_and_still_confirms(monkeypatch, confirm_ok):
+    payload = snapshot({"state": "OPEN", "headRefOid": HEAD, "reviewDecision": None})
+    commit = payload["data"]["repository"]["pullRequest"]["commits"]["nodes"][0]["commit"]
+    commit["statusCheckRollup"] = None
+    calls = []
+
+    def read(self, args):
+        calls.append(args)
+        if args[:2] == ["api", "graphql"]:
+            return payload
+        assert args == ["pr", "view", URL, "--json", "state,headRefOid,reviewDecision"]
+        return {"state": "OPEN", "headRefOid": HEAD if confirm_ok else "b" * 40,
+                "reviewDecision": ""}
+
+    monkeypatch.setattr(Reader, "_read", read)
+    reader = Reader()
+    expected = {"merged": False, "approved": False} if confirm_ok else {}
+    assert reader.get(URL) == expected
+    assert reader.get(URL) == expected
+    assert reader.states == ({URL: "OPEN"} if confirm_ok else {})
+    assert len(calls) == 2
+
+
+def test_missing_rollup_field_is_not_null_evidence():
+    payload = snapshot()
+    commit = payload["data"]["repository"]["pullRequest"]["commits"]["nodes"][0]["commit"]
+    del commit["statusCheckRollup"]
+    assert parse(payload) is None
+
+
 def test_only_required_checks_and_no_empty_green():
     payload = snapshot(buckets=())
     assert parse(payload)[1] == []
