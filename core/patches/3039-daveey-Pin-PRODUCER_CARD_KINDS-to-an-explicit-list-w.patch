From 9e0dc398e548e576c103a6384702159e698a9f1b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 00:05:03 +0000
Subject: [PATCH] [daveey] Pin PRODUCER_CARD_KINDS to an explicit list without
 loop_tick

#1772 added loop_tick to PRODUCER_NOTICE_DISPLAY_KINDS, and PRODUCER_CARD_KINDS
was derived from that set, so any producer card could name loop_tick through
automation_display_metadata, contradicting its comment ("kept apart from the
silence set"). No admission legitimately carries loop_tick: a slash /loop tick
bypasses admit_route_wake and snapshot_automation refuses commands. List the
four producer kinds explicitly and test that loop_tick is refused while staying
silence machinery (review 5883948618 nit on #1772).
---
 gateway/response_filters.py                      |  8 +++++---
 .../test_automation_notification_category.py     | 16 ++++++++++++++++
 2 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/gateway/response_filters.py b/gateway/response_filters.py
index 38512b7de5..848f9daea4 100644
--- a/gateway/response_filters.py
+++ b/gateway/response_filters.py
@@ -38,9 +38,11 @@ PRODUCER_NOTICE_DISPLAY_KINDS = frozenset(
     {"process_complete", "async_delegation_complete", "kanban_notice", "loop_tick"})
 MACHINERY_DISPLAY_KINDS = frozenset({INTERNAL_NOTIFICATION_DISPLAY_KIND, *PRODUCER_NOTICE_DISPLAY_KINDS})
 # What a gateway producer's card may name (a liveness tick names internal_notification for its CLI
-# receipt). Closed, and kept apart from the silence set above so a kind added there never becomes
-# nameable; never a client-chosen presentation such as ``hidden``.
-PRODUCER_CARD_KINDS = frozenset({INTERNAL_NOTIFICATION_DISPLAY_KIND, *PRODUCER_NOTICE_DISPLAY_KINDS})
+# receipt). An explicit closed list, not derived from the silence set above, so a kind added there
+# never becomes nameable: ``loop_tick`` is silence-machinery but no automation admission carries it (a
+# slash tick bypasses the authority FIFO). Never a client-chosen presentation such as ``hidden``. [daveey]
+PRODUCER_CARD_KINDS = frozenset({INTERNAL_NOTIFICATION_DISPLAY_KIND, "process_complete",
+                                 "async_delegation_complete", "kanban_notice"})
 
 # Longer than any marker could plausibly be, even with stray punctuation.
 _MARKER_LENGTH_CAP = 64
diff --git a/tests/gateway/test_automation_notification_category.py b/tests/gateway/test_automation_notification_category.py
index 1835c6c3b4..05f2c3aa15 100644
--- a/tests/gateway/test_automation_notification_category.py
+++ b/tests/gateway/test_automation_notification_category.py
@@ -113,6 +113,22 @@ async def test_display_kind_is_a_closed_producer_set(tmp_path, monkeypatch):
             automation_display_metadata(bad)
 
 
+def test_producer_card_kinds_is_explicit_and_excludes_loop_tick():
+    """A silence-machinery kind is not thereby nameable by a producer card: ``loop_tick`` is machinery
+    for silence, but no automation admission carries it (a slash /loop tick bypasses the FIFO)."""
+    from gateway.response_filters import (MACHINERY_DISPLAY_KINDS, PRODUCER_CARD_KINDS,
+                                          PRODUCER_NOTICE_DISPLAY_KINDS)
+    from gateway.session_automation import automation_display_metadata
+    assert PRODUCER_CARD_KINDS == {'internal_notification', 'process_complete', 'async_delegation_complete',
+                                   'kanban_notice'}
+    assert 'loop_tick' in PRODUCER_NOTICE_DISPLAY_KINDS and 'loop_tick' in MACHINERY_DISPLAY_KINDS
+    for kind in sorted(PRODUCER_CARD_KINDS):
+        card = {'display_kind': kind, 'display_text': 'x'}
+        assert automation_display_metadata(card) == card
+    with pytest.raises(RuntimeStoreError, match='invalid_params'):
+        automation_display_metadata({'display_kind': 'loop_tick', 'display_text': '↻ /loop /recap'})
+
+
 @pytest.mark.asyncio
 @pytest.mark.parametrize('category', ['result', 'diagnostic'])
 async def test_native_automation_category_roundtrip(tmp_path, monkeypatch, category):
