From 645c31dfecf3c8dd2c059c395352f0286650bba6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 17:54:43 +0000
Subject: [PATCH] [daveey] notify+wake dedup: the tui row keeps deferring while
 the core-drain hold holds the wake

While session_notifier_drain.held() is on, the waking local row rewinds every
batch and stays unacked, but tui_defer/wake_owes_after counted DEFER_MAX_S
(600 s) from the event's created_at. A hold longer than that let the tui row
start its notice turn, and the wake started a second turn once the hold lifted
(review t_01a1d0abf9e9a498 of PR #1465 at 9268465a67).

wake_owes_after now drops the age cutoff while the hold is on, so both tui
consumers (legacy poller, unloaded sweeper) leave a covered event to the held
wake. The window only pauses: after the hold lifts, a wake that cannot land
still leaves the notice to the tui row once the window has passed.

Card: t_01a1d0c30e0ca84d
---
 gateway/kanban_wake_sibling.py                | 24 ++++++--
 .../test_kanban_notify_wake_one_turn.py       | 61 +++++++++++++++++++
 2 files changed, 80 insertions(+), 5 deletions(-)

diff --git a/gateway/kanban_wake_sibling.py b/gateway/kanban_wake_sibling.py
index 96e55b55fc..417dd4bc94 100644
--- a/gateway/kanban_wake_sibling.py
+++ b/gateway/kanban_wake_sibling.py
@@ -10,9 +10,9 @@ The waking ``local`` row owns the turn for every event it wakes on, and the wake
 ``tui`` row would have shown (:func:`notice_lines`). The ``tui`` consumers stay silent only for events that row has
 already delivered (:func:`tui_cover`); while it still owes a covered event they leave the ``tui`` row unclaimed
 (:func:`tui_defer`), so a wake that never lands (the row dropped after repeated failures, no LOCAL adapter, past
-:data:`DEFER_MAX_S`) still leaves the ``tui`` notice owed and delivered: a duplicate beats a lost notice. Kinds the
-wake leg does not wake on (``status``, quota and re-pin notices) stay with the ``tui`` row. A ``notify``-only
-``local`` row covers nothing.
+:data:`DEFER_MAX_S`, a window that does not run while a core-drain hold keeps the wake waiting) still leaves the
+``tui`` notice owed and delivered: a duplicate beats a lost notice. Kinds the wake leg does not wake on (``status``,
+quota and re-pin notices) stay with the ``tui`` row. A ``notify``-only ``local`` row covers nothing.
 """
 
 from __future__ import annotations
@@ -97,7 +97,8 @@ def tui_defer(conn: Any, sub: dict, now: Optional[float] = None) -> bool:
 
 def wake_owes_after(conn: Any, sub: dict, floor: int, now: Optional[float] = None) -> bool:
     """True when this ``tui`` row's waking ``local`` sibling still owes a covered event past ``floor`` (and past
-    its own cursor), younger than :data:`DEFER_MAX_S`.
+    its own cursor), younger than :data:`DEFER_MAX_S`, or of any age while the core-drain hold that keeps the wake
+    leg waiting is on (:func:`_drain_held`).
 
     The legacy poller also asks this right after its claim, with ``floor`` = the claim's start: a covered event
     appended between :func:`tui_defer` and the claim would otherwise ride both the ``tui`` batch and the wake turn
@@ -109,8 +110,11 @@ def wake_owes_after(conn: Any, sub: dict, floor: int, now: Optional[float] = Non
     acked = _local_acked(conn, sub)
     if acked is None:
         return False
+    # While a core-update drain hold is on, the wake leg rewinds every batch and delivers it once the hold lifts,
+    # so the window does not run: a hold past DEFER_MAX_S let the tui row show its notice turn and the wake start
+    # a second one after the hold (review of PR #1465 at 9268465a67). [daveey]
+    since = float("-inf") if _drain_held() else (now if now is not None else time.time()) - DEFER_MAX_S
     try:
-        since = (now if now is not None else time.time()) - DEFER_MAX_S
         pending = conn.execute("SELECT kind, payload FROM task_events WHERE task_id = ? AND id > ? "
                                "AND created_at > ?", (sub["task_id"], max(int(floor), acked), since)).fetchall()
     except sqlite3.Error:
@@ -125,6 +129,16 @@ def wake_owes_after(conn: Any, sub: dict, floor: int, now: Optional[float] = Non
     return False
 
 
+def _drain_held() -> bool:
+    """The wake leg's core-drain hold (:func:`gateway.session_notifier_drain.held`); an unreadable hold marker counts
+    as not held (deliver as before: a duplicate beats a lost notice)."""
+    from gateway import session_notifier_drain
+    try:
+        return bool(session_notifier_drain.held())
+    except OSError:
+        return False
+
+
 def tui_formatter(conn: Any, sub: dict, fmt: Callable) -> Callable:
     """``fmt`` (``(sub, task, ev, board) -> text | None``) with the events :func:`tui_cover` covers silenced."""
     cover = tui_cover(conn, sub)
diff --git a/tests/gateway/test_kanban_notify_wake_one_turn.py b/tests/gateway/test_kanban_notify_wake_one_turn.py
index 356f09dc09..02b324f7df 100644
--- a/tests/gateway/test_kanban_notify_wake_one_turn.py
+++ b/tests/gateway/test_kanban_notify_wake_one_turn.py
@@ -531,3 +531,64 @@ def test_two_wakes_for_one_card_fold_in_either_order_keeping_every_notice_once(c
     assert sorted(card["notices"]) == sorted(["🔄 t_x → ready", "✔ t_x done", "⏸ blocked"])
     [again] = _merge([card], [dict(second)])  # a third wake re-folding the same card adds nothing twice
     assert again["text"] == card["text"]
+
+
+# Review of PR #1465 at 9268465a67: the core-drain hold can outlast DEFER_MAX_S.
+
+def _kanban_notices(db):
+    return [m.get("content") for m in db.get_messages(CHAT) if m.get("display_kind") == "kanban_notice"]
+
+
+def test_a_core_drain_hold_longer_than_the_defer_window_still_starts_one_turn(board, tmp_path, monkeypatch):
+    """While the core-drain hold is on, the wake leg rewinds every batch, but the tui row's DEFER_MAX_S window kept
+    running from the event: a hold over it let the tui row show its notice turn, and the wake started a second turn
+    once the hold lifted."""
+    from gateway import kanban_wake_sibling, session_notifier_drain
+    held = [True]
+    monkeypatch.setattr(session_notifier_drain, "held", lambda: held[0])
+    monkeypatch.setenv("HERMES_KANBAN_UNLOADED_WAKE", "0")
+    db = SessionDB(tmp_path / "state.db")
+    db.create_session(CHAT, "desktop")
+    db.append_message(CHAT, "user", "start the cards")
+
+    @contextlib.contextmanager
+    def opener(chat_id):
+        yield (db, chat_id) if db.get_session(chat_id) else (None, None)
+
+    runner, adapter = board
+    tid = _card()
+    _event(tid, "completed")
+    _wake_leg(runner)  # held: rewound, the local row stays unacked
+    assert adapter.turns == []
+    monkeypatch.setattr(kanban_wake_sibling, "DEFER_MAX_S", -1.0)  # the hold has outlasted the window
+    texts = _notice_leg()
+    ku.sweep_once(set(), now=time.time() + 3600, session_db=opener)
+    assert texts == [] and _kanban_notices(db) == []  # both tui consumers leave it to the held wake
+    held[0] = False
+    _wake_leg(runner)
+    texts += _notice_leg()
+    ku.sweep_once(set(), now=time.time() + 3600, session_db=opener)
+    texts += _kanban_notices(db)
+    assert len(adapter.turns) + len(texts) == 1, (adapter.turns, texts)
+    [turn] = adapter.turns
+    assert turn.count(NOTICE["completed"].format(tid=tid)) == 1
+    last, subs = _cursors(tid)
+    assert subs["local"] == (last, None) and subs["tui"] == (last, None)
+
+
+def test_a_wake_that_cannot_land_after_a_long_hold_still_leaves_the_tui_notice(board, monkeypatch):
+    """The hold only pauses the window: once it lifts, a wake that cannot land leaves the notice to the tui row."""
+    from gateway import kanban_wake_sibling, session_notifier_drain
+    held = [True]
+    monkeypatch.setattr(session_notifier_drain, "held", lambda: held[0])
+    runner, _ = board
+    runner.adapters = {}
+    tid = _card()
+    _event(tid, "completed")
+    monkeypatch.setattr(kanban_wake_sibling, "DEFER_MAX_S", -1.0)
+    _wake_leg(runner)
+    assert _notice_leg() == []  # held: still the wake's
+    held[0] = False
+    _wake_leg(runner)  # no LOCAL adapter: the wake never lands
+    texts = _notice_leg()
+    assert len(texts) == 1 and NOTICE["completed"].format(tid=tid) in texts[0]
