From 79224161ac5815bab6010629eafaf2916fcc8aaf Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 17:23:44 +0000
Subject: [PATCH] [daveey] Reconcile pickup material evidence regression with
 landed clock fixes

After rebase, the sibling boundary test treated only last_at/pass increments as new evidence. The correction intentionally suppresses those tick-only updates. Keep that suppression assertion and a positive changed-target-title assertion across all 16 cause/size/clock cases. Both pickup suites: 72 passed.
---
 tests/hermes_cli/test_kanban_pickup_stall.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_pickup_stall.py b/tests/hermes_cli/test_kanban_pickup_stall.py
index c54fab96bf7c84d1d14f105009666dbebecfbe3d..bea8532975d7acb3282bf6754b151b1fc5aed9e0 100644
--- a/tests/hermes_cli/test_kanban_pickup_stall.py
+++ b/tests/hermes_cli/test_kanban_pickup_stall.py
@@ -350,11 +350,16 @@ def test_same_cause_burst_refreshes_all_targets_without_comment_churn(gws, monke
     clock[0] += 1
     kps.file_repairs(worker.conn, WORKER, cards)
     assert len(kb.list_comments(worker.conn, tid)) == len(comments)
-    # Real new pickup evidence must still reach the open incident.
+    # Repeated skips update only tick bookkeeping, not material evidence.
     cards[0]["skip"].update(last_at=clock[0] * 1000, passes=2)
     assert kps.file_repairs(worker.conn, WORKER, cards) == [tid]
+    assert len(kb.list_comments(worker.conn, tid)) == len(comments)
+    # A changed target title is material and must still reach the open incident.
+    cards[0]["title"] = "changed target evidence"
+    assert kps.file_repairs(worker.conn, WORKER, cards) == [tid]
     updated = kb.list_comments(worker.conn, tid)
     assert len(updated) == len(comments) + 1
+    assert "changed target evidence" in updated[-1].body
     assert "2 pass(es)" in updated[-1].body
     clock[0] += 60
     kps.file_repairs(worker.conn, WORKER, cards)
-- 
