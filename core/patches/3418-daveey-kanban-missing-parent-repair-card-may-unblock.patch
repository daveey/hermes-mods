+- A missing-parent repair card may unblock exactly the child whose newest ``parent_missing`` block names it
+  (``missing_parent_repair_grant``); the operator call's home check uses the same rule across gateways.
 """
 from __future__ import annotations
 
+import json
 import re
 from typing import Optional
 
@@ -74,6 +77,45 @@ def self_heal_requeue_grant(conn, worker_task_id: str) -> tuple[Optional[str], O
     return (target, fix.id) if target else (None, None)
 
 
+MISSING_PARENT_DETECTOR = "missing-parent-detector"
+MISSING_PARENT_VIA = "missing-parent-repair"
+
+
+def is_missing_parent_repair_card(task) -> bool:
+    """A repair card the dispatcher's missing-parent detector filed (``kanban_db_graph.missing_parent_repair``)."""
+    return task is not None and (task.created_by or "") == MISSING_PARENT_DETECTOR
+
+
+def missing_parent_repair_grant(conn, worker_task_id: Optional[str], target_id: str) -> Optional[str]:
+    """The repair card id when ``worker_task_id`` may unblock ``target_id``, else None.
+
+    The dispatcher's parent_missing block carries no agent actor, yet it names a repair card as the owner of
+    recovery. That repair card (``created_by='missing-parent-detector'``) may unblock exactly the child that
+    created it (``creator_task_id``), and only while the child is blocked, has no human request, and its NEWEST
+    ``blocked`` event is ``source: parent_missing`` naming this very card as ``repair_task_id``. A later hand
+    block, or a block naming another repair card, revokes it. Both entry paths use it: the ``kanban_unblock``
+    tool (same gateway) and the operator call's home check (another gateway). [daveey]
+    """
+    if not worker_task_id or not target_id or worker_task_id == target_id:
+        return None
+    if not is_missing_parent_repair_card(kb.get_task(conn, worker_task_id)):
+        return None
+    if _creator_task_id(conn, worker_task_id) != target_id:
+        return None
+    row = conn.execute("SELECT status, human_request FROM tasks WHERE id = ?", (target_id,)).fetchone()
+    if row is None or row[0] != "blocked" or row[1]:
+        return None
+    ev = conn.execute("SELECT payload FROM task_events WHERE task_id = ? AND kind = 'blocked' "
+                      "ORDER BY id DESC LIMIT 1", (target_id,)).fetchone()
+    try:
+        payload = json.loads(ev[0] or "{}") if ev else {}
+    except ValueError:
+        return None
+    if not isinstance(payload, dict) or payload.get("source") != "parent_missing":
+        return None
+    return worker_task_id if payload.get("repair_task_id") == worker_task_id else None
+
+
 _OWNER_WAKE_TITLE = "Owner wake: supervise"
 # One chat-closeout ``owner_wake.card_line`` of a local card: ``- <board>/<id> "<title>": ...`` or ``- <board>/<id>:``.
 # A remote card's line names its gateway (`` on <gw>``) or a longer key, so it never matches.
@@ -107,6 +149,8 @@ def requeue_grant(conn, worker_task_id: str, target_id: str, *,
     """``(via, source_card)`` when this worker may unblock ``target_id``, else ``(None, None)``.
 
     - ``self-heal-requeue``: the self-heal grant (``self_heal_requeue_grant``), unchanged.
+    - ``missing-parent-repair``: a missing-parent repair card on its parent_missing child
+      (``missing_parent_repair_grant``).
     - ``owner-wake-requeue``: an owner-wake supervisor card (``created_by='owner-wake'``, title
       ``Owner wake: supervise ...``) may unblock exactly the cards its body lists on this board,
       and only while the target is in triage or blocked.
@@ -117,6 +161,9 @@ def requeue_grant(conn, worker_task_id: str, target_id: str, *,
     target, fix_id = self_heal_requeue_grant(conn, worker_task_id)
     if target is not None and target == target_id:
         return "self-heal-requeue", fix_id
+    repair = missing_parent_repair_grant(conn, worker_task_id, target_id)
+    if repair is not None:
+        return MISSING_PARENT_VIA, repair
     worker = kb.get_task(conn, worker_task_id)
     if not _is_owner_wake_supervisor(worker):
         return None, None
@@ -134,4 +181,6 @@ def has_requeue_grant(conn, worker_task_id: str, *, board: Optional[str] = None)
     if self_heal_requeue_grant(conn, worker_task_id)[0] is not None:
         return True
     worker = kb.get_task(conn, worker_task_id)
-    return bool(owner_wake_listed_refs(worker))
+    # A missing-parent repair card gets the tool even when its child lives on another gateway: the tool then
+    # forwards the unblock as an operator call, and the child's home re-checks the grant.
+    return bool(owner_wake_listed_refs(worker)) or is_missing_parent_repair_card(worker)
diff --git a/tests/hermes_cli/test_kanban_operator_call_missing_parent.py b/tests/hermes_cli/test_kanban_operator_call_missing_parent.py
new file mode 100644
index 0000000000..7df277c72e
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_operator_call_missing_parent.py
@@ -0,0 +1,121 @@
+"""Operator-call unblock of a parent_missing child by the repair card its block names. [daveey]
+
+The dispatcher's parent_missing block carries no agent actor, so the home refused every operator-call unblock of it
+as "a hand, Desktop or policy hold", although the same block names the repair card as its owner. The repair worker
+then ran ``hermes kanban unblock`` over ssh and the event read ``actor: user``. The home now accepts exactly the
+repair card its newest parent_missing block names (Board-proven ``caller.task_id``), and nothing else.
+"""
+from __future__ import annotations
+
+import json
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_supervisor_requests as ksr
+from tests.hermes_cli import test_kanban_operator_call as base
+
+_log, _round = base._log, base._round
+fleet = base.fleet  # the two-gateway fixture, shared
+
+
+def _home_repair(f):
+    """The home blocks a child as parent_missing and files its repair card; a worker-5 run picks the repair up."""
+    child = f.card(f.h, "dependent of a lost parent")
+    repair = kb.create_task(f.h, title=f"Recover missing dependencies for {child}", assignee="default",
+                            created_by="missing-parent-detector", creator_task_id=child)
+    with kb.write_txn(f.h):
+        f.h.execute("UPDATE tasks SET created_on = 'hub' WHERE id = ?", (repair,))
+        f.h.execute("UPDATE tasks SET status = 'blocked', block_kind = 'transient' WHERE id = ?", (child,))
+        kb._append_event(f.h, child, "blocked", {
+            "reason": f"parent t_ghost missing from this board; repair card {repair} owns investigation and recovery",
+            "kind": "transient", "source": "parent_missing", "parents": ["t_ghost"], "repair_task_id": repair})
+    # Worker-node pickup: worker-5 holds a copy of the hub's repair card and runs it under a Board lease.
+    row = f.h.execute("SELECT * FROM tasks WHERE id = ?", (repair,)).fetchone()
+    with kb.write_txn(f.w):
+        f.w.execute(f"INSERT INTO tasks ({','.join(row.keys())}) VALUES ({','.join('?' * len(row))})", tuple(row))
+    kb.claim_task(f.w, repair)
+    run_id = kb._current_run_id(f.w, repair)
+    f.run_uid(f.w, repair)
+    f.board()
+    run = f.w.execute("SELECT * FROM task_runs WHERE id = ?", (run_id,)).fetchone()
+    cols = [k for k in run.keys() if k != "id"]
+    with kb.write_txn(f.rep):
+        f.rep.execute(f"INSERT INTO task_runs ({','.join(cols)}) VALUES ({','.join('?' * len(cols))})",
+                      tuple(run[k] for k in cols))
+    return child, repair, run_id
+
+
+def _submit_as(f, task, run_id, target):
+    return ksr.submit(f.w, env_task=task, env_run=str(run_id),
+                      ops=[{"op": "operator", "action": "unblock", "task_id": target, "reason": "parent restored"}])
+
+
+def _execute_row(f, target):
+    return next(r for r in _log(f.h, "execute") if r["target_task_id"] == target)
+
+
+def _unblocked(f, target):
+    return [json.loads(p or "null") for (p,) in f.h.execute(
+        "SELECT payload FROM task_events WHERE task_id = ? AND kind = 'unblocked' ORDER BY id", (target,))]
+
+
+def test_repair_card_unblocks_its_child_through_an_operator_call(fleet):
+    f = fleet
+    child, repair, run_id = _home_repair(f)
+    out = _submit_as(f, repair, run_id, child)
+    _round(f)
+    assert _execute_row(f, child)["outcome"] == "applied", _execute_row(f, child)
+    assert kb.get_task(f.h, child).status in ("ready", "todo")
+    [payload] = _unblocked(f, child)
+    assert payload["operator_request_uid"]
+    assert payload["operator_caller"]["task_id"] == repair
+    assert payload["operator_caller"]["gateway"] == "worker-5"
+    assert payload["repair_task_id"] == repair
+    assert ksr.get_request(f.w, out["request_id"])["status"] == "done"
+
+
+def test_another_caller_still_cannot_release_the_parent_missing_block(fleet):
+    f = fleet
+    child, _repair, _ = _home_repair(f)
+    _submit_as(f, f.caller, f.run_id, child)
+    _round(f)
+    row = _execute_row(f, child)
+    assert row["outcome"] == "refused" and "not blocked by its own agent run" in row["detail"]
+    assert kb.get_task(f.h, child).status == "blocked"
+    assert not _unblocked(f, child)
+
+
+def test_repair_card_cannot_unblock_another_hub_card(fleet):
+    f = fleet
+    _child, repair, run_id = _home_repair(f)
+    held = f.card(f.h, "held by hand")
+    kb.block_task(f.h, held, reason="hold", actor="user", kind="transient")
+    f.board()
+    _submit_as(f, repair, run_id, held)
+    _round(f)
+    assert _execute_row(f, held)["outcome"] == "refused"
+    assert kb.get_task(f.h, held).status == "blocked"
+
+
+def test_block_superseded_by_a_hand_block_is_refused_at_home(fleet):
+    f = fleet
+    child, repair, run_id = _home_repair(f)
+    with kb.write_txn(f.h):
+        kb._append_event(f.h, child, "blocked", {"reason": "David holds it", "actor": "user", "kind": "transient"})
+    f.board()
+    _submit_as(f, repair, run_id, child)
+    _round(f)
+    assert _execute_row(f, child)["outcome"] == "refused"
+    assert kb.get_task(f.h, child).status == "blocked"
+
+
+def test_parent_missing_block_naming_another_repair_card_is_refused(fleet):
+    f = fleet
+    child, repair, run_id = _home_repair(f)
+    with kb.write_txn(f.h):
+        kb._append_event(f.h, child, "blocked", {"reason": "re-detected", "kind": "transient",
+                                                 "source": "parent_missing", "repair_task_id": "t_0123456789abcdef"})
+    f.board()
+    _submit_as(f, repair, run_id, child)
+    _round(f)
+    assert _execute_row(f, child)["outcome"] == "refused"
+    assert kb.get_task(f.h, child).status == "blocked"
diff --git a/tests/tools/test_kanban_missing_parent_repair_unblock.py b/tests/tools/test_kanban_missing_parent_repair_unblock.py
new file mode 100644
index 0000000000..73d5ca0ca1
--- /dev/null
+++ b/tests/tools/test_kanban_missing_parent_repair_unblock.py
@@ -0,0 +1,246 @@
+"""A missing-parent repair card may unblock exactly the child whose parent_missing block names it. [daveey]
+
+The dispatcher blocks a child whose parent stayed missing (``source: parent_missing``) and files a repair card
+(``created_by='missing-parent-detector'``, ``creator_task_id=<child>``) that owns recovery. Before the grant the
+repair worker's ``kanban_unblock`` was refused (no rule), so it unblocked over ssh with the CLI and the event read
+as David's (``actor: user``). Every other worker, target, or block stays refused.
+"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+
+@pytest.fixture
+def board(monkeypatch, tmp_path):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    (home / "config.yaml").write_text("kanban:\n  sync:\n    enabled: false\n")  # repair admission reads it
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_PROFILE", "test-worker")
+    for key in (
+        "HERMES_KANBAN_DB", "HERMES_KANBAN_BOARD", "HERMES_KANBAN_TASK",
+        "HERMES_KANBAN_RUN_ID", "HERMES_KANBAN_CLAIM_LOCK", "HERMES_KANBAN_HOME",
+        "HERMES_DELEGATED_CHILD_CONTEXT", "HERMES_KANBAN_WORKER_TASK", "HERMES_SESSION_ID",
+    ):
+        monkeypatch.delenv(key, raising=False)
+    from pathlib import Path as _Path
+    monkeypatch.setattr(_Path, "home", lambda: tmp_path)
+    from hermes_cli import kanban_db as kb
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    return home
+
+
+def _parent_missing_child(conn, kb, title="dependent"):
+    """A child the real detector blocked as parent_missing; returns ``(child, repair)``."""
+    child = kb.create_task(conn, title=title, assignee="default")
+    with kb.write_txn(conn):
+        conn.execute("INSERT INTO task_links (parent_id, child_id) VALUES (?, ?)", ("t_ghost0000000000", child))
+        conn.execute("UPDATE tasks SET status = 'todo' WHERE id = ?", (child,))
+    kb.recompute_ready(conn)
+    with kb.write_txn(conn):
+        conn.execute("UPDATE task_events SET created_at = created_at - ? WHERE task_id = ?",
+                     (kb.PARENT_MISSING_BLOCK_SECONDS + 1, child))
+    kb.recompute_ready(conn)
+    assert kb.get_task(conn, child).status == "blocked"
+    ev = conn.execute("SELECT payload FROM task_events WHERE task_id = ? AND kind = 'blocked' "
+                      "ORDER BY id DESC LIMIT 1", (child,)).fetchone()
+    repair = json.loads(ev[0])["repair_task_id"]
+    assert kb.get_task(conn, repair).created_by == "missing-parent-detector"
+    return child, repair
+
+
+def _as_worker(monkeypatch, conn, kb, tid):
+    kb.claim_task(conn, tid)
+    monkeypatch.setenv("HERMES_KANBAN_TASK", tid)
+    monkeypatch.setenv("HERMES_KANBAN_RUN_ID", str(kb._current_run_id(conn, tid)))
+
+
+def _unblock(target):
+    from tools import kanban_tools as kt
+    return json.loads(kt._handle_unblock({"task_id": target}))
+
+
+def _unblocked(conn, kb, tid):
+    return [e.payload for e in kb.list_events(conn, tid) if e.kind == "unblocked"]
+
+
+def test_repair_worker_unblocks_its_child_attributed_to_the_repair_card(board, monkeypatch):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    from tools import kanban_tools as kt
+
+    conn = kbc.connect()
+    child, repair = _parent_missing_child(conn, kb)
+    _as_worker(monkeypatch, conn, kb, repair)
+    conn.close()
+
+    assert kt._check_kanban_unblock() is True
+    out = _unblock(child)
+    assert out.get("ok") is True, out
+    assert out.get("via") == "missing-parent-repair"
+    conn = kbc.connect()
+    try:
+        assert kb.get_task(conn, child).status in ("ready", "todo")
+        [payload] = _unblocked(conn, kb, child)
+        assert payload["actor"] == f"agent (task {repair})"
+        assert payload["repair_task_id"] == repair
+    finally:
+        conn.close()
+
+
+def test_another_worker_cannot_unblock_a_parent_missing_child(board, monkeypatch):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+
+    conn = kbc.connect()
+    child, _repair = _parent_missing_child(conn, kb)
+    other = kb.create_task(conn, title="plain worker", assignee="default")
+    _as_worker(monkeypatch, conn, kb, other)
+    conn.close()
+
+    assert _unblock(child).get("ok") is not True
+    conn = kbc.connect()
+    try:
+        assert kb.get_task(conn, child).status == "blocked"
+        assert not _unblocked(conn, kb, child)
+    finally:
+        conn.close()
+
+
+def test_repair_card_cannot_unblock_another_target(board, monkeypatch):
+    from hermes_cli import kanban_db as kb
