From 1a423b77e21bffefc7c7717d3708bd0d354bcdf9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 10:52:44 +0000
Subject: [PATCH] fix(kanban): describe refused run routes without new pin
 directives [daveey]

---
 hermes_cli/kanban_host_refusal.py            | 4 ++--
 tests/hermes_cli/test_kanban_host_refusal.py | 5 +++++
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_host_refusal.py b/hermes_cli/kanban_host_refusal.py
index 4ec5fe1a0c..b90c09400b 100644
--- a/hermes_cli/kanban_host_refusal.py
+++ b/hermes_cli/kanban_host_refusal.py
@@ -162,8 +162,8 @@ def _cause(proof: dict, task_id: Optional[str] = None) -> str:
         claim = f"card {task_id}'s claim" if task_id else "the claim"
         return (f"the profile owner kept refusing {claim} with capsule_observation_missing (no live run-bound "
                 "capsule transport, or a profile policy it could not read made it require one)")
-    pin = "/".join(p for p in (proof.get("provider"), proof.get("model")) if p) or "its pin"
-    return f"the host's model-routing registry served no subscription pin when {whose} worker started ({pin})"
+    route = "/".join(p for p in (proof.get("provider"), proof.get("model")) if p) or "the selected route"
+    return f"the host's model-routing registry served no subscription route when {whose} worker started ({route})"
 
 
 def _host() -> str:
diff --git a/tests/hermes_cli/test_kanban_host_refusal.py b/tests/hermes_cli/test_kanban_host_refusal.py
index 18683084bb..babcb8f001 100644
--- a/tests/hermes_cli/test_kanban_host_refusal.py
+++ b/tests/hermes_cli/test_kanban_host_refusal.py
@@ -288,6 +288,11 @@ def test_host_notice_dedups_across_cards_and_reappears_next_window(home, monkeyp
         assert all(kb.get_task(conn, t).status == "ready" for t in cards)
         (notice,) = _notices(conn)
         assert cards[0] in notice["body"] or cards[1] in notice["body"]
+        from hermes_cli.kanban_model_neutral import validate_text
+        validate_text(notice["body"])
+        assert "anthropic/claude-opus-5-5" in notice["body"]  # observed route, not a new restriction
+        row = kb.get_task(conn, notice["id"])
+        assert (row.model_override, row.provider_override, row.model_pin_mandatory) == (None, None, None)
         assert _notice_comments(conn, notice["id"]) == []
 
         tid, frame = _admitted_run(conn, submitter=75003)  # same window: still one notice, no comment
-- 
2.43.0

