From a286616b5a0e2eadfdaa97a9030a2247045d42f6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 26 Oct 2026 23:09:58 +0000
Subject: [PATCH] test(projects): match atomic kanban activity snapshot fixture
 [daveey]

---
 tests/tui_gateway/test_projects_rpc.py | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/tests/tui_gateway/test_projects_rpc.py b/tests/tui_gateway/test_projects_rpc.py
index 0dc4494490..b50670dd5f 100644
--- a/tests/tui_gateway/test_projects_rpc.py
+++ b/tests/tui_gateway/test_projects_rpc.py
@@ -776,11 +776,12 @@ def test_tree_rows_carry_session_activity_stamps(monkeypatch, tmp_path):
         _create_session(launch_home, sid, repo)
 
     monkeypatch.setattr(goal_session_activity, "active_goal_sessions", lambda: frozenset({"s_goal"}))
-    # Counts include durable remote-stale evidence as the fourth mapping.
-    monkeypatch.setattr(
-        kanban_session_activity, "_all_counts",
-        lambda: ({"s_cards": 2}, {"s_cards": 1}, {}, {"s_cards": 1}),
-    )
+    # Match the atomic counts + waiting IDs snapshot used by row annotation.
+    def counts(*, include_waiting=False):
+        snapshot = ({"s_cards": 2}, {"s_cards": 1}, {}, {"s_cards": 1})
+        return (*snapshot, {"s_cards": frozenset({"t_open"})}) if include_waiting else snapshot
+
+    monkeypatch.setattr(kanban_session_activity, "_all_counts", counts)
     monkeypatch.setattr(cron_session_activity, "cron_owner_sessions", lambda: frozenset())
     monkeypatch.setattr(process_session_activity, "_owned_processes", lambda: {"s_quiet": set()})
 
