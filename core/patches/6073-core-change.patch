             clock[0] = end
-            if clock[0] >= 110:
-                stop.set()
             return False
     loop.run(Events(), stop, SimpleNamespace(held=lambda: True, beat=lambda: None),
              lambda: calls.append(clock[0]), coalesce=3.0, floor_all=True)
