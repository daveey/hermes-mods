From 4d03503112efbc91aa5339c68ed92ca3e72bb1e7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 10:52:40 +0000
Subject: [PATCH] test(kanban): preserve lifecycle and cross-board admission
 with real profile routes [daveey]

---
 tests/gateway/test_kanban_cross_board_slots.py             | 5 +++++
 tests/hermes_cli/test_kanban_block_kinds.py                | 4 ++++
 tests/hermes_cli/test_kanban_dispatch_owner_operator.py    | 2 ++
 tests/hermes_cli/test_kanban_dispatch_tick_hook.py         | 4 ++++
 tests/hermes_cli/test_kanban_owner_down.py                 | 5 +++++
 tests/hermes_cli/test_kanban_worker_lifecycle_hooks.py     | 4 ++++
 tests/hermes_cli/test_kanban_worktree_create_validation.py | 3 ++-
 tests/hermes_cli/test_kanban_worktree_restore.py           | 3 ++-
 8 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/tests/gateway/test_kanban_cross_board_slots.py b/tests/gateway/test_kanban_cross_board_slots.py
index b7c3089970..cd8e686048 100644
--- a/tests/gateway/test_kanban_cross_board_slots.py
+++ b/tests/gateway/test_kanban_cross_board_slots.py
@@ -22,6 +22,11 @@ def home(tmp_path, monkeypatch):
     root.mkdir()
     monkeypatch.setenv("HERMES_HOME", str(root))
     monkeypatch.setenv("HERMES_KANBAN_HOME", str(root))
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    from hermes_cli.kanban_model_assignment import _assignee_config
+    assert not (_assignee_config("default") or {}).get("model_routing", {}).get("enabled")
+    (root / "config.yaml").write_text(_managed_yaml())
+    assert _assignee_config("default")["model_routing"]["enabled"]
     for var in ("HERMES_KANBAN_DB", "HERMES_KANBAN_BOARD", "HERMES_KANBAN_TASK"):
         monkeypatch.delenv(var, raising=False)
     kb.init_db()
diff --git a/tests/hermes_cli/test_kanban_block_kinds.py b/tests/hermes_cli/test_kanban_block_kinds.py
index 57ccd4e3e3..04456bc966 100644
--- a/tests/hermes_cli/test_kanban_block_kinds.py
+++ b/tests/hermes_cli/test_kanban_block_kinds.py
@@ -36,6 +36,10 @@ def kanban_home(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
     home.mkdir()
     monkeypatch.setenv("HERMES_HOME", str(home))
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    profile = home / "profiles" / "worker"
+    profile.mkdir(parents=True)
+    (profile / "config.yaml").write_text(_managed_yaml())
     kb.init_db()
     return home
 
diff --git a/tests/hermes_cli/test_kanban_dispatch_owner_operator.py b/tests/hermes_cli/test_kanban_dispatch_owner_operator.py
index 0f02a1a907..0d30637c75 100644
--- a/tests/hermes_cli/test_kanban_dispatch_owner_operator.py
+++ b/tests/hermes_cli/test_kanban_dispatch_owner_operator.py
@@ -14,6 +14,8 @@ from hermes_cli.kanban_dispatch_owner import get_dispatch_owner, set_dispatch_ow
 @pytest.fixture
 def board(tmp_path, monkeypatch):
     monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    (tmp_path / "config.yaml").write_text(_managed_yaml())
     monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
     monkeypatch.delenv("HERMES_KANBAN_DB", raising=False)
     monkeypatch.delenv("HERMES_KANBAN_BOARD", raising=False)
diff --git a/tests/hermes_cli/test_kanban_dispatch_tick_hook.py b/tests/hermes_cli/test_kanban_dispatch_tick_hook.py
index a8ca184fa8..3b84ab595a 100644
--- a/tests/hermes_cli/test_kanban_dispatch_tick_hook.py
+++ b/tests/hermes_cli/test_kanban_dispatch_tick_hook.py
@@ -27,6 +27,10 @@ def kanban_home(tmp_path, monkeypatch):
     home.mkdir()
     monkeypatch.setenv("HERMES_HOME", str(home))
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    profile = home / "profiles" / "alice"
+    profile.mkdir(parents=True)
+    (profile / "config.yaml").write_text(_managed_yaml())
     kb.init_db()
     return home
 
diff --git a/tests/hermes_cli/test_kanban_owner_down.py b/tests/hermes_cli/test_kanban_owner_down.py
index e0135ec2ad..b12837acfd 100644
--- a/tests/hermes_cli/test_kanban_owner_down.py
+++ b/tests/hermes_cli/test_kanban_owner_down.py
@@ -51,6 +51,11 @@ def home(tmp_path, monkeypatch):
     monkeypatch.setattr(kb, "_pid_alive", lambda pid: False)
     monkeypatch.setattr(kbd, "_worker_final_output", lambda *a, **kw: "")
     monkeypatch.setattr(kbd, "_profile_exists_fn", lambda: (lambda name: True))
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    for name in ("askeve-builder", "worker-ok"):
+        profile = home / "profiles" / name
+        profile.mkdir(parents=True)
+        (profile / "config.yaml").write_text(_managed_yaml())
     kb.init_db()
     return home
 
diff --git a/tests/hermes_cli/test_kanban_worker_lifecycle_hooks.py b/tests/hermes_cli/test_kanban_worker_lifecycle_hooks.py
index 6ca48822af..abb3f013d0 100644
--- a/tests/hermes_cli/test_kanban_worker_lifecycle_hooks.py
+++ b/tests/hermes_cli/test_kanban_worker_lifecycle_hooks.py
@@ -37,6 +37,10 @@ def kanban_home(tmp_path, monkeypatch):
     # Crash detection acts immediately in these tests (no launch grace).
     monkeypatch.setenv("HERMES_KANBAN_CRASH_GRACE_SECONDS", "0")
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    profile = home / "profiles" / "alice"
+    profile.mkdir(parents=True)
+    (profile / "config.yaml").write_text(_managed_yaml())
     kb.init_db()
     return home
 
diff --git a/tests/hermes_cli/test_kanban_worktree_create_validation.py b/tests/hermes_cli/test_kanban_worktree_create_validation.py
index 636c1dc7c5..709d29c51d 100644
--- a/tests/hermes_cli/test_kanban_worktree_create_validation.py
+++ b/tests/hermes_cli/test_kanban_worktree_create_validation.py
@@ -36,8 +36,9 @@ def kanban_home(tmp_path, monkeypatch):
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
     profile = home / "profiles" / "a"
     profile.mkdir(parents=True)
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
     (profile / "config.yaml").write_text(
-        "platform_toolsets:\n  cli: [terminal, file]\nterminal:\n  backend: local\n",
+        "platform_toolsets:\n  cli: [terminal, file]\nterminal:\n  backend: local\n" + _managed_yaml(),
         encoding="utf-8",
     )
     kb.init_db()
diff --git a/tests/hermes_cli/test_kanban_worktree_restore.py b/tests/hermes_cli/test_kanban_worktree_restore.py
index 6e71a05c4b..609b14386d 100644
--- a/tests/hermes_cli/test_kanban_worktree_restore.py
+++ b/tests/hermes_cli/test_kanban_worktree_restore.py
@@ -29,8 +29,9 @@ def kanban_home(tmp_path, monkeypatch):
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
     profile = home / "profiles" / "a"
     profile.mkdir(parents=True)
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
     (profile / "config.yaml").write_text(
-        "platform_toolsets:\n  cli: [terminal, file]\nterminal:\n  backend: local\n", encoding="utf-8",
+        "platform_toolsets:\n  cli: [terminal, file]\nterminal:\n  backend: local\n" + _managed_yaml(), encoding="utf-8",
     )
     kb.init_db()
     return home
