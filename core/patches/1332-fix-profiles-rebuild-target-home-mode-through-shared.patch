From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 21:32:48 +0000
Subject: [PATCH] fix(profiles): rebuild target home mode through shared bridge
 [daveey]

---
 hermes_cli/config.py                            |  2 +-
 .../gateway/test_managed_worker_profile_env.py  | 17 ++++++++++++++++-
 tests/hermes_cli/test_web_host_terminal.py      |  2 +-
 tools/environments/local.py                     |  4 ++--
 4 files changed, 20 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/config.py b/hermes_cli/config.py
index cd79cc47070..19db20aee2b 100644
--- a/hermes_cli/config.py
+++ b/hermes_cli/config.py
@@ -2019,7 +2019,7 @@ TERMINAL_CONFIG_ENV_MAP = {
     **{
         key: f"TERMINAL_{key.upper()}"
         for key in (
-            "modal_mode", "degraded_mode", "cwd", "temp_dir", "timeout", "lifetime_seconds",
+            "modal_mode", "degraded_mode", "cwd", "home_mode", "temp_dir", "timeout", "lifetime_seconds",
             "docker_image", "docker_forward_env", "modal_image",
             "daytona_image", "vercel_runtime", "vercel_image", "ssh_host", "ssh_user", "ssh_port", "ssh_key",
             "container_cpu", "container_memory", "container_disk", "container_persistent",
diff --git a/tests/gateway/test_managed_worker_profile_env.py b/tests/gateway/test_managed_worker_profile_env.py
index 1f45a32591d..c71f8e00ab7 100644
--- a/tests/gateway/test_managed_worker_profile_env.py
+++ b/tests/gateway/test_managed_worker_profile_env.py
@@ -23,7 +23,7 @@ def test_secondary_worker_env_drops_launch_terminal_policy_and_env_settings(tmp_
     monkeypatch.setenv('HERMES_MODEL', 'launch-model')
     monkeypatch.setenv('TERMINAL_ENV', 'docker')
     monkeypatch.setenv('TERMINAL_CWD', str(root))
-    # These launch-bridge settings are derived outside TERMINAL_CONFIG_ENV_MAP.
+    # Include launch bridge policy, not only the fixture's backend and cwd.
     monkeypatch.setenv('TERMINAL_DOCKER_IMAGE_PINNED', '1')
     monkeypatch.setenv('TERMINAL_HOME_MODE', 'profile')
     set_multiplex_active(True)
@@ -55,6 +55,21 @@ def test_derived_terminal_policy_preserves_launch_and_managed_values(tmp_path, m
     assert strip_launch_profile_env(values.copy(), beta) == values
 
 
+def test_target_home_mode_is_rebuilt_by_both_terminal_bridges(tmp_path, monkeypatch):
+    from hermes_cli.config import apply_terminal_config_to_env
+    from tools.terminal_scope import build_profile_terminal_scope
+
+    target = tmp_path / 'target'
+    target.mkdir()
+    (target / 'config.yaml').write_text('terminal:\n  home_mode: profile\n')
+    monkeypatch.setenv('HERMES_HOME', str(target))
+    monkeypatch.setenv('TERMINAL_HOME_MODE', 'real')
+    scope = build_profile_terminal_scope(target)
+    assert scope['TERMINAL_HOME_MODE'] == 'profile'
+    child_env = apply_terminal_config_to_env(env={}, config={'terminal': {'home_mode': 'profile'}})
+    assert child_env['TERMINAL_HOME_MODE'] == 'profile'
+
+
 def test_launch_scrub_runs_before_the_turn_context_is_injected(tmp_path, monkeypatch):
     """The launch residue strip runs on the RAW environ, before ``build_subprocess_env`` bridges this
     turn's own session context: a launch ``.env`` that names ``HERMES_SESSION_ID`` must not erase the
diff --git a/tests/hermes_cli/test_web_host_terminal.py b/tests/hermes_cli/test_web_host_terminal.py
index e4b8e285545..4b48ff8d4b0 100644
--- a/tests/hermes_cli/test_web_host_terminal.py
+++ b/tests/hermes_cli/test_web_host_terminal.py
@@ -105,7 +105,7 @@ def test_host_terminal_resolver_applies_selected_profile_home_and_config(
     monkeypatch.setenv("HOME", str(current / "home"))
     monkeypatch.setenv("HERMES_HOME", str(current))
     monkeypatch.setenv("HERMES_REAL_HOME", str(real_home))
-    monkeypatch.setenv("TERMINAL_HOME_MODE", "profile")
+    monkeypatch.setenv("TERMINAL_HOME_MODE", "real")
     monkeypatch.setenv("OPENAI_API_KEY", "current-profile-secret")
 
     _argv, _cwd, env, _shell_name = web_host_terminal.resolve_argv(home=target)
diff --git a/tools/environments/local.py b/tools/environments/local.py
index c170e652114..9497922986f 100644
--- a/tools/environments/local.py
+++ b/tools/environments/local.py
@@ -530,8 +530,8 @@ def strip_launch_profile_env(env: dict, target_home: str | Path | None = None) -
         key.upper() for key in
         set(load_env_file(launch_home / ".env")) | set(launch_dotenv_keys())
         | set(TERMINAL_CONFIG_ENV_MAP.values()) | set(source_supplied_names())
-        # Derived by the config/gateway bridges, not represented in the config map.
-        | {"TERMINAL_DOCKER_IMAGE_PINNED", "TERMINAL_HOME_MODE"}
+        # Derived by the config bridge, not represented in the config map.
+        | {"TERMINAL_DOCKER_IMAGE_PINNED"}
         if not _is_global_env(key.upper()) or key.upper().startswith("TERMINAL_")} - managed_names
     for key in [k for k in env if k.upper() in residue_names]:
         del env[key]
