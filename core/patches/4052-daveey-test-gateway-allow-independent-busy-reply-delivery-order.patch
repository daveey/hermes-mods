From e78a5cf8f4e088d7f7fe8b7233eec0f0aa0961d3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 03:16:22 +0000
Subject: [PATCH] [daveey] test(gateway): allow independent busy-reply delivery
 order

Problem: CI job 132291138763 failed the ordered reply assertion despite
both replies arriving exactly once; its retry passed.
Why: FIFO execution settles the first turn and resolves its native waiter,
then starts the second. The adapter delivery tasks finish independently.
Root (happened): the test asserted transport ordering that execution FIFO
does not guarantee, unlike the sibling failure-notice test.
Root (not caught): the immediate fake transport usually preserves the
incidental order; no controlled reversed-delivery case exercised it.
Recurrence: no existing busy_follow_up PR found; main retains the assertion.

Assert exact reply multiplicity without incidental ordering. Parameterize
the integration test to gate the first transport send on the second send,
proving the reverse interleaving with Events, not a timing sleep. Retain
all receipt, queued/started, completion and background-task assertions.
Production code, deadlines and retry policy are unchanged.

Proof: canonical run_tests.sh with HERMES_TEST_FILE_RETRIES=0: 3 passed.
Controlled delayed delivery with old assertion: 1 failed, 2 passed, same
FIRST/SECOND ordering mismatch as CI. Owned descendant SIGSTOP/SIGCONT
(120ms stopped/30ms runnable): fixed 3 passed in 20.6s; restored old
assertion fails. scripts/hermes-python scripts/check --base origin/main
passed. Independent local source review found no blockers.
---
 .../gateway/test_shared_busy_receive_loop.py  | 22 +++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/tests/gateway/test_shared_busy_receive_loop.py b/tests/gateway/test_shared_busy_receive_loop.py
index 2af6696796..f827cefdbd 100644
--- a/tests/gateway/test_shared_busy_receive_loop.py
+++ b/tests/gateway/test_shared_busy_receive_loop.py
@@ -72,7 +72,8 @@ async def _wait_for(predicate, timeout=5):
 
 
 @pytest.mark.asyncio
-async def test_busy_follow_up_returns_after_commit_and_is_answered_once(monkeypatch):
+@pytest.mark.parametrize('delay_first_delivery', [False, True])
+async def test_busy_follow_up_returns_after_commit_and_is_answered_once(monkeypatch, delay_first_delivery):
     first_gate, second_gate = asyncio.Event(), asyncio.Event()
 
     async def first():
@@ -83,6 +84,19 @@ async def test_busy_follow_up_returns_after_commit_and_is_answered_once(monkeypa
         await second_gate.wait()
         return 'SECOND_REPLY'
     authority, adapter, source = await _busy_owner(monkeypatch, {'one': first, 'two': second})
+    if delay_first_delivery:
+        second_sent = asyncio.Event()
+        send = adapter.send
+
+        async def delayed_send(chat_id, content, reply_to=None, metadata=None):
+            if content == 'FIRST_REPLY':
+                await asyncio.wait_for(second_sent.wait(), timeout=30)
+            result = await send(chat_id, content, reply_to, metadata)
+            if content == 'SECOND_REPLY':
+                second_sent.set()
+            return result
+
+        monkeypatch.setattr(adapter, 'send', delayed_send)
     await adapter.handle_message(MessageEvent(text='one', source=source, message_id='m1'))
     await _wait_for(lambda: _statuses(authority).get('one') == 'started')
     # The receive loop hands over the follow-up while the first turn is still running.
@@ -96,7 +110,11 @@ async def test_busy_follow_up_returns_after_commit_and_is_answered_once(monkeypa
     await _wait_for(lambda: _statuses(authority).get('two') == 'started')
     second_gate.set()
     await _wait_for(lambda: 'SECOND_REPLY' in adapter.sent and not adapter._background_tasks)
-    assert adapter.sent == ['FIRST_REPLY', 'SECOND_REPLY']
+    # FIFO execution does not serialize the independent adapter delivery tasks.
+    # Keep exact multiplicity, but allow either transport completion order.
+    assert sorted(adapter.sent) == ['FIRST_REPLY', 'SECOND_REPLY']
+    if delay_first_delivery:
+        assert adapter.sent == ['SECOND_REPLY', 'FIRST_REPLY']
     assert _statuses(authority) == {'one': 'terminal', 'two': 'terminal'}
 
 
