From 147c572ff839bcac2bd60dcd8949920fc7ecbe54 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 24 Oct 2026 04:33:05 +0000
Subject: [PATCH] fix(kanban): require readable owner scope for origin
 projection [daveey]

---
 hermes_cli/kanban_origin_ledger.py            | 18 ++++++++++++
 .../test_kanban_origin_projection.py          | 28 +++++++++++++++++++
 2 files changed, 46 insertions(+)

diff --git a/hermes_cli/kanban_origin_ledger.py b/hermes_cli/kanban_origin_ledger.py
index e5b465733c..b33a16a036 100644
--- a/hermes_cli/kanban_origin_ledger.py
+++ b/hermes_cli/kanban_origin_ledger.py
@@ -195,6 +195,24 @@ def project(path: Path, *, replica: Path | None, gateway: str, profile: str,
                         "SELECT version,data FROM replica WHERE gw=? AND coll='tasks' AND key=?",
                         (owner['gateway'], binding['task_record_key'])).fetchone()
                     current = bool(row and row[0] == version and json.loads(row[1]) == task)
+                    # A successful origin pull does not prove the owner could
+                    # read this board. Consume the collector's qualified scope
+                    # inventory; missing/ambiguous inventory is not healthy.
+                    inventory = source.execute(
+                        "SELECT data FROM replica WHERE gw=? AND coll='gateway' AND key='info'",
+                        (owner['gateway'],)).fetchone()
+                    try:
+                        info = json.loads(inventory[0]) if inventory else {}
+                        scopes = info.get('task_scopes')
+                        if not isinstance(scopes, list):
+                            scopes = []
+                        matching = [s for s in scopes if isinstance(s, dict)
+                                    and (s.get('profile'), s.get('board')) == (owner['profile'], owner['board'])]
+                        readable = (info.get('gateway') == owner['gateway'] and len(matching) == 1
+                                    and matching[0].get('state') == 'ok')
+                    except (ValueError, TypeError, AttributeError):
+                        readable = False
+                    current = current and readable
                 status = task.get('status')
                 # Acceptance alone is not a release, including an initially
                 # terminal publication. Unknown status also remains unfinished.
diff --git a/tests/hermes_cli/test_kanban_origin_projection.py b/tests/hermes_cli/test_kanban_origin_projection.py
index 3649443fdb..05d529d93c 100644
--- a/tests/hermes_cli/test_kanban_origin_projection.py
+++ b/tests/hermes_cli/test_kanban_origin_projection.py
@@ -1,5 +1,7 @@
 """Authoritative receipt projections survive replica loss and isolate owners."""
 import sqlite3
+import json
+import pytest
 
 from tests.hermes_cli.test_kanban_origin_ledger import world, publish, accept
 from hermes_cli import kanban_origin_ledger as ledger
@@ -76,6 +78,13 @@ def test_projection_current_release_and_reopen(world):
         db.execute('CREATE TABLE meta (k TEXT PRIMARY KEY, v TEXT)')
         db.execute("INSERT INTO meta VALUES ('last_ok','1000')")
     def rows():
+        # Source contract: collect_all publishes scope health at gateway/info.
+        # publish() replaces the replica, so restore inventory on each observation.
+        with sqlite3.connect(replica) as db:
+            db.execute("DELETE FROM replica WHERE coll='gateway'")
+            db.execute("INSERT INTO replica VALUES ('owner','gateway','info',6,?)",
+                       (json.dumps({'gateway': 'owner', 'task_scopes': [
+                           {'profile': 'work', 'board': 'build', 'state': 'ok'}]}),))
         return ledger.project(path, replica=replica, gateway='origin', profile='default', now=1001)
     assert rows()[0]['status'] == 'running'
     publish(replica, binding, status='done')
@@ -88,3 +97,22 @@ def test_projection_current_release_and_reopen(world):
         db.execute('UPDATE replica SET version=5')
     assert rows()[0]['unfinished'] is True
     assert rows()[0]['status'] == 'running'
+
+
+@pytest.mark.parametrize('scopes', [None, [], [{'profile': 'work', 'board': 'build', 'state': 'unknown'}],
+                                   [{'profile': 'other', 'board': 'build', 'state': 'ok'}]])
+def test_fresh_origin_sync_does_not_make_unreadable_owner_scope_current(world, scopes):
+    path, replica, binding = world
+    publish(replica, binding)
+    accept(world)
+    publish(replica, binding, status='done')
+    with sqlite3.connect(replica) as db:
+        db.execute('UPDATE replica SET version=4')
+        db.execute('CREATE TABLE meta (k TEXT PRIMARY KEY, v TEXT)')
+        db.execute("INSERT INTO meta VALUES ('last_ok','1000')")
+        if scopes is not None:
+            db.execute("INSERT INTO replica VALUES ('owner','gateway','info',5,?)",
+                       (json.dumps({'gateway': 'owner', 'task_scopes': scopes}),))
+    row = ledger.project(path, replica=replica, gateway='origin', profile='default', now=1001)[0]
+    assert row['status'] == 'unknown'
+    assert row['unfinished'] and row['stale']
-- 
