From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 09:57:04 +0000
Subject: [PATCH] fix(session): reject malformed controls and label empty
 sessions truthfully [daveey]

---
 .../src/app/chat/session-status-dot.test.tsx    | 17 +++++++++++++++++
 .../desktop/src/app/chat/session-status-dot.tsx |  2 +-
 apps/desktop/src/test/canonical-outcome.ts      |  2 +-
 hermes_state_session_status_snapshot.py         |  3 ++-
 .../hermes_state/test_session_status_refresh.py | 13 ++++++++++++-
 5 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/apps/desktop/src/app/chat/session-status-dot.test.tsx b/apps/desktop/src/app/chat/session-status-dot.test.tsx
index edfe1ded06..a9bdf8f287 100644
--- a/apps/desktop/src/app/chat/session-status-dot.test.tsx
+++ b/apps/desktop/src/app/chat/session-status-dot.test.tsx
@@ -37,6 +37,23 @@ describe('SessionStatusDot published status', () => {
     }
   )
 
+  it('announces a canonical never-started session as draft, not Running', () => {
+    // Shape published by reduce_status for an empty transcript with complete source reads.
+    const status = {
+      ...canonicalOutcome('none').status,
+      kind: 'unresolved',
+      reason: 'empty',
+      presentation: { stripe: 'none', reason_codes: ['never_started'] }
+    }
+    const { container } = mount({ kind: 'unresolved', status })
+
+    const dot = container.querySelector('[data-session-status-dot]')!
+    expect(dot.getAttribute('data-session-status-dot')).toBe('none')
+    expect(dot.getAttribute('aria-label')).toBe('Draft — nothing sent yet')
+    expect(dot.getAttribute('title')).toBe('Draft — nothing sent yet')
+    expect(dot.className).toContain('border-(--ui-text-quaternary)')
+  })
+
   it.each([undefined, { kind: 'done' }, { kind: 'done', status: { status_version: 2 } }] as const)(
     'missing and unsupported protocols remain unknown: %j', value => {
       const { container } = mount(value as SessionOutcome | undefined)
diff --git a/apps/desktop/src/app/chat/session-status-dot.tsx b/apps/desktop/src/app/chat/session-status-dot.tsx
index 08b09d4eae..2e416b876b 100644
--- a/apps/desktop/src/app/chat/session-status-dot.tsx
+++ b/apps/desktop/src/app/chat/session-status-dot.tsx
@@ -107,7 +107,7 @@ export const sessionDotVariant = (
           : stripe === 'blocked' ? r.outcomeMuted
             : stripe === 'attention' ? r.outcomeUnresolved(null)
               : stripe === 'waiting' ? r.outcomeWaiting
-                : r.sessionRunning
+                : r.draftSession
 
   return {
     ariaLabel: label,
diff --git a/apps/desktop/src/test/canonical-outcome.ts b/apps/desktop/src/test/canonical-outcome.ts
index 7a673b2032..e196889431 100644
--- a/apps/desktop/src/test/canonical-outcome.ts
+++ b/apps/desktop/src/test/canonical-outcome.ts
@@ -13,7 +13,7 @@ export function canonicalOutcome(
     ...outcome,
     status: {
       status_version: 1,
-      kind: ({ done: 'done', attention: 'unresolved', blocked: 'muted', stuck: 'decision', waiting: 'waiting', none: 'running' } as const)[stripe],
+      kind: ({ done: 'done', attention: 'unresolved', blocked: 'muted', stuck: 'decision', waiting: 'waiting', none: 'unresolved' } as const)[stripe],
       revision: 7,
       generation: 3,
       identity: { gateway: 'gateway', profile: 'default', session_id: 'session', owner_epoch: 'epoch' },
diff --git a/hermes_state_session_status_snapshot.py b/hermes_state_session_status_snapshot.py
index 48ee3f2c3e..140248a9c0 100644
--- a/hermes_state_session_status_snapshot.py
+++ b/hermes_state_session_status_snapshot.py
@@ -150,7 +150,8 @@ def _control_items(sid: str) -> tuple[list[dict], list[dict]]:
         if not isinstance(result, dict):
             raise ValueError("malformed control result")
         for key, normalizer, target in (("decision_items", so._decision_item, decisions), ("waiting_on", so._wait_item, waits)):
-            values = result.get(key) or []
+            # Omitted collections mean no contribution; supplied null/non-lists are unavailable evidence.
+            values = result.get(key, [])
             if not isinstance(values, list):
                 raise ValueError("malformed control items")
             for value in values:
diff --git a/tests/hermes_state/test_session_status_refresh.py b/tests/hermes_state/test_session_status_refresh.py
index f67bbf1591..44ff7efcb2 100644
--- a/tests/hermes_state/test_session_status_refresh.py
+++ b/tests/hermes_state/test_session_status_refresh.py
@@ -120,7 +120,11 @@ def test_declaration_cron_receipt_cannot_restore_an_older_status_revision(db, bo
     assert so.get_outcome("chat", db=db)["status"] == successor[0]
 
 
-@pytest.mark.parametrize("value", [[], {"decision_items": [{}]}, {"waiting_on": [{"kind": "unsupported", "id": "work"}]}])
+@pytest.mark.parametrize("value", [
+    [], {"decision_items": [{}]}, {"waiting_on": [{"kind": "unsupported", "id": "work"}]},
+    {"decision_items": {}}, {"waiting_on": False}, {"decision_items": 0}, {"waiting_on": ""},
+    {"decision_items": None}, {"waiting_on": None},
+])
 def test_malformed_control_source_is_unknown_then_recovers(db, value):
     turn(db)
     so.register_outcome_provider("invalid", lambda sid: value)
@@ -131,6 +135,13 @@ def test_malformed_control_source_is_unknown_then_recovers(db, value):
     assert_done(refresh(db))
 
 
+@pytest.mark.parametrize("value", [{}, {"decision_items": [], "waiting_on": []}, None])
+def test_empty_or_noncontributing_control_source_is_complete(db, value):
+    turn(db)
+    so.register_outcome_provider("empty", lambda sid: value)
+    assert_done(refresh(db))
+
+
 @pytest.mark.parametrize("value", [{"status": "active"}, {"status": "unsupported", "goal": "work"}])
 def test_malformed_goal_source_is_unknown_then_recovers(db, value):
     turn(db)
