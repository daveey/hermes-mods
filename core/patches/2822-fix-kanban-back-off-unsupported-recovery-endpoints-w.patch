             if row["placement_policy"] is None and mode is None:
                 continue
             key = (board, row["id"])
@@ -327,12 +336,7 @@ def reevaluate(conn, hub, board, gateway, *, cfg=None):
                 else:
                     from hermes_cli.kanban_placement_recovery import request_assignment
                     reply = request_assignment(hub, board, row, mode, candidates)
-                    if reply.get("state") == "queued":
-                        # Never adopt an arbitrary post-pull revision: it may be somebody else's edit.
-                        version = reply.get("task_version", row["sync_version"])
-                        _queued[key] = (version, identity, time.monotonic() + RESERVE_KEEPALIVE_S)
-                        if len(_queued) > 1024:
-                            del _queued[next(iter(_queued))]
+                    _remember_queued(reply, key, row["sync_version"], identity)
                     queue.try_record(queue.record_reply, conn, row["id"], gateway, reply, candidates)
                 attempted += 1
             except OSError as exc:
@@ -342,6 +346,9 @@ def reevaluate(conn, hub, board, gateway, *, cfg=None):
                 return attempted
             except client.HubError as exc:
                 timing = queue.call_timing(budget, started, time.monotonic())
+                if recovery.unavailable_endpoint(hub, board, gateway, exc, mode):
+                    logger.info("Board recovery endpoint unavailable; backing off for %ss", recovery.RECOVERY_RETRY_S)
+                    continue
                 fence = None
                 if rejection_code(exc) == "not_claimable":
                     # The Board already has it leased or not ready: our copy is behind. Back off at this revision.
diff --git a/tests/hermes_cli/test_kanban_recovery_backoff.py b/tests/hermes_cli/test_kanban_recovery_backoff.py
new file mode 100644
index 0000000000..ec00828fef
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_recovery_backoff.py
@@ -0,0 +1,64 @@
+"""Older Boards do not support recovery; retain normal reservation service."""
+import pytest
+
+from hermes_cli import kanban_sync_client as client
+from hermes_cli import kanban_worker_placement as wp
+from tests.hermes_cli import test_kanban_placement_recovery as fixtures
+
+conn = fixtures.conn
+setup = fixtures.setup
+
+
+@pytest.mark.parametrize("status", [404, 405, 501])
+def test_absent_recovery_endpoint_backs_off_across_cards(setup, monkeypatch, status):
+    db, hub = setup
+    fixtures.make(db)
+    fixtures.make(db)
+    clock = [100.0]
+    monkeypatch.setattr(wp.time, "monotonic", lambda: clock[0])
+    calls = []
+
+    def unsupported(board, **body):
+        calls.append(body)
+        raise client.HubError(status, "not found")
+
+    hub.recover = unsupported
+    wp.reevaluate(db, hub, "default", "hub")
+    wp.reevaluate(db, hub, "default", "hub")
+    assert len(calls) == 1
+    clock[0] += 601
+    wp.reevaluate(db, hub, "default", "hub")
+    assert len(calls) == 2
+
+
+def test_unavailable_recovery_keeps_policy_reservations(setup, monkeypatch):
+    from hermes_cli import kanban_worker_node as node
+    from tests.hermes_cli import test_kanban_worker_reserve_client as reserve
+    db, hub = setup
+    tid = reserve.acknowledged(db, runs_on='["machine:worker-1"]')
+    monkeypatch.setattr(node, "registry", lambda **kw: {"machines": {"worker-1": {"state": "revoked"}}})
+    calls = []
+
+    def unsupported(board, **body):
+        raise client.HubError(404, "not found")
+
+    hub.recover = unsupported
+    hub.reserve = lambda board, **body: calls.append(body) or {"state": "assigned", "machine": "worker-2"}
+    wp.reevaluate(db, hub, "default", "hub")
+    wp.reevaluate(db, hub, "default", "hub")
+    assert calls == [{"task_id": tid, "expected_revision": 4, "candidates": ["worker-2"]}]
+
+
+def test_other_recovery_errors_remain_observable(setup):
+    db, hub = setup
+    fixtures.make(db)
+    calls = []
+
+    def conflict(board, **body):
+        calls.append(body)
+        raise client.HubError(409, '{"error":"revision_conflict"}')
+
+    hub.recover = conflict
+    wp.reevaluate(db, hub, "default", "hub")
+    wp.reevaluate(db, hub, "default", "hub")
+    assert len(calls) == 2
