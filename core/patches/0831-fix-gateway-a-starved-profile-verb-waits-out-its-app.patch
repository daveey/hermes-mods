From 816c454ef01358d5a0e8db7dd8e4c9e3fa1bc0f5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 23:22:46 +0000
Subject: [PATCH] fix(gateway): a starved profile verb waits out its apply
 [daveey]

Problem: test_profile_control_verbs_round_trip_and_refusals failed once
on CI run 40739917536 with FileNotFoundError reading gateway_state.json,
then passed on retry. SIGSTOP/SIGCONT (0.4s/0.03s) on the same test also
returned pending with no served/unserved key.

Why 1: the verb handler waited future.result(timeout=5) of wall clock,
and the test read the status file after a 2s flush. Both expire while
the process is stopped; monotonic time keeps running.
Why 2: the apply is milliseconds of CPU and the status write is an
off-thread fsync+rename, so a quiet machine hides both caps.
Why 3: nothing stalled the apply past 5s, and the CI retry kept the job
green. The 2s flush read is already fixed on main (7eb4ddb0); the verb
cap was the one the prescribed starvation still hit.
Root (happened): a wall-clock liveness cap sized for a quiet host was
used as proof the coroutine had finished.
Root (not caught): no test held the apply past 5s.
Recurrence: first filing of this id; the flush half landed separately.

Countermeasures: verb wait is 30s and returns as soon as apply finishes;
the socket client waits 45s so it reads that answer. A 6s apply must
return unserved, not pending. Sibling flush-then-read tests assert a
30s flush instead of ignoring a timed-out one.
---
 gateway/control_socket.py                     |  6 +++--
 gateway/run_profile_reconcile.py              |  6 ++++-
 .../gateway/test_drain_active_work_report.py  |  4 ++--
 .../test_multiplex_adapter_registry.py        |  2 +-
 tests/gateway/test_multiplex_hot_serve.py     | 22 +++++++++++++++++++
 5 files changed, 34 insertions(+), 6 deletions(-)

diff --git a/gateway/control_socket.py b/gateway/control_socket.py
index edcfcffde4..8fd6822e5c 100644
--- a/gateway/control_socket.py
+++ b/gateway/control_socket.py
@@ -371,11 +371,13 @@ def rescan_gateway_profiles(home: Path, *, timeout: float = 8.0) -> Optional[dic
 
 
 def request_unserve_profile(home: Path, name: str) -> Optional[dict[str, Any]]:
-    return query_gateway_control(home, "unserve-profile", params={"name": name}, timeout=8.0)
+    # Outlast the handler's ``_PROFILE_VERB_WAIT_S`` (30s) so a throttled gateway's
+    # answer is read, not dropped. A missing socket still fails at connect.
+    return query_gateway_control(home, "unserve-profile", params={"name": name}, timeout=45.0)
 
 
 def request_serve_profile_hot(home: Path, name: str) -> Optional[dict[str, Any]]:
-    return query_gateway_control(home, "serve-profile", params={"name": name}, timeout=8.0)
+    return query_gateway_control(home, "serve-profile", params={"name": name}, timeout=45.0)
 
 
 def migrate_gateway_profile_identity(home: Path, old_name: str, new_name: str, *,
diff --git a/gateway/run_profile_reconcile.py b/gateway/run_profile_reconcile.py
index 16cb67fd15..28723d3d08 100644
--- a/gateway/run_profile_reconcile.py
+++ b/gateway/run_profile_reconcile.py
@@ -32,6 +32,10 @@ _PROFILE_SIGNATURE_FILES = ("config.yaml", ".env")
 # read it can end in has no timeout of its own — on Windows the named pipe stalls there until
 # its peer answers — so the await needs one. A healthy identify answers in milliseconds.
 _OWN_GATEWAY_PROBE_TIMEOUT_SECS = 5.0
+# Wall-clock cap for a control-socket lifecycle verb. The apply coroutine is milliseconds of
+# CPU and returns as soon as it finishes; a 5s cap expired on a CPU-throttled runner before
+# the loop ran it, and the client was told ``pending``. Must stay under the socket client's wait.
+_PROFILE_VERB_WAIT_S = 30.0
 
 
 def profile_serve_signature(home: Path) -> tuple:
@@ -342,7 +346,7 @@ def _profile_lifecycle_verb(runner, *, serve: bool):
     def handler(params):
         future = asyncio.run_coroutine_threadsafe(apply(params.get("name")), loop)
         try:
-            return future.result(timeout=5.0)
+            return future.result(timeout=_PROFILE_VERB_WAIT_S)
         except TimeoutError:
             # Keep running: the client must not interpret an incomplete teardown as stopped.
             return {"pending": True, "served_profiles": runner.served_profile_names()}
diff --git a/tests/gateway/test_drain_active_work_report.py b/tests/gateway/test_drain_active_work_report.py
index 500ad159bb..4fd6c9f44f 100644
--- a/tests/gateway/test_drain_active_work_report.py
+++ b/tests/gateway/test_drain_active_work_report.py
@@ -40,7 +40,7 @@ def test_draining_status_names_chat_and_cron_units_and_clears_when_running(tmp_p
         with sched._running_lock:
             sched._running_worker_pids[sched._inflight_key("job-a")] = 4242
         runner._update_runtime_status("draining")
-        flush_runtime_status()
+        assert flush_runtime_status(timeout=30.0)
         record = json.loads((tmp_path / "gateway_state.json").read_text())
         by_kind = {unit["kind"]: unit for unit in record["active_work"]}
         assert by_kind["chat"]["session"] == "telegram:dm:1" and by_kind["chat"]["current_tool"] == "terminal"
@@ -50,7 +50,7 @@ def test_draining_status_names_chat_and_cron_units_and_clears_when_running(tmp_p
         sched.release_running_job("job-a")
     assert sched.get_running_job_details() == []
     runner._update_runtime_status("running")
-    flush_runtime_status()
+    assert flush_runtime_status(timeout=30.0)
     assert json.loads((tmp_path / "gateway_state.json").read_text())["active_work"] is None
 
 
diff --git a/tests/gateway/test_multiplex_adapter_registry.py b/tests/gateway/test_multiplex_adapter_registry.py
index 1ce45d3cec..2d193fc63e 100644
--- a/tests/gateway/test_multiplex_adapter_registry.py
+++ b/tests/gateway/test_multiplex_adapter_registry.py
@@ -900,7 +900,7 @@ class TestSecondaryProfileConfigHandling:
         runner.config = GatewayConfig(multiplex_profiles=False)
 
         assert await runner._start_secondary_profile_adapters() == 0
-        flush_runtime_status()
+        assert flush_runtime_status(timeout=30.0)
         assert read_runtime_status(tmp_path / "gateway_state.json")["served_profiles"] == []
 
     @pytest.mark.asyncio
diff --git a/tests/gateway/test_multiplex_hot_serve.py b/tests/gateway/test_multiplex_hot_serve.py
index 1f1640a4cc..b251252629 100644
--- a/tests/gateway/test_multiplex_hot_serve.py
+++ b/tests/gateway/test_multiplex_hot_serve.py
@@ -252,6 +252,28 @@ async def test_profile_control_verbs_round_trip_and_refusals(tmp_path, monkeypat
         assert runner._profile_adapters["worker"][Platform.DISCORD].token.endswith("new-worker-token\n")
 
 
+@pytest.mark.asyncio
+async def test_profile_verb_waits_out_a_slow_apply(tmp_path, monkeypatch):
+    """``future.result(timeout=5)`` is wall clock. A throttled loop misses it and
+    the verb returns ``pending`` with no ``unserved`` key (SIGSTOP duty cycle).
+    """
+    from gateway import run_profile_reconcile as verbs
+
+    runner, home = _runner(tmp_path, monkeypatch)
+    _mkprofile(home, "worker", "DISCORD_BOT_TOKEN=worker-token\n")
+    with patch("hermes_cli.profiles.get_active_profile_name", return_value="default"):
+        await runner._start_secondary_profile_adapters()
+        real = runner._unserve_profile
+
+        async def slow_unserve(name, home):
+            await asyncio.sleep(6)
+            await real(name, home)
+
+        runner._unserve_profile = slow_unserve
+        answer = await asyncio.to_thread(verbs.unserve_profile_verb(runner), {"name": "worker"})
+    assert answer.get("unserved") == "worker", answer
+
+
 @pytest.mark.platforms("linux")
 @pytest.mark.asyncio
 async def test_profile_lifecycle_over_real_control_socket(tmp_path, monkeypatch):
