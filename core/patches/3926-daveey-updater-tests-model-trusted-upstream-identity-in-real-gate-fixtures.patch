From 1018afeefbc71c0838db46af404ac44ac9e31c24 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:48:08 +0000
Subject: [PATCH] [daveey] updater tests: model trusted upstream identity in
 real gate fixtures

The upstream identity gate correctly refuses local-path remotes. Its script tests were updated, but the updater integration fixture was not, so green candidates never landed in two main-CI tests. Give FakeFork.adopt an explicit fixture upstream and map the canonical URL to it with clone-local insteadOf. Preserve production checks and all staging, identity, red-refusal and landing assertions.

Proof: original two files reproduced 8 passed / 2 failed. Fixed integration files, six upstream-sync suites and subprocess scanners: 1499 passed. scripts/check --base origin/main: 20 checks OK.
---
 tests/hermes_cli/test_update_fork_merge_upstream.py | 2 +-
 tests/hermes_cli/test_update_fork_sync_identity.py  | 2 +-
 tests/hermes_cli/upstream_gate_fake.py              | 6 +++++-
 3 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/tests/hermes_cli/test_update_fork_merge_upstream.py b/tests/hermes_cli/test_update_fork_merge_upstream.py
index 0747b45abb..200a0e1064 100644
--- a/tests/hermes_cli/test_update_fork_merge_upstream.py
+++ b/tests/hermes_cli/test_update_fork_merge_upstream.py
@@ -28,7 +28,7 @@ def repo(tmp_path, monkeypatch):
     for k, v in {"user.email": "t@t", "user.name": "t"}.items(): sh("git", "config", k, v, cwd=live)
     sh("git", "remote", "add", "upstream", str(up), cwd=live)
     (live / "a.txt").write_text("a fork\n"); sh("git", "commit", "-qam", "fork change", cwd=live); sh("git", "push", "-q", "origin", "main", cwd=live)
-    gate.adopt(live)
+    gate.adopt(live, up)
     return up, fork, live, gate
 
 
diff --git a/tests/hermes_cli/test_update_fork_sync_identity.py b/tests/hermes_cli/test_update_fork_sync_identity.py
index 8c6ab691e8..1dcb795a3c 100644
--- a/tests/hermes_cli/test_update_fork_sync_identity.py
+++ b/tests/hermes_cli/test_update_fork_sync_identity.py
@@ -73,7 +73,7 @@ def test_a_local_branch_named_upstream_main_never_changes_what_the_sync_counts_o
     # hands exactly that commit to the CI gate: staged first, on main once its full suite is green.
     from tests.hermes_cli.upstream_gate_fake import FakeFork
     gate = FakeFork(tmp_path, monkeypatch, origin)
-    gate.adopt(clone)
+    gate.adopt(clone, upstream)
     _push_synced_fork(["git"], clone)
     assert gate.staged() == [commits[2]]
     assert _git(origin, "rev-parse", "refs/heads/main") == commits[0]
diff --git a/tests/hermes_cli/upstream_gate_fake.py b/tests/hermes_cli/upstream_gate_fake.py
index f957082aef..e593039c5e 100644
--- a/tests/hermes_cli/upstream_gate_fake.py
+++ b/tests/hermes_cli/upstream_gate_fake.py
@@ -105,9 +105,13 @@ class FakeFork:
             f'[user]\n\temail = t@t\n\tname = t\n[url "{bare}"]\n\tinsteadOf = {URL}\n')
 
     @staticmethod
-    def adopt(clone: Path) -> None:
+    def adopt(clone: Path, upstream: Path) -> None:
         """Point ``clone``'s origin at the GitHub-named URL (resolved to the bare repo) and give it the gate."""
         subprocess.run(["git", "-C", str(clone), "remote", "set-url", "origin", URL], check=True)
+        # Keep the real upstream-identity check and fetch, but route all traffic to the fixture.
+        upstream_url = "https://github.com/NousResearch/hermes-agent.git"
+        subprocess.run(["git", "-C", str(clone), "config", f"url.{upstream}.insteadOf", upstream_url], check=True)
+        subprocess.run(["git", "-C", str(clone), "remote", "set-url", "upstream", upstream_url], check=True)
         gate = clone / "scripts" / "ci" / "upstream_sync.py"
         gate.parent.mkdir(parents=True, exist_ok=True)
         for sibling in GATE.parent.glob("upstream_sync*.py"):  # the gate and the helper modules it imports
-- 
