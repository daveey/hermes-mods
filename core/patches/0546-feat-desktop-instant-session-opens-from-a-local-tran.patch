diff --git a/apps/desktop/electron/transcript-cache-host.ts b/apps/desktop/electron/transcript-cache-host.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d820ba2d8bfbe77f0184a2603f6675af1b8d129a
--- /dev/null
+++ b/apps/desktop/electron/transcript-cache-host.ts
@@ -0,0 +1,201 @@
+/**
+ * [daveey] Electron-main host for the local transcript cache (instant session loads, C1):
+ * owns the SQLite store, answers the renderer's cache IPC and runs the background
+ * prefetcher against every registry gateway. main.ts injects its backend routing
+ * (ensureRegistryBackend + getJsonForBackend) so this module never dials on its own.
+ *
+ * IPC (preload exposes it as `hermesDesktop.transcriptCache`):
+ *   hermes:transcript-cache:read             sendSync  {connectionId, profile, sessionId} -> entry | null
+ *   hermes:transcript-cache:put              send      {key, messages, kind: 'latest' | 'older'}
+ *   hermes:transcript-cache:drop             send      {key} | {sessionId, everywhere: true}
+ *   hermes:transcript-cache:migrate-profile  send      {connectionId, from, to}
+ *   hermes:transcript-cache:clear            send
+ *   hermes:transcript-cache:stats            invoke    -> {bytes, sessions}
+ */
+import path from 'node:path'
+
+import type { IpcMain } from 'electron'
+
+import { type TranscriptCacheKey, TranscriptCacheStore } from './transcript-cache'
+import { type HubSessionRecord, TranscriptPrefetcher } from './transcript-prefetch'
+
+export interface TranscriptCacheHostDeps {
+  /** Resolve the backend descriptor of a registry connection's default profile. */
+  backendFor: (connectionId: string, opts: { passive: boolean }) => Promise<unknown>
+  getJson: (descriptor: unknown, requestPath: string, opts: { timeoutMs: number }) => Promise<any>
+  ipcMain: IpcMain
+  log: (line: string) => void
+  /** Registry snapshot: the primary id ('' connection ids mean it) and every connection id. */
+  registry: () => { connectionIds: string[]; primary: string }
+  userDataDir: string
+}
+
+const GATEWAY_NAME_PREFIX = 'hub-gateway:'
+const HUB_LIST_LIMIT = 2000
+
+export function installTranscriptCache(deps: TranscriptCacheHostDeps) {
+  const store = new TranscriptCacheStore(path.join(deps.userDataDir, 'transcript-cache.sqlite'))
+
+  const normalizeKey = (raw: any): TranscriptCacheKey | null => {
+    const sessionId = String(raw?.sessionId ?? '').trim()
+
+    if (!sessionId) {
+      return null
+    }
+
+    return {
+      connectionId: String(raw?.connectionId ?? '').trim() || deps.registry().primary || 'local',
+      profile: String(raw?.profile ?? '').trim() || 'default',
+      sessionId
+    }
+  }
+
+  const guarded = <T>(label: string, fn: () => T, fallback: T): T => {
+    try {
+      return fn()
+    } catch (error) {
+      deps.log(`transcript cache ${label} failed: ${(error as Error)?.message || error}`)
+
+      return fallback
+    }
+  }
+
+  deps.ipcMain.on('hermes:transcript-cache:read', (event, raw) => {
+    const key = normalizeKey(raw)
+    event.returnValue = key ? guarded('read', () => store.read(key), null) : null
+  })
+
+  deps.ipcMain.on('hermes:transcript-cache:put', (_event, payload) => {
+    const key = normalizeKey(payload?.key)
+
+    if (!key || !Array.isArray(payload?.messages)) {
+      return
+    }
+
+    guarded(
+      'put',
+      () => (payload.kind === 'older' ? store.putOlder(key, payload.messages) : store.putLatest(key, payload.messages)),
+      false
+    )
+  })
+
+  deps.ipcMain.on('hermes:transcript-cache:drop', (_event, payload) => {
+    if (payload?.everywhere) {
+      const sessionId = String(payload.sessionId ?? '').trim()
+
+      if (sessionId) {
+        guarded('drop', () => store.dropEverywhere(sessionId), undefined)
+      }
+
+      return
+    }
+
+    const key = normalizeKey(payload?.key)
+
+    if (key) {
+      guarded('drop', () => store.drop(key), undefined)
+    }
+  })
+
+  deps.ipcMain.on('hermes:transcript-cache:migrate-profile', (_event, payload) => {
+    const connectionId = String(payload?.connectionId ?? '').trim() || deps.registry().primary || 'local'
+    const from = String(payload?.from ?? '').trim() || 'default'
+    const to = String(payload?.to ?? '').trim() || 'default'
+
+    guarded('migrate', () => store.migrateProfile(connectionId, from, to), undefined)
+  })
+
+  deps.ipcMain.on('hermes:transcript-cache:clear', () => {
+    guarded('clear', () => store.clear(), undefined)
+  })
+
+  deps.ipcMain.handle('hermes:transcript-cache:stats', () => store.stats())
+
+  // Hub gateway name -> registry connection id, learned from each connection's own
+  // hub-sync status and remembered in the cache file so it survives restarts.
+  const learnedThisRun = new Set<string>()
+
+  const connectionForGateway = async (gateway: string): Promise<string | undefined> => {
+    const { connectionIds } = deps.registry()
+    const remembered = store.getMeta(GATEWAY_NAME_PREFIX + gateway)
+
+    if (remembered && connectionIds.includes(remembered)) {
+      return remembered
+    }
+
+    for (const connectionId of connectionIds) {
+      if (learnedThisRun.has(connectionId)) {
+        continue
+      }
+
+      learnedThisRun.add(connectionId)
+
+      try {
+        const descriptor = await deps.backendFor(connectionId, { passive: false })
+        const status = await deps.getJson(descriptor, '/api/plugins/hub-sync/status', { timeoutMs: 8_000 })
+        const name = typeof status?.gateway === 'string' ? status.gateway.trim() : ''
+
+        if (name) {
+          store.setMeta(GATEWAY_NAME_PREFIX + name, connectionId)
+
+          if (name === gateway) {
+            return connectionId
+          }
+        }
+      } catch (error) {
+        learnedThisRun.delete(connectionId) // retried on a later tick
+        deps.log(`transcript prefetch: could not read ${connectionId} hub name (${(error as Error)?.message || error})`)
+      }
+    }
+
+    return undefined
+  }
+
+  const prefetcher = new TranscriptPrefetcher({
+    connectionForGateway,
+    fetchLatest: async (key, limit) => {
+      const descriptor = await deps.backendFor(key.connectionId, { passive: false })
+
+      const query = new URLSearchParams({
+        include_compacted: 'true',
+        limit: String(limit),
+        order: 'latest',
+        profile: key.profile
+      })
+
+      const page = await deps.getJson(
+        descriptor,
+        `/api/sessions/${encodeURIComponent(key.sessionId)}/messages?${query.toString()}`,
+        { timeoutMs: 30_000 }
+      )
+
+      return Array.isArray(page?.messages) ? page.messages : []
+    },
+    listHubSessions: async () => {
+      try {
+        // The replica lives on this Mac: read it from the primary without spawning one.
+        const descriptor = await deps.backendFor(deps.registry().primary || 'local', { passive: true })
+
+        const body = await deps.getJson(descriptor, `/api/plugins/hub-sync/sessions?limit=${HUB_LIST_LIMIT}`, {
+          timeoutMs: 8_000
+        })
+
+        return body?.available === false || !Array.isArray(body?.sessions) ? null : (body.sessions as HubSessionRecord[])
+      } catch {
+        return null
+      }
+    },
+    log: deps.log,
+    store
+  })
+
+  return {
+    prefetcher,
+    start: () => prefetcher.start(),
+    stop: () => {
+      prefetcher.stop()
+      guarded('close', () => store.close(), undefined)
+    },
+    store
+  }
+}
diff --git a/apps/desktop/electron/transcript-cache.test.ts b/apps/desktop/electron/transcript-cache.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a9db6649f45c92ce2cc4b674397ae9c7e3059e31
--- /dev/null
+++ b/apps/desktop/electron/transcript-cache.test.ts
@@ -0,0 +1,175 @@
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+
+import { afterEach, describe, expect, it } from 'vitest'
+
+import { LATEST_ROWS, mergeLatest, mergeOlder, TranscriptCacheStore } from './transcript-cache'
+
+const rows = (from: number, to: number) =>
+  Array.from({ length: to - from + 1 }, (_, index) => ({
+    content: `m${from + index}`,
+    id: from + index,
+    role: 'user'
+  }))
+
+const key = (sessionId: string, connectionId = 'mac-mini', profile = 'default') => ({
+  connectionId,
+  profile,
+  sessionId
+})
+
+const dirs: string[] = []
+
+function tempFile() {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'transcript-cache-'))
+  dirs.push(dir)
+
+  return path.join(dir, 'transcript-cache.sqlite')
+}
+
+afterEach(() => {
+  for (const dir of dirs.splice(0)) {
+    fs.rmSync(dir, { force: true, recursive: true })
+  }
+})
+
+describe('transcript cache: write and read', () => {
+  it('round-trips the latest rows on disk, scoped by connection and profile', () => {
+    const file = tempFile()
+    const store = new TranscriptCacheStore(file)
+
+    expect(store.putLatest(key('s1'), rows(1, 3), { activity: 10, messageCount: 3 })).toBe(true)
+    store.close()
+
+    const reopened = new TranscriptCacheStore(file)
+    const hit = reopened.read(key('s1'))
+
+    expect(hit?.messages).toEqual(rows(1, 3))
+    expect(hit?.activity).toBe(10)
+    expect(hit?.messageCount).toBe(3)
+    // Same stored id under another gateway or profile is a different session.
+    expect(reopened.read(key('s1', 'hermes-hub'))).toBeNull()
+    expect(reopened.read(key('s1', 'mac-mini', 'alpha'))).toBeNull()
+    expect((fs.statSync(file).mode & 0o777).toString(8)).toBe('600')
+  })
+
+  it('keeps only the latest LATEST_ROWS of a page', () => {
+    const store = new TranscriptCacheStore(':memory:')
+
+    store.putLatest(key('s1'), rows(1, LATEST_ROWS + 50))
+
+    const hit = store.read(key('s1'))!
+    expect(hit.messages).toHaveLength(LATEST_ROWS)
+    expect(hit.messages[0]).toMatchObject({ id: 51 })
+  })
+
+  it('keeps loaded older pages when the next latest page overlaps, and drops them across a gap', () => {
+    const store = new TranscriptCacheStore(':memory:')
+
+    store.putLatest(key('s1'), rows(101, 300))
+    store.putOlder(key('s1'), rows(1, 100))
+    expect(store.read(key('s1'))!.messages).toHaveLength(300)
+
+    // Ten new rows: the new latest page starts inside the cached run.
+    store.putLatest(key('s1'), rows(111, 310))
+    const grown = store.read(key('s1'))!.messages
+    expect(grown).toHaveLength(310)
+    expect(grown[0]).toMatchObject({ id: 1 })
+    expect(grown.at(-1)).toMatchObject({ id: 310 })
+
+    // The session outgrew the window between fetches: no stitching across the gap.
+    store.putLatest(key('s1'), rows(601, 800))
+    expect(store.read(key('s1'))!.messages[0]).toMatchObject({ id: 601 })
+  })
+
+  it('ignores an older page with nothing to extend and dedupes overlapping rows', () => {
+    expect(mergeOlder([], rows(1, 3))).toEqual([])
+    expect(mergeOlder(rows(3, 5), rows(1, 4)).map(row => (row as { id: number }).id)).toEqual([1, 2, 3, 4, 5])
+    expect(mergeLatest(rows(1, 5), rows(1, 6))).toEqual(rows(1, 6))
+  })
+
+  it('drops one scope, every scope of a deleted id, and re-keys a renamed profile', () => {
+    const store = new TranscriptCacheStore(':memory:')
+
+    store.putLatest(key('s1'), rows(1, 2))
+    store.putLatest(key('s1', 'hermes-hub'), rows(1, 2))
+    store.putLatest(key('s2', 'local', 'old'), rows(1, 2))
+
+    store.drop(key('s1'))
+    expect(store.read(key('s1'))).toBeNull()
+    expect(store.read(key('s1', 'hermes-hub'))).not.toBeNull()
+
+    store.dropEverywhere('s1')
+    expect(store.read(key('s1', 'hermes-hub'))).toBeNull()
+
+    store.migrateProfile('local', 'old', 'new')
+    expect(store.read(key('s2', 'local', 'new'))?.messages).toEqual(rows(1, 2))
+    expect(store.read(key('s2', 'local', 'old'))).toBeNull()
+  })
+
+  it('self-evicts a corrupt entry', () => {
+    const file = tempFile()
+    const store = new TranscriptCacheStore(file)
+
+    store.putLatest(key('s1'), rows(1, 2))
+    store.close()
+
+    const raw = new DatabaseSync(file)
+    raw.prepare("UPDATE transcripts SET body = '{not json'").run()
+    raw.close()
+
+    const reopened = new TranscriptCacheStore(file)
+    expect(reopened.read(key('s1'))).toBeNull()
+    expect(reopened.stats().sessions).toBe(0)
+  })
+})
+
+describe('transcript cache: LRU and size bounds', () => {
+  it('evicts the least recently used session past the session bound', () => {
+    let clock = 0
+    const store = new TranscriptCacheStore(':memory:', { limits: { maxSessions: 3 }, now: () => (clock += 1) })
+
+    store.putLatest(key('a'), rows(1, 2))
+    store.putLatest(key('b'), rows(1, 2))
+    store.putLatest(key('c'), rows(1, 2))
+    store.read(key('a')) // a is now the most recently used
+    store.putLatest(key('d'), rows(1, 2))
+
+    expect(store.keys().map(entry => entry.sessionId).sort()).toEqual(['a', 'c', 'd'])
+  })
+
+  it('evicts by total bytes', () => {
+    let clock = 0
+    const store = new TranscriptCacheStore(':memory:', { limits: { maxTotalBytes: 2500 }, now: () => (clock += 1) })
+    const big = (sessionId: string) => store.putLatest(key(sessionId), [{ content: 'x'.repeat(1000), id: 1 }])
+
+    big('a')
+    big('b')
+    big('c')
+
+    expect(store.stats().bytes).toBeLessThanOrEqual(2500)
+    expect(store.keys().map(entry => entry.sessionId)).toEqual(['c', 'b'])
+  })
+
+  it('trims the oldest rows of an oversized entry instead of dropping its latest rows', () => {
+    const store = new TranscriptCacheStore(':memory:', { limits: { maxEntryBytes: 600 } })
+    const page = Array.from({ length: 20 }, (_, index) => ({ content: 'y'.repeat(50), id: index + 1 }))
+
+    store.putLatest(key('s1'), page)
+
+    const hit = store.read(key('s1'))!
+    expect(hit.messages.length).toBeGreaterThan(0)
+    expect(hit.messages.length).toBeLessThan(20)
+    expect(hit.messages.at(-1)).toMatchObject({ id: 20 })
+    expect(store.stats().bytes).toBeLessThanOrEqual(600)
+  })
+
+  it('refuses a single row larger than the entry bound', () => {
+    const store = new TranscriptCacheStore(':memory:', { limits: { maxEntryBytes: 100 } })
+
+    expect(store.putLatest(key('s1'), [{ content: 'z'.repeat(500), id: 1 }])).toBe(false)
+    expect(store.read(key('s1'))).toBeNull()
+  })
+})
diff --git a/apps/desktop/electron/transcript-cache.ts b/apps/desktop/electron/transcript-cache.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2f6885f9f9a98f2fa29747ef45892b8c36f2a1cd
--- /dev/null
+++ b/apps/desktop/electron/transcript-cache.ts
@@ -0,0 +1,341 @@
+/**
+ * [daveey] Persistent local transcript cache (instant session loads, C1).
+ *
+ * One SQLite file under Desktop's userData holds the raw `/api/sessions/{id}/messages`
+ * rows of recently active sessions on every gateway, keyed by (connection, profile,
+ * stored session id). A click paints from here before any SSH/REST round trip; the
+ * open path and the background prefetcher keep it current. Same trust domain as the
+ * gateways' own state.db on this Mac: plaintext, local only, never sent anywhere.
+ *
+ * Each entry is the newest contiguous run of a session's display rows: the latest
+ * page (LATEST_ROWS) plus any older pages the user loaded. A newer latest page
+ * replaces the tail and keeps the loaded prefix only when the two overlap, so a
+ * session that grew past the window never stitches a gap into its history.
+ *
+ * Bounds: MAX_SESSIONS entries and MAX_TOTAL_BYTES overall, least recently used
+ * first; one entry is capped at MAX_ENTRY_BYTES (older loaded pages go first).
+ */
+import fs from 'node:fs'
+import path from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+
+export const LATEST_ROWS = 200
+export const DEFAULT_LIMITS = {
+  maxEntryBytes: 8 * 1024 * 1024,
+  maxSessions: 1000,
+  maxTotalBytes: 256 * 1024 * 1024
+}
+
+export interface TranscriptCacheKey {
+  connectionId: string
+  profile: string
+  sessionId: string
+}
+
+export interface TranscriptCacheMeta {
+  /** Hub replica `activity` / `message_count` the entry was fetched against. */
+  activity?: null | number
+  messageCount?: null | number
+}
+
+export interface CachedTranscript {
+  activity: null | number
+  messageCount: null | number
+  messages: unknown[]
+  savedAt: number
+}
+
+type Limits = typeof DEFAULT_LIMITS
+
+const SCHEMA = `
+CREATE TABLE IF NOT EXISTS transcripts (
+  connection_id TEXT NOT NULL,
+  profile TEXT NOT NULL,
+  session_id TEXT NOT NULL,
+  body TEXT NOT NULL,
+  bytes INTEGER NOT NULL,
+  saved_at REAL NOT NULL,
+  used_at REAL NOT NULL,
+  activity REAL,
+  message_count INTEGER,
+  PRIMARY KEY (connection_id, profile, session_id)
+) WITHOUT ROWID;
+CREATE INDEX IF NOT EXISTS transcripts_used ON transcripts(used_at);
+CREATE INDEX IF NOT EXISTS transcripts_session ON transcripts(session_id);
+CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT NOT NULL);
+`
+
+/** Stable identity of one display row: the server row id when present. */
+export function messageIdentity(message: unknown): string {
+  const row = (message ?? {}) as Record<string, unknown>
+
+  if (typeof row.id === 'number' || typeof row.id === 'string') {
+    return `i:${row.id}`
+  }
+
+  return `h:${String(row.role ?? '')}|${String(row.timestamp ?? '')}|${String(row.tool_call_id ?? '')}`
+}
+
+/** Newer latest page `latest` over cached run `cached`: keep the loaded prefix only on overlap. */
+export function mergeLatest(cached: readonly unknown[], latest: readonly unknown[]): unknown[] {
+  if (latest.length === 0) {
+    return [...cached]
+  }
+
+  const anchor = messageIdentity(latest[0])
+  const at = cached.findIndex(message => messageIdentity(message) === anchor)
+
+  return at > 0 ? [...cached.slice(0, at), ...latest] : [...latest]
+}
+
+/** An older page loaded above the cached run: prepend what the run does not already hold. */
+export function mergeOlder(cached: readonly unknown[], older: readonly unknown[]): unknown[] {
+  if (cached.length === 0) {
+    return [] // no anchor: an older page alone is not "the latest messages"
+  }
+
+  const held = new Set(cached.map(messageIdentity))
+
+  return [...older.filter(message => !held.has(messageIdentity(message))), ...cached]
+}
+
+const byteLength = (text: string) => Buffer.byteLength(text, 'utf8')
+
+/** Serialize, dropping the oldest rows until the entry fits (latest rows always win). */
+function fitEntry(messages: unknown[], maxBytes: number): { body: string; bytes: number } | null {
+  let start = 0
+
+  while (start < messages.length) {
+    const body = JSON.stringify(messages.slice(start))
+    const bytes = byteLength(body)
+
+    if (bytes <= maxBytes) {
+      return { body, bytes }
+    }
+
+    // Drop roughly the overflow's share of rows, at least one.
+    start += Math.max(1, Math.floor(((bytes - maxBytes) / bytes) * (messages.length - start)))
+  }
+
+  return null
+}
+
+export class TranscriptCacheStore {
+  private readonly db: DatabaseSync
+  private readonly limits: Limits
+  private readonly now: () => number
+
+  constructor(file: string, options: { limits?: Partial<Limits>; now?: () => number } = {}) {
+    if (file !== ':memory:') {
+      fs.mkdirSync(path.dirname(file), { recursive: true })
+    }
+
+    this.db = new DatabaseSync(file)
+    this.limits = { ...DEFAULT_LIMITS, ...options.limits }
+    this.now = options.now ?? Date.now
+
+    this.db.exec('PRAGMA journal_mode = WAL; PRAGMA synchronous = NORMAL; PRAGMA busy_timeout = 2000;')
+    this.db.exec(SCHEMA)
+
+    if (file !== ':memory:') {
+      try {
+        fs.chmodSync(file, 0o600)
+      } catch {
+        // best effort: same posture as state.db
+      }
+    }
+  }
+
+  close(): void {
+    this.db.close()
+  }
+
+  read(key: TranscriptCacheKey, options: { touch?: boolean } = {}): CachedTranscript | null {
+    const row = this.db
+      .prepare(
+        'SELECT body, saved_at, activity, message_count FROM transcripts WHERE connection_id = ? AND profile = ? AND session_id = ?'
+      )
+      .get(key.connectionId, key.profile, key.sessionId) as
+      | { activity: null | number; body: string; message_count: null | number; saved_at: number }
+      | undefined
+
+    if (!row) {
+      return null
+    }
+
+    let messages: unknown
+
+    try {
+      messages = JSON.parse(row.body)
+    } catch {
+      messages = null
+    }
+
+    if (!Array.isArray(messages) || messages.length === 0) {
+      this.drop(key) // corrupt entries self-evict
+
+      return null
+    }
+
+    if (options.touch !== false) {
+      this.db
+        .prepare('UPDATE transcripts SET used_at = ? WHERE connection_id = ? AND profile = ? AND session_id = ?')
+        .run(this.now(), key.connectionId, key.profile, key.sessionId)
+    }
+
+    return { activity: row.activity, messageCount: row.message_count, messages, savedAt: row.saved_at }
+  }
+
+  /** Metadata only (prefetch freshness checks): no body parse, no LRU touch. */
+  meta(key: TranscriptCacheKey): { activity: null | number; messageCount: null | number; savedAt: number } | null {
+    const row = this.db
+      .prepare(
+        'SELECT saved_at, activity, message_count FROM transcripts WHERE connection_id = ? AND profile = ? AND session_id = ?'
+      )
+      .get(key.connectionId, key.profile, key.sessionId) as
+      | { activity: null | number; message_count: null | number; saved_at: number }
+      | undefined
+
+    return row ? { activity: row.activity, messageCount: row.message_count, savedAt: row.saved_at } : null
+  }
+
+  /** Store a freshly fetched latest page (chronological rows, newest last). */
+  putLatest(key: TranscriptCacheKey, latest: readonly unknown[], meta: TranscriptCacheMeta = {}): boolean {
+    if (!Array.isArray(latest) || latest.length === 0) {
+      return false
+    }
+
+    const cached = this.read(key, { touch: false })?.messages ?? []
+
+    return this.write(key, mergeLatest(cached, latest.slice(-LATEST_ROWS)), meta)
+  }
+
+  /** Store an older page the user loaded ("Show earlier"). Ignored without a cached run to extend. */
+  putOlder(key: TranscriptCacheKey, older: readonly unknown[]): boolean {
+    const current = this.read(key, { touch: false })
+
+    if (!current || !Array.isArray(older) || older.length === 0) {
+      return false
+    }
+
+    return this.write(key, mergeOlder(current.messages, older), {
+      activity: current.activity,
+      messageCount: current.messageCount
+    })
+  }
+
+  drop(key: TranscriptCacheKey): void {
+    this.db
+      .prepare('DELETE FROM transcripts WHERE connection_id = ? AND profile = ? AND session_id = ?')
+      .run(key.connectionId, key.profile, key.sessionId)
+  }
+
+  /** Every scope's entry for a deleted stored id. */
+  dropEverywhere(sessionId: string): void {
+    this.db.prepare('DELETE FROM transcripts WHERE session_id = ?').run(sessionId)
+  }
+
+  /** Profile rename on one connection: re-key its entries. */
+  migrateProfile(connectionId: string, from: string, to: string): void {
+    if (from === to) {
+      return
+    }
+
+    this.db
+      .prepare(
+        'UPDATE OR REPLACE transcripts SET profile = ? WHERE connection_id = ? AND profile = ?'
+      )
+      .run(to, connectionId, from)
+  }
+
+  clear(): void {
+    this.db.exec('DELETE FROM transcripts')
+  }
+
+  keys(): TranscriptCacheKey[] {
+    return (
+      this.db
+        .prepare('SELECT connection_id, profile, session_id FROM transcripts ORDER BY used_at DESC')
+        .all() as { connection_id: string; profile: string; session_id: string }[]
+    ).map(row => ({ connectionId: row.connection_id, profile: row.profile, sessionId: row.session_id }))
+  }
+
+  stats(): { bytes: number; sessions: number } {
+    const row = this.db.prepare('SELECT COUNT(*) AS n, COALESCE(SUM(bytes), 0) AS b FROM transcripts').get() as {
+      b: number
+      n: number
+    }
+
+    return { bytes: Number(row.b), sessions: Number(row.n) }
+  }
+
+  getMeta(k: string): null | string {
+    const row = this.db.prepare('SELECT v FROM meta WHERE k = ?').get(k) as { v: string } | undefined
+
+    return row?.v ?? null
+  }
+
+  setMeta(k: string, v: string): void {
+    this.db.prepare('INSERT INTO meta (k, v) VALUES (?, ?) ON CONFLICT(k) DO UPDATE SET v = excluded.v').run(k, v)
+  }
+
+  private write(key: TranscriptCacheKey, messages: unknown[], meta: TranscriptCacheMeta): boolean {
+    const fitted = fitEntry(messages, this.limits.maxEntryBytes)
+
+    if (!fitted) {
+      this.drop(key)
+
+      return false
+    }
+
+    const now = this.now()
+
+    this.db
+      .prepare(
+        `INSERT INTO transcripts (connection_id, profile, session_id, body, bytes, saved_at, used_at, activity, message_count)
+         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
+         ON CONFLICT(connection_id, profile, session_id) DO UPDATE SET
+           body = excluded.body, bytes = excluded.bytes, saved_at = excluded.saved_at, used_at = excluded.used_at,
+           activity = COALESCE(excluded.activity, transcripts.activity),
+           message_count = COALESCE(excluded.message_count, transcripts.message_count)`
+      )
+      .run(
+        key.connectionId,
+        key.profile,
+        key.sessionId,
+        fitted.body,
+        fitted.bytes,
+        now,
+        now,
+        meta.activity ?? null,
+        meta.messageCount ?? null
+      )
+
+    this.enforceBounds()
+
+    return true
+  }
+
+  /** Evict least recently used entries until both the count and byte bounds hold. */
+  enforceBounds(): void {
+    let { bytes, sessions } = this.stats()
+
+    if (sessions <= this.limits.maxSessions && bytes <= this.limits.maxTotalBytes) {
+      return
+    }
+
+    const victims = this.db
+      .prepare('SELECT connection_id, profile, session_id, bytes FROM transcripts ORDER BY used_at ASC')
+      .all() as { bytes: number; connection_id: string; profile: string; session_id: string }[]
+
+    for (const victim of victims) {
+      if (sessions <= this.limits.maxSessions && bytes <= this.limits.maxTotalBytes) {
+        break
+      }
+
+      this.drop({ connectionId: victim.connection_id, profile: victim.profile, sessionId: victim.session_id })
+      sessions -= 1
+      bytes -= Number(victim.bytes)
+    }
+  }
+}
diff --git a/apps/desktop/electron/transcript-prefetch.test.ts b/apps/desktop/electron/transcript-prefetch.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c60d26ba2f9ac2889034c50de4540a53601e68f8
--- /dev/null
+++ b/apps/desktop/electron/transcript-prefetch.test.ts
@@ -0,0 +1,182 @@
+import { describe, expect, it, vi } from 'vitest'
+
+import { type TranscriptCacheKey, TranscriptCacheStore } from './transcript-cache'
+import {
+  GATEWAY_BACKOFF_MS,
+  type HubSessionRecord,
+  MIN_REFETCH_MS,
+  selectPrefetchTargets,
+  TranscriptPrefetcher
+} from './transcript-prefetch'
+
+const CONNECTIONS: Record<string, string> = { hub: 'hermes-hub', macbook: 'local', mini: 'mac-mini' }
+
+const record = (gateway: string, id: string, activity: number, extra: Partial<HubSessionRecord> = {}) => ({
+  activity,
+  gateway,
+  id,
+  message_count: 10,
+  profile: 'default',
+  ...extra
+})
+
+describe('prefetch selection', () => {
+  it('takes the most recently active tips per gateway, skipping archived, hidden, parents and unregistered gateways', () => {
+    const records: HubSessionRecord[] = [
+      record('mini', 'old', 1),
+      record('mini', 'new', 5),
+      record('mini', 'mid', 3),
+      record('mini', 'gone', 9, { archived: true }),
+      record('mini', 'secret', 9, { hidden: true }),
+      record('hub', 'root', 4),
+      record('hub', 'tip', 6, { parent_session_id: 'root' }),
+      record('hub', 'bot', 8, { automated: true, profile: 'alpha' }),
+      record('elsewhere', 'x', 10)
+    ]
+
+    const targets = selectPrefetchTargets(records, gateway => CONNECTIONS[gateway], 2)
+
+    expect(targets.map(target => `${target.key.connectionId}/${target.key.profile}/${target.key.sessionId}`)).toEqual([
+      // people's chats first, newest first; automations after
+      'hermes-hub/default/tip',
+      'mac-mini/default/new',
+      'mac-mini/default/mid',
+      'hermes-hub/alpha/bot'
+    ])
+  })
+
+  it('caps each gateway separately', () => {
+    const records = [
+      ...Array.from({ length: 250 }, (_, index) => record('mini', `m${index}`, index)),
+      ...Array.from({ length: 250 }, (_, index) => record('hub', `h${index}`, index))
+    ]
+
+    const targets = selectPrefetchTargets(records, gateway => CONNECTIONS[gateway])
+
+    expect(targets.filter(target => target.key.connectionId === 'mac-mini')).toHaveLength(200)
+    expect(targets.filter(target => target.key.connectionId === 'hermes-hub')).toHaveLength(200)
+    expect(targets.some(target => target.key.sessionId === 'm49')).toBe(false)
+    expect(targets.some(target => target.key.sessionId === 'm50')).toBe(true)
+  })
+
+  it("keeps a gateway's people chats in the window when automations are busier", () => {
+    const records = [
+      ...Array.from({ length: 250 }, (_, index) => record('hub', `bot${index}`, 1000 + index, { automated: true })),
+      record('hub', 'quiet-chat', 1)
+    ]
+
+    const hub = selectPrefetchTargets(records, gateway => CONNECTIONS[gateway])
+
+    expect(hub).toHaveLength(200)
+    expect(hub[0].key.sessionId).toBe('quiet-chat')
+  })
+})
+
+describe('prefetch refresh on activity change', () => {
+  function harness(records: HubSessionRecord[]) {
+    let clock = 1_000_000
+    const store = new TranscriptCacheStore(':memory:', { now: () => clock })
+    const fetchLatest = vi.fn(async (key: TranscriptCacheKey) => [{ content: `${key.sessionId}@${clock}`, id: clock }])
+
+    const prefetcher = new TranscriptPrefetcher({
+      connectionForGateway: gateway => CONNECTIONS[gateway],
+      fetchLatest,
+      listHubSessions: async () => records,
+      now: () => clock,
+      store
+    })
+
+    return {
+      advance: (ms: number) => (clock += ms),
+      fetchLatest,
+      prefetcher,
+      store
+    }
+  }
+
+  it('fetches every target once, then only the session whose activity or message_count moved', async () => {
+    const records = [record('mini', 'a', 1), record('mini', 'b', 2), record('hub', 'c', 3)]
+    const h = harness(records)
+
+    expect(await h.prefetcher.tick()).toMatchObject({ fetched: 3, targets: 3 })
+    expect(h.store.read({ connectionId: 'mac-mini', profile: 'default', sessionId: 'a' })?.activity).toBe(1)
+
+    h.advance(MIN_REFETCH_MS)
+    expect(await h.prefetcher.tick()).toMatchObject({ fetched: 0, skipped: 3 })
+
+    records[1] = record('mini', 'b', 7) // new activity on b
+    records[2] = record('hub', 'c', 3, { message_count: 11 }) // a message landed on c
+    h.fetchLatest.mockClear()
+    expect(await h.prefetcher.tick()).toMatchObject({ fetched: 2 })
+    expect(h.fetchLatest.mock.calls.map(([key]) => key.sessionId).sort()).toEqual(['b', 'c'])
+    expect(h.store.read({ connectionId: 'mac-mini', profile: 'default', sessionId: 'b' })?.activity).toBe(7)
+  })
+
+  it('refetches a session that keeps moving at most once per MIN_REFETCH_MS', async () => {
+    const records = [record('mini', 'a', 1)]
+    const h = harness(records)
+
+    await h.prefetcher.tick()
+    records[0] = record('mini', 'a', 2)
+    h.advance(1_000)
+    expect(await h.prefetcher.tick()).toMatchObject({ fetched: 0 })
+    h.advance(MIN_REFETCH_MS)
+    expect(await h.prefetcher.tick()).toMatchObject({ fetched: 1 })
+  })
+
+  it('backs off a gateway whose route fails without blocking the others', async () => {
+    const records = [record('mini', 'a', 1), record('mini', 'b', 2), record('mini', 'c', 3), record('hub', 'd', 4)]
+    const h = harness(records)
+
+    h.fetchLatest.mockImplementation(async key => {
+      if (key.connectionId === 'mac-mini') {
+        throw new Error('connect ECONNREFUSED')
+      }
+
+      return [{ content: 'ok', id: 1 }]
+    })
+
+    const first = await h.prefetcher.tick()
+    expect(first.fetched).toBe(1)
+    expect(first.failed).toBeGreaterThanOrEqual(1)
+    // At most the two in-flight workers hit the dead route before it is marked down.
+    expect(h.fetchLatest.mock.calls.filter(([key]) => key.connectionId === 'mac-mini').length).toBeLessThanOrEqual(2)
+
+    h.fetchLatest.mockClear()
+    await h.prefetcher.tick()
+    expect(h.fetchLatest.mock.calls.some(([key]) => key.connectionId === 'mac-mini')).toBe(false)
+
+    h.advance(GATEWAY_BACKOFF_MS)
+    await h.prefetcher.tick()
+    expect(h.fetchLatest.mock.calls.some(([key]) => key.connectionId === 'mac-mini')).toBe(true)
+  })
+
+  it('a 404 for one session does not mark its gateway down', async () => {
+    const h = harness([record('mini', 'a', 1), record('mini', 'b', 2), record('mini', 'c', 3)])
+
+    h.fetchLatest.mockImplementation(async key => {
+      if (key.sessionId === 'c') {
+        throw Object.assign(new Error('not found'), { status: 404 })
+      }
+
+      return [{ content: 'ok', id: 1 }]
+    })
+
+    expect(await h.prefetcher.tick()).toMatchObject({ failed: 1, fetched: 2 })
+  })
+
+  it('does nothing without a hub replica', async () => {
+    const store = new TranscriptCacheStore(':memory:')
+    const fetchLatest = vi.fn()
+
+    const prefetcher = new TranscriptPrefetcher({
+      connectionForGateway: () => 'local',
+      fetchLatest,
+      listHubSessions: async () => null,
+      store
+    })
+
+    expect(await prefetcher.tick()).toMatchObject({ fetched: 0, targets: 0 })
+    expect(fetchLatest).not.toHaveBeenCalled()
+  })
+})
diff --git a/apps/desktop/electron/transcript-prefetch.ts b/apps/desktop/electron/transcript-prefetch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e2dbc729a8e46b67b62e46a6d962ca5dc57e5624
--- /dev/null
+++ b/apps/desktop/electron/transcript-prefetch.ts
@@ -0,0 +1,275 @@
+/**
+ * [daveey] Background transcript prefetch (instant session loads, C1).
+ *
+ * The local hermes-hub replica (`GET /api/plugins/hub-sync/sessions`, fresh within
+ * about a second via `hermes-hub watch`) lists every gateway's sessions with their
+ * `activity` and `message_count`. Each tick picks, per gateway, the PER_GATEWAY most
+ * recently active session tips and fetches the latest page of any whose cached copy
+ * was taken against a different activity/message_count. So a click on any of them
+ * paints from the local cache, and a session that moved is refetched on the next
+ * tick. All I/O is injected; electron/main.ts wires it to ensureRegistryBackend.
+ */
+import { LATEST_ROWS, type TranscriptCacheKey, type TranscriptCacheMeta } from './transcript-cache'
+
+export const PER_GATEWAY = 200
+/** A session whose activity keeps moving (a running turn) is refetched at most this often. */
+export const MIN_REFETCH_MS = 30_000
+/** A gateway that failed is skipped for this long before it is tried again. */
+export const GATEWAY_BACKOFF_MS = 60_000
+
+export interface HubSessionRecord {
+  activity?: null | number
+  archived?: boolean
+  automated?: boolean
+  gateway: string
+  hidden?: boolean
+  id: string
+  message_count?: null | number
+  parent_session_id?: null | string
+  profile?: null | string
+  started_at?: null | number
+}
+
+export interface PrefetchTarget {
+  automated: boolean
+  key: TranscriptCacheKey
+  meta: { activity: null | number; messageCount: null | number }
+}
+
+export interface PrefetchStore {
+  meta(key: TranscriptCacheKey): { activity: null | number; messageCount: null | number; savedAt: number } | null
+  putLatest(key: TranscriptCacheKey, latest: readonly unknown[], meta?: TranscriptCacheMeta): boolean
+}
+
+export interface PrefetchDeps {
+  /** Registry connection id of a hub gateway name, or undefined (unregistered gateway). */
+  connectionForGateway: (gateway: string) => Promise<string | undefined> | string | undefined
+  /** Latest `limit` raw display rows of one session (chronological). */
+  fetchLatest: (key: TranscriptCacheKey, limit: number) => Promise<unknown[]>
+  listHubSessions: () => Promise<HubSessionRecord[] | null>
+  log?: (line: string) => void
+  now?: () => number
+  store: PrefetchStore
+}
+
+const profileOf = (value: unknown) => String(value ?? '').trim() || 'default'
+
+/**
+ * Per gateway, the PER_GATEWAY most recently active session tips, people's chats
+ * before automations. A record that is another record's compression parent is
+ * history of that tip, not its own session. Fetch order: chats first, newest first.
+ */
+export function selectPrefetchTargets(
+  records: readonly HubSessionRecord[],
+  connectionForGateway: (gateway: string) => string | undefined,
+  perGateway: number = PER_GATEWAY
+): PrefetchTarget[] {
+  const parents = new Set(
+    records
+      .filter(record => record.parent_session_id)
+      .map(record => `${record.gateway}\u0000${profileOf(record.profile)}\u0000${record.parent_session_id}`)
+  )
+
+  const byGateway = new Map<string, HubSessionRecord[]>()
+
+  for (const record of records) {
+    if (!record?.id || !record.gateway || record.archived || record.hidden) {
+      continue
+    }
+
+    if (parents.has(`${record.gateway}\u0000${profileOf(record.profile)}\u0000${record.id}`)) {
+      continue
+    }
+
+    byGateway.set(record.gateway, [...(byGateway.get(record.gateway) ?? []), record])
+  }
+
+  const activityOf = (record: HubSessionRecord) => Number(record.activity ?? record.started_at ?? 0)
+  const targets: PrefetchTarget[] = []
+
+  for (const [gateway, list] of byGateway) {
+    const connectionId = connectionForGateway(gateway)
+
+    if (!connectionId) {
+      continue
+    }
+
+    // People's chats claim the slots first: a gateway running many automations
+    // (Kanban, cron) would otherwise push the chats someone opens out of the window.
+    const byActivity = [...list].sort((a, b) => activityOf(b) - activityOf(a))
+    const chosen = [...byActivity.filter(record => !record.automated), ...byActivity.filter(record => record.automated)]
+
+    for (const record of chosen.slice(0, perGateway)) {
+      targets.push({
+        automated: Boolean(record.automated),
+        key: { connectionId, profile: profileOf(record.profile), sessionId: record.id },
+        meta: { activity: record.activity ?? null, messageCount: record.message_count ?? null }
+      })
+    }
+  }
+
+  return targets.sort((a, b) => Number(a.automated) - Number(b.automated) || (b.meta.activity ?? 0) - (a.meta.activity ?? 0))
+}
+
+/** Whether a cached entry is behind the hub's view of the session. */
+export function needsRefresh(
+  cached: { activity: null | number; messageCount: null | number; savedAt: number } | null,
+  target: PrefetchTarget,
+  now: number
+): boolean {
+  if (!cached) {
+    return true
+  }
+
+  const moved = cached.activity !== target.meta.activity || cached.messageCount !== target.meta.messageCount
+
+  return moved && now - cached.savedAt >= MIN_REFETCH_MS
+}
+
+export class TranscriptPrefetcher {
+  private readonly deps: PrefetchDeps
+  private readonly downUntil = new Map<string, number>()
+  private running: null | Promise<PrefetchTickResult> = null
+  private timer: null | ReturnType<typeof setTimeout> = null
+  private stopped = true
+
+  constructor(deps: PrefetchDeps) {
+    this.deps = deps
+  }
+
+  /** One pass; concurrent calls share the pass in flight. */
+  tick(): Promise<PrefetchTickResult> {
+    if (!this.running) {
+      this.running = this.pass().finally(() => {
+        this.running = null
+      })
+    }
+
+    return this.running
+  }
+
+  start(intervalMs = 5_000): void {
+    if (!this.stopped) {
+      return
+    }
+
+    this.stopped = false
+
+    const loop = async () => {
+      try {
+        await this.tick()
+      } catch (error) {
+        this.deps.log?.(`transcript prefetch tick failed: ${(error as Error)?.message || error}`)
+      }
+
+      if (!this.stopped) {
+        this.timer = setTimeout(loop, intervalMs)
+        this.timer.unref?.()
+      }
+    }
+
+    void loop()
+  }
+
+  stop(): void {
+    this.stopped = true
+
+    if (this.timer) {
+      clearTimeout(this.timer)
+      this.timer = null
+    }
+  }
+
+  private async pass(): Promise<PrefetchTickResult> {
+    const now = this.deps.now?.() ?? Date.now()
+    const result: PrefetchTickResult = { failed: 0, fetched: 0, skipped: 0, targets: 0 }
+    const records = await this.deps.listHubSessions()
+
+    if (!records) {
+      return result
+    }
+
+    const names = new Map<string, string | undefined>()
+
+    for (const gateway of new Set(records.map(record => record.gateway))) {
+      try {
+        names.set(gateway, await this.deps.connectionForGateway(gateway))
+      } catch {
+        names.set(gateway, undefined)
+      }
+    }
+
+    const targets = selectPrefetchTargets(records, gateway => names.get(gateway))
+    result.targets = targets.length
+
+    const due = targets.filter(target => needsRefresh(this.deps.store.meta(target.key), target, now))
+    result.skipped = targets.length - due.length
+
+    // Two fetches per gateway at a time: one slow SSH route never stalls the rest.
+    const queues = new Map<string, PrefetchTarget[]>()
+
+    for (const target of due) {
+      queues.set(target.key.connectionId, [...(queues.get(target.key.connectionId) ?? []), target])
+    }
+
+    await Promise.all(
+      [...queues].map(async ([connectionId, queue]) => {
+        const worker = async () => {
+          while (queue.length > 0) {
+            if ((this.downUntil.get(connectionId) ?? 0) > (this.deps.now?.() ?? Date.now())) {
+              result.skipped += queue.length
+              queue.length = 0
+
+              return
+            }
+
+            const target = queue.shift()!
+
+            try {
+              const rows = await this.deps.fetchLatest(target.key, LATEST_ROWS)
+
+              if (rows.length > 0 && this.deps.store.putLatest(target.key, rows, target.meta)) {
+                result.fetched += 1
+              } else {
+                result.skipped += 1
+              }
+            } catch (error) {
+              result.failed += 1
+
+              if (isGatewayFailure(error)) {
+                this.downUntil.set(connectionId, (this.deps.now?.() ?? Date.now()) + GATEWAY_BACKOFF_MS)
+                this.deps.log?.(
+                  `transcript prefetch: ${connectionId} unreachable (${(error as Error)?.message || error}); backing off`
+                )
+              }
+            }
+          }
+        }
+
+        await Promise.all([worker(), worker()])
+      })
+    )
+
+    if (result.fetched || result.failed) {
+      this.deps.log?.(
+        `transcript prefetch: ${result.fetched} fetched, ${result.failed} failed, ${result.skipped} current of ${result.targets}`
+      )
+    }
+
+    return result
+  }
+}
+
+export interface PrefetchTickResult {
+  failed: number
+  fetched: number
+  skipped: number
+  targets: number
+}
+
+/** A 404 is one missing session; anything without an HTTP status is the route itself. */
+function isGatewayFailure(error: unknown): boolean {
+  const status = Number((error as { status?: unknown; statusCode?: unknown })?.status ?? (error as any)?.statusCode)
+
+  return !(status >= 400 && status < 500)
+}
