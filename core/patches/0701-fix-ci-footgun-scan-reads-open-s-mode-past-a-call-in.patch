From 7137506242b89bb105d04827c0355eb42952accc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 02:41:37 -0700
Subject: [PATCH] fix(ci): footgun scan reads open()'s mode past a call in the
 path; skew-exit reads utf-8-sig

Release CI run 40658112864 failed "Windows footguns (blocking)"; latest main
showed 2 hits:
- hermes_cli/web_server.py:466 `open(os.path.join(sys.prefix, "pyvenv.cfg"), "rb")`
  is binary. The rule's path matcher `[^,)]+` stopped at the comma inside
  os.path.join(...), never saw "rb", and called it text mode. The matcher
  now spans one paren level.
- hermes_cli/web_server_skew_exit.py:94 read JSON as utf-8 (BOM-intolerant);
  now utf-8-sig.

Five whys: red because 8e6534e7ad/4dbfb50490 added these lines and were
pushed without `scripts/check-windows-footguns.py --all` (the pre-commit
hook runs ruff only); the false positive was a regex that could not see
past a nested call. Test: tests/scripts/test_footgun_open_nested_path.py
(2 of its 6 cases fail on the old regex).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 scripts/check-windows-footguns.py             |  3 +-
 .../scripts/test_footgun_open_nested_path.py  | 37 +++++++++++++++++++
 2 files changed, 39 insertions(+), 1 deletion(-)
 create mode 100644 tests/scripts/test_footgun_open_nested_path.py

diff --git a/scripts/check-windows-footguns.py b/scripts/check-windows-footguns.py
index c5eb14ff0d..78526b546f 100644
--- a/scripts/check-windows-footguns.py
+++ b/scripts/check-windows-footguns.py
@@ -208,7 +208,8 @@ FOOTGUNS: list[Footgun] = [
         # explicit builtins-style open() call.  Path.open() is rare in the
         # codebase compared to open() and can be audited separately.
         pattern=re.compile(
-            r"""(?:^|[\s\(,;=])(?<![.\w])open\s*\(\s*[^,)]+\s*(?:,\s*['"](?P<mode>[^'"]*)['"])?"""
+            # The path may itself be a call (open(os.path.join(a, b), "rb")): one paren level.
+            r"""(?:^|[\s\(,;=])(?<![.\w])open\s*\(\s*(?:[^,()]|\([^()]*\))+\s*(?:,\s*['"](?P<mode>[^'"]*)['"])?"""
         ),
         message=(
             "open() without an explicit encoding= uses the platform default "
diff --git a/tests/scripts/test_footgun_open_nested_path.py b/tests/scripts/test_footgun_open_nested_path.py
new file mode 100644
index 0000000000..0848bed0a9
--- /dev/null
+++ b/tests/scripts/test_footgun_open_nested_path.py
@@ -0,0 +1,37 @@
+"""The ``open() without encoding= on text mode`` rule reads the mode past a call in the path.
+
+``open(os.path.join(sys.prefix, "pyvenv.cfg"), "rb")`` failed CI's Windows footgun scan: the
+path matcher stopped at the comma inside ``os.path.join(...)``, never saw ``"rb"``, and called it
+text mode.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from tests.scripts.test_footgun_subprocess_encoding import _load_linter_module, _scan_line
+
+RULE_NAME = "open() without encoding= on text mode"
+
+
+@pytest.fixture(scope="module")
+def linter():
+    return _load_linter_module()
+
+
+@pytest.mark.parametrize("line", [
+    'with open(os.path.join(sys.prefix, "pyvenv.cfg"), "rb") as fh:',
+    'data = open(Path(a, b), "wb")',
+    'with open(os.path.join(root, name), encoding="utf-8") as fh:',
+])
+def test_binary_or_encoded_open_with_a_call_in_the_path_is_not_flagged(linter, line):
+    assert not _scan_line(linter, line, RULE_NAME)
+
+
+@pytest.mark.parametrize("line", [
+    'with open(os.path.join(root, name)) as fh:',
+    'with open(os.path.join(root, name), "r") as fh:',
+    'with open(path, "w") as fh:',
+])
+def test_text_open_is_still_flagged(linter, line):
+    assert _scan_line(linter, line, RULE_NAME)
-- 
