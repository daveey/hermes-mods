From 67afe419971cfc288e1a5b135992d8e94a331515 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 22:17:02 -0800
Subject: [PATCH] fix(kanban-sync): a board older than the failure-counter
 rename is not schema-ahead [daveey]

e4b3ebe805's guard refuses to sync a board that holds columns this core neither
syncs nor keeps local, reading them as a newer core's migration. The
failure-counter rename (#20410) is ADD-first (kanban_db_connect.
_RENAMED_TASK_COLUMNS): it adds consecutive_failures / last_failure_error, fills
them from spawn_failures / last_spawn_error and keeps those. Every board older
than the rename still holds them, so the MacBook gateway, on the current core,
logged at boot (2026-11-02 20:47 PT)

  kanban sync: not starting: board default: this core does not declare columns
  a newer core added (tasks: last_spawn_error, spawn_failures)

and gave the sync role up. Its outbox stopped pushing (42 ops), cards created
there never reached the Board, and the dispatcher's lease claims came back
not_found (0 workers spawned while 6 cards were ready).

kanban_db_sync.RETIRED_COLUMNS declares the two legacy columns, and
undeclared_columns counts them as known. They still never travel (_wire_fields),
and a column a newer core adds still refuses.

Tests (test_kanban_sync_schema_guard.py, on a board created with the pre-rename
schema and migrated by connect()):
- it is not schema-ahead;
- push() delivers a card, without the retired columns;
- run_forever starts and pushes (the entry path the MacBook refused at);
- a newer core's column on such a board still refuses;
- every rename source column in _RENAMED_TASK_COLUMNS is declared retired.
All 5 fail on the old guard; 11/11 pass on macOS and on Linux.
---
 hermes_cli/kanban_db_sync.py                  |  10 +-
 .../test_kanban_sync_schema_guard.py          | 101 ++++++++++++++++++
 2 files changed, 109 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_db_sync.py b/hermes_cli/kanban_db_sync.py
index 99133669900..fb2476e4b26 100644
--- a/hermes_cli/kanban_db_sync.py
+++ b/hermes_cli/kanban_db_sync.py
@@ -97,6 +97,11 @@ LOCAL_COLUMNS: dict[str, frozenset[str]] = {
 # Set by the service, never by a gateway: applied from the feed, never captured.
 # ``ready_since``: when the card last became ready (ms), for the Board's ``home_grace`` placement rule.
 SERVER_COLUMNS: dict[str, frozenset[str]] = {"tasks": frozenset({"created_on", "ready_since"})}
+# Old columns an ADD-first rename migration keeps (``kanban_db_connect._RENAMED_TASK_COLUMNS``: the new column is
+# added and filled from the old one, which stays). Every board older than the rename holds them; only
+# ``Task.from_row``'s pre-migration fallbacks read them, and they never travel. Known, so the schema-ahead guard
+# (``undeclared_columns``) does not read an OLDER schema's leftovers as a newer core's columns. [daveey]
+RETIRED_COLUMNS: dict[str, frozenset[str]] = {"tasks": frozenset({"spawn_failures", "last_spawn_error"})}
 KEY_COLUMNS: dict[str, frozenset[str]] = {
     "tasks": frozenset({"id"}),
     "task_links": frozenset(),
@@ -466,11 +471,12 @@ def captured_columns(conn: sqlite3.Connection, table: str) -> list[str]:
 
 
 def undeclared_columns(conn: sqlite3.Connection) -> dict[str, set[str]]:
-    """Per synced table, columns that are neither synced, local-only nor a key:
+    """Per synced table, columns that are neither synced, local-only, a key nor retired:
     a migration added them and nobody decided whether they leave the gateway."""
     out: dict[str, set[str]] = {}
     for table in SYNCED_TABLES:
-        known = SYNCED_COLUMNS[table] | LOCAL_COLUMNS[table] | KEY_COLUMNS[table] | SERVER_COLUMNS.get(table, frozenset())
+        known = (SYNCED_COLUMNS[table] | LOCAL_COLUMNS[table] | KEY_COLUMNS[table]
+                 | SERVER_COLUMNS.get(table, frozenset()) | RETIRED_COLUMNS.get(table, frozenset()))
         extra = set(table_columns(conn, table)) - known
         if extra:
             out[table] = extra
diff --git a/tests/hermes_cli/test_kanban_sync_schema_guard.py b/tests/hermes_cli/test_kanban_sync_schema_guard.py
index 7751a1e5f31..35e5248b9c1 100644
--- a/tests/hermes_cli/test_kanban_sync_schema_guard.py
+++ b/tests/hermes_cli/test_kanban_sync_schema_guard.py
@@ -14,6 +14,7 @@ The guard: a board whose tables hold a column this core neither syncs nor keeps
 from __future__ import annotations
 
 import json
+import sqlite3
 
 import pytest
 
@@ -129,3 +130,103 @@ def test_run_forever_gives_up_the_sync_role_on_an_older_core(kanban_home, live,
     with caplog.at_level("ERROR", logger=ksc._log.name):
         ksc.run_forever(lambda: next(ticks, None) is not None, sleep=lambda _s: None)
     assert any("placement_policy" in r.getMessage() and r.levelname == "ERROR" for r in caplog.records)
+
+
+# Incident (2026-11-02, MacBook): the guard read the two columns a pre-#20410 core created as "a newer core
+# migrated this board". The rename migration is ADD-first (``kanban_db_connect._RENAMED_TASK_COLUMNS``): it adds
+# ``consecutive_failures`` / ``last_failure_error``, fills them from ``spawn_failures`` / ``last_spawn_error`` and
+# keeps those. So every board older than the rename holds them, and the current core's gateway logged
+# "kanban sync: not starting: board default: ... (tasks: last_spawn_error, spawn_failures)", leaving the MacBook's
+# outbox unpushed and its dispatcher's lease claims "not_found".
+_PRE_RENAME_SCHEMA = """
+CREATE TABLE tasks (
+    id TEXT PRIMARY KEY, title TEXT NOT NULL, body TEXT, assignee TEXT, status TEXT NOT NULL,
+    priority INTEGER DEFAULT 0, created_by TEXT, created_at INTEGER NOT NULL, started_at INTEGER,
+    completed_at INTEGER, workspace_kind TEXT NOT NULL DEFAULT 'scratch', workspace_path TEXT, claim_lock TEXT,
+    claim_expires INTEGER, tenant TEXT, result TEXT, idempotency_key TEXT,
+    spawn_failures INTEGER NOT NULL DEFAULT 0, worker_pid INTEGER, last_spawn_error TEXT
+);
+CREATE TABLE task_events (
+    id INTEGER PRIMARY KEY AUTOINCREMENT, task_id TEXT NOT NULL, kind TEXT NOT NULL, payload TEXT,
+    created_at INTEGER NOT NULL
+);
+"""
+
+
+@pytest.fixture
+def pre_rename_live(kanban_home):
+    """``live`` on a board a pre-#20410 core created, opened (and migrated) by this core."""
+    raw = sqlite3.connect(str(kanban_home / "kanban.db"))
+    raw.executescript(_PRE_RENAME_SCHEMA)
+    raw.close()
+    support.write_sync_config(kanban_home, True)
+    conn = kbc.connect(kanban_home / "kanban.db")
+    ksc.ensure_identity(conn, BOARD, ME)
+    with kbc.write_txn(conn):
+        conn.execute("UPDATE kanban_sync_state SET mode = 'primary'")
+    try:
+        yield conn
+    finally:
+        conn.close()
+
+
+def test_board_migrated_from_before_the_rename_is_not_schema_ahead(pre_rename_live):
+    cols = {r[1] for r in pre_rename_live.execute("PRAGMA table_info(tasks)")}
+    assert {"spawn_failures", "last_spawn_error", "consecutive_failures", "last_failure_error"} <= cols
+    assert ksc.schema_ahead(pre_rename_live) == {}
+
+
+def test_board_migrated_from_before_the_rename_pushes(pre_rename_live, svc):
+    tid = kb.create_task(pre_rename_live, title="Summarize public data", assignee="default")
+    ksc.push(pre_rename_live, svc.hub(ME), BOARD, ME, primary=True)
+    row = _board_row(svc, tid)
+    assert row is not None and row["title"] == "Summarize public data"
+    assert "spawn_failures" not in row and "last_spawn_error" not in row  # retired: never travel
+    assert _pending(pre_rename_live) == 0
+
+
+def test_run_forever_starts_on_a_board_migrated_from_before_the_rename(kanban_home, pre_rename_live, svc,
+                                                                       monkeypatch, caplog):
+    """The entry path the MacBook gateway refused at: run_forever's start check, then a real round."""
+    from hermes_cli import machine_metrics
+
+    hub = svc.hub(ME)
+    monkeypatch.setattr(ksc, "load_identity", lambda: hub.ident)
+    monkeypatch.setattr(ksc, "Hub", lambda ident: hub)
+    monkeypatch.setattr(ksc.sync, "set_lease_client", lambda value: None)  # no process-global lease client leaks
+    monkeypatch.setattr(ksc, "board_paths", lambda: [(BOARD, kanban_home / "kanban.db")])
+    monkeypatch.setattr(ksc, "reconcile_links", lambda *args, **kwargs: None)
+    monkeypatch.setattr(machine_metrics, "Reporter", lambda *args: type("R", (), {"report_due": lambda self: None})())
+    monkeypatch.setattr(hub, "report_metrics", lambda *args: None, raising=False)
+    feeds = []
+
+    class Feed:
+        def __init__(self, ident, slug, *args, **kwargs):
+            feeds.append(slug)
+
+        def run(self):
+            return None
+
+    monkeypatch.setattr(ksc, "FeedWatcher", Feed)
+    running = [True]
+    monkeypatch.setattr(ksc, "wait_for_work", lambda *args: running.__setitem__(0, False))
+    tid = kb.create_task(pre_rename_live, title="x", assignee="default")
+    with caplog.at_level("ERROR", logger=ksc._log.name):
+        ksc.run_forever(lambda: running[0], interval=1)
+    assert [r.getMessage() for r in caplog.records if r.levelname == "ERROR"] == []
+    assert feeds == [BOARD]
+    assert _board_row(svc, tid) is not None
+
+
+def test_retired_columns_do_not_hide_a_newer_cores_column(pre_rename_live):
+    with kbc.write_txn(pre_rename_live):
+        pre_rename_live.execute("ALTER TABLE tasks ADD COLUMN upstream_new_field TEXT")
+    assert ksc.schema_ahead(pre_rename_live) == {"tasks": {"upstream_new_field"}}
+
+
+def test_every_rename_source_column_is_declared_retired():
+    """A rename migration that keeps its old column must declare it retired: otherwise every board older than the
+    rename reads as schema-ahead and its gateway stops syncing."""
+    sources = {src for _new, _ddl, src, _copy in kbc._RENAMED_TASK_COLUMNS if src}
+    assert sources and sources == sync.RETIRED_COLUMNS["tasks"]
+    assert not sync.RETIRED_COLUMNS["tasks"] & (sync.SYNCED_COLUMNS["tasks"] | sync.LOCAL_COLUMNS["tasks"])
-- 
