Subject: [PATCH] test(kanban): reconstruct review sources before pool and age
 controls [daveey]

Retained focused proof: host cap 24 passed; hub and fairness remain seven failures after two bounded iterations. Preserve all original pool, ordering and zero-claim assertions; no broader passing or delivery claim. Further same-group repair requires creator disposition39090.
---
 tests/hermes_cli/hub_admission_support.py     |  6 +++++-
 tests/hermes_cli/test_kanban_fair_dispatch.py | 10 ++++++----
 tests/hermes_cli/test_kanban_hub_admission.py | 12 ++++++++++--
 3 files changed, 21 insertions(+), 7 deletions(-)

diff --git a/tests/hermes_cli/hub_admission_support.py b/tests/hermes_cli/hub_admission_support.py
index 5c3683ca77..cdb1ac46c7 100644
--- a/tests/hermes_cli/hub_admission_support.py
+++ b/tests/hermes_cli/hub_admission_support.py
@@ -28,7 +28,8 @@ def open_board(tmp_path, monkeypatch):
 
 
 def configure(home, limit=50, cap=None):
-    lines = ["kanban:"]
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    lines = [_managed_yaml().rstrip(), "kanban:"]
     if cap is not None:
         lines.append(f"  max_in_progress: {cap}")
     if limit is not None:
@@ -42,6 +43,9 @@ def advisory(home, pct=10.0, age_ms=0):
 
 
 def task(conn, review=False, title="gate"):
+    from tests.hermes_cli.kanban_review_fixture import SOURCE_TITLE, create_review
+    if review and conn.execute("SELECT 1 FROM tasks WHERE title=? AND status='done'", (SOURCE_TITLE,)).fetchone():
+        return create_review(conn, title, "default")
     t = kb.create_task(conn, title=title, assignee="default")
     with kb.write_txn(conn):
         conn.execute("UPDATE tasks SET status=? WHERE id=?", ("review" if review else "ready", t))
diff --git a/tests/hermes_cli/test_kanban_fair_dispatch.py b/tests/hermes_cli/test_kanban_fair_dispatch.py
index a5f065528d..ef179f0d0c 100644
--- a/tests/hermes_cli/test_kanban_fair_dispatch.py
+++ b/tests/hermes_cli/test_kanban_fair_dispatch.py
@@ -17,17 +17,19 @@ def test_one_slot_follows_ready_age_across_lanes(board, monkeypatch, all_assigne
     now = 1_800_000_000
     monkeypatch.setattr(time, "time", lambda: now)
     fixtures.configure(home, limit=None, cap=7)
+    from tests.hermes_cli.kanban_review_fixture import completed_source
+    completed_source(conn)
     if hub:
         fixtures._enable(home)
         fixtures.advisory(home)
         fixtures.locked(monkeypatch, fixtures.fake_sample(10))
     monkeypatch.setattr(dispatch, "_memory_pressure_level", lambda: "normal")
     monkeypatch.setattr(dispatch, "review_dispatch_enabled", lambda: True)
-    older = fixtures.ready(conn, "older", priority=0, created_at=now - 3600)
-    fresh = fixtures.ready(conn, "fresh", priority=1000, created_at=now)
+    older = fixtures.ready(conn, "older", priority=0, created_at=now - 3600, review=older_lane == "review")
+    fresh = fixtures.ready(conn, "fresh", priority=1000, created_at=now, review=older_lane != "review")
     review_id = older if older_lane == "review" else fresh
-    with kb.write_txn(conn):
-        conn.execute("UPDATE tasks SET status='review' WHERE id=?", (review_id,))
+    from hermes_cli.kanban_review_model import implementer_models
+    assert implementer_models(conn, kb.get_task(conn, review_id)) == {"claude-sonnet-5-5"}
     spawned = []
     dispatch.dispatch_once(conn, spawn_fn=lambda candidate, workspace, board=None: spawned.append(candidate.id),
                            max_spawn=1, max_in_progress=7)
diff --git a/tests/hermes_cli/test_kanban_hub_admission.py b/tests/hermes_cli/test_kanban_hub_admission.py
index 9816904377..eb8ea9a229 100644
--- a/tests/hermes_cli/test_kanban_hub_admission.py
+++ b/tests/hermes_cli/test_kanban_hub_admission.py
@@ -371,6 +371,9 @@ def test_dispatch_follows_shared_score_for_marked_and_normal_candidates(
 ):
     from hermes_cli import kanban_db_dispatch as dispatch
     conn, home = board
+    configure(home, limit=None)
+    from tests.hermes_cli.kanban_review_fixture import completed_source
+    completed_source(conn)
     configure(home, cap=7)
     with (home / "config.yaml").open("a") as config:
         config.write("    priority_slots: 3\n")
@@ -454,6 +457,8 @@ def test_dispatch_full_regular_pool_claims_marked_with_shared_memory_budget(
     from hermes_cli import kanban_db_dispatch as dispatch
     conn, home = board
     configure(home, limit=None)
+    from tests.hermes_cli.kanban_review_fixture import completed_source
+    completed_source(conn)
     for index in range(7):
         tid = task(conn, title=f"active {index}")
         assert kb.claim_task(conn, tid)
@@ -515,6 +520,9 @@ def test_full_regular_pool_never_attempts_normal_claims(board, monkeypatch, all_
     from hermes_cli import kanban_db_dispatch as dispatch
     from hermes_cli import kanban_queue_position as kqp
     conn, home = board
+    configure(home, limit=None)
+    from tests.hermes_cli.kanban_review_fixture import completed_source
+    completed_source(conn)
     attempts, spawned, spawn = _saturate(conn, home, monkeypatch, 7)
     normal = [task(conn, review=review, title=f"normal {index}") for index in range(3)]
     result = dispatch.dispatch_once(conn, spawn_fn=spawn, max_spawn=20, max_in_progress=7, reconcile_orphans=False)
@@ -1062,8 +1070,8 @@ def test_claim_inside_the_hold_budget_still_admits(board, monkeypatch):
 
 # --- Phase 2: deterministic admission score over the full replica ---------------------------------------
 
-def ready(conn, title, priority=0, created_at=None, admission_class="normal", failures=0):
-    tid = task(conn, title=title)
+def ready(conn, title, priority=0, created_at=None, admission_class="normal", failures=0, review=False):
+    tid = task(conn, title=title, review=review)
     fields = {"priority": priority}
     if admission_class != "normal":
         fields["admission_class"] = admission_class
