From 8d86c702baa91c320e3f8a4822a465dd00c23dff Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 04:10:50 +0000
Subject: [PATCH] fix: route the fork's config.yaml readers through
 config_backend; ruff RUF100/PIE807 [daveey]

Upstream's check_config_yaml_readers guard (config-backend seam) arrived with the sync and
flags fork readers that open/stat config.yaml directly: prompt_builder global_context_files,
kanban capabilities/assignment routing/db sync, session_listing, process_consumer_health.
---
diff --git a/agent/prompt_builder.py b/agent/prompt_builder.py
index d6d270fd8454297935bfc2cb89a6cdcbcf05353f..3873355bbad348d0360341948d80b12332f73d75 100644
--- a/agent/prompt_builder.py
+++ b/agent/prompt_builder.py
@@ -1758,10 +1758,10 @@ def global_context_file_paths(home_override: Path | None = None) -> list[Path]:
         # A worker bound to an explicit config (ignore_user_config) never reads the profile's file.
         cfg = worker_config_snapshot()
         if cfg is None:
-            from utils import load_yaml_file_readonly
+            from hermes_cli.config_backend import config_exists, read_config_doc_readonly
             home = Path(home_override) if home_override is not None else get_hermes_home()
             cfg_path = home / "config.yaml"
-            cfg = load_yaml_file_readonly(cfg_path) if cfg_path.is_file() else {}
+            cfg = read_config_doc_readonly(cfg_path) if config_exists(cfg_path) else {}
         raw = ((cfg or {}).get("agent") or {}).get("global_context_files") if isinstance(cfg, dict) else None
     except Exception as e:
         logger.debug("Could not read agent.global_context_files: %s", e)
diff --git a/hermes_cli/kanban_assignment_routing.py b/hermes_cli/kanban_assignment_routing.py
index 90ea16f73d8aeeb6ac3187dd28ba7bf89cd5c4f5..e2c8ba9445bdba786a84c1b96ed5b03c19205590 100644
--- a/hermes_cli/kanban_assignment_routing.py
+++ b/hermes_cli/kanban_assignment_routing.py
@@ -71,7 +71,8 @@ def _supervisor(task):
         try:
             # Unconstrained scratch validation intentionally skips profile IO;
             # routing still needs an existing configured profile, never a label.
-            if not (Path(resolve_profile_env(name)) / 'config.yaml').is_file():
+            from hermes_cli.config_backend import config_exists
+            if not config_exists(Path(resolve_profile_env(name)) / 'config.yaml'):
                 continue
             required = validate_assignment(name, requires=[*(task.requires or []), 'kanban'],
                                            workspace_kind=task.workspace_kind,
