From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 09:00:27 +0000
Subject: [PATCH 238/248] batch: pin utf-8 decoding in dispatch-guard gh call
 (#55658 guard)

---
 hermes_cli/kanban_db_dispatch_guard_notice.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_db_dispatch_guard_notice.py b/hermes_cli/kanban_db_dispatch_guard_notice.py
index b95f014f87..ba9bc38b98 100644
--- a/hermes_cli/kanban_db_dispatch_guard_notice.py
+++ b/hermes_cli/kanban_db_dispatch_guard_notice.py
@@ -37,7 +37,7 @@ def _pr_failing_checks(pr_url: str) -> str:
     """Best-effort one-line summary of ``pr_url``'s failing checks ('' if unavailable)."""
     try:
         out = subprocess.run(["gh", "pr", "checks", pr_url], stdin=subprocess.DEVNULL, capture_output=True,
-                             text=True, timeout=30, check=False).stdout
+                             text=True, encoding="utf-8", errors="replace", timeout=30, check=False).stdout
     except (OSError, subprocess.SubprocessError):
         return ""
     failing = [ln.split("\t")[0].strip() for ln in out.splitlines()
