From 3877cafb5ab05e3594cda793c3834fd8a8be0e24 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 05:32:03 -0800
Subject: [PATCH] test(image_gen): catalog-ownership test no longer depends on
 OpenRouter's live model list [daveey]

OpenRouter dropped x-ai/grok-imagine-image-quality from GET /images/models, so
test_catalog_models_are_offered_only_by_openrouter failed on every branch. Stub
the fetch so the test checks the curated tables, not the vendor catalog.
---
 tests/plugins/image_gen/test_openrouter_compat_provider.py | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/tests/plugins/image_gen/test_openrouter_compat_provider.py b/tests/plugins/image_gen/test_openrouter_compat_provider.py
index 12aba98b738..5a933f6ca74 100644
--- a/tests/plugins/image_gen/test_openrouter_compat_provider.py
+++ b/tests/plugins/image_gen/test_openrouter_compat_provider.py
@@ -787,9 +787,12 @@ class TestImageApiSurface:
     def test_catalog_models_are_offered_only_by_openrouter(self):
         from plugins.image_gen.openrouter import _IMAGE_API_MODELS, _build_providers
 
+        # Offline catalog: the live OpenRouter list drifts (models get renamed/dropped), which
+        # made this test fail on every branch whenever the vendor changed its catalog.
         by_name = {p.name: p for p in _build_providers()}
-        openrouter_ids = {m["id"] for m in by_name["openrouter"].list_models()}
-        nous_ids = {m["id"] for m in by_name["nous"].list_models()}
+        with patch("requests.get", side_effect=OSError("offline")):
+            openrouter_ids = {m["id"] for m in by_name["openrouter"].list_models()}
+            nous_ids = {m["id"] for m in by_name["nous"].list_models()}
         assert set(_IMAGE_API_MODELS) <= openrouter_ids
         assert not (set(_IMAGE_API_MODELS) & nous_ids)
 
