From 883b05f36bba64f22cd710771817a3e72f2f9cdc Mon Sep 17 00:00:00 2001
From: x <x@example.com>
Date: Tue, 27 Oct 2026 18:25:08 -0700
Subject: [PATCH] perf(state): cache clean macOS deleted-WAL holder scan and
 single-flight it

---
 hermes_state_dbfile.py                        | 31 +++++++++++++-
 .../test_state_db_darwin_fd_scan_hang.py      | 42 +++++++++++++++++++
 2 files changed, 71 insertions(+), 2 deletions(-)

diff --git a/hermes_state_dbfile.py b/hermes_state_dbfile.py
index 5d19aba9be..bfbb7a16eb 100644
--- a/hermes_state_dbfile.py
+++ b/hermes_state_dbfile.py
@@ -239,6 +239,14 @@ _DARWIN_LIBPROC = None
 # expiry, failing open per the guard's contract.
 _DARWIN_FD_SCAN_TIMEOUT_SECONDS = 5.0
 
+# A clean (no holder) verdict is reused for this long, and only one scan runs at a time. Every
+# SessionDB open used to walk every fd of every process (~5 s of CPU, up to 5 s of abandoned
+# thread each on timeout); a busy Mac opening state.db from dozens of CLI/worker/wake_check
+# processes spent its cores on that. Positive verdicts are never cached.
+_DARWIN_FD_CLEAN_TTL_SECONDS = 30.0
+_darwin_scan_lock = threading.Lock()
+_darwin_clean_until: dict[str, float] = {}
+
 
 def _darwin_libproc():
     """libproc's fd-enumeration entry points, loaded once per process.
@@ -322,6 +330,25 @@ def _iter_darwin_sidecar_holders(db_path) -> list[tuple[int, str]]:
     # APFS/HFS+ are case-insensitive by default and libproc reports the pathname as the opener
     # spelled it; ``os.path.normcase`` is the identity on darwin, so fold case here.
     watched = {path.casefold(): path for path in (base + "-wal", base + "-shm")}
+    now = time.monotonic()
+    if _darwin_clean_until.get(base, 0.0) > now:
+        return []
+    # Single flight: a concurrent scan in this process is waited on (bounded), never duplicated.
+    if not _darwin_scan_lock.acquire(timeout=_DARWIN_FD_SCAN_TIMEOUT_SECONDS):
+        return []  # fail open, as for a scan timeout
+    try:
+        if _darwin_clean_until.get(base, 0.0) > time.monotonic():
+            return []
+        holders, completed = _scan_darwin_sidecar_holders(base, watched, db_path)
+        if completed and not holders:
+            _darwin_clean_until[base] = time.monotonic() + _DARWIN_FD_CLEAN_TTL_SECONDS
+        return holders
+    finally:
+        _darwin_scan_lock.release()
+
+
+def _scan_darwin_sidecar_holders(base, watched, db_path) -> tuple[list[tuple[int, str]], bool]:
+    """One bounded libproc pass; the flag is False when the pass timed out (fail-open, not a verdict)."""
     holders: list[tuple[int, str]] = []
     errors: list[BaseException] = []
 
@@ -346,10 +373,10 @@ def _iter_darwin_sidecar_holders(db_path) -> list[tuple[int, str]]:
             _DARWIN_FD_SCAN_TIMEOUT_SECONDS,
             db_path,
         )
-        return []
+        return [], False
     if errors:
         raise errors[0]
-    return holders
+    return holders, True
 
 
 def iter_deleted_sqlite_sidecar_holders(db_path) -> list[tuple[int, str]]:
diff --git a/tests/hermes_state/test_state_db_darwin_fd_scan_hang.py b/tests/hermes_state/test_state_db_darwin_fd_scan_hang.py
index 0224286e21..99488fdb5c 100644
--- a/tests/hermes_state/test_state_db_darwin_fd_scan_hang.py
+++ b/tests/hermes_state/test_state_db_darwin_fd_scan_hang.py
@@ -30,6 +30,16 @@ from hermes_state_dbfile import (
     _iter_darwin_sidecar_holders,
 )
 
+import pytest
+
+
+@pytest.fixture(autouse=True)
+def _fresh_scan_cache():
+    dbfile._darwin_clean_until.clear()
+    yield
+    dbfile._darwin_clean_until.clear()
+
+
 # Far below the 5s production budget so the suite stays fast; far above zero
 # so scheduling jitter cannot flake it.
 BUDGET = 2.0
@@ -119,3 +129,35 @@ def test_healthy_scan_still_reports_holder(monkeypatch, tmp_path, caplog):
     assert not any(
         "timed out" in record.getMessage() for record in caplog.records
     ), "a successful scan must not log a timeout warning"
+
+
+def test_clean_verdict_is_reused_and_scans_are_single_flight(monkeypatch, tmp_path):
+    """Every SessionDB open used to walk all fds of all processes; a clean pass is now cached."""
+    calls = []
+
+    class _Empty:
+        def proc_pidinfo(self, *a):
+            calls.append(1)
+            return 0
+
+    monkeypatch.setattr(dbfile, "_darwin_libproc", lambda: _Empty())
+    monkeypatch.setattr(dbfile, "_darwin_all_pids", lambda _lib: [4242])
+    db = tmp_path / "state.db"
+    results = []
+    threads = [threading.Thread(target=lambda: results.append(_iter_darwin_sidecar_holders(db)))
+               for _ in range(8)]
+    [t.start() for t in threads]
+    [t.join(HANG_GUARD) for t in threads]
+    assert results == [[]] * 8
+    assert len(calls) == 1, "concurrent/cached opens must share one libproc pass"
+    dbfile._darwin_clean_until.clear()
+    _iter_darwin_sidecar_holders(db)
+    assert len(calls) == 2
+
+
+def test_timed_out_scan_is_not_cached(monkeypatch, tmp_path):
+    monkeypatch.setattr(dbfile, "_darwin_libproc", lambda: _HungLibproc())
+    monkeypatch.setattr(dbfile, "_darwin_all_pids", lambda _lib: [4242])
+    monkeypatch.setattr(dbfile, "_DARWIN_FD_SCAN_TIMEOUT_SECONDS", 0.3)
+    assert _iter_darwin_sidecar_holders(tmp_path / "state.db") == []
+    assert not dbfile._darwin_clean_until
