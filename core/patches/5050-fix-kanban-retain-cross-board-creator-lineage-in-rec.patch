From e2834c029d3991de379bc2299be20542c49ad7c2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 23:05:56 +0000
Subject: [PATCH] fix(kanban): retain cross-board creator lineage in receipts
 [daveey]

Keep creator identity independent of local priority availability. Preserve omitted priority arguments when the creator is absent from the target board; record its identity with unknown effective priority. Existing replica creator-chat test fails on b0c8ae0a6d and passes after; all five absent-creator receipt cases remain alive without invented inheritance.
---
 hermes_cli/kanban_db_creation.py                       | 6 +++++-
 tests/tools/test_kanban_create_priority_inheritance.py | 6 ++++--
 tools/kanban_tools.py                                  | 5 +++--
 3 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_db_creation.py b/hermes_cli/kanban_db_creation.py
index 0ee8856c8c..b57fbfd437 100644
--- a/hermes_cli/kanban_db_creation.py
+++ b/hermes_cli/kanban_db_creation.py
@@ -42,10 +42,14 @@ def tool_creation_audit(args: dict, *, admission=None, **effective) -> dict | No
     return audit
 
 
-def inherit_tool_priority(conn, args, creator_task_id, *, receipt=None):
+def inherit_tool_priority(conn, args, creator_task_id, *, receipt=None, creator_present=True):
     """Resolve omitted worker urgency before placement/courier serialization."""
     from hermes_cli.kanban_fairness_creation import observe_intent
 
+    if not creator_present:
+        # Preserve cross-board lineage without inventing a local priority snapshot.
+        observe_intent(conn, args, creator_task_id, receipt, effective={})
+        return args
     if creator_task_id is None or args.get("priority") is not None:
         observe_intent(conn, args, creator_task_id, receipt)
         return args
diff --git a/tests/tools/test_kanban_create_priority_inheritance.py b/tests/tools/test_kanban_create_priority_inheritance.py
index 3921c8f85b..1b68e4c388 100644
--- a/tests/tools/test_kanban_create_priority_inheritance.py
+++ b/tests/tools/test_kanban_create_priority_inheritance.py
@@ -38,9 +38,11 @@ def test_capture_keeps_original_tool_intent(home, monkeypatch, argument, intent,
             records = [json.loads(row[5]) for row in journal.rows(conn) if row[1] == 'creation']
         assert not session.abandoned.is_set()
         assert len(records) == 1
-        assert records[0]['creator_task_uid'] == (creator if creator_present else None)
+        assert records[0]['creator_task_uid'] == creator
         if not creator_present:
-            assert 'creator_task_uid' in records[0]['unknown_fields']
+            assert 'creator_task_uid' not in records[0]['unknown_fields']
+            assert records[0]['effective_parent_priority'] is None
+            assert 'effective_parent_priority' in records[0]['unknown_fields']
             if argument in ('omitted', None):
                 expected = 0
         assert records[0]['priority_intent'] == intent
diff --git a/tools/kanban_tools.py b/tools/kanban_tools.py
index 8f5bc138c9..170d3db5ef 100644
--- a/tools/kanban_tools.py
+++ b/tools/kanban_tools.py
@@ -1586,7 +1586,8 @@ def _handle_create(args: dict, **kw) -> str:
                     if courier_intent is None and _is_dispatcher_owned_worker() else None)
         self_task = kb.get_task(conn, self_tid) if self_tid else None
         creation_receipt = {} if courier_intent is None else None
-        args = inherit_tool_priority(conn, args, self_tid if self_task is not None else None, receipt=creation_receipt)
+        args = inherit_tool_priority(conn, args, self_tid, receipt=creation_receipt,
+                                     creator_present=self_task is not None)
         session_id = _create_session_id(args, courier_intent, self_task)
         project_id, project_source_task_id = _ca.inherited_project(project_id, workspace_kind, workspace_path, self_task)
         marker_placement, place_origin = None, {"session_id": session_id}
@@ -1649,7 +1650,7 @@ def _handle_create(args: dict, **kw) -> str:
                 # session's current board.
                 board=args.get("board"),
                 project_source_task_id=project_source_task_id, triage=triage,
-                creator_task_id=self_tid if self_task is not None else None,
+                creator_task_id=self_tid,
                 idempotency_key=args.get("idempotency_key"),
                 max_runtime_seconds=_opt_int(args.get("max_runtime_seconds")), skills=skills,
                 requires=_effective_requires(marker_placement, args),
-- 
