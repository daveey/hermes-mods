From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 11:41:20 +0000
Subject: [PATCH] [daveey] Align unplaceable show contract with card-id queue
 receipt

---
 tests/tools/test_kanban_show_queue.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/tools/test_kanban_show_queue.py b/tests/tools/test_kanban_show_queue.py
index 20a765bc50..b84a19b880 100644
--- a/tests/tools/test_kanban_show_queue.py
+++ b/tests/tools/test_kanban_show_queue.py
@@ -137,7 +137,7 @@ def test_runs_on_no_machine_carries_reads_unplaceable(home, monkeypatch, capsys)
     tid = _card("PR831 land", runs_on=["hermes-hub"])
     _registry(monkeypatch, {"hub": ["linux"], "worker-1": ["linux"]})
     want = {"lane": "unplaceable", "runs_on": ["hermes-hub"], "missing": ["hermes-hub"],
-            "machines": ["hub", "worker-1"]}
+            "machines": ["hub", "worker-1"], "task_id": tid}
     out = _tool(tid)
     assert out.get("queue") == want
     assert "no machine" in (out.get("queue_note") or "") and "hermes-hub" in out["queue_note"]
