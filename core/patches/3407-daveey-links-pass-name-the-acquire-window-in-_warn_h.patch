From 7491dbd74759d81f3add0f2fdb5eb5bc3704d240 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:43:43 +0000
Subject: [PATCH] [daveey] links pass: name the acquire window in
 _warn_held_elsewhere; _clock patch fails loudly

Follow-up to PR #2091 review nits (review 5889536505, card t_01a1d47ba3d84e5d):

1. The _warn_held_elsewhere comment said _HOLD is None only in the release
   window. It is also None in the acquire window (between `with _PASS_LOCK:`
   and the _HOLD assignment). The comment now names both; a refusal there
   stays quiet, which is harmless.
2. test_a_hold_past_the_threshold_warns_again_naming_its_duration patched
   _clock with raising=False only so it stayed red on the pre-#2091 base.
   The seam is on main now, so drop raising=False: a rename of _clock fails
   the test loudly instead of silently patching nothing.

Comment/test only. Proof: tests/hermes_cli/test_kanban_sync_links_thread.py
passes; scripts/check --base origin/main ok (19 checks).
---
 hermes_cli/kanban_sync_links_pass.py              | 4 +++-
 tests/hermes_cli/test_kanban_sync_links_thread.py | 2 +-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_sync_links_pass.py b/hermes_cli/kanban_sync_links_pass.py
index 1a777c9abe..ce3274a337 100644
--- a/hermes_cli/kanban_sync_links_pass.py
+++ b/hermes_cli/kanban_sync_links_pass.py
@@ -70,7 +70,9 @@ class LinksPass:
     @staticmethod
     def _warn_held_elsewhere() -> None:
         # The holder is never this runner: its own pass keeps ``_idle`` clear, so ``request`` returns before here,
-        # and ``_pass`` clears ``_HOLD`` before releasing the lock. ``_HOLD`` is None only in that release window.
+        # and ``_pass`` clears ``_HOLD`` before releasing the lock. While another runner holds the lock, ``_HOLD`` is
+        # None only between acquiring the lock and setting ``_HOLD``, and between clearing it and releasing the lock;
+        # a refusal in either window stays quiet, which is harmless because the next request warns.
         global _WARNED
         hold, warned, now = _HOLD, _WARNED, _clock()
         if hold is None:
diff --git a/tests/hermes_cli/test_kanban_sync_links_thread.py b/tests/hermes_cli/test_kanban_sync_links_thread.py
index a8f3816492..dbf05ac755 100644
--- a/tests/hermes_cli/test_kanban_sync_links_thread.py
+++ b/tests/hermes_cli/test_kanban_sync_links_thread.py
@@ -231,7 +231,7 @@ def test_a_hold_past_the_threshold_warns_again_naming_its_duration(monkeypatch,
     again, naming how long it has held the lock, then at most once per interval (review nit on PR #2073)."""
     from hermes_cli import kanban_sync_links_pass as lp
     now = {"t": 1000.0}
-    monkeypatch.setattr(lp, "_clock", lambda: now["t"], raising=False)  # base has no seam: the real clock barely moves
+    monkeypatch.setattr(lp, "_clock", lambda: now["t"])  # the real clock barely moves
     held, refused = _HeldPass(monkeypatch), lp.LinksPass("refused")
     boards = [("default", Path("/nonexistent/kanban.db"))]
     try:
