From 546f0e0a0ade876476c393724ef82e6ccc2f35a9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 15:13:53 +0000
Subject: [PATCH] test(owned-subprocs): cleanup tolerates a tree process that
 exits before its kill [daveey]

test_a_sigkilled_owner_takes_its_child_tree_and_spares_a_live_owners[tts-command] failed once on
CI (run 43237424519) in its finally block, after every assertion had passed: `_alive(identity)`
read the process as present, then a fresh `psutil.Process(pid)` found it already reaped and raised
NoSuchProcess. The exception also skipped killing the owners, leaking the live owner's tree.

The cleanup now kills through one Process object, checks the recorded create time, and treats a
process that vanished first as already cleaned up. `_alive` also counts psutil's STATUS_DEAD
("X", mid-reap) as gone, like a zombie, so a slow reaper cannot flip a dead tree back to alive.

Repro: a harness that runs the real test and injects the exit between the check and the kill
fails on the old file (NoSuchProcess, owners leaked) and passes on the new one; the file passes
under a SIGSTOP/SIGCONT duty cycle (8/8).
---
 tests/hermes_cli/test_owned_agent_subprocs.py | 20 +++++++++++++++----
 1 file changed, 16 insertions(+), 4 deletions(-)

diff --git a/tests/hermes_cli/test_owned_agent_subprocs.py b/tests/hermes_cli/test_owned_agent_subprocs.py
index 653d28b24c..5efb0541a6 100644
--- a/tests/hermes_cli/test_owned_agent_subprocs.py
+++ b/tests/hermes_cli/test_owned_agent_subprocs.py
@@ -115,15 +115,28 @@ def _read(path: Path) -> dict:
     return json.loads(path.read_text(encoding="utf-8-sig"))
 
 
+# A killed orphan lingers as a zombie until init reaps it, and reads as ``X (dead)`` while the reap
+# is under way, so neither state is alive; a starved reaper can sit in that window for a while.
+_GONE = frozenset({psutil.STATUS_ZOMBIE, psutil.STATUS_DEAD})
+
+
 def _alive(identity: dict) -> bool:
-    """Zombie-aware: a killed orphan lingers as a zombie until init reaps it."""
     try:
         proc = psutil.Process(identity["pid"])
-        return proc.create_time() == identity["created"] and proc.status() != psutil.STATUS_ZOMBIE
+        return proc.create_time() == identity["created"] and proc.status() not in _GONE
     except psutil.NoSuchProcess:
         return False
 
 
+def _kill(identity: dict) -> None:
+    """Cleanup: SIGKILL the recorded process if it is still that process. It can finish exiting (and
+    be reaped) between any check and the kill, so a vanished process is already the wanted outcome."""
+    with contextlib.suppress(psutil.NoSuchProcess):
+        proc = psutil.Process(identity["pid"])
+        if proc.create_time() == identity["created"]:
+            proc.kill()
+
+
 def _start_owner(tmp_path: Path, name: str, site: str) -> tuple[subprocess.Popen, Path]:
     out = tmp_path / name
     out.mkdir()
@@ -161,8 +174,7 @@ def test_a_sigkilled_owner_takes_its_child_tree_and_spares_a_live_owners(tmp_pat
     finally:
         for tree in ids.values():
             for identity in tree.values():
-                if _alive(identity):
-                    psutil.Process(identity["pid"]).kill()
+                _kill(identity)
         for owner in owners.values():
             if owner.poll() is None:
                 owner.kill()
