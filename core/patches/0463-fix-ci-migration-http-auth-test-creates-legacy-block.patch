From e99a18feca4fc4f8cac63e4e80c931179ef9776c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 08:34:08 +0000
Subject: [PATCH] fix(ci): migration http-auth test creates legacy blocked card
 with lint_blocked=False

---
 tests/hermes_cli/test_kanban_migration_http_auth.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_migration_http_auth.py b/tests/hermes_cli/test_kanban_migration_http_auth.py
index e4ebfaaecf..963b474c96 100644
--- a/tests/hermes_cli/test_kanban_migration_http_auth.py
+++ b/tests/hermes_cli/test_kanban_migration_http_auth.py
@@ -46,7 +46,7 @@ def test_migration_http_boundary(monkeypatch, surface, mode, credential):
     app.middleware("http")(middleware.gated_auth_middleware)
     app.middleware("http")(token_auth.token_auth_middleware)
     with connect_closing() as conn:
-        tid = db.create_task(conn, title="Legacy", assignee="owner", initial_status="blocked")
+        tid = db.create_task(conn, title="Legacy", assignee="owner", initial_status="blocked", lint_blocked=False)
     path = f"{PREFIX}/tasks/{tid}" if surface == "patch" else f"{PREFIX}/tasks/bulk"
     if credential == "service":
         monkeypatch.setattr(token_auth, "_token_routes", {path})
-- 
