From e4ee75b2bb09ee0d2c5d11e210ab9b46c3a5407a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:28:38 +0000
Subject: [PATCH] [daveey] ci: decode review artifacts portably

---
 scripts/ci/live_comment.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/scripts/ci/live_comment.py b/scripts/ci/live_comment.py
index 6b719fd25ff..b2a55c26b07 100644
--- a/scripts/ci/live_comment.py
+++ b/scripts/ci/live_comment.py
@@ -508,7 +508,7 @@ def fetch_all_review_statuses(
                 raise RuntimeError("review-status artifact download failed")
             continue
         if strict:
-            content = status_file.read_text().strip().removeprefix("review_status=")
+            content = status_file.read_text(encoding="utf-8-sig").strip().removeprefix("review_status=")
             statuses = json.loads(content)
             if not isinstance(statuses, list) or not all(isinstance(s, dict) for s in statuses):
                 raise ValueError("invalid review-status artifact")
