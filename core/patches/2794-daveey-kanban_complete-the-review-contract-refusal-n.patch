From ad4c73fc7b15a1b5f6419faa7e917846b984966d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 15:10:29 +0000
Subject: [PATCH] [daveey] kanban_complete: the review-contract refusal names
 its cause on the core-pull path

refusal() opened with "this card states the ship review contract" on both gate paths. On the
names_core_pull path (PR #1507) the body never stated it (PR1462's brief asked for `pr`), so the
wording was wrong there. That path now opens with "this card reviews a core-fork pull (<url>)",
naming the first core-fork pull in the body (new core_pull helper; names_core_pull wraps it). The
rest of the text, which names reviewed_pr, is unchanged.

Proof: tests/tools/test_kanban_review_contract.py 71/0 (plus test_kanban_tools.py, 156/0 together).
With #1507's module swapped in, exactly the two new tests fail (2/69).
---
 hermes_cli/kanban_review_contract.py       | 20 ++++++++++++++++----
 tests/tools/test_kanban_review_contract.py | 19 +++++++++++++++++++
 2 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_review_contract.py b/hermes_cli/kanban_review_contract.py
index 4d61907c42..a05aa29f45 100644
--- a/hermes_cli/kanban_review_contract.py
+++ b/hermes_cli/kanban_review_contract.py
@@ -52,9 +52,17 @@ def states_contract(body: Optional[str]) -> bool:
     return any(m.group("repo").lower() in CORE_REPOS for m in _PULL.finditer(text))
 
 
+def core_pull(body: Optional[str]) -> Optional[str]:
+    """The first core-fork pull request URL ``body`` names, else None."""
+    for m in _PULL.finditer(body or ""):
+        if m.group("repo").lower() in CORE_REPOS:
+            return "https://" + m.group(0)
+    return None
+
+
 def names_core_pull(body: Optional[str]) -> bool:
     """True when ``body`` names a pull request of the core fork: the cards whose review ship lands from."""
-    return any(m.group("repo").lower() in CORE_REPOS for m in _PULL.finditer(body or ""))
+    return core_pull(body) is not None
 
 
 def is_review_result(metadata: Any) -> bool:
@@ -90,15 +98,19 @@ def refusal(body: Optional[str], metadata: Any) -> Optional[str]:
     """The refusal text for a review result on a core-fork pull card that ship cannot read, else None."""
     if not is_review_result(metadata):
         return None
-    if not states_contract(body):
+    if states_contract(body):
+        cause = "this card states the ship review contract"
+    else:
         # The body does not spell the contract out: a core-fork pull card still gates a review that carries a
         # verdict (PR1462's brief asked for `pr`); a verdictless landing/cleanup handoff is not a review.
-        if not names_core_pull(body) or not any(key in metadata for key in _VERDICT_KEYS):
+        pull = core_pull(body)
+        if pull is None or not any(key in metadata for key in _VERDICT_KEYS):
             return None
+        cause = f"this card reviews a core-fork pull ({pull})"
     found = problems(metadata)
     if not found:
         return None
-    return ("kanban_complete refused: this card states the ship review contract, and `hermes-core-wt ship "
+    return (f"kanban_complete refused: {cause}, and `hermes-core-wt ship "
             "--review-task` reads only metadata.verdict, metadata.reviewed_sha and metadata.reviewed_pr. "
             + "; ".join(found) + ". Nothing changed: retry kanban_complete with the same summary and metadata "
             "that also carries {\"verdict\": \"approve\" | \"request_changes\", \"reviewed_sha\": \"<40-hex head>\", "
diff --git a/tests/tools/test_kanban_review_contract.py b/tests/tools/test_kanban_review_contract.py
index 31febc5d54..c57d29bdcb 100644
--- a/tests/tools/test_kanban_review_contract.py
+++ b/tests/tools/test_kanban_review_contract.py
@@ -212,6 +212,25 @@ def test_body_asking_for_pr_key_is_still_gated():  # T1: fails on 2e870e8f71
     assert [p.split(":")[0] for p in krc.problems(PR_KEY_MD)] == ["reviewed_pr"]
 
 
+def test_refusal_names_its_cause_on_each_path():
+    # Contract path: the body spells the keys out.
+    msg = krc.refusal(SHIP_BODY, {"review_verdict": "approve", "reviewed_sha": SHA, "reviewed_pr": PR}) or ""
+    assert msg.startswith("kanban_complete refused: this card states the ship review contract, ")
+    assert "core-fork pull" not in msg and "metadata.verdict" in msg
+    # names_core_pull path: the body asked for `pr`, so it never stated the contract; name the pull instead.
+    msg = krc.refusal(PR_KEY_BODY, dict(PR_KEY_MD)) or ""
+    assert msg.startswith(f"kanban_complete refused: this card reviews a core-fork pull ({PR_KEY_PULL}), ")
+    assert "states the ship review contract" not in msg and "metadata.reviewed_pr" in msg
+
+
+def test_core_pull_is_the_first_core_fork_pull():
+    other = "https://github.com/me/myapp/pull/3730"
+    body = f"see {other} and github.com/Daveey/Hermes/pull/7, then {PR_KEY_PULL}"
+    assert krc.core_pull(body) == "https://github.com/Daveey/Hermes/pull/7"
+    assert krc.core_pull(f"see {other}") is None
+    assert krc.core_pull(None) is None
+
+
 def test_body_asking_for_pr_key_accepts_reviewed_pr():  # T2
     assert krc.refusal(PR_KEY_BODY, {**PR_KEY_MD, "reviewed_pr": PR_KEY_PULL}) is None
 
