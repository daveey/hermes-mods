From 998234cb3e68544f5a7c5869b8592208ed3f420e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 06:42:27 -0700
Subject: [PATCH] test: isolate kanban_db_dispatch._live_worker_procs per test
 (deflake '_FakePopen' has no attribute 'poll')

_default_spawn parks Popen handles in a module-global registry that
reap_worker_zombies() polls. Tests that patch subprocess.Popen with a
minimal fake leaked it there, so a later dispatch test in the same
process crashed in reap_worker_zombies (CI run 40676146435, flaky).
An autouse root-conftest fixture now empties the registry before each
test and restores it after, covering every current and future fake.

Repro: test_dispatcher_spawn_injects_kanban_paths_without_stale_session
then test_dispatch_max_in_progress_blocks_review_when_at_limit: RED before, GREEN after.
---
 tests/conftest.py | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/tests/conftest.py b/tests/conftest.py
index 0a146c28a9..10600e51fd 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -471,6 +471,27 @@ def _reset_foreground_exit_fence():
         base._exit_fenced = False
 
 
+@pytest.fixture(autouse=True)
+def _isolate_kanban_live_worker_procs():
+    """Give every test an empty ``kanban_db_dispatch._live_worker_procs`` and drop what it parked.
+
+    ``_default_spawn`` parks each ``subprocess.Popen`` handle in that module-global registry and
+    ``reap_worker_zombies`` later calls ``.poll()`` on every entry. A test that monkeypatches
+    ``subprocess.Popen`` with a minimal fake (no ``poll``) leaked the fake into the registry, so a
+    later dispatch test in the same process died with ``'_FakePopen' object has no attribute
+    'poll'`` (order-dependent CI flake). Clearing here covers every current and future fake.
+    """
+    mod = sys.modules.get("hermes_cli.kanban_db_dispatch")
+    saved = dict(mod._live_worker_procs) if mod is not None else {}
+    if mod is not None:
+        mod._live_worker_procs.clear()
+    yield
+    mod = sys.modules.get("hermes_cli.kanban_db_dispatch")
+    if mod is not None:
+        mod._live_worker_procs.clear()
+        mod._live_worker_procs.update(saved)
+
+
 @pytest.fixture(autouse=True)
 def _neutralize_kanban_memory_guard(request, monkeypatch):
     """Pin the kanban dispatcher's memory guard to "no data" for every test.
