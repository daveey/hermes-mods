--- a/hermes_cli/active_sessions.py
+++ b/hermes_cli/active_sessions.py
@@ -563,7 +563,11 @@ def try_acquire_active_session(
             logger.info("Pruned %d stale active session lease(s)", pruned)
 
         def refuse(message: str, reason: str, log: str, *args) -> tuple[None, ActiveSessionRefusal]:
-            _write_entries(state_path, entries)  # persist the prune even when refusing
+            # Persist a prune even when refusing, but never rewrite an unchanged
+            # registry: each write fsyncs under the exclusive lock, so a no-op write
+            # per refusal serializes every contender behind the disk.
+            if pruned:
+                _write_entries(state_path, entries)
             logger.info(log, *args)
             return None, ActiveSessionRefusal(message, reason)
 
diff --git a/scripts/ci/flaky_kanban.py b/scripts/ci/flaky_kanban.py
index dc9be78722..bf83d4bbea 100644
--- a/scripts/ci/flaky_kanban.py
+++ b/scripts/ci/flaky_kanban.py
@@ -184,13 +184,39 @@ def _gh(url: str, token: str) -> Any:
         return json.loads(resp.read())
 
 
-def poll_github(repo: str, token: str, board: Board, state: dict[str, Any], *, runs: int = 40) -> list[str]:
-    """File cards for FLAKY annotations on recently completed runs not seen before."""
+def _completed_runs(api: str, token: str, *, since: float, per_page: int = 100) -> list[dict[str, Any]]:
+    """Every run created since ``since`` that has completed, across all result pages.
+
+    The list is ordered by creation, but a run is only readable once it completes: a
+    40-minute test run finishes after dozens of newer short runs, so a fixed first page
+    (it used to be the newest 40) silently skipped exactly the long test runs that carry
+    FLAKY annotations. A creation-time window, paged out, keeps them in view until they
+    complete; ``state["runs"]`` dedupes across polls.
+    """
+    created = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(since))
+    runs: list[dict[str, Any]] = []
+    page = 1
+    while True:
+        batch = _gh(f"{api}/actions/runs?status=completed&created=%3E%3D{created}"
+                    f"&per_page={per_page}&page={page}", token).get("workflow_runs", [])
+        runs += batch
+        if len(batch) < per_page:
+            return runs
+        page += 1
+
+
+def poll_github(repo: str, token: str, board: Board, state: dict[str, Any], *,
+                lookback_hours: float = 6.0) -> list[str]:
+    """File cards for FLAKY annotations on recently completed runs not seen before.
+
+    ``lookback_hours`` must outlast the slowest workflow plus any cron outage, and stay
+    well under ``save_state``'s 1000-run dedupe memory (the repo sees ~50 runs/hour).
+    """
     api = f"https://api.github.com/repos/{repo}"
     log: list[str] = []
     done = set(state["runs"])
-    page = _gh(f"{api}/actions/runs?status=completed&per_page={runs}", token)
-    for run in sorted(page.get("workflow_runs", []), key=lambda r: r["id"]):
+    since = time.time() - lookback_hours * 3600
+    for run in sorted(_completed_runs(api, token, since=since), key=lambda r: r["id"]):
         key = f"{run['id']}/{run.get('run_attempt', 1)}"
         if key in done:
             continue
diff --git a/tests/ci/test_flaky_kanban.py b/tests/ci/test_flaky_kanban.py
index 5c201e3f74..5be5171ba2 100644
--- a/tests/ci/test_flaky_kanban.py
+++ b/tests/ci/test_flaky_kanban.py
@@ -120,6 +120,44 @@ def test_annotations_round_trip_through_the_github_poll(monkeypatch):
     assert len(board.cards) == 2
 
 
+def test_poll_pages_past_newer_runs_to_reach_a_long_test_run(monkeypatch):
+    """A long test run completes after more newer runs than one page holds.
+
+    Regression: PR run 40764402730 (37 min of tests) finished behind 53 newer
+    completed runs; the poll read only the newest 40, so its three FLAKY
+    annotations never became cards.
+    """
+    api = "https://api.github.com/repos/o/r"
+    # Newest first, as GitHub orders them; the slow test run is the oldest.
+    runs = [{"id": 1000 - i, "run_attempt": 1, "head_branch": "b", "html_url": f"https://r/{1000 - i}"}
+            for i in range(150)]
+    slow = runs[-1]["id"]
+    seen_urls = []
+
+    def fake_gh(url, token):
+        seen_urls.append(url)
+        if url.startswith(f"{api}/actions/runs?"):
+            query = dict(part.split("=", 1) for part in url.split("?", 1)[1].split("&"))
+            per_page, page = int(query["per_page"]), int(query.get("page", 1))
+            return {"workflow_runs": runs[(page - 1) * per_page: page * per_page]}
+        if url.startswith(f"{api}/actions/runs/{slow}/attempts/1/jobs"):
+            return {"jobs": [{"id": 7, "name": "Python tests / Run tests (1/2)", "html_url": "https://job/7"}]}
+        if "/attempts/" in url:
+            return {"jobs": []}
+        if url.startswith(f"{api}/check-runs/7/annotations"):
+            return [{"title": fk.ANNOTATION_TITLE, "message": "tests/slow.py::test_flaky\nE  boom"}]
+        raise AssertionError(url)
+
+    monkeypatch.setattr(fk, "_gh", fake_gh)
+    board, state = FakeBoard(), fk.load_state(Path("/nonexistent/state.json"))
+    log = fk.poll_github("o/r", "tok", board, state)
+
+    assert log == [f"opened {state['cards']['tests/slow.py::test_flaky']['card']} tests/slow.py::test_flaky"]
+    assert f"{slow}/1" in state["runs"] and len(state["runs"]) == len(runs)
+    # Bounded by a creation window, not by a page count.
+    assert all("created=%3E%3D" in u for u in seen_urls if u.startswith(f"{api}/actions/runs?"))
+
+
 def test_annotate_mode_tolerates_a_missing_report(tmp_path, capsys):
     assert fk.main(["--annotate", str(tmp_path / "absent.json")]) == 0
     assert "no flaky report" in capsys.readouterr().out
