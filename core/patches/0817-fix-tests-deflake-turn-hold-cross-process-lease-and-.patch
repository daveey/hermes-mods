 scripts/ci/flaky_kanban.py                    |  34 ++++-
 tests/ci/test_flaky_kanban.py                 |  38 ++++++
 .../test_session_hygiene_turnhold_adoption.py |  27 +++-
 tests/hermes_cli/test_active_sessions.py      | 129 ++++++++++++------
 .../test_hosted_room_driver_runtime.py        |  88 ++++++------
 6 files changed, 228 insertions(+), 94 deletions(-)

