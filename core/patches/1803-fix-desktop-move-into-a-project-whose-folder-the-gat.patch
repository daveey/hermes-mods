+        )
+      }
+
+      if (method === 'projects.get') {
+        expect(params).toMatchObject({ id: 'p_ad616738' })
+
+        return { project: { id: 'p_ad616738', name: 'focus', primary_path: '/home/me/code/myapp' } }
+      }
