     st_ph = ",".join("?" for _ in statuses)
-    conn = _open_ro(path)
-    conn.row_factory = sqlite3.Row
-    try:
+    with cached_ro(path) as conn:
+        conn.row_factory = sqlite3.Row
         cols = {r[1] for r in conn.execute("PRAGMA table_info(tasks)")}
         if "session_id" not in cols:
