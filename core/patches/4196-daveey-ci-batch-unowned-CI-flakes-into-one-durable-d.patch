+
+    admitted = []
+    with pytest.raises(RuntimeError, match="owner inventory unavailable"):
+        fk.file_cards([{"test_id": "tests/a.py::test_a"}], run_url="https://github.com/o/r/actions/runs/1/job/9",
+                      branch="a" * 40, board=Board(), state={"cards": {}},
