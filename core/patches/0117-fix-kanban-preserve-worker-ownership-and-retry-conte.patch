diff --git a/tests/hermes_cli/test_kanban_host_identity.py b/tests/hermes_cli/test_kanban_host_identity.py
new file mode 100644
index 0000000000000000000000000000000000000000..9c04c49737508bb6edf09ed7289aa076df20ebd8
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_host_identity.py
@@ -0,0 +1,56 @@
+"""Hostnames can change on wake; process ownership must not change with them."""
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_host_identity as identity
+
+
+@pytest.fixture(autouse=True)
+def clear_cache():
+    clear = identity.boot_prefix.cache_clear
+    clear()
+    yield
+    clear()
+
+
+@pytest.mark.platforms("macos")
+def test_boot_identity_survives_hostname_change_and_dispatcher_restart(monkeypatch):
+    monkeypatch.setattr(identity.subprocess, 'run', lambda *a, **k: SimpleNamespace(stdout='CB94B6BF-9036-41A6-8861-EF82D3222CDB\n'))
+    monkeypatch.setattr(identity.socket, 'gethostname', lambda: 'before.local')
+    lock = kb._claimer_id()
+    monkeypatch.setattr(identity.socket, 'gethostname', lambda: 'after.local')
+    identity.boot_prefix.cache_clear()  # fresh dispatcher's view
+    assert kb._claim_is_local(lock)
+    assert kb._claim_is_local('after.local:123')  # legacy compatibility
+    assert not kb._claim_is_local('foreign.local:123')
+    assert not kb._claim_is_local('boot-00000000-0000-0000-0000-000000000000:123')
+
+
+@pytest.mark.platforms("macos")
+@pytest.mark.parametrize('output', ['', 'not-a-uuid'])
+def test_unavailable_identity_uses_hostname(monkeypatch, output):
+    monkeypatch.setattr(identity.subprocess, 'run', lambda *a, **k: SimpleNamespace(stdout=output))
+    monkeypatch.setattr(identity.socket, 'gethostname', lambda: 'fallback')
+    assert identity.claim_prefix() == 'fallback:'
+
+
+def test_hostname_change_does_not_reclaim_live_run(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setattr(identity, 'boot_prefix', lambda: 'boot-test:')
+    monkeypatch.setattr(identity.socket, 'gethostname', lambda: 'before.local')
+    path = tmp_path / 'board.db'
+    kbc.init_db(path)
+    with kbc.connect_closing(path) as conn:
+        tid = kb.create_task(conn, title='survivor', assignee='default')
+        kb.recompute_ready(conn)
+        task = kb.claim_task(conn, tid)
+        conn.execute('UPDATE tasks SET worker_pid=123, claim_expires=0 WHERE id=?', (tid,))
+        conn.commit()
+        monkeypatch.setattr(identity.socket, 'gethostname', lambda: 'after.local')
+        monkeypatch.setattr(kb, '_worker_alive', lambda *a: True)
+        assert kb.release_stale_claims(conn) == 0
+        assert kb.get_task(conn, tid).current_run_id == task.current_run_id
+        assert kb.get_task(conn, tid).status == 'running'
diff --git a/tests/hermes_cli/test_kanban_restart_survival.py b/tests/hermes_cli/test_kanban_restart_survival.py
new file mode 100644
index 0000000000000000000000000000000000000000..535fc06007a971cde10e9277b8b48555d20d200c
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_restart_survival.py
@@ -0,0 +1,119 @@
+"""Real detached workers outlive gateway and Desktop backend group teardown."""
+import json
+import os
+from pathlib import Path
+import shutil
+import signal
+import subprocess
+import sys
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as dispatch
+
+
+def wait_for(predicate):
+    until = time.monotonic() + 30
+    while time.monotonic() < until:
+        if predicate():
+            return
+        time.sleep(.05)
+    raise AssertionError('subprocess readiness timed out')
+
+
+@pytest.mark.live_system_guard_bypass  # signals only PIDs spawned by this test, intentionally orphaned
+@pytest.mark.platforms('posix')
+@pytest.mark.parametrize('entry', ['gateway', 'desktop'])
+def test_worker_survives_entrypoint_restart(tmp_path, monkeypatch, entry):
+    node = shutil.which('node')
+    if entry == 'desktop' and not node:
+        pytest.skip('Desktop requires Node with TypeScript support')
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    board = tmp_path / 'board.db'
+    monkeypatch.setenv('HERMES_KANBAN_DB', str(board))
+    kbc.init_db(board)
+    with kbc.connect_closing(board) as conn:
+        tid = kb.create_task(conn, title='restart survival', assignee='default')
+        kb.recompute_ready(conn)
+    root = Path(__file__).resolve().parents[2]
+    # Both entrypoints use _default_spawn. Replace only the LLM command with a
+    # deterministic worker; keep the real environment, file FDs and setsid.
+    worker_code = f'''
+import sys
+sys.path[:] = {sys.path!r}
+from pathlib import Path
+import os, time
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+root = Path({str(tmp_path)!r})
+(root / 'worker-ready').write_text(str(os.getpid()))
+while not (root / 'continue').exists(): time.sleep(.05)
+with kbc.connect_closing(root / 'board.db') as conn:
+    kb.complete_task(conn, {tid!r}, result='survived restart', expected_run_id=int(os.environ['HERMES_KANBAN_RUN_ID']))
+(root / 'done').write_text('done')
+'''
+    parent_code = f'''
+import sys
+sys.path[:] = {sys.path!r}
+import time
+from pathlib import Path
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as d
+root = Path({str(tmp_path)!r})
+d._worker_argv = lambda *a: [{sys.executable!r}, '-c', {worker_code!r}]
+d._retag_legacy_worker_sessions = lambda *a: None
+with kbc.connect_closing(root / 'board.db') as conn:
+    task = kb.claim_task(conn, {tid!r})
+    pid = d._default_spawn(task, str(root))
+    d._set_worker_pid(conn, task.id, pid)
+(root / 'parent-ready').write_text(str(pid))
+while True: time.sleep(1)
+'''
+    env = dict(os.environ)
+    for key in list(env):
+        if key.startswith('HERMES_KANBAN_') and key != 'HERMES_KANBAN_DB':
+            env.pop(key)
+    parent = subprocess.Popen([sys.executable, '-c', parent_code], env=env,
+                              start_new_session=True, stdout=subprocess.DEVNULL,
+                              stderr=(tmp_path / 'parent.log').open('w'))
+    pid = None
+    try:
+        wait_for(lambda: (tmp_path / 'parent-ready').exists())
+        wait_for(lambda: (tmp_path / 'worker-ready').exists())
+        pid = int((tmp_path / 'worker-ready').read_text())
+        assert os.getpgid(pid) != os.getpgid(parent.pid)
+        with kbc.connect_closing(board) as conn:
+            run_id = kb.get_task(conn, tid).current_run_id
+        if entry == 'desktop':
+            # Execute Desktop's actual managed-backend teardown, not a copy.
+            module = (root / 'apps/desktop/electron/backend-child.ts').as_uri()
+            js = f"import {{stopBackendChild}} from {json.dumps(module)}; stopBackendChild({{pid:{parent.pid},kill:s=>process.kill({parent.pid},s)}},{{forceKillProcessTree:()=>{{throw Error('unexpected')}}}});"
+            subprocess.run([node, '--input-type=module', '-e', js], check=True, timeout=20)
+        else:
+            os.killpg(parent.pid, signal.SIGTERM)
+        parent.wait(timeout=15)
+        assert dispatch._pid_alive(pid)
+        # A fresh dispatcher connection must preserve this same run, even when
+        # its old dispatcher's lease has expired.
+        with kbc.connect_closing(board) as conn:
+            conn.execute('UPDATE tasks SET claim_expires=0 WHERE id=?', (tid,))
+            conn.commit()
+            assert kb.release_stale_claims(conn) == 0
+            assert dispatch.detect_crashed_workers(conn) == []
+            assert kb.get_task(conn, tid).current_run_id == run_id
+        (tmp_path / 'continue').touch()
+        wait_for(lambda: (tmp_path / 'done').exists())
+        with kbc.connect_closing(board) as conn:
+            assert kb.get_task(conn, tid).status == 'done'
+            row = conn.execute('SELECT outcome FROM task_runs WHERE id=?', (run_id,)).fetchone()
+            assert row[0] == 'completed'
+    finally:
+        if parent.poll() is None:
+            os.killpg(parent.pid, signal.SIGKILL)
+            parent.wait(timeout=5)
+        if pid and dispatch._pid_alive(pid):
+            os.kill(pid, signal.SIGKILL)
