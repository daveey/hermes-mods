From 6e5ce1e737a1d4952768c5a34c344a76d2171977 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 17:06:50 -0800
Subject: [PATCH] fix(doctor): argv mask judges paths by their start; keep
 numbers and known public flags

Review follow-up: a value containing "/" anywhere counted as a path, so a
base64 secret after a secret-named flag (--aws-secret-access-key
wJalrXUtnFEMI/K7MDENG/...) printed in full. A path is now recognised by how
it starts (/, ~, ./, ../, \, C:\). Numbers are never masked, count and
identifier flags (--max-tokens, --token-env, --idempotency-key, ...) are
public, the Hermes-id exception accepts only letter words (a lowercase
prefixed random token is no longer exempt) and a Title-case word segment
keeps model names like Qwen3-Coder-480B-A35B-Instruct readable.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_state_argv_secrets.py            | 20 +++++++++++------
 tests/hermes_state/test_argv_secrets.py | 29 +++++++++++++++++++++++++
 2 files changed, 42 insertions(+), 7 deletions(-)

diff --git a/hermes_state_argv_secrets.py b/hermes_state_argv_secrets.py
index 2b1e59674c7..969cd28ba82 100644
--- a/hermes_state_argv_secrets.py
+++ b/hermes_state_argv_secrets.py
@@ -21,10 +21,14 @@ _SECRET_FLAG = re.compile(
 )
 # Flags that LOOK secret-named but carry public, identifying values.
 _PUBLIC_FLAGS = frozenset({"--ssh-session-token-file", "--token-file", "--key-file", "--auth-file",
-                           "--keychain", "--monkey", "--keyboard", "--author", "--authority"})
+                           "--keychain", "--monkey", "--keyboard", "--author", "--authority",
+                           "--max-tokens", "--min-tokens", "--cache-read-tokens", "--token-env",
+                           "--idempotency-key", "--step-key", "--passkey-browser"})
 _TOKEN_CHARS = re.compile(r"^[A-Za-z0-9_+=.~-]+$")
 _HEX = re.compile(r"^[0-9a-fA-F-]+$")
-_HERMES_ID = re.compile(r"^(?:t_[0-9a-f]+|\d{8}_\d{6}_[0-9a-z]+|[a-z]+(?:[-_][a-z0-9]+)+)$")
+_HERMES_ID = re.compile(r"^(?:t_[0-9a-f]+|\d{8}_\d{6}_[0-9a-z]+|[a-z]+(?:[-_][a-z]+)+)$")
+_NUMBER = re.compile(r"^[+-]?\d+(?:\.\d+)?$")
+_PATH_START = re.compile(r"^(?:/|~|\.{1,2}/|\\|[A-Za-z]:[\\/])")
 _MIN_BARE_SECRET = 20
 _MIN_ENTROPY_BITS = 3.5
 
@@ -36,8 +40,9 @@ def _looks_like_bare_secret(token: str) -> bool:
         return False
     if _HEX.match(token) or _HERMES_ID.match(token):
         return False
-    if any(len(part) >= 5 and part.isalpha() and part.islower() for part in re.split(r"[-_.]", token)):
-        return False  # a separated plain word (``…-production``, ``…_session``): an identifier, not random
+    if any(len(part) >= 5 and part.isalpha() and (part.islower() or part.istitle())
+           for part in re.split(r"[-_.]", token)):
+        return False  # a separated plain word (``…-production``, ``Qwen3-Coder-…``): an identifier, not random
     if not (re.search(r"[A-Za-z]", token) and re.search(r"\d", token)):
         return False
     counts = Counter(token)
@@ -50,12 +55,13 @@ def _is_secret_flag(token: str) -> bool:
 
 
 def _looks_like_path(value: str) -> bool:
-    """A file path names where a secret lives, not the secret: keep it (``--password-file /x/y.pass``)."""
-    return "/" in value or "\\" in value or value.startswith(("~", "."))
+    """A file path names where a secret lives, not the secret: keep it (``--password-file /x/y.pass``). Judged by
+    how it starts: base64 secrets contain ``/`` too (``wJalrXUtnFEMI/K7MDENG/…``)."""
+    return bool(_PATH_START.match(value))
 
 
 def _mask_value(value: str, *, secret_named: bool) -> str:
-    if not value or _looks_like_path(value):
+    if not value or _looks_like_path(value) or _NUMBER.match(value):
         return value
     return MASK if secret_named or _looks_like_bare_secret(value) else value
 
diff --git a/tests/hermes_state/test_argv_secrets.py b/tests/hermes_state/test_argv_secrets.py
index 065a9196a13..390945693f3 100644
--- a/tests/hermes_state/test_argv_secrets.py
+++ b/tests/hermes_state/test_argv_secrets.py
@@ -22,6 +22,14 @@ KEY = "q8ZpL2vXk9RtYwB4mN7cQ1sD5fH3jK6g"
         (["tool.py", "--signing-key=hunter2"], ["tool.py", f"--signing-key={MASK}"]),
         (["tool.py", "--auth", "abc"], ["tool.py", "--auth", MASK]),
         (["tool.py", "--DB-PASSWORD", "pw"], ["tool.py", "--DB-PASSWORD", MASK]),
+        # base64 secrets contain "/": still masked after a secret-named flag (only a path's START keeps it)
+        (
+            ["--aws-secret-access-key", "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"],
+            ["--aws-secret-access-key", MASK],
+        ),
+        (["--webhook-secret=Zm9vYmFyYmF6/cXV4cXV1eA=="], [f"--webhook-secret={MASK}"]),
+        # a lowercase prefixed random token is not a Hermes id
+        (["abc-9f8e7d6c5b4a39281706f5e4z"], [MASK]),
         # a bare token as a --flag=value value
         (["tool.py", f"--config={KEY}"], ["tool.py", f"--config={MASK}"]),
     ],
@@ -59,6 +67,27 @@ def test_secrets_are_masked(argv, expected):
         ],
         ["/home/ubuntu/.local/share/hermes-mail/hermes_hub.py", "_runtime-serve"],
         ["--author", "daveey", "--keyboard", "us"],
+        [
+            "--max-tokens",
+            "4096",
+            "--min-tokens=16",
+            "--cache-read-tokens",
+            "2048",
+            "--token-env",
+            "OPENAI_API_KEY",
+        ],
+        [
+            "--idempotency-key",
+            "followup:t_01a1ecf2c3d6367b:notify",
+            "--step-key",
+            "build",
+            "--passkey-browser",
+            "chrome",
+        ],
+        ["--model", "Qwen3-Coder-480B-A35B-Instruct"],
+        ["--api-key-timeout", "30"],
+        ["--key-file", "C:\\Users\\x\\key.pem"],
+        ["--token-file", "./token.txt"],
     ],
 )
 def test_identifiers_are_kept(argv):
