+@pytest.mark.parametrize("body", [
+    "assert 'js-tests' in ('tests-os', 'lint')",
+    "assert 'js-tests' in 'tests-os,lint'",
+    "assert ['lint', 'tests-os'] == ['lint', 'js-tests']",
+    "assert {'lint', 'tests-os'} == {'lint', 'js-tests'}",
+    "a = {'tests/e2e': False}; b = {'tests-os/e2e-windows': False}; assert all(a.values()) and all(b.values()), (a, b)",
