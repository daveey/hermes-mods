+])
+def test_other_predicates_cannot_borrow_an_os_diagnostic(tmp_path, body):
+    p = _run(tmp_path, {"test_update_ci_routing.py":
+        "def test_every_set_lane_reaches_its_consumer_whatever_the_other_lanes_say():\n    " + body + "\n"})
