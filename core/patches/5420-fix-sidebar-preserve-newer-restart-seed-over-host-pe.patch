From 767ae6d5be537d26b3fe6c8541e361a7eb3e6a10 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 06:47:58 +0000
Subject: [PATCH] fix(sidebar): preserve newer restart seed over host peek
 [daveey]

---
 hermes_cli/kanban_annotation_host.py           |  5 ++++-
 .../test_kanban_annotation_refresh_bounded.py  | 18 ++++++++++++++++++
 2 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_annotation_host.py b/hermes_cli/kanban_annotation_host.py
index d784f43e5b..9557368b39 100644
--- a/hermes_cli/kanban_annotation_host.py
+++ b/hermes_cli/kanban_annotation_host.py
@@ -394,7 +394,10 @@ def peek_display(scope: tuple[str, ...], previous: tuple | None) -> tuple | None
     if read is None or not read[2]:
         return previous
     parts, observed_at, _complete = read
-    previous_at = bounded.read_at(previous)
+    # Restart seeds carry provenance in the disk cache, not the bounded-read registry.
+    previous_at = _disk.observed_at(previous)
+    if previous_at is None:
+        previous_at = bounded.read_at(previous)
     if previous_at is not None and previous_at >= observed_at:
         return previous
     return bounded.ObservedParts(parts, observed_at)
diff --git a/tests/hermes_cli/test_kanban_annotation_refresh_bounded.py b/tests/hermes_cli/test_kanban_annotation_refresh_bounded.py
index db932ab5eb..d390a78120 100644
--- a/tests/hermes_cli/test_kanban_annotation_refresh_bounded.py
+++ b/tests/hermes_cli/test_kanban_annotation_refresh_bounded.py
@@ -125,6 +125,24 @@ def test_slow_refresh_error_keeps_previous_and_releases_lock(scoped, caplog):
     assert ksa._annotation_snapshot()[0] == {"s1": 4}
 
 
+@pytest.mark.parametrize("host_age, expected", [(10, 1), (5, 1), (4, 0)])
+def test_display_peek_preserves_newer_restart_seed(scoped, host_age, expected):
+    from hermes_cli import kanban_annotation_disk as disk
+
+    now = time.time()
+    # Exercise the real restart seed path, not a process-local bounded read.
+    scoped.undo()
+    ksa._reset_cache_for_tests()
+    scoped.setattr(ksa, "_origin_scope", lambda: SCOPE)
+    scoped.setattr(disk, "load", lambda scope: (_parts(1), now - 5))
+    scoped.setattr(ksa._host_copy, "_display_read", lambda scope: (_parts(0), now - host_age, True))
+    with ksa._annotate_refresh_lock:
+        row = ksa.annotate_kanban_activity([{"id": "s1"}], display=True)[0]
+    assert row.get("kanban_active", 0) == expected, row
+    assert row["kanban_observed_at"] == now - (5 if expected else host_age)
+    assert not row.get("kanban_unknown")
+
+
 def test_fast_cold_scope_returns_counts_with_caller_context(scoped):
     from contextvars import ContextVar
 
