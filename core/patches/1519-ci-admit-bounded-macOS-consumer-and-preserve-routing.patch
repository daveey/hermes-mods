From 42d950f8ff360ce7be913ea7ce8cfade8d64ae76 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 17:50:02 +0000
Subject: [PATCH] ci: admit bounded macOS consumer and preserve routing on
 reapply [daveey]

---
 .github/FAST-LANE.md                 | 14 ++++++++++++++
 scripts/fork-ci-runner.sh            |  4 +++-
 tests/ci/test_fast_runner_routing.py | 25 ++++++++++++++++++++++++-
 3 files changed, 41 insertions(+), 2 deletions(-)

diff --git a/.github/FAST-LANE.md b/.github/FAST-LANE.md
index 6bb6beb2b1b..6ce4057ac30 100644
--- a/.github/FAST-LANE.md
+++ b/.github/FAST-LANE.md
@@ -13,6 +13,20 @@ heavy `hermes-hub` pool they queued behind full suites (PR #266: 23 min for a
 `ci-fast` when it is re-run after an upstream merge.
 The `!cancelled()` condition still keeps superseded runs from latching their group.
 
+## Third admission (November 1, 2026)
+
+`macOS state required (v1)` (`ci.yaml` job `macos-state-required`) is the
+macOS state lane's own required check: checkout plus one `python3
+scripts/ci/required_results.py --macos-state` over `toJSON(needs)`. No build,
+Docker, secrets or matrix; 10-minute timeout. It ran 14 s on `ci-fast`
+(runner `ec2-gwgen4-1`, run 41326127097, job 124910774212, 16:41:34–16:41:48
+UTC). It must keep `if: ${{ always() }}` so a skipped or cancelled lane fails
+closed, and an `always()` job may not wait on `hermes-hub`
+(`tests/ci/test_fork_runner_routing.py`), so `ci-fast` is its only lane. It is
+not a completion job: `scripts/fork-ci-runner.sh` pins its runner but leaves its
+condition alone, and it is not in the aggregate's needs. The rollout must add
+its name to main's required status checks separately before promotion is complete.
+
 ## Second admission (October 30, 2026)
 
 At 02:31 PDT all 16 online `hermes-hub` runners were busy with full suites
diff --git a/scripts/fork-ci-runner.sh b/scripts/fork-ci-runner.sh
index d1ea5c6c648..420e60569f0 100755
--- a/scripts/fork-ci-runner.sh
+++ b/scripts/fork-ci-runner.sh
@@ -40,7 +40,9 @@ COMPLETION = {
     'supply-chain-audit.yml': ('aggregate',),
 }
 FAST = {
-    'ci.yaml': ('detect', 'all-checks-pass', 'ci-timings'),
+    # macos-state-required is FAST but not COMPLETION: it keeps always() so a
+    # skipped or cancelled macOS lane still fails the required check.
+    'ci.yaml': ('detect', 'all-checks-pass', 'ci-timings', 'macos-state-required'),
     'actionlint.yml': ('actionlint',),
     'lint.yml': ('ruff-blocking', 'code-health', 'windows-footguns'),
     'case-collision-check.yml': ('check-case-collisions',),
diff --git a/tests/ci/test_fast_runner_routing.py b/tests/ci/test_fast_runner_routing.py
index eec68990bb1..22317af7d94 100644
--- a/tests/ci/test_fast_runner_routing.py
+++ b/tests/ci/test_fast_runner_routing.py
@@ -44,10 +44,21 @@ FAST = {
     ("supply-chain-audit.yml", "scan"),
     ("supply-chain-audit.yml", "dep-bounds"),
     ("supply-chain-audit.yml", "aggregate"),
+    # Third admission (November 1, 2026): the macOS state lane's own required
+    # check. Checkout plus one python3 call over toJSON(needs); 14 s on ci-fast
+    # in run 41326127097 (job 124910774212). Its always() must stay (fail-closed
+    # when the lane is skipped or cancelled), and an always() job may not wait
+    # on hermes-hub (test_fork_runner_routing), so it cannot go back there.
+    ("ci.yaml", "macos-state-required"),
 }
 # Completion jobs in the orchestrator itself: the gate, and the advisory report
 # that runs after it. Neither can be one of the gate's own needs.
 COMPLETION = {("ci.yaml", "all-checks-pass"), ("ci.yaml", "ci-timings")}
+# Required checks that the ruleset names directly instead of through the gate,
+# so they are outside its needs and keep always(): never !cancelled() or skip.
+SEPARATE_REQUIRED = {
+    ("ci.yaml", "macos-state-required"): ("macOS state required (v1)", {"detect", "hermes-state-macos"}),
+}
 
 
 def _workflows():
@@ -115,6 +126,11 @@ def test_fast_label_is_known_and_checks_cannot_bypass_the_gate():
         elif (wf, name) in COMPLETION:
             assert name == "all-checks-pass" or "all-checks-pass" in job["needs"]
             assert job["if"] == "${{ !cancelled() }}"
+        elif (wf, name) in SEPARATE_REQUIRED:
+            title, needs = SEPARATE_REQUIRED[(wf, name)]
+            assert job["name"] == title
+            assert set(job["needs"]) == needs
+            assert job["if"] == "${{ always() }}"
         elif wf == "ci.yaml":
             assert name in gate["needs"]
         else:
@@ -139,7 +155,11 @@ def test_fork_rewriter_keeps_every_fast_job_on_the_fast_lane(tmp_path, upstream_
             match = re.search(r"(?m)^  " + re.escape(name) + r":\n(?:(?!  \S).*\n)*", text)
             assert match, (wf, name)
             block = match.group(0)
-            text = text.replace(block, re.sub(r"(?m)^    runs-on: .*$", f"    runs-on: {upstream_label}", block))
+            changed = re.sub(r"(?m)^    runs-on: .*$", f"    runs-on: {upstream_label}", block)
+            if (wf, name) in SEPARATE_REQUIRED:
+                # The bare form is what the script's completion rewrite turns into !cancelled().
+                changed = re.sub(r"(?m)^    if: .*$", "    if: always()", changed)
+            text = text.replace(block, changed)
         path.write_text(text, encoding="utf-8")
     yaml = YAML(typ="safe")
     for _ in range(2):
@@ -147,6 +167,9 @@ def test_fork_rewriter_keeps_every_fast_job_on_the_fast_lane(tmp_path, upstream_
         for wf, name in FAST:
             job = yaml.load((tmp_path / ".github/workflows" / wf).read_text(encoding="utf-8"))["jobs"][name]
             assert _labels(job) == ["self-hosted", "ci-fast"], (wf, name)
+            if (wf, name) in SEPARATE_REQUIRED:
+                # The fast pin must not turn a fail-closed check into a skippable one.
+                assert job["if"] == "always()", (wf, name)
     # Heavy work the script routes is untouched by the fast-lane pin.
     lint = yaml.load((tmp_path / ".github/workflows/lint.yml").read_text(encoding="utf-8"))
     assert lint["jobs"]["lint-diff"]["runs-on"] == ["self-hosted", "hermes-hub"]
-- 
