From 6725b6ff61025ede06fbb8723328f979eab63347 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 04:19:38 -0700
Subject: [PATCH] fix(ci): [daveey] e2e-upgrade fetches upstream release tags
 so N-1 resolves on the fork

---
 .github/workflows/tests.yml          | 13 +++++++++++++
 tests/ci/test_fast_runner_routing.py | 15 +++++++++++++++
 2 files changed, 28 insertions(+)

diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index f2aac3bd0c..71526dd5f6 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -336,6 +336,19 @@ jobs:
           fetch-depth: 0
           fetch-tags: true
 
+      - name: Fetch upstream release tags
+        # [daveey] The fork carries no v20* release tags, so N-1 (`git describe` below) found
+        # nothing and every N-1 test failed "No names found" (run 40658892506, git shard).
+        # main = upstream + fork commits, so upstream's release tags are ancestors of HEAD~1.
+        # Fetched only when origin's own tags can't resolve N-1; the last line fails the step
+        # if they still can't.
+        run: |
+          set -euo pipefail
+          if ! git describe --tags --abbrev=0 --match 'v20[0-9][0-9].*' HEAD~1 >/dev/null 2>&1; then
+            git fetch --no-tags --quiet https://github.com/NousResearch/hermes-agent.git '+refs/tags/v20*:refs/tags/v20*'
+          fi
+          git describe --tags --abbrev=0 --match 'v20[0-9][0-9].*' HEAD~1
+
       - name: Set up Node
         # `hermes update` builds the web UI / TUI workspaces.
         uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # 7.0.0
diff --git a/tests/ci/test_fast_runner_routing.py b/tests/ci/test_fast_runner_routing.py
index c4be84a82a..01ba4f15c2 100644
--- a/tests/ci/test_fast_runner_routing.py
+++ b/tests/ci/test_fast_runner_routing.py
@@ -108,3 +108,18 @@ def test_e2e_upgrade_runs_only_on_bwrap_capable_slots():
         for name, j in data.get("jobs", {}).items():
             if "ci-bwrap" in _labels(j):
                 assert (wf, name) == ("tests.yml", "e2e-upgrade")
+
+
+def test_e2e_upgrade_has_release_tags_for_n_minus_1():
+    # N-1 = `git describe --tags --abbrev=0 --match 'v20[0-9][0-9].*' HEAD~1`. The fork
+    # carries no release tags, so without upstream's the git/core shards fail
+    # "No names found, cannot describe anything" (run 40658892506, e2e-upgrade (git)).
+    steps = _workflows()["tests.yml"]["jobs"]["e2e-upgrade"]["steps"]
+    names = [s.get("name") for s in steps]
+    fetch = steps[names.index("Fetch upstream release tags")]
+    assert names.index("Checkout code") < names.index("Fetch upstream release tags")
+    assert names.index("Fetch upstream release tags") < names.index("Run upgrade e2e tests (${{ matrix.shard }})")
+    assert "https://github.com/NousResearch/hermes-agent.git" in fetch["run"]
+    assert "refs/tags/v20*:refs/tags/v20*" in fetch["run"]
+    # The step proves N-1 resolves instead of letting every N-1 test fail on its own.
+    assert fetch["run"].rstrip().endswith("git describe --tags --abbrev=0 --match 'v20[0-9][0-9].*' HEAD~1")
-- 
