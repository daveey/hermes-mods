+        replica.execute("UPDATE tasks SET created_on=NULL WHERE id=?", (shadow_board["ready"],))
+    assert _cards(_read(shadow_board))[shadow_board["ready"]]["home_gateway"] == "unknown"
+    def no_query(*args):
