diff --git a/hermes_cli/kanban_release_home.py b/hermes_cli/kanban_release_home.py
new file mode 100644
index 0000000000000000000000000000000000000000..566f88a20cb61bddc1c213c5e26564b3d6285023
--- /dev/null
+++ b/hermes_cli/kanban_release_home.py
@@ -0,0 +1,151 @@
+"""Authenticated HOME consume queue. Consumption is NOT local application.
+
+No local scope release, budget, promotion, result or execution authority exists
+here. The separate applied transaction must be implemented before advertising.
+"""
+from __future__ import annotations
+
+import logging
+
+from hermes_cli import kanban_release_certificate as cert, kanban_release_intent as intent
+from hermes_cli import kanban_release_home_queue as queue
+
+_log = logging.getLogger(__name__)
+
+
+def _hub():
+    from hermes_cli import kanban_sync_client as client
+    return client.Hub(client.load_identity())
+
+
+def _identity(conn, hub, row, own, board):
+    from hermes_cli import kanban_operator_call as operator
+    if (hub.ident.gateway != own or operator._own_gateway(conn) != own or operator._board_slug(conn) != board
+            or row["board"] != board or not operator._is_home(conn, own, row["task_id"])):
+        raise ValueError("HOME release identity changed")
+
+
+def _authenticate(conn, hub, row, own, board):
+    ev = hub.row_evidence(board, "task_events", row["delivery_uid"], max_response_bytes=cert.MAX_BYTES)
+    if (not isinstance(ev, dict) or ev.get("board") != board or ev.get("table") != "task_events"
+            or ev.get("uid") != row["delivery_uid"] or ev.get("state") != "live"):
+        raise ValueError("canonical HOME release carrier unavailable")
+    canonical = ev.get("row")
+    p = queue.validate(canonical, board, own)
+    # Compare all frozen fields available in the real local event schema. Board
+    # alone supplies HLC/origin/run UID; private intent supplies actor authority.
+    for k in ("uid", "task_id", "payload", "created_at"):
+        expected = row["delivery_uid"] if k == "uid" else row[k]
+        if cert.encode(canonical[k]) != cert.encode(expected):
+            raise ValueError("HOME release carrier differs from captured event")
+    _identity(conn, hub, row, own, board)
+    return p
+
+
+def _proof(hub, body):
+    from hermes_cli.kanban_release_native import _proof as read_proof
+    return read_proof(hub, body)
+
+
+def _freeze(conn, row, p):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_db_sync import uuid7
+    op = {"client_op_id": uuid7(), "op": "consume_owner_release", "task": row["task_id"],
+          "intent_uid": row["intent_uid"], "digest": p["digest"], "seen_comments": p["seen_comments"]}
+    with kb.write_txn(conn):
+        current = conn.execute(f"SELECT * FROM {queue.TABLE} WHERE delivery_uid=?", (row["delivery_uid"],)).fetchone()
+        if current is None or tuple(current) != tuple(row):
+            raise ValueError("HOME release intake changed before preparation")
+        if conn.execute(f"SELECT 1 FROM {queue.TABLE} WHERE board=? AND intent_uid=? AND stage!='observed' "
+                        "AND delivery_uid!=?", (row["board"], row["intent_uid"], row["delivery_uid"])).fetchone():
+            raise ValueError("HOME release intent already has an authenticated delivery")
+        conn.execute(f"UPDATE {queue.TABLE} SET stage='prepared',consume_wire=?,wire_digest=? "
+                     "WHERE delivery_uid=? AND stage='observed' AND consume_wire IS NULL",
+                     (cert.encode(op), intent.digest(op), row["delivery_uid"]))
+
+
+def _transition(conn, row, expected, stage):
+    from hermes_cli import kanban_db as kb
+    with kb.write_txn(conn):
+        changed = conn.execute(f"UPDATE {queue.TABLE} SET stage=? WHERE delivery_uid=? AND stage=? "
+                               "AND consume_wire=? AND wire_digest=?", (stage, row["delivery_uid"], expected,
+                                                                        row["consume_wire"], row["wire_digest"]))
+        if changed.rowcount != 1:
+            raise ValueError("HOME release consume stage changed")
+
+
+def _reconcile(conn, hub, row, body, op, own, board):
+    from hermes_cli import kanban_release_replica as replica
+    receipt = cert.validate(hub.owner_release_consumption(board, body["intent_uid"]), board=board,
+                            task=body["task_id"], intent_uid=body["intent_uid"])
+    if cert.encode(receipt["consume"]) != cert.encode(op) or cert.encode(receipt["intent"]) != cert.encode(body):
+        raise ValueError("HOME release winning consumption differs")
+    _identity(conn, hub, row, own, board)
+    replica._store(conn, receipt)  # historical cache only; no coverage consumers
+    _transition(conn, row, "consume_pending", "consumed_pending_apply")
+
+
+def _process(conn, hub, row, own, board):
+    _identity(conn, hub, row, own, board)
+    p = cert.parse(row["payload"])
+    body = intent.validate(p["intent"])
+    # Resolve the frozen identity before mutable TTL/comments/owner checks.
+    op = queue.wire(row) if row["stage"] != "observed" else None
+    if op is not None:
+        proof = _proof(hub, body)
+        if proof["state"] == "consumed":
+            if row["stage"] == "prepared":
+                _transition(conn, row, "prepared", "consume_pending")
+                row = conn.execute(f"SELECT * FROM {queue.TABLE} WHERE delivery_uid=?", (row["delivery_uid"],)).fetchone()
+            _reconcile(conn, hub, row, body, op, own, board)
+            return
+    else:
+        p = _authenticate(conn, hub, row, own, board)
+        body = p["intent"]
+        proof = _proof(hub, body)
+    if proof["state"] != "authorized":
+        return  # unavailable certificate/refusal/expiry never remints a request
+    if op is None:
+        _freeze(conn, row, p)
+        row = conn.execute(f"SELECT * FROM {queue.TABLE} WHERE delivery_uid=?", (row["delivery_uid"],)).fetchone()
+        op = queue.wire(row)
+    # A later canonical edit/deletion cannot piggyback an earlier authorization.
+    _authenticate(conn, hub, row, own, board)
+    if row["stage"] == "prepared":
+        _transition(conn, row, "prepared", "consume_pending")
+        row = conn.execute(f"SELECT * FROM {queue.TABLE} WHERE delivery_uid=?", (row["delivery_uid"],)).fetchone()
+    _identity(conn, hub, row, own, board)
+    hub.ops(board, [op])  # never a writer across HTTP; ACK alone is not consumed
+    _reconcile(conn, hub, row, body, op, own, board)
+
+
+def tick(conn, rep, own, board):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_sync_client import HubError
+    queue.intake(conn, rep, board, own)
+    if not queue.exists(conn):
+        return
+    rows = conn.execute(f"SELECT * FROM {queue.TABLE} WHERE board=? AND stage IN ('observed','prepared','consume_pending') "
+                        "ORDER BY checked,rowid LIMIT 2", (board,)).fetchall()
+    if not rows:
+        return
+    import sqlite3
+    from hermes_cli.kanban_sync_client import SyncUnavailable
+    try:
+        hub = _hub()
+    except (OSError, HubError, SyncUnavailable) as exc:
+        _log.info("HOME release transport unavailable: %s", exc)
+        return
+    try:
+        for row in rows:
+            # Durable round-robin: transient failure cannot monopolize intake.
+            with kb.write_txn(conn):
+                conn.execute(f"UPDATE {queue.TABLE} SET checked=(SELECT COALESCE(MAX(checked),0)+1 FROM {queue.TABLE}) "
+                             "WHERE delivery_uid=?", (row["delivery_uid"],))
+            row = conn.execute(f"SELECT * FROM {queue.TABLE} WHERE delivery_uid=?", (row["delivery_uid"],)).fetchone()
+            try:
+                _process(conn, hub, row, own, board)
+            except (ValueError, OSError, HubError, sqlite3.Error) as exc:
+                _log.info("HOME release %s remains held: %s", row["delivery_uid"], exc)
+    finally:
+        hub.close()
diff --git a/hermes_cli/kanban_release_home_queue.py b/hermes_cli/kanban_release_home_queue.py
new file mode 100644
index 0000000000000000000000000000000000000000..ada8895ef1482ac1416e9dbf5d5cbaa555b4a249
--- /dev/null
+++ b/hermes_cli/kanban_release_home_queue.py
@@ -0,0 +1,118 @@
+"""Durable HOME intake/custody, independent of the worker operator ledger.
+
+Rows are transport bookkeeping only. No stage grants release or execution.
+Immutable carrier bytes and a once-frozen consume identity survive restarts.
+"""
+from __future__ import annotations
+
+import json
+import re
+
+from hermes_cli import kanban_release_certificate as cert, kanban_release_intent as intent
+
+TABLE = "owner_release_home_queue"
+LIMIT = 262144
+_FIELDS = {"uid", "task_id", "run_uid", "kind", "payload", "created_at", "hlc", "origin_gateway", "deleted_at"}
+_PAYLOAD = {"version", "carrier", "action", "request_uid", "board", "target_task_id", "home", "intent", "digest", "seen_comments", "nonce"}
+
+
+def carrier(value):
+    return isinstance(value, dict) and (value.get("carrier") == "owner_release" or value.get("action") == "owner_release")
+
+
+def validate(row, board, own):
+    """Pure validation; the caller must independently authenticate the row."""
+    if (not isinstance(row, dict) or not _FIELDS <= set(row) or row["deleted_at"] is not None
+            or row["run_uid"] is not None or row["kind"] != "operator_call_requested"
+            or not intent._coordinate(row["uid"]) or type(row["created_at"]) is not int
+            or row["created_at"] < 0 or not isinstance(row["payload"], str) or len(row["payload"]) > LIMIT):
+        raise ValueError("invalid HOME release carrier event")
+    p = cert.parse(row["payload"])
+    if not cert._exact(p, _PAYLOAD):
+        raise ValueError("invalid HOME release carrier fields")
+    body = intent.validate(p["intent"])
+    if (type(p["version"]) is not int or p["version"] != 1 or p["carrier"] != "owner_release" or p["action"] != "owner_release"
+            or p["request_uid"] != row["uid"] or p["board"] != board or body["board"] != board
+            or p["target_task_id"] != row["task_id"] or body["task_id"] != row["task_id"]
+            or p["home"] != own or body["home"] != own or body["actor"]["gateway"] == own
+            or row["origin_gateway"] != body["actor"]["gateway"] or p["digest"] != intent.digest(body)
+            or cert.encode(p["intent"]) != cert.encode(body) or row["uid"] == body["intent_uid"]
+            or not isinstance(p["nonce"], str) or re.fullmatch(r"[a-f0-9]{64}", p["nonce"]) is None
+            or not cert._comments(p["seen_comments"], body["task_id"])):
+        raise ValueError("HOME release carrier identity differs")
+    if (not isinstance(row["hlc"], str) or re.fullmatch(r"[0-9]{13}-[0-9]{4}-" + re.escape(body["actor"]["gateway"]), row["hlc"]) is None
+            or len(json.dumps(p["seen_comments"], ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode("utf-8", errors="backslashreplace")) > 131072):
+        raise ValueError("HOME release carrier clock or inventory bound differs")
+    return p
+
+
+def install(conn):
+    conn.execute(f"CREATE TABLE IF NOT EXISTS {TABLE} (delivery_uid TEXT PRIMARY KEY, board TEXT NOT NULL, "
+                 "task_id TEXT NOT NULL, payload TEXT NOT NULL, created_at INTEGER NOT NULL, intent_uid TEXT NOT NULL, "
+                 "stage TEXT NOT NULL, consume_wire TEXT, wire_digest TEXT, checked INTEGER NOT NULL DEFAULT 0)")
+    conn.execute("CREATE TABLE IF NOT EXISTS owner_release_home_scan (board TEXT PRIMARY KEY,last_id INTEGER NOT NULL,last_uid TEXT)")
+    abort = "BEGIN SELECT RAISE(ABORT,'HOME release custody immutable'); END"
+    conn.execute(f"CREATE TRIGGER IF NOT EXISTS {TABLE}_delete BEFORE DELETE ON {TABLE} {abort}")
+    conn.execute(f"CREATE TRIGGER IF NOT EXISTS {TABLE}_replace BEFORE INSERT ON {TABLE} "
+                 f"WHEN EXISTS(SELECT 1 FROM {TABLE} WHERE delivery_uid=NEW.delivery_uid OR rowid=NEW.rowid) {abort}")
+    conn.execute(f"CREATE TRIGGER IF NOT EXISTS {TABLE}_update BEFORE UPDATE ON {TABLE} WHEN "
+                 "NEW.delivery_uid IS NOT OLD.delivery_uid OR NEW.board IS NOT OLD.board OR NEW.task_id IS NOT OLD.task_id "
+                 "OR NEW.payload IS NOT OLD.payload OR NEW.created_at IS NOT OLD.created_at OR NEW.intent_uid IS NOT OLD.intent_uid "
+                 "OR (OLD.consume_wire IS NOT NULL AND (NEW.consume_wire IS NOT OLD.consume_wire OR NEW.wire_digest IS NOT OLD.wire_digest)) "
+                 "OR NOT (NEW.stage=OLD.stage OR (OLD.stage='observed' AND NEW.stage='prepared') "
+                 "OR (OLD.stage='prepared' AND NEW.stage='consume_pending') "
+                 "OR (OLD.stage='consume_pending' AND NEW.stage='consumed_pending_apply')) " + abort)
+    conn.execute(f"CREATE INDEX IF NOT EXISTS idx_home_release_pending ON {TABLE}(board,stage,checked)")
+    conn.execute(f"CREATE INDEX IF NOT EXISTS idx_home_release_intent ON {TABLE}(board,intent_uid)")
+
+
+def exists(conn):
+    return conn.execute("SELECT 1 FROM sqlite_master WHERE name=?", (TABLE,)).fetchone() is not None
+
+
+def intake(conn, rep, board, own):
+    """At most 16 bounded carrier payloads per tick, atomic with own UID cursor.
+
+    Invalid shapes advance, while authenticated I/O retries rotate in the queue.
+    Existing worker scan watermarks/refusals have no suppression authority here.
+    """
+    from hermes_cli import kanban_db as kb, kanban_operator_call as operator
+    last = 0
+    if exists(conn):
+        saved = conn.execute("SELECT last_id,last_uid FROM owner_release_home_scan WHERE board=?", (board,)).fetchone()
+        if saved and operator._uid_at(rep, saved[0]) == saved[1]:
+            last = saved[0]
+    rows = rep.execute("SELECT id,uid,task_id,created_at,payload FROM task_events WHERE id>? "
+                       "AND kind='operator_call_requested' AND length(CAST(payload AS BLOB))<=? AND json_valid(payload) "
+                       "AND (json_extract(payload,'$.carrier')='owner_release' OR json_extract(payload,'$.action')='owner_release') "
+                       "ORDER BY id LIMIT 16", (last, LIMIT)).fetchall()
+    if not rows:
+        return
+    with kb.write_txn(conn):
+        install(conn)
+        for eid, uid, task, created, raw in rows:
+            try:
+                p = cert.parse(raw)
+                body = intent.validate(p.get("intent"))
+            except (ValueError, TypeError):
+                continue
+            if p.get("home") != own or body["home"] != own or body["board"] != board:
+                continue
+            old = conn.execute(f"SELECT payload,task_id,created_at FROM {TABLE} WHERE delivery_uid=?", (uid,)).fetchone()
+            if old is None:
+                conn.execute(f"INSERT INTO {TABLE} (delivery_uid,board,task_id,payload,created_at,intent_uid,stage) "
+                             "VALUES (?,?,?,?,?,?,'observed')", (uid, board, task, raw, created, body["intent_uid"]))
+        conn.execute("INSERT INTO owner_release_home_scan VALUES (?,?,?) ON CONFLICT(board) DO UPDATE SET "
+                     "last_id=excluded.last_id,last_uid=excluded.last_uid", (board, rows[-1][0], rows[-1][1]))
+
+
+def wire(row):
+    p = cert.parse(row["payload"])
+    op = cert.parse(row["consume_wire"])
+    expected = {"client_op_id": op.get("client_op_id"), "op": "consume_owner_release", "task": row["task_id"],
+                "intent_uid": row["intent_uid"], "digest": p["digest"], "seen_comments": p["seen_comments"]}
+    if (cert.encode(op) != row["consume_wire"] or intent.digest(op) != row["wire_digest"]
+            or cert.encode(op) != cert.encode(expected) or not intent._coordinate(op["client_op_id"])
+            or op["client_op_id"] in {row["delivery_uid"], row["intent_uid"]}):
+        raise ValueError("HOME release consume journal changed")
+    return op
diff --git a/tests/hermes_cli/test_owner_release_home.py b/tests/hermes_cli/test_owner_release_home.py
new file mode 100644
index 0000000000000000000000000000000000000000..70ef9ca0b0f0b82148b78446156f786f026d0161
--- /dev/null
+++ b/tests/hermes_cli/test_owner_release_home.py
@@ -0,0 +1,153 @@
+"""HOME real operator entrypoint. Board adapter is not a real DO composition."""
+from __future__ import annotations
+
+import copy
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_operator_call as operator
+from hermes_cli import kanban_release_certificate as certificate, kanban_release_intent as intent
+from tests.hermes_cli import test_kanban_operator_call as helpers
+
+fleet = helpers.fleet
+
+
+@pytest.fixture
+def home(fleet, monkeypatch):
+    from hermes_cli import kanban_release_home as subject
+    f = fleet
+    body = dict(version=1, intent_uid="intent-home", board="default", task_id=f.target, home="hub",
+                actor=dict(gateway="worker-5", profile="default", session="native-chat"), episode="scope-now",
+                capability_episodes=["old-capability"], runs=2, note="Resume the original goal")
+    p = dict(version=1, carrier="owner_release", action="owner_release", request_uid="delivery-home", board="default",
+             target_task_id=f.target, home="hub", intent=body, digest=intent.digest(body), seen_comments=[], nonce="a" * 64)
+    event = dict(uid=p["request_uid"], task_id=f.target, run_uid=None, kind=operator.REQUEST_KIND,
+                 payload=certificate.encode(p), created_at=100, hlc="1795700000000-0000-worker-5", origin_gateway="worker-5",
+                 deleted_at=None)
+    with kb.write_txn(f.rep):
+        f.rep.execute("INSERT INTO task_events (uid,task_id,kind,payload,created_at) VALUES (?,?,?,?,?)",
+                      tuple(event[k] for k in ("uid", "task_id", "kind", "payload", "created_at")))
+    class Hub:
+        ident = SimpleNamespace(gateway="hub")
+        def __init__(self):
+            self.state, self.calls, self.down, self.winner = "authorized", [], False, None
+        def outside(self):
+            assert not f.h.in_transaction
+            if self.down:
+                raise OSError("network unavailable")
+        def row_evidence(self, *a, **kw):
+            self.outside()
+            return dict(board="default", table="task_events", uid=event["uid"], state="live", row=copy.deepcopy(event))
+        def owner_release_evidence(self, *a):
+            self.outside()
+            return dict(version=1, intent=body, digest=intent.digest(body), state=self.state)
+        def owner_release_consumption(self, *a):
+            self.outside()
+            return self.winner
+        def ops(self, board, ops):
+            self.outside()
+            self.calls.append(copy.deepcopy(ops[0]))
+            raise OSError("lost reply")
+        def close(self):
+            pass
+    hub = Hub()
+    monkeypatch.setattr(subject, "_hub", lambda: hub)
+    return SimpleNamespace(f=f, body=body, payload=p, event=event, hub=hub, subject=subject)
+
+
+def queued(h):
+    return h.f.h.execute("SELECT * FROM owner_release_home_queue WHERE delivery_uid='delivery-home'").fetchone()
+
+
+def test_real_operator_entrypoint_freezes_before_network_and_reopens(home):
+    h = home
+    before = tuple(h.f.h.execute("SELECT status,current_run_id FROM tasks WHERE id=?", (h.f.target,)).fetchone())
+    operator.apply_incoming(h.f.h)
+    row = queued(h)
+    assert row["stage"] == "consume_pending"
+    frozen = row["consume_wire"]
+    assert h.hub.calls == [json.loads(frozen)]
+    assert not h.f.h.execute("SELECT 1 FROM operator_calls WHERE request_uid='delivery-home'").fetchone()
+    from hermes_cli import kanban_db_connect as connections
+    path = h.f.h.execute("PRAGMA database_list").fetchone()[2]
+    h.f.h.close()
+    from pathlib import Path
+    h.f.h = connections.connect(Path(path))
+    h.f.gw[id(h.f.h)] = "hub"
+    operator.apply_incoming(h.f.h)
+    assert h.hub.calls == [json.loads(frozen), json.loads(frozen)]
+    assert queued(h)["consume_wire"] == frozen
+    assert tuple(h.f.h.execute("SELECT status,current_run_id FROM tasks WHERE id=?", (h.f.target,)).fetchone()) == before
+
+
+def test_old_generic_refusal_and_watermark_do_not_suppress_home_queue(home):
+    h = home
+    with kb.write_txn(h.f.h):
+        operator.ensure_schema(h.f.h)
+        operator.log(h.f.h, request_uid="delivery-home", side="execute", outcome="refused")
+        eid = h.f.rep.execute("SELECT MAX(id) FROM task_events").fetchone()[0]
+        uid = h.f.rep.execute("SELECT uid FROM task_events WHERE id=?", (eid,)).fetchone()[0]
+        h.f.h.execute("INSERT INTO operator_call_scan VALUES (?,?,?)", ("default", eid, uid))
+    operator.apply_incoming(h.f.h)
+    assert queued(h)["stage"] == "consume_pending" and len(h.hub.calls) == 1
+
+
+@pytest.mark.parametrize("key,value", [("origin_gateway", "other-gateway"), ("deleted_at", 1), ("run_uid", "a-run"),
