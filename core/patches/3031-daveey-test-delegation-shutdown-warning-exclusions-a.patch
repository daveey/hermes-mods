From 92ca0ce9cfe613831a83f726f9441f2caacafe84 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 19:40:22 +0000
Subject: [PATCH] [daveey] test delegation shutdown warning exclusions and
 closed-chat logging

Proof: 42 tests passed across the three targeted files; M7 removal fails 3 new cases, M8 removal fails both non-delegation and interim-notice cases, M9 removal fails the cron case. Production code unchanged. scripts/check: 18 checks OK.
---
 .../test_unviewed_delegation_failure_turn.py  |  6 +++-
 ...est_delegate_shutdown_stop_wakes_parent.py | 35 +++++++++++++++++++
 2 files changed, 40 insertions(+), 1 deletion(-)

diff --git a/tests/gateway/test_unviewed_delegation_failure_turn.py b/tests/gateway/test_unviewed_delegation_failure_turn.py
index 4f55f20989..7594f1b050 100644
--- a/tests/gateway/test_unviewed_delegation_failure_turn.py
+++ b/tests/gateway/test_unviewed_delegation_failure_turn.py
@@ -264,7 +264,7 @@ async def test_unattended_wakes_stop_at_the_limit_until_the_user_returns(tmp_pat
 
 
 @pytest.mark.asyncio
-async def test_failure_in_a_chat_its_viewer_closed_stays_a_note(tmp_path, monkeypatch):
+async def test_failure_in_a_chat_its_viewer_closed_stays_a_note(tmp_path, monkeypatch, caplog):
     """Exit or /new ends the session's background work and refuses new dispatches: a wake there would
     run its re-dispatched child inside the wake turn of a chat nobody will reopen. A viewer attaching
     lifts the refusal, and the next failure wakes again."""
@@ -276,9 +276,13 @@ async def test_failure_in_a_chat_its_viewer_closed_stays_a_note(tmp_path, monkey
         seen = _turns(runner, authority, target, "deleg_closed")
         await _fail(runner, authority, ref, route, target, "deleg_closed0")
         assert seen == [] and len(_notes(authority, target, "deleg_closed0")) == 1
+        warnings = [r.getMessage() for r in caplog.records if "not woken" in r.getMessage()]
+        assert len(warnings) == 1 and "its chat was closed" in warnings[0]
+        caplog.clear()
         delegation.allow_for_session(token)
         await _fail(runner, authority, ref, route, target, "deleg_closed1")
         assert len(seen) == 1 and "deleg_closed1" in seen[0][0]
+        assert not any("not woken" in r.getMessage() for r in caplog.records)
     finally:
         authority.db.close()
 
diff --git a/tests/tools/test_delegate_shutdown_stop_wakes_parent.py b/tests/tools/test_delegate_shutdown_stop_wakes_parent.py
index 88dbd3c575..577e38f2d1 100644
--- a/tests/tools/test_delegate_shutdown_stop_wakes_parent.py
+++ b/tests/tools/test_delegate_shutdown_stop_wakes_parent.py
@@ -7,6 +7,9 @@ asked. ``interrupt_all(..., by_shutdown=True)`` now stamps why the unit stopped
 stamped stop counts as a failure the parent must act on (re-dispatch or tell the user).
 """
 import threading
+from types import SimpleNamespace
+
+import pytest
 
 from tests.tools.test_async_delegation import _drain_for
 from tools import async_delegation as ad
@@ -65,6 +68,38 @@ def test_shutdown_stop_of_a_single_unit_is_stamped_and_wakes_the_parent():
     assert "not by you or the user" in (format_process_notification(evt) or "")
 
 
+@pytest.mark.parametrize("statuses", [("completed",), ("failed",), ("completed", "failed")])
+def test_shutdown_stamp_without_stopped_children_has_no_stop_guidance(statuses):
+    evt = {"type": "async_delegation", "is_batch": True, "delegation_id": "deleg_done",
+           "interrupted_by": "gateway shutdown (restart)", "goals": ["work"] * len(statuses),
+           "results": [{"task_index": i, "status": status, "summary": "result"}
+                       for i, status in enumerate(statuses)]}
+    text = format_process_notification(evt) or ""
+    assert "deleg_done" in text
+    assert "stopped by" not in text
+    assert delegation_wakes_parent(evt) is ("failed" in statuses)
+
+
+@pytest.mark.parametrize("extra,warns", [
+    ({}, True),
+    ({"type": "completion"}, False),
+    ({"task_failure_notice": True}, False),
+    ({"role": "cron_run"}, False),
+])
+def test_requested_stop_warning_only_for_final_delegations(caplog, extra, warns):
+    from gateway.config import Platform
+    from gateway.run_notifications import _watch_notification_metadata
+
+    evt = {"type": "async_delegation", "delegation_id": "deleg_warning", "status": "interrupted",
+           "parent_session_id": "parent-warning", **extra}
+    metadata = _watch_notification_metadata(evt, SimpleNamespace(platform=Platform.LOCAL))
+    assert not metadata.get("completion_wakes_parent")
+    warnings = [record.getMessage() for record in caplog.records if "not woken" in record.getMessage()]
+    assert bool(warnings) is warns, warnings
+    if warns:
+        assert "parent-warning" in warnings[0] and "interrupted" in warnings[0]
+
+
 def test_requested_stop_stays_asleep():
     """``/stop`` (and any caller that does not say shutdown) is a stop someone asked for."""
     delegation_id = _dispatch_batch(threading.Event())
