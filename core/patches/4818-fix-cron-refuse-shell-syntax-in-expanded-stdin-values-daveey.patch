From 00870a0efa53a32f9d02d30ebd1d284d2b1b757e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 16:01:31 +0000
Subject: [PATCH] fix(cron): refuse shell syntax in expanded stdin values
 [daveey]

---
 cron/lifecycle_guard_nested_shells.py         |  4 ++-
 ...st_lifecycle_guard_stdin_literal_values.py | 34 +++++++++++++++++++
 2 files changed, 37 insertions(+), 1 deletion(-)
 create mode 100644 tests/cron/test_lifecycle_guard_stdin_literal_values.py

diff --git a/cron/lifecycle_guard_nested_shells.py b/cron/lifecycle_guard_nested_shells.py
index f266cd9412ca3f9fdfaff7af171b3a9ea6facc65..a340c94f1a32aadf3ce979c06766e7f9197c468d 100644
--- a/cron/lifecycle_guard_nested_shells.py
+++ b/cron/lifecycle_guard_nested_shells.py
@@ -921,7 +921,9 @@ def _expanded_targets(target: str, variables: dict[str, list[str]]) -> Optional[
         name = match.group(1) or match.group(2)
         values = variables.get(name) or ([os.environ[name]] if name in os.environ else [])
         steps += len(values)
-        if not values or steps > _MAX_EXPANSIONS:
+        # Expansion results are data, never fresh shell syntax. Our path walker
+        # cannot preserve quoting for these characters, so retain uncertainty.
+        if not values or steps > _MAX_EXPANSIONS or any(_unresolvable(value) for value in values):
             return None
         pending.extend(word[:match.start()] + value + word[match.end():] for value in values)
     return words
diff --git a/tests/cron/test_lifecycle_guard_stdin_literal_values.py b/tests/cron/test_lifecycle_guard_stdin_literal_values.py
new file mode 100644
index 0000000000000000000000000000000000000000..442d7121ef1abe085bef0321c5f9e7ab0519045c
--- /dev/null
+++ b/tests/cron/test_lifecycle_guard_stdin_literal_values.py
@@ -0,0 +1,34 @@
+import os
+import subprocess
+import pytest
+from cron.lifecycle_guard import scan_gateway_lifecycle
+
+@pytest.mark.parametrize('command', [
+    'bash --noprofile -l < "$S"',
+    'P=$S; bash --noprofile -l < "$P"',
+    'exec 3<"$S"; bash --noprofile -l <&3',
+])
+def test_environment_value_is_not_shell_source(tmp_path, monkeypatch, command):
+    monkeypatch.setenv('S', '$T')
+    monkeypatch.setenv('T', '/dev/null')
+    script = tmp_path / '$T'
+    script.write_text("printf 'REVIEW_LITERAL_EXECUTED\\n'\n")
+    result = subprocess.run(['/bin/bash', '--noprofile', '--norc', '-c', command], cwd=tmp_path,
+        env=dict(os.environ, HOME=str(tmp_path), BASH_ENV='/dev/null'), input='', text=True,
+        capture_output=True, timeout=10, check=False)
+    assert result.returncode == 0 and result.stdout == 'REVIEW_LITERAL_EXECUTED\n', result
+    script.write_text('t ( bash huge.sh )\n')
+    (tmp_path / 'huge.sh').write_text('# padding\n' * 130000)
+    result = scan_gateway_lifecycle(command, cwd=str(tmp_path), session_aliases=frozenset({'zz'}))
+    assert result[0], result
+
+
+def test_regular_environment_path_controls(tmp_path, monkeypatch):
+    script = tmp_path / 'input.sh'
+    monkeypatch.setenv('S', str(script))
+    script.write_text('t ( bash huge.sh )\n')
+    (tmp_path / 'huge.sh').write_text('# padding\n' * 130000)
+    command = 'bash --noprofile -l < "$S"'
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path), session_aliases=frozenset({'zz'}))[0]
+    script.write_text('printf harmless\n')
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path), session_aliases=frozenset({'zz'})) == (False, None)
-- 
