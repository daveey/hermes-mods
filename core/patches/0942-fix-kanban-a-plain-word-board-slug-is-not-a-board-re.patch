From 004623277de54b96e2761fc4552dd577a42d6163 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 08:51:50 +0000
Subject: [PATCH] fix(kanban): a plain-word board slug is not a board reference
 [daveey]

create_overlap treated any bare slug token in the title as naming that
board. The mini ci-runners alarm title contains "runners", so every
create exited 2 against open cards on board runners that shared one
other word (stall.log 2026-10-28 20:42-21:28 PDT).

A plain alphabetic slug now counts only via an explicit reference
(/slug, board slug, slug board). A hyphenated slug in the title still
counts. Tool, CLI and REST alarm creates are covered.
---
diff --git a/hermes_cli/kanban_overlap.py b/hermes_cli/kanban_overlap.py
index 854644b425..b32cc46ac5 100644
--- a/hermes_cli/kanban_overlap.py
+++ b/hermes_cli/kanban_overlap.py
@@ -6,10 +6,14 @@ open cards on every board of this gateway (live board DBs) and every other gatew
 ``hub.db``), so the answer no longer depends on which chat asks or which board the card lands on.
 
 An open card matches when:
-- the new card names its board (the slug in the title, or ``/<slug>`` / ``board <slug>`` in the body, e.g. a
-  ``example-org/<slug>`` repo), is not being created on that board, and the titles share a word, or
+- the new card names its board, is not being created on that board, and the titles share a word, or
 - both titles share at least half of the longer title's significant words (3 or more).
 
+Naming a board means an explicit reference (``/<slug>``, ``board <slug>``, ``<slug> board``) in the
+title or body, or the slug itself in the title when the slug is not a single plain word
+(``unconventional-collab``, not ``runners`` or ``hermes``). A bare plain word that equals a board
+slug does not count.
+
 Never matched: closed cards, the creator's own card, the new card's parents, cards the same chat or the same
 worker created (fan-out), the waiting card a capability-owner create quotes, and another capability-owner
 card for that same waiting card. A missing or unreadable replica is skipped and logged, never a block.
@@ -45,13 +49,38 @@ def words(text: str) -> set[str]:
     return {w for w in re.findall(r"[a-z0-9]+", (text or "").lower()) if len(w) >= 2 and w not in _STOP}
 
 
+def _plain_word_slug(slug: str) -> bool:
+    """True when the slug is one alphabetic word (``runners``, ``hermes``, ``bb``).
+
+    A hyphen, underscore or digit (``unconventional-collab``) is specific enough that the
+    slug itself in the title still names the board. A plain word is an ordinary word.
+    """
+    return bool(re.fullmatch(r"[a-z]+", (slug or "").lower()))
+
+
+def _explicit_board_ref(slug: str, text: str) -> bool:
+    """``/<slug>`` (``hub/runners``, ``Metta-AI/<slug>``), ``board <slug>`` or ``<slug> board``."""
+    s = re.escape((slug or "").lower())
+    if not s:
+        return False
+    return bool(re.search(
+        rf"(?:/|\bboard[\s:=`'\\\"]+){s}(?![a-z0-9_-])"
+        rf"|(?<![a-z0-9_-]){s}(?![a-z0-9_-])[\s:=`'\\\"]+board\b",
+        (text or "").lower(),
+    ))
+
+
 def _names_board(slug: str, title: str, body: str) -> bool:
     if not slug or slug == "default":
         return False
-    s = re.escape(slug.lower())
-    if re.search(rf"(?<![a-z0-9_-]){s}(?![a-z0-9_-])", (title or "").lower()):
+    if _explicit_board_ref(slug, title) or _explicit_board_ref(slug, body):
         return True
-    return bool(re.search(rf"(?:/|\bboard[\s:=`'\"]+){s}(?![a-z0-9_-])", (body or "").lower()))
+    # A bare slug token in the title names the board only when it is not a plain word.
+    # "runners" in "bb-linux runners can't run jobs" is not a board reference.
+    if _plain_word_slug(slug):
+        return False
+    s = re.escape(slug.lower())
+    return bool(re.search(rf"(?<![a-z0-9_-]){s}(?![a-z0-9_-])", (title or "").lower()))
 
 
 def _reasons(card: dict, new_words: set[str], title: str, body: str, target_board: str) -> tuple[list[str], float]:
diff --git a/tests/tools/test_kanban_create_overlap.py b/tests/tools/test_kanban_create_overlap.py
index 605eb2ff1f..2ca6307542 100644
--- a/tests/tools/test_kanban_create_overlap.py
+++ b/tests/tools/test_kanban_create_overlap.py
@@ -186,3 +186,99 @@ def test_a_board_named_in_passing_with_an_unrelated_title_is_not_a_match(home):
     out = _create(title="Rotate the Telnyx API key",
                   body="Logs are under ~/.hermes/kanban/boards/research-x/ for reference.")
     assert out.get("ok") is True, out
+
+
+# Mini bb_stall, 2026-10-28 20:42-21:28 PDT: every ci-runners alarm create exited 2.
+# stall.log: "rc=2 from EC2 — the new card names board 'runners'". The alarm title is
+# "CI: bb-linux runners can't run jobs (...)" and open hub/runners cards share the word "bb"
+# (t_625bc2b7 ends "from EC2"). A plain-word board slug in the title is not naming that board.
+ALARM_TITLE = ("CI: bb-linux runners can't run jobs "
+               "(1 bb-linux job(s) queued > 30 min (oldest 0.5 h))")
+ALARM_BODY = (
+    "The merge train and every bb-linux CI job stall until a runner can start jobs.\n"
+    "1 bb-linux job(s) queued > 30 min (oldest 0.5 h).\n"
+    "Runners: metta1 online, 48 GB free.\n"
+    "Disk full: free space or add a runner (tools/ci-runner/install-linux.sh).")
+RUNNERS_TITLE = ("Runners L: real end-to-end natural-language macOS routing, "
+                 "workspace build and BB action from EC2")
+
+
+def _runners_owner():
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_boards as kbb
+    from hermes_cli import kanban_db_connect as kbc
+    kbb.create_board("runners")
+    conn = kbc.connect(board="runners")
+    try:
+        return kb.create_task(conn, title=RUNNERS_TITLE, assignee="default",
+                              session_id="other-chat")
+    finally:
+        conn.close()
+
+
+def test_plain_word_board_slug_in_the_title_does_not_name_that_board(home):
+    owner = _runners_owner()
+    out = _create(title=ALARM_TITLE, body=ALARM_BODY)
+    assert out.get("code") != "create_overlap", out
+    assert out.get("ok") is True, out
+    assert owner not in [m.get("id") for m in out.get("matches") or []]
+
+
+def test_bare_plain_word_in_the_body_does_not_name_that_board(home):
+    """'runners' or 'hermes' as an ordinary word, with no /slug or 'board slug', is not a reference."""
+    _runners_owner()
+    out = _create(title="CI: bb-linux fleet is down",
+                  body="The runners are fine and hermes logs are unrelated. The bb fleet disk is full.")
+    assert out.get("ok") is True, out
+
+
+def test_explicit_board_reference_still_names_the_board(home):
+    owner = _runners_owner()
+    out = _create(title="CI: bb-linux fleet is down",
+                  body="See hub/runners. The bb fleet is stuck.")
+    assert out.get("code") == "create_overlap", out
+    assert owner in [m["id"] for m in out["matches"]]
+    named = _create(title="CI: the bb runners board is down", body="The bb fleet is stuck.")
+    assert named.get("code") == "create_overlap", named
+    assert owner in [m["id"] for m in named["matches"]]
+
+
+def test_hyphenated_slug_in_the_title_still_names_the_board(home):
+    owner = _board_with_b1()
+    out = _create(title="external-anchor rescoring on unconventional-collab",
+                  body="notes, no slash path and no 'board' marker")
+    assert out.get("code") == "create_overlap", out
+    assert owner in [m["id"] for m in out["matches"]]
+
+
+def test_cli_alarm_create_is_not_refused_for_a_plain_word_board_slug(home, monkeypatch, capsys):
+    """The mini alarm files via `hermes kanban create`, the path that exited 2."""
+    import argparse
+    from hermes_cli import kanban as kc
+    _runners_owner()
+    monkeypatch.setattr(kc, "_check_dispatcher_presence", lambda **kw: (True, ""))
+    root = argparse.ArgumentParser(prog="hermes")
+    kc.build_parser(root.add_subparsers())
+    # --board is a group flag pinned before the verb (alarm: `kanban --board default create`).
+    # Omitting it uses the current board, which this fixture's create also targets.
+    rc = kc._cmd_create(root.parse_args([
+        "kanban", "create", ALARM_TITLE, "--body", ALARM_BODY,
+        "--assignee", "default", "--json"]))
+    captured = capsys.readouterr()
+    assert rc == 0, (rc, captured.out, captured.err)
+    assert "create_overlap" not in captured.err
+
+
+def test_rest_alarm_create_is_not_refused_for_a_plain_word_board_slug(home):
+    """Dashboard POST /tasks uses the same overlap check as the tool and the CLI."""
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+    from plugins.kanban.dashboard.plugin_api import router
+    _runners_owner()
+    app = FastAPI()
+    app.include_router(router)
+    with TestClient(app) as client:
+        r = client.post("/tasks", json={"title": ALARM_TITLE, "body": ALARM_BODY, "assignee": "default"})
+    assert r.status_code != 409, r.text
+    assert r.status_code == 200, r.text
+    assert "create_overlap" not in r.text

