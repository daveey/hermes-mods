     with early.early_sessions(headless=True, isolated=False) as owner:
@@ -389,3 +398,14 @@
     seen = _boot_signal('runtime-close', signum, 'exits')
     assert seen['events'] == ['yielded', 'signal', 'feed-closed', 'previous'] and seen['code'] == 123
