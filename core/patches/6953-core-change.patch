+
     def _deliver_queue(self):
-        if self.pending:  # depth > 0: no handler can pop or run in between
-            signum, frame = self.pending.pop(0)
-            try:
-                self._act(signum, frame)
-            finally:
-                self._deliver_queue()
+        found = self._next()  # depth > 0: a handler arriving now only queues
+        if found is None:
