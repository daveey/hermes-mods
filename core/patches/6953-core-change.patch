+            if other[0] == signum and not other[1] & self._DELIVERED:
+                other[1] |= self._DELIVERED
+                if other[1] & self._RETURNED:
+                    self._queue.pop(other_key, None)
+        try:
+            self._act(signum, key)
+        finally:
