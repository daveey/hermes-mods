         const name = typeof status?.gateway === 'string' ? status.gateway.trim() : ''
 
@@ -154,7 +161,7 @@ export function installTranscriptCache(deps: TranscriptCacheHostDeps) {
   const prefetcher = new TranscriptPrefetcher({
