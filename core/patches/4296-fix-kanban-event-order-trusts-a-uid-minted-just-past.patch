 from hermes_cli import kanban_shared_blocker_checks as checks
-from hermes_cli.kanban_shared_blocker_fence import _uid_before_check
+from hermes_cli.kanban_shared_blocker_fence import _uid_before_check, consistent_uid_milliseconds
 
 
 def _claim_uid(milliseconds, *, version=7, suffix=0):
@@ -60,6 +60,40 @@ def test_same_second_requires_strictly_earlier_milliseconds(claimed_ms, expected
                              {'checked_at_ms': 1200}) is expected
 
 
+@pytest.mark.parametrize(('claimed_ms', 'seconds', 'expected'), [
+    pytest.param(1000, 1, 1000, id='first-millisecond-of-own-second'),
+    pytest.param(1999, 1, 1999, id='last-millisecond-of-own-second'),
+    pytest.param(2010, 1, 2010, id='straddle-10ms-into-next-second'),
+    pytest.param(2999, 1, 2999, id='last-straddle-millisecond'),
+    pytest.param(3000, 1, None, id='past-the-straddle-window'),
+    pytest.param(999, 1, None, id='before-own-second'),
+    pytest.param(1500, None, None, id='no-seconds'),
+    pytest.param(1500, 1.0, None, id='float-seconds'),
+    pytest.param(1500, True, None, id='bool-is-not-a-seconds-clock'),
+])
+def test_consistent_uid_milliseconds_window(claimed_ms, seconds, expected):
+    assert consistent_uid_milliseconds(_claim_uid(claimed_ms), seconds) == expected
+
+
+def test_a_straddled_claim_is_never_before_a_same_second_check():
+    # A claim uid minted in second+1 is after any check of second `started`: the fence keeps its fallback.
+    assert _uid_before_check(_claim_uid(2010), 1, {'checked_at_ms': 1999}) is False
+
+
+def test_shared_blocker_event_order_keeps_a_straddled_uid_after_its_second():
+    from hermes_cli.kanban_shared_blockers import _event_order
+    straddled = {'id': 1, 'created_at': 1, 'uid': _claim_uid(2010)}
+    in_second = {'id': 2, 'created_at': 1, 'uid': _claim_uid(1700)}
+    backfilled = {'id': 3, 'created_at': 1, 'uid': _claim_uid(3000)}
+    assert _event_order(_Row(straddled)) == (2010, 1)
+    assert _event_order(_Row(backfilled)) == (1000, 3)
+    assert _event_order(_Row(straddled)) > _event_order(_Row(in_second)) > _event_order(_Row(backfilled))
+
+
+class _Row(dict):
+    """sqlite3.Row stand-in: mapping access plus keys()."""
+
+
 @pytest.mark.platforms('posix')
 def test_default_registered_check_runs_nonexecutable_stub_in_profile_home_with_spaces(
         tmp_path, monkeypatch):
diff --git a/tests/hermes_cli/test_kanban_stale_wake_terminal.py b/tests/hermes_cli/test_kanban_stale_wake_terminal.py
index 8dbeb2eed1..836366df36 100644
--- a/tests/hermes_cli/test_kanban_stale_wake_terminal.py
+++ b/tests/hermes_cli/test_kanban_stale_wake_terminal.py
@@ -503,6 +503,39 @@ def test_terminal_hold_still_orders_one_second_by_a_consistent_uid_clock():
     assert ktg.terminal_hold(conn, "t") is None
 
 
+@pytest.mark.parametrize("straddler,other,held", [
+    pytest.param("completed", "reopened", 1, id="straddled-terminal-after-same-second-reopen"),
+    pytest.param("reopened", "completed", None, id="straddled-reopen-after-same-second-terminal"),
+])
+def test_terminal_hold_trusts_a_uid_minted_just_past_the_rows_second(straddler, other, held):
+    """created_at is read before the INSERT and the uid is minted by the AFTER INSERT trigger, so a write straddling
+    the boundary carries a uid ~10 ms into second+1. It is still event time: the straddler (arrived first, id 1) is
+    the later event of second 500, not sorted at 500.000 before the reopen/terminal minted at 500.700."""
+    import sqlite3
+    conn = sqlite3.connect(":memory:")
+    conn.row_factory = sqlite3.Row
+    conn.execute("CREATE TABLE task_events (id INTEGER PRIMARY KEY, uid TEXT, task_id TEXT, kind TEXT, payload TEXT, "
+                 "created_at INTEGER)")
+    conn.execute("INSERT INTO task_events VALUES (1, ?, 't', ?, '{}', 500)", (_v7_at(501_010), straddler))
+    conn.execute("INSERT INTO task_events VALUES (2, ?, 't', ?, '{}', 500)", (_v7_at(500_700), other))
+    hold = ktg.terminal_hold(conn, "t")
+    assert (hold and hold["id"]) == held
+
+
+@pytest.mark.parametrize("uid_ms", [502_000, 509_000, 900_123])
+def test_terminal_hold_distrusts_a_uid_past_the_straddle_window(uid_ms):
+    """A uid stamped a full second or more past created_at's second is a backfill, not event time: the terminal that
+    arrived first falls back to 500.000 and the in-second reopen (500.700) stays later, so there is no hold."""
+    import sqlite3
+    conn = sqlite3.connect(":memory:")
+    conn.row_factory = sqlite3.Row
+    conn.execute("CREATE TABLE task_events (id INTEGER PRIMARY KEY, uid TEXT, task_id TEXT, kind TEXT, payload TEXT, "
+                 "created_at INTEGER)")
+    conn.execute("INSERT INTO task_events VALUES (1, ?, 't', 'completed', '{}', 500)", (_v7_at(uid_ms),))
+    conn.execute("INSERT INTO task_events VALUES (2, ?, 't', 'reopened', '{}', 500)", (_v7_at(500_700),))
+    assert ktg.terminal_hold(conn, "t") is None
+
+
