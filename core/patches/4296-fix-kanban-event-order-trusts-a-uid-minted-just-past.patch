diff --git a/hermes_cli/kanban_shared_blocker_fence.py b/hermes_cli/kanban_shared_blocker_fence.py
index 1279e9e44a..b92e9fc0b6 100644
--- a/hermes_cli/kanban_shared_blocker_fence.py
+++ b/hermes_cli/kanban_shared_blocker_fence.py
@@ -29,14 +29,25 @@ def uid_milliseconds(identity):
     return uid.int >> 80 if uid.version == 7 else None
 
 
+# created_at is read in Python before the INSERT and the uid is minted later by
+# the AFTER INSERT trigger, so a write straddling a second boundary carries a
+# legitimate uid just past created_at's second (replay of local boards: 296 of
+# 957,626 v7 event uids, 259 within 50 ms, max 760 ms). Backfilled uids sit
+# minutes to days out (125k at >= 60 s).
+UID_STRADDLE_MS = 1000
+
+
 def consistent_uid_milliseconds(identity, seconds):
-    """UUIDv7 milliseconds only when they fall in the row's own recorded second.
+    """UUIDv7 milliseconds only when they fall in the row's own recorded second,
+    or within :data:`UID_STRADDLE_MS` after it (a write straddling the boundary).
 
     Sync backfills uid-less rows with a v7 uid stamped at backfill time, so a
-    uid whose second disagrees with the row's seconds clock is not event time.
+    uid stamped later than that is not event time.
     """
     ms = uid_milliseconds(identity)
-    return ms if ms is not None and ms // 1000 == seconds else None
+    if ms is None or type(seconds) is not int:
+        return None
+    return ms if seconds * 1000 <= ms < (seconds + 1) * 1000 + UID_STRADDLE_MS else None
 
 
 def _uid_before_check(identity, started, payload):
diff --git a/hermes_cli/kanban_shared_blockers.py b/hermes_cli/kanban_shared_blockers.py
index 4be1adc4c6..ea9b489a52 100644
--- a/hermes_cli/kanban_shared_blockers.py
+++ b/hermes_cli/kanban_shared_blockers.py
@@ -499,7 +499,8 @@ def _event_order(row) -> tuple[int, int]:
     from hermes_cli.kanban_shared_blocker_fence import consistent_uid_milliseconds
 
     created = kb._to_epoch(row["created_at"]) or 0
-    # A backfilled uid carries backfill time: trust it only inside created_at's second.
+    # A backfilled uid carries backfill time: trust it only inside created_at's second
+    # (or just past it, for a write straddling the boundary).
     stamp = consistent_uid_milliseconds(row["uid"] if "uid" in row.keys() else None, created)
     if stamp is None:
         stamp = created * 1000
diff --git a/hermes_cli/kanban_sync_divergence.py b/hermes_cli/kanban_sync_divergence.py
index 1760f9fe88..17d110f36a 100644
--- a/hermes_cli/kanban_sync_divergence.py
+++ b/hermes_cli/kanban_sync_divergence.py
@@ -228,6 +228,8 @@ def _event_order(event: dict) -> tuple[int, int, int]:
     its 48-bit millisecond orders the two. A row with no uid (sync off, or written while the triggers were down)
     falls back to arrival order, and so does a uid that is not a v7 (its leading bits are random, not time) or a
     v7 outside the row's own second: ``kanban_db_sync`` backfills uid-less rows with a v7 stamped at backfill time.
+    A uid up to ``UID_STRADDLE_MS`` past the second still counts (created_at is read before the INSERT, the uid at
+    it), and sorts last in its own second.
     """
     second = int(event["created_at"] or 0)
     ms = consistent_uid_milliseconds(event.get("uid"), second)
diff --git a/tests/hermes_cli/test_kanban_shared_blocker_uid_precision.py b/tests/hermes_cli/test_kanban_shared_blocker_uid_precision.py
