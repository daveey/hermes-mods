diff --git a/hermes_cli/worker_drain_census.py b/hermes_cli/worker_drain_census.py
index 07fcfc7084..daaa0f7139 100644
--- a/hermes_cli/worker_drain_census.py
+++ b/hermes_cli/worker_drain_census.py
@@ -114,9 +114,18 @@ def baseline_is_live(base: Baseline) -> bool:
 
 
 def process_identity(proc_root: str, pid: str) -> tuple:
-    fields = _read(f'{proc_root}/{pid}/stat').rsplit(')', 1)[1].split()
-    return (int(pid), int(fields[19]), os.stat(f'{proc_root}/{pid}').st_uid,
-            _read_cgroup(proc_root, pid), os.readlink(f'{proc_root}/{pid}/exe'))
+    def sample():
+        fields = _read(f'{proc_root}/{pid}/stat').rsplit(')', 1)[1].split()
+        return (int(pid), int(fields[19]), os.stat(f'{proc_root}/{pid}').st_uid,
+                _read_cgroup(proc_root, pid), os.readlink(f'{proc_root}/{pid}/exe'))
+
+    # procfs is not a transactional snapshot. Reject a restart, exec, uid or
+    # cgroup transition observed while assembling the identity, never mix it
+    # with an older trusted tuple. CPU/state fields may change normally.
+    before = sample()
+    if before != sample():
+        raise ValueError('process changed during identity read')
+    return before
 
 
 def _entry_identity(e: dict) -> tuple:
diff --git a/tests/hermes_cli/test_worker_drain_cron_degrade.py b/tests/hermes_cli/test_worker_drain_cron_degrade.py
new file mode 100644
index 0000000000..c2a97ced6b
--- /dev/null
+++ b/tests/hermes_cli/test_worker_drain_cron_degrade.py
@@ -0,0 +1,26 @@
+"""Legacy cron fail-open cannot leave an activated daemon exempt from /proc."""
+import pytest
+
+from cron import scheduler_tick as tick
+from hermes_cli import admission_fence
+from hermes_cli import worker_drain_capability as cap
+
+
+@pytest.mark.parametrize('unavailable', ['unsupported', 'reserve_oserror'])
+def test_failopen_revokes_exemption_before_dispatch(monkeypatch, unavailable):
+    from cron import scheduler
+    from hermes_cli import backend_retirement
+    events = []
+    monkeypatch.setattr(cap, 'revoke', lambda reason: events.append('revoked'))
+    monkeypatch.setattr(admission_fence, 'SUPPORTED', unavailable != 'unsupported')
+    monkeypatch.setattr(scheduler, '_get_hermes_home', lambda: '/fixture/home')
+    monkeypatch.setattr(backend_retirement, 'BUSY_WAIT_S', 0.01)
+
+    def reserve(*a, **kw):
+        raise OSError('fixture fence unavailable')
+
+    monkeypatch.setattr(admission_fence, 'reserve', reserve)
+    with tick.update_admission() as allowed:
+        assert allowed
+        events.append('dispatch')
+    assert events == ['revoked', 'dispatch']
diff --git a/tests/hermes_cli/test_worker_drain_identity_races.py b/tests/hermes_cli/test_worker_drain_identity_races.py
new file mode 100644
index 0000000000..526c9d6037
--- /dev/null
+++ b/tests/hermes_cli/test_worker_drain_identity_races.py
@@ -0,0 +1,42 @@
+"""A procfs identity assembled across a restart or exec is not evidence of idle."""
+import pytest
+
+from hermes_cli import worker_drain_census as census
+from tests.hermes_cli.test_worker_drain_baseline import process
+
+pytestmark = pytest.mark.platforms('linux')
+
+
+@pytest.mark.parametrize('change', ['start', 'cgroup', 'exe'])
+def test_identity_change_during_read_is_unknown(tmp_path, monkeypatch, change):
+    process(tmp_path)
+    original = census._read
+    reads = []
+
+    def read(path):
+        value = original(path)
+        if str(path).endswith('/10/stat'):
+            reads.append(path)
+        # The second stat read starts the revalidation pass. Inject an exec or
+        # migration after the first complete sample (not into Path's realpath).
+        if str(path).endswith('/10/stat') and len(reads) == 2:
+            if change == 'start':
+                process(tmp_path, start=101)
+                value = original(path)
+            elif change == 'cgroup':
+                (tmp_path / '10' / 'cgroup').write_text('0::/other\n')
+            else:
+                (tmp_path / '10' / 'exe').unlink()
+                (tmp_path / '10' / 'exe').symlink_to('/usr/sbin/other')
+        return value
+
+    monkeypatch.setattr(census, '_read', read)
+    with pytest.raises(ValueError, match='process changed'):
+        census.process_identity(str(tmp_path), '10')
+
+
+def test_stable_identity_remains_usable(tmp_path):
+    process(tmp_path)
+    entry = census.process_identity(str(tmp_path), '10')
+    assert entry[0:2] == (10, 100)
+    assert entry[3:] == ('/system.slice/idle.service', '/usr/sbin/idled')
diff --git a/tests/hermes_cli/test_worker_drain_init_provenance.py b/tests/hermes_cli/test_worker_drain_init_provenance.py
new file mode 100644
index 0000000000..f432adee6a
--- /dev/null
+++ b/tests/hermes_cli/test_worker_drain_init_provenance.py
@@ -0,0 +1,47 @@
+"""PID1 provenance is authored package content, not a nonexistent unit fragment."""
+import json
+import os
+
+import pytest
+
+from hermes_cli import worker_drain_baseline as producer
+from hermes_cli import worker_drain_fence as fence
+from tests.hermes_cli.test_worker_drain_baseline import process
+
+pytestmark = pytest.mark.platforms('linux')
+
+
+@pytest.mark.parametrize('changes', [{}, {'name': 'other.service'}, {'user': 'somebody'},
+                                     {'package_path': 'relative'}, {'package_path': '/a/../b'}])
+def test_init_manifest_has_explicit_package_contract(monkeypatch, changes):
+    unit = {'name': 'init.scope', 'kind': 'init', 'package_path': '/image/systemd-package',
+            'package_sha256': '0' * 64, 'exe_sha256': '1' * 64, **changes}
+    monkeypatch.setattr(fence, '_secure_read', lambda *a: json.dumps({'version': 1, 'units': [unit]}))
+    if changes:
+        with pytest.raises(producer.CaptureRefused, match='untrusted'):
+            producer.load_manifest('/manifest')
+    else:
+        assert producer.load_manifest('/manifest')['units'] == [unit]
+
+
+def test_package_pinned_init_does_not_need_fragment(tmp_path, monkeypatch):
+    process(tmp_path, pid=1, exe='/usr/lib/systemd/systemd')
+    package = tmp_path / 'package-manifest'
+    package.write_bytes(b'image package systemd=1\n')
+    unit = {'name': 'init.scope', 'kind': 'init', 'package_path': str(package),
+            'package_sha256': producer.file_digest(package), 'exe_sha256': 'exe-hash'}
+    digest = producer.file_digest
+    monkeypatch.setattr(producer, 'file_digest', lambda p: 'exe-hash' if str(p).endswith('/1/exe') else digest(p))
+    state = {'MainPID': '0', 'ControlGroup': '/system.slice/idle.service', 'FragmentPath': ''}
+    entry = producer._unit_entry(unit, state, str(tmp_path), fence.Identity('iid', 'boot', 'epoch'), {})
+    assert entry['pid'] == 1 and entry['uid'] == os.getuid()
+    package.write_bytes(b'changed package\n')
+    with pytest.raises(producer.CaptureRefused, match='provenance'):
+        producer._unit_entry(unit, state, str(tmp_path), fence.Identity('iid', 'boot', 'epoch'), {})
+
+
+def test_init_cannot_be_declared_as_arbitrary_service(tmp_path):
+    unit = {'name': 'arbitrary.service', 'kind': 'init', 'package_path': '/x',
+            'package_sha256': '0' * 64, 'exe_sha256': '1' * 64}
+    with pytest.raises(producer.CaptureRefused, match='provenance'):
+        producer._unit_entry(unit, {'MainPID': '10', 'FragmentPath': '/x'}, str(tmp_path), None, {})
