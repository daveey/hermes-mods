From 7eef74e62dc28f9cf70d040c0ce9f14f4766feb1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 05:35:16 +0000
Subject: [PATCH] refactor(cron): preserve variable input scans after startup
 traversal [daveey]

---
 cron/lifecycle_guard.py         | 14 +++-----------
 cron/lifecycle_guard_startup.py | 14 ++++++++++++++
 2 files changed, 17 insertions(+), 11 deletions(-)

diff --git a/cron/lifecycle_guard.py b/cron/lifecycle_guard.py
index cb102caca50b5fbda891d52e19f7bdc1ff79ea7b..f098cf1b71d70958451b74aa4bb0d269ff2679f8 100644
--- a/cron/lifecycle_guard.py
+++ b/cron/lifecycle_guard.py
@@ -1708,19 +1708,11 @@ def _contains_unsafe_gateway_action(
             walk_command, include_quoted=covered_quote_scope != quote_scope(cwd, executed, budget)))))
     nested_texts, nested_scripts = collect_nested_shell_inputs(
         command, walk_command, cwd=cwd, budget=budget, session_payloads=session_payloads)
-    from cron.lifecycle_guard_variables import scan_recursive_payloads, scan_variable_payloads
+    from cron.lifecycle_guard_startup import scan_shell_inputs, script_working_directory
 
-    from cron.lifecycle_guard_startup import scan_startup_sources, script_working_directory
-
-    if scan_startup_sources(walk_command, recurse, budget, cwd, executed, source):
-        return True
-    if scan_variable_payloads(walk_command, cwd=cwd, executed=executed, budget=budget,
-                              recurse=recurse, source=source, variable_source=variable_source):
-        return True
-
-    if scan_recursive_payloads(
+    if scan_shell_inputs(
             walk_command, nested_texts, cwd=cwd, executed=executed, budget=budget,
-            covered_scope=covered_quote_scope, recurse=recurse, source=source):
+            covered_scope=covered_quote_scope, recurse=recurse, source=source, variable_source=variable_source):
         return True
 
     # A nested shell's script may be a path the ordinary candidates never name: a stdin file
diff --git a/cron/lifecycle_guard_startup.py b/cron/lifecycle_guard_startup.py
index 2a057534b290e4f035d13e7deb8f4f7a84e13458..a7a219e6de253eca7faf31b3a016983825e500bf 100644
--- a/cron/lifecycle_guard_startup.py
+++ b/cron/lifecycle_guard_startup.py
@@ -112,6 +112,20 @@ def scan_startup_sources(command, recurse, budget, cwd, executed, source) -> boo
     return False
 
 
+def scan_shell_inputs(command, nested_texts, *, cwd, executed, budget,
+                      covered_scope, recurse, source, variable_source):
+    """Startup declarations precede variable sinks and recursive child inputs."""
+    from cron.lifecycle_guard_variables import scan_recursive_payloads, scan_variable_payloads
+
+    if scan_startup_sources(command, recurse, budget, cwd, executed, source):
+        return True
+    if scan_variable_payloads(command, cwd=cwd, executed=executed, budget=budget,
+                              recurse=recurse, source=source, variable_source=variable_source):
+        return True
+    return scan_recursive_payloads(command, nested_texts, cwd=cwd, executed=executed, budget=budget,
+                                   covered_scope=covered_scope, recurse=recurse, source=source)
+
+
 def script_working_directory(resolved, cwd, preserve_cwd):
     """Startup sources do not chdir; retain the legacy directory rule elsewhere."""
     from cron.lifecycle_guard import _resolve_script_directory
-- 
