From 305c91c8ba3fa347648aef0fecd4209fd17f4a1e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:48:09 +0000
Subject: [PATCH] fix(tests): the parallel runner counts each file's setup
 errors once, not twice [daveey]

---
 scripts/run_tests_parallel.py            | 2 --
 tests/scripts/test_run_tests_parallel.py | 3 ++-
 2 files changed, 2 insertions(+), 3 deletions(-)

diff --git a/scripts/run_tests_parallel.py b/scripts/run_tests_parallel.py
index 497f9b30e3f..2317c7512c7 100644
--- a/scripts/run_tests_parallel.py
+++ b/scripts/run_tests_parallel.py
@@ -1741,7 +1741,6 @@ def main() -> int:
     fail_count = 0
     tests_passed = 0
     tests_failed = 0
-    tests_errored = 0
     tests_skipped = 0
     skipped_files: list[tuple[Path, int]] = []
     # pytest setup/teardown ERRORs ("41 passed, 7 errors"). Not failures, but
@@ -1786,7 +1785,6 @@ def main() -> int:
             tests_skipped += summary.get("skipped", 0)
             if summary.get("skipped", 0):
                 skipped_files.append((fpath, summary["skipped"]))
-            tests_errored += summary.get("errors", 0)
             files_crashed += summary.get("crashed", 0)
             tests_collected += sum(
                 summary.get(k, 0)
diff --git a/tests/scripts/test_run_tests_parallel.py b/tests/scripts/test_run_tests_parallel.py
index bd6946326e3..1285203f6c7 100644
--- a/tests/scripts/test_run_tests_parallel.py
+++ b/tests/scripts/test_run_tests_parallel.py
@@ -702,7 +702,8 @@ def test_setup_errors_are_counted_on_the_summary_line(tmp_path: Path) -> None:
 
     assert proc.returncode != 0
     summary = next(line for line in proc.stdout.splitlines() if line.startswith("=== Summary"))
-    assert "1 tests passed, 0 failed, 2 errored" in summary, summary
+    # Fork: upstream's summary notes say "N errors" (the fork said "N errored"); same count.
+    assert "1 tests passed, 0 failed, 2 errors" in summary, summary
 
 
 @pytest.mark.platforms("posix")  # POSIX signal death; Windows has no SIGSEGV exit
-- 
2.55.0

