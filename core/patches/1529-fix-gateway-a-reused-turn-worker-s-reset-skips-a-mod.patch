From dee20bcec75f8cc3b9da0db0706eb66892f30734 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 18:06:09 +0000
Subject: [PATCH] fix(gateway): a reused turn worker's reset skips a module
 another thread is still importing [daveey]

sys.modules lists a module when its import starts, so a reset racing another turn thread's
first import of tools.terminal_tool_sudo / tools.interrupt read attributes that did not exist
yet (AttributeError: partially initialized module ...) and retired the worker thread
(self-heal defect gateway-06efb1e8d9, mini 2026-10-30). Read every name with getattr and skip
a branch whose names are missing: a half-imported module has run no turn code. Regression
tests hold a real module mid-import on another thread.
---
 gateway/turn_thread_reset.py              | 17 +++--
 tests/gateway/test_turn_executor_reuse.py | 83 +++++++++++++++++++++++
 2 files changed, 94 insertions(+), 6 deletions(-)

diff --git a/gateway/turn_thread_reset.py b/gateway/turn_thread_reset.py
index 8ec060b3895..0b1abba3c53 100644
--- a/gateway/turn_thread_reset.py
+++ b/gateway/turn_thread_reset.py
@@ -38,13 +38,18 @@ _PER_TURN_THREAD_LOCALS = (
 def reset_reused_thread_state() -> None:
     """Drop the calling thread's turn-keyed state (call from the worker itself, between items)."""
     tid = threading.get_ident()
-    interrupt = sys.modules.get("tools.interrupt")
-    if interrupt is not None:
-        interrupt.set_interrupt(False, tid)  # clears the bit, its reason and a pending yield
+    # sys.modules lists a module as soon as its import STARTS: another turn thread importing it
+    # for the first time leaves it there without these names yet. Such a module has run no turn
+    # code, so it holds nothing to clear; read every name with getattr and skip what is missing.
+    set_interrupt = getattr(sys.modules.get("tools.interrupt"), "set_interrupt", None)
+    if set_interrupt is not None:
+        set_interrupt(False, tid)  # clears the bit, its reason and a pending yield
     sudo = sys.modules.get("tools.terminal_tool_sudo")
-    if sudo is not None:
-        with sudo._sudo_password_cache_lock:
-            sudo._sudo_password_cache.pop(f"thread:{tid}", None)
+    cache_lock = getattr(sudo, "_sudo_password_cache_lock", None)
+    cache = getattr(sudo, "_sudo_password_cache", None)
+    if cache_lock is not None and cache is not None:
+        with cache_lock:
+            cache.pop(f"thread:{tid}", None)
     for module_name, attr in _PER_TURN_THREAD_LOCALS:
         local = getattr(sys.modules.get(module_name), attr, None)
         if local is not None:
diff --git a/tests/gateway/test_turn_executor_reuse.py b/tests/gateway/test_turn_executor_reuse.py
index 8712f8fb1c8..2983c0f4dde 100644
--- a/tests/gateway/test_turn_executor_reuse.py
+++ b/tests/gateway/test_turn_executor_reuse.py
@@ -108,3 +108,86 @@ def test_a_reused_worker_does_not_log_as_the_previous_turns_session():
         assert tag == "", f"the reused thread logs as {tag!r}"
     finally:
         ex.shutdown(wait=True)
+
+
+def _hold_mid_import(monkeypatch, module_name):
+    """Re-import the real ``module_name`` on a helper thread and park it before its body runs.
+
+    Python lists a module in ``sys.modules`` when its import starts, so until ``release`` is set
+    the name resolves to a module with none of its attributes: what a reused worker's reset saw
+    while another turn thread was importing it for the first time (gateway-06efb1e8d9).
+    """
+    import importlib.util
+    import sys
+
+    package, _, child = module_name.rpartition(".")
+    monkeypatch.delitem(sys.modules, module_name)  # restored (the original object) after the test
+    monkeypatch.delattr(sys.modules[package], child)
+    spec = importlib.util.find_spec(module_name)
+    real_exec = spec.loader.exec_module
+    started, release = threading.Event(), threading.Event()
+
+    class _GatedLoader:
+        def create_module(self, spec):
+            return None
+
+        def exec_module(self, module):
+            started.set()
+            assert release.wait(10), "the test never released the import"
+            real_exec(module)
+
+    class _Finder:
+        def find_spec(self, name, path=None, target=None):
+            if name != module_name:
+                return None
+            gated = importlib.util.spec_from_file_location(name, spec.origin, loader=_GatedLoader())
+            return gated
+
+    finder = _Finder()
+    sys.meta_path.insert(0, finder)
+    importer = threading.Thread(target=importlib.import_module, args=(module_name,), daemon=True)
+    importer.start()
+    assert started.wait(5), "the import never started"
+    sys.meta_path.remove(finder)
+
+    def finish():
+        release.set()
+        importer.join(10)
+        assert not importer.is_alive()
+        return sys.modules[module_name]
+
+    return finish
+
+
+def test_reset_skips_a_sudo_module_another_thread_is_still_importing(monkeypatch):
+    import sys
+
+    from gateway.turn_thread_reset import reset_reused_thread_state
+
+    finish = _hold_mid_import(monkeypatch, "tools.terminal_tool_sudo")
+    try:
+        assert not hasattr(sys.modules["tools.terminal_tool_sudo"], "_sudo_password_cache_lock")
+        reset_reused_thread_state()  # was: AttributeError: partially initialized module ...
+    finally:
+        sudo = finish()
+    key = f"thread:{threading.get_ident()}"
+    sudo._sudo_password_cache[key] = "cached by this thread's turn"
+    reset_reused_thread_state()
+    assert key not in sudo._sudo_password_cache, "a fully loaded module's thread entry must still clear"
+
+
+def test_reset_skips_an_interrupt_module_another_thread_is_still_importing(monkeypatch):
+    import sys
+
+    from gateway.turn_thread_reset import reset_reused_thread_state
+
+    finish = _hold_mid_import(monkeypatch, "tools.interrupt")
+    try:
+        assert not hasattr(sys.modules["tools.interrupt"], "set_interrupt")
+        reset_reused_thread_state()  # was: AttributeError: partially initialized module ...
+    finally:
+        interrupt = finish()
+    interrupt.set_interrupt(True, reason="turn one's stop")
+    reset_reused_thread_state()
+    assert not interrupt.is_interrupted(), "a fully loaded module's interrupt bit must still clear"
+    assert interrupt.get_interrupt_reason() is None
