From 452e0cf83fb196587f1fb177eedafe79d91bd6e2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 11:49:30 +0000
Subject: [PATCH] fix(skills): a bare HERMES_KANBAN_BOARD pin no longer lists
 kanban-only skills [daveey]

_detect_kanban counted HERMES_KANBAN_BOARD alone as a worker signal, but
every classic CLI / legacy-TUI chat pins it at boot (_pin_kanban_board_env),
so environments: [kanban] skills (sdlc-review, ...) appeared in chats that
never get the kanban tools, and daemon/legacy discovery diverged.

Follow tools/kanban_tools.py::_visible instead: a dispatcher-owned
HERMES_KANBAN_TASK (the dispatcher always sets it with the board), an
ambient origin session, or the profile's kanban toolset.
---
 agent/skill_utils.py                      | 20 ++++--
 tests/agent/test_skill_kanban_env_gate.py | 83 +++++++++++++++++++++++
 2 files changed, 99 insertions(+), 4 deletions(-)
 create mode 100644 tests/agent/test_skill_kanban_env_gate.py

diff --git a/agent/skill_utils.py b/agent/skill_utils.py
index b3c6af25f0d..1ccf84a4089 100644
--- a/agent/skill_utils.py
+++ b/agent/skill_utils.py
@@ -118,10 +118,16 @@ _ENV_DETECT_CACHE: dict[str, bool] = {}
 
 
 def _detect_kanban() -> bool:
-    # Mirror tools/kanban_tools.py: a dispatcher-spawned worker (env vars, but
-    # only when this execution OWNS the task — delegate children / in-process
-    # cron see the worker's vars) or a profile opted into the kanban toolset.
-    if os.getenv("HERMES_KANBAN_TASK") or os.getenv("HERMES_KANBAN_BOARD"):
+    # Mirror tools/kanban_tools.py::_visible: a dispatcher-spawned worker
+    # (HERMES_KANBAN_TASK, but only when this execution OWNS the task —
+    # delegate children / in-process cron see the worker's vars), a session
+    # started for another gateway's chat (ambient origin), or a profile opted
+    # into the kanban toolset. [daveey] A bare HERMES_KANBAN_BOARD is NOT a
+    # worker signal: every CLI / legacy-TUI chat pins it at boot
+    # (``_pin_kanban_board_env``) and the dispatcher always sets it together
+    # with HERMES_KANBAN_TASK, so counting it alone listed kanban-only skills
+    # in chats that never get the kanban tools.
+    if os.getenv("HERMES_KANBAN_TASK"):
         try:
             from agent.delegation_context import is_dispatcher_owned_worker_context
             owned = is_dispatcher_owned_worker_context()
@@ -129,6 +135,12 @@ def _detect_kanban() -> bool:
             owned = True
         if owned:
             return True
+    try:
+        from hermes_cli.kanban_origin import ambient_origin_ref
+        if ambient_origin_ref():
+            return True
+    except ImportError:
+        pass
     try:
         from tools.kanban_tools import _profile_has_kanban_toolset
         return bool(_profile_has_kanban_toolset())
diff --git a/tests/agent/test_skill_kanban_env_gate.py b/tests/agent/test_skill_kanban_env_gate.py
new file mode 100644
index 00000000000..e5f25df8ca0
--- /dev/null
+++ b/tests/agent/test_skill_kanban_env_gate.py
@@ -0,0 +1,83 @@
+"""``environments: [kanban]`` skills follow the kanban tool gate, not a bare board pin. [daveey]
+
+Every classic CLI / legacy-TUI chat pins ``HERMES_KANBAN_BOARD`` at boot
+(``_pin_kanban_board_env``), so the board pin alone must not turn a chat into
+a "kanban worker" for skill relevance: those chats never get the kanban tools.
+"""
+import pytest
+
+_KANBAN_ENV = (
+    "HERMES_KANBAN_TASK", "HERMES_KANBAN_BOARD", "HERMES_KANBAN_DB",
+    "HERMES_ORIGIN_SESSION", "HERMES_DELEGATED_CHILD_CONTEXT",
+)
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    for name in _KANBAN_ENV:
+        monkeypatch.delenv(name, raising=False)
+    (tmp_path / "config.yaml").write_text("platform_toolsets:\n  cli: [file, terminal]\n")
+    for name, extra in (("ordinary-probe", ""), ("review-probe", "environments: [kanban]\n")):
+        skill = tmp_path / "skills" / name
+        skill.mkdir(parents=True)
+        (skill / "SKILL.md").write_text(f"---\nname: {name}\ndescription: Probe\n{extra}---\nBody\n")
+    return tmp_path
+
+
+def _commands():
+    from agent.skill_commands import reload_skills
+    reload_skills()
+    from agent.skill_commands import get_skill_commands
+    return set(get_skill_commands())
+
+
+def _detect():
+    from agent.skill_utils import _detect_kanban, _detect_environment
+    return _detect_kanban(), _detect_environment("kanban")
+
+
+def test_bare_board_pin_hides_kanban_skills(home, monkeypatch):
+    monkeypatch.setenv("HERMES_KANBAN_BOARD", "default")
+    assert _detect() == (False, False)
+    commands = _commands()
+    assert "/ordinary-probe" in commands
+    assert "/review-probe" not in commands
+
+
+def test_dispatcher_owned_worker_shows_kanban_skills(home, monkeypatch):
+    monkeypatch.setenv("HERMES_KANBAN_TASK", "t_probe")
+    monkeypatch.setenv("HERMES_KANBAN_BOARD", "default")
+    assert _detect() == (True, True)
+    assert "/review-probe" in _commands()
+
+
+def test_non_owned_worker_env_hides_kanban_skills(home, monkeypatch):
+    from agent.delegation_context import non_dispatcher_owned_context
+    monkeypatch.setenv("HERMES_KANBAN_TASK", "t_probe")
+    monkeypatch.setenv("HERMES_KANBAN_BOARD", "default")
+    with non_dispatcher_owned_context():
+        assert _detect() == (False, False)
+
+
+def test_ambient_origin_session_shows_kanban_skills(home, monkeypatch):
+    monkeypatch.setenv("HERMES_ORIGIN_SESSION", "@session:default@hub/s1")
+    assert _detect() == (True, True)
+
+
+def test_profile_kanban_toolset_shows_kanban_skills(home):
+    (home / "config.yaml").write_text("platform_toolsets:\n  cli: [file, terminal, kanban]\n")
+    assert _detect() == (True, True)
+    assert "/review-probe" in _commands()
+
+
+def test_chat_boot_pin_lists_no_kanban_skill(home, monkeypatch):
+    import os
+    from hermes_cli.main_tui_launch import _pin_kanban_board_env
+    monkeypatch.setattr(os, "environ", os.environ.copy())  # the pin writes os.environ directly
+    _pin_kanban_board_env()
+    assert os.environ.get("HERMES_KANBAN_BOARD") == "default"
+    commands = _commands()
+    assert "/ordinary-probe" in commands
+    assert "/review-probe" not in commands
