From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 19:27:06 +0000
Subject: [PATCH 6878] Replay sender: durable single-slot journal, deferred observation and bounded recovery (dormant)

Public mirror of source commit f0a4c56ee79d21eeef8240b86e39fb74f2929164.

---
diff --git a/tests/hermes_cli/test_kanban_replay_confirmation_custody.py b/tests/hermes_cli/test_kanban_replay_confirmation_custody.py
new file mode 100644
index 0000000000000000000000000000000000000000..6820e87f4c88525d47411e657ebd8ccb183921f8
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_replay_confirmation_custody.py
@@ -0,0 +1,61 @@
+"""Local command settlement precedes remote ACK; confirmation is not slot custody."""
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_db_sync as sync
+from hermes_cli import kanban_replay_journal as journal
+from hermes_cli import kanban_sync_client as client
+from hermes_cli import kanban_retain_transport as retain
+from hermes_cli import kanban_actionability_transport as act
+from tests.hermes_cli import test_kanban_replay_controls as support
+from tests.hermes_cli import test_kanban_retain_receipt as receipts
+
+live = support.live
+
+
+@pytest.mark.parametrize('kind', ['retain', act.KIND])
+def test_confirmation_after_local_settlement_before_remote_ack_survives_reopen(live, kind):
+    sync.set_mode(live, 'primary')
+    if kind == 'retain':
+        owned, _, _, evidence = receipts.fixture(live)
+        confirm = lambda conn, hub: retain.confirm(conn, hub, 'default', owned['run_uid'])
+    else:
+        _, owned, _ = support.reserve(live, kind)
+        wire = json.loads(owned['request_json'])
+        root = dict(contract=wire['payload'], home_gateway='macbook', request_uid=owned['op_id'],
+                    request_sha256=owned['request_sha256'])
+        row = dict(uid=wire['contract_uid'], task_id=owned['task_id'], kind='actionability_contract',
+                   version=1, created_at=1, origin_gateway='macbook', payload=json.dumps(root))
+        evidence = SimpleNamespace(ident=SimpleNamespace(gateway='macbook'),
+            row_evidence=lambda board, table, uid: dict(board=board, table=table, uid=uid, state='live', row=row))
+        confirm = lambda conn, hub: act.confirm(conn, hub, 'default', owned['op_id'])
+    receiver = support.Controls()
+    receiver.ident = evidence.ident
+    receiver.row_evidence = evidence.row_evidence
+    call = receiver._call
+
+    def lose_ack(method, path, body=None):
+        if path.endswith('/ack'):
+            raise OSError('ACK not delivered')
+        return call(method, path, body)
+
+    receiver._call = lose_ack
+    with pytest.raises(OSError, match='ACK not delivered'):
+        client.push(live, receiver, 'default', 'macbook', primary=True, max_batches=1)
+    assert receiver.slot['h'] == '1' and receiver.slot['a'] == '0'
+    assert support.command(live, kind, owned)['delivery_state'] == 'acknowledged'
+    assert journal.snapshot(live)['settled'] == '1' and journal.pending_wire(live) is None
+    assert not live.execute('SELECT 1 FROM kanban_sync_outbox WHERE op_id=?', (owned['op_id'],)).fetchone()
+    reopened = support.sender.reopen(live)
+    try:
+        result = confirm(reopened, receiver)
+        assert result['ok'] and support.command(reopened, kind, owned)['delivery_state'] == 'confirmed'
+        assert receiver.slot['a'] == '0' and len(receiver.sent) == 1
+        receiver._call = call
+        client.push(reopened, receiver, 'default', 'macbook', primary=True, max_batches=0)
+        assert receiver.slot['a'] == '1' and len(receiver.sent) == 1
+        assert journal.pending_wire(reopened) is None
+    finally:
+        reopened.close()
