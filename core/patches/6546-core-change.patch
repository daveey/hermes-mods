---
diff --git a/hermes_cli/kanban_db_creation.py b/hermes_cli/kanban_db_creation.py
index 56c4e61b03e..855d0a15f25 100644
--- a/hermes_cli/kanban_db_creation.py
+++ b/hermes_cli/kanban_db_creation.py
@@ -79,6 +79,7 @@
     from hermes_cli import kanban_db as kb
     from hermes_cli.kanban_consent import snapshot
 
+    source = conn.execute("SELECT created_by, session_id, priority FROM tasks WHERE id=?", (task_id,)).fetchone()
     kb._append_event(conn, task_id, "created", {
         "assignee": assignee,
         "status": status,
@@ -97,8 +98,11 @@
         # Why a worker pool can or cannot take it (kanban_worker_placement.creation_audit); absent with no pool.
         **(placement_audit if isinstance(placement_audit, dict) else {}),
         # Final insertion policy, not a later assignment or a caller's diagnostic override.
+        # Audit stored origin, independently of creator-card authority and any
+        # caller diagnostic override (interactive and spin-out creates included).
+        "creator_source": {"author": source[0], "session_id": source[1]},
         "placement_policy": placement_policy,
-        "priority": conn.execute("SELECT priority FROM tasks WHERE id=?", (task_id,)).fetchone()[0],
+        "priority": source[2],
         "consent_stops": snapshot(conn, task_id, creator_task_id),
     })
     from hermes_cli.kanban_fairness_creation import stage
diff --git a/tests/hermes_cli/test_kanban_create_entry_parity.py b/tests/hermes_cli/test_kanban_create_entry_parity.py
index 364363fb49b..7c12e15bd78 100644
--- a/tests/hermes_cli/test_kanban_create_entry_parity.py
+++ b/tests/hermes_cli/test_kanban_create_entry_parity.py
@@ -127,6 +127,37 @@
          "execute_code: hermes kanban create": _via_execute_code}
 
 
+@pytest.mark.parametrize("path", list(PATHS))
+def test_created_event_records_truthful_source_without_task_authority(chat, monkeypatch, capsys, path):
+    task_id = PATHS[path](f"source via {path}", monkeypatch)
+    with kbc.connect_closing() as conn:
+        task = kb.get_task(conn, task_id)
+        assert task is not None
+        event = conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='created'",
+                             (task_id,)).fetchone()
+        payload = json.loads(event[0])
+        assert payload["creator_source"] == {"author": task.created_by, "session_id": SID}
+        assert payload["creator_task_id"] is None
+
+
+@pytest.mark.parametrize("author", ["default", "agent", "spin-out"])
+def test_direct_creation_records_source_even_without_creator_card(chat, author):
+    with kbc.connect_closing() as conn:
+        task_id = kb.create_task(conn, title="direct producer source", assignee="default",
+                                 created_by=author, session_id=SID, idempotency_key="source-probe",
+                                 placement_audit={"creator_source": {"author": "fabricated", "session_id": "foreign"}})
+        event = conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='created'",
+                             (task_id,)).fetchone()
+        payload = json.loads(event[0])
+        assert payload["creator_source"] == {"author": author, "session_id": SID}
+        assert payload["creator_task_id"] is None
+        # An idempotent replay cannot rewrite the original attribution.
+        assert kb.create_task(conn, title="replayed source", created_by="other",
+                              idempotency_key="source-probe") == task_id
+        assert conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='created'",
+                            (task_id,)).fetchall() == [event]
+
+
 @pytest.mark.parametrize("path", list(PATHS))
 def test_card_shows_in_the_creating_chats_task_list(chat, monkeypatch, capsys, path):
     task_id = PATHS[path](f"card via {path}", monkeypatch)
