 2 files changed, 58 insertions(+)
 create mode 100644 tests/hermes_cli/test_kanban_blocker_input_identity.py

diff --git a/tests/hermes_cli/test_kanban_blocker_input_identity.py b/tests/hermes_cli/test_kanban_blocker_input_identity.py
new file mode 100644
index 0000000000..52590fbba3
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_blocker_input_identity.py
@@ -0,0 +1,55 @@
+"""Unknown identity and physical/schema changes cannot reuse blocker inputs."""
+import os
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_blocker_inputs as inputs
+from hermes_cli import kanban_db_connect as kbc
+from tests.hermes_cli import test_kanban_shared_blockers as helpers
+
+kanban_home = helpers.kanban_home
+
+
+@pytest.mark.parametrize('change', ['schema', 'main_file'])
+def test_schema_and_file_identity_invalidate(kanban_home, change):
+    with kbc.connect_closing() as conn:
+        calls = []
+
+        def compute():
+            calls.append(1)
+            return len(calls)
+
+        @inputs.input_pass
+        def exercise():
+            assert inputs.read('v', conn, 10, compute) == 1
+            if change == 'schema':
+                conn.execute('CREATE TABLE schema_probe (value INTEGER)')
+            else:
+                path = Path(conn.execute('PRAGMA database_list').fetchone()[2])
+                st = path.stat()
+                os.utime(path, ns=(st.st_atime_ns, st.st_mtime_ns + 1000000000))
+            assert inputs.read('v', conn, 10, compute) == 2
+        exercise()
+
+
+def test_unreadable_key_falls_back(kanban_home, monkeypatch):
+    from hermes_cli import config
+    from hermes_cli.config_backend import ConfigBackendUnavailable
+    with kbc.connect_closing() as conn:
+        calls = []
+
+        def unavailable():
+            raise ConfigBackendUnavailable('unavailable')
+
+        def compute():
+            calls.append(1)
+            return len(calls)
+
+        @inputs.input_pass
+        def exercise():
+            assert inputs.read('v', conn, 10, compute) == 1
+            monkeypatch.setattr(config, 'load_config_readonly', unavailable)
+            assert inputs.read('v', conn, 10, compute) == 2
+            assert inputs.read('v', conn, 10, compute) == 3
+        exercise()
diff --git a/tests/hermes_cli/test_kanban_blocker_inputs.py b/tests/hermes_cli/test_kanban_blocker_inputs.py
index 32e09f2404..391ded4bc4 100644
--- a/tests/hermes_cli/test_kanban_blocker_inputs.py
+++ b/tests/hermes_cli/test_kanban_blocker_inputs.py
@@ -89,6 +89,9 @@ def test_clock_boundary_and_payload_mutation(kanban_home, monkeypatch):
             assert len(payloads) == 1
             payloads[0]['active_runs'].append('mutated')
             assert checks._check_payloads(conn, None)[0]['active_runs'] == ['a']
+            hit = checks._check_payloads(conn, None)
+            hit[0]['active_runs'].append('mutated hit')
+            assert checks._check_payloads(conn, None)[0]['active_runs'] == ['a']
             clock[0] += 1
             assert checks._check_payloads(conn, None) == []
         exercise()
