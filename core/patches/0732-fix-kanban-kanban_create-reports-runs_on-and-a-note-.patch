From c6ab879e421dae1fead94c32ebdbb27316d97d4a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 05:26:40 -0700
Subject: [PATCH] fix(kanban): kanban_create reports runs_on and a note when a
 placement pin becomes a board-lease runs_on [daveey]

A placement=<machine> pin on a primary board is rewritten to runs_on=[machine:<name>] and the card is created
here; the response looked local, so callers archived and re-created it (duplicate risk). Return runs_on,
placement{where,runs_on,machine} and a one-line note.
---
 tests/hermes_cli/test_kanban_worker_node.py |  5 +++++
 tools/kanban_tools.py                       | 10 ++++++++++
 2 files changed, 15 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_worker_node.py b/tests/hermes_cli/test_kanban_worker_node.py
index f9095896d8..1c0088598f 100644
--- a/tests/hermes_cli/test_kanban_worker_node.py
+++ b/tests/hermes_cli/test_kanban_worker_node.py
@@ -169,7 +169,12 @@ def test_tool_create_runs_on_and_placement_to_an_enrolled_machine(gws, monkeypat
     tid = out["task_id"]
     row = hub.conn.execute("SELECT runs_on, created_on FROM tasks WHERE id = ?", (tid,)).fetchone()
     assert json.loads(row["runs_on"]) == ["machine:worker-1"]  # created here, runs only there
+    # The response says so, so a caller doesn't read the pin as ignored and re-create the card.
+    assert out["runs_on"] == ["machine:worker-1"]
+    assert out["placement"] == {"where": "local", "runs_on": ["machine:worker-1"], "machine": WORKER}
+    assert "runs on " + WORKER + " via the board lease" in out["note"] and tid in out["note"]
     out = _tool_create({"title": "explicit", "assignee": "default", "runs_on": ["linux"]})
+    assert out["runs_on"] == ["linux"] and "placement" not in out
     assert json.loads(hub.conn.execute("SELECT runs_on FROM tasks WHERE id = ?",
                                        (out["task_id"],)).fetchone()[0]) == ["linux"]
 
diff --git a/tools/kanban_tools.py b/tools/kanban_tools.py
index 74b6e358fd..a3174fc05b 100644
--- a/tools/kanban_tools.py
+++ b/tools/kanban_tools.py
@@ -1643,9 +1643,11 @@ def _handle_create(args: dict, **kw) -> str:
             runs_on = _wn.normalize_runs_on(args.get("runs_on"))
         except ValueError as exc:
             return tool_error(str(exc))
+        pinned_machine = None
         if runs_on is None and origin_intent is None:
             runs_on = _wn.placement_runs_on(conn, args.get("placement"))
             if runs_on is not None:
+                pinned_machine = str(args.get("placement")).strip()
                 args = {**args, "placement": "local"}
         if origin_intent is None and origin is None:
             # Default placement: no local-only need -> the card runs on the routed gateway. [daveey]
@@ -1722,6 +1724,14 @@ def _handle_create(args: dict, **kw) -> str:
             if placed:
                 extra["capability_placement"] = placed
                 landed = _fields(kb.get_task(conn, new_tid), _CREATED_FIELDS)
+        if runs_on is not None:
+            # Say where the card runs: a pin rewritten to runs_on otherwise reads like an ignored pin,
+            # and a caller that archives and re-creates it makes a duplicate. [daveey]
+            extra["runs_on"] = runs_on
+            if pinned_machine:
+                extra["placement"] = {"where": "local", "runs_on": runs_on, "machine": pinned_machine}
+                extra["note"] = (f"Created here as {new_tid}; it runs on {pinned_machine} via the board lease "
+                                 f"(runs_on={runs_on}). The pin was honoured: do not re-create it.")
         if origin_intent is not None:
             return json.dumps({"ok": False, "created": True, "code": "origin_bind_pending",
                                "task_id": new_tid, **landed, **gate,
-- 
