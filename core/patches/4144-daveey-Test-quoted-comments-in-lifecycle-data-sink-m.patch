From fc2106dc6520ac363bc45287353a5c454ba13af9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 05:10:57 +0000
Subject: [PATCH] [daveey] Test quoted comments in lifecycle data-sink masking

Close audit #2718's direct shlex comment-stripping gap. Preserve grep lifecycle-pattern arguments as data even when a trailing comment contains an unmatched apostrophe; retain ordinary lifecycle refusal.

Proof: comment-word suite 77 passed; exact _shlex_tokens strip_shell_comments removal gives 76 passed / 1 behavioral failure, zero skips. Restored guard family 1967 passed across 26 files with -j1; scripts/check 20 checks passed. Initial parallel family run hit existing 5-second performance assertion; isolated and serial reruns passed. No production changes.
---
 tests/cron/test_lifecycle_guard_comment_words.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/tests/cron/test_lifecycle_guard_comment_words.py b/tests/cron/test_lifecycle_guard_comment_words.py
index 0b66b5b0f5..ff40122c26 100644
--- a/tests/cron/test_lifecycle_guard_comment_words.py
+++ b/tests/cron/test_lifecycle_guard_comment_words.py
@@ -85,6 +85,15 @@ ALLOWED = [
 ]
 
 
+def test_comment_quote_does_not_break_data_sink_exemption():
+    # Data-sink masking tokenizes the original command, before logical-line splitting.
+    assert scan_gateway_lifecycle("grep 'hermes gateway restart' /dev/null # it's") == (False, None)
+
+
+def test_comment_quote_does_not_hide_direct_lifecycle_command():
+    assert scan_gateway_lifecycle("hermes gateway restart # it's")[0] is True
+
+
 def _tree(tmp_path):
     (tmp_path / "r.sh").write_text('hermes gateway "restart"\n')
     (tmp_path / "clean.py").write_text("print(1)\n")
