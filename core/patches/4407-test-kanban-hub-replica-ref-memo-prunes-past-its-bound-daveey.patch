From 373bf2da660a95543f7311bdd7f90be2d4edd0d2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 05:33:44 +0000
Subject: [PATCH] test(kanban): hub replica ref memo prunes past its bound
 [daveey]

Audit t_7068e01411e1f0c3 found that PR #3096's memo bound in
hermes_cli/kanban_board_replica_refs.py was untested: the mutant
`if len(known) > _HUB_MEMO_REFS:` -> `if False:` survived all 15 tests in
test_kanban_replica_refs_kept_readers.py with zero skips. Answers stay
correct under that mutant, but distinct refs pile up without limit on one
kept reader while the hub probe is unchanged.

The new test sets _HUB_MEMO_REFS to 2 and asks for distinct refs one call at a
time on the same reader and probe. It checks that the memo keeps everything at
the bound, keeps only the current request's refs once past it, and that an
evicted ref (present on the hub) is scanned again and still resolves. It does
not assert a hard cap for one oversized request, because the code only prunes
down to that request's refs. Test only; production unchanged.

Proof (card t_d3b3dcc7c1370b4d, worker-8, isolated HOME/HERMES_HOME,
sdlc-review mutants.py, pm test-environment python):
- baseline: 16 passed
- M1 `if False:`: killed, 1 failed (the new test) / 15 passed; it fails on
  `assert memo_refs() == {gone[1]}` with extra items HUB_ONLY and gone[0]
- M2 `>=` instead of `>`: killed, 1 failed (the new test) / 15 passed
- hermes-core-wt test on the file: 16 passed, 0 failed
---
 .../test_kanban_replica_refs_kept_readers.py  | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_replica_refs_kept_readers.py b/tests/hermes_cli/test_kanban_replica_refs_kept_readers.py
index 218c30c77b3180cb296055b815866637aa6c5fb6..7f822d2335797d81e867241a2565e2675c80163e 100644
--- a/tests/hermes_cli/test_kanban_replica_refs_kept_readers.py
+++ b/tests/hermes_cli/test_kanban_replica_refs_kept_readers.py
@@ -183,6 +183,27 @@ def test_a_rewritten_key_at_a_new_seq_is_seen(host):
     assert refs.unresolved_after_replica([HUB_ONLY]) == [HUB_ONLY]
 
 
+def test_distinct_refs_under_an_unchanged_probe_stay_bounded(host, hub_scans, monkeypatch):
+    """Each lookup of new refs grows the memo; past ``_HUB_MEMO_REFS`` it keeps only the current request's refs, so
+    distinct refs on one kept reader cannot pile up. An evicted ref is looked up afresh and answers as before."""
+    monkeypatch.setattr(refs, "_HUB_MEMO_REFS", 2)
+    gone = [f"t_01a1cfdeadbeef{n:02d}" for n in (1, 2)]
+
+    def memo_refs():
+        (entry,) = refs._hub_memo.values()
+        return set(entry[1])
+
+    assert refs.unresolved_after_replica([HUB_ONLY]) == []
+    assert refs.unresolved_after_replica([gone[0]]) == [gone[0]]
+    assert memo_refs() == {HUB_ONLY, gone[0]}  # at the bound: nothing dropped
+    assert refs.unresolved_after_replica([gone[1]]) == [gone[1]]
+    assert memo_refs() == {gone[1]}  # over it: only the refs this request asked about
+    hub_scans.clear()
+    assert refs.unresolved_after_replica([HUB_ONLY]) == []  # evicted, so scanned again, still found
+    assert hub_scans == [HUB_ONLY]
+    assert memo_refs() == {gone[1], HUB_ONLY}
+
+
 def test_rows_without_seq_are_never_memoized(host, hub_scans):
     _write(host, ("INSERT INTO replica VALUES ('gw-z', 'tasks', 'default/t_01a1cf000000abcd', 1, NULL, '{}', 0)", ()))
     refs.unresolved_after_replica([NOWHERE])
