From c03c2a2c1ed7ac01912a8060d1bf0778066453d5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 25 Oct 2026 23:03:01 +0000
Subject: [PATCH] ci(detect): curl fallback when runner lacks gh CLI; 3m detect
 timeout (retries hid 'gh: command not found' until the 1m timeout cancelled
 Detect)

---
 .github/actions/detect-changes/action.yml | 28 +++++++++++++++++++----
 .github/workflows/ci.yaml                 |  2 +-
 2 files changed, 25 insertions(+), 5 deletions(-)

diff --git a/.github/actions/detect-changes/action.yml b/.github/actions/detect-changes/action.yml
index 906d24a0e2..d28252d48b 100644
--- a/.github/actions/detect-changes/action.yml
+++ b/.github/actions/detect-changes/action.yml
@@ -109,12 +109,32 @@ runs:
           # die with "cannot iterate over: null", which fails every retry
           # and forces the fail-open path (seen on stacked PRs). The full
           # file list (up to the API's 300-file cap) is on page one.
+          #
+          # Self-hosted runners may not ship the gh CLI. Without it every
+          # attempt died with "command not found" and the retry sleeps ate the
+          # job's whole timeout, cancelling Detect and skipping every lane.
+          # Fall back to curl against the same endpoint (the compare API caps
+          # the file list at 300, 100 per page, so pages 1-3 cover it).
+          compare_files() {
+            if command -v gh >/dev/null 2>&1; then
+              gh api --paginate \
+                "repos/${REPO}/compare/${BASE_SHA}...${HEAD_SHA}" \
+                --jq '.files[]?.filename'
+              return
+            fi
+            local page
+            for page in 1 2 3; do
+              curl -fsS --max-time 20 \
+                -H "Authorization: Bearer ${GH_TOKEN}" \
+                -H "Accept: application/vnd.github+json" \
+                "https://api.github.com/repos/${REPO}/compare/${BASE_SHA}...${HEAD_SHA}?per_page=100&page=${page}" |
+                python3 -c 'import json,sys; [print(f["filename"]) for f in (json.load(sys.stdin).get("files") or [])]' ||
+                return 1
+            done
+          }
           CHANGED=""
           for i in 1 2 3; do
-            if CHANGED="$(gh api \
-              --paginate \
-              "repos/${REPO}/compare/${BASE_SHA}...${HEAD_SHA}" \
-              --jq '.files[]?.filename')"; then
+            if CHANGED="$(compare_files)"; then
               break
             fi
             if [ "$i" = 3 ]; then
diff --git a/.github/workflows/ci.yaml b/.github/workflows/ci.yaml
index 4bf5a1b28f..520c38d71e 100644
--- a/.github/workflows/ci.yaml
+++ b/.github/workflows/ci.yaml
@@ -72,7 +72,7 @@ jobs:
   detect:
     name: Detect affected areas
     runs-on: [self-hosted, hermes-hub]
-    timeout-minutes: 1
+    timeout-minutes: 3
     outputs:
       python: ${{ steps.gate-lanes.outputs.python }}
       python_prod: ${{ steps.gate-lanes.outputs.python_prod }}
-- 
2.55.0

