From 22f4338c575cf5e1a6340a17b0796fe4832a85b3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 01:47:45 +0000
Subject: [PATCH] [daveey] survivable processes: daemon test via a
 self-daemonizing tool; noqa on its own line

The foreground guard refuses a shell '&', so the daemon case uses a forking python3 -c. RED with the
first commit's pipeline tee (exit 124 at the 65 s timeout), GREEN with the process-substitution tee.
---
 tests/tools/test_update_survivable_processes.py | 8 +++++++-
 tools/process_registry_survivable.py            | 3 ++-
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/tests/tools/test_update_survivable_processes.py b/tests/tools/test_update_survivable_processes.py
index 111345e744..73eecf0a35 100644
--- a/tests/tools/test_update_survivable_processes.py
+++ b/tests/tools/test_update_survivable_processes.py
@@ -362,6 +362,11 @@ def test_user_stop_still_kills_a_long_foreground_command(tmp_path, monkeypatch):
         wait_until(marker.exists, timeout=8, what="a command a user Stop should have killed")
 
 
+# A self-daemonizing tool (the shell '&' form is refused by the foreground guard): the child keeps stdout.
+DAEMONIZE = ("python3 -c 'import os, sys, time\nif os.fork():\n    print(\"started\", flush=True); sys.exit(0)\n"
+             "open(sys.argv[1], \"w\").write(str(os.getpid())); time.sleep(120)' {pidfile}")
+
+
 @pytest.mark.live_system_guard_bypass
 @pytest.mark.platforms("linux")
 @pytest.mark.skipif(not _user_systemd(), reason="needs a user systemd bus")
@@ -370,8 +375,9 @@ def test_long_foreground_command_leaving_a_daemon_returns_promptly_and_keeps_it(
     left running as without the key."""
     pidfile = tmp_path / "daemon.pid"
     started = time.monotonic()
-    result = _run_owner(tmp_path, monkeypatch, {"command": f"sleep 120 & echo $! > {pidfile}; echo started",
+    result = _run_owner(tmp_path, monkeypatch, {"command": DAEMONIZE.format(pidfile=pidfile),
                                                 "timeout": 65}, key_on=True, interrupt=False)
+    wait_until(pidfile.exists, timeout=10, what=f"the daemon's pid file ({result})")
     daemon = int(pidfile.read_text())
     try:
         assert result["exit_code"] == 0 and result["output"].strip() == "started", result
diff --git a/tools/process_registry_survivable.py b/tools/process_registry_survivable.py
index 44fdcb5b90..8c03dc0eb9 100644
--- a/tools/process_registry_survivable.py
+++ b/tools/process_registry_survivable.py
@@ -165,7 +165,8 @@ class SurvivableForeground:
             return None
         from gateway.session_context import async_delivery_supported, get_session_env
 
-        proc = subprocess.Popen(  # noqa: subprocess-stdin — stdin is DEVNULL or the caller's piped data
+        # noqa: subprocess-stdin — stdin is DEVNULL or the caller's piped data
+        proc = subprocess.Popen(
             argv, text=True, env=systemd_user_bus_env(run_env), encoding="utf-8", errors="replace",
             stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
             stdin=subprocess.PIPE if stdin_data is not None else subprocess.DEVNULL,
