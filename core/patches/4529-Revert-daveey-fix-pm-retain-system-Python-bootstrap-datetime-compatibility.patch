From 2a1169e3e65138f87e9ba4a9ee1b6ad969cdfcf3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 07:44:42 +0000
Subject: [PATCH] Revert "[daveey] fix(pm): retain system Python bootstrap
 datetime compatibility"

This reverts commit c2e8200cf97c862ff1711c9d115a14550e8b91fb.
---
 pm/network.py            |  5 ++---
 tests/pm/test_network.py | 15 ---------------
 2 files changed, 2 insertions(+), 18 deletions(-)

diff --git a/pm/network.py b/pm/network.py
index 068b27dbeec0b93050ff3e99691244b0f0739336..d12cc1b19278b4a4181a578aaded0f123b376f4a 100644
--- a/pm/network.py
+++ b/pm/network.py
@@ -10,7 +10,7 @@ import ssl
 import time
 import urllib.error
 import urllib.parse
-from datetime import timezone
+from datetime import timezone, UTC
 from email.utils import parsedate_to_datetime
 from typing import Callable, TypeVar
 
@@ -80,8 +80,7 @@ def _delay(exc: Exception, attempt: int) -> float:
                 try:
                     when = parsedate_to_datetime(value)
                     if when.tzinfo is None:
-                        # PM bootstraps on system Python, including macOS 3.9.
-                        when = when.replace(tzinfo=timezone.utc)  # noqa: UP017 -- bootstrap Python can predate 3.11
+                        when = when.replace(tzinfo=UTC)
                     retry_after = when.timestamp() - time.time()
                 except (TypeError, ValueError, OverflowError):
                     retry_after = 0.0
diff --git a/tests/pm/test_network.py b/tests/pm/test_network.py
index 22f21acc5cffa87ebf20df014f5c3149ac0370a7..5793f76305303405c4c8b688e02f3ab6d946163a 100644
--- a/tests/pm/test_network.py
+++ b/tests/pm/test_network.py
@@ -15,21 +15,6 @@ from pm import network
 from pm.downloader import DownloadPaused, HashError
 
 
-def test_bootstrap_retry_policy_without_python311_datetime_alias(monkeypatch):
-    """PM imports before it installs Python, including Apple's system Python 3.9."""
-    import datetime as datetime_module
-    import importlib.util
-
-    monkeypatch.delattr(datetime_module, "UTC", raising=False)
-    spec = importlib.util.spec_from_file_location("bootstrap_network", network.__file__)
-    bootstrap_network = importlib.util.module_from_spec(spec)
-    spec.loader.exec_module(bootstrap_network)
-    monkeypatch.setattr(bootstrap_network.time, "time", lambda: 1577836800.0)
-    # A timezone-less Retry-After exercises the UTC fallback, not just import.
-    error = _http_error(503, "Wed, 01 Jan 2020 00:00:12")
-    assert bootstrap_network._delay(error, 0) == 12.0
-
-
 def _http_error(status, retry_after=None):
     headers = Message()
     if retry_after is not None:
