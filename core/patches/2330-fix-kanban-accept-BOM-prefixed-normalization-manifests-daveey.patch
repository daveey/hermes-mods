Subject: [PATCH] fix(kanban): accept BOM-prefixed normalization manifests
 [daveey]

---
 hermes_cli/kanban_priority_migration.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_priority_migration.py b/hermes_cli/kanban_priority_migration.py
index e5e3e9e928a..3130efc8752 100644
--- a/hermes_cli/kanban_priority_migration.py
+++ b/hermes_cli/kanban_priority_migration.py
@@ -59,7 +59,7 @@ def apply(conn, path: Path, *, undo: bool = False, allow_legacy_rollback: bool =
     """
     from hermes_cli import kanban_db as kb
 
-    manifest = json.loads(path.read_text(encoding="utf-8"))
+    manifest = json.loads(path.read_text(encoding="utf-8-sig"))
     if manifest.get("version") != 1 or manifest.get("cap") != PRIORITY_CAP:
         raise ValueError("unknown priority migration manifest")
     rows = manifest["rows"]
