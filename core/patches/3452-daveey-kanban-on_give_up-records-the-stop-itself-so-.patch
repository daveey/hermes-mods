From 16aa62c87f2e4b465383819d3e871f9cd3dc75f3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 09:23:15 +0000
Subject: [PATCH] [daveey] kanban: on_give_up records the stop itself, so
 kanban_sync_client stays under its 2000-line cap after main grew it

---
 hermes_cli/kanban_sync_client.py       | 13 ++++---------
 hermes_cli/kanban_sync_schema_alert.py |  8 +++++---
 2 files changed, 9 insertions(+), 12 deletions(-)

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index f2430d8927..1d5094f171 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -1474,14 +1474,11 @@ def _run_forever(keep_running: Callable[[], bool], interval: Optional[float], ru
         _log.warning("%s; kanban sync not started", exc)
         runstate.record_down(f"not starting: {exc}")
         return
-    from hermes_cli.kanban_sync_schema_alert import note_start
+    from hermes_cli.kanban_sync_schema_alert import note_start, on_give_up  # one hub card per incident [daveey]
     note_start()
     ahead = _schema_ahead_boards(board_paths())
     if ahead:
-        why = "; ".join(f"board {slug}: {refusal}" for slug, refusal in ahead)
-        runstate.record_down("not starting: " + why)
-        from hermes_cli.kanban_sync_schema_alert import on_give_up
-        on_give_up(ident.gateway, why)  # one hub card per host incident [daveey]
+        on_give_up(runstate, ident.gateway, "not starting: ", "; ".join(f"board {s}: {r}" for s, r in ahead))
         return  # give the host sync role up: a current core's gateway can take it [daveey]
     hub = Hub(ident)
     sync.set_lease_client(HubLeaseClient(hub))
@@ -1523,10 +1520,8 @@ def _run_forever(keep_running: Callable[[], bool], interval: Optional[float], ru
             ahead = [r for r in results if (r.error or "").startswith("SchemaAhead")]
             if ahead:
                 _log.error("kanban sync: a newer core migrated this host's board; giving up the sync role")
-                why = "; ".join(f"board {r.board}: {r.error}" for r in ahead)
-                runstate.record_down("gave up the sync role: " + why)
-                from hermes_cli.kanban_sync_schema_alert import on_give_up
-                on_give_up(ident.gateway, why)  # one hub card per host incident [daveey]
+                on_give_up(runstate, ident.gateway, "gave up the sync role: ",
+                           "; ".join(f"board {r.board}: {r.error}" for r in ahead))
                 return
             runstate.clear()  # a completed round: the loop runs
             for r in results:
diff --git a/hermes_cli/kanban_sync_schema_alert.py b/hermes_cli/kanban_sync_schema_alert.py
index e8ac1fae19..b227a21756 100644
--- a/hermes_cli/kanban_sync_schema_alert.py
+++ b/hermes_cli/kanban_sync_schema_alert.py
@@ -18,7 +18,7 @@ import logging
 import re
 import time
 from pathlib import Path
-from typing import Callable, Optional
+from typing import Any, Callable, Optional
 
 log = logging.getLogger(__name__)
 
@@ -216,13 +216,15 @@ def _report(host, why, since, runner, hub_cli, info, now) -> Optional[str]:
     return rid
 
 
-def on_give_up(gateway: str, why: str) -> None:
-    """``run_forever``'s hook, right after it recorded the stop: the incident is that record's ``since``.
+def on_give_up(state: Any, gateway: str, prefix: str, why: str) -> None:
+    """``run_forever``'s give-up: record the stop (``prefix + why``) in ``state``, then report it; the incident is
+    that record's ``since``.
 
     A give-up while this host's own core update is under way (the installed checkout moved past the commit this
     process started on, and this process runs that checkout) is the update's transition, not an incident: the
     update restarts this gateway on the new core."""
     from hermes_cli import kanban_sync_runstate as runstate
+    state.record_down(prefix + why)
     if _updating():
         log.warning("kanban sync: gave up the sync role while this host's core update is under way (%s -> %s); "
                     "no hub card", (_START_HEAD or "")[:12], (_installed_head() or "")[:12])
-- 
2.51.0

