From 5374347b174703068090cb3ef39dfd197d5b61f1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 21:36:33 +0000
Subject: [PATCH] API chat completions: non-streaming reply carries the served
 provider and model (class selectors named neither; BB egress rows read
 hermes/class:fast)

---
 gateway/platforms/api_server.py               |  6 ++++++
 gateway/platforms/api_server_openai_routes.py |  7 +++++++
 tests/gateway/test_api_class_routing.py       | 21 +++++++++++++++++++
 3 files changed, 34 insertions(+)

diff --git a/gateway/platforms/api_server.py b/gateway/platforms/api_server.py
index e82f7a4898d..aafe4539f40 100644
--- a/gateway/platforms/api_server.py
+++ b/gateway/platforms/api_server.py
@@ -3615,6 +3615,12 @@ class APIServerAdapter(OpenAICompatRoutesMixin, BasePlatformAdapter):
         _session_rotated = isinstance(_eff_sid, str) and isinstance(session_id, str) and _eff_sid != session_id
         if getattr(agent, "_last_compaction_in_place", False) or _session_rotated:
             result["_compressed"] = True
+        # Always record who actually served the turn (a class selector names no provider or model).
+        if isinstance(result, dict):
+            _p, _m = getattr(agent, "provider", ""), getattr(agent, "model", "")
+            result["served_runtime"] = {
+                "provider": self._clean_runtime_id(_p, max_len=80) if isinstance(_p, str) else "",
+                "model": self._clean_runtime_id(_m) if isinstance(_m, str) else ""}
         if requested_runtime or route or confirmed_runtime_lock or (route_source and route_source != "global"):
             runtime = self._turn_runtime_metadata(
                 agent, route=route, requested_runtime=requested_runtime,
diff --git a/gateway/platforms/api_server_openai_routes.py b/gateway/platforms/api_server_openai_routes.py
index 05d32c8d554..aed174759be 100644
--- a/gateway/platforms/api_server_openai_routes.py
+++ b/gateway/platforms/api_server_openai_routes.py
@@ -1060,6 +1060,13 @@ class OpenAICompatRoutesMixin:
             "choices": [{"index": 0, "message": {"role": "assistant", "content": "" if presentation_muted else final_response},
                          "finish_reason": finish_reason}],
             "usage": _chat_usage_payload(usage)}
+        # A class selector ("class:fast") is not a model: report who served it, so clients (BB's egress log)
+        # attribute the request. ``model`` keeps echoing the request when the runtime is unknown.
+        served = result.get("served_runtime") if isinstance(result.get("served_runtime"), dict) else {}
+        if served.get("provider"):
+            response_data["provider"] = served["provider"]
+        if served.get("model"):
+            response_data["model"] = served["model"]
         # Non-streaming twin of ``delta.reasoning_content`` (#99552).
         reasoning_text = _turn_reasoning_text(history, user_message, result)
         if reasoning_text and not presentation_muted:
diff --git a/tests/gateway/test_api_class_routing.py b/tests/gateway/test_api_class_routing.py
index ce7438fc81c..86dc8b3be3b 100644
--- a/tests/gateway/test_api_class_routing.py
+++ b/tests/gateway/test_api_class_routing.py
@@ -123,3 +123,24 @@ async def test_runs_http_class(adapter, routing_home, streaming_route, native_tr
     assert native_transport
     assert all(body["model"] == "anthropic-deep" and headers.get("authorization", "").startswith("Bearer sk-ant-oat")
                for _, headers, body in native_transport)
+
+
+@pytest.mark.asyncio
+async def test_completions_http_class_reply_names_served_provider_and_model(
+        adapter, routing_home, streaming_route, native_transport):
+    """A class selector is not a model: the non-streaming reply carries who served it (BB egress attribution)."""
+    from aiohttp import web
+    from aiohttp.test_utils import TestClient, TestServer
+    app = web.Application()
+    app.router.add_post("/v1/chat/completions", adapter._handle_chat_completions)
+    with patch("gateway.run._resolve_runtime_agent_kwargs", side_effect=AssertionError("paid default")), \
+            patch("model_tools.get_tool_definitions", return_value=[]):
+        async with TestClient(TestServer(app)) as client:
+            response = await client.post("/v1/chat/completions", json={
+                "model": "class:deep", "provider": "auto", "stream": False,
+                "messages": [{"role": "user", "content": "Say ok"}]})
+            body = await response.json()
+            assert response.status == 200, body
+    assert body["provider"] == "anthropic"
+    assert body["model"] == "anthropic-deep"
+
-- 
2.55.0

