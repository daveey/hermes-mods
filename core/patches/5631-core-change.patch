From c5cb8861c35b42a0dbee8a4e7a65585297769d7e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 23:00:22 +0000
Subject: [PATCH] fix(kanban): preserve original refusal diagnostics [daveey]

Markdown normalization must only affect validation, not the offending-line diagnostic. Retain source_line for errors and extend real create/no-write/lossless historical resubmission coverage to formatted models, providers and provenance suffixes. CI regression reproduced unchanged: 33 passed/1 failed. Focused three whole files pass with retries off; full scripts/check passes. No routing policy or fleet state change.
---
 hermes_cli/kanban_model_neutral.py                     | 8 ++++----
 tests/hermes_cli/test_kanban_model_neutral_review44.py | 7 ++++++-
 2 files changed, 10 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_model_neutral.py b/hermes_cli/kanban_model_neutral.py
index 8ff72aab93..3243c34831 100644
--- a/hermes_cli/kanban_model_neutral.py
+++ b/hermes_cli/kanban_model_neutral.py
@@ -98,10 +98,10 @@ def validate_text(*values):
     exclusions and negated restrictions are deliberately not rewritten here.
     """
     for text in values:
-        for line in (text or '').splitlines():
-            line = _active_text(line)
+        for source_line in (text or '').splitlines():
+            line = _active_text(source_line)
             if _REQUIRED.search(line):
-                raise ValueError(f'{ERROR}; refused line: {line}{_TEXT_GUIDANCE}')
+                raise ValueError(f'{ERROR}; refused line: {source_line}{_TEXT_GUIDANCE}')
             # Comments carry authorship, not authority over text after their end.
             line = re.sub(r'<!-- implementer-models:.*?-->', '', line)
             # Inspect rendered inline identities, retaining the original stored bytes.
@@ -143,7 +143,7 @@ def validate_text(*values):
                     r'(?:independent\s+)?review\s*\(\s*' + _ROUTE_NAME,
                     clause, re.IGNORECASE)
                 if _DIRECTIVE.search(clause) or _PROVIDER_DIRECTIVE.search(clause) or named_review or required_review:
-                    raise ValueError(f'{ERROR}; refused line: {line}{_TEXT_GUIDANCE}')
+                    raise ValueError(f'{ERROR}; refused line: {source_line}{_TEXT_GUIDANCE}')
 
 
 def forwarded_text(text):
diff --git a/tests/hermes_cli/test_kanban_model_neutral_review44.py b/tests/hermes_cli/test_kanban_model_neutral_review44.py
index 6fb30837e1..1502f3f23e 100644
--- a/tests/hermes_cli/test_kanban_model_neutral_review44.py
+++ b/tests/hermes_cli/test_kanban_model_neutral_review44.py
@@ -39,7 +39,12 @@ def test_evidence_label_carries_line(board, text):
     assert kb.get_task(board, tid).body == line
 
 
-@pytest.mark.parametrize("text", [t for _n, t in REAL_ROWS] + CONTROLS)
+@pytest.mark.parametrize("text", [t for _n, t in REAL_ROWS] + CONTROLS + [
+    '  Use **claude-opus-5-5**.',
+    'Review must use `openai-codex`.',
+    '<!-- implementer-models: audit --> Use __claude-opus-5-5__.',
+    'Historical run instruction (superseded and not active): "old evidence"; Use *claude-opus-5-5*.',
+])
 def test_error_names_the_quoting_form_and_resubmission_is_lossless(board, text):
     before = board.execute('SELECT count(*) FROM tasks').fetchone()[0]
     with pytest.raises(ValueError) as err:
