From 8ecc28347df98b0480296f7668c0e884bea29716 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 18:03:48 +0000
Subject: [PATCH] fix(kanban): keep skipped post-merge jobs out of red main
 notice [daveey]

---
 hermes_cli/kanban_pr_merge_time.py            | 3 ++-
 tests/hermes_cli/test_kanban_pr_merge_time.py | 8 ++++++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_pr_merge_time.py b/hermes_cli/kanban_pr_merge_time.py
index a0eba7852cb..a2fe196e6ad 100644
--- a/hermes_cli/kanban_pr_merge_time.py
+++ b/hermes_cli/kanban_pr_merge_time.py
@@ -53,7 +53,8 @@ def merge_evidence(receipt, pr, repo, runs, statuses):
     statuses, post_statuses = partition_at_merge(statuses, merged_at, runs=False)
     sha = receipt["head_sha"]
     receipt["post_merge_checks"] = [check_receipt(c, sha) for c in post_runs + post_statuses]
-    if any(c["classification"] in {"failure", "infra"} for c in receipt["post_merge_checks"]):
+    if any(c["conclusion"] in {"failure", "error", "timed_out", "action_required"}
+           for c in receipt["post_merge_checks"]):
         receipt["main_health"] = {
             "idempotency_key": f"ci-red:{repo}:{sha}",
             "detail": f"Main CI is red for {repo}@{sha}; owned by ci-main-watch, not this PR's acceptance."}
diff --git a/tests/hermes_cli/test_kanban_pr_merge_time.py b/tests/hermes_cli/test_kanban_pr_merge_time.py
index 11dc7dcd7ff..18a10ee44aa 100644
--- a/tests/hermes_cli/test_kanban_pr_merge_time.py
+++ b/tests/hermes_cli/test_kanban_pr_merge_time.py
@@ -163,6 +163,14 @@ def test_unknown_merge_chronology_fails_closed(evidence, field, value):
     assert not receipt["ok"] and receipt["classification"] == "infra"
 
 
+@pytest.mark.parametrize("conclusion", ["skipped", "neutral", "cancelled", "success"])
+def test_nonfailure_postmerge_checks_do_not_claim_main_is_red(evidence, conclusion):
+    evidence["runs"][0]["conclusion"] = conclusion
+    receipt = collect()
+    assert receipt["ok"] and "main_health" not in receipt
+    assert receipt["post_merge_checks"][0]["conclusion"] == conclusion
+
+
 @pytest.mark.parametrize("owner_state", ["ready", "done", "archived", None])
 def test_completion_receipt_names_main_health_owner(evidence, owner_state):
     from hermes_cli import kanban_db as kb
-- 
2.55.0

