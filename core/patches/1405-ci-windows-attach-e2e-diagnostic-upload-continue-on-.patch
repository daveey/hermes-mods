From 88a09efe9c5b6b86e2b3edf9d16dccae27060d7e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 04:34:19 +0000
Subject: [PATCH] ci(windows-attach-e2e): diagnostic upload continue-on-error,
 1-day retention [daveey]

---
 .github/workflows/windows-desktop-attach-e2e.yml | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/windows-desktop-attach-e2e.yml b/.github/workflows/windows-desktop-attach-e2e.yml
index ae3fd79392a..0141e51870f 100644
--- a/.github/workflows/windows-desktop-attach-e2e.yml
+++ b/.github/workflows/windows-desktop-attach-e2e.yml
@@ -101,11 +101,13 @@ jobs:
 
       - name: Upload failure artifacts
         if: failure() || cancelled()
+        # Diagnostic only: the account-wide artifact quota must never fail this lane.
+        continue-on-error: true
         uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
         with:
           name: windows-desktop-attach-e2e-${{ github.run_attempt }}
           path: |
             apps/desktop/test-results/core
             apps/desktop/playwright-report/core
-          retention-days: 14
+          retention-days: 1
           if-no-files-found: ignore
-- 
2.55.0

