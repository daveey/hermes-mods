 hermes_state_common.py                        |   5 +
 hermes_state_sessions.py                      |  30 +++--
 tests/hermes_cli/test_browse_schema_drift.py  |   1 +
 .../test_session_filter_clause_order.py       | 112 ++++++++++++++++++
 4 files changed, 135 insertions(+), 13 deletions(-)
 create mode 100644 tests/hermes_state/test_session_filter_clause_order.py

diff --git a/hermes_state_common.py b/hermes_state_common.py
index d1ff044b12..25ce99d959 100644
--- a/hermes_state_common.py
+++ b/hermes_state_common.py
@@ -948,6 +948,11 @@ CREATE INDEX IF NOT EXISTS idx_sessions_tool_names
 -- a small candidate set before compression-chain and preview hydration.
 CREATE INDEX IF NOT EXISTS idx_sessions_effective_activity
     ON sessions(COALESCE(last_activity_at, started_at) DESC, started_at DESC);
+-- Pinned back-fill of every sidebar slice (``SELECT id FROM sessions WHERE pinned = 1``):
+-- a handful of pins must not cost a full sessions scan per slice. ``pinned`` leads so the
+-- planner SEARCHes (pinned=?) rather than SCANs; on ``(id)`` alone it walks the partial index.
+CREATE INDEX IF NOT EXISTS idx_sessions_pinned
+    ON sessions(pinned, id) WHERE pinned = 1;
 -- CLI/TUI listings match gateway rows stored as source='local' by created_source,
 -- before LIMIT. created_source is reconciled onto legacy DBs, so this index lives
 -- here rather than in SCHEMA_SQL. A source-only index would walk every local row
diff --git a/hermes_state_sessions.py b/hermes_state_sessions.py
index 9c1281c454..dccbc0deed 100644
--- a/hermes_state_sessions.py
+++ b/hermes_state_sessions.py
@@ -106,21 +106,13 @@ def _session_filter_where(
     """Shared ``sessions s`` WHERE builder so counts line up with listed rows. ``exclude_children``
     hides sub-agent runs and compression continuations but keeps branch/reset children
     (``_LISTABLE_CHILD_SQL``); ``include_subagents`` re-admits the sub-agent runs only
-    (``sessions.show_subagents``). Clause order is part of the SQL text contract."""
+    (``sessions.show_subagents``). Clause order is part of the SQL text contract: SQLite tests
+    ANDed terms left to right, so the plain-column clauses come first and reject most rows (an
+    excluded source, empty or archived) before the child-lineage clauses pay ``json_valid`` +
+    ``json_extract`` on ``model_config`` and a parent lookup. The lineage clauses bind no
+    parameters, so moving them last leaves the parameter order unchanged."""
     where: list[str] = []
     params: list[Any] = []
-    if exclude_children and include_subagents:
-        where.append(f"({_LISTABLE_CHILD_SQL} OR {_delegate_from_json('s.model_config')} IS NOT NULL)")
-    elif exclude_children:
-        where += [_LISTABLE_CHILD_SQL, f"{_delegate_from_json('s.model_config')} IS NULL"]
-    # Show roots and user-visible branch/reset sessions, while still hiding sub-agent runs and compression
-    # continuations. All four carry parent_session_id, so the shared predicate classifies the edge from
-    # stable markers plus legacy-compatible parent metadata. Branch sessions are identified two ways, OR'd
-    # for robustness: 1. A stable ``_branched_from`` marker in model_config, written by /branch at creation
-    # time. This survives the parent being reopened and re-ended with a different end_reason (e.g.
-    # tui_shutdown overwriting 'branched'), which otherwise hides the branch — see issue #20856. 2. The
-    # legacy heuristic (parent ended with 'branched' before the child started), covering branch sessions
-    # created before the marker existed.
     include_sources = [source] if source else list(sources or [])
     source_clause, source_params = _source_match_clause(include_sources, local_created_sources)
     for clause, values in (
@@ -138,6 +130,18 @@ def _session_filter_where(
         where.append("s.archived = 1")
     elif not include_archived:
         where.append("s.archived = 0")
+    # Show roots and user-visible branch/reset sessions, while still hiding sub-agent runs and compression
+    # continuations. All four carry parent_session_id, so the shared predicate classifies the edge from
+    # stable markers plus legacy-compatible parent metadata. Branch sessions are identified two ways, OR'd
+    # for robustness: 1. A stable ``_branched_from`` marker in model_config, written by /branch at creation
+    # time. This survives the parent being reopened and re-ended with a different end_reason (e.g.
+    # tui_shutdown overwriting 'branched'), which otherwise hides the branch — see issue #20856. 2. The
+    # legacy heuristic (parent ended with 'branched' before the child started), covering branch sessions
+    # created before the marker existed.
+    if exclude_children and include_subagents:
+        where.append(f"({_LISTABLE_CHILD_SQL} OR {_delegate_from_json('s.model_config')} IS NOT NULL)")
+    elif exclude_children:
+        where += [_LISTABLE_CHILD_SQL, f"{_delegate_from_json('s.model_config')} IS NULL"]
     return where, params
 
 
diff --git a/tests/hermes_cli/test_browse_schema_drift.py b/tests/hermes_cli/test_browse_schema_drift.py
index 75b154eff9..43f18f6cc2 100644
--- a/tests/hermes_cli/test_browse_schema_drift.py
+++ b/tests/hermes_cli/test_browse_schema_drift.py
@@ -200,6 +200,7 @@ def _drop_session_column(path, column):
     with closing(sqlite3.connect(path)) as conn:
         # SQLite refuses DROP COLUMN while an index references it; a pre-column store has neither.
         conn.execute("DROP INDEX IF EXISTS idx_sessions_effective_activity")
+        conn.execute("DROP INDEX IF EXISTS idx_sessions_pinned")
         conn.execute("DROP TRIGGER IF EXISTS sessions_projection_update")
