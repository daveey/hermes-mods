diff --git a/cron/scheduler_authority.py b/cron/scheduler_authority.py
index eea00d6598a..1515bb98ca9 100644
--- a/cron/scheduler_authority.py
+++ b/cron/scheduler_authority.py
@@ -9,6 +9,48 @@ class CronExecutionUnknown(RuntimeError):
     """The owner may have accepted this fire; never book it as failed or re-fire."""
 
 
+class CronFireNotAdmitted(RuntimeError):
+    """[daveey] No ready owner was reached and nothing was submitted (the gateway is draining for an
+    update, starting, or absent): a scheduled fire is held and stays due, never booked as a failed
+    run. Raised only before admission; a refusal after submit stays a definite failure."""
+
+    def __init__(self, message, state, reason_code=None):
+        super().__init__(message)
+        self.state, self.reason_code = state, reason_code
+
+
+# GatewayUnavailableError states that mean "not ready yet", not "this owner refuses the job".
+_NOT_READY_STATES = frozenset({'draining', 'starting', 'absent'})
+
+
+def settle_unbooked_fire(job, exc, fire_owner, execution_id):
+    """[daveey] Settle a fire that must not be booked as a failed run; True when it was handled.
+
+    - CronFireNotAdmitted on a scheduled fire: the gateway was not ready (an update's restart gap)
+      and nothing was submitted. The slot goes back on the schedule, the streak and last verdict
+      stay, and the ledger row records the non-admission. Manual fires still fail loudly.
+    - CronExecutionUnknown: the owner may have accepted it, so the job pauses for reconciliation.
+    Every other error returns False and takes the failed-run path."""
+    import logging
+    log = logging.getLogger('cron.scheduler')
+    if isinstance(exc, CronFireNotAdmitted) and job.get('_scheduled_instant'):
+        from cron.executions import finish_execution
+        from cron.jobs import release_unadmitted_fire
+        released = release_unadmitted_fire(
+            job['id'], job['_scheduled_instant'], str(exc), expected_fire_owner=fire_owner or None)
+        finish_execution(execution_id, success=False, error=str(exc), delivery_outcome='suppressed')
+        log.warning('Cron %s held (%s): %s', job['id'],
+                    'slot stays due' if released else 'claim moved on', exc)
+        return True
+    if isinstance(exc, CronExecutionUnknown):
+        from cron.executions import give_up_execution
+        pause_for_unknown(job['id'], execution_id, str(exc))
+        give_up_execution(execution_id, reason=str(exc))
+        log.error('Cron %s paused with unverified admission: %s', job['id'], exc)
+        return True
+    return False
+
+
 def journal_path(job_id, request_id):
     from hermes_constants import get_hermes_home
     key = hashlib.sha256(json.dumps([job_id, request_id]).encode()).hexdigest()
@@ -143,6 +185,14 @@ def run_canonical_job(job, *, extra_prompt=None, cancel_event=None, execution_id
     except Exception as exc:
         if attempted:
             raise CronExecutionUnknown(f'Cron execution unverified; reconcile {journal}: {exc}') from exc
+        from hermes_cli.gateway_client import GatewayUnavailableError
+        if isinstance(exc, GatewayUnavailableError) and exc.state in _NOT_READY_STATES:
+            # The gate's probe said ready, then an update fenced the gateway before connect:
+            # nothing was submitted, so the fire is held for the next tick, not failed.
+            reason = exc.state + (f' ({exc.reason_code})' if exc.reason_code else '')
+            raise CronFireNotAdmitted(
+                f'Not admitted: the gateway is {reason}; the fire stays due: {exc}',
+                exc.state, exc.reason_code) from exc
         error = f'{type(exc).__name__}: {exc}'
         return False, f'# Cron Job: {job["id"]} (FAILED)\n\n{error}\n', '', error
 
diff --git a/cron/scheduler_gateway_gate.py b/cron/scheduler_gateway_gate.py
index 8433472d1c4..0280101eefe 100644
--- a/cron/scheduler_gateway_gate.py
+++ b/cron/scheduler_gateway_gate.py
@@ -1,17 +1,20 @@
-"""Headless tick gate: agent jobs need a live gateway; a headless tick never starts one.
-
-``run_canonical_job`` reaches the owner through ``connect_gateway`` → ``ensure_gateway_runtime``,
-which spawns an unmanaged daemon when nothing owns the profile. That is right for an interactive
-caller (``hermes cron run``) and wrong for ``hermes cron tick`` from a system crontab: every tick
-would leave a stray gateway behind. Headless surfaces refuse rather than spawn (same policy as
-approvals), so a headless tick skips its agent jobs while the gateway is down and lets them fire
-on the next tick once it is up — no run is recorded and the due instant does not move. The
-in-process ticker never reaches this gate: it runs inside the gateway by definition.
-
-"Down" is every outcome but ``ready``: a gateway still ``starting`` (or draining, or one whose
-control socket does not answer) would otherwise send the tick into ``ensure_gateway_runtime``'s
-30 s wait and book the deadline as a FAILED run, consuming the slot — the crontab minute is the
-budget, and a slot lost to a restart window is a missed fire, not a job failure.
+"""Tick gate: agent jobs need a ready gateway; a tick outside the gateway holds them until there is one.
+
+``run_canonical_job`` reaches the owner through ``connect_gateway`` → ``ensure_gateway_runtime``.
+Every tick whose process has no gateway owner bound (``gateway.session_cron.owner_for_home``) dials
+out that way: the system-crontab ``hermes cron tick`` (headless) and the Desktop ``serve`` ticker,
+which takes over a store whenever no gateway pid owns it, including the seconds a ``hermes update``
+restarts the gateway. Only the gateway's own ticker admits in-process and skips this gate.
+
+"Not ready" is every outcome but ``ready``, plus a live update fence: ensure would answer
+``draining``/``update_paused`` (or wait a whole deadline on a ``starting`` owner) and the run would
+be booked FAILED, consuming the slot and growing ``failure_streak`` (hermes-hub 2026-10-29/30, cron
+6b4342ad83d9: three FAILED runs, one per update restart). Held agent jobs are not run, not failed,
+and their due instant does not move: they fire on the first tick that finds the gateway ready.
+
+``may_start``: an interactive owner (the Desktop ticker) may still let ensure start an ABSENT
+gateway outside an update. A headless tick never spawns one: every crontab tick would leave a stray
+daemon behind (headless surfaces refuse rather than spawn, the same policy as approvals).
 """
 import logging
 import os
@@ -22,24 +25,42 @@ GATEWAY_DOWN_HINT = (
     "the gateway is not running, so agent jobs cannot fire; they run at the next tick once it is "
     "up. Start it with `hermes gateway start` (or `hermes gateway install` for a service)."
 )
+UPDATE_HINT = (
+    "a Hermes update is in progress (gateway update_paused), so agent jobs cannot fire; they run "
+    "at the first tick after the update."
+)
 # A crontab tick has a minute; a gateway still starting answers within a few seconds or not at all.
 _HEADLESS_PROBE_TIMEOUT_S = 5.0
 
 
-def _gateway_unavailable(home) -> str | None:
-    """Why a headless tick must hold its agent jobs, or None when a ready owner serves *home*.
-    Everything short of ``ready`` — absent (``ensure`` would spawn), starting/draining (``ensure``
-    would wait a whole deadline then fail the run), inaccessible/incompatible (no owner answers) —
-    is held, never booked as a run."""
+def _update_in_progress(home) -> bool:
+    """The same update fence ``ensure_gateway_runtime`` consults (profile, process, install root)."""
+    from hermes_cli.gateway_runtime import _update_fenced
+    from hermes_constants import get_default_hermes_root, get_process_hermes_home
+
+    try:
+        return _update_fenced({home, get_process_hermes_home(), get_default_hermes_root()})
+    except Exception:  # ensure judges an unreadable fence itself; never stop the tick here
+        logger.debug("update fence check failed for %s", home, exc_info=True)
+        return False
+
+
+def _gateway_unavailable(home, *, may_start: bool = False) -> str | None:
+    """Why this tick must hold its agent jobs, or None when they may dispatch. An update fence holds
+    (ensure answers update_paused even over a running gateway); otherwise ``ready`` dispatches,
+    ``absent`` dispatches only when *may_start*, and starting/draining/inaccessible/incompatible
+    hold (ensure would wait a whole deadline, or no owner answers), never booked as a run."""
     from hermes_cli.gateway_runtime import discover_gateway_endpoint
 
     if os.environ.get("HERMES_TUI_GATEWAY_URL", "").strip():
         return None  # explicit remote gateway: connect_gateway never spawns for it
+    if _update_in_progress(home):
+        return UPDATE_HINT
     observed = discover_gateway_endpoint(home, timeout=_HEADLESS_PROBE_TIMEOUT_S)
     if observed.state == "ready":
         return None
     if observed.state == "absent":
-        return GATEWAY_DOWN_HINT
+        return None if may_start else GATEWAY_DOWN_HINT
     reason = observed.state + (f" ({observed.reason_code})" if observed.reason_code else "")
     return (f"the gateway is {reason}, so agent jobs cannot fire; they run at the next tick once it "
             "is ready. Check it with `hermes gateway status`.")
@@ -63,16 +84,16 @@ def _note_fire_refused(job_ids, detail: str) -> None:
         save_jobs(jobs)
 
 
-def refuse_agent_jobs_without_gateway(due_jobs: list) -> list:
-    """Return the due jobs a headless tick may dispatch; agent jobs are held back (skipped, not
-    failed) when no ready gateway serves this home. Logs once per tick, not once per job."""
+def refuse_agent_jobs_without_gateway(due_jobs: list, *, may_start: bool = False) -> list:
+    """Return the due jobs this tick may dispatch; agent jobs are held back (skipped, not failed)
+    when no ready gateway serves this home. Logs once per tick, not once per job."""
     from hermes_constants import get_hermes_home
 
     agent_jobs = [job for job in due_jobs if not job.get("no_agent")]
     if not agent_jobs:
         return due_jobs
     home = get_hermes_home().resolve()
-    hint = _gateway_unavailable(home)
+    hint = _gateway_unavailable(home, may_start=may_start)
     if hint is None:
         return due_jobs
     ids = [str(job["id"]) for job in agent_jobs]
@@ -81,3 +102,15 @@ def refuse_agent_jobs_without_gateway(due_jobs: list) -> list:
         "Cron tick for %s skipped %d agent job(s) (%s): %s",
         home, len(ids), ", ".join(ids), hint)
     return [job for job in due_jobs if job.get("no_agent")]
+
+
+def tick_needs_gate(headless: bool) -> bool:
+    """True for every tick whose agent jobs would dial out: headless, or no gateway owner bound in
+    this process (the Desktop ``serve`` ticker, a standalone in-process ticker). Decided by the
+    owner binding itself rather than by which entry point ticks, so a new ticker path is gated."""
+    if headless:
+        return True
+    from gateway import session_cron
+    from hermes_constants import get_hermes_home
+
+    return session_cron.owner_for_home(get_hermes_home()) is None
