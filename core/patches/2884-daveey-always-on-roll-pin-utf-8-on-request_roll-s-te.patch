From 4663a00c86849587599f69dc7936c6cf201501d0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 18:04:59 +0000
Subject: [PATCH] [daveey] always-on roll: pin utf-8 on request_roll's text
 subprocess; exempt the roller's loopback backend client from the
 session-token route guard

---
 hermes_cli/always_on_rollover.py                        | 2 +-
 tests/hermes_cli/test_dashboard_session_token_routes.py | 6 ++++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/always_on_rollover.py b/hermes_cli/always_on_rollover.py
index 0f1e5fc14e..794f2d2aa5 100644
--- a/hermes_cli/always_on_rollover.py
+++ b/hermes_cli/always_on_rollover.py
@@ -168,7 +168,7 @@ def request_roll(run: Callable = subprocess.run) -> bool:
     """Ask the roller unit for a warm roll without waiting for it (``hermes update``'s dashboard refresh)."""
     try:
         return run(["systemctl", "--user", "restart", "--no-block", ROLLER_UNIT], capture_output=True,
-                   text=True, timeout=15).returncode == 0
+                   text=True, encoding="utf-8", errors="replace", timeout=15).returncode == 0
     except (OSError, subprocess.SubprocessError):
         return False
 
diff --git a/tests/hermes_cli/test_dashboard_session_token_routes.py b/tests/hermes_cli/test_dashboard_session_token_routes.py
index 779741315e..efa8f24aaf 100644
--- a/tests/hermes_cli/test_dashboard_session_token_routes.py
+++ b/tests/hermes_cli/test_dashboard_session_token_routes.py
@@ -108,6 +108,12 @@ def test_loopback_dashboard_still_accepts_the_session_header(gated):
 _EXEMPT = {
     ("hermes_cli/web_server.py", "_dashboard_selftest_once"):
         "in-process ASGI self-test; its loop skips gated binds",
+    ("hermes_cli/always_on_rollover.py", "_http_get"):
+        "roller -> its own loopback-only always-on backend (serve --isolated on 127.0.0.1, never gated); "
+        "the path is a parameter because warmup replays Desktop's own GETs",
+    ("hermes_cli/always_on_rollover.py", "_http_post"):
+        "roller -> its own loopback-only always-on backend (never gated); the path is a parameter "
+        "(only /api/health/retirement, already a session-token route)",
 }
 _API_PATH = re.compile(r"/api/[A-Za-z0-9_\-/{}.]*")
 
-- 
2.43.0

