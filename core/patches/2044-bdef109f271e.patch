From bdef109f271efac00784ebfa4b337f05a08d15e2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 8 Nov 2026 00:38:14 +0000
Subject: [PATCH] test(groups): use one clock for owed revoke bounds [daveey]

---
 .../test_hosted_room_owed_revoke_bounds.py    | 22 +++++++++----------
 1 file changed, 11 insertions(+), 11 deletions(-)

diff --git a/tests/gateway/test_hosted_room_owed_revoke_bounds.py b/tests/gateway/test_hosted_room_owed_revoke_bounds.py
index 5794597fbbc..17b336f8980 100644
--- a/tests/gateway/test_hosted_room_owed_revoke_bounds.py
+++ b/tests/gateway/test_hosted_room_owed_revoke_bounds.py
@@ -2,7 +2,6 @@
 
 import base64
 import json
-import time
 
 from gateway import hosted_rooms
 
@@ -20,30 +19,30 @@ def _rows(db):
                             "ORDER BY member_id, expires_at").fetchall()
 
 
-def _owe(db, grant, *, member="peer", room="ended", expires_at=None):
+def _owe(db, grant, *, now, member="peer", room="ended", expires_at=None):
     from gateway.hosted_room_peer import room_grant_hard_expiry
     hosted_rooms.owe_room_grant_revoke(
         db, room_id=room, member_id=member, target_url="http://127.0.0.1:9", grant=grant,
-        expires_at=room_grant_hard_expiry(grant) if expires_at is None else expires_at)
+        expires_at=room_grant_hard_expiry(grant) if expires_at is None else expires_at, now=now)
 
 
 def test_an_owed_revoke_lives_no_longer_than_the_longest_signed_horizon(tmp_path):
-    db, now = tmp_path / "state.db", time.time()
-    _owe(db, _grant(now + 10**9, "forever"))  # an unsigned payload claiming 30 years
+    db, now = tmp_path / "state.db", 1_700_000_000.0
+    _owe(db, _grant(now + 10**9, "forever"), now=now)  # an unsigned payload claiming 30 years
     (_member, expires_at, _attempts), = _rows(db)
-    assert expires_at <= now + hosted_rooms.MAX_OWED_REVOKE_SECONDS + 60
+    assert expires_at == now + hosted_rooms.MAX_OWED_REVOKE_SECONDS
 
 
 def test_repeated_and_many_grants_for_one_member_keep_a_few_rows(tmp_path):
-    db, now = tmp_path / "state.db", time.time()
+    db, now = tmp_path / "state.db", 1_700_000_000.0
     same = _grant(now + 3600, "same")
     for _ in range(5):
-        _owe(db, same)
+        _owe(db, same, now=now)
     assert len(_rows(db)) == 1
     refused = 0
     for index in range(50):
         try:
-            _owe(db, _grant(now + 3600 + index, f"g{index}"))
+            _owe(db, _grant(now + 3600 + index, f"g{index}"), now=now)
         except hosted_rooms.OwedRevokesFullError:
             refused += 1  # the caller revokes that grant at once (HostedRoomService.owe_grant_revoke)
     assert len(_rows(db)) == hosted_rooms.MAX_OWED_REVOKES_PER_MEMBER
@@ -51,8 +50,9 @@ def test_repeated_and_many_grants_for_one_member_keep_a_few_rows(tmp_path):
 
 
 def test_an_owed_revoke_is_retried_until_its_grant_expires(tmp_path):
-    db, now = tmp_path / "state.db", time.time()
-    _owe(db, _grant(now + 30 * 86400, "unreachable"))
+    # Creation and due queries share one clock, even if SQLite setup is descheduled.
+    db, now = tmp_path / "state.db", 1_700_000_000.0
+    _owe(db, _grant(now + 30 * 86400, "unreachable"), now=now)
     for attempt in range(200):
         owed, = hosted_rooms.due_room_grant_revokes(db, limit=5, now=now + attempt + 1)
         hosted_rooms.settle_room_grant_revoke(
