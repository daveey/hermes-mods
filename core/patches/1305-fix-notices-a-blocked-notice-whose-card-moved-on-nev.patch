From e555afdb330a07c874fddb5899850a59acefafef Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 11:19:34 -0700
Subject: [PATCH] fix(notices): a blocked notice whose card moved on never
 wakes a close-out turn [daveey]

The notice guarantee woke a '[Kanban close-out] ... the decision you need from
them' turn for a chat whose last row was a 3-day-old 'Decision needed' blocked
notice, although the card had resolved its own question the next day and
rescheduled (coach pattern closeout-notice-stale-decision, session
20261016_205230_62e09a). A blocked notice whose cards are no longer
blocked/triage on the live board (answered and unblocked, rescheduled, done,
archived), or a remote/board-gone one the fan-out marked stale, is now stamped
closeout.state=superseded and only refreshes the chat outcome.

Tests: tests/tui_gateway/test_notice_guarantee.py (3 fail before, pass after;
agent-blocked control still dispatches).
---
 tests/tui_gateway/test_notice_guarantee.py | 50 ++++++++++++++++++++++
 tui_gateway/notice_guarantee.py            | 42 ++++++++++++++++++
 2 files changed, 92 insertions(+)

diff --git a/tests/tui_gateway/test_notice_guarantee.py b/tests/tui_gateway/test_notice_guarantee.py
index aaddb24813..1de7d4ca1b 100644
--- a/tests/tui_gateway/test_notice_guarantee.py
+++ b/tests/tui_gateway/test_notice_guarantee.py
@@ -173,3 +173,53 @@ def test_a_notice_whose_handling_raises_is_stamped_error_once(db, monkeypatch):
     assert ng.candidates(db, time.time()) == []  # handled once, not retried on every pass
     stored = so.get_outcome(CHAT, db=db)
     assert (stored["kind"], stored["reason"]) == ("unresolved", "notice_tail")
+
+
+# Superseded decision notices (coach pattern closeout-notice-stale-decision): a "blocked" notice whose card has
+# since moved on (the user answered and it was unblocked, it rescheduled itself, finished, or was archived) asks a
+# question nobody needs to answer any more. It must not wake a close-out turn that re-asks it; it is stamped
+# ``superseded`` and the chat's outcome is refreshed. [daveey]
+
+def _decision_card():
+    with contextlib.closing(kbc.connect()) as conn:
+        return kb.create_task(conn, title="prod deploy", assignee="worker", session_id=CHAT,
+                              initial_status="blocked", human_request=HUMAN, lint_blocked=False)
+
+
+@pytest.mark.parametrize("move", ["unblock", "archive"])
+def test_a_blocked_notice_whose_card_moved_on_is_superseded_not_woken(db, move):
+    tid = _decision_card()
+    row = _notice(db, f"⏸ [default] @default Kanban {tid} blocked: Decision needed — prod deploy", task_id=tid,
+                  board="default")
+    with contextlib.closing(kbc.connect()) as conn:
+        assert (kb.unblock_task(conn, tid) if move == "unblock" else kb.archive_task(conn, tid))
+    ksa._reset_cache_for_tests()
+
+    out, calls = _run(db)
+
+    assert calls == [] and [o["result"] for o in out] == ["superseded"]
+    assert _closeout(db, row) == "superseded"
+    assert _run(db) == ([], [])  # handled once
+
+
+def test_a_remote_blocked_notice_marked_stale_is_superseded(db, monkeypatch):
+    _no_local_board(monkeypatch)
+    row = _notice(db, "⏸ Kanban t_remote3 on hub blocked — remote card", board="nosuchboard", task_id="t_remote3",
+                  gateway="hub", kanban_event_keys=["remote:hub:nosuchboard/default/t_remote3:blocked@1:default:x"],
+                  blocked_on_human=True, stale=True, stale_tasks=["t_remote3"])
+
+    out, calls = _run(db)
+
+    assert calls == [] and [o["result"] for o in out] == ["superseded"]
+    assert _closeout(db, row) == "superseded"
+
+
+def test_a_blocked_notice_whose_card_is_still_blocked_by_an_agent_still_gets_a_closeout(db):
+    with contextlib.closing(kbc.connect()) as conn:
+        tid = kb.create_task(conn, title="flaky", assignee="worker", session_id=CHAT)
+        kb.block_task(conn, tid, reason="transient CI outage", kind="transient")
+    row = _notice(db, f"⏸ Kanban {tid} blocked: transient CI outage", task_id=tid, board="default")
+
+    out, calls = _run(db)
+
+    assert calls == [(CHAT, row)] and [o["result"] for o in out] == ["dispatched"]
diff --git a/tui_gateway/notice_guarantee.py b/tui_gateway/notice_guarantee.py
index 37f05de95c..98631cfbd3 100644
--- a/tui_gateway/notice_guarantee.py
+++ b/tui_gateway/notice_guarantee.py
@@ -6,6 +6,8 @@ separately, best-effort (live poller, unloaded sweeper wake, chat-closeout). Res
 unloaded sweeper's loop therefore looks, in every profile store, for chats whose last active message is a
 ``kanban_notice`` older than ``GRACE_S`` with no live turn, and:
 
+- a "blocked" notice whose card has moved on since (answered, rescheduled, done, archived) never wakes: it is
+  stamped ``closeout.state = "superseded"`` and the chat's outcome is refreshed;
 - a notice about a card blocked on a human never wakes: the chat's outcome is refreshed (it reads ``decision``);
 - otherwise the notice row is claimed (``display_metadata.closeout``, compare-and-swap on the row, so exactly one
   backend acts on it) and ONE close-out turn is started with ``server._wake_session_turn``; the claim records the
@@ -143,6 +145,44 @@ def blocked_on_human(cand: dict) -> bool:
         return flagged or any(_blocked_on_human(_kb.get_task(conn, tid)) for tid in sorted(tasks))
 
 
+def superseded(cand: dict) -> bool:
+    """True when this is a "blocked" notice whose card has moved on since: answered and unblocked, rescheduled,
+    finished or archived. Its question needs no answer any more, so no close-out turn re-asks it (coach pattern
+    closeout-notice-stale-decision: a 3-day-old "Decision needed" notice woke a turn after the card had resolved
+    it itself). Local notices are judged by the live board (every card on a blocked line must be found and out of
+    blocked/triage); remote notices, and local ones whose board is gone, by the ``stale`` flag the fan-out sets
+    when the card changes (``notice_fanout.mark_stale_blocked_notices``). [daveey]"""
+    from hermes_cli import kanban_db as _kb
+    from hermes_cli import kanban_db_connect as _kbc
+    from tui_gateway.notice_fanout import _BLOCKED_LINE
+    meta = cand["meta"]
+    stale = bool(meta.get("stale"))  # only ever set on blocked notices, by the fan-out
+    blocked = sorted(set(_BLOCKED_LINE.findall(cand["content"])))
+    if not blocked or _is_remote(meta):
+        return stale
+    keys = [str(k) for k in meta.get("kanban_event_keys") or () if ":" in str(k) and not str(k).startswith("remote:")]
+    board = meta.get("board") or (keys[0].rsplit(":", 1)[0] if keys else None)
+    try:
+        conn = _kbc.connect(board=board) if board else _kbc.connect()
+    except ValueError:
+        return stale
+    with contextlib.closing(conn):
+        tasks = [_kb.get_task(conn, tid) for tid in blocked]
+    if any(t is None for t in tasks):
+        return stale
+    return all(str(getattr(t, "status", "") or "") not in ("blocked", "triage") for t in tasks)
+
+
+def _supersede(db: Any, cand: dict, now: float) -> str:
+    """Stamp the notice ``superseded`` (compare-and-swap like a claim) and refresh the chat's outcome."""
+    meta = {**cand["meta"], "closeout": {"state": "superseded", "at": now, "pid": os.getpid()}}
+    if db._write_rowcount("UPDATE messages SET display_metadata = ? WHERE id = ? AND display_metadata IS ?",
+                          (json.dumps(meta, ensure_ascii=False), cand["msg_id"], cand["raw_meta"])) != 1:
+        return "skipped:claimed"
+    _refresh(db, cand["sid"])
+    return "superseded"
+
+
 def _wake(sid: str, msg_id: int) -> str:
     from tui_gateway import server
     meta = {"display_text": CLOSEOUT_DISPLAY, "closeout": {"state": "self", "of": msg_id}}
@@ -187,6 +227,8 @@ def _handle(db, cand: dict, now: float, *, holders, session_db, wake, spawn) ->
         return "skipped:held"
     if _live_turn(db, sid):
         return "skipped:live"
+    if superseded(cand):
+        return _supersede(db, cand, now)
     if blocked_on_human(cand):
         _refresh(db, sid)
         return "refreshed:human"
