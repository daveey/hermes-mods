From 5a499bea1cf0b92834466c17673027e93607742d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 06:23:05 +0000
Subject: [PATCH] test(profiles): exercise config file freshness and preserve
 absent-home scan seam [daveey]

---
 hermes_cli/web_routers/profiles.py                    | 7 ++++---
 tests/hermes_cli/test_profiles_sessions_scan_cache.py | 3 ++-
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/web_routers/profiles.py b/hermes_cli/web_routers/profiles.py
index 65c7435545a..522b6307792 100644
--- a/hermes_cli/web_routers/profiles.py
+++ b/hermes_cli/web_routers/profiles.py
@@ -509,9 +509,10 @@ def get_profiles_sessions(
     errors: list[dict[str, str]] = []
     now = time.time()
     for name, home in targets:
-        include_subagents, exclude = subagent_listing_scope(
-            home, source=filters["source"], sources=filters["sources"],
-            exclude_sources=filters["exclude_sources"])
+        include_subagents, exclude = (subagent_listing_scope(
+            home, source=source or None, sources=_csv_list(sources) or None,
+            exclude_sources=_csv_list(exclude_sources) or None)
+            if home is not None else (False, filters["exclude_sources"]))
         scoped = {**filters, "exclude_sources": exclude, "include_subagents": include_subagents}
         cache_key = (per_profile, order, full, tuple(
             (key, tuple(value) if isinstance(value, list) else value) for key, value in scoped.items()))
diff --git a/tests/hermes_cli/test_profiles_sessions_scan_cache.py b/tests/hermes_cli/test_profiles_sessions_scan_cache.py
index bc3e5dca7ac..d103241a9a5 100644
--- a/tests/hermes_cli/test_profiles_sessions_scan_cache.py
+++ b/tests/hermes_cli/test_profiles_sessions_scan_cache.py
@@ -84,7 +84,8 @@ def test_effective_config_filter_and_profile_roster_are_live(listing, monkeypatc
     db.create_session('child', source='subagent', parent_session_id='first',
                       model_config={'_delegate_from': 'first'})
     assert [row['id'] for row in poll(client)['sessions']] == ['first']
-    monkeypatch.setattr(profiles, 'subagent_listing_scope', lambda *a, **kw: (True, None))
+    from hermes_cli.config import atomic_config_write
+    atomic_config_write(tmp_path / 'config.yaml', {'sessions': {'show_subagents': True}})
     assert {row['id'] for row in poll(client)['sessions']} == {'first', 'child'}
     assert len(scans) == 2
     other_home = tmp_path / 'other'
-- 
2.55.0

