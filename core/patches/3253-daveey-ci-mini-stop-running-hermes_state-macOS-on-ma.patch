 scripts/ci/classify_changes.py           |   3 +-
 tests/ci/test_macos_state_routing.py     | 111 +++++++----------------
 4 files changed, 57 insertions(+), 123 deletions(-)

diff --git a/.github/workflows/ci.yaml b/.github/workflows/ci.yaml
index 04c3a86d93..89053e7763 100644
--- a/.github/workflows/ci.yaml
+++ b/.github/workflows/ci.yaml
@@ -7,9 +7,10 @@ name: CI
 #
 # Sub-workflows are triggered via ``workflow_call`` and keep their own job
 # definitions, matrices, and concurrency settings. They no longer have
-# ``push:`` / ``pull_request:`` triggers of their own, except hermes-state-macos
-# and native-memory-macos: each keeps standalone main validation (its own
-# ``push:`` trigger), masked out of this workflow on main pushes.
+# ``push:`` / ``pull_request:`` triggers of their own, except native-memory-macos,
+# which keeps standalone main validation (its own path-filtered ``push:``
+# trigger). hermes-state-macos validates main from its own 4-hourly schedule
+# instead. Both are masked out of this workflow on main pushes.
 #
 # SECURITY: this workflow runs PR-controlled actions, workflows, and code.
 # Do not add ``secrets: inherit`` or GitHub App credentials here. Trusted
@@ -132,11 +133,10 @@ jobs:
         # lanes are forced off unless this is a release run or a manual dispatch
         # (whose empty diff already turns every lane on): never on a pull request
         # or a push to main, whatever the diff or labels say. The macOS state and
-        # native memory lanes are off on a main push (hermes-state-macos.yml runs
-        # main from its own path-filtered push trigger and 4-hourly schedule, and
-        # native-memory-macos.yml from its own push trigger, so a main push never
-        # runs a suite twice on the one mini runner) and on for a dispatch or a
-        # release.
+        # native memory lanes are off on a main push (hermes-state-macos.yml tests
+        # main from its own 4-hourly schedule, and native-memory-macos.yml from
+        # its own push trigger, so a main push never queues the one mini runner
+        # behind required PR jobs) and on for a dispatch or a release.
         id: gate-lanes
         env:
           RELEASE: ${{ inputs.release }}
@@ -316,7 +316,7 @@ jobs:
     # on the mini: the job skips, and macos-state-required below then fails the
     # selected lane, so a fork change to that surface cannot merge on a skip.
     # Main pushes skip here (detect turns the lane off); the workflow's own
-    # path-filtered push trigger and 4-hourly schedule run main.
+    # 4-hourly schedule tests main HEAD.
     if: needs.detect.outputs.hermes_state == 'true' && (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository)
     uses: ./.github/workflows/hermes-state-macos.yml
     with:
diff --git a/.github/workflows/hermes-state-macos.yml b/.github/workflows/hermes-state-macos.yml
index c2383fd1c5..b584c1a21d 100644
--- a/.github/workflows/hermes-state-macos.yml
+++ b/.github/workflows/hermes-state-macos.yml
@@ -12,47 +12,23 @@ name: hermes_state (macOS)
 #
 # ci.yaml calls this for selected same-repository PRs and release/dispatch runs.
 # Its macOS state required (v1) consumer requires success when selected.
-# Main pushes run here directly; CI masks its duplicate call only on main pushes.
 #
-# Main pushes start this lane only when they touch the surface ci.yaml's
-# classifier selects it for (scripts/ci/classify_changes.py: _HERMES_STATE_PATHS,
-# .github/ and _CI_CONFIG_FILES; tests/ci/test_macos_state_routing.py holds the
-# paths list equal to it). Running it on every main push (~1 in 12 touches that
-# surface) kept the single mini runner busy with main and queued required PR jobs
-# 90+ min. The 4-hourly schedule tests main HEAD anyway: a change outside the
-# surface that still breaks the suite (or a push whose diff GitHub cannot fully
-# evaluate: past 3,000 changed files a match beyond them is missed) surfaces
-# within 4 h instead of on its own push.
+# Main pushes do not run this lane: neither a push trigger here nor CI's call
+# (detect masks it on a non-release main push). A PR that touches the lane's
+# surface already ran it on CI's merge of the PR into main, and the 4-hourly
+# schedule tests main HEAD, so a break from two PRs landing close together (or
+# from a change outside the surface) surfaces within 4 h. A main-push run held
+# the one mini runner ~10 min and put required PR jobs 18-20 min behind it; of
+# its 5 failures in the 16 days before it was dropped, none was a confirmed code
+# regression (disk, runner loss, host timeouts; t_01a1d37abf5db0ae). ci-probe/**
+# branches keep an unfiltered push trigger for probing the runner.
 #
 # HERMES_HOME points at a throwaway temp dir so the lane can never touch the
 # live ~/.hermes of anything else running on the mini.
 
 on:
   push:
-    branches: [main, 'ci-probe/**']
-    paths:
-      - 'hermes_state*'
-      - 'hermes_state*/**'
-      - 'tests/hermes_state/**'
-      - 'tests/conftest.py'
-      - 'tests/_fixtures/**'
-      - 'tests/fakes/**'
-      - 'tests/e2e/conftest.py'
-      - 'tests/e2e/core/_*'
-      - 'tests/e2e/core/_*/**'
-      - 'scripts/run_tests.sh'
-      - 'scripts/run_tests_parallel.py'
-      - 'scripts/run_tests_host_slots.py'
-      - 'scripts/worker_test_budget.py'
-      - 'scripts/run_tests_parallel_rss.py'
-      - 'scripts/run_tests_launch.py'
-      - 'scripts/run_tests_fork_child.py'
-      - 'pyproject.toml'
-      - 'uv.lock'
-      - 'setup.py'
-      - '.github/**'
-      - 'justfile'
-      - 'scripts/hermes-python'
+    branches: ['ci-probe/**']
   schedule:
     - cron: '23 */4 * * *'
   workflow_dispatch:
@@ -67,8 +43,8 @@ permissions:
   contents: read
 
 concurrency:
-  # Collapse queued standalone pushes and scheduled main runs, but never
-  # supersede a required caller.
+  # Collapse queued scheduled main runs (and ci-probe pushes, per branch), but
+  # never supersede a required caller.
   group: ${{ github.workflow == 'hermes_state (macOS)' && (github.event_name == 'push' || github.event_name == 'schedule') && format('hermes-state-macos-push-{0}', github.ref) || format('hermes-state-macos-{0}-{1}-{2}', github.run_id, github.run_attempt, inputs.commit || github.sha) }}
   cancel-in-progress: false
 
