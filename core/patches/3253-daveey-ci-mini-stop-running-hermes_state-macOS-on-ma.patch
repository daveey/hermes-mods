-def _gha_path_glob(pattern):
-    """GitHub ``on.push.paths`` glob: ``*`` stops at ``/``, ``**`` crosses it, whole-path match."""
-    out, i = '', 0
-    while i < len(pattern):
-        if pattern.startswith('**', i):
-            out, i = out + '.*', i + 2
-        elif pattern[i] == '*':
-            out, i = out + '[^/]*', i + 1
-        else:
-            out, i = out + re.escape(pattern[i]), i + 1
-    return re.compile(out + r'\Z')
