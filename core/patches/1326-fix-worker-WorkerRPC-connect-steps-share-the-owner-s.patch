From ff727b789d071d615d9225ba3c80c460580422af Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 21:04:01 +0000
Subject: [PATCH] fix(worker): WorkerRPC connect steps share the owner-stall
 budget, not fixed 5 s deadlines [daveey]

David-MBP run 10619 (10-30 13:15:50 PDT) lost its managed worker on the
WorkerRPC connect: websockets connect(open_timeout=5) -> TimeoutError: timed
out while waiting for handshake response, while the owner's loop stalled >10 s
under load. _connection had three fixed 5 s deadlines on the same owner
(discover_gateway_endpoint, query_identify, connect open_timeout); nothing
retries, so one owner delay over 5 s failed the whole run.

Nothing has been sent during connect, so waiting is safe: the three steps now
share one deadline of worker_receipt_timeout_s() (the same budget a receipt
gets), each taking what remains.

Tests (both RED with the 5 s deadlines restored):
- the connect steps each get (what is left of) the receipt budget;
- a worker process whose owner answers the WebSocket upgrade 8 s late lands
  its first worker.persist and exits 0 (old code: handshake TimeoutError).
---
 agent/runtime_session_store.py                | 19 ++++-
 .../agent/test_worker_rpc_connection_reuse.py | 74 +++++++++++++++++++
 2 files changed, 89 insertions(+), 4 deletions(-)

diff --git a/agent/runtime_session_store.py b/agent/runtime_session_store.py
index 06c56fb482..1bc8c1d955 100644
--- a/agent/runtime_session_store.py
+++ b/agent/runtime_session_store.py
@@ -16,6 +16,7 @@ from pathlib import Path
 import queue
 import sys
 import threading
+import time
 from hermes_dir_acl import make_user_dir
 
 logger = logging.getLogger(__name__)
@@ -143,16 +144,25 @@ class WorkerRPC:
         from hermes_cli.gateway_client import _session_ticket, gateway_ws_target
         from hermes_cli.gateway_runtime_discovery import query_identify
         from websockets.sync.client import connect
+        from hermes_cli.ws_logging import ws_logger
         # A served secondary has no socket; its multiplexer's descriptor names it.
         from hermes_cli.gateway_runtime import discover_gateway_endpoint
-        discovery = discover_gateway_endpoint(self.home, timeout=5)
+        # Discovery, identify and the WebSocket upgrade share ONE deadline, the same owner-stall budget
+        # as a receipt: nothing is sent yet, so waiting is safe, while a fixed 5 s step failed the
+        # whole run whenever the owner's loop stalled longer (David-MBP 10-30, handshake timeout).
+        deadline = time.monotonic() + _receipt_timeout_s()
+
+        def remaining():
+            return max(0.1, deadline - time.monotonic())
+
+        discovery = discover_gateway_endpoint(self.home, timeout=remaining())
         if discovery.state == 'ready' and discovery.endpoint is not None:
             self.endpoint = discovery.endpoint
         elif discovery.state != 'draining' or self.endpoint is None:
             raise WorkerPersistenceError('owner_unavailable')
         from hermes_cli.gateway_runtime import control_home_for
         endpoint = self.endpoint
-        descriptor = query_identify(control_home_for(self.home, endpoint), timeout=5)
+        descriptor = query_identify(control_home_for(self.home, endpoint), timeout=remaining())
         if descriptor.get('pid') == os.getpid():
             raise WorkerPersistenceError('synchronous_self_rpc')
         ticket = _session_ticket(self.home, endpoint, purpose='worker-adoption')
@@ -160,8 +170,9 @@ class WorkerRPC:
         # The owner is loopback, like connect_gateway's peer: an inherited HTTPS_PROXY must not carry it.
         # No library keepalive: its pong deadline would run independently of (and could fail) a call
         # inside its receipt budget; that budget and the observed close are the liveness checks.
-        self.link = _OwnerLink(connect(url, subprotocols=protocols, open_timeout=5, close_timeout=1,
-                                       max_size=8 * 1024 * 1024, proxy=None, ping_interval=None))
+        self.link = _OwnerLink(connect(url, subprotocols=protocols, open_timeout=remaining(), close_timeout=1,
+                                       max_size=8 * 1024 * 1024, proxy=None, ping_interval=None,
+                                       logger=ws_logger()))
         return self.link
 
     def _drop(self):
diff --git a/tests/agent/test_worker_rpc_connection_reuse.py b/tests/agent/test_worker_rpc_connection_reuse.py
index 4b46e82be0..ca1fa03660 100644
--- a/tests/agent/test_worker_rpc_connection_reuse.py
+++ b/tests/agent/test_worker_rpc_connection_reuse.py
@@ -271,3 +271,77 @@ def test_an_owner_error_reply_keeps_the_connection_for_the_next_call(owner, tmp_
     assert rpc('worker.persist') == {'n': 2}
     assert owner.requests == ['fail', 'worker.persist']
     assert (owner.connections, owner.tickets) == (1, 1)
+
+
+def test_connect_steps_share_the_receipt_budget_not_a_fixed_five_seconds(owner, tmp_path, monkeypatch):
+    """Discovery, identify and the WebSocket upgrade wait on the same owner: none of them may give up
+    before the owner-stall budget a receipt gets (David-MBP 10-30 13:15: a 5 s upgrade deadline
+    failed the whole run while the owner's loop stalled)."""
+    from websockets.sync import client
+    from hermes_cli import gateway_runtime
+    import hermes_cli.gateway_runtime_discovery as discovery
+    from agent.runtime_session_store import WorkerRPC
+    from hermes_state_runtime import worker_receipt_timeout_s
+    seen = {}
+    real_discover, real_identify, real_connect = (gateway_runtime.discover_gateway_endpoint,
+                                                  discovery.query_identify, client.connect)
+
+    def discover(home, timeout):
+        seen['discover'] = timeout
+        return real_discover(home, timeout)
+
+    def identify(home, timeout):
+        seen['identify'] = timeout
+        return real_identify(home, timeout)
+
+    def connect(*args, **kwargs):
+        seen['connect'] = kwargs['open_timeout']
+        return real_connect(*args, **kwargs)
+    monkeypatch.setattr(gateway_runtime, 'discover_gateway_endpoint', discover)
+    monkeypatch.setattr(discovery, 'query_identify', identify)
+    monkeypatch.setattr(client, 'connect', connect)
+    assert WorkerRPC(tmp_path)('worker.persist') == {'n': 1}
+    budget = worker_receipt_timeout_s()
+    assert set(seen) == {'discover', 'identify', 'connect'}, seen
+    for step, timeout in seen.items():
+        # One deadline: each step gets what is left of it (milliseconds spent so far), never 5 s.
+        assert budget - 5 < timeout <= budget, (step, timeout, budget)
+
+
+_UPGRADE_WORKER = r'''
+import json, sys, time
+from types import SimpleNamespace
+sys.path.insert(0, sys.argv[1])
+from hermes_cli import gateway_client, gateway_runtime
+import hermes_cli.gateway_runtime_discovery as discovery
+endpoint = SimpleNamespace(api_origin='http://127.0.0.1:' + sys.argv[2], control_home=None)
+gateway_runtime.discover_gateway_endpoint = lambda home, timeout: SimpleNamespace(state='ready', endpoint=endpoint)
+discovery.query_identify = lambda home, timeout: {'pid': -1}
+gateway_client._session_ticket = lambda home, endpoint, purpose: 'ticket-child'
+from agent.runtime_session_store import WorkerRPC
+started = time.monotonic()
+reply = WorkerRPC(sys.argv[3])('worker.persist', operation='message.append')
+print(json.dumps({'reply': reply, 'elapsed': time.monotonic() - started}))
+'''
+
+
+@pytest.mark.platforms("linux")
+def test_worker_process_survives_an_owner_upgrade_reply_delayed_eight_seconds(owner, tmp_path):
+    """A worker process whose owner answers the WebSocket upgrade 8 s late still lands its first
+    ``worker.persist`` and exits 0 (with the old ``open_timeout=5`` it died on the handshake)."""
+    import os
+    import subprocess
+    import sys
+    from pathlib import Path
+    root = Path(__file__).resolve().parents[2]
+    env = dict(os.environ, HERMES_HOME=str(tmp_path / 'home'))
+    (tmp_path / 'home').mkdir()
+    owner.relay.stall(8)  # the owner's loop holds every byte it writes, the 101 reply included
+    result = subprocess.run([sys.executable, '-c', _UPGRADE_WORKER, str(root), str(owner.relay.port),
+                             str(tmp_path)], cwd=root, env=env, capture_output=True, text=True, timeout=60,
+                            check=False)
+    assert result.returncode == 0, result.stdout + result.stderr
+    proof = json.loads(result.stdout.strip().splitlines()[-1])
+    assert proof['reply'] == {'n': 1, 'operation': 'message.append'}, proof
+    assert proof['elapsed'] >= 7.5, proof
+    assert owner.requests == ['worker.persist']
