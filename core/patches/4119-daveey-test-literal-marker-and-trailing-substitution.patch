From 3059f72ea6fd494160c2c2d7e04c295d117ec433 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 04:15:35 +0000
Subject: [PATCH] [daveey] test literal marker and trailing substitution feeds

Retain the exact repros from t_01a1d651a23341aa. Current main already fixes sentinel aliasing with shlex escapes and resolves complete substitution writers plus closed-group output, so the older implementation is superseded. Add nine missing pipeline and trailing-redirection cases; existing closed-group parameterization covers the remaining repro.

Proof: full lifecycle_guard suite passed on rerun; scripts/check --base origin/main: 20 checks ok. Initial full run hit the existing output_sink elapsed-time assertion; isolated rerun and full rerun passed. No production behavior changed.
---
 tests/cron/test_lifecycle_guard_feed_routing.py | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/tests/cron/test_lifecycle_guard_feed_routing.py b/tests/cron/test_lifecycle_guard_feed_routing.py
index 36c7e60576..c6f5704c57 100644
--- a/tests/cron/test_lifecycle_guard_feed_routing.py
+++ b/tests/cron/test_lifecycle_guard_feed_routing.py
@@ -50,7 +50,17 @@ def files(tmp_path) -> dict[str, str]:
         "cat {sh} 2>&1 | bash",
         "cat {py} 2>&1 |& python3",
         "cat {py} 2>/dev/null 2>&1 | python3",
-        # 2. Output process substitution.
+        # Literal private-use words must not turn into pipeline-ending ampersands.
+        "cat {py} \ue000 | python3",
+        "cat {py} \ue000\ue000 | python3",
+        "cat {py} \ue000 2>&1 | python3",
+        "cat {py} \ue000\ue001 2>&1 | python3",
+        # 2. Output process substitution, including redirects after the body.
+        "cat > >(python3) < {py}",
+        "cat > >(python3) <{py}",
+        "cat >> >(python3) < {py}",
+        "cat > >(python3) < {py} 2>&1",
+        "cat > >(python3) > >(wc -l) < {py}",
         "cat {py} > >(python3)",
         "cat {sh} > >(bash)",
         "cat {py} | tee >(python3)",
