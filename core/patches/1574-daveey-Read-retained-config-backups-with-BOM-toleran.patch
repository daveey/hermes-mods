Subject: [PATCH] [daveey] Read retained config backups with BOM tolerance

---
 hermes_cli/config_backups.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hermes_cli/config_backups.py b/hermes_cli/config_backups.py
index 8df2212a2d3..dfa9cbadaeb 100644
--- a/hermes_cli/config_backups.py
+++ b/hermes_cli/config_backups.py
@@ -90,7 +90,7 @@ def _last_full_good_backup(candidates: list[Path]) -> Optional[Path]:
     counts = []
     for path in candidates:
         try:
-            doc = fast_safe_load(path.read_text(encoding="utf-8"))
+            doc = fast_safe_load(path.read_text(encoding="utf-8-sig"))
         except Exception:
             counts.append(0)
         else:
