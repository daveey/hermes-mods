From 64430a72af612466da089ce8773da4d3979c07f8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 05:30:40 -0700
Subject: [PATCH] fix(ci): lockguard lint allowlists kanban_placement_forward's
 short-lived read-only connect (red since cb924b52fd)

---
 hermes_cli/kanban_placement_forward.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_placement_forward.py b/hermes_cli/kanban_placement_forward.py
index ef7d79105e..38ad15e98e 100644
--- a/hermes_cli/kanban_placement_forward.py
+++ b/hermes_cli/kanban_placement_forward.py
@@ -86,7 +86,7 @@ def forward_argv(task, board: Optional[str], worker_cmd: list) -> Optional[list]
         path = kb.kanban_db_path(board=board)
         if not os.path.exists(path):
             return None
-        conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=10)
+        conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=10)  # noqa: kanban-lockguard — short-lived read-only handle, closed in the finally below
         try:
             st = state(conn, task.id)
         finally:
