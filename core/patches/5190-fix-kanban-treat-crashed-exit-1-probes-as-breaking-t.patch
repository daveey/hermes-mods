From 0e5c00b2a6d619ca9f7f7653bb4539b12a65835e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 09:41:28 +0000
Subject: [PATCH] fix(kanban): treat crashed exit-1 probes as breaking the
 notice streak [daveey]

Independent review of PR #3734 at 6017090052: apply_result stores last_rc=1
with fails=1 for a crashed probe posing as not-yet, so last_rc != 1 left the
early-notice streak intact. Reset when last_rc != 1 or fails, matching
kanban_passive_intake.quiet_until.

Proof: RED test_exit_1_with_error_output_breaks_notice_streak on reviewed
head; GREEN 26 notice tests; 3 exact-anchor mutants killed (drop fails,
drop last_rc, never reset).
---
 hermes_cli/kanban_wake_unproven.py            |  7 +++--
 tests/hermes_cli/test_kanban_wake_unproven.py | 29 +++++++++++++++++++
 2 files changed, 33 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_wake_unproven.py b/hermes_cli/kanban_wake_unproven.py
index 88331421b5..188fe40e98 100644
--- a/hermes_cli/kanban_wake_unproven.py
+++ b/hermes_cli/kanban_wake_unproven.py
@@ -91,9 +91,10 @@ def note_check(conn: sqlite3.Connection, task_id: str, cmd: str, out: str, now:
     conn.execute("""CREATE TABLE IF NOT EXISTS task_wake_notice_checks (
         task_id TEXT PRIMARY KEY REFERENCES tasks(id) ON DELETE CASCADE,
         park_id INTEGER NOT NULL, first_at INTEGER NOT NULL, checks INTEGER NOT NULL)""")
-    previous = conn.execute("SELECT last_rc FROM task_wake_checks WHERE task_id = ?", (task_id,)).fetchone()
-    # A failed/invalid probe breaks the consecutive not-ready streak, but not notice deduplication.
-    if previous is not None and previous[0] != 1:
+    previous = conn.execute("SELECT last_rc, fails FROM task_wake_checks WHERE task_id = ?", (task_id,)).fetchone()
+    # A failed/invalid probe (non-1 last_rc, or last_rc=1 with fails from a crash posing as not-yet)
+    # breaks the consecutive not-ready streak, but not notice deduplication.
+    if previous is not None and (previous[0] != 1 or previous[1]):
         conn.execute("DELETE FROM task_wake_notice_checks WHERE task_id = ?", (task_id,))
     conn.execute("INSERT INTO task_wake_notice_checks VALUES (?, ?, ?, 1) ON CONFLICT(task_id) DO UPDATE SET "
                  "park_id = excluded.park_id, "
diff --git a/tests/hermes_cli/test_kanban_wake_unproven.py b/tests/hermes_cli/test_kanban_wake_unproven.py
index bae27d49cb..cd769da110 100644
--- a/tests/hermes_cli/test_kanban_wake_unproven.py
+++ b/tests/hermes_cli/test_kanban_wake_unproven.py
@@ -224,6 +224,35 @@ def test_failed_probe_breaks_notice_streak(parked):
     assert notices(conn, tid)[0].payload["checks"] == 4
 
 
+def test_exit_1_with_error_output_breaks_notice_streak(parked):
+    conn, tid, clock = parked
+    result(parked, 0)
+    result(parked, 3)
+    state = wc.get_state(conn, tid)
+    wc.apply_result(
+        conn, tid, state["cmd"], 1, "Traceback (most recent call last):\nValueError: boom",
+        generation=state["generation"], now=clock[0] + 4 * HOUR)
+    result(parked, 7)
+    assert not notices(conn, tid)
+    for hour in (8, 12):
+        result(parked, hour)
+    assert not notices(conn, tid)
+    result(parked, 13)
+    assert len(notices(conn, tid)) == 1
+    assert notices(conn, tid)[0].payload["checks"] == 4
+
+
+def test_non_one_last_rc_with_zero_fails_breaks_notice_streak(parked):
+    conn, tid, _ = parked
+    result(parked, 0)
+    result(parked, 3)
+    with kb.write_txn(conn):
+        conn.execute("UPDATE task_wake_checks SET last_rc = ?, fails = 0 WHERE task_id = ?",
+                     (wc.UNKNOWN_RC, tid))
+    result(parked, 7)
+    assert not notices(conn, tid)
+
+
 def test_spent_park_is_not_used(parked):
     conn, tid, _ = parked
     with kb.write_txn(conn):
