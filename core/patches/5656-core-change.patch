From 9b7e789eeebd5789f82059ed8e64964cbf3fb3bb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 00:57:04 +0000
Subject: [PATCH] [daveey] audit refusal stop source custody and ready-age
 inventories

---
 tests/hermes_cli/test_kanban_ready_entry_registry.py | 11 +++++++----
 tests/hermes_cli/test_kanban_source_receipt_sites.py |  2 ++
 2 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_ready_entry_registry.py b/tests/hermes_cli/test_kanban_ready_entry_registry.py
index fb7d8dad53..67a185b63b 100644
--- a/tests/hermes_cli/test_kanban_ready_entry_registry.py
+++ b/tests/hermes_cli/test_kanban_ready_entry_registry.py
@@ -105,22 +105,25 @@ NON_ENTRY_WRITER_EVENTS = {
     "parent_missing", "status_healed",
     # Preclaim observation; exhaustion moves to triage, never releases to ready.
     "review_admission_refused",
+    # Safety observations close/retain a stopped run, never enter ready.
+    "safety_refused", "decision_hold_restricted",
 }
 
 
-def test_review_admission_refusal_does_not_reset_ready_age(conn):
+@pytest.mark.parametrize("kind", ["review_admission_refused", "safety_refused", "decision_hold_restricted"])
+def test_nonentry_observation_does_not_reset_ready_age(conn, kind):
     tid = kb.create_task(conn, title="review refusal observation", assignee="default")
     with kb.write_txn(conn):
         conn.execute("UPDATE tasks SET created_at=100 WHERE id=?", (tid,))
         conn.execute("UPDATE task_events SET created_at=100 WHERE task_id=?", (tid,))
-        kb._append_event(conn, tid, "review_admission_refused", {"preclaim": True})
+        kb._append_event(conn, tid, kind, {"preclaim": True})
         conn.execute(
             "UPDATE task_events SET created_at=200 WHERE task_id=? AND kind=?",
-            (tid, "review_admission_refused"),
+            (tid, kind),
         )
     assert pu.ready_since(conn, tid, 100) == 100
     assert score._ready_since(conn, [tid])[tid] == 100
-    assert "'review_admission_refused'" not in cw._floor_kinds()
+    assert f"'{kind}'" not in cw._floor_kinds()
 
 
 def _writer_events(source):
diff --git a/tests/hermes_cli/test_kanban_source_receipt_sites.py b/tests/hermes_cli/test_kanban_source_receipt_sites.py
index 20ba88a736..b1d23ab83a 100644
--- a/tests/hermes_cli/test_kanban_source_receipt_sites.py
+++ b/tests/hermes_cli/test_kanban_source_receipt_sites.py
@@ -305,6 +305,8 @@ _STATUS_IN = re.compile(r"(?<![\w.])status\s+IN\s*\(([^)]*)\)", re.IGNORECASE)
 
 # Every status-leaving ``UPDATE tasks`` that can move a card out of ``running``, by ``path::function``.
 WRAPPED = {
+    # Stop-only reclaim still preserves staged source custody with the real wrapper.
+    "hermes_cli/kanban_refusal_receipt.py::stop_failed_refusal",
     "hermes_cli/kanban_db.py::complete_task",
     "hermes_cli/kanban_dependency_review.py::apply_block_update",  # block_task
     "hermes_cli/kanban_timed_park.py::park",
-- 
