From 34172c68f73619c212bb5b0fd7e39e93a311871b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:47:12 +0000
Subject: [PATCH] [daveey] update: preload kanban_comment_writer before the
 checkout moves

Upstream's new restart_child_env case drives served_profile_child_env after the
move; the fork's _finalize_child_env lazily imports
hermes_cli.kanban_comment_writer (ssh agent marker), so it must be in
POST_MOVE_MODULES like tools.environments.local.
---
 hermes_cli/update_cmd_commit.py | 1 +
 1 file changed, 1 insertion(+)

diff --git a/hermes_cli/update_cmd_commit.py b/hermes_cli/update_cmd_commit.py
index e7fe141552..0c99d76ea4 100644
--- a/hermes_cli/update_cmd_commit.py
+++ b/hermes_cli/update_cmd_commit.py
@@ -96,6 +96,7 @@ POST_MOVE_MODULES = (
     "hermes_cli.gateway_runtime_start",
     "hermes_cli.gateway_windows",
     "hermes_cli.github_api",
+    "hermes_cli.kanban_comment_writer",  # [daveey] tools.environments.local stamps the ssh agent marker
     "hermes_cli.plugins_session_env",
     "hermes_cli.source_check",
     "hermes_cli.update_cmd_fleet_unit_budget",
-- 
2.43.0

