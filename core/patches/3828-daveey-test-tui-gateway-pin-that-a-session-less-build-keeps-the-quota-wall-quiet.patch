From c8b21ed227c28a048f56cf4d5b27c9f65b409227 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:37:17 +0000
Subject: [PATCH] [daveey] test(tui-gateway): pin that a session-less build
 keeps the quota wall quietly

Post-merge check t_01a1d6672f6410cf (PR #2496) found mutant A6 surviving: deleting the
`if not session_id: return None` guard in tui_gateway/class_routing.py::walled_pin_deferral
left all 76 tests in the four routing test files green.

Finding: the mutant does not move the pin. routing_session(None) sets the routing contextvar
to None, so gateway_deferral still refuses (no-session), even under an ambient
routing_session(SID). The guard's one observable effect is that a session-less build (the
readiness probe) refuses quietly instead of logging the per-episode
"walled pin not deferred (reason=no-session)" WARNING, which is meant for a gateway turn that
lost its session.

New test (parametrized None / ""): router-picked Astra pin + 33 h Codex wall;
walled_pin_deferral returns None directly and under an ambient routing_session(SID);
_resolve_runtime_or_defer_wall with no session raises SubscriptionQuotaUnavailable; no
not-deferred warning; the session's stored route is untouched.

Proof: under A6 both cases fail on the warning assertion (reason=no-session logged);
at main the four files pass 80/80, skipped=0.
---
 tests/agent/test_walled_default_pin.py | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/tests/agent/test_walled_default_pin.py b/tests/agent/test_walled_default_pin.py
index 94b2b96ef5..ab56214681 100644
--- a/tests/agent/test_walled_default_pin.py
+++ b/tests/agent/test_walled_default_pin.py
@@ -448,6 +448,30 @@ def test_desktop_wall_still_refuses_when_the_pin_must_not_move(home, case):
                                        'openai-codex', overrides, session)
 
 
+@pytest.mark.parametrize('session', [None, ''], ids=['none', 'empty'])
+def test_sessionless_desktop_build_keeps_the_wall_quietly(home, monkeypatch, caplog, session):
+    """A build with no session identity (the readiness probe) owns no durable route, so even a router-picked
+    pin behind a far wall is not deferred, an ambient routing session does not lend it one, and the refusal
+    stays quiet: no per-episode ``reason=no-session`` warning, which is for a gateway turn missing its session."""
+    from agent.model_routing_runtime import routing_session
+    from agent.model_routing_unavailable import SubscriptionQuotaUnavailable
+    from tui_gateway.class_routing import walled_pin_deferral
+    from tui_gateway.server import _resolve_runtime_or_defer_wall
+    monkeypatch.setattr('agent.model_routing_walls._NOT_DEFERRED_SEEN', set())
+    _router_picks_astra(home)
+    reset = _wall(home, 'openai-codex', ASTRA, 33)
+    wall = SubscriptionQuotaUnavailable('openai-codex', ASTRA, reset)
+    with caplog.at_level(logging.WARNING):
+        assert walled_pin_deferral(wall, ASTRA, 'openai-codex', session) is None
+        with routing_session(SID):
+            assert walled_pin_deferral(wall, ASTRA, 'openai-codex', session) is None
+        with pytest.raises(SubscriptionQuotaUnavailable):
+            _resolve_runtime_or_defer_wall({'requested': 'openai-codex', 'target_model': ASTRA}, ASTRA,
+                                           'openai-codex', {}, session)
+    assert _not_deferred(caplog) == []
+    assert _state(home).peek(SID, 'deep')['selected_model'] == ASTRA  # the session's route was not touched
+
+
 def test_desktop_wall_refuses_when_nothing_else_in_the_class_can_serve(home):
     from agent.model_routing_unavailable import SubscriptionQuotaUnavailable
     from tui_gateway.server import _resolve_agent_model_runtime  # agent_factory binds into the server namespace
