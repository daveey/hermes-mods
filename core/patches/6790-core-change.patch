Subject: [PATCH 6790] Origin-forward refusals, queued-create wait handles and wait-check parsing

Public mirror of source commit 91096295e32b8c070b2486998927e9d4559e3164.

---
diff --git a/hermes_cli/kanban_origin_forward_run_end.py b/hermes_cli/kanban_origin_forward_run_end.py
index 2d46e10d70a7e396e1797cc32ceddfd8a70a973a..be1b7b3dc2431886e08f0e495959ab6c3cdb9cfd 100644
--- a/hermes_cli/kanban_origin_forward_run_end.py
+++ b/hermes_cli/kanban_origin_forward_run_end.py
@@ -57,7 +57,7 @@
         return
     reservations = {json.loads(event[0])['request_id'] for event in conn.execute(
         'SELECT payload FROM task_events WHERE task_id=? AND run_id=? AND kind=?', (task_id, run_id, _RESERVED))}
-    from hermes_cli.kanban_capability_registry import hub_db_path
+    from hermes_cli.kanban_capability_registry import hub_db_path, _ro
     path = hub_db_path()
     try:
         path.lstat()
@@ -66,7 +66,7 @@
             _pending(sorted(reservations)[0])
         return
     try:
-        with closing(sqlite3.connect(path.resolve().as_uri() + '?mode=ro', uri=True)) as db:
+        with closing(_ro(path)) as db:
             for identity in sorted(reservations):
                 sent = db.execute('SELECT state FROM sent WHERE id=?', (identity,)).fetchone()
                 if not sent or sent[0] not in ('done', 'rejected'):
