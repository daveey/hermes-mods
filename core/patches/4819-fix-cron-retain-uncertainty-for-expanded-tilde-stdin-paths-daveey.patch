From 34489c949c85b0163537fb1eba943d9e8f5d756b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 05:49:06 +0000
Subject: [PATCH] fix(cron): retain uncertainty for expanded tilde stdin paths
 [daveey]

---
 cron/lifecycle_guard_nested_shells.py              |  5 +++--
 .../test_lifecycle_guard_stdin_literal_values.py   | 14 ++++++++++----
 2 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/cron/lifecycle_guard_nested_shells.py b/cron/lifecycle_guard_nested_shells.py
index a340c94f1a32aadf3ce979c06766e7f9197c468d..0bba4d965b849f27584e70943f69989fc9258eb3 100644
--- a/cron/lifecycle_guard_nested_shells.py
+++ b/cron/lifecycle_guard_nested_shells.py
@@ -922,8 +922,9 @@ def _expanded_targets(target: str, variables: dict[str, list[str]]) -> Optional[
         values = variables.get(name) or ([os.environ[name]] if name in os.environ else [])
         steps += len(values)
         # Expansion results are data, never fresh shell syntax. Our path walker
-        # cannot preserve quoting for these characters, so retain uncertainty.
-        if not values or steps > _MAX_EXPANSIONS or any(_unresolvable(value) for value in values):
+        # cannot preserve quoting or literal tildes through path resolution.
+        if not values or steps > _MAX_EXPANSIONS or any(
+                _unresolvable(value) or "~" in value for value in values):
             return None
         pending.extend(word[:match.start()] + value + word[match.end():] for value in values)
     return words
diff --git a/tests/cron/test_lifecycle_guard_stdin_literal_values.py b/tests/cron/test_lifecycle_guard_stdin_literal_values.py
index 442d7121ef1abe085bef0321c5f9e7ab0519045c..f555c32dfa59c50afb711cec828ee811c9f85012 100644
--- a/tests/cron/test_lifecycle_guard_stdin_literal_values.py
+++ b/tests/cron/test_lifecycle_guard_stdin_literal_values.py
@@ -8,13 +8,19 @@ from cron.lifecycle_guard import scan_gateway_lifecycle
     'P=$S; bash --noprofile -l < "$P"',
     'exec 3<"$S"; bash --noprofile -l <&3',
 ])
-def test_environment_value_is_not_shell_source(tmp_path, monkeypatch, command):
-    monkeypatch.setenv('S', '$T')
+@pytest.mark.parametrize('value', ['$T', '~/input.sh'])
+def test_environment_value_is_not_shell_source(tmp_path, monkeypatch, command, value):
+    monkeypatch.setenv('S', value)
     monkeypatch.setenv('T', '/dev/null')
-    script = tmp_path / '$T'
+    home = tmp_path / 'home'
+    home.mkdir()
+    (home / 'input.sh').write_text('printf harmless\n')
+    monkeypatch.setenv('HOME', str(home))
+    script = tmp_path / value
+    script.parent.mkdir(exist_ok=True)
     script.write_text("printf 'REVIEW_LITERAL_EXECUTED\\n'\n")
     result = subprocess.run(['/bin/bash', '--noprofile', '--norc', '-c', command], cwd=tmp_path,
-        env=dict(os.environ, HOME=str(tmp_path), BASH_ENV='/dev/null'), input='', text=True,
+        env=dict(os.environ, BASH_ENV='/dev/null'), input='', text=True,
         capture_output=True, timeout=10, check=False)
     assert result.returncode == 0 and result.stdout == 'REVIEW_LITERAL_EXECUTED\n', result
     script.write_text('t ( bash huge.sh )\n')
-- 
2.43.0

