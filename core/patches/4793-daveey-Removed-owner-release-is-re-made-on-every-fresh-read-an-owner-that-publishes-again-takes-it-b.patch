From e9c07f61d2703d27db7c0465cf37e267fb6879bc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 07:14:53 +0000
Subject: [PATCH] [daveey] Removed-owner release is re-made on every fresh
 read; an owner that publishes again takes it back

Review 5952178127 (request_changes on 1b96f54f6102): once `_release_removed_owners` had released a remembered row
it never looked at it again, so a machine that came back, even one republishing the exact card as running with its
session links dropped, left the chat's row done and released.

Fix: `owner_removed` is an inference, not a receipt. On every fresh read a row carrying it is first put back to
its unresolved state (unknown, unfinished, unreleased, marker dropped) and judged again: it is released only while
its owner still publishes no task record and has no fresh scope heartbeat. A stale read neither makes nor takes
back the inference. Owner-attested releases are untouched (they never carry the marker).

Tests (tests/hermes_cli/test_kanban_release_removed_owner_rows.py): the owner publishes another card, republishes
the exact card running with `sessions: []`, or only beats again, each through `_legacy_remote_links` on the real
replica file, warm and from a cold process reading the durable snapshot; removed again releases again; a stale
read keeps an earlier release; the pure rule restores and is stable.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 hermes_cli/kanban_session_activity_records.py | 23 ++++---
 .../test_kanban_release_removed_owner_rows.py | 66 +++++++++++++++++++
 2 files changed, 81 insertions(+), 8 deletions(-)

diff --git a/hermes_cli/kanban_session_activity_records.py b/hermes_cli/kanban_session_activity_records.py
index 952eda7526bfd79667afbc3477590607f2100aa2..572a9270741e2aaeb55e7e124834eba7da1ca00e 100644
--- a/hermes_cli/kanban_session_activity_records.py
+++ b/hermes_cli/kanban_session_activity_records.py
@@ -59,22 +59,29 @@ def _release_removed_owners(carried: list[dict[str, Any]], owners, moved: dict[s
     were removed (2026-11-18). Absence of ONE record is still never closure (a live owner publishing other cards
     keeps its rows as they are, see ``_retire_moved``); this is the absence of the whole owner: no task record from
     that gateway and no fresh scope heartbeat, in a replica that is not stale (``owners`` is filled only then). An
-    open, unknown-status or unqualified row is left alone, and so is everything while the replica is stale.
+    open, unknown-status or unqualified row is left alone, and so is everything while the replica is stale (an
+    earlier release included: a stale read neither makes nor takes back the inference).
     ``owners`` is the projection's ``(gateway, board, id)`` set; it is walked only when a candidate row exists."""
-    wanted = [i for i, c in enumerate(carried) if c.get('status') == 'unknown' and c.get('ownership_state') == 'qualified'
+    if not moved:
+        return carried
+    # ``owner_removed`` is an inference, re-made on every fresh read, never a completion receipt: such a row is put
+    # back to its unresolved state first, so an owner that publishes or beats again (a reprovisioned machine, even
+    # one republishing this very card as running with its session links dropped) takes the release back.
+    rows = [({**{k: v for k, v in c.items() if k != 'owner_removed'}, 'status': 'unknown', 'unfinished': True,
+              'released': False} if c.get('owner_removed') else c) for c in carried]
+    wanted = [i for i, c in enumerate(rows) if c.get('status') == 'unknown' and c.get('ownership_state') == 'qualified'
               and c.get('reported_status') in ('done', 'archived') and not c.get('released') and c.get('gateway')]
-    if not wanted or not moved:
+    if not wanted:
         return carried
     publishing = {owner[0] for owner in owners}
     if not publishing:  # a read that carries no task record at all proves nothing about who is gone
         return carried
     publishing |= {scope[0] for scope in moved.get('live_scopes', ())}
-    out = list(carried)
     for i in wanted:
-        if carried[i]['gateway'] not in publishing:
-            out[i] = {**carried[i], 'status': carried[i]['reported_status'], 'unfinished': False, 'released': True,
-                      'owner_removed': True}
-    return out
+        if rows[i]['gateway'] not in publishing:
+            rows[i] = {**rows[i], 'status': rows[i]['reported_status'], 'unfinished': False, 'released': True,
+                       'owner_removed': True}
+    return rows
 
 
 def _fold_legacy_aliases(tasks: dict[tuple, dict[str, Any]], raw: dict[tuple, dict[str, Any]]) -> None:
diff --git a/tests/hermes_cli/test_kanban_release_removed_owner_rows.py b/tests/hermes_cli/test_kanban_release_removed_owner_rows.py
index 0513b706b8b1c75a54a0c2a9fde94610a1ade796..36236bed39e962a0061a192066c8042f374b9015 100644
--- a/tests/hermes_cli/test_kanban_release_removed_owner_rows.py
+++ b/tests/hermes_cli/test_kanban_release_removed_owner_rows.py
@@ -116,3 +116,69 @@ def test_a_stale_replica_keeps_the_rows_unknown(world):
         db.execute("DELETE FROM replica WHERE gw = 'gone'")
     clock['now'] = 1000.0 + 40 * 3600  # no hub pull since: the replica is stale and proves nothing
     assert by_id(activity._legacy_remote_links())['t_done'] == ('unknown', False, True)
+
+
+def _removed_then_released(path, clock):
+    activity._legacy_remote_links()
+    with sqlite3.connect(path) as db:
+        db.execute("DELETE FROM replica WHERE gw = 'gone'")
+    tick(path, clock, 1010.0)
+    assert by_id(activity._legacy_remote_links())['t_done'] == ('done', True, True)
+
+
+@pytest.mark.parametrize('cold', [False, True])
+def test_an_owner_that_publishes_again_takes_the_release_back(world, cold):
+    """Review 5952178127: the release is an inference re-made on every fresh read, not a receipt."""
+    path, clock = world
+    _removed_then_released(path, clock)
+    put(path, 'gone', 't_new', 60, status='running')  # the machine is back and publishes another card
+    tick(path, clock, 1020.0)
+    if cold:
+        activity._reset_cache_for_tests()  # a new process: only the durable snapshot remembers the release
+    rows = activity._legacy_remote_links()
+    assert by_id(rows)['t_done'] == ('unknown', False, True)
+    done = next(r for r in rows if r['id'] == 't_done')
+    assert 'owner_removed' not in done and done['unfinished'] is True and done['reported_status'] == 'done'
+    with sqlite3.connect(path) as db:  # removed once more: released once more
+        db.execute("DELETE FROM replica WHERE gw = 'gone'")
+    tick(path, clock, 1030.0)
+    assert by_id(activity._legacy_remote_links())['t_done'] == ('done', True, True)
+
+
+@pytest.mark.parametrize('cold', [False, True])
+def test_a_reprovisioned_owner_republishing_the_card_running_without_links_takes_it_back(world, cold):
+    path, clock = world
+    _removed_then_released(path, clock)
+    with sqlite3.connect(path) as db:  # the exact card, running again, its session links dropped
+        db.execute("INSERT INTO replica VALUES ('gone','tasks','work/build/t_done',2,61,?,1015000)",
+                   (json.dumps(card('t_done', gateway='gone', status='running', sessions=[])),))
+    tick(path, clock, 1020.0)
+    if cold:
+        activity._reset_cache_for_tests()
+    assert by_id(activity._legacy_remote_links())['t_done'] == ('unknown', False, True)
+
+
+def test_a_fresh_heartbeat_alone_takes_the_release_back(world):
+    path, clock = world
+    _removed_then_released(path, clock)
+    with sqlite3.connect(path) as db:
+        db.execute("INSERT INTO replica VALUES ('gone','gateway','info',1,62,?,0)",
+                   (json.dumps({'gateway': 'gone', 'task_scopes': [ok(1015.0)]}),))
+    tick(path, clock, 1020.0)
+    assert by_id(activity._legacy_remote_links())['t_done'] == ('unknown', False, True)
+
+
+def test_a_stale_read_keeps_an_earlier_release(world):
+    path, clock = world
+    _removed_then_released(path, clock)
+    clock['now'] = 1010.0 + 40 * 3600
+    assert by_id(activity._legacy_remote_links())['t_done'] == ('done', True, True)
+
+
+def test_released_rows_are_restored_by_the_pure_rule_when_the_owner_publishes():
+    released = _release_removed_owners([row('t_done', 'gone', 'done')], {('other', 'build', 't_x')}, FRESH)
+    assert released[0]['owner_removed'] is True
+    assert _release_removed_owners(released, {('other', 'build', 't_x')}, FRESH) == released, 'stable while it is gone'
+    back = _release_removed_owners(released, {('gone', 'build', 't_new')}, FRESH)
+    assert back == [row('t_done', 'gone', 'done')]
+    assert _release_removed_owners(released, (), {}) == released and _release_removed_owners(released, (), FRESH) == released
