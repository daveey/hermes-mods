From 6467cd432f43a326a96b8513e5367f0d55aa0f42 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 10:25:18 +0000
Subject: [PATCH] fix(update): align conflict owner fixtures and upgrade
 routing [daveey]

Public mirror of the source commit; see the accompanying feature documentation.

---
 scripts/ci/classify_changes.py                         | 3 +++
 tests/hermes_cli/test_update_upstream_conflict_card.py | 2 ++
 2 files changed, 5 insertions(+)

diff --git a/scripts/ci/classify_changes.py b/scripts/ci/classify_changes.py
index 7d3e0e22d98..00b2d8dfc69 100644
--- a/scripts/ci/classify_changes.py
+++ b/scripts/ci/classify_changes.py
@@ -466,6 +466,9 @@ _UPDATE_DEPENDENCIES = (
     "hermes_cli/local_runtime/processes.py",  # bounded probes' spawn_server/job custody
     "agent/deadline.py",  # bounded probes' process-tree timeout cleanup
     "hermes_cli/kanban_db.py",  # update_upstream_conflict files the conflict card
+    "hermes_cli/kanban_capability_registry.py",  # conflict owner requires installed gateway identity
+    "hermes_cli/kanban_hub_admission_placement.py",  # conflict ownership uses the canonical hub predicate
+    "hermes_cli/kanban_placement.py",  # conflict ownership honors configured hub aliases
     "hermes_cli/kanban_db_connect.py",
     "hermes_cli/kanban_db_sync.py",  # conflict reporting validates the inventory board
     "hermes_cli/kanban_sync_client.py",  # authoritative conflict-owner evidence
diff --git a/tests/hermes_cli/test_update_upstream_conflict_card.py b/tests/hermes_cli/test_update_upstream_conflict_card.py
index 17f4802e7a9..0bb459f19ce 100644
--- a/tests/hermes_cli/test_update_upstream_conflict_card.py
+++ b/tests/hermes_cli/test_update_upstream_conflict_card.py
@@ -13,6 +13,8 @@ def conflict_repo(tmp_path, monkeypatch):
 
 
 def test_conflict_files_one_card_and_refreshes_it(conflict_repo, tmp_path, monkeypatch):
+    from tests.hermes_cli.test_update_upstream_conflict import _gateway_identity
+    _gateway_identity(tmp_path, monkeypatch, "hub")
     monkeypatch.setenv("HERMES_KANBAN_DB", str(tmp_path / "board.db"))
     save_config({"platform_toolsets": {"cli": ["terminal", "file"]}, "terminal": {"backend": "local"}})
     up, _fork, live, gate = conflict_repo
-- 
