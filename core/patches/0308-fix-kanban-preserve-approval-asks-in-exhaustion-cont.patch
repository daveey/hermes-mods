From 095fc7222c6d6312ee8d99f2149809df9d8908a2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 25 Oct 2026 18:17:39 +0000
Subject: [PATCH] fix(kanban): preserve approval asks in exhaustion context
 [daveey]

---
 hermes_cli/kanban_continuation_recovery.py              | 2 +-
 tests/hermes_cli/test_kanban_continuation_exhaustion.py | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_continuation_recovery.py b/hermes_cli/kanban_continuation_recovery.py
index bc8c370cfd..09c79897f2 100644
--- a/hermes_cli/kanban_continuation_recovery.py
+++ b/hermes_cli/kanban_continuation_recovery.py
@@ -19,7 +19,7 @@ _CONTEXT = re.compile(
     r"(?:review the preserved implementation/checkpoint \S+ for this card; "
     r"the dispatcher refused continuation after its \d+-run limit"
     r"|latest unshipped commit\s*[a-z0-9]+ passes\s*\d+ [a-z ]*tests"
-    r"(?: and\s*\d+ [a-z ]*tests)?; [a-z ,/-]+ still remains?"
+    r"(?: and\s*\d+ [a-z ]*tests)?; live acceptance still remains?"
     r"|this is not delivered; keep the originating tracker unfinished)[.!]?", re.IGNORECASE,
 )
 
diff --git a/tests/hermes_cli/test_kanban_continuation_exhaustion.py b/tests/hermes_cli/test_kanban_continuation_exhaustion.py
index 0d54e52ab5..ee9527e1da 100644
--- a/tests/hermes_cli/test_kanban_continuation_exhaustion.py
+++ b/tests/hermes_cli/test_kanban_continuation_exhaustion.py
@@ -53,6 +53,8 @@ def test_budget_only_human_block_routes_to_agent_triage(board, kind, reason):
 @pytest.mark.parametrize("kind,reason,human", [
     ("needs_input", "Which production region should we deploy to?", True),
     ("needs_input", "Reset the continuation budget. Which production region should we deploy to?", True),
+    ("needs_input", "Reset the continuation budget. Latest unshipped commit abc123 passes 20 tests; "
+     "please approve production deployment, which still remains.", True),
     ("capability", "Restore the deployment credentials, then unblock this card.", True),
     ("time", "Waiting for the release window.", False),
 ])
-- 
2.55.0

