diff --git a/tests/hermes_cli/test_kanban_tracking_contention.py b/tests/hermes_cli/test_kanban_tracking_contention.py
new file mode 100644
index 0000000000..f4b482d526
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_tracking_contention.py
@@ -0,0 +1,107 @@
+"""Unrelated offline I/O must not pin a board's reader cleanup lock."""
+from concurrent.futures import ThreadPoolExecutor
+import sqlite3
+import threading
+
+import pytest
+
+from hermes_cli import kanban_dispatch_owner as owner
+from hermes_cli import kanban_generation as generation
+from hermes_cli import kanban_lockguard as guard
+from hermes_cli import sqlite_safe_read as tracking
+
+
+@pytest.mark.parametrize("operation", ["close", "failed_open", "recovery"])
+def test_tracking_wait_releases_board_for_idle_reader(tmp_path, monkeypatch, operation):
+    path = tmp_path / "board.db"
+    seed = sqlite3.connect(path)
+    seed.execute("PRAGMA journal_mode=WAL")
+    seed.close()
+    reader = guard.connect(path, check_same_thread=False)
+    ready, proceed, attempted = (threading.Event() for _ in range(3))
+    real_lock = tracking._live_lock
+    worker_ident = []
+
+    class ObservedTrackingLock:
+        def acquire(self, *args, **kwargs):
+            if worker_ident and threading.get_ident() == worker_ident[0] and proceed.is_set():
+                attempted.set()
+            return real_lock.acquire(*args, **kwargs)
+
+        def release(self):
+            real_lock.release()
+
+        def __enter__(self):
+            self.acquire()
+            return self
+
+        def __exit__(self, *_):
+            self.release()
+
+    monkeypatch.setattr(tracking, "_live_lock", ObservedTrackingLock())
+    original_prepare = generation.prepare_connection
+
+    def prepare(conn, timeout):
+        original_prepare(conn, timeout)
+        if operation == "failed_open":
+            ready.set()
+            assert proceed.wait(5)
+            raise ValueError("injected preparation failure")
+
+    monkeypatch.setattr(generation, "prepare_connection", prepare)
+
+    def work():
+        worker_ident.append(threading.get_ident())
+        if operation == "failed_open":
+            with pytest.raises(ValueError, match="injected"):
+                owner.connect_with_identity(path, timeout=0.1)
+            return
+        conn = owner.connect_with_identity(path, timeout=0.1)
+        ready.set()
+        assert proceed.wait(5)
+        try:
+            if operation == "close":
+                conn.close()
+            else:
+                conn._hermes_generation_shm = (-1, -1)
+                try:
+                    replacement = guard.connect(path, timeout=0.1)
+                except sqlite3.OperationalError as exc:
+                    assert generation.is_busy(exc)
+                else:
+                    replacement.close()
+        finally:
+            conn.close()
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        pending = pool.submit(work)
+        assert ready.wait(5)
+        with tracking.offline_file_access(tmp_path / "unrelated.db"):
+            proceed.set()
+            assert attempted.wait(5)
+            closing = pool.submit(reader.close)
+            # Record before releasing offline I/O; always release it before assertions/cleanup.
+            try:
+                closing.result(timeout=0.5)
+                closed = True
+            except TimeoutError:
+                closed = False
+        pending.result(timeout=5)
+        closing.result(timeout=5)
+    assert closed, f"{operation} propagated global tracking wait to idle reader close"
+    assert not tracking.has_live_connection(path)
+
+
+def test_lifecycle_busy_does_not_retry_readwrite(tmp_path, monkeypatch):
+    calls = []
+
+    def busy(database, **kwargs):
+        calls.append(database)
+        raise generation.BoardLifecycleBusy()
+
+    monkeypatch.setattr(guard, "connect", busy)
+    with pytest.raises(generation.BoardLifecycleBusy) as raised:
+        generation.open_ro(tmp_path / "board.db")
+    assert raised.value.sqlite_errorcode == sqlite3.SQLITE_BUSY
+    assert len(calls) == 1
+    assert calls[0].endswith("?mode=ro")
diff --git a/tests/hermes_cli/test_sqlite_offline_reservations.py b/tests/hermes_cli/test_sqlite_offline_reservations.py
new file mode 100644
index 0000000000..784ecabecc
--- /dev/null
+++ b/tests/hermes_cli/test_sqlite_offline_reservations.py
@@ -0,0 +1,101 @@
+"""Raw-I/O reservations exclude same-file opens without pinning unrelated closes."""
+from concurrent.futures import ThreadPoolExecutor
+import sqlite3
+import threading
+
+import pytest
+
+from hermes_cli import sqlite_safe_read as tracking
+
+
+@pytest.mark.parametrize("suffix", ["", "-wal", "-shm"])
+@pytest.mark.parametrize("alias", ["plain", "uri", "symlink"])
+def test_reserved_file_refuses_open_before_allocation(tmp_path, suffix, alias):
+    path = tmp_path / "space board.db"
+    sqlite3.connect(path).close()
+    target = path
+    options = {}
+    if alias == "uri":
+        target = path.as_uri() + "?mode=ro"
+        options["uri"] = True
+    elif alias == "symlink":
+        target = tmp_path / "alias.db"
+        target.symlink_to(path)
+    with tracking.offline_file_access(str(path) + suffix):
+        with pytest.raises(sqlite3.OperationalError) as caught:
+            tracking.connect_tracked(target, wait_for_tracking=False, **options)
+        assert caught.value.sqlite_errorcode == sqlite3.SQLITE_BUSY
+        other = tracking.connect_tracked(tmp_path / "other.db", wait_for_tracking=False)
+        other.close()
+    conn = tracking.connect_tracked(target, **options)
+    conn.close()
+    assert not tracking.has_live_connection(path)
+
+
+def test_same_thread_wait_refuses_and_nested_raw_cleanup(tmp_path):
+    path = tmp_path / "board.db"
+    with pytest.raises(ValueError, match="body"):
+        with tracking.offline_file_access(path):
+            with tracking.offline_file_access(str(path) + "-wal"):
+                with pytest.raises(sqlite3.OperationalError):
+                    tracking.connect_tracked(path)
+            raise ValueError("body")
+    conn = tracking.connect_tracked(path)
+    with pytest.raises(tracking.LiveConnectionError):
+        with tracking.offline_file_access(path):
+            pytest.fail("live handle allowed raw access")
+    conn.close()
+    with tracking.offline_file_access(path):
+        pass
+
+
+def test_waiting_open_and_header_refusal(tmp_path, monkeypatch):
+    from hermes_cli import sqlite_offline_reservations as offline
+
+    path = tmp_path / "board.db"
+    seed = sqlite3.connect(path)
+    seed.execute("CREATE TABLE example (value)")
+    seed.close()
+    attempted = threading.Event()
+    original = offline.conflicts
+
+    def observe(*args, **kwargs):
+        pending = original(*args, **kwargs)
+        if pending and not kwargs.get("raw"):
+            attempted.set()
+        return pending
+
+    monkeypatch.setattr(offline, "conflicts", observe)
+
+    def open_close():
+        conn = tracking.connect_tracked(path)
+        conn.close()
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        with tracking.offline_file_access(path):
+            pending = pool.submit(open_close)
+            assert attempted.wait(5)
+            assert not pending.done()
+            assert pool.submit(tracking.read_header_bytes_preopen, path).result(5) is None
+        pending.result(5)
+    header = tracking.read_header_bytes_preopen(path)
+    assert header is not None and header.startswith(b"SQLite")
+
+
+def test_completion_does_not_need_registry_lock(tmp_path):
+    path = tmp_path / "board.db"
+    reserved, finish = threading.Event(), threading.Event()
+
+    def raw():
+        with tracking.offline_file_access(path):
+            reserved.set()
+            assert finish.wait(5)
+
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        pending = pool.submit(raw)
+        assert reserved.wait(5)
+        with tracking._live_lock:
+            finish.set()
+            pending.result(5)
+            conn = tracking.connect_tracked(path)
+            conn.close()
diff --git a/tests/hermes_cli/test_sqlite_reservation_adversarial.py b/tests/hermes_cli/test_sqlite_reservation_adversarial.py
