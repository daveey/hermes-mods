From 87b826e2984cec5dff8dc0162ab69582dbc39edb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:02:10 +0000
Subject: [PATCH] fix(quiet): executed-code index cap fits the grown gateway
 graph (MAX_LOADED_CODE 2^18, 2x headroom asserted)

main's growth pushed gateway.run+tui_gateway+run_agent to ~65.5k code objects, at the old
65536 cap, so loaded-code-limit latched and every quiet start would fail closed.
---
 hermes_cli/code_attestation.py                 | 3 ++-
 tests/hermes_cli/test_code_attestation_deps.py | 7 ++++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/code_attestation.py b/hermes_cli/code_attestation.py
index 4ad838c316..e691537a5b 100644
--- a/hermes_cli/code_attestation.py
+++ b/hermes_cli/code_attestation.py
@@ -54,6 +54,7 @@ _ROUTE_SENTINEL_ROOT = "/@attest-root-sentinel@"
 MAX_SOURCE = 2 * 1024 * 1024
 MAX_TREE = 64 * 1024 * 1024
 MAX_UNITS = 16384
+MAX_LOADED_CODE = 1 << 18  # code objects kept for executed-code lookups; the gateway graph uses ~70k
 MAX_CACHE_ENTRIES = 32
 MAX_CACHE_BYTES = 8 * 1024 * 1024
 _FROZEN_ALIASES: dict[str, str] = {"importlib._bootstrap": "_frozen_importlib",
@@ -562,7 +563,7 @@ class Attestation:
 
     def _remember(self, code, component):
         for nested in _codes(code):
-            if len(self._known) >= 65536:
+            if len(self._known) >= MAX_LOADED_CODE:
                 self.mark_unknown("loaded-code-limit")
                 return
             self._known[id(nested)] = (nested, component)
diff --git a/tests/hermes_cli/test_code_attestation_deps.py b/tests/hermes_cli/test_code_attestation_deps.py
index 369613d465..c04940a6c8 100644
--- a/tests/hermes_cli/test_code_attestation_deps.py
+++ b/tests/hermes_cli/test_code_attestation_deps.py
@@ -231,7 +231,8 @@ def test_gateway_runtime_import_graph_has_no_residual_unknowns(tmp_path):
                           "generated": [(u["generator"], u["component"]) for u in a.dependency_receipts()["units"]
                                         if u["kind"] == "generated"],
                           "threads": sorted(t.name for t in threading.enumerate()),
-                          "dists": len(a.dependency_receipts()["dists"])}))
+                          "dists": len(a.dependency_receipts()["dists"]),
+                          "known": len(a._known)}))
     '''))
     result = subprocess.run([sys._base_executable, "-I", str(script), str(ROOT), str(selected),
                              *GATEWAY_GRAPH], cwd=tmp_path, capture_output=True, text=True,
@@ -242,6 +243,10 @@ def test_gateway_runtime_import_graph_has_no_residual_unknowns(tmp_path):
     report = json.loads((tmp_path / "graph.json").read_text(encoding="utf-8"))
     assert report["failed"] == {}, report["failed"]
     assert report["dists"] > 10
+    # The executed-code index must hold the whole runtime graph with room for plugins and
+    # providers loaded later; hitting the cap latches loaded-code-limit and fails every start.
+    from hermes_cli.code_attestation import MAX_LOADED_CODE
+    assert report["known"] * 2 < MAX_LOADED_CODE, (report["known"], MAX_LOADED_CODE)
     assert report["new"] == [], (report["new"], report["producers"])
     # R5: the real producers were receipted with a dependency origin, not latched unknown.
     generators = {g for g, _ in report["generated"]}
-- 
