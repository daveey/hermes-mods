diff --git a/agent/model_metadata_http.py b/agent/model_metadata_http.py
index 39e4fa23a46..045b101b87f 100644
--- a/agent/model_metadata_http.py
+++ b/agent/model_metadata_http.py
@@ -25,6 +25,13 @@ def resolve_verify(base_url: str = ""):
     )
 
 
+def create_client(**kwargs):
+    """Build metadata/probe clients through one transport-injection boundary."""
+    import httpx
+
+    return httpx.Client(**kwargs)
+
+
 @contextmanager
 def stream(url: str, *, headers=None, params=None, timeout=10.0, verify=None):
     import httpx
@@ -43,7 +50,7 @@ def stream(url: str, *, headers=None, params=None, timeout=10.0, verify=None):
     if isinstance(timeout, tuple):
         connect, read = timeout
         timeout = httpx.Timeout(read, connect=connect)
-    with httpx.Client(
+    with create_client(
         verify=resolve_verify() if verify is None else verify,
         timeout=timeout,
         follow_redirects=True,
diff --git a/tests/_fixtures/offline_catalogs.py b/tests/_fixtures/offline_catalogs.py
index 8c595389786..a75e6232f4f 100644
--- a/tests/_fixtures/offline_catalogs.py
+++ b/tests/_fixtures/offline_catalogs.py
@@ -35,3 +35,33 @@ def _offline_video_catalog(request, monkeypatch):
         return real_get(url, *args, **kwargs)
 
     monkeypatch.setattr(requests, "get", get)
+
+
+@pytest.fixture(autouse=True)
+def _offline_metadata_transport(request, monkeypatch):
+    """Only incidental metadata clients get an offline remote transport default.
+
+    Explicit client/transport fakes installed by tests win. The production
+    request construction, response handling, caches and fallbacks still run.
+    """
+    if request.node.get_closest_marker("live"):
+        return
+    import httpx
+    from agent import model_metadata_http
+
+    real_client = httpx.Client
+    create_client = model_metadata_http.create_client
+
+    class OfflineTransport(httpx.HTTPTransport):
+        def handle_request(self, request):
+            if not _is_loopback(request.url.host):
+                raise httpx.ConnectError("offline metadata fixture: provide a test transport", request=request)
+            return super().handle_request(request)
+
+    def client(**kwargs):
+        if httpx.Client is real_client and "transport" not in kwargs:
+            kwargs["transport"] = OfflineTransport(verify=kwargs.get("verify", True))
+        return create_client(**kwargs)
+
+    monkeypatch.setattr(model_metadata_http, "create_client", client)
+
