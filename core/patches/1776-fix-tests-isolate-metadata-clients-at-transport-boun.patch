@@ -1411,9 +1410,8 @@ def _model_id_matches(candidate_id: str, lookup_model: str) -> bool:
 
 def _ollama_show(server_url: str, api_key: str, bare_model: str, timeout: float = 3.0, *, note_blackhole: bool = False) -> Optional[dict[str, Any]]:
