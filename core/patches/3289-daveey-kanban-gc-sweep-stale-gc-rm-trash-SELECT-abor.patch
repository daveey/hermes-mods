+        (tmp_path / "real").mkdir()
+        target = str(tmp_path / "real" / ".." / "real")
+        assert env_loader._home_key(target) == str(Path(target).resolve())
+        assert env_loader._home_key("~nobody-such-user/x") == str(Path("~nobody-such-user/x").resolve())
