From 1ab265d8096219d8550562d9681d41b4c2b4feb2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 10:42:35 +0000
Subject: [PATCH] [daveey] test(selfheal): keep auto maintenance from
 collapsing the pack-sprawl fixture

test_repacks_at_threshold failed on CI with made=2 of 12: each fixture commit runs
`git maintenance run --auto`, which on git 2.55 (or with a runner gitconfig) repacks the
packs made so far, often detached, so the count raced. Disable auto maintenance/gc on the
fixture's commits. RED: a GIT_CONFIG_GLOBAL with gc.autoPackLimit=3 gave 4 packs of 12;
GREEN: 12.
---
 tests/hermes_cli/test_worktree_selfheal.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_worktree_selfheal.py b/tests/hermes_cli/test_worktree_selfheal.py
index 98f467b428..9efd64cee3 100644
--- a/tests/hermes_cli/test_worktree_selfheal.py
+++ b/tests/hermes_cli/test_worktree_selfheal.py
@@ -100,7 +100,10 @@ class TestMaintainPackHealth:
         for i in range(n):
             (repo / f"p{i}.txt").write_text(f"{i}\n")
             _git(repo, "add", "-A")
-            _git(repo, "commit", "-qm", f"c{i}")
+            # Every commit runs `git maintenance run --auto` (gc --auto before git 2.29). Newer git
+            # (2.55 on CI) or a runner's gitconfig can make it repack the packs made so far, often
+            # detached, so it raced the count: CI once saw made=2 of 12. Keep the fixture's packs.
+            _git(repo, "-c", "maintenance.auto=false", "-c", "gc.auto=0", "commit", "-qm", f"c{i}")
             sha = _git(repo, "rev-parse", "HEAD^{commit}").stdout.strip()
             # One pack per commit object: pipe the sha into pack-objects.
             subprocess.run(
-- 
