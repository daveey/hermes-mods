From f751f42dec6b8cd27830009154d31cc6e26ccff9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 14:14:48 +0000
Subject: [PATCH] fix(ci): [daveey] footgun text=True rule reads encoding= on
 the call's continuation lines

The subprocess text=True rule was line-based, so a multi-line call passing
encoding= on the next line was a false positive and needed a
'# windows-footgun: ok' marker (three sites so far, one blocking a pre-push
on 2026-11-14). Add Footgun.call_continuation_exempt: the scanner walks the
rest of the open call (paren-balanced, strings/comments ignored) and drops
the hit when encoding= is there. Multi-line calls without encoding= stay
flagged. Remove the two now-stale markers; a guard test fails if one returns.

Self-heal other-4df1303e86 (t_4cda207002aa8237).
---
 hermes_cli/worktree_archive.py                |  2 +-
 scripts/check-windows-footguns.py             | 76 ++++++++++++++-
 scripts/releases/commit_build.py              |  2 +-
 ...t_footgun_multiline_subprocess_encoding.py | 93 +++++++++++++++++++
 4 files changed, 170 insertions(+), 3 deletions(-)
 create mode 100644 tests/scripts/test_footgun_multiline_subprocess_encoding.py

diff --git a/hermes_cli/worktree_archive.py b/hermes_cli/worktree_archive.py
index dedc38e9794a8a5b41408454bf1d1557ffe4f01f..24cd2c90ff0520023af28cc192b6da536364199e 100644
--- a/hermes_cli/worktree_archive.py
+++ b/hermes_cli/worktree_archive.py
@@ -78,7 +78,7 @@ def _env(cwd, index: Optional[str] = None, *, budget=None) -> dict:
 
 
 def _run(args, cwd, env, timeout: float = 300, stdin_text: Optional[str] = None):
-    return subprocess.run(["git", *args], cwd=str(cwd), env=env, capture_output=True, text=True,  # windows-footgun: ok -- encoding passed on the next line
+    return subprocess.run(["git", *args], cwd=str(cwd), env=env, capture_output=True, text=True,
                           encoding="utf-8", errors="surrogateescape", timeout=timeout,
                           input=stdin_text, stdin=None if stdin_text is not None else subprocess.DEVNULL,
                           check=False)
diff --git a/scripts/check-windows-footguns.py b/scripts/check-windows-footguns.py
index 78526b546f6f3e856ed4c3b5afedc1167457a1de..fb4ba2a030bfa66f55046520e9a5fb80f0cc17ad 100644
--- a/scripts/check-windows-footguns.py
+++ b/scripts/check-windows-footguns.py
@@ -138,6 +138,13 @@ class Footgun:
     # the regex can't fully distinguish (e.g. open() where mode may contain
     # "b" for binary, or the line may have `encoding=` elsewhere).
     post_filter: Callable[..., Any] | None = None
+    # Optional "the rest of this call excuses it" pattern. When the call
+    # that contains the match is still open at the end of the matched line,
+    # the scanner reads its continuation lines (paren-balanced, comments and
+    # string contents ignored) and drops the hit if this pattern matches
+    # there. Lets a line-based rule see ``encoding=`` passed on a later line
+    # of the same multi-line call instead of forcing a suppression marker.
+    call_continuation_exempt: re.Pattern | None = None
 
 
 # A real open() mode. The regex stops at the first comma, so
@@ -445,6 +452,9 @@ FOOTGUNS: list[Footgun] = [
             # rule focused on the actual footgun.
             and _is_likely_subprocess_call(line)
         ),
+        # encoding= on a continuation line of the same call is not a
+        # footgun (it used to need a `# windows-footgun: ok` marker).
+        call_continuation_exempt=re.compile(r"\bencoding\s*="),
     ),
     Footgun(
         name="bare Path.read_text()/write_text() without encoding=",
@@ -686,6 +696,65 @@ def _call_closes_on_line(line: str, open_paren_end: int) -> bool:
     return False
 
 
+def _paren_walk(segment: str, depth: int) -> tuple[str, int]:
+    """Walk ``segment`` from paren ``depth``, skipping string contents.
+
+    Returns (code text consumed, depth after). Stops right after the paren
+    that brings depth to 0. String bodies are dropped from the returned text
+    so ``"encoding="`` inside a literal never excuses a hit.
+    """
+    out: list[str] = []
+    quote: str | None = None
+    i, n = 0, len(segment)
+    while i < n:
+        c = segment[i]
+        if quote:
+            if c == "\\" and i + 1 < n:
+                i += 2
+                continue
+            if c == quote:
+                quote = None
+            i += 1
+            continue
+        if c in ("'", '"'):
+            quote = c
+        elif c == "(":
+            depth += 1
+        elif c == ")":
+            depth -= 1
+            if depth <= 0:
+                return "".join(out), 0
+        out.append(c)
+        i += 1
+    return "".join(out), depth
+
+
+_CALL_CONTINUATION_MAX_LINES = 40
+
+
+def _call_continuation(lines: list[str], index: int, code: str, match_end: int) -> str:
+    """Code text of the continuation lines of the call open at ``match_end``.
+
+    ``index`` is the 0-based position of the matched line in ``lines`` and
+    ``code`` that line's comment-stripped code. Returns "" when the call
+    closes on the matched line (nothing continues), so a hit is excused only
+    by text that really belongs to the same multi-line call.
+    """
+    _, depth = _paren_walk(code[:match_end], 0)
+    if depth <= 0:
+        return ""
+    _, depth = _paren_walk(code[match_end:], depth)
+    if depth <= 0:
+        return ""
+    collected: list[str] = []
+    for nxt in lines[index + 1 : index + 1 + _CALL_CONTINUATION_MAX_LINES]:
+        text, depth = _paren_walk(_strip_code(nxt), depth)
+        collected.append(text)
+        if depth <= 0:
+            break
+    return "\n".join(collected)
+
+
 def _looks_like_string_literal(line: str, match: re.Match) -> bool:
     """Heuristic: is the ``text=True`` match inside a string literal?
 
@@ -801,7 +870,8 @@ def scan_file(path: Path, footguns: list[Footgun]) -> list[tuple[int, str, Footg
     # triple-quote we see; we don't try to handle nested or f-string cases.
     in_triple: str | None = None  # None, "'''", or '"""'
 
-    for i, line in enumerate(text.splitlines(), start=1):
+    all_lines = text.splitlines()
+    for i, line in enumerate(all_lines, start=1):
         # Update triple-quote state based on this line's occurrences.
         code_for_scan = line
         if in_triple:
@@ -860,6 +930,10 @@ def scan_file(path: Path, footguns: list[Footgun]) -> list[tuple[int, str, Footg
                 except (IndexError, AttributeError):
                     # Post-filter assumed a named group that isn't there — skip.
                     continue
+            if fg.call_continuation_exempt is not None and fg.call_continuation_exempt.search(
+                _call_continuation(all_lines, i - 1, code, match.end())
+            ):
+                continue
             matches.append((i, line.rstrip(), fg))
     return matches
 
