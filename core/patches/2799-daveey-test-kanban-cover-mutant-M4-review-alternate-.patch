From a05ea1006221fe43bfa53a5399b4ac7eb3847a8b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 15:14:07 +0000
Subject: [PATCH] [daveey] test(kanban): cover mutant M4 (review alternate
 walled only in the live pool); a short own wall never hides a longer known
 wall

Review t_01a1d039a4ae58ad of PR #1514 found that deleting the alternate's
`live_quota_wall` check in `_review_off_wall` (mutant M4) failed no test.
New test: a review_unpinned card whose base provider (openai-codex) is
walled in provider_walls.json; the first independent alternate (grok-5)
is walled only by the live pool. With a later free reviewer
(grok-5-mini) the route moves there; with none it keeps its base route.
Both cases are RED with M4 applied and GREEN on main.

Same review's nit: `pinned_route` (and `record`) read `known_wall` only
when the card had no own wall on the pin's provider, so a 2 h own wall
hid a 55 h provider-file wall: the pin waited out 2 h, then spawned into
the long wall. `_with_known_wall` now folds the known wall in with the
later reset winning and the card's own episode id kept (one comment per
episode still holds). Test: own 2 h + file 55 h reroutes with resets_at
= 55 h (RED before), control own 55 h + file 2 h keeps 55 h.

Tests: the 17 test files importing kanban_pin_reroute / kanban_model_tier
/ kanban_dispatch_skip, 449 passed. scripts/check ok.
---
 hermes_cli/kanban_pin_reroute.py            | 23 +++++++---
 tests/hermes_cli/test_kanban_pin_reroute.py | 48 +++++++++++++++++++++
 2 files changed, 64 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban_pin_reroute.py b/hermes_cli/kanban_pin_reroute.py
index 364322369c..59dd9226de 100644
--- a/hermes_cli/kanban_pin_reroute.py
+++ b/hermes_cli/kanban_pin_reroute.py
@@ -11,7 +11,8 @@ Rule (:func:`pinned_route`); every condition must hold, anything else keeps the
    earlier ``model_reroute``, or the live episode), and that wall is still up; or the pin's provider is
    walled right now in ``provider_walls.json`` or the live pool is quota-walled for the pinned model
    (:func:`known_wall`), fresh card or not: its next run would only exit 75 into that wall to learn it
-   (kanban-dd62aef001; t_c21c170e, 11-12: a card woken from ``scheduled`` paid one wall run);
+   (kanban-dd62aef001; t_c21c170e, 11-12: a card woken from ``scheduled`` paid one wall run). When both
+   are up, the later reset counts: a short own wall never hides a longer known one;
 2. it resets ``kanban.pin_quota_reroute_min_hours`` (default 6) or more from now;
 3. the pin is not mandatory: neither ``tasks.model_pin_mandatory`` nor a ``require_model: true`` body line;
 4. the lane is ready, not review;
@@ -135,6 +136,17 @@ def known_wall(pinned: tuple[str, str], now: Optional[float] = None) -> Optional
     return {provider: float(max(resets))} if resets else None
 
 
+def _with_known_wall(own: dict[str, tuple[float, Any]], pinned: tuple[str, str],
+                     now: float) -> dict[str, tuple[float, Any]]:
+    """*own* with the pin's :func:`known_wall` folded in: the later reset wins, and the card's own episode id is
+    kept. A short own wall (a 2 h burst) never hides a longer wall the provider file or live pool knows."""
+    for name, until in (known_wall(pinned, now) or {}).items():
+        mine = own.get(name)
+        if mine is None or until > mine[0]:
+            own[name] = (until, mine[1] if mine else None)
+    return own
+
+
 def pinned_route(conn: Any, task: Any, *, lane: str, now: float, cfg: Optional[dict],
                  current: Optional[dict[str, float]] = None) -> Optional[tuple[str, str]]:
     """Same-class ``(model, provider)`` this pinned card's run may use instead of its walled pin, or None.
@@ -152,9 +164,7 @@ def pinned_route(conn: Any, task: Any, *, lane: str, now: float, cfg: Optional[d
     if lane == "review" or pinned is None or is_mandatory_pin(task):
         return None
     model, provider = pinned
-    own = own_walls(conn, task.id, now, current)
-    if provider not in own:
-        own.update({name: (until, None) for name, until in (known_wall(pinned, now) or {}).items()})
+    own = _with_known_wall(own_walls(conn, task.id, now, current), pinned, now)
     if provider not in own or own[provider][0] - now < min_wall_seconds(cfg):
         return None
     config = _assignee_config(getattr(task, "assignee", None)) or {}
@@ -196,9 +206,8 @@ def record(conn: Any, task: Any, origin: tuple[str, str], target: tuple[str, str
     for wall in (_outstanding(conn, task.id, state, now) if state else []):
         if origin[1] in _providers(wall):
             current[origin[1]] = max(current.get(origin[1], 0), wall["until"])
-    own = own_walls(conn, task.id, now, current)
-    if origin[1] not in own:  # moved by a wall the provider file / live pool knows (pinned_route rule 1)
-        own.update({name: (until, None) for name, until in (known_wall(origin, now) or {}).items()})
+    # The same walls pinned_route read: the card's own plus any the provider file / live pool knows (rule 1).
+    own = _with_known_wall(own_walls(conn, task.id, now, current), origin, now)
     resets_at, episode_id = own.get(origin[1], (None, None))
     payload = {"from_model": origin[0], "from_provider": origin[1], "to_model": target[0],
                "to_provider": target[1], "walled_provider": origin[1], "resets_at": resets_at,
diff --git a/tests/hermes_cli/test_kanban_pin_reroute.py b/tests/hermes_cli/test_kanban_pin_reroute.py
index a78708a91f..35e03b9aeb 100644
--- a/tests/hermes_cli/test_kanban_pin_reroute.py
+++ b/tests/hermes_cli/test_kanban_pin_reroute.py
@@ -416,6 +416,28 @@ def test_non_fresh_pin_on_a_known_wall_controls_never_move(board, monkeypatch, a
         assert _events(conn, tid, 'model_reroute') == [] and _comments(conn, tid) == []
 
 
+@pytest.mark.parametrize('own_hours, file_hours', [(2, 55), (55, 2)])
+def test_a_short_own_wall_never_hides_a_longer_known_wall(
+        board, monkeypatch, all_assignees_spawnable, own_hours, file_hours):
+    """Review nit on PR #1514: rule 1 read the provider file only when the card had no wall of its own on the
+    pin's provider, so a 2 h own wall hid a 55 h provider-file wall and the pin waited out the 2 h only to
+    spawn into the long wall. The later of the two now decides (and is the recorded reset); the card's own
+    episode id is kept so the one-comment-per-episode rule still holds."""
+    clock = _clock(monkeypatch)
+    _, cfg = _deep(monkeypatch)
+    with kbc.connect() as conn:
+        start = clock[0]
+        tid = _walled_card(conn, cfg, clock, hours=own_hours)
+        file_until = float(start + file_hours * 3600)
+        monkeypatch.setattr(walls, 'active_walls', lambda **_k: {'openai-codex': file_until})
+        assert _tick(conn) == [PEER]
+        [event] = _events(conn, tid, 'model_reroute')
+        assert event['resets_at'] == float(start + max(own_hours, file_hours) * 3600)
+        live = episode(conn, tid)
+        assert live and live['episode_id'] and event['episode_id'] == live['episode_id']
+        assert len(_comments(conn, tid)) == 1
+
+
 # --- the review lane on a known wall (hub run 174730, 2026-11-12) ---------------------------------------
 
 GROK = ('grok-5', 'xai-oauth')
@@ -474,6 +496,32 @@ def test_review_unpinned_keeps_its_route_without_a_free_alternative(board, monke
         assert tier.resolve_dispatch_tier(conn, kb.get_task(conn, tid), lane='review') == (*PIN, 'review_unpinned')
 
 
+GROK_MINI = ('grok-5-mini', 'xai-oauth')
+
+
+@pytest.mark.parametrize('case', ['later_free', 'none_free'])
+def test_review_unpinned_skips_an_alternative_walled_only_in_the_live_pool(board, monkeypatch, case):
+    """Mutant M4 (t_01a1d04d206e2c6e): ``_review_off_wall`` must check the live pool on each alternate, not
+    only provider_walls.json. The first alternate (grok-5) is walled only by the live pool, which walls per
+    model: the review moves to a later free reviewer (grok-5-mini, same provider, no wall) or, with none,
+    keeps its route; never into grok-5's wall."""
+    clock = _clock(monkeypatch)
+    config, _ = _deep(monkeypatch)
+    deep = config['model_routing']['routes']['deep']
+    deep.append(dict(deep[0], model=GROK[0], provider=GROK[1]))
+    if case == 'later_free':
+        deep.append(dict(deep[0], model=GROK_MINI[0], provider=GROK_MINI[1]))
+    until = float(clock[0] + 55 * 3600)
+    monkeypatch.setattr(walls, 'active_walls', lambda **_k: {'openai-codex': until})  # the base, file only
+    monkeypatch.setattr(walls, 'live_quota_wall', lambda p, m: until if (m, p) == GROK else None)
+    with kbc.connect() as conn:
+        tid = _review_card(conn)
+        route = tier.resolve_dispatch_tier(conn, kb.get_task(conn, tid), lane='review')
+        assert route[:2] != GROK
+        assert route == ((*GROK_MINI, 'review_unpinned+wall:openai-codex') if case == 'later_free'
+                         else (*PIN, 'review_unpinned'))
+
+
 # --- the mandatory mark: create, set-model, tool, sync ---------------------------------------------
 
 def test_create_flag_requires_a_pin_and_persists(board):
