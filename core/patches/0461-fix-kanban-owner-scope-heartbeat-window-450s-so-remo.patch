From 4695da764babc87851c6b440b02edad67c3b3907 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 26 Oct 2026 23:15:54 -0700
Subject: [PATCH] fix(kanban): owner scope heartbeat window 450s so remote
 release stops flapping at the 180s collector period [daveey]

---
 hermes_cli/kanban_origin_ledger.py                      | 2 +-
 hermes_cli/kanban_session_activity.py                   | 7 +++++--
 tests/hermes_cli/test_kanban_origin_scope_heartbeat.py  | 2 +-
 tests/hermes_cli/test_kanban_remote_terminal_release.py | 6 ++++++
 4 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_origin_ledger.py b/hermes_cli/kanban_origin_ledger.py
index 989f95633d..ab7fc89c88 100644
--- a/hermes_cli/kanban_origin_ledger.py
+++ b/hermes_cli/kanban_origin_ledger.py
@@ -329,7 +329,7 @@ def project(path: Path, *, replica: Path | None, gateway: str, profile: str,
                     # Owner liveness: the collector's per-scope heartbeat (one record per sync) proves it read
                     # this whole board recently, so an unchanged, current task record is still observed. The
                     # per-task stamp is accepted too, for records published before scope heartbeats existed.
-                    live = (_recent(heartbeat, now)
+                    live = (_recent(heartbeat, now, 450)
                             or _recent(_owner_evidence(task).get('observed_at'), now))
                     current = current and readable and live
                 if (owner['gateway'], owner['profile']) == (gateway, profile):
diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index 888c7404c2..ca06da8a84 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -249,6 +249,9 @@ def _replica_bucket(task: dict[str, Any]) -> str | None:
 # by gateway/profile/board/id: equal task IDs in different owner profiles are separate cards.
 # Historical board/id records retain unknown ownership rather than default-profile inference.
 HUB_STALE_AFTER_S = 180.0  # same as the hub-sync plugin: no successful hub sync for this long = stale
+# The owner collector publishes each scope heartbeat about every 180s (sawtooth 0..~200s as replicated), so a
+# 180s window flapped: a closed card was released half the time. Allow ~2.5 collector periods. [daveey]
+SCOPE_HEARTBEAT_FRESH_S = 450.0
 _REMOTE_FIELDS = ("title", "status", "block_kind", "human_request", "assignee", "created_at", "started_at", "priority")
 _remote_last: list[dict[str, Any]] | None = None  # last good read (process lifetime)
 _remote_scope: tuple[str, ...] | None = None
@@ -293,7 +296,7 @@ def _owner_attests_terminal(task: dict[str, Any], gw: str, owner_profile: str |
     Release needs all of: a fresh hub sync; a profile-qualified record whose own identity fields match its
     key; a terminal status inside the owner collector's hash-bound observation (``origin_observation``, so a
     replica row edited or truncated in transit proves nothing); and that collector's per-scope heartbeat for
-    this exact (profile, board) within ``HUB_STALE_AFTER_S``, so an offline owner's last word is not taken
+    this exact (profile, board) within ``SCOPE_HEARTBEAT_FRESH_S``, so an offline owner's last word is not taken
     as current. Absence of a row is never release. This is the same rule a local board applies to its own
     cards (``done``/``archived`` are not counted), applied only to evidence the owner signed. Pre-ledger
     cards had no other release path, so every one of them stayed open forever. [daveey]
@@ -312,7 +315,7 @@ def _owner_attests_terminal(task: dict[str, Any], gw: str, owner_profile: str |
     if task.get('origin_bindings') and evidence.get('verified') is not True:
         return False
     beat = heartbeats.get((gw, owner_profile, board))
-    return beat is not None and 0 <= now - beat <= HUB_STALE_AFTER_S
+    return beat is not None and 0 <= now - beat <= SCOPE_HEARTBEAT_FRESH_S
 
 
 def _fold_legacy_aliases(tasks: dict[tuple, dict[str, Any]], raw: dict[tuple, dict[str, Any]]) -> None:
diff --git a/tests/hermes_cli/test_kanban_origin_scope_heartbeat.py b/tests/hermes_cli/test_kanban_origin_scope_heartbeat.py
index bacf265b74..4a3973c705 100644
--- a/tests/hermes_cli/test_kanban_origin_scope_heartbeat.py
+++ b/tests/hermes_cli/test_kanban_origin_scope_heartbeat.py
@@ -48,7 +48,7 @@ def test_fresh_scope_heartbeat_keeps_unchanged_task_current(world, published):
 
 
 @pytest.mark.parametrize('scope', [
-    {'observed_at': 800},                      # heartbeat older than the 180 s window
+    {'observed_at': 400},                      # heartbeat older than the 450 s window
     {},                                        # no heartbeat and no per-task stamp
     {'observed_at': 1000, 'state': 'unknown'},  # fresh heartbeat on a scope the owner could not read
     {'observed_at': 1000, 'board': 'other'},    # fresh heartbeat for a different board
diff --git a/tests/hermes_cli/test_kanban_remote_terminal_release.py b/tests/hermes_cli/test_kanban_remote_terminal_release.py
index f4a0b064e1..fbdec67256 100644
--- a/tests/hermes_cli/test_kanban_remote_terminal_release.py
+++ b/tests/hermes_cli/test_kanban_remote_terminal_release.py
@@ -148,3 +148,9 @@ def test_snapshot_does_not_resurrect_a_folded_or_released_alias(tmp_path, monkey
     rows = activity._legacy_remote_links()
     assert counted(rows) == []
     assert {r['key'] for r in rows} == {'owner/default/default/t_1'}
+
+
+def test_scope_heartbeat_between_one_and_two_collector_periods_still_releases(tmp_path):
+    """The owner publishes a scope heartbeat about every 180s; a 200s-old one must not flap the release."""
+    from hermes_cli import kanban_session_activity as ksa
+    assert ksa.SCOPE_HEARTBEAT_FRESH_S >= 400
-- 
2.55.0

