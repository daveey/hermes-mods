From eb5b0fed780b9c164c120e432b147ed909d249a1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 21:16:24 +0000
Subject: [PATCH] [daveey] profile-board links-diff test: settle=0 so the CLI
 read is one raw read, not a 90 s real-clock window

#2520 made `_links_diff` default to DEFAULT_SETTLE_S (90 s) when args has no
`settle`. test_links_diff_names_trusted_profile_board_rows_and_flags_a_missing_card_of_a_synced_profile
called it with `Namespace(json=False)` on a deliberately unclean report, so
settle() re-read until the window ended on the real time.sleep/monotonic seams:
the file went from 10.4 s (5 tests, at 6ce7bb80d7) to 100.0 s with a 90.11 s
slow case (444f35d75e). The assertion is about one raw read's exit code, so pass
settle=0.

Other links-diff CLI callers in tests/: test_kanban_chat_links.py:248 is clean
(stops after one read); test_kanban_chat_links_settle.py drives a fake clock.

Proof (worker-2, hermes-core-wt test):
- GREEN: test_kanban_chat_links_profile_board.py 7 passed, 5.9 s.
- Mutant `_links_diff` -> `return 0`: the test fails with `assert 0 == 1`.

Card: t_01a1d6c1f316550a (found by post-merge check t_01a1d6a623306970).
---
 tests/hermes_cli/test_kanban_chat_links_profile_board.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_chat_links_profile_board.py b/tests/hermes_cli/test_kanban_chat_links_profile_board.py
index ab90db4816..a26620742a 100644
--- a/tests/hermes_cli/test_kanban_chat_links_profile_board.py
+++ b/tests/hermes_cli/test_kanban_chat_links_profile_board.py
@@ -66,7 +66,8 @@ def test_links_diff_names_trusted_profile_board_rows_and_flags_a_missing_card_of
     assert sorted(got) == ["t_d3e3f88a", "t_work_lost", "t_work_on"]
     assert (got["t_work_lost"]["owner_on_board"], got["t_d3e3f88a"]["owner_on_board"]) == (True, False)
     capsys.readouterr()
-    assert kanban_sync_cli._links_diff(argparse.Namespace(json=False)) == 1
+    # settle=0: one raw read. Without it the CLI's 90 s default window re-reads this unclean report on the real clock.
+    assert kanban_sync_cli._links_diff(argparse.Namespace(json=False, settle=0)) == 1
     assert "profile_board: 1 [('s1', ('hub', 'default', 't_d3e3f88a'))]" in capsys.readouterr().out
 
 
