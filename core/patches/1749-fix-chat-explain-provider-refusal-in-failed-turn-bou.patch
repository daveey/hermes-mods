From 3a9c81260f5a02f4e28b1b114bf9b002b6a6d2d5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 21:24:19 +0000
Subject: [PATCH] fix(chat): explain provider refusal in failed-turn boundary
 [daveey]

---
 agent/conversation_loop.py                    |  8 ++-
 agent/turn_failure_copy.py                    | 31 +++++++---
 agent/turn_truncation.py                      |  1 +
 ...est_content_policy_refusal_stop_details.py | 62 +++++++++++++++++++
 4 files changed, 90 insertions(+), 12 deletions(-)

diff --git a/agent/conversation_loop.py b/agent/conversation_loop.py
index 9ed9346efd2..509b6783509 100644
--- a/agent/conversation_loop.py
+++ b/agent/conversation_loop.py
@@ -1140,7 +1140,8 @@ def _invalid_tool_name_error_content(name: str, valid_tool_names) -> str:
 
 
 def _content_policy_blocked_result(
-    messages: list[dict], api_call_count: int, *, final_response: str, error_detail: str
+    messages: list[dict], api_call_count: int, *, final_response: str, error_detail: str,
+    refusal_category: Any = None,
 ) -> dict[str, Any]:
     """Terminal turn result for a content-policy block (deterministic for the unchanged
     prompt, so no retry); shared by the HTTP-200 and exception paths."""
@@ -1148,6 +1149,7 @@ def _content_policy_blocked_result(
         "final_response": final_response, "messages": messages, "api_calls": api_call_count,
         "completed": False, "failed": True, "error": f"content_policy_blocked: {error_detail}",
         "failure_reason": "content_policy_blocked", "failure_retryable": False,
+        "refusal_category": refusal_category,
     }
 
 
@@ -1954,7 +1956,7 @@ def _close_durable_failed_turn(agent, result: Any) -> None:
         # hedge over the whole list rather than under-report a possible side effect.
         start = result.get("current_turn_user_idx")
         turn_messages = messages[start:] if isinstance(start, int) and 0 <= start < len(messages) else messages
-        content = failed_turn_notice(turn_messages, restarted=_stopped_by_backend_exit(agent, result))
+        content = failed_turn_notice(turn_messages, restarted=_stopped_by_backend_exit(agent, result), result=result)
         # [daveey] A turn nobody typed (a Kanban notice, a background-job report) is never "sent again" by a
         # person: its host supplies copy that says what failed and what happens next (TUI: automation replay).
         override = getattr(agent, "_failed_turn_notice_override", None)
@@ -1965,7 +1967,7 @@ def _close_durable_failed_turn(agent, result: Any) -> None:
                 logger.debug("failed-turn copy override raised", exc_info=True)
                 custom = None
             if isinstance(custom, str) and custom.strip():
-                partial = content == PARTIAL_FAILED_TURN_NOTICE
+                partial = failed_turn_notice(turn_messages) == PARTIAL_FAILED_TURN_NOTICE
                 custom = custom.strip() + (" Some actions may already have run; verify their effects." if partial else "")
                 content = _redact_display_metadata({"content": custom})["content"]
         boundary = {"role": "assistant", "display_kind": FAILED_TURN_DISPLAY_KIND, "content": content}
diff --git a/agent/turn_failure_copy.py b/agent/turn_failure_copy.py
index 4659a5d5d7a..4755f5b056b 100644
--- a/agent/turn_failure_copy.py
+++ b/agent/turn_failure_copy.py
@@ -48,8 +48,8 @@ def stamp_failure(result: dict[str, Any], reason: str, retryable: bool) -> dict[
 
 # ---- failed-turn transcript boundary ----------------------------------------------------------
 # The Hermes-authored assistant row that closes a durable turn which ended without one. A
-# transcript boundary, NOT the model's answer: no provider/model error or refusal detail is
-# ever interpolated (that rides ``final_response``). Owned here so the core closer
+# transcript boundary, NOT the model's answer: only a validated refusal category is interpolated;
+# raw provider prose stays in ``final_response``. Owned here so the core closer
 # (``agent/conversation_loop.py::run_conversation``) and the gateway's own writer
 # (``gateway/run_turn.py::_hmwa_close_failed_turn``) say the same thing.
 
@@ -92,14 +92,27 @@ def untyped_failed_turn_display_kind(role: Any, content: Any) -> Optional[str]:
     return None
 
 
-def failed_turn_notice(turn_messages: Any, *, restarted: bool = False) -> str:
-    """Boundary copy for a failed turn: never claim "not processed" when a tool may have run. ``restarted``:
-    the turn was stopped by a backend restart, whose recovery continues a turn that ran no tool."""
-    for row in turn_messages or ():
-        if isinstance(row, dict) and (
+def failed_turn_notice(turn_messages: Any, *, restarted: bool = False, result: Any = None) -> str:
+    """Display-only boundary: preserve refusal categories and possible tool effects, not raw provider prose."""
+    partial = any(
+        isinstance(row, dict) and (
             row.get("role") == "tool" or (row.get("role") == "assistant" and row.get("tool_calls"))
-        ):
-            return PARTIAL_FAILED_TURN_NOTICE
+        ) for row in turn_messages or ()
+    )
+    if isinstance(result, dict) and result.get("failure_reason") == "content_policy_blocked":
+        category = result.get("refusal_category")
+        # Category is a machine identifier, not arbitrary provider prose/markup or reasoning.
+        safe = (isinstance(category, str) and 0 < len(category) <= 80
+                and all(c.isascii() and (c.isalnum() or c in "_-") for c in category))
+        detail = f" (category: {category})" if safe else ""
+        notice = (
+            f"The model provider's content filter refused this turn{detail}. "
+            "Try to rephrase your question, or start a new chat or fork from before the problematic context; "
+            "a long conversation can contribute to a filter trigger."
+        )
+        return notice + (" Some actions may already have run; verify their effects." if partial else "")
+    if partial:
+        return PARTIAL_FAILED_TURN_NOTICE
     return RESTART_FAILED_TURN_NOTICE if restarted else FAILED_TURN_NOTICE
 
 
diff --git a/agent/turn_truncation.py b/agent/turn_truncation.py
index 2a161febf0b..64391fbef26 100644
--- a/agent/turn_truncation.py
+++ b/agent/turn_truncation.py
@@ -794,4 +794,5 @@ def handle_content_policy_refusal(
     return RefusalVerdict("return", _content_policy_blocked_result(
         messages, api_call_count, final_response=_refusal_response,
         error_detail=_refusal_text or "model declined (content_filter)",
+        refusal_category=_stop_details.get("category") if isinstance(_stop_details, dict) else None,
     ), active_system_prompt)
diff --git a/tests/agent/test_content_policy_refusal_stop_details.py b/tests/agent/test_content_policy_refusal_stop_details.py
index 04259baa971..ba225586484 100644
--- a/tests/agent/test_content_policy_refusal_stop_details.py
+++ b/tests/agent/test_content_policy_refusal_stop_details.py
@@ -2,6 +2,10 @@
 from types import SimpleNamespace
 from unittest.mock import MagicMock
 
+import pytest
+
+from agent.conversation_loop import _close_durable_failed_turn
+from agent.turn_failure_copy import FAILED_TURN_NOTICE, failed_turn_notice
 from agent.turn_retry_state import TurnRetryState
 from agent.turn_truncation import handle_content_policy_refusal
 
@@ -32,3 +36,61 @@ def test_empty_refusal_reports_stop_details_explanation():
     )
     assert verdict.action == "return"
     assert "classifier halt" in verdict.result["error"]
+
+
+@pytest.mark.parametrize("explanation", [None, "classifier halt"])
+@pytest.mark.parametrize("partial", [False, True])
+def test_refusal_category_reaches_visible_boundary(explanation, partial):
+    agent = _agent()
+    agent._persist_disabled = False
+    agent._failed_turn_notice_override = None
+    agent.session_id = "refusal-test"
+    agent._session_db.latest_conversation_role.return_value = "tool" if partial else "user"
+    messages = [{"role": "user", "content": "Why choose this host?"}]
+    if partial:
+        messages.append({"role": "tool", "content": "done", "tool_call_id": "call"})
+    response = SimpleNamespace(
+        content=[], stop_reason="refusal", usage=None, model="claude",
+        stop_details={"category": "reasoning_extraction", "explanation": explanation},
+    )
+    verdict = handle_content_policy_refusal(
+        agent, response, TurnRetryState(), thinking_spinner=None, messages=messages,
+        api_messages=[], api_kwargs={}, active_system_prompt=None, conversation_history=[],
+        api_call_count=1, effective_task_id="t", turn_id="u", api_request_id="r",
+        api_start_time=0.0, retry_count=0, max_retries=0,
+    )
+    _close_durable_failed_turn(agent, verdict.result)
+    boundary = messages[-1]
+    assert boundary["display_kind"] == "failed_turn"
+    assert "provider" in boundary["content"]
+    assert "refused" in boundary["content"]
+    assert "reasoning_extraction" in boundary["content"]
+    assert "new chat" in boundary["content"]
+    assert "rephrase" in boundary["content"]
+    assert "Your request was not processed" not in boundary["content"]
+    assert ("Some actions may already have run" in boundary["content"]) == partial
+    agent._flush_messages_to_session_db.assert_called_once_with(messages)
+
+
+def test_other_failure_keeps_generic_visible_boundary():
+    agent = _agent()
+    agent._persist_disabled = False
+    agent._failed_turn_notice_override = None
+    agent.session_id = "failure-test"
+    agent._session_db.latest_conversation_role.return_value = "user"
+    messages = [{"role": "user", "content": "Hello"}]
+    _close_durable_failed_turn(agent, {
+        "messages": messages, "completed": False, "failed": True, "failure_reason": "server_error",
+    })
+    assert messages[-1]["content"] == FAILED_TURN_NOTICE
+
+
+@pytest.mark.parametrize("category", [None, {}, "", "x" * 81, "<script>bad</script>", "secret\ntext"])
+def test_missing_or_malformed_category_still_explains_refusal(category):
+    notice = failed_turn_notice([], result={
+        "failure_reason": "content_policy_blocked", "refusal_category": category,
+    })
+    assert "provider's content filter refused" in notice
+    assert "category:" not in notice
+    assert "<script>" not in notice
+    assert "secret" not in notice
-- 
