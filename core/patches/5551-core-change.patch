From 6d88c1e530963226a7dfb1342c9866eb107ac136 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 22:13:33 +0000
Subject: [PATCH] test(projects): isolate dashboard workspace temp policy
 [daveey]

---
 .../test_web_server_chat_workspaces.py         | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/tests/hermes_cli/test_web_server_chat_workspaces.py b/tests/hermes_cli/test_web_server_chat_workspaces.py
index af2b264611..2c1088784d 100644
--- a/tests/hermes_cli/test_web_server_chat_workspaces.py
+++ b/tests/hermes_cli/test_web_server_chat_workspaces.py
@@ -35,24 +35,34 @@ def client():
             web_server.app.state.auth_required = previous
 
 
-def test_workspaces_lists_projects_and_discovered_repos(client, tmp_path):
+def test_workspaces_lists_projects_and_discovered_repos(client, tmp_path, monkeypatch):
     """Explicit project folders AND the discovery cache both surface; the payload names the
     default cwd a chat lands in when nothing is picked."""
     from hermes_cli import projects_db as pdb
-
+    import tempfile
+
+    # Model a user workspace separately from the OS temp root that hosts pytest.
+    system_temp = tmp_path / "system-temp"
+    system_temp.mkdir()
+    monkeypatch.setattr(tempfile, "gettempdir", lambda: str(system_temp))
+    monkeypatch.setenv("TMPDIR", str(system_temp))
+    rejected_repo = system_temp / "cached-internal"
+    rejected_repo.mkdir()
     proj_dir = tmp_path / "proj"
     proj_dir.mkdir()
     repo_dir = tmp_path / "scanned"
     repo_dir.mkdir()
     with pdb.connect_closing() as conn:
         pdb.create_project(conn, name="Demo", folders=[str(proj_dir)])
-        pdb.record_discovered_repos(conn, [(str(repo_dir), "scanned")], replace=True, policy_key="k")
+        pdb.record_discovered_repos(conn, [
+            (str(repo_dir), "scanned"), (str(rejected_repo), "cached-internal")
+        ], replace=True, policy_key="k")
 
     body = client.get("/api/chat/workspaces").json()
 
     assert [p["name"] for p in body["projects"]] == ["Demo"]
     assert body["projects"][0]["folders"][0]["path"] == str(proj_dir)
-    assert str(repo_dir) in {r["root"] for r in body["repos"]}
+    assert {r["root"] for r in body["repos"]} == {str(repo_dir)}
     assert Path(body["default_cwd"]).is_dir()
     assert body["home"] == str(Path.home())
 
-- 
2.43.0

