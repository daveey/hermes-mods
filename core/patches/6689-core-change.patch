From: daveey <daveey@users.noreply.github.com>
Date: Fri, 27 Nov 2026 04:28:05 +0000
Subject: [PATCH 6689] Annotation holder counts custody and read sharing

Public mirror of source commit 53ab7fd54f7e72d19d1aafc36fc277cf98ce9f13.

---
diff --git a/hermes_cli/kanban_annotation_host.py b/hermes_cli/kanban_annotation_host.py
index f45790aa9da3d4db3ae4771f0b5377bfda6c5635..620bbd514f35e35acc31df12e0c759a5d07c2a89 100644
--- a/hermes_cli/kanban_annotation_host.py
+++ b/hermes_cli/kanban_annotation_host.py
@@ -625,11 +625,16 @@
 
 def replace_deadlines(owner: tuple, values) -> None:
     """Stage a successful source's complete current clocks; never replace a peer's."""
+    from hermes_cli import kanban_session_activity as _ksa
     from hermes_cli.kanban_annotation_deadlines import Plan
 
     pending = getattr(_holder_ctx, 'deadlines', None)
     if isinstance(pending, Plan):
-        pending.replace(owner, values, time.time())
+        # Complete input probes may project rows while planning, without
+        # publishing any output. Only the subsequent real projection owns
+        # replacement; a probe must not borrow a newer clock for old output.
+        if getattr(_ksa._revalidate.force_read, 'scope', None) == _ksa._origin_scope():
+            pending.replace(owner, values, time.time())
     elif pending is not None:  # legacy holder: retain conservative unowned clocks
         for due in values:
             note_deadline(due)
diff --git a/tests/hermes_cli/test_annotation_deadline_custody.py b/tests/hermes_cli/test_annotation_deadline_custody.py
index 240322f3dc964ad31d792b324cddb1bad299299a..1aa6fa1fae94a888a5d4519144e300ae6e5bea9d 100644
--- a/tests/hermes_cli/test_annotation_deadline_custody.py
+++ b/tests/hermes_cli/test_annotation_deadline_custody.py
@@ -117,6 +117,22 @@
     assert host._clock_deadlines[h.scope] == old
 
 
+def test_key_probe_without_output_publication_cannot_replace_clock(replica_holder, monkeypatch):
+    h = replica_holder
+    host._event_refresh(h.events)
+    old = list(host._clock_deadlines[h.scope])
+    h.now[0] = 120.0
+    with sqlite3.connect(h.path) as conn:
+        conn.execute("UPDATE meta SET v='120' WHERE k='last_ok'")
+    def probe(scope):
+        assert ksa._read_remote_links(h.path) == []
+        return {name: 0 for name in parts.ALL}  # unchanged semantic keys; no projection
+    monkeypatch.setattr(parts, 'keys', probe)
+    host._event_refresh(h.events)  # filesystem wake actually probes, unlike a skipped control-only tick
+    assert h.calls == [100.0]
+    assert host._clock_deadlines[h.scope] == old, 'input probe borrowed a newer output clock'
+
+
 def test_deadline_owners_legacy_clocks_and_confirmations_do_not_alias():
     from hermes_cli.kanban_annotation_deadlines import Plan
     plan = Plan([], (), 100.0)
