+def api_listener_state(home, desc, log=None):
+    """This daemon's settled ``api_server`` record from its ``gateway_state.json``: ``state`` is
+    ``connected``, or ``fatal`` with its ``error_code`` (``api_server_port_in_use`` when the port was
