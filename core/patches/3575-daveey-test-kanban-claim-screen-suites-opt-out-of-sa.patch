From 9dfc4ac9c33febff8905c28c6f1519feea47692a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:37:45 +0000
Subject: [PATCH] [daveey] test(kanban): claim-screen suites opt out of
 same-round promotion; the fake Board serves reserve

Main's pickup fixture now serves placement recovery (bb3036bfbd). With
push-before-pull the round that acks a hub-created card also applies its echo,
so that round's reevaluate promotes a portable legacy card before the tick's
claim screen (on main: one round later). The claim-screen tests in
test_kanban_hub_admission_claim (autouse, except test_promotion_*) and the
portable-probe self-check test now use the file's existing _no_board_promotion,
so they keep testing the screen; promotion keeps its own tests. The promoted
card's next round reserves, so FakeHub.reserve answers like a Board with the
route (assigned to the first candidate; 404 when recover is off).

Tests: the 2 files 74 passed; 53 files using the fake Board / pickup fixture
1197 passed.
---
 tests/hermes_cli/kanban_sync_fake_board.py          | 13 +++++++++++++
 .../hermes_cli/test_kanban_claim_deny_selfcheck.py  |  4 +++-
 tests/hermes_cli/test_kanban_hub_admission_claim.py | 10 ++++++++++
 3 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/kanban_sync_fake_board.py b/tests/hermes_cli/kanban_sync_fake_board.py
index 4dae804fbf..47e9d21fc0 100644
--- a/tests/hermes_cli/kanban_sync_fake_board.py
+++ b/tests/hermes_cli/kanban_sync_fake_board.py
@@ -350,6 +350,19 @@ class FakeHub:
             "board", None, hlc)
         return {"state": "assigned", "machine": candidates[0], "task_version": updated["version"]}
 
+    def reserve(self, board: str, *, task_id: str, expected_revision: int, candidates: list) -> dict:
+        """``POST /placement/reserve`` for a worker-first card, served with ``recover`` (a Board that has one has
+        both): assigns the first candidate at ``expected_revision`` without changing the row; off = 404."""
+        self._check()
+        if not self.svc.recover:
+            raise ksc.HubError(404, "not found")
+        self.svc.calls.append(("reserve", board, {"task_id": task_id, "candidates": candidates}))
+        row = self.svc.board(board)["rows"].get("tasks", {}).get(task_id)
+        if row is None or row["version"] != expected_revision or not candidates:
+            raise ksc.HubError(409, json.dumps({"error": "revision_conflict"}))
+        return {"state": "assigned", "machine": candidates[0], "reservation_id": f"r-{task_id}",
+                "expires_at": int(time.time()) + 60, "reason": "worker_capacity_reserved"}
+
     def ops(self, board: str, ops: list[dict]) -> dict:
         self._check()
         self.svc.calls.append(("ops", board, ops))
diff --git a/tests/hermes_cli/test_kanban_claim_deny_selfcheck.py b/tests/hermes_cli/test_kanban_claim_deny_selfcheck.py
index 533ce0132a..7182d2cc74 100644
--- a/tests/hermes_cli/test_kanban_claim_deny_selfcheck.py
+++ b/tests/hermes_cli/test_kanban_claim_deny_selfcheck.py
@@ -77,9 +77,11 @@ def _tick(hub):
 
 # --- keep_reason: a portable fleet probe is not a hub-local wake_check ------------------------------------------
 
-def test_a_claim_deny_with_a_portable_fleet_probe_moves_to_the_worker_queue(gws, hub_judge):
+def test_a_claim_deny_with_a_portable_fleet_probe_moves_to_the_worker_queue(gws, hub_judge, monkeypatch):
     """The live t_01a184cee94603eb shape, with the default probe list: red on main (kept on the hub)."""
+    from tests.hermes_cli.test_kanban_hub_admission_claim import _no_board_promotion
     hub, worker, svc = gws
+    _no_board_promotion(monkeypatch)  # the claim screen's path; promotion applies the same keep reasons
     hub_judge.admit_next = False
     tid = _card(hub, wake_check=PROBE)
     _tick(hub)
diff --git a/tests/hermes_cli/test_kanban_hub_admission_claim.py b/tests/hermes_cli/test_kanban_hub_admission_claim.py
index 82af4370be..902d840ebd 100644
--- a/tests/hermes_cli/test_kanban_hub_admission_claim.py
+++ b/tests/hermes_cli/test_kanban_hub_admission_claim.py
@@ -48,6 +48,16 @@ def _tick(hub):
     return hub.tick()
 
 
+@pytest.fixture(autouse=True)
+def _claim_screen_first(request, monkeypatch):
+    """These tests drive the claim screen, so the Board serves no promotion unless a test is about it.
+
+    Push-before-pull (t_01a1d36ddcea59fe) acks a hub-created card in the round's first push, and that round's feed
+    echo stamps ``created_on``, so the same round's reevaluate already promotes a portable legacy card through
+    placement recovery, before the tick's claim screen. The ``test_promotion_*`` cases cover that path."""
+    if "promotion" not in request.node.name:
+        _no_board_promotion(monkeypatch)
+
 def test_a_denied_pre_gate_hub_card_moves_to_the_worker_queue_and_is_not_claimed(gws, hub_judge):
     hub, worker, svc = gws
     hub_judge.admit_next = False
