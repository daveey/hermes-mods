+    results.append(SimpleNamespace(pulled=0, skipped=False, error="boom"))
+    st.board_end(tok, results)
+    c = la.counters()["sync.board/main"]
+    assert (c["runs"], c["rows"], c["skips"], c["errors"]) == (3, 4, 1, 1)
