From 688d4d1c533d463390a8db3cde7c6712c008eefc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 02:58:14 +0000
Subject: [PATCH] fix(kanban): defer dependency projection to main's
 parent_blocks gate [daveey]

Public mirror of the source commit; see the accompanying feature documentation.

---
 hermes_cli/kanban_containment_terminal.py     | 50 ++-----------------
 .../test_kanban_actionability_dependencies.py | 21 ++++----
 2 files changed, 15 insertions(+), 56 deletions(-)

diff --git a/hermes_cli/kanban_containment_terminal.py b/hermes_cli/kanban_containment_terminal.py
index 5a828dc87d2..884d39b022e 100644
--- a/hermes_cli/kanban_containment_terminal.py
+++ b/hermes_cli/kanban_containment_terminal.py
@@ -118,51 +118,9 @@ def archive_local(conn, task, *, comment=None, precondition=None, via=None, even
     return True
 
 
-_COVERED = "hermes_scope_renewal_covers"
-
-
-def _register_covered(conn) -> bool:
-    """Expose ``kanban_scope_renewal.covered`` to SQL on ``conn``; any read failure is uncovered (fail closed)."""
-    from hermes_cli import kanban_scope_renewal as renewal
-
-    def covers(task_id, key):
-        # A reader schema without comments/renewal columns (minimal mirrors) cannot prove coverage: restrictive.
-        try:
-            return 1 if str(key) in renewal.covered(conn, str(task_id)) else 0
-        except (sqlite3.Error, KeyError, IndexError, TypeError, ValueError):
-            return 0
-    try:
-        sqlite3.Connection.create_function(conn, _COVERED, 2, covers)
-    except (sqlite3.Error, TypeError):
-        return False
-    return True
-
-
 def parent_status_sql(conn, alias="", *, table="tasks"):
-    """Effective dependency state, never terminal success for an execution-restricted scope.
-
-    Both full and incremental foreign mirrors use this expression. Legacy minimal
-    schemas may lack history/marker columns; do not reference nonexistent columns.
-    Ordinary archives remain successful; administrative archive does not clear a stop.
-    """
-    prefix = (alias or table) + "."
-    clauses = []
-    if "containment_episode" in {r[1] for r in conn.execute(f"PRAGMA table_info({table})")}:
-        clauses.append(f"({prefix}status='archived' AND {prefix}containment_episode IS NOT NULL)")
-    columns = {r[1] for r in conn.execute("PRAGMA table_info(task_events)")}
-    if {"task_id", "kind", "payload"} <= columns:
-        live = " AND de.deleted_at IS NULL" if "deleted_at" in columns else ""
-        cause = "CASE WHEN json_valid(de.payload) THEN json_extract(de.payload,'$.cause') END"
-        # A scope stop a valid renewal froze (kanban_scope_renewal.covered: exact uid, unedited mandate) no longer
-        # restricts, exactly as execution readers treat it; safety evidence is never renewable.
-        renewed = ""
-        if "id" in columns and _register_covered(conn):
-            key = "COALESCE(de.uid, CAST(de.id AS TEXT))" if "uid" in columns else "CAST(de.id AS TEXT)"
-            renewed = f" AND NOT ({cause}='scope_stopped' AND {_COVERED}(de.task_id, {key}))"
-        clauses.append(f"EXISTS (SELECT 1 FROM task_events de WHERE de.task_id={prefix}id "
-                       "AND de.kind IN ('spend_budget_triaged','decision_hold_restricted') "
-                       f"AND {cause} IN ('safety_refusal','scope_stopped'){live}{renewed})")
-    if not clauses:
+    """Legacy schemas lack the marker; ordinary archived parents remain successful."""
+    prefix = alias + "." if alias else ""
+    if "containment_episode" not in {r[1] for r in conn.execute(f"PRAGMA table_info({table})")}:
         return prefix + "status"
-    return (f"CASE WHEN {prefix}status IN ('done','archived') AND ({' OR '.join(clauses)}) "
-            f"THEN 'triage' ELSE {prefix}status END")
+    return f"CASE WHEN {prefix}status='archived' AND {prefix}containment_episode IS NOT NULL THEN 'triage' ELSE {prefix}status END"
diff --git a/tests/hermes_cli/test_kanban_actionability_dependencies.py b/tests/hermes_cli/test_kanban_actionability_dependencies.py
index 13481dd6d8b..748819e394a 100644
--- a/tests/hermes_cli/test_kanban_actionability_dependencies.py
+++ b/tests/hermes_cli/test_kanban_actionability_dependencies.py
@@ -24,7 +24,7 @@ def test_archived_scope_stopped_parent_never_satisfies_child(board):
     restrict(board, parent)
     assert kb.archive_task(board, parent)
     assert kb.get_task(board, parent).status == 'archived'
-    assert kb.parent_states(board, child) == [(parent, 'triage')]
+    assert kb.unsatisfied_parents(board, child) == [(parent, 'archived:restricted')]
     kb.recompute_ready(board)
     assert kb.get_task(board, child).status == 'todo'
     assert kb.claim_task(board, child) is None
@@ -82,19 +82,19 @@ def test_foreign_parent_mirrors_preserve_actual_archived_stop(board, monkeypatch
             refresh._refresh_rows(live, board, {parent, ordinary}, scoped={})
         else:
             sync.refresh_remote_parents(live, board, scoped={})
-        assert dict(kb.parent_states(live, 'child', remote=True)) == {parent: 'triage', ordinary: 'archived'}
-        # Exact source correlation matters even when the event table has an id column.
+        assert dict(kb.parent_states(live, 'child', remote=True)) == {parent: 'archived:restricted', ordinary: 'archived'}
+        # Exact source correlation: an unrelated ordinary archive never inherits another card's stop.
         unrelated = kb.create_task(board, title='Unrelated archived control', assignee='default')
         assert kb.archive_task(board, unrelated)
-        from hermes_cli.kanban_containment_terminal import parent_status_sql
-        expression = parent_status_sql(board)
-        rows = dict(board.execute(f'SELECT id,{expression} FROM tasks WHERE id IN (?,?,?)', (parent, ordinary, unrelated)))
-        assert rows == {parent: 'triage', ordinary: 'archived', unrelated: 'archived'}
+        assert kb.parent_blocks(board, parent, 'archived') is True
+        assert kb.parent_blocks(board, ordinary, 'archived') is False
+        assert kb.parent_blocks(board, unrelated, 'archived') is False
     finally:
         live.close()
 
 
-# Review on eeb369b4 (P1): a validly renewed, promoted and completed scope kept projecting triage to its children.
+# Review on eeb369b4 (P1): a validly renewed, promoted and completed scope must release its children (now via
+# main's parent_blocks gate, which labels restricted terminal parents '<status>:restricted').
 from tests.hermes_cli import test_kanban_scope_renewal as scope
 
 
@@ -114,6 +114,7 @@ def test_renewed_promoted_completed_scope_releases_its_child(board, monkeypatch)
     parent, child, _, _ = renewed_and_done(board, monkeypatch)
     assert kb.get_task(board, parent).status == 'done'
     assert kb.parent_states(board, child) == [(parent, 'done')]
+    assert kb.unsatisfied_parents(board, child) == []
     kb.recompute_ready(board)
     assert kb.get_task(board, child).status == 'ready'
 
@@ -127,7 +128,7 @@ def test_edited_mandate_new_stop_or_safety_keep_the_child_waiting(board, monkeyp
             else:
                 cause = 'scope_stopped' if spoil == 'stop' else 'safety_refusal'
                 kb._append_event(board, parent, 'decision_hold_restricted', {'cause': cause, 'episode': episode})
-        assert kb.parent_states(board, child) == [(parent, 'triage')], spoil
+        assert kb.unsatisfied_parents(board, child) == [(parent, 'done:restricted')], spoil
 
 
 @pytest.mark.parametrize('incremental', [False, True])
@@ -154,6 +155,6 @@ def test_foreign_mirrors_release_a_renewed_completed_parent(board, monkeypatch,
             refresh._refresh_rows(live, board, {parent, stopped}, scoped={})
         else:
             sync.refresh_remote_parents(live, board, scoped={})
-        assert dict(kb.parent_states(live, 'child', remote=True)) == {parent: 'done', stopped: 'triage'}
+        assert dict(kb.parent_states(live, 'child', remote=True)) == {parent: 'done', stopped: 'archived:restricted'}
     finally:
         live.close()
