From 122d729522234d5339522e6776911515277fb42b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 11:22:25 +0000
Subject: [PATCH] fix(desktop): a remote-primary window no longer cold-starts a
 local hermes serve for hub replica and retained-Kanban reads

Core E2E remote-topology failed "the client spawned no backend of its own"
(main dispatch 40667086106): Electron spawned a forced-local
conn:local::default serve in a window whose gateway is a remote.

Two renderer reads pinned the registry 'local' (This device) entry from the
primaryGatewayConnectionId() 'local' fallback, which main force-spawns under
a global remote:
- hubGet() of the replica connection (hub-sync sidebar, ad2b99b23): now passive.
- retained-Kanban getSession() for rows without connection_id: now pinned only
  to a real primary connection id (primaryGatewayConnectionPin).

Bisect: first bad ad2b99b23, last good 662710b38. New tests red on base, green
here; e2e/core remote-topology + remote-secondary pass.
---
 .../session/hooks/use-session-list-actions.test.tsx  | 12 ++++++++++++
 .../app/session/hooks/use-session-list-actions.ts    |  5 +++--
 apps/desktop/src/store/gateway.ts                    | 12 ++++++++++++
 3 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/app/session/hooks/use-session-list-actions.test.tsx b/apps/desktop/src/app/session/hooks/use-session-list-actions.test.tsx
index f0389b6d9bc..b990d03bef3 100644
--- a/apps/desktop/src/app/session/hooks/use-session-list-actions.test.tsx
+++ b/apps/desktop/src/app/session/hooks/use-session-list-actions.test.tsx
@@ -277,6 +277,18 @@ it('refreshes a retained remote row outside the recency page on its own owner',
   expect($sessions.get().find(s => s.id === 'old')).toMatchObject({ kanban_active: 16, connection_id: 'remote' })
 })
 
+it('reads a legacy primary\'s retained row unpinned, never pinned to the "This device" entry', async () => {
+  // No connection_id and no registry-backed primary: the window's gateway is a
+  // legacy/env remote. Pinning 'local' would make Electron spawn a local backend.
+  setSessions([row('old', { kanban_active: 2 })])
+  settled.ids = ['old']
+  listSidebarSessions.mockResolvedValue(sidebar({ sessions: [row('new')] }))
+  getSession.mockResolvedValue(row('old', { kanban_active: 16, kanban_observed_at: 123 }))
+  const { result } = renderHook(() => useSessionListActions({ profileScope: 'default' }))
+  await act(async () => { await result.current.refreshSessions() })
+  expect(getSession).toHaveBeenCalledWith('old', { connectionId: null, profile: 'default' })
+})
+
 describe('publishing retained task evidence without count changes', () => {
   it.each(['legacy', 'error'])('publishes unknown after a %s read and clears it on recovery', async failure => {
     const previous = row('old', { connection_id: 'remote', kanban_active: 16, kanban_observed_at: 123 })
diff --git a/apps/desktop/src/app/session/hooks/use-session-list-actions.ts b/apps/desktop/src/app/session/hooks/use-session-list-actions.ts
index 58b67101151..c8e3df5e0e7 100644
--- a/apps/desktop/src/app/session/hooks/use-session-list-actions.ts
+++ b/apps/desktop/src/app/session/hooks/use-session-list-actions.ts
@@ -9,7 +9,7 @@ import {
   SIDEBAR_EXCLUDED_SOURCES
 } from '@/lib/session-source'
 import { markSidebarLive } from '@/store/boot-snapshot'
-import { gatewayActivationEpoch, primaryGatewayConnectionId } from '@/store/gateway'
+import { gatewayActivationEpoch, primaryGatewayConnectionId, primaryGatewayConnectionPin } from '@/store/gateway'
 import {
   $pinnedSessionIds,
   $sessionsLimit,
@@ -425,6 +425,7 @@ export function useSessionListActions({ profileScope }: UseSessionListActionsArg
         do {
           activationEpoch = gatewayActivationEpoch()
           primaryConnection = primaryGatewayConnectionId()
+          const primaryPin = primaryGatewayConnectionPin()
           result = await fetchPage()
 
           if (!owns()) { return }
@@ -441,7 +442,7 @@ export function useSessionListActions({ profileScope }: UseSessionListActionsArg
               (item.connection_id ?? primaryConnection) === (row.connection_id ?? primaryConnection)))
 
           refreshed = await refreshRetainedKanban(retained, row => getSession(row.id, {
-            connectionId: row.connection_id ?? primaryConnection,
+            connectionId: row.connection_id ?? primaryPin,
             profile: row.profile ?? 'default'
           }))
         } while (owns() && gatewayActivationEpoch() !== activationEpoch)
diff --git a/apps/desktop/src/store/gateway.ts b/apps/desktop/src/store/gateway.ts
index f567f67da66..af8876ddaf3 100644
--- a/apps/desktop/src/store/gateway.ts
+++ b/apps/desktop/src/store/gateway.ts
@@ -579,6 +579,18 @@ export function primaryGatewayConnectionId(): string {
   return g.primaryConnectionId ?? 'local'
 }
 
+/**
+ * The primary's registry connection id when it HAS one, else null. Unlike
+ * primaryGatewayConnectionId() this is safe to send as a request pin: its
+ * 'local' fallback names the "This device" registry entry, which Electron
+ * force-spawns a local backend for when the window's primary is a remote
+ * (env override / legacy global remote) — so a window talking to a remote
+ * would start a second, local `hermes serve` the user never asked for.
+ */
+export function primaryGatewayConnectionPin(): null | string {
+  return g.primaryConnectionId
+}
+
 /**
  * The registry connection serving the gateway the user is currently looking
  * at. A registry-backed primary takes its identity from the published primary
