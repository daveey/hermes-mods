@@ -525,12 +529,8 @@ function SidebarSessionRowImpl({
           <span
             aria-hidden="true"
             className={cn(
-              'pointer-events-none absolute top-1 bottom-1 left-0 w-[3px] rounded-full',
-              statusStripe === 'done'
-                ? 'bg-emerald-500'
-                : statusStripe === 'blocked'
-                  ? 'bg-zinc-400 dark:bg-zinc-500'
-                  : 'bg-red-500'
+              'pointer-events-none absolute top-1 bottom-1 left-0 w-[3px] rounded-full bg-(--session-status-color)',
+              sessionStatusStripeColor(statusStripe)
             )}
             data-slot="session-status-stripe"
             data-status-stripe={statusStripe}
diff --git a/apps/desktop/src/lib/session-status-stripe.ts b/apps/desktop/src/lib/session-status-stripe.ts
new file mode 100644
index 0000000000000000000000000000000000000000..17a44944adbcc05c24b9e1fbe05f88f6f24ee7e4
--- /dev/null
+++ b/apps/desktop/src/lib/session-status-stripe.ts
@@ -0,0 +1,15 @@
+import type { SessionStatusStripe } from '@/store/session-dot-state'
+
+/** Shared sidebar stripe / session-tab underline palette, including dark grey. */
+export const sessionStatusStripeColor = (stripe: null | SessionStatusStripe): string => {
+  switch (stripe) {
+    case 'done':
+      return '[--session-status-color:var(--color-emerald-500)]'
+
+    case 'stuck':
+      return '[--session-status-color:var(--color-red-500)]'
+
+    default:
+      return '[--session-status-color:var(--color-zinc-400)] dark:[--session-status-color:var(--color-zinc-500)]'
+  }
+}
