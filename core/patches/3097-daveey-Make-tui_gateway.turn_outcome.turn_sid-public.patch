From 6a07e320e9044e924ccfb488fd5dcbd41ad97c92 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 02:35:28 +0000
Subject: [PATCH] [daveey] Make tui_gateway.turn_outcome.turn_sid public

prompt_turn and session_auto_continue import the session-id helper from
turn_outcome; drop the leading underscore so the cross-module import is a
public API (PR #1788 review nit).
---
 tui_gateway/prompt_turn.py           | 8 ++++----
 tui_gateway/session_auto_continue.py | 4 ++--
 tui_gateway/turn_outcome.py          | 4 ++--
 3 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/tui_gateway/prompt_turn.py b/tui_gateway/prompt_turn.py
index 9939f92fec..c06bc82958 100644
--- a/tui_gateway/prompt_turn.py
+++ b/tui_gateway/prompt_turn.py
@@ -1459,10 +1459,10 @@ def _run_admitted_prompt(
                 _emit("message.complete", sid, payload)
                 if paused_for_update:
                     update_pause.start_in_place_watcher(sid, session, st.marker_key)
-            from tui_gateway.turn_outcome import _turn_sid, concluding_turn_identity
+            from tui_gateway.turn_outcome import turn_sid, concluding_turn_identity
             concluding = concluding_turn_identity(st.agent, st.own_marker)
             _schedule_refused_turn_retry(sid, session, st.marker_key, concluding,
-                outcome_sid=_turn_sid(session, st.agent))
+                outcome_sid=turn_sid(session, st.agent))
             if status == "complete":
                 # [daveey] This turn's context carried any failed delivery already in the transcript.
                 automation_replay.cancel_carried(st.marker_key, str(session.get("session_key") or ""))
@@ -1481,10 +1481,10 @@ def _run_admitted_prompt(
             automation_replay.schedule_for_turn(session, st)
         finally:
             # Capture before admission reopens: the reused agent may then hold the next turn's lease.
-            from tui_gateway.turn_outcome import _turn_sid, concluding_turn_identity
+            from tui_gateway.turn_outcome import turn_sid, concluding_turn_identity
             if concluding is None:
                 concluding = concluding_turn_identity(st.agent, st.own_marker)
-            outcome_sid = _turn_sid(session, st.agent)
+            outcome_sid = turn_sid(session, st.agent)
             automation_replay.remove_failure_copy(st)
             _release_turn_scopes(sid, session, st)
             try:  # a raising settle step must not skip the trim / HERMES_HOME reset
diff --git a/tui_gateway/session_auto_continue.py b/tui_gateway/session_auto_continue.py
index 58c5f2c409..3e7f71c24f 100644
--- a/tui_gateway/session_auto_continue.py
+++ b/tui_gateway/session_auto_continue.py
@@ -130,8 +130,8 @@ def _schedule_refused_turn_retry(sid: str, session: dict, marker_key: str,
         return
 
     if outcome_sid is None:
-        from tui_gateway.turn_outcome import _turn_sid
-        outcome_sid = _turn_sid(session, session.get("agent"))
+        from tui_gateway.turn_outcome import turn_sid
+        outcome_sid = turn_sid(session, session.get("agent"))
 
     def fire() -> None:
         from tui_gateway.update_pause import _detect_skew
diff --git a/tui_gateway/turn_outcome.py b/tui_gateway/turn_outcome.py
index c5a545bd34..39b8f69c56 100644
--- a/tui_gateway/turn_outcome.py
+++ b/tui_gateway/turn_outcome.py
@@ -13,7 +13,7 @@ from typing import Optional
 logger = logging.getLogger(__name__)
 
 
-def _turn_sid(session: dict, agent=None) -> str:
+def turn_sid(session: dict, agent=None) -> str:
     return str(getattr(agent, "session_id", "") or session.get("session_key") or "")
 
 
@@ -51,7 +51,7 @@ def refresh_turn_outcome(session: dict, agent=None, concluding_turn: Optional[fr
                          *, session_id: Optional[str] = None) -> None:
     """Refresh the outcome of the row this turn wrote (the agent's compression tip, else the session key).
     ``concluding_turn``: the turn's own evidence (``concluding_turn_identity``); omitted = nothing discounted."""
-    sid = _turn_sid(session, agent) if session_id is None else session_id
+    sid = turn_sid(session, agent) if session_id is None else session_id
     if not sid:
         return
     try:
-- 
2.51.0

