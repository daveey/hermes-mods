From c9153377cab96415b61b32f15d03b310961e6ec8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 21:58:30 +0000
Subject: [PATCH] [daveey] lifecycle guard: retain prior bodies when rewalking
 heredoc views

Preserve the raw prefix on queued terminator views. Stripping earlier bodies while retaining their openers makes a second walk consume later group commands. Ten new variants fail at e3921101 and pass here, including quoted, tab-stripped, multiple prior bodies and bash-normalized substitutions. Harmless real-bash markers verify feed semantics. Full lifecycle suite: 2334 passed. Static replay of 1249 private multiline terminal commands: zero changed verdicts or exceptions.
---
 cron/lifecycle_guard_groups.py                |  4 +++-
 ...test_lifecycle_guard_heredoc_delimiters.py | 21 +++++++++++++++++++
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/cron/lifecycle_guard_groups.py b/cron/lifecycle_guard_groups.py
index 47ac89c86369b2fa5583b9a99cd456bab335ef96..efdd4eab01f1e6b62c6dc2379c1129fd61ceef44 100644
--- a/cron/lifecycle_guard_groups.py
+++ b/cron/lifecycle_guard_groups.py
@@ -468,7 +468,9 @@ def _heredoc_scripts(command: str) -> Iterator[Optional[str]]:
                 overflow = True
                 break
             views -= 1
-            pending.append(head + view)
+            # A view is parsed again: retain earlier bodies with their openers,
+            # or a bodiless earlier opener consumes the rest of the group.
+            pending.append(script[:previous] + view)
     if overflow:
         yield None
 
diff --git a/tests/cron/test_lifecycle_guard_heredoc_delimiters.py b/tests/cron/test_lifecycle_guard_heredoc_delimiters.py
index 5bf85dd276e0288c0bd83f45ebc2e37b6ff32e79..1f05cd2dcbd7835ffdda044713042729b0e81584 100644
--- a/tests/cron/test_lifecycle_guard_heredoc_delimiters.py
+++ b/tests/cron/test_lifecycle_guard_heredoc_delimiters.py
@@ -177,6 +177,27 @@ def test_two_heredocs_on_one_opener_with_harmless_group_stay_allowed():
     assert scan_gateway_lifecycle(command) == (False, None)
 
 
+@pytest.mark.parametrize("prefix", [
+    "cat <<A\nx\nA\n",
+    "cat <<'A'\n}\nA\n",
+    "cat <<-A\n\tx\n\tA\n",
+    "cat <<A <<B\nx\nA\ny\nB\n",
+    "cat <<A\nx\nA\ncat <<B\ny\nB\n",
+])
+@pytest.mark.parametrize(("delimiter", "terminator"), [REPRINTED[0], REPRINTED[3]])
+def test_reprinted_view_preserves_earlier_heredoc_bodies(tmp_path, prefix, delimiter, terminator):
+    def command(inner, sink):
+        return "{\n" + prefix + _group(delimiter, terminator, inner, sink)[2:]
+
+    assert scan_gateway_lifecycle(command(f"cat {_lifecycle_script(tmp_path)}", "python3")) == (True, None)
+    assert scan_gateway_lifecycle(command("echo MARKER_FED", "cat")) == (False, None)
+    if shutil.which("bash"):
+        result = subprocess.run(["bash", "-c", command("echo MARKER_FED", "cat")],
+                                capture_output=True, text=True, timeout=20, check=False)
+        assert result.returncode == 0, result.stderr
+        assert "MARKER_FED" in result.stdout.splitlines(), result.stderr
+
+
 def _candidate_lines(count: int) -> str:
     lines = [f"echo $(echo {index})" for index in range(count)]
     return "\n".join(["{", "cat <<$(echo E)", *lines, "} | cat"])
