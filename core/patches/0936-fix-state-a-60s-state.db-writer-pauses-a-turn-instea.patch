+def _run_probe_script(db: Path, probes: list[dict]) -> dict:
+    proc = subprocess.run(
+        [
+            sys.executable,
+            "-c",
+            lockowners._DARWIN_PROBE_SCRIPT,
+            str(db),
+            json.dumps(probes),
+        ],
+        capture_output=True,
+        text=True,
+        timeout=lockowners._DARWIN_PROBE_TIMEOUT_S,
+        check=False,
+    )
+    assert proc.returncode == 0, proc.stderr
+    return json.loads(proc.stdout)
