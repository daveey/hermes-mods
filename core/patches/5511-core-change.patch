From 2113992292ec9f44d386da7ab64b5e187ead5427 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 07:39:38 +0000
Subject: [PATCH] test(kanban): settle bootstrap WAL before steady-state cache
 proof [daveey]

The new envelope schema changes WAL page cadence. Exact-head CI and local reproduction fail the heartbeat cache control while the unchanged parent passes. Checkpoint schema bootstrap before warming this steady-state test; retain revision assertions, content rearm tests and the independent main-file-rewrite invalidation control. Focused RED on original fixture; all 10 replica revision controls GREEN with explicit bootstrap settlement.
---
 tests/hermes_cli/test_kanban_sync_links_replica_revision.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_sync_links_replica_revision.py b/tests/hermes_cli/test_kanban_sync_links_replica_revision.py
index 3f52f81e5a..25d01f8945 100644
--- a/tests/hermes_cli/test_kanban_sync_links_replica_revision.py
+++ b/tests/hermes_cli/test_kanban_sync_links_replica_revision.py
@@ -51,6 +51,10 @@ def test_replica_bookkeeping_rows_do_not_repeat_plan(live, ledger, kanban_home,
         with kbc.write_txn(replica):
             replica.execute("INSERT INTO tasks (id,title,status,created_at,created_on) "
                             "VALUES ('t_foreign','foreign','running',1,?)", (f.OTHER,))
+        # Settle schema-bootstrap WAL pages before warming the steady-state cache.
+        # Otherwise a later heartbeat can cross SQLite's auto-checkpoint boundary
+        # and correctly trigger the independent main-file rewrite invalidator.
+        replica.execute("PRAGMA wal_checkpoint(TRUNCATE)")
         settled = f._settled(live, ledger, kanban_home, spies)
         for i in range(3):
             before = rev.read_key(replica, rev.SHADOW_TABLES)
