From 7d2bba4f5908d3f7fd01b2c31858e6922209849a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 16:08:31 +0000
Subject: [PATCH] [daveey] lifecycle guard tests: pin a process substitution
 closed on the next line (#2393 follow-up)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Test-only pins. On main before 80acb24331 (the one-walk-per-script change), each line got a
fresh `_LineWalk`, so a `<(` left open at a line end resumed the outer command with the last
segment's output never routed into the group, and `scan_gateway_lifecycle` returned
(False, None) for:

    python3 <(cat f.py          bash < <(cat r.sh
    )                           )

A real bash runs f.py / r.sh for both. 80acb24331 already fixes them (a newline ends the
command as `;` does); these cases keep it fixed. Added to
tests/cron/test_lifecycle_guard_multiline_feed.py:

- scanned: `python3 <(cat f.py⏎)`, `bash < <(cat r.sh⏎)`, and the control
  `python3 <(cat f.py;⏎)` (already scanned per line);
- allowed: `cat c.py | python3 - <(cat f.py |⏎cat)` (stdin is c.py; bash runs c.py).
  `python3 <(⏎cat f.py⏎)` was already pinned by 80acb24331.

Proof: the two new scanned cases are RED on 80acb24331^ (7325d3c867) and GREEN on main;
the control and the allowed case pass on both (pins). File: 54 passed on main.
Card: t_01a1d633c3e3ec1e.
---
 tests/cron/test_lifecycle_guard_multiline_feed.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/tests/cron/test_lifecycle_guard_multiline_feed.py b/tests/cron/test_lifecycle_guard_multiline_feed.py
index 0e3c0afa7f..5bf5c98aab 100644
--- a/tests/cron/test_lifecycle_guard_multiline_feed.py
+++ b/tests/cron/test_lifecycle_guard_multiline_feed.py
@@ -66,6 +66,10 @@ def files(tmp_path) -> dict[str, str]:
         # A process substitution spanning lines.
         "python3 <(\ncat {py}\n)",
         "bash <(\ncat {sh}\n)",
+        # ... and one whose last command ends at the line break, not at `;` (#2393 follow-up).
+        "python3 <(cat {py}\n)",
+        "bash < <(cat {sh}\n)",
+        "python3 <(cat {py};\n)",
         # A quoted newline inside the group body is data, not a line break.
         "{{\necho 'a\nb'\ncat {py}\n}} | python3",
         # A heredoc body's `}` does not close the group around its command.
@@ -104,6 +108,8 @@ def test_multiline_compound_feeds_are_scanned(files, template):
         # A heredoc body's `{` does not open a group the command's `}` then closes.
         "cat <<EOF\n{{\nEOF\ncat {py}\n}} | python3",
         "cat <<EOF\n(\nEOF\ncat {py}\n) | python3",
+        # stdin comes from the clean file; the process substitution is only an argument.
+        "cat {clean} | python3 - <(cat {py} |\ncat)",
     ],
 )
 def test_multiline_bodies_without_a_feed_stay_allowed(files, template):
