From 3fcc0e0f77edee208c947a2906240c867297a7b6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 02:58:36 +0000
Subject: [PATCH] fix(cron): preserve input provenance through descriptor
 transfers [daveey]

Follow copies and moves through both duplication operators. Replace closed and rebound descriptor bindings in order, returning the final stdin file. Review regressions: three scanner failures before, all 21 transfer and control cases pass after; 1603 lifecycle consumer tests pass. Full check currently hits unrelated stale-base health findings; rerun after canonical rebase.
---
 cron/lifecycle_guard.py                       | 21 ++++++------
 ...est_lifecycle_guard_descriptor_transfer.py | 34 +++++++++++++++++++
 2 files changed, 45 insertions(+), 10 deletions(-)
 create mode 100644 tests/cron/test_lifecycle_guard_descriptor_transfer.py

diff --git a/cron/lifecycle_guard.py b/cron/lifecycle_guard.py
index 2c78228066..1b7a5c0281 100644
--- a/cron/lifecycle_guard.py
+++ b/cron/lifecycle_guard.py
@@ -922,11 +922,8 @@ def _runs_under_uv(segment: list[str], index: int) -> bool:
 
 
 def _split_redirections(arguments: list[str]) -> tuple[list[str], list[str]]:
-    """``(arguments without redirections, files redirected to stdin)``. A heredoc, here-string or
-    descriptor duplication is stripped but feeds no file; ``<`` and ``<>`` on fd 0 do, and so does
-    ``<&N`` after ``N<f`` opened a file on that descriptor (``bash 3<f.sh <&3``)."""
+    """Strip redirections and follow opened inputs through ordered fd copies/moves to stdin."""
     kept: list[str] = []
-    stdin: list[str] = []
     opened: dict[str, str] = {}
     index = 0
     while index < len(arguments):
@@ -939,13 +936,17 @@ def _split_redirections(arguments: list[str]) -> tuple[list[str], list[str]]:
         if not target and index < len(arguments):
             target = arguments[index]
             index += 1
+        fd = fd or ("0" if operator.startswith("<") else "1")
+        source = target.removesuffix("-")
+        provenance = opened.get(source) if operator in ("<&", ">&") else None
+        opened.pop(fd, None)  # Every redirection replaces the destination's old binding.
         if operator in ("<", "<>") and target:
-            opened[fd or "0"] = target
-        elif operator == "<&" and fd in ("", "0") and target in opened:
-            operator, target = "<", opened[target]
-        if operator in ("<", "<>") and fd in ("", "0") and target:
-            stdin.append(target)
-    return kept, stdin
+            opened[fd] = target
+        elif provenance is not None:
+            opened[fd] = provenance
+        if operator in ("<&", ">&") and target.endswith("-"):
+            opened.pop(source, None)  # A move copies first, then closes its source.
+    return kept, [opened["0"]] if "0" in opened else []
 
 
 def _cat_operands(segment: Optional[list[str]]) -> list[str]:
diff --git a/tests/cron/test_lifecycle_guard_descriptor_transfer.py b/tests/cron/test_lifecycle_guard_descriptor_transfer.py
new file mode 100644
index 0000000000..1c1c00dfe3
--- /dev/null
+++ b/tests/cron/test_lifecycle_guard_descriptor_transfer.py
@@ -0,0 +1,34 @@
+"""Descriptor provenance regressions; scanner inputs never execute a shell."""
+import pytest
+
+from cron.lifecycle_guard import _split_redirections, scan_gateway_lifecycle
+
+
+@pytest.mark.parametrize("suffix", ["<&3-", "4<&3 <&4", "4>&3 <&4"])
+@pytest.mark.parametrize("dangerous", [True, False])
+def test_opened_descriptor_transfer(tmp_path, suffix, dangerous):
+    script = tmp_path / "script.sh"
+    script.write_text(" ".join(["hermes", "gateway", "restart"]) + "\n"
+                      if dangerous else "echo harmless\n", encoding="utf-8")
+    assert scan_gateway_lifecycle(f"bash 3<{script} {suffix}") == (dangerous, None)
+
+
+@pytest.mark.parametrize("redirects, expected", [
+    (["3<bad", "4<&3", "3<&-", "<&4"], ["bad"]),
+    (["3<bad", "4>&3-", "<&4"], ["bad"]),
+    (["3<bad", "4<&3-", "<&3"], []),
+    (["3<bad", "3<&-", "<&3"], []),
+    (["3<bad", "3>&-", "<&3"], []),
+    (["3<bad", "3>out", "<&3"], []),
+    (["3<bad", "3<<<safe", "<&3"], []),
+    (["3<bad", "3<&9", "<&3"], []),
+    (["3<bad", "3<good", "<&3"], ["good"]),
+    (["3<bad", "4<&3", "3<good", "<&4"], ["bad"]),
+    (["<bad", "<good"], ["good"]),
+    (["<bad", "0<&-"], []),
+    (["3<bad", "0>&3"], ["bad"]),
+    (["3<bad", "3<&3", "<&3"], ["bad"]),
+    (["3<bad", "3<&3-", "<&3"], []),
+])
+def test_descriptor_close_and_rebind(redirects, expected):
+    assert _split_redirections(redirects) == ([], expected)
