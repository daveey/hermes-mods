From b6d05be874e925eb726522ed53310eb3a6883679 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 03:13:54 +0000
Subject: [PATCH] [daveey] survivable processes: lazy
 SURVIVABLE_INTERRUPT_REASONS import, no bare which (CI)

CI on 0c46c784693 failed two cross-cutting checks:
- tests/tools/test_managed_browserbase_and_modal.py stubs tools.interrupt before importing
  terminal_tool; process_registry_survivable's module-level import of SURVIVABLE_INTERRUPT_REASONS
  raised ImportError. It is now imported inside survivable_interrupt_reason.
- tests/test_managed_runtime_resolution.py flagged a new bare shutil.which in usable(); it was
  redundant (_systemd_run_user_scope_available resolves systemd-run itself) and is dropped.
Also rebased on f021646c08f (update-pause mid-tool cancel): agent/interrupt_control merges both
rules (a pending Stop keeps its reason against every survivable reason; the update pause relabels
no pending interrupt and is not a user intervention).
RED: both files failed in CI run 42946701271 on 0c46c784693. GREEN: 4 files, 68 passed.
---
 tests/tools/test_update_survivable_processes.py |  5 ++---
 tools/process_registry_survivable.py            | 15 +++++++--------
 2 files changed, 9 insertions(+), 11 deletions(-)

diff --git a/tests/tools/test_update_survivable_processes.py b/tests/tools/test_update_survivable_processes.py
index 787d3c8475..0d3cb51c28 100644
--- a/tests/tools/test_update_survivable_processes.py
+++ b/tests/tools/test_update_survivable_processes.py
@@ -21,7 +21,7 @@ import pytest
 import tools.process_registry as pr
 import tools.process_registry_survivable as surv
 from tests.waiting import wait_until
-from tools.interrupt import set_interrupt
+from tools.interrupt import SURVIVABLE_INTERRUPT_REASONS, set_interrupt
 from tools.process_registry import ProcessRegistry
 
 REPO = str(Path(pr.__file__).resolve().parents[1])
@@ -41,7 +41,6 @@ def key(monkeypatch):
     monkeypatch.setattr(pr.ProcessRegistry, "_config_value",
                         staticmethod(lambda section, k, fallback: state["on"] if k == surv.CONFIG_KEY else fallback))
     monkeypatch.setattr(pr, "_systemd_run_user_scope_available", lambda: state["scope"])
-    monkeypatch.setattr(surv.shutil, "which", lambda name: f"/usr/bin/{name}")
     monkeypatch.setattr(surv, "_warned", False)
     return state
 
@@ -208,7 +207,7 @@ def test_a_shutdown_after_a_user_stop_keeps_the_stop_reason_on_the_tool_thread()
 
     tid = threading.get_ident()
     try:
-        for later in sorted(surv.SURVIVABLE_INTERRUPT_REASONS):
+        for later in sorted(SURVIVABLE_INTERRUPT_REASONS):
             stopped = agent()
             request_hard_interrupt(stopped)  # the user's Stop
             stop_reason = stopped._tool_interrupt_reason
diff --git a/tools/process_registry_survivable.py b/tools/process_registry_survivable.py
index 49eebce760..2c7a937f4f 100644
--- a/tools/process_registry_survivable.py
+++ b/tools/process_registry_survivable.py
@@ -24,18 +24,12 @@ import json
 import logging
 import os
 import shlex
-import shutil
 import subprocess
 import threading
 from contextlib import suppress
 from pathlib import Path
 from typing import Any, Optional
 
-# ``tool_reason`` slugs a survivable foreground command outlives: card A's update pause, the gateway's
-# restart/shutdown stop and a TUI/Desktop backend exit (session_reaper's ``backend_exit``). A user Stop, a
-# new message, a timeout and every watchdog are not in it: those still kill the command.
-from tools.interrupt import SURVIVABLE_INTERRUPT_REASONS
-
 logger = logging.getLogger("tools.process_registry")
 
 CONFIG_KEY = "update_survivable_processes"
@@ -72,7 +66,8 @@ def usable() -> bool:
 
     # The same decision persisted_job_scope_argv makes: a process in no user unit gets no scope.
     in_unit = kanban_run_scope_cgroup() is not None or user_unit_cgroup() is not None
-    if in_unit and shutil.which("systemd-run") and pr._systemd_run_user_scope_available():
+    # The probe resolves systemd-run itself (no binary = unusable).
+    if in_unit and pr._systemd_run_user_scope_available():
         return True
     with _warn_lock:
         if not _warned:
@@ -109,7 +104,11 @@ def foreground_eligible(env: Any, env_type: str, effective_timeout: Any) -> bool
 def survivable_interrupt_reason(*thread_ids: Optional[int]) -> Optional[str]:
     """The pending interrupt of ``thread_ids`` (the waiter, the tool thread it acts for) when it is one a
     survivable command outlives; None for any other interrupt (a user Stop kills the command)."""
-    from tools.interrupt import thread_interrupt_reason
+    # ``SURVIVABLE_INTERRUPT_REASONS``: the ``tool_reason`` slugs a survivable foreground command outlives
+    # (card A's update pause, the gateway's restart/shutdown stop, a TUI/Desktop backend exit). A user Stop,
+    # a new message, a timeout and every watchdog are not in it: those still kill the command. Imported here,
+    # not at module level: terminal_tool imports this module, and harnesses stub tools.interrupt.
+    from tools.interrupt import SURVIVABLE_INTERRUPT_REASONS, thread_interrupt_reason
 
     for tid in thread_ids:
         if tid and (reason := thread_interrupt_reason(tid)) in SURVIVABLE_INTERRUPT_REASONS:
