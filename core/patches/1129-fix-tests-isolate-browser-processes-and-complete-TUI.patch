 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_update_finish.py b/tests/hermes_cli/test_update_finish.py
index 584313f90e6..257edfcc49c 100644
--- a/tests/hermes_cli/test_update_finish.py
+++ b/tests/hermes_cli/test_update_finish.py
@@ -421,6 +421,12 @@ def _npm_graph(source):
     _put(source, "packages/value/index.js", "export const value = 'compiled local graph';\n")
     _put(source, "packages/value/index.d.ts", "export const value: string;\n")
     _put(source, "ui-tui/src/entry.tsx", "import { value } from 'fixture-value'; console.log(value);\n")
+    # [daveey] The real TUI compiler also packages its Python helpers. Keep the
+    # miniature checkout complete so a missing input cannot mask compiler results.
+    for name in ("gateway_bootstrap.py", "clipboard_image.py"):
+        target = source / "ui-tui/scripts" / name
+        target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(ROOT / "ui-tui/scripts" / name, target)
     _put(source, "web/src/main.ts", "import { value } from 'fixture-value'; document.body.textContent = value;\n")
     _put(source, "web/index.html", '<html><body><script type="module" src="/src/main.ts"></script></body></html>')
     _put(source, "web/tsconfig.json", json.dumps({"compilerOptions": {
diff --git a/tests/tools/test_browser_real_profile.py b/tests/tools/test_browser_real_profile.py
index 7506a4bd2af..80466600fd2 100644
--- a/tests/tools/test_browser_real_profile.py
+++ b/tests/tools/test_browser_real_profile.py
@@ -375,14 +375,19 @@ class TestRealProfileCdpLaunch:
         snapshot.assert_not_called()
         assert attached is not None and attached.owned is False and attached.pid == chrome.pid
 
-    def test_the_browser_holding_a_dir_is_found_by_its_argv_never_a_helper(self, tmp_path):
+    def test_the_browser_holding_a_dir_is_found_by_its_argv_never_a_helper(self, tmp_path, monkeypatch):
         """The argv scan behind the Windows singleton check (real processes, any host): the browser process
         naming the dir, never a ``--type=`` helper naming it too, and nothing for another dir."""
         import subprocess
+        import psutil
 
         helper = subprocess.Popen([*_SLEEPER, "--type=renderer", f"--user-data-dir={tmp_path}"])
         browser = subprocess.Popen([*_SLEEPER, f"--user-data-dir={tmp_path}"])
         try:
+            # [daveey] Inspect real argv, but only for children this test owns:
+            # unrelated live browsers can name (and realpath) the real Hermes home.
+            children = [psutil.Process(proc.pid) for proc in (helper, browser)]
+            monkeypatch.setattr(psutil, "process_iter", lambda attrs: iter(children))
             found = launcher._pid_naming_dir(str(tmp_path))
             other = launcher._pid_naming_dir(str(tmp_path / "other"))
         finally:
