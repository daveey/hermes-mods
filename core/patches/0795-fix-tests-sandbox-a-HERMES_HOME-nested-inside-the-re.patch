From 89338dbf512ba2673de00a98ba13c3c3e60c8f3b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 17:29:47 +0000
Subject: [PATCH] fix(tests): sandbox a HERMES_HOME nested inside the real
 Hermes root [daveey]

HERMES_HOME=$(mktemp -d) from a Hermes worker shell (TMPDIR=~/.hermes/cache/scratch)
handed pytest a "custom" home inside the real root. The conftest honored it, so
import-time homes (tui_gateway.server._hermes_home) froze there and realpath() of
them lstat'ed ~/.hermes/cache, tripping the real-home guard in 13 notification_poller
tests. Treat any home nested in the real root as production and sandbox it.
Regression: test_hermes_home_nested_in_the_real_root_is_sandboxed.
---
 tests/conftest.py                           |  9 +++--
 tests/hermes_cli/test_real_home_tripwire.py | 41 +++++++++++++++++++++
 2 files changed, 46 insertions(+), 4 deletions(-)

diff --git a/tests/conftest.py b/tests/conftest.py
index 38a7331cf4..68977a4f5f 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -101,10 +101,11 @@ def _hermes_home_points_at_production(value: str) -> bool:
         real_root = _real_platform_state_root() or (Path.home() / ".hermes").resolve()
     except Exception:
         return True
-    if resolved == real_root:
-        return True
-    # Profile home directly under the production root: <root>/profiles/<name>
-    return resolved.parent.name == "profiles" and resolved.parent.parent == real_root
+    # The root itself, a profile home (<root>/profiles/<name>), or any other dir nested in it. A
+    # nested "custom" home is never usable: the real-home guard refuses everything under the root,
+    # and ``HERMES_HOME=$(mktemp -d)`` from a Hermes shell (TMPDIR=<root>/cache/scratch) lands
+    # there, freezing import-time homes (``tui_gateway.server._hermes_home``) inside the root.
+    return resolved.is_relative_to(real_root)
 
 
 # ``import hermes_bootstrap`` (transitively: any entry-point module) runs
diff --git a/tests/hermes_cli/test_real_home_tripwire.py b/tests/hermes_cli/test_real_home_tripwire.py
index e8c4982e70..ebd74fa392 100644
--- a/tests/hermes_cli/test_real_home_tripwire.py
+++ b/tests/hermes_cli/test_real_home_tripwire.py
@@ -285,6 +285,47 @@ def test_hermes_exported_scratch_tmp_is_not_the_test_temp_root(tmp_path):
     assert "1 passed" in result.stdout
 
 
+def test_hermes_home_nested_in_the_real_root_is_sandboxed(tmp_path):
+    """``HERMES_HOME=$(mktemp -d)`` from a Hermes worker shell (TMPDIR=<real root>/cache/scratch)
+    hands pytest a "custom" home INSIDE the real root. Honoring it froze import-time homes
+    (``tui_gateway.server._hermes_home``) there, so resolving or writing them tripped the
+    real-home guard on ``<root>/cache``. The conftest must sandbox it like the root itself."""
+    fake_user = tmp_path / "user"
+    scratch = fake_user / ".hermes" / "cache" / "scratch"
+    nested_home = scratch / "tmp.abc123"
+    nested_home.mkdir(parents=True)
+    probe = tmp_path / "test_probe.py"
+    probe.write_text(textwrap.dedent(f"""
+        import os
+        from pathlib import Path
+
+        # Collection-time, like any test module importing tui_gateway.server at the top.
+        from tui_gateway import server
+        COLLECTION_HOME = os.environ["HERMES_HOME"]
+
+        def test_session_home_is_outside_the_real_root():
+            real_root = Path({str(fake_user / ".hermes")!r}).resolve()
+            home = Path(COLLECTION_HOME).resolve()
+            assert not home.is_relative_to(real_root), home
+            (home / "probe.txt").write_text("ok")
+
+        def test_import_time_home_resolves_under_the_guard():
+            # process_consumer_health.register() does exactly this for the session home.
+            Path(server._hermes_home).resolve()
+        """), encoding="utf-8")
+    env = {k: v for k, v in os.environ.items()
+           if k not in ("TMPDIR", "TMP", "TEMP", "HERMES_SCRATCH_DIR", "HERMES_TEST_SANDBOX_HOME")}
+    env.update(HOME=str(fake_user), HERMES_HOME=str(nested_home), TMPDIR=str(scratch))
+    result = subprocess.run(
+        [sys.executable, "-m", "pytest", "-p", "tests.conftest", "-p", "no:cacheprovider", "-q", str(probe)],
+        cwd=PROJECT_ROOT, env=env, capture_output=True, text=True, timeout=180,
+        check=False,
+    )
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert "2 passed" in result.stdout
+    assert not (nested_home / "probe.txt").exists()
+
+
 def test_linked_worktree_git_dir_is_the_checkouts_own_metadata(tmp_path):
     """A linked worktree's ``.git`` file names its git dir (under the home's checkout for
     hermes-core-wt trees); that dir counts as the checkout's, a plain clone contributes nothing,
-- 
