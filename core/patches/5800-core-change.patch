+def qualified(filename, function):
+    module = Path(filename).stem
+    package = {"gen_source_receipt_fixture.py": "scripts", "flaky_intake.py": "scripts.ci"}.get(filename, "hermes_cli")
+    return f"{package}.{module}.{function}"
