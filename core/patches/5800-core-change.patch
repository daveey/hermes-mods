 tests/conftest.py                             |   1 -
 tests/hermes_cli/custody_authorizer.py        | 193 ---------
 .../test_kanban_sync_capture_sites.py         | 375 ++++++------------
 5 files changed, 132 insertions(+), 467 deletions(-)
 delete mode 100644 tests/_fixtures/custody_writes.py
