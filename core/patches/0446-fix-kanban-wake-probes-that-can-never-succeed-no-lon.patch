diff --git a/hermes_cli/kanban_wait_check.py b/hermes_cli/kanban_wait_check.py
new file mode 100644
index 0000000000..32dc8451d4
--- /dev/null
+++ b/hermes_cli/kanban_wait_check.py
@@ -0,0 +1,87 @@
+"""``hermes kanban wait-check``: the one supported cross-gateway wait probe.
+
+Exit 0 = condition met, 1 = not yet, 2 = cannot tell (unknown card, unreachable gateway,
+unreadable DB). The wake-check scheduler treats 2 as broken (3 in a row wakes the card),
+never as "not yet". Arguments travel as argv (``shlex.join`` for ssh), so SQL/quoting
+never gets re-split by a remote shell.
+
+    hermes kanban wait-check task t_x [--gateway hub] [--board SLUG] [--until done,blocked,archived]
+    hermes kanban wait-check board-empty SLUG [--gateway hub]
+"""
+from __future__ import annotations
+
+import os
+import shlex
+import sqlite3
+import subprocess
+import sys
+from pathlib import Path
+from typing import Optional
+
+DEFAULT_UNTIL = ("done", "blocked", "archived")
+GATEWAY_SSH = {"hub": "ubuntu@hub.example.com"}
+SSH_TIMEOUT = 25
+
+
+def _db(board: Optional[str]) -> Path:
+    home = Path(os.environ.get("HERMES_HOME") or Path.home() / ".hermes")
+    if os.environ.get("HERMES_KANBAN_DB") and board in (None, "default"):
+        return Path(os.environ["HERMES_KANBAN_DB"])
+    return home / "kanban.db" if board in (None, "default") else home / "kanban" / "boards" / board / "kanban.db"
+
+
+def _query(path: Path, sql: str, args=()):
+    last: Optional[Exception] = None
+    for _ in range(3):  # WAL/lock flakes are transient
+        try:
+            c = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=20)
+            try:
+                return c.execute(sql, args).fetchall()
+            finally:
+                c.close()
+        except sqlite3.OperationalError as exc:
+            last = exc
+    raise last  # type: ignore[misc]
+
+
+def check_local(kind: str, target: str, *, board: Optional[str] = None, until=DEFAULT_UNTIL) -> tuple[int, str]:
+    try:
+        if kind == "task":
+            rows = _query(_db(board), "select status from tasks where id=?", (target,))
+            if not rows:
+                return 2, f"error: {target} not found"
+            return (0 if rows[0][0] in set(until) else 1), f"{target} {rows[0][0]}"
+        if kind == "board-empty":
+            n = _query(_db(target), "select count(*) from tasks where status not in ('done','archived')")[0][0]
+            return (0 if n == 0 else 1), f"{target} open={n}"
+    except Exception as exc:  # any failure is "cannot tell", never "not yet"
+        return 2, f"error: {exc}"
+    return 2, f"error: unknown check {kind!r}"
+
+
+def check_remote(gateway: str, kind: str, target: str, *, board: Optional[str] = None, until=DEFAULT_UNTIL) -> tuple[int, str]:
+    inner = ["hermes", "kanban", "wait-check", kind, target, "--until", ",".join(until)]
+    if board:
+        inner += ["--board", board]
+    host = GATEWAY_SSH.get(gateway, gateway)
+    remote = "export PATH=$HOME/.local/bin:$HOME/.hermes/bin:$PATH; " + shlex.join(inner)
+    try:
+        p = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", f"ConnectTimeout={SSH_TIMEOUT}", host, remote],
+                           capture_output=True, text=True, timeout=SSH_TIMEOUT + 15, check=False)
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        return 2, f"error: ssh {host}: {exc}"
+    out = (p.stdout + p.stderr).strip()
+    if p.returncode in (0, 1):
+        return p.returncode, out
+    return 2, f"error: remote wait-check on {host} exited {p.returncode}: {out[-300:]}"
+
+
+def run(args) -> int:
+    until = tuple(u for u in (args.until or "").split(",") if u) or DEFAULT_UNTIL
+    gw = getattr(args, "gateway", None)
+    if gw in (None, "", "local"):
+        rc, msg = check_local(args.check, args.target, board=args.board, until=until)
+    else:
+        rc, msg = check_remote(gw, args.check, args.target, board=args.board, until=until)
+    print(msg, file=sys.stderr if rc == 2 else sys.stdout)
+    return rc
diff --git a/hermes_cli/kanban_wake_check.py b/hermes_cli/kanban_wake_check.py
index a7de802b18..7681ef2228 100644
--- a/hermes_cli/kanban_wake_check.py
+++ b/hermes_cli/kanban_wake_check.py
@@ -27,6 +27,7 @@ from __future__ import annotations
 
 import logging
 import os
+import re
 import sqlite3
 import subprocess
 import threading
@@ -52,6 +53,42 @@ OUTPUT_TAIL_CHARS = 500
 MAX_CMD_CHARS = 2000
 CONDITION_MET_EVENT = "condition_met"
 BROKEN_EVENT = "wake_check_broken"
+# Output that shows a probe crashed even though it exited 1 ("not yet"): a traceback, a
+# shell syntax/lookup error, a sqlite failure, or a script's own ``error:`` line. Such a
+# probe can never succeed, so it counts toward BROKEN_AFTER instead of looking like waiting.
+ERROR_OUTPUT_RE = re.compile(
+    r"Traceback \(most recent call last\)|^\s*(?:\S+: )?(?:line \d+: )?.*(?:syntax error|command not found"
+    r"|No such file or directory|unexpected EOF)|OperationalError|database is locked"
+    r"|unable to open database file|^\s*error:", re.IGNORECASE | re.MULTILINE)
+
+
+def output_error(out: str) -> Optional[str]:
+    """The matching error line when a probe's output shows it crashed, else None."""
+    m = ERROR_OUTPUT_RE.search(out or "")
+    return m.group(0).strip() or "error" if m else None
+
+
+def dry_run_error(cmd: Optional[str], *, cwd: Optional[str] = None, env: Optional[dict] = None) -> Optional[str]:
+    """Run ``cmd`` once at park time; refusal text when it can never succeed (rc >= 2, could
+    not start, or exit 0/1 with error output), else None. A timeout is accepted: slow is not
+    broken. ``HERMES_KANBAN_WAKE_DRYRUN=0`` skips it (tests)."""
+    if not cmd or os.environ.get("HERMES_KANBAN_WAKE_DRYRUN") == "0":
+        return None
+    rc, out = _run_probe(("dry-run", cmd), cmd, cwd or str(Path.home()), env if env is not None else dict(os.environ))
+    if rc == "timeout":
+        return None
+    bad = None
+    if not isinstance(rc, int) or rc >= 2:
+        bad = f"exited {rc}"
+    elif output_error(out):
+        bad = f"exit {rc} but its output shows an error ({output_error(out)})"
+    if bad is None:
+        return None
+    return (f"refused: the wake_check was run once at park time and {bad}, so it could never "
+            "succeed and would wait silently forever. Exit codes: 0 = condition holds, 1 = not "
+            "yet, anything else = broken. For a wait on another card use "
+            "`hermes kanban wait-check task <id> --gateway <name> --until done,blocked`; do not "
+            f"hand-roll ssh+SQL (ssh re-splits quoted args). Output: {_tail(out)!r}")
 
 
 GUARD_HELP = (
@@ -348,12 +385,14 @@ def apply_result(conn: sqlite3.Connection, task_id: str, cmd: str, rc: Any, out:
         rc_col = rc if isinstance(rc, int) else -1
         if rc == 0:
             return _wake(conn, task_id, CONDITION_MET_EVENT, {"wake_check": cmd, "output": tail})
-        if rc == 1:
+        if rc == 1 and not output_error(out):
             conn.execute(
                 "UPDATE task_wake_checks SET last_at = ?, last_rc = 1, last_out = ?, fails = 0, "
                 "next_at = ? WHERE task_id = ?", (now, tail, now + int(state["every"]), task_id))
             return None
         fails = int(state["fails"] or 0) + 1
+        if rc == 1:  # exit 1 with error output: a crashed probe posing as "not yet"
+            rc, rc_col = f"exit 1 with error output: {output_error(out)}", 1
         if fails >= BROKEN_AFTER:
             return _wake(conn, task_id, BROKEN_EVENT, {
                 "wake_check": cmd, "rc": rc, "fails": fails, "output": tail,
diff --git a/tests/hermes_cli/test_kanban_wake_check.py b/tests/hermes_cli/test_kanban_wake_check.py
index aff9d64625..323784cbc6 100644
--- a/tests/hermes_cli/test_kanban_wake_check.py
+++ b/tests/hermes_cli/test_kanban_wake_check.py
@@ -362,3 +362,88 @@ def test_diagnostics_flag_clock_parks_and_failing_probes(kanban_home) -> None:
             conn.execute("UPDATE task_wake_checks SET last_rc = 1, fails = 0 WHERE task_id = ?", (failing,))
         states = kwc.load_states(conn)
         assert "wake_check_overdue" in kinds(failing, now=states[failing]["next_at"] + 3600)
+
+
+# --- silent forever-waits (t_1132a78a) -----------------------------------------------------
+
+def test_dry_run_rejects_probes_that_can_never_succeed():
+    assert kwc.dry_run_error("exit 0") is None
+    assert kwc.dry_run_error("exit 1") is None
+    assert "exited 2" in kwc.dry_run_error("exit 2")
+    assert "exited 127" in kwc.dry_run_error("no_such_command_xyz")
+    # exit 1 with a traceback / shell syntax error / sqlite error is still broken
+    assert kwc.dry_run_error("echo 'OperationalError: incomplete input' >&2; exit 1")
+    assert kwc.dry_run_error("echo \"bash: -c: line 1: syntax error near unexpected token '('\"; exit 1")
+    assert kwc.dry_run_error("echo 'error: database is locked'; exit 1")
+    assert kwc.dry_run_error("echo 'task t_x running'; exit 1") is None
+
+
+def test_dry_run_can_be_disabled(monkeypatch):
+    monkeypatch.setenv("HERMES_KANBAN_WAKE_DRYRUN", "0")
+    assert kwc.dry_run_error("exit 2") is None
+
+
+def test_exit1_with_error_output_counts_as_failing_then_wakes_broken(kanban_home):
+    cmd = "echo 'Traceback (most recent call last):' ; exit 1"
+    with kbc.connect_closing() as conn:
+        tid = _running(conn)
+        assert kb.schedule_task(conn, tid, reason="SCHEDULED_UNTIL=2099-01-01T00:00:00Z",
+                                wake_check=cmd, check_every=120)
+        for i in range(kwc.BROKEN_AFTER):
+            state = kwc.get_state(conn, tid)
+            gen = state["generation"]
+            kwc.apply_result(conn, tid, cmd, 1, "Traceback (most recent call last):", generation=gen, now=1000 + i)
+            if i < kwc.BROKEN_AFTER - 1:
+                assert kwc.get_state(conn, tid)["fails"] == i + 1
+        assert _events(conn, tid, kwc.BROKEN_EVENT)
+
+
+def test_plain_exit1_is_still_not_yet(kanban_home):
+    cmd = "echo 'running'; exit 1"
+    with kbc.connect_closing() as conn:
+        tid = _running(conn)
+        assert kb.schedule_task(conn, tid, reason="SCHEDULED_UNTIL=2099-01-01T00:00:00Z",
+                                wake_check=cmd, check_every=120)
+        gen = kwc.get_state(conn, tid)["generation"]
+        kwc.apply_result(conn, tid, cmd, 1, "t_x running", generation=gen, now=1000)
+        assert kwc.get_state(conn, tid)["fails"] == 0
+
+
+def test_cli_park_rejects_broken_probe():
+    from hermes_cli.kanban import _cli_wake_check
+
+    ns = argparse.Namespace(wake_check="exit 2", check_every=None, clock_only=False)
+    with pytest.raises(ValueError, match="never succeed|could never"):
+        _cli_wake_check(ns)
+
+
+def test_wait_check_local(kanban_home):
+    from hermes_cli import kanban_wait_check as w
+
+    with kbc.connect_closing() as conn:
+        tid = _running(conn)
+    assert w.check_local("task", tid, until=("done",))[0] == 1
+    assert w.check_local("task", tid, until=("running",))[0] == 0
+    rc, msg = w.check_local("task", "t_missing")
+    assert rc == 2 and msg.startswith("error:")
+    assert w.check_local("board-empty", "default")[0] == 1
+
+
+def test_wait_check_remote_is_argv_safe(monkeypatch):
+    from hermes_cli import kanban_wait_check as w
+
+    seen = {}
+
+    class P:
+        returncode, stdout, stderr = 1, "t_x running", ""
+
+    def fake(argv, **kw):
+        seen["argv"] = argv
+        return P()
+
+    monkeypatch.setattr(w.subprocess, "run", fake)
+    assert w.check_remote("hub", "task", "t_x; rm -rf /", until=("done",))[0] == 1
+    assert seen["argv"][-2] == "ubuntu@hub.example.com"
+    assert "'t_x; rm -rf /'" in seen["argv"][-1]
+    P.returncode, P.stdout = 255, ""
+    assert w.check_remote("hub", "task", "t_x")[0] == 2
