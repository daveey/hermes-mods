+class _BudgetDeadline(_Deadline):
+    """The resolver's materialize budget in the publisher's proof-deadline shape."""
+
+    def __init__(self, bound):
+        self.bound = bound
+
+    def left(self, cap: float = 60.0) -> float:
+        return min(self.bound.left(), cap)
+
