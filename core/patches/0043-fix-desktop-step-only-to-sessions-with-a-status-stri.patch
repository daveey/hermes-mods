The needs-you filter matched dot states unread / needs-input, but since the
stripe change a read session with a finished turn (idle + messages) is still
green. With no unread rows the filter found nothing and fell back to the plain
neighbour, landing on unstriped rows. Eligibility is now sessionStatusStripe
(the stripe the row draws) and there is no fallback; archive → next keeps it.
---
diff --git a/apps/desktop/src/app/contrib/wiring.tsx b/apps/desktop/src/app/contrib/wiring.tsx
index 713eef3cfb1724ce145815d6c76a0e760b8152ea..99ed5fbed4943cee39c8787d110151fe55c9add2 100644
--- a/apps/desktop/src/app/contrib/wiring.tsx
+++ b/apps/desktop/src/app/contrib/wiring.tsx
@@ -993,7 +993,7 @@ export function ContribWiring({ children }: { children: ReactNode }) {
   const openNewSessionTab = useCallback(() => openNewSessionTabAction(openNewSessionTile), [openNewSessionTile])
 
   // Archive the selected session (rebindable `session.archive` hotkey), then
-  // step to the next sidebar session exactly like ⌘] (needs-you first, else
+  // step to the next sidebar session like ⌘] (status-striped first, else
   // the plain neighbour) instead of dropping to a fresh draft. The target is
   // computed BEFORE the row leaves the sidebar so its position is still known.
   const archiveSelectedSession = useCallback(() => {
@@ -1004,7 +1004,7 @@ export function ContribWiring({ children }: { children: ReactNode }) {
       return
     }
 
-    const next = nextSidebarSessionId(sessionId, 1, false)
+    const next = nextSidebarSessionId(sessionId, 1, false, true)
     const onDeselect = next && next !== sessionId ? () => openSession(next, navigate) : undefined
 
     void archiveSession(sessionId, { onDeselect })
diff --git a/apps/desktop/src/store/sidebar-visible-order.test.ts b/apps/desktop/src/store/sidebar-visible-order.test.ts
index 656352194f9f13908307e826d86d8aa9c269fb5b..84c94166c9b9aabdaab9ac3708278b85daf9bf96 100644
--- a/apps/desktop/src/store/sidebar-visible-order.test.ts
+++ b/apps/desktop/src/store/sidebar-visible-order.test.ts
@@ -1,6 +1,21 @@
-import { afterEach, describe, expect, it } from 'vitest'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import type * as DotStateModule from './session-dot-state'
+import type { SessionDotState } from './session-dot-state'
+
+const dots = vi.hoisted(() => ({ value: {} as Record<string, SessionDotState> }))
+
+vi.mock('@/store/session-dot-state', async importOriginal => {
+  const real = await importOriginal<typeof DotStateModule>()
+  const { atom: mkAtom } = await import('nanostores')
+  const $dots = mkAtom<Record<string, SessionDotState>>({})
+  $dots.get = () => dots.value
+
+  return { ...real, $sessionDotStateById: $dots }
+})
 
 import {
+  nextSidebarSessionId,
   publishSidebarSection,
   sidebarSessionOrder,
   stepSessionId,
@@ -100,3 +115,49 @@ describe('sidebarSessionOrder', () => {
     expect(sidebarSessionOrder()).not.toContain('x')
   })
 })
+
+describe('nextSidebarSessionId (⌘] / ⌘[)', () => {
+  const key = Symbol('recents')
+
+  afterEach(() => {
+    unpublishSidebarSection(key)
+    dots.value = {}
+    document.body.innerHTML = ''
+  })
+
+  // a: green (read, finished turn)  b: no stripe (no turns)  c: working
+  // d: red (blocked)  e: green (unread)
+  function setup() {
+    const anchor = document.createElement('span')
+    document.body.append(anchor)
+    publishSidebarSection(key, {
+      anchor,
+      ids: ['a', 'b', 'c', 'd', 'e'],
+      turnIds: ['a', 'c', 'd', 'e'],
+      virtualized: true
+    })
+    dots.value = { a: 'idle', b: 'idle', c: 'working', d: 'needs-input', e: 'unread' }
+  }
+
+  it('lands only on rows with a status stripe, including read-but-finished (green) ones', () => {
+    setup()
+    expect(nextSidebarSessionId('e', 1, false)).toBe('a') // wraps; idle + turns = green
+    expect(nextSidebarSessionId('a', 1, false)).toBe('d') // skips b (no turns) and c (working)
+    expect(nextSidebarSessionId('d', -1, false)).toBe('a')
+    expect(nextSidebarSessionId('a', -1, false)).toBe('e')
+  })
+
+  it('does not fall back to an unstriped neighbour when nothing else has a stripe', () => {
+    setup()
+    dots.value = { a: 'idle', b: 'idle', c: 'working', d: 'working', e: 'working' }
+    expect(nextSidebarSessionId('a', 1, false)).toBeNull()
+    expect(nextSidebarSessionId('a', -1, false)).toBeNull()
+  })
+
+  it('archive fallback and ⇧ still take the plain neighbour', () => {
+    setup()
+    dots.value = { a: 'idle', b: 'idle', c: 'working', d: 'working', e: 'working' }
+    expect(nextSidebarSessionId('a', 1, false, true)).toBe('b')
+    expect(nextSidebarSessionId('a', 1, true)).toBe('b')
+  })
+})
diff --git a/apps/desktop/src/store/sidebar-visible-order.ts b/apps/desktop/src/store/sidebar-visible-order.ts
index 1bd3872b5c43843bd20f783f771ddf97cc9db707..9ad56e833cfc97d8f548333cc3bd86f1fa040aa0 100644
--- a/apps/desktop/src/store/sidebar-visible-order.ts
+++ b/apps/desktop/src/store/sidebar-visible-order.ts
@@ -1,5 +1,5 @@
 import { $sessions } from '@/store/session'
-import { $sessionDotStateById, type SessionDotState } from '@/store/session-dot-state'
+import { $sessionDotStateById, sessionStatusStripe } from '@/store/session-dot-state'
 
 // The sidebar's session order as the user sees it, for ⌘] / ⌘[ stepping.
 // Each rendered SessionsSection (pinned, recents, …) publishes the ids of its
@@ -13,6 +13,9 @@ import { $sessionDotStateById, type SessionDotState } from '@/store/session-dot-
 interface SectionEntry {
   anchor: HTMLElement | null
   ids: readonly string[]
+  /** Ids of this section's rows that have at least one message (the status
+   *  stripe's `hasTurns`), so stepping can match the stripe the row draws. */
+  turnIds?: readonly string[]
   virtualized?: boolean
 }
 
@@ -73,9 +76,26 @@ export function sidebarSessionOrder(): string[] {
   return ids.length ? ids : $sessions.get().map(session => session.id)
 }
 
-/** The sidebar dot states that mean "waiting on you": a blocking prompt
- *  (amber) or a finished, unread turn. */
-export const NEEDS_YOU_STATES: ReadonlySet<SessionDotState> = new Set(['needs-input', 'unread'])
+/** Whether a sidebar row shows a status stripe — green (finished, waiting on
+ *  you) or red (blocked / stalled). ⌘] / ⌘[ step only to these, so they land
+ *  exactly where the sidebar shows a coloured bar. */
+export function sessionHasStatusStripe(id: string): boolean {
+  let hasTurns = false
+
+  for (const entry of sections.values()) {
+    if (entry.turnIds?.includes(id)) {
+      hasTurns = true
+
+      break
+    }
+  }
+
+  if (!hasTurns) {
+    hasTurns = ($sessions.get().find(session => session.id === id)?.message_count ?? 0) > 0
+  }
+
+  return sessionStatusStripe($sessionDotStateById.get()[id] ?? 'idle', hasTurns) !== null
+}
 
 /**
  * The session `direction` steps from `currentId` in `order`, wrapping. With
@@ -108,19 +128,22 @@ export function stepSessionId(
   return null
 }
 
-/** ⌘] / ⌘[: next session that needs you, else the plain next one. ⇧ skips
- *  the needs-you filter. */
-export function nextSidebarSessionId(currentId: null | string, direction: 1 | -1, anySession: boolean): null | string {
+/** ⌘] / ⌘[: next session with a status stripe (green / red); null when none
+ *  has one. ⇧ (`anySession`) steps to the plain neighbour. `fallbackToAny`
+ *  (archive → next) takes the plain neighbour when no row has a stripe. */
+export function nextSidebarSessionId(
+  currentId: null | string,
+  direction: 1 | -1,
+  anySession: boolean,
+  fallbackToAny = false
+): null | string {
   const order = sidebarSessionOrder()
 
-  if (!anySession) {
-    const dots = $sessionDotStateById.get()
-    const needing = stepSessionId(order, currentId, direction, id => NEEDS_YOU_STATES.has(dots[id] ?? 'idle'))
-
-    if (needing) {
-      return needing
-    }
+  if (anySession) {
+    return stepSessionId(order, currentId, direction)
   }
 
-  return stepSessionId(order, currentId, direction)
+  const striped = stepSessionId(order, currentId, direction, sessionHasStatusStripe)
+
+  return striped ?? (fallbackToAny ? stepSessionId(order, currentId, direction) : null)
 }
