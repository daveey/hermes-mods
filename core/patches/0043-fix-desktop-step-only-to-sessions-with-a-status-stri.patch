 apps/desktop/src/app/contrib/wiring.tsx       |  4 +-
 .../src/store/sidebar-visible-order.test.ts   | 63 ++++++++++++++++++-
 .../src/store/sidebar-visible-order.ts        | 53 +++++++++++-----
 4 files changed, 107 insertions(+), 18 deletions(-)

diff --git a/apps/desktop/src/app/chat/sidebar/sessions-section.tsx b/apps/desktop/src/app/chat/sidebar/sessions-section.tsx
index 35f8dfa66e..0ded2e7fe3 100644
--- a/apps/desktop/src/app/chat/sidebar/sessions-section.tsx
+++ b/apps/desktop/src/app/chat/sidebar/sessions-section.tsx
@@ -488,6 +488,11 @@ export function SidebarSessionsSection({
     publishSidebarSection(orderKey, {
       anchor: orderAnchorRef.current,
       ids: sectionOpen ? visibleRows.flatMap(row => (row.kind === 'session' ? [row.entry.session.id] : [])) : [],
+      turnIds: sectionOpen
+        ? visibleRows.flatMap(row =>
+            row.kind === 'session' && row.entry.session.message_count > 0 ? [row.entry.session.id] : []
+          )
+        : [],
       virtualized: flatVirtualized
     })
   }, [flatVirtualized, orderKey, sectionOpen, visibleRows])
diff --git a/apps/desktop/src/app/contrib/wiring.tsx b/apps/desktop/src/app/contrib/wiring.tsx
index 4099a86683..44b675a377 100644
--- a/apps/desktop/src/app/contrib/wiring.tsx
+++ b/apps/desktop/src/app/contrib/wiring.tsx
@@ -1005,7 +1005,7 @@ export function ContribWiring({ children }: { children: ReactNode }) {
   }, [openNewSessionTile])
 
   // Archive the selected session (rebindable `session.archive` hotkey), then
-  // step to the next sidebar session exactly like ⌘] (needs-you first, else
+  // step to the next sidebar session like ⌘] (status-striped first, else
   // the plain neighbour) instead of dropping to a fresh draft. The target is
   // computed BEFORE the row leaves the sidebar so its position is still known.
   const archiveSelectedSession = useCallback(() => {
@@ -1016,7 +1016,7 @@ export function ContribWiring({ children }: { children: ReactNode }) {
       return
     }
 
-    const next = nextSidebarSessionId(sessionId, 1, false)
+    const next = nextSidebarSessionId(sessionId, 1, false, true)
     const onDeselect = next && next !== sessionId ? () => openSession(next, navigate) : undefined
 
     void archiveSession(sessionId, { onDeselect })
diff --git a/apps/desktop/src/store/sidebar-visible-order.test.ts b/apps/desktop/src/store/sidebar-visible-order.test.ts
index 656352194f..84c94166c9 100644
--- a/apps/desktop/src/store/sidebar-visible-order.test.ts
+++ b/apps/desktop/src/store/sidebar-visible-order.test.ts
@@ -1,6 +1,21 @@
-import { afterEach, describe, expect, it } from 'vitest'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import type * as DotStateModule from './session-dot-state'
+import type { SessionDotState } from './session-dot-state'
+
+const dots = vi.hoisted(() => ({ value: {} as Record<string, SessionDotState> }))
+
+vi.mock('@/store/session-dot-state', async importOriginal => {
+  const real = await importOriginal<typeof DotStateModule>()
+  const { atom: mkAtom } = await import('nanostores')
+  const $dots = mkAtom<Record<string, SessionDotState>>({})
+  $dots.get = () => dots.value
+
+  return { ...real, $sessionDotStateById: $dots }
+})
 
 import {
+  nextSidebarSessionId,
   publishSidebarSection,
   sidebarSessionOrder,
   stepSessionId,
@@ -100,3 +115,49 @@ describe('sidebarSessionOrder', () => {
     expect(sidebarSessionOrder()).not.toContain('x')
   })
 })
+
+describe('nextSidebarSessionId (⌘] / ⌘[)', () => {
+  const key = Symbol('recents')
+
+  afterEach(() => {
+    unpublishSidebarSection(key)
+    dots.value = {}
+    document.body.innerHTML = ''
+  })
+
+  // a: green (read, finished turn)  b: no stripe (no turns)  c: working
+  // d: red (blocked)  e: green (unread)
+  function setup() {
+    const anchor = document.createElement('span')
+    document.body.append(anchor)
+    publishSidebarSection(key, {
+      anchor,
+      ids: ['a', 'b', 'c', 'd', 'e'],
+      turnIds: ['a', 'c', 'd', 'e'],
+      virtualized: true
+    })
+    dots.value = { a: 'idle', b: 'idle', c: 'working', d: 'needs-input', e: 'unread' }
+  }
+
+  it('lands only on rows with a status stripe, including read-but-finished (green) ones', () => {
+    setup()
+    expect(nextSidebarSessionId('e', 1, false)).toBe('a') // wraps; idle + turns = green
+    expect(nextSidebarSessionId('a', 1, false)).toBe('d') // skips b (no turns) and c (working)
+    expect(nextSidebarSessionId('d', -1, false)).toBe('a')
+    expect(nextSidebarSessionId('a', -1, false)).toBe('e')
+  })
+
+  it('does not fall back to an unstriped neighbour when nothing else has a stripe', () => {
+    setup()
+    dots.value = { a: 'idle', b: 'idle', c: 'working', d: 'working', e: 'working' }
+    expect(nextSidebarSessionId('a', 1, false)).toBeNull()
+    expect(nextSidebarSessionId('a', -1, false)).toBeNull()
+  })
+
+  it('archive fallback and ⇧ still take the plain neighbour', () => {
+    setup()
+    dots.value = { a: 'idle', b: 'idle', c: 'working', d: 'working', e: 'working' }
+    expect(nextSidebarSessionId('a', 1, false, true)).toBe('b')
+    expect(nextSidebarSessionId('a', 1, true)).toBe('b')
+  })
+})
diff --git a/apps/desktop/src/store/sidebar-visible-order.ts b/apps/desktop/src/store/sidebar-visible-order.ts
index 1bd3872b5c..9ad56e833c 100644
--- a/apps/desktop/src/store/sidebar-visible-order.ts
