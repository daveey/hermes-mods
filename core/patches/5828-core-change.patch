From 314d166ca7bc43dbf9464e83c91df06201ad9ba7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 00:19:43 +0000
Subject: [PATCH] [daveey] links tickets: lock ticket allocation, correct
 _store_links docstring (review nits)

Co-Authored-By: Contributor <contributor@example.com>
---
 hermes_cli/kanban_links_tickets.py    | 5 ++++-
 hermes_cli/kanban_session_activity.py | 2 +-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_links_tickets.py b/hermes_cli/kanban_links_tickets.py
index 6b151b2e3b..3e4260568b 100644
--- a/hermes_cli/kanban_links_tickets.py
+++ b/hermes_cli/kanban_links_tickets.py
@@ -8,6 +8,7 @@ Without this, on a board written every few seconds each reader queued on ``_link
 observation window, many strict projections took seconds of wall each, the lock was held most of the time and Desktop user-steps
 polls timing out behind it while the hub sat idle. ``publish``/``answers``/``reset`` run under ``_links_lock``."""
 import itertools
+import threading
 from typing import Callable
 
 from hermes_cli import kanban_links_narrow as _links_narrow
@@ -17,11 +18,13 @@ class StartTickets:
     def __init__(self, clock: Callable[[], float]):
         self._clock = clock  # the owner's monotonic clock, looked up per call (tests replace it)
         self._tickets = itertools.count(1)
+        self._take_lock = threading.Lock()  # next() on count is atomic only under the GIL
         self._started: dict[tuple, int] = {}
 
     def take(self) -> int:
         """A reader's arrival or a projection's start; strictly increasing across threads."""
-        return next(self._tickets)
+        with self._take_lock:
+            return next(self._tickets)
 
     def publish(self, scope: tuple, started: int, live_scopes) -> None:
         """``scope``'s cached projection is now the one that took ``started``; forget scopes the cache evicted."""
diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index 5efe5c9d5c..6ec5bb8038 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -994,7 +994,7 @@ def _publish_links(scope: tuple, fingerprint: tuple) -> tuple:
 
 def _store_links(scope: tuple, fingerprint: tuple) -> tuple:
     """Project and publish (caller holds ``_links_lock``); returns the published entry. ``fingerprint`` is taken
-    before projecting, so a store change during the projection leaves the cache stale and triggers another rebuild."""
+    before projecting: a store change during it leaves the entry stale for readers arriving after it started."""
     global _links_cache
     started = _links_tickets.take()
     _origin_rows_sink.rows = []
-- 
