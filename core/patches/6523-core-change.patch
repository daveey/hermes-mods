+# c ---------------------------------------------------------------------------------------------------------
+@pytest.mark.parametrize("conclusion", ["failure", "cancelled", "timed_out"])
+def test_c_widened_then_another_run_fails_wakes_at_once(kanban_home, api, clock, conclusion):
