From 4c1f163efa103b6fc3126f41aefa68b5be3aa475 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 23:41:29 +0000
Subject: [PATCH] [daveey] Read scratch payload manifests with BOM-safe
 encoding

---
 hermes_cli/kanban_scratch_archive.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_scratch_archive.py b/hermes_cli/kanban_scratch_archive.py
index 73f68174510..6d9302e9e75 100644
--- a/hermes_cli/kanban_scratch_archive.py
+++ b/hermes_cli/kanban_scratch_archive.py
@@ -354,7 +354,7 @@ def verify_complete_archive(archive: Path) -> dict:
     """Re-read the payload and prove it matches its manifest; raise :class:`ArchiveRefused` if not."""
     base = Path(archive) / PAYLOAD_DIR
     try:
-        manifest = json.loads((base / _MANIFEST).read_text(encoding="utf-8"))
+        manifest = json.loads((base / _MANIFEST).read_text(encoding="utf-8-sig"))
         if manifest.get("version") != PAYLOAD_VERSION:
             raise ArchiveRefused(f"unsupported payload version {manifest.get('version')!r}")
         if _sha256_file(base / _TREE) != manifest["tree_sha256"]:
