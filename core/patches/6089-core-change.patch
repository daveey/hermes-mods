From 79e8e67c39d0702e9cc0b0393603aaf160676dee Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 24 Nov 2026 06:26:01 +0000
Subject: [PATCH 6089] Early native-sessions capture at serve boot and update-admission hold

Public mirror of source commit 79e8e67c39d0702e9cc0b0393603aaf160676dee.

---
diff --git a/hermes_cli/sessions_early_boot.py b/hermes_cli/sessions_early_boot.py
index c315d0e8951..370f07d3456 100644
--- a/hermes_cli/sessions_early_boot.py
+++ b/hermes_cli/sessions_early_boot.py
@@ -3,6 +3,7 @@
 import os
 import signal
 import sys
+import threading
 
 
 class EarlySessions:
@@ -57,15 +58,26 @@
             raise SystemExit(128 + signum)
 
     try:
-        for signum in (signal.SIGTERM, signal.SIGINT):
-            previous[signum] = signal.signal(signum, stop)
+        # signal.signal is illegal off the main thread (serve_update_wait and
+        # other cmd_dashboard harnesses). CPython delivers signals to the main
+        # thread anyway, so skip rather than abort capture.
+        if threading.current_thread() is threading.main_thread():
+            for signum in (signal.SIGTERM, signal.SIGINT):
+                try:
+                    previous[signum] = signal.signal(signum, stop)
+                except (ValueError, OSError, RuntimeError):
+                    previous.pop(signum, None)
         owner.runtime.start_background()
         yield owner
     finally:
         try:
             owner.close()
         finally:
-            for signum, handler in previous.items():
-                # Do not remove a later installed exit-flush handler.
-                if signal.getsignal(signum) is stop:
-                    signal.signal(signum, handler)
+            if previous and threading.current_thread() is threading.main_thread():
+                for signum, handler in previous.items():
+                    # Do not remove a later installed exit-flush handler.
+                    try:
+                        if signal.getsignal(signum) is stop:
+                            signal.signal(signum, handler)
+                    except (ValueError, OSError, RuntimeError):
+                        pass
diff --git a/tests/hermes_cli/test_sessions_early_boot.py b/tests/hermes_cli/test_sessions_early_boot.py
index 897f2226124..ddfd4c08038 100644
--- a/tests/hermes_cli/test_sessions_early_boot.py
+++ b/tests/hermes_cli/test_sessions_early_boot.py
@@ -1,6 +1,7 @@
 """Early capture keeps one owner through import failures and app adoption."""
 from types import SimpleNamespace
 import signal
+import threading
 
 from fastapi import FastAPI
 import pytest
@@ -94,6 +95,32 @@
         signal.signal(signal.SIGINT, original)
 
 
+def test_worker_thread_skips_signal_install_and_still_starts(boot):
+    calls, runtime = boot
+    original_term = signal.getsignal(signal.SIGTERM)
+    original_int = signal.getsignal(signal.SIGINT)
+    result = {}
+
+    def run():
+        with early.early_sessions(headless=True, isolated=True) as owner:
+            assert owner is not None
+            result['owner'] = owner
+            result['term'] = signal.getsignal(signal.SIGTERM)
+            result['int'] = signal.getsignal(signal.SIGINT)
+            assert owner.adopt() is runtime
+
+    thread = threading.Thread(target=run)
+    thread.start()
+    thread.join(5)
+    assert not thread.is_alive()
+    assert result.get('owner') is not None
+    assert result['term'] is original_term
+    assert result['int'] is original_int
+    assert signal.getsignal(signal.SIGTERM) is original_term
+    assert signal.getsignal(signal.SIGINT) is original_int
+    assert calls.count('start') == calls.count('close') == 1
+
+
 def test_failed_drain_retains_owner():
     calls = []
     def close():
