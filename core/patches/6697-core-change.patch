From 1640d761fb511f7b702981d08adec3475a4d3ff1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 27 Nov 2026 05:05:50 +0000
Subject: [PATCH 6697] Hot-path read-cost reductions (SQLite hand-offs, request coalescing, memoization)

Public mirror of source commit 1640d761fb511f7b702981d08adec3475a4d3ff1.

---
diff --git a/tests/hermes_cli/test_kanban_external_activity.py b/tests/hermes_cli/test_kanban_external_activity.py
index fee2fbd009c6070b848f197f3eeaa8707086e77b..735a388114a7a20d023bb82fff627fa0b22be253 100644
--- a/tests/hermes_cli/test_kanban_external_activity.py
+++ b/tests/hermes_cli/test_kanban_external_activity.py
@@ -297,10 +297,13 @@
         stamp, opens = _counting(monkeypatch, conn)
         with kea.one_board_read():
             stamp([{"id": "s1"}])
+            # A commit before the inner block: were the inner block to start its own read set,
+            # the moved signature would force a second open here.
+            _session_card(conn, "s1")
             with kea.one_board_read():
                 stamp([{"id": "s1"}])
             stamp([{"id": "s1"}])  # the inner block's end does not drop the outer one's read
-            assert len(opens) == 1
+            assert len(opens) == 1, "a nested block shares the outer block's read"
             _session_card(conn, "s1")
             worker = threading.Thread(target=lambda: stamp([{"id": "s1"}]))
             worker.start()
diff --git a/tests/hermes_cli/test_turn_session_activity.py b/tests/hermes_cli/test_turn_session_activity.py
index 118aca769d5e7982b2b15b89b203a54a7c42bbcf..1994e583b2324c732d97c43bf3a99ded673a51fd 100644
--- a/tests/hermes_cli/test_turn_session_activity.py
+++ b/tests/hermes_cli/test_turn_session_activity.py
@@ -479,7 +479,14 @@
     now = time.time()
     work = home / "profiles" / "work" / "state.db"
     _leases(work, [("p", _holder(os.getpid(), "p"), now - 5, now + 600)])
-    assert "p" in tsa._collect(now)
+    keeper = sqlite3.connect(work)
+    keeper.execute("PRAGMA journal_mode=WAL")
+    keeper.execute("SELECT * FROM session_turn_leases").fetchall()  # initialize the WAL index
+    try:
+        assert "p" in tsa._collect(now)
+        assert work in tsa._store_reads, "a WAL store with a known stamp is retained"
+    finally:
+        keeper.close()
     for suffix in ("", "-wal", "-shm"):
         (work.parent / f"state.db{suffix}").unlink(missing_ok=True)
     assert "p" not in tsa._collect(now + 1)
-- 
