+    monkeypatch.setattr(provenance, "_discover_homes", lambda profile: [tmp_path / str(profile)])
+    assert _replays({("homes", "p"): (str(tmp_path / "p"),)})
+    assert not _replays({("homes", "p"): (str(tmp_path / "q"),)})
