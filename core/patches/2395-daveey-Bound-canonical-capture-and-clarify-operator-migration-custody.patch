--- a/tests/hermes_cli/test_kanban_priority_global.py
+++ b/tests/hermes_cli/test_kanban_priority_global.py
@@ -42,3 +42,15 @@ def test_global_plan_reserves_exception_bands_and_records_terminal_resolution():
         {"id": "operator", "status": "ready", "origin": "one", "old": 20002},
     ]
     assert "earlier" not in by_id
+
+
+def test_both_open_exceptions_keep_requested_order_above_ordinary():
+    rows = [
+        {"id": "ordinary", "priority": 90000, "created_on": "one", "status": "ready"},
+        {"id": "earlier", "priority": 50000, "created_on": "two", "status": "blocked"},
+        {"id": "operator", "priority": 20002, "created_on": "one", "status": "running"},
+    ]
+    plan = migration.plan_global(rows, board_id="board", exceptions=["earlier", "operator"])
+    by_id = {row["id"]: row for row in plan["rows"]}
+    assert 0 < by_id["ordinary"]["new"] < by_id["earlier"]["new"] < by_id["operator"]["new"] == 900
+    assert [row["old"] for row in plan["exceptions"]] == [50000, 20002]
diff --git a/tests/hermes_cli/test_kanban_priority_page_limit.py b/tests/hermes_cli/test_kanban_priority_page_limit.py
new file mode 100644
index 00000000000..5fe412862ef
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_priority_page_limit.py
@@ -0,0 +1,22 @@
+"""Bounded canonical capture must reject endlessly advancing snapshots."""
+import pytest
+
+from hermes_cli import kanban_priority_prepare as prepare
+
+
+class EndlessSnapshot:
+    def __init__(self):
+        self.calls = 0
+
+    def snapshot_page(self, board, table, **kwargs):
+        self.calls += 1
+        key = f'{self.calls:08d}'
+        return {'table': 'tasks', 'head': 1, 'more': True, 'next': key,
+                'rows': [{'id': key, 'status': 'ready', 'created_on': 'one', 'priority': 1}]}
+
+
+def test_capture_rejects_page_limit_before_returning_partial_inventory():
+    hub = EndlessSnapshot()
+    with pytest.raises(ValueError, match='snapshot page limit exceeded'):
+        prepare.capture(hub, board_id='board', exceptions=[])
+    assert hub.calls == 10000
