From f20002ce0f6527bdb9c87298013785da81868b05 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 22:20:39 +0000
Subject: [PATCH] fix(kanban): retain portable DB-only fairness capture
 [daveey]

The runtime capture budget added by #3687 made the existing DB-only CLI
require Unix fcntl and O_DIRECTORY. Keep runtime capture fail-closed on
unsupported platforms, but use Windows msvcrt byte-range advisory locking
for DB capture budget writes. Preserve file fsync and atomic replacement;
only directory fsync is unavailable on Windows.

Exercise arm/status/drain/seal/clear through the real DB CLI with isolated
Windows-style budget primitives, plus budget overflow and release. RED on
prior budget source (ValueError), GREEN after the portable path. All five
budget importing test files included in combined fairness gate, which passes
twice. This is simulated platform proof, not a native Windows execution.

Also prove recovery after the real post-commit OSError/KeyboardInterrupt:
status works with the retained plan and explicit --replace arms again.
Fifty fresh-process repetitions of the reported seal-timeout test pass;
no captured failure to justify changing that pre-existing test.
---
 hermes_cli/kanban_fairness_budget.py          | 21 +++++--
 .../test_kanban_fairness_arm_rollback.py      |  7 +++
 .../test_kanban_fairness_budget_portable.py   | 60 +++++++++++++++++++
 3 files changed, 84 insertions(+), 4 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_fairness_budget_portable.py

diff --git a/hermes_cli/kanban_fairness_budget.py b/hermes_cli/kanban_fairness_budget.py
index 70b5b28344..bec0c94077 100644
--- a/hermes_cli/kanban_fairness_budget.py
+++ b/hermes_cli/kanban_fairness_budget.py
@@ -24,16 +24,26 @@ class BudgetExceeded(ValueError):
 def _locked(root):
     try:
         import fcntl
-    except ImportError as exc:
-        raise ValueError("capture budget requires advisory file locking") from exc
+        def lock(stream, acquire):
+            fcntl.flock(stream.fileno(), fcntl.LOCK_EX if acquire else fcntl.LOCK_UN)
+    except ImportError:
+        try:
+            import msvcrt
+        except ImportError as exc:
+            raise ValueError("capture budget requires advisory file locking") from exc
+        def lock(stream, acquire):
+            # Windows locks a byte range from the current position; seeking is
+            # required on both acquisition and release, including an empty file.
+            stream.seek(0)
+            msvcrt.locking(stream.fileno(), msvcrt.LK_LOCK if acquire else msvcrt.LK_UNLCK, 1)
     if (root / ".capture-budget.lock").is_symlink():
         raise ValueError("budget lock must not be a symlink")
     with (root / ".capture-budget.lock").open("a+b") as stream:
-        fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
+        lock(stream, True)
         try:
             yield
         finally:
-            fcntl.flock(stream.fileno(), fcntl.LOCK_UN)
+            lock(stream, False)
 
 
 def _used(root):
@@ -101,6 +111,9 @@ def _write(path, data):
         stream.flush()
         os.fsync(stream.fileno())
     os.replace(tmp, path)
+    if not hasattr(os, "O_DIRECTORY"):
+        # Windows supports file fsync + atomic replacement, not directory fsync.
+        return
     directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
     try:
         os.fsync(directory)
diff --git a/tests/hermes_cli/test_kanban_fairness_arm_rollback.py b/tests/hermes_cli/test_kanban_fairness_arm_rollback.py
index a89d1a8143..968efbcc8b 100644
--- a/tests/hermes_cli/test_kanban_fairness_arm_rollback.py
+++ b/tests/hermes_cli/test_kanban_fairness_arm_rollback.py
@@ -93,6 +93,7 @@ def test_post_commit_failure_keeps_committed_plan(db, tmp_path, monkeypatch, err
     def fail_status(conn):
         raise error("after commit")
 
