Subject: [PATCH 439/453] fix(kanban): preserve crash recovery for scope-killed
 workers [daveey]

(cherry picked from commit 4553b4f464cb2035234d16a9a22cc02af218411d)
---
 hermes_cli/kanban_continuation.py             |  2 +-
 hermes_cli/kanban_db_dispatch.py              |  4 +-
 hermes_cli/kanban_diagnostics.py              | 13 ++--
 hermes_cli/kanban_model_tier.py               |  2 +-
 hermes_cli/kanban_shared_blockers.py          |  2 +-
 .../test_kanban_crash_outcome_consumers.py    | 77 +++++++++++++++++++
 6 files changed, 89 insertions(+), 11 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_crash_outcome_consumers.py

diff --git a/hermes_cli/kanban_continuation.py b/hermes_cli/kanban_continuation.py
index ca5bd3c880..35ec5b97c0 100644
--- a/hermes_cli/kanban_continuation.py
+++ b/hermes_cli/kanban_continuation.py
@@ -74,7 +74,7 @@ def consecutive_continuations(conn: sqlite3.Connection, task_id: str) -> int:
         outcome = row[0]
         if outcome == CONTINUED_OUTCOME:
             count += 1
-        elif outcome in ("timed_out", "crashed", "reclaimed", "rate_limited"):
+        elif outcome in ("timed_out", "crashed", "oom_killed", "signaled", "reclaimed", "rate_limited"):
             continue
         else:
             break
diff --git a/hermes_cli/kanban_db_dispatch.py b/hermes_cli/kanban_db_dispatch.py
index 7a7618793b..6af5685ea1 100644
--- a/hermes_cli/kanban_db_dispatch.py
+++ b/hermes_cli/kanban_db_dispatch.py
@@ -1728,7 +1728,7 @@ def check_respawn_guard(
     #     ``blocker_auth``. Same cooldown, measured from the latest run's end; once
     #     it has elapsed the stamp is dropped and the card retries. (2026-10-23:
     #     six cards blocked ``capability`` for 13 h on a cleared quota wall.) [daveey]
-    if err and latest_outcome != "crashed" and not _is_completion_gate_error(err) and _kbq.is_quota_error(err):
+    if err and latest_outcome not in {"crashed", "oom_killed", "signaled"} and not _is_completion_gate_error(err) and _kbq.is_quota_error(err):
         ended_at = _kb._to_epoch(latest_run["ended_at"]) if latest_run is not None else None
         if rl_cooldown > 0 and ended_at is not None and (now - ended_at) < rl_cooldown:
             return "rate_limit_cooldown"
@@ -1739,7 +1739,7 @@ def check_respawn_guard(
     # crash is different: its persisted error includes the worker's last
     # captured output, which is context rather than a diagnosis and may contain
     # benign commands such as ``claude auth status`` (#117097).
-    if (err and latest_outcome != "crashed" and not _is_completion_gate_error(err)
+    if (err and latest_outcome not in {"crashed", "oom_killed", "signaled"} and not _is_completion_gate_error(err)
             and _RESPAWN_BLOCKER_RE.search(err)):
         return "blocker_auth"
 
diff --git a/hermes_cli/kanban_diagnostics.py b/hermes_cli/kanban_diagnostics.py
index b358c4a218..a138c28280 100644
--- a/hermes_cli/kanban_diagnostics.py
+++ b/hermes_cli/kanban_diagnostics.py
@@ -377,7 +377,8 @@ def _failure_threshold(cfg: dict) -> Any:
     return cfg.get("failure_threshold", cfg.get("spawn_failure_threshold", 3))
 
 
-_OUTCOME_LABELS = {"spawn_failed": "spawn", "timed_out": "timeout", "crashed": "crash"}
+_OUTCOME_LABELS = {"spawn_failed": "spawn", "timed_out": "timeout", "crashed": "crash",
+                   "oom_killed": "OOM kill", "signaled": "signal kill"}
 
 
 def _rule_repeated_failures(task, events, runs, now, cfg) -> list[Diagnostic]:
@@ -406,7 +407,7 @@ def _rule_repeated_failures(task, events, runs, now, cfg) -> list[Diagnostic]:
     # Most recent failure outcome makes the title/action specific.
     most_recent_outcome = next(
         (oc for oc in (_task_field(r, "outcome") for r in _runs_newest_first(runs))
-         if oc in {"spawn_failed", "timed_out", "crashed"}),
+         if oc in _OUTCOME_LABELS),
         None,
     )
 
@@ -416,7 +417,7 @@ def _rule_repeated_failures(task, events, runs, now, cfg) -> list[Diagnostic]:
         doctor, auth = f"hermes -p {assignee} doctor", f"hermes -p {assignee} auth"
         actions.append(_cli_hint(f"Verify profile: {doctor}", doctor, suggested=True))
         actions.append(_cli_hint(f"Fix profile auth: {auth}", auth))
-    elif most_recent_outcome in {"timed_out", "crashed"}:
+    elif most_recent_outcome in {"timed_out", "crashed", "oom_killed", "signaled"}:
         # Worker got off the ground but died: logs diagnose, reclaim/reassign recover.
         task_id = _task_field(task, "id")
         if task_id:
@@ -484,7 +485,7 @@ def _rule_repeated_crashes(task, events, runs, now, cfg) -> list[Diagnostic]:
     last_err = None
     for r in _runs_newest_first(runs):
         outcome = _task_field(r, "outcome")
-        if outcome == "crashed":
+        if outcome in {"crashed", "oom_killed", "signaled"}:
             consecutive += 1
             if last_err is None:
                 last_err = _task_field(r, "error")
@@ -503,13 +504,13 @@ def _rule_repeated_crashes(task, events, runs, now, cfg) -> list[Diagnostic]:
     if err_snippet:
         title = f"Agent crashed {consecutive}x: {err_snippet.splitlines()[0][:160]}"
         detail = (
-            f"The last {consecutive} runs ended with outcome=crashed. "
+            f"The last {consecutive} runs crashed or were killed. "
             f"Full last error:\n\n{err_snippet}"
         )
     else:
         title = f"Agent crashed {consecutive}x (no error recorded)"
         detail = (
-            f"The last {consecutive} runs ended with outcome=crashed but "
+            f"The last {consecutive} runs crashed or were killed but "
             f"no error text was captured. Check the worker log for more."
         )
     return [Diagnostic(
