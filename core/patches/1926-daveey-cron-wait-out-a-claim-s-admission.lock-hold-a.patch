--- a/hermes_cli/admission_fence.py
+++ b/hermes_cli/admission_fence.py
@@ -138,12 +138,14 @@ def turns_waiting(root):
     return False
 
 
-def reserve(home):
+def reserve(home, *, timeout=0.05):
     import fcntl
 
     # Some callers hold the backend session-map lock. Absorb ordinary short
