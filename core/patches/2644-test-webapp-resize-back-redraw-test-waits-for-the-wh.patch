From 7e30a3cf4160514c72e6a2a0bbefff58d7d7266e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 11:15:33 +0000
Subject: [PATCH] test(webapp): resize-back redraw test waits for the whole
 READY line

The Python watcher's print('READY', flush=True) under -u is two writes:
'READY', then '\n'. When the test's reader took 'READY' alone (a starved
runner), it sent the resize pair while the newline was still unread. That
newline then counted as the program's answer to the first step, so the step
back went before the program read the size: both SIGWINCHes found 24 rows,
the watcher printed WINCH with no RESIZE, and the test failed with
`assert [] == [b'RESIZE 23', b'RESIZE 24']` (CI run 43197894812).

Wait for b"READY\r\n" so all output from before the step is consumed (the
session counts a chunk before it reaches the tab). Repro: delaying the
newline 0.5 s fails 3/3 before, passes 5/5 after.
---
 tests/hermes_cli/test_host_terminal_redraw.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_host_terminal_redraw.py b/tests/hermes_cli/test_host_terminal_redraw.py
index 21ef181171..54394ecc10 100644
--- a/tests/hermes_cli/test_host_terminal_redraw.py
+++ b/tests/hermes_cli/test_host_terminal_redraw.py
@@ -101,7 +101,9 @@ async def test_a_resize_back_waits_until_the_program_answered_the_step(tmp_path,
     await session.start()
     try:
         assert await session.attach(tab)
-        await async_wait_until(lambda: b"READY" in tab.output, timeout=10)
+        # The whole line: Python's print writes 'READY' and its newline separately, and a newline
+        # read after the step would count as the program's answer to it.
+        await async_wait_until(lambda: b"READY\r\n" in tab.output, timeout=60)
         start = len(tab.output)
         # The redraw's two frames, arriving together as they leave the browser.
         tab.send("\x1b[RESIZE:80;23]", "\x1b[RESIZE:80;24]")
