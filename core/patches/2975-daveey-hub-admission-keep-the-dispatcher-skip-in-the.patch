From d92d08b08a938d2d81501f33686b23325b42f905 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 11:13:45 +0000
Subject: [PATCH] [daveey] hub admission: keep the dispatcher skip in the pool
 queue note

The pool-census branch of local_words returned before main's dispatcher-skip line (7f90e373a01), so an opted-in hub's ready-wait note lost the skip reason (kanban-dd62aef001). Prefix the skip and use its advice unless it is an ordering skip.
---
 hermes_cli/kanban_queue_position.py           | 10 +++--
 tests/hermes_cli/test_kanban_hub_admission.py | 42 +++++++++++++++++++
 2 files changed, 49 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_queue_position.py b/hermes_cli/kanban_queue_position.py
index 58e3edf466..882167b2a7 100644
--- a/hermes_cli/kanban_queue_position.py
+++ b/hermes_cli/kanban_queue_position.py
@@ -340,9 +340,13 @@ def local_words(place: dict[str, Any]) -> str:
         if (place.get("admission_class") not in ("capacity", "urgent") and pools["regular"] is not None
                 and pools["regular_cap"] is not None and pools["regular"] >= pools["regular_cap"]):
             census += f"; regular pool full ({pools['regular']}/{pools['regular_cap']}), a normal card waits for it"
-        return (f"{words}, {census}; class {place['admission_class']}. "
-                "Queued, not stuck: check class/placement and available capacity; priority slots are marked-only. "
-                "Do not run its work outside the dispatcher")
+        words = f"{words}, {census}; class {place['admission_class']}"
+        pool_advice = ("Queued, not stuck: check class/placement and available capacity; priority slots are "
+                       "marked-only. Do not run its work outside the dispatcher")
+        if not skip:
+            return f"{words}. {pool_advice}"
+        words = f"last dispatcher skip of this ready episode: {skips.words(skip)} ({words})"
+        return words + ". " + (pool_advice if skips.is_ordering(skip) else skips.advice(skip))
     if place.get("running") is not None and place.get("limit") is not None:
         words += f", {place['running']}/{place['limit']} running"
     elif place.get("limit") is not None and "running" in place:
diff --git a/tests/hermes_cli/test_kanban_hub_admission.py b/tests/hermes_cli/test_kanban_hub_admission.py
index 06d1c14c3a..97eb72ae44 100644
--- a/tests/hermes_cli/test_kanban_hub_admission.py
+++ b/tests/hermes_cli/test_kanban_hub_admission.py
@@ -1528,3 +1528,45 @@ def test_capacity_report_wait_starts_at_latest_ready_event_not_creation(board):
                          (started - 600, tid))
     entry, = report.capacity_report(conn, now_s=now, days=7)["cards"]
     assert (entry["ready_wait_p50_before_s"], entry["ready_wait_p50_after_s"]) == (600, 600)
+
+
+_POOLS_FULL = {"regular": 7, "regular_cap": 7, "priority": 0, "priority_cap": 3}
+_SCORE = {"total": 1100, "effective_priority": 1000, "class_rank": 0, "descendants": 0, "age_buckets": 1,
+          "failures": 0, "weights": {"class": 500, "unblock": 25, "age": 100, "failure": 25}}
+
+
+def test_pool_note_keeps_non_ordering_dispatcher_skip():
+    """An opted-in hub's pool census must not swallow the recorded dispatcher skip (kanban-dd62aef001)."""
+    from hermes_cli import kanban_dispatch_skip as skips
+    from hermes_cli import kanban_queue_position as qp
+    skip = {"reason": "pinned_quota_wall", "detail": "claude-opus-5-5 (anthropic)"}
+    note = qp.describe({"lane": "local", "ahead": 0, "running": 7, "limit": 7, "skip": skip,
+                        "admission_class": "normal", "admission_pools": dict(_POOLS_FULL),
+                        "admission_score": dict(_SCORE)})
+    assert note.startswith("last dispatcher skip of this ready episode: " + skips.words(skip)), note
+    assert "regular 7/7, priority 0/3" in note, note
+    assert "score 1100 (priority 1000" in note, note
+    assert "regular pool full (7/7), a normal card waits for it" in note, note
+    assert "class normal" in note, note
+    assert note.endswith(skips.advice(skip)), note
+    assert "check class/placement" not in note, note
+
+
+def test_pool_note_ordering_skip_keeps_pool_advice():
+    """A slot-ordering skip still names itself, then the class/placement advice (never a bump)."""
+    from hermes_cli import kanban_dispatch_skip as skips
+    from hermes_cli import kanban_queue_position as qp
+    skip = {"reason": "claim_deferred", "detail": "capacity"}
+    note = qp.describe({"lane": "local", "ahead": 2, "skip": skip, "admission_class": "normal",
+                        "admission_pools": dict(_POOLS_FULL)})
+    assert note.startswith("last dispatcher skip of this ready episode: " + skips.words(skip)), note
+    assert "regular pool full (7/7)" in note and "class normal" in note, note
+    assert "check class/placement" in note and "bump" not in note, note
+
+
+def test_pool_note_without_skip_is_unchanged():
+    from hermes_cli import kanban_queue_position as qp
+    note = qp.describe({"lane": "local", "ahead": 0, "admission_class": "capacity",
+                        "admission_pools": dict(_POOLS_FULL)})
+    assert note.startswith("waiting for a local slot: ~0 ahead, regular 7/7, priority 0/3; class capacity. "), note
+    assert "last dispatcher skip" not in note and "pool full" not in note, note
