From 47b31d5e427cae6f8a45b13bfbafe2d36fcf5ad3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:57:49 +0000
Subject: [PATCH] fix(kanban): distinguish scope stops from provider refusals
 [daveey]

---
 hermes_cli/kanban_db_promote.py              | 10 +++++-----
 hermes_cli/kanban_spend_decision.py          | 15 +++++++++++----
 hermes_cli/kanban_spend_promote.py           |  5 ++---
 tests/hermes_cli/test_kanban_retain_local.py |  9 ++++++++-
 4 files changed, 26 insertions(+), 13 deletions(-)

diff --git a/hermes_cli/kanban_db_promote.py b/hermes_cli/kanban_db_promote.py
index fe46f8520d..eff391ad97 100644
--- a/hermes_cli/kanban_db_promote.py
+++ b/hermes_cli/kanban_db_promote.py
@@ -15,9 +15,9 @@ def promote_task(
     System callers omit the precondition. Manual boundaries check unread comments
     under the write lock; dry runs validate without writing anything.
     """
-    from hermes_cli.kanban_spend_decision import execution_restricted as restricted
-    if restricted(conn, task_id):
-        return False, 'Provider safety restriction has no supported execution release'
+    from hermes_cli.kanban_spend_decision import execution_refusal
+    if refusal := execution_refusal(conn, task_id):
+        return False, refusal
     cur_status = _kb._task_status(conn, task_id)
     if cur_status is None:
         return False, f"task {task_id} not found"
@@ -41,8 +41,8 @@ def promote_task(
             return False, refusal
         return True, None
     with _kb.write_txn(conn):
-        if restricted(conn, task_id):
-            return False, 'Provider safety restriction has no supported execution release'
+        if refusal := execution_refusal(conn, task_id):
+            return False, refusal
         if precondition and (refusal := precondition(conn)):
             return False, refusal
         # A scheduled exception authorizes only an unresolved spend decision, rechecked under the writer lock.
diff --git a/hermes_cli/kanban_spend_decision.py b/hermes_cli/kanban_spend_decision.py
index a8d2761dc8..99935f4e1e 100644
--- a/hermes_cli/kanban_spend_decision.py
+++ b/hermes_cli/kanban_spend_decision.py
@@ -116,15 +116,22 @@ def receipt_restrictions(conn, task_id: str, *, safety_only: bool = False) -> li
     return out
 
 
-def unblock_refusal(conn, task_id: str) -> str | None:
-    """An unblock is not a recorded spend decision; keep every release surface honest."""
-    if not pending(conn, task_id):
-        return None
+def execution_refusal(conn, task_id: str) -> str | None:
+    """Cause-specific diagnostic only; never converts a scope stop into clearance."""
     from hermes_cli.kanban_refusal_receipt import restricted
     if restricted(conn, task_id):
         return 'Provider safety restriction retained; no supported execution release. Owning supervisor must resolve the scope/authority boundary without rerunning refused work.'
     if execution_restricted(conn, task_id):
         return 'Scope stopped; no supported execution release. Owning supervisor must resolve the scope/authority boundary.'
+    return None
+
+
+def unblock_refusal(conn, task_id: str) -> str | None:
+    """An unblock is not a recorded spend decision; keep every release surface honest."""
+    if not pending(conn, task_id):
+        return None
+    if refusal := execution_refusal(conn, task_id):
+        return refusal
     return (f"cannot unblock {task_id}: spend-budget decision pending; split or re-scope the work, "
             f"then use `hermes kanban promote {task_id} --reason <what changed>`, or archive it")
 
diff --git a/hermes_cli/kanban_spend_promote.py b/hermes_cli/kanban_spend_promote.py
index 612437159d..7e6837eeb9 100644
--- a/hermes_cli/kanban_spend_promote.py
+++ b/hermes_cli/kanban_spend_promote.py
@@ -101,9 +101,8 @@ def scope_refusal(conn: sqlite3.Connection, target: str, requester: Optional[str
     from hermes_cli import kanban_spend_decision as ksd
     from hermes_cli.kanban_continuation import HUMAN_BLOCK_KINDS
     from hermes_cli.kanban_operator_call import COMMENT_MARK
-    from hermes_cli.kanban_spend_decision import execution_restricted as restricted
-    if restricted(conn, target):
-        return 'Provider safety restriction has no supported execution release; ordinary spend promotion is not clearance'
+    if refusal := ksd.execution_refusal(conn, target):
+        return refusal
     row = conn.execute("SELECT status, human_request, block_kind FROM tasks WHERE id = ?", (target,)).fetchone()
     if row is None:
         return f"no such task {target}"
diff --git a/tests/hermes_cli/test_kanban_retain_local.py b/tests/hermes_cli/test_kanban_retain_local.py
index 89fa87cd98..a314f5a47f 100644
--- a/tests/hermes_cli/test_kanban_retain_local.py
+++ b/tests/hermes_cli/test_kanban_retain_local.py
@@ -64,6 +64,13 @@ def test_scope_restriction_survives_later_ordinary_promotion(board, monkeypatch)
     before = budget._window_start(board, tid, 2999999999)
     kb.add_comment(board, tid, 'operator-fixture', 'Administrative note, not release', writer_kind='human')
     assert kb.get_task(board, tid).status == 'triage'
-    assert kb.promote_task(board, tid, actor='fixture', reason='generic promotion')[0] is False
+    promoted, refusal = kb.promote_task(board, tid, actor='fixture', reason='generic promotion')
+    assert promoted is False
+    assert 'scope stopped' in refusal.lower()
+    assert 'provider' not in refusal.lower()
+    from hermes_cli.kanban_spend_promote import scope_refusal
+    refusal = scope_refusal(board, tid, 'decision-fixture', 'episode-fixture', 1)
+    assert 'scope stopped' in refusal.lower()
+    assert 'provider' not in refusal.lower()
     assert not kb.unblock_task(board, tid)
     assert budget._window_start(board, tid, 2999999999) == before
-- 
2.43.0

