index 42af807c392..84d802159db 100644
--- a/apps/desktop/src/app/chat/composer/text-utils.ts
+++ b/apps/desktop/src/app/chat/composer/text-utils.ts
@@ -218,6 +218,46 @@ export function detectTrigger(textBefore: string): TriggerState | null {
