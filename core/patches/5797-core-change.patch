-    # -- the guards themselves -------------------------------------------------------------------------
     ("kanban_sync_capture_storage.py", "install", "UPDATE", _O): GUARD_INSTALL,
     ("kanban_sync_capture_storage.py", "install", "UPDATE", _P): GUARD_INSTALL,
 }
 
