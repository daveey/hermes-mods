diff --git a/hermes_state_local_quarantine.py b/hermes_state_local_quarantine.py
new file mode 100644
index 00000000000..a9c0638e92c
--- /dev/null
+++ b/hermes_state_local_quarantine.py
@@ -0,0 +1,30 @@
+"""Terminal, fail-closed quarantine of an invalid stored local policy."""
+import json
+import time
+
+from hermes_state_local import POLICY_PREFIX
+from hermes_state_runtime import RuntimeStoreError, _epoch, _json
+
+
+def quarantine_local_policy(db, *, epoch, session_id, expected, error_type):
+    """Keep policy/history intact; fence only the exact receipt the owner validated.
+
+    Returns whether this transaction recorded the first refusal. A stale owner or a
+    concurrently changed receipt must retry inspection rather than quarantine new data.
+    """
+    def write(conn):
+        _epoch(conn, epoch)
+        key = POLICY_PREFIX + session_id
+        row = conn.execute('SELECT value FROM state_meta WHERE key=?', (key,)).fetchone()
+        if row is None:
+            raise RuntimeStoreError('storage_unavailable')
+        saved = json.loads(row[0])
+        if saved.get('quarantine') is not None:
+            return False
+        if saved != expected:
+            raise RuntimeStoreError('admission_conflict')
+        saved['quarantine'] = {'reason': 'invalid_stored_policy', 'error_type': error_type,
+                               'at': time.time()}
+        conn.execute('UPDATE state_meta SET value=? WHERE key=?', (_json(saved), key))
+        return True
+    return db._execute_write(write)
diff --git a/tests/gateway/test_kanban_policy_quarantine.py b/tests/gateway/test_kanban_policy_quarantine.py
new file mode 100644
index 00000000000..cc7467e831b
--- /dev/null
+++ b/tests/gateway/test_kanban_policy_quarantine.py
@@ -0,0 +1,38 @@
+"""A pre-admission Kanban retry reuses and respects its quarantined receipt."""
+import json
+
+import pytest
+
+from hermes_state_local import POLICY_PREFIX
+from hermes_state_runtime import RuntimeStoreError
+from tests.gateway.test_kanban_finite_admission import kanban_owner
+
+
+@pytest.mark.asyncio
+async def test_kanban_invalid_policy_retries_keep_one_receipt(kanban_owner, monkeypatch):
+    from gateway import session_kanban
+    from gateway.session_local_recovery import local_receipt_ids
+    from dataclasses import replace
+
+    owner = kanban_owner({'model': {'default': 'm', 'provider': 'custom'}})
+    build = session_kanban.build_kanban_policy
+
+    def broken(*args):
+        policy, secrets = build(*args)
+        return replace(policy, model=''), secrets
+
+    monkeypatch.setattr(session_kanban, 'build_kanban_policy', broken)
+    try:
+        for _ in range(3):
+            with pytest.raises(RuntimeStoreError, match='invalid_params'):
+                await session_kanban.run_task(owner.connection, owner.params)
+        with owner.authority.db._read_ctx() as conn:
+            rows = conn.execute('SELECT value FROM state_meta WHERE key LIKE ?', (POLICY_PREFIX + '%',)).fetchall()
+            assert len(rows) == 1
+            receipt = json.loads(rows[0][0])
+            assert receipt['policy']['model'] == ''
+            assert receipt['quarantine']['reason'] == 'invalid_stored_policy'
+            assert conn.execute('SELECT count(*) FROM session_admissions').fetchone()[0] == 0
+        assert receipt['session_id'] not in local_receipt_ids(owner.authority)
+    finally:
+        await owner.close()
diff --git a/tests/gateway/test_local_policy_quarantine.py b/tests/gateway/test_local_policy_quarantine.py
new file mode 100644
index 00000000000..a389836f414
--- /dev/null
+++ b/tests/gateway/test_local_policy_quarantine.py
@@ -0,0 +1,94 @@
+"""Stored policy validation is terminal; unavailable storage is retryable."""
+import json
+
+import pytest
+
+from gateway import session_local_recovery as recovery
+from gateway.session_local import create_local_session
+from hermes_state_local import POLICY_PREFIX
+from hermes_state_runtime import RuntimeStoreError
+from tests.gateway.test_local_receipt_untracked_compression import _owner, _unrecovered_owner
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('damage', ['empty_model', 'missing_model', 'bad_toolsets', 'bad_json', 'missing_policy'])
+async def test_invalid_policy_is_quarantined_once(tmp_path, monkeypatch, caplog, damage):
+    first, connection = await _owner(tmp_path, monkeypatch, 'first')
+    ref = create_local_session(first, connection.actor, {
+        'request_id': 'r', 'source': 'tui', 'cwd': str(tmp_path), 'model': 'm', 'toolsets': []})
+    sid = ref.session_id
+    first.db.append_message(sid, 'user', 'preserve this history; never replay')
+    with first.db._read_ctx() as conn:
+        receipt = json.loads(conn.execute('SELECT value FROM state_meta WHERE key=?',
+                                         (POLICY_PREFIX + sid,)).fetchone()[0])
+    if damage == 'empty_model':
+        receipt['policy']['model'] = ''
+    elif damage == 'missing_model':
+        del receipt['policy']['model']
+    elif damage == 'bad_toolsets':
+        receipt['policy']['toolsets'] = 42
+    elif damage == 'bad_json':
+        receipt['policy']['config_json'] = '{'
+    else:
+        del receipt['policy']
+    first.db._execute_write(lambda conn: conn.execute(
+        'UPDATE state_meta SET value=? WHERE key=?', (json.dumps(receipt), POLICY_PREFIX + sid)))
+    await connection.close()
+    first.db.close()
+    second, connection = _unrecovered_owner(tmp_path, 'second')
+    try:
+        recovery.recover_local_sessions(second)
+        assert sid not in recovery.local_receipt_ids(second)
+        assert sid not in second.sessions
+        with second.db._read_ctx() as conn:
+            saved = json.loads(conn.execute('SELECT value FROM state_meta WHERE key=?',
+                                           (POLICY_PREFIX + sid,)).fetchone()[0])
+        assert saved.get('policy') == receipt.get('policy')
+        assert saved['quarantine']['reason'] == 'invalid_stored_policy'
+        assert second.db.get_messages_as_conversation(sid)[0]['content'] == 'preserve this history; never replay'
+        recovery.recover_local_sessions(second)
+        with pytest.raises(RuntimeStoreError, match='invalid_params'):
+            recovery.restore_local_session(second, sid)
+        warnings = [r for r in caplog.records if sid in r.getMessage() and r.levelname == 'WARNING']
+        assert len(warnings) == 1
+    finally:
+        await connection.close()
+        second.db.close()
+    third, connection = _unrecovered_owner(tmp_path, 'third')
+    try:
+        assert sid not in recovery.local_receipt_ids(third)
+        recovery.recover_local_sessions(third)
+        assert sid not in third.sessions
+    finally:
+        await connection.close()
+        third.db.close()
+
+
+@pytest.mark.asyncio
+async def test_transient_policy_restore_failure_retries(tmp_path, monkeypatch):
+    from gateway import session_policy
+    first, connection = await _owner(tmp_path, monkeypatch, 'first')
+    ref = create_local_session(first, connection.actor, {
+        'request_id': 'r', 'source': 'tui', 'cwd': str(tmp_path), 'model': 'm', 'toolsets': []})
+    await connection.close()
+    first.db.close()
+    second, connection = _unrecovered_owner(tmp_path, 'second')
+    original = session_policy.restore_policy
+    calls = []
+
+    def unavailable(data):
+        calls.append(data)
+        raise RuntimeStoreError('storage_unavailable')
+
+    try:
+        monkeypatch.setattr(session_policy, 'restore_policy', unavailable)
+        recovery.recover_local_sessions(second)
+        recovery.recover_local_sessions(second)
+        assert len(calls) == 2
+        assert ref.session_id in recovery.local_receipt_ids(second)
+        monkeypatch.setattr(session_policy, 'restore_policy', original)
+        recovery.recover_local_sessions(second)
+        assert ref.session_id in second.sessions
+    finally:
+        await connection.close()
+        second.db.close()
diff --git a/tests/gateway/test_local_policy_quarantine_write.py b/tests/gateway/test_local_policy_quarantine_write.py
new file mode 100644
index 00000000000..cc9a56a371d
--- /dev/null
+++ b/tests/gateway/test_local_policy_quarantine_write.py
@@ -0,0 +1,48 @@
+"""Quarantine cannot commit against stale ownership or a changed receipt."""
+import json
+
+import pytest
+
+from gateway.session_local import create_local_session
+from gateway.session_local_recovery import local_receipt_ids, recover_local_sessions
+from hermes_state_local import POLICY_PREFIX, local_receipt
+from hermes_state_runtime import RuntimeStoreError
+from tests.gateway.test_local_receipt_untracked_compression import _owner, _unrecovered_owner
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('failure', ['unavailable', 'changed_receipt'])
+async def test_quarantine_write_failure_keeps_receipt_retryable(tmp_path, monkeypatch, failure):
+    first, connection = await _owner(tmp_path, monkeypatch, 'first')
+    ref = create_local_session(first, connection.actor, {
+        'request_id': 'r', 'source': 'tui', 'cwd': str(tmp_path), 'model': 'm', 'toolsets': []})
+    sid = ref.session_id
+    receipt = local_receipt(first.db, sid)
+    receipt['policy']['model'] = ''
+    first.db._execute_write(lambda conn: conn.execute(
+        'UPDATE state_meta SET value=? WHERE key=?', (json.dumps(receipt), POLICY_PREFIX + sid)))
+    await connection.close()
+    first.db.close()
+    second, connection = _unrecovered_owner(tmp_path, 'second')
+    write = second.db._execute_write
+
+    def interrupted_write(operation):
+        if failure == 'unavailable':
+            raise RuntimeStoreError('storage_unavailable')
+        changed = dict(receipt, concurrent_metadata=True)
+        write(lambda conn: conn.execute('UPDATE state_meta SET value=? WHERE key=?',
+                                       (json.dumps(changed), POLICY_PREFIX + sid)))
+        return write(operation)
+
+    try:
+        monkeypatch.setattr(second.db, '_execute_write', interrupted_write)
+        recover_local_sessions(second)
+        assert sid in local_receipt_ids(second)
+        assert 'quarantine' not in local_receipt(second.db, sid)
+        monkeypatch.setattr(second.db, '_execute_write', write)
+        recover_local_sessions(second)
+        assert sid not in local_receipt_ids(second)
+        assert local_receipt(second.db, sid)['quarantine']['reason'] == 'invalid_stored_policy'
+    finally:
+        await connection.close()
+        second.db.close()
