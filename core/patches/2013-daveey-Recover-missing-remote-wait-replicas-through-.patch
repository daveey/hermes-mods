+def test_live_orphan_proof_is_owner_computed(kanban_home, api):
+    tid = _live_card()
+    _set(tid, status="blocked", block_kind=None, human_request=None)
+    proof = api.get(f"/api/plugins/kanban/tasks/{tid}").json()["wait_observation"]
