diff --git a/hermes_cli/kanban_wait_live.py b/hermes_cli/kanban_wait_live.py
new file mode 100644
index 00000000000..c8adfaf638c
--- /dev/null
+++ b/hermes_cli/kanban_wait_live.py
@@ -0,0 +1,54 @@
+"""Bounded optional Desktop owner read when a local task replica is absent."""
+from __future__ import annotations
+
+import inspect
+import json
+import time
+
+from hermes_cli.kanban_wait_replica import STATUSES, observe_wait
+
+
+def owner_proof(conn, task):
+    """Owner-produced evidence; the relay must not infer it from summary prose."""
+    from hermes_cli.kanban_db_connect import _main_db_file
+    from hermes_cli.kanban_db_sync import board_slug_for_path
+    board = board_slug_for_path(_main_db_file(conn))
+    return {"board": board, "human_request": bool(task.human_request),
+            **observe_wait(conn, task.id, now=int(time.time()))}
+
+
+def read_task(gateway, target, *, board=None, timeout_seconds=8):
+    """Only a qualified, explicitly live response with owner wait evidence is usable."""
+    try:
+        from hermes_cli.plugins import discover_plugins
+        from tools.registry import registry
+        if timeout_seconds <= 0:
+            raise ValueError("live task lookup budget exhausted")
+        discover_plugins()
+        entry = registry.get_entry("cross_task")
+        # Older handlers ignore unknown kwargs and can wait 150s. Never invoke
+        # one under the scheduler's 30s probe budget.
+        if entry is None or "timeout_seconds" not in inspect.signature(entry.handler).parameters:
+            raise ValueError("bounded live task transport unavailable; update session-mentions")
+        board = board or "default"
+        raw = entry.handler({"action": "read", "target": f"@task:{board}@{gateway}/{target}", "limit": 1},
+                            timeout_seconds=min(8, timeout_seconds))
+        data = json.loads(raw)
+        if data.get("ok") is not True:
+            raise ValueError(str(data.get("error") or "live task lookup failed")[:200])
+        task = data.get("task") or {}
+        resolved_gateway = data.get("gateway")
+        proof = task.get("wait_observation") or {}
+        if (not isinstance(resolved_gateway, str) or not resolved_gateway
+                or data.get("ref") != f"@task:{board}@{resolved_gateway}/{target}"
+                or data.get("board") != board or proof.get("board") != board
+                or task.get("source") != "live" or task.get("id") != target
+                or task.get("status") not in STATUSES
+                or type(proof.get("parked_agent")) is not bool
+                or type(proof.get("human_request")) is not bool
+                or "orphan_reason" not in proof):
+            raise ValueError("live task transport returned no matching owner observation")
+        task["human_request"] = proof["human_request"]
+        return task
+    except Exception as exc:  # health: allow BLE001 -- probe exceptions must be rc2, never process-exit 1 (pending)
+        raise ValueError(f"live task transport: {exc}") from exc
diff --git a/hermes_cli/kanban_wait_replica.py b/hermes_cli/kanban_wait_replica.py
index b142fda459c..d27a44d1e91 100644
--- a/hermes_cli/kanban_wait_replica.py
+++ b/hermes_cli/kanban_wait_replica.py
@@ -17,6 +17,10 @@ STALE_RC = 3
 STATUSES = frozenset(("todo", "ready", "running", "scheduled", "review", "blocked", "triage", "done", "archived"))
 
 
+class MissingReplica(ValueError):
+    """No local observation exists for this owner-qualified card."""
+
+
 class StaleReplica(ValueError):
     """The card was seen in the gateway's replica, but that replica is older than MAX_AGE_SECONDS."""
 
@@ -34,7 +38,7 @@ def read_task(gateway, target, board=None):
         rows = db.execute("SELECT data FROM replica WHERE gw=? AND coll='tasks' AND key=?",
                           (gateway, f"default/{board}/{target}")).fetchall()
         if not rows:
-            raise ValueError(f"{target} not found in {gateway} replica")
+            raise MissingReplica(f"{target} not found in {gateway} replica")
         tasks = [json.loads(r[0]) for r in rows]
         if any(t != tasks[0] for t in tasks[1:]):
             raise ValueError(f"ambiguous replica records for {target}")
@@ -96,15 +100,22 @@ def stale_message(target, stale):
             f"stale_age={stale.age:.0f}s, limit={stale.limit:.0f}s; last seen {status}, unknown now: not yet)")
 
 
-def check(gateway, target, *, board=None, until=(), since=()):
+def check(gateway, target, *, board=None, until=(), since=(), live_timeout=None):
     try:
+        source = "replica"
         try:
             task = read_task(gateway, target, board)
+        except MissingReplica:
+            if live_timeout is None:
+                raise
+            from hermes_cli.kanban_wait_live import read_task as read_live
+            task = read_live(gateway, target, board=board, timeout_seconds=live_timeout)
+            source = "live owner"
         except StaleReplica as stale:
             return STALE_RC, stale_message(target, stale)
         status = task["status"]
         orphan = orphan_reason(task)
-        suffix = " (replica; orphan producer)" if orphan else " (replica)"
+        suffix = f" ({source}; orphan producer)" if orphan else f" ({source})"
         if status in since:
             return 1, f"{target} {status} (unchanged since park){suffix}"
         if status in until:
@@ -114,7 +125,7 @@ def check(gateway, target, *, board=None, until=(), since=()):
             if not isinstance(evidence, dict) or type(evidence.get("parked_agent")) is not bool:
                 raise ValueError(f"{target} scheduled producer evidence unavailable; update owner core")
             if evidence["parked_agent"]:
-                return 0, f"{target} {status} (replica; orphan producer)"
+                return 0, f"{target} {status} ({source}; orphan producer)"
         return 1, f"{target} {status}{suffix}"
     except (OSError, sqlite3.Error, ValueError, TypeError, KeyError, AttributeError) as exc:
         return 2, f"error: replica {gateway}: {exc}"
