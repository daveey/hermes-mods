From fd20c2828583318deec5c6943206612569be4341 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 14:34:27 +0000
Subject: [PATCH] [daveey] Preserve original Acceptance offsets in diagnostic
 correction

Locate the case-insensitive label on original text instead of expanded casefold text. Refuse deeply nested invalid JSON without a traceback and describe normal connection schema setup honestly.

Proof: added reviewer Unicode and deep-nesting rows fail on ae1198a6 (31 passed, 3 failed), then six canonical files pass 100/0. No live metadata correction or authority claim.
---
 hermes_cli/kanban.py                                       | 2 +-
 hermes_cli/kanban_diagnostic_correction.py                 | 7 ++++---
 tests/hermes_cli/test_kanban_diagnostic_correction.py      | 2 ++
 tests/hermes_cli/test_kanban_diagnostic_correction_cli.py  | 3 ++-
 .../docs/developer-guide/diagnostic-prose-correction.md    | 7 +++++--
 5 files changed, 14 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban.py b/hermes_cli/kanban.py
index 6a4229f18f..65b1884531 100644
--- a/hermes_cli/kanban.py
+++ b/hermes_cli/kanban.py
@@ -211,7 +211,7 @@ def kanban_command(args: argparse.Namespace) -> int:
         board_scope = kb.scoped_current_board(normed)
 
     with board_scope:
-        # Maintenance commands must not auto-initialize/migrate before validation.
+        # Maintenance handlers skip init_db; their connections still run schema setup.
         if handler := {"repair": _cmd_repair, "recover": _cmd_recover,
                        "correct-diagnostics": _cmd_correct_diagnostics}.get(action):
             return handler(args)
diff --git a/hermes_cli/kanban_diagnostic_correction.py b/hermes_cli/kanban_diagnostic_correction.py
index 5a96cdf428..3c611cc2b6 100644
--- a/hermes_cli/kanban_diagnostic_correction.py
+++ b/hermes_cli/kanban_diagnostic_correction.py
@@ -5,6 +5,7 @@ Quotation planning is pure. It grants no authority to mutate a card or comment.
 from __future__ import annotations
 
 import os
+import re
 import sqlite3
 
 
@@ -29,7 +30,7 @@ def command(args) -> int:
         request = json.loads(raw.decode("utf-8"))
         if not isinstance(request, dict) or set(request) != keys:
             raise ValueError("expected exactly: " + ", ".join(sorted(keys)))
-    except (OSError, ValueError) as exc:
+    except (OSError, ValueError, RecursionError) as exc:
         print(f"kanban: invalid correction request: {exc}", file=sys.stderr)
         return 2
     try:
@@ -126,7 +127,7 @@ def quote_diagnostic(original: str, diagnostic: str) -> str:
     if original.count(diagnostic) != 1:
         raise ValueError("diagnostic occurrence is missing or ambiguous")
     start = original.index(diagnostic)
-    acceptance = original.casefold().find("acceptance:")
-    if acceptance >= 0 and start + len(diagnostic) > acceptance:
+    acceptance = re.search(r"acceptance:", original, re.IGNORECASE)
+    if acceptance is not None and start + len(diagnostic) > acceptance.start():
         raise ValueError("diagnostic overlaps acceptance text")
     return original[:start] + f'"{diagnostic}"' + original[start + len(diagnostic):]
diff --git a/tests/hermes_cli/test_kanban_diagnostic_correction.py b/tests/hermes_cli/test_kanban_diagnostic_correction.py
index be8f9df785..76340ef777 100644
--- a/tests/hermes_cli/test_kanban_diagnostic_correction.py
+++ b/tests/hermes_cli/test_kanban_diagnostic_correction.py
@@ -139,6 +139,8 @@ def test_stale_compare_preserves_both_fields_and_history(kanban_home, stale):
     ("No error here", "origin chat @session:example", "missing or ambiguous"),
     ("x x", "x", "missing or ambiguous"),
     ("Acceptance: x", "x", "acceptance"),
+    ("ß" * 40 + "\nAcceptance: deliver error now", "error", "acceptance"),
+    ("ß" * 20 + "\nAcceptance: deliver", "Acceptance", "acceptance"),
     ("x", "", "nonempty single-line"),
     ('a"b', 'a"b', "nonempty single-line"),
     ("a\nb", "a\nb", "nonempty single-line"),
diff --git a/tests/hermes_cli/test_kanban_diagnostic_correction_cli.py b/tests/hermes_cli/test_kanban_diagnostic_correction_cli.py
index a112a4e4f3..0be082ac17 100644
--- a/tests/hermes_cli/test_kanban_diagnostic_correction_cli.py
+++ b/tests/hermes_cli/test_kanban_diagnostic_correction_cli.py
@@ -44,7 +44,8 @@ def test_cli_worker_cannot_open_request(correction_case, monkeypatch, capsys):
     assert list(conn.iterdump()) == before
 
 
-@pytest.mark.parametrize("raw", [b"not json", b"\xff", b"x" * 200001], ids=["json", "utf8", "size"])
+@pytest.mark.parametrize("raw", [b"not json", b"\xff", b"x" * 200001, b"[" * 150000],
+                         ids=["json", "utf8", "size", "deep-nesting"])
 def test_cli_bad_file_bytes(correction_case, tmp_path, capsys, raw):
     conn, tid, _ = correction_case
     path = tmp_path / "bad-bytes.json"
diff --git a/website/docs/developer-guide/diagnostic-prose-correction.md b/website/docs/developer-guide/diagnostic-prose-correction.md
index df913e8ca7..36ee1cfb5e 100644
--- a/website/docs/developer-guide/diagnostic-prose-correction.md
+++ b/website/docs/developer-guide/diagnostic-prose-correction.md
@@ -25,8 +25,11 @@ operator review; no text heuristic can establish their meaning.
 
 The task must be inactive and open. A synced board must be primary on the card's
 owning gateway. The comment must have an existing portable UID and belong to that
-exact task. Run on an existing initialized board; this command does not initialize
-or migrate one. There is no force or caller-supplied authority flag.
+exact task. Run on an existing initialized board with the sync schema. The command
+skips explicit board initialization, but opening its connection still runs normal
+schema setup and may create a missing database. A board without the sync schema
+is refused with a SQLite error (for example, `no such column: uid`); this is not a
+read-only missing-board probe. There is no force or caller-supplied authority flag.
 
 ## Request
 
