 hermes_cli/kanban_overlap.py                  |  47 +++++---
 hermes_cli/kanban_parser.py                   |   5 +
 plugins/kanban/dashboard/plugin_api.py        |  19 ++-
 .../test_kanban_create_entry_parity.py        | 109 ++++++++++++++++++
 5 files changed, 189 insertions(+), 15 deletions(-)

