From b8600f6f813a615fea7ad7ba038cc7f67c94ae35 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 03:13:06 +0000
Subject: [PATCH] fix(update): keep the upstream-sync REFUSED line visible
 under its diagnostics [daveey]

Exact-head review of 0ce9e610db0: hermes update printed only the gate's last 4
lines, so the new evidence lines pushed REFUSED, its run URL and the failing job
out of view. Print from the last verdict line (capped at 40 lines) when it is
older than the last 4. Also: a timed-out log read is an unavailable log (not a
whole-diagnostics fault); a non-dict nightly state is 'lookup unavailable'.
---
 hermes_cli/update_cmd_git.py                  | 19 ++++++-
 scripts/ci/upstream_sync_diagnostics.py       | 12 ++++-
 .../test_update_upstream_gate_report.py       | 43 +++++++++++++++
 .../ci/test_upstream_sync_diagnostics.py      | 53 +++++++++++++++----
 4 files changed, 115 insertions(+), 12 deletions(-)
 create mode 100644 tests/hermes_cli/test_update_upstream_gate_report.py

diff --git a/hermes_cli/update_cmd_git.py b/hermes_cli/update_cmd_git.py
index 55a889e667d..40fc7e02557 100644
--- a/hermes_cli/update_cmd_git.py
+++ b/hermes_cli/update_cmd_git.py
@@ -353,11 +353,28 @@ def _sync_fork_with_upstream(git_cmd: list[str], cwd: Path, head: str = "HEAD")
     except (OSError, subprocess.SubprocessError) as exc:
         print(f"  ✗ Upstream sync gate failed to run: {exc}")
         return False
-    for line in (proc.stdout or proc.stderr or "").strip().splitlines()[-4:]:
+    for line in _gate_report(proc.stdout or proc.stderr or ""):
         print(f"    {line}")
     return proc.returncode == 0
 
 
+_GATE_VERDICTS = ("REFUSED", "NOT YET", "LANDED")
+_GATE_REPORT_LINES = 40
+
+
+def _gate_report(output: str) -> list[str]:
+    """The gate's tail: its last 4 lines, widened back to the last verdict line when the evidence lines a REFUSED
+    prints under it (upstream_sync_diagnostics) would push that verdict out of view; capped."""
+    lines = output.strip().splitlines()
+    verdicts = [i for i, line in enumerate(lines) if line.startswith(_GATE_VERDICTS)]
+    start = len(lines) - 4
+    if verdicts and verdicts[-1] < start:
+        start = verdicts[-1]
+    shown = lines[max(start, 0):][:_GATE_REPORT_LINES]
+    hidden = len(lines) - max(start, 0) - len(shown)
+    return shown + ([f"… {hidden} more line(s)"] if hidden > 0 else [])
+
+
 def _offer_upstream_remote(git_cmd: list[str], cwd: Path, *, assume_yes: bool, input_fn) -> bool:
     """Prompt to add ``upstream`` and add it; False when the user declined, the run is non-interactive, or add failed.
 
