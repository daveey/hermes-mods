From 4e533f23b04b8cabd5775c99eee33a50c958b110 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 06:16:52 +0000
Subject: [PATCH] [daveey] keep marked lane order across replica waiter ranking

---
 hermes_cli/kanban_db_dispatch_queries.py      |  7 +++--
 tests/hermes_cli/test_kanban_hub_admission.py | 27 +++++++++++++++++++
 2 files changed, 32 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_db_dispatch_queries.py b/hermes_cli/kanban_db_dispatch_queries.py
index ec5218b6bf..a682d0348e 100644
--- a/hermes_cli/kanban_db_dispatch_queries.py
+++ b/hermes_cli/kanban_db_dispatch_queries.py
@@ -34,12 +34,15 @@ def lane_rows(conn: sqlite3.Connection, status: str, *, marked_first: bool = Fal
     """Unclaimed rows of one lane in dispatch order; optional pool ordering keeps priority ties per class."""
     prefix = "admission_class IN ('capacity', 'urgent') DESC, " if marked_first else ""
     rows = conn.execute(
-        "SELECT id, assignee FROM tasks "
+        "SELECT id, assignee, admission_class FROM tasks "
         f"WHERE status = '{status}' AND claim_lock IS NULL "
         f"ORDER BY {prefix}{DISPATCH_ORDER}"
     ).fetchall()
     from hermes_cli.kanban_dispatch_priority import order_with_remote_waiters
-    return order_with_remote_waiters(conn, rows)
+    rows = order_with_remote_waiters(conn, rows)
+    if marked_first:  # replica donation reorders within a class, never across the pool partition
+        rows.sort(key=lambda row: row["admission_class"] not in ("capacity", "urgent"))
+    return rows
 
 
 def still_current_worker(conn: sqlite3.Connection, row, pid: int) -> bool:
diff --git a/tests/hermes_cli/test_kanban_hub_admission.py b/tests/hermes_cli/test_kanban_hub_admission.py
index 3fdbbb5193..214f3edd8f 100644
--- a/tests/hermes_cli/test_kanban_hub_admission.py
+++ b/tests/hermes_cli/test_kanban_hub_admission.py
@@ -419,6 +419,33 @@ def test_dispatch_marked_candidate_precedes_normal_in_same_lane(
     assert receipt[0] == "priority"
 
 
+@pytest.mark.parametrize("enabled", [False, True])
+def test_replica_waiter_ranking_cannot_undo_marked_lane_order(board, monkeypatch, all_assignees_spawnable, enabled):
+    """A remote waiter donating priority to a normal row reorders within a class, never across marked-first."""
+    from hermes_cli import kanban_db_dispatch as dispatch
+    from hermes_cli import kanban_dispatch_priority as donation
+    conn, home = board
+    configure(home, limit=50 if enabled else None, cap=7)
+    if enabled:
+        with (home / "config.yaml").open("a") as config:
+            config.write("    priority_slots: 3\n")
+        advisory(home)
+        monkeypatch.setattr(cm, "sample", fake_sample(10))
+    monkeypatch.setattr(dispatch, "_memory_pressure_level", lambda: "normal")
+    marked = task(conn, title="restore capacity")
+    kb.edit_task(conn, marked, admission_class="urgent")
+    donated = task(conn, title="remote waiter donates")
+    monkeypatch.setattr(donation, "_order_with_remote_waiters",
+                        lambda c, rows: sorted(rows, key=lambda r: r["id"] != donated))
+    spawned = []
+
+    def spawn(candidate, workspace, board=None):
+        spawned.append(candidate.id)
+
+    dispatch.dispatch_once(conn, spawn_fn=spawn, max_spawn=1, max_in_progress=7)
+    assert spawned == ([marked] if enabled else [donated])
+
+
 @pytest.mark.parametrize("enabled", [False, True])
 def test_dispatch_pool_order_keeps_worker_priority(board, monkeypatch, all_assignees_spawnable, enabled):
     from hermes_cli import kanban_db_dispatch as dispatch
