From e3455d70ae500bdb08b31b4e35a02b65bb170e62 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 09:00:19 +0000
Subject: [PATCH] fix(kanban): sweeper drops archived cards' notify subs whose
 chat no store holds [daveey]

An archived card's tui sub pointing at a chat no state.db holds never drained:
its chat's poller never runs and _deliver_sub returned early, so the chat kept
an unseen count forever (chat s1 on hermes-hub, t_01a18c03307c8661). Drop such
subs; open cards keep theirs, since the chat may still appear.
---
 .../tui_gateway/test_kanban_unloaded_sweep.py | 29 +++++++++++++++++++
 tui_gateway/kanban_unloaded.py                | 10 ++++++-
 2 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_kanban_unloaded_sweep.py b/tests/tui_gateway/test_kanban_unloaded_sweep.py
index c2382965b64..af252e69b3b 100644
--- a/tests/tui_gateway/test_kanban_unloaded_sweep.py
+++ b/tests/tui_gateway/test_kanban_unloaded_sweep.py
@@ -134,6 +134,35 @@ def test_unknown_chat_keeps_its_cursor(db):
     assert _cursor(tid) == before
 
 
+def _subs(tid):
+    conn = kbc.connect()
+    try:
+        return kbn.list_notify_subs(conn, task_id=tid)
+    finally:
+        conn.close()
+
+
+def test_archived_card_sub_to_unknown_chat_is_removed(db):
+    """An archived card's sub whose chat no store holds can never drain: its poller never runs and the sweep
+    skipped it, so the chat kept an unseen count forever (chat s1, t_01a18c03307c8661). [daveey]"""
+    tid = _card(chat_id="s1")
+    conn = kbc.connect()
+    try:
+        assert kb.archive_task(conn, tid)
+    finally:
+        conn.close()
+    assert ku.sweep_once(set(), now=LATER, session_db=_session_db(db)) == []
+    assert _subs(tid) == []
+
+
+def test_live_card_sub_to_unknown_chat_is_kept(db):
+    """Control: a card still open keeps its sub, since the chat may appear later (a store not yet mounted)."""
+    tid = _card(chat_id="s1")
+    before = _cursor(tid)
+    assert ku.sweep_once(set(), now=LATER, session_db=_session_db(db)) == []
+    assert len(_subs(tid)) == 1 and _cursor(tid) == before
+
+
 def test_append_is_deduped_by_notice_id(db):
     meta = {"notice_id": "default:t_x:0-1"}
     first = db.append_kanban_notice(CHAT, "one", meta)
diff --git a/tui_gateway/kanban_unloaded.py b/tui_gateway/kanban_unloaded.py
index f7cbbe2d8e1..12987679dad 100644
--- a/tui_gateway/kanban_unloaded.py
+++ b/tui_gateway/kanban_unloaded.py
@@ -358,7 +358,15 @@ def _deliver_sub(conn, slug, sub, ident, grace_s, now, session_db, _kb, _kbn, ki
     task = _kb.get_task(conn, sub["task_id"])
     with session_db(sub["chat_id"]) as (db, tip):
         if db is None or tip is None:
-            return None  # no store holds this chat (deleted): leave the cursor alone
+            # No store holds this chat (deleted): leave the cursor alone, since the chat may still appear. An
+            # archived card's sub can never drain this way (its chat's poller never runs), so it kept that chat in
+            # unseen counts forever (chat s1, t_01a18c03307c8661): drop it. [daveey]
+            if task is not None and getattr(task, "status", "") == "archived":
+                with contextlib.suppress(Exception):
+                    _kbn.remove_notify_sub(conn, **ident)
+                    logger.info("Dropped notify sub for archived %s/%s: no store holds chat %s",
+                                slug, ident["task_id"], ident["chat_id"])
+            return None
         from tui_gateway.notice_fanout import chat_skip_reason
         skip = chat_skip_reason(db, sub["chat_id"])  # [daveey] archived / moved copy: the notice goes nowhere
         old, new, claimed = _kbn.claim_unseen_events_for_sub(conn, kinds=kinds, durable=skip is None, **ident)
-- 
