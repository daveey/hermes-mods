Date: Fri, 13 Nov 2026 23:52:22 +0000
Subject: [PATCH] test(kanban): reject in-memory change cursors [daveey]

Initialize a real in-memory board via SQLite backup and require FULL,None for first, existing-cursor, and post-write polls. M22 now fails on the behavioral FULL assertion: 1 failed, 34 passed, zero skips; production 35 passed. No production changes.
---
 tests/hermes_cli/test_kanban_task_change.py | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_task_change.py b/tests/hermes_cli/test_kanban_task_change.py
index ed11dc95e1..48e1950856 100644
--- a/tests/hermes_cli/test_kanban_task_change.py
+++ b/tests/hermes_cli/test_kanban_task_change.py
@@ -64,6 +64,23 @@ def _write(conn, sql, params=()):
         conn.execute(sql, params)
 
 
+def test_in_memory_board_never_issues_a_trusted_cursor(board):
+    """Even a fully initialized board cannot vouch for a cursor without a file identity."""
+    tid = kb.create_task(board, title="in memory", assignee="w")
+    disk_cursor = _armed(board)
+    conn = sqlite3.connect(":memory:")
+    try:
+        board.backup(conn)
+        assert conn.execute("SELECT title FROM tasks WHERE id = ?", (tid,)).fetchone()[0] == "in memory"
+        assert tc.changed_since(conn, None) == (FULL, None)
+        assert tc.changed_since(conn, disk_cursor) == (FULL, None)
+        conn.execute("UPDATE tasks SET title = 'changed' WHERE id = ?", (tid,))
+        conn.commit()
+        assert tc.changed_since(conn, None) == (FULL, None)
+    finally:
+        conn.close()
+
+
 def test_a_task_write_marks_only_that_task_and_rearms(board):
     a = kb.create_task(board, title="a", assignee="w")
     b = kb.create_task(board, title="b", assignee="w")
