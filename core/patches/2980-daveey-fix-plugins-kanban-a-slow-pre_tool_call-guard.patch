+            else "retry shortly")
+    return {"action": "block",
+            "message": f"{_PRE_TOOL_CALL_TIMEOUT_BLOCK_MESSAGE} (plugin {module}, callback {name}); {when}"}
 
 # The one hook whose callback rewrites the reply the user would otherwise see streaming.
