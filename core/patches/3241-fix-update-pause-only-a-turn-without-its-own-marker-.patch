 .../test_update_pause_superseded.py           | 31 +++++++++++++++++++
 .../test_update_pause_user_stop.py            |  4 +--
 tui_gateway/prompt_turn.py                    |  3 +-
 tui_gateway/update_pause.py                   | 14 ++++++---
 5 files changed, 47 insertions(+), 9 deletions(-)

