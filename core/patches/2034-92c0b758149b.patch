From 92c0b758149b868b98154fec174f9423721676d0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 7 Nov 2026 02:04:31 +0000
Subject: [PATCH] [daveey] Isolate scratch inventory failures and recognize
 nested owners

---
 hermes_cli/kanban_worktree_gc.py              | 11 +++++--
 .../test_kanban_scratch_preservation.py       | 29 +++++++++++++++++++
 2 files changed, 38 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_worktree_gc.py b/hermes_cli/kanban_worktree_gc.py
index df1d1e4651b..ea1e63d841e 100644
--- a/hermes_cli/kanban_worktree_gc.py
+++ b/hermes_cli/kanban_worktree_gc.py
@@ -66,10 +66,14 @@ def gc_task_scratch(conn: sqlite3.Connection, *, older_than_days: int | None = N
             for board in ws._sibling_board_db_files(conn):
                 with _read_board(board) as other:
                     known_paths.update(_scratch_owner_paths(other))
-            _report_unowned_scratch(kb.workspaces_root(), known_paths)
         except (OSError, sqlite3.Error):
             log.warning("Scratch GC aborted: cannot read all boards; preserving workspaces", exc_info=True)
             return 0
+        try:
+            _report_unowned_scratch(kb.workspaces_root(), known_paths)
+        except OSError:
+            log.warning("Scratch preservation inventory unavailable; unknown paths remain preserved",
+                        exc_info=True)
         for row in rows:
             path = Path(row["workspace_path"] or (kb.workspaces_root() / row["id"])).expanduser()
             if not path.is_dir() or path.is_symlink() or not ws._is_managed_scratch_path(path):
@@ -116,10 +120,13 @@ def _report_unowned_scratch(root: Path, known_paths: set[Path]) -> None:
     """Observe root children without entering them or guessing task IDs from names."""
     if not root.exists():
         return
+    root_key = root.resolve()
+    represented = {root_key / known.relative_to(root_key).parts[0]
+                   for known in known_paths if known.is_relative_to(root_key) and known != root_key}
     for path in root.iterdir():
         if path.is_symlink() or not path.is_dir():
             continue
-        if path.resolve() not in known_paths:
+        if path.resolve() not in represented:
             log.warning("Scratch preserved: reason=owner_unverified path=%s; "
                         "no local task workspace record; moved or unknown ownership; "
                         "no deletion deadline", path)
diff --git a/tests/hermes_cli/test_kanban_scratch_preservation.py b/tests/hermes_cli/test_kanban_scratch_preservation.py
index 3dd7c778a85..5ff560e094b 100644
--- a/tests/hermes_cli/test_kanban_scratch_preservation.py
+++ b/tests/hermes_cli/test_kanban_scratch_preservation.py
@@ -95,6 +95,35 @@ def test_unreadable_board_aborts_without_unknown_owner_claim(board, caplog):
     assert "owner_unverified" not in caplog.text
 
 
+def test_nested_record_represents_root_child(board, caplog):
+    tid, path = helpers._task(status="running")
+    nested = path / "nested"
+    nested.mkdir()
+    with kbc.connect_closing() as conn:
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET workspace_path=? WHERE id=?", (str(nested), tid))
+    caplog.set_level(logging.WARNING)
+    assert helpers._gc() == 0
+    assert "owner_unverified" not in caplog.text
+
+
+def test_inventory_failure_does_not_block_known_cleanup(board, caplog, monkeypatch):
+    _, path = helpers._task()
+    real_iterdir = type(path).iterdir
+
+    def unreadable_root(self):
+        if self == path.parent:
+            raise PermissionError("inventory denied")
+        return real_iterdir(self)
+
+    monkeypatch.setattr(type(path), "iterdir", unreadable_root)
+    caplog.set_level(logging.WARNING)
+    assert helpers._gc() == 0
+    assert not path.exists()
+    assert "inventory unavailable" in caplog.text
+    assert "cannot read all boards" not in caplog.text
+
+
 def test_completed_time_wins_over_later_diagnostics(board, remote, caplog):
     tid, path = helpers._task(remote=remote)
     with kbc.connect_closing() as conn:
-- 
