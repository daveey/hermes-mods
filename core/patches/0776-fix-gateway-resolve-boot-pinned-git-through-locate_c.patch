From 1b95d56baed61f7ecaad5101fc92abf4adc58b23 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 16:00:50 +0000
Subject: [PATCH] fix(gateway): resolve boot-pinned git through locate_command
 [daveey]

---
 gateway/boot_pinned_imports.py                |  6 ++--
 .../test_boot_pinned_git_resolution.py        | 34 +++++++++++++++++++
 2 files changed, 38 insertions(+), 2 deletions(-)
 create mode 100644 tests/gateway/test_boot_pinned_git_resolution.py

diff --git a/gateway/boot_pinned_imports.py b/gateway/boot_pinned_imports.py
index 29b5317cfd2..ce8d70d1cb9 100644
--- a/gateway/boot_pinned_imports.py
+++ b/gateway/boot_pinned_imports.py
@@ -25,12 +25,13 @@ import importlib.util
 import linecache
 import logging
 import os
-import shutil
 import subprocess
 import sys
 import threading
 from typing import Callable, Optional
 
+from hermes_platform.resolver import locate_command
+
 _log = logging.getLogger(__name__)
 
 _GIT_TIMEOUT_S = 15
@@ -98,7 +99,8 @@ class BootPinnedFinder(importlib.abc.MetaPathFinder):
         self.root = os.path.realpath(root)
         self.boot_sha = boot_sha
         self._current_sha = current_sha
-        self._git = git or shutil.which("git")
+        command = (git,) if git else locate_command("git").command
+        self._git = command[0] if command else None
         self._top_level = self._list_top_level()
         self._lock = threading.RLock()
         self._local = threading.local()
diff --git a/tests/gateway/test_boot_pinned_git_resolution.py b/tests/gateway/test_boot_pinned_git_resolution.py
new file mode 100644
index 00000000000..074e27de09d
--- /dev/null
+++ b/tests/gateway/test_boot_pinned_git_resolution.py
@@ -0,0 +1,34 @@
+"""Boot pinning uses the shared passive resolver without losing explicit git overrides."""
+
+from gateway.boot_pinned_imports import BootPinnedFinder
+from hermes_platform.resolver import Candidate, Resolution
+
+
+def test_boot_finder_uses_resolved_git(tmp_path, monkeypatch):
+    executable = str(tmp_path / "git")
+    calls = []
+
+    def resolve(name):
+        calls.append(name)
+        return Resolution("path_executable", (Candidate(executable, "PATH", True),))
+
+    monkeypatch.setattr("gateway.boot_pinned_imports.locate_command", resolve)
+    finder = BootPinnedFinder(str(tmp_path), "a" * 40, lambda: None)
+    assert finder._git == executable
+    assert calls == ["git"]
+
+
+def test_boot_finder_missing_git_disables_blob_reads(tmp_path, monkeypatch):
+    monkeypatch.setattr("gateway.boot_pinned_imports.locate_command",
+                        lambda name: Resolution("missing"))
+    finder = BootPinnedFinder(str(tmp_path), "a" * 40, lambda: None)
+    assert finder._run_git("show", "HEAD:missing.py") is None
+
+
+def test_boot_finder_explicit_git_skips_discovery(tmp_path, monkeypatch):
+    def unexpected(name):
+        raise AssertionError("explicit git must not trigger PATH discovery")
+
+    monkeypatch.setattr("gateway.boot_pinned_imports.locate_command", unexpected)
+    finder = BootPinnedFinder(str(tmp_path), "a" * 40, lambda: None, git="/explicit/git")
+    assert finder._git == "/explicit/git"
