     with pytest.raises(bb.AnswerRefused, match='bb_binding_schema_unavailable'):
         read(db)
 
@@ -120,7 +123,7 @@
         read(db)
 
 
-@pytest.mark.parametrize('raw', ['null','[]','true','3','"string"','{'])
