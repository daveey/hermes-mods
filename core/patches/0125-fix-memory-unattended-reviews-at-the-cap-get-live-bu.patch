From 1d7493205bfbaeaffdf610d9c2f5a02a78e87ae5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 17 Oct 2026 15:55:35 -0700
Subject: [PATCH] fix(memory): unattended reviews at the cap get live budget +
 staging rule, not 'add removes' advice [daveey]

Background review forks only append unattended; patch/remove are staged for
approval (#105921). At the cap, the fork read the replayed system-prompt header
(frozen at session start, possibly days stale), tried a bare add, overflowed,
then followed the over-budget advice ('add removes to the same batch'), which
only staged a proposal. Net: MEMORY.md/USER.md unchanged since 10-14 and 50
pending proposals, with an over_budget error on every review save.

- The unattended memory review prompt now carries live per-store usage read
  from disk and the max entry size that fits, plus the staging rule.
- Over-budget errors inside an unattended review say removes/patches are
  staged, so skip (or use a skill) or send one batch that stages the whole
  consolidation.
- Tests: TestUnattendedReviewAtCap, TestReviewPromptLiveBudget.
---
 agent/background_review.py                    | 18 ++++++++
 .../test_background_review_memory_scope.py    | 34 +++++++++++++++
 tests/tools/test_memory_tool.py               | 43 +++++++++++++++++++
 tools/memory_tool.py                          | 16 ++++++-
 tools/memory_tool_store.py                    | 35 +++++++++++++++
 5 files changed, 145 insertions(+), 1 deletion(-)

diff --git a/agent/background_review.py b/agent/background_review.py
index 8ca6f40928..89b344ca43 100644
--- a/agent/background_review.py
+++ b/agent/background_review.py
@@ -1307,6 +1307,22 @@ def _run_review_in_thread(
         _set_thread_approval_callback(None)
 
 
+def _live_memory_budget_note(agent: Any) -> str:
+    """Live per-store free space for an unattended memory review. The fork replays the parent's
+    system prompt, whose memory header is frozen at session start, while only appends land
+    unattended — so without the live figures the fork tried bare adds into a store other
+    sessions had already filled, overflowed, then staged proposals nobody approved."""
+    store = getattr(agent, "_memory_store", None)
+    if store is None or not hasattr(store, "review_budget_note"):
+        return ""
+    try:
+        note = store.review_budget_note()
+        return note if isinstance(note, str) else ""
+    except Exception:
+        logger.debug("Could not read live memory budget for review prompt", exc_info=True)
+        return ""
+
+
 # (review_memory, review_skills) -> prompt attribute name; skills-only is also the default.
 _PROMPT_NAME_BY_SCOPE = {
     (True, True): "_COMBINED_REVIEW_PROMPT", (True, False): "_MEMORY_REVIEW_PROMPT",
@@ -1331,6 +1347,8 @@ def spawn_background_review_thread(
     # Per-agent overrides (agent._MEMORY_REVIEW_PROMPT etc.) keep working.
     name = _PROMPT_NAME_BY_SCOPE[(review_memory, review_skills)]
     prompt = getattr(agent, name, globals()[name])
+    if review_memory and not explicit and (budget := _live_memory_budget_note(agent)):
+        prompt = f"{prompt}\n\n{budget}"
     if focus := (focus or "").strip():
         prompt = (
             f"{prompt}\n\nThe user explicitly requested this review with the following "
diff --git a/tests/agent/test_background_review_memory_scope.py b/tests/agent/test_background_review_memory_scope.py
index 4ab629bf2f..7eb672d2b0 100644
--- a/tests/agent/test_background_review_memory_scope.py
+++ b/tests/agent/test_background_review_memory_scope.py
@@ -261,3 +261,37 @@ class TestConsolidationProposalSurfaces:
         ]
         actions = bg.summarize_background_review_actions(review_messages, [])
         assert any("staged for your approval" in a for a in actions)
+
