From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 05:26:15 +0000
Subject: [PATCH] [daveey] test(kanban): pin review reassignment chronology

---
 .../test_kanban_dependency_review_sync.py     | 29 ++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_dependency_review_sync.py b/tests/hermes_cli/test_kanban_dependency_review_sync.py
index 55d34e126ca..779008bd12e 100644
--- a/tests/hermes_cli/test_kanban_dependency_review_sync.py
+++ b/tests/hermes_cli/test_kanban_dependency_review_sync.py
@@ -8,6 +8,7 @@ from hermes_cli import kanban_db_connect as kbc
 from hermes_cli import kanban_db_dispatch as dispatch
 from hermes_cli import kanban_db_dispatch_pr_state as prs
 from hermes_cli import kanban_db_sync as sync
+from hermes_cli.kanban_dependency_review import resumes_review
 from tests.hermes_cli import kanban_sync_support as support
 from tests.hermes_cli.test_kanban_dependency_review import HEAD, PR, finish_reviews, parked
 
@@ -77,8 +78,17 @@ def test_uid_mismatch_never_falls_back_to_matching_integer(boards, bad_uid):
     assert dispatch.check_respawn_guard(source, task) == "active_pr"
 
 
+@pytest.fixture
+def review_clock(monkeypatch):
+    # Assignment is a separate operator handoff only when strictly later than
+    # publication. Scheduling delays must not choose which policy this tests.
+    clock = [int(kb.time.time())]
+    monkeypatch.setattr(kb.time, "time", lambda: clock[0])
+    return clock
+
+
 @pytest.mark.parametrize("mode", ["other_pr", "short_head", "other_assignee", "unowned"])
-def test_synced_invalid_review_or_owner_stays_held(boards, mode):
+def test_synced_invalid_review_or_owner_stays_held(boards, review_clock, mode):
     source, target = boards
     task, reviews = parked(source, authenticated=mode != "unowned")
     finish_reviews(source, reviews, metadata={"verdict": "changes_required",
@@ -90,6 +100,23 @@ def test_synced_invalid_review_or_owner_stays_held(boards, mode):
     assert dispatch.check_respawn_guard(target, task) == "active_pr"
 
 
+@pytest.mark.parametrize("assignment_delay", [0, 1])
+def test_synced_reassignment_separates_review_from_operator_handoff(boards, review_clock, assignment_delay):
+    source, target = boards
+    task, reviews = parked(source)
+    finish_reviews(source, reviews, metadata={"verdict": "changes_required", "head": HEAD, "pr": PR})
+    assert resumes_review(source, task, [PR])
+    review_clock[0] += assignment_delay
+    assert kb.assign_task(source, task, "other")
+    transport(source, target)
+    synced_task = kb.get_task(target, task)
+    assert synced_task is not None and synced_task.assignee == "other"
+    assert not resumes_review(target, task, [PR])
+    # A later explicit reassignment independently authorizes the new owner;
+    # it must not be mistaken for acceptance of the old owner's checkpoint.
+    assert dispatch.check_respawn_guard(target, task) == (None if assignment_delay else "active_pr")
+
+
 @pytest.mark.parametrize("remapped", [False, True])
 def test_legacy_checkpoint_only_accepts_original_local_id(boards, remapped):
     source, target = boards
