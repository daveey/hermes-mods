From 62f1807115eb7bbbb7ae19e402858a19e1230b10 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 07:58:50 +0000
Subject: [PATCH] [daveey] fix(kanban): completion_receipt schema lists
 evidence.operator_delivery; states tz-aware observed_at and 32768-byte cap

The advertised evidence object is additionalProperties:false but omitted the optional
operator_delivery the validator admits (and operator-gated claims require), so a strictly
validating client would refuse a receipt the writer accepts. The description now also says
observed_at must be timezone-aware ISO-8601 and that canonical receipt JSON is capped at
hermes_completion_receipt.MAX_BYTES (32768, now a named constant). PR #1930 review nits 1-2.
---
 hermes_completion_receipt.py                  |  5 ++-
 .../test_kanban_complete_receipt_schema.py    | 39 +++++++++++++++++++
 tools/kanban_tools_schemas.py                 | 14 +++++--
 3 files changed, 52 insertions(+), 6 deletions(-)

diff --git a/hermes_completion_receipt.py b/hermes_completion_receipt.py
index 2c9bca4030..b986e6be9f 100644
--- a/hermes_completion_receipt.py
+++ b/hermes_completion_receipt.py
@@ -18,6 +18,7 @@ MAX_EVIDENCE = 32
 MAX_REMAINING = 32
 MAX_TEXT = 2000
 MAX_REF = 2048
+MAX_BYTES = 32768  # canonical (compact, ASCII) JSON of the whole receipt
 _QUALIFIED_OWNER = re.compile(r"@(task|session):[A-Za-z0-9_.-]+@[A-Za-z0-9_.-]+/[^\s/@]+\Z")
 
 
@@ -134,6 +135,6 @@ def validate_completion_receipt(value: Any) -> dict:
     if type(raw["version"]) is not int or raw["version"] != 1:
         raise ValueError("completion_receipt: version must be integer 1")
     out = {"version": 1, "items": [_item(i) for i in _array(raw["items"], "items", MAX_ITEMS, nonempty=True)]}
-    if len(json.dumps(out, ensure_ascii=True, separators=(",", ":")).encode("utf-8")) > 32768:
-        raise ValueError("completion_receipt: canonical JSON must not exceed 32768 bytes")
+    if len(json.dumps(out, ensure_ascii=True, separators=(",", ":")).encode("utf-8")) > MAX_BYTES:
+        raise ValueError(f"completion_receipt: canonical JSON must not exceed {MAX_BYTES} bytes")
     return out
diff --git a/tests/tools/test_kanban_complete_receipt_schema.py b/tests/tools/test_kanban_complete_receipt_schema.py
index 2158176398..f25475e517 100644
--- a/tests/tools/test_kanban_complete_receipt_schema.py
+++ b/tests/tools/test_kanban_complete_receipt_schema.py
@@ -45,3 +45,42 @@ def test_example_in_the_description_validates():
     desc = _receipt_schema()["description"]
     example = json.loads(desc[desc.index("Example: ") + len("Example: "):])
     assert hcr.validate_completion_receipt(example) == example
+
+
+def _evidence_schema():
+    return _receipt_schema()["properties"]["items"]["items"]["properties"]["evidence"]["items"]
+
+
+def test_evidence_advertises_the_optional_operator_delivery_the_validator_admits():
+    # evidence has additionalProperties:false, so a strict client refuses any key the schema omits; the validator
+    # accepts (and for operator-gated claims requires) operator_delivery, so the schema must list it.
+    evidence = _evidence_schema()
+    assert evidence["additionalProperties"] is False
+    assert evidence["properties"]["operator_delivery"]["type"] == "object"
+    assert "operator_delivery" not in evidence["required"]
+    example = {"version": 1, "items": [{
+        "scope": "comment on the foreign card", "disposition": "delivered", "remaining": [],
+        "evidence": [{"ref": "operator comment 7", "observed_at": "2026-11-13T06:40:00+00:00",
+                      "verification": "independently_checked", "operator_delivery": {
+                          "request_uid": "r", "target_task_id": "t_x", "board": "default", "caller_task_id": "t_y",
+                          "caller_run_uid": "u", "caller_gateway": "a", "executor_gateway": "b", "comment_id": 7,
+                          "content_sha256": "0" * 64, "result_event_uid": "e"}}]}]}
+    admitted = hcr.validate_completion_receipt(example)
+    assert set(admitted["items"][0]["evidence"][0]) <= set(evidence["properties"])
+
+
+def test_description_states_timezone_and_byte_cap():
+    desc = _receipt_schema()["description"]
+    assert "timezone-aware" in desc
+    assert f"{hcr.MAX_BYTES} bytes" in desc
+    assert "operator_delivery" in desc
+    assert "timezone" in _evidence_schema()["properties"]["observed_at"]["description"]
+    big = {"version": 1, "items": [{"scope": "s" * hcr.MAX_TEXT, "disposition": "delivered", "remaining": [],
+                                    "evidence": [{"ref": "r", "observed_at": "2026-11-13T06:40:00+00:00",
+                                                  "verification": "reported"}]}] * 20}
+    try:
+        hcr.validate_completion_receipt(big)
+    except ValueError as exc:
+        assert str(hcr.MAX_BYTES) in str(exc)
+    else:
+        raise AssertionError("over-cap receipt admitted")
diff --git a/tools/kanban_tools_schemas.py b/tools/kanban_tools_schemas.py
index 65ce692c4a..ef60f6baf1 100644
--- a/tools/kanban_tools_schemas.py
+++ b/tools/kanban_tools_schemas.py
@@ -120,12 +120,15 @@ def _completion_receipt_schema() -> dict[str, Any]:
             "Optional v1 per-scope receipt. Include it when this completion claims delivery of a scoped "
             "artifact or ask (a fix, file, PR, reply, setting): one item per scope with its disposition "
             "(delivered, superseded with superseded_by, contained = mitigated not fixed, rejected), evidence "
-            "refs with the ISO8601 time you observed each and verification independently_checked (you re-ran "
-            "or read it back this run) or reported (taken from someone's word), and what remains. Remaining "
+            "refs with the timezone-aware ISO-8601 time you observed each (a naive timestamp is refused) and "
+            "verification independently_checked (you re-ran or read it back this run) or reported (taken from "
+            "someone's word), and what remains. A cross-card operator delivery claim attaches the applied "
+            "result's operator_delivery object to its evidence. Remaining "
             "pending work needs an open owner card you created or linked, as @task:<board>@<gateway>/<id>; "
             "deferred work may have owner null with a reason. Chat close-outs relay this instead of guessing "
             f"from the summary. Text fields hold at most {hcr.MAX_TEXT} characters, refs and owners "
-            f"{hcr.MAX_REF}. Example: " + json.dumps(example, separators=(",", ":"))),
+            f"{hcr.MAX_REF}; the whole receipt's canonical JSON at most {hcr.MAX_BYTES} bytes. Example: "
+            + json.dumps(example, separators=(",", ":"))),
         "properties": {
             "version": {"type": "integer", "enum": [1]},
             "items": {"type": "array", "minItems": 1, "maxItems": hcr.MAX_ITEMS, "items": {
@@ -140,8 +143,11 @@ def _completion_receipt_schema() -> dict[str, Any]:
                         "required": ["ref", "observed_at", "verification"],
                         "properties": {
                             "ref": ref,
-                            "observed_at": {"type": "string", "maxLength": 64},
+                            "observed_at": {"type": "string", "maxLength": 64, "description": (
+                                "ISO-8601 with timezone, e.g. 2026-11-13T06:40:00+00:00")},
                             "verification": {"type": "string", "enum": list(hcr.VERIFICATIONS)},
+                            "operator_delivery": {"type": "object", "description": (
+                                "Optional: the applied operator result's operator_delivery, verbatim")},
                         }}},
                     "remaining": {"type": "array", "maxItems": hcr.MAX_REMAINING, "items": {
                         "type": "object", "additionalProperties": False,
-- 
