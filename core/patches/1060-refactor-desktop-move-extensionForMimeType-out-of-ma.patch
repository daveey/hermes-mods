diff --git a/apps/desktop/electron/mime-extension.test.ts b/apps/desktop/electron/mime-extension.test.ts
new file mode 100644
index 00000000000..fe2d12189fa
--- /dev/null
+++ b/apps/desktop/electron/mime-extension.test.ts
@@ -0,0 +1,19 @@
+import { describe, expect, it } from 'vitest'
+
+import { extensionForMimeType } from './mime-extension'
+
+describe('extensionForMimeType', () => {
+  it('maps image MIME types (parameters and case ignored) to extensions', () => {
+    expect(extensionForMimeType('image/png')).toBe('.png')
+    expect(extensionForMimeType('IMAGE/JPEG; charset=binary')).toBe('.jpg')
+    expect(extensionForMimeType('image/gif')).toBe('.gif')
+    expect(extensionForMimeType('image/webp')).toBe('.webp')
+    expect(extensionForMimeType('image/bmp')).toBe('.bmp')
+    expect(extensionForMimeType('image/svg+xml')).toBe('.svg')
+  })
+
+  it('returns an empty string for anything else', () => {
+    expect(extensionForMimeType('text/plain')).toBe('')
+    expect(extensionForMimeType(undefined)).toBe('')
+  })
+})
diff --git a/apps/desktop/electron/mime-extension.ts b/apps/desktop/electron/mime-extension.ts
new file mode 100644
index 00000000000..fdacd294ccc
--- /dev/null
+++ b/apps/desktop/electron/mime-extension.ts
@@ -0,0 +1,33 @@
+// Image MIME type -> file extension for saved clipboard/download images (moved out of main.ts).
+export function extensionForMimeType(mimeType: unknown): string {
+  const type = String(mimeType || '')
+    .split(';')[0]
+    .trim()
+    .toLowerCase()
+
+  if (type === 'image/png') {
+    return '.png'
+  }
+
+  if (type === 'image/jpeg') {
+    return '.jpg'
+  }
+
+  if (type === 'image/gif') {
+    return '.gif'
+  }
+
+  if (type === 'image/webp') {
+    return '.webp'
+  }
+
+  if (type === 'image/bmp') {
+    return '.bmp'
+  }
+
+  if (type === 'image/svg+xml') {
+    return '.svg'
+  }
+
+  return ''
+}
