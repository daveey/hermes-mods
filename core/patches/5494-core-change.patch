diff --git a/hermes_cli/kanban_unclaimable_ready.py b/hermes_cli/kanban_unclaimable_ready.py
new file mode 100644
index 0000000000..eb77b3a819
--- /dev/null
+++ b/hermes_cli/kanban_unclaimable_ready.py
@@ -0,0 +1,113 @@
+"""Dispatcher sweep: a READY card no enrolled machine can ever claim is flagged at once, not after hours. [daveey]
+
+Incident t_c193191791c511de: ``runs_on=["macos"]`` on the hub; the only macos machines are
+``pinned_only`` (``kanban_claimants``). It sat ready 24 h, and the one notice that fired said "waiting for macbook,
+mini", so its owner kept expecting a Mac. This sweep runs each dispatcher tick, covers every way a card gets into
+that state (create before the check existed, edit, move, a worker-scaler rehome onto the hub), and:
+
+* posts ONE ``chat_wait_unclaimed`` notice per (card, labels) to the creator's chats, naming each candidate machine's
+  reason and the cross-gateway create remedy (``kanban_chat_wait.notice_text``);
+* on the hub (the operator lane), keeps ONE agent-owned alarm card open for the class: a new card is added to it
+  by comment (``kanban_pickup_stall._create``), never a second alarm.
+
+Temporary states (hold, drain, quota, offline) never count: ``kanban_claimants`` reads structure only.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import time
+from typing import Any, Optional
+
+_log = logging.getLogger(__name__)
+
+KEY = "unclaimable-ready:"
+HOWTO = (
+    "Each listed card is ready but no enrolled machine can ever claim it, so waiting will not start it. For each: "
+    "if its work needs a Mac, create a new card on that Mac's own gateway (cross-gateway create, "
+    "placement='<machine>') and archive the stranded one with a comment naming the replacement; otherwise "
+    "`kanban_move` it to labels an active pool worker carries. Do not change Mac policy (pinned_only) to make it "
+    "claimable. Comment on this alarm with what you did for each card.")
+
+
+def stranded(conn, machines, me: str) -> list[dict[str, Any]]:
+    """Ready, unclaimed cards of this board whose stored ``runs_on`` no machine could ever claim."""
+    from hermes_cli import kanban_claimants as kc
+    from hermes_cli import kanban_runs_on_capabilities as roc
+    from hermes_cli import kanban_worker_node as wn
+    out = []
+    for row in conn.execute("SELECT id, title, tenant, runs_on, created_on, created_at FROM tasks WHERE status = 'ready' "
+                            "AND runs_on IS NOT NULL AND claim_lock IS NULL AND lease_holder IS NULL "
+                            "AND current_run_id IS NULL"):
+        labels = wn._parse(row["runs_on"])
+        home = row["created_on"] or me
+        if labels and roc.impossible(labels, machines, me, home):
+            out.append({"id": row["id"], "title": row["title"], "tenant": row["tenant"], "runs_on": labels,
+                        "created_at": row["created_at"], "why": kc.refusals(labels, machines, home)})
+    return out
+
+
+def _notify(conn, card: dict[str, Any], now: float) -> bool:
+    from hermes_cli import kanban_claimants as kc
+    from hermes_cli import kanban_parent_unclaimed as pu
+    from hermes_cli.kanban_chat_wait import NOTICE_KIND
+    waited = max(0.0, now - pu.ready_since(conn, card["id"], card["created_at"]))
+    return pu.post_notice(
+        conn, card["id"], card["id"], wait_key="unclaimable:" + json.dumps(card["runs_on"]),
+        waited_seconds=waited, ready_seconds=waited, parent_title=card["title"], kind=NOTICE_KIND,
+        extra={"unclaimable": kc.stranded_text(card["id"], card["runs_on"], card["why"])})
+
+
+def _alarm(conn, cards: list[dict[str, Any]], own: str, now_ms: int) -> Optional[str]:
+    from hermes_cli import kanban_claimants as kc
+    from hermes_cli import kanban_pickup_stall as kps
+    key = f"{kps.KEY_PREFIX}{own}:{KEY}"
+    existing = kps._covering_repair(conn, key, now_ms)
+    if existing:
+        body = (conn.execute("SELECT body FROM tasks WHERE id = ?", (existing,)).fetchone()[0] or "")
+        seen = {r[0] for r in conn.execute("SELECT body FROM task_comments WHERE task_id = ?", (existing,))}
+        if all(c["id"] in body or any(c["id"] in s for s in seen if s) for c in cards):
+            return existing  # every card is already on the open alarm: one alarm, no repeat comments
+    listed = "\n".join(f"- {c['id']} ({c['title']}): " + kc.stranded_text(c["id"], c["runs_on"], c["why"])
+                       for c in cards)
+    body = (f"{len(cards)} ready card(s) on {own} that no enrolled machine can ever claim (structural, not a wait):"
+            f"\n\n{listed}\n\n{HOWTO}")
+    return kps._create(conn, key=key, title=f"Ready cards no machine can claim on {own} ({len(cards)})", body=body,
+                       tenant=cards[0]["tenant"], own=own, now_ms=now_ms, howto=HOWTO)
+
+
+def sweep(conn, *, now: Optional[float] = None) -> list[str]:
+    """Notify each stranded ready card's chats once and keep the hub's single alarm current; returns card ids."""
+    from hermes_cli import kanban_db_sync as sync
+    from hermes_cli import kanban_pickup_stall as kps
+    from hermes_cli import kanban_worker_node as wn
+    if sync.board_mode(conn) != "primary":
+        return []
+    try:
+        reg = wn.registry()
+    except Exception:  # health: allow BLE001 -- unknown registry is never evidence of impossibility
+        return []
+    machines = (reg or {}).get("machines") or None
+    me = wn._own(conn)
+    if not machines or not me:
+        return []
+    now = time.time() if now is None else now
+    cards = stranded(conn, machines, me)
+    if not cards:
+        return []
+    for card in cards:
+        try:
+            _notify(conn, card, now)
+        except Exception:  # health: allow BLE001 -- one card's notice never blocks the alarm
+            _log.warning("kanban unclaimable notice failed for %s", card["id"], exc_info=True)
+    if me == kps.OPERATOR_LANE:
+        _alarm(conn, cards, me, int(now * 1000))
+    return [c["id"] for c in cards]
+
+
+def safe_sweep(conn) -> list[str]:
+    try:
+        return sweep(conn)
+    except Exception:  # health: allow BLE001 -- the detector must never stop dispatch
+        _log.warning("kanban dispatcher: unclaimable-ready sweep failed", exc_info=True)
+        return []
diff --git a/tests/hermes_cli/test_kanban_unclaimable_runs_on.py b/tests/hermes_cli/test_kanban_unclaimable_runs_on.py
new file mode 100644
index 0000000000..5543ede899
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_unclaimable_runs_on.py
@@ -0,0 +1,138 @@
+"""A label carried only by pinned_only machines is unclaimable from another gateway (silent starvation). [daveey]
+
+t_c193191791c511de (runs_on=["macos"]) sat ready 24 h on the hub: the only macos machines are pinned_only with no
+pickup, and no pool worker carries ``macos``. Create/move refuse it, the dispatcher flags a ready one in a single
+sweep (chat notice + ONE alarm card), and the stranded reroute grant covers it.
+"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from hermes_cli import kanban_claimants as kc
+from hermes_cli import kanban_creator_repin as kcr
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_dispatch as kbd
+from hermes_cli import kanban_db_sync as sync
+from hermes_cli import kanban_move as km
+from hermes_cli import kanban_runs_on_capabilities as roc
+from hermes_cli import kanban_unclaimable_ready as ur
+from hermes_cli import kanban_worker_node as wn
+from tests.hermes_cli.kanban_sync_fake_board import FakeService
+from tests.hermes_cli.test_kanban_worker_node import HUB, MACHINES, Gateway
+
+OTHER_WORKER_TASK = "t_0e119394bdc0e026"
+
+
+@pytest.fixture
+def svc(monkeypatch):
+    # The alarm queues on a capable pool worker (kanban_pickup_stall.alarm_placement): give worker-1 its labels.
+    alarm = ["capability:file", "capability:hub-write", "capability:kanban", "capability:terminal", "pool:worker",
+             "profile:default"]
+    monkeypatch.setitem(MACHINES, "worker-1", {**MACHINES["worker-1"], "labels": ["linux", *alarm]})
+    return FakeService(lease_runs=True, machines=MACHINES)
+
+
+@pytest.fixture
+def hub(tmp_path, monkeypatch, svc):
+    monkeypatch.setattr(kbd, "_profile_exists_fn", lambda: None)
+    sync.consume_dispatcher_wake()
+    g = Gateway(tmp_path, HUB, svc, monkeypatch, pickup=False)
+    yield g
+    g.conn.close()
+    sync.set_lease_client(None)
+    wn.set_registry_fetch(None)
+
+
+def _ready_macos_card(hub, labels=("macos",)):
+    hub.enter()
+    tid = kb.create_task(hub.conn, title="Build the Mac app", assignee="default")
+    with kb.write_txn(hub.conn):
+        wn.set_runs_on(hub.conn, tid, list(labels))  # a row written before the check, or rehomed onto the hub
+    return tid
+
+
+def _events(conn, tid, kind):
+    return [json.loads(r[0] or "{}") for r in conn.execute(
+        "SELECT payload FROM task_events WHERE task_id = ? AND kind = ?", (tid, kind))]
+
+
+def test_label_only_pinned_only_machines_carry_is_impossible():
+    assert MACHINES["macbook"]["pinned_only"] and not MACHINES["macbook"].get("pickup")
+    assert roc.impossible(["macos"], MACHINES, HUB)
+    assert kc.refusals(["macos"], MACHINES, HUB) == {"macbook": "pinned_only"}
+    assert kc.claimants(["macos"], MACHINES, HUB) == []
+
+
+def test_the_machines_own_cards_and_carried_labels_stay_claimable():
+    assert not roc.impossible(["macos"], MACHINES, HUB, home="macbook")  # its own gateway's card
+    assert not roc.impossible(["linux"], MACHINES, HUB)
+    assert roc.impossible(["hermes-hub"], MACHINES, HUB)  # unchanged: nothing carries it
+    pool = {**MACHINES, "worker-2": {"labels": ["macos"], "pinned_only": False, "pickup": "all", "hold": False}}
+    assert not roc.impossible(["macos"], pool, HUB)  # a pool worker carrying it makes it claimable
+
+
+def test_a_pin_needs_pickup_to_count():
+    pickup = {**MACHINES, "macbook": {**MACHINES["macbook"], "pickup": "explicit"}}
+    assert not roc.impossible(["macos", "machine:macbook"], pickup, HUB)
+    assert roc.impossible(["macos", "machine:macbook"], MACHINES, HUB)
+
+
+def test_create_is_refused_with_the_cross_gateway_remedy(hub):
+    hub.enter()
+    before = hub.conn.execute("SELECT count(*) FROM tasks").fetchone()[0]
+    with pytest.raises(ValueError, match="no enrolled machine can claim") as err:
+        kb.create_task(hub.conn, title="mac", assignee="default", requires=[], runs_on=["macos"])
+    assert "macbook: pinned_only" in str(err.value) and "cross-gateway create" in str(err.value)
+    assert hub.conn.execute("SELECT count(*) FROM tasks").fetchone()[0] == before
+
+
+def test_move_to_such_labels_is_refused(hub):
+    tid = _ready_macos_card(hub, ["linux"])
+    res = km.move_queued(hub.conn, tid, runs_on=["macos"], reason="needs xcode")
+    assert not res["ok"] and res["reason_code"] == "no_machine" and "cross-gateway create" in res["error"]
+    assert json.loads(hub.conn.execute("SELECT runs_on FROM tasks WHERE id = ?", (tid,)).fetchone()[0]) == ["linux"]
+
+
+def test_sweep_flags_a_ready_card_once_and_keeps_one_alarm(hub):
+    tid = _ready_macos_card(hub)
+    assert ur.sweep(hub.conn) == [tid]
+    notices = _events(hub.conn, tid, "chat_wait_unclaimed")
+    assert len(notices) == 1 and "macbook: pinned_only" in notices[0]["unclaimable"]
+    from hermes_cli import kanban_chat_wait as cw
+    text = cw.notice_text(notices[0])
+    assert "NO MACHINE CAN CLAIM" in text and "waiting for macbook" not in text
+    alarms = [r[0] for r in hub.conn.execute("SELECT id FROM tasks WHERE idempotency_key LIKE 'pickup-stall:hub:"
+                                             "unclaimable-ready:%'")]
+    assert len(alarms) == 1 and tid in kb.get_task(hub.conn, alarms[0]).body
+    ur.sweep(hub.conn)
+    assert len(_events(hub.conn, tid, "chat_wait_unclaimed")) == 1  # once per card and labels
+    assert len(list(hub.conn.execute("SELECT id FROM tasks WHERE idempotency_key LIKE 'pickup-stall:hub:"
+                                     "unclaimable-ready:%'"))) == 1
+    second = _ready_macos_card(hub, ["macos", "xcode"])
+    ur.sweep(hub.conn)
+    assert len(list(hub.conn.execute("SELECT id FROM tasks WHERE idempotency_key LIKE 'pickup-stall:hub:"
+                                     "unclaimable-ready:%'"))) == 1  # the new card goes on the open alarm
+    assert any(second in c.body for c in kb.list_comments(hub.conn, alarms[0])) \
+        or second in kb.get_task(hub.conn, alarms[0]).body
+
