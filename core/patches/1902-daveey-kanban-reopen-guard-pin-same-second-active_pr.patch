From 5698335772887671402149cd0f981c55a2aeebf3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 22:44:54 +0000
Subject: [PATCH] [daveey] kanban reopen guard: pin same-second active_pr tie;
 docstring names the rerun bound

Review of #808: the strict reopen tie was only killed through recent_success; add an active_pr-only test (success window over, PR comment and reopen in one second stay guarded). Docstring: a reopen authorizes reruns until one completes or posts a PR comment; a rerun ending without either retries like any reclaimed run.
---
 hermes_cli/kanban_db_dispatch_rerun.py          |  3 ++-
 tests/hermes_cli/test_kanban_reopen_dispatch.py | 12 ++++++++++++
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_db_dispatch_rerun.py b/hermes_cli/kanban_db_dispatch_rerun.py
index dc888e9891b..9857d7ba02c 100644
--- a/hermes_cli/kanban_db_dispatch_rerun.py
+++ b/hermes_cli/kanban_db_dispatch_rerun.py
@@ -13,7 +13,8 @@ def reopened_after(conn: sqlite3.Connection, task_id: str, since: int) -> bool:
     """A supported operator reopen (:func:`kanban_db_operator.reopen_done_task`: ``done`` -> ready/todo,
     payload ``previous_status: done``) strictly after ``since``: a deliberate "run it again". A same-second
     tie, an older reopen, or a ``reopened`` event without that payload fails closed. One reopen authorizes
-    one rerun: that rerun's own completion or PR comment is newer and guards again. [daveey]"""
+    a rerun until that rerun completes or posts a PR comment (newer, so it guards again); a rerun that
+    ends without either retries like any reclaimed run. [daveey]"""
     from hermes_cli import kanban_db as _kb
     from hermes_cli.kanban_db_dispatch import _rows_since
 
diff --git a/tests/hermes_cli/test_kanban_reopen_dispatch.py b/tests/hermes_cli/test_kanban_reopen_dispatch.py
index 31f5abc7d96..a77d8c6c27c 100644
--- a/tests/hermes_cli/test_kanban_reopen_dispatch.py
+++ b/tests/hermes_cli/test_kanban_reopen_dispatch.py
@@ -186,6 +186,18 @@ def test_pr_owner_reopen_resumes_its_pr_once(kanban_home, clock, spawns, open_pr
     assert _guard(tid) == "active_pr"
 
 
+def test_same_second_reopen_keeps_pr_guard(kanban_home, clock, open_pr):
+    """active_pr alone (success window over): a reopen in the PR comment's second stays guarded."""
+    with kbc.connect_closing() as conn:
+        tid = _ran_and_completed(conn, pr_comment=True)
+        clock[0] += 3700
+        worker_comment(conn, tid, "default", f"Merged state of {PR} noted")
+    _reopen(tid)
+    assert _guard(tid) == "active_pr"
+    clock[0] += 1
+    assert _guard(tid) == "active_pr"
+
+
 def test_reopen_without_newer_reopen_keeps_pr_guard(kanban_home, clock, open_pr):
     """No reopen: a done card's open PR still guards a ready row (the ordinary hold)."""
     with kbc.connect_closing() as conn:
