diff --git a/hermes_cli/kanban_origin_forward_adapter.py b/hermes_cli/kanban_origin_forward_adapter.py
new file mode 100644
index 0000000000000000000000000000000000000000..9938f31b602d00651272511c5a197661b605cfdc
--- /dev/null
+++ b/hermes_cli/kanban_origin_forward_adapter.py
@@ -0,0 +1,61 @@
+"""Trusted local courier adapter for origin-gateway forwarding admission.
+
+The courier must queue the returned frozen envelope as itself and wait for the
+owner's completed origin receipt. Preparing an envelope is NOT a handoff.
+"""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import re
+import sqlite3
+import sys
+import time
+
+from hermes_cli.kanban_origin_adapter import _gateway, _resolve_session
+from hermes_cli.kanban_origin_forward import read_lease
+from hermes_cli.kanban_origin_forward_decision import prepare
+
+
+def receive(request):
+    from hermes_constants import get_hermes_home
+    from hermes_cli.profiles import get_active_profile_name
+    from hermes_cli.kanban_sync_client import Hub, load_identity
+
+    home = get_hermes_home()
+    profile = get_active_profile_name()
+    if profile == "custom":
+        raise ValueError("origin_profile_unknown")
+    replica = Path(os.environ.get("HERMES_HUB_STATE") or Path.home() / ".local/state/hermes-hub") / "hub.db"
+    gateway = _gateway(replica)
+
+    def lookup(board, task):
+        # Construct lazily: durable replay needs neither a live lease nor network.
+        return read_lease(Hub(load_identity()), board, task)
+
+    outbound = prepare(request, path=home / "kanban/origin-forward.db",
+                       ledger=home / "kanban/origin-ledger.db", gateway=gateway, profile=profile,
+                       lease_lookup=lookup, now_ms=lambda: int(time.time() * 1000),
+                       session_exists=lambda sid: bool(_resolve_session(home / "state.db", sid)))
+    return {"status": "prepared", "handoff_complete": False, "outbound": outbound}
+
+
+def command(args):
+    from hermes_cli.kanban_sync_client import HubError
+    try:
+        raw = sys.stdin.read(262145) if args.request_file == "-" else Path(args.request_file).read_text(encoding="utf-8-sig")
+        if len(raw.encode("utf-8")) > 262144:
+            raise ValueError("origin_forward_request_invalid")
+        result = receive(json.loads(raw))
+    except (OSError, sqlite3.Error, HubError):
+        result = {"status": "pending", "code": "origin_forward_evidence_unavailable", "handoff_complete": False}
+    except (KeyError, TypeError, ValueError, RecursionError) as exc:
+        code = str(exc)
+        if not re.fullmatch(r"origin_[a-z_]+", code):
+            code = "origin_forward_request_invalid"
+        # Incomplete snapshots are absence of evidence, not a terminal decision.
+        status = "pending" if code == "origin_forward_lease_unavailable" else "rejected"
+        result = {"status": status, "code": code, "handoff_complete": False}
+    print(json.dumps(result))
+    return 0
diff --git a/hermes_cli/kanban_origin_forward_decision.py b/hermes_cli/kanban_origin_forward_decision.py
new file mode 100644
index 0000000000000000000000000000000000000000..f06af1a5d691820b1f431bb413e54f54f36a4798
--- /dev/null
+++ b/hermes_cli/kanban_origin_forward_decision.py
@@ -0,0 +1,128 @@
+"""Freeze origin-local authorization before the courier can enqueue a create.
+
+The server-stamped input is supplied by a trusted local courier adapter. A retry
+reuses the exact durable envelope; a fresh decision needs live execution custody.
+No network writes, task creation, or completion claims happen in this module.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import sqlite3
+from contextlib import closing
+from pathlib import Path
+
+from hermes_cli.kanban_origin_forward import authorize
+
+_COMPONENT = r"[A-Za-z0-9_-][A-Za-z0-9_.-]{0,127}"
+
+
+def _matches(pattern, value):
+    return isinstance(value, str) and re.fullmatch(pattern, value) is not None
+
+
+def _canonical(value):
+    try:
+        raw = json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)
+    except (TypeError, ValueError, RecursionError) as exc:
+        raise ValueError("origin_forward_request_invalid") from exc
+    if len(raw.encode("utf-8")) > 262144:
+        raise ValueError("origin_forward_request_invalid")
+    return raw
+
+
+def _validate_create(create):
+    # Match the placement courier's surface, not arbitrary owner-tool parameters.
+    strings = {"title", "body", "assignee", "session_id", "admission_class", "admission_frees",
+               "model", "provider", "completion_contract", "idempotency_key", "distinct_reason"}
+    lists = {"skills", "requires", "distinct_from"}
+    integers = {"max_runtime_seconds", "priority", "goal_max_turns"}
+    booleans = {"goal_mode", "review_required", "triage"}
+    allowed = strings | lists | integers | booleans
+    if (not set(create) <= allowed
+            or not all(isinstance(create.get(key), str) and create[key].strip()
+                       for key in ("title", "assignee", "session_id"))
+            or not _matches(_COMPONENT, create["session_id"])):
+        raise ValueError("origin_forward_create_invalid")
+    for key, value in create.items():
+        if ((key in strings and not isinstance(value, str))
+                or (key in lists and (not isinstance(value, list) or not all(isinstance(v, str) for v in value)))
+                or (key in integers and type(value) is not int)
+                or (key in booleans and type(value) is not bool)):
+            raise ValueError("origin_forward_create_invalid")
+
+
+def _validated(request, gateway, profile):
+    if not isinstance(request, dict) or not isinstance(request.get("args"), dict):
+        raise ValueError("origin_forward_request_invalid")
+    args = request["args"]
+    origin = args.get("origin")
+    destination = args.get("destination")
+    if (not isinstance(origin, dict) or set(origin) != {"gateway", "profile", "session"}
+            or not all(_matches(_COMPONENT, value) for value in origin.values())
+            or origin["gateway"] != gateway or origin["profile"] != profile
+            or request.get("to_gw") != gateway or request.get("coll") != "sessions"
+            or request.get("action") != "origin-forward"
+            or request.get("key") != f"{profile}/{origin['session']}"
+            or not _matches("gw:" + _COMPONENT, request.get("from"))
+            or not _matches(r"[A-Za-z0-9._:-]{8,128}", request.get("id"))):
+        raise ValueError("origin_forward_route_invalid")
+    if (not isinstance(destination, dict) or set(destination) != {"gateway", "profile", "board"}
+            or not all(_matches(_COMPONENT, value) for value in destination.values())
+            or not isinstance(args.get("creator"), dict) or not isinstance(args.get("create"), dict)
+            or not isinstance(args.get("run_uid"), str) or not args["run_uid"]):
+        raise ValueError("origin_forward_request_invalid")
+    # Transport timestamps/claim counters are not part of the immutable request.
+    return {key: request[key] for key in ("id", "from", "to_gw", "coll", "key", "action", "args")}
+
+
+def _existing(db, identity, canonical):
+    row = db.execute("SELECT request_json,envelope_json FROM decisions WHERE identity=?", (identity,)).fetchone()
+    if row is None:
+        return None
+    if row[0] != canonical:
+        raise ValueError("origin_forward_conflict")
+    return json.loads(row[1])
+
+
+def prepare(request: dict, *, path: Path, ledger: Path, gateway: str, profile: str,
+            lease_lookup, now_ms, session_exists) -> dict:
+    canonical = _canonical(_validated(request, gateway, profile))
+    # Work only with a detached JSON snapshot, including across network I/O.
+    request = json.loads(canonical)
+    args = request["args"]
+    identity = _canonical([gateway, profile, request["from"], request["id"]])
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with closing(sqlite3.connect(path)) as db:
+        db.execute("PRAGMA synchronous=FULL")
+        db.execute("CREATE TABLE IF NOT EXISTS decisions (identity TEXT PRIMARY KEY, "
+                   "request_json TEXT NOT NULL, envelope_json TEXT NOT NULL)")
+        replay = _existing(db, identity, canonical)
+        if replay is not None:
+            return replay
+        _validate_create(args["create"])
+        creator = args["creator"]
+        from hermes_cli.kanban_origin_ledger import validate_binding
+        validate_binding({"binding_id": "validation", "version": 1, "publication_version": 1,
+                          "origin": args["origin"], "owner": creator,
+                          "task_record_key": "/".join(str(creator.get(k, ""))
+                                                     for k in ("profile", "board", "task_id"))})
+        lease = lease_lookup(creator["board"], creator["task_id"])
+        authorize(ledger=ledger, origin=args["origin"], creator=creator, gateway=gateway,
+                  profile=profile, sender=request["from"], run_uid=args["run_uid"],
+                  lease=lease, now_ms=now_ms(), session_exists=session_exists)
+        destination = args["destination"]
+        envelope = {"id": "origin-forward-" + hashlib.sha256(identity.encode()).hexdigest(),
+                    "to_gw": destination["gateway"], "coll": "tasks", "action": "create",
+                    "key": f"{destination['profile']}/{destination['board']}",
+                    "args": {"origin": args["origin"], "create": args["create"]}}
+        # Concurrent admissions may have raced the network read. Recheck while
+        # holding write custody, and return only after durable commit.
+        with db:
+            db.execute("BEGIN IMMEDIATE")
+            replay = _existing(db, identity, canonical)
+            if replay is not None:
+                return replay
+            db.execute("INSERT INTO decisions VALUES (?,?,?)", (identity, canonical, _canonical(envelope)))
+        return envelope
