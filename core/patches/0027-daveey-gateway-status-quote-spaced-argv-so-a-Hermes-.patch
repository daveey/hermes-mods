From 2c51ad61d8cc15bbd68bb6c40d83de6a0179fb2f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 13 Oct 2026 15:00:20 -0700
Subject: [PATCH] [daveey] gateway status: quote spaced argv so a Hermes
 Python.app gateway reads as running

---
 gateway/status.py                             |  8 +++++-
 .../gateway/test_status_cmdline_spaced_exe.py | 26 +++++++++++++++++++
 2 files changed, 33 insertions(+), 1 deletion(-)
 create mode 100644 tests/gateway/test_status_cmdline_spaced_exe.py

diff --git a/gateway/status.py b/gateway/status.py
index d05755882c..a3a081d139 100644
--- a/gateway/status.py
+++ b/gateway/status.py
@@ -523,7 +523,13 @@ def _read_process_cmdline(pid: int) -> Optional[str]:
         import psutil  # type: ignore
         cmdline_parts = psutil.Process(pid).cmdline()
         if cmdline_parts:
-            return " ".join(cmdline_parts)
+            # [daveey] Quote whitespace-bearing args (``~/Applications/Hermes Python.app/...``) so
+            # the quote-aware tokenizer in ``_gateway_command_subcommand`` keeps them one token.
+            # Args that already carry a double quote (an inline ``-c`` source) stay as-is.
+            return " ".join(
+                f'"{part}"' if any(c.isspace() for c in part) and '"' not in part else part
+                for part in cmdline_parts
+            )
     if not _IS_WINDOWS:
         with contextlib.suppress(OSError, subprocess.TimeoutExpired):
             result = subprocess.run(
diff --git a/tests/gateway/test_status_cmdline_spaced_exe.py b/tests/gateway/test_status_cmdline_spaced_exe.py
new file mode 100644
index 0000000000..f11b124ed1
--- /dev/null
+++ b/tests/gateway/test_status_cmdline_spaced_exe.py
@@ -0,0 +1,26 @@
+"""[daveey] A gateway whose interpreter path has a space (``~/Applications/Hermes Python.app``)
+must still read as a running gateway: the joined psutil cmdline quotes that argument."""
+
+import sys
+import types
+
+from gateway import status
+
+
+def test_spaced_interpreter_path_still_reads_as_gateway(monkeypatch):
+    argv = [
+        "/Users/x/Applications/Hermes Python.app/Contents/MacOS/python3.14",
+        "-I",
+        "/Users/x/.hermes/hermes-agent/hermes_cli/main.py",
+        "gateway",
+        "run",
+        "--external-supervisor",
+    ]
+    fake = types.SimpleNamespace(Process=lambda pid: types.SimpleNamespace(cmdline=lambda: argv))
+    monkeypatch.setitem(sys.modules, "psutil", fake)
+    monkeypatch.setattr(status.Path, "read_bytes", lambda self: b"")
+
+    cmdline = status._read_process_cmdline(4242) or ""
+
+    assert cmdline.startswith('"/Users/x/Applications/Hermes Python.app/')
+    assert status.looks_like_gateway_runtime_command_line(cmdline)
-- 
