+"""The never-a-workspace roots are resolved once per input set, not once per path. [daveey]"""
+from __future__ import annotations
+
+import tempfile
+
+import pytest
+
+from tui_gateway import server
+
+
+@pytest.fixture
+def homes(tmp_path, monkeypatch):
+    import hermes_constants
+
+    home = tmp_path / "user"
+    internal = home / ".hermes"
+    temp = tmp_path / "system-temp"
+    for path in (internal, temp):
+        path.mkdir(parents=True)
+    monkeypatch.setenv("TMPDIR", str(temp))
+    monkeypatch.setattr(tempfile, "gettempdir", lambda: str(temp))
+    monkeypatch.setattr(hermes_constants, "get_hermes_home", lambda: internal)
+    monkeypatch.setattr(hermes_constants, "_get_platform_default_hermes_home", lambda: internal)
+    monkeypatch.setattr(server, "_non_workspace_memo", None)
+    return home, internal, temp
+
+
+def test_many_paths_resolve_the_roots_once(homes, monkeypatch):
+    home, internal, temp = homes
+    builds = []
+    real = server._non_workspace_dirs
+    monkeypatch.setattr(server, "_non_workspace_dirs", lambda: builds.append(1) or real())
+    paths = [str(home / f"repo-{i}") for i in range(200)]
+    assert not any(server._is_non_workspace_path(p) for p in paths)
+    assert server._is_non_workspace_path(str(internal / "cache"))
+    assert server._is_non_workspace_path(str(temp / "x"))
+    assert server._is_non_workspace_path("/")
+    assert server._is_non_workspace_path("")
+    assert builds == [1]  # was once per asked path, with ~20 root resolutions each
+
+
+def test_new_profile_home_is_seen_at_once(homes):
+    home, internal, _ = homes
+    outside = home / "profile-storage"
+    outside.mkdir()
+    assert not server._is_non_workspace_path(str(outside / "cache"))
+    profiles = internal / "profiles"
+    profiles.mkdir()
+    assert not server._is_non_workspace_path(str(outside / "cache"))
+    (profiles / "linked").symlink_to(outside, target_is_directory=True)
+    assert server._is_non_workspace_path(str(outside / "cache"))
+
+
+def test_changed_home_or_temp_root_is_seen_at_once(homes, monkeypatch, tmp_path):
+    import hermes_constants
+
+    home, internal, _ = homes
+    other = tmp_path / "other-home"
+    other.mkdir()
+    assert not server._is_non_workspace_path(str(other / "x"))
+    monkeypatch.setattr(hermes_constants, "get_hermes_home", lambda: other)
+    assert server._is_non_workspace_path(str(other / "x"))
+    env_temp = tmp_path / "env-temp"
+    env_temp.mkdir()
+    assert not server._is_non_workspace_path(str(env_temp / "y"))
+    monkeypatch.setenv("TMPDIR", str(env_temp))
+    assert server._is_non_workspace_path(str(env_temp / "y"))
+
+
+def test_relinked_root_is_seen_after_the_ttl(homes, monkeypatch, tmp_path):
+    import hermes_constants
+
+    home, internal, _ = homes
+    first, second = tmp_path / "store-1", tmp_path / "store-2"
+    first.mkdir()
+    second.mkdir()
+    link = tmp_path / "hermes-link"
+    link.symlink_to(first, target_is_directory=True)
+    monkeypatch.setattr(hermes_constants, "get_hermes_home", lambda: link)
+    assert server._is_non_workspace_path(str(first / "x"))
+    link.unlink()
+    link.symlink_to(second, target_is_directory=True)
+    now = server.time.monotonic()
+    monkeypatch.setattr(server.time, "monotonic", lambda: now + server._NON_WORKSPACE_TTL_S + 1)
+    assert server._is_non_workspace_path(str(second / "x"))
+    assert not server._is_non_workspace_path(str(first / "x"))
diff --git a/tui_gateway/coalesced_build.py b/tui_gateway/coalesced_build.py
new file mode 100644
index 00000000000..23c4f06ed68
--- /dev/null
+++ b/tui_gateway/coalesced_build.py
@@ -0,0 +1,81 @@
+"""Run one expensive build at a time per key without serving anything stale. [daveey]
+
+A caller never receives a build that started before it asked: if a build is running when it
+arrives, it waits for that one to finish and shares the NEXT one with everyone else who arrived
+meanwhile. Overlapping identical requests therefore cost at most two builds in a row instead of
+one concurrent build each, and a caller that just changed something still sees its change.
+
+The legacy ``projects.tree`` RPC had no such bound: a slow build was re-requested by the sidebar
+poll before it finished, so seven identical builds ran at once and each took a minute.
+"""
+from __future__ import annotations
+
+import threading
+from collections.abc import Callable, Hashable
+from typing import Any
+
+_WAIT_POLL_S = 1.0
+
+
+class _State:
+    __slots__ = ("started", "finished", "running", "value", "waiters")
+
+    def __init__(self) -> None:
+        self.started = 0  # builds begun
+        self.finished = 0  # index of the newest build that completed successfully
+        self.running = False
+        self.value: Any = None
+        self.waiters = 0
+
+
+class Coalescer:
+    """``run(key, build)``: the result of a ``build()`` that began after this call was made."""
+
+    def __init__(self) -> None:
+        self._cond = threading.Condition()
+        self._states: dict[Hashable, _State] = {}
+
+    def run(self, key: Hashable, build: Callable[[], Any]) -> Any:
+        with self._cond:
+            state = self._states.get(key)
+            if state is None:
+                state = self._states[key] = _State()
+            need = state.started + 1  # the first build to begin after this request
+            state.waiters += 1
+            try:
+                while state.running and state.finished < need:
+                    self._cond.wait(_WAIT_POLL_S)
+                if state.finished >= need:
+                    value = state.value
+                    self._leave(key, state)
+                    return value
+                state.started += 1
+                mine = state.started
+                state.running = True
+            except BaseException:
+                self._leave(key, state)
+                raise
+        try:
+            value = build()
+        except BaseException:
+            # A failed build certifies nothing: every waiter retries for itself.
+            with self._cond:
+                state.running = False
+                self._leave(key, state)
+                self._cond.notify_all()
+            raise
+        with self._cond:
+            state.running = False
+            state.finished, state.value = mine, value
+            self._leave(key, state)
+            self._cond.notify_all()
+        return value
+
+    def _leave(self, key: Hashable, state: _State) -> None:
+        """Forget an idle key: the shared value is not a cache and must not outlive its callers."""
+        state.waiters -= 1
+        if state.waiters <= 0 and not state.running and self._states.get(key) is state:
+            del self._states[key]
+
+
+project_tree = Coalescer()
