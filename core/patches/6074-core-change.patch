diff --git a/tests/tui_gateway/test_coalesced_build.py b/tests/tui_gateway/test_coalesced_build.py
new file mode 100644
index 00000000000..65d237b81b9
--- /dev/null
+++ b/tests/tui_gateway/test_coalesced_build.py
@@ -0,0 +1,111 @@
+"""Overlapping identical builds share one that began after each caller asked. [daveey]"""
+from __future__ import annotations
+
+import threading
+
+import pytest
+
+from tui_gateway.coalesced_build import Coalescer
+
+
+def test_single_caller_runs_its_own_build_and_leaves_nothing_behind():
+    c = Coalescer()
+    assert c.run("k", lambda: 7) == 7
+    assert c.run("k", lambda: 8) == 8  # not a cache: a later call builds again
+    assert c._states == {}
+
+
+def test_callers_arriving_during_a_build_share_the_next_one_not_the_running_one():
+    c = Coalescer()
+    first_started, release_first = threading.Event(), threading.Event()
+    builds, results, lock = [], {}, threading.Lock()
+
+    def build():
+        with lock:
+            builds.append(len(builds) + 1)
+            n = builds[-1]
+        if n == 1:
+            first_started.set()
+            assert release_first.wait(10)
+        return n
+
+    def call(name):
+        results[name] = c.run("k", build)
+
+    leader = threading.Thread(target=call, args=("leader",))
+    leader.start()
+    assert first_started.wait(10)
+    followers = [threading.Thread(target=call, args=(f"f{i}",)) for i in range(6)]
+    for t in followers:
+        t.start()
+    for _ in range(200):  # every follower is parked behind the running build
+        with c._cond:
+            if c._states["k"].waiters == 7:
+                break
+        threading.Event().wait(0.01)
+    else:
+        pytest.fail("followers never queued")
+    release_first.set()
+    for t in (leader, *followers):
+        t.join(10)
+        assert not t.is_alive()
+    assert results["leader"] == 1
+    assert {results[f"f{i}"] for i in range(6)} == {2}  # one shared build, begun after they asked
+    assert builds == [1, 2]
+    assert c._states == {}
+
+
+def test_keys_do_not_wait_on_each_other():
+    c = Coalescer()
+    gate, started = threading.Event(), threading.Event()
+    out = {}
+
+    def slow():
+        started.set()
+        assert gate.wait(10)
+        return "a"
+
+    t = threading.Thread(target=lambda: out.setdefault("a", c.run("a", slow)))
+    t.start()
+    assert started.wait(10)
+    assert c.run("b", lambda: "b") == "b"  # returned while "a" is still building
+    gate.set()
+    t.join(10)
+    assert out == {"a": "a"}
+
+
+def test_failed_build_reaches_only_its_caller_and_waiters_build_for_themselves():
+    c = Coalescer()
+    started, release = threading.Event(), threading.Event()
+    calls, results, errors = [], {}, {}
+
+    def build():
+        calls.append(1)
+        if len(calls) == 1:
+            started.set()
+            assert release.wait(10)
+            raise RuntimeError("store unavailable")
+        return "ok"
+
+    def call(name):
+        try:
+            results[name] = c.run("k", build)
+        except RuntimeError as exc:
+            errors[name] = str(exc)
+
+    leader = threading.Thread(target=call, args=("leader",))
+    leader.start()
+    assert started.wait(10)
+    follower = threading.Thread(target=call, args=("follower",))
+    follower.start()
+    for _ in range(200):
+        with c._cond:
+            if c._states["k"].waiters == 2:
+                break
+        threading.Event().wait(0.01)
+    release.set()
+    leader.join(10)
+    follower.join(10)
+    assert errors == {"leader": "store unavailable"}
+    assert results == {"follower": "ok"}
+    assert c._states == {}
diff --git a/tests/tui_gateway/test_git_probe_warm_settled.py b/tests/tui_gateway/test_git_probe_warm_settled.py
new file mode 100644
index 00000000000..9509da6642f
--- /dev/null
+++ b/tests/tui_gateway/test_git_probe_warm_settled.py
@@ -0,0 +1,96 @@
+"""warm_roots only fans out cwds whose roots are not already cached. [daveey]"""
+from __future__ import annotations
+
+import os
+
+import pytest
+
+from tui_gateway import git_probe
+
+
+@pytest.fixture
+def probes(monkeypatch):
+    git_probe.invalidate()
+    calls = []
+    repos = {}
+
+    def run_git(cwd, *args):
+        calls.append((cwd, args))
+        root = repos.get(cwd, "")
+        if not root:
+            return ""
+        return root if "--show-toplevel" in args else os.path.join(root, ".git")
+
+    monkeypatch.setattr(git_probe, "run_git", run_git)
+    pools = []
+    real = git_probe.ThreadPoolExecutor
+
+    class Pool(real):
+        def __init__(self, *a, **k):
+            pools.append(k.get("max_workers") or (a[0] if a else None))
+            super().__init__(*a, **k)
+
+    monkeypatch.setattr(git_probe, "ThreadPoolExecutor", Pool)
+    yield calls, repos, pools
+    git_probe.invalidate()
+
+
+def test_second_warm_of_the_same_cwds_spawns_no_pool_and_no_git(probes, tmp_path):
+    calls, repos, pools = probes
+    repo, plain, other = (tmp_path / n for n in ("repo", "plain", "other"))
+    for d in (repo, plain, other):
+        d.mkdir()
+    repos[str(repo)] = str(repo)
+    cwds = [str(repo), str(plain), str(other)]
+    git_probe.warm_roots(cwds)
+    assert pools == [3] and calls
+    assert git_probe.resolve(str(repo)) == {"repo_root": str(repo), "worktree_root": str(repo)}
+    assert git_probe.resolve(str(plain)) is None
+    calls.clear()
+    pools.clear()
+    git_probe.warm_roots(cwds)
+    assert pools == [] and calls == []
+
+
+def test_only_the_new_cwd_is_probed(probes, tmp_path):
+    calls, repos, pools = probes
+    old, new = tmp_path / "old", tmp_path / "new"
+    old.mkdir()
+    new.mkdir()
+    git_probe.warm_roots([str(old)])
+    calls.clear()
+    pools.clear()
+    git_probe.warm_roots([str(old), str(new)])
+    assert pools == []  # one pending cwd resolves inline
+    assert {cwd for cwd, _ in calls} == {str(new)}
+
+
+def test_negative_is_reprobed_when_the_dir_changes_or_the_ttl_ends(probes, tmp_path, monkeypatch):
+    calls, repos, pools = probes
+    a, b = tmp_path / "a", tmp_path / "b"
+    a.mkdir()
+    b.mkdir()
+    git_probe.warm_roots([str(a), str(b)])
+    calls.clear()
+    (a / ".git").mkdir()  # `git init`: the dir's own mtime moves
+    os.utime(a, ns=(1, 1))
+    repos[str(a)] = str(a)
+    git_probe.warm_roots([str(a), str(b)])
+    assert {cwd for cwd, _ in calls} == {str(a)}
+    assert git_probe.repo_root(str(a)) == str(a)
+    calls.clear()
+    now = git_probe.time.monotonic()
+    monkeypatch.setattr(git_probe.time, "monotonic", lambda: now + git_probe._NEG_TTL + 1)
+    git_probe.warm_roots([str(a), str(b)])
+    assert {cwd for cwd, _ in calls} == {str(b)}  # the positive stays, the expired negative is asked again
+
+
+def test_repo_with_unresolved_common_root_is_still_warmed(probes, tmp_path):
+    calls, repos, pools = probes
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    repos[str(repo)] = str(repo)
+    assert git_probe.repo_root(str(repo)) == str(repo)  # toplevel cached, common root not yet
+    calls.clear()
+    git_probe.warm_roots([str(repo)])
+    assert any("--git-common-dir" in args for _, args in calls)
