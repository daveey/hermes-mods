From 14ba6e4a26886f61fc2a2f2509153acdc7d5ed69 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 23:10:31 +0000
Subject: [PATCH] [daveey] printf guard: preserve conversions after unknown
 format escapes

Unknown format escapes consume only the backslash in bash. Consuming the following percent shifted arguments and hid a precision-built command. Keep percent available to the conversion parser; keep %b unknown escapes literal.

Proof: sink regression and two real-bash comparisons RED on a4b700a328; 192 sink tests and 1075 guard tests GREEN. Existing %b comparison pins echo-style behaviour. Full corpus exits 0. Document locale and empty-%c model limits; control-character %q precision follow-up t_01a1d723ccf9d9bd.
---
 cron/lifecycle_guard_printf.py                 | 8 +++++++-
 tests/cron/test_lifecycle_guard_output_sink.py | 4 ++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/cron/lifecycle_guard_printf.py b/cron/lifecycle_guard_printf.py
index 3a2888d8d0..c50bc893fb 100644
--- a/cron/lifecycle_guard_printf.py
+++ b/cron/lifecycle_guard_printf.py
@@ -19,7 +19,9 @@ The model follows bash 5's ``printf.def``: flags ``#'-+ 0``, a width and a preci
 or ``%%``. An invalid conversion stops the output there, as in bash. Output past the guard's scan
 budget is cut short (the guard refuses it as oversized anyway). Callers also walk the arguments
 without the format and the earlier whole-argument substitution, so the model is one variant
-among several and never the only text scanned.
+among several and never the only text scanned. Unicode escapes assume UTF-8; in a C locale bash
+may retain non-ASCII Unicode escapes verbatim. Empty ``%c`` is modelled without bash's NUL,
+which bash drops again when reading script input.
 """
 
 import re
@@ -82,6 +84,10 @@ def _decode_escape(text: str, index: int, *, echo_style: bool) -> tuple[str, int
         value = int(text[start:end], 16) if end > start else None
         if value is not None and (char == "x" or value < 0x110000):
             return chr(value), end, False
+    # In a format an unknown escape consumes only the backslash: the next `%`
+    # still starts a conversion. Consuming it would shift every subsequent argument.
+    if not echo_style:
+        return "\\", index + 1, False
     return "\\" + char, index + 2, False
 
 
diff --git a/tests/cron/test_lifecycle_guard_output_sink.py b/tests/cron/test_lifecycle_guard_output_sink.py
index 1d4b8d3175..8a401abf83 100644
--- a/tests/cron/test_lifecycle_guard_output_sink.py
+++ b/tests/cron/test_lifecycle_guard_output_sink.py
@@ -72,6 +72,7 @@ _SINK_SHAPES = {
     "printf-format-repeats": "printf '%s%s ' ba sh {big} | bash\n",
     # Review 5893864308 (PR #2341): a `*` width or precision takes an argument, a precision
     # truncates and `%b` decodes its argument, so the whole-argument walk read the wrong words.
+    "printf-unknown-format-escape": "printf '\\%s\\n%.4s %s\\n' junk bashrc {big} | bash\n",
     "printf-star-width": "printf '%*s %s' 5 bash {big} | bash\n",
     "printf-star-precision": "printf '%.*s %s' 4 bashrc {big} | bash\n",
     "printf-precision": "printf '%.4s %s' bashrc {big} | bash\n",
@@ -277,6 +278,9 @@ def test_printf_output_applies_the_format(format_text, arguments, printed):
 
 # Formats whose output the model must reproduce byte for byte; compared against real bash.
 _BASH_PRINTF_CASES = [
+    (r"\%s\n%.4s %s\n", ["junk", "bashrc", "/x/a.sh"]),
+    (r"\%*s|\%.*s|", ["5", "bash", "4", "bashrc"]),
+    (r"%b|%s", [r"\%s", "unchanged"]),
     ("%*s %s", ["5", "bash", "/x/a.sh"]),
     ("%.4s %s", ["bashrc", "/x/a.sh"]),
     ("%.*s %s", ["4", "bashrc", "/x/a.sh"]),
