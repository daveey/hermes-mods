From 08a6c910e845ac2c2c6f91a38687235ebfcd4c75 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 08:20:17 +0000
Subject: [PATCH] [daveey] test(kanban chat waits): answers in tests come after
 the park second

The strict created_at > park_at rule (previous commit) ignores a comment in the
park own second; three tests answered within it. The helper now dates the
orchestrator answer a few seconds later, as a real answer is.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/hermes_cli/test_kanban_decision_ask.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_decision_ask.py b/tests/hermes_cli/test_kanban_decision_ask.py
index 5e59b681a0aec9e248d375f3615ed39d9741395d..c61a6cd3733850ab1ef88b4d42058b80ac232ffb 100644
--- a/tests/hermes_cli/test_kanban_decision_ask.py
+++ b/tests/hermes_cli/test_kanban_decision_ask.py
@@ -753,7 +753,9 @@ def _orchestrator_comment(monkeypatch, conn, tid, body) -> None:
     """The orchestrator answers from its own chat, not from inside this card's run."""
     monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
     monkeypatch.delenv("HERMES_KANBAN_RUN_ID", raising=False)
-    kb.add_comment(conn, tid, "default", body)
+    cid = kb.add_comment(conn, tid, "default", body)
+    with kb.write_txn(conn):  # an answer comes after the ask was delivered, never in the park's own second
+        conn.execute("UPDATE task_comments SET created_at = ? WHERE id = ?", (int(time.time()) + 5, cid))
 
 
 def test_a_filtered_probe_that_misses_the_answer_still_escalates(kanban_home, monkeypatch) -> None:
