+"""Build diagnostics retain the failing call site without unbounded payloads."""
+import logging
+
+from tui_gateway.build_diagnostics import log_build_failure
+
+
+def test_bounded_traceback_retains_innermost_frame(caplog):
+    def failing_build(depth):
+        local_secret = 'not-a-log-field'
+        if depth:
+            return failing_build(depth - 1)
+        raise ValueError('failure ' + 'x' * 20000 + local_secret)
+    try:
+        failing_build(35)
+    except ValueError as exc:
+        log_build_failure(logging.getLogger('build-diagnostic-test'), 'ui-id', 'stored-id', exc)
+    assert caplog.records[-1].exc_info is not None
+    message = caplog.text
+    assert 'ui-id (stored-id): ValueError: failure' in message
+    assert 'Traceback (most recent call last;' in message
+    assert message.count('in failing_build') == 20
+    assert 'not-a-log-field' not in message
+    assert 'raise ValueError' not in message
+    assert len(message) < 8500
+
+
+def test_wrapped_failure_keeps_cause_frames(caplog):
+    def inner_failure():
+        raise ValueError('original cause')
+    try:
+        try:
+            inner_failure()
+        except ValueError as exc:
+            raise RuntimeError('outer wrapper') from exc
+    except RuntimeError as exc:
+        log_build_failure(logging.getLogger('build-diagnostic-test'), 'ui', 'stored', exc)
+    assert 'in inner_failure' in caplog.text
+    assert 'ValueError: original cause' in caplog.text
+    assert 'RuntimeError: outer wrapper' in caplog.text
+    assert caplog.records[-1].exc_info[2] is None
diff --git a/tui_gateway/build_diagnostics.py b/tui_gateway/build_diagnostics.py
new file mode 100644
index 0000000000..900ee45a11
--- /dev/null
+++ b/tui_gateway/build_diagnostics.py
@@ -0,0 +1,25 @@
+"""Bounded build-failure logging, without session dictionaries or frame locals."""
+import traceback
+
+
+class BuildFailureTraceback(Exception):
+    """Log-only bounded rendering; never retains the original exception or frames."""
+
+
+def log_build_failure(logger, sid, key, exc):
+    # Use a detached diagnostic exception for exc_info. Passing the original
+    # exception lets formatters expand arbitrary provider payloads and chains.
+    parts = []
+    current = exc
+    for _ in range(3):
+        frames = traceback.extract_tb(current.__traceback__, limit=-20)
+        stack = '\n'.join(f'  File "{f.filename}", line {f.lineno}, in {f.name}' for f in frames)
+        parts.append(f'{type(current).__name__}: {str(current)[:300]}\n{stack}')
+        current = current.__cause__ or (None if current.__suppress_context__ else current.__context__)
+        if current is None:
+            break
+    diagnostic = BuildFailureTraceback(('Traceback (most recent call last; outer exception first):\n'
+                                       + '\nCaused by / during handling:\n'.join(parts))[:8000])
+    logger.warning('agent build failed for session %s (%s): %s: %s',
+                   sid, key, type(exc).__name__, str(exc)[:300],
+                   exc_info=(BuildFailureTraceback, diagnostic, None))
diff --git a/tui_gateway/model_switch.py b/tui_gateway/model_switch.py
index 8fb89dd881..c27467c629 100644
--- a/tui_gateway/model_switch.py
+++ b/tui_gateway/model_switch.py
@@ -392,6 +392,29 @@ def _commit_recording_composer_profile(
         raise
 
 
+def _commit_agentless_switch(session: dict, result, override: dict) -> None:
+    """Commit the explicit pick before publishing overrides or retrying a failed build.
+
+    The allocation belongs to the stored session key, never the UI transport id.
+    Use the same ordered event writer as the canonical model mutation; a missing
+    store must fail closed rather than acknowledge a pick the allocator cannot honour.
+    """
+    from agent.model_routing_switch_intent import record_in_transaction
+    key = session.get("session_key")
+    with session.setdefault("agent_build_lock", threading.Lock()):
+        if key:
+            with _session_db(session) as db:
+                if db is None:
+                    raise ValueError("Cannot persist model switch: session store unavailable")
+                def write(conn):
+                    row = conn.execute('SELECT runtime_generation FROM sessions WHERE id=?', (key,)).fetchone()
+                    record_in_transaction(conn, key, result.new_model, result.target_provider, row[0] if row else 0)
+                db._execute_write(write)
+        # Same lock as retry admission: two picks cannot commit A, commit/publish B,
+        # then publish A and build a tuple that no longer matches the newest intent.
+        session["model_override"] = override
+
+
 def _apply_model_switch(
     sid: str, session: dict, raw_input: str, *, confirm_expensive_model: bool = False,
     pin_session_override: bool = True, parsed_flags: Any | None = None,
@@ -439,9 +462,13 @@ def _apply_model_switch(
     # Deliberately NOT written to process-global env (HERMES_MODEL & co.): the desktop hosts
     # every same-profile session in one process, so os.environ would leak the switch to all.
     if pin_session_override and isinstance(session, dict) and not one_turn:
-        session["model_override"] = {
+        override = {
             "model": result.new_model, "provider": result.target_provider,
             "base_url": result.base_url, "api_key": result.api_key, "api_mode": result.api_mode}
+        if agent is None:
+            _commit_agentless_switch(session, result, override)
+        else:
+            session["model_override"] = override
     if persist_global:
         from hermes_cli.model_switch import persist_model_selection
         persist_model_selection(result)
