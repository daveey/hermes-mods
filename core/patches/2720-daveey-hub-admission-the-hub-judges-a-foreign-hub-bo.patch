@@ -417,6 +417,8 @@ def local_refusals(conn: sqlite3.Connection, status: str) -> dict[str, str]:
     if not reg:
         return out
     machines = reg["machines"]
+    from hermes_cli.kanban_hub_admission_pickup import refusals as unjudged
