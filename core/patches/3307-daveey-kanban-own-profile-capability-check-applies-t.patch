From fd97bf41ebba5656831e2bb9488164b912feb94a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 08:53:29 +0000
Subject: [PATCH] [daveey] kanban: own-profile capability check applies the
 launch TERMINAL_* overlay

_profile_policy built the process's own profile's terminal scope from its
files only, while _bind_whole_profile binds that home over the frozen
launch TERMINAL_* overlay. A backend set only by the launch environment
(TERMINAL_ENV from systemd, op run, a launcher bridge) was therefore
ignored by the requires check: an own profile running ssh/docker was
judged local and granted host_repo. Pass env_overlay=launch_terminal_env()
for the own (unstamped) home; other profiles stay file-only.

Review nit 1 on PR #2004 (t_01a1d4138fd1167a).
---
 hermes_cli/kanban_capabilities.py            | 12 ++++++----
 tests/hermes_cli/test_kanban_capabilities.py | 25 ++++++++++++++++++++
 2 files changed, 32 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_capabilities.py b/hermes_cli/kanban_capabilities.py
index 1152c49cfb..32bb1c9230 100644
--- a/hermes_cli/kanban_capabilities.py
+++ b/hermes_cli/kanban_capabilities.py
@@ -300,7 +300,7 @@ def _profile_policy(assignee: str):
     from hermes_cli.config_effective import load_profile_config_effective
     from hermes_cli.profiles import resolve_profile_env
     from tools.terminal_scope import build_profile_terminal_scope
-    from tui_gateway.launch_profile_policy import owner_secret_scope
+    from tui_gateway.launch_profile_policy import launch_terminal_env, owner_secret_scope
 
     home = Path(resolve_profile_env(assignee))
     config_path = home / "config.yaml"
@@ -308,18 +308,20 @@ def _profile_policy(assignee: str):
     # shared loader. That is fine for startup, but cannot establish assignment authority.
     _check_policy_shape(read_config_doc_readonly(config_path))
     scope = scope_for_profile(home)
-    # The process's own profile reads its launch scope, as ``_bind_whole_profile`` binds it: a
-    # managed ``${VAR}`` that only systemd / ``op run`` injects has no file to rebuild from. Any
-    # other profile gets its own files only (t_01a1d3f89c1e13c6).
+    # The process's own profile reads its launch secret scope and the frozen launch ``TERMINAL_*``
+    # overlay, as ``_bind_whole_profile`` binds it: a managed ``${VAR}`` or a ``TERMINAL_ENV`` that only
+    # systemd / ``op run`` injects has no file to rebuild from. Any other profile gets its own files
+    # only (t_01a1d3f89c1e13c6, t_01a1d4138fd1167a).
     secrets = owner_secret_scope(home)
     # Unstamped marks the process's own profile, as the legacy setter left it; any other home is routed.
     stamp = not _is_process_home(home)
+    overlay = None if stamp else launch_terminal_env()
     with ExitStack() as stack:
         # Home and secrets first: the effective config resolves managed values against them.
         stack.enter_context(bind_state(scope, secrets=secrets, stamp_home=stamp, terminal=False))
         config = load_profile_config_effective(config_path, fail_closed=True)
         _check_policy_shape(config)
-        terminal = build_profile_terminal_scope(home)
+        terminal = build_profile_terminal_scope(home, env_overlay=overlay)
         # Effective config includes managed overlays and expanded values; the terminal
         # scope helper also preserves a legacy profile-local .env backend when YAML omits it.
         if "backend" in config.get("terminal", {}):
diff --git a/tests/hermes_cli/test_kanban_capabilities.py b/tests/hermes_cli/test_kanban_capabilities.py
index b9afae09cf..63e0ee98cc 100644
--- a/tests/hermes_cli/test_kanban_capabilities.py
+++ b/tests/hermes_cli/test_kanban_capabilities.py
@@ -210,6 +210,31 @@ def test_own_profile_policy_resolves_launch_injected_refs(profiles, monkeypatch)
         secret_scope.reset_multiplex_context(token)
 
 
+@pytest.mark.parametrize("multiplex", [False, True])
+def test_own_profile_policy_counts_launch_only_terminal_backend(profiles, monkeypatch, multiplex):
+    """A backend that only the launch environment sets (``TERMINAL_ENV`` from systemd, ``op run``,
+    a launcher bridge) is the backend the process's own profile runs with, as ``_bind_whole_profile``
+    binds it; another profile never inherits it (t_01a1d4138fd1167a). [daveey]"""
+    from agent import secret_scope
+    from tui_gateway import launch_profile_policy
+
+    monkeypatch.setenv("TERMINAL_ENV", "ssh")
+    monkeypatch.setattr(launch_profile_policy, "_snapshot", None)  # this test's launch env
+    policy = "platform_toolsets: {cli: [terminal, file]}\n"  # no backend in config.yaml or .env
+    profiles("default", policy)
+    profiles("coder", policy)
+    token = secret_scope.set_multiplex_context(multiplex)
+    try:
+        with pytest.raises(CapabilityMismatchError) as caught:
+            validate_assignment("default", requires=["host_repo"])
+        assert caught.value.missing == ["host_repo"]
+        assert validate_assignment("default", requires=["terminal", "git"]) == ["terminal", "git"]
+        # Another profile reads its own files only: the default backend (local) still grants host_repo.
+        assert validate_assignment("coder", requires=["host_repo"]) == ["host_repo"]
+    finally:
+        secret_scope.reset_multiplex_context(token)
+
+
 def test_skill_names_are_not_guessed_as_capabilities(profiles):
     # Skill capability metadata has no established convention; do not infer from names/prose.
     assert validate_assignment("legacy", skills=["git", "terminal"]) == []
