From 7c85fad0c239a54b1fd9d15de6cd359e2c900449 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 12:12:45 +0000
Subject: [PATCH] test(desktop): kanban drawer: answer PR #2181 review nits
 [daveey]

Review 5890689893 (t_01a1d4c98a6ae865) nits:
1) userOpenReads' doc now states that a fetch cancelled by a socket
   invalidation (cancelRefetch) in a failed read's retry delay also settles
   the kind's open read, by design: the user's read already went out
   foreground and failed.
2) The cancelRefetch pin test used retryDelay 300 ms, so a loaded runner
   could let the retry beat the invalidation. It now uses 10 s, which the
   invalidation cancels, and asserts the replacement's first read is a poll.

Proof: kanban vitest 146/146; mutating retryingFetch to
fetchStatus === 'fetching' still fails both pinned drawer tests.
---
 apps/desktop/src/plugins/kanban/api.ts          |  4 +++-
 apps/desktop/src/plugins/kanban/drawer.test.tsx | 14 +++++++-------
 2 files changed, 10 insertions(+), 8 deletions(-)

diff --git a/apps/desktop/src/plugins/kanban/api.ts b/apps/desktop/src/plugins/kanban/api.ts
index fb54ab44bf..d38a0bfe74 100644
--- a/apps/desktop/src/plugins/kanban/api.ts
+++ b/apps/desktop/src/plugins/kanban/api.ts
@@ -866,7 +866,9 @@ export async function fetchBoard(archived: boolean): Promise<KanbanBoard> {
  *  'foreground' until that kind's open read has settled, so a slow link's poll thinner never skips the user's read:
  *  not on a re-open within the thinning gap, and not on React Query's retry of a failed first read (`retry`: this
  *  call retries a failed read of the same fetch). The open read settles when a read answers, or when a fetch whose
- *  reads all failed has spent its retries: the next fetch then starts with `retry` false. Every later read of that
+ *  reads all failed has spent its retries: the next fetch then starts with `retry` false. A fetch that a socket
+ *  invalidation (cancelRefetch) cancels in a failed read's retry delay settles it too, by design: the user's read
+ *  already went out foreground and failed, and the replacement fetch starts with `retry` false. Every later read of that
  *  kind (interval or socket refetch) is a background poll again and may be thinned (electron/slow-link.ts), so a kind
  *  whose reads keep failing (gateway unreachable, task gone, timeouts on a very slow link) stops bypassing the
  *  thinner after its first fetch. */
diff --git a/apps/desktop/src/plugins/kanban/drawer.test.tsx b/apps/desktop/src/plugins/kanban/drawer.test.tsx
index 3c292602a5..8f34abd754 100644
--- a/apps/desktop/src/plugins/kanban/drawer.test.tsx
+++ b/apps/desktop/src/plugins/kanban/drawer.test.tsx
@@ -347,7 +347,8 @@ describe('task modal dialog', () => {
 
   it('makes the reads of a fetch that replaced a failed one during its retry delay polls', async () => {
     detail = { ...legacyDetail, attachments: [] }
-    client = new QueryClient({ defaultOptions: { queries: { retry: 1, retryDelay: 300 } } })
+    // A retry delay far longer than the test: the invalidation below cancels it, so the retry cannot race it.
+    client = new QueryClient({ defaultOptions: { queries: { retry: 1, retryDelay: 10_000 } } })
 
     const taskReads = () =>
       rest.mock.calls
@@ -368,13 +369,12 @@ describe('task modal dialog', () => {
     await waitFor(() => expect(taskQuery()?.state.fetchFailureCount).toBe(1))
 
     // A socket invalidation in the retry delay cancels that fetch and starts a new one (cancelRefetch). The new fetch's
-    // reads (first and retry) are polls: its first read must not pass for a retry of the cancelled fetch.
-    await act(async () => {
-      await client.invalidateQueries({ queryKey: ['kanban'] })
-    })
-    await waitFor(() => expect(taskReads()).toEqual(['foreground', 'foreground', undefined, undefined]), {
-      timeout: 3_000
+    // first read is a poll: it must not pass for a retry of the cancelled fetch. (Its own retry waits out the long delay,
+    // so the invalidation is not awaited.)
+    act(() => {
+      void client.invalidateQueries({ queryKey: ['kanban'] })
     })
+    await waitFor(() => expect(taskReads()).toEqual(['foreground', 'foreground', undefined]))
   })
 
   it('sends a foreground read when a task is re-opened while its cache is still fresh', async () => {
