From af3f0f1f7158413892c4fec03571aa2bd85a6586 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:19:07 +0000
Subject: [PATCH] test(kanban): pin the scratch-backoff epoch bound below
 Windows' gmtime limit and the ISO retry line [daveey]

Post-merge mutation check of #2516 (t_01a1d63619f1204d) found two surviving
mutants against tests/hermes_cli/test_kanban_scratch_gc_backoff.py:

- B9: MAX_EPOCH_S = 3.2e10 -> 5e10. The only bound test used 9.9e10, so any
  bound up to that passed, including ones above Windows' gmtime limit
  (~3.25e10) that reopen the GC-pass abort #2516 fixed.
- B8: _utc returning str(epoch) instead of the ISO text. Nothing asserted the
  normal-path "next retry after <ISO>" text.

New tests:
- test_memo_loader_epoch_bound_sits_below_the_windows_gmtime_limit: retry_at /
  last_at at 3.26e10 are dropped, at 3.19e10 kept (edge pair from review
  5896160079 nit 2).
- test_skip_logged_names_the_retry_time_in_iso_utc: now=1_000_000, retry_at
  now+60 logs "next retry after 1970-01-12T13:47:40Z".

Proof (hermes-core-wt test, tests/hermes_cli/test_kanban_scratch_gc_backoff.py):
- unmutated: 32 passed, 0 failed (pytest -rs: 32 passed, none skipped)
- B9: 2 failed: test_memo_loader_epoch_bound_sits_below_the_windows_gmtime_limit
  [retry_at-32600000000.0-False] and [last_at-32600000000.0-False]
- B8: 1 failed: test_skip_logged_names_the_retry_time_in_iso_utc
B6 (fallback f"{epoch:.0f}" -> str(epoch)) is equivalent and left unpinned.

Tests only.
---
 .../test_kanban_scratch_gc_backoff.py         | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_scratch_gc_backoff.py b/tests/hermes_cli/test_kanban_scratch_gc_backoff.py
index 4c600edabb..cb8f80feb1 100644
--- a/tests/hermes_cli/test_kanban_scratch_gc_backoff.py
+++ b/tests/hermes_cli/test_kanban_scratch_gc_backoff.py
@@ -191,6 +191,33 @@ def test_memo_loader_drops_each_malformed_field(tmp_path, bad):
     assert bo.skip_logged(refusals, "ok", tree, 5, "t") is True
 
 
+@pytest.mark.parametrize("field, value, kept", [
+    ("retry_at", 3.26e10, False), ("last_at", 3.26e10, False),  # just past Windows' gmtime limit
+    ("retry_at", 3.19e10, True), ("last_at", 3.19e10, True),    # just below MAX_EPOCH_S
+])
+def test_memo_loader_epoch_bound_sits_below_the_windows_gmtime_limit(tmp_path, field, value, kept):
+    """MAX_EPOCH_S is the fix: a bound above ~3.25e10 lets Windows' gmtime abort the pass."""
+    tree = tmp_path / "tree"
+    tree.mkdir()
+    now = 1_000_000.0
+    entry = {"fingerprint": bo.fingerprint(tree, 5), "count": 1, "last_at": now, "retry_at": now + 60,
+             "reason": "r", field: value}
+    _write_entries({"e": entry})
+    assert (set(bo.Refusals("default", now=lambda: now).entries) == {"e"}) is kept
+
+
+def test_skip_logged_names_the_retry_time_in_iso_utc(tmp_path, caplog):
+    tree = tmp_path / "tree"
+    tree.mkdir()
+    now = 1_000_000.0
+    refusals = bo.Refusals("default", now=lambda: now)
+    refusals.entries["t"] = {"fingerprint": bo.fingerprint(tree, 5), "count": 1, "last_at": now,
+                             "retry_at": now + 60, "reason": "r"}
+    caplog.set_level(logging.INFO, logger="hermes_cli.kanban_scratch_backoff")
+    assert bo.skip_logged(refusals, "t", tree, 5, "t") is True
+    assert "next retry after 1970-01-12T13:47:40Z; last: r" in caplog.text
+
+
 @pytest.mark.parametrize("exc", [OSError, OverflowError, ValueError])
 def test_skip_logged_keeps_the_tree_when_retry_at_cannot_be_formatted(tmp_path, monkeypatch, caplog, exc):
     """Windows ``time.gmtime`` raises past ~year 3000; the INFO line must never abort the GC pass."""
