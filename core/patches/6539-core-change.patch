diff --git a/tests/hermes_cli/test_kanban_session_activity.py b/tests/hermes_cli/test_kanban_session_activity.py
index 98fcd0cdfc3..92a8a348859 100644
--- a/tests/hermes_cli/test_kanban_session_activity.py
+++ b/tests/hermes_cli/test_kanban_session_activity.py
@@ -35,7 +35,19 @@
 
 
 @pytest.fixture
-def kanban_root(tmp_path, monkeypatch):
+def kanban_root(tmp_path, monkeypatch, request):
+    if getattr(request, "param", False):
+        # An inherited home can have an independently changing origin ledger.
+        from hermes_cli.kanban_origin_ledger import _db
+
+        ambient = tmp_path / "ambient-home"
+        monkeypatch.setenv("HERMES_HOME", str(ambient))
+        with _db(ambient / "kanban" / "origin-ledger.db"):
+            pass
+        mail_config = tmp_path / "hermes-mail.json"
+        mail_config.write_text(json.dumps({"gateway": "macbook"}))
+        monkeypatch.setenv("HERMES_MAIL_CONFIG", str(mail_config))
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))  # origin-ledger fingerprint belongs to this fixture too
     monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
     monkeypatch.setenv("HERMES_HUB_STATE", str(tmp_path / "hub-state"))  # never the real hermes-hub replica
     ksa._reset_cache_for_tests()
@@ -899,6 +911,7 @@
         conn.execute("INSERT OR REPLACE INTO replica VALUES (?, ?, ?, 1, ?, ?, 0)", (gw, coll, key, seq, data))
 
 
+@pytest.mark.parametrize("kanban_root", [False, True], indirect=True, ids=["empty-home", "ambient-ledger"])
 def test_hub_session_rows_do_not_invalidate_the_remote_links_projection(kanban_root, monkeypatch):
     """hub-sync rewrites ~10k replica ``sessions`` rows continuously. The projection reads only ``tasks`` and
     ``gateway`` rows, so a sessions write must not force every reader to re-project (2026-10-27: ~19% of a Desktop
@@ -913,11 +926,20 @@
     projections: list[int] = []
     real = ksa._project_remote_links
     monkeypatch.setattr(ksa, "_project_remote_links", lambda: projections.append(1) or real())
-    monkeypatch.setattr(ksa, "_CACHE_TTL_S", 300.0)  # isolate the fingerprint from the TTL
+    from types import SimpleNamespace
+
+    # This test measures invalidation, not expiry; freeze only this consumer's clock.
+    monkeypatch.setattr(ksa, "time", SimpleNamespace(monotonic=lambda: 100.0, time=ksa.time.time))
 
     first = ksa._remote_links()
+    ambient_ledger = kanban_root / "ambient-home" / "kanban" / "origin-ledger.db"
     for n in range(5):
         _replica_write(path, "mini", "sessions", f"s_{n}", seq=10 + n)
+        if ambient_ledger.exists() and n in (1, 3):
+            # Real commits elsewhere must not enter this fixture's fingerprint.
+            with sqlite3.connect(ambient_ledger) as conn:
+                conn.execute("CREATE TABLE IF NOT EXISTS fixture_churn (value INTEGER)")
+                conn.execute("INSERT INTO fixture_churn VALUES (?)", (n,))
         assert ksa._remote_links() == first
     assert len(projections) == 1
 
