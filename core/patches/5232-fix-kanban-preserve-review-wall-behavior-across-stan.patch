From 8178f1cb3d8976da2513cce70ba057be805d5349 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 12:57:21 +0000
Subject: [PATCH] fix(kanban): preserve review wall behavior across standard
 fallback [daveey]

Keep legacy boolean live-wall refusals unavailable without manufacturing a deadline. Adapt admission fixtures to independent route levels and cover deferred standard reviewers plus unwalled standard fallback. Rebase integration proof: 40 consumer files, 1103 passed; all 21 scripts/check gates passed.
---
 hermes_cli/kanban_review_model.py                    |  7 ++++---
 .../hermes_cli/test_kanban_review_wall_admission.py  | 12 +++++++-----
 2 files changed, 11 insertions(+), 8 deletions(-)

diff --git a/hermes_cli/kanban_review_model.py b/hermes_cli/kanban_review_model.py
index 9dcd3845c5..c7fee60f78 100644
--- a/hermes_cli/kanban_review_model.py
+++ b/hermes_cli/kanban_review_model.py
@@ -378,13 +378,14 @@ def resolve_review_model(conn, task, cfg):
         norm = pw._norm(provider)
         if not norm or norm == "auto":
             return True
-        deadlines = [value for value in (walls.get(norm), holds.get(norm), pw.live_quota_wall(norm, model))
-                     if isinstance(value, (int, float)) and value > now]
+        live_wall = pw.live_quota_wall(norm, model)
+        deadlines = [value for value in (walls.get(norm), holds.get(norm), live_wall)
+                     if isinstance(value, (int, float)) and not isinstance(value, bool) and value > now]
         if deadlines:
             if registry_refusal(model, provider, assignee) is None:
                 waits.append(max(deadlines))  # a route needs ALL its overlapping walls/holds to clear
             return True
-        return False
+        return live_wall is True  # legacy boolean unavailability has no provable deferral deadline
 
     # A concrete, independent handoff override is honored unless its pool is held or walled (the fast return
     # used to skip that check and run the reviewer into the hold/wall): then the next independent route takes it.
diff --git a/tests/hermes_cli/test_kanban_review_wall_admission.py b/tests/hermes_cli/test_kanban_review_wall_admission.py
index bfe03cc0bd..bd875f9789 100644
--- a/tests/hermes_cli/test_kanban_review_wall_admission.py
+++ b/tests/hermes_cli/test_kanban_review_wall_admission.py
@@ -14,16 +14,17 @@ START = 1_800_000_000
 RESET = START + 7200
 
 
+@pytest.mark.parametrize("route_level", ["deep", "standard"])
 @pytest.mark.parametrize("source", ["wall", "hold", "live", "overlap"])
 @pytest.mark.parametrize("lane", ["review", "ready"])
 def test_walled_review_not_claimed_and_unwalled_host_claims(
-        board, monkeypatch, all_assignees_spawnable, source, lane):
+        board, monkeypatch, all_assignees_spawnable, source, lane, route_level):
     clock = [START]
     monkeypatch.setattr(kb.time, "time", lambda: clock[0])
     monkeypatch.setattr(tier, "load_tier_config", lambda: {"enabled": True})
     monkeypatch.setattr(review, "implementer_models", lambda *_a: {"gpt-6-astra", "gpt-6.1-sol"})
-    monkeypatch.setattr(review, "independent_routes", lambda *_a: iter([
-        ("claude-fable-5-2", "anthropic"), ("claude-opus-5-5", "anthropic")]))
+    monkeypatch.setattr(review, "independent_routes", lambda *_a, level="deep": iter([
+        ("claude-fable-5-2", "anthropic"), ("claude-opus-5-5", "anthropic")] if level == route_level else []))
     monkeypatch.setattr(review, "registry_refusal", lambda *_a: None)
     blocked = [True]
     monkeypatch.setattr(walls, "active_walls", lambda **_kw: (
@@ -60,7 +61,7 @@ def test_walled_review_not_claimed_and_unwalled_host_claims(
         assert seen == [tid]
 
 
-@pytest.mark.parametrize("case", ["alternate", "expiry", "dry_run", "structural", "registry", "race", "earliest"])
+@pytest.mark.parametrize("case", ["alternate", "standard", "expiry", "dry_run", "structural", "registry", "race", "earliest"])
 def test_review_wait_boundaries(board, monkeypatch, case):
     from hermes_cli import kanban_review_admission as admission
 
@@ -72,7 +73,8 @@ def test_review_wait_boundaries(board, monkeypatch, case):
         routes.append(("gpt-6.1-sol", "openai-codex"))
     if case == "structural":
         routes = []
-    monkeypatch.setattr(review, "independent_routes", lambda *_a: iter(routes))
+    monkeypatch.setattr(review, "independent_routes", lambda *_a, level="deep": iter(
+        routes if level == "deep" else [("gpt-6.1-sol", "openai-codex")] if case == "standard" else []))
     monkeypatch.setattr(review, "registry_refusal", lambda *_a: "refused" if case == "registry" else None)
     walled = {"anthropic": START - 1 if case == "expiry" else RESET}
     if case == "earliest":
