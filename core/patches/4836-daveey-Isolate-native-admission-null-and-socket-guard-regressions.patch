From 6f66dc46aea624977379df98a21bcc43957080f0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 09:46:42 +0000
Subject: [PATCH] [daveey] Isolate native admission null and socket guard
 regressions

---
 .../test_origin_native_admission.py           | 19 +++++++++++++
 .../tools/test_origin_cli_transport_guards.py | 28 +++++++++++++++++++
 2 files changed, 47 insertions(+)

diff --git a/tests/hermes_cli/test_origin_native_admission.py b/tests/hermes_cli/test_origin_native_admission.py
index 5a9bc6db9550e2224dba2082c88239ebda092d46..6da0892d7f7b34fdfc7c454b3471129a1d8ac0bf 100644
--- a/tests/hermes_cli/test_origin_native_admission.py
+++ b/tests/hermes_cli/test_origin_native_admission.py
@@ -74,6 +74,25 @@ def test_real_tool_create_is_atomic(turn, monkeypatch, revocation):
             assert snapshot(conn) == before
 
 
+@pytest.mark.parametrize("missing", ["context", "scope", "binding"])
+def test_receipt_null_boundaries_refuse_before_admit(monkeypatch, missing):
+    origin = {"session": "fixture-chat"}
+    owner = {"gateway": "here", "profile": "default", "board": "default", "task_id": "fixture-task"}
+    context = None if missing == "context" else {"origin": origin}
+    primary = None if missing == "scope" else ("here", "default", "default")
+    binding = None if missing == "binding" else {"origin": origin, "owner": owner}
+    monkeypatch.setattr(native, "_primary_scope", lambda conn: primary)
+    monkeypatch.setattr(native, "_receipt", lambda conn, task: binding)
+    state = admission._Admission(SimpleNamespace(validated=lambda: context))
+    token = admission._current.set(state)
+    try:
+        with pytest.raises(admission.AdmissionRefused, match="lost custody"):
+            admission.require_receipt(object(), "fixture-task")
+        assert state.admitted == set()
+    finally:
+        admission._current.reset(token)
+
+
 def test_no_ambient_authority(turn):
     turn.release()
     with pytest.raises(admission.AdmissionRefused):
diff --git a/tests/tools/test_origin_cli_transport_guards.py b/tests/tools/test_origin_cli_transport_guards.py
index 28cab20db3867e71aeccf9b3ae0fc818d205d846..d393797ed1201d289831e91d6453f61bcf82c2d7 100644
--- a/tests/tools/test_origin_cli_transport_guards.py
+++ b/tests/tools/test_origin_cli_transport_guards.py
@@ -60,6 +60,34 @@ def test_wrong_reply_socket_is_rejected(echo_launch, family, kind):
     assert echo_launch.retire() == []
 
 
+@pytest.mark.parametrize("side,family,kind", [
+    ("reply", socket.AF_INET, socket.SOCK_SEQPACKET),
+    ("reply", socket.AF_UNIX, socket.SOCK_STREAM),
+    ("channel", socket.AF_INET, socket.SOCK_SEQPACKET),
+])
+def test_socket_predicates_stop_at_first_boundary(monkeypatch, echo_launch, side, family, kind):
+    class Socket:
+        def __enter__(self):
+            return self
+        def __exit__(self, *args):
+            pass
+        def settimeout(self, timeout):
+            pass
+    fake = Socket()
+    fake.family, fake.type = family, kind
+    def forbidden(*args):
+        pytest.fail("invalid socket crossed its validation boundary")
+    monkeypatch.setattr(bridge.socket, "socket", lambda **kw: fake)
+    if side == "reply":
+        monkeypatch.setattr(bridge.select, "poll", forbidden)
+        echo_launch._handle(bridge._encode({"nonce": echo_launch._nonce, "args": {}}), 0, [42])
+        assert echo_launch.retire() == []
+    else:
+        monkeypatch.setattr(bridge.os, "dup", lambda fd: 42)
+        monkeypatch.setattr(bridge.socket, "socketpair", forbidden)
+        assert bridge.request(json.dumps({"fd": 42, "nonce": "x"}), {})["outcome"] == "outcome_unknown"
+
+
 def test_encode_limit_is_enforced():
     with pytest.raises(ValueError, match="too large"):
         bridge._encode("x" * bridge.LIMIT)
