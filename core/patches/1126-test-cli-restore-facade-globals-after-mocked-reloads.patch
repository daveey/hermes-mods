From f9e37f8dd9825863dcf87eaf7fd8803e707dc1f7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 04:15:35 +0000
Subject: [PATCH] test(cli): restore facade globals after mocked reloads
 [daveey]

---
 .../hermes_cli/test_cli_interrupt_ack_race.py | 23 +++++++++++++++----
 tests/hermes_cli/test_cli_new_session.py      | 20 ++++++++++++----
 2 files changed, 34 insertions(+), 9 deletions(-)

diff --git a/tests/hermes_cli/test_cli_interrupt_ack_race.py b/tests/hermes_cli/test_cli_interrupt_ack_race.py
index 0b3d9c0e7b6..b7c6ff2e71a 100644
--- a/tests/hermes_cli/test_cli_interrupt_ack_race.py
+++ b/tests/hermes_cli/test_cli_interrupt_ack_race.py
@@ -63,11 +63,14 @@ def _make_cli():
         "prompt_toolkit.formatted_text": MagicMock(),
         "prompt_toolkit.auto_suggest": MagicMock(),
     }
-    with patch.dict(sys.modules, prompt_toolkit_stubs), patch.dict(
-        "os.environ", clean_env, clear=False
-    ):
-        import cli as _cli_mod
-
+    import cli as _cli_mod
+
+    # sys.modules restoration cannot undo names bound by reload (notably
+    # _pt_print and _PT_ANSI). Restore the facade's namespace as well, including
+    # on constructor failure, so subsequent tests keep real terminal output.
+    with patch.dict(_cli_mod.__dict__), patch.dict(
+        sys.modules, prompt_toolkit_stubs
+    ), patch.dict("os.environ", clean_env, clear=False):
         _cli_mod = importlib.reload(_cli_mod)
         with patch.object(_cli_mod, "get_tool_definitions", return_value=[]), patch.dict(
             _cli_mod.__dict__, {"CLI_CONFIG": _clean_config}
@@ -75,6 +78,16 @@ def _make_cli():
             return _cli_mod.HermesCLI()
 
 
+def test_make_cli_preserves_real_terminal_output(capsys):
+    """Constructing a stubbed CLI must not silence later resume/status output."""
+    import cli as cli_mod
+
+    _make_cli()
+    cli_mod._cprint("terminal output survives CLI construction")
+
+    assert "terminal output survives CLI construction" in capsys.readouterr().out
+
+
 class _StubAgent:
     """Agent whose turn completes WITHOUT acknowledging the interrupt."""
 
diff --git a/tests/hermes_cli/test_cli_new_session.py b/tests/hermes_cli/test_cli_new_session.py
index b4d8641f4e3..9a46c448a29 100644
--- a/tests/hermes_cli/test_cli_new_session.py
+++ b/tests/hermes_cli/test_cli_new_session.py
@@ -109,11 +109,13 @@ def _make_cli(env_overrides=None, config_overrides=None, **kwargs):
         "prompt_toolkit.formatted_text": MagicMock(),
         "prompt_toolkit.auto_suggest": MagicMock(),
     }
-    with patch.dict(sys.modules, prompt_toolkit_stubs), patch.dict(
-        "os.environ", clean_env, clear=False
-    ):
-        import cli as _cli_mod
+    import cli as _cli_mod
 
+    # reload binds prompt_toolkit mocks into cli's globals; restoring only
+    # sys.modules leaves subsequent status output silently mocked out.
+    with patch.dict(_cli_mod.__dict__), patch.dict(
+        sys.modules, prompt_toolkit_stubs
+    ), patch.dict("os.environ", clean_env, clear=False):
         _cli_mod = importlib.reload(_cli_mod)
         with patch.object(_cli_mod, "get_tool_definitions", return_value=[]), patch.dict(
             _cli_mod.__dict__, {"CLI_CONFIG": _clean_config}
@@ -121,6 +123,16 @@ def _make_cli(env_overrides=None, config_overrides=None, **kwargs):
             return _cli_mod.HermesCLI(**kwargs)
 
 
+def test_make_cli_preserves_real_terminal_output(capsys):
+    """Constructing a stubbed CLI must not silence later resume/status output."""
+    import cli as cli_mod
+
+    _make_cli()
+    cli_mod._cprint("terminal output survives CLI construction")
+
+    assert "terminal output survives CLI construction" in capsys.readouterr().out
+
+
 def _prepare_cli_with_active_session(tmp_path):
     cli = _make_cli()
     cli._session_db = SessionDB(db_path=tmp_path / "state.db")
-- 
