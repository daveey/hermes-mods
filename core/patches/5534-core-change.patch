index 0000000000..2486adb682
--- /dev/null
+++ b/tests/hermes_cli/test_session_source_policy_http.py
@@ -0,0 +1,54 @@
+"""HTTP payload differential against the pre-reuse source-policy algorithm."""
+
+import pytest
+
+from hermes_cli import session_listing as listing
+from tests.hermes_cli import test_profiles_sidebar_scope as fixtures
+
+_uncached_sidebar_endpoints = fixtures._uncached_sidebar_endpoints
+client = fixtures.client
+profiles_on_disk = fixtures.profiles_on_disk
+_seed_session = fixtures._seed_session
+
+
+def _legacy_policy(home):
+    policy = listing.AutomatedSourcePolicy(
+        listing._sessions_source_list(home, "automated_sources"),
+        listing._sessions_source_list(home, "interactive_sources"))
+    profile, root = listing._store_profile_and_root(home)
+    sidebar_profiles = listing._sessions_source_list(root, "sidebar_profiles")
+    if (sidebar_profiles and profile.lower() not in sidebar_profiles
+            and not listing._profile_sets_source_policy(home)):
+        return listing.AutomatedSourcePolicy(["*"])
+    return policy
+
+
+@pytest.mark.parametrize("route", ["/api/profiles/sessions", "/api/profiles/projects/tree"])
+@pytest.mark.parametrize("automated", ["include", "exclude"])
+def test_http_payload_identical_to_legacy(client, profiles_on_disk, monkeypatch, route, automated):
+    from hermes_cli.web_routers import profiles as routes
+    from hermes_cli import kanban_session_activity as activity
+    from unittest.mock import Mock
+    import time
+
+    # Keep the observation producer's clock identical, not a stripped/normalized payload.
+    clock = Mock(wraps=time)
+    clock.time.return_value = time.time() - 60
+    monkeypatch.setattr(activity, "time", clock)
+
+    for name, home in profiles_on_disk.items():
+        (home / "config.yaml").write_text(
+            "sessions:\n  interactive_sources: [desktop, cli]\n")
+        _seed_session(home, f"{name}-human", source="cli")
+        _seed_session(home, f"{name}-bot", source="eval")
+    modern = listing.automated_session_sources
+    with monkeypatch.context() as patch:
+        patch.setattr(listing, "automated_session_sources", _legacy_policy)
+        patch.setattr(routes, "automated_session_sources", _legacy_policy)
+        expected = client.get(route, params={"automated": automated})
+    monkeypatch.setattr(routes, "automated_session_sources", modern)
+    actual = client.get(route, params={"automated": automated})
+    assert expected.status_code == actual.status_code == 200
+    assert expected.json()["errors"] == []
+    assert actual.json() == expected.json()
+    assert actual.content == expected.content
diff --git a/tests/hermes_cli/test_session_source_policy_reuse.py b/tests/hermes_cli/test_session_source_policy_reuse.py
new file mode 100644
index 0000000000..aa0f5195c3
--- /dev/null
+++ b/tests/hermes_cli/test_session_source_policy_reuse.py
@@ -0,0 +1,84 @@
+"""Source-policy reuse retains payloads without retaining config across calls."""
+
+import copy
+
+import pytest
+
+from hermes_cli import config, session_listing as listing
+from hermes_constants import get_hermes_home
+
+
+def test_policy_reads_each_home_once_and_preserves_stamped_payload(monkeypatch, tmp_path):
+    root = tmp_path / "home"
+    root.mkdir()
+    (root / "config.yaml").write_text(
+        "sessions:\n  automated_sources: ' EVAL, cron '\n"
+        "  interactive_sources: [desktop, CLI]\n  sidebar_profiles: [default]\n"
+    )
+    original = config.load_config_readonly
+    calls = []
+
+    def counted():
+        calls.append(str(get_hermes_home()))
+        return original()
+
+    monkeypatch.setattr(config, "load_config_readonly", counted)
+    rows = [
+        {"id": "human", "source": "local", "created_source": "desktop"},
+        {"id": "bot", "source": "eval"},
+        {"id": "unknown", "source": "new-bot"},
+        {"id": "legacy", "source": None},
+    ]
+    expected = listing.stamp_automated(
+        copy.deepcopy(rows), automated_sources=listing.AutomatedSourcePolicy(
+            ["eval", "cron"], ["desktop", "cli"]
+        )
+    )
+    assert listing.stamp_automated(copy.deepcopy(rows), root) == expected
+    assert calls == [str(root)]
+
+
+def test_fresh_policies_observe_file_env_and_root_edits(monkeypatch, tmp_path):
+    root = tmp_path / "home"
+    named = root / "profiles" / "bot"
+    named.mkdir(parents=True)
+    (root / "config.yaml").write_text("sessions:\n  sidebar_profiles: [default]\n")
+    path = named / "config.yaml"
+    path.write_text("sessions:\n  interactive_sources: '${D2_HUMAN_SOURCES}'\n")
+    monkeypatch.setenv("D2_HUMAN_SOURCES", "desktop,cli")
+    first = listing.automated_session_sources(named)
+    assert first.interactive == ["desktop", "cli"]
+    first.interactive.append("eval")
+    first.append("*")
+    second = listing.automated_session_sources(named)
+    assert not list(second)
+    assert second.interactive == ["desktop", "cli"]
+    monkeypatch.setenv("D2_HUMAN_SOURCES", "cli")
+    assert listing.automated_session_sources(named).interactive == ["cli"]
+    path.write_text("{}\n")
+    assert listing.automated_session_sources(named) == ["*"]
+    (root / "config.yaml").write_text("sessions:\n  sidebar_profiles: [default, bot]\n")
+    assert not listing.automated_session_sources(named)
+    path.unlink()
+    assert not listing.automated_session_sources(named)
+
+
+def test_errors_restore_home_and_do_not_memoize_fallback(monkeypatch, tmp_path):
+    from hermes_cli.config_backend import ConfigBackendUnavailable
+
+    prior_home = get_hermes_home()
+    home = tmp_path / "profile"
+    with monkeypatch.context() as patch:
+        def unavailable():
+            raise ConfigBackendUnavailable("D2 synthetic unavailable")
+        patch.setattr(config, "load_config_readonly", unavailable)
+        with pytest.raises(ConfigBackendUnavailable, match="D2 synthetic unavailable"):
+            listing.automated_session_sources(home)
+    assert get_hermes_home() == prior_home
+    with monkeypatch.context() as patch:
+        patch.setattr(config, "load_config_readonly", lambda: {"sessions": None})
+        assert not listing.automated_session_sources(home)
+    with monkeypatch.context() as patch:
+        patch.setattr(config, "load_config_readonly", lambda: {"sessions": {"automated_sources": ["EVAL"]}})
+        assert listing.automated_session_sources(home) == ["eval"]
+    assert get_hermes_home() == prior_home
