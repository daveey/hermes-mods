+    if (commit.trace) {
+      const scope = owner && typeof owner === 'object' ? owner : { profile: owner }
+      await Promise.resolve().then(() => hermesApiAs<{ id: string; archived?: boolean | number }>({ connectionId: scope.connectionId ?? null, profile: scope.profile ?? null },
