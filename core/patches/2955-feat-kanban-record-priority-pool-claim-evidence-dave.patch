Subject: [PATCH] feat(kanban): record priority pool claim evidence [daveey]

---
 hermes_cli/kanban_admission.py                |  2 ++
 hermes_cli/kanban_admission_pools.py          |  5 ++++-
 tests/hermes_cli/test_kanban_hub_admission.py | 14 ++++++++++++++
 3 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_admission.py b/hermes_cli/kanban_admission.py
index 8af3a43a8b..efabc0cb35 100644
--- a/hermes_cli/kanban_admission.py
+++ b/hermes_cli/kanban_admission.py
@@ -167,6 +167,8 @@ def _final_hub_gate(gate, started=None, *, conn=None, task_id=None):
     counts = getattr(_decision, "counts", None) or {}
     admission = {k: counts[k] for k in ("active_before", "active_after", "excluded_run_uid")} \
         if counts.get("excluded_run_uid") else None
+    if "pools" in counts:
+        admission = {**(admission or {}), "pool": _decision.pool, "pools": counts["pools"]}
     return None, {**{k: measured[k] for k in cpu.FIELDS}, "limit_pct": limit,
                   **({"hub_admission": admission} if admission else {})}
 
diff --git a/hermes_cli/kanban_admission_pools.py b/hermes_cli/kanban_admission_pools.py
index 818e63bb41..fbff6d55aa 100644
--- a/hermes_cli/kanban_admission_pools.py
+++ b/hermes_cli/kanban_admission_pools.py
@@ -25,7 +25,7 @@ def board_pools(conn, *, own=None, excluded=()):
     ):
         if run_id in excluded:
             continue
-        pool = pool or "regular"
+        pool = "regular" if pool is None else pool
         if pool not in counts:
             raise ValueError("unknown admission pool receipt")
         counts[pool] += 1
@@ -73,6 +73,9 @@ def candidate_pool(conn, task_id, regular_cap, *, echo=None):
     active = machine_metrics.active_card_runs(exclude=echo, detail=detail)
     if row is None or active is None:
         return None, ceiling, detail
+    detail.update(active_before=active + detail.get("excluded", 0), active_after=active)
+    if echo is not None and detail.get("excluded"):
+        detail["excluded_run_uid"] = echo.run_uid
     counts = detail["pools"]
     pool = select_pool(row[0], **counts, regular_cap=regular_cap, priority_cap=slots)
     return pool, ceiling, detail
diff --git a/tests/hermes_cli/test_kanban_hub_admission.py b/tests/hermes_cli/test_kanban_hub_admission.py
index ba32ded19d..189f70205d 100644
--- a/tests/hermes_cli/test_kanban_hub_admission.py
+++ b/tests/hermes_cli/test_kanban_hub_admission.py
@@ -171,6 +171,20 @@ def test_urgent_claim_uses_extra_pool_with_regular_pool_full(board, monkeypatch,
     assert claim(conn, candidate, review) is not None
     receipt = conn.execute("SELECT admission_pool FROM task_runs WHERE task_id=?", (candidate,)).fetchone()
     assert receipt[0] == "priority"
+    event = next(event for event in kb.list_events(conn, candidate) if event.kind == "claimed")
+    assert event.payload["hub_admission"]["pool"] == "priority"
+    assert event.payload["hub_admission"]["pools"] == {"regular": 7, "priority": 0}
+    assert event.payload["hub_cpu"]["limit_pct"] == 85
+
+
+@pytest.mark.parametrize("bad", ["", "unrecognized"])
+def test_unknown_pool_receipt_invalidates_census(board, bad):
+    conn, _home = board
+    task_id = task(conn)
+    assert kb.claim_task(conn, task_id)
+    with kb.write_txn(conn):
+        conn.execute("UPDATE task_runs SET admission_pool=? WHERE task_id=?", (bad, task_id))
+    assert mm.active_card_runs(detail={"pools": {"regular": 0, "priority": 0}}) is None
 
 
 def test_capacity_class_and_frees_claim_survive_task_readback(board):
