From 04a48498a14779967e300c16d29b2013ecb81a4f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 20:52:33 +0000
Subject: [PATCH] fix(desktop): keep an entered empty auto project in the
 alphabetical sidebar [daveey]

Review of #1132 (t_01a1cc566d1e0174): sidebarProjectsShown ran the legacy
session-bearing prefilter before the strict non-empty filter, so an entered
empty AUTO project was dropped before keepId could keep it and the scope
bounced back to the overview. The strict filter already drops empty auto
repos, so apply it alone in alphabetical mode.

Proof: new unit + integration cases fail on the previous source (2 red) and
pass now; sidebar vitest 531/531, tsc, eslint, health clean.
---
 .../chat/sidebar/chat-sidebar.integration.test.tsx   | 12 ++++++++++++
 .../src/app/chat/sidebar/project-filter.test.ts      | 10 ++++++++++
 apps/desktop/src/app/chat/sidebar/project-filter.ts  |  8 +++++---
 3 files changed, 27 insertions(+), 3 deletions(-)

diff --git a/apps/desktop/src/app/chat/sidebar/chat-sidebar.integration.test.tsx b/apps/desktop/src/app/chat/sidebar/chat-sidebar.integration.test.tsx
index 1ae444f0d70..70635e8e9ea 100644
--- a/apps/desktop/src/app/chat/sidebar/chat-sidebar.integration.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/chat-sidebar.integration.test.tsx
@@ -349,6 +349,18 @@ describe('ChatSidebar project entry', () => {
 
     expect($currentCwd.get()).toBe(project.path)
   })
+
+  it('stays inside an entered empty auto project instead of bouncing to the overview', () => {
+    // A non-empty sibling keeps the overview live, which is what arms the scope reset.
+    const sibling = { ...project, id: '/repos/busy', label: 'busy', path: '/repos/busy', sessionCount: 2 }
+
+    $projectTree.set([{ ...project, isAuto: true, sessionCount: 0 }, sibling])
+    $projectScope.set(project.id)
+
+    renderSidebar('/', 'chat')
+
+    expect($projectScope.get()).toBe(project.id)
+  })
 })
 
 // A brand-new chat in a folder no project claims (a CLI started in ~) has no
diff --git a/apps/desktop/src/app/chat/sidebar/project-filter.test.ts b/apps/desktop/src/app/chat/sidebar/project-filter.test.ts
index 8bae883e1fa..45f9ab01e8d 100644
--- a/apps/desktop/src/app/chat/sidebar/project-filter.test.ts
+++ b/apps/desktop/src/app/chat/sidebar/project-filter.test.ts
@@ -101,6 +101,16 @@ describe('sidebar project policy (alphabetical, no empties)', () => {
     expect(sidebarProjectsShown(projects, 'explicit_empty').map(p => p.id)).toEqual(['home', 'explicit_empty', 'busy'])
   })
 
+  it('keeps an entered empty AUTO project too', () => {
+    const projects = [
+      { id: 'auto_empty', isAuto: true, sessionCount: 0 },
+      { id: 'busy', isAuto: true, sessionCount: 2 }
+    ]
+
+    expect(sidebarProjectsShown(projects).map(p => p.id)).toEqual(['busy'])
+    expect(sidebarProjectsShown(projects, 'auto_empty').map(p => p.id)).toEqual(['auto_empty', 'busy'])
+  })
+
   it('sorts alphabetically and drops the drag handle', () => {
     const handler = () => undefined
 
diff --git a/apps/desktop/src/app/chat/sidebar/project-filter.ts b/apps/desktop/src/app/chat/sidebar/project-filter.ts
index f013c5d2db1..42a8e655461 100644
--- a/apps/desktop/src/app/chat/sidebar/project-filter.ts
+++ b/apps/desktop/src/app/chat/sidebar/project-filter.ts
@@ -58,9 +58,11 @@ export function filterToNonEmptyProjects<T extends { id: string; isNoProject?: b
 export function sidebarProjectsShown<
   T extends { id: string; isAuto?: boolean; isNoProject?: boolean; sessionCount?: number }
 >(projects: readonly T[], keepId?: null | string): T[] {
-  const bearing = filterToSessionBearingProjects(projects)
-
-  return SIDEBAR_PROJECTS_ALPHABETICAL ? filterToNonEmptyProjects(bearing, keepId) : bearing
+  // The strict filter already drops empty auto repos; running the session-bearing one first would
+  // also drop an entered empty auto repo before `keepId` could keep it.
+  return SIDEBAR_PROJECTS_ALPHABETICAL
+    ? filterToNonEmptyProjects(projects, keepId)
+    : filterToSessionBearingProjects(projects)
 }
 
 export function filterToSessionBearingProjects<
