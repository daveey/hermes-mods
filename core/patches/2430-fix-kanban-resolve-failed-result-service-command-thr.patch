From 09ba4a0ff525bef7d4b9c9f48e10d9d57e8613bf Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 02:19:57 +0000
Subject: [PATCH] fix(kanban): resolve failed-result service command through
 platform API [daveey]

---
 hermes_cli/kanban_failed_result_service.py                 | 7 ++++---
 .../hermes_cli/test_kanban_failed_result_launch_safety.py  | 2 +-
 tests/hermes_cli/test_kanban_failed_result_observer.py     | 5 +++--
 3 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_failed_result_service.py b/hermes_cli/kanban_failed_result_service.py
index c0ca55fafe..0d8bf60d1e 100644
--- a/hermes_cli/kanban_failed_result_service.py
+++ b/hermes_cli/kanban_failed_result_service.py
@@ -3,13 +3,14 @@ from __future__ import annotations
 
 import json
 import os
-import shutil
 import subprocess
 import sys
 import tempfile
 import time
 from pathlib import Path
 
+from hermes_platform.resolver import locate_command
+
 
 def arm_service(context, *, startup_seconds=5.0):
     """Acknowledge initialized board access only after systemd takes custody.
@@ -21,7 +22,7 @@ def arm_service(context, *, startup_seconds=5.0):
     from tools.process_registry import systemd_user_bus_env
     from hermes_cli._startup_fast import project_root_str
 
-    binary = shutil.which('systemd-run')
+    binary = locate_command('systemd-run').command
     if not binary:
         raise RuntimeError('failed-result observer needs systemd-run')
     directory = Path(tempfile.mkdtemp(prefix='failed-result-', dir=Path(context['db']).parent))
@@ -30,7 +31,7 @@ def arm_service(context, *, startup_seconds=5.0):
     unit = f'hermes-failed-result-{os.getpid()}-{time.monotonic_ns()}.service'
     context['observer_unit'] = unit
     env = build_subprocess_env(extra=systemd_user_bus_env())
-    command = [binary, '--user', '--quiet', '--collect', f'--unit={unit}',
+    command = [*binary, '--user', '--quiet', '--collect', f'--unit={unit}',
                '--property=Type=exec', '--property=Slice=app.slice',
                '--property=Restart=on-failure', '--property=RestartSec=500ms',
                '--property=RestartForceExitStatus=SIGTERM SIGHUP SIGINT SIGPIPE',
diff --git a/tests/hermes_cli/test_kanban_failed_result_launch_safety.py b/tests/hermes_cli/test_kanban_failed_result_launch_safety.py
index 830e7f7f22..d885fca1df 100644
--- a/tests/hermes_cli/test_kanban_failed_result_launch_safety.py
+++ b/tests/hermes_cli/test_kanban_failed_result_launch_safety.py
@@ -40,7 +40,7 @@ def test_service_uses_canonical_install_root_and_reads_readiness(board, tmp_path
     root = tmp_path / 'canonical-install'
     root.mkdir()
     monkeypatch.setattr(_startup_fast, 'project_root_str', lambda: str(root))
-    monkeypatch.setattr(service.shutil, 'which', lambda name: '/usr/bin/systemd-run')
+    monkeypatch.setattr(service, 'locate_command', lambda name: SimpleNamespace(command=('/usr/bin/systemd-run',)))
     calls = []
 
     def submit(command, **kwargs):
diff --git a/tests/hermes_cli/test_kanban_failed_result_observer.py b/tests/hermes_cli/test_kanban_failed_result_observer.py
index 64bd19f2c4..7b14925a3f 100644
--- a/tests/hermes_cli/test_kanban_failed_result_observer.py
+++ b/tests/hermes_cli/test_kanban_failed_result_observer.py
@@ -3,6 +3,7 @@ import contextlib
 import json
 import os
 from pathlib import Path
+from types import SimpleNamespace
 
 import pytest
 
@@ -86,7 +87,7 @@ def test_failed_arm_keeps_result_and_records_diagnostic(board, monkeypatch):
 @pytest.mark.parametrize('ack', ['correct', 'wrong', 'none', 'refused'])
 def test_service_custody_requires_exact_readiness_ack(board, monkeypatch, ack):
     _, context = board
-    monkeypatch.setattr(service.shutil, 'which', lambda name: '/usr/bin/systemd-run')
+    monkeypatch.setattr(service, 'locate_command', lambda name: SimpleNamespace(command=('/usr/bin/systemd-run',)))
     times = iter([0, 0, 2])
     monkeypatch.setattr(service.time, 'monotonic', lambda: next(times))
     monkeypatch.setattr(service.time, 'sleep', lambda _: None)
@@ -111,6 +112,6 @@ def test_service_custody_requires_exact_readiness_ack(board, monkeypatch, ack):
 
 def test_missing_manager_is_not_reported_as_custody(board, monkeypatch):
     _, context = board
-    monkeypatch.setattr(service.shutil, 'which', lambda name: None)
+    monkeypatch.setattr(service, 'locate_command', lambda name: SimpleNamespace(command=()))
     with pytest.raises(RuntimeError, match='needs systemd-run'):
         service.arm_service(context)
-- 
2.43.0

