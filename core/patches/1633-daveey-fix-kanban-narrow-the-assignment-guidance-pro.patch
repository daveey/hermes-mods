From 6ea8987d2a7472168a3e0270cc0d404a8bb1ecf2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 04:10:26 +0000
Subject: [PATCH] [daveey] fix(kanban): narrow the assignment-guidance probe's
 except to sqlite/config errors

---
 hermes_cli/kanban_block_policy.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_block_policy.py b/hermes_cli/kanban_block_policy.py
index 2a86ea28b50..c8e408ba784 100644
--- a/hermes_cli/kanban_block_policy.py
+++ b/hermes_cli/kanban_block_policy.py
@@ -94,7 +94,7 @@ def _assignment_routes(task) -> bool:
         from hermes_cli.kanban_assignment_routing import supervisor_available
         row = kb.get_task(task[0], task[1])
         return row is not None and supervisor_available(row)
-    except Exception:  # guidance only: an unreadable config or card never offers a route that may fail
+    except (sqlite3.Error, ValueError, OSError):  # an unreadable card or profile never offers a route that may fail
         return False
 
 
