index 48a90151730ad41c6f69f60828ac3d89c116c4f4..0edfe8e97f9c3b1b9f80dd81dd4f989584b4dc92 100644
--- a/apps/desktop/electron/remote-lifecycle.ts
+++ b/apps/desktop/electron/remote-lifecycle.ts
@@ -825,6 +825,65 @@ async function disconnect(ssh, ownershipId) {
   await cleanupStale(ssh, ownershipId, lock, pidAlive)
 }
 
+// Normal disconnect that keeps the owned backend for the next connect (W0, ssh-teardown-policy.ts): nothing is
+// killed and the lockfile stays, so reconnecting with the persisted token reuses the backend instead of paying a
+// cold spawn. The backend's idle watchdog retires it if nobody comes back. Skewed or missing records are left alone.
+async function release(ssh, ownershipId, log: (line: string) => void = () => {}) {
+  if (!ssh || !ownershipId) {
+    return
+  }
+
+  const lock = await readLockfile(ssh, ownershipId)
+
+  if (!lock || isLockfileSkew(lock)) {
+    return
+  }
+
+  log(`[ssh-lifecycle] released remote dashboard pid=${lock.pid} port=${lock.port}; it exits on its own when idle`)
+}
+
+// Log why a present lockfile was not reused, so reuse misses can be counted from the lifecycle log.
+function logReuseMiss(log: (line: string) => void, lock, ctx) {
+  if (!ctx.reusable) {
+    log(`reuse miss: ${reuseMissReasons(lock, ctx).join('; ') || 'unknown'}`)
+  }
+}
+
+// Why a present lockfile was not reused. Empty when every reuse condition holds.
+function reuseMissReasons(lock, { pidAlive, owned, profile, reuseToken, hermesPath, hermesHome }): string[] {
+  const reasons: string[] = []
+
+  if (!pidAlive) {
+    reasons.push(`pid ${lock.pid} not alive`)
+  } else if (!owned) {
+    reasons.push(`pid ${lock.pid} is not our dashboard`)
+  }
+
+  if (!(lock.port > 0)) {
+    reasons.push('no port recorded')
+  }
+
+  if (lock.profile !== profile) {
+    reasons.push(`profile ${lock.profile || "''"} != ${profile || "''"}`)
+  }
+
+  if (!reuseToken) {
+    reasons.push('no stored token')
+  } else if (lock.tokenFingerprint !== fingerprintToken(reuseToken)) {
+    reasons.push('token fingerprint mismatch')
+  }
+
+  if (lock.hermesPath !== hermesPath) {
+    reasons.push(`hermes path ${lock.hermesPath} != ${hermesPath}`)
+  }
+
+  if (lock.hermesHome !== hermesHome) {
+    reasons.push(`hermes home ${lock.hermesHome} != ${hermesHome}`)
+  }
+
+  return reasons
+}
+
 function buildOwnedStaleTerminationCommand(lock, ownershipId) {
   const pid = Number(lock.pid)
   // expandRemotePath() output is already a shell-quoted fragment; embed it
@@ -1587,6 +1646,8 @@ async function connect(deps) {
       lock.hermesPath === hermesPath &&
       lock.hermesHome === hermesHome
 
+    logReuseMiss(log, lock, { reusable, pidAlive, owned, profile, reuseToken, hermesPath, hermesHome })
+
     if (reusable) {
       const creationTime = lock.creationTime || (await remoteProcessCreationTime(ssh, lock.pid))
 
@@ -1828,6 +1889,7 @@ export {
   readLockfile,
   readRemoteInstallId,
   READY_RE,
+  release,
   REMOTE_LOCK_DIR,
   remotePidAlive,
   remoteProcessCreationTime,
diff --git a/apps/desktop/electron/ssh-teardown-policy.ts b/apps/desktop/electron/ssh-teardown-policy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1168145e5e165e3760fa2d55f16e30d596bfeb50
--- /dev/null
+++ b/apps/desktop/electron/ssh-teardown-policy.ts
@@ -0,0 +1,85 @@
+// What a Desktop SSH teardown does to the remote `serve --isolated` backend it owns.
+//
+// A normal disconnect (quit, a broken tunnel being rebuilt, revalidation, resume from sleep, the idle pool stop)
+// RELEASES the backend: the tunnel and SSH transport close, the backend and its lockfile stay, and the next connect
+// reuses it with the token Desktop persisted when it first adopted it. The backend's own idle watchdog
+// (hermes_cli/web_server_idle_exit.py: exit 900 s after the last client, never mid-turn) bounds how long a released
+// backend lives, so releasing does not reopen the #91668 leak.
+//
+// A deliberate change (different connection settings, a removed or switched connection, an explicit recycle)
+// TERMINATES it, as before. Any reason not listed here terminates, so a new caller errs toward the old behavior.
+// Windows remotes use their own lifecycle and are skipped, as before.
+
+export type SshTeardownReason =
+  | 'quit'
+  | 'bootstrap-retry'
+  | 'revalidate'
+  | 'resume'
+  | 'idle-stop'
+  | 'fingerprint-change'
+  | 'connection-removed'
+  | 'recycle'
+  | 'config-apply'
+  | 'profile-teardown'
+
+export type RemoteTeardownAction = 'release' | 'terminate' | 'skip-windows'
+
+const RELEASE_REASONS: ReadonlySet<SshTeardownReason> = new Set([
+  'quit',
+  'bootstrap-retry',
+  'revalidate',
+  'resume',
+  'idle-stop'
+])
+
+export function remoteTeardownAction(reason: SshTeardownReason, remoteOs: string | undefined): RemoteTeardownAction {
+  if (remoteOs === 'Windows') {
+    return 'skip-windows'
+  }
+
+  return RELEASE_REASONS.has(reason) ? 'release' : 'terminate'
+}
+
+// The cleanup a teardown runs against the remote, for teardownSshState's `cleanupRemote`. Windows remotes use
+// connectWindowsRemote, which shares no POSIX lock/kill; the log keeps quit from being a mysterious no-op there.
+export function remoteCleanupFor(
+  action: RemoteTeardownAction,
+  lifecycle: {
+    release: (ssh, ownershipId, log: (line: string) => void) => Promise<void>
+    disconnect: (ssh, ownershipId) => Promise<void>
+  },
+  log: (line: string) => void
+): (ssh, ownershipId) => Promise<void> {
+  return {
+    'skip-windows': async () =>
+      log('[ssh] skip remote serve teardown on Windows remotes; POSIX disconnect does not apply'),
+    release: (ssh, ownershipId) => lifecycle.release(ssh, ownershipId, log),
+    terminate: lifecycle.disconnect
+  }[action]
+}
+
+// Why each pool key is being stopped, carried from the caller to the pool stopper's afterStop hook. Quit, the
+// update handoff, idle retirement, resume and revalidation record a reason; uninstall and other stops record none,
+// so take() falls back to 'connection-removed' and the remote backend is terminated as before W0.
+export function createTeardownReasons() {
+  const pending = new Map<string, SshTeardownReason>()
+
+  return {
+    note(key: string, reason?: SshTeardownReason) {
+      if (reason) {
+        pending.set(key, reason)
+      }
+    },
+    noteAll(keys: Iterable<string>, reason?: SshTeardownReason) {
+      for (const key of keys) {
+        this.note(key, reason)
+      }
+    },
+    take(key: string): SshTeardownReason {
+      const reason = pending.get(key) ?? 'connection-removed'
+      pending.delete(key)
+
+      return reason
+    }
+  }
+}
