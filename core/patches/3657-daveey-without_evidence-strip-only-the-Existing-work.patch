From 4ed839bc4451523b962a284bee68d2409858e23c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 16:01:45 +0000
Subject: [PATCH] [daveey] without_evidence: strip only the "Existing work
 checked" record's first paragraph

A heading-form `## Existing work checked` section ran to the next heading, so later heading-less steps were stripped
with it: `## Existing work checked\nNone open.\n\nThen open Chrome on the MacBook...` gave `without_evidence == ''`
and `portable_reason == None`, hiding the host marker from the portability scan (fail-open; PR #2339 review
5893795853, nit 1).

Fix: the heading form now strips the heading, any blank lines after it, and one paragraph (to the next blank line or
heading), like the bold-label form. A longer record is scanned as work, which fails closed (the card stays home).

RED (before): 3 new parametrized cases of
test_heading_less_text_after_the_record_paragraph_is_still_scanned failed (text == ''); portable_reason returned None
for the example body. GREEN: they pass and portable_reason == "local marker"; the existing record-stripping cases
(including t_01a1d5386cb55abf's body) still pass. 1107 tests passed, 0 failed across the importers of
without_evidence / marker_work_text and the placement suites.

Nit 2 (docs only, no behavior change): "a worker_queue gateway never falls back to worker-first" holds only for
creation_decision; on the hub a queue miss goes to the admission judge, and a card it denies can still get
worker-first from pool_route. Qualified in db_placement's docstring, creation_decision's comment and the two tests
that repeated it.
---
 hermes_cli/kanban_placement.py                  | 11 +++++++----
 hermes_cli/kanban_worker_placement.py           |  9 ++++++---
 .../test_kanban_existing_work_checked.py        | 17 +++++++++++++++--
 tests/hermes_cli/test_kanban_pool_queue.py      |  4 ++--
 4 files changed, 30 insertions(+), 11 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 6fbfced7a5..0c74e3ebe9 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -637,11 +637,14 @@ _EVIDENCE = re.compile(re.escape(EVIDENCE_OPEN) + r".*?" + re.escape(EVIDENCE_CL
 # The "Existing work checked" record ask-gate's superseding_work rule asks every creator to write is evidence too: a
 # past search ("`hermes-hub tasks` (all boards) had no open card ..."), never work the card must do. Scanned as work,
 # its `hermes-hub tasks` read as a home coordination action, so two MacBook cards (t_01a1d5386cb55abf,
-# t_01a1d54acc8c8e54, 11-13) could run nowhere. A heading section runs to the next heading; a bold-label paragraph
-# to the next blank line. [daveey]
+# t_01a1d54acc8c8e54, 11-13) could run nowhere. Only the record's first paragraph is stripped: a heading, any blank
+# lines after it, then lines up to the next blank line or heading; a bold label runs to the next blank line. Running a
+# heading section to the next heading also swallowed later heading-less steps ("None open.\n\nThen open Chrome on
+# the MacBook"), hiding their host markers (fail-open, PR #2339 review). A longer record is scanned: fails closed.
+_RECORD_LINE = r"\n(?![ \t]*$|[ \t]*#{1,6}[ \t]).*"
 _EXISTING_WORK = re.compile(
-    r"^[ \t]*(?:#{1,6}[ \t]+Existing work checked\b[^\n]*(?:\n(?![ \t]*#{1,6}[ \t]).*)*"
-    r"|\*\*Existing work checked\b[^\n]*(?:\n(?![ \t]*\n|[ \t]*#{1,6}[ \t]).*)*)",
+    r"^[ \t]*(?:#{1,6}[ \t]+Existing work checked\b[^\n]*(?:\n[ \t]*$)*(?:" + _RECORD_LINE + r")*"
+    r"|\*\*Existing work checked\b[^\n]*(?:" + _RECORD_LINE + r")*)",
     re.IGNORECASE | re.MULTILINE)
 
 
diff --git a/hermes_cli/kanban_worker_placement.py b/hermes_cli/kanban_worker_placement.py
index 12b6d4e93c..130e7a5f6f 100644
--- a/hermes_cli/kanban_worker_placement.py
+++ b/hermes_cli/kanban_worker_placement.py
@@ -167,8 +167,9 @@ def creation_decision(args, cfg, gateway, pin, origin_intent, machine_ok=None, q
     from hermes_cli import kanban_placement as placement
     from hermes_cli import kanban_placement_coordination as coordination
     if placement._Cfg(cfg).queue_label(gateway):
-        # A worker_queue gateway never falls back to worker-first: a queue miss (no live labelled machine, a
-        # non-primary board) stays home under legacy routing. The fallback reserved one machine at a time from a
+        # On a worker_queue gateway this decision never falls back to worker-first: a queue miss (no live labelled
+        # machine, a non-primary board) stays home under legacy routing (the hub's admission judge may still route a
+        # card it denies worker-first via pool_route). The fallback reserved one machine at a time from a
         # stale worker_pools list (MacBook t_01a1d5386cb55abf: worker-2..4 only, 140 reservations). [daveey]
         return None
     pools = cfg.get("worker_pools")
@@ -232,7 +233,9 @@ def db_placement(fields):
 
     Same outcome as the front doors: a portable card of a ``worker_queue`` gateway queues for the pool label on a
     Board primary (``runs_on`` is a Board placement field); a queue miss there, or off a primary, stays home
-    (:func:`creation_decision` never falls back to worker-first on a queue gateway). Only a gateway without a
+    (:func:`creation_decision` itself never falls back to worker-first on a queue gateway; on the hub a queue miss
+    goes to the admission judge, and a card it denies can still get worker-first from
+    :func:`kanban_hub_admission_placement.pool_route`). Only a gateway without a
     ``worker_queue`` keeps worker-pool enrollment. Judging the queue but keeping only ``placement_policy`` (11-12)
     dropped both. [daveey]
     """
diff --git a/tests/hermes_cli/test_kanban_existing_work_checked.py b/tests/hermes_cli/test_kanban_existing_work_checked.py
index 12febac6bd..9333482437 100644
--- a/tests/hermes_cli/test_kanban_existing_work_checked.py
+++ b/tests/hermes_cli/test_kanban_existing_work_checked.py
@@ -6,7 +6,8 @@
 coordination action, so ``queue_decision`` returned None (``required_labels`` None). ``creation_decision`` then fell
 back to worker-first-v1 from the MacBook's stale ``worker_pools`` list, and every reserved worker's
 ``claim_refusal`` refused the same text. Three fixes, one test group each: the record is evidence, not work; a
-coordination-refused card is never enrolled; a ``worker_queue`` gateway never falls back to worker-first.
+coordination-refused card is never enrolled; ``creation_decision`` on a ``worker_queue`` gateway never falls back to
+worker-first (the hub's admission judge may still route a card it denies worker-first via ``pool_route``).
 """
 from __future__ import annotations
 
@@ -64,6 +65,18 @@ def test_an_existing_work_record_is_stripped_up_to_the_next_heading_or_paragraph
     assert "hermes-hub" not in text and "Summarise the CI failures." in text
 
 
+@pytest.mark.parametrize("body", [
+    "## Existing work checked\nNone open.\n\nThen open Chrome on the MacBook and sign in.\n",
+    "## Existing work checked\n\nNone open.\n\nThen open Chrome on the MacBook and sign in.\n",
+    "## Existing work checked\nNone open.\n\n- Then open Chrome on the MacBook and sign in.\n",
+])
+def test_heading_less_text_after_the_record_paragraph_is_still_scanned(body):
+    # RED before: the heading section ran to the next heading, so the trailing step vanished (fail-open).
+    text = kp.without_evidence(body)
+    assert "None open." not in text and "open Chrome on the MacBook" in text
+    assert kp.portable_reason(_args(body, title="sign in")) == "local marker"  # the host marker still binds
+
+
 def test_the_same_action_outside_the_record_still_stays_home():
     body = BODY.replace("## Decided fix\n", "## Decided fix\nRun `hermes-hub tasks` to list every board.\n")
     assert coordination.required_labels(_args(body), POOLS) is None
@@ -101,7 +114,7 @@ def test_a_claimable_card_still_enrolls_on_a_pool_gateway_without_a_queue():
     assert out is not None and out["placement_policy"] == wp.POLICY, out
 
 
-# --- a worker_queue gateway never falls back to worker-first ----------------------------------------------------
+# --- creation_decision on a worker_queue gateway never falls back to worker-first -------------------------------
 
 def test_a_queue_gateway_keeps_a_queue_miss_home_instead_of_worker_first():
     cfg = {**POOLS, **QUEUE}
diff --git a/tests/hermes_cli/test_kanban_pool_queue.py b/tests/hermes_cli/test_kanban_pool_queue.py
index 9b67b9d7e2..197a709842 100644
--- a/tests/hermes_cli/test_kanban_pool_queue.py
+++ b/tests/hermes_cli/test_kanban_pool_queue.py
@@ -684,8 +684,8 @@ def test_direct_create_task_queues_a_portable_card_like_the_front_doors(hub, mon
 
 
 def test_direct_create_task_keeps_a_queue_miss_home_instead_of_pool_enrollment(hub, monkeypatch):
-    """A worker_queue gateway never falls back to worker-first (MacBook t_01a1d5386cb55abf, 11-13: the fallback
-    reserved one machine at a time from a stale worker_pools list); a queue miss stays home."""
+    """creation_decision on a worker_queue gateway never falls back to worker-first (MacBook t_01a1d5386cb55abf,
+    11-13: the fallback reserved one machine at a time from a stale worker_pools list); a queue miss stays home."""
     monkeypatch.setattr(kp, "config", lambda: {**CFG, "worker_pools": {HUB: ["worker-1", "worker-2"]}})
     _registry(held=("worker-1", "worker-2"))  # no unheld machine carries the label
     tid = kb.create_task(hub.conn, title="summarise the failing CI jobs", assignee="default", requires=[])
