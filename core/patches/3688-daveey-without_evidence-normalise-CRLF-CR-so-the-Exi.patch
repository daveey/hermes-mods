From 3b5dd81a660bb6864b702e7a66d98c54be6b6e7e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 16:51:16 +0000
Subject: [PATCH] [daveey] without_evidence: normalise CRLF/CR so the "Existing
 work checked" strip can't fail open

With CRLF line endings a blank line is "\r", which matches neither the
record's `[ \t]*$` blank-line test nor a heading, so _RECORD_LINE kept
consuming lines and the "Existing work checked" record (heading or bold
label form) ran on to the next heading. "## Existing work checked\r\n
None open.\r\n\r\nThen open Chrome on the MacBook.\r\n" stripped to "\n",
hiding the MacBook host marker from portable_reason (fail-open). Raised as
a nit on PR #2383 (review 5894587994); card t_01a1d5bf2e342a4d.

Fix: without_evidence normalises "\r\n" and lone "\r" to "\n" before both
the _EVIDENCE and _EXISTING_WORK subs. Every caller (marker_work_text,
coordination, diagnostics) only scans the result, so the normalised text
is never stored. _EVIDENCE (DOTALL) and the marker scans already treat \r
as ordinary text/whitespace; normalising up front covers them too.

Proof: new test_crlf_blank_lines_still_end_the_record_paragraph (3 bodies
x {CRLF, CR}) is 6/6 red on base, green after; all 89 test files importing
kanban_placement pass (2494 tests).
---
 hermes_cli/kanban_placement.py                    |  7 +++++--
 .../test_kanban_existing_work_checked.py          | 15 +++++++++++++++
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 0c74e3ebe9..4421667295 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -650,8 +650,11 @@ _EXISTING_WORK = re.compile(
 
 def without_evidence(body: str) -> str:
     """``body`` minus every complete fenced evidence block (:data:`EVIDENCE_OPEN` ... :data:`EVIDENCE_CLOSE`) and
-    every "Existing work checked" section (:data:`_EXISTING_WORK`)."""
-    return _EXISTING_WORK.sub("", _EVIDENCE.sub("", body or ""))
+    every "Existing work checked" section (:data:`_EXISTING_WORK`). Line endings are normalised to ``\\n`` first:
+    a CRLF blank line is ``\\r``, which the record's blank-line test never matched, so the record ran on and hid
+    later host markers (fail-open, PR #2383 review). Callers only scan the result."""
+    text = (body or "").replace("\r\n", "\n").replace("\r", "\n")
+    return _EXISTING_WORK.sub("", _EVIDENCE.sub("", text))
 
 
 def structural_reason(args: dict, cfg: Optional[dict] = None) -> Optional[str]:
diff --git a/tests/hermes_cli/test_kanban_existing_work_checked.py b/tests/hermes_cli/test_kanban_existing_work_checked.py
index 9333482437..36c438241d 100644
--- a/tests/hermes_cli/test_kanban_existing_work_checked.py
+++ b/tests/hermes_cli/test_kanban_existing_work_checked.py
@@ -77,6 +77,21 @@ def test_heading_less_text_after_the_record_paragraph_is_still_scanned(body):
     assert kp.portable_reason(_args(body, title="sign in")) == "local marker"  # the host marker still binds
 
 
+@pytest.mark.parametrize("newline", ["\r\n", "\r"])
+@pytest.mark.parametrize("body", [
+    "## Existing work checked\nNone open.\n\nThen open Chrome on the MacBook and sign in.\n",
+    "## Existing work checked\n\nNone open.\n\nThen open Chrome on the MacBook and sign in.\n",
+    "**Existing work checked:** None open.\n\nThen open Chrome on the MacBook and sign in.\n",
+])
+def test_crlf_blank_lines_still_end_the_record_paragraph(body, newline):
+    # RED before: a CRLF blank line is "\r", which the blank-line test never matched, so the record ran on to the
+    # next heading and hid the trailing step's host marker (fail-open, PR #2383 review 5894587994).
+    body = body.replace("\n", newline)
+    text = kp.without_evidence(body)
+    assert "None open." not in text and "open Chrome on the MacBook" in text
+    assert kp.portable_reason(_args(body, title="sign in")) == "local marker"
+
+
 def test_the_same_action_outside_the_record_still_stays_home():
     body = BODY.replace("## Decided fix\n", "## Decided fix\nRun `hermes-hub tasks` to list every board.\n")
     assert coordination.required_labels(_args(body), POOLS) is None
