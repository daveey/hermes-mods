diff --git a/tests/hermes_cli/test_kanban_start_gate.py b/tests/hermes_cli/test_kanban_start_gate.py
new file mode 100644
index 0000000000000000000000000000000000000000..ee81acf6a9dbb7ce5a26c364d18388c2dc9f6306
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_start_gate.py
@@ -0,0 +1,87 @@
+"""The plugin start gate: a ``kanban_start_gate`` callback can keep a card ready and unclaimed for one tick. [daveey]"""
+from __future__ import annotations
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_start_gate as gate
+from hermes_cli import lifecycle
+from hermes_cli import plugins
+from tests.hermes_cli.test_kanban_llm_pacing import _dispatch, _opus_card, paced_board
+from tests.hermes_cli.test_kanban_model_tier import _write_cfg, board
+
+
+def _hook(monkeypatch, answers, seen=None):
+    """Subscribe one fake plugin: ``answers`` is a list of returns, or a callable taking the hook kwargs."""
+    def invoke(name, **kwargs):
+        assert name == gate.HOOK
+        if seen is not None:
+            seen.append(kwargs)
+        return answers(**kwargs) if callable(answers) else list(answers)
+    monkeypatch.setattr(lifecycle, "has_hook", lambda name: name == gate.HOOK)
+    monkeypatch.setattr(lifecycle, "invoke_hook", invoke)
+
+
+ASK = dict(task_id="t_1", lane="ready", assignee="default", board=None)
+
+
+def test_no_subscriber_starts_the_card(monkeypatch):
+    monkeypatch.setattr(lifecycle, "has_hook", lambda name: False)
+    monkeypatch.setattr(lifecycle, "invoke_hook", lambda *a, **k: pytest.fail("not asked without a subscriber"))
+    assert gate.hold(**ASK) is None
+
+
+def test_a_hold_answer_names_its_reason(monkeypatch):
+    seen = []
+    _hook(monkeypatch, [None, {"hold": True, "reason": "token_throttle"}], seen)
+    assert gate.hold(**ASK) == "start_gate:token_throttle"
+    assert seen == [ASK]  # the callback gets the card, its lane, assignee and board
+    _hook(monkeypatch, [{"hold": True, "reason": "Token Throttle: over the cap!!"}])
+    assert gate.hold(**ASK) == "start_gate:token_throttle_over_the_cap"  # one lowercase word, bounded
+    _hook(monkeypatch, [{"hold": True}])
+    assert gate.hold(**ASK) == "start_gate:plugin"
+    _hook(monkeypatch, [{"hold": True, "reason": "x" * 200}])
+    assert gate.hold(**ASK) == "start_gate:" + "x" * 40
+
+
+@pytest.mark.parametrize("answers", [[], [None], [False], ["hold"], [{"hold": False}], [{"hold": 1}],
+                                     [{"hold": "true"}], [{"reason": "token_throttle"}], [[{"hold": True}]]])
+def test_anything_but_an_exact_hold_starts_the_card(monkeypatch, answers):
+    _hook(monkeypatch, answers)
+    assert gate.hold(**ASK) is None
+
+
+def test_a_failing_hook_starts_the_card(monkeypatch):
+    def boom(**kwargs):
+        raise RuntimeError("plugin fault")
+    _hook(monkeypatch, boom)
+    assert gate.hold(**ASK) is None
+
+
+def test_the_hook_is_a_registered_hook_name():
+    assert gate.HOOK in plugins.VALID_HOOKS
+
+
+def test_dispatch_keeps_a_gated_card_ready_and_starts_it_once_the_gate_opens(paced_board, monkeypatch):
+    _write_cfg(paced_board)
+    holding = {"on": True}
+    _hook(monkeypatch, lambda **kw: [{"hold": True, "reason": "token_throttle"}] if holding["on"] else [None])
+    with kbc.connect() as conn:
+        a, b = _opus_card(conn, "a"), _opus_card(conn, "b")
+        seen, result = _dispatch(conn)
+        assert seen == [] and kb.get_task(conn, a).status == "ready" and kb.get_task(conn, b).status == "ready"
+        assert sorted(result.respawn_guarded) == sorted([(a, "start_gate:token_throttle"), (b, "start_gate:token_throttle")])
+        holding["on"] = False
+        seen, result = _dispatch(conn)
+        assert sorted(seen) == sorted([a, b]) and not result.respawn_guarded  # nothing persisted: it just starts
+
+
+def test_dispatch_dry_run_reports_the_gate_without_claiming(paced_board, monkeypatch):
+    _write_cfg(paced_board)
+    _hook(monkeypatch, [{"hold": True, "reason": "token_throttle"}])
+    from hermes_cli import kanban_db_dispatch as kdd
+    with kbc.connect() as conn:
+        tid = _opus_card(conn)
+        result = kdd.dispatch_once(conn, dry_run=True)
+        assert (tid, "start_gate:token_throttle") in result.respawn_guarded and kb.get_task(conn, tid).status == "ready"
diff --git a/website/docs/user-guide/features/kanban.md b/website/docs/user-guide/features/kanban.md
index af47ddb43a7b9a0b0d73c37d73105cd4e33339e6..d6269977275649fd4bbc8ea3a20ad4bad4978809 100644
--- a/website/docs/user-guide/features/kanban.md
+++ b/website/docs/user-guide/features/kanban.md
@@ -1555,6 +1555,10 @@ To see why a ready card is not spawning, run `hermes kanban dispatch --dry-run`
 
 `recent_success` and `active_pr` hold the **ready** lane only — they are the inputs to a review handoff, not signals against one. To have a reviewer, closer or other recovery profile pick up a card whose PR is already open, either move it to the review lane with `hermes kanban request-review <id>` (accepted from `ready` as well as `running`; the review-lane spawn is not subject to either guard) or hand the ready card to that profile with `hermes kanban assign <id> <profile>`: a handoff recorded *after* the PR comment — an operator reassign, a reviewer's changes-requested verdict, or a review reopen — lifts `active_pr` for the profile now named on the card, because that PR is exactly what it must work on. Only a change to a *different* profile counts: re-assigning the same profile, unassigning, or the dispatcher's own `kanban.default_assignee` fill-in does not lift the guard, so the assignee that opened the PR is still not re-spawned against it after a crash, reclaim or no-op reassign, and a newer PR comment posted after the handoff guards again. A deliberate re-queue after a success (drag `done→ready`, `unblock`, re-promotion) also lifts `recent_success`, so a manual re-run is never silently held for the whole window.
 
+### Plugin start gate (`kanban_start_gate` hook)
+
+Right before claiming a card the dispatcher asks the `kanban_start_gate` plugin hook (kwargs `task_id`, `lane`, `assignee`, `board`). A callback that returns `{"hold": True, "reason": "<word>"}` keeps the card `ready` and unclaimed for that tick; the tick records it under `respawn_guarded` with reason `start_gate:<word>`, and `hermes kanban dispatch --dry-run` lists it as `Guarded (start_gate:<word>)`. Nothing is stored: the card is asked again on the next tick and starts as soon as no callback holds it. No subscriber, a failing callback or any other return starts the card. The hermes-mods throughput plugin uses it to stop starting cards while the fleet's token rate is over the token throttle's cap, so worker slots are not filled with runs that only wait for model calls.
+
 ### LLM quota pacing (`kanban.llm_pacing`)
 
 Before claiming a ready or review card, the dispatcher checks the OAuth pool of the provider the card's next run would use (for a `class:*` selector, every provider the class may route to; the card waits only when all of them hold it). It reads each account's account-wide usage windows (`five_hour` and `seven_day` from `/api/oauth/usage`; Codex `Session`/`Weekly`) at most every `read_interval_seconds`, measures each window's burn rate from its recent samples, and compares the pool's burn with the rate that would bring every account with headroom to `target_percent` exactly at its window's reset. An account whose window has not started yet (the endpoint reports `null` for an idle `five_hour`) counts as a fresh full window; an account read successfully with both windows `null` (idle or brand-new) counts as two. A failed usage read adds no headroom.
