index c90f5c4f63e..99c6e89a2b7 100644
--- a/hermes_state_lockguard_fdscan.py
+++ b/hermes_state_lockguard_fdscan.py
@@ -147,21 +147,51 @@
     direct = once(path)
     if direct is not None:
         return direct
-    parent = path
-    missing: list[str] = []
-    while True:
-        parent, tail = os.path.split(parent)
-        if not tail:
-            break
-        missing.append(tail)
-        resolved = once(parent if parent else ".")
-        if resolved is not None:
-            for part in reversed(missing):
-                resolved = os.path.join(resolved, part)
-            return resolved
-        if not parent or parent == os.sep:
