From a87ae5f6e2fcf879a5a8fdd32e7f0dd64eeb1f89 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 14:18:41 -0800
Subject: [PATCH] [daveey] tests: bind synthesized-turn commit point into
 rebound prompt harnesses

CI shard 4 failed test_refused_input_commits_failed_mailbox_receipt with NameError: the harness rebinds
_run_admitted_prompt onto an explicit namespace, and prompt_turn now reaches start_synthesized_turn via
server globals (split-module import contract). Supply the production functions in both harnesses.
---
 tests/tui_gateway/test_bot_live_owner_delivery.py        | 3 +++
 tests/tui_gateway/test_notification_admission_refusal.py | 2 +-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_bot_live_owner_delivery.py b/tests/tui_gateway/test_bot_live_owner_delivery.py
index 9afa57b59cf..afa0d9c0169 100644
--- a/tests/tui_gateway/test_bot_live_owner_delivery.py
+++ b/tests/tui_gateway/test_bot_live_owner_delivery.py
@@ -60,6 +60,9 @@ def test_refused_input_commits_failed_mailbox_receipt(tmp_path):
         "_reopen_routed_session_row": noop,
         # Every dispatch binds the session's own row before the turn writes (#111999).
         "_ensure_session_db_row": noop,
+        # [daveey] Server-bound commit point for synthesized turns (exit_job_receipts); a user turn passes through.
+        "start_synthesized_turn": session_notifications.start_synthesized_turn,
+        "admit_synthesized_turn": session_notifications.admit_synthesized_turn,
     })
     def terminal(outcome):
         mailbox.complete_delivery(tmp_path, queued["id"], status=outcome["status"],
diff --git a/tests/tui_gateway/test_notification_admission_refusal.py b/tests/tui_gateway/test_notification_admission_refusal.py
index 0a3c21e42cd..fbd4b16604c 100644
--- a/tests/tui_gateway/test_notification_admission_refusal.py
+++ b/tests/tui_gateway/test_notification_admission_refusal.py
@@ -42,7 +42,7 @@ def test_refused_notification_retains_result_without_spending_attempts(tmp_path,
     # too, else the rebound dispatcher dies on a NameError instead of exercising the refusal.
     for name in ('_notif_run_submit', '_notif_owner_refused', '_notif_owner_preflight', '_notif_note_owner_refusal',
                  '_notif_refusal_backoff', '_notif_hold_for', '_notif_retry_completions',
-                 '_notification_event_requires_owner'):
+                 '_notification_event_requires_owner', 'start_synthesized_turn', 'admit_synthesized_turn'):
         if hasattr(session_notifications, name):
             namespace[name] = rebind(getattr(session_notifications, name), namespace)
     for name in ('_OWNER_REFUSAL_CODES', '_NOTIF_REFUSAL_BACKOFF_S', '_NOTIF_REFUSAL_BACKOFF_MAX_S',
-- 
2.55.0

