From 03d3bb7bda882e8cdefebfcdefd04e93a92664bc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 16:04:37 +0000
Subject: [PATCH] [daveey] lifecycle guard: parse ssh options after the
 destination before reading the remote command

Review 5911427581 B1 on PR #3319: OpenSSH resumes getopt after the destination, so
`ssh h1 'ssh h2 -p 22 sh -s' < f` and `ssh h1 -T < f` hand f to a shell, but the walk
read `-p`/`-T` as the remote command and skipped the nested-shell scan (fail open).
Skip post-destination options (value options consume their value, `--` ends them);
nothing left = a login shell.

Tests: 5 control shapes (post-host options ending in a shell or no command) refuse,
3 data-consumer shapes with post-host options stay allowed; the 5 failed before.
tests/cron: 11704 passed; the one failure is the known load-timing test
test_large_no_sink_heredoc_scan_stays_fast (passes 3/3 alone).
---
 cron/lifecycle_guard_nested_shells.py              |  6 +++++-
 tests/cron/test_lifecycle_guard_session_aliases.py | 11 +++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/cron/lifecycle_guard_nested_shells.py b/cron/lifecycle_guard_nested_shells.py
index 37c1100e9b60db091e1c8387ce6b38078ff7da82..1a204ba09dd20cb59994b4531b18d4757af2ac4f 100644
--- a/cron/lifecycle_guard_nested_shells.py
+++ b/cron/lifecycle_guard_nested_shells.py
@@ -308,7 +308,11 @@ def _shell_input(
         from tools.shell_heredoc import _SSH_VALUE_OPTIONS
 
         _options, host = _option_words(arguments, frozenset(_SSH_VALUE_OPTIONS))
-        return ("stdin", None) if _remote_reads_stdin(arguments[host + 1:], hops) else None
+        # OpenSSH resumes getopt after the destination (`ssh h -p 22 sh -s`, `ssh h -T`), so
+        # options there are ssh's own and the remote command starts at the next operand.
+        remote = arguments[host + 1:]
+        _options, command = _option_words(remote, frozenset(_SSH_VALUE_OPTIONS))
+        return ("stdin", None) if _remote_reads_stdin(remote[command:], hops) else None
     if name not in _SHELL_EXECUTABLES:
         return None
     options_end = _shell_options_end(arguments, name)[0]
diff --git a/tests/cron/test_lifecycle_guard_session_aliases.py b/tests/cron/test_lifecycle_guard_session_aliases.py
index 63e0a4098948f7ecb4aea2cf113ec85c189e05d8..336111d026b136c2a0265228fbf84f60d1a96979 100644
--- a/tests/cron/test_lifecycle_guard_session_aliases.py
+++ b/tests/cron/test_lifecycle_guard_session_aliases.py
@@ -824,6 +824,10 @@ _MULTI_HOP_DATA_CONSUMERS = [
     "ssh -p 22 h1 \"ssh -J j h2 'timeout 20 python3 -'\" < {py}",
     "ssh h1 \"ssh h2 'ssh h3 python3 -'\" < {py}",
     "ssh h1 'ssh h2 cat' < {script}",
+    # OpenSSH resumes option parsing after the destination (review 5911427581 B1).
+    "ssh h1 'ssh h2 -p 22 python3 -' < {py}",
+    "ssh h1 -T 'ssh h2 -o BatchMode=yes -T python3 -' < {py}",
+    "ssh h1 'ssh h2 -- python3 -' < {py}",
     "ssh h1 \"ssh h2 python3 -\" <<'PY'\n" + _PY_TAKEOVER + "PY",
 ]
 
@@ -855,6 +859,13 @@ _MULTI_HOP_SHELLS = [
     "ssh h1 'sudo -i' < {script}",  # other hops are still not modelled: fail closed
     "ssh h1 'ssh h2 su -l bob' < {script}",
     "ssh h1 \"ssh h2 'ssh h3 \\\"ssh h4 'ssh h5 python3 -'\\\"'\" < {script}",  # hop cap: closed
+    # Options after the destination are still ssh's own (review 5911427581 B1): the remote
+    # command starts at the first operand after them; none left = a login shell.
+    "ssh h1 'ssh h2 -p 22 sh -s' < {script}",
+    "ssh h1 'ssh h2 -T' < {script}",
+    "ssh h1 'ssh h2 -o BatchMode=yes -p22 -T bash' < {script}",
+    "ssh h1 -T < {script}",
+    "ssh h1 -p 22 -- < {script}",
 ]
 
 
-- 
