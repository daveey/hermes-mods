From 83645f1c712c9e636da23e0a554bff1cc4aafc14 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 14:25:52 +0000
Subject: [PATCH] fix(fairness): explicit portable manifest text encoding
 [daveey]

---
 hermes_cli/kanban_fairness_segments.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_fairness_segments.py b/hermes_cli/kanban_fairness_segments.py
index b76bd5eba9951586044e56d927823181272f603d..3c1d65da0046f025b2ba6f40a266716d9a85aa45 100644
--- a/hermes_cli/kanban_fairness_segments.py
+++ b/hermes_cli/kanban_fairness_segments.py
@@ -29,7 +29,7 @@ def write(path: Path, data: bytes) -> None:
 def receipts(out: Path) -> dict:
     path = out / RECEIPTS
     if path.exists():
-        return json.loads(path.read_text(encoding="utf-8"))
+        return json.loads(path.read_text(encoding="utf-8-sig"))
     return {"version": VERSION, "capture_id": None, "board_uid": None, "segments": [],
             "sources": [], "gaps": [], "bytes": 0}
 
@@ -142,7 +142,7 @@ def load_records(out: Path) -> dict:
     gaps = []
     try:
         path = out / MANIFEST
-        manifest = json.loads(path.read_text()) if path.exists() else receipts(out)
+        manifest = json.loads(path.read_text(encoding="utf-8-sig")) if path.exists() else receipts(out)
     except (OSError, ValueError, TypeError):
         return {"manifest": {}, "records": [], "gaps": [{"code": "bad_manifest"}]}
     if manifest.get("sealed") is not True or not manifest.get("final_seal"):
-- 
