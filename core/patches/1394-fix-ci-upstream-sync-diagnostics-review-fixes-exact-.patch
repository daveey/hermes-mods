+def test_partial_python_slice_set_cannot_prove_candidate_only(tmp_path, monkeypatch, capsys):
+    slices = [job(70 + n, f"Python tests / Run tests ({n}/8)", "success" if n != 3 else "cancelled") for n in range(1, 9)]
