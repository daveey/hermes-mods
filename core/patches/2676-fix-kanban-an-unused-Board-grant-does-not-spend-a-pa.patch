 hermes_cli/kanban_dependency_review.py        |  13 +--
 hermes_cli/kanban_dependency_review_notice.py |   8 +-
 hermes_cli/kanban_hold_release.py             |  13 +--
 ...t_kanban_dependency_review_unused_grant.py | 102 ++++++++++++++++++
 5 files changed, 121 insertions(+), 20 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_dependency_review_unused_grant.py

