From c10255bcb0fcef9f2fdd192a828f26f1ffab43d2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:14:04 +0000
Subject: [PATCH] [daveey] test(arith-sink): cover typeset /
 command_not_found_handle / ENV= date rebinds

Post-merge check t_01a1d6de3f6b577c on #2626 found three alternatives of
`_DATE_REBIND_RE` (tools/shell_heredoc.py) with no test: deleting `typeset`,
`command_not_found_handle` or bare `ENV=` left all related suites green
(mutants A5f, A5g, A5h survived).

Add one `test_rebound_date_is_still_a_sink` case per alternative, each using
only that word so it alone drops the `$(date +%s)` exemption:
- `typeset -fx date`
- `command_not_found_handle() { echo 'a[$(bash x)]'; }`
- `ENV=evil.sh ` (BASH_ENV= does not match it: `_` is a word char, so `\bENV` needs the bare name)

Proof (sdlc-review scripts/mutants.py, tests/cron/test_lifecycle_guard_arith_sink.py):
baseline 67 passed, 0 skipped; A5f killed by [typeset ...], A5g killed by
[command_not_found_handle() ...], A5h killed by [ENV=evil.sh ...]; tally killed 3.

Test-only change. Card: t_01a1d6f6020d69cd.
---
 tests/cron/test_lifecycle_guard_arith_sink.py | 1 +
 1 file changed, 1 insertion(+)

diff --git a/tests/cron/test_lifecycle_guard_arith_sink.py b/tests/cron/test_lifecycle_guard_arith_sink.py
index a0e519f6af..8fefa00e6a 100644
--- a/tests/cron/test_lifecycle_guard_arith_sink.py
+++ b/tests/cron/test_lifecycle_guard_arith_sink.py
@@ -149,6 +149,7 @@ def test_output_run_inside_arithmetic_still_fails_closed(tmp_path, shape):
     "date() { echo 'a[$(bash x)]'; }\n", "function date { :; }\n", "date () { :; }; ",
     "alias date=evil\n", "PATH=/tmp/evil:$PATH\n", "export PATH=/tmp/evil\n", "hash -p /tmp/evil date\n",
     "source lib.sh\n", ". lib.sh\n", "BASH_ENV=evil.sh ", "enable -f x date\n", "declare -f date\n",
+    "typeset -fx date\n", "command_not_found_handle() { echo 'a[$(bash x)]'; }\n", "ENV=evil.sh ",
 ])
 def test_rebound_date_is_still_a_sink(prefix):
     assert output_reaches_shell(prefix + "x=$(( $(date +%s) + 1 ))\n")
