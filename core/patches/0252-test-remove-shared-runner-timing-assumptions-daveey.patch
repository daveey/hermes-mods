From f1e1ba10661dbdaffa66e67c3e87b893ccbe89f9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 20:51:57 +0000
Subject: [PATCH 243/248] test: remove shared-runner timing assumptions
 [daveey]

---
 tests-js/bundle-smoke-metadata.test.mjs         | 4 +++-
 tests/hermes_cli/test_cli_goal_parked_resume.py | 4 +++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/tests-js/bundle-smoke-metadata.test.mjs b/tests-js/bundle-smoke-metadata.test.mjs
index 2a91032eed..9386f29df3 100644
--- a/tests-js/bundle-smoke-metadata.test.mjs
+++ b/tests-js/bundle-smoke-metadata.test.mjs
@@ -109,7 +109,9 @@ test('channel smoke binds the complete admitted request, not a commit-build iden
       expect(run('identity').status).not.toBe(0)
     }
   } finally { fs.rmSync(temp, { recursive: true, force: true }) }
-}, 15_000)
+  // Ten real Node CLIs share the runner with other suites; budget for their
+  // aggregate startup cost, not a single unit-test invocation.
+}, 60_000)
 
 test('workspace admission rejects reuse and symlink escapes before creating anything outside runner temp', () => {
   const temp = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), 'smoke-paths-')))
diff --git a/tests/hermes_cli/test_cli_goal_parked_resume.py b/tests/hermes_cli/test_cli_goal_parked_resume.py
index a5a729f342..0f3428d678 100644
--- a/tests/hermes_cli/test_cli_goal_parked_resume.py
+++ b/tests/hermes_cli/test_cli_goal_parked_resume.py
@@ -29,7 +29,9 @@ class _Cli(CLILoopsMixin):
         return self._mgr
 
 
-def test_idle_hook_queues_the_continuation_when_a_timed_barrier_has_elapsed(hermes_home):
+def test_idle_hook_queues_the_continuation_when_a_timed_barrier_has_elapsed(hermes_home, monkeypatch):
+    # Importing cli on a busy runner can outlast the one-second barrier.
+    monkeypatch.setattr(time, "time", lambda: 1_800_000_000.0)
     mgr = goals.GoalManager(session_id="resume-idle")
     mgr.set("finish the thing")
     mgr.wait_for_seconds(1, reason="cooldown")
