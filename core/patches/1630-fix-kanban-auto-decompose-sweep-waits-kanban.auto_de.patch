From e5654de882ad113af8a36527f61ae213b43f1be8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 03:06:45 +0000
Subject: [PATCH] fix(kanban): auto-decompose sweep waits
 kanban.auto_decompose_min_age_seconds (120 s) before taking a triage card
 [daveey]

Agents create triage cards as holds (test fixtures) and park them with kanban_schedule; the sweep
specified them 6-16 s after creation and workers claimed them (defect kanban-76c77018a6, 5 cases in
4 days). The dispatcher's sweep now skips triage cards younger than the window; manual decompose and
decompose --all are unchanged. The kanban_create triage param says triage is not a hold.
---
 gateway/kanban_watchers_common.py             |  23 ++++
 gateway/kanban_watchers_dispatcher.py         |  16 ++-
 hermes_cli/config_defaults.py                 |   4 +-
 hermes_cli/kanban_decompose.py                |  12 +-
 .../test_kanban_auto_decompose_min_age.py     | 116 ++++++++++++++++++
 tools/kanban_tools_schemas.py                 |   6 +-
 6 files changed, 168 insertions(+), 9 deletions(-)
 create mode 100644 tests/gateway/test_kanban_auto_decompose_min_age.py

diff --git a/gateway/kanban_watchers_common.py b/gateway/kanban_watchers_common.py
index 2df2f52e47b..212c1f23717 100644
--- a/gateway/kanban_watchers_common.py
+++ b/gateway/kanban_watchers_common.py
@@ -87,6 +87,29 @@ def _resolve_auto_decompose_settings(load_config: Callable[[], Any]) -> tuple[bo
     return bool(kcfg.get("auto_decompose", True)), max(per_tick, 1)
 
 
+AUTO_DECOMPOSE_MIN_AGE_DEFAULT = 120
+
+
+def _auto_decompose_min_age_seconds() -> int:
+    """``kanban.auto_decompose_min_age_seconds`` (default 120; 0 = sweep immediately), re-read per tick.
+
+    The auto-decompose sweep skips triage cards younger than this so a creator can park a triage
+    hold with ``kanban_schedule`` before it is specified and dispatched (fixture cards were specified
+    6-16 s after creation and ran, defect kanban-76c77018a6). Manual decompose/specify ignore it.
+    A config read error keeps the default window. [daveey]
+    """
+    try:
+        from hermes_cli.config import load_config
+
+        raw = ((load_config() or {}).get("kanban") or {}).get(
+            "auto_decompose_min_age_seconds", AUTO_DECOMPOSE_MIN_AGE_DEFAULT)
+        return max(int(AUTO_DECOMPOSE_MIN_AGE_DEFAULT if raw is None else raw), 0)
+    except Exception:
+        logger.warning("kanban.auto_decompose_min_age_seconds unreadable; using %ss",
+                       AUTO_DECOMPOSE_MIN_AGE_DEFAULT, exc_info=True)
+        return AUTO_DECOMPOSE_MIN_AGE_DEFAULT
+
+
 def _gc_retention_days() -> int:
     """``kanban.done_sub_retention_days`` (default 30; 0 disables), re-read per sweep; fails safe to 30."""
     try:
