 hermes_cli/auth_pool_read_scope.py            | 37 ++++++++-----
 .../test_credential_pool_deleted_rows.py      | 55 +++++++++++++++++++
 .../hermes_cli/test_picker_auth_read_scope.py | 15 +++++
 4 files changed, 97 insertions(+), 21 deletions(-)

