From 7c2041e566300d382437e3c0fd8976219a110f14 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 20:16:08 +0000
Subject: [PATCH] [daveey] Reject article-free owner-chat relay asks

Regression proof: article-free named-owner-chat actions reject, while canonical owner-terminal attestation and unrelated rollout controls remain accepted.
---
 hermes_cli/kanban_block_policy.py             |  3 +-
 .../test_kanban_owner_chat_relay.py           | 52 +++++++++++++++++++
 2 files changed, 54 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_cli/test_kanban_owner_chat_relay.py

diff --git a/hermes_cli/kanban_block_policy.py b/hermes_cli/kanban_block_policy.py
index cef052a6dc..13cc1b03f5 100644
--- a/hermes_cli/kanban_block_policy.py
+++ b/hermes_cli/kanban_block_policy.py
@@ -211,7 +211,8 @@ _RELAY = re.compile(
     r"|\b(?:from|in|via|using)\s+(?:a|an|any|the)\s+hermes\s+(?:desktop\s+|cli\s+)?(?:chat|session)\b"
     # "from an owner Hermes chat" (hub t_01a1848506cae619), "from any owner chat", "from an owner Hermes Desktop or
     # CLI chat": an owner chat is an agent the ask makes David relay to. [daveey]
-    r"|\b(?:from|in|via|using)\s+(?:a|an|any|the)\s+owner\s+(?:hermes\s+)?(?:desktop\s+|cli\s+)?(?:or\s+cli\s+)?"
+    r"|\b(?:from|in|via|using)\s+(?:(?:a|an|any|the)\s+)?owner(?:'s)?\s+"
+    r"(?:hermes\s+)?(?:desktop\s+|cli\s+)?(?:or\s+cli\s+)?"
     r"(?:chat|session)\b",
     re.IGNORECASE)
 
diff --git a/tests/hermes_cli/test_kanban_owner_chat_relay.py b/tests/hermes_cli/test_kanban_owner_chat_relay.py
new file mode 100644
index 0000000000..9302e4a46e
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_owner_chat_relay.py
@@ -0,0 +1,52 @@
+"""Historical owner-chat asks must not bypass the relay presentation lint."""
+import pytest
+
+from hermes_cli.kanban_block_policy import agent_relay_ask_error
+
+
+# Sanitized historical grammar; personal actions and identifiers are omitted.
+HISTORICAL_ACTIONS = (
+    "From owner chat 20000101_000000_aaaaaa, run the reviewed check through run_in_user_terminal. Unblock = verify the result; archive = abandon this activation.",
+    "In owner Desktop chat 20000102_000000_bbbbbb, run the reviewed check through run_in_user_terminal. Unblock = verify the result; archive = abandon this activation.",
+)
+
+
+@pytest.mark.parametrize("action", HISTORICAL_ACTIONS)
+def test_historical_owner_chat_actions_are_rejected(action):
+    error = agent_relay_ask_error(action)
+    assert error is not None and error.startswith("agent_relay_ask:")
+
+
+@pytest.mark.parametrize("article", ["", "a ", "an ", "any ", "the "])
+@pytest.mark.parametrize("owner", ["owner", "owner's"])
+@pytest.mark.parametrize("surface", ["chat", "Desktop chat", "Hermes Desktop or CLI session"])
+def test_owner_chat_article_and_possessive_forms(article, owner, surface):
+    assert agent_relay_ask_error(f"From {article}{owner} {surface}, run the check.")
+
+
+@pytest.mark.parametrize("action", [
+    "Approve the owner rollout",
+    "Run the check in owner rollout documentation.",
+    "Ask the vendor's agent to approve the owner rollout.",
+])
+def test_unrelated_owner_language_stays_allowed(action):
+    assert agent_relay_ask_error(action) is None
+
+
+@pytest.mark.parametrize("verb", ["open", "start"])
+def test_canonical_owner_terminal_template_stays_allowed(verb):
+    action = (
+        f"From your own Hermes chat {verb} the owner-terminal flow for task t_0123456789abcdef. "
+        "Unblock = resume verification; archive = abandon reconciliation."
+    )
+    request = {
+        "action": action,
+        "interaction": "user_terminal",
+        "why_human": "host_only boundary: only the owner's Desktop chat may open a terminal",
+        "evidence": (
+            "run_in_user_terminal refused: Kanban caller, owner chats only. "
+            "cross_session send refused: Kanban worker cannot send into a human chat."
+        ),
+    }
+    assert agent_relay_ask_error(action, request) is None
+    assert agent_relay_ask_error(action)  # The attestation is still mandatory.
-- 
2.43.0

