From 70583c1095c1c22aa7bacf7fc62492d0c930675f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 09:12:37 +0000
Subject: [PATCH] fix(ownership): preserve namespace-qualified CLI holder
 telemetry [daveey]

Broad consumer regression exposed that known durable CLI holders were mislabeled opaque. Reuse the established namespace-qualified durable PID parser; never manufacture a recorded birth from a current PID. Real CLI takeover handoff remains unchanged. Proof: canonical no-retry CLI durable/full-turn, self-orphan and transient suites passed.
---
 tests/tui_gateway/test_self_orphan_turn_lease.py | 6 +++---
 tui_gateway/session_lifecycle.py                 | 2 ++
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/tests/tui_gateway/test_self_orphan_turn_lease.py b/tests/tui_gateway/test_self_orphan_turn_lease.py
index 383d36499f..7304ba3195 100644
--- a/tests/tui_gateway/test_self_orphan_turn_lease.py
+++ b/tests/tui_gateway/test_self_orphan_turn_lease.py
@@ -73,8 +73,8 @@ def test_different_holder_even_in_same_process_stays_fenced(orphan, monkeypatch)
     refusal = server._durable_owner_refusal(orphan.session)
     assert calls == []
     assert refusal.reason == 'SESSION_NOT_OWNED'
-    assert refusal.ownership_cause == 'lease_unknown'
-    assert refusal.holder_pid == 0
+    assert refusal.ownership_cause == 'lease_foreign'
+    assert refusal.holder_pid == os.getpid()
     assert orphan.db.session_turn_lease_owner('root')['holder'] == foreign
 
 
@@ -99,7 +99,7 @@ def test_receipt_cannot_authorize_a_different_custodian(orphan, monkeypatch, tmp
     monkeypatch.setattr(target, 'release_session_turn_lease', lambda *args: calls.append(args))
     refusal = server._durable_owner_refusal(orphan.session)
     assert refusal.reason == 'SESSION_NOT_OWNED'
-    assert refusal.ownership_cause == 'lease_unknown'
+    assert refusal.ownership_cause == 'lease_foreign'
     assert calls == []
 
 
diff --git a/tui_gateway/session_lifecycle.py b/tui_gateway/session_lifecycle.py
index f0f2392c9a..ed505393c0 100644
--- a/tui_gateway/session_lifecycle.py
+++ b/tui_gateway/session_lifecycle.py
@@ -155,6 +155,8 @@ def _durable_owner_refusal(session: dict):
         f"Details: session {owner['conversation_id']} opened by {surface}. "
         f"Writer: {holder}", SESSION_NOT_OWNED)
     refusal.ownership_cause = "lease_foreign"
+    from tui_gateway.gateway_background_holder import _durable_holder_pid
+    refusal.holder_pid = _durable_holder_pid(holder)
     # A namespace-qualified remote writer is positive foreign evidence. An opaque
     # holder is not: keep its fence, but do not offer a destructive takeover.
     from hermes_state_pidns import pid_namespace_id
-- 
