Subject: [PATCH 6611] Truthful non-running reasons and refusal provenance

Public mirror of source commit 1b5b39b97424460071eb9839dbfb8b3b340dbd96.

---
diff --git a/hermes_cli/kanban_nonrunning_reason.py b/hermes_cli/kanban_nonrunning_reason.py
index b9cd651eab3e31252842b049fbd8012e02d162aa..d370054a48abce2dc9d3b9b6201425ceae6494d0 100644
--- a/hermes_cli/kanban_nonrunning_reason.py
+++ b/hermes_cli/kanban_nonrunning_reason.py
@@ -71,6 +71,10 @@
     if rule is None and reason == 'claim_deferred' and isinstance(code, str):
         rule = next((value for prefix, value in PREFIXES.items()
                      if code == prefix or code.startswith(prefix + '_') or code.startswith(prefix + ':')), None)
+    # Producer details may be provenance-bearing str subclasses. Preserve their
+    # origin for classification above, but expose only plain wire values: copying
+    # a ClaimDeferral would reconstruct it without its required origin argument.
+    code = str(code) if isinstance(code, str) else code
     if rule is None:
         return {'code': code if isinstance(code, str) and code.isidentifier() else 'unclassified_refusal',
                 'family': 'unknown', 'disposition': 'unknown', 'actor': 'unknown',
diff --git a/tests/hermes_cli/test_kanban_nonrunning_reason.py b/tests/hermes_cli/test_kanban_nonrunning_reason.py
index f9e967eec844708d2ad02377370b479b5db4aebd..549e51fe2eb4e8d32b56462bd071c19ef77b4c2f 100644
--- a/tests/hermes_cli/test_kanban_nonrunning_reason.py
+++ b/tests/hermes_cli/test_kanban_nonrunning_reason.py
@@ -88,6 +88,26 @@
     assert value['actor'] != 'human'
 
 
+@pytest.mark.parametrize('code,origin', [('lease_held', 'board'), ('offline', 'local'),
+                                         ('gateway_draining', 'local'), ('future_code', 'local')])
+def test_typed_refusal_projects_plain_copyable_code(code, origin):
+    from copy import deepcopy
+    from hermes_cli.execution_observations import nonrunning_reason
+    detail = sync.ClaimDeferral(code, origin)
+    reason = reasons.describe('claim_deferred', detail)
+    assert type(reason['code']) is str
+    assert reason['code'] == code
+    assert deepcopy(reason) == reason
+    reason.update(freshness='current', observed_at=1000, valid_until=1180,
+                  evidence_ref='fixture', source_revision='one')
+    adapted = nonrunning_reason(reason, now=1001)
+    if reason['disposition'] != 'unknown':
+        assert adapted['code'] == code
+        assert adapted['valid_until'] == 1180
+    if code == 'offline':
+        assert reason['disposition'] == 'unknown'  # no fabricated Board provenance
+
+
 def test_new_ready_without_dispatcher_evidence_is_unknown(kanban_home):
     with kbc.connect_closing() as conn:
         tid = kb.create_task(conn, title='unobserved', assignee='default')
