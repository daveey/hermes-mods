From ea26b1290dcc48d85e5ced5c0222f3a739062e31 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 08:14:05 +0000
Subject: [PATCH] fix(always-on): a stale update marker holds the start-up roll
 once, not twice [daveey]

Fourth review of #3920: Roller.start() waits out the update marker before
probing, then roll() waited again, so a stale marker held the start-up roll
for 2 x UPDATE_WAIT_S (about 20 min). roll() takes marker_waited and start()
passes it. Test: with a marker that never clears, start() waits one
UPDATE_WAIT_S.

Co-Authored-By: Contributor <contributor@example.com>
---
 hermes_cli/always_on_rollover.py            |  8 +++++---
 tests/hermes_cli/test_always_on_rollover.py | 11 +++++++++++
 2 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/always_on_rollover.py b/hermes_cli/always_on_rollover.py
index dcb137868c..520e254140 100644
--- a/hermes_cli/always_on_rollover.py
+++ b/hermes_cli/always_on_rollover.py
@@ -630,8 +630,10 @@ class Roller:
                 return port, False
         return None, False
 
-    def roll(self, reason: str) -> bool:
-        if not aod.wait_for_update_clear(self.marker, sleep=self.sleep, now=self.clock):
+    def roll(self, reason: str, *, marker_waited: bool = False) -> bool:
+        """*marker_waited*: the caller already waited out the update marker (Roller.start), so a stale marker
+        does not hold the roll for a second UPDATE_WAIT_S."""
+        if not marker_waited and not aod.wait_for_update_clear(self.marker, sleep=self.sleep, now=self.clock):
             log("update marker still present; rolling anyway")
         record = read_active(self.home)
         active_port = record["port"] if record and self.unit_active(record["port"]) else None
@@ -831,7 +833,7 @@ class Roller:
             log("update marker still present; rolling anyway")
         before = read_active(self.home)
         starved = before is not None and self.unit_active(before["port"]) and self._never_answers(before["port"])
-        ok = self.roll("roller started")
+        ok = self.roll("roller started", marker_waited=True)
         if ok and starved:
             self.demote_if_replaced(before["port"])
         return ok
diff --git a/tests/hermes_cli/test_always_on_rollover.py b/tests/hermes_cli/test_always_on_rollover.py
index 56432d6e46..46b68fc2bd 100644
--- a/tests/hermes_cli/test_always_on_rollover.py
+++ b/tests/hermes_cli/test_always_on_rollover.py
@@ -526,6 +526,17 @@ def test_start_probes_only_after_the_update_marker_clears(home):
     assert set(roller._load_demoted()) == {9148}
 
 
+def test_start_waits_out_a_stale_update_marker_once(home):
+    host = FakeHost(running={9148}, commits={9148: "a" * 40})
+    ro.write_active(9148)
+    (home / "no-marker").write_text("")  # stale: never cleared
+    roller = make_roller(home, host)
+    t0 = roller.clock()
+    assert roller.start() is True
+    waited = roller.clock() - t0
+    assert ro.aod.UPDATE_WAIT_S <= waited < 2 * ro.aod.UPDATE_WAIT_S  # one wait, not start()'s plus roll()'s
+
+
 def test_start_does_not_demote_a_healthy_active_backend(home):
     host = FakeHost(running={9148}, commits={9148: "a" * 40})
     ro.write_active(9148)
-- 
