+    class Inline:
+        def __init__(self, target=None, daemon=None, args=(), kwargs=None, name=None):
+            self._t, self._a, self._k = target, args, kwargs or {}
+
+        def start(self):
+            self._t(*self._a, **self._k)
+
+        def is_alive(self):
+            return False
+
+        def join(self, timeout=None):
+            return None
+
