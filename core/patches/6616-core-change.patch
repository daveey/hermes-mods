Subject: [PATCH 6616] Profile resource custody and retirement before deletion

Public mirror of source commit 3cc35bd892bc5483a07a1d1ef502a338ef34a6f3.

---
diff --git a/hermes_state.py b/hermes_state.py
index 64db6b8421adb02ad7e0f20f84a32f0961ac88a1..9b35c9de9820c7102fbf3b0871309e1875842657 100644
--- a/hermes_state.py
+++ b/hermes_state.py
@@ -666,6 +666,8 @@
         self._read_budget = _read_budget_for(self.db_path)
         self._read_permits = self._read_budget.permits
         self._read_conns_lock = threading.Lock()
+        # A live reopen replaces the writer lease, not outstanding readers' custody.
+        self._read_conn_leases = {}
         # Set when close() begins; an in-flight reader then closes its own connection
         # instead of re-populating a pool nobody will drain again.
         self._read_conns_closed = False
@@ -964,6 +966,9 @@
                 self._read_open_failed_at = time.monotonic()
             logger.debug("read-only connection open failed for %s", self.db_path, exc_info=True)
             return None
+        if lease is not None:
+            with self._read_conns_lock:
+                self._read_conn_leases[conn] = lease
         return conn
 
     def _evict_one_idle_read_conn(self) -> bool:
@@ -979,8 +984,10 @@
         """Close a pooled read connection and release its permit even when the close fails (withholding
         it would narrow the read path forever). Over-releasing the BoundedSemaphore raises ValueError."""
         try:
-            if self._profile_lease is not None:
-                self._profile_lease.close_connection(conn, reader=True)
+            with self._read_conns_lock:
+                lease = self._read_conn_leases.pop(conn, None)
+            if lease is not None:
+                lease.close_connection(conn, reader=True)
             else:
                 self._close_conn_logged(conn, "read-conn")
         finally:
diff --git a/tests/hermes_state/test_profile_reader_reopen_custody.py b/tests/hermes_state/test_profile_reader_reopen_custody.py
new file mode 100644
index 0000000000000000000000000000000000000000..cdec6a7a046d22e2cbb544649ec7ed7260363f7b
--- /dev/null
+++ b/tests/hermes_state/test_profile_reader_reopen_custody.py
@@ -0,0 +1,56 @@
+"""Pooled readers keep their opening lease across a writer close/reopen."""
+import sqlite3
+import threading
+
+import pytest
+
+from hermes_constants import mark_named_profile_deleted
+from hermes_profile_resources import wait_profile_resources
+from hermes_state import SessionDB
+from tests.hermes_state import test_profile_retirement_custody as helpers
+from tests.hermes_state.test_profile_retirement_races import DelayedClose
+from tests.waiting import wait_until
+
+profile_home = helpers.profile_home
+
+
+@pytest.mark.parametrize('failed_close', [False, True])
+def test_checked_out_reader_return_after_live_reopen(profile_home, monkeypatch, failed_close):
+    allow = threading.Event()
+    db = SessionDB(profile_home / 'state.db')
+    original = db._connect_read_only
+
+    def open_reader(**kwargs):
+        conn = original(**kwargs)
+        return DelayedClose(conn, allow) if failed_close else conn
+
+    monkeypatch.setattr(db, '_connect_read_only', open_reader)
+    try:
+        with db._read_ctx() as conn:
+            assert conn is not db._conn
+            old = db._profile_lease
+            db.close()
+            db.create_session('reopened', source='cli', model='test')
+            new = db._profile_lease
+            assert old is not None and new is not None and new is not old
+            assert conn.execute('SELECT 1').fetchone()[0] == 1
+        # The replacement writer must retain its own reference, even while the
+        # old reader's concrete close is pending on the original lease.
+        assert new._refs == 1
+        if failed_close:
+            assert conn.attempted.is_set()
+            assert old._refs == 1
+            assert conn.execute('SELECT 1').fetchone()[0] == 1
+            assert not old.handle.closed
+            allow.set()
+        wait_until(lambda: old._refs == 0, timeout=10)
+        assert new._refs == 1
+        with pytest.raises(sqlite3.ProgrammingError):
+            conn.execute('SELECT 1')
+        db.close()
+        assert new._refs == 0
+        mark_named_profile_deleted(profile_home)
+        assert wait_profile_resources(profile_home, timeout=10)
+    finally:
+        allow.set()
+        db.close()
diff --git a/tests/hermes_state/test_profile_retirement_races.py b/tests/hermes_state/test_profile_retirement_races.py
index c7266e482dafb3b8d0ddd877357896fbb33cacec..bd57324c4b0882601fb170f1ce9c22aa0ef9dfa6 100644
--- a/tests/hermes_state/test_profile_retirement_races.py
+++ b/tests/hermes_state/test_profile_retirement_races.py
@@ -64,13 +64,19 @@
             db.close()
 
 
-def test_failed_pooled_close_withholds_ack_until_retried(profile_home):
+def test_failed_pooled_close_withholds_ack_until_retried(profile_home, monkeypatch):
     from hermes_profile_resources import wait_profile_resources
     allow = threading.Event()
     db = SessionDB(profile_home / 'state.db')
-    conn = db._get_read_conn()
-    assert conn is not None
-    proxy = DelayedClose(conn, allow)
+    original = db._connect_read_only
+
+    def open_reader(**kwargs):
+        return DelayedClose(original(**kwargs), allow)
+
+    monkeypatch.setattr(db, '_connect_read_only', open_reader)
+    proxy = db._get_read_conn()
+    assert proxy is not None
+    conn = proxy.connection
     try:
         db._close_read_conn(proxy)
         mark_named_profile_deleted(profile_home)
