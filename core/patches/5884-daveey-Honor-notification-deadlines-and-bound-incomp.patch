diff --git a/tui_gateway/kanban_unloaded.py b/tui_gateway/kanban_unloaded.py
index 978841d107c..c61cde01fd8 100644
--- a/tui_gateway/kanban_unloaded.py
+++ b/tui_gateway/kanban_unloaded.py
@@ -878,6 +878,10 @@ def _loop(stop: threading.Event) -> None:
                     schedule.gate.retry_at = time.monotonic() + interval
                     logger.warning("kanban unloaded pass failed", exc_info=True)
                 maintenance = time.monotonic() + interval
+                if not schedule.gate.was_bound and schedule.role != "retired":
+                    # An early report wake may not admit legacy work. Keep its
+                    # outstanding deadline rather than postponing it a full interval.
+                    maintenance = min(maintenance, schedule.next_legacy)
             # Stop observation is memory-only. Lease custody still gets its
             # normal maintenance cadence even with no admitted source pass.
             wake.wait(min(1.0, max(0.01, min(maintenance, schedule.gate.retry_at) - time.monotonic())))
diff --git a/tui_gateway/kanban_unloaded_schedule.py b/tui_gateway/kanban_unloaded_schedule.py
index 1f9a6d8f5bc..989032e1543 100644
--- a/tui_gateway/kanban_unloaded_schedule.py
+++ b/tui_gateway/kanban_unloaded_schedule.py
@@ -15,7 +15,13 @@ class UnloadedSchedule:
         now = time.monotonic()
         changed = role != self.role
         self.role = role
+        # Read before due(): an empty membership resets retry_at.
+        report_due = now >= self.gate.retry_at
         due = self.gate.due(now, legacy_due=now >= self.next_legacy)
+        if not due and report_due and not self.gate.was_bound and not self.gate.actions:
+            # Never-bound work is the legacy executor; its reported deadline is
+            # due work. A detached binding still waits for a fresh membership.
+            due = True
         # Ownership changes require catch-up, but a detached facts registry is
         # never permission to resume scans using the launch profile instead.
         if not due and not (changed and (self.gate.actions or not self.gate.was_bound)):
