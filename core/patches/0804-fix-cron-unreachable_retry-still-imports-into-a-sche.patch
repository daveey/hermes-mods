From 66c42a1aa552f5e6e98e0a3f853ff9887613c7f1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 13:22:37 -0700
Subject: [PATCH] fix(cron): unreachable_retry still imports into a scheduler
 running the previous release [daveey]

The previous release's scheduler imports cron.unreachable_retry lazily (will_retry) after an
update swapped the tree; 6f88751a7e made that module import is_recurring from cron.constants,
which the old process already holds without it. The ImportError lost the run's bookkeeping and
the one-shot job ran twice (release run 40717630046, e2e-upgrade handoff,
test_cron_job_due_mid_update_runs_exactly_once). Fall back to a local is_recurring.

Tests: tests/cron/test_unreachable_retry_mixed_version_import.py (red before).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 cron/unreachable_retry.py                     | 11 ++++++-
 ..._unreachable_retry_mixed_version_import.py | 29 +++++++++++++++++++
 2 files changed, 39 insertions(+), 1 deletion(-)
 create mode 100644 tests/cron/test_unreachable_retry_mixed_version_import.py

diff --git a/cron/unreachable_retry.py b/cron/unreachable_retry.py
index a576ba5fe7..25d4ce20cf 100644
--- a/cron/unreachable_retry.py
+++ b/cron/unreachable_retry.py
@@ -23,9 +23,18 @@ import logging
 from datetime import datetime
 from typing import Any, Dict, Optional
 
-from cron.constants import is_recurring
 from hermes_time import now as _hermes_now
 
+try:
+    from cron.constants import is_recurring
+except ImportError:
+    # A scheduler still running the previous release imports this module lazily (will_retry,
+    # is_model_unreachable_failure) from the tree an update just swapped in, while its in-memory
+    # cron.constants predates is_recurring. Failing here lost the run's bookkeeping and the next
+    # tick ran the one-shot job again (e2e-upgrade handoff, release N-1 -> HEAD).
+    def is_recurring(job: dict) -> bool:
+        return (job.get("schedule") or {}).get("kind") in {"cron", "interval"}
+
 logger = logging.getLogger("cron.scheduler")
 
 # Cowork's ladder: re-run after 5, 15, then 30 minutes; then give up until the
diff --git a/tests/cron/test_unreachable_retry_mixed_version_import.py b/tests/cron/test_unreachable_retry_mixed_version_import.py
new file mode 100644
index 0000000000..5a09ceba49
--- /dev/null
+++ b/tests/cron/test_unreachable_retry_mixed_version_import.py
@@ -0,0 +1,29 @@
+"""cron.unreachable_retry imports into a scheduler still running the previous release.
+
+The previous release's scheduler imports this module lazily (``from cron.unreachable_retry import
+will_retry``) after an update has swapped the tree, while the cron.constants it already holds
+predates ``is_recurring``. That ImportError lost the one-shot job's bookkeeping and the job ran
+twice (release run 40717630046, e2e-upgrade handoff, test_cron_job_due_mid_update_runs_exactly_once).
+"""
+
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+
+_OLD_PROCESS = """
+import cron.constants as constants
+del constants.is_recurring  # the previous release's cron.constants, already in memory
+from cron.unreachable_retry import is_recurring, will_retry
+assert is_recurring({"schedule": {"kind": "cron"}})
+assert not is_recurring({"schedule": None})
+assert not is_recurring({"schedule": {"kind": "once"}})
+print("ok")
+"""
+
+
+def test_imports_under_an_older_in_memory_cron_constants():
+    proc = subprocess.run([sys.executable, "-c", _OLD_PROCESS], cwd=ROOT, capture_output=True, text=True,
+                          timeout=120, check=False)
+    assert proc.returncode == 0 and proc.stdout.strip() == "ok", proc.stderr[-2000:]
