From 5309c55fa9ae2b4343b0fbbe86d6304173a2e4f1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 09:12:04 +0000
Subject: [PATCH] [daveey] kanban priority: terminal arrivals stay in the
 capture rows; feed docstring states the fixed-head limits

Follow-up to PR #2025 review nits 1-3 (review 5888521260, card
t_01a1d422c3832a8f).

Nit 2 (behaviour): a card created AND finished inside the capture window was
dropped from the inventory rows, while the same terminal card on a page read
after its creation was kept. Manifest rows were unaffected (terminal rows are
never planned), but an `exceptions` entry naming that card refused with
"unresolved exception; canonical evidence required" or resolved, depending only
on page timing. check_interval now keeps a created-then-terminal card as a
terminal row, exactly as a later page shows it, so the inventory is every card
at the fixed head and exception resolution is timing-independent. Open arrivals
keep their origin / integer / cap check; terminal arrivals get the same
plan_global validation as any paged terminal row.

Nit 1 (docstring): "exact" holds when a row's ONLY in-window priority change is
already on its page. An earlier in-window change still carrying the old
priority (a full-row upsert such as a title edit or the creation row, then a
re-prioritisation) refuses even when the page is read late. That fail-closed
behaviour is kept and now stated; tests pin both shapes.

Nit 3 (docstring): an open card created in-window above PRIORITY_CAP refuses,
while the same card paged before the window would be planned and normalized.
The docstring now says this is deliberate: an in-window creation is an arrival,
mirroring kanban_priority_inventory.classify's apply-time arrival rule. A test
pins the asymmetry.

Proof:
- tests/hermes_cli/test_kanban_priority_fixed_head.py: new cases. RED on
  origin/main (feed module reverted): 22 fail (create-then-finish exception
  resolution, terminal-arrival ordering, and the new seeded BusyBoard invariant
  "inventory rows == every card at the final head" on 19 of 20 seeds; seed 14
  has no create-then-finish card). GREEN here: 120 passed.
- Every test file mentioning kanban_priority (20 files, 428 tests) passes.
- No live priority operation was run.
---
 hermes_cli/kanban_priority_feed.py            | 33 ++++++----
 .../test_kanban_priority_fixed_head.py        | 66 +++++++++++++++++++
 2 files changed, 88 insertions(+), 11 deletions(-)

diff --git a/hermes_cli/kanban_priority_feed.py b/hermes_cli/kanban_priority_feed.py
index 3742efe6d0..4433b90ea1 100644
--- a/hermes_cli/kanban_priority_feed.py
+++ b/hermes_cli/kanban_priority_feed.py
@@ -18,15 +18,27 @@ def check_interval(hub, board: str, rows: list[dict], first: int, target: int) -
     - status is replayed onto the rows (a card finishing or reopening);
     - a card CREATED in the window (its first in-window change is the Board's
       full creation row, ``version`` 1) joins the inventory even when its id
-      sorts into a page read before it existed. Open at ``target`` it needs an
-      origin and an integer priority <= ``PRIORITY_CAP`` (the apply-time
-      arrival rule); terminal at ``target`` it is out of manifest scope.
+      sorts into a page read before it existed. Terminal at ``target`` it is
+      kept as a terminal row, exactly as a later page would have shown it, so
+      it is outside the manifest rows but still resolves an ``exceptions``
+      entry whatever the page timing. Open at ``target`` it needs an origin and
+      an integer priority <= ``PRIORITY_CAP``. That is fail-closed on purpose:
+      the same card paged after its creation would be planned and normalized,
+      but one that appeared after the first head is an arrival, and this
+      mirrors ``kanban_priority_inventory.classify``'s apply-time arrival rule
+      instead of normalizing a card the capture never paged.
 
-    Identity, origin and priority are never replayed: any in-window value that
-    differs from the row refuses, as do deletes and a card missing from the
-    snapshot that is open (or of unknown status) at ``target`` without a
-    creation row (it existed before ``first``). No import or priority clipping
-    occurs. Local apply still requires atomic CAS.
+    Identity, origin and priority are never replayed, so the result is the
+    ``target`` inventory only when every in-window change carries the row's
+    value. A row paged after its ONLY in-window priority change already holds
+    the ``target`` value and passes. Any other in-window value that differs
+    from the row refuses: a priority change on a page read before it, an
+    earlier full-row upsert with the old priority (a creation row or a title
+    edit followed by a re-prioritisation), and any origin or identity change.
+    Deletes refuse too, as does a card missing from the snapshot that is open
+    (or of unknown status) at ``target`` without a creation row (it existed
+    before ``first``); terminal there, such a card stays out of the rows. No
+    import or priority clipping occurs. Local apply still requires atomic CAS.
     """
     inventory = {row['id']: row for row in rows}
     created: dict[str, dict] = {}
@@ -64,10 +76,9 @@ def check_interval(hub, board: str, rows: list[dict], first: int, target: int) -
             row['status'] = status
     from hermes_cli.kanban_priority import PRIORITY_CAP
     for row in created.values():
-        if row['status'] in _TERMINAL:
-            continue
         origin, value = row.get('created_on'), row.get('priority')
-        if not isinstance(origin, str) or not origin or type(value) is not int or value > PRIORITY_CAP:
+        if row['status'] not in _TERMINAL and (
+                not isinstance(origin, str) or not origin or type(value) is not int or value > PRIORITY_CAP):
             raise ValueError(f'{_CHANGED} (new open card exceeds cap or lacks origin)')
         rows.append(row)
     rows.sort(key=lambda row: row['id'])
diff --git a/tests/hermes_cli/test_kanban_priority_fixed_head.py b/tests/hermes_cli/test_kanban_priority_fixed_head.py
index 0cf986d78f..9171a4c52b 100644
--- a/tests/hermes_cli/test_kanban_priority_fixed_head.py
+++ b/tests/hermes_cli/test_kanban_priority_fixed_head.py
@@ -264,3 +264,69 @@ def test_busy_board_priority_change_before_its_page_is_read_is_the_fixed_head_va
         board = BusyBoard(seed, inject=1, ahead=True)
         manifest = prepare.capture(board, board_id='board', exceptions=[])
         assert board.injected is not None and _rows(manifest) == board.truth
+
+
+# ---- review follow-ups (PR #2025 nits 1-3) ------------------------------------------------------------------
+
+
+@pytest.mark.parametrize('terminal', TERMINAL)
+def test_card_created_and_finished_in_window_resolves_an_exception_like_a_later_page(terminal):
+    # Nit 2: a create-then-finish card was dropped from the rows, so an
+    # exceptions entry naming it refused ('unresolved exception') only when its
+    # page was read before the creation. It is now a terminal row either way.
+    changes = [_new(2, 'n'), _task(4, 'n', status=terminal)]
+    early = prepare.capture(Window([_row('a')], changes), board_id='board', exceptions=['n'])
+    late = prepare.capture(Window([_row('a'), {**_row('n', priority=500), 'status': terminal}], changes),
+                           board_id='board', exceptions=['n'])
+    assert early == late
+    assert early['exceptions'] == [{'id': 'n', 'status': terminal, 'origin': 'one', 'old': 500}]
+    assert _rows(early) == [('a', 10000)]
+
+
+def test_terminal_arrival_joins_the_rows_in_id_order():
+    rows = [_row('b')]
+    check_interval(Window(rows, [_new(2, 'a'), _task(3, 'a', status='done')]), 'board', rows, 1, 5)
+    assert [(row['id'], row['status']) for row in rows] == [('a', 'done'), ('b', 'ready')]
+
+
+@pytest.mark.parametrize('seed', SEEDS)
+def test_busy_board_inventory_rows_are_every_card_at_the_final_head(seed):
+    # The fixed-head invariant over ALL statuses, not just the open manifest
+    # rows: create-then-finish ("flash") cards are terminal rows, as a later
+    # page would show them.
+    board = BusyBoard(seed)
+    rows = prepare._inventory(board, 'board')
+    assert [(r['id'], r['status'], r['priority']) for r in rows] == [
+        (u, r['status'], r['priority']) for u, r in sorted(board.tasks.items())]
+
+
+@pytest.mark.parametrize('earlier', [
+    pytest.param(lambda: _task(2, 'b', **{**_row('b'), 'title': 'edited'}), id='full-row-edit-with-old-priority'),
+    pytest.param(lambda: _task(2, 'b', priority=10000), id='patch-with-old-priority'),
+])
+def test_priority_change_after_an_earlier_in_window_old_value_refuses_even_paged_late(earlier):
+    # Nit 1: "exact" holds for a row's ONLY in-window priority change. An
+    # earlier in-window change still carrying the old priority disagrees with
+    # the late-paged row (which already holds the new value), so capture
+    # fails closed rather than replaying priority.
+    hub = Window([_row('a'), _row('b', priority=7)], [earlier(), _task(3, 'b', priority=7)])
+    with pytest.raises(ValueError, match='changed'):
+        prepare.capture(hub, board_id='board', exceptions=[])
+
+
+def test_only_in_window_priority_change_paged_late_is_exact():
+    hub = Window([_row('a'), _row('b', priority=7)], [_task(3, 'b', priority=7)])
+    assert _rows(prepare.capture(hub, board_id='board', exceptions=[])) == [('a', 10000), ('b', 7)]
+
+
+def test_above_cap_card_paged_before_the_window_is_planned_but_an_above_cap_arrival_refuses():
+    # Nit 3: deliberate asymmetry. A paged above-cap card is in the snapshot
+    # and normalized; one created in the window is an arrival and refuses, as
+    # kanban_priority_inventory.classify refuses it at apply time.
+    paged = prepare.capture(Window([_row('a'), _row('n', priority=PRIORITY_CAP + 1)], []),
+                            board_id='board', exceptions=[])
+    assert [row['id'] for row in paged['rows']] == ['a', 'n']
+    assert all(row['new'] <= paged['ceiling'] for row in paged['rows'])
+    with pytest.raises(ValueError, match='exceeds cap'):
+        prepare.capture(Window([_row('a')], [_new(2, 'n', priority=PRIORITY_CAP + 1)]),
+                        board_id='board', exceptions=[])
