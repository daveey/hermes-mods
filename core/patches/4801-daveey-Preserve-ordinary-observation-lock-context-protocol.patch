From 86c2c97b6e2407829075da12dee644d10d4c6000 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 07:16:00 +0000
Subject: [PATCH] [daveey] Preserve ordinary observation lock context protocol

CI exposed a direct consumer using a context-manager lock spy. Outside bounded recording preserve the existing with-lock protocol; timed acquisition remains mandatory inside the record deadline. Proof: previously failing test_store_query_holds_scope_lock plus budget and real socket/transaction suites: 56 passed.
---
 agent/origin_observation_budget.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/agent/origin_observation_budget.py b/agent/origin_observation_budget.py
index 1d34ade17650bdab7f40378e78c9b547d5c6166a..9e8ff34be31a7a4cb0080e081efe9dda5215f1f9 100644
--- a/agent/origin_observation_budget.py
+++ b/agent/origin_observation_budget.py
@@ -42,7 +42,12 @@ def bounded_record(fn):
 @contextmanager
 def observation_lock(lock):
     left = remaining()
-    acquired = lock.acquire() if left is None else lock.acquire(timeout=left)
+    if left is None:
+        # Ordinary calls retain the lock's context-manager protocol.
+        with lock:
+            yield
+        return
+    acquired = lock.acquire(timeout=left)
     if not acquired:
         raise TimeoutError('origin_observation_timeout')
     try:
-- 
