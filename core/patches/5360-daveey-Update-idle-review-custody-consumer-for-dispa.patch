From 211900189c9b2d19c72f9397d8428f2a3aaa6fa4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 01:59:54 +0000
Subject: [PATCH] [daveey] Update idle review custody consumer for
 dispatch-owned settlement

CI exposed a stale manual release in test_local_work_agent_seams after dispatch began owning settlement. Assert retained custody during spawn, release on dispatch exit and idempotent fallback cleanup instead.

Proof: original consumer reproduced RED; canonical queue/review and local-work agent consumer suites GREEN (4 files). No production behavior changes.
---
 tests/agent/test_local_work_agent_seams.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/agent/test_local_work_agent_seams.py b/tests/agent/test_local_work_agent_seams.py
index 64b8b4a727..f3f6c79143 100644
--- a/tests/agent/test_local_work_agent_seams.py
+++ b/tests/agent/test_local_work_agent_seams.py
@@ -190,7 +190,9 @@ def test_idle_queue_item_reserves_at_pop_and_empty_poll_does_not(reg, monkeypatc
     assert item is not None and reg.snapshot().active == 1, 'selected item is tracked atomically with the pop'
     item.context.run(queue._dispatch, item)
     assert spawned == [1]
-    item.work.release()
+    assert item.work is None, 'dispatch settles its own reservation, not the caller'
+    assert reg.snapshot().active == 0, 'dispatch retains custody through spawn then releases'
+    item.finish()  # the outer dispatcher fallback is idempotent
     _clean(reg)
 
 
