From b95d0f46d426348c0d116e77c3264218803f9967 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 07:00:32 +0000
Subject: [PATCH] [daveey] Preserve updater import closure and ref-lock metric
 schema

Fix CI consumers: preload ref-lock diagnostics before checkout swap, expose the new failure token in the shipped schema, and avoid writing empty ledgers for unrelated receipts. Proof: reproduced schema/post-swap failures; 191 focused tests pass (one Windows-only skip), all 20 scripts/check gates pass.
---
 .../schemas/hermes.shared_metrics.v4.schema.json       |  1 +
 hermes_cli/update_cmd_commit.py                        |  1 +
 hermes_cli/update_ref_lock_alert.py                    |  4 +++-
 tests/hermes_cli/test_update_ref_lock_alert.py         | 10 ++++++++++
 4 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/observability/schemas/hermes.shared_metrics.v4.schema.json b/hermes_cli/observability/schemas/hermes.shared_metrics.v4.schema.json
index bb8ef326b6956c4a958f69cf8f8010a5d2b8f792..708f8bfb659e5f8a48141c9eb2404d401eb9fa81 100644
--- a/hermes_cli/observability/schemas/hermes.shared_metrics.v4.schema.json
+++ b/hermes_cli/observability/schemas/hermes.shared_metrics.v4.schema.json
@@ -2769,6 +2769,7 @@
                     "git_failed",
                     "git_in_progress",
                     "git_index_locked",
+                    "ref_lock_stale",
                     "git_timeout",
                     "head_moved",
                     "interrupted",
diff --git a/hermes_cli/update_cmd_commit.py b/hermes_cli/update_cmd_commit.py
index 0c99d76ea4e4e9935d7af3910f1698f5085335ea..0c5d25b0294882ffa2896a4bd73631e849975e57 100644
--- a/hermes_cli/update_cmd_commit.py
+++ b/hermes_cli/update_cmd_commit.py
@@ -101,6 +101,7 @@ POST_MOVE_MODULES = (
     "hermes_cli.source_check",
     "hermes_cli.update_cmd_fleet_unit_budget",
     "hermes_cli.update_serve_obligations",
+    "hermes_cli.update_ref_lock_alert",
     "pm.lock",
     "tools.environments.local",
 )
diff --git a/hermes_cli/update_ref_lock_alert.py b/hermes_cli/update_ref_lock_alert.py
index 644beaa3ec70b88cf43bec34247efe5e74239677..89f7cf2c6e3cb317d8586b4f2aceef1f98312f03 100644
--- a/hermes_cli/update_ref_lock_alert.py
+++ b/hermes_cli/update_ref_lock_alert.py
@@ -138,6 +138,7 @@ def observe(data: dict[str, Any], *, directory: Optional[Path] = None,
         path = _ledger_path(directory)
         with _locked(path):
             ledger = _load(path)
+            before = json.dumps(ledger, sort_keys=True)
             entries = ledger["entries"]
             for k in [k for k, e in entries.items() if now - e.get("seen_at", 0) > _MAX_AGE_S]:
                 del entries[k]
@@ -162,7 +163,8 @@ def observe(data: dict[str, Any], *, directory: Optional[Path] = None,
                 except Exception as exc:
                     entry["attempts"] = entry.get("attempts", 0) + 1
                     logger.warning("ref-lock alert card not filed (will retry): %s", exc, exc_info=True)
-            _store(path, ledger)
+            if json.dumps(ledger, sort_keys=True) != before:  # every finalize passes here; most change nothing
+                _store(path, ledger)
     except Exception:
         logger.warning("ref-lock alert bookkeeping failed", exc_info=True)
     return published
diff --git a/tests/hermes_cli/test_update_ref_lock_alert.py b/tests/hermes_cli/test_update_ref_lock_alert.py
index 4686e45daa40d4c08e3571bc2189c35edd7921bf..40087b31cb9024111ddeaf2ba06db2e28839b090 100644
--- a/tests/hermes_cli/test_update_ref_lock_alert.py
+++ b/tests/hermes_cli/test_update_ref_lock_alert.py
@@ -294,3 +294,13 @@ def test_lock_acquisition_failure_does_not_write_or_publish(tmp_path, monkeypatc
         assert alert.observe(_data("first"), directory=tmp_path) == []
     assert not (tmp_path / alert._LEDGER).exists()
     assert any(r.exc_info and "bookkeeping failed" in r.message for r in caplog.records)
+
+
+def test_unrelated_receipt_leaves_no_ledger_file(tmp_path):
+    # Every finalized receipt (refused, ok, ...) is observed; only a ref-lock stop may write state,
+    # else a bare receipt-dir listing finds a non-receipt json (test_update_contract refusal receipt).
+    data = _data("first")
+    data.pop(alert.FACT, None)
+    data["outcome"] = "refused"
+    assert alert.observe(data, directory=tmp_path) == []
+    assert not (tmp_path / alert._LEDGER).exists()
-- 
2.43.0

