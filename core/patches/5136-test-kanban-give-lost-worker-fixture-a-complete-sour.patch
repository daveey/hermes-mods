From 9cdf560c3fc76b6f9d5233d4c5ecdea88a9d5963 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 10:20:05 +0000
Subject: [PATCH] test(kanban): give lost-worker fixture a complete source
 claim [daveey]

Required CI caught two failures in the loss-order consumer omitted by the
initial import-only selection. Its fabricated policy carried db/task_id but
not run_id/claim_lock, so the new fail-closed source boundary refused before
launching the child. Claim the disposable task normally and freeze all four
identity fields. Stub only unrelated cgroup placement, because this isolated
fixture has no dispatcher submitter. Keep actual managed child and loss /
cancellation ordering assertions intact; do not relax source validation.

Proof: exact published head CI 44715003744 failed both loss-order tests;
canonical local red reproduced. Updated source+loss tests: 16 passed.
Expanded direct+managed consumer selection: 37 files,662 passed,7 skipped,
0 failed with file retries disabled. Production source unchanged.

Co-Authored-By: GPT-6.1-sol <noreply@openai.com>
---
 tests/gateway/test_managed_worker_unknown_status.py | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/tests/gateway/test_managed_worker_unknown_status.py b/tests/gateway/test_managed_worker_unknown_status.py
index 9171ceece2..51e575a4f7 100644
--- a/tests/gateway/test_managed_worker_unknown_status.py
+++ b/tests/gateway/test_managed_worker_unknown_status.py
@@ -87,6 +87,8 @@ def _kanban_loss_recorder(monkeypatch, policy, started, release, write_s):
         order.append('worker_lost')
     settle = session_worker_reservation.lose_admission_worker
     monkeypatch.setattr(session_kanban, 'record_worker_loss', record)
+    # This loss-order fixture has no dispatcher submitter or per-run cgroup.
+    monkeypatch.setattr('gateway.session_kanban_scope.resolve_run_scope', lambda _: None)
     monkeypatch.setattr(session_worker_reservation, 'lose_admission_worker',
                         lambda *a, **kw: (order.append('settled'), settle(*a, **kw))[1])
     # A real ordinary (scratch) card on a real board, as build_kanban_policy freezes it: the capsule gate
@@ -97,7 +99,11 @@ def _kanban_loss_recorder(monkeypatch, policy, started, release, write_s):
     board = kb.init_db()
     with connect_closing() as conn:
         task_id = kb.create_task(conn, title='lost worker')
-    return dataclasses.replace(policy, kanban_json=json.dumps({'task_id': task_id, 'db': str(board)})), order
+        task = kb.claim_task(conn, task_id)
+        assert task is not None
+    context = {'task_id': task_id, 'db': str(board), 'run_id': task.current_run_id,
+               'claim_lock': task.claim_lock}
+    return dataclasses.replace(policy, kanban_json=json.dumps(context)), order
 
 
 @pytest.mark.platforms("linux")
