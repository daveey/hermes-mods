From 4897e78880e91de5027c9a2128c5fbb78598ed43 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 00:08:53 -0700
Subject: [PATCH] fix(resume): bound a replaced backend's durable pause hold to
 HOLD_MAX_S; paused continuation takes over idle detached holders [daveey]

Review of 0514681bb4: the durable core_update_pause hold had no time bound, so a
continuation refused forever (live foreign owner, startup sweep gave up after 600s)
refused every automatic notice for the whole freshness window (240 min). The hold
now starts when this backend first sees the pause, keyed by the pause identity
(started_at, paused_at, pauses), and releases after HOLD_MAX_S (305s) like the
in-place hold; re-reading the same marker never re-arms it, a new pause does.

Paused continuations used allow_takeover=False, so an idle detached sibling holding
the lease blocked them until the WS orphan reap (20s grace, longer while a
detached turn runs). They now take over only an idle detached holder; a mid-turn
holder (notice, another reader's continuation) is never interrupted and the 30s
refusal backoff retries.
---
diff --git a/tests/tui_gateway/test_update_pause_recovery.py b/tests/tui_gateway/test_update_pause_recovery.py
index d91ec37ce582cc07d25a45f2a64e6541626ae7cc..19f5c0cd44adffb06b3717e1d2288fa40b74b4d5 100644
--- a/tests/tui_gateway/test_update_pause_recovery.py
+++ b/tests/tui_gateway/test_update_pause_recovery.py
@@ -129,7 +129,7 @@ def test_replaced_backend_slot_refusal_backs_off(recovery, monkeypatch):
     monkeypatch.setattr(server, "time", types.SimpleNamespace(time=time.time, monotonic=lambda: clock[0]))
     monkeypatch.setattr(server, "_start_session_work", lambda fn, **kw: fn() or True)
     def slot(*args, **kwargs):
-        assert kwargs == {"allow_takeover": False}
+        assert kwargs == {"takeover_idle_only": True}
         attempts.append(clock[0])
         return "another live owner" if len(attempts) == 1 else None
     monkeypatch.setattr(server, "_ensure_active_session_slot", slot)
@@ -190,6 +190,75 @@ def test_pause_readers_use_exclusive_slot_without_detached_takeover(recovery, mo
         server._release_active_session_slot(second)
 
 
+@pytest.mark.parametrize("holder_running", [False, True])
+def test_pause_reader_takes_over_only_an_idle_detached_holder(recovery, monkeypatch, holder_running):
+    _detached_ws_transport = server._detached_ws_transport
+    af.set_hold(recovery.home)
+    sid = mount()["session_id"]
+    af.clear_hold(recovery.home)
+    first = server._sessions[sid]
+    # A same-process sibling runtime of this chat lost its client but still holds the lease.
+    holder = {**first, "history_lock": threading.Lock(), "transport": _detached_ws_transport,
+              "running": holder_running}
+    holder.pop("active_session_lease", None)
+    server._sessions["holder"] = holder
+    assert recovery.real_slot("holder", holder) is None
+    monkeypatch.setattr(server, "_ensure_active_session_slot", recovery.real_slot)
+    monkeypatch.setattr(server, "_start_session_work", lambda fn, **kw: fn() or True)
+    monkeypatch.setattr(server, "_interrupt_session_turn", lambda *a, **kw: None)
+    try:
+        assert server._maybe_schedule_auto_continue(sid, first, "paused") is not None
+        if holder_running:
+            # Mid-turn holder (a notice, another reader's continuation): never interrupted; retry backs off.
+            assert recovery.calls == [] and not first["running"]
+            assert holder.get("active_session_lease") is not None
+            assert first["_auto_continue_retry_after"] > time.monotonic()
+        else:
+            # Idle holder: no wait for its reap, the paused turn continues now.
+            assert_continued(recovery)
+            assert holder.get("active_session_lease") is None
+    finally:
+        server._release_active_session_slot(first)
+        server._release_active_session_slot(holder)
+
+
+def test_replaced_backend_durable_hold_is_bounded(recovery, monkeypatch):
+    # Fresh backend whose continuation is refused forever (a live foreign owner): notices wait for the
+    # paused turn at most HOLD_MAX_S, like the in-place hold, then flow; re-reading never re-arms it.
+    af.set_hold(recovery.home)
+    sid = mount()["session_id"]
+    af.clear_hold(recovery.home)
+    session = server._sessions[sid]
+    mono = [1000.0]
+    monkeypatch.setattr(up, "_mono", lambda: mono[0])
+    monkeypatch.setattr(server, "_start_session_work", lambda fn, **kw: fn() or True)
+    monkeypatch.setattr(server, "_ensure_active_session_slot", lambda *a, **kw: "another live owner")
+    assert server._maybe_schedule_auto_continue(sid, session, "paused") is not None
+    assert recovery.calls == []
+    def claim():
+        claimed = server._notif_claim_turn(session)
+        session["running"] = False
+        return claimed
+    for dt in (0.0, 60.0, up.HOLD_MAX_S - 1):
+        mono[0] = 1000.0 + dt
+        assert up.continuation_due(session) and not claim(), dt
+    for dt in (up.HOLD_MAX_S, 900.0, 3600.0, 3 * 3600.0):
+        mono[0] = 1000.0 + dt
+        monkeypatch.setattr(up, "_now", lambda dt=dt: time.time() + min(dt, 3600.0))
+        assert not up.continuation_due(session) and claim(), dt
+    # A new pause (fresh paused_at) by a dead writer is a new hold, bounded the same way.
+    mark_turn_paused(recovery.home, "paused", up.PAUSE_REASON)
+    path = recovery.home / "desktop" / "interrupted_turns.json"
+    entries = json.loads(path.read_text())
+    entries["paused"]["writer_pid"] = 2 ** 22 - 3
+    entries["paused"].pop("writer_start_time", None)
+    path.write_text(json.dumps(entries))
+    monkeypatch.setattr(up, "_now", time.time)
+    assert up.continuation_due(session) and not claim()
+    mono[0] += up.HOLD_MAX_S
+    assert not up.continuation_due(session) and claim()
+
+
 def test_typed_message_during_build_retires_scheduled_pause(recovery, monkeypatch):
     from tui_gateway.turn_marker import clear_turn_marker
     af.set_hold(recovery.home)
diff --git a/tui_gateway/session_auto_continue.py b/tui_gateway/session_auto_continue.py
index f28e627f3efd93a05c5a1c4b1953c3d2302dfc11..82950679a8e991220b0301d990f85a18bd8ebb9e 100644
--- a/tui_gateway/session_auto_continue.py
+++ b/tui_gateway/session_auto_continue.py
@@ -227,7 +227,9 @@ def _maybe_schedule_auto_continue(sid: str, session: dict, session_key: str) ->
         # marker and still be mid-turn. Leave the marker so a later resume retries.
         # Running the continuation anyway would be the double-writer this fence exists to prevent. See
         # #94778.
-        slot_error = (_ensure_active_session_slot(sid, session, allow_takeover=False) if paused
+        # A paused continuation takes over only an idle detached sibling: one mid-turn (a notice, another
+        # reader's continuation) keeps the slot and this retries after the 30 s backoff below.
+        slot_error = (_ensure_active_session_slot(sid, session, takeover_idle_only=True) if paused
                       else _ensure_active_session_slot(sid, session))
         if slot_error is not None:
             logger.info("auto-continue for %s refused: session has another live owner", session_key)
diff --git a/tui_gateway/update_pause.py b/tui_gateway/update_pause.py
index 150cb600618ac4eee3a6580204443757dbe2f94e..4646a3fab42a4926af4175b10c861b6493096397 100644
--- a/tui_gateway/update_pause.py
+++ b/tui_gateway/update_pause.py
@@ -70,6 +70,10 @@ def _now() -> float:
     return time.time()
 
 
+def _mono() -> float:
+    return time.monotonic()
+
+
 def _home(session: dict) -> Path:
     from tui_gateway import server
     return Path(session.get("profile_home") or server._hermes_home)
@@ -361,8 +365,18 @@ def _durable_continuation_due(session: dict) -> bool:
     # indefinitely starve automatic delivery when the startup reader skips them.
     with server._session_profile_runtime_scope(session):
         enabled, freshness, attempts = server._auto_continue_config()
-    return bool(enabled and _now() - marker["started_at"] <= freshness
-                and marker["attempts"] < attempts)
+    if not (enabled and _now() - marker["started_at"] <= freshness and marker["attempts"] < attempts):
+        return False
+    # Same cap as the in-place hold (HOLD_MAX_S): a continuation this backend keeps failing to admit
+    # (a live foreign owner, a startup sweep that gave up) must not refuse the chat's notices for the
+    # whole freshness window. The clock starts when this backend first sees this pause and is keyed by
+    # the pause's identity, so re-reading the same marker never re-arms it; only a new pause does.
+    identity = (marker.get("started_at"), marker.get("paused_at"), marker.get("pauses"))
+    with session["history_lock"]:
+        seen = session.get("_update_pause_durable_seen")
+        if not seen or seen[0] != identity:
+            seen = session["_update_pause_durable_seen"] = (identity, _mono())
+    return _mono() - seen[1] < HOLD_MAX_S
 
 
 def _note_watching(session: dict) -> None:
