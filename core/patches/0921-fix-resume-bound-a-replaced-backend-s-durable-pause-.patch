 tui_gateway/session_auto_continue.py          |  4 +-
 tui_gateway/session_lifecycle.py              | 13 ++--
 tui_gateway/update_pause.py                   | 18 ++++-
 4 files changed, 98 insertions(+), 8 deletions(-)

