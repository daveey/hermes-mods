diff --git a/tests/hermes_cli/test_kanban_human_request_choices.py b/tests/hermes_cli/test_kanban_human_request_choices.py
new file mode 100644
index 00000000000..f89f2f6920b
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_human_request_choices.py
@@ -0,0 +1,51 @@
+"""A blocked card's ``human_request`` may carry decision ``choices`` (2-6 short {label, value}); they survive
+validation and storage on create and block, and a malformed list is refused. [daveey]"""
+import json
+
+import pytest
+
+from hermes_cli import kanban_db as db
+from hermes_cli.kanban_db_connect import connect_closing
+from hermes_cli.kanban_human_request import validate_human_request
+
+CHOICES = [{"label": "Ship it", "value": "ship"}, {"label": "Hold", "value": "hold"}]
+REQUEST = dict(action="Reply ship or hold in this chat. Unblock = deploy; archive = drop it.",
+               why_human="Release owner decision required", interaction="approval", scope="Staging only",
+               evidence="Release policy", choices=CHOICES)
+
+
+def _stored(tid):
+    with connect_closing() as conn:
+        return json.loads(conn.execute("SELECT human_request FROM tasks WHERE id = ?", (tid,)).fetchone()[0])
+
+
+def test_choices_are_kept_on_create_and_on_block():
+    with connect_closing() as conn:
+        tid = db.create_task(conn, title="Deploy?", assignee="owner", initial_status="blocked",
+                             human_request=REQUEST, lint_blocked=False)
+    assert _stored(tid)["choices"] == CHOICES
+    with connect_closing() as conn:
+        other = db.create_task(conn, title="Deploy later?", assignee="owner")
+        assert db.block_task(conn, other, reason="owner decides", kind="needs_input", human_request=REQUEST)
+    assert _stored(other)["choices"] == CHOICES
+
+
+@pytest.mark.parametrize("bad", [
+    "ship or hold",                                              # not a list
+    [{"label": "Only one", "value": "one"}],                     # fewer than 2
+    [{"label": f"c{i}", "value": f"v{i}"} for i in range(7)],    # more than 6
+    [{"label": "Ship", "value": ""}, {"label": "Hold", "value": "hold"}],     # empty value
+    [{"label": "x" * 61, "value": "a"}, {"label": "Hold", "value": "hold"}],  # label too long
+    [{"label": "A", "value": "same"}, {"label": "B", "value": "same"}],       # duplicate value
+])
+def test_invalid_choices_are_rejected(bad):
+    with pytest.raises(ValueError, match="choice"):
+        validate_human_request({**REQUEST, "choices": bad})
+    with connect_closing() as conn, pytest.raises(ValueError, match="choice"):
+        db.create_task(conn, title="Bad ask", assignee="owner", initial_status="blocked",
+                       human_request={**REQUEST, "choices": bad}, lint_blocked=False)
+
+
+def test_a_request_without_choices_is_unchanged():
+    plain = {k: v for k, v in REQUEST.items() if k != "choices"}
+    assert validate_human_request(plain) == plain
diff --git a/tests/hermes_state/test_empty_draft_archive.py b/tests/hermes_state/test_empty_draft_archive.py
new file mode 100644
index 00000000000..91a64de13f4
--- /dev/null
+++ b/tests/hermes_state/test_empty_draft_archive.py
@@ -0,0 +1,61 @@
+"""Drafts (session-outcome contract, lane A2): maintenance archives interactive rows that never got a message and
+are older than 24 h; pinned rows and young drafts stay. The pass runs from the gateway's state.db maintenance
+tick whatever ``sessions.auto_archive`` says. [daveey]"""
+
+from __future__ import annotations
+
+import time
+
+import pytest
+
+from hermes_state import SessionDB
+
+
+@pytest.fixture
+def db(tmp_path):
+    handle = SessionDB(db_path=tmp_path / "state.db")
+    yield handle
+    handle.close()
+
+
+def _draft(db, sid, age_h, *, source="desktop", pinned=False):
+    db.create_session(sid, source=source)
+    then = time.time() - age_h * 3600
+    db._conn.execute("UPDATE sessions SET started_at = ?, last_activity_at = ?, pinned = ? WHERE id = ?",
+                     (then, then, int(pinned), sid))
+    db._conn.commit()
+
+
+def _archived(db, sid):
+    return bool(db.get_session(sid)["archived"])
+
+
+def test_old_empty_drafts_are_archived_pinned_and_young_ones_stay(db):
+    _draft(db, "old", 30)
+    _draft(db, "pinned", 30, pinned=True)
+    _draft(db, "young", 2)
+    _draft(db, "used", 30)
+    db.append_message("used", role="user", content="hello")
+    db._conn.execute("UPDATE sessions SET last_activity_at = ? WHERE id = 'used'", (time.time() - 30 * 3600,))
+    db._conn.execute("UPDATE messages SET timestamp = ? WHERE session_id = 'used'", (time.time() - 30 * 3600,))
+    db._conn.commit()
+    _draft(db, "telegram", 30, source="telegram")
+
+    assert db.maybe_archive_empty_drafts() == 1
+
+    assert [s for s in ("old", "pinned", "young", "used", "telegram") if _archived(db, s)] == ["old"]
+    assert db.maybe_archive_empty_drafts() == 0  # throttled for the hour
+
+
+def test_gateway_maintenance_tick_archives_drafts_without_auto_archive(monkeypatch, db):
+    from gateway import run
+    from hermes_cli import config
+    import hermes_state_registry
+    _draft(db, "old", 30)
+    monkeypatch.setattr(config, "load_config", lambda: {"sessions": {"auto_archive": False, "auto_prune": False}})
+    monkeypatch.setattr(hermes_state_registry, "acquire", lambda *a, **k: db)
+    monkeypatch.setattr(hermes_state_registry, "release_or_close", lambda handle: None)
+
+    run._housekeeping_state_db_maintenance()
+
+    assert _archived(db, "old")
diff --git a/tests/tui_gateway/test_notice_guarantee.py b/tests/tui_gateway/test_notice_guarantee.py
new file mode 100644
index 00000000000..c001b7aee48
--- /dev/null
+++ b/tests/tui_gateway/test_notice_guarantee.py
@@ -0,0 +1,115 @@
+"""Notice guarantee (session-outcome contract, lane A2): a chat whose last message is a kanban notice older than
+5 minutes, with no live turn, gets ONE close-out wake (budget 2/h); a wake that does not start, or a spent budget,
+leaves the stored outcome ``unresolved{notice_tail}``; a notice about a card blocked on a human never wakes and
+refreshes to ``decision``. [daveey]"""
+
+from __future__ import annotations
+
+import contextlib
+import time
+
+import pytest
+
+import hermes_state_outcome as so
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_session_activity as ksa
+from hermes_state import SessionDB
+from tui_gateway import notice_guarantee as ng
+
+CHAT = "20261029_130000_a2guar"
+HUMAN = {"action": "Reply ship or hold here. Unblock = deploy; archive = drop it.",
+         "why_human": "Only David approves prod.", "interaction": "approval", "scope": "prod deploy",
+         "evidence": "CI green", "choices": [{"label": "Ship", "value": "ship"}, {"label": "Hold", "value": "hold"}]}
+
+
+@pytest.fixture
+def db(tmp_path):
+    so._reset_hooks_for_tests()
+    ksa._reset_cache_for_tests()
+    handle = SessionDB(tmp_path / "state.db")
+    handle.create_session(CHAT, "desktop")
+    handle.append_message(CHAT, "user", "run the deploy card")
+    handle.append_message(CHAT, "assistant", "Started the deploy card; I will report when it lands.")
+    yield handle
+    handle.close()
+    so._reset_hooks_for_tests()
+
+
+def _notice(db, text, *, age=600.0, **meta):
+    row = db.append_kanban_notice(CHAT, text, {"notice_id": f"n:{text}:{time.time()}", "display_text": text, **meta})
+    db._write_rowcount("UPDATE messages SET timestamp = ? WHERE id = ?", (time.time() - age, row))
+    return row
+
+
+def _run(db, verdict="started"):
+    calls = []
+
+    def wake(sid, msg_id):
+        calls.append((sid, msg_id))
+        return verdict
+
+    @contextlib.contextmanager
+    def opener(chat_id):
+        yield db, db.get_compression_tip(chat_id) or chat_id
+
+    out = ng.guarantee_pass(stores=lambda: iter([db]), holders=list, session_db=opener, wake=wake,
+                            spawn=lambda job: job())
+    return out, calls
+
+
+def _closeout(db, row):
+    return db._read_one("SELECT json_extract(display_metadata, '$.closeout.state') FROM messages WHERE id = ?",
+                        (row,))[0]
+
+
+def test_an_unanswered_notice_gets_one_closeout_wake(db):
+    row = _notice(db, "✔ Kanban t_aaa done — deploy card")
+
+    out, calls = _run(db)
+
+    assert calls == [(CHAT, row)] and [o["result"] for o in out] == ["dispatched"]
+    assert _closeout(db, row) == "started"
+    assert _run(db) == ([], [])  # claimed: never woken twice
+
+
+def test_young_notice_waits_for_the_grace_window(db):
+    _notice(db, "✔ Kanban t_aaa done — deploy card", age=30)
+    assert _run(db) == ([], [])
+
+
+def test_a_refused_wake_leaves_the_outcome_notice_tail(db):
+    row = _notice(db, "✔ Kanban t_aaa done — deploy card")
+
+    _out, calls = _run(db, verdict="refused")
+
+    assert len(calls) == 1 and _closeout(db, row) == "refused"
+    stored = so.get_outcome(CHAT, db=db)
+    assert (stored["kind"], stored["reason"]) == ("unresolved", "notice_tail")
+
+
+def test_a_spent_budget_refreshes_instead_of_waking(db):
+    for n in range(ng.WAKES_PER_HOUR):
+        _notice(db, f"earlier close-out {n}", closeout={"state": "started", "at": time.time() - 600})
+    _notice(db, "✔ Kanban t_aaa done — deploy card")
+
+    out, calls = _run(db)
+
+    assert calls == [] and [o["result"] for o in out] == ["refreshed:budget"]
+    stored = so.get_outcome(CHAT, db=db)
+    assert (stored["kind"], stored["reason"]) == ("unresolved", "notice_tail")
+
+
+def test_a_blocked_on_human_notice_never_wakes_and_reads_decision(db):
+    with contextlib.closing(kbc.connect()) as conn:
+        tid = kb.create_task(conn, title="prod deploy", assignee="worker", session_id=CHAT,
+                             initial_status="blocked", human_request=HUMAN, lint_blocked=False)
+    _notice(db, f"⏸ Kanban {tid} blocked: needs approval — prod deploy", task_id=tid)
+    ksa._reset_cache_for_tests()
+
+    out, calls = _run(db)
+
+    assert calls == [] and [o["result"] for o in out] == ["refreshed:human"]
+    stored = so.get_outcome(CHAT, db=db)
+    assert stored["kind"] == "decision"
+    assert stored["items"][0]["card_id"] == tid and [c["value"] for c in stored["items"][0]["choices"]] == ["ship", "hold"]
