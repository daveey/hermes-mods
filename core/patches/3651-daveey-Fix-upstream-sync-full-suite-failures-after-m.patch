         turn._ctx = SimpleNamespace(
             session_key="", session_id=event.source.chat_id, message=event.text, source=event.source,
             title_user_message=None, persist_user_display_kind=None, persist_user_display_metadata=None,
-            moa_config=None, inbound_message_id=None, mute_notification_reply=False, reply_expected=None)
+            moa_config=None, inbound_message_id=None, mute_notification_reply=False, reply_expected=None,
+            # approval_transport snapshots the turn's status routing. [daveey]
+            _loop_for_step=None, _status_chat_id=None, _status_thread_metadata=None,
+            _status_adapter_pinned=None, _status_adapter_resolver=None)
         turn._approval_owner = None
         turn._approval_notify_sync = lambda *args, **kwargs: None
         turn._runner = SimpleNamespace(_consume_pending_native_image_paths=lambda key: [])
diff --git a/tests/gateway/test_profile_create_through_gateway.py b/tests/gateway/test_profile_create_through_gateway.py
index e79b01a6bc..49e4c6ab78 100644
--- a/tests/gateway/test_profile_create_through_gateway.py
+++ b/tests/gateway/test_profile_create_through_gateway.py
@@ -67,7 +67,9 @@ def test_cli_creates_through_a_live_gateway_local_and_by_url(tmp_path, monkeypat
         profile_cmd._profile_create(parser.parse_args(["profile", "create", "viaurl"]))
         out = capsys.readouterr().out
         assert (home / "profiles" / "viaurl" / "config.yaml").is_file(), out
-        assert (user / ".local" / "bin" / "viaurl").is_file(), out
+        # tests/conftest.py points the profile wrapper dir at the sandbox. [daveey]
+        from hermes_cli.profiles import _get_wrapper_dir
+        assert (_get_wrapper_dir() / "viaurl").is_file(), out
         monkeypatch.delenv("HERMES_TUI_GATEWAY_URL")
 
         # Named: a different home with no gateway, pointed at this one by URL.
@@ -86,7 +88,7 @@ def test_cli_creates_through_a_live_gateway_local_and_by_url(tmp_path, monkeypat
         profile_cmd._profile_create(parser.parse_args(["profile", "create", "byurl2"]))
         out = capsys.readouterr().out
         assert (home / "profiles" / "byurl2" / "config.yaml").is_file(), out
-        assert not (user / ".local" / "bin" / "byurl2").exists(), out
+        assert not (_get_wrapper_dir() / "byurl2").exists(), out
         (terminal_home / "config.yaml").unlink()
         monkeypatch.delenv("HERMES_TUI_GATEWAY_URL")
 
