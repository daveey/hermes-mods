From ed89c2fd9be98efc3084bc8889d7cd9d41ac4b79 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 08:22:09 +0000
Subject: [PATCH] [daveey] Fix upstream-sync full-suite failures after merging
 upstream 55b0b261

- gateway/session_terminal_cwd: a multiplexed gateway's one routing store lives in the launch
  home; a served profile's turn no longer saves its host cwd there (C7 tenancy e2e leak).
- agent/turn_empty_response: the machinery-kind mirror carries the fork's kanban_notice and
  loop_tick producer kinds, matching gateway.response_filters.
- tests: drop the duplicate _FakeAdapter methods the merge kept in test_session_race_guard;
  test_api_context_usage's ctx stub carries the status-routing fields approval_transport reads;
  test_profile_create_through_gateway reads the sandboxed wrapper dir; the preswap replay-env
  test checks behaviour instead of reading source.
---
 agent/turn_empty_response.py                         |  6 ++++--
 gateway/session_terminal_cwd.py                      | 12 ++++++++++--
 tests/gateway/test_api_context_usage.py              |  5 ++++-
 tests/gateway/test_profile_create_through_gateway.py |  6 ++++--
 tests/gateway/test_session_race_guard.py             |  6 ------
 tests/hermes_cli/test_update_preswap_drain.py        |  8 +++++---
 6 files changed, 27 insertions(+), 16 deletions(-)

diff --git a/agent/turn_empty_response.py b/agent/turn_empty_response.py
index b231264137..08f46ee670 100644
--- a/agent/turn_empty_response.py
+++ b/agent/turn_empty_response.py
@@ -28,8 +28,10 @@ _INLINE_THINK_RE = re.compile(r'<think>|<thinking>|<reasoning>', re.IGNORECASE)
 # The persisted user-row display kinds the gateway types as machinery: the self-injected
 # internal_notification turn plus the producer-notice cards (background-process completions,
 # async delegation results). Mirrors gateway.response_filters.MACHINERY_DISPLAY_KINDS;
-# agent/ cannot import gateway/.
-_MACHINERY_DISPLAY_KINDS = frozenset({"internal_notification", "process_complete", "async_delegation_complete"})
+# agent/ cannot import gateway/. The fork's kanban_notice and loop_tick producer kinds are
+# machinery too. [daveey]
+_MACHINERY_DISPLAY_KINDS = frozenset({"internal_notification", "process_complete", "async_delegation_complete",
+                                      "kanban_notice", "loop_tick"})
 
 # Loop exit stamped when a machinery turn ends with the model adding nothing.
 NOTIFICATION_NO_REPLY_EXIT = "notification_no_reply"
diff --git a/gateway/session_terminal_cwd.py b/gateway/session_terminal_cwd.py
index 61f7ef09ac..3e559ce990 100644
--- a/gateway/session_terminal_cwd.py
+++ b/gateway/session_terminal_cwd.py
@@ -45,6 +45,14 @@ def _routing_entry(runner, session_key):
     return entry if isinstance(getattr(entry, "metadata", None), dict) else None
 
 
+def _store_is_this_profiles() -> bool:
+    """[daveey] A multiplexed gateway keeps ONE routing store, in its launch home, for every profile it
+    serves. A served profile's turn must not write its host path into that home (another tenant's
+    files), so its cwd is not saved there and restarts start it in ``terminal.cwd``."""
+    from hermes_constants import get_hermes_home, get_routing_process_hermes_home, hermes_home_key
+    return hermes_home_key(get_hermes_home()) == hermes_home_key(get_routing_process_hermes_home())
+
+
 # Which conversation (routing entry, by its creation stamp) each chat's in-process cwd record
 # belongs to. ``/new`` publishes a fresh entry: the record left by the old conversation is dropped at
 # that conversation's next turn, inside the turn's own profile scope that qualifies the record's key.
@@ -63,7 +71,7 @@ def restore_turn_cwd(runner, session_key: str | None, policy) -> object | None:
     if _record_owner.get(owner, token) != token:
         clear_session_cwd(session_key)
     _record_owner[owner] = token
-    if get_session_cwd(session_key) is None:
+    if get_session_cwd(session_key) is None and _store_is_this_profiles():
         saved = entry.metadata.get(_METADATA_KEY)
         if isinstance(saved, str) and os.path.isabs(saved) and os.path.isdir(saved):
             record_session_cwd(session_key, saved)
@@ -74,7 +82,7 @@ def persist_turn_cwd(runner, session_key: str | None, token: object | None) -> N
     """Write the chat's recorded cwd onto its routing entry when it changed. Only onto the entry the
     turn started on: a ``/new`` during the turn published a fresh one, which starts in ``terminal.cwd``."""
     entry = _routing_entry(runner, session_key) if token is not None else None
-    if entry is None or entry.created_at != token:
+    if entry is None or entry.created_at != token or not _store_is_this_profiles():
         return
     from tools.terminal_tool import get_session_cwd
     cwd = get_session_cwd(session_key)
diff --git a/tests/gateway/test_api_context_usage.py b/tests/gateway/test_api_context_usage.py
