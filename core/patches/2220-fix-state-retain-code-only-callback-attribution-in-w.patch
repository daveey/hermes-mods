From 49676b445acfbf2366c27a884f9e71f6d310f209 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 22:14:49 +0000
Subject: [PATCH] fix(state): retain code-only callback attribution in writer
 diagnostics [daveey]

---
 hermes_state.py                               |  2 +-
 hermes_state_write_diagnostics.py             | 13 +++++--
 .../test_write_diagnostics_callback.py        | 36 +++++++++++++++++++
 3 files changed, 47 insertions(+), 4 deletions(-)
 create mode 100644 tests/hermes_state/test_write_diagnostics_callback.py

diff --git a/hermes_state.py b/hermes_state.py
index 59808559076..a574e88c2a2 100644
--- a/hermes_state.py
+++ b/hermes_state.py
@@ -1127,7 +1127,7 @@ class SessionDB(
                         finally:
                             held_s = time.monotonic() - held_since
                             if held_s >= _WRITE_HOLD_WARN_S:
-                                log_write_duration(held_s, stage)
+                                log_write_duration(held_s, stage, fn)
                 # Success — periodic best-effort checkpoint + FTS merge.
                 self._note_unconfirmed_corruption(fn, first_corrupt)
                 self._write_count += 1
diff --git a/hermes_state_write_diagnostics.py b/hermes_state_write_diagnostics.py
index 3d86f115ded..9234b01ca1e 100644
--- a/hermes_state_write_diagnostics.py
+++ b/hermes_state_write_diagnostics.py
@@ -5,11 +5,12 @@ import logging
 import os
 import re
 import sys
+from types import FunctionType, MethodType
 
 logger = logging.getLogger("hermes_state")
 
 
-def log_write_duration(held_s: float, stage: str) -> None:
+def log_write_duration(held_s: float, stage: str, callback: object) -> None:
     """Attribute a completed/failed hold to code, including generic SQL wrappers.
 
     Never inspect SQL, parameters, locals, callable reprs, or exception text. The
@@ -31,9 +32,15 @@ def log_write_duration(held_s: float, stage: str) -> None:
                 frame = frame.f_back
         finally:
             del frame
+        # Exact built-in types avoid invoking arbitrary callable properties/reprs.
+        if type(callback) is MethodType:
+            callback = callback.__func__
+        callback_name = "opaque"
+        if type(callback) is FunctionType:
+            callback_name = re.sub(r"[^a-zA-Z0-9_.<>]", "_", callback.__code__.co_qualname)[:160]
         logger.warning(
-            "state.db write lock held %.1fs (pid %d) stage=%s callsites=%s",
-            held_s, os.getpid(), stage, " <- ".join(sites),
+            "state.db write lock held %.1fs (pid %d) stage=%s callback=%s callsites=%s",
+            held_s, os.getpid(), stage, callback_name, " <- ".join(sites),
         )
     except Exception:  # health: allow BLE001,S110 -- diagnostic handlers must never change commit settlement or cause replay
         # No recursive logging here: the failed handler may be the cause.
diff --git a/tests/hermes_state/test_write_diagnostics_callback.py b/tests/hermes_state/test_write_diagnostics_callback.py
new file mode 100644
index 00000000000..15900e79d7d
--- /dev/null
+++ b/tests/hermes_state/test_write_diagnostics_callback.py
@@ -0,0 +1,36 @@
+"""Callback attribution uses only bounded code metadata, never user properties."""
+import logging
+
+import pytest
+
+from hermes_state_write_diagnostics import log_write_duration
+
+
+@pytest.mark.parametrize("bound", [False, True])
+def test_callback_code_identity_not_mutable_name(caplog, bound):
+    def operation(self=None):
+        pass
+
+    operation.__qualname__ = "mutable-secret"
+    callback = operation.__get__(object()) if bound else operation
+    with caplog.at_level(logging.WARNING, logger="hermes_state"):
+        log_write_duration(1, "committed", callback)
+    assert "callback=test_callback_code_identity_not_mutable_name.<locals>.operation" in caplog.text
+    assert "mutable-secret" not in caplog.text
+
+
+def test_opaque_callable_never_inspected(caplog):
+    class Opaque:
+        def __getattribute__(self, name):
+            raise AssertionError("property-secret")
+
+        def __repr__(self):
+            raise AssertionError("repr-secret")
+
+        def __call__(self, conn):
+            return 1
+
+    with caplog.at_level(logging.WARNING, logger="hermes_state"):
+        log_write_duration(1, "committed", Opaque())
+    assert "callback=opaque" in caplog.text
+    assert "secret" not in caplog.text
-- 
2.55.0

