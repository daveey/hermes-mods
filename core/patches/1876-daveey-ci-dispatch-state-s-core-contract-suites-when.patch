From d5be956dcfef9bb6741d054f4d7ad0801ba9c949 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 10:58:14 +0000
Subject: [PATCH] [daveey] ci: dispatch state's core-contract suites when core
 main changes a file they read

bb-dev-tests.yml and hermes-sync-tests.yml (state branch) check out core main as core-fixture and fail
when a core contract they guard drifts, but they only trigger on state pushes. A core main commit that
broke one stayed green until the next state push touching their paths. This workflow dispatches both on
state's head on a main push to any core file those tests read, daily as a backstop, and on demand.
ci_main_watch already reads workflow_dispatch runs on state, so a red one opens the state ci-red card.
---
 .github/workflows/state-contract-dispatch.yml | 77 +++++++++++++++++++
 1 file changed, 77 insertions(+)
 create mode 100644 .github/workflows/state-contract-dispatch.yml

diff --git a/.github/workflows/state-contract-dispatch.yml b/.github/workflows/state-contract-dispatch.yml
new file mode 100644
index 00000000000..a8860677a3a
--- /dev/null
+++ b/.github/workflows/state-contract-dispatch.yml
@@ -0,0 +1,77 @@
+name: State contract dispatch
+
+# fork (daveey/hermes): re-runs the state branch's core-contract suites when core main changes.
+#
+# bb-dev-tests.yml and hermes-sync-tests.yml live on `state` and check out core `main` as core-fixture
+# (HERMES_TEST_CORE), where a core file they need that is missing or changed FAILS them instead of skipping.
+# They trigger only on state pushes, so a core main commit that breaks one of those contracts stayed green
+# until the next state push touching their paths (sometimes a day or more; hosts install main in 1-2 h).
+# This workflow dispatches both on state's head whenever main changes a core file they read. The dispatched
+# runs show up as `workflow_dispatch` runs on state, which ci_main_watch (hub cron) already reads: a red one
+# opens the daveey/hermes@state ci-red card.
+#
+# `paths:` = the core files the state tests read today (require_core_path / LIVE_CORE reads in state's
+# tests/ and hosts/daveey-mini/bb-dev/tests/, plus hermes-sync's own core reads). The daily schedule is the
+# backstop for anything the list misses (a transitive import, a newly added contract test).
+on:
+  push:
+    branches: [main]
+    paths:
+      - '.github/workflows/state-contract-dispatch.yml'
+      - 'agent/core_update_drain.py'
+      - 'agent/delegation_context.py'
+      - 'agent/model_routing_managed.py'
+      - 'cron/executions.py'
+      - 'cron/jobs.py'
+      - 'gateway/restart.py'
+      - 'gateway/status.py'
+      - 'hermes_cli/admission_fence.py'
+      - 'hermes_cli/backend_retirement.py'
+      - 'hermes_cli/gateway_launchd.py'
+      - 'hermes_cli/kanban_db.py'
+      - 'hermes_cli/kanban_db_connect.py'
+      - 'hermes_cli/kanban_deploy_window.py'
+      - 'hermes_cli/kanban_host_identity.py'
+      - 'hermes_cli/kanban_model_assignment.py'
+      - 'hermes_cli/plugins.py'
+      - 'hermes_cli/stderr_timestamp.py'
+      - 'hermes_cli/venv_sync.py'
+      - 'hermes_cli/web_server_sessions.py'
+      - 'pm/client.py'
+      - 'scripts/check'
+      - 'scripts/ci/upstream_sync.py'
+      - 'tests/tools/test_git_consumer_environment.py'
+      - 'tools/environments/local.py'
+      - 'tui_gateway/contracts/canonical_sessions.py'
+      - 'tui_gateway/update_pause.py'
+  schedule:
+    # 11:17 UTC = 03:17/04:17 PT: after the nightly e2e dispatch, before the morning's state pushes.
+    - cron: '17 11 * * *'
+  workflow_dispatch:
+
+permissions:
+  actions: write
+  contents: read
+
+concurrency:
+  group: state-contract-dispatch
+  cancel-in-progress: true
+
+jobs:
+  dispatch:
+    name: Dispatch state core-contract suites
+    # The runner label bb-dev-tests.yml uses (ephemeral hermes-hub VMs, gh preinstalled; see nightly-e2e.yml).
+    runs-on: [self-hosted, hermes-hub]
+    timeout-minutes: 5
+    steps:
+      - name: gh workflow run bb-dev-tests.yml / hermes-sync-tests.yml --ref state
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          set -euo pipefail
+          state_sha=$(gh api "repos/${GITHUB_REPOSITORY}/commits/state" --jq .sha)
+          for wf in bb-dev-tests.yml hermes-sync-tests.yml; do
+            gh workflow run "$wf" --repo "$GITHUB_REPOSITORY" --ref state
+            echo "dispatched $wf on state ${state_sha} (core main ${GITHUB_SHA}, event ${GITHUB_EVENT_NAME})" \
+              | tee -a "$GITHUB_STEP_SUMMARY"
+          done
-- 
2.55.0

