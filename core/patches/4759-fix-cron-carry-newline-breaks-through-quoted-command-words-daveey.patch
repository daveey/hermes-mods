From ea790a11d57990446400d46defa09f625016678c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 02:23:17 +0000
Subject: [PATCH] fix(cron): carry newline breaks through quoted command words
 [daveey]

The command walker collected nested expansion offsets but omitted the collector
when a command contained a double-quoted word. That lost executable newlines
on command -> quoted word -> command traversal in an opaque parameter frame.
Forward the collector at the quote boundary and shift offsets through the
existing constant-time output accounting. Preserve whole outer-word scans.

Add both independent-review RUN reproducers with real Bash marker execution
and allowed clean twins. At 9db60d055894 these produce 2 failed / 6 passed;
after the fix the eight rows pass.

Addresses review 5949444455 on PR #2925.
---
 cron/lifecycle_guard_lines.py                               | 5 +++--
 .../cron/test_lifecycle_guard_nested_review_regressions.py  | 6 +++++-
 2 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/cron/lifecycle_guard_lines.py b/cron/lifecycle_guard_lines.py
index c3df04d333237ddd21dca820057eaf4c06f96daf..7dbcb9e489e6abbf81ffb52187e9c29c2bf3330d 100644
--- a/cron/lifecycle_guard_lines.py
+++ b/cron/lifecycle_guard_lines.py
@@ -343,7 +343,8 @@ def _walk_command_span(text: str, start: int, shlex_quotes: bool,
             continue
         nested: list[int] | None = None
         if char == '"':
-            end, span = _double_span(text, pos + 1, shlex_quotes=shlex_quotes)
+            nested = [] if breaks is not None else None
+            end, span = _double_span(text, pos + 1, shlex_quotes=shlex_quotes, breaks=nested)
         elif char in "$`":
             nested = [] if breaks is not None else None
             end, span = _expansion(text, pos, in_double=False, shlex_quotes=shlex_quotes,
@@ -464,7 +465,7 @@ def _expansion(text: str, pos: int, *, in_double: bool, shlex_quotes: bool,
     """Return an opaque span, or an empty span when ordinary scanning should proceed.
 
     *breaks* collects command-separating newlines of nested ``$(...)`` frames (see
-    ``_command_span``); backtick bodies and double-quoted frames do not report them."""
+    ``_command_span``), including through double-quoted words; backtick bodies report none."""
     if text.startswith("${", pos):
         return _parameter_span(text, pos + 2, shlex_quotes=shlex_quotes, breaks=breaks)
     elif text.startswith("$(", pos) and not text.startswith("$((", pos):
diff --git a/tests/cron/test_lifecycle_guard_nested_review_regressions.py b/tests/cron/test_lifecycle_guard_nested_review_regressions.py
index 76220d9892f32048218623cf6aad2e53cea6fc4a..964ca7fbdcc1ca7c3b78f1bcc1dab98f96000f3a 100644
--- a/tests/cron/test_lifecycle_guard_nested_review_regressions.py
+++ b/tests/cron/test_lifecycle_guard_nested_review_regressions.py
@@ -9,9 +9,13 @@ RUN = [
     'echo ' + DEEP + '; bash ./r.sh',
     'echo "${x:-${y:-"\'"} "$(true\nbash ./r.sh)"}"',
 ]
+RUN += [
+    'echo "${x:-${y:-"\'"} $(echo "$(true\nbash ./r.sh)")}"',
+    'echo "${x:-${y:-${z:-"\'"}} $(echo "$(true\nbash ./r.sh)")}"',
+]
 CLEAN = [
     "echo '" + DEEP + "'; python3 ./clean.py",
-    RUN[1].replace('bash ./r.sh', 'python3 ./clean.py'),
+    *(command.replace('bash ./r.sh', 'python3 ./clean.py') for command in RUN[1:]),
 ]
 
 
