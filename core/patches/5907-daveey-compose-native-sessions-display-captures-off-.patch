diff --git a/hermes_cli/sessions_native_source.py b/hermes_cli/sessions_native_source.py
new file mode 100644
index 00000000000..79cc7a22c84
--- /dev/null
+++ b/hermes_cli/sessions_native_source.py
@@ -0,0 +1,174 @@
+"""Native invalidation of demanded canonical session display captures. [daveey]
+
+The canonical reader runs on ChangeFeed, NOT inside a reducer or HTTP request.
+Source vectors identify captures, not a cross-database transaction. External
+annotations/time/roster have a disclosed 30s reconciliation bound. One fair queue
+retains trailing hints; a failed selector cannot starve unrelated selectors.
+"""
+from collections import OrderedDict
+from dataclasses import dataclass, replace
+import threading
+import time
+
+from hermes_cli.fact_capture import CaptureBudgetExceeded
+from hermes_cli.fact_contract import Fact
+from hermes_cli.fact_source_watch import NativeSourceWatch
+from hermes_cli.fact_store import view_key
+
+
+@dataclass(frozen=True)
+class SessionViewCapture:
+    after: int
+    next_deadline: float
+    fact: object = None
+
+
+class SessionsSource:
+    """Bounded per-endpoint inventories with read-touch LRU and fair dirty order."""
+    def __init__(self, store, source, paths, capture, *, max_views=32,
+                 max_bytes=12 * 1024 * 1024, refresh_seconds=30, reconcile=None):
+        self.store, self.source = store, source
+        self.paths, self.reader = tuple(paths), capture
+        self.max_views, self.max_bytes = max_views, max_bytes
+        self.refresh_seconds, self.reconcile = refresh_seconds, reconcile
+        self._lock = threading.Lock()
+        self._selectors = OrderedDict()
+        self._dirty = OrderedDict()
+        self._sizes, self._retry = {}, {}
+        self._retired = set()
+        self._watch = self._wake = None
+        self._closed = False
+        self._serial = 0
+        self._next_capture = 0
+        self._refresh = time.monotonic() + refresh_seconds
+
+    def watch(self, wake):
+        with self._lock:
+            if self._wake is not None or self._closed:
+                raise RuntimeError('sessions source already watched or closed')
+            self._wake = wake
+        self._watch = NativeSourceWatch(self.paths, self.invalidate)
+        return self
+
+    def _evict(self, key):
+        self._selectors.pop(key)
+        self._dirty.pop(key, None)
+        self._retry.pop(key, None)
+        self._retired.add(key)
+
+    def touch(self, name, selector):
+        key = view_key(self.source.scope, name, selector)
+        with self._lock:
+            if key in self._selectors:
+                self._selectors.move_to_end(key)
+
+    def demand(self, name, selector):
+        key = view_key(self.source.scope, name, selector)
+        with self._lock:
+            if self._closed:
+                raise RuntimeError('sessions source closed')
+            if key not in self._selectors:
+                peers = [k for k, (view, _) in self._selectors.items() if view == name]
+                if len(peers) >= self.max_views:
+                    self._evict(peers[0])
+                self._selectors[key] = (name, dict(selector))
+            self._selectors.move_to_end(key)
+            self._dirty.setdefault(key, None)
+            wake = self._wake
+        if wake is not None:
+            wake()  # ChangeFeed condition only; no file descriptor writes.
+
+    def invalidate(self):
+        with self._lock:
+            for key in self._selectors:
+                self._dirty.setdefault(key, None)
+            wake = self._wake
+        if wake is not None:
+            wake()
+
+    def refresh_at(self, wall_deadline):
+        with self._lock:
+            self._refresh = min(self._refresh, time.monotonic() + max(0, wall_deadline - time.time()))
+
+    def _deadline(self):
+        deadlines = [max(self._next_capture, self._retry.get(key, 0)) for key in self._dirty]
+        return min([self._refresh, *deadlines])
+
+    def capture(self, cursor, budget):
+        self._watch.check()
+        started = time.monotonic()
+        if started >= self._refresh and self.reconcile is not None:
+            self.reconcile()  # owner-only roster discovery, never demand/request
+        with self._lock:
+            if started >= self._refresh:
+                for key in self._selectors:
+                    self._dirty.setdefault(key, None)
+                self._refresh = started + self.refresh_seconds
+            key = next((key for key in self._dirty
+                        if started >= max(self._next_capture, self._retry.get(key, 0))), None)
+            if key is None:
+                return SessionViewCapture(self._serial, self._deadline())
+            self._dirty.pop(key)
+            name, selector = self._selectors[key]
+        observed = time.time()
+        self._serial += 1
+        try:
+            body = self.reader(name, selector)
+            if (not isinstance(body, bytes) or len(body) > min(budget.max_bytes, self.max_bytes)
+                    or time.monotonic() - started > budget.max_seconds):
+                raise CaptureBudgetExceeded('sessions view exceeds capture budget')
+            fact = Fact(key, {'encoded': body}, source_vector=((self.source, self._serial),),
+                        observed_at=observed, valid_until=observed + 2 * self.refresh_seconds,
+                        health='fresh')
+        except Exception:  # health: allow BLE001 -- isolate capture failures; unknown is not empty success
+            old = self.store.snapshot(self.source.scope).get(key)
+            fact = (replace(old, health='stale', error_code='sessions_capture_failed') if old is not None
+                    else Fact(key, {}, error_code='sessions_capture_failed'))
+            with self._lock:
+                if key in self._selectors:
+                    self._dirty.setdefault(key, None)
+                    self._retry[key] = time.monotonic() + 5
+        else:
+            with self._lock:
+                self._retry.pop(key, None)
+        with self._lock:
+            # <=50% capture duty under sustained hints, at most five passes/sec.
+            self._next_capture = time.monotonic() + max(.2, time.monotonic() - started)
+            due = self._deadline()
+        return SessionViewCapture(self._serial, due, fact)
+
+    def commit(self, capture):
+        with self._lock:
+            deleted = set(self._retired)
+            self._retired.clear()
+            fact = capture.fact
+            if fact is not None and fact.key not in self._selectors:
+                fact = None  # Evicted during capture.
+            for key in deleted:
+                self._sizes.pop(key, None)
+            if fact is not None:
+                size = len(fact.value.get('encoded', b''))
+                while sum(self._sizes.values()) - self._sizes.get(fact.key, 0) + size > self.max_bytes:
+                    victim = next(key for key in self._selectors if key != fact.key and key in self._sizes)
+                    self._evict(victim)
+                    self._sizes.pop(victim)
+                    deleted.add(victim)
+                self._sizes[fact.key] = size
+            self.store.publish([fact] if fact is not None else (), deleted_keys=deleted)
+
+    def failure(self):
+        # Watch/publication failure (not one selector failure) invalidates all.
+        snapshot = self.store.snapshot(self.source.scope)
+        with self._lock:
+            keys = tuple(self._selectors)
+            for key in keys:
+                self._dirty.setdefault(key, None)
+        stale = [replace(fact, health='stale', error_code='sessions_source_failed')
+                 for key in keys if (fact := snapshot.get(key)) is not None]
+        self.store.publish(stale)
+
+    def close(self):
+        with self._lock:
+            self._closed = True
+        if self._watch is not None:
+            self._watch.close()
diff --git a/hermes_cli/sessions_native_startup.py b/hermes_cli/sessions_native_startup.py
new file mode 100644
index 00000000000..60859832a06
--- /dev/null
+++ b/hermes_cli/sessions_native_startup.py
@@ -0,0 +1,148 @@
+"""App-owned sessions display startup; HERMES_FACTS_SESSIONS=0 rolls back. [daveey]
+
+No configuration, discovery, capture or SQLite on the warm HTTP path. This is
+in-process rendered-field composition, not dedicated fact_host activation.
+"""
+import asyncio
+from contextlib import asynccontextmanager
+import inspect
+import os
+import sys
+from types import SimpleNamespace
+
+from fastapi import HTTPException
+
+from hermes_cli.fact_capture import CaptureBudget
+from hermes_cli.fact_contract import Scope, SourceId
+from hermes_cli.fact_feed import ChangeFeed
+from hermes_cli.fact_inprocess import IncrementalLifecycle, InProcessFacts
+from hermes_cli.fact_store import FactStore
+from hermes_cli.sessions_fact_routes import use
+from hermes_cli.sessions_native_source import SessionsSource
+
+
+class SessionsRuntime:
+    def __init__(self, profiles, targets):
+        self.profiles = profiles
+        self.targets = tuple(targets)
+        self.names = frozenset(name for name, _ in targets)
+        self.scope = Scope(str(targets[0][1]), 'sessions-display')
+        self.store = FactStore()
+        self.lifecycle = IncrementalLifecycle({(self.scope, 'sessions')})
+        self.feed = self.local = self.handle = self.binding = None
+        paths = [home / filename for _, home in targets for filename in ('state.db', 'config.yaml')]
+        self.source = SessionsSource(self.store, SourceId(self.scope, 'sessions.display', 'canonical'),
+                                     paths, self.capture, reconcile=self.reconcile)
+        self.generation = 0
+
+    def reconcile(self):
+        # Profiles introduced after boot use 30s reconciliation until next boot
+        # installs their native watches; do not claim native freshness for them.
+        targets = self.profiles._profile_targets('sessions facts reconciliation')
+        self.names = frozenset(name for name, _ in targets)
+
+    def capture(self, name, selector):
+        from hermes_cli.web_json_response import native_json_response
+        readers = {'sessions': self.profiles.get_profiles_sessions,
+                   'sessions_sidebar': self.profiles.get_profiles_sessions_sidebar,
+                   'sessions_stamps': self.profiles.get_profiles_session_stamps}
+        # Bypass the legacy request coalescer/TTL, but retain canonical SQL,
+        # ordering, projection and seven-family annotation implementations.
+        reader = readers[name]
+        if name == 'sessions_sidebar':
+            reader = reader.__wrapped__  # Skip TTL only; keep load accounting.
+        result = reader(**selector)
+        groups = [result.get('sessions', ())]
+        groups.extend(result.get(key, {}).get('sessions', ()) for key in ('recents', 'cron', 'messaging'))
+        for rows in groups:
+            for row in rows:
+                if row.get('is_active'):
+                    self.source.refresh_at(row.get('last_active', row.get('started_at', 0)) + 300)
+        return native_json_response(result).body
+
+    def demand(self, scope, name, selector):
+        if scope != self.scope or name not in ('sessions', 'sessions_sidebar', 'sessions_stamps'):
+            raise ValueError('unauthorized sessions demand')
+        profile = selector.get('recents_profile', selector.get('profile', 'all')) or 'all'
+        if profile != 'all' and profile not in self.names:
+            raise HTTPException(404, 'Profile not found')
+        self.source.demand(name, selector)
+
+    def start(self):
+        self.feed = ChangeFeed(lambda source, capture: source.commit(capture),
+                               lambda source, error: source.failure(),
+                               budget=CaptureBudget(max_bytes=4 * 1024 * 1024, max_seconds=5))
+        try:
+            self.feed.register(self.source)
+            self.local = InProcessFacts(self.store, [self.scope], demand=self.demand)
+            self.handle = self.local.acquire(self.scope, lifecycle=self.lifecycle)
+            binding_handle = SimpleNamespace(v1=self.handle.v1, demand=self.handle.demand,
+                                             touch=self.source.touch)
+            self.binding = self.profiles.bind_sessions_facts(binding_handle, self.scope)
+            from hermes_cli.sessions_fact_routes import selector_for
+            from hermes_cli.fact_contract import Ready
+            selector = selector_for(inspect.signature(self.profiles.get_profiles_sessions), (), {})
+            self.demand(self.scope, 'sessions', selector)
+            with self.store._condition:
+                if not self.store._condition.wait_for(
+                        lambda: isinstance(self.store.snapshot(self.scope).view('sessions', selector), Ready), timeout=15):
+                    raise TimeoutError('sessions bootstrap unavailable; activation refused')
+            self.lifecycle.report_ready('sessions', self.scope)
+            self.generation += 1
+            self.lifecycle.transition('sessions', self.scope, 'facts', self.generation)
+        except BaseException:
+            self.close()
+            raise
+        return self
+
+    def close(self):
+        if self.binding is not None:
+            self.generation += 1
+            self.lifecycle.transition('sessions', self.scope, 'legacy', self.generation)
+        if self.feed is not None:
+            self.feed.close()  # failed drain retains app custody; never start a replacement
+        if self.binding is not None:
+            self.binding.close()
+            self.binding = None
+        if self.handle is not None:
+            self.handle.close()
+            self.handle = None
+        if self.local is not None:
+            self.local.close()
+            self.local = None
+
+
+class SessionsMiddleware:
+    """Use only app-startup authority, never infer a binding from a query value."""
+    def __init__(self, app):
+        self.app = app
+
+    async def __call__(self, scope, receive, send):
+        if scope['type'] != 'http':
+            return await self.app(scope, receive, send)
+        runtime = getattr(scope['app'].state, 'sessions_facts', None)
+        with use(runtime.binding if runtime is not None else None):
+            await self.app(scope, receive, send)
+
+
+@asynccontextmanager
+async def lifespan(app):
+    from hermes_cli.web_routers import profiles
+    retained = getattr(app.state, 'sessions_facts', None)
+    if retained is not None:
+        raise RuntimeError('sessions startup custody retained')
+    # health: allow HX002 -- creator-defined startup rollback switch, never a credential
+    enabled = os.environ.get('HERMES_FACTS_SESSIONS', '1').strip().lower() not in ('0', 'off', 'false', 'no')
+    # NativeSourceWatch currently supports Linux only; keep other hosts legacy.
+    if not enabled or not sys.platform.startswith('linux'):
+        yield
+        return
+    targets = await asyncio.to_thread(profiles._profile_targets, 'sessions facts startup')
+    runtime = SessionsRuntime(profiles, targets)
+    app.state.sessions_facts = runtime  # custody survives a failed startup/unwind
+    try:
+        await asyncio.to_thread(runtime.start)
+        yield
+    finally:
+        await asyncio.to_thread(runtime.close)
+        app.state.sessions_facts = None
