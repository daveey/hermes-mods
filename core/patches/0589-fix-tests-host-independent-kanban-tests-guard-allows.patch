Three tests failed on clean main on hermes-hub but pass in CI:

- test_kanban_tools TUI-subscription tests (2): SessionDB.append_message lazily imports
  agent.conversation_loop -> hermes_bootstrap, whose sealed-payload probe reads
  <checkout>/../manifest.json. With the checkout inside the real Hermes home (default install
  ~/.hermes/hermes-agent, or a worktree under ~/.hermes/cache/scratch) the real-home guard refused
  that read. The guard already exempts the checkout itself; it now also allows READS of that one
  sibling manifest (writes still refused). Test in test_real_home_tripwire.

- test_replay_t5bc8e125 (capability routing): since 8d1ca16533 hub_cli_path() resolves hermes-hub
  through PATH, so on a host with the client installed argv[0] is /home/.../.local/bin/hermes-hub
  and the literal ["hermes-hub", ...] assert failed. The fixture now drops PATH entries that hold a
  real hermes-hub (the resolver keeps its own test in test_kanban_placement).
---
diff --git a/tests/hermes_cli/test_kanban_capability_routing.py b/tests/hermes_cli/test_kanban_capability_routing.py
index 8334cecebeaae77a36224f0a25461e3419628a83..475c3d4a213f78c31eca4a2180de0eac64a04068 100644
--- a/tests/hermes_cli/test_kanban_capability_routing.py
+++ b/tests/hermes_cli/test_kanban_capability_routing.py
@@ -8,6 +8,7 @@ for an hour with no producer until David asked.
 from __future__ import annotations
 
 import json
+import os
 import sqlite3
 import time
 from pathlib import Path
@@ -45,6 +46,11 @@ def env(tmp_path: Path, monkeypatch: pytest.MonkeyPatch):
     home.mkdir()
     monkeypatch.setenv("HERMES_HOME", str(home))
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    # hub_cli_path() resolves `hermes-hub` through PATH first. On a host with the client installed
+    # (hermes-hub, the MacBook: ~/.local/bin/hermes-hub) argv[0] became that absolute path, so these
+    # asserts depended on the host. Drop PATH entries that carry a real hermes-hub.
+    monkeypatch.setenv("PATH", os.pathsep.join(
+        d for d in os.environ.get("PATH", "").split(os.pathsep) if d and not (Path(d) / "hermes-hub").exists()))
     mail = tmp_path / "mail.json"
     mail.write_text(json.dumps({"gateway": "hub"}))
     monkeypatch.setenv("HERMES_MAIL_CONFIG", str(mail))
diff --git a/tests/home_io_guard.py b/tests/home_io_guard.py
index 6f0b7384ac0f39adfbebe4f41b5b32ef581da9e9..bba3b7ad76957c9f015e721e22bccb4bb2000476 100644
--- a/tests/home_io_guard.py
+++ b/tests/home_io_guard.py
@@ -48,6 +48,12 @@ _INTERPRETER_PREFIXES = tuple({
 # resolve once at import, as before: they are fixed for the process lifetime.
 _normcase = os.path.normcase
 _INTERPRETER_PREFIX_STRS = tuple(_normcase(os.fspath(p)) for p in _INTERPRETER_PREFIXES)
+# The sealed-payload probe (pm.environments._payload_manifest) reads ``<checkout>/../manifest.json``
+# whenever hermes_bootstrap is first imported, which many modules do lazily mid-test (e.g.
+# hermes_state -> agent.context_compressor -> agent.conversation_loop). With the checkout inside a
+# guarded root (default install ``~/.hermes/hermes-agent``, or a worktree under ~/.hermes/cache) that
+# read is the checkout asking "am I a payload?", not Hermes state. Reads only; writes stay refused.
+_PAYLOAD_MANIFEST_STR = _normcase(os.fspath(Path(__file__).resolve().parent.parent.parent / "manifest.json"))
 
 
 def _within(path: str, prefix: str) -> bool:
@@ -98,6 +104,8 @@ class HomeIOGuard:
             # which is not I/O against the home.
             if metadata and (absolute == "/proc" or absolute.startswith("/proc" + os.sep)):
                 return
+            if absolute == _PAYLOAD_MANIFEST_STR and not destructive:
+                return
             resolved = self._refuse_installed_app_change(value, absolute) if destructive else None
             roots = tuple(_normcase(os.fspath(r)) for r in self.roots())
             # Resolving the root itself (get_default_hermes_root's relative_to
