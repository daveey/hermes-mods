From 1e85dd4a22e1ec17d49388c826f1c6ca6517cd28 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 02:04:51 +0000
Subject: [PATCH] fix: safe workers skip import-time home init; termux lane
 checks out inputs.commit [daveey]

The fork's lazy env registry runs ensure_hermes_home() at config import, which
read SOUL.md inside a safe worker. Upstream's eager path returned the bound
worker snapshot before touching the home, so skip it when a snapshot is bound
(tests/agent/test_safe_worker_policy.py red->green).

The fork-only termux-assembly-permissions job now follows inputs.commit like
every other checkout (tests/ci/test_stable_release_commit_threading.py).
---
 .github/workflows/tests.yml |  2 ++
 hermes_cli/config.py        | 11 ++++++++++-
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index 5f0bab6e849..2c0cb6ebb9c 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -189,6 +189,8 @@ jobs:
     steps:
       - name: Checkout code
         uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          ref: ${{ inputs.commit }}
 
       - name: Pull the native Linux test image
         uses: ./.github/actions/retry
diff --git a/hermes_cli/config.py b/hermes_cli/config.py
index 085d146e51f..cd79cc47070 100644
--- a/hermes_cli/config.py
+++ b/hermes_cli/config.py
@@ -3952,4 +3952,13 @@ def __getattr__(name: str):  # CORE_DECLARED_ENV_NAMES, BUNDLED_PLATFORM_SECRET_
     raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
 
 
-_env_registry.install(_env_registry_stages, ensure_home=ensure_hermes_home)
+def _ensure_home_at_import() -> None:
+    """The import-time home init the eager discovery's ``load_config()`` used to do. A bound
+    worker config snapshot short-circuits ``load_config()`` before it touches the home, so a safe
+    worker never seeded or read SOUL.md at import; keep it that way. [daveey]"""
+    if _worker_config_snapshot() is not None:
+        return
+    ensure_hermes_home()
+
+
+_env_registry.install(_env_registry_stages, ensure_home=_ensure_home_at_import)
-- 
