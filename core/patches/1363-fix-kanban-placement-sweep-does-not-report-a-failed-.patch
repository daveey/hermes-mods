From 32b542601a3111dc53c191669a61980a21473158 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 00:28:27 +0000
Subject: [PATCH] fix(kanban): placement sweep does not report a failed late
 archive send as sent [daveey]

---
 hermes_cli/kanban_placement_forward.py        |  5 ++++-
 .../test_kanban_placement_cancel.py           | 21 +++++++++++++++++++
 2 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_placement_forward.py b/hermes_cli/kanban_placement_forward.py
index ba05fe5d6f4..8dd69b940bb 100644
--- a/hermes_cli/kanban_placement_forward.py
+++ b/hermes_cli/kanban_placement_forward.py
@@ -356,9 +356,12 @@ def sweep_unresolved_archives(conn: sqlite3.Connection, *, now: Optional[float]
             elif expired:  # one last try failed too
                 _give_up(conn, task_id, payload, gw, f"sending the archive to {gw} kept failing ({n + 1} times)")
             continue
-        if forward_archive(conn, task_id, runner=runner, await_budget=0, record_unresolved=False) is not None:
+        view = forward_archive(conn, task_id, runner=runner, await_budget=0, record_unresolved=False)
+        if _sent(view):
             sent.append(task_id)
             continue
+        if view is not None:
+            continue  # the id arrived but the send failed: recorded ``failed``, the backoff path retries it
         if expired:
             _give_up(conn, task_id, payload, gw,
                      f"{gw} never made the card for request {payload.get('request_id') or '?'}")
diff --git a/tests/hermes_cli/test_kanban_placement_cancel.py b/tests/hermes_cli/test_kanban_placement_cancel.py
index b236a3724ae..44ebb8858cb 100644
--- a/tests/hermes_cli/test_kanban_placement_cancel.py
+++ b/tests/hermes_cli/test_kanban_placement_cancel.py
@@ -338,3 +338,24 @@ def test_crash_gap_gives_up_after_seven_days_when_every_try_fails(mac, monkeypat
         assert _statuses(conn, child) == ["failed", "failed", "expired"]
         assert kpf.sweep_unresolved_archives(conn, now=far + 30 * 86400) == []
         assert len(_statuses(conn, child)) == 3
+
+
+def test_unresolved_archive_whose_late_send_fails_is_not_reported_sent(mac, monkeypatch):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    from hermes_cli import kanban_placement_forward as kpf
+    with kbc.connect_closing() as conn:
+        child, rid = _unresolved_forwarded_card(mac, monkeypatch, conn)
+        assert kb.archive_task(conn, child)
+        assert _statuses(conn, child) == ["unresolved"]
+        mac["hub"].execute("UPDATE sent SET state='done', result=? WHERE id=?",
+                           (json.dumps({"ok": True, "task_id": "t_hub0001", "status": "ready"}), rid))
+        mac["hub"].commit()
+        mac["result"]["rc"] = 1
+        t0 = time.time()
+        assert kpf.sweep_unresolved_archives(conn, now=t0) == []  # failed: not reported sent
+        assert _statuses(conn, child) == ["unresolved", "failed"]
+        mac["result"]["rc"] = 0
+        assert kpf.sweep_unresolved_archives(conn, now=t0 + kpf.FAILED_RETRY_BASE + 1) == [child]
+        assert _statuses(conn, child) == ["unresolved", "failed", "pending"]
+    assert len(_archive_requests(mac)) == 2
-- 
