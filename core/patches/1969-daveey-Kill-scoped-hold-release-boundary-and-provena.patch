Subject: [PATCH] [daveey] Kill scoped hold release boundary and provenance
 mutants

---
 ...kanban_hold_release_mutation_boundaries.py | 115 ++++++++++++++++++
 1 file changed, 115 insertions(+)
 create mode 100644 tests/tools/test_kanban_hold_release_mutation_boundaries.py

diff --git a/tests/tools/test_kanban_hold_release_mutation_boundaries.py b/tests/tools/test_kanban_hold_release_mutation_boundaries.py
new file mode 100644
index 00000000000..c4a823139e5
--- /dev/null
+++ b/tests/tools/test_kanban_hold_release_mutation_boundaries.py
@@ -0,0 +1,115 @@
+"""Independent guard-boundary witnesses, including redundant validation layers."""
+import json
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_hold_release as release
+from tests.tools import test_kanban_owner_wake_hold_release as cases
+from tests.tools import test_kanban_owner_wake_requeue as wake
+
+board = wake.board
+
+
+def test_invalid_park_timestamp(board, monkeypatch):
+    with kbc.connect() as conn:
+        task, _, _ = cases.held(conn, monkeypatch)
+        conn.execute("UPDATE task_events SET created_at='invalid' WHERE task_id=? AND kind='dependency_wait'", (task,))
+        with pytest.raises(ValueError, match="portable completed"):
+            release._park(conn, task)
+
+
+@pytest.mark.parametrize("field,value", [("parents", "string"), ("parents", [None]),
+                                        ("prs", "string"), ("prs", {cases.reviews.PR: True})])
+def test_scope_reason(board, monkeypatch, field, value):
+    with kbc.connect() as conn:
+        task, _, _ = cases.held(conn, monkeypatch)
+        row, evidence, parked = release._park(conn, task)
+        evidence[field] = value
+        monkeypatch.setattr(release, "_park", lambda *_: (row, evidence, parked))
+        # Make other predicates permissive to witness this boundary independently.
+        if field == "parents":
+            monkeypatch.setattr(kb, "parent_ids", lambda *_: set(value))
+        with pytest.raises(ValueError, match="retained satisfied" if field == "parents" else "captured PR"):
+            release._scope(conn, task)
+
+
+def test_unnamed_review_is_not_a_proof(board, monkeypatch):
+    with kbc.connect() as conn:
+        task, _, _ = cases.held(conn, monkeypatch)
+        row, captured, proofs = release._scope(conn, task)
+        result = {"metadata": json.dumps({"reviewed_sha": "a" * 40}), "id": 456}
+        real = release.review._completed_review_run
+        monkeypatch.setattr(release.review, "_completed_review_run", lambda c, p, *args: result if p == "unnamed" else real(c, p, *args))
+        parents = kb.parent_ids(conn, task)
+        monkeypatch.setattr(kb, "parent_ids", lambda *_: [*parents, "unnamed"])
+        assert release._scope(conn, task) == (row, captured, proofs)
+
+
+@pytest.mark.parametrize("kind", ["foreign", "dispatcher", "changed", "empty"])
+def test_publication_boundaries(board, monkeypatch, kind):
+    from hermes_cli import kanban_db_dispatch_pr_state as prs
+    with kbc.connect() as conn:
+        task, _, _ = cases.held(conn, monkeypatch)
+        conn.execute("DELETE FROM task_comments WHERE task_id=?", (task,))
+        body = "plain text" if kind == "empty" else cases.reviews.PR + "9"
+        author = "kanban-dispatcher" if kind == "dispatcher" else "dev"
+        from tests.hermes_cli.kanban_guard_helpers import worker_comment
+        comment = worker_comment(conn, task, author, body)
+        if kind == "foreign":
+            monkeypatch.setattr(prs, "_foreign_pr_comment_ids", lambda *_: {comment})
+        if kind == "changed":
+            with pytest.raises(ValueError, match="scope changed"):
+                release._check_publications(conn, task, {cases.reviews.PR.lower()})
+        else:
+            release._check_publications(conn, task, {cases.reviews.PR.lower()})
+
+
+@pytest.mark.parametrize("kind", ["missing", "precondition", "foreign"])
+def test_transaction_boundary(board, monkeypatch, kind):
+    from hermes_cli import kanban_db_dispatch as dispatch
+    from hermes_cli import kanban_wake_check
+    with kbc.connect() as conn:
+        task, _, sup = cases.held(conn, monkeypatch)
+        monkeypatch.setattr(dispatch, "check_respawn_guard", lambda *_: "active_pr")
+        if kind == "missing":
+            task = "absent"
+        if kind == "foreign":
+            monkeypatch.setattr(kanban_wake_check, "foreign_copy", lambda *_: True)
+        message = {"missing": "unclaimed READY", "foreign": "local home", "precondition": "revoked sentinel"}[kind]
+        with pytest.raises(ValueError, match=message):
+            release.release(conn, task, supervisor=sup, supervisor_board="default",
+                            precondition=lambda _: "revoked sentinel" if kind == "precondition" else None)
+
+
+@pytest.mark.parametrize("kind", ["no_run", "foreign_legacy", "dict_scope", "nonstring_scope"])
+def test_receipt_boundary(board, monkeypatch, kind):
+    from hermes_cli import kanban_wake_check
+    with kbc.connect() as conn:
+        task, _, _ = cases.held(conn, monkeypatch)
+        now = int(time.time()) + 2
+        monkeypatch.setattr(time, "time", lambda: now)
+        assert wake._unblock(task).get("ok")
+        event = conn.execute("SELECT id,payload FROM task_events WHERE task_id=? AND kind='hold_released'", (task,)).fetchone()
+        data = json.loads(event["payload"])
+        if kind == "no_run":
+            task = kb.create_task(conn, title="No run", assignee="dev")
+            kb._append_event(conn, task, "hold_released", data)
+        elif kind == "foreign_legacy":
+            run = conn.execute("SELECT id FROM task_runs WHERE task_id=? ORDER BY id DESC LIMIT 1", (task,)).fetchone()
+            data["park"] = {"run_id": run[0]}
+            monkeypatch.setattr(kanban_wake_check, "foreign_copy", lambda *_: True)
+        elif kind == "dict_scope":
+            data["prs"] = {cases.reviews.PR.lower(): True}
+        else:
+            data["prs"] = [cases.reviews.PR.lower(), None]
+        conn.execute("UPDATE task_events SET payload=? WHERE id=?", (json.dumps(data), event["id"]))
+        assert not release.released_after(conn, task, now - 1, [cases.reviews.PR])
+
+
+def test_identity_prefers_portable_uid():
+    assert release._identity({"id": 1, "uid": "portable"}) == {"run_uid": "portable"}
+    assert release._identity({"id": 1, "uid": ""}) == {"run_id": 1}
+    assert release._identity({"id": 1}) == {"run_id": 1}
