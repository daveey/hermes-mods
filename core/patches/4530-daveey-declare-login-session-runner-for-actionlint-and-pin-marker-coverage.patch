Date: Sun, 15 Nov 2026 15:15:06 +0000
Subject: [PATCH] [daveey] declare login-session runner for actionlint and pin
 marker coverage

Proof: label regression fails before declaration; focused three CI suites pass. Six mutants killed: each of three omitted function markers, GUI preflight fail-open, room exclusion removal, session selector broadening. Native probe 43720637010: three room runners each3278 pass/0 fail; session runner5 pass/0 fail. No runner labels changed.
---
 .github/actionlint.yaml                  |  3 ++-
 tests/ci/test_macos_os_tests_workflow.py | 27 ++++++++++++++++++++++++
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/.github/actionlint.yaml b/.github/actionlint.yaml
index 20c5ec83e15dfee7ba301f3303b0d4cf369ce11e..dedef18f61360e5e5adcab990ec6cf9366c2a1f9 100644
--- a/.github/actionlint.yaml
+++ b/.github/actionlint.yaml
@@ -32,8 +32,9 @@ self-hosted-runner:
     - ci-bwrap
     # Autoscaled one-VM-per-job group for the Python test slices (tests.yml test).
     - tfgar-tests
-    # Dedicated single-job macOS state-suite runner on the mini.
+    # Dedicated macOS pool and isolated console-user login-session lane.
     - hermes-state
+    - hermes-mac-session
     - tfgar-probe
 
 # fork (daveey/hermes): known findings that are not bugs. The lint runs in
diff --git a/tests/ci/test_macos_os_tests_workflow.py b/tests/ci/test_macos_os_tests_workflow.py
index 3d9a0550f03bd03e7e74fdbfc571bd12012122d5..91874e272ec39e4ba772180c821f2a66457ca0c8 100644
--- a/tests/ci/test_macos_os_tests_workflow.py
+++ b/tests/ci/test_macos_os_tests_workflow.py
@@ -87,6 +87,33 @@ def test_login_session_job_is_gated_and_requires_a_real_gui_domain(domain_status
     assert any(step.get("uses") == "./.github/actions/setup-pm" for step in job["steps"])
 
 
+def test_session_runner_label_is_declared_for_actionlint():
+    config = hermes_yaml.safe_load((ROOT / ".github/actionlint.yaml").read_text(encoding="utf-8"))
+    assert "hermes-mac-session" in config["self-hosted-runner"]["labels"]
+
+
+def test_login_session_marker_covers_exactly_the_three_login_dependent_functions():
+    import ast
+
+    expected = {
+        ("test_gateway_launchd_runtime.py",
+         "test_gateway_job_is_a_launchd_osascript_child_that_reads_as_unsupervised"),
+        ("test_gateway_snapshot_restore_live.py", "test_snapshot_restore_rejoins_the_restored_authority"),
+        ("test_update_posix_pause.py", "test_a_launchd_job_is_paused_through_launchd_and_restarted_through_it"),
+    }
+    marked = set()
+    for path in (ROOT / "tests/hermes_cli").glob("test_*.py"):
+        tree = ast.parse(path.read_text(encoding="utf-8"))
+        for node in ast.walk(tree):
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and any(
+                ast.unparse(decorator) == "pytest.mark.macos_login_session"
+                for decorator in node.decorator_list
+            ):
+                marked.add((path.name, node.name))
+    assert marked == expected
+    assert "macos_login_session:" in (ROOT / "tests/conftest.py").read_text(encoding="utf-8")
+
+
 def test_native_lane_provisions_real_tools_and_messaging_before_tests():
     import json
 
