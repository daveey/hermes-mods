From aecbdb62d41e5c3ef7f67c6ada91039736a36c69 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 24 Nov 2026 23:57:37 +0000
Subject: [PATCH 6281] Semantic annotation parts and fail-fresh caching

Public mirror of source commit aecbdb62d41e5c3ef7f67c6ada91039736a36c69.

---
diff --git a/hermes_cli/kanban_annotation_host.py b/hermes_cli/kanban_annotation_host.py
index a9325b39030..be9b36445b9 100644
--- a/hermes_cli/kanban_annotation_host.py
+++ b/hermes_cli/kanban_annotation_host.py
@@ -719,7 +719,10 @@
             _ksa._revalidate.force_read.parts = forced
             try:
                 try:
-                    _ksa._refresh_annotation_locked(scope)
+                    # No part needs a read: avoid prepare/freeze/publication and ordinary inner TTLs.
+                    # Keep the deadline/settle path below: this hint can precede COMMIT visibility.
+                    if forced:
+                        _ksa._refresh_annotation_locked(scope)
                 except BaseException:
                     _parts.failed(scope)
                     raise
diff --git a/tests/hermes_cli/test_kanban_annotation_parts.py b/tests/hermes_cli/test_kanban_annotation_parts.py
index 1e14659f83d..d06c5ac9e71 100644
--- a/tests/hermes_cli/test_kanban_annotation_parts.py
+++ b/tests/hermes_cli/test_kanban_annotation_parts.py
@@ -136,6 +136,55 @@
     assert _published()[0] == {}
 
 
+def test_unchanged_source_wakes_skip_the_outer_read_but_keep_confirmations(world, monkeypatch):
+    """A hint before COMMIT must still get a trailing semantic-key probe."""
+    calls = []
+    original = ksa._refresh_annotation_locked
+
+    def read(*args, **kwargs):
+        calls.append(args)
+        return original(*args, **kwargs)
+
+    monkeypatch.setattr(ksa, '_refresh_annotation_locked', read)
+    monkeypatch.setattr(host, 'SETTLE_S', (0.25, 2.0))
+    _refresh()
+    assert len(calls) == 1
+    first = _published()
+    for _ in range(5):
+        _refresh()
+    assert len(calls) == 1, 'unchanged source hints entered the expensive outer projection'
+    assert _published() is first
+    assert len(host._settle_deadlines[SCOPE]) == 2
+
+    # Model the WAL append being observed before COMMIT: no further source hint.
+    world.conn.execute("UPDATE tasks SET status='done' WHERE id='t1'")
+    host._clock_deadlines[SCOPE] = [0.0]
+    host._settle_deadlines[SCOPE] = (0.0,)
+    _refresh(source=False)
+    assert len(calls) == 2
+    assert _published()[0] == {}
+
+
+def test_unchanged_keys_do_not_skip_a_provider_clock_or_count_renewal(world, monkeypatch):
+    calls = []
+    original = ksa._refresh_annotation_locked
+
+    def read(*args, **kwargs):
+        calls.append(args)
+        return original(*args, **kwargs)
+
+    monkeypatch.setattr(ksa, '_refresh_annotation_locked', read)
+    _refresh()
+    _refresh()
+    assert len(calls) == 1
+    host._clock_deadlines[SCOPE] = [0.0]
+    _refresh(source=False)
+    assert len(calls) == 2, 'provider clock was mistaken for an unchanged source hint'
+    monkeypatch.setattr(host, 'STRICT_REFRESH_AGE_S', 0.0)
+    _refresh()
+    assert len(calls) == 3, 'unchanged inputs suppressed a real counts renewal'
+
+
 def _undated(value):
     """``value`` without the wall times a read stamps on its execution evidence (they date the read itself)."""
     if isinstance(value, dict):
