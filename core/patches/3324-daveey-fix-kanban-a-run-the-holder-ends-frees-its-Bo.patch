diff --git a/hermes_cli/kanban_run_end_lease.py b/hermes_cli/kanban_run_end_lease.py
new file mode 100644
index 0000000000..9aada21275
--- /dev/null
+++ b/hermes_cli/kanban_run_end_lease.py
@@ -0,0 +1,84 @@
+"""Free the Board lease when the holder's own transition ends its run. [daveey]
+
+On a primary board the Board frees a run's lease when the pushed card row leaves ``running`` (rows.ts:
+the holder moving its card out of ``running`` ends the lease). With this host's push loop down, that
+row never leaves the outbox, the lease outlives the run, and at expiry the Board's stale-lease reaper
+books it as a crash (``reclaimed`` + ``failure_finalized``, ``stale_lease=<holder>``): a card that
+parked normally trips its retry breaker (t_01a1d05e8be13a6a, laptop-1 2026-11-13, sync down on
+SchemaAhead). Claims and renewals still reached the Board as direct calls; only the release was lost.
+
+So every run-ending transition the holder makes (schedule, block, complete, review handoff, request
+changes, continue, archive, descendant reopen) queues :func:`note` inside its write txn, and
+``write_txn`` calls :func:`flush` after COMMIT: a direct ``release`` call, best-effort, the way
+operator reclaim already does. A failed release keeps today's fallback (the lease expires on the
+server) and never fails the transition. Crash, timeout and reclaim accounting paths do not queue: they
+release with their own outcome, and a neutral release sent first would hide the charge.
+
+Only while the outbox is stalled (:func:`outbox_stalled`). Board ``releaseTask`` returns a card it still
+sees ``running`` to ``ready`` (and drops a placement card's ``runs_on``). On a healthy host the direct
+release would usually beat the row push, so a parked or done card would read ``ready`` on the Board
+until the push lands, open to a claim from another machine. There the row push ends the lease itself,
+so nothing is sent.
+"""
+from __future__ import annotations
+
+import logging
+import sqlite3
+import time
+from typing import Optional
+
+_log = logging.getLogger("hermes_cli.kanban_db_sync")
+
+# A due pending outbox row older than this means the push loop is not draining (a healthy loop pushes
+# within seconds; a held row with a future ``retry_after`` does not count).
+OUTBOX_STALL_SECONDS = 120
+
+# id(conn) -> [(task_id, run_uid)] queued inside the open write txn of that connection.
+_PENDING: dict[int, list[tuple[str, str]]] = {}
+
+
+def outbox_stalled(conn: sqlite3.Connection, now: Optional[float] = None) -> bool:
+    """True when a due ``pending`` outbox row is older than :data:`OUTBOX_STALL_SECONDS`."""
+    now = time.time() if now is None else now
+    row = conn.execute(
+        "SELECT MIN(created_at) FROM kanban_sync_outbox WHERE state = 'pending' "
+        "AND (retry_after IS NULL OR retry_after <= ?)", (int(now),)).fetchone()
+    return bool(row) and row[0] is not None and int(row[0]) <= int((now - OUTBOX_STALL_SECONDS) * 1000)
+
+
+def note(conn: sqlite3.Connection, task_id: str, run_id: Optional[int]) -> None:
+    """Queue the lease release for ``run_id``, which the holder's transition just ended in this txn."""
+    from hermes_cli import kanban_db_sync as sync
+    if run_id is None or sync.board_mode(conn) != "primary":
+        return
+    uid = sync.run_uid(conn, run_id)
+    if uid is None:
+        return
+    if getattr(conn, "in_transaction", False):
+        _PENDING.setdefault(id(conn), []).append((task_id, uid))
+    else:
+        _release(conn, task_id, uid)
+
+
+def flush(conn: sqlite3.Connection, *, committed: bool) -> None:
+    """``write_txn`` after COMMIT (``committed``) or rollback (drops the queue)."""
+    pending = _PENDING.pop(id(conn), None) if _PENDING else None
+    if not committed or not pending:
+        return
+    for task_id, uid in pending:
+        _release(conn, task_id, uid)
+
+
+def _release(conn: sqlite3.Connection, task_id: str, uid: str) -> None:
+    from hermes_cli import kanban_db_sync as sync
+    try:
+        row = conn.execute("SELECT ended_at FROM task_runs WHERE uid = ?", (uid,)).fetchone()
+        if row is None or row[0] is None:
+            return  # the end did not commit (a rolled-back savepoint): the run still holds its lease
+        if not outbox_stalled(conn):
+            return  # the row push ends the lease on the Board, with no window where the card reads ready
+        _log.info("kanban sync: outbox stalled; releasing the Board lease of %s run %s at its end", task_id, uid)
+        sync.release_lease(conn, task_id, uid)
+    except Exception as exc:  # health: allow BLE001 -- best-effort: the lease expires on the server instead
+        _log.warning("kanban sync: lease release for %s run %s failed (%s: %s); it expires on the server",
+                     task_id, uid, type(exc).__name__, exc)
diff --git a/tests/hermes_cli/test_kanban_run_end_lease.py b/tests/hermes_cli/test_kanban_run_end_lease.py
new file mode 100644
index 0000000000..38ddf0c9f0
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_run_end_lease.py
@@ -0,0 +1,129 @@
+"""A run the holder ends itself frees its Board lease while this host's push loop is down. [daveey]
+
+t_01a1d05e8be13a6a (laptop-1 2026-11-13): with sync down on SchemaAhead, two runs that parked
+normally kept their Board lease (only the pushed ``scheduled`` row frees it, and it never left the
+outbox); at expiry the Board reaped each as a crash (``stale_lease=macbook``) and the second tripped
+the retry breaker. The Board service is a stub (kanban_sync_support.FakeLeaseClient).
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_sync as sync
+from tests.hermes_cli import kanban_sync_support as support
+
+
+@pytest.fixture
+def kanban_home(tmp_path, monkeypatch):
+    return support.kanban_home(tmp_path, monkeypatch)
+
+
+@pytest.fixture
+def lease_client():
+    yield from support.lease_client()
+
+
+@pytest.fixture
+def synced_conn(kanban_home):
+    yield from support.synced_conn(kanban_home)
+
+
+@pytest.fixture
+def primary(synced_conn):
+    sync.set_mode(synced_conn, "primary")
+    return synced_conn
+
+
+def _claimed(conn, lease_client, title="parks"):
+    tid = kb.create_task(conn, title=title, assignee="worker")
+    assert kb.claim_task(conn, tid) is not None
+    run_uid = lease_client.calls[-1][1]["run_uid"]
+    assert lease_client.calls[-1][0] == "acquire"
+    return tid, run_uid
+
+
+def _stall_outbox(conn):
+    """The push loop is down: everything queued so far has sat in the outbox for ten minutes."""
+    conn.execute("UPDATE kanban_sync_outbox SET created_at = created_at - 600000")
+    conn.commit()
+
+
+def _releases(lease_client):
+    return [req for kind, req in lease_client.calls if kind == "release"]
+
+
+def test_schedule_releases_the_run_lease_while_the_outbox_is_stalled(primary, lease_client):
+    tid, run_uid = _claimed(primary, lease_client)
+    _stall_outbox(primary)
+    assert kb.schedule_task(primary, tid, reason="SCHEDULED_UNTIL=2099-01-01T00:00:00Z", clock_only=True)
+    [req] = _releases(lease_client)
+    assert req["task_uid"] == tid and req["run_uid"] == run_uid
+
+
+@pytest.mark.parametrize("end", ["block", "complete", "review", "continue"])
+def test_block_complete_review_and_continue_release_the_run_lease(primary, lease_client, end):
+    tid, run_uid = _claimed(primary, lease_client)
+    _stall_outbox(primary)
+    if end == "block":
+        assert kb.block_task(primary, tid, reason="needs an answer", kind="time", clock_only=True)
+    elif end == "complete":
+        assert kb.complete_task(primary, tid, summary="done")
+    elif end == "review":
+        assert kb.request_review(primary, tid, summary="please review")
+    else:
+        from hermes_cli import kanban_continuation
+        assert kanban_continuation.continue_task(primary, tid, checkpoint="halfway")["ok"]
+    assert [r["run_uid"] for r in _releases(lease_client)] == [run_uid]
+
+
+@pytest.mark.parametrize("error", [sync.LeaseUnavailable("connection refused"), RuntimeError("bad answer")])
+def test_a_failed_release_leaves_the_park_intact(primary, lease_client, monkeypatch, error):
+    tid, run_uid = _claimed(primary, lease_client)
+    _stall_outbox(primary)
+
+    def release(**kw):
+        lease_client.calls.append(("release", kw))
+        raise error
+
+    monkeypatch.setattr(lease_client, "release", release)
+    assert kb.schedule_task(primary, tid, reason="SCHEDULED_UNTIL=2099-01-01T00:00:00Z", clock_only=True)
+    assert [r["run_uid"] for r in _releases(lease_client)] == [run_uid]
+    task = kb.get_task(primary, tid)
+    assert task.status == "scheduled"
+    run = primary.execute("SELECT outcome, ended_at FROM task_runs WHERE uid = ?", (run_uid,)).fetchone()
+    assert run["outcome"] == "scheduled" and run["ended_at"] is not None
+
+
+def test_a_draining_outbox_leaves_the_release_to_the_row_push(primary, lease_client):
+    """Board releaseTask turns a card it still sees running back to ready: on a healthy host the pushed
+    row ends the lease itself, so a direct release would only open a window for another machine's claim."""
+    tid, _run_uid = _claimed(primary, lease_client)
+    assert kb.schedule_task(primary, tid, reason="SCHEDULED_UNTIL=2099-01-01T00:00:00Z", clock_only=True)
+    assert _releases(lease_client) == []
+
+
+def test_a_crash_end_does_not_send_a_neutral_release(primary, lease_client):
+    """Crash accounting releases with its own outcome; a neutral release sent first would hide the charge."""
+    tid, _run_uid = _claimed(primary, lease_client)
+    _stall_outbox(primary)
+    with kb.write_txn(primary):
+        kb._end_run(primary, tid, outcome="crashed")
+    assert _releases(lease_client) == []
+
+
+def test_a_rolled_back_end_keeps_the_lease(primary, lease_client):
+    tid, _run_uid = _claimed(primary, lease_client)
+    _stall_outbox(primary)
+    with pytest.raises(RuntimeError):
+        with kb.write_txn(primary):
+            run_id = kb._end_or_synthesize_run(primary, tid, outcome="scheduled", status="scheduled",
+                                               synthesize=False)
+            assert run_id is not None
+            raise RuntimeError("abort")
+    assert _releases(lease_client) == []
+    # The next txn on the same connection does not inherit the dropped queue.
+    with kb.write_txn(primary):
+        primary.execute("SELECT 1")
+    assert _releases(lease_client) == []
