Subject: [PATCH] test(kanban): lanes tool-create test owns its worker fixture
 [daveey]

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 tests/tools/test_kanban_lanes_tool_create.py | 34 +++++++++++++++++---
 1 file changed, 30 insertions(+), 4 deletions(-)

diff --git a/tests/tools/test_kanban_lanes_tool_create.py b/tests/tools/test_kanban_lanes_tool_create.py
index 35ad50dca7f3a60bdc979c1319a02fe0f5c3286c..ac012b2b992f2de13bde54defa4045344db8c891 100644
--- a/tests/tools/test_kanban_lanes_tool_create.py
+++ b/tests/tools/test_kanban_lanes_tool_create.py
@@ -2,7 +2,33 @@
 import json
 from pathlib import Path
 
-from tests.tools.test_kanban_tools import worker_env  # the fixture
+import pytest
+
+
+@pytest.fixture
+def worker_card(monkeypatch, tmp_path):
+    """A claimed worker card in an isolated HERMES_HOME, as the dispatcher pins it for the kanban tools."""
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_PROFILE", "test-worker")
+    monkeypatch.delenv("HERMES_SESSION_ID", raising=False)
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    conn = kbc.connect()
+    try:
+        tid = kb.create_task(conn, title="worker-test", assignee="test-worker")
+        kb.claim_task(conn, tid)
+        run_id = kb._current_run_id(conn, tid)
+    finally:
+        conn.close()
+    monkeypatch.setenv("HERMES_KANBAN_TASK", tid)
+    monkeypatch.setenv("HERMES_KANBAN_RUN_ID", str(run_id))
+    return tid
 
 
 def _configure():
@@ -13,14 +39,14 @@ def _configure():
     (Path(get_default_hermes_root()) / "config.yaml").write_text(json.dumps(doc))
 
 
-def test_tool_created_follow_up_in_gated_lane_is_held(worker_env):
+def test_tool_created_follow_up_in_gated_lane_is_held(worker_card):
     from hermes_cli import kanban_db_connect as kbc
     from hermes_cli import kanban_lanes as lanes
     from tools import kanban_tools as kt
 
     _configure()
     with kbc.connect() as conn:
-        conn.execute("UPDATE tasks SET tenant='hermes' WHERE id=?", (worker_env,))
+        conn.execute("UPDATE tasks SET tenant='hermes' WHERE id=?", (worker_card,))
         conn.commit()
     result = json.loads(kt._handle_create({"title": "Tidy the dispatcher", "assignee": "test-worker",
                                            "priority": 1000}))
@@ -31,7 +57,7 @@ def test_tool_created_follow_up_in_gated_lane_is_held(worker_env):
     assert tuple(row) == ("triage", "hermes", 100, lanes.GATE_KIND)
 
 
-def test_tool_created_card_without_lanes_is_unchanged(worker_env):
+def test_tool_created_card_without_lanes_is_unchanged(worker_card):
     from hermes_cli import kanban_db_connect as kbc
     from tools import kanban_tools as kt
 
