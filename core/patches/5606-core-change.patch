Subject: [PATCH] test(kanban): retain capture and hold progress under neutral
 routing [daveey]

---
 tests/hermes_cli/test_kanban_fairness_vertical.py | 15 +++++++++++++--
 tests/hermes_cli/test_kanban_hold_diagnostics.py  |  9 +++++----
 2 files changed, 18 insertions(+), 6 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_fairness_vertical.py b/tests/hermes_cli/test_kanban_fairness_vertical.py
index fb64f10b90..5ccb5d89b1 100644
--- a/tests/hermes_cli/test_kanban_fairness_vertical.py
+++ b/tests/hermes_cli/test_kanban_fairness_vertical.py
@@ -33,11 +33,22 @@ def kanban_home(tmp_path, monkeypatch):
     home.mkdir()
     monkeypatch.setenv("HERMES_HOME", str(home))
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
-    (home / "config.yaml").write_text("kanban:\n  dispatch_profiles: [worker-a]\n", encoding="utf-8")
+    _configure(home)
     kb.init_db()
     return home
 
 
+def _configure(home):
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    from hermes_cli.kanban_model_assignment import _assignee_config
+    (home / "config.yaml").write_text("kanban:\n  dispatch_profiles: [worker-a]\n", encoding="utf-8")
+    profile = home / "profiles" / "worker-a"
+    profile.mkdir(parents=True, exist_ok=True)
+    (profile / "config.yaml").write_text(_managed_yaml(), encoding="utf-8")
+    config = _assignee_config("worker-a")
+    assert config is not None and config["model_routing"]["enabled"] is True
+
+
 def _spawn(task, _workspace):
     if task.title == "launch fails":
         raise RuntimeError("no worker")
@@ -127,7 +138,7 @@ def test_capture_does_not_change_what_the_dispatcher_does(
         kanban_home, all_assignees_spawnable, tmp_path, monkeypatch):
     def run(home, armed):
         monkeypatch.setenv("HERMES_HOME", str(home))
-        (home / "config.yaml").write_text("kanban:\n  dispatch_profiles: [worker-a]\n", encoding="utf-8")
+        _configure(home)
         kb.init_db()
         with kbc.connect_closing() as conn:
             if armed:
diff --git a/tests/hermes_cli/test_kanban_hold_diagnostics.py b/tests/hermes_cli/test_kanban_hold_diagnostics.py
index 0a6ce9996a..c1bd58ea5f 100644
--- a/tests/hermes_cli/test_kanban_hold_diagnostics.py
+++ b/tests/hermes_cli/test_kanban_hold_diagnostics.py
@@ -17,11 +17,12 @@ def test_updater_hold_records_each_unclaimed_card_and_recovers(gws, monkeypatch,
 
     hub, worker = gws
     hub.enter()
-    ids = [kb.create_task(hub.conn, title=f'held {n}', assignee='default',
-                          runs_on=['machine:worker-1']) for n in range(3)]
+    from tests.hermes_cli.kanban_review_fixture import completed_gateway_source, create_review
     if lane == 'review':
-        for tid in ids:
-            assert kb.request_review(hub.conn, tid, summary='ready for review')
+        completed_gateway_source(hub)
+    create = create_review if lane == 'review' else kb.create_task
+    ids = [create(hub.conn, title=f'held {n}', assignee='default',
+                          runs_on=['machine:worker-1']) for n in range(3)]
     hub.round()
     worker.round()
     worker.enter()
