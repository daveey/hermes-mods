From faabd1c195fba9b92b88f29d907994ac18eae8d0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 20:12:05 +0000
Subject: [PATCH] fix(kanban): unattested ssh/hub-read keeps its home marker;
 claim revalidates access labels [daveey]

---
 hermes_cli/kanban_placement.py                |  2 +-
 hermes_cli/kanban_placement_coordination.py   | 28 +++++++++++--------
 .../test_kanban_coordination_placement.py     | 13 +++++++--
 3 files changed, 28 insertions(+), 15 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 097eda3226c..71b24ec8797 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -448,7 +448,7 @@ def portable_reason(args: dict, cfg: Optional[dict] = None) -> Optional[str]:
     full = without_carried_inputs(f"{title}\n{body}", c.raw)
     if refusal := coordination.check(full, c.raw, skills=args.get("skills")):
         return refusal
-    marker_full = coordination.access_text(coordination.marker_text(full))
+    marker_full = coordination.access_text(coordination.marker_text(full), c.raw)
     extra = c.raw.get("extra_home_markers")
     exemptible = (HUB_CLI_COMMAND, r"\btoken-broker\b", r"\bssh\b", r"\bon the hub\b", r"\bthe hub's\b",
                   r"\bjournalctl\b", r"\bkanban\.db\b")  # coordination.check() proved the worker attests each
diff --git a/hermes_cli/kanban_placement_coordination.py b/hermes_cli/kanban_placement_coordination.py
index bd6b2a37c02..3230fc5d7b5 100644
--- a/hermes_cli/kanban_placement_coordination.py
+++ b/hermes_cli/kanban_placement_coordination.py
@@ -90,12 +90,14 @@ def requirements(text):
     for tool, label in _TOOLS.items():
         if re.search(r"\b" + re.escape(tool) + r"\b", text, re.IGNORECASE):
             labels.add(label)
-    for rx, needed in _ACCESS:
-        if rx.search(text):
-            labels.update(needed)
     return labels, None
 
 
+def access_requirements(text):
+    """Labels the ssh / hub-read mentions in ``text`` would need; never a refusal (unmet = markers keep binding)."""
+    return {label for rx, needed in _ACCESS if rx.search(text) for label in needed}
+
+
 def destinations(cfg, target=None):
     """No pool inference for an explicit legacy heavy destination."""
     if target:
@@ -137,9 +139,12 @@ def attested(names, required):
     return True
 
 
-def check(text, cfg, *, target=None, skills=None):
+def check(text, cfg, *, target=None, skills=None, access=False):
+    """``access`` adds the ssh / hub-read labels (claim revalidation); placement leaves them to :func:`access_text`."""
     required, refusal = requirements(text)
     required.update(skill_requirements(skills))
+    if access:
+        required.update(access_requirements(text))
     if refusal or not required:
         return refusal
     return None if attested(destinations(cfg, target), required) else REASON
@@ -153,13 +158,14 @@ def marker_text(text):
     return re.sub(r"\btoken-broker\b", "", text, flags=re.IGNORECASE)
 
 
-def access_text(text):
-    """``text`` minus the remote-access mentions :func:`check` required an attestation for (ssh, hub reads).
+def access_text(text, cfg, *, target=None):
+    """``text`` minus the remote-access mentions (ssh, hub reads) whose labels EVERY destination attests.
 
-    Only called after check succeeds, so every destination holds the labels; kept apart from
-    :func:`marker_text` so a card that never needed the attestation keeps its markers."""
-    for rx, _ in _ACCESS:
-        text = rx.sub("", text)
+    An unattested mention stays in the text, so its home marker still pins the card exactly as before.
+    Kept apart from :func:`marker_text` so a card that never needed the attestation keeps its markers."""
+    for rx, needed in _ACCESS:
+        if rx.search(text) and attested(destinations(cfg, target), set(needed)):
+            text = rx.sub("", text)
     return text
 
 
@@ -170,7 +176,7 @@ def claim_refusal(card, me):
     from hermes_cli.kanban_placement import without_evidence, without_placement_note
     text = f"{card.get('title') or ''}\n{without_evidence(without_placement_note(card.get('body') or ''))}"
     from hermes_cli.kanban_runs_on_capabilities import _loads
-    return check(text, {}, target=me, skills=_loads(card.get("skills"), []))
+    return check(text, {}, target=me, skills=_loads(card.get("skills"), []), access=True)
 
 
 def legacy_refusal(args):
diff --git a/tests/hermes_cli/test_kanban_coordination_placement.py b/tests/hermes_cli/test_kanban_coordination_placement.py
index bc677d3c2b5..419b9b5e12b 100644
--- a/tests/hermes_cli/test_kanban_coordination_placement.py
+++ b/tests/hermes_cli/test_kanban_coordination_placement.py
@@ -270,7 +270,7 @@ ACCESS = ["capability:ssh-mbp", "capability:ssh-mini", "capability:hub-read"]
 
 def test_ssh_card_needs_mac_ssh_attestation(fleet):
     cfg, entry, _ = fleet
-    assert reason("ssh mini and check the watcher output", cfg) == "needs worker coordination capability"
+    assert reason("ssh mini and check the watcher output", cfg) == "home gateway marker"
     entry["labels"] += ACCESS
     assert reason("ssh mini and check the watcher output", cfg) is None
 
@@ -278,14 +278,14 @@ def test_ssh_card_needs_mac_ssh_attestation(fleet):
 def test_ssh_attestation_needs_both_mac_keys(fleet):
     cfg, entry, _ = fleet
     entry["labels"] += ["capability:ssh-mini"]
-    assert reason("SSH to the MacBook for the log", cfg) == "needs worker coordination capability"
+    assert reason("SSH to the MacBook for the log", cfg) == "home gateway marker"
 
 
 @pytest.mark.parametrize("body", ["read the log on the hub", "the hub's log output", "journalctl -u x",
                                     "query kanban.db for the run"])
 def test_hub_reads_need_hub_read_attestation(fleet, body):
     cfg, entry, _ = fleet
-    assert reason(body, cfg) == "needs worker coordination capability"
+    assert reason(body, cfg) == "home gateway marker"
     entry["labels"] += ["capability:hub-read"]
     assert reason(body, cfg) is None
 
@@ -305,3 +305,10 @@ def test_claim_refusal_revalidates_access_labels(fleet):
     assert claim_refusal(card, "worker") == "needs worker coordination capability"
     entry["labels"] += ACCESS
     assert claim_refusal(card, "worker") is None
+
+
+def test_unattested_access_leaves_cards_home_as_before(fleet):
+    cfg, entry, _ = fleet
+    entry["labels"] += ["capability:hub-read"]  # hub reads attested, ssh not
+    assert reason("ssh mini and read the log on the hub", cfg) == "home gateway marker"
+    assert reason("read the log on the hub", cfg) is None
-- 
2.55.0

