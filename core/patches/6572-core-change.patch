From 8bc1f8261627dbb3fa5cafdb4186b8f960d66324 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 20:48:13 +0000
Subject: [PATCH 6572] Desktop Background section, stripes and bounded reports

Public mirror of source commit 8bc1f8261627dbb3fa5cafdb4186b8f960d66324.

---
diff --git a/apps/desktop/src/app/chat/sidebar/session-row-card-timers.test.tsx b/apps/desktop/src/app/chat/sidebar/session-row-card-timers.test.tsx
index 8d6fbb600c1..61b4224178c 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row-card-timers.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row-card-timers.test.tsx
@@ -165,10 +165,15 @@
 
   const first = draw(fields)
 
-  for (const colour of ['pink', 'amber', 'green', 'violet']) {
+  for (const colour of ['pink', 'amber', 'orange', 'violet']) {
     expect(first.container.querySelector(`[data-card-colour="${colour}"]`)).not.toBeNull()
   }
 
+  const stuck = first.container.querySelector('[data-card-colour="orange"]')
+  expect(stuck?.textContent).toBe('1')
+  expect(stuck?.className).toContain('border-orange-500')
+  expect(first.container.querySelector('[data-card-colour="green"]')).toBeNull()
+
   first.unmount()
   const { getByTestId } = draw(fields, 'external')
   expect(getByTestId('session-row-eta').nextElementSibling).toBe(getByTestId('session-row-card-timers'))
