From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 08:39:17 +0000
Subject: [PATCH] test(kanban): run_forever holds a refused board without a
 busy retry

Drives the real loop (fails on a7ff3c6 where the held board was skipped). Drops the source-inspection asserts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/hermes_cli/test_kanban_sync_refusal.py | 33 +++++++++++++++++---
 1 file changed, 28 insertions(+), 5 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_sync_refusal.py b/tests/hermes_cli/test_kanban_sync_refusal.py
index 6a64b9d093..001f53a224 100644
--- a/tests/hermes_cli/test_kanban_sync_refusal.py
+++ b/tests/hermes_cli/test_kanban_sync_refusal.py
@@ -106,8 +106,6 @@ def test_backoff_caps_at_fifteen_minutes():
 
 def test_run_forever_never_selects_or_wakes_on_a_held_board(tmp_path):
     """Review of #3759: a held board must leave run_forever's selection and wake set, not spin it every 0.5 s."""
-    import inspect
-
     clock = {"t": 0.0}
     now = lambda: clock["t"]
     boards = _boards(tmp_path)
@@ -115,6 +113,31 @@ def test_run_forever_never_selects_or_wakes_on_a_held_board(tmp_path):
     assert refusal.runnable(boards, now=now) == [boards[1]]
     clock["t"] += refusal.FIRST_BACKOFF_S
     assert refusal.runnable(boards, now=now) == boards
-    src = inspect.getsource(ksc._run_forever)
-    assert "selected = refusal.runnable(selected)" in src
-    assert "ready = refusal.runnable(" in src
+
+
+def test_run_forever_holds_a_refused_board_without_a_busy_retry(monkeypatch, tmp_path):
+    """Exercises the real loop (review of #3759 finding 1): a board that keeps refusing is tried once, then left out of
+    every round until its backoff ends, while the other board keeps syncing and the loop never takes the 0.5 s
+    busy wait."""
+    from pathlib import Path
+
+    from tests.hermes_cli.test_kanban_sync_push_starvation import _fake_loop
+
+    boards = [("refused", Path("refused")), ("healthy", Path("healthy"))]
+    rounds, waits = _fake_loop(monkeypatch, tmp_path, boards)
+    clock = ksc.time.monotonic  # the harness's fake clock (one second per wait)
+    monkeypatch.setattr(refusal.time, "monotonic", clock)
+
+    def sync_board(slug, path, *args):
+        rounds[-1].append(slug)
+        if slug == "refused":
+            raise ContainmentRefused("canonical receipt identity changed")
+        return ksc.RoundResult(board=slug, mode="primary")
+
+    monkeypatch.setattr(ksc, "sync_board", sync_board)
+    ksc.run_forever(lambda: len(rounds) < 40, interval=5)
+    tried = [i for i, r in enumerate(rounds) if "refused" in r]
+    assert tried and tried[0] == 0
+    assert all(i >= refusal.FIRST_BACKOFF_S for i in tried[1:])  # never retried inside its 60 s backoff
+    assert sum("healthy" in r for r in rounds) >= 5  # the other board keeps syncing
+    assert ksc.BUSY_RETRY_S not in waits  # no 0.5 s busy retry for a held board
