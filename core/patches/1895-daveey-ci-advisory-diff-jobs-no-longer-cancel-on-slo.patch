From 3d185ea860226020a0c2a0d233f143de3a7bf823 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 12:42:23 -0800
Subject: [PATCH] [daveey] ci: advisory diff jobs no longer cancel on slow
 full-history checkout

lockfile-diff and prompt-surface-diff ran fetch-depth 0 of the ~1 GB private
repo under a 5-minute timeout; on fresh ci-fast runners the fetch ran past it,
the jobs were cancelled, and the required aggregate failed (sync PR #805 twice,
#801, test/735). Raise both to the fast-lane cap of 10 and make lockfile-diff a
blob:none partial clone (credentials persist, so its two blobs fetch lazily).
---
 .github/workflows/lockfile-diff.yml       | 7 ++++++-
 .github/workflows/prompt-surface-diff.yml | 5 ++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/lockfile-diff.yml b/.github/workflows/lockfile-diff.yml
index eb85417c62c..88fbe5ff707 100644
--- a/.github/workflows/lockfile-diff.yml
+++ b/.github/workflows/lockfile-diff.yml
@@ -41,7 +41,10 @@ jobs:
   diff:
     name: package-lock.json semantic diff
     runs-on: [self-hosted, ci-fast]
-    timeout-minutes: 5
+    # fork: a full-history fetch of this ~1 GB private repo on a fresh ci-fast runner can exceed
+    # 5 min; a cancel here fails the required aggregate (execution is required even though the
+    # findings are advisory). 10 is the fast-lane cap (tests/ci/test_fast_runner_routing.py).
+    timeout-minutes: 10
     outputs:
       changed: ${{ steps.diff.outputs.changed }}
       review_status: ${{ steps.emit-status.outputs.review_status }}
@@ -51,6 +54,8 @@ jobs:
         with:
           ref: ${{ inputs.commit }}
           fetch-depth: 0 # need history for the merge base
+          # fork: commits+trees only; the two lockfile blobs are fetched lazily (credentials persist).
+          filter: blob:none
 
       - name: Generate semantic lockfile diff
         id: diff
diff --git a/.github/workflows/prompt-surface-diff.yml b/.github/workflows/prompt-surface-diff.yml
index 759b82b5fd7..0a421fd4b44 100644
--- a/.github/workflows/prompt-surface-diff.yml
+++ b/.github/workflows/prompt-surface-diff.yml
@@ -41,7 +41,10 @@ jobs:
   diff:
     name: Prompt surface summary
     runs-on: [self-hosted, ci-fast]
-    timeout-minutes: 5
+    # fork: a full-history fetch of this ~1 GB private repo on a fresh ci-fast runner can exceed
+    # 5 min; a cancel here fails the required aggregate (execution is required even though the
+    # findings are advisory). 10 is the fast-lane cap (tests/ci/test_fast_runner_routing.py).
+    timeout-minutes: 10
     outputs:
       changed: ${{ steps.diff.outputs.changed }}
       review_status: ${{ steps.emit-status.outputs.review_status }}
-- 
2.55.0

