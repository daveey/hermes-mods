From 29b193a1dc1e10c6b030afddc586143ae4486eae Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 00:58:11 +0000
Subject: [PATCH] fix(kanban): overlap veto ignores ports, gpu indices and
 one-off repo asides [daveey]

Delta review of e6ac0831dd (opus, probes in hub
~/.hermes/cache/scratch/review387b/) approved it: live hub + replica
replay admits 2 open pairs (mini vs macbook, mini vs metta3), no
duplicates. It named four latent misfires with zero live hits; closed
here because the commit message claimed "not a port":

- process: "hermes-gateway:8642" vs ":8643" read as two processes.
  Process now needs "gateway <n>" (whitespace) or "pid <n>".
- host: "metta-3" and "metta3" were two hosts; gpuN (a device index on
  one machine) was a host. Hosts normalise the dash; gpu is dropped.
- repo: one "see Metta-AI/metta" aside in the old card's body made it
  that card's repo. A body-only repo must be the only one, named twice
  (the bb_bridge card names me/myapp in its run URL and PR flow).
- waits_on: "should not be blocked on t_x" counted as a wait. Negation
  now allows be/been/get/stay/keep before the verb.

Tests: 6 new cases fail on e6ac0831dd; 137 pass across the overlap
suites. Live replay unchanged (same 2 pairs).
---
 hermes_cli/kanban_overlap.py                  | 25 +++++++++++--------
 .../test_kanban_create_overlap_url_slug.py    | 16 ++++++++++++
 2 files changed, 31 insertions(+), 10 deletions(-)

diff --git a/hermes_cli/kanban_overlap.py b/hermes_cli/kanban_overlap.py
index e0956398134..b2c706bd194 100644
--- a/hermes_cli/kanban_overlap.py
+++ b/hermes_cli/kanban_overlap.py
@@ -147,10 +147,12 @@ _HOST_ALIASES = {
 }
 # Bare "hub" is not a host here: it is also the BB hub (on the mini) and "for hub t_..." quotes a card. A host is a
 # whole token: "mini-batch" or a device "sx-heart-room-mini" names no machine, and worker-N is a lane, not a host.
-_HOST_PATTERN = re.compile(r"(?:metta|gpu|bb-linux)-?\d+")
+# gpuN is a device index on one machine, not a machine. ``metta-3`` is ``metta3``.
+_HOST_PATTERN = re.compile(r"(metta|bb-linux)-?(\d+)")
 _TASK_REF = re.compile(r"(?:\b[a-z][\w.-]{0,40}[/ ](?:[\w-]{1,40}/)?)?\bt_[0-9a-f]{8,16}\b")
-# A process lifetime: ``gateway 78233``, ``pid 1722`` (a port after the number is not a process).
-_PROCESS = re.compile(r"\b(?:gateway|pid)[\s=:#]*(?:pid[\s=:#]*)?(\d{3,})\b(?![\s:]*port)")
+# A process lifetime: ``gateway 78233``, ``pid 1722``. A port is not a process: ``gateway 8080 port`` nor
+# ``hermes-gateway:8642`` (a number glued to the word by a colon is an address).
+_PROCESS = re.compile(r"\b(?:gateway\s+(?:pid[\s=:#]*)?|pid[\s=:#]*)(\d{3,})\b(?![\s:]*port)")
 _REVISION = re.compile(r"\b(?=[0-9a-f]*[a-f])(?=[0-9a-f]*[0-9])[0-9a-f]{7,40}\b")
 # A newer revision of the same check is the same owner's work, so a differing sha alone never makes cards
 # distinct. It does when one title inverts the other's acceptance (da19695 "OWNER_ASK_KEYS removal"; the
@@ -165,7 +167,7 @@ _ARTICLES = frozenset({"the", "a", "an"})
 _BODY_SCAN = 20000  # bodies can be huge; a repo named past this is not what the card is about
 _WAIT = re.compile(r"\b(?:park(?:s|ed|ing)?|wait(?:s|ed|ing)?|blocked|depend(?:s|ing)?)\s+on\s+"
                    r"(?:[a-z][\w@-]{0,40}[ /]){0,2}(t_[0-9a-f]{8,16})\b", re.IGNORECASE)
-_NEGATED = re.compile(r"(?:\bnot|n't|\bnever|\bno longer)\s+$", re.IGNORECASE)
+_NEGATED = re.compile(r"(?:\bnot|n't|\bnever|\bno longer)\s+(?:(?:be|been|get|stay|keep)\s+)?$", re.IGNORECASE)
 
 
 def target_identity(title: str, gateways: Iterable[str] = ()) -> dict[str, frozenset[str]]:
@@ -176,8 +178,10 @@ def target_identity(title: str, gateways: Iterable[str] = ()) -> dict[str, froze
     for tok in re.findall(r"[a-z0-9][a-z0-9.-]*[a-z0-9]|[a-z0-9]", low):
         if tok in _HOST_ALIASES:
             hosts.add(_HOST_ALIASES[tok])
-        elif tok in dynamic or _HOST_PATTERN.fullmatch(tok):
+        elif tok in dynamic:
             hosts.add(tok)
+        elif m := _HOST_PATTERN.fullmatch(tok):
+            hosts.add(m.group(1) + m.group(2))
     return {"host": frozenset(hosts), "process": frozenset(_PROCESS.findall(low)),
             "revision": frozenset(_REVISION.findall(low))}
 
@@ -188,14 +192,15 @@ def repos(text: str) -> frozenset[str]:
 
 
 def _repo_of(title: str, body: str) -> tuple[frozenset[str], bool]:
-    """A card's repo and whether its title names it: the title's slugs, else the body's when it names exactly one
-    (the bb_bridge card "Main CI red since effa0d25f: repair the hub suite on main" names me/myapp only in
-    its body)."""
+    """A card's repo and whether its title names it: the title's slugs, else the body's when it names exactly one,
+    at least twice (the bb_bridge card "Main CI red since effa0d25f: repair the hub suite on main" names
+    me/myapp in its run URL and its PR flow). One "see Metta-AI/metta" aside is not the card's repo."""
     named = repos(title)
     if named:
         return named, True
-    in_body = repos(body)
-    return (in_body, False) if len(in_body) == 1 else (frozenset(), False)
+    found = _REPO.findall((body or "")[:_BODY_SCAN].lower())
+    in_body = frozenset(found)
+    return (in_body, False) if len(in_body) == 1 and len(found) >= 2 else (frozenset(), False)
 
 
 def _inverts(title: str, other: str) -> bool:
diff --git a/tests/tools/test_kanban_create_overlap_url_slug.py b/tests/tools/test_kanban_create_overlap_url_slug.py
index 352f74504ef..48631ed972e 100644
--- a/tests/tools/test_kanban_create_overlap_url_slug.py
+++ b/tests/tools/test_kanban_create_overlap_url_slug.py
@@ -554,6 +554,11 @@ def test_pinned_board_db_is_read_once_under_its_own_board_name(home, monkeypatch
     ("Deploy myapp 1a2b3c4 to the hub", "Deploy myapp 5d6e7f8 to the hub and disable old flag", False),
     ("Verify MBP hermes-mods has da19695 (Inbox OWNER_ASK_KEYS removal)",
      "Verify MacBook runs hermes-mods a2dadd6 (inbox ask_contract RETRY_SHAPE + OWNER_ASK_KEYS)", True),
+    # Delta review of e6ac0831dd: a port glued to a hostname, one host spelled two ways and GPU indices on one
+    # machine are not different targets.
+    ("hermes-gateway:8642 returns 502", "hermes-gateway:8643 returns 502", False),
+    ("metta3 still critically low on disk", "metta-3 still critically low on disk", False),
+    ("gpu0 ECC errors after driver update", "gpu2 ECC errors after driver update", False),
 ])
 def test_distinct_target_classes(a, b, distinct):
     from hermes_cli.kanban_overlap import distinct_target
@@ -570,6 +575,15 @@ def test_repos_named_only_in_both_bodies_do_not_make_a_duplicate_distinct(new_bo
     assert distinct_target(title, title, new_body=new_body, card_body=card_body) is None
 
 
+def test_a_single_passing_repo_mention_in_the_other_body_does_not_make_a_duplicate_distinct():
+    """Delta review of e6ac0831dd: a body names its own repo more than once (BB_CI: the run URL and the PR flow);
+    one "see Metta-AI/metta" aside is not what the card is about."""
+    from hermes_cli.kanban_overlap import distinct_target
+    assert distinct_target("Repair main CI hub suite red on me/myapp", "Repair main CI hub suite red",
+                           card_body="Prior art: see Metta-AI/metta.") is None
+    assert distinct_target("Fix red main CI: daveey/hermes (since a8ff96df)", BB_CI[1], card_body=BB_CI[2])
+
+
 @pytest.mark.parametrize(("text", "waits"), [
     ("SCRATCH waiter (parks on macbook t_01a18d2db718c3d1)", True),
     ("Blocked on hub/t_01a18d2db718c3d1 finishing", True),
@@ -579,6 +593,8 @@ def test_repos_named_only_in_both_bodies_do_not_make_a_duplicate_distinct(new_bo
     ("Same producer as t_01a18d2db718c3d1: redo", False),
     ("Second producer, replaces producer t_01a18d2db718c3d1", False),
     ("Its parent t_01a18d2db718c3d1 never finished", False),
+    ("This should not be blocked on t_01a18d2db718c3d1; redo it", False),
+    ("It need not stay waiting on t_01a18d2db718c3d1", False),
 ])
 def test_waits_on_needs_an_unnegated_wait_on_that_card(text, waits):
     from hermes_cli.kanban_overlap import waits_on
