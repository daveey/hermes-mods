From 9dc26ab68cf48e778e64092459cbdc673d77d466 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 00:51:00 -0700
Subject: [PATCH] fix(kanban-sync): read kanban.sync with the repo's YAML
 loader, not PyYAML [daveey]

The mini's venv ships ruamel only; import yaml failed, sync_config() logged
'cannot read config' and sync read as off there. utils.load_yaml_file_readonly
is the loader the rest of Hermes uses (cached on the file signature).

Co-Authored-By: Claude <noreply@anthropic.com>
---
 hermes_cli/kanban_db_sync.py                |  4 ++--
 tests/hermes_cli/test_kanban_sync_client.py | 14 ++++++++++++++
 2 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_db_sync.py b/hermes_cli/kanban_db_sync.py
index 5ac35f6aaf..fd10334189 100644
--- a/hermes_cli/kanban_db_sync.py
+++ b/hermes_cli/kanban_db_sync.py
@@ -170,10 +170,10 @@ def sync_config() -> Mapping[str, Any]:
     there, never from the active profile: a worker running under a profile without the setting must not see
     sync as off and drop the board's capture triggers under the gateway."""
     try:
-        import yaml
         from hermes_cli import kanban_db
+        from utils import load_yaml_file_readonly
         path = kanban_db.kanban_home() / "config.yaml"
-        kanban = ((yaml.safe_load(path.read_text(encoding="utf-8-sig")) if path.exists() else None) or {}).get("kanban") or {}
+        kanban = ((load_yaml_file_readonly(path) if path.exists() else None) or {}).get("kanban") or {}
     except Exception as exc:  # health: allow BLE001 -- an unreadable config reads as sync off; connect() must not break
         _log.warning("kanban sync: cannot read config (%s: %s); sync stays off", type(exc).__name__, exc)
         return {}
diff --git a/tests/hermes_cli/test_kanban_sync_client.py b/tests/hermes_cli/test_kanban_sync_client.py
index e238387c31..094dcf57d8 100644
--- a/tests/hermes_cli/test_kanban_sync_client.py
+++ b/tests/hermes_cli/test_kanban_sync_client.py
@@ -508,3 +508,17 @@ def test_import_clears_rows_the_service_refused_before_it(live, svc):
     assert not live.execute("SELECT 1 FROM kanban_sync_outbox WHERE state = 'rejected'").fetchone()
     assert ksc.push(live, svc.hub(ME), BOARD, ME, primary=False).rejected == 0
     assert tid in svc.board(BOARD)["rows"]["tasks"]
+
+
+def test_sync_config_does_not_need_pyyaml(kanban_home, monkeypatch):
+    """Some installs ship only ruamel (no PyYAML): the switch must still read as on."""
+    import builtins
+    real_import = builtins.__import__
+
+    def no_pyyaml(name, *args, **kwargs):
+        if name == "yaml":
+            raise ModuleNotFoundError("No module named 'yaml'")
+        return real_import(name, *args, **kwargs)
+    support.write_sync_config(kanban_home, True)
+    monkeypatch.setattr(builtins, "__import__", no_pyyaml)
+    assert sync.sync_enabled()
-- 
2.55.0

