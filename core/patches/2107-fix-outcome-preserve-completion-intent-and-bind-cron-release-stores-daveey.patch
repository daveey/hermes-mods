     named = {"crons": crons} if crons else {}
     if holds and declared.get("kind") in ("done", "waiting"):
-        return {**declared, **(named if declared.get("kind") == "done" else {})}
+        return {**{k: v for k, v in declared.items() if k != "crons"},
+                **(named if declared.get("kind") == "done" else {})}
     if not tail:
         return _outcome("unresolved", now, reason="empty", **carry)
     reason = _tail_reason(tail)
@@ -630,12 +631,16 @@ def declare_outcome(sid: str, outcome: dict, *, db: Any = None) -> dict[str, Any
         tip = _tip(handle, sid)
         if _row(handle, tip) is None:
             raise ValueError(f"unknown session {sid}")
-        if declared["kind"] == "done" and not declared.get("keep_crons"):
-            from cron.jobs import use_cron_store
-            from cron.session_ownership import release_session_jobs
+        # Persist intent before touching the separate cron store. A failed DB
+        # write must never release ownership without a completion receipt.
+        _write(handle, tip, declared)
+        if declared["kind"] == "done":
+            from cron.session_ownership import release_for_database
 
-            with use_cron_store(Path(handle.db_path).parent):
-                declared["released_crons"] = release_session_jobs(_lineage_ids(handle, tip))
+            declared["released_crons"], errors = release_for_database(
+                handle, _lineage_ids(handle, tip), keep=bool(declared.get("keep_crons")))
+            if errors:
+                declared["cron_release_error"] = "; ".join(errors)
         _write(handle, tip, declared)
     return declared
 
diff --git a/tests/hermes_state/test_outcome_cron_release.py b/tests/hermes_state/test_outcome_cron_release.py
index 5b98a50e448..a881f4cce87 100644
--- a/tests/hermes_state/test_outcome_cron_release.py
+++ b/tests/hermes_state/test_outcome_cron_release.py
@@ -1,4 +1,8 @@
 """Declaring done ends ownership, not execution, of standing cron jobs."""
+import sqlite3
+
+import pytest
+
 from cron import jobs
 from hermes_cli import cron_session_activity
 from hermes_state import SessionDB
@@ -25,6 +29,50 @@ def test_done_releases_live_cron_without_changing_execution(tmp_path, monkeypatc
                     assert after[key] == before[key], key
 
 
+def test_failed_declaration_write_does_not_release_jobs(tmp_path, monkeypatch):
+    with jobs.use_cron_store(tmp_path), SessionDB(db_path=tmp_path / "state.db") as db:
+        db.create_session("chat", source="desktop")
+        job = jobs.create_job(prompt="Check", schedule="every 1h", owner_session_id="chat")
+        before = jobs.get_job(job["id"])
+
+        def fail_write(*args):
+            raise sqlite3.OperationalError("injected write failure")
+
+        monkeypatch.setattr(outcomes, "_write", fail_write)
+        with pytest.raises(sqlite3.OperationalError, match="injected"):
+            outcomes.declare_outcome("chat", {"kind": "done", "summary": "Finished."}, db=db)
+        assert jobs.get_job(job["id"]) == before
+
+
+def test_corrupt_cron_store_reports_partial_completion(tmp_path):
+    cron_file = tmp_path / "cron" / "jobs.json"
+    cron_file.parent.mkdir()
+    cron_file.write_text("broken json", encoding="utf-8")
+    with SessionDB(db_path=tmp_path / "state.db") as db:
+        db.create_session("chat", source="desktop")
+        result = outcomes.declare_outcome("chat", {"kind": "done", "summary": "Finished."}, db=db)
+        assert result["kind"] == "done"
+        assert result["cron_release_error"]
+        assert outcomes.get_outcome("chat", db=db) == result
+    assert cron_file.read_text(encoding="utf-8") == "broken json"
+
+
+def test_done_releases_cross_profile_owner_not_unrelated_jobs(tmp_path, monkeypatch):
+    profile = tmp_path / "profiles" / "other"
+    profile.mkdir(parents=True)
+    with jobs.use_cron_store(profile):
+        owned = jobs.create_job(prompt="Check", schedule="every 1h", owner_session_id="chat")
+        unrelated = jobs.create_job(prompt="Check", schedule="every 1h", owner_session_id="someone-else")
+    monkeypatch.setattr(cron_session_activity, "_jobs_paths", lambda: [profile / "cron" / "jobs.json"])
+    with SessionDB(db_path=tmp_path / "state.db") as db:
+        db.create_session("chat", source="desktop")
+        result = outcomes.declare_outcome("chat", {"kind": "done", "summary": "Finished."}, db=db)
+        assert [j["id"] for j in result["released_crons"]] == [owned["id"]]
+        assert outcomes._cron_items(["chat"]) == []
+    with jobs.use_cron_store(profile):
+        assert jobs.get_job(unrelated["id"]) == unrelated
+
+
 def test_done_can_keep_cron_ownership(tmp_path):
     with jobs.use_cron_store(tmp_path):
         job = jobs.create_job(prompt="Check", schedule="every 1h", owner_session_id="chat")
