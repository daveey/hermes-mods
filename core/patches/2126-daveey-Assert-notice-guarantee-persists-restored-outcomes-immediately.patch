From 14a5d5efa95f3e36104e9fede2fea5d769bea3f0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 21:48:40 +0000
Subject: [PATCH] [daveey] Assert notice guarantee persists restored outcomes
 immediately

---
 tests/tui_gateway/test_notice_guarantee.py | 2 ++
 tui_gateway/notice_guarantee.py            | 3 ++-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_notice_guarantee.py b/tests/tui_gateway/test_notice_guarantee.py
index 7d7acbb7c18..95868069956 100644
--- a/tests/tui_gateway/test_notice_guarantee.py
+++ b/tests/tui_gateway/test_notice_guarantee.py
@@ -141,6 +141,8 @@ def test_touch_only_human_notice_preserves_previous_turn_outcome(db, prior):
     out, calls = _run(db)
 
     assert calls == [] and [o["result"] for o in out] == ["refreshed:human"]
+    stored = so.get_outcome(CHAT, db=db)
+    assert (stored["kind"], stored.get("reason")) == (before["kind"], before.get("reason"))
     after = so.refresh_outcome(CHAT, "manual", db=db)
     assert (after["kind"], after.get("reason")) == (before["kind"], before.get("reason"))
     assert db._read_one("SELECT MAX(id) FROM messages WHERE session_id = ?", (CHAT,))[0] == row
diff --git a/tui_gateway/notice_guarantee.py b/tui_gateway/notice_guarantee.py
index e5947ccc576..a83595da1b7 100644
--- a/tui_gateway/notice_guarantee.py
+++ b/tui_gateway/notice_guarantee.py
@@ -8,7 +8,8 @@ unloaded sweeper's loop therefore looks, in every profile store, for chats whose
 
 - a "blocked" notice whose card has moved on since (answered, rescheduled, done, archived) never wakes: it is
   stamped ``closeout.state = "superseded"`` and the chat's outcome is refreshed;
-- a notice about a card blocked on a human never wakes: the chat's outcome is refreshed (it reads ``decision``);
+- a notice about a card blocked on a human never wakes: its owner's outcome reads ``decision``; an incidental
+  recipient with no owning obligation preserves its preceding turn's outcome through an informational marker;
 - otherwise the notice row is claimed (``display_metadata.closeout``, compare-and-swap on the row, so exactly one
   backend acts on it) and ONE close-out turn is started with ``server._wake_session_turn``; the claim records the
   verdict;
-- 
2.55.0

