From 60c01b0af8ff5c3d5557263accf94043796d5dbe Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 17:18:41 +0000
Subject: [PATCH] Keep original author when a verdict separates identical
 immutable re-handoffs [daveey]

A review-lane run is not work on the artifact, so it no longer resets rehandoff_runs;
an unchanged merged artifact re-handed off after changes_requested keeps its first author excluded.
---
 hermes_cli/kanban_review_retry.py             | 10 +++++++++
 .../test_kanban_review_retry_custody.py       | 21 +++++++++++++++++++
 2 files changed, 31 insertions(+)

diff --git a/hermes_cli/kanban_review_retry.py b/hermes_cli/kanban_review_retry.py
index eb6b657a8f..9aa39799ce 100644
--- a/hermes_cli/kanban_review_retry.py
+++ b/hermes_cli/kanban_review_retry.py
@@ -34,6 +34,16 @@ def rehandoff_runs(conn, task_id):
     executed = {row[0] for row in conn.execute(
         "SELECT DISTINCT run_id FROM task_events WHERE task_id=? "
         "AND kind IN ('run_route', 'worker_result', 'spawned', 'owner_admitted')", (task_id,))}
+    # A reviewer inspecting the head is not work on the artifact: a verdict between two
+    # identical handoffs leaves the same immutable deliverable under review.
+    reviewing = set()
+    for run_id, kind, raw in conn.execute(
+            "SELECT run_id, kind, payload FROM task_events WHERE task_id=? "
+            "AND kind IN ('model_tier', 'run_route', 'claimed')", (task_id,)):
+        payload = _mapping(raw)
+        if payload.get('lane') == 'review' or (kind == 'claimed' and payload.get('source_status') == 'review'):
+            reviewing.add(run_id)
+    executed -= reviewing
     prior = None
     repeats = set()
     for run_id, outcome, raw in conn.execute(
diff --git a/tests/hermes_cli/test_kanban_review_retry_custody.py b/tests/hermes_cli/test_kanban_review_retry_custody.py
index f0173c289f..103157334a 100644
--- a/tests/hermes_cli/test_kanban_review_retry_custody.py
+++ b/tests/hermes_cli/test_kanban_review_retry_custody.py
@@ -75,6 +75,27 @@ def test_intervening_work_retains_next_handoff_author(identity_board):
             authors.ASTRA, authors.GROK, authors.OPUS}
 
 
+def test_verdict_between_identical_handoffs_keeps_original_author(identity_board):
+    """A reviewed head re-handed off unchanged is still the first author's work."""
+    with authors.kbc.connect() as conn:
+        tid = authors._card(conn)
+        handoff(conn, tid, authors.ASTRA, ARTIFACT)
+        rid = authors._run(conn, tid, receipt=authors.GROK, lane='review')
+        conn.execute("UPDATE task_runs SET outcome='changes_requested' WHERE id=?", (rid,))
+        handoff(conn, tid, authors.OPUS, ARTIFACT)
+        assert review.implementer_models(conn, kb.get_task(conn, tid)) == {authors.ASTRA}
+
+
+def test_verdict_then_changed_handoff_still_starts_new_epoch(identity_board):
+    with authors.kbc.connect() as conn:
+        tid = authors._card(conn)
+        handoff(conn, tid, authors.ASTRA, ARTIFACT)
+        rid = authors._run(conn, tid, receipt=authors.GROK, lane='review')
+        conn.execute("UPDATE task_runs SET outcome='changes_requested' WHERE id=?", (rid,))
+        handoff(conn, tid, authors.OPUS, {**ARTIFACT, 'merge_commit': 'c' * 40})
+        assert review.implementer_models(conn, kb.get_task(conn, tid)) == {authors.OPUS}
+
+
 def test_three_refusals_park_and_wake_stay_review(board, monkeypatch):
     from hermes_cli.kanban_db_dispatch import dispatch_once
     monkeypatch.setenv('HERMES_KANBAN_RATE_LIMIT_COOLDOWN_SECONDS', '0')
