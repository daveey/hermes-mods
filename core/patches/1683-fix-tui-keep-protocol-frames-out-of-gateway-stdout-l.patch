     def write(self, obj: dict) -> bool:
-        """Return ``True`` on success, ``False`` ONLY when the peer is gone (see :func:`_raise_unless_peer_gone`)."""
+        """Return false for a disabled channel or a gone peer; propagate other I/O failures."""
