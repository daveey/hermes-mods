From 2ff7a5cadbe2d50d54ed482a05a39d9f94259902 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 11:13:57 +0000
Subject: [PATCH] [daveey] Divergence repair holds one replica chunk at a time;
 chunk-boundary budget case

---
 hermes_cli/kanban_sync_divergence.py              | 12 ++++++------
 tests/hermes_cli/test_gateway_tick_read_budget.py |  8 +++++---
 2 files changed, 11 insertions(+), 9 deletions(-)

diff --git a/hermes_cli/kanban_sync_divergence.py b/hermes_cli/kanban_sync_divergence.py
index 0e4b23ca40..f34ebf0b1f 100644
--- a/hermes_cli/kanban_sync_divergence.py
+++ b/hermes_cli/kanban_sync_divergence.py
@@ -33,16 +33,16 @@ def repair_divergence(live: sqlite3.Connection, shadow: sqlite3.Connection, gate
             if r["id"] not in held and seen.get(r["id"]) == r["sync_version"]]
     # One replica read per chunk and one omissions read per pass, not one of each per settled card: the scan
     # visits every synced card each round (13% of hub gateway CPU at 4,948 cards, 2026-11-12). [daveey]
-    replica: dict[str, sqlite3.Row] = {}
-    for i in range(0, len(rows), _CHUNK):
-        ids = [r["id"] for r in rows[i:i + _CHUNK]]
-        replica.update((r["id"], r) for r in shadow.execute(
-            f"SELECT * FROM tasks WHERE id IN ({','.join('?' * len(ids))})", ids))
     omissions: dict[str, set[str]] = {}
     for uid, field in live.execute(
             "SELECT row_uid, field FROM kanban_sync_omissions WHERE table_name='tasks' AND state!='delivered'"):
         omissions.setdefault(uid, set()).add(field)
-    for row in rows:
+    replica: dict[str, sqlite3.Row] = {}
+    for index, row in enumerate(rows):
+        if index % _CHUNK == 0:
+            ids = [r["id"] for r in rows[index:index + _CHUNK]]
+            replica = {r["id"]: r for r in shadow.execute(
+                f"SELECT * FROM tasks WHERE id IN ({','.join('?' * len(ids))})", ids)}
         tid = row["id"]
         theirs = replica[tid]
         mine, remote = _row_fields(live, "tasks", row), _row_fields(shadow, "tasks", theirs)
diff --git a/tests/hermes_cli/test_gateway_tick_read_budget.py b/tests/hermes_cli/test_gateway_tick_read_budget.py
index 6b711b72d6..c42565a7be 100644
--- a/tests/hermes_cli/test_gateway_tick_read_budget.py
+++ b/tests/hermes_cli/test_gateway_tick_read_budget.py
@@ -49,8 +49,10 @@ def live(kanban_home):
         conn.close()
 
 
-@pytest.mark.parametrize("cards", [3, 40])
-def test_divergence_repair_reads_the_replica_per_pass_not_per_card(live, kanban_home, monkeypatch, cards):
+@pytest.mark.parametrize("cards, chunk, reads", [(3, 500, 2), (40, 500, 2), (7, 3, 4)])
+def test_divergence_repair_reads_the_replica_per_pass_not_per_card(live, kanban_home, monkeypatch, cards, chunk, reads):
+    from hermes_cli import kanban_sync_divergence
+    monkeypatch.setattr(kanban_sync_divergence, "_CHUNK", chunk)  # the last card sits in a later, partial chunk
     svc = FakeService()
     sync.set_mode(live, "primary")
     ids = [kb.create_task(live, title=f"card {i}", assignee="worker") for i in range(cards)]
@@ -75,7 +77,7 @@ def test_divergence_repair_reads_the_replica_per_pass_not_per_card(live, kanban_
     ksc.sync_board(BOARD, kanban_home / "kanban.db", svc.hub(ME), ME)
     ksc.sync_board(BOARD, kanban_home / "kanban.db", svc.hub(ME), ME)
     assert seen, "the repair scan did not run after a local write"
-    assert len(seen[0]) <= 2, f"{len(seen[0])} replica reads for {cards} settled cards: {seen[0][:6]}"
+    assert len(seen[0]) <= reads, f"{len(seen[0])} replica reads for {cards} settled cards: {seen[0][:6]}"
     assert svc.board(BOARD)["rows"]["tasks"][ids[-1]]["title"] == "gap edit", "the uncaptured edit was not healed"
 
 
