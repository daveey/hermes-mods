+    {"id": "summarize-outstanding-human-array-request", "items": [{"set": {"identity.work_id": "w1", "human_request": [{"action": "Choose a destination", "why_human": "Your preference", "interaction": "reply", "scope": "this task", "evidence": "two options"}]}}], "now": 1001, "expected": {"outstanding_human_requests": 0}},
