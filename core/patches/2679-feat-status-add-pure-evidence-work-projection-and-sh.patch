diff --git a/apps/desktop/src/lib/execution-observations.test.ts b/apps/desktop/src/lib/execution-observations.test.ts
new file mode 100644
index 0000000000..813f7ef39b
--- /dev/null
+++ b/apps/desktop/src/lib/execution-observations.test.ts
@@ -0,0 +1,210 @@
+import { describe, expect, it } from 'vitest'
+
+import fixture from '../../../../schemas/fixtures/execution-observations-v1.json'
+
+import {
+  executionIdentityKey,
+  projectExecutionObservation,
+  selectExecutionObservation,
+  summarizeExecutionObservations
+} from './execution-observations'
+
+// Verdicts live only in the shared fixture, which tests/hermes_cli/test_execution_observation_golden.py also loads.
+type Patch = { set?: Record<string, unknown>; delete?: string[] }
+type Item = Patch & { raw?: unknown }
+interface Case extends Patch {
+  id: string
+  now?: unknown
+  source_class?: string
+  expected: Record<string, unknown>
+  expected_absent?: string[]
+  identity?: unknown
+  items?: Item[]
+  values_raw?: unknown
+}
+
+const clone = <T>(v: T): T => structuredClone(v)
+const isObject = (v: unknown): v is Record<string, unknown> => v !== null && typeof v === 'object' && !Array.isArray(v)
+
+function apply(value: Record<string, unknown>, patch: Patch) {
+  for (const [path, replacement] of Object.entries(patch.set ?? {})) {
+    const keys = path.split('.')
+    let parent = value
+
+    for (const key of keys.slice(0, -1)) {parent = parent[key] as Record<string, unknown>}
+
+    parent[keys.at(-1)!] = clone(replacement)
+  }
+
+  for (const path of patch.delete ?? []) {
+    const keys = path.split('.')
+    let parent = value
+
+    for (const key of keys.slice(0, -1)) {parent = parent[key] as Record<string, unknown>}
+
+    delete parent[keys.at(-1)!]
+  }
+
+  return value
+}
+
+const caseInput = (patch: Patch) => apply(clone(fixture.base) as Record<string, unknown>, patch)
+const itemInput = (item: Item) => ('raw' in item ? clone(item.raw) : caseInput(item))
+
+/** Recursive subset: bool is distinct from number, missing is not null. */
+function subset(actual: unknown, expected: unknown): boolean {
+  if (isObject(expected)) {
+    return isObject(actual) && Object.entries(expected).every(([k, v]) => Object.hasOwn(actual, k) && subset(actual[k], v))
+  }
+
+  if (Array.isArray(expected)) {
+    return Array.isArray(actual) && actual.length === expected.length && expected.every((e, i) => subset(actual[i], e))
+  }
+
+  return Object.is(actual, expected) || (typeof actual === 'number' && actual === expected)
+}
+
+function present(value: unknown, path: string): boolean {
+  for (const key of path.split('.')) {
+    if (!isObject(value) || !Object.hasOwn(value, key)) {return false}
+
+    value = value[key]
+  }
+
+  return true
+}
+
+function check(actual: Record<string, unknown>, test: Case) {
+  const observations = (actual.observations ?? []) as { state: string }[]
+  const view = { ...actual, states: observations.map(o => o.state) }
+
+  expect(subset(view, test.expected), JSON.stringify({ expected: test.expected, actual: view })).toBe(true)
+
+  for (const path of test.expected_absent ?? []) {expect(present(actual, path), path).toBe(false)}
+}
+
+// Passed through verbatim: an invalid class must be rejected by the projector, not normalised by the test.
+const cls = (test: { source_class?: string }) => (test.source_class ?? 'sidebar') as 'sidebar' | 'imported_owner'
+const cases = fixture.cases as unknown as Case[]
+const selectCases = fixture.select_cases as unknown as Case[]
+const summarizeCases = fixture.summarize_cases as unknown as Case[]
+
+describe('shared execution observation semantic contract', () => {
+  it('loads the shared fixture sections', () => {
+    const ids = [...cases, ...selectCases, ...summarizeCases].map(c => c.id)
+
+    expect(new Set(ids).size).toBe(ids.length)
+    expect(cases.length).toBeGreaterThan(150)
+    expect(selectCases.length).toBeGreaterThan(0)
+    expect(summarizeCases.length).toBeGreaterThan(0)
+  })
+
+  for (const test of cases) {
+    it(test.id, () => {
+      const value = caseInput(test)
+      const before = clone(value)
+      const result = projectExecutionObservation(value, (test.now ?? 1001) as number, cls(test))
+
+      check(result, test)
+      expect(value).toEqual(before)
+
+      if ('delivery_receipt' in value && test.expected.state === 'done') {
+        expect(result.delivery_receipt).toEqual(value.delivery_receipt)
+      }
+    })
+  }
+
+  for (const test of selectCases) {
+    it(`select: ${test.id}`, () => {
+      const values = 'values_raw' in test ? clone(test.values_raw) : test.items!.map(itemInput)
+      const before = clone(values)
+      const identity = test.identity ?? fixture.base.identity
+      const result = selectExecutionObservation(values as unknown[], clone(identity), test.now as number, cls(test))
+
+      check(result, test)
+      expect(values).toEqual(before)
+
+      if (Array.isArray(values) && !test.values_raw) {
+        const again = selectExecutionObservation([...values].reverse(), clone(identity), test.now as number, cls(test))
+
+        expect(again.state).toBe(result.state)
+        expect(again.unknown_reason).toBe(result.unknown_reason)
+      }
+    })
+  }
+
+  for (const test of summarizeCases) {
+    it(`summarize: ${test.id}`, () => {
+      const values = 'values_raw' in test ? clone(test.values_raw) : test.items!.map(itemInput)
+      const before = clone(values)
+
+      check(summarizeExecutionObservations(values as unknown[], test.now as number) as unknown as Record<string, unknown>, test)
+      expect(values).toEqual(before)
+    })
+  }
+
+  it.each(['gateway', 'profile', 'board', 'run_id', 'work_id'])('does not alias %s', field => {
+    const id = { ...fixture.base.identity, [field]: field === 'run_id' ? 8 : 'different' }
+
+    expect(executionIdentityKey(id)).not.toEqual(executionIdentityKey(fixture.base.identity))
+    expect(projectExecutionObservation(fixture.base, 1001, 'sidebar', id).state).toBe('unknown')
+  })
+
+  it('treats 7 and 7.0 as one identity but "7" as another', () => {
+    expect(executionIdentityKey({ ...fixture.base.identity, run_id: 7.0 })).toBe(executionIdentityKey(fixture.base.identity))
+    expect(executionIdentityKey({ ...fixture.base.identity, run_id: '7' })).not.toBe(executionIdentityKey(fixture.base.identity))
+  })
+
+  it.each([NaN, Infinity, -Infinity, true, '1000'])('rejects invalid clock %s', observed_at => {
+    expect(projectExecutionObservation({ ...fixture.base, observed_at }, 1001).state).toBe('unknown')
+  })
+
+  it('returns a deep copy: mutating output never touches the input', () => {
+    const value = { ...clone(fixture.base), human_request: { action: 'a', nested: { deep: [1] } } } as Record<string, any>
+    const before = clone(value)
+    const result = projectExecutionObservation(value, 1001) as Record<string, any>
+
+    result.identity.work_id = 'mutated'
+    result.human_request.nested.deep.push(2)
+    result.owner.gateway = 'mutated'
+    expect(value).toEqual(before)
+  })
+
+  it('ignores inherited properties for every lookup', () => {
+    const inherited = Object.create({ source_class: 'imported_owner', successful: true })
+
+    Object.assign(inherited, { observed_at: 900, valid_until: 1600 })
+    // Inherited source_class is not an own property, so the envelope's class applies.
+    expect(projectExecutionObservation({ ...clone(fixture.base), required_sources: [inherited] }, 1001).state).toBe('running')
+
+    const polluted = Object.create({ version: 1, state: 'running' })
+
+    expect(projectExecutionObservation(polluted, 1001).state).toBe('unknown')
+  })
+
+  it('copies an own __proto__ key as data without changing a prototype', () => {
+    const value = JSON.parse(JSON.stringify(fixture.base).replace('"version":1', '"version":1,"__proto__":{"state":"failed","x":1}'))
+    const result = projectExecutionObservation(value, 1001)
+
+    expect(result.state).toBe('running')
+    expect(Object.getPrototypeOf(result)).toBe(Object.prototype)
+    expect((result as Record<string, unknown>).x).toBeUndefined()
+  })
+
+  it('does not throw on cyclic or non-JSON input', () => {
+    const cyclic = clone(fixture.base) as Record<string, unknown>
+
+    cyclic.self = cyclic
+    cyclic.fn = () => 1
+    expect(projectExecutionObservation(cyclic, 1001).state).toBe('running')
+  })
+
+  it('retains partial uncertainty next to fresh running and rejects empty certainty', () => {
+    const result = summarizeExecutionObservations([fixture.base, { ...fixture.base, state: 'unknown' }], 1001)
+
+    expect(result.counts.running).toBe(1)
+    expect(result.counts.unknown).toBe(1)
+    expect(result.uncertain).toBe(true)
+    expect(summarizeExecutionObservations([], 1001).uncertain).toBe(true)
+  })
+})
diff --git a/apps/desktop/src/lib/execution-observations.ts b/apps/desktop/src/lib/execution-observations.ts
new file mode 100644
index 0000000000..b1056b8364
--- /dev/null
+++ b/apps/desktop/src/lib/execution-observations.ts
@@ -0,0 +1,400 @@
+/** Pure v1 work projection. Shared by sidebar and feature-detecting disk plugins.
+ * Python counterpart: hermes_cli.execution_observations; both load the golden contract
+ * schemas/fixtures/execution-observations-v1.json. Never reads clocks implicitly.
+ * Every lookup of producer data is own-property-only and type-checked before any set/map access.
+ */
+export type ExecutionState = 'running' | 'queued' | 'waiting' | 'needs_user' | 'done' | 'failed' | 'cancelled' | 'unknown'
+export type ObservationSourceClass = 'sidebar' | 'imported_owner'
+export interface ExecutionObservation extends Record<string, unknown> {
+  state: ExecutionState
+  freshness: 'current' | 'unknown' | 'stale'
+  unknown_reason?: string
+  last_known_state?: unknown
+  observed_at?: unknown
+  valid_until?: unknown
+  last_activity?: unknown
+  last_progress?: unknown
+}
+
+const STATES: readonly string[] = ['running', 'queued', 'waiting', 'needs_user', 'done', 'failed', 'cancelled', 'unknown']
+const TTL: Readonly<Record<string, number>> = { sidebar: 180, imported_owner: 600 }
+const ID_FIELDS = ['gateway', 'profile', 'board', 'session', 'lineage', 'kind', 'work_id', 'run_id', 'generation']
+const PROGRESS_KINDS = ['artifact', 'test_result', 'work_result']
+const NONHUMAN_WAIT_KINDS = ['dependency', 'transient', 'time']
+const INTERACTIONS = ['approval', 'reply', 'user_terminal', 'physical', 'external']
+const WORK_KINDS = ['card', 'turn', 'process', 'subagent']
+const PROBE_FIELDS = ['resolved_check', 'resolved_check_every']
+// Union of Python str.isspace and JavaScript String.trim sets, so blank/padding checks agree in both languages.
+const WS = '\\t\\n\\v\\f\\r\\x1c-\\x1f \\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff'
+const EDGE_WS = new RegExp(`^[${WS}]+|[${WS}]+$`, 'g')
+
+const has = (o: object, k: string): boolean => Object.prototype.hasOwnProperty.call(o, k)
+const isObject = (v: unknown): v is Record<string, unknown> => v !== null && typeof v === 'object' && !Array.isArray(v)
+const object = (v: unknown): Record<string, unknown> => (isObject(v) ? v : {})
+const get = (o: unknown, k: string): unknown => (isObject(o) && has(o, k) ? o[k] : undefined)
+const trim = (s: string): string => s.replace(EDGE_WS, '')
+const text = (v: unknown): v is string => typeof v === 'string' && v.length > 0
+const nonblank = (v: unknown): v is string => typeof v === 'string' && trim(v).length > 0
+const ident = (v: unknown): v is string => typeof v === 'string' && v.length > 0 && v === trim(v)
+const codePoints = (s: string): number => [...s].length
+const epoch = (v: unknown): v is number => typeof v === 'number' && Number.isFinite(v) && v >= 0 && v <= 8.64e12
+const ttlOf = (c: unknown): number | undefined => (typeof c === 'string' && has(TTL, c) ? TTL[c] : undefined)
+const stateOf = (v: unknown): v is ExecutionState => typeof v === 'string' && STATES.includes(v)
+const integral = (v: unknown): number | null => (typeof v === 'number' && Number.isSafeInteger(v) && v >= 1 ? v : null)
+const attempt = (v: unknown): boolean => integral(v) !== null || ident(v)
+const qualified = (v: unknown): boolean => ['gateway', 'profile'].every(k => ident(get(v, k)))
+
+/** Deep copy of JSON-like data (cycle-safe; own keys defined as data so `__proto__` cannot rebind a prototype). */
+function copy<T>(value: T, seen = new WeakMap<object, unknown>()): T {
+  if (value === null || typeof value !== 'object') {return typeof value === 'function' || typeof value === 'symbol' ? (undefined as T) : value}
+  const known = seen.get(value)
+
+  if (known) {return known as T}
+
+  if (Array.isArray(value)) {
+    const out: unknown[] = []
+
+    seen.set(value, out)
+    value.forEach((v, i) => {
+      out[i] = copy(v, seen)
+    })
+
+    return out as T
+  }
+
+  const out: Record<string, unknown> = {}
+
+  seen.set(value, out)
+
+  for (const key of Object.keys(value)) {
+    const v = copy((value as Record<string, unknown>)[key], seen)
+
+    if (v !== undefined) {Object.defineProperty(out, key, { value: v, enumerable: true, writable: true, configurable: true })}
+  }
+
+  return out as T
+}
+
+function validIdentity(v: unknown): boolean {
+  if (!isObject(v)) {return false}
+
+  const fields = ['gateway', 'profile', 'kind', 'work_id']
+
+  if (get(v, 'kind') === 'card') {fields.push('board')}
+  else if (!ident(get(v, 'session')) && !ident(get(v, 'lineage'))) {return false}
+
+  if (['board', 'session', 'lineage'].some(k => has(v, k) && !ident(v[k]))) {return false}
+
+  const attempts = ['run_id', 'generation'].filter(k => has(v, k))
+
+  return fields.every(k => ident(get(v, k))) && attempts.length > 0 && attempts.every(k => attempt(v[k]))
+}
+
+export function executionIdentityKey(v: unknown): string | null {
+  if (!validIdentity(v)) {return null}
+
+  // JSON keeps "7" distinct from 7 and 7.0 equal to 7.
+  return JSON.stringify(ID_FIELDS.map(k => [k, get(v, k) ?? null]))
+}
+
+/** JSON-semantic equality: bool is not a number; 7 equals 7.0; null is not missing. */
+function sameJson(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => sameJson(v, b[i]))
+  }
+
+  if (isObject(a) || isObject(b)) {
+    if (!isObject(a) || !isObject(b)) {return false}
+
+    const keys = Object.keys(a)
+
+    return keys.length === Object.keys(b).length && keys.every(k => has(b, k) && sameJson(a[k], b[k]))
+  }
+
+  return typeof a === typeof b && a === b
+}
+
+function unknown(out: ExecutionObservation, reason: string, freshness: 'unknown' | 'stale' = 'unknown'): ExecutionObservation {
+  return { ...out, state: 'unknown', freshness, unknown_reason: reason }
+}
+
+function progress(out: ExecutionObservation, now: number): void {
+  const evidence = get(out, 'progress_evidence')
+  const at = get(out, 'last_progress')
+  const observed = get(out, 'observed_at')
+  const kind = get(out, 'last_progress_kind')
+  const ref = get(out, 'last_progress_ref')
+
+  const valid =
+    epoch(at) &&
+    epoch(now) &&
+    epoch(observed) &&
+    at <= observed &&
+    at <= now &&
+    typeof kind === 'string' &&
+    PROGRESS_KINDS.includes(kind) &&
+    text(ref) &&
+    isObject(evidence) &&
+    get(evidence, 'successful') === true &&
+    get(evidence, 'evidence_ref') === ref &&
+    epoch(get(evidence, 'observed_at')) &&
+    get(evidence, 'observed_at') === at
+
+  if (!valid) {
+    out.last_progress = null
+    out.last_progress_kind = null
+    out.last_progress_ref = null
+  }
+}
+
+function validWait(value: unknown, now: number): boolean {
+  const target = get(value, 'target')
+
+  if (!isObject(value) || !qualified(get(value, 'owner')) || !qualified(target) || !ident(get(target, 'kind')) || !ident(get(target, 'work_id'))) {
+    return false
+  }
+
+  if (get(target, 'kind') === 'card' && !ident(get(target, 'board'))) {return false}
+
+  const since = get(value, 'since')
+  const due = get(value, 'due_at')
+
+  return nonblank(get(value, 'kind')) && nonblank(get(value, 'predicate')) && epoch(since) && since <= now && (due == null || (epoch(due) && due >= since))
+}
+
+/** Visible request semantics shared with Python. Probes are stripped before this runs. */
+function humanRequest(value: unknown, waitKind?: unknown): boolean {
+  if (!isObject(value)) {return false}
+
+  if (!['action', 'why_human', 'interaction', 'scope', 'evidence'].every(k => nonblank(get(value, k)))) {return false}
+
+  if (!INTERACTIONS.includes(value.interaction as string)) {return false}
+
+  if (typeof waitKind === 'string' && NONHUMAN_WAIT_KINDS.includes(waitKind)) {return false}
+
+  const choices = get(value, 'choices')
+
+  if (choices != null) {
+    if (!Array.isArray(choices) || choices.length < 2 || choices.length > 6) {return false}
+
+    const values = new Set<string>()
+
+    for (const c of choices) {
+      const label = get(c, 'label')
+      const val = get(c, 'value')
+
+      if (!nonblank(label) || codePoints(trim(label)) > 60 || !nonblank(val) || codePoints(trim(val)) > 120) {return false}
+
+      values.add(trim(val))
+    }
+
+    if (values.size !== choices.length) {return false}
+  }
+
+  return true
+}
+
+/** Private probe commands never enter an observation; the input is not mutated. */
+function stripProbes(raw: Record<string, unknown>): Record<string, unknown> {
+  const request = get(raw, 'human_request')
+
+  if (!isObject(request) || !PROBE_FIELDS.some(k => has(request, k))) {return raw}
+
+  const kept: Record<string, unknown> = {}
+
+  for (const k of Object.keys(request)) {
+    if (!PROBE_FIELDS.includes(k)) {Object.defineProperty(kept, k, { value: request[k], enumerable: true, writable: true, configurable: true })}
+  }
+
+  return { ...raw, human_request: kept }
+}
+
+function freshness(source: Record<string, unknown>, now: number, sourceClass: ObservationSourceClass): ExecutionObservation {
+  const raw = copy(source)
+  const state = get(raw, 'state')
+
+  const out: ExecutionObservation = {
+    ...raw,
+    state: 'unknown',
+    freshness: 'unknown',
+    observed_at: get(raw, 'observed_at') ?? null,
+    valid_until: get(raw, 'valid_until') ?? null,
+    last_activity: get(raw, 'last_activity') ?? null,
+    last_progress: get(raw, 'last_progress') ?? null,
+    age_seconds: null,
+    last_known_state: stateOf(state) && state !== 'unknown' ? state : get(raw, 'last_known_state')
+  }
+
+  const version = get(raw, 'version')
+
+  if (!(typeof version === 'number' && version === 1)) {return unknown(out, 'legacy_or_unsupported_version')}
+
+  if (!validIdentity(get(raw, 'identity'))) {return unknown(out, 'missing_qualified_identity')}
+
+  if (!qualified(get(raw, 'owner'))) {return unknown(out, 'missing_qualified_owner')}
+
+  const refs = get(raw, 'evidence_refs')
+
+  if (!Array.isArray(refs) || refs.length === 0 || !refs.every(nonblank)) {return unknown(out, 'missing_evidence_references')}
+
+  if (!nonblank(get(raw, 'source')) || !nonblank(get(raw, 'source_revision'))) {return unknown(out, 'missing_source_identity')}
+
+  const observed = get(raw, 'observed_at')
+  const until = get(raw, 'valid_until')
+  const ttl = ttlOf(sourceClass)
+
+  if (ttl === undefined || !epoch(now) || !epoch(observed) || !epoch(until)) {return unknown(out, 'missing_or_invalid_source_timing')}
+
+  if (until < observed || now < observed) {return unknown(out, 'clock_inconsistent')}
+
+  let boundary = Math.min(until, observed + ttl)
+  const sources = has(raw, 'required_sources') ? raw.required_sources : []
+
+  if (!Array.isArray(sources)) {return unknown(out, 'invalid_required_sources')}
+
+  for (const s of sources) {
+    const at = get(s, 'observed_at')
+    const end = get(s, 'valid_until')
+
+    if (!epoch(at) || !epoch(end)) {return unknown(out, 'missing_required_source_timing')}
+
+    if (end < at || now < at) {return unknown(out, 'clock_inconsistent')}
+
+    // Absent inherits the envelope class; explicit null/array/unknown is invalid.
+    const sourceTTL = has(s as object, 'source_class') ? ttlOf((s as Record<string, unknown>).source_class) : ttl
+
+    if (sourceTTL === undefined) {return unknown(out, 'invalid_required_source_class')}
+
+    boundary = Math.min(boundary, end, at + sourceTTL)
+  }
+
+  out.valid_until = boundary
+  out.age_seconds = now - observed
+
+  if (now >= boundary) {return unknown(out, 'source_expired', 'stale')}
+
+  if (!stateOf(state)) {return unknown(out, 'unsupported_state')}
+
+  if (state === 'unknown') {
+    const reason = get(raw, 'unknown_reason')
+
+    return unknown(out, text(reason) ? reason : 'source_unknown')
+  }
+
+  out.state = state
+  out.freshness = 'current'
+  delete out.unknown_reason
+
+  return out
+}
+
+function delivered(out: ExecutionObservation): boolean {
+  const receipt = get(out, 'delivery_receipt')
+  const key = executionIdentityKey(get(out, 'identity'))
+
+  return (
+    key !== null &&
+    isObject(receipt) &&
+    get(receipt, 'verified') === true &&
+    get(receipt, 'disposition') === 'delivered' &&
+    nonblank(get(receipt, 'evidence_ref')) &&
+    executionIdentityKey(get(receipt, 'identity')) === key
+  )
+}
+
+/** Never claim done without a matching verified delivered receipt, whatever the source of the value. */
+function lastKnown(out: ExecutionObservation): ExecutionObservation {
+  const known = out.last_known_state
+  const valid = stateOf(known) && known !== 'unknown' && (known !== 'done' || delivered(out))
+
+  out.last_known_state = valid ? known : null
+
