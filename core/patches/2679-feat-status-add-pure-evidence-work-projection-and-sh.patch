+}
+
+export function projectExecutionObservation(
+  value: unknown,
+  now: number,
+  sourceClass: ObservationSourceClass = 'sidebar',
+  expectedIdentity?: unknown
+): ExecutionObservation {
+  return lastKnown(project(value, now, sourceClass, expectedIdentity))
