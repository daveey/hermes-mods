From 3b26b5128b07683c95984d88db985827c0030914 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 27 Nov 2026 02:37:15 +0000
Subject: [PATCH 6704] Spend-review lease allowance consumer, decision liveness and budget fences

Public mirror of source commit 3b26b5128b07683c95984d88db985827c0030914.

---
diff --git a/hermes_cli/kanban_spend_override_fence.py b/hermes_cli/kanban_spend_override_fence.py
index 87bb1af9c15d461bdc058c8129e9d84ef9a5462d..f837463c546440f0662fd96b3a190dde20e203bf 100644
--- a/hermes_cli/kanban_spend_override_fence.py
+++ b/hermes_cli/kanban_spend_override_fence.py
@@ -18,9 +18,14 @@
 
 
 def require_decision(conn, task_id):
-    """Inside the budget writer: release owns its composition; standalone CLI edits do not."""
+    """Inside the budget writer: release owns its composition; standalone CLI edits do not. Only while the card
+    is held where release can record that decision (its ``_HELD`` lanes): a running, todo or ready card whose
+    Core history still reads a stop as pending has no release route, and refusing there would strand it."""
     from hermes_cli import kanban_spend_decision as decision
-    if decision.pending(conn, task_id) and decision.restricted_floor(conn, task_id) is not None:
+    from hermes_cli.kanban_release import _HELD
+    row = conn.execute("SELECT status FROM tasks WHERE id=?", (task_id,)).fetchone()
+    if (row is not None and row[0] in _HELD and decision.pending(conn, task_id)
+            and decision.restricted_floor(conn, task_id) is not None):
         raise StopDecisionRequired(
             f"stop_decision_required: {task_id} still needs a stop decision; no budget was changed. "
             f"Use `hermes kanban release {task_id}` from the owning chat or a human terminal "
diff --git a/tests/hermes_cli/test_kanban_budget_decision_liveness.py b/tests/hermes_cli/test_kanban_budget_decision_liveness.py
index b21e33945f699f841bc343d948eca4caf05336e5..090f003c52de94ccab1ab12817e7deda8af7ef28 100644
--- a/tests/hermes_cli/test_kanban_budget_decision_liveness.py
+++ b/tests/hermes_cli/test_kanban_budget_decision_liveness.py
@@ -90,6 +90,7 @@
         if not inserted:
             inserted = True
             with real(conn):
+                conn.execute("UPDATE tasks SET status='triage' WHERE id=?", (tid,))  # the stop's own writer
                 kb._append_event(conn, tid, decision.EVENT, {'cause': 'scope_stopped', 'reason': 'scope ended'})
         with real(conn, *args, **kwargs) as transaction:
             yield transaction
@@ -112,3 +113,20 @@
     assert reply['ok'] is False and reply['error'] == 'stop_decision_required'
     assert f'hermes kanban release {tid}' in reply['message']
     assert releases.written(board, tid) == before
+
+
+@pytest.mark.parametrize('lane', ['scheduled', 'todo', 'ready', 'running'])
+def test_refusal_applies_only_where_release_can_record_the_decision(board, monkeypatch, lane):
+    """Replay: promoted cards still reading a restricted stop as pending sit in todo/ready/running,
+    where release answers not_held. Refusing their standalone budget there would leave no route at all."""
+    tid = renewed(board, monkeypatch)
+    with kb.write_txn(board):
+        board.execute('UPDATE tasks SET status=? WHERE id=?', (lane, tid))
+    assert decision.pending(board, tid) and decision.restricted_floor(board, tid) is not None
+    rc, error = releases.spend_budget(board, monkeypatch, tid, '--runs', '59', '--reason', 'continue goal')
+    if lane == 'scheduled':  # release's held lanes: it is the route, and it is named
+        assert rc == 1 and 'stop_decision_required' in error
+        assert budget.card_override(board, tid) is None
+    else:
+        assert rc == 0, error
+        assert budget.card_override(board, tid)['runs'] == 59
