From e418b2bf3a8a9fe527363f021d7ae9a37bf88fb8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 03:24:20 +0000
Subject: [PATCH] fix(guard): refuse recursion at public boolean scan
 boundaries [daveey]

---
 cron/lifecycle_guard.py                       |  6 ++---
 ...fecycle_guard_nested_review_regressions.py | 22 ++++++++++++++++++-
 2 files changed, 24 insertions(+), 4 deletions(-)

diff --git a/cron/lifecycle_guard.py b/cron/lifecycle_guard.py
index c1e9a36cabc77d30bea536dbb90d308417746f0a..64d4bb5e7f44241da350ec37a7be08f71de19c6a 100644
--- a/cron/lifecycle_guard.py
+++ b/cron/lifecycle_guard.py
@@ -219,7 +219,7 @@ def contains_host_interpreter_kill(text: str) -> bool:
     """Conservatively match when substitution nesting prevents a complete scan."""
     try:
         return _contains_host_interpreter_kill(text)
-    except SubstitutionNestingLimit:
+    except (SubstitutionNestingLimit, RecursionError):
         return True
 
 
@@ -428,7 +428,7 @@ def contains_gateway_lifecycle_command(text: str, *, mask_heredocs: bool = True)
     """Return a conservative match if substitution nesting prevents a complete scan."""
     try:
         return _contains_gateway_lifecycle_command(text, mask_heredocs=mask_heredocs)
-    except SubstitutionNestingLimit:
+    except (SubstitutionNestingLimit, RecursionError):
         return True
 
 
@@ -950,7 +950,7 @@ def contains_launchctl_submit_command(command: str) -> bool:
     """Return a conservative match if substitution nesting prevents a complete scan."""
     try:
         return _contains_launchctl_submit_command(command)
-    except SubstitutionNestingLimit:
+    except (SubstitutionNestingLimit, RecursionError):
         return True
 
 
diff --git a/tests/cron/test_lifecycle_guard_nested_review_regressions.py b/tests/cron/test_lifecycle_guard_nested_review_regressions.py
index 964ca7fbdcc1ca7c3b78f1bcc1dab98f96000f3a..f702ddf71c427a5dfdd4483c8ed305d155fc8777 100644
--- a/tests/cron/test_lifecycle_guard_nested_review_regressions.py
+++ b/tests/cron/test_lifecycle_guard_nested_review_regressions.py
@@ -1,7 +1,13 @@
 """Real-shell execution and clean twins for nested-frame review regressions."""
 import pytest
 
-from cron.lifecycle_guard import scan_gateway_lifecycle
+from cron.lifecycle_guard import (
+    contains_gateway_lifecycle_command,
+    contains_host_interpreter_kill,
+    contains_launchctl_submit_command,
+    scan_gateway_lifecycle,
+)
+from tools.approval_detection import detect_dangerous_command
 from tests.cron.test_lifecycle_guard_fd_redirections import _bash_runs, _tree
 
 DEEP = '${x:-$(' * 199 + 'true' + ')}' * 199
@@ -34,3 +40,17 @@ def test_review_clean(tmp_path, command):
     _tree(tmp_path)
     assert not _bash_runs(tmp_path, command)
     assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (False, None)
+
+
+@pytest.mark.parametrize('scanner', [
+    contains_gateway_lifecycle_command,
+    contains_host_interpreter_kill,
+    contains_launchctl_submit_command,
+    detect_dangerous_command,
+])
+@pytest.mark.parametrize('literal', [False, True], ids=['RUN', 'CLEAN'])
+def test_deep_nesting_public_boundaries(scanner, literal):
+    command = "echo '" + DEEP + "'" if literal else 'echo ' + DEEP
+    result = scanner(command)
+    unsafe = result[0] if isinstance(result, tuple) else result
+    assert unsafe is not literal
-- 
