From 6bff20084bd0f3cc97d55bf3cea51cf0d80cc085 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 00:28:56 +0000
Subject: [PATCH] [daveey] test(kanban pacing): hold three days out instead of
 a fixed epoch that went red at its UTC date

Co-Authored-By: Contributor <contributor@example.com>
---
 tests/hermes_cli/test_kanban_pacing_queue.py | 12 ++++++++++--
 tests/plugins/test_kanban_pacing_detail.py   | 12 ++++++++++--
 2 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_pacing_queue.py b/tests/hermes_cli/test_kanban_pacing_queue.py
index efbbc30180..5811619bbc 100644
--- a/tests/hermes_cli/test_kanban_pacing_queue.py
+++ b/tests/hermes_cli/test_kanban_pacing_queue.py
@@ -1,4 +1,6 @@
 """Recorded pacing is a queue reason, not a slot wait. [daveey]"""
+import time
+
 import pytest
 
 from hermes_cli import kanban_db as kb
@@ -7,6 +9,12 @@ from hermes_cli import kanban_queue_position as queue
 from tests.hermes_cli.test_kanban_pace_reroute import board as board  # noqa: PLC0414 -- pytest fixture
 
 
+# A hold three days out: still active, and never today (today's holds print without a date). A fixed epoch went
+# red at its own UTC date and would drop the hold once it passed. [daveey]
+_UNTIL = time.time() + 3 * 86400
+_UNTIL_TEXT = time.strftime('%Y-%m-%d %H:%MZ', time.gmtime(int(_UNTIL)))
+
+
 @pytest.mark.parametrize('placement', [None, 'worker-first-v1'])
 @pytest.mark.parametrize('reason', ['llm_paced', 'llm_pacing'])
 def test_pacing_queue_note_precedes_worker_placement(board, placement, reason, monkeypatch):
@@ -24,12 +32,12 @@ def test_pacing_queue_note_precedes_worker_placement(board, placement, reason, m
             conn.execute('UPDATE tasks SET placement_policy=? WHERE id=?', (placement, tid))
         with kb.write_txn(conn):
             kb._append_event(conn, tid, 'dispatch_skipped', {
-                'reason': reason, 'detail': 'xai-oauth held', 'until': 1795474351.914,
+                'reason': reason, 'detail': 'xai-oauth held', 'until': _UNTIL,
                 'providers': [{'provider': 'xai-oauth', 'state': 'held', 'limit': 0}]})
         task = kb.get_task(conn, tid)
         fields = queue.fields(queue.read(conn, task))
         assert fields['queue']['lane'] == 'llm_pacing'
-        assert 'LLM quota pacing (xai-oauth held pool) until 2026-11-23 22:52Z' in fields['queue_note']
+        assert f'LLM quota pacing (xai-oauth held pool) until {_UNTIL_TEXT}' in fields['queue_note']
         assert 'worker' not in fields['queue_note'] and 'slot' not in fields['queue_note']
         with kb.write_txn(conn):
             kb._append_event(conn, tid, 'dispatch_skipped', {'reason': 'per_profile_capped', 'detail': 'coach'})
diff --git a/tests/plugins/test_kanban_pacing_detail.py b/tests/plugins/test_kanban_pacing_detail.py
index 78684592dc..11e6f2b44e 100644
--- a/tests/plugins/test_kanban_pacing_detail.py
+++ b/tests/plugins/test_kanban_pacing_detail.py
@@ -1,4 +1,6 @@
 """Live and replica card detail preserve recorded pacing without local capacity claims. [daveey]"""
+import time
+
 import pytest
 
 from hermes_cli import kanban_db as kb
@@ -11,6 +13,12 @@ from tests.plugins.test_kanban_foreign_card_api import (
 from tests.plugins.test_kanban_foreign_card_api import api as api, kanban_home as kanban_home  # noqa: PLC0414 -- fixtures
 
 
+# A hold three days out: still active, and never today (today's holds print without a date). A fixed epoch went
+# red at its own UTC date and would drop the hold once it passed. [daveey]
+_UNTIL = time.time() + 3 * 86400
+_UNTIL_TEXT = time.strftime('%Y-%m-%d %H:%MZ', time.gmtime(int(_UNTIL)))
+
+
 @pytest.mark.parametrize('replica', [False, True])
 def test_card_detail_names_pacing_provider_and_reset(kanban_home, api, monkeypatch, replica):
     tid = make_replica_card(kanban_home) if replica else _live_card()
@@ -21,14 +29,14 @@ def test_card_detail_names_pacing_provider_and_reset(kanban_home, api, monkeypat
     with kbc.connect(path) as conn:
         with kb.write_txn(conn):
             kb._append_event(conn, tid, 'dispatch_skipped', {
-                'reason': 'llm_paced', 'detail': 'xai-oauth held', 'until': 1795474351.914,
+                'reason': 'llm_paced', 'detail': 'xai-oauth held', 'until': _UNTIL,
                 'providers': [{'provider': 'xai-oauth', 'state': 'held', 'limit': 0}]})
     result = api.get(f'/api/plugins/kanban/tasks/{tid}')
     assert result.status_code == 200, result.text
     body = result.json()
     assert body['source'] == ('replica' if replica else 'live')
     assert body['queue']['lane'] == 'llm_pacing'
-    assert 'LLM quota pacing (xai-oauth held pool) until 2026-11-23 22:52Z' in body['queue_note']
+    assert f'LLM quota pacing (xai-oauth held pool) until {_UNTIL_TEXT}' in body['queue_note']
     assert 'worker' not in body['queue_note'] and 'slot' not in body['queue_note']
     if replica:
         assert 'capacity_note' not in body and 'wait_observation' not in body
-- 
