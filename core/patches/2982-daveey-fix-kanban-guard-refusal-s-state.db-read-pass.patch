From 45a7521b5a70e982305f91c188d921b358d058c5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 18:31:06 +0000
Subject: [PATCH] [daveey] fix(kanban): guard-refusal's state.db read passes
 the board lockguard; a refusal with an appended budget notice still counts

Review 5879878115 (t_01a1d0f8f07a0344) on c98479ce90:
- Blocker: tests/hermes_cli/test_kanban_lockguard.py flagged the raw sqlite3.connect in
  kanban_guard_refusal.refused_kanban_calls. It opens the worker's state.db read-only, not a board,
  so it carries the established `# noqa: kanban-lockguard` marker (as kanban_notify_reconcile_exec,
  kanban_identity do).
- Nit: the tool executor appends a budget notice to the latest tool result before it is persisted, so
  a park call refused as the run's budget ran out failed json.loads and was not counted. _is_guard_refusal
  now reads only the leading JSON value (JSONDecoder.raw_decode). New test
  test_refusal_with_appended_budget_notice_still_counts.
---
 hermes_cli/kanban_guard_refusal.py            | 13 +++++++++----
 tests/hermes_cli/test_kanban_guard_refusal.py | 16 ++++++++++++++++
 2 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_guard_refusal.py b/hermes_cli/kanban_guard_refusal.py
index 860b4bab68..50bb60ce93 100644
--- a/hermes_cli/kanban_guard_refusal.py
+++ b/hermes_cli/kanban_guard_refusal.py
@@ -60,10 +60,14 @@ def _prior_refusal_streak(conn: sqlite3.Connection, task_id: str, run_id) -> int
 
 def _is_guard_refusal(content) -> bool:
     """The tool result IS the skipped-guard refusal (``tool_error``'s ``{"error": "<marker>..."}``), not
-    merely a result quoting it (a ``kanban_show`` of a card whose body cites the marker)."""
+    merely a result quoting it (a ``kanban_show`` of a card whose body cites the marker). Only the leading
+    JSON value is read: near the end of a run the tool executor appends a budget notice to the latest tool
+    result before it is persisted, and a park call refused as the budget runs out must still count."""
+    if not isinstance(content, str):
+        return False
     try:
-        body = json.loads(content or "")
-    except (TypeError, ValueError):
+        body, _end = json.JSONDecoder().raw_decode(content.lstrip())
+    except ValueError:
         return False
     error = body.get("error") if isinstance(body, dict) else None
     return isinstance(error, str) and error.startswith(REFUSAL_MARKER)
@@ -85,7 +89,8 @@ def refused_kanban_calls(conn: Optional[sqlite3.Connection], task_id: str, run_i
         return []
     state_db, session_id = row[0], row[1]
     try:
-        with closing(sqlite3.connect(Path(state_db).as_uri() + "?mode=ro", uri=True, timeout=2)) as state:
+        uri = Path(state_db).as_uri() + "?mode=ro"
+        with closing(sqlite3.connect(uri, uri=True, timeout=2)) as state:  # noqa: kanban-lockguard (state.db)
             rows = state.execute(
                 "SELECT tool_name, content FROM messages "
                 "WHERE session_id=? AND role='tool' ORDER BY id DESC LIMIT ?",
diff --git a/tests/hermes_cli/test_kanban_guard_refusal.py b/tests/hermes_cli/test_kanban_guard_refusal.py
index f0b9e2e7cd..7132d674f2 100644
--- a/tests/hermes_cli/test_kanban_guard_refusal.py
+++ b/tests/hermes_cli/test_kanban_guard_refusal.py
@@ -173,6 +173,22 @@ def test_refused_kanban_complete_counts_as_host_refusal(kanban_home):
         assert task.status == "ready" and "failure_finalized" not in kinds
 
 
+def test_refusal_with_appended_budget_notice_still_counts(kanban_home):
+    """Near the end of a run the tool executor appends a budget notice to the latest tool result before it
+    is persisted; a park call refused as the budget runs out is still the refusal."""
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="t", assignee="default")
+        run_id = _clean_exit(conn, tid, 70106)
+        notice = "\n\n[BUDGET WARNING: iteration 89/90. Wrap up and park the card now.]"
+        _session(kanban_home, conn, tid, run_id, [("kanban_continue", REFUSAL + notice)])
+
+        kbd.detect_crashed_workers(conn)
+
+        run, kinds, task = _booking(conn, tid)
+        assert json.loads(run["metadata"])["guard_refusal"] == {"refused_tools": ["kanban_continue"]}
+        assert task.status == "ready" and "failure_finalized" not in kinds
+
+
 def test_refusal_streak_is_bounded(kanban_home):
     """A guard that stays hung must not requeue a card uncounted forever: after ``STREAK_LIMIT`` such runs
     the next one is charged as a protocol violation again."""
