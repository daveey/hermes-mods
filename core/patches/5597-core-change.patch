From 32a55220c993cb8131b38e21ca96df70eb6b7ac3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 11:22:32 +0000
Subject: [PATCH] test(kanban): retain quiet and sync fences with eligible
 dynamic routes [daveey]

---
 .../test_kanban_sync_watcher_claim_fence.py     |  4 ++--
 tests/hermes_cli/kanban_sync_support.py         | 12 ++++++++++++
 tests/hermes_cli/test_kanban_sync_claim_gate.py |  2 +-
 tests/hermes_cli/test_quiet_gates_dispatch.py   | 17 +++++++++++++++--
 4 files changed, 30 insertions(+), 5 deletions(-)

diff --git a/tests/gateway/test_kanban_sync_watcher_claim_fence.py b/tests/gateway/test_kanban_sync_watcher_claim_fence.py
index a62c15ae1c..dab3cb358f 100644
--- a/tests/gateway/test_kanban_sync_watcher_claim_fence.py
+++ b/tests/gateway/test_kanban_sync_watcher_claim_fence.py
@@ -43,13 +43,13 @@ def kanban_home(tmp_path, monkeypatch):
 
 
 def _board(kanban_home, *, enabled):
-    support.write_sync_config(kanban_home, True)
+    support.write_routed_sync_config(kanban_home, True)
     svc = FakeService(lease_runs=True)
     conn = kbc.connect(kanban_home / "kanban.db")
     ksc.ensure_identity(conn, BOARD, ME)
     sync.set_mode(conn, "primary")
     sync.set_lease_client(ksc.HubLeaseClient(svc.hub(ME)))
-    support.write_sync_config(kanban_home, enabled)  # the switch the watcher reads at startup
+    support.write_routed_sync_config(kanban_home, enabled)  # the switch the watcher reads at startup
     return conn
 
 
diff --git a/tests/hermes_cli/kanban_sync_support.py b/tests/hermes_cli/kanban_sync_support.py
index bdac3f3bc4..0558406aac 100644
--- a/tests/hermes_cli/kanban_sync_support.py
+++ b/tests/hermes_cli/kanban_sync_support.py
@@ -19,6 +19,18 @@ def write_sync_config(home: Path, enabled: bool) -> None:
     (home / "config.yaml").write_text(f"kanban:\n  sync:\n    enabled: {'true' if enabled else 'false'}\n")
 
 
+def write_routed_sync_config(home: Path, enabled: bool) -> None:
+    """Real default route eligibility for tests driving automatic dispatch, not only sync."""
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    from hermes_cli.config_effective import load_user_config_effective
+    write_sync_config(home, enabled)
+    with (home / "config.yaml").open("a") as stream:
+        stream.write(_managed_yaml())
+    config = load_user_config_effective()
+    assert config["kanban"]["sync"]["enabled"] is enabled
+    assert config["model_routing"]["enabled"] is True
+
+
 def kanban_home(tmp_path, monkeypatch):
     home = tmp_path / ".hermes"
     home.mkdir()
diff --git a/tests/hermes_cli/test_kanban_sync_claim_gate.py b/tests/hermes_cli/test_kanban_sync_claim_gate.py
index 227a2d6674..2c45e99920 100644
--- a/tests/hermes_cli/test_kanban_sync_claim_gate.py
+++ b/tests/hermes_cli/test_kanban_sync_claim_gate.py
@@ -62,7 +62,7 @@ def kanban_home(tmp_path, monkeypatch):
 
 @pytest.fixture
 def live(kanban_home, svc):
-    support.write_sync_config(kanban_home, True)
+    support.write_routed_sync_config(kanban_home, True)
     conn = kbc.connect(kanban_home / "kanban.db")
     ksc.ensure_identity(conn, BOARD, ME)
     sync.set_mode(conn, "primary")
diff --git a/tests/hermes_cli/test_quiet_gates_dispatch.py b/tests/hermes_cli/test_quiet_gates_dispatch.py
index 9b3b102aab..30c8ab175b 100644
--- a/tests/hermes_cli/test_quiet_gates_dispatch.py
+++ b/tests/hermes_cli/test_quiet_gates_dispatch.py
@@ -40,6 +40,11 @@ def board(tmp_path, monkeypatch):
     monkeypatch.setattr(kbd, "_profile_exists_fn", lambda: lambda name: name == "default")
     monkeypatch.setattr(kbd, "_memory_pressure_level", lambda: "unknown")
     monkeypatch.setattr(kbd, "review_dispatch_enabled", lambda: False)
+    from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
+    from hermes_cli.kanban_model_assignment import _assignee_config
+    assert not _assignee_config("default").get("model_routing", {}).get("enabled")
+    (tmp_path / "config.yaml").write_text(_managed_yaml())
+    assert _assignee_config("default")["model_routing"]["enabled"] is True
     spawned: list[str] = []
     monkeypatch.setattr(kbd, "_default_spawn", lambda task, ws, *, board=None: spawned.append(task.id) or None)
     with kbc.connect_closing(board="default") as conn:
@@ -80,9 +85,17 @@ def test_automatic_local_claim_deferred_then_resumes(board):
 
 def test_review_lane_claim_deferred_too(board, monkeypatch):
     monkeypatch.setattr(kbd, "review_dispatch_enabled", lambda: True)
+    assert [tid for tid, *_ in _dispatch().spawned] == [board.tid]
+    board.spawned.clear()  # observe only the later quiet review attempt
     with kbc.connect_closing(board="default") as conn:
-        assert kb.claim_task(conn, board.tid) is not None
-        assert kb.request_review(conn, board.tid, summary="r") is True
+        task = kb.get_task(conn, board.tid)
+        assert task.current_run_id is not None
+        kb._append_event(conn, board.tid, "worker_result",
+                         {"route_model": "claude-sonnet-5-5", "route_provider": "anthropic"},
+                         run_id=task.current_run_id)
+        assert kb.request_review(conn, board.tid, summary="r", expected_run_id=task.current_run_id) is True
+        from hermes_cli.kanban_review_model import implementer_models
+        assert implementer_models(conn, kb.get_task(conn, board.tid)) == {"claude-sonnet-5-5"}
     with cq.acquire(max_s=60, reason="measure") as owner:
         result = _dispatch()
     assert board.spawned == [] and result.quiet_deferred == [(board.tid, owner.lease.episode_id)]
-- 
2.43.0

