diff --git a/agent/credential_pool_values.py b/agent/credential_pool_values.py
new file mode 100644
index 0000000000..1a9dff6aa8
--- /dev/null
+++ b/agent/credential_pool_values.py
@@ -0,0 +1,13 @@
+"""Pure credential row normalization and ordering helpers."""
+
+
+def normalize_pool_auth_type(provider, token, auth_type):
+    from agent.credential_pool import AUTH_TYPE_API_KEY, AUTH_TYPE_OAUTH
+
+    if provider == "anthropic" and isinstance(token, str) and token.startswith("sk-ant-oat"):
+        return AUTH_TYPE_OAUTH
+    return str(auth_type or AUTH_TYPE_API_KEY)
+
+
+def next_priority(entries):
+    return max((entry.priority for entry in entries), default=-1) + 1
diff --git a/agent/model_routing.py b/agent/model_routing.py
new file mode 100644
index 0000000000..65f7870fcc
--- /dev/null
+++ b/agent/model_routing.py
@@ -0,0 +1,132 @@
+"""Opt-in class-preserving, subscription-first routing before credential resolution.
+
+Concrete model pins never enter the allocator. Eligibility/funding attestations are
+operator-provided, host-specific facts, not inferred from the existence of a key.
+Runtime credential validation is a separate gate, before any request is sent.
+"""
+from __future__ import annotations
+
+from agent.model_routing_state import RoutingState
+
+CLASSES = frozenset({"deep", "standard", "fast"})
+BILLING = frozenset({"subscription", "credit-funded", "metered"})
+SUBSCRIPTION_PROVIDERS = frozenset({"anthropic", "openai-codex", "xai-oauth"})
+
+
+class ModelRoutingError(ValueError):
+    """Fail closed; deliberately not AuthError (legacy paid fallbacks catch it)."""
+
+
+def is_class_selector(model):
+    return isinstance(model, str) and model.startswith("class:")
+
+
+def _validate_route(route):
+    if not isinstance(route, dict):
+        raise ModelRoutingError("Route must be an exact provider/model/billing/weight/capabilities mapping")
+    for key in ("provider", "model"):
+        if not isinstance(route.get(key), str) or not route[key] or route[key].strip() != route[key]:
+            raise ModelRoutingError(f"Route {key} must be a nonempty exact identifier")
+    if route["provider"] == "auto" or is_class_selector(route["model"]):
+        raise ModelRoutingError("Registry routes must be concrete, never auto or class selectors")
+    if route.get("billing") not in BILLING:
+        raise ModelRoutingError("Unknown route billing classification")
+    if route["billing"] == "subscription" and route["provider"] not in SUBSCRIPTION_PROVIDERS:
+        raise ModelRoutingError("Unverified subscription provider: only native subscription transports are supported")
+    weight = route.get("weight")
+    if type(weight) is not int or not 1 <= weight <= 100:
+        raise ModelRoutingError("Route weight must be an integer from 1 to 100")
+    if not isinstance(route.get("capabilities"), dict):
+        raise ModelRoutingError("Route capabilities must be a mapping")
+    for key in ("eligible", "funding_verified"):
+        if key in route and type(route[key]) is not bool:
+            raise ModelRoutingError(f"Route {key} must be boolean")
+    caps = route["capabilities"]
+    for key, value in caps.items():
+        if key in ("context_tokens", "max_latency_ms"):
+            if type(value) is not int or value <= 0:
+                raise ModelRoutingError(f"Capability {key} must be a positive integer")
+        elif type(value) is not bool:
+            raise ModelRoutingError(f"Capability {key} must be boolean")
+
+
+def validate_policy(policy):
+    if not isinstance(policy, dict):
+        raise ModelRoutingError("model_routing must be a mapping")
+    if type(policy.get("enabled", False)) is not bool or type(policy.get("allow_metered", False)) is not bool:
+        raise ModelRoutingError("model_routing enabled/allow_metered must be boolean")
+    if type(policy.get("policy_version", 1)) is not int or policy.get("policy_version", 1) != 1:
+        raise ModelRoutingError("Unsupported model_routing policy_version")
+    routes = policy.get("routes", {})
+    if not isinstance(routes, dict) or set(routes) - CLASSES:
+        raise ModelRoutingError("Registry must contain only deep/standard/fast route lists")
+    for level, entries in routes.items():
+        if not isinstance(entries, list):
+            raise ModelRoutingError(f"{level} routes must be a list")
+        identities, weights = set(), {}
+        for route in entries:
+            _validate_route(route)
+            identity = route["provider"], route["model"]
+            if identity in identities:
+                raise ModelRoutingError("Duplicate route identity")
+            identities.add(identity)
+            provider = route["provider"]
+            if provider in weights and weights[provider] != route["weight"]:
+                raise ModelRoutingError("All routes for a provider must use the same provider weight")
+            weights[provider] = route["weight"]
+
+
+def _capable(route, requirements):
+    caps = route["capabilities"]
+    for key, value in requirements.items():
+        if key == "min_context_tokens":
+            if caps.get("context_tokens", 0) < value:
+                return False
+        elif key == "max_latency_ms":
+            if caps.get(key, float("inf")) > value:
+                return False
+        elif value and caps.get(key) is not True:
+            return False
+    return True
+
+
+def resolve_model_route(model, provider="auto", *, config=None, session_id=None,
+                        parent_session_id=None, requirements=None, excluded=(), state_path=None,
+                        eligible=None):
+    """Return concrete model/provider and durable metadata, or unchanged exact pin.
+
+    ``excluded`` is a sequence of failed (provider, model) pairs for a new attempt,
+    never a reason to rebalance a healthy running turn. No paid legacy fallback is
+    permissible after ModelRoutingError. Caller must validate actual credentials.
+    """
+    if not is_class_selector(model):
+        return {"model": model, "provider": provider, "metadata": None}
+    level = model.removeprefix("class:")
+    if level not in CLASSES:
+        raise ModelRoutingError(f"Unknown model class: {level}")
+    if provider not in (None, "", "auto"):
+        raise ModelRoutingError("Class selectors require provider auto; use a concrete model to pin a provider")
+    if config is None:
+        from hermes_cli.config_effective import load_user_config_effective
+        config = load_user_config_effective()
+    policy = config.get("model_routing", {})
+    validate_policy(policy)
+    if not policy.get("enabled", False):
+        raise ModelRoutingError("Model class routing is disabled")
+    if not isinstance(session_id, str) or not session_id:
+        raise ModelRoutingError("Class routing requires a durable session/job identity")
+    excluded = set(tuple(pair) for pair in excluded)
+    routes = [r for r in policy.get("routes", {}).get(level, [])
+              if r.get("eligible") is True and r.get("funding_verified") is True
+              and (r["provider"], r["model"]) not in excluded
+              and _capable(r, requirements or {})
+              and (r["billing"] == "subscription" or policy.get("allow_metered", False))
+              and (eligible is None or eligible(r))]
+    # Keep the full policy-approved set for sticky lookup. New allocations prefer
+    # subscriptions; returning to a healthy paid session must not silently switch it.
+    if state_path is None:
+        from hermes_constants import get_hermes_home
+        state_path = get_hermes_home() / "model-routing.sqlite3"
+    metadata = RoutingState(state_path).allocate(session_id, parent_session_id, level,
+                                                routes, policy.get("policy_version", 1), excluded)
+    return {"model": metadata["selected_model"], "provider": metadata["selected_provider"], "metadata": metadata}
diff --git a/agent/model_routing_runtime.py b/agent/model_routing_runtime.py
new file mode 100644
index 0000000000..9e769db242
--- /dev/null
+++ b/agent/model_routing_runtime.py
@@ -0,0 +1,74 @@
+"""Class routing's credential boundary: no generic provider/billing fallback."""
+from __future__ import annotations
+
+from agent.model_routing import ModelRoutingError, resolve_model_route
+
+
+def resolve_class_runtime(model, provider, *, config=None, session_id=None,
+                          parent_session_id=None, requirements=None, excluded=()):
+    from agent.credential_pool import load_pool
+    from hermes_cli import runtime_provider as runtime
+
+    if config is None:
+        from hermes_cli.config_effective import load_user_config_effective
+        config = load_user_config_effective()
+    pools = {}
+
+    def eligible(route):
+        from hermes_cli.config import is_provider_enabled
+        block = config.get("providers", {}).get(route["provider"], {})
+        if not is_provider_enabled(block):
+            return False
+        key = route["provider"], route["billing"]
+        if key not in pools:
+            pools[key] = load_pool(route["provider"], allowed_auth_types=
+                                  {"oauth"} if route["billing"] == "subscription" else None)
+        return pools[key].has_available(model=route["model"])
+
+    failed = list(excluded)
+    while True:
+        chosen = resolve_model_route(model, provider, config=config, session_id=session_id,
+                                     parent_session_id=parent_session_id, requirements=requirements,
+                                     excluded=failed, eligible=eligible)
+        metadata = chosen["metadata"]
+        selected = chosen["provider"]
+        runtime._raise_if_provider_disabled(selected)
+        pool = pools[selected, metadata["billing_group"]]
+        entry = pool.select(model=chosen["model"])
+        if entry is None:
+            # Refresh/quota can change after the availability probe. Never enter
+            # the legacy ladder (it can consume an environment API key).
+            failed.append((selected, chosen["model"]))
+            continue
+        cfg = {"provider": selected, "default": chosen["model"]}
+        resolved = runtime._resolve_runtime_from_pool_entry(
+            provider=selected, entry=entry, model_cfg=cfg, pool=pool,
+            requested_provider=selected, target_model=chosen["model"])
+        verify_class_runtime(resolved, metadata)
+        resolved.update(model=chosen["model"], model_routing=metadata)
+        return resolved
+
+
+def verify_class_runtime(runtime, metadata):
+    """Check the actual credential/transport, not only manifest labels."""
+    from hermes_cli.auth import DEFAULT_CODEX_BASE_URL, DEFAULT_XAI_OAUTH_BASE_URL
+    from utils import base_url_hostname
+
+    if runtime.get("provider") != metadata["selected_provider"] or not runtime.get("api_key"):
+        raise ModelRoutingError("Class route resolved to a different provider or an empty credential")
+    if metadata["billing_group"] != "subscription":
+        return
+    pool = runtime.get("credential_pool")
+    entry = pool.current() if pool else None
+    if entry is None or entry.auth_type != "oauth":
+        raise ModelRoutingError("Subscription routing requires an OAuth credential, never a paid API key")
+    expected = {
+        "anthropic": ("api.anthropic.com", "anthropic_messages"),
+        "openai-codex": (base_url_hostname(DEFAULT_CODEX_BASE_URL), "codex_responses"),
+        "xai-oauth": (base_url_hostname(DEFAULT_XAI_OAUTH_BASE_URL), "codex_responses"),
+    }
+    host, mode = expected[metadata["selected_provider"]]
+    if base_url_hostname(runtime.get("base_url", "")) != host or runtime.get("api_mode") != mode:
+        raise ModelRoutingError("Subscription route requires its native provider endpoint and protocol")
+    if metadata["selected_provider"] == "anthropic" and not runtime["api_key"].startswith("sk-ant-oat"):
+        raise ModelRoutingError("Anthropic subscription route requires its native OAuth token")
diff --git a/agent/model_routing_state.py b/agent/model_routing_state.py
new file mode 100644
index 0000000000..9097e724af
--- /dev/null
+++ b/agent/model_routing_state.py
@@ -0,0 +1,82 @@
+"""Process-safe provider allocation and session lineage (no credentials or prompts)."""
+from __future__ import annotations
+
+import json
+import sqlite3
+from contextlib import closing
+from pathlib import Path
+
+
+class RoutingState:
+    def __init__(self, path):
+        self.path = Path(path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+
+    def allocate(self, session_id, parent_session_id, level, candidates, version, excluded):
+        """Allocate and persist atomically; aliases share one failover decision."""
+        with closing(sqlite3.connect(self.path, timeout=30, isolation_level=None)) as db:
+            db.execute("PRAGMA busy_timeout=30000")
+            db.execute("CREATE TABLE IF NOT EXISTS aliases (session TEXT PRIMARY KEY, root TEXT NOT NULL)")
+            db.execute("CREATE TABLE IF NOT EXISTS routes (root TEXT, class TEXT, metadata TEXT NOT NULL, "
+                       "PRIMARY KEY(root, class))")
+            db.execute("CREATE TABLE IF NOT EXISTS counters (pool TEXT PRIMARY KEY, position INTEGER NOT NULL)")
+            db.execute("BEGIN IMMEDIATE")
+            try:
+                result = self._allocate(db, session_id, parent_session_id, level, candidates, version, excluded)
+                db.execute("COMMIT")
+                return result
+            except BaseException:
+                db.execute("ROLLBACK")
+                raise
+
+    def _allocate(self, db, session, parent, level, candidates, version, excluded):
+        from agent.model_routing import ModelRoutingError
+
+        root = self._root(db, session, parent)
+        row = db.execute("SELECT metadata FROM routes WHERE root=? AND class=?", (root, level)).fetchone()
+        if row:
+            previous = json.loads(row[0])
+            identity = previous["selected_provider"], previous["selected_model"]
+            allowed = any((r["provider"], r["model"]) == identity and
+                          r["billing"] == previous["billing_group"] for r in candidates)
+            if identity not in excluded:
+                if not allowed:
+                    raise ModelRoutingError("Sticky route is no longer eligible; explicit failure selection required")
+                return previous
+        if not candidates:
+            raise ModelRoutingError(f"No eligible {level} routes under billing/capability policy")
+        route = self._choose(db, level, candidates, version)
+        metadata = {"requested_class": level, "policy_version": version,
+                    "selected_provider": route["provider"], "selected_model": route["model"],
+                    "billing_group": route["billing"], "reason": "same-class-failover" if row else "allocation"}
+        db.execute("INSERT OR REPLACE INTO routes VALUES (?, ?, ?)", (root, level, json.dumps(metadata)))
+        return metadata
+
+    @staticmethod
+    def _root(db, session, parent):
+        row = db.execute("SELECT root FROM aliases WHERE session=?", (session,)).fetchone()
+        if row:
+            return row[0]
+        root = session
+        if parent:
+            row = db.execute("SELECT root FROM aliases WHERE session=?", (parent,)).fetchone()
+            root = row[0] if row else parent
+            db.execute("INSERT OR IGNORE INTO aliases VALUES (?, ?)", (parent, root))
+        db.execute("INSERT INTO aliases VALUES (?, ?)", (session, root))
+        return root
+
+    @staticmethod
+    def _choose(db, level, candidates, version):
+        # Provider weights, not route/account counts, determine traffic share.
+        subscriptions = [r for r in candidates if r["billing"] == "subscription"]
+        candidates = subscriptions or candidates
+        groups = {}
+        for route in candidates:
+            groups.setdefault(route["provider"], []).append(route)
+        cycle = [p for p in sorted(groups) for _ in range(groups[p][0]["weight"])]
+        pool = json.dumps([version, level, [(p, groups[p][0]["weight"]) for p in sorted(groups)]])
+        row = db.execute("SELECT position FROM counters WHERE pool=?", (pool,)).fetchone()
+        position = row[0] if row else 0
+        provider = cycle[position % len(cycle)]
+        db.execute("INSERT OR REPLACE INTO counters VALUES (?, ?)", (pool, position + 1))
+        return sorted(groups[provider], key=lambda r: r["model"])[0]
