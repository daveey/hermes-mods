From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 17:15:33 +0000
Subject: [PATCH] [daveey] worker_resources_unknown alarm: read its streak file
 utf-8-sig

---
 hermes_cli/worker_resources_unknown_alarm.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hermes_cli/worker_resources_unknown_alarm.py b/hermes_cli/worker_resources_unknown_alarm.py
index 6e49a9d44a..cfae740720 100644
--- a/hermes_cli/worker_resources_unknown_alarm.py
+++ b/hermes_cli/worker_resources_unknown_alarm.py
@@ -50,7 +50,7 @@ def record_for(exc: Optional[BaseException]) -> Optional[str]:
 
 def read() -> Optional[dict[str, Any]]:
     try:
-        state = json.loads(_path().read_text(encoding="utf-8"))
+        state = json.loads(_path().read_text(encoding="utf-8-sig"))
     except (OSError, ValueError):
         return None
     return state if isinstance(state, dict) and isinstance(state.get("since"), (int, float)) else None
