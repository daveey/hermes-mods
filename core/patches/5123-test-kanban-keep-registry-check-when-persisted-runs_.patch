From 7082111924d4a4955216e2f634ee5b882b390c14 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 09:45:01 +0000
Subject: [PATCH] test(kanban): keep registry check when persisted runs_on is
 malformed [daveey]

Cover unparseable and non-list persisted runs_on in preflight: {not json,
truncated list, JSON object, JSON string, and null. Each still yields
no_capability_holder against an empty registry.

Proof: ValueError fail-open mutant (all ACCESS_LABELS) fails 2 cases;
dict-as-labels mutant fails the JSON object case; restored declared-access
suite 47 passed.

Addresses review 5990402273.
---
 .../hermes_cli/test_kanban_declared_access.py | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_declared_access.py b/tests/hermes_cli/test_kanban_declared_access.py
index acd859818b..29f3a044d1 100644
--- a/tests/hermes_cli/test_kanban_declared_access.py
+++ b/tests/hermes_cli/test_kanban_declared_access.py
@@ -168,6 +168,32 @@ def test_preflight_reads_persisted_access_labels(conn, monkeypatch, requirement,
     assert unchanged is not None and unchanged.status == "ready"
 
 
+@pytest.mark.parametrize("raw", [
+    "{not json",
+    '["capability:hub-read"',
+    '{"capability:hub-read": 1}',
+    '"capability:hub-read"',
+    "null",
+])
+def test_preflight_malformed_runs_on_keeps_registry_check(conn, monkeypatch, raw):
+    from hermes_cli import kanban_capability_routing as routing
+
+    tid = kb.create_task(conn, title="Check declared access", assignee="default",
+                         requires=["terminal", "hub:read"])
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET placement_policy=NULL, runs_on=? WHERE id=?", (raw, tid))
+    task = kb.get_task(conn, tid)
+    assert task is not None
+    assert not hasattr(task, "runs_on")
+    assert task.placement_policy is None
+    monkeypatch.setattr(routing, "has_replica", lambda: True)
+    result = routing.preflight(conn, tid, self_gw="hub", local={}, remote={})
+    assert result is not None, raw
+    assert result["code"] == "no_capability_holder", result
+    unchanged = kb.get_task(conn, tid)
+    assert unchanged is not None and unchanged.status == "ready"
+
+
 @pytest.mark.parametrize("requirement", ["hub:read", "hub:write", "ssh:mini", "ssh:mbp"])
 def test_preflight_keeps_access_needs_without_sync_schema(tmp_path, monkeypatch, requirement):
     from hermes_cli import kanban_capability_routing as routing
