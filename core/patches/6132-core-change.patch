diff --git a/hermes_cli/kanban_actionability_creation.py b/hermes_cli/kanban_actionability_creation.py
new file mode 100644
index 00000000000..d8b89a07f93
--- /dev/null
+++ b/hermes_cli/kanban_actionability_creation.py
@@ -0,0 +1,88 @@
+"""Creation-time administrative policy, never execution or release authority. [daveey]"""
+from __future__ import annotations
+
+import json
+
+from hermes_cli.kanban_actionability import owner, positive_time, project, valid_awaiting
+
+
+def _text(value):
+    return value if isinstance(value, str) and value.strip() else None
+
+
+def intent_for(task, kind, payload, *, now):
+    """Derive once from source clocks; the same pure function verifies recorded intent."""
+    if not isinstance(payload, dict):
+        return None
+    timed = kind == 'scheduled' or (kind == 'continued' and payload.get('status') == 'scheduled')
+    if not timed and kind not in ('blocked', 'dependency_wait'):
+        return None
+    status = 'scheduled' if timed else ('todo' if kind == 'dependency_wait' or payload.get('kind') == 'assignment' else 'blocked')
+    if task.get('status') != status:
+        return None
+    wake = positive_time(payload.get('wake_at')) if timed else None
+    deadline = wake + 600 if wake else (now + 86400 if not timed else None)
+    human = payload.get('human_request')
+    human = _text(human.get('action')) if isinstance(human, dict) else None
+    parents = payload.get('actionability_parent_ids') or []
+    dependencies = [{'task_id': pid, 'status': None, 'trigger': f'Observe the existing dependency {pid} through authenticated lifecycle gates'}
+                    for pid in parents] if isinstance(parents, list) and all(_text(pid) for pid in parents) else []
+    reason = None
+    if owner(task.get('assignee'))['kind'] == 'unavailable':
+        reason = 'owner_missing'
+    elif timed and not wake:
+        reason = 'wake_invalid'
+    elif timed and not valid_awaiting(payload.get('awaiting')):
+        reason = 'producer_malformed'
+    elif deadline is None or deadline <= now:
+        reason = 'deadline_not_future'
+    elif (timed and not (payload.get('awaiting') or _text(payload.get('wake_check')))) or (not timed and not human and not dependencies):
+        reason = 'trigger_missing'
+    row = project({'task': task, 'source_at': now, 'wake_at': wake,
+                   'deadline_at': deadline, 'human_step': human, 'dependencies': dependencies,
+                   'awaiting': payload.get('awaiting'), 'probe': _text(payload.get('wake_check'))}, now=now)
+    return {'version': 1, 'policy': 'scheduled-wake-grace-v1' if timed else 'blocked-admin-review-v1',
+            'status': status, 'source_kind': kind, 'owner': row['owner'],
+            'action': row['action'], 'instruction': row['instruction'], 'blocker': row['blocker'],
+            'first_observed': now, 'wake_at': wake, 'deadline_at': None if reason else deadline,
+            'invalid_reason': reason, 'execution_authority': False}
+
+
+def stamp(conn, task_id, kind, payload, *, now):
+    """Freeze ordinary administrative policy with the actual source event clock."""
+    if kind not in ('scheduled', 'blocked', 'continued', 'dependency_wait'):
+        return payload
+    original = payload
+    row = conn.execute('SELECT * FROM tasks WHERE id=?', (task_id,)).fetchone()
+    if isinstance(payload, dict):
+        from hermes_cli.kanban_db_sync import run_uid
+        from hermes_cli.kanban_actionability_parents import snapshot
+        parents = [r[0] for r in conn.execute('SELECT parent_id FROM task_links WHERE child_id=? ORDER BY parent_id', (task_id,))]
+        payload = {**payload, 'actionability_parent_ids': parents,
+                   'actionability_parent_states': snapshot(conn, parents),
+                   'actionability_run_uid': run_uid(conn, row['current_run_id']) if row else None}
+    intent = intent_for(dict(row), kind, payload, now=now) if row else None
+    return {**payload, 'actionability_intent': intent} if intent is not None else original
+
+
+def validated_intent(task, source, *, parent_ids=None):
+    """Return exactly supported source-bound bytes, not coercively equal malformed data."""
+    data = source['data']
+    if parent_ids is not None and data.get('actionability_parent_ids') != parent_ids:
+        return None
+    human = task.get('human_request')
+    if isinstance(human, str):
+        try:
+            human = json.loads(human)
+        except ValueError:
+            return None
+    if (data.get('human_request') or None) != (human or None):
+        return None
+    intent = data.get('actionability_intent')
+    expected = intent_for(task, source['kind'], data, now=source['created_at'])
+    # JSON comparison distinguishes True/1 and 1/1.0; unknown fields/policies fail closed.
+    if expected is None or expected['invalid_reason'] or not isinstance(intent, dict):
+        return None
+    if json.dumps(intent, sort_keys=True) != json.dumps(expected, sort_keys=True):
+        return None
+    return intent
diff --git a/hermes_cli/kanban_actionability_intents.py b/hermes_cli/kanban_actionability_intents.py
new file mode 100644
index 00000000000..e5e7dd351be
--- /dev/null
+++ b/hermes_cli/kanban_actionability_intents.py
@@ -0,0 +1,61 @@
+"""Local original-source custody; metadata grants no execution authority. [daveey]"""
+from __future__ import annotations
+
+import json
+
+from hermes_cli import kanban_db_sync as sync
+
+
+def materialize(conn, hub, board):
+    """Defer canonical work until the successful home sync round, outside writers."""
+    from hermes_cli.kanban_actionability_materialize import run
+    run(conn, hub, board)
+
+
+def ensure_schema(conn):
+    conn.execute('CREATE TABLE IF NOT EXISTS kanban_actionability_intents ('
+                 'event_uid TEXT PRIMARY KEY, task_id TEXT NOT NULL, source_json TEXT NOT NULL, '
+                 'source_kind TEXT NOT NULL, source_at INTEGER NOT NULL, deadline_at INTEGER, '
+                 "state TEXT NOT NULL DEFAULT 'pending', reason TEXT, op_id TEXT, last_checked_at INTEGER NOT NULL DEFAULT 0)")
+
+
+def capture(conn, event_uid):
+    """Insert only new stamped home events, atomically with append/import; no network."""
+    if sync.board_mode(conn) != 'primary' or not event_uid:
+        return
+    state = sync.sync_state(conn) or {}
+    source = conn.execute('SELECT e.*, t.created_on, t.sync_version FROM task_events e JOIN tasks t ON t.id=e.task_id WHERE e.uid=?',
+                          (event_uid,)).fetchone()
+    if source is None:
+        return
+    gateway = state.get('gateway_id')
+    local_insert = (source['created_on'] is None and source['sync_version'] in (None, 0)
+                    and not state.get('applying') and isinstance(gateway, str) and bool(gateway.strip())
+                    and conn.execute("SELECT 1 FROM kanban_sync_outbox WHERE table_name='task_events' AND row_uid=? "
+                                     "AND op='upsert' AND state='pending'", (event_uid,)).fetchone() is not None)
+    # Local pre-ACK custody is not proof of home: canonical observation still owns that check.
+    if not local_insert and (not source['created_on'] or source['created_on'] != gateway):
+        return
+    try:
+        data = json.loads(source['payload'] or '{}')
+    except (ValueError, TypeError):
+        return
+    intent = data.get('actionability_intent') if isinstance(data, dict) else None
+    if not isinstance(intent, dict) or type(intent.get('version')) is not int or intent['version'] != 1:
+        return
+    from hermes_cli.kanban_actionability_creation import intent_for
+    recorded_owner = intent.get('owner')
+    refs = recorded_owner.get('refs') if isinstance(recorded_owner, dict) else None
+    assignee = refs[0] if isinstance(refs, list) and len(refs) == 1 else None
+    expected = intent_for({'id': source['task_id'], 'status': intent.get('status'), 'assignee': assignee}, source['kind'],
+                          data, now=source['created_at'])
+    valid = expected is not None and json.dumps(expected, sort_keys=True) == json.dumps(intent, sort_keys=True)
+    reason = expected.get('invalid_reason') if valid else 'creation_intent_invalid'
+    deadline = expected['deadline_at'] if valid and not reason else None
+    if not conn.in_transaction:
+        raise ValueError('source intent capture requires source write transaction')
+    ensure_schema(conn)
+    conn.execute('INSERT OR IGNORE INTO kanban_actionability_intents '
+                 '(event_uid,task_id,source_json,source_kind,source_at,deadline_at,state,reason) VALUES (?,?,?,?,?,?,?,?)',
+                 (event_uid, source['task_id'], source['payload'], source['kind'], source['created_at'],
+                  deadline, 'invalid' if reason else 'pending', reason))
diff --git a/hermes_cli/kanban_actionability_materialize.py b/hermes_cli/kanban_actionability_materialize.py
new file mode 100644
index 00000000000..bc1a1e2916f
--- /dev/null
+++ b/hermes_cli/kanban_actionability_materialize.py
@@ -0,0 +1,97 @@
+"""Bounded home-only original-intent delivery; no escalation or lifecycle authority. [daveey]"""
+from __future__ import annotations
+
+import json
+
+from hermes_cli import kanban_actionability_creation as creation
+from hermes_cli import kanban_actionability_observation as observation
+from hermes_cli import kanban_actionability_recovery as recovery
+from hermes_cli import kanban_actionability_transport as transport
+from hermes_cli import kanban_db_sync as sync
+from hermes_cli.kanban_db_connect import write_txn
+
+
+class StaleIntent(ValueError):
+    """A positively observed source mismatch, not an unavailable observation."""
+
+
+def _payload(conn, hub, board, row):
+    if not callable(getattr(hub, '_call', None)):
+        raise ValueError('canonical execution inventory transport unavailable')
+    source = observation.observe(hub, board, row['task_id'], include_source=True)
+    event, task = source['source_event'], source['source_task']
+    if not isinstance(event.get('payload'), str):
+        raise ValueError('canonical original source payload unavailable')
+    if event['uid'] != row['event_uid'] and row['source_kind'] == 'dependency_wait':
+        raise ValueError('canonical dependency source unavailable')
+    if (task['containment_episode'] or event['uid'] != row['event_uid']
+            or event['kind'] != row['source_kind'] or event['created_at'] != row['source_at']
+            or event.get('payload') != row['source_json'] or event['version'] != 1):
+        raise StaleIntent('original source identity/status/run changed')
+    data = json.loads(row['source_json'])
+    if 'actionability_run_uid' not in data or data['actionability_run_uid'] != task['current_run_uid']:
+        raise StaleIntent('original source run changed')
+    from hermes_cli.kanban_actionability_sources import Reader
+    if Reader(conn).pending(row['task_id']):
+        raise ValueError('unresolved retain custody; administrative obligation remains pending')
+    parents = [p['id'] for p in source['facts']['dependencies']]
+    intent = creation.validated_intent(task, {'kind': event['kind'], 'created_at': event['created_at'], 'data': data},
+                                       parent_ids=parents)
+    if intent is None or intent['deadline_at'] != row['deadline_at']:
+        raise StaleIntent('original owner/trigger/deadline/graph changed')
+    from hermes_cli.kanban_actionability_parents import check
+    check(data.get('actionability_parent_states'), source['raw_parent_states'])
+    cap = transport.capability(hub, board)
+    return recovery._payload(source, owner=intent['owner'], action=intent['action'],
+                             instruction=intent['instruction'], prerequisite=intent['blocker']['prerequisite'],
+                             trigger=intent['blocker']['trigger'], evidence=[row['event_uid']],
+                             deadline_at=intent['deadline_at'], now=int(cap['hlc'][:13]) // 1000)
+
+
+def _set(conn, row, state, reason=None):
+    with write_txn(conn):
+        conn.execute('UPDATE kanban_actionability_intents SET state=?,reason=? WHERE event_uid=? AND state=? AND op_id IS ?',
+                     (state, reason, row['event_uid'], row['state'], row['op_id']))
+
+
+def run(conn, hub, board):
+    """One rotating eight-source window; uncertain reservations never rederive."""
+    from hermes_cli.kanban_sync_client import HubError
+    if conn.in_transaction or sync.board_mode(conn) != 'primary':
+        return
+    state = sync.sync_state(conn) or {}
+    if state.get('board_id') != board or state.get('gateway_id') != hub.ident.gateway:
+        return
+    if not conn.execute("SELECT 1 FROM sqlite_master WHERE name='kanban_actionability_intents'").fetchone():
+        return
+    with write_txn(conn):
+        rows = [dict(r) for r in conn.execute('SELECT * FROM kanban_actionability_intents '
+                "WHERE state IN ('pending','reserved') ORDER BY last_checked_at,event_uid LIMIT 8")]
+        conn.executemany(f'UPDATE kanban_actionability_intents SET last_checked_at={sync._NOW_MS_SQL} WHERE event_uid=?',
+                         [(r['event_uid'],) for r in rows])
+    for row in rows:
+        uid = row['event_uid']
+        try:
+            if row['state'] == 'pending':
+                payload = _payload(conn, hub, board, row)
+                with write_txn(conn):
+                    current = conn.execute('SELECT * FROM kanban_actionability_intents WHERE event_uid=?', (uid,)).fetchone()
+                    if (current['state'] != 'pending' or current['source_json'] != row['source_json']
+                            or current['deadline_at'] != row['deadline_at']):
+                        raise ValueError('intent custody changed during canonical observation')
+                    command = transport.reserve(conn, row['task_id'], payload)
+                    conn.execute("UPDATE kanban_actionability_intents SET state='reserved',op_id=?,reason=NULL WHERE event_uid=?",
+                                 (command['op_id'], uid))
+                    row['op_id'] = command['op_id']
+                    row['state'] = 'reserved'
+            command = transport.command(conn, row['op_id'])
+            if command and command['delivery_state'] == 'rejected':
+                _set(conn, row, 'rejected', 'canonical request rejected')
+                continue
+            if not command or command['delivery_state'] != 'confirmed':
+                transport.confirm(conn, hub, board, row['op_id'])
+            _set(conn, row, 'confirmed')
+        except StaleIntent as exc:
+            _set(conn, row, 'stale', str(exc))
+        except (ValueError, KeyError, TypeError, OSError, HubError) as exc:
+            _set(conn, row, row['state'], str(exc)[:500])
