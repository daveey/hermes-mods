From 3b0a387343818ce612eb3d372e9a2129a2c417a7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:11:18 +0000
Subject: [PATCH] fix(cron): retain computed commands in substitution bodies
 [daveey]

Address independent review: walk executed substitution bodies with original executable-word provenance, and mask arithmetic only when the matching span closes with double parentheses. Bash otherwise reparses the opener as nested subshells. Five additional harmless real-Bash RUN cases fail before this fix and pass after; five corresponding clean twins stay allowed. All 68 cron lifecycle consumer files pass (10450 plus 76 tests); scripts/check passes.
---
 cron/lifecycle_guard_computed.py              | 22 ++++++++++++++-----
 .../test_lifecycle_guard_computed_commands.py | 10 +++++++++
 2 files changed, 26 insertions(+), 6 deletions(-)

diff --git a/cron/lifecycle_guard_computed.py b/cron/lifecycle_guard_computed.py
index 28aef3b3daebf1824c0f8e7519b82589dc3051fc..8f21d330634b05a2515712df9de0a1263b3f5ab9 100644
--- a/cron/lifecycle_guard_computed.py
+++ b/cron/lifecycle_guard_computed.py
@@ -117,14 +117,16 @@ def _opaque_expansions(text, bindings):
             continue
         if quote != "'" and text.startswith('$((', index):
             end = _paren_end(text, index)
-            out.append('0')  # Arithmetic output cannot name a lifecycle executable.
-            index = end
-            continue
+            if text[index:end].endswith('))'):
+                out.append('0')  # Arithmetic output cannot name a lifecycle executable.
+                index = end
+                continue
         if not quote and text.startswith('((', index):
             end = index + _paren_end('$' + text[index:], 0) - 1
-            out.append(':')  # Arithmetic command contents are not executable words.
-            index = end
-            continue
+            if text[index:end].endswith('))'):
+                out.append(':')  # Only a closed arithmetic command is opaque.
+                index = end
+                continue
         if quote != "'" and (span := _expansion(text, index, bool(quote), bindings)):
             marker = f'{_MARKER}{len(expansions)}z'
             expansions[marker] = span
@@ -169,6 +171,14 @@ def scan_computed_commands(command, *, cwd, executed, variable_source, budget, r
         budget.variable_candidates.computed_producer_shadow = True
     if not any(s in command for s in ('${', '$(', '`')):
         return False
+    from cron.lifecycle_guard_substitutions import separate_substitutions
+
+    # Bodies execute even when their output is an assignment or data argument.
+    # Keep their original syntax/provenance; flattened token recovery loses it.
+    _, bodies = separate_substitutions(command)
+    for body in bodies:
+        if recurse(body, cwd, True, source):
+            return True
     opaque, expansions = _opaque_expansions(command, budget.variable_candidates.values)
     for segment in _structural_segments(opaque):
         words = segment[guard._peel_reserved_words(segment):]
diff --git a/tests/cron/test_lifecycle_guard_computed_commands.py b/tests/cron/test_lifecycle_guard_computed_commands.py
index 5bb60cb9d7b2edc2b1b334edce745f801f8b0926..9f6f465db777e1c30f185d22714b34576aa8dad7 100644
--- a/tests/cron/test_lifecycle_guard_computed_commands.py
+++ b/tests/cron/test_lifecycle_guard_computed_commands.py
@@ -8,6 +8,11 @@ from cron.lifecycle_guard import scan_gateway_lifecycle
 
 
 RUN = [
+    'x=$(${x:-hermes} gateway restart)',
+    'echo `${x:-hermes} gateway restart`',
+    'echo "$(echo "$(${x:-bash} ./r.sh)")"',
+    '((${x:-hermes} gateway restart); true)',
+    'echo $(( ${x:-hermes} gateway restart); true)',
     '${x:-hermes gateway restart}',
     '${x:-hermes} gateway restart',
     '$(echo hermes) gateway restart',
@@ -28,6 +33,11 @@ RUN = [
     '. ./producer.sh; $(echo echo) gateway restart',
 ]
 CLEAN = [
+    'x=$(${x:-echo} hi)',
+    'echo `${x:-echo} hi`',
+    'echo "$(echo "$(${x:-bash} ./clean.sh)")"',
+    '((${x:-echo} hi); true)',
+    'echo $(( ${x:-echo} hi); true)',
     '${x:-echo} hi',
     '$(echo echo) hi',
     '$(printf %s echo) hi',
-- 
