From a7c1f439c34de91661b5d30650c0fe1854f5fc58 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 12:52:20 -0800
Subject: [PATCH] fix(outcome): recognize completed silent cron runs [daveey]

---
 hermes_state_outcome.py                    | 10 ++++-
 tests/hermes_state/test_session_outcome.py | 47 ++++++++++++++++++++++
 2 files changed, 56 insertions(+), 1 deletion(-)

diff --git a/hermes_state_outcome.py b/hermes_state_outcome.py
index db55d359509..e019ed86171 100644
--- a/hermes_state_outcome.py
+++ b/hermes_state_outcome.py
@@ -198,7 +198,7 @@ def _parse(raw: Any) -> Optional[dict[str, Any]]:
 
 
 def _row(db: Any, sid: str) -> Optional[dict[str, Any]]:
-    row = db._read_one("SELECT id, source, outcome_json, outcome_at, muted FROM sessions WHERE id = ?", (sid,))
+    row = db._read_one("SELECT id, source, end_reason, outcome_json, outcome_at, muted FROM sessions WHERE id = ?", (sid,))
     return dict(row) if row is not None else None
 
 
@@ -531,6 +531,14 @@ def _derive(db: Any, sid: str, *, ignore_live_turn: bool = False,
     if reason:
         return _outcome("unresolved", now, reason=reason, **carry)
     text = _text(tail[0].get("content"))
+    # Cron's successful no-news protocol deliberately has no prose summary. Respect that
+    # terminal receipt, but not a marker in an unfinished/failed run or a pending reply.
+    # Keep this after live work, notices and failure checks: silence cannot erase obligations.
+    if pending_reply is None and row.get("source") == "cron" and row.get("end_reason") == "cron_complete":
+        from gateway.response_filters import is_intentional_silence_response
+
+        if is_intentional_silence_response(text):
+            return _outcome("done", now, summary="Scheduled run completed with nothing to report.", **named, **carry)
     msg_id = tail[0].get("id")
     verdict = _judge_summary(sid, text, row.get("source"))
     if verdict is None:
diff --git a/tests/hermes_state/test_session_outcome.py b/tests/hermes_state/test_session_outcome.py
index ba06cdd3215..e335bb2cd9a 100644
--- a/tests/hermes_state/test_session_outcome.py
+++ b/tests/hermes_state/test_session_outcome.py
@@ -211,6 +211,53 @@ def test_7_summary_is_done_otherwise_no_summary(db):
     assert so.refresh_outcome("chat", "turn_end", db=db)["reason"] == "no_summary"
 
 
+@pytest.mark.parametrize("marker", ["[SILENT]", "NO_REPLY", " SILENT "])
+def test_completed_silent_cron_is_done_without_a_judge(db, marker):
+    db._write_rowcount("UPDATE sessions SET source='cron', end_reason='cron_complete' WHERE id='chat'", ())
+    turn(db, marker)
+    out = so.refresh_outcome("chat", "manual", db=db)
+    assert out["kind"] == "done"
+    assert out["summary"] == "Scheduled run completed with nothing to report."
+    assert so.get_outcome("chat", db=db) == out
+
+
+@pytest.mark.parametrize("source, end_reason", [
+    ("desktop", "cron_complete"), ("cron", None), ("cron", "cron_incomplete_no_output"),
+])
+def test_silence_alone_does_not_prove_cron_completion(db, source, end_reason):
+    db._write_rowcount("UPDATE sessions SET source=?, end_reason=? WHERE id='chat'", (source, end_reason))
+    turn(db, "[SILENT]")
+    assert so.refresh_outcome("chat", "manual", db=db)["reason"] == "no_summary"
+
+
+@pytest.mark.parametrize("role, text, kw, expected", [
+    ("assistant", "[SILENT]", {"finish_reason": "error"}, "turn_failed"),
+    ("user", "card completed", {"display_kind": "kanban_notice"}, "notice_tail"),
+    ("tool", "result", {"tool_name": "terminal", "tool_call_id": "c1"}, "interrupted"),
+])
+def test_completed_silent_cron_preserves_tail_errors(db, role, text, kw, expected):
+    db._write_rowcount("UPDATE sessions SET source='cron', end_reason='cron_complete' WHERE id='chat'", ())
+    turn(db, "[SILENT]")
+    say(db, role, text, **kw)
+    assert so.refresh_outcome("chat", "manual", db=db)["reason"] == expected
+
+
+@pytest.mark.parametrize("status, human_request, expected", [
+    ("running", None, "waiting"), ("blocked", HUMAN_REQUEST, "decision"),
+])
+def test_completed_silent_cron_preserves_live_work(db, board, status, human_request, expected):
+    db._write_rowcount("UPDATE sessions SET source='cron', end_reason='cron_complete' WHERE id='chat'", ())
+    turn(db, "[SILENT]")
+    add_card(board, "t_work", "chat", status, human_request)
+    assert so.refresh_outcome("chat", "manual", db=db)["kind"] == expected
+
+
+def test_pending_silence_does_not_reuse_old_cron_completion(db):
+    db._write_rowcount("UPDATE sessions SET source='cron', end_reason='cron_complete' WHERE id='chat'", ())
+    turn(db, "[SILENT]")
+    assert so.derive_outcome("chat", db=db, pending_reply="[SILENT]")["reason"] == "no_summary"
+
+
 def test_7_pending_reply_is_judged_instead_of_the_saved_tail(db):
     turn(db, "Let me look at the logs next.")
     assert so.derive_outcome("chat", db=db)["reason"] == "no_summary"
-- 
