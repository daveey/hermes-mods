From b9486154971001d85d0d9a3c18d86112ad8e1089 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 04:32:27 -0700
Subject: [PATCH] fix(desktop): an env-pinned remote client never spawns a
 local backend for the registry's 'local' primary [daveey]

HERMES_DESKTOP_REMOTE_URL pins the app to a remote but never enters the
connections registry, so 'local' stays the registry primary and every
primary-routed renderer call arrives as an explicit 'local'. The hub-sync
replica read (~0.3 s after boot) was the first: ensureRegistryBackend forced
a genuinely local child for it (globalRemote branch), the published local
route then pulled the window's REST traffic onto that child, and e2e
remote-topology failed 'the client spawned no backend of its own'.

With the env pin and 'local' as primary, the local entry IS the primary and
delegates to the v1 route (the env remote). Migrated v1-remote users (remote
is the registry primary) still force-local 'This device'.

Proof: remote-topology.spec.ts in the CI runner image: fails before (local
'--profile default serve' child, first dial /api/plugins/hub-sync/sessions
conn=local), passes after with no client backend.
---
 .../electron/connection-registry.test.ts        | 17 +++++++++++++++++
 apps/desktop/electron/connection-registry.ts    | 17 ++++++++++++++++-
 apps/desktop/electron/main.ts                   |  2 ++
 3 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/electron/connection-registry.test.ts b/apps/desktop/electron/connection-registry.test.ts
index a3095aa474..9b75ccdc27 100644
--- a/apps/desktop/electron/connection-registry.test.ts
+++ b/apps/desktop/electron/connection-registry.test.ts
@@ -785,6 +785,23 @@ test('registry local route: v1 REMOTE global mode forces a genuinely-local backe
   assert.notEqual(route.poolKey, backendScopeKey(LOCAL_CONNECTION_ID, 'default'))
 })
 
+test('registry local route: the env remote pins the app while local is still the registry primary', () => {
+  // HERMES_DESKTOP_REMOTE_URL never enters the registry, so 'local' stays its primary and every primary-routed
+  // renderer call (hub-sync replica, config, sidebar) arrives as an explicit 'local'. Forcing a local child for it
+  // spawned a backend on a client the env pinned to a remote (e2e remote-topology: "the client spawned no backend").
+  assert.deepEqual(resolveRegistryLocalRoute('default', { envRemotePrimary: true, globalRemote: true }), {
+    delegate: true,
+    poolKey: 'default'
+  })
+  assert.deepEqual(resolveRegistryLocalRoute(null, { envRemotePrimary: true, globalRemote: true }), {
+    delegate: true,
+    poolKey: 'default'
+  })
+  // Control: without the env pin (a migrated v1-remote user, remote is the registry primary) 'local' still
+  // forces a genuinely local child.
+  assert.equal(resolveRegistryLocalRoute('default', { envRemotePrimary: false, globalRemote: true }).delegate, false)
+})
+
 test('registry local route: a per-profile remote override delegates to the override (#90477)', () => {
   // The per-profile SSH/remote override is the authoritative route for that
   // profile. Forcing local here made the roster list the profile via its
diff --git a/apps/desktop/electron/connection-registry.ts b/apps/desktop/electron/connection-registry.ts
index a07c672e96..7a314bbc2e 100644
--- a/apps/desktop/electron/connection-registry.ts
+++ b/apps/desktop/electron/connection-registry.ts
@@ -531,12 +531,27 @@ function normalizedSshTarget(route: { host?: unknown; port?: unknown; user?: unk
  */
 export function resolveRegistryLocalRoute(
   profile: null | string | undefined,
-  opts: { globalRemote?: boolean; localProfileExists?: boolean; profileRemoteOverride?: boolean } = {}
+  opts: {
+    /** HERMES_DESKTOP_REMOTE_URL pins the app to a remote while the registry's primary is still 'local'. */
+    envRemotePrimary?: boolean
+    globalRemote?: boolean
+    localProfileExists?: boolean
+    profileRemoteOverride?: boolean
+  } = {}
 ): RegistryLocalRoute {
   const raw = String(profile ?? '').trim()
   const profileKey = raw || 'default'
   const concrete = raw.length > 0
 
+  // [daveey] The env override applies app-wide and never enters the registry, so the 'local' entry stays the
+  // registry primary: every renderer call routed to the primary arrives here as an explicit 'local' (the hub-sync
+  // replica read is the first, ~0.3 s after boot). Forcing a local child for it spawned a backend on a client the env
+  // had pinned to a remote, and the published local route then pulled the window's REST traffic onto that child.
+  // In that setup 'local' IS the primary, so it follows the v1 route to the env remote.
+  if (opts.envRemotePrimary) {
+    return { delegate: true, poolKey: profileKey }
+  }
+
   // A per-profile SSH/remote override is an explicit per-profile routing
   // decision: the override owns this profile's backend, so the 'local' entry
   // must delegate to the legacy profile route (which resolves the override),
diff --git a/apps/desktop/electron/main.ts b/apps/desktop/electron/main.ts
index 540282dae4..ea94dc2220 100644
--- a/apps/desktop/electron/main.ts
+++ b/apps/desktop/electron/main.ts
@@ -187,6 +187,7 @@ import {
   buildAgentRoster,
   connectionDialFieldsChanged,
   connectionIdForPendingLogin,
+  LOCAL_CONNECTION_ID,
   mergeConnectionInput,
   migrateV1ToRegistry,
   normalizeConnectionInput,
@@ -11244,6 +11245,7 @@ async function ensureRegistryBackend(
     // Pass the raw profile, not profileKey: profileKey collapses null to
     // 'default' and would refuse an unprofiled enumeration as a concrete dial.
     const localRoute = resolveRegistryLocalRoute(rawProfile || null, {
+      envRemotePrimary: Boolean(process.env.HERMES_DESKTOP_REMOTE_URL) && registry.primary === LOCAL_CONNECTION_ID,
       globalRemote: globalRemoteActive(),
       profileRemoteOverride: Boolean(profileHasRemoteOverride(profileKey)),
       ...(rawProfile ? { localProfileExists } : {})
