   expect(copy.body).toContain('OpenCode Go could not be reached')
 })
+
+it('names the machine holding a chat that is open somewhere else', () => {
+  const surface = sessionNotOwnedSurface(
+    'This chat is open in another Hermes window/terminal. Use it there, or start a new chat here.\n' +
+      'Details: session 20261013_205237_240fcc opened by desktop on davids-mac-mini-1 4m ago.'
+  )
+
+  expect(surface.owner).toEqual({ age: '4m', host: 'davids-mac-mini-1', surface: 'desktop' })
+
+  const copy = errorCardText(TRANSLATIONS.en.assistant.thread, surface)
+
+  expect(copy.title).toBe('This chat is open somewhere else')
+  expect(copy.body).toContain('Hermes desktop on davids-mac-mini-1 (opened 4m ago)')
+})
+
+it('keeps the generic owner copy for an older backend that names no machine', () => {
+  const surface = sessionNotOwnedSurface('x\nDetails: session s1 opened by cli 2h10m ago.')
+
+  expect(surface.owner).toEqual({ age: '2h10m', surface: 'cli' })
+  expect(errorCardText(TRANSLATIONS.en.assistant.thread, surface).body).toBe(
+    TRANSLATIONS.en.assistant.thread.errorCodes.SESSION_NOT_OWNED.body
+  )
+  expect(sessionNotOwnedSurface('no details at all').owner).toBeUndefined()
+})
diff --git a/apps/desktop/src/lib/error-surface-copy.ts b/apps/desktop/src/lib/error-surface-copy.ts
index b15cff0617eb0328e66a91d8deb19dd17e2367e4..5320f9845099b33586a54de5d2352a67564815d3 100644
--- a/apps/desktop/src/lib/error-surface-copy.ts
+++ b/apps/desktop/src/lib/error-surface-copy.ts
@@ -44,6 +44,16 @@ export function errorCardText(
 
   if ('code' in key) {
     const copy = thread.errorCodes[key.code]
+    const owner = key.code === 'SESSION_NOT_OWNED' ? surface?.owner : undefined
+
+    // Say WHERE the chat is open when the backend recorded the machine: "another window"
+    // alone sends people hunting through windows on the wrong computer.
+    if (owner?.host) {
+      return {
+        body: thread.errorSessionOwnedElsewhere(owner.surface, owner.host, owner.age ?? ''),
+        title: render(copy.title, provider)
+      }
+    }
 
     // Free-tier and usage-window refusals arrive with the backend's own sentence (the
     // wait, the model, the way forward); the table body is only the fallback for an older backend.
diff --git a/tests/hermes_cli/test_active_sessions.py b/tests/hermes_cli/test_active_sessions.py
index b99f4fca2b5dc8f010dbbb55ec2813958bcdf749..2351353d1d1c10e55f3b284533abbe791e14bfbd 100644
--- a/tests/hermes_cli/test_active_sessions.py
+++ b/tests/hermes_cli/test_active_sessions.py
@@ -775,3 +775,32 @@ def test_snapshot_prunes_after_lock_release_and_keeps_concurrent_lease(tmp_path,
     assert [e["lease_id"] for e in live] == ["live-1"]
     persisted = active_sessions._read_entries(state_path, strict=True)
     assert sorted(e["lease_id"] for e in persisted) == ["live-1", "new-1"]
+
+
+def test_owner_refusal_names_the_holding_machine(tmp_path, monkeypatch):
+    """A refusal says WHERE the chat is open: the SSH Desktop client when one launched this backend."""
+    from hermes_cli import active_sessions as a
+
+    monkeypatch.setenv(a.DESKTOP_CLIENT_HOST_ENV, "MacBook-Pro-177.local")
+    lease, refusal = a.try_acquire_active_session(
+        session_id="s-host", surface="desktop", config={}, registry_home=tmp_path)
+    assert lease is not None and refusal is None
+    entry = a.active_session_registry_snapshot(tmp_path)[0]
+    assert entry["host"] == "MacBook-Pro-177"
+    details = a.session_owner_details("s-host", entry)
+    assert details.startswith("Details: session s-host opened by desktop on MacBook-Pro-177 ")
+    assert details.endswith(" ago.")
+
+
+def test_owner_host_defaults_to_this_machine(monkeypatch):
+    from hermes_cli import active_sessions as a
+
+    monkeypatch.delenv(a.DESKTOP_CLIENT_HOST_ENV, raising=False)
+    monkeypatch.setattr(a.socket, "gethostname", lambda: "davids-mac-mini-1.local")
+    assert a.owner_host() == "davids-mac-mini-1"
+
+
+def test_owner_details_without_host_keeps_old_shape():
+    from hermes_cli import active_sessions as a
+
+    assert a.session_owner_details("s1", {"surface": "cli"}) == "Details: session s1 opened by cli."
