From 5fd976600e6db00f5abf522002429d0fa59a5de5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 14:03:39 +0000
Subject: [PATCH] [daveey] desktop: build the dot row store list on first use,
 not at import

CI on 1889c0e4261 failed check:test:ui: open-session-refresh-in-place, profile-routing and
messaging/index partially mock @/store/session or @/store/gateway, and the module-level
ROW_EXECUTION_STORES array read $unlistedSessionOwnerRows / $activeGatewayRoute at import, which a
vitest partial mock throws on. None of those suites renders a dot.

rowExecutionStores() (and the hook's dotRowStores()) now build the list lazily and memoize it, so
the same singleton array still reaches useStoresSelector on every render.

RED (1889c0e4261): those 3 files fail to load, 'No "$unlistedSessionOwnerRows" export ...'.
GREEN: those 3 + session-dot-state + session-status-dot: 5 files / 160 tests pass; tsc -p . clean;
eslint clean.
---
 apps/desktop/src/lib/use-session-dot-state.ts | 12 ++++---
 .../src/store/execution-observation-row.ts    | 35 +++++++++++--------
 2 files changed, 28 insertions(+), 19 deletions(-)

diff --git a/apps/desktop/src/lib/use-session-dot-state.ts b/apps/desktop/src/lib/use-session-dot-state.ts
index 8417569937..7d14abe4e9 100644
--- a/apps/desktop/src/lib/use-session-dot-state.ts
+++ b/apps/desktop/src/lib/use-session-dot-state.ts
@@ -1,6 +1,8 @@
+import type { ReadableAtom } from 'nanostores'
+
 import { useStoreSelector, useStoresSelector } from '@/lib/use-session-slice'
 import { $backgroundRunningSessionIds } from '@/store/composer-status'
-import { ROW_EXECUTION_STORES } from '@/store/execution-observation-row'
+import { rowExecutionStores } from '@/store/execution-observation-row'
 import { $kanbanObservationTick } from '@/store/kanban-observation'
 import { $messagingSessions, $sessions, lineageAliases, sessionMatchesStoredId } from '@/store/session'
 import {
@@ -16,7 +18,9 @@ import type { SessionInfo } from '@/types/hermes'
 /** [daveey] Every store a dot's row verdict reads: the observation tick (time-only expiry) and `rowExecution`'s own
  *  inputs, which include the owner route and the listed `$sessions` / `$messagingSessions` rows a missing caller row
  *  falls back to. Subscribing to fewer left the dot up to one 15 s tick behind a roster, event or owner change. */
-const DOT_ROW_STORES = [$kanbanObservationTick, ...ROW_EXECUTION_STORES] as const
+let dotRowStoreList: null | readonly ReadableAtom<unknown>[] = null
+
+const dotRowStores = () => (dotRowStoreList ??= [$kanbanObservationTick, ...rowExecutionStores()])
 
 const NO_ROW: Partial<SessionInfo> = {}
 
@@ -33,7 +37,7 @@ const dotRow = (id: string, row: null | SessionInfo | undefined): Partial<Sessio
 export function useSessionDotState(id: null | string, row?: null | SessionInfo) {
   const state = useStoreSelector($sessionDotStateById, states => id ? (states[id] ?? 'idle') : 'draft')
 
-  return useStoresSelector(DOT_ROW_STORES, () => id ? withRowActivity(state, dotRow(id, row)) : state)
+  return useStoresSelector(dotRowStores(), () => id ? withRowActivity(state, dotRow(id, row)) : state)
 }
 
 /** Whether any lineage alias of `id` is in `ids` (the store claims every alias the same way). */
@@ -51,7 +55,7 @@ export function useBackgroundDotLabel(
   const processLive = useStoreSelector($backgroundRunningSessionIds, ids => background && litFor(ids, id))
   const delegating = useStoreSelector($delegatingSessionIds, ids => background && litFor(ids, id))
 
-  return useStoresSelector(DOT_ROW_STORES, () =>
+  return useStoresSelector(dotRowStores(), () =>
     background && id !== null ? backgroundDotLabel(dotRow(id, row), processLive || delegating) : 'running'
   )
 }
diff --git a/apps/desktop/src/store/execution-observation-row.ts b/apps/desktop/src/store/execution-observation-row.ts
index fb69118a62..d8b2bf58e8 100644
--- a/apps/desktop/src/store/execution-observation-row.ts
+++ b/apps/desktop/src/store/execution-observation-row.ts
@@ -1,4 +1,4 @@
-import { computed } from 'nanostores'
+import { computed, type ReadableAtom } from 'nanostores'
 
 import { summarizeExecutionObservations } from '@/lib/execution-observations'
 import type { SessionInfo } from '@/types/hermes'
@@ -134,20 +134,25 @@ const $tileOwnerBindings = computed($sessionTiles, tiles =>
  *  of them (`useStoresSelector`), or its verdict lags until some unrelated store happens to notify.
  *  Not covered (module state, no store): the per-runtime event owner map (session-states.ts), remembered owner hints
  *  (session.ts) and the gateway registry's primary/secondary sockets; those changes repaint on the next 15 s tick. */
-export const ROW_EXECUTION_STORES = [
-  $liveWorkRoster,
-  $backgroundStatusBySession,
-  $subagentsBySession,
-  $runtimeBindings,
-  $sessions,
-  $tileOwnerBindings,
-  $activeGatewayRoute,
-  $gatewayActivationEpoch,
-  $cronSessions,
-  $messagingSessions,
-  $projectTree,
-  $unlistedSessionOwnerRows
-] as const
+let rowExecutionStoreList: null | readonly ReadableAtom<unknown>[] = null
+
+/** Built on first use, not at import: reading these bindings at module load throws in every suite that partially
+ *  mocks `@/store/session` or `@/store/gateway` without them, though it never renders a dot. */
+export const rowExecutionStores = (): readonly ReadableAtom<unknown>[] =>
+  (rowExecutionStoreList ??= [
+    $liveWorkRoster,
+    $backgroundStatusBySession,
+    $subagentsBySession,
+    $runtimeBindings,
+    $sessions,
+    $tileOwnerBindings,
+    $activeGatewayRoute,
+    $gatewayActivationEpoch,
+    $cronSessions,
+    $messagingSessions,
+    $projectTree,
+    $unlistedSessionOwnerRows
+  ])
 
 /** Evidence that keeps a row off done: live/waiting/needs-you work, an outstanding ask, or unresolved uncertainty. */
 export const executionHoldsRow = (e: null | RowExecution): boolean =>
-- 
