 .../contrib/hooks/use-desktop-integrations.ts | 12 ++++-
 .../hooks/use-session-actions/index.ts        |  5 ++
 apps/desktop/src/store/composer.ts            | 26 +++++++++++
 4 files changed, 87 insertions(+), 2 deletions(-)

