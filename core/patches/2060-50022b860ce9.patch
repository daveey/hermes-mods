From 50022b860ce959918137fa353839008fadbfb74a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 9 Nov 2026 03:20:40 +0000
Subject: [PATCH] test(kanban): match WAL replica concurrency in heartbeat
 fixture [daveey]

---
 .../test_kanban_replica_read_memo.py          |  2 ++
 ...test_kanban_replica_read_memo_heartbeat.py | 21 +++++++++++++++++++
 2 files changed, 23 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_replica_read_memo.py b/tests/hermes_cli/test_kanban_replica_read_memo.py
index 2bca78e3fff..2eaf7c8388d 100644
--- a/tests/hermes_cli/test_kanban_replica_read_memo.py
+++ b/tests/hermes_cli/test_kanban_replica_read_memo.py
@@ -30,6 +30,8 @@ def hub(tmp_path, monkeypatch):
     """hermes-hub's replica schema: every write carries the feed's monotonic ``seq``."""
     path = tmp_path / 'hub.db'
     with sqlite3.connect(path) as db:
+        # Match hub client's open_db: rollback journaling excludes concurrent readers during commit.
+        db.execute('PRAGMA journal_mode = WAL')
         db.executescript('CREATE TABLE meta(k TEXT PRIMARY KEY, v TEXT);'
                          'CREATE TABLE replica(gw TEXT, coll TEXT, key TEXT, version INTEGER, seq INTEGER, data TEXT,'
                          ' updated_at INTEGER, PRIMARY KEY (gw, coll, key));'
diff --git a/tests/hermes_cli/test_kanban_replica_read_memo_heartbeat.py b/tests/hermes_cli/test_kanban_replica_read_memo_heartbeat.py
index 3ce8d9d63f6..f3e6b3a46bf 100644
--- a/tests/hermes_cli/test_kanban_replica_read_memo_heartbeat.py
+++ b/tests/hermes_cli/test_kanban_replica_read_memo_heartbeat.py
@@ -190,6 +190,27 @@ def test_gateway_identity_change_rereads(world):
     assert row_reads(statements) == 2 and live == []
 
 
+def test_reader_answers_exactly_while_heartbeat_writer_is_uncommitted(world):
+    """A production WAL writer cannot exclude readers, even if descheduled before commit."""
+    path, _, _, clock = world
+    tick(path, clock, 1100.0)
+    fresh_answer, _ = read(path, clock)
+    set_info(path, [ok(2000.0)])
+    future_answer, _ = read(path, clock)
+    assert fresh_answer != future_answer
+    writer = sqlite3.connect(path)
+    try:
+        writer.execute('BEGIN EXCLUSIVE')
+        writer.execute("UPDATE replica SET data=? WHERE coll='gateway' AND key='info'",
+                       (json.dumps({'gateway': 'owner', 'task_scopes': [ok(1000.0)]}),))
+        # The last committed heartbeat remains visible while the writer holds its transaction.
+        assert read(path, clock)[0] == future_answer
+        writer.commit()
+        assert read(path, clock)[0] == fresh_answer
+    finally:
+        writer.close()
+
+
 def test_concurrent_reads_during_heartbeat_churn_answer_exactly(world):
     path, _, _, clock = world
     tick(path, clock, 1100.0)
