From 5001f4369012b51821b91090ac2c16d3b89825a7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 08:36:57 +0000
Subject: [PATCH] test(kanban): cover closed home-incident key isolation
 [daveey]

Exercise a closed incident for worker-1 followed by the same overdue card
moving to worker-10. The new home must receive its own repair despite the
unchanged membership and unexpired old incident.
---
 tests/hermes_cli/test_kanban_pickup_stall_home.py | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_pickup_stall_home.py b/tests/hermes_cli/test_kanban_pickup_stall_home.py
index facd06eeba..590013b750 100644
--- a/tests/hermes_cli/test_kanban_pickup_stall_home.py
+++ b/tests/hermes_cli/test_kanban_pickup_stall_home.py
@@ -256,6 +256,19 @@ def test_closed_incident_is_replaced_when_membership_changes(replica, local):
     assert second != first
 
 
+def test_closed_incident_for_another_home_does_not_cover_same_membership(replica, local):
+    card(replica, "one", home="worker-1")
+    [first] = subject.sweep(local, replica, "hub", now_ms=NOW * 1000)
+    _close(local, first, NOW)
+    replica.execute("UPDATE tasks SET created_on='worker-10' WHERE id='one'")
+    _fresh_at(replica, NOW + 60)
+    [second] = subject.sweep(local, replica, "hub", now_ms=(NOW + 60) * 1000)
+    assert second != first
+    assert kb.get_task(local, second).idempotency_key.startswith(
+        "pickup-stall:hub:home-overdue-worker-10:")
+    assert local.execute("SELECT COUNT(*) FROM tasks").fetchone()[0] == 2
+
+
 def test_closed_incident_is_replaced_when_membership_shrinks(replica, local):
     card(replica, "one")
     card(replica, "two")
