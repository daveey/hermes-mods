 def _served_by_running_multiplexer(profile_name: str) -> bool:
diff --git a/tests/gateway/test_status_pid_memo.py b/tests/gateway/test_status_pid_memo.py
new file mode 100644
index 0000000000..4a74603717
--- /dev/null
+++ b/tests/gateway/test_status_pid_memo.py
@@ -0,0 +1,190 @@
+"""Memoized ``get_running_pid`` for polled per-profile status (design t_01a1d563324d7e8e §3, card J). [daveey]
+
+Gate: the PID/lock files' identity, the cached process staying alive under its start time with its lock held,
+and a ``RECHECK_S`` backstop. RED before the memo: ``_check_gateway_running`` re-ran the full probe every call.
+"""
+
+from __future__ import annotations
+
+import os
+import time
+
+import pytest
+
+from gateway import status
+from gateway import status_pid_memo as memo
+
+
+@pytest.fixture(autouse=True)
+def _fresh():
+    memo.clear()
+    yield
+    memo.clear()
+
+
+@pytest.fixture
+def files(tmp_path):
+    pid_path = tmp_path / "gateway.pid"
+    pid_path.write_text("{}")
+    status._get_gateway_lock_path(pid_path).write_text("")
+    return pid_path
+
+
+class _Probe:
+    def __init__(self, answer):
+        self.answer, self.calls = answer, 0
+
+    def __call__(self, path):
+        self.calls += 1
+        return self.answer
+
+
+@pytest.fixture(params=["procfs", "portable"])
+def alive(request, monkeypatch):
+    """Drive both liveness paths: Linux's one /proc read, and kill(0)+start time+lock elsewhere."""
+    state = {"alive": True, "start": 111, "locked": True, "zombie": False}
+
+    def _proc(pid):
+        if request.param != "procfs":
+            return None
+        if not state["alive"]:
+            return b"", -1
+        return (b"Z" if state["zombie"] else b"S"), state["start"]
+
+    monkeypatch.setattr(memo, "_proc_stat", _proc)
+    monkeypatch.setattr(memo, "_pid_alive", lambda pid: state["alive"])
+    monkeypatch.setattr(status, "_get_process_start_time", lambda pid: state["start"])
+    monkeypatch.setattr(status, "is_gateway_runtime_lock_active",
+                        lambda path=None: state["locked"] and not state["zombie"])
+    return state
+
+
+def test_unchanged_files_and_live_process_reuse_the_answer(files, alive):
+    probe = _Probe(4242)
+    assert [memo.running_pid(files, probe=probe, now=t) for t in (0, 1, 2, 3)] == [4242] * 4
+    assert probe.calls == 1
+
+
+def test_stopped_gateway_answer_is_reused_until_a_file_moves(files, alive):
+    probe = _Probe(None)
+    assert memo.running_pid(files, probe=probe, now=0) is None
+    assert memo.running_pid(files, probe=probe, now=1) is None
+    assert probe.calls == 1
+    probe.answer = 777  # a gateway starts: it rewrites the PID file
+    files.write_text('{"pid": 777, "started": true}')
+    assert memo.running_pid(files, probe=probe, now=2) == 777
+    assert probe.calls == 2
+
+
+def test_lock_file_change_is_picked_up_next_call(files, alive):
+    probe = _Probe(None)
+    memo.running_pid(files, probe=probe, now=0)
+    lock = status._get_gateway_lock_path(files)
+    os.replace(_write(lock.with_name("new.lock"), "x"), lock)
+    probe.answer = 9
+    assert memo.running_pid(files, probe=probe, now=1) == 9
+
+
+def _write(path, text):
+    path.write_text(text)
+    return path
+
+
+@pytest.mark.parametrize("change", ["dead", "pid_reused", "zombie"])
+def test_cached_live_pid_rechecked_without_any_file_change(files, alive, change):
+    probe = _Probe(4242)
+    assert memo.running_pid(files, probe=probe, now=0) == 4242
+    if change == "dead":
+        alive["alive"] = False
+    elif change == "pid_reused":
+        alive["start"] = 222
+    else:
+        alive["zombie"] = True
+    probe.answer = None
+    assert memo.running_pid(files, probe=probe, now=1) is None
+    assert probe.calls == 2
+
+
+def test_recheck_deadline_passing_reprobes_with_no_other_change(files, alive):
+    probe = _Probe(None)
+    memo.running_pid(files, probe=probe, now=0)
+    memo.running_pid(files, probe=probe, now=memo.RECHECK_S - 0.01)
+    assert probe.calls == 1
+    probe.answer = 31
+    assert memo.running_pid(files, probe=probe, now=memo.RECHECK_S) == 31
+    assert probe.calls == 2
+
+
+def test_file_moving_during_probe_is_not_memoized(files, alive):
+    calls = []
+
+    def racy(path):
+        calls.append(1)
+        if len(calls) == 1:
+            files.write_text('{"pid": 5, "mid-probe": true}')
+        return 5
+
+    assert memo.running_pid(files, probe=racy, now=0) == 5
+    assert memo.running_pid(files, probe=racy, now=1) == 5
+    assert len(calls) == 2
+
+
+def test_answers_are_not_shared_across_probes(files, alive):
+    a, b = _Probe(1), _Probe(None)
+    assert memo.running_pid(files, probe=a, now=0) == 1
+    assert memo.running_pid(files, probe=b, now=0) is None
+    assert (a.calls, b.calls) == (1, 1)
+
+
+def test_profiles_check_gateway_running_uses_the_memo(tmp_path, monkeypatch, alive):
+    from hermes_cli import profiles
+    calls = []
+
+    def fake_get_running_pid(pid_path=None, *, cleanup_stale=True):
+        calls.append(cleanup_stale)
+
+    monkeypatch.setattr(status, "get_running_pid", fake_get_running_pid)
+    monkeypatch.setattr(status, "multiplexer_liveness_for_profile", lambda profile_dir: None)
+    home = tmp_path / "profiles" / "work"
+    home.mkdir(parents=True)
+    for _ in range(5):
+        assert profiles._check_gateway_running(home) is False
+    assert calls == [False], "the PID-file rung must probe once while nothing changes, never cleaning"
+
+
+# -- replay benchmark: budget 0.05% of one core (design §3: get_running_pid 0.4 -> 0.05) --------------------------
+
+def test_replay_budget_polled_profile_list(files):
+    """The measured stream: 11 profiles listed every 2 s by an open Desktop, no gateway changing state. A memo
+    hit costs two stats plus one /proc read per profile; budget is per wall second of polling."""
+    import fcntl
+    paths, held = [], []
+    for n in range(11):
+        d = files.parent / f"p{n}"
+        d.mkdir()
+        p = d / "gateway.pid"
+        p.write_text("{}")
+        lock = status._get_gateway_lock_path(p)
+        lock.write_text("")
+        h = open(lock, "a+")  # a real held lock: the portable path checks it
+        fcntl.flock(h.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+        held.append(h)
+        paths.append(p)
+    pid = os.getpid()  # a real live process: exercise the real liveness path
+    probe = _Probe(pid)
+    try:
+        for p in paths:
+            memo.running_pid(p, probe=probe)
+        best = float("inf")
+        for _ in range(5):
+            t0 = time.thread_time()
+            for _ in range(50):
+                for p in paths:
+                    assert memo.running_pid(p, probe=probe) == pid
+            best = min(best, (time.thread_time() - t0) / 50)
+    finally:
+        for h in held:
+            h.close()
+    assert probe.calls == len(paths)
+    per_second = best / 2.0  # one profile list every 2 s
+    assert per_second <= 0.0005, f"{best * 1000:.3f} ms per list = {per_second:.4%} of a core"
diff --git a/tests/tui_gateway/test_producer_admission_gate.py b/tests/tui_gateway/test_producer_admission_gate.py
new file mode 100644
index 0000000000..707322559e
--- /dev/null
+++ b/tests/tui_gateway/test_producer_admission_gate.py
@@ -0,0 +1,195 @@
+"""Change gate of the producer-admission cold-chat sweep (design t_01a1d563324d7e8e §3, card J). [daveey]
+
+``sweep_once`` opened every profile's SessionDB on every 15 s pass (13 of 17 profile samples; ~0.7 s CPU a pass
+on the hub). It now keeps one read-only observer per store and skips a store whose (file identity,
+``data_version``) is unchanged since a pass that found nothing pending. A pending row is due on every pass, so a
+refused resume retries with no commit in between.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import os
+import shutil
+import time
+
+import pytest
+
+import hermes_state_producer_admission as pa
+from tests.tui_gateway.test_producer_admission import (
+    PRODUCER,
+    SID,
+    _admit,
+    _db,
+    _install_resume,
+    _notices,
+    _root,
+    sdb as sdb,  # noqa: PLC0414 -- the self-alias is load-bearing: it suppresses F811 for the pytest fixture parameter shadowing this import
+    turns as turns,  # noqa: PLC0414 -- the self-alias is load-bearing: it suppresses F811 for the pytest fixture parameter shadowing this import
+)
+from tui_gateway import producer_admission as delivery
+from tui_gateway import server
+
+
+@pytest.fixture(autouse=True)
+def _fresh_observers():
+    reset = getattr(delivery, "reset_observers", lambda: None)  # tolerant: the RED run predates the gate
+    reset()
+    yield
+    reset()
+
+
+@pytest.fixture
+def opens(monkeypatch):
+    """Count full-path store opens (the cost the gate removes)."""
+    calls = []
+    real = pa.open_profile_db
+
+    def _counting(home):
+        calls.append(str(home))
+        return real(home)
+
+    monkeypatch.setattr(pa, "open_profile_db", _counting)
+    return calls
+
+
+def test_unchanged_store_with_nothing_pending_is_not_reopened(sdb, opens):
+    assert delivery.sweep_once() == []
+    first = len(opens)
+    for _ in range(3):
+        assert delivery.sweep_once() == []
+    assert len(opens) == first, "a quiet store must be skipped, not reopened every pass"
+
+
+def test_unrelated_commit_reads_the_observer_but_opens_nothing(sdb, opens):
+    delivery.sweep_once()
+    before = len(opens)
+    sdb.append_message(SID, "user", "an unrelated turn moves data_version")
+    assert delivery.sweep_once() == []
+    assert len(opens) == before, "no pending owner: the observer answers without a SessionDB open"
+
+
+def test_admission_after_a_skipped_pass_is_picked_up_next_pass(sdb, turns, monkeypatch, opens):
+    calls, _ = _install_resume(monkeypatch)
+    assert delivery.sweep_once() == [] and delivery.sweep_once() == []
+    _admit()  # the input change: one commit to the store
+    [rec] = delivery.sweep_once()
+    assert rec["verdict"] == "started" and rec["owner"] == SID
+    assert len(_notices(sdb)) == 1 and len(calls) == 1
+
+
+def test_pending_row_is_retried_every_pass_with_no_other_change(sdb, turns, monkeypatch):
+    calls, _ = _install_resume(monkeypatch, refuse=True)
+    _admit()
+    for n in range(1, 4):  # a refused resume writes nothing: the row is due again on the next pass anyway
+        [rec] = delivery.sweep_once()
+        assert rec["verdict"] == "resume_refused"
+        assert len(calls) == n
+    assert pa.read_producer_admission(producer=PRODUCER, profile_home=_root())["status"] == "queued"
+
+
+def test_delivered_row_settles_then_the_store_goes_quiet(sdb, turns, monkeypatch, opens):
+    _install_resume(monkeypatch)
+    _admit()
+    [rec] = delivery.sweep_once()
+    assert rec["verdict"] == "started"
+    assert delivery.sweep_once() == []  # the pass after a pending one re-reads, finds nothing
+    settled = len(opens)
+    assert delivery.sweep_once() == [] and len(opens) == settled
+
+
+def test_replaced_store_file_is_reobserved(tmp_path):
+    import sqlite3
+    path = tmp_path / "state.db"
+
+    def _make(target):
+        with contextlib.closing(sqlite3.connect(target)) as conn:
+            conn.execute("CREATE TABLE t (x)")
+            conn.commit()
+
+    _make(path)
+    with delivery._observers_lock:
+        key1, conn1 = delivery._observe(path)
+        assert delivery._observe(path) == (key1, conn1)  # unchanged: same key, same kept connection
+    _make(tmp_path / "restored.db")
+    os.replace(tmp_path / "restored.db", path)  # a restore swaps the inode
+    with delivery._observers_lock:
+        key2, conn2 = delivery._observe(path)
+    assert key2[:2] != key1[:2] and conn2 is not conn1
+
+
+def test_profile_store_added_later_is_swept(turns, monkeypatch):
+    calls, _ = _install_resume(monkeypatch)
+    assert delivery.sweep_once() == []
+    work = _db("work")
+    work.create_session(SID, "desktop")
+    work.append_message(SID, "user", "hi")
+
+    @contextlib.contextmanager
+    def _opener(session):
+        yield work
+
+    monkeypatch.setattr(server, "_session_db", _opener)
+    _admit(home=_root() / "profiles" / "work")
+    recs = delivery.sweep_once()
+    assert [(r["profile"], r["verdict"]) for r in recs] == [("work", "started")]
+    assert len(calls) == 1
+    work.close()
+
+
+def test_removed_profile_store_drops_its_observer(monkeypatch):
+    work = _db("work")
+    work.create_session(SID, "desktop")
+    work.close()
+    delivery.sweep_once()
