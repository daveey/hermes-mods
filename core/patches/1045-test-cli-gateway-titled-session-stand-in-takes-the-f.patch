From d755d000f158b34cbb364473cf68fb5b8f95c609 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:31:16 +0000
Subject: [PATCH] test(cli): gateway titled-session stand-in takes the fork's
 --source label [daveey]

Upstream made the gateway the single writer of chat -c --create-if-missing rows; the merge already
passes the fork's source= through create_titled_session, but the test stand-ins rejected it.
---
 tests/hermes_cli/test_chat_c_fail_loudly.py | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/tests/hermes_cli/test_chat_c_fail_loudly.py b/tests/hermes_cli/test_chat_c_fail_loudly.py
index 1989c43e9c8..7f321e77c9c 100644
--- a/tests/hermes_cli/test_chat_c_fail_loudly.py
+++ b/tests/hermes_cli/test_chat_c_fail_loudly.py
@@ -27,12 +27,14 @@ def isolated_home(tmp_path, monkeypatch):
     monkeypatch.setenv("HERMES_HOME", str(home))
     from hermes_cli import gateway_session_store
 
-    def create_titled(title):
+    # Fork: the fork's --source label rides session.create's ``source`` (gateway_session_store
+    # .create_titled_session(title, source=...)), so the stand-in writes it the way the gateway does.
+    def create_titled(title, source=None):
         from hermes_state import SessionDB
         db = SessionDB()
         try:
             sid = "local-" + "ab" * 32
-            db.create_session(sid, source="local")
+            db.create_session(sid, source=source or "cli")
             db.set_session_title(sid, title)
             return sid
         finally:
@@ -156,7 +158,8 @@ class TestChatCFailLoudlyOnStderr:
 
         created = []
         monkeypatch.setattr(store_mod, "create_titled_session",
-                            lambda title: created.append(title) or "local-" + "a" * 64, raising=False)
+                            lambda title, source=None: created.append(title) or "local-" + "a" * 64,
+                            raising=False)  # Fork: source= carries --source to the gateway
         args = type(
             "Args",
             (),
-- 
