From 3c5587b7f6ba899644a30e5580ee028b22fd2910 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 10:26:47 +0000
Subject: [PATCH] test(update): preserve two pinned gateways in one fleet pass
 [daveey]

---
 .../test_update_pause_pinned_runtime.py       | 41 +++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/tests/hermes_cli/test_update_pause_pinned_runtime.py b/tests/hermes_cli/test_update_pause_pinned_runtime.py
index ffce383d476..4f93c56481c 100644
--- a/tests/hermes_cli/test_update_pause_pinned_runtime.py
+++ b/tests/hermes_cli/test_update_pause_pinned_runtime.py
@@ -137,6 +137,47 @@ def test_update_proceeds_past_a_pinned_unit_that_cannot_idle_pause(host, capsys,
     assert not deferrals.state_path().exists(), "a pause that went through left a deferral streak"
 
 
+def test_two_pinned_units_are_both_left_running_through_pause_and_restart(host, monkeypatch, capsys):
+    """Skipping the builder must continue to the reviewer, not break the unit loop."""
+    builder = _run_pinned(host, status_record=True)
+    reviewer_home = host["home"].parent / "askeve-reviewer"
+    reviewer_home.mkdir()
+    reviewer = dict(host, home=reviewer_home)
+    reviewer_pid = _run_pinned(reviewer, status_record=True)
+    reviewer_unit = "hermes-gateway-askeve-reviewer"
+    reviewer_dropin = host["dropin"].parents[1] / f"{reviewer_unit}.service.d" / host["dropin"].name
+    reviewer_dropin.parent.mkdir()
+    reviewer_dropin.write_bytes(host["dropin_before"])
+    original_systemctl = fleet._systemctl
+
+    def two_units(cmd, *, timeout):
+        if "list-units" in cmd:
+            text = "".join(f"{unit}.service loaded active running Hermes\n" for unit in (UNIT, reviewer_unit))
+            return subprocess.CompletedProcess(cmd, 0, stdout=text if "--user" in cmd else "", stderr="")
+        if any(reviewer_unit in arg for arg in cmd):
+            if "--property=MainPID" in cmd:
+                return subprocess.CompletedProcess(cmd, 0, stdout=f"{reviewer_pid}\n", stderr="")
+            if "--property=Environment" in cmd:
+                return subprocess.CompletedProcess(cmd, 0, stdout=f"HERMES_HOME={reviewer_home}\n", stderr="")
+        return original_systemctl(cmd, timeout=timeout)
+
+    monkeypatch.setattr(fleet, "_systemctl", two_units)
+    monkeypatch.setattr(dashboard_procs, "_hermes_home_for_pid",
+                        lambda pid: str(reviewer_home if pid == reviewer_pid else host["home"]))
+    monkeypatch.setattr("hermes_cli.update_receipt._profile_homes",
+                        lambda: [("default", host["root"]), ("askeve-builder", host["home"]),
+                                 ("askeve-reviewer", reviewer_home)])
+    assert builder != reviewer_pid
+    assert pause._pause(pause._empty_token()) is None
+    out = capsys.readouterr().out
+    assert UNIT in out and reviewer_unit in out
+    failed = []
+    fleet._restart_systemd_gateway_units_best_effort(failed, fleet._systemd_gateway_unit_listings())
+    assert failed == [] and host["asked"] == [] and host["writes"] == [] and host["repairs"] == []
+    assert all(proc.poll() is None for proc in host["procs"])
+    assert host["dropin"].read_bytes() == reviewer_dropin.read_bytes() == host["dropin_before"]
+
+
 def test_a_checkout_unit_that_cannot_idle_pause_still_defers_and_starts_a_streak(host):
     """Control: the same unit NOT proven on another checkout keeps the refusal (its code is the one
     being replaced), and that deferral is counted against it."""
