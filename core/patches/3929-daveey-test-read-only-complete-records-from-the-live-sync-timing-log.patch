From bea95711b658728202b132f17b1c8ed03b0d8337 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:00:56 +0000
Subject: [PATCH] [daveey] test: read only complete records from the live sync
 timing log

test_real_loop_records_full_report_cost_and_matches_a_change_to_its_boards_service
polls the capture log while the real sync loop appends to it. A read that
lands mid-append ends in a torn record, and json.loads raised
JSONDecodeError (flaky CI run 43508705776, attempt 1:
'...h","t0":229241394078' -> "Expecting ',' delimiter"). Not CPU starvation
of a deadline: a reader/writer race on the file tail, which a throttled
runner only widens.

_records now parses only newline-terminated lines. The writer
(TimingDiag._write) always ends each record with "\n", so the complete
prefix is exactly the set of finished records; the final reads after the
loop has joined see the whole file.

Proof: a local copy of the test whose TimingDiag(write=...) splits every
append in two with a 50 ms gap fails the old helper with the same
JSONDecodeError on every run, and passes 3/3 with this helper (plus the
unmodified file, 2/2 each run).
---
 tests/hermes_cli/test_kanban_sync_timing_loop.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_sync_timing_loop.py b/tests/hermes_cli/test_kanban_sync_timing_loop.py
index a013ebece5..a427cdb9be 100644
--- a/tests/hermes_cli/test_kanban_sync_timing_loop.py
+++ b/tests/hermes_cli/test_kanban_sync_timing_loop.py
@@ -36,9 +36,11 @@ def _config(root: Path, until: float | None) -> None:
 
 
 def _records(path: Path) -> list[dict]:
+    """The complete records so far. The loop appends while the test polls, so a read can end inside a record."""
     if not path.exists():
         return []
-    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines()]
+    text = path.read_text(encoding="utf-8")
+    return [json.loads(line) for line in text[:text.rfind("\n") + 1].splitlines()]
 
 
 @pytest.mark.platforms("linux")  # the reporter's real CPU busy sample reads /proc/stat
