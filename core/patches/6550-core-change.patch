From b6bed1041d7e172992171aee56038fe175da1739 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 26 Nov 2026 05:40:52 +0000
Subject: [PATCH 6550] Annotation readers, batched revisions and settlement generations

Public mirror of source commit b6bed1041d7e172992171aee56038fe175da1739.

---
diff --git a/hermes_cli/kanban_scope_renewal.py b/hermes_cli/kanban_scope_renewal.py
index 1c77290224d..b4fe20be811 100644
--- a/hermes_cli/kanban_scope_renewal.py
+++ b/hermes_cli/kanban_scope_renewal.py
@@ -72,7 +72,12 @@
 
 def _columns(conn: sqlite3.Connection, table: str) -> frozenset:
     """Column names in one result row (kanban_table_columns), not one row per column: the actionability reader asks
-    for task_comments on every card and parent each session-panel pass, repeating schema probes. [daveey]"""
+    for task_comments on every card and parent each session-panel pass, repeating schema probes.
+
+    Only a bare table name: ``pragma_table_info`` answers a schema-qualified or malformed name with an empty set,
+    where the old ``PRAGMA table_info(<table>)`` raised, so such a name fails loudly here instead. [daveey]"""
+    if not isinstance(table, str) or not table.isidentifier():
+        raise ValueError(f"not a bare table name: {table!r}")
     from hermes_cli.kanban_table_columns import table_columns
     return table_columns(conn, table)
 
diff --git a/tests/hermes_cli/test_scope_renewal_columns.py b/tests/hermes_cli/test_scope_renewal_columns.py
index 6fa1347e914..4b612a600e8 100644
--- a/tests/hermes_cli/test_scope_renewal_columns.py
+++ b/tests/hermes_cli/test_scope_renewal_columns.py
@@ -5,6 +5,8 @@
 """
 import sqlite3
 
+import pytest
+
 from hermes_cli import kanban_scope_renewal as renewal
 from hermes_cli.kanban_actionability_evidence import Rows
 from tests.hermes_cli import test_kanban_failure_transport as support
@@ -63,3 +65,26 @@
         assert renewal._columns(Rows(counted), 'no_such_table') == set()
     finally:
         counted.close()
+
+
+@pytest.mark.parametrize('name', ['main.task_comments', 'task comments', 'task_comments)', ''])
+def test_a_qualified_or_malformed_table_name_fails_loudly(live, name):
+    with pytest.raises(ValueError):
+        renewal._columns(live, name)
+
+
+def test_a_closed_connection_raises(live):
+    counted = _counted(live)
+    counted.close()
+    with pytest.raises(sqlite3.ProgrammingError):
+        renewal._columns(counted, 'task_comments')
+
+
+def test_a_schema_change_between_calls_is_seen(live):
+    before = renewal._columns(live, 'task_comments')
+    assert 'probe_extra' not in before
+    live.execute('ALTER TABLE task_comments ADD COLUMN probe_extra TEXT')
+    live.commit()
+    after = renewal._columns(live, 'task_comments')
+    assert after == before | {'probe_extra'}
+    assert after == {r[1] for r in live.execute('PRAGMA table_info(task_comments)')}
