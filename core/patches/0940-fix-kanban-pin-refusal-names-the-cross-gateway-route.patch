From 2bb1d3298bd3527c63a21ca9d3fd36ad0659915f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 08:41:37 +0000
Subject: [PATCH] fix(kanban): pin refusal names the cross-gateway route that
 works from this gateway [daveey]

placement=<machine> only reaches the gateway's routed target (on the hub there is
no route, so placement='macbook' is refused); hermes-hub create-task <machine>
works from any gateway (live: t_01a186cf60392092 claimed and completed on
David-MBP 8 s after a hub create).
---
 hermes_cli/kanban_worker_node.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_worker_node.py b/hermes_cli/kanban_worker_node.py
index 3983cb0531..399e9de981 100644
--- a/hermes_cli/kanban_worker_node.py
+++ b/hermes_cli/kanban_worker_node.py
@@ -94,9 +94,9 @@ class MachinePinRefused(Exception):  # not ValueError: label-syntax handlers mus
         self.machine = machine
         super().__init__(
             f"runs_on names machine:{machine}, but {why}, so no worker would ever claim the card on this board. "
-            f"Nothing was written. Create it on that machine's own gateway instead: kanban_create("
-            f"placement=\"{machine}\") (a cross-gateway create, origin-bound to this chat), or "
-            f"`hermes-hub create-task {machine} ...`.")
+            f"Nothing was written. Create it on that machine's own gateway instead (a cross-gateway create): "
+            f"kanban_create(placement=\"{machine}\") when this gateway's kanban.placement route targets "
+            f"{machine}, otherwise `hermes-hub create-task {machine} <title> --body ...`.")
 
     @property
     def tool_error_fields(self) -> dict:
-- 
