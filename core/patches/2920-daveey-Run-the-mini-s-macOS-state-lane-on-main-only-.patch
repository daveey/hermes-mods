From 1272b93b6090dcc8cef66669fa7393dded68b5b9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 07:16:26 -0800
Subject: [PATCH] [daveey] Run the mini's macOS state lane on main only for
 state-surface pushes

The single self-hosted mini runner (mini-hermes-state-1) also served every
main push: ~32 standalone runs in 19 h (~12 min each, ~34% of the runner),
although only ~8% of main commits touch the surface the PR classifier
selects the lane for. Required 'tests/hermes_state (macOS, mini)' PR jobs
queued behind them for 40-145 min (PR #1468: 93+ min).

The push trigger now carries a paths filter equal to the classifier's
hermes_state selection (_HERMES_STATE_PATHS, .github/, _CI_CONFIG_FILES),
and a 4-hourly schedule tests main HEAD as the backstop for changes outside
that surface and for >300-file pushes. Scheduled runs share the push
concurrency group, so they collapse with queued pushes. PR selection,
dispatch and release runs are unchanged.

tests/ci/test_macos_state_routing.py holds the paths filter equal to
classify() for every tracked file plus edge paths, and checks the schedule
and its concurrency group.
---
 .github/workflows/ci.yaml                | 13 +++--
 .github/workflows/hermes-state-macos.yml | 38 ++++++++++++-
 tests/ci/test_macos_state_routing.py     | 72 ++++++++++++++++++++++++
 3 files changed, 115 insertions(+), 8 deletions(-)

diff --git a/.github/workflows/ci.yaml b/.github/workflows/ci.yaml
index 09d1f49173..04c3a86d93 100644
--- a/.github/workflows/ci.yaml
+++ b/.github/workflows/ci.yaml
@@ -132,10 +132,11 @@ jobs:
         # lanes are forced off unless this is a release run or a manual dispatch
         # (whose empty diff already turns every lane on): never on a pull request
         # or a push to main, whatever the diff or labels say. The macOS state and
-        # native memory lanes are off on a main push (hermes-state-macos.yml and
-        # native-memory-macos.yml each run main from their own push trigger, so a
-        # main push never runs a suite twice on the one mini runner) and on for
-        # a dispatch or a release.
+        # native memory lanes are off on a main push (hermes-state-macos.yml runs
+        # main from its own path-filtered push trigger and 4-hourly schedule, and
+        # native-memory-macos.yml from its own push trigger, so a main push never
+        # runs a suite twice on the one mini runner) and on for a dispatch or a
+        # release.
         id: gate-lanes
         env:
           RELEASE: ${{ inputs.release }}
@@ -314,8 +315,8 @@ jobs:
     # dependency manifests (and every dispatch / release). A fork PR never runs
     # on the mini: the job skips, and macos-state-required below then fails the
     # selected lane, so a fork change to that surface cannot merge on a skip.
-    # Main pushes skip here (detect turns the lane off); the workflow's own push
-    # trigger runs main.
+    # Main pushes skip here (detect turns the lane off); the workflow's own
+    # path-filtered push trigger and 4-hourly schedule run main.
     if: needs.detect.outputs.hermes_state == 'true' && (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository)
     uses: ./.github/workflows/hermes-state-macos.yml
     with:
diff --git a/.github/workflows/hermes-state-macos.yml b/.github/workflows/hermes-state-macos.yml
index 4d0af2c0bb..581d8ba7a4 100644
--- a/.github/workflows/hermes-state-macos.yml
+++ b/.github/workflows/hermes-state-macos.yml
@@ -14,12 +14,45 @@ name: hermes_state (macOS)
 # Its macOS state required (v1) consumer requires success when selected.
 # Main pushes run here directly; CI masks its duplicate call only on main pushes.
 #
+# Main pushes start this lane only when they touch the surface ci.yaml's
+# classifier selects it for (scripts/ci/classify_changes.py: _HERMES_STATE_PATHS,
+# .github/ and _CI_CONFIG_FILES; tests/ci/test_macos_state_routing.py holds the
+# paths list equal to it). Running it on every main push (~1 in 12 touches that
+# surface) kept the single mini runner busy with main and queued required PR jobs
+# 90+ min. The 4-hourly schedule tests main HEAD anyway: a change outside the
+# surface that still breaks the suite (or a >300-file push, whose paths filter
+# GitHub truncates) surfaces within 4 h instead of on its own push.
+#
 # HERMES_HOME points at a throwaway temp dir so the lane can never touch the
 # live ~/.hermes of anything else running on the mini.
 
 on:
   push:
     branches: [main, 'ci-probe/**']
+    paths:
+      - 'hermes_state*'
+      - 'hermes_state*/**'
+      - 'tests/hermes_state/**'
+      - 'tests/conftest.py'
+      - 'tests/_fixtures/**'
+      - 'tests/fakes/**'
+      - 'tests/e2e/conftest.py'
+      - 'tests/e2e/core/_*'
+      - 'tests/e2e/core/_*/**'
+      - 'scripts/run_tests.sh'
+      - 'scripts/run_tests_parallel.py'
+      - 'scripts/run_tests_host_slots.py'
+      - 'scripts/run_tests_parallel_rss.py'
+      - 'scripts/run_tests_launch.py'
+      - 'scripts/run_tests_fork_child.py'
+      - 'pyproject.toml'
+      - 'uv.lock'
+      - 'setup.py'
+      - '.github/**'
+      - 'justfile'
+      - 'scripts/hermes-python'
+  schedule:
+    - cron: '23 */4 * * *'
   workflow_dispatch:
   workflow_call:
     inputs:
@@ -32,8 +65,9 @@ permissions:
   contents: read
 
 concurrency:
-  # Collapse queued standalone pushes, but never supersede a required caller.
-  group: ${{ github.workflow == 'hermes_state (macOS)' && github.event_name == 'push' && format('hermes-state-macos-push-{0}', github.ref) || format('hermes-state-macos-{0}-{1}-{2}', github.run_id, github.run_attempt, inputs.commit || github.sha) }}
+  # Collapse queued standalone pushes and scheduled main runs, but never
+  # supersede a required caller.
+  group: ${{ github.workflow == 'hermes_state (macOS)' && (github.event_name == 'push' || github.event_name == 'schedule') && format('hermes-state-macos-push-{0}', github.ref) || format('hermes-state-macos-{0}-{1}-{2}', github.run_id, github.run_attempt, inputs.commit || github.sha) }}
   cancel-in-progress: false
 
 jobs:
diff --git a/tests/ci/test_macos_state_routing.py b/tests/ci/test_macos_state_routing.py
index ccd43b123b..ce123f4afe 100644
--- a/tests/ci/test_macos_state_routing.py
+++ b/tests/ci/test_macos_state_routing.py
@@ -1,6 +1,8 @@
 """Replay the macOS state lane's real workflow wiring, without running a mini job."""
+import functools
 import json
 import os
+import re
 import subprocess
 import sys
 from pathlib import Path
@@ -123,6 +125,76 @@ def test_standalone_pushes_collapse_without_superseding_required_calls():
     assert render('hermes_state (macOS)', 1, 'workflow_dispatch') != render('hermes_state (macOS)', 2, 'workflow_dispatch')
 
 
+def _gha_path_glob(pattern):
+    """GitHub ``on.push.paths`` glob: ``*`` stops at ``/``, ``**`` crosses it, whole-path match."""
+    out, i = '', 0
+    while i < len(pattern):
+        if pattern.startswith('**', i):
+            out, i = out + '.*', i + 2
+        elif pattern[i] == '*':
+            out, i = out + '[^/]*', i + 1
+        elif pattern[i] == '?':
+            out, i = out + '[^/]', i + 1
+        else:
+            out, i = out + re.escape(pattern[i]), i + 1
+    return re.compile(out + r'\Z')
+
+
+@functools.cache
+def _main_push_path_patterns():
+    on_push = workflow('hermes-state-macos.yml')['on']['push']
+    return tuple(_gha_path_glob(p) for p in on_push['paths'])
+
+
+def _main_push_starts_lane(path):
+    return any(p.match(path) for p in _main_push_path_patterns())
+
+
+_EDGE_PATHS = [
+    'hermes_state.py', 'hermes_state_new_module.py', 'hermes_state_pkg/inner/mod.py',
+    'tests/hermes_state/sub/test_x.py', 'tests/hermes_statex/test_y.py', 'tests/test_hermes_state.py',
+    'docs/hermes_state.md', 'pkg/hermes_state.py', 'tests/_fixtures/a/b.py', 'tests/fakes/x.py',
+    'tests/e2e/core/_harness.py', 'tests/e2e/core/_pkg/mod.py', 'tests/e2e/core/test_x.py',
+    'tests/e2e/conftest.py', 'tests/e2e/other/conftest.py', 'tests/sub/conftest.py',
+    'scripts/run_tests.sh', 'scripts/run_tests_new.py', 'scripts/run_tests_launch.py',
+    'pyproject.toml', 'sub/pyproject.toml', 'uv.lock', 'setup.py', 'justfile', 'sub/justfile',
+    'scripts/hermes-python', '.github/workflows/x.yml', '.github/a/b/c', 'run_agent.py', 'README.md',
+]
+
+
+@pytest.mark.parametrize('path', _EDGE_PATHS)
+def test_main_push_paths_equal_classifier_selection_edges(path):
+    # A main push starts the standalone lane exactly when a PR with that file selects it.
+    assert _main_push_starts_lane(path) is classify([path])['hermes_state'], path
+
+
+def test_main_push_paths_equal_classifier_selection_for_every_tracked_file():
+    files = subprocess.run(['git', 'ls-files'], cwd=ROOT, capture_output=True, text=True,
+                           check=True, timeout=60).stdout.split('\n')
+    files = [f for f in files if f]
+    assert len(files) > 1000
+    mismatched = [f for f in files if _main_push_starts_lane(f) is not classify([f])['hermes_state']]
+    assert not mismatched, mismatched[:20]
+    assert sum(map(_main_push_starts_lane, files)) < len(files) // 4, 'filter must not select most of main'
+
+
+def test_schedule_backstop_tests_main_and_collapses_with_pushes():
+    doc = workflow('hermes-state-macos.yml')
+    crons = [entry['cron'] for entry in doc['on']['schedule']]
+    assert len(crons) == 1
+    minute, hour, *rest = crons[0].split()
+    assert hour == '*/4' and rest == ['*', '*', '*'] and minute.isdigit()
+    group = doc['concurrency']['group']
+    def render(event, run_id):
+        ctx = context(event, 'refs/heads/main')
+        ctx['github'].update(workflow='hermes_state (macOS)', run_id=run_id, sha=f'sha-{run_id}')
+        return gha.render(group, ctx)
+    assert render('schedule', 1) == render('push', 2) == render('schedule', 3)
+    assert render('schedule', 1) != render('workflow_dispatch', 4)
+    job = doc['jobs']['hermes-state-macos']
+    assert gha.condition(job['if'], context('schedule', 'refs/heads/main'))
+
+
 @pytest.mark.parametrize('selected', ['true', 'false', None, '', 'TRUE', 0, 1, True, False])
 @pytest.mark.parametrize('result', ['success', 'skipped', 'failure', 'cancelled', None])
 def test_required_consumer_executes_real_cli(selected, result, monkeypatch):
