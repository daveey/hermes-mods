@@ -87,9 +91,21 @@ jobs:
           import shutil
           import subprocess
 
-          ROOT = Path('/Users/me/ci-runner-hermes-state')
+          # Dedicated runner roots: the Mac mini's operator login agent and the
+          # office minis' ci LaunchDaemons (one job at a time each).
+          ROOTS = (
+              Path('/Users/me/ci-runner-hermes-state'),
+              Path('/Users/ci/actions-runner-hermes'),
+          )
 
           def prepare():
+              # Use the root this runner runs from; any other runner or user
