From ff729d1c405c821f7310b326b66efa10db8a4834 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 13:36:40 -0800
Subject: [PATCH] fix(kanban-sync): a push request never exceeds the Board's
 200-op limit [daveey]

push() sent the unacknowledged parent cards on top of a full PUSH_BATCH of
rows, so one such card behind 200 pending rows made a 201-op request. The
Board answered 400 'ops must be a list of <= 200', the same rows were
selected again, and hermes-hub pushed nothing from 2026-11-17 14:38Z
(80,641 pending ops, 39k attempts on the head rows). Trim the rows so
parents + rows fit the limit; the rest go in the next batch.

The fake Board now enforces the limit; the new test fails without the fix.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 hermes_cli/kanban_sync_client.py              | 15 ++++-
 tests/hermes_cli/kanban_sync_fake_board.py    |  2 +
 .../test_kanban_sync_push_batch_cap.py        | 67 +++++++++++++++++++
 3 files changed, 83 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_cli/test_kanban_sync_push_batch_cap.py

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index 52eac024895ca8ba4209da20d5afe870f4471764..0e8f914041426338d1b5152a57ffc2ababe0996d 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -662,6 +662,19 @@ class PushResult:
     deferred: int = 0
 
 
+def _within_batch(conn: sqlite3.Connection, rows: list[dict], wire: list[dict],
+                  gateway: str) -> tuple[list[dict], list[dict], list[tuple[dict, str]]]:
+    """``(rows, wire, parents)`` trimmed so parents + rows fit one request. The Board refuses more than PUSH_BATCH
+    ops (400), and the parents ride on top of a full batch: one unacknowledged card behind 200 pending rows failed
+    every round with 201 ops and nothing left the hub for 7 h (2026-11-17). The dropped rows go in the next batch."""
+    parents = _unacked_parents(conn, rows, gateway)
+    if len(parents) + len(rows) > PUSH_BATCH:
+        rows = rows[:max(1, PUSH_BATCH - len(parents))]
+        wire = wire[:len(rows)]
+        parents = _unacked_parents(conn, rows, gateway)
+    return rows, wire, parents
+
+
 def push(conn: sqlite3.Connection, hub: Hub, board: str, gateway: str, *, primary: bool,
          max_batches: int = MAX_BATCHES_PER_ROUND, before_head: bool = False,
          seen: Optional[dict] = None) -> PushResult:
@@ -689,7 +702,7 @@ def push(conn: sqlite3.Connection, hub: Hub, board: str, gateway: str, *, primar
         with write_txn(conn):
             from hermes_cli.kanban_terminal_guard import strip_stale_push  # no wake reopens a done card [daveey]
             wire = [strip_stale_push(conn, translate(_full_row_if_unseen(conn, r), _next_hlc(conn, gateway))) for r in rows]
-            parents = _unacked_parents(conn, rows, gateway)
+            rows, wire, parents = _within_batch(conn, rows, wire, gateway)
             wire = [op for op, _tid in parents] + wire
         try:
             resp = hub.ops(board, wire)
