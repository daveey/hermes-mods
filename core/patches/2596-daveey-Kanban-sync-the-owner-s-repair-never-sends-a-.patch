diff --git a/hermes_cli/kanban_sync_divergence.py b/hermes_cli/kanban_sync_divergence.py
index e6fa6f67e8..cea49dba1d 100644
--- a/hermes_cli/kanban_sync_divergence.py
+++ b/hermes_cli/kanban_sync_divergence.py
@@ -39,6 +39,9 @@ def repair_divergence(live: sqlite3.Connection, shadow: sqlite3.Connection, gate
         fields = {k: v for k, v in mine.items() if k in remote and remote[k] != v and k not in omitted}
         if not fields:
             continue
