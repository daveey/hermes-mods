From 4d65994a95c650c24533c6133a6d2191f6d0a66f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 09:24:01 +0000
Subject: [PATCH] [daveey] Keep busy sync fences local to their board

---
 hermes_cli/kanban_sync_client.py              |  4 +++-
 hermes_cli/kanban_sync_guard.py               |  6 ++++-
 .../test_kanban_sync_detach_race.py           | 22 +++++++++++++++++++
 3 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index 51d8f969e6c..6b0d00ced05 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -892,6 +892,8 @@ def publish_pickup_if_changed(hub: Any, *, now: Optional[float] = None) -> bool:
 
 def sync_all_once(hub: Optional[Hub] = None, *,
                   boards: Optional[list[tuple[str, Path]]] = None) -> list[RoundResult]:
+    from hermes_cli.kanban_sync_guard import SyncRoundBusy
+
     ident = load_identity() if hub is None else hub.ident
     hub = hub or Hub(ident)
     publish_pickup_if_changed(hub)
@@ -899,7 +901,7 @@ def sync_all_once(hub: Optional[Hub] = None, *,
     for slug, path in board_paths() if boards is None else boards:
         try:
             results.append(sync_board(slug, path, hub, ident.gateway))
-        except (HubError, OSError, Resync, sqlite3.Error, SyncUnavailable) as exc:
+        except (HubError, OSError, Resync, sqlite3.Error, SyncUnavailable, SyncRoundBusy) as exc:
             _log.warning("kanban sync: round for %s failed (%s: %s)", slug, type(exc).__name__, exc)
             results.append(RoundResult(board=slug, mode="?", error=f"{type(exc).__name__}: {exc}"))
     return results
diff --git a/hermes_cli/kanban_sync_guard.py b/hermes_cli/kanban_sync_guard.py
index f6313c2a23d..943b6b5b36b 100644
--- a/hermes_cli/kanban_sync_guard.py
+++ b/hermes_cli/kanban_sync_guard.py
@@ -3,6 +3,10 @@ from contextlib import contextmanager
 from pathlib import Path
 
 
+class SyncRoundBusy(RuntimeError):
+    """A sync round or detach already owns this board's synchronization fence."""
+
+
 @contextmanager
 def board_sync_lock(path: Path):
     """Never wait for network I/O while detaching: a busy round must finish first.
@@ -14,5 +18,5 @@ def board_sync_lock(path: Path):
     canonical = Path(path).resolve()
     with _dispatch_tick_lock(canonical.with_name(canonical.name + ".sync")) as held:
         if not held:
-            raise RuntimeError("board sync round is busy; retry detach after it finishes")
+            raise SyncRoundBusy("board sync round is busy; retry after it finishes")
         yield
diff --git a/tests/hermes_cli/test_kanban_sync_detach_race.py b/tests/hermes_cli/test_kanban_sync_detach_race.py
index a3fde2b7fb0..b6825797b7c 100644
--- a/tests/hermes_cli/test_kanban_sync_detach_race.py
+++ b/tests/hermes_cli/test_kanban_sync_detach_race.py
@@ -76,3 +76,25 @@ def test_detach_refuses_until_whole_sync_round_including_push_finishes(synced_co
         # A round enumerated before detach but starting after it does no I/O.
         result = client.sync_board("default", path, None, "fixture-host")
         assert result.mode == "off"
+
+
+def test_busy_round_is_scoped_to_one_board_and_next_pass_recovers(synced_conn, tmp_path):
+    from hermes_cli import kanban_sync_client as client
+    from hermes_cli.kanban_sync_guard import board_sync_lock
+    from tests.hermes_cli.kanban_sync_fake_board import FakeService
+
+    first = Path(sync._db_key(synced_conn))
+    second = tmp_path / "second.db"
+    client.ensure_identity(synced_conn, "first", "fixture-host")
+    sync.set_mode(synced_conn, "primary")
+    with kbc.connect_closing(second) as conn:
+        client.ensure_identity(conn, "second", "fixture-host")
+        sync.set_mode(conn, "primary")
+    hub = FakeService().hub("fixture-host")
+    boards = [("first", first), ("second", second)]
+    with board_sync_lock(first):
+        results = client.sync_all_once(hub, boards=boards)
+    assert [r.board for r in results] == ["first", "second"]
+    assert "busy" in results[0].error
+    assert not results[1].error
+    assert all(not r.error for r in client.sync_all_once(hub, boards=boards))
-- 
