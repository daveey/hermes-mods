diff --git a/plugins/kanban/dashboard/board_diagnostics.py b/plugins/kanban/dashboard/board_diagnostics.py
new file mode 100644
index 00000000000..776eb2b2dbf
--- /dev/null
+++ b/plugins/kanban/dashboard/board_diagnostics.py
@@ -0,0 +1,32 @@
+"""Card-badge summaries of per-task diagnostics for the kanban board payload."""
+
+from __future__ import annotations
+
+from typing import Optional
+
+from hermes_cli import kanban_diagnostics as kd
+
+
+def _warnings_summary_from_diagnostics(diagnostics: list[dict]) -> Optional[dict]:
+    """Compact card badge summary ``{count, kinds, latest_at, highest_severity}``; None when empty."""
+    if not diagnostics:
+        return None
+    kinds: dict[str, int] = {}
+    count = latest = 0
+    highest_idx, highest_sev = -1, None
+    for d in diagnostics:
+        n = d.get("count", 1)
+        kinds[d["kind"]] = kinds.get(d["kind"], 0) + n
+        count += n
+        latest = max(latest, d.get("last_seen_at") or 0)
+        sev = d.get("severity")
+        if sev in kd.SEVERITY_ORDER and kd.SEVERITY_ORDER.index(sev) > highest_idx:
+            highest_idx, highest_sev = kd.SEVERITY_ORDER.index(sev), sev
+    return {"count": count, "kinds": kinds, "latest_at": latest, "highest_severity": highest_sev}
+
+
+def _attach_diagnostics(task_d: dict, diags: Optional[list[dict]]) -> None:
+    """Full list in the payload (drawer renders without a second round-trip); card badge gets the summary."""
+    if diags:
+        task_d["diagnostics"] = diags
+        task_d["warnings"] = _warnings_summary_from_diagnostics(diags)
diff --git a/plugins/kanban/dashboard/board_prewarm.py b/plugins/kanban/dashboard/board_prewarm.py
new file mode 100644
index 00000000000..41046414688
--- /dev/null
+++ b/plugins/kanban/dashboard/board_prewarm.py
@@ -0,0 +1,44 @@
+"""Boot-time read of the active and default boards, so the Desktop's first cold-start poll finds
+a snapshot (or joins this read) instead of paying connect + first-init integrity probe + the
+full read under the burst's GIL contention. The probe still runs in ``kbc.connect`` before
+anything is written; only the thread it runs on changes."""
+
+from __future__ import annotations
+
+import logging
+import os
+import threading
+from typing import Optional
+
+from agent.memory_provider import spawn_context_thread
+from hermes_cli import kanban_db
+
+log = logging.getLogger(__name__)
+
+
+def prewarm_boards(api) -> None:
+    """``api`` is the kanban plugin_api module (key and read come from the same code as GET /board)."""
+    from plugins.kanban.dashboard.board_snapshot import file_sig, prewarm
+
+    seen = set()
+    for name in (kanban_db.get_current_board(), kanban_db.DEFAULT_BOARD):
+        try:
+            resolved = api._resolve_board(name)
+            path = str(kanban_db.kanban_db_path(board=resolved))
+            key = (path, None, False, None, None, int(api._BOARD_DONE_LIMIT))
+            if key in seen:
+                continue
+            seen.add(key)
+            prewarm(lambda r=resolved: api._get_board_uncached(None, False, r, None, None, api._BOARD_DONE_LIMIT),
+                    key, file_sig(path))
+        except Exception:
+            log.debug("kanban board prewarm failed for %r", name, exc_info=True)
+
+
+def start_board_prewarm(api) -> Optional[threading.Thread]:
+    """Run ``prewarm_boards`` on a daemon thread (not under the test harness)."""
+    if os.environ.get("HERMES_TEST_ISOLATION"):
+        return None
+    thread = spawn_context_thread(lambda: prewarm_boards(api), name="kanban-board-prewarm")
+    thread.start()
+    return thread
diff --git a/plugins/kanban/dashboard/board_snapshot.py b/plugins/kanban/dashboard/board_snapshot.py
index 3c7f8eca991..b03c01f5a07 100644
--- a/plugins/kanban/dashboard/board_snapshot.py
+++ b/plugins/kanban/dashboard/board_snapshot.py
@@ -22,6 +22,8 @@ _cache: dict[tuple, tuple] = {}
 _cache_lock = threading.Lock()
 _refresh_lock = threading.Lock()
 _refresh_thread: Optional[threading.Thread] = None
+# key -> Event set when the first read of that key (a request or the boot prewarm) finishes.
+_first_reads: dict[tuple, threading.Event] = {}
 
 
 def file_sig(path: str) -> Optional[tuple]:
@@ -84,6 +86,41 @@ def serve(key, sig, read: Callable[[], dict], now: Optional[float] = None) -> di
             return dict(hit[2], now=int(time.time()))
         _schedule(read, key, sig, now)
         return dict(hit[2], now=int(time.time()))
-    result = read()
-    _publish(key, sig, now, result)
-    return result
+    return _first_read(read, key, sig, now)
+
+
+def _first_read(read: Callable[[], dict], key, sig, now) -> dict:
+    """The first read of ``key`` runs once. A caller that arrives while another (the boot prewarm
+    or an earlier poll) is reading waits for it instead of repeating the 4-5 s read under the
+    GIL contention of the Desktop's cold-start burst."""
+    with _cache_lock:
+        pending = _first_reads.get(key)
+        leader = pending is None
+        if leader:
+            pending = _first_reads[key] = threading.Event()
+    if not leader:
+        pending.wait()
+        with _cache_lock:
+            hit = _cache.get(key)
+        if hit is not None:
+            return dict(hit[2], now=int(time.time()))
+        return read()  # the leader failed: read for ourselves
+    try:
+        result = read()
+        _publish(key, sig, now, result)
+        return result
+    finally:
+        with _cache_lock:
+            _first_reads.pop(key, None)
+        pending.set()
+
+
+def prewarm(read: Callable[[], dict], key, sig, now: Optional[float] = None) -> None:
+    """Take the first read of ``key`` off the first Desktop poll (boot, background thread).
+    A no-op if a snapshot exists or a read is already running."""
+    if key is None or sig is None:
+        return
+    with _cache_lock:
+        if key in _cache:
+            return
+    _first_read(read, key, sig, time.monotonic() if now is None else now)
