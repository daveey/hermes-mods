From fb794abb7166ac2c088eba2f4bcb39b7a2d7f6ec Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 18:51:11 +0000
Subject: [PATCH] fix(kanban): book the managed submitter's refusal as its
 run's receipt [daveey]

A bound managed run's crash diagnosis no longer trusts the shared task log
(an older run's submitter can flush into it), but the owner's refusal text
("Kanban owner refused: Gateway inaccessible: service_identity_unverified")
is printed by kanban_worker_client, never by the interpreter, so the
owner-death classifier lost it and charged the card.

The submitter now books its refusal/error exit as a worker_result under its
own pid (tasks.worker_pid), the exact task/run_id/claim_lock, fenced on the
task and run row still running that attempt with that worker. An existing
receipt for the run (the interpreter's own, e.g. a quota wall) is kept.

Tests: the real main() refusal writes the qualified receipt; main() through
the sweep books owner_restart_lost; a bound run with the refusal only in the
log stays a crash; late run-A refusals never land on run B; the
interpreter's 75 is not superseded. Owner-death fixture now uses the
production writer keyed on the submitter.
---
 hermes_cli/kanban_worker_client.py          |  26 +++-
 hermes_cli/kanban_worker_log.py             |  48 +++++-
 tests/hermes_cli/test_kanban_owner_death.py | 153 +++++++++++++++++++-
 3 files changed, 217 insertions(+), 10 deletions(-)

diff --git a/hermes_cli/kanban_worker_client.py b/hermes_cli/kanban_worker_client.py
index e5e8e888812..8ac840ce0e0 100644
--- a/hermes_cli/kanban_worker_client.py
+++ b/hermes_cli/kanban_worker_client.py
@@ -260,7 +260,24 @@ def main():
     return rc
 
 
+def _book_refusal(params, board_db, rc, line):
+    """Book this submitter's refusal as its run's receipt (``record_submitter_result``): a bound
+    run's crash diagnosis never trusts the shared task log, so the line printed below would
+    otherwise be lost to the owner-death classifier. Never raises: the exit must not depend on it. [daveey]"""
+    if params is None or not board_db:
+        return
+    try:
+        from hermes_cli import kanban_db as kb
+        from hermes_cli.kanban_db_connect import connect_closing
+        from hermes_cli.kanban_worker_log import record_submitter_result
+        with connect_closing(Path(board_db)) as conn, kb.write_txn(conn):
+            record_submitter_result(conn, params, os.getpid(), rc, line)
+    except Exception:  # health: allow BLE001 -- the receipt is best effort; the log line and exit trailer stand
+        pass
+
+
 def _submit():
+    params = board_db = None
     try:
         params = {'board': os.environ['HERMES_KANBAN_BOARD'], 'task_id': os.environ['HERMES_KANBAN_TASK'],
             'run_id': int(os.environ['HERMES_KANBAN_RUN_ID']), 'claim_lock': os.environ['HERMES_KANBAN_CLAIM_LOCK']}
@@ -279,11 +296,14 @@ def _submit():
         print(f'Kanban owner restarted: {exc}', file=sys.stderr)
         return KANBAN_OWNER_RESTART_EXIT_CODE
     except (KeyError, ValueError, OSError) as exc:
-        print(f'Kanban owner refused: {exc}', file=sys.stderr)
+        line = f'Kanban owner refused: {exc}'
+        print(line, file=sys.stderr)
+        rc = 1
         if getattr(exc, 'owner_unavailable', False):
             from hermes_cli.kanban_owner_unavailable import KANBAN_OWNER_UNAVAILABLE_EXIT_CODE
-            return KANBAN_OWNER_UNAVAILABLE_EXIT_CODE
-        return 1
+            rc = KANBAN_OWNER_UNAVAILABLE_EXIT_CODE
+        _book_refusal(params, board_db, rc, line)
+        return rc
 
 
