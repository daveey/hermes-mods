From 6ff47d82fc70a1a11d5d0b006c02a9e5ae8e8774 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 04:50:24 +0000
Subject: [PATCH] fix(workers): preserve saved toolset normalization for
 credentials [daveey]

Address review R1 on PR4009: share YAML name coercion and legacy hermes
bundle expansion with the canonical platform tools reader. Normalize only
explicit names, not its default-added plugin/MCP tools, and intersect with
the worker's effective selection as before.

Regression: two bootstrap tests fail on reviewed 0e1a325902 (missing search
credential for [hermes], AttributeError for [web, 12306]) and pass here.
109 consumer files: 2406 passed, 0 failed, 17 skipped. Full scripts/check
--base origin/main passes.
---
 gateway/session_worker_credentials.py         |  4 ++--
 hermes_cli/tools_config.py                    | 23 ++-----------------
 hermes_cli/toolset_validation.py              |  6 +++++
 .../test_managed_worker_tool_credentials.py   |  2 ++
 4 files changed, 12 insertions(+), 23 deletions(-)

diff --git a/gateway/session_worker_credentials.py b/gateway/session_worker_credentials.py
index 1a2f645881..2c5ff35c34 100644
--- a/gateway/session_worker_credentials.py
+++ b/gateway/session_worker_credentials.py
@@ -164,7 +164,7 @@ def tool_environment(authority, policy, config):
     """Only explicitly selected tool credentials; platform delivery stays with the owner."""
     from tools.registry import registry
     from toolsets import resolve_toolset
-    from hermes_cli.toolset_validation import parse_platform_toolsets_value
+    from hermes_cli.toolset_validation import normalize_saved_toolset_names, parse_platform_toolsets_value
     from tools.environments.local_env_policy import _is_hermes_internal_secret
     request = json.loads(policy.request_json)
     platform = 'acp' if policy.source == 'acp' else 'cli'
@@ -173,7 +173,7 @@ def tool_environment(authority, policy, config):
     explicit = parse_platform_toolsets_value(explicit)
     if not explicit:
         return {}
-    permitted = {name for toolset in explicit for name in resolve_toolset(toolset)}
+    permitted = {name for toolset in normalize_saved_toolset_names(explicit) for name in resolve_toolset(toolset)}
     selected = {name for toolset in policy.current_toolsets(config) for name in resolve_toolset(toolset)} & permitted
     names = {name for entry in registry.get_all_entries() if entry.name in selected
              for name in entry.requires_env if isinstance(name, str) and not _is_hermes_internal_secret(name)
diff --git a/hermes_cli/tools_config.py b/hermes_cli/tools_config.py
index 6bfe294ebc..4471dac51c 100644
--- a/hermes_cli/tools_config.py
+++ b/hermes_cli/tools_config.py
@@ -585,27 +585,8 @@ def _get_platform_tools(config: dict, platform: str, *, include_default_mcp_serv
     explicitly_configured = isinstance(toolset_names, list)
     if not explicitly_configured:
         toolset_names = [_platform_default_toolset(platform)]
-    # YAML may parse bare numeric names (``12306:``) as int; normalise so sorted() never mixes types.
-    toolset_names = [str(ts) for ts in toolset_names]
-
-    # Expand legacy toolset aliases.  Older Hermes versions and clients used
-    # bare ``"hermes"`` as a composite toolset covering both the CLI and the
-    # API-server surface.  Modern code expects ``"hermes-cli"`` (and
-    # ``"hermes-api-server"`` for the HTTP endpoint), so configs persisted
-    # by those older versions still carry the legacy name; without expansion
-    # ``resolve_toolset("hermes")`` returns ``[]`` — all tools silently
-    # disappear.
-    _LEGACY_TOOLSET_ALIASES: dict = {
-        "hermes": ("hermes-cli", "hermes-api-server"),
-    }
-    expanded: list = []
-    for name in toolset_names:
-        aliases = _LEGACY_TOOLSET_ALIASES.get(name)
-        if aliases:
-            expanded.extend(aliases)
-        else:
-            expanded.append(name)
-    toolset_names = expanded
+    from hermes_cli.toolset_validation import normalize_saved_toolset_names
+    toolset_names = normalize_saved_toolset_names(toolset_names)
 
     configurable_keys = _configurable_keys()
     plugin_ts_keys = _get_plugin_toolset_keys()
diff --git a/hermes_cli/toolset_validation.py b/hermes_cli/toolset_validation.py
index 3583318954..6eb2bc2811 100644
--- a/hermes_cli/toolset_validation.py
+++ b/hermes_cli/toolset_validation.py
@@ -31,6 +31,12 @@ def parse_platform_toolsets_value(value: object) -> Optional[list[str]]:
     return None
 
 
+def normalize_saved_toolset_names(names: list) -> list[str]:
+    """Normalize YAML names and expand legacy bundles, without adding default tools."""
+    aliases = {'hermes': ('hermes-cli', 'hermes-api-server')}
+    return [expanded for name in names for expanded in aliases.get(str(name), (str(name),))]
+
+
 def _platform_default_toolset(platform: object) -> str:
     info = PLATFORMS.get(platform)
     return info.default_toolset if info is not None else f"hermes-{platform}"
diff --git a/tests/gateway/test_managed_worker_tool_credentials.py b/tests/gateway/test_managed_worker_tool_credentials.py
index d712587dfc..8924111914 100644
--- a/tests/gateway/test_managed_worker_tool_credentials.py
+++ b/tests/gateway/test_managed_worker_tool_credentials.py
@@ -12,6 +12,8 @@ from tests.gateway.test_managed_turn_contract import assignment
     ({}, {}),
     ({'platform_toolsets': {'cli': ['web']}}, {'EXA_API_KEY': 'synthetic-search'}),
     ({'platform_toolsets': {'cli': "['web']"}}, {'EXA_API_KEY': 'synthetic-search'}),
+    ({'platform_toolsets': {'cli': ['hermes']}}, {'EXA_API_KEY': 'synthetic-search'}),
+    ({'platform_toolsets': {'cli': ['web', 12306]}}, {'EXA_API_KEY': 'synthetic-search'}),
     ({'platform_toolsets': {'acp': ['web']}}, {}),
     ({'platform_toolsets': {'cli': []}}, {}),
     ({'platform_toolsets': {'cli': 'invalid'}}, {}),
-- 
