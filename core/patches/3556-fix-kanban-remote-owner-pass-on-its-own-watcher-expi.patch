+def test_remote_notice_admitted_while_the_notifier_deliveries_are_blocked(env, monkeypatch):
+    """The remote owner pass has its own watcher and cadence (t_01a1d4de28a8510d): it ran inline after the
+    notifier's local deliveries, so a slow delivery or a slow pass held both and the MacBook admitted busy-chat
+    remote notices 13-88 s after it first saw them. A notifier stuck in a delivery must not hold it back."""
+    from gateway import kanban_watchers as kw
+    hub, runner, authority, fifo, db = env
+    authority.sessions[CHAT] = _Live(CHAT)
+    _busy(db, fifo)
+    runner._running = True
+    runner._KANBAN_WATCHER_START_DELAY = 0.0
+    in_delivery = asyncio.Event()
+    blocker = asyncio.Event()  # never set while the remote notice is waited for
+
+    class _StuckNotification:
+        def __init__(self, *a, **k):
+            pass
+
+        async def deliver(self):
+            in_delivery.set()
+            await blocker.wait()
+
+    monkeypatch.setattr(kw, "_notifier_collect", lambda *a, **k: [{"local": "delivery"}])
+    monkeypatch.setattr(kw, "_KanbanNotification", _StuckNotification)
+
+    async def scenario():
+        notifier = asyncio.ensure_future(runner._kanban_notifier_watcher(interval=1))
+        await asyncio.wait_for(in_delivery.wait(), 5)
+        owner = asyncio.ensure_future(runner._kanban_remote_owner_watcher(interval=1))
+        _publish(hub, [_done("t_01a1cfabf44499dd")])
+        try:
+            # within 2 owner-pass intervals (1 s each), plus slack for the pass itself
+            await async_wait_until(fifo.queued, timeout=2 * 1.0 + 0.5,
+                                   what="remote notice admitted within 2 owner-pass intervals")
+            assert not blocker.is_set() and not notifier.done()  # the local delivery is still stuck
+        finally:
+            runner._running = False
+            blocker.set()
+            await asyncio.wait_for(asyncio.gather(notifier, owner), 5)  # stopped between passes, not cancelled
+
+    asyncio.run(scenario())
+    [queued] = fifo.queued()
+    assert "t_01a1cfabf44499dd" in queued["text"]
+    assert _ledger("t_01a1cfabf44499dd")["holder_pid"] == os.getpid()  # claim in flight, not stranded
+
+
+def test_remote_owner_watcher_honours_notify_in_gateway(env, monkeypatch):
+    from hermes_cli import config as hc
+    _hub, runner, _authority, _fifo, _db = env
+    runner._running = True
+    calls = []
+    monkeypatch.setattr(hc, "load_config", lambda: {"kanban": {"notify_in_gateway": False}})
+    monkeypatch.setattr(kro, "tick", lambda *a, **k: calls.append(a))
+    asyncio.run(asyncio.wait_for(runner._kanban_remote_owner_watcher(interval=1), 2))
+    assert calls == []
+
+
+def test_the_notifier_loop_no_longer_runs_the_remote_owner_pass(env, monkeypatch):
+    """Exactly one caller of ``kro.tick`` (not re-entrant): the supervised remote owner watcher."""
+    from gateway import kanban_watchers as kw
+    _hub, runner, _authority, _fifo, _db = env
+    runner._running = True
+    runner._KANBAN_WATCHER_START_DELAY = 0.0
+    calls = []
+
+    async def tick(*a, **k):
+        calls.append(a)
+        return []
+
+    def collect(*a, **k):
+        runner._running = False  # one notifier pass
+        return []
+    monkeypatch.setattr(kro, "tick", tick)
+    monkeypatch.setattr(kw, "_notifier_collect", collect)
+    asyncio.run(asyncio.wait_for(runner._kanban_notifier_watcher(interval=1), 5))
+    assert calls == []
+    assert "_kanban_remote_owner_watcher" in GatewayRunner._PRE_RECONNECT_WATCHERS
diff --git a/tests/tui_gateway/test_kanban_remote_expired_scan.py b/tests/tui_gateway/test_kanban_remote_expired_scan.py
new file mode 100644
index 0000000000..c0fa3e1a3d
--- /dev/null
+++ b/tests/tui_gateway/test_kanban_remote_expired_scan.py
@@ -0,0 +1,75 @@
+"""An expired remote state costs a transcript scan once, on its first settle, never on every pass. [daveey]
+
+MacBook gateway, 2026-11-13 04:28-04:40 PST (t_01a1d4de28a8510d): ``collect`` asked ``transcript_has`` for every
+card whose observed state was past ``LATE_MAX_S`` on every pass, before ``_claim_notice`` looked at the ledger. Two
+busy chats carried 158 and 207 such cards, all already settled, so each owner pass spent 12-20 s in lineage
+notice-key scans whose answer was never used, and the 5 s notifier loop it shares ran 13-88 s late.
+"""
+import logging
+import sqlite3
+
+from tests.tui_gateway.test_kanban_remote_late_observed import REF, T0, TID, _chat, _ledger_row, \
+    _observed_then_starved
+from tui_gateway import kanban_remote_notices as krn
+from tests.tui_gateway.test_kanban_remote_notices import CHAT
+
+GONE = T0 + 120 + 72 * 3600 + 600  # past the 72 h late window
+
+
+class _Has:
+    def __init__(self, answer: bool) -> None:
+        self.answer, self.calls = answer, []
+
+    def __call__(self, key: str, task_id: str) -> bool:
+        self.calls.append((key, task_id))
+        return self.answer
+
+
+def test_expired_state_scans_the_transcript_once_then_never_again(tmp_path, caplog):
+    ledger = tmp_path / "ledger.db"
+    with _chat(tmp_path):
+        replica = _observed_then_starved(tmp_path, ledger)
+        has = _Has(False)
+        with caplog.at_level(logging.INFO, logger=krn.logger.name):
+            assert krn.collect(CHAT, "default", hub_db=replica, ledger=ledger, now=GONE, transcript_has=has) == []
+            assert len(has.calls) == 1  # the first settle chooses "transcript" vs "expired"
+            for n in range(1, 6):  # later passes (the owner pass runs every few seconds), restarts included
+                if n % 2:
+                    krn._reset_for_tests()
+                assert krn.collect(CHAT, "default", hub_db=replica, ledger=ledger, now=GONE + 10 * n,
+                                   transcript_has=has) == []
+        assert len(has.calls) == 1, f"settled expired card rescanned {len(has.calls) - 1} more time(s)"
+    row = _ledger_row(ledger, CHAT, REF)
+    assert row["delivered"] == krn.SETTLED and row["settled"] == "expired"
+    warnings = [r for r in caplog.records if r.levelno == logging.WARNING and r.name == krn.logger.name]
+    assert len(warnings) == 1 and TID in warnings[0].getMessage()
+
+
+def test_expired_state_already_in_the_transcript_settles_transcript_without_a_warning(tmp_path, caplog):
+    ledger = tmp_path / "ledger.db"
+    with _chat(tmp_path):
+        replica = _observed_then_starved(tmp_path, ledger)
+        has = _Has(True)
+        with caplog.at_level(logging.INFO, logger=krn.logger.name):
+            assert krn.collect(CHAT, "default", hub_db=replica, ledger=ledger, now=GONE, transcript_has=has) == []
+            assert krn.collect(CHAT, "default", hub_db=replica, ledger=ledger, now=GONE + 30,
+                               transcript_has=has) == []
+        assert len(has.calls) == 1
+    row = _ledger_row(ledger, CHAT, REF)
+    assert row["delivered"] == krn.SETTLED and row["settled"] == "transcript"
+    assert not [r for r in caplog.records if r.levelno == logging.WARNING and r.name == krn.logger.name]
+    with sqlite3.connect(ledger) as conn:
+        assert conn.execute("SELECT reason FROM swept").fetchall() in ([], [("transcript",)])
+
+
+def test_many_settled_expired_cards_cost_no_scan_per_pass(tmp_path):
+    """The live shape: a long-lived chat with many expired cards, all settled. A pass scans none of them."""
+    ledger = tmp_path / "ledger.db"
+    with _chat(tmp_path):
+        replica = _observed_then_starved(tmp_path, ledger)
+        has = _Has(False)
+        krn.collect(CHAT, "default", hub_db=replica, ledger=ledger, now=GONE, transcript_has=has)
+        has.calls.clear()
+        for n in range(20):
+            krn.collect(CHAT, "default", hub_db=replica, ledger=ledger, now=GONE + 5 * (n + 1), transcript_has=has)
+        assert has.calls == []
