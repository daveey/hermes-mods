From 67ac7b45f89e93f82bbefe43191a1ce67387c1b5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 12:08:39 +0000
Subject: [PATCH] [daveey] fix(kanban): exempt in-memory sort scratch from
 board lock scan

The lockguard source scan flags ordered() even though its literal :memory: database never opens a board file. Use the existing line-scoped exemption rather than allowlisting the module or weakening board protection.

Proof: main f7f3d558 reproduces test_kanban_modules_open_boards_only_through_the_guard red at kanban_shadow_view.py:126. With the exemption, the complete lockguard, shadow-view and board-shadow suites pass; scripts/check --base origin/main passes. This isolates the repair already present in PR3752 from its unrelated admission changes.
---
 hermes_cli/kanban_shadow_view.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_shadow_view.py b/hermes_cli/kanban_shadow_view.py
index 86a4331de5..4a3f9e1ecf 100644
--- a/hermes_cli/kanban_shadow_view.py
+++ b/hermes_cli/kanban_shadow_view.py
@@ -123,7 +123,7 @@ def ordered(tasks: list[tuple[Any, Optional[str]]], order_by: Optional[str]) ->
         return tasks
     from hermes_cli import kanban_db as kb
     expression = kb.VALID_SORT_ORDERS[order_by.strip().lower()]
-    with sqlite3.connect(":memory:") as order:
+    with sqlite3.connect(":memory:") as order:  # noqa: kanban-lockguard -- sort scratch, not a board
         order.execute("CREATE TABLE cards (position INTEGER, id TEXT, created_at INTEGER, priority INTEGER, "
                       "status TEXT, assignee TEXT, title TEXT, started_at INTEGER, completed_at INTEGER)")
         order.executemany("INSERT INTO cards VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)", [
