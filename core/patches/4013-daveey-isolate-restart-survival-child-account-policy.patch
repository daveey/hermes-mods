From 902711fb17becbd7116593ba8e8dbb47c6bdee2a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 01:01:51 +0000
Subject: [PATCH] [daveey] isolate restart-survival child account policy

The exec parent loses conftest policy_root isolation, so enrolled worker hosts refuse its claim and then spawn crashes on None. Set the supported temp-only policy override explicitly and assert the child resolves it. Surface parent stderr when readiness fails; preserve both real entrypoint teardown assertions and deadlines.

Proof: exact bea95711b65 on worker-2 fails both tests with real-account inventory refusal in parent.log; same host/base with override passes 2/2 in 5.6s. Local restart-survival and account-board suites pass 26/26; full scripts/check passes.
---
 tests/hermes_cli/test_kanban_restart_survival.py | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_restart_survival.py b/tests/hermes_cli/test_kanban_restart_survival.py
index 70fd2c34fb..54de31ff63 100644
--- a/tests/hermes_cli/test_kanban_restart_survival.py
+++ b/tests/hermes_cli/test_kanban_restart_survival.py
@@ -63,7 +63,9 @@ from pathlib import Path
 from hermes_cli import kanban_db as kb
 from hermes_cli import kanban_db_connect as kbc
 from hermes_cli import kanban_db_dispatch as d
+from hermes_cli import worker_compute_capacity as capacity
 root = Path({str(tmp_path)!r})
+assert capacity.policy_root() == root, 'child account policy must be isolated'
 d._worker_argv = lambda *a: [{sys.executable!r}, '-c', {worker_code!r}]
 d._retag_legacy_worker_sessions = lambda *a: None
 with kbc.connect_closing(root / 'board.db') as conn:
@@ -74,6 +76,9 @@ with kbc.connect_closing(root / 'board.db') as conn:
 while True: time.sleep(1)
 '''
     env = dict(os.environ)
+    # conftest's in-process policy_root patch does not cross exec. Keep the
+    # child's admission inventory away from the real worker account as well.
+    env['HERMES_TEST_POLICY_ROOT'] = str(tmp_path)
     for key in list(env):
         if key.startswith('HERMES_KANBAN_') and key != 'HERMES_KANBAN_DB':
             env.pop(key)
@@ -82,7 +87,11 @@ while True: time.sleep(1)
                               stderr=(tmp_path / 'parent.log').open('w'))
     pid = None
     try:
-        wait_for(lambda: (tmp_path / 'parent-ready').exists())
+        try:
+            wait_for(lambda: (tmp_path / 'parent-ready').exists())
+        except AssertionError:
+            print((tmp_path / 'parent.log').read_text())
+            raise
         # write_text truncates before it writes; wait for the pid, not the file.
         wait_for(lambda: (tmp_path / 'worker-ready').exists()
                  and (tmp_path / 'worker-ready').read_text().strip().isdigit())
-- 
