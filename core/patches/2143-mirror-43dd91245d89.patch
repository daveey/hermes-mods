From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 14:35:26 -0800
Subject: [PATCH] [daveey] Retain withdrawal custody across wake dispatch and
 older claim acknowledgments

Review found two interleavings missed by archive-before-claim/passive-only fixtures. Worker owns ack after dispatched wake; archive cleanup requires no later unclaimed events. Remove unfenced surface cleanup. RED: 2 behavioral failures with 8 controls passing. GREEN: 32 focused tests then final 42 tests across five files; independent re-review still pending.
---
 gateway/kanban_watchers_notifier.py           |  4 +-
 hermes_cli/kanban_db_notify.py                |  4 +-
 .../test_kanban_request_withdrawal.py         | 60 +++++++++++++++++++
 tui_gateway/kanban_unloaded.py                |  3 +
 tui_gateway/session_notifications.py          |  2 +-
 5 files changed, 68 insertions(+), 5 deletions(-)

diff --git a/gateway/kanban_watchers_notifier.py b/gateway/kanban_watchers_notifier.py
index 5b05374b036..c8388210be1 100644
--- a/gateway/kanban_watchers_notifier.py
+++ b/gateway/kanban_watchers_notifier.py
@@ -868,6 +868,4 @@ class _KanbanNotification:
         await self.advance()
         if not is_push:
             self.clear_failures()
-        # Unsubscribe only on archive; ``done`` is reversible.
-        if self.task and self.task.status == "archived":
-            await self.unsub()
+        # advance/ack removes archived subscriptions only after all events drain.
diff --git a/hermes_cli/kanban_db_notify.py b/hermes_cli/kanban_db_notify.py
index 2f5ac0773f0..3d6e251a529 100644
--- a/hermes_cli/kanban_db_notify.py
+++ b/hermes_cli/kanban_db_notify.py
@@ -868,7 +868,9 @@ def ack_notify_claim(
             "WHERE s.task_id = ? AND s.platform = ? AND s.chat_id = ? AND s.thread_id = ?", key,
         ).fetchone()
         if row is not None and row["inflight_from"] is None and row["status"] == "archived":
-            conn.execute("DELETE FROM kanban_notify_subs " + _SUB_KEY_WHERE, key)
+            conn.execute("DELETE FROM kanban_notify_subs " + _SUB_KEY_WHERE
+                         + " AND NOT EXISTS (SELECT 1 FROM task_events e WHERE e.task_id = ? AND e.id > ?)",
+                         (*key, task_id, int(upto)))
     return cur.rowcount > 0
 
 
