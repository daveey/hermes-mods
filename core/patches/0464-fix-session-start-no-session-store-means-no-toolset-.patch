From 4af6ea3a8172f0babc1642e2b8433e0b0d46d523 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 04:20:09 -0700
Subject: [PATCH] fix(session-start): no session store means no toolset pin,
 not a crash [daveey]

54178461e4 made _make_agent look up the start pin on _get_db(), which returns
None when state.db cannot open (the gateway deliberately continues without
state.db features). session_toolsets_for(None, ...) raised AttributeError, so
every agent build without a store crashed; main CI went red on 30+ tui_gateway
tests ('NoneType' object has no attribute '_read_one'). No store means no
ledger, so no start can have pinned anything: return None. A lookup failure on
a real store still propagates and refuses the build.
---
 tests/tui_gateway/test_start_toolsets.py | 18 ++++++++++++++++++
 tui_gateway/session_start_requests.py    |  5 +++++
 2 files changed, 23 insertions(+)

diff --git a/tests/tui_gateway/test_start_toolsets.py b/tests/tui_gateway/test_start_toolsets.py
index eb211e9f00..7c6b83446f 100644
--- a/tests/tui_gateway/test_start_toolsets.py
+++ b/tests/tui_gateway/test_start_toolsets.py
@@ -176,6 +176,24 @@ def test_make_agent_without_pin_is_unchanged(monkeypatch, store):
     assert getattr(agent, "_toolset_pin", None) is None
 
 
+def test_no_session_store_means_no_pin_and_the_build_proceeds(monkeypatch, store):
+    # _get_db() returns None when state.db cannot open; the gateway keeps running without
+    # state.db features, so _make_agent must not crash on the pin lookup.
+    assert StartStore.session_toolsets_for(None, "any") is None
+    import run_agent
+    monkeypatch.setattr(run_agent, "AIAgent", _FakeAgent)
+    monkeypatch.setattr(server, "_get_db", lambda: None)
+    monkeypatch.setattr(server, "_load_enabled_toolsets", lambda platform=None: ["terminal"])
+    monkeypatch.setattr(server, "_agent_cbs", lambda sid: {})
+    monkeypatch.setattr(server, "_startup_system_prompt", lambda cfg, key: "")
+    monkeypatch.setattr(server, "_resolve_agent_model_runtime", lambda m, p: ("model", {}))
+    monkeypatch.setattr(server, "_load_cfg", dict)
+    monkeypatch.setattr(server, "_resolve_agent_platform", lambda p=None: "desktop")
+    agent = server._make_agent("sid", "no-db")
+    assert agent.kwargs["enabled_toolsets"] == ["terminal"]
+    assert getattr(agent, "_toolset_pin", None) is None
+
+
 def test_pin_lookup_failure_refuses_the_build(monkeypatch, store):
     sid = _pinned_session(store)
     def boom(*a, **kw):
diff --git a/tui_gateway/session_start_requests.py b/tui_gateway/session_start_requests.py
index e31ef56f54..625f869eec 100644
--- a/tui_gateway/session_start_requests.py
+++ b/tui_gateway/session_start_requests.py
@@ -282,7 +282,12 @@ class StartStore:
         Walks parent_session_id (compression, branches) to the root, so every descendant
         keeps the pin. A missing ledger or column means no pin; any other failure propagates
         so a caller refuses to build rather than silently widening.
+
+        No session store (``_get_db()`` returned None: the gateway runs without state.db
+        features) means no ledger, so no start could have pinned anything: no pin.
         """
+        if db is None:
+            return None
         if db._read_one("SELECT 1 FROM sqlite_master WHERE type='table' AND name='session_start_requests'") is None:
             return None
         if not any(r[1] == "toolsets_json" for r in db._read_all("PRAGMA table_info(session_start_requests)")):
