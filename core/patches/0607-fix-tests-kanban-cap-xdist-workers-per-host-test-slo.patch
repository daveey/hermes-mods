From a8c26642a3c7adde71e87683a7d50ef460f8a063 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 21:46:35 -0700
Subject: [PATCH] fix(tests,kanban): cap xdist workers per host test slot; a
 full max_in_progress is idle, not stuck [daveey]

A direct 'pytest -n 8' held ONE host slot but ran 8 workers: 4 slots x 8 on the 16-core MacBook put
load past 100, while ready cards waited behind max_in_progress=6 and the gateway logged 'dispatcher
stuck ... check profile health' with no reason.

- run_tests_host_slots.xdist_worker_budget(): HERMES_TEST_XDIST_MAX, else cpu_count // host slots.
- tests/conftest.py trims xdist's popen tx list to that budget before nodes start.
- DispatchResult.at_capacity records a full max_in_progress/max_spawn; describe_suppression names it;
  gateway + CLI daemon stuck detectors skip ticks held only by a full cap (all_at_capacity).
---
diff --git a/gateway/kanban_watchers.py b/gateway/kanban_watchers.py
index 5a8843e8a27ab89c61368e8c7a1d64c6e6609530..fce74e65037a9bf1101d07ec242de5f34d343898 100644
--- a/gateway/kanban_watchers.py
+++ b/gateway/kanban_watchers.py
@@ -346,7 +346,8 @@ class GatewayKanbanWatchersMixin:
                             health.publish(dispatcher.successful_scopes)
                         any_spawned = _log_spawn_results(results)
                         ready_pending = await _to_thread_process_service(dispatcher.ready_nonempty)
-                        bad_ticks = bad_ticks + 1 if ready_pending and not any_spawned else 0
+                        capped = _kbd.all_at_capacity(res for _slug, res in (results or []))
+                        bad_ticks = bad_ticks + 1 if ready_pending and not any_spawned and not capped else 0
                     now = int(time.time())
                     if bad_ticks >= _HEALTH_WINDOW and now - last_warn_at >= 300:
                         held = _kbd.describe_suppression(res for _slug, res in (results or []))
diff --git a/hermes_cli/kanban_db_dispatch.py b/hermes_cli/kanban_db_dispatch.py
index 117b5bafe8e3108ae030c0700045f9e08b7178d9..e1e33be416d811e666a25da9d2f8dc70a8d89fe1 100644
--- a/hermes_cli/kanban_db_dispatch.py
+++ b/hermes_cli/kanban_db_dispatch.py
@@ -204,6 +204,10 @@ class DispatchResult:
     skipped_locked: bool = False
     """True when another process held the board's dispatch lock: this tick did
     no DB writes; the lock holder is making progress on the same board."""
+    at_capacity: Optional[str] = None
+    """``"max_in_progress=6/6"`` / ``"max_spawn=3/3"`` when the host or board concurrency cap was full this
+    tick, so no worker could start. A ready queue held only by a full cap is correctly idle, not stuck:
+    the "dispatcher stuck" warning names it instead of blaming profile health. [daveey]"""
     memory_pressure: Optional[str] = None
     """Memory pressure that restricted this tick: ``"critical"`` (no new
     workers), ``"elevated"`` (at most one), ``None`` (no restriction).
@@ -222,6 +226,7 @@ def describe_suppression(results: Iterable[Optional[DispatchResult]]) -> str:
     """
     counts: dict[str, int] = {}
     pressure: Optional[str] = None
+    capacity: Optional[str] = None
     for res in results:
         if res is None:
             continue
@@ -235,12 +240,25 @@ def describe_suppression(results: Iterable[Optional[DispatchResult]]) -> str:
             counts["skipped_owned"] = counts.get("skipped_owned", 0) + 1
         if res.memory_pressure:
             pressure = res.memory_pressure
+        if res.at_capacity:
+            capacity = res.at_capacity
     parts = [f"{k}={v}" for k, v in sorted(counts.items())]
+    if capacity:
+        parts.append(f"at_capacity({capacity})")
     if pressure:
         parts.append(f"memory_pressure={pressure}")
     return ", ".join(parts)
 
 
+def all_at_capacity(results: Iterable[Optional[DispatchResult]]) -> bool:
+    """True when every board's tick that ran was held only by a full concurrency cap (nothing could spawn).
+
+    The "dispatcher stuck" detectors skip such ticks: ready work waiting behind ``kanban.max_in_progress``
+    running workers is the cap doing its job (stale/timeout reclaim frees hung workers). [daveey]"""
+    ran = [res for res in results if res is not None and not res.skipped_locked]
+    return bool(ran) and all(res.at_capacity for res in ran)
+
+
 # Bounded registry of recently-reaped worker exits, filled by the reap loop in
 # ``dispatch_once`` and read by ``detect_crashed_workers`` to classify a dead-pid
 # task. Entry: ``pid -> (raw_wait_status, reaped_at_epoch)``; raw status kept so
@@ -2463,12 +2481,14 @@ def _tick_spawn_budget(
     # Both ready and review loops consume from the same budget.
     if max_spawn is not None:
         if running_count >= max_spawn:
+            result.at_capacity = f"max_spawn={running_count}/{max_spawn}"
             return False, None
         spawn_budget = max_spawn - running_count
 
     if max_in_progress is not None:
         total_running = running_count + count_running_tasks_other_boards(board)
         if total_running >= max_in_progress:
+            result.at_capacity = f"max_in_progress={total_running}/{max_in_progress}"
             return False, None
         remaining = max_in_progress - total_running
         if spawn_budget is None or spawn_budget > remaining:
diff --git a/hermes_cli/kanban_ops.py b/hermes_cli/kanban_ops.py
index f07b3d7372fadb6c7445c02142adb3d75567285a..c13a9600f358db6e2f88f829abc70779e14412e4 100644
--- a/hermes_cli/kanban_ops.py
+++ b/hermes_cli/kanban_ops.py
@@ -224,7 +224,7 @@ def _cmd_daemon(args: argparse.Namespace) -> int:
 
     def _on_tick(res):
         ready_pending = bool(res.skipped_unassigned) or _ready_queue_nonempty()
-        if ready_pending and not res.spawned:
+        if ready_pending and not res.spawned and not res.at_capacity:  # a full cap is idle, not stuck [daveey]
             health_state["bad_ticks"] += 1
         else:
             health_state["bad_ticks"] = 0
diff --git a/scripts/run_tests_host_slots.py b/scripts/run_tests_host_slots.py
index e02189c50ba9a300843f8aa3edc55cf3a8b4fee2..fc26a1895f8b50ba33519be6919d7dfadd8abda7 100644
--- a/scripts/run_tests_host_slots.py
+++ b/scripts/run_tests_host_slots.py
@@ -69,6 +69,23 @@ def host_slot_count() -> int:
     return os.cpu_count() or 4
 
 
+def xdist_worker_budget() -> int:
+    """Max xdist workers one slot holder may start: ``HERMES_TEST_XDIST_MAX``, else cpu_count // host slots.
+
+    A direct ``pytest -n 8`` session holds ONE host slot but runs 8 workers, so four slot holders on a
+    16-core Mac ran 32+ workers and the load average passed 100 (ready Kanban cards then sat unclaimed).
+    Capping each holder's workers at its share of the cores keeps slots x workers <= cores. [daveey]
+    """
+    raw = os.environ.get("HERMES_TEST_XDIST_MAX", "").strip()
+    if raw:
+        try:
+            return max(1, int(raw))
+        except ValueError:
+            pass
+    cores = os.cpu_count() or 4
+    return max(1, cores // max(1, host_slot_count()))
+
+
 def host_slot_dir() -> str:
     return os.environ.get("HERMES_TEST_SLOT_DIR") or f"/tmp/hermes-test-slots-{os.getuid()}"  # windows-footgun: ok — POSIX test host slots  # no-tmp: ok — host-wide shared slot dir must be outside per-run scratch
 
diff --git a/tests/hermes_cli/test_kanban_host_cap.py b/tests/hermes_cli/test_kanban_host_cap.py
index b311a2d6591a53e81b561d2597fbda830ebced46..61600855caf0651b9afe4f70f7d02a194a42703c 100644
--- a/tests/hermes_cli/test_kanban_host_cap.py
+++ b/tests/hermes_cli/test_kanban_host_cap.py
@@ -360,3 +360,74 @@ def test_review_budget_still_bounded_by_shared_cap(
 
     # Budget 2 total across both lanes, reservation notwithstanding.
     assert len(res.spawned) == 2
+
+
+# ---------------------------------------------------------------------------
+# 4. A ready queue held only by a full cap is idle, not "stuck" [daveey]
+# ---------------------------------------------------------------------------
+
+
+def test_full_max_in_progress_is_recorded_and_named(kanban_home, all_assignees_spawnable):
+    """Ready cards waiting behind max_in_progress running workers: the tick says why (at_capacity)."""
+    with kbc.connect() as conn:
+        for title in ("busy-1", "busy-2"):
+            assert kb.claim_task(conn, kb.create_task(conn, title=title, assignee="alice")) is not None
+        kb.create_task(conn, title="waits", assignee="alice")
+        spawns: list = []
+        res = kbd.dispatch_once(conn, spawn_fn=_fake_spawn_factory(spawns), max_in_progress=2)
+    assert not spawns
+    assert res.at_capacity == "max_in_progress=2/2"
+    assert "at_capacity(max_in_progress=2/2)" in kbd.describe_suppression([res])
+    assert kbd.all_at_capacity([res])
+
+
+def test_full_max_spawn_is_recorded(kanban_home, all_assignees_spawnable):
+    with kbc.connect() as conn:
+        assert kb.claim_task(conn, kb.create_task(conn, title="busy", assignee="alice")) is not None
+        kb.create_task(conn, title="waits", assignee="alice")
+        res = kbd.dispatch_once(conn, spawn_fn=_fake_spawn_factory([]), max_spawn=1)
+    assert res.at_capacity == "max_spawn=1/1"
+
+
+def test_under_cap_tick_is_not_at_capacity(kanban_home, all_assignees_spawnable):
+    with kbc.connect() as conn:
+        kb.create_task(conn, title="runs", assignee="alice")
+        res = kbd.dispatch_once(conn, spawn_fn=_fake_spawn_factory([]), max_in_progress=2)
+    assert res.at_capacity is None
+    assert not kbd.all_at_capacity([res])
+
+
+def test_all_at_capacity_needs_every_ticked_board_capped():
+    capped, free = kb.DispatchResult(), kb.DispatchResult()
+    capped.at_capacity = "max_in_progress=6/6"
+    locked = kb.DispatchResult()
+    locked.skipped_locked = True
+    assert kbd.all_at_capacity([capped, None, locked])
+    assert not kbd.all_at_capacity([capped, free])
+    assert not kbd.all_at_capacity([])
+    assert not kbd.all_at_capacity([locked]), "no board actually ticked"
+
+
+def _daemon_stderr(monkeypatch, capsys, res, ticks=8):
+    import argparse
+    from hermes_cli import kanban_ops
+
+    monkeypatch.setattr(kbd, "has_spawnable_ready", lambda conn: True)
+
+    def fake_run_daemon(*, on_tick, **_kw):
+        for _ in range(ticks):
+            on_tick(res)
+
+    monkeypatch.setattr(kbd, "run_daemon", fake_run_daemon)
+    assert kanban_ops._cmd_daemon(argparse.Namespace(force=True, interval=1, max=None, pidfile=None)) == 0
+    return capsys.readouterr().err
+
+
+def test_cli_daemon_does_not_warn_stuck_when_cap_is_full(kanban_home, monkeypatch, capsys):
+    res = kb.DispatchResult()
+    res.at_capacity = "max_in_progress=6/6"
+    assert "dispatcher stuck" not in _daemon_stderr(monkeypatch, capsys, res)
+
+
+def test_cli_daemon_still_warns_stuck_when_nothing_holds_spawns(kanban_home, monkeypatch, capsys):
+    assert "dispatcher stuck" in _daemon_stderr(monkeypatch, capsys, kb.DispatchResult())
