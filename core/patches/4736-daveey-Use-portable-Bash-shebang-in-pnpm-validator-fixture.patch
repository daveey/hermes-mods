Subject: [PATCH] [daveey] Use portable Bash shebang in pnpm validator fixture

---
 tests/ci/test_nix_pnpm_cache.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/ci/test_nix_pnpm_cache.py b/tests/ci/test_nix_pnpm_cache.py
index 406e27be572bf00cf594df39f975ab65d30523a5..6dafd23f5cb2d35eb32027c532be8cc1f29b44b8 100644
--- a/tests/ci/test_nix_pnpm_cache.py
+++ b/tests/ci/test_nix_pnpm_cache.py
@@ -31,7 +31,7 @@ def test_pnpm_restores_without_saving_and_bounds_validation():
 @pytest.mark.parametrize('fail_call', [0, 1, 2])
 def test_validation_rebuilds_cached_output_and_reports_mismatch(tmp_path, fail_call):
     fake = tmp_path / 'nix'
-    fake.write_text('''#!/bin/bash
+    fake.write_text('''#!/usr/bin/env bash
 printf '%s\\n' "$*" >> "$RUNNER_TEMP/calls"
 count=$(wc -l < "$RUNNER_TEMP/calls")
 if [ "$count" = "$FAIL_CALL" ]; then
