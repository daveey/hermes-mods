From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 14:13:01 +0000
Subject: [PATCH] test(kanban): reconcile registry-only review consumers
 [daveey]

CI44911154178 exposed seven obsolete consumer assertions after removing concrete strong-model preference and retiring model-diversity admission. Main CI44909682195 was green; local five-file reproduction87/7 matched the failing identities. Check deep and standard registry membership, keep attribution separate from admission receipts, prove missing-policy refusal without writes, and select same-author routes by registry ordering even with contradictory strong config. Preserve actual all-provider-wall refusal and quota-episode no-spawn behavior. First focused repair:94 passed across5files with file retries disabled. Full scripts/check:21 gates pass. Required new-head CI and independent review remain mandatory.
---
 tests/hermes_cli/test_kanban_model_assignment.py  |  3 ++-
 tests/hermes_cli/test_kanban_model_tier.py        |  5 ++++-
 .../hermes_cli/test_kanban_quota_episode_walls.py | 15 ++++++++++-----
 .../test_kanban_review_declared_implementers.py   |  7 +++++--
 .../hermes_cli/test_kanban_review_model_cycles.py |  5 +++--
 5 files changed, 24 insertions(+), 11 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_model_assignment.py b/tests/hermes_cli/test_kanban_model_assignment.py
index cef3b0e5dc..a43da7e6c0 100644
--- a/tests/hermes_cli/test_kanban_model_assignment.py
+++ b/tests/hermes_cli/test_kanban_model_assignment.py
@@ -91,7 +91,8 @@ def test_dispatch_routes_legacy_incompatible_pin_without_spawning(board, monkeyp
         assert config is not None
         validate_policy(config['model_routing'])
         qualified = {(route['model'], route['provider'])
-                     for route in eligible_routes(config['model_routing'], 'standard', class_requirements(config))}
+                     for level in ('deep', 'standard')
+                     for route in eligible_routes(config['model_routing'], level, class_requirements(config))}
         assert len(spawned) == 1 and spawned[0][0] == tid, repr(result)
         assert spawned[0][1:] in qualified
         assert kb.get_task(conn, tid).current_run_id != source_run
diff --git a/tests/hermes_cli/test_kanban_model_tier.py b/tests/hermes_cli/test_kanban_model_tier.py
index b4ae46bef2..31b4f61d68 100644
--- a/tests/hermes_cli/test_kanban_model_tier.py
+++ b/tests/hermes_cli/test_kanban_model_tier.py
@@ -126,10 +126,13 @@ def test_review_lane_uses_deep_class(board):
         _review_source(conn, tid)
         seen = _dispatch(conn)
         events = _tier_events(conn, tid)
+        assert events[-1]['review_independence'] == 'separate_execution'
+        assert 'implementer_models' not in events[-1] and 'implementer_model' not in events[-1]
+        from hermes_cli.kanban_review_model import implementer_models
+        assert implementer_models(conn, kb.get_task(conn, tid)) == {SONNET}
     assert "sdlc-review" in seen[tid][2]
     assert seen[tid][:2] == (OPUS, "anthropic")
     assert events[-1]["reason"] == "review_unpinned"
-    assert events[-1]["implementer_models"] == [SONNET]
 
 
 def test_retry_after_failed_run_uses_deep_class(board):
diff --git a/tests/hermes_cli/test_kanban_quota_episode_walls.py b/tests/hermes_cli/test_kanban_quota_episode_walls.py
index 968f128468..bfe2eaa112 100644
--- a/tests/hermes_cli/test_kanban_quota_episode_walls.py
+++ b/tests/hermes_cli/test_kanban_quota_episode_walls.py
@@ -259,15 +259,20 @@ def test_review_card_waits_when_its_strong_provider_is_walled_elsewhere(board, m
         free = dispatch.check_respawn_guard(conn, tid, lane='review')
         monkeypatch.setattr(walls, 'active_walls', lambda **_k: {'anthropic': float(clock[0] + 3600)})
         walled = dispatch.check_respawn_guard(conn, tid, lane='review')
-        from hermes_cli.kanban_review_model import ReviewModelUnavailable
-        with pytest.raises(ReviewModelUnavailable, match='author|implementer'):
+        # Tier selection may see a standard fallback, but episode admission must
+        # still refuse it: codex is held by this card's authenticated quota receipt.
+        assert tier.resolve_model_tier(conn, kb.get_task(conn, tid), lane='review')[1] == 'openai-codex'
+        from hermes_cli.kanban_review_model import ReviewRouteDeferred
+        monkeypatch.setattr(walls, 'active_walls', lambda **_k: {
+            'anthropic': float(clock[0] + 3600), 'openai-codex': float(clock[0] + 54 * 3600)})
+        with pytest.raises(ReviewRouteDeferred, match='No eligible deep or standard review route'):
             tier.apply_model_tier(conn, kb.get_task(conn, tid), lane='review')
         seen = []
         dispatch.dispatch_once(conn, spawn_fn=lambda task, ws: seen.append(task.id))
         assert seen == []
-    # This fixture has only a review-lane failure, not authenticated implementation evidence.
-    # Even a free provider must not turn unknown authorship into an eligible reviewer.
-    assert free == 'subscription_quota_reset'
+    # Missing model attribution is audit-only: the free eligible deep route is
+    # usable, but neither a deep nor a standard route bypasses real provider walls.
+    assert free is None
     assert walled == 'subscription_quota_reset'
 
 
diff --git a/tests/hermes_cli/test_kanban_review_declared_implementers.py b/tests/hermes_cli/test_kanban_review_declared_implementers.py
index 621583e3a8..1089678871 100644
--- a/tests/hermes_cli/test_kanban_review_declared_implementers.py
+++ b/tests/hermes_cli/test_kanban_review_declared_implementers.py
@@ -126,8 +126,11 @@ def test_a_host_without_a_routing_policy_accepts_no_declaration(board):
     with kbc.connect_closing() as conn:
         task = _review(conn, '<!-- implementer-models: claude-code -->')
         assert review.implementer_models(conn, task) == set()
-        # No author evidence to lift: the strong route still admits a real separate review.
-        assert review.resolve_review_model(conn, task, {'strong_model': routing.OPUS})[0] == routing.OPUS
+        # Concrete strong config is not authority to invent a route without a registry.
+        before = list(conn.iterdump())
+        with pytest.raises(review.ReviewModelsExhausted, match='No eligible deep or standard review route'):
+            review.resolve_review_model(conn, task, {'strong_model': routing.OPUS})
+        assert list(conn.iterdump()) == before
         task = _review(conn, f'<!-- implementer-models: {OPUS} -->')  # a real model, but no policy to confirm it
         assert review.implementer_models(conn, task) == set()
 
