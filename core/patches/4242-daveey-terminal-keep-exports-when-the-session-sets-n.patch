From aab2a557908eab065c684119fe5efc96c17f715b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 14:32:31 +0000
Subject: [PATCH] [daveey] terminal: keep exports when the session sets
 noclobber

The env re-dump (and login bootstrap) wrote `export -p` with a plain `>`
into the file mktemp had just created. A session with noclobber on
(`set -C`, e.g. from BASH_ENV) refuses that redirect, so the dump failed,
`mv` was skipped and every export was silently lost between commands.
Use `>|`, as the askpass prologue already does.

Why it surfaced as a macOS-only red: test_live_local_backend_noclobber_
startup_keeps_caller_input exports PATH to a fake sudo and then runs
`sudo true`. The PATH export never carried, so the command reached the
HOST sudo: on Linux CI that is passwordless and the test passed by
accident; on the mac mini runner it asked for a password and failed
("Sorry, try again"). The test now refuses (exit 97) before any host sudo
can run if the PATH export did not carry.

Proof:
- New test_exports_carry_when_the_session_sets_noclobber and the hardened
  askpass test are RED on main on Linux (worker) and natively on the mac
  mini (bash 3.2), GREEN with the fix on both.
- Linux: 328 passed across persistent-shell, askpass delivery/sdk,
  snapshot injection/leak, local shell init and comment-writer suites.
- macOS (mini, native): 130 passed across the 4 affected files.

Fixes the red `macOS OS-marked tests` workflow on main
(runs 43580978583, 43595806519).
---
 tests/tools/test_local_persistent_shell.py | 20 ++++++++++++++++++++
 tests/tools/test_sudo_askpass_delivery.py  |  4 +++-
 tools/environments/base_session_env.py     |  4 +++-
 3 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/tests/tools/test_local_persistent_shell.py b/tests/tools/test_local_persistent_shell.py
index 067f2ff9c6..3f89b2efa0 100644
--- a/tests/tools/test_local_persistent_shell.py
+++ b/tests/tools/test_local_persistent_shell.py
@@ -73,3 +73,23 @@ def test_profile_functions_survive_only_with_persistence_off(monkeypatch, tmp_pa
         assert run(probe) == later
     finally:
         cleanup_vm(_resolve_container_task_id(task_id))
+
+
+@pytest.mark.platforms("linux", "macos")
+def test_exports_carry_when_the_session_sets_noclobber(monkeypatch, tmp_path):
+    """A ``set -C`` startup (here BASH_ENV) must not stop the env re-dump: it writes into the file
+    mktemp just created, which noclobber refuses for a plain ``>``. Every export was lost that way."""
+    from tools.environments.local import LocalEnvironment
+
+    startup = tmp_path / "bash-env"
+    startup.write_text("set -C\n", encoding="utf-8")
+    temp = tmp_path / "tmp"
+    temp.mkdir()
+    monkeypatch.setenv("TERMINAL_TEMP_DIR", str(temp))
+    env = LocalEnvironment(cwd=str(tmp_path), timeout=10, env={"TMPDIR": str(temp), "BASH_ENV": str(startup)})
+    try:
+        assert env.execute("export HERMES_LP_NOCLOBBER=carried")["returncode"] == 0
+        result = env.execute("echo ${HERMES_LP_NOCLOBBER:-lost}")
+    finally:
+        env.cleanup()
+    assert result["output"].strip() == "carried", result
diff --git a/tests/tools/test_sudo_askpass_delivery.py b/tests/tools/test_sudo_askpass_delivery.py
index 932b6da477..37f29d9e91 100644
--- a/tests/tools/test_sudo_askpass_delivery.py
+++ b/tests/tools/test_sudo_askpass_delivery.py
@@ -777,7 +777,9 @@ def test_live_local_backend_noclobber_startup_keeps_caller_input(configured_pass
     env = LocalEnvironment(cwd=str(tmp_path), timeout=10, env={"TMPDIR": str(temp), "BASH_ENV": str(startup)})
     try:
         assert env.execute(f"export PATH={fake.parent}:$PATH")["returncode"] == 0
-        result = env.execute('read -r p; echo "got:$p"; sudo true', stdin_data="rest\n")
+        # Refuse to reach a host sudo if the PATH export did not carry (it once did not, under set -C).
+        result = env.execute(f'case ":$PATH:" in *":{fake.parent}:"*) ;; *) exit 97 ;; esac; '
+                             'read -r p; echo "got:$p"; sudo true', stdin_data="rest\n")
     finally:
         env.cleanup()
     assert result["returncode"] == 0, result
diff --git a/tools/environments/base_session_env.py b/tools/environments/base_session_env.py
index df47a85db5..14f1f5bb2c 100644
--- a/tools/environments/base_session_env.py
+++ b/tools/environments/base_session_env.py
@@ -138,7 +138,9 @@ def _export_dump_excluding_session_vars(tmp_path: str, excluded_names: Iterable[
         "${!HERMES_RPC_*} HERMES_KERNEL_DIR "
         f"HERMES_UI_SESSION_ID{extra_unset} 2>/dev/null; "
         "export -p; ) || true; } "
-        f"> {tmp_path}")
+        # ``>|``: *tmp_path* is the file mktemp just created, and a session with ``noclobber``
+        # (``set -C``, e.g. from BASH_ENV) refuses a plain ``>`` onto it, losing every export.
+        f">| {tmp_path}")
 
 
 def _snapshot_bootstrap_script(
