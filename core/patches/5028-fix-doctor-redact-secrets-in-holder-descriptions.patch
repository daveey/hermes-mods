From aa1ff0512d4d1860e31b3e5b9e84dd1f021829e3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 16:48:19 -0800
Subject: [PATCH] fix(doctor): redact secrets in holder descriptions

Review follow-up: with no length cut, a holder's --api-key value or URL
credentials would reach doctor output in full (an early secret already
leaked its prefix through the 80-character cut). describe_holder_pid now
runs agent.redact.redact_sensitive_text(force=True,
redact_url_credentials=True) before any cut, for every caller.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_state_holders.py                       | 13 +++++--
 .../test_doctor_fts_deferral_holders.py       | 36 +++++++++++++++++++
 2 files changed, 46 insertions(+), 3 deletions(-)

diff --git a/hermes_state_holders.py b/hermes_state_holders.py
index dd1835d0b6d..ff67faf1b62 100644
--- a/hermes_state_holders.py
+++ b/hermes_state_holders.py
@@ -60,7 +60,8 @@ def _read_proc_argv(pid: int) -> Optional[list[str]]:
 def describe_holder_pid(pid: int, *, limit: Optional[int] = 80) -> str:
     """``PID 123 (hermes gateway run)`` for operator-facing holder lists; /proc argv first, psutil elsewhere.
     The command line is cut to *limit* characters for log and error lines; ``None`` keeps all of it
-    (``hermes doctor``, whose holder lists are read by a person deciding what to stop)."""
+    (``hermes doctor``, whose holder lists are read by a person deciding what to stop). Secrets in the
+    command line (``--api-key`` values, URL credentials) are always redacted."""
     argv = _read_proc_argv(pid)
     if argv is None and psutil is not None:
         try:
@@ -73,8 +74,14 @@ def describe_holder_pid(pid: int, *, limit: Optional[int] = 80) -> str:
         if at is not None and at + 1 < len(argv):
             # An interpreter's inline source (launcher wrappers) would fill the description; its arguments follow.
             argv = [*argv[:at + 1], "<inline code>", *argv[at + 2:]]
-    who = " ".join(" ".join([os.path.basename(argv[0]), *argv[1:]]).split())[:limit] if argv else "command line unavailable"
-    return f"PID {pid} ({who})"
+    if not argv:
+        return f"PID {pid} (command line unavailable)"
+    # Redacted before the cut: holder lists are pasted into issues, and a process's argv can carry
+    # `--api-key …` or credentials in a URL (an early secret used to leak its prefix through the cut too).
+    from agent.redact import redact_sensitive_text
+    who = redact_sensitive_text(" ".join(" ".join([os.path.basename(argv[0]), *argv[1:]]).split()),
+                                force=True, redact_url_credentials=True)
+    return f"PID {pid} ({who[:limit]})"
 
 
 def _looks_like_python_executable(program: str) -> bool:
diff --git a/tests/hermes_cli/test_doctor_fts_deferral_holders.py b/tests/hermes_cli/test_doctor_fts_deferral_holders.py
index a2e6dd9b173..cc9a951122c 100644
--- a/tests/hermes_cli/test_doctor_fts_deferral_holders.py
+++ b/tests/hermes_cli/test_doctor_fts_deferral_holders.py
@@ -167,3 +167,39 @@ def test_doctor_lists_holders_with_their_whole_command_line(tmp_path):
     finally:
         holder.stdin.close()
         holder.wait(timeout=30)
+
+
+@pytest.mark.platforms("linux", "macos")
+def test_holder_descriptions_never_show_secrets_from_argv(tmp_path):
+    """Doctor output is pasted into issues: an API key or URL credentials in a holder's argv are redacted,
+    whole or cut."""
+    from hermes_state_holders import describe_holder_pid
+
+    key = "sk-ant-api03-" + "A1b2C3d4" * 6
+    proc = subprocess.Popen(
+        [
+            sys.executable,
+            "-c",
+            "import sys; print('ready', flush=True); sys.stdin.read()",
+            "--base-url",
+            "http://alice:hunter2pw@10.0.0.1:8000/v1",
+            "--api-key",
+            key,
+        ],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        text=True,
+    )
+    try:
+        assert proc.stdout.readline().strip() == "ready"
+        for desc in (
+            describe_holder_pid(proc.pid, limit=None),
+            describe_holder_pid(proc.pid),
+        ):
+            assert (
+                key[:16] not in desc and "hunter2pw" not in desc and "alice" not in desc
+            ), desc
+        assert "10.0.0.1:8000/v1" in describe_holder_pid(proc.pid, limit=None)
+    finally:
+        proc.stdin.close()
+        proc.wait(timeout=30)
-- 
