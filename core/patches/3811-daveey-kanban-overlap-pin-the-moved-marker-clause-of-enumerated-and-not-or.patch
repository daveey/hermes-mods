From 0fa1a455fdc8d85dfb1d5c785bfa79c689c7e05f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:14:47 +0000
Subject: [PATCH] [daveey] kanban overlap: pin the moved-marker clause of
 enumerated() (and, not or)

`hermes_cli/kanban_overlap_own.py` `enumerated()` returns a moved marker only
when both titles carry one (`if mine_m and their_m:`). Mutating that to
`if (mine_m or their_m):` passed all 51 tests of
tests/tools/test_kanban_create_overlap_same_creator.py: PR #2569's test pins
only the replace-span clause. Under the mutant a moved marker (w1-01) plus a
marker on one side only (w1-02) reads as an enumeration, so own_distinct
admits a same-creator duplicate (fail-open, the class #2429 closed).

Adds a test for both directions of ("w1-01 Fix guard w1-02 tests",
"Fix guard tests w1-01"): enumerated() is None and own_distinct() is None.

Proof (scripts/run_tests.sh via hermes-core-wt test, --file-timeout 900):
- main + test: 53 passed, 0 failed, 0 skipped.
- mutant + test: 51 passed, 2 failed (the two new params,
  `assert (frozenset(), frozenset({'02'})) is None`).

Test-only change. Card t_01a1d67ef556476c.
---
 .../test_kanban_create_overlap_same_creator.py      | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/tests/tools/test_kanban_create_overlap_same_creator.py b/tests/tools/test_kanban_create_overlap_same_creator.py
index 3c93cad892..dc1771f34b 100644
--- a/tests/tools/test_kanban_create_overlap_same_creator.py
+++ b/tests/tools/test_kanban_create_overlap_same_creator.py
@@ -220,3 +220,16 @@ def test_a_replaced_span_with_a_marker_on_one_side_only_is_not_an_enumeration(mi
     card = {"title": theirs, "assignee": "default"}
     assert own.enumerated(mine, theirs) is None
     assert own.own_distinct(mine, "default", card) is None
+
+
+@pytest.mark.parametrize("mine, theirs", [
+    ("w1-01 Fix guard w1-02 tests", "Fix guard tests w1-01"),
+    ("Fix guard tests w1-01", "w1-01 Fix guard w1-02 tests"),
+])
+def test_a_moved_marker_beside_a_one_sided_marker_is_not_an_enumeration(mine, theirs):
+    """A moved marker counts only when both titles carry a different one of its shape: ``w1-01`` moved and
+    ``w1-02`` exists on one side only, so this is a re-issue of the same work, not a leg."""
+    from hermes_cli import kanban_overlap_own as own
+    card = {"title": theirs, "assignee": "default"}
+    assert own.enumerated(mine, theirs) is None
+    assert own.own_distinct(mine, "default", card) is None
