From f32b78414d37e8ed5165ea6ec042c85e51cf5c39 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 05:43:51 +0000
Subject: [PATCH] [daveey] fix(kanban): a card that opens or focuses the
 Desktop app still stays with the app

Review of the previous commit found three live instructions that lost their pin:
"Open a Desktop chat and send one prompt", "Focus the existing Desktop window",
"Open a fresh Hermes Desktop chat". A verb that operates the app within the same
clause as the surface now pins from the body, and the adjective form accepts
"Hermes Desktop".

Proof: replay of old vs new over the hub's kanban and sync-shadow DBs
(read-only): no card gains a pin it did not have. New test file: 31 cases pass;
the 40 test files that touch placement pass (1054 tests).
---
 hermes_cli/kanban_placement.py                         |  9 +++++++--
 .../test_kanban_placement_desktop_surface.py           | 10 ++++++++++
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index d7abf15e72..53f41c322f 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -96,14 +96,19 @@ DESKTOP_SURFACE_MARKER = r"\bdesktop (app|backend|backends|renderer|window|chat|
 # A chat or window the card itself opens or drives in the live app ("a throwaway Desktop chat runs the CLI"):
 # that is work on the machine with the app, wherever in the card it is said.
 LIVE_DESKTOP_MARKER = (r"\b(throwaway|scratch|disposable|hidden|fixture|fresh|new|real|live) "
-                       r"desktop (chat|chats|session|sessions|window)\b")
+                       r"(hermes )?desktop (chat|chats|session|sessions|window)\b")
+# The same need said with a verb: "Open a Desktop chat and send one prompt", "Focus the existing Desktop
+# window". The verb and the surface sit in one sentence, at most a few words apart.
+DESKTOP_ACTION_MARKER = (r"\b(open|opens|opening|start|starts|launch|launches|focus|focuses|click|clicks|"
+                         r"type|types|quit|quits|relaunch|reopen|restart)\b[^.;:,()\n]{0,40}?"
+                         r"\bdesktop (app|chat|chats|window|sidebar)\b")
 # Phrases that mean the work needs this machine (a Mac the user works on). Case-insensitive.
 DEFAULT_LOCAL_MARKERS = (
     r"\bchrome\b", r"\bcdp\b", r"\bkeychain\b", r"\bcodesign", r"\bnotari[sz]", r"\btcc\b",
     r"\bosascript\b", r"\bapple ?script\b", r"\bapple (photos|notes|reminders|contacts|calendar|music)\b",
     r"\bphotos\.app\b", r"\bimessage\b", r"\bfind ?my\b", r"\bremindctl\b", r"\bshortcuts? app\b",
     r"\blaunchd\b", r"\blaunchctl\b", r"launchagents", r"~/library/", r"\bhermes\.app\b",
-    HERMES_DESKTOP_MARKER, DESKTOP_SURFACE_MARKER, LIVE_DESKTOP_MARKER,
+    HERMES_DESKTOP_MARKER, DESKTOP_SURFACE_MARKER, LIVE_DESKTOP_MARKER, DESKTOP_ACTION_MARKER,
     r"\bdesktop\s+dom\b",
     r"\bmacbook\b", MACOS_MARKER, r"\bmac ?mini\b", r"\bthe mini\b", r"\mini-1\b",
     BABYBEAR_MARKER, r"\bxcode\b", r"\bsimulator\b", r"\bwhatsapp\b", r"\bscreen ?shot",
diff --git a/tests/hermes_cli/test_kanban_placement_desktop_surface.py b/tests/hermes_cli/test_kanban_placement_desktop_surface.py
index 2cbc41034b..ba81f0611e 100644
--- a/tests/hermes_cli/test_kanban_placement_desktop_surface.py
+++ b/tests/hermes_cli/test_kanban_placement_desktop_surface.py
@@ -27,6 +27,8 @@ _SYMPTOM_BODIES = [
     "Its completion notice is delivered to the owning session (Desktop chat or Kanban run) exactly once.",
     "Rows created as source=cli show in the Desktop sidebar. Create them as source=tool.",
     "The desktop app for b2bcf494ad was copied from a peer in 205 s while admission was held.",
+    "The worker was cut off mid-turn. The Desktop chat showed no notice afterwards.",
+    "The fix must start from the session row; Desktop chats are otherwise unchanged.",
 ]
 
 
@@ -59,6 +61,10 @@ def test_desktop_surface_in_the_title_still_pins(title):
     "Open a fresh Desktop window and read the status bar.",
     "Start a new Desktop session and send one prompt.",
     "Needs a Desktop DOM readback of the composer",
+    "Open a Desktop chat and send one prompt.",
+    "Focus the existing Desktop window and read the status bar.",
+    "Open a fresh Hermes Desktop chat and send one prompt.",
+    "Quit and relaunch the Desktop app, then read the version.",
 ])
 def test_a_chat_or_window_the_card_drives_in_the_live_app_still_pins(body):
     d = decide({"title": "Prove the notice text", "body": body})
@@ -79,5 +85,9 @@ def test_create_tool_sends_a_card_that_describes_desktop_chats_to_the_hub(mac):
     out = json.loads(kt._handle_create({"title": _TITLE, "body": _BODY}))
     assert out.get("placed", {}).get("gateway") == "hub" and "placement" not in out, out
     assert helpers._local_count() == 0
+    for title, body in (("Prove the notice text", "Open a Desktop chat and send one prompt."),
+                        ("Read the block actor line", "A throwaway Desktop chat runs the CLI block.")):
+        live = json.loads(kt._handle_create({"title": title, "body": body}))
+        assert live["placement"]["where"] == "local" and "desktop chat" in live["placement"]["why"], live
     pinned = json.loads(kt._handle_create({"title": "Desktop app: composer loses focus", "body": "Push the fix."}))
     assert pinned["placement"] == {"where": "local", "why": "local marker: mentions 'desktop app'"}, pinned
-- 
2.43.0

