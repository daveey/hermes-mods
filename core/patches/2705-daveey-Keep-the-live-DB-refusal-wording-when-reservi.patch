From 43c7b4087e01c0d4ca582beb772c52514f4a1215 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 07:56:51 +0000
Subject: [PATCH] [daveey] Keep the live-DB refusal wording when reserving
 offline paths

The reservation change shortened the offline_file_access refusal and dropped
'its main database' for sidecar targets, which the files preview route test
asserts (CI shard 4/8). Restore the original text and name the path in the
nested-reservation refusal.
---
 hermes_cli/sqlite_safe_read.py | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/sqlite_safe_read.py b/hermes_cli/sqlite_safe_read.py
index a1cae32102..88c3140d9c 100644
--- a/hermes_cli/sqlite_safe_read.py
+++ b/hermes_cli/sqlite_safe_read.py
@@ -362,15 +362,19 @@ def offline_file_access(path: Path | str, *, what: str = "read"):
             with _live_lock:
                 main = _live_main_key(key)
                 if main is not None:
+                    subject = "it" if main == key else f"its main database {main}"
                     raise LiveConnectionError(
-                        f"Refusing to {what} {path}: a connection to {main} is still open "
-                        "in this process, and raw file access would cancel its POSIX locks.")
+                        f"Refusing to {what} {path}: a connection to {subject} is still open "
+                        "in this process, and raw file access would cancel that "
+                        "connection's POSIX advisory locks. Close all database "
+                        "handles (stop the gateway/dashboard) and retry.")
                 pending = offline.conflicts(key, raw=True)
                 if not pending:
                     offline.reserve(key, finished)
                     break
                 if recursive or offline.owns_reservation():
-                    raise LiveConnectionError("nested offline file access would wait on another owner")
+                    raise LiveConnectionError(
+                        f"Refusing to {what} {path}: nested offline file access would wait on another owner")
             pending[0][2].wait()
         yield
     finally:
-- 
