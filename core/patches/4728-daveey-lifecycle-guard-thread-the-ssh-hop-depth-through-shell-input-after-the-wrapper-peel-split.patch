From a13b9b4c919fdf8c9bdac03402aface48569b15b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:02:53 +0000
Subject: [PATCH] [daveey] lifecycle guard: thread the ssh hop depth through
 _shell_input after the wrapper-peel split

d5e7156bca moved the ssh branch of _nested_shell_input into _shell_input; the rebase of
this PR's hop-following onto it left `hops` undefined there (F821, 74 session_aliases
failures). Pass it explicitly.
---
 cron/lifecycle_guard_nested_shells.py | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/cron/lifecycle_guard_nested_shells.py b/cron/lifecycle_guard_nested_shells.py
index 34af62ef95904045e0a6a9ec47aa38586eed0a26..cd5b16af9f88df8f33f8819b6298b73cf4098cde 100644
--- a/cron/lifecycle_guard_nested_shells.py
+++ b/cron/lifecycle_guard_nested_shells.py
@@ -322,7 +322,7 @@ def _nested_shell_input(view: list[str], hops: int = 1) -> Optional[tuple[str, O
             lambda word: word.startswith("-"), view[index + 1:]))
         peeled = _peel_transparent_prefixes(view, index, limit=1)
         if peeled == index:
-            return _shell_input(view, index, name, login_exec)
+            return _shell_input(view, index, name, login_exec, hops)
         index = peeled
     return None
 
@@ -361,9 +361,10 @@ def _launcher_shell_input(
 
 
 def _shell_input(
-    view: list[str], index: int, name: str, login_exec: bool,
+    view: list[str], index: int, name: str, login_exec: bool, hops: int = 1,
 ) -> Optional[tuple[str, Optional[str]]]:
-    """``_nested_shell_input`` for the unwrapped command *name* at *index*: ssh or a shell."""
+    """``_nested_shell_input`` for the unwrapped command *name* at *index*: ssh or a shell
+    (*hops*: the ssh hop depth, see ``_remote_reads_stdin``)."""
     arguments = _split_redirections(view[index + 1:])[0]
     if name == "ssh":
         from tools.shell_heredoc import _SSH_VALUE_OPTIONS
