From 1360ebb5baab2b7292d4079c46e99dc981a22640 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 4 Nov 2026 06:13:05 +0000
Subject: [PATCH] [daveey] test(desktop): fork tests speak upstream's dial
 readiness and onboarding scope

Upstream a66e74dc67 gates a public dial's open on the gateway.ready frame
(DialReadiness); the fork's gateway-local-ticket-reconnect Socket mock
never sent it, so the hub primary never opened (15s timeouts). Send the
legacy-peer ready frame on open, as upstream did for
gateway-background-reconnect.

The fork's submit path consumes the pending credential warning, which
captures onboarding scope via getApiRequestConnection; upstream's
remote-negotiated-image @/hermes mock lacked it.
---
 .../use-prompt-actions/remote-negotiated-image.test.tsx      | 1 +
 .../desktop/src/store/gateway-local-ticket-reconnect.test.ts | 5 +++++
 2 files changed, 6 insertions(+)

diff --git a/apps/desktop/src/app/session/hooks/use-prompt-actions/remote-negotiated-image.test.tsx b/apps/desktop/src/app/session/hooks/use-prompt-actions/remote-negotiated-image.test.tsx
index a6822b9fab6..9396c235cd1 100644
--- a/apps/desktop/src/app/session/hooks/use-prompt-actions/remote-negotiated-image.test.tsx
+++ b/apps/desktop/src/app/session/hooks/use-prompt-actions/remote-negotiated-image.test.tsx
@@ -18,6 +18,7 @@ vi.mock('@/api/client', async importOriginal => ({
   ...(await importOriginal<Record<string, unknown>>()), hermesApi: vi.fn()
 }))
 vi.mock('@/hermes', () => ({
+  getApiRequestConnection: () => null, getApiRequestProfile: () => null,
   getLatestSessionMessages: vi.fn(async () => ({ messages: [], session_id: RUNTIME_SESSION_ID })),
   getProfiles: vi.fn(async () => ({ profiles: [] })), getSession: vi.fn(),
   PROMPT_SUBMIT_REQUEST_TIMEOUT_MS: 1_800_000, setApiRequestProfile: vi.fn(), transcribeAudio: vi.fn()
diff --git a/apps/desktop/src/store/gateway-local-ticket-reconnect.test.ts b/apps/desktop/src/store/gateway-local-ticket-reconnect.test.ts
index 3b771492813..30333654b24 100644
--- a/apps/desktop/src/store/gateway-local-ticket-reconnect.test.ts
+++ b/apps/desktop/src/store/gateway-local-ticket-reconnect.test.ts
@@ -35,6 +35,11 @@ class Socket extends EventTarget {
       if (this.readyState !== 0) { return }
       this.readyState = 1
       this.dispatchEvent(new Event('open'))
+      // A real gateway's first frame after accept; empty = a legacy (non-authority) peer.
+      // A native dial is canonical by provenance and ignores it.
+      this.dispatchEvent(new MessageEvent('message', {
+        data: JSON.stringify({ jsonrpc: '2.0', method: 'event', params: { type: 'gateway.ready', payload: {} } })
+      }))
     }, 1)
   }
 
