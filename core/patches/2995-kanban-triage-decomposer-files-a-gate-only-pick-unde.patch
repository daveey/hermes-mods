From e6df829306c796c90b1e81813664b80319fb9b31 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 17:08:08 +0000
Subject: [PATCH] kanban: triage decomposer files a gate-only pick under its
 queue

Review 5878651070 on #1597: the triage auto-decomposer bypassed the create refusal. decompose_triage_task
inserts children by raw INSERT and specify_triage_task UPDATEs the assignee, both with names from
list_profiles(), which includes bb-repair-native.

- _build_roster drops kanban.gate_only_assignees names, so the decomposer never offers or accepts them.
- decompose_triage_task (root + each child) and specify_triage_task map a gate-only assignee to its
  queue via create_assignee(), covering any other caller. assign_task (the gate's path) is unchanged.

Proof: 3 new tests in test_kanban_gate_only.py fail on d38dbcf39e and pass here (12/12); decompose,
decompose_db, decompose_runnable, specify/triage suites green (9 files, 63 tests).
---
 hermes_cli/kanban_db.py                   |  8 +++---
 hermes_cli/kanban_db_graph.py             |  7 +++--
 hermes_cli/kanban_decompose.py            |  3 +++
 tests/hermes_cli/test_kanban_gate_only.py | 33 +++++++++++++++++++++++
 4 files changed, 45 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index 324d77871c..9efb71f89d 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -3615,13 +3615,13 @@ def specify_triage_task(
     conn: sqlite3.Connection, task_id: str, *, title: Optional[str] = None,
     body: Optional[str] = None, assignee: Optional[str] = None, author: Optional[str] = None,
 ) -> bool:
-    """Update title/body/assignee (when given) and move ``triage -> todo`` in one
-    txn; False when not in triage. Lands in ``todo`` (not ``ready``) so parent
-    gating still applies; the audit comment is written only when a field changed.
+    """Update title/body/assignee (when given) and move ``triage -> todo`` in one txn; False when not in triage.
+    Lands in ``todo`` (not ``ready``) so parent gating still applies; the audit comment only when a field changed.
     """
     if title is not None and not title.strip():
         raise ValueError("title cannot be blank")
-    assignee = _canonical_assignee(assignee)
+    from hermes_cli.kanban_gate_only import create_assignee
+    assignee = create_assignee(_canonical_assignee(assignee))  # promotion is not the gate: gate-only -> queue [daveey]
     with write_txn(conn):
         existing = conn.execute(
             "SELECT title, body, assignee FROM tasks WHERE id = ? AND status = 'triage'",
diff --git a/hermes_cli/kanban_db_graph.py b/hermes_cli/kanban_db_graph.py
index 17d83253e1..ea2d739785 100644
--- a/hermes_cli/kanban_db_graph.py
+++ b/hermes_cli/kanban_db_graph.py
@@ -181,8 +181,9 @@ def decompose_triage_task(
 
     if not children:
         return None
+    from hermes_cli.kanban_gate_only import create_assignee
     if root_assignee is not None:
-        root_assignee = _canonical_assignee(root_assignee)
+        root_assignee = create_assignee(_canonical_assignee(root_assignee))  # gate-only -> its queue [daveey]
     _validate_children_graph(children)
 
     # ONE txn so the fan-out is atomic; helpers that open their own write_txn
@@ -279,7 +280,9 @@ def _insert_decomposed_child(
     new_id = new_task_id(conn)
     import json
     from hermes_cli.kanban_capabilities import check_declaration, validate_assignment
-    assignee = _canonical_assignee(child.get("assignee"))
+    from hermes_cli.kanban_gate_only import create_assignee
+    # A fan-out child is a fresh card: a gate-only pick files under its queue, as a create would. [daveey]
+    assignee = create_assignee(_canonical_assignee(child.get("assignee")))
     if require_declaration:
         check_declaration(child.get("requires"), child_ws_kind, assignee=assignee,
                           where=f"tasks[{index}].requires")
diff --git a/hermes_cli/kanban_decompose.py b/hermes_cli/kanban_decompose.py
index f90e551ef9..2a36bd3747 100644
--- a/hermes_cli/kanban_decompose.py
+++ b/hermes_cli/kanban_decompose.py
@@ -167,6 +167,9 @@ def _build_roster() -> tuple[list[dict], set[str]]:
     except Exception as exc:
         logger.warning("decompose: failed to list profiles: %s", exc)
         return [], set()
+    from hermes_cli.kanban_gate_only import gate_only_assignees
+    gate_only = set(gate_only_assignees())  # only their admission gate assigns them, never the decomposer [daveey]
+    all_profiles = [p for p in all_profiles if p.name not in gate_only]
     roster = []
     for p in all_profiles:
         desc = (p.description or "").strip()
diff --git a/tests/hermes_cli/test_kanban_gate_only.py b/tests/hermes_cli/test_kanban_gate_only.py
index 72a9acc38d..8cee6cfabd 100644
--- a/tests/hermes_cli/test_kanban_gate_only.py
+++ b/tests/hermes_cli/test_kanban_gate_only.py
@@ -157,3 +157,36 @@ def test_board_home_config_declares_it_too(home, monkeypatch, tmp_path):
     from hermes_cli import config
     monkeypatch.setattr(config, "load_config_readonly", dict)
     assert go.gate_only_assignees() == {"bb-repair-native": "bb-queue"}
+
+
+def test_triage_fanout_files_a_gate_only_pick_under_the_queue(home):
+    """Review 5878651070: the auto-decomposer inserts children by raw INSERT, never create_task."""
+    from hermes_cli.kanban_db_graph import decompose_triage_task
+    _gate(home)
+    with kbc.connect() as conn:
+        root = kb.create_task(conn, title="fix BB-12", created_by="bb-dev", triage=True)
+        kids = decompose_triage_task(conn, root, root_assignee="bb-repair-native", children=[
+            {"title": "native repair", "assignee": "bb-repair-native", "requires": []},
+            {"title": "write it up", "assignee": "default", "requires": []}], author="decomposer")
+        assert [kb.get_task(conn, k).assignee for k in kids] == ["bb-queue", "default"]
+        assert kb.get_task(conn, root).assignee == "bb-queue"
+
+
+def test_triage_single_task_promotion_files_a_gate_only_pick_under_the_queue(home):
+    _gate(home)
+    with kbc.connect() as conn:
+        root = kb.create_task(conn, title="fix BB-12", created_by="bb-dev", triage=True)
+        assert kb.specify_triage_task(conn, root, assignee="bb-repair-native", author="decomposer")
+        assert kb.get_task(conn, root).assignee == "bb-queue"
+
+
+def test_decomposer_roster_never_offers_a_gate_only_profile(home):
+    from types import SimpleNamespace
+    from unittest.mock import patch
+    from hermes_cli import kanban_decompose as kd
+    profiles = [SimpleNamespace(name=n, description=f"desc {n}") for n in ("default", "bb-repair-native")]
+    with patch("hermes_cli.profiles.list_profiles", return_value=profiles):
+        assert kd._build_roster()[1] == {"default", "bb-repair-native"}  # without the config: offered
+        _gate(home)
+        roster, names = kd._build_roster()
+    assert names == {"default"} and [e["name"] for e in roster] == ["default"]
