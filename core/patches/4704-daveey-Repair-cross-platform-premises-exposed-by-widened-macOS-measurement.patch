diff --git a/tests/cron/bash_execution.py b/tests/cron/bash_execution.py
new file mode 100644
index 0000000000000000000000000000000000000000..f3df003f7a8add64ee52909e440e6c56983e54d9
--- /dev/null
+++ b/tests/cron/bash_execution.py
@@ -0,0 +1,25 @@
+"""Version gate for execution premises that assume modern /bin/bash grammar.
+
+Do not substitute Homebrew Bash: minor versions differ on arithmetic indirection.
+Scanner-only tests and explicitly version-keyed Bash 3 controls need no gate.
+"""
+from functools import lru_cache
+import subprocess
+
+import pytest
+
+
+@lru_cache(maxsize=1)
+def system_bash_major() -> int:
+    result = subprocess.run(
+        ["/bin/bash", "--noprofile", "--norc", "-c", 'printf "%s" "${BASH_VERSINFO[0]}"'],
+        capture_output=True, text=True, encoding="utf-8", check=True, timeout=5,
+    )
+    return int(result.stdout)
+
+
+def require_modern_system_bash() -> str:
+    """Gate only a real-shell premise, never a scanner fixture or whole module."""
+    if system_bash_major() < 4:
+        pytest.skip("execution premise requires /bin/bash >= 4; system Bash 3 has different grammar")
+    return "/bin/bash"
diff --git a/tests/cron/test_bash_execution.py b/tests/cron/test_bash_execution.py
new file mode 100644
index 0000000000000000000000000000000000000000..30bceb986779b2338664aec3dfad51684041cfa2
--- /dev/null
+++ b/tests/cron/test_bash_execution.py
@@ -0,0 +1,49 @@
+"""The shared execution gate rejects old Bash without changing scanner policy."""
+from types import SimpleNamespace
+
+import pytest
+
+from tests.cron import bash_execution as execution
+
+
+@pytest.mark.parametrize("major", [3, 4, 5])
+def test_version_gate(monkeypatch, major):
+    monkeypatch.setattr(execution, "system_bash_major", lambda: major)
+    if major < 4:
+        with pytest.raises(pytest.skip.Exception, match="requires /bin/bash >= 4"):
+            execution.require_modern_system_bash()
+    else:
+        assert execution.require_modern_system_bash() == "/bin/bash"
+
+
+def test_version_probe_is_cached_and_uses_system_bash(monkeypatch):
+    calls = []
+
+    def run(argv, **kwargs):
+        calls.append((argv, kwargs))
+        return SimpleNamespace(stdout="5")
+
+    execution.system_bash_major.cache_clear()
+    monkeypatch.setattr(execution.subprocess, "run", run)
+    try:
+        assert execution.system_bash_major() == 5
+        assert execution.system_bash_major() == 5
+        assert len(calls) == 1
+        argv, kwargs = calls[0]
+        assert argv[:4] == ["/bin/bash", "--noprofile", "--norc", "-c"]
+        assert "BASH_VERSINFO[0]" in argv[4]
+        assert kwargs["check"] is True
+        assert kwargs["timeout"] == 5
+    finally:
+        execution.system_bash_major.cache_clear()
+
+
+@pytest.mark.parametrize("module", ["test_lifecycle_guard_fd_redirections", "test_lifecycle_guard_comment_words"])
+def test_shared_marker_helpers_gate_before_execution(monkeypatch, tmp_path, module):
+    import importlib
+
+    helper = importlib.import_module(f"tests.cron.{module}")
+    monkeypatch.setattr(execution, "system_bash_major", lambda: 3)
+    monkeypatch.setattr(helper.subprocess, "run", lambda *a, **kw: pytest.fail("old Bash executed"))
+    with pytest.raises(pytest.skip.Exception, match="requires /bin/bash >= 4"):
+        helper._bash_runs(tmp_path, "true")
