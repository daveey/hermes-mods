From 5933da5b0e595349d2c1599e854a4082c3811b28 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 09:13:04 +0000
Subject: [PATCH 6385] Test isolation, fixture lifecycle and CI case partitioning

Public mirror of source commit 5933da5b0e595349d2c1599e854a4082c3811b28.

---
diff --git a/tests/gateway/test_plugin_idle_task_housekeeping.py b/tests/gateway/test_plugin_idle_task_housekeeping.py
index 65f26402a3b..c5e0dfa654d 100644
--- a/tests/gateway/test_plugin_idle_task_housekeeping.py
+++ b/tests/gateway/test_plugin_idle_task_housekeeping.py
@@ -202,7 +202,15 @@
 @pytest.mark.parametrize("failed_start", [1, 2])
 def test_restart_fixture_reaps_workers_when_startup_assertions_fail(gw, monkeypatch, failed_start):
     stop_class = _Stop
-    stops = []
+    serve = _serve
+    stops, loops = [], []
+
+    def record_loop(stop):
+        loop = serve(stop)
+        loops.append(loop)
+        return loop
+
+    monkeypatch.setattr(sys.modules[__name__], "_serve", record_loop)
 
     def stop_with_failure(n):
         stop = stop_class(n)
@@ -218,8 +226,16 @@
         return stop
 
     monkeypatch.setattr(sys.modules[__name__], "_Stop", stop_with_failure)
-    with pytest.raises(AssertionError, match="injected startup failure"):
-        test_after_an_in_process_restart_only_the_new_housekeeping_records(gw, monkeypatch)
+    try:
+        with pytest.raises(AssertionError, match="injected startup failure"):
+            test_after_an_in_process_restart_only_the_new_housekeeping_records(gw, monkeypatch)
+        assert loops and all(not loop.is_alive() for loop in loops)
+    finally:
+        # A cleanup mutant must fail without leaking its deliberately stranded loop.
+        for stop in stops:
+            stop.set()
+        for loop in loops:
+            loop.join(BUDGET + 10)
     assert gw.fences
     assert all(not worker.is_alive() for fence in gw.fences for worker in fence._workers)
     assert str(gw.lock) not in plugins_idle_tasks._in_flight
@@ -283,3 +299,6 @@
                 loop.join(BUDGET + 10)
         for fence in gw.fences:
             assert fence.close(timeout=10), "fixture left an idle worker running"
+        for loop in (old, new):
+            if loop is not None:
+                assert not loop.is_alive(), "fixture left a housekeeping loop running"
