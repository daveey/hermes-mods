From 192e51317b65eeea97a46b228e666f136c769258 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:24:17 +0000
Subject: [PATCH] [daveey] Keep checkpoint intent validation portable and
 facade size bounded

---
 gateway/run_shutdown.py      | 1 -
 gateway/update_checkpoint.py | 6 ++++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/gateway/run_shutdown.py b/gateway/run_shutdown.py
index 39c30ee3512..38d4c29d81a 100644
--- a/gateway/run_shutdown.py
+++ b/gateway/run_shutdown.py
@@ -1633,7 +1633,6 @@ class GatewayShutdownMixin(GatewayRestartWaitMixin, GatewaySessionEndMixin, Gate
     def request_restart(self, *, detached: bool = False, via_service: bool = False, update_intent=None) -> bool:
         if self._restart_task_started:
             return False
-        # An explicit path stays armed even if already gone, so the wait cancels instead of stopping.
         self._restart_update_intent = self._core_update_intent_path() if update_intent is None else update_intent
         self._restart_requested = True
         self._restart_detached = detached
diff --git a/gateway/update_checkpoint.py b/gateway/update_checkpoint.py
index 678f8b322e4..686d652352f 100644
--- a/gateway/update_checkpoint.py
+++ b/gateway/update_checkpoint.py
@@ -14,6 +14,7 @@ from pathlib import Path
 from hermes_constants import get_default_hermes_root, get_hermes_home
 from hermes_cli import admission_fence
 from gateway.cron_pause import preserve_cron_slots
+from gateway.status import _pid_exists
 from gateway.session_runtime_workers import kanban_managed_count
 from gateway.run_shutdown_restart_wait import CORE_UPDATE_KANBAN_WAIT_S, CORE_UPDATE_KANBAN_STOP_LEASH_S
 
@@ -25,7 +26,7 @@ CHECKPOINT_DRAIN_S = CORE_UPDATE_KANBAN_WAIT_S + CORE_UPDATE_KANBAN_STOP_LEASH_S
 def checkpoint_intent(home):
     """Return the bounded, live unfenced episode, or None (never infer authority from an env flag)."""
     try:
-        data = json.loads((Path(home) / "core-update/intent").read_text(encoding="utf-8"))
+        data = json.loads((Path(home) / "core-update/intent").read_text(encoding="utf-8-sig"))
         now = time.time()
         if (not isinstance(data, dict) or data.get("kind") != "unfenced"
                 or data.get("checkpoint") is not True or type(data.get("pid")) is not int
@@ -33,7 +34,8 @@ def checkpoint_intent(home):
                 or not 0 <= now - float(data["created_at"]) < 180
                 or not now < float(data["expires_at"]) <= float(data["created_at"]) + 180):
             return None
-        os.kill(data["pid"], 0)
+        if not _pid_exists(data["pid"]):
+            return None
         root = get_default_hermes_root(home=home)
         if not admission_fence.is_held(Path(root) / "core-update"):
             return None
-- 
2.55.0

