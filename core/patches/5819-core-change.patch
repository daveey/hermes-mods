From 63338848fff554eeee9d7308bb176376032c61f8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 15:04:19 +0000
Subject: [PATCH] [daveey] Scope renewal: order the deciding promotion by
 arrival, not its claimed time

A promotion or archive decides a renewed stop only when it was recorded after
the renewal. reopened() compared _event_order (created_at, uid millisecond),
which is the writer's clock: a promote attempt left on a restricted card with a
clock ahead of the renewal released the card at renewal with no fresh decision.
Compare the row id (arrival), the same rule the Board applies with ord
(hermes-hub PR #207 review).

RED: test_g_promotion_recorded_before_the_renewal_never_decides_it_whatever_time_it_claims
failed on the previous head; GREEN with this change. 34 files / 415 tests of
the scope-renewal, retain, spend, refusal and importing suites pass.
---
 hermes_cli/kanban_scope_renewal.py            | 11 ++++++-----
 tests/hermes_cli/test_kanban_scope_renewal.py | 13 +++++++++++++
 2 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_scope_renewal.py b/hermes_cli/kanban_scope_renewal.py
index f2a6ff2f73..4d5dc64944 100644
--- a/hermes_cli/kanban_scope_renewal.py
+++ b/hermes_cli/kanban_scope_renewal.py
@@ -117,15 +117,16 @@ def reopened(conn: sqlite3.Connection, task_id: str, ordinary: list[dict]) -> Op
 
     A renewal re-opens its stop at the renewal's position: only a promotion or archive recorded after it is that
     decision. Without this, a promotion older than the scope annotation would release the card at renewal.
-    ``ordinary``: stop/promotion/archive events, newest first.
+    "After" is arrival order (the row id), as on the Board (its ``ord``): an event's ``created_at`` and uid are
+    its writer's clock, and a promotion recorded before the renewal must not decide it whatever time it states.
+    ``ordinary``: stop/promotion/archive events.
     """
-    from hermes_cli.kanban_sync_divergence import _event_order
-    renewed = sorted(renewals(conn, task_id), key=_event_order, reverse=True)
+    renewed = sorted(renewals(conn, task_id), key=lambda e: int(e["id"]), reverse=True)
     if not renewed:
         return None
-    decided = next((e for e in ordinary if e["kind"] != STOP), None)
+    decided = max((int(e["id"]) for e in ordinary if e["kind"] != STOP), default=-1)
     for renewal in renewed:
-        if decided is not None and _event_order(decided) > _event_order(renewal):
+        if decided > int(renewal["id"]):
             return None
         stop = next((e for e in ordinary if e["kind"] == STOP and key(e) == renewal["payload"]["episode"]), None)
         if stop is not None:
diff --git a/tests/hermes_cli/test_kanban_scope_renewal.py b/tests/hermes_cli/test_kanban_scope_renewal.py
index b70f099fd3..9075e8dabc 100644
--- a/tests/hermes_cli/test_kanban_scope_renewal.py
+++ b/tests/hermes_cli/test_kanban_scope_renewal.py
@@ -247,6 +247,19 @@ def test_g_promotion_older_than_the_scope_annotation_does_not_release_a_renewed_
     assert not decision.pending(board, tid)
 
 
+def test_g_promotion_recorded_before_the_renewal_never_decides_it_whatever_time_it_claims(board, monkeypatch):
+    """A refused promote attempt leaves its event behind; its timestamp is its writer's clock, not arrival."""
+    tid, _, episode = stopped(board, monkeypatch)
+    kb._append_event(board, tid, 'promoted_manual', {})
+    board.execute("UPDATE task_events SET created_at=created_at+3600 WHERE task_id=? AND kind='promoted_manual'", (tid,))
+    board.commit()
+    link(board, tid)
+    renew(board, tid, episode, mandate(board, tid))
+    assert decision.pending(board, tid), 'a promotion recorded before the renewal must not release it'
+    kb._append_event(board, tid, 'promoted_manual', {})  # its clock is an hour behind the stale row's claim
+    assert not decision.pending(board, tid), 'one recorded after the renewal is the decision'
+
+
 def test_h_notice_and_unblock_text_name_the_route_only_for_scope_stops(board, monkeypatch):
     tid, _, _ = stopped(board, monkeypatch)
     text = decision.unblock_refusal(board, tid)
