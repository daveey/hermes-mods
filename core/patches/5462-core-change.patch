+        refusal = ActiveSessionRefusal(_SESSION_OWNERSHIP_UNAVAILABLE, SESSION_COORDINATION_UNAVAILABLE)
+        refusal.ownership_cause = "lease_self_orphan"
+        refusal.holder_pid = exc.receipt.pid
