 tests/pm/run_tests_harness_support.py         | 256 ++++++++++++++++++
 tests/scripts/test_run_tests_allocator_env.py | 194 +++++++++++++
 3 files changed, 463 insertions(+)
 create mode 100644 tests/pm/run_tests_harness_support.py
