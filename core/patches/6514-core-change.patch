Subject: [PATCH 6514] Request-stage diagnostics, stream phases and process custody

Public mirror of source commit 1e72e4c7cf4c6fe6081aeb615b53c1c4a2f45a08.

---
diff --git a/tests/hermes_cli/test_web_read_stages.py b/tests/hermes_cli/test_web_read_stages.py
index 187af4cfde2..590ef078d64 100644
--- a/tests/hermes_cli/test_web_read_stages.py
+++ b/tests/hermes_cli/test_web_read_stages.py
@@ -14,6 +14,7 @@
 
 from hermes_cli.web_read_coalescing import coalesced_read
 from hermes_cli import web_request_stages as stages
+from tests.waiting import async_wait_until
 
 
 class Sink:
@@ -31,7 +32,7 @@
     release = threading.Event()
     calls = []
 
-    def read(board):
+    def read(board, version=0):
         calls.append(board)
         entered[board].set()
         assert release.wait(5)
@@ -41,8 +42,8 @@
     app = FastAPI()
 
     @app.get("/api/plugins/kanban/board")
-    async def board(board: str):
-        return await wrapped(board)
+    async def board(board: str, version: int = 0):
+        return await wrapped(board, version)
 
     @app.get("/api/health")
     async def health():
@@ -51,10 +52,14 @@
     observed = stages.RequestStageIngress(stages.RequestStageHandler(app), sink)
     tasks = []
     async with httpx.AsyncClient(transport=httpx.ASGITransport(app=observed), base_url="http://test") as client:
-        async def request(key, rid):
-            return await client.get("/api/plugins/kanban/board", params={"board": key},
+        async def request(key, rid, version=0):
+            return await client.get("/api/plugins/kanban/board", params={"board": key, "version": version},
                                     headers={"x-hermes-req-id": rid * 32})
 
+        def read_names(rid):
+            return [r["stage"] for r in sink.rows if r.get("id") == rid * 32
+                    and r["stage"].startswith("read_")]
+
         try:
             tasks.append(asyncio.create_task(request("a", "a")))
             assert await run_sync(entered["a"].wait, 2)
@@ -62,11 +67,20 @@
             assert await run_sync(entered["b"].wait, 2)
             tasks.append(asyncio.create_task(request("c", "c")))
             tasks.append(asyncio.create_task(request("a", "d")))
+            # Different arguments, same occupied group: not a coalesced follower.
+            tasks.append(asyncio.create_task(request("a", "e", version=1)))
             # A healthy request proves the loop progresses while both workers wait.
             assert (await client.get("/api/health")).json() == {"ok": True}
-            await asyncio.sleep(0)
+            await async_wait_until(
+                lambda: "read_admission_wait" in read_names("c")
+                and "read_group_wait" in read_names("e") and bool(read_names("d")),
+                timeout=2, what="shared and group admission waits",
+            )
+            assert read_names("c") == ["read_join", "read_group_wait", "read_admission_wait"]
+            assert read_names("d") == ["read_join"]
+            assert read_names("e") == ["read_join", "read_group_wait"]
             read_rows = [r for r in sink.rows if r["stage"].startswith("read_")]
-            assert len([r for r in read_rows if r["stage"] == "read_join"]) == 4
+            assert len([r for r in read_rows if r["stage"] == "read_join"]) == 5
             assert not entered["c"].is_set()
             tasks[0].cancel()
             with pytest.raises(asyncio.CancelledError):
@@ -74,15 +88,16 @@
             assert not any(r["stage"] == "read_worker_end" for r in read_rows)
             release.set()
             replies = await asyncio.wait_for(asyncio.gather(*tasks[1:]), 3)
-            assert [r.json()["board"] for r in replies] == ["b", "c", "a"]
+            assert [r.json()["board"] for r in replies] == ["b", "c", "a", "a"]
         finally:
             release.set()
             await asyncio.gather(*tasks, return_exceptions=True)
-    assert sorted(calls) == list("abc")
+    assert sorted(calls) == list("aabc")
     joins = [r for r in sink.rows if r["stage"] == "read_join"]
     assert joins[0]["read_id"] == joins[3]["read_id"]
-    assert len({r["read_id"] for r in joins}) == 3
-    for join in joins[:3]:
+    assert [r["id"] for r in joins] == [rid * 32 for rid in "abcde"]
+    assert len({r["read_id"] for r in joins}) == 4
+    for join in [joins[i] for i in (0, 1, 2, 4)]:
         rows = [r for r in sink.rows if r.get("read_id") == join["read_id"]
                 and r["stage"] != "read_join"]
         assert [r["stage"] for r in rows] == [
