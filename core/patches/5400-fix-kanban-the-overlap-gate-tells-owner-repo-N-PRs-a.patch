From 786a0b15cae58e7fcbac6fda10a0be42318155ab Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 05:49:51 +0000
Subject: [PATCH] fix(kanban): the overlap gate tells owner/repo#N PRs apart
 [daveey]

core-ship-backstop titles retros "Retro exact-head review: <owner>/<repo>#N
merged without a hermes-core-wt/ship receipt". _PR_REF refused a # after a
word character, so those titles named no PR and every retro for another PR
collided with any open one (stalled until an example state
PR #3876 worked around it).

A PR ref is now (repo or None, N): owner/repo#N and github.com/.../pull/N
carry their repo, lowercased; #N, PR N, PRN, PR #N, pull/N carry none and
match any repo. _different_prs compares refs, so a/b#55 and c/d#55 differ.
pr_numbers() keeps returning the number set; pr_refs() is new.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/kanban_overlap.py                  | 39 ++++++++++++---
 .../test_kanban_create_overlap_pr_ids.py      | 47 +++++++++++++++++++
 2 files changed, 80 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_overlap.py b/hermes_cli/kanban_overlap.py
index 44ef003c1d..125a4804e5 100644
--- a/hermes_cli/kanban_overlap.py
+++ b/hermes_cli/kanban_overlap.py
@@ -241,18 +241,45 @@ def cites(card_id: str, title: str, body: str) -> bool:
 # Template titles (t_01a1db274c88e2e3): ``hermes-core-wt ship --request-review`` files "Independent exact-head review
 # PR #N @<sha> (core-wt ship review required)", so two reviews of different PRs share ~80% of their words and only the
 # PR number tells them apart. Titles that each name PRs, and no PR in common, are different work by title.
-_PR_REF = re.compile(r"(?:(?<![\w#])#|\bpr\s*#?\s*|\bpull/)(\d{2,6})(?!\d)", re.IGNORECASE)
+# owner/repo#N (example incident): core-ship-backstop files "Retro exact-head review: example-org/hermes#N merged
+# without a hermes-core-wt/ship receipt". A bare ``#`` after a word character is no ref (``state#12``), so those titles
+# named no PR and every retro for another PR collided with any open one: the backstop stalled until an example state
+# PR #3876 worked around it. A ref is now (repo, N): ``owner/repo#N`` and a github.com ``.../owner/repo/pull/N`` URL
+# carry their repo (lowercased); ``#N``, ``PR N``, ``PRN``, ``PR #N`` and ``pull/N`` carry none and match any repo.
+# ``##N``, ``word#N`` and ``a/b/c#N`` stay non-refs; N is 2-6 digits.
+_PR_REF = re.compile(
+    r"(?<![\w./#-])(?P<repo>[a-z0-9][a-z0-9-]{0,38}/[a-z0-9_.-]+)#(?P<rn>\d{2,6})(?!\d)"
+    r"|github\.com/(?P<url>[a-z0-9][a-z0-9-]{0,38}/[a-z0-9_.-]+)/pull/(?P<un>\d{2,6})(?!\d)"
+    r"|(?:(?<![\w#])#|\bpr\s*#?\s*|\bpull/)(?P<n>\d{2,6})(?!\d)",
+    re.IGNORECASE)
+
+PrRef = tuple[Optional[str], int]  # (lowercased "owner/repo" or None when the title does not say, PR number)
+
+
+def pr_refs(title: str) -> frozenset[PrRef]:
+    """PR refs a title names, as (repo or None, number): ``owner/repo#N`` and ``github.com/owner/repo/pull/N`` carry
+    their repo; ``#N``, ``PR N``, ``PRN``, ``PR #N``, ``pull/N`` do not (N of 2-6 digits)."""
+    refs = set()
+    for m in _PR_REF.finditer(title or ""):
+        repo = m.group("repo") or m.group("url")
+        refs.add((repo.lower() if repo else None, int(m.group("rn") or m.group("un") or m.group("n"))))
+    return frozenset(refs)
 
 
 def pr_numbers(title: str) -> frozenset[int]:
-    """PR numbers a title names: ``#N``, ``PR N``, ``PRN``, ``PR #N``, ``pull/N`` (N of 2-6 digits)."""
-    return frozenset(int(n) for n in _PR_REF.findall(title or ""))
+    """PR numbers a title names, whatever the repo (see ``pr_refs``)."""
+    return frozenset(n for _, n in pr_refs(title))
+
+
+def _same_pr(x: PrRef, y: PrRef) -> bool:
+    """Equal numbers in the same repo, or a side that names no repo (conservative: it may be either)."""
+    return x[1] == y[1] and (x[0] is None or y[0] is None or x[0] == y[0])
 
 
 def _different_prs(a: str, b: str) -> bool:
-    """Both titles name a PR and no PR number is common to them (repos are not told apart)."""
-    mine, theirs = pr_numbers(a), pr_numbers(b)
-    return bool(mine and theirs and not mine & theirs)
+    """Both titles name a PR and no PR is common to them (``_same_pr``: ``a/b#5`` and ``c/d#5`` differ)."""
+    mine, theirs = pr_refs(a), pr_refs(b)
+    return bool(mine and theirs) and not any(_same_pr(x, y) for x in mine for y in theirs)
 
 
 def _reasons(card: dict, new_words: set[str], title: str, body: str, target_board: str,
diff --git a/tests/tools/test_kanban_create_overlap_pr_ids.py b/tests/tools/test_kanban_create_overlap_pr_ids.py
index bf33a0a1d7..d9b1ab2d9e 100644
--- a/tests/tools/test_kanban_create_overlap_pr_ids.py
+++ b/tests/tools/test_kanban_create_overlap_pr_ids.py
@@ -96,3 +96,50 @@ def test_shared_file_reason_does_not_join_different_prs(worker, tmp_path):
 def test_pr_numbers_forms():
     assert ko.pr_numbers("Review #2799, PR139: x, PR 173, pr #42 and pull/3050") == {2799, 139, 173, 42, 3050}
     assert ko.pr_numbers("@478094efef M9/M10 exact53e08858 #1 #1234567 state#12 spring 2026") == frozenset()
+
+
+# owner/repo#N (example incident): core-ship-backstop files "Retro exact-head review: <owner>/<repo>#N merged without a
+# hermes-core-wt/ship receipt". ``state#12``'s rule (no ``#`` after a word character) read no PR in those titles, so
+# each retro for another PR collided with any open one and the backstop stalled (worked around in an example state
+# PR #3876). A ref now carries its repo; an unqualified ref matches any repo.
+RETRO_3855 = ("Retro exact-head review: example-org/hermes#3855 merged without a hermes-core-wt/ship "
+              "receipt")
+RETRO_3863 = RETRO_3855.replace("#3855", "#3863")
+
+
+def test_retro_reviews_of_different_owner_repo_prs_are_not_duplicates(worker, tmp_path):
+    remote(tmp_path, RETRO_3855)
+    assert check(RETRO_3863) is None
+    assert ko._different_prs(RETRO_3863, RETRO_3855)
+
+
+def test_same_owner_repo_pr_still_matches(worker, tmp_path):
+    remote(tmp_path, RETRO_3855)
+    assert not ko._different_prs(RETRO_3855, RETRO_3855.replace("example-org", "Example-Org"))
+    out = check(RETRO_3855)
+    assert out and out["code"] == "create_overlap" and "titles share" in out["matches"][0]["why"], out
+
+
+def test_same_number_in_different_repos_is_different_prs():
+    assert ko._different_prs("Retro review a/b#55 merged", "Retro review c/d#55 merged")
+
+
+def test_unqualified_ref_matches_any_repo():
+    assert not ko._different_prs("Retro review a/b#55 merged", "Retro review #55 merged")
+    assert not ko._different_prs("Retro review PR 55 merged", "Retro review c/d#55 merged")
+
+
+def test_pr_refs_carry_the_repo():
+    assert ko.pr_refs(RETRO_3855) == {("example-org/hermes", 3855)}
+    assert ko.pr_refs("Owner-1/Repo_x.y#42 and #43") == {("owner-1/repo_x.y", 42), (None, 43)}
+    assert ko.pr_refs("see https://github.com/Example-Org/hermes/pull/3876") == {
+        ("example-org/hermes", 3876)}
+    assert ko.pr_refs("Review #2799, PR139: x, PR 173, pr #42 and pull/3050") == {
+        (None, 2799), (None, 139), (None, 173), (None, 42), (None, 3050)}
+    assert ko.pr_numbers(RETRO_3855) == {3855}
+
+
+@pytest.mark.parametrize("title", ["foo#12", "##12", "a/b#1", "a/b/c#12", "a/b#1234567", "x hermes-core-wt/ship y"])
+def test_not_pr_refs(title):
+    assert ko.pr_refs(title) == frozenset()
+    assert ko.pr_numbers(title) == frozenset()
-- 
