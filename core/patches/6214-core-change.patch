From f4a4c0531818a402cfb359dadcaf6703632692b7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 24 Nov 2026 18:27:53 +0000
Subject: [PATCH 6214] Conditional terminal-run reservation and indexed wait history

Public mirror of source commit f4a4c0531818a402cfb359dadcaf6703632692b7.

---
diff --git a/hermes_cli/kanban_parent_unclaimed.py b/hermes_cli/kanban_parent_unclaimed.py
index b7c9dd82a08..9f16f7cfb97 100644
--- a/hermes_cli/kanban_parent_unclaimed.py
+++ b/hermes_cli/kanban_parent_unclaimed.py
@@ -40,14 +40,14 @@
     """``kanban_diagnostics._last_ready_entry_ts`` computed from only the rows that can move it, never the
     whole event history (the hub's maintenance pass loaded every event/run of every parent here).
 
-    Same predicate: max of (latest floor-kind event, latest ``continued`` event whose payload says
+    Same predicate: max of (latest floor-kind event, latest conditional registry event whose payload says
     status=ready, latest run end), after dropping unused Board grants' runs and their run-tagged events. An
     unused grant needs ``outcome='released'`` and its judgement reads only that run's own events, so only
     released runs are loaded whole (``idx_events_run``); other runs contribute just ``ended_at``. Event
     reads use ``idx_events_kind_task_id``; ``heartbeat`` & co. are never touched."""
     from hermes_cli import kanban_db as kb
     from hermes_cli.kanban_diagnostics import _event_ts, _parse_payload
-    from hermes_cli.kanban_ready_events import READY_WAIT_FLOOR_KINDS
+    from hermes_cli.kanban_ready_events import READY_ENTRY_CONDITIONAL_KINDS, READY_WAIT_FLOOR_KINDS
     from hermes_cli.kanban_unused_grant import unused_grant_run
 
     unused: set = set()
@@ -65,13 +65,13 @@
         "AND (outcome IS NULL OR outcome != 'released')", (task_id,))]
     floor = max([0, *(e for e in (kb._to_epoch(v) for v in ends) if e)])
 
-    kinds = sorted(READY_WAIT_FLOOR_KINDS | {"continued"})
+    kinds = sorted(READY_WAIT_FLOOR_KINDS | READY_ENTRY_CONDITIONAL_KINDS)
     marks = ",".join("?" * len(kinds))
     for ev in conn.execute(f"SELECT kind, payload, created_at, run_id FROM task_events "
                            f"WHERE task_id = ? AND kind IN ({marks})", (task_id, *kinds)):
         if ev["run_id"] in unused:
             continue
-        if ev["kind"] == "continued" and _parse_payload(ev).get("status") != "ready":
+        if ev["kind"] in READY_ENTRY_CONDITIONAL_KINDS and _parse_payload(ev).get("status") != "ready":
             continue
         floor = max(floor, _event_ts(ev))
     return floor
diff --git a/tests/hermes_cli/test_kanban_parent_unclaimed_ready_since_bounded.py b/tests/hermes_cli/test_kanban_parent_unclaimed_ready_since_bounded.py
index 1704f43a607..0c69f98fc62 100644
--- a/tests/hermes_cli/test_kanban_parent_unclaimed_ready_since_bounded.py
+++ b/tests/hermes_cli/test_kanban_parent_unclaimed_ready_since_bounded.py
@@ -95,6 +95,18 @@
     assert pu.ready_since(conn, task, created_at) == _oracle(conn, task, created_at)
 
 
+@pytest.mark.parametrize("kind", ["continued", "shared_blocker_cleared"])
+@pytest.mark.parametrize("status", [None, "ready", "review", "blocked"])
+def test_conditional_registry_matches_oracle_without_full_history(conn, kind, status):
+    task = "t_conditional"
+    _ev(conn, task, "created", 100)
+    _ev(conn, task, kind, 700, {"status": status})
+    _noise(conn, task, 40)
+    conn.commit()
+    assert pu.ready_since(conn, task) == _oracle(conn, task)
+    assert pu.ready_since(conn, task) == (700 if status == "ready" else 100)
+
+
 def test_does_not_materialise_full_history(conn, monkeypatch):
     task = "t_target"
     _ev(conn, task, "created", 100)
