From c44e46eb2a478d014767e282868e5e0e23efefa9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 02:47:17 +0000
Subject: [PATCH] tests: follow bg shell exec change (patch target,
 SIGTERM-ignoring script)

---
 tests/tools/test_kill_verify_tree_death.py        | 6 +++---
 tests/tools/test_login_shell_path_preservation.py | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/tests/tools/test_kill_verify_tree_death.py b/tests/tools/test_kill_verify_tree_death.py
index 6a6baa4423a..f8da8009d77 100644
--- a/tests/tools/test_kill_verify_tree_death.py
+++ b/tests/tools/test_kill_verify_tree_death.py
@@ -130,8 +130,8 @@ def test_escalated_kill_of_sigterm_ignoring_child_reports_killed(tmp_path, monke
 @pytest.mark.skipif(sys.platform == "win32", reason="POSIX signal escalation; Windows uses taskkill")
 @pytest.mark.live_system_guard_bypass  # the late children are SIGKILLed after their shell dies
 def test_kill_reaps_children_spawned_during_the_grace_window(tmp_path, monkeypatch):
-    """The interactive ``bash -lic`` wrapper ignores SIGTERM and keeps running its script
-    through the grace window. Children it starts after the kill began must die with it,
+    """A shell that ignores SIGTERM (the script traps it; the old interactive ``bash -lic``
+    wrapper did this implicitly) keeps running its script through the grace window. Children it starts after the kill began must die with it,
     not be reparented to init when the shell is finally SIGKILLed."""
     import psutil
 
@@ -147,7 +147,7 @@ def test_kill_reaps_children_spawned_during_the_grace_window(tmp_path, monkeypat
     started, pid_file = tmp_path / "started", tmp_path / "late_pids"
     reg = ProcessRegistry()
     s = reg.spawn_local(
-        f"touch {started}; sleep 0.5; for i in 1 2 3; do sleep 30 & echo $! >> {pid_file}; done; wait",
+        f"trap '' TERM; touch {started}; sleep 0.5; for i in 1 2 3; do sleep 30 & echo $! >> {pid_file}; done; wait",
         cwd=str(tmp_path),
     )
     late = []
diff --git a/tests/tools/test_login_shell_path_preservation.py b/tests/tools/test_login_shell_path_preservation.py
index f2451a2ae09..5bf02119ee5 100644
--- a/tests/tools/test_login_shell_path_preservation.py
+++ b/tests/tools/test_login_shell_path_preservation.py
@@ -159,7 +159,7 @@ def test_background_command_keeps_spawn_path_dirs_a_login_profile_resets(tmp_pat
     login_shell.write_text(f'#!/usr/bin/env bash\nPATH="{profile_bin}:/usr/local/bin:/usr/bin:/bin"\n'
                            'exec /bin/bash --noprofile --norc -c "$2"\n', encoding="utf-8")
     login_shell.chmod(0o755)
-    monkeypatch.setattr("tools.process_registry._find_shell", lambda: str(login_shell))
+    monkeypatch.setattr("tools.process_registry_bg_shell._find_shell", lambda: str(login_shell))
     registry = ProcessRegistry()
     session = _spawn(registry, env=SimpleNamespace(env={"PATH": f"{parent_bin}:/usr/bin:/bin"}),
                      env_type="local", command='only-in-parent; printf "PATH=%s\\n" "$PATH"',
-- 
2.55.0

