diff --git a/hermes_cli/kanban_sync_divergence.py b/hermes_cli/kanban_sync_divergence.py
new file mode 100644
index 00000000000..e6fa6f67e8e
--- /dev/null
+++ b/hermes_cli/kanban_sync_divergence.py
@@ -0,0 +1,62 @@
+"""Field-scoped repair of uncaptured local writes."""
+from __future__ import annotations
+
+import json
+import logging
+import sqlite3
+import time
+from hermes_cli import kanban_db_sync as sync
+
+_log = logging.getLogger(__name__)
+
+
+def repair_divergence(live: sqlite3.Connection, shadow: sqlite3.Connection, gateway: str) -> dict[str, list[str]]:
+    """Queue the local values of this gateway's cards that the service never received.
+
+    A card whose live ``sync_version`` equals the replica's, with no outbox op in flight, has seen every service
+    write. Any synced field that still differs was then written locally with no capture trigger, e.g. in the
+    window while another process re-installed the triggers. The install heal only finds NULL-uid children;
+    ``repair_missing_children`` handles settled missing links. A task row has no missing-row marker, so this
+    field comparison is the only place that finds its uncaptured edits.
+    Hub incident 2026-10-28: a ``scheduled -> ready`` wake reached the service as its event but not as its
+    status, and the service refused every lease as ``not_claimable`` for 3 h. Returns {task id: fields queued}."""
+    from hermes_cli.kanban_sync_client import _row_fields, _diverged_runs
+    from hermes_cli.kanban_db_connect import write_txn
+    from hermes_cli.kanban_sync_omissions import held_fields, repair_holds
+    held = repair_holds(live, "tasks")
+    seen = {r[0]: r[1] for r in shadow.execute(
+        "SELECT id, sync_version FROM tasks WHERE (created_on = ? OR created_on IS NULL) AND sync_version IS NOT NULL",
+        (gateway,))}
+    repaired: dict[str, list[str]] = {}
+    rows = live.execute("SELECT * FROM tasks WHERE sync_version IS NOT NULL").fetchall()
+    for row in rows:
+        tid = row["id"]
+        if tid in held or seen.get(tid) != row["sync_version"]:
+            continue
+        theirs = shadow.execute("SELECT * FROM tasks WHERE id = ?", (tid,)).fetchone()
+        mine, remote = _row_fields(live, "tasks", row), _row_fields(shadow, "tasks", theirs)
+        omitted = held_fields(live, "tasks", tid)
+        fields = {k: v for k, v in mine.items() if k in remote and remote[k] != v and k not in omitted}
+        if not fields:
+            continue
+        runs = _diverged_runs(live, shadow, tid)
+        with write_txn(live):
+            # [daveey] The same uncaptured transaction usually ended the card's run too (``complete_task`` writes
+            # both). Queue those run rows FIRST: a card arriving ``done`` before its run makes the Board end the
+            # lease's run generically (rows.ts ``endLeaseRun``: ``released``, "card left running (done)"), and
+            # with no later holder write that row came back over the real ``done/completed`` run. The owner then
+            # published the card unverified, and no origin ever released it (hub t_01a185075c59bd52, 10-29).
+            for run_uid, run_fields, run_version in runs:
+                live.execute(
+                    "INSERT INTO kanban_sync_outbox (op_id, table_name, row_uid, op, fields, base_version, hlc, "
+                    "created_at) VALUES (?, 'task_runs', ?, 'upsert', ?, ?, '', ?)",
+                    (sync.uuid7(), run_uid, json.dumps(run_fields), None, int(time.time() * 1000)))
+            live.execute(
+                "INSERT INTO kanban_sync_outbox (op_id, table_name, row_uid, op, fields, base_version, hlc, created_at) "
+                "VALUES (?, 'tasks', ?, 'upsert', ?, ?, '', ?)",
+                (sync.uuid7(), tid, json.dumps(fields), row["sync_version"], int(time.time() * 1000)))
+        repaired[tid] = sorted(fields) + [f"task_runs:{uid}" for uid, _f, _v in runs]
+        _log.warning("kanban sync: %s %s differed from the service with nothing in flight (an uncaptured write); "
+                     "re-queued", tid, ", ".join(repaired[tid]))
+    return repaired
+
diff --git a/hermes_cli/kanban_sync_omissions.py b/hermes_cli/kanban_sync_omissions.py
new file mode 100644
index 00000000000..8a666870d11
--- /dev/null
+++ b/hermes_cli/kanban_sync_omissions.py
@@ -0,0 +1,77 @@
+"""Local custody of fields omitted for an older Board, independent of outbox retirement."""
+from __future__ import annotations
+
+import sqlite3
+from typing import Any, Mapping
+
+
+def held_fields(conn: sqlite3.Connection, table: str, uid: str) -> set[str]:
+    return {r[0] for r in conn.execute(
+        "SELECT field FROM kanban_sync_omissions WHERE table_name=? AND row_uid=? AND state!='delivered'",
+        (table, uid))}
+
+
+def without_held(conn: sqlite3.Connection, table: str, uid: str, fields: Mapping[str, Any]) -> dict[str, Any]:
+    """Run under the authoritative-apply write lock, including merged replies without pending-wins."""
+    held = held_fields(conn, table, uid)
+    _queue_restore(conn, table, uid, fields, held)
+    return {k: v for k, v in fields.items() if k not in held}
+
+
+def _queue_restore(conn, table, uid, authoritative, held):
+    """Presence is a capability hint, not an acknowledgement; try once per omission."""
+    import json
+    import time
+    from hermes_cli import kanban_db_sync as sync
+    from hermes_cli import kanban_sync_client as client
+    from hermes_cli.kanban_sync_rejections import _local
+    wanted = held & authoritative.keys()
+    if not wanted:
+        return
+    row = _local(conn, table, uid)
+    if row is None:
+        return
+    current = client._row_fields(conn, table, row)
+    for field in wanted:
+        receipts = conn.execute(
+            "SELECT original_op_id,restore_op_id FROM kanban_sync_omissions "
+            "WHERE table_name=? AND row_uid=? AND field=? AND state!='delivered'", (table, uid, field)).fetchall()
+        if any(r[1] for r in receipts) or field not in current:
+            continue
+        op_id = sync.uuid7()
+        conn.execute(
+            "INSERT INTO kanban_sync_outbox (op_id,table_name,row_uid,op,fields,hlc,created_at) "
+            "VALUES (?,?,?,'restore',?,'',?)", (op_id, table, uid, json.dumps({field: current[field]}), int(time.time()*1000)))
+        conn.execute("UPDATE kanban_sync_omissions SET restore_op_id=?,state='restoring' "
+                     "WHERE table_name=? AND row_uid=? AND field=? AND state!='delivered'", (op_id, table, uid, field))
+
+
+def acknowledge(conn, op_id, authoritative=None):
+    """Release only a delivered current value, not an older concurrent edit or a losing merge."""
+    import json
+    from hermes_cli import kanban_sync_client as client
+    from hermes_cli.kanban_sync_rejections import _local
+    op = conn.execute("SELECT * FROM kanban_sync_outbox WHERE op_id=? AND op='restore'", (op_id,)).fetchone()
+    if op is None:
+        return
+    row = _local(conn, op['table_name'], op['row_uid'])
+    current = client._row_fields(conn, op['table_name'], row) if row else {}
+    sent = json.loads(op['fields'])
+    delivered = all(k in current and current[k] == v and
+                    (authoritative is None or (k in authoritative and authoritative[k] == v)) for k, v in sent.items())
+    conn.execute("UPDATE kanban_sync_omissions SET state=? WHERE restore_op_id=?",
+                 ('delivered' if delivered else 'held', op_id))
+
+
+def remap(conn, old_id, new_id):
+    """Follow the existing bounded transient retry's fresh Board verdict identity."""
+    for column in ('compat_op_id', 'restore_op_id'):
+        conn.execute(f"UPDATE kanban_sync_omissions SET {column}=? WHERE {column}=?", (new_id, old_id))
+
+
+def repair_holds(conn, table):
+    """An omission owns only its field; unrelated or failed compatibility ops still hold the row."""
+    return {r[0] for r in conn.execute(
+        "SELECT row_uid FROM kanban_sync_outbox o WHERE table_name=? AND state IN ('pending','rejected') "
+        "AND NOT (state='rejected' AND EXISTS (SELECT 1 FROM kanban_sync_omissions m "
+        "WHERE m.original_op_id=o.op_id AND m.table_name=o.table_name AND m.row_uid=o.row_uid))", (table,))}
diff --git a/tests/hermes_cli/test_kanban_sync_omissions.py b/tests/hermes_cli/test_kanban_sync_omissions.py
