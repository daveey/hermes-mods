From 33d662a4be0a90fa90296a255622e1b0fc183b12 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 11:26:38 +0000
Subject: [PATCH] test(kanban): keep a pinned non-claiming worker in
 label_machines [daveey]

The machine: pin carve-out in label_machines had no test. A mutant that
drops every non-claiming worker survived. This test kills it.

Review t_eeeeee0000000027 nit on e3c83bd74ad5.
---
 tests/hermes_cli/test_claim_gate_giveup.py | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/tests/hermes_cli/test_claim_gate_giveup.py b/tests/hermes_cli/test_claim_gate_giveup.py
index bc52a44f82..13a34bde01 100644
--- a/tests/hermes_cli/test_claim_gate_giveup.py
+++ b/tests/hermes_cli/test_claim_gate_giveup.py
@@ -78,6 +78,16 @@ def test_label_machines_drops_a_non_claiming_pool_worker():
     assert label_machines("pool:worker", machines) == ["worker-a1"]
 
 
+def test_label_machines_keeps_a_pinned_non_claiming_worker():
+    """A machine: pin in the wanted labels keeps a worker that is not claiming."""
+    seen = int(time.time() * 1000)
+    machines = {
+        "worker-1": {"state": "active", "labels": ["pool:worker", "machine:worker-1"], "pickup": "all",
+                     "last_seen": seen, "metrics": {"claiming": 0}},
+    }
+    assert label_machines({"pool:worker", "machine:worker-1"}, machines) == ["worker-1"]
+
+
 def test_sync_watcher_give_up_is_wired():
     from gateway.run_startup import GatewayStartupMixin
 
