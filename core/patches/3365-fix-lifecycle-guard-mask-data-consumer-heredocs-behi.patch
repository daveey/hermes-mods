+        command = f"ssh h{level} \"bash -s\" <<'R{level}'\n{command}\nR{level}"
+    unsafe, refusal = scan_gateway_lifecycle(command, cwd=str(tmp_path))
+    assert unsafe is True and str(db) in refusal
+
+
