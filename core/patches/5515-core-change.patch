From e4e5598af8005fa0c385f413c09184c309aa5b58 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 12:37:07 +0000
Subject: [PATCH] fix(kanban): preserve shared transaction and identity cleanup
 contracts [daveey]

Broad CI exposed capture arming on boundary-only adapters/minimal revision schemas plus descriptor FK interference with task identity replacement. Existing three consumer suites reproduce8 failures; check actual cursor/schema before installing TEMP triggers and revoke old identity provenance before ID mutation. Added descriptor replacement control;13 files187tests pass, including immutable envelopes/capability, repairs, custody, transaction boundaries and revision invalidation. Prior targeted sync-only selection missed facade-level write_txn consumers. Worker180 must deploy first. Independent exact-head review and new required CI still open; final-GC limit remains unwaived.
---
 docs/designs/kanban-frozen-replay.md               |  2 ++
 hermes_cli/kanban_db_sync.py                       |  6 ++++++
 hermes_cli/kanban_sync_status_origin.py            | 11 ++++++++++-
 tests/hermes_cli/test_kanban_sync_status_origin.py | 11 +++++++++++
 4 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/docs/designs/kanban-frozen-replay.md b/docs/designs/kanban-frozen-replay.md
index e7b97c8cad..d10209b12e 100644
--- a/docs/designs/kanban-frozen-replay.md
+++ b/docs/designs/kanban-frozen-replay.md
@@ -23,6 +23,8 @@ Additional diagnostic review found definitive compatibility INSERTs dropped stat
 
 Independent Worker review of PR180 found another failure: generic server HLC stamps entered legacy client LWW without the deployed sender absorbing the server clock. Its six real-DO probes reproduce five failures at the reviewed head; gating server comparisons with frozen_replay plus new-sender clock absorption preserves Worker-first compatibility. Native clock tests cover max-merge, counter rollover, transaction rollback, synthetic parents and byte-identical retries despite newer capability clocks. Pending-origin queue capacity refusal is explicitly transient through the existing bounded retry/remap path, retaining capture provenance; its dedicated test reproduced RED before the classification correction.
 
+Broad CI of native head4de59d3a then caught shared-transaction integration regressions: boundary-only connection adapters return no cursor, minimal revision stores expose tasks without status (SQLite accepts NEW.status at trigger CREATE time but fails later DML), and the new descriptor foreign key blocked identity-replacement cleanup. Local untouched consumer assertions reproduced8 failures across3 files (`core-clock-consumer-red.log`). Arm capture only after checking its actual schema/cursor contract; revoke the descriptor BEFORE task-ID mutation rather than transfer its provenance. Added a replacement-specific descriptor assertion; all13 selected files now pass187 tests,0 failures (`core-clock-final13.log`). Earlier narrower selections missed these facade-level write_txn consumers, so they are now explicit regression coverage; this does not substitute for another broad CI run.
+
 ## Coverage boundaries
 
 - Pre-upgrade or unbound historical uncertain sends cannot recover their original envelope or origin. Legacy ambiguity after reopen remains documented; never claim universal old-client safety.
diff --git a/hermes_cli/kanban_db_sync.py b/hermes_cli/kanban_db_sync.py
index 86df310e35..3f7448d01f 100644
--- a/hermes_cli/kanban_db_sync.py
+++ b/hermes_cli/kanban_db_sync.py
@@ -201,6 +201,12 @@ CREATE TABLE IF NOT EXISTS kanban_sync_status_origins (
     origin TEXT,
     status TEXT
 );
+-- A primary-key replacement is a different task identity, not an origin
+-- transfer. Remove the old descriptor before SQLite checks the child FK.
+CREATE TRIGGER IF NOT EXISTS kanban_status_origin_identity
+BEFORE UPDATE OF id ON tasks WHEN OLD.id IS NOT NEW.id BEGIN
+    DELETE FROM kanban_sync_status_origins WHERE task_id = OLD.id;
+END;
 -- First-send synthetic parents are pending transport, not a permanent receipt ledger.
 CREATE TABLE IF NOT EXISTS kanban_sync_parent_envelopes (
     task_id TEXT PRIMARY KEY,
diff --git a/hermes_cli/kanban_sync_status_origin.py b/hermes_cli/kanban_sync_status_origin.py
index 9a07e372dc..6f9bb54d3b 100644
--- a/hermes_cli/kanban_sync_status_origin.py
+++ b/hermes_cli/kanban_sync_status_origin.py
@@ -19,7 +19,16 @@ _LIMIT = 512
 def arm(conn: sqlite3.Connection) -> bool:
     """Record new outbox status ops on this connection; savepoint rollback is native."""
     try:
-        if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='kanban_sync_outbox'").fetchone():
+        cursor = conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='kanban_sync_outbox'")
+        if cursor is None or not cursor.fetchone():
+            return False
+        # write_txn also serves boundary-only connection adapters and minimal
+        # revision stores. SQLite accepts invalid NEW.column trigger references
+        # at CREATE time, then breaks an unrelated later mutation: check first.
+        required = {"tasks": {"id", "status"},
+                    "kanban_sync_outbox": {"op_id", "row_uid", "table_name", "op", "fields", "status_origin"}}
+        if any(not columns <= {row[1] for row in conn.execute(f"PRAGMA table_info({table})")}
+               for table, columns in required.items()):
             return False
         conn.execute(f"CREATE TEMP TABLE IF NOT EXISTS {_TABLE} (op_id TEXT PRIMARY KEY, task_id TEXT)")
         conn.execute(f"DELETE FROM temp.{_TABLE}")
diff --git a/tests/hermes_cli/test_kanban_sync_status_origin.py b/tests/hermes_cli/test_kanban_sync_status_origin.py
index 0204fd7abd..4e42a5c33e 100644
--- a/tests/hermes_cli/test_kanban_sync_status_origin.py
+++ b/tests/hermes_cli/test_kanban_sync_status_origin.py
@@ -106,3 +106,14 @@ def test_status_provenance_invalidated_across_connections_and_task_delete(board)
     finally:
         other.close()
 
+
+def test_identity_replacement_revokes_capture_instead_of_transferring_it(board):
+    conn, _ = board
+    target = kb.create_task(conn, title="old identity")
+    replacement = kb.create_task(conn, title="replacement")
+    assert conn.execute("SELECT COUNT(*) FROM kanban_sync_status_origins").fetchone()[0] == 2
+    conn.execute("PRAGMA recursive_triggers=OFF")
+    conn.execute("UPDATE OR REPLACE tasks SET id=? WHERE id=?", (target, replacement))
+    assert conn.execute("SELECT title FROM tasks WHERE id=?", (target,)).fetchone()[0] == "replacement"
+    assert conn.execute("SELECT COUNT(*) FROM kanban_sync_status_origins").fetchone()[0] == 0
+
