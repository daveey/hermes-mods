diff --git a/apps/desktop/src/store/execution-observation-row.ts b/apps/desktop/src/store/execution-observation-row.ts
index 4024906bf2..d78b4be95e 100644
--- a/apps/desktop/src/store/execution-observation-row.ts
+++ b/apps/desktop/src/store/execution-observation-row.ts
@@ -33,7 +33,16 @@ export interface RowExecution {
   outstanding: number
 }
 
-type Stamped = Pick<SessionInfo, 'execution_observations' | 'id' | 'connection_id' | 'profile'>
+type Stamped = Pick<SessionInfo, 'execution_observations' | 'id' | 'connection_id' | 'profile'> &
+  Partial<Pick<SessionInfo, 'kanban_active' | 'kanban_parked'>>
+
+/** A producer that sent card counts but no `execution_observations` at all is an older backend (mixed
+ * version): its legacy live (unparked) cards still discover work, but as explicit unknown, never as
+ * certain running. Parked cards keep their legacy wait and blocked cards their legacy ask. */
+const legacyCardsWithoutObservations = (row: Partial<Stamped> | undefined): number =>
+  row && !Array.isArray(row.execution_observations)
+    ? Math.max(0, (row.kanban_active ?? 0) - Math.max(0, row.kanban_parked ?? 0))
+    : 0
 
 function ownerSource(owner: ReturnType<typeof knownOwnerForSession>) {
   if (isSessionOwnerRoute(owner)) {return gatewayRouteState(owner.connectionId, owner.profile).key}
@@ -50,7 +59,7 @@ export function rowExecution(row: Partial<Stamped> | undefined, nowSeconds: numb
 
   const roster = row?.id ? rosterRowEvidence($liveWorkRoster.get(), source, lineageAliases(row.id, $sessions.get())) : { records: [], missing: 0 }
   const list = [...(Array.isArray(row?.execution_observations) ? row.execution_observations : []), ...roster.records]
-  let missing = roster.missing
+  let missing = roster.missing + legacyCardsWithoutObservations(row)
 
   if (row?.id) {
     const aliases = lineageAliases(row.id, $sessions.get())
diff --git a/apps/desktop/src/store/live-work-roster.ts b/apps/desktop/src/store/live-work-roster.ts
index 9bd238c1f2..b6c9bb838d 100644
--- a/apps/desktop/src/store/live-work-roster.ts
+++ b/apps/desktop/src/store/live-work-roster.ts
@@ -152,6 +152,8 @@ export function noteEventFed(eventFedAt: Map<string, number>, aliases: readonly
 export const rosterSourceHasWork = (roster: LiveWorkRoster, source: string) =>
   Object.values(roster[source]?.sessions ?? {}).some(c => c.subagents > 0 || c.background > 0)
 
+const isRecord = (v: unknown): v is Record<string, unknown> => v !== null && typeof v === 'object' && !Array.isArray(v)
+
 /** Roster counts discover work, never establish liveness. Missing per-kind records stay unknown
  * beside other fresh records. `source` is the row's owner route, not its unqualified session id. */
 export function rosterRowEvidence(roster: LiveWorkRoster, source: string, aliases: readonly string[]) {
@@ -162,7 +164,21 @@ export function rosterRowEvidence(roster: LiveWorkRoster, source: string, aliase
     const counts = roster[source]?.sessions[alias]
 
     if (roster[source]?.failed) {
-      if (counts || roster[source].covers.has(alias)) {missing += Math.max(1, (counts?.background ?? 0) + (counts?.subagents ?? 0))}
+      // A failed read revokes current state, never outstanding asks: keep each cached record as an
+      // explicit unknown under its own identity, with its human requests and original clocks.
+      const cached = (counts?.execution_observations ?? []).filter(isRecord).map(record => ({
+        ...record,
+        state: 'unknown',
+        last_known_state: record.state,
+        unknown_reason: 'source_unavailable'
+      }))
+
+      records.push(...cached)
+
+      if (counts || roster[source].covers.has(alias)) {
+        const live = (counts?.background ?? 0) + (counts?.subagents ?? 0)
+        missing += Math.max(cached.length > 0 ? 0 : 1, live - cached.length)
+      }
 
       continue
     }
