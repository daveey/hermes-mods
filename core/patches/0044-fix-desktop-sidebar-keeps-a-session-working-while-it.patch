From 1597e882c43d36ddfeef5f9392ee6ec901095f60 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 13 Oct 2026 21:11:05 -0700
Subject: [PATCH] fix(desktop): sidebar keeps a session 'working' while its
 kanban tasks run [daveey]

A turn that hands work to kanban_create ends at once, so the sidebar painted
the session done (green stripe) while its kanban workers ran for hours.
Session-list endpoints now stamp kanban_active (queued/running tasks created
by the row's lineage, read from every board, 3s cache) and the dot state
claims 'background' for those rows, like async delegation.
---
diff --git a/apps/desktop/src/store/session-dot-state.test.ts b/apps/desktop/src/store/session-dot-state.test.ts
index d3be36451cc2d83e9a65513fc7534b7348ea9dfc..2c8919dd9ba37316dfea9c7a9935ee17a066b774 100644
--- a/apps/desktop/src/store/session-dot-state.test.ts
+++ b/apps/desktop/src/store/session-dot-state.test.ts
@@ -15,6 +15,7 @@ import {
 } from './session'
 import {
   $delegatingSessionIds,
+  $kanbanBusySessionIds,
   $sessionDotStateById,
   $unreadSessionCount,
   hasLiveTurn,
@@ -261,3 +262,43 @@ describe('$unreadSessionCount (titlebar badge)', () => {
     expect($sessionDotStateById.get()['cron-1']).not.toBe('unread')
   })
 })
+
+describe('kanban work in flight ($kanbanBusySessionIds)', () => {
+  beforeEach(() => {
+    clearAllSessionStates()
+    $sessions.set([])
+    $unreadFinishedSessionIds.set([])
+    $unreadWriteGuard.set(new Map())
+  })
+
+  afterEach(() => {
+    clearAllSessionStates()
+    $sessions.set([])
+    $unreadFinishedSessionIds.set([])
+  })
+
+  it('reads a finished turn with running kanban tasks as background, not done', () => {
+    setSessions([storedRow('s1', { kanban_active: 2, unread: true }), storedRow('s2')])
+
+    expect($kanbanBusySessionIds.get()).toEqual(['s1'])
+    expect($sessionDotStateById.get()['s1']).toBe('background')
+    expect(sessionStatusStripe($sessionDotStateById.get()['s1'] ?? 'idle', true)).toBeNull()
+    // Control: a plain finished session still gets its green stripe.
+    expect(sessionStatusStripe($sessionDotStateById.get()['s2'] ?? 'idle', true)).toBe('done')
+  })
+
+  it('goes back to done once the tasks finish', () => {
+    setSessions([storedRow('s1', { kanban_active: 1 })])
+    setSessions([storedRow('s1', { kanban_active: 0 })])
+
+    expect($kanbanBusySessionIds.get()).toEqual([])
+    expect(sessionStatusStripe($sessionDotStateById.get()['s1'] ?? 'idle', true)).toBe('done')
+  })
+
+  it('yields to a live turn', () => {
+    setSessions([storedRow('s1', { kanban_active: 1 })])
+    publishSessionState('rt1', { ...createClientSessionState('s1'), busy: true })
+
+    expect($sessionDotStateById.get()['s1']).toBe('working')
+  })
+})
