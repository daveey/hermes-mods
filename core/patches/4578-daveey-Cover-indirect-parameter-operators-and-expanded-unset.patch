From 0b9be8d86f93da3be2ffe5483142f8a07118300f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 12:30:14 +0000
Subject: [PATCH] [daveey] Cover indirect parameter operators and expanded
 unset

Why: name recovery recognized only colon/default indirect forms and incorrectly assumed expanded unset never re-evaluates subscripts. Existing scalar/array targets invalidate that premise. Recover all indirect operator families and expanded unset conservatively; retain prefix enumeration and plain-name controls.

Proof: 23 new harmless real-Bash marker cases failed at refusal before fix; 107 focused and 9154 full lifecycle tests pass after fix. Four helper mutants killed. Frozen 431-command/26-DB helper replay versus c1d532eb6fc7 has zero changed outputs (not full filesystem replay). All 20 scripts/check checks pass. Delayed nameref assignments/loops tracked separately by t_afe91fe3c5f8c071.
---
 cron/lifecycle_guard_arith_words.py           |  8 ++++----
 .../test_lifecycle_guard_name_indirection.py  | 19 ++++++++++++++++++-
 2 files changed, 22 insertions(+), 5 deletions(-)

diff --git a/cron/lifecycle_guard_arith_words.py b/cron/lifecycle_guard_arith_words.py
index 4b06b6988ac45894dcc6332bc1a39f86ac2e2281..e7290124ee706ddfc38236b30c3b8ab5e1224332 100644
--- a/cron/lifecycle_guard_arith_words.py
+++ b/cron/lifecycle_guard_arith_words.py
@@ -105,9 +105,9 @@ def _recursive_arithmetic_segment(segment: list[str]) -> bool:
     # NAME subscripts recursively evaluate variables just like explicit arithmetic.
     # Expansion-supplied names and nameref targets can hide the entire subscript
     # in an earlier assignment. A plain NAME does not: `read x` stays inert.
-    # Bash unset does not re-expand a subscript supplied through a parameter.
-    expanded_name = any("[" in token or (name != "unset" and "$" in token)
-                        for token in arguments)
+    # unset re-expands parameter-supplied subscripts when the target exists;
+    # its absence cannot be proved without tracking shell state.
+    expanded_name = any("[" in token or "$" in token for token in arguments)
     return name == "let" or (
         name == "[[" and (any(token in _INT_OPERATORS for token in arguments)
                           or ("-v" in arguments and expanded_name))
@@ -135,7 +135,7 @@ def _implicit_arithmetic_expansion(command: str) -> bool:
     This is only a context prefilter, not an evaluator. Preserve shell quoting so
     literal examples in printf/echo do not activate unrelated data assignments.
     """
-    tokens = re.compile(r'''\\.|'|"|\$\$|\$\[|\$\{![A-Za-z_]\w*(?=[}:])|\$\{[#!]?(?:[A-Za-z_]\w*|\d+|[@*#?$!-])(?:\[|:(?![-=?+]))''')
+    tokens = re.compile(r'''\\.|'|"|\$\$|\$\[|\$\{![A-Za-z_]\w*(?=[}:=+?/#%^,\-]|@[A-Za-z])|\$\{[#!]?(?:[A-Za-z_]\w*|\d+|[@*#?$!-])(?:\[|:(?![-=?+]))''')
     quoted = False
     pos = 0
     while match := tokens.search(command, pos):
diff --git a/tests/cron/test_lifecycle_guard_name_indirection.py b/tests/cron/test_lifecycle_guard_name_indirection.py
index 856169d9d0902d87e9d873a8eb7ac0abec8bf47d..04c18b7d445051ed2468691c7d0a8c8fe409b7fc 100644
--- a/tests/cron/test_lifecycle_guard_name_indirection.py
+++ b/tests/cron/test_lifecycle_guard_name_indirection.py
@@ -19,6 +19,11 @@ SHAPES = [
     r'x="a[\$(SCRIPT)]"; echo ${!x}',
     r'x="a[\$(SCRIPT)]"; echo "${!x}"',
     r'x="a[\$(SCRIPT)]"; echo ${!x:-d}',
+    *[f'x=\'a[$(SCRIPT)]\'; echo ${{!x{operator}}}' for operator in
+      ('-d', '+d', '=d', '?e', '#p', '##p', '%p', '%%p', '/a/b', '//a/b', '^', '^^', ',', ',,', '@Q')],
+    *[f'x=\'a[$(SCRIPT)]\'; {setup}; {unset} "$x"' for setup in
+      ('a=(1)', 'a=1', 'read -a a <<< 1', 'declare -A a')
+      for unset in ('unset', 'unset -v')],
     "declare 'a[$(SCRIPT)]=1'",
     r"declare a[\$\(SCRIPT\)]=1",
     "declare -a 'a[$(SCRIPT)]=1'",
@@ -166,7 +171,6 @@ def test_name_and_indirection_scripts_are_scanned(tmp_path, shape, bash_version)
     "x='a[$(SCRIPT)]'; printf -v x 1",
     "x='a[$(SCRIPT)]'; read x <<< 1",
     "x='a[$(SCRIPT)]'; unset x",
-    'x=\'a[$(SCRIPT)]\'; unset "$x"',
     "x='a[$(SCRIPT)]'; echo '${!x}'",
     r"x='a[$(SCRIPT)]'; echo \${!x}",
     "x='a[$(SCRIPT)]'; echo $${!x}",
@@ -182,6 +186,19 @@ def test_inert_name_words_stay_allowed(tmp_path, shape):
     assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (False, None)
 
 
+@pytest.mark.platforms("posix")
+def test_unset_unknown_target_conservatively_scans(tmp_path):
+    # No local target means no execution in this fixture, but inherited/sourced
+    # state may supply it; do not infer that every expanded unset is inert.
+    command = 'x=\'a[$(SCRIPT)]\'; unset "$x"'.replace("SCRIPT", str(tmp_path / "payload.sh"))
+    ran, script = _run_bash(tmp_path, command)
+    assert not ran
+    script.write_text("hermes gateway restart\n", encoding="utf-8")
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (True, None)
+    script.write_text("echo hello\n", encoding="utf-8")
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (False, None)
+
+
 @pytest.mark.parametrize("prefix", ["mapfile -t", "readarray -t", "wait -p"])
 def test_other_name_builtins_conservatively_recover_payload(prefix):
     # Bash versions differ in accepting subscripted names here; fail towards
