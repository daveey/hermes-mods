From 8d0e014385aadd91bfe294a91aa0a8d90edbb0a3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 13:51:51 +0000
Subject: [PATCH 6465] Sessions facts-mode CPU accounting, capture timing and collect attribution

Public mirror of source commit 8d0e014385aadd91bfe294a91aa0a8d90edbb0a3.

---
diff --git a/hermes_cli/sessions_fact_routes.py b/hermes_cli/sessions_fact_routes.py
index 2f24f9ffbd2..64b6a1841a2 100644
--- a/hermes_cli/sessions_fact_routes.py
+++ b/hermes_cli/sessions_fact_routes.py
@@ -150,8 +150,8 @@
             self._condition.notify_all()
 
     def response(self, name, selector):
-        # The legacy reader's own span never runs in facts mode. Account the read that
-        # replaced it, or a facts-served route looks like zero requests and zero CPU.
+        # The legacy reader's span never runs in facts mode: account the read replacing it.
+        # `runs` counts reads, not HTTP requests: a cold request reads twice (one fallback).
         with _la.pass_(f"route/profiles.{name}.facts") as accounted:
             touch = getattr(self._handle, 'touch', None)
             if touch is not None:
diff --git a/tests/hermes_cli/test_sessions_capture_process.py b/tests/hermes_cli/test_sessions_capture_process.py
index b13ff23ca06..71fd381364f 100644
--- a/tests/hermes_cli/test_sessions_capture_process.py
+++ b/tests/hermes_cli/test_sessions_capture_process.py
@@ -156,9 +156,27 @@
     assert owner_accounted() - owner_before < .1
 
 
+def test_reaped_grandchild_cpu_is_accounted():
+    # The capture child may fork helpers (git); CPU of those it reaped is the child's cost too.
+    grandchild = ('import time\nend = time.process_time() + .4\n'
+                  'while time.process_time() < end:\n    pass\n')
+    code = ('import subprocess, sys\nsys.stdin.buffer.read()\n'
+            f'subprocess.run([sys.executable, "-I", "-c", {grandchild!r}], check=True)\n' + frame())
+    before = _capture_child_stat()
+    capture = CaptureProcess(command=command(code))
+    try:
+        assert json.loads(capture('sessions', {}))['sessions'][0]['id'] == 'real-row'
+    finally:
+        capture.close()
+    after = _capture_child_stat()
+    assert after['errors'] == before.get('errors', 0)
+    assert after['cpu_s'] - before.get('cpu_s', 0) >= .35
+
+
 def test_failed_child_cpu_is_accounted_as_an_error():
     before = _capture_child_stat()
-    capture = CaptureProcess(seconds=.5, command=command(_burn(30, '')))
+    # A 2 s budget: on a loaded runner a 0.5 s child can get under 0.1 CPU-s.
+    capture = CaptureProcess(seconds=2, command=command(_burn(30, '')))
     with pytest.raises(CaptureUnavailable) as error:
         capture('sessions', {})
     assert error.value.reason == 'timeout'
