From d046b3821c1bf3a14c6a3cf081e18d7efed6cf8e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 01:47:57 -0700
Subject: [PATCH] fix(kanban): check resolved probes on dashboard create too
 [daveey]

---
 plugins/kanban/dashboard/plugin_api.py        |  3 ++-
 .../dashboard/plugin_api_human_request.py     | 11 ++++++++
 .../test_kanban_ask_resolved_check.py         | 25 +++++++++++++++++++
 3 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/plugins/kanban/dashboard/plugin_api.py b/plugins/kanban/dashboard/plugin_api.py
index ce20bb10b9..713664035b 100644
--- a/plugins/kanban/dashboard/plugin_api.py
+++ b/plugins/kanban/dashboard/plugin_api.py
@@ -571,7 +571,8 @@ def create_task(payload: CreateTaskBody, board: Optional[str] = Query(None)):
             parents=list(payload.parents), entry="rest")
         if refused:
             raise HTTPException(status_code=409, detail=json.loads(refused))
-        # CreateTaskBody field names (less the overlap override) match create_task's keyword parameters.
+        from .plugin_api_human_request import check_create_ask
+        check_create_ask(conn, payload)
         task_id = kanban_db.create_task(conn, created_by="dashboard", board=board, **fields)
         after_create(conn, task_id)
         task = kanban_db.get_task(conn, task_id)
diff --git a/plugins/kanban/dashboard/plugin_api_human_request.py b/plugins/kanban/dashboard/plugin_api_human_request.py
index 776a53c7b7..ddbfcec3ca 100644
--- a/plugins/kanban/dashboard/plugin_api_human_request.py
+++ b/plugins/kanban/dashboard/plugin_api_human_request.py
@@ -31,6 +31,17 @@ def classify_request(conn, task_id, payload, actor: str) -> bool:
                                    actor=actor, reason=payload.block_reason)
 
 
+def check_create_ask(conn, payload) -> None:
+    """[daveey] REST create shares filing guards and idempotent-retry semantics with tool/CLI create."""
+    from hermes_cli.kanban_ask_resolved import create_context, create_filing_error, idempotent_hit
+
+    status = None if idempotent_hit(conn, payload.idempotency_key) else payload.initial_status
+    error = create_filing_error(payload.human_request, status,
+                                context=create_context(conn, payload.workspace_path, payload.assignee))
+    if error:
+        raise HTTPException(status_code=409, detail=error)
+
+
 def ask_filing_refusal(conn, task_id: str, payload) -> Optional[str]:
     """[daveey] An ask filed with a ``resolved_check`` (block or metadata-only) runs it once first, in the card's
     sweep context, as every other filing path does (``kanban_ask_resolved``): exit 0 or a broken probe refuses."""
diff --git a/tests/hermes_cli/test_kanban_ask_resolved_check.py b/tests/hermes_cli/test_kanban_ask_resolved_check.py
index 16966dafc7..6150c3875c 100644
--- a/tests/hermes_cli/test_kanban_ask_resolved_check.py
+++ b/tests/hermes_cli/test_kanban_ask_resolved_check.py
@@ -558,6 +558,31 @@ def test_cli_create_retry_with_idempotency_key_runs_no_probe(board, capsys):
     assert (board / "runs").read_text().count("run") == 1
 
 
+# --- dashboard: create also uses the filing guard ----------------------------------------------------
+
+@pytest.mark.parametrize("cmd,code", [("true", kar.ALREADY_RESOLVED), ("exit 2", kar.BROKEN)])
+def test_dashboard_create_refuses_resolved_or_broken_probe(board, dashboard, cmd, code):
+    r = dashboard.post("/api/plugins/kanban/tasks", json={"title": "Pair watch", "assignee": "test-worker",
+        "initial_status": "blocked", "requires": [], "human_request": _ask(cmd)})
+    assert r.status_code == 409 and r.json()["detail"].startswith(code), r.text
+    with kbc.connect_closing() as conn:
+        assert not kb.list_tasks(conn)
+
+
+def test_dashboard_create_pending_and_idempotent_retry(board, dashboard):
+    args = {"title": "Pair watch", "assignee": "test-worker", "initial_status": "blocked", "requires": [],
+            "idempotency_key": "rest-pair", "human_request": _ask(_counting_probe(board))}
+    first = dashboard.post("/api/plugins/kanban/tasks", json=args)
+    assert first.status_code == 200, first.text
+    tid = first.json()["task"]["id"]
+    with kbc.connect_closing() as conn:
+        assert kb.get_task(conn, tid).status == "blocked" and _row(conn, tid)[2] == kar.PURPOSE
+    (board / "done").write_text("")
+    again = dashboard.post("/api/plugins/kanban/tasks", json=args)
+    assert again.status_code == 200 and again.json()["task"]["id"] == tid, again.text
+    assert (board / "runs").read_text().count("run") == 1
+
+
 # --- dashboard: PATCH and bulk run the filing probe too -------------------------------------------------
 
 @pytest.fixture
