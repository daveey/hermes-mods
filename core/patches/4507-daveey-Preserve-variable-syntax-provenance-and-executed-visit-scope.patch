+    variable_source: bool = True,
 ) -> bool:
     """``executed=False`` means *command* is the content of a file that is only MENTIONED in inert
     (masked) text: it is still scanned for a literal lifecycle command, but "could not scan" (budget,
@@ -1650,7 +1651,7 @@ def _contains_unsafe_gateway_action(
 
     def recurse(
         text: str, cwd: Optional[str], executed: bool, source: Optional[str], python_source: bool = False,
-        nested: bool = False, covered_quotes: Optional[tuple] = None,
+        nested: bool = False, covered_quotes: Optional[tuple] = None, variable_source: bool = True,
     ) -> bool:
         if python_source:
             return _python_source_is_unsafe(text, budget)
@@ -1658,7 +1659,7 @@ def _contains_unsafe_gateway_action(
             return _contains_unsafe_gateway_action(
                 text, cwd=cwd, depth=depth + 1, visited=visited, budget=budget,
                 read_remote_script=read_remote_script, executed=executed, source=source,
-                covered_quote_scope=covered_quotes,
+                covered_quote_scope=covered_quotes, variable_source=variable_source,
             )
 
     # The walks below must see the same masked view `_direct_lifecycle_scan` sees (#110422): a
@@ -1680,7 +1681,12 @@ def _contains_unsafe_gateway_action(
             walk_command, include_quoted=covered_quote_scope != quote_scope(cwd, executed, budget)))))
     nested_texts, nested_scripts = collect_nested_shell_inputs(
         command, walk_command, cwd=cwd, budget=budget, session_payloads=session_payloads)
-    from cron.lifecycle_guard_variables import scan_recursive_payloads
+    from cron.lifecycle_guard_variables import scan_recursive_payloads, scan_variable_payloads
+
+    if scan_variable_payloads(walk_command, cwd=cwd, executed=executed, budget=budget,
+                              recurse=recurse, source=source, variable_source=variable_source):
+        return True
+
 
     if scan_recursive_payloads(
             walk_command, nested_texts, cwd=cwd, executed=executed, budget=budget,
@@ -1704,7 +1710,7 @@ def _contains_unsafe_gateway_action(
             continue
         resolved = _resolve_lenient(script_path)
         scopes = unvisited_scopes(visited, budget, resolved, python_source=python_source,
-                                  nested=resolved in nested_scripts)
+                                  nested=resolved in nested_scripts, executed=candidate_executed)
         if not scopes:
             continue
         if not budget.charge_path():
diff --git a/cron/lifecycle_guard_nested_shells.py b/cron/lifecycle_guard_nested_shells.py
index 11ea390861e25b3065c6a7ef440fbd91efcd18ba..3600877ec2bc7ee1ee7e55dcb557c66225bc119f 100644
--- a/cron/lifecycle_guard_nested_shells.py
+++ b/cron/lifecycle_guard_nested_shells.py
@@ -58,7 +58,7 @@ def shell_scope(budget: _LifecycleScanBudget, nested: bool) -> contextlib.Abstra
 
 def unvisited_scopes(
     visited: set[object], budget: _LifecycleScanBudget, resolved: Path, *, python_source: bool,
-    nested: bool,
+    nested: bool, executed: bool = True,
 ) -> list[tuple[bool, tuple]]:
     """``(nested, visit key)`` for each scope *resolved* still needs a walk in. A shell walk
     depends on its scope (alias names, heredoc masking), so ``visited`` keys carry it: a path one
@@ -74,7 +74,10 @@ def unvisited_scopes(
         wanted.append((True, (None, True)))  # nested_shell_scope's state
     keys: dict[tuple, bool] = {}
     for flag, scope in wanted:
-        keys.setdefault((resolved, "shell", scope, budget.integer_context), flag)
+        # A mention does not cover an execution walk: only the latter
+        # resolves variable sinks and fails closed on referenced scan caps.
+        key = (resolved, "shell", scope, budget.integer_context)
+        keys.setdefault(key if executed else (*key, "mention"), flag)
     return [(flag, key) for key, flag in keys.items() if key not in visited]
 
 
diff --git a/cron/lifecycle_guard_output.py b/cron/lifecycle_guard_output.py
index 4f1a4125c0cdbb43ca528fd404cb992ce3ac1289..6c4bd64bce17440af98df5626abf4f2f8458ae07 100644
--- a/cron/lifecycle_guard_output.py
+++ b/cron/lifecycle_guard_output.py
@@ -22,25 +22,32 @@ def quote_scope(cwd, executed, budget) -> tuple:
 
 
 def iter_recursive_payloads(command, nested_texts, *, cwd, executed, budget, covered_scope):
+    """Yield payload, nested-shell, quote coverage, and shell-variable provenance.
+
+    Printed strings/overlapping quote spans are conservative candidates, not
+    original shell syntax. Resolving their standalone ``$log`` as a command would
+    promote a redirect's data binding into execution. Real nested shell programs
+    retain variable discovery; referenced files do too at their read boundary.
+    """
     from cron import lifecycle_guard as guard
 
     budget.integer_context = budget.integer_context or may_set_integer_attributes(command)
     for payload in nested_texts:
-        yield payload, True, None
+        yield payload, True, None, True
     for payload in guard._iter_shell_command_payloads(command):
-        yield payload, False, None
+        yield payload, False, None, True
     integer_context = budget.integer_context
     for payload in iter_arithmetic_word_payloads(command, integer_context=integer_context):
-        yield payload, False, None
+        yield payload, False, None, False
     # Snapshot after preceding nested-shell walks; shared budget state may have changed.
     scope = quote_scope(cwd, executed, budget)
     for payload, raw_quote in iter_printed_shell_payloads(
             command, include_quoted=covered_scope != scope):
-        yield payload, False, scope if raw_quote else None
+        yield payload, False, scope if raw_quote else None, False
     # Quoted eval text can establish attributes needed by the parent's later assignments.
     if budget.integer_context and not integer_context:
         for payload in iter_arithmetic_word_payloads(command, integer_context=True):
-            yield payload, False, None
+            yield payload, False, None, False
 
 
 def iter_printed_shell_payloads(
diff --git a/cron/lifecycle_guard_variables.py b/cron/lifecycle_guard_variables.py
index 665bb667c2983f98960053c9b583a42f5df394fa..7397f67546f84dae368c864c725ecd7d98a0969e 100644
--- a/cron/lifecycle_guard_variables.py
+++ b/cron/lifecycle_guard_variables.py
@@ -16,18 +16,23 @@ _DECLARATIONS = frozenset({'export', 'readonly', 'local', 'declare', 'typeset'})
 _SHELLS = frozenset({'bash', 'sh', 'zsh', 'dash', 'ksh', 'source', '.'})
 
 
+def scan_variable_payloads(command, *, cwd, executed, budget, recurse, source, variable_source):
+    if executed and variable_source:
+        for payload, payload_cwd in budget.variable_candidates.payloads(command, cwd):
+            if recurse(payload, payload_cwd, True, source):
+                return True
+    return False
+
+
 def scan_recursive_payloads(command, nested_texts, *, cwd, executed, budget,
                             covered_scope, recurse, source):
     from cron.lifecycle_guard_output import iter_recursive_payloads
 
-    if executed:
-        for payload, payload_cwd in budget.variable_candidates.payloads(command, cwd):
-            if recurse(payload, payload_cwd, True, source):
-                return True
-    for payload, nested, covered in iter_recursive_payloads(
+    for payload, nested, covered, variable_source in iter_recursive_payloads(
             command, nested_texts, cwd=cwd, executed=executed,
             budget=budget, covered_scope=covered_scope):
-        if recurse(payload, cwd, executed, source, nested=nested, covered_quotes=covered):
+        if recurse(payload, cwd, executed, source, nested=nested, covered_quotes=covered,
+                   variable_source=variable_source):
             return True
     return False
 
diff --git a/tests/cron/test_lifecycle_guard_function_variables.py b/tests/cron/test_lifecycle_guard_function_variables.py
index 20755c24692fdb81ff0b13c1e413b63c4dee32d3..3f95e44caaf62289ea99e23526c8841acfb7ae5e 100644
--- a/tests/cron/test_lifecycle_guard_function_variables.py
+++ b/tests/cron/test_lifecycle_guard_function_variables.py
@@ -55,3 +55,43 @@ def test_variable_state_does_not_leak_between_scans(tmp_path):
     (tmp_path / 'big.sh').write_text('#' + 'x' * (1024 * 1024 + 1))
     assert scan_gateway_lifecycle("P='bash big.sh'", cwd=str(tmp_path)) == (False, None)
     assert scan_gateway_lifecycle('f() { $P; }; f', cwd=str(tmp_path)) == (False, None)
+
+
+def test_mentioned_library_does_not_cover_variable_execution(tmp_path):
+    from cron.lifecycle_guard import _LifecycleScanBudget
+    from cron.lifecycle_guard_nested_shells import unvisited_scopes
+
+    budget = _LifecycleScanBudget()
+    path = tmp_path / 'lib.sh'
+    mentioned = unvisited_scopes(set(), budget, path, python_source=False,
+                                 nested=False, executed=False)
+    visited = {key for _, key in mentioned}
+    assert unvisited_scopes(visited, budget, path, python_source=False,
+                            nested=False, executed=True)
+    assert not unvisited_scopes(visited, budget, path, python_source=False,
+                                nested=False, executed=False)
+
+
+def test_printed_variable_is_not_original_shell_syntax():
+    from cron.lifecycle_guard import _LifecycleScanBudget
+    from cron.lifecycle_guard_output import iter_recursive_payloads
+
+    payloads = list(iter_recursive_payloads(
+        'echo "$log" | bash', [], cwd=None, executed=True,
+        budget=_LifecycleScanBudget(), covered_scope=None))
+    assert payloads
+    assert all(not item[-1] for item in payloads)
+    shell = list(iter_recursive_payloads(
+        "bash -c 'f() { $P; }; f'", [], cwd=None, executed=True,
+        budget=_LifecycleScanBudget(), covered_scope=None))
+    assert any(item[0] == 'f() { $P; }; f' and item[-1] for item in shell)
+
+
+def test_variable_discovery_skips_plain_text_without_tokenizing(monkeypatch):
+    from cron import lifecycle_guard
+    from cron.lifecycle_guard_variables import VariableCandidates
+
+    def forbidden(_command):
+        pytest.fail('plain masked payload must not pay for another tokenizer pass')
+    monkeypatch.setattr(lifecycle_guard, '_iter_command_segments', forbidden)
+    assert list(VariableCandidates().payloads('plain text\n' * 8000, None)) == []
