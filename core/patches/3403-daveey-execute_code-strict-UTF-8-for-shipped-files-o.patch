From 770292f9510e34cda39bf38a687ea6a8d90c4738 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:54:33 +0000
Subject: [PATCH] [daveey] execute_code: strict UTF-8 for shipped files;
 oversize result error says the call ran

Follow-up to PR #2092 review 5889650143 (non-blocking nits).

1. _remote_write escaped lone surrogates for every payload via _wire_bytes, including
   files shipped by _ship_file_to_remote (script.py, hermes_tools.py, kernel_runner.py,
   the env file). There a literal \udcXX is not the same text (raw/bytes literals,
   comments, shell-quoted env values). Only the RPC poller's JSON responses now opt in
   (rpc_result=True); every other ship encodes strict UTF-8 and raises before writing,
   as before #2092. _wire_bytes' docstring is scoped to RPC results.
2. The oversize error replaced the result after the tool already ran, so a
   side-effecting call (a patch with a big diff) read as failed and the "ask for less"
   hint invited a retry. It now says "<tool> ran, but its result is N bytes ... only its
   result was dropped: any change the call made stands, do not repeat it".
3. Comment on _wire_bytes: the round-trip claim is exact for lone surrogates; a
   high+low pair held as two code points would join on json.loads, which
   surrogateescape (U+DC80..U+DCFF only) never produces.

Tests (tests/tools/test_code_execution_terminal_full_output.py):
- new test_file_ship_refuses_a_lone_surrogate: RED (did not raise) before, GREEN after.
- test_remote_file_rpc_bounds_a_large_non_terminal_result asserts the new wording:
  RED before, GREEN after.
- 35 test files importing code_execution_*/code_kernel_remote: 863 passed, 5 skipped.
---
 ...est_code_execution_terminal_full_output.py | 26 +++++++++++++-
 tools/code_execution_rpc.py                   | 34 +++++++++++++------
 2 files changed, 48 insertions(+), 12 deletions(-)

diff --git a/tests/tools/test_code_execution_terminal_full_output.py b/tests/tools/test_code_execution_terminal_full_output.py
index aa727dce75..7954b897e6 100644
--- a/tests/tools/test_code_execution_terminal_full_output.py
+++ b/tests/tools/test_code_execution_terminal_full_output.py
@@ -180,7 +180,10 @@ def test_remote_file_rpc_bounds_a_large_non_terminal_result(monkeypatch):
                                   tool="read_file", log=log)
     assert set(r) == {"error", "result_bytes", "limit_bytes"}
     assert r["result_bytes"] > r["limit_bytes"] == 1024 * 1024
-    assert "read_file result is" in r["error"] and "offset/limit" in r["error"]
+    assert "result is" in r["error"] and "offset/limit" in r["error"]
+    # The tool already ran: the error must not read as a failed call to retry.
+    assert "read_file ran" in r["error"] and "only its result was dropped" in r["error"]
+    assert "do not repeat" in r["error"]
     assert shipped < 2 * 1024 * 1024
     assert log[-1]["tool"] == "read_file" and "limit" in log[-1]["error"]
     # A result within the cap ships unchanged.
@@ -188,6 +191,27 @@ def test_remote_file_rpc_bounds_a_large_non_terminal_result(monkeypatch):
     assert r == {"content": "x" * 1000}
 
 
+def test_file_ship_refuses_a_lone_surrogate():
+    """Only RPC results (JSON strings) escape surrogates: a shipped file (script.py,
+    hermes_tools.py, kernel_runner.py, the env file) would carry a literal \\udcXX that
+    means something else in a raw/bytes literal, a comment or a shell-quoted value, so a
+    lone surrogate there still fails loudly before anything is written."""
+    from tools.code_execution_tool import _ship_file_to_remote
+
+    calls = []
+
+    class Env:
+        def execute(self, cmd, cwd=None, timeout=None, stdin_data=None):
+            calls.append(cmd)
+            return {"output": "", "returncode": 0}
+
+    with pytest.raises(UnicodeEncodeError):
+        _ship_file_to_remote(Env(), "/sandbox/script.py", "print(r'\udc80')\n")
+    assert calls == []
+    _ship_file_to_remote(Env(), "/sandbox/script.py", "print('ok \u00e9')\n")
+    assert len(calls) == 1
+
+
 def test_local_socket_ships_a_lone_surrogate():
     """The local socket transport encoded strictly too; the surrogate now round-trips."""
     import socket
diff --git a/tools/code_execution_rpc.py b/tools/code_execution_rpc.py
index 5f1e399a1b..2eda30ea1d 100644
--- a/tools/code_execution_rpc.py
+++ b/tools/code_execution_rpc.py
@@ -60,17 +60,24 @@ def _execute_checked(env, cmd: str, what: str, *, timeout: int, **kwargs) -> dic
 
 
 def _wire_bytes(text: str) -> bytes:
-    """The UTF-8 bytes an RPC transport ships for *text*, and what a size cap must measure.
-    Tool results can hold lone surrogates (file reads decode undecodable bytes with
-    surrogateescape), which strict UTF-8 refuses: each becomes its ``\\uXXXX`` escape, which
-    inside a JSON string (where ``json.dumps`` puts every one) decodes back to the same text."""
+    """The UTF-8 bytes an RPC transport ships for a JSON-encoded RPC result *text*, and what
+    a size cap must measure. Tool results can hold lone surrogates (file reads decode
+    undecodable bytes with surrogateescape), which strict UTF-8 refuses: each becomes its
+    ``\\uXXXX`` escape, which inside a JSON string (where ``json.dumps`` puts every one)
+    decodes back to the same text. Only for RPC results: a shipped file (script, env file)
+    stays strict, since there the escape would be literal text."""
+    # Exact for lone surrogates only: a high+low pair held as two code points would ship as
+    # two escapes that json.loads joins into one astral char. surrogateescape yields only
+    # low surrogates (U+DC80..U+DCFF), so a tool result never holds such a pair.
     return text.encode("utf-8", "backslashreplace")
 
 
 def _remote_write(env, remote_path: str, content: str, *, atomic: bool = False,
-                  timeout: int = 30, check: bool = False):
+                  timeout: int = 30, check: bool = False, rpc_result: bool = False):
     """Write *content* owner-only to *remote_path*; returns the execute() result
-    (``check=True`` raises on failure via _execute_checked).
+    (``check=True`` raises on failure via _execute_checked). ``rpc_result=True`` (a JSON
+    RPC response) ships lone surrogates as escapes via _wire_bytes; anything else is
+    strict UTF-8, so a lone surrogate in a shipped file raises before anything is written.
 
     The base64 payload always travels as ``stdin_data``: pipe-mode backends
     (ssh, docker, local: the real shared-host ones) deliver it on
@@ -79,7 +86,8 @@ def _remote_write(env, remote_path: str, content: str, *, atomic: bool = False,
     for heredoc-mode backends (modal, daytona, vercel), and managed_modal
     forwards it as ``stdinData``, the same contract ``_write_to_sandbox``
     relies on."""
-    encoded = base64.b64encode(_wire_bytes(content)).decode("ascii")
+    raw = _wire_bytes(content) if rpc_result else content.encode("utf-8")
+    encoded = base64.b64encode(raw).decode("ascii")
     target = shlex.quote(remote_path)
     write = (f"base64 -d > {target}.tmp && mv -f {target}.tmp {target}"
              if atomic else f"base64 -d > {target}")
@@ -131,10 +139,14 @@ def _handle_rpc_request(request: dict, *, allowed_tools: frozenset, tool_call_co
     if full_output_cap is not None and isinstance(result, str):
         size = len(_wire_bytes(result))
         if size > full_output_cap:
+            # The call already ran: say so, or a side-effecting tool (patch, write_file) with a
+            # big result reads as failed and invites a retry of a change that landed.
             result = tool_error(
-                f"{tool_name} result is {size:,} bytes, over the {full_output_cap:,}-byte limit "
-                "of this remote sandbox's tool transport; ask for less (read_file offset/limit, "
-                "a narrower search_files pattern or limit, a shorter web_extract char_limit)",
+                f"{tool_name} ran, but its result is {size:,} bytes, over the "
+                f"{full_output_cap:,}-byte limit of this remote sandbox's tool transport, so "
+                "only its result was dropped: any change the call made stands, do not repeat it "
+                "to get the result. To read data, ask for less (read_file offset/limit, a "
+                "narrower search_files pattern or limit, a shorter web_extract char_limit)",
                 result_bytes=size, limit_bytes=full_output_cap)
     entry = {"tool": tool_name, "args_preview": str(tool_args)[:80],
              "duration": round(time.monotonic() - call_start, 2)}
@@ -344,7 +356,7 @@ def _rpc_poll_loop(env, rpc_dir: str, task_id: str, tool_call_log: list, tool_ca
                 # Atomic (tmp + rename) and owner-only; results carry tool output
                 # on a shared-host backend.
                 _remote_write(env, f"{rpc_dir}/res_{seq:06d}", tool_result,
-                              atomic=True, timeout=60)
+                              atomic=True, timeout=60, rpc_result=True)
                 env.execute(f"rm -f {quoted_req_file}", cwd="/", timeout=5)
         except Exception as e:
             if not stop_event.is_set():
