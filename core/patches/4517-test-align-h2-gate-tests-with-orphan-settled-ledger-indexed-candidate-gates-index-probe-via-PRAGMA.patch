From a9600aadc7caf74d7219228dad172ed61f4e74d2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 16:29:59 +0000
Subject: [PATCH] test: align h2 gate tests with
 orphan/settled-ledger/indexed-candidate gates; index probe via PRAGMA

---
 owned/cache/plugin_hooks.json               |  2 +-
 tests/tui_gateway/test_h2_gate_mutations.py | 23 ++++++++++++++-------
 tests/tui_gateway/test_h2_remainder_c11.py  | 13 ++++++------
 tui_gateway/notice_guarantee.py             |  3 ++-
 4 files changed, 25 insertions(+), 16 deletions(-)

diff --git a/owned/cache/plugin_hooks.json b/owned/cache/plugin_hooks.json
index 9463a3f16985cb9738c2a6ac6d08536cb4c7f85c..6397b924f8daedf247590912eb466c0d6b8e2053 100644
--- a/owned/cache/plugin_hooks.json
+++ b/owned/cache/plugin_hooks.json
@@ -1 +1 @@
-{"version": 1, "fingerprint": "996f20bf0ea902783a1c8683b4d731a42caa4b01f5dcb2117b36264e5c201c9e", "hooks": ["on_session_end", "post_tool_call", "pre_tool_call", "transform_tool_result"]}
\ No newline at end of file
+{"version": 1, "fingerprint": "417f2db477576e05458a5c19fdd4aff806808899aeffb5c40a7ee2aede6dc3f2", "hooks": ["on_session_end", "post_tool_call", "pre_tool_call", "transform_tool_result"]}
\ No newline at end of file
diff --git a/tests/tui_gateway/test_h2_gate_mutations.py b/tests/tui_gateway/test_h2_gate_mutations.py
index 136497be47619a56ee46ed9fca0449049adf9617..e0f7ed7a1450ce06a74cbb4ec98b99577804848a 100644
--- a/tests/tui_gateway/test_h2_gate_mutations.py
+++ b/tests/tui_gateway/test_h2_gate_mutations.py
@@ -334,7 +334,7 @@ def test_remote_pending_inputs_stay_hot(monkeypatch, tmp_path):
     from tui_gateway import kanban_replica_observer as observer
     ledger = tmp_path / 'ledger.db'
     with contextlib.closing(sqlite3.connect(ledger)) as conn:
-        conn.execute('CREATE TABLE notices(delivered INTEGER)')
+        conn.execute('CREATE TABLE notices(delivered INTEGER, holder_pid INTEGER)')
         conn.commit()
     monkeypatch.setattr(kanban_origin, '_hub_db', lambda: tmp_path / 'hub.db')
     monkeypatch.setattr(kanban_origin, 'gateway_names', lambda: ['me'])
@@ -343,7 +343,7 @@ def test_remote_pending_inputs_stay_hot(monkeypatch, tmp_path):
     monkeypatch.setattr(remote, 'ledger_path', lambda: ledger)
     remote._woken.clear()
     base = gates.probe('remote_notices')
-    assert not base.pending and base.key[1] == 'me' and base.key[2] == ('fp', 1)
+    assert not base.pending and base.key[1] == 'me' and isinstance(base.key[2], str)  # a content digest, not the replica counter
     monkeypatch.setattr(remote, '_sweep_snapshot', lambda p, me: ([{'key': 'a'}], {}))
     assert gates.probe('remote_notices').pending  # even delivered terminal cards are hot
     monkeypatch.setattr(remote, '_sweep_snapshot', lambda p, me: ([], {}))
@@ -353,9 +353,9 @@ def test_remote_pending_inputs_stay_hot(monkeypatch, tmp_path):
     finally:
         remote._woken.clear()
     with contextlib.closing(sqlite3.connect(ledger)) as conn:
-        conn.execute('INSERT INTO notices(delivered) VALUES (0)')
+        conn.execute('INSERT INTO notices(delivered, holder_pid) VALUES (0, 123)')
         conn.commit()
-    assert gates.probe('remote_notices').pending  # undelivered ledger row: stale-claim recovery
+    assert gates.probe('remote_notices').pending  # a HELD undelivered ledger row: stale-claim recovery
     monkeypatch.setattr(observer, 'fingerprint', lambda p: None)
     assert gates.probe('remote_notices').pending  # unknown replica state
     monkeypatch.setattr(kanban_origin, 'gateway_names', lambda: [''])
@@ -369,7 +369,7 @@ def test_remote_each_key_component_moves_the_key_independently(monkeypatch, tmp_
     from tui_gateway import kanban_replica_observer as observer
     ledger = tmp_path / 'ledger.db'
     with contextlib.closing(sqlite3.connect(ledger)) as conn:
-        conn.execute('CREATE TABLE notices(delivered INTEGER)')
+        conn.execute('CREATE TABLE notices(delivered INTEGER, holder_pid INTEGER)')
         conn.execute('INSERT INTO notices(delivered) VALUES (1)')
         conn.commit()
     state = {'fp': ('fp', 1), 'me': 'me', 'ledger': ledger}
@@ -382,8 +382,11 @@ def test_remote_each_key_component_moves_the_key_independently(monkeypatch, tmp_
     base = gates.probe('remote_notices')
     assert not base.pending
     assert gates.probe('remote_notices').key == base.key  # stable
-    state['fp'] = ('fp', 2)
-    assert gates.probe('remote_notices').key != base.key
+    state['fp'] = ('fp', 2)  # the replica's commit counter churns on every sync: it is NOT a key component
+    assert gates.probe('remote_notices').key == base.key
+    monkeypatch.setattr(remote, '_sweep_snapshot', lambda p, me: ([('gw', 'k', {'status': 'done'}, [])], {}))
+    assert gates.probe('remote_notices').key != base.key  # a swept card's content moves it
+    monkeypatch.setattr(remote, '_sweep_snapshot', lambda p, me: ([], {}))
     state['fp'] = ('fp', 1)
     state['me'] = 'you'
     assert gates.probe('remote_notices').key != base.key
@@ -576,7 +579,7 @@ def test_guarantee_store_appearing_or_vanishing_moves_the_key(store, tmp_path, m
 
 
 # ----------------------------------------------------------- board components move key independently
-def test_notices_second_board_change_moves_key_and_new_subscription_goes_hot():
+def test_notices_second_board_change_moves_key_and_new_subscription_goes_hot(tmp_path, monkeypatch):
     from hermes_cli import kanban_db as kb
     from hermes_cli import kanban_db_connect as kbc
     from hermes_cli import kanban_db_notify as notify
@@ -584,6 +587,10 @@ def test_notices_second_board_change_moves_key_and_new_subscription_goes_hot():
     with contextlib.closing(kbc.connect()) as conn:
         kb.create_task(conn, title='default board exists', assignee='w')
     create_board('second')
+    from hermes_state import SessionDB
+    chat_db = SessionDB(tmp_path / 'chat-state.db')
+    chat_db.create_session('chat', 'desktop')  # an existing chat: a sub whose chat is in no store is an orphan (inert)
+    monkeypatch.setattr(gates, '_profile_paths', lambda every_store=True: [chat_db.db_path])
     base = gates.probe('notices')
     assert not base.pending and len(base.key) == 2
     with contextlib.closing(kbc.connect(board='second')) as conn:
diff --git a/tests/tui_gateway/test_h2_remainder_c11.py b/tests/tui_gateway/test_h2_remainder_c11.py
index a1da49120a928b352dbc4c1d864404a0899d35fd..1c4f61bab91c1b0a9e16dc269c63b06793133d3d 100644
--- a/tests/tui_gateway/test_h2_remainder_c11.py
+++ b/tests/tui_gateway/test_h2_remainder_c11.py
@@ -122,24 +122,25 @@ def _subscribe(chat="chat", done=True):
     return tid
 
 
-def test_notice_for_a_live_chat_is_not_pending_until_the_chat_unloads(db):
+def test_notice_for_a_live_chat_is_not_pending_until_the_chat_unloads(db, monkeypatch):
     """A chat unloading with a pending notice: the sweep skips live chats, so the notice waits on the live set."""
-    _subscribe("chat")
-    assert gates.probe("notices", live={"chat"}).pending is False
+    monkeypatch.setattr(gates, "_profile_paths", lambda every_store=True: [db.db_path])
+    _subscribe(CHAT)
+    assert gates.probe("notices", live={CHAT}).pending is False
     assert gates.probe("notices", live=set()).pending is True
     ran = []
-    for live in ({"chat"}, {"chat"}, set(), set()):
+    for live in ({CHAT}, {CHAT}, set(), set()):
         gates.run("notices", lambda: ran.append(1) or [], live=live)
     assert len(ran) == 3  # first live pass, the unload, and the unloaded notice stays hot (never stamped)
 
 
 def test_inflight_claim_on_a_live_chat_stays_pending(db):
-    tid = _subscribe("chat")
+    tid = _subscribe(CHAT)
     with contextlib.closing(kbc.connect()) as conn:
         conn.execute("UPDATE kanban_notify_subs SET inflight_from=1, inflight_pid=1, inflight_start=1, inflight_at=1 "
                      "WHERE task_id=?", (tid,))
         conn.commit()
-    assert gates.probe("notices", live={"chat"}).pending is True
+    assert gates.probe("notices", live={CHAT}).pending is True
 
 
 def test_board_writes_do_not_move_the_notices_key(db):
diff --git a/tui_gateway/notice_guarantee.py b/tui_gateway/notice_guarantee.py
index 3dc24c17d0641b383f7ae637b5baa211e145fdc1..cf84d27f43d1b55151de3e54efda369d135990f2 100644
--- a/tui_gateway/notice_guarantee.py
+++ b/tui_gateway/notice_guarantee.py
@@ -125,7 +125,8 @@ def candidates_sql(db: Any) -> str:
     """The indexed form when the store has ``idx_messages_kanban_notice`` (a build older than this one, or a
     store not yet reconciled by a writer, does not: the legacy form is the same rows, only slower)."""
     try:
-        has = db._read_one("SELECT 1 FROM sqlite_master WHERE type = 'index' AND name = 'idx_messages_kanban_notice'")
+        with db._read_ctx() as conn:
+            has = any(r[1] == 'idx_messages_kanban_notice' for r in conn.execute('PRAGMA index_list(messages)'))
     except Exception:  # health: allow BLE001 -- the legacy scan is always correct
         return _CANDIDATES_SQL
     return _CANDIDATES_INDEXED_SQL if has else _CANDIDATES_SQL
