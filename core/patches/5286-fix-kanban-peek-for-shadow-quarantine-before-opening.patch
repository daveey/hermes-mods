From b0d7ac8aa8de5a520038ffa7d10d1739ac80e553 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 16:05:24 +0000
Subject: [PATCH] fix(kanban): peek for shadow quarantine before opening a
 second round connection

---
 hermes_cli/kanban_sync_client.py     |  2 +-
 hermes_cli/kanban_sync_quarantine.py | 15 +++++++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index 6c3912de05..624c23fd8f 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -1032,7 +1032,7 @@ def _sync_board_locked(slug: str, path: Path, hub: Hub, gateway: str) -> RoundRe
         # An earlier round may have committed a quarantine before a later page
         # failed. Copy that safety state before sending anything this round.
         replica_path = shadow_path(slug)
-        if replica_path.exists():
+        if replica_path.exists() and quarantine.file_holds(replica_path):
             with connection(replica_path, lambda: open_shadow(slug, gateway)) as replica:
                 quarantine.adopt(replica, live)
         # Send before pulling as well as after: a pull backlog never holds local edits back (9 h, t_01a1d36ddcea59fe).
diff --git a/hermes_cli/kanban_sync_quarantine.py b/hermes_cli/kanban_sync_quarantine.py
index 8737ae6adb..3c69199d25 100644
--- a/hermes_cli/kanban_sync_quarantine.py
+++ b/hermes_cli/kanban_sync_quarantine.py
@@ -32,6 +32,21 @@ def _exists(conn) -> bool:
     return conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='containment_sync_quarantine'").fetchone() is not None
 
 
+def file_holds(path: Path) -> bool:
+    """Cheap peek: does this database file hold any quarantine row? Opens no pooled shadow connection."""
+    import sqlite3
+    try:
+        peek = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=5)
+    except sqlite3.Error:
+        return False
+    try:
+        return _exists(peek) and peek.execute("SELECT 1 FROM containment_sync_quarantine LIMIT 1").fetchone() is not None
+    except sqlite3.Error:
+        return False
+    finally:
+        peek.close()
+
+
 def install(conn) -> None:
     from hermes_cli import kanban_containment_guard as guard
     from hermes_cli.kanban_containment_connections import verifier
