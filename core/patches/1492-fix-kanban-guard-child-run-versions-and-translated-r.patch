From 6110db6d1b1a2a29d3696894152802b253f60293 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 12:31:01 +0000
Subject: [PATCH] fix(kanban): guard child run versions and translated
 references [daveey]

---
 hermes_cli/kanban_sync_rejections.py          |  8 ++++--
 .../hermes_cli/test_kanban_sync_rejections.py | 28 +++++++++++++++++++
 2 files changed, 33 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_sync_rejections.py b/hermes_cli/kanban_sync_rejections.py
index e1af49c760c..5a6d38f0fbe 100644
--- a/hermes_cli/kanban_sync_rejections.py
+++ b/hermes_cli/kanban_sync_rejections.py
@@ -64,9 +64,11 @@ def _classify(op, before, evidence, parent_evidence):
         if (remote.get("uid") != op["row_uid"] or not isinstance(version, int)
                 or version < (op.get("base_version") or 0)):
             return "unresolved", "authoritative identity/version does not cover rejected write"
-        if op["table_name"] == "tasks" and local.get("sync_version") != version:
-            return "unresolved", "local task has not settled at authoritative version"
-        if local.get("current_run_id") is not None and before["fields"].get("current_run_uid") is None:
+        if op["table_name"] in ("tasks", "task_runs") and local.get("sync_version") != version:
+            return "unresolved", "local row has not settled at authoritative version"
+        if any(table == op["table_name"] and local.get(column) is not None
+               and before["fields"].get(wire) is None
+               for (table, column), wire in sync.REF_COLUMNS.items()):
             return "unresolved", "local run reference cannot be translated"
         if fields and all(k in before["fields"] and k in remote and before["fields"][k] == remote[k] for k in fields):
             return "superseded", "authoritative row equals current local values for every rejected wire field"
diff --git a/tests/hermes_cli/test_kanban_sync_rejections.py b/tests/hermes_cli/test_kanban_sync_rejections.py
index d6ddb16752f..44b2962ccad 100644
--- a/tests/hermes_cli/test_kanban_sync_rejections.py
+++ b/tests/hermes_cli/test_kanban_sync_rejections.py
@@ -125,6 +125,34 @@ def test_cli_diff_dirty_then_clean_after_normal_sync(live, svc, kanban_home, mon
     assert json.loads(capsys.readouterr().out)["clean"] is True
 
 
+@pytest.mark.parametrize("table,translated,settled", [
+    ("task_events", False, True), ("task_events", True, True),
+    ("task_runs", True, False), ("task_runs", True, True),
+])
+def test_child_reference_translation_and_run_version(live, svc, table, translated, settled):
+    tid = kb.create_task(live, title="child controls", assignee="worker")
+    client.push(live, svc.hub(ME), BOARD, ME, primary=False)
+    with kbc.write_txn(live):
+        live.execute("UPDATE kanban_sync_state SET applying=1")
+        live.execute("INSERT INTO task_runs (id,uid,task_id,status,sync_version,started_at) VALUES (123,'run-uid',?,'done',?,1)",
+                     (tid, 3 if settled else 2))
+        if table == "task_events":
+            live.execute("INSERT INTO task_events (uid,task_id,run_id,kind,created_at) VALUES ('event-uid',?,?,'done',1)",
+                         (tid, 123 if translated else 999))
+        live.execute("UPDATE kanban_sync_state SET applying=0")
+        uid = "event-uid" if table == "task_events" else "run-uid"
+        fields = {"run_uid": "old-run"} if table == "task_events" else {"status": "blocked"}
+        live.execute("INSERT INTO kanban_sync_outbox (op_id,table_name,row_uid,op,fields,hlc,created_at,state) "
+                     "VALUES ('child-op',?,?,'upsert',?,'',1,'rejected')", (table, uid, json.dumps(fields)))
+    remote = {"uid": uid, "version": 3, "status": "done", "run_uid": "run-uid" if translated else None}
+    svc.board(BOARD)["rows"].setdefault(table, {})[uid] = remote
+    from hermes_cli.kanban_sync_rejections import resolve_rejections
+    reports = resolve_rejections(live, svc.hub(ME), BOARD)
+    expected = "superseded" if translated and settled else "unresolved"
+    assert reports[0]["classification"] == expected
+    assert client.status(live)["rejected"] == int(expected == "unresolved")
+
+
 def ghost(live):
     with kbc.write_txn(live):
         live.execute("INSERT INTO kanban_sync_outbox (op_id,table_name,row_uid,op,fields,hlc,created_at,state,last_error) "
-- 
2.55.0

