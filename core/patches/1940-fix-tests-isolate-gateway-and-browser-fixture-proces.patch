From b0b38083a71cb356d00d67f79ba58b555a5008f1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 4 Nov 2026 18:24:59 +0000
Subject: [PATCH] fix(tests): isolate gateway and browser fixture process
 discovery [daveey]

---
 tests/hermes_cli/test_gateway_restart_loop.py |  5 +++--
 tests/tools/test_browser_launcher_reclaim.py  | 22 +++++++++++++++++--
 tests/tools/test_browser_orphan_reaper.py     |  3 +++
 3 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/tests/hermes_cli/test_gateway_restart_loop.py b/tests/hermes_cli/test_gateway_restart_loop.py
index fb3e76afdb4..7156b597fd5 100644
--- a/tests/hermes_cli/test_gateway_restart_loop.py
+++ b/tests/hermes_cli/test_gateway_restart_loop.py
@@ -485,8 +485,9 @@ class TestGatewaySelfTargetingGuard:
         def _sentinel(*a, **k):
             raise _Reached()
 
-        monkeypatch.setattr(gw, "_dispatch_via_service_manager_if_s6", _sentinel)
-        monkeypatch.setattr(gw, "_dispatch_all_via_service_manager_if_s6", _sentinel)
+        # This is the first boundary after the self-targeting guard, before
+        # host process discovery or service/session inspection can run.
+        monkeypatch.setattr("hermes_cli.gateway_profile_lifecycle.profile_lifecycle", _sentinel)
         args = Namespace(gateway_command="stop", all=False, system=False)
         with pytest.raises(_Reached):
             gw.gateway_command(args)
diff --git a/tests/tools/test_browser_launcher_reclaim.py b/tests/tools/test_browser_launcher_reclaim.py
index 43961008994..6f64389774a 100644
--- a/tests/tools/test_browser_launcher_reclaim.py
+++ b/tests/tools/test_browser_launcher_reclaim.py
@@ -25,6 +25,22 @@ pytestmark = [pytest.mark.platforms("linux"),
 _REPO = Path(__file__).resolve().parents[2]
 
 
+@pytest.fixture
+def browser_processes(monkeypatch):
+    """Enumerate only our real subprocesses; keep real argv/liveness checks."""
+    import psutil
+
+    processes = []
+
+    def process_iter(*args, **kwargs):
+        for proc in processes:
+            if proc.poll() is None:
+                yield psutil.Process(proc.pid)
+
+    monkeypatch.setattr(psutil, "process_iter", process_iter)
+    return processes
+
+
 def _dir_of_a_dead_owner() -> Path:
     """A throwaway profile dir named for a Hermes process that has exited (it died mid-launch)."""
     from hermes_constants import hermes_home_key
@@ -52,11 +68,12 @@ def _stop(proc: subprocess.Popen) -> None:
     proc.wait(timeout=10)
 
 
-def test_an_unrecorded_live_browsers_throwaway_profile_survives_the_reclaim(tmp_path):
+def test_an_unrecorded_live_browsers_throwaway_profile_survives_the_reclaim(tmp_path, browser_processes):
     """Owner SIGKILLed before its record existed, its Chromium still up: reclaim waits for that Chromium."""
     script = write_fake_chromium(tmp_path / "chromium")
     udd = _dir_of_a_dead_owner()
     proc = _start_browser_on(script, udd, tmp_path / "chromium.log")
+    browser_processes.append(proc)
     try:
         launcher.reap_orphaned_browsers()
         assert udd.is_dir(), "the reaper deleted the profile of a Chromium still running on it"
@@ -69,13 +86,14 @@ def test_an_unrecorded_live_browsers_throwaway_profile_survives_the_reclaim(tmp_
         kill_fake(proc.pid, script)
 
 
-def test_a_live_browsers_profile_survives_when_its_record_cannot_prove_the_pid(tmp_path):
+def test_a_live_browsers_profile_survives_when_its_record_cannot_prove_the_pid(tmp_path, browser_processes):
     """A record whose start time no longer proves the pid is never signalled; its dir must not go either while a
     Chromium still runs on it."""
     from hermes_constants import hermes_home_key
     script = write_fake_chromium(tmp_path / "chromium")
     udd = _dir_of_a_dead_owner()
     proc = _start_browser_on(script, udd, tmp_path / "chromium.log")
+    browser_processes.append(proc)
     try:
         unprovable = launcher.LaunchedBrowser(key="lost", pid=proc.pid, start_time=1, cdp_url="", http_url="",
                                               user_data_dir=str(udd), owned=True, ephemeral=True,
diff --git a/tests/tools/test_browser_orphan_reaper.py b/tests/tools/test_browser_orphan_reaper.py
index df7ad55993e..75a51d6fd2f 100644
--- a/tests/tools/test_browser_orphan_reaper.py
+++ b/tests/tools/test_browser_orphan_reaper.py
@@ -34,6 +34,9 @@ def records(monkeypatch):
     monkeypatch.setattr(launcher, "_served_homes", set(), raising=False)
     monkeypatch.setattr(launcher, "_browsers", {})
     monkeypatch.setattr(launcher, "_procs", {})
+    # Records and liveness are synthetic; unrelated host browsers must not
+    # enter the fallback argv scan (which resolves their real profile paths).
+    monkeypatch.setattr("psutil.process_iter", lambda *a, **k: iter(()))
     terminated = []
     monkeypatch.setattr(launcher, "_terminate", lambda pid, start_time, proc: terminated.append(pid))
     return SimpleNamespace(dir=path, terminated=terminated,
-- 
