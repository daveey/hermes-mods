From 9f1a0b1eb92c02a4cafa5663a9853c38689a3c70 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:54:03 +0000
Subject: [PATCH] [daveey] desktop: chunk-check budget rejects fractional ms;
 harness hint names throttled hosts

Follow-up to PR #2313 (review 5893294816).

1) Behaviour: chunkCheckTimeoutMs accepted any finite positive number, so
   HERMES_CHUNK_CHECK_TIMEOUT_MS=1500.5 reached spawnSync, whose `timeout`
   must be an integer: it threw RangeError ERR_OUT_OF_RANGE out of
   checkDistBuilt instead of returning a verdict. It now requires
   Number.isInteger and otherwise falls back to the 30 min default.
2) main()'s harness hint blamed only a Windows stalled process creation/AV.
   It now also names an ETIMEDOUT on a throttled or contended host
   (background-QoS prebuild, loaded box) and the override knob.
3) A comment says why the override is an env var: a build-script knob that
   runs before any Hermes config is loaded (precedent
   HERMES_DESKTOP_LIFECYCLE_TIMEOUT_MS in test-desktop.mjs).

Proof (pool worker, node 26.12.1, separate pnpm deps tree):
- RED (new tests only, old script): tests-js/renderer-syntax-timeout.test.mjs
  2 failed | 2 passed: "expected 1500.5 to be 1800000" and
  "RangeError: The value of "timeout" is out of range. It must be an
  integer. Received 1500.5".
- GREEN: renderer-syntax-timeout.test.mjs 4 passed;
  apps/desktop/scripts/assert-dist-built.test.mjs 11 passed; eslint clean
  on both files.
---
 apps/desktop/scripts/assert-dist-built.mjs | 12 +++++++++-
 tests-js/renderer-syntax-timeout.test.mjs  | 28 ++++++++++++++++++++++
 2 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/scripts/assert-dist-built.mjs b/apps/desktop/scripts/assert-dist-built.mjs
index cc75795d73..5a6100d163 100644
--- a/apps/desktop/scripts/assert-dist-built.mjs
+++ b/apps/desktop/scripts/assert-dist-built.mjs
@@ -103,9 +103,16 @@ export function checkDistBuilt(distDir) {
 // A false failure costs a whole rebuild; a real stall only costs this wait, so err long.
 export const DEFAULT_CHUNK_CHECK_TIMEOUT_MS = 30 * 60_000
 
+// The override is an environment variable, not a config key, because this is a build-script knob:
+// the script runs under `pnpm run build` (and the unattended prebuild) before any Hermes runtime or
+// config is loaded, and only whoever runs the build needs to turn it. Same precedent as
+// HERMES_DESKTOP_LIFECYCLE_TIMEOUT_MS in test-desktop.mjs.
+//
+// Only a positive integer counts: spawnSync's `timeout` throws ERR_OUT_OF_RANGE on a fraction
+// (e.g. 1500.5), which would escape checkDistBuilt as an exception instead of a verdict.
 export function chunkCheckTimeoutMs(env = process.env) {
   const raw = Number(env.HERMES_CHUNK_CHECK_TIMEOUT_MS)
-  return Number.isFinite(raw) && raw > 0 ? raw : DEFAULT_CHUNK_CHECK_TIMEOUT_MS
+  return Number.isInteger(raw) && raw > 0 ? raw : DEFAULT_CHUNK_CHECK_TIMEOUT_MS
 }
 
 // Renderer chunks are emitted as ESM (`<script type="module">` in index.html).
@@ -190,6 +197,9 @@ function main() {
       console.error("  This is a failure of the CHECK, not of the bundle: node did not run to")
       console.error("  completion. On Windows that is usually a stalled process creation")
       console.error("  (antivirus/EDR interference, memory pressure) and clears on a retry.")
+      console.error("  An ETIMEDOUT on a throttled or contended host (a background-QoS")
+      console.error("  prebuild, a loaded box) means the check was slow, not broken: raise")
+      console.error("  HERMES_CHUNK_CHECK_TIMEOUT_MS (milliseconds) or build when it is idle.")
       console.error("  If it repeats, check the node binary and any AV exclusion for the")
       console.error(`    build tree, then re-run: cd ${desktopRoot} && pnpm run build\n`)
       process.exit(1)
diff --git a/tests-js/renderer-syntax-timeout.test.mjs b/tests-js/renderer-syntax-timeout.test.mjs
index 64c2c5fa5c..9ca93d99ea 100644
--- a/tests-js/renderer-syntax-timeout.test.mjs
+++ b/tests-js/renderer-syntax-timeout.test.mjs
@@ -20,6 +20,34 @@ describe('renderer chunk check budget', () => {
     }
   })
 
+  test('a non-integer budget falls back to the default instead of crashing spawnSync', async () => {
+    // spawnSync's `timeout` must be an integer: 1500.5 throws ERR_OUT_OF_RANGE out of checkDistBuilt.
+    const { chunkCheckTimeoutMs } = await import(checker)
+    for (const bad of ['1500.5', '0.5', '1e-3']) {
+      const ms = chunkCheckTimeoutMs({ HERMES_CHUNK_CHECK_TIMEOUT_MS: bad })
+      expect(ms).toBe(chunkCheckTimeoutMs({}))
+      expect(Number.isInteger(ms)).toBe(true)
+    }
+    expect(chunkCheckTimeoutMs({ HERMES_CHUNK_CHECK_TIMEOUT_MS: '1500.0' })).toBe(1500)
+  })
+
+  test('a fractional budget in the environment still lets checkDistBuilt return a verdict', async () => {
+    const { checkDistBuilt } = await import(checker)
+    const root = mkdtempSync(join(tmpdir(), 'renderer-check-fraction-'))
+    const saved = process.env.HERMES_CHUNK_CHECK_TIMEOUT_MS
+    try {
+      mkdirSync(join(root, 'assets'))
+      writeFileSync(join(root, 'index.html'), '<!doctype html>')
+      writeFileSync(join(root, 'assets', 'index-fixture.js'), 'export const value = 1')
+      process.env.HERMES_CHUNK_CHECK_TIMEOUT_MS = '1500.5'
+      expect(checkDistBuilt(root)).toEqual({ ok: true })
+    } finally {
+      if (saved === undefined) delete process.env.HERMES_CHUNK_CHECK_TIMEOUT_MS
+      else process.env.HERMES_CHUNK_CHECK_TIMEOUT_MS = saved
+      rmSync(root, { recursive: true, force: true })
+    }
+  }, 120_000)
+
   test.skipIf(process.platform === 'win32')('a slow node passes within the budget; only overrunning it is a harness failure', () => {
     const root = mkdtempSync(join(tmpdir(), 'renderer-check-budget-'))
     try {
-- 
