From 7fc764bc81d0125b88cc76c0eeb219c9b11d3171 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 19:57:30 +0000
Subject: [PATCH] test: pin chronological run ordering for _latest_run and
 latest_run_skipping_requeues

---
 .../test_kanban_operator_resume_requeue.py    | 32 ++++++++++++++++++-
 1 file changed, 31 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_operator_resume_requeue.py b/tests/hermes_cli/test_kanban_operator_resume_requeue.py
index 7d6997de1e..bf6804125e 100644
--- a/tests/hermes_cli/test_kanban_operator_resume_requeue.py
+++ b/tests/hermes_cli/test_kanban_operator_resume_requeue.py
@@ -13,7 +13,7 @@ import pytest
 from hermes_cli import kanban_db as kb
 from hermes_cli import kanban_db_connect as kbc
 from hermes_cli import kanban_operator_resume as resume
-from hermes_cli.kanban_core_update_requeue import CORE_UPDATE_REQUEUE_REASON
+from hermes_cli.kanban_core_update_requeue import CORE_UPDATE_REQUEUE_REASON, latest_run_skipping_requeues
 from tests.hermes_cli import test_kanban_operator_resume as base
 
 kanban_home, clock, _held, _guard = base.kanban_home, base.clock, base._held, base._guard
@@ -139,3 +139,33 @@ def test_receipt_matches_by_run_uid_on_synced_schema_with_out_of_order_ids(kanba
     _run(clock, tid, "worker crashed")  # a genuinely newer run still spends it
     _stamp_uids(tid, prefix="01a1f999-0000-7000-8000-")
     assert _guard(tid) == "active_pr"
+
+
+def _runs_by_start(conn, tid):
+    return conn.execute("SELECT id, outcome FROM task_runs WHERE task_id=? ORDER BY started_at, id", (tid,)).fetchall()
+
+
+def test_latest_run_is_the_newest_started_not_the_highest_id(kanban_home, clock):
+    tid = _resumed(clock)
+    _run(clock, tid, CORE_UPDATE_REQUEUE_REASON)  # newest-started run
+    _older_run_with_higher_id(tid)
+    with kbc.connect_closing() as conn:
+        by_start = _runs_by_start(conn, tid)
+        highest = conn.execute("SELECT id FROM task_runs WHERE task_id=? ORDER BY id DESC LIMIT 1", (tid,)).fetchone()
+        assert by_start[0]["id"] == highest["id"]  # replica shape: the oldest-started run has the highest id
+        latest = resume._latest_run(conn, tid)
+    assert latest["id"] == by_start[-1]["id"] != highest["id"]
+    assert latest["outcome"] == "reclaimed"
+
+
+def test_latest_run_skipping_requeues_ignores_an_older_run_with_the_highest_id(kanban_home, clock):
+    tid = _resumed(clock)
+    with kbc.connect_closing() as conn:
+        checkpoint = resume._latest_run(conn, tid)["id"]
+    _run(clock, tid, CORE_UPDATE_REQUEUE_REASON)  # a requeue follows the checkpoint run
+    _older_run_with_higher_id(tid)
+    with kbc.connect_closing() as conn:
+        highest = conn.execute("SELECT id FROM task_runs WHERE task_id=? ORDER BY id DESC LIMIT 1", (tid,)).fetchone()
+        assert highest["id"] not in (checkpoint,)
+        run = latest_run_skipping_requeues(conn, tid)
+    assert run["id"] == checkpoint != highest["id"]
-- 
