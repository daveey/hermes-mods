From 5b3cff1d30639c6a45d922c7a3d7519dc62ff536 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 06:58:50 +0000
Subject: [PATCH] fix(sessions): preserve agent proof identity through
 compression [daveey]

Problem: completed compressed agent CLI proofs evade retirement and their
continuations can become sidebar-visible.
Why 1: compression parents are excluded while their child is authoritative.
Why 2: child publication did not inherit hidden or _agent_cli.
Root (happened): creation provenance was not a conversation-lifetime contract.
Root (not caught): create/retirement tests omitted real compression publication.
Recurrence: exact-head independent review of PR #3898 found this before landing.

Carry _agent_cli on continuations and copy their visibility in the publication
transaction, without changing branch/reset or human-chat defaults.
Proof: eight real compression cases fail on a1a020e7 and pass after the fix;
ended, done and idle hidden lineages retire; active and explicitly visible
lineages remain unarchived. Full scripts/check passes.
---
 hermes_state_compression.py                   |  5 ++-
 .../test_agent_cli_compression.py             | 36 +++++++++++++++++++
 2 files changed, 40 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_state/test_agent_cli_compression.py

diff --git a/hermes_state_compression.py b/hermes_state_compression.py
index b48ca75ee3..063f5b3ef1 100644
--- a/hermes_state_compression.py
+++ b/hermes_state_compression.py
@@ -121,7 +121,7 @@ _CHAIN_CAP = 1000
 # ``hermes sessions refresh-prompts`` request and rebuilds its prompt once more after eviction.
 # ``_chat_adopted`` (``gateway.session_lifecycle.CHAT_ADOPTED_MARKER``): a delegate row the user resumed a
 # chat onto stays that chat's conversation past a rotation, or the route guard rejects the new tip.
-_CONVERSATION_MODEL_CONFIG_KEYS = ("onboarding_run", "prompt_refresh_epoch", "_chat_adopted")
+_CONVERSATION_MODEL_CONFIG_KEYS = ("onboarding_run", "prompt_refresh_epoch", "_chat_adopted", "_agent_cli")
 
 
 def _walk_compression_chain(session_id: str, step) -> list[str]:
@@ -407,6 +407,9 @@ class SessionCompressionMixin:
                 (parent["archived"] or 0) if continuation else 0,
                 (parent["auto_archived"] or 0) if continuation else 0),
         )
+        if continuation and carried.get('_agent_cli'):
+            conn.execute('UPDATE sessions SET hidden=(SELECT hidden FROM sessions WHERE id=?) WHERE id=?',
+                         (parent_session_id, child_session_id))
 
     def publish_compression_child(
         self, *, parent_session_id: str, child_session_id: str, source: str,
diff --git a/tests/hermes_state/test_agent_cli_compression.py b/tests/hermes_state/test_agent_cli_compression.py
new file mode 100644
index 0000000000..017982a289
--- /dev/null
+++ b/tests/hermes_state/test_agent_cli_compression.py
@@ -0,0 +1,36 @@
+"""Proof-chat visibility and retirement survive real compression publication."""
+import json
+import time
+
+import pytest
+
+from hermes_state import SessionDB
+
+
+@pytest.mark.parametrize('state', ['ended', 'done', 'idle', 'active'])
+@pytest.mark.parametrize('hidden', [True, False])
+def test_compressed_agent_cli_keeps_visibility_and_retires(tmp_path, state, hidden):
+    db = SessionDB(tmp_path / 'state.db')
+    try:
+        db.create_session('parent', 'cli', model_config={'_agent_cli': True})
+        db.set_session_hidden('parent', hidden)
+        db.publish_compression_child(
+            parent_session_id='parent', child_session_id='child', source='cli',
+            messages=[{'role': 'user', 'content': 'proof'}],
+            require_compression_lease=False)
+        child = db.get_session('child')
+        assert bool(child['hidden']) is hidden
+        assert json.loads(child['model_config'])['_agent_cli'] is True
+        if state == 'ended':
+            db.end_session('child', 'done')
+        elif state == 'done':
+            db._write_sql('UPDATE sessions SET outcome_json=? WHERE id=?', ('{"kind":"done"}', 'child'))
+        elif state == 'idle':
+            then = time.time() - 90000
+            db._write_sql('UPDATE sessions SET started_at=?, last_activity_at=?', (then, then))
+            db._write_sql('UPDATE messages SET timestamp=?', (then,))
+        db.maybe_archive_empty_drafts()
+        for sid in ('parent', 'child'):
+            assert bool(db.get_session(sid)['archived']) is (hidden and state != 'active')
+    finally:
+        db.close()
