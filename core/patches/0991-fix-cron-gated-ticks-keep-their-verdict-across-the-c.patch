From 86cb56bb80a5c77c3a71af0ccda9d1e147395dfa Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 19:24:46 +0000
Subject: [PATCH] fix(cron): gated ticks keep their verdict across the
 canonical owner; port fork cron tests [daveey]

Upstream runs every agent cron job inside the canonical gateway owner (cdbe8c35adf); run-side
flags reach the scheduler's bookkeeping only through RUN_JOB_FLAGS. The fork's _agent_skipped
(wake gate / unchanged monitor) was not in it, so a silent tick between failing wakes reset
failure_streak and the alert-once marker again. Added to RUN_JOB_FLAGS.

Fork cron tests that called run_job directly now run through upstream's cron_owner seam (or bind
the owner execution when they stub the session DB); the alert-once test counts delivery-queue
enqueues as upstream's own preflight test does, and the unpinned case passes model=None now that
upstream's shared _job pins test-model.
---
 gateway/session_cron.py                     |  4 ++-
 tests/cron/test_class_routing.py            |  4 +++
 tests/cron/test_cron_finalize_slow_write.py | 32 +++++++++++++++++++--
 tests/cron/test_managed_entry.py            |  5 ++++
 tests/cron/test_preflight_managed_pin.py    | 16 ++++++++---
 tests/cron/test_silent_tick_keeps_streak.py |  4 +++
 6 files changed, 57 insertions(+), 8 deletions(-)

diff --git a/gateway/session_cron.py b/gateway/session_cron.py
index 46f174a923b..8c1fee54d51 100644
--- a/gateway/session_cron.py
+++ b/gateway/session_cron.py
@@ -155,7 +155,9 @@ CRON_SESSION_READ_ONLY_SURFACE = {'layer': 'gateway', 'code': 'cron_session_read
 # Run-side verdicts run_job stamps on the job dict for the firing scheduler's bookkeeping tail
 # (cron/quota_hold.py parks past a closed usage window; cron/unreachable_retry.py re-runs a
 # never-reached model). They cross the authority boundary inside the cron result.
-RUN_JOB_FLAGS = ('_model_unreachable', '_quota_hold_seconds')
+# [daveey] ``_agent_skipped``: a wake gate or unchanged monitor suppressed the agent, so the tick
+# keeps the job's last real verdict (failure streak, alert-once marker) instead of resetting it.
+RUN_JOB_FLAGS = ('_model_unreachable', '_quota_hold_seconds', '_agent_skipped')
 
 
 async def operation(authority, name, params, actor=None):
