From a57d545f88616041ee6fb0ec46108e83c88817f0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 17:11:46 -0800
Subject: [PATCH] fix(doctor): mask numeric values of secret-named flags

Review follow-up: the number exemption (for counts like --max-tokens 4096)
also let --webhook-secret 12345678901234567890 through. Numbers stay visible
only after flags that are not secret-named; count flags are already public.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_state_argv_secrets.py            | 4 +++-
 tests/hermes_state/test_argv_secrets.py | 5 +++++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/hermes_state_argv_secrets.py b/hermes_state_argv_secrets.py
index 969cd28ba82..dc82511610b 100644
--- a/hermes_state_argv_secrets.py
+++ b/hermes_state_argv_secrets.py
@@ -61,8 +61,10 @@ def _looks_like_path(value: str) -> bool:
 
 
 def _mask_value(value: str, *, secret_named: bool) -> str:
-    if not value or _looks_like_path(value) or _NUMBER.match(value):
+    if not value or _looks_like_path(value):
         return value
+    if _NUMBER.match(value) and not secret_named:
+        return value  # a count or id; after a secret-named flag a number is the secret (PINs, numeric keys)
     return MASK if secret_named or _looks_like_bare_secret(value) else value
 
 
diff --git a/tests/hermes_state/test_argv_secrets.py b/tests/hermes_state/test_argv_secrets.py
index 390945693f3..3c67198453f 100644
--- a/tests/hermes_state/test_argv_secrets.py
+++ b/tests/hermes_state/test_argv_secrets.py
@@ -28,6 +28,11 @@ KEY = "q8ZpL2vXk9RtYwB4mN7cQ1sD5fH3jK6g"
             ["--aws-secret-access-key", MASK],
         ),
         (["--webhook-secret=Zm9vYmFyYmF6/cXV4cXV1eA=="], [f"--webhook-secret={MASK}"]),
+        # a numeric value after a secret-named flag is the secret
+        (
+            ["--webhook-secret", "12345678901234567890", "--signing-key=4242424242"],
+            ["--webhook-secret", MASK, f"--signing-key={MASK}"],
+        ),
         # a lowercase prefixed random token is not a Hermes id
         (["abc-9f8e7d6c5b4a39281706f5e4z"], [MASK]),
         # a bare token as a --flag=value value
-- 
