---
diff --git a/hermes_cli/sessions_early_boot.py b/hermes_cli/sessions_early_boot.py
index 4bdf497b0ee..c315d0e8951 100644
--- a/hermes_cli/sessions_early_boot.py
+++ b/hermes_cli/sessions_early_boot.py
@@ -47,8 +47,10 @@
     previous = {}
 
     def stop(signum, frame):
-        owner.close()
         handler = previous[signum]
+        if handler == signal.SIG_IGN:
+            return
+        owner.close()
         if callable(handler):
             handler(signum, frame)
         elif handler != signal.SIG_IGN:
diff --git a/hermes_cli/web_boot_services.py b/hermes_cli/web_boot_services.py
index 4e29a5e0212..5581a13273a 100644
--- a/hermes_cli/web_boot_services.py
+++ b/hermes_cli/web_boot_services.py
@@ -17,6 +17,8 @@
             ready = getattr(scope['app'].state, 'boot_services_ready', None)
             if ready is not None and not ready.is_set():
                 if scope['type'] == 'websocket':
+                    await receive()  # consume websocket.connect before a retryable close
+                    await send({'type': 'websocket.accept'})
                     await send({'type': 'websocket.close', 'code': 1013})
                     return
                 if scope['method'] != 'GET' or scope['path'] not in _DISPLAY_PATHS:
diff --git a/hermes_cli/web_server.py b/hermes_cli/web_server.py
index ecfe9df06e9..30e4292f7fa 100644
--- a/hermes_cli/web_server.py
+++ b/hermes_cli/web_server.py
@@ -1818,25 +1818,27 @@
             await server.startup()
             if server.should_exit:
                 return
-            app.state.http_listener_ready.set()
-
-            _on_server_started(
-                server,
-                host=host,
-                port=port,
-                headless=headless,
-                isolated=isolated,
-                open_browser=open_browser,
-                initial_profile=initial_profile,
-                start_mcp_discovery_after_bind=start_mcp_discovery_after_bind,
-                ssh_lock_path=ssh_lock_path,
-            )
-            if headless:
-                from hermes_cli.observability.shared_metrics_startup import record_process_ready
-                record_process_ready("serve_boot", background=True)
-
-            await server.main_loop()
-            if server.started:
-                await server.shutdown()
+            try:
+                app.state.http_listener_ready.set()
+                _on_server_started(
+                    server,
+                    host=host,
+                    port=port,
+                    headless=headless,
+                    isolated=isolated,
+                    open_browser=open_browser,
+                    initial_profile=initial_profile,
+                    start_mcp_discovery_after_bind=start_mcp_discovery_after_bind,
+                    ssh_lock_path=ssh_lock_path,
+                )
+                if headless:
+                    from hermes_cli.observability.shared_metrics_startup import record_process_ready
+                    record_process_ready("serve_boot", background=True)
+                await server.main_loop()
+            finally:
+                # Drain the app before asyncio.run cancels its background warmup
+                # on an exceptional loop/ready callback exit.
+                if server.started:
+                    await server.shutdown()
 
     _run_serve(_serve, config, host, port)
diff --git a/tests/hermes_cli/test_sessions_early_boot.py b/tests/hermes_cli/test_sessions_early_boot.py
index ced243488ca..897f2226124 100644
--- a/tests/hermes_cli/test_sessions_early_boot.py
+++ b/tests/hermes_cli/test_sessions_early_boot.py
@@ -81,6 +81,19 @@
     assert not calls
 
 
+def test_ignored_signal_keeps_owner_adoptable(boot):
+    calls, runtime = boot
+    original = signal.signal(signal.SIGINT, signal.SIG_IGN)
+    try:
+        with early.early_sessions(headless=True, isolated=False) as owner:
+            signal.getsignal(signal.SIGINT)(signal.SIGINT, None)
+            assert 'close' not in calls
+            assert owner.adopt() is runtime
+        assert calls.count('close') == 1
+    finally:
+        signal.signal(signal.SIGINT, original)
+
+
 def test_failed_drain_retains_owner():
     calls = []
     def close():
