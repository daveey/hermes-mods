From 4b82a74b17a17038fea23459d2f64a4f7779b35f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 22:20:44 +0000
Subject: [PATCH] [daveey] Narrow backup parsing failures to IO and YAML errors

---
 hermes_cli/config_backups.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/config_backups.py b/hermes_cli/config_backups.py
index dfa9cbadaeb..793a2a1d4ad 100644
--- a/hermes_cli/config_backups.py
+++ b/hermes_cli/config_backups.py
@@ -85,13 +85,14 @@ def _last_full_good_backup(candidates: list[Path]) -> Optional[Path]:
     automatic recovery selection. Newest wins ties; normal rotation resumes when
     the document regains at least half the anchor's sections.
     """
+    from hermes_yaml import YAMLError
     from utils import fast_safe_load
 
     counts = []
     for path in candidates:
         try:
             doc = fast_safe_load(path.read_text(encoding="utf-8-sig"))
-        except Exception:
+        except (OSError, UnicodeError, YAMLError):
             counts.append(0)
         else:
             counts.append(len(doc) if isinstance(doc, dict) else 0)
-- 
