From fccc5aabd1db8fb4016e370f2f4f9e7a5230cfa1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:36:10 +0000
Subject: [PATCH] fix(cron): bound repeated arithmetic word walks [daveey]

The existing fd-redirection clean control exposed a normalized payload revisiting itself under sticky context. Omit unchanged text already scanned at this level. Retain a cheap declaration-hint prefilter and short-circuit sticky hints; the large inert heredoc performance control and fd-redirection consumers pass.
---
 cron/lifecycle_guard_arith_words.py | 4 +++-
 cron/lifecycle_guard_output.py      | 2 +-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/cron/lifecycle_guard_arith_words.py b/cron/lifecycle_guard_arith_words.py
index fcc2fdfe55f79c4e16160e417c429aa199cd0eb9..7960f78500967c3dd8b637991c15178c5ba9ce4a 100644
--- a/cron/lifecycle_guard_arith_words.py
+++ b/cron/lifecycle_guard_arith_words.py
@@ -154,6 +154,8 @@ def may_set_integer_attributes(command: str) -> bool:
     """Conservative attribute hint, including declarations without a substitution."""
     from cron import lifecycle_guard as guard
 
+    if not any(hint in command for hint in (*_INTEGER_DECLARERS, "source", ".", "$", "`")):
+        return False
     for segment in guard._iter_command_segments(command):
         if _INTEGER_DECLARATION_RE.search(" ".join(segment)):
             return True
@@ -205,6 +207,6 @@ def iter_arithmetic_word_payloads(command: str, *, integer_context: bool = False
             if "[" not in operand or not any(o in operand for o in _SUBSTITUTION_OPENERS):
                 continue
             payload = _BACKTICK_SPAN_RE.sub(r"$(\1)", operand)
-            if payload not in seen:
+            if payload != command and payload not in seen:
                 seen.add(payload)
                 yield payload
diff --git a/cron/lifecycle_guard_output.py b/cron/lifecycle_guard_output.py
index 82e629a6915b6e859c990710708ae871d57e97a5..7aa0ec55ce44a1badbf1912ac79589207c17554c 100644
--- a/cron/lifecycle_guard_output.py
+++ b/cron/lifecycle_guard_output.py
@@ -24,7 +24,7 @@ def quote_scope(cwd, executed, budget) -> tuple:
 def iter_recursive_payloads(command, nested_texts, *, cwd, executed, budget, covered_scope):
     from cron import lifecycle_guard as guard
 
-    budget.integer_context |= may_set_integer_attributes(command)
+    budget.integer_context = budget.integer_context or may_set_integer_attributes(command)
     for payload in nested_texts:
         yield payload, True, None
     for payload in guard._iter_shell_command_payloads(command):
-- 
