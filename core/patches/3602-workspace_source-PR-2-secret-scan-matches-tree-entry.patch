From b6836c3022dcf144e1f33519ef9e65eb034a1ef1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 13:54:23 +0000
Subject: [PATCH] workspace_source PR-2: secret scan matches tree entry names
 only; PII patterns only on text blobs

Review 5892051198: raw tree bytes interleave 20-byte binary shas, which form false
E.164 phone matches with the next entry's mode (326/1340 real trees). Trees are now
matched by their new entry names only (the fixed '<mode> <name>\0<sha>' format leaves
no other place for data); commits, tags and blobs still go to the matcher as whole raw
bytes. Binary blobs get the high-signal patterns (PEM/key markers, provider tokens,
credential assignments) but not the PII-style phone pattern.
---
 hermes_cli/kanban_source_publish.py           | 38 +++++++++---
 .../hermes_cli/test_kanban_source_publish.py  | 60 +++++++++++++++++++
 2 files changed, 89 insertions(+), 9 deletions(-)

diff --git a/hermes_cli/kanban_source_publish.py b/hermes_cli/kanban_source_publish.py
index 0a62ba5f5d..bc0f2494ae 100644
--- a/hermes_cli/kanban_source_publish.py
+++ b/hermes_cli/kanban_source_publish.py
@@ -162,10 +162,19 @@ def prove_origin(path: str, cfg: Settings, *, lookup: Optional[Callable[[str], d
 
 # --- step 4: secret scan ----------------------------------------------------------------------------------------
 
-def _secret_in(text: str) -> bool:
-    from agent.redact import redact_sensitive_text
+def _secret_in(text: str, *, pii: bool = True) -> bool:
+    """Whether the redactor masks anything in ``text``. ``pii=False`` ignores the PII-style pass (E.164 phone
+    numbers): binary bytes form those by chance, while the high-signal patterns (keys, provider tokens, credential
+    assignments) stay on. The phone pass runs last over the other passes' output, so when the full result equals
+    the phone pass alone applied to the input, no other pattern matched."""
+    from agent.redact import _SIGNAL_PHONE_RE, _redact_phone, redact_sensitive_text
+    if not text.strip():
+        return False
     # force: the publish gate never honours ``security.redact_secrets: false`` (that only governs display).
-    return bool(text.strip()) and redact_sensitive_text(text, force=True) != text
+    masked = redact_sensitive_text(text, force=True)
+    if masked == text:
+        return False
+    return pii or masked != _SIGNAL_PHONE_RE.sub(_redact_phone, text)
 
 
 def _denylisted(rel: str) -> bool:
@@ -254,9 +263,10 @@ def _blob_secret_line(blob: bytes) -> Optional[int]:
     if _KEY_MARKER_BYTES.search(blob):
         return 0
     text = _decode(blob)
-    if text is None:  # binary: the PEM marker above, plus every printable run (like ``strings``)
+    if text is None:  # binary: the PEM marker above, plus the high-signal patterns over every printable run
         runs = [m.group(0).decode("ascii") for m in _PRINTABLE_RUN.finditer(blob)]
-        return 0 if any(_secret_in(r) for r in runs) or _secret_in("\n".join(runs)) else None
+        found = any(_secret_in(r, pii=False) for r in runs) or _secret_in("\n".join(runs), pii=False)
+        return 0 if found else None
     if _KEY_MARKER.search(text):
         return 0
     for no, line in enumerate(text.splitlines(), 1):
@@ -282,8 +292,9 @@ def _name_text(name: bytes) -> str:
 
 def secret_scan(deadline: _Deadline, path: str, base: str, head: str) -> None:
     """Scan exactly the objects a push of ``head`` over ``base`` can send (``rev-list --objects head --not base``
-    with replace refs and grafts off): every new commit's headers and message, every new tree's entry names, every
-    new blob's raw bytes. ``head`` is the sha that is then pushed, never a ref name re-resolved later."""
+    with replace refs and grafts off). Commits, tags and blobs: the entire raw bytes go to the matcher, unparsed.
+    Trees: only the entry names (the fixed ``<mode> <name>\\0<20-byte sha>`` format leaves no other place for data,
+    and raw sha bytes false-match). ``head`` is the sha that is then pushed, never a ref name re-resolved later."""
     listed = _isolated(deadline, path, "rev-list", "--objects", "--no-object-names", head, "--not", base,
                        cap=120.0).decode("ascii").split()
     kinds = _cat_batch(deadline, path, listed, check_only=True)
@@ -300,8 +311,10 @@ def secret_scan(deadline: _Deadline, path: str, base: str, head: str) -> None:
         if name:
             old.add((name, meta.split()[2].decode("ascii")))
     where: dict[str, str] = {}
+    walked: set[str] = set()
 
     def walk(tree: str, prefix: bytes) -> None:
+        walked.add(tree)
         for mode, name, sha in _tree_entries(objects[tree][1]):
             full = prefix + name
             if (full, sha) in old:
@@ -322,9 +335,16 @@ def secret_scan(deadline: _Deadline, path: str, base: str, head: str) -> None:
         tree = objects[sha][1].split(b"\n", 1)[0].removeprefix(b"tree ").decode("ascii")
         if tree in new:
             walk(tree, b"")
-    # No object format is parsed for the credential match: the ENTIRE raw bytes of every new object (a commit with
-    # all its headers, signatures and message; a tag; a tree; a blob) go to the matcher (review 5891362210).
+    # No commit, tag or blob format is parsed for the credential match: their ENTIRE raw bytes (a commit with all
+    # its headers, signatures and message) go to the matcher (review 5891362210). A tree's content is its entry
+    # names, matched in walk() per new entry; its raw bytes interleave binary shas, which false-match (review
+    # 5892051198). A new tree no new commit reaches has every entry name matched here.
     for sha, (kind, data) in objects.items():
+        if kind == "tree":
+            if sha not in walked and any(_secret_in(_name_text(n)) or _KEY_MARKER_BYTES.search(n)
+                                         for _, n, _ in _tree_entries(data)):
+                raise PublishRefused("secret_scan_refused", f"tree {sha[:12]} has a credential in a path name")
+            continue
         if (line := _blob_secret_line(data)) is not None:
             label = where.get(sha, f"blob {sha[:12]}") if kind == "blob" else f"{kind} {sha[:12]}"
             raise PublishRefused("secret_scan_refused", f"{label}{f':{line}' if line else ''} adds a credential")
diff --git a/tests/hermes_cli/test_kanban_source_publish.py b/tests/hermes_cli/test_kanban_source_publish.py
index a364fdee62..1f143ce7e8 100644
--- a/tests/hermes_cli/test_kanban_source_publish.py
+++ b/tests/hermes_cli/test_kanban_source_publish.py
@@ -292,6 +292,66 @@ def test_key_inside_binary_blob_is_scanned(card):
     _refused(card, "secret_scan_refused")
 
 
+def test_provider_token_inside_binary_blob_is_scanned(card):
+    (card.path / "blob.bin").write_bytes(b"\x00\x01\xff\xfe" * 64 + f"token={SECRET}".encode() + b"\x00\x9f" * 32)
+    git(card.path, "add", "blob.bin")
+    git(card.path, "commit", "-q", "-m", "bin")
+    _refused(card, "secret_scan_refused")
+
+
+def _blob_sha_tail_plus_digit(prefix: bytes) -> bytes:
+    """Content whose blob sha ends in ``+<digit>``: in the raw tree the next entry's ``100644`` mode follows those
+    bytes, so ``+<digit>100644`` reads as an E.164 phone number (review 5892051198)."""
+    import hashlib
+    for i in range(1_000_000):
+        body = prefix + f"# {i}\n".encode()
+        tail = hashlib.sha1(b"blob %d\0" % len(body) + body).digest()[-2:]
+        if tail[:1] == b"+" and tail[1:] in b"123456789":
+            return body
+    raise AssertionError("no candidate")
+
+
+def test_tree_sha_bytes_never_false_match(card):
+    """A benign new file whose blob sha forms a phone-shaped run with the next tree entry's mode is published:
+    trees are matched by entry name only, never by their raw (binary sha) bytes."""
+    (card.path / "zz_probe_a.py").write_bytes(_blob_sha_tail_plus_digit(b"print('benign')\n"))
+    (card.path / "zz_probe_b.py").write_text("x = 1\n")
+    git(card.path, "add", "zz_probe_a.py", "zz_probe_b.py")
+    git(card.path, "commit", "-q", "-m", "benign files")
+    tree = subprocess.run(["git", "-C", str(card.path), "cat-file", "tree", "HEAD"], capture_output=True,
+                          check=True).stdout
+    from agent.redact import _SIGNAL_PHONE_RE
+    assert _SIGNAL_PHONE_RE.search(tree.decode("latin-1"))  # the fixture really has the shape
+    head = git(card.path, "rev-parse", "HEAD")
+    assert card.receipt()["state"] == "published" and card.remote() == head
+
+
+def test_secret_in_tree_entry_name_refused(card):
+    commit(card.path, f"conf/{SECRET}.txt", "plain\n")
+    _refused(card, "secret_scan_refused")
+
+
+def test_random_binary_blob_passes(card):
+    import random
+    data = random.Random(7).randbytes(256 * 1024)
+    (card.path / "noise.bin").write_bytes(b"\x00" + data)
+    git(card.path, "add", "noise.bin")
+    git(card.path, "commit", "-q", "-m", "noise")
+    head = git(card.path, "rev-parse", "HEAD")
+    assert card.receipt()["state"] == "published" and card.remote() == head
+
+
+def test_phone_shaped_bytes_in_binary_blob_pass_but_text_phone_refused(card):
+    """PII-style patterns apply to text only; binary blobs get the high-signal patterns."""
+    (card.path / "img.bin").write_bytes(b"\x00\x89PNG\xff" + b"+15551234567 " + b"\x00\xfe" * 16)
+    git(card.path, "add", "img.bin")
+    git(card.path, "commit", "-q", "-m", "image")
+    head = git(card.path, "rev-parse", "HEAD")
+    assert card.receipt()["state"] == "published" and card.remote() == head
+    assert pub._secret_in("call +15551234567 now") and not pub._secret_in("call +15551234567 now", pii=False)
+    assert pub._secret_in(f"a +15551234567 b {SECRET}", pii=False)
+
+
 def test_global_config_cannot_reshape_the_scan_or_push(card, world, monkeypatch):
     """The scan and the push ignore global config (attributes file, hooks path); a global pre-push hook never runs."""
     hooks = world.tmp / "global-hooks"
