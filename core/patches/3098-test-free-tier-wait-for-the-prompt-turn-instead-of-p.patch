From 9286b1cd1dc5f8846ed9468a2e2f1b7ccb9c7552 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 02:05:00 +0000
Subject: [PATCH] test(free-tier): wait for the prompt turn instead of patching
 threading.Thread [daveey]

test_prompt_submit_records_only_untouched_turns made prompt.submit's turn run
inline by replacing threading.Thread with a fake that calls the target in start().
That only covers threads built by looking up threading.Thread at call time. A
threading.Thread subclass bound at import (PR #1806's TrackedThread, which
spawn_context_thread returns inside an active work scope) stays a real thread
once its module was imported by an earlier test in the file: the turn then ran
after the test had asserted and dropped the session, so all three cases failed
whenever the whole file ran, and passed on the retry of just these three ids
(the import then happened while the fake was installed). Reproduced on
b07a0bd43d: full file 3 failed, the three ids alone 3 passed.

Let the turn run on its real worker threads and wait (tests.waiting.wait_until,
60 s cap) for every expected message.complete and a settled session, then join
the last turn thread before unregistering the session. The record-before-
message.complete assertions are unchanged.

Verified: full file passes on main and on b07a0bd43d; 24/24 runs each under a
SIGSTOP/SIGCONT duty cycle (80 ms stopped / 20 ms running, 12 in parallel).
---
 tests/tui_gateway/test_free_tier_task_done.py | 15 ++++++---------
 1 file changed, 6 insertions(+), 9 deletions(-)

diff --git a/tests/tui_gateway/test_free_tier_task_done.py b/tests/tui_gateway/test_free_tier_task_done.py
index 36b2961c43..f3d1c6360b 100644
--- a/tests/tui_gateway/test_free_tier_task_done.py
+++ b/tests/tui_gateway/test_free_tier_task_done.py
@@ -11,6 +11,7 @@ import pytest
 from tui_gateway import server
 from hermes_cli import anon_auth, free_tier_offer
 from tui_gateway.free_tier_task_done import note_task_done
+from tests.waiting import wait_until
 
 CLEAN = {"completed": True, "final_response": "Here is your plan.", "user_intervened": False}
 
@@ -73,14 +74,6 @@ def test_a_correction_rpc_during_the_task_disqualifies_it(method, params):
     assert not _recorded()
 
 
-class _ImmediateThread:
-    def __init__(self, target=None, daemon=None, **kw):
-        self._target = target
-
-    def start(self):
-        self._target()
-
-
 @pytest.mark.parametrize("touch,recorded_turns,records_at_each_complete", [
     (None, [1], [1]), ("steer", [], [0]), ("typed", [2], [0, 1]),
 ], ids=["untouched", "steered-over-rpc", "typed-while-busy"])
@@ -124,7 +117,6 @@ def test_prompt_submit_records_only_untouched_turns(monkeypatch, touch, recorded
     monkeypatch.setattr(server, "make_stream_renderer", lambda cols: None)
     monkeypatch.setattr(server, "render_message", lambda raw, cols: None)
     monkeypatch.setattr(server, "_sync_session_key_after_compress", lambda *a, **kw: None)
-    monkeypatch.setattr(server.threading, "Thread", _ImmediateThread)
     monkeypatch.setattr(server, "_load_busy_input_mode", lambda: "queue")
     session = _session(agent=_Agent(), running=False, history_version=0, image_counter=0, cols=80,
                        slash_worker=None, show_reasoning=False, tool_progress_mode="all", pending_title=None)
@@ -133,6 +125,11 @@ def test_prompt_submit_records_only_untouched_turns(monkeypatch, touch, recorded
         resp = server.handle_request({"id": "1", "method": "prompt.submit",
                                       "params": {"session_id": "sid", "text": "Plan my week"}})
         assert "result" in resp, resp
+        # The turn (and a queued follow-up) runs on worker threads; the session stays registered until the
+        # last turn has settled. Patching threading.Thread to run inline missed thread classes bound at import.
+        wait_until(lambda: len(recorded_at_complete) >= len(records_at_each_complete) and not session["running"],
+                   timeout=60, what="every turn's message.complete and a settled session")
+        session["_run_thread"].join(timeout=60)  # its post-turn housekeeping, before the session goes away
     finally:
         server._sessions.pop("sid", None)
     assert recorded == recorded_turns
