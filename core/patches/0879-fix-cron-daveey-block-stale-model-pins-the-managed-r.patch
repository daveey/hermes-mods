diff --git a/tests/cron/test_preflight_managed_pin.py b/tests/cron/test_preflight_managed_pin.py
new file mode 100644
index 0000000000000000000000000000000000000000..da74bdd4d53611719cdfad6b6e19a4023ae121f7
--- /dev/null
+++ b/tests/cron/test_preflight_managed_pin.py
@@ -0,0 +1,122 @@
+"""Cron preflight refuses a pin the managed routing registry rejects. [daveey]
+
+On the mini (``model_routing.enforce_subscription_only: true``) the ``imsg-spam-classifier`` job
+was pinned to ``claude-sonnet-5``, which the registry no longer lists (only ``claude-sonnet-5-5``).
+Every woken run died before the model with "Managed subscription policy rejects unregistered or
+ambiguous concrete pin": the provider-key preflight swallowed the ManagedPinRejectedError as a
+non-auth error and failed open, so the job errored on every wake instead of showing
+``blocked_config`` once. Entry path: ``run_job`` against a temp config.yaml (the
+test_preflight_config harness), plus ``run_one_job`` for the alert-once bookkeeping.
+"""
+import sys
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parent.parent.parent))
+
+import cron.jobs as cron_jobs
+import cron.scheduler as sched
+from tests.cron.test_preflight_config import _job, _run_job_patched
+
+
+def managed_yaml(enforce=True):
+    lines = ["model_routing:", "  enabled: true", "  policy_version: 1", "  allow_metered: false",
+             f"  enforce_subscription_only: {'true' if enforce else 'false'}", "  routes:"]
+    for level, provider, model in (("deep", "anthropic", "claude-opus-5-5"),
+                                   ("standard", "anthropic", "claude-sonnet-5-5"),
+                                   ("standard", "openai-codex", "gpt-6.1-sol")):
+        if f"    {level}:" not in lines:
+            lines.append(f"    {level}:")
+        lines += [f"      - provider: {provider}", f"        model: {model}", "        billing: subscription",
+                  "        weight: 1", "        eligible: true", "        funding_verified: true",
+                  "        capabilities: {tools: true, streaming: true}"]
+    return "\n".join(lines) + "\n"
+
+
+def _write_config(home, enforce=True):
+    (home / "config.yaml").write_text(
+        "model:\n  default: claude-opus-5-5\n  provider: anthropic\n" + managed_yaml(enforce), encoding="utf-8")
+
+
+def _run(tmp_path, **job_overrides):
+    job = _job(**job_overrides)
+    with cron_jobs.use_cron_store(tmp_path):
+        cron_jobs.save_jobs([job])
+        return _run_job_patched(job, tmp_path)
+
+
+@pytest.mark.parametrize("provider", [None, "anthropic"])
+def test_unregistered_pin_is_blocked_config_naming_allowed_pins(tmp_path, provider):
+    _write_config(tmp_path)
+    success, output, _final, error, agent_constructed = _run(
+        tmp_path, model="claude-sonnet-5", provider=provider)
+    assert agent_constructed is False
+    assert success is False
+    assert "[blocked_config]" in (error or "")
+    assert "'claude-sonnet-5'" in error
+    # Names what the job CAN pin, so the alert is actionable.
+    assert "claude-sonnet-5-5" in error and "claude-opus-5-5" in error
+    assert "hermes cron edit pf-test --model" in error
+    assert "BLOCKED" in output
+
+
+def test_registered_pin_runs(tmp_path):
+    _write_config(tmp_path)
+    success, _output, _final, error, agent_constructed = _run(
+        tmp_path, model="claude-sonnet-5-5", provider="anthropic")
+    assert "[blocked_config]" not in (error or "")
+    assert agent_constructed is True
+    assert success is True, error
+
+
+def test_policy_off_does_not_block(tmp_path):
+    _write_config(tmp_path, enforce=False)
+    success, _output, _final, error, agent_constructed = _run(tmp_path, model="claude-sonnet-5")
+    assert "[blocked_config]" not in (error or "")
+    assert agent_constructed is True
+    assert success is True, error
+
+
+def test_unpinned_job_on_rejected_cron_model_is_blocked(tmp_path):
+    """The fleet default ``cron.model`` is a stored pin too."""
+    (tmp_path / "config.yaml").write_text(
+        "model:\n  default: claude-opus-5-5\n  provider: anthropic\ncron:\n  model: claude-sonnet-5\n"
+        + managed_yaml(), encoding="utf-8")
+    success, _output, _final, error, agent_constructed = _run(tmp_path)
+    assert agent_constructed is False and success is False
+    assert "[blocked_config]" in (error or "") and "cron.model" in error
+
+
+def test_rejected_pin_alerts_once_across_woken_runs(tmp_path):
+    """Two woken runs of the stale-pin job deliver ONE alert and persist blocked_config."""
+    _write_config(tmp_path)
+    job = _job(model="claude-sonnet-5")
+    deliveries = []
+
+    def fake_deliver(job, content, adapters=None, loop=None, **kwargs):
+        deliveries.append(content)
+
+    with cron_jobs.use_cron_store(tmp_path):
+        cron_jobs.save_jobs([job])
+        for _tick in range(2):
+            fresh = next(j for j in cron_jobs.load_jobs() if j["id"] == job["id"])
+            with patch("cron.scheduler._hermes_home", tmp_path), \
+                 patch("cron.scheduler_delivery._resolve_origin", return_value=None), \
+                 patch("hermes_cli.env_loader.load_hermes_dotenv"), \
+                 patch("hermes_cli.env_loader.reset_secret_source_cache"), \
+                 patch("hermes_state_registry.acquire", return_value=MagicMock()), \
+                 patch("tools.mcp_tool_discovery.discover_mcp_tools", return_value=[]), \
+                 patch("hermes_cli.runtime_provider.resolve_runtime_provider",
+                       return_value={"api_key": "k", "base_url": "https://example.invalid/v1",
+                                     "provider": "anthropic", "api_mode": "chat_completions"}), \
+                 patch.object(sched, "_deliver_result", side_effect=fake_deliver), \
+                 patch("run_agent.AIAgent") as mock_agent_cls:
+                assert sched.run_one_job(fresh) is True
+                assert mock_agent_cls.called is False
+        stored = next(j for j in cron_jobs.load_jobs() if j["id"] == job["id"])
+
+    assert stored["last_status"] == "blocked_config"
+    assert len(deliveries) == 1, deliveries
+    assert "claude-sonnet-5-5" in deliveries[0]
diff --git a/tests/cron/test_silent_tick_keeps_streak.py b/tests/cron/test_silent_tick_keeps_streak.py
new file mode 100644
index 0000000000000000000000000000000000000000..70e239d65c76503e40c522d6fab746e598c47300
--- /dev/null
+++ b/tests/cron/test_silent_tick_keeps_streak.py
@@ -0,0 +1,77 @@
+"""A tick whose gate suppressed the agent is not a healthy agent run. [daveey]
+
+The mini's ``imsg-spam-classifier`` failed every woken run for a day, yet showed
+``last_status=ok``: the silent once-a-minute ticks between wakes (wake-gate script printing
+``{"wakeAgent": false}``, or an unchanged monitor) went through ``mark_job_run(success=True)``,
+which reset ``failure_streak`` to 0 and cleared ``preflight_alerted``. So a 100% agent failure
+read as "1 failure, recovered", repeatedly, and an alert-once blocked_config alert re-fired on
+every wake. Entry path: ``run_one_job`` for both gates, with a real job store.
+"""
+import sys
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parent.parent.parent))
+
+import cron.jobs as cron_jobs
+import cron.scheduler as sched
+from cron.monitor import MonitorOutcome
+from tests.cron.test_preflight_config import _job
+
+
+def _tick(tmp_path, job_id, *, gate):
+    fresh = next(j for j in cron_jobs.load_jobs() if j["id"] == job_id)
+    extra = []
+    if gate == "wake_gate":
+        extra.append(patch.object(sched, "_run_job_script_with_claim_heartbeat",
+                                  return_value=(True, '{"wakeAgent": false}')))
+    else:
+        extra.append(patch("cron.monitor.check_monitor", return_value=MonitorOutcome(ok=True, changed=False)))
+    from contextlib import ExitStack
+    with ExitStack() as stack:
+        for p in [patch("cron.scheduler._hermes_home", tmp_path),
+                  patch("cron.scheduler_delivery._resolve_origin", return_value=None),
+                  patch("hermes_cli.env_loader.load_hermes_dotenv"),
+                  patch("hermes_cli.env_loader.reset_secret_source_cache"),
+                  patch("hermes_state_registry.acquire", return_value=MagicMock()),
+                  patch.object(sched, "_deliver_result"), *extra]:
+            stack.enter_context(p)
+        agent_cls = stack.enter_context(patch("run_agent.AIAgent"))
+        assert sched.run_one_job(fresh) is True
+        assert agent_cls.called is False
+
+
+@pytest.mark.parametrize("gate", ["wake_gate", "monitor_no_change"])
+def test_silent_tick_keeps_failure_streak_and_alert_marker(tmp_path, gate):
+    overrides = {"script": "gate.py"} if gate == "wake_gate" else {"monitor_script": "mon.py"}
+    job = _job(**overrides)
+    with cron_jobs.use_cron_store(tmp_path):
+        cron_jobs.save_jobs([job])
+        assert cron_jobs.mark_job_run(job["id"], False, "[blocked_config] stale pin", status="blocked_config")
+        cron_jobs.mark_preflight_alerted(job["id"])
+        _tick(tmp_path, job["id"], gate=gate)
+        stored = cron_jobs.get_job(job["id"])
+        assert stored["failure_streak"] == 1
+        assert stored["last_status"] == "blocked_config"
+        assert stored["last_error"] == "[blocked_config] stale pin"
+        assert stored.get("preflight_alerted")
+        # The tick still counts as a fire for scheduling.
+        assert stored["last_run_at"]
+        # A real healthy run afterwards still resets everything.
+        assert cron_jobs.mark_job_run(job["id"], True)
+        healed = cron_jobs.get_job(job["id"])
+        assert healed["failure_streak"] == 0 and healed["last_status"] == "ok"
+        assert not healed.get("preflight_alerted")
+
+
+def test_silent_tick_on_a_fresh_job_still_reads_ok(tmp_path):
+    """No prior run: the gate tick records ok (nothing to preserve)."""
+    job = _job(script="gate.py")
+    with cron_jobs.use_cron_store(tmp_path):
+        cron_jobs.save_jobs([job])
+        _tick(tmp_path, job["id"], gate="wake_gate")
+        stored = cron_jobs.get_job(job["id"])
+        assert stored["last_status"] == "ok"
+        assert int(stored.get("failure_streak") or 0) == 0
diff --git a/tests/hermes_cli/test_cron_managed_pin_cli.py b/tests/hermes_cli/test_cron_managed_pin_cli.py
new file mode 100644
index 0000000000000000000000000000000000000000..54cd4109d7461a472b006b875e9f6ddcc3326be3
--- /dev/null
+++ b/tests/hermes_cli/test_cron_managed_pin_cli.py
@@ -0,0 +1,96 @@
+"""``hermes cron create/edit`` refuse a pin the managed routing registry rejects; doctor lists them.
+
+Same contract as kanban's create-time check (abe20b1815): under
+``model_routing.enforce_subscription_only`` the job's pin must pass ``pin_policy`` when it is set,
+not only when the job wakes. [daveey]
+"""
+import argparse
+import sys
+from argparse import Namespace
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parent.parent.parent))
+
+from cron.jobs import create_job, get_job, list_jobs
+from hermes_cli.cron import cron_command
+from hermes_cli.subcommands.cron import build_cron_parser
+from tests.cron.test_preflight_managed_pin import managed_yaml
+
+
+@pytest.fixture()
+def managed_home(tmp_path, monkeypatch):
+    monkeypatch.setattr("cron.jobs.CRON_DIR", tmp_path / "cron")
+    monkeypatch.setattr("cron.jobs.JOBS_FILE", tmp_path / "cron" / "jobs.json")
+    monkeypatch.setattr("cron.jobs.OUTPUT_DIR", tmp_path / "cron" / "output")
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+
+    def configure(enforce=True):
+        (tmp_path / "config.yaml").write_text(
+            "model:\n  default: claude-opus-5-5\n  provider: anthropic\n" + managed_yaml(enforce),
+            encoding="utf-8")
+
+    configure()
+    return configure
+
+
+def _cli(*argv):
+    parser = argparse.ArgumentParser(prog="hermes")
