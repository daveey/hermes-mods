From b9456676b3b7f684e983b610ab150b7726ee180f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 08:05:44 +0000
Subject: [PATCH] [daveey] gateway: an explicit HERMES_LAUNCHD_LABEL names the
 launchd job whatever its prefix

Hand-written launchd plists (the mini's com.daveey.myapp.* gateway jobs) can only tell the gateway its
job through EnvironmentVariables.HERMES_LAUNCHD_LABEL: below the job's first process XPC_SERVICE_NAME is 0.
launchd_job_label() and the stderr-timestamp re-export kept only ai.hermes* labels, so the label was dropped,
the drain cap assumed 60s and these ExitTimeOut=45 jobs could be SIGKILLed mid-teardown (gateway-64b702b67e).
The ai.hermes filter stays on XPC_SERVICE_NAME; app-coalition names (application.*) are rejected in both.
---
 gateway/restart.py                           | 35 ++++++----
 hermes_cli/stderr_timestamp.py               | 18 +++--
 tests/gateway/test_launchd_explicit_label.py | 70 ++++++++++++++++++++
 3 files changed, 103 insertions(+), 20 deletions(-)
 create mode 100644 tests/gateway/test_launchd_explicit_label.py

diff --git a/gateway/restart.py b/gateway/restart.py
index de4cd952b67..87b377e8da7 100644
--- a/gateway/restart.py
+++ b/gateway/restart.py
@@ -39,6 +39,9 @@ EXTERNAL_GATEWAY_SUPERVISOR_ENV = "HERMES_GATEWAY_EXTERNAL_SUPERVISOR"
 # Forwarded by the stderr-timestamp launchd wrapper (hermes_cli/stderr_timestamp.py) to the gateway
 # grandchild, which sees ``XPC_SERVICE_NAME=0``. Read only via :func:`launchd_job_label`.
 LAUNCHD_LABEL_ENV = "HERMES_LAUNCHD_LABEL"
+# launchd's app-coalition service names (``application.<bundle>.<n>``) leak into IDE integrated terminals;
+# they never name a gateway job.
+LAUNCHD_APP_COALITION_PREFIX = "application."
 
 DEFAULT_GATEWAY_RESTART_DRAIN_TIMEOUT = float(DEFAULT_CONFIG["agent"]["restart_drain_timeout"])
 DEFAULT_GATEWAY_SIGNAL_INTERRUPT_GRACE_TIMEOUT = float(DEFAULT_CONFIG["gateway"]["signal_interrupt_grace_timeout"])
@@ -90,21 +93,27 @@ def parse_launchd_exit_timeout(print_output: object) -> float | None:
 
 
 def launchd_job_label(environ: Mapping[str, str] | None = None) -> str | None:
-    """The ``ai.hermes.*`` launchd job label in *environ*, or ``None`` (no darwin gate).
-
-    launchd stamps ``XPC_SERVICE_NAME`` only on the job process it spawns. The generated plist
-    runs the stderr-timestamp wrapper there, so the gateway grandchild reads ``XPC_SERVICE_NAME=0``
-    and finds its label only in the wrapper's re-export, ``HERMES_LAUNCHD_LABEL``. Both go through
-    the same ``ai.hermes`` predicate: app-coalition labels (``application.<bundle>…``, exported
-    into IDE integrated terminals) are not our job. ONE seam for every reader of launchd identity
-    (drain cap, restart route, control-socket supervisor declaration).
+    """This process's launchd job label in *environ*, or ``None`` (no darwin gate).
+
+    launchd stamps ``XPC_SERVICE_NAME`` only on the job process it spawns, so a gateway below a
+    wrapper reads ``XPC_SERVICE_NAME=0`` and finds its job only in ``HERMES_LAUNCHD_LABEL`` (set in
+    the plist's ``EnvironmentVariables`` or re-exported by the stderr-timestamp wrapper).
+    ``XPC_SERVICE_NAME`` counts only with the ``ai.hermes`` prefix: launchd also exports
+    app-coalition names (``application.<bundle>…``) there into IDE integrated terminals, and those
+    are not our job. [daveey] An explicit ``HERMES_LAUNCHD_LABEL`` is an operator assertion and
+    counts whatever its prefix (hand-written plists such as ``com.daveey.myapp.*`` name their own
+    job there, gateway-64b702b67e), except an app-coalition name, which is never a job identity in
+    either variable. ONE seam for every reader of launchd identity (drain cap, restart route,
+    control-socket supervisor declaration).
     """
     env = os.environ if environ is None else environ
-    for var in ("XPC_SERVICE_NAME", LAUNCHD_LABEL_ENV):
-        label = str(env.get(var, "") or "").strip()
-        if label.startswith("ai.hermes"):
-            return label
-    return None
+    xpc = str(env.get("XPC_SERVICE_NAME", "") or "").strip()
+    if xpc.startswith("ai.hermes"):
+        return xpc
+    explicit = str(env.get(LAUNCHD_LABEL_ENV, "") or "").strip()
+    if not explicit or explicit == "0" or explicit.startswith(LAUNCHD_APP_COALITION_PREFIX):
+        return None
+    return explicit
 
 
 def launchd_service_label(environ: Mapping[str, str] | None = None, *, platform: str = sys.platform) -> str | None:
diff --git a/hermes_cli/stderr_timestamp.py b/hermes_cli/stderr_timestamp.py
index d47b56c1622..086b1246fb4 100644
--- a/hermes_cli/stderr_timestamp.py
+++ b/hermes_cli/stderr_timestamp.py
@@ -114,15 +114,19 @@ def _child_launchd_label_env(environ: Mapping[str, str] | None = None) -> dict[s
     interactive shell has none, the grandchild sees ``XPC_SERVICE_NAME=0``). Re-exporting the
     label lets the gateway resolve its job without it (the stop-drain cap reading the live
     ``ExitTimeOut``, the exit-75 restart route, the control-socket supervisor declaration — all
-    via ``gateway.restart.launchd_job_label``). Only ``ai.hermes.*`` labels are exported;
-    app-coalition labels are meaningless as a job identity.
+    via ``gateway.restart.launchd_job_label``). ``XPC_SERVICE_NAME`` is exported only as an
+    ``ai.hermes.*`` label (app-coalition labels are meaningless as a job identity); [daveey] an
+    explicit ``HERMES_LAUNCHD_LABEL`` passes through whatever its prefix (hand-written
+    ``com.daveey.myapp.*`` plists, gateway-64b702b67e). Same rule as ``launchd_job_label``.
     """
     env = os.environ if environ is None else environ
-    for variable in ("XPC_SERVICE_NAME", _LAUNCHD_LABEL_ENV):
-        label = str(env.get(variable, "") or "").strip()
-        if label.startswith("ai.hermes"):
-            return {_LAUNCHD_LABEL_ENV: label}
-    return {}
+    xpc = str(env.get("XPC_SERVICE_NAME", "") or "").strip()
+    if xpc.startswith("ai.hermes"):
+        return {_LAUNCHD_LABEL_ENV: xpc}
+    explicit = str(env.get(_LAUNCHD_LABEL_ENV, "") or "").strip()
+    if not explicit or explicit == "0" or explicit.startswith("application."):
+        return {}
+    return {_LAUNCHD_LABEL_ENV: explicit}
 
 
 def _prepare_child_command(command: Sequence[str], environ: Mapping[str, str] | None = None) -> list[str]:
diff --git a/tests/gateway/test_launchd_explicit_label.py b/tests/gateway/test_launchd_explicit_label.py
new file mode 100644
index 00000000000..59623bcd827
--- /dev/null
+++ b/tests/gateway/test_launchd_explicit_label.py
@@ -0,0 +1,70 @@
+"""[daveey] An explicit ``HERMES_LAUNCHD_LABEL`` names the launchd job whatever its prefix (gateway-64b702b67e).
+
+The mini's gateways run under hand-written ``com.daveey.myapp.*`` plists. Below the job's first process
+``XPC_SERVICE_NAME`` is ``0``, so the plist's ``EnvironmentVariables.HERMES_LAUNCHD_LABEL`` is the only
+place the gateway can learn its job; the old ``ai.hermes`` prefix filter discarded it, the drain cap fell
+back to the assumed 60 s and these 45 s ``ExitTimeOut`` jobs could be SIGKILLed mid-teardown.
+The prefix filter stays on ``XPC_SERVICE_NAME``: launchd also exports app-coalition names
+(``application.<bundle>…``) there for IDE integrated terminals, and those are not our job.
+"""
+
+from __future__ import annotations
+
+import subprocess
+
+from gateway.restart import (
+    LAUNCHD_LABEL_ENV,
+    launchd_job_label,
+    launchd_service_label,
+    read_launchd_exit_timeout_s,
+)
+from hermes_cli.stderr_timestamp import _child_launchd_label_env
+
+BB_LABEL = "com.daveey.myapp.hermes"
+
+
+def test_explicit_label_counts_whatever_its_prefix():
+    env = {"XPC_SERVICE_NAME": "0", LAUNCHD_LABEL_ENV: BB_LABEL}
+    assert launchd_job_label(env) == BB_LABEL
+    assert launchd_service_label(env, platform="darwin") == BB_LABEL
+
+
+def test_app_coalition_xpc_name_without_explicit_label_is_still_rejected():
+    assert launchd_job_label({"XPC_SERVICE_NAME": "application.com.foo.12345"}) is None
+    assert launchd_job_label({"XPC_SERVICE_NAME": "0"}) is None
+
+
+def test_ai_hermes_xpc_name_still_counts_and_wins():
+    env = {"XPC_SERVICE_NAME": "ai.hermes.gateway", LAUNCHD_LABEL_ENV: BB_LABEL}
+    assert launchd_job_label(env) == "ai.hermes.gateway"
+
+
+def test_app_coalition_xpc_name_falls_through_to_explicit_label():
+    env = {"XPC_SERVICE_NAME": "application.com.foo.1", LAUNCHD_LABEL_ENV: BB_LABEL}
+    assert launchd_job_label(env) == BB_LABEL
+
+
+def test_blank_or_app_coalition_explicit_label_is_no_label():
+    assert launchd_job_label({"XPC_SERVICE_NAME": "0", LAUNCHD_LABEL_ENV: "  "}) is None
+    assert launchd_job_label({"XPC_SERVICE_NAME": "0", LAUNCHD_LABEL_ENV: "0"}) is None
+    assert launchd_job_label({"XPC_SERVICE_NAME": "0", LAUNCHD_LABEL_ENV: "application.com.x.1"}) is None
+
+
+def test_explicit_label_reads_the_jobs_live_exit_timeout():
+    seen = []
+
+    def run(cmd, **_kw):
+        seen.append(cmd)
+        return subprocess.CompletedProcess(cmd, 0, stdout="\texit timeout = 45\n", stderr="")
+
+    env = {"XPC_SERVICE_NAME": "0", LAUNCHD_LABEL_ENV: BB_LABEL}
+    assert read_launchd_exit_timeout_s(environ=env, uid=501, run=run, platform="darwin") == 45.0
+    assert seen and seen[0][-1] == f"gui/501/{BB_LABEL}"
+
+
+def test_stderr_wrapper_forwards_explicit_label_whatever_its_prefix():
+    assert _child_launchd_label_env({"XPC_SERVICE_NAME": "0", LAUNCHD_LABEL_ENV: BB_LABEL}) == {
+        LAUNCHD_LABEL_ENV: BB_LABEL
+    }
+    assert _child_launchd_label_env({"XPC_SERVICE_NAME": "application.com.foo.1"}) == {}
+    assert _child_launchd_label_env({"XPC_SERVICE_NAME": "0", LAUNCHD_LABEL_ENV: "application.com.x.1"}) == {}
