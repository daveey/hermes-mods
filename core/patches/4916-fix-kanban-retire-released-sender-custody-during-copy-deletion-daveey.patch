index 662501f514b3776a43a1d74712f11d59a12fcb65..5bb611f58caef9aec648477e771ceb2176cc1f0d 100644
--- a/hermes_cli/kanban_containment_guard.py
+++ b/hermes_cli/kanban_containment_guard.py
@@ -44,6 +44,11 @@ def released_history_delete(conn: sqlite3.Connection, task_id: str, *, verify_re
     """
     if pending(conn, task_id, verify_release=verify_release):
         raise sqlite3.IntegrityError("containment_pending")
+    # Retire only requests whose stop history was just verified as released,
+    # before removing that history could reinterpret them as unresolved.
+    if conn.in_transaction:
+        from hermes_cli.kanban_containment_requests import retire_released
+        retire_released(conn, task_id)
     token = _DELETE.set((id(conn), task_id))
     try:
         yield
diff --git a/hermes_cli/kanban_containment_requests.py b/hermes_cli/kanban_containment_requests.py
index df9677ecb0e3637cf89ddafc38b0690d74f8e11e..cd36bd06ae49ee17c7cb406ca529cc6923f3b228 100644
--- a/hermes_cli/kanban_containment_requests.py
+++ b/hermes_cli/kanban_containment_requests.py
@@ -24,3 +24,23 @@ def pending(conn: sqlite3.Connection, task: str, known_stops: set[str]) -> bool:
         if op.get("op") == "contain" and op.get("task") == task and op.get("event_uid") not in known_stops:
             return True
     return False
+
+
+def retire_released(conn: sqlite3.Connection, task: str) -> None:
+    """Retire observed stop requests only inside verified release-delete custody.
+
+    The caller holds the deletion transaction and has verified every episode.
+    Unknown requests remain hold-only custody; rollback restores retired rows.
+    """
+    if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='containment_delivery'").fetchone():
+        return
+    from hermes_cli.kanban_db_sync import sync_state
+    state = sync_state(conn)
+    if state is None:
+        return
+    conn.execute(
+        "DELETE FROM containment_delivery WHERE board=? AND gateway=? AND json_valid(op_json) "
+        "AND json_extract(op_json,'$.op')='contain' AND json_extract(op_json,'$.task')=? "
+        "AND json_extract(op_json,'$.event_uid') IN "
+        "(SELECT uid FROM task_events WHERE task_id=? AND kind='contained')",
+        (state["board_id"], state["gateway_id"], task, task))
