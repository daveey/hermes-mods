diff --git a/tests/hermes_cli/test_kanban_containment_delete_paths.py b/tests/hermes_cli/test_kanban_containment_delete_paths.py
new file mode 100644
index 0000000000000000000000000000000000000000..df77cd55f62d4607a35eceb0ec78e100ebd45a3e
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_containment_delete_paths.py
@@ -0,0 +1,94 @@
+"""Released containment eviction/purge and held import regression paths."""
+from __future__ import annotations
+
+import logging
+import sqlite3
+
+import pytest
+
+from gateway.session_context import scoped_current_session_id
+from hermes_cli import kanban_containment_service as service
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_worker_node as wn
+from hermes_cli.kanban_containment_connections import held
+from tests.hermes_cli import test_kanban_containment_lifecycle as lc
+from tests.hermes_cli import test_kanban_containment_remote as rm
+
+board = rm.board
+
+
+def _as_foreign_copy(conn, tid):
+    conn.execute("UPDATE tasks SET created_on='home' WHERE id=?", (tid,))
+    conn.execute("DELETE FROM kanban_sync_outbox WHERE row_uid=? OR json_extract(fields,'$.task_id')=?", (tid, tid))
+    conn.commit()
+
+
+def _evict(conn, monkeypatch, caplog):
+    from hermes_cli import kanban_replica_lag as lag
+    monkeypatch.setattr(wn, "_guard_held", lambda c, ids: set())
+    monkeypatch.setattr(lag, "held_copies", lambda c, path, ids: set())
+    monkeypatch.setattr(wn, "_replica_path", lambda c: None)
+    caplog.clear()
+    with caplog.at_level(logging.WARNING, logger=wn._log.name):
+        gone = wn.evict(conn)
+    failed = [r.getMessage() for r in caplog.records if "could not evict" in r.getMessage()]
+    return gone, failed
+
+
+def _child(conn, relay):
+    return conn.execute("SELECT child_id FROM task_links WHERE parent_id=?", (relay,)).fetchone()[0]
+
+
+def _released_child(conn, monkeypatch):
+    relay, authority, session, _hub = rm.setup(conn, monkeypatch)
+    child = _child(conn, relay)
+    rm.adopt(conn, monkeypatch, relay, session)
+    with scoped_current_session_id(session):
+        stop = service.contain(conn, task_id=child, authority=authority, summary="Fixture")
+    rm.adopt(conn, monkeypatch, authority, session)
+    with scoped_current_session_id(session):
+        assert service.resume(conn, task_id=child, episode=stop["episode"])["status"] == "ready"
+    assert not held(conn, child)
+    return child
+
+
+@pytest.mark.parametrize("released", [False, True])
+def test_evict_foreign_copy(board, monkeypatch, caplog, released):
+    if released:
+        child = _released_child(board, monkeypatch)
+    else:
+        relay, _authority, _session, _hub = rm.setup(board, monkeypatch)
+        child = _child(board, relay)
+    _as_foreign_copy(board, child)
+    gone, failed = _evict(board, monkeypatch, caplog)
+    assert child in gone and not failed
+    assert kb.get_task(board, child) is None
+    assert _evict(board, monkeypatch, caplog) == ([], [])
+
+
+@pytest.mark.parametrize("released", [False, True])
+def test_synced_purge(board, monkeypatch, released):
+    from hermes_cli.kanban_db_archive import archive_task
+    if released:
+        child = _released_child(board, monkeypatch)
+    else:
+        relay, _authority, _session, _hub = rm.setup(board, monkeypatch)
+        child = _child(board, relay)
+    assert archive_task(board, child)
+    assert kb.delete_archived_task(board, child)
+    assert kb.get_task(board, child) is None
+
+
+def test_import_board_preserves_hold(board, tmp_path):
+    from hermes_cli import kanban_transfer as transfer
+    relay, _consumer, _authority, target, spec = lc.setup(board)
+    lc.contain(board, relay, target, spec)
+    tid = target["task_id"]
+    assert held(board, tid)
+    out = transfer.export_board("default", tmp_path / "out.tar.gz")
+    res = transfer.import_board(str(out if not isinstance(out, dict) else tmp_path / "out.tar.gz"), slug="imported-fixture")
+    from hermes_cli import kanban_db_connect as kbc
+    with kbc.connect_closing(board=res["board"]) as conn:
+        assert held(conn, tid)
+        with pytest.raises(sqlite3.IntegrityError):
+            conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
diff --git a/tests/hermes_cli/test_kanban_containment_history_delete.py b/tests/hermes_cli/test_kanban_containment_history_delete.py
new file mode 100644
index 0000000000000000000000000000000000000000..c7202448947e8364954031132520aeea2076ef5a
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_containment_history_delete.py
@@ -0,0 +1,130 @@
+"""Exact-removal kills for released_history_delete permit predicates."""
+from __future__ import annotations
+
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_containment_connections as connections
+from hermes_cli import kanban_containment_guard as guard
+from hermes_cli import kanban_db as kb
+from tests.hermes_cli import test_kanban_containment_lifecycle as lc
+
+board = lc.board
+
+
+def _released(conn):
+    relay, _consumer, authority, target, spec = lc.setup(conn)
+    episode = lc.contain(conn, relay, target, spec)["episode"]
+    assert lc.release(conn, target, episode, authority)["status"] == "ready"
+    assert not connections.held(conn, relay)
+    return relay
+
+
+def _protected(conn, task):
+    return conn.execute(
+        "SELECT COUNT(*) FROM task_events WHERE task_id=? AND kind IN ('contained','containment_released')",
+        (task,),
+    ).fetchone()[0]
+
+
+def _delete_protected(conn, task):
+    conn.execute(
+        "DELETE FROM task_events WHERE task_id=? AND kind IN ('contained','containment_released')",
+        (task,),
+    )
+
+
+def test_delete_permit_refuses_while_pending(board):
+    relay, _consumer, _authority, target, spec = lc.setup(board)
+    lc.contain(board, relay, target, spec)
+    with kb.write_txn(board):
+        with pytest.raises(sqlite3.IntegrityError, match="containment_pending"):
+            with connections.released_history_delete(board, relay):
+                pass
+        assert board.execute("SELECT kanban_containment_delete(?)", (relay,)).fetchone()[0] == 0
+        with pytest.raises(sqlite3.IntegrityError, match="containment_pending"):
+            _delete_protected(board, relay)
+    assert _protected(board, relay) == 1
+
+
+def test_delete_permit_without_verifier_keeps_released_history_held(board):
+    task = _released(board)
+    with kb.write_txn(board):
+        with pytest.raises(sqlite3.IntegrityError, match="containment_pending"):
+            with guard.released_history_delete(board, task):
+                pass
+        with connections.released_history_delete(board, task):
+            _delete_protected(board, task)
+    assert _protected(board, task) == 0
+
+
+def test_delete_permit_udf_is_false_outside_transaction(board):
+    task = _released(board)
+    assert not board.in_transaction
+    with connections.released_history_delete(board, task):
+        assert not board.in_transaction
+        assert board.execute("SELECT kanban_containment_delete(?)", (task,)).fetchone()[0] == 0
+        with pytest.raises(sqlite3.IntegrityError, match="containment_pending"):
+            _delete_protected(board, task)
+    assert _protected(board, task) == 2
+
+
+def test_delete_permit_is_task_and_reset_scoped(board):
+    granted, other = _released(board), _released(board)
+    with kb.write_txn(board):
+        with connections.released_history_delete(board, granted):
+            assert board.execute("SELECT kanban_containment_delete(?)", (granted,)).fetchone()[0] == 1
+            assert board.execute("SELECT kanban_containment_delete(?)", (other,)).fetchone()[0] == 0
+            with pytest.raises(sqlite3.IntegrityError, match="containment_pending"):
+                _delete_protected(board, other)
+            _delete_protected(board, granted)
+        assert board.execute("SELECT kanban_containment_delete(?)", (granted,)).fetchone()[0] == 0
+        with pytest.raises(sqlite3.IntegrityError, match="containment_pending"):
+            _delete_protected(board, other)
+    assert _protected(board, granted) == 0
+    assert _protected(board, other) == 2
+
+
+def test_delete_permit_is_connection_scoped(board):
+    task = _released(board)
+    path = board.execute("PRAGMA database_list").fetchone()[2]
+    peer = sqlite3.connect(path, isolation_level=None)
+    try:
+        connections.register(peer)
+        with kb.write_txn(board):
+            with connections.released_history_delete(board, task):
+                assert board.execute("SELECT kanban_containment_delete(?)", (task,)).fetchone()[0] == 1
+                peer.execute("BEGIN")
+                try:
+                    assert peer.in_transaction
+                    assert peer.execute("SELECT kanban_containment_delete(?)", (task,)).fetchone()[0] == 0
+                finally:
+                    peer.execute("ROLLBACK")
+    finally:
+        peer.close()
+    assert _protected(board, task) == 2
+
+
+def test_delete_permit_resets_after_exception(board):
+    task = _released(board)
+    with kb.write_txn(board):
+        with pytest.raises(RuntimeError, match="scope-reset"):
+            with connections.released_history_delete(board, task):
+                assert board.execute("SELECT kanban_containment_delete(?)", (task,)).fetchone()[0] == 1
+                raise RuntimeError("scope-reset")
+        assert board.execute("SELECT kanban_containment_delete(?)", (task,)).fetchone()[0] == 0
+        with pytest.raises(sqlite3.IntegrityError, match="containment_pending"):
+            _delete_protected(board, task)
+    assert _protected(board, task) == 2
+    assert board.execute("SELECT COUNT(*) FROM containment_observations WHERE task_id=?", (task,)).fetchone()[0] >= 1
+
+
+def test_delete_task_relations_does_not_cross_tasks(board):
+    granted, other = _released(board), _released(board)
+    with kb.write_txn(board):
+        kb._delete_task_relations(board, granted)
+    assert _protected(board, granted) == 0
+    assert _protected(board, other) == 2
+    assert board.execute("SELECT COUNT(*) FROM containment_observations WHERE task_id=?", (granted,)).fetchone()[0] == 0
+    assert board.execute("SELECT COUNT(*) FROM containment_observations WHERE task_id=?", (other,)).fetchone()[0] >= 1
diff --git a/tests/hermes_cli/test_kanban_containment_request_retirement.py b/tests/hermes_cli/test_kanban_containment_request_retirement.py
