From 9e16ddab3fe0295afd09aaa161e31608c227e7e1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 07:05:55 +0000
Subject: [PATCH] fix(tests): let serve own its ephemeral ledger-test port
 [daveey]

---
 .../test_isolated_serve_ledger_marker.py      | 28 ++++++++++++++-----
 1 file changed, 21 insertions(+), 7 deletions(-)

diff --git a/tests/hermes_cli/test_isolated_serve_ledger_marker.py b/tests/hermes_cli/test_isolated_serve_ledger_marker.py
index 98791c0a74..1c060a8331 100644
--- a/tests/hermes_cli/test_isolated_serve_ledger_marker.py
+++ b/tests/hermes_cli/test_isolated_serve_ledger_marker.py
@@ -18,12 +18,6 @@ import psutil
 import pytest
 
 
-def _free_port():
-    with socket.socket() as sock:
-        sock.bind(("127.0.0.1", 0))
-        return sock.getsockname()[1]
-
-
 def _await_ledger_row(ledger, proc, log, *, timeout=45):
     deadline = time.monotonic() + timeout
     while time.monotonic() < deadline:
@@ -117,6 +111,26 @@ def test_stop_terminates_a_live_process():
         proc.stdin.close()
 
 
+@pytest.mark.parametrize("isolated", [False, True])
+def test_ledger_launch_does_not_release_a_reserved_port(tmp_path, monkeypatch, isolated):
+    """A competing listener wins any bind/close reservation before serve starts."""
+    popen = subprocess.Popen
+    launches = []
+    with socket.socket() as competitor:
+        def launch(argv, **kwargs):
+            if "serve" in argv and ("--isolated" in argv) == isolated:
+                port = int(argv[argv.index("--port") + 1])
+                # With port 0, the competitor gets its own allocation instead.
+                competitor.bind(("127.0.0.1", port))
+                competitor.listen()
+                launches.append(port)
+            return popen(argv, **kwargs)
+
+        monkeypatch.setattr(subprocess, "Popen", launch)
+        test_isolated_serve_ledger_row_is_marked_and_ordinary_serve_is_not(tmp_path)
+    assert launches == [0]
+
+
 def test_isolated_serve_ledger_row_is_marked_and_ordinary_serve_is_not(tmp_path):
     home = tmp_path / "home"
     home.mkdir()
@@ -135,7 +149,7 @@ def test_isolated_serve_ledger_row_is_marked_and_ordinary_serve_is_not(tmp_path)
             with log.open("w", encoding="utf-8") as out:
                 procs[name] = subprocess.Popen(
                     [sys.executable, "-m", "hermes_cli.main", "serve", *extra,
-                     "--host", "127.0.0.1", "--port", str(_free_port())],
+                     "--host", "127.0.0.1", "--port", "0"],
                     env=env, stdout=out, stderr=subprocess.STDOUT,
                 )
             rows[name] = _await_ledger_row(ledger, procs[name], log)
