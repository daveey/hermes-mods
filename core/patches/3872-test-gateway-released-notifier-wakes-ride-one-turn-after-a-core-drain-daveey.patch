From 40bafc63d3b0d907ab4917b3574d5b9823f6bf5d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:21:05 +0000
Subject: [PATCH] test(gateway): released notifier wakes ride one turn after a
 core drain [daveey]

test_receipted_wakes_wait_for_core_drain_but_human_bypasses expected the two
receipted notifier wakes released after a core drain to run as two turns. With
pending notices folded into the turn that starts at a boundary (previous commit,
t_01a1d663082aa53a), both are pending when the drain releases, so the first
wake's turn carries the second in admission order: one turn "wake-1\n\nwake-2".
The test's subject (wakes held during the drain, a human bypasses them, all
rows settle terminal after release) is unchanged; only the final turn split.
---
 tests/gateway/test_notifier_core_drain.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/gateway/test_notifier_core_drain.py b/tests/gateway/test_notifier_core_drain.py
index f99fa00983..33d86df8f4 100644
--- a/tests/gateway/test_notifier_core_drain.py
+++ b/tests/gateway/test_notifier_core_drain.py
@@ -51,7 +51,9 @@ async def test_receipted_wakes_wait_for_core_drain_but_human_bypasses(monkeypatc
             lambda: all(status == "terminal" for _, status, _ in admissions(runner, authority, source)),
             what="deferred wakes released after core drain",
         )
-        assert executed == [("owner", text) for text in ("A", "human", "wake-1", "wake-2")]
+        # Both released wakes are pending at one boundary, so they ride one turn in admission order
+        # (gateway/session_fold_pending.py, t_01a1d663082aa53a).
+        assert executed == [("owner", text) for text in ("A", "human", "wake-1\n\nwake-2")]
     finally:
         hold.finish.set()
         marker.unlink(missing_ok=True)
