From 46329eeaba50449d2e05da205a428e59c2628ca5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 08:06:41 +0000
Subject: [PATCH] fix(kanban): keep every home-rooted .worktrees tree on its
 host [daveey]

Re-review of 15ef9d20 (PR773, B1): LOCAL_WORKTREE_PATH covered only ~/.hermes/hermes-agent/.worktrees, so
cards naming the per-repo kanban trees on the hub enrolled worker-first though their work exists only there
(~/code/myapp/.worktrees/t_50dec368: 1 unpushed commit; ~/code/askeve/.worktrees/t_01a18c8*: 12 trees,
1-6 dirty files each). Repro at 15ef9d20: decide() returned worker-first-v1 for both titles.

Fix: LOCAL_WORKTREE_PATH matches any `(~|/home/<user>)/<...>/.worktrees` path segment (next to
/.claude/worktrees). `.worktrees-notes.md`, `worktrees/` without the dot, a bare `.worktrees` word and
non-home `/tmp/.../.worktrees` stay portable; ordinary ~/code/<repo> paths stay portable.

Five whys (recurrence of the 15ef9d20 chain, same PR):
Why 1: 15ef9d20 restored the `.worktrees` marker only for the one tree it had traced (hermes-agent).
Why 2: its host-state inventory listed ~/code/_wt*, .claude/worktrees and hermes-agent/.worktrees, but not the
  `<repo>/.worktrees` layout kanban worktree cards create under ~/code/<repo> - evidence: reviewer listing above.
Why 3: tests pinned concrete example paths, not the layout, so no case named a repo other than hermes-agent.
Root (happened): the marker was written per traced instance instead of per worktree layout.
Root (not caught): test_host_specific_state_and_identity_stay_local had no `~/code/<repo>/.worktrees` case and
  the enrolls list had no near-miss negatives, so neither a narrow nor an over-broad regex failed a test.
Countermeasure: myapp/askeve-shaped stay-local cases (~ and /home/ubuntu, backticked, bare dir) plus
  near-miss negatives in test_ordinary_repo_work_enrolls_worker_first.

Tests: RED at 15ef9d20: 4 failed (the 4 new stay-local cases), 6 new negatives passed. GREEN: placement
suites 416 passed; test_kanban_placement_cancel.py 19 passed (run alone).
---
 hermes_cli/kanban_placement.py                   | 11 ++++++++---
 tests/hermes_cli/test_kanban_worker_placement.py | 13 +++++++++++++
 2 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 7c41e2bd165..4e0459f9afb 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -350,13 +350,18 @@ def _heavy_marker(title: str, body: str, cfg: _Cfg) -> Optional[str]:
 # and the Board CLI name ``hermes-hub`` kept ~3 of every 4 ready hub cards off the worker pool, so the hub's
 # local execution cap throttled the whole queue. What stays local: an existing worktree on this host
 # (``~/code/_wt/<slug>``, ``~/code/_wt-remote/<slug>``, ``<repo>/.claude/worktrees/<x>``,
-# ``~/.hermes/hermes-agent/.worktrees/<x>`` hold unpushed work), Hermes state under ``~/.hermes`` other than the
-# code checkout (``~/.hermes/skills`` is host state: curator ledger, usage counts, live-patched skills), a
+# ``~/code/<repo>/.worktrees/<x>``, ``~/.hermes/hermes-agent/.worktrees/<x>`` hold unpushed work), Hermes
+# state under ``~/.hermes`` other than the code checkout (``~/.hermes/skills`` is host state: curator ledger,
+# usage counts, live-patched skills), a
 # ``hermes-hub <subcommand>`` run (it acts with this gateway's key and replica), and a card that declares
 # ``requires: [host_repo]`` or a ``dir``/``worktree`` workspace.
 HERMES_STATE_PATH = r"(?:~|/home/[^/\s]+)/\.hermes/(?!(?:hermes-agent|repos|bin)(?:/|\b))[\w.-]"
 HOST_WORKTREE_PATH = r"(?:~|/home/[^/\s]+)/code/_wt(?:-[\w-]+)?(?:/|\b)"
-LOCAL_WORKTREE_PATH = r"/\.claude/worktrees\b|(?:~|/home/[^/\s]+)/\.hermes/hermes-agent/\.worktrees\b"
+# Any home-rooted ``<dir>/.worktrees`` (``~/code/<repo>/.worktrees/t_*``, ``~/.hermes/hermes-agent/.worktrees``):
+# kanban worktrees there hold host-only commits and dirty files. ``.worktrees-notes.md`` and ``/tmp/.../.worktrees``
+# are not matches.
+LOCAL_WORKTREE_PATH = (r"/\.claude/worktrees\b|"
+                       r"(?:~|/home/[^/\s]+)/(?:[^/\s`'\"]+/)*\.worktrees(?![\w-]|\.\w)")
 HUB_CLI_COMMAND = (r"\bhermes-hub\s+(?:sync|status|sessions|inbox|tasks|where|links|requests?|inspect-legacy|"
                    r"reconcile-legacy|inspect-alias|retire-alias|adopt-task|create-task|depend|outcomes|"
                    r"install-watch|watch|diff-shared)\b")
diff --git a/tests/hermes_cli/test_kanban_worker_placement.py b/tests/hermes_cli/test_kanban_worker_placement.py
index b430c99a74e..7123da16c41 100644
--- a/tests/hermes_cli/test_kanban_worker_placement.py
+++ b/tests/hermes_cli/test_kanban_worker_placement.py
@@ -91,6 +91,13 @@ def test_courier_and_host_work_bypass_worker_policy():
     "hermes-hub client: retry a 409 from the Board",
     "Fix a typo in ~/code/_wtf/notes.md",
     "Read the hermes-agent tree under ~/.hermes for context",
+    # Near-misses of the home-rooted .worktrees marker stay portable.
+    "Fix the parser bug in ~/code/myapp/src/parser.py and open a PR",
+    "Patch /home/ubuntu/code/askeve/app/routes.py and push",
+    "Document ~/code/askeve/.worktrees-notes.md cleanup",
+    "Rename ~/code/myapp/worktrees/README.md",
+    "Add .worktrees to ~/code/askeve/.gitignore",
+    "Clean /tmp/scratch/.worktrees in the test fixture",
 ])
 def test_ordinary_repo_work_enrolls_worker_first(title):
     """Repo paths, the Board CLI name and a bare ~/.hermes are not host needs: workers provision checkouts."""
@@ -118,6 +125,12 @@ def test_hub_state_work_stays_local(title):
     "Continue in ~/code/_wt-remote/fix-x and push",
     "Finish the agent tree at ~/code/hermes-mods/.claude/worktrees/agent-a1 and open a PR",
     "Rebase /home/ubuntu/.hermes/hermes-agent/.worktrees/fix-y onto main",
+    # Any home-rooted per-repo .worktrees (kanban t_* trees): 11-03 hub had myapp 1 unpushed commit,
+    # askeve 12 trees with dirty files. Follow-up cards name the path in text, not a worktree workspace.
+    "Continue in ~/code/myapp/.worktrees/t_50dec368 and push",
+    "Finish /home/ubuntu/code/askeve/.worktrees/t_01a18c8d53dc31b2 and open a PR",
+    "Commit the dirty files in `~/code/askeve/.worktrees/t_01a18c8d53dc31b2`.",
+    "List the trees under /home/ubuntu/code/myapp/.worktrees",
     # hermes-hub commands act with this gateway's key and replica; a worker has neither.
     "Run hermes-hub create-task hub --title x", "hermes-hub adopt-task t_1 --session s", "Run `hermes-hub sync`",
     "Check hermes-hub requests for the stuck ask",
