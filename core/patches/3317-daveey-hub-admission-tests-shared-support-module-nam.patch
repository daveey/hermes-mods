From 1395789384008cbb19340b4b262ac8c3b16f9b6d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 05:16:51 +0000
Subject: [PATCH] [daveey] hub admission tests: shared support module; name the
 no-JSON1 fallback in _running_rows

PR #1859 review nits (t_01a1d3181167992b): test_hub_cpu_gate_contention no longer imports
test_kanban_hub_admission (or re-exports its board fixture); both use
tests/hermes_cli/hub_admission_support.py. _running_rows' docstring and comment now name
'no such function: json_group_array' (SQLite without JSON1) as a long-path fallback too.
---
 hermes_cli/machine_metrics.py                 |  7 +-
 tests/hermes_cli/hub_admission_support.py     | 72 +++++++++++++++++++
 .../test_hub_cpu_gate_contention.py           | 10 ++-
 tests/hermes_cli/test_kanban_hub_admission.py | 57 +--------------
 4 files changed, 88 insertions(+), 58 deletions(-)
 create mode 100644 tests/hermes_cli/hub_admission_support.py

diff --git a/hermes_cli/machine_metrics.py b/hermes_cli/machine_metrics.py
index 2ccb623a57..97a468070e 100644
--- a/hermes_cli/machine_metrics.py
+++ b/hermes_cli/machine_metrics.py
@@ -86,12 +86,15 @@ _LOCAL_SQL = f"SELECT (SELECT count(*) FROM pragma_table_info('tasks') WHERE nam
 
 def _running_rows(db) -> Optional[tuple[bool, Any, list]]:
     """``(synced, own gateway id, [(task_id, run_id, pool, class, origin), ...])`` for the running rows this host
-    counts, read in one statement; ``None`` when the board's schema predates claim receipts, or has lease holders
-    without sync state (read it the long way, which decides those exactly as before)."""
+    counts, read in one statement; ``None`` when the board's schema predates claim receipts, when this SQLite lacks
+    JSON1 (``no such function: json_group_array``), or when it has lease holders without sync state (read it the long
+    way, which decides those exactly as before)."""
     for synced, sql in ((True, _SYNCED_SQL), (False, _LOCAL_SQL)):
         try:
             head, rows = db.execute(sql).fetchone()
         except sqlite3.OperationalError as exc:
+            # "no such table/column" (pre-receipt schema, unsynced board) or "no such function" (no JSON1): both
+            # fall through to the long path, which needs neither.
             if str(exc).startswith("no such "):
                 continue
             raise
