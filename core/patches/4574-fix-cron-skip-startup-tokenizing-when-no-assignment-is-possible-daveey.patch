From ce9fa840db536372534298519f6ed642dcc6ae75 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 19:40:20 +0000
Subject: [PATCH] fix(cron): skip startup tokenizing when no assignment is
 possible [daveey]

CI on b9ef9f85 failed tests/cron/test_lifecycle_guard_budget.py::
test_line_budget_fails_closed_before_tokenizing_every_line (assert 10 < 10):
iter_startup_sources added a tenth shlex pass over a one-line root that cannot
hold any assignment. Quote/backslash removal never creates '='; only a $-form
can, so a command with neither '=' nor '$' yields no startup file and now skips
the extra tokenizer pass. Behaviour for every command containing either is
unchanged. Proof: lexer count for the test's root 10 -> 9 (main's count);
tests/cron/test_lifecycle_guard*.py 54 files, 9730 passed, 0 failed.
---
 cron/lifecycle_guard_startup.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/cron/lifecycle_guard_startup.py b/cron/lifecycle_guard_startup.py
index 60dbe1475f2cbd6248b73389685334c4ef5496b3..cabd868ed83a52b57e2920e266b2648a77f8ec7b 100644
--- a/cron/lifecycle_guard_startup.py
+++ b/cron/lifecycle_guard_startup.py
@@ -46,6 +46,11 @@ def iter_startup_sources(command: str) -> Iterator[tuple[str, bool]]:
     """
     # Assignment names may contain shell quotes or escapes. Match only after
     # the shared segment tokenizer removes them, not against raw source text.
+    # Quote and backslash removal never create "="; only a $-form ($'\x3d')
+    # can. Without either, no tokenized word can be an assignment, so skip the
+    # extra tokenizer pass (it counts against the per-scan lexer budget).
+    if "=" not in command and "$" not in command:
+        return
     from cron.lifecycle_guard import (
         _executable_name, _executed_command_index, _iter_command_segment_views,
         _split_redirections,
