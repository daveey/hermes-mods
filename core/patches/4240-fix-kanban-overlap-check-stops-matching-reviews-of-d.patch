From 5f224d4d77e5c2d2bd94976addc9ba4969c55406 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 17:54:51 +0000
Subject: [PATCH] fix(kanban): overlap check stops matching reviews of
 different PRs by template words [daveey]

Problem: since 11-11 kanban_create refused "Independent exact-head review PR #N @<sha> (core-wt ship review
required)" cards as duplicates of open reviews of OTHER PRs (36/33/29 refusals on 11-12/13/14, plus 94/87/33
distinct_from overrides). Example 11-14 17:22:14Z: #3050 refused against t_01a1db12b45dec5f (#3056) on
"titles share 8 words (core, exact, head, independent, pr, review, ship, wt)". Ten refused reviews were
re-created as "Review PR139 ..." and lost the strong-tier keep pattern.

Why: _reasons scores titles as free text; the ship template's 8 words are ~80% of each review title, so
the PR number, the only distinguishing token, cannot pull the ratio under 0.5. No negative test covered
template titles differing only in identifiers.

Fix: the two title-share reasons ("titles share N words", "titles name <file> and share N words") do not
apply when both titles name a PR (#N, PR N, PRN, PR #N, pull/N; N of 2-6 digits) and the PR sets are
disjoint. Same PR on both sides, or a PR on one side only, is unchanged; singleton job, failure identity
and board reasons are unchanged. Shas without PR numbers and repo disambiguation are out of scope.

Proof: tests/tools/test_kanban_create_overlap_pr_ids.py (12 tests). RED on main: 8 failed (the #3050/#3056
pair, every PR form, the shared-file reason with different PRs, pr_numbers); the 4 unchanged-behaviour
cases (PR166 same-PR pair vs t_01a1d803ac2c9d7c, overlapping PR sets, PR on one side only, the
t_01a1d290dc768ba1 run_ci.py pair) pass on both. GREEN: all 15 files importing kanban_overlap, 480 passed.
scripts/check --base origin/main ok.

Card: t_01a1db274c88e2e3
---
 hermes_cli/kanban_overlap.py                  | 21 +++-
 .../test_kanban_create_overlap_pr_ids.py      | 98 +++++++++++++++++++
 2 files changed, 118 insertions(+), 1 deletion(-)
 create mode 100644 tests/tools/test_kanban_create_overlap_pr_ids.py

diff --git a/hermes_cli/kanban_overlap.py b/hermes_cli/kanban_overlap.py
index f2a15c14a1..44ef003c1d 100644
--- a/hermes_cli/kanban_overlap.py
+++ b/hermes_cli/kanban_overlap.py
@@ -238,6 +238,23 @@ def cites(card_id: str, title: str, body: str) -> bool:
     return card_id in set(_CARD_ID.findall(f"{title}\n{(body or '')[:_BODY_SCAN]}"))
 
 
+# Template titles (t_01a1db274c88e2e3): ``hermes-core-wt ship --request-review`` files "Independent exact-head review
+# PR #N @<sha> (core-wt ship review required)", so two reviews of different PRs share ~80% of their words and only the
+# PR number tells them apart. Titles that each name PRs, and no PR in common, are different work by title.
+_PR_REF = re.compile(r"(?:(?<![\w#])#|\bpr\s*#?\s*|\bpull/)(\d{2,6})(?!\d)", re.IGNORECASE)
+
+
+def pr_numbers(title: str) -> frozenset[int]:
+    """PR numbers a title names: ``#N``, ``PR N``, ``PRN``, ``PR #N``, ``pull/N`` (N of 2-6 digits)."""
+    return frozenset(int(n) for n in _PR_REF.findall(title or ""))
+
+
+def _different_prs(a: str, b: str) -> bool:
+    """Both titles name a PR and no PR number is common to them (repos are not told apart)."""
+    mine, theirs = pr_numbers(a), pr_numbers(b)
+    return bool(mine and theirs and not mine & theirs)
+
+
 def _reasons(card: dict, new_words: set[str], title: str, body: str, target_board: str,
              gateways: Iterable[str] = (), failure: Optional[FailureIdentity] = None) -> tuple[list[str], float]:
     reasons, score = [], 0.0
@@ -266,7 +283,9 @@ def _reasons(card: dict, new_words: set[str], title: str, body: str, target_boar
         ratio = len(shared) / max(len(new_words), len(theirs))
         score = max(score, ratio)
         # The title ratio alone: a failure match sets score to 1.0 without any title overlap.
-        if len(shared) >= MIN_SHARED and ratio >= 0.5:
+        if _different_prs(title, card.get("title") or ""):
+            pass  # Template words shared by titles of different PRs say nothing (_PR_REF).
+        elif len(shared) >= MIN_SHARED and ratio >= 0.5:
             reasons.append(f"titles share {len(shared)} words ({', '.join(sorted(shared))})")
         elif len(shared) >= MIN_FILE_SHARED and ratio >= FILE_SCORE and (same := code_files(title)
                                                                           & code_files(card.get("title") or "")):
diff --git a/tests/tools/test_kanban_create_overlap_pr_ids.py b/tests/tools/test_kanban_create_overlap_pr_ids.py
new file mode 100644
index 0000000000..bf33a0a1d7
--- /dev/null
+++ b/tests/tools/test_kanban_create_overlap_pr_ids.py
@@ -0,0 +1,98 @@
+"""kanban_create does not call review cards for different PRs duplicates by shared template words. [daveey]
+
+Incident (2026-11-11..14, t_01a1db274c88e2e3): ``hermes-core-wt ship --request-review`` titles every review
+"Independent exact-head review PR #N @<sha> (core-wt ship review required)". Those template words are ~80% of each
+title, so the title-share rule refused reviews of other PRs (36/33/29 a day, plus ~90/day ``distinct_from``
+overrides). Refused reviews re-created as "Review PR139 ..." lost the strong-tier keep pattern. Titles that both name
+PRs, with no PR in common, no longer match by shared words; the same PR, or a PR on one side only, is unchanged.
+"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_overlap as ko
+from tests.tools import test_kanban_create_overlap as helpers
+from tests.tools.test_kanban_create_overlap_shared_file import HUB_CARD, WORKER_DUP
+
+home = helpers.home
+
+REVIEW_3050 = "Independent exact-head review PR #3050 @478094efef (core-wt ship review required)"
+REVIEW_3056 = ("Independent exact-head review state PR #3056 @6898005a52 "
+               "(core-wt ship: lease the topic-branch push)")
+PR166_NEW = "Independent exact-head review hermes-mods PR166 M9/M10/M5 tests"
+PR166_OPEN = "Independent review mods PR166 exact53e08858: user-steps M9/M10/M5 tests"
+
+
+def remote(tmp_path, title, *, cid="t_01a1db12b45dec5f"):
+    (tmp_path / "hub-state" / "hub.db").unlink(missing_ok=True)
+    helpers._fake_replica(tmp_path / "hub-state" / "hub.db", [
+        ("hub", {"id": cid, "board": "default", "title": title, "body": "", "status": "running",
+                 "gateway": "hub", "sessions": [{"session": "20261114_172000_aaaaaa", "rel": "created"}]})])
+
+
+def check(title):
+    with kbc.connect_closing() as conn:
+        refusal, _ = ko.check(conn, {"body": ""}, courier=False, title=title, session_id="worker-7-run",
+                              self_tid=None, parents=[])
+    return json.loads(refusal) if refusal else None
+
+
+@pytest.fixture
+def worker(home, monkeypatch):
+    from hermes_cli import kanban_capability_registry as reg
+    monkeypatch.setattr(reg, "self_gateway", lambda: "worker-7")
+    return home
+
+
+def test_reviews_of_different_prs_are_not_duplicates(worker, tmp_path):
+    """The 11-14 17:22:14Z refusal: #3050 against open #3056 on 8 shared template words."""
+    remote(tmp_path, REVIEW_3056)
+    assert check(REVIEW_3050) is None
+
+
+@pytest.mark.parametrize("pr", ["#3020", "PR 3020", "PR3020", "pr #3020", "pull/3020"])
+def test_every_pr_form_tells_reviews_apart(worker, tmp_path, pr):
+    """Same template, so each pair shares 8-9 of 10-11 words (#3020 at 17:26:59Z was refused like this)."""
+    remote(tmp_path, REVIEW_3050)
+    assert check(REVIEW_3050.replace("PR #3050 @478094efef", f"{pr} @1a2b3c4d5e")) is None
+
+
+def test_same_pr_review_still_matches(worker, tmp_path):
+    """The 11-14 03:12:46Z refusal of a second PR166 review against t_01a1d803ac2c9d7c."""
+    remote(tmp_path, PR166_OPEN, cid="t_01a1d803ac2c9d7c")
+    out = check(PR166_NEW)
+    assert out and out["code"] == "create_overlap", out
+    (m,) = out["matches"]
+    assert m["id"] == "t_01a1d803ac2c9d7c" and "titles share" in m["why"], m
+
+
+def test_overlapping_pr_sets_still_match(worker, tmp_path):
+    remote(tmp_path, REVIEW_3056.replace("PR #3056", "PR #3056 and #3050"))
+    out = check(REVIEW_3050)
+    assert out and "titles share" in out["matches"][0]["why"], out
+
+
+def test_pr_on_one_side_only_matches_as_before(worker, tmp_path):
+    remote(tmp_path, REVIEW_3056.replace("PR #3056 ", ""))
+    out = check(REVIEW_3050)
+    assert out and "titles share" in out["matches"][0]["why"], out
+
+
+def test_run_ci_pair_still_matches(worker, tmp_path):
+    """t_01a1d290dc768ba1's pair: no PR on either side, matched by the shared file."""
+    remote(tmp_path, HUB_CARD, cid="t_01a1d25511610669")
+    out = check(WORKER_DUP)
+    assert out and "run_ci.py" in out["matches"][0]["why"], out
+
+
+def test_shared_file_reason_does_not_join_different_prs(worker, tmp_path):
+    remote(tmp_path, f"{HUB_CARD} (PR #3056)", cid="t_01a1d25511610669")
+    assert check(f"{WORKER_DUP} (PR #3050)") is None
+
+
+def test_pr_numbers_forms():
+    assert ko.pr_numbers("Review #2799, PR139: x, PR 173, pr #42 and pull/3050") == {2799, 139, 173, 42, 3050}
+    assert ko.pr_numbers("@478094efef M9/M10 exact53e08858 #1 #1234567 state#12 spring 2026") == frozenset()
