From a5cb5b2f4d34aaf0ff23b0e128f0f9028a044036 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 14:41:07 +0000
Subject: [PATCH] [daveey] Verify correction replay against persistent board
 rows

Rebased main tracks comment wakes in TEMP tables. SQL trace proves write_txn clears the one leftover wake marker on replay; total_changes counts that harmless cleanup. Compare the complete persistent database dump instead, retaining the unchanged-board guarantee. No production code changed.
---
 tests/hermes_cli/test_kanban_diagnostic_correction.py | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_diagnostic_correction.py b/tests/hermes_cli/test_kanban_diagnostic_correction.py
index 76340ef777..be0e6511a3 100644
--- a/tests/hermes_cli/test_kanban_diagnostic_correction.py
+++ b/tests/hermes_cli/test_kanban_diagnostic_correction.py
@@ -61,14 +61,17 @@ def test_atomic_correction_keeps_original_comment_identity_and_audit(kanban_home
         # Unrelated history must not evict the durable replay identity.
         for _ in range(110):
             kb.add_comment(conn, task_id, "fixture-author", "Unrelated history")
-        changes = conn.total_changes
+        # write_txn clears connection-local wake markers left by add_comment;
+        # those TEMP-table deletes count in total_changes but are not board writes.
+        persisted = list(conn.iterdump())
         assert apply(
             conn, task_id, comment_uid=before["uid"], expected_body=body, expected_comment=comment,
             body_diagnostic="origin chat @session:example", comment_diagnostic="origin chat @session:example",
             reason="The two occurrences reproduce an error; neither is a delivery destination.",
             request_id="fixture-correction-1",
         ) == result
-        assert conn.total_changes == changes
+        assert list(conn.iterdump()) == persisted
+        changes = conn.total_changes
         with pytest.raises(ValueError, match="request_id conflict"):
             apply(
                 conn, task_id, comment_uid=before["uid"], expected_body=body, expected_comment=comment,
