From ea7f48117c4b21fb685f5277a639d41899b40be4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:58:18 +0000
Subject: [PATCH] kanban sync: the 410 sweep test backdates its rows before the
 rebuild

CI failed test_a_410_on_the_live_file_sweeps_own_rows_the_board_deleted_and_keeps_local_work on
949af4daf7: on a fast runner the 410 round began in the same second the test created its cards, and
the `created_at < since` guard (round-1 finding 2) correctly spares a row written in that second, so
the Board-deleted card was kept. The test now backdates its setup rows 60s, as the other sweep tests
do. A probe with the rows dated inside the rebuild second reproduces the CI assertion.
---
 tests/hermes_cli/test_kanban_sync_live_resync_sweep.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_sync_live_resync_sweep.py b/tests/hermes_cli/test_kanban_sync_live_resync_sweep.py
index eead0932c5..9643592367 100644
--- a/tests/hermes_cli/test_kanban_sync_live_resync_sweep.py
+++ b/tests/hermes_cli/test_kanban_sync_live_resync_sweep.py
@@ -87,6 +87,13 @@ def test_a_410_on_the_live_file_sweeps_own_rows_the_board_deleted_and_keeps_loca
     _board_deletes(svc, ("task_comments", dropped), ("tasks", gone))
     svc.compact(BOARD)  # the deletes are below the floor now: the live cursor gets 410
     assert int(sync.sync_state(live)["cursor"]) < svc.board(BOARD)["floor"]
+    # The rows were written well before the rebuild: on a fast runner the 410 round can begin in the same second they
+    # were created, and the `created_at < since` guard rightly spares a row written in the second the rebuild began.
+    with kbc.write_txn(live):
+        live.execute("UPDATE kanban_sync_state SET applying = 1")
+        live.execute("UPDATE tasks SET created_at = created_at - 60")
+        live.execute("UPDATE task_comments SET created_at = created_at - 60")
+        live.execute("UPDATE kanban_sync_state SET applying = 0")
 
     local = kb.create_task(live, title="unpushed local card")  # its op waits in the outbox
     _picked_up_foreign_copy(live, "t_foreign_copy")
-- 
2.43.0

