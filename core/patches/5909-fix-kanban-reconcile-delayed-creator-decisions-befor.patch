From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 09:29:58 +0000
Subject: [PATCH] fix(kanban): reconcile delayed creator decisions before
 waking cards [daveey]

Public mirror of the source commit; see the accompanying feature documentation.

---
 hermes_cli/kanban_decision_ask.py             | 13 +++++-
 tests/hermes_cli/test_kanban_decision_ask.py  |  2 +-
 .../test_kanban_decision_notice_reconcile.py  | 46 +++++++++++++++++++
 3 files changed, 58 insertions(+), 3 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_decision_notice_reconcile.py

diff --git a/hermes_cli/kanban_decision_ask.py b/hermes_cli/kanban_decision_ask.py
index d9b4b7fffd1..1f479e5b01f 100644
--- a/hermes_cli/kanban_decision_ask.py
+++ b/hermes_cli/kanban_decision_ask.py
@@ -35,12 +35,21 @@ def notice_text(payload: dict) -> str:
     ask = str(payload.get("why") or payload.get("reason") or "")
     if len(ask) > 6000:
         ask = ask[:4500] + "\n[... full text in the card comments ...]\n" + ask[-1500:]
+    reconcile = (
+        "\nBefore acting, read the card's current status and newer owner decisions. "
+        "If already answered or superseded, do not post another waking comment or reopen the decision. "
+        "A running agent turn or administrative run is not product progress; report the changed acceptance "
+        "gate, or say it is unchanged. Preserve safety stops, dependencies and admission limits."
+    )
     if isinstance(payload.get("actionability"), dict) and payload["actionability"].get("kind") == "administrative_only":
         return ("Administrative reconsideration for the accountable owner (not a request for the user):\n" + ask
+                + reconcile
                 + "\nComments record a decision only; they never release or rerun the root scope. "
                 "Use the existing supported authority and admission gates; a notice grants neither.")
-    return ("Decision for the creator agent (not a request for the user). This card is parked until you decide:\n" + ask
-            + "\nAnswer with a comment on the card (kanban_comment); the comment wakes it. "
+    return ("Decision notice for the creator agent (not a request for the user):\n" + ask
+            + reconcile
+            + "\nAnswer with a comment on the card (kanban_comment) only if the decision is still outstanding; "
+            "a comment may wake the card, but grants no release authority. "
             "Retain agent recovery on quota/offline failures. Escalate to the user only for a concrete human-only "
             "action, after try-to-unblock and generate-unblock-card, with a meaningful scope and evidence.")
 
diff --git a/tests/hermes_cli/test_kanban_decision_ask.py b/tests/hermes_cli/test_kanban_decision_ask.py
index 8c648e0e513..a007863996c 100644
--- a/tests/hermes_cli/test_kanban_decision_ask.py
+++ b/tests/hermes_cli/test_kanban_decision_ask.py
@@ -551,7 +551,7 @@ def test_an_ask_that_cannot_wake_now_is_retried_never_written_passively(kanban_h
     assert not wakes and not rows  # handed back, not written passively
     later = now + (60 if busy_slots else 3600)  # a slot frees / the budget's hour slides
     wakes, rows = _sweep(chat, later)
-    assert len(wakes) == 1 and "parked until you decide" in wakes[0] and not rows, (wakes, rows)
+    assert len(wakes) == 1 and "current status and newer owner decisions" in wakes[0] and not rows, (wakes, rows)
     ku._reset_wake_budget_for_tests()
 
 
diff --git a/tests/hermes_cli/test_kanban_decision_notice_reconcile.py b/tests/hermes_cli/test_kanban_decision_notice_reconcile.py
new file mode 100644
index 00000000000..6232f68b301
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_decision_notice_reconcile.py
@@ -0,0 +1,46 @@
+"""Decision notices are historical prompts, not fresh release authority."""
+from __future__ import annotations
+
+import pytest
+
+from hermes_cli.kanban_decision_ask import notice_text
+
+
+@pytest.mark.parametrize("surface", ["shared", "gateway", "tui"])
+@pytest.mark.parametrize("administrative", [False, True])
+def test_delayed_decision_notice_requires_reconciliation(surface, administrative):
+    payload = {"why": "Select global identity protocol and milestones A-D."}
+    if administrative:
+        payload["actionability"] = {"kind": "administrative_only"}
+    if surface == "gateway":
+        from gateway import kanban_watchers_notifier as gn
+        from types import SimpleNamespace
+        _, text, _ = gn._EVENT_FORMATTERS["decision_requested"](
+            SimpleNamespace(payload=payload), SimpleNamespace(head="fixture"))
+    elif surface == "tui":
+        from tui_gateway import session_notifications as sn
+        _, render = sn._KANBAN_EVENT_FORMATTERS["decision_requested"]
+        text = render(None, payload, "t")
+    else:
+        text = notice_text(payload)
+    assert payload["why"] in text
+    assert "current status and newer owner decisions" in text
+    assert "already answered or superseded" in text
+    assert "do not post another waking comment" in text
+    assert "not product progress" in text
+    assert "This card is parked until you decide" not in text
+    if administrative:
+        assert "never release or rerun the root scope" in text
+    else:
+        assert "only if the decision is still outstanding" in text
+        assert "kanban_comment" in text
+        assert "concrete human-only" in text
+
+
+def test_notice_reconciliation_keeps_question_fallback_and_bounds():
+    text = notice_text({"reason": "Preserve stopped scope; no retry."})
+    assert "Preserve stopped scope; no retry." in text
+    long = notice_text({"why": "A" * 7000 + "END"})
+    assert "full text in the card comments" in long
+    assert "END" in long
+    assert "current status and newer owner decisions" in long
