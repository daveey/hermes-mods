From 3c0dcd7062039b043aed4e90cb0829180196ac43 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 12:07:10 +0000
Subject: [PATCH] [daveey] kanban: parent_missing self-clear handles a
 parentless child and tells the repair card

Two follow-ups from the independent review of PR #2104 (review 5889862433) on
kanban_db_graph.clear_found_parents:

1. No parents left. If every parent link is removed while the child is
   detector-blocked (source=parent_missing, no human_request), parent_states
   returns [] and clear_found_parents returned early on `not states`, so the
   child stayed blocked with nothing to wait on. An empty parent set now counts
   as resolved: the child returns to todo and the same readiness pass promotes
   it (all() over no parents). Blocks from other sources with no parents still
   stay blocked.

2. Repair card left ready. When the block clears, the "Recover missing
   dependencies for <child>" card (repair_task_id from the blocked event) stayed
   ready with no signal, so a worker could still investigate a parent that is
   now present. In the same readiness txn, clear_found_parents now comments on
   the repair card (only while it is not done/archived) that the block cleared
   via parent_found, naming the child and blocked_event_id. Once per cleared
   block: a later pass sees the child unblocked and does nothing.

Tests (tests/hermes_cli/test_kanban_parent_missing_self_clear.py), RED on main
2b80c7272d: test_every_parent_unlinked_returns_the_detector_blocked_child_to_ready
(blocked != ready) and test_clearing_the_block_comments_on_the_open_repair_card
(no comment). Guards: a parentless non-detector block stays blocked; a done
repair card gets no comment. All 26 test files touching parent_missing /
kanban_db_graph pass (334 tests); scripts/check --base origin/main ok.

Card t_01a1d4964e833458.
---
 hermes_cli/kanban_db_graph.py                 | 26 ++++++++--
 .../test_kanban_parent_missing_self_clear.py  | 52 +++++++++++++++++++
 2 files changed, 74 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_db_graph.py b/hermes_cli/kanban_db_graph.py
index ebc67fe1bd..d2faabc773 100644
--- a/hermes_cli/kanban_db_graph.py
+++ b/hermes_cli/kanban_db_graph.py
@@ -79,7 +79,9 @@ def clear_found_parents(conn: sqlite3.Connection, row, *, remote: bool) -> str:
 
     Only the detector's own block is cleared: the child's newest lifecycle event must be the ``blocked`` with
     ``source`` 'parent_missing', with no human request on the card. A later hand, policy or
-    breaker block, or a block from any other source, stays for its owner. The repair card is left to finish.
+    breaker block, or a block from any other source, stays for its owner. A child left with no parent link at all
+    also clears (nothing is missing). The repair card is left to finish, with a comment (while still open) saying
+    the block cleared via parent_found.
     2026-11-13, laptop-1: t_01a1d0ea6db6c158 stayed blocked hours after its parent was mirrored done. [daveey]"""
     from hermes_cli import kanban_db as kb
 
@@ -92,22 +94,38 @@ def clear_found_parents(conn: sqlite3.Connection, row, *, remote: bool) -> str:
     ).fetchone()
     if last is None or _event_field(last["payload"], "source") != "parent_missing":  # only the detector's block
         return status
-    states = kb.parent_states(conn, task_id, remote=remote)
-    if not states or any(st is None for _pid, st in states):
+    # No parent left (every link removed while blocked) counts as resolved: nothing is missing any more.
+    if any(st is None for _pid, st in kb.parent_states(conn, task_id, remote=remote)):
         return status
     cur = conn.execute(
         "UPDATE tasks SET status = 'todo' WHERE id = ? AND status = 'blocked' AND human_request IS NULL", (task_id,),
     )
     if cur.rowcount != 1:
         return status
+    repair_id = _event_field(last["payload"], "repair_task_id")
     kb._append_event(conn, task_id, "unblocked", {
         "status": "todo", "source": "parent_found", "cleared_block": "parent_missing",
         "blocked_event_id": last["id"], "parents": _event_field(last["payload"], "parents"),
-        "repair_task_id": _event_field(last["payload"], "repair_task_id"),
+        "repair_task_id": repair_id,
     })
+    _tell_repair_card(conn, repair_id, task_id, last["id"])
     return "todo"
 
 
+def _tell_repair_card(conn: sqlite3.Connection, repair_id, task_id: str, blocked_event_id: int) -> None:
+    """In the caller's txn: note on the still-open repair card that its child's block cleared, so its worker does
+    not investigate a parent that is back. A finished or absent repair card gets nothing. [daveey]"""
+    from hermes_cli import kanban_db as kb
+
+    if not isinstance(repair_id, str) or kb._task_status(conn, repair_id) in (None, "done", "archived"):
+        return
+    kb.add_comment(conn, repair_id, "kanban-dispatcher", (
+        f"The parent_missing block on {task_id} cleared via parent_found (blocked_event_id {blocked_event_id}): "
+        "every parent is present again (or no parent link remains), so the child is back in todo. "
+        "Nothing is left to recover for that block; confirm and close this card."
+    ))
+
+
 def report_deferred_pass(conn: sqlite3.Connection, fresh: dict) -> None:
     """After a readiness pass: the children :func:`note_missing_parents` deferred because the replica is not at the
     feed head get one INFO line per board per stale replica stamp (``kanban_replica_freshness.report_deferred``)."""
diff --git a/tests/hermes_cli/test_kanban_parent_missing_self_clear.py b/tests/hermes_cli/test_kanban_parent_missing_self_clear.py
index 59d548a69a..f8af8113bd 100644
--- a/tests/hermes_cli/test_kanban_parent_missing_self_clear.py
+++ b/tests/hermes_cli/test_kanban_parent_missing_self_clear.py
@@ -124,3 +124,55 @@ def test_a_parent_missing_block_with_one_parent_still_missing_stays_blocked(loca
         local.execute("INSERT INTO tasks (id, title, status, created_at) VALUES ('t_a', 'a', 'done', 0)")
     kb.recompute_ready(local)
     assert kb.get_task(local, child).status == "blocked"  # t_b is still missing
+
+
+def test_every_parent_unlinked_returns_the_detector_blocked_child_to_ready(local):
+    """PR #2104 review: with no parent left ``parent_states`` is ``[]``; the child must not stay blocked on nothing."""
+    child = _blocked_on_missing(local, "t_late")
+    assert kb.unlink_tasks(local, "t_late", child)
+    assert kb.parent_states(local, child) == []
+    kb.recompute_ready(local)
+    assert kb.get_task(local, child).status == "ready"  # before the fix: blocked with nothing to wait on
+    payload = json.loads(support._events(local, child, "unblocked")[-1]["payload"])
+    assert payload["cleared_block"] == "parent_missing" and payload["parents"] == ["t_late"]
+
+
+def test_a_hand_block_with_no_parents_stays_blocked(local):
+    child = kb.create_task(local, title="dependent", assignee="worker")
+    with kbc.write_txn(local):
+        local.execute("UPDATE tasks SET status = 'blocked', block_kind = 'transient' WHERE id = ?", (child,))
+        kb._append_event(local, child, "blocked", {"kind": "transient", "source": "breaker", "reason": "x"})
+    kb.recompute_ready(local)
+    assert kb.get_task(local, child).status == "blocked"
+
+
+def _repair_comments(conn, repair):
+    return [c.body for c in kb.list_comments(conn, repair)]
+
+
+def test_clearing_the_block_comments_on_the_open_repair_card(local):
+    """PR #2104 review: the repair card is told the block cleared, so its worker does not chase a present parent."""
+    child = _blocked_on_missing(local, "t_late")
+    repair = _repair(local, child)
+    [(blocked_id,)] = local.execute(
+        "SELECT id FROM task_events WHERE task_id = ? AND kind = 'blocked' "
+        "AND json_extract(payload, '$.source') = 'parent_missing'", (child,)).fetchall()
+    with kbc.write_txn(local):
+        local.execute("INSERT INTO tasks (id, title, status, created_at) VALUES ('t_late', 'late', 'done', 0)")
+    kb.recompute_ready(local)
+    assert kb.get_task(local, child).status == "ready"
+    [body] = _repair_comments(local, repair)  # before the fix: no comment, the repair card reads as live work
+    assert child in body and "parent_found" in body and str(blocked_id) in body
+    kb.recompute_ready(local)
+    assert len(_repair_comments(local, repair)) == 1  # once per cleared block
+
+
+def test_a_finished_repair_card_gets_no_comment(local):
+    child = _blocked_on_missing(local, "t_late")
+    repair = _repair(local, child)
+    with kbc.write_txn(local):
+        local.execute("UPDATE tasks SET status = 'done' WHERE id = ?", (repair,))
+        local.execute("INSERT INTO tasks (id, title, status, created_at) VALUES ('t_late', 'late', 'done', 0)")
+    kb.recompute_ready(local)
+    assert kb.get_task(local, child).status == "ready"
+    assert _repair_comments(local, repair) == []
