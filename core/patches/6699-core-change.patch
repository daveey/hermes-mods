diff --git a/hermes_cli/kanban_allowance_maintenance.py b/hermes_cli/kanban_allowance_maintenance.py
new file mode 100644
index 0000000000000000000000000000000000000000..a7b0ad4e23a541b60a483f7a100772ce5468bde0
--- /dev/null
+++ b/hermes_cli/kanban_allowance_maintenance.py
@@ -0,0 +1,111 @@
+"""Home-owned exhaustion recovery before dispatch capacity gates. [daveey]
+
+Private Board observations never authorize execution. Exhaustion is monotonic for
+one exact override; a successor override invalidates it. Cadence/cursor state is
+only bounded process-local I/O pacing, never a spending counter or durable proof.
+"""
+from collections import OrderedDict
+import time
+
+from hermes_cli import kanban_allowance_observation as observation
+
+BATCH = 8
+CADENCE = 60.0
+MAX_BOARDS = 64
+_CURSORS = OrderedDict()
+
+
+HELD_NOTE = ("The Board still holds this card's reviewer allowance ({state}, review {review}), so the newer budget "
+             "does not let it run: only a human operator's `hermes kanban release` replaces that allowance.")
+
+
+def triage(conn, task_id, observed):
+    from hermes_cli.kanban_wake_check import foreign_copy
+    if observed is None or observed.remaining != 0 or foreign_copy(conn, task_id):
+        return False
+    note = "The Board's ten fresh-lease reviewer allowance is exhausted; the owner must decide the next round."
+    return _hold(conn, task_id, lambda: observation.current(conn, task_id, observed), note,
+                 {**observed.expected, "remaining": 0, "board": observed.board})
+
+
+def triage_stuck(conn, task_id, held):
+    """Decided but stuck: the Board refuses every grant of a card whose newest budget is generic."""
+    from hermes_cli.kanban_wake_check import foreign_copy
+    if held is None or foreign_copy(conn, task_id):
+        return False
+    return _hold(conn, task_id, lambda: observation.still_stuck(conn, task_id, held),
+                 HELD_NOTE.format(state=held.state, review=held.review_uid),
+                 {"basis": observation.allowance.BASIS, "review_uid": held.review_uid, "state": held.state,
+                  "board": held.board, "superseded": False})
+
+
+def _hold(conn, task_id, valid, note, evidence):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_spend_budget as budget
+    from hermes_cli import kanban_spend_decision as decision
+    from hermes_cli.kanban_wake_check import foreign_copy
+    with kb.write_txn(conn):
+        if not valid() or foreign_copy(conn, task_id):
+            return False
+        if decision.pending(conn, task_id):
+            return False  # preserve that episode; ordinary decision maintenance owns its notice
+        now = int(time.time())
+        changed = conn.execute(
+            "UPDATE tasks SET status='triage',claim_lock=NULL,claim_expires=NULL,worker_pid=NULL "
+            "WHERE id=? AND status IN ('ready','review') AND current_run_id IS NULL AND " + budget._UNCLAIMED,
+            (task_id, now)).rowcount
+        if changed != 1:
+            return False
+        spent = budget.spend(conn, task_id, as_of=now + 1)
+        limits = budget.card_limits(conn, task_id, budget.limits())
+        kb._append_event(conn, task_id, budget.EVENT, {
+            "limit": "runs", "runs": spent.runs, "since": spent.since, "tokens": spent.tokens,
+            "runs_with_usage": spent.reported, "cost_usd": spent.cost_usd, "override": True,
+            "limits": {"runs": limits.runs, "cache_read_tokens": limits.cache_read_tokens}, "reason": note,
+            "allowance": evidence})
+        kb.add_comment(conn, task_id, budget.AUTHOR, budget._comment(task_id, note), system=True)
+        decision.safe_ensure_producer(conn, task_id)
+    return True
+
+
+def sweep(conn):
+    """At most eight reads and five seconds per minute per DB, outside write transactions."""
+    from hermes_cli import kanban_db_sync as sync
+    from hermes_cli.kanban_wake_check import foreign_copy
+    if conn.in_transaction or sync.board_mode(conn) != "primary":
+        return []
+    state = sync.sync_state(conn)
+    if not state:
+        return []
+    path = next((row[2] for row in conn.execute("PRAGMA database_list") if row[1] == "main"), "")
+    key = (path, state["board_id"])
+    now = time.monotonic()
+    after, next_at = _CURSORS.get(key, ("", 0.0))
+    if now < next_at:
+        return []
+    _CURSORS[key] = (after, now + CADENCE)
+    _CURSORS.move_to_end(key)
+    while len(_CURSORS) > MAX_BOARDS:
+        _CURSORS.popitem(last=False)
+    rows = conn.execute(
+        "SELECT t.id FROM tasks t WHERE t.status IN ('ready','review') AND t.current_run_id IS NULL "
+        "AND t.id>? AND EXISTS (SELECT 1 FROM task_events e WHERE e.task_id=t.id "
+        "AND e.kind='spend_budget_set' AND json_valid(e.payload) "
+        "AND json_extract(e.payload,'$.runs_basis')='board_lease_allowance_v1') ORDER BY t.id LIMIT ?",
+        (after, BATCH)).fetchall()
+    deadline, held = now + observation.READ_SECONDS, []
+    for (task_id,) in rows:
+        if time.monotonic() >= deadline:
+            break
+        after = task_id
+        if foreign_copy(conn, task_id):
+            continue
+        # One read per card: an exhausted exact allowance, else a generic newest budget the Board still refuses.
+        if (triage(conn, task_id, observation.read(conn, task_id, deadline=deadline))
+                or triage_stuck(conn, task_id, observation.stuck(conn, task_id, deadline=deadline))):
+            held.append(task_id)
+    # Wrap only after exhausting this bounded page, not after a deadline-shortened pass.
+    if not rows or (len(rows) < BATCH and after == rows[-1][0]):
+        after = ""
+    _CURSORS[key] = (after, now + CADENCE)
+    return held
diff --git a/hermes_cli/kanban_allowance_observation.py b/hermes_cli/kanban_allowance_observation.py
new file mode 100644
index 0000000000000000000000000000000000000000..c9a6ba7437ff856bc8513e363b8aa039aafffd4e
--- /dev/null
+++ b/hermes_cli/kanban_allowance_observation.py
@@ -0,0 +1,156 @@
+"""Bounded Board allowance diagnostics for decision recovery, never claim authority. [daveey]
+
+Read only outside SQLite transactions. An observation is usable only for the same
+Board and override, within its original request deadline. Missing/malformed/failed
+reads are unknown, not exhausted and never permission to claim. The real lease
+endpoint remains the sole spending authority on every claim.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import time
+
+from hermes_cli import kanban_spend_allowance as allowance
+
+READ_SECONDS = 5.0
+
+
+@dataclass(frozen=True)
+class Observation:
+    board: str
+    expected: dict
+    remaining: int
+    deadline: float
+
+
+def _remaining(reply, board, task, want):
+    if not isinstance(reply, dict) or reply.get("board") != board:
+        return None
+    data = reply.get("allowance")
+    if not isinstance(data, dict):
+        return None
+    coordinates = {"runs_basis": want["basis"], "task": task, "review_uid": want["review_uid"],
+                   "budget_event_uid": want["budget_event_uid"], "state": "active"}
+    if any(data.get(key) != value for key, value in coordinates.items()):
+        return None
+    if any(not isinstance(data.get(key), str) or not data[key] for key in ("home", "episode")):
+        return None
+    runs, used, remaining = (data.get(key) for key in ("runs", "used", "remaining"))
+    if (any(type(value) is not int for value in (runs, used, remaining)) or runs != allowance.BOARD_RUNS
+            or not 0 <= used <= runs or remaining != runs - used):
+        return None
+    return remaining
+
+
+def read(conn, task_id, *, deadline: float | None = None) -> Observation | None:
+    """One authenticated bounded read; refuse transaction callers before opening transport."""
+    from hermes_cli import kanban_db_sync as sync
+    from hermes_cli import kanban_sync_client as client
+    if conn.in_transaction:
+        return None
+    want, state = allowance.expected(conn, task_id), sync.sync_state(conn)
+    if want is None or not state:
+        return None
+    now = time.monotonic()
+    deadline = min(now + READ_SECONDS, deadline) if deadline is not None else now + READ_SECONDS
+    if deadline <= now:
+        return None
+    hub = None
+    try:
+        hub = client.Hub(client.load_identity(), deadline=deadline)
+        remaining = _remaining(hub.reviewer_allowance(state["board_id"], task_id), state["board_id"], task_id, want)
+        if remaining is None or time.monotonic() >= deadline:
+            return None
+        return Observation(state["board_id"], want, remaining, deadline)
+    except (client.SyncUnavailable, client.HubError, OSError, TimeoutError, ValueError):
+        return None  # unknown diagnostic; the ordinary exact-debit claim guard still refuses
+    finally:
+        if hub is not None:
+            hub.close()
+
+
+def current(conn, task_id, observed: Observation | None) -> bool:
+    """Recheck local identity and freshness under the caller's write transaction; no I/O."""
+    from hermes_cli import kanban_db_sync as sync
+    if observed is None or time.monotonic() >= observed.deadline:
+        return False
+    state = sync.sync_state(conn)
+    return bool(state and state["board_id"] == observed.board and allowance.expected(conn, task_id) == observed.expected)
+
+
+@dataclass(frozen=True)
+class Held:
+    """The Board still holds a private allowance although the card's newest local budget is a generic one."""
+    board: str
+    budget: object  # the newest local override row at read time (None: no override)
+    review_uid: str
+    state: str  # active | invalidated
+    deadline: float
+
+
+def _budget(conn, task_id):
+    row = allowance._newest(conn, task_id)
+    return tuple(row) if row is not None else None
+
+
+def _held(reply, board, task):
+    """None (unknown), ``{}`` (the Board holds no allowance) or its validated active/invalidated allowance."""
+    if not isinstance(reply, dict) or reply.get("board") != board or "allowance" not in reply:
+        return None
+    data = reply["allowance"]
+    if data is None:
+        return {}
+    if (not isinstance(data, dict) or data.get("runs_basis") != allowance.BASIS or data.get("task") != task
+            or data.get("state") not in ("active", "invalidated")
+            or any(not isinstance(data.get(key), str) or not data[key] for key in ("review_uid", "budget_event_uid"))):
+        return None
+    return data
+
+
+def board_state(conn, task_id, *, deadline: float | None = None):
+    """What the Board itself holds for the card, whatever the local budget says: None when unknown, ``{}`` when
+    it holds none, else its allowance. One authenticated bounded read, never under a transaction, never authority."""
+    from hermes_cli import kanban_db_sync as sync
+    from hermes_cli import kanban_sync_client as client
+    state = None if conn.in_transaction else sync.sync_state(conn)
+    if not state or sync.board_mode(conn) != "primary":
+        return None
+    now = time.monotonic()
+    deadline = min(now + READ_SECONDS, deadline) if deadline is not None else now + READ_SECONDS
+    if deadline <= now:
+        return None
+    hub = None
+    try:
+        hub = client.Hub(client.load_identity(), deadline=deadline)
+        seen = _held(hub.reviewer_allowance(state["board_id"], task_id), state["board_id"], task_id)
+        return None if time.monotonic() >= deadline else seen
+    except (client.SyncUnavailable, client.HubError, OSError, TimeoutError, ValueError):
+        return None
+    finally:
+        if hub is not None:
+            hub.close()
+
+
+def stuck(conn, task_id, *, deadline: float | None = None) -> Held | None:
+    """A decided-but-stuck card: a generic budget is newest locally (cumulative accounting, so the claim states
+    no allowance) while the Board still holds one and refuses every such grant. Unknown reads are not stuck."""
+    from hermes_cli import kanban_db_sync as sync
+    if conn.in_transaction or allowance.state(conn, task_id) is not None or not allowance.history(conn, task_id):
+        return None
+    now = time.monotonic()
+    deadline = min(now + READ_SECONDS, deadline) if deadline is not None else now + READ_SECONDS
+    seen = board_state(conn, task_id, deadline=deadline)
+    if not seen:
+        return None
+    return Held(sync.sync_state(conn)["board_id"], _budget(conn, task_id), seen["review_uid"], seen["state"],
+                deadline)
+
+
+def still_stuck(conn, task_id, held: Held | None) -> bool:
+    """Recheck under the caller's write transaction; no I/O. A newer budget of any kind invalidates the reading."""
+    from hermes_cli import kanban_db_sync as sync
+    if held is None or time.monotonic() >= held.deadline:
+        return False
+    state = sync.sync_state(conn)
+    return bool(state and state["board_id"] == held.board and allowance.state(conn, task_id) is None
+                and _budget(conn, task_id) == held.budget)
