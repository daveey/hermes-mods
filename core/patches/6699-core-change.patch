+def _history(conn, tid, n):
+    now = int(time.time()) + 10
+    with kbc.write_txn(conn):
+        for i in range(n):
+            conn.execute("INSERT INTO task_runs (task_id, status, outcome, started_at, ended_at) "
+                         "VALUES (?, 'crashed', 'crashed', ?, ?)", (tid, now + 200 * i, now + 200 * i + 120))
