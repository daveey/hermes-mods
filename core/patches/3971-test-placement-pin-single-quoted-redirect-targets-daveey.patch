From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 23:45:56 +0000
Subject: [PATCH] test(placement): pin single-quoted redirect targets [daveey]

Close PR #2703 mutation gap: bare cd with one or two single-quoted spaced redirect targets retains home-state placement; a repo operand remains portable with and without hub:read. Test-only, appended separately from PR #2800 tables. GREEN 482 tests across three affected files, no skips; mutation removing the single-quoted redirect alternative yields 2 failed / 84 passed in home forms. All 20 scripts/check gates pass. Task t_01a1d74649358ecf.
---
 tests/hermes_cli/test_kanban_state_path_home_forms.py | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_state_path_home_forms.py b/tests/hermes_cli/test_kanban_state_path_home_forms.py
index 49111ff340..b8fc4d2d0f 100644
--- a/tests/hermes_cli/test_kanban_state_path_home_forms.py
+++ b/tests/hermes_cli/test_kanban_state_path_home_forms.py
@@ -181,3 +181,14 @@ def test_each_cd_home_span_names_its_own_relative_state_path(tmp_path, monkeypat
     got = [v[:3] for v in hm._state_path(kp.HERMES_STATE_PATH, _hit(body), "worker-2", hm._Probe())]
     assert got == [("queue", "b", "~/.hermes/logs/x.log"),
                    ("queue", "artifact-not-here", "~/.hermes/kanban/workspaces/t_x/f")]
+
+
+@pytest.mark.parametrize("operand, expected", [("", "home gateway marker"), (" repo", None)])
+@pytest.mark.parametrize("redirect", ["2>'x y'", "2>'x y' 3>'z w'"])
+def test_single_quoted_redirect_target_preserves_cd_home_placement(attested, redirect, operand, expected):
+    # Quotes keep each spaced target one redirect word. Only a real cd operand changes the destination.
+    cfg, _, _ = attested
+    body = f"cd {redirect}{operand} && cat .hermes/.env"
+    assert bool(_hit(body)) == (expected is not None)
+    assert roots.reason(body, cfg) == expected
+    assert roots.reason(body, cfg, requires=()) == expected
