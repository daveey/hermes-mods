From 5391a156b8a617e4c28cee583b2d5f5fe071f10d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:21:35 +0000
Subject: [PATCH] [daveey] placement: a cd nested in ( ), $( ) or `...` never
 ends the home span; pushd -n neither

PR #2649 review 5898066605 nit (card t_01a1d6c72922ed5a). The home-relative `.hermes` span
(cd home -> next span-ending cd) still ended at a cd that changes no cwd of this shell:

- a chained cd inside a subshell or $( ): `cd ~ && (cd repo && cd sub && make) && cat .hermes/.env`,
  `x=$(cd a && cd b && pwd)`: only the first `(`-preceded cd was skipped; the `&& cd` after it ended the span;
- a backtick substitution `x=\`cd repo && pwd\``;
- `pushd -n repo` (only edits the stack).

All routed a card naming hub state to the worker pool (fail-open, not a regression vs main).

Fix: a balanced `( )` group (3 deep) or a backtick substitution opened after `=` or `"` (a markdown code
span is not one) is one atomic span step, so no cd inside it ends the span. Unclosed or deeper groups read as
plain text, as before. A cd home inside still stops the group, so spans stay disjoint. A state path inside the
nesting (`cd ~ && (x=$(cat .hermes/.env))`) still matches through _NEST_PREFIX, where a chained cd in the opened
group ends it like a span. `pushd -n` no longer ends the span.

Linear: atomic/possessive groups, no alternative overlaps. Probe (scratch): 7 adversarial shapes at 2000 vs
8000 units scale ~4x (max 0.47 s at 287 KB); a 640 KB single line of unclosed `( a=\`` took 1.6 s vs 0.46 s at
160 KB. New timing rows for nested bodies (180 KB-class, < 1 s) are green; the existing ones stay green.

RED on main (5cf6f649f05): 8 of the new rows fail (7 decision rows, 1 raw-regex backtick row).
GREEN: test_kanban_placement_home_spellings.py + test_kanban_state_path_home_forms.py 140 passed; all 85 test
files importing kanban_placement / kanban_home_marker_placement: 2519 passed.
---
 hermes_cli/kanban_placement.py                | 23 +++++++-
 .../test_kanban_placement_home_spellings.py   | 58 +++++++++++++++++++
 2 files changed, 78 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 0468c9206a..b91aa82fa7 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -602,8 +602,25 @@ _REDIR = (r"(?:[ \t]*&?>|[ \t]+\d+>)[>|]?[ \t]*(?:&[ \t]*)?"
 _CMD_END = r"(?=(?:" + _REDIR + r")*(?:[ \t]*(?:$|[\n;|)]|&(?!>))|[ \t]+#))"
 _CD_HOME = (r"(?<![\w./-])(?-i:cd(?:[ \t]+" + HOME_PREFIX + r"/?)?|pushd[ \t]+" + HOME_PREFIX + r"/?)" + _CMD_END)
 _CHDIR = (r"(?:" + _CD_HOME + r"|(?:(?<=\n)|&&|\|\||;|`|\{)[ \t]*"
-          r"(?-i:cd(?![\w.-])(?![ \t]+-" + _CMD_END + r")|pushd(?![\w.-])(?![ \t]+[+-]\d+" + _CMD_END + r")(?!"
-          + _CMD_END + r"))(?![ \t]+[\"']?(?:\./)?\.hermes(?![\w.-])))")
+          r"(?-i:cd(?![\w.-])(?![ \t]+-" + _CMD_END + r")|pushd(?![\w.-])(?![ \t]+[+-]\d+" + _CMD_END + r")"
+          r"(?![ \t]+-n(?![\w-]))(?!" + _CMD_END + r"))(?![ \t]+[\"']?(?:\./)?\.hermes(?![\w.-])))")
+# PR #2649 review 5898066605 nit: a cd nested in a subshell ``( )``, ``$( )`` or a backtick substitution (one
+# opened after ``=`` or ``"``; a markdown code span is not one) never ends the span, however many cds it chains.
+# A balanced group up to _NEST_DEPTH deep is one atomic span step; past that, or unclosed, its chars are plain
+# text again (today's behaviour). A cd home inside still stops it, so spans stay disjoint and the scan linear.
+# The state path may sit inside the nesting (``cd ~ && (x=$(cat .hermes/.env))``): _NEST_PREFIX opens groups
+# before the tail, and a chained cd inside an opened group ends that prefix as it would a span (it changes the
+# group's own cwd), so an unclosed ``(``/backtick reads as before.
+_NEST_DEPTH = 3
+_NO_HOME = r"(?!" + _CD_HOME + r")"
+_TICK = r"(?<=[=\"])`"
+_TICK_GROUP = _TICK + r"(?:" + _NO_HOME + r"[^`])*+`"
+_PARENS = r"\((?>" + _TICK_GROUP + r"|" + _NO_HOME + r"[^()])*+\)"
+for _level in range(_NEST_DEPTH - 1):
+    _PARENS = r"\((?>" + _PARENS + r"|" + _TICK_GROUP + r"|" + _NO_HOME + r"[^()])*+\)"
+_NESTED = r"(?:" + _PARENS + r"|" + _TICK_GROUP + r")"
+_NEST_PREFIX = (r"(?:\((?:(?>" + _NESTED + r"|(?!" + _CHDIR + r")[^()]))*?|" + _TICK + r"(?:(?!" + _CHDIR
+                + r")[^`])*?){0," + str(_NEST_DEPTH) + r"}")
 _CD_INTO = r"(?<![\w./-])(?-i:cd|pushd)[ \t]+[\"']?"
 _CODE_TREE = r"(?:hermes-agent|repos|bin)"
 _STATE_SUB = r"\.hermes/(?!" + _CODE_TREE + r"(?:/|\b))[\w.-]"
@@ -613,7 +630,7 @@ _STATE_DIR = (r"\.hermes/?[\"']?" + _CMD_END + r"(?!(?:" + _REDIR + r")*[ \t]*(?
               r"(?-i:cd|pushd)[ \t]+[\"']?(?:\./)?"
               + _CODE_TREE + r"(?![\w.-]))")
 HERMES_STATE_PATH = (r"(?:" + HOME_PREFIX + r"/" + _STATE_SUB + r"|" + _CD_INTO + HOME_PREFIX + r"/" + _STATE_DIR +
-                     r"|" + _CD_HOME + r"(?:(?!" + _CHDIR + r")[\s\S])*?"
+                     r"|" + _CD_HOME + r"(?>" + _NESTED + r"|(?!" + _CHDIR + r")[\s\S])*?" + _NEST_PREFIX +
                      r"(?:(?<![\w./~$}-])(?:\./)?" + _STATE_SUB + r"|" + _CD_INTO + r"(?:\./)?" + _STATE_DIR + r"))")
 HOST_WORKTREE_PATH = r"(?:~|/home/[^/\s]+)/code/_wt(?:-[\w-]+)?(?:/|\b)"
 # Any home-rooted ``<dir>/.worktrees`` (``~/code/<repo>/.worktrees/t_*``, ``~/.hermes/hermes-agent/.worktrees``):
diff --git a/tests/hermes_cli/test_kanban_placement_home_spellings.py b/tests/hermes_cli/test_kanban_placement_home_spellings.py
index b3ae37ee40..3c2400ffa8 100644
--- a/tests/hermes_cli/test_kanban_placement_home_spellings.py
+++ b/tests/hermes_cli/test_kanban_placement_home_spellings.py
@@ -126,6 +126,27 @@ def test_an_uppercase_cd_does_not_end_the_span(body):
     assert d["where"] == "local" and "runs_on" not in d, d
 
 
+# PR #2649 review 5898066605 nit: a cd nested in a subshell, ``$( )`` or a backtick substitution changes no cwd of
+# this shell, however many cds the nested command chains; ``pushd -n`` only edits the stack.
+@pytest.mark.parametrize("body", [
+    "Run pytest, then cd ~ && (cd repo && cd sub && make) && cat .hermes/.env",
+    "Run pytest, then cd ~ && x=$(cd a && cd b && pwd) && cat .hermes/.env",
+    "Run pytest, then cd ~\n(\n  cd repo\n  cd sub; make\n)\ncat .hermes/.env",
+    "Run pytest, then cd ~ && x=$(cd a && y=$(cd b; cd c) && cd d) && cat .hermes/.env",
+    "Run pytest, then cd ~ && x=`cd repo && pwd` && cat .hermes/.env",
+    'Run pytest, then cd ~ && echo "`cd repo; cd sub; pwd`" && cat .hermes/.env',
+    "Run pytest, then cd ~ && pushd -n repo && cat .hermes/.env",
+    # The state path inside the nesting still names home state, as before.
+    "Run pytest, then cd ~ && (x=$(cat .hermes/.env))",
+    "Run pytest, then cd ~ && x=$(cd a && y=$(cat .hermes/.env))",
+])
+def test_a_nested_cd_never_ends_the_span(body):
+    from hermes_cli import kanban_placement as kp
+    assert re.search(kp.HERMES_STATE_PATH, body, re.IGNORECASE)  # raw text too: here backtick spans are not stripped
+    d = helpers._hub({"title": "Maintenance", "body": body})
+    assert d["where"] == "local" and "runs_on" not in d, d
+
+
 @pytest.mark.parametrize("body", [
     "Run pytest, then label the backup CD; then cat .hermes/notes.md in the repo",
     "Run pytest, then label the backup CD ~/.hermes; it holds the hermes-agent tree",
@@ -134,6 +155,43 @@ def test_an_uppercase_cd_is_no_home_marker(body):
     assert helpers._hub({"title": "Maintenance", "body": body})["runs_on"] == ["machine:worker-1"]
 
 
+@pytest.mark.parametrize("body", [
+    "Run pytest, then cd ~ && (cd repo && make) && cd repo && cat .hermes/notes.md",
+    "Run pytest, then cd ~ && x=$(cd a && cd b) && cd repo && cat .hermes/notes.md",
+    "Run pytest, then cd ~ && x=`cd a && pwd` && cd repo && cat .hermes/notes.md",
+    "Run pytest, then cd ~ && pushd -n x && pushd repo && cat .hermes/notes.md",
+    "Run pytest, then cd ~ && echo :( && cd repo && cat .hermes/notes.md",  # an unclosed paren is no subshell
+    "Run pytest, then cd ~ && x=`cd a && cd repo && cat .hermes/notes.md",  # nor an unclosed backtick
+    "Run pytest, then cd ~ and run `make` then `cd repo && cat .hermes/notes.md`",  # markdown code spans
+])
+def test_a_top_level_cd_after_the_nesting_still_ends_the_span(body):
+    from hermes_cli import kanban_placement as kp
+    assert re.search(kp.HERMES_STATE_PATH, body, re.IGNORECASE) is None
+    assert helpers._hub({"title": "Maintenance", "body": body})["runs_on"] == ["machine:worker-1"]
+
+
+@pytest.mark.parametrize("body", [
+    "cd ~ && x=$(cd a && y=`cat .hermes/.env`)",   # marker_work_text strips backtick spans; the raw regex reads them
+    "cd ~ && x=`cd a; cd b` && cat .hermes/.env",
+])
+def test_the_raw_pattern_reads_backtick_substitution(body):
+    from hermes_cli import kanban_placement as kp
+    assert re.search(kp.HERMES_STATE_PATH, body, re.IGNORECASE)
+
+
+@pytest.mark.parametrize("unit", [
+    "(cd ~) x=$(cd a && (cd b) && `cd c`) step {i} padded out to a realistic length ",
+    "cd ~ && (( ( ( x=` step {i} padded out to a realistic length\n",
+    "cd ~ && x=`cd a` y=$(cd b) (cd c (cd d (cd e))) && cd f step {i}\n",
+])
+def test_a_large_no_match_nested_body_is_linear(unit):
+    from hermes_cli import kanban_placement as kp
+    body = "Run pytest, then " + "".join(unit.format(i=i) for i in range(5000))
+    start = time.monotonic()
+    assert re.search(kp.HERMES_STATE_PATH, body, re.IGNORECASE) is None
+    assert time.monotonic() - start < 1.0
+
+
 def test_a_large_no_match_prose_cd_body_is_linear():
     """Spans no longer end at a prose cd, so a later cd home must still end one: no O(n^2) on one long line."""
     from hermes_cli import kanban_placement as kp
