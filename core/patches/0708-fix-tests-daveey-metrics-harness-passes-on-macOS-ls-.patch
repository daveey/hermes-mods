From 00c401c74a7f2a4ac280904aa4c97a50fa6371d8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 10:37:53 +0000
Subject: [PATCH] fix(tests): [daveey] metrics harness passes on macOS ls and
 with the live venv's bin on PATH

test_foreground_terminal_commands_count_by_kind_and_outcome hard-coded GNU ls's
exit 2 for a missing path; BSD/macOS ls exits 1. Assert nonzero instead.

home_io_guard exempted stat of <PATH entry>/<name> (command lookup) but not of the
PATH entry itself, so _resolve_hermes_bin_dir's isdir(dirname(which('hermes')))
tripped the real-home guard whenever a dev shell had ~/.hermes/hermes-agent/venv/bin
on PATH (terminal + file-tool tests failed). Metadata-only stat of a PATH entry is
now exempt; listing/writing inside it is still refused (new tripwire test).
---
diff --git a/tests/hermes_cli/test_real_home_tripwire.py b/tests/hermes_cli/test_real_home_tripwire.py
index efc60a68d8e5d9a5b6a5ec3efdaa2def63fb24a8..d65d29b673cbd6fcfcd6d2043b73751392a0765e 100644
--- a/tests/hermes_cli/test_real_home_tripwire.py
+++ b/tests/hermes_cli/test_real_home_tripwire.py
@@ -170,6 +170,23 @@ def test_path_metadata_exemption_tracks_path_changes(protected_home, monkeypatch
         guard.check(target, metadata=True)
 
 
+def test_path_entry_itself_is_lookup_metadata_but_not_readable(protected_home, monkeypatch):
+    """A dev shell with the live venv's bin on PATH: ``isdir(dirname(which("hermes")))`` stats
+    the PATH entry itself. That is command lookup; listing or writing inside it is not."""
+    from tests.home_io_guard import HomeIOGuard
+
+    bin_dir = protected_home / "empty"
+    guard = HomeIOGuard(lambda: [protected_home])
+    monkeypatch.setenv("PATH", str(bin_dir))
+    guard.check(bin_dir, metadata=True)
+    for value, kwargs in ((bin_dir, {}), (bin_dir / "state.db", {"destructive": True})):
+        with pytest.raises(AssertionError, match="REAL hermes home"):
+            guard.check(value, **kwargs)
+    monkeypatch.setenv("PATH", str(protected_home.parent))
+    with pytest.raises(AssertionError, match="REAL hermes home"):
+        guard.check(bin_dir, metadata=True)
+
+
 def test_relative_path_metadata_exemption_tracks_working_directory(protected_home, tmp_path, monkeypatch):
     from tests.home_io_guard import HomeIOGuard
 
diff --git a/tests/hermes_cli/test_shared_metrics_harness.py b/tests/hermes_cli/test_shared_metrics_harness.py
index 03e820ed617586762fc06c1ca6238dee822be2a8..e39fd8728c405c54f39f6e4e3927ae5b8b366a02 100644
--- a/tests/hermes_cli/test_shared_metrics_harness.py
+++ b/tests/hermes_cli/test_shared_metrics_harness.py
@@ -115,7 +115,8 @@ def test_foreground_terminal_commands_count_by_kind_and_outcome(direct_runtime,
     results = [json.loads(terminal_tool(command, task_id="harness", timeout=timeout)) for command, timeout in (
         ("ls /definitely/not/here", 30), ("echo ok", 30), ("sh -c 'exit 124'", 30), ("sleep 5", 1),
     )]
-    assert [r["exit_code"] for r in results] == [2, 0, 124, 124]
+    # A missing path makes GNU ls exit 2 and BSD/macOS ls exit 1; only "nonzero" matters here.
+    assert results[0]["exit_code"] != 0 and [r["exit_code"] for r in results[1:]] == [0, 124, 124]
     terminal_tool("true", task_id="harness", _host_local=True)  # Hermes' own control plane: never counted
     rows = _rows(tmp_path, contract.TERMINAL_OUTCOME_METRIC, "backend", "command_kind", "outcome")
     assert rows == sorted([
