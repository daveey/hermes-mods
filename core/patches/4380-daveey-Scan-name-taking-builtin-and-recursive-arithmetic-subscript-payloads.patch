From 56d5840089b410163a21744b93ab35fdbffd0771 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:01:54 +0000
Subject: [PATCH] [daveey] Scan name-taking builtin and recursive arithmetic
 subscript payloads

Proof: 11 original real-Bash marker regressions fail on baseline; final lifecycle suite green. Clean script twins and inert data modes remain allowed. Four targeted in-memory mutants killed. Read-only replay of 2057 unique terminal commands from the latest 10000 hub message rows yields zero changed operand selections after preserving assignment argv boundaries. This is operand-selection replay, not historical filesystem verdict replay.
---
 cron/lifecycle_guard_arith_words.py           | 43 ++++++++++-
 .../test_lifecycle_guard_name_indirection.py  | 74 +++++++++++++++++++
 2 files changed, 116 insertions(+), 1 deletion(-)
 create mode 100644 tests/cron/test_lifecycle_guard_name_indirection.py

diff --git a/cron/lifecycle_guard_arith_words.py b/cron/lifecycle_guard_arith_words.py
index aaa1e7d6c7f71ee8f6988007afcf9c7522b0f13f..f32f47849f0ee7b2ad3dee17ba1ba5af2528b88c 100644
--- a/cron/lifecycle_guard_arith_words.py
+++ b/cron/lifecycle_guard_arith_words.py
@@ -64,6 +64,39 @@ def _arithmetic_operands(segment: list[str]) -> Iterator[str]:
     arguments = words[index + 1:]
     if name == "let" or (name in _INTEGER_DECLARERS and _integer_declaration(arguments)):
         yield from arguments
+    # NAME-taking builtins evaluate array subscripts after shell quote removal.
+    # Scan all arguments once the name-taking mode is present: options and operands
+    # can be interleaved, and scanning a benign referenced script remains allowed.
+    if name in {"unset", "read", "mapfile", "readarray"} or (
+        name in {"test", "[", "printf"} and "-v" in arguments
+    ) or (name == "wait" and "-p" in arguments):
+        yield from arguments
+
+
+def _recursive_arithmetic_segment(segment: list[str]) -> bool:
+    from cron import lifecycle_guard as guard
+
+    words = segment[guard._peel_reserved_words(segment):]
+    index = guard._executed_command_index(words)
+    if index is None:
+        return False
+    name = guard._executable_name(words[index])
+    return name == "let" or (
+        name == "[[" and any(token in _INT_OPERATORS for token in words[index + 1:])
+    )
+
+
+def _indirect_assignment_words(segment: list[str]) -> Iterator[str]:
+    from cron import lifecycle_guard as guard
+
+    words = segment[guard._peel_reserved_words(segment):]
+    index = guard._executed_command_index(words)
+    if index is None:
+        yield from words
+    else:
+        yield from words[:index]
+        if guard._executable_name(words[index]) in _INTEGER_DECLARERS:
+            yield from words[index + 1:]
 
 
 def iter_arithmetic_word_payloads(command: str) -> Iterator[str]:
@@ -80,8 +113,16 @@ def iter_arithmetic_word_payloads(command: str) -> Iterator[str]:
     integer_text = any(
         _INTEGER_DECLARATION_RE.search(" ".join(segment)) for segment in segments
     )
+    # Arithmetic recursively evaluates variable values. Recover earlier dequoted
+    # assignments too, not just the word at the evaluation site. Preserve argv
+    # boundaries so a quoted shell program or echo argument is not an assignment.
+    recursive_text = "((" in command or any(
+        _recursive_arithmetic_segment(segment) for segment in segments
+    )
     for segment in segments:
-        operands = segment if integer_text else _arithmetic_operands(segment)
+        operands = list(segment if integer_text else _arithmetic_operands(segment))
+        if recursive_text:
+            operands.extend(_indirect_assignment_words(segment))
         for operand in operands:
             if "[" not in operand or not any(o in operand for o in _SUBSTITUTION_OPENERS):
                 continue
diff --git a/tests/cron/test_lifecycle_guard_name_indirection.py b/tests/cron/test_lifecycle_guard_name_indirection.py
new file mode 100644
index 0000000000000000000000000000000000000000..5af2fbfcd854ecec994039ad000602f2f9999835
--- /dev/null
+++ b/tests/cron/test_lifecycle_guard_name_indirection.py
@@ -0,0 +1,74 @@
+"""Bash name operands and recursively evaluated assignment values must be scanned."""
+import pytest
+
+from cron.lifecycle_guard import scan_gateway_lifecycle
+from cron.lifecycle_guard_arith_words import iter_arithmetic_word_payloads
+from tests.cron.test_lifecycle_guard_arith_escaped_words import _run_bash
+
+
+SHAPES = [
+    "test -v 'a[$(SCRIPT)]'",
+    r"test -v a[\$\(SCRIPT\)]",
+    "[ -v 'a[$(SCRIPT)]' ]",
+    "printf -v 'a[$(SCRIPT)]' 1",
+    r"printf -v a[\$\(SCRIPT\)] 1",
+    "read 'a[$(SCRIPT)]' <<< 1",
+    "x='a[$(SCRIPT)]'; echo $((x))",
+    r"x=a[\$\(SCRIPT\)]; echo $((x))",
+    "x='a[$(SCRIPT)]'; (( x ))",
+    r"x=a[\`SCRIPT\`]; (( x ))",
+    "x='a[$(SCRIPT)]'; let y=x",
+    "x='a[$(SCRIPT)]'; [[ x -eq 0 ]]",
+    r"declare -i x; x=a[\$\(SCRIPT\)]",
+    r"declare -a a=([0]=1); unset a[\$\(SCRIPT\)]",
+    r"builtin printf -v a[\$\(SCRIPT\)] 1",
+    r"command test -v a[\$\(SCRIPT\)]",
+    r"if test -v a[\$\(SCRIPT\)]; then :; fi",
+    r"read -r a[\$\(SCRIPT\)] <<< 1",
+    r"x=a['$'\(SCRIPT\)]; y=x; echo $((y))",
+    "declare x='a[$(SCRIPT)]'; echo $((x))",
+]
+
+
+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("shape", SHAPES)
+def test_name_and_indirection_scripts_are_scanned(tmp_path, shape):
+    command = shape.replace("SCRIPT", str(tmp_path / "payload.sh"))
+    ran, script = _run_bash(tmp_path, command)
+    assert ran, "Bash must execute the harmless marker script"
+    script.write_text("hermes gateway restart\n", encoding="utf-8")
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (True, None)
+    script.write_text("echo hello\n", encoding="utf-8")
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (False, None)
+
+
+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("shape", [
+    r"x=a[\$\(SCRIPT\)]; echo x",
+    r"echo a[\$\(SCRIPT\)]",
+    r"printf '%s' a[\$\(SCRIPT\)]",
+    r"[[ -v a[\$\(SCRIPT\)] ]]",
+    r"test -n a[\$\(SCRIPT\)]",
+    r"echo 'x=a[$(SCRIPT)]'; echo $((1))",
+    r"printf '%s' 'x=a[$(SCRIPT)]; ((x))'",
+])
+def test_inert_name_words_stay_allowed(tmp_path, shape):
+    command = shape.replace("SCRIPT", str(tmp_path / "payload.sh"))
+    ran, script = _run_bash(tmp_path, command)
+    assert not ran
+    script.write_text("hermes gateway restart\n", encoding="utf-8")
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (False, None)
+
+
+@pytest.mark.parametrize("prefix", ["mapfile -t", "readarray -t", "wait -p"])
+def test_other_name_builtins_conservatively_recover_payload(prefix):
+    # Bash versions differ in accepting subscripted names here; fail towards
+    # reading the referenced file, without refusing clean contents.
+    assert list(iter_arithmetic_word_payloads(prefix + r" a[\$\(S\)]")) == ["a[$(S)]"]
+
+
+@pytest.mark.parametrize("command", [
+    r"wait a[\$\(S\)]", r"printf '%s' a[\$\(S\)]", r"test -n a[\$\(S\)]",
+])
+def test_non_name_modes_do_not_recover_payload(command):
+    assert list(iter_arithmetic_word_payloads(command)) == []
