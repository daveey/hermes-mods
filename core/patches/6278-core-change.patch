diff --git a/apps/desktop/src/app/shell/titlebar-tool-span.test.ts b/apps/desktop/src/app/shell/titlebar-tool-span.test.ts
new file mode 100644
index 00000000000..04da12525b6
--- /dev/null
+++ b/apps/desktop/src/app/shell/titlebar-tool-span.test.ts
@@ -0,0 +1,23 @@
+import { describe, expect, it } from 'vitest'
+
+import { TITLEBAR_TOOL_MAX_SPAN, titlebarToolCells, titlebarToolSpan, titlebarToolsWidthCss } from './titlebar'
+
+describe('titlebar tool span', () => {
+  it('defaults to one cell and clamps to whole cells in 1..max', () => {
+    expect(titlebarToolSpan({})).toBe(1)
+    expect(titlebarToolSpan({ span: 5 })).toBe(5)
+    expect(titlebarToolSpan({ span: 2.7 })).toBe(2)
+    expect(titlebarToolSpan({ span: 0 })).toBe(1)
+    expect(titlebarToolSpan({ span: -3 })).toBe(1)
+    expect(titlebarToolSpan({ span: Number.NaN })).toBe(1)
+    expect(titlebarToolSpan({ span: 99 })).toBe(TITLEBAR_TOOL_MAX_SPAN)
+    expect(titlebarToolSpan({ span: '4' as unknown as number })).toBe(4)
+  })
+
+  it('a row reserves the sum of its spans, so a wide chip is not drawn over the header text', () => {
+    expect(titlebarToolCells([])).toBe(0)
+    expect(titlebarToolCells([{}, {}])).toBe(2)
+    expect(titlebarToolCells([{}, { span: 5 }])).toBe(6)
+    expect(titlebarToolsWidthCss(titlebarToolCells([{}, { span: 5 }]))).toBe('calc(6 * var(--titlebar-control-size))')
+  })
+})
diff --git a/apps/desktop/src/app/shell/titlebar.ts b/apps/desktop/src/app/shell/titlebar.ts
index cb65abfddf4..067242fa6f5 100644
--- a/apps/desktop/src/app/shell/titlebar.ts
+++ b/apps/desktop/src/app/shell/titlebar.ts
@@ -81,6 +81,21 @@
 export const titlebarToolClusterClass =
   'fixed z-70 flex flex-row items-center pointer-events-auto select-none [-webkit-app-region:no-drag]'
 
+/** Most titlebar cells one tool may take (a wide plugin chip); larger spans are clamped. */
+export const TITLEBAR_TOOL_MAX_SPAN = 8
+
+/** Titlebar cells one tool takes: its `span` (whole cells, 1..TITLEBAR_TOOL_MAX_SPAN), else 1. */
+export function titlebarToolSpan(tool: { span?: number }): number {
+  const span = Math.floor(Number(tool.span))
+
+  return Number.isFinite(span) ? Math.min(TITLEBAR_TOOL_MAX_SPAN, Math.max(1, span)) : 1
+}
+
+/** Cells a row of tools takes, so the header padding reserves a wide tool's real width. */
+export function titlebarToolCells(tools: readonly { span?: number }[]): number {
+  return tools.reduce((cells, tool) => cells + titlebarToolSpan(tool), 0)
+}
+
 /** Width reserved for N abutting titlebar tool buttons. */
 export function titlebarToolsWidthCss(toolCount: number): string {
   return `calc(${toolCount} * var(--titlebar-control-size))`
