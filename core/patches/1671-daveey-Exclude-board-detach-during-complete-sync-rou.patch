     # Dropped first, so a round that fails or finds nothing to repair never leaves a stale deferral that would
diff --git a/hermes_cli/kanban_sync_guard.py b/hermes_cli/kanban_sync_guard.py
new file mode 100644
index 00000000000..f6313c2a23d
--- /dev/null
+++ b/hermes_cli/kanban_sync_guard.py
@@ -0,0 +1,18 @@
+"""Cross-process exclusion between a sync round and explicit board detachment."""
+from contextlib import contextmanager
+from pathlib import Path
+
+
+@contextmanager
+def board_sync_lock(path: Path):
+    """Never wait for network I/O while detaching: a busy round must finish first.
+
+    Reuse the native portable nonblocking flock implementation with a separate
+    key, so ordinary dispatcher ticks are not serialized with network polling.
+    """
+    from hermes_cli.kanban_db_connect import _dispatch_tick_lock
+    canonical = Path(path).resolve()
+    with _dispatch_tick_lock(canonical.with_name(canonical.name + ".sync")) as held:
+        if not held:
+            raise RuntimeError("board sync round is busy; retry detach after it finishes")
+        yield
diff --git a/tests/hermes_cli/test_kanban_sync_detach_race.py b/tests/hermes_cli/test_kanban_sync_detach_race.py
index 0eddd957e75..a3fde2b7fb0 100644
--- a/tests/hermes_cli/test_kanban_sync_detach_race.py
+++ b/tests/hermes_cli/test_kanban_sync_detach_race.py
@@ -47,3 +47,32 @@ def test_detach_between_feed_precheck_and_write_preserves_custody(synced_conn, m
         assert kb.get_task(conn, tid).status == "running"
         assert [tuple(r) for r in conn.execute("SELECT * FROM task_runs")] == before
         assert sync.sync_state(conn)["cursor"] != 999
+
+
+def test_detach_refuses_until_whole_sync_round_including_push_finishes(synced_conn, monkeypatch):
+    from hermes_cli import kanban_sync_client as client
+    from tests.hermes_cli.kanban_sync_fake_board import FakeService
+
+    conn = synced_conn
+    path = Path(sync._db_key(conn))
+    client.ensure_identity(conn, "default", "fixture-host")
+    sync.set_mode(conn, "primary")
+    kb.create_task(conn, title="pending publication", assignee="worker")
+    hub = FakeService().hub("fixture-host")
+    real_push = client.push
+    reached = []
+    with kbc.connect_closing(path) as detacher:
+        def push_with_detach(*args, **kwargs):
+            with pytest.raises(RuntimeError, match="sync round is busy"):
+                sync.set_mode(detacher, "off")
+            assert sync.board_mode(conn) == "primary"
+            reached.append(True)
+            return real_push(*args, **kwargs)
+
+        monkeypatch.setattr(client, "push", push_with_detach)
+        result = client.sync_board("default", path, hub, "fixture-host")
+        assert reached and result.push.sent
+        sync.set_mode(detacher, "off")
+        # A round enumerated before detach but starting after it does no I/O.
+        result = client.sync_board("default", path, None, "fixture-host")
+        assert result.mode == "off"
