From 11b40eeb0bef488298c4a1b14a6c45cd4fe1b678 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:27:20 +0000
Subject: [PATCH] [daveey] links_diff test: pin that placement placeholder
 chats are counted, not compared

Post-merge mutation check of #2163 (t_01a1d4bf32c15f0f): in `_unlinked_chats`,
replacing `out = {s for s in profiles if is_placeholder_session(s)}` with
`out = set()` left test_kanban_chat_links*.py green (47 passed), because the
machine-chat links_diff test seeds only cron and `local-<hash>` worker chats.
`machine_sessions` does not classify a `kanban-placement*` id as machine, so
only the placeholder filter keeps its ledger row out of the comparison.

New test `test_links_diff_leaves_out_placement_placeholder_chats` seeds a
placeholder chat beside a human chat and asserts machine_links == 1 and that
only the human chat differs.

Proof (tests-only change, no production code touched):
- GREEN on origin/main: test_kanban_chat_links.py + _parity.py 48 passed, 0 failed.
- RED with the mutant on main: 47 passed, 1 failed (the new test;
  machine_links 0, chats 2).
- Same GREEN/RED against PR #2351's refactored `_unlinked_chats`
  (wt/chat-links-machine-nits): 48/0 green, mutant 47/1 red. The new test sits
  above the test #2351 extends, so the two diffs do not overlap.
---
 tests/hermes_cli/test_kanban_chat_links_parity.py | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_chat_links_parity.py b/tests/hermes_cli/test_kanban_chat_links_parity.py
index c7d7750104..908e470b4d 100644
--- a/tests/hermes_cli/test_kanban_chat_links_parity.py
+++ b/tests/hermes_cli/test_kanban_chat_links_parity.py
@@ -310,6 +310,17 @@ def test_links_diff_agrees_on_a_done_unverified_card_whose_owner_written_sibling
     assert [(c["id"], c["status"]) for c in links.replica_cards(["s1"], ME)] == [("t_done", "unknown")]
 
 
+def test_links_diff_leaves_out_placement_placeholder_chats(env):
+    """[daveey] A ``kanban-placement*`` placeholder is no chat: the link writer never links it, and
+    ``machine_sessions`` does not classify it machine, so only the placeholder filter keeps its ledger row out of
+    the comparison. It is counted, not compared; a human chat beside it still differs."""
+    replica(env, [("t_ph", "done", HUB), ("t_human", "done", HUB)], [("t_human", "s_human", "shepherd", 1)])
+    env["ledger"].extend([_unknown_row("t_ph", "kanban-placement-abc"), _unknown_row("t_human", "s_human", "shepherd")])
+    report = links.links_diff(ME)
+    assert report["machine_links"] == 1, report
+    assert report["only_in_ledger"] == {"s_human": [(HUB, "default", "t_human")]}
+
+
 def test_links_diff_leaves_out_chats_the_link_writer_never_links(env):
     """[daveey] 250 of the 270 only-in-ledger links on laptop-1 (2026-11-13) were kanban worker transcripts:
     ``_ledger_links`` never writes a machine session's link and ``reconcile`` releases one, so the ledger's rows for
