diff --git a/agent/credential_pool_model_state.py b/agent/credential_pool_model_state.py
new file mode 100644
index 0000000000..23242f8ade
--- /dev/null
+++ b/agent/credential_pool_model_state.py
@@ -0,0 +1,71 @@
+"""Mergeable model failure generations and sticky scoped recovery receipts."""
+from __future__ import annotations
+
+import logging
+from typing import Any
+
+MODEL_STATE_FIELDS = ("model_cooldowns", "model_cooldown_recorded_at", "model_cooldown_cleared_at")
+
+
+def merge_model_state(*rows: dict[str, Any]) -> dict[str, Any]:
+    from agent.credential_pool import _parse_absolute_timestamp
+
+    recorded: dict[str, float] = {}
+    cleared: dict[str, float] = {}
+    global_clear = max((_parse_absolute_timestamp(row.get("status_cleared_at")) or 0.0
+                        for row in rows), default=0.0)
+    for row in rows:
+        for field, target in (("model_cooldown_recorded_at", recorded),
+                              ("model_cooldown_cleared_at", cleared)):
+            for model, stamp in (row.get(field) or {}).items():
+                if isinstance(stamp, (int, float)):
+                    target[model] = max(target.get(model, 0.0), float(stamp))
+    observations: dict[str, tuple[float, float]] = {}
+    for row in rows:
+        for model, until in (row.get("model_cooldowns") or {}).items():
+            if not isinstance(until, (int, float)):
+                continue
+            stamp = (row.get("model_cooldown_recorded_at") or {}).get(model, 0.0)
+            receipt = max(global_clear, cleared.get(model, 0.0))
+            if receipt and stamp <= receipt:
+                continue
+            observations[model] = max(observations.get(model, (0.0, 0.0)), (stamp, float(until)))
+    result: dict[str, Any] = dict(zip(MODEL_STATE_FIELDS, (
+        {model: observation[1] for model, observation in observations.items()}, recorded, cleared)))
+    result = {field: value for field, value in result.items()
+              if value or any(row.get(field) is not None for row in rows)}
+    if global_clear:
+        result["status_cleared_at"] = global_clear
+    return result
+
+
+def resync_model_state(pool, entry):
+    """Read resets even when the credential has no account-wide failure status."""
+    from hermes_cli.auth import read_credential_pool
+    try:
+        row = next((r for r in read_credential_pool(pool.provider) if r.get("id") == entry.id), None)
+        if row is None:
+            return entry
+        state = merge_model_state(entry.to_dict(), row)
+        if all((getattr(entry, field) or {}) == state.get(field, {}) for field in MODEL_STATE_FIELDS):
+            return entry
+        return pool._adopt(entry, persist=False, **state)
+    except Exception:
+        logging.getLogger(__name__).debug("Could not resync model cooldown state", exc_info=True)
+        return entry
+
+
+def adopt_persisted_row(entry, row, pair):
+    """Adopt merged resets/status as well as tokens without dehydrating reference rows."""
+    from dataclasses import replace
+    from agent.credential_pool import PooledCredential
+    from hermes_cli.auth_pool_merge import _POOL_STATUS_FIELDS
+
+    if row is None:
+        return entry
+    updates = {field: row.get(field) for field in (*MODEL_STATE_FIELDS, *_POOL_STATUS_FIELDS)}
+    changed = any(getattr(entry, field) != value for field, value in updates.items())
+    if any(pair):
+        return PooledCredential.from_dict(entry.provider, row) if changed or pair != (
+            entry.access_token, entry.refresh_token) else entry
+    return replace(entry, **updates) if changed else entry
diff --git a/agent/credential_pool_recovery.py b/agent/credential_pool_recovery.py
new file mode 100644
index 0000000000..c3b2eeb434
--- /dev/null
+++ b/agent/credential_pool_recovery.py
@@ -0,0 +1,77 @@
+"""Persistence-only compare-and-swap for externally verified quota recovery."""
+from __future__ import annotations
+
+import time
+import logging
+
+
+def clear_verified_model_cooldown(pool, observed, model: str) -> bool:
+    """Clear only the exact failure/token generation that a caller verified.
+
+    No probes or refreshes here. Read and mutate the owning store under its lock, never
+    flush a pre-probe pool snapshot over a peer's refresh or another model's failure.
+    """
+    from agent import credential_pool as cp
+    from agent.credential_pool_disabled import disabled_keys, matches
+    from hermes_cli import auth
+
+    if not model or observed.provider != pool.provider:
+        return False
+    with pool._lock:
+        target = None
+        if pool.provider in cp.SINGLE_USE_REFRESH_POOL_PROVIDERS and not cp._profile_owns_pool_provider(pool.provider):
+            target = cp._borrowed_single_use_pool_root()
+            if target is None:
+                return False
+        try:
+            with auth._auth_store_lock(target_path=target):
+                store = auth._load_auth_store(target) if target is not None else auth._load_auth_store()
+                rows = store.get("credential_pool", {}).get(pool.provider, [])
+                row = next((r for r in rows if isinstance(r, dict) and r.get("id") == observed.id), None)
+                if row is None:
+                    return False
+                current = cp.PooledCredential.from_dict(pool.provider, row)
+                if (not observed.runtime_api_key or current.runtime_api_key != observed.runtime_api_key
+                        or (current.access_token, current.refresh_token, current.base_url, current.auth_type)
+                        != (observed.access_token, observed.refresh_token, observed.base_url, observed.auth_type)
+                        or matches(current, disabled_keys(pool.provider))):
+                    return False
+                status_fields = ("last_status", "last_status_at", "last_error_code", "last_error_reason",
+                                 "last_error_message", "last_error_reset_at", "status_cleared_at")
+                if any(getattr(current, f) != getattr(observed, f) for f in status_fields):
+                    return False
+                if any(current.extra.get(f) != observed.extra.get(f)
+                       for f in ("cooldown_until", "failure_reason", "bench_status_at", "bench_token_fp")):
+                    return False
+                billing = (cp.FAILURE_REASON_BILLING, cp.FAILURE_REASON_BILLING_UNVERIFIED)
+                if (current.last_status == cp.STATUS_DEAD or current.last_error_code in (401, 402, 403)
+                        or current.last_error_reason in billing or current.extra.get("failure_reason") in billing):
+                    return False
+                cooldown = (observed.model_cooldowns or {}).get(model)
+                if current.last_status == cp.STATUS_EXHAUSTED:
+                    # Only Codex's explicitly observed account-wide 429 is recoverable here.
+                    if pool.provider != "openai-codex" or current.last_error_code != 429:
+                        return False
+                    updates = {**cp._MARK_OK, "last_status_at": current.last_status_at}
+                elif cooldown is not None:
+                    for field in ("model_cooldowns", "model_cooldown_recorded_at", "model_cooldown_cleared_at"):
+                        if (getattr(current, field) or {}).get(model) != (getattr(observed, field) or {}).get(model):
+                            return False
+                    cooldowns = dict(current.model_cooldowns or {})
+                    cooldowns.pop(model, None)
+                    cleared = {**(current.model_cooldown_cleared_at or {}), model: time.time()}
+                    updates = {"model_cooldowns": cooldowns, "model_cooldown_cleared_at": cleared}
+                else:
+                    return False
+                row.update(updates)
+                auth._save_auth_store(store, target_path=target)
+                adopted = cp.PooledCredential.from_dict(pool.provider, row)
+                live = pool._find(lambda e: e.id == observed.id)
+                if live is not None:
+                    pool._replace_entry(live, adopted)
+                pool._persisted_token_pairs[observed.id] = (adopted.access_token, adopted.refresh_token)
+                return True
+        except Exception:
+            # Failure to lock/read/write is not evidence of recovery.
+            logging.getLogger(__name__).debug("Could not persist verified quota recovery", exc_info=True)
+            return False
diff --git a/agent/request_bucket_context.py b/agent/request_bucket_context.py
new file mode 100644
index 0000000000..ea393d1b7b
--- /dev/null
+++ b/agent/request_bucket_context.py
@@ -0,0 +1,32 @@
+"""Keep a request-bucket reset separate from subscription usage windows."""
+from __future__ import annotations
+
+from agent.credential_pool_timestamps import _parse_absolute_timestamp
+from agent.retry_utils import parse_retry_after_seconds
+
+
+def request_bucket_context(error, context, *, now):
+    """Override generic/body resets only with positive request-bucket evidence.
+
+    Anthropic uses the same generic rate-limit message for a real weekly rejection;
+    never classify that message alone as a transient throttle. Unified rejected
+    windows stay authoritative even if request-bucket headers are also present.
+    """
+    if getattr(error, 'status_code', None) != 429:
+        return context
+    headers = getattr(getattr(error, 'response', None), 'headers', None) or {}
+    headers = {str(k).lower(): v for k, v in headers.items()}
+    if any(str(value).lower() == 'rejected' for key, value in headers.items()
+           if key.startswith('anthropic-ratelimit-unified') and key.endswith('status')):
+        return context
+    exhausted = any(str(headers.get(key, '')).strip() == '0' for key in (
+        'anthropic-ratelimit-requests-remaining', 'x-ratelimit-remaining-requests'))
+    if not exhausted:
+        return context
+    seconds = parse_retry_after_seconds(headers)
+    if seconds is None:
+        reset = _parse_absolute_timestamp(headers.get('anthropic-ratelimit-requests-reset'))
+        seconds = reset - now if reset is not None else None
+    if seconds is None or seconds < 0:
+        return context
+    return {**context, 'reset_at': now + seconds}
