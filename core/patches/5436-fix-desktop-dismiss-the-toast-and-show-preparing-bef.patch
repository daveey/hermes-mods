From 3dc04151fc7955ffd1be940ba4659e9f337c5ed8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 00:02:14 -0800
Subject: [PATCH] fix(desktop): dismiss the toast and show preparing before the
 backend hermes-sync hand-off [daveey]

Exact-head review of #3919: the complexity refactor moved the backend toast dismiss and the
prepare stage after routeUpdateToHermesSync, so a managed backend's dialog sat on its old
stage during the request. routeOrRunBackendUpdate now sets both first; tests assert it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/desktop/src/store/updates-sync-route.test.ts | 15 +++++++++++++--
 apps/desktop/src/store/updates.ts                 |  9 ++++++++-
 2 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/apps/desktop/src/store/updates-sync-route.test.ts b/apps/desktop/src/store/updates-sync-route.test.ts
index 22fb0ccf9d..ac88ff9a3a 100644
--- a/apps/desktop/src/store/updates-sync-route.test.ts
+++ b/apps/desktop/src/store/updates-sync-route.test.ts
@@ -20,7 +20,11 @@ vi.mock('@/hermes', async importOriginal => ({
   getHermesUpdateProgress: vi.fn().mockResolvedValue({ progress: null }),
   updateHermes: (...args: unknown[]) => updateHermesSpy(...args)
 }))
-vi.mock('@/store/notifications', () => ({ dismissNotification: vi.fn(), notify: vi.fn() }))
+const dismissSpy = vi.fn()
+vi.mock('@/store/notifications', () => ({
+  dismissNotification: (...args: unknown[]) => dismissSpy(...args),
+  notify: vi.fn()
+}))
 
 const updates = await import('./updates')
 
@@ -99,12 +103,19 @@ describe('Update on a host hermes-sync manages', () => {
   })
 
   it('hands the backend Update to hermes-sync without starting hermes update', async () => {
-    forceStateSpy.mockResolvedValue(managed)
+    let stageDuringRoute = ''
+    forceStateSpy.mockImplementation(async () => {
+      stageDuringRoute = updates.$backendUpdateApply.get().stage // preparing while the request is in flight
+
+      return managed
+    })
     forceSpy.mockResolvedValue({ ok: true })
 
     const result = await updates.applyBackendUpdate()
 
     expect(forceSpy).toHaveBeenCalledWith(undefined)
+    expect(dismissSpy).toHaveBeenCalled() // the "update available" toast goes away on the hand-off too
+    expect(stageDuringRoute).toBe('prepare')
     expect(updateHermesSpy).not.toHaveBeenCalled()
     expect(result.ok).toBe(true)
     expect(updates.$backendUpdateApply.get()).toMatchObject({ applying: false, stage: 'synced' })
diff --git a/apps/desktop/src/store/updates.ts b/apps/desktop/src/store/updates.ts
index 0fcbbfd373..f847bc0052 100644
--- a/apps/desktop/src/store/updates.ts
+++ b/apps/desktop/src/store/updates.ts
@@ -842,7 +842,6 @@ async function applyOwnUpdate(
   bridge: NonNullable<NonNullable<typeof window.hermesDesktop>['updates']>,
   opts: DesktopUpdateApplyOptions
 ): Promise<DesktopUpdateApplyResult> {
-
   try {
     const result = await bridge.apply(opts)
 
@@ -1106,6 +1105,14 @@ let backendUpdateInFlight: Promise<DesktopUpdateApplyResult> | null = null
 
 /** hermes-sync's Force update on a backend it manages, else the backend's own `POST /api/hermes/update`. */
 async function routeOrRunBackendUpdate(): Promise<DesktopUpdateApplyResult> {
+  dismissNotification(UPDATE_TOAST_ID)
+  $backendUpdateApply.set({
+    ...IDLE,
+    applying: true,
+    stage: 'prepare',
+    message: translateNow('updates.applyStatus.preparing')
+  })
+
   return (await routeUpdateToHermesSync('backend')) ?? runBackendUpdate()
 }
 
