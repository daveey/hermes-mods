From d4c89ee50ff1c7414509b76c8e540b8387f3bb8c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:55:51 +0000
Subject: [PATCH] fix(kanban): declare internal HTTP provenance boundary
 [daveey]

The bundled Kanban endpoint deliberately calls the core raw-transport and process-ancestry classifier. This is not a public third-party plugin contract; record this one intended crossing rather than duplicate the classifier or publish its internals. CI boundary test failed before the declaration; boundary and comment suites now pass (25 tests).
---
 scripts/boundary_lint_baseline.json | 1 +
 1 file changed, 1 insertion(+)

diff --git a/scripts/boundary_lint_baseline.json b/scripts/boundary_lint_baseline.json
index ed4a309e858..be6d6b11b4b 100644
--- a/scripts/boundary_lint_baseline.json
+++ b/scripts/boundary_lint_baseline.json
@@ -226,6 +226,7 @@
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.web_read_coalescing.coalesced_read": 1,
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.web_server_chat": 1,
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.web_server_sessions._open_session_db_for_profile": 1,
+    "plugins/kanban/dashboard/plugin_api_comment_actor.py hermes_cli.kanban_http_comment_writer.http_comment_writer": 1,
     "plugins/kanban/dashboard/plugin_api_human_request.py hermes_cli.kanban_ask_resolved.create_context": 1,
     "plugins/kanban/dashboard/plugin_api_human_request.py hermes_cli.kanban_ask_resolved.create_filing_error": 1,
     "plugins/kanban/dashboard/plugin_api_human_request.py hermes_cli.kanban_ask_resolved.filing_refusal": 1,
