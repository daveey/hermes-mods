From d02ead74390ef154d3e41d96b4b37bc7757fa0d2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 02:15:07 +0000
Subject: [PATCH] [daveey] kanban_worker_shell: share top_level_env's
 live-ancestor check; test the spawn-pid fallback

PR #1781 review nits (t_01a1d23a8bee4dbe):

- top_level_env.descends_from_live_pid(pid) is the one pid>1 / alive / _is_ancestor check.
  _descends_from_live_agent, the finished-card branch of leaked_worker_env_diagnosis and
  kanban_worker_shell.run_for all use it (kanban_worker_shell._descends_from is gone).
- tests/tools/test_kanban_review_contract.py covers run_for's worker_pid fallback (no worker_bound
  event): a shell descending from the fingerprinted spawn pid completes its own run without --force;
  a fingerprint mismatch or pid 1 is refused.
- run_for's docstring now says the proof is card-agnostic: any card's proven worker shell (not only a
  review card's) passes expected_run_id, so a no---force CLI completion fenced to that run succeeds.
---
 hermes_cli/kanban_worker_shell.py          | 17 +++-----
 hermes_cli/top_level_env.py                | 15 +++++--
 tests/tools/test_kanban_review_contract.py | 46 +++++++++++++++++++++-
 3 files changed, 62 insertions(+), 16 deletions(-)

diff --git a/hermes_cli/kanban_worker_shell.py b/hermes_cli/kanban_worker_shell.py
index bd67242dbe..4eb6c25aee 100644
--- a/hermes_cli/kanban_worker_shell.py
+++ b/hermes_cli/kanban_worker_shell.py
@@ -43,18 +43,12 @@ def _payloads(conn, task_id: str, run_id: int, kind: str) -> list[dict]:
     return out
 
 
-def _descends_from(pid) -> bool:
-    from hermes_cli.top_level_env import _is_ancestor, _pid_alive
-    try:
-        pid = int(pid or 0)
-    except (TypeError, ValueError):
-        return False
-    return pid > 1 and _pid_alive(pid) and _is_ancestor(pid)
-
-
 def run_for(conn, task_id: str, env: Optional[Mapping[str, str]] = None) -> tuple[Optional[int], Optional[str]]:
     """``(run_id, None)`` when this process is proven to be ``task_id``'s worker shell; ``(None, why)`` when the env
-    names the card but the proof fails; ``(None, None)`` when the env does not name the card at all."""
+    names the card but the proof fails; ``(None, None)`` when the env does not name the card at all.
+
+    The proof is card-agnostic: any card's proven worker shell (not only a review card's) gets its run id, which the
+    CLI passes as ``expected_run_id``, so a no-``--force`` completion fenced to that run succeeds."""
     env = os.environ if env is None else env
     if not names_card(task_id, env):
         return None, None
@@ -71,7 +65,8 @@ def run_for(conn, task_id: str, env: Optional[Mapping[str, str]] = None) -> tupl
     from hermes_cli.kanban_db_dispatch import _worker_alive
     spawned = task["worker_pid"] if task["worker_pid"] and _worker_alive(task["worker_pid"],
                                                                          task["worker_started_at"]) else None
-    if not any(_descends_from(pid) for pid in [*bound, spawned]):
+    from hermes_cli.top_level_env import descends_from_live_pid
+    if not any(descends_from_live_pid(pid) for pid in [*bound, spawned]):
         return None, f"pid {os.getpid()} does not descend from run {run_id}'s live worker"
     sessions = {p.get("session_id") for p in _payloads(conn, task_id, run_id, "owner_admitted")}
     if len(sessions) != 1 or not isinstance(next(iter(sessions)), str) or not next(iter(sessions)):
diff --git a/hermes_cli/top_level_env.py b/hermes_cli/top_level_env.py
index bf18d53b35..39a358e86c 100644
--- a/hermes_cli/top_level_env.py
+++ b/hermes_cli/top_level_env.py
@@ -273,6 +273,16 @@ def _is_ancestor(pid: int, start: Optional[int] = None) -> bool:
     return False
 
 
+def descends_from_live_pid(pid) -> bool:
+    """Whether this process descends from ``pid`` while it is alive. pid 0/1 (and a non-integer) never
+    count: every process descends from init, so it vouches for nothing. [daveey]"""
+    try:
+        pid = int(pid or 0)
+    except (TypeError, ValueError):
+        return False
+    return pid > 1 and _pid_alive(pid) and _is_ancestor(pid)
+
+
 def _descends_from_live_agent(env: Mapping[str, str], bound_pid: Optional[int]) -> bool:
     """Whether this process descends from a live agent of the lineage other than the spawn pid:
     the run's ``worker_bound`` interpreter, or the ``HERMES_DELEGATED_CHILD_OWNER`` process that
@@ -281,7 +291,7 @@ def _descends_from_live_agent(env: Mapping[str, str], bound_pid: Optional[int])
 
     owner = (env.get(DELEGATED_CHILD_OWNER_ENV) or "").strip().partition(":")[0]
     candidates = [bound_pid] + ([int(owner)] if owner.isdigit() else [])
-    return any(pid and pid > 1 and _pid_alive(pid) and _is_ancestor(pid) for pid in candidates)
+    return any(descends_from_live_pid(pid) for pid in candidates)
 
 
 def leaked_worker_env_diagnosis(environ: Optional[Mapping[str, str]] = None) -> Optional[str]:
@@ -308,8 +318,7 @@ def leaked_worker_env_diagnosis(environ: Optional[Mapping[str, str]] = None) ->
     if not status:
         reason = f"its worker card {tid} is not on the board"
     elif status in _TERMINAL_STATUSES:
-        if _descends_from_live_agent(env, bound_pid) or (
-                worker_pid and worker_pid > 1 and _pid_alive(worker_pid) and _is_ancestor(worker_pid)):
+        if _descends_from_live_agent(env, bound_pid) or descends_from_live_pid(worker_pid):
             # The worker's own shell after kanban_complete: the env is legitimately its own, the card
             # is just finished. No Desktop is involved (t_01a198dc526bff6e). [daveey]
             return (f"your Kanban card {tid} is {status}: board writes from its worker shell are fenced. "
diff --git a/tests/tools/test_kanban_review_contract.py b/tests/tools/test_kanban_review_contract.py
index 70cab15123..cd8c40acbb 100644
--- a/tests/tools/test_kanban_review_contract.py
+++ b/tests/tools/test_kanban_review_contract.py
@@ -430,7 +430,10 @@ def kb_status(kb, conn, tid):
 WORKER_SESSION = "local-reviewer-session"
 
 
-def _worker_shell_card(kb, monkeypatch, body, *, bound_pid=None, session=WORKER_SESSION, env_session=WORKER_SESSION):
+def _worker_shell_card(kb, monkeypatch, body, *, bound_pid=None, session=WORKER_SESSION, env_session=WORKER_SESSION,
+                       bound=True, spawn=None):
+    """``spawn=(pid, fingerprint)`` records the claim's spawned worker (``tasks.worker_pid``); ``bound=False`` leaves
+    the run without a ``worker_bound`` event, so only that spawn pid can prove the shell."""
     import os
     from hermes_cli import kanban_db_connect as kbc
     with kbc.connect() as conn:
@@ -440,7 +443,10 @@ def _worker_shell_card(kb, monkeypatch, body, *, bound_pid=None, session=WORKER_
         with kb.write_txn(conn):
             if session:
                 kb._append_event(conn, tid, "owner_admitted", {"session_id": session, "pid": 1}, run_id=run_id)
-            kb._append_event(conn, tid, "worker_bound", {"pid": bound_pid or os.getppid()}, run_id=run_id)
+            if bound:
+                kb._append_event(conn, tid, "worker_bound", {"pid": bound_pid or os.getppid()}, run_id=run_id)
+            if spawn:
+                conn.execute("UPDATE tasks SET worker_pid = ?, worker_started_at = ? WHERE id = ?", (*spawn, tid))
     for var in ("HERMES_KANBAN_TASK", "HERMES_KANBAN_RUN_ID"):
         monkeypatch.delenv(var, raising=False)
     monkeypatch.setenv("HERMES_KANBAN_WORKER_TASK", tid)
@@ -494,6 +500,42 @@ def test_cli_worker_env_alone_is_not_trusted(board, monkeypatch, capsys, case):
     assert _status(board, tid) == "running"
 
 
+# No worker_bound event (the bind never landed): the claim's spawned worker_pid proves the shell, but only while its
+# start-time fingerprint still matches (a recycled pid is a stranger) and never as pid 1 (every process descends
+# from init).
+
+def _fingerprint(pid):
+    from hermes_cli.kanban_db_dispatch import _process_fingerprint
+    return _process_fingerprint(pid)
+
+
+def test_cli_worker_shell_proven_by_the_fingerprinted_spawn_pid(board, monkeypatch):
+    import os
+    tid, run_id = _worker_shell_card(board, monkeypatch, SHIP_BODY, bound=False,
+                                     spawn=(os.getppid(), _fingerprint(os.getppid())))
+    assert _cli_complete(tid, dict(GOOD), force=False) == 0  # fenced to the proven run, no --force needed
+    assert _status(board, tid) == "done"
+    row = _closing_run(board, tid)
+    assert (row["id"], row["outcome"], row["status"]) == (run_id, "completed", "done")
+    assert _runs(board, tid) == 1
+
+
+@pytest.mark.parametrize("case", ["fingerprint_mismatch", "init_pid"])
+def test_cli_worker_shell_spawn_pid_fallback_refuses(board, monkeypatch, capsys, case):
+    import os
+    if case == "fingerprint_mismatch":
+        fp = _fingerprint(os.getppid())
+        assert fp and "|" in fp
+        spawn = (os.getppid(), "another-boot|" + fp.partition("|")[2])  # same pid number, foreign instantiation
+    else:
+        spawn = (1, _fingerprint(1))
+    tid, _ = _worker_shell_card(board, monkeypatch, SHIP_BODY, bound=False, spawn=spawn)
+    assert _cli_complete(tid, dict(GOOD), force=True) != 0
+    err = capsys.readouterr().err
+    assert "review_independence" in err and "CLI fallback cannot record a review ship accepts" in err
+    assert _status(board, tid) == "running"
+
+
 def test_cli_worker_env_on_an_unclaimed_card_is_refused(board, monkeypatch, capsys):
     tid = _outside_card(board, SHIP_BODY)
     monkeypatch.setenv("HERMES_KANBAN_WORKER_TASK", tid)
