From 0d3797b3617f5a442e6d10af407d2eac98c4e7b4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 00:12:54 -0700
Subject: [PATCH] fix(kanban): refuse reclaim of a foreign live lease [daveey]

A replica reclaim of a card another gateway still leases closed the run.
The close synced, and the owner's terminal-worker reaper SIGTERMed the
live worker (David-MBP 2026-10-28 23:05, during the core-update drain).
reclaim_task now records reclaim_refused and leaves the run open. The
reaper skips a run whose task is still running under that worker. A dead
worker during a drain hold is requeued to ready and not claimed again
until the hold lifts.
---
diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index ab0c7f85b951f552280b7c64eadfb12e6a2559fd..2ead516b3847e98afaf3a42f4895683a3ae07d47 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -2672,8 +2672,8 @@ def reclaim_task(
     ).fetchone()
     if not row:
         return False
-    if row["status"] != "running" and row["claim_lock"] is None:
-        # Nothing to reclaim — already ready / blocked / done.
+    idle = row["status"] != "running" and row["claim_lock"] is None
+    if idle or _sync.refuse_foreign_reclaim(conn, task_id):
         return False
     prev_lock = row["claim_lock"]
     termination = _terminate_reclaimed_worker(
