From 7fc5777f7e34a6aade1bd5a7c3b48b2dd29a4614 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 08:17:32 +0000
Subject: [PATCH] fix(always-on): start-up roll re-checks a marker that had
 cleared [daveey]

Fifth review of #3920: start() passed marker_waited=True even when its wait
ended because the marker cleared, so an update starting during the start-up
probes (up to ~49 s on a starved backend) was not waited for by roll(). Only
a stale, timed-out marker now skips roll()'s wait. Test: after a clear wait,
roll() is called with marker_waited=False.

Co-Authored-By: Contributor <contributor@example.com>
---
 hermes_cli/always_on_rollover.py            |  7 +++++--
 tests/hermes_cli/test_always_on_rollover.py | 10 ++++++++++
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/always_on_rollover.py b/hermes_cli/always_on_rollover.py
index 520e254140..9985c7ce8b 100644
--- a/hermes_cli/always_on_rollover.py
+++ b/hermes_cli/always_on_rollover.py
@@ -829,11 +829,14 @@ class Roller:
         is demoted like one supervise() rolls away from, so it is not adopted again or kept for 6 h. Decided after
         the update marker clears (a backend paused for the update is not starved) and only when every one of
         UNRESPONSIVE_CONFIRMATIONS probes misses, the same bar supervise() uses."""
-        if not aod.wait_for_update_clear(self.marker, sleep=self.sleep, now=self.clock):
+        cleared = aod.wait_for_update_clear(self.marker, sleep=self.sleep, now=self.clock)
+        if not cleared:
             log("update marker still present; rolling anyway")
         before = read_active(self.home)
         starved = before is not None and self.unit_active(before["port"]) and self._never_answers(before["port"])
-        ok = self.roll("roller started", marker_waited=True)
+        # A marker that cleared may be taken again by a new update during the probes: roll() checks again then.
+        # Only a stale (timed-out) marker skips roll()'s wait, so it holds the start once, not twice.
+        ok = self.roll("roller started", marker_waited=not cleared)
         if ok and starved:
             self.demote_if_replaced(before["port"])
         return ok
diff --git a/tests/hermes_cli/test_always_on_rollover.py b/tests/hermes_cli/test_always_on_rollover.py
index 46b68fc2bd..4a653e10f5 100644
--- a/tests/hermes_cli/test_always_on_rollover.py
+++ b/tests/hermes_cli/test_always_on_rollover.py
@@ -537,6 +537,16 @@ def test_start_waits_out_a_stale_update_marker_once(home):
     assert ro.aod.UPDATE_WAIT_S <= waited < 2 * ro.aod.UPDATE_WAIT_S  # one wait, not start()'s plus roll()'s
 
 
+def test_start_lets_roll_recheck_a_marker_that_had_cleared(home):
+    host = FakeHost(running={9148}, commits={9148: "a" * 40})
+    ro.write_active(9148)
+    roller = make_roller(home, host)
+    calls = []
+    roller.roll = lambda reason, **kw: calls.append(kw) or True  # type: ignore[method-assign]
+    assert roller.start() is True
+    assert calls == [{"marker_waited": False}]  # an update that starts during the probes is still waited for
+
+
 def test_start_does_not_demote_a_healthy_active_backend(home):
     host = FakeHost(running={9148}, commits={9148: "a" * 40})
     ro.write_active(9148)
-- 
