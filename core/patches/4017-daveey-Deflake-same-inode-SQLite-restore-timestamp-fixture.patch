From 62be3718f8aa600c8687a5b92e92aedd877d5710 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 00:50:21 +0000
Subject: [PATCH] [daveey] Deflake same-inode SQLite restore timestamp fixture

Why: the CI failure compared identical generation, size, mtime_ns and data_version keys. Equal-size SQLite copies with equal header counters can complete within one filesystem timestamp tick; the test never established the changed-mtime precondition of the observer contract. Set that transition explicitly, retaining same-inode/equal-size and restored-value checks. No sleeps, production changes or retry widening.

Proof: controlled copyfile wrapper preserving destination mtime fails the original after != before assertion; the same wrapper passes after this change. Canonical whole-file plus reproduction: 13 passed, retries disabled. scripts/check: 20 checks OK. SIGSTOP/SIGCONT session stress of canonical launcher also passed (per-file workers may escape that session; this is not full descendant stress proof).
---
 tests/tui_gateway/test_watch_store_gate.py | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/tests/tui_gateway/test_watch_store_gate.py b/tests/tui_gateway/test_watch_store_gate.py
index 3680a81bab..c2153985d2 100644
--- a/tests/tui_gateway/test_watch_store_gate.py
+++ b/tests/tui_gateway/test_watch_store_gate.py
@@ -213,9 +213,16 @@ def test_in_place_restore_reopens_sqlite_page_cache(tmp_path):
     try:
         with watch_store.observed(path) as (before, conn):
             assert conn.execute("SELECT v FROM t").fetchone()[0] == 1
-        inode = path.stat().st_ino
+        original = path.stat()
         shutil.copyfile(other, path)
-        assert path.stat().st_ino == inode
+        # Equal-size SQLite files can have equal header counters, and copyfile can
+        # finish within the same filesystem mtime tick. Exercise the changed-mtime
+        # restore contract explicitly instead of depending on wall-clock progress.
+        os.utime(path, ns=(original.st_atime_ns, original.st_mtime_ns + 2_000_000_000))
+        restored = path.stat()
+        assert restored.st_ino == original.st_ino
+        assert restored.st_size == original.st_size
+        assert restored.st_mtime_ns != original.st_mtime_ns
         with watch_store.observed(path) as (after, conn):
             assert after != before
             assert conn.execute("SELECT v FROM t").fetchone()[0] == 99
-- 
