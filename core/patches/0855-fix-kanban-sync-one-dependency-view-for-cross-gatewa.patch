+    res = hub.ops(BOARD, [{"client_op_id": f"other-{op_id}", "op": "upsert", "table": table, "uid": uid,
+                           "hlc": f"{time.time_ns() // 1_000_000 + 1000:013d}-0000-{OTHER}", "fields": fields}])
+    assert res["results"][0]["status"] == "applied", res
+    return res
