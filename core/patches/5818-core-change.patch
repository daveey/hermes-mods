diff --git a/hermes_cli/kanban_scope_renewal.py b/hermes_cli/kanban_scope_renewal.py
new file mode 100644
index 0000000000..f2a6ff2f73
--- /dev/null
+++ b/hermes_cli/kanban_scope_renewal.py
@@ -0,0 +1,261 @@
+"""Authority-bound renewal of ONE scope-stopped episode. [daveey]
+
+A worker's ``kanban_retain(reason='scope_stopped')`` restricts its card: no promotion, comment, timer or review
+releases it (``kanban_spend_decision``). ``scope_renewed`` is the one release of that restriction, and only of it:
+
+* it names one stop episode (the ``spend_budget_triaged`` uid) and one mandate comment, written after the stop by
+  the same authority that renews: a human operator, the card's owning chat (an unreleased ``created`` chat link;
+  ``shepherd``/``touch`` observers never qualify) or the card's creator task. Runs of the stopped card never renew;
+* it freezes the exact scope evidence it covers (``covered_restriction_uids``). Execution readers ignore covered
+  evidence only; evidence added later, a new stop, and every safety restriction stay restrictive;
+* it does not promote, claim or touch spend: the card stays in triage under its pending decision until a
+  ``hermes kanban promote`` recorded AFTER the renewal, and ``kanban_spend_budget`` keeps the historical floor
+  (``kanban_spend_decision.restricted_floor``), so a renew-then-promote cycle cannot open a fresh window.
+
+A mandate edited after the renewal no longer matches its frozen digest: the renewal stops covering (restricted
+again) and a fresh mandate plus a new renewal is the recovery.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import sqlite3
+from dataclasses import dataclass
+from typing import Any, Optional
+
+EVENT = "scope_renewed"
+STOP, RESTRICT = "spend_budget_triaged", "decision_hold_restricted"
+MAX_MANDATE = 8000  # the operator courier's comment bound: one limit on every path
+MAX_REASON = 2000
+ROUTE = ("record the renewed scope as a comment on the card, then "
+         "`hermes kanban renew-scope {task} --episode <stop uid> --mandate-comment <comment id> --reason <text>` "
+         "(a human operator, the card's owning chat or its creator task), then a separate "
+         "`hermes kanban promote {task} <what changed>`")
+
+
+class RenewalRefused(ValueError):
+    def __init__(self, code: str, message: str):
+        super().__init__(message)
+        self.code = code
+
+
+@dataclass(frozen=True)
+class Actor:
+    """Who renews, as the comment classifier sees them. ``authority``: human | chat | creator_task."""
+    kind: str
+    session: Optional[str]
+    authority: str
+    ref: Optional[str] = None
+    gateway: str = ""
+    profile: str = "default"
+
+
+def key(event: dict) -> str:
+    return event.get("uid") or str(event["id"])
+
+
+def _payload(raw: Any) -> dict:
+    if isinstance(raw, dict):
+        return raw
+    try:
+        data = json.loads(raw or "{}")
+    except (TypeError, ValueError):
+        return {}
+    return data if isinstance(data, dict) else {}
+
+
+def digest(body: str) -> str:
+    return hashlib.sha256(body.encode("utf-8")).hexdigest()
+
+
+def _columns(conn: sqlite3.Connection, table: str) -> set:
+    return {r[1] for r in conn.execute(f"PRAGMA table_info({table})")}
+
+
+def comment_ref(row: dict) -> str:
+    """Portable identity of a comment: its sync uid, else the local id on a board that never synced."""
+    return row.get("uid") or str(row["id"])
+
+
+def _comment(conn: sqlite3.Connection, task_id: str, ref: str) -> Optional[dict]:
+    if not ref:
+        return None
+    if "uid" in _columns(conn, "task_comments"):
+        row = conn.execute("SELECT * FROM task_comments WHERE task_id=? AND uid=?", (task_id, ref)).fetchone()
+        if row is not None:
+            return dict(row)
+    if ref.isascii() and ref.isdecimal():
+        row = conn.execute("SELECT * FROM task_comments WHERE task_id=? AND id=?", (task_id, int(ref))).fetchone()
+        if row is not None and comment_ref(dict(row)) == ref:
+            return dict(row)
+    return None
+
+
+def renewals(conn: sqlite3.Connection, task_id: str) -> list[dict]:
+    """Renewals whose frozen mandate is still the comment on the card; each with a parsed ``payload``."""
+    out = []
+    for row in conn.execute("SELECT * FROM task_events WHERE task_id=? AND kind=?", (task_id, EVENT)):
+        event = dict(row)
+        p = _payload(event["payload"])
+        uids = p.get("covered_restriction_uids")
+        if p.get("version") != 1 or not p.get("episode") or not isinstance(uids, list):
+            continue
+        mandate = _comment(conn, task_id, str(p.get("mandate_comment_uid") or ""))
+        if mandate is None or digest(mandate["body"]) != p.get("mandate_body_sha256"):
+            continue
+        out.append({**event, "payload": p})
+    return out
+
+
+def covered(conn: sqlite3.Connection, task_id: str) -> frozenset:
+    """Keys of scope evidence a valid renewal froze. Callers never apply it to safety evidence."""
+    return frozenset(str(uid) for r in renewals(conn, task_id) for uid in r["payload"]["covered_restriction_uids"])
+
+
+def reopened(conn: sqlite3.Connection, task_id: str, ordinary: list[dict]) -> Optional[dict]:
+    """The renewed stop that still waits for its own decision.
+
+    A renewal re-opens its stop at the renewal's position: only a promotion or archive recorded after it is that
+    decision. Without this, a promotion older than the scope annotation would release the card at renewal.
+    ``ordinary``: stop/promotion/archive events, newest first.
+    """
+    from hermes_cli.kanban_sync_divergence import _event_order
+    renewed = sorted(renewals(conn, task_id), key=_event_order, reverse=True)
+    if not renewed:
+        return None
+    decided = next((e for e in ordinary if e["kind"] != STOP), None)
+    for renewal in renewed:
+        if decided is not None and _event_order(decided) > _event_order(renewal):
+            return None
+        stop = next((e for e in ordinary if e["kind"] == STOP and key(e) == renewal["payload"]["episode"]), None)
+        if stop is not None:
+            return stop
+    return None
+
+
+def scope_evidence(conn: sqlite3.Connection, task_id: str, episode: str) -> list[dict]:
+    """Scope-cause stop/annotation rows and confirmed scope receipts bound to ``episode``. Never safety."""
+    from hermes_cli.kanban_spend_decision import receipt_restrictions
+    out = []
+    for row in conn.execute("SELECT * FROM task_events WHERE task_id=? AND kind IN (?,?)", (task_id, STOP, RESTRICT)):
+        event = dict(row)
+        p = _payload(event["payload"])
+        if p.get("cause") == "scope_stopped" and (key(event) if event["kind"] == STOP else p.get("episode")) == episode:
+            out.append(event)
+    for event in receipt_restrictions(conn, task_id):
+        p = _payload(event["payload"])
+        if p.get("superseded_by_safety_stop") is not True and p.get("episode_uid") == episode:
+            out.append(event)
+    return out
+
+
+def _mandate_event(conn: sqlite3.Connection, task_id: str, comment: dict) -> Optional[dict]:
+    """The one ``commented`` event bound to this comment (uid on synced boards, local id otherwise)."""
+    found = []
+    for row in conn.execute("SELECT * FROM task_events WHERE task_id=? AND kind='commented'", (task_id,)):
+        event = dict(row)
+        p = _payload(event["payload"])
+        bound = (p.get("comment_uid") == comment["uid"] if comment.get("uid")
+                 else p.get("comment_uid") is None and p.get("comment_id") == comment["id"])
+        if bound:
+            found.append({**event, "payload": p})
+    return found[0] if len(found) == 1 else None
+
+
+def _creator_sessions(conn: sqlite3.Connection, creator: str) -> set:
+    return {str(s) for (raw,) in conn.execute(
+        "SELECT payload FROM task_events WHERE task_id=? AND kind='owner_admitted'", (creator,))
+        if (s := _payload(raw).get("session_id"))}
+
+
+def _writer_refusal(conn: sqlite3.Connection, actor: Actor, event: dict) -> Optional[str]:
+    """None when the mandate was written by the renewing authority, on what the ``commented`` event records."""
+    p = event["payload"]
+    if actor.authority == "human":
+        if p.get("writer_kind") != "human":
+            return "a human operator renews on a mandate comment a human wrote"
+        if actor.gateway and event.get("origin_gateway") and event["origin_gateway"] != actor.gateway:
+            return f"the mandate comment was written on {event['origin_gateway']}, not this gateway"
+        return None
+    if p.get("writer_kind") != "agent":
+        return "the mandate comment was not written by the renewing agent"
+    if actor.authority == "creator_task":
+        if p.get("writer_task") == actor.ref or p.get("writer_session") in _creator_sessions(conn, str(actor.ref)):
+            return None
+        return f"the mandate comment was not written by creator task {actor.ref}"
+    if p.get("writer_task") or not actor.session or p.get("writer_session") != actor.session:
+        return "the mandate comment was not written by this owning chat"
+    return None
+
+
+def prepare(conn: sqlite3.Connection, task_id: str, *, episode: str, comment_id: int, reason: str,
+            actor: Actor) -> dict:
+    """The ``scope_renewed`` payload, or :class:`RenewalRefused`. Call inside the write transaction that appends it."""
+    from hermes_cli import kanban_spend_decision as ksd
+    from hermes_cli.kanban_refusal_receipt import restricted as safety_restricted
+    from hermes_cli.kanban_sync_divergence import _event_order
+    reason = (reason or "").strip()
+    if not reason or len(reason) > MAX_REASON:
+        raise RenewalRefused("invalid_reason", f"--reason is required (at most {MAX_REASON} characters)")
+    task = conn.execute("SELECT status, current_run_id, claim_lock FROM tasks WHERE id=?", (task_id,)).fetchone()
+    if task is None:
+        raise RenewalRefused("no_such_task", f"no such task {task_id}")
+    if safety_restricted(conn, task_id):
+        raise RenewalRefused("safety_restricted", ksd.execution_refusal(conn, task_id) or "safety restriction retained")
+    if task[0] != "triage" or task[2]:
+        raise RenewalRefused("not_stopped", f"{task_id} is {task[0]}, not held in triage by a scope stop")
+    stop = ksd.pending_episode(conn, task_id)
+    current = key(stop) if stop else None
+    if stop is None or stop["kind"] != STOP or current != episode:
+        raise RenewalRefused("episode_mismatch", f"episode {episode} is not {task_id}'s current stop ({current}); "
+                             "reread the card")
+    done = covered(conn, task_id)
+    evidence = [e for e in scope_evidence(conn, task_id, episode) if key(e) not in done]
+    if not evidence:
+        raise RenewalRefused("not_scope_stopped", f"stop {episode} on {task_id} carries no unrenewed scope restriction")
+    comment = conn.execute("SELECT * FROM task_comments WHERE task_id=? AND id=?", (task_id, int(comment_id))).fetchone()
+    body = (comment["body"] or "").strip() if comment is not None else ""
+    if not body:
+        raise RenewalRefused("mandate_missing", f"comment {comment_id} is not a non-empty comment on {task_id}")
+    if len(body) > MAX_MANDATE:
+        raise RenewalRefused("mandate_too_long", f"the mandate comment exceeds {MAX_MANDATE} characters; "
+                             "write a shorter one")
+    comment = dict(comment)
+    written = _mandate_event(conn, task_id, comment)
+    if written is None:
+        raise RenewalRefused("mandate_unattributable", f"comment {comment_id} has no single writer record; "
+                             "write a fresh mandate comment")
+    if why := _writer_refusal(conn, actor, written):
+        raise RenewalRefused("mandate_authority", why)
+    if any(_event_order(e) >= _event_order(written) for e in evidence):
+        raise RenewalRefused("mandate_stale", f"comment {comment_id} predates the scope stop it would renew; "
+                             "write the mandate after the stop")
+    return {"version": 1, "episode": episode, "mandate_comment_uid": comment_ref(comment),
+            "mandate_comment_id": comment["id"], "mandate_event_uid": key(written),
+            "mandate_body_sha256": digest(comment["body"]),
+            "covered_restriction_uids": sorted(key(e) for e in evidence),
+            "actor_kind": actor.kind, "actor_session": actor.session, "actor_gateway": actor.gateway,
+            "actor_profile": actor.profile, "authority_kind": actor.authority, "authority_ref": actor.ref,
+            "reason": reason}
+
+
+def renew_local(conn: sqlite3.Connection, task_id: str, *, episode: str, comment_id: int, reason: str,
+                actor: Actor) -> dict:
+    """Validate and append in one write transaction on a board with no canonical Board. Status is untouched."""
+    from hermes_cli import kanban_db as kb
+    with kb.write_txn(conn):
+        payload = prepare(conn, task_id, episode=episode, comment_id=comment_id, reason=reason, actor=actor)
+        kb._append_event(conn, task_id, EVENT, payload)
+    return payload
+
+
+def mandate(conn: sqlite3.Connection, task_id: str) -> Optional[dict]:
+    """The newest effective renewal's mandate for the next run's context, or None while restricted."""
+    from hermes_cli import kanban_spend_decision as ksd
+    from hermes_cli.kanban_sync_divergence import _event_order
+    valid = renewals(conn, task_id)
+    if not valid or ksd.execution_restricted(conn, task_id):
+        return None
+    renewal = max(valid, key=_event_order)
+    comment = _comment(conn, task_id, str(renewal["payload"]["mandate_comment_uid"]))
+    return {**renewal["payload"], "body": comment["body"], "mandate_comment_id": comment["id"]} if comment else None
diff --git a/hermes_cli/kanban_scope_renewal_cli.py b/hermes_cli/kanban_scope_renewal_cli.py
new file mode 100644
index 0000000000..fdda71993e
--- /dev/null
+++ b/hermes_cli/kanban_scope_renewal_cli.py
@@ -0,0 +1,159 @@
+"""``hermes kanban renew-scope``: who is asking, and where the renewal is decided. [daveey]
+
+The caller is identified exactly as ``hermes kanban comment`` identifies a comment's writer
+(``kanban_comment_writer.cli_comment_writer``); no flag names a role or session. On a synced board the canonical
+Board decides and writes the ``scope_renewed`` event (one ``renew_scope`` op, so a card whose home is another
+gateway needs no courier); a board that never synced validates and appends in one local transaction.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import sqlite3
+from typing import Mapping, Optional
+
+from hermes_cli import kanban_scope_renewal as renewal
+from hermes_cli.kanban_scope_renewal import Actor, RenewalRefused
+
+_TASK_MARKERS = ("HERMES_KANBAN_WORKER_TASK", "HERMES_KANBAN_TASK")
+_MARKED = re.compile(r"\d+:[A-Z][A-Z0-9_]*")  # an agent-marker ancestor; not a runner, a guess or a handle
+
+
+def _sessions(conn: sqlite3.Connection, task_id: str) -> set:
+    return renewal._creator_sessions(conn, task_id)
+
+
+def owning_link(conn: sqlite3.Connection, task_id: str, *, gateway: str, profile: str, session: str) -> Optional[dict]:
+    """This chat's unreleased ``created`` link (or the legacy owning subscription ``_chat_links`` projects).
+
+    ``shepherd``/``touch`` rows are observer subscriptions any chat can add to any card: never authority.
+    """
+    from hermes_cli.kanban_creator_chats import _chat_links
+    if not conn.execute("SELECT 1 FROM sqlite_master WHERE name='task_chat_links'").fetchone():
+        return _owning_sub(conn, task_id, session)
+    for link in _chat_links(conn, task_id):
+        if (link.get("kind", "created") == "created" and link["chat_session"] == session
+                and link["chat_gateway"] == gateway and (link.get("chat_profile") or "default") == profile):
+            return link
+    return None
+
+
+def _owning_sub(conn: sqlite3.Connection, task_id: str, session: str) -> Optional[dict]:
+    """A board that never synced has no chat links: the chat whose subscription was stamped at creation owns."""
+    from hermes_cli.kanban_db_notify import OBSERVER_SUB_REASONS
+    for row in conn.execute("SELECT chat_id, delivery_metadata FROM kanban_notify_subs WHERE task_id=? AND chat_id=?",
+                            (task_id, session)):
+        try:
+            reason = json.loads(row[1] or "{}").get("reason")
+        except (TypeError, ValueError, AttributeError):
+            continue
+        if reason and reason not in OBSERVER_SUB_REASONS:
+            return {"chat_session": session}
+    return None
+
+
+def resolve_actor(conn: sqlite3.Connection, task_id: str, *, writer: tuple, env: Mapping[str, str],
+                  gateway: str, profile: str) -> Actor:
+    """The renewing authority, or :class:`RenewalRefused`. The stopped card's own runs are refused first."""
+    from hermes_cli.kanban_archive_scope import _creator_task_id
+    kind, session, evidence = writer
+    if kind == "human":
+        return Actor("human", None, "human", None, gateway, profile)
+    marked = {str(env.get(name) or "").strip() for name in _TASK_MARKERS} - {""}
+    if task_id in marked or (session and session in _sessions(conn, task_id)):
+        raise RenewalRefused("own_run", f"a run of {task_id} cannot renew its own stopped scope")
+    if kind != "agent" or not session or not _MARKED.fullmatch(str(evidence)):
+        raise RenewalRefused("identity_unavailable", "the caller's identity is missing or ambiguous "
+                             f"({evidence}); renew from the owning chat, the creator task or a human terminal")
+    if len(marked) > 1:
+        raise RenewalRefused("identity_unavailable", "the caller carries two different task identities")
+    creator = _creator_task_id(conn, task_id)
+    if marked:
+        own = next(iter(marked))
+        row = conn.execute("SELECT status FROM tasks WHERE id=?", (own,)).fetchone()
+        if own != creator or row is None or row[0] != "running" or session not in _sessions(conn, own):
+            raise RenewalRefused("not_scope_authority", f"task {own} is not {task_id}'s running creator task")
+        return Actor("agent", session, "creator_task", own, gateway, profile)
+    if owning_link(conn, task_id, gateway=gateway, profile=profile, session=session) is None:
+        raise RenewalRefused("not_scope_authority", f"this session is not {task_id}'s owning chat (an unreleased "
+                             "created chat link); shepherd/touch subscriptions and unrelated agents cannot renew")
+    return Actor("agent", session, "chat", f"@session:{profile}@{gateway}/{session}", gateway, profile)
+
+
+def _canonical(conn: sqlite3.Connection, board: str, task_id: str, payload: dict, mode: str) -> dict:
+    """Ask the canonical Board to revalidate and write the event; project its exact row into this replica."""
+    from hermes_cli import kanban_db_sync as sync
+    from hermes_cli import kanban_sync_client as client
+    hub = client.Hub(client.load_identity())
+    try:
+        capability = hub.decision_retain_capability(board)
+        if not isinstance(capability, dict) or capability.get("scope_renewal") != 1:
+            raise RenewalRefused("board_unsupported", "the Board does not support scope renewal v1 yet; "
+                                 "nothing was changed. Retry after the Board deployment")
+        if mode == "primary":
+            client.push(conn, hub, board, hub.ident.gateway, primary=True)  # the mandate comment must be canonical
+        body = conn.execute("SELECT body FROM task_comments WHERE id=?", (payload["mandate_comment_id"],)).fetchone()[0]
+        event_uid = sync.uuid7()
+        audit = {k: payload[k] for k in ("actor_kind", "actor_session", "actor_profile", "authority_kind",
+                                         "authority_ref", "reason")}
+        wire = {"client_op_id": event_uid, "op": "renew_scope", "task": task_id, "event_uid": event_uid,
+                "episode": payload["episode"], "mandate_comment_uid": payload["mandate_comment_uid"],
+                "mandate_body": body, "payload": {"version": 1, **audit}}
+        results = hub.ops(board, [wire]).get("results", [])
+        if len(results) != 1 or results[0].get("client_op_id") != event_uid or results[0].get("status") != "applied":
+            reply = results[0] if len(results) == 1 else {}
+            raise RenewalRefused(str(reply.get("reason") or "board_rejected"),
+                                 f"the Board refused the renewal: {reply.get('reason') or 'no reply'}"
+                                 f"{': ' + str(reply['detail']) if reply.get('detail') else ''}")
+        proof = hub.row_evidence(board, "task_events", event_uid)
+        row = proof.get("row") if proof.get("state") == "live" else None
+        if not isinstance(row, dict) or row.get("kind") != renewal.EVENT or row.get("task_id") != task_id:
+            raise RenewalRefused("board_unconfirmed", "the Board applied the renewal but its event could not be "
+                                 "read back; rerun `hermes kanban show` after the next sync")
+        sync.apply_remote_changes(conn, [client._row_change("task_events", row)],
+                                  new_cursor=sync.sync_state(conn)["cursor"], board=board)
+        return json.loads(row["payload"])
+    finally:
+        hub.close()
+
+
+def renew(conn: sqlite3.Connection, task_id: str, *, episode: str, comment_id: int, reason: str,
+          board: Optional[str] = None, writer: Optional[tuple] = None,
+          env: Optional[Mapping[str, str]] = None) -> dict:
+    from hermes_cli import kanban_db_sync as sync
+    from hermes_cli.kanban_comment_writer import cli_comment_writer
+    from hermes_cli.kanban_origin import gateway_names
+    from hermes_cli.profiles import get_active_profile_name
+    env = os.environ if env is None else env
+    actor = resolve_actor(conn, task_id, writer=writer or cli_comment_writer(env=env), env=env,
+                          gateway=gateway_names()[0], profile=get_active_profile_name() or "default")
+    mode = sync.board_mode(conn)
+    if mode == "off" and not sync.sync_state(conn):
+        return renewal.renew_local(conn, task_id, episode=episode, comment_id=comment_id, reason=reason, actor=actor)
+    if mode == "off":
+        raise RenewalRefused("board_unavailable", "this board is synced but sync is not active in this process")
+    payload = renewal.prepare(conn, task_id, episode=episode, comment_id=comment_id, reason=reason, actor=actor)
+    return _canonical(conn, board or sync.sync_state(conn)["board_id"], task_id, payload, mode)
+
+
+def command(args: argparse.Namespace) -> int:
+    from hermes_cli import kanban_db as kb
+    try:
+        with kb.connect_closing() as conn:
+            payload = renew(conn, args.task_id, episode=args.episode, comment_id=args.mandate_comment,
+                            reason=args.reason)
+    except RenewalRefused as exc:
+        if getattr(args, "json", False):
+            print(json.dumps({"ok": False, "error": exc.code, "message": str(exc)}))
+        else:
+            print(f"renew-scope refused ({exc.code}): {exc}")
+        return 1
+    if getattr(args, "json", False):
+        print(json.dumps({"ok": True, "task_id": args.task_id, **payload}))
+    else:
+        print(f"Scope renewed on {args.task_id} for stop {payload['episode']} (mandate comment "
+              f"{payload['mandate_comment_uid']}). The card is still in triage: "
+              f"`hermes kanban promote {args.task_id} <what changed>` releases it.")
+    return 0
