+    await Promise.resolve()
+    expect(setSessionMutedRemote).toHaveBeenCalledWith(tip, true)
+    expect(isSessionParked('root', tip)).toBe(true)
+    expect(toggleSessionBlocked('root')).toBe(false)
+    await Promise.resolve()
+  })
+})
