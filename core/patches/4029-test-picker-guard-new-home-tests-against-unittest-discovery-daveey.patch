From de6a264f0b1abb370528e1b254ec20458e842af3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 01:48:28 +0000
Subject: [PATCH] test(picker): guard new home tests against unittest discovery
 [daveey]

---
 tests/test_home_key_fast_hit.py      | 1 +
 tests/test_home_path_construction.py | 1 +
 2 files changed, 2 insertions(+)

diff --git a/tests/test_home_key_fast_hit.py b/tests/test_home_key_fast_hit.py
index 5b399f0509..f5d0bc0da1 100644
--- a/tests/test_home_key_fast_hit.py
+++ b/tests/test_home_key_fast_hit.py
@@ -1,4 +1,5 @@
 """A warm home key need not allocate/reparse another Path."""
+if not __name__.startswith("tests."): raise ImportError("Use scripts/run_tests.sh; unittest discovery bypasses test isolation")  # unittest-discovery guard
 import hermes_constants as hc
 
 
diff --git a/tests/test_home_path_construction.py b/tests/test_home_path_construction.py
index 3b52dcf1c3..4f6c0b1593 100644
--- a/tests/test_home_path_construction.py
+++ b/tests/test_home_path_construction.py
@@ -1,4 +1,5 @@
 """Only immutable Path construction is memoized; home selection/expansion remains live."""
+if not __name__.startswith("tests."): raise ImportError("Use scripts/run_tests.sh; unittest discovery bypasses test isolation")  # unittest-discovery guard
 from pathlib import Path
 
 import hermes_constants as hc
-- 
2.43.0

