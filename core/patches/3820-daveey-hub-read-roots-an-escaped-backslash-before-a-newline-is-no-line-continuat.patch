From 2ff1eece61a106f4b8d2a2ac4dbd57b36055e7fc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:32:55 +0000
Subject: [PATCH] [daveey] hub-read roots: an escaped backslash before a
 newline is no line continuation

Review 5896823155 of PR #2559 @ b76cfea3b3 (request changes): `_CONTINUATION`
`\\\n` also removed the newline in `x\\<NL>`, where the first backslash quotes the
second and the newline ends the command. The joined spelling glued the next line
onto `x`, and the literal spelling keeps `c<NL>d` split, so
`x\\<NL>c\<NL>d ~/.hermes/logs && cat auth.json` cleared the logs root while
real bash cds into logs and prints auth.json.

Fix: only an odd run of backslashes continues a line:
`(?<!\\)((?:\\\\)*)\\\n`, substituted with `\1` (keeps the escaped pairs).
The reviewer's body is a new `test_controls_still_pin` row.

Proof:
- Real bash, HOME=<scratch>: the row prints <scratch>/.hermes/logs/auth.json.
- RED with prod at b76cfea3b3: the new row fails, the rest pass.
- GREEN: every test file importing kanban_placement_coordination (19 files,
  1024 passed); scripts/check --base origin/main ok.
---
 hermes_cli/kanban_placement_coordination.py    | 8 +++++---
 tests/hermes_cli/test_kanban_hub_read_roots.py | 2 ++
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_placement_coordination.py b/hermes_cli/kanban_placement_coordination.py
index e7855f291a..e0249b6bf0 100644
--- a/hermes_cli/kanban_placement_coordination.py
+++ b/hermes_cli/kanban_placement_coordination.py
@@ -197,12 +197,14 @@ _BACKTICK = re.compile(r"`")
 _CHDIR = re.compile(r"(?<![\w.-])(?:cd|pushd|popd)(?![\w.-])(?![ \t]+(?:~|/)(?![^\s;&|]*\.hermes)[\w./-]*(?=$|[\s;&|)]))")
 # Bash removes a whole backslash-newline before it splits words, so ``.\<NL>.`` is a ``..`` and ``c\<NL>d`` a cd
 # (review 5896219134 nit). Only ``\n`` continues a line: a backslash before ``\r`` quotes the CR, and the newline
-# after it starts a new command. Both spellings are judged, so neither join can hide a cd or ``..`` from the other.
-_CONTINUATION = re.compile(r"\\\n")
+# after it starts a new command. Only an odd run of backslashes continues: in ``x\\<NL>`` the first backslash
+# quotes the second and the newline ends the command (review 5896823155). Both spellings are judged, so neither
+# join can hide a cd or ``..`` from the other.
+_CONTINUATION = re.compile(r"(?<!\\)((?:\\\\)*)\\\n")
 
 
 def _strip_read_paths(text, roots):
-    splits = {_SPLIT.sub("", text), _SPLIT.sub("", _CONTINUATION.sub("", text))}
+    splits = {_SPLIT.sub("", text), _SPLIT.sub("", _CONTINUATION.sub(r"\1", text))}
     if (_DOTDOT.search(text) or _EXPANSION.search(text) or _PARAMETER.search(text) or _BACKTICK.search(text)
             or any(_DOTDOT.search(split) or _CHDIR.search(split) for split in splits)):
         return text
diff --git a/tests/hermes_cli/test_kanban_hub_read_roots.py b/tests/hermes_cli/test_kanban_hub_read_roots.py
index 32050c2d32..aeb828369f 100644
--- a/tests/hermes_cli/test_kanban_hub_read_roots.py
+++ b/tests/hermes_cli/test_kanban_hub_read_roots.py
@@ -178,6 +178,8 @@ def test_malformed_roots_clear_nothing(attested, roots):
     "c\\\nd ~/.hermes/logs && cat .\\\n./.env",
     "c\\\nd ~/.hermes/logs && cat auth.json",
     "cat x\\\r\ncd ~/.hermes/logs && cat .env",
+    # An escaped backslash is no continuation: its newline ends the command, and the next line's split cd runs.
+    "x\\\\\nc\\\nd ~/.hermes/logs && cat auth.json",
     # One row per exact anchor of the root-clearing guards: a mutant of each passed every other row.
     'ssh hermes-hub cat --file="~/.hermes/logs/a b/c"',
     "ssh hermes-hub cat ~/.hermes/logs/x.log .\\./.env",
