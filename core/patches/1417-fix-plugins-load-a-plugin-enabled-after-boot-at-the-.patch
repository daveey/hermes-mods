@@ -1257,10 +1262,19 @@ class PluginManager(PluginLoaderMixin, PluginDispatchMixin, PluginLedgerMixin):
             except BaseException:
                 self._discovered = False
                 raise
+            self._swept_fingerprint, self._swept_precheck = hook_stamp, precheck_stamp
             plugins_snapshot.record_hooks(hook_stamp, self, self.home_path)  # best-effort, never raises
         # Outside the lock: a listener (the gateway's re-wire) may read the registry from another thread.
         self._notify_plugin_loaded(loaded_before)
 
+    def refresh_if_inputs_changed(self) -> bool:
+        """[daveey] At a NEW-session agent build in a long-lived process (serve, gateway): rerun discovery
+        (forced, like ``load_and_go_live``) when its inputs changed since the last sweep, so a plugin
+        enabled after boot loads without a restart. True when a pass ran. Never call it mid-turn.
+        See :mod:`hermes_cli.plugins_refresh`."""
+        from hermes_cli.plugins_refresh import refresh_if_inputs_changed
+        return refresh_if_inputs_changed(self)
+
     def _re_register_config_hooks_after_force(self) -> None:
         """Restore config-owned shell hooks/outbound webhooks after a force clear; each guarded
         independently so one failing does not skip the other."""
@@ -2103,6 +2117,19 @@ def get_plugin_error_classification(
     return winner
 
 
+def refresh_plugins_for_new_session() -> bool:
+    """[daveey] :meth:`PluginManager.refresh_if_inputs_changed` for the active home's manager; never
+    raises (an agent build must not fail on it)."""
+    try:
+        from agent.safe_worker_policy import safe_worker_enabled
+        if safe_worker_enabled():
+            return False
+        return get_plugin_manager().refresh_if_inputs_changed()
+    except Exception:
+        logger.warning("plugin refresh before a new-session agent build failed", exc_info=True)
+        return False
+
+
 def _ensure_plugins_discovered(force: bool = False) -> PluginManager:
     """Return the global manager after idempotent (or ``force``d) discovery."""
     manager = get_plugin_manager()
diff --git a/hermes_cli/plugins_refresh.py b/hermes_cli/plugins_refresh.py
new file mode 100644
index 00000000000..93568e48812
--- /dev/null
+++ b/hermes_cli/plugins_refresh.py
@@ -0,0 +1,55 @@
+"""Session-boundary plugin refresh for long-lived processes. [daveey]
+
+A ``PluginManager`` discovers once: ``discover_and_load`` returns early once ``_discovered`` is set.
+``hermes plugins enable`` nudges only the host-level serve backend (its rendezvous record) and the
+gateway's control socket, so a per-profile ``hermes serve --isolated`` backend (a Desktop chat over
+SSH) that booted before the enable never loaded the plugin until it restarted: nine every-host
+guards enabled on the hub on 10-30 stayed out of all ten per-profile backends.
+
+:func:`refresh_if_inputs_changed` closes that gap where it is safe to: when a long-lived process
+builds the agent for a NEW session (``tui_gateway`` ``_make_agent``, the gateway's
+``_build_fresh_agent``), never mid-turn. It compares the discovery inputs against those the last
+sweep read and, only when they differ, runs the same forced pass ``load_and_go_live`` runs, under
+the same ``_GO_LIVE_LOCK`` + ``_discovery_lock``. Cost when nothing changed: one
+``plugins_snapshot.precheck`` (stat of config.yaml, .env and each top-level plugin dir); the full
+``fingerprint`` (~15-20 ms on the hub's plugin tree) runs only when the precheck moved.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+
+def refresh_if_inputs_changed(manager: Any) -> bool:
+    """Force-rediscover ``manager``'s plugins when their inputs changed since its last sweep. True when
+    a forced pass ran; False when the manager never discovered (its first lazy discovery reads the
+    current inputs anyway), the inputs are unchanged, or they could not be read."""
+    from hermes_cli import plugins_snapshot
+    from hermes_cli.plugins_loader import in_plugin_load_worker
+
+    if not manager._discovered or manager._swept_fingerprint is None or in_plugin_load_worker():
+        return False
+    home = manager.home_path
+    pre = plugins_snapshot.precheck(home)
+    if pre is not None and pre == manager._swept_precheck:
+        return False
+    stamp = plugins_snapshot.fingerprint(home)
+    if stamp is None:
+        return False
+    if stamp == manager._swept_fingerprint:
+        manager._swept_precheck = pre  # e.g. a __pycache__ dir appeared: nothing discovery reads moved
+        return False
+    from hermes_cli.plugins import _join_background_discovery
+    from hermes_cli.plugins_activation import _GO_LIVE_LOCK
+
+    _join_background_discovery()
+    with _GO_LIVE_LOCK, manager._discovery_lock:
+        if manager._swept_fingerprint == stamp:
+            return False  # another session's build swept these inputs while we waited
+        logger.info("plugin inputs for %s changed since the last discovery; reloading plugins for a new "
+                    "session", home)
+        manager.discover_and_load(force=True)
+    return True
diff --git a/hermes_cli/plugins_snapshot.py b/hermes_cli/plugins_snapshot.py
index 291914063a7..2bcaad7b867 100644
--- a/hermes_cli/plugins_snapshot.py
+++ b/hermes_cli/plugins_snapshot.py
@@ -172,6 +172,41 @@ def fingerprint(home: Optional[Path] = None) -> Optional[str]:
         return None
 
 
+def precheck(home: Optional[Path] = None) -> Optional[str]:
+    """[daveey] A cheap subset of :func:`fingerprint`'s inputs (~1 ms against ~15-20 ms on the hub's real
+    plugin tree): the discovery env flags, config.yaml and .env (``hermes plugins enable`` writes
+    ``plugins.enabled``), the user plugin root's entries and each top-level plugin dir's manifest and
+    ``__init__.py``. Unchanged means a long-lived process skips the full fingerprint at a session
+    boundary; a deep in-place edit of a plugin module is the one input it misses. None when it cannot
+    be computed (callers then compute the full fingerprint)."""
+    try:
+        from hermes_cli import plugins as _plugins
+
+        home = Path(home) if home is not None else get_hermes_home()
+        parts: list = [str(home), [[name, os.environ.get(name)] for name in _ENV_INPUTS]]
+        for name in ("config.yaml", ".env"):
+            parts.append(_stat_entry(home / name, name))
+        roots = [Path(_plugins.get_bundled_plugins_dir()), home / "plugins"]
+        if _plugins._env_enabled("HERMES_ENABLE_PROJECT_PLUGINS"):
+            roots.append(Path.cwd() / ".hermes" / "plugins")
+        for root in roots:
+            try:
+                names = sorted(n for n in os.listdir(root) if n not in _SKIP_DIRS)
+            except OSError as exc:
+                parts.append([str(root), "missing", exc.errno])
+                continue
+            parts.append(_stat_entry(root, str(root)))
+            for name in names:
+                entry = root / name
+                parts.append(_stat_entry(entry, name))  # follows a symlinked plugin to its directory
+                for leaf in ("plugin.yaml", "plugin.yml", "__init__.py"):
+                    parts.append(_stat_entry(entry / leaf, f"{name}/{leaf}"))
+        return hashlib.sha256(json.dumps(parts, default=str).encode()).hexdigest()
+    except Exception:
+        logger.debug("plugin discovery precheck failed", exc_info=True)
+        return None
+
+
 def builtin_collision() -> Optional[str]:
     """Why the live (discovered) plugin set may change built-in toolset membership, or None."""
     import toolsets
