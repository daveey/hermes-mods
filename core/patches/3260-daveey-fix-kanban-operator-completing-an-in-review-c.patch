From f2e7050ffd2ad6567861ebc4300b9d344e28816e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 08:15:04 +0000
Subject: [PATCH] [daveey] fix(kanban): operator completing an in-review card
 with a run id is told to omit it

Follow-up to PR #1926 review nit (review 5887681047, card t_01a1d3d928d91f9e).

require_review: an operator (no worker identity) completing a card in
'review' while passing expected_run_id was told only an operator may
approve without claiming, plus 'Run N is not its current run', with no
route to the approval it is allowed. The operator lane now also reads
'To approve it as the operator, complete it again without
expected_run_id.' (a card in review has no current run, so omitting the
id is the only route). The refusal stands; worker lanes keep their text;
no permission changes.

Proof: test_operator_stale_run_refusal_names_the_remedy[None] fails on
base 76ce83a7a8-descendant origin/main and passes on head; the two
worker-identity cases assert the remedy is absent, and the operator case
then completes via the named remedy. Mutant 'if not worker' -> 'if True'
fails the wording file. 4 review_required test files green.
---
 hermes_cli/kanban_review_required.py          |  2 ++
 .../test_kanban_review_required_wording.py    | 20 +++++++++++++++++++
 2 files changed, 22 insertions(+)

diff --git a/hermes_cli/kanban_review_required.py b/hermes_cli/kanban_review_required.py
index ed9f759c9e..a97907c0df 100644
--- a/hermes_cli/kanban_review_required.py
+++ b/hermes_cli/kanban_review_required.py
@@ -42,6 +42,8 @@ def require_review(conn, task_id: str, expected_run_id: int | None, *, placement
     if task.status == "review":  # never tell any lane an in-review card "is not in review"
         stale = ("" if expected_run_id is None else
                  f" Run {expected_run_id} is not its current run: a card pending review has none.")
+        if not worker:  # an operator reaches here only with a run id: name the allowed route
+            stale += " To approve it as the operator, complete it again without expected_run_id."
         raise ReviewRequiredError(
             f"{task_id} is pending review: a reviewer approves it by claiming the review run; only "
             f"{OPERATOR} may approve it without claiming it.{stale}"
diff --git a/tests/tools/test_kanban_review_required_wording.py b/tests/tools/test_kanban_review_required_wording.py
index 1e9f2aea32..e0b61f9abf 100644
--- a/tests/tools/test_kanban_review_required_wording.py
+++ b/tests/tools/test_kanban_review_required_wording.py
@@ -116,6 +116,26 @@ def test_in_review_card_with_stale_run_id_is_named_pending_review(board, monkeyp
     assert kb.get_task(board, tid).status == "review"  # still refused: no permission widened
 
 
+# --- PR #1926 review nit: the operator, who may approve, is told how ---
+
+
+@pytest.mark.parametrize("identity", (None, *IDENTITIES))
+def test_operator_stale_run_refusal_names_the_remedy(board, monkeypatch, identity):
+    tid, run = claimed(board, monkeypatch)
+    assert kb.request_review(board, tid, summary="implemented", expected_run_id=run)
+    as_operator(monkeypatch)
+    if identity:
+        monkeypatch.setenv(identity, "t_orchestrator")
+    with pytest.raises(ValueError) as refused:
+        kb.complete_task(board, tid, summary="approve", expected_run_id=run, force=True)
+    remedy = "without expected_run_id" in str(refused.value)
+    assert remedy is (identity is None)  # worker lanes keep their text: they may not approve unclaimed
+    assert kb.get_task(board, tid).status == "review"  # the refusal itself stands
+    if identity is None:  # and the remedy it names works
+        assert kb.complete_task(board, tid, summary="approve", force=True)
+        assert kb.get_task(board, tid).status == "done"
+
+
 def _dashboard(tmp_path):
     from fastapi import FastAPI
     from fastapi.testclient import TestClient
