Subject: [PATCH] [daveey] register origin forwarding in integration guard
 inventories

---
 tests/hermes_cli/serve_handler_ledger.json | 6 ++++--
 tests/hermes_cli/test_kanban_lockguard.py  | 2 ++
 tests/test_tests_tree_layout.py            | 1 +
 3 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/serve_handler_ledger.json b/tests/hermes_cli/serve_handler_ledger.json
index 07ae403ec87712a2d80eaacf145f182cab8bb528..6526ee6f2679e0928bd47fd633a6dfba90f34aab 100644
--- a/tests/hermes_cli/serve_handler_ledger.json
+++ b/tests/hermes_cli/serve_handler_ledger.json
@@ -5,7 +5,7 @@
    "undecided": 351
   },
   "rpc": {
-   "authority": 112,
+   "authority": 114,
    "keep-host-wide": 1,
    "undecided": 184
   },
@@ -679,7 +679,9 @@
   {"current_path": "legacy fallback; standalone: legacy server.dispatch", "decision": "undecided", "handler": "wake.status", "kind": "rpc", "ref": "D3"},
   {"current_path": "legacy fallback; standalone: legacy server.dispatch", "decision": "undecided", "handler": "wake.stop", "kind": "rpc", "ref": "D3"},
   {"current_path": "authority; standalone: unknown method", "decision": "authority", "handler": "worker.adopt", "kind": "rpc", "ref": ""},
+  {"current_path": "authority; standalone: unknown method", "decision": "authority", "handler": "worker.nativeOrigin", "kind": "rpc", "ref": ""},
   {"current_path": "authority; standalone: unknown method", "decision": "authority", "handler": "worker.persist", "kind": "rpc", "ref": ""},
-  {"current_path": "authority; standalone: unknown method", "decision": "authority", "handler": "worker.register", "kind": "rpc", "ref": ""}
+  {"current_path": "authority; standalone: unknown method", "decision": "authority", "handler": "worker.register", "kind": "rpc", "ref": ""},
+  {"current_path": "authority; standalone: unknown method", "decision": "authority", "handler": "worker.turnLease", "kind": "rpc", "ref": ""}
  ]
 }
diff --git a/tests/hermes_cli/test_kanban_lockguard.py b/tests/hermes_cli/test_kanban_lockguard.py
index d72b1842bad22fb6d4bcfdd91f078bd23f8a0a27..dcb0377f52410574c7d2c5f8c8c7921ee0d956c8 100644
--- a/tests/hermes_cli/test_kanban_lockguard.py
+++ b/tests/hermes_cli/test_kanban_lockguard.py
@@ -253,6 +253,8 @@ def test_kanban_modules_open_boards_only_through_the_guard():
         # state.db / hub.db / in-memory / offline copies, not live boards
         "kanban_worker_recovery.py", "kanban_transfer.py",
         "kanban_origin_ledger.py", "kanban_lockguard.py",
+        # Origin-local receipt and decision journals, never Kanban board connections.
+        "kanban_origin_forward.py", "kanban_origin_forward_decision.py",
         # connects only inside its own short-lived child (`python -m hermes_cli.kanban_db_recover`);
         # in-process callers (kanban_ops, the dispatcher) reach it only through spawn_recovery()
         "kanban_db_recover.py",
diff --git a/tests/test_tests_tree_layout.py b/tests/test_tests_tree_layout.py
index ff14f67295476e2dcf9053dd672f8c8bb93c51c7..2e6078873021903169921007255e2d5158755b5e 100644
--- a/tests/test_tests_tree_layout.py
+++ b/tests/test_tests_tree_layout.py
@@ -31,6 +31,7 @@ TESTS_ROOT = REPO_ROOT / "tests"
 # plumbing (env filtering, live-system guard, platform gating), not tests.
 _NON_MIRROR_DIRS = {
     "compat", "installation", "_fixtures",
+    "origin_transport",  # composed core argv → courier → core adapter transport, across repositories
     "ci", "conformance", "dashboard", "desktop", "docker", "e2e", "evals",
     "fakes", "fixtures", "install", "integration", "manual",
     "monitoring", "perf_guards", "scripts", "secret_sources",
