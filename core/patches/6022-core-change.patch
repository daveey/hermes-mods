diff --git a/hermes_cli/backup_prune.py b/hermes_cli/backup_prune.py
new file mode 100644
index 00000000000..916ce669088
--- /dev/null
+++ b/hermes_cli/backup_prune.py
@@ -0,0 +1,79 @@
+"""Pruning of quick state snapshots (``state-snapshots/<id>/``)."""
+import logging
+import shutil
+from pathlib import Path
+from typing import Callable, Optional, Sequence
+
+logger = logging.getLogger("hermes_cli.backup")
+
+QUICK_DEFAULT_KEEP = 20
+
+
+def _prune_quick_snapshots(
+    root: Path,
+    keep: int = QUICK_DEFAULT_KEEP,
+    protect: Optional[Callable[[Path], bool]] = None,
+) -> int:
+    """Remove oldest quick snapshots beyond the keep limit. Returns count deleted.
+
+    ``protect``: a snapshot beyond the limit for which it returns True is left in place.
+    """
+    if not root.exists():
+        return 0
+
+    dirs = sorted(
+        (
+            d
+            for d in root.iterdir()
+            if d.is_dir() and not d.name.startswith(".") and not d.name.endswith(".partial")
+        ),
+        key=lambda d: d.name,
+        reverse=True,
+    )
+
+    deleted = 0
+    for d in dirs[keep:]:
+        if protect is not None and protect(d):
+            continue
+        try:
+            shutil.rmtree(d)
+            deleted += 1
+        except OSError as exc:
+            logger.warning("Failed to prune snapshot %s: %s", d.name, exc)
+
+    return deleted
+
+
+def prune_after_snapshot(
+    root: Path, keep: int, failed_dbs: Sequence[str], oversized_skipped: Sequence[str]
+) -> None:
+    """Prune after a new quick snapshot landed in ``root``.
+
+    #68805 review: a snapshot is incomplete when a present DB failed to capture or
+    was skipped for size, and an older snapshot may then hold the only recoverable
+    copy. A failed capture keeps every older snapshot. A size skip keeps only the
+    older snapshots that really contain a skipped DB: the ones taken under the same
+    cap never held it, and keeping them all retained
+    unnecessary snapshots when a large database was skipped.
+    """
+    if failed_dbs:
+        logger.warning(
+            "Skipping snapshot prune because %d DB(s) failed to capture "
+            "— preserving older snapshots as recovery source",
+            len(failed_dbs),
+        )
+        return
+    if not oversized_skipped:
+        _prune_quick_snapshots(root, keep=keep)
+        return
+    print(
+        "  ⚠ DB file(s) skipped for size: "
+        + ", ".join(oversized_skipped)
+        + " — older snapshots that contain them are kept"
+    )
+    logger.warning("Quick snapshot skipped oversized DB file(s): %s", ", ".join(oversized_skipped))
+    _prune_quick_snapshots(
+        root,
+        keep=keep,
+        protect=lambda d: any((d / rel).is_file() for rel in oversized_skipped),
+    )
diff --git a/tests/hermes_cli/test_backup_prune.py b/tests/hermes_cli/test_backup_prune.py
new file mode 100644
index 00000000000..94a89137c01
--- /dev/null
+++ b/tests/hermes_cli/test_backup_prune.py
@@ -0,0 +1,58 @@
+"""Quick-snapshot pruning after a size-capped or failed capture (hermes_cli.backup_prune)."""
+import sqlite3
+
+import pytest
+
+from tests.hermes_cli.test_backup import _advance_backup_clock
+
+
+class TestPruneAfterSnapshot:
+    @pytest.fixture
+    def hermes_home(self, tmp_path):
+        home = tmp_path / ".hermes"
+        home.mkdir()
+        (home / "config.yaml").write_text("model:\n  provider: openrouter\n")
+        conn = sqlite3.connect(str(home / "state.db"))
+        conn.execute("CREATE TABLE sessions (id TEXT PRIMARY KEY, data TEXT)")
+        conn.execute("INSERT INTO sessions VALUES ('s1', ?)", ("x" * 4096,))
+        conn.commit()
+        conn.close()
+        return home
+
+    def test_oversized_db_still_prunes_snapshots_that_never_held_it(self, hermes_home):
+        """A size-capped caller (pre-update: keep=1, 1 GiB cap) must not leak a
+        snapshot per run. Older snapshots taken under the same cap never held
+        the skipped DB, so they are no recovery source and are pruned; an older
+        snapshot that does hold it survives however many runs follow.
+        """
+        from hermes_cli.backup import create_quick_snapshot, list_quick_snapshots
+
+        complete_id = create_quick_snapshot(label="complete", hermes_home=hermes_home)
+        assert (hermes_home / "state-snapshots" / complete_id / "state.db").exists()
+
+        capped_ids = []
+        for n in range(4):
+            _advance_backup_clock()
+            capped_ids.append(create_quick_snapshot(
+                label=f"capped{n}", hermes_home=hermes_home, max_file_size=1024, keep=1
+            ))
+        assert all(capped_ids)
+
+        snap_ids = {s["id"] for s in list_quick_snapshots(limit=100, hermes_home=hermes_home)}
+        assert snap_ids == {complete_id, capped_ids[-1]}, snap_ids
+
+    def test_failed_db_capture_still_suppresses_all_pruning(self, hermes_home, monkeypatch):
+        """A DB that failed to capture keeps every older snapshot, as before."""
+        from hermes_cli import backup
+
+        first_id = backup.create_quick_snapshot(label="first", hermes_home=hermes_home)
+        _advance_backup_clock()
+        second_id = backup.create_quick_snapshot(label="second", hermes_home=hermes_home)
+        _advance_backup_clock()
+
+        monkeypatch.setattr(backup, "_safe_copy_db", lambda *a, **k: False)
+        third_id = backup.create_quick_snapshot(label="failed", hermes_home=hermes_home, keep=1)
+
+        snap_ids = {s["id"] for s in backup.list_quick_snapshots(limit=100, hermes_home=hermes_home)}
+        assert {first_id, second_id} <= snap_ids
+        assert third_id is None or third_id in snap_ids
