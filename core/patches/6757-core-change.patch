From f561fe16e9b193bdfe2dc0403e8f9ead68bdafe5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 27 Nov 2026 08:44:39 +0000
Subject: [PATCH 6757] Origin-forward refusals, queued-create wait handles and wait-check parsing

Public mirror of source commit f561fe16e9b193bdfe2dc0403e8f9ead68bdafe5.

---
diff --git a/hermes_cli/kanban_origin_creation.py b/hermes_cli/kanban_origin_creation.py
index bab0c33b4750cdd10501ce240998a248787aab2d..2008e9cd4b611b1e8f4c416e8fd560a671407138 100644
--- a/hermes_cli/kanban_origin_creation.py
+++ b/hermes_cli/kanban_origin_creation.py
@@ -209,7 +209,9 @@
         # Validate under the same write lock, before calling code that can insert
         # a task. Generic exceptions (including postcommit ValueError) prove no
         # such absence and must retain the owner's pending semantics.
-        missing = kb._missing_task_ids(conn, options["parents"])
+        # Same normalisation as create_task (falsy entries are never linked); the
+        # stored immutable envelope keeps its original parents unchanged.
+        missing = kb._missing_task_ids(conn, [p for p in options["parents"] if p])
         if missing:
             from hermes_cli.kanban_dependency_validation import missing_dependency_error
             raise OriginCreateRefused("origin_parent_unknown", str(missing_dependency_error(missing)))
diff --git a/tests/hermes_cli/test_origin_create_validation.py b/tests/hermes_cli/test_origin_create_validation.py
index 645423e1f973ea7162f2c808ca9bb0274a2fe6d0..176c1d0b4aae47f31597a3e3fdbf297f9506313e 100644
--- a/tests/hermes_cli/test_origin_create_validation.py
+++ b/tests/hermes_cli/test_origin_create_validation.py
@@ -68,3 +68,28 @@
     replay = helpers.invoke(world, monkeypatch, capsys)
     assert replay.get('created') is True, replay
     assert _counts() == before
+
+
+def test_empty_parent_entry_still_creates_like_create_task(world, monkeypatch, capsys):
+    """create_task drops falsy parents; the pre-insert check must not refuse them."""
+    world['args']['create']['parents'] = ['']
+    before = _counts()
+    result = helpers.invoke(world, monkeypatch, capsys)
+    assert result.get('created') is True, result
+    after = _counts()
+    assert after['tasks'] == before['tasks'] + 1
+    assert after['task_links'] == before['task_links']
+    assert world['args']['create']['parents'] == ['']
+
+
+def test_mixed_empty_and_missing_parent_rejects_naming_only_missing(world, monkeypatch, capsys):
+    from hermes_cli.kanban_dependency_validation import missing_dependency_error
+
+    world['args']['create']['parents'] = ['', 't_missing_parent']
+    before = _counts()
+    result = helpers.invoke(world, monkeypatch, capsys)
+    assert result.get('status') == 'rejected', result
+    assert result['code'] == 'origin_parent_unknown'
+    assert str(missing_dependency_error(['t_missing_parent'])) in result['error']
+    assert str(missing_dependency_error(['', 't_missing_parent'])) not in result['error']
+    assert _counts() == before
