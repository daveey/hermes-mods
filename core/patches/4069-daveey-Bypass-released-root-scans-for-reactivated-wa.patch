From 5f2cda3eedaf967b84ad0463d68eba3045c0a769 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 02:07:22 +0000
Subject: [PATCH] [daveey] Bypass released-root scans for reactivated watcher
 owners

Address review 5900611992: check per-path owner reactivation before resolving released roots. Subsequent release still removes reactivation and prevents descriptor retention.

Proof: new regression fails on prior head at path_is_under, then 62 tests pass across all four watch_store importing suites. Two-root 10000-pass thread-CPU mechanism replay: 78.743us before, 0.302us after. Existing thresholds unchanged. Full check found unrelated stale-base kanban_db_dispatch FILE_LINES; canonical ship rebase will rerun the gate.
---
 tests/tui_gateway/test_watch_store_release.py | 20 +++++++++++++++++++
 tui_gateway/watch_store.py                    |  4 +++-
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_watch_store_release.py b/tests/tui_gateway/test_watch_store_release.py
index 49711717fd..87bc199f82 100644
--- a/tests/tui_gateway/test_watch_store_release.py
+++ b/tests/tui_gateway/test_watch_store_release.py
@@ -75,6 +75,26 @@ def test_release_covers_evicted_stores_and_reactivation_is_per_path(tmp_path):
     assert not has_live_connection(paths[0])
 
 
+def test_reactivated_owner_skips_released_root_scans(tmp_path, monkeypatch):
+    import hermes_state_common
+
+    path = tmp_path / "released" / "state.db"
+    create(path)
+    watch_store.release_under(path.parent)
+    watch_store.release_under(tmp_path / "other")
+    with contextlib.closing(_connect_tracked_db(path, tracking_path=path)):
+        observe(path)
+        assert str(path) in watch_store._reactivated
+        with monkeypatch.context() as patch:
+            def unexpected_scan(*_args):
+                pytest.fail("reactivated owner must bypass released-root resolution")
+            patch.setattr(hermes_state_common, "path_is_under", unexpected_scan)
+            assert not watch_store._transient(str(path))
+    close_all_under(path.parent)
+    assert watch_store._transient(str(path))
+    assert str(path) not in watch_store._reactivated
+
+
 def content(path, cache):
     def read(conn, _key):
         return conn.execute("SELECT title FROM sessions").fetchone()[0], False
diff --git a/tui_gateway/watch_store.py b/tui_gateway/watch_store.py
index 1c968dc27d..ce9a477ede 100644
--- a/tui_gateway/watch_store.py
+++ b/tui_gateway/watch_store.py
@@ -91,8 +91,10 @@ def release_under(root=None) -> int:
 def _transient(path: str) -> bool:
     from hermes_state_common import path_is_under
     from hermes_cli.sqlite_safe_read import has_live_connection
+    if path in _reactivated:
+        return False
     released = _release_all or any(path_is_under(Path(path), root) for root in _released_roots)
-    if not released or path in _reactivated:
+    if not released:
         return False
     # Check before opening our own tracked observer, which must never reactivate itself.
     if has_live_connection(path):
