From a8313b601fa6527f52de6a79d8bd2d2487eac824 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 09:36:36 +0000
Subject: [PATCH] [daveey] Preserve complete CI audit rows in acceptance
 receipts

---
 hermes_cli/kanban_pr_merge_time.py            |  4 +++
 tests/hermes_cli/test_kanban_pr_merge_time.py | 25 +++++++++++++++++++
 2 files changed, 29 insertions(+)

diff --git a/hermes_cli/kanban_pr_merge_time.py b/hermes_cli/kanban_pr_merge_time.py
index 1f3d9fe6090..8a68f4172e9 100644
--- a/hermes_cli/kanban_pr_merge_time.py
+++ b/hermes_cli/kanban_pr_merge_time.py
@@ -19,6 +19,10 @@ def check_receipt(check, sha):
     outcome = check.get("conclusion") if is_run else check["state"]
     return {"name": check.get("name", check.get("context")), "id": check["id"],
             "url": check.get("html_url") or check.get("target_url"),
+            # Retention deletes GitHub runs too. Keep audit rows in pr_acceptance
+            # events, including chronology, rather than only an expiring URL.
+            "html_url": check.get("html_url") or check.get("target_url"),
+            "completed_at": check.get("completed_at") if is_run else check.get("created_at"),
             "head_sha": check.get("head_sha", check.get("sha")),
             "classification": _classify(check, sha, outcome, is_run), "conclusion": outcome}
 
diff --git a/tests/hermes_cli/test_kanban_pr_merge_time.py b/tests/hermes_cli/test_kanban_pr_merge_time.py
index 34f08404b38..32342223d91 100644
--- a/tests/hermes_cli/test_kanban_pr_merge_time.py
+++ b/tests/hermes_cli/test_kanban_pr_merge_time.py
@@ -299,6 +299,31 @@ def test_nonfailure_postmerge_checks_do_not_claim_main_is_red(evidence, conclusi
     assert receipt["post_merge_checks"][0]["conclusion"] == conclusion
 
 
+def test_completed_landing_proof_survives_github_expiry(evidence, monkeypatch):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_db_connect import connect
+    import json
+
+    url = "https://github.com/acme/repo/actions/runs/123/job/456"
+    evidence["runs"][1]["html_url"] = url
+    kb.init_db()
+    with connect() as conn:
+        task = kb.create_task(conn, title="Archive landing", completion_contract="acme/repo")
+        assert kb.complete_task(conn, task, summary="verified", metadata={
+            "published_pr": "https://github.com/acme/repo/pull/7"})
+    # The producer has completed. No GitHub result remains for the auditor.
+    evidence["runs"] = []
+    monkeypatch.setattr(acceptance, "_api", lambda *a, **kw: pytest.fail("offline audit contacted GitHub"))
+    with connect() as conn:
+        receipt = json.loads(conn.execute(
+            "SELECT payload FROM task_events WHERE task_id=? AND kind='pr_acceptance'", (task,)).fetchone()[0])
+    assert receipt["ok"] and receipt["pr_state"] == "MERGED"
+    row, = receipt["checks"]
+    assert {key: row[key] for key in ("name", "head_sha", "conclusion", "completed_at", "html_url")} == {
+        "name": NAME, "head_sha": SHA, "conclusion": "success",
+        "completed_at": PRE["completed_at"], "html_url": url}
+
+
 @pytest.mark.parametrize("owner_state", ["ready", "done", "archived", None])
 def test_completion_receipt_names_main_health_owner(evidence, owner_state):
     from hermes_cli import kanban_db as kb
