index 0000000000..5bc051c922
--- /dev/null
+++ b/tests/gateway/test_deferred_managed_runtime.py
@@ -0,0 +1,142 @@
+"""Deferred gateway routes must reach the common agent billing boundary."""
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock, patch
+
+import pytest
+import run_agent  # bootstrap discovery before the isolated-home guard
+
+from agent.i18n import t
+from agent.model_routing import ModelRoutingError
+from gateway.run import GatewayRunner
+from gateway.session import Platform, SessionSource
+from hermes_cli.config import atomic_config_write
+from tests.agent import test_managed_subscription as fixtures
+from tests.tui_gateway import test_class_routing as desktop_fixtures
+
+native_transport = desktop_fixtures.native_transport
+
+managed = fixtures.managed
+routing_home = fixtures.routing_home
+streaming_route = fixtures.streaming_route
+
+
+@pytest.fixture
+def runner(monkeypatch, tmp_path):
+    monkeypatch.chdir(tmp_path)
+    runner = GatewayRunner.__new__(GatewayRunner)
+    runner.config = None
+    runner._provider_routing = {}
+    runner._session_db = None
+    runner._resolve_session_key_or_none = lambda *args: 'key'
+    runner._session_key_for_source = lambda source: 'key'
+    runner._rehydrate_session_model_override = lambda key: None
+    runner._peek_session_state = lambda key: None
+    runner._resolve_session_reasoning_config = lambda **kw: None
+    runner._resolve_session_service_tier = lambda **kw: None
+    runner._resolve_turn_toolsets = lambda *args: ([], None)
+    runner._refresh_fallback_model = lambda: [{'provider': 'openrouter', 'model': 'paid'}]
+    runner._thread_metadata_for_source = lambda *args: {}
+    runner._evict_cached_agent = Mock()
+    runner._persist_manual_compression = AsyncMock()
+    adapter = SimpleNamespace(send=AsyncMock(), emit_warning=AsyncMock(),
+                              extract_media=lambda text: ([], text),
+                              extract_images=lambda text: ([], text))
+    runner._delivery_adapter_for = lambda source: adapter
+    monkeypatch.setattr('model_tools.get_tool_definitions', lambda **kw: [])
+    monkeypatch.setattr('gateway.run._resolve_gateway_model', lambda *args: 'class:deep')
+    return runner
+
+
+def restore(runner, model):
+    """Feed persisted intent through the real session/runtime restoration path."""
+    exact = not model.startswith('class:')
+    row = {'model': model if exact else 'anthropic-deep', 'model_config': {'model_routing': {
+        'selected_model': model if exact else 'anthropic-deep',
+        'selected_provider': 'openrouter' if model == 'paid' else 'anthropic',
+        'requested_class': 'deep', 'exact_pin': exact}}}
+    runner.session_store = SimpleNamespace(_entries={'key': SimpleNamespace(session_id='pin')})
+    # Routing reads the persisted row; agent persistence is not under test here.
+    runner._session_db = SimpleNamespace(_db=SimpleNamespace(get_session=lambda sid: row),
+                                         get_session=AsyncMock(return_value=None))
+
+
+def source():
+    return SessionSource(platform=Platform.TELEGRAM, chat_id='fixture')
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('model', ['class:deep', 'anthropic-deep'])
+async def test_manual_compression_builds_deferred_agent(managed, runner, native_transport, model):
+    restore(runner, model)
+    built = []
+
+    def compress(agent, messages, request, **kwargs):
+        built.append(agent)
+        assert agent.model == 'anthropic-deep' and agent.provider == 'anthropic'
+        assert bool(agent.model_routing.get('exact_pin')) == (model == 'anthropic-deep')
+        assert agent._fallback_chain == []
+        return SimpleNamespace(status='nothing_to_do')
+
+    # Keep the production compression-agent builder and its guarded AIAgent constructor.
+    # The core compression algorithm is covered separately; this test pins its entry boundary.
+    with patch('agent.conversation_compression_manual.compress_now', side_effect=compress):
+        result = await runner._run_manual_compression(
+            source(), SimpleNamespace(session_id='pin'), [{'role': 'user', 'content': 'hi'}], None)
+    assert result == t('gateway.compress.nothing_to_do')
+    assert len(built) == 1
+    runner._evict_cached_agent.assert_called_once_with('key')
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('model', ['class:deep', 'anthropic-deep'])
+async def test_background_deferred_route_sends_native(managed, runner, native_transport, model):
+    restore(runner, model)
+    # Keep session intent for resolution without giving the fresh background agent a fake DB.
+    real_resolve = runner._resolve_session_agent_runtime
+
+    def resolve(**kwargs):
+        result = real_resolve(**kwargs)
+        runner._session_db = None
+        return result
+
+    runner._resolve_session_agent_runtime = resolve
+    with patch('gateway.run._load_gateway_config', return_value=managed):
+        await runner._run_background_task_inner('Say ok', source(), 'job')
+    adapter = runner._delivery_adapter_for(source())
+    adapter.emit_warning.assert_not_awaited()
+    assert 'ok' in adapter.send.call_args.kwargs['content']
+    assert native_transport
+    assert all(body['model'] == 'anthropic-deep' and url.startswith('https://api.anthropic.com/')
+               and headers.get('authorization', '').startswith('Bearer sk-ant-oat')
+               and 'x-api-key' not in headers for url, headers, body in native_transport)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('surface', ['compression', 'background'])
+async def test_restored_paid_pin_still_hits_billing_guard(managed, runner, native_transport, surface):
+    restore(runner, 'paid')
+    with patch('gateway.run._load_gateway_config', return_value=managed):
+        if surface == 'compression':
+            with pytest.raises(ModelRoutingError, match='Managed subscription policy'):
+                await runner._run_manual_compression(source(), SimpleNamespace(session_id='pin'), [], None)
+        else:
+            await runner._run_background_task_inner('Say ok', source(), 'job')
+            runner._delivery_adapter_for(source()).emit_warning.assert_awaited_once()
+            runner._delivery_adapter_for(source()).send.assert_not_awaited()
+    assert native_transport == []
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('surface', ['compression', 'background'])
+async def test_disabled_managed_policy_keeps_missing_credentials_error(managed, runner, tmp_path, surface):
+    managed['model_routing']['enabled'] = False
+    atomic_config_write(tmp_path / 'config.yaml', managed)
+    restore(runner, 'anthropic-deep')
+    with patch('run_agent.AIAgent') as agent, patch('gateway.run._load_gateway_config', return_value=managed):
+        if surface == 'compression':
+            result = await runner._run_manual_compression(source(), SimpleNamespace(session_id='pin'), [], None)
+            assert result == t('gateway.compress.no_provider')
+        else:
+            await runner._run_background_task_inner('Say ok', source(), 'job')
+            assert runner._delivery_adapter_for(source()).send.call_args.args[1] == t('gateway.background.no_credentials')
+        agent.assert_not_called()
