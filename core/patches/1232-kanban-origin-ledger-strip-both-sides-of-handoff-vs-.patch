From bf41d1e5e7d44390e8bc67e9ecd036de7ba0843e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 04:09:24 -0700
Subject: [PATCH] kanban origin ledger: strip both sides of
 handoff-vs-first-line evidence comparison

A 400-char cut landing after a space left the cut line with trailing whitespace while the recorded summary was stripped, so evidence_ok was False and the owner-done card was never released.
---
 hermes_cli/kanban_origin_ledger.py                    | 2 +-
 tests/hermes_cli/test_kanban_origin_legacy_release.py | 8 +++++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_origin_ledger.py b/hermes_cli/kanban_origin_ledger.py
index 9d0b20227f3..ac8738873a9 100644
--- a/hermes_cli/kanban_origin_ledger.py
+++ b/hermes_cli/kanban_origin_ledger.py
@@ -189,7 +189,7 @@ def observe_owner_task(conn: sqlite3.Connection, task: dict, *, now: float) -> d
             # The event preview hides FINAL SEND blocks (public_summary), so accept that form of the first line too.
             from hermes_cli.kanban_final_send import public_summary
             evidence_ok = isinstance(judged, str) and (judged == recorded or (
-                recorded in (_first_line(judged, 400), _first_line(public_summary(judged), 400) or '')
+                recorded in (_first_line(judged, 400).strip(), (_first_line(public_summary(judged), 400) or '').strip())
                 and run is not None and run[0] == event[1]
                 and judged == (run[4] or '').strip()))
             goal_verified = bool(isinstance(subject, dict) and proof.get('snapshot') == digest(subject)
diff --git a/tests/hermes_cli/test_kanban_origin_legacy_release.py b/tests/hermes_cli/test_kanban_origin_legacy_release.py
index 961d5f2877b..e1485ebef73 100644
--- a/tests/hermes_cli/test_kanban_origin_legacy_release.py
+++ b/tests/hermes_cli/test_kanban_origin_legacy_release.py
@@ -95,7 +95,13 @@ def test_receipt_verified_card_keeps_the_lifecycle_basis(board):
     assert 'basis' not in evidence  # unchanged observations publish identical records
 
 
-@pytest.mark.parametrize('summary', ['x' * 750, 'Delivered.\n\nDetails line two', '  padded summary  '])
+@pytest.mark.parametrize('summary', ['x' * 750, 'Delivered.\n\nDetails line two', '  padded summary  ',
+    # The 400-char cut lands right after a space: the event preview ends in 'a', the cut line ends in ' '.
+    'a' * 399 + ' ' + 'b' * 300,
+    # Same cut through the FINAL SEND-hiding public preview.
+    'a' * 399 + ' ' + 'b' * 300 + '\nFINAL SEND for @session:default/20261026_abc: hello',
+    # Cut after a space on the first line of a multi-line handoff.
+    'a' * 399 + ' c\nsecond line'])
 def test_receipt_binds_the_full_handoff_not_the_events_first_line(board, summary):
     """The completed event keeps only the summary's first line (400 chars); the receipt binds the whole handoff."""
     with kbc.connect_closing() as conn:
