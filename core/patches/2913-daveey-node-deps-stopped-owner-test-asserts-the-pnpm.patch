From 19d753a092bb80524fbeb79a96b98ae93aa30f5c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 19:27:31 +0000
Subject: [PATCH] [daveey] node-deps stopped-owner test asserts the pnpm shim
 was still gated when stopped

The test "an owner stopped during its pnpm install cannot write into the
next owner's trees" only detects a stopped pnpm writing into the next
owner's trees while the shim is still blocked at its `read -r _ || :`
gate when the job is stopped. Nothing checked that: with the gate removed
the test passed 3/3 params, and with the gate removed plus the watcher
kill disabled it still passed 2/3, so a broken gate would silently stop
the test from detecting the bug it exists for.

The shim now touches owner.passed right after the read. The stop-wait also
ends early when that file appears, and the test asserts it is absent after
the stop-wait and again just before owner.input('\n'). The gate and every
timeout are unchanged.

Under taskset 2 cores + 4 busy loops: gate-removed mutant fails 3/3 params
at the new assertion; watcher-kill mutant still fails 3/3 at the
written-by-the-stopped-pnpm assertion.
---
 tests-js/node-deps.test.mjs | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/tests-js/node-deps.test.mjs b/tests-js/node-deps.test.mjs
index 8bdd911b5a..0f02d8e646 100644
--- a/tests-js/node-deps.test.mjs
+++ b/tests-js/node-deps.test.mjs
@@ -560,6 +560,7 @@ test.skipIf(process.platform === 'win32').each([[false, false], [true, false], [
   writeFileSync(join(dir, 'owner/pnpm'), ['#!/bin/sh', 'if [ "$1" = install ]; then',
     `  echo $$ > '${dir}/owner.started'`,
     '  read -r _ || :',
+    `  touch '${dir}/owner.passed'`,
     `  echo third > node_modules/.written-by-the-stopped-pnpm; touch '${dir}/relay.release'; '${pnpmCommand()}' "$@"; exit $?`,
     'fi', `exec '${pnpmCommand()}' "$@"`, ''].join('\n'))
   chmodSync(join(dir, 'owner/pnpm'), 0o755)
@@ -617,7 +618,11 @@ test.skipIf(process.platform === 'win32').each([[false, false], [true, false], [
   expect(state('owner.started')[0]).toBe(state('relay.pid')[0])
   expect(state('watcher.pid')[0]).not.toBe(state('relay.pid')[0])
   owner.stop()
-  await until(() => state('owner.started')[1]?.startsWith('T') && state('relay.pid')[1]?.startsWith('T'))
+  // The pnpm must still be held at its gate: one already past it did its work before the stop, and
+  // then nothing below could see a stopped pnpm write into the next owner's trees.
+  const passed = join(dir, 'owner.passed')
+  await until(() => existsSync(passed) || (state('owner.started')[1]?.startsWith('T') && state('relay.pid')[1]?.startsWith('T')))
+  expect(existsSync(passed)).toBe(false)
   expect(state('watcher.pid')[1]).not.toMatch(/^T/)
   expect(existsSync(join(source, 'node_modules/.written-by-the-stopped-pnpm'))).toBe(false)
   Object.assign(lockTiming, { stale: 1_500 })
@@ -627,6 +632,7 @@ test.skipIf(process.platform === 'win32').each([[false, false], [true, false], [
     Object.assign(lockTiming, timing)
   }
   const built = readFileSync(join(webOnly(source), 'built'), 'utf8')
+  expect(existsSync(passed)).toBe(false)
   owner.input('\n')
   owner.resume()
   const { code, output } = await owner.exit
