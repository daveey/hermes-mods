From 1301d369510295665666c8ea6130b7b5b658c927 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 09:11:01 +0000
Subject: [PATCH] fix(accounting): retain partial thread names with list args
 [daveey]

Thread accepts list args, but target inspection combined them with a partial's
argument tuple and raised TypeError. The fail-open wrapper preserved execution
while silently dropping residual attribution. Normalize the inspection copy
at the Thread boundary; leave the original invocation arguments untouched.

Proof: real Thread tests cover tuple/list with partial and nested Context.run
carriers. Before normalization, both list cases failed attribution while tuple
controls passed. GREEN focused 56 passed; all 17 direct importing suites 331
passed, 13 skipped, zero failures. Full scripts/check --base origin/main passes.
Removing normalization reproduces the exact two RED failures.

Follow-up to the non-blocking attribution finding on PR3662. This fixes naming,
not a claim of live CPU reduction; idle-Mac acceptance remains on its owner card.
---
 hermes_cli/loop_accounting.py                 |  4 ++--
 .../test_loop_accounting_thread_targets.py    | 24 +++++++++++++++++++
 2 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/loop_accounting.py b/hermes_cli/loop_accounting.py
index 20a02a7ffa8db6033b2895f64259d7edd482f099..d7acf3e57136c8832d91f08dfcd3572e3b229aeb 100644
--- a/hermes_cli/loop_accounting.py
+++ b/hermes_cli/loop_accounting.py
@@ -1048,9 +1048,9 @@ MAX_TARGET_KEYS = 64  # distinct thread targets; later ones fold into TARGET_OTH
 TARGET_OTHER = "other"
 
 
-def _target_key(target: Any, args: tuple = ()) -> str:
+def _target_key(target: Any, args: tuple | list = ()) -> str:
     """Name of a ``Thread`` target (``module.qualname``; a lambda also gets its line number)."""
-    target = _callable_target(target, args)
+    target = _callable_target(target, tuple(args))
     name = _callable_name(target)
     code = getattr(getattr(target, "__func__", target), "__code__", None)
     if name.endswith("<lambda>") and code is not None:
diff --git a/tests/hermes_cli/test_loop_accounting_thread_targets.py b/tests/hermes_cli/test_loop_accounting_thread_targets.py
index dac65b922e886e488e9fda0f3a40512b73f13926..7283892b2155fa5caec60403b9efb58611757f89 100644
--- a/tests/hermes_cli/test_loop_accounting_thread_targets.py
+++ b/tests/hermes_cli/test_loop_accounting_thread_targets.py
@@ -239,6 +239,30 @@ def test_reused_native_id_nested_scopes_do_not_double_count(monkeypatch):
     assert la._target_exited[la._target_key(replacement)]["accounted_cpu_s"] == pytest.approx(0.2)
 
 
+@pytest.mark.parametrize("carrier", ["partial", "context_partial"])
+@pytest.mark.parametrize("args_type", [tuple, list])
+def test_thread_carriers_preserve_sequence_args_attribution(carrier, args_type):
+    from contextvars import Context
+    from functools import partial
+
+    la.instrument_thread_targets()
+    seen = []
+
+    def original(first, second):
+        seen.append((first, second))
+
+    target = partial(original, 1)
+    args = args_type([2])
+    if carrier == "context_partial":
+        target = partial(Context().run, target)
+    th = threading.Thread(target=target, args=args)
+    th.start()
+    th.join()
+    assert seen == [(1, 2)]
+    assert la._target_key(original) in la._target_exited
+    assert la._target_exited[la._target_key(original)]["threads"] == 1
+
+
 def test_context_thread_names_original_target():
     from contextvars import Context
 
