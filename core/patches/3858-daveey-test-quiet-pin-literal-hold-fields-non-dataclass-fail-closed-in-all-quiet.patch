From 1f547fd133c582fb2ac4656385d94fe80e673afb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 21:11:08 +0000
Subject: [PATCH] [daveey] test(quiet): pin literal hold fields + non-dataclass
 fail-closed in all_quiet_deferred

Post-merge mutation check of #2570 (t_01a1d6962c783474) found two survivors in
hermes_cli/kanban_db_dispatch_stuck.py that passed all 10 tests of
tests/hermes_cli/test_quiet_gates_dispatch.py:

- M1e: moving "clock_held" from QUIET_HOLD_FIELDS to QUIET_COMPATIBLE_FIELDS.
  A quiet tick that also has clock_held then reads as all-quiet and loses its
  stuck accounting. The loop test took its expectations from the module's own
  (mutated) sets, so it could not catch this.
- M1d: dropping `dataclasses.is_dataclass(res) and`. A non-dataclass row then
  raises TypeError in dataclasses.fields instead of failing closed.

Tests only:
- test_quiet_with_literal_hold_field_keeps_stuck_accounting, parametrized over a
  hard-coded LITERAL_HOLD_FIELDS tuple (clock_held, rate_limited,
  no_progress_held, core_update_drain_hold, at_capacity and the rest). It is not
  derived from stuck.QUIET_HOLD_FIELDS.
- test_non_dataclass_row_fails_closed: a SimpleNamespace row carrying
  quiet_deferred gives `all_quiet_deferred(...) is False` and does not raise.

Proof (worker-4, base origin/main 987876f5d0a):
- head: scripts/run_tests.sh tests/hermes_cli/test_quiet_gates_dispatch.py
  gives 36 passed, 0 failed, 0 skipped
- M1e at exact anchor: 1 failed (test_quiet_with_literal_hold_field_keeps_stuck_accounting[clock_held])
- M1d at exact anchor: 1 failed (test_non_dataclass_row_fails_closed)
- scripts/check --base origin/main: 20 checks ok
---
 tests/hermes_cli/test_quiet_gates_dispatch.py | 31 +++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/tests/hermes_cli/test_quiet_gates_dispatch.py b/tests/hermes_cli/test_quiet_gates_dispatch.py
index 8d2c974533..9b3b102aab 100644
--- a/tests/hermes_cli/test_quiet_gates_dispatch.py
+++ b/tests/hermes_cli/test_quiet_gates_dispatch.py
@@ -197,3 +197,34 @@ def test_quiet_with_any_hold_field_keeps_stuck_accounting():
     for name in sorted(stuck.QUIET_COMPATIBLE_FIELDS - {"skipped_locked", "skipped_owned"}):
         row = dataclasses.replace(quiet, **{name: _truthy(by_name[name])})
         assert kbd.all_quiet_deferred([row]), name
+
+
+# Hard-coded on purpose: the loop above takes its expectations from the module's own sets, so moving a hold
+# (e.g. clock_held) into QUIET_COMPATIBLE_FIELDS would pass it while quiet then masks that hold (#2570 M1e).
+LITERAL_HOLD_FIELDS = (
+    "clock_held", "rate_limited", "no_progress_held", "core_update_drain_hold", "at_capacity",
+    "spawned", "skipped_unassigned", "skipped_nonspawnable", "skipped_per_profile_capped", "owner_down",
+    "skipped_ineligible", "claim_deferred", "admission_deferred", "capsule_refused", "pinned_quota_held",
+    "auto_blocked", "respawn_guarded", "crashed", "timed_out", "stale", "reclaimed", "reconciled_orphans",
+    "released_leftover_claims", "ownership_error", "memory_pressure",
+)
+
+
+@pytest.mark.parametrize("name", LITERAL_HOLD_FIELDS)
+def test_quiet_with_literal_hold_field_keeps_stuck_accounting(name):
+    from hermes_cli import kanban_db_dispatch_stuck as stuck
+    assert name in stuck.QUIET_HOLD_FIELDS and name not in stuck.QUIET_COMPATIBLE_FIELDS
+    ep = "episode-1"
+    quiet = kbd.DispatchResult(quiet_deferred=[("t_a", ep)], quiet_deadlines={ep: 5.0})
+    field = {f.name: f for f in dataclasses.fields(kbd.DispatchResult)}[name]
+    assert kbd.all_quiet_deferred([dataclasses.replace(quiet, **{name: _truthy(field)})]) is False
+    assert kbd.all_quiet_deferred([quiet, kbd.DispatchResult(**{name: _truthy(field)})]) is False
+
+
+def test_non_dataclass_row_fails_closed():
+    """A row that is not a DispatchResult dataclass never reads as all-quiet, and never raises (#2570 M1d)."""
+    row = SimpleNamespace(quiet_deferred=[("t_a", "episode-1")], quiet_deadlines={"episode-1": 5.0},
+                          skipped_locked=False, skipped_owned=False)
+    assert kbd.all_quiet_deferred([row]) is False
+    quiet = kbd.DispatchResult(quiet_deferred=[("t_a", "episode-1")])
+    assert kbd.all_quiet_deferred([quiet, row]) is False
