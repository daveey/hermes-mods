diff --git a/tests/gateway/test_gc_budget.py b/tests/gateway/test_gc_budget.py
new file mode 100644
index 00000000000..0ca002a6022
--- /dev/null
+++ b/tests/gateway/test_gc_budget.py
@@ -0,0 +1,74 @@
+"""Gateway and serve processes collect garbage less often and time every collection. [daveey]"""
+from __future__ import annotations
+
+import gc
+
+import pytest
+
+from gateway import gc_budget
+
+
+@pytest.fixture
+def restore_gc():
+    before = gc.get_threshold()
+    callbacks = list(gc.callbacks)
+    totals = {k: list(v) for k, v in gc_budget._totals.items()}
+    yield before
+    gc.set_threshold(*before)
+    gc.callbacks[:] = callbacks
+    gc_budget._totals.clear()
+    gc_budget._totals.update(totals)
+
+
+@pytest.mark.parametrize(("raw", "expected"), [
+    (None, gc_budget.GATEWAY_GC_THRESHOLD0), ("", gc_budget.GATEWAY_GC_THRESHOLD0),
+    ("50000", 50000), ("7000.9", 7000), ("0", None), ("-5", None), ("many", None), ("inf", None)])
+def test_threshold_from_environment(raw, expected):
+    environ = {} if raw is None else {gc_budget.ENV: raw}
+    assert gc_budget.gateway_gc_threshold0(environ) == expected
+
+
+def test_apply_raises_only_the_young_threshold(restore_gc):
+    gc.set_threshold(2000, 10, 10)
+    assert gc_budget.apply_gateway_gc_budget({}) == (gc_budget.GATEWAY_GC_THRESHOLD0, 10, 10)
+    assert gc_budget.apply_gateway_gc_budget({gc_budget.ENV: "0"}) == (gc_budget.GATEWAY_GC_THRESHOLD0, 10, 10)
+    gc.set_threshold(2000, 10, 10)
+    assert gc_budget.apply_gateway_gc_budget({gc_budget.ENV: "0"}) == (2000, 10, 10)  # opt-out keeps the default
+
+
+def test_apply_installs_one_timer_and_times_collections(restore_gc):
+    gc_budget.apply_gateway_gc_budget({})
+    gc_budget.apply_gateway_gc_budget({})
+    assert gc.callbacks.count(gc_budget._on_gc) == 1
+    gc_budget._totals.clear()
+    cycle = []
+    cycle.append(cycle)
+    del cycle
+    gc.collect()
+    gc.collect(0)
+    snap = gc_budget.snapshot()
+    assert snap["timed"] is True and snap["threshold"][0] == gc_budget.GATEWAY_GC_THRESHOLD0
+    full, young = snap["generations"]["2"], snap["generations"]["0"]
+    assert full["runs"] == 1 and young["runs"] == 1
+    assert full["collected"] >= 1
+    assert full["wall_s"] >= full["max_wall_s"] > 0
+    assert full["cpu_s"] >= 0
+
+
+def test_timer_survives_a_collection_started_while_the_accounting_lock_is_held(restore_gc):
+    from hermes_cli import loop_accounting
+
+    gc_budget.apply_gateway_gc_budget({})
+    with loop_accounting._lock:  # a collection can begin inside any allocation, this one included
+        gc.collect()
+    assert gc_budget.snapshot()["generations"]["2"]["runs"] >= 1
+
+
+def test_accounting_snapshot_reports_gc(restore_gc):
+    from hermes_cli import loop_accounting
+
+    gc_budget.apply_gateway_gc_budget({})
+    gc.collect()
+    snap = loop_accounting.snapshot()
+    assert snap["gc"]["generations"]["2"]["runs"] >= 1
+    assert snap["gc"]["threshold"][0] == gc_budget.GATEWAY_GC_THRESHOLD0
diff --git a/tests/tui_gateway/test_non_workspace_policy_cache.py b/tests/tui_gateway/test_non_workspace_policy_cache.py
index 173d0c0e897..c3b08f7d5db 100644
--- a/tests/tui_gateway/test_non_workspace_policy_cache.py
+++ b/tests/tui_gateway/test_non_workspace_policy_cache.py
@@ -84,3 +84,52 @@
     monkeypatch.setattr(server.time, "monotonic", lambda: now + server._NON_WORKSPACE_TTL_S + 1)
     assert server._is_non_workspace_path(str(second / "x"))
     assert not server._is_non_workspace_path(str(first / "x"))
+
+
+def _count_realpath(monkeypatch):
+    import os
+
+    calls = []
+    real = os.path.realpath
+    monkeypatch.setattr(server.os.path, "realpath", lambda p, *a, **k: calls.append(str(p)) or real(p, *a, **k))
+    return calls
+
+
+def test_canonical_path_is_resolved_once_per_ttl(homes, monkeypatch):
+    home, _, _ = homes
+    target = home / "repo"
+    target.mkdir()
+    monkeypatch.setattr(server, "_canonical_memo", {})
+    calls = _count_realpath(monkeypatch)
+    first = server._canonical_workspace_path(str(target))
+    resolved = len(calls)
+    assert resolved >= 1
+    assert [server._canonical_workspace_path(str(target)) for _ in range(50)] == [first] * 50
+    assert len(calls) == resolved  # the repeats made no filesystem call at all
+    assert server._canonical_workspace_path("") == ""
+
+
+def test_canonical_path_sees_a_relinked_alias_after_the_ttl(homes, monkeypatch):
+    import os
+
+    home, _, _ = homes
+    one, two, alias = home / "one", home / "two", home / "alias"
+    one.mkdir()
+    two.mkdir()
+    alias.symlink_to(one, target_is_directory=True)
+    monkeypatch.setattr(server, "_canonical_memo", {})
+    assert server._canonical_workspace_path(str(alias)) == os.path.normcase(os.path.realpath(one))
+    alias.unlink()
+    alias.symlink_to(two, target_is_directory=True)
+    assert server._canonical_workspace_path(str(alias)) == os.path.normcase(os.path.realpath(one))  # inside the TTL
+    now = server.time.monotonic()
+    monkeypatch.setattr(server.time, "monotonic", lambda: now + server._CANONICAL_TTL_S + 1)
+    assert server._canonical_workspace_path(str(alias)) == os.path.normcase(os.path.realpath(two))
+
+
+def test_canonical_memo_is_bounded(homes, monkeypatch):
+    monkeypatch.setattr(server, "_canonical_memo", {})
+    monkeypatch.setattr(server, "_CANONICAL_MAX", 10)
+    for i in range(35):
+        server._canonical_workspace_path(f"/nonexistent-hhp/{i}")
+    assert len(server._canonical_memo) <= 10
diff --git a/tui_gateway/methods_projects.py b/tui_gateway/methods_projects.py
index c77a4b48e42..dbe9fe77c37 100644
--- a/tui_gateway/methods_projects.py
+++ b/tui_gateway/methods_projects.py
@@ -139,9 +139,27 @@
     return {os.path.normcase(os.path.realpath(path)) for path in candidates if path}
 
 
+# ``realpath`` is one ``lstat`` per path component, and each releases the GIL. A tree build resolves
+# every session cwd several times; overlapping builds repeat syscall-heavy work
+# and GIL handoffs. A re-pointed symlink is seen after the TTL.
+_CANONICAL_TTL_S = 30.0
+_CANONICAL_MAX = 20000
+_canonical_memo: dict[str, tuple[float, str]] = {}
+
+
 def _canonical_workspace_path(path: str) -> str:
     """Resolve local aliases before policy checks and project/repo/lane keying."""
-    return os.path.normcase(os.path.realpath(path)) if path else ""
+    if not path:
+        return ""
+    now = time.monotonic()
+    hit = _canonical_memo.get(path)
+    if hit is not None and now < hit[0]:
+        return hit[1]
+    real = os.path.normcase(os.path.realpath(path))
+    if len(_canonical_memo) >= _CANONICAL_MAX:
+        _canonical_memo.clear()
+    _canonical_memo[path] = (now + _CANONICAL_TTL_S, real)
+    return real
 
 
 # The policy's resolved roots, kept while every input they are derived from is unchanged. One tree
