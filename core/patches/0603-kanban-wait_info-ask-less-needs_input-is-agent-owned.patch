From 2f6f37d635a4e2bfa7fd2f7947bcf4fb9ee9d7d4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 04:24:54 +0000
Subject: [PATCH] kanban wait_info: ask-less needs_input is agent-owned
 (matches AGENT_OWNED_KINDS); add _cmd_block refusal test

---
 hermes_cli/kanban_wait_info.py              |  5 +++--
 tests/hermes_cli/test_kanban_block_kinds.py | 12 ++++++++++++
 tests/hermes_cli/test_kanban_wait_info.py   | 13 +++++++++----
 3 files changed, 24 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_wait_info.py b/hermes_cli/kanban_wait_info.py
index 1a573b9518..761ad744ca 100644
--- a/hermes_cli/kanban_wait_info.py
+++ b/hermes_cli/kanban_wait_info.py
@@ -33,7 +33,7 @@ STALL_AFTER_S = 2 * 3600
 LIVE_PRODUCER_KINDS = ("card", "ci", "deploy", "external", "clock")
 # Block kinds only an agent clears (core kanban_block_policy.AGENT_OWNED_KINDS, plus assignment routing). Untyped
 # (None/legacy) blocks are agent-owned too, but uncertain: they only count once stalled.
-AGENT_BLOCK_KINDS = ("transient", "capability", "assignment")
+AGENT_BLOCK_KINDS = ("transient", "capability", "assignment", "needs_input")
 # Events that put a card into its current parked state; the newest one dates the wait and carries its reason.
 # ``continued`` is a continuation checkpoint parking the card ``scheduled`` with a ``wake_at``.
 PARK_EVENT_KINDS = ("scheduled", "blocked", "gave_up", "continuation_exhausted", "block_loop_detected",
@@ -193,7 +193,8 @@ def describe(status: Any, *, block_kind: Any = None, human: bool = False, park:
         if kind is None:
             return out("blocked:untyped", "an agent to clear an untyped block", True, certain=False)
         if kind != "time":
-            # needs_input (or another human kind) without a validated ask: the user's move, just not visible.
+            # another human kind without a validated ask: the user's move, just not visible. (An ask-less
+            # needs_input is agent-owned, handled above; a validated ask returns early as ``human``.)
             return out(f"blocked:{kind}", f"an unvalidated ask ({kind})", False)
     # scheduled, or blocked kind=time: a park. Who produces what it waits for?
     wake_at = epoch_s(payload.get("wake_at"))
diff --git a/tests/hermes_cli/test_kanban_block_kinds.py b/tests/hermes_cli/test_kanban_block_kinds.py
index 9cea3a74ca..9f6ff37166 100644
--- a/tests/hermes_cli/test_kanban_block_kinds.py
+++ b/tests/hermes_cli/test_kanban_block_kinds.py
@@ -351,3 +351,15 @@ def test_dispatcher_auto_decompose_tick_requests_human_skip(monkeypatch) -> None
     disp = kwd._KanbanDispatcher(SimpleNamespace(DEFAULT_BOARD="default"), settings)
     assert disp.auto_decompose_tick(5) == 0
     assert seen.get("skip_awaiting_human") is True
+
+
+def test_cmd_block_refuses_askless_needs_input(kanban_home: Path, capsys: pytest.CaptureFixture[str]) -> None:
+    """`hermes kanban block --kind needs_input` with no human_request is refused (rc 2) and the task is untouched."""
+    with kbc.connect_closing() as conn:
+        tid = _running_task(conn, title="askless")
+        args = argparse.Namespace(task_id=tid, ids=None, reason=["need", "a", "decision"], kind="needs_input")
+        assert kanban_cli._cmd_block(args) == 2
+        assert "agent_owned_block" in capsys.readouterr().err
+        task = kb.get_task(conn, tid)
+        assert (task.status, task.block_kind) == ("running", None)
+        assert not [e for e in kb.list_events(conn, tid) if e.kind == "blocked"]
diff --git a/tests/hermes_cli/test_kanban_wait_info.py b/tests/hermes_cli/test_kanban_wait_info.py
index 37f1f700b3..85f9b4a4f2 100644
--- a/tests/hermes_cli/test_kanban_wait_info.py
+++ b/tests/hermes_cli/test_kanban_wait_info.py
@@ -295,10 +295,15 @@ def test_parked_waits_lists_each_owning_session_with_wait_info(kanban_root):
 
 
 # ---- review fixes: false positives that must not wake anyone ------------------------------------------------------
-def test_needs_input_without_a_validated_ask_is_not_agent_owned():
-    info = d("blocked", block_kind="needs_input", human=False, park={"reason": "Two decisions for David"},
-             since=NOW - 30 * H)
-    assert info["agent_owned"] is False and info["wait_state"] == "waiting" and "unvalidated ask" in info["waiting_on"]
+def test_needs_input_without_a_validated_ask_is_agent_owned():
+    # Matches kanban_block_policy.AGENT_OWNED_KINDS: an ask-less needs_input is invisible to David, so an agent owns it.
+    from hermes_cli.kanban_block_policy import AGENT_OWNED_KINDS
+    assert "needs_input" in AGENT_OWNED_KINDS
+    fresh = d("blocked", block_kind="needs_input", human=False, park={"reason": "Two decisions for David"},
+              since=NOW - 60)
+    assert fresh["agent_owned"] is True and fresh["wait_state"] == "waiting"
+    stale = d("blocked", block_kind="needs_input", human=False, park={"reason": "x"}, since=NOW - 30 * H)
+    assert stale["agent_owned"] is True and stale["wait_state"] == "stalled"
 
 
 def test_untyped_legacy_block_counts_only_once_stalled():
