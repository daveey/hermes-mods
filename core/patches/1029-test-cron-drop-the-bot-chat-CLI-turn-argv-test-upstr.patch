From 8238320fd0dc86c66d299836ed9fc718994ad869 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:18:20 +0000
Subject: [PATCH] test(cron): drop the bot-chat CLI-turn argv test; upstream
 retired that lane [daveey]

Upstream 5d87060eb8c removed cron's local hermes chat -Q Bot Chat fallback
(scheduler_delivery._run_bot_chat_turn); delivery is admitted to the live owner
or parked, so there is no child argv left to check against a cwd checkout.
---
 .../test_worker_argv_ignores_cwd_checkout.py  | 24 ++++---------------
 1 file changed, 5 insertions(+), 19 deletions(-)

diff --git a/tests/hermes_cli/test_worker_argv_ignores_cwd_checkout.py b/tests/hermes_cli/test_worker_argv_ignores_cwd_checkout.py
index ab8418a83dd..c559c02e7d7 100644
--- a/tests/hermes_cli/test_worker_argv_ignores_cwd_checkout.py
+++ b/tests/hermes_cli/test_worker_argv_ignores_cwd_checkout.py
@@ -196,25 +196,11 @@ def test_cron_external_worker_argv_imports_the_install(monkeypatch, tmp_path, de
 
 
 # --- cron bot-chat delivery -------------------------------------------------------------
-
-
-def test_cron_bot_chat_turn_argv_imports_the_install(monkeypatch, tmp_path, decoy_checkout):
-    import cron.scheduler_delivery as delivery
-
-    root = tmp_path / "hermes"
-    (root / "profiles" / "beta").mkdir(parents=True)
-    monkeypatch.setenv("HERMES_HOME", str(root))
-    captured: dict = {}
-
-    def fake_turn(argv, env, report_path, timeout):
-        captured.update(argv=list(argv), env=dict(env))
-        return subprocess.CompletedProcess(argv, 0, stdout="", stderr="")
-
-    monkeypatch.setattr(delivery, "_run_bot_chat_turn", fake_turn)
-    assert delivery._deliver_to_bot_chat({"id": "j", "name": "nightly"}, "brief", "beta") is None
-
-    assert "hermes_cli.main" in captured["argv"]
-    _assert_install_tree(_imports_from(captured["argv"], captured["env"], decoy_checkout))
+# Fork: test_cron_bot_chat_turn_argv_imports_the_install was removed with its subject. Upstream
+# 5d87060eb8c ("cron bot-chat delivery has no local CLI fallback lane") retired the
+# ``hermes chat -Q`` child (``cron.scheduler_delivery._run_bot_chat_turn``); Bot Chat delivery is
+# now admitted to the target's live owner or parked (``cron.bot_chat_legacy.defer``), with no argv
+# to spawn from a cwd.
 
 
 def test_safe_path_flag_is_not_inherited_by_grandchildren(tmp_path):
