From 454ae626cc3bf1557d9dc25957263a0a928a0adc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 17:37:13 +0000
Subject: [PATCH] [daveey] test(gateway): read a turn's result from a settled
 receipt, not a terminal row

test_managed_turn_falls_back_like_the_in_process_turn flaked on CI with
KeyError: 'result' (run 43263846825). settle() waited for the
session_admissions row to read terminal, then read prompt.receipt once
with include_result. But commit_and_publish commits the terminal row
before it publishes the completion frame, and until then live.settling
makes the receipt read as the started claim, which carries no result.
A throttled owner widens that window.

Reproduced deterministically by holding the commit->publish window open
for 1.5 s in gateway/session_settlement_recovery.py (local only, not
committed): the receipt came back status=started while the row was
terminal, and the test failed with the CI KeyError. With the fix all
three files pass with the window held open.

Add settled_receipt() to the local_recovery_probe fixture: it polls
prompt.receipt itself (bounded by RPC_DEADLINE, returns as soon as it
reads terminal/unknown). Use it in the flaky file and in the two
siblings that made the same single read after a DB-row wait
(test_managed_worker_launch, test_session_policy_workspace_readiness).
---
 tests/gateway/fixtures/local_recovery_probe.py    | 15 +++++++++++++++
 tests/gateway/test_managed_worker_construct.py    | 10 +++-------
 tests/gateway/test_managed_worker_launch.py       |  4 ++--
 .../test_session_policy_workspace_readiness.py    |  5 ++---
 4 files changed, 22 insertions(+), 12 deletions(-)

diff --git a/tests/gateway/fixtures/local_recovery_probe.py b/tests/gateway/fixtures/local_recovery_probe.py
index 46b1d4636b..3b8510e949 100644
--- a/tests/gateway/fixtures/local_recovery_probe.py
+++ b/tests/gateway/fixtures/local_recovery_probe.py
@@ -85,6 +85,21 @@ async def rpc(ws, method, **params):
                 return reply
 
 
+async def settled_receipt(ws, sid, admission_id, timeout=RPC_DEADLINE):
+    """``prompt.receipt`` (with its committed result) once the receipt itself reads settled.
+
+    A ``terminal`` row in ``session_admissions`` is not enough: until the owner publishes the
+    completion frame (``live.settling``) the receipt still reads as the started claim and carries
+    no result. Poll the receipt, never the database row, for the result."""
+    async def read():
+        reply = await rpc(ws, 'prompt.receipt', session_id=sid, admission_id=admission_id, include_result=True)
+        assert 'result' in reply, reply
+        return reply if reply['result']['status'] in ('terminal', 'unknown') else None
+    settled = await async_wait_until(read, timeout=timeout, interval=.05, what=f'receipt {admission_id} settled')
+    assert settled is not None
+    return settled
+
+
 def websocket(home, desc, **kw):
     # These probes test RPC behavior, not heartbeat responsiveness. A CPU-starved
     # daemon can miss the library's 20s pong deadline before RPC_DEADLINE expires.
diff --git a/tests/gateway/test_managed_worker_construct.py b/tests/gateway/test_managed_worker_construct.py
index 894b1574dd..fed178b106 100644
--- a/tests/gateway/test_managed_worker_construct.py
+++ b/tests/gateway/test_managed_worker_construct.py
@@ -18,8 +18,7 @@ from types import SimpleNamespace
 
 import pytest
 
-from tests.gateway.fixtures.local_recovery_probe import child_env, daemon, rpc, websocket
-from tests.waiting import async_wait_until
+from tests.gateway.fixtures.local_recovery_probe import child_env, daemon, rpc, settled_receipt, websocket
 
 
 def _reply(handler, body, text):
@@ -101,11 +100,8 @@ def run_pair(tmp_path, extra_config, turn, *, before_create=None, **create_param
     async def settle(ws, sid, request_id, text):
         submitted = await rpc(ws, 'prompt.submit', session_id=sid, input_id=request_id, text=text)
         assert 'result' in submitted, submitted
-        await async_wait_until(
-            lambda: query('SELECT status FROM session_admissions WHERE request_id=?', (request_id,)) == [('terminal',)],
-            timeout=120, interval=.05, what=f'admission {request_id} terminal')
-        [(admission,)] = query('SELECT admission_id FROM session_admissions WHERE request_id=?', (request_id,))
-        receipt = await rpc(ws, 'prompt.receipt', session_id=sid, admission_id=admission, include_result=True)
+        receipt = await settled_receipt(ws, sid, submitted['result']['admission_id'])
+        assert receipt['result']['status'] == 'terminal', receipt
         return receipt['result']['result']
 
     results = {}
