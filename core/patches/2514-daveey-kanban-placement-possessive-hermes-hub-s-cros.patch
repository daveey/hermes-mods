From 9a84526dc2152a671a02f7f5e963e4febfae3e09 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 07:46:10 +0000
Subject: [PATCH] [daveey] kanban placement: possessive
 hermes-hub's/cross_task's prose is not an invocation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The coordination parser matched `hermes-hub` before `'s`, and a trailing `with `/`via `/`use ` in the prefix made it an explicit invocation with an empty action, so prose like "passes with hermes-hub's older core" refused as 'needs home coordination action'. Exclude a possessive ('s or ’s, not followed by a word char or hyphen) in the _HUB and _CROSS lookaheads. HOME_GATEWAY_MARKERS are unchanged.

Proof: new tests fail 5/5 on origin/main and pass after (140 passed across the coordination and access-contract suites). Mutants killed: no inner lookahead, no curly apostrophe, cross_task unfixed, hub unfixed, any-apostrophe exclusion. Replay over 10,632 distinct task rows (12 local board DBs + sync-shadow, mode=ro on hermes-worker-6): exactly one result changes, t_01a1cafd82625f0a, from (set(), needs home coordination action) to ({capability:core-ship}, None).
---
 hermes_cli/kanban_placement_coordination.py   |  5 ++--
 .../test_kanban_coordination_placement.py     | 29 +++++++++++++++++++
 2 files changed, 32 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_placement_coordination.py b/hermes_cli/kanban_placement_coordination.py
index 592538155b..f76888e72b 100644
--- a/hermes_cli/kanban_placement_coordination.py
+++ b/hermes_cli/kanban_placement_coordination.py
@@ -14,8 +14,9 @@ import time
 REASON = "needs worker coordination capability"
 ACTION_REASON = "needs home coordination action"
 # Intentionally narrower than the CLI: status and pull are the reader install's proof.
-_HUB = re.compile(r"(?<![\w/.-])hermes-hub\b(?![/.-])", re.IGNORECASE)
-_CROSS = re.compile(r"(?<![\w/.-])cross_task\b(?![/.-])", re.IGNORECASE)
+# A possessive (``hermes-hub's older core``) names the host in prose; it is not an invocation.
+_HUB = re.compile(r"(?<![\w/.-])hermes-hub\b(?![/.-]|['\u2019]s(?![\w-]))", re.IGNORECASE)
+_CROSS = re.compile(r"(?<![\w/.-])cross_task\b(?![/.-]|['\u2019]s(?![\w-]))", re.IGNORECASE)
 _HUB_ACTIONS = set(("status pull sync sessions inbox tasks where links request requests "
                     "inspect-legacy reconcile-legacy inspect-alias retire-alias adopt-task "
                     "create-task depend outcomes install-watch watch diff-shared").split())
diff --git a/tests/hermes_cli/test_kanban_coordination_placement.py b/tests/hermes_cli/test_kanban_coordination_placement.py
index 9322737460..fe069e22b6 100644
--- a/tests/hermes_cli/test_kanban_coordination_placement.py
+++ b/tests/hermes_cli/test_kanban_coordination_placement.py
@@ -193,6 +193,35 @@ def test_explicit_execution_is_fail_closed(fleet, text):
     assert coord.requirements(text)[1] == coord.ACTION_REASON
 
 
+@pytest.mark.parametrize("text", [
+    "fails with current core and passes with hermes-hub's older core",
+    "compare via hermes-hub\u2019s journal output",
+    "use hermes-hub's checkout as the base",
+    "Run hermes-hub's\nexisting fixtures",
+    "verified with cross_task's comment path",
+])
+def test_possessive_prose_is_not_an_invocation(fleet, text):
+    from hermes_cli import kanban_placement_coordination as coord
+    cfg, entry, _ = fleet
+    entry["labels"] = []
+    assert coord.requirements(text) == (set(), None)
+    assert reason(text, cfg) is None
+
+
+@pytest.mark.parametrize("text", [
+    "`hermes-hub unknown-cmd`", "run hermes-hub", "run hermes-hub' frobnicate",
+    "run hermes-hub's-tool", "use cross_task", "with hermes-hub'sync",
+])
+def test_possessive_exemption_keeps_invocations_fail_closed(fleet, text):
+    from hermes_cli import kanban_placement_coordination as coord
+    assert coord.requirements(text)[1] == coord.ACTION_REASON
+
+
+def test_possessive_exemption_keeps_status_read():
+    from hermes_cli import kanban_placement_coordination as coord
+    assert coord.requirements("hermes-hub status") == ({"capability:coordination-read"}, None)
+
+
 @pytest.mark.parametrize("text", ["hermes-hub status", "hermes-hub pull", "cross_task read", "cross_task list"])
 def test_each_read_needs_fresh_attestation(fleet, text):
     cfg, entry, _ = fleet
-- 
