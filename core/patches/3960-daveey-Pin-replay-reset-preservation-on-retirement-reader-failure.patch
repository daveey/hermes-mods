From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 23:47:20 +0000
Subject: [PATCH] [daveey] Pin replay reset preservation on retirement reader
 failure

A retirement reader RuntimeError is not evidence of a successor. Cover failed-wake scheduling, durable notice retry, and scalar/dict reset consumers independently. Production is unchanged.

Proof: predictions recorded on t_01a1d74643faf1d6 before runs. scripts/mutants.py exact except Exception to except ImportError mutation: baseline 21 passed; four new parametrized cases fail; mutant killed. Restored suite 21 passed, zero skips; scripts/check: 20 checks ok.
---
 .../hermes_cli/test_superseded_host_loops.py  | 23 +++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/tests/hermes_cli/test_superseded_host_loops.py b/tests/hermes_cli/test_superseded_host_loops.py
index 4380f14ba0..0306e858eb 100644
--- a/tests/hermes_cli/test_superseded_host_loops.py
+++ b/tests/hermes_cli/test_superseded_host_loops.py
@@ -344,6 +344,29 @@ def test_a_skewed_but_not_retired_process_still_waits_for_the_reset(monkeypatch)
     assert ng._retry_at("20261031_064851_d0f106", now) == reset + ng.DEFER_SLACK_S
 
 
+@pytest.mark.parametrize("consumer", ["wake", "notice", "scalar", "failure_dict"])
+def test_unreadable_retirement_state_preserves_the_wall_reset(monkeypatch, consumer):
+    from tui_gateway import automation_replay as ar
+    from tui_gateway import notice_guarantee as ng
+    from tui_gateway import server
+
+    def unreadable():
+        raise RuntimeError("retirement state unavailable")
+
+    monkeypatch.setattr(hll, "host_loops_retired", unreadable)
+    now = time.time()
+    reset = now + 4 * 86400
+    if consumer == "wake":
+        assert _replay_due(monkeypatch, reset) == reset
+    elif consumer == "notice":
+        session = {"agent_failure": {"failure_resets_at": reset}}
+        monkeypatch.setattr(server, "_find_live_session_by_key", lambda key: ("sid", session))
+        assert ng._retry_at("20261031_064851_d0f106", now) == reset + ng.DEFER_SLACK_S
+    else:
+        failure = {"failure_resets_at": reset} if consumer == "failure_dict" else reset
+        assert ar.trusted_resets_at(failure) == reset
+
+
 @pytest.mark.parametrize("skewed", [False, True])
 def test_a_wall_failure_in_a_retired_process_replays_after_the_short_delay(monkeypatch, skewed):
     from gateway import code_skew
