+    if not cfg.enabled:
+        return {}
+    now_held: dict[str, float] = {}
+    for provider, entry in _load_state(state_path()).items():
+        name = str(provider).strip().lower()
+        pace = _stored_pace(entry, now, cfg) if name in cfg.providers else None
