From 7b8f9d85ec44d4a46a783784f786a8eea0776ace Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 08:17:34 +0000
Subject: [PATCH] perf(kanban): keep exact batch keys outermost in replica
 query [daveey]

Public mirror of the source commit; see the accompanying feature documentation.

---
 hermes_cli/kanban_origin_batch.py            |  4 +++-
 tests/hermes_cli/test_kanban_origin_batch.py | 23 ++++++++++++++++++++
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_origin_batch.py b/hermes_cli/kanban_origin_batch.py
index 387ebb21823..c368db9b8c0 100644
--- a/hermes_cli/kanban_origin_batch.py
+++ b/hermes_cli/kanban_origin_batch.py
@@ -18,7 +18,9 @@ def task_rows(source, bindings):
     if not wanted or source is None:
         return {}
     return {(gw, key): (version, data) for gw, key, version, data in source.execute(
-        "SELECT r.gw,r.key,r.version,r.data FROM json_each(?) AS wanted JOIN replica AS r "
+        # CROSS JOIN keeps the requested keys outermost: ordinary JOIN can
+        # scan every task via a coll index and re-scan json_each per task.
+        "SELECT r.gw,r.key,r.version,r.data FROM json_each(?) AS wanted CROSS JOIN replica AS r "
         "ON r.gw=json_extract(wanted.value,'$[0]') AND r.coll='tasks' "
         "AND r.key=json_extract(wanted.value,'$[1]')", (json.dumps(wanted),)).fetchall()}
 
diff --git a/tests/hermes_cli/test_kanban_origin_batch.py b/tests/hermes_cli/test_kanban_origin_batch.py
index bee1fe10f62..7d6a5817b54 100644
--- a/tests/hermes_cli/test_kanban_origin_batch.py
+++ b/tests/hermes_cli/test_kanban_origin_batch.py
@@ -55,6 +55,29 @@ def test_refresh_and_projection_remain_strict_after_committed_changes(world, mon
         assert projected[0]['status'] == 'unknown'  # fixture owner has no current scope heartbeat
 
 
+def test_batch_work_is_bounded_by_requested_keys_not_replica_inventory(monkeypatch):
+    monkeypatch.setenv('HERMES_ORIGIN_BATCH_READS', '1')
+    conn = sqlite3.connect(':memory:')
+    try:
+        conn.execute('CREATE TABLE replica(gw TEXT,coll TEXT,key TEXT,version INTEGER,data TEXT,'
+                     'PRIMARY KEY(gw,coll,key))')
+        # Production secondary indexes let SQLite reorder an ordinary JOIN to
+        # scan all task records, then scan json_each once for every record.
+        conn.execute('CREATE INDEX replica_poll_metadata ON replica(coll,gw)')
+        conn.executemany('INSERT INTO replica VALUES(?,?,?,?,?)',
+                         [('owner', 'tasks', str(i), i, '{}') for i in range(3000)])
+        bindings = [{'owner': {'gateway': 'owner'}, 'task_record_key': str(i)} for i in range(8)]
+        calls = []
+        def budget():
+            calls.append(1)
+            return len(calls) > 10
+        conn.set_progress_handler(budget, 1000)
+        assert batch.task_rows(conn, bindings) == {('owner', str(i)): (i, '{}') for i in range(8)}
+    finally:
+        conn.set_progress_handler(None, 0)
+        conn.close()
+
+
 def test_locked_refresh_takes_new_batch_after_preflight(world, monkeypatch):
     path, replica, binding = world
     support.publish(replica, binding)
