From 09251f94f2540d02206182733ca7c46cd749b886 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 02:22:10 +0000
Subject: [PATCH] test(delegation): wait generously for the fan-out completion
 event instead of a 5s deadline

---
 tests/tools/test_async_delegation.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tests/tools/test_async_delegation.py b/tests/tools/test_async_delegation.py
index f76df54c50..7461cdb936 100644
--- a/tests/tools/test_async_delegation.py
+++ b/tests/tools/test_async_delegation.py
@@ -1020,7 +1020,8 @@ def test_multi_task_call_is_one_completion_unless_independent_completions(monkey
     gates[1].set()
     assert _drain_one(timeout=0.5) is None  # two of three done: no message yet
     gates[2].set()
-    evt = _drain_one()
+    evt = _drain_one(timeout=60)  # returns as soon as the event lands; a CPU-throttled runner needs the slack
+    assert evt is not None, "no completion message after all three tasks finished"
     assert sorted(r["task_index"] for r in evt["results"]) == [0, 1, 2]
 
 
