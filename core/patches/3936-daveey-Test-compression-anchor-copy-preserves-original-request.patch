From 34f7f9c4f9ab2e1ea8169c3259a39cd3106f5974 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 23:09:08 +0000
Subject: [PATCH] [daveey] Test compression anchor copy preserves original
 request

Pin restored-anchor durability stamping to the copied request, and retain an already-present request no-op control. No production changes or live transcript mutation.

Proof: 4 focused compression files: 63 passed. sdlc-review mutants.py: baseline 2 passed, K6 fresh-copy omission killed by test_anchor_copy_does_not_stamp_the_original_request. scripts/check: all 20 checks pass after fresh main rebase. Inspected _ensure_compressed_has_user_turn -> _commit_compaction: existing concurrent-fork coverage exercises the persistence caller; this regression targets the source-dict mutation directly.
---
 tests/agent/test_compression_anchor_copy.py | 43 +++++++++++++++++++++
 1 file changed, 43 insertions(+)
 create mode 100644 tests/agent/test_compression_anchor_copy.py

diff --git a/tests/agent/test_compression_anchor_copy.py b/tests/agent/test_compression_anchor_copy.py
new file mode 100644
index 0000000000..bb319750c1
--- /dev/null
+++ b/tests/agent/test_compression_anchor_copy.py
@@ -0,0 +1,43 @@
+"""Restored intent anchors must not change the source transcript's durability."""
+
+from copy import deepcopy
+
+from agent.context_compressor import _DB_PERSISTED_MARKER
+from agent.conversation_compression import _ensure_compressed_has_user_turn
+
+
+def test_anchor_copy_does_not_stamp_the_original_request():
+    request = {"role": "user", "content": "please do X"}
+    original = [{"role": "system", "content": "s"}, request]
+    before = deepcopy(original)
+    tool_call = {
+        "role": "assistant",
+        "content": "",
+        "tool_calls": [
+            {"id": "c1", "type": "function", "function": {"name": "t", "arguments": "{}"}},
+        ],
+    }
+    compressed = [tool_call]
+
+    outcome = _ensure_compressed_has_user_turn(original, compressed)
+
+    assert outcome == "inserted"
+    assert compressed == [
+        {"role": "user", "content": "please do X", _DB_PERSISTED_MARKER: True},
+        tool_call,
+    ]
+    # Stamping the restored anchor must not mark the source request as persisted.
+    assert original == before
+    assert request == {"role": "user", "content": "please do X"}
+
+
+def test_existing_request_needs_no_anchor_or_persistence_stamp():
+    request = {"role": "user", "content": "please do X"}
+    original = [{"role": "system", "content": "s"}, request]
+    compressed = [request]
+    before = deepcopy(original)
+
+    assert _ensure_compressed_has_user_turn(original, compressed) == "already_present"
+
+    assert compressed == [before[-1]]
+    assert original == before
