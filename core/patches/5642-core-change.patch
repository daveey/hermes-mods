From 7d9f94dfa42cedd811f10536dbf2a5d89a4e0716 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 01:09:59 +0000
Subject: [PATCH] fix(tests): await shell readiness before describing holder
 argv [daveey]

Problem: CI occurrence 83, job 137041928767, failed the non-Python -c
holder test with command line unavailable; failed-id retry recovered.

Why: Popen returning is not an argv-publication barrier. On Linux,
10,000 real child spawns yielded 3,580 empty immediate procfs reads.
A warmed real describe_holder_pid loop failed 7/1,000 original assertions;
each next description recovered read x while the child remained alive.
The fixture inspected a starting shell, unlike adjacent ready-handshaked
Python fixtures. The old test had no startup-order regression.

Wait for shell stdout readiness before the unchanged read x assertion.
No production renderer, masking, permission or retry policy changes.
Add a controlled argv-unavailable-before-ack regression exercising both
procfs and psutil paths and requiring the invoked fixture to reap its
child even on RED. This models the reproduced availability gap, not a
claim of historical kernel tracing.

Proof: deterministic old fixture RED at original read x assertion,
new fixture GREEN; whole file 11 passed without retries (10 historical
cases plus ordering regression); exact test 1,000 calls passed without
retries. Relevant holder and argv redaction suites passed; scripts/check
all 21 checks passed. Native macOS execution is left to required CI.

Hermes-Card: t_373d39ca68a41a15
---
 .../test_doctor_fts_deferral_holders.py       | 59 ++++++++++++++++++-
 1 file changed, 58 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_doctor_fts_deferral_holders.py b/tests/hermes_cli/test_doctor_fts_deferral_holders.py
index 8d6be58eea..56429339c7 100644
--- a/tests/hermes_cli/test_doctor_fts_deferral_holders.py
+++ b/tests/hermes_cli/test_doctor_fts_deferral_holders.py
@@ -128,12 +128,69 @@ def test_two_gateways_are_told_they_block_each_other():
 def test_holder_description_keeps_a_non_python_dash_c():
     from hermes_state_holders import describe_holder_pid
 
-    proc = subprocess.Popen(["sh", "-c", "read x", "sh"], stdin=subprocess.PIPE)
+    # Popen's exec-error pipe can close before the child's argv is observable.
+    # Wait for the shell itself, as the Python holder fixtures above do.
+    proc = subprocess.Popen(
+        ["sh", "-c", "printf 'ready\\n'; read x", "sh"],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        text=True,
+    )
     try:
+        assert proc.stdout.readline().strip() == "ready"
         assert "read x" in describe_holder_pid(proc.pid)
     finally:
         proc.stdin.close()
         proc.wait(timeout=30)
+        proc.stdout.close()
+
+
+@pytest.mark.platforms("linux", "macos")
+def test_non_python_holder_waits_for_child_readiness(monkeypatch):
+    """Model argv being unavailable until the parent observes the child's ready message."""
+    import hermes_state_holders as holders
+
+    popen = subprocess.Popen
+    read_argv = holders._read_proc_argv
+    cmdline = holders.psutil.Process.cmdline
+    children = []
+    ready = False
+
+    def spawn(*args, **kwargs):
+        proc = popen(*args, **kwargs)
+        children.append(proc)
+        if proc.stdout is not None:
+            readline = proc.stdout.readline
+
+            def observe_ready():
+                nonlocal ready
+                line = readline()
+                ready = line.strip() == "ready"
+                return line
+
+            monkeypatch.setattr(proc.stdout, "readline", observe_ready)
+        return proc
+
+    def argv_when_ready(pid):
+        if children and pid == children[0].pid and not ready:
+            return None
+        return read_argv(pid)
+
+    def cmdline_when_ready(proc):
+        if children and proc.pid == children[0].pid and not ready:
+            return []
+        return cmdline(proc)
+
+    monkeypatch.setattr(subprocess, "Popen", spawn)
+    monkeypatch.setattr(holders, "_read_proc_argv", argv_when_ready)
+    monkeypatch.setattr(holders.psutil.Process, "cmdline", cmdline_when_ready)
+    try:
+        test_holder_description_keeps_a_non_python_dash_c()
+        assert ready
+    finally:
+        # The invoked test must retain cleanup even when its semantic assertion fails.
+        assert len(children) == 1
+        assert children[0].poll() is not None
 
 
 @pytest.mark.platforms("linux", "macos")
