+          uname -a
+      - name: Regression against b92048a2
+        run: |
+          git show b92048a2e0556115f268a8ad62e11ef885f21bcf:scripts/ci/plugin_validation_sandbox.py > scripts/ci/plugin_validation_sandbox.py
