diff --git a/.github/workflows/sandbox-lifecycle-proof.yml b/.github/workflows/sandbox-lifecycle-proof.yml
new file mode 100644
index 00000000000..2229ac64b73
--- /dev/null
+++ b/.github/workflows/sandbox-lifecycle-proof.yml
@@ -0,0 +1,28 @@
+name: Sandbox lifecycle proof
+on:
+  push:
+    branches: ['sandbox-proof/**']
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  real-isolation:
+    runs-on: [self-hosted, hermes-hub]
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: ./.github/actions/setup-pm
