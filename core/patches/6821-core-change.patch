From e4f731f708eb3955e37046760f6a5ebc5acc98ae Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 27 Nov 2026 13:43:42 +0000
Subject: [PATCH 6821] Policy-config interning: exact-byte storage and opt-in rollout

Public mirror of source commit e4f731f708eb3955e37046760f6a5ebc5acc98ae.

---
diff --git a/tests/hermes_cli/test_session_recovery_policy_config.py b/tests/hermes_cli/test_session_recovery_policy_config.py
index 07a32c2cc20a95c75b639aecc35663ea32f7b3d6..0f9c698fa4d3911a736dd905fe5da14f6392b9e5 100644
--- a/tests/hermes_cli/test_session_recovery_policy_config.py
+++ b/tests/hermes_cli/test_session_recovery_policy_config.py
@@ -15,6 +15,7 @@
         def write(conn):
             store_receipt(conn, 'one', receipt, intern=True)
             store_receipt(conn, 'two', receipt, intern=True)
+            store_receipt(conn, 'legacy', receipt)
             conn.execute('DELETE FROM state_meta WHERE key GLOB ?', (REF_PREFIX + '*:two',))
         db._execute_write(write)
     report = recover_session_database(source, output, allow_partial=True)
diff --git a/tests/hermes_state/test_policy_config_storage.py b/tests/hermes_state/test_policy_config_storage.py
index 2bafe4e24cd75e2f1d66306c317679748ca589a7..44623177e7aee0a8be265560b4bcd4b8d4b88fe7 100644
--- a/tests/hermes_state/test_policy_config_storage.py
+++ b/tests/hermes_state/test_policy_config_storage.py
@@ -275,3 +275,15 @@
     with pytest.raises(RuntimeStoreError, match='storage_unavailable'):
         store_receipt(conn, 'one', malformed, intern=True)
     assert conn.execute('SELECT * FROM state_meta').fetchall() == []
+
+
+def test_conflicting_inline_and_reference_custody_cannot_be_retired(conn):
+    store_receipt(conn, 'one', receipt(), intern=True)
+    key = 'gateway.local_policy.v1:one'
+    raw = json.loads(conn.execute('SELECT value FROM state_meta WHERE key=?', (key,)).fetchone()[0])
+    raw['policy']['config_json'] = '{}'
+    conn.execute('UPDATE state_meta SET value=? WHERE key=?', (json.dumps(raw), key))
+    before = conn.execute('SELECT * FROM state_meta ORDER BY key').fetchall()
+    with pytest.raises(RuntimeStoreError, match='storage_unavailable'):
+        delete_receipt(conn, 'one')
+    assert conn.execute('SELECT * FROM state_meta ORDER BY key').fetchall() == before
