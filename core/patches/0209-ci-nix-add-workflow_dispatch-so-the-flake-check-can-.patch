From a50aab5a5f24cbdc29cfcb049a5ecb35a88c89dd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 03:37:44 +0000
Subject: [PATCH] ci(nix): add workflow_dispatch so the flake check can be
 re-run on demand (#33)

---
 .github/workflows/nix.yml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/.github/workflows/nix.yml b/.github/workflows/nix.yml
index ed861d92b5..c3349fc911 100644
--- a/.github/workflows/nix.yml
+++ b/.github/workflows/nix.yml
@@ -11,6 +11,7 @@ name: Nix flake check
 # fast required jobs beside it. A separate run reruns and cancels on its own.
 
 on:
+  workflow_dispatch:
   pull_request:
   push:
     branches: [main]
-- 
