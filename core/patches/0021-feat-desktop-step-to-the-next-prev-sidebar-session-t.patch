diff --git a/apps/desktop/src/store/sidebar-visible-order.test.ts b/apps/desktop/src/store/sidebar-visible-order.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bb4d70fa52d90afa0d3e6ec243ba528c42935185
--- /dev/null
+++ b/apps/desktop/src/store/sidebar-visible-order.test.ts
@@ -0,0 +1,68 @@
+import { afterEach, describe, expect, it } from 'vitest'
+
+import {
+  publishSidebarSection,
+  sidebarSessionOrder,
+  stepSessionId,
+  unpublishSidebarSection
+} from './sidebar-visible-order'
+
+const order = ['a', 'b', 'c', 'd']
+
+describe('stepSessionId', () => {
+  it('steps forward and back with wrap-around', () => {
+    expect(stepSessionId(order, 'b', 1)).toBe('c')
+    expect(stepSessionId(order, 'd', 1)).toBe('a')
+    expect(stepSessionId(order, 'a', -1)).toBe('d')
+  })
+
+  it('skips ineligible sessions and wraps to find one', () => {
+    const needs = new Set(['a', 'c'])
+
+    expect(stepSessionId(order, 'c', 1, id => needs.has(id))).toBe('a')
+    expect(stepSessionId(order, 'a', -1, id => needs.has(id))).toBe('c')
+  })
+
+  it('returns null when nothing else qualifies', () => {
+    expect(stepSessionId(order, 'b', 1, id => id === 'b')).toBeNull()
+    expect(stepSessionId([], 'b', 1)).toBeNull()
+  })
+
+  it('starts at the ends for an unknown current session', () => {
+    expect(stepSessionId(order, null, 1)).toBe('a')
+    expect(stepSessionId(order, 'zz', -1)).toBe('d')
+  })
+})
+
+describe('sidebarSessionOrder', () => {
+  const keys: symbol[] = []
+
+  afterEach(() => {
+    keys.forEach(unpublishSidebarSection)
+    keys.length = 0
+    document.body.innerHTML = ''
+  })
+
+  it('concatenates sections in DOM order, deduped', () => {
+    const top = document.createElement('span')
+    const bottom = document.createElement('span')
+    document.body.append(top, bottom)
+    const pinned = Symbol('pinned')
+    const recents = Symbol('recents')
+    keys.push(pinned, recents)
+
+    // Published out of order on purpose.
+    publishSidebarSection(recents, { anchor: bottom, ids: ['r1', 'p1', 'r2'] })
+    publishSidebarSection(pinned, { anchor: top, ids: ['p1', 'p2'] })
+
+    expect(sidebarSessionOrder()).toEqual(['p1', 'p2', 'r1', 'r2'])
+  })
+
+  it('ignores sections whose anchor left the document', () => {
+    const gone = Symbol('gone')
+    keys.push(gone)
+    publishSidebarSection(gone, { anchor: document.createElement('span'), ids: ['x'] })
+
+    expect(sidebarSessionOrder()).not.toContain('x')
+  })
+})
diff --git a/apps/desktop/src/store/sidebar-visible-order.ts b/apps/desktop/src/store/sidebar-visible-order.ts
new file mode 100644
index 0000000000000000000000000000000000000000..de198e8419b4a94e088708c1f2314eff103f3af4
--- /dev/null
+++ b/apps/desktop/src/store/sidebar-visible-order.ts
@@ -0,0 +1,102 @@
+import { $sessions } from '@/store/session'
+import { $sessionDotStateById, type SessionDotState } from '@/store/session-dot-state'
+
+// The sidebar's session order as the user sees it, for ⌘] / ⌘[ stepping.
+// Each rendered SessionsSection (pinned, recents, …) publishes the ids of its
+// visible rows plus an anchor element; sections are concatenated in DOM order
+// at read time. The virtualized list renders only on-screen rows, so the DOM
+// can't be read directly — the section's row model is the authority.
+
+interface SectionEntry {
+  anchor: HTMLElement | null
+  ids: readonly string[]
+}
+
+const sections = new Map<symbol, SectionEntry>()
+
+export function publishSidebarSection(key: symbol, entry: SectionEntry): void {
+  sections.set(key, entry)
+}
+
+export function unpublishSidebarSection(key: symbol): void {
+  sections.delete(key)
+}
+
+function domOrder(a: SectionEntry, b: SectionEntry): number {
+  if (!a.anchor || !b.anchor || a.anchor === b.anchor) {
+    return 0
+  }
+
+  return a.anchor.compareDocumentPosition(b.anchor) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1
+}
+
+/** Visible sidebar session ids, top to bottom (deduped). Falls back to the
+ *  recency list when no section is mounted (sidebar hidden, project view). */
+export function sidebarSessionOrder(): string[] {
+  const ordered = [...sections.values()].filter(entry => entry.anchor?.isConnected).sort(domOrder)
+  const seen = new Set<string>()
+  const ids: string[] = []
+
+  for (const entry of ordered) {
+    for (const id of entry.ids) {
+      if (!seen.has(id)) {
+        seen.add(id)
+        ids.push(id)
+      }
+    }
+  }
+
+  return ids.length ? ids : $sessions.get().map(session => session.id)
+}
+
+/** The sidebar dot states that mean "waiting on you": a blocking prompt
+ *  (amber) or a finished, unread turn. */
+export const NEEDS_YOU_STATES: ReadonlySet<SessionDotState> = new Set(['needs-input', 'unread'])
+
+/**
+ * The session `direction` steps from `currentId` in `order`, wrapping. With
+ * `eligible`, skips sessions it rejects; null when nothing else qualifies.
+ * An unknown current id steps from just outside the list (first / last).
+ */
+export function stepSessionId(
+  order: readonly string[],
+  currentId: null | string,
+  direction: 1 | -1,
+  eligible?: (id: string) => boolean
+): null | string {
+  const n = order.length
+
+  if (n === 0) {
+    return null
+  }
+
+  const at = currentId ? order.indexOf(currentId) : -1
+  const start = at >= 0 ? at : direction === 1 ? -1 : n
+
+  for (let step = 1; step <= n; step += 1) {
+    const id = order[(((start + direction * step) % n) + n) % n]
+
+    if (id !== currentId && (!eligible || eligible(id))) {
+      return id
+    }
+  }
+
+  return null
+}
+
+/** ⌘] / ⌘[: next session that needs you, else the plain next one. ⇧ skips
+ *  the needs-you filter. */
+export function nextSidebarSessionId(currentId: null | string, direction: 1 | -1, anySession: boolean): null | string {
+  const order = sidebarSessionOrder()
+
+  if (!anySession) {
+    const dots = $sessionDotStateById.get()
+    const needing = stepSessionId(order, currentId, direction, id => NEEDS_YOU_STATES.has(dots[id] ?? 'idle'))
+
+    if (needing) {
+      return needing
+    }
+  }
+
+  return stepSessionId(order, currentId, direction)
+}
