From 0a85c6fb2d1e767434ffef4135e5d91de3600721 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 07:03:01 +0000
Subject: [PATCH 1156/1157] ci(tests): the Python test job installs tmux before
 the suite

Run 41009740205 shard 2 on ec2-gwgen-3 failed
tests/hermes_cli/test_gateway_chat_native.py with FileNotFoundError: 'tmux'.
That platforms("linux") test drives the real CLI in tmux, but only the e2e
job installs tmux; the test job relied on the runner image, and not every
example-hub image ships it. Same idempotent step as the e2e job, plus a
workflow test (red on the base) that the test job verifies tmux first.
---
 .github/workflows/tests.yml        |  9 +++++++++
 tests/ci/test_e2e_tmux_required.py | 11 +++++++++++
 2 files changed, 20 insertions(+)

diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index 4358fe6af52..f8297d93f9b 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -92,6 +92,15 @@ jobs:
           rm -rf "$RG_TARBALL" "ripgrep-${RG_VERSION}-x86_64-unknown-linux-musl"
           rg --version
 
+      - name: Install tmux
+        # tests/hermes_cli/test_gateway_chat_native.py and other platforms("linux") tests drive the
+        # real CLI in tmux and fail (not skip) without it. Not every hermes-hub runner image ships it
+        # (ec2-gwgen-3 did not, run 41009740205), so install it like the e2e job does.
+        run: |
+          set -euo pipefail
+          command -v tmux >/dev/null || { sudo apt-get update -qq && sudo apt-get install -y -qq tmux; }
+          tmux -V
+
       - name: Set up locked Python and test dependencies
         uses: ./.github/actions/setup-pm
         with:
diff --git a/tests/ci/test_e2e_tmux_required.py b/tests/ci/test_e2e_tmux_required.py
index badd3c4fcda..1305907c0bf 100644
--- a/tests/ci/test_e2e_tmux_required.py
+++ b/tests/ci/test_e2e_tmux_required.py
@@ -60,3 +60,14 @@ def test_the_e2e_job_requires_tmux():
     assert run_step["env"]["HERMES_E2E_REQUIRE_TUI"] == "1"
     assert any("tmux" in s.get("run", "") and "tmux -V" in s.get("run", "") for s in job["steps"]), \
         "the e2e job must install/verify tmux before the tmux suites run"
+
+
+def test_the_python_test_job_installs_tmux_before_running_tests():
+    """The full-suite job runs platforms("linux") tests that drive the real CLI in tmux
+    (tests/hermes_cli/test_gateway_chat_native.py); a runner image without tmux failed them (run 41009740205)."""
+    yaml = pytest.importorskip("hermes_yaml")
+    steps = yaml.safe_load((_REPO / ".github" / "workflows" / "tests.yml").read_text(encoding="utf-8"))["jobs"]["test"]["steps"]
+    names = [s.get("name") for s in steps]
+    tmux = [i for i, s in enumerate(steps) if "tmux -V" in s.get("run", "")]
+    assert tmux, "the test job must install/verify tmux"
+    assert tmux[0] < names.index("Run tests"), names
