Subject: [PATCH 6698] File-descriptor headroom guard and incident reporting

Public mirror of source commit f7e980a4c232feff35464f2c879266a50e649d59.

---
diff --git a/tests/hermes_cli/test_fd_headroom_mutant_gaps.py b/tests/hermes_cli/test_fd_headroom_mutant_gaps.py
new file mode 100644
index 0000000000000000000000000000000000000000..8a17d8365546608e5b2d6c21251218ccb311309a
--- /dev/null
+++ b/tests/hermes_cli/test_fd_headroom_mutant_gaps.py
@@ -0,0 +1,69 @@
+"""FD incident contracts left unpinned by the landed suite: crash-safe intent and the hour-old failure note."""
+import json
+
+import pytest
+from hermes_cli import fd_headroom_incident as incidents
+
+
+class ProcessDied(BaseException):
+    """Stands in for the gateway dying mid-create: no ``except Exception`` handler runs."""
+
+
+def _sample():
+    return dict(host='example-host', profile='default', role='gateway', count=800, soft=1000,
+                hard=10000, census={'classes': {'resource-leases': 700}}, triggered=True, raised='')
+
+
+class _Board:
+    def __init__(self):
+        self.cards, self.creates = {}, []
+
+    def client(self, *, die_after_create=False, create_error=None):
+        board = self
+
+        class Client:
+            def create(self, envelope):
+                board.creates.append(envelope)
+                if create_error is not None:
+                    raise create_error
+                board.cards.setdefault(envelope['id'], f't_{len(board.cards) + 1:016x}')
+                if die_after_create:
+                    raise ProcessDied()
+                return board.cards[envelope['id']]
+
+            def read(self, tid, _board):
+                live = tid in board.cards.values()
+                return {'state': 'live' if live else 'deleted',
+                        'row': {'id': tid, 'status': 'ready'} if live else None}
+
+            def comment(self, envelope):
+                pass
+
+            def close(self):
+                pass
+        return Client()
+
+
+def test_intent_is_durable_before_a_create_the_process_does_not_survive(tmp_path):
+    board, path = _Board(), tmp_path / 'incident.json'
+    with pytest.raises(ProcessDied):
+        incidents.report(_sample(), now=10000, client=board.client(die_after_create=True),
+                         state_path=path)
+    durable = json.loads(path.read_text())
+    assert durable['envelope']['id'] == board.creates[0]['id']
+    restarted = incidents.report(_sample(), now=10300, client=board.client(), state_path=path)
+    assert [e['id'] for e in board.creates] == [board.creates[0]['id']] * 2
+    assert len(board.cards) == 1
+    assert restarted['task_id'] == board.cards[board.creates[0]['id']]
+
+
+def test_failure_note_stays_silent_until_failing_for_an_hour(tmp_path):
+    board, path = _Board(), tmp_path / 'incident.json'
+    client = board.client(create_error=OSError('offline'))
+    first = incidents.report(_sample(), now=10000, client=client, state_path=path)
+    assert first['failing_since'] == 10000
+    assert incidents.failure_note(first, now=10000) == ''
+    later = incidents.report(_sample(), now=13599, client=client, state_path=path)
+    assert later['failing_since'] == 10000
+    assert incidents.failure_note(later, now=13599) == ''
+    assert incidents.failure_note(later, now=13600).startswith('card create failing since ')
