From a934e39df2ffd3a3846dc324acbe809eb644314c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 07:12:03 +0000
Subject: [PATCH] fix(ci): bind wrapper test paths and use safe recovery pid
 probe [daveey]

---
 hermes_cli/kanban_db_recover.py | 14 ++++----------
 tests/hermes_cli/test_backup.py |  2 +-
 tests/hermes_cli/test_doctor.py |  1 +
 3 files changed, 6 insertions(+), 11 deletions(-)

diff --git a/hermes_cli/kanban_db_recover.py b/hermes_cli/kanban_db_recover.py
index f192196040..827b1dd7e3 100644
--- a/hermes_cli/kanban_db_recover.py
+++ b/hermes_cli/kanban_db_recover.py
@@ -174,15 +174,9 @@ HOLDER_TASK_ENV = "HERMES_RECOVERY_HOLDER_TASK"
 
 
 def _pid_alive(pid: int) -> bool:
-    try:
-        os.kill(pid, 0)
-    except ProcessLookupError:
-        return False
-    except PermissionError:
-        return True
-    except (OSError, OverflowError):
-        return False
-    return True
+    from gateway.status import _pid_exists
+
+    return _pid_exists(pid)
 
 
 def recovery_lock_holder_info(db_path: Path) -> Optional[dict]:
@@ -213,7 +207,7 @@ def recovery_lock_holder_info(db_path: Path) -> Optional[dict]:
 def _proc_start(pid: int) -> Optional[str]:
     """Linux process start time in clock ticks (``/proc/<pid>/stat`` field 22); None elsewhere."""
     try:
-        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
+        return Path(f"/proc/{pid}/stat").read_text(encoding="utf-8-sig").rsplit(")", 1)[1].split()[19]
     except (OSError, IndexError):
         return None
 
diff --git a/tests/hermes_cli/test_backup.py b/tests/hermes_cli/test_backup.py
index 99d9e09d54..ccab3844b0 100644
--- a/tests/hermes_cli/test_backup.py
+++ b/tests/hermes_cli/test_backup.py
@@ -1385,7 +1385,6 @@ class TestProfileRestoration:
             for name, content in files.items():
                 zf.writestr(name, content)
 
-
     def test_import_skips_profile_dirs_without_config(self, tmp_path, monkeypatch):
         """Import doesn't create wrappers for profile dirs without config."""
         hermes_home = tmp_path / ".hermes"
@@ -1395,6 +1394,7 @@ class TestProfileRestoration:
 
         wrapper_dir = tmp_path / ".local" / "bin"
         wrapper_dir.mkdir(parents=True)
+        monkeypatch.setattr("hermes_cli.profiles._get_wrapper_dir", lambda: wrapper_dir)
 
         zip_path = tmp_path / "backup.zip"
         self._make_backup_zip(zip_path, {
diff --git a/tests/hermes_cli/test_doctor.py b/tests/hermes_cli/test_doctor.py
index 2310d10154..448daeb015 100644
--- a/tests/hermes_cli/test_doctor.py
+++ b/tests/hermes_cli/test_doctor.py
@@ -1649,6 +1649,7 @@ def test_profile_alias_status_follows_the_wrapper_the_profile_really_has(monkeyp
     monkeypatch.setenv("HERMES_HOME", str(tmp_path / ".hermes"))
     monkeypatch.setattr(hermes_constants, "_default_hermes_root_memo", None)
     monkeypatch.setattr(gm, "duplicate_credential_findings", list)
+    monkeypatch.setattr(profiles, "_get_wrapper_dir", lambda: tmp_path / ".local" / "bin")
     for name in ("dev", "ops", "work", "old"):
         (tmp_path / ".hermes" / "profiles" / name).mkdir(parents=True)
         (tmp_path / ".hermes" / "profiles" / name / "config.yaml").write_text("model: m\n", encoding="utf-8")
