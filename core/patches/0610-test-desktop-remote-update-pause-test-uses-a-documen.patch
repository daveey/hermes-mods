From 469b0731ea6646d31b0a9a828c23ef045d8e91b3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 21:34:37 -0700
Subject: [PATCH] test(desktop): remote-update-pause test uses a documentation
 address for the hub [daveey]

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/desktop/electron/remote-update-pause.test.ts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/electron/remote-update-pause.test.ts b/apps/desktop/electron/remote-update-pause.test.ts
index 806dc63c6a..0601e11b39 100644
--- a/apps/desktop/electron/remote-update-pause.test.ts
+++ b/apps/desktop/electron/remote-update-pause.test.ts
@@ -9,7 +9,7 @@ import { RemoteUpdatePause, remoteUpdatePauseKey, UPDATE_PAUSE_BACKOFF_MS } from
 // 2026-10-27 20:58–21:00 PDT: the hub ran its own `hermes update`; every renderer request and prewarm tick dialed a
 // new SSH control master, hit the remote preflight's "SSH startup is paused" refusal and closed it again.
 
-const HUB = { user: 'ubuntu', host: '198.51.100.7', port: 22, remoteHermesPath: '' }
+const HUB = { user: 'ubuntu', host: '192.0.2.10', port: 22, remoteHermesPath: '' }
 const KEY = remoteUpdatePauseKey(HUB)
 
 function updateRefusal(): Error {
@@ -161,7 +161,7 @@ describe('renderer API requests during a remote update', () => {
 
     await expect(
       h.pause.run(KEY, async () => {
-        throw new Error('ssh: connect to host 198.51.100.7 port 22: Connection refused')
+        throw new Error('ssh: connect to host 192.0.2.10 port 22: Connection refused')
       })
     ).rejects.toThrow(/Connection refused/)
     expect(h.pause.paused(KEY)).toBe(false)
-- 
