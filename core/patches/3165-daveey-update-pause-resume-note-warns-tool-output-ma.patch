From bc88a77542da017f014dfebac1d749900d2a5312 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 05:52:50 +0000
Subject: [PATCH] [daveey] update pause: resume note warns tool output may be
 stale (re-read PR/CI/card state)

A chat resumed after an update pause reported "PR #1750 isn't merged yet" from a
pre-pause gh pr view; the PR had merged during the pause. The note said every tool
result above is complete, which read as current. Add one sentence telling the agent
to re-read PR, CI or card state before reporting it. (self-heal agent-36ec41dc12)
---
 tests/tui_gateway/test_update_pause.py | 7 +++++++
 tui_gateway/update_pause.py            | 2 ++
 2 files changed, 9 insertions(+)

diff --git a/tests/tui_gateway/test_update_pause.py b/tests/tui_gateway/test_update_pause.py
index 9b7f9ff52d..2562a9f92e 100644
--- a/tests/tui_gateway/test_update_pause.py
+++ b/tests/tui_gateway/test_update_pause.py
@@ -370,3 +370,10 @@ def test_marker_writer_is_this_process(home):
     import json
     entry = json.loads((home / "desktop" / "interrupted_turns.json").read_text())["session-key"]
     assert entry["writer_pid"] == os.getpid() and entry["paused_at"] > 0
+
+
+def test_pause_note_warns_tool_output_may_be_stale():
+    # A PR can merge (or CI finish, or a card move) during the pause; a pre-pause read must not be reported as current.
+    text = up.pause_note("x")
+    assert "may be stale" in text
+    assert "re-read any PR, CI or card state" in text
diff --git a/tui_gateway/update_pause.py b/tui_gateway/update_pause.py
index f0ed8d2861..d5028e5dbb 100644
--- a/tui_gateway/update_pause.py
+++ b/tui_gateway/update_pause.py
@@ -458,6 +458,8 @@ def pause_note(prompt: str, killed_jobs: list | None = None) -> str:
     from tui_gateway.session_history import _AUTO_CONTINUE_NOTE_PREFIX
     note = (f"{_AUTO_CONTINUE_NOTE_PREFIX} — it was paused at a step boundary for a Hermes update. Every "
             "tool result above is complete; continue with the next step and don't redo finished steps. "
+            "Tool output above may be stale: re-read any PR, CI or card state before reporting it; the update "
+            "may itself be one of those changes. "
             f"The paused request was:]\n\n{prompt}")
     report = killed_jobs_report(killed_jobs, "Background jobs stopped for this Hermes update:")
     return f"{note}\n\n{report}" if report else note
-- 
2.51.0

