+def _with(github, **changes):
+    for name, value in changes.items():
+        target = getattr(github, name)
+        if isinstance(target, dict):
+            target.update(value)
+        else:
+            setattr(github, name, value)
+    return github
+
+
+def _main_ci(branch="main", event="push", e2e="success"):
