+    "nightly_resolve_log_unavailable": lambda: _with(_nightly_green(), logs={51: None}),
+    "ci_run_off_main": lambda: _main_ci(branch="feature"),
+    "ci_run_pull_request": lambda: _main_ci(event="pull_request"),
