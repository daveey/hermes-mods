+++ b/hermes_cli/kanban_model_tier.py
@@ -96,8 +96,6 @@
     if not is_class_selector(default_model) or default_model == "class:carbon":
         default_model = "class:standard"
     from hermes_cli.kanban_review_model import is_review_run
-    if _str(getattr(task, "model_override", None)) == "class:carbon":
-        return "class:carbon", "auto", "class"
     if is_review_run(conn, task, lane):
         from hermes_cli.kanban_review_model import resolve_review_model
         review = resolve_review_model(conn, task, cfg)
diff --git a/hermes_cli/kanban_review_model.py b/hermes_cli/kanban_review_model.py
index c4b77995bfb..5f8a6b8caf4 100644
--- a/hermes_cli/kanban_review_model.py
+++ b/hermes_cli/kanban_review_model.py
@@ -413,6 +413,10 @@
     from hermes_cli import kanban_provider_walls as pw
     # Separate execution is enforced by verdict custody, not model identity.
     override = _override(conn, task)
+    # A card's explicit paid class survives review only when no newer handoff
+    # supersedes it. Ordinary review candidates must never select carbon.
+    if not override and str(getattr(task, "model_override", None) or "").strip() == "class:carbon":
+        return "class:carbon", "auto", "class"
     assignee = getattr(task, "assignee", None)
     refusal = registry_refusal(override[0], override[1], assignee) if override else None
     class_override = bool(override and is_class_selector(override[0]))
