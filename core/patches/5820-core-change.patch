 hermes_cli/kanban_scope_renewal.py            |  3 +
 hermes_cli/kanban_scope_renewal_cli.py        | 46 +++++++++++---
 tests/hermes_cli/test_kanban_scope_renewal.py | 62 ++++++++++++++++++-
 .../test_kanban_scope_renewal_synced.py       |  3 +-
 tui_gateway/session_notifications.py          |  2 +-
 6 files changed, 128 insertions(+), 12 deletions(-)

diff --git a/hermes_cli/kanban_comment_writer.py b/hermes_cli/kanban_comment_writer.py
index 4237c8763b..41bdf46940 100644
--- a/hermes_cli/kanban_comment_writer.py
+++ b/hermes_cli/kanban_comment_writer.py
@@ -262,6 +262,30 @@ def agent_ancestor(pid: Optional[int] = None, *, read: Optional[ProcReader] = No
     raise Inconclusive(f"ancestry deeper than {MAX_ANCESTRY}")
 
 
+def ancestry_environs(pid: Optional[int] = None, *, read: Optional[ProcReader] = None) -> list[Mapping[str, str]]:
+    """Start-time environments of ``pid`` (default: this process) and EVERY ancestor up to init, nearest first.
+
+    Unlike :func:`agent_ancestor` the walk does not stop at the first marker: a caller that needs the identity a
+    process was started with (not only "is this an agent") must see what each ancestor carried, because the
+    nearest process's environment is whatever its parent chose to pass. A skipped OS supervisor contributes
+    nothing. Raises :class:`Inconclusive` when the walk can't be completed."""
+    read = read or _read_proc
+    current = os.getpid() if pid is None else int(pid)
+    seen: set[int] = set()
+    found: list[Mapping[str, str]] = []
+    for _ in range(MAX_ANCESTRY):
+        if current in seen:
+            raise Inconclusive(f"ancestry loop at pid {current}")
+        seen.add(current)
+        ppid, environ = read(current)
+        if environ:
+            found.append(environ)
+        if current == 1 or ppid <= 0:
+            return found
+        current = ppid
+    raise Inconclusive(f"ancestry deeper than {MAX_ANCESTRY}")
+
+
 def is_agent_handle(author: Optional[str]) -> bool:
     """True for an agent comment handle: ``<gateway>/t_<16 hex>`` or ``hub-chat-<6+ hex>``."""
     return _AGENT_HANDLE.fullmatch(author or "") is not None
diff --git a/hermes_cli/kanban_scope_renewal.py b/hermes_cli/kanban_scope_renewal.py
index 4d5dc64944..c5781637c2 100644
--- a/hermes_cli/kanban_scope_renewal.py
+++ b/hermes_cli/kanban_scope_renewal.py
@@ -119,6 +119,9 @@ def reopened(conn: sqlite3.Connection, task_id: str, ordinary: list[dict]) -> Op
     decision. Without this, a promotion older than the scope annotation would release the card at renewal.
     "After" is arrival order (the row id), as on the Board (its ``ord``): an event's ``created_at`` and uid are
     its writer's clock, and a promotion recorded before the renewal must not decide it whatever time it states.
+    On a synced board a replica's row id is its own arrival order, not the Board's: a promotion another gateway
+    recorded before the renewal can be pulled after it. This reader may then show the stop decided; execution
+    still needs the Board's lease, and the Board decides by its own ``ord`` (``spend_decision_pending``).
     ``ordinary``: stop/promotion/archive events.
     """
     renewed = sorted(renewals(conn, task_id), key=lambda e: int(e["id"]), reverse=True)
diff --git a/hermes_cli/kanban_scope_renewal_cli.py b/hermes_cli/kanban_scope_renewal_cli.py
index fdda71993e..01c9f4e270 100644
