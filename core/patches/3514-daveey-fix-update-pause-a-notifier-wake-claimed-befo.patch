diff --git a/tests/agent/test_update_yield_before_turn.py b/tests/agent/test_update_yield_before_turn.py
new file mode 100644
index 0000000000..23ac1985a9
--- /dev/null
+++ b/tests/agent/test_update_yield_before_turn.py
@@ -0,0 +1,84 @@
+"""[daveey] t_01a1d49d50e4c656: a turn whose admission the claim would now hold yields before it starts.
+
+laptop-1 incident 31763 (2026-11-13 PST): the canonical gateway claimed a folded Kanban-wake batch on the
+Desktop chat 20261026_235722_bef6c6 at 02:54, BEFORE the core-update hold; its agent turn then waited on the
+session turn lease held by the legacy Desktop backend's own 43-minute turn. That turn parked for the update at
+03:07:12.09 and released the lease; within ~100 ms the waiting gateway turn acquired it and started (03:07:12.353,
+history=105) INSIDE the drain window, ran a turn-start preflight compression (deep aux model, no step boundary)
+and parked only at 03:09:07, 3 s after the reclaim preflight refused "unmatched gateway work".
+
+The claim's hold check (``session_notifier_drain.eligible``) ran once, at 02:54. The gateway now installs an
+``update_yield_before_turn`` gate for a fresh claim of a claim-held class (a notifier wake): the agent asks it
+after the lease is acquired and before anything of the turn runs (no request, no persistence, no turn-start
+compression), and the gateway hands the admission back to its FIFO place.
+"""
+
+from __future__ import annotations
+
+from unittest.mock import patch
+
+from agent.update_pause_cancel import BEFORE_TURN_ATTR, UNSTARTED_KEY
+from tests.agent.test_step_boundary_pause import _final_response, _make_agent
+
+HISTORY = [{"role": "user", "content": "earlier"}, {"role": "assistant", "content": "ok"}]
+
+
+def _run(agent, events, message="[IMPORTANT: 28 Kanban task updates arrived while this session was busy]"):
+    agent.client.chat.completions.create.side_effect = [_final_response()]
+
+    def _persist(messages, *_a, **_k):
+        events.append(("persist", [m.get("role") for m in messages]))
+
+    with (
+        patch.object(agent, "_flush_messages_to_session_db", return_value=True),
+        patch.object(agent, "_persist_session", side_effect=_persist),
+        patch.object(agent, "_save_trajectory"),
+        patch.object(agent, "_cleanup_task_resources"),
+    ):
+        return agent.run_conversation(message, conversation_history=[dict(m) for m in HISTORY])
+
+
+def test_held_claim_yields_before_the_turn_starts_without_compressing():
+    events: list = []
+    agent = _make_agent(events)
+    # The turn-start preflight would compress (the 03:07:21 deep-aux compression): it must never be entered.
+    agent.compression_enabled = True
+    agent.context_compressor.should_compress_preflight.return_value = True
+    asked: list = []
+    vars(agent)[BEFORE_TURN_ATTR] = lambda: asked.append(1) or "core_update_pause"
+
+    with patch.object(agent, "_compress_context") as compress:
+        result = _run(agent, events)
+
+    assert asked == [1]
+    assert agent.client.chat.completions.create.call_count == 0
+    assert compress.call_count == 0
+    assert result["paused_for_update"] == "core_update_pause"
+    assert result[UNSTARTED_KEY] is True
+    assert result["interrupted"] is True and result["completed"] is False and result["api_calls"] == 0
+    assert result["messages"] == HISTORY  # the wake text was never added
+    assert not [e for e in events if e[0] == "persist"]
+
+
+def test_open_gate_runs_the_turn_normally():
+    events: list = []
+    agent = _make_agent(events)
+    asked: list = []
+    vars(agent)[BEFORE_TURN_ATTR] = lambda: asked.append(1) or None
+
+    result = _run(agent, events)
+
+    assert asked == [1]
+    assert result["final_response"] == "done"
+    assert not result.get("paused_for_update") and UNSTARTED_KEY not in result
+
+
+def test_failing_gate_never_pauses():
+    events: list = []
+    agent = _make_agent(events)
+
+    def _boom():
+        raise RuntimeError("fence unreadable")
+    vars(agent)[BEFORE_TURN_ATTR] = _boom
+
+    assert _run(agent, events)["final_response"] == "done"
diff --git a/tests/gateway/test_update_hold_claimed_wake.py b/tests/gateway/test_update_hold_claimed_wake.py
new file mode 100644
index 0000000000..b6234f1424
--- /dev/null
+++ b/tests/gateway/test_update_hold_claimed_wake.py
@@ -0,0 +1,142 @@
+"""[daveey] t_01a1d49d50e4c656: a notifier wake claimed before a core-update hold never starts inside it.
+
+laptop-1 incident 31763 (2026-11-13 PST): the gateway claimed a folded Kanban-wake batch for the Desktop chat
+20261026_235722_bef6c6 at 02:54, before the hold. Its turn then waited on the session turn lease (a Desktop
+backend turn held it) until 03:07:12, when that turn parked for the update; the waiting wake started at once,
+inside the drain window, and kept the reclaim from finding the chat idle. A claim is checked against the hold
+once; the turn it hands off may begin much later.
+
+Contract: a queued notifier wake waits in its FIFO while the hold is on (``session_notifier_drain``). A claimed
+one whose turn has not begun when the hold comes on yields before its turn starts and goes back to its FIFO
+place, queued, unsettled and unrun; it runs once the hold lifts. A human or a resumed checkpoint is untouched.
+"""
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.session_results import execution_result
+
+
+def _turn_start(agent_history, event):
+    """What TurnRunner does for the agent run: install the hook for the bound scope, then the agent's own
+    turn-start check (``conversation_loop`` runs it after acquiring the session turn lease)."""
+    from agent.update_pause_cancel import pause_before_turn
+    from gateway.run_turn_runner import project_paused_result
+    from gateway.session_update_pause_hook import installed
+    agent = SimpleNamespace()
+    with installed(agent, message_id=event.message_id):
+        paused = pause_before_turn(agent, agent_history)
+    return None if paused is None else project_paused_result(paused, {})
+
+
+@pytest.mark.asyncio
+async def test_wake_claimed_before_the_hold_goes_back_to_its_fifo_until_the_hold_lifts(tmp_path, monkeypatch):
+    from gateway import session_notifier_drain, session_update_pause
+    from gateway.config import GatewayConfig
+    from gateway.run import GatewayRunner
+    from gateway.session_authority import initialize_session_authority
+    from gateway.session_automation import admit_route_wake
+    from gateway.session_contract import SessionActor
+    from gateway.session_local import create_local_session
+    from hermes_cli import admission_fence
+    from hermes_state import SessionDB
+    from hermes_state_runtime import list_session_admissions
+    from tests.waiting import async_wait_until
+
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    runner = GatewayRunner(GatewayConfig(sessions_dir=tmp_path / 'sessions'))
+    db = SessionDB(tmp_path / 'state.db')
+    runner.session_store._db = runner._session_db = db
+    authority = await initialize_session_authority(runner, profile_id='default', instance_id='wake-hold', db=db)
+    held, asked = [False], []
+    monkeypatch.setattr(session_notifier_drain, 'held', lambda: asked.append(1) or held[0])
+    monkeypatch.setattr(session_update_pause, 'update_held', lambda authority: held[0])
+    monkeypatch.setattr(admission_fence, 'pause_requested', lambda root: held[0])
+    started, ran = [], []
+
+    async def turn(event, source, quick_key, run_generation):
+        started.append(event.text)
+        # The turn waited on the session turn lease (another backend's turn held it) across the start
+        # of the hold: the hold is on by the time this turn would begin.
+        held[0] = True
+        projected = _turn_start([], event)
+        if projected is not None:
+            execution_result.get()['result'] = projected
+            return None
+        ran.append(event.text)
+        execution_result.get()['result'] = {'final_response': 'done', 'messages': []}
+        return 'done'
+
+    monkeypatch.setattr(runner, '_handle_message_with_agent', turn)
+    try:
+        viewer = SessionActor('test-owner', 'default', frozenset(
+            {'session:create', 'session:submit', 'session:read'}), 'viewer')
+        ref = create_local_session(authority, viewer, dict(request_id='cli', source='tui', model='fixture',
+                                                          cwd=str(tmp_path), toolsets=[]))
+        await authority.attach(viewer, ref, history=False)
+        live = authority.sessions[ref.session_id]
+        adapter = runner._adapter_for_source(live.source)
+        wake = '[IMPORTANT: 28 Kanban task updates arrived while this session was busy]'
+        assert await admit_route_wake(runner, adapter, live.source, wake, 'kanban-wake') is True
+        await async_wait_until(lambda: len(started) == 1, timeout=10, what='the wake was claimed')
+
+        def requeued():
+            rows = list_session_admissions(db, session_id=ref.session_id)
+            return [(r['status'], r['outcome']) for r in rows] == [('queued', None)] \
+                and not authority.pending_results and authority.sessions[ref.session_id].event_stream.execution == {}
+        await async_wait_until(lambda: requeued() or bool(ran), timeout=10, what='the wake settled its first claim')
+        assert ran == [], 'the wake began its turn inside the update hold'
+        assert requeued() and not authority.update_parked
+        assert not authority.executing
+
+        # The drain keeps it queued behind the held claim (several claim polls), never re-claiming it.
+        polls = len(asked)
+        authority._schedule(ref)
+        await async_wait_until(lambda: len(asked) >= polls + 3, timeout=10, what='the drain re-read the hold')
+        assert len(started) == 1 and requeued()
+        first_id = list_session_admissions(db, session_id=ref.session_id)[0]['admission_id']
+
+        async def later(event, source, quick_key, run_generation):
+            started.append(event.text)
+            assert _turn_start([], event) is None
+            ran.append(event.text)
+            execution_result.get()['result'] = {'final_response': 'done', 'messages': []}
+            return 'done'
+        monkeypatch.setattr(runner, '_handle_message_with_agent', later)
+        held[0] = False  # the hold lifts
+        authority._schedule(ref)
+        await async_wait_until(lambda: ran == [wake], timeout=10, what='the wake ran after the hold lifted')
+        await asyncio.wait_for(authority.sessions[ref.session_id].task, 10)
+        rows = list_session_admissions(db, session_id=ref.session_id, pending_only=False)
+        assert [(r['admission_id'], r['status'], r['outcome']) for r in rows] == [
+            (first_id, 'terminal', 'completed')]  # the same admission, run once
+    finally:
+        held[0] = False
+        tasks = [live.task for live in authority.sessions.values() if live.task]
+        for task in tasks:
+            if not task.done():
+                task.cancel()
+        await asyncio.gather(*tasks, return_exceptions=True)
+        db.close()
+
+
+@pytest.mark.asyncio
+async def test_human_turn_claimed_before_the_hold_still_runs(tmp_path, monkeypatch):
+    """Humans keep their admission semantics under the claim hold: only the held class yields."""
+    from gateway import session_notifier_drain, session_update_pause
+    from gateway.session_update_pause_ingress import pause_scope
+    from gateway.session_update_pause_hook import installed
+    from agent.update_pause_cancel import BEFORE_TURN_ATTR
+    monkeypatch.setattr(session_notifier_drain, 'held', lambda: True)
+    monkeypatch.setattr(session_update_pause, 'update_held', lambda authority: True)
+    authority = SimpleNamespace(profile_id=str(tmp_path))
+    monkeypatch.setattr('gateway.session_tui_ops._profile_home', lambda authority: tmp_path)
+    live = SimpleNamespace(source=SimpleNamespace(platform=SimpleNamespace(value='local')))
+    event = SimpleNamespace(message_id='m1')
+    human = {'payload': {'text': 'hi'}, 'request_id': 'r', 'principal_id': 'uid:501'}
+    with pause_scope(authority, human, event, live, is_api=False):
+        agent = SimpleNamespace()
+        with installed(agent, message_id='m1') as hooked:
+            assert hooked
+            assert BEFORE_TURN_ATTR not in vars(agent)
diff --git a/tests/hermes_state/test_requeue_unstarted_input.py b/tests/hermes_state/test_requeue_unstarted_input.py
new file mode 100644
index 0000000000..694989fc27
--- /dev/null
+++ b/tests/hermes_state/test_requeue_unstarted_input.py
@@ -0,0 +1,78 @@
+"""[daveey] t_01a1d49d50e4c656: ``requeue_unstarted_input`` hands a claim that never began its turn back to its FIFO place.
+
+Only an exact, unstarted generation: nothing of the conversation's transcript may postdate the claim, and the old
+generation is fenced (its settlement refuses) once the row is queued again.
+"""
+import json
+
+import pytest
+
+import hermes_state_runtime as rt
+from hermes_state import SessionDB
+from hermes_state_update_pause import requeue_unstarted_input
+from tests.hermes_state.test_notifier_claim_eligibility import wake_payload
+
+
+@pytest.fixture
+def claimed(tmp_path):
+    db = SessionDB(db_path=tmp_path / 'state.db')
+    db.create_session('s', source='test')
+    epoch = rt.begin_runtime_epoch(db, instance_id='owner')
+    identity = json.dumps(['kanban-wake', 'route', 'one'])
+    wake = rt.admit_session_input(db, epoch=epoch, session_id='s', principal_id='automation:route',
+                                  request_id=identity, payload=wake_payload(identity, local=True))
+    rt.admit_session_input(db, epoch=epoch, session_id='s', principal_id='human', request_id='later',
+                           payload={'text': 'later'})
+    row = rt.claim_session_input(db, epoch=epoch, session_id='s')
+    assert row['admission_id'] == wake['admission_id']
+    try:
+        yield db, epoch, row
+    finally:
+        db.close()
+
+
+def _requeue(db, owner_epoch, row, **overrides):
+    return requeue_unstarted_input(db, **{'epoch': owner_epoch, 'admission_id': row['admission_id'],
+                                          'generation': row['generation'],
+                                          'transcript_mark': row['transcript_mark'], **overrides})
+
+
+def test_requeued_row_is_the_fifo_head_again_and_its_old_generation_is_fenced(claimed):
+    db, epoch, row = claimed
+    queued = _requeue(db, epoch, row)
+    assert (queued['status'], queued['outcome'], queued['generation']) == ('queued', None, None)
+    pending = rt.list_session_admissions(db, session_id='s')
+    assert [r['admission_id'] for r in pending] == [row['admission_id'], pending[1]['admission_id']]
+    assert [r['status'] for r in pending] == ['queued', 'queued']
+    with pytest.raises(rt.RuntimeStoreError) as exc:
+        rt.settle_session_input(db, epoch=epoch, admission_id=row['admission_id'], generation=row['generation'],
+                                outcome='completed')
+    assert exc.value.reason == 'stale_generation'
+    again = rt.claim_session_input(db, epoch=epoch, session_id='s')
+    assert again['admission_id'] == row['admission_id'] and again['generation'] == row['generation'] + 1
+
+
+def test_refused_once_the_turn_wrote_its_transcript(claimed):
+    db, epoch, row = claimed
+    db.append_messages_batch('s', [{'role': 'user', 'content': 'the wake'}])
+    with pytest.raises(rt.RuntimeStoreError) as exc:
+        _requeue(db, epoch, row)
+    assert exc.value.reason == 'invalid_checkpoint'
+    assert rt.get_session_admission(db, admission_id=row['admission_id'])['status'] == 'started'
+
+
+@pytest.mark.parametrize('field,value', [('generation', 99), ('epoch', 0)])
+def test_refused_for_another_generation_or_owner(claimed, field, value):
+    db, epoch, row = claimed
+    with pytest.raises(rt.RuntimeStoreError):
+        _requeue(db, epoch, row, **{field: value})
+    assert rt.get_session_admission(db, admission_id=row['admission_id'])['status'] == 'started'
+
+
+def test_refused_after_settlement(claimed):
+    db, epoch, row = claimed
+    rt.settle_session_input(db, epoch=epoch, admission_id=row['admission_id'], generation=row['generation'],
+                            outcome='completed')
+    with pytest.raises(rt.RuntimeStoreError) as exc:
+        _requeue(db, epoch, row)
+    assert exc.value.reason == 'stale_generation'
