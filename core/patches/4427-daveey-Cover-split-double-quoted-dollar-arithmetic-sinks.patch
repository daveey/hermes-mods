From edd8cdb2edf28715e0b49671708938b27cfa0175 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 03:56:12 +0000
Subject: [PATCH] [daveey] Cover split double-quoted dollar arithmetic sinks

Add the real Bash marker witness for a dollar joined to an opening parenthesis after quote removal, plus the non-subscript data control. Exercise scanner, output sink and lifecycle scan-cap refusal using the existing behavioral harness. Production is unchanged.

Proof: canonical focused suite 60 passed, 1 existing xfail, zero skips. Exact shell_arith_sink quoted-dollar-join condition replaced with if False is killed by the new scanner assertion; marker oracle executes first. scripts/check: 20 checks ok.
---
 tests/cron/test_lifecycle_guard_arith_word_quotes.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/tests/cron/test_lifecycle_guard_arith_word_quotes.py b/tests/cron/test_lifecycle_guard_arith_word_quotes.py
index d2a743cbf5dd30ac4b0791a1cc4729eaa45ca019..e3e8a27dfe4f0f6af21dd2eced5e45eacbb22ffd 100644
--- a/tests/cron/test_lifecycle_guard_arith_word_quotes.py
+++ b/tests/cron/test_lifecycle_guard_arith_word_quotes.py
@@ -32,6 +32,8 @@ SINKS = [
     "let 'x=a[''$(SCRIPT)]'",
     "let 'x=a[ ''$(SCRIPT)]'",
     r'let "a[\$(SCRIPT)]=1"',
+    # Quote removal joins the dollar and parenthesis only at arithmetic evaluation.
+    'let "a[$""(SCRIPT)]=1"',
     r'let "a[\`SCRIPT\`]=1"',
     r'unset v; let "${v:-a[\$(SCRIPT)]}"',
     r"let x=a[\`SCRIPT\`]",
@@ -47,6 +49,7 @@ SINKS = [
 DATA = [
     "let '${v:-$(SCRIPT)}'",
     "let '$(SCRIPT)'",
+    'let "$""(SCRIPT)"',
     "let 'x=$(( $(SCRIPT) ))'",
     "[[ 1 -eq 1 && x == '$(SCRIPT)' ]]",
     "[[ 1 -eq '$(SCRIPT)' && 1 -eq a[1] ]]",
-- 
