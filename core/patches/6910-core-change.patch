Subject: [PATCH 6910] Replay sender: durable single-slot journal, deferred observation and bounded recovery (dormant)

Public mirror of source commit b93541c20c23f7593f80a726f5176eabf1376d3d.

---
diff --git a/hermes_cli/kanban_replay_existence.py b/hermes_cli/kanban_replay_existence.py
index 81989d6594d9e4354130e48f0eb8ece89a6b1ad0..1eb3760254992fefbf8699870a5886f3300aa62b 100644
--- a/hermes_cli/kanban_replay_existence.py
+++ b/hermes_cli/kanban_replay_existence.py
@@ -113,7 +113,7 @@
     """Explicit retry clears only a fault still bound to the exact pending slot."""
     if not reason.strip():
         raise ValueError('owner recovery reason required')
-    with write_txn(conn):
+    with write_txn(conn, allow_nested=True):
         held = fault(conn)
         state = journal.snapshot(conn)
         pending = state['pending']
diff --git a/hermes_cli/kanban_replay_recovery.py b/hermes_cli/kanban_replay_recovery.py
index 892b04396b336e3bdacf47ec97053fa778413c46..f638526661a8dbbb35e83c20084100a8f6c862fa 100644
--- a/hermes_cli/kanban_replay_recovery.py
+++ b/hermes_cli/kanban_replay_recovery.py
@@ -155,9 +155,22 @@
 def resume(conn, expected_op, reason):
     if not reason.strip():
         raise ValueError('owner recovery reason required')
-    with write_txn(conn):
+    with write_txn(conn, allow_nested=True):
         held = fault(conn)
         if held is None or expected_op != held['op_id'] or _bound(held) != _identity(journal.snapshot(conn)):
             raise ValueError('transport recovery identity changed; inspect without discarding custody')
         conn.execute('DELETE FROM kanban_replay_transport_fault1 WHERE id=1')
     return dict(action='retry_exact', op_id=expected_op, reason=reason[:500])
+
+
+def resume_all(conn, expected_op, reason):
+    """Release all same-operation retry holds atomically, or preserve every hold."""
+    from hermes_cli import kanban_replay_existence as existence
+    with write_txn(conn):
+        row_hold = existence.fault(conn)
+        transport_hold = fault(conn)
+        if row_hold is not None:
+            existence.resume(conn, expected_op, reason)
+        if transport_hold is not None or row_hold is None:
+            resume(conn, expected_op, reason)
+    return dict(action='retry_exact', op_id=expected_op, reason=reason[:500])
diff --git a/hermes_cli/kanban_sync_cli.py b/hermes_cli/kanban_sync_cli.py
