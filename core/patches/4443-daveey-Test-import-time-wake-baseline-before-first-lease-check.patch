From 2e51977721543a8dc6993d512e7663b380522e76 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 06:00:44 +0000
Subject: [PATCH] [daveey] Test import-time wake baseline before first lease
 check

Fresh isolated module import precedes a fake 400-second suspend and the first lapsed-row check. Cover retained grace, grace expiry, and a no-suspend control without manually priming the tracker.

Proof: drop-import-baseline mutant fails the 400-second first-call assertion (no-suspend control passes); restored production source passes all 62 tests across the new file and four lease/write-guard neighbours. Test-only change.
---
 .../test_wake_grace_import_baseline.py        | 35 +++++++++++++++++++
 1 file changed, 35 insertions(+)
 create mode 100644 tests/hermes_state/test_wake_grace_import_baseline.py

diff --git a/tests/hermes_state/test_wake_grace_import_baseline.py b/tests/hermes_state/test_wake_grace_import_baseline.py
new file mode 100644
index 0000000000000000000000000000000000000000..87ae6922d34a1f7b8dc3fff55c7fcd1fc648c814
--- /dev/null
+++ b/tests/hermes_state/test_wake_grace_import_baseline.py
@@ -0,0 +1,35 @@
+"""The first lease check after suspend must use the sample taken at import."""
+
+import importlib.util
+import time
+
+import pytest
+
+import hermes_state_wake_grace as wake_grace
+from hermes_platform import quiet_clock
+
+
+@pytest.mark.parametrize("suspend_seconds", [0, 400])
+def test_first_lapsed_row_check_uses_import_baseline(monkeypatch, suspend_seconds):
+    suspended_ns = 1000 * 10**9
+    monkeypatch.setattr(
+        quiet_clock, "suspend_inclusive_ns",
+        lambda: time.monotonic_ns() + suspended_ns,
+    )
+    # Execute a fresh module without resetting or sampling its tracker ourselves.
+    # Keep it separate from the singleton used by SessionDB and neighbouring tests.
+    spec = importlib.util.spec_from_file_location("_wake_grace_import_probe", wake_grace.__file__)
+    assert spec is not None and spec.loader is not None
+    fresh = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(fresh)
+    awake = 50_000.0
+    monkeypatch.setattr(fresh, "_awake_now", lambda: awake)
+
+    # The process stays alive across sleep, but makes no lease call before waking.
+    suspended_ns += suspend_seconds * 10**9
+    holder = "pid=123:turn=live"
+    assert fresh.lapsed_row_reclaimable(holder, expires_at=300, now=500) is (suspend_seconds == 0)
+    awake += fresh.WAKE_GRACE_SECONDS - 1
+    assert fresh.lapsed_row_reclaimable(holder, expires_at=300, now=589) is (suspend_seconds == 0)
+    awake += 2
+    assert fresh.lapsed_row_reclaimable(holder, expires_at=300, now=591) is True
