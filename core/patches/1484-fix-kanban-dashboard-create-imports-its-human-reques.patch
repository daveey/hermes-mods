From b41abac0746f0506a62bfcc8baf88da2a6bee2d8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 01:42:29 -0800
Subject: [PATCH] fix(kanban): dashboard create imports its human-request
 sibling absolutely; resolved_check schema drops maxLength [daveey]

The dashboard loader (web_server_dashboard / plugin_host_child) execs plugin_api.py as a top-level
module (hermes_dashboard_plugin_kanban), so 'from .plugin_api_human_request import' raised
'attempted relative import with no known parent package' on every POST /tasks. Use the absolute
plugins.kanban.dashboard.* import the file already uses for that sibling.

resolved_check carried maxLength 2000, which llama.cpp's grammar converter rejects (#131278);
RESOLVED_CHECK_MAX_CHARS still enforces it server-side, as the clarify schema does.
---
 plugins/kanban/dashboard/plugin_api.py | 2 +-
 tools/kanban_tools_schemas.py          | 4 +++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/plugins/kanban/dashboard/plugin_api.py b/plugins/kanban/dashboard/plugin_api.py
index 713664035b..82365b46fd 100644
--- a/plugins/kanban/dashboard/plugin_api.py
+++ b/plugins/kanban/dashboard/plugin_api.py
@@ -571,7 +571,7 @@ def create_task(payload: CreateTaskBody, board: Optional[str] = Query(None)):
             parents=list(payload.parents), entry="rest")
         if refused:
             raise HTTPException(status_code=409, detail=json.loads(refused))
-        from .plugin_api_human_request import check_create_ask
+        from plugins.kanban.dashboard.plugin_api_human_request import check_create_ask
         check_create_ask(conn, payload)
         task_id = kanban_db.create_task(conn, created_by="dashboard", board=board, **fields)
         after_create(conn, task_id)
diff --git a/tools/kanban_tools_schemas.py b/tools/kanban_tools_schemas.py
index b6ebae3110..720a50f531 100644
--- a/tools/kanban_tools_schemas.py
+++ b/tools/kanban_tools_schemas.py
@@ -268,7 +268,9 @@ HUMAN_REQUEST = {
                 "value": {"type": "string", "minLength": 1, "maxLength": 120}},
                 "required": ["label", "value"], "additionalProperties": False},
         },
-        "resolved_check": {"type": "string", "minLength": 1, "maxLength": 2000, "description": (
+        # no maxLength: llama.cpp's grammar converter rejects >=2000 (#131278); kanban_human_request enforces
+        # RESOLVED_CHECK_MAX_CHARS server-side.
+        "resolved_check": {"type": "string", "minLength": 1, "description": (
             "Optional shell probe (bash -lc, 30 s) that tells when David's step is done even if he never "
             "unblocks: exit 0 = done, 1 = not yet, anything else = broken. It runs once when you file the "
             "ask: exit 0 refuses the ask (ask_already_resolved: the state already holds, continue the work), "
