From: daveey <daveey@users.noreply.github.com>
Date: Tue, 24 Nov 2026 08:56:57 -0800
Subject: [PATCH 6181] Standing producer owner chats and local origin custody

Public mirror of source commit fabef70ec12478a362ccbd30f446d9bf1e3b5fb3.

---
diff --git a/hermes_cli/kanban_owner_chat.py b/hermes_cli/kanban_owner_chat.py
index 1f72c08c0ec..1f58100d4a9 100644
--- a/hermes_cli/kanban_owner_chat.py
+++ b/hermes_cli/kanban_owner_chat.py
@@ -314,9 +314,11 @@
     failed: set[str] = set()
     try:
         found, linked = ownerless(conn, live), []
+        eligible = found
         if apply:
             forced: set[str] = set()
-            for task_id, producer in [c for c in found if c[0] not in _UNLINKABLE][:limit]:
+            eligible = [c for c in found if c[0] not in _UNLINKABLE]
+            for task_id, producer in eligible[:limit]:
                 dead = _needs_owner(conn, task_id, links, live)
                 if dead is None or producer in failed:
                     continue
@@ -340,19 +342,23 @@
     by_producer: dict[str, int] = {}
     for _, producer in found:
         by_producer[producer] = by_producer.get(producer, 0) + 1
-    return {"ownerless": len(found), "linked": len(linked), "by_producer": by_producer, "failed": sorted(failed)}
+    return {"ownerless": len(found), "linked": len(linked), "by_producer": by_producer, "failed": sorted(failed),
+            "eligible": len(eligible)}
 
 
 def _relink(conn, task_id: str, producer: str, sid: str, links: bool, live) -> bool:
     """Under the write lock: own the card by ``sid`` if it still needs an owner. True when newly linked or its
     archived chat was just restored."""
+    from hermes_cli.kanban_adoption_authority import gateway as _gateway
+    from hermes_cli.profiles import get_active_profile_name
     dead = _needs_owner(conn, task_id, links, live)
     if dead is None:
         return False
+    here = f"{_gateway(conn)}/{get_active_profile_name()}/"
     for ref in dead:
         if ref != sid:  # a notice to a deleted/archived owner chat is dropped: stop binding the card to it
-            conn.execute("DELETE FROM kanban_notify_subs WHERE task_id=? AND (chat_id=? OR chat_id LIKE ?)",
-                         (task_id, ref, "%/" + ref))
+            conn.execute("DELETE FROM kanban_notify_subs WHERE task_id=? AND chat_id IN (?, ?)",
+                         (task_id, ref, here + ref))
     return link(conn, task_id, producer, sid) or sid in dead
 
 
@@ -366,7 +372,9 @@
         return None
     _NEXT_BACKFILL[path] = now + BACKFILL_CATCHUP_S  # set first: a pass that raises waits, never reruns every tick
     result = backfill(conn, apply=True, limit=BACKFILL_BATCH)
-    full = result["ownerless"] > BACKFILL_BATCH or bool(result["failed"])
+    full = result["eligible"] > BACKFILL_BATCH or bool(result["failed"])
+    if not full:
+        _UNLINKABLE.clear()  # the hourly pass gives cards that could not be owned another try
     _NEXT_BACKFILL[path] = now + (BACKFILL_CATCHUP_S if full else BACKFILL_EVERY_S)
     if result["linked"]:
         log.info("kanban owner chats: linked %d ownerless cards %s", result["linked"], result["by_producer"])
diff --git a/tests/hermes_cli/test_kanban_owner_chat.py b/tests/hermes_cli/test_kanban_owner_chat.py
index 70ee50b17e9..f866bb9de0c 100644
--- a/tests/hermes_cli/test_kanban_owner_chat.py
+++ b/tests/hermes_cli/test_kanban_owner_chat.py
@@ -172,7 +172,8 @@
             conn.execute("UPDATE tasks SET status='done' WHERE id=?", (finished,))
         monkeypatch.setattr(owner, "enabled", lambda: True)
         dry = owner.backfill(conn, apply=False)
-        assert dry == {"ownerless": 1, "linked": 0, "by_producer": {"worker-claim-watch": 1}, "failed": []}
+        assert dry == {"ownerless": 1, "linked": 0, "by_producer": {"worker-claim-watch": 1}, "failed": [],
+                       "eligible": 1}
         assert _links(conn, old) == []
         applied = owner.backfill(conn, apply=True)
         assert applied["linked"] == 1
@@ -344,7 +345,7 @@
         synced.execute("INSERT INTO task_chat_links (uid,task_id,chat_gateway,chat_profile,chat_session,kind,"
                        "released,created_at) VALUES ('u1',?,'hub',NULL,'20261124_120000_gone','created',1,0)", (tid,))
     monkeypatch.setattr(owner, "enabled", lambda: True)
-    assert owner.backfill(synced, apply=True) == {"ownerless": 0, "linked": 0, "by_producer": {}, "failed": []}
+    assert owner.backfill(synced, apply=True) == {"ownerless": 0, "linked": 0, "by_producer": {}, "failed": [], "eligible": 0}
 
 
 def test_owner_chats_cli_lists_then_links(kanban_home, monkeypatch, capsys):
@@ -455,7 +456,7 @@
         assert not db.get_session(sid)["archived"]
     finally:
         db.close()
-    assert owner.backfill(synced, apply=True) == {"ownerless": 0, "linked": 0, "by_producer": {}, "failed": []}
+    assert owner.backfill(synced, apply=True) == {"ownerless": 0, "linked": 0, "by_producer": {}, "failed": [], "eligible": 0}
     assert sum(e.kind == owner.EVENT for e in kb.list_events(synced, tid)) == 1
 
 
@@ -531,3 +532,18 @@
         assert stuck in owner._UNLINKABLE
         assert owner.backfill(conn, apply=True, limit=1)["linked"] == 1  # the next pass moves on
         assert _links(conn, other)
+
+
+def test_unlinkable_cards_neither_keep_the_catch_up_pace_nor_stay_skipped_forever(kanban_home, monkeypatch,
+                                                                                    owner_backfill):
+    monkeypatch.setattr(owner, "_NEXT_BACKFILL", {})
+    monkeypatch.setattr(owner, "BACKFILL_BATCH", 1)
+    monkeypatch.setattr(owner, "enabled", lambda: False)
+    with kbc.connect_closing() as conn:
+        stuck = [kb.create_task(conn, title=f"stuck {n}", assignee="default", created_by="self-heal") for n in range(2)]
+        monkeypatch.setattr(owner, "enabled", lambda: True)
+        monkeypatch.setattr(owner, "_UNLINKABLE", set(stuck))
+        result = owner.maybe_backfill(conn, now=0.0)
+        assert result["eligible"] == 0 and result["linked"] == 0
+        assert owner._NEXT_BACKFILL[next(iter(owner._NEXT_BACKFILL))] == owner.BACKFILL_EVERY_S  # hourly, not 10 min
+        assert owner._UNLINKABLE == set()  # retried on the next hourly pass
