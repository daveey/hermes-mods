From 89bca8245384c430e1c4876398162b79f0df35d4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 21:45:17 +0000
Subject: [PATCH] [daveey] keep board memo revalidation in topical sibling

---
 hermes_cli/kanban_session_activity.py            |  8 +-------
 hermes_cli/kanban_session_activity_revalidate.py | 12 ++++++++++++
 2 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index 75bf882b4d5..f8db97c64c0 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -1352,13 +1352,7 @@ def _read_local_boards(active: dict[str, int], blocked: dict[str, int], unseen:
         _board_memo.pop(gone, None)
     now = time.time()
     for path in paths:
-        key = _board_content_key(path)
-        if key[:1] == ("stat",):
-            # A same-mtime commit must not survive the counts TTL through this
-            # row memo. data_version observes commits on the retained reader;
-            # bind it to that connection because its sequence is connection-local.
-            with cached_ro(path) as conn:
-                key = (key, conn, conn.execute("PRAGMA data_version").fetchone()[0])
+        key = _revalidate.board_memo_key(path)
         hit = _board_memo.get(str(path))
         reads = hit[1] if hit is not None and hit[0] == key else None
         if reads is not None and ((sink is not None and "parked" not in reads)
diff --git a/hermes_cli/kanban_session_activity_revalidate.py b/hermes_cli/kanban_session_activity_revalidate.py
index 11e02bc1daa..ee5d184133a 100644
--- a/hermes_cli/kanban_session_activity_revalidate.py
+++ b/hermes_cli/kanban_session_activity_revalidate.py
@@ -37,6 +37,18 @@ def revalidatable(fingerprint: tuple, wall: float) -> bool:
     return True
 
 
+def board_memo_key(path) -> tuple:
+    """Observe same-stat commits before reusing per-board rows, independently of the counts TTL."""
+    from hermes_cli import kanban_session_activity as _ksa
+
+    key = _ksa._board_content_key(path)
+    if key[:1] == ("stat",):
+        # data_version is connection-local: retain identity to reject a replacement reader.
+        with _ksa.cached_ro(path) as conn:
+            return key, conn, conn.execute("PRAGMA data_version").fetchone()[0]
+    return key
+
+
 def counts_fresh(scope: tuple[str, ...], fingerprint: tuple, now: float) -> bool:
     """Caller holds ``_ksa._cache_lock``. The cached counts answer for ``fingerprint``: same scope and inputs, and
     either within the TTL or (``revalidatable`` fingerprint) younger than ``_ksa._COUNTS_MAX_AGE_S``."""
-- 
