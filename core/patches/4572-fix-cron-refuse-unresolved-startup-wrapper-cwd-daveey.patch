From 6f822f661df22617dead75397a54890318a9b8c1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 10:40:48 +0000
Subject: [PATCH] fix(cron): refuse unresolved startup wrapper cwd [daveey]

---
 cron/lifecycle_guard_startup.py                | 15 ++++++++++++---
 tests/cron/test_lifecycle_guard_startup_env.py | 14 ++++++++++++++
 2 files changed, 26 insertions(+), 3 deletions(-)

diff --git a/cron/lifecycle_guard_startup.py b/cron/lifecycle_guard_startup.py
index 98ae960bb710d2264d1d846e0bdf2a09530d6969..2b34406b10b3cc886d3ab37ad095b47d15ef6bbe 100644
--- a/cron/lifecycle_guard_startup.py
+++ b/cron/lifecycle_guard_startup.py
@@ -37,7 +37,7 @@ def _startup_variable(shell: str, arguments: list[str]) -> str | None:
     return "BASH_ENV" if shell == "bash" and not interactive else None
 
 
-def iter_startup_sources(command: str) -> Iterator[str]:
+def iter_startup_sources(command: str) -> Iterator[tuple[str, bool]]:
     """Source explicit assignment-prefix/env-wrapper files before child-shell payloads.
 
     Reuse the ordinary source walk so local/remote read limits, cycles and refusals
@@ -62,15 +62,24 @@ def iter_startup_sources(command: str) -> Iterator[str]:
         variable = _startup_variable(shell, view[index + 1:])
         if variable is None:
             continue
+        # Wrapper chdir changes both startup resolution and its relative commands.
+        # Until the recursive walk carries wrapper cwd, refuse rather than read
+        # a same-named clean file from the caller's directory.
+        changes_cwd = any(word.startswith(("-C", "--chdir")) for word in view[:index])
         for word in view[:index]:
             name, equals, value = word.partition("=")
             if equals and name == variable and value:
-                yield value
+                yield value, changes_cwd
 
 
 def scan_startup_sources(command, recurse, budget, cwd, executed, source) -> bool:
     """Walk startup input before -c text; never evaluate dynamic names in the guard."""
-    for value in iter_startup_sources(command):
+    for value, changes_cwd in iter_startup_sources(command):
+        if changes_cwd:
+            if executed:
+                budget.refusal = "Cannot statically resolve shell startup working directory through chdir wrapper"
+                return True
+            continue
         if "$" in value or "`" in value:
             if executed:
                 budget.refusal = "Cannot statically resolve shell startup file expansion; use a literal path"
diff --git a/tests/cron/test_lifecycle_guard_startup_env.py b/tests/cron/test_lifecycle_guard_startup_env.py
index 6331c77d715fb5169aebb660860ae2e24a2081fa..f005773da3accbfb31b5859856c99bd1fbb2365c 100644
--- a/tests/cron/test_lifecycle_guard_startup_env.py
+++ b/tests/cron/test_lifecycle_guard_startup_env.py
@@ -102,6 +102,20 @@ def test_dynamic_startup_paths_fail_closed_without_execution(tmp_path, value):
     assert not (tmp_path / "ran").exists()
 
 
+@pytest.mark.platforms("linux")
+@pytest.mark.parametrize("option", ["-C sub", "-Csub", "--chdir=sub", "--chdir sub"])
+def test_env_chdir_startup_fails_closed(tmp_path, option):
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub/start.sh").write_text("touch ran\n")
+    command = f"env {option} BASH_ENV=start.sh bash -c true"
+    result = run_bash(tmp_path, command)
+    assert (tmp_path / "sub/ran").exists(), result.stderr
+    (tmp_path / "sub/ran").unlink()
+    unsafe, refusal = scan_gateway_lifecycle(command, cwd=str(tmp_path))
+    assert unsafe and refusal and "startup working directory" in refusal
+    assert not (tmp_path / "sub/ran").exists()
+
+
 def test_startup_remote_read_uses_same_walk(tmp_path):
     seen = []
 
