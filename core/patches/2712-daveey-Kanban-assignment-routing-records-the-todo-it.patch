From 76771af297b298eae0c635ddf59fdf0a2f42752a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 12:20:41 +0000
Subject: [PATCH] [daveey] Kanban assignment routing records the todo it lands,
 so the sync heal does not strand it blocked

block_task records status='blocked' before assignment_routing.route() moves the
card to todo behind its supervisor card. The sync heal prefers that recorded
status, so a stale running copy over an assignment-routed run end healed to
blocked, where the supervisor's completion never promotes it. route() now sets
payload['status']='todo' next to supervisor_task_id. Review t_01a1cfa2752afe62.
Also documents why a block_loop_detected end is reclaimed to todo, not parked.
---
 hermes_cli/kanban_assignment_routing.py            | 1 +
 hermes_cli/kanban_sync_divergence.py               | 3 ++-
 tests/hermes_cli/test_kanban_assignment_routing.py | 4 ++++
 tests/hermes_cli/test_kanban_sync_running_heal.py  | 9 +++++++++
 4 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_assignment_routing.py b/hermes_cli/kanban_assignment_routing.py
index 509cf57214..f73143f2f8 100644
--- a/hermes_cli/kanban_assignment_routing.py
+++ b/hermes_cli/kanban_assignment_routing.py
@@ -265,5 +265,6 @@ def route(conn, task, payload):
     )
     kb._link(conn, supervisor_id, task.id)
     conn.execute("UPDATE tasks SET status='todo' WHERE id=?", (task.id,))
+    payload['status'] = 'todo'  # where the card landed (block_task recorded 'blocked'); the sync heal restores it
     payload['supervisor_task_id'] = supervisor_id
     payload['supervisor_profile'] = name
diff --git a/hermes_cli/kanban_sync_divergence.py b/hermes_cli/kanban_sync_divergence.py
index fd1cf7455d..bca58e9a40 100644
--- a/hermes_cli/kanban_sync_divergence.py
+++ b/hermes_cli/kanban_sync_divergence.py
@@ -197,7 +197,8 @@ def _parked_status(live: sqlite3.Connection, tid: str, run: sqlite3.Row) -> tupl
     must name it. The card's last lifecycle move since then decides: that park event, or a later park event (the
     wake invariant turns a wakeless human ``scheduled`` wait into ``blocked``), lands where it recorded
     (``_landing``); anything else (an unblock, a wake, a review reopen, a triage sweep) means the card left it.
-    Events are ordered by origin time (``_event_order``)."""
+    A ``block_loop_detected`` end is not a park either: the heal reclaims it to ``todo`` like any loop sweep, and
+    the loop detector re-parks it if the run loops again. Events are ordered by origin time (``_event_order``)."""
     if (run["outcome"] or "") not in _PARKS:
         return None
     cols = {r[1] for r in live.execute("PRAGMA table_info(task_events)")}
diff --git a/tests/hermes_cli/test_kanban_assignment_routing.py b/tests/hermes_cli/test_kanban_assignment_routing.py
index ad9cdd67ea..a33da28844 100644
--- a/tests/hermes_cli/test_kanban_assignment_routing.py
+++ b/tests/hermes_cli/test_kanban_assignment_routing.py
@@ -6,6 +6,7 @@ import pytest
 
 from hermes_cli import kanban_db as kb
 from hermes_cli import kanban_session_activity as activity
+from hermes_cli.kanban_sync_divergence import _landing
 
 
 @pytest.fixture
@@ -50,6 +51,9 @@ def test_routes_real_mismatch_to_durable_supervisor(board, kind):
     audit = payload(conn, tid)
     assert audit['requested_kind'] == kind
     assert audit['rekind_reason'] == ('profile_capability_mismatch' if kind == 'capability' else None)
+    assert audit['status'] == 'todo'  # where routing left it, not 'blocked': the sync heal restores this status
+    event = dict(conn.execute('SELECT kind, payload FROM task_events WHERE task_id=? AND kind="blocked"', (tid,)).fetchone())
+    assert _landing(event) is None  # not a park: a heal over this run lands todo, behind the supervisor
     supervisor = kb.get_task(conn, audit['supervisor_task_id'])
     assert supervisor.assignee == 'supervisor'
     assert supervisor.status == 'ready'
diff --git a/tests/hermes_cli/test_kanban_sync_running_heal.py b/tests/hermes_cli/test_kanban_sync_running_heal.py
index f57aa6bcad..89554eb453 100644
--- a/tests/hermes_cli/test_kanban_sync_running_heal.py
+++ b/tests/hermes_cli/test_kanban_sync_running_heal.py
@@ -179,6 +179,15 @@ def test_an_exhausted_budget_block_lands_triage_not_blocked(live, kanban_home, s
     assert _status(live, tid) == "triage"
 
 
+def test_an_assignment_routed_block_lands_todo_behind_its_supervisor(live, kanban_home, svc):
+    """``assignment_routing.route`` moves the card to ``todo`` behind a supervisor; ``blocked`` would strand it."""
+    tid = _regressed(live, kanban_home, svc, status="todo", outcome="blocked", completed_at=None,
+                     end_payload={"kind": "assignment", "reason": "r", "source_status": "ready", "status": "todo",
+                                  "supervisor_task_id": "t_sup", "supervisor_profile": "supervisor"})
+    _heal_through_rounds(live, kanban_home, svc)
+    assert _status(live, tid) == "todo"
+
+
 def test_a_metadata_only_block_event_is_not_a_move(live, kanban_home, svc):
     """``kanban_human_request_migration.classify`` re-files the ask on a ``triage`` card with a ``blocked`` event."""
     tid = _regressed(live, kanban_home, svc, status="triage", outcome="blocked", completed_at=None,
