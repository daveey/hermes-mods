From 1b3d042340fd642dfa9045c200546f1e7f4094d7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 01:18:06 +0000
Subject: [PATCH] test(kanban): same-board producer wake note omits --gateway

79890017fb4 made the wake note for a producer on this board point at
'hermes kanban wait-check task <id>' without --gateway (the probe reads this
board). The shared _assert_woken helper still required --gateway for every
producer, so test_local_producer_completed_after_the_park_wakes_it failed in CI
(run 42929724235, shard 6/8). Assert the board-local form for 'this board' and
keep the --gateway form for remote producers.
---
 tests/hermes_cli/test_kanban_park_producer_finished.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_park_producer_finished.py b/tests/hermes_cli/test_kanban_park_producer_finished.py
index dd3bd881b17..02e5ed61a49 100644
--- a/tests/hermes_cli/test_kanban_park_producer_finished.py
+++ b/tests/hermes_cli/test_kanban_park_producer_finished.py
@@ -79,7 +79,12 @@ def _assert_woken(conn, tid, ref, gateway_word):
     note = [c for c in kb.list_comments(conn, tid) if c.author == "kanban-dispatcher"][-1].body
     assert f"Woken: producer card {ref} on {gateway_word} is done" in note, note
     assert "hermes kanban show` reads only this host's board" in note, note
-    assert f"hermes kanban wait-check task {ref} --gateway" in note, note
+    if gateway_word == "this board":
+        # Same-host producer: the probe reads this board, so the note must not send the waiter to a --gateway.
+        assert f"hermes kanban wait-check task {ref}`" in note, note
+        assert "--gateway" not in note, note
+    else:
+        assert f"hermes kanban wait-check task {ref} --gateway" in note, note
     assert "add `--from <that status>`. Those statuses count as met" in note, note
     ctx = kwc.render_wake_context(conn, tid)
     assert "producer card" in ctx and ref in ctx, ctx
-- 
