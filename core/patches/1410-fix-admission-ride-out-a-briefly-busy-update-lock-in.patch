         yield root
     finally:
diff --git a/hermes_cli/backend_retirement.py b/hermes_cli/backend_retirement.py
index b2837d3a52c..f66f4c2c36e 100644
--- a/hermes_cli/backend_retirement.py
+++ b/hermes_cli/backend_retirement.py
@@ -5,11 +5,75 @@ close the check/use race: every source of new work must reserve admission before
 """
 
 from contextlib import contextmanager
+from contextvars import ContextVar
 import logging
 import secrets
 import threading
 import time
 
+# [daveey] A busy admission.lock is not an update hold (agent-6f2f71c662): hermes-sync's state read,
+# its hold write and Kanban claims hold it past one 50 ms try on a loaded Mac, and every such refusal
+# dropped a typed message, notification or goal turn. Turn sources retry a busy lock (50 ms tries) for up
+# to BUSY_WAIT_S; a real hold or a retiring backend still refuses at once. The one caller that reserves
+# under the session resume lock (prompt.admit) passes busy_wait_s=0 and keeps a single try.
+BUSY_WAIT_S = 0.5
+_refusal: ContextVar = ContextVar("update_admission_refusal", default=None)
+_busy_wait_override: ContextVar = ContextVar("update_admission_busy_wait", default=None)
+_log = logging.getLogger(__name__)
+
+
+@contextmanager
+def single_lock_try():
+    """Reservations made inside (this context only) take one short lock try, no busy-lock retry.
+
+    For code that reserves while holding the session resume lock without owning the call site's
+    signature (warm session.resume scheduling auto-continue)."""
+    token = _busy_wait_override.set(0.0)
+    try:
+        yield
+    finally:
+        _busy_wait_override.reset(token)
+
+
+def last_refusal():
+    """Why this context's latest ``reservation`` refused: "retiring", "held", "busy", "unavailable", or None."""
+    return _refusal.get()
+
+
+def refusal_text():
+    """The 5035 text for the latest refusal in this context."""
+    if _refusal.get() == "busy":
+        return "update admission is briefly busy (another Hermes process holds the update lock); retry"
+    return "backend is retiring or update admission is paused; retry after the update"
+
+
+def _reserve(root, busy_wait_s, what):
+    """``admission_fence.reserve`` that rides out a briefly busy lock. Returns (reservation | None, reason).
+
+    Each try keeps reserve's own 50 ms lock cap, so a caller never blocks longer than busy_wait_s + 50 ms.
+    A hold returns (None, "held") at once; any other fence error fails closed with its traceback."""
+    from hermes_cli import admission_fence
+
+    started = time.monotonic()
+    tries = 0
+    while True:
+        tries += 1
+        try:
+            pending = admission_fence.reserve(root)
+        except admission_fence.AdmissionBusy:
+            waited = time.monotonic() - started
+            if waited >= busy_wait_s:
+                _log.warning("%s unavailable: update admission lock busy for %.1fs (no update hold)", what, waited)
+                return None, "busy"
+            continue
+        except (OSError, TimeoutError):
+            _log.warning("%s unavailable", what, exc_info=True)
+            return None, "unavailable"
+        if tries > 1:
+            _log.debug("update admission lock was busy for %.2fs; %s after %d tries",
+                       time.monotonic() - started, "admitted" if pending is not None else "held", tries)
+        return pending, (None if pending is not None else "held")
+
 # [daveey] Background reviews (the post-turn memory/skill review fork) run on a daemon thread with
 # no session turn lease and no admission reservation, so the idle proof read a backend mid-review
 # as idle and retirement hard-interrupted the review mid-call (2026-10-28 04:38, two reviews lost).
@@ -81,15 +145,12 @@ class RetirementFence:
         if the call outlasts the window, the window expires rather than killing it.
         """
         from hermes_constants import get_default_hermes_root, get_hermes_home
-        from hermes_cli.admission_fence import reserve, SUPPORTED
+        from hermes_cli.admission_fence import SUPPORTED
 
         pending = None
         if SUPPORTED:
-            try:
-                pending = reserve(get_default_hermes_root(home=get_hermes_home()))
-            except (OSError, TimeoutError):
-                logging.getLogger(__name__).warning("Review update admission unavailable", exc_info=True)
-                return None
+            pending, _reason = _reserve(get_default_hermes_root(home=get_hermes_home()), BUSY_WAIT_S,
+                                        "Review update admission")
             if pending is None:
                 return None
         with self._lock:
@@ -131,30 +192,38 @@ class RetirementFence:
                 self.release()
 
     @contextmanager
-    def reservation(self, home=None):
+    def reservation(self, home=None, *, busy_wait_s=None):
         """Compose process retirement with the cross-process update reservation.
 
         Neither lock is held while acquiring the other, or while callers hold
         session locks. The pending reservation remains visible until publication.
+        A briefly busy admission.lock is retried for ``busy_wait_s`` (default
+        BUSY_WAIT_S; 0 = one 50 ms try, for callers holding the session resume
+        lock, also forced by ``single_lock_try()``); the refusal reason is
+        readable afterwards through ``last_refusal()``.
         """
         from hermes_constants import get_default_hermes_root, get_hermes_home
-        from hermes_cli.admission_fence import reserve, HOLD_MESSAGE, SUPPORTED
+        from hermes_cli.admission_fence import HOLD_MESSAGE, SUPPORTED
 
+        if busy_wait_s is None:
+            override = _busy_wait_override.get()
+            busy_wait_s = BUSY_WAIT_S if override is None else override
         if not SUPPORTED:
             with self.work() as admitted:
+                _refusal.set(None if admitted else "retiring")
                 yield admitted
             return
 
         admitted = self.acquire()
         pending = None
         try:
+            reason = "retiring"
             if admitted:
-                try:
-                    pending = reserve(get_default_hermes_root(home=home or get_hermes_home()))
-                except (OSError, TimeoutError):
-                    logging.getLogger(__name__).warning("Update admission unavailable", exc_info=True)
-                if pending is None:
-                    logging.getLogger(__name__).info(HOLD_MESSAGE)
+                pending, reason = _reserve(get_default_hermes_root(home=home or get_hermes_home()),
+                                           busy_wait_s, "Update admission")
+                if reason == "held":
+                    _log.info(HOLD_MESSAGE)
+            _refusal.set(reason)
             yield admitted and pending is not None
         finally:
             try:
diff --git a/tests/hermes_cli/test_admission_fence.py b/tests/hermes_cli/test_admission_fence.py
index d7180d0269c..6be3802ec4c 100644
--- a/tests/hermes_cli/test_admission_fence.py
+++ b/tests/hermes_cli/test_admission_fence.py
@@ -30,6 +30,150 @@ def _lock_child(home, ready, finish):
         finish.wait(20)
 
 
+def _timed_lock_child(home, ready, hold_s):
+    import time
+    with af.admission_lock(home):
+        ready.set()
+        time.sleep(hold_s)  # health: allow HX013 -- how long another process holds the lock IS the contention under test
+
+
+def _spawn_lock_holder(home, hold_s):
+    ctx = multiprocessing.get_context("spawn")
+    ready = ctx.Event()
+    child = ctx.Process(target=_timed_lock_child, args=(home, ready, hold_s))
+    child.start()
+    assert ready.wait(20)
+    return child
+
+
+def _reap(child):
+    if child.is_alive():
+        child.kill()
+    child.join(10)
+
+
+def _busy_records(caplog):
+    return [r for r in caplog.records if r.name == "hermes_cli.backend_retirement" and r.levelno >= 30]
+
+
+def test_reservation_survives_lock_briefly_busy_without_hold(tmp_path, caplog):
+    """[daveey] Another process holding admission.lock for 200 ms (no update hold) must not refuse a
+    turn: hermes-sync's state read and Kanban claims hold it that long on a loaded Mac (agent-6f2f71c662)."""
+    import logging
+    caplog.set_level(logging.DEBUG, logger="hermes_cli.backend_retirement")
+    child = _spawn_lock_holder(tmp_path, 0.2)
+    try:
+        fence = RetirementFence()
+        with fence.reservation(tmp_path) as admitted:
+            assert admitted
+            assert not child.is_alive() or af.state(tmp_path)["reservations"] == 1
+        assert not _busy_records(caplog)
+    finally:
+        _reap(child)
+    assert af.state(tmp_path)["reservations"] == 0
+
+
+def test_reservation_refuses_long_busy_lock_with_one_warning(tmp_path, caplog):
+    import logging
+    import time
+    caplog.set_level(logging.DEBUG, logger="hermes_cli.backend_retirement")
+    child = _spawn_lock_holder(tmp_path, 2.0)
+    try:
+        fence = RetirementFence()
+        started = time.monotonic()
+        with fence.reservation(tmp_path) as admitted:
+            elapsed = time.monotonic() - started
+            assert not admitted
+        assert 0.45 <= elapsed < 1.5
+        records = _busy_records(caplog)
+        assert len(records) == 1, [r.getMessage() for r in records]
+        message = records[0].getMessage()
+        assert "update admission lock busy for" in message and "no update hold" in message
+        assert records[0].exc_info is None
+        from hermes_cli.backend_retirement import last_refusal
+        assert last_refusal() == "busy"
+        assert fence.active_count() == 0
+    finally:
+        _reap(child)
+
+
+def test_hold_refuses_at_once_without_busy_retry(tmp_path, caplog):
+    import logging
+    import time
+    caplog.set_level(logging.DEBUG, logger="hermes_cli.backend_retirement")
+    af.set_hold(tmp_path)
+    fence = RetirementFence()
+    started = time.monotonic()
+    with fence.reservation(tmp_path, busy_wait_s=5.0) as admitted:
+        assert not admitted
+    assert time.monotonic() - started < 0.3
+    assert not _busy_records(caplog)
+    from hermes_cli.backend_retirement import last_refusal
+    assert last_refusal() == "held"
+
+
+def test_zero_busy_wait_makes_one_short_try(tmp_path):
+    """The prompt-admission path holds the session resume lock: it keeps a single 50 ms try."""
+    import time
+    child = _spawn_lock_holder(tmp_path, 2.0)
+    try:
+        fence = RetirementFence()
+        started = time.monotonic()
+        with fence.reservation(tmp_path, busy_wait_s=0) as admitted:
+            assert not admitted
+        assert time.monotonic() - started < 0.3
+        session = {"history_lock": threading.RLock(), "profile_home": str(tmp_path)}
+        from hermes_cli import backend_retirement
+        real = backend_retirement.retirement
+        backend_retirement.retirement = fence
+        try:
+            started = time.monotonic()
+            with server._session_turn_admission(session, busy_wait_s=0) as admitted:
+                assert not admitted
+            assert time.monotonic() - started < 0.3
+        finally:
+            backend_retirement.retirement = real
+        from hermes_cli.backend_retirement import single_lock_try
+        started = time.monotonic()
+        with single_lock_try():
+            with fence.reservation(tmp_path) as admitted:
+                assert not admitted
+        assert time.monotonic() - started < 0.3
+    finally:
+        _reap(child)
+
+
+def test_busy_refusal_text_says_briefly_busy(tmp_path, monkeypatch):
+    """prompt.submit's 5035 names a busy lock as briefly busy, not as a paused update."""
+    from hermes_cli import backend_retirement
+    fence = RetirementFence()
+    monkeypatch.setattr(backend_retirement, "retirement", fence)
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    session = {"history_lock": threading.RLock(), "profile_home": str(tmp_path), "session_key": "k"}
+    child = _spawn_lock_holder(tmp_path, 2.0)
+    try:
+        error, _ = server._lock_in_submit_turn("r", "s", session, "hi", {}, False, None, None, None)
+    finally:
+        _reap(child)
+    assert error["error"]["code"] == 5035
+    assert "briefly busy" in error["error"]["message"]
+    af.set_hold(tmp_path)
+    error, _ = server._lock_in_submit_turn("r", "s", session, "hi", {}, False, None, None, None)
+    assert "update admission is paused" in error["error"]["message"]
+
+
+def test_background_review_survives_briefly_busy_lock(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    child = _spawn_lock_holder(tmp_path, 0.2)
+    try:
+        fence = RetirementFence()
+        hold = fence.begin_background_review()
+        assert hold is not None
+        fence.end_background_review(hold)
+    finally:
+        _reap(child)
+
+
 def test_hold_refuses_and_existing_reservation_survives(tmp_path):
     reservation = af.reserve(tmp_path)
     assert af.state(tmp_path)["reservations"] == 1
