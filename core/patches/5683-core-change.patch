From 3f2eb7e5c7d207e599132b5bf06f729aa487a0a5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 06:25:29 +0000
Subject: [PATCH] [daveey] retain actionable diagnostics without inventing
 rejection authority

Why: repeated Board storage_error replies had no durable reason in retain outbox custody. Receipt replay itself can raise storage_error after a lost applied reply (Board board.ts452-454 via335-349), so attempt exhaustion is not nonapplication evidence. Preserve unknown custody and exact replay until a receipt or definitive rejection; record the bounded cause and recovery action instead of enabling a contradictory release. Independent plan critique rejected the unsafe threshold-to-rejected alternative. Proof: unchanged reply-order suite reproduced2 failures on missing last_error;4 focused files now76passed, including25-refusal recovery through both result and confirm entry paths and delayed rejection after confirmed receipt.
---
 hermes_cli/kanban_retain_transport.py         | 11 +++++--
 .../test_kanban_retain_reply_order.py         | 33 +++++++++++++++++++
 2 files changed, 42 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_retain_transport.py b/hermes_cli/kanban_retain_transport.py
index 06aa526c0d..e622b8f127 100644
--- a/hermes_cli/kanban_retain_transport.py
+++ b/hermes_cli/kanban_retain_transport.py
@@ -100,8 +100,15 @@ def record_result(conn: sqlite3.Connection, row: dict, result: dict) -> str:
                      (str(result.get("reason") or "retain rejected")[:500], op_id))
         state, count = "rejected", "rejected"
     else:
-        conn.execute("UPDATE kanban_sync_outbox SET attempts=attempts+1,retry_after=? WHERE op_id=?",
-                     (int(time.time()) + 30, op_id))
+        # Even an explicit storage_error can be a failed lookup of an already
+        # applied receipt. Attempt exhaustion is not authority to release the run.
+        # Keep the immutable replay path and its concrete prerequisite visible.
+        reason = str(result.get('reason') or result.get('status') or 'missing reply')[:80]
+        detail = str(result.get('detail') or '')[:200]
+        error = (f'retain delivery unknown; replay exact command {op_id} after Board recovery; '
+                 f'require canonical receipt or definitive rejection; {reason}: {detail}')[:500]
+        conn.execute("UPDATE kanban_sync_outbox SET attempts=attempts+1,retry_after=?,last_error=? WHERE op_id=?",
+                     (int(time.time()) + 30, error, op_id))
         state, count = "unknown", "deferred"
     conn.execute("UPDATE kanban_failure_commands SET delivery_state=? WHERE op_id=? AND operation_kind='retain'",
                  (state, op_id))
diff --git a/tests/hermes_cli/test_kanban_retain_reply_order.py b/tests/hermes_cli/test_kanban_retain_reply_order.py
index df097adc23..0ef2f82187 100644
--- a/tests/hermes_cli/test_kanban_retain_reply_order.py
+++ b/tests/hermes_cli/test_kanban_retain_reply_order.py
@@ -56,6 +56,39 @@ def test_transient_rejection_never_grants_failure_fallback(live, boundary, reaso
     assert transport.outbound(live, dict(live.execute("SELECT * FROM kanban_sync_outbox WHERE op='retain'").fetchone()))
 
 
+@pytest.mark.parametrize('boundary', ['result', 'confirm'])
+def test_repeated_storage_refusals_keep_recoverable_custody_and_diagnostics(live, boundary):
+    # A lost applied reply followed by receipt-lookup storage failures is still
+    # unknown, not permission to cancel the immutable command or release its run.
+    owned, _receipt, _rows, hub = receipts.fixture(live)
+    result = {'client_op_id': owned['request_uid'], 'status': 'rejected',
+              'reason': 'storage_error', 'detail': 'receipt lookup unavailable'}
+    applied_ops = hub.ops
+    hub.ops = lambda *a: {'results': [result]}
+    for _ in range(25):
+        if boundary == 'result':
+            with kbc.write_txn(live):
+                transport.record_result(live, {'op_id': owned['op_id']}, result)
+        else:
+            with pytest.raises(ValueError):
+                transport.confirm(live, hub, 'default', owned['run_uid'])
+    row = live.execute('SELECT * FROM kanban_sync_outbox WHERE op_id=?', (owned['op_id'],)).fetchone()
+    assert row['attempts'] == 25
+    assert 'storage_error: receipt lookup unavailable' in row['last_error']
+    assert 'replay exact command' in row['last_error']
+    assert owned['op_id'] in row['last_error']
+    assert len(row['last_error']) <= 500
+    assert transport.command(live, owned['run_uid'])['delivery_state'] == 'unknown'
+    rid = live.execute('SELECT id FROM task_runs WHERE uid=?', (owned['run_uid'],)).fetchone()[0]
+    assert release.observer_held(live, rid) and not release.queued(live, rid)
+    assert transport.command(live, owned['run_uid'])['request_json'] == owned['request_json']
+    hub.ops = applied_ops
+    assert transport.confirm(live, hub, 'default', owned['run_uid'])['terminal_for_run']
+    with kbc.write_txn(live):
+        transport.record_result(live, {'op_id': owned['op_id']}, result)
+    assert transport.command(live, owned['run_uid'])['delivery_state'] == 'confirmed'
+
+
 def test_legacy_read_only_command_readers_do_not_migrate(live, monkeypatch):
     # The pre-retain table has no operation/delivery/fallback columns.
     tid, rid = support._running(live)
