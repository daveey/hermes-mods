From 73e3a1089a16433ff35902b8a4cb31929e248d74 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 04:32:15 +0000
Subject: [PATCH 1137/1157] fix(plugins): discovery fingerprint ignores ctime
 so a metadata-only sync pass keeps the hook/toolset records served [daveey]

hermes-sync's rsync -a --checksum (macOS openrsync) re-applies mode/times to every
unchanged user plugin file each ~10 min pass. That moves only st_ctime_ns, which the
fingerprint hashed, so plugin_hooks.json and plugin_toolset_keys.json went stale on
every pass and the bb gate's next cold assign paid a full discovery (20-45 s, killed
at its 45 s helper timeout) again after PR245. Content changes still move inode, size
or mtime (rsync renames a temp file in; editors and git set mtime).

Tests: metadata-only touch keeps both records served (RED on base, GREEN here); an
rsync-style rename with restored mtime still invalidates and the new observer fires.
---
 hermes_cli/plugins_snapshot.py                |  9 +++-
 ...est_kanban_capabilities_plugin_snapshot.py | 17 ++++++++
 .../test_plugin_hook_presence_record.py       | 42 +++++++++++++++++++
 3 files changed, 67 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/plugins_snapshot.py b/hermes_cli/plugins_snapshot.py
index b8ed59c0dc4..db713e0d3e7 100644
--- a/hermes_cli/plugins_snapshot.py
+++ b/hermes_cli/plugins_snapshot.py
@@ -82,11 +82,18 @@ def _cache_path(home: Path) -> Path:
 
 
 def _stat_entry(path: Path, label: str) -> list:
+    # [daveey] No st_ctime_ns: it moves on every metadata write (chmod, utime, xattr), not only on
+    # content changes. hermes-sync's `rsync -a --checksum` (macOS openrsync) re-applies mode/times to
+    # every unchanged plugin file each ~10 min pass, which made the record stale on every pass, so the
+    # bb gate's next cold assign paid a full discovery (20-45 s) again. A content change still moves
+    # one of the kept fields: an in-place write sets a new mtime, and a sync that restores the source
+    # mtime writes a temp file and renames it (new inode). Only an in-place, same-size rewrite that
+    # then forges the old mtime back goes unseen; nothing on the sync or edit paths does that.
     try:
         st = path.stat()
     except OSError as exc:
         return [label, "missing", exc.errno]
-    return [label, st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns]
+    return [label, st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns]
 
 
 def _walk_root(root: Path, label: str, out: list) -> None:
diff --git a/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py b/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py
index 1dff6bff30b..c6dcccff09c 100644
--- a/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py
+++ b/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py
@@ -202,6 +202,23 @@ def test_new_plugin_dir_and_config_edit_invalidate_the_record(home):
     assert _run(home)["discoveries"] == 1
 
 
+def test_metadata_only_sync_pass_keeps_the_record_served(home):
+    """A sync pass that rewrites nothing (macOS openrsync -a --checksum) re-applies mode and times,
+    moving only ctime: the record must stay served. [daveey]"""
+    _tool_plugin(home, "extra", "extra_ping", "extra")
+    _config(home, "platform_toolsets:\n  cli: [terminal, file, extra]\n" + ENABLED % "extra")
+    first = _run(home)
+    assert first["discoveries"] == 1
+    files = [p for p in [home / "config.yaml", *(home / "plugins").rglob("*")] if p.is_file()]
+    for p in files:
+        st = p.stat()
+        os.chmod(p, st.st_mode)
+        os.utime(p, ns=(st.st_atime_ns, st.st_mtime_ns))
+    second = _run(home)
+    assert _verdict(second) == _verdict(first)
+    assert second["discoveries"] == 0
+
+
 @pytest.mark.parametrize("blob", ["", "{not json", "[]", json.dumps({"toolset_keys": [], "portable_mcp": []}),
                                   json.dumps({"version": 1, "fingerprint": "0" * 64, "builtin_collision": None,
                                               "toolset_keys": [], "portable_mcp": []})])
diff --git a/tests/hermes_cli/test_plugin_hook_presence_record.py b/tests/hermes_cli/test_plugin_hook_presence_record.py
index c22063726d4..b16fc46d979 100644
--- a/tests/hermes_cli/test_plugin_hook_presence_record.py
+++ b/tests/hermes_cli/test_plugin_hook_presence_record.py
@@ -212,3 +212,45 @@ def test_assignment_is_committed_before_notify_so_a_killed_helper_leaves_it_whol
         assert [json.loads(p)["assignee"] for _, p in events] == ["bob"]
     finally:
         con.close()
+
+
+def _metadata_only_touch(paths) -> None:
+    """What a sync pass that rewrites nothing does (macOS openrsync -a --checksum every 10 min on the
+    mini): re-apply each file's mode and times, which moves only its ctime."""
+    for p in paths:
+        st = p.stat()
+        os.chmod(p, st.st_mode)
+        os.utime(p, ns=(st.st_atime_ns, st.st_mtime_ns))
+
+
+def test_metadata_only_sync_pass_keeps_the_record_served(home):
+    _config(home, ["bystander"])
+    tid = _run(home, "setup")["task_id"]
+    _run(home, "discover")
+    before = {p: p.stat() for p in [home / "config.yaml", *(home / "plugins").rglob("*")] if p.is_file()}
+    _metadata_only_touch(before)
+    assert any(p.stat().st_ctime_ns != st.st_ctime_ns for p, st in before.items())
+    assert all((p.stat().st_ino, p.stat().st_size, p.stat().st_mtime_ns) == (st.st_ino, st.st_size, st.st_mtime_ns)
+               for p, st in before.items())
+    out = _run(home, "assign", task_id=tid, profile="bob")
+    assert out["assigned"] is True
+    assert out["sweeps"] == 0 and out["discover_and_load"] == 0, out
+
+
+def test_sync_replacing_a_plugin_file_with_its_old_mtime_still_invalidates(home):
+    """rsync -a writes changed content to a temp file, renames it over the old one and restores the
+    source mtime: same mtime, maybe same size, new inode. That must still read as a change."""
+    _config(home, ["bystander"])
+    tid = _run(home, "setup")["task_id"]
+    _run(home, "discover")
+    assert "on_kanban_task_updated" not in _hooks_record(home)["hooks"]
+    init = home / "plugins" / "bystander" / "__init__.py"
+    old = init.stat()
+    tmp = init.with_name(".__init__.py.tmp")
+    tmp.write_text(textwrap.dedent(OBSERVER))
+    os.utime(tmp, ns=(old.st_atime_ns, old.st_mtime_ns))
+    os.replace(tmp, init)
+    assert init.stat().st_mtime_ns == old.st_mtime_ns
+    out = _run(home, "assign", task_id=tid, profile="bob")
+    assert out["assigned"] is True and out["sweeps"] == 1
+    assert _observed(home) == [{"task_id": tid, "changed_fields": ["assignee"]}]
