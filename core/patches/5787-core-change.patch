From 04e4b21367cc72af9c49825d254adb92128f9b26 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 19:02:06 +0000
Subject: [PATCH] test(session): retain status precedence and isolate lifecycle
 fixtures [daveey]

---
 tests/gateway/test_turn_start_outcome.py      | 22 +++++++++++++++++++
 .../test_session_status_refresh.py            |  6 ++---
 .../tui_gateway/test_turn_outcome_refresh.py  |  3 +++
 3 files changed, 28 insertions(+), 3 deletions(-)

diff --git a/tests/gateway/test_turn_start_outcome.py b/tests/gateway/test_turn_start_outcome.py
index 1cd04e6555..257b186d3b 100644
--- a/tests/gateway/test_turn_start_outcome.py
+++ b/tests/gateway/test_turn_start_outcome.py
@@ -17,6 +17,28 @@ class Observed(BaseException):
     """Stop the real admission path before invoking a provider."""
 
 
+@pytest.mark.parametrize("path", ["tui", "gateway"])
+def test_turn_start_publication_failure_is_logged_not_raised(tmp_path, monkeypatch, caplog, path):
+    from contextlib import nullcontext
+    from tui_gateway import server
+    from tui_gateway.turn_outcome import refresh_turn_start_outcome
+    from gateway.turn_outcome import refresh_gateway_turn_start_outcome
+
+    def fail(*args, **kwargs):
+        assert args == ("start", "turn_start")
+        assert not kwargs.get("concluding_turn")
+        raise OSError("unavailable fixture store")
+
+    monkeypatch.setattr(so, "refresh_outcome", fail)
+    if path == "tui":
+        monkeypatch.setattr(server, "_session_profile_runtime_scope", lambda session: nullcontext())
+        monkeypatch.setattr(server, "_session_db", lambda session: nullcontext(object()))
+        refresh_turn_start_outcome({"session_key": "start"})
+    else:
+        refresh_gateway_turn_start_outcome(SimpleNamespace(_session_db=object()), SimpleNamespace(session_id="start"))
+    assert "unavailable fixture store" in caplog.text
+
+
 @pytest.mark.asyncio
 @pytest.mark.parametrize("previous", [None, "waiting"])
 async def test_gateway_admission_publishes_running(tmp_path, monkeypatch, previous):
diff --git a/tests/hermes_state/test_session_status_refresh.py b/tests/hermes_state/test_session_status_refresh.py
index 44ff7efcb2..321dd61307 100644
--- a/tests/hermes_state/test_session_status_refresh.py
+++ b/tests/hermes_state/test_session_status_refresh.py
@@ -229,13 +229,13 @@ def test_repeated_refresh_and_reads_never_change_revision_or_paint(db):
 def test_declaration_keeps_the_envelope_and_has_no_status_authority(db, board):
     add_card(board, "t_open", "running")
     turn(db)
-    assert refresh(db)["kind"] == "waiting"
+    assert refresh(db)["kind"] == "running"
     declared = so.declare_outcome("chat", {"kind": "done", "summary": "all finished"}, db=db)
     assert declared["kind"] == "done"
     stored = so.get_outcome("chat", db=db)
-    assert stored["status"]["kind"] == "waiting" and stored["status"]["revision"] == 1
+    assert stored["status"]["kind"] == "running" and stored["status"]["revision"] == 1
     status = refresh(db, "manual")
-    assert (status["kind"], status["revision"]) == ("waiting", 1)
+    assert (status["kind"], status["revision"]) == ("running", 1)
     set_card(board, "t_open", "done")
     status = refresh(db, "card_change")
     assert_done(status)
diff --git a/tests/tui_gateway/test_turn_outcome_refresh.py b/tests/tui_gateway/test_turn_outcome_refresh.py
index 6964218470..be6035e683 100644
--- a/tests/tui_gateway/test_turn_outcome_refresh.py
+++ b/tests/tui_gateway/test_turn_outcome_refresh.py
@@ -81,6 +81,9 @@ def turn_env(monkeypatch, tmp_path, db):
     }.items():
         monkeypatch.setattr(server, name, stub)
     monkeypatch.setattr(server.threading, "Thread", _ImmediateThread)
+    # These turn lifecycle fixtures have no linked cards; ImmediateThread cannot
+    # execute the board reader's asynchronous refresher (which requires args).
+    monkeypatch.setattr(so, "_live_work", lambda *args: ([], [], False))
     yield monkeypatch
     for sid in [s for s in server._sessions if s.startswith(("ui-outcome-", "ui-retry"))]:
         server._sessions.pop(sid, None)
