     _, worker = gws
@@ -113,9 +113,12 @@ def test_local_source_wins_and_no_replica_is_opened(gws, monkeypatch):
         replica.close()
     worker.conn.execute('UPDATE tasks SET model_override=? WHERE id=?', ('gpt-6-astra', source))
     worker.conn.commit()
-    def unexpected(conn):
