From 1e7af04de35cd6c4ff2b2cc9fe61a0e55ce290e8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:27:07 +0000
Subject: [PATCH] [daveey] kanban: on_give_up formats the (board, refusal)
 pairs itself, keeping kanban_sync_client at its 2000-line cap over main

---
 hermes_cli/kanban_sync_client.py       | 8 +++-----
 hermes_cli/kanban_sync_schema_alert.py | 7 ++++---
 2 files changed, 7 insertions(+), 8 deletions(-)

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index 1d5094f171..e3f65586d9 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -1478,7 +1478,7 @@ def _run_forever(keep_running: Callable[[], bool], interval: Optional[float], ru
     note_start()
     ahead = _schema_ahead_boards(board_paths())
     if ahead:
-        on_give_up(runstate, ident.gateway, "not starting: ", "; ".join(f"board {s}: {r}" for s, r in ahead))
+        on_give_up(runstate, ident.gateway, "not starting: ", ahead)
         return  # give the host sync role up: a current core's gateway can take it [daveey]
     hub = Hub(ident)
     sync.set_lease_client(HubLeaseClient(hub))
@@ -1520,8 +1520,7 @@ def _run_forever(keep_running: Callable[[], bool], interval: Optional[float], ru
             ahead = [r for r in results if (r.error or "").startswith("SchemaAhead")]
             if ahead:
                 _log.error("kanban sync: a newer core migrated this host's board; giving up the sync role")
-                on_give_up(runstate, ident.gateway, "gave up the sync role: ",
-                           "; ".join(f"board {r.board}: {r.error}" for r in ahead))
+                on_give_up(runstate, ident.gateway, "gave up the sync role: ", [(r.board, r.error) for r in ahead])
                 return
             runstate.clear()  # a completed round: the loop runs
             for r in results:
@@ -1546,8 +1545,7 @@ def _run_forever(keep_running: Callable[[], bool], interval: Optional[float], ru
 
 
 def _schema_ahead_boards(boards: list[tuple[str, Path]]) -> list[tuple[str, str]]:
-    """``(slug, refusal)`` per board a newer core migrated (logged at ERROR). An unreadable board is left to the
-    round's own errors."""
+    """``(slug, refusal)`` per board a newer core migrated (logged at ERROR); an unreadable one is the round's error."""
     ahead = []
     for slug, path in boards:
         try:
diff --git a/hermes_cli/kanban_sync_schema_alert.py b/hermes_cli/kanban_sync_schema_alert.py
index b227a21756..4ca7b6f7f1 100644
--- a/hermes_cli/kanban_sync_schema_alert.py
+++ b/hermes_cli/kanban_sync_schema_alert.py
@@ -216,14 +216,15 @@ def _report(host, why, since, runner, hub_cli, info, now) -> Optional[str]:
     return rid
 
 
-def on_give_up(state: Any, gateway: str, prefix: str, why: str) -> None:
-    """``run_forever``'s give-up: record the stop (``prefix + why``) in ``state``, then report it; the incident is
-    that record's ``since``.
+def on_give_up(state: Any, gateway: str, prefix: str, ahead: list[tuple[str, Any]]) -> None:
+    """``run_forever``'s give-up over ``ahead`` (``(board, refusal)`` pairs): record the stop (``prefix + why``) in
+    ``state``, then report it; the incident is that record's ``since``.
 
     A give-up while this host's own core update is under way (the installed checkout moved past the commit this
     process started on, and this process runs that checkout) is the update's transition, not an incident: the
     update restarts this gateway on the new core."""
     from hermes_cli import kanban_sync_runstate as runstate
+    why = "; ".join(f"board {board}: {refusal}" for board, refusal in ahead)
     state.record_down(prefix + why)
     if _updating():
         log.warning("kanban sync: gave up the sync role while this host's core update is under way (%s -> %s); "
-- 
2.51.0

