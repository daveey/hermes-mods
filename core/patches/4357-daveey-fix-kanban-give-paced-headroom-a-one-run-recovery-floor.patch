diff --git a/tests/hermes_cli/test_kanban_pacing_recovery.py b/tests/hermes_cli/test_kanban_pacing_recovery.py
new file mode 100644
index 0000000000000000000000000000000000000000..f0fc5edeef1a179ab830218ea70c1ca67f3c3e6d
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_pacing_recovery.py
@@ -0,0 +1,67 @@
+"""Paced headroom must not trap idle dispatchers at zero concurrency. [daveey]"""
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as dispatch
+from hermes_cli import kanban_llm_pacing as lp
+from hermes_cli import kanban_llm_pacing_dispatch as pd
+from hermes_cli import kanban_model_tier as tier
+from hermes_cli import kanban_provider_walls as walls
+from tests.hermes_cli import test_kanban_quota_episode as helpers
+from tests.hermes_cli.test_kanban_quota_episode_walls import LIVE_CFG, _clock
+
+board = helpers.board
+
+
+@pytest.mark.parametrize('average', [0, 0.5, 1, 6])
+@pytest.mark.parametrize('deferrable', [False, True])
+def test_paced_headroom_has_a_one_run_floor(average, deferrable):
+    pace = lp.PoolPace('openai-codex', lp.PACED, 0.15)
+    assert lp.admit_limit(pace, average, deferrable=deferrable, cfg=lp.PacingConfig()) == 1
+
+
+@pytest.mark.parametrize('deferrable', [False, True])
+def test_no_headroom_still_holds(deferrable):
+    pace = lp.PoolPace('openai-codex', lp.HELD, 0.0)
+    assert lp.admit_limit(pace, 0, deferrable=deferrable, cfg=lp.PacingConfig()) == 0
+
+
+@pytest.mark.parametrize('destination', [lp.PACED, lp.HELD])
+def test_far_wall_reroutes_before_pacing_and_destination_limits_claims(
+        board, monkeypatch, all_assignees_spawnable, destination):
+    clock = _clock(monkeypatch)
+    config, _ = helpers.routing(monkeypatch)
+    route = config['model_routing']['routes']['standard'][0]
+    config['model_routing']['routes'] = {'deep': [dict(route, model='claude-opus-5-5'),
+        dict(route, provider='openai-codex', model='gpt-6-astra')]}
+    monkeypatch.setattr(tier, 'load_tier_config', lambda: LIVE_CFG)
+    monkeypatch.setattr(walls, 'active_walls', lambda **kw: {'openai-codex': float(clock[0] + 6 * 86400)})
+    monkeypatch.setattr(walls, 'live_quota_wall', lambda *a, **kw: None)
+    monkeypatch.setattr(pd, 'load_config', lp.PacingConfig)
+    monkeypatch.setattr(pd, 'avg_running', lambda *a: 0)
+    consulted = []
+
+    def pace_for(conn, provider, cfg, now):
+        consulted.append(provider)
+        return lp.PoolPace(provider, destination if provider == 'anthropic' else lp.HELD, 0.15)
+
+    monkeypatch.setattr(pd, 'pace_for', pace_for)
+    with kbc.connect() as conn:
+        ids = [kb.create_task(conn, title=f'fresh default {i}', assignee='a') for i in range(2)]
+        seen = []
+        result = dispatch.dispatch_once(conn, spawn_fn=lambda task, ws: seen.append(
+            (task.id, task.model_override, task.provider_override)))
+        assert consulted and set(consulted) == {'anthropic'}
+        if destination == lp.HELD:
+            assert seen == []
+            assert len(result.llm_paced) == 2
+        else:
+            assert len(seen) == 1
+            assert seen[0][0] in ids
+            assert seen[0][1:] == ('claude-opus-5-5', 'anthropic')
+            assert len(result.llm_paced) == 1
+            assert result.llm_paced[0][3]['providers'] == [
+                {'provider': 'anthropic', 'state': lp.PACED, 'limit': 1, 'running': 1}]
+            receipts = [e.payload for e in kb.list_events(conn, seen[0][0]) if e.kind == 'run_route']
+            assert receipts[-1]['tier_reason'] == 'default+wall:openai-codex'
diff --git a/website/docs/user-guide/features/kanban.md b/website/docs/user-guide/features/kanban.md
index 15736198540d48d1ec21890e1719296fdd7200d2..c8259877906b428b2b655b1157c811b8f5041abf 100644
--- a/website/docs/user-guide/features/kanban.md
+++ b/website/docs/user-guide/features/kanban.md
@@ -1558,7 +1558,7 @@ To see why a ready card is not spawning, run `hermes kanban dispatch --dry-run`
 Before claiming a ready or review card, the dispatcher checks the OAuth pool of the provider the card's next run would use (for a `class:*` selector, every provider the class may route to; the card waits only when all of them hold it). It reads each account's account-wide usage windows (`five_hour` and `seven_day` from `/api/oauth/usage`; Codex `Session`/`Weekly`) at most every `read_interval_seconds`, measures each window's burn rate from its recent samples, and compares the pool's burn with the rate that would bring every account with headroom to `target_percent` exactly at its window's reset. An account whose window has not started yet (the endpoint reports `null` for an idle `five_hour`) counts as a fresh full window; an account read successfully with both windows `null` (idle or brand-new) counts as two. A failed usage read adds no headroom.
 
 - **open**: the pool is on or behind pace, so claims proceed (just behind pace, this host may grow only to its recent concurrency × the pace factor, at least one run).
-- **paced**: the pool is ahead of pace, so this host keeps its recent average concurrency on that provider × the pace factor. Review-lane, negative-priority and continuation-woken cards get only `deferrable_share` of that limit.
+- **paced**: the pool is ahead of pace, so this host keeps its recent average concurrency on that provider × the pace factor. Review-lane, negative-priority and continuation-woken cards get only `deferrable_share` of that limit. The final limit has a one-run floor, including deferrable work: paced pools still have headroom, and an idle host must be able to restart rather than remain at zero forever. That floor is shared with running work on the provider, not an extra slot per card; it can exceed the proportional rate at low concurrency. Known quota walls are resolved before this check, and a rerouted card is governed by its destination provider's limit.
 - **held**: every readable account is past its reserve (`reserve_five_hour_percent` / `reserve_seven_day_percent`), so no Kanban claim starts until the earliest reset frees one; the remaining headroom is left to chats, cron and notices.
 
 A held card stays `ready` and unclaimed. The dispatcher records an `llm_paced` event (providers, state, limit, running) and a `dispatch_skipped` row with reason `llm_paced`. Queue position, the chat-wait and parent-unclaimed notices, and `hermes kanban diagnostics` (`held_in_ready`) name the hold instead of "skip reason unrecorded". Raising the card's priority does not lift it. If no account can be read, the governor fails open, and mandatory model pins and ungoverned providers always start. Only Kanban dispatch consults it.
