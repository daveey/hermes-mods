diff --git a/hermes_cli/kanban_spend_budget_cli.py b/hermes_cli/kanban_spend_budget_cli.py
new file mode 100644
index 0000000000..b6ab1767b0
--- /dev/null
+++ b/hermes_cli/kanban_spend_budget_cli.py
@@ -0,0 +1,60 @@
+"""``hermes kanban spend-budget <id>``: show or set one card's own spend budget (kanban_spend_budget). [daveey]
+
+Without a change flag it prints the card's effective limits, its override (who set it, why) and its current
+spend. ``--runs N`` / ``--cache-read-tokens N`` (0 = no limit), ``--exempt`` (both 0) or ``--clear`` (back to
+the board's limits) record a ``spend_budget_set`` event and need ``--reason``. Worker and delegate_task shells
+are fenced from this verb like every other board write, so a looping card cannot exempt itself.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_spend_budget as ksb
+
+
+def _err(msg: str, rc: int = 1) -> int:
+    print(msg, file=sys.stderr)
+    return rc
+
+
+def _actor() -> str:
+    from hermes_cli.profiles import current_profile_name
+    return current_profile_name("user") or "user"
+
+
+def command(args: argparse.Namespace) -> int:
+    tid = args.task_id
+    runs, cache = args.runs, args.cache_read_tokens
+    exempt, clear = bool(args.exempt), bool(args.clear)
+    if ((exempt or clear) and (runs is not None or cache is not None)) or (exempt and clear):
+        return _err("kanban spend-budget: --exempt and --clear stand alone (no --runs / --cache-read-tokens)", 2)
+    changing = exempt or clear or runs is not None or cache is not None
+    if changing and not (args.reason or "").strip():
+        return _err("kanban spend-budget: a change needs --reason (it is recorded on the card)", 2)
+    if exempt:
+        runs = cache = 0
+    with kbc.connect_closing() as conn:
+        if conn.execute("SELECT 1 FROM tasks WHERE id = ?", (tid,)).fetchone() is None:
+            return _err(f"kanban spend-budget: unknown task {tid}")
+        if changing:
+            ksb.set_override(conn, tid, runs=runs, cache_read_tokens=cache, by=_actor(), reason=args.reason)
+        lim = ksb.card_limits(conn, tid, ksb.limits())
+        override = ksb.card_override(conn, tid)
+        spent = ksb.spend(conn, tid)
+    out = {"task_id": tid, "limits": lim._asdict(), "override": override,
+           "spent": {"runs": spent.runs, "since": spent.since, "tokens": spent.tokens}}
+    if getattr(args, "json", False):
+        print(json.dumps(out, sort_keys=True))
+        return 0
+    if not lim.runs and not lim.cache_read_tokens:
+        print(f"{tid}: no spend budget (exempt)")
+    else:
+        shown = ", ".join(f"{k} {'no limit' if v == 0 else v}" for k, v in lim._asdict().items())
+        print(f"{tid}: spend budget {shown}")
+    if override is not None and ksb.override_set(override):
+        print(f"  override set by {override.get('by')}: {override.get('reason')}")
+    print(f"  spent: {spent.runs} runs, {spent.tokens['cache_read_tokens']} cache-read tokens in this window")
+    return 0
diff --git a/tests/hermes_cli/test_kanban_spend_budget.py b/tests/hermes_cli/test_kanban_spend_budget.py
index c69e249e2e..9bebd5c784 100644
--- a/tests/hermes_cli/test_kanban_spend_budget.py
+++ b/tests/hermes_cli/test_kanban_spend_budget.py
@@ -316,3 +316,161 @@ def test_payload_json_roundtrip(kanban_home):
         raw = conn.execute("SELECT payload FROM task_events WHERE task_id = ? AND kind = ?",
                            (tid, ksb.EVENT)).fetchone()[0]
         assert json.loads(raw)["limits"] == {"runs": ksb.DEFAULT_RUNS, "cache_read_tokens": ksb.DEFAULT_CACHE_READ}
+
+
+# --- t_01a1daf392bf6005: a human answer re-authorizes; a card can carry its own limit --------------------
+
+def _blocked_and_answered(conn, tid: str, *, writer_kind: str, relay: bool = False) -> None:
+    """The card blocked needs_input after spending its budget; someone answered and unblocked it."""
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET status = 'blocked' WHERE id = ?", (tid,))
+        kb._append_event(conn, tid, "blocked", {"kind": "needs_input", "reason": "which ring?"})
+    kwargs = {"relayed_human": {"session": "chat-1", "message_id": 7, "at": int(time.time())}} if relay else {}
+    kb.add_comment(conn, tid, "david" if writer_kind == "human" else "default", "The left ring.",
+                   writer_kind=writer_kind, **kwargs)
+    assert kb.unblock_task(conn, tid)
+
+
+@pytest.mark.parametrize("writer_kind, relay", [("human", False), ("agent", True)], ids=["human", "relayed"])
+def test_a_human_answer_opens_a_new_window(kanban_home, writer_kind, relay):
+    """Defect 1: David answered a needs_input card that had spent its budget while blocked; the next tick
+    triaged it with no run, undoing his answer. A human (or verified relayed) answer now opens a new window."""
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="asked David", assignee="default")
+        _runs(conn, tid, ksb.DEFAULT_RUNS)
+        _blocked_and_answered(conn, tid, writer_kind=writer_kind, relay=relay)
+        assert ksb.spend(conn, tid).runs == 0
+        spawns = Spawns()
+        res = kbd.dispatch_once(conn, spawn_fn=spawns)
+        assert res.no_progress_held == [] and spawns.ids == [tid]
+        assert _events(conn, tid, ksb.EVENT) == []
+
+
+def test_an_agent_comment_and_a_bare_unblock_do_not_reopen_the_budget(kanban_home):
+    """Agent notes are what a loop produces, and a bare unblock carries no actor: neither opens a window."""
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="loops", assignee="default")
+        _runs(conn, tid, ksb.DEFAULT_RUNS)
+        _blocked_and_answered(conn, tid, writer_kind="agent")
+        kb.add_comment(conn, tid, "default", "legacy note without a kind")
+        spawns = Spawns()
+        assert kbd.dispatch_once(conn, spawn_fn=spawns).no_progress_held == [(tid, "spend_budget:triage")]
+        assert spawns.ids == [] and kb.get_task(conn, tid).status == "triage"
+
+
