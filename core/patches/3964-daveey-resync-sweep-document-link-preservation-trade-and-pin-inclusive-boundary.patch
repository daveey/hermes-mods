Subject: [PATCH] [daveey] resync sweep: document link preservation trade and
 pin inclusive boundary

---
 hermes_cli/kanban_sync_resync_sweep.py        |  2 +
 ..._kanban_sync_live_resync_sweep_boundary.py | 38 +++++++++++++++++++
 2 files changed, 40 insertions(+)
 create mode 100644 tests/hermes_cli/test_kanban_sync_live_resync_sweep_boundary.py

diff --git a/hermes_cli/kanban_sync_resync_sweep.py b/hermes_cli/kanban_sync_resync_sweep.py
index 9920070e96..23ded9d3d8 100644
--- a/hermes_cli/kanban_sync_resync_sweep.py
+++ b/hermes_cli/kanban_sync_resync_sweep.py
@@ -25,6 +25,8 @@ row is then missing from the snapshot although the Board holds it, and its op is
 rows and every row of the cards they name. A link written after that read and acked by such a push before the
 sweep has neither an op nor a creation time, so the links present at that read bound the ``task_links`` sweep, and
 the child card's ``linked``/``unlinked`` events since ``since`` spare a key that was unlinked and re-created.
+This conservatively keeps all links of that child, including a Board-deleted edge that may linger until another
+rebuild or be re-pushed by repair; as with outbox-held rows, preserving local work wins over tombstoning it.
 [daveey] t_01a1d5f9de4020fa t_01a1d62f0a4187d8 t_01a1d6660108bedb
 """
 
diff --git a/tests/hermes_cli/test_kanban_sync_live_resync_sweep_boundary.py b/tests/hermes_cli/test_kanban_sync_live_resync_sweep_boundary.py
new file mode 100644
index 0000000000..61747333de
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_sync_live_resync_sweep_boundary.py
@@ -0,0 +1,38 @@
+"""Pin the inclusive, child-local link-event boundary requested in PR #2571."""
+from __future__ import annotations
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_sync_resync_sweep as sweep
+from tests.hermes_cli import test_kanban_sync_live_resync_sweep as helpers
+
+kanban_home = helpers.kanban_home
+live = helpers.live
+
+
+@pytest.mark.parametrize("kind", ["linked", "unlinked"])
+@pytest.mark.parametrize("delta", [-1, 0, 1])
+def test_link_event_boundary_spares_only_its_child(live, kind, delta):
+    since = 2_000_000_000
+    parent = kb.create_task(live, title="parent")
+    child = kb.create_task(live, title="child with a link event at the boundary")
+    sibling = kb.create_task(live, title="child with only old link events")
+    kb.link_tasks(live, parent, child)
+    kb.link_tasks(live, parent, sibling)
+    with kbc.write_txn(live):
+        live.execute("UPDATE task_events SET created_at = ?", (since - 60,))
+        live.execute("UPDATE task_events SET kind = ?, created_at = ? WHERE task_id = ? AND kind = 'linked'",
+                     (kind, since + delta, child))
+        live.execute("DELETE FROM kanban_sync_outbox")
+    held = sweep.held_at_start(live)
+    assert held.links == {f"{parent}>{child}", f"{parent}>{sibling}"}
+    assert not held.rows and not held.cards  # no other hold may mask the event boundary
+    seen = {"tasks": {parent, child, sibling}, "task_links": set()}
+    swept = sweep.sweep_absent(live, seen, helpers.BOARD, helpers.ME, since=since, held=held)
+    expected = {(parent, child)} if delta >= 0 else set()
+    assert {tuple(r) for r in live.execute("SELECT parent_id, child_id FROM task_links")} == expected
+    assert swept == {"task_links": 1 if delta >= 0 else 2}
+    tombstones = {r[0] for r in live.execute("SELECT row_uid FROM kanban_sync_tombstones WHERE table_name = 'task_links'")}
+    assert tombstones == {f"{parent}>{sibling}"} | ({f"{parent}>{child}"} if delta < 0 else set())
