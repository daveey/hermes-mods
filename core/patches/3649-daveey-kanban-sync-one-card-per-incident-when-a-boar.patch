+# --- sleep, recovery, scope -----------------------------------------------------------------------------------------
+
+def test_sleep_never_counts(live, kanban_home):
+    """The wall clock jumps 5 h while awake time moves 1 minute, the replica behind the whole time."""
+    host = Host(kanban_home, _pt("2026-11-12 08:00:00"))
