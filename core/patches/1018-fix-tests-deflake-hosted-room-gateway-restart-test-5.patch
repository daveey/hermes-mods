From 0d6f22c0f8f98cc67082941025a6482de8362878 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 16:13:43 -0700
Subject: [PATCH] fix(tests): deflake hosted-room gateway restart test; 5s stop
 / 3s wait missed under CPU throttling (#208)

---
 tests/gateway/test_hosted_room_gateway_lifecycle.py | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/tests/gateway/test_hosted_room_gateway_lifecycle.py b/tests/gateway/test_hosted_room_gateway_lifecycle.py
index 679d7ac145a..3b5428d9f31 100644
--- a/tests/gateway/test_hosted_room_gateway_lifecycle.py
+++ b/tests/gateway/test_hosted_room_gateway_lifecycle.py
@@ -67,7 +67,9 @@ def _service(db_path, *, profiles=("default",)):
     return service, rpc
 
 
-def _wait_for(predicate, timeout=3.0):
+# Generous bounds: both return as soon as the condition holds, so a CPU-throttled
+# runner never misses a fixed wall-clock deadline.
+def _wait_for(predicate, timeout=60.0):
     deadline = time.monotonic() + timeout
     while time.monotonic() < deadline:
         if predicate():
@@ -185,7 +187,7 @@ def test_gateway_restart_resumes_queued_room_for_multiplexed_profile(tmp_path):
             )
         )
     finally:
-        assert resumed.stop(timeout=5.0)
+        assert resumed.stop(timeout=60.0)
 
     assert rpc.submits == ["ops"]
     assert hosted_room_driver.list_tasks(db, room_id="room-1", status="settled")
@@ -226,8 +228,8 @@ def test_dashboard_and_gateway_workers_share_one_fenced_execution_owner(tmp_path
         )
         time.sleep(0.05)
     finally:
-        assert gateway.stop(timeout=5.0)
-        assert dashboard.stop(timeout=5.0)
+        assert gateway.stop(timeout=60.0)
+        assert dashboard.stop(timeout=60.0)
 
     assert len(gateway_rpc.submits) + len(dashboard_rpc.submits) == 1
     events = hosted_rooms.read_events(db, room_id="room-1", since_seq=0)["events"]
-- 
2.55.0

