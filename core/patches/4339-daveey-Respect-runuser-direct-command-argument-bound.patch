From 8eeb26f32ffc4daec3ad12b18580c0df8d7d9fc5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 04:02:37 +0000
Subject: [PATCH] [daveey] Respect runuser direct-command argument boundaries

Review #2911 found that command-looking printf arguments were scanned as shell payloads. Check direct-user mode first and stop wrapper command-option collection at --. Four direct-user controls fail before the fix; all six added controls pass after it. Session suite: 87 passed. Full lifecycle run had only the known 5s performance threshold flake; isolated output-sink suite: 192 passed.
---
 cron/lifecycle_guard_nested_shells.py              | 14 +++++++++-----
 tests/cron/test_lifecycle_guard_session_aliases.py |  6 ++++++
 2 files changed, 15 insertions(+), 5 deletions(-)

diff --git a/cron/lifecycle_guard_nested_shells.py b/cron/lifecycle_guard_nested_shells.py
index c0f4c83244..e02fa1a3ac 100644
--- a/cron/lifecycle_guard_nested_shells.py
+++ b/cron/lifecycle_guard_nested_shells.py
@@ -166,17 +166,21 @@ def _nested_shell_input(view: list[str]) -> Optional[tuple[str, Optional[str]]]:
     name = _executable_name(view[index])
     if name in ("su", "runuser"):
         options = view[index + 1:]
-        for position, word in enumerate(options):
-            if word.startswith("--command="):
-                return "payload", word.partition("=")[2]
-            if word in ("-c", "--command") and position + 1 < len(options):
-                return "payload", options[position + 1]
         direct_user = any(
             word == "--user" or word.startswith("--user=")
             or re.fullmatch(r"-[mpPl]*u.*", word)
             for word in _option_words(options, frozenset("ucsg"))[0]
         )
         if name == "su" or not direct_user:
+            # Direct-user runuser executes argv, not a shell command string.
+            # Even in shell mode, -- ends the wrapper's option namespace.
+            for position, word in enumerate(options):
+                if word == "--":
+                    break
+                if word.startswith("--command="):
+                    return "payload", word.partition("=")[2]
+                if word in ("-c", "--command") and position + 1 < len(options):
+                    return "payload", options[position + 1]
             return "stdin", None
     if name == "doas":
         options, _operand = _option_words(view[index + 1:], frozenset("uC"))
diff --git a/tests/cron/test_lifecycle_guard_session_aliases.py b/tests/cron/test_lifecycle_guard_session_aliases.py
index 0c302bc4a9..5a20e2edbe 100644
--- a/tests/cron/test_lifecycle_guard_session_aliases.py
+++ b/tests/cron/test_lifecycle_guard_session_aliases.py
@@ -292,6 +292,12 @@ def test_nested_login_shell_body_treats_names_as_unknown(tmp_path, live_kanban_d
     "runuser -ubob -- python3 - <<'EOF'\nprint('t ( bash {db} )')\nEOF",
     "runuser --user bob -- python3 - <<'EOF'\nprint('t ( bash {db} )')\nEOF",
     "runuser --user=bob -- python3 - <<'EOF'\nprint('t ( bash {db} )')\nEOF",
+    "runuser -u bob -- printf '%s\\n' --command='t ( bash {db} )'",
+    "runuser -u bob -- printf '%s\\n' -c 't ( bash {db} )'",
+    "runuser -u bob printf '%s\\n' --command='t ( bash {db} )'",
+    "runuser --user=bob printf '%s\\n' -c 't ( bash {db} )'",
+    "su -- bob --command='t ( bash {db} )'",
+    "runuser -- bob -c 't ( bash {db} )'",
 ])
 def test_plain_child_shell_keeps_session_names(tmp_path, live_kanban_db, shape):
     """Controls: no login/interactive shell, so the session's names still decide (#2358)."""
