From 4d51eeb65a82b64d4054d6758734eb8a240134ab Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 23:26:24 +0000
Subject: [PATCH] [daveey] placement: recognize home redirects and redirected
 code-tree transitions

Follow-up t_01a1d6fd89ac1a22 to PR #2703 review 5898829102 nits 1/2.
Recognize >|, whitespace after >& and command-substitution redirect targets
(including one nesting level). Skip redirects before the state-dir code-tree
exemption. Preserve cd operands after redirects and literal ~2 directory words.

Cause: redirect token grammar omitted valid forms; the exemption started at
the end of the directory word rather than skipping its redirections.

Proof:
- Base 84c7510975 with new tests: 12 failed, 80 passed.
- Fixed home-forms suite: 92 passed, including existing linear-time checks.
- Five isolated grammar mutations killed (noclobber, ampersand whitespace,
  substitution, nesting, exemption redirect skipping).
- Read-only hub board/profile/sync-shadow replay: 41,379 rows across 162
  task-schema DBs, zero classification differences and zero 200ms timeouts.
---
 hermes_cli/kanban_placement.py                | 12 +++++---
 .../test_kanban_state_path_home_forms.py      | 28 +++++++++++++++++++
 2 files changed, 36 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index d6d31f4006..0468c9206a 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -595,9 +595,10 @@ def _heavy_marker(title: str, body: str, cfg: _Cfg) -> Optional[str]:
 HOME_PREFIX = r"(?:~|/home/[^/\s]+|\$HOME\b|\$\{HOME\}|\"\$HOME\"|\"\$\{HOME\}\")"
 # ``cd ~ 2>/dev/null`` ends the cd too (an fd-numbered redirect); ``cd ~2>x`` is a dir word, not a redirect.
 # Redirects (``>``, ``>>``, ``&>``, ``N>``, ``N>&M`` plus their target word) are skipped, and the command must
-# then end: ``cd 2>/dev/null repo`` enters ``repo``, not home (PR #2603 review nit 1).
-_REDIR = (r"(?:[ \t]*&?>|[ \t]+\d+>)>?[ \t]*&?"
-          r"(?:\"[^\"\n]*\"|'[^'\n]*'|[^\s;&|()<>\"'])+")
+# then end: ``cd 2>/dev/null repo`` enters ``repo``, not home (PR #2603 review nit 1). The noclobber ``>|``, a
+# space after ``>&`` and a ``$(...)`` target (one nesting level) are redirects too (PR #2703 review nit 1).
+_REDIR = (r"(?:[ \t]*&?>|[ \t]+\d+>)[>|]?[ \t]*(?:&[ \t]*)?"
+          r"(?:\"[^\"\n]*\"|'[^'\n]*'|\$\((?:[^()\n]|\([^()\n]*\))*\)|[^\s;&|()<>\"'])+")
 _CMD_END = r"(?=(?:" + _REDIR + r")*(?:[ \t]*(?:$|[\n;|)]|&(?!>))|[ \t]+#))"
 _CD_HOME = (r"(?<![\w./-])(?-i:cd(?:[ \t]+" + HOME_PREFIX + r"/?)?|pushd[ \t]+" + HOME_PREFIX + r"/?)" + _CMD_END)
 _CHDIR = (r"(?:" + _CD_HOME + r"|(?:(?<=\n)|&&|\|\||;|`|\{)[ \t]*"
@@ -606,7 +607,10 @@ _CHDIR = (r"(?:" + _CD_HOME + r"|(?:(?<=\n)|&&|\|\||;|`|\{)[ \t]*"
 _CD_INTO = r"(?<![\w./-])(?-i:cd|pushd)[ \t]+[\"']?"
 _CODE_TREE = r"(?:hermes-agent|repos|bin)"
 _STATE_SUB = r"\.hermes/(?!" + _CODE_TREE + r"(?:/|\b))[\w.-]"
-_STATE_DIR = (r"\.hermes/?[\"']?" + _CMD_END + r"(?![ \t]*(?:#[^\n]*)?(?:&&|;|\n)\s*(?-i:cd|pushd)[ \t]+[\"']?(?:\./)?"
+# The code-tree exemption skips the state-dir cd's own redirects first (``cd ~/.hermes 2>/dev/null && cd
+# hermes-agent``, PR #2703 review nit 2).
+_STATE_DIR = (r"\.hermes/?[\"']?" + _CMD_END + r"(?!(?:" + _REDIR + r")*[ \t]*(?:#[^\n]*)?(?:&&|;|\n)\s*"
+              r"(?-i:cd|pushd)[ \t]+[\"']?(?:\./)?"
               + _CODE_TREE + r"(?![\w.-]))")
 HERMES_STATE_PATH = (r"(?:" + HOME_PREFIX + r"/" + _STATE_SUB + r"|" + _CD_INTO + HOME_PREFIX + r"/" + _STATE_DIR +
                      r"|" + _CD_HOME + r"(?:(?!" + _CHDIR + r")[\s\S])*?"
diff --git a/tests/hermes_cli/test_kanban_state_path_home_forms.py b/tests/hermes_cli/test_kanban_state_path_home_forms.py
index b8fc4d2d0f..614aaa17c1 100644
--- a/tests/hermes_cli/test_kanban_state_path_home_forms.py
+++ b/tests/hermes_cli/test_kanban_state_path_home_forms.py
@@ -103,6 +103,17 @@ def test_tilde_root_path_still_clears(attested):
     # PR #2603 review nit 2: the fd-redirect end reaches a cd into the state dir itself too.
     "cd ~/.hermes 2>/dev/null && cat .env",
     "cd ~ && cd .hermes 2>x && cat .env",
+    # PR #2703 review 5898829102 nit 1: a noclobber ``>|``, a space after ``>&`` and a ``$(...)`` target are redirects
+    # too; before the fix these cd-home forms stopped matching (fail-open).
+    "cd ~ >|log && cat .hermes/.env",
+    "cd ~ 2>|log && cat .hermes/.env",
+    "cd ~ >& /dev/null && cat .hermes/.env",
+    "cd ~ 2>& 1 && cat .hermes/.env",
+    "cd ~ >$(mktemp) && cat .hermes/.env",
+    "cd ~ >$(mktemp -p $(pwd)) && cat .hermes/.env",
+    "cd >$(mktemp) && cat .hermes/.env",
+    "pushd ~ >| /dev/null; cat .hermes/.env",
+    "cd ~/.hermes >$(mktemp) && cat .env",
 ])
 def test_pushd_and_commented_cd_home_are_state_paths(body):
     assert _hit(body)
@@ -117,6 +128,10 @@ def test_pushd_and_commented_cd_home_are_state_paths(body):
     "cd 2>&1 >/dev/null repo; cat .hermes/.env",
     "cd >>log repo\ncat .hermes/.env",
     'cd 2>"x y" repo && cat .hermes/.env',
+    # The nit 1 redirect forms keep this rule: an operand after them is still the cd target.
+    "cd >|log repo && cat .hermes/.env",
+    "cd >& /dev/null repo && cat .hermes/.env",
+    "cd >$(mktemp) repo && cat .hermes/.env",
 ])
 def test_cd_with_operand_after_a_redirect_is_not_cd_home(body):
     assert not _hit(body)
@@ -131,11 +146,24 @@ def test_cd_with_operand_after_a_redirect_is_not_cd_home(body):
     # No space: ``~2`` / ``~/2`` is a literal directory word, not home plus a ``2>`` redirect.
     "cd ~2>x && cat .hermes/.env",
     "cd ~/2>x && cat .hermes/.env",
+    "cd ~2>|x && cat .hermes/.env",
 ])
 def test_prose_cd_and_non_home_pushd_stay_portable(body):
     assert not _hit(body)
 
 
+# PR #2703 review 5898829102 nit 2: a redirect on the cd into ~/.hermes does not hide the cd into its code tree that
+# follows, so the pair names the hermes-agent checkout (portable), not the state directory.
+@pytest.mark.parametrize("body", [
+    "cd ~/.hermes 2>/dev/null && cd hermes-agent && git status",
+    "cd ~/.hermes >/dev/null; cd ./repos/x",
+    "cd ~ && cd .hermes 2>&1 && cd hermes-agent && make",
+    "cd ~/.hermes >& /dev/null # code\ncd bin",
+])
+def test_redirected_cd_into_state_dir_then_code_tree_is_the_code_tree(body):
+    assert not _hit(body)
+
+
 def test_many_cd_home_lines_without_a_state_path_scan_in_linear_time():
     # A pasted shell transcript: before the fix each ``cd ~`` scanned to the end of the text (20000 lines: ~37 s).
     body = "cd ~ && make\n" * 20000
-- 
