From 117743d58b4e3d7ec7c71aabba2e990c22578b9e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 05:47:31 +0000
Subject: [PATCH] [daveey] test(completion-recovery): second reconcile starts
 fresh; document last-admission-only marker

Test (b)'s second reconcile now clears the in-memory offer state first, as a
restarted gateway would, so its == 0 / no-offer assertions catch a disabled
recovered_admission_id check on their own (previously only the _offered
dedupe made them pass). Docstrings on requeue_admitted_completion and the
recovery module state the one-admission-per-identity assumption behind the
last-admission-only marker. Follow-up to #1665 review nits.
---
 gateway/completion_admission_recovery.py              |  5 ++++-
 .../test_completion_admission_desktop_delivery.py     | 11 +++++++++++
 tools/async_delegation.py                             |  7 ++++++-
 3 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/gateway/completion_admission_recovery.py b/gateway/completion_admission_recovery.py
index 97a51a49e6..02128d6b8a 100644
--- a/gateway/completion_admission_recovery.py
+++ b/gateway/completion_admission_recovery.py
@@ -13,7 +13,10 @@ Two halves close it:
   each async delegation they carried through ``requeue_admitted_completion``. A delegation whose
   Desktop row (``async_delegation_complete`` stamped with its id) is in the parent counts as
   delivered, and the reopen records the admission it was made for (``recovered_admission_id``), so a
-  (delegation, admission) pair is reopened at most once across starts. The ledger stays the
+  (delegation, admission) pair is reopened at most once across starts. That marker keeps only the
+  last admission, which is exact while completion_admission reuses one admission per completion
+  identity (one per delegation); were there two, the attempt budget and replay cap bound the
+  alternation. The ledger stays the
   gate: the reopened row is claimed (``claim_completion_delivery``, one attempt each) like any pending
   result, and a row past its attempts or its replay age is dropped there with a logged reason.
 - ``deliver_admitted`` is the claimed offer's step when the result already has an admission: a
diff --git a/tests/gateway/test_completion_admission_desktop_delivery.py b/tests/gateway/test_completion_admission_desktop_delivery.py
index 10d91316dd..1f470dddab 100644
--- a/tests/gateway/test_completion_admission_desktop_delivery.py
+++ b/tests/gateway/test_completion_admission_desktop_delivery.py
@@ -45,6 +45,16 @@ def _batch_row(authority, target):
                                 display_metadata={'display_text': 'Background work finished'})
 
 
+def _fresh_gateway_start():
+    """Forget this process's in-memory offer history, as a restarted gateway would. Without it the
+    ``_offered`` dedupe alone makes a repeat reopen offer nothing, hiding the durable marker."""
+    with delegation._orphan_lock:
+        delegation._offered.clear()
+        delegation._offered_at.clear()
+        delegation._startup_replayed.clear()
+        delegation._reoffered_at.clear()
+
+
 def _deliver_by_batch(events):
     for evt in events:
         claim = delegation.claim_event_delivery(evt, 'tui-completion-batch')
@@ -99,6 +109,7 @@ async def test_reopened_admission_delivered_by_batch_is_reopened_once(tmp_path,
         _batch_row(authority, target)
         assert _ledger('deleg_batch')[0] == 'delivered'
 
+        _fresh_gateway_start()  # only the durable recovered_admission_id may stop the second reopen
         assert reconcile_failed_completion_admissions(authority, offers) == 0
         assert _offered(offers) == []
         assert _ledger('deleg_batch')[0] == 'delivered'
diff --git a/tools/async_delegation.py b/tools/async_delegation.py
index 3da4a3ae41..0d26b48f72 100644
--- a/tools/async_delegation.py
+++ b/tools/async_delegation.py
@@ -847,7 +847,12 @@ def requeue_admitted_completion(delegation_id: str, target_queue,
     ``recovered_admission_id``: the failed admission a start-up reconcile reopens the row for. It is
     stored in the reopening transaction, and a row already reopened for that admission is left as it
     is, so a result delivered by a consumer that leaves no trace the reconcile can read is never
-    offered again at the next start."""
+    offered again at the next start.
+
+    The marker holds only the LAST admission a row was reopened for. Two failed admissions for one
+    delegation would overwrite each other and could alternate past the once-per-admission rule. That
+    does not happen today: completion_admission reuses one admission per completion identity, so a
+    delegation has at most one. The attempt budget and the replay age cap still bound it if it did."""
     now = time.time()
     with _DB_LOCK, _transaction() as conn:
         if recovered_admission_id is not None and conn.execute(
