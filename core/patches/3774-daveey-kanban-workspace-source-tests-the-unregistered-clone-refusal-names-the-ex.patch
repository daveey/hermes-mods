From bde22b8cb49004b92adff23e8a6bde39ce0caad6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:02:11 +0000
Subject: [PATCH] [daveey] kanban workspace_source tests: the
 unregistered-clone refusal names the exact clone root

Post-merge mutant M3 of #2474 (t_01a1d63b6784525c): in prove_origin,
`owner = common.parent if common.name == ".git" else common` -> `owner = common`
survived tests/hermes_cli/test_kanban_source_publish.py, because the park
refusal test asserted the substring "its clone is <clone>", which
"its clone is <clone>/.git)" also contains. That mutant names the wrong
value to paste into kanban.workspace_source.clones.

- Assert the detail's closing paren: "(its clone is <clone>)".
- New test: a worktree of a bare repo (common dir not named .git) names the
  repo directory itself, killing the converse mutant `owner = common.parent`.

Tests only. Proof: at this head the file passes 78/78, 0 skipped; with M3
applied test_unpublished_park_refusal_names_the_publish_refusal fails; with
`owner = common.parent` test_unregistered_refusal_names_a_bare_repo_itself
fails (each single-line mutant restored after).
---
 tests/hermes_cli/test_kanban_source_publish.py | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_source_publish.py b/tests/hermes_cli/test_kanban_source_publish.py
index 10cc102f1b..ba19f08988 100644
--- a/tests/hermes_cli/test_kanban_source_publish.py
+++ b/tests/hermes_cli/test_kanban_source_publish.py
@@ -528,13 +528,26 @@ def test_unpublished_park_refusal_names_the_publish_refusal(card, monkeypatch):
     text = str(refused.value)
     assert text.startswith("unpublished_workspace:")
     assert "workspace_source publish refused: source_clone_unregistered:" in text
-    assert f"its clone is {card.world.homes['hub'].clone}" in text
+    # The exact clone root (the value to register), closed by the detail's paren: not ``<clone>/.git``.
+    assert f"(its clone is {card.world.homes['hub'].clone})" in text
     assert "kanban.workspace_source.clones" in text
     task = kb.get_task(card.conn, card.id)
     assert task is not None and task.status == "running"  # refused: run ownership intact
     assert card.remote() is None
 
 
+def test_unregistered_refusal_names_a_bare_repo_itself(world, tmp_path):
+    """A worktree of a bare repository: its git common dir is the repository itself (not named ``.git``), so the
+    refusal names that directory, not its parent."""
+    path = tmp_path / "bare-wt"
+    git(world.origin, "worktree", "add", "-q", "--detach", str(path), "main")
+    cfg = kws.Settings(**{**use_home(world, "hub")[1].__dict__, "clones": {}})
+    with pytest.raises(pub.PublishRefused) as refused:
+        pub.prove_origin(str(path), cfg)
+    assert refused.value.code == "source_clone_unregistered"
+    assert refused.value.detail.endswith(f"(its clone is {world.origin})")
+
+
 def test_publish_refusal_hint_is_scoped_to_the_preflighted_run():
     """Only the run being preflighted gets its refusal named; another card or run (a nested ending) gets none."""
     assert pre.refusal_hint("t_a", 7) == ""
