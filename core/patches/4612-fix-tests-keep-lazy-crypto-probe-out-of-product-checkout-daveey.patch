From e295e16d235119495c65881ebd932b132e282f99 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 15:44:38 +0000
Subject: [PATCH] fix(tests): keep lazy crypto probe out of product checkout
 [daveey]

The lazy secrets main-level probe created then unlinked a root .py file.
Concurrent routing ownership scans could enumerate it before cleanup and
read it afterward, failing with FileNotFoundError rather than a hub assertion.
Run the unchanged script via python -c from the checkout instead: repo import
resolution and all dispatch/crypto assertions remain intact without a file.

Add a deterministic enumeration/read-gap regression using the real probe
subprocess and scanner, with uncached reads after cleanup. Before the fixture
fix this fails on _test_main_update_crypto_probe.py; afterward it passes.
No product code, hub threshold, scanner exemption, retries or timeout changes.
Tracked-only scanning was considered but would hide untracked product edits.

Proof: regression RED (including isolated retry); four affected suites in
parallel GREEN: 49 passed, 68 platform skips, zero failures. Full scripts/check
--base origin/main passed. Incident source 666623d and main ab626f4 both retain
the same writer. Controlled scheduling reproduces the observed exception;
we do not claim to have observed the original CI interleaving directly.
---
 tests/ci/test_update_probe_isolation.py       | 28 +++++++++++++++
 .../hermes_cli/test_lazy_secrets_dispatch.py  | 35 +++++++++----------
 2 files changed, 44 insertions(+), 19 deletions(-)
 create mode 100644 tests/ci/test_update_probe_isolation.py

diff --git a/tests/ci/test_update_probe_isolation.py b/tests/ci/test_update_probe_isolation.py
new file mode 100644
index 0000000000000000000000000000000000000000..cbad3d86545e1ccca00bfb2f93b6e94f408cfdd1
--- /dev/null
+++ b/tests/ci/test_update_probe_isolation.py
@@ -0,0 +1,28 @@
+"""The lazy-crypto fixture must not remove files inventoried as product source."""
+
+import subprocess
+
+import pytest
+
+from tests.ci import test_update_ci_routing as routing
+from tests.hermes_cli import test_lazy_secrets_dispatch as dispatch
+
+
+@pytest.mark.live_system_guard_bypass
+def test_crypto_probe_does_not_invalidate_product_inventory(monkeypatch):
+    run = subprocess.run
+    inventories = []
+
+    def inventory_then_run(*args, **kwargs):
+        # Pause the scanner after enumeration until the real probe has exited
+        # and its fixture cleanup has run. No scheduler luck or sleeps required.
+        inventories.append(routing._product_python())
+        return run(*args, **kwargs)
+
+    monkeypatch.setattr(subprocess, "run", inventory_then_run)
+    dispatch.TestUpdatePathE2E().test_main_update_check_crypto_absent_in_sys_modules()
+    assert len(inventories) == 1
+    assert routing._REPO / "hermes_cli/main.py" in inventories[0]
+    for path in inventories[0]:
+        # Bypass memoization so a previous ownership test cannot mask deletion.
+        routing._imports.__wrapped__(path)
