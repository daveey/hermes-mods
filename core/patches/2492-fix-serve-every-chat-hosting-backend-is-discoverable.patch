diff --git a/tests/gateway/test_host_backends.py b/tests/gateway/test_host_backends.py
new file mode 100644
index 0000000000..12e1bd8a68
--- /dev/null
+++ b/tests/gateway/test_host_backends.py
@@ -0,0 +1,100 @@
+"""Per-process serve backend entries (``gateway.host_backends``, t_01a1ce929e118cf2).
+
+The role record holds one owner per role. On daveey-mini the supervised always-on SSH backend
+(:9147) lost ``desktop-serve`` to a local Desktop pool child, published nothing, and hermes-sync's
+activations never reached its chats. Each backend now also publishes its own entry; these tests
+use a real rendezvous dir, real processes and real liveness proofs.
+"""
+from __future__ import annotations
+
+import dataclasses
+import json
+import os
+import stat
+import subprocess
+import sys
+
+import pytest
+
+from gateway import host_backends as hb
+from gateway import host_rendezvous as hr
+
+
+@pytest.fixture
+def lock_dir(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_GATEWAY_LOCK_DIR", str(tmp_path / "locks"))
+    monkeypatch.setattr(hr, "register_exit_cleanup", lambda callback: None)
+    yield tmp_path / "locks"
+    hb.clear()
+
+
+def _dead_pid() -> int:
+    proc = subprocess.Popen([sys.executable, "-c", "pass"])
+    proc.wait()
+    return proc.pid
+
+
+def test_publish_writes_a_private_entry_and_token_that_read_back(lock_dir):
+    record = hb.publish(hr.ROLE_DESKTOP_SERVE, host="127.0.0.1", port=9147, token="always-on-token")
+
+    assert record is not None and record.pid == os.getpid()
+    assert hb.read_entries() == [record]
+    assert hb.read_token(record) == "always-on-token"
+    assert hb.token_is_consistent(record) and hb.token_for(record) == "always-on-token"
+    if sys.platform != "win32":
+        assert stat.S_IMODE(hb.backends_dir().stat().st_mode) == 0o700
+        assert stat.S_IMODE(hb.token_path(record.pid).stat().st_mode) == 0o600
+        assert stat.S_IMODE(hb.entry_path(record.pid).stat().st_mode) == 0o600
+
+
+@pytest.mark.parametrize("kwargs", [
+    {"role": hr.ROLE_DESKTOP_SERVE, "port": 9147, "token": ""},
+    {"role": hr.ROLE_DESKTOP_SERVE, "port": None, "token": "t"},
+    {"role": hr.ROLE_GATEWAY, "port": 9147, "token": "t"},
+])
+def test_an_undialable_backend_publishes_nothing(lock_dir, kwargs):
+    role = kwargs.pop("role")
+    assert hb.publish(role, host="127.0.0.1", **kwargs) is None
+    assert hb.read_entries() == []
+
+
+def test_a_dead_entry_is_pruned_with_its_token(lock_dir):
+    record = hb.publish(hr.ROLE_DESKTOP_SERVE, host="127.0.0.1", port=9147, token="t")
+    dead = _dead_pid()
+    payload = {**record.to_json(), "pid": dead}
+    hb.entry_path(dead).write_text(json.dumps(payload))
+    hb.token_path(dead).write_text("old-token")
+
+    assert [r.pid for r in hb.read_entries()] == [os.getpid()]
+    assert not hb.entry_path(dead).exists() and not hb.token_path(dead).exists()
+
+
+def test_an_entry_whose_name_is_not_its_pid_is_ignored(lock_dir):
+    record = hb.publish(hr.ROLE_DESKTOP_SERVE, host="127.0.0.1", port=9147, token="t")
+    hb.entry_path(record.pid).rename(hb.backends_dir() / "1.json")
+
+    assert hb.read_entries() == []
+
+
+def test_clear_removes_only_this_process_entry(lock_dir):
+    hb.publish(hr.ROLE_SERVE, host="127.0.0.1", port=9119, token="t")
+    other = hb.backends_dir() / "999999.json"
+    other.write_text("{}")
+
+    hb.clear()
+
+    assert not hb.entry_path(os.getpid()).exists() and other.exists()
+
+
+def test_token_for_never_hands_out_another_process_role_token(lock_dir):
+    hr.publish_record(hr.ROLE_DESKTOP_SERVE, host="127.0.0.1", port=58497, token="pool-child-token")
+    entry = hb.publish(hr.ROLE_DESKTOP_SERVE, host="127.0.0.1", port=9147, token="always-on-token")
+    try:
+        # Same role, other pid, torn entry token: the pool child's role token must not be used.
+        foreign = dataclasses.replace(entry, pid=entry.pid + 1)
+        assert hb.token_for(foreign) == ""
+        assert hb.token_for(entry) == "always-on-token"
+        # A record whose entry token does not match it falls back to its own role token only.
+        assert hb.token_for(hr.read_record(hr.ROLE_DESKTOP_SERVE)) == "pool-child-token"
+    finally:
+        hr.clear_record(hr.ROLE_DESKTOP_SERVE)
diff --git a/tests/hermes_cli/test_plugin_activation_second_desktop_backend.py b/tests/hermes_cli/test_plugin_activation_second_desktop_backend.py
new file mode 100644
index 0000000000..5a378600c3
--- /dev/null
+++ b/tests/hermes_cli/test_plugin_activation_second_desktop_backend.py
@@ -0,0 +1,117 @@
+"""A second Desktop-owned backend with no role record still gets the activation (t_01a1ce929e118cf2).
+
+daveey-mini ran the supervised always-on SSH backend (:9147) and a local Desktop pool child. Both
+are Desktop-owned, so both contend for the single ``desktop-serve`` record; the loser published
+nothing and hermes-sync logged only ``backend serve:9119 ok`` while :9147 kept old hooks. Here the
+loser is a REAL second process that publishes only its per-process entry.
+"""
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from gateway import host_backends as hb
+from gateway import host_rendezvous as hr
+from hermes_cli import plugins_activation
+from tests.hermes_cli.test_plugin_activation_serve_fanout import _listener
+
+REPO = Path(__file__).resolve().parents[2]
+
+
+@pytest.fixture
+def second_backend(monkeypatch, tmp_path):
+    """Start a real process that publishes an entry for ``port`` and stays alive."""
+    monkeypatch.setenv("HERMES_GATEWAY_LOCK_DIR", str(tmp_path / "locks"))
+    procs, servers = [], []
+
+    def start(token: str = "always-on-token"):
+        server, seen = _listener()
+        servers.append(server)
+        code = ("import sys\nfrom gateway import host_backends as hb\n"
+                f"r = hb.publish('desktop-serve', host='127.0.0.1', port={server.server_address[1]}, "
+                f"token={token!r})\nprint('ready' if r else 'refused', flush=True)\nsys.stdin.read()\n")
+        proc = subprocess.Popen([sys.executable, "-c", code], cwd=REPO, text=True,
+                                stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+                                env={**os.environ, "PYTHONPATH": str(REPO)})
+        procs.append(proc)
+        assert proc.stdout.readline().strip() == "ready"
+        return proc, server.server_address[1], seen
+
+    yield start
+    for proc in procs:
+        proc.stdin.close()
+        proc.wait(timeout=30)
+    for server in servers:
+        server.shutdown()
+
+
+def test_the_backend_that_lost_the_desktop_serve_record_is_still_activated(second_backend, tmp_path):
+    pool, pool_seen = _listener()
+    try:
+        assert hr.publish_record(hr.ROLE_DESKTOP_SERVE, host="127.0.0.1", port=pool.server_address[1],
+                                 token="pool-child-token") is not None
+        proc, port, seen = second_backend()
+
+        answer = plugins_activation.notify_serve_backend("probe", tmp_path)
+
+        assert pool_seen == [{"token": "pool-child-token", "name": "probe", "home": str(tmp_path)}]
+        assert seen == [{"token": "always-on-token", "name": "probe", "home": str(tmp_path)}]
+        assert [(b["role"], b["port"], b["pid"]) for b in answer["backends"]] == [
+            ("desktop-serve", pool.server_address[1], os.getpid()), ("desktop-serve", port, proc.pid)]
+        assert answer["ok"] is True and "backend_error" not in answer
+    finally:
+        hr.clear_record(hr.ROLE_DESKTOP_SERVE)
+        pool.shutdown()
+
+
+def test_after_the_record_holder_exits_the_survivor_is_still_found(second_backend, tmp_path):
+    # The mini at 23:03: host-desktop-serve.lock, no host-desktop-serve.json, :9147 alive.
+    proc, port, seen = second_backend()
+
+    records = plugins_activation.serve_backend_records()
+
+    assert [(r.role, r.port, r.pid) for r in records] == [("desktop-serve", port, proc.pid)]
+    plugins_activation.notify_serve_backends("probe", tmp_path)
+    assert seen == [{"token": "always-on-token", "name": "probe", "home": str(tmp_path)}]
+
+
+def test_an_entry_with_a_torn_token_is_skipped(second_backend):
+    proc, _port, _seen = second_backend()
+    hb.token_path(proc.pid).write_text("torn-restart-token")
+
+    assert plugins_activation.serve_backend_records() == []
+
+
+def test_the_entry_goes_away_when_its_backend_exits(second_backend):
+    proc, _port, _seen = second_backend()
+    proc.stdin.close()
+    proc.wait(timeout=30)
+
+    assert hb.read_entries() == []
+    assert not hb.entry_path(proc.pid).exists()
+
+
+def test_a_desktop_backend_that_loses_the_role_record_still_publishes_its_entry(monkeypatch, tmp_path):
