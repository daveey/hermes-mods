From 1d4a810f623fbee38ce57709a69f9d26edb4c9e2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:33:32 +0000
Subject: [PATCH] [daveey] Record final creation-time placement policy in task
 events

---
 hermes_cli/kanban_db.py                       |  2 +-
 hermes_cli/kanban_db_creation.py              |  4 ++-
 .../test_kanban_portable_reason_audit.py      | 31 +++++++++++++++++++
 tests/tools/test_kanban_creation_audit.py     |  2 ++
 4 files changed, 37 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index 98c4df825e8..7287613e61c 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -1390,7 +1390,7 @@ def create_task(
                     workspace_path=workspace_path, branch_name=branch_name, project_id=project_id,
                     skills=skills_list, goal_mode=goal_mode, model_override=model_override,
                     provider_override=provider_override, created_by=created_by, requires=required,
-                    human_request=human_request, placement_audit=placement_audit,
+                    human_request=human_request, placement_audit=placement_audit, placement_policy=placement_policy,
                 )
                 # ACK-edge: the originating channel hears a child BLOCK, not just the fan-in.
                 initialize_ownership(conn, task_id, creator_task_id, parents, now, chat_origin)
diff --git a/hermes_cli/kanban_db_creation.py b/hermes_cli/kanban_db_creation.py
index 006be621640..0cb5d437a2f 100644
--- a/hermes_cli/kanban_db_creation.py
+++ b/hermes_cli/kanban_db_creation.py
@@ -23,7 +23,7 @@ def tool_creation_audit(args: dict, **effective) -> dict | None:
 def record_created(conn, task_id, *, assignee, status, parents, creator_task_id,
                    tenant, workspace_kind, workspace_path, branch_name, project_id,
                    skills, goal_mode, model_override, provider_override, created_by, requires,
-                   human_request=None, placement_audit=None):
+                   placement_policy, human_request=None, placement_audit=None):
     from hermes_cli import kanban_db as kb
 
     kb._append_event(conn, task_id, "created", {
@@ -43,6 +43,8 @@ def record_created(conn, task_id, *, assignee, status, parents, creator_task_id,
         "provider_override": provider_override,
         # Why a worker pool can or cannot take it (kanban_worker_placement.creation_audit); absent with no pool.
         **(placement_audit if isinstance(placement_audit, dict) else {}),
+        # Final insertion policy, not a later assignment or a caller's diagnostic override.
+        "placement_policy": placement_policy,
     })
     if status == "blocked":
         # A creation-time human ask is a decision wait: validate_human_request
diff --git a/tests/hermes_cli/test_kanban_portable_reason_audit.py b/tests/hermes_cli/test_kanban_portable_reason_audit.py
index e5b7e69bb7e..b6bc7f53ae6 100644
--- a/tests/hermes_cli/test_kanban_portable_reason_audit.py
+++ b/tests/hermes_cli/test_kanban_portable_reason_audit.py
@@ -133,3 +133,34 @@ def test_create_task_records_a_passed_reason(kanban_home):
         tid = kb.create_task(conn, title="tool card", placement_audit={"portable_reason": "local marker"})
     assert created_payload(tid)["portable_reason"] == "local marker"
     assert json.dumps(created_payload(tid))  # stays JSON
+
+
+@pytest.mark.parametrize("pinned", [False, True])
+def test_db_policy_is_creation_time_not_later_state(kanban_home, monkeypatch, pinned):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+
+    monkeypatch.setattr(placement.reg, "self_gateway", lambda: "hub")
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="Implement cloneable repository fix", assignee="default",
+                             requires=["terminal", "file", "git"], placement_checked=pinned,
+                             placement_audit={"portable_reason": None, "placement_policy": "untrusted"})
+        expected = None if pinned else "worker-first-v1"
+        assert kb.get_task(conn, tid).placement_policy == expected
+        # Simulate subsequent assignment changes in this isolated fixture, never production.
+        conn.execute("UPDATE tasks SET placement_policy=NULL WHERE id=?", (tid,))
+    assert created_payload(tid)["placement_policy"] == expected
+
+
+def test_runtime_pin_does_not_disable_cloneable_implementation():
+    from hermes_cli.kanban_worker_placement import creation_audit
+
+    cfg = {"worker_pools": {"hub": ["worker-1"]}}
+    repo = {"title": "Implement owner-feed regression in a cloneable repository",
+            "requires": ["terminal", "file", "git"], "assignee": "default"}
+    runtime = {**repo, "title": "Investigate stale session-idle owner evidence",
+               "runs_on": ["machine:hub"], "placement": "local"}
+    assert creation_audit(runtime, cfg)["portable_reason"] is not None
+    assert "placement_policy" not in placement.decide(runtime, cfg=cfg, self_gw="hub")
+    assert creation_audit(repo, cfg)["portable_reason"] is None
+    assert placement.decide(repo, cfg=cfg, self_gw="hub")["placement_policy"] == "worker-first-v1"
diff --git a/tests/tools/test_kanban_creation_audit.py b/tests/tools/test_kanban_creation_audit.py
index d2845a0191b..b17e10208f3 100644
--- a/tests/tools/test_kanban_creation_audit.py
+++ b/tests/tools/test_kanban_creation_audit.py
@@ -48,3 +48,5 @@ def test_effective_creation_audit_preserves_enrollment(kanban_home, tmp_path, mo
         assert task.project_id == (project_id if case == "inherited-project" else None)
         assert task.workspace_kind == ("worktree" if case == "inherited-project" else "scratch")
         assert event.payload["portable_reason"] == reason
+        assert "placement_policy" in event.payload
+        assert event.payload["placement_policy"] == policy
