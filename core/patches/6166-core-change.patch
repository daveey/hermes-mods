From f511f85bdadbf1c05f7332c81c588a28c5bdb9a6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 24 Nov 2026 13:36:20 +0000
Subject: [PATCH 6166] Fail-closed startup readiness and natural controller rollover

Public mirror of source commit f511f85bdadbf1c05f7332c81c588a28c5bdb9a6.

---
diff --git a/tests/e2e/core/serve_ownership/test_serve_session_ownership.py b/tests/e2e/core/serve_ownership/test_serve_session_ownership.py
index 222c6109562..47ad31d0024 100644
--- a/tests/e2e/core/serve_ownership/test_serve_session_ownership.py
+++ b/tests/e2e/core/serve_ownership/test_serve_session_ownership.py
@@ -241,6 +241,15 @@
         port = int(_poll(lambda: (m := re.search(rb"backend listening on [\d.]+:(\d+)", log.read_bytes()))
                          and m.group(1) or (serve.poll() is not None and b"-1"), BOOT_S, "serve port", log))
         assert port > 0, f"serve exited rc={serve.returncode}\n{log.read_text(errors='replace')}"
+        import httpx
+
+        from tests.e2e.core._service_readiness import service_response
+
+        # The listener line precedes service readiness; /api/status crosses the warmup fence.
+        with httpx.Client(base_url=f"http://127.0.0.1:{port}", timeout=60, trust_env=False,
+                          headers={"X-Hermes-Session-Token": token}) as http:
+            ready = service_response(http, "/api/status")
+            assert ready.status_code == 200, f"serve service readiness: {ready.status_code} {ready.text}"
         sws = connect(f"ws://127.0.0.1:{port}/api/ws?token={token}", open_timeout=90, max_size=None)
         sinks.append(sws)
         created = _rpc(sws, 1, "session.create", {})
diff --git a/tests/e2e/core/terminal/_gateway_client.py b/tests/e2e/core/terminal/_gateway_client.py
index f10e495d7e0..fc6971f3908 100644
--- a/tests/e2e/core/terminal/_gateway_client.py
+++ b/tests/e2e/core/terminal/_gateway_client.py
@@ -130,8 +130,24 @@
         except BaseException:
             self.stop()
             raise
+        self._await_services()
         return self
 
+    def _await_services(self) -> None:
+        """The listener line precedes service readiness; /api/status crosses the warmup fence."""
+        import httpx
+
+        from tests.e2e.core._service_readiness import service_response
+
+        try:
+            with httpx.Client(base_url=f"http://127.0.0.1:{self.port}", timeout=60, trust_env=False,
+                              headers={"X-Hermes-Session-Token": self.token}) as client:
+                response = service_response(client, "/api/status")
+            assert response.status_code == 200, f"serve service readiness: {response.status_code} {response.text}"
+        except BaseException:
+            self.stop()
+            raise
+
     @property
     def ws_url(self) -> str:
         return f"ws://127.0.0.1:{self.port}/api/ws?token={self.token}"
