From 4b02e53fa182493ab9a70d9b9227e2c8ba1e3009 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 26 Nov 2026 22:39:01 +0000
Subject: [PATCH 6723] Sidebar filtered project overviews, queued CI waits and retained card timers

Public mirror of source commit 4b02e53fa182493ab9a70d9b9227e2c8ba1e3009.

---
diff --git a/apps/desktop/src/app/chat/sidebar/session-row-card-squares.tsx b/apps/desktop/src/app/chat/sidebar/session-row-card-squares.tsx
index 47bc2ea046ebb239f11866dbcff3d3d177c4a95d..714bacba8107b3e5a2f79ecfe8f7f7da11cf62ea 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row-card-squares.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row-card-squares.tsx
@@ -14,6 +14,7 @@
 
 import { CardCountsContext } from './card-counts-context'
 import { SessionRowCardTimers } from './session-row-card-timers'
+import { rowTimers } from './session-row-timer-memory'
 import { useWaitClock } from './use-wait-clock'
 
 const COLOURS = {
@@ -190,7 +191,7 @@
   const readouts = !counts && statusStripe === 'external' ? sessionWaitEtas(session, Date.now() / 1000) : []
   const colours = counts ? backgroundCardColours(session) : trailingColours(session, executionUnknown)
 
-  if (!gatewayIcon && !readouts.length && !colours.length && !session.kanban_timed_cards?.length) {
+  if (!gatewayIcon && !readouts.length && !colours.length && !rowTimers(session).cards.length) {
     return null
   }
 
diff --git a/apps/desktop/src/app/chat/sidebar/session-row-timer-retention.test.tsx b/apps/desktop/src/app/chat/sidebar/session-row-timer-retention.test.tsx
index 87222f24fca580a0f626b429c44359e8bca98bcd..b50b236ee21d85fcaa584f7e4c5d27f884be2119 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row-timer-retention.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row-timer-retention.test.tsx
@@ -3,7 +3,9 @@
 
 import type { SessionInfo } from '@/hermes'
 import { I18nProvider } from '@/i18n'
+import { setSessions } from '@/store/session'
 
+import { flatRowCardMarks } from './session-row-card-squares'
 import { SessionRowCardTimers } from './session-row-card-timers'
 
 const NOW = 1_800_000_000
@@ -81,3 +83,27 @@
   act(() => vi.advanceTimersByTime(10_000))
   expect(ui.container.querySelector('[data-card-timer]')).toBeNull()
 })
+
+it('shows retained timers through the flat row marks of a single-connection unknown row', () => {
+  vi.useFakeTimers({ now: NOW * 1000 })
+  const first = render(view(row({ kanban_observed_at: NOW, kanban_timed_cards: cards })))
+  first.unmount()
+
+  const flat = render(
+    <I18nProvider configClient={null} initialLocale="en">
+      {flatRowCardMarks(row({ kanban_unknown: true }), 0, null)}
+    </I18nProvider>
+  )
+
+  expect(flat.container.querySelectorAll('[data-card-timer]')).toHaveLength(2)
+})
+
+it('a known-empty list read clears retention while the row is unmounted', () => {
+  vi.useFakeTimers({ now: NOW * 1000 })
+  const first = render(view(row({ kanban_observed_at: NOW, kanban_timed_cards: cards })))
+  first.unmount()
+  act(() => setSessions([row({ kanban_observed_at: NOW + 1 })]))
+  const next = render(view(row({ kanban_unknown: true })))
+  expect(next.container.querySelector('[data-card-timer]')).toBeNull()
+  act(() => setSessions([]))
+})
diff --git a/apps/desktop/src/store/session.ts b/apps/desktop/src/store/session.ts
index 7453622dbfd2529b3fb255e9fae07b3e834cd9fe..3ebfb5f97765bfc796d82b9488ad719f3c7bc448 100644
--- a/apps/desktop/src/store/session.ts
+++ b/apps/desktop/src/store/session.ts
@@ -2,6 +2,7 @@
 import { atom, computed } from 'nanostores'
 
 import { setApiRequestLocalMode } from '@/api/client'
+import { rememberRowTimers } from '@/app/chat/sidebar/session-row-timer-memory'
 import { lastVisibleMessageIsUser } from '@/app/chat/thread-loading'
 import type { ContextSuggestion } from '@/app/types'
 import type { HermesConnection } from '@/global'
@@ -1530,6 +1531,11 @@
   rescopeComposerSelection(composerScopeForConnection($connection.get()))
 }
 
+// Timer retention must see known-empty reads even while the row is unmounted (virtualized list).
+for (const list of [$sessions, $cronSessions, $messagingSessions]) {
+  list.listen(rows => rows.forEach(rememberRowTimers))
+}
+
 export const setGatewayState = (next: Updater<ConnectionState>) => updateAtom($gatewayState, next)
 export const setSessions = (next: Updater<SessionInfo[]>) => updateAtom($sessions, next)
 export const setUnlistedSessionOwnerRows = (next: Updater<SessionInfo[]>) => updateAtom($unlistedSessionOwnerRows, next)
