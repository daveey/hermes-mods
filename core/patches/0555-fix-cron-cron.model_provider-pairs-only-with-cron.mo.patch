From 73e3404f0020750db70eef665d2df656f345502e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 16:29:46 -0700
Subject: [PATCH] fix(cron): cron.model_provider pairs only with cron.model
 [daveey]

A job pinned to its own model without a provider inherited cron.model_provider
(the fleet provider), so 'hermes cron edit --model claude-...' without
--provider would be sent to openai-codex. _CronJobConfig now records the
model's source (job/cron/main/env); the fleet provider applies only to
cron.model. A provider-less pin uses its model's catalog provider, else the
global config.
---
 cron/scheduler.py                             | 38 +++++++++--
 .../cron/test_cron_model_provider_pairing.py  | 64 +++++++++++++++++++
 2 files changed, 98 insertions(+), 4 deletions(-)
 create mode 100644 tests/cron/test_cron_model_provider_pairing.py

diff --git a/cron/scheduler.py b/cron/scheduler.py
index 4bc0adf1f7..75ae091de3 100644
--- a/cron/scheduler.py
+++ b/cron/scheduler.py
@@ -1615,6 +1615,10 @@ class _CronJobConfig:
     model: str
     model_cfg: Any
     cron_default_provider: str
+    # Where ``model`` came from: "job" (per-job pin), "cron" (cron.model), "main" (config model.default)
+    # or "env" (HERMES_MODEL). cron.model_provider pairs only with "cron". The default keeps callers that
+    # predate the field on the old behaviour (cron.model_provider applies when the job names none). [daveey]
+    model_source: str = "cron"
 
 
 def _load_cron_job_config(job: dict, job_id: str, job_name: str) -> _CronJobConfig:
@@ -1622,6 +1626,7 @@ def _load_cron_job_config(job: dict, job_id: str, job_name: str) -> _CronJobConf
     the main agent model (config ``model:``, then HERMES_MODEL). Re-read every tick (no cache) so
     ``hermes cron edit --model`` and ``hermes model`` both apply next tick."""
     model = job.get("model") or cron_env_setting("HERMES_MODEL") or ""
+    model_source = "job" if job.get("model") else "env"
     _cron_default_provider = ""
     _cfg: dict = {}
     _model_cfg: Any = {}
@@ -1640,12 +1645,14 @@ def _load_cron_job_config(job: dict, job_id: str, job_name: str) -> _CronJobConf
             if not job.get("model"):
                 if _cron_default_model:
                     model = _cron_default_model
+                    model_source = "cron"
                 else:
                     # The main agent model: ``model: <name>`` shorthand or ``model.default``.
                     _main = _model_cfg if isinstance(_model_cfg, str) else (
                         _model_cfg.get("default") or _model_cfg.get("model") or _model_cfg.get("name")
                         if isinstance(_model_cfg, dict) else "")
-                    model = str(_main or "").strip() or model
+                    if str(_main or "").strip():
+                        model, model_source = str(_main).strip(), "main"
     except Exception as e:
         logger.warning("Job '%s': failed to load config.yaml, using defaults: %s", job_id, e)
 
@@ -1667,7 +1674,7 @@ def _load_cron_job_config(job: dict, job_id: str, job_name: str) -> _CronJobConf
         _net_cfg = _cfg.get("network", {})
         if isinstance(_net_cfg, dict) and _net_cfg.get("force_ipv4"):
             apply_ipv4_preference(force=True)
-    return _CronJobConfig(_cfg, model, _model_cfg, _cron_default_provider)
+    return _CronJobConfig(_cfg, model, _model_cfg, _cron_default_provider, model_source)
 
 
 def _load_prefill_messages(cfg: dict, job_id: str) -> Optional[list]:
@@ -1752,10 +1759,33 @@ def _blocked_config_result(job_id: str, job_name: str, _pf_reason: str) -> tuple
     return False, blocked_doc, "", f"{marker} {_pf_reason}"
 
 
+def _default_provider_for(jc: _CronJobConfig) -> Optional[str]:
+    """Provider for a job that names none. ``cron.model_provider`` belongs to ``cron.model`` only: a job
+    pinned to another model (``hermes cron edit --model claude-...`` without ``--provider``) was sent to the
+    fleet provider (openai-codex) and failed. Such a pin runs on its model's own provider when the static
+    catalog knows it, else on the persisted global config (None). [daveey]"""
+    source = getattr(jc, "model_source", "cron")
+    if source == "cron":
+        return jc.cron_default_provider or None
+    if source != "job":
+        return None
+    main = jc.model_cfg
+    main_model = main if isinstance(main, str) else (
+        (main.get("default") or main.get("model") or main.get("name")) if isinstance(main, dict) else "")
+    if str(main_model or "").strip() == str(jc.model or "").strip():
+        return None  # the main model: the global config's provider is its pair
+    try:
+        from hermes_cli.kanban_model_tier import infer_provider
+        return infer_provider(str(jc.model or "").strip())
+    except Exception:
+        return None
+
+
 def _resolve_job_runtime(job: dict, job_id: str, jc: _CronJobConfig) -> tuple[dict, str]:
     """Resolve the runtime, walking the fallback chain on auth/transient-network errors. Returns
     ``(runtime, model)``; provider+model swap atomically (never swap only the provider while keeping
-    a paid primary model). Provider precedence: per-job pin > cron.model_provider > persisted
+    a paid primary model). Provider precedence: per-job pin > cron.model_provider (only for a cron.model job;
+    ``_default_provider_for``) > persisted
     global config (None lets resolve_runtime_provider read it). A pinned job has no chain here
     (``_job_fallback_chain``): its resolve failure is the job's failure."""
     from hermes_cli.runtime_provider import (
@@ -1763,7 +1793,7 @@ def _resolve_job_runtime(job: dict, job_id: str, jc: _CronJobConfig) -> tuple[di
     from hermes_cli.auth import AuthError
 
     model = jc.model
-    requested = job.get("provider") or jc.cron_default_provider or None
+    requested = job.get("provider") or _default_provider_for(jc) or None
     from cron.scheduler_class_routing import deferred_runtime
     deferred = deferred_runtime(model, requested, job)
     if deferred is not None:
diff --git a/tests/cron/test_cron_model_provider_pairing.py b/tests/cron/test_cron_model_provider_pairing.py
new file mode 100644
index 0000000000..37da6834e2
--- /dev/null
+++ b/tests/cron/test_cron_model_provider_pairing.py
@@ -0,0 +1,64 @@
+"""cron.model_provider pairs only with cron.model [daveey].
+
+A job pinned to its own model without a provider used to inherit cron.model_provider (the fleet's
+openai-codex), so ``hermes cron edit --model claude-...`` without ``--provider`` failed. Entry path: run_job
+with a temp config.yaml (same harness as test_cron_provider_pin), checking the provider handed to
+resolve_runtime_provider.
+"""
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).parent.parent.parent))
+
+from tests.cron.test_cron_provider_pin import _base_job, _run  # noqa: E402
+
+
+def test_pinned_job_without_provider_uses_its_models_provider_not_cron_model_provider(tmp_path):
+    job = _base_job(model="claude-opus-5-5")
+    ok, err, agent_kwargs, resolve_kwargs = _run(
+        job, tmp_path, current_provider="openai-codex", current_model="gpt-6-astra",
+        cron_model="gpt-6-astra", cron_model_provider="openai-codex")
+    assert ok is True, err
+    assert agent_kwargs["model"] == "claude-opus-5-5"
+    assert resolve_kwargs["requested"] == "anthropic"
+
+
+def test_pinned_job_on_unknown_model_falls_back_to_global_config(tmp_path):
+    job = _base_job(model="some-house-model")
+    ok, err, _a, resolve_kwargs = _run(
+        job, tmp_path, current_provider="openrouter", current_model="main-model",
+        cron_model="fleet-model", cron_model_provider="fleet-provider")
+    assert ok is True, err
+    assert resolve_kwargs["requested"] is None  # resolve_runtime_provider reads model.provider
+
+
+def test_pinned_job_on_main_model_uses_global_config(tmp_path):
+    job = _base_job(model="claude-opus-5-5")
+    ok, err, _a, resolve_kwargs = _run(
+        job, tmp_path, current_provider="my-anthropic-proxy", current_model="claude-opus-5-5",
+        cron_model="fleet-model", cron_model_provider="fleet-provider")
+    assert ok is True, err
+    assert resolve_kwargs["requested"] is None
+
+
+def test_unpinned_job_gets_cron_model_provider(tmp_path):
+    ok, err, agent_kwargs, resolve_kwargs = _run(
+        _base_job(), tmp_path, current_provider="anthropic", current_model="claude-opus-5-5",
+        cron_model="gpt-6-astra", cron_model_provider="openai-codex")
+    assert ok is True, err
+    assert (agent_kwargs["model"], resolve_kwargs["requested"]) == ("gpt-6-astra", "openai-codex")
+
+
+def test_main_model_job_does_not_get_cron_model_provider(tmp_path):
+    """cron.model_provider without cron.model: the job runs the main model on its own provider."""
+    ok, err, agent_kwargs, resolve_kwargs = _run(
+        _base_job(), tmp_path, current_provider="anthropic", current_model="claude-opus-5-5",
+        cron_model_provider="openai-codex")
+    assert ok is True, err
+    assert (agent_kwargs["model"], resolve_kwargs["requested"]) == ("claude-opus-5-5", None)
+
+
+def test_model_source_default_keeps_old_callers_on_cron_provider():
+    from cron.scheduler import _CronJobConfig, _default_provider_for
+    jc = _CronJobConfig(cfg={}, model="m", model_cfg={}, cron_default_provider="fleet")
+    assert jc.model_source == "cron" and _default_provider_for(jc) == "fleet"
