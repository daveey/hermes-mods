From 1be484f93bb7f8e9f5ef3b86dab309e61d1cf374 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 12:15:01 +0000
Subject: [PATCH] feat(kanban): return per-row rejection resolution receipts
 [daveey]

---
 hermes_cli/kanban_sync_client.py                | 3 ++-
 tests/hermes_cli/test_kanban_sync_rejections.py | 4 +++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index bc1c2dccf5f..7d4b9c463a7 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -583,6 +583,7 @@ class RoundResult:
     push: Optional[PushResult] = None
     error: Optional[str] = None
     repaired: dict[str, list[str]] = field(default_factory=dict)  # cards re-pushed by repair_divergence
+    rejection_resolutions: list[dict] = field(default_factory=list)
 
 
 def open_shadow(slug: str, gateway: str) -> sqlite3.Connection:
@@ -656,7 +657,7 @@ def sync_board(slug: str, path: Path, hub: Hub, gateway: str) -> RoundResult:
                 heal_clobbered_completions(live)
         result.push = push(live, hub, slug, gateway, primary=mode == "primary")
         from hermes_cli.kanban_sync_rejections import resolve_rejections
-        resolve_rejections(live, hub, slug)
+        result.rejection_resolutions = resolve_rejections(live, hub, slug)
         return result
     finally:
         live.close()
diff --git a/tests/hermes_cli/test_kanban_sync_rejections.py b/tests/hermes_cli/test_kanban_sync_rejections.py
index e072a2dd27b..ec32926dbb0 100644
--- a/tests/hermes_cli/test_kanban_sync_rejections.py
+++ b/tests/hermes_cli/test_kanban_sync_rejections.py
@@ -50,7 +50,9 @@ def test_normal_sync_retires_superseded_keeps_audit_and_is_idempotent(live, svc,
     reject_status(live, svc)
     audits = [tuple(r) for r in live.execute("SELECT * FROM task_events WHERE kind='sync_rejected'")]
     assert audits
-    client.sync_board(BOARD, kanban_home / "kanban.db", svc.hub(ME), ME)
+    result = client.sync_board(BOARD, kanban_home / "kanban.db", svc.hub(ME), ME)
+    assert result.rejection_resolutions[0]["classification"] == "superseded"
+    assert result.rejection_resolutions[0]["action"] == "retired"
     assert client.status(live)["rejected"] == 0
     assert [tuple(r) for r in live.execute("SELECT * FROM task_events WHERE kind='sync_rejected'")] == audits
     client.sync_board(BOARD, kanban_home / "kanban.db", svc.hub(ME), ME)
-- 
2.55.0

