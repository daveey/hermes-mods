-                        return False
                     trigram = self._trigram_tokenizer_available(cursor)
+                    tables = [(r[0], (r[1] or "").startswith("CREATE VIRTUAL")) for r in cursor.execute(
+                        "SELECT name, sql FROM sqlite_master WHERE type = 'table' ORDER BY name").fetchall()]
