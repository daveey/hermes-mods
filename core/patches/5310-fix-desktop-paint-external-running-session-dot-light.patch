From 1594a09c9fd3b4b2b88cfeba9b659eba2e764dc4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 16:51:21 +0000
Subject: [PATCH] fix(desktop): paint external-running session dot light blue
 (down: red)

The sidebar/tab session dot reused the hollow-grey 'background' variant for
external and external_down, so only the hover text differed. Paint it filled sky-400 / red-500
like the row stripe; test asserts the computed colour.

Hermes-Card: t_eeeeee000000002d
---
 .../src/app/chat/session-status-dot.test.tsx  | 27 +++++++++++++++++++
 .../src/app/chat/session-status-dot.tsx       | 23 +++++++++++++++-
 2 files changed, 49 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/app/chat/session-status-dot.test.tsx b/apps/desktop/src/app/chat/session-status-dot.test.tsx
index dbe48f937f..c0ef43f9b1 100644
--- a/apps/desktop/src/app/chat/session-status-dot.test.tsx
+++ b/apps/desktop/src/app/chat/session-status-dot.test.tsx
@@ -420,6 +420,33 @@ describe('SessionStatusDot external label', () => {
     }
   })
 
+  it('paints running-external light blue and down red (computed colour), never the hollow grey background dot', () => {
+    const bg = (el: Element | null) => getComputedStyle(el as Element).backgroundColor
+
+    const ext = dot({
+      id: 'ext-paint',
+      kanban_active: 1,
+      kanban_external: 1,
+      kanban_observed_at: Date.now() / 1000,
+      kanban_parked: 1,
+      message_count: 4
+    })
+
+    expect(bg(ext.querySelector('[data-background-label="external"]'))).toBe('rgb(56, 189, 248)')
+    cleanup()
+
+    const down = dot({
+      id: 'ext-down-paint',
+      kanban_active: 1,
+      kanban_external_down: 1,
+      kanban_observed_at: Date.now() / 1000,
+      kanban_parked: 1,
+      message_count: 4
+    })
+
+    expect(bg(down.querySelector('[data-background-label="external_down"]'))).toBe('rgb(239, 68, 68)')
+  })
+
   it('missing cards keep the generic external label, not a service claim', () => {
     const c = dot({
       id: 'ext-generic',
diff --git a/apps/desktop/src/app/chat/session-status-dot.tsx b/apps/desktop/src/app/chat/session-status-dot.tsx
index 79c23056bd..bb67647263 100644
--- a/apps/desktop/src/app/chat/session-status-dot.tsx
+++ b/apps/desktop/src/app/chat/session-status-dot.tsx
@@ -1,4 +1,5 @@
 import { useStore } from '@nanostores/react'
+import type { CSSProperties } from 'react'
 
 import { type Translations, useI18n } from '@/i18n'
 import { formatSessionExternalHover } from '@/lib/external-run'
@@ -19,12 +20,17 @@ type DotVariant = {
   ariaLabel?: (r: Translations['sidebar']['row']) => string
   className: string
   role?: 'status'
+  style?: CSSProperties
   title?: (r: Translations['sidebar']['row']) => string
 }
 
 // Shared base for every active dot; idle is smaller and uses its own class.
 const DOT_BASE = 'size-1.5 rounded-full'
 
+// [daveey] Tailwind sky-400 / red-500, the external and external_down stripe hues.
+const EXTERNAL_BLUE = '#38bdf8'
+const EXTERNAL_RED = '#ef4444'
+
 // Three colors and one fill/hollow axis, none of it moving. Motion on a 6px
 // circle can only say "something is happening" — which the row's arc already
 // says, better — while costing a repaint per frame on every row at once. What
@@ -118,7 +124,21 @@ export const sessionDotVariant = (
             ? r.backgroundExternalDown
             : r.backgroundExternal
 
-    return { ...DOT_VARIANTS.background, ariaLabel: label, title: label }
+    // [daveey] External run: filled light blue (down: red), the same hues as the row stripe. Literal colours (not
+    // class names) so the paint is the same wherever the dot renders and can be asserted as a computed colour.
+    const external = backgroundLabel === 'external' || backgroundLabel === 'external_down'
+
+    return {
+      ...DOT_VARIANTS.background,
+      ariaLabel: label,
+      ...(external
+        ? {
+            className: DOT_BASE,
+            style: { backgroundColor: backgroundLabel === 'external' ? EXTERNAL_BLUE : EXTERNAL_RED }
+          }
+        : {}),
+      title: label
+    }
   }
 
   const stripe = state === 'unread' ? unreadDotOutcomeStripe(outcome) : null
@@ -213,6 +233,7 @@ export function SessionStatusDot({ storedSessionId, session, branchStem, classNa
           className={variant.className}
           data-background-label={dotState === 'background' ? backgroundLabel : undefined}
           role={variant.role}
+          style={variant.style}
           title={title}
         />
       )}
