From: daveey <daveey@users.noreply.github.com>
Date: Tue, 24 Nov 2026 23:32:46 +0000
Subject: [PATCH 6251] Recorded governor explanations and lightweight why startup

Public mirror of source commit d45c14dca0c820cc0a835c2c515ceee6b192943c.

---
diff --git a/hermes_cli/kanban_why_fast.py b/hermes_cli/kanban_why_fast.py
index 98834aa2647..7393bef9d1e 100644
--- a/hermes_cli/kanban_why_fast.py
+++ b/hermes_cli/kanban_why_fast.py
@@ -91,6 +91,7 @@
     if flags == ["--json"] and (root / "kanban" / "current").exists():
         return False  # canonical resolver handles current-board metadata and tombstones
     path = root / "kanban.db" if board == "default" else root / "kanban" / "boards" / board / "kanban.db"
+    # sqlite-sidecar-open: ok — read_answer opens SQLite through lockguard; plain file read is unrelated JSON
     result = read_answer(path, task_id)
     if result is None or result.get("board") != board:
         return False
