From e9e07e29f5ea8f22ad05cc9d3cb4029542311916 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 5 Nov 2026 04:12:49 +0000
Subject: [PATCH] [daveey] Let local recovery probes use the RPC hang bound
 instead of pong timeout

---
 .../gateway/fixtures/local_recovery_probe.py  |  4 ++
 .../gateway/test_local_recovery_transport.py  | 52 +++++++++++++++++++
 2 files changed, 56 insertions(+)
 create mode 100644 tests/gateway/test_local_recovery_transport.py

diff --git a/tests/gateway/fixtures/local_recovery_probe.py b/tests/gateway/fixtures/local_recovery_probe.py
index 23925fd2546..731628760e2 100644
--- a/tests/gateway/fixtures/local_recovery_probe.py
+++ b/tests/gateway/fixtures/local_recovery_probe.py
@@ -85,6 +85,10 @@ async def rpc(ws, method, **params):
 
 
 def websocket(home, desc, **kw):
+    # These probes test RPC behavior, not heartbeat responsiveness. A CPU-starved
+    # daemon can miss the library's 20s pong deadline before RPC_DEADLINE expires.
+    # Keep pings, but let rpc() own the hang bound; heartbeat tests can opt back in.
+    kw.setdefault('ping_timeout', None)
     grant = control(home, 'session-ticket', {'profile_id': str(home), 'instance_id': desc['instance_id'], 'purpose': 'interactive'})
     return connect(desc['api_origin'].replace('http:', 'ws:') + '/api/ws',
                    subprotocols=['hermes-gateway-v1', 'hermes-gateway-ticket.' + grant['ticket']], **kw)
diff --git a/tests/gateway/test_local_recovery_transport.py b/tests/gateway/test_local_recovery_transport.py
new file mode 100644
index 00000000000..eb6ca5dded3
--- /dev/null
+++ b/tests/gateway/test_local_recovery_transport.py
@@ -0,0 +1,52 @@
+"""Local daemon probes use the RPC hang bound, not a shorter pong deadline."""
+import asyncio
+import json
+
+import pytest
+from websockets.asyncio.server import serve
+
+from tests.gateway.fixtures import local_recovery_probe as probe
+
+
+@pytest.mark.parametrize('options,expected_timeout', [({}, None), ({'ping_timeout': 5}, 5)])
+def test_probe_heartbeat_policy_and_explicit_override(tmp_path, monkeypatch, options, expected_timeout):
+    monkeypatch.setattr(probe, 'control', lambda *args: {'ticket': 'test-ticket'})
+
+    async def echo(ws):
+        async for message in ws:
+            request = json.loads(message)
+            await ws.send(json.dumps({'id': request['id'], 'result': 'ok'}))
+
+    async def run():
+        async with serve(echo, '127.0.0.1', 0) as server:
+            port = next(iter(server.sockets)).getsockname()[1]
+            desc = {'api_origin': f'http://127.0.0.1:{port}', 'instance_id': 'test'}
+            async with probe.websocket(tmp_path, desc, **options) as ws:
+                assert ws.ping_interval is not None
+                assert ws.ping_timeout == expected_timeout
+                assert (await probe.rpc(ws, 'test.read'))['result'] == 'ok'
+
+    asyncio.run(run())
+
+
+def test_unanswered_rpc_still_times_out_without_pong_deadline(tmp_path, monkeypatch):
+    monkeypatch.setattr(probe, 'control', lambda *args: {'ticket': 'test-ticket'})
+    monkeypatch.setattr(probe, 'RPC_DEADLINE', 2)
+
+    async def run():
+        received = asyncio.Event()
+
+        async def silent(ws):
+            await ws.recv()
+            received.set()
+            await ws.wait_closed()
+
+        async with serve(silent, '127.0.0.1', 0) as server:
+            port = next(iter(server.sockets)).getsockname()[1]
+            desc = {'api_origin': f'http://127.0.0.1:{port}', 'instance_id': 'test'}
+            async with probe.websocket(tmp_path, desc) as ws:
+                with pytest.raises(TimeoutError):
+                    await probe.rpc(ws, 'test.unanswered')
+                assert received.is_set()
+
+    asyncio.run(run())
