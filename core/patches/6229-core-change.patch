     if (connection.kind === 'ssh' && !pooled.some(([key]) => (key.slice(prefix.length) || 'default') === 'default')) {
       const primary = await deps.reusedPrimary(connection.id)
 
       if (primary) {
         backends.push({ descriptor: primary, profileLabel: 'default' })
