diff --git a/hermes_cli/kanban_worktree_gc.py b/hermes_cli/kanban_worktree_gc.py
index 701ea203a6f..ac43bec1625 100644
--- a/hermes_cli/kanban_worktree_gc.py
+++ b/hermes_cli/kanban_worktree_gc.py
@@ -310,8 +310,13 @@
 
     def owner_unchanged():
         # Re-checked right before the archive changes the tree (foreign ownership adoption).
-        with kb.write_txn(conn):
-            return guard(path)
+        # A busy/failed board read refuses the change; it must not abort the whole GC pass.
+        try:
+            with kb.write_txn(conn):
+                return guard(path)
+        except sqlite3.Error:
+            log.warning("Scratch GC: owner re-check failed for %s; not adopting", task_id, exc_info=True)
+            return False
 
