From 9561d2b6b6ea96ca833a7280818371068106b034 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 5 Nov 2026 05:37:02 +0000
Subject: [PATCH] fix(auth): guard CF Access writes with Fetch Metadata
 [daveey]

Restore the reviewed guard delta after ed1afb convergence without remerging upstream. CF Access browser-cookie authentication must not bypass the other-page write check.

Proof: tests-only on fresh main fail both same-site/cross-site POST cases (200 versus 403); with guard, all 304 tests across 18 auth/context files pass. Read, same-origin and missing-metadata controls remain allowed.
---
 hermes_cli/dashboard_auth/middleware.py             |  4 ++++
 .../gateway/test_context_fallback_label_gateway.py  | 12 ++++++++++++
 tests/hermes_cli/test_dashboard_auth_cf_access.py   | 13 +++++++++++++
 3 files changed, 29 insertions(+)

diff --git a/hermes_cli/dashboard_auth/middleware.py b/hermes_cli/dashboard_auth/middleware.py
index 39723b9e013..cbbc1f25af7 100644
--- a/hermes_cli/dashboard_auth/middleware.py
+++ b/hermes_cli/dashboard_auth/middleware.py
@@ -259,6 +259,10 @@ async def gated_auth_middleware(
                 nxt = request.query_params.get("next", "")
                 target = nxt if nxt and is_safe_next_path(nxt) else f"{prefix_from_request(request)}/"
                 return RedirectResponse(url=target, status_code=302)
+            # Access asserts the login from the browser's own CF_Authorization cookie, so a write
+            # the browser itself says another page made is refused here as for a cookie session.
+            if request.method not in _SAFE_METHODS and _browser_says_other_page(request):
+                return JSONResponse(status_code=403, content={"detail": _OTHER_PAGE_WRITE_DETAIL})
             request.state.session = cf_session
             return await call_next(request)
     # Login/callback routes have their own credentials/state checks. Logout is public so an
diff --git a/tests/gateway/test_context_fallback_label_gateway.py b/tests/gateway/test_context_fallback_label_gateway.py
index 0698dfa6443..038b61e7e95 100644
--- a/tests/gateway/test_context_fallback_label_gateway.py
+++ b/tests/gateway/test_context_fallback_label_gateway.py
@@ -91,6 +91,18 @@ async def test_context_marks_a_non_resident_sessions_defaulted_route():
     assert "Window: 128,000 tokens (fallback)" in result
 
 
+def test_extracted_route_resolver_marks_bedrocks_static_default(monkeypatch):
+    """The fork's extracted ``gateway.run_model_context`` resolver agrees with the resolver's own default
+    record: an unknown Bedrock model's static 128K is a default, a detected window is not."""
+    from gateway import run
+    from gateway.run_model_context import resolve_gateway_model_context
+    monkeypatch.setattr(run, "_load_gateway_config", dict)
+    route = {"provider": "bedrock", "base_url": RUNTIME_URL, "api_key": "aws-sdk"}
+    defaulted = resolve_gateway_model_context(UNKNOWN, route)
+    assert (defaulted.context_length, defaulted.context_source) == (128_000, "default")
+    assert run._resolve_gateway_model_context(UNKNOWN, route).context_source == "default"
+
+
 @pytest.mark.asyncio
 async def test_model_switch_does_not_show_a_discarded_pin(tmp_path, monkeypatch):
     """The configured model's 128K pin is dropped for the new route, so it must not label the new window."""
diff --git a/tests/hermes_cli/test_dashboard_auth_cf_access.py b/tests/hermes_cli/test_dashboard_auth_cf_access.py
index b76367adafb..134c9c303a0 100644
--- a/tests/hermes_cli/test_dashboard_auth_cf_access.py
+++ b/tests/hermes_cli/test_dashboard_auth_cf_access.py
@@ -70,6 +70,19 @@ def test_ws_ticket_works_with_access_session(gated):
     assert r.status_code == 200 and r.json()["ticket"]
 
 
+@pytest.mark.parametrize("site", ["same-site", "cross-site"])
+def test_access_session_write_from_another_page_is_refused(gated, site):
+    """Access rides the browser's CF_Authorization cookie: a write the browser marks as another
+    page's is refused like a cookie session's, while the same page's write and reads still work."""
+    headers = {cf_access.HEADER: _token(), "Sec-Fetch-Site": site}
+    r = gated.post("/api/auth/ws-ticket", headers=headers)
+    assert r.status_code == 403
+    assert r.json()["detail"] == "Cookie-authenticated writes must come from this dashboard's own page."
+    assert gated.get("/api/auth/me", headers=headers).status_code == 200
+    own = gated.post("/api/auth/ws-ticket", headers={cf_access.HEADER: _token(), "Sec-Fetch-Site": "same-origin"})
+    assert own.status_code == 200 and own.json()["ticket"]
+
+
 @pytest.mark.parametrize("kwargs", [
     {"aud": "some-other-app"},
     {"iss": "https://evil.cloudflareaccess.com"},
