From df2b99ca70dadfed387a795e7f96f6bdb4a9fdbb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 18 Oct 2026 18:23:57 -0700
Subject: [PATCH] feat(desktop): sidebar section rows take hover actions +
 strong label [daveey]

SidebarSectionRow gains `actions` (hover/focus-revealed trailing controls
that replace `meta` while hovered) and `strong` (unread emphasis), for
the hermes-mods Inbox section's per-row Archive button.
---
 .../sidebar/contributed-sections.test.tsx     | 43 ++++++++++++++++++
 .../app/chat/sidebar/contributed-sections.tsx | 44 ++++++++++++++++++-
 2 files changed, 85 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/app/chat/sidebar/contributed-sections.test.tsx b/apps/desktop/src/app/chat/sidebar/contributed-sections.test.tsx
index ab4fece34d..f817eca5d0 100644
--- a/apps/desktop/src/app/chat/sidebar/contributed-sections.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/contributed-sections.test.tsx
@@ -77,4 +77,47 @@ describe('SidebarContributedSections', () => {
     })
     expect(screen.queryByText('Blocked')).toBeNull()
   })
+
+  it('renders hover actions beside meta without selecting the row, and bolds strong labels', () => {
+    const onSelect = vi.fn()
+    const onArchive = vi.fn()
+
+    const { container } = render(
+      <SidebarSection label="Inbox" onToggle={() => {}} open>
+        <SidebarSectionRow
+          actions={
+            <button
+              onClick={event => {
+                event.stopPropagation()
+                onArchive()
+              }}
+              type="button"
+            >
+              Archive
+            </button>
+          }
+          label="Idle box"
+          meta="12m"
+          onSelect={onSelect}
+          strong
+        />
+        <SidebarSectionRow label="Plain" meta="1d" onSelect={() => {}} />
+      </SidebarSection>
+    )
+
+    const slot = container.querySelector('[data-slot="sidebar-section-row-actions"]')
+    expect(slot).not.toBeNull()
+    expect(slot?.className).toContain('group-hover/contrib-row:flex')
+    expect(screen.getByText('12m').className).toContain('group-hover/contrib-row:hidden')
+    // A row without actions keeps its meta visible on hover.
+    expect(screen.getByText('1d').className).not.toContain('hidden')
+    expect(container.querySelectorAll('[data-slot="sidebar-section-row-actions"]')).toHaveLength(1)
+
+    fireEvent.click(screen.getByText('Archive'))
+    expect(onArchive).toHaveBeenCalledTimes(1)
+    expect(onSelect).not.toHaveBeenCalled()
+
+    expect(screen.getByText('Idle box').className).toContain('font-semibold')
+    expect(screen.getByText('Plain').className).not.toContain('font-semibold')
+  })
 })
diff --git a/apps/desktop/src/app/chat/sidebar/contributed-sections.tsx b/apps/desktop/src/app/chat/sidebar/contributed-sections.tsx
index 0165c43e31..3c4952e226 100644
--- a/apps/desktop/src/app/chat/sidebar/contributed-sections.tsx
+++ b/apps/desktop/src/app/chat/sidebar/contributed-sections.tsx
@@ -111,11 +111,18 @@ export interface SidebarSectionRowProps {
   indent?: boolean
   /** Muted label typography for group header rows. */
   muted?: boolean
+  /** Hover-revealed trailing controls (e.g. an archive button); replace
+   *  `meta` while the row is hovered or focused. Clicks inside should
+   *  `stopPropagation()` — they sit outside the row body anyway. */
+  actions?: React.ReactNode
+  /** Emphasised (unread) label typography. */
+  strong?: boolean
 }
 
 /** One clickable row on the session-row grid. */
 export function SidebarSectionRow({
   accentColor,
+  actions,
   active,
   icon,
   indent,
@@ -123,12 +130,41 @@ export function SidebarSectionRow({
   meta,
   muted,
   onSelect,
+  strong,
   tip
 }: SidebarSectionRowProps) {
+  const metaNode = meta ? (
+    <span
+      className={cn(
+        'text-[0.6875rem] text-(--ui-text-tertiary) tabular-nums',
+        actions && 'group-focus-within/contrib-row:hidden group-hover/contrib-row:hidden'
+      )}
+    >
+      {meta}
+    </span>
+  ) : null
+
+  const actionsNode = actions ? (
+    <span
+      className={cn(
+        'items-center gap-0.5',
+        meta ? 'hidden group-focus-within/contrib-row:flex group-hover/contrib-row:flex' : 'flex opacity-0 group-focus-within/contrib-row:opacity-100 group-hover/contrib-row:opacity-100'
+      )}
+      data-slot="sidebar-section-row-actions"
+    >
+      {actions}
+    </span>
+  ) : null
+
   return (
     <SidebarRowShell
       actions={
-        meta ? <span className="text-[0.6875rem] text-(--ui-text-tertiary) tabular-nums">{meta}</span> : undefined
+        metaNode || actionsNode ? (
+          <>
+            {metaNode}
+            {actionsNode}
+          </>
+        ) : undefined
       }
       className={cn(
         'group/contrib-row relative hover:bg-(--chrome-action-hover)',
@@ -153,7 +189,11 @@ export function SidebarSectionRow({
             )}
           </SidebarRowLead>
           <SidebarRowLabel
-            className={cn('group-hover/contrib-row:text-foreground', muted && 'text-(--ui-text-tertiary)')}
+            className={cn(
+              'group-hover/contrib-row:text-foreground',
+              muted && 'text-(--ui-text-tertiary)',
+              strong && 'font-semibold text-foreground'
+            )}
           >
             {label}
           </SidebarRowLabel>
-- 
2.55.0

