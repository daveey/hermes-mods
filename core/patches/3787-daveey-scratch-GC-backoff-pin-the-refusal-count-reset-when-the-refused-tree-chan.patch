From a670fc3428bbc86be79aa02e1770c03561e9b4f7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:25:22 +0000
Subject: [PATCH] [daveey] scratch GC backoff: pin the refusal count reset when
 the refused tree changes

Post-merge check t_01a1d5f0a7c905e0 of #2407: mutant B09 in
Refusals.record (`if prior.get("fingerprint") == fp` -> `if True`, so a
changed tree keeps its old refusal count) survived all 159 tests in the
three scratch GC/custody suites. A changed tree refused again then waited
the old tree's doubled backoff instead of BASE_S.

New test_refusal_count_resets_when_the_refused_tree_changes (mtime and
completed_at variants): refuse a tree twice (count 2), change its
fingerprint, refuse again -> count == 1 and retry_at - last_at == BASE_S.

RED under B09: both variants fail (assert 3 == 1).
GREEN on main: tests/hermes_cli/test_kanban_scratch_gc_backoff.py,
test_kanban_scratch_custody_backoff.py, test_kanban_scratch_custody.py pass
via scripts/run_tests.sh. Test-only change.
---
 .../test_kanban_scratch_gc_backoff.py         | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_scratch_gc_backoff.py b/tests/hermes_cli/test_kanban_scratch_gc_backoff.py
index ce4a718a5d..4c600edabb 100644
--- a/tests/hermes_cli/test_kanban_scratch_gc_backoff.py
+++ b/tests/hermes_cli/test_kanban_scratch_gc_backoff.py
@@ -7,6 +7,7 @@ refused trees every hour (one partial clone cost ~78 s per pass) and ran past th
 import argparse
 import json
 import logging
+import os
 
 import pytest
 
@@ -106,6 +107,33 @@ def test_backoff_doubles_to_a_cap(tmp_path):
     assert bo.Refusals("default", now=lambda: clock[0]).entries == {}
 
 
+@pytest.mark.parametrize("change", ["mtime", "completed_at"])
+def test_refusal_count_resets_when_the_refused_tree_changes(tmp_path, change):
+    """A changed tree refused again starts over at count 1 and BASE_S, not the old tree's doubled wait."""
+    clock = [1_000_000.0]
+    refusals = bo.Refusals("default", now=lambda: clock[0])
+    tree = tmp_path / "tree"
+    tree.mkdir()
+    refusals.record("t", tree, 5, "refused")
+    clock[0] += 60
+    refusals.record("t", tree, 5, "refused")
+    assert refusals.entries["t"]["count"] == 2
+    old_fp = refusals.entries["t"]["fingerprint"]
+    completed_at = 5
+    if change == "mtime":
+        st = tree.stat()
+        os.utime(tree, ns=(st.st_atime_ns, st.st_mtime_ns + 1_000_000_000))
+    else:
+        completed_at = 6
+    assert bo.fingerprint(tree, completed_at) != old_fp
+    clock[0] += 60
+    refusals.record("t", tree, completed_at, "refused again")
+    entry = refusals.entries["t"]
+    assert entry["count"] == 1
+    assert entry["retry_at"] - entry["last_at"] == bo.BASE_S
+    assert entry["fingerprint"] == bo.fingerprint(tree, completed_at)
+
+
 def test_unreadable_state_is_empty_and_never_blocks(remote, archives):
     bo._path("default").parent.mkdir(parents=True, exist_ok=True)
     bo._path("default").write_text("{not json")
