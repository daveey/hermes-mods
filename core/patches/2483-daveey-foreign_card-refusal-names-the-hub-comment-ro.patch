From 2199ec4ba69756980e47c9a5b5ca9c269043bde1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 06:35:58 +0000
Subject: [PATCH] [daveey] foreign_card refusal names the hub-comment route for
 hub-owned cards

A worker's kanban_comment on a hub-owned card is refused as foreign_card. With no route named, workers filed relay cards that queued on the hub only to post one comment (t_01a1cdddf74bf702, t_01a1ce0a2cbadf21). When the hub-comment helper (state hosts/hermes-workers/bin/hub-comment, capability:hub-write workers) is on PATH and the owner is the hub, the refusal now names it, comment only. t_01a1ce48ffc89823
---
 hermes_cli/kanban_foreign_card.py             | 23 ++++++++++++-
 .../test_kanban_foreign_card_writes.py        | 34 +++++++++++++++++++
 2 files changed, 56 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_foreign_card.py b/hermes_cli/kanban_foreign_card.py
index 3a337e1354..f6ba08747d 100644
--- a/hermes_cli/kanban_foreign_card.py
+++ b/hermes_cli/kanban_foreign_card.py
@@ -35,7 +35,28 @@ class ForeignCardError(Exception):
 
 def message(task_id: str, owner: Optional[str]) -> str:
     return (f"{task_id} was created on {owner or 'another gateway'} and lives there; this gateway has only a "
-            "replica copy. Its owner or the Board must write it.")
+            "replica copy. Its owner or the Board must write it." + comment_route(task_id, owner))
+
+
+# Gateway names a hub-owned card's ``created_on`` carries (the hub's own name and its alias).
+HUB_OWNERS = frozenset({"hub", "hermes-hub"})
+HUB_COMMENT = "hub-comment"
+
+
+def comment_route(task_id: str, owner: Optional[str]) -> str:
+    """The supported comment-only route onto ``owner``'s card from this machine, as a sentence, else "".
+
+    A pool worker carrying ``capability:hub-write`` has the ``hub-comment`` helper (state
+    ``hosts/hermes-workers/bin/hub-comment``): it adds one comment to a hub-owned card over the logged
+    ``hub-admin`` route, attributed ``<worker>/<card>``, and reads it back. Before it was named here, workers that
+    hit this refusal filed relay cards that queued on the hub only to post one comment (t_01a1ce48ffc89823).
+    Only a comment: completion, status, links and archive stay with the owner."""
+    import shutil
+    if (owner or "").strip().lower() not in HUB_OWNERS or not shutil.which(HUB_COMMENT):
+        return ""
+    return (f" To add a comment only (no other write), run `{HUB_COMMENT} {task_id} --text '...'` (or "
+            "`--file <path>`) from your card's terminal: it posts on the hub attributed to your card and prints "
+            "the comment id. Do not file a relay card for it.")
 
 
 def replica_path(db_path: Optional[str]) -> Optional[Path]:
diff --git a/tests/hermes_cli/test_kanban_foreign_card_writes.py b/tests/hermes_cli/test_kanban_foreign_card_writes.py
index 6cc4863245..96c9fbc3ef 100644
--- a/tests/hermes_cli/test_kanban_foreign_card_writes.py
+++ b/tests/hermes_cli/test_kanban_foreign_card_writes.py
@@ -92,6 +92,40 @@ def test_tool_comment_names_owner(synced):
     assert OWNER_TEXT in out["error"]
 
 
+def _hub_comment_on_path(tmp_path, monkeypatch):
+    bindir = tmp_path / "hub-comment-bin"
+    bindir.mkdir()
+    helper = bindir / "hub-comment"
+    helper.write_text("#!/bin/sh\nexit 0\n")
+    helper.chmod(0o755)
+    monkeypatch.setenv("PATH", f"{bindir}:/usr/bin:/bin")
+
+
+def test_tool_comment_on_hub_card_names_the_hub_comment_route(home, monkeypatch, tmp_path):
+    """t_01a1ce48ffc89823: workers that hit foreign_card filed relay cards that queued on the hub just to post one
+    comment. On a machine with the hub-comment helper, the refusal names it (comment only)."""
+    from tools import kanban_tools as kt
+    tid = replica_card(home, owner="hub")
+    monkeypatch.setattr(sync, "sync_config", lambda: {"enabled": True, "boards": ["default"]})
+    _hub_comment_on_path(tmp_path, monkeypatch)
+    out = json.loads(kt._handle_comment({"task_id": tid, "body": "hello"}))
+    assert out.get("rejection") == "foreign_card", out
+    assert "was created on hub and lives there" in out["error"]
+    assert f"run `hub-comment {tid} --text '...'`" in out["error"]
+    assert "comment only (no other write)" in out["error"]
+
+
+def test_hub_comment_route_only_for_hub_cards_with_the_helper(home, monkeypatch, tmp_path):
+    from hermes_cli import kanban_foreign_card as kfc
+    monkeypatch.setenv("PATH", "/usr/bin:/bin")
+    assert "hub-comment" not in kfc.message("t_x", "hub")  # no helper on this machine
+    _hub_comment_on_path(tmp_path, monkeypatch)
+    assert "hub-comment t_x" in kfc.message("t_x", "hub")
+    assert "hub-comment t_x" in kfc.message("t_x", "hermes-hub")
+    for owner in ("worker-1", None, "macbook"):  # the helper only reaches hub-owned cards
+        assert "hub-comment" not in kfc.message("t_x", owner)
+
+
 def test_cli_complete_names_owner(synced, capsys):
     assert cli("complete", synced, "--summary", "done") == 1
     err = capsys.readouterr().err
-- 
