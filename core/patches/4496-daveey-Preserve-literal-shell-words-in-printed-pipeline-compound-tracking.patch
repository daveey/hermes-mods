+        tags = list(re.finditer(marker + r"([0-5])" + marker, token))
+        quoted = any(match[1] == "5" for match in tags)
+        token = re.sub(marker + r"([0-5])" + marker,
+                       lambda m: "" if m[1] == "5" else m[0], token)
         match = pattern.match(token)
