From: daveey <daveey@users.noreply.github.com>
Date: Thu, 22 Oct 2026 21:51:54 -0700
Subject: [PATCH] fix(sidebar): sessions shepherding cards on another gateway
 count them via the hermes-hub replica [daveey]

A session that owns work running on another gateway (hermes-hub create-task origin, a shepherd request,
cross_task read/comment) painted green: kanban_session_activity read only local boards. Read the hermes-hub
replica (hub.db, read-only, missing/corrupt = no-op) and count remote cards whose sessions link names this
gateway (rel shepherd), plus their children, into kanban_active / kanban_blocked.
---
 hermes_cli/kanban_session_activity.py         | 110 ++++++++++++++++++
 .../test_kanban_session_activity.py           | 106 +++++++++++++++++
 2 files changed, 216 insertions(+)

diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index 2206338564..5066a20bf0 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -14,7 +14,9 @@ seconds because the sidebar polls.
 
 from __future__ import annotations
 
+import json
 import logging
+import os
 import sqlite3
 import threading
 import time
@@ -133,6 +135,105 @@ def _read_unseen(path: Path) -> dict[str, int]:
     return {str(sid): int(n) for sid, n in rows}
 
 
+# [daveey] Cards on ANOTHER gateway. A session here can own work that runs elsewhere (``hermes-hub create-task``,
+# a ``shepherd`` request, ``cross_task`` read/comment): the owner publishes it as a ``sessions`` link
+# ``{session, gw: <this gateway>, rel: "shepherd"}`` on the card, and hermes-hub keeps a local replica of every
+# gateway's cards in ``hub.db``. Those cards (and their children, transitively) count for the session too, so it
+# doesn't paint green while its remote work runs. Read-only; no replica = no-op.
+def _hub_db_path() -> Path | None:
+    base = os.environ.get("HERMES_HUB_STATE") or str(Path.home() / ".local" / "state" / "hermes-hub")
+    path = Path(base) / "hub.db"
+    return path if path.is_file() else None
+
+
+def _open_ro(path: Path) -> sqlite3.Connection:
+    """Read-only open that survives a WAL db whose -wal/-shm were just removed (plain ``mode=ro`` then fails);
+    never creates the file."""
+    try:
+        conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=0.5)
+        conn.execute("SELECT 1 FROM sqlite_master LIMIT 1")
+        return conn
+    except sqlite3.OperationalError:
+        conn = sqlite3.connect(f"file:{path}?mode=rw", uri=True, timeout=0.5)
+        conn.execute("PRAGMA query_only = ON")
+        return conn
+
+
+def _self_gateway(conn: sqlite3.Connection) -> str:
+    try:
+        row = conn.execute("SELECT v FROM meta WHERE k = 'gateway'").fetchone()
+        if row and row[0]:
+            return str(row[0])
+    except sqlite3.Error:
+        pass
+    try:
+        cfg = Path(os.environ.get("HERMES_MAIL_CONFIG") or Path.home() / ".config" / "hermes-mail" / "config.json")
+        return str(json.loads(cfg.read_text()).get("gateway") or "")
+    except (OSError, ValueError, AttributeError):
+        return ""
+
+
+def _replica_bucket(task: dict[str, Any]) -> str | None:
+    """'active' | 'blocked' | None, by the same rules as ``_status_filter`` for local boards."""
+    status, kind = task.get("status"), task.get("block_kind")
+    human = kind is None or kind in HUMAN_BLOCK_KINDS
+    if status in ACTIVE_STATUSES or (status == "blocked" and not human):
+        return "active"
+    if (status == "blocked" and human) or (status == "triage" and kind in HUMAN_BLOCK_KINDS):
+        return "blocked"
+    return None
+
+
+def _read_hub_replica(path: Path) -> tuple[dict[str, int], dict[str, int]]:
+    """``(active, blocked)`` per local session from replica cards whose ``sessions`` link names this gateway,
+    plus their children (walked transitively on the same gateway and board)."""
+    conn = _open_ro(path)
+    try:
+        me = _self_gateway(conn)
+        if not me:
+            return {}, {}
+        rows = conn.execute("SELECT gw, data FROM replica WHERE coll = 'tasks' AND gw != ?", (me,)).fetchall()
+    finally:
+        conn.close()
+    tasks: dict[tuple[str, str, str], dict[str, Any]] = {}
+    for gw, data in rows:
+        try:
+            t = json.loads(data)
+        except (TypeError, ValueError):
+            continue
+        if isinstance(t, dict) and t.get("id"):
+            tasks[(str(gw), str(t.get("board") or "default"), str(t["id"]))] = t
+    pairs: dict[str, set[tuple[str, str]]] = {"active": set(), "blocked": set()}
+    for (gw, board, tid), t in tasks.items():
+        links = t.get("sessions") if isinstance(t.get("sessions"), list) else []
+        sids = {str(l["session"]) for l in links if isinstance(l, dict) and l.get("session") and l.get("gw") == me}
+        if not sids:
+            continue
+        seen: set[str] = set()
+        todo = [tid]
+        while todo:
+            cur = todo.pop()
+            if cur in seen:
+                continue
+            seen.add(cur)
+            card = tasks.get((gw, board, cur))
+            if card is None:
+                continue
+            bucket = _replica_bucket(card)
+            if bucket:
+                ref = f"{gw}/{board}/{cur}"
+                pairs[bucket].update((sid, ref) for sid in sids)
+            kids = card.get("children") if isinstance(card.get("children"), list) else []
+            todo.extend(str(k) for k in kids if k)
+    out: list[dict[str, int]] = []
+    for bucket in ("active", "blocked"):
+        counts: dict[str, int] = {}
+        for sid, _ref in pairs[bucket]:
+            counts[sid] = counts.get(sid, 0) + 1
+        out.append(counts)
+    return out[0], out[1]
+
+
 def _all_counts() -> tuple[dict[str, int], dict[str, int], dict[str, int]]:
     """``(active, blocked, unseen)`` per-session task counts across every board, cached."""
     global _cache
@@ -155,6 +256,15 @@ def _all_counts() -> tuple[dict[str, int], dict[str, int], dict[str, int]]:
                     into[sid] = into.get(sid, 0) + n
             except sqlite3.Error as exc:  # an old schema without session_id, a locked file
                 _log.debug("kanban activity read failed for %s: %s", path, exc)
+    try:
+        hub = _hub_db_path()
+        if hub is not None:
+            r_active, r_blocked = _read_hub_replica(hub)
+            for src, into in ((r_active, active), (r_blocked, blocked)):
+                for sid, n in src.items():
+                    into[sid] = into.get(sid, 0) + n
+    except Exception as exc:  # a corrupt/locked replica must never break the sidebar
+        _log.debug("hermes-hub replica read failed: %s", exc)
     with _cache_lock:
         _cache = (now + _CACHE_TTL_S, active, blocked, unseen)
     return active, blocked, unseen
diff --git a/tests/hermes_cli/test_kanban_session_activity.py b/tests/hermes_cli/test_kanban_session_activity.py
index 1b326a5413..77cef5f97e 100644
--- a/tests/hermes_cli/test_kanban_session_activity.py
+++ b/tests/hermes_cli/test_kanban_session_activity.py
@@ -20,6 +20,7 @@ def _make_board(path: Path, rows: list[tuple[str, str, str | None]]) -> None:
 @pytest.fixture
 def kanban_root(tmp_path, monkeypatch):
     monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_HUB_STATE", str(tmp_path / "hub-state"))  # never the real hermes-hub replica
     ksa._reset_cache_for_tests()
     yield tmp_path
     ksa._reset_cache_for_tests()
@@ -207,3 +208,108 @@ def test_kanban_unseen_counts_subscriptions_trailing_a_terminal_event(kanban_roo
     ksa.annotate_kanban_activity(rows)
     assert rows[0]["kanban_unseen"] == 1
     assert all("kanban_unseen" not in r for r in rows[1:])
+
+
+# --- cards on ANOTHER gateway, seen through the hermes-hub replica (hub.db) [daveey] ---
+
+import json as _json
+
+
+def _make_replica(state_dir: Path, me: str, tasks: list[dict]) -> Path:
+    state_dir.mkdir(parents=True, exist_ok=True)
+    path = state_dir / "hub.db"
+    conn = sqlite3.connect(path)
+    conn.executescript(
+        "CREATE TABLE meta (k TEXT PRIMARY KEY, v TEXT);"
+        "CREATE TABLE replica (gw TEXT, coll TEXT, key TEXT, version INTEGER, seq INTEGER, data TEXT,"
+        " updated_at INTEGER, PRIMARY KEY (gw, coll, key));"
+    )
+    conn.execute("INSERT INTO meta VALUES ('gateway', ?)", (me,))
+    for t in tasks:
+        gw = t.pop("_gw")
+        data = {"board": "default", "children": [], "parents": [], "sessions": [], "block_kind": None, **t}
+        conn.execute("INSERT INTO replica VALUES (?, 'tasks', ?, 1, 1, ?, 0)",
+                     (gw, f"{data['board']}/{data['id']}", _json.dumps(data, sort_keys=True)))
+    conn.commit()
+    conn.close()
+    return path
+
+
+def _shep(session, gw="macbook"):
+    return {"session": session, "profile": "default", "gw": gw, "rel": "shepherd"}
+
+
+def test_replica_card_shepherded_by_a_local_session_keeps_it_busy(kanban_root):
+    _make_replica(kanban_root / "hub-state", "macbook", [
+        {"_gw": "hub", "id": "t_r1", "status": "running", "children": ["t_r2"], "sessions": [
+            {"session": "hub_oneshot", "profile": None, "rel": "created"}, _shep("s_mac")]},
+        {"_gw": "hub", "id": "t_r2", "status": "todo", "children": ["t_r3"]},  # child: counts via children
+        {"_gw": "hub", "id": "t_r3", "status": "blocked", "block_kind": "needs_input"},  # grandchild waits on a human
+        {"_gw": "hub", "id": "t_r4", "status": "done", "sessions": [_shep("s_mac")]},
+    ])
+    rows = [{"id": "s_mac"}, {"id": "hub_oneshot"}]
+    ksa.annotate_kanban_activity(rows)
+    assert rows[0]["kanban_active"] == 2
+    assert rows[0]["kanban_blocked"] == 1
+    assert "kanban_active" not in rows[1]  # a session on the owning gateway is not ours
+
+
+def test_replica_link_for_another_gateway_does_not_count(kanban_root):
+    _make_replica(kanban_root / "hub-state", "macbook", [
+        {"_gw": "hub", "id": "t_r1", "status": "running", "sessions": [_shep("s_mac", gw="mini")]},
+        {"_gw": "mini", "id": "t_r2", "status": "running", "sessions": [{"session": "s_mac", "rel": "created"}]},
+        # our own published records in the replica are already counted from the local boards
+        {"_gw": "macbook", "id": "t_r3", "status": "running", "sessions": [_shep("s_mac")]},
+    ])
+    rows = [{"id": "s_mac"}]
+    ksa.annotate_kanban_activity(rows)
+    assert "kanban_active" not in rows[0]
+
+
+def test_replica_counts_add_to_local_boards_and_follow_lineage(kanban_root):
+    _make_board(kanban_root / "kanban.db", [("t1", "running", "s_root")])
+    _make_replica(kanban_root / "hub-state", "macbook", [
+        {"_gw": "hub", "id": "t_r1", "status": "ready", "sessions": [_shep("s_root")]},
+        {"_gw": "hub", "id": "t_r2", "status": "blocked", "block_kind": "transient", "sessions": [_shep("s_tip")]},
+    ])
+    rows = [{"id": "s_tip", "_lineage_root_id": "s_root", "_lineage_ids": ["s_root", "s_tip"]}]
+    ksa.annotate_kanban_activity(rows)
+    assert rows[0]["kanban_active"] == 3
+    assert "kanban_blocked" not in rows[0]
+
+
+def test_missing_or_corrupt_replica_is_harmless(kanban_root):
+    _make_board(kanban_root / "kanban.db", [("t1", "running", "s1")])
+    rows = [{"id": "s1"}]
+    ksa.annotate_kanban_activity(rows)  # no hub-state dir at all
+    assert rows[0]["kanban_active"] == 1
+    assert not (kanban_root / "hub-state" / "hub.db").exists()  # the read never creates the file
+    (kanban_root / "hub-state").mkdir()
+    (kanban_root / "hub-state" / "hub.db").write_bytes(b"not a database" * 100)
+    ksa._reset_cache_for_tests()
+    rows = [{"id": "s1"}]
+    ksa.annotate_kanban_activity(rows)
+    assert rows[0]["kanban_active"] == 1
+    # a replica row with junk data is skipped, not fatal
+    (kanban_root / "hub-state" / "hub.db").unlink()
+    path = _make_replica(kanban_root / "hub-state", "macbook", [
+        {"_gw": "hub", "id": "t_ok", "status": "running", "sessions": [_shep("s1")]}])
+    conn = sqlite3.connect(path)
+    conn.execute("INSERT INTO replica VALUES ('hub', 'tasks', 'default/t_bad', 1, 1, '{not json', 0)")
+    conn.commit()
+    conn.close()
+    ksa._reset_cache_for_tests()
+    rows = [{"id": "s1"}]
+    ksa.annotate_kanban_activity(rows)
+    assert rows[0]["kanban_active"] == 2
+
+
+def test_hub_platform_subscription_on_a_local_board_is_not_a_tui_shepherd(kanban_root):
+    """The owning gateway stores a remote shepherd as platform 'hub'; its own sidebar must not count it."""
+    _make_board(kanban_root / "kanban.db", [("t1", "running", None)])
+    conn = sqlite3.connect(kanban_root / "kanban.db")
+    conn.execute("CREATE TABLE kanban_notify_subs (task_id TEXT, platform TEXT, chat_id TEXT)")
+    conn.execute("INSERT INTO kanban_notify_subs VALUES ('t1', 'hub', 'macbook/default/s_mac')")
+    conn.commit()
+    conn.close()
+    assert ksa.active_task_counts() == {}
