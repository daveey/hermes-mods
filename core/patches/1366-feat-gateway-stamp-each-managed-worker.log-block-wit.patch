From f06cd838bbc011077126869abec62251a1d0d0f9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 00:36:54 +0000
Subject: [PATCH] feat(gateway): stamp each managed-worker.log block with UTC
 time and core sha [daveey]

drain_worker_stderr now writes one header line, '[pid N] @ <ISO8601 UTC> core=<short sha>',
before a worker's first stderr line. The sha is the gateway's boot revision (code_skew
snapshot; read from checkout files at most once per process, never git). Other lines keep the
plain '[pid N] ' prefix so existing parsers are unaffected.

Why: crash storms in managed-worker.log could not be dated against the deploy that fixed them
(coach stamped them with its own pass time).
---
 gateway/session_managed_worker_log.py         | 35 ++++++++++++++++++-
 .../gateway/test_managed_worker_stderr_log.py | 24 +++++++++++++
 2 files changed, 58 insertions(+), 1 deletion(-)

diff --git a/gateway/session_managed_worker_log.py b/gateway/session_managed_worker_log.py
index 7fe389e95de..19848ac2165 100644
--- a/gateway/session_managed_worker_log.py
+++ b/gateway/session_managed_worker_log.py
@@ -5,6 +5,10 @@ provider error echoes and tool prints land in this stream. The owner drains it o
 thread (an undrained pipe would block the child), redacts every line before it touches disk,
 and keeps ``<home>/logs/managed-worker.log`` private (0600) and capped at
 ``MAX_LOG_BYTES`` plus one rotated copy.
+
+Before a worker's first line the drain writes one header, ``[pid N] @ <ISO8601 UTC> core=<sha>``,
+so a crash block can be dated and matched to the core revision that produced it. Every other line
+keeps the plain ``[pid N] `` prefix.
 """
 import logging
 import os
@@ -20,6 +24,30 @@ MAX_LINE_BYTES = 64 * 1024
 KEPT_LINE_CHARS = 4096
 _locks = {}
 _locks_guard = threading.Lock()
+_core_sha = None
+
+
+def _core_short_sha():
+    """The revision the gateway booted on (``code_skew``'s snapshot, short form). Read from the
+    checkout files at most once per process when no snapshot exists; never runs git."""
+    global _core_sha
+    try:
+        from gateway import code_skew
+        fingerprint = code_skew._boot_fingerprint
+        if fingerprint:
+            return code_skew._short(fingerprint)
+        if _core_sha is None:
+            fingerprint = code_skew._process_boot_fingerprint() or code_skew._fingerprint()
+            _core_sha = code_skew._short(fingerprint) if fingerprint else 'unknown'
+        return _core_sha
+    except (ImportError, AttributeError, OSError, ValueError):  # an older tree, or an unreadable checkout
+        return 'unknown'
+
+
+def _header(pid):
+    from datetime import UTC, datetime
+    stamp = datetime.now(UTC).strftime('%Y-%m-%dT%H:%M:%SZ')
+    return f'[pid {pid}] @ {stamp} core={_core_short_sha()}\n'
 
 
 def worker_log_path(profile_id):
@@ -66,6 +94,7 @@ def drain_worker_stderr(stream, path, pid, scrub):
     (launch key, assignment secret) known so far. Never stops reading on a write failure."""
     skipping = False
     warned = False
+    header = True
     try:
         while True:
             chunk = stream.readline(MAX_LINE_BYTES)
@@ -78,7 +107,11 @@ def drain_worker_stderr(stream, path, pid, scrub):
             skipping = not whole
             try:
                 line = _redact(chunk.decode('utf-8', 'replace'), scrub)
-                _append(path, f'[pid {pid}] ' + (line if whole else line[:KEPT_LINE_CHARS] + ' [truncated]\n'))
+                text = f'[pid {pid}] ' + (line if whole else line[:KEPT_LINE_CHARS] + ' [truncated]\n')
+                if header:
+                    header = False
+                    text = _header(pid) + text
+                _append(path, text)
             except (OSError, ValueError) as exc:
                 # Keep draining regardless: a child blocked on a full stderr pipe would wedge.
                 if not warned:
diff --git a/tests/gateway/test_managed_worker_stderr_log.py b/tests/gateway/test_managed_worker_stderr_log.py
index 3e3f2015143..8ecc3cff2aa 100644
--- a/tests/gateway/test_managed_worker_stderr_log.py
+++ b/tests/gateway/test_managed_worker_stderr_log.py
@@ -52,3 +52,27 @@ def test_worker_log_is_bounded_and_scrubs_the_workers_exact_secrets(tmp_path):
     assert not list(path.parent.glob(LOG_NAME + '.2'))
     text = ''.join(f.read_text() for f in files)
     assert assignment not in text and '[truncated]' in text and text.endswith('[pid 7] last\n')
+
+
+def test_each_worker_block_starts_with_one_utc_and_core_sha_header(tmp_path, monkeypatch):
+    """The first line a worker writes is preceded by ``[pid N] @ <ISO8601 UTC> core=<sha>`` (once
+    per pid), so crash storms in the log can be dated against deploys; other lines are unchanged."""
+    import re
+    from datetime import UTC, datetime
+    from gateway import code_skew
+    from gateway.session_managed_worker_log import LOG_NAME, drain_worker_stderr
+    monkeypatch.setattr(code_skew, '_boot_fingerprint', 'git:refs/heads/main:' + 'abcdef1234' + '0' * 30)
+    path = tmp_path / 'logs' / LOG_NAME
+    before = datetime.now(UTC).replace(microsecond=0)
+    drain_worker_stderr(io.BytesIO(b'Traceback\nboom\n'), path, 11, list)
+    drain_worker_stderr(io.BytesIO(b'other\n'), path, 12, list)
+    lines = path.read_text().splitlines()
+    header = re.compile(r'^\[pid (\d+)\] @ (\S+) core=(\S+)$')
+    heads = [header.match(line) for line in lines if header.match(line)]
+    assert [m.group(1) for m in heads] == ['11', '12']
+    for m in heads:
+        stamp = datetime.fromisoformat(m.group(2))
+        assert stamp.tzinfo is not None and stamp.utcoffset().total_seconds() == 0
+        assert before <= stamp <= datetime.now(UTC)
+        assert m.group(3) == 'abcdef1234'
+    assert lines == [lines[0], '[pid 11] Traceback', '[pid 11] boom', lines[3], '[pid 12] other']
