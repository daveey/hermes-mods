From 5417a9eae1dcfb72c64590f4995092b768c4456b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 5 Nov 2026 05:32:08 +0000
Subject: [PATCH] test(kanban): await an executable recovery tick [daveey]
 (#876)

---
 tests/gateway/fixtures/kanban_owner_probe.py | 19 +++++++++++++++++--
 tests/gateway/test_session_kanban.py         |  4 ++++
 2 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/tests/gateway/fixtures/kanban_owner_probe.py b/tests/gateway/fixtures/kanban_owner_probe.py
index dcb2c89e64f..897c97ae7f4 100644
--- a/tests/gateway/fixtures/kanban_owner_probe.py
+++ b/tests/gateway/fixtures/kanban_owner_probe.py
@@ -68,7 +68,8 @@ def main():
     peer = ThreadingHTTPServer(('127.0.0.1', 0), Model)
     peer.requests = []
     contended = os.environ.get('KANBAN_PROBE_MODE') == 'timeout_contended'
-    peer.mode = 'timeout' if contended else os.environ.get('KANBAN_PROBE_MODE', 'complete')
+    crash_contended = os.environ.get('KANBAN_PROBE_MODE') == 'crash_contended'
+    peer.mode = 'crash' if crash_contended else ('timeout' if contended else os.environ.get('KANBAN_PROBE_MODE', 'complete'))
     peer.blocked, peer.release = threading.Event(), threading.Event()
     threading.Thread(target=peer.serve_forever, daemon=True).start()
     url = f'http://127.0.0.1:{peer.server_port}/v1'
@@ -179,7 +180,21 @@ def main():
                     dispatch.reap_worker_zombies()
                     receipt['client_exit'] = dispatch._classify_worker_exit(clients[0].pid)
                     dispatch._recent_worker_exits.clear()
-                    swept = dispatch.dispatch_once(conn, board='owned', max_spawn=0)
+                    from hermes_cli.kanban_db_connect import _dispatch_tick_lock
+                    # A connection opener can be descheduled while holding this lock.
+                    with _dispatch_tick_lock(kb.kanban_db_path(board='owned')) if crash_contended else nullcontext():
+                        swept = dispatch.dispatch_once(conn, board='owned', max_spawn=0)
+                    if crash_contended:
+                        assert swept.skipped_locked, swept
+                        receipt['first_sweep_deferred'] = True
+                    def sweep_when_unlocked():
+                        nonlocal swept
+                        # A refused tick did no recovery. Retry only that refusal,
+                        # never an admitted tick with the wrong lifecycle outcome.
+                        if swept.skipped_locked:
+                            swept = dispatch.dispatch_once(conn, board='owned', max_spawn=0)
+                        return None if swept.skipped_locked else swept
+                    swept = wait_until(sweep_when_unlocked, timeout=60, what='dispatcher recovery tick lock')
                     task = kb.get_task(conn, tid)
                     run = dict(conn.execute('SELECT * FROM task_runs WHERE id=?', (params['run_id'],)).fetchone())
                     from gateway.session_kanban import worker_exit_code
diff --git a/tests/gateway/test_session_kanban.py b/tests/gateway/test_session_kanban.py
index 6fcc78367a7..13853efe54a 100644
--- a/tests/gateway/test_session_kanban.py
+++ b/tests/gateway/test_session_kanban.py
@@ -59,6 +59,7 @@ def test_claim_freezes_task_policy_and_rejects_forgery(tmp_path, monkeypatch):
 
 
 @pytest.mark.parametrize('mode', ['complete', 'timeout', 'rate_limit', 'billing', 'crash',
+    pytest.param('crash_contended', marks=pytest.mark.platforms('posix')),
     pytest.param('timeout_contended', marks=pytest.mark.platforms('posix'))])
 def test_real_dispatcher_lifecycle(tmp_path, mode):
     import os
@@ -73,6 +74,9 @@ def test_real_dispatcher_lifecycle(tmp_path, mode):
     assert result.returncode == 0, result.stdout + result.stderr
     receipt = json.loads((tmp_path / 'state' / 'receipt.json').read_text())
     print(json.dumps(receipt))
+    if mode == 'crash_contended':
+        assert receipt['first_sweep_deferred']
+        assert receipt['run_outcome'] == 'crashed' and receipt['failures'] == 1
     if mode == 'timeout_contended':
         assert receipt['initial_claim_deferred']
         assert receipt['run_outcome'] == 'timed_out' and receipt['failures'] == 1
-- 
