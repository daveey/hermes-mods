From df1f0f4df0d545ba9ca8ccaa867578d88200a37b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 24 Oct 2026 05:59:42 +0000
Subject: [PATCH] fix(desktop): include active kanban count in automated rows
 [daveey]

---
 apps/desktop/src/store/sidebar-automated.test.ts | 7 +++++++
 apps/desktop/src/store/sidebar-automated.ts      | 1 +
 2 files changed, 8 insertions(+)

diff --git a/apps/desktop/src/store/sidebar-automated.test.ts b/apps/desktop/src/store/sidebar-automated.test.ts
index 1ca8432f3f..60bd45f27b 100644
--- a/apps/desktop/src/store/sidebar-automated.test.ts
+++ b/apps/desktop/src/store/sidebar-automated.test.ts
@@ -48,6 +48,13 @@ describe('sessionHiddenAsAutomated [daveey]', () => {
     expect(sessionHiddenAsAutomated(bot, false, { dotState: 'idle' })).toBe(false)
   })
 
+  it('hides automated rows waiting on cards unless they need human attention', () => {
+    expect(sessionHiddenAsAutomated({ ...bot, kanban_active: 1 }, false, { dotState: 'idle' })).toBe(true)
+    expect(sessionHiddenAsAutomated({ ...bot, kanban_active: 1, kanban_blocked: 1 }, false, { dotState: 'idle' })).toBe(false)
+    expect(sessionHiddenAsAutomated({ ...bot, kanban_active: 0 }, false, { dotState: 'idle' })).toBe(true)
+    expect(sessionHiddenAsAutomated(bot, false, { dotState: 'idle' })).toBe(true)
+  })
+
   it('still hides a working or finished automated row', () => {
     expect(sessionHiddenAsAutomated(bot, false, { dotState: 'working' })).toBe(true)
     expect(sessionHiddenAsAutomated(bot, false, { dotState: 'unread' })).toBe(true)
diff --git a/apps/desktop/src/store/sidebar-automated.ts b/apps/desktop/src/store/sidebar-automated.ts
index 31ee01f5f3..3d4b0dc536 100644
--- a/apps/desktop/src/store/sidebar-automated.ts
+++ b/apps/desktop/src/store/sidebar-automated.ts
@@ -23,6 +23,7 @@ type AutomatedRow = Pick<
   | 'automated'
   | 'cron_active'
   | 'id'
+  | 'kanban_active'
   | 'kanban_attention'
   | 'kanban_blocked'
   | 'message_count'
-- 
2.55.0

