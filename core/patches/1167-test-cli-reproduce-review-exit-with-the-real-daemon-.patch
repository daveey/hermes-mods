From 5a16137f9e94d6173e01a82b2b4cb828b2b234f2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 08:00:03 +0000
Subject: [PATCH] test(cli): reproduce review exit with the real daemon tool
 pool [daveey]

Warm DaemonThreadPoolExecutor before shutdown, as a session which already ran tools does. The old lazy stdlib import reproduced only the atexit registration variant. With pre-6b890a10bbc CLI cleanup this now fails with the exact cannot schedule new futures after interpreter shutdown message; current cleanup cancels the fork before dispatch. Ten targeted tests pass; independent read-only review found no correctness issues.
---
 .../hermes_cli/test_cli_exit_cancels_background_review.py | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_cli_exit_cancels_background_review.py b/tests/hermes_cli/test_cli_exit_cancels_background_review.py
index 2958e2cd65d..54b40213905 100644
--- a/tests/hermes_cli/test_cli_exit_cancels_background_review.py
+++ b/tests/hermes_cli/test_cli_exit_cancels_background_review.py
@@ -26,8 +26,12 @@ REPO = Path(__file__).resolve().parents[2]
 # way the real CLI's MCP and terminal teardown did (4.4 s on the MacBook).
 _SCRIPT = textwrap.dedent(
     """
-    import atexit, concurrent.futures, sys, threading, time
+    import atexit, sys, threading, time
     sys.path.insert(0, {repo!r})
+    # Warm the real tool executor before exit, matching a session that already ran tools.
+    # Its inherited submit then reproduces "cannot schedule new futures", rather than a
+    # lazy concurrent.futures import failing with "can't register atexit after shutdown".
+    from tools.daemon_pool import DaemonThreadPoolExecutor
     import cli
     from agent.background_review import finish_background_review_run, prepare_background_review_run
 
@@ -57,7 +61,7 @@ _SCRIPT = textwrap.dedent(
                 print("REVIEW_STOPPED_BEFORE_TOOLS", flush=True)
                 return
             try:
-                with concurrent.futures.ThreadPoolExecutor(1) as pool:
+                with DaemonThreadPoolExecutor(1) as pool:
                     pool.submit(lambda: None).result()
                 print("TOOL_DISPATCHED", flush=True)
             except RuntimeError as exc:
