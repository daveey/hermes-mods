From 9df5a3ea668eec56d76b8fb91bfc775e8b121f31 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 13:16:02 +0000
Subject: [PATCH] [daveey] Preserve fairness trigger-loss evidence across
 sealing

Proof: 10 regressions failed before fix; 55 focused tests pass; four integrity mutants killed. Persist pre-seal integrity atomically and retain observed drain gaps even with no rows. Legacy seals without receipts remain indeterminate.
---
 docs/kanban-fairness-capture.md               |  6 ++
 hermes_cli/kanban_fairness_journal.py         | 23 ++++-
 .../test_kanban_fairness_journal.py           | 88 ++++++++++++++++++-
 .../test_kanban_fairness_vertical.py          |  2 +-
 4 files changed, 113 insertions(+), 6 deletions(-)

diff --git a/docs/kanban-fairness-capture.md b/docs/kanban-fairness-capture.md
index 86be7a46c7a7d6f4cdd0bea925fac6f77b54e833..4cc8289ec31de9406e760728e204a5be9f263c9a 100644
--- a/docs/kanban-fairness-capture.md
+++ b/docs/kanban-fairness-capture.md
@@ -30,6 +30,12 @@ stored.
 - `capture drain` copies new rows into `segment-NNNNNN.jsonl` files (hashed in `receipts.json`).
   `capture seal` removes the triggers, drains the tail and writes `manifest.json`. `capture clear` drops the
   tables.
+- Drains compare the installed trigger SQL with the expected definitions and persist observed loss even
+  when there are no new rows. Seal checks inside its write transaction before removing triggers and stores
+  that result in the session, so a later drain or repeated seal cannot hide loss. Missing or changed
+  triggers, and legacy seals without an integrity receipt, produce `trigger_loss` coverage gaps.
+  This detects loss observed by drain or seal, not a trigger removed and identically restored entirely
+  between checks; do not repair triggers during a capture or treat such a window as certified.
 
 Which database to arm: a board's own `kanban.db` holds only what that gateway knows. To see every gateway's
 cards from one host, arm the board's replica (`--board default --replica`, the `sync-shadow` copy) and state
diff --git a/hermes_cli/kanban_fairness_journal.py b/hermes_cli/kanban_fairness_journal.py
index 7a42fe63ce91d506c5c4e5b22f175614cbdb44b7..991bdb9529450630fdeb6e87077219f537a6281f 100644
--- a/hermes_cli/kanban_fairness_journal.py
+++ b/hermes_cli/kanban_fairness_journal.py
@@ -104,11 +104,20 @@ def status(conn: sqlite3.Connection) -> Optional[dict]:
         return None
     names = ("capture_id", "armed_ms", "sealed_ms", "max_records", "max_bytes", "stored", "bytes", "dropped",
              "first_drop_ms", "last_drop_ms")
-    installed = {r[0] for r in conn.execute(
-        "SELECT name FROM sqlite_master WHERE type = 'trigger' AND name GLOB 'kanban_fairness_*'")}
+    installed = dict(conn.execute(
+        "SELECT name, sql FROM sqlite_master WHERE type = 'trigger' AND name GLOB 'kanban_fairness_*'"))
+    complete = installed == _triggers(conn)
+    # A seal intentionally removes triggers. Its pre-removal receipt, not current absence,
+    # proves integrity. Older sealed journals without that receipt are unknown, never clean.
+    seal_complete = None
+    columns = {r[1] for r in conn.execute(f"PRAGMA table_info({SESSION})")}
+    if "seal_triggers_complete" in columns:
+        seal_complete = conn.execute(f"SELECT seal_triggers_complete FROM {SESSION} WHERE id = 1").fetchone()[0]
     last = conn.execute(f"SELECT MAX(seq) FROM {JOURNAL}").fetchone()[0]
     return {**dict(zip(names, row)), "last_seq": last or 0, "db": identity(conn),
-            "triggers": sorted(installed), "triggers_complete": installed == set(_triggers(conn))}
+            "triggers": sorted(installed), "triggers_complete": complete,
+            "trigger_integrity": complete if row[2] is None else (
+                seal_complete == 1 if seal_complete in (0, 1) else None)}
 
 
 def arm(conn: sqlite3.Connection, capture_id: str, *, max_records: int = MAX_RECORDS,
@@ -165,7 +174,13 @@ def seal(conn: sqlite3.Connection) -> dict:
     from hermes_cli.kanban_db_connect import write_txn
 
     with write_txn(conn):
-        _open_status(conn)
+        state = _open_status(conn)
+        columns = {r[1] for r in conn.execute(f"PRAGMA table_info({SESSION})")}
+        if "seal_triggers_complete" not in columns:
+            conn.execute(f"ALTER TABLE {SESSION} ADD COLUMN seal_triggers_complete INTEGER")
+        if state["sealed_ms"] is None:
+            conn.execute(f"UPDATE {SESSION} SET seal_triggers_complete = ? WHERE id = 1",
+                         (int(state["triggers_complete"]),))
         conn.execute(f"UPDATE {SESSION} SET sealed_ms = COALESCE(sealed_ms, {_NOW_MS}) WHERE id = 1")
         _drop_triggers(conn)
     return _open_status(conn)
diff --git a/tests/hermes_cli/test_kanban_fairness_journal.py b/tests/hermes_cli/test_kanban_fairness_journal.py
index beae3f0b4cbbe6e22a5d06c51d39cd68a9974785..d7f2c567f140ff3de265280bba6b96025a6d56fd 100644
--- a/tests/hermes_cli/test_kanban_fairness_journal.py
