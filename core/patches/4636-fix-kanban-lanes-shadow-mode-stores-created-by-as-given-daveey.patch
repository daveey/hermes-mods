From d3dfd49b49b71a002ce90914299af1f4e29f0661 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 16:06:29 -0800
Subject: [PATCH] fix(kanban): lanes shadow mode stores created_by as given
 [daveey]

Shadow changes nothing on a card but its lane; the user-label rewrite for agent terminals now applies only
while lanes are enforced.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 hermes_cli/kanban_lanes.py                 |  7 +++++--
 tests/hermes_cli/test_kanban_lanes_plan.py | 10 ++++++++++
 website/docs/user-guide/features/kanban.md |  4 ++--
 3 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_lanes.py b/hermes_cli/kanban_lanes.py
index 97b23295cf136814f655739fe96f0cf6c3f214f5..d664a8e07fd5dcb01d934bef237ce24fb9c9ba72 100644
--- a/hermes_cli/kanban_lanes.py
+++ b/hermes_cli/kanban_lanes.py
@@ -281,8 +281,11 @@ def _human_shell() -> bool:
 def cli_creator(args, label: str) -> str:
     """``created_by`` for a CLI create. ``--created-by`` defaults to ``user`` for every caller and takes any
     string, so the user labels are kept only for a person: a typed slash command or a human shell. Anything
-    else asking for one is stored as ``agent``. Unchanged when no lanes are configured."""
-    if label not in USER_CREATORS or safe_policy() is None:
+    else asking for one is stored as ``agent``. Only while lanes are enforced: with no lanes, or in shadow mode,
+    the label is stored as given, because shadow changes nothing an agent or a reader can observe on a card
+    beyond its lane. (Shadow's ``would_gate`` therefore reads a chat or cron agent's terminal create as the
+    person's; worker shells and tool creates are still recognised by their card.)"""
+    if label not in USER_CREATORS or enforced() is None:
         return label
     return label if cli_person(args) else "agent"
 
diff --git a/tests/hermes_cli/test_kanban_lanes_plan.py b/tests/hermes_cli/test_kanban_lanes_plan.py
index 11d893848fa919f3c6541fe8cc5f7ac03fbc9cea..5fff5c18dbaf7b1eb598d587cd139f134e4a5982 100644
--- a/tests/hermes_cli/test_kanban_lanes_plan.py
+++ b/tests/hermes_cli/test_kanban_lanes_plan.py
@@ -218,6 +218,16 @@ def test_cli_create_label_is_untouched_without_lanes(conn, monkeypatch):
     assert _stored(conn, "no lanes")["created_by"] == "user"
 
 
+def test_shadow_mode_stores_the_label_the_caller_gave(conn, configured, monkeypatch):
+    configured(lane_shadow=True)
+    monkeypatch.setattr(lanes, "_human_shell", lambda: False)  # an agent's terminal
+    assert cli("create", "agent in shadow", "--assignee", "default", "--priority", "900") == 0
+    row = _stored(conn, "agent in shadow")
+    assert (row["created_by"], row["status"], row["priority"]) == ("user", "ready", 900)
+    assert cli("create", "claims dashboard", "--assignee", "default", "--created-by", "dashboard") == 0
+    assert _stored(conn, "claims dashboard")["created_by"] == "dashboard"
+
+
 def _typed(*argv):
     """A slash command the person typed, through the real slash entry point."""
     return kanban.run_slash(" ".join(argv), human_typed=True)
diff --git a/website/docs/user-guide/features/kanban.md b/website/docs/user-guide/features/kanban.md
index 2dbca6eae88f170a59164f6800e90c9b1dd8bd52..6d61f4c98e32b06bb109965238705e1126adfe59 100644
--- a/website/docs/user-guide/features/kanban.md
+++ b/website/docs/user-guide/features/kanban.md
@@ -1573,8 +1573,8 @@ kanban:
 
 - **Classification** happens once, at creation: the user's explicit `tenant`, then a lane whose `match` fits (creator name, idempotency-key prefix, repository directory name, or a declared `self_work`), then a tenant an agent passed (workers pass their own card's), the parent's or the creating card's lane, then `lane_default` with a `lane_unclassified` event. Every decision is a `lane_assigned` event with its source.
 - **Shares are targets, not ceilings.** Under contention each free slot goes to the lane running the fewest cards relative to its `share`; inside a lane the admission score decides. A lane with nothing ready lends its share. Land-turn owners, `urgent`/`capacity` cards and alarm cards go first, in score order, ahead of every lane pick. `paused: true` stops a lane's cards from being dispatched.
-- **The gate.** In a `gated` lane a card filed by another card, or by a `match` creator or key prefix, starts in `triage` with `block_kind = lane_gate` until it is admitted. The user's own cards (a human shell, a slash command the person typed, or the dashboard, with no worker card behind the call), kernel recovery cards, alarm-keyed and `urgent` cards, and `gate_exempt` titles under an admitted creating card are not held. With lanes configured, `hermes kanban create` from an agent's terminal stores `created_by: agent` when it would have stored `user` or `dashboard`. A held card that a runnable (todo, ready, running or review) card of another lane is linked to wait on is admitted at once, outside the budget, unless its title is `never_admit`. While the gate is enforced, the stale-triage sweep, `specify` and `decompose` (the auto-decomposer and `--force` included) leave held cards alone; with lanes removed or in shadow they treat them as ordinary triage, so a rollback strands nothing.
-- **Shadow mode.** `lane_shadow: true` is the step before enforcement: cards are classified and `hermes kanban lanes` reports them, and each `lane_assigned` event records `would_gate`, but the gate, the cap, the lane ordering and `paused` do nothing.
+- **The gate.** In a `gated` lane a card filed by another card, or by a `match` creator or key prefix, starts in `triage` with `block_kind = lane_gate` until it is admitted. The user's own cards (a human shell, a slash command the person typed, or the dashboard, with no worker card behind the call), kernel recovery cards, alarm-keyed and `urgent` cards, and `gate_exempt` titles under an admitted creating card are not held. While lanes are enforced (not in shadow mode), `hermes kanban create` from an agent's terminal stores `created_by: agent` when it would have stored `user` or `dashboard`. A held card that a runnable (todo, ready, running or review) card of another lane is linked to wait on is admitted at once, outside the budget, unless its title is `never_admit`. While the gate is enforced, the stale-triage sweep, `specify` and `decompose` (the auto-decomposer and `--force` included) leave held cards alone; with lanes removed or in shadow they treat them as ordinary triage, so a rollback strands nothing.
+- **Shadow mode.** `lane_shadow: true` is the step before enforcement: cards are classified and `hermes kanban lanes` reports them, and each `lane_assigned` event records `would_gate`, but the gate, the cap, the lane ordering and `paused` do nothing, and `created_by` is stored as given. The only change to a card is its `tenant`.
 - **Priority cap.** `agent_priority_cap` bounds the stored priority of a card the user did not create, at creation. Later edits are not capped, and the planner may set 0 to 1000.
 - **Limits.** Worker nodes order foreign pickup with their own board copy, so lane order is exact only on the board that holds the cards; `paused` applies where `lanes` is configured. A worker that parks on a held follow-up card waits until that card is admitted.
 
