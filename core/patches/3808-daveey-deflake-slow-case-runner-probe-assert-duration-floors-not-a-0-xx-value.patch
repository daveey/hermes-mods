From 6ce7bb80d79728c0f9243af0e798fb0e0da38b99 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:26:04 +0000
Subject: [PATCH] [daveey] deflake slow-case runner probe: assert duration
 floors, not a 0.xx value
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

test_runner_prints_the_slow_case_line asserted the printed duration started
with "0." and that exactly one case crossed the 0.4 s threshold. On a
CPU-throttled CI slice the probe's 0.6 s sleep measured 1.75 s (run
43485802960), and `test_fast` can cross 0.4 s there too.

Only lower bounds hold under starvation, so the probe now checks the line
shape (`⏱ slow test case <s.ss>s <node id>`), that test_sleeps is reported at
>= 0.6 s, and that every reported case is at or above the threshold. Which
cases fall under the threshold stays pinned deterministically by
test_slow_cases_sum_phases_and_keep_only_cases_over_the_threshold.

Repro: SIGSTOP/SIGCONT duty cycle (1.5 s off / 0.1 s on) on the runner and
its fork-server pytest child: old test 0/4 (slow case 1.52-1.62s), new 4/4.
---
 .../test_run_tests_parallel_slow_cases.py       | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/tests/scripts/test_run_tests_parallel_slow_cases.py b/tests/scripts/test_run_tests_parallel_slow_cases.py
index ad9d550a37..9471e067be 100644
--- a/tests/scripts/test_run_tests_parallel_slow_cases.py
+++ b/tests/scripts/test_run_tests_parallel_slow_cases.py
@@ -7,6 +7,7 @@ whether a PR's own added test case is slow (>= 10 s) before it attributes a wall
 from __future__ import annotations
 
 import importlib.util
+import re
 import shutil
 import subprocess
 import sys
@@ -83,7 +84,15 @@ def test_runner_prints_the_slow_case_line(tmp_path, monkeypatch):
         timeout=120, check=False, env={**__import__("os").environ, "HERMES_TEST_SLOW_CASE_S": "0.4"},
     )
     assert proc.returncode == 0, proc.stdout
-    lines = [ln for ln in proc.stdout.splitlines() if "⏱ slow test case" in ln]
-    assert len(lines) == 1, proc.stdout
-    assert lines[0].strip().startswith("⏱ slow test case 0.")
-    assert lines[0].endswith("test_probe_slow.py::test_sleeps"), lines[0]
+    # Only lower bounds hold on a CPU-starved runner: the 0.6 s sleep is a floor (a throttled slice measured it
+    # at 1.75 s), and even ``test_fast`` may cross 0.4 s there. Which cases fall under the threshold is pinned
+    # by the parser unit test above, so this probe checks the printed line's shape and the threshold floor.
+    cases: dict[str, float] = {}
+    for ln in proc.stdout.splitlines():
+        if "⏱ slow test case" in ln:
+            m = re.fullmatch(r"\s*⏱ slow test case (\d+\.\d\d)s (\S+)", ln)
+            assert m, ln
+            cases[m.group(2).rsplit("::", 1)[-1]] = float(m.group(1))
+    assert set(cases) <= {"test_sleeps", "test_fast"}, proc.stdout
+    assert cases.get("test_sleeps", 0.0) >= 0.6, proc.stdout
+    assert all(secs >= 0.4 for secs in cases.values()), proc.stdout
-- 
