From 6aa8426978bdc7f0a3f0c5cb40696e8630be00ac Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 27 Nov 2026 14:18:47 +0000
Subject: [PATCH 6928] Replay sender: durable single-slot journal, deferred observation and bounded recovery (dormant)

Public mirror of source commit 6aa8426978bdc7f0a3f0c5cb40696e8630be00ac.

---
diff --git a/tests/hermes_cli/test_kanban_legacy_direct_push.py b/tests/hermes_cli/test_kanban_legacy_direct_push.py
index 4cacf5adc7d1aa54dc06f771b3cd70b126476bc8..adfc4efc3dcbb083526450cf41a14dbb81ed44e5 100644
--- a/tests/hermes_cli/test_kanban_legacy_direct_push.py
+++ b/tests/hermes_cli/test_kanban_legacy_direct_push.py
@@ -58,7 +58,7 @@
         except RuntimeError as exc:
             outcome = f'{type(exc).__name__}: {exc}'
         print('DIRECT_OUTCOME', outcome)
-        with open(str(tmp_path / 'outcome.txt'), 'w') as fh:
+        with open(str(tmp_path / 'outcome.txt'), 'w', encoding='utf-8') as fh:
             fh.write(outcome)
     finally:
         release.set()
diff --git a/tests/hermes_cli/test_kanban_replay_hard_death.py b/tests/hermes_cli/test_kanban_replay_hard_death.py
index 054d4ec3e982f5ce7f93a39d50c09abc52b3bd2e..797499cbc9f39a553f9f63c4ef2e0ae323f216f1 100644
--- a/tests/hermes_cli/test_kanban_replay_hard_death.py
+++ b/tests/hermes_cli/test_kanban_replay_hard_death.py
@@ -108,7 +108,7 @@
             assert peer.receiver.slot['h'] == peer.receiver.slot['a'] == '1'
         proc.kill()
         proc.join(10)
-        assert proc.exitcode == -signal.SIGKILL
+        assert proc.exitcode == -getattr(signal, "SIGKILL", signal.SIGTERM)
         peer.stage = None
         peer.release.set()
         reopened = kbc.connect(path)
diff --git a/tests/hermes_cli/test_kanban_replay_storage_faults.py b/tests/hermes_cli/test_kanban_replay_storage_faults.py
index 6e8156957b073176009151d464d65c75620fc2ef..4d6da0eff32c4e8f9fc52572976eab39000ebf8f 100644
--- a/tests/hermes_cli/test_kanban_replay_storage_faults.py
+++ b/tests/hermes_cli/test_kanban_replay_storage_faults.py
@@ -193,7 +193,7 @@
         assert proc.is_alive()
         proc.kill()
         proc.join(10)
-        assert proc.exitcode == -signal.SIGKILL
+        assert proc.exitcode == -getattr(signal, "SIGKILL", signal.SIGTERM)
         with _reopen(conn, path) as reopened:
             if phase == 'committed':
                 after = journal.snapshot(reopened)
diff --git a/tests/hermes_cli/test_kanban_sync_capture_sites.py b/tests/hermes_cli/test_kanban_sync_capture_sites.py
index a3cbdf36113f853d897de28369d772f067ac5754..b8bd5a199c359a9c435827fc5181cf44b247e094 100644
--- a/tests/hermes_cli/test_kanban_sync_capture_sites.py
+++ b/tests/hermes_cli/test_kanban_sync_capture_sites.py
@@ -128,7 +128,7 @@
     for filename, function, _, _ in sorted(entries):
         module = qualified(filename, "").rstrip(".")
         path = root.joinpath(*module.split(".")).with_suffix(".py")
-        tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+        tree = ast.parse(path.read_text(encoding="utf-8-sig"), filename=str(path))
         nodes = tree.body
         for component in function.split("."):
             matches = [node for node in nodes if isinstance(node, (ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef))
