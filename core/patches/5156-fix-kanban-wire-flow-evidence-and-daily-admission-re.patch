+"""Exercise the actual read-only gh subprocess boundary without network."""
+import sys
+
+import pytest
+
+from hermes_cli import kanban_db_dispatch_pr_state as shared
+from hermes_cli.kanban_lanes_flow_pr import Reader
+
+
+@pytest.mark.parametrize("state,decision,buckets,expected", [
+    ("OPEN", "APPROVED", ["pass"], {"merged": False, "approved": True, "checks": "green"}),
+    ("OPEN", "REVIEW_REQUIRED", ["pending"], {"merged": False, "approved": False, "checks": "pending"}),
+    ("OPEN", "APPROVED", [], {"merged": False, "approved": True}),
+    ("OPEN", "APPROVED", ["fail"], {"merged": False, "approved": True}),
+    ("MERGED", "APPROVED", [], {"merged": True}),
+    ("CLOSED", "APPROVED", [], {}),
+])
+def test_real_executable_observations(tmp_path, monkeypatch, state, decision, buckets, expected):
+    script = tmp_path / "fixture_gh.py"
+    view = {"state": state, "reviewDecision": decision, "headRefOid": "a" * 40}
+    checks = [{"bucket": b} for b in buckets]
+    script.write_text("import json,sys\n" +
+                      f"print(json.dumps({view!r} if 'view' in sys.argv else {checks!r}))\n")
+    monkeypatch.setattr(shared, "_gh_argv", lambda: [sys.executable, str(script)])
+    reader = Reader()
+    assert reader.get("https://github.com/example/repo/pull/1") == expected
+    # A cached result must not spawn again, even when executable disappears.
+    script.unlink()
+    assert reader.get("https://github.com/example/repo/pull/1") == expected
+
+
+@pytest.mark.parametrize("body", ["print('not json')", "raise SystemExit(1)", "print('[]')"])
+def test_unreadable_observation_does_not_guess(tmp_path, monkeypatch, body):
+    script = tmp_path / "fixture_gh.py"
+    script.write_text(body)
+    monkeypatch.setattr(shared, "_gh_argv", lambda: [sys.executable, str(script)])
+    assert Reader().get("https://github.com/example/repo/pull/1") == {}
+
+
+def test_exhausted_budget_never_spawns(monkeypatch):
+    reader = Reader()
+    reader.deadline = 0
+    monkeypatch.setattr(shared, "_gh_argv", lambda: pytest.fail("no work after deadline"))
+    assert reader.get("https://github.com/example/repo/pull/1") == {}
+
+
+def test_missing_executable_is_unknown(monkeypatch):
+    monkeypatch.setattr(shared, "_gh_argv", lambda: ["/nonexistent/fixture-gh"])
+    assert Reader().get("https://github.com/example/repo/pull/1") == {}
+
+
+@pytest.mark.parametrize("change", ["headRefOid", "state", "reviewDecision", "missing", "absent_head"])
+def test_changed_head_or_review_during_checks_is_unknown(monkeypatch, change):
+    first = {"state": "OPEN", "headRefOid": "a" * 40, "reviewDecision": "APPROVED"}
+    last = dict(first)
+    if change == "missing":
+        last = None
+    elif change == "absent_head":
+        first.pop("headRefOid")
+        last.pop("headRefOid")
+    else:
+        last[change] = "different"
+    answers = iter([first, [{"bucket": "pass"}], last])
+    monkeypatch.setattr(Reader, "_read", lambda self, argv: next(answers))
+    assert Reader().get("https://github.com/example/repo/pull/1") == {}
diff --git a/website/docs/user-guide/features/kanban.md b/website/docs/user-guide/features/kanban.md
index ad38a06d6d..531be2179b 100644
--- a/website/docs/user-guide/features/kanban.md
+++ b/website/docs/user-guide/features/kanban.md
@@ -1635,6 +1635,10 @@ kanban:
 - **Priority cap.** `agent_priority_cap` bounds the stored priority of a card the user did not create, at creation. Later edits are not capped, and the planner may set 0 to 1000.
 - **Limits.** Worker nodes order foreign pickup with their own board copy, so lane order is exact only on the board that holds the cards; `paused` applies where `lanes` is configured. A worker that parks on a held follow-up card waits until that card is admitted.
 
+`usd_per_day` counts only `usage.cost_usd` reported on worker-result receipts; runs reporting tokens but no cost add zero, not an inferred price. Daily caps reserve admissions, not running slots: lowering a limit does not interrupt admitted work. Review/landing titles in `gate_exempt` under an admitted creator remain exempt. Daily-limit-only waits in ungated lanes are reconsidered by dispatcher readiness maintenance (including after local midnight); ordinary gated lanes still require admission, and agent/planner admission checks both daily limits. A person's explicit admission remains an override and counts toward `cards_per_day` even when outside the planner budget.
+
+Flow uses the latest scheduled event's `awaiting` record, current review/rework events, and bounded read-only GitHub PR observations (at most five seconds of network work per report, one observation per unique PR). Missing checks or exhausted lookup budget never establish green; absent evidence stays `landing_unclassified`. A merged PR stays in deploy until there is explicit live readback. Deployment systems can persist `metadata.flow_pr: {url: <PR URL>, merged: true, deployed: true, verified: false}` on a task event to report live verification (`test`); this is observation only, not authority to merge or declare success. All three flags are strict booleans and the URL must match the card's PR. The command does not infer installation from merge time.
+
 `hermes kanban lanes` (default `show`) prints target against actual share of run-hours over `--hours` (default 6), running, ready, held and open cards per lane; on a synced board it reads the fleet replica unless `--local`. `lanes flow --json [--window 1h|6h|24h|7d]` lists every open card with step, reason and source plus per-lane done/run-hours/cost and today's cap usage. `held` and `unclassified` list cards; `assign <id> <lane>`, `admit <id>`, `pin <id> [--off]` and `set <lane> [--share N] [--admit-per-day N] [--cards-per-day N] [--usd-per-day N] [--pause|--resume]` (always written to the installation-root config) are the controls; a person's `admit` does not spend the daily budget (an agent's does); `promote` and `unblock` also release a held card and are not budgeted; `explain <id>` says which lane a card is in and why it waits. Unset `cards_per_day` / `usd_per_day` means unlimited. Over the cap, new cards wait at the gate with reason `limit:cards_per_day` or `limit:usd_per_day`; both reset at local midnight.
 
 `hermes kanban lanes apply <file|->` applies a planner's JSON action list. Each action is validated on its own and refused with a reason when it breaks a limit: `admit` (at most `admit_per_day` per local day, never a `never_admit` title), `merge` (a held card into an open card of the same lane; it stays held), `reprioritize` (0 to 1000, never a pinned card), `relane` (only a card placed by inheritance or by default, never into or out of a gated lane) and `note`. Every action except `note` needs a one-line `reason`; one plan applies at most 50 actions.
