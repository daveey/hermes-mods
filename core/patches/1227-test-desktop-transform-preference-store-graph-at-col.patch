From 100a00ccd167f8913ff51313ad6b2af34bff79fa Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 05:08:54 -0700
Subject: [PATCH] test(desktop): transform preference store graph at
 collection, not inside the first test timeout (#289)

---
 .../lib/ui-preferences/guidance-sync.test.ts  | 11 ++++++
 .../lib/ui-preferences/sync-defaults.test.ts  | 16 +++++++++
 .../lib/ui-preferences/sync-handoff.test.ts   | 36 +++++++++----------
 3 files changed, 45 insertions(+), 18 deletions(-)

diff --git a/apps/desktop/src/lib/ui-preferences/guidance-sync.test.ts b/apps/desktop/src/lib/ui-preferences/guidance-sync.test.ts
index e1ee5b41b48..7dcb04ef1b1 100644
--- a/apps/desktop/src/lib/ui-preferences/guidance-sync.test.ts
+++ b/apps/desktop/src/lib/ui-preferences/guidance-sync.test.ts
@@ -6,6 +6,17 @@ import { afterEach, expect, it, vi } from 'vitest'
 
 import { parseUiPreferencesWrite, readUiPreferences, writeUiPreferences } from '../../../electron/ui-preferences'
 
+// Transform the stores this file loads while it is collected, outside the
+// test's timeout: vi.resetModules() keeps the transformed code, so a load only
+// re-evaluates it. Left to the first load(), the cold transform timed the test
+// out at 15s on a CPU-starved runner.
+await Promise.all([import('./sync'), import('@/store/onboarding'), import('@/store/tips')])
+// Drop the warm-up's evaluated stores and the values they wrote at load, so
+// the first test starts from the same empty page as every later one.
+vi.resetModules()
+window.localStorage.clear()
+window.sessionStorage.clear()
+
 const dirs: string[] = []
 const tick = (ms = 400) => new Promise(resolve => setTimeout(resolve, ms))
 
diff --git a/apps/desktop/src/lib/ui-preferences/sync-defaults.test.ts b/apps/desktop/src/lib/ui-preferences/sync-defaults.test.ts
index a901bd0bc99..b477c910a81 100644
--- a/apps/desktop/src/lib/ui-preferences/sync-defaults.test.ts
+++ b/apps/desktop/src/lib/ui-preferences/sync-defaults.test.ts
@@ -36,6 +36,22 @@ const LOAD_WRITERS = [
   () => import('@/store/tool-view')
 ]
 
+// Transform every store this file loads while it is collected, outside any
+// test's timeout: vi.resetModules() keeps the transformed code, so a load only
+// re-evaluates it. Left to the first boot(), the cold transform timed that
+// test out at 15s on a CPU-starved runner.
+await Promise.all([
+  import('./sync'),
+  import('@/store/translucency'),
+  import('@/store/voice-prefs'),
+  ...LOAD_WRITERS.map(load => load())
+])
+// Drop the warm-up's evaluated stores and the defaults they wrote at load, so
+// the first test starts from the same empty page as every later one.
+vi.resetModules()
+window.localStorage.clear()
+window.sessionStorage.clear()
+
 const dirs: string[] = []
 const tick = (ms = 400) => new Promise(resolve => setTimeout(resolve, ms))
 
diff --git a/apps/desktop/src/lib/ui-preferences/sync-handoff.test.ts b/apps/desktop/src/lib/ui-preferences/sync-handoff.test.ts
index 3e857e39faf..147cb1cdc58 100644
--- a/apps/desktop/src/lib/ui-preferences/sync-handoff.test.ts
+++ b/apps/desktop/src/lib/ui-preferences/sync-handoff.test.ts
@@ -2,7 +2,7 @@ import fs from 'node:fs'
 import os from 'node:os'
 import path from 'node:path'
 
-import { afterEach, beforeAll, expect, it, vi } from 'vitest'
+import { afterEach, expect, it, vi } from 'vitest'
 
 import { parseUiPreferencesWrite, readUiPreferences, writeUiPreferences } from '../../../electron/ui-preferences'
 
@@ -32,6 +32,23 @@ const LOAD_WRITERS = [
   () => import('@/store/translucency')
 ]
 
+// Transform the whole store graph while the file is collected, outside every
+// test and hook timeout. vi.resetModules() keeps the transformed code, so each
+// pageLoad only re-evaluates it. Left to the first test, the cold transform
+// alone took 14–22s on a CPU-starved runner (15s testTimeout); a beforeAll
+// only moves it under the 30s hookTimeout, which a slower runner exceeds too.
+await Promise.all([
+  import('./sync'),
+  import('@/lib/storage'),
+  import('@/store/favorite-models'),
+  ...LOAD_WRITERS.map(load => load())
+])
+// Drop the warm-up's evaluated stores and the defaults they wrote at load, so
+// the first test starts from the same empty page as every later one.
+vi.resetModules()
+window.localStorage.clear()
+window.sessionStorage.clear()
+
 const dirs: string[] = []
 const stops: (() => void)[] = []
 // Deliberately longer than the old 400–800ms assertion sleeps.
@@ -111,23 +128,6 @@ const outboxes = () =>
     key.startsWith(OUTBOX_PREFIX)
   )
 
-// Transform the store graph once, under hookTimeout: each pageLoad re-evaluates it after
-// vi.resetModules(), and the first test paying the cold transform inside its own 15s budget
-// timed out when CI ran every workspace check at once (1.2s alone, >15s there).
-beforeAll(async () => {
-  await import('./sync')
-  await import('@/lib/storage')
-  await import('@/store/favorite-models')
-
-  for (const load of LOAD_WRITERS) {
-    await load()
-  }
-
-  vi.resetModules()
-  window.localStorage.clear()
-  window.sessionStorage.clear()
-})
-
 afterEach(() => {
   closeTabs()
   vi.useRealTimers()
-- 
2.55.0

