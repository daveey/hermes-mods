From e878d722811f604779b670ef8c9c629217962833 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 10:55:08 -0800
Subject: [PATCH] test(gateway): remove opted-in launchd jobs on assertion
 failures [daveey]

---
 .../test_gateway_launchd_runtime.py           | 78 +++++++++++++------
 1 file changed, 54 insertions(+), 24 deletions(-)

diff --git a/tests/hermes_cli/test_gateway_launchd_runtime.py b/tests/hermes_cli/test_gateway_launchd_runtime.py
index 86c5959ad93..92a69942418 100644
--- a/tests/hermes_cli/test_gateway_launchd_runtime.py
+++ b/tests/hermes_cli/test_gateway_launchd_runtime.py
@@ -43,30 +43,30 @@ def test_gateway_job_is_a_launchd_osascript_child_that_reads_as_unsupervised(mon
     assert job is not None, "launchd refused the job in this user's GUI domain"
     try:
         try:
-            wait_until(lambda: report.exists() or job.poll() is not None, timeout=30)
-        except AssertionError:
-            pass  # the assert below names what the job did instead
-        log = tmp_path / "gateway-stdio.log"
-        state = subprocess.run(["launchctl", "print", job.target], capture_output=True, text=True, encoding="utf-8",
-                               check=False, stdin=subprocess.DEVNULL).stdout
-        assert report.exists(), (f"tmp={tmp_path}\nlog={log.read_text(encoding='utf-8') if log.exists() else None!r}\n"
-                                 f"launchctl print:\n{state[:3000]}")
-        seen = json.loads(report.read_text(encoding="utf-8-sig"))
-        wrapper = seen["ppid"]
-        # The caller is not an ancestor: launchd (pid 1) spawned the wrapper, the wrapper the command. The
-        # wrapper is the signed Hermes Python.app when installed (its TCC grants), else osascript.
-        expected = responsible_app([sys.executable]) or "/usr/bin/osascript"
-        assert _command_of(wrapper).startswith(str(expected)), _command_of(wrapper)
-        assert subprocess.run(["ps", "-o", "ppid=", "-p", str(wrapper)], capture_output=True, text=True, encoding="utf-8",
-                              check=False, stdin=subprocess.DEVNULL).stdout.strip() == "1"
-        assert seen["marker"] == "env-carried"
-        # Read as unsupervised, or /restart would exit for a respawn no KeepAlive provides.
-        assert seen["xpc"] == "0"
-        assert not list(tmp_path.glob(".*.plist")), "the plist holding the launch env must not stay on disk"
-        assert job.poll() is None
-    finally:
-        release.write_text("", encoding="utf-8")
-    try:
+            try:
+                wait_until(lambda: report.exists() or job.poll() is not None, timeout=30)
+            except AssertionError:
+                pass  # the assert below names what the job did instead
+            log = tmp_path / "gateway-stdio.log"
+            state = subprocess.run(["launchctl", "print", job.target], capture_output=True, text=True, encoding="utf-8",
+                                   check=False, stdin=subprocess.DEVNULL).stdout
+            assert report.exists(), (f"tmp={tmp_path}\nlog={log.read_text(encoding='utf-8') if log.exists() else None!r}\n"
+                                     f"launchctl print:\n{state[:3000]}")
+            seen = json.loads(report.read_text(encoding="utf-8-sig"))
+            wrapper = seen["ppid"]
+            # The caller is not an ancestor: launchd (pid 1) spawned the wrapper, the wrapper the command. The
+            # wrapper is the signed Hermes Python.app when installed (its TCC grants), else osascript.
+            expected = responsible_app([sys.executable]) or "/usr/bin/osascript"
+            assert _command_of(wrapper).startswith(str(expected)), _command_of(wrapper)
+            assert subprocess.run(["ps", "-o", "ppid=", "-p", str(wrapper)], capture_output=True, text=True, encoding="utf-8",
+                                  check=False, stdin=subprocess.DEVNULL).stdout.strip() == "1"
+            assert seen["marker"] == "env-carried"
+            # Read as unsupervised, or /restart would exit for a respawn no KeepAlive provides.
+            assert seen["xpc"] == "0"
+            assert not list(tmp_path.glob(".*.plist")), "the plist holding the launch env must not stay on disk"
+            assert job.poll() is None
+        finally:
+            release.write_text("", encoding="utf-8")
         assert wait_until(lambda: job.poll() is not None, timeout=30)
         assert job.poll() == 0
     finally:  # leave the developer's GUI domain as we found it
@@ -74,6 +74,36 @@ def test_gateway_job_is_a_launchd_osascript_child_that_reads_as_unsupervised(mon
                        stdin=subprocess.DEVNULL)
 
 
+@pytest.mark.parametrize("release_fails", [False, True])
+def test_real_launchd_probe_removes_job_after_early_failure(monkeypatch, tmp_path, release_fails):
+    """Exercise the actual integration test's teardown without creating a real job."""
+    from types import SimpleNamespace
+
+    module = sys.modules[__name__]
+    target = "gui/501/mock-owned-job"
+    calls = []
+    monkeypatch.setattr(module, "start_gateway_job", lambda *a, **kw: SimpleNamespace(target=target, poll=lambda: 1))
+    monkeypatch.setattr(module, "wait_until", lambda predicate, **kw: predicate())
+
+    def fake_run(command, **kwargs):
+        calls.append(command)
+        return subprocess.CompletedProcess(command, 0, "mock failed child", "")
+
+    monkeypatch.setattr(subprocess, "run", fake_run)
+    original_write = Path.write_text
+
+    def write_text(path, *args, **kwargs):
+        if release_fails and path == tmp_path / "release":
+            raise OSError("mock release failure")
+        return original_write(path, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "write_text", write_text)
+    with pytest.raises(OSError if release_fails else AssertionError):
+        test_gateway_job_is_a_launchd_osascript_child_that_reads_as_unsupervised(monkeypatch, tmp_path)
+    assert calls == [["launchctl", "print", target], ["launchctl", "remove", "mock-owned-job"]]
+    assert (tmp_path / "release").exists() is not release_fails
+
+
 def _job_program_arguments(monkeypatch, tmp_path, command):
     """ProgramArguments of the plist start_gateway_job hands to ``launchctl bootstrap``."""
     seen = {}
-- 
