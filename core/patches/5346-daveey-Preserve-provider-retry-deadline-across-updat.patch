+        threading.Event(), SimpleNamespace(join=lambda: None)))
+    session = {"agent": agent, "session_key": "key", "profile_home": str(tmp_path),
+               "history_lock": threading.Lock()}
+    st = _TurnRun(agent, None, None, True, marker_key="key", own_marker=None,
