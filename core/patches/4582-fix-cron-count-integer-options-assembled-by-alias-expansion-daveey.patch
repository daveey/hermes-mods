From 1f89da370684c91245e8c2043447c063a9d52692 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 19:46:13 +0000
Subject: [PATCH] fix(cron): count integer options assembled by alias expansion
 [daveey]

Review of PR #3305 at a22d17b09b found one remaining miss in the alias
integer-context family: a trailing-space alias also expands the next
word, so

    alias d='declare '; alias i='-i'; d i x; x=a[\$\(payload\)]

runs `declare -i x` and the later assignment executes payload, while
scan_gateway_lifecycle returned (False, None). Neither alias value matches
the declaration regex and `d i x` carries no literal option.

Without evaluating aliases, an alias definition whose (dequoted) value
holds an integer option word (`-i`, `-xi x`) now sets the sticky
integer hint, like a value that already contains `declare -i`.

RED: 3 new real-Bash rows (declare/typeset trailing-space + option alias,
and a combined `-xi x` value) fail at a22d17b09b; the marker proves Bash
runs the payload. GREEN: 36/36 in test_lifecycle_guard_arith_int_context,
1296 passed across all 16 lifecycle-guard arith/output consumer files.
Controls stay allowed: `alias i='+i'` and `alias i='-x'` twins.
---
 cron/lifecycle_guard_arith_words.py                  | 7 ++++++-
 tests/cron/test_lifecycle_guard_arith_int_context.py | 5 +++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/cron/lifecycle_guard_arith_words.py b/cron/lifecycle_guard_arith_words.py
index bb8eee37e09c2961928cbb80666aa0728f0d7157..f2b5f2f9d844496cc3d680d713e0a5b2afd29e9d 100644
--- a/cron/lifecycle_guard_arith_words.py
+++ b/cron/lifecycle_guard_arith_words.py
@@ -173,10 +173,15 @@ def may_set_integer_attributes(command: str, *, aliases_defined: bool = False) -
         name = guard._executable_name(words[index])
         # Alias values are dequoted assignment words: the '=' before declare
         # prevents the ordinary declaration regex from matching its command name.
+        # A value may also be only an option (`alias i='-i'`) that a trailing-space
+        # alias (`alias d='declare '`) expands into `d i x`. Do not evaluate
+        # aliases: any value carrying an integer option word sets the hint.
         # Inspect only alias definitions, not arbitrary data assignments.
         if name == "alias" and any(
-            _INTEGER_DECLARATION_RE.search(word.partition("=")[2])
+            _INTEGER_DECLARATION_RE.search(value)
+            or _integer_declaration(re.sub(r"[\"'\\]", "", value).split())
             for word in words[index + 1:] if "=" in word
+            for value in (word.partition("=")[2],)
         ):
             return True
         # Do not evaluate expansions or source files to discover attributes. Either
diff --git a/tests/cron/test_lifecycle_guard_arith_int_context.py b/tests/cron/test_lifecycle_guard_arith_int_context.py
index fb20c81c709b81c00e13b583702564b086b80b86..ff8ac0526935ed068dc3ac78132f543c1472d9d9 100644
--- a/tests/cron/test_lifecycle_guard_arith_int_context.py
+++ b/tests/cron/test_lifecycle_guard_arith_int_context.py
@@ -14,6 +14,9 @@ SHAPES = [
     "shopt -s expand_aliases\nalias d='declare'\nd -i x\nx=a[\\$\\(SCRIPT\\)]",
     "shopt -s expand_aliases\nalias d='typeset'\nd -i x\nx=a[\\$\\(SCRIPT\\)]",
     "shopt -s expand_aliases\nalias d='builtin declare'\nd -xi x\nx=a[\\$\\(SCRIPT\\)]",
+    "shopt -s expand_aliases\nalias d='declare '\nalias i='-i'\nd i x\nx=a[\\$\\(SCRIPT\\)]",
+    "shopt -s expand_aliases\nalias d='typeset '\nalias i='-i'\nd i x\nx=a[\\$\\(SCRIPT\\)]",
+    "shopt -s expand_aliases\nalias d='declare '\nalias i='-xi x'\nd i\nx=a[\\$\\(SCRIPT\\)]",
     "shopt -s expand_aliases\nalias d='declare -i'\nd x\nx=a[\\$\\(SCRIPT\\)]",
     "shopt -s expand_aliases\nalias d='typeset -i'\nd x\nx=a[\\$\\(SCRIPT\\)]",
     r'let "a[\`SCRIPT\`]=1"',
@@ -37,6 +40,8 @@ CONTROLS = [
     "shopt -s expand_aliases\nalias d='typeset'\nd x\nx=a[\\$\\(SCRIPT\\)]",
     "shopt -s expand_aliases\nalias d='declare'\nd x\nx=a[\\$\\(SCRIPT\\)]",
     "shopt -s expand_aliases\nalias d='declare +i'\nd x\nx=a[\\$\\(SCRIPT\\)]",
+    "shopt -s expand_aliases\nalias d='declare '\nalias i='+i'\nd i x\nx=a[\\$\\(SCRIPT\\)]",
+    "shopt -s expand_aliases\nalias d='typeset '\nalias i='-x'\nd i x\nx=a[\\$\\(SCRIPT\\)]",
     r"eval 'x=a[\$\(SCRIPT\)]'",
     r"declare x; eval 'x=a[\$\(SCRIPT\)]'",
     r"declare +i x; eval 'x=a[\$\(SCRIPT\)]'",
-- 
