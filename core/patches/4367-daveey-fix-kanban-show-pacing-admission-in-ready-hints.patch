From e08f1451fa5d2cd16316eaa10aa6f64b959c0ddf Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 01:04:13 +0000
Subject: [PATCH] [daveey] fix(kanban): show pacing admission in ready hints

Reuse the stall notice pacing decision and observation renderer for ready_hint. Preserve busy-backlog precedence and unchanged fail-open wording.

Proof: four hub parity regressions fail on baseline; 65 focused and 362 consumer tests pass. Busy-guard removal is killed. Fresh focused/backlog rerun passes 107 tests; scripts/check passes all 20 checks.
---
 hermes_cli/kanban_parent_unclaimed.py         |  9 +++++-
 .../test_kanban_notice_pacing_admission.py    | 28 +++++++++++++++++++
 2 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_parent_unclaimed.py b/hermes_cli/kanban_parent_unclaimed.py
index d1ae4aec3f33b939a09c1f597bf0f2c55080ca56..558e07cbd13cba1b5dc7289876bdd2c6850f98c9 100644
--- a/hermes_cli/kanban_parent_unclaimed.py
+++ b/hermes_cli/kanban_parent_unclaimed.py
@@ -161,7 +161,14 @@ def ready_hint(conn, task, *, now: Optional[float] = None) -> Optional[str]:
     from hermes_cli.kanban_dispatch_skip import notice_fields
     pool = _pool_sentence(place, now)
     fields = {**notice_fields(place, waited), **({"pool_hint": pool} if pool else {}), **_backlog(place)}
-    return (f"Ready {_minutes(waited)} min, unclaimed; {_queue_words(place, now)}. " + (f"{pool}. " if pool else "")
+    from hermes_cli import kanban_host_counts as khc
+    from hermes_cli import kanban_label_backlog as klb
+    admission = None if klb.busy(place.get("backlog")) else _pacing_admission(conn, task.id, place, None)
+    if admission:
+        fields.update(admission=admission, board=place.get("board") or khc.board_of(conn),
+                      observed_at=place.get("observed_at") or int(now))
+    return (f"Ready {_minutes(waited)} min, unclaimed; {_queue_words(place, now)}" + _observation(fields) + ". "
+            + (f"{pool}. " if pool else "")
             + checkpoint + _options(task.id, lane_evidence(conn, task.id), fields, now) + ".")
 
 
diff --git a/tests/hermes_cli/test_kanban_notice_pacing_admission.py b/tests/hermes_cli/test_kanban_notice_pacing_admission.py
index 85d81531aa75afa6aa89a192041bef46c790bbb1..4b7556f393cf06e8dd940b451d4c1ca5021d9efb 100644
--- a/tests/hermes_cli/test_kanban_notice_pacing_admission.py
+++ b/tests/hermes_cli/test_kanban_notice_pacing_admission.py
@@ -175,6 +175,23 @@ def test_held_pool_notice_carries_the_until_time(hub, path):
     _assert_names_no_re_placement(text)
 
 
+@pytest.mark.parametrize("state", [lp.PACED, lp.HELD])
+@pytest.mark.parametrize("path", sorted(NOTICES))
+def test_ready_hint_matches_the_notice_pacing_admission(hub, state, path):
+    until = int(time.time()) + 3600
+    _store(("anthropic", state, until))
+    tid = _hub_card(hub.conn)
+    payload, text = NOTICES[path](hub.conn, tid)
+    hint = pu.ready_hint(hub.conn, kb.get_task(hub.conn, tid), now=payload["observed_at"])
+    assert hint is not None
+    assert pu._observation(payload) in hint
+    assert pu._options(tid, payload=payload) in hint
+    assert "it starts on its own once its provider pool is back on pace" in hint
+    assert "this machine cannot lease it" in hint
+    _assert_names_no_re_placement(hint)
+    assert "LLM quota pacing" in text
+
+
 # --- card case 4: no positive read, today's payload and words -------------------------------------------------------
 
 
@@ -202,6 +219,14 @@ def test_without_a_positive_governor_read_the_notice_is_as_before(hub, monkeypat
     assert payload["admission"] == UNKNOWN, payload
     assert "admission reason unknown" in text and "re-place on a capable gateway with free slots" in text, text
     assert "pacing" not in json.dumps(payload) and "pacing" not in text, (payload, text)
+    task, now = kb.get_task(hub.conn, tid), payload["observed_at"]
+    hint = pu.ready_hint(hub.conn, task, now=now)
+    assert hint is not None
+    assert asked == [tid, tid]
+    monkeypatch.setattr(pu, "_pacing_admission", lambda *_a: None)
+    assert hint == pu.ready_hint(hub.conn, task, now=now)
+    assert "re-place on a capable gateway with free slots" in hint
+    assert "admission reason" not in hint
 
 
 # --- every condition the rule adds ----------------------------------------------------------------------------------
@@ -302,6 +327,9 @@ def test_a_busy_pool_and_a_core_update_hold_still_come_first(hub):
             kb._append_event(hub.conn, claimed, "claimed", {"holder": f"worker-{3 + i % 2}", "run_uid": f"r{i}"})
     payload = _post(hub.conn, busy)
     assert payload["admission"] == {"reason": "matching_pool_busy", "status": "queued"}, payload
+    hint = pu.ready_hint(hub.conn, kb.get_task(hub.conn, busy))
+    assert hint is not None and "Not a placement problem" in hint
+    assert "LLM quota pacing" not in hint
     held = _pool_card(hub.conn, title="held for an update")
     assert _post(hub.conn, held, core_update_hold=True)["admission"] == {"reason": "core_update_hold", "status": "held"}
 
