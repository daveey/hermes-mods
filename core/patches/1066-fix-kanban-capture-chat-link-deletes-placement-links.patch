From aba16a22103b05f93a7ad49c7f9ab9a0ff4f955d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 19:56:42 -0700
Subject: [PATCH] fix(kanban): capture chat-link deletes; placement links leave
 live and the Board [daveey] (#243)

A local DELETE on task_chat_links had no capture trigger, so the Board kept
the row forever: 231 released kanban-placement-* links on the hub became a
shadow-only child_mismatch at pending=0 (2026-10-30, t_01a18a6ec4732371).

- task_chat_links joins _DELETE_CAPTURED (delete op + tombstone; evict and
  pulls delete under applying, so nothing echoes).
- reconcile deletes placement-attribution links (is_placeholder_session)
  instead of releasing them.
- sync_board queues a Board delete for this gateway's placement links the
  live file already lost (retire_lost_placeholder_links). Real chat links
  missing from live are untouched and stay a reported mismatch.
---
 hermes_cli/kanban_chat_links.py               |  17 +-
 hermes_cli/kanban_db_sync.py                  |   5 +-
 hermes_cli/kanban_sync_client.py              |  38 +++++
 tests/hermes_cli/test_kanban_chat_links.py    |   4 +-
 .../test_kanban_sync_placeholder_links.py     | 160 ++++++++++++++++++
 5 files changed, 217 insertions(+), 7 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_sync_placeholder_links.py

diff --git a/hermes_cli/kanban_chat_links.py b/hermes_cli/kanban_chat_links.py
index ac74bf27811..be486eece7e 100644
--- a/hermes_cli/kanban_chat_links.py
+++ b/hermes_cli/kanban_chat_links.py
@@ -95,10 +95,19 @@ def reconcile(conn: sqlite3.Connection, board: str, gateway: str, *, ledger: boo
     want = _local_links(conn, gateway)
     if ledger:
         want.update(_ledger_links(board, gateway))
-    have = {r[0]: r[1] for r in conn.execute(
-        "SELECT uid, released FROM task_chat_links WHERE chat_gateway = ?", (gateway,))}
-    added = changed = released = 0
+    from hermes_cli.kanban_placement import is_placeholder_session
+    rows = conn.execute("SELECT uid, released, chat_session FROM task_chat_links WHERE chat_gateway = ?",
+                        (gateway,)).fetchall()
+    have = {r[0]: r[1] for r in rows}
+    # A placement attribution id is not a chat: its link is deleted (captured, so the Board drops it too), never
+    # merely released; a released one still counted in every diff and replica read.
+    placeholders = {r[0] for r in rows if is_placeholder_session(r[2])}
+    added = changed = released = retired = 0
     with write_txn(conn):
+        for uid in placeholders - set(want):
+            conn.execute("DELETE FROM task_chat_links WHERE uid = ?", (uid,))
+            have.pop(uid)
+            retired += 1
         for uid, link in want.items():
             if uid not in have:
                 conn.execute(
@@ -113,7 +122,7 @@ def reconcile(conn: sqlite3.Connection, board: str, gateway: str, *, ledger: boo
             if uid not in want and not was_released:
                 conn.execute("UPDATE task_chat_links SET released = 1 WHERE uid = ?", (uid,))
                 released += 1
-    return {"added": added, "changed": changed, "released": released}
+    return {"added": added, "changed": changed, "released": released, "retired": retired}
 
 
