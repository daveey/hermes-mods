From f8c1ced0040ec430e376cbdf8c22d2ba686817fa Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 24 Nov 2026 12:08:51 -0800
Subject: [PATCH 6220] Standing producer owner chats and local origin custody

Public mirror of source commit f8c1ced0040ec430e376cbdf8c22d2ba686817fa.

---
diff --git a/hermes_cli/kanban_owner_chat.py b/hermes_cli/kanban_owner_chat.py
index fced67320d5..a310a044467 100644
--- a/hermes_cli/kanban_owner_chat.py
+++ b/hermes_cli/kanban_owner_chat.py
@@ -82,6 +82,11 @@
             "provider safety refusal.")
 
 
+def idle_summary(producer: str) -> str:
+    return (f"Standing owner chat for Kanban cards from {producer}. Budget and scope stops on them arrive here "
+            "as notices; nothing pending.")
+
+
 def declared_producer(tool_task_id: Optional[str] = None, *, allow_env: bool = True) -> Optional[str]:
     """The producer a headless caller's runner declared: the cron job running a tool call, else (outside any
     agent turn only) ``HERMES_KANBAN_PRODUCER``, which the cron script runner sets."""
@@ -158,6 +163,11 @@
             row = db.get_session(sid) or {}
             if not row.get("message_count"):
                 db.append_message(sid, "assistant", brief(producer))
+            if not row.get("outcome_json"):
+                # The sidebar paints a chat with no outcome (or the seed, judged no summary) amber "attention"
+                # for good; the standing chat has nothing pending until a notice wakes it, whose turn re-declares.
+                from hermes_state_outcome import declare_outcome
+                declare_outcome(sid, {"kind": "done", "summary": idle_summary(producer)}, db=db)
             if not db.get_session_title(sid):
                 try:
                     db.set_session_title(sid, title(producer))
diff --git a/tests/hermes_cli/test_kanban_owner_chat.py b/tests/hermes_cli/test_kanban_owner_chat.py
index c63238d7c72..bfcbe94fc6b 100644
--- a/tests/hermes_cli/test_kanban_owner_chat.py
+++ b/tests/hermes_cli/test_kanban_owner_chat.py
@@ -658,3 +658,16 @@
                          "NULL,0,0)", (tid,))
         monkeypatch.setattr(owner, "enabled", lambda: True)
         assert owner.backfill(conn, apply=True)["linked"] == 1
+
+
+def test_a_new_owner_chat_is_not_left_amber_with_no_outcome(kanban_home):
+    from hermes_state import SessionDB
+    from hermes_state_outcome import _parse
+    with kbc.connect_closing() as conn:
+        kb.create_task(conn, title="a", assignee="default", created_by="ci-main-watch")
+    db = SessionDB(db_path=kanban_home / "state.db")
+    try:
+        outcome = _parse(db.get_session(owner.session_id("ci-main-watch"))["outcome_json"])
+        assert outcome["kind"] == "done" and outcome["source"] == "declared"
+    finally:
+        db.close()
-- 
