From f4d2f7180c8bd5a5f5c7349b48bff4a66bc6d9ad Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 08:49:10 -0700
Subject: [PATCH] test(update): tolerate procfs reaping during custody checks
 [daveey] (#322)

---
 tests/hermes_cli/test_update_custody_tree.py | 28 +++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_update_custody_tree.py b/tests/hermes_cli/test_update_custody_tree.py
index 81574f68c5a..d0d6ce72c2a 100644
--- a/tests/hermes_cli/test_update_custody_tree.py
+++ b/tests/hermes_cli/test_update_custody_tree.py
@@ -31,11 +31,37 @@ def _alive(pid: int) -> bool:
     except ProcessLookupError:
         return False
     if Path(f"/proc/{pid}/stat").exists():  # Linux: a zombie is dead
-        stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
+        try:
+            stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
+        except FileNotFoundError:
+            # The reaper can remove procfs state after the existence check.
+            return False
         return stat[stat.rfind(")") + 2:][:1] != "Z"
     return True
 
 
+@pytest.mark.platforms("linux")
+def test_alive_tolerates_a_process_reaped_before_its_stat_read(monkeypatch):
+    child = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(60)"])
+    stat_path = Path(f"/proc/{child.pid}/stat")
+    read_text = Path.read_text
+
+    def reap_before_read(path, *args, **kwargs):
+        if path == stat_path:
+            child.kill()
+            child.wait(timeout=60)
+        return read_text(path, *args, **kwargs)
+
+    try:
+        assert _alive(child.pid), "a live process must not count as gone"
+        monkeypatch.setattr(Path, "read_text", reap_before_read)
+        assert not _alive(child.pid)
+    finally:
+        if child.poll() is None:
+            child.kill()
+        child.wait(timeout=60)
+
+
 def _gone_within(pid: int, seconds: float) -> bool:
     deadline = time.monotonic() + seconds
     while time.monotonic() < deadline:
