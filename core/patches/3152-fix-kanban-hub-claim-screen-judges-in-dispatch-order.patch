From 8475dd24c4ece03be1fbaafab12987a859a792d8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 01:43:55 +0000
Subject: [PATCH] fix(kanban): hub claim screen judges in dispatch order so the
 budget never defers top priority [daveey]

The per-tick judge budget walked candidates by id, so a backlog deferred
the highest-priority card and the claim pass let lower-priority cards jump
it (test_capacity_release_restarts_in_priority_order went red). Judge in
lane_rows' dispatch order instead.
---
 hermes_cli/kanban_hub_admission_claim.py            |  8 ++++++--
 tests/hermes_cli/test_kanban_hub_admission_claim.py | 11 +++++++++++
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_hub_admission_claim.py b/hermes_cli/kanban_hub_admission_claim.py
index 87e4acccc0..a7152ca595 100644
--- a/hermes_cli/kanban_hub_admission_claim.py
+++ b/hermes_cli/kanban_hub_admission_claim.py
@@ -64,9 +64,13 @@ class Counts:
 
 
 def _candidates(conn: sqlite3.Connection) -> list[sqlite3.Row]:
-    return conn.execute(
+    """Screenable cards in the claim pass's own dispatch order, so the per-tick judge budget covers the cards the
+    claims reach first and never lets lower-priority work jump a deferred higher-priority card."""
+    from hermes_cli.kanban_db_dispatch_queries import lane_rows
+    rows = {row["id"]: row for row in conn.execute(
         "SELECT * FROM tasks WHERE status = 'ready' AND claim_lock IS NULL "
-        "AND (runs_on IS NULL OR runs_on IN ('', '[]')) AND placement_policy IS NULL ORDER BY id").fetchall()
+        "AND (runs_on IS NULL OR runs_on IN ('', '[]')) AND placement_policy IS NULL").fetchall()}
+    return [rows[row["id"]] for row in lane_rows(conn, "ready") if row["id"] in rows]
 
 
 def _latest_wake_check(conn: sqlite3.Connection, task_id: str) -> str:
diff --git a/tests/hermes_cli/test_kanban_hub_admission_claim.py b/tests/hermes_cli/test_kanban_hub_admission_claim.py
index 173876e4f4..c5967917a3 100644
--- a/tests/hermes_cli/test_kanban_hub_admission_claim.py
+++ b/tests/hermes_cli/test_kanban_hub_admission_claim.py
@@ -331,6 +331,17 @@ def test_screen_reports_deferred_ids(gws, hub_judge):
     assert "deferred=2" in counts.line()
 
 
+def test_the_judge_budget_follows_dispatch_priority_not_creation_order(gws, hub_judge):
+    hub, _worker, _svc = gws
+    low = _hub_card(hub, title="older low-priority card", priority=0)
+    high = _hub_card(hub, title="newer urgent card", priority=900)
+    hub.enter()
+    counts = hac.screen(hub.conn, budget=1)
+    # The claim pass reaches the urgent card first; deferring it would let the older card jump it this tick.
+    assert counts.deferred_ids == frozenset({low})
+    assert _events(hub.conn, high, "hub_admission") and not _events(hub.conn, low, "hub_admission")
+
+
 @pytest.mark.parametrize("kind,payload", [
     ("scheduled", {"wake_check": "test -f ~/.hermes/cache/new-probe"}),
     ("hub_admission", {"admit": True, "entry": "move", "why": "new decision"}),
-- 
