diff --git a/hermes_cli/kanban_quota_probe.py b/hermes_cli/kanban_quota_probe.py
index 79f0f0af87b8c944bbd51a0e26b150f4072eed04..18fca8f644e1e654994ce4fcd7214040e239032b 100644
--- a/hermes_cli/kanban_quota_probe.py
+++ b/hermes_cli/kanban_quota_probe.py
@@ -82,7 +82,7 @@
     """The model the episode's run was routed to (its receipt), else the episode's recorded model."""
     from hermes_cli.kanban_quota_receipt import _owned_receipt
     owned = _owned_receipt(conn, task_id, state['run_id'])
-    model = owned[0].get('route_model') if owned else None
+    model = state.get('wall_model') or (owned[0].get('route_model') if owned else None)
     return model if isinstance(model, str) and model else state.get('model')
 
 
@@ -90,8 +90,15 @@
     """``provider -> Verdict._asdict()`` for every provider *walls* name (``kanban_quota_episode._providers``)."""
     from hermes_cli.kanban_quota_episode import _providers
     verdict = verdict or live_verdict
-    names = sorted({provider for wall in walls for provider in _providers(wall)})
-    return {provider: verdict(provider, model)._asdict() for provider in names}
+    targets = sorted({(provider, wall.get('wall_model') or model) for wall in walls for provider in _providers(wall)},
+                     key=lambda target: (target[0], str(target[1])))
+    found = {}
+    for provider, candidate in targets:
+        value = verdict(provider, candidate)._asdict()
+        # One serving model cannot release another model's confirmed/unknown wall.
+        if provider not in found or found[provider]['state'] == 'headroom' or value['state'] == 'walled':
+            found[provider] = value
+    return found
 
 
 def contradicted(exc, *, verdict=None):
diff --git a/tests/hermes_cli/test_kanban_model_quota_walls.py b/tests/hermes_cli/test_kanban_model_quota_walls.py
index 8fd27898540d0fd4ad472a9cf7804edd2c9500ef..f2f14b33da8bc9809c20963e7605249e7beee81f 100644
--- a/tests/hermes_cli/test_kanban_model_quota_walls.py
+++ b/tests/hermes_cli/test_kanban_model_quota_walls.py
@@ -152,3 +152,15 @@
     assert set(pw.active_walls()) == {f'{P}/{A}'}
     assert quota.decision(conn, task, base=(B, P, 'default')) == (None, None)
     assert quota.decision(conn, task, base=('class:standard', 'auto', 'default')) == (None, (B, P))
+
+
+@pytest.mark.parametrize('state', ['walled', 'unknown'])
+def test_release_probes_every_scoped_model_before_releasing_provider(state):
+    from hermes_cli import kanban_quota_probe as probe
+    seen = []
+    def verdict(provider, model):
+        seen.append((provider, model))
+        return probe.Verdict(state if model == A else 'headroom', model)
+    found = probe.verdicts([{'provider': P, 'wall_model': m} for m in (A, B)], B, verdict)
+    assert set(seen) == {(P, A), (P, B)}
+    assert found[P]['state'] == state
