From 3b88d6ddb76c7a9bfd3463cdfe0e99a9139575ce Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 11:08:21 +0000
Subject: [PATCH] [daveey] refactor: inline the paused-turn homes lookup so
 session_notifications.py stays at its 2000-line cap

---
 tui_gateway/session_notifications.py | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/tui_gateway/session_notifications.py b/tui_gateway/session_notifications.py
index ae1029bff0..941f512d87 100644
--- a/tui_gateway/session_notifications.py
+++ b/tui_gateway/session_notifications.py
@@ -1713,8 +1713,7 @@ def _wake_session_turn(session_key: str, text: str, *, display_kind: str | None
             # [daveey] A turn paused for an update belongs to the restarting backend's startup sweep; resuming it
             # here would continue it in a process its viewers are not attached to (update_pause).
             from tui_gateway.update_pause import paused_turn_homes, successor_owes_continuation
-            homes = paused_turn_homes(_hermes_home, _readopt_wake_profiles())
-            if any(successor_owes_continuation(home, key) for home in homes):
+            if any(successor_owes_continuation(h, key) for h in paused_turn_homes(_hermes_home, _readopt_wake_profiles())):
                 logger.info("%s: %s is paused for a Hermes update and its backend is restarting; left to that "
                             "backend's continuation", label, key)
                 return "busy"
-- 
2.43.0

