 The move itself is the ordinary queued move (``kanban_move.move_queued``) with its own guards. Nothing here reads
 or writes a registry hold, so a hold is never lifted or shortened. A target another gateway created is moved through
@@ -35,14 +39,17 @@ CLOSED = ("done", "archived")
 
 def howto(own: str) -> str:
     """The supported re-place command, as alarm prose (``_tail`` and the hold text name it)."""
+    pool = pool_label()
     return (f"To re-place a listed card off {own}, call the kanban_move TOOL from this alarm's run (not the shell: "
             f"`hermes kanban move` is fenced in worker shells): kanban_move(task_id=\"<listed card>\", "
-            "runs_on=[\"machine:<X>\"], reason=\"...\"), where X is another machine eligible now (active, unheld, "
-            "free slot, the card's profile and capabilities). When the card was created on another gateway, "
-            "kanban_move answers foreign_card: send the same move as kanban_supervisor_request(ops=[{\"op\": "
-            "\"operator\", \"action\": \"move\", \"task_id\": \"<listed card>\", \"runs_on\": [\"machine:<X>\"], "
-            f"\"reason\": \"...\"}}]). Only the cards this alarm lists, only while they are ready and pinned to {own}, "
-            f"and never back to {own}.")
+            f"runs_on=[\"{pool}\"], reason=\"...\") queues it for any pool worker other than {own} with a free "
+            "slot (granted while one is eligible now). Never pin one pool worker: that needs a host_reason, and "
+            "capacity is none. Only when no pool worker is eligible, use runs_on=[\"machine:<X>\"] for another "
+            "machine eligible now that is not a pool worker (active, unheld, free slot, the card's profile and "
+            "capabilities). When the card was created on another gateway, kanban_move answers foreign_card: send "
+            "the same move as kanban_supervisor_request(ops=[{\"op\": \"operator\", \"action\": \"move\", "
+            f"\"task_id\": \"<listed card>\", \"runs_on\": [\"{pool}\"], \"reason\": \"...\"}}]). Only the cards "
+            f"this alarm lists, only while they are ready and pinned to {own}, and never back to {own}.")
 
 
 def _cols(row: Any) -> set:
@@ -126,14 +133,42 @@ def scope_refusal(conn: sqlite3.Connection, alarm: Any, target: Any, runs_on: An
         labels = list(wn.normalize_runs_on(runs_on) or [])
     except ValueError as exc:
         return str(exc)
+    if labels == [pool_label()]:
+        return pool_refusal(own, machines, _need(target), now_ms)
     if len(labels) != 1 or not labels[0].startswith("machine:"):
-        return "runs_on must be exactly one machine:<X> label"
+        return f"runs_on must be exactly [\"{pool_label()}\"] or exactly one machine:<X> label"
     name = labels[0].split(":", 1)[1]
     if name == own:
         return f"the card must leave {own}"
     return eligible_now(name, own, machines, _need(target), now_ms)
 
 
+def pool_label() -> str:
+    from hermes_cli.kanban_placement import POOL_LABEL
+    return POOL_LABEL
+
+
+def pool_refusal(own: str, machines: Optional[Mapping[str, Mapping[str, Any]]], need: set,
+                 now_ms: int) -> Optional[str]:
+    """None when a pool machine other than ``own`` may take the card now (:func:`eligible_now`), else why not.
+
+    The pool queue is how an alarm re-places a card onto a pool worker: ``machine:<pool worker>`` needs a
+    ``host_reason`` (:mod:`hermes_cli.kanban_move_pool`), which capacity never is, so no alarm path passes one."""
+    label = pool_label()
+    if machines is None:
+        return "the machine registry is unreadable"
+    pooled = sorted(n for n, e in machines.items() if n != own and label in ((e or {}).get("labels") or []))
+    whys = []
+    for name in pooled:
+        why = eligible_now(name, own, machines, need, now_ms)
+        if why is None:
+            return None
+        whys.append(why)
+    return (f"no {label} machine other than {own} is eligible now"
+            + (f": {'; '.join(whys)}" if whys else " (none carries the label)")
+            + "; a machine outside the pool that is eligible now takes runs_on=[\"machine:<X>\"]")
+
+
 def _registry_machines() -> Optional[Mapping[str, Mapping[str, Any]]]:
     from hermes_cli import kanban_worker_node as wn
     reg = wn.registry()
diff --git a/tests/hermes_cli/test_kanban_pickup_stall_repin.py b/tests/hermes_cli/test_kanban_pickup_stall_repin.py
index b52b0ca5af..4ab8b0750d 100644
--- a/tests/hermes_cli/test_kanban_pickup_stall_repin.py
+++ b/tests/hermes_cli/test_kanban_pickup_stall_repin.py
@@ -177,6 +177,46 @@ def test_the_new_machine_must_be_eligible_now(board, change):
     assert board.why(machines=_machines(**{X: change})) is not None
 
 
+# t_01a1d0214f3e63e8 (2026-11-12): every eligible machine was a pool worker, and a move to ``machine:<pool worker>``
+# needs a host_reason no alarm path can pass (kanban_move_pool), so the alarm could re-place nothing. The pool queue
+# is the alarm's way off M whenever another pool worker is eligible now.
+POOL = "pool:worker"
+
+
+def _pooled(**over):
+    return _machines(**{X: {"labels": [*_worker(X)["labels"], POOL]}}, **over)
+
+
+def test_the_pool_queue_is_a_valid_target_when_another_pool_worker_is_eligible(board):
+    assert board.why(runs_on=[POOL], machines=_pooled()) is None
+
+
+@pytest.mark.parametrize("machines", [
+    lambda: _machines(),                                               # no machine carries the pool label
+    lambda: _pooled(worker_2={"hold": True}),                          # the only other pool worker is held
+    lambda: _pooled(worker_2={"metrics": {"active_card_runs": 10}}),  # ... or has no free slot
+    lambda: _pooled(worker_2={"last_seen": NOW - 301_000}),           # ... or was not seen recently
+    lambda: _machines(worker_1={"hold": False, "labels": [*_worker(M)["labels"], POOL]}),  # only M is pooled
+    lambda: None,                                                      # the registry is unreadable
+])
+def test_the_pool_queue_is_refused_when_no_other_pool_worker_is_eligible_now(board, machines):
+    why = rp.refusal(board.conn, board.target, board.alarm, [POOL], machines=machines(), now_ms=NOW)
+    assert why is not None and (POOL in why or "unreadable" in why), why
+
+
+@pytest.mark.parametrize("runs_on", [[POOL, "linux"], [POOL, f"machine:{X}"], ["pool:gpu"]])
+def test_the_pool_queue_is_exactly_the_pool_label(board, runs_on):
+    assert board.why(runs_on=runs_on, machines=_pooled(worker_2={
+        "labels": [*_worker(X)["labels"], POOL, "pool:gpu"]})) is not None
+
+
+def test_the_pool_queue_still_needs_the_cards_capabilities(board):
+    board.set(board.target, requires=json.dumps(["gpu"]))
+    assert "capability:gpu" in board.why(runs_on=[POOL], machines=_pooled())
+    assert board.why(runs_on=[POOL], machines=_pooled(
+        worker_2={"labels": [*_worker(X)["labels"], POOL, "capability:gpu"]})) is None
+
+
 def test_the_new_machine_needs_the_cards_required_capabilities(board):
     board.set(board.target, requires=json.dumps(["gpu"]))
     assert "capability:gpu" in board.why()
@@ -267,6 +307,22 @@ def test_the_alarms_run_re_places_each_listed_card_and_keeps_running(held):
     assert support.MACHINES[M]["hold"] is True  # the hold is the operator's: never lifted or shortened
 
 
+def test_the_alarms_run_re_places_a_listed_card_onto_the_pool_queue(held, monkeypatch):
+    hub, _worker_gw, alarm, (a, b), _unlisted = held
+    body = kb.get_task(hub.conn, alarm).body
+    assert f'runs_on=["{POOL}"]' in body  # the alarm recommends the pool queue first
+    out = _move(a, [POOL])  # worker-2 carries no pool label yet: nowhere on the pool can take it now
+    assert out.get("ok") is not True and POOL in out["error"], out
+    monkeypatch.setitem(support.MACHINES, X, {**support.MACHINES[X],
+                                              "labels": [*support.MACHINES[X]["labels"], POOL]})
+    hub.enter()  # re-read the registry
+    for tid in (a, b):
+        out = _move(tid, [POOL])
+        assert out.get("ok") is True, out
+        assert place._pin(hub.conn, tid) == [POOL]
+    assert kb.get_task(hub.conn, alarm).status == "running"
+
+
 def test_the_alarms_run_may_not_move_an_unlisted_card_or_back_onto_the_stalled_machine(held):
     hub, _worker_gw, _alarm, (a, _b), unlisted = held
     out = _move(unlisted, [f"machine:{X}"])
@@ -313,6 +369,12 @@ def test_an_alarm_caller_gets_the_same_scope_on_an_operator_call_move(fleet, mon
         f.h.execute("UPDATE tasks SET runs_on = ? WHERE id = ?", (json.dumps([f"machine:{M}"]), other))
     f.board()
     assert ask([f"machine:{X}"], target=other).get("code") == "pickup_stall_scope"
+    # The pool queue: granted while another pool worker is eligible now, refused when none is.
+    assert ask([POOL]).get("code") == "pickup_stall_scope"
+    monkeypatch.setattr(rp, "_registry_machines", lambda: _pooled())
+    assert ask([POOL])["verdict"] == "supervisor"
+    monkeypatch.setattr(rp, "_registry_machines", lambda: _pooled(worker_2={"hold": True}))
+    assert ask([POOL]).get("code") == "pickup_stall_scope"
     # A caller that is no alarm keeps the plain operator-call rules.
     with kb.write_txn(f.w):
         f.w.execute("UPDATE tasks SET created_by = 'default' WHERE id = ?", (f.caller,))
