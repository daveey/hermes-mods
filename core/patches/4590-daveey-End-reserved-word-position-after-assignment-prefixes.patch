From d7767e044e2a80febc1afe7aa799d2e5a4d584e7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 11:52:18 +0000
Subject: [PATCH] [daveey] End reserved-word position after assignment prefixes

Bash treats x=1 case as a simple command, not a case compound. Do not cache its closing substitution parenthesis as a pattern delimiter. Preserve builtin-name command lookup separately.

Proof: real-Bash marker, masking, date/data controls and lifecycle refusal regressions: 18 RED failures before repair; 755 targeted tests GREEN after repair. Full lifecycle suite running; main-relative check currently reports unrelated stale-base health drift, to be refreshed by canonical ship.
---
 tests/tools/test_shell_builtin_names.py | 19 +++++++++++++++++++
 tools/shell_case_words.py               |  8 +++-----
 2 files changed, 22 insertions(+), 5 deletions(-)

diff --git a/tests/tools/test_shell_builtin_names.py b/tests/tools/test_shell_builtin_names.py
index c24967df66b2932ab75cd111d42abfde7aa42760..acde6ce2002609b68d8143ef61920d2161ef6380 100644
--- a/tests/tools/test_shell_builtin_names.py
+++ b/tests/tools/test_shell_builtin_names.py
@@ -144,6 +144,9 @@ CASE_BODIES = [
     "case x in x) printf x;;& y) :;; esac",
     "case x in x) # ) case esac\n printf x;; esac",
     "printf '%s' case esac",
+    "x=1 case z in y",
+    "x=1 y=2 case z in y",
+    "x+=1 case z in y",
     "time case x in x) :;; esac",
     "time -p case x in x) :;; esac",
     "time { case x in x) :;; esac; }",
@@ -195,6 +198,22 @@ def test_case_boundary_masks_whole_substitution(body):
     assert mask_prefix_expansions('$(' + body + ') after') == '__expansion__ after'
 
 
+@pytest.mark.platforms("linux")
+@pytest.mark.parametrize("prefix", ["x=1", "x=1 y=2", "x+=1"])
+def test_assignment_prefix_case_cannot_hide_arithmetic_output(tmp_path, prefix):
+    from cron.lifecycle_guard import scan_gateway_lifecycle
+    from tests.cron.test_lifecycle_guard_arith_sink import _big_log
+    from tools.shell_heredoc import output_reaches_shell
+
+    shape = ('echo "$(' + prefix + ' case z in y)"; '
+             '[[ 1 -eq $(printf \'%s\' \'a[$(P)]\') ]]; echo ")"')
+    test_literal_builtin_name_marker(tmp_path, shape, True)
+    command = shape.replace("P", "bash " + str(_big_log(tmp_path)))
+    assert output_reaches_shell(command)
+    unsafe, refusal = scan_gateway_lifecycle(command, cwd=str(tmp_path))
+    assert unsafe and refusal and "larger than the scan cap" in refusal
+
+
 def test_failed_word_boundary_is_not_retried(monkeypatch):
     from tools import shell_builtin_names as names
 
diff --git a/tools/shell_case_words.py b/tools/shell_case_words.py
index be53fe9b87e93798671c0e752617e34c0ee6ae43..fcf1b072a8e590dcd600c276e1f5b770899556c2 100644
--- a/tools/shell_case_words.py
+++ b/tools/shell_case_words.py
@@ -5,10 +5,6 @@ word fragments; their own boundary walk has its own state.
 """
 from __future__ import annotations
 
-import re
-
-_ASSIGNMENT = re.compile(r"[A-Za-z_]\w*(?:\+)?=")
-
 
 class CaseWords:
     def __init__(self):
@@ -54,7 +50,9 @@ class CaseWords:
                 self.prefix = ""
             else:
                 self.prefix = ""
-                self.command = bool(_ASSIGNMENT.match(word)) or word in {
+                # Assignment words keep builtin lookup open, but end Bash's
+                # reserved-word position: `x=1 case` runs a command named case.
+                self.command = word in {
                     "if", "then", "elif", "else", "while", "until", "do", "!", "{",
                 }
 
