From 3ffbbbee9b26ad65b2206f1a95801983a02fc2fc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 21:53:51 -0700
Subject: [PATCH] ci: run the CI review comment poller on poll-only hub runners
 [daveey]

Long-running review pollers use a separate runner label so they do not
occupy test-runner slots. fork-ci-runner.sh preserves the routing across
upstream merges. Runner provisioning remains operator-owned.
---
 .github/workflows/ci-review-comment.yml | 4 +++-
 scripts/fork-ci-runner.sh               | 6 ++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/ci-review-comment.yml b/.github/workflows/ci-review-comment.yml
index 2d821b0e42..38ce1e54ab 100644
--- a/.github/workflows/ci-review-comment.yml
+++ b/.github/workflows/ci-review-comment.yml
@@ -46,7 +46,9 @@ jobs:
     if: >-
       github.event.workflow_run.event == 'pull_request' &&
       github.event.workflow_run.head_repository.full_name == github.repository
-    runs-on: [self-hosted, hermes-hub]
+    # [daveey] poll-only runners (label hermes-hub-poll ONLY, 0.5 CPU each): this
+    # poller lives up to 40-60 min and used to hold a test runner slot.
+    runs-on: [self-hosted, hermes-hub-poll]
     timeout-minutes: 60
     steps:
       - name: Checkout trusted default branch
diff --git a/scripts/fork-ci-runner.sh b/scripts/fork-ci-runner.sh
index c278141106..ab950b78f8 100755
--- a/scripts/fork-ci-runner.sh
+++ b/scripts/fork-ci-runner.sh
@@ -17,6 +17,12 @@ FILES=(ci.yaml tests.yml lint.yml js-tests.yml rust-tests.yml remote-backends.ym
 sed -i.bak -E 's/^([[:space:]]*runs-on:[[:space:]]*)(ubuntu-latest(-32-core)?|ubuntu-24\.04)[[:space:]]*$/\1[self-hosted, hermes-hub]/' "${FILES[@]}"
 rm -f ./*.bak
 
+# Long-lived pollers go to the poll-only runners (label `hermes-hub-poll` ONLY,
+# 0.5 CPU each; hosts/hermes-hub/gh-runner/ci-slice.sh install-poll), so they
+# never hold one of the test runners.
+sed -i.bak -E 's/^([[:space:]]*runs-on:[[:space:]]*)(\[self-hosted, hermes-hub\]|ubuntu-latest|ubuntu-24\.04)[[:space:]]*$/\1[self-hosted, hermes-hub-poll]/' ci-review-comment.yml
+rm -f ./*.bak
+
 # Docker-dependent jobs go to the rootless-docker runners (label `docker-ci`
 # ONLY, so plain [self-hosted, hermes-hub] jobs never land on them;
 # hosts/hermes-hub/gh-runner/setup-ci-docker.sh). Plain ubuntu jobs above stay
-- 
2.55.0

