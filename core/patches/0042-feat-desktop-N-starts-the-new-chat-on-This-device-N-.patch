+    await selectThisDeviceForNewChat()
+
+    expect(ensureGatewayAgent).toHaveBeenCalledWith('local', 'default', expect.anything())
+    expect($activeConnectionId.get()).toBe('local')
+    expect(requestFreshSession).toHaveBeenCalledTimes(1)
