+def _cli_drain(b):
+    return subprocess.run(
+        [sys.executable, "-m", "hermes_cli.main", "kanban", "supervisor-requests", "--drain", "--json"],
+        env=_child_env(b), cwd=str(REPO), capture_output=True, text=True, timeout=240, check=False)
