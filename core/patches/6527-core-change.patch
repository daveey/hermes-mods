From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 21:41:09 +0000
Subject: [PATCH 6527] Refusal boundary for refused providers

Public mirror of source commit 55951e97822d1558342dc00e794a7593cad36adc.

---
diff --git a/hermes_cli/kanban_refusal_boundary.py b/hermes_cli/kanban_refusal_boundary.py
index ce070a49fee..01b17f6c266 100644
--- a/hermes_cli/kanban_refusal_boundary.py
+++ b/hermes_cli/kanban_refusal_boundary.py
@@ -42,8 +42,8 @@
 def require_policy(policy, *, model=_UNSET, provider=_UNSET, request=False):
     """Fresh board read at real owner exec and worker construction, including saved policies.
 
-    ``request=True`` (outbound request): an ended claim (the run's own terminal board tool) is no longer
-    live, so only the provider fence applies; a live claim gets the full route check."""
+    ``request=True`` (outbound request): the same ended run with no successor claimant may finish its
+    reply on an unrefused provider; a live claim also requires a concrete route, not peer availability."""
     if policy is None or not getattr(policy, 'kanban_json', None):
         return
     from hermes_cli import kanban_db as kb
@@ -61,7 +61,7 @@
             if (task is None or task.status != 'running' or task.current_run_id != context['run_id']
                     or task.claim_lock != context['claim_lock'] or run is None
                     or tuple(run) != ('running', context['claim_lock'], None)):
-                # Closing reply: only the SAME run, ended by its own terminal tool, with no other claimant,
+                # Closing reply: only the SAME ended run (including reclaim), with no other claimant,
                 # on an unrefused concrete route. Never reopens tools/work or authorizes another claim.
                 if (request and task is not None and run is not None
                         and run['claim_lock'] == context['claim_lock'] and run['ended_at'] is not None
diff --git a/hermes_cli/kanban_review_model.py b/hermes_cli/kanban_review_model.py
index daf599babd7..5f5d5e6d6ed 100644
--- a/hermes_cli/kanban_review_model.py
+++ b/hermes_cli/kanban_review_model.py
@@ -453,6 +453,8 @@
     import time
     from hermes_cli import kanban_provider_walls as pw
     # Separate execution is enforced by verdict custody, not model identity.
+    from hermes_cli.kanban_refusal_fallback import refused_providers
+    safety_refused = set(refused_providers(conn, task.id))
     override = _override(conn, task)
     # A card's explicit paid class survives review only when no newer handoff
     # supersedes it. Ordinary review candidates must never select carbon.
@@ -479,6 +481,9 @@
 
     def _unavailable(model, provider, level="deep"):
         norm = pw._norm(provider)
+        if norm in safety_refused:
+            _candidate(collector, level, model, norm, now, (), ["safety_refused"])
+            return True  # A cooldown/deadline cannot restore a refused provider's authority.
         if not norm or norm == "auto":
             _candidate(collector, level, model, norm, now, (), ["provider_unresolved"])
             return True
@@ -515,7 +520,7 @@
     candidates = independent_routes(set(), cfg, assignee)
     independent_candidate = False
     for model, provider in candidates:
-        independent_candidate = True
+        independent_candidate |= pw._norm(provider) not in safety_refused
         if _unavailable(model, provider):
             continue
         if override and registry_refusal(model, provider, assignee):
@@ -526,7 +531,7 @@
         return model, provider, reason
     # Refused overrides retain their existing registered-deep-only recovery contract.
     for model, provider in (() if refusal else independent_routes(set(), cfg, assignee, level="standard")):
-        independent_candidate = True
+        independent_candidate |= pw._norm(provider) not in safety_refused
         if _unavailable(model, provider, "standard"):
             continue
         if override and registry_refusal(model, provider, assignee):
@@ -537,7 +542,7 @@
     detail = f"No eligible {levels} review route"
     if refusal and override:
         detail = f"review_model {override[0]!r} is refused here ({refusal.code}); {detail}"
-    if not independent_candidate and not override and not _downstream(task):
+    if not independent_candidate and not override and not _downstream(task) and not safety_refused:
         # Keep the normal profile/class tier route when no concrete review policy
         # is configured. Missing attribution must not disable legacy allocation.
         from hermes_cli.kanban_model_assignment import _assignee_config
