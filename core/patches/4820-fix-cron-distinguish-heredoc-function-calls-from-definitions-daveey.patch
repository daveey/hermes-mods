From ae20bbca395aa88010a31a47f26794299aca80a7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 06:08:48 +0000
Subject: [PATCH] fix(cron): distinguish heredoc function calls from
 definitions [daveey]

---
 cron/lifecycle_guard_nested_shells.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/cron/lifecycle_guard_nested_shells.py b/cron/lifecycle_guard_nested_shells.py
index 0bba4d965b849f27584e70943f69989fc9258eb3..a0d3307f4805ca5475e863e8b0cda3031e401f9a 100644
--- a/cron/lifecycle_guard_nested_shells.py
+++ b/cron/lifecycle_guard_nested_shells.py
@@ -1026,5 +1026,7 @@ def _calls_function(view: list[str], functions: frozenset[str]) -> bool:
 
 def _reaches_group(owner: str, functions: frozenset[str]) -> bool:
     """Whether a heredoc's *owner* text hands the body to a compound command or function call."""
-    return any(_compound_redirections(view) or _calls_function(view, functions)
+    return any(_compound_redirections(view) or (
+                   _calls_function(view, functions)
+                   and any(operator in {"<<", "<<-"} for _fd, operator, _target in _redirections(view)))
                for view in _iter_command_segment_views(owner))
-- 
