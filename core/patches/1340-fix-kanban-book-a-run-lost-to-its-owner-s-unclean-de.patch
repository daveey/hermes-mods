diff --git a/hermes_cli/kanban_owner_death.py b/hermes_cli/kanban_owner_death.py
new file mode 100644
index 00000000000..15b0c8e3ccd
--- /dev/null
+++ b/hermes_cli/kanban_owner_death.py
@@ -0,0 +1,142 @@
+"""Book a worker lost to its profile owner's DEATH like one lost to a restart. [daveey]
+
+2026-10-30 12:26 PDT, David-MBP: gateway 43117 segfaulted. Its 4 in-flight managed runs exited 1 a few
+seconds later ("[owner admission settled interrupted] Kanban owner refused: Gateway inaccessible:
+service_identity_unverified"); three shared that fingerprint, so the sweep's systemic rule tripped them
+straight into sticky triage on their first failure. A clean restart of the same gateway books the same runs
+``owner_restart_lost`` and charges nothing; an unclean death is no more the cards' fault.
+
+A crashed run is rebooked as ``owner_restart_lost`` (``infrastructure: true``, no failure counted, respawn
+spaced by ``check_respawn_guard``) when BOTH hold:
+
+- the worker reports its owner unavailable (``OWNER_GONE_MARKERS`` in the run error or worker output), and
+- the owner named by the run's ``owner_admitted`` receipt is gone: the owner's lifecycle ledger
+  (``logs/gateway-exit-diag.log``) records that pid's life as UNCLEAN, or the pid is dead/recycled.
+
+Crash-loop guard: a card that was also in flight at the owner's PREVIOUS unclean death is charged normally
+(``owner_death_repeat``), because a card whose own work kills the gateway has to stop.
+"""
+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+from typing import Optional
+
+# Lower-case substrings of what a worker says when its owner went away under it.
+OWNER_GONE_MARKERS = (
+    "service_identity_unverified",
+    "owner admission settled interrupted",
+)
+# A ``worker_lost`` note counts only when its reason names the owner going away: the live owner records
+# ``managed_worker_failed`` & co. for a worker that died on its own, which stays the card's crash.
+_OWNER_GONE_LOSS = re.compile(r"managed worker lost: [^\]]*(owner|gateway|shutdown|restart)")
+_EXIT_DIAG_TAIL_BYTES = 256 * 1024
+_RUN_SCAN_LIMIT = 20
+
+
+def unclean_owner_deaths(owner_home: Path) -> list[int]:
+    """Prior pids the owner's ledger recorded as UNCLEAN exits, oldest first. ``[]`` when unreadable."""
+    path = owner_home / "logs" / "gateway-exit-diag.log"
+    try:
+        with path.open("rb") as fh:
+            fh.seek(0, 2)
+            size = fh.tell()
+            fh.seek(max(0, size - _EXIT_DIAG_TAIL_BYTES))
+            data = fh.read().decode("utf-8", "replace")
+    except OSError:
+        return []
+    deaths: list[int] = []
+    for line in data.splitlines():
+        try:
+            record = json.loads(line)
+        except ValueError:
+            continue
+        if not isinstance(record, dict) or record.get("tag") != "gateway.previous_unclean_exit":
+            continue
+        try:
+            pid = int(record["prior_pid"])
+        except (KeyError, TypeError, ValueError):
+            continue
+        if not deaths or deaths[-1] != pid:
+            deaths.append(pid)
+    return deaths
+
+
+def _reports_owner_gone(dead) -> bool:
+    text = f"{dead.error_text}\n{dead.event_payload.get('worker_output') or ''}".lower()
+    return any(marker in text for marker in OWNER_GONE_MARKERS) or bool(_OWNER_GONE_LOSS.search(text))
+
+
+def _earlier_owner_death_pids(conn, task_id: str) -> list[int]:
+    """``owner_death_pid`` of the card's closed runs, newest first (``None`` for a run without one)."""
+    out = []
+    for row in conn.execute(
+        "SELECT metadata FROM task_runs WHERE task_id = ? AND ended_at IS NOT NULL ORDER BY id DESC LIMIT ?",
+        (task_id, _RUN_SCAN_LIMIT),
+    ):
+        try:
+            meta = json.loads(row[0]) if row[0] else {}
+        except (TypeError, ValueError):
+            meta = {}
+        pid = meta.get("owner_death_pid") if isinstance(meta, dict) else None
+        out.append(int(pid) if isinstance(pid, int) else None)
+    return out
+
+
+def _previous_death_seen(conn, task_id: str, owner_pid: int, deaths: list[int]) -> Optional[int]:
+    """The owner's previous unclean death this card was ALSO in flight at, or None."""
+    earlier = _earlier_owner_death_pids(conn, task_id)
+    if owner_pid in deaths:
+        idx = deaths.index(owner_pid)
+        previous = deaths[idx - 1] if idx > 0 else None
+    else:
+        previous = deaths[-1] if deaths else None
+    if previous is not None:
+        return previous if previous in earlier else None
+    # No ledger to order the deaths: the card's last closed run was lost to another owner death.
+    if earlier and earlier[0] is not None and earlier[0] != owner_pid:
+        return earlier[0]
+    return None
+
+
+def note(dead, conn, task_id: Optional[str], run_id) -> None:
+    """Rebook ``dead`` (``_DeadWorker``) lost to its owner's death as ``owner_restart_lost``. No-op for
+    any other death; a crash-loop repeat stays a crash and is tagged so the systemic rule skips it."""
+    if conn is None or not task_id or dead.kind in ("clean_exit", "rate_limited", "owner_restart", "oom_killed"):
+        return
+    if (dead.protocol_violation or dead.rate_limited or dead.terminal_provider or dead.host_reboot
+            or dead.owner_unavailable or dead.owner_restart or dead.reboot_culprit):
+        return
+    if not _reports_owner_gone(dead):
+        return
+    from hermes_cli.kanban_owner_recovery import _owner_process_gone, _owner_receipt
+    receipt = _owner_receipt(conn, task_id)
+    if not receipt:
+        return
+    try:
+        owner_pid = int(receipt["pid"])
+        owner_home = Path(receipt["db"]).parent
+    except (KeyError, TypeError, ValueError):
+        return
+    deaths = unclean_owner_deaths(owner_home)
+    unclean = owner_pid in deaths
+    if not unclean and not _owner_process_gone(receipt):
+        return  # the owner that admitted this run is still alive: not an owner death
+    payload = dead.event_payload
+    payload["owner_death_pid"] = owner_pid
+    payload["owner_exit"] = "unclean" if unclean else "pid_changed"
+    repeat = _previous_death_seen(conn, task_id, owner_pid, deaths)
+    if repeat is not None:
+        payload["owner_death_repeat"] = repeat
+        dead.error_text = (
+            f"{dead.error_text} (owner pid {owner_pid} died with this card in flight, as pid {repeat} did "
+            "before it: counted as a failure)")
+        return
+    original = dead.error_text
+    dead.kind, dead.owner_restart, dead.event_kind = "owner_restart", True, "owner_restart_lost"
+    payload.update(exit_kind="owner_restart", owner_restart=True, infrastructure=True)
+    how = "an unclean exit" if unclean else "its pid changed since the claim"
+    dead.error_text = (
+        f"pid {payload.get('pid')} lost its turn to the death of its profile owner (pid {owner_pid}, {how}) — "
+        f"requeued without counting a failure; worker said: {original}")
diff --git a/hermes_cli/kanban_systemic_crash.py b/hermes_cli/kanban_systemic_crash.py
new file mode 100644
index 00000000000..c32ee0f2ef9
--- /dev/null
+++ b/hermes_cli/kanban_systemic_crash.py
@@ -0,0 +1,87 @@
+"""Give a systemic crash trip a visible owner: one fix card per fingerprint. [daveey]
+
+The dead-worker sweep trips cards whose crash fingerprint repeats >= 3 times in one tick at once (a retry
+would hit the same wall). It used to park them in sticky triage "for an operator" with no card, ask or
+owner, so nothing ever looked at them (2026-10-30 12:26 PDT, David-MBP, 3 cards for 35 min).
+
+Now the sweep opens ONE fix card per fingerprint (idempotency key ``systemic-crash:<hash>``, reused across
+ticks while it is open), and each tripped card is linked as its child: it waits on the fix card instead of a
+sticky hold, and ``recompute_ready`` resumes it when the fix card is done (within the failure budget).
+"""
+from __future__ import annotations
+
+import hashlib
+import logging
+import sqlite3
+from typing import Optional
+
+_log = logging.getLogger(__name__)
+AUTHOR = "kanban-dispatcher"
+_MAX_ROUNDS = 20
+
+
+def fix_key(fingerprint: str) -> str:
+    return "systemic-crash:" + hashlib.sha1(fingerprint.encode("utf-8")).hexdigest()[:16]
+
+
+def _open_card(conn: sqlite3.Connection, key: str) -> tuple[Optional[str], bool]:
+    """``(id, reusable)`` of the newest non-archived card with ``key``; ``(None, True)`` when none."""
+    row = conn.execute(
+        "SELECT id, status FROM tasks WHERE idempotency_key = ? AND status != 'archived' "
+        "ORDER BY created_at DESC LIMIT 1", (key,)).fetchone()
+    if row is None:
+        return None, True
+    return row["id"], row["status"] != "done"
+
+
+def ensure_fix_card(conn: sqlite3.Connection, fingerprint: str, task_ids: list[str], sample_error: str,
+                    assignee: Optional[str]) -> Optional[str]:
+    """The open fix card for ``fingerprint`` (created on first sight), or None when it cannot be made.
+
+    A done fix card did not fix it (the same crash is back): the next round's key (``:r2``...) opens a
+    fresh card. Each call names its tripped cards in a comment on the fix card.
+    """
+    from hermes_cli import kanban_db as kb
+    base = fix_key(fingerprint)
+    try:
+        for n in range(1, _MAX_ROUNDS + 1):
+            key = base if n == 1 else f"{base}:r{n}"
+            existing, reusable = _open_card(conn, key)
+            if existing and not reusable:
+                continue
+            listed = ", ".join(task_ids)
+            if existing:
+                kb.add_comment(conn, existing, AUTHOR,
+                               f"The same crash tripped {len(task_ids)} more card(s): {listed}. "
+                               "They wait on this card as children.")
+                return existing
+            body = (
+                f"{len(task_ids)} Kanban workers crashed with the same error in one dispatcher tick, so the "
+                "sweep tripped their cards instead of retrying into the same wall.\n\n"
+                f"Fingerprint: `{fingerprint}`\n\nSample error:\n```\n{sample_error[:500]}\n```\n\n"
+                f"Tripped cards (children of this card): {listed}\n\n"
+                "Find and fix the root cause of this crash. When this card is done, the tripped cards resume "
+                "on their own (they are linked as its children). Do not re-queue them by hand.")
+            return kb.create_task(
+                conn, title=f"Systemic Kanban crash: {len(task_ids)} cards died with `{fingerprint[:60]}`",
+                body=body, assignee=assignee, created_by=AUTHOR, idempotency_key=key)
+    except Exception:
+        _log.warning("kanban: opening the systemic-crash fix card failed", exc_info=True)
+    return None
+
+
+def attach(conn: sqlite3.Connection, fix_id: str, task_id: str) -> bool:
+    """Link a tripped card under its fix card and say so on the card. False when the link failed."""
+    from hermes_cli import kanban_db as kb
+    try:
+        kb.link_tasks(conn, fix_id, task_id)
+    except Exception:
+        _log.warning("kanban: linking %s under systemic fix card %s failed", task_id, fix_id, exc_info=True)
+        return False
+    try:
+        kb.add_comment(conn, task_id, AUTHOR,
+                       f"Tripped by a systemic crash shared with other cards. Fix card {fix_id} owns it; this "
+                       "card resumes when that card is done.")
+    except Exception:
+        _log.debug("kanban: systemic-trip comment failed", exc_info=True)
+    return True
diff --git a/tests/hermes_cli/test_kanban_owner_death.py b/tests/hermes_cli/test_kanban_owner_death.py
new file mode 100644
index 00000000000..2fb143eecf2
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_owner_death.py
@@ -0,0 +1,219 @@
+"""One unclean owner death must not park every in-flight Kanban card in sticky triage. [daveey]
+
+2026-10-30 12:26 PDT, David-MBP: gateway 43117 segfaulted; its in-flight managed runs exited 1 with
+"[owner admission settled interrupted] Kanban owner refused: Gateway inaccessible:
+service_identity_unverified", three shared that fingerprint, and the systemic rule tripped them into
+sticky triage with no owner (t_01a18db7ce134b33, t_01a18e08b1e764a1, t_01a18e122934644d).
+
+* A run lost to its owner's death (owner-unavailable words + an unclean ledger record or a gone owner
+  pid) is booked ``owner_restart_lost``, uncounted, however many die together.
+* A card in flight at two consecutive unclean owner deaths is charged.
+* A real systemic trip opens ONE fix card per fingerprint and the tripped cards wait on it.
+"""
+
+import json
+import os
+import time
+
+import psutil
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as kbd
+from hermes_cli.kanban_block_routing import has_sticky_block
+from hermes_cli.kanban_systemic_crash import fix_key
+
+DEAD_OWNER = 43117
+REFUSAL = "Kanban owner refused: Gateway inaccessible: service_identity_unverified"
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_KANBAN_CRASH_GRACE_SECONDS", "0")
+    me = os.getpid()
+    monkeypatch.setattr(kb, "_pid_alive", lambda pid: pid == me)  # every worker and the old owner are dead
+    output = {"text": REFUSAL}
+    monkeypatch.setattr(kbd, "_worker_final_output", lambda *a, **kw: output["text"])
+    owner_home = tmp_path / "owner"
+    (owner_home / "logs").mkdir(parents=True)
+    return {"home": tmp_path, "owner_home": owner_home, "output": output}
+
+
+def _ledger(board, *dead_pids):
+    with (board["owner_home"] / "logs" / "gateway-exit-diag.log").open("a") as fh:
+        for pid in dead_pids:
+            fh.write(json.dumps({"ts": "2026-10-30T19:26:23Z", "tag": "gateway.previous_unclean_exit",
+                                 "pid": pid + 1, "prior_pid": pid}) + "\n")
+
+
+def _claim(conn, tid, pid, board, owner_pid=DEAD_OWNER, birth=1.0):
+    host = kb._claimer_id().split(":", 1)[0]
+    kb.claim_task(conn, tid, claimer=f"{host}:w{pid}")
+    run_id = _task(conn, tid).current_run_id
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET worker_pid=?, started_at=? WHERE id=?", (pid, int(time.time()) - 600, tid))
+        kb._append_event(conn, tid, "owner_admitted",
+                         {"db": str(board["owner_home"] / "state.db"), "session_id": "s", "request_id": f"r{pid}",
+                          "pid": owner_pid, "birth": birth}, run_id=run_id)
+        kb._append_event(conn, tid, "worker_bound", {"pid": pid + 500000, "started_at": "x"}, run_id=run_id)
+    return tid
+
+
+def _reaped(monkeypatch, pids, code=1):
+    monkeypatch.setattr(kbd, "_recent_worker_exits", {pid: ((code & 0xFF) << 8, time.time()) for pid in pids})
+
+
+def _kinds(conn, tid):
+    return [r[0] for r in conn.execute("SELECT kind FROM task_events WHERE task_id=? ORDER BY id", (tid,))]
+
+
+def _last_payload(conn, tid, kind):
+    row = conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind=? ORDER BY id DESC LIMIT 1",
+                       (tid, kind)).fetchone()
+    return json.loads(row[0]) if row and row[0] else {}
+
+
+def test_runs_lost_to_an_unclean_owner_death_requeue_uncounted(board, monkeypatch):
+    _ledger(board, DEAD_OWNER)
+    with kbc.connect() as conn:
+        pids = [81001, 81002, 81003, 81004]
+        tids = [_claim(conn, kb.create_task(conn, title=f"card {p}", assignee="default"), p, board) for p in pids]
+        _reaped(monkeypatch, pids)
+        assert kbd.detect_crashed_workers(conn) == []
+        assert kbd.detect_crashed_workers._last_auto_blocked == []  # type: ignore[attr-defined]
+        for tid in tids:
+            task = _task(conn, tid)
+            assert (task.status, task.consecutive_failures) == ("ready", 0)
+            kinds = _kinds(conn, tid)
+            assert "gave_up" not in kinds and "crashed" not in kinds
+            payload = _last_payload(conn, tid, "owner_restart_lost")
+            assert payload["owner_death_pid"] == DEAD_OWNER and payload["infrastructure"] is True
+            assert payload["owner_exit"] == "unclean"
+            outcome, error = conn.execute(
+                "SELECT outcome, error FROM task_runs WHERE task_id=? ORDER BY id DESC LIMIT 1", (tid,)).fetchone()
+            assert outcome == "reclaimed" and f"pid {DEAD_OWNER}" in error
+            assert kbd.check_respawn_guard(conn, tid) == "owner_restart_cooldown"
+        assert not conn.execute("SELECT 1 FROM tasks WHERE idempotency_key LIKE 'systemic-crash:%'").fetchone()
+
+
+def test_owner_pid_gone_without_a_ledger_record_requeues_too(board, monkeypatch):
+    with kbc.connect() as conn:
+        pids = [82001, 82002, 82003]
+        tids = [_claim(conn, kb.create_task(conn, title=f"card {p}", assignee="default"), p, board) for p in pids]
+        _reaped(monkeypatch, pids)
+        assert kbd.detect_crashed_workers(conn) == []
+        for tid in tids:
+            assert (_task(conn, tid).status, _task(conn, tid).consecutive_failures) == ("ready", 0)
+            assert _last_payload(conn, tid, "owner_restart_lost")["owner_exit"] == "pid_changed"
+
+
+@pytest.mark.parametrize("reason, requeued", [("owner gone: gateway shutdown", True),
