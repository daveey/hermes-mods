Subject: [PATCH] test(notifications): prove mixed-result dispatch and refusal
 custody [daveey]

---
 .../test_notification_remote_retry.py         | 53 +++++++++++++++++++
 1 file changed, 53 insertions(+)

diff --git a/tests/tui_gateway/test_notification_remote_retry.py b/tests/tui_gateway/test_notification_remote_retry.py
index 1fc85d5ffd2c86a56404747d077d17824fcfbe73..97f67f08d412ac9d9647b59bdab7329bd10cc9d8 100644
--- a/tests/tui_gateway/test_notification_remote_retry.py
+++ b/tests/tui_gateway/test_notification_remote_retry.py
@@ -66,6 +66,59 @@ def test_remote_collector_failure_cancels_callback_retry(own, monkeypatch):
     assert len(failures) == 1 and "collector failed" in str(failures[0][1])
 
 
+@pytest.mark.parametrize("accepted", [True, False, None], ids=["accepted", "submit-refused", "owner-refused"])
+def test_mixed_local_notice_remote_defer_real_dispatch(own, monkeypatch, accepted):
+    import threading
+    from hermes_state import SessionDB
+    from tests.tui_gateway.test_j_nonrpc_rows import _complete_local
+
+    replica, ledger = own
+    home = ledger.parent.parent
+    clock = [100.0]
+    monkeypatch.setattr(sn, "time", SimpleNamespace(monotonic=lambda: clock[0], time=lambda: fixtures.NOW))
+    monkeypatch.setattr(kri, "_clock", lambda: clock[0])
+    monkeypatch.setattr(krn.time, "time", lambda: fixtures.NOW)
+    monkeypatch.setattr(sn, "_launch_home", lambda: home)
+    monkeypatch.setattr(sn, "_session_lineage", lambda key: ())
+    monkeypatch.setattr(sn, "_kb_gateway_owns", lambda session: False)
+    monkeypatch.setattr(sn, "_kb_stray_delegate_keys", lambda *a: ())
+    monkeypatch.setattr(sn, "_session_profile_runtime_scope", lambda s: contextlib.nullcontext())
+    monkeypatch.setattr(sn, "_kb_owner_refusal", lambda *a: "not owner" if accepted is None else None)
+    monkeypatch.setattr(sn, "_emit", lambda *a: None)
+    fixtures._lease()
+    assert kri.refresh(replica, ledger, now=fixtures.NOW)
+    fixtures._poll()
+    fixtures._add(replica, fixtures._done("t_remote_wait"), 50)
+    tid = _complete_local(fixtures.CHAT, "local mixed", "local done")
+    submitted = []
+
+    def submit(rid, sid, session, text, **kwargs):
+        submitted.append(text)
+        sn._notif_release_turn(session)
+        return accepted
+
+    monkeypatch.setattr(sn, "_notif_run_submit", submit)
+    with SessionDB(home / "state.db") as db:
+        db.create_session(fixtures.CHAT, "desktop")
+        monkeypatch.setattr(sn, "_get_db", lambda: db)
+        session = {"session_key": fixtures.CHAT, "history": [], "history_lock": threading.RLock()}
+        sn._notif_poll_kanban("sid", session)
+        assert ("_kanban_remote_retry_at" in session) == bool(accepted)
+        if accepted is None:
+            assert not submitted and not db.get_messages(fixtures.CHAT)
+            # Real cursor rewind/claim release makes the local notice collectable again.
+            again = sn._collect_kanban_notifications(session, [])
+            assert any(tid in text for text in again)
+        else:
+            assert len(submitted) == 1 and tid in submitted[0]
+            assert sum(tid in row["content"] for row in db.get_messages(fixtures.CHAT)) == 1
+        assert not session.get("_kanban_claims")
+        if not accepted:
+            assert session.get("_kanban_refused_until", 0) > clock[0]
+        else:
+            assert not session.get("_kanban_pending")
+
+
 @pytest.mark.parametrize("outcome", ["empty_hit", "defer", "mixed_ok", "binding", "release_error",
                                     "refused", "_closing", "_finalized", "_lease_taken_over", "exception"])
 def test_poll_attempt_keeps_only_valid_deferral(monkeypatch, outcome):
