From 02d4edd8005c74339dd555065585225c6158ecd1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 05:03:21 +0000
Subject: [PATCH] test(kanban): pin the wall clock in board rows cache equality
 tests

test_board_payload_matches_a_cold_read and test_unchanged_board_materializes_rows_once
compare whole board payloads read moments apart. Task ages are whole seconds of
time.time(), so a throttled CI runner that straddles a second boundary between reads
sees created_age_seconds differ (0 vs 1) and the equality fails. Freeze time.time()
after setup so every compared read shares one clock second.

Reproduced deterministically with a 1.1s stall before the cold read: fails on main,
passes with the fix.
---
 tests/plugins/test_kanban_board_rows_cache.py | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/tests/plugins/test_kanban_board_rows_cache.py b/tests/plugins/test_kanban_board_rows_cache.py
index 5dda44cd781..4c9ecfef5b4 100644
--- a/tests/plugins/test_kanban_board_rows_cache.py
+++ b/tests/plugins/test_kanban_board_rows_cache.py
@@ -95,9 +95,20 @@ def _strip_now(body):
     return {k: v for k, v in body.items() if k != "now"}
 
 
-def test_unchanged_board_materializes_rows_once(env):
+def _freeze_wall(monkeypatch):
+    """Pin time.time() so reads compared for equality share one clock second.
+
+    Task ages are whole seconds of time.time(); on a CPU-throttled runner two reads a few
+    milliseconds apart can straddle a second boundary and differ only in created_age_seconds.
+    """
+    t = float(int(time.time()))
+    monkeypatch.setattr(time, "time", lambda: t)
+
+
+def test_unchanged_board_materializes_rows_once(env, monkeypatch):
     mod, sql_reads, _home = env
     tid = _create("first")
+    _freeze_wall(monkeypatch)
     bodies = [_read(mod) for _ in range(5)]
     assert len(sql_reads) == 1
     assert tid in _cards(bodies[0])
@@ -391,7 +402,7 @@ def test_snapshot_refresh_cadence_reprojects_unchanged_board(env, monkeypatch):
     assert len(sql_reads) == 1
 
 
-def test_board_payload_matches_a_cold_read(env):
+def test_board_payload_matches_a_cold_read(env, monkeypatch):
     """A projection over retained rows equals a read with no retained rows."""
     mod, _sql_reads, _home = env
     parent = _create("parent", skills=["a"])
@@ -401,6 +412,7 @@ def test_board_payload_matches_a_cold_read(env):
         kb.add_comment(conn, parent, "me", "hello")
     finally:
         conn.close()
+    _freeze_wall(monkeypatch)
     _read(mod)
     warm = _read(mod)
     _clear_rows()
