+def test_review_out_of_requeues_is_dropped_with_a_log_line(root, fence, queue, monkeypatch, caplog):
+    calls, in_call, finish_call, done = [], threading.Event(), threading.Event(), threading.Event()
+    agent = _spawning_agent()
