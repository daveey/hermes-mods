 gateway/session_worker_credentials.py         |  3 +++
 tests/e2e/core/kanban/_helpers.py             | 21 ++++++++++++++++++-
 .../kanban/test_kanban_rate_limit_review.py   | 13 +++++++++---
 .../gateway/test_managed_worker_env_compat.py | 13 ++++++++++++
 4 files changed, 46 insertions(+), 4 deletions(-)

diff --git a/gateway/session_worker_credentials.py b/gateway/session_worker_credentials.py
index 2c5ff35c34..a912f2d8b5 100644
--- a/gateway/session_worker_credentials.py
+++ b/gateway/session_worker_credentials.py
@@ -17,6 +17,9 @@ EXEC_ENV = frozenset({
     'USERPROFILE', 'APPDATA', 'LOCALAPPDATA', 'HOMEDRIVE', 'HOMEPATH',
     'SSH_AUTH_SOCK', 'DISPLAY', 'XDG_CONFIG_HOME', 'XDG_DATA_DIRS', 'LD_LIBRARY_PATH',
     'TERM', 'KUBECONFIG', 'HERMES_BUNDLED_SKILLS',
+    # Host board policy, not task identity: the failed-result observer must book
+    # the same quota backoff as the dispatcher, including the documented zero.
+    'HERMES_KANBAN_RATE_LIMIT_COOLDOWN_SECONDS',
 })
 
 
diff --git a/tests/e2e/core/kanban/_helpers.py b/tests/e2e/core/kanban/_helpers.py
index e01d325b2d..71eb47fe49 100644
--- a/tests/e2e/core/kanban/_helpers.py
+++ b/tests/e2e/core/kanban/_helpers.py
@@ -83,6 +83,25 @@ class Board:
             + self.extra_config,
             encoding="utf-8",
         )
+        # Kanban requires class routing even when the profile has a concrete default.
+        # Exercise the real allocator and credential boundary, never an admission stub.
+        from urllib.parse import urlsplit
+        assert urlsplit(self.base_url).hostname == "127.0.0.1", self.base_url
+        route = {
+            "provider": "custom", "model": "fake-model", "billing": "metered",
+            "weight": 1, "eligible": True, "funding_verified": True,
+            "capabilities": {"tools": True, "streaming": True, "context_tokens": 200000},
+        }
+        # Metered permission is confined to this disposable home and dummy loopback pool.
+        policy = {"enabled": True, "allow_metered": True, "policy_version": 1,
+                  "routes": {level: [route] for level in ("fast", "standard", "deep")}}
+        with (self.hermes_home / "config.yaml").open("a", encoding="utf-8") as config:
+            config.write("\nmodel_routing: " + json.dumps(policy) + "\n")
+        (self.hermes_home / "auth.json").write_text(json.dumps({
+            "version": 1, "credential_pool": {"custom": [{
+                "id": "loopback", "source": "manual", "auth_type": "api_key",
+                "access_token": "loopback-only", "base_url": self.base_url,
+            }]}}), encoding="utf-8")
         (self.hermes_home / ".env").write_text("OPENAI_API_KEY=sk-fake-e2e\n", encoding="utf-8")
         # Workers run with cwd=<task workspace>; the wrapper pins THIS checkout on the path.
         self.hermes_bin = self.root / "hermes-bin"
@@ -185,5 +204,5 @@ class Board:
     def diag(self, tid: str) -> str:
         return (f"task={json.dumps(self.task(tid), default=str)[:1500]}\n"
                 f"runs={json.dumps(self.runs(tid), default=str)[:2500]}\n"
-                f"events={[(e['kind'], e['payload']) for e in self.events(tid)][-15:]}\n"
+                f"events={json.dumps([(e['kind'], e['payload']) for e in self.events(tid)][-15:], indent=2)}\n"
                 f"log tail:\n{self.worker_log(tid)[-2500:]}")
diff --git a/tests/e2e/core/kanban/test_kanban_rate_limit_review.py b/tests/e2e/core/kanban/test_kanban_rate_limit_review.py
index bd5cf3678b..50a0418885 100644
--- a/tests/e2e/core/kanban/test_kanban_rate_limit_review.py
+++ b/tests/e2e/core/kanban/test_kanban_rate_limit_review.py
@@ -44,7 +44,7 @@ pytestmark = [
 # with a marker in the scratch home tells a reviewer's prompt apart without reading prompt wording.
 REVIEW_SKILL = "sdlc-review"
 REVIEW_MARK = "E2E_REVIEW_LANE_SKILL_5d21c9"
-REVIEW_MODEL = "fake-review-model"  # distinct from the implementer's fake-model
+REVIEW_MODEL = "fake-model"  # independence is a separate execution, not a model name
 RATE_LIMIT_EXIT_CODE = 75  # KANBAN_RATE_LIMIT_EXIT_CODE — documented worker exit contract
 MAX_TICKS = 6  # a healthy rate-limited card is done on tick 3; the rest prove "forever"
 
@@ -115,10 +115,12 @@ class TwoRoleModel:
             return ToolCall("kanban_complete", {"summary": "review: approved"})
         impl_no = sum(1 for a in self.attempts if a.role == "impl")
         if impl_no <= self.rate_limited_attempts:
-            return Error(status=429, message="Rate limit exceeded: quota for this key", retry_after=0)
+            # A zero/expired hint correctly falls back to the real pool's default cooldown.
+            # Give the server a short future reset so the next process tick can retry.
+            return Error(status=429, message="Rate limit exceeded: quota for this key", retry_after=1)
         return ToolCall("kanban_request_review", {
             "summary": "implementation ready for review",
-            "metadata": {"review_model": REVIEW_MODEL, "review_provider": "custom"},
+            "metadata": {"review_model": "class:deep"},
         })
 
     def by_role(self, role: str) -> list[Attempt]:
@@ -226,6 +228,11 @@ def test_clean_handoff_spawns_the_reviewer_on_the_next_tick(tmp_path: Path) -> N
     b, tid, diag = f.board, f.tid, f.diag()
     assert b.task(tid)["status"] == "done", diag
     assert f.run_outcomes() == ["review_requested", "completed"], diag
+    tiers = [e["payload"] for e in b.events(tid, "model_tier")]
+    assert [(t["model"], t["provider"]) for t in tiers] == [
+        ("class:standard", "auto"), (REVIEW_MODEL, "custom")], diag
+    owners = b.events(tid, "owner_admitted")
+    assert len(owners) == 2 and len({e["payload"]["session_id"] for e in owners}) == 2, diag
     assert [t["spawned"] for t in f.ticks] == [1, 1], diag
     assert not any(t["guarded"] for t in f.ticks), diag
     assert [(a.role, a.tick) for a in f.model.attempts] == [("impl", 1), ("review", 2)], diag
diff --git a/tests/gateway/test_managed_worker_env_compat.py b/tests/gateway/test_managed_worker_env_compat.py
index 190b53f865..daabc6108f 100644
--- a/tests/gateway/test_managed_worker_env_compat.py
