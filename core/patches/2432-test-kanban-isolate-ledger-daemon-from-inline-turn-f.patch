From 3bfae7cf703b032918e72205333125e0fc1e1e9c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 03:25:19 +0000
Subject: [PATCH] test(kanban): isolate ledger daemon from inline turn fixtures
 [daveey]

---
 tests/tui_gateway/test_goal_command.py            | 3 +++
 tests/tui_gateway/test_refused_turn_retry.py      | 3 +++
 tests/tui_gateway/test_relay_live_author.py       | 3 +++
 tests/tui_gateway/test_update_pause_superseded.py | 4 ++++
 4 files changed, 13 insertions(+)

diff --git a/tests/tui_gateway/test_goal_command.py b/tests/tui_gateway/test_goal_command.py
index bd6127c6e5..414d3aa1dc 100644
--- a/tests/tui_gateway/test_goal_command.py
+++ b/tests/tui_gateway/test_goal_command.py
@@ -117,6 +117,9 @@ def turn_env(server, monkeypatch, tmp_path):
     """Neutralize side paths unrelated to post-turn goal continuation."""
     emitted = []
     monkeypatch.setattr(server.threading, "Thread", _InlineThread)
+    # Inline turn execution must not inline the process-lifetime ledger daemon.
+    from hermes_cli import kanban_session_activity as activity
+    monkeypatch.setattr(activity, "_refresh_links_in_background", lambda scope: None)
     monkeypatch.setattr(
         server,
         "_emit",
diff --git a/tests/tui_gateway/test_refused_turn_retry.py b/tests/tui_gateway/test_refused_turn_retry.py
index ce852a2b22..7184e8e97a 100644
--- a/tests/tui_gateway/test_refused_turn_retry.py
+++ b/tests/tui_gateway/test_refused_turn_retry.py
@@ -31,6 +31,9 @@ def marker_home(monkeypatch, tmp_path):
 @pytest.fixture()
 def turn_env(monkeypatch, tmp_path, marker_home):
     monkeypatch.setattr(server.threading, "Thread", _InlineThread)
+    # Inline turn execution must not inline the process-lifetime ledger daemon.
+    from hermes_cli import kanban_session_activity as activity
+    monkeypatch.setattr(activity, "_refresh_links_in_background", lambda scope: None)
     monkeypatch.setattr(server, "_wire_callbacks", lambda sid: None)
     monkeypatch.setattr(server, "_sync_agent_model_with_config", lambda sid, session: None)
     monkeypatch.setattr(server, "_session_cwd", lambda session: str(tmp_path))
diff --git a/tests/tui_gateway/test_relay_live_author.py b/tests/tui_gateway/test_relay_live_author.py
index 16ab5d563b..28ee891cee 100644
--- a/tests/tui_gateway/test_relay_live_author.py
+++ b/tests/tui_gateway/test_relay_live_author.py
@@ -50,6 +50,9 @@ class _InlineThread:
 @pytest.fixture()
 def turn_env(monkeypatch, tmp_path):
     monkeypatch.setattr(srv.threading, "Thread", _InlineThread)
+    # Inline turn execution must not inline the process-lifetime ledger daemon.
+    from hermes_cli import kanban_session_activity as activity
+    monkeypatch.setattr(activity, "_refresh_links_in_background", lambda scope: None)
     for name in ("_emit", "_wire_callbacks", "_sync_agent_model_with_config", "_register_session_cwd",
                  "_tts_stream_begin", "_sync_session_key_after_compress"):
         monkeypatch.setattr(srv, name, lambda *a, **k: None)
diff --git a/tests/tui_gateway/test_update_pause_superseded.py b/tests/tui_gateway/test_update_pause_superseded.py
index 70fe5122d4..a2b8ba8c5a 100644
--- a/tests/tui_gateway/test_update_pause_superseded.py
+++ b/tests/tui_gateway/test_update_pause_superseded.py
@@ -45,6 +45,10 @@ def env(monkeypatch, tmp_path):
     monkeypatch.setattr(server, "_hermes_home", tmp_path)
     monkeypatch.setattr(server, "_load_cfg", lambda: CFG)
     monkeypatch.setattr(server.threading, "Thread", _InlineThread)
+    # This fixture runs turn threads inline, not process-lifetime ledger daemons.
+    # Outcome derivation may read warm links; projection refresh is tested separately.
+    from hermes_cli import kanban_session_activity as activity
+    monkeypatch.setattr(activity, "_refresh_links_in_background", lambda scope: None)
     monkeypatch.setattr(server, "_emit", lambda *a, **k: None)
     monkeypatch.setattr(server, "_wire_callbacks", lambda sid: None)
     monkeypatch.setattr(server, "_sync_agent_model_with_config", lambda sid, session: None)
-- 
