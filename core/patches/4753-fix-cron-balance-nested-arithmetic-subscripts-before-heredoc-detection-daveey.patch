From 4b9c22acb64a64ba9b1d531096669bd11a5a2d93 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 01:33:56 +0000
Subject: [PATCH] fix(cron): balance nested arithmetic subscripts before
 heredoc detection [daveey]

---
 cron/lifecycle_guard_lines.py                 | 29 +++++++++++++++++--
 .../test_lifecycle_guard_nested_subscripts.py | 24 +++++++++++++++
 2 files changed, 50 insertions(+), 3 deletions(-)
 create mode 100644 tests/cron/test_lifecycle_guard_nested_subscripts.py

diff --git a/cron/lifecycle_guard_lines.py b/cron/lifecycle_guard_lines.py
index 2a452d0ff00dec398110a91f0f73bb90348e6892..1635776f29f11e38a3e5bcb1f66aa74a2d3730da 100644
--- a/cron/lifecycle_guard_lines.py
+++ b/cron/lifecycle_guard_lines.py
@@ -169,10 +169,11 @@ class _HereDocs:
         """Advance on the character at *pos*; when it is the newline before complete bodies,
         return the position after them, else *pos*."""
         char = text[pos]
-        if char == "[" and _arithmetic_bracket(text, pos):
-            self._bracket_end = text.find("]", pos + 1)
         if pos <= self._bracket_end:
             return pos
+        if char == "[" and _arithmetic_bracket(text, pos):
+            self._bracket_end = _bracket_end(text, pos)
+            return pos
         if char == "(" and self._arith < 0 and text.startswith("((", pos):
             self._arith = depth
         elif char == ")" and depth - 1 == self._arith:
@@ -190,11 +191,33 @@ class _HereDocs:
         return pos
 
 
+def _bracket_end(text: str, pos: int) -> int:
+    """Find the balanced closing bracket, ignoring quoted or escaped brackets."""
+    depth = 1
+    pos += 1
+    while pos < len(text):
+        char = text[pos]
+        if char == "\\":
+            pos += 2
+            continue
+        if char in "'\"`":
+            pos = _quoted_end(text, pos + 1, char, escapes=char != "'")
+            continue
+        if char == "[":
+            depth += 1
+        elif char == "]":
+            depth -= 1
+            if not depth:
+                return pos
+        pos += 1
+    return -1
+
+
 def _arithmetic_bracket(text: str, pos: int) -> bool:
     """Legacy arithmetic expansion or an assignment subscript, not literal ``[``."""
     if text[pos - 1:pos] == "$":
         return True
-    end = text.find("]", pos + 1)
+    end = _bracket_end(text, pos)
     return end >= 0 and text.startswith(("=", "+="), end + 1) and bool(
         re.search(r"(?:^|[\s;|(])[A-Za-z_][A-Za-z_0-9]*$", text[:pos]))
 
diff --git a/tests/cron/test_lifecycle_guard_nested_subscripts.py b/tests/cron/test_lifecycle_guard_nested_subscripts.py
new file mode 100644
index 0000000000000000000000000000000000000000..a134a7dbf503eae9fd8ac8a78e0717826295ccbb
--- /dev/null
+++ b/tests/cron/test_lifecycle_guard_nested_subscripts.py
@@ -0,0 +1,24 @@
+"""Nested arithmetic brackets must not turn shifts into here-documents."""
+
+import pytest
+
+from cron.lifecycle_guard import scan_gateway_lifecycle
+from tests.cron import test_lifecycle_guard_comment_words as h
+
+
+@pytest.mark.parametrize("body,tail", [
+    ("a[b[0]<<2]=3", "2]=3"),
+    ("echo $[a[0]<<2]", "2]"),
+    ("a[b[c[0]]<<2]=3", "2]=3"),
+    ("echo $[a[b[0]]<<2]", "2]"),
+])
+@pytest.mark.parametrize("outer", [False, True])
+@pytest.mark.parametrize("dangerous", [True, False])
+def test_nested_subscripts_do_not_hide_following_command(tmp_path, body, tail, outer, dangerous):
+    h._tree(tmp_path)
+    following = "bash ./r.sh" if dangerous else "python3 ./clean.py"
+    command = 'echo "${x:-$(' + body + '\n)}"; ' + following + '\n' + tail
+    if outer:
+        command = '(\n' + command + '\n)'
+    assert h._bash_runs(tmp_path, command) is dangerous
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path))[0] is dangerous, repr(command)
