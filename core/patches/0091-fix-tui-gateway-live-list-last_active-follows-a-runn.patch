From 90e467744bd9cdd1025b0324fb547cb3fdfca568 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 15 Oct 2026 12:51:48 -0700
Subject: [PATCH] fix(tui-gateway): live-list last_active follows a running
 turn's activity clock [daveey]

session.active_list reported last_active as the turn's START time (it is only
stamped at turn start/end). Desktop's rehydrateLiveSessionStatuses marks a
working row stalled once last_active is 5+ min old, so every turn longer than
5 min painted the red 'stuck' sidebar stripe while its tools were running;
opening the session streamed events that cleared it, which looked like an
instant resume. Fold in the agent's _last_activity_ts (and the compute-host
activity stamp for isolated turns) for running sessions.
---
 tests/tui_gateway/test_tui_gateway_server.py | 45 ++++++++++++++++++++
 tui_gateway/server.py                        | 23 +++++++++-
 2 files changed, 67 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_tui_gateway_server.py b/tests/tui_gateway/test_tui_gateway_server.py
index c270a0e763..33f6bf88cf 100644
--- a/tests/tui_gateway/test_tui_gateway_server.py
+++ b/tests/tui_gateway/test_tui_gateway_server.py
@@ -17715,6 +17715,51 @@ def test_session_active_list_reports_live_sessions(monkeypatch):
     assert rows["sid-b"]["preview"] == "writing code"
 
 
+def test_session_active_list_last_active_follows_running_turn_activity(monkeypatch):
+    """[daveey] A running turn's ``last_active`` must track the agent's activity clock, not the
+    prompt's start: Desktop paints a turn whose ``last_active`` is 5+ min old as stalled (red
+    sidebar stripe), so every turn longer than 5 min read as stuck while its tools ran."""
+    import time as _time
+
+    previous_sessions = dict(server._sessions)
+    server._sessions.clear()
+    monkeypatch.setattr(server, "_get_db", lambda: None)
+    now = _time.time()
+    server._sessions["busy"] = _session(
+        agent=types.SimpleNamespace(model="m", _last_activity_ts=now - 3.0),
+        running=True, session_key="k-busy", created_at=now - 900, last_active=now - 900,
+    )
+    # Isolated (compute-host) turn: activity arrives as a perf_counter_ns stamp.
+    server._sessions["iso"] = _session(
+        agent=types.SimpleNamespace(model="m"),
+        running=True, session_key="k-iso", created_at=now - 900, last_active=now - 900,
+        _compute_host_turn_id="t1", _compute_host_activity_ns=_time.perf_counter_ns() - 2_000_000_000,
+    )
+    # Control: an idle session keeps its stored stamp even if the agent clock is newer
+    # (idle rows sort/read by their last turn, not background bookkeeping).
+    server._sessions["idle"] = _session(
+        agent=types.SimpleNamespace(model="m", _last_activity_ts=now - 1.0),
+        session_key="k-idle", created_at=now - 900, last_active=now - 600,
+    )
+    # Control: a running turn that really went quiet stays old.
+    server._sessions["quiet"] = _session(
+        agent=types.SimpleNamespace(model="m", _last_activity_ts=now - 800),
+        running=True, session_key="k-quiet", created_at=now - 900, last_active=now - 900,
+    )
+    try:
+        resp = server.handle_request({"id": "1", "method": "session.active_list", "params": {}})
+    finally:
+        server._sessions.clear()
+        server._sessions.update(previous_sessions)
+
+    rows = {row["id"]: row for row in resp["result"]["sessions"]}
+    assert now - rows["busy"]["last_active"] < 30
+    assert now - rows["iso"]["last_active"] < 30
+    assert rows["idle"]["last_active"] == pytest.approx(now - 600)
+    assert rows["quiet"]["last_active"] == pytest.approx(now - 800)
+    assert all(row["last_active"] <= _time.time() + 1 for row in rows.values())
+
+
 def test_session_active_list_excludes_finalized_sessions(monkeypatch):
     """#38950: a finalized-but-not-yet-popped session must not inflate the count.
 
diff --git a/tui_gateway/server.py b/tui_gateway/server.py
index 1aeddbf13a..da5d97de9c 100644
--- a/tui_gateway/server.py
+++ b/tui_gateway/server.py
@@ -3062,6 +3062,27 @@ def _session_live_title(session: dict, key: str) -> str:
     return title
 
 
+def _session_live_last_active(session: dict, now: float) -> float:
+    """[daveey] ``last_active`` for a live-list row. ``session["last_active"]`` is stamped only when a
+    turn starts or ends, so for a RUNNING turn fold in the agent's activity clock (stamped by API waits,
+    stream tokens and tool heartbeats; isolated turns mirror it as ``_compute_host_activity_ns``).
+    Desktop reads a running row whose ``last_active`` is 5+ min old as stalled (red sidebar stripe), so
+    without this every turn longer than 5 min painted stuck while its tools were still running."""
+    stamp = float(session.get("last_active") or session.get("created_at") or now)
+    if not session.get("running"):
+        return stamp
+    candidates = [stamp]
+    with contextlib.suppress(Exception):
+        ts = getattr(session.get("agent"), "_last_activity_ts", None)
+        if isinstance(ts, (int, float)) and not isinstance(ts, bool):
+            candidates.append(float(ts))
+    with contextlib.suppress(Exception):
+        ns = session.get("_compute_host_activity_ns")
+        if session.get("_compute_host_turn_id") and isinstance(ns, int) and not isinstance(ns, bool):
+            candidates.append(now - max(0.0, (time.perf_counter_ns() - ns) / 1_000_000_000))
+    return min(max(candidates), now)
+
+
 def _session_live_item(sid: str, session: dict, current_sid: str = "") -> dict:
     key = _session_lookup_key(session, fallback=sid)
     agent = session.get("agent")
@@ -3078,7 +3099,7 @@ def _session_live_item(sid: str, session: dict, current_sid: str = "") -> dict:
     now = time.time()
     return {
         "current": sid == current_sid, "id": sid,
-        "last_active": float(session.get("last_active") or session.get("created_at") or now),
+        "last_active": _session_live_last_active(session, now),
         "message_count": len(history),
         "model": str(getattr(agent, "model", "") or _resolve_model()), "preview": preview,
         "session_key": key, "started_at": float(session.get("created_at") or now), "status": status,
