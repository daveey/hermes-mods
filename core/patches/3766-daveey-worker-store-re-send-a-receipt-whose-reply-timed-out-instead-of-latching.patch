index b3d5f4ae90..518f4bf59a 100644
--- a/agent/turn_facade_lease.py
+++ b/agent/turn_facade_lease.py
@@ -381,15 +381,21 @@ class DurableTurnLease:
         except Exception as exc:
             if self.stop.is_set():
                 return False
+            from agent.runtime_session_store import is_retryable_owner_error
             from hermes_state_errors import is_sqlite_lock_error
 
