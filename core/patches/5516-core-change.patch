From 14596971ff7f0bb9547422a1c95b46744d2a8b53 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 13:04:12 +0000
Subject: [PATCH] fix(kanban): keep standalone sync schema independent of tasks
 [daveey]

---
 docs/designs/kanban-frozen-replay.md                |  2 ++
 hermes_cli/kanban_db_sync.py                        | 11 +++++------
 tests/hermes_cli/test_kanban_sync_origin_repairs.py | 10 ++++++++++
 3 files changed, 17 insertions(+), 6 deletions(-)

diff --git a/docs/designs/kanban-frozen-replay.md b/docs/designs/kanban-frozen-replay.md
index d10209b12e..19b73298fb 100644
--- a/docs/designs/kanban-frozen-replay.md
+++ b/docs/designs/kanban-frozen-replay.md
@@ -25,6 +25,8 @@ Independent Worker review of PR180 found another failure: generic server HLC sta
 
 Broad CI of native head4de59d3a then caught shared-transaction integration regressions: boundary-only connection adapters return no cursor, minimal revision stores expose tasks without status (SQLite accepts NEW.status at trigger CREATE time but fails later DML), and the new descriptor foreign key blocked identity-replacement cleanup. Local untouched consumer assertions reproduced8 failures across3 files (`core-clock-consumer-red.log`). Arm capture only after checking its actual schema/cursor contract; revoke the descriptor BEFORE task-ID mutation rather than transfer its provenance. Added a replacement-specific descriptor assertion; all13 selected files now pass187 tests,0 failures (`core-clock-final13.log`). Earlier narrower selections missed these facade-level write_txn consumers, so they are now explicit regression coverage; this does not substitute for another broad CI run.
 
+The next broad run at0dc03e exposed the same family at a different entry: standalone `SYNC_SCHEMA_SQL` consumers intentionally have no `tasks` table, so the identity-cleanup CREATE TRIGGER failed at schema boot. Three unchanged drain consumer files reproduced RED, and a fresh/repeated standalone-schema regression failed before repair. The task-specific trigger now lives in `wanted_triggers`, where application tables exist; FK cleanup and identity revocation remain unchanged. Six-file validation including all three drain consumers, origin capture/repairs and native identity replacement passes51 tests (`core-schema-green2.log`). This extends integration coverage rather than modifying the drain fixtures to hide the dependency.
+
 ## Coverage boundaries
 
 - Pre-upgrade or unbound historical uncertain sends cannot recover their original envelope or origin. Legacy ambiguity after reopen remains documented; never claim universal old-client safety.
diff --git a/hermes_cli/kanban_db_sync.py b/hermes_cli/kanban_db_sync.py
index 3f7448d01f..04e04008ca 100644
--- a/hermes_cli/kanban_db_sync.py
+++ b/hermes_cli/kanban_db_sync.py
@@ -201,12 +201,6 @@ CREATE TABLE IF NOT EXISTS kanban_sync_status_origins (
     origin TEXT,
     status TEXT
 );
--- A primary-key replacement is a different task identity, not an origin
--- transfer. Remove the old descriptor before SQLite checks the child FK.
-CREATE TRIGGER IF NOT EXISTS kanban_status_origin_identity
-BEFORE UPDATE OF id ON tasks WHEN OLD.id IS NOT NEW.id BEGIN
-    DELETE FROM kanban_sync_status_origins WHERE task_id = OLD.id;
-END;
 -- First-send synthetic parents are pending transport, not a permanent receipt ledger.
 CREATE TABLE IF NOT EXISTS kanban_sync_parent_envelopes (
     task_id TEXT PRIMARY KEY,
@@ -677,6 +671,11 @@ def _delete_trigger(table: str) -> str:
 def wanted_triggers(conn: sqlite3.Connection) -> dict[str, str]:
     """Trigger name -> CREATE statement, generated from the live column list."""
     out: dict[str, str] = {
+        # Application-table triggers belong here, not the independently usable
+        # SYNC_SCHEMA_SQL. Replacing an identity revokes rather than transfers
+        # its descriptor before the child FK is checked.
+        "kanban_sync_origin_identity": "CREATE TRIGGER kanban_sync_origin_identity BEFORE UPDATE OF id ON tasks "
+        "WHEN OLD.id IS NOT NEW.id BEGIN DELETE FROM kanban_sync_status_origins WHERE task_id=OLD.id; END",
         "kanban_sync_origin_invalidate": "CREATE TRIGGER kanban_sync_origin_invalidate AFTER UPDATE OF status ON tasks "
         "WHEN OLD.status IS NOT NEW.status BEGIN DELETE FROM kanban_sync_status_origins WHERE task_id=NEW.id; END",
         "kanban_sync_origin_delete": "CREATE TRIGGER kanban_sync_origin_delete AFTER DELETE ON tasks "
diff --git a/tests/hermes_cli/test_kanban_sync_origin_repairs.py b/tests/hermes_cli/test_kanban_sync_origin_repairs.py
index 8d57310287..75ae3f048a 100644
--- a/tests/hermes_cli/test_kanban_sync_origin_repairs.py
+++ b/tests/hermes_cli/test_kanban_sync_origin_repairs.py
@@ -1,5 +1,6 @@
 """Capture provenance survives definitive compatibility repairs, never uncertain rewrites."""
 import json
+import sqlite3
 
 import pytest
 
@@ -13,6 +14,15 @@ from tests.hermes_cli import test_kanban_sync_envelope as fixtures
 board = fixtures.board
 
 
+def test_standalone_sync_schema_needs_no_application_tables():
+    with sqlite3.connect(":memory:") as conn:
+        for _ in range(2):
+            conn.executescript(sync.SYNC_SCHEMA_SQL)
+            assert not conn.execute("SELECT 1 FROM sqlite_master WHERE name='tasks'").fetchone()
+            conn.execute("INSERT OR REPLACE INTO kanban_sync_parent_envelopes VALUES ('task', '{}')")
+        assert conn.execute("SELECT COUNT(*) FROM kanban_sync_parent_envelopes").fetchone()[0] == 1
+
+
 @pytest.mark.parametrize("repair", ["parent", "virtual", "omission"])
 def test_definitive_repair_retains_captured_origin_and_freezes_next_send(board, repair):
     conn, _ = board
