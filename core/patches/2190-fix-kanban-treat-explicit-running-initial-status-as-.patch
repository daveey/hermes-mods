From 34547e9f027279ff3c92a21e2ccf9fd0adec137c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 09:05:41 +0000
Subject: [PATCH] fix(kanban): treat explicit running initial status as
 portable default [daveey]

---
 hermes_cli/kanban_placement.py                   |  5 ++++-
 tests/hermes_cli/test_kanban_worker_placement.py | 15 +++++++++++++++
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index d7cabc82e8..202a00b6b8 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -420,7 +420,10 @@ def portable_reason(args: dict, cfg: Optional[dict] = None) -> Optional[str]:
         return "non-default board"
     if (args.get("assignee") or "default") not in c.assignees():
         return "assignee not allowlisted"
-    if any(args.get(k) not in (None, "", [], False) for k in UNCARRIED_OPTIONS):
+    # Explicit tool defaults are equivalent to omission, as on the CLI path.
+    # A blocked initial status still needs origin-side human-request handling.
+    if any(args.get(k) not in (None, "", [], False)
+           for k in UNCARRIED_OPTIONS if not (k == "initial_status" and args.get(k) == "running")):
         return "uncarried option"
     reqs = args.get("requires") or []
     reqs = [reqs] if isinstance(reqs, str) else list(reqs)
diff --git a/tests/hermes_cli/test_kanban_worker_placement.py b/tests/hermes_cli/test_kanban_worker_placement.py
index c761afd677..3b91684764 100644
--- a/tests/hermes_cli/test_kanban_worker_placement.py
+++ b/tests/hermes_cli/test_kanban_worker_placement.py
@@ -31,6 +31,21 @@ def test_portable_reason_retains_conservative_exclusions(fields):
     assert pooled == legacy
 
 
+@pytest.mark.parametrize("status,reason", [(None, None), ("running", None), ("blocked", "uncarried option")])
+def test_explicit_default_initial_status_preserves_portability(status, reason):
+    args = {"title": "Analyze public data", "requires": ["terminal"], "initial_status": status}
+    before = dict(args)
+    assert placement.portable_reason(args, {}) == reason
+    result = placement.decide(args, cfg={"worker_pools": {"hub": ["worker-1"]}}, self_gw="hub")
+    assert (result.get("placement_policy") == "worker-first-v1") == (reason is None)
+    assert args == before
+
+
+def test_running_status_does_not_hide_other_uncarried_options():
+    args = {"title": "Analyze public data", "initial_status": "running", "max_retries": 2}
+    assert placement.portable_reason(args, {}) == "uncarried option"
+
+
 def test_extra_home_marker_remains_an_exclusion():
     assert placement.portable_reason({"title": "Inspect special-device"}, {"extra_home_markers": ["special-device"]})
 
-- 
2.55.0

