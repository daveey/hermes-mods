From 8d1ca16533790641b13a05bcfd2f48b4b3abf099 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 19:32:39 -0700
Subject: [PATCH] fix(kanban): find hermes-hub without the login shell PATH;
 placed cards name host:<gw> to route back [daveey]

Live drill of default placement on the MacBook: the worker/gateway interpreter (Hermes Python.app,
launchd PATH) has no ~/.local/bin, so 'hermes-hub create-task' raised ENOENT and the card fell
back to a local one. Capability routing's owner cards used the same bare name and would have failed
the same way on the MacBook. kanban_capability_registry.hub_cli_path(): configured hub_cli, else
PATH, else ~/.local/bin/hermes-hub. The placed card's footer now names needs=['host:<gw>'] (the
MacBook publishes host:macbook via a shared probe).
---
 hermes_cli/kanban_capability_registry.py  | 19 +++++++++++++++++++
 hermes_cli/kanban_capability_routing.py   |  4 +---
 hermes_cli/kanban_placement.py            |  3 ++-
 tests/hermes_cli/test_kanban_placement.py | 21 +++++++++++++++++++++
 tools/kanban_tools.py                     |  2 +-
 5 files changed, 44 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_capability_registry.py b/hermes_cli/kanban_capability_registry.py
index b26acc2439..fc52a552e4 100644
--- a/hermes_cli/kanban_capability_registry.py
+++ b/hermes_cli/kanban_capability_registry.py
@@ -152,6 +152,25 @@ def self_gateway() -> Optional[str]:
         return None
 
 
+def hub_cli_path(configured=None) -> str:
+    """The hermes-hub executable. [daveey]
+
+    Gateway and worker processes (launchd, Hermes Python.app) run without the login shell's PATH, so
+    the installer's ``~/.local/bin`` is usually missing there: a bare ``hermes-hub`` raised ENOENT and
+    every cross-gateway create silently failed. Order: configured value, PATH, ``~/.local/bin``.
+    """
+    import shutil
+
+    if isinstance(configured, str) and configured.strip():
+        value = os.path.expanduser(configured.strip())
+        return shutil.which(value) or value
+    found = shutil.which("hermes-hub")
+    if found:
+        return found
+    fallback = Path.home() / ".local" / "bin" / "hermes-hub"
+    return str(fallback) if fallback.exists() else "hermes-hub"
+
+
 def _ro(path: Path):
     import sqlite3
     if not path.exists():
diff --git a/hermes_cli/kanban_capability_routing.py b/hermes_cli/kanban_capability_routing.py
index ca8fdf503a..5f22f3d0ce 100644
--- a/hermes_cli/kanban_capability_routing.py
+++ b/hermes_cli/kanban_capability_routing.py
@@ -80,9 +80,7 @@ def needs_from_requires(requires) -> list[str]:
 
 
 def _hub_cli() -> str:
-    cfg = reg._config()
-    value = cfg.get("hub_cli")
-    return value if isinstance(value, str) and value.strip() else "hermes-hub"
+    return reg.hub_cli_path(reg._config().get("hub_cli"))
 
 
 def _owner_assignee() -> str:
diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 3a537db09a..dad135a0f7 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -256,7 +256,8 @@ def remote_body(args: dict, *, self_gw: str, target: str) -> str:
         f"Placed on {target} by {self_gw}'s default placement rule (kanban.placement): nothing in the card "
         f"named a {self_gw}-only need. If you hit something only {self_gw} has (its Chrome profile, Keychain, "
         f"Apple apps, launchd or Desktop state, AWS SSO profiles, ssh to the mini, a checkout this host "
-        f"lacks), block with needs=[<capability>] so capability routing opens an owner card on {self_gw}; "
+        f"lacks), block with needs=['host:{self_gw}'] (or the exact capability, e.g. "
+        f"'aws:<account>:admin', 'ssh:mini') so capability routing opens an owner card on {self_gw}; "
         "don't park or ask David.")
     return (body + "\n\n---\n" + "\n".join(extra)).strip()
 
diff --git a/tests/hermes_cli/test_kanban_placement.py b/tests/hermes_cli/test_kanban_placement.py
index 8dce6b1543..feb17450ae 100644
--- a/tests/hermes_cli/test_kanban_placement.py
+++ b/tests/hermes_cli/test_kanban_placement.py
@@ -273,3 +273,24 @@ def test_retry_reuses_the_request_id():
     assert kp.request_id("macbook", {"title": "t", "idempotency_key": "k"}, "s1") == \
         kp.request_id("macbook", {"title": "other", "idempotency_key": "k"}, "s1")
     assert len(a) <= 128 and reg.is_gateway_need("x:y")  # ids fit hermes-hub's alphabet/length
+
+
+def test_hub_cli_resolves_without_the_login_shell_path(tmp_path, monkeypatch):
+    """Gateway/worker processes have no ~/.local/bin on PATH: a bare 'hermes-hub' raised ENOENT."""
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("PATH", str(tmp_path / "empty"))
+    assert reg.hub_cli_path() == "hermes-hub"  # nothing installed: unchanged (the caller's error names it)
+    exe = tmp_path / ".local" / "bin" / "hermes-hub"
+    exe.parent.mkdir(parents=True)
+    exe.write_text("#!/bin/sh\n")
+    exe.chmod(0o755)
+    assert reg.hub_cli_path() == str(exe)
+    assert reg.hub_cli_path(str(tmp_path / "custom")) == str(tmp_path / "custom")  # configured wins
+    from hermes_cli import kanban_capability_routing as kcr
+    monkeypatch.setattr(reg, "_config", lambda: {})
+    assert kcr._hub_cli() == str(exe)
+
+
+def test_remote_body_names_the_capability_to_route_back_with():
+    body = kp.remote_body({"body": "Do it."}, self_gw="macbook", target="hub")
+    assert "needs=['host:macbook']" in body and reg.is_gateway_need("host:macbook")
diff --git a/tools/kanban_tools.py b/tools/kanban_tools.py
index 5a9b7d3772..7b633995fa 100644
--- a/tools/kanban_tools.py
+++ b/tools/kanban_tools.py
@@ -1439,7 +1439,7 @@ def _place_remote(args: dict, *, assignee: str, skills, parents, project_id, ses
         cfg = kp.config()
         placed = kp.create_remote(view, target=target, origin_session=session_id,
                                   origin_profile=current_profile_name("default") or "default",
-                                  self_gw=self_gw, cfg=cfg, hub_cli=cfg.get("hub_cli") or "hermes-hub")
+                                  self_gw=self_gw, cfg=cfg, hub_cli=reg.hub_cli_path(cfg.get("hub_cli")))
         if not placed.get("ok"):
             logger.warning("kanban placement: %s refused the card (%s); creating it locally",
                            target, placed.get("error"))
