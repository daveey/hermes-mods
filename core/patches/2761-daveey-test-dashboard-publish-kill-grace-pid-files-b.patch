From b38b8d78cd986bed0a839f5185ccdd9b71c9312a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 14:05:12 +0000
Subject: [PATCH] [daveey] test(dashboard): publish kill-grace pid files by
 rename so a starved child never hands out ''
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

test_wedged_pty_descendant_is_gone_but_detached_bot_survives flaked on CI with
`ValueError: invalid literal for int() with base 10: ''` reading bot.pid. The
backend stand-in waits only for the pid files to exist, and Path.write_text
creates the file empty before writing it: a detached bot descheduled between the
two lets the backend signal ready and the test read an empty pid.

The wedged TUI and detached bot now write <path>.tmp and os.replace it into
place, so existence implies content. Proven: widening the write_text create→write
gap to 0.5 s reproduces the exact CI error on the base and passes with the fix;
15/15 green under a SIGSTOP/SIGCONT duty cycle.

[card:t_01a1d00ceec6c960]
---
 tests/hermes_cli/test_dashboard_procs_kill_grace.py | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_dashboard_procs_kill_grace.py b/tests/hermes_cli/test_dashboard_procs_kill_grace.py
index e32b0053d3..6ff2cc8721 100644
--- a/tests/hermes_cli/test_dashboard_procs_kill_grace.py
+++ b/tests/hermes_cli/test_dashboard_procs_kill_grace.py
@@ -35,13 +35,17 @@ _IGNORING_CHILD = textwrap.dedent(
     """
 )
 
+# The pid files are published by rename: the backend waits on their existence, and write_text
+# creates the file empty before writing, so a child descheduled in between would hand out ''.
+
 # A wedged hosted TUI: ignores SIGTERM and the SIGHUP its PTY master's close delivers.
 _WEDGED_DESCENDANT = textwrap.dedent(
     """
     import os, pathlib, signal, sys, time
     signal.signal(signal.SIGTERM, signal.SIG_IGN)
     signal.signal(signal.SIGHUP, signal.SIG_IGN)
-    pathlib.Path(sys.argv[1]).write_text(str(os.getpid()))
+    pathlib.Path(sys.argv[1] + ".tmp").write_text(str(os.getpid()))
+    os.replace(sys.argv[1] + ".tmp", sys.argv[1])
     time.sleep(300)
     """
 )
@@ -49,7 +53,8 @@ _WEDGED_DESCENDANT = textwrap.dedent(
 _DETACHED_BOT = textwrap.dedent(
     """
     import os, pathlib, sys, time
-    pathlib.Path(sys.argv[1]).write_text(str(os.getpid()))
+    pathlib.Path(sys.argv[1] + ".tmp").write_text(str(os.getpid()))
+    os.replace(sys.argv[1] + ".tmp", sys.argv[1])
     time.sleep(300)
     """
 )
