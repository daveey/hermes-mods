From d2dfe257611516bcbd6083508c13f76f08523547 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:02:03 +0000
Subject: [PATCH] [daveey] Drain workflow replay input before recording
 arguments

---
 tests/ci/test_macos_state_superseded.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/ci/test_macos_state_superseded.py b/tests/ci/test_macos_state_superseded.py
index 5b7b5ca35e..a8807a60a3 100644
--- a/tests/ci/test_macos_state_superseded.py
+++ b/tests/ci/test_macos_state_superseded.py
@@ -86,7 +86,7 @@ def test_workflow_passes_delegation_only_for_nonrelease_pr(event, release, expec
     step = next(step for step in job["steps"] if "run" in step)
     env = {key: gha.to_string(gha.render(value, ctx)) for key, value in step["env"].items()}
     # Execute the workflow's shell argument construction, recording its CLI boundary.
-    shim = 'python3() { printf "%s\\n" "$@"; }; export -f python3\n'
+    shim = 'python3() { cat >/dev/null; printf "%s\\n" "$@"; }; export -f python3\n'
     proc = subprocess.run(["bash", "-eo", "pipefail", "-c", shim + gha.render(step["run"], ctx)],
                           cwd=ROOT, env=env, text=True, encoding="utf-8", capture_output=True,
                           timeout=30, check=False)
-- 
