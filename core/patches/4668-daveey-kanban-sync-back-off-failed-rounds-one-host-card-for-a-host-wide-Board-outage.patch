+    support.write_sync_config(h, True)
+    monkeypatch.setattr(replica_age, "_core_sha", lambda: "2cc7101849aa")
+    monkeypatch.setattr(ksc, "load_identity", lambda: (_ for _ in ()).throw(ksc.SyncUnavailable("no Board in tests")))
+    return h
