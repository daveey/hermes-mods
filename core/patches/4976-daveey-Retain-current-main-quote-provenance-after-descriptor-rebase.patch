Subject: [PATCH] [daveey] Retain current main quote provenance after
 descriptor rebase

---
 cron/lifecycle_guard_words.py | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/cron/lifecycle_guard_words.py b/cron/lifecycle_guard_words.py
index 3ed4804e190674c5cd748d7f5d884bd71173749f..508a60976172fc27a51ba325c8a8df80982e39b8 100644
--- a/cron/lifecycle_guard_words.py
+++ b/cron/lifecycle_guard_words.py
@@ -71,13 +71,10 @@ def tokenize_redirections(line: str, tokenize: Callable[[str], list[str]],
         if escaped:
             escaped = False
         elif ch == "\\" and not single:
-            protected.append(quote_marker)
             escaped = True
         elif ch == "'" and not double:
-            protected.append(quote_marker)
             single = not single
         elif ch == '"' and not single:
-            protected.append(quote_marker)
             double = not double
         protected.append(replacements.get(ch, ch) if literal or ch == marker else ch)
 
