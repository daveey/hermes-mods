From 7914492409ac86fcd84d9812dd32347314f563d6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 21:21:01 +0000
Subject: [PATCH] test(accounting): measure thread instrumentation CPU, not
 idle wall time [daveey]

Occurrence57 job135109479331 reported 69.3us wall overhead against the unchanged 50us budget, then passed isolated retry. Separate baseline/enabled wall samples charge unrelated descheduling to instrumentation. Use process CPU, which includes both parent and target threads. Keep 300 lifecycles, three samples and the exact assertion.

Proof: canonical retries-disabled controlled idle-gap RED 1 pass/1 fail (348us); fixed wholefile GREEN24/0 twice. Adding 200us real CPU per wrapped child kills both benchmark cases (212/220us). Restored product source, final wholefile24/0; scripts/check21 OK. Historical scheduling attribution remains unproven; controlled proof establishes a sufficient mechanism.
---
 .../test_loop_accounting_thread_targets.py    | 26 ++++++++++++++++---
 1 file changed, 23 insertions(+), 3 deletions(-)

diff --git a/tests/hermes_cli/test_loop_accounting_thread_targets.py b/tests/hermes_cli/test_loop_accounting_thread_targets.py
index da62d7dfb2..5484bb6576 100644
--- a/tests/hermes_cli/test_loop_accounting_thread_targets.py
+++ b/tests/hermes_cli/test_loop_accounting_thread_targets.py
@@ -323,20 +323,40 @@ def test_lifetime_reset_clears_both_target_maps(clear):
     assert la._target_exited == {}
 
 
-def test_thread_start_overhead_is_small():
+@pytest.mark.parametrize("scheduling_gap", [False, True])
+def test_thread_start_overhead_is_small(monkeypatch, scheduling_gap):
     """One wrapped thread lifecycle adds two lock rounds: pin the added cost under 50 µs per thread."""
+    if scheduling_gap:
+        original_join = threading.Thread.join
+        joined = 0
+        idle = threading.Event()
+
+        def delayed_join(thread, *args, **kwargs):
+            nonlocal joined
+            result = original_join(thread, *args, **kwargs)
+            joined += 1
+            # Give each enabled sample an idle scheduling gap after the first
+            # lifecycle. Waiting adds wall time, not instrumentation CPU work.
+            if joined > 900 and (joined - 901) % 300 == 0:
+                idle.wait(0.1)
+            return result
+
+        monkeypatch.setattr(threading.Thread, "join", delayed_join)
+
     def noop():
         pass
 
     def per_thread(n: int) -> float:
         best = float("inf")
         for _ in range(3):
-            t0 = time.perf_counter()
+            # Account for the parent and spawned threads, excluding idle time
+            # and descheduling that are not work added by instrumentation.
+            t0 = time.process_time()
             for _ in range(n):
                 th = threading.Thread(target=noop)
                 th.start()
                 th.join()
-            best = min(best, (time.perf_counter() - t0) / n)
+            best = min(best, (time.process_time() - t0) / n)
         return best
 
     base = per_thread(300)
