From c536c1baa61b6c2f22817d8acaae0a4ea8adfb76 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 02:08:50 +0000
Subject: [PATCH] fix(worker): preserve unknown profile discovery errors
 [daveey]

Explicit stat propagates unreadable profile discovery rather than Python 3.14 is_dir silently dropping real occupancy. RED: 2 profile-error regressions fail before fix. GREEN: 85 boundary/account/legacy tests. Twelve targeted mutation operators killed, including missing legacy foreign records.
---
 hermes_cli/worker_account_boards.py           |  6 ++-
 .../test_worker_board_root_boundary.py        | 37 ++++++++++++++++++-
 2 files changed, 41 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/worker_account_boards.py b/hermes_cli/worker_account_boards.py
index a689a285b6..2f4cbff83e 100644
--- a/hermes_cli/worker_account_boards.py
+++ b/hermes_cli/worker_account_boards.py
@@ -261,7 +261,11 @@ def paths() -> list[Path]:
     profiles = root / 'profiles'
     if not _missing(profiles):
         for profile in profiles.iterdir():
-            if profile.is_dir():
+            try:
+                is_directory = stat.S_ISDIR(profile.stat().st_mode)
+            except FileNotFoundError:
+                continue  # entry vanished after listing; other I/O errors are unknown
+            if is_directory:
                 found.extend(_installation_boards(profile))
     directory = root / 'worker-resources' / 'boards'
     if not _missing(directory):
diff --git a/tests/hermes_cli/test_worker_board_root_boundary.py b/tests/hermes_cli/test_worker_board_root_boundary.py
index 3c3fdc6bb3..b2bda724a3 100644
--- a/tests/hermes_cli/test_worker_board_root_boundary.py
+++ b/tests/hermes_cli/test_worker_board_root_boundary.py
@@ -1,7 +1,9 @@
 """Standalone proof homes must not enter the real account inventory."""
 import hashlib
 import json
+import os
 import sqlite3
+from pathlib import Path
 
 import pytest
 
@@ -49,7 +51,8 @@ def test_real_default_named_and_profile_boards_register(account, relative):
     assert board in inventory.paths()
 
 
-def test_legacy_foreign_record_cannot_reenter_census(account):
+@pytest.mark.parametrize('missing', [False, True])
+def test_legacy_foreign_record_cannot_reenter_census(account, missing):
     board = account / 'cache/scratch/old/kanban.db'
     board.parent.mkdir(parents=True)
     board.touch()
@@ -57,6 +60,8 @@ def test_legacy_foreign_record_cannot_reenter_census(account):
     records.mkdir(parents=True)
     record = records / (hashlib.sha256(str(board).encode()).hexdigest() + '.json')
     record.write_text(json.dumps(str(board)))
+    if missing:
+        board.unlink()
     assert inventory.paths() == []
     assert record.exists(), 'census remains read-only'
 
@@ -103,6 +108,36 @@ def test_unregistered_profile_discovered(account, relative):
     assert board in inventory.paths()
 
 
+@pytest.mark.parametrize('error', [PermissionError, OSError])
+def test_unreadable_profile_remains_unknown(account, monkeypatch, error):
+    from hermes_cli import worker_resource_admission as admission
+    profile = account / 'profiles/research'
+    _running_board(profile / 'kanban.db')
+    original = os.stat
+
+    def denied(path, *args, **kwargs):
+        if Path(path) == profile:
+            raise error('profile stat unavailable')
+        return original(path, *args, **kwargs)
+
+    monkeypatch.setattr(os, 'stat', denied)
+    with pytest.raises(error):
+        inventory.paths()
+    with pytest.raises(error):
+        admission.occupied_count_for_host()
+
+
+def test_profile_non_directory_or_vanished_entry_is_skipped(account, monkeypatch):
+    profiles = account / 'profiles'
+    profiles.mkdir()
+    (profiles / 'readme').touch()
+    vanished = profiles / 'vanished'
+    original = Path.iterdir
+    monkeypatch.setattr(Path, 'iterdir', lambda path: iter([profiles / 'readme', vanished])
+                        if path == profiles else original(path))
+    assert inventory.paths() == []
+
+
