From 7a589634625ecb71b51d4a164005a66d52ae0b40 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 03:55:04 +0000
Subject: [PATCH 584/584] kanban block policy: name needs_input in docstring;
 honest test name

---
 hermes_cli/kanban_block_policy.py            | 2 +-
 tests/tools/test_kanban_block_needs_input.py | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_block_policy.py b/hermes_cli/kanban_block_policy.py
index 2b57841a74..275f4700a1 100644
--- a/hermes_cli/kanban_block_policy.py
+++ b/hermes_cli/kanban_block_policy.py
@@ -1,6 +1,6 @@
 """Block is never a terminal parking state for agent-owned reasons.
 
-``capability`` / ``transient`` / untyped blocks with no human ask, no wake
+``capability`` / ``transient`` / ``needs_input`` (without a human_request) / untyped blocks with no human ask, no wake
 probe and no routed assignee have no owner: nothing wakes them. Worker-facing
 entry points (tool + CLI) refuse them with a typed error naming the fix; the
 dispatcher re-spawns any that already exist (``sweep_agent_owned_blocks``);
diff --git a/tests/tools/test_kanban_block_needs_input.py b/tests/tools/test_kanban_block_needs_input.py
index ed750c4a00..b4728a5aa6 100644
--- a/tests/tools/test_kanban_block_needs_input.py
+++ b/tests/tools/test_kanban_block_needs_input.py
@@ -68,7 +68,7 @@ def test_needs_input_with_human_request_blocks_and_sidebar_shows_blocked(worker_
     assert _replica_bucket({"status": "blocked", "block_kind": "needs_input", "human_request": None}) == "active"
 
 
-def test_cli_refuses_needs_input_without_human_request():
+def test_policy_function_refuses_needs_input_unless_owned():
     from hermes_cli.kanban_block_policy import block_policy_error
     assert "agent_owned_block" in block_policy_error("needs_input", reason=CUTOVER_REASON)
     assert block_policy_error("needs_input", human_request=ASK) is None
