From 2f5c6596d11c654bc13da43c11ef423a60d5439a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 22:44:25 +0000
Subject: [PATCH] test(notices): reject shared reuse when both fingerprints are
 unknown [daveey]

---
 .../test_kanban_observation_singleflight.py          | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/tests/tui_gateway/test_kanban_observation_singleflight.py b/tests/tui_gateway/test_kanban_observation_singleflight.py
index 6ac2c033f0..364489da7a 100644
--- a/tests/tui_gateway/test_kanban_observation_singleflight.py
+++ b/tests/tui_gateway/test_kanban_observation_singleflight.py
@@ -225,6 +225,18 @@ def test_missing_sequence_signature_never_reuses_an_old_memo(tmp_path):
     assert any(state.startswith("blocked@") for _, _, state in after)
 
 
+def test_unknown_fingerprints_never_reuse_a_shared_snapshot(tmp_path, monkeypatch):
+    from tui_gateway import kanban_replica_observer as observer
+
+    replica, ledger, cards = _world(tmp_path)
+    monkeypatch.setattr(observer, "fingerprint", lambda path: None)
+    before = obs.observe(replica, ledger, NOW)
+    _move(replica, cards[0], "blocked", NOW + 1)
+    after = obs.observe(replica, ledger, NOW + 2)
+    assert after != before
+    assert any(state.startswith("blocked@") for _, _, state in after)
+
+
 def test_unknown_after_fingerprint_forces_a_fresh_snapshot(tmp_path, monkeypatch):
     from tui_gateway import kanban_replica_observer as observer
 
