From 8068f99c3f986361d431fdfb89d7640960241240 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 13 Oct 2026 12:15:48 -0700
Subject: [PATCH] fix(desktop): archive/unarchive a session on its owning
 gateway [daveey]

All-Gateways sidebar rows from another connection (connection_id set) were
archived via the active backend, which 404'd ('Session not found'); the
optimistic hide rolled back and the row reappeared. Route the PATCH with the
row's connectionId, mirroring deleteSession's removedOwner.
---
diff --git a/apps/desktop/src/api/sessions.test.ts b/apps/desktop/src/api/sessions.test.ts
index 7bdaff9c7d3aa3b231ef4ebfb1dac671d8ccbe30..2e2a6814944bec81f306a092f1b7e5fe25e9cd2b 100644
--- a/apps/desktop/src/api/sessions.test.ts
+++ b/apps/desktop/src/api/sessions.test.ts
@@ -157,6 +157,23 @@ describe('setSessionArchived profile scoping', () => {
     })
   })
 
+  it('routes an object owner to ITS connection (All-Gateways row on another gateway)', async () => {
+    // Regression: archiving a mac-mini row from the MacBook sidebar sent the
+    // PATCH to the active (local) backend, which 404'd; the row reappeared.
+    hermesApi.mockResolvedValue({ ok: true } as never)
+    vi.mocked(client.capabilityScoped).mockReturnValue({ profile: 'default', connectionId: 'mac-mini' })
+
+    await setSessionArchived('sess-remote', true, { connectionId: 'mac-mini', profile: 'default' })
+
+    expect(hermesApi.mock.calls[0][0]).toMatchObject({
+      connectionId: 'mac-mini',
+      method: 'PATCH',
+      path: '/api/sessions/sess-remote',
+      profile: 'default',
+      body: { archived: true, profile: 'default' }
+    })
+  })
+
   it('omits the profile from the body only when there is no active profile at all', async () => {
     hermesApi.mockResolvedValue({ ok: true, exists: true, runtime_revision: 5, runtime_generation: 2 } as never)
 
diff --git a/apps/desktop/src/app/session/hooks/use-session-actions/index.ts b/apps/desktop/src/app/session/hooks/use-session-actions/index.ts
index b4a268c1765903130422815500f171a9681e08c1..7fa5644b3b4c8d36e6e1d18215054da0ae5aeb76 100644
--- a/apps/desktop/src/app/session/hooks/use-session-actions/index.ts
+++ b/apps/desktop/src/app/session/hooks/use-session-actions/index.ts
@@ -3274,7 +3274,12 @@ export function useSessionActions({
       }
 
       try {
-        await setSessionArchived(storedSessionId, true, profile)
+        // Route to the row's OWN gateway (mirrors deleteSession's removedOwner):
+        // an All-Gateways row archived via the active connection 404s there.
+        const archiveOwner: SessionOwnerScope = archived?.connection_id
+          ? { connectionId: archived.connection_id, profile: archived.profile || 'default' }
+          : profile
+        await setSessionArchived(storedSessionId, true, archiveOwner)
         // Archived rows never reach the sidebar, so their persisted unread can
         // only rot. Dropped after the RPC so a failed archive keeps it.
         forgetSessionUnread(archivedIds, profile)
@@ -3323,7 +3328,10 @@ export function useSessionActions({
       const profile = archived?.profile?.trim() || undefined
 
       try {
-        await setSessionArchived(storedSessionId, false, profile)
+        const restoreOwner: SessionOwnerScope = archived?.connection_id
+          ? { connectionId: archived.connection_id, profile: archived.profile || 'default' }
+          : profile
+        await setSessionArchived(storedSessionId, false, restoreOwner)
 
         // Drop the archived-view row first so the view reflects the restore
         // even when the session cannot be re-listed below (e.g. it belongs to
diff --git a/apps/desktop/src/app/session/hooks/use-session-actions/unarchive-session.test.tsx b/apps/desktop/src/app/session/hooks/use-session-actions/unarchive-session.test.tsx
index c3cb42b4b7b88c6d9e5c9530b005c7cf67c7660e..d703179a2b876887ee682758960bc71ac0a10b8f 100644
--- a/apps/desktop/src/app/session/hooks/use-session-actions/unarchive-session.test.tsx
+++ b/apps/desktop/src/app/session/hooks/use-session-actions/unarchive-session.test.tsx
@@ -53,7 +53,7 @@ function archivedSession(overrides: Partial<SessionInfo> = {}): SessionInfo {
   } as SessionInfo
 }
 
-type Handle = Pick<ReturnType<typeof useSessionActions>, 'unarchiveSession'>
+type Handle = Pick<ReturnType<typeof useSessionActions>, 'archiveSession' | 'unarchiveSession'>
 
 function Harness({ onReady }: { onReady: (handle: Handle) => void }) {
   const ref = <T,>(value: T): MutableRefObject<T> => ({ current: value })
@@ -79,7 +79,7 @@ function Harness({ onReady }: { onReady: (handle: Handle) => void }) {
   })
 
   useEffect(() => {
-    onReady({ unarchiveSession: actions.unarchiveSession })
+    onReady({ archiveSession: actions.archiveSession, unarchiveSession: actions.unarchiveSession })
   }, [actions, onReady])
 
   return null
@@ -132,6 +132,38 @@ describe('unarchiveSession', () => {
     expect($sessions.get().map(session => session.id)).toEqual([])
   })
 
+  it('restores a row from ANOTHER gateway on that gateway (connection-scoped owner)', async () => {
+    $archivedSessions.set([archivedSession({ connection_id: 'mac-mini', profile: 'default' } as Partial<SessionInfo>)])
+    vi.mocked(setSessionArchived).mockResolvedValue({ ok: true })
+
+    const handle = await mountHarness()
+
+    await act(() => handle.unarchiveSession('arch-1'))
+
+    expect(vi.mocked(setSessionArchived)).toHaveBeenCalledWith('arch-1', false, {
+      connectionId: 'mac-mini',
+      profile: 'default'
+    })
+  })
+
+  it('archives a row from ANOTHER gateway on that gateway, not the active one', async () => {
+    // Regression: an All-Gateways sidebar row (connection_id=mac-mini) was
+    // archived via the active local backend, which 404'd; the row came back.
+    setSessions([
+      archivedSession({ archived: false, connection_id: 'mac-mini', id: 'remote-1', profile: 'default' } as Partial<SessionInfo>)
+    ])
+    vi.mocked(setSessionArchived).mockResolvedValue({ ok: true })
+
+    const handle = await mountHarness()
+
+    await act(() => handle.archiveSession('remote-1'))
+
+    expect(vi.mocked(setSessionArchived)).toHaveBeenCalledWith('remote-1', true, {
+      connectionId: 'mac-mini',
+      profile: 'default'
+    })
+  })
+
   it('passes the archived row profile to setSessionArchived', async () => {
     $archivedSessions.set([archivedSession({ profile: 'sage' } as Partial<SessionInfo>)])
     vi.mocked(setSessionArchived).mockResolvedValue({ ok: true })
-- 
