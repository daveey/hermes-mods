From 657f903a13b1ce9cbd5ffa5ebb587c53f3028005 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 03:31:04 +0000
Subject: [PATCH 6424] Spend review, decided-triage repair and spend-stop watch

Public mirror of source commit 657f903a13b1ce9cbd5ffa5ebb587c53f3028005.

---
diff --git a/hermes_cli/kanban_spend_caused_review.py b/hermes_cli/kanban_spend_caused_review.py
index 076428da7fb..b336231224b 100644
--- a/hermes_cli/kanban_spend_caused_review.py
+++ b/hermes_cli/kanban_spend_caused_review.py
@@ -115,8 +115,11 @@
         target = verdict.get("target")
         if not isinstance(target, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,200}", target):
             raise ValueError("invalid target")
+        # Same boundary as Board spend_review.ts names(): one sentence-ending "." or ":" is prose, a longer
+        # coordinate (t_x.2, t_x:child, t_x-old, gw:t_x) is another name.
         if target == ctx["task_id"] or not any(re.search(
-                r"(?<![A-Za-z0-9._:-])" + re.escape(target) + r"(?![A-Za-z0-9._:-])", text)
+                r"(?<![A-Za-z0-9._:-])" + re.escape(target)
+                + r"(?=\Z|[^A-Za-z0-9._:-]|[.:](?:\Z|[^A-Za-z0-9._:-]))", text)
                 for text in ctx.get("target_evidence", [])):
             raise ValueError("target is not named in stop evidence")
         fields["target"] = target
diff --git a/tests/hermes_cli/test_kanban_spend_review_reconcile.py b/tests/hermes_cli/test_kanban_spend_review_reconcile.py
index d2dd6556fc2..881b1e34f91 100644
--- a/tests/hermes_cli/test_kanban_spend_review_reconcile.py
+++ b/tests/hermes_cli/test_kanban_spend_review_reconcile.py
@@ -177,3 +177,19 @@
         caused.validate(verdict, ctx)
     ctx["target_evidence"] = ["stop names t_other"]
     assert caused.validate(verdict, ctx)["target"] == "t_other"
+
+
+@pytest.mark.parametrize("text,named", [
+    ("This card duplicates the finished card t_other.", True), ("Superseded by t_other: nothing remains.", True),
+    ("Already delivered (see t_other).", True), ("Duplicate of t_other.2 only.", False),
+    ("Duplicate of t_other-old.", False), ("Duplicate of t_other:child.", False), ("Duplicate of t_other..", False),
+    ("Duplicate of gw:t_other.", False)])
+def test_target_named_at_sentence_end_matches_board_boundary(text, named):
+    """Same cases as Board spend-review.test.ts: sentence punctuation is prose, a longer coordinate is not."""
+    verdict = {"decision": "archive", "reason": "duplicate", "target": "t_other"}
+    ctx = {"task_id": "t_source", "evidence": [text], "target_evidence": [text]}
+    if named:
+        assert caused.validate(verdict, ctx)["target"] == "t_other"
+    else:
+        with pytest.raises(ValueError, match="not named"):
+            caused.validate(verdict, ctx)
