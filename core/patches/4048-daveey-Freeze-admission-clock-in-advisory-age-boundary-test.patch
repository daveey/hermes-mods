From c984e1f6e7202119c5ed9efbc382dee0352371db Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 02:15:53 +0000
Subject: [PATCH] [daveey] Freeze admission clock in advisory age boundary test

The 9900 ms fixture left only 100 ms for task creation and the pre-lease read. CPU scheduling consumed that margin and correctly rejected the claim. Freeze only kanban_admission._now and retain real sampler-file reads and claim flow. Assert exact inclusive 10000/15000 ms boundaries and rejection 1 ms beyond each.

Proof: owned pytest SIGSTOP/SIGCONT for 500 ms before the first sampler read reproduces the old None-claim assertion (initial and retry); fixed full file passes 148 tests under the same pause and normally. scripts/check --base origin/main passes. No production timeout or retry changes.
---
 tests/hermes_cli/test_kanban_hub_admission.py | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_hub_admission.py b/tests/hermes_cli/test_kanban_hub_admission.py
index 70351db2c0..b18cc94f15 100644
--- a/tests/hermes_cli/test_kanban_hub_admission.py
+++ b/tests/hermes_cli/test_kanban_hub_admission.py
@@ -867,12 +867,21 @@ def test_advisory_age_boundary_10000_ms_is_fresh_and_the_locked_read_keeps_15000
     """Pre-lease: 10 s (15 s minus the lease headroom). The locked gate reads the same file and accepts up to 15 s."""
     conn, home = board
     configure(home)
-    advisory(home, age_ms=9_900)
+    # Freeze only the admission clock: task creation or runner descheduling must not
+    # consume a 100 ms margin before the pre-lease read. Exercise the exact bounds.
+    now = int(time.time())
+    monkeypatch.setattr(ka, "_now", lambda: now)
+    mm.record_hub_cpu_sample({"cpu_busy_pct": 10.0, "cpu_busy_window_ms": 1000,
+                              "cpu_busy_sample_end_ms": now * 1000 - 10_000}, root=home)
     t = task(conn)
     assert kb.claim_task(conn, t) is not None
     assert ka.ADVISORY_MAX_AGE_MS - ka.PRELEASE_HEADROOM_MS == 10_000
-    advisory(home, age_ms=14_000)  # too old to take a lease, still fresh for the locked read
+    now += 0.001
+    assert ka.sampler_sample(10_000) is None
+    now = int(now) + 5  # same sample, exactly 15 s old: still fresh for the locked read
     assert ka.sampler_sample() is not None and ka.sampler_sample(10_000) is None
+    now += 0.001
+    assert ka.sampler_sample() is None
 
 
 @pytest.mark.parametrize("review", [False, True])
-- 
