From b3c050ed1387aa1ac96b79d885ac07b9be9f2814 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 01:42:35 +0000
Subject: [PATCH] fix(tests): restore hermes modules after an isolated kanban
 home [daveey]

isolated_kanban_home deleted hermes_cli from sys.modules and never put
the process's objects back. Later files in the same pytest process patched
one copy and executed another, which is why the shard-0 ordered run reported
37 failures once the OOM-txn hang no longer stopped it.
---
diff --git a/tests/hermes_cli/test_kanban_cli_dispatch_passthrough.py b/tests/hermes_cli/test_kanban_cli_dispatch_passthrough.py
index aaf214458f68744e3c46f32ec8244f270ede644d..2523ca2f586164693437ba4f35df1868b6024a2a 100644
--- a/tests/hermes_cli/test_kanban_cli_dispatch_passthrough.py
+++ b/tests/hermes_cli/test_kanban_cli_dispatch_passthrough.py
@@ -8,6 +8,7 @@ operator footgun that only manifests in long-running setups.
 from __future__ import annotations
 
 import argparse
+import contextlib
 import os
 import sys
 import tempfile
@@ -17,16 +18,37 @@ from unittest.mock import MagicMock, patch
 import pytest
 
 
+def _hermes_module(name: str) -> bool:
+    return name.startswith("hermes_cli") or name.startswith("hermes_state") or name == "hermes_constants"
+
+
+@contextlib.contextmanager
+def reimported_hermes_modules():
+    """Drop hermes modules so the next import sees the current HERMES_HOME.
+
+    Restores the process's module objects on the way out. A wipe that is not
+    undone splits the process: a later file patches the object it imported at
+    collection, and the code path runs the other copy.
+    """
+    saved = {name: mod for name, mod in list(sys.modules.items()) if _hermes_module(name)}
+    for name in saved:
+        del sys.modules[name]
+    try:
+        yield
+    finally:
+        for name in [n for n in list(sys.modules) if _hermes_module(n)]:
+            del sys.modules[name]
+        sys.modules.update(saved)
+
+
 @pytest.fixture()
 def isolated_kanban_home(monkeypatch):
     """Spin up a fresh HERMES_HOME with a clean kanban DB."""
     test_home = tempfile.mkdtemp(prefix="kanban_cli_passthrough_")
     os.makedirs(os.path.join(test_home, "profiles", "default"), exist_ok=True)
     monkeypatch.setenv("HERMES_HOME", test_home)
-    for mod in list(sys.modules.keys()):
-        if mod.startswith("hermes_cli") or mod.startswith("hermes_state") or mod == "hermes_constants":
-            del sys.modules[mod]
-    yield test_home
+    with reimported_hermes_modules():
+        yield test_home
 
 
 def test_cli_dispatch_passes_max_in_progress_from_config(isolated_kanban_home, monkeypatch):
@@ -96,3 +118,17 @@ def test_cli_max_flag_overrides_config_max_spawn(isolated_kanban_home, monkeypat
     )
 
 
+def test_reimported_hermes_modules_restores_process_objects():
+    """A later file in the same process must see the module object it imported."""
+    import importlib
+
+    import hermes_cli.kanban_db as kb
+
+    before = sys.modules["hermes_cli.kanban_db"]
+    assert before is kb
+    with reimported_hermes_modules():
+        fresh = importlib.import_module("hermes_cli.kanban_db")
+        assert fresh is not before
+    assert sys.modules["hermes_cli.kanban_db"] is before
+
+
