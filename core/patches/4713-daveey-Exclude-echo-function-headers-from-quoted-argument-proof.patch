From bdcc7bbdd21ebddd83094d7ecb67c4a97427a7f8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 16:57:30 +0000
Subject: [PATCH] [daveey] Exclude echo function headers from quoted-argument
 proof

Prepublication adversarial review found echo () { ./"($(printf payload))"; }; echo could be misclassified as an echo argument. Real Bash marker reproduced it. Require the narrow echo followed by double-quoted first argument grammar; unsupported prefixes remain conservative. Cover ordinary and continuation-separated function headers and use portable fixture shebangs.
---
 tests/cron/test_lifecycle_guard_quoted_echo_sink.py | 12 ++++++++----
 tools/shell_arith_sink.py                           |  2 +-
 2 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/tests/cron/test_lifecycle_guard_quoted_echo_sink.py b/tests/cron/test_lifecycle_guard_quoted_echo_sink.py
index bd2a32bb7ada3f91741cd6913ada88d0072e6b7b..97fa2ad2558336a01fdb7271be4ed0e4b7c400d3 100644
--- a/tests/cron/test_lifecycle_guard_quoted_echo_sink.py
+++ b/tests/cron/test_lifecycle_guard_quoted_echo_sink.py
@@ -40,7 +40,7 @@ def test_quoted_parentheses_are_data(tmp_path, prefix, parens, producer):
 def test_generated_real_bash_output_execution(tmp_path, shape, substitution):
     marker = tmp_path / "executed"
     payload = tmp_path / "payload"
-    payload.write_text("#!/bin/bash\n: > " + shlex.quote(str(marker)) + "\n", encoding="utf-8")
+    payload.write_text("#!/usr/bin/env bash\n: > " + shlex.quote(str(marker)) + "\n", encoding="utf-8")
     payload.chmod(0o700)
     command = shape.replace("SUB", substitution.replace("PAYLOAD", shlex.quote(str(payload))))
     bash = shutil.which("bash")
@@ -81,12 +81,16 @@ def test_uncertain_or_nested_context_keeps_original_sink(command):
     assert output_reaches_shell(command)
 
 
-def test_quoted_parentheses_in_command_word_execute(tmp_path):
+@pytest.mark.parametrize("command", [
+    './"($(printf payload))"',
+    'echo () { ./"($(printf payload))"; }; echo',
+    'echo \\\n() { ./"($(printf payload))"; }; echo',
+])
+def test_quoted_parentheses_in_command_word_execute(tmp_path, command):
     marker = tmp_path / "executed"
     payload = tmp_path / "(payload)"
-    payload.write_text("#!/bin/bash\n: > " + shlex.quote(str(marker)) + "\n", encoding="utf-8")
+    payload.write_text("#!/usr/bin/env bash\n: > " + shlex.quote(str(marker)) + "\n", encoding="utf-8")
     payload.chmod(0o700)
-    command = './"($(printf payload))"'
     bash = shutil.which("bash")
     assert bash is not None
     subprocess.run([bash, "--noprofile", "--norc", "-c", command], cwd=tmp_path,
diff --git a/tools/shell_arith_sink.py b/tools/shell_arith_sink.py
index 3d4444f4aea165f861d35c77915ecf162fdcf3c5..47c28da9db61308f71bf0f37bfb182f0d3cb0c1c 100644
--- a/tools/shell_arith_sink.py
+++ b/tools/shell_arith_sink.py
@@ -46,7 +46,7 @@ _INTEGER_DECLARATION_RE = re.compile(
     r"[ \t]+-[A-Za-z]*i")
 _PARAM_NAME_RE = re.compile(r"[#!]?(?:[A-Za-z_]\w*|\d+|[@*#?$!-])")
 _COMMENT_PRECEDERS = frozenset(" \t\n;&|(")
-_LITERAL_ECHO_PREFIX_RE = re.compile(r"[ \t]*echo[ \t]+")
+_LITERAL_ECHO_PREFIX_RE = re.compile(r'[ \t]*echo[ \t]+"')
 
 # Characters that cannot end a variable name or an expansion: a quoted `[` after one
 # (or after a quote concatenation ending in one) never names an array subscript.
-- 
