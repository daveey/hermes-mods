From 6c9a5046fd4711ea0d0a9b0f7a587ac613f3a7c2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 12:57:31 +0000
Subject: [PATCH] fix(kanban): retry aggregate memory setup with host
 diagnostics [daveey]

systemctl stderr was captured but lost in CalledProcessError formatting. Log every failed attempt with host, return code and up to 500 decoded stderr characters. Retry after 1s and 3s, preserve the 10s command timeout, fail closed and cache success only.

Proof: seven regression cases fail against unchanged main implementation; all 65 tests in six importing suites pass with the fix. Covers diagnostics, truncation, bytes/text stderr, transient recovery on attempts two and three, failure non-caching, OSError and timeout bounds.
---
 hermes_cli/kanban_aggregate_scope.py          | 34 +++++++---
 .../hermes_cli/test_kanban_aggregate_scope.py | 64 ++++++++++++++++++-
 2 files changed, 87 insertions(+), 11 deletions(-)

diff --git a/hermes_cli/kanban_aggregate_scope.py b/hermes_cli/kanban_aggregate_scope.py
index 8ea6fc09c7a759b1f9d35485bd2776f85e59e493..fd2b4276b1b7efd443181918aa91c5fdb79d1196 100644
--- a/hermes_cli/kanban_aggregate_scope.py
+++ b/hermes_cli/kanban_aggregate_scope.py
@@ -5,20 +5,38 @@ for the gateway/control plane. All boards/profiles in this user manager share
 one pool. The gateway itself is deliberately not moved into the pool.
 """
 from functools import lru_cache
+import logging
+import socket
 import subprocess
+import time
+
+
+logger = logging.getLogger(__name__)
 
 
 @lru_cache(maxsize=1)
 def configure_pool():
     """Set runtime properties; only cache success, never launch unbounded on failure."""
-    try:
-        subprocess.run(
-            ['systemctl', '--user', 'set-property', '--runtime', 'hermes-kanban.slice',
-             'MemoryHigh=70%', 'MemoryMax=80%'], check=True,
-            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=10)
-    except (OSError, subprocess.SubprocessError) as exc:
-        from tools.process_registry import RestartSafeScopeUnavailable
-        raise RestartSafeScopeUnavailable(f'Kanban aggregate memory budget unavailable: {exc}') from exc
+    for attempt, delay in enumerate((1, 3, None), start=1):
+        try:
+            subprocess.run(
+                ['systemctl', '--user', 'set-property', '--runtime', 'hermes-kanban.slice',
+                 'MemoryHigh=70%', 'MemoryMax=80%'], check=True,
+                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=10)
+            return
+        except (OSError, subprocess.SubprocessError) as exc:
+            stderr = getattr(exc, 'stderr', None) or ''
+            if isinstance(stderr, bytes):
+                stderr = stderr.decode('utf-8', errors='replace')
+            message = (
+                f'Kanban aggregate memory budget unavailable on {socket.gethostname()}: '
+                f'returncode={getattr(exc, "returncode", None)}; stderr={stderr[:500]}; {exc}'
+            )
+            logger.warning('%s (attempt %s/3)', message, attempt)
+            if delay is None:
+                from tools.process_registry import RestartSafeScopeUnavailable
+                raise RestartSafeScopeUnavailable(message) from exc
+            time.sleep(delay)
 
 
 def bounded_scope(argv, *, task_id=None, board=None):
diff --git a/tests/hermes_cli/test_kanban_aggregate_scope.py b/tests/hermes_cli/test_kanban_aggregate_scope.py
index 67273c92935325d88a85554f451297e4eb85089b..c735b24d42aa804bc00ca95acc07fdf6db83e522 100644
--- a/tests/hermes_cli/test_kanban_aggregate_scope.py
+++ b/tests/hermes_cli/test_kanban_aggregate_scope.py
@@ -34,9 +34,67 @@ def test_unavailable_budget_fails_closed_and_retries_later():
     from hermes_cli.kanban_aggregate_scope import bounded_scope, configure_pool
     configure_pool.cache_clear()
     command = ['systemd-run', '--user', '--scope', '--', 'worker']
-    with patch('subprocess.run', side_effect=subprocess.CalledProcessError(1, 'systemctl')) as run:
+    from tools.process_registry import RestartSafeScopeUnavailable
+
+    with patch('subprocess.run', side_effect=subprocess.CalledProcessError(1, 'systemctl')) as run, \
+            patch('time.sleep') as sleep:
         for _ in range(2):
-            with pytest.raises(RuntimeError, match='aggregate'):
+            with pytest.raises(RestartSafeScopeUnavailable, match='aggregate'):
                 bounded_scope(command)
-        assert run.call_count == 2
+        assert run.call_count == 6
+        assert [call.args for call in sleep.call_args_list] == [(1,), (3,), (1,), (3,)]
+    configure_pool.cache_clear()
+
+
+@pytest.mark.parametrize('stderr', [b'manager reloading', 'manager reloading'])
+def test_pool_failure_reports_host_returncode_and_bounded_stderr(stderr, caplog):
+    from hermes_cli.kanban_aggregate_scope import configure_pool
+    from tools.process_registry import RestartSafeScopeUnavailable
+
+    configure_pool.cache_clear()
+    suffix = b'x' * 600 if isinstance(stderr, bytes) else 'x' * 600
+    error = subprocess.CalledProcessError(7, 'systemctl', stderr=stderr + suffix)
+    with patch('subprocess.run', side_effect=error) as run, \
+            patch('socket.gethostname', return_value='test-host'), patch('time.sleep'):
+        with pytest.raises(RestartSafeScopeUnavailable) as caught:
+            configure_pool()
+    assert run.call_count == 3
+    assert caught.value.__cause__ is error
+    message = str(caught.value)
+    assert 'test-host' in message
+    assert 'returncode=7' in message
+    assert 'stderr=' + ('manager reloading' + 'x' * 600)[:500] in message
+    assert 'x' * 500 not in message
+    assert len(caplog.records) == 3
+    assert all(record.levelname == 'WARNING' and message in record.message
+               for record in caplog.records)
+    configure_pool.cache_clear()
+
+
+@pytest.mark.parametrize('failures', [1, 2])
+def test_transient_pool_failure_recovers_and_caches(failures):
+    from hermes_cli.kanban_aggregate_scope import configure_pool
+
+    configure_pool.cache_clear()
+    error = subprocess.CalledProcessError(1, 'systemctl', stderr=b'busy')
+    with patch('subprocess.run', side_effect=[error] * failures + [None]) as run, \
+            patch('time.sleep') as sleep:
+        configure_pool()
+        configure_pool()
+    assert run.call_count == failures + 1
+    assert [call.args for call in sleep.call_args_list] == [(1,), (3,)][:failures]
+    configure_pool.cache_clear()
+
+
+@pytest.mark.parametrize('error', [OSError('no manager'),
+                                  subprocess.TimeoutExpired('systemctl', 10, stderr=b'busy')])
+def test_other_pool_errors_remain_bounded_and_fail_closed(error):
+    from hermes_cli.kanban_aggregate_scope import configure_pool
+    from tools.process_registry import RestartSafeScopeUnavailable
+
+    configure_pool.cache_clear()
+    with patch('subprocess.run', side_effect=error) as run, patch('time.sleep'):
+        with pytest.raises(RestartSafeScopeUnavailable, match='returncode=None'):
+            configure_pool()
+    assert run.call_count == 3
     configure_pool.cache_clear()
