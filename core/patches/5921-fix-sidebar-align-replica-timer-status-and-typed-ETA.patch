From a4bbdeaf042c6625ead45dbc7dbc5a90e1608998 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 09:57:41 +0000
Subject: [PATCH] fix(sidebar): align replica timer status and typed ETA
 fixture [daveey]

Public mirror of the source commit; see the accompanying feature documentation.

---
 .../app/chat/sidebar/session-row-card-squares-eta.test.tsx | 4 ++--
 hermes_state_outcome.py                                    | 5 +++--
 tests/hermes_cli/test_kanban_remote_waiting_overlap.py     | 4 ++--
 tests/hermes_state/test_session_status_refresh.py          | 7 +++++--
 4 files changed, 12 insertions(+), 8 deletions(-)

diff --git a/apps/desktop/src/app/chat/sidebar/session-row-card-squares-eta.test.tsx b/apps/desktop/src/app/chat/sidebar/session-row-card-squares-eta.test.tsx
index ef0524a3c87..5cbe7e24df1 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row-card-squares-eta.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row-card-squares-eta.test.tsx
@@ -63,7 +63,7 @@ describe('the ETA readout on light-blue rows', () => {
     vi.useFakeTimers({ now: NOW * 1000 })
     const clock = kind === 'clock'
 
-    const projected = {
+    const projected: NonNullable<SessionInfo['kanban_external_cards']>[number] = {
       eta: {
         estimate_source: clock ? 'wakes 14:30' : 'no history yet',
         expected_s: clock ? 1500 : null,
@@ -74,7 +74,7 @@ describe('the ETA readout on light-blue rows', () => {
         adapter: kind,
         health: clock ? 'ok' : 'unknown',
         job: clock ? 'running' : 'unknown',
-        state: clock ? 'external_running' : 'external_unknown'
+        service: clock ? 'timer' : kind
       },
       task_id: 'edge/default/default/t_wait',
       title: 'Remote wait'
diff --git a/hermes_state_outcome.py b/hermes_state_outcome.py
index c8642d010fb..8e6e736eea6 100644
--- a/hermes_state_outcome.py
+++ b/hermes_state_outcome.py
@@ -384,8 +384,9 @@ def _read_card_items(ids: list[str]) -> tuple[list[dict], list[dict]]:
                               "choices": _choices(req.get("choices")), "card_id": tid, "state": "open"})
             continue
         wait_kind = wait.get("wait_kind")
-        display_state = "external_unknown" if card.get("remote") and replica_bucket(card) else (
-            "external_running" if wait_kind in ("ci", "deploy", "clock") and status == "scheduled" else status)
+        display_state = "external_running" if wait_kind in ("ci", "deploy", "clock") and status == "scheduled" else status
+        if card.get("remote") and replica_bucket(card):
+            display_state = "external_running" if card["awaiting"]["kind"] == "clock" else "external_unknown"
         item: dict[str, Any] = {"kind": "card", "id": tid, "label": _str(card.get("title")) or tid,
                                 "state": display_state}
         if explained:
diff --git a/tests/hermes_cli/test_kanban_remote_waiting_overlap.py b/tests/hermes_cli/test_kanban_remote_waiting_overlap.py
index 9062b1cf942..8fa1ef2eac0 100644
--- a/tests/hermes_cli/test_kanban_remote_waiting_overlap.py
+++ b/tests/hermes_cli/test_kanban_remote_waiting_overlap.py
@@ -5,7 +5,7 @@ import pytest
 from hermes_cli import kanban_session_activity as ksa
 
 
-@pytest.mark.parametrize("kind,external", [("ci", 1), ("deploy", 1), ("card", 0), ("clock", 0), ("external", 0), (None, 0)])
+@pytest.mark.parametrize("kind,external", [("ci", 1), ("deploy", 1), ("card", 0), ("clock", 1), ("external", 0), (None, 0)])
 @pytest.mark.parametrize("status", ["scheduled", "running", "unknown", "done"])
 def test_replica_external_wait_uses_the_parked_snapshot(remote_projection, monkeypatch, kind, external, status):
     key = "edge/default/default/t_ci"
@@ -22,7 +22,7 @@ def test_replica_external_wait_uses_the_parked_snapshot(remote_projection, monke
         }])[0]
         expected = external if status == "scheduled" else 0
         assert row.get("kanban_external", 0) == expected
-        assert row.get("kanban_external_unknown", 0) == expected
+        assert row.get("kanban_external_unknown", 0) == (expected if kind != "clock" else 0)
         assert row.get("kanban_external_down", 0) == 0
         assert expected <= row.get("kanban_parked", 0)
         assert row.get("kanban_blocked", 0) == 0
diff --git a/tests/hermes_state/test_session_status_refresh.py b/tests/hermes_state/test_session_status_refresh.py
index 8ae36cb6bb2..6f89157287f 100644
--- a/tests/hermes_state/test_session_status_refresh.py
+++ b/tests/hermes_state/test_session_status_refresh.py
@@ -110,8 +110,11 @@ def test_replica_ci_deploy_wait_publishes_external_stripe(db, monkeypatch, kind,
     monkeypatch.setattr(ksa, "session_outcome_tasks", lambda *a, **kw: [card])
     status = refresh(db, "card_change")
     assert status["kind"] == "waiting"
-    assert status["presentation"]["stripe"] == ("external" if remote and kind in ("ci", "deploy") else "waiting")
-    assert status["on"][0]["state"] == ("external_unknown" if remote and kind in ("ci", "deploy") else "scheduled")
+    assert status["presentation"]["stripe"] == ("external" if remote and kind in ("ci", "deploy", "clock") else "waiting")
+    expected_state = "scheduled"
+    if remote and kind in ("ci", "deploy", "clock"):
+        expected_state = "external_running" if kind == "clock" else "external_unknown"
+    assert status["on"][0]["state"] == expected_state
     published = so.get_outcome("chat", db=db)
     assert published is not None and published["status"] == status
 
-- 
2.43.0

