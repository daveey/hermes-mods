+# ---------------------------------------------------------------------------
+# In-flight (claimed, not yet durably delivered) notice claims. [daveey]
+# ---------------------------------------------------------------------------
+
+_MY_HOLDER: Optional[tuple[int, Optional[int]]] = None
+
+
+def _my_holder() -> tuple[int, Optional[int]]:
+    """``(pid, start-time fingerprint)`` of this process (PID-reuse guard), cached per pid."""
+    import os
+    global _MY_HOLDER
+    pid = os.getpid()
+    if _MY_HOLDER is None or _MY_HOLDER[0] != pid:
+        _MY_HOLDER = (pid, _process_start(pid))
+    return _MY_HOLDER
+
+
+def _process_start(pid: int) -> Optional[int]:
+    try:
+        from gateway.status import _get_process_start_time
+        return _get_process_start_time(int(pid))
+    except Exception:
+        return None
+
+
+def _holder_is_me(row) -> bool:
+    return row["inflight_pid"] is not None and int(row["inflight_pid"]) == _my_holder()[0]
+
+
+def _holder_alive(row) -> bool:
+    """True unless the holder process is provably gone (dead pid, or a recycled pid with another start time)."""
+    import os
+    pid = row["inflight_pid"]
+    if pid is None:
+        return False
+    try:
+        os.kill(int(pid), 0)
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        pass  # exists, owned by someone else
+    except (OSError, ValueError, TypeError):
+        return False
+    recorded = row["inflight_start"]
+    if recorded is None:
+        return True
+    current = _process_start(int(pid))
+    if current is None:
+        return True
+    try:
+        from gateway.status import start_time_fingerprints_match
+        return start_time_fingerprints_match(recorded, current)
+    except Exception:
+        return int(recorded) == int(current)
+
+
+def _rewind_orphan(conn: sqlite3.Connection, key: tuple, row) -> bool:
+    """Hand an orphaned claim's range back (cursor -> ``inflight_from``), CAS on the dead holder."""
+    cur = conn.execute(
+        "UPDATE kanban_notify_subs SET last_event_id = MIN(last_event_id, inflight_from), inflight_from = NULL, "
+        "inflight_pid = NULL, inflight_start = NULL " + _SUB_KEY_WHERE
+        + " AND inflight_from = ? AND inflight_pid IS ?",
+        (*key, row["inflight_from"], row["inflight_pid"]),
+    )
+    if cur.rowcount:
+        import logging
+        logging.getLogger(__name__).warning(
+            "kanban notice claim for %s -> %s/%s was never delivered (holder pid %s is gone); rewound to event %s "
+            "for redelivery", key[0], key[1], key[2], row["inflight_pid"], row["inflight_from"])
+    return cur.rowcount > 0
+
+
+def recover_orphaned_notify_claims(
+    conn: sqlite3.Connection, *, platform: Optional[str] = None, chat_id: Optional[str] = None,
+) -> int:
+    """Rewind every in-flight claim whose holder process is gone; returns how many. Never touches a claim held
+    by this process or by a live one."""
+    where = ["inflight_from IS NOT NULL"]
+    params: list[Any] = []
+    if platform is not None:
+        where.append("LOWER(platform) = LOWER(?)")
+        params.append(platform)
+    if chat_id is not None:
+        where.append("chat_id = ?")
+        params.append(chat_id)
+    try:
+        rows = conn.execute(
+            "SELECT task_id, platform, chat_id, thread_id, inflight_from, inflight_pid, inflight_start "
+            "FROM kanban_notify_subs WHERE " + " AND ".join(where), params,
+        ).fetchall()
+    except sqlite3.OperationalError:
+        return 0  # pre-migration board
+    orphans = [r for r in rows if not _holder_is_me(r) and not _holder_alive(r)]
+    if not orphans:
+        return 0
+    n = 0
+    with _kb.write_txn(conn):
+        for r in orphans:
+            n += _rewind_orphan(conn, _sub_key(r["task_id"], r["platform"], r["chat_id"], r["thread_id"]), r)
+    return n
+
+
+def ack_notify_claim(
+    conn: sqlite3.Connection,
+    *,
+    task_id: str,
+    platform: str,
+    chat_id: str,
+    thread_id: Optional[str] = None,
+    upto: int,
+    from_cursor: Optional[int] = None,
+) -> None:
+    """Every event of this subscription up to ``upto`` is durably delivered: clear the in-flight marker (or move
+    it to ``upto`` when a later claim is still outstanding). ``from_cursor`` (the delivered range's start) skips
+    the ack while an EARLIER claim is still outstanding (``inflight_from < from_cursor``), so its marker is kept.
+    A sub whose task was archived meanwhile is removed now (its removal waited for this ack)."""
+    key = _sub_key(task_id, platform, chat_id, thread_id)
+    guard = "" if from_cursor is None else " AND inflight_from >= ?"
+    with _kb.write_txn(conn):
+        conn.execute(
+            "UPDATE kanban_notify_subs SET "
+            "inflight_pid = CASE WHEN last_event_id <= ? THEN NULL ELSE inflight_pid END, "
+            "inflight_start = CASE WHEN last_event_id <= ? THEN NULL ELSE inflight_start END, "
+            "inflight_from = CASE WHEN last_event_id <= ? THEN NULL ELSE MAX(inflight_from, ?) END "
+            + _SUB_KEY_WHERE + " AND inflight_from IS NOT NULL" + guard,
+            (int(upto), int(upto), int(upto), int(upto), *key,
+             *(() if from_cursor is None else (int(from_cursor),))),
+        )
+        row = conn.execute(
+            "SELECT s.inflight_from, t.status FROM kanban_notify_subs s LEFT JOIN tasks t ON t.id = s.task_id "
+            "WHERE s.task_id = ? AND s.platform = ? AND s.chat_id = ? AND s.thread_id = ?", key,
+        ).fetchone()
+        if row is not None and row["inflight_from"] is None and row["status"] == "archived":
+            conn.execute("DELETE FROM kanban_notify_subs " + _SUB_KEY_WHERE, key)
+
+
+def notify_claim_in_flight(
+    conn: sqlite3.Connection, *, task_id: str, platform: str, chat_id: str, thread_id: Optional[str] = None,
+) -> bool:
+    row = conn.execute(
+        "SELECT inflight_from FROM kanban_notify_subs " + _SUB_KEY_WHERE,
+        _sub_key(task_id, platform, chat_id, thread_id),
+    ).fetchone()
+    return row is not None and row["inflight_from"] is not None
+
+
 def _cas_cursor(conn: sqlite3.Connection, key: tuple, new_cursor: int, expected: int) -> sqlite3.Cursor:
     """Move ``last_event_id`` only if it still equals ``expected``."""
     return conn.execute(
@@ -563,7 +733,21 @@ def rewind_notify_cursor(
     notifier advanced the row, so retries never clobber newer progress.
     """
     with _kb.write_txn(conn):
-        cur = _cas_cursor(conn, _sub_key(task_id, platform, chat_id, thread_id), old_cursor, claimed_cursor)
+        key = _sub_key(task_id, platform, chat_id, thread_id)
+        cur = _cas_cursor(conn, key, old_cursor, claimed_cursor)
+        if cur.rowcount > 0:
+            # The handed-back range is no longer in flight; an earlier, still-held claim keeps its marker.
+            try:
+                conn.execute(
+                    "UPDATE kanban_notify_subs SET "
+                    "inflight_pid = CASE WHEN inflight_from < ? THEN inflight_pid END, "
+                    "inflight_start = CASE WHEN inflight_from < ? THEN inflight_start END, "
+                    "inflight_from = CASE WHEN inflight_from < ? THEN inflight_from END "
+                    + _SUB_KEY_WHERE + " AND inflight_from IS NOT NULL",
+                    (int(old_cursor), int(old_cursor), int(old_cursor), *key),
+                )
+            except sqlite3.OperationalError:
+                pass  # pre-migration board
     return cur.rowcount > 0
 
 
diff --git a/tests/tui_gateway/test_kanban_notice_at_least_once.py b/tests/tui_gateway/test_kanban_notice_at_least_once.py
new file mode 100644
index 0000000000000000000000000000000000000000..cb0c0c0ba6dc0b9dde28b254fd5e45aea8f90f18
--- /dev/null
+++ b/tests/tui_gateway/test_kanban_notice_at_least_once.py
@@ -0,0 +1,244 @@
+"""A kanban notice claimed for a busy chat must survive the claiming backend dying. [daveey]
+
+A card can complete while its chat is mid-turn. Its poller claims the completed event
+and advances ``last_event_id``, storing the notice in the in-memory buffer.
+The notice then waits for the turn to end.
+A backend replacement before delivery destroys that buffer.
+The advanced cursor alone cannot prove the transcript received the notice.
+
+Fix: the tui poller's claim is recorded IN FLIGHT with its holder process and acknowledged only once the notice is
+in the transcript (a ``kanban_notice`` row written before the turn, deduped by event id). A claim whose holder
+process is gone is rewound, so the chat's next poller (or the unloaded sweep) delivers it.
+"""
+
+import contextlib
+import subprocess
+import sys
+import threading
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_notify as kbn
+from hermes_state import SessionDB
+from tui_gateway import kanban_unloaded as ku
+from tui_gateway import server
+
+KEY = "20260101_000000_example"
+
+
+def _dead_pid() -> int:
+    p = subprocess.Popen([sys.executable, "-c", "pass"])
+    p.wait()
+    return p.pid
+
+
+def _session(key: str = KEY, running: bool = False) -> dict:
+    return {"session_key": key, "history_lock": threading.RLock(), "running": running}
+
+
+def _task(chat_id: str = KEY) -> str:
+    conn = kbc.connect()
+    try:
+        tid = kb.create_task(conn, title="Drill parent", assignee="default")
+        kbn.add_notify_sub(conn, task_id=tid, platform="tui", chat_id=chat_id)
+        return tid
+    finally:
+        conn.close()
+
+
+def _complete(tid: str, summary: str = "reply OK and complete") -> None:
+    conn = kbc.connect()
+    try:
+        assert kb.complete_task(conn, tid, summary=summary)
+    finally:
+        conn.close()
+
+
+def _sub(tid: str) -> dict:
+    conn = kbc.connect()
+    try:
+        row = conn.execute("SELECT * FROM kanban_notify_subs WHERE task_id = ?", (tid,)).fetchone()
+        return dict(row)
+    finally:
+        conn.close()
+
+
+def _orphan(tid: str, inflight_from: int) -> None:
+    """The claiming backend died before delivering: its in-flight claim names a dead process."""
+    conn = kbc.connect()
+    try:
+        with kb.write_txn(conn):
+            conn.execute("UPDATE kanban_notify_subs SET inflight_from = ?, inflight_pid = ?, inflight_start = NULL "
+                         "WHERE task_id = ?", (inflight_from, _dead_pid(), tid))
+    finally:
+        conn.close()
+
+
+@pytest.fixture
+def gate(monkeypatch):
+    state = {"submitted": []}
+
+    def _submit(rid, sid, session, text, **kwargs):
+        state["submitted"].append((sid, text, kwargs))
+        with session["history_lock"]:
+            session["running"] = False
+        return True
+
+    monkeypatch.setattr(server, "_run_prompt_submit", _submit)
+    monkeypatch.setattr(server, "_emit", lambda *a, **k: None)
+    return state
+
+
+@pytest.fixture
+def sdb(tmp_path, monkeypatch):
+    d = SessionDB(tmp_path / "state.db")
+    d.create_session(KEY, "desktop")
+    d.append_message(KEY, "user", "run the drill")
+
+    @contextlib.contextmanager
+    def _opener(session):
+        yield d
+
+    monkeypatch.setattr(server, "_session_db", _opener)
+    return d
+
+
+def _notices(d: SessionDB) -> list:
+    return [m for m in d.get_messages(KEY) if m.get("display_kind") == "kanban_notice"]
+
+
+def test_notice_claimed_while_busy_survives_backend_replacement(gate):
+    """Claimed during a long turn, the backend is replaced before the turn ends."""
+    tid = _task()
+    before = _sub(tid)["last_event_id"]
+    _complete(tid)
+
+    busy = _session(running=True)
+    server._notif_poll_kanban_scoped("ui-old-backend", busy)
+    assert gate["submitted"] == [] and len(busy["_kanban_pending"]) == 1, "buffered while the turn runs"
+    assert _sub(tid)["last_event_id"] > before, "claimed cursor advanced"
+    assert _sub(tid)["inflight_from"] == before, "but still in flight, owned by this process"
+
+    # The old backend dies with the notice in memory (the core-update replaced serve).
+    _orphan(tid, _sub(tid)["inflight_from"])
+
+    server._notif_poll_kanban_scoped("ui-new-backend", _session())
+    assert len(gate["submitted"]) == 1 and tid in gate["submitted"][0][1], "the new backend redelivers it"
+
+
+def test_notice_row_is_written_before_the_turn_and_the_claim_acked(gate, sdb):
+    tid = _task()
+    _complete(tid)
+    session = _session()
+
+    server._notif_poll_kanban_scoped("ui", session)
+
+    rows = _notices(sdb)
+    assert len(rows) == 1 and tid in rows[0]["content"]
+    assert len(gate["submitted"]) == 1
+    _sid, text, kwargs = gate["submitted"][0]
+    assert text == rows[0]["content"] and kwargs.get("display_kind") == "kanban_notice"
+    assert session["_submit_user_row"]["content"] == text, "the turn adopts the row instead of writing a second"
+    sub = _sub(tid)
+    assert sub["inflight_from"] is None and sub["inflight_pid"] is None, "acked once durable"
+
+
+def test_redelivery_after_a_crash_between_write_and_ack_does_not_duplicate(gate, sdb):
+    tid = _task()
+    before = _sub(tid)["last_event_id"]
+    _complete(tid)
+    server._notif_poll_kanban_scoped("ui", _session())
+    assert len(_notices(sdb)) == 1 and len(gate["submitted"]) == 1
+
+    _orphan(tid, before)  # died after the row was written, before the ack
+    server._notif_poll_kanban_scoped("ui-new", _session())
+
+    assert len(_notices(sdb)) == 1, "deduped by event id"
+    assert len(gate["submitted"]) == 1, "no second turn for a notice already in the chat"
+    assert _sub(tid)["inflight_from"] is None
+
+
+def test_busy_transcript_keeps_the_claim_in_flight_and_buffered(gate, sdb, monkeypatch):
+    from hermes_state_errors import SessionTurnLeaseLostError
+
+    def _busy(*a, **k):
+        raise SessionTurnLeaseLostError("another backend runs a turn")
+
+    monkeypatch.setattr(sdb, "record_kanban_notice", _busy)
+    tid = _task()
+    before = _sub(tid)["last_event_id"]
+    _complete(tid)
+    session = _session()
+
+    server._notif_poll_kanban_scoped("ui", session)
+
+    assert gate["submitted"] == [] and len(session["_kanban_pending"]) == 1
+    assert session["running"] is False
+    assert _sub(tid)["inflight_from"] == before
+
+
+def test_live_holder_blocks_other_claimers_and_is_not_recovered():
+    tid = _task()
+    _complete(tid)
+    conn = kbc.connect()
+    try:
+        old, _new, events = kbn.claim_unseen_events_for_sub(conn, task_id=tid, platform="tui", chat_id=KEY,
+                                                           durable=True)
+        assert events
+        with kb.write_txn(conn):  # pretend a different, LIVE process holds it (our parent)
+            import os
+            conn.execute("UPDATE kanban_notify_subs SET inflight_pid = ?, inflight_start = NULL WHERE task_id = ?",
+                         (os.getppid(), tid))
+            conn.execute("UPDATE kanban_notify_subs SET last_event_id = ? WHERE task_id = ?", (old, tid))
+        assert kbn.recover_orphaned_notify_claims(conn) == 0
+        assert kbn.claim_unseen_events_for_sub(conn, task_id=tid, platform="tui", chat_id=KEY,
+                                               durable=True)[2] == []
+    finally:
+        conn.close()
+
+
+def test_ack_keeps_an_earlier_outstanding_claim_in_flight():
+    tid = _task()
+    conn = kbc.connect()
+    try:
+        kb.block_task(conn, tid, reason="first")
+        o1, n1, e1 = kbn.claim_unseen_events_for_sub(conn, task_id=tid, platform="tui", chat_id=KEY, durable=True)
+        kb.unblock_task(conn, tid)
+        assert kb.complete_task(conn, tid, summary="second")
+        o2, n2, e2 = kbn.claim_unseen_events_for_sub(conn, task_id=tid, platform="tui", chat_id=KEY, durable=True)
+        assert e1 and e2 and o2 == n1
+
+        kbn.ack_notify_claim(conn, task_id=tid, platform="tui", chat_id=KEY, upto=n2, from_cursor=o2)
+        assert _sub(tid)["inflight_from"] == o1, "the first claim is still undelivered"
+        kbn.ack_notify_claim(conn, task_id=tid, platform="tui", chat_id=KEY, upto=n2, from_cursor=o1)
+        assert _sub(tid)["inflight_from"] is None
+    finally:
+        conn.close()
+
+
+def test_unloaded_sweep_recovers_an_orphaned_claim(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_KANBAN_UNLOADED_WAKE", "0")
+    d = SessionDB(tmp_path / "state.db")
+    d.create_session(KEY, "desktop")
+    d.append_message(KEY, "user", "start")
+    tid = _task()
+    before = _sub(tid)["last_event_id"]
+    _complete(tid)
+    conn = kbc.connect()
+    try:
+        assert kbn.claim_unseen_events_for_sub(conn, task_id=tid, platform="tui", chat_id=KEY, durable=True)[2]
+    finally:
+        conn.close()
+    _orphan(tid, before)
+
+    @contextlib.contextmanager
