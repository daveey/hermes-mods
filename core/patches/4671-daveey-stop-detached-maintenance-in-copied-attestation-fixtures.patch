From c012b9ee1cce96d9ac8d1675140aa78ed26cf9f0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 00:36:52 +0000
Subject: [PATCH] [daveey] stop detached maintenance in copied attestation
 fixtures

Why: extension_core copies the shared real-Git core repository immediately
after its fixture commit. Git 2.55 can detach auto-maintenance; repack then
removes loose objects already enumerated by strict shutil.copytree. The
fixture's sanitized environment drops runner GIT_CONFIG_* policy, so runner
housekeeping disables cannot protect this repository.

Persist maintenance.auto=false before the first commit. Copies inherit it,
including extension and relaunch fixture commits. Keep real Git commits,
strict copytree, provenance, native loading and tamper assertions unchanged.

Proof (HERMES_TEST_FILE_RETRIES=0):
- Exact incident merge fd491792, Git 2.55.0: whole quiet-extension file
  naturally reproduced 44 passed/1 setup error with disappearing objects;
  isolated [False] passed 1. Fixture files match starting main 562deca345.
- Controlled real maintenance launch deferred to copytree's enumerated loose
  object gap: RED removes the object and raises shutil.Error; GREEN 45 passed.
- New regression uses real bucket-17 blobs and gc.auto=1, traces actual child
  launches after env sanitization, then verifies copied HEAD/fsck/clean tree.
  RED observes maintenance/gc/repack launches; GREEN suppresses all of them.
- Final Git 2.55: route, relaunch, extension and fixture regression 87 passed.
- Full scripts/check --base origin/main passed.

No retry policy, timeout, sleep, copy error suppression or product changes.
---
 .../test_code_attestation_fixture.py          | 48 +++++++++++++++++++
 .../hermes_cli/test_code_attestation_route.py |  4 ++
 2 files changed, 52 insertions(+)
 create mode 100644 tests/hermes_cli/test_code_attestation_fixture.py

diff --git a/tests/hermes_cli/test_code_attestation_fixture.py b/tests/hermes_cli/test_code_attestation_fixture.py
new file mode 100644
index 0000000000000000000000000000000000000000..067122cc07c1ad6d2a4c38abd48549985013bb2b
--- /dev/null
+++ b/tests/hermes_cli/test_code_attestation_fixture.py
@@ -0,0 +1,48 @@
+"""Copied attestation repositories must have no automatic background writers."""
+import hashlib
+import json
+import shutil
+import subprocess
+
+from tests.hermes_cli import test_code_attestation_route as route
+
+core = route.core
+
+
+def test_committed_core_copy_has_no_automatic_housekeeping(core, tmp_path, monkeypatch):
+    dest = tmp_path / "copy"
+    shutil.copytree(core, dest)
+    # Git auto-GC samples bucket 17. Exceed its threshold without hash luck or
+    # thousands of objects, while retaining a real commit and object database.
+    route._git(dest, "config", "gc.auto", "1")
+    found = 0
+    for index in range(10000):
+        data = f"maintenance regression {index}\n".encode()
+        oid = hashlib.sha1(f"blob {len(data)}\0".encode() + data).hexdigest()
+        if oid.startswith("17"):
+            (dest / f"maintenance-{found}").write_bytes(data)
+            found += 1
+            if found == 3:
+                break
+    assert found == 3
+    route._git(dest, "add", "-A")
+    trace = tmp_path / "git-trace.jsonl"
+    real_run = subprocess.run
+
+    def traced_run(command, **kwargs):
+        # The fixture intentionally sanitizes env; trace the actual child after
+        # that boundary, rather than relying on inherited GIT_* configuration.
+        kwargs["env"] = {**kwargs["env"], "GIT_TRACE2_EVENT": str(trace)}
+        return real_run(command, **kwargs)
+
+    with monkeypatch.context() as patch:
+        patch.setattr(route.subprocess, "run", traced_run)
+        route._git(dest, "commit", "-qm", "exercise automatic housekeeping")
+    events = [json.loads(line) for line in trace.read_text().splitlines()]
+    children = [event["argv"] for event in events if event.get("event") == "child_start"]
+    assert not any("maintenance" in argv or "gc" in argv for argv in children), children
+    copied = tmp_path / "after-commit"
+    shutil.copytree(dest, copied)
+    assert route._git(copied, "rev-parse", "HEAD") == route._git(dest, "rev-parse", "HEAD")
+    route._git(copied, "fsck", "--full")
+    assert route._git(copied, "status", "--porcelain") == ""
diff --git a/tests/hermes_cli/test_code_attestation_route.py b/tests/hermes_cli/test_code_attestation_route.py
index bc9d78c455a5470a31113b029c13a1cb204c10c5..15e1befa38441062ce2c7739466727530167e3f0 100644
--- a/tests/hermes_cli/test_code_attestation_route.py
+++ b/tests/hermes_cli/test_code_attestation_route.py
@@ -85,6 +85,10 @@ def core(tmp_path_factory):
     handoff.write_text(text.replace(marker, marker + "    import attest_probe  # noqa: F401\n    return 0\n", 1))
     (dest / "attest_probe.py").write_text(PROBE_MODULE)
     _git(dest, "init", "-q")
+    # A commit may detach maintenance that repacks/removes loose objects while
+    # consumers copy this repository. Persist the policy so copies inherit it;
+    # _git intentionally drops the runner's GIT_CONFIG_* environment settings.
+    _git(dest, "config", "maintenance.auto", "false")
     _git(dest, "add", "-A")
     _git(dest, "commit", "-qm", "fixture")
     return dest
