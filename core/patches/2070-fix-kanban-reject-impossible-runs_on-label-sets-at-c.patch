From 75f66cff3c7a8412eadd2ff9a042b200688ea796 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 9 Nov 2026 15:00:52 +0000
Subject: [PATCH] fix(kanban): reject impossible runs_on label sets at create
 [daveey]

---
 hermes_cli/kanban_runs_on_capabilities.py     | 14 +++++-
 .../test_kanban_runs_on_label_admission.py    | 48 +++++++++++++++++++
 2 files changed, 61 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_cli/test_kanban_runs_on_label_admission.py

diff --git a/hermes_cli/kanban_runs_on_capabilities.py b/hermes_cli/kanban_runs_on_capabilities.py
index fa2f3844543..78a0e237760 100644
--- a/hermes_cli/kanban_runs_on_capabilities.py
+++ b/hermes_cli/kanban_runs_on_capabilities.py
@@ -143,7 +143,19 @@ def check_create(conn, runs_on, *, assignee: Optional[str], requires, workspace_
     if sync.board_mode(conn) != "primary":
         return
     labels = wn.normalize_runs_on(runs_on if isinstance(runs_on, str) else list(runs_on))
-    check(labels, assignee=assignee, requires=requires, workspace_kind=workspace_kind, me=wn._own(conn))
+    reg = wn.registry() if labels else None
+    machines = reg.get("machines") if reg is not None else None
+    # No candidates is not evidence of missing profile tools (check deliberately
+    # allows unknown tools). It IS evidence of an impossible label conjunction.
+    # Include held/inactive machines: temporary unavailability is not a typo.
+    if labels and machines is not None and not any(
+            set(labels) <= wn.effective_labels(entry, name) for name, entry in machines.items()):
+        raise ValueError(
+            f"runs_on={labels}: no enrolled machine carries all these labels. Nothing was written. "
+            "Use placement='<gateway>' to name a gateway, or runs_on=['machine:<registered-name>'] "
+            "to pin a Board machine; bare strings are capability labels, not gateway aliases.")
+    check(labels, assignee=assignee, requires=requires, workspace_kind=workspace_kind, me=wn._own(conn),
+          machines=machines)
 
 
 def runs_elsewhere(conn, runs_on, *, machines: Optional[Mapping[str, Mapping[str, Any]]] = None) -> bool:
diff --git a/tests/hermes_cli/test_kanban_runs_on_label_admission.py b/tests/hermes_cli/test_kanban_runs_on_label_admission.py
new file mode 100644
index 00000000000..1f4ed7bb84a
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_runs_on_label_admission.py
@@ -0,0 +1,48 @@
+"""Reject unsatisfiable label conjunctions before they strand Board cards. [daveey]"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_worker_node as wn
+from tests.hermes_cli.test_kanban_worker_node import HUB, MACHINES
+
+pytest_plugins = ["tests.hermes_cli.test_kanban_requires_placement"]
+
+
+@pytest.mark.parametrize("labels", [["hermes-hub"], ["linux", "macos"]])
+@pytest.mark.parametrize("requires", [[], ["terminal"]])
+def test_create_refuses_labels_no_enrolled_machine_carries(gws, labels, requires):
+    hub, _ = gws
+    before = hub.conn.execute("SELECT count(*) FROM tasks").fetchone()[0]
+    with pytest.raises(ValueError, match="no enrolled machine"):
+        kb.create_task(hub.conn, title="unclaimable", assignee="default", requires=requires, runs_on=labels)
+    assert hub.conn.execute("SELECT count(*) FROM tasks").fetchone()[0] == before
+
+
+def test_tool_refusal_is_actionable_and_writes_nothing(gws, monkeypatch):
+    from tools import kanban_tools as kt
+    hub, _ = gws
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    before = hub.conn.execute("SELECT count(*) FROM tasks").fetchone()[0]
+    out = json.loads(kt._handle_create({"title": "unclaimable", "assignee": "default", "requires": [],
+                                      "runs_on": ["hermes-hub"], "placement": "local"}))
+    assert "no enrolled machine" in out.get("error", ""), out
+    assert "placement" in out["error"]
+    assert hub.conn.execute("SELECT count(*) FROM tasks").fetchone()[0] == before
+
+
+@pytest.mark.parametrize("labels", [[], ["linux"], [f"machine:{HUB}"]])
+def test_registered_labels_are_not_rejected_while_machines_held(gws, monkeypatch, labels):
+    hub, _ = gws
+    pool = {name: {**entry, "hold": True} for name, entry in MACHINES.items()}
+    monkeypatch.setattr(wn, "registry", lambda: {"machines": pool})
+    assert kb.create_task(hub.conn, title="held not impossible", assignee="default", requires=[], runs_on=labels)
+
+
+def test_unknown_registry_does_not_claim_labels_are_impossible(gws, monkeypatch):
+    hub, _ = gws
+    monkeypatch.setattr(wn, "registry", lambda: None)
+    assert kb.create_task(hub.conn, title="unknown", assignee="default", requires=[], runs_on=["custom"])
