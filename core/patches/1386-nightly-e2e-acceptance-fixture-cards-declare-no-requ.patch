From 8d9612cd7f24f921ebda40682effd510ff12aca4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 02:44:35 +0000
Subject: [PATCH] nightly e2e: acceptance fixture cards declare --no-requires
 (agent-run create)

---
 scripts/ci/nightly_e2e.py    | 2 ++
 tests/ci/test_nightly_e2e.py | 4 +++-
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/scripts/ci/nightly_e2e.py b/scripts/ci/nightly_e2e.py
index 502a66fd8e7..0342c961a8d 100644
--- a/scripts/ci/nightly_e2e.py
+++ b/scripts/ci/nightly_e2e.py
@@ -202,6 +202,8 @@ class NightlyBoard(CliBoard):
             "-",
             "--json",
             *override,
+            # A live-run identity makes this an agent-run create, which must declare needs; a fixture needs none.
+            *(["--no-requires"] if creator_task_id else []),
             stdin=body,
             extra_env=extra_env,
         )
diff --git a/tests/ci/test_nightly_e2e.py b/tests/ci/test_nightly_e2e.py
index 694b0d1ef7b..dbceed3f549 100644
--- a/tests/ci/test_nightly_e2e.py
+++ b/tests/ci/test_nightly_e2e.py
@@ -581,12 +581,14 @@ def test_acceptance_owner_must_be_the_running_worker_task(tmp_path, monkeypatch)
 def test_nightly_board_stamps_creator_only_for_acceptance(monkeypatch):
     envs = []
     board = ne.NightlyBoard("hermes")
-    monkeypatch.setattr(board, "_run", lambda *a, **k: envs.append(k.get("extra_env")) or '{"id":"t_x"}')
+    argv = []
+    monkeypatch.setattr(board, "_run", lambda *a, **k: argv.append(a) or envs.append(k.get("extra_env")) or '{"id":"t_x"}')
     live = {"runs": [{"id": 6, "status": "ended", "ended_at": 1}, {"id": 7, "status": "running", "ended_at": None}]}
     monkeypatch.setattr(board, "_show", lambda *a, **k: live)
     board.create("t", "b", "k")
     board.create("t", "b", "k", creator_task_id=OWNER)
     assert envs == [None, {"HERMES_KANBAN_TASK": OWNER, "HERMES_KANBAN_RUN_ID": "7"}]
+    assert ["--no-requires" in a for a in argv] == [False, True]
     live["runs"].pop()
     with pytest.raises(RuntimeError, match="no live run"):
         board.create("t", "b", "k", creator_task_id=OWNER)
-- 
2.55.0

