index 0000000000..d6b18fdc7c
--- /dev/null
+++ b/tests/gateway/test_channel_directory_slack_errors.py
@@ -0,0 +1,43 @@
+"""A Slack channel-list failure logs ONE line.
+
+``SlackApiError.__str__`` is two lines ("The request to the Slack API failed. (url: ...)" then
+"The server responded with: {...}"). Logged verbatim, the second line lands in the log file with
+no timestamp or level, so line-oriented shippers file it as its own record and grade it by its
+words — an ``invalid_auth`` warning became an error-level issue (Baby Bear mini, BB-69/BB-76).
+"""
+
+import asyncio
+import logging
+import os
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock, patch
+
+from gateway.channel_directory import _build_slack
+
+
+class _SlackApiError(Exception):
+    """Shape of ``slack_sdk.errors.SlackApiError``: multi-line str, ``response['error']``."""
+
+    def __init__(self, url: str, error: str):
+        self.response = {"ok": False, "error": error}
+        super().__init__(
+            f"The request to the Slack API failed. (url: {url}, status: 200)\n"
+            f"The server responded with: {self.response}"
+        )
+
+
+def test_slack_api_error_is_logged_on_one_line(tmp_path, caplog):
+    client = MagicMock()
+    client.users_conversations = AsyncMock(
+        side_effect=_SlackApiError("https://slack.com/api/users.conversations", "invalid_auth"))
+    adapter = SimpleNamespace(_team_clients={"T0TEAM": client})
+
+    with patch.dict(os.environ, {"HERMES_HOME": str(tmp_path)}), \
+            caplog.at_level(logging.WARNING, logger="gateway.channel_directory"):
+        asyncio.run(_build_slack(adapter))
+
+    warnings = [r.getMessage() for r in caplog.records if r.levelno == logging.WARNING]
+    assert len(warnings) == 1
+    assert "\n" not in warnings[0]
+    assert "invalid_auth" in warnings[0]
+    assert "T0TEAM" in warnings[0]
diff --git a/tests/hermes_cli/test_gateway_exit_diag.py b/tests/hermes_cli/test_gateway_exit_diag.py
new file mode 100644
index 0000000000..2ca53130b1
--- /dev/null
+++ b/tests/hermes_cli/test_gateway_exit_diag.py
@@ -0,0 +1,56 @@
+"""``logs/gateway-exit-diag.log`` records carry a ``level`` so log shippers grade them by intent.
+
+A supervised gateway restarts by exiting 75 (SIGUSR1 drain, ``hermes update``, ``/restart``); its
+``asyncio.run.SystemExit`` record used to carry only a traceback, which log shippers that grade
+JSON lines by keywords filed as an error on every routine restart (Baby Bear mini, BB-59).
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from gateway.restart import GATEWAY_SERVICE_RESTART_EXIT_CODE
+from hermes_cli.gateway_exit_diag import make_exit_diag
+
+
+def _rows() -> list[dict]:
+    path = Path(os.environ["HERMES_HOME"]) / "logs" / "gateway-exit-diag.log"
+    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines()]
+
+
+@pytest.mark.parametrize("code", [None, 0, GATEWAY_SERVICE_RESTART_EXIT_CODE])
+def test_planned_system_exit_is_info(code):
+    make_exit_diag()("asyncio.run.SystemExit", code=code, traceback="Traceback (most recent call last): ...")
+    assert _rows()[-1]["level"] == "info"
+
+
+@pytest.mark.parametrize("code", [1, 2, "fatal"])
+def test_failing_system_exit_is_error(code):
+    make_exit_diag()("asyncio.run.SystemExit", code=code, traceback="Traceback (most recent call last): ...")
+    assert _rows()[-1]["level"] == "error"
+
+
+@pytest.mark.parametrize(
+    ("tag", "level"),
+    [
+        ("gateway.start", "info"),
+        ("asyncio.run.returned", "info"),
+        ("gateway.exit_clean", "info"),
+        ("atexit.hook", "info"),
+        ("gateway.exit_nonzero", "error"),
+        ("asyncio.run.exception", "error"),
+    ],
+)
+def test_lifecycle_records_carry_their_level(tag, level):
+    make_exit_diag()(tag)
+    assert _rows()[-1]["level"] == level
+
+
+def test_opt_out_writes_nothing(monkeypatch):
+    monkeypatch.setenv("HERMES_GATEWAY_EXIT_DIAG", "0")
+    make_exit_diag()("gateway.start")
+    assert not (Path(os.environ["HERMES_HOME"]) / "logs" / "gateway-exit-diag.log").exists()
diff --git a/tests/tui_gateway/test_tui_gateway_loop_noise_ws_keepalive.py b/tests/tui_gateway/test_tui_gateway_loop_noise_ws_keepalive.py
new file mode 100644
index 0000000000..24dd6a7afe
--- /dev/null
+++ b/tests/tui_gateway/test_tui_gateway_loop_noise_ws_keepalive.py
@@ -0,0 +1,76 @@
+"""A websocket that closes while uvicorn's keepalive awaits a pong is not a loop error.
+
+websockets' legacy protocol returns ``asyncio.shield(pong_waiter)`` from ``ping()``. When the
+connection closes, ``close_connection`` cancels the keepalive task (cancelling the shield's
+outer future) and ``abort_pings`` then sets ``ConnectionClosed`` on the inner waiter. asyncio's
+shield logs that as "ConnectionClosedOK exception in shielded future" at ERROR — on every Desktop
+SSH-tunnel disconnect, where the serve backend runs keepalive pings (Baby Bear mini, BB-70/71/75).
+"""
+
+from __future__ import annotations
+
+import asyncio
+
+import pytest
+
+from tui_gateway.loop_noise import install_loop_noise_filter
+
+websockets_exceptions = pytest.importorskip("websockets.exceptions")
+websockets_frames = pytest.importorskip("websockets.frames")
+
+
+def _closed_ok():
+    close = websockets_frames.Close(websockets_frames.CloseCode.NO_STATUS_RCVD, "")
+    return websockets_exceptions.ConnectionClosedOK(close, close, True)
+
+
+def _shielded_failure(loop: asyncio.AbstractEventLoop, exc: BaseException) -> None:
+    """Replay the keepalive sequence: await a shielded waiter, cancel the awaiter, then fail the waiter."""
+    async def scenario():
+        waiter = loop.create_future()
+
+        async def keepalive():
+            await asyncio.shield(waiter)
+
+        task = asyncio.ensure_future(keepalive())
+        await asyncio.sleep(0)
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        waiter.set_exception(exc)
+        waiter.cancel()  # abort_pings' no-op cancel on the already-done waiter
+        await asyncio.sleep(0)
+
+    loop.run_until_complete(scenario())
+
+
+@pytest.fixture
+def loop_with_capture():
+    loop = asyncio.new_event_loop()
+    forwarded: list[dict] = []
+    loop.set_exception_handler(lambda _loop, ctx: forwarded.append(ctx))
+    install_loop_noise_filter(loop)
+    try:
+        yield loop, forwarded
+    finally:
+        loop.close()
+
+
+def test_closed_websocket_in_shielded_keepalive_is_not_forwarded(loop_with_capture):
+    loop, forwarded = loop_with_capture
+    _shielded_failure(loop, _closed_ok())
+    assert forwarded == []
+
+
+def test_other_exception_in_shielded_future_still_forwarded(loop_with_capture):
+    loop, forwarded = loop_with_capture
+    _shielded_failure(loop, RuntimeError("real bug behind a shield"))
+    assert len(forwarded) == 1
+    assert isinstance(forwarded[0]["exception"], RuntimeError)
+
+
+def test_closed_websocket_outside_a_shield_still_forwarded(loop_with_capture):
+    loop, forwarded = loop_with_capture
+    ctx = {"message": "Task exception was never retrieved", "exception": _closed_ok()}
+    loop.call_exception_handler(ctx)
+    assert forwarded == [ctx]
