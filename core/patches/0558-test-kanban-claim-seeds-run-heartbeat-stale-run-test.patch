From f147bf0fa9aded70fc144132626ae53576a297ad Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:51:16 +0000
Subject: [PATCH] test(kanban): claim seeds run heartbeat; stale-run test
 asserts it is unchanged

---
 tests/hermes_cli/test_kanban_core_functionality.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_core_functionality.py b/tests/hermes_cli/test_kanban_core_functionality.py
index fae5b6e8ff..55dd676f62 100644
--- a/tests/hermes_cli/test_kanban_core_functionality.py
+++ b/tests/hermes_cli/test_kanban_core_functionality.py
@@ -417,13 +417,15 @@ def test_stale_run_cannot_block_or_heartbeat_new_attempt(kanban_home, monkeypatc
         kb.claim_task(conn, tid)
         run2 = kb.latest_run(conn, tid)
         assert run2.id != run1.id
+        # claim seeds the heartbeat for the new run; stale echoes must not move it.
+        seeded_hb = kb.get_task(conn, tid).last_heartbeat_at
 
         assert not kbd.heartbeat_worker(conn, tid, note="late", expected_run_id=run1.id)
         assert not kb.block_task(conn, tid, reason="late block", expected_run_id=run1.id)
         task = kb.get_task(conn, tid)
         assert task.status == "running"
         assert task.current_run_id == run2.id
-        assert task.last_heartbeat_at is None
+        assert task.last_heartbeat_at == seeded_hb
 
         assert kbd.heartbeat_worker(conn, tid, note="current", expected_run_id=run2.id)
         assert kb.block_task(conn, tid, reason="current block", expected_run_id=run2.id)
