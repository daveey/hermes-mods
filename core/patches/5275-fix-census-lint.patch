From 6945982764adf963a3bad4959f3ecd474fc9e055 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 19:36:50 +0000
Subject: [PATCH] fix: census lint

---
 hermes_cli/machine_persistent_jobs.py        |  2 +-
 hermes_cli/worker_drain_census.py            |  2 +-
 tests/hermes_cli/test_worker_drain_census.py | 10 +++++-----
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/machine_persistent_jobs.py b/hermes_cli/machine_persistent_jobs.py
index 710d116e4c..7748a6a670 100644
--- a/hermes_cli/machine_persistent_jobs.py
+++ b/hermes_cli/machine_persistent_jobs.py
@@ -41,7 +41,7 @@ def _complete_zero(at_ms: int) -> dict:
         if fence.load_activation() is None:
             return {}
         count = census.complete_count()
-    except Exception:
+    except Exception:  # health: allow BLE001 -- any census/fence fault must degrade to UNKNOWN, never zero
         return {}
     if count is None:
         return {}
diff --git a/hermes_cli/worker_drain_census.py b/hermes_cli/worker_drain_census.py
index 6644adde16..ec447c5712 100644
--- a/hermes_cli/worker_drain_census.py
+++ b/hermes_cli/worker_drain_census.py
@@ -34,7 +34,7 @@ def census(proc_root: str = "/proc", uid: int | None = None) -> int | None:
     """Return the count of non-baseline worker processes, or None if UNKNOWN."""
     if not sys.platform.startswith("linux"):
         return None
-    uid = os.getuid() if uid is None else uid
+    uid = os.getuid() if uid is None else uid  # windows-footgun: ok
     me = str(os.getpid())
     try:
         entries = [e for e in os.listdir(proc_root) if e.isdigit()]
diff --git a/tests/hermes_cli/test_worker_drain_census.py b/tests/hermes_cli/test_worker_drain_census.py
index a4f6df63c8..e52be4f822 100644
--- a/tests/hermes_cli/test_worker_drain_census.py
+++ b/tests/hermes_cli/test_worker_drain_census.py
@@ -21,7 +21,7 @@ U = "/user.slice/user-1000.slice/user@1000.service"
 def test_baseline_only_is_zero(tmp_path):
     _proc(tmp_path, 10, U + "/init.scope")
     _proc(tmp_path, 11, U + "/app.slice/gpg-agent.service")
-    assert census.census(str(tmp_path), uid=os.getuid()) == 0
+    assert census.census(str(tmp_path), uid=os.stat(str(tmp_path)).st_uid) == 0
 
 
 def test_unscoped_and_app_slice_work_counts(tmp_path):
@@ -29,20 +29,20 @@ def test_unscoped_and_app_slice_work_counts(tmp_path):
     _proc(tmp_path, 11, U + "/app.slice/hermes-core-update.service")
     _proc(tmp_path, 12, "/user.slice/user-1000.slice/session-3.scope")
     _proc(tmp_path, 13, U + "/hermes.slice/hermes-kanban.slice/x.service")
-    assert census.census(str(tmp_path), uid=os.getuid()) == 3
+    assert census.census(str(tmp_path), uid=os.stat(str(tmp_path)).st_uid) == 3
 
 
 def test_kernel_thread_ignored(tmp_path):
     _proc(tmp_path, 10, "/", cmdline="")
-    assert census.census(str(tmp_path), uid=os.getuid()) == 0
+    assert census.census(str(tmp_path), uid=os.stat(str(tmp_path)).st_uid) == 0
 
 
 def test_unreadable_entry_is_unknown(tmp_path):
     d = tmp_path / "10"
     d.mkdir()  # no cgroup file readable -> exited => skipped
-    assert census.census(str(tmp_path), uid=os.getuid()) == 0
+    assert census.census(str(tmp_path), uid=os.stat(str(tmp_path)).st_uid) == 0
     (d / "cgroup").mkdir()  # IsADirectoryError is an OSError we cannot classify
-    assert census.census(str(tmp_path), uid=os.getuid()) is None
+    assert census.census(str(tmp_path), uid=os.stat(str(tmp_path)).st_uid) is None
 
 
 def test_missing_proc_is_unknown(tmp_path):
