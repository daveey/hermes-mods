From db912ef4f8b3d270cef3c8f41b2ec419026c3947 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 20:28:03 +0000
Subject: [PATCH] [daveey] Stamp only stranded passive notices to preserve idle
 caching

---
 tests/tui_gateway/test_notice_guarantee.py |  4 +++-
 tui_gateway/notice_guarantee.py            | 14 ++++++++++----
 2 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/tests/tui_gateway/test_notice_guarantee.py b/tests/tui_gateway/test_notice_guarantee.py
index a724c0b76ff..7d7acbb7c18 100644
--- a/tests/tui_gateway/test_notice_guarantee.py
+++ b/tests/tui_gateway/test_notice_guarantee.py
@@ -161,7 +161,9 @@ def test_informational_marker_only_applies_to_validated_notice_rows(role, kind,
 
 
 def test_human_notice_stamp_does_not_overwrite_a_concurrent_claim(db):
-    tid = _decision_card()
+    with contextlib.closing(kbc.connect()) as conn:
+        tid = kb.create_task(conn, title="other deploy", assignee="worker", session_id="other-chat",
+                             initial_status="blocked", human_request=HUMAN, lint_blocked=False)
     row = _notice(db, f"⏸ Kanban {tid} blocked", task_id=tid)
     [cand] = ng.candidates(db, time.time())
     ng._stamp(db, row, "claimed")
diff --git a/tui_gateway/notice_guarantee.py b/tui_gateway/notice_guarantee.py
index 05aeab6c7d0..e5947ccc576 100644
--- a/tui_gateway/notice_guarantee.py
+++ b/tui_gateway/notice_guarantee.py
@@ -250,16 +250,22 @@ def _refresh_once(db: Any, cand: dict, branch: str, seen: set) -> str:
     seen.add(key)
     if key in _refreshed:
         return "skipped:refreshed"
-    if branch == "human":
-        # This notice intentionally starts no turn. Keep the real card decision in
-        # live-work precedence, but don't strand incidental (touch-only) recipients.
+    from hermes_state_outcome import get_outcome
+
+    refreshed = _refresh(db, cand["sid"])
+    outcome = get_outcome(cand["sid"], db=db) if refreshed else None
+    if branch == "human" and outcome and outcome.get("reason") == "notice_tail":
+        # No owning decision/wait accounted for this intentionally passive notice.
+        # Preserve the preceding turn instead of manufacturing an obligation for
+        # an incidental recipient. Other outcomes need no metadata write.
         meta = {**cand["meta"], "outcome_informational": True}
         changed = db._write_rowcount(
             "UPDATE messages SET display_metadata = ? WHERE id = ? AND display_metadata IS ?",
             (json.dumps(meta, ensure_ascii=False), cand["msg_id"], cand["raw_meta"]))
         if changed != 1:
             return "skipped:changed"
-    if _refresh(db, cand["sid"]):
+        refreshed = _refresh(db, cand["sid"])
+    if refreshed:
         _refreshed.add(key)
     return f"refreshed:{branch}"
 
-- 
2.55.0

