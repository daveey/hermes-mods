From b89f24b00cc9913a34f7cdcf88e1aba71d1b2d9d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 18:23:57 -0800
Subject: [PATCH] fix(doctor): UPPER_SNAKE env names stay readable in
 NAME=value tokens

An environment-style name with digits (HERMES_RELAY_ID_2024=abc) looked like
a random token, so the whole assignment was masked, name included. An
UPPER_SNAKE name is now always a name: its value is judged under it, so
OPENROUTER_API_KEY_2024=... still hides the value. Tested.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_state_argv_secrets.py            | 5 ++++-
 tests/hermes_state/test_argv_secrets.py | 5 +++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/hermes_state_argv_secrets.py b/hermes_state_argv_secrets.py
index 14d548bb1c0..39150694d74 100644
--- a/hermes_state_argv_secrets.py
+++ b/hermes_state_argv_secrets.py
@@ -35,6 +35,8 @@ _TOKEN_CHARS = re.compile(r"^[A-Za-z0-9_+=.~-]+$")
 _HEX = re.compile(r"^[0-9a-fA-F-]+$")
 _HERMES_ID = re.compile(r"^(?:t_[0-9a-f]+|\d{8}_\d{6}_[0-9a-z]+|[a-z]+(?:[-_][a-z]+)+)$")
 _ASSIGNMENT = re.compile(r"^([A-Za-z][A-Za-z0-9_.-]*)=")
+# An environment-style name (HERMES_RELAY_ID_2024, OPENROUTER_API_KEY_2): a name, never a random token.
+_ENV_NAME = re.compile(r"^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+$")
 _NUMBER = re.compile(r"^[+-]?\d+(?:\.\d+)?$")
 _PATH_START = re.compile(r"^(?:/|~|\.{1,2}/|\\|[A-Za-z]:[\\/])")
 _MIN_BARE_SECRET = 20
@@ -104,7 +106,8 @@ def mask_argv_secrets(argv: list[str]) -> list[str]:
         name, value = (assignment.group(1), token[assignment.end():]) if assignment else ("", "")
         # ssh -o ServerAliveInterval=15, env-style NAME=value -- not base64 padding (``Zm9v…MA==``: a random "name"
         # followed by "=" or nothing), which is judged as one token below.
-        if assignment and value and not value.startswith("=") and not _looks_like_bare_secret(name):
+        if (assignment and value and not value.startswith("=")
+                and (_ENV_NAME.match(name) or not _looks_like_bare_secret(name))):
             out.append(f"{name}={_mask_value(value, secret_named=_is_secret_flag('--' + name))}")
             continue
         out.append(_mask_value(token, secret_named=False))
diff --git a/tests/hermes_state/test_argv_secrets.py b/tests/hermes_state/test_argv_secrets.py
index 3dc280cf711..7a593565b63 100644
--- a/tests/hermes_state/test_argv_secrets.py
+++ b/tests/hermes_state/test_argv_secrets.py
@@ -67,6 +67,11 @@ KEY = "q8ZpL2vXk9RtYwB4mN7cQ1sD5fH3jK6g"
             ["API_TOKEN=abc123", "Config=" + KEY],
             [f"API_TOKEN={MASK}", f"Config={MASK}"],
         ),
+        # an UPPER_SNAKE env name stays readable; a secret-named one still hides its value
+        (
+            ["HERMES_RELAY_ID_2024=abc", "OPENROUTER_API_KEY_2024=sk12"],
+            ["HERMES_RELAY_ID_2024=abc", f"OPENROUTER_API_KEY_2024={MASK}"],
+        ),
         # plural secret lists are secrets too
         (
             ["--github-tokens", "Qx7Lm2Zp/w", "--bot-tokens=abc"],
-- 
