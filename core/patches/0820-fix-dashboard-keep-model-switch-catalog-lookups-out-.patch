diff --git a/tests/agent/test_models_dev_network_scope.py b/tests/agent/test_models_dev_network_scope.py
new file mode 100644
index 0000000000..e5c3ceb40c
--- /dev/null
+++ b/tests/agent/test_models_dev_network_scope.py
@@ -0,0 +1,30 @@
+"""A scoped catalog policy must be cache-only, nested and exception safe."""
+
+import pytest
+
+from agent import models_dev
+
+
+@pytest.mark.parametrize("source", ["memory", "disk", "cold"])
+def test_cache_only_scope_serves_available_data_and_restores_on_error(monkeypatch, source):
+    registry = {"example": {"name": "Example", "models": {}}}
+    monkeypatch.setattr(models_dev, "_models_dev_cache", registry if source == "memory" else {})
+    monkeypatch.setattr(models_dev, "_models_dev_cache_time", 0)
+    monkeypatch.setattr(models_dev, "_models_dev_retry_after", 0)
+    monkeypatch.setattr(models_dev, "_load_disk_cache", lambda: registry if source == "disk" else {})
+    monkeypatch.setattr(models_dev, "_disk_cache_age_seconds", lambda: None)
+    calls = []
+
+    def fetch(**_kwargs):
+        calls.append(True)
+        raise OSError("offline")
+
+    monkeypatch.setattr(models_dev, "_fetch_models_dev_from_network", fetch)
+    with pytest.raises(ValueError, match="test unwind"):
+        with models_dev.models_dev_network_scope(allow_network=False):
+            with models_dev.models_dev_network_scope(allow_network=True):
+                assert models_dev.fetch_models_dev(force_refresh=True) == ({} if source == "cold" else registry)
+                assert not calls
+                raise ValueError("test unwind")
+    models_dev.fetch_models_dev(force_refresh=True)
+    assert calls
diff --git a/tests/hermes_cli/test_config_model_catalog_lock.py b/tests/hermes_cli/test_config_model_catalog_lock.py
new file mode 100644
index 0000000000..20d0ed6fb9
--- /dev/null
+++ b/tests/hermes_cli/test_config_model_catalog_lock.py
@@ -0,0 +1,84 @@
+"""A cold models.dev fetch must not monopolize dashboard config writes."""
+
+import threading
+
+import pytest
+
+from tests.hermes_cli.test_config_rmw_lock import client as rmw_client, _on_disk
+
+
+@pytest.mark.parametrize("operation", ["activate", "make_default"])
+def test_blocked_catalog_fetch_does_not_block_config_autosave(request, monkeypatch, operation):
+    client = request.getfixturevalue("rmw_client")
+    from agent import models_dev
+    from hermes_cli.config import load_config, save_config
+
+    cfg = load_config()
+    cfg["providers"] = {"racebox": {"base_url": "http://racebox:8000/v1", "model": "race-model", "api_key": "k"}}
+    save_config(cfg)
+    monkeypatch.setattr(models_dev, "_models_dev_cache", {})
+    monkeypatch.setattr(models_dev, "_models_dev_cache_time", 0)
+    monkeypatch.setattr(models_dev, "_models_dev_retry_after", 0)
+    monkeypatch.setattr(models_dev, "_load_disk_cache", dict)
+    monkeypatch.setattr(models_dev, "_disk_cache_age_seconds", lambda: None)
+    fetching, release, saved = threading.Event(), threading.Event(), threading.Event()
+    results, errors = {}, []
+
+    def blocked_fetch(**_kwargs):
+        fetching.set()
+        release.wait()
+        raise OSError("catalog unavailable")
+
+    monkeypatch.setattr(models_dev, "_fetch_models_dev_from_network", blocked_fetch)
+
+    def send_request(name, callback):
+        try:
+            results[name] = callback()
+        except BaseException as exc:
+            errors.append(exc)
+        finally:
+            if name == "autosave":
+                saved.set()
+
+    # Hold a real foreground catalog fetch open. The dashboard's model writer
+    # must not join it while holding the config RMW lock.
+    catalog = threading.Thread(target=lambda: models_dev.fetch_models_dev())
+    def select_model():
+        if operation == "activate":
+            return client.post("/api/providers/custom-endpoints/racebox/activate")
+        return client.post("/api/providers/custom-endpoints", json={
+            "id": "racebox", "name": "racebox", "base_url": "http://racebox:8000/v1",
+            "model": "race-model", "make_default": True, "discover_models": False})
+
+    activate = threading.Thread(target=send_request, args=("activate", select_model))
+    autosave = threading.Thread(target=send_request, args=("autosave", lambda: client.put(
+        "/api/config", json={"config": {"display": {"personality": "canary"}}})))
+    reached_switch = threading.Event()
+    from hermes_cli import model_switch
+    real_label = model_switch._switch_provider_label
+
+    def label(st):
+        # This point is reached under the config lock, before the old blocking lookup.
+        reached_switch.set()
+        return real_label(st)
+
+    monkeypatch.setattr(model_switch, "_switch_provider_label", label)
+    catalog.start()
+    try:
+        assert fetching.wait(10), "catalog fetch did not start"
+        activate.start()
+        assert reached_switch.wait(10), "activation did not reach model switch"
+        autosave.start()
+        assert saved.wait(10), "autosave waited for the blocked catalog fetch"
+        assert not release.is_set()
+    finally:
+        release.set()
+        for thread in (catalog, activate, autosave):
+            if thread.ident is not None:
+                thread.join(30)
+                assert not thread.is_alive()
+    assert not errors
+    assert results["activate"].status_code == 200, results["activate"].text
+    assert results["autosave"].status_code == 200, results["autosave"].text
+    assert _on_disk()["model"]["provider"] == "racebox"
+    assert _on_disk()["display"]["personality"] == "canary"
diff --git a/tests/hermes_cli/test_model_switch_catalog_network.py b/tests/hermes_cli/test_model_switch_catalog_network.py
new file mode 100644
index 0000000000..12c26a68ae
--- /dev/null
+++ b/tests/hermes_cli/test_model_switch_catalog_network.py
@@ -0,0 +1,38 @@
+"""Dashboard cache-only switching keeps CLI catalog fetches available."""
+
+import pytest
+
+from agent import models_dev
+from hermes_cli.model_switch import switch_model
+
+
+@pytest.mark.parametrize("allow_network", [False, True])
+@pytest.mark.parametrize("provider", ["openrouter", "racebox"])
+def test_switch_catalog_network_policy(monkeypatch, allow_network, provider):
+    monkeypatch.setattr(models_dev, "_models_dev_cache", {})
+    monkeypatch.setattr(models_dev, "_models_dev_cache_time", 0)
+    monkeypatch.setattr(models_dev, "_models_dev_retry_after", 0)
+    monkeypatch.setattr(models_dev, "_load_disk_cache", dict)
+    monkeypatch.setattr(models_dev, "_disk_cache_age_seconds", lambda: None)
+    calls = []
+
+    def fetch(**_kwargs):
+        calls.append(True)
+        raise OSError("offline")
+
+    monkeypatch.setattr(models_dev, "_fetch_models_dev_from_network", fetch)
+    monkeypatch.setattr("hermes_cli.runtime_provider.resolve_runtime_provider", lambda **_kw: {
+        "api_key": "test-key", "base_url": "http://endpoint/v1", "api_mode": "chat_completions"})
+    monkeypatch.setattr("hermes_cli.models_validate.validate_requested_model", lambda *_a, **_kw: {
+        "accepted": True, "persist": True, "recognized": True})
+    kwargs: dict = {} if allow_network else {"allow_network": False}
+    result = switch_model(
+        "race-model", current_provider=provider, current_model="old-model", explicit_provider=provider,
+        user_providers={"racebox": {"base_url": "http://endpoint/v1", "model": "race-model", "api_key": "k"}},
+        **kwargs)
+    assert result.success, result.error_message
+    assert bool(calls) is allow_network
+    # The per-operation policy must not leak into the next CLI request.
+    if not allow_network:
+        models_dev.fetch_models_dev()
+        assert calls
