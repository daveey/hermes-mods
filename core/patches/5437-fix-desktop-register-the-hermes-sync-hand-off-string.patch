From a61ed2bc32bef9f4cb2bf8fde409093776fb7505 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 00:05:50 -0800
Subject: [PATCH] fix(desktop): register the hermes-sync hand-off strings in
 the i18n key catalog and overlay gaps [daveey]

CI on #3919: locales/_keys.desktop.json was stale and the two new English strings had no
overlay entry; they join the other Force update strings as known gaps (English fallback).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/desktop/src/i18n/overlay-gaps.json | 2 ++
 locales/_keys.desktop.json              | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/apps/desktop/src/i18n/overlay-gaps.json b/apps/desktop/src/i18n/overlay-gaps.json
index 257983e15d..fe7e5c294c 100644
--- a/apps/desktop/src/i18n/overlay-gaps.json
+++ b/apps/desktop/src/i18n/overlay-gaps.json
@@ -2383,6 +2383,8 @@
   "shell.statusbar.forceUpdate.confirmBody": ["ar","de","es","fr","ja","ru","zh","zh-hant"],
   "shell.statusbar.forceUpdate.confirmLabel": ["ar","de","es","fr","ja","ru","zh","zh-hant"],
   "shell.statusbar.forceUpdate.cancelLabel": ["ar","de","es","fr","ja","ru","zh","zh-hant"],
+  "shell.statusbar.forceUpdate.syncedTitle": ["ar","de","es","fr","ja","ru","zh","zh-hant"],
+  "shell.statusbar.forceUpdate.syncedApplying": ["ar","de","es","fr","ja","ru","zh","zh-hant"],
   "shell.statusbar.forceUpdate.requested": ["ar","de","es","fr","ja","ru","zh","zh-hant"],
   "shell.statusbar.forceUpdate.failed": ["ar","de","es","fr","ja","ru","zh","zh-hant"],
   "assistant.thread.errorCodes.core_update_forced_stop.body": ["ar","de","es","fr","ja","ru","zh","zh-hant"],
diff --git a/locales/_keys.desktop.json b/locales/_keys.desktop.json
index 6e63ba5419..1040807afc 100644
--- a/locales/_keys.desktop.json
+++ b/locales/_keys.desktop.json
@@ -4709,6 +4709,8 @@
     "shell.statusbar.forceUpdate.failed",
     "shell.statusbar.forceUpdate.menuItem",
     "shell.statusbar.forceUpdate.requested",
+    "shell.statusbar.forceUpdate.syncedApplying",
+    "shell.statusbar.forceUpdate.syncedTitle",
     "shell.statusbar.gateway",
     "shell.statusbar.gatewayChecking",
     "shell.statusbar.gatewayConnecting",
