From 1e5ac4b3520a5d10783124b8f1ca398f68190d15 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 01:58:57 +0000
Subject: [PATCH] fix(kanban): preserve host paths and board administration
 fence [daveey]

---
 hermes_cli/kanban_placement.py                 |  4 +++-
 hermes_cli/kanban_placement_coordination.py    |  5 +++++
 .../test_kanban_coordination_placement.py      | 18 ++++++++++++++++++
 3 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index fd47b611ddb..4d12061fb58 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -444,7 +444,9 @@ def portable_reason(args: dict, cfg: Optional[dict] = None) -> Optional[str]:
         return refusal
     marker_full = coordination.marker_text(full)
     extra = c.raw.get("extra_home_markers")
-    pats = [(p, marker_full) for p in HOME_GATEWAY_MARKERS if p != HOST_WORKTREE_PATH]
+    exemptible = (HUB_CLI_COMMAND, r"\btoken-broker\b")
+    pats = [(p, marker_full if p in exemptible else full)
+            for p in HOME_GATEWAY_MARKERS if p != HOST_WORKTREE_PATH]
     pats += [(p, full) for p in extra] if isinstance(extra, list) else []
     for p, text in pats:
         try:
diff --git a/hermes_cli/kanban_placement_coordination.py b/hermes_cli/kanban_placement_coordination.py
index 83597c41e16..2530f2a9b1b 100644
--- a/hermes_cli/kanban_placement_coordination.py
+++ b/hermes_cli/kanban_placement_coordination.py
@@ -60,6 +60,11 @@ _TOOLS = {
 def requirements(text):
     """Return required labels and an unsupported-action refusal, without changing text."""
     labels = set()
+    # Reader/broker attestations do not grant managed-worker board administration.
+    if re.search(r"\binstall-boards\.py\b|\bhermes kanban boards (?:create|subscribe)\b|"
+                 r"\bcreate board replicas\b|\battach primary/pickup subscriptions\b",
+                 text, re.IGNORECASE):
+        return labels, ACTION_REASON
     for _, _, action in _actions(text, _HUB, _HUB_ACTIONS):
         if action not in ("status", "pull"):
             return labels, ACTION_REASON
diff --git a/tests/hermes_cli/test_kanban_coordination_placement.py b/tests/hermes_cli/test_kanban_coordination_placement.py
index af85ec6314c..219b4fb20e7 100644
--- a/tests/hermes_cli/test_kanban_coordination_placement.py
+++ b/tests/hermes_cli/test_kanban_coordination_placement.py
@@ -23,6 +23,24 @@ def reason(body, cfg):
     return kp.portable_reason({"title": "Read coordination evidence", "body": body}, cfg)
 
 
+def test_independent_broker_state_path_stays_home(fleet):
+    cfg, _, _ = fleet
+    assert reason("Inspect ~/.hermes/token-broker", cfg) == "home gateway marker"
+
+
+def test_board_provisioning_is_not_reader_capability(fleet):
+    cfg, _, _ = fleet
+    body = ("Worker-local implementation: create board replicas and attach primary/pickup "
+            "subscriptions; token-broker exec for gh read")
+    assert reason(body, cfg) == "needs home coordination action"
+
+
+@pytest.mark.parametrize("body", ["run install-boards.py", "hermes kanban boards create runners"])
+def test_board_admin_commands_stay_home(fleet, body):
+    cfg, _, _ = fleet
+    assert reason(body, cfg) == "needs home coordination action"
+
+
 def test_attested_reader_and_broker_are_portable(fleet):
     cfg, _, _ = fleet
     assert reason("cross_task read; hermes-hub status; token-broker exec for gh read", cfg) is None
-- 
2.55.0

