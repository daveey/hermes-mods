From 511893aae448a87e6e5c391f7195a22cd517bb40 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 13:56:25 +0000
Subject: [PATCH] [daveey] test(browser): fake_daemon awaits the stand-in's
 visible argv before ownership checks

Popen returns once exec has begun, but the kernel publishes the new
argv a moment later. On a throttled runner both back-to-back
_own_harness_daemon calls in
test_an_owned_harness_daemon_is_not_re_verified_and_a_replacement_releases_the_old_group
read an empty /proc/<pid>/cmdline, so nothing was registered
(CI run 43226987483: assert [] == [('register', [225105])]).

The real harness publishes its pid file from the running daemon, so
its argv is always visible by then. The fixture now waits (generous
timeout, returns as soon as it holds) for that precondition, as the
other-Hermes test already does (#938), and kills the stand-in if the
wait fails. Fault injection (first two cmdline reads empty) fails 3
tests at the old fixture and passes all at the new one.
---
 .../tools/test_browser_use_cli_owned_daemon.py | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/tests/tools/test_browser_use_cli_owned_daemon.py b/tests/tools/test_browser_use_cli_owned_daemon.py
index 9c4fd8bf89..279e4a94a4 100644
--- a/tests/tools/test_browser_use_cli_owned_daemon.py
+++ b/tests/tools/test_browser_use_cli_owned_daemon.py
@@ -42,12 +42,22 @@ def fake_daemon(tmp_path):
     proc = subprocess.Popen([sys.executable, "-m", "browser_harness.daemon"], cwd=str(tmp_path / "pkgroot"),
                             stdin=subprocess.DEVNULL, start_new_session=True,
                             env={**os.environ, **process_identity.spawn_env("browser-harness-daemon")})
+    # Popen returns once exec has begun, but the kernel publishes the new argv a moment later: a
+    # throttled CI container can read an empty /proc/<pid>/cmdline for both of a test's back-to-back
+    # ownership checks. The real harness publishes its pid file from the running daemon, so its argv
+    # is always visible by then; establish only that precondition, never retry the verdict under test.
+    import psutil
+
     runtime = tmp_path / "runtime"
     runtime.mkdir()
-    yield proc, runtime
-    if proc.poll() is None:
-        proc.kill()
-    proc.wait(timeout=10)
+    try:
+        wait_until(lambda: "browser_harness.daemon" in psutil.Process(proc.pid).cmdline(), timeout=30,
+                   what="the stand-in harness daemon's argv to become visible")
+        yield proc, runtime
+    finally:
+        if proc.poll() is None:
+            proc.kill()
+        proc.wait(timeout=10)
 
 
 @pytest.fixture
