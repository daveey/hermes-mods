From d589f2244cdb1826b78c3a6bcc7b5f67cf2b0db1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 21:54:11 +0000
Subject: [PATCH] test(update): isolate git fixtures from host gateway
 inventory [daveey]

---
 tests/gateway/test_update_streaming.py               | 5 +++++
 tests/hermes_cli/test_source_channel_integration.py  | 5 +++++
 tests/hermes_cli/test_source_release_channels.py     | 5 +++++
 tests/hermes_cli/test_update_channel_release_hold.py | 5 +++++
 tests/hermes_cli/test_update_parked_branch_guard.py  | 5 +++++
 5 files changed, 25 insertions(+)

diff --git a/tests/gateway/test_update_streaming.py b/tests/gateway/test_update_streaming.py
index bd5cece7011..d2f55b957c6 100644
--- a/tests/gateway/test_update_streaming.py
+++ b/tests/gateway/test_update_streaming.py
@@ -365,6 +365,11 @@ class TestCmdUpdateGatewayMode:
         monkeypatch.setattr(main, "_finalize_update_output", lambda state: None)
         monkeypatch.setattr(main, "_run_pre_update_backup", lambda args: None)
         monkeypatch.setattr(main, "_pause_windows_gateways_for_update", lambda: None)
+        # Prompt/Git fixture has no gateway fleet; leave the pause fence real.
+        from hermes_cli import update_cmd_posix_pause as pause
+        monkeypatch.setattr(pause, "_discover_systemd", list)
+        monkeypatch.setattr(pause, "_discover_launchd", list)
+        monkeypatch.setattr(pause, "_discover_bare", lambda pids: ([], []))
         monkeypatch.setattr("hermes_cli.update_inventory.collect_runtime_inventory", lambda: None)
         monkeypatch.setattr(update_cmd, "_prepare_git_command", lambda **_: (False, ["git"], False))
         monkeypatch.setattr(update_cmd, "run_completion", lambda request: {"exit_code": 0, "receipt": None})
diff --git a/tests/hermes_cli/test_source_channel_integration.py b/tests/hermes_cli/test_source_channel_integration.py
index 38bcef8eb90..c61102c67bc 100644
--- a/tests/hermes_cli/test_source_channel_integration.py
+++ b/tests/hermes_cli/test_source_channel_integration.py
@@ -24,6 +24,11 @@ def git(root, *args):
 
 @pytest.fixture
 def source(tmp_path, monkeypatch):
+    # Git/channel fixture: no host gateways belong to this temporary install.
+    from hermes_cli import update_cmd_posix_pause as pause
+    monkeypatch.setattr(pause, "_discover_systemd", list)
+    monkeypatch.setattr(pause, "_discover_launchd", list)
+    monkeypatch.setattr(pause, "_discover_bare", lambda pids: ([], []))
     home, origin, checkout = (tmp_path / name for name in ("home", "origin", "checkout"))
     home.mkdir()
     origin.mkdir()
diff --git a/tests/hermes_cli/test_source_release_channels.py b/tests/hermes_cli/test_source_release_channels.py
index c76c75a5eb6..60ffb5ee4d9 100644
--- a/tests/hermes_cli/test_source_release_channels.py
+++ b/tests/hermes_cli/test_source_release_channels.py
@@ -25,6 +25,11 @@ def git(root, *args):
 
 @pytest.fixture(params=["utf-8", "utf-8-sig"])
 def releases(tmp_path, monkeypatch, request):
+    # Git/channel fixture: no host gateways belong to this temporary install.
+    from hermes_cli import update_cmd_posix_pause as pause
+    monkeypatch.setattr(pause, "_discover_systemd", list)
+    monkeypatch.setattr(pause, "_discover_launchd", list)
+    monkeypatch.setattr(pause, "_discover_bare", lambda pids: ([], []))
     origin = tmp_path / "origin"
     origin.mkdir()
     git(origin, "init", "-b", "main")
diff --git a/tests/hermes_cli/test_update_channel_release_hold.py b/tests/hermes_cli/test_update_channel_release_hold.py
index 8d17d080f4a..2ab7977a545 100644
--- a/tests/hermes_cli/test_update_channel_release_hold.py
+++ b/tests/hermes_cli/test_update_channel_release_hold.py
@@ -32,6 +32,11 @@ def git(root, *args):
 @pytest.fixture
 def source(tmp_path, monkeypatch):
     """An install on a post-runtime ``main`` commit; the release sits beside it, before the runtime."""
+    # Git/channel fixture: no host gateways belong to this temporary install.
+    from hermes_cli import update_cmd_posix_pause as pause
+    monkeypatch.setattr(pause, "_discover_systemd", list)
+    monkeypatch.setattr(pause, "_discover_launchd", list)
+    monkeypatch.setattr(pause, "_discover_bare", lambda pids: ([], []))
     home, origin, checkout = (tmp_path / name for name in ("home", "origin", "checkout"))
     home.mkdir()
     origin.mkdir()
diff --git a/tests/hermes_cli/test_update_parked_branch_guard.py b/tests/hermes_cli/test_update_parked_branch_guard.py
index 309eaa432fe..c225571664b 100644
--- a/tests/hermes_cli/test_update_parked_branch_guard.py
+++ b/tests/hermes_cli/test_update_parked_branch_guard.py
@@ -363,6 +363,11 @@ def _patch_update_flow(monkeypatch, repo, run_real_git=True):
     monkeypatch.setattr(main_web_build, "_record_bytecode_fingerprint", lambda *a, **k: None)
     monkeypatch.setattr(hermes_main, "_run_pre_update_backup", lambda *a, **k: None)
     monkeypatch.setattr(hermes_main, "_pause_windows_gateways_for_update", lambda: None)
+    # Keep real Git behavior without discovering the runner's host services.
+    from hermes_cli import update_cmd_posix_pause as pause
+    monkeypatch.setattr(pause, "_discover_systemd", list)
+    monkeypatch.setattr(pause, "_discover_launchd", list)
+    monkeypatch.setattr(pause, "_discover_bare", lambda pids: ([], []))
     monkeypatch.setattr(
         hermes_main, "_resume_windows_gateways_after_update", lambda *a, **k: None
     )
-- 
