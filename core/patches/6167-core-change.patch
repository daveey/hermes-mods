diff --git a/tests/e2e/core/dashboard/_issue_helpers.py b/tests/e2e/core/dashboard/_issue_helpers.py
index 1f550efff94..a146b186428 100644
--- a/tests/e2e/core/dashboard/_issue_helpers.py
+++ b/tests/e2e/core/dashboard/_issue_helpers.py
@@ -32,6 +32,7 @@
 
 import httpx
 
+from tests.e2e.core._service_readiness import service_response
 from tests.e2e.core.dashboard._helpers import (
     _READY_RE, _TOKEN_RE, Dashboard, Sandbox, group_members, kill_group, poll,
 )
@@ -94,7 +95,7 @@
             assert self.port > 0, f"hermes dashboard exited rc={self.proc.returncode}:\n{self.log_tail()}"
             self.base = f"http://127.0.0.1:{self.port}"
             self.http = httpx.Client(base_url=self.base, timeout=30.0, trust_env=False)
-            index = self.http.get("/")
+            index = service_response(self.http, "/")
             m = _TOKEN_RE.search(index.text)
             assert index.status_code == 200 and m, f"index.html carried no session token: {index.status_code}"
             self.token = m.group(1)
diff --git a/tests/e2e/core/dashboard/test_pty_service_readiness.py b/tests/e2e/core/dashboard/test_pty_service_readiness.py
new file mode 100644
index 00000000000..80a465b6ea1
--- /dev/null
+++ b/tests/e2e/core/dashboard/test_pty_service_readiness.py
@@ -0,0 +1,42 @@
+"""The interactive dashboard harness waits for service warmup too."""
+from __future__ import annotations
+
+import io
+from types import SimpleNamespace
+
+import httpx
+import pytest
+
+from tests.e2e.core.dashboard import _issue_helpers
+
+
+@pytest.mark.parametrize("status", [200, 401, 503])
+def test_pty_boot_retries_only_service_warmup(monkeypatch, tmp_path, status):
+    calls = []
+
+    def handle(request):
+        calls.append(request)
+        if len(calls) == 1:
+            return httpx.Response(503, json={"detail": "Backend services warming"})
+        return httpx.Response(status, text='__HERMES_SESSION_TOKEN__ = "fixture-token"')
+
+    client_type = httpx.Client
+    monkeypatch.setattr(_issue_helpers.httpx, "Client", lambda **kwargs: client_type(
+        **kwargs, transport=httpx.MockTransport(handle)))
+    proc = SimpleNamespace(stdout=io.StringIO("HERMES_DASHBOARD_READY port=12345\n"),
+                           poll=lambda: None, returncode=None)
+    monkeypatch.setattr(_issue_helpers.subprocess, "Popen", lambda *args, **kwargs: proc)
+    monkeypatch.setattr(_issue_helpers.PtyDashboard, "close", lambda self: None)
+    sb = SimpleNamespace(root=tmp_path, home=tmp_path, env=lambda extra: extra)
+    server = _issue_helpers.PtyDashboard.__new__(_issue_helpers.PtyDashboard)
+    try:
+        if status == 200:
+            server.__init__(sb, tmp_path / "boot.log", tty=False)
+            assert server.token == "fixture-token"
+        else:
+            with pytest.raises(AssertionError, match=f"no session token: {status}"):
+                server.__init__(sb, tmp_path / "boot.log", tty=False)
+        assert len(calls) == 2
+    finally:
+        server.http.close()
+        server._log.close()
