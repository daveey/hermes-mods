From ba39442dc0ce4c38bed176bbb8da076636251ce0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 11:19:08 +0000
Subject: [PATCH] test(desktop): send-then-close guard case reads storage
 through Storage.key, like outboxKeys [daveey]

The storage-unchanged check spread window.localStorage; the file already notes that enumeration
is not reliable in this environment, so read every key via Storage.key(i). Verified non-vacuous:
with the lateSnapshot guard removed the stale snapshot writes a pendingSubmissions.v2 entry and
the equality fails.
---
 .../hooks/use-composer-submit.send-then-close.test.tsx   | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/app/chat/composer/hooks/use-composer-submit.send-then-close.test.tsx b/apps/desktop/src/app/chat/composer/hooks/use-composer-submit.send-then-close.test.tsx
index cadfeca196c..74ffdcab69a 100644
--- a/apps/desktop/src/app/chat/composer/hooks/use-composer-submit.send-then-close.test.tsx
+++ b/apps/desktop/src/app/chat/composer/hooks/use-composer-submit.send-then-close.test.tsx
@@ -241,7 +241,14 @@ scenario('a body resumed after its case timed out never touches the next case',
   await expect(stale(() => openPage(async () => true))).rejects.toThrow('this case already ended')
   await expect(stale(() => saveDraft('stale words'))).rejects.toThrow('this case already ended')
   await expect(stale(() => closeWindow())).rejects.toThrow('this case already ended')
-  const storage = () => JSON.stringify({ ...window.localStorage })
+
+  const storage = () =>
+    JSON.stringify(
+      Array.from({ length: window.localStorage.length }, (_, index) => window.localStorage.key(index) ?? '').map(
+        key => [key, window.localStorage.getItem(key)]
+      )
+    )
+
   const storageBefore = storage()
   await expect(
     stale(() => lateSnapshot([{ admission_id: 'adm-1', input_id: 'stale', status: 'queued', text: 'stale words' }]))
-- 
