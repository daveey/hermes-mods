From 6b6f9d504ae7bb0b09bfde601ce159b9fdebdcae Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 03:17:02 +0000
Subject: [PATCH] kanban origin creation: ignore default
 chat_origin/placement_policy in the stored intent envelope so pre-upgrade
 intents still match on retry [daveey] (#602)

---
 hermes_cli/kanban_origin_creation.py          |  6 +++++
 .../hermes_cli/test_kanban_origin_creation.py | 27 +++++++++++++++++++
 2 files changed, 33 insertions(+)

diff --git a/hermes_cli/kanban_origin_creation.py b/hermes_cli/kanban_origin_creation.py
index 0ffff49b927..7cf90342dd4 100644
--- a/hermes_cli/kanban_origin_creation.py
+++ b/hermes_cli/kanban_origin_creation.py
@@ -60,6 +60,12 @@ def create_with_origin(conn, intent: dict, options: dict) -> str:
     # The sender gated its own declaration; kept out of the stored envelope so an intent recorded
     # before the option existed still matches on retry. [daveey]
     options.pop("require_declaration", None)
+    # Options added after intents were first stored: omit them while at their default (None) so an
+    # intent stored before the option existed still matches on retry; a real value stays in the
+    # envelope and a differing one remains a conflict.
+    for _late in ("chat_origin", "placement_policy"):
+        if options.get(_late) is None:
+            options.pop(_late, None)
     options["parents"] = list(options["parents"])
     if options["skills"] is not None:
         options["skills"] = list(options["skills"])
diff --git a/tests/hermes_cli/test_kanban_origin_creation.py b/tests/hermes_cli/test_kanban_origin_creation.py
index 005e5285e1b..99b840cd591 100644
--- a/tests/hermes_cli/test_kanban_origin_creation.py
+++ b/tests/hermes_cli/test_kanban_origin_creation.py
@@ -115,3 +115,30 @@ def test_failed_intent_insert_rolls_back_task_and_events(board):
         assert conn.execute("SELECT COUNT(*) FROM task_events").fetchone()[0] == 0
         tid = kb.create_task(conn, title="Build", origin_intent=intent())
         assert kb.get_task(conn, tid).title == "Build"
+
+
+def _strip_late_options(conn):
+    row = conn.execute("SELECT request_id,intent_json FROM origin_creation_intents").fetchone()
+    env = json.loads(row["intent_json"])
+    for k in ("chat_origin", "placement_policy"):
+        env["options"].pop(k, None)
+    conn.execute("UPDATE origin_creation_intents SET intent_json=? WHERE request_id=?",
+                 (json.dumps(env, sort_keys=True, separators=(",", ":")), row["request_id"]))
+    conn.commit()
+
+
+def test_retry_ignores_default_options_added_after_intent_was_stored(board):
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="Build", origin_intent=intent())
+        _strip_late_options(conn)
+        assert kb.create_task(conn, title="Build", origin_intent=intent()) == tid
+        assert conn.execute("SELECT COUNT(*) FROM tasks").fetchone()[0] == 1
+
+
+def test_retry_with_non_default_late_option_still_conflicts(board):
+    with kbc.connect_closing() as conn:
+        kb.create_task(conn, title="Build", origin_intent=intent())
+        _strip_late_options(conn)
+        with pytest.raises(OriginError) as err:
+            kb.create_task(conn, title="Build", origin_intent=intent(), chat_origin="gw/prof/sess")
+        assert err.value.code == "origin_creation_conflict"
-- 
