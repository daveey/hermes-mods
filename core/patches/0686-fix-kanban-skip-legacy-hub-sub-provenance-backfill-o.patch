From cb3080476313e622058e3c588d873bd797ddb9cf Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 08:41:36 +0000
Subject: [PATCH] fix(kanban): skip legacy hub-sub provenance backfill on
 boards whose tasks table lacks created_at [daveey]

The board-open backfill joined tasks.created_at, which a legacy/minimal tasks
table (test_kanban_lockguard's scratch board) does not have, so connect() raised
OperationalError. Rows stay unstamped there and use the inherit-time fallback.
---
 hermes_cli/kanban_db_connect.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_db_connect.py b/hermes_cli/kanban_db_connect.py
index 991bfef9e3..be93f27b96 100644
--- a/hermes_cli/kanban_db_connect.py
+++ b/hermes_cli/kanban_db_connect.py
@@ -1018,8 +1018,10 @@ def _migrate_add_optional_columns(conn: sqlite3.Connection) -> None:
     ):
         conn.execute("UPDATE task_events SET kind = ? WHERE kind = ?", (new, old))
 
-    if _table_exists(conn, "kanban_notify_subs") and "delivery_metadata" in _column_names(conn, "kanban_notify_subs"):
-        # Unstamped legacy 'hub' subs get origin/shepherd provenance so inheritance can tell them apart. [daveey]
+    if (_table_exists(conn, "kanban_notify_subs") and "delivery_metadata" in _column_names(conn, "kanban_notify_subs")
+            and "created_at" in _column_names(conn, "tasks")):
+        # Unstamped legacy 'hub' subs get origin/shepherd provenance so inheritance can tell them apart. A legacy
+        # tasks table without created_at can't date its rows: leave them unstamped (inherit-time fallback). [daveey]
         from hermes_cli.kanban_db_notify import stamp_legacy_hub_sub_provenance
         try:
             stamp_legacy_hub_sub_provenance(conn)
-- 
