From dfafe9cb8c53fbeee48da94d70d72b81ef839144 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 07:46:52 +0000
Subject: [PATCH] fix(kanban): keep host skills, local worktrees and hermes-hub
 runs on their host [daveey]

Review of d2f8d4fd (PR773) named wrong-host risks in the loosened portability boundary. Traced on hermes-hub:

- ~/.hermes/skills is host state, not a checkout (no .git; .curator_ledger.jsonl, .usage.json, .locks;
  loaded skills come from ~/.hermes/repos/hermes-state). d2f8d4fd excluded it, so "patch
  ~/.hermes/skills/..." enrolled worker-first and would edit the worker's copy. Real: removed from the exclusion.
- ~/code/_wt-remote (5 hub worktrees) matched only by accident of a boundary-less `_wt` (which also hit
  `_wtf`); `<repo>/.claude/worktrees` and `~/.hermes/hermes-agent/.worktrees` were not markers after `~/code/`
  was dropped. Real (unpushed work a worker cannot see): explicit HOST_WORKTREE_PATH/LOCAL_WORKTREE_PATH.
- `hermes-hub <subcommand>` runs with this host's ~/.config/hermes-mail/gateway.key, state dir and
  ~/.hermes replica (hermes_hub.py read_key/state_dir/hermes_home); on a worker it would act as the worker or
  fail. Real: HUB_CLI_COMMAND marks the CLI's actual subcommands; prose such as "hermes-hub client" stays
  portable. Whether worker-1 holds a gateway key is unverified (not reachable from the hub); the marker does not
  depend on it.
- Not changed (verified not a regression or no live effect): ~/.hermes/hermes-agent read/branch work stays
  portable (7-day sample: references are source reads or "work only in your own worktree"; live-tree ops are
  caught by hermes-sync/gateway-restart markers or `requires: [host_repo]`); a broad unpushed/uncommitted word
  marker was rejected (57 of 2704 cards, mostly "never git stash" guidance); raw-body scans in _heavy_marker and
  routed _local_marker (no live effect: all placed notes are "Placed on hub by macbook").

Five whys (recurrence of 09332d23, PR428, 10-31):
Why 1: d2f8d4fd dropped `~/code/` and `/home/x/code/` to unblock worker-first enrollment.
Why 2: those markers were added by 09332d23 to keep host-bound heavy work (incl. ~/code/_wt) on the hub; its
  tests asserted only the stays-local direction, so they also blocked all ordinary repo work (the 11-03 queue).
Why 3: the reverse fix in d2f8d4fd asserted only the enrolls direction for the paths it freed, so the host
  state hidden behind the broad marker (skills, .claude/worktrees, _wt-remote, hermes-agent/.worktrees,
  hermes-hub identity) lost its guard without a failing test.
Root (process): each side of the portability boundary was changed with tests for one direction only.
Fix: test_host_specific_state_and_identity_stay_local pins each concrete host thing next to the
  enrolls-worker-first cases, so the next loosening or tightening must fail one of them.

Replay, hub kanban.db, cards created in the last 48 h: portable 215 -> 214 of 833; the one flip asks to
"ask via hermes-hub request/comment" (a host-identity action). No card becomes newly portable.

Tests: RED at d2f8d4fd 9 failed (8 new stays-local cases + `_wtf`), GREEN: placement suites 335 passed,
test_kanban_placement_cancel.py 19 passed (run alone; its `mac` fixture errors only when collected with others).
---
 hermes_cli/kanban_placement.py                | 18 ++++++++++-----
 .../test_kanban_worker_placement.py           | 22 ++++++++++++++++++-
 2 files changed, 34 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 35eb3d4db4c..7c41e2bd165 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -349,12 +349,20 @@ def _heavy_marker(title: str, body: str, cfg: _Cfg) -> Optional[str]:
 # ``~/.hermes/hermes-agent``), so ordinary repo work is portable. Before 11-03 ``~/code/``, a bare ``~/.hermes``
 # and the Board CLI name ``hermes-hub`` kept ~3 of every 4 ready hub cards off the worker pool, so the hub's
 # local execution cap throttled the whole queue. What stays local: an existing worktree on this host
-# (``~/code/_wt/<slug>`` holds unpushed work), Hermes state under ``~/.hermes`` other than the code checkout and
-# skills, and a card that declares ``requires: [host_repo]`` or a ``dir``/``worktree`` workspace.
-HERMES_STATE_PATH = r"(?:~|/home/[^/\s]+)/\.hermes/(?!(?:hermes-agent|skills|repos|bin)(?:/|\b))[\w.-]"
-HOST_WORKTREE_PATH = r"(?:~|/home/[^/\s]+)/code/_wt"
+# (``~/code/_wt/<slug>``, ``~/code/_wt-remote/<slug>``, ``<repo>/.claude/worktrees/<x>``,
+# ``~/.hermes/hermes-agent/.worktrees/<x>`` hold unpushed work), Hermes state under ``~/.hermes`` other than the
+# code checkout (``~/.hermes/skills`` is host state: curator ledger, usage counts, live-patched skills), a
+# ``hermes-hub <subcommand>`` run (it acts with this gateway's key and replica), and a card that declares
+# ``requires: [host_repo]`` or a ``dir``/``worktree`` workspace.
+HERMES_STATE_PATH = r"(?:~|/home/[^/\s]+)/\.hermes/(?!(?:hermes-agent|repos|bin)(?:/|\b))[\w.-]"
+HOST_WORKTREE_PATH = r"(?:~|/home/[^/\s]+)/code/_wt(?:-[\w-]+)?(?:/|\b)"
+LOCAL_WORKTREE_PATH = r"/\.claude/worktrees\b|(?:~|/home/[^/\s]+)/\.hermes/hermes-agent/\.worktrees\b"
+HUB_CLI_COMMAND = (r"\bhermes-hub\s+(?:sync|status|sessions|inbox|tasks|where|links|requests?|inspect-legacy|"
+                   r"reconcile-legacy|inspect-alias|retire-alias|adopt-task|create-task|depend|outcomes|"
+                   r"install-watch|watch|diff-shared)\b")
 HOME_GATEWAY_MARKERS = (
-    HERMES_STATE_PATH, HOST_WORKTREE_PATH, r"\bkanban\.db\b", r"\bcron ?(job|jobs|tab)?\b",
+    HERMES_STATE_PATH, HOST_WORKTREE_PATH, LOCAL_WORKTREE_PATH, HUB_CLI_COMMAND,
+    r"\bkanban\.db\b", r"\bcron ?(job|jobs|tab)?\b",
     r"\btoken-broker\b", r"\bhermes-sync\b", r"\bon the hub\b", r"\bthe hub's\b",
     r"\bgateway (restart|config|service)\b", r"\bsystemctl\b", r"\blaunchd\b", r"\bssh\b",
     r"\brestart(ing)? (the )?gateway\b", r"\bhermes config (set|edit|unset)\b",
diff --git a/tests/hermes_cli/test_kanban_worker_placement.py b/tests/hermes_cli/test_kanban_worker_placement.py
index e1430ad578e..b430c99a74e 100644
--- a/tests/hermes_cli/test_kanban_worker_placement.py
+++ b/tests/hermes_cli/test_kanban_worker_placement.py
@@ -87,8 +87,9 @@ def test_courier_and_host_work_bypass_worker_policy():
     "Fix flaky test in ~/code/hermes/tests/test_x.py",
     "Patch /home/ubuntu/code/fabric-play and open a PR",
     "Branch off ~/.hermes/hermes-agent: git -C ~/.hermes/hermes-agent log origin/main",
-    "Update the skill at ~/.hermes/skills/devops/foo/SKILL.md in hermes-mods",
+    "Update skills/devops/foo/SKILL.md in ~/code/hermes-mods and push",
     "hermes-hub client: retry a 409 from the Board",
+    "Fix a typo in ~/code/_wtf/notes.md",
     "Read the hermes-agent tree under ~/.hermes for context",
 ])
 def test_ordinary_repo_work_enrolls_worker_first(title):
@@ -109,6 +110,25 @@ def test_hub_state_work_stays_local(title):
     assert "placement_policy" not in result
 
 
+@pytest.mark.parametrize("title", [
+    # ~/.hermes/skills is host state, not a checkout: curator ledger, usage counts, locks, live-patched skills.
+    "Patch ~/.hermes/skills/devops/kanban-orchestrator/SKILL.md (live edit)",
+    "Sum use_count from /home/ubuntu/.hermes/skills/.usage.json",
+    # Existing worktrees on this host hold unpushed work a worker cannot see.
+    "Continue in ~/code/_wt-remote/fix-x and push",
+    "Finish the agent tree at ~/code/hermes-mods/.claude/worktrees/agent-a1 and open a PR",
+    "Rebase /home/ubuntu/.hermes/hermes-agent/.worktrees/fix-y onto main",
+    # hermes-hub commands act with this gateway's key and replica; a worker has neither.
+    "Run hermes-hub create-task hub --title x", "hermes-hub adopt-task t_1 --session s", "Run `hermes-hub sync`",
+    "Check hermes-hub requests for the stuck ask",
+])
+def test_host_specific_state_and_identity_stay_local(title):
+    assert placement.portable_reason({"title": title, "requires": ["terminal", "file", "git"]}, {}) is not None
+    result = placement.decide({"title": title, "requires": ["terminal", "file", "git"]},
+                              cfg={"worker_pools": {"hub": ["worker-1"]}}, self_gw="hub")
+    assert "placement_policy" not in result
+
+
 
