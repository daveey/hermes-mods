 .../test_kanban_class_wall_admission.py       | 25 +++++++++++++++++++
 .../hermes_cli/test_kanban_pacing_recovery.py |  4 ++-
 tests/hermes_cli/test_kanban_pin_reroute.py   | 10 +++++---
 .../test_kanban_review_paced_reroute.py       |  4 +--
 5 files changed, 37 insertions(+), 8 deletions(-)

