 TERMINAL_KINDS = (*TERMINAL_KINDS, "failure_finalized")
 
 
@@ -332,6 +333,7 @@ class _Collector:
         )
         if not events:
             return None
+        events = coalesce_superseded_blocks(events)  # cursor range stays whole; only the render is coalesced
