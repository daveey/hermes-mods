     "request_withdrawn": _fmt_request_withdrawn,
+    "resolved_check_broken": _fmt_resolved_check_drop,
+    "resolved_check_lost": _fmt_resolved_check_drop,
     "completed": _fmt_completed,
     "blocked": _fmt_blocked,
     "failure_finalized": _fmt_failure("failure_finalized"),
diff --git a/hermes_cli/kanban_ask_resolved.py b/hermes_cli/kanban_ask_resolved.py
index 60658fccb0..63011836f2 100644
--- a/hermes_cli/kanban_ask_resolved.py
+++ b/hermes_cli/kanban_ask_resolved.py
@@ -24,8 +24,9 @@ pair button, flipped the Settings toggle), so the card does not sit blocked unti
   needs its own card id is filed with ``kanban block`` after the create. An idempotent create that returns an
   existing card runs no probe.
 * One exit 0 appends an ``ask_resolved`` event, comments, and unblocks through the normal unblock path
-  (``ready``, or ``todo`` behind an open parent). ``BROKEN_AFTER`` failures in a row comment once, drop the probe
-  and leave the card blocked: a broken probe never answers for David and is never restored.
+  (``ready``, or ``todo`` behind an open parent). ``BROKEN_AFTER`` consecutive failures spanning at least
+  ``BROKEN_MIN_SECONDS`` drop the probe, mark the ask and notify its origins once. Exit 1 resets the streak.
+  The card stays blocked: a broken probe never answers for David and is never restored until re-filed.
 """
 from __future__ import annotations
 
@@ -47,6 +48,7 @@ RESTORED_EVENT = "resolved_check_restored"
 LOST_EVENT = "resolved_check_lost"
 ALIVE_EVENT = "resolved_check_alive"
 SILENT_EVENT = "resolved_check_host_silent"
+BROKEN_MIN_SECONDS = 6 * 60 * 60
 
 
 def _request(value: Any) -> Optional[dict]:
@@ -231,6 +233,10 @@ def filing_fields(conn: sqlite3.Connection, human_request: Any) -> dict:
 
 def store_request(conn: sqlite3.Connection, task_id: str, human_request: Optional[dict]) -> None:
     """Write the card's human_request and (re)register its resolved_check probe. Caller holds the write txn."""
+    if human_request:
+        human_request = dict(human_request)
+        human_request.pop("resolved_check_dropped_at", None)
+        human_request.pop("resolved_check_drop_reason", None)
     conn.execute("UPDATE tasks SET human_request = ? WHERE id = ?",
                  (json.dumps(human_request) if human_request else None, task_id))
     sync_row(conn, task_id)
@@ -263,6 +269,14 @@ def satisfied_note(cmd: str, tail: str) -> str:
             "Verify the state and continue; don't redo the asked action.")
 
 
+def mark_dropped(conn: sqlite3.Connection, task_id: str, kind: str, now: int) -> None:
+    """Persist probe custody loss alongside its event; keep the filed action intact."""
+    row = conn.execute("SELECT human_request FROM tasks WHERE id = ?", (task_id,)).fetchone()
+    request = _request(row[0]) or {}
+    request.update(resolved_check_dropped_at=now, resolved_check_drop_reason=kind)
+    conn.execute("UPDATE tasks SET human_request = ? WHERE id = ?", (json.dumps(request), task_id))
+
+
 def broken_note(cmd: str, rc: Any, fails: int, tail: str) -> str:
     return (f"This ask's resolved_check `{cmd}` failed {fails} times in a row (last rc {rc}): `{tail}`. It is no "
             "longer probed and the card stays blocked on David's ask; re-file the ask with a fixed resolved_check "
@@ -313,18 +327,22 @@ def apply_result(conn: sqlite3.Connection, task_id: str, cmd: str, rc: Any, out:
             return None
         nxt = now + int(state["every"])
         if rc == 1:
-            conn.execute("UPDATE task_wake_checks SET last_at = ?, last_rc = 1, last_out = ?, fails = 0, next_at = ? "
+            conn.execute("UPDATE task_wake_checks SET last_at = ?, last_rc = 1, last_out = ?, fails = 0, first_failure_at = NULL, next_at = ? "
                          "WHERE task_id = ?", (now, tail, nxt, task_id))
             note_alive(conn, task_id, cmd, now)
             return None
         fails = int(state["fails"] or 0) + 1
+        first = conn.execute("SELECT first_failure_at FROM task_wake_checks WHERE task_id = ?", (task_id,)).fetchone()[0]
+        # Legacy rows have a count but no start time: grant a fresh grace period.
+        first = now if first is None else int(first)
         rc_col = rc if isinstance(rc, int) else -1
-        if fails < kwc.BROKEN_AFTER:
-            conn.execute("UPDATE task_wake_checks SET last_at = ?, last_rc = ?, last_out = ?, fails = ?, next_at = ? "
-                         "WHERE task_id = ?", (now, rc_col, tail, fails, nxt, task_id))
+        if fails < kwc.BROKEN_AFTER or now - first < BROKEN_MIN_SECONDS:
+            conn.execute("UPDATE task_wake_checks SET last_at = ?, last_rc = ?, last_out = ?, fails = ?, next_at = ?, first_failure_at = ? "
+                         "WHERE task_id = ?", (now, rc_col, tail, fails, nxt, first, task_id))
             note_alive(conn, task_id, cmd, now)
             return None
         conn.execute("DELETE FROM task_wake_checks WHERE task_id = ?", (task_id,))
+        mark_dropped(conn, task_id, BROKEN_EVENT, now)
         kb._append_event(conn, task_id, BROKEN_EVENT, {"cmd": cmd, "rc": rc, "fails": fails, "output": tail})
         kb.add_comment(conn, task_id, AUTHOR, broken_note(cmd, rc, fails, tail))
         return BROKEN_EVENT
@@ -446,6 +464,7 @@ def reconcile(conn: sqlite3.Connection, *, now: Optional[int] = None) -> dict:
                                                               **({"probe_host": host} if host else {})})
                 out["restored"].append(tid)
             else:
+                mark_dropped(conn, tid, LOST_EVENT, now)
                 kb._append_event(conn, tid, LOST_EVENT, {"cmd": cmd, "filed_event_id": filed_id})
                 kb.add_comment(conn, tid, AUTHOR, lost_note(cmd))
                 out["lost"].append(tid)
diff --git a/hermes_cli/kanban_block_notice.py b/hermes_cli/kanban_block_notice.py
index 99854e27bc..fb407c1433 100644
--- a/hermes_cli/kanban_block_notice.py
+++ b/hermes_cli/kanban_block_notice.py
@@ -66,7 +66,39 @@ def ask_update_notice(task, task_id: str, board: str, payload, *, chat_id: str |
     return f"ask updated (card still blocked): {text} — open task: {link}"
 
 
-def block_notice(task, task_id: str, board: str, *, gateway: str = "", reason: str = "", actor: str = "") -> str:
+DROP_EVENTS = ("resolved_check_broken", "resolved_check_lost")
+_DROP_CAUSE = {"resolved_check_broken": "its probe kept failing", "resolved_check_lost": "its probe went missing"}
+
+
+def coalesce_superseded_blocks(events):
+    """Drop ``blocked`` events that a later drop event in the same unseen batch supersedes. [daveey]
+
+    The drop notice renders the current card (block text plus the lost-detection warning), so the earlier
+    ``blocked`` of the same batch would print the same marked card twice. Only blocks older than a drop event
+    in this batch go; an ordinary block, or one re-filed after the drop, is kept. Callers keep the full claimed
+    cursor range, so ack/rewind semantics are unchanged.
+    """
+    events = list(events)
+    last_drop = max((int(e.id) for e in events if e.kind in DROP_EVENTS), default=None)
+    if last_drop is None:
+        return events
+    return [e for e in events if not (e.kind == "blocked" and int(e.id) < last_drop)]
+
+
+def drop_warning(request: dict, drop_event: str = "") -> str:
+    """Notice head for an ask whose resolved_check was dropped. [daveey]
+
+    The filed ask text may promise "I'll notice automatically"; that was true when it was filed and is not now,
+    so the caller renders it under a label that makes it historical (persisted text is never edited).
+    """
+    cause = _DROP_CAUSE.get(str(request.get("resolved_check_drop_reason") or drop_event))
+    return ("Automatic detection stopped" + (f" ({cause})" if cause else "") + ": this ask's resolved_check is no "
+            "longer probed, so the card will NOT resume by itself when your step is done. It resumes only if you "
+            "unblock it or the ask is re-filed with a working resolved_check.")
+
+
+def block_notice(task, task_id: str, board: str, *, gateway: str = "", reason: str = "",
+                 actor: str = "", drop_event: str = "") -> str:
     """Use current card evidence, never event prose, to assign a human action.
 
     Links open the existing task flow; this function grants no authority and
@@ -89,6 +121,14 @@ def block_notice(task, task_id: str, board: str, *, gateway: str = "", reason: s
         lines = [f"blocked — actor: {actor or 'user'}", f"Next action for the user: {request['action']}",
                  f"Why only the user: {request['why_human']}", f"Scope: {request['scope']}",
                  f"Open task: {link}"]
+        if request.get("resolved_check_dropped_at"):
+            lines[1:2] = [drop_warning(request, drop_event),
+                          "Your step is still needed. Filed ask, historical wording (any promise below to detect "
+                          "it automatically no longer applies):", lines[1]]
+            lines.insert(1, f"Work: {get('title') or task_id}")
+        elif drop_event in DROP_EVENTS:  # re-filed since the drop: never report "stopped" as the current state
+            lines.insert(1, "Automatic detection had stopped for an earlier version of this ask; it was re-filed "
+                            "since, so this is the current ask.")
         if request["interaction"] == "user_terminal":
             lines.append("Use the owner Desktop session's user-terminal flow; opening this task or unblocking it does not execute a command or grant terminal authority.")
         return "\n".join(lines)
