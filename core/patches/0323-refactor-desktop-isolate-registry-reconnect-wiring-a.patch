diff --git a/apps/desktop/electron/registry-reconnect-wiring.test.ts b/apps/desktop/electron/registry-reconnect-wiring.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a1bfe730d1de4e3fc8980d5c354385ed94966ba7
--- /dev/null
+++ b/apps/desktop/electron/registry-reconnect-wiring.test.ts
@@ -0,0 +1,44 @@
+import { expect, test, vi } from 'vitest'
+
+import { ManagedConnectionUpdateGate } from './managed-ssh-update'
+import { createSshReuseProbe, wireRegistryReconnect } from './registry-reconnect-wiring'
+
+test('wiring gates only new SSH dials with the exact correlation', () => {
+  const gate = new ManagedConnectionUpdateGate()
+  const handle = vi.fn()
+
+  const service = wireRegistryReconnect({
+    ipcMain: { handle }, pool: new Map(), states: new Map(), gate,
+    key: (id, profile) => `${id}:${profile}`,
+    readRegistry: () => ({ connections: [] }),
+    dialClaims: { inFlight: () => false }, poolStopper: { inFlight: () => false },
+    bootstrap: { pending: new Set<string>() }, request: async () => null,
+    keepalives: { stop: vi.fn() }, disposeTerminals: vi.fn(), log: vi.fn(), reopen: async () => {}
+  })
+
+  const owner = '11111111-1111-4111-8111-111111111111'
+  gate.claim('hub', owner)
+  expect(() => service.assertCanDial('ssh', 'hub', '')).toThrow()
+  expect(() => service.assertCanDial('ssh', 'hub', 'other')).toThrow()
+  expect(() => service.assertCanDial('ssh', 'hub', owner)).not.toThrow()
+  expect(() => service.assertCanDial('ssh', 'other', '')).not.toThrow()
+  expect(() => service.assertCanDial('remote', 'hub', '')).not.toThrow()
+  expect(() => service.assertCanDial('local', 'hub', '')).not.toThrow()
+  expect(handle.mock.calls.map(call => call[0])).toEqual([
+    'hermes:connections:reconnect-target', 'hermes:connections:reconnect'
+  ])
+  expect(handle.mock.calls[0][1](null, 'hub', 'default')).toBeNull()
+})
+
+test.each([401, 403, 404])('reuse probe classifies authenticated HTTP %s as stale', async status => {
+  const fetchJson = vi.fn(async () => { throw new Error(`${status}: unavailable`) })
+  await expect(createSshReuseProbe(fetchJson)('http://hub', 'token', 'nonce')).resolves.toBe('authenticated-stale')
+  expect(fetchJson).toHaveBeenCalledWith('http://hub/api/ssh/ownership', 'token')
+})
+
+test('reuse probe preserves transport errors and ownership classification', async () => {
+  const error = new Error('connection reset')
+  await expect(createSshReuseProbe(async () => { throw error })('http://hub', 'token', 'nonce')).rejects.toBe(error)
+  const probe = createSshReuseProbe(async () => ({ ok: true, sshOwnerNonce: 'nonce', protocolVersion: 1 }))
+  await expect(probe('http://hub', 'token', 'nonce')).resolves.toBe('authenticated-ok')
+})
diff --git a/apps/desktop/electron/registry-reconnect-wiring.ts b/apps/desktop/electron/registry-reconnect-wiring.ts
new file mode 100644
index 0000000000000000000000000000000000000000..742acfc41f3911fb1299072837ffa9267008c391
--- /dev/null
+++ b/apps/desktop/electron/registry-reconnect-wiring.ts
@@ -0,0 +1,87 @@
+import type { IpcMain } from 'electron'
+
+import type { ManagedConnectionUpdateGate } from './managed-ssh-update'
+import { createRegistryReconnectService } from './registry-reconnect-service'
+import { proveRegistryOwnerStopped } from './registry-stopped-owner'
+import { classifySshReuseProof, terminateOwnedDashboardForUpdate } from './remote-lifecycle'
+
+interface RegistrySshState extends Omit<Parameters<typeof proveRegistryOwnerStopped>[1], 'profile'> {
+  registryConnectionId: string
+  primaryRegistryScope?: boolean
+  remotePlatform: string
+  remoteProfile?: string
+  ssh: Parameters<typeof proveRegistryOwnerStopped>[0] & { close: () => Promise<void> }
+}
+
+interface WiringDeps<D, E extends { connectionPromise: Promise<D> }> {
+  ipcMain: Pick<IpcMain, 'handle'>
+  pool: Map<string, E>
+  states: Map<string, RegistrySshState>
+  gate: ManagedConnectionUpdateGate
+  key: (id: string, profile: string) => string
+  readRegistry: () => { connections: { id: string; kind: string }[] }
+  dialClaims: { inFlight: (key: string) => unknown }
+  poolStopper: { inFlight: (key: string) => unknown }
+  bootstrap: { pending: { has: (key: string) => boolean } }
+  request: Parameters<typeof createRegistryReconnectService<D, E, RegistrySshState>>[0]['request']
+  keepalives: { stop: (key: string) => void }
+  disposeTerminals: (key: string) => void
+  log: (message: string) => void
+  reopen: (id: string, profile: string, correlation: string) => Promise<unknown>
+}
+
+/** Main-process adapters; ownership and generation checks remain in the service. */
+export function wireRegistryReconnect<D, E extends { connectionPromise: Promise<D> }>(deps: WiringDeps<D, E>) {
+  const service = createRegistryReconnectService({
+    pool: deps.pool,
+    states: deps.states,
+    gate: deps.gate,
+    key: deps.key,
+    isSsh: id => deps.readRegistry().connections.some(source => source.id === id && source.kind === 'ssh'),
+    inFlight: key => Boolean(deps.dialClaims.inFlight(key) || deps.poolStopper.inFlight(key) || deps.bootstrap.pending.has(key)),
+    request: deps.request,
+    proveStopped: state => proveRegistryOwnerStopped(state.ssh, { ...state, profile: state.remoteProfile || '' }),
+    terminate: async state => {
+      const expected = { ...state, profile: state.remoteProfile || '' }
+
+      if (state.remotePlatform !== 'Linux') { throw new Error('Unsupported registry SSH platform') }
+      await terminateOwnedDashboardForUpdate(state.ssh, expected)
+    },
+    close: async (key, state) => {
+      deps.keepalives.stop(key)
+      deps.disposeTerminals(key)
+      // The owned serve is already confirmed stopped. Closing its transport
+      // must never fall back to generic remote disconnect/kill.
+      await state.ssh.close().catch(error => deps.log(`[registry-reconnect] transport close: ${String(error)}`))
+    },
+    onCleanupError: error => deps.log(`[registry-reconnect] cleanup: ${String(error)}`),
+    reopen: deps.reopen
+  })
+
+  deps.ipcMain.handle('hermes:connections:reconnect-target', (_event, id, profile) => service.target(id, profile))
+  deps.ipcMain.handle('hermes:connections:reconnect', (_event, target) => service.run(target))
+
+  return {
+    ...service,
+    assertCanDial: (kind: string, id: string, correlation: string) => {
+      if (kind === 'ssh') { deps.gate.assertCanDial(id, correlation) }
+    }
+  }
+}
+
+/** Authenticated stale owners are replaceable; transport uncertainty is not. */
+export function createSshReuseProbe(fetchJson: (url: string, token: string) => Promise<unknown>) {
+  return async (baseUrl: string, token: string, spawnNonce: string) => {
+    try {
+      const proof = await fetchJson(`${baseUrl}/api/ssh/ownership`, token)
+
+      return classifySshReuseProof(proof, spawnNonce)
+    } catch (error) {
+      if (/^(401|403|404):/.test(String((error as Error)?.message || ''))) {
+        return 'authenticated-stale'
+      }
+
+      throw error
+    }
+  }
+}
diff --git a/website/docs/developer-guide/registry-backend-reconnect.md b/website/docs/developer-guide/registry-backend-reconnect.md
new file mode 100644
index 0000000000000000000000000000000000000000..a1f819c91613ad4e64890d7c3843945e107c4737
--- /dev/null
+++ b/website/docs/developer-guide/registry-backend-reconnect.md
@@ -0,0 +1,89 @@
+---
+title: Registry SSH backend reconnect
+---
+
+# Registry SSH backend reconnect
+
+The Desktop preload exposes an explicit, generation-qualified reconnect for one
+registry-owned SSH backend. This is not the profile-only `recycleBackend` API and
+must not be replaced with a managed update or a generic remote process kill.
+
+## Requirements
+
+The running Desktop bundle must include the registry reconnect implementation
+introduced in fork PR [51](https://github.com/daveey/hermes/pull/51). A checkout on
+disk is not evidence that the running Electron main process includes it. Check
+for both preload methods below; older bundles do not implement this API.
+
+The already-running remote serve must support authenticated SSH ownership
+protocol version 1 and `/api/health/retirement` prepare/commit/cancel with the
+backend-owned admission fence (fork commit
+`98745df3b9cb10468b4e3018184ee3a030bf675d`). Missing capability, unknown idle state,
+and active work fail closed. An old serve cannot gain this capability merely
+because its checkout was updated.
+
+Only Linux remote targets are supported. The resident must be an owned,
+non-primary registry SSH backend with a spawn nonce and no pending bootstrap or
+stop. Windows and Darwin are refused before retirement preparation. Linux owned
+termination uses runtime-independent process identity checks; a deleted managed
+Python runtime is deliberately not a reason to refuse ownership proof.
+
+## Executable Desktop API
+
+Use the owning Desktop renderer, not a shell on the remote gateway:
+
+```javascript
+const connections = window.hermesDesktop?.connections
+if (!connections?.reconnectTarget || !connections?.reconnect) {
+  throw new Error('This running Desktop does not support scoped reconnect')
+}
+const target = await connections.reconnectTarget('hermes-hub', 'default')
+if (!target) throw new Error('No eligible owned registry backend')
+// Retain this exact object for any explicitly authorized recovery retry.
+const result = await connections.reconnect(target)
+if (!result.ok) throw new Error('Reconnect refused; do not use a broader fallback')
+console.log({ previousGeneration: target.generation, generation: result.generation })
+```
+
+`reconnectTarget(connectionId, profile)` returns
+`{ connectionId, profile, generation } | null`. It captures an opaque resident
+generation, not a PID and not a durable configuration version. It is discovery,
+not an idle assertion. `reconnect(target)` returns `{ ok: boolean, generation?:
+string }`, or rejects on transport/lifecycle failures. Success means an owned
+replacement was published; it does not prove an application-specific RPC works.
+
+Do not automatically loop on refusal or obtain a different generation to bypass
+an unresolved attempt. An ambiguous commit retains the exact-resident fence.
+An authorized retry with the same target reconciles it: a live owner must again
+prove ownership and commit retirement, or a read-only Linux process check must
+prove the captured owner has exited. Unknown/live process probes never authorize
+a kill. Replaced identity or generation fails closed. After successful retirement
+but failed replacement bootstrap, the fence is released so ordinary dialing can
+retry startup; that failure is not reported as successful reconnect.
+
+## Safety boundaries and evidence
+
+The connection gate prevents configuration mutation and new bootstrap publication
+during reconnect. Existing unrelated profile residents may continue dispatching.
+The coordinator and pool-stop guard protect the selected resident from concurrent
+teardown and generation replacement. The primary backend, gateway daemon, other
+connections and other profiles are not termination targets.
+
+The remote retirement endpoint checks work and freezes admission atomically using
+the same backend lock that admits a turn. A prepared fence can expire or be
+cancelled; a committed fence remains closed through termination. Reading an idle
+status beforehand or polling a lease table is not an equivalent fence.
+
+Regression coverage is in the Electron `registry-reconnect`,
+`registry-reconnect-service`, `registry-retirement-http`,
+`registry-stopped-owner`, and `registry-reconnect-wiring` suites, plus pool-stop
+and bootstrap suites. `tests/hermes_cli/test_backend_retirement.py` exercises the
+authenticated endpoint and a real threaded race between admission and freezing.
+The stopped-owner suite probes real local live/exited processes with synthetic
+SSH transport. These are automated tests, not live reconnect evidence.
+
+For rollout, record merged commit, released bundle, installed/running bundle,
+remote capability, and live operation separately. The designated live operator
+must perform only the approved target reconnect; a separate verification should
+then check authenticated owner-routed inventory/detail/refresh and latency.
+Never infer installation or live success from unit tests or a merged PR.
-- 
