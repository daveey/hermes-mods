From b3c6726df207ec350c3dcee4b3de5ac08b7e02df Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 17:17:24 +0000
Subject: [PATCH] [daveey] test(desktop): pin an unread muted row's dot to the
 blocked tone; document emerald on bot/profile dots
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Follow-up to review 5878594316 on #1520 (unread dot takes the stored outcome's tone).

1. session-row.test.tsx renders an unread muted chat and asserts its dot paints the
   `blocked` stripe colour, is labelled "Unread — Muted", and is not the done emerald
   (only session-outcome.test.ts pinned muted->blocked before). RED with the dot fed no
   outcome: label "Finished".
2. bot-row.tsx and the profile switcher keep the emerald unread dot, with the reason
   in a comment: the profile square is a rollup of N unread sessions (some only
   persisted markers with no row or outcome; mixed outcomes, a count label, and the
   row dots below carry each outcome), and the canonical Bot Chat is hidden from
   listings while the roster's canonical_session summary carries no outcome.
---
 .../src/app/chat/sidebar/profile-switcher.tsx |  4 ++++
 .../src/app/chat/sidebar/session-row.test.tsx | 23 +++++++++++++++++++
 .../src/plugins/hermes-bots/bot-row.tsx       |  6 ++++-
 3 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/app/chat/sidebar/profile-switcher.tsx b/apps/desktop/src/app/chat/sidebar/profile-switcher.tsx
index 2e8f69dd68..3807eb7f15 100644
--- a/apps/desktop/src/app/chat/sidebar/profile-switcher.tsx
+++ b/apps/desktop/src/app/chat/sidebar/profile-switcher.tsx
@@ -142,6 +142,10 @@ function railCondensed(profileCount: number, restGroups: readonly FleetGroup[]):
 // row. It paints the session status dot's own class for the same state, so a
 // profile's loudest state reads the same as its sessions' dots below. The
 // `profile-status-dot` slot lets tests (and tours) find it.
+// [daveey] Its unread state stays the plain emerald unread class, not an outcome tone (unlike a session row's
+// unread dot): it is a rollup of N unread sessions, some only persisted markers with no loaded row and so no
+// stored outcome, with mixed outcomes no single tone describes. Its label is the unread count, never "Finished",
+// and each session's own row dot below carries that session's outcome tone.
 function ProfileStatusDot({ summary }: { summary: ProfileDotSummary }) {
   return <span aria-hidden="true" className={sessionDotClassName(summary.state)} data-slot="profile-status-dot" />
 }
diff --git a/apps/desktop/src/app/chat/sidebar/session-row.test.tsx b/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
index e19e1603c8..6dbba8e800 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
@@ -10,6 +10,7 @@ import type { SessionInfo } from '@/hermes'
 import { createClientSessionState } from '@/lib/chat-runtime'
 import type * as ChatRuntime from '@/lib/chat-runtime'
 import { SESSION_ROW_AREAS, type SessionRowSlotProps } from '@/lib/session-row-slots'
+import { sessionStatusStripeColor } from '@/lib/session-status-stripe'
 import type * as Time from '@/lib/time'
 import type * as ComposerStatusStore from '@/store/composer-status'
 import { $sidebarRowMeta } from '@/store/layout'
@@ -1175,6 +1176,28 @@ describe('SidebarSessionRow stored outcome', () => {
       expect(dot?.className).not.toContain('ui-success')
     })
 
+    // [daveey] Muted maps to the `blocked` stripe; session-outcome.test.ts pins that mapping, this pins the row
+    // actually paints it: a parked chat that comes back unread must not show the done emerald.
+    it('an unread muted chat paints the blocked stripe tone, never the done emerald', () => {
+      $unreadFinishedSessionIds.set(['s1'])
+
+      const { container } = renderRow(
+        makeSession({
+          message_count: 4,
+          muted: true,
+          outcome: { kind: 'muted' },
+          title: 'Parked'
+        } as Partial<SessionInfo> & { title: string })
+      )
+
+      const dot = dotOf(container)
+      expect(dot?.getAttribute('aria-label')).toBe('Unread — Muted')
+      expect(dot?.className).toContain(sessionStatusStripeColor('blocked'))
+      expect(dot?.className).not.toContain(sessionStatusStripeColor('done'))
+      expect(dot?.className).not.toContain('ui-success')
+      expect(container.querySelector('[data-sidebar-stripe]')?.getAttribute('data-sidebar-stripe')).toBe('blocked')
+    })
+
     it('an unread done chat (or one with no outcome) keeps the emerald unread dot', () => {
       $unreadFinishedSessionIds.set(['s1'])
 
diff --git a/apps/desktop/src/plugins/hermes-bots/bot-row.tsx b/apps/desktop/src/plugins/hermes-bots/bot-row.tsx
index c9110c749b..81f4a3ca62 100644
--- a/apps/desktop/src/plugins/hermes-bots/bot-row.tsx
+++ b/apps/desktop/src/plugins/hermes-bots/bot-row.tsx
@@ -267,7 +267,11 @@ export function BotRow({ bot, onDelete, onEdit, onGroup, onNewSection, showHandl
         <div className="flex items-baseline justify-between gap-2">
           <div className="flex min-w-0 items-center gap-1.5">
             {/* The session row's own lead cell, so a bot's name sits on the
-                same left edge as every session name above it in the rail. */}
+                same left edge as every session name above it in the rail.
+                [daveey] No `session` prop, so an unread dot here stays emerald whatever the chat's stored
+                outcome: the canonical Bot Chat is hidden from session listings and the roster's
+                canonical_session summary carries no outcome. Painting the outcome tone here means adding
+                `outcome` to that summary (gateway/session_group_controls.py) and passing it through. */}
             <SidebarRowLead>
               <SessionStatusDot storedSessionId={canonicalSessionId} />
             </SidebarRowLead>
-- 
