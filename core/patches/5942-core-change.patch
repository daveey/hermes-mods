diff --git a/hermes_cli/fact_annotation_kanban.py b/hermes_cli/fact_annotation_kanban.py
new file mode 100644
index 0000000000..0dc718f2b2
--- /dev/null
+++ b/hermes_cli/fact_annotation_kanban.py
@@ -0,0 +1,133 @@
+"""Detached Kanban inputs for annotation ViewFacts. [daveey]
+
+Run only on an authorized source owner, never a request or pure reducer. Reuse
+canonical transaction readers and raw execution observations; do not adopt host
+copies or re-date the legacy count memo. Independent boards are a source vector,
+not a fictitious cross-database transaction.
+"""
+from contextlib import closing
+import math
+import time
+
+from hermes_cli.fact_capture import CaptureBudgetExceeded
+
+
+def _add(into, values):
+    for sid, count in values.items():
+        into[sid] = into.get(sid, 0) + count
+
+
+def _remote(cards, maps, keys, execution):
+    from hermes_cli import kanban_session_activity as activity
+    active, blocked, _, stale, _, parked, _, stalled = maps
+    for card in cards:
+        bucket = activity._replica_bucket(card)
+        into = active if bucket == 'active' else blocked if bucket == 'blocked' else None
+        if into is None:
+            continue
+        sid = card['session']
+        into[sid] = into.get(sid, 0) + 1
+        is_parked = bucket == 'active' and card.get('status') in (
+            *activity.PARKED_STATUSES, 'todo', *activity.PENDING_RELEASE_STATUSES)
+        if is_parked:
+            parked[sid] = parked.get(sid, 0) + 1
+            if activity._external_activity.replica_bucket(card):
+                keys.setdefault(sid, set()).add((str(card.get('key')), 'external_unknown', False))
+        keys.setdefault(sid, set()).add((str(card.get('key')), str(bucket), is_parked))
+        activity._replica_exec.collect(card, execution)
+        if card.get('status') not in activity.PENDING_RELEASE_STATUSES and (
+                activity._remote_wait(card) or {}).get('wait_state') == 'stalled':
+            stalled[sid] = stalled.get(sid, 0) + 1
+            keys[sid].add((str(card.get('key')), 'stalled', False))
+        if card.get('stale'):
+            stale[sid] = stale.get(sid, 0) + 1
+
+
+def _attention(paths, now, due):
+    from hermes_cli import kanban_session_activity as activity
+    from hermes_cli.kanban_session_activity_attention import _check_passes
+    checks = tuple(activity._done_checks.values())
+    counts, pairs = {}, set()
+    if not checks:
+        return counts
+    # These are operational plugin captures. Do not use False-on-error legacy
+    # verdict caches: a swallowed provider failure cannot certify fresh facts.
+    with _check_passes(checks):
+        for path in paths:
+            for sid, card in activity._read_recent_done(path, now - activity.ATTENTION_WINDOW_S):
+                if any(check(card) for check in checks):
+                    pairs.add((sid, str(card['id'])))
+                completed = card.get('completed_at')
+                if isinstance(completed, (int, float)) and math.isfinite(completed):
+                    due.append(math.nextafter(math.nextafter(completed, math.inf)
+                                              + activity.ATTENTION_WINDOW_S, math.inf))
+    for sid, _ in pairs:
+        counts[sid] = counts.get(sid, 0) + 1
+    return counts
+
+
+def capture(budget, *, now):
+    from hermes_cli import kanban_session_activity as activity
+    from hermes_cli import kanban_external_activity as external_activity
+    from hermes_cli.fact_contract import freeze
+    from hermes_cli.fact_wire import encode
+    started = time.monotonic()
+    paths = tuple(activity._board_db_paths())
+    maps = tuple({} for _ in range(8))
+    active, blocked, unseen, _stale, waiting, parked, held, stalled = maps
+    local_keys, execution, external = {}, {}, {}
+    due = [now + 30]
+    total = 0
+    # _read_board's historical pair sink is process-wide. Use its existing
+    # lifecycle lock, with bounded acquisition, even though our outputs are local.
+    if not activity._pairs_lock.acquire(timeout=budget.max_seconds):
+        raise CaptureBudgetExceeded('kanban capture lock deadline exceeded')
+    try:
+        for path in paths:
+            reads, complete = activity._read_board(path, parked=True, stalled=True)
+            if not complete:
+                raise RuntimeError('incomplete native kanban board capture')
+            total += len(reads['pairs']) + len(reads.get('done_pairs', ()))
+            if total > budget.max_keys or time.monotonic() - started >= budget.max_seconds:
+                raise CaptureBudgetExceeded('kanban capture inventory/time budget exceeded')
+            for into, name in ((active, 'active'), (blocked, 'blocked'), (unseen, 'unseen')):
+                _add(into, reads[name])
+            for sid, tid in reads['pairs']:
+                waiting.setdefault(sid, set()).add(tid)
+                raw = reads.get('execution', {}).get(tid)
+                if raw is not None:
+                    execution.setdefault(sid, {})[f'{activity._board_slug(path)}/{tid}'] = raw
+            for sid, tid in reads.get('done_pairs', ()):
+                execution.setdefault(sid, {})[f'done:{activity._board_slug(path)}/{tid}'] = reads['done_execution'][tid]
+            for into, values in zip((parked, held), reads['parked']):
+                _add(into, values)
+            stalled_pairs = set()
+            _add(stalled, activity._stalled_counts(*reads['stall_rows'], now=now, keys=stalled_pairs))
+            for sid, keys in activity._identity.local_keys(path, {**reads, 'stalled_pairs': stalled_pairs},
+                                                         board=activity._board_slug(path)).items():
+                local_keys.setdefault(sid, set()).update(keys)
+            # A separate canonical external transaction has its own captured
+            # observation dates. Errors propagate instead of empty success.
+            with closing(activity._open_ro(path)) as conn:
+                conn.execute('BEGIN')
+                values = external_activity.read_session_external(conn, activity._parked_pairs(conn), now)
+            for sid, slot in values.items():
+                target = external.setdefault(sid, {'counts': [0, 0, 0], 'cards': []})
+                target['counts'] = [a + b for a, b in zip(target['counts'], slot['counts'])]
+                target['cards'] += slot['cards']
+    finally:
+        activity._pairs_lock.release()
+    remote = activity._remote_cards(None, activity.LISTED_STATUSES, False)
+    if total + len(remote) > budget.max_keys:
+        raise CaptureBudgetExceeded('kanban remote inventory exceeds key budget')
+    remote_keys = {}
+    _remote(remote, maps, remote_keys, execution)
+    parts = (*maps[:4], waiting, parked, held, stalled, activity._identity.merge_keys(remote_keys, local_keys),
+             activity._extra_waiting(), _attention(paths, now, due), execution)
+    _, provider_due = activity._host_copy.waiting_events(now)
+    if provider_due is not None:
+        due.append(provider_due)
+    value = freeze({'parts': parts, 'observed_at': now, 'external': external})
+    if len(encode(value)) > budget.max_bytes or time.monotonic() - started >= budget.max_seconds:
+        raise CaptureBudgetExceeded('kanban capture byte/time budget exceeded')
+    return value, min((d for d in due if d > now), default=now + 30)
diff --git a/hermes_cli/fact_annotation_runtime.py b/hermes_cli/fact_annotation_runtime.py
new file mode 100644
index 0000000000..03e84af962
--- /dev/null
+++ b/hermes_cli/fact_annotation_runtime.py
@@ -0,0 +1,137 @@
+"""Authorized annotation startup composition; no discovery or request I/O. [daveey]
+
+The caller supplies exact profile homes and scoped seed identities. Construction
+owns no release decision. ``start`` certifies captured inputs and seeded output
+health before draining legacy; failed readiness never installs a native lookup.
+"""
+from contextvars import copy_context
+from pathlib import Path
+import time
+
+from hermes_cli import fact_annotation_capture as capture
+from hermes_cli import kanban_annotation_facts as annotations
+from hermes_cli.fact_annotation_membership import AnnotationMembershipSource
+from hermes_cli.fact_annotation_sources import NativeAnnotationOwner, NativeAnnotationSource
+from hermes_cli.fact_annotation_startup import AnnotationRegistry
+from hermes_cli.fact_annotation_views import projections, selector_for
+from hermes_cli.fact_capture import CaptureBudget
+from hermes_cli.fact_contract import FactKey, Scope, SourceId
+from hermes_cli.fact_inprocess import InProcessFacts, IncrementalLifecycle
+from hermes_cli.fact_materializers import view_reducer
+from hermes_cli.fact_reducers import ReducerEngine
+from hermes_cli.fact_store import FactStore, view_key
+
+
+class AnnotationRuntime:
+    """One shared feed and transport, partitioned by exact authorized profile."""
+    def __init__(self, profiles, *, fallback_profile, gateway, stop_legacy, start_legacy,
+                 budget=CaptureBudget(max_seconds=5)):
+        if not profiles or fallback_profile not in profiles:
+            raise ValueError('annotation profile roster is incomplete')
+        self.store = FactStore()
+        self.scopes = {name: Scope('serve.annotations.' + gateway, name) for name in profiles}
+        self.engines = {scope: ReducerEngine(self.store, scope) for scope in self.scopes.values()}
+        self.handles, self.bindings = {}, {}
+        self.owner = self.local = self.registry = None
+        self._stopped = False
+        self._stop, self._start = stop_legacy, start_legacy
+        self.life = IncrementalLifecycle({(scope, 'annotations') for scope in self.scopes.values()})
+        sources = []
+        try:
+            for name, home in profiles.items():
+                scope, home = self.scopes[name], Path(home).absolute()
+                engine = self.engines[scope]
+                engine.register(view_reducer(projections()))
+                sources.extend(self._sources(engine, scope, home, gateway))
+            self.owner = NativeAnnotationOwner(self.engines, [], operational=sources, budget=budget)
+            self.local = InProcessFacts(self.store, set(self.scopes.values()), demand=self.owner.demand)
+            for name, scope in self.scopes.items():
+                handle = self.local.acquire(scope, lifecycle=self.life)
+                self.handles[name] = handle
+                self.bindings[name] = annotations.AnnotationFacts(handle, scope,
+                    stop_legacy=self._pause, start_legacy=self._resume, view_facts=True)
+            self.registry = AnnotationRegistry(self.bindings, fallback_profile)
+        except BaseException:
+            self.close()
+            raise
+
+    def _pause(self):
+        if not self._stopped:
+            self._stopped = True
+            self._stop()
+
+    def _resume(self):
+        if self._stopped:
+            self._start()
+            self._stopped = False
+
+    @staticmethod
+    def _sources(engine, scope, home, gateway):
+        from agent.runtime_scope import bind_profile_scope
+        from hermes_cli.fact_annotation_kanban import capture as kanban
+        with bind_profile_scope(home, hydrate_secrets=False):
+            context = copy_context()
+        state = home / 'state.db'
+        sources = [AnnotationMembershipSource(engine, SourceId(scope, 'annotations.' + family, 'local'), path)
+                   for family, path in (('goal', state), ('cron', home / 'cron/jobs.json'))]
+        readers = {
+            'kanban': lambda budget, wall, ids: kanban(budget, now=wall),
+            'background': lambda budget, wall, ids: capture.processes(home / 'processes.json', budget,
+                profile=scope.profile_id, gateway=gateway, now=wall),
+            'turn': lambda budget, wall, ids: capture.turns(state, budget,
+                profile=scope.profile_id, gateway=gateway, now=wall),
+            'subagent': lambda budget, wall, ids: capture.children(state, budget,
+                profile=scope.profile_id, gateway=gateway, now=wall),
+            'review': lambda budget, wall, ids: capture.reviews(state, budget, ids=ids, now=wall),
+        }
+        paths = (state, home / 'processes.json', home / 'desktop/interrupted_turns.json',
+                 home / 'config.yaml', home / 'kanban')
+        for family, reader in readers.items():
+            def read(budget, wall, ids, reader=reader):
+                return context.run(reader, budget, wall, ids)
+            sources.append(NativeAnnotationSource(engine, SourceId(scope, 'annotations.' + family, 'local'),
+                                                  paths, read))
+        return sources
+
+    def start(self, seeds, *, timeout=15):
+        """Seed canonical selectors, await real source+output readiness, then cut over."""
+        keys = {scope: {FactKey(scope, 'AnnotationInput', family) for family in annotations.FIELDS}
+                for scope in self.scopes.values()}
+        for profile, rows in seeds.items():
+            scope = self.scopes[profile]
+            for row in rows:
+                for family in annotations.FIELDS:
+                    selector = selector_for(scope, row, display=family == 'kanban')
+                    self.owner.demand(scope, 'annotations.' + family, selector)
+                    keys[scope].add(view_key(scope, 'annotations.' + family, selector))
+        deadline = time.monotonic() + timeout
+        with self.store._condition:
+            while True:
+                now = time.time()
+                if all((fact := self.store.snapshot(scope).get(key)) is not None and fact.health == 'fresh'
+                       and (fact.valid_until is None or fact.valid_until > now)
+                       for scope, wanted in keys.items() for key in wanted):
+                    break
+                left = deadline - time.monotonic()
+                if left <= 0:
+                    raise TimeoutError('native annotation sources/seeds not ready; legacy retained')
+                self.store._condition.wait(left)
+        for scope in self.scopes.values():
+            self.life.report_ready('annotations', scope)
+            self.life.transition('annotations', scope, 'facts', 1)
+        self.registry.install()
+        return self
+
+    def close(self):
+        if self.registry is not None:
+            self.registry.close()
+        for name, binding in self.bindings.items():
+            scope = self.scopes[name]
+            self.life.transition('annotations', scope, 'legacy', 2)
+            binding.close()
+        if self.owner is not None:
+            self.owner.close()
+        for handle in self.handles.values():
+            handle.close()
+        if self.local is not None:
+            self.local.close()
