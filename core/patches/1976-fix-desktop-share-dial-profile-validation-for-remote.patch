From 63aaf96bc846dbe6279221ba442accf9ac8a3c6e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 5 Nov 2026 00:26:24 +0000
Subject: [PATCH] fix(desktop): share dial profile validation for remote use
 [daveey]

---
 apps/desktop/electron/remote-warm-set.ts      |  5 ++--
 apps/desktop/electron/remote-warm-use.test.ts | 23 +++++++++++++++++++
 2 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/apps/desktop/electron/remote-warm-set.ts b/apps/desktop/electron/remote-warm-set.ts
index 9eb5c6b99f9..a15a3eda3e1 100644
--- a/apps/desktop/electron/remote-warm-set.ts
+++ b/apps/desktop/electron/remote-warm-set.ts
@@ -5,6 +5,7 @@
 import fs from 'node:fs'
 
 import { backendScopeKey } from './connection-registry'
+import { DESKTOP_PROFILE_NAME_RE } from './desktop-profile'
 import { prewarmTargetKey, prewarmTargets, RecentRemoteProfiles } from './remote-prewarm'
 import { type SshKeepaliveHoldDeps, SshKeepaliveHolds } from './ssh-keepalive-hold'
 
@@ -46,7 +47,7 @@ export function createRemoteWarmSet(deps: RemoteWarmSetDeps) {
     const id = String(connectionId ?? '').trim()
     const name = String(profile ?? '').trim() || 'default'
 
-    if (!id || !USE_PROFILE_NAME_RE.test(name) || !sshConnectionIds().includes(id)) {
+    if (!id || !DESKTOP_PROFILE_NAME_RE.test(name) || !sshConnectionIds().includes(id)) {
       return false
     }
 
@@ -63,8 +64,6 @@ export function createRemoteWarmSet(deps: RemoteWarmSetDeps) {
   return { holds, listTargets, noteDial, noteUse, recent }
 }
 
-const USE_PROFILE_NAME_RE = /^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$/
-
 export type RegistryDialUseOpts = { forceProbe?: boolean; passive?: boolean; use?: boolean }
 
 // Whether an ensureRegistryBackend dial counts as the user using that profile. Only callers acting on a user's
diff --git a/apps/desktop/electron/remote-warm-use.test.ts b/apps/desktop/electron/remote-warm-use.test.ts
index 19093fb3439..75ea83050bb 100644
--- a/apps/desktop/electron/remote-warm-use.test.ts
+++ b/apps/desktop/electron/remote-warm-use.test.ts
@@ -96,6 +96,29 @@ describe('remote warm set: what counts as use', () => {
     expect(setHeld).not.toHaveBeenCalled()
   })
 
+  it.each(['note-use', 'use dial'])('%s accepts only dialable lowercase profile names', entry => {
+    const { set, setHeld, stateBytes } = warmSet({})
+    const touch = vi.spyOn(set.recent, 'touch')
+    const noteUse = vi.spyOn(set.holds, 'noteUse')
+    const before = stateBytes()
+
+    const report = (profile: string) =>
+      entry === 'note-use' ? set.noteUse('hermes-hub', profile) : set.noteDial('hermes-hub', profile, { use: true })
+
+    expect(report('Research')).toBe(false)
+    expect(report('reSearch')).toBe(false)
+    expect(touch).not.toHaveBeenCalled()
+    expect(noteUse).not.toHaveBeenCalled()
+    expect(setHeld).not.toHaveBeenCalled()
+    expect(stateBytes()).toBe(before)
+
+    expect(report('research')).toBe(true)
+    expect(touch).toHaveBeenCalledExactlyOnceWith('hermes-hub', 'research')
+    expect(noteUse).toHaveBeenCalledExactlyOnceWith('conn:hermes-hub::research')
+    expect(setHeld).toHaveBeenCalledWith('conn:hermes-hub::research', true)
+    expect(JSON.parse(stateBytes())['hermes-hub']).toHaveProperty('research')
+  })
+
   it('registryDialCountsAsUse: only an explicit use flag on a non-passive, non-probe dial', () => {
     expect(registryDialCountsAsUse()).toBe(false)
     expect(registryDialCountsAsUse({})).toBe(false)
-- 
