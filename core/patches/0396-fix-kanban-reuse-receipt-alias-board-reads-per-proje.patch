From 8e99e6268fafcdbefa5183846251925b61c9339e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 26 Oct 2026 20:43:31 +0000
Subject: [PATCH] fix(kanban): reuse receipt alias board reads per projection
 [daveey]

---
 hermes_cli/kanban_session_activity.py         | 13 ++++++++--
 .../test_kanban_local_dedup_cost.py           | 25 +++++++++++++++++++
 2 files changed, 36 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_local_dedup_cost.py

diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index 0bf418ea7d..9b298dd2f7 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -429,14 +429,23 @@ def _without_local_open_duplicates(rows: list[dict[str, Any]], *, gateway: str,
         return rows
     boards = {_board_slug(p): p for p in _board_db_paths()}
     represented = set()
+    # Receipt fan-out often repeats the same board/session. Read each alias once
+    # per projection, without extending freshness or sharing across profiles.
+    task_ids: dict[tuple[Path, str], set[str]] = {}
+
+    def contains(path: Path, sid: str, task_id: str) -> bool:
+        key = (path, sid)
+        if key not in task_ids:
+            task_ids[key] = {t['id'] for t in _read_session_tasks(path, [sid], LISTED_STATUSES)}
+        return task_id in task_ids[key]
+
     for row in local:
         path = boards.get(row['board'])
         if path is None:
             continue
         aliases = {row['session'], row['origin_session']}
         # Require coverage of every receipt alias, not just a matching task id.
-        if all(any(t['id'] == row['id'] for t in _read_session_tasks(path, [sid], LISTED_STATUSES))
-               for sid in aliases):
+        if all(contains(path, sid, row['id']) for sid in aliases):
             represented.add((row['key'], row['session'], row['origin_session']))
     return [row for row in rows
             if (row['key'], row['session'], row['origin_session']) not in represented]
diff --git a/tests/hermes_cli/test_kanban_local_dedup_cost.py b/tests/hermes_cli/test_kanban_local_dedup_cost.py
new file mode 100644
index 0000000000..3586c7a6e0
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_local_dedup_cost.py
@@ -0,0 +1,25 @@
+"""Receipt aliases share board reads without sharing evidence across profiles."""
+from hermes_cli import kanban_session_activity as activity
+
+
+def test_repeated_receipts_read_each_board_alias_once(monkeypatch, tmp_path):
+    board = tmp_path / 'kanban.db'
+    calls = []
+    monkeypatch.setattr(activity, '_board_db_paths', lambda: [board])
+
+    def read(path, ids, statuses):
+        calls.append((path, tuple(ids)))
+        return [{'id': 'open'}] if ids == ['tip'] else []
+
+    monkeypatch.setattr(activity, '_read_session_tasks', read)
+    rows = [dict(gateway='gw', profile='default', board='default', id='open',
+                 key='gw/default/default/open', session='tip', origin_session='tip')
+            for _ in range(20)]
+    # An unrepresented receipt alias and a foreign profile must survive.
+    retained = [{**rows[0], 'origin_session': 'old'}, {**rows[0], 'profile': 'other', 'key': 'gw/other/default/open'}]
+    result = activity._without_local_open_duplicates(rows + retained, gateway='gw', profile='default')
+    assert result == retained
+    assert len(calls) == 2
+    # Request-local only: changed board state must be consulted on the next call.
+    monkeypatch.setattr(activity, '_read_session_tasks', lambda *args: [])
+    assert activity._without_local_open_duplicates(rows, gateway='gw', profile='default') == rows
-- 
