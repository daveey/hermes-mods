From 7412d31c7c41e8e7bf033e15198c87a66044cb84 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 13:10:00 +0000
Subject: [PATCH] [daveey] Placement forward: an unclosed evidence marker in
 the card body no longer swallows its own text; the footer names the board of
 the opened DB
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Follow-up of review t_01a1d4edfaee2aab on PR #2210 (both non-blocking nits), card t_01a1d4f597a0fe56.

1. remote_args fences the parents' handoffs in `<!-- placement:evidence -->` ... close. A card body with a
   stray, unclosed open marker paired with the footer's close, so `without_evidence` stripped the card's own
   text from that marker to the footer, home commands (`hermes-hub restart`) included, and a home-bound card
   looked portable. `_own_text` now neutralises every open marker after the body's last close marker (those
   are exactly the unclosed ones under the non-greedy match); complete fences in the body are kept.
2. The footer's board slug and `Forwarder.board` came from `kb.get_current_board()`, which ignores
   `HERMES_KANBAN_DB`, while `connect_closing()` resolves that pin first. `opened_board(conn)` reads the slug
   off the file the connection opened (`board_slug_for_path`); a pinned file outside the board layout falls
   back to the active board. The comment claiming the two resolutions match is replaced.

Proof: tests/hermes_cli/test_kanban_placement_forward_footer.py — 4 new tests fail on main (body text
stripped; footer names `default` with only HERMES_KANBAN_DB pinning `ops`) and pass here; all 11 test files
importing kanban_placement_forward pass (413 tests); scripts/check --base origin/main ok.
---
 hermes_cli/kanban_placement_forward.py        | 34 +++++++++++--
 .../test_kanban_placement_forward_footer.py   | 48 +++++++++++++++++++
 2 files changed, 77 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_placement_forward.py b/hermes_cli/kanban_placement_forward.py
index bea25f9908..d36a52342c 100644
--- a/hermes_cli/kanban_placement_forward.py
+++ b/hermes_cli/kanban_placement_forward.py
@@ -431,10 +431,35 @@ def _quoted(text: str) -> str:
     return text.replace(EVIDENCE_CLOSE, "<!-- /placement-evidence (quoted) -->")
 
 
+def _own_text(body: str) -> str:
+    """The card's own body, safe above the footer's fence: an open marker after its last close marker is
+    unclosed and would pair with the footer's close, so ``without_evidence`` would strip the card's own
+    text (its home commands included) up to the footer. Neutralise those; complete fences stay."""
+    from hermes_cli.kanban_placement import EVIDENCE_CLOSE, EVIDENCE_OPEN
+    cut = body.rfind(EVIDENCE_CLOSE)
+    cut = 0 if cut < 0 else cut + len(EVIDENCE_CLOSE)
+    return body[:cut] + body[cut:].replace(EVIDENCE_OPEN, "<!-- placement-evidence (quoted) -->")
+
+
+def opened_board(conn: sqlite3.Connection) -> str:
+    """Slug of the board file ``conn`` opened. ``connect_closing()`` resolves ``HERMES_KANBAN_DB`` before
+    ``HERMES_KANBAN_BOARD`` but ``get_current_board()`` ignores the DB pin, so read the slug off the file;
+    a pinned file outside the board layout (or no file) falls back to the active board."""
+    from pathlib import Path
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_sync as sync
+    path = sync._db_key(conn)
+    if path:
+        slug = sync.board_slug_for_path(path)
+        if slug != kb.DEFAULT_BOARD or Path(path).resolve() == kb.board_own_db_path(None).resolve():
+            return slug
+    return kb.get_current_board()
+
+
 def remote_args(conn: sqlite3.Connection, task, *, self_gw: str, board: Optional[str] = None) -> dict:
     """The ``kanban_create`` view of the local card sent to the target: its options, and the body with
     the parents' handoffs (the target cannot read this board). ``board`` is the source card's board slug
-    (default: the active board), named in the footer's read target."""
+    (default: the board ``conn`` opened), named in the footer's read target."""
     from hermes_cli import kanban_db as kb
     from hermes_cli.kanban_placement import EVIDENCE_CLOSE, EVIDENCE_OPEN
     parents = kb.parent_ids(conn, task.id)
@@ -444,9 +469,9 @@ def remote_args(conn: sqlite3.Connection, task, *, self_gw: str, board: Optional
         p = kb.get_task(conn, pid)
         handoff = (summaries.get(pid) or (p.result if p else None) or "(no handoff)").strip()
         lines.append(_quoted(f"- {pid} ({p.title if p else '?'}): {handoff[:1500]}"))
-    body = (task.body or "").rstrip()
+    body = _own_text((task.body or "").rstrip())
     if lines:
-        board = board or kb.get_current_board()
+        board = board or opened_board(conn)
         # Spell the tool's read call: "with cross_task @task:..." parses as an unknown explicit invocation in
         # kanban_placement_coordination._actions (ACTION_REASON), which kept such forwarded cards on the
         # target's home instead of the pool (t_01a1d49003c65ca4). A read only needs coordination-read.
@@ -482,8 +507,7 @@ class Forwarder:
         self.sleep = time.sleep
         self.cfg = kp.config()
         self.self_gw = reg.self_gateway() or "local"
-        from hermes_cli import kanban_db as kb
-        self.board = kb.get_current_board()  # main() opened this board's DB through the same resolution
+        self.board = opened_board(conn)  # the board whose DB main() opened, HERMES_KANBAN_DB pin included
         self.hub_cli = reg.hub_cli_path(self.cfg.get("hub_cli"))
         self.live = lambda t: kp.target_live(t, now=self.now(), live_seconds=kp._Cfg(self.cfg).live_seconds())
         self.create = kp.create_remote
diff --git a/tests/hermes_cli/test_kanban_placement_forward_footer.py b/tests/hermes_cli/test_kanban_placement_forward_footer.py
index cbee27b0bc..224e1719f1 100644
--- a/tests/hermes_cli/test_kanban_placement_forward_footer.py
+++ b/tests/hermes_cli/test_kanban_placement_forward_footer.py
@@ -141,3 +141,51 @@ def test_forwarder_passes_its_board(home, monkeypatch):
     monkeypatch.setattr(kb, "get_current_board", lambda: "ops")
     with kbc.connect_closing() as conn:
         assert forward.Forwarder(conn, "t_x", None).board == "ops"
+
+
+# PR #2210 review: a stray unclosed open marker in the card's own body paired with the footer's close, so
+# without_evidence stripped the card's own home command and the card looked portable.
+def test_unclosed_open_marker_in_child_body_does_not_swallow_its_own_text(home, monkeypatch):
+    from hermes_cli.kanban_placement import EVIDENCE_CLOSE, EVIDENCE_OPEN, without_evidence
+    with kbc.connect_closing() as conn:
+        pid = kb.create_task(conn, title="Parent", assignee="default")
+        kb.complete_task(conn, pid, summary="ok", force=True)
+        child = kb.create_task(conn, title="Fix", assignee="default", parents=[pid],
+                               body=f"{EVIDENCE_OPEN} stray marker\nThen run hermes-hub restart.")
+        body = forward.remote_args(conn, kb.get_task(conn, child), self_gw="macbook")["body"]
+    assert "hermes-hub restart" in without_evidence(body)
+    assert body.count(EVIDENCE_OPEN) == 1 and body.count(EVIDENCE_CLOSE) == 1  # only the footer's fence
+    reason, labels, _ = _portable(body, monkeypatch)
+    assert reason == coord.ACTION_REASON
+    assert labels is None
+
+
+def test_complete_fence_in_child_body_is_kept(home):
+    from hermes_cli.kanban_placement import EVIDENCE_CLOSE, EVIDENCE_OPEN, without_evidence
+    own = f"Spec.\n{EVIDENCE_OPEN}\nold handoff: hermes-hub restart\n{EVIDENCE_CLOSE}\nDo {EVIDENCE_OPEN} it."
+    assert forward._own_text(own).startswith(f"Spec.\n{EVIDENCE_OPEN}\nold handoff: hermes-hub restart\n{EVIDENCE_CLOSE}")
+    assert "hermes-hub" not in without_evidence(forward._own_text(own) + f"\n{EVIDENCE_OPEN}\nx\n{EVIDENCE_CLOSE}")
+    assert "Do " in without_evidence(forward._own_text(own) + f"\n{EVIDENCE_OPEN}\nx\n{EVIDENCE_CLOSE}")
+
+
+def test_board_follows_the_kanban_db_pin_alone(home, monkeypatch):
+    """Only HERMES_KANBAN_DB pins the board: the footer and the forwarder name the board of the file opened."""
+    kb.create_board("ops")
+    monkeypatch.delenv("HERMES_KANBAN_BOARD", raising=False)
+    monkeypatch.setenv("HERMES_KANBAN_DB", str(kb.board_own_db_path("ops")))
+    assert kb.get_current_board() == "default"  # the drift this guards against
+    _, body = _forward_with_handoff("ok")
+    assert "@task:ops@macbook/<id>" in body
+    with kbc.connect_closing() as conn:
+        assert forward.Forwarder(conn, "t_x", None).board == "ops"
+
+
+def test_board_pin_outside_the_board_layout_falls_back_to_the_active_board(home, monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_KANBAN_DB", str(tmp_path / "pinned.db"))
+    monkeypatch.setattr(kb, "get_current_board", lambda: "research")
+    with kbc.connect_closing() as conn:
+        assert forward.opened_board(conn) == "research"
+    monkeypatch.delenv("HERMES_KANBAN_DB")
+    monkeypatch.setattr(kb, "get_current_board", lambda: "default")
+    with kbc.connect_closing() as conn:
+        assert forward.opened_board(conn) == "default"
