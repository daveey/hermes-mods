From 98312c5c587b8f0bc72669d29a2398c250fae485 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:55:14 +0000
Subject: [PATCH] [daveey] tests: read the tools pair under the publish lock in
 the refresh thread-safety test

test_refresh_is_thread_safe_under_concurrent_calls flaked on CI
(run 43412829395: {'a','b'} != {'a','c'}). The writer publishes
agent.tools and agent.valid_tool_names together under
_agent_tools_lock, but the test read them as two bare attribute reads,
so another worker could publish the other set between the reads: a
torn read in the test, not a torn write in production.

Observe the pair under _mcp_agent._agent_tools_lock, so the assertion
checks what the lock guarantees. With a 1 ms yield widening that read
window, the old test fails 10/10 and the new one passes 10/10. Dropping
the writer's lock (mutant) still fails the new test 10/10.

Also join with a generous timeout and assert the workers finished,
instead of a 10 s join whose expiry went unchecked.
---
 tests/tools/test_refresh_agent_mcp_tools.py | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/tests/tools/test_refresh_agent_mcp_tools.py b/tests/tools/test_refresh_agent_mcp_tools.py
index 1b586aed0f..e101490789 100644
--- a/tests/tools/test_refresh_agent_mcp_tools.py
+++ b/tests/tools/test_refresh_agent_mcp_tools.py
@@ -182,8 +182,13 @@ def test_refresh_is_thread_safe_under_concurrent_calls(monkeypatch):
                 _mcp_agent.refresh_agent_mcp_tools(agent)
                 # Coherence invariant: the name set must match the tool list
                 # at every observation, never a torn cross-attribute state.
-                names = {t["function"]["name"] for t in agent.tools}
-                assert agent.valid_tool_names == names
+                # Observe the pair under the publish lock, as a reader that
+                # needs both does: two bare reads let another thread publish
+                # the other set in between, a torn READ, not a torn write.
+                with _mcp_agent._agent_tools_lock:
+                    names = {t["function"]["name"] for t in agent.tools}
+                    valid = set(agent.valid_tool_names)
+                assert valid == names
                 assert names in ({"a", "b"}, {"a", "c"})
         except Exception as exc:  # pragma: no cover - failure path
             errors.append(exc)
@@ -192,7 +197,8 @@ def test_refresh_is_thread_safe_under_concurrent_calls(monkeypatch):
     for t in threads:
         t.start()
     for t in threads:
-        t.join(timeout=10)
+        t.join(timeout=120)  # returns as soon as the worker ends; generous for throttled runners
+    assert not any(t.is_alive() for t in threads)
 
     assert not errors
     assert agent.valid_tool_names in ({"a", "b"}, {"a", "c"})
