From 293b041480aa72be24d4a771785eb8694c217603 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 23:16:14 +0000
Subject: [PATCH] test(gateway): await authorization dispatch before asserting
 replies [daveey]

---
 tests/e2e/test_platform_commands.py | 43 +++++++++++++++++++++++++----
 1 file changed, 37 insertions(+), 6 deletions(-)

diff --git a/tests/e2e/test_platform_commands.py b/tests/e2e/test_platform_commands.py
index dc209d113de..ea41e867b89 100644
--- a/tests/e2e/test_platform_commands.py
+++ b/tests/e2e/test_platform_commands.py
@@ -132,6 +132,31 @@ class TestSessionLifecycle:
 
 
 
+@pytest.fixture(params=[0, 0.6], ids=["immediate-pairing", "delayed-pairing"])
+def pairing_worker_schedule(request, runner, monkeypatch):
+    """Exercise a worker reply that outlives the old 300ms assertion sleep."""
+    original_to_thread = asyncio.to_thread
+    pairing_calls = 0
+
+    async def scheduled_to_thread(func, *args, **kwargs):
+        nonlocal pairing_calls
+        if func is runner.pairing_store.generate_code:
+            pairing_calls += 1
+            if request.param:
+                ready = asyncio.Event()
+                timer = asyncio.get_running_loop().call_later(request.param, ready.set)
+                try:
+                    await ready.wait()
+                finally:
+                    timer.cancel()
+        return await original_to_thread(func, *args, **kwargs)
+
+    monkeypatch.setattr(asyncio, "to_thread", scheduled_to_thread)
+    yield
+    assert pairing_calls == 1, "pairing scheduling scenario must exercise the worker seam"
+
+
+@pytest.mark.usefixtures("pairing_worker_schedule")
 class TestAuthorization:
     """Verify the pipeline handles unauthorized users."""
 
@@ -143,7 +168,10 @@ class TestAuthorization:
         event = make_event(platform, "/help")
         adapter.send.reset_mock()
         await adapter.handle_message(event)
-        await asyncio.sleep(0.3)
+        # handle_message only schedules dispatch; pairing awaits a worker thread.
+        # Join that dispatch before checking either positive or negative output.
+        async with asyncio.timeout(10):
+            await asyncio.gather(*adapter._background_tasks)
 
         # The adapter.send is called directly by the authorization path
         # (not via _send_with_retry), so check it was called with a pairing message
@@ -159,12 +187,15 @@ class TestAuthorization:
         event = make_event(platform, "/help")
         adapter.send.reset_mock()
         await adapter.handle_message(event)
-        await asyncio.sleep(0.3)
+        # handle_message only schedules dispatch; pairing awaits a worker thread.
+        # Join that dispatch before checking either positive or negative output.
+        async with asyncio.timeout(10):
+            await asyncio.gather(*adapter._background_tasks)
 
-        # If send was called, it should NOT contain the help text
-        if adapter.send.called:
-            response_text = adapter.send.call_args[0][1] if len(adapter.send.call_args[0]) > 1 else ""
-            assert "/new" not in response_text
+        adapter.send.assert_awaited_once()
+        response_text = adapter.send.call_args[0][1] if len(adapter.send.call_args[0]) > 1 else ""
+        assert "/new" not in response_text
+        runner._handle_message_with_agent.assert_not_awaited()
 
 
 class TestSendFailureResilience:
