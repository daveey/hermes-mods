From e67e636bf26d5a08ea9e214a68befeedfd751cf2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 11:18:16 +0000
Subject: [PATCH] [daveey] Require terminal cancelled-job proof before PR
 supersession

Address review 5991737107: retain cancelled evidence lacking terminal completion at merge. New regression cases reproduce two fail-opens on 07e0d77174 (missing completed_at and in_progress status), then pass with finished(check); post-merge completion remains refused. Existing assertions unchanged. Proof: 571 PR-gate tests passed across 19 files; 175 extra consumer tests passed, 1 skipped across 9 files; scripts/check all 21 checks green. Fresh read-only PR #12 evaluation returns ok=true, classification=success.
---
 hermes_cli/kanban_pr_merge_time.py                   |  2 +-
 .../test_kanban_pr_cancelled_superseded.py           | 12 ++++++++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_pr_merge_time.py b/hermes_cli/kanban_pr_merge_time.py
index e4096206f8..b2d3d4d8d3 100644
--- a/hermes_cli/kanban_pr_merge_time.py
+++ b/hermes_cli/kanban_pr_merge_time.py
@@ -156,7 +156,7 @@ def _drop_cancelled_superseded(kept, every, cutoff, run_of):
                 and ((other := run_of(c)) is None or other["id"] == workflow["id"])]
 
     def superseded(check):
-        if check.get("conclusion") != "cancelled":
+        if check.get("conclusion") != "cancelled" or not finished(check):
             return False
         earlier = run_of(check)
         if earlier is None or len(jobs_in_run(check, earlier)) != 1:
diff --git a/tests/hermes_cli/test_kanban_pr_cancelled_superseded.py b/tests/hermes_cli/test_kanban_pr_cancelled_superseded.py
index 368622ea81..4b88762437 100644
--- a/tests/hermes_cli/test_kanban_pr_cancelled_superseded.py
+++ b/tests/hermes_cli/test_kanban_pr_cancelled_superseded.py
@@ -76,6 +76,18 @@ def test_cancelled_run_superseded_by_later_green_workflow_run(evidence, actions)
     assert ids(receipt) == [2]
 
 
+@pytest.mark.parametrize("tamper", [
+    {"completed_at": None},
+    {"status": "in_progress"},
+    {"completed_at": POST_MERGE},
+])
+def test_cancelled_job_requires_terminal_premerge_completion(evidence, actions, tamper):
+    evidence["runs"][0].update(tamper)
+    receipt = collect()
+    assert receipt["ok"] is False
+    assert 1 in ids(receipt)
+
+
 def test_chain_of_cancelled_runs_each_superseded(evidence, actions):
     actions["workflow_runs"][50] = workflow_run(50, created="2026-11-02T10:00:00Z", conclusion="cancelled")
     evidence["runs"].insert(0, check("cancelled", 3, 6, started="2026-11-02T10:00:30Z",
