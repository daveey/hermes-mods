From 133921ff90ecca6bba469e0eb324db55b32c5830 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 19:00:02 +0000
Subject: [PATCH] ci: catalog-tests keeps the fork's per-run main concurrency
 group [daveey]

Upstream's new catalog-tests.yml (a ci.yaml callee) grouped main pushes by ref, so a main push and
a main dispatch shared the callee group; tests/ci/test_ci_concurrency_groups.py caught it. Same
combined expression as tests.yml/lint.yml.
---
 .github/workflows/catalog-tests.yml | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/catalog-tests.yml b/.github/workflows/catalog-tests.yml
index b1a2bf0c3b1..57623a4c0d9 100644
--- a/.github/workflows/catalog-tests.yml
+++ b/.github/workflows/catalog-tests.yml
@@ -22,7 +22,8 @@ permissions:
   contents: read
 
 concurrency:
-  group: catalog-tests-${{ (github.ref_type == 'tag' || inputs.commit != '') && github.run_id || github.ref }}
+  group: catalog-tests-${{ (github.ref_type == 'tag' || github.ref == 'refs/heads/main' || inputs.commit != '') && github.run_id || github.ref }}
+  # fork: main pushes keep their own run; upstream: a stable dispatch (inputs.commit) never queues behind or cancels a push.
   cancel-in-progress: ${{ github.ref_type != 'tag' && inputs.commit == '' }}
 
 jobs:
-- 
2.55.0

