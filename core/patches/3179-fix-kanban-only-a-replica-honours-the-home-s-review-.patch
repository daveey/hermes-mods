From 0b265d682297dabae58534a5eda769294080f488 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 01:37:02 +0000
Subject: [PATCH] fix(kanban): only a replica honours the home's review-release
 stamp [daveey]

The home holds every piece of dependency-review evidence, so it keeps
deciding with resumes_review; honouring its own stamp let a post-promotion
evidence change (relink, replica_parent, no_verdict suites: 18 cases) skip
the re-hold. Partial-replica unit fixtures now convert the board to a synced
foreign copy after promotion (as_replica); test_home_never_honours_its_own_stamp
pins the gate. No existing assertion changed.

Proof: all 649 tests/hermes_cli/test_kanban*.py files, 10515 passed, 0 failed.
---
 hermes_cli/kanban_review_release.py           |  9 +++-
 .../hermes_cli/test_kanban_review_release.py  | 48 +++++++++++++++++++
 .../test_kanban_review_release_boundaries.py  |  6 ++-
 .../test_kanban_review_release_controls.py    |  4 ++
 4 files changed, 64 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_review_release.py b/hermes_cli/kanban_review_release.py
index fa2ea6b036..351f593cf1 100644
--- a/hermes_cli/kanban_review_release.py
+++ b/hermes_cli/kanban_review_release.py
@@ -97,9 +97,16 @@ def promotion_payload(conn, task_id, status, prepared):
 
 
 def released(conn, task_id, pr_urls):
-    """Use only a still-unconsumed park and unchanged dependency/PR scope."""
+    """Use only a still-unconsumed park and unchanged dependency/PR scope.
+
+    Only a replica (foreign copy) honours the stamp: the home holds every
+    piece of evidence, so it keeps re-evaluating ``resumes_review`` locally and
+    a post-promotion change to that evidence still re-holds the card there.
+    """
     from hermes_cli.kanban_wake_check import foreign_copy
     from hermes_cli.kanban_move_parent_evidence import owner_faulted_since
+    if not foreign_copy(conn, task_id):
+        return False
     try:
         run, checkpoint, parked = _park(conn, task_id)
     except ValueError:
diff --git a/tests/hermes_cli/test_kanban_review_release.py b/tests/hermes_cli/test_kanban_review_release.py
index 1cab32bf12..656976f097 100644
--- a/tests/hermes_cli/test_kanban_review_release.py
+++ b/tests/hermes_cli/test_kanban_review_release.py
@@ -11,6 +11,35 @@ PR = helpers.PR
 OLD = PR + "9"
 
 
+def as_replica(conn, task, home="home"):
+    """View ``conn`` as a worker's synced copy of ``task`` (homed on ``home``) after promotion.
+
+    Only a replica honours the home's stamp; the home itself re-evaluates. The
+    synced schema names the park by its portable UID, so the stamp is restated
+    with the UID the home would have carried (unsynced fixtures lack the column).
+    """
+    import json
+    from hermes_cli import kanban_db_sync as sync
+    conn.executescript(sync.SYNC_SCHEMA_SQL)
+    conn.execute("INSERT INTO kanban_sync_state (board_id, gateway_id, hlc_last, mode) "
+                 "SELECT 'board-test', 'worker', '', 'shadow' WHERE NOT EXISTS (SELECT 1 FROM kanban_sync_state)")
+    for table, column in (("tasks", "created_on"), ("task_runs", "uid")):
+        if column not in {r[1] for r in conn.execute(f"PRAGMA table_info({table})")}:
+            conn.execute(f"ALTER TABLE {table} ADD COLUMN {column} TEXT")
+    conn.execute("UPDATE tasks SET created_on=? WHERE id=?", (home, task))
+    conn.execute("UPDATE task_events SET origin_gateway=? WHERE task_id=? AND kind='promoted'", (home, task))
+    for event in conn.execute("SELECT id, payload FROM task_events WHERE task_id=? AND kind='promoted'",
+                              (task,)).fetchall():
+        payload = json.loads(event["payload"] or "{}")
+        park = (payload.get("review_release") or {}).get("park") if isinstance(payload, dict) else None
+        if isinstance(park, dict) and "run_id" in park:
+            uid = f"park-{park['run_id']}"
+            conn.execute("UPDATE task_runs SET uid=? WHERE id=?", (uid, park["run_id"]))
+            payload["review_release"]["park"] = {"run_uid": uid}
+            conn.execute("UPDATE task_events SET payload=? WHERE id=?", (json.dumps(payload), event["id"]))
+    conn.commit()
+
+
