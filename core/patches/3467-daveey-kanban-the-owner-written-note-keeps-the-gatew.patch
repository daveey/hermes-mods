From 84ee291acdaa4e600c949ea56c5a2d902349f765 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:46:14 +0000
Subject: [PATCH] [daveey] kanban: the owner-written note keeps the gateway id
 verbatim ("Owner gateway worker-4 ...", not "Worker-4")

PR #2079 re-review 5889570113 nit 4: _chat_link_by_owner upper-cased the first letter of a sentence that began
with the gateway id. The sentence now opens with the fixed words "owner gateway", so only they are capitalized.
---
 tests/tools/test_kanban_board_delivery.py | 8 +++++---
 tools/kanban_tools_board_delivery.py      | 3 ++-
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/tests/tools/test_kanban_board_delivery.py b/tests/tools/test_kanban_board_delivery.py
index 55656ee5ad..5484a99925 100644
--- a/tests/tools/test_kanban_board_delivery.py
+++ b/tests/tools/test_kanban_board_delivery.py
@@ -349,9 +349,11 @@ def test_create_placed_elsewhere_while_the_sync_role_is_given_up_says_only_this_
     assert "queued locally" not in json.dumps(out)
     assert SHOWS_PROMISE not in out["note"]
     assert "shows in this chat's tasks once this gateway's copy of the Board refreshes" in out["note"]
-    assert "Worker-4 writes this chat's link to the Board; this gateway's Board sync has been stopped since " in out[
-        "note"]
-    assert out["board_sync"].startswith("worker-4 writes this chat's link to the Board")
+    # [daveey] PR #2079 re-review 5889570113: the gateway id stays verbatim (it read "Worker-4").
+    assert ("Owner gateway worker-4 writes this chat's link to the Board; this gateway's Board sync has been stopped "
+            "since ") in out["note"]
+    assert "Worker-4" not in out["note"]
+    assert out["board_sync"].startswith("owner gateway worker-4 writes this chat's link to the Board")
     assert "gave up the sync role" in out["board_sync"] and "may not refresh until it recovers" in out["board_sync"]
 
 
diff --git a/tools/kanban_tools_board_delivery.py b/tools/kanban_tools_board_delivery.py
index e8fdad99e4..6cf27d2435 100644
--- a/tools/kanban_tools_board_delivery.py
+++ b/tools/kanban_tools_board_delivery.py
@@ -58,13 +58,14 @@ def _chat_link_by_owner(payload: dict) -> None:
     """The placed card and its link to this chat are on the Board; only this gateway's replica lags."""
     from hermes_cli import kanban_sync_runstate as runstate
     record = runstate.down() or {}
-    owner = payload.get("runs_where") or "the card's home gateway"
+    owner = f"owner gateway {payload['runs_where']}" if payload.get("runs_where") else "the card's home gateway"
     text = str(payload.get("note") or "")
     text = text.replace(CHAT_TASKS_SHOWS, CHAT_TASKS_SHOWS + _LATER, 1).replace(
         CHAT_TASKS_HEAD + CHAT_TASKS_SEP, CHAT_TASKS_HEAD + _LATER + CHAT_TASKS_SEP, 1)
     sync_note = (f"{owner} writes this chat's link to the Board; this gateway's Board sync has been stopped since "
                  f"{runstate.when(record.get('since'))} ({record.get('reason') or 'unknown reason'}), so its copy "
                  "of the Board may not refresh until it recovers")
+    # [daveey] Capitalize only the fixed lead word: a gateway id stays verbatim ("worker-4", never "Worker-4").
     payload["note"] = f"{text} {sync_note[0].upper()}{sync_note[1:]}."
     payload["chat_link"] = OWNER_WRITTEN
     payload["board_sync"] = sync_note
-- 
