From 22685c1faa707aafad32437258b2f1e7ada923e2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 12:07:50 +0000
Subject: [PATCH] [daveey] update-pause cancel: the executor's emit_cancelled
 JSON is no own result
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Follow-up to PR #2062 (review 5890290599, card t_01a1d4b4c463cc06).

`with_own_result` keeps a cancelled call's own result below the update-pause
stamp and already skips the executor's bracketed `[Tool execution
cancelled/skipped —` texts. `_ToolCallRef.emit_cancelled` (a KeyboardInterrupt
mid-tool) instead returns `{"error": "Tool execution cancelled. ...",
"status": "cancelled"}` JSON, which was kept below the stamp as if the call had
produced it.

Fix: a JSON object with `status == "cancelled"` whose `error` starts with
"Tool execution cancelled" counts as no own result, so the bare stamp is
committed. A tool's own JSON that merely says cancelled (other error text)
is still kept.

Proof: new test_the_executors_cancelled_json_is_no_own_result (uses the real
emit_cancelled output) fails without the fix and passes with it; all 94 test
files referencing update_pause pass (1248 passed).
---
 agent/update_pause_cancel.py                    | 16 +++++++++++++++-
 tests/tui_gateway/test_update_pause_mid_tool.py | 17 +++++++++++++++++
 2 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/agent/update_pause_cancel.py b/agent/update_pause_cancel.py
index a4b775ddfc..9ced10dee8 100644
--- a/agent/update_pause_cancel.py
+++ b/agent/update_pause_cancel.py
@@ -95,6 +95,7 @@ OWN_RESULT_TAIL = 512
 OWN_RESULT_INTRO = "The call's own result when the update cancelled it:"
 OWN_RESULT_END = "[end of the cancelled call's own result]"
 # The executor's own text for a call the interrupt abandoned or skipped (tool_executor): no result of the call.
+# Its ``emit_cancelled`` JSON for a KeyboardInterrupt mid-tool is the same (``_executor_cancelled_json``).
 _EXECUTOR_CANCEL_PREFIXES = ("[Tool execution cancelled \u2014 ", "[Tool execution skipped \u2014 ")
 
 
@@ -105,7 +106,7 @@ def with_own_result(stamp: str, result: Any) -> str:
     result whose last line is an executor's ``[Command interrupted]`` marker from reading as an interrupted
     result on replay (``replay_cleanup.is_interrupted_tool_result``), which would rewrite it away again."""
     if not isinstance(result, str) or not result.strip() or result == stamp \
-            or result.startswith(_EXECUTOR_CANCEL_PREFIXES):
+            or result.startswith(_EXECUTOR_CANCEL_PREFIXES) or _executor_cancelled_json(result):
         return stamp
     kept = result.strip()
     if len(kept) > OWN_RESULT_HEAD + OWN_RESULT_TAIL:
@@ -114,6 +115,19 @@ def with_own_result(stamp: str, result: Any) -> str:
     return f"{stamp}\n{OWN_RESULT_INTRO}\n{kept}\n{OWN_RESULT_END}"
 
 
+def _executor_cancelled_json(result: str) -> bool:
+    """``result`` is ``_ToolCallRef.emit_cancelled``'s JSON (a KeyboardInterrupt mid-tool): the executor's own
+    text, not the call's result (t_01a1d4b4c463cc06, review 5890290599 on #2062)."""
+    if '"cancelled"' not in result:
+        return False
+    try:
+        parsed = json.loads(result)
+    except ValueError:
+        return False
+    return isinstance(parsed, dict) and parsed.get("status") == "cancelled" \
+        and str(parsed.get("error") or "").startswith("Tool execution cancelled")
+
+
 @contextmanager
 def compression_in_flight(agent: Any) -> Iterator[None]:
     """[daveey] t_01a1d0aa52ee1404: a context compression host wait is in flight like a tool call. The watcher's
diff --git a/tests/tui_gateway/test_update_pause_mid_tool.py b/tests/tui_gateway/test_update_pause_mid_tool.py
index c07376c9c0..b90ff63eae 100644
--- a/tests/tui_gateway/test_update_pause_mid_tool.py
+++ b/tests/tui_gateway/test_update_pause_mid_tool.py
@@ -501,6 +501,23 @@ def test_a_cancelled_calls_resume_handle_survives_the_stamp(tmp_path):
     assert "check its outcome before re-running" in stamp and "re-run if still needed" not in text
 
 
+def test_the_executors_cancelled_json_is_no_own_result(tmp_path):
+    """t_01a1d4b4c463cc06 (review 5890290599 on #2062): ``_ToolCallRef.emit_cancelled``'s JSON is the executor's
+    text for a KeyboardInterrupt mid-tool, not the call's result, so the bare stamp is committed."""
+    from agent.tool_executor import _ToolCallRef
+
+    agent = _make_agent(tmp_path, "long_job")
+    update_pause_cancel.started(agent, "c1")
+    assert update_pause_cancel.cancel(agent, "stamp") == ["c1"]
+    with patch("agent.tool_executor._emit_terminal_post_tool_call"):
+        executor_text = _ToolCallRef("long_job", {}, "t", "c1", []).emit_cancelled(agent, time.time())
+    assert json.loads(executor_text)["status"] == "cancelled"
+    assert update_pause_cancel.committed(agent, "c1", executor_text) == ("stamp", True)
+    # A tool's own JSON that only says cancelled (no executor wording) is still its result.
+    own = json.dumps({"status": "cancelled", "error": "job cancelled by the remote", "job_id": "j-1"})
+    assert update_pause_cancel.with_own_result("stamp", own) != "stamp"
+
+
 def test_a_long_own_result_keeps_its_head_and_tail_within_about_2kb():
     head, middle, tail = '{"job_id": "j-1", "output": "', "x" * 50_000, '", "session_id": "proc_9"}'
     text = update_pause_cancel.with_own_result("stamp", head + middle + tail)
