From 6418853e34840b940cb2e736568875cc540d7322 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 05:44:40 +0000
Subject: [PATCH] [daveey] Resolve notify-subscribe caller to a stored chat
 before warning

Prefer a stored HERMES_SESSION_ID, then a stored session key, then its validated final segment. Only compare real chat lineages; never recommend an unchecked routing key or an unstored session id. Correct the docstring that conflated subprocess identity with poller routing.

Proof: Existing target suite reproduces the Desktop routing-key false warning before the fix. Final target suite: 20 passed (adds an unstored HERMES_SESSION_ID + routing key case). Caller-priority, suffix, unchecked key, unchecked session id, worker, unknown-target and lineage mutants killed. Live MacBook command and wake verification remain required after deploy.
---
 hermes_cli/kanban_notify_target.py            | 27 +++++---
 .../test_kanban_notify_subscribe_target.py    | 63 +++++++++++++++++++
 2 files changed, 83 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban_notify_target.py b/hermes_cli/kanban_notify_target.py
index 0f3891b686..d091671c20 100644
--- a/hermes_cli/kanban_notify_target.py
+++ b/hermes_cli/kanban_notify_target.py
@@ -37,21 +37,34 @@ def _title_and_tip(session_id: str) -> tuple[Optional[str], Optional[str], bool]
         db.close()
 
 
+def _caller_chat() -> tuple[str, Optional[str]]:
+    """Resolve subprocess identity to a real state.db chat, never suggest an unchecked routing key."""
+    session_id = (os.environ.get("HERMES_SESSION_ID") or "").strip()
+    key = (os.environ.get("HERMES_SESSION_KEY") or "").strip()
+    for candidate in (session_id, key, key.rsplit(":", 1)[-1]):
+        if candidate:
+            _title, tip, found = _title_and_tip(candidate)
+            if found:
+                return candidate, tip
+    return "", None
+
+
 def print_tui_target(task_id: str, chat_id: str) -> None:
     """Print the bound chat's title; warn on stderr when it is not the calling agent's own chat.
 
-    The subprocess env names the calling chat: ``HERMES_SESSION_KEY`` (what the tui poller listens on) or
-    ``HERMES_SESSION_ID``. Two ids of one compacted lineage (same compression tip) are the same chat. A plain shell
-    (neither set) and a Kanban worker are never warned."""
+    ``HERMES_SESSION_ID`` names the state.db chat; ``HERMES_SESSION_KEY`` may instead be a
+    Desktop routing key ending in that id. Here both only identify the caller: this manual
+    subscribe routes by ``--chat-id``, not by either env spelling.
+    Two ids of one compacted lineage (same compression tip) are the same chat. A plain shell,
+    an unresolved caller, and a Kanban worker are never warned."""
     title, tip, found = _title_and_tip(chat_id)
     label = title or "untitled"
     print(f"  chat {chat_id}: {label}" if found else
           f"  chat {chat_id} is not a chat in this profile's state.db (check the id)")
-    mine = (os.environ.get("HERMES_SESSION_KEY") or os.environ.get("HERMES_SESSION_ID") or "").strip()
-    if os.environ.get("HERMES_KANBAN_TASK") or not mine or mine == chat_id:
+    if os.environ.get("HERMES_KANBAN_TASK") or not found:
         return
-    _mine_title, mine_tip, mine_found = _title_and_tip(mine)
-    if found and mine_found and tip == mine_tip:
+    mine, mine_tip = _caller_chat()
+    if not mine or tip == mine_tip:
         return
     print(f"WARNING: binding a different chat ({label}): this command runs from chat {mine}, but --chat-id is "
           f"{chat_id}. To link the card to this chat, re-run with --chat-id {mine} and "
diff --git a/tests/hermes_cli/test_kanban_notify_subscribe_target.py b/tests/hermes_cli/test_kanban_notify_subscribe_target.py
index 5d0b4c0b56..e038f4842a 100644
--- a/tests/hermes_cli/test_kanban_notify_subscribe_target.py
+++ b/tests/hermes_cli/test_kanban_notify_subscribe_target.py
@@ -76,6 +76,69 @@ def test_subscribe_warns_when_binding_a_different_chat(home, monkeypatch, capsys
     assert MINE in text
 
 
+_ROUTING_KEY = f"agent:main:local:dm:{MINE}"
+# caller -> (subprocess env, the chat id the warning must suggest; None = never warned)
+_CALLERS = {
+    "routing": ({"HERMES_SESSION_KEY": _ROUTING_KEY}, MINE),
+    "bare": ({"HERMES_SESSION_KEY": MINE}, MINE),
+    "preferred": ({"HERMES_SESSION_KEY": _ROUTING_KEY, "HERMES_SESSION_ID": OTHER}, OTHER),
+    "preferred_bare": ({"HERMES_SESSION_KEY": MINE, "HERMES_SESSION_ID": OTHER}, OTHER),
+    "stale_id": ({"HERMES_SESSION_KEY": _ROUTING_KEY, "HERMES_SESSION_ID": "stale-unstored"}, MINE),
+    "worker": ({"HERMES_SESSION_KEY": _ROUTING_KEY, "HERMES_KANBAN_TASK": "t_worker"}, None),
+    "unknown": ({"HERMES_SESSION_KEY": "agent:main:local:dm:missing"}, None),
+}
+
+
+@pytest.mark.parametrize("target", [MINE, OTHER])
+@pytest.mark.parametrize("caller", sorted(_CALLERS))
+def test_subscribe_resolves_caller_before_warning(home, monkeypatch, capsys, target, caller):
+    env, resolved = _CALLERS[caller]
+    for name, value in env.items():
+        monkeypatch.setenv(name, value)
+    rc, _ = _subscribe(target)
+    out = capsys.readouterr()
+    assert rc == 0
+    if resolved and target != resolved:
+        assert "WARNING: binding a different chat" in out.err
+        assert f"re-run with --chat-id {resolved} and" in out.err
+    else:
+        assert "WARNING" not in out.err
+    assert "agent:main:local:dm:" not in out.err
+    assert "stale-unstored" not in out.err
+
+
+def test_subscribe_routing_key_same_compression_lineage(home, monkeypatch, capsys):
+    from hermes_state import SessionDB
+    with SessionDB(db_path=home / "state.db") as db:
+        db.publish_compression_child(parent_session_id=MINE, child_session_id="compressed",
+                                     source="desktop", messages=[{"role": "user", "content": "summary"}],
+                                     require_compression_lease=False)
+    monkeypatch.setenv("HERMES_SESSION_KEY", f"agent:main:local:dm:{MINE}")
+    rc, _ = _subscribe("compressed")
+    assert rc == 0
+    assert "WARNING" not in capsys.readouterr().err
+
+
+def test_unknown_target_keeps_id_diagnostic_without_lineage_warning(home, monkeypatch, capsys):
+    monkeypatch.setenv("HERMES_SESSION_ID", MINE)
+    rc, _ = _subscribe("missing")
+    out = capsys.readouterr()
+    assert rc == 0
+    assert "not a chat in this profile's state.db" in out.out
+    assert "WARNING" not in out.err
+
+
+def test_real_routing_shaped_id_is_not_replaced_by_suffix(home, monkeypatch, capsys):
+    from hermes_state import SessionDB
+    key = f"agent:main:local:dm:{MINE}"
+    with SessionDB(db_path=home / "state.db") as db:
+        db.create_session(session_id=key, source="desktop")
+    monkeypatch.setenv("HERMES_SESSION_KEY", key)
+    rc, _ = _subscribe(MINE)
+    assert rc == 0
+    assert f"re-run with --chat-id {key} and" in capsys.readouterr().err
+
+
 def test_subscribe_from_a_plain_shell_does_not_warn(home, capsys):
     rc, _ = _subscribe(OTHER)
     out = capsys.readouterr()
