From d14d1b3bbefde568809fefe6f720069b7add7e70 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 08:55:05 -0700
Subject: [PATCH] feat(kanban): publish configured machine pickup on sync
 [daveey] (#203)

* feat(kanban): publish pickup_mode once per sync round when it changed [daveey]

The Board gives a machine pin runs_on only when /v2/machines advertises
pickup. Post kanban.sync.pickup (None as null) from the sync client, once
per round, and only when the value changed.

* test(kanban): exercise judge gate with a valid task identifier [daveey]
---
 hermes_cli/kanban_sync_client.py            | 47 ++++++++++++++++++
 tests/hermes_cli/test_kanban_worker_node.py | 55 +++++++++++++++++++++
 2 files changed, 102 insertions(+)

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index 6cd13fec2ed..2f3fb999e69 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -152,6 +152,10 @@ class Hub:
         """This machine's own load for the registry (display only; see hermes_cli.machine_metrics)."""
         return self._call("POST", "/v2/machines/me/metrics", metrics)
 
+    def report_pickup(self, pickup: Optional[str]) -> dict:
+        """Publish this machine's ``kanban.sync.pickup`` (None → null) on its own registry row."""
+        return self._call("POST", "/v2/machines/me", {"pickup": pickup})
+
 
 # --- boards ---------------------------------------------------------------------------------------
 
@@ -623,9 +627,52 @@ def sync_board(slug: str, path: Path, hub: Hub, gateway: str) -> RoundResult:
         live.close()
 
 
+_UNPUBLISHED = object()
+_PICKUP_STATE: dict[str, Any] = {"value": _UNPUBLISHED, "retry_at": 0.0}
+_PICKUP_UNSUPPORTED_S = 600.0
+
+
+def reset_published_pickup() -> None:
+    """Tests: forget the last posted pickup so the next round posts again."""
+    _PICKUP_STATE["value"] = _UNPUBLISHED
+    _PICKUP_STATE["retry_at"] = 0.0
+
+
+def publish_pickup_if_changed(hub: Any, *, now: Optional[float] = None) -> bool:
+    """Post :func:`hermes_cli.kanban_worker_node.pickup_mode` (None → null) once per sync round, and only when it
+    changed. A failed post is retried next round. An older Board (404/405) stays quiet for 10 minutes. Never
+    raises into the sync loop. A hub without ``report_pickup`` (test fakes) is a no-op."""
+    from hermes_cli.kanban_worker_node import pickup_mode
+    mode = pickup_mode()
+    if _PICKUP_STATE["value"] == mode:
+        return False
+    clock = time.monotonic() if now is None else now
+    if clock < float(_PICKUP_STATE["retry_at"]):
+        return False
+    poster = getattr(hub, "report_pickup", None)
+    if poster is None:
+        return False
+    try:
+        poster(mode)
+    except HubError as exc:
+        if exc.status in (404, 405):
+            _PICKUP_STATE["retry_at"] = clock + _PICKUP_UNSUPPORTED_S
+            _log.info("kanban sync: board has no pickup route yet (%s); retrying later", exc.status)
+        else:
+            _log.warning("kanban sync: pickup publish failed (%s)", exc)
+        return False
+    except OSError as exc:
+        _log.warning("kanban sync: pickup publish failed (%s)", exc)
+        return False
+    _PICKUP_STATE["value"] = mode
+    _PICKUP_STATE["retry_at"] = 0.0
+    return True
+
+
 def sync_all_once(hub: Optional[Hub] = None) -> list[RoundResult]:
     ident = load_identity() if hub is None else hub.ident
     hub = hub or Hub(ident)
+    publish_pickup_if_changed(hub)
     results = []
     for slug, path in board_paths():
         try:
diff --git a/tests/hermes_cli/test_kanban_worker_node.py b/tests/hermes_cli/test_kanban_worker_node.py
index 0a426d1d9a5..9118ae530be 100644
--- a/tests/hermes_cli/test_kanban_worker_node.py
+++ b/tests/hermes_cli/test_kanban_worker_node.py
@@ -416,3 +416,58 @@ def test_tool_create_heavy_route_works_when_the_registry_has_no_pickup_field(gws
     monkeypatch.setattr(kp, "create_remote", lambda view, **kw: {"ok": True, "request_id": "r", "queued_only": True})
     out = _tool_create({"title": "Run the bench-v2 benchmark", "assignee": "default"})
     assert out["runs_on"] == ["machine:worker-1"], out
+
+
+def test_client_publishes_pickup_mode_once_per_round_when_it_changed(gws, monkeypatch):
+    """The sync client posts pickup_mode() (None → null) once per sync round, and only when it changed."""
+    hub_gw, worker = gws
+    posted: list = []
+
+    class PublishingHub:
+        def __init__(self, gateway):
+            self.ident = ksc.Identity(url="https://board.test", key="k" * 16, gateway=gateway)
+
+        def report_pickup(self, pickup):
+            posted.append((self.ident.gateway, pickup))
+            return {"pickup": pickup}
+
+    ksc.reset_published_pickup()
+    worker.enter()  # kanban.sync.pickup: true → pickup_mode() == "all"
+    assert wn.pickup_mode() == "all"
+    assert ksc.publish_pickup_if_changed(PublishingHub(WORKER)) is True
+    assert ksc.publish_pickup_if_changed(PublishingHub(WORKER)) is False  # unchanged: no second post
+    hub_gw.enter()  # pickup off → None, posted as null
+    assert wn.pickup_mode() is None
+    assert ksc.publish_pickup_if_changed(PublishingHub(HUB)) is True
+    assert posted == [(WORKER, "all"), (HUB, None)]
+    assert json.dumps({"pickup": posted[-1][1]}) == '{"pickup": null}'
+
+    calls = []
+    client = ksc.Hub(ksc.Identity(url="https://board.test", key="k" * 16, gateway=WORKER))
+    monkeypatch.setattr(client, "_call", lambda method, path, body=None: calls.append((method, path, body)) or {})
+    client.report_pickup(None)
+    assert calls == [("POST", "/v2/machines/me", {"pickup": None})]
+
+    seen = []
+    monkeypatch.setattr(ksc, "publish_pickup_if_changed", lambda hub: seen.append(hub.ident.gateway) or False)
+    worker.enter()
+    ksc.sync_all_once(worker.svc.hub(WORKER))
+    ksc.sync_all_once(worker.svc.hub(WORKER))
+    assert seen == [WORKER, WORKER]  # once per round, not once per board
+
+
+def test_pin_to_a_machine_that_published_all_gets_runs_on(gws, monkeypatch):
+    """A registry entry whose machine posted pickup=all is a real pin target; one without pickup is not."""
+    hub, _ = gws
+    hub.enter()
+    monkeypatch.setattr("hermes_cli.kanban_capability_registry.self_gateway", lambda: HUB)
+    wn.set_registry_fetch(lambda: {"me": HUB, "machines": [
+        {"name": WORKER, "state": "active", "labels": ["linux"], "pickup": "all"},
+        {"name": "macbook", "state": "active", "labels": ["macos"], "pinned_only": True},
+    ]})
+    out = _tool_create({"title": "pinned to a publisher", "assignee": "default", "placement": WORKER})
+    assert out["runs_on"] == ["machine:worker-1"], out
+    assert json.loads(hub.conn.execute("SELECT runs_on FROM tasks WHERE id = ?",
+                                        (out["task_id"],)).fetchone()[0]) == ["machine:worker-1"]
+    # macbook is active and has no pickup field: the pin does not become runs_on
+    assert wn.placement_runs_on(hub.conn, "macbook") is None
