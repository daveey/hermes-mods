From e15380f007439283d6eaf7259b49a11b39533594 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 08:59:14 +0000
Subject: [PATCH] [daveey] ci: narrow batch API errors and use UTC alias

---
 scripts/ci/batch_review_comments.py    | 8 ++++----
 tests/ci/test_batch_review_comments.py | 4 ++--
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/scripts/ci/batch_review_comments.py b/scripts/ci/batch_review_comments.py
index 2f8a6811e52..7cce3bfbe0a 100644
--- a/scripts/ci/batch_review_comments.py
+++ b/scripts/ci/batch_review_comments.py
@@ -26,7 +26,7 @@ import importlib.util
 import json
 import os
 import sys
-from datetime import datetime, timezone
+from datetime import UTC, datetime
 from pathlib import Path
 
 CI_WORKFLOW_NAME = "CI"
@@ -134,13 +134,13 @@ def process_pr(token: str, repo: str, pr: dict, now: datetime) -> str:
 
 
 def run_batch(token: str, repo: str, now: datetime | None = None) -> int:
-    now = now or datetime.now(timezone.utc)
+    now = now or datetime.now(UTC)
     owner, name = repo.split("/")
     try:
         prs = lc._api_get_paginated(
             f"{lc.API_BASE}/repos/{owner}/{name}/pulls?state=open&per_page=100", token,
         )
-    except Exception as e:
+    except (OSError, ValueError, RuntimeError) as e:
         print(f"ERROR listing open PRs: {e}", file=sys.stderr)
         return 1
 
@@ -151,7 +151,7 @@ def run_batch(token: str, repo: str, now: datetime | None = None) -> int:
         try:
             result = process_pr(token, repo, pr, now)
             print(f"  PR #{pr['number']}: {result}")
-        except Exception as e:
+        except (OSError, ValueError, RuntimeError) as e:
             failures += 1
             print(f"  PR #{pr['number']}: ERROR {e}", file=sys.stderr)
     if failures:
diff --git a/tests/ci/test_batch_review_comments.py b/tests/ci/test_batch_review_comments.py
index 4cd50dd2091..da57d7d18b6 100644
--- a/tests/ci/test_batch_review_comments.py
+++ b/tests/ci/test_batch_review_comments.py
@@ -4,7 +4,7 @@ from __future__ import annotations
 
 import importlib.util
 import sys
-from datetime import datetime, timezone
+from datetime import UTC, datetime
 from pathlib import Path
 
 import pytest
@@ -17,7 +17,7 @@ sys.modules["batch_review_comments"] = b
 _spec.loader.exec_module(b)
 
 REPO = "o/r"
-NOW = datetime(2026, 11, 11, 12, 17, tzinfo=timezone.utc)
+NOW = datetime(2026, 11, 11, 12, 17, tzinfo=UTC)
 
 
 def _pr(n, sha, head_repo: str | None = REPO, state="open"):
-- 
2.55.0

