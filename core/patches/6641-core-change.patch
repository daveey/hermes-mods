+_LATEST_EVENT = ("SELECT e.task_id,{fields} FROM json_each(?) AS wanted CROSS JOIN task_events AS e"
+                 " ON e.id=(SELECT MAX(id) FROM task_events WHERE kind='{kind}' AND task_id=wanted.value)")
