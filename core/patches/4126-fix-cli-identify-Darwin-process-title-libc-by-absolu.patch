From e2e836ca72579d142e69636e9c9169018619720e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 03:54:09 +0000
Subject: [PATCH] fix(cli): identify Darwin process-title libc by absolute path
 [daveey]

Problem: quiet proof blocks native-load:libc.dylib from Darwin startup.
Why: _set_process_title emits a loader-search basename; intentional strict
attestation cannot establish outside-core provenance for unresolved names.
Root (happened): startup producer lacks explicit library identity.
Root (not caught): policy tests did not exercise the actual Darwin entry.
Recurrence: PR2796 preserved the correct unresolved-provenance guard; this
fixes its previously uncovered producer rather than weakening that guard.

Use /usr/lib/libc.dylib, preserving use_errno, pthread call and exception
handling. Apple's Libsystem xcodescripts/create_dylib_symlinks.sh lists c
and pthread in BSD_LIBS and links /usr/lib/libc.dylib to libSystem.dylib.
CPython 3.14 Lib/ctypes/macholib/dyld.py supports shared-cache paths too.

Proof: parent RED 1 failed/4 passed with native-load:libc.dylib from real
_set_process_title. GREEN integrated producer, negative provenance,
quiet-policy and dependency suites pass. Startup activation and full
code-attestation consumers pass. Full scripts/check passes.
Mock CDLL emits the same audit event; no actual Darwin loader/OS call or
Mac action. Linux/Windows call behavior and nonfatal loader failure tested.
Unresolved names, invalid paths, core aliases and bad dependency receipts
remain blocking. No quiet gate override or live CPU acceptance claim.
---
 hermes_cli/main.py                            |  2 +-
 .../test_process_title_attestation.py         | 80 +++++++++++++++++++
 2 files changed, 81 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_cli/test_process_title_attestation.py

diff --git a/hermes_cli/main.py b/hermes_cli/main.py
index 227dbe8f63..14ead6540a 100644
--- a/hermes_cli/main.py
+++ b/hermes_cli/main.py
@@ -149,7 +149,7 @@ def _set_process_title() -> None:
             libc = ctypes.CDLL("libc.so.6", use_errno=True)
             libc.prctl(15, b"hermes", 0, 0, 0)  # PR_SET_NAME = 15
         elif system == "Darwin":
-            libc = ctypes.CDLL("libc.dylib", use_errno=True)
+            libc = ctypes.CDLL("/usr/lib/libc.dylib", use_errno=True)
             libc.pthread_setname_np(b"hermes")
     except Exception:
         pass
diff --git a/tests/hermes_cli/test_process_title_attestation.py b/tests/hermes_cli/test_process_title_attestation.py
new file mode 100644
index 0000000000..b0a6f4d1dc
--- /dev/null
+++ b/tests/hermes_cli/test_process_title_attestation.py
@@ -0,0 +1,80 @@
+"""Exercise the real startup producer without loading or calling a host library."""
+import pytest
+
+from tests.hermes_cli.test_code_attestation import run_probe
+
+
+@pytest.mark.parametrize("system, expected", [
+    ("Darwin", "/usr/lib/libc.dylib"), ("Linux", "libc.so.6"), ("Windows", None),
+])
+def test_process_title_native_provenance(tmp_path, system, expected):
+    result = run_probe(tmp_path, '''
+        import ctypes, platform
+        from hermes_cli.main import _set_process_title
+        # Force the documented fallback even if the optional package is installed.
+        sys.modules['setproctitle'] = None
+        platform.system = lambda: SYSTEM
+        calls = []
+        class Library:
+            def pthread_setname_np(self, title):
+                calls.append(['pthread_setname_np', title.decode()])
+            def prctl(self, *args):
+                calls.append(['prctl', args[0], args[1].decode(), *args[2:]])
+        def load(name, *, use_errno):
+            calls.append(['load', name, use_errno])
+            # Same event as ctypes' native dlopen; no real host OS calls.
+            sys.audit('ctypes.dlopen', name)
+            return Library()
+        ctypes.CDLL = load
+        before = set(a.quiet_unknown_partition()[0])
+        _set_process_title()
+        blocking, informational = a.quiet_unknown_partition()
+        print(json.dumps(dict(calls=calls, blocking=sorted(set(blocking)-before),
+                             informational=informational, raw=a.latched_unknowns())))
+    '''.replace('SYSTEM', repr(system)))
+    if system == 'Darwin':
+        assert not any(r.startswith('native-load:') for r in result['blocking']), result
+    if expected is None:
+        assert result['calls'] == []
+    else:
+        assert result['calls'][0] == ['load', expected, True]
+        if system == 'Darwin':
+            assert result['calls'][1] == ['pthread_setname_np', 'hermes']
+            assert 'native-load:' + expected in result['informational']
+            assert 'native-load:' + expected in result['raw']
+        else:
+            assert result['calls'][1] == ['prctl', 15, 'hermes', 0, 0, 0]
+
+
+def test_unresolved_and_invalid_native_names_still_block(tmp_path):
+    result = run_probe(tmp_path, r'''
+        names = ['libc.dylib', 'arbitrary.dylib', '/bad\x00/native.dylib']
+        alias = pathlib.Path('core-alias').resolve()
+        alias.symlink_to(root, target_is_directory=True)
+        names.append(str(alias / 'native.dylib'))
+        for name in names:
+            sys.audit('ctypes.dlopen', name)
+        blocking, informational = a.quiet_unknown_partition()
+        print(json.dumps(dict(names=names, blocking=blocking, informational=informational)))
+    ''')
+    for name in result['names']:
+        if '\x00' in name:
+            assert 'audit-error:ValueError' in result['blocking']
+        else:
+            assert 'native-load:' + name in result['blocking']
+        assert 'native-load:' + name not in result['informational']
+
+
+def test_darwin_title_loader_failure_is_nonfatal(tmp_path):
+    result = run_probe(tmp_path, '''
+        import ctypes, platform
+        from hermes_cli.main import _set_process_title
+        sys.modules['setproctitle'] = None
+        platform.system = lambda: 'Darwin'  # os-marker: ok — mocked loader; no host OS calls
+        def fail(*args, **kwargs):
+            raise OSError('fixture loader failure')
+        ctypes.CDLL = fail
+        _set_process_title()
+        print(json.dumps({'survived': True}))
+    ''')
+    assert result['survived']
