From 00eaacb397ceebe4864b5b740cb78581f9e52dfa Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:41:57 +0000
Subject: [PATCH] test(worker-admission): pin host load in the unknown-alarm
 leaked-board tests [daveey]

test_refusal_records_the_streak_and_names_the_record leaked a board and
expected worker_resources_unknown, but worker_resource_admission._refusal()
checks _pressure() (real os.getloadavg / effective_cores) before occupancy.
On a host at >= 1.5 load/core it answered worker_load_pressure first, so the
test failed under load (hermes-worker-7, load 22-23 on 16 CPUs) and gave noisy
RED evidence on parent trees.

Fix: a _host_load(monkeypatch, load1) helper pins the seam _pressure reads
(16 cores, os.getloadavg). The streak test pins load 1. Two new tests show
the file controls pressure itself, both driving the real _pressure:
- load 24 -> _pressure True, refusal == worker_load_pressure, no unknown
  streak recorded;
- load 1 -> _pressure False, refusal == worker_resources_unknown.
The file's other tests never reach the real _refusal (they stub _refusal or
call alarm/sweep directly), so they had no exposure.

Proof (hermes-worker-8, 16 CPU, 32 `yes` hogs, load 32-47):
- origin/main test file: 1 failed, 7 passed
  (assert 'worker_load_pressure' == 'worker_resources_unknown', line 48);
- this file: 10/10 passed in each of 5 consecutive scripts/run_tests.sh runs.
Mutant `if False and _pressure(directory):` turns the new load-24 test RED.
scripts/check --base origin/main: 20 checks ok.

Card: t_01a1d65fceb2dd81
---
 .../test_worker_resources_unknown_alarm.py    | 27 ++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_worker_resources_unknown_alarm.py b/tests/hermes_cli/test_worker_resources_unknown_alarm.py
index 10ddd22cdd..869f4808d9 100644
--- a/tests/hermes_cli/test_worker_resources_unknown_alarm.py
+++ b/tests/hermes_cli/test_worker_resources_unknown_alarm.py
@@ -43,7 +43,32 @@ def _leak_a_board(tmp_path):
     return board
 
 
-def test_refusal_records_the_streak_and_names_the_record(tmp_path):
+def _host_load(monkeypatch, load1):
+    """Pin the load seam ``_pressure`` reads (16 cores; held from 1.5 load/core): real host load is never asked."""
+    monkeypatch.setattr(capacity, "effective_cores", lambda: 16)
+    monkeypatch.setattr("os.getloadavg", lambda: (load1, load1, load1))
+
+
+def test_load_pressure_answers_before_the_leaked_board_and_records_no_streak(tmp_path, monkeypatch):
+    """t_01a1d65fceb2dd81: ``_refusal`` checks pressure before occupancy, so a loaded host answers
+    ``worker_load_pressure`` even with a leaked board, and that answer is not an unknown streak."""
+    _leak_a_board(tmp_path)
+    _host_load(monkeypatch, 24)
+    assert admission._pressure(capacity.policy_root() / "worker-resources") is True
+    assert admission.refusal(enabled=True) == "worker_load_pressure"
+    assert alarm.read() is None
+
+
+def test_without_load_pressure_the_leaked_board_answers_unknown(tmp_path, monkeypatch):
+    _leak_a_board(tmp_path)
+    _host_load(monkeypatch, 1)
+    assert admission._pressure(capacity.policy_root() / "worker-resources") is False
+    assert admission.refusal(enabled=True) == "worker_resources_unknown"
+    assert alarm.read() is not None
+
+
+def test_refusal_records_the_streak_and_names_the_record(tmp_path, monkeypatch):
+    _host_load(monkeypatch, 1)  # t_01a1d65fceb2dd81: real load >= 1.5/core answered worker_load_pressure first
     board = _leak_a_board(tmp_path)
     assert admission.refusal(enabled=True) == "worker_resources_unknown"
     state = alarm.read()
