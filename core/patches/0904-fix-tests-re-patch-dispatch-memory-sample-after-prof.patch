From 8dca42d3f954707d23c0bff9fc2dc8c2cddc6928 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 23:02:01 -0700
Subject: [PATCH] fix(tests): re-patch dispatch memory sample after profile-cap
 reimport [daveey] (#164)

The per-profile cap fixture drops every hermes_cli module and reimports
kanban_db. conftest only patches _system_memory_sample on the module
object that existed before that purge, so the reimported dispatcher
reads live host memory and flakes when pressure is elevated.

Co-authored-by: hermes <hermes@localhost>
---
 tests/hermes_cli/test_kanban_per_profile_cap.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_per_profile_cap.py b/tests/hermes_cli/test_kanban_per_profile_cap.py
index 84252f2961..a3e9218084 100644
--- a/tests/hermes_cli/test_kanban_per_profile_cap.py
+++ b/tests/hermes_cli/test_kanban_per_profile_cap.py
@@ -33,6 +33,11 @@ def isolated_kanban_home_with_profiles(monkeypatch):
         del sys.modules[name]
     try:
         from hermes_cli import kanban_db
+        # conftest guard patches _system_memory_sample only on the module object
+        # imported before the purge above; dispatch uses the reimported module,
+        # which would read live host memory and flake under pressure.
+        from hermes_cli import kanban_db_dispatch
+        monkeypatch.setattr(kanban_db_dispatch, "_system_memory_sample", dict)
         yield kanban_db
     finally:
         for name in [
