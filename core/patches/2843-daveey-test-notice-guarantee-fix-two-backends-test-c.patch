From 7f99b4f794e6bc8008998b98eb5099ce64f9b6e7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 16:28:04 +0000
Subject: [PATCH] [daveey] test(notice guarantee): fix two-backends test
 comment wording (review t_01a1d08cc2a8c713 nits)

B's pass runs inside A's holders lookup, the first check in A's handling of the row (after
candidates() fixed raw_meta), not the last step before _claim; a legacy row carries no busy count,
so the wake is stamped busy_attempts 1, not 'busy wake 2'. Comment-only.
---
 tests/tui_gateway/test_notice_guarantee.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/tests/tui_gateway/test_notice_guarantee.py b/tests/tui_gateway/test_notice_guarantee.py
index eb5f930915..145004f7be 100644
--- a/tests/tui_gateway/test_notice_guarantee.py
+++ b/tests/tui_gateway/test_notice_guarantee.py
@@ -259,9 +259,9 @@ def test_a_legacy_busy_row_past_the_lookback_is_left_alone(db):
 
 def test_two_backends_passes_over_one_legacy_busy_row_wake_it_once(db):
     # Every backend runs this pass every 30 s over the same profile store, and once the fix ships each of them
-    # re-offers a legacy busy row. Backend B's whole pass runs between backend A's candidate read and its claim
-    # (A's holders lookup is the last step before _claim), so A holds a stale raw_meta: the claim's compare-and-swap
-    # must let only B wake the row, stamped as busy wake 2 (busy_attempts carried over from the old busy wake).
+    # re-offers a legacy busy row. Backend B's whole pass runs inside A's holders lookup (the first check in A's
+    # handling of the row, after candidates() fixed its raw_meta), so A claims with a stale raw_meta: the claim's
+    # compare-and-swap must let only B wake the row, stamped busy_attempts 1 (a legacy row carries no count).
     row = _notice(db, "✔ Kanban t_aaa done — deploy card")
     _stamp_legacy_busy(db, row)
     other = SessionDB(db.db_path)  # backend B: its own connection to the same store
