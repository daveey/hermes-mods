From a36e78b2245b51653712a3cfb7fc75ae2d3f7f0a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 20:00:47 +0000
Subject: [PATCH] test: make system unit home adoption fixture hermetic
 [daveey]

---
 tests/hermes_cli/test_gateway_service.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/tests/hermes_cli/test_gateway_service.py b/tests/hermes_cli/test_gateway_service.py
index 0fe1fac9573..4842db78ae5 100644
--- a/tests/hermes_cli/test_gateway_service.py
+++ b/tests/hermes_cli/test_gateway_service.py
@@ -2985,9 +2985,15 @@ class TestUnitAnchoredServiceIdentity:
         monkeypatch.setattr(gateway_cli, "_SYSTEM_UNIT_DIR", unit_dir)
         monkeypatch.setattr(os, "geteuid", lambda: 0)
         monkeypatch.setattr(hermes_constants, "_get_platform_default_hermes_home", lambda: root_home)
+        # Service identity follows the passwd account, not a runner's scratch HOME.
+        monkeypatch.setattr(hermes_constants, "_account_home", lambda: root_home.parent)
+        monkeypatch.setattr(Path, "home", lambda: root_home.parent)
+        monkeypatch.delenv("SUDO_USER", raising=False)
         monkeypatch.delenv("HERMES_HOME", raising=False)
+        monkeypatch.setattr(gateway_cli, "_systemctl_show", lambda *a, **kw: pytest.fail("must read fixture unit"))
 
         pre_sync_name = gateway_cli.get_service_name()
+        assert pre_sync_name == gateway_cli._SERVICE_BASE
         gateway_cli._sync_hermes_home_from_systemd_unit(system=True)
 
         assert os.environ["HERMES_HOME"] == str(alice_home)  # the sync really ran
