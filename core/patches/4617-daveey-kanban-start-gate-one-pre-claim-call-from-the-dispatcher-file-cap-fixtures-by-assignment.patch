 4 files changed, 30 insertions(+), 12 deletions(-)

diff --git a/hermes_cli/kanban_db_dispatch.py b/hermes_cli/kanban_db_dispatch.py
index 9424c88a243466b516105fd0f0f320716422bf65..a5928a1e7f77ebf9b232aaf7368695bf52ace93d 100644
--- a/hermes_cli/kanban_db_dispatch.py
+++ b/hermes_cli/kanban_db_dispatch.py
@@ -1892,14 +1892,8 @@ def _dispatch_lane_task(
                 return False
             _guard_notice.record_guard_hold(conn, task_id, guard_reason)
         return False
-    from hermes_cli.kanban_llm_pacing_dispatch import hold as _pacing_hold  # quota-pace governor [daveey]
-    if _pacing_hold(conn, row, lane, result, dry_run=dry_run):  # pool ahead of pace: wait, unclaimed
-        return False
-    from hermes_cli.kanban_start_gate import hold as _start_gate_hold  # plugin start gate (token throttle) [daveey]
-    gate_reason = _start_gate_hold(task_id=task_id, lane=lane, assignee=assignee, board=board)
-    if gate_reason is not None:  # a plugin holds this start: wait, unclaimed, asked again next tick
-        result.respawn_guarded.append((task_id, gate_reason))
-        _record_clock_hold(conn, result, task_id, gate_reason)
+    from hermes_cli.kanban_start_gate import pre_claim_hold as _pre_claim_hold  # quota governor + plugin gate [daveey]
+    if _pre_claim_hold(conn, row, lane, result, assignee=assignee, board=board, dry_run=dry_run):  # wait, unclaimed
         return False
 
     def _count_spawn(name: str) -> None:
diff --git a/hermes_cli/kanban_start_gate.py b/hermes_cli/kanban_start_gate.py
index 8663d14eb852092255a39b2b1f5dbefdffb0fef8..9d4738d4cdb6874d3c91aceb98333d9f37f49d81 100644
--- a/hermes_cli/kanban_start_gate.py
+++ b/hermes_cli/kanban_start_gate.py
@@ -43,3 +43,18 @@ def hold(*, task_id: str, lane: str, assignee: Optional[str], board: Optional[st
     except (RuntimeError, ValueError, TypeError, LookupError, AttributeError, OSError) as exc:  # fail open
         logger.warning("kanban start gate: hook failed (%s: %s); starting ungated", type(exc).__name__, exc)
     return None
+
+
+def pre_claim_hold(conn: Any, row: Any, lane: str, result: Any, *, assignee: Optional[str], board: Optional[str],
+                   dry_run: bool = False) -> bool:
+    """The dispatcher's last two waits before a claim: the quota governor (``kanban_llm_pacing_dispatch.hold``, which
+    records its own event) and then the plugin start gate, recorded as a guard hold on ``result``."""
+    from hermes_cli.kanban_llm_pacing_dispatch import hold as pacing_hold
+
+    if pacing_hold(conn, row, lane, result, dry_run=dry_run):  # pool held (or, with pace_starts, ahead of pace)
+        return True
+    reason = hold(task_id=row["id"], lane=lane, assignee=assignee, board=board)
+    if reason is None:
+        return False
+    result.respawn_guarded.append((row["id"], reason))  # asked again next tick; nothing is persisted
+    return True
