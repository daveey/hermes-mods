From 389a0740dad4145d16611faf260c9fc3b37ea2ba Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 01:36:59 +0000
Subject: [PATCH] [daveey] Recover a returning home after successor delivery
 fails

---
 .../tui_gateway/test_kanban_remote_rehome.py  | 22 +++++++++++++++++++
 tui_gateway/kanban_remote_identity.py         |  2 +-
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_kanban_remote_rehome.py b/tests/tui_gateway/test_kanban_remote_rehome.py
index 410bd8f5d59b44d79202a3d86eceaf28e29116e8..386f6981acd88a6407cfc73b9362e045b3716687 100644
--- a/tests/tui_gateway/test_kanban_remote_rehome.py
+++ b/tests/tui_gateway/test_kanban_remote_rehome.py
@@ -209,6 +209,28 @@ def test_moved_woken_claim_recovers_only_after_turn_ends(tmp_path, running):
         krn._forget_woken(claim_id)
 
 
+def test_return_home_after_ended_alias_and_failed_successor_retries(tmp_path):
+    now = time.time()
+    hub = once._hub(tmp_path, now)
+    ledger = tmp_path / 'ledger.db'
+    _move(hub, 'worker-6')
+    [old] = krn.collect(once.CHAT, 'default', hub_db=hub, ledger=ledger, now=now)
+    claim_id = (old['session'], old['ref'], old['state'])
+    _move(hub, 'hub')
+    krn._track_woken(claim_id, {'running': False})
+    try:
+        [new] = krn.collect(once.CHAT, 'default', hub_db=hub, ledger=ledger, now=now + 10,
+                            transcript_has=lambda *_: False)
+        krn.release(new, ledger=ledger)
+        _move(hub, 'worker-6')
+        offered = krn.collect(once.CHAT, 'default', hub_db=hub, ledger=ledger, now=now + 20,
+                              transcript_has=lambda *_: False)
+        assert len(offered) == 1
+        assert offered[0]['ref'] == old['ref']
+    finally:
+        krn._forget_woken(claim_id)
+
+
 @pytest.mark.parametrize('delivered', [False, True])
 def test_returning_old_home_respects_successor_custody(tmp_path, monkeypatch, delivered):
     now = time.time()
diff --git a/tui_gateway/kanban_remote_identity.py b/tui_gateway/kanban_remote_identity.py
index a021b658313caaca40913da3b197f34c21cc76bf..595945f49d051c1feda142795a1498febb6b4c29 100644
--- a/tui_gateway/kanban_remote_identity.py
+++ b/tui_gateway/kanban_remote_identity.py
@@ -30,7 +30,7 @@ def moved_claim(conn, *, session, ref, state, now, notice_key, swept_key, transc
         if (row['ref'] in ended and row['notice_key'] and transcript_has is not None
                 and notices._forget_woken((session, row['ref'], state))):
             # The caller's claim transaction also reserves the successor before releasing this fence.
-            conn.execute('UPDATE notices SET holder_pid=NULL, holder_start=NULL '
+            conn.execute('DELETE FROM notices '
                          'WHERE session=? AND ref=? AND state=? AND delivered=0',
                          (session, row['ref'], state))
             continue
