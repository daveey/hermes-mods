From 34d27c11a0e219310e29b64f93d4303b8e26c0f0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 26 Oct 2026 21:30:52 -0700
Subject: [PATCH 447/453] fix(kanban): default CLI assignee; sweep stale triage
 cards to default profile

(cherry picked from commit 34d27c11a0e219310e29b64f93d4303b8e26c0f0)
---
diff --git a/hermes_cli/kanban.py b/hermes_cli/kanban.py
index d84d300605d376362514a7183f0943bcd81b0931..1def383ec1ee69d7a145ab72ae000e5d828645a2 100644
--- a/hermes_cli/kanban.py
+++ b/hermes_cli/kanban.py
@@ -217,6 +217,16 @@ _AGENT_ENV_MARKERS = ("HERMES_SESSION_KEY", "HERMES_SESSION_ID", "HERMES_SESSION
                       "HERMES_RPC_SOCKET", "HERMES_KERNEL_SENTINEL")
 
 
+def _cli_default_assignee(args) -> Optional[str]:
+    """Dispatchable cards need an assignee: an unassigned ``ready``/``todo`` card is
+    never spawned. Default it (``kanban.default_assignee`` or ``default``); triage and
+    blocked drafts stay unassigned. Trackers for remote work should use
+    ``kanban_schedule`` with a ``wake_check`` instead."""
+    if getattr(args, "triage", False) or getattr(args, "initial_status", "running") == "blocked":
+        return None
+    return kb._default_ready_assignee()
+
+
 def _agent_invoked() -> bool:
     """Whether this CLI call came from an agent tool (terminal / execute_code)."""
     return any(os.environ.get(name) for name in _AGENT_ENV_MARKERS)
@@ -417,7 +427,8 @@ def _cmd_create(args: argparse.Namespace) -> int:
         try:
             task_id = kb.create_task(
                 conn, title=args.title, body=body,
-                assignee=args.assignee or (_profile_author() if in_worker or _agent_invoked() else None),
+                assignee=args.assignee or (_profile_author() if in_worker or _agent_invoked() else None)
+                or _cli_default_assignee(args),
                 session_id=session_id, requires=getattr(args, "requires", None),
                 created_by=args.created_by or _profile_author(),
                 workspace_kind=ws_kind, workspace_path=ws_path, branch_name=branch_name,
diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index e1fe5338007b7bd47d564745fd68a04110d4b02a..da93c38b422f7eb4bdf54817d01b5592183247a7 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -1179,6 +1179,17 @@ def _normalize_task_skills(skills: Optional[Iterable[str]]) -> Optional[list[str
     return cleaned
 
 
+def _default_ready_assignee() -> str:
+    """``kanban.default_assignee`` (config) or the ``default`` profile."""
+    try:
+        from hermes_cli.config import load_config
+
+        name = str(((load_config().get("kanban") or {}).get("default_assignee")) or "").strip()
+    except Exception:
+        name = ""
+    return name or "default"
+
+
 def create_task(
     conn: sqlite3.Connection, *, title: str, body: Optional[str] = None,
     assignee: Optional[str] = None, created_by: Optional[str] = None,
diff --git a/tests/hermes_cli/test_kanban_unclaimable_cards.py b/tests/hermes_cli/test_kanban_unclaimable_cards.py
new file mode 100644
index 0000000000000000000000000000000000000000..2392f293d1a149a0dc8552a3c60ff3731e538c9e
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_unclaimable_cards.py
@@ -0,0 +1,46 @@
+"""Cards nobody can claim: unassigned ready and stale triage."""
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_dispatch as kd
+
+
+@pytest.fixture
+def conn(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    kb.init_db()
+    from hermes_cli.kanban_db_connect import connect_closing
+    with connect_closing() as c:
+        yield c
+
+
+def _row(conn, tid):
+    return conn.execute("SELECT status, assignee, body FROM tasks WHERE id=?", (tid,)).fetchone()
+
+
+def test_stale_triage_swept_once(conn):
+    tid = kb.create_task(conn, title="held", triage=True)
+    assert kd.sweep_stale_triage(conn) == []  # too fresh
+    future = int(time.time()) + 7200
+    assert kd.sweep_stale_triage(conn, default_assignee="default", now=future) == [tid]
+    row = _row(conn, tid)
+    assert row["status"] == "ready" and row["assignee"] == "default" and "triage sweep" in row["body"]
+    conn.execute("UPDATE tasks SET status='triage' WHERE id=?", (tid,))
+    conn.commit()
+    assert kd.sweep_stale_triage(conn, now=future + 7200) == []
+
+
+def _args(**kw):
+    import argparse
+    return argparse.Namespace(**kw)
+
+
+def test_cli_defaults_assignee_but_not_triage_or_blocked(conn):
+    from hermes_cli import kanban
+    assert kanban._cli_default_assignee(_args(triage=False, initial_status="running")) == "default"
+    assert kanban._cli_default_assignee(_args(triage=True)) is None
+    assert kanban._cli_default_assignee(_args(triage=False, initial_status="blocked")) is None
