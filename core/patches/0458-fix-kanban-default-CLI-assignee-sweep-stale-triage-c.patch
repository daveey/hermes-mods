diff --git a/hermes_cli/kanban_db_dispatch.py b/hermes_cli/kanban_db_dispatch.py
index 6af5685ea1..8aae0053da 100644
--- a/hermes_cli/kanban_db_dispatch.py
+++ b/hermes_cli/kanban_db_dispatch.py
@@ -2473,6 +2473,48 @@ def _resolve_default_assignee(default_assignee: Optional[str]) -> Optional[str]:
 # The dispatch lock has been released here. Fire the tick observer strictly OUTSIDE the single-writer
 # critical section (#56066 sweeper finding / #64231 disposition): a slow subscriber must never extend the
 # lock hold and stall a sibling dispatcher's tick.
+TRIAGE_STALE_SECONDS = 3600
+_TRIAGE_BRIEF = (
+    "\n\n---\n[triage sweep] This card sat in triage with no specifier. Specify it "
+    "(clarify title/body, then do the work), or park it with kanban_schedule + a wake_check "
+    "probe if it waits on something external. Do not return it to triage."
+)
+
+
+def sweep_stale_triage(
+    conn: sqlite3.Connection, *, default_assignee: Optional[str] = None,
+    older_than: int = TRIAGE_STALE_SECONDS, now: Optional[int] = None,
+) -> list[str]:
+    """Nothing consumes ``triage`` on boards without a specifier, so it becomes a
+    parking lot. Move triage cards idle for ``older_than`` seconds to ``ready`` on the
+    default profile with a "specify or park with a probe" brief. Once per card
+    (``triage_swept`` event) so a worker that re-triages cannot loop; cards with an
+    open human request are left alone. Returns swept task ids."""
+    import time as _time
+    now = int(now if now is not None else _time.time())
+    cutoff = now - older_than
+    swept: list[str] = []
+    rows = conn.execute(
+        "SELECT t.id, t.body, t.assignee, t.human_request FROM tasks t WHERE t.status = 'triage' "
+        "AND COALESCE((SELECT MAX(e.created_at) FROM task_events e WHERE e.task_id = t.id), t.created_at) <= ? "
+        "AND NOT EXISTS (SELECT 1 FROM task_events s WHERE s.task_id = t.id AND s.kind = 'triage_swept')",
+        (cutoff,),
+    ).fetchall()
+    for row in rows:
+        if row["human_request"]:
+            continue
+        assignee = (row["assignee"] or "").strip() or default_assignee or "default"
+        with _kb.write_txn(conn):
+            cur = conn.execute(
+                "UPDATE tasks SET status = 'ready', assignee = ?, body = ? WHERE id = ? AND status = 'triage'",
+                (assignee, (row["body"] or "") + _TRIAGE_BRIEF, row["id"]),
+            )
+            if cur.rowcount:
+                _kb._append_event(conn, row["id"], "triage_swept", {"assignee": assignee, "older_than": older_than})
+                swept.append(row["id"])
+    return swept
+
+
 def _dispatch_once_locked(
     conn: sqlite3.Connection,
     *,
@@ -2505,6 +2547,11 @@ def _dispatch_once_locked(
         return result
 
     result.scheduling_admitted = not dry_run
+    if not dry_run:
+        try:
+            sweep_stale_triage(conn, default_assignee=_resolve_default_assignee(default_assignee))
+        except Exception:
+            _kb._log.debug("kanban dispatch: triage sweep failed", exc_info=True)
     ready_rows = lane_rows(conn, "ready")
     # Review rows are enumerated up front so the budget split can see whether
     # review work exists at all.
diff --git a/tests/hermes_cli/test_kanban_unclaimable_cards.py b/tests/hermes_cli/test_kanban_unclaimable_cards.py
new file mode 100644
index 0000000000..2392f293d1
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_unclaimable_cards.py
@@ -0,0 +1,46 @@
+"""Cards nobody can claim: unassigned ready and stale triage."""
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_dispatch as kd
+
+
+@pytest.fixture
+def conn(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    kb.init_db()
+    from hermes_cli.kanban_db_connect import connect_closing
+    with connect_closing() as c:
+        yield c
+
+
+def _row(conn, tid):
+    return conn.execute("SELECT status, assignee, body FROM tasks WHERE id=?", (tid,)).fetchone()
+
+
+def test_stale_triage_swept_once(conn):
+    tid = kb.create_task(conn, title="held", triage=True)
+    assert kd.sweep_stale_triage(conn) == []  # too fresh
+    future = int(time.time()) + 7200
+    assert kd.sweep_stale_triage(conn, default_assignee="default", now=future) == [tid]
+    row = _row(conn, tid)
+    assert row["status"] == "ready" and row["assignee"] == "default" and "triage sweep" in row["body"]
+    conn.execute("UPDATE tasks SET status='triage' WHERE id=?", (tid,))
+    conn.commit()
+    assert kd.sweep_stale_triage(conn, now=future + 7200) == []
+
+
+def _args(**kw):
+    import argparse
+    return argparse.Namespace(**kw)
+
+
+def test_cli_defaults_assignee_but_not_triage_or_blocked(conn):
+    from hermes_cli import kanban
+    assert kanban._cli_default_assignee(_args(triage=False, initial_status="running")) == "default"
+    assert kanban._cli_default_assignee(_args(triage=True)) is None
+    assert kanban._cli_default_assignee(_args(triage=False, initial_status="blocked")) is None
