From ba37cef62a001585fa90383101ab6dcba39564a2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 22:55:13 +0000
Subject: [PATCH] [daveey] fix(kanban): fail closed on shadow freshness read
 errors

Preliminary independent audit found OperationalError from pulled_at reads was converted into a stable stale token. Re-raise busy and I/O errors; retain only legacy missing-table/column compatibility. Two regression cases failed before the fix; all 1008 tests in 60 annotation/link consumer files pass afterward. Correct the existing board-read error fixture signature so it tests DatabaseError, not incidental TypeError.
---
 hermes_cli/kanban_annotation_local.py         |  4 +-
 .../test_kanban_annotation_narrow_local.py    | 48 ++++++++++++++++++-
 2 files changed, 49 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_annotation_local.py b/hermes_cli/kanban_annotation_local.py
index 24f6802873..aa9a6181bf 100644
--- a/hermes_cli/kanban_annotation_local.py
+++ b/hermes_cli/kanban_annotation_local.py
@@ -266,7 +266,9 @@ def shadows_part(entries: list[tuple[str, Any]], profile: str, now: float | None
                 try:
                     row = conn.execute("SELECT pulled_at FROM kanban_sync_state LIMIT 1").fetchone()
                     pulled = float(row[0]) if row and row[0] is not None else None
-                except sqlite3.OperationalError:  # replica written before pulls were stamped
+                except sqlite3.OperationalError as exc:  # replica written before pulls were stamped
+                    if "no such table" not in str(exc) and "no such column" not in str(exc):
+                        raise
                     pulled = None
             finally:
                 conn.row_factory = None
diff --git a/tests/hermes_cli/test_kanban_annotation_narrow_local.py b/tests/hermes_cli/test_kanban_annotation_narrow_local.py
index ebcde7a329..bb7cd5d354 100644
--- a/tests/hermes_cli/test_kanban_annotation_narrow_local.py
+++ b/tests/hermes_cli/test_kanban_annotation_narrow_local.py
@@ -15,8 +15,10 @@ from hermes_cli import kanban_annotation_local as own
 from hermes_cli import kanban_annotation_narrow as narrow
 from hermes_cli import kanban_session_activity as ksa
 from hermes_cli.kanban_db_sync import SHADOW_DIR
-from tests.hermes_cli.test_kanban_annotation_narrow import SCOPE, hub  # fixture
