From 05e461c457af719993b9fe9b206cc3367dabfb32 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 06:01:16 +0000
Subject: [PATCH] [daveey] Allow nonblocking published PR readers in lanes flow

Expanded dashboard views were waiting for brokered PR reads on every board invalidation. Add an optional prefetch/get reader seam; default CLI Reader and all classifier policy remain unchanged. Dashboard observation lifecycle stays plugin-owned.

Proof: injection test failed RED with unexpected reader keyword before implementation. Core flow, PR observation and persisted-evidence suites pass 84 tests; scripts/check passes 21 gates.
---
 hermes_cli/kanban_lanes_flow.py               | 13 ++++++----
 .../test_kanban_lanes_flow_evidence.py        | 24 +++++++++++++++++++
 2 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_lanes_flow.py b/hermes_cli/kanban_lanes_flow.py
index acfb1be77b..c0e1b13491 100644
--- a/hermes_cli/kanban_lanes_flow.py
+++ b/hermes_cli/kanban_lanes_flow.py
@@ -290,8 +290,12 @@ def _pr_urls(conn, rows) -> list:
     return out
 
 
-def snapshot(conn, *, window: str = "6h", now: Optional[float] = None, pol=None) -> dict:
-    """Cards still open, plus per-lane window throughput and today's cap usage."""
+def snapshot(conn, *, window: str = "6h", now: Optional[float] = None, pol=None, reader=None) -> dict:
+    """Cards still open, plus per-lane window throughput and today's cap usage.
+
+    Dashboards may inject a nonblocking published PR reader (prefetch/get). The CLI
+    default still takes fresh, bounded network observations for every report.
+    """
     if window not in WINDOWS:
         raise ValueError(f"window must be one of {', '.join(WINDOWS)}")
     now = time.time() if now is None else now
@@ -302,8 +306,9 @@ def snapshot(conn, *, window: str = "6h", now: Optional[float] = None, pol=None)
     usage = lanes.usage(conn, pol, window_s=window_s, now=now)
     rows = conn.execute(
         f"SELECT * FROM tasks WHERE status IN {_OPEN} ORDER BY created_at, id").fetchall()
-    from hermes_cli.kanban_lanes_flow_pr import Reader
-    reader = Reader()
+    if reader is None:
+        from hermes_cli.kanban_lanes_flow_pr import Reader
+        reader = Reader()
     reader.prefetch(_pr_urls(conn, rows))
     cards = []
     for row in rows:
diff --git a/tests/hermes_cli/test_kanban_lanes_flow_evidence.py b/tests/hermes_cli/test_kanban_lanes_flow_evidence.py
index db5b1b2b2b..b74ccb0bc6 100644
--- a/tests/hermes_cli/test_kanban_lanes_flow_evidence.py
+++ b/tests/hermes_cli/test_kanban_lanes_flow_evidence.py
@@ -60,6 +60,30 @@ def test_report_uses_pr_observation(conn, configured, monkeypatch, observation,
     assert card(conn, tid)["step"] == step
 
 
+def test_injected_reader_avoids_network_and_preserves_classification(conn, configured, monkeypatch):
+    tid = base._ready_in(conn, "myapp", "observed landing")
+    kb._append_event(conn, tid, "review_requested", {"metadata": {"pr": URL}})
+    kb._append_event(conn, tid, "changes_requested", {})
+    conn.commit()
+    seen = []
+
+    class Published:
+        def prefetch(self, urls):
+            seen.extend(urls)
+
+        def get(self, url):
+            assert url == URL
+            return {"merged": False, "approved": True, "checks": "green"}
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("injected snapshot constructed a network Reader")
+
+    monkeypatch.setattr(prs, "Reader", forbidden)
+    snapshot = flow.snapshot(conn, reader=Published())
+    assert URL in seen
+    assert next(c for c in snapshot["cards"] if c["id"] == tid)["step"] == "merge"
+
+
 def test_live_verification_requires_explicit_deploy_readback(conn, configured):
     tid = base._ready_in(conn, "myapp", "verify")
     conn.execute("UPDATE tasks SET status='scheduled' WHERE id=?", (tid,))
