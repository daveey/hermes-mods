Subject: [PATCH 6806] Code-attestation inventory cost, diagnostics and quiet-start review records

Public mirror of source commit 982ac7cc00937b615c33a93817faf7b24cee2795.

---
diff --git a/hermes_cli/code_attestation_inventory.py b/hermes_cli/code_attestation_inventory.py
index c43defcafe055521760b905d1c27edc72e244292..70fab371c6924dc6d7c8063a6862d763c7d2e83b 100644
--- a/hermes_cli/code_attestation_inventory.py
+++ b/hermes_cli/code_attestation_inventory.py
@@ -94,6 +94,33 @@
         raise ValueError('module_metadata_unavailable') from None
     if filename is not None and type(filename) is not str:
         raise ValueError('module_metadata_unavailable')
-    if filename is None and dynamic:
-        raise ValueError('module_metadata_unavailable')
+    if filename is None:
+        if dynamic:
+            raise ValueError('module_metadata_unavailable')
+        try:
+            _check_class_metadata(type(module), deadline=deadline, budget=budget)
+        except RuntimeError:
+            raise ValueError('module_metadata_unavailable') from None
+    # A concrete raw namespace file is authoritative for diagnostics, even when
+    # a subclass descriptor overrides ordinary access. Never invoke that access.
     return filename
+
+
+def _check_class_metadata(cls, *, deadline, budget):
+    from hermes_cli import code_attestation as ca
+    # Base type descriptors bypass hostile metaclass attribute hooks too.
+    mro = type.__dict__['__mro__'].__get__(cls)
+    for base in mro:
+        ca._check_inventory_deadline(deadline)
+        if base is ModuleType:
+            return
+        namespace = type.__dict__['__dict__'].__get__(base)
+        count = 0
+        for key in namespace:
+            ca._check_inventory_deadline(deadline)
+            count += 1
+            budget[0] += 1
+            if count > MAX_MODULE_NAMESPACE_ITEMS or budget[0] > MAX_INVENTORY_NAMESPACE_ITEMS:
+                raise ValueError('module_metadata_unavailable')
+            if type(key) is not str or key in ('__file__', '__getattr__', '__getattribute__'):
+                raise ValueError('module_metadata_unavailable')
diff --git a/tests/hermes_cli/test_code_attestation_inventory_subclasses.py b/tests/hermes_cli/test_code_attestation_inventory_subclasses.py
new file mode 100644
index 0000000000000000000000000000000000000000..85a08198f9ffa78dd8377a47a2ab36bbf9cd2b36
--- /dev/null
+++ b/tests/hermes_cli/test_code_attestation_inventory_subclasses.py
@@ -0,0 +1,79 @@
+"""Class metadata is opaque; only concrete instance metadata is diagnostic."""
+from types import ModuleType, SimpleNamespace
+
+import pytest
+
+from hermes_cli import code_attestation_inventory as inv
+
+
+def _callback(*args):
+    pytest.fail('class metadata callback executed')
+
+
+def _module(kind):
+    attrs = {
+        'attribute': {'__file__': 'class.py'},
+        'property': {'__file__': property(_callback)},
+        'getattr': {'__getattr__': _callback},
+        'getattribute': {'__getattribute__': _callback},
+        'slot': {'__slots__': ('__file__',)},
+    }
+    class OpaqueMeta(type):
+        def __getattribute__(self, name):
+            pytest.fail('metaclass attribute callback executed')
+    parent = OpaqueMeta('Parent', (ModuleType,), attrs[kind])
+    child = OpaqueMeta('Child', (parent,), {})
+    return child('opaque')
+
+
+@pytest.mark.parametrize('kind', ['attribute', 'property', 'getattr', 'getattribute', 'slot'])
+@pytest.mark.parametrize('explicit_none', [False, True])
+def test_class_metadata_without_concrete_file_refuses_before_classification(kind, explicit_none):
+    module = _module(kind)
+    namespace = ModuleType.__dict__['__dict__'].__get__(module)
+    if explicit_none:
+        namespace['__file__'] = None
+    calls = []
+    ledger = SimpleNamespace(_modules={}, _generation=7,
+        _module_snapshot=lambda: (('opaque', module),),
+        _module_file=lambda *args: calls.append(args))
+    with pytest.raises(ValueError, match='^module_metadata_unavailable$'):
+        inv.inventory_modules(ledger)
+    assert calls == [] and ledger._modules == {} and ledger._generation == 7
+
+
+@pytest.mark.parametrize('kind', ['attribute', 'property', 'getattr', 'getattribute', 'slot'])
+def test_concrete_namespace_file_is_authoritative_without_class_callbacks(kind):
+    module = _module(kind)
+    namespace = ModuleType.__dict__['__dict__'].__get__(module)
+    namespace['__file__'] = 'concrete.py'
+    assert inv._module_filename(module, deadline=None, budget=[0]) == 'concrete.py'
+
+
+def test_benign_subclass_without_file_remains_placeholder():
+    class Benign(ModuleType):
+        pass
+    assert inv._module_filename(Benign('placeholder'), deadline=None, budget=[0]) is None
+
+
+@pytest.mark.parametrize('limit', ['MAX_MODULE_NAMESPACE_ITEMS', 'MAX_INVENTORY_NAMESPACE_ITEMS'])
+def test_class_metadata_scan_is_bounded(monkeypatch, limit):
+    class Benign(ModuleType):
+        padding = None
+    monkeypatch.setattr(inv, limit, 0)
+    with pytest.raises(ValueError, match='^module_metadata_unavailable$'):
+        inv._check_class_metadata(Benign, deadline=None, budget=[0])
+
+
+def test_class_metadata_scan_checks_each_item_deadline(monkeypatch):
+    from hermes_cli import code_attestation as ca
+    class Benign(ModuleType):
+        padding = None
+    checks = []
+    def check(deadline):
+        checks.append(deadline)
+        if len(checks) == 3:
+            raise TimeoutError('class item deadline')
+    monkeypatch.setattr(ca, '_check_inventory_deadline', check)
+    with pytest.raises(TimeoutError, match='class item deadline'):
+        inv._check_class_metadata(Benign, deadline=10, budget=[0])
