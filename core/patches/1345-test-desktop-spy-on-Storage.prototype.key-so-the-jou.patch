From ce3b574f6667ad528ba8ce4006325c611d240eb7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 22:14:27 +0000
Subject: [PATCH] test(desktop): spy on Storage.prototype.key so the
 journal-read count is observed on jsdom's real Storage

On Node 22 with jsdom's real Storage, vi.spyOn(window.localStorage, 'key') stores the spy as a storage item and never intercepts calls (0 calls observed). Spying on the prototype intercepts every instance call. Assertion unchanged.

RED before: expected "key" to be called 6 times, but got 0. GREEN after: 4/4.
Card: t_01a18ec8e10bf506
---
 .../hooks/use-prompt-actions/prepared-submissions.test.ts       | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/apps/desktop/src/app/session/hooks/use-prompt-actions/prepared-submissions.test.ts b/apps/desktop/src/app/session/hooks/use-prompt-actions/prepared-submissions.test.ts
index e781e9956c4..e17c8d17720 100644
--- a/apps/desktop/src/app/session/hooks/use-prompt-actions/prepared-submissions.test.ts
+++ b/apps/desktop/src/app/session/hooks/use-prompt-actions/prepared-submissions.test.ts
@@ -33,7 +33,7 @@ test('a browser journal read lists the storage keys once, however many stores it
   }
 
   await removePreparedSubmission('c', 'c')
-  const key = vi.spyOn(window.localStorage, 'key')
+  const key = vi.spyOn(Storage.prototype, 'key')
   expect((await readPreparedSubmission('a'))?.text).toBe('a')
   expect(await readPreparedSubmission('c')).toBeUndefined()
   expect(key).toHaveBeenCalledTimes(2 * window.localStorage.length)
