From d05f0dc18571a157659d308dd0bc5be7a4f99f16 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 18:06:10 +0000
Subject: [PATCH] [daveey] fix(goals,init): a deleted launch dir never
 retargets goal gates or /init at a fallback tree

Review of #1646 (t_01a1d0e2163ea056): resolve_agent_cwd now falls back to TERMINAL_CWD/Kanban
workspace/$HOME for a deleted process cwd, so goals._gate_workspace ran gates in $HOME and /init
targeted $HOME's AGENTS.md. Both now use resolve_agent_cwd_strict() (configured cwd, else the
launch dir, else None): gates keep (None, None), /init raises FileNotFoundError. Stale
deleted-cwd comments in _workspace_pin_key and the prompt's cwd line updated.
---
 agent/prompt_builder.py                |  2 +-
 agent/runtime_cwd.py                   | 16 +++++++++++++++-
 agent/system_prompt.py                 |  2 +-
 hermes_cli/goals.py                    | 10 +++++-----
 hermes_cli/init_command.py             | 11 ++++++-----
 tests/agent/test_deleted_cwd_prompt.py | 25 +++++++++++++++++++++++++
 6 files changed, 53 insertions(+), 13 deletions(-)

diff --git a/agent/prompt_builder.py b/agent/prompt_builder.py
index 630b435784..19a4ffe153 100644
--- a/agent/prompt_builder.py
+++ b/agent/prompt_builder.py
@@ -1047,7 +1047,7 @@ def _local_host_hints() -> list[str]:
     host_lines = [f"Host: {host}", f"User home directory: {os.path.expanduser('~')}"]
     try:
         host_lines.append(f"Current working directory: {resolve_agent_cwd()}")
-    except OSError:
+    except OSError:  # unreadable cwd; a deleted one already falls back inside resolve_agent_cwd
         pass
     # The model reaches for the system temp dir by reflex (tmpfs on most Linux hosts, fills RAM);
     # naming Hermes' scratch dir here is what makes the TMPDIR export a habit rather than a hidden default.
diff --git a/agent/runtime_cwd.py b/agent/runtime_cwd.py
index cc50128d08..fe69ede37f 100644
--- a/agent/runtime_cwd.py
+++ b/agent/runtime_cwd.py
@@ -141,10 +141,24 @@ def process_cwd_or_fallback() -> str:
 
 
 def resolve_agent_cwd() -> Path:
-    """Configured cwd, else the launch dir; a deleted launch dir falls back via ``process_cwd_or_fallback``."""
+    """Configured cwd, else the launch dir; a deleted launch dir falls back via ``process_cwd_or_fallback``.
+
+    Callers that must act IN the project (goal gates, /init writing AGENTS.md) use
+    :func:`resolve_agent_cwd_strict` instead: a fallback directory is a different project there."""
     return _resolve_configured_cwd(override_is_final=False) or Path(process_cwd_or_fallback())
 
 
+def resolve_agent_cwd_strict() -> Path | None:
+    """Configured cwd, else the launch dir, else ``None`` when the launch dir is gone. Never substitutes
+    the Kanban workspace or $HOME for a deleted launch dir (TERMINAL_CWD is already the configured cwd
+    above), so callers that run or write project files can refuse instead of using another tree."""
+    configured = _resolve_configured_cwd(override_is_final=False)
+    if configured is not None:
+        return configured
+    cwd = process_cwd()
+    return Path(cwd) if cwd else None
+
+
 def resolve_context_cwd(*, include_session_override: bool = True) -> Path | None:
     """Configured cwd for context-file discovery, or None (build_context_files_prompt then falls back to the
     launch dir). An existing configured path is honored verbatim — including the Hermes source tree, a
diff --git a/agent/system_prompt.py b/agent/system_prompt.py
index 331408db21..c06e70d0a6 100644
--- a/agent/system_prompt.py
+++ b/agent/system_prompt.py
@@ -620,7 +620,7 @@ def _workspace_pin_key() -> str:
     (TUI ``/compress``) are one workspace, not two."""
     try:
         return str(resolve_context_cwd() or resolve_agent_cwd())
-    except OSError:  # deleted cwd
+    except OSError:  # unreadable cwd; a deleted one already falls back inside resolve_agent_cwd
         return ""
 
 
diff --git a/hermes_cli/goals.py b/hermes_cli/goals.py
index f9652cfe27..903ce845cc 100644
--- a/hermes_cli/goals.py
+++ b/hermes_cli/goals.py
@@ -388,7 +388,7 @@ def _gate_workspace() -> tuple[Optional[str], Optional[str]]:
     relative gate run anywhere else would check a different project and could pass a failing goal,
     and no agent turn can fix it, so the caller pauses instead of retrying.
     No declared workspace keeps the classic resolution (TERMINAL_CWD, else the launch directory)."""
-    from agent.runtime_cwd import resolve_agent_cwd, scoped_session_cwd
+    from agent.runtime_cwd import resolve_agent_cwd_strict, scoped_session_cwd
 
     declared = scoped_session_cwd()
     if declared:
@@ -397,10 +397,10 @@ def _gate_workspace() -> tuple[Optional[str], Optional[str]]:
             return str(path), None
         return None, (f"the session workspace {declared} is not a directory on this host, "
                       "and running gates anywhere else would check a different project")
-    try:
-        return str(resolve_agent_cwd()), None
-    except OSError:
-        return None, None  # deleted launch directory: subprocess reports it per gate
+    resolved = resolve_agent_cwd_strict()
+    if resolved is None:
+        return None, None  # deleted launch directory: subprocess reports it per gate, never $HOME
+    return str(resolved), None
 
 
 def run_gate(gate: GoalGate, *, cwd: Optional[str] = None) -> tuple[bool, int, str]:
diff --git a/hermes_cli/init_command.py b/hermes_cli/init_command.py
index 76691ef01e..8533758e64 100644
--- a/hermes_cli/init_command.py
+++ b/hermes_cli/init_command.py
@@ -104,12 +104,13 @@ def _resolve_session_cwd(session_key: str | None) -> str:
             return recorded
     except Exception:
         pass
-    try:
-        from agent.runtime_cwd import resolve_agent_cwd
+    from agent.runtime_cwd import resolve_agent_cwd_strict
 
-        return str(resolve_agent_cwd())
-    except Exception:
-        return os.getcwd()
+    resolved = resolve_agent_cwd_strict()
+    if resolved is None:
+        # A deleted launch dir must not retarget /init at $HOME's AGENTS.md (see docstring).
+        raise FileNotFoundError("the working directory was deleted; cd into the project and rerun /init")
+    return str(resolved)
 
 
 def build_init_prompt_for_cwd(cwd: str | None = None, extra: str = "",
diff --git a/tests/agent/test_deleted_cwd_prompt.py b/tests/agent/test_deleted_cwd_prompt.py
index 7ee74d4f75..6877717a36 100644
--- a/tests/agent/test_deleted_cwd_prompt.py
+++ b/tests/agent/test_deleted_cwd_prompt.py
@@ -115,3 +115,28 @@ def test_compaction_rebuild_boundary_survives_deleted_process_cwd(deleted_cwd, t
         rebuilt = _rebuild_system_prompt_at_boundary(agent, "")
     assert "KANBAN-WORKSPACE-RULES" in rebuilt
     assert agent._cached_system_prompt == rebuilt
+
+
+def test_goal_gate_workspace_never_falls_back_to_another_tree(deleted_cwd, tmp_path, monkeypatch):
+    """Goal gates must run in the project or nowhere: a deleted launch dir with no configured cwd
+    yields (None, None) as before, never $HOME or the Kanban workspace (which could pass a failing goal)."""
+    from hermes_cli.goals import _gate_workspace
+
+    ws = _project(tmp_path, "ws", "W")
+    home = _project(tmp_path, "home", "H")
+    monkeypatch.setenv("HOME", str(home))
+    monkeypatch.setenv("HERMES_KANBAN_WORKSPACE", str(ws))
+    assert _gate_workspace() == (None, None)
+    term = _project(tmp_path, "term", "T")
+    monkeypatch.setenv("TERMINAL_CWD", str(term))
+    assert _gate_workspace() == (str(term), None)
+
+
+def test_init_never_retargets_home_for_deleted_launch_dir(deleted_cwd, tmp_path, monkeypatch):
+    from hermes_cli import init_command
+
+    home = _project(tmp_path, "home", "H")
+    monkeypatch.setenv("HOME", str(home))
+    monkeypatch.setattr("tools.terminal_tool.get_session_cwd", lambda _key: None, raising=False)
+    with pytest.raises(FileNotFoundError):
+        init_command._resolve_session_cwd("")
