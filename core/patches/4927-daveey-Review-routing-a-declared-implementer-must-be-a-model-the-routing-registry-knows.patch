From bc12bd433213ab5939cb554dc5c4cabd009620a4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 08:03:13 +0000
Subject: [PATCH] [daveey] Review routing: a declared implementer must be a
 model the routing registry knows

Answers review 5971146857 (approve with three non-blocking points) on PR #3652.

1. Missing guard: a syntactically valid but unknown name (`claude-code`) counted as implementer evidence. It
   excluded no real route yet lifted the fail-closed refusal, so the review could run on the model that wrote the
   change. `declared_implementers(body, assignee)` now voids the whole declaration unless every name passes
   `registry_refusal` (this host's managed routing registry, for the card's assignee).
2. Tests: a valid marker followed by a malformed one is void; `claude-opus x` (prefix-only match) is void; the
   unknown-name case; and `resolve_review_model` with a real routing config picks the deep route other than the
   declared implementer.
3. Dead code: the unreachable `not names` and `is_class_selector` clauses are gone (`_MODEL_ID` refuses both).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/kanban_review_model.py             | 17 ++++++++----
 ...est_kanban_review_declared_implementers.py | 27 ++++++++++++++++++-
 2 files changed, 38 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_review_model.py b/hermes_cli/kanban_review_model.py
index 8cb8ed7d91cf1719cdfd5a98116742a18743b2b1..446a4761ddeda4f0390e17d826fdfc966eb1c463 100644
--- a/hermes_cli/kanban_review_model.py
+++ b/hermes_cli/kanban_review_model.py
@@ -15,15 +15,22 @@ _DECLARED = re.compile(r"^<!-- implementer-models: ([^>\n]*) -->$", re.MULTILINE
 _MODEL_ID = re.compile(r"[a-z0-9][a-z0-9._-]{1,79}")
 
 
-def declared_implementers(body) -> set[str]:
-    """Models a review card's body declares as the change's implementers (``_DECLARED``). A malformed entry or a
-    class selector makes the whole declaration void: it then proves nothing, as if absent."""
+def declared_implementers(body, assignee=None) -> set[str]:
+    """Models a review card's body declares as the change's implementers (``_DECLARED``). [daveey]
+
+    Void (an empty set, as if absent) when any entry on any marker line is malformed (``_MODEL_ID``: no class
+    selector, no space or slash) or is not a model this host's routing registry knows for the card's assignee
+    (``registry_refusal``): a name that excludes no real route must not lift the fail-closed refusal while the
+    review could still run on the model that wrote the change (review 5971146857)."""
     found: set[str] = set()
     for match in _DECLARED.finditer(body or ""):
         names = [name.strip() for name in match.group(1).split(",")]
-        if not names or any(not _MODEL_ID.fullmatch(name) or is_class_selector(name) for name in names):
+        if any(not _MODEL_ID.fullmatch(name) for name in names):
             return set()
         found.update(names)
+    from hermes_cli.kanban_model_tier import infer_provider
+    if any(registry_refusal(name, infer_provider(name), assignee) is not None for name in found):
+        return set()
     return found
 
 
@@ -72,7 +79,7 @@ def implementer_models(conn, task) -> set[str]:
                     models.add(model)
         if downstream:
             # Declared provenance counts as evidence of its own: the change came from outside the board.
-            models.update(declared_implementers(getattr(stored, "body", None)))
+            models.update(declared_implementers(getattr(stored, "body", None), getattr(stored, "assignee", None)))
             created = conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='created' "
                                    "ORDER BY id LIMIT 1", (card.id,)).fetchone()
             creator = _payload(created[0] if created else None).get("creator_task_id")
diff --git a/tests/hermes_cli/test_kanban_review_declared_implementers.py b/tests/hermes_cli/test_kanban_review_declared_implementers.py
index b6f95ef4aaeccb02a456b76b1338d36eed9250f6..cd32f200b5820c763e872c0e4cd41f91fd256ee5 100644
--- a/tests/hermes_cli/test_kanban_review_declared_implementers.py
+++ b/tests/hermes_cli/test_kanban_review_declared_implementers.py
@@ -33,11 +33,23 @@ TITLE = 'Independent exact-head review PR #1 @abc (core-wt ship review required)
     ('<!-- implementer-models: class:deep -->', set()),                    # a class is no implementer
     ('<!-- implementer-models: claude-opus-5-5, Bad Name -->', set()),     # one bad entry voids the declaration
     ('<!-- implementer-models:  -->', set()),
+    ('<!-- implementer-models: a-model -->\n<!-- implementer-models: Bad Name -->', set()),  # a later bad line too
+    ('<!-- implementer-models: claude-opus x -->', set()),                                  # the whole entry must match
 ])
-def test_declared_implementers(body, expected):
+def test_declared_implementers(body, expected, monkeypatch):
+    monkeypatch.setattr(review, 'registry_refusal', lambda *a: None)  # every well-formed name is registered here
     assert review.declared_implementers(body) == expected
 
 
+def test_a_name_the_routing_registry_does_not_know_voids_the_declaration(monkeypatch):
+    """Review 5971146857: ``claude-code`` excludes no real route, so it must not count as implementer evidence."""
+    known = {'claude-opus-5-5', 'claude-fable-5-2'}
+    monkeypatch.setattr(review, 'registry_refusal', lambda model, provider, assignee: None if model in known else 'no')
+    assert review.declared_implementers('<!-- implementer-models: claude-opus-5-5 -->') == {'claude-opus-5-5'}
+    assert review.declared_implementers('<!-- implementer-models: claude-code -->') == set()
+    assert review.declared_implementers('<!-- implementer-models: claude-opus-5-5, claude-code -->') == set()
+
+
 def _review(conn, body):
     tid = kb.create_task(conn, title=TITLE, assignee='a', body=body)
     conn.commit()
@@ -73,3 +85,16 @@ def test_a_declaration_on_a_card_that_is_not_a_review_is_ignored(board):
                              body=f'<!-- implementer-models: {OPUS} -->')
         conn.commit()
         assert review.implementer_models(conn, kb.get_task(conn, tid)) == set()
+
+
+def test_the_reviewer_is_never_a_declared_implementer(board):
+    """Through ``resolve_review_model`` with a real routing config (deep routes opus and fable, strong opus): the
+    declared implementer opus is excluded, so fable reviews."""
+    from tests.hermes_cli import test_kanban_review_model as routing
+    cfg = routing.config(board)
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title=TITLE, assignee='default', body=f'<!-- implementer-models: {routing.OPUS} -->')
+        conn.commit()
+        task = kb.get_task(conn, tid)
+        assert review.implementer_models(conn, task) == {routing.OPUS}
+        assert review.resolve_review_model(conn, task, cfg)[0] == routing.FABLE
