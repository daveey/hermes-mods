+def test_url_opener_command_forwards_new_window_flag():
+    argv = top_level_env.url_opener_command("http://x/", new=2)
+    assert argv[-2:] == ["http://x/", "2"]
+    assert top_level_env.url_opener_command("http://x/")[-2:] == ["http://x/", "0"]
