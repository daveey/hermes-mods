 import re
 import sqlite3
 from typing import Any
@@ -63,3 +64,42 @@ def _add_card_details(conn: sqlite3.Connection, found: dict[str, dict[str, Any]]
     for task_id, (_, url) in prs.items():
         found[task_id]["pr_url"] = url
