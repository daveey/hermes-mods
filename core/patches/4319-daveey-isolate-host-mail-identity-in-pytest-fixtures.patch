From 2d098616a9afc57a5ead9f9fa1e3a01f1ed770e4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:47:38 +0000
Subject: [PATCH] [daveey] isolate host mail identity in pytest fixtures

The hub claim-deny suite read ~/.config/hermes-mail/config.json through capability_registry.self_gateway despite isolated HERMES_HOME and hub replica. That selected creation-time worker_queue placement before claim screening: 15/21 tests failed only on hub. Redirect HERMES_MAIL_CONFIG per test, preserving HOME and all existing assertions. Regression poisons both default-home and explicit-env mail identities before exercising the real hermetic fixture: 2 failures before, 2 passes after. Hub controlled A/B: 6 pass/15 fail before; 21 pass after only the redirect. Worker-1: 93 focused tests pass. scripts/check: all 20 checks pass.
---
 tests/conftest.py                    | 10 +++++-----
 tests/test_hermetic_mail_identity.py | 30 ++++++++++++++++++++++++++++
 2 files changed, 35 insertions(+), 5 deletions(-)
 create mode 100644 tests/test_hermetic_mail_identity.py

diff --git a/tests/conftest.py b/tests/conftest.py
index 8f355e380b..51be2fec4f 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -335,12 +335,12 @@ def _hermetic_environment(tmp_path, tmp_path_factory, monkeypatch):
     # The hermes-hub replica (hub.db) lives under HOME, which stays real: point readers (kanban_create's overlap
     # check, wait replicas) at an empty per-test dir so the host's live cards never leak into a test. [daveey]
     monkeypatch.setenv("HERMES_HUB_STATE", str(tmp_path / "hermes-hub-state"))
+    # self_gateway reads mail identity before the replica; HOME deliberately stays real.
+    # Redirect rather than delete: absence falls back to ~/.config/hermes-mail/config.json.
+    monkeypatch.setenv("HERMES_MAIL_CONFIG", str(tmp_path / "hermes-mail.json"))
 
-    # 3. Isolate both inputs to profile/root resolution. HERMES_HOME alone
-    #    is insufficient: get_default_hermes_root() resolves the native root
-    #    too, to distinguish standard profiles from custom deployments.
-    #    Patch only the Hermes default, not HOME/Path.home(). Subprocesses need
-    #    a stable HOME. Hardcoded real-home I/O must still trip the guard.
+    # 3. Isolate HERMES_HOME and the native root used to distinguish profiles/custom deployments.
+    # Keep HOME/Path.home() stable for subprocesses; hardcoded real-home I/O must still trip the guard.
     import hermes_constants
 
     platform_default = hermes_constants._get_platform_default_hermes_home
diff --git a/tests/test_hermetic_mail_identity.py b/tests/test_hermetic_mail_identity.py
new file mode 100644
index 0000000000..ef99dc22e5
--- /dev/null
+++ b/tests/test_hermetic_mail_identity.py
@@ -0,0 +1,30 @@
+"""Host mail identity must not pre-place synthetic admission cards. [daveey]"""
+if not __name__.startswith("tests."): raise ImportError("Use scripts/run_tests.sh; unittest discovery bypasses test isolation")  # unittest-discovery guard
+
+import json
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_capability_registry as registry
+from tests import conftest
+
+
+@pytest.mark.parametrize("source", ["default", "environment"])
+def test_hermetic_environment_hides_host_mail_identity(tmp_path, tmp_path_factory, monkeypatch, source):
+    host = tmp_path / "host"
+    config = host / ".config" / "hermes-mail" / "config.json"
+    config.parent.mkdir(parents=True)
+    config.write_text(json.dumps({"gateway": "hub"}), encoding="utf-8")
+    monkeypatch.setattr(Path, "home", classmethod(lambda cls: host))
+    if source == "environment":
+        monkeypatch.setenv("HERMES_MAIL_CONFIG", str(config))
+    else:
+        monkeypatch.delenv("HERMES_MAIL_CONFIG", raising=False)
+    assert registry.self_gateway() == "hub"  # the actual production reader sees the poison
+
+    sandbox = tmp_path / "nested"
+    sandbox.mkdir()
+    with pytest.MonkeyPatch.context() as isolated:
+        conftest._hermetic_environment.__wrapped__(sandbox, tmp_path_factory, isolated)
+        assert registry.self_gateway() is None
