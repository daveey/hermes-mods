diff --git a/hermes_state_update_pause.py b/hermes_state_update_pause.py
index c21ca7d985..a82e23a72f 100644
--- a/hermes_state_update_pause.py
+++ b/hermes_state_update_pause.py
@@ -111,6 +111,46 @@ def _valid_checkpoint(conn, row):
         return None
 
 
+def parked_update_turn(conn, session_ids):
+    """[daveey] t_01a1d6f94ac774a2: the admission id of a started turn parked by an update checkpoint
+    whose conversation covers any of ``session_ids``, else None.
+
+    A receipt proves its turn by "no row after the tool suffix", so a row a passive writer (a Kanban or
+    completion notice) appends while the turn is parked voids it and the turn is dropped on resume. A
+    parked turn holds no turn lease, so passive writers ask this instead. Receipt validity is not judged
+    here: an unreadable receipt still fences its logical target until resume or recovery settles it."""
+    wanted = {sid for sid in session_ids if sid}
+    end = CHECKPOINT_PREFIX[:-1] + chr(ord(CHECKPOINT_PREFIX[-1]) + 1)
+    for key, value in conn.execute('SELECT key,value FROM state_meta WHERE key>=? AND key<?',
+                                   (CHECKPOINT_PREFIX, end)).fetchall():
+        admission_id = key[len(CHECKPOINT_PREFIX):]
+        row = conn.execute("SELECT target_session_id FROM session_admissions WHERE admission_id=? "
+                           "AND status='started'", (admission_id,)).fetchone()
+        if row is None:
+            continue
+        bound = {row[0]}
+        try:
+            receipt = json.loads(value) if isinstance(value, str) and len(value) <= MAX_RECEIPT_BYTES else None
+        except (ValueError, RecursionError):
+            receipt = None
+        if isinstance(receipt, dict):
+            chain = receipt.get('physical_chain')
+            bound.update(s for s in [receipt.get('physical_session_id'), *(chain if isinstance(chain, list) else ())]
+                         if isinstance(s, str))
+        if wanted & bound:
+            return admission_id
+    return None
+
+
+def refuse_parked_write(conn, session_id, conversation_id):
+    """A passive (lease-less) transcript write's in-transaction guard: the same retryable "busy" refusal a
+    live turn lease gives, so callers rewind and retry after the parked turn resumes or is settled."""
+    from hermes_state_errors import SessionTurnLeaseLostError
+    if parked_update_turn(conn, (session_id, conversation_id)) is not None:
+        raise SessionTurnLeaseLostError(
+            f'Session has a turn parked for an update; refusing transcript mutation for {session_id!r}')
+
+
 def delete_session_checkpoint(conn, admission_id):
     """Same-transaction cleanup; never deletes unrelated state_meta receipts."""
     conn.execute('DELETE FROM state_meta WHERE key=?', (CHECKPOINT_PREFIX + admission_id,))
diff --git a/tests/gateway/test_parked_automation_fence_settles.py b/tests/gateway/test_parked_automation_fence_settles.py
new file mode 100644
index 0000000000..88a35f78ab
--- /dev/null
+++ b/tests/gateway/test_parked_automation_fence_settles.py
@@ -0,0 +1,115 @@
+"""t_01a1d6f94ac774a2: a parked automation turn whose proof dies under the drain must not stall its chat.
+
+laptop-1 2026-11-13 12:13: boot recovery kept a valid checkpoint for a parked Kanban-notice batch, a
+passive notice row landed (12:13:06) before the drain resumed it (12:13:15), the resume refused
+``invalid_checkpoint``, and ``refuse_checkpoint`` fenced the head ``unknown`` and PAUSED the FIFO. GW-10
+settles an unattended unknown, but only at boot or on a later claim, so every turn was refused for
+1 h 45 min until the next gateway boot. Now (a) the passive writer is refused while the turn is parked,
+so the turn resumes, and (b) a head fenced by the drain still settles when nobody waits on it.
+"""
+import logging
+
+import pytest
+
+from gateway.session_authority import LiveSession, SessionAuthority
+from hermes_state_errors import SessionTurnLeaseLostError
+from hermes_state_runtime import (admit_session_input, begin_runtime_epoch, get_session_admission,
+                                  recover_session_inputs)
+from hermes_state_update_pause import get_session_checkpoint
+from tests.gateway.test_authority_update_pause import parked_fixture
+from tests.gateway.test_session_authority_cancel_settlement import REF
+
+AUTOMATION = {'text': 'kanban batch', 'local_automation_v1': {'identity': 'kanban-batch-1', 'owner': 's'}}
+PERSON = {'text': 'kanban batch'}
+
+
+async def _after_boot(tmp_path, monkeypatch, payload):
+    """Owner 1 parks the head and queues a follower; owner 2 boots and recovers (checkpoint kept)."""
+    from gateway import session_finite
+    from gateway.session_unattended_unknown import settle_recovered_unattended
+    from hermes_cli import admission_fence
+    db, old, head = parked_fixture(tmp_path, monkeypatch, payload=payload)
+    follower = admit_session_input(db, epoch=old.epoch, principal_id='human', session_id='s',
+                                   request_id='follower', payload={'text': 'FOLLOWER'})
+    epoch = begin_runtime_epoch(db, instance_id='after-update')
+    assert recover_session_inputs(db, epoch=epoch) == 0
+    assert settle_recovered_unattended(db, epoch) == 0
+    assert get_session_checkpoint(db, session_id='s') is not None
+    owner = SessionAuthority(old.runner, profile_id='owned', instance_id='after-update', db=db, epoch=epoch)
+    owner.sessions['s'] = LiveSession(old.sessions['s'].source, 'route')
+    calls = []
+
+    async def execute(authority, ref, row):
+        calls.append('resumed' if row.get('update_resume') else row['payload']['text'])
+        return calls[-1]
+    monkeypatch.setattr(session_finite, 'execute_finite_admission', execute)
+    monkeypatch.setattr(admission_fence, 'is_held', lambda root: False)
+    return db, owner, head, follower, calls
+
+
+async def _drain(owner):
+    import asyncio
+    owner._schedule(REF)
+    await asyncio.wait_for(owner.sessions['s'].task, 10)
+
+
+def _status(db, admission):
+    row = get_session_admission(db, admission_id=admission['admission_id'])
+    return row['status'], row['outcome']
+
+
+@pytest.mark.asyncio
+async def test_notice_between_boot_recovery_and_resume_is_deferred_and_turn_resumes(tmp_path, monkeypatch):
+    """Race regression (acceptance 3): the notice arrives in the window and must not stop the chat."""
+    db, owner, head, follower, calls = await _after_boot(tmp_path, monkeypatch, AUTOMATION)
+    with db:
+        metadata = {'notice_id': 'default:t_x:0-1', 'kanban_event_keys': ['default:1']}
+        with pytest.raises(SessionTurnLeaseLostError):
+            db.append_kanban_notice('s', 'card t_x done', metadata)
+        await _drain(owner)
+        assert calls == ['resumed', 'FOLLOWER']
+        assert _status(db, head) == ('terminal', 'completed')
+        assert _status(db, follower) == ('terminal', 'completed')
+        # The deferred notice is delivered on its next pass, after the resumed turn.
+        assert db.append_kanban_notice('s', 'card t_x done', metadata) > 0
+
+
+@pytest.mark.asyncio
+async def test_drain_fenced_automation_head_settles_and_follower_runs_in_same_drain(tmp_path, monkeypatch, caplog):
+    """Acceptance 2: a proof voided after boot recovery (any writer) fences the automation head; GW-10 settles
+    it and the same drain runs the queued follower, with no pause."""
+    db, owner, head, follower, calls = await _after_boot(tmp_path, monkeypatch, AUTOMATION)
+    with db:
+        db.append_message('s', 'user', 'a row an unguarded writer appended')  # voids the proof
+        assert get_session_checkpoint(db, session_id='s') is None
+        with caplog.at_level(logging.INFO, logger='gateway.session_authority'):
+            await _drain(owner)
+        assert calls == ['FOLLOWER']
+        assert _status(db, head) == ('terminal', 'interrupted')
+        assert _status(db, follower) == ('terminal', 'completed')
+        assert not [r for r in caplog.records if 'paused' in r.getMessage()]
+
+
+@pytest.mark.asyncio
+async def test_drain_fenced_persons_head_still_pauses_and_says_so(tmp_path, monkeypatch, caplog):
+    db, owner, head, follower, calls = await _after_boot(tmp_path, monkeypatch, PERSON)
+    with db:
+        db.append_message('s', 'user', 'a row an unguarded writer appended')
+        with caplog.at_level(logging.INFO, logger='gateway.session_authority'):
+            await _drain(owner)
+        assert calls == []
+        assert _status(db, head) == ('unknown', None)
+        assert _status(db, follower) == ('queued', None)
+        paused = [r for r in caplog.records if r.getMessage() == 'Session s paused: unknown_execution']
+        assert paused and paused[0].levelno == logging.WARNING
+
+
+@pytest.mark.parametrize('reason,level', [('session_busy', logging.INFO), ('runtime_draining', logging.INFO),
+                                          ('unknown_execution', logging.WARNING),
+                                          ('admission_conflict', logging.WARNING)])
+def test_every_pause_is_logged(tmp_path, monkeypatch, caplog, reason, level):
+    from tests.gateway.test_session_authority_cancel_settlement import _authority
+    db, owner = _authority(tmp_path, monkeypatch)
+    with db, caplog.at_level(logging.INFO, logger='gateway.session_authority'):
+        owner._pause(REF, reason)
+    assert [(r.getMessage(), r.levelno) for r in caplog.records] == [(f'Session s paused: {reason}', level)]
diff --git a/tests/hermes_state/test_parked_turn_passive_writes.py b/tests/hermes_state/test_parked_turn_passive_writes.py
new file mode 100644
index 0000000000..f104ef9940
--- /dev/null
+++ b/tests/hermes_state/test_parked_turn_passive_writes.py
@@ -0,0 +1,154 @@
+"""t_01a1d6f94ac774a2: a passive row may not land in a chat whose turn is parked for an update.
+
+The update checkpoint proves its parked turn by "nothing was written after its tool suffix". A
+parked turn holds no turn lease, so passive writers (Kanban notices, completion notes, detached
+results, legacy prompt rows) used to append freely and void the proof: the turn was dropped on
+resume (7 of 7 on laptop-1 2026-11-13). Each passive path now gets the same retryable "busy"
+refusal a live turn gives, the checkpoint stays valid, and the deferred row lands after the resume.
+"""
+import json
+
+import pytest
+
+import hermes_state_runtime as rt
+from hermes_state import SessionDB
+from hermes_state_errors import SessionTurnLeaseLostError
+
+
+@pytest.fixture
+def parked(tmp_path):
+    from hermes_state_update_pause import checkpoint_session_input
+    with SessionDB(tmp_path / 'state.db') as db:
+        db.create_session('s', source='test')
+        db.create_session('other', source='test')
+        epoch = rt.begin_runtime_epoch(db, instance_id='first')
+        rt.admit_session_input(db, epoch=epoch, principal_id='automation:kanban', session_id='s',
+                               request_id='one', payload={'text': 'notice batch'})
+        row = rt.claim_session_input(db, epoch=epoch, session_id='s')
+        db.append_messages_batch('s', [
+            {'role': 'user', 'content': 'notice batch'},
+            {'role': 'assistant', 'content': '', 'tool_calls': [
+                {'id': 'call-a', 'type': 'function', 'function': {'name': 'example', 'arguments': '{}'}}]},
+            {'role': 'tool', 'content': 'done', 'tool_call_id': 'call-a', 'tool_name': 'example'},
+        ])
+        checkpoint_session_input(db, epoch=epoch, admission_id=row['admission_id'], generation=row['generation'],
+                                 physical_session_id='s', transcript_mark=row['transcript_mark'])
+        yield db, epoch, row
+
+
+def _kanban_notice(db, sid, n=1):
+    return db.append_kanban_notice(sid, f'card {n} done', {'notice_id': f'default:t_{n}:0-1',
+                                                          'kanban_event_keys': [f'default:{n}']})
+
+
+def _record_kanban_notice(db, sid, n=2):
+    return db.record_kanban_notice(sid, f'card {n} done', {'notice_id': f'default:t_{n}:0-1'})[0]
+
+
+def _completion_note(db, sid):
+    return db.append_completion_note(sid, 'adm-x', 'process finished', 'completion_note', {})
+
+
+def _delegation(db, sid):
+    return db.append_delegation_delivery(sid, 'delegate answered', {'delegation_id': 'd-1'})
+
+
+def _legacy_prompt(db, sid):
+    from hermes_state_prompt_admission import admit_prompt, prompt_digest
+    return admit_prompt(db, sid, 'op-1', 'typed while parked', prompt_digest(sid, 'typed while parked'))
+
+
+PASSIVE = {'append_kanban_notice': _kanban_notice, 'record_kanban_notice': _record_kanban_notice,
+           'append_completion_note': _completion_note, 'append_delegation_delivery': _delegation,
+           'admit_prompt': _legacy_prompt}
+
+
+@pytest.mark.parametrize('write', PASSIVE.values(), ids=PASSIVE.keys())
+def test_passive_write_defers_and_parked_turn_resumes_then_row_lands(parked, write):
+    from hermes_state_update_pause import get_session_checkpoint, resume_session_checkpoint
+    db, epoch, row = parked
+    before = db.get_messages('s')
+    with pytest.raises(SessionTurnLeaseLostError, match='parked for an update'):
+        write(db, 's')
+    assert db.get_messages('s') == before
+    assert get_session_checkpoint(db, session_id='s') is not None, 'the refused write must not void the proof'
+    # A new owner (the post-update gateway) keeps the valid checkpoint and resumes it.
+    epoch = rt.begin_runtime_epoch(db, instance_id='second')
+    assert rt.recover_session_inputs(db, epoch=epoch) == 0
+    resumed = resume_session_checkpoint(db, epoch=epoch, admission_id=row['admission_id'])
+    assert resumed['update_resume']['admission_id'] == row['admission_id']
+    # The retried passive row is delivered once the turn is no longer parked.
+    write(db, 's')
+    assert len(db.get_messages('s')) == len(before) + 1
+
+
+def test_destructive_user_rewrite_is_refused_while_parked(parked):
+    from hermes_state_update_pause import get_session_checkpoint
+    db, _, _ = parked
+    with pytest.raises(SessionTurnLeaseLostError):
+        db.replace_messages('s', [{'role': 'user', 'content': 'rewritten'}], active_only=True,
+                            reject_active_turn_lease=True)
+    assert get_session_checkpoint(db, session_id='s') is not None
+
+
+def test_other_chats_and_unparked_turns_still_take_passive_rows(parked):
+    from hermes_state_update_pause import CHECKPOINT_PREFIX
+    db, _, row = parked
+    assert _kanban_notice(db, 'other') > 0  # a different conversation is not parked
+    # A fenced (unknown) head is no longer parked: its receipt is gone, the chat takes rows again.
+    db._execute_write(lambda c: c.execute('DELETE FROM state_meta WHERE key=?', (CHECKPOINT_PREFIX + row['admission_id'],)))
+    assert _kanban_notice(db, 's') > 0
+
+
+def test_settled_admission_with_leftover_receipt_does_not_fence(parked):
+    db, _, row = parked
+    db._execute_write(lambda c: c.execute("UPDATE session_admissions SET status='terminal',outcome='interrupted' "
+                                          "WHERE admission_id=?", (row['admission_id'],)))
+    assert _kanban_notice(db, 's') > 0
+
+
+def test_live_turn_owner_write_is_not_refused(parked):
+    """Only writers without the turn lease are passive: the lease holder's own rows are not fenced here."""
+    db, _, _ = parked
+    db._execute_write(lambda c: c.execute(
+        "INSERT INTO session_turn_leases(conversation_id, holder, acquired_at, expires_at) "
+        "VALUES('s','resumed',0,?)", (2e10,)))
