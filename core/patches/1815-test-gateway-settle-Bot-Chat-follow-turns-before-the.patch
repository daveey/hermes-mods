From fdc396c03a63f022c263b56ab48479d279221fe7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 05:02:08 +0000
Subject: [PATCH] test(gateway): settle Bot Chat follow turns before the next
 mutation

_turn returned as soon as the handler recorded its agent build, before the drain
committed the turn's settlement. On a throttled runner a session.mutate issued
right after raced that commit: a pick read a stale runtime revision (error reply,
KeyError 'result') or arrived while the turn lease was still live (deferred pick,
cold build on the old exact pin). Wait for the admission to reach 'terminal'.

Deflakes test_follow_after_explicit_pick_consumed_by_another_build.
---
 tests/gateway/test_bot_chat_follow_entry.py | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/tests/gateway/test_bot_chat_follow_entry.py b/tests/gateway/test_bot_chat_follow_entry.py
index 6b4adbdfe4b..89277f64b57 100644
--- a/tests/gateway/test_bot_chat_follow_entry.py
+++ b/tests/gateway/test_bot_chat_follow_entry.py
@@ -67,10 +67,17 @@ def _in_process_handler(built):
 
 
 async def _turn(authority, owner, ref, built, rid):
+    """One turn, returned only once it has SETTLED: the handler records its build before it returns, and
+    the drain then commits the turn's settlement (lease release, runtime revision). A caller that mutates
+    the session right after must not race that commit (a deferred pick or a revision conflict)."""
     from gateway.session_contract import Submission
+    from hermes_state_runtime import get_session_admission
     count = len(built)
-    await authority.submit(owner.actor, Submission(rid, ref, {'text': rid}, 'queue'))
+    receipt = await authority.submit(owner.actor, Submission(rid, ref, {'text': rid}, 'queue'))
     await async_wait_until(lambda: len(built) > count, timeout=30, what=f'turn {rid}')
+    await async_wait_until(
+        lambda: (get_session_admission(authority.db, admission_id=receipt.admission_id) or {}).get('status') == 'terminal',
+        timeout=30, what=f'turn {rid} settled')
     return built[-1]
 
 
