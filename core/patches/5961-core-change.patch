Subject: [PATCH 5961] Fact change feed: bounded failure logging and busy-open tolerance

Public mirror of source commit 4c3da8fdeab55c28de2be75ae2577bd3c8ba62c6.

---
diff --git a/hermes_cli/fact_capture.py b/hermes_cli/fact_capture.py
index 7daf4b2b268..0f5177bf619 100644
--- a/hermes_cli/fact_capture.py
+++ b/hermes_cli/fact_capture.py
@@ -99,7 +99,10 @@
     path = Path(path).resolve()
     ensure_kanban_test_isolation(path)
     initial = path.stat()
-    with closing(open_ro(path, timeout=0)) as conn:
+    # Spend up to this capture's own time budget waiting out a busy open: the
+    # tracking registry is held only briefly per open, and timeout=0 failed
+    # nearly every first capture on a busy host (one retry ~0.1 s later each).
+    with closing(open_ro(path, timeout=budget.max_seconds)) as conn:
         # SQLite refuses oversized rows before Python allocates their values.
         conn.setlimit(sqlite3.SQLITE_LIMIT_LENGTH, budget.max_bytes)
         before = _identity(path)
diff --git a/hermes_cli/fact_feed.py b/hermes_cli/fact_feed.py
index 119ddc6c98a..7937e0da940 100644
--- a/hermes_cli/fact_feed.py
+++ b/hermes_cli/fact_feed.py
@@ -180,7 +180,10 @@
                 source.traced.add(("capture", type(exc)))
                 log.exception("source capture/publication failed (attempt %d); retaining cursor", attempt)
             else:
-                log.log(logging.WARNING if _visible(attempt) else logging.DEBUG,
+                # A single busy retry is routine contention, not news: warn once
+                # it persists (max backoff, then every _REMIND_EVERY attempts).
+                warn = _visible(attempt) and not (busy and attempt == 1)
+                log.log(logging.WARNING if warn else logging.DEBUG,
                         "source capture/publication failed (attempt %d%s); retaining cursor: %s",
                         attempt, ", busy" if busy else "", exc)
             with source.publication:
diff --git a/tests/hermes_cli/test_fact_capture.py b/tests/hermes_cli/test_fact_capture.py
index 8ded10dfa28..849f7e19099 100644
--- a/tests/hermes_cli/test_fact_capture.py
+++ b/tests/hermes_cli/test_fact_capture.py
@@ -178,3 +178,34 @@
         capture_tasks(path, None, slow)
     with pytest.raises(sqlite3.ProgrammingError):
         borrowed[0].execute("SELECT 1")
+
+
+def test_briefly_held_tracking_registry_does_not_fail_capture(board, monkeypatch):
+    """A capture waits out a momentary registry holder within its own budget.
+
+    With timeout=0 every first capture on a busy hub failed with "tracking
+    registry is busy" and only succeeded on the feed's retry ~0.1 s later."""
+    import threading
+    from hermes_cli import fact_capture as capture
+    from hermes_cli import sqlite_safe_read
+
+    path, writer = board
+    kb.create_task(writer, title="a", assignee="w")
+    monkeypatch.setattr(capture, "time", time)  # real clock: this test is about waiting
+    held, release = threading.Event(), threading.Event()
+
+    def holder():
+        with sqlite_safe_read._live_lock:
+            held.set()
+            release.wait(2)
+
+    thread = threading.Thread(target=holder)
+    thread.start()
+    assert held.wait(2)
+    threading.Timer(0.005, release.set).start()
+    try:
+        result = capture_tasks(path, None, rows, budget=CaptureBudget(max_seconds=0.5))
+    finally:
+        release.set()
+        thread.join(2)
+    assert result.after is not None
