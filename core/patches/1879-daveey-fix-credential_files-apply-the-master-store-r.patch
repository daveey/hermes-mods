From 7b1217bdee607fb2ec743f063a527d5f88e55898 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 12:26:08 +0000
Subject: [PATCH] [daveey] fix(credential_files): apply the master-store read
 deny-list to terminal.credential_files config entries

The config route (_load_config_files) checked only HERMES_HOME containment,
so terminal.credential_files: ['.env'] bind-mounted the master key file
read-only into non-capsule docker sandboxes while register_credential_file
refused the same path. Both routes now share _is_read_denied (fail-closed:
missing or raising guard refuses the mount); denied config entries are
logged and skipped, the rest of the list still mounts.

Proof: 9 new tests red before, green after (.env, auth.json and the other
deny-listed stores yield no mount; non-store file still mounts; guard
missing/raising fails closed). Mutation dropping the config-route check
re-reds all 9. 249 tests across credential_files + docker/modal/daytona/
vercel/file_sync/capsule suites pass.
---
 tests/tools/test_credential_files.py | 80 ++++++++++++++++++++++++++++
 tools/credential_files.py            | 48 ++++++++++-------
 2 files changed, 109 insertions(+), 19 deletions(-)

diff --git a/tests/tools/test_credential_files.py b/tests/tools/test_credential_files.py
index 454aede54bb..36f14393d96 100644
--- a/tests/tools/test_credential_files.py
+++ b/tests/tools/test_credential_files.py
@@ -727,3 +727,83 @@ class TestMasterCredentialStoresAreNeverMountable:
             assert cf.get_credential_file_mounts() == []
         rec = next(r for r in caplog.records if "read guard raised" in r.message)
         assert rec.exc_info is not None, "traceback must be attached (logger.exception)"
+
+
+class TestConfigCredentialFilesHonorReadDenyList:
+    """``terminal.credential_files`` in config.yaml is a second mount route.
+
+    It used to check only HERMES_HOME containment, so ``credential_files:
+    [".env"]`` bind-mounted the master key file into every docker sandbox
+    while ``register_credential_file(".env")`` refused the same file. Both
+    routes must apply the same fail-closed read deny-list.
+    """
+
+    _home = staticmethod(TestMasterCredentialStoresAreNeverMountable._home)
+
+    @staticmethod
+    def _write_config(home: Path, cred_files: list):
+        import hermes_yaml as yaml
+        (home / "config.yaml").write_text(
+            yaml.safe_dump({"terminal": {"credential_files": cred_files}}))
+
+    @pytest.mark.parametrize(
+        "rel_path",
+        [
+            ".env",
+            "auth.json",
+            ".anthropic_oauth.json",
+            "webhook_subscriptions.json",
+            "cache/bws_cache.json",
+            "mcp-tokens/srv.json",
+        ],
+    )
+    def test_config_master_store_yields_no_mount(self, tmp_path, rel_path, caplog):
+        home = self._home(tmp_path)
+        self._write_config(home, [rel_path])
+        with patch.dict(os.environ, {"HERMES_HOME": str(home)}):
+            with caplog.at_level("WARNING", logger="tools.credential_files"):
+                mounts = get_credential_file_mounts()
+        assert mounts == [], f"config {rel_path} would be bind-mounted into the sandbox"
+        assert any("refused" in r.message and rel_path in r.message
+                   for r in caplog.records), "a denied config entry is logged"
+
+    def test_config_non_store_file_still_mounts(self, tmp_path):
+        home = self._home(tmp_path)
+        self._write_config(home, ["google_token.json"])
+        with patch.dict(os.environ, {"HERMES_HOME": str(home)}):
+            mounts = get_credential_file_mounts()
+        assert mounts == [{"host_path": str((home / "google_token.json").resolve()),
+                           "container_path": "/root/.hermes/google_token.json"}]
+
+    def test_config_denied_entry_is_skipped_not_fatal(self, tmp_path):
+        home = self._home(tmp_path)
+        self._write_config(home, [".env", "google_token.json", "auth.json"])
+        with patch.dict(os.environ, {"HERMES_HOME": str(home)}):
+            paths = [m["container_path"] for m in get_credential_file_mounts()]
+        assert paths == ["/root/.hermes/google_token.json"]
+
+    def test_config_missing_guard_fails_closed(self, tmp_path, caplog):
+        import tools.credential_files as cf
+
+        home = self._home(tmp_path)
+        self._write_config(home, ["google_token.json"])
+        with patch.dict(os.environ, {"HERMES_HOME": str(home)}), \
+                patch.object(cf, "get_read_block_error", None):
+            with caplog.at_level("ERROR", logger="tools.credential_files"):
+                assert cf.get_credential_file_mounts() == []
+        assert any("deny-list cannot be consulted" in r.message for r in caplog.records)
+
+    def test_config_guard_exception_fails_closed(self, tmp_path, caplog):
+        import tools.credential_files as cf
+
+        def _boom(path):
+            raise RuntimeError("guard exploded")
+
+        home = self._home(tmp_path)
+        self._write_config(home, ["google_token.json"])
+        with patch.dict(os.environ, {"HERMES_HOME": str(home)}), \
+                patch.object(cf, "get_read_block_error", _boom):
+            with caplog.at_level("ERROR", logger="tools.credential_files"):
+                assert cf.get_credential_file_mounts() == []
+        rec = next(r for r in caplog.records if "read guard raised" in r.message)
+        assert rec.exc_info is not None
diff --git a/tools/credential_files.py b/tools/credential_files.py
index f5431576c24..34630776aac 100644
--- a/tools/credential_files.py
+++ b/tools/credential_files.py
@@ -63,6 +63,32 @@ def _contained_host_path(rel: str, hermes_home: Path, abs_msg: str, traversal_ms
     return host_path.resolve()
 
 
+def _is_read_denied(resolved: Path, rel: str) -> bool:
+    """True (logged) when *resolved* must not be mounted: a master store on the read deny-list.
+
+    Master credential stores are never mountable, even though they sit inside HERMES_HOME and therefore
+    pass the containment check. Shared by the skill route and the ``terminal.credential_files`` config
+    route so neither can mount what the read surface denies. Fails CLOSED: if the canonical guard can't
+    be consulted the mount is refused rather than risk bind-mounting auth.json into a sandbox. The
+    sentinel + logger.exception keep guard failures debuggable instead of silently swallowed (#67665).
+    """
+    if get_read_block_error is None:
+        logger.error("credential_files: refusing %r — agent.file_safety could not be "
+                     "imported, so the master-store deny-list cannot be consulted", rel)
+        return True
+    try:
+        denied = get_read_block_error(str(resolved))
+    except Exception:
+        logger.exception("credential_files: refusing %r — read guard raised", rel)
+        return True
+    if denied:
+        logger.warning("credential_files: refused %r — it is a credential store the agent "
+                       "is denied from reading; mount a per-service token, "
+                       "not the master key files", rel)
+        return True
+    return False
+
+
 def register_credential_file(relative_path: str, container_base: str = "/root/.hermes") -> bool:
     """Register a HERMES_HOME-relative credential file for mounting; True if it exists and was registered.
 
@@ -80,24 +106,7 @@ def register_credential_file(relative_path: str, container_base: str = "/root/.h
     if not resolved.is_file():
         logger.debug("credential_files: skipping %s (not found)", resolved)
         return False
-    # Master credential stores are never mountable, even though they sit inside HERMES_HOME and therefore
-    # pass the containment check above. Fails CLOSED: if the canonical guard can't be consulted we refuse
-    # the mount rather than risk bind-mounting auth.json into a sandbox. The import lives at module top (no
-    # circular-import concern — file_safety is stdlib-only); the sentinel + logger.exception keep guard
-    # failures debuggable instead of silently swallowed (#67665).
-    if get_read_block_error is None:
-        logger.error("credential_files: refusing %r — agent.file_safety could not be "
-                     "imported, so the master-store deny-list cannot be consulted", relative_path)
-        return False
-    try:
-        denied = get_read_block_error(str(resolved))
-    except Exception:
-        logger.exception("credential_files: refusing %r — read guard raised", relative_path)
-        return False
-    if denied:
-        logger.warning("credential_files: refused %r — it is a credential store the agent "
-                       "is denied from reading; a skill may mount its own service token, "
-                       "not the master key files", relative_path)
+    if _is_read_denied(resolved, relative_path):
         return False
 
     container_path = f"{container_base.rstrip('/')}/{relative_path}"
@@ -143,7 +152,8 @@ def _load_config_files() -> list[dict[str, str]]:
                 rel, hermes_home,
                 "credential_files: rejected absolute config path %r",
                 "credential_files: rejected config path traversal %r (%s)")
-            if resolved_path is not None and resolved_path.is_file():
+            if (resolved_path is not None and resolved_path.is_file()
+                    and not _is_read_denied(resolved_path, rel)):
                 result.append(_mount(resolved_path, f"/root/.hermes/{rel}"))
     except Exception as e:
         logger.warning("Could not read terminal.credential_files from config: %s", e)
