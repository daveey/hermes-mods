Subject: [PATCH 6061] Serve producer isolation (dormant panel producer and admission)

Public mirror of source commit 59dbbe2466676917b7142de5de2e87c0739c8d16.

---
diff --git a/tests/hermes_cli/test_serve_producer_projection_unavailable.py b/tests/hermes_cli/test_serve_producer_projection_unavailable.py
index 50ed8daa737..18a0bb83b01 100644
--- a/tests/hermes_cli/test_serve_producer_projection_unavailable.py
+++ b/tests/hermes_cli/test_serve_producer_projection_unavailable.py
@@ -35,6 +35,8 @@
         assert actual == (False, None, 503)
         assert relay.acknowledged(other)
         assert relay.read(other) == b'{"healthy":true}'
+        # Drain the extra refresh submitted by projection_response before recovery.
+        assert wait_until(lambda: relay.pending_count == 0, timeout=10)
         # The failure revokes only this key, not the relay or another publication.
         (tmp_path / 'fail').unlink()
         assert relay.submit({'body': body, 'accepted': 3}) == key
