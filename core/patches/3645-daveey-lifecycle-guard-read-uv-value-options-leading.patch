+@pytest.mark.parametrize(
+    "template",
+    [
+        # Leading redirection: the command word comes after it.
+        "< {py} python3",
+        "<{py} python3",
+        "0< {py} python3",
+        "< {sh} bash",
+        "FOO=1 < {py} python3",
+        "> /dev/null < {sh} bash",
+        "sudo < {sh} bash",
+        "if < {sh} bash; then :; fi",
+        # Redirection glued to the command word (`<` is not a control character).
+        "python3<{py}",
+        "bash<{sh}",
+        "sudo bash<{sh}",
+        "FOO=1 python3<{py}",
+        "bash -c 'python3<{py}'",
+        # cat's own stdin is what it writes to the pipe.
+        "cat < {py} | python3",
+        "cat - < {py} | python3",
+        "< {py} cat | python3",
+        "cat < {sh} | bash",
+        # A pipe into a group feeds every command in it.
+        "cat {py} | (python3)",
+        "cat {py} |(python3)",
+        "cat {sh} | (bash)",
+        "cat {sh} | (true; bash)",
+        "cat {sh} | (true && (bash))",
+        "cat {py} | {{ python3; }}",
+        "cat {sh} | {{ true; bash; }}",
+        # `}` closes the group only in command position; `echo }` prints it.
+        "cat {sh} | {{ true; echo }}; bash; }}",
+    ],
+)
