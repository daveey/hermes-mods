From c5d426d6e72e2f6d5413c947baedda3a387e5825 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 11 Oct 2026 17:08:56 -0700
Subject: [PATCH] fix(plugins): desktop-only packages load without Python;
 provides_middleware is a known manifest field [daveey]

A package with desktop/plugin.js and no __init__.py (e.g. githermes) failed
every gateway start with 'No __init__.py'; treat it like a manifest-only
language pack. provides_middleware declares ctx.register_middleware use, like
provides_tools/provides_hooks, so v2 manifests no longer warn about it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/plugins_loader.py                  |  9 ++--
 hermes_cli/plugins_manifest.py                |  1 +
 tests/hermes_cli/test_plugins_desktop_only.py | 41 +++++++++++++++++++
 3 files changed, 47 insertions(+), 4 deletions(-)
 create mode 100644 tests/hermes_cli/test_plugins_desktop_only.py

diff --git a/hermes_cli/plugins_loader.py b/hermes_cli/plugins_loader.py
index 4d4505659c..7374c85927 100644
--- a/hermes_cli/plugins_loader.py
+++ b/hermes_cli/plugins_loader.py
@@ -546,10 +546,11 @@ class PluginLoaderMixin:
 
     @staticmethod
     def _is_manifest_only_language_pack(manifest: PluginManifest) -> bool:
-        """A ``provides_locales`` plugin with no ``__init__.py`` is complete without Python — like a
-        manifest-only desktop plugin, it loads from its declared files alone."""
-        return bool(manifest.provides_locales and manifest.path
-                    and not (Path(manifest.path) / "__init__.py").is_file())
+        """A plugin with no ``__init__.py`` that is complete without Python: a ``provides_locales`` pack
+        (loads from ``locales/``) or a desktop-only package (Electron loads ``desktop/plugin.js``)."""
+        if not manifest.path or (Path(manifest.path) / "__init__.py").is_file():
+            return False
+        return bool(manifest.provides_locales) or (Path(manifest.path) / "desktop" / "plugin.js").is_file()
 
     def _register_declared_locales(self, manifest: PluginManifest, ctx) -> None:
         """``provides_locales`` -> ``ctx.register_locale_dir(<plugin>/locales)``; a declared id with no file
diff --git a/hermes_cli/plugins_manifest.py b/hermes_cli/plugins_manifest.py
index 576ba20e54..e0343ed4b1 100644
--- a/hermes_cli/plugins_manifest.py
+++ b/hermes_cli/plugins_manifest.py
@@ -31,6 +31,7 @@ _VALID_PLUGIN_KINDS: set[str] = {"standalone", "backend", "exclusive", "platform
 # ── Manifest v2 (#64165) parsing helpers ──────────────────────────────────
 _KNOWN_MANIFEST_FIELDS: set[str] = {
     "name", "version", "description", "author", "requires_env", "provides_tools", "provides_hooks",
+    "provides_middleware",
     "kind", "hooks", "label", "optional_env", "platforms", "external_dependencies",
     "pip_dependencies", "provides_browser_providers", "provides_web_providers",
     "manifest_version", "api_version", "requires_plugins", "python_dependencies", "config_schema",
diff --git a/tests/hermes_cli/test_plugins_desktop_only.py b/tests/hermes_cli/test_plugins_desktop_only.py
new file mode 100644
index 0000000000..40bd7d8dc5
--- /dev/null
+++ b/tests/hermes_cli/test_plugins_desktop_only.py
@@ -0,0 +1,41 @@
+"""A desktop-only package (desktop/plugin.js, no __init__.py) loads cleanly instead of failing import."""
+
+import logging
+
+from hermes_cli.plugins import PluginManager
+
+
+def _manager(tmp_path, monkeypatch, files):
+    home = tmp_path / "home"
+    plugin = home / "plugins" / "panel_only"
+    for name, text in files.items():
+        (plugin / name).parent.mkdir(parents=True, exist_ok=True)
+        (plugin / name).write_text(text)
+    (home / "config.yaml").write_text("plugins:\n  enabled: [panel_only]\n")
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    manager = PluginManager()
+    manager.discover_and_load()
+    return manager._plugins["panel_only"]
+
+
+def test_desktop_only_package_loads_without_python(tmp_path, monkeypatch, caplog):
+    caplog.set_level(logging.WARNING)
+    loaded = _manager(tmp_path, monkeypatch, {
+        "plugin.yaml": "name: panel_only\nversion: 0.1.0\nmanifest_version: 1\nkind: standalone\n",
+        "desktop/plugin.js": "export default {}\n"})
+    assert loaded.error is None
+    assert loaded.enabled
+    assert "No __init__.py" not in caplog.text
+
+
+def test_package_without_python_or_desktop_half_still_fails(tmp_path, monkeypatch):
+    loaded = _manager(tmp_path, monkeypatch, {"plugin.yaml": "name: panel_only\nversion: 0.1.0\n"})
+    assert loaded.error and "__init__.py" in loaded.error
+
+
+def test_provides_middleware_is_a_known_manifest_field(tmp_path, monkeypatch, caplog):
+    caplog.set_level(logging.WARNING)
+    _manager(tmp_path, monkeypatch, {
+        "plugin.yaml": "name: panel_only\nversion: 0.1.0\nmanifest_version: 2\nprovides_middleware: []\n",
+        "__init__.py": "def register(ctx):\n    pass\n"})
+    assert "unknown manifest field" not in caplog.text
