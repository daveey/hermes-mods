From f8d4d3da5c1ba02a7cda340eaf63e3fb58fe7fa1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:45:12 +0000
Subject: [PATCH] [daveey] Recover recursive assignments for name-taking
 subscript sinks

Why: direct NAME subscript recovery did not activate recursive variable-value recovery, so test -v a[x], printf -v a[x], read and unset could execute a substitution stored in x without scanning it. Share the builtin mode predicate and require a subscript argument before recovering assignments.

Proof: seven real-Bash marker regressions fail on prior head and pass with this change; eight inert controls and clean referenced-script twins stay allowed. Full lifecycle suite 2328 passed (34 files); scripts/check 20 checks OK. Three condition mutants killed. Frozen read-only hub sample of 2057 unique commands has zero operand-selection differences against original baseline; not filesystem verdict replay.
---
 cron/lifecycle_guard_arith_words.py             | 17 +++++++++++++----
 .../test_lifecycle_guard_name_indirection.py    | 15 +++++++++++++++
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/cron/lifecycle_guard_arith_words.py b/cron/lifecycle_guard_arith_words.py
index f32f47849f0ee7b2ad3dee17ba1ba5af2528b88c..89b5c20b6bb1d41104892c22a148a45f293e21a7 100644
--- a/cron/lifecycle_guard_arith_words.py
+++ b/cron/lifecycle_guard_arith_words.py
@@ -47,6 +47,12 @@ def _integer_declaration(arguments: list[str]) -> bool:
     )
 
 
+def _name_taking_mode(name: str, arguments: list[str]) -> bool:
+    return name in {"unset", "read", "mapfile", "readarray"} or (
+        name in {"test", "[", "printf"} and "-v" in arguments
+    ) or (name == "wait" and "-p" in arguments)
+
+
 def _arithmetic_operands(segment: list[str]) -> Iterator[str]:
     from cron import lifecycle_guard as guard
 
@@ -67,9 +73,7 @@ def _arithmetic_operands(segment: list[str]) -> Iterator[str]:
     # NAME-taking builtins evaluate array subscripts after shell quote removal.
     # Scan all arguments once the name-taking mode is present: options and operands
     # can be interleaved, and scanning a benign referenced script remains allowed.
-    if name in {"unset", "read", "mapfile", "readarray"} or (
-        name in {"test", "[", "printf"} and "-v" in arguments
-    ) or (name == "wait" and "-p" in arguments):
+    if _name_taking_mode(name, arguments):
         yield from arguments
 
 
@@ -81,8 +85,13 @@ def _recursive_arithmetic_segment(segment: list[str]) -> bool:
     if index is None:
         return False
     name = guard._executable_name(words[index])
+    arguments = words[index + 1:]
+    # NAME subscripts recursively evaluate variables just like explicit arithmetic.
+    # A plain NAME does not: `read x` must not activate earlier data assignments.
     return name == "let" or (
-        name == "[[" and any(token in _INT_OPERATORS for token in words[index + 1:])
+        name == "[[" and any(token in _INT_OPERATORS for token in arguments)
+    ) or (
+        _name_taking_mode(name, arguments) and any("[" in token for token in arguments)
     )
 
 
diff --git a/tests/cron/test_lifecycle_guard_name_indirection.py b/tests/cron/test_lifecycle_guard_name_indirection.py
index 5af2fbfcd854ecec994039ad000602f2f9999835..820e568863ba08f65289377bf0c35bc87345c748 100644
--- a/tests/cron/test_lifecycle_guard_name_indirection.py
+++ b/tests/cron/test_lifecycle_guard_name_indirection.py
@@ -27,6 +27,13 @@ SHAPES = [
     r"read -r a[\$\(SCRIPT\)] <<< 1",
     r"x=a['$'\(SCRIPT\)]; y=x; echo $((y))",
     "declare x='a[$(SCRIPT)]'; echo $((x))",
+    "x='a[$(SCRIPT)]'; test -v 'a[x]'",
+    r"x=a[\$\(SCRIPT\)]; [ -v 'a[x]' ]",
+    "x='a[$(SCRIPT)]'; printf -v 'a[x]' 1",
+    "x='a[$(SCRIPT)]'; read 'a[x]' <<< 1",
+    "x='a[$(SCRIPT)]'; declare -a a=([0]=1); unset 'a[x]'",
+    "x='a[$(SCRIPT)]'; builtin test -v 'a[x]'",
+    "x='a[$(SCRIPT)]'; command printf -v 'a[x]' 1",
 ]
 
 
@@ -51,6 +58,14 @@ def test_name_and_indirection_scripts_are_scanned(tmp_path, shape):
     r"test -n a[\$\(SCRIPT\)]",
     r"echo 'x=a[$(SCRIPT)]'; echo $((1))",
     r"printf '%s' 'x=a[$(SCRIPT)]; ((x))'",
+    "x='a[$(SCRIPT)]'; test -n 'a[x]'",
+    "x='a[$(SCRIPT)]'; printf '%s' 'a[x]'",
+    "x='a[$(SCRIPT)]'; echo 'a[x]'",
+    "x='a[$(SCRIPT)]'; test -v x",
+    "x='a[$(SCRIPT)]'; printf -v x 1",
+    "x='a[$(SCRIPT)]'; read x <<< 1",
+    "x='a[$(SCRIPT)]'; unset x",
+    "echo 'x=a[$(SCRIPT)]'; test -v 'a[x]'",
 ])
 def test_inert_name_words_stay_allowed(tmp_path, shape):
     command = shape.replace("SCRIPT", str(tmp_path / "payload.sh"))
