diff --git a/hermes_cli/kanban_worker_scope.py b/hermes_cli/kanban_worker_scope.py
index 1718835e33..2eba08c271 100644
--- a/hermes_cli/kanban_worker_scope.py
+++ b/hermes_cli/kanban_worker_scope.py
@@ -125,6 +125,210 @@ def release_failure(metadata: dict) -> None:
         _systemctl("reset-failed", unit)
 
 
+# --- Stop a finished run's scope ------------------------------------------------
+# A worker's scope outlives the worker: anything it left behind (a background
+# pytest whose wrapper the agent pkill'ed, ``ssh-agent -s``, a ``nohup … &``)
+# stays in ``hermes-worker-kanban-<task>-run-<n>.scope`` and nothing stopped the
+# scope, so orphans held hub test slots for hours and scopes piled up for days.
+# Each dispatch tick now stops the scope of every run of this board that ended
+# more than ``RUN_SCOPE_STOP_GRACE_SECONDS`` ago and whose worker is gone.
+# Jobs the worker started with ``persist_on_release`` (recorded in any profile's
+# ``processes.json``) and their descendants are spared: such a scope gets every
+# other process signalled instead of a unit stop. [daveey]
+RUN_SCOPE_STOP_GRACE_SECONDS = 600
+RUN_SCOPE_SWEEP_INTERVAL_SECONDS = 300
+_SCOPE_UNIT_PREFIX = "hermes-worker-kanban-"
+_CGROUP_ROOT = Path("/sys/fs/cgroup")
+_last_scope_sweep: dict[str, float] = {}
+
+
+def _parse_scope_unit(unit: str) -> tuple[str, int] | None:
+    import re
+
+    m = re.fullmatch(r"hermes-worker-kanban-(?P<task>.+)-run-(?P<run>\d+)\.scope", unit)
+    return (m.group("task"), int(m.group("run"))) if m else None
+
+
+def _active_run_scopes() -> list[str] | None:
+    proc = _systemctl("list-units", "--type=scope", "--state=active", "--plain",
+                      "--no-legend", "--no-pager", _SCOPE_UNIT_PREFIX + "*")
+    if proc is None or proc.returncode:
+        return None
+    return [line.split()[0] for line in proc.stdout.splitlines()
+            if line.split() and line.split()[0].startswith(_SCOPE_UNIT_PREFIX)]
+
+
+def _scope_pids(unit: str) -> list[int] | None:
+    proc = _systemctl("show", unit, "-p", "ControlGroup", "--value")
+    if proc is None or proc.returncode or not proc.stdout.strip():
+        return None
+    try:
+        raw = (_CGROUP_ROOT / proc.stdout.strip().lstrip("/") / "cgroup.procs").read_text(encoding="utf-8-sig")
+    except OSError:
+        return None
+    return [int(p) for p in raw.split() if p.isdecimal()]
+
+
+def _proc_stat(pid: int) -> tuple[int, int] | None:
+    """(ppid, start ticks) from /proc/<pid>/stat, or None when the pid is gone."""
+    try:
+        stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8-sig")
+        fields = stat[stat.rindex(")") + 2:].split()
+        return int(fields[1]), int(fields[19])
+    except (OSError, ValueError, IndexError):
+        return None
+
+
+def _cmdline(pid: int) -> str:
+    try:
+        return Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(
+            "utf-8", "replace").strip()[:200]
+    except OSError:
+        return ""
+
+
+def _persisted_pids() -> set[int]:
+    """Live pids of ``persist_on_release`` jobs from every profile's process checkpoint."""
+    from hermes_constants import get_default_hermes_root, get_hermes_home
+
+    homes = {get_hermes_home()}
+    try:
+        root = get_default_hermes_root()
+        homes.add(root)
+        homes.update(p for p in (root / "profiles").iterdir() if p.is_dir())
+    except OSError:
+        pass
+    pids: set[int] = set()
+    for home in homes:
+        try:
+            entries = json.loads((home / "processes.json").read_text(encoding="utf-8-sig"))
+        except (OSError, ValueError):
+            continue
+        for entry in entries if isinstance(entries, list) else []:
+            if not isinstance(entry, dict) or not entry.get("persist_on_release"):
+                continue
+            pid, start = entry.get("pid"), entry.get("host_start_time")
+            if type(pid) is not int or pid <= 1:
+                continue
+            stat = _proc_stat(pid)
+            if stat is not None and (type(start) is not int or stat[1] == start):
+                pids.add(pid)
+    return pids
+
+
+def _is_spared(pid: int, persisted: set[int]) -> bool:
+    seen = 0
+    while pid > 1 and seen < 64:
+        if pid in persisted:
+            return True
+        stat = _proc_stat(pid)
+        if stat is None:
+            return False
+        pid, seen = stat[0], seen + 1
+    return False
+
+
+def _signal_unspared(pids: list[int]) -> None:
+    import signal
+    import time
+
+    def send(sig: int, targets: list[int]) -> None:
+        for pid in targets:
+            try:
+                os.kill(pid, sig)
+            except OSError:
+                pass
+
+    send(signal.SIGTERM, pids)
+    deadline = time.monotonic() + 2.0
+    while time.monotonic() < deadline and any(_proc_stat(p) is not None for p in pids):
+        time.sleep(0.1)
+    send(getattr(signal, "SIGKILL", signal.SIGTERM), [p for p in pids if _proc_stat(p) is not None])
+
+
+def stop_ended_run_scopes(
+    conn: sqlite3.Connection, *, board: str | None = None,
+    grace_seconds: int = RUN_SCOPE_STOP_GRACE_SECONDS, force: bool = False,
+) -> list[dict]:
+    """Stop the systemd scopes of this board's runs that ended ``grace_seconds`` ago.
+
+    Throttled to one sweep per ``RUN_SCOPE_SWEEP_INTERVAL_SECONDS`` per board unless
+    ``force``. A run whose row is not on this board, whose retained worker is still
+    alive (``reap_terminal_workers`` owns that), or whose scope holds this process is
+    left alone. Returns one record per scope acted on (also logged and booked as a
+    ``run_scope_stopped`` event). Never raises.
+    """
+    import logging
+    import time
+
+    log = logging.getLogger(__name__)
+    key = board or "default"
+    if not force and time.monotonic() - _last_scope_sweep.get(key, float("-inf")) < RUN_SCOPE_SWEEP_INTERVAL_SECONDS:
+        return []
+    _last_scope_sweep[key] = time.monotonic()
+    stopped: list[dict] = []
+    try:
+        units = _active_run_scopes()
+        if not units:
+            return []
+        from hermes_cli import kanban_db as kb
+
+        cutoff = int(time.time()) - grace_seconds
+        persisted: set[int] | None = None
+        for unit in units:
+            parsed = _parse_scope_unit(unit)
+            if parsed is None:
+                continue
+            task_id, run_id = parsed
+            row = conn.execute(
+                "SELECT ended_at, worker_pid FROM task_runs WHERE id = ? AND task_id = ?",
+                (run_id, task_id)).fetchone()
+            if row is None or row[0] is None or int(row[0]) > cutoff:
+                continue
+            if row[1] is not None and kb._pid_alive(int(row[1])):
+                continue
+            pids = _scope_pids(unit)
+            if not pids or os.getpid() in pids:
+                continue
+            if persisted is None:
+                persisted = _persisted_pids()
+            spared = [p for p in pids if _is_spared(p, persisted)]
+            doomed = [p for p in pids if p not in spared]
+            if not doomed:
+                continue
+            record = {
+                "systemd_unit": unit, "run_id": run_id, "task_id": task_id,
+                "mode": "signal" if spared else "stop", "spared": spared,
+                "killed": [{"pid": p, "cmd": _cmdline(p)} for p in doomed],
+            }
+            if spared:
+                _signal_unspared(doomed)
+            else:
+                proc = _systemctl("stop", "--no-block", unit)
+                if proc is None or proc.returncode:
+                    log.warning("kanban: could not stop scope %s: %s", unit,
+                                (proc.stderr.strip() if proc is not None else "no user bus"))
+                    continue
+            log.info("kanban: stopped scope %s of ended run %s (%s): killed %s, spared %s",
+                     unit, run_id, record["mode"],
+                     [f"{k['pid']}:{k['cmd'][:60]}" for k in record["killed"]], spared)
+            try:
+                with kb.write_txn(conn):
+                    kb._append_event(conn, task_id, "run_scope_stopped",
+                                     {k: v for k, v in record.items() if k != "task_id"}, run_id=run_id)
+            except Exception:
+                log.debug("kanban: booking run_scope_stopped for %s failed", unit, exc_info=True)
+            stopped.append(record)
+    except Exception:
+        log.warning("kanban: stopping ended run scopes failed", exc_info=True)
+    return stopped
+
+
+def stopped_scope_units(conn: sqlite3.Connection, *, board: str | None = None) -> list[str]:
+    """Dispatch-tick entry: :func:`stop_ended_run_scopes`, reduced to the unit names."""
+    return [r["systemd_unit"] for r in stop_ended_run_scopes(conn, board=board)]
+
+
 # --- Typed OOM recovery -------------------------------------------------------
 # An ``oom_killed`` run is a resource failure, not a generic crash: the retry
 # gets a doubled MemoryMax (bounded by MemAvailable admission) instead of dying
diff --git a/tests/hermes_cli/test_kanban_run_scope_stop.py b/tests/hermes_cli/test_kanban_run_scope_stop.py
new file mode 100644
index 0000000000..505de4f11b
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_run_scope_stop.py
@@ -0,0 +1,236 @@
+"""Invariant: a run's ``hermes-worker-kanban-<task>-run-<n>.scope`` is stopped once
+the run has ended and its worker is gone, so nothing the worker left behind (an
+orphaned pytest, ``ssh-agent -s``) keeps running in it for hours or days.
+A job the worker started with ``persist_on_release`` survives: its scope gets the
+other processes signalled instead of a unit stop.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as kbd
+from hermes_cli import kanban_worker_scope as kws
+from tests.waiting import wait_until
+
+# The orphans are this test's own processes, but they are reparented out of its
+# subtree (that is the bug), so the live-system kill guard must let them be signalled.
+pytestmark = pytest.mark.live_system_guard_bypass
+
+
+@pytest.fixture
+def conn(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setattr(kws, "_last_scope_sweep", {})
+    db_path = kb.kanban_db_path(board="default")
+    kb._INITIALIZED_PATHS.discard(str(db_path.resolve()))
+    kb.init_db()
+    with kbc.connect() as c:
+        yield c
+
+
+class FakeSystemd:
+    """``systemctl --user`` for transient scopes whose cgroup.procs live under tmp_path."""
+
+    def __init__(self, tmp_path: Path, monkeypatch):
+        self.root = tmp_path / "cgroup"
+        self.units: dict[str, list[int]] = {}
+        self.calls: list[tuple[str, ...]] = []
+        monkeypatch.setattr(kws, "_CGROUP_ROOT", self.root)
+        monkeypatch.setattr(kws, "_systemctl", self)
+
+    def add(self, unit: str, pids: list[int]) -> None:
+        self.units[unit] = pids
+        d = self.root / "app.slice" / unit
+        d.mkdir(parents=True, exist_ok=True)
+        (d / "cgroup.procs").write_text("".join(f"{p}\n" for p in pids))
+
+    def __call__(self, *args: str):
+        self.calls.append(args)
+        out = ""
+        if args[0] == "list-units":
+            out = "".join(f"{u} loaded active running scope\n" for u in self.units)
+        elif args[0] == "show":
+            out = f"/app.slice/{args[1]}\n"
+        return subprocess.CompletedProcess(["systemctl", "--user", *args], 0, out, "")
+
+    @property
+    def stops(self) -> list[str]:
+        return [c[-1] for c in self.calls if c[0] == "stop"]
+
+
+def _orphaning_worker() -> int:
+    """Run a fake worker that leaves a sleeping grandchild behind; return the grandchild pid."""
+    out = subprocess.run(
+        [sys.executable, "-c",
+         "import subprocess, sys; p = subprocess.Popen(['sleep', '300'], start_new_session=True, "
+         "stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL); print(p.pid)"],
+        capture_output=True, text=True, check=True, timeout=30)
+    return int(out.stdout.strip())  # the worker has exited; its grandchild still sleeps
+
+
+def _dead_pid() -> int:
+    proc = subprocess.Popen([sys.executable, "-c", "pass"])
+    proc.wait()
+    return proc.pid
+
+
+def _ended_run(conn, *, ended_ago: int) -> tuple[str, int | None, str]:
+    tid = kb.create_task(conn, title="finished", assignee="coder")
+    kb.claim_task(conn, tid, claimer=kb._claimer_id())
+    run_id = kb._current_run_id(conn, tid)
+    kbd._set_worker_pid(conn, tid, _dead_pid())
+    assert kb.complete_task(conn, tid, result="done", expected_run_id=run_id) is True
+    conn.execute("UPDATE task_runs SET ended_at = ended_at - ? WHERE id=?", (ended_ago, run_id))
+    return tid, run_id, f"hermes-worker-kanban-{tid}-run-{run_id}.scope"
+
+
+def _alive(pid: int) -> bool:
+    try:
+        os.waitpid(pid, os.WNOHANG)  # reap if it is our zombie
+    except ChildProcessError:
+        pass
+    return kws._proc_stat(pid) is not None
+
+
+def _start(pid: int) -> int:
+    stat = kws._proc_stat(pid)
+    assert stat is not None
+    return stat[1]
+
+
+def _kill(*pids: int) -> None:
+    for pid in pids:
+        try:
+            os.kill(pid, 9)
+        except OSError:
+            pass
+
+
+def test_ended_runs_scope_is_stopped_on_dispatch_tick(conn, tmp_path, monkeypatch):
+    systemd = FakeSystemd(tmp_path, monkeypatch)
+    orphan = _orphaning_worker()
+    try:
+        tid, run_id, unit = _ended_run(conn, ended_ago=kws.RUN_SCOPE_STOP_GRACE_SECONDS + 60)
+        systemd.add(unit, [orphan])
+
+        result = kbd.dispatch_once(conn, spawn_fn=lambda *a, **k: 0, dry_run=True, max_spawn=0)
+
+        assert result.stopped_run_scopes == [unit]
+        assert systemd.stops == [unit]
+        assert ("stop", "--no-block", unit) in systemd.calls
+        ev = conn.execute("SELECT payload, run_id FROM task_events WHERE task_id=? AND kind='run_scope_stopped'",
+                          (tid,)).fetchone()
+        payload = json.loads(ev["payload"])
+        assert ev["run_id"] == run_id and payload["mode"] == "stop"
+        assert [k["pid"] for k in payload["killed"]] == [orphan] and "sleep 300" in payload["killed"][0]["cmd"]
+    finally:
+        _kill(orphan)
+
+
+def test_persisted_job_survives_and_only_the_orphan_is_killed(conn, tmp_path, monkeypatch):
+    systemd = FakeSystemd(tmp_path, monkeypatch)
+    orphan = _orphaning_worker()
+    # A persist_on_release job: a shell wrapper with its own child, both in the scope.
+    job = subprocess.Popen(["bash", "-c", "sleep 300 & wait"], start_new_session=True)
+    job_child = int(wait_until(lambda: subprocess.run(
+        ["pgrep", "-P", str(job.pid)], capture_output=True, text=True, check=False).stdout.split())[0])
+    profile_home = tmp_path / ".hermes" / "profiles" / "bb-tuner"
+    profile_home.mkdir(parents=True)
+    (profile_home / "processes.json").write_text(json.dumps([
+        {"session_id": "proc_x", "pid": job.pid, "host_start_time": _start(job.pid),
+         "persist_on_release": True},
+    ]))
+    try:
+        _tid, _run_id, unit = _ended_run(conn, ended_ago=kws.RUN_SCOPE_STOP_GRACE_SECONDS + 60)
+        systemd.add(unit, [job.pid, job_child, orphan])
+
+        stopped = kws.stop_ended_run_scopes(conn, force=True)
+
+        assert systemd.stops == []  # a unit stop would take the persisted job with it
+        assert [r["mode"] for r in stopped] == ["signal"]
+        assert sorted(stopped[0]["spared"]) == sorted([job.pid, job_child])
+        assert [k["pid"] for k in stopped[0]["killed"]] == [orphan]
+        wait_until(lambda: not _alive(orphan), timeout=5, what="orphan killed")
+        assert job.poll() is None and _alive(job_child)
+    finally:
+        _kill(orphan, job_child, job.pid)
+        job.wait(timeout=10)
+
+
+def test_same_pid_without_persisted_marker_is_not_spared(conn, tmp_path, monkeypatch):
+    """A recycled pid (start time differs from the checkpoint) is not a persisted job."""
+    systemd = FakeSystemd(tmp_path, monkeypatch)
+    orphan = _orphaning_worker()
+    (tmp_path / ".hermes" / "processes.json").write_text(json.dumps([
+        {"pid": orphan, "host_start_time": _start(orphan) - 1, "persist_on_release": True},
+    ]))
+    try:
+        _tid, _run_id, unit = _ended_run(conn, ended_ago=kws.RUN_SCOPE_STOP_GRACE_SECONDS + 60)
+        systemd.add(unit, [orphan])
+        assert [r["mode"] for r in kws.stop_ended_run_scopes(conn, force=True)] == ["stop"]
+        assert systemd.stops == [unit]
+    finally:
+        _kill(orphan)
+
+
+def test_scope_is_left_alone_inside_grace_while_running_or_on_another_board(conn, tmp_path, monkeypatch):
+    systemd = FakeSystemd(tmp_path, monkeypatch)
+    _tid, _run, recent = _ended_run(conn, ended_ago=10)
+    live = kb.create_task(conn, title="live", assignee="coder")
+    kb.claim_task(conn, live, claimer=kb._claimer_id())
+    live_unit = f"hermes-worker-kanban-{live}-run-{kb._current_run_id(conn, live)}.scope"
+    foreign = "hermes-worker-kanban-t_elsewhere-run-1.scope"  # a run of another board's DB
+    for unit in (recent, live_unit, foreign):
+        systemd.add(unit, [os.getppid()])
+
+    assert kws.stop_ended_run_scopes(conn, force=True) == []
