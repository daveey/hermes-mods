From 55231ef4ae14bed0446102cb37aebdc857abb82e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 05:03:30 -0800
Subject: [PATCH] [daveey] kanban tests: a lost review that names its report
 only in the result stays held

Problem: the _LOST_REVIEW_KEYS comment says complete_task adds artifacts for
scratch-workspace files named "in the summary or result", but only the summary
case had a test (Opus review of f7de15aa, note 3). The comment also named only
kanban_complete as the worker_session_id source (note 2).
Why 1: test_lost_review_citing_its_report_file_stays_held named the report in
the summary only.
Why 2: _merge_completion_prose_artifacts joins summary and result into one
text, so the summary case looked like it covered both; a scan of the summary
alone passed every test.
Root: the lost-review tests pinned each key the classifier allows, not each
entry path that adds the key.
Fix: parametrize the report-file test over where the report path is named
(summary, result). Comment: kanban_complete, kanban_continue and
kanban_request_review all stamp worker_session_id
(tools/kanban_tools.py:896/1220/1285). Comment-only in production code: the
module's AST is unchanged.
Proof: GREEN 54 passed. Dropping "artifacts" from _LOST_REVIEW_KEYS fails both
report-file cases and the worker-tool test (3). Scanning the summary alone
fails report-file[result] only (1).
---
 hermes_cli/kanban_dependency_review.py              | 11 ++++++-----
 .../test_kanban_dependency_review_no_verdict.py     | 13 +++++++++----
 2 files changed, 15 insertions(+), 9 deletions(-)

diff --git a/hermes_cli/kanban_dependency_review.py b/hermes_cli/kanban_dependency_review.py
index 73bf1ae320..6ca910a822 100644
--- a/hermes_cli/kanban_dependency_review.py
+++ b/hermes_cli/kanban_dependency_review.py
@@ -219,11 +219,12 @@ def _approval_prs(conn, parent_id, parked_at, owner_run_id, captured: set[str])
 
 _REVIEW_KEYS = ("verdict", "approved", "reviewed_sha")
 # Keys a result can carry without its worker describing any work: a PR reference, the
-# session id kanban_complete stamps on a dispatcher worker's own result, and artifacts
-# (files the worker lists, by artifacts= or by hand, plus scratch-workspace files
-# complete_task finds named in the summary or result). Any other key routes by
-# _REVIEW_KEYS alone, so hub reviews that record review_outcome or reviewer_checks, and
-# size-judge rulings, take the ordering continuation as they did before #728. [daveey]
+# session id the worker tools (kanban_complete, kanban_continue, kanban_request_review)
+# stamp on a dispatcher worker's own result, and artifacts (files the worker lists, by
+# artifacts= or by hand, plus scratch-workspace files complete_task finds named in the
+# summary or result). Any other key routes by _REVIEW_KEYS alone, so hub reviews that
+# record review_outcome or reviewer_checks, and size-judge rulings, take the ordering
+# continuation as they did before #728. [daveey]
 _LOST_REVIEW_KEYS = frozenset({"pr", "reviewed_pr", "worker_session_id", "artifacts"})
 
 
diff --git a/tests/hermes_cli/test_kanban_dependency_review_no_verdict.py b/tests/hermes_cli/test_kanban_dependency_review_no_verdict.py
index 5f7c4f78b2..71a7715379 100644
--- a/tests/hermes_cli/test_kanban_dependency_review_no_verdict.py
+++ b/tests/hermes_cli/test_kanban_dependency_review_no_verdict.py
@@ -154,9 +154,10 @@ def test_ordering_handoff_does_not_absorb_unreadable_review(board, monkeypatch,
     assert dispatch.check_respawn_guard(board, task) == expected
 
 
-def test_lost_review_citing_its_report_file_stays_held(board, monkeypatch):
-    """Completion adds an artifacts list when the summary names a scratch-workspace file, so a
-    review whose verdict was lost but which cites its report file must still be held."""
+@pytest.mark.parametrize("where", ["summary", "result"])
+def test_lost_review_citing_its_report_file_stays_held(board, monkeypatch, where):
+    """Completion adds an artifacts list when the summary or the result names a scratch-workspace
+    file, so a review whose verdict was lost but which cites its report file must still be held."""
     from hermes_cli import kanban_db_workspace as kbw
     task, parents = incident(board, monkeypatch, finish=False)
     stored_keys = []
@@ -168,7 +169,11 @@ def test_lost_review_citing_its_report_file_stays_held(board, monkeypatch):
         kbw.set_workspace_path(board, parent, workspace)
         report = workspace / "review.md"
         report.write_text("No blocking defects.\n")
-        assert kb.complete_task(board, parent, summary=f"Reviewed PR #682. No blocking defects; report: {report}",
+        if where == "summary":
+            summary, result = f"Reviewed PR #682. No blocking defects; report: {report}", None
+        else:  # the PR in the summary, the report path only in the result
+            summary, result = "Reviewed PR #682. No blocking defects.", f"Report: {report}"
+        assert kb.complete_task(board, parent, summary=summary, result=result,
                                 expected_run_id=row.current_run_id, metadata={})
         stored = kb._json_dict(board.execute(
             "SELECT metadata FROM task_runs WHERE task_id = ? ORDER BY id DESC LIMIT 1", (parent,)).fetchone()[0])
