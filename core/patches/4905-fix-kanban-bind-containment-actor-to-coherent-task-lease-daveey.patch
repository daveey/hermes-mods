From a2aa3ecd5ae42e7ff88ef1fe30a0dc0810e4bac8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 13:42:41 +0000
Subject: [PATCH] fix(kanban): bind containment actor to coherent task lease
 [daveey]

---
 hermes_cli/kanban_containment_lifecycle.py        | 7 +++++--
 tests/hermes_cli/test_kanban_containment_scope.py | 4 ++++
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_containment_lifecycle.py b/hermes_cli/kanban_containment_lifecycle.py
index 50ec689d2914f16d56f4b37b6c2302a96a7e28fd..6b4e11171d653f327c8618463f341b34a69c3d5d 100644
--- a/hermes_cli/kanban_containment_lifecycle.py
+++ b/hermes_cli/kanban_containment_lifecycle.py
@@ -65,11 +65,14 @@ def _events(conn: sqlite3.Connection, task: str) -> list[dict]:
 def _actor(conn: sqlite3.Connection, task: str, run_uid: str) -> None:
     if not _uid(run_uid):
         raise ContainmentRefused("actor requires a portable current run identity")
-    row = conn.execute("SELECT t.status,t.current_run_id,r.id,r.ended_at,r.claim_expires "
+    row = conn.execute("SELECT t.status,t.current_run_id,r.id,r.ended_at,r.claim_expires,"
+                       "t.claim_expires,t.claim_lock,r.claim_lock "
                        "FROM tasks t JOIN task_runs r ON r.task_id=t.id WHERE t.id=? AND r.uid=?",
                        (task, run_uid)).fetchone()
+    now = time.time()
     if (row is None or row[0] != "running" or row[1] != row[2] or row[3] is not None
-            or row[4] is None or row[4] <= time.time()):
+            or row[4] is None or row[4] <= now or row[5] is None or row[5] <= now
+            or not row[6] or row[6] != row[7]):
         raise ContainmentRefused("actor is not the current live claimed run")
 
 
diff --git a/tests/hermes_cli/test_kanban_containment_scope.py b/tests/hermes_cli/test_kanban_containment_scope.py
index c6894e2de56fa3e96cfd381c08cbba8c8f722663..1ae6bd69e0930391d3fe5166ebf6e75c7df81d01 100644
--- a/tests/hermes_cli/test_kanban_containment_scope.py
+++ b/tests/hermes_cli/test_kanban_containment_scope.py
@@ -18,6 +18,10 @@ board = helpers.board
     ("ended", "UPDATE task_runs SET ended_at=1 WHERE id=?"),
     ("expired", "UPDATE task_runs SET claim_expires=1 WHERE id=?"),
     ("no_expiry", "UPDATE task_runs SET claim_expires=NULL WHERE id=?"),
+    ("task_expired", "UPDATE tasks SET claim_expires=1 WHERE current_run_id=?"),
+    ("task_no_expiry", "UPDATE tasks SET claim_expires=NULL WHERE current_run_id=?"),
+    ("task_no_lock", "UPDATE tasks SET claim_lock=NULL WHERE current_run_id=?"),
+    ("task_wrong_lock", "UPDATE tasks SET claim_lock='another-holder' WHERE current_run_id=?"),
     ("task_not_running", "UPDATE tasks SET status='ready' WHERE current_run_id=?"),
     ("different_current", "UPDATE tasks SET current_run_id=NULL WHERE current_run_id=?"),
     ("malformed_uid", None),
-- 
2.43.0

