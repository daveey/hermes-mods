diff --git a/hermes_cli/kanban_spend_decision.py b/hermes_cli/kanban_spend_decision.py
index ebe181a99c5..f04a09432e4 100644
--- a/hermes_cli/kanban_spend_decision.py
+++ b/hermes_cli/kanban_spend_decision.py
@@ -165,7 +165,16 @@
 
 
 def restricted_since(conn, task_id: str) -> int | None:
-    """Execution fencing: the earliest restriction a scope renewal does not cover. Safety is never covered."""
+    """Execution fencing: the earliest restriction a scope renewal does not cover. Safety is never covered.
+    An owning-chat administrative stop (``kanban_stop_ended``) is never covered either, and never moves the
+    accounting floor."""
+    from hermes_cli.kanban_stop_ended import stopped_at
+    admin = stopped_at(conn, task_id)
+    since = _restricted_since(conn, task_id)
+    return min(t for t in (admin, since) if t is not None) if (admin, since) != (None, None) else None
+
+
+def _restricted_since(conn, task_id: str) -> int | None:
     import json
     from hermes_cli import kanban_scope_renewal as renewal
     renewed = renewal.covered(conn, task_id)
diff --git a/hermes_cli/kanban_stop_context.py b/hermes_cli/kanban_stop_context.py
new file mode 100644
index 00000000000..b22f4edc568
--- /dev/null
+++ b/hermes_cli/kanban_stop_context.py
@@ -0,0 +1,114 @@
+"""Live owner token for the stop-only ``kanban_stop_ended`` control. [daveey]
+
+Plain session ContextVars and a non-None turn event are inherited by copied contexts, threads
+and subprocess environments, so they are not proof that the caller is the owning chat's live
+turn. This token is: the interactive turn runner binds one around its actual tool execution
+(:func:`bound`), every copied context shares the SAME mutable object, and closing it at turn
+end, replacement or cancellation invalidates every copy at once. Nothing exports it to the
+environment and no tool argument can mint one.
+
+Lock order is fixed: this token's lock (bounded), then the board's ``BEGIN IMMEDIATE``.
+Closing takes the same token lock, so a cancellation either lands before the commit (refused)
+or waits for it to finish; never the inverse order.
+"""
+from __future__ import annotations
+
+import itertools
+import os
+import re
+import threading
+from contextlib import contextmanager
+from contextvars import ContextVar
+
+from hermes_cli.kanban_stop_ended import StopRefused
+
+INTERACTIVE_SOURCES = frozenset({'desktop', 'cli', 'tui', 'acp', 'gui'})
+_ROUTING = ('HERMES_KANBAN_TASK', 'HERMES_KANBAN_WORKER_TASK', 'HERMES_DELEGATED_CHILD_CONTEXT', 'HERMES_CRON_SESSION')
+LOCK_TIMEOUT_S = 5.0
+_GENERATION = itertools.count(1)
+_CURRENT: ContextVar['OwnerToken | None'] = ContextVar('hermes_stop_only_owner_token', default=None)
+
+
+def _session_source(session_id: str):
+    from hermes_constants import get_hermes_home
+    from hermes_cli.kanban_session_provenance import _read_sources
+    sources, readable = _read_sources(str(get_hermes_home() / 'state.db'), [session_id])
+    return sources.get(session_id) if readable else None
+
+
+def _routing_context() -> bool:
+    from gateway.session_context import get_session_env
+    return any(os.environ.get(k) or get_session_env(k, '') for k in _ROUTING)
+
+
+class OwnerToken:
+    """One interactive turn's stop-only authority. Mutable, shared by copies, closes permanently."""
+
+    def __init__(self, session_id: str, gateway: str, profile: str, *, source_reader=_session_source):
+        self.session_id, self.gateway, self.profile = session_id, gateway, profile or 'default'
+        self.generation = next(_GENERATION)
+        self._lock = threading.Lock()
+        self._open = True
+        self._source_reader = source_reader
+
+    @property
+    def open(self) -> bool:
+        return self._open
+
+    def close(self) -> None:
+        with self._lock:  # waits for an in-flight commit; afterwards every copy refuses
+            self._open = False
+
+    def identity(self) -> dict:
+        return {'gateway': self.gateway, 'profile': self.profile, 'session': self.session_id,
+                'generation': self.generation}
+
+    @contextmanager
+    def held(self):
+        if not self._lock.acquire(timeout=LOCK_TIMEOUT_S):
+            raise StopRefused('stop_ended_owner_busy', 'owner token busy; retry the same request')
+        try:
+            if not self._open or _CURRENT.get() is not self:
+                raise StopRefused('stop_ended_owner_required', 'owner token closed or not this execution\'s token')
+            if _routing_context():
+                raise StopRefused('stop_ended_owner_required', 'machine, cron, Kanban or delegated context')
+            # Fresh, positive provenance at commit time, not a cached classification.
+            if self._source_reader(self.session_id) not in INTERACTIVE_SOURCES:
+                raise StopRefused('stop_ended_owner_required', 'session is not a local interactive chat')
+            yield {k: v for k, v in self.identity().items() if k != 'generation'}
+        finally:
+            self._lock.release()
+
+    def verify_link(self, conn, task_id: str, who: dict) -> None:
+        """Inside the write transaction: exactly this chat holds the card's unreleased ``created`` link."""
+        if not conn.execute("SELECT 1 FROM sqlite_master WHERE name='task_chat_links'").fetchone():
+            raise StopRefused('stop_ended_owner_required', 'board has no chat ownership links')
+        owners = {(r['chat_gateway'], r['chat_profile'] or 'default', r['chat_session']) for r in conn.execute(
+            "SELECT chat_gateway,chat_profile,chat_session FROM task_chat_links "
+            "WHERE task_id=? AND kind='created' AND released=0", (task_id,))}
+        if owners != {(who['gateway'], who['profile'], who['session'])}:
+            raise StopRefused('stop_ended_owner_required',
+                              'caller is not the single unreleased owning chat of this card')
+
+
+def current() -> OwnerToken:
+    token = _CURRENT.get()
+    if token is None or not token.open:
+        raise StopRefused('stop_ended_owner_required', 'no live owning-chat turn is bound to this execution')
+    return token
+
+
+@contextmanager
+def bound(session_id: str, *, gateway: str, profile: str, source: str, source_reader=_session_source):
+    """Bind around one interactive turn's tool execution; closes permanently on exit (any exit)."""
+    token = None
+    if (source in INTERACTIVE_SOURCES and isinstance(session_id, str)
+            and re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}', session_id) and gateway):
+        token = OwnerToken(session_id, gateway, profile, source_reader=source_reader)
+    reset = _CURRENT.set(token)
+    try:
+        yield token
+    finally:
+        if token is not None:
+            token.close()
+        _CURRENT.reset(reset)
diff --git a/hermes_cli/kanban_stop_ended.py b/hermes_cli/kanban_stop_ended.py
new file mode 100644
index 00000000000..54dfe319d70
--- /dev/null
+++ b/hermes_cli/kanban_stop_ended.py
@@ -0,0 +1,202 @@
+"""Owning-chat stop-only control for an ENDED card on a local-executing shadow board. [daveey]
+
+``kanban_retain`` stops only the caller's own admitted run and refuses a shadow board
+(``retain requires owning primary or genuinely local board``); ``kanban_protect_stopped``
+needs a provider-refusal source and an admitted administrative requester. Neither can stop a
+private shadow-board card whose run already ended (shadow-tools M5). This module is that
+control, and nothing more:
+
+- stop only: the card goes to ``triage`` with a genuine ``administrative_stop_restricted``
+  event; no run, lease, decision/spend/failure/safety episode is created; nothing is released;
+- local shadow only: the receipt says ``LOCAL-SHADOW-ONLY`` / ``canonical_protected=false``.
+  The event reaches the Board through the board's ordinary ordered outbox, and only after the
+  Board advertises ``admin_stop_ingress: 1`` (hermes-hub ``admin_stop_ingress.ts``), whose
+  barrier refuses every lease and every foreign write to the held card;
+- owner only: the caller must be the card's current owning interactive chat on this gateway,
+  proven by a live stop-only token (:mod:`hermes_cli.kanban_stop_context`) plus an exact
+  unreleased ``created`` chat link; identity arguments, environment, machine, cron, Kanban
+  worker and delegated contexts are refused before any write;
+- snapshot/apply CAS: without ``expected_digest`` the call is a pure read; applying needs the
+  digest of exactly that snapshot, so a concurrent claim, run, link or event refuses it.
+
+Persistent SQL fences (:mod:`hermes_cli.kanban_stop_guards`) keep the stopped card, its runs,
+events and dependency edges frozen for every later writer on this file.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import sqlite3
+import time
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_sync as sync
+
+KIND = 'administrative_stop_restricted'
+STOPPABLE = ('scheduled', 'todo', 'ready', 'triage', 'blocked', 'review')
+CONFLICTING = ('decision_protected_stopped', KIND)
+MAX_DEADLINE = 14 * 86400
+
+
+class StopRefused(ValueError):
+    """A typed refusal; nothing was written."""
+
+    def __init__(self, code: str, why: str):
+        self.code = code
+        super().__init__(f'{code}: {why}')
+
+
+def canonical(value) -> str:
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False, ensure_ascii=False)
+
+
+def _mode_guard(conn):
+    """Registered AND durable shadow; primary/off keep their own paths (``kanban_retain``)."""
+    state = sync.sync_state(conn)
+    if sync.board_mode(conn) != 'shadow' or not state or state.get('mode') != 'shadow':
+        raise StopRefused('stop_ended_requires_shadow', 'only a local-executing shadow board uses this control')
+    if not state.get('gateway_id') or not state.get('board_id'):
+        raise StopRefused('stop_ended_identity_unknown', 'shadow board has no enrolled board/gateway identity')
+    return state
+
+
+def _rows(conn, sql, args):
+    return [dict(r) for r in conn.execute(sql, args)]
+
+
+def snapshot(conn, task_id: str) -> dict:
+    """Canonical read-only state the CAS digest covers. ``tasks`` has no ``updated_at``; never use it."""
+    task = conn.execute('SELECT * FROM tasks WHERE id=?', (task_id,)).fetchone()
+    if task is None:
+        raise StopRefused('stop_ended_task_missing', 'exact local task does not exist')
+    task = dict(task)
+    ended = conn.execute('SELECT uid,status,outcome,ended_at FROM task_runs WHERE task_id=? AND ended_at IS NOT NULL '
+                         'ORDER BY ended_at DESC, id DESC LIMIT 1', (task_id,)).fetchone()
+    open_runs = conn.execute('SELECT COUNT(*) FROM task_runs WHERE task_id=? AND ended_at IS NULL', (task_id,)).fetchone()[0]
+    links = {'incoming': sorted(r['parent_id'] for r in conn.execute('SELECT parent_id FROM task_links WHERE child_id=?', (task_id,))),
+             'outgoing': sorted(r['child_id'] for r in conn.execute('SELECT child_id FROM task_links WHERE parent_id=?', (task_id,)))}
+    restrictions = sorted(r['uid'] or str(r['id']) for r in conn.execute(
+        'SELECT id,uid FROM task_events WHERE task_id=? AND kind IN '
+        "('decision_hold_restricted','spend_budget_triaged','decision_protected_stopped',?)", (task_id, KIND)))
+    return {
+        'version': 1, 'task_id': task_id, 'status': task['status'], 'current_run_id': task['current_run_id'],
+        'claim_lock': task.get('claim_lock'), 'claim_expires': task.get('claim_expires'),
+        'worker_pid': task.get('worker_pid'), 'created_on': task.get('created_on'),
+        'ended_run': dict(ended) if ended else None, 'open_runs': open_runs,
+        'max_event_id': conn.execute('SELECT COALESCE(MAX(id),0) FROM task_events WHERE task_id=?', (task_id,)).fetchone()[0],
+        'links': links, 'restrictions': restrictions,
+    }
+
+
+def digest(snap: dict) -> str:
+    return hashlib.sha256(canonical(snap).encode()).hexdigest()
+
+
+def _eligible(conn, state, snap):
+    if snap['created_on'] not in (None, '', state['gateway_id']):
+        raise StopRefused('stop_ended_foreign_card', 'card lives on another gateway; its home must stop it')
+    from hermes_cli.kanban_foreign_card import check as assert_local_card
+    assert_local_card(conn, snap['task_id'])
+    if (snap['status'] not in STOPPABLE or snap['current_run_id'] is not None or snap['claim_lock']
+            or snap['claim_expires'] or snap['worker_pid'] or snap['open_runs']):
+        raise StopRefused('stop_ended_target_active', 'target must be ended, unclaimed and non-terminal')
+    if not snap['ended_run'] or not snap['ended_run'].get('uid'):
+        raise StopRefused('stop_ended_no_ended_run', 'target has no ended run with a portable UID')
+    if conn.execute('SELECT 1 FROM task_events WHERE task_id=? AND kind IN (?,?) LIMIT 1',
+                    (snap['task_id'], *CONFLICTING)).fetchone():
+        raise StopRefused('stop_ended_conflicting_hold', 'existing stop custody is kept, never merged or replaced')
+    from hermes_cli.kanban_containment_guard import pending
+    if pending(conn, snap['task_id']):
+        raise StopRefused('stop_ended_conflicting_hold', 'pending containment transport owns this card')
+
+
+def normalize(reason, evidence, escalate_at, now=None) -> dict:
+    now = int(time.time()) if now is None else now
+    if not isinstance(reason, str) or not reason.strip() or len(reason) > 1000:
+        raise StopRefused('stop_ended_invalid', 'reason must be 1..1000 characters')
+    if (not isinstance(evidence, list) or not 1 <= len(evidence) <= 8
+            or any(not isinstance(e, str) or not e.strip() or len(e) > 512 for e in evidence)):
+        raise StopRefused('stop_ended_invalid', 'evidence must be 1..8 strings of at most 512 characters')
+    if type(escalate_at) is not int or not now < escalate_at <= now + MAX_DEADLINE:
+        raise StopRefused('stop_ended_invalid', 'escalate_at must be a fixed future Unix time within 14 days')
+    return {'reason': reason, 'evidence': list(evidence), 'escalate_at': escalate_at}
+
+
+def request_uid(board: str, gateway: str, task_id: str, ended_run_uid: str) -> str:
+    return 'as-' + hashlib.sha256(canonical([board, gateway, task_id, ended_run_uid]).encode()).hexdigest()
+
+
+def _stored(conn, task_id):
+    row = conn.execute('SELECT id,uid,payload FROM task_events WHERE task_id=? AND kind=? ORDER BY id LIMIT 1',
+                       (task_id, KIND)).fetchone()
+    return (row, json.loads(row['payload'])) if row else (None, None)
+
+
+def read(conn, *, board: str, task_id: str) -> dict:
+    """Pure read: snapshot + digest + any stored receipt. Writes nothing, reserves nothing."""
+    state = _mode_guard(conn)
+    snap = snapshot(conn, task_id)
+    row, payload = _stored(conn, task_id)
+    if row is not None:
+        return {'ok': True, 'mode': 'readback', 'receipt': payload['receipt'], 'event_uid': row['uid'],
+                'status': snap['status'], 'execution_restricted': True}
+    _eligible(conn, state, snap)
+    return {'ok': True, 'mode': 'snapshot', 'board': board, 'gateway': state['gateway_id'], 'task_id': task_id,
+            'expected_digest': digest(snap), 'snapshot': snap, 'writes': 0}
+
+
+def apply(conn, *, board: str, task_id: str, expected_digest: str, owner, capability, reason, evidence, escalate_at) -> dict:
+    """CAS-apply the stop. ``owner`` is a live :class:`kanban_stop_context.OwnerToken`; ``capability`` reads the
+    Board's ``admin_stop_ingress`` flag. Lock order: token lock, then BEGIN IMMEDIATE, never the reverse."""
+    frozen = normalize(reason, evidence, escalate_at)
+    if not isinstance(expected_digest, str) or not re.fullmatch(r'[0-9a-f]{64}', expected_digest):
+        raise StopRefused('stop_ended_invalid', 'expected_digest must be the 64-hex snapshot digest')
+    state = _mode_guard(conn)
+    if state['board_id'] != board:
+        raise StopRefused('stop_ended_identity_unknown', 'board does not match the enrolled shadow board')
+    with owner.held() as who:
+        stored_row, stored = _stored(conn, task_id)
+        if stored is None and capability(board) != 1:
+            # Unknown/old Board: a published row would not be a hold there. Refuse, never claim coverage.
+            raise StopRefused('stop_ended_ingress_unsupported', 'Board does not advertise admin_stop_ingress: 1')
+        with kb.write_txn(conn):
+            owner.verify_link(conn, task_id, who)
+            stored_row, stored = _stored(conn, task_id)
+            if stored is not None:
+                request = stored['request']
+                if (request['expected_digest'], request['frozen'], request['owner']) != (expected_digest, frozen, who):
+                    raise StopRefused('stop_ended_conflict', 'card already stopped by a different frozen request')
+                return {**stored['receipt'], 'replayed': True}
+            snap = snapshot(conn, task_id)
+            _eligible(conn, state, snap)
+            if digest(snap) != expected_digest:
+                raise StopRefused('stop_ended_target_changed', 'snapshot changed since the digest was read')
+            uid = request_uid(board, state['gateway_id'], task_id, snap['ended_run']['uid'])
+            receipt = {
+                'version': 1, 'ok': True, 'request_uid': uid, 'board': board, 'gateway': state['gateway_id'],
+                'task_id': task_id, 'ended_run_uid': snap['ended_run']['uid'], 'digest': expected_digest,
+                'protection_scope': 'LOCAL-SHADOW-ONLY', 'canonical_protected': False,
+                'dependency_satisfied': False, 'incomplete': True, 'terminal_for_run': False,
+                'execution_authority': False, 'status': 'triage', 'escalate_at': frozen['escalate_at'],
+            }
+            kb._append_event(conn, task_id, KIND, {
+                'version': 1, 'protection_scope': 'LOCAL-SHADOW-ONLY', 'canonical_protected': False,
+                'dependency_satisfied': False, 'incomplete': True, 'terminal_for_run': False,
+                'request': {'request_uid': uid, 'expected_digest': expected_digest, 'frozen': frozen, 'owner': who},
+                'receipt': receipt})
+            conn.execute("UPDATE tasks SET status='triage' WHERE id=?", (task_id,))
+            from hermes_cli.kanban_stop_guards import install
+            install(conn)
+            event_uid = conn.execute('SELECT uid FROM task_events WHERE task_id=? AND kind=?', (task_id, KIND)).fetchone()[0]
+            return {**receipt, 'event_uid': event_uid, 'replayed': False}
+
+
+def stopped_at(conn, task_id: str):
+    """Execution restriction time (feeds ``restricted_since``, never the accounting floor)."""
+    try:
+        row = conn.execute('SELECT MIN(COALESCE(created_at,0)) FROM task_events WHERE task_id=? AND kind=?',
+                           (task_id, KIND)).fetchone()
+    except sqlite3.OperationalError:  # schema-less connection; a real board always has task_events
+        return None
+    return row[0] if row else None
diff --git a/hermes_cli/kanban_stop_guards.py b/hermes_cli/kanban_stop_guards.py
new file mode 100644
index 00000000000..b9e62148938
--- /dev/null
+++ b/hermes_cli/kanban_stop_guards.py
@@ -0,0 +1,80 @@
+"""Persistent SQL fences for ``administrative_stop_restricted`` cards. [daveey]
+
+Stored triggers protect every later writer on this file (reopened connections, older local
+code, maintenance) without changing sync selection. A stopped card stays ``triage`` with no
+run, claim or worker; it gets no new runs; its runs, evidence and dependency edges (either
+direction) are immutable; it cannot be deleted, archived, completed or REPLACEd. Unrelated
+cards are untouched: every predicate starts from the stopped card's own evidence row.
+The one allowance is the supported NULL -> uid bootstrap with every other column equal.
+"""
+from __future__ import annotations
+
+from hermes_cli.kanban_stop_ended import KIND
+
+VERSION = 1
+MARKER = 'kanban_stop_ended_guard'
+_STOPPED = f"SELECT task_id FROM task_events WHERE kind='{KIND}'"
+
+
+def _uid_only(table: str, columns: set[str]) -> str:
+    # The NULL -> uid bootstrap, or an exact no-op rewrite (a sync echo of this gateway's own row).
+    same = ' AND '.join(f'NEW.{c} IS OLD.{c}' for c in sorted(columns - {'uid'}))
+    return f'(({same}) AND (NEW.uid IS OLD.uid OR (OLD.uid IS NULL AND NEW.uid IS NOT NULL)))'
+
+
+def _columns(conn, table):
+    return {r[1] for r in conn.execute(f'PRAGMA table_info({table})')}
+
+
+def ddl(conn) -> dict[str, tuple[str, str]]:
+    task_cols, run_cols, event_cols = _columns(conn, 'tasks'), _columns(conn, 'task_runs'), _columns(conn, 'task_events')
+    pinned = ["NEW.status IS NOT 'triage'", 'NEW.current_run_id IS NOT NULL', 'NEW.claim_lock IS NOT NULL',
+              'NEW.claim_expires IS NOT NULL']
+    pinned += [f'NEW.{c} IS NOT NULL' for c in ('worker_pid', 'worker_started_at') if c in task_cols]
+    pinned += [f'NEW.{c} IS NOT OLD.{c}' for c in ('title', 'body', 'assignee', 'created_on', 'tenant') if c in task_cols]
+    runs_uid = _uid_only('task_runs', run_cols) if 'uid' in run_cols else '0'
+    events_uid = _uid_only('task_events', event_cols) if 'uid' in event_cols else '0'
+    links = f'OLD.parent_id IN ({_STOPPED}) OR OLD.child_id IN ({_STOPPED})'
+    new_links = f'NEW.parent_id IN ({_STOPPED}) OR NEW.child_id IN ({_STOPPED})'
+    evidence_replace = ('EXISTS (SELECT 1 FROM task_events o WHERE o.id=NEW.id AND o.task_id IN '
+                        f'({_STOPPED}))')
+    if 'uid' in event_cols:
+        evidence_replace = ('EXISTS (SELECT 1 FROM task_events o WHERE (o.id=NEW.id OR (NEW.uid IS NOT NULL AND o.uid=NEW.uid)) '
+                            f'AND o.task_id IN ({_STOPPED}))')
+    return {
+        'task_update': ('BEFORE UPDATE ON tasks', f"OLD.id IN ({_STOPPED}) AND ({' OR '.join(pinned)})"),
+        'task_delete': ('BEFORE DELETE ON tasks', f'OLD.id IN ({_STOPPED})'),
+        # INSERT OR REPLACE fires INSERT (not DELETE) triggers with recursive_triggers OFF.
+        'task_replace': ('BEFORE INSERT ON tasks', f'NEW.id IN ({_STOPPED})'),
+        'run_insert': ('BEFORE INSERT ON task_runs', f'NEW.task_id IN ({_STOPPED})'),
+        'run_update': ('BEFORE UPDATE ON task_runs', f'OLD.task_id IN ({_STOPPED}) AND NOT {runs_uid}'),
+        'run_delete': ('BEFORE DELETE ON task_runs', f'OLD.task_id IN ({_STOPPED})'),
+        'event_update': ('BEFORE UPDATE ON task_events', f'OLD.task_id IN ({_STOPPED}) AND NOT {events_uid}'),
+        'event_delete': ('BEFORE DELETE ON task_events', f'OLD.task_id IN ({_STOPPED})'),
+        'event_replace': ('BEFORE INSERT ON task_events', evidence_replace),
+        'link_insert': ('BEFORE INSERT ON task_links', new_links),
+        'link_update': ('BEFORE UPDATE ON task_links', f'{links} OR {new_links}'),
+        'link_delete': ('BEFORE DELETE ON task_links', links),
+    }
+
+
+def install(conn) -> None:
+    """Idempotent; runs inside the caller's write transaction, so no connection sees an unfenced gap."""
+    conn.execute(f'CREATE TABLE IF NOT EXISTS {MARKER} (version INTEGER NOT NULL)')
+    conn.execute('CREATE INDEX IF NOT EXISTS idx_stop_ended_kind ON task_events(kind, task_id)')
+    for name, (when, predicate) in ddl(conn).items():
+        trigger = f'stop_ended_{name}'
+        sql = f"CREATE TRIGGER {trigger} {when} WHEN {predicate} BEGIN SELECT RAISE(ABORT,'administrative_stop_immutable'); END"
+        old = conn.execute("SELECT sql FROM sqlite_master WHERE type='trigger' AND name=?", (trigger,)).fetchone()
+        if old and old[0] == sql:
+            continue
+        conn.execute(f'DROP TRIGGER IF EXISTS {trigger}')
+        conn.execute(sql)
+    if not conn.execute(f'SELECT 1 FROM {MARKER} WHERE version>=?', (VERSION,)).fetchone():
+        conn.execute(f'INSERT INTO {MARKER} (version) VALUES (?)', (VERSION,))
+
+
+def installed(conn) -> bool:
+    """Fail closed: a stopped card with a missing or partial fence set is reported unguarded."""
+    names = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='trigger' AND name LIKE 'stop_ended_%'")}
+    return names >= {f'stop_ended_{n}' for n in ddl(conn)}
