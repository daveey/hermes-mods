From d19314a6c0bb0845b43ac5c34135f0299a9a265c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 11:18:10 +0000
Subject: [PATCH] test(desktop): pin input-port and empty-provider handoff
 guards [daveey]

Address exact-head review 5991762737 with test-only coverage.
Non-always-on ports 0/80/9200 refuse the active catalog without any getter call.
Empty/missing live provider preserves successor rows/provider and overlays only
live model without mutating the payload.

Mutation proof: removing input BACKEND_PORTS guard fails all three port cases;
removing provider truthiness fails empty-provider RPC. Production restored.
GREEN: 98 tests across control handoff, rollover, drain, token routes and skew;
scripts/check --base origin/main: 21 checks ok.

Live busy-pair/client and natural deployment/Desktop proof remain outstanding.
Read-only options only; no queue migration or model switching.
---
 .../test_always_on_control_handoff.py         | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/tests/hermes_cli/test_always_on_control_handoff.py b/tests/hermes_cli/test_always_on_control_handoff.py
index 4c20368c78..ecd195ed8b 100644
--- a/tests/hermes_cli/test_always_on_control_handoff.py
+++ b/tests/hermes_cli/test_always_on_control_handoff.py
@@ -438,3 +438,28 @@ def test_rpc_matching_provider_overlays_live_model_only(home, monkeypatch):
     assert resp["result"]["model"] == "live-model"
     assert resp["result"]["provider"] == "xai"
     assert resp["result"]["providers"] == payload["providers"]
+
+
+@pytest.mark.parametrize("port", [0, 80, 9200])
+def test_non_always_on_predecessor_never_reads_active_catalog(home, port):
+    ro.write_active(9148)
+    calls = []
+
+    def get(*args):
+        calls.append(args)
+        return 200, 0.0, {"providers": []}
+
+    assert ro.handoff_control_read(port, "/api/model/options", get=get) is None
+    assert calls == []
+
+
+@pytest.mark.parametrize("agent", [types.SimpleNamespace(model="live-model", provider=""),
+                                  types.SimpleNamespace(model="live-model")], ids=["empty", "missing"])
+def test_rpc_empty_live_provider_preserves_successor_rows_and_overlays_model(home, monkeypatch, agent):
+    payload = {"provider": "xai", "model": "disk-model",
+               "providers": [{"slug": "xai", "is_current": True, "models": ["disk-model"]}]}
+    resp, calls = _rpc(home, monkeypatch, {"session_id": "empty-provider"},
+                       {"empty-provider": {"agent": agent}}, payload)
+    assert calls == [ro.model_options_control_path()]
+    assert resp["result"] == {**payload, "model": "live-model"}
+    assert payload["model"] == "disk-model", "overlay must not mutate the successor payload"
