From f0c7044430db5386bb32599c2025dfb6bef469a9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 12:30:08 +0000
Subject: [PATCH] [daveey] fix(quota): a reap never mirrors a disproved hint;
 prune false provider-wide walls

record_wall_for_run copied an episode's false 5-day hint into provider_walls.json and
_disproved treated that copy as independent evidence, so the release never fired on
the reaping host. A disproved hint is now mirrored as its backoff only, only a later
file wall vetoes the release, and the reclaim phase drops walls past the backoff cap
that the live OAuth pool disproves (mirrors from older reaps or other cards).
---
 hermes_cli/kanban_db_dispatch.py              |  7 +---
 hermes_cli/kanban_provider_walls.py           | 40 ++++++++++++++++++-
 hermes_cli/kanban_quota_episode.py            | 11 ++---
 .../test_kanban_quota_episode_false_wall.py   | 40 ++++++++++++++++---
 4 files changed, 80 insertions(+), 18 deletions(-)

diff --git a/hermes_cli/kanban_db_dispatch.py b/hermes_cli/kanban_db_dispatch.py
index 5fc4d08f48..498bc68163 100644
--- a/hermes_cli/kanban_db_dispatch.py
+++ b/hermes_cli/kanban_db_dispatch.py
@@ -2112,11 +2112,8 @@ def _run_reclaim_phase(
     result.promoted = _kb.recompute_ready(conn, failure_limit=failure_limit)
     from hermes_cli.kanban_idle_candidates import sweep_shared_blockers
     sweep_shared_blockers(conn, result)
-    try:
-        from hermes_cli import kanban_provider_walls as _walls
-        _walls.alert_on_storm(conn, board=board)
-    except Exception:
-        _kb._log.warning("kanban: rate-limit storm alert failed", exc_info=True)
+    from hermes_cli.kanban_provider_walls import tick_upkeep
+    tick_upkeep(conn, board=board, dry_run=dry_run)
     try:
         result.quota_block_released = _kbq.release_recovered_quota_blocks(conn)
     except Exception:
diff --git a/hermes_cli/kanban_provider_walls.py b/hermes_cli/kanban_provider_walls.py
index 08945fe13d..d5342c0885 100644
--- a/hermes_cli/kanban_provider_walls.py
+++ b/hermes_cli/kanban_provider_walls.py
@@ -106,11 +106,14 @@ def record_wall(provider: str, retry_after: Optional[int], *, now: Optional[floa
 def record_wall_for_run(conn: sqlite3.Connection, task_id: str, run_id: Optional[int],
                         log_path: Optional[Path]) -> Optional[float]:
     """Wall bookkeeping for a rate-limited exit: provider from the run's ``model_tier`` event."""
-    from hermes_cli.kanban_quota_episode import episode
+    from hermes_cli.kanban_quota_episode import _disproved, _unhinted, episode
     state = episode(conn, task_id)
     if state and state['run_id'] == run_id:
         # Exact-run receipt/backoff owns the deadline; never extend it with an
-        # unscoped log tail or the legacy provider-wide default.
+        # unscoped log tail or the legacy provider-wide default. A hint the live
+        # pool already disproves is mirrored as its backoff only.
+        if _disproved(state, time.time(), {}):
+            state = _unhinted(conn, task_id, state)
         return record_wall(state.get('provider'), max(0, state['until'] - time.time()))
     provider = ""
     try:
@@ -225,6 +228,29 @@ def live_pool_serving(provider: str, model: Optional[str] = None) -> bool:
         return False
 
 
+def prune_disproved_walls(*, now: Optional[float] = None, path: Optional[Path] = None) -> list[str]:
+    """Drop provider-wide walls longer than the backoff cap that the live OAuth pool disproves.
+
+    Only a quota hint sets a wall past ``MAX_BACKOFF_SECONDS``; a pool that serves (any model, judged
+    conservatively) proves it false, e.g. a mirror of a hint born of a transient auth bench. Returns the
+    providers dropped. [daveey]"""
+    from hermes_cli.kanban_quota_episode import MAX_BACKOFF_SECONDS
+    now = time.time() if now is None else now
+    p = path or walls_path()
+    walls = active_walls(now=now, path=p)
+    dropped = [name for name, until in walls.items()
+               if until - now > MAX_BACKOFF_SECONDS and live_pool_serving(name, None)]
+    if dropped:
+        current = active_walls(now=now, path=p)
+        for name in dropped:
+            current.pop(name, None)
+        tmp = p.with_suffix(".tmp")
+        tmp.write_text(json.dumps(current), encoding="utf-8")
+        tmp.replace(p)
+        logger.info("kanban walls: dropped %s (live OAuth pool serving)", ", ".join(sorted(dropped)))
+    return dropped
+
+
 def rate_limit_storm(conn: sqlite3.Connection, *, now: Optional[float] = None, prefix: Optional[str] = None) -> int:
     """``rate_limited`` runs in the last hour claimed by this host (claim ``prefix``, default this host's).
 
@@ -264,3 +290,13 @@ def alert_on_storm(conn: sqlite3.Connection, *, board: Optional[str] = None, now
         assignee="default", created_by="rate-limit-alert", priority=80, idempotency_key=f"rate_limit_storm:{host}:{day}",
         board=board,
     )
+
+
+def tick_upkeep(conn: sqlite3.Connection, *, board: Optional[str] = None, dry_run: bool = False) -> None:
+    """Per-tick wall upkeep: drop walls the live pool disproves, then alert on a rate-limit storm."""
+    try:
+        if not dry_run:
+            prune_disproved_walls()
+        alert_on_storm(conn, board=board)
+    except Exception:  # health: allow BLE001 -- wall upkeep never strands the reclaim phase; traceback logged
+        logger.warning("kanban: provider wall pruning / rate-limit storm alert failed", exc_info=True)
diff --git a/hermes_cli/kanban_quota_episode.py b/hermes_cli/kanban_quota_episode.py
index 7ed67ee0b5..893aaefb4d 100644
--- a/hermes_cli/kanban_quota_episode.py
+++ b/hermes_cli/kanban_quota_episode.py
@@ -84,9 +84,10 @@ def _providers(state):
 
 def _disproved(wall, now, memo):
     """True for a hinted wall the live OAuth pool now contradicts: every provider it names serves its
-    model (any model for a class route) and no provider-wide wall stands. A transient auth bench once
-    made ``quota_unavailable`` report a days-long false wall; the stored deadline must not outlive it.
-    *memo* caches the pool reads for one ``_outstanding`` call (walls of an episode share providers)."""
+    model (any model for a class route) and no later provider-wide wall stands. A transient auth bench
+    once made ``quota_unavailable`` report a days-long false wall; the stored deadline must not outlive it.
+    A file wall ending no later than this one may be its own mirror (``record_wall_for_run``), so only a
+    later one is independent evidence. *memo* caches the pool reads for one ``_outstanding`` call."""
     from agent.model_routing import is_class_selector
     from hermes_cli import kanban_provider_walls as pw
     names = _providers(wall)
@@ -99,8 +100,8 @@ def _disproved(wall, now, memo):
         memo['walls'] = pw.active_walls(now=now)
     for name in names:
         if (name, model) not in memo:
-            memo[name, model] = memo['walls'].get(name) is None and pw.live_pool_serving(name, model)
-    return all(memo[name, model] for name in names)
+            memo[name, model] = pw.live_pool_serving(name, model)
+    return all(memo['walls'].get(name, 0) <= wall['until'] and memo[name, model] for name in names)
 
 
 def _unhinted(conn, task_id, wall):
diff --git a/tests/hermes_cli/test_kanban_quota_episode_false_wall.py b/tests/hermes_cli/test_kanban_quota_episode_false_wall.py
index 5a8a813c47..b89611ad97 100644
--- a/tests/hermes_cli/test_kanban_quota_episode_false_wall.py
+++ b/tests/hermes_cli/test_kanban_quota_episode_false_wall.py
@@ -59,16 +59,17 @@ def _false_wall(conn, tid, model):
 
 @pytest.mark.parametrize('model', [MODEL, 'class:deep'])
 @pytest.mark.parametrize('kind,provider_wall,held', [
-    ('serving', False, False),  # worker-3: the provider-wide file held only openai-codex
-    ('serving', True, True),    # a standing provider-wide wall is independent evidence
-    ('walled', False, True),
-    ('empty', False, True),     # an empty or unreadable pool proves nothing
+    ('serving', 'reaped', False),       # the file exactly as this host's own reap left it
+    ('serving', 'independent', True),   # a later provider-wide wall from another source still holds
+    ('walled', 'reaped', True),
+    ('empty', 'reaped', True),          # an empty or unreadable pool proves nothing
 ])
 def test_hinted_episode_wall_holds_only_while_the_live_pool_confirms_it(
         board, tmp_path, monkeypatch, model, kind, provider_wall, held):
     from hermes_cli import kanban_provider_walls as pw
 
     monkeypatch.setattr(kb.time, 'time', lambda: NOW)
+    monkeypatch.setattr(pw.time, 'time', lambda: NOW)
     monkeypatch.setenv('HERMES_KANBAN_RATE_LIMIT_COOLDOWN_SECONDS', '300')
     _pool(tmp_path, monkeypatch, kind)
     with kbc.connect() as conn:
@@ -77,8 +78,11 @@ def test_hinted_episode_wall_holds_only_while_the_live_pool_confirms_it(
         state = quota.episode(conn, tid)
         assert state is not None
         assert state['hinted'] and state['providers'] == ['anthropic'] and state['until'] == reset
-        pw.walls_path().write_text(json.dumps({'openai-codex': NOW + 6 * 86400,
-                                               **({'anthropic': reset} if provider_wall else {})}))
+        if kind == 'serving':
+            # The reap never mirrors a hint the live pool disproves into the provider-wide file.
+            assert 'anthropic' not in pw.active_walls(now=NOW)
+        if provider_wall == 'independent':
+            pw.record_wall('anthropic', reset + 86400 - NOW, now=NOW)
         if held:
             assert quota.hold_until(conn, tid) == reset
             assert dispatch.check_respawn_guard(conn, tid) == 'subscription_quota_reset'
@@ -136,3 +140,27 @@ def test_a_disproved_short_hint_keeps_the_doubling_backoff(board, tmp_path, monk
         # Held on the backoff, not on the rejected hint.
         assert dispatch.check_respawn_guard(conn, tid) == 'rate_limit_cooldown'
         assert quota.hold_until(conn, tid, NOW + 2401) is None
+
+
+@pytest.mark.parametrize('kind,anthropic_in,anthropic_kept', [
+    ('serving', 5 * 86400, False),  # a days-long mirror of a false hint: the pool serves, so it goes
+    ('serving', 600, True),         # within the backoff cap: a rate-limit wall, left to expire
+    ('walled', 5 * 86400, True),    # the pool confirms the wall
+    ('empty', 5 * 86400, True),     # an empty pool proves nothing
+])
+def test_reclaim_phase_prunes_a_provider_wall_the_live_pool_disproves(
+        board, tmp_path, monkeypatch, kind, anthropic_in, anthropic_kept):
+    """A false hint already mirrored into provider_walls.json (an older reap, another card) keeps every
+    card on the host retiering around anthropic; the dispatcher drops it once the live pool serves."""
+    from hermes_cli import kanban_provider_walls as pw
+
+    monkeypatch.setattr(kb.time, 'time', lambda: NOW)
+    monkeypatch.setattr(pw.time, 'time', lambda: NOW)
+    _pool(tmp_path, monkeypatch, kind)
+    pw.walls_path().write_text(json.dumps({'openai-codex': NOW + 6 * 86400, 'anthropic': NOW + anthropic_in}))
+    with kbc.connect() as conn:
+        dispatch._run_reclaim_phase(conn, dispatch.DispatchResult(), stale_timeout_seconds=3600,
+                                    failure_limit=2, reconcile_orphans=False)
+    walls = pw.active_walls(now=NOW)
+    assert walls.get('openai-codex') == NOW + 6 * 86400  # no codex OAuth pool here: nothing disproves it
+    assert ('anthropic' in walls) is anthropic_kept
