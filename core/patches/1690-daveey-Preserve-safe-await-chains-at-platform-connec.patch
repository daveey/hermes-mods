@@ -205,6 +205,9 @@ class GatewayAdapterLifecycleMixin:
         task = asyncio.ensure_future(adapter.connect(is_reconnect=is_reconnect))
         if await self._wait_or_detach(task, timeout):
             return bool(await task)
