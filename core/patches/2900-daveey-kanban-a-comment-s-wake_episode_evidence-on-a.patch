From 535096c2cdf1813a1d4e0aa978fdf61e781f1811 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 18:04:31 +0000
Subject: [PATCH] [daveey] kanban: a comment's wake_episode_evidence on a
 finished parent does not reopen it for the review hold

A verifier comment on a long-done dependency appends a wake_episode_evidence
snapshot (outside the wake corridor, when this DB did not carry the exit reset).
_historical_parent_history counted it as lifecycle activity after the park, so
the parent became 'awaited' with no post-park approval and resumes_review
refused an exact-head APPROVE: t_01a1d0a5ba47fe18 held active_pr on PR #1630
(parent t_01a1d087f0697ede, evidence event 168 s after the park).
---
 hermes_cli/kanban_dependency_review.py         |  5 +++--
 .../test_kanban_dependency_review_history.py   | 18 +++++++++++++++++-
 2 files changed, 20 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_dependency_review.py b/hermes_cli/kanban_dependency_review.py
index 5b4815c401..d8d8a1bfd6 100644
--- a/hermes_cli/kanban_dependency_review.py
+++ b/hermes_cli/kanban_dependency_review.py
@@ -308,9 +308,10 @@ def _historical_parent_history(conn, parent_id, parked_at):
     if ended is None or ended >= parked_at:
         return False
     events = conn.execute(
-        # Archival and late process-exit receipts do not reopen finished work.
+        # Archival, late process-exit receipts and the wake-episode snapshot a comment on a
+        # finished card appends (kanban_wake_episode.EVIDENCE_EVENT) do not reopen it.
         "SELECT created_at FROM task_events WHERE task_id = ? "
-        "AND kind NOT IN ('commented', 'archived', 'worker_result')",
+        "AND kind NOT IN ('commented', 'archived', 'worker_result', 'wake_episode_evidence')",
         (parent_id,),
     )
     return all((kb._to_epoch(e["created_at"]) or float("inf")) < parked_at for e in events)
diff --git a/tests/hermes_cli/test_kanban_dependency_review_history.py b/tests/hermes_cli/test_kanban_dependency_review_history.py
index f254f8ade1..6d9e420966 100644
--- a/tests/hermes_cli/test_kanban_dependency_review_history.py
+++ b/tests/hermes_cli/test_kanban_dependency_review_history.py
@@ -106,7 +106,7 @@ def test_historical_parent_lifecycle_activity_invalidates_exemption(board, monke
 
 
 @pytest.mark.parametrize("legacy", [False, True])
-@pytest.mark.parametrize("event", ["archived", "worker_result"])
+@pytest.mark.parametrize("event", ["archived", "worker_result", "wake_episode_evidence"])
 def test_historical_parent_bookkeeping_does_not_rearm_hold(board, monkeypatch, legacy, event):
     task, historical = mixed_park(board, monkeypatch, legacy=legacy)
     with kb.write_txn(board):
@@ -117,6 +117,22 @@ def test_historical_parent_bookkeeping_does_not_rearm_hold(board, monkeypatch, l
     assert dispatch.check_respawn_guard(board, task) is None
 
 
+def test_comment_on_finished_historical_parent_does_not_rearm_hold(board, monkeypatch):
+    # A verifier's comment on a long-done parent appends `commented` and, from outside the
+    # wake corridor, a `wake_episode_evidence` snapshot. Neither reopens the parent. The
+    # snapshot is appended when this DB has not carried the parent's exit reset itself
+    # (it completed on another gateway and arrived by sync): drop the local exit row.
+    task, historical = mixed_park(board, monkeypatch)
+    with kb.write_txn(board):
+        board.execute("DELETE FROM task_wake_episode_exit WHERE task_id = ?", (historical,))
+    kb.add_comment(board, historical, "worker-1/t_verifier", "independent verification")
+    kinds = {r[0] for r in board.execute(
+        "SELECT kind FROM task_events WHERE task_id = ? AND created_at >= ?", (historical, int(time.time())))}
+    assert "wake_episode_evidence" in kinds
+    monkeypatch.setattr(prs, "pr_state", lambda url: "MERGED" if url == OLD_PR else "OPEN")
+    assert dispatch.check_respawn_guard(board, task) is None
+
+
 def test_ambiguous_numeric_reference_does_not_cover_two_repositories(board):
     from hermes_cli.kanban_dependency_review import _named_prs
     assert _named_prs({"pr": 10}, {PR, "https://github.com/other/repo/pull/10"}) == set()
