From 0e970915d1a24b33daecdbb10f357c2e1c80169f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 23:06:09 +0000
Subject: [PATCH] fix(picker): retain auth loader fallback when version stat
 fails [daveey]

---
 hermes_cli/model_switch_providers.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/model_switch_providers.py b/hermes_cli/model_switch_providers.py
index e885b7f134..98ae3bae72 100644
--- a/hermes_cli/model_switch_providers.py
+++ b/hermes_cli/model_switch_providers.py
@@ -349,7 +349,12 @@ def _picker_auth_store() -> dict:
         return _load_auth_store()
     from utils import file_cache_version
     path = _auth_file_path()
-    version = (str(path), file_cache_version(path))
+    try:
+        version = (str(path), file_cache_version(path))
+    except OSError:
+        # A missing/unstatable file must retain the loader's normal fallback behavior.
+        # Without a trustworthy version, do not memoize that fallback.
+        return _load_auth_store()
     cached = memo.get(_AUTH_STORE_MEMO_KEY)
     if cached is not None and cached[0] == version:
         return cached[1]
-- 
