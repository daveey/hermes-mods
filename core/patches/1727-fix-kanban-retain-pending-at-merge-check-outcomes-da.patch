From c3ebcfc1583abfc745cc64f5911f92e196b66301 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 18:36:09 +0000
Subject: [PATCH] fix(kanban): retain pending-at-merge check outcomes [daveey]

---
 hermes_cli/kanban_pr_acceptance.py            |  1 +
 hermes_cli/kanban_pr_merge_time.py            |  3 +++
 tests/hermes_cli/test_kanban_pr_merge_time.py | 15 +++++++++++----
 3 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_pr_acceptance.py b/hermes_cli/kanban_pr_acceptance.py
index 1e214e53361..11718096902 100644
--- a/hermes_cli/kanban_pr_acceptance.py
+++ b/hermes_cli/kanban_pr_acceptance.py
@@ -250,6 +250,7 @@ def collect_acceptance(contract: str, published_pr: str | None,
         phase = "reading commit statuses"
         statuses = [{**s, "sha": sha} for page in _api(f"repos/{repo}/commits/{sha}/statuses?per_page=100",
                                                        paginate=True, profile_home=profile_home) for s in page]
+        phase = "selecting merge-time evidence"
         runs, statuses = merge_evidence(receipt, pr, repo, runs, statuses)
         outcomes = []
         for context, app_id in sorted(required, key=str):
diff --git a/hermes_cli/kanban_pr_merge_time.py b/hermes_cli/kanban_pr_merge_time.py
index a2fe196e6ad..930b66c06b7 100644
--- a/hermes_cli/kanban_pr_merge_time.py
+++ b/hermes_cli/kanban_pr_merge_time.py
@@ -37,6 +37,9 @@ def partition_at_merge(checks, merged_at, *, runs):
         if started > cutoff:
             post.append(check)
             continue
+        # A pre-merge start does not make its later conclusion evidence at merge.
+        if runs and check.get("completed_at") and timestamp(check["completed_at"]) > cutoff:
+            check = {**check, "status": "in_progress", "conclusion": None}
         key = (check["name"], check["app"]["id"]) if runs else check["context"]
         order = (started, check["id"])
         if key not in latest or order > latest[key][0]:
diff --git a/tests/hermes_cli/test_kanban_pr_merge_time.py b/tests/hermes_cli/test_kanban_pr_merge_time.py
index 18a10ee44aa..51267351d84 100644
--- a/tests/hermes_cli/test_kanban_pr_merge_time.py
+++ b/tests/hermes_cli/test_kanban_pr_merge_time.py
@@ -33,7 +33,7 @@ def evidence(monkeypatch):
         if "/check-runs?" in endpoint:
             runs = state["runs"]
             if "filter=latest" in endpoint:
-                # GitHub hides earlier executions for the same check name.
+                # Reduced single-suite history; latest retains other suites in real responses.
                 runs = [max(runs, key=lambda r: r["id"])] if runs else []
             return [{"total_count": len(runs) + state.get("omitted", 0), "check_runs": runs}]
         if "/statuses?" in endpoint:
@@ -62,6 +62,13 @@ def test_merged_fast_forward_uses_premerge_success(evidence):
     assert "rerun" not in receipt["recovery"].lower()
 
 
+@pytest.mark.parametrize("conclusion", ["success", "failure"])
+def test_run_finishing_after_merge_remains_pending_at_merge(evidence, conclusion):
+    evidence["runs"] = [{**PRE, "completed_at": POST["completed_at"], "conclusion": conclusion}]
+    receipt = collect()
+    assert not receipt["ok"] and receipt["classification"] == "pending"
+
+
 def test_open_still_uses_latest_without_cutoff(evidence):
     evidence["state"] = "OPEN"
     receipt = collect()
@@ -81,7 +88,7 @@ def test_later_success_never_repairs_premerge_evidence(evidence, result):
 
 
 def test_failed_premerge_rerun_overrides_earlier_success(evidence):
-    evidence["runs"] = [PRE, {**POST, "started_at": MERGED}]
+    evidence["runs"] = [PRE, {**POST, "started_at": MERGED, "completed_at": MERGED}]
     receipt = collect()
     assert not receipt["ok"] and receipt["classification"] == "failure"
     assert receipt["checks"][0]["id"] == POST["id"]
@@ -90,7 +97,7 @@ def test_failed_premerge_rerun_overrides_earlier_success(evidence):
 
 def test_successful_premerge_rerun_overrides_earlier_failure(evidence):
     evidence["runs"] = [{**PRE, "conclusion": "failure"},
-                        {**POST, "started_at": MERGED, "conclusion": "success"}]
+                        {**POST, "started_at": MERGED, "completed_at": MERGED, "conclusion": "success"}]
     assert collect()["ok"]
 
 
@@ -137,7 +144,7 @@ def test_legacy_statuses_obey_merge_cutoff(evidence, pre, post, expected):
 
 def test_legacy_latest_premerge_failure_wins(evidence):
     evidence.update(app=None, runs=[], statuses=[status(PRE, "success"),
-                    status({**POST, "started_at": MERGED}, "failure")])
+                    status({**POST, "started_at": MERGED, "completed_at": MERGED}, "failure")])
     assert collect()["classification"] == "failure"
 
 
-- 
2.55.0

