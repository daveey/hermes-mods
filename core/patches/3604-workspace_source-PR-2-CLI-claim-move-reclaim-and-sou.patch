From 4e66ea4f19f730cf8891846eae5af569476ab9e3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 14:09:37 +0000
Subject: [PATCH] workspace_source PR-2: CLI claim, move/reclaim and
 source-release read absent source columns as NULL

The source columns come from the sync schema, so a board that never synced has
neither, and 'hermes kanban claim' failed there with 'no such column:
workspace_source' (tests/e2e/core/kanban/test_kanban_worker_sigkill.py).
kanban_workspace_source.source_columns() selects NULL for an absent column; the
claim refusal, the move/reclaim checks and source-release use it.
---
 hermes_cli/kanban_source_cli.py             |  4 ++--
 hermes_cli/kanban_source_move.py            |  2 +-
 hermes_cli/kanban_workspace_source.py       |  7 +++++++
 tests/hermes_cli/test_kanban_source_move.py | 13 +++++++++++++
 4 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_source_cli.py b/hermes_cli/kanban_source_cli.py
index f195216289..9fc3fb26ad 100644
--- a/hermes_cli/kanban_source_cli.py
+++ b/hermes_cli/kanban_source_cli.py
@@ -24,7 +24,7 @@ CLAIM_REFUSED = "source_cli_claim_refused"
 
 
 def claim_refusal(conn: sqlite3.Connection, task_id: str) -> Optional[str]:
-    row = conn.execute("SELECT workspace_source, workspace_custody FROM tasks WHERE id = ?", (task_id,)).fetchone()
+    row = conn.execute(f"SELECT {ws.source_columns(conn)} FROM tasks WHERE id = ?", (task_id,)).fetchone()
     if row is None:
         return None
     if row[0] is not None or ws.parse_custody(row[1]) is not None:
@@ -65,7 +65,7 @@ def source_release(conn: sqlite3.Connection, task_id: str, to_state: str, *, by:
                    hub: Any = None) -> dict:
     if to_state not in ("published", "unchanged"):
         return {"ok": False, "reason_code": "invalid", "error": "--to must be published or unchanged"}
-    row = conn.execute("SELECT workspace_source FROM tasks WHERE id = ?", (task_id,)).fetchone()
+    row = conn.execute(f"SELECT {ws.source_columns(conn)} FROM tasks WHERE id = ?", (task_id,)).fetchone()
     if row is None:
         return {"ok": False, "reason_code": "not_found", "error": f"no such task: {task_id}"}
     try:
diff --git a/hermes_cli/kanban_source_move.py b/hermes_cli/kanban_source_move.py
index 62b46f2b55..05cb3a25ef 100644
--- a/hermes_cli/kanban_source_move.py
+++ b/hermes_cli/kanban_source_move.py
@@ -22,7 +22,7 @@ PORTABLE_STATES = ("published", "unchanged")
 
 
 def _row(conn: sqlite3.Connection, task_id: str) -> Optional[sqlite3.Row]:
-    return conn.execute("SELECT workspace_kind, workspace_path, workspace_source, workspace_custody FROM tasks "
+    return conn.execute(f"SELECT workspace_kind, workspace_path, {ws.source_columns(conn)} FROM tasks "
                         "WHERE id = ?", (task_id,)).fetchone()
 
 
diff --git a/hermes_cli/kanban_workspace_source.py b/hermes_cli/kanban_workspace_source.py
index bfee8234d9..95e45810a9 100644
--- a/hermes_cli/kanban_workspace_source.py
+++ b/hermes_cli/kanban_workspace_source.py
@@ -234,6 +234,13 @@ def parse_custody(value: Any) -> Optional[Custody]:
 SNAPSHOT_KEYS = ("workspace_source", "workspace_custody")
 
 
+def source_columns(conn: sqlite3.Connection) -> str:
+    """The replica's source columns for a SELECT list. They are added by the sync schema (kanban_db_sync), so a board
+    that never synced has neither: no card there has custody, so both read as NULL."""
+    have = {r[1] for r in conn.execute("PRAGMA table_info(tasks)")}
+    return ", ".join(k if k in have else f"NULL AS {k}" for k in SNAPSHOT_KEYS)
+
+
 @dataclass(frozen=True)
 class SourceSnapshot:
     """``workspace_source``/``workspace_custody`` as of the grant (same Board transaction), from the lease response
diff --git a/tests/hermes_cli/test_kanban_source_move.py b/tests/hermes_cli/test_kanban_source_move.py
index 8bdc9a74f3..c9e28126e5 100644
--- a/tests/hermes_cli/test_kanban_source_move.py
+++ b/tests/hermes_cli/test_kanban_source_move.py
@@ -178,6 +178,19 @@ def test_cli_claim_command_refuses(conn, kanban_home, capsys):
     assert kb.get_task(conn, tid).status != "running"
 
 
+def test_unsynced_board_without_source_columns_claims_and_moves(kanban_home, capsys):
+    """A board that never synced lacks the source columns: the CLI claim, the move/reclaim checks and source-release
+    read them as NULL instead of failing on the missing column."""
+    from hermes_cli import kanban as kcli
+    with kbc.connect_closing() as plain:
+        assert "workspace_source" not in {r[1] for r in plain.execute("PRAGMA table_info(tasks)")}
+        tid = kb.create_task(plain, title="plain", assignee="worker")
+        assert ksm.parked_refusal(plain, tid, me="hub") is None and ksm.reclaim_refusal(plain, tid) is None
+        assert cli.source_release(plain, tid, "published", by="op", head=lambda *_: None, hub=_Hub())["ok"] is False
+    assert kcli._cmd_claim(SimpleNamespace(task_id=tid, ttl=60)) == 0
+    assert f"Claimed {tid}" in capsys.readouterr().out
+
+
 class _Hub:
     def __init__(self):
         self.calls = []
