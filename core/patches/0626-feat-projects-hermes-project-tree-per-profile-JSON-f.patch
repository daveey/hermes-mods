From 8c93b5bd9a7362f7fe42f0b4b49bfbca9f0ff8cd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 21:53:42 -0700
Subject: [PATCH 602/603] feat(projects): `hermes project tree` (per-profile
 JSON for the hub) and `project update --name/--icon/--color` [daveey]

The hub sync collector publishes each profile's sidebar tree so other gateways can show an
asleep gateway's project groups, and applies a shared project name/icon/color through
`project update`. The REST all-profiles route and the CLI share profile_project_trees().

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff --git a/hermes_cli/projects_cmd.py b/hermes_cli/projects_cmd.py
index 469de5209196f91f7b0cffc1fcab287084d75323..190f97419342d3cb94872d2a297b55b21cc700f3 100644
--- a/hermes_cli/projects_cmd.py
+++ b/hermes_cli/projects_cmd.py
@@ -46,6 +46,11 @@ def build_parser(parent_subparsers: argparse._SubParsersAction) -> argparse.Argu
     p_add.add_argument("--primary", action="store_true", help="Mark as primary repo")
     project_sub("remove-folder", "Remove a folder from a project").add_argument("path", help="Folder path")
     project_sub("rename", "Rename a project").add_argument("name", help="New name")
+    p_update = project_sub("update", "Change a project's name, icon or color")
+    for opt in ("--name", "--icon", "--color"):
+        p_update.add_argument(opt, default=None, help="'' clears icon/color" if opt != "--name" else None)
+    sub.add_parser(
+        "tree", help="Every profile's project tree as JSON (read-only; the hub sync collector reads it)")
     project_sub("set-primary", "Set the primary folder").add_argument("path", help="Folder path (must already be in project)")
     p_use = sub.add_parser("use", help="Set the active project")
     p_use.add_argument("project", nargs="?", default=None, help="Project id or slug (omit to clear)")
@@ -184,6 +189,39 @@ def _cmd_rename(args, conn, proj) -> str:
     return f"Renamed {proj.slug} -> {args.name}"
 
 
+@_with_project
+def _cmd_update(args, conn, proj):
+    if args.name is None and args.icon is None and args.color is None:
+        return _err("give at least one of --name, --icon, --color")
+    pdb.update_project(conn, proj.id, name=args.name, icon=args.icon, color=args.color)
+    return f"Updated {proj.slug}"
+
+
+def _cmd_tree(args) -> int:
+    """``{"profiles": [{"profile", "ok", "nodes"}]}``: each profile's own sidebar tree, lanes
+    without session rows and previews as ids (``previewIds``), plus every claimed ``sessionIds``.
+    ``ok`` False means that profile's state.db could not be read (its nodes are unknown). [daveey]"""
+    import json
+
+    # tui_gateway.server (the tree builder) points sys.stdout at stderr on import to keep its
+    # JSON-RPC channel clean, so keep the real stdout for the answer.
+    out = sys.stdout
+    from hermes_cli.web_routers.profiles import profile_project_trees
+
+    profiles = []
+    for name, tree in profile_project_trees(log_label="hermes project tree"):
+        nodes = []
+        for node in (tree or {}).get("projects") or []:
+            previews = node.get("previewSessions") or []
+            node = {k: v for k, v in node.items() if k != "previewSessions"}
+            node["previewIds"] = [s["id"] for s in previews if s.get("id")]
+            nodes.append(node)
+        profiles.append({"profile": name, "ok": tree is not None, "nodes": nodes})
+    out.write(json.dumps({"profiles": profiles}, default=str) + "\n")
+    out.flush()
+    return 0
+
+
 @_with_project
 def _cmd_set_primary(args, conn, proj):
     if not pdb.set_primary(conn, proj.id, args.path):
@@ -233,6 +271,8 @@ _HANDLERS = {
     "add-folder": _cmd_add_folder,
     "remove-folder": _cmd_remove_folder,
     "rename": _cmd_rename,
+    "update": _cmd_update,
+    "tree": _cmd_tree,
     "set-primary": _cmd_set_primary,
     "use": _cmd_use,
     "archive": _flag_command("archive_project", "Archived"),
diff --git a/tests/hermes_cli/test_profiles_sidebar_scope.py b/tests/hermes_cli/test_profiles_sidebar_scope.py
index ea2ae1d2a4f2bc94add8e4c2d5f3da1e2bbde305..3ca7ca886f96e8cc5aa2beb030e6814e2923faa0 100644
--- a/tests/hermes_cli/test_profiles_sidebar_scope.py
+++ b/tests/hermes_cli/test_profiles_sidebar_scope.py
@@ -418,3 +418,56 @@ class TestSidebarShowSubagents:
         assert _slice_ids(payload, "recents") == {"default-parent", "worker-parent", "worker-sub"}
         # The messaging slice keeps its shape: a subagent run is not a platform thread.
         assert _slice_ids(payload, "messaging") == set()
+
+
+class TestProjectTreeCli:
+    """[daveey] ``hermes project tree``: each profile's own tree, unmerged, for the hub collector."""
+
+    def _tree(self, capsys):
+        import argparse
+        import json
+
+        from hermes_cli import projects_cmd
+
+        parser = argparse.ArgumentParser()
+        projects_cmd.build_parser(parser.add_subparsers(dest="command"))
+        assert projects_cmd.projects_command(parser.parse_args(["project", "tree"])) == 0
+        return {p["profile"]: p for p in json.loads(capsys.readouterr().out)["profiles"]}
+
+    def test_each_profile_reports_its_own_nodes_without_merging(self, client, profiles_on_disk, tmp_path, capsys):
+        shared = tmp_path / "repos" / "shared"
+        shared.mkdir(parents=True)
+        ids = {}
+        for name, home in profiles_on_disk.items():
+            _seed_session(home, f"{name}-chat", source="cli", cwd=shared)
+            ids[name] = _seed_project(home, "Shared", shared)
+
+        tree = self._tree(capsys)
+        merged = client.get("/api/profiles/projects/tree").json()
+
+        assert set(tree) == {"default", "worker"}
+        for name in ("default", "worker"):
+            assert tree[name]["ok"] is True
+            node = next(n for n in tree[name]["nodes"] if n["id"].startswith("p_"))
+            assert node["id"] == ids[name] and node["label"] == "Shared"
+            assert node["sessionIds"] == [f"{name}-chat"] and node["previewIds"] == [f"{name}-chat"]
+            assert "previewSessions" not in node
+        # The route merges the same two per-profile nodes into one group.
+        declared = [p for p in merged["projects"] if not p["isNoProject"]]
+        assert len(declared) == 1 and declared[0]["sessionCount"] == 2
+
+    def test_tree_is_read_only(self, profiles_on_disk, tmp_path, capsys):
+        folder = tmp_path / "repo"
+        folder.mkdir()
+        home = profiles_on_disk["default"]
+        _seed_session(home, "chat", source="cli", cwd=folder)
+        _seed_project(home, "Repo", folder)
+        before = {f: (home / f).read_bytes() for f in ("state.db", "projects.db")}
+        self._tree(capsys)
+        assert {f: (home / f).read_bytes() for f in before} == before
+
+    def test_unreadable_profile_is_not_ok(self, profiles_on_disk, capsys):
+        (profiles_on_disk["worker"] / "state.db").write_bytes(b"not a database" * 100)
+        tree = self._tree(capsys)
+        assert tree["worker"]["ok"] is False and tree["worker"]["nodes"] == []
+        assert tree["default"]["ok"] is True
