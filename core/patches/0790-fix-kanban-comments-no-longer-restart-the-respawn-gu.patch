From 48e6269b089f1b6542610fbff7b9ca9c0f86069c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 09:46:53 -0700
Subject: [PATCH 718/721] fix(kanban): comments no longer restart the
 respawn-guard hold-cap clock (#170)

* fix(kanban): comments no longer restart the respawn-guard hold-cap clock [daveey]

* fix(kanban): report held ready cards (respawn_guarded / foreign runs_on) apart from stranded ones [daveey]
---
diff --git a/hermes_cli/kanban_db_dispatch_guard_notice.py b/hermes_cli/kanban_db_dispatch_guard_notice.py
index 3f2fe8f92b49808f914078b05e406906616a002f..37ffa7de85202bb9def2f5b873b77cc04a650104 100644
--- a/hermes_cli/kanban_db_dispatch_guard_notice.py
+++ b/hermes_cli/kanban_db_dispatch_guard_notice.py
@@ -25,12 +25,13 @@ GUARD_HOLD_NOTE_MARKER = "[respawn-guard]"
 
 def guard_hold_started_at(conn: sqlite3.Connection, task_id: str) -> Optional[int]:
     """When the current unbroken run of ``respawn_guarded`` events began: the first one
-    after the newest event of any other kind (a claim, a block, an unblock, a comment...)."""
+    after the newest event of any other kind (a claim, a block, an unblock...). Comments of any
+    author do not restart it: a note or reply fixes nothing, and resetting on them held
+    a card in ``ready`` past its cap despite repeated comments. [daveey]"""
     row = conn.execute(
         "SELECT MIN(created_at) FROM task_events WHERE task_id = ? AND kind = 'respawn_guarded' "
         "AND id > COALESCE((SELECT MAX(id) FROM task_events WHERE task_id = ? "
-        "AND kind != 'respawn_guarded' AND NOT (kind = 'commented' AND "
-        "json_extract(payload, '$.author') = 'kanban-dispatcher')), 0)", (task_id, task_id),
+        "AND kind != 'respawn_guarded' AND kind != 'commented'), 0)", (task_id, task_id),
     ).fetchone()
     return int(row[0]) if row and row[0] is not None else None
 
diff --git a/tests/hermes_cli/test_kanban_diagnostics.py b/tests/hermes_cli/test_kanban_diagnostics.py
index 2c6dacfa85ddb483ea468df49576ae6497f20922..c593499dd5a3ed521b8921181b41dfd8cb341e10 100644
--- a/tests/hermes_cli/test_kanban_diagnostics.py
+++ b/tests/hermes_cli/test_kanban_diagnostics.py
@@ -283,3 +283,31 @@ def test_stranded_in_ready_counts_a_continue_that_resumed_straight_to_ready():
               _event("continued", ts=now - 5 * 60, status="ready", resume_status="ready")]
     assert [d for d in kd.compute_task_diagnostics(task, events, [], now=now)
             if d.kind == "stranded_in_ready"] == []
+
+
+def _kinds(diags):
+    return sorted(d.kind for d in diags if d.kind in ("stranded_in_ready", "held_in_ready"))
+
+
+def test_ready_hold_is_reported_apart_from_stranded():
+    """A respawn_guarded last event, or a foreign machine:* pin, is a held card, not a stranded one."""
+    now = 100_000
+    old = now - 90 * 60
+    guarded = [_event("created", ts=old), _event("respawn_guarded", ts=now - 60)]
+    d = kd.compute_task_diagnostics(_task(), guarded, [], now=now)
+    assert _kinds(d) == ["held_in_ready"]
+    assert next(x for x in d if x.kind == "held_in_ready").data["hold_reason"] == "respawn_guarded"
+
+    pinned = _task(runs_on='["machine:macbook"]')
+    d = kd.compute_task_diagnostics(pinned, [_event("created", ts=old)], [], now=now)
+    assert _kinds(d) == ["held_in_ready"]
+    assert next(x for x in d if x.kind == "held_in_ready").data["foreign_machines"] == ["macbook"]
+
+    # pinned to this hub, or a plain old ready card: still stranded
+    own = _task(runs_on=["machine:hub"])
+    assert _kinds(kd.compute_task_diagnostics(own, [_event("created", ts=old)], [], now=now)) == ["stranded_in_ready"]
+    # a guarded card that later got another event is no longer held
+    later = guarded + [_event("commented", ts=now - 10)]
+    assert _kinds(kd.compute_task_diagnostics(_task(), later, [], now=now)) == ["stranded_in_ready"]
+    # a young hold is not reported at all
+    assert _kinds(kd.compute_task_diagnostics(pinned, [_event("created", ts=now - 60)], [], now=now)) == []
diff --git a/tests/hermes_cli/test_kanban_quota_guard.py b/tests/hermes_cli/test_kanban_quota_guard.py
index bdb4bf2df3b4e535f231350afd6b40b76fe144f5..17d4e64bfe0d4117177cd5378435cdf1e0df729d 100644
--- a/tests/hermes_cli/test_kanban_quota_guard.py
+++ b/tests/hermes_cli/test_kanban_quota_guard.py
@@ -207,3 +207,24 @@ def test_auth_hold_block_is_not_released(kanban_home, monkeypatch):
         assert task.status == "blocked" and task.block_kind == "capability"
         ev = conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='blocked'", (tid,)).fetchone()
         assert json.loads(ev[0])["kind"] == "capability"
+
+
+def test_hold_clock_survives_non_dispatcher_comments(kanban_home, monkeypatch):
+    """A comment from an orchestrator/human must not restart the hold clock."""
+    monkeypatch.setenv("HERMES_KANBAN_GUARD_HOLD_CAP_LONG_SECONDS", "3600")
+    now = 5_000_000
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="pr held", assignee="a")
+        monkeypatch.setattr(kb.time, "time", lambda: now)
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, "respawn_guarded", {"reason": "active_pr"})
+        monkeypatch.setattr(kb.time, "time", lambda: now + 1800)
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, "commented", {"author": "default", "len": 10})
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, "respawn_guarded", {"reason": "active_pr"})
+        from hermes_cli.kanban_db_dispatch_guard_notice import guard_hold_started_at
+        assert guard_hold_started_at(conn, tid) == now
+        monkeypatch.setattr(kb.time, "time", lambda: now + 3700)
+        assert kbd._block_if_guard_hold_capped(conn, tid, "active_pr") is True
+        assert kb.get_task(conn, tid).status != "ready"
