From 696ca7fecbdda3d49c9e3e4927e61ea6a437d4e2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 01:54:08 +0000
Subject: [PATCH] fix(kanban): create_overlap matches titles that name the same
 code file [daveey]

Hub card t_01a1d25511610669 ("... runs tests/run_ci.py on a pool worker ...") was
open when worker-5 created t_01a1d2586e1e5515 ("Local full state suite on pool
workers: run_ci.py fails ...") 3.5 min later; the worker ran a 644 s suite before
it was stopped as superseded. The titles share 8 of 19 significant words, under
the half-of-the-longer-title rule, and nothing else matched.

Two titles naming the same code file basename (dotted names whole:
sync-handoff.test.ts, never test.ts) that share >= 6 words and >= 30% of the
longer title now match. distinct_target / work_role exemptions still apply, and
a file-only match the new card cites by id is admitted like a failure-only one.

Replay over 14 days of replica cards (8112 creates): 2 extra refusals, both true
duplicates; 3 more fire but cite the open card and are admitted.

Card t_01a1d290dc768ba1.
---
 hermes_cli/kanban_overlap.py                  |  34 +++++-
 .../test_kanban_create_overlap_shared_file.py | 104 ++++++++++++++++++
 2 files changed, 135 insertions(+), 3 deletions(-)
 create mode 100644 tests/tools/test_kanban_create_overlap_shared_file.py

diff --git a/hermes_cli/kanban_overlap.py b/hermes_cli/kanban_overlap.py
index cc69644588..b6a4202546 100644
--- a/hermes_cli/kanban_overlap.py
+++ b/hermes_cli/kanban_overlap.py
@@ -9,7 +9,9 @@ An open card matches when:
 - the new card names its board, is not being created on that board, and the titles share a word (for a
   plain-word slug, 2 words that are a quarter of the longer title: one shared word or a hostname with any of
   the hundreds of cards on ``bb`` or ``hermes`` is chance, not overlap), or
-- both titles share at least half of the longer title's significant words (3 or more).
+- both titles share at least half of the longer title's significant words (3 or more), or
+- both titles name the same code file (``tests/run_ci.py`` / ``run_ci.py``) and share 6 or more significant words
+  that are at least 30% of the longer title (:func:`code_files`).
 
 The hermes-mods core mirror is a singleton job: a whole ``mirror`` token plus
 ``hermes-mods``, ``core``, or both ``fork`` and ``backlog`` matches regardless of score
@@ -259,9 +261,35 @@ def _reasons(card: dict, new_words: set[str], title: str, body: str, target_boar
         # The title ratio alone: a failure match sets score to 1.0 without any title overlap.
         if len(shared) >= MIN_SHARED and ratio >= 0.5:
             reasons.append(f"titles share {len(shared)} words ({', '.join(sorted(shared))})")
+        elif len(shared) >= MIN_FILE_SHARED and ratio >= FILE_SCORE and (same := code_files(title)
+                                                                          & code_files(card.get("title") or "")):
+            reasons.append(f"titles name {', '.join(sorted(same))} and share {len(shared)} words "
+                           f"({', '.join(sorted(shared))})")
     return reasons, score
 
 
+# Shared code file (t_01a1d290dc768ba1): "State suite: ... runs tests/run_ci.py on a pool worker ..." and "Local full
+# state suite on pool workers: run_ci.py fails ..." were one job across two gateways, but long descriptive titles
+# shared 8 of 19 words, under half. A file both titles name is a strong signal, like a shared failing test; with 6
+# shared words, replayed over 14 days of replica cards (8112 creates, 482 naming a file), it adds 2 refusals, both
+# true duplicates, and no false one; 3 more fire but cite the open card by id and are admitted (see _find).
+# A dotted basename is one name: ``sync-handoff.test.ts``, never its ``test.ts`` suffix (every vitest file has it).
+_CODE_FILE = re.compile(r"(?<![\w.-])(?:[\w.~-]+/)*((?:[\w-]+\.)*[\w-]*[a-z][\w-]*\."
+                        r"(?:py|sh|ts|tsx|js|mjs|cjs|json|jsonl|ya?ml|"
+                        r"toml|sql|md|swift|rs|go|rb|plist|service|timer|db))\b", re.IGNORECASE)
+MIN_FILE_SHARED = 6
+FILE_SCORE = 0.3
+
+
+def code_files(title: str) -> frozenset[str]:
+    """File basenames a title names (``tests/run_ci.py`` and ``run_ci.py`` are both ``run_ci.py``)."""
+    return frozenset(m.lower() for m in _CODE_FILE.findall(title or ""))
+
+
+def _file_reason(why: str) -> bool:
+    return why.startswith("titles name ")
+
+
 # Target identity (overlap audit t_01a189c70884fa59). Shared title words say two cards are the same KIND of work;
 # they do not say it is the same target. 108 refusals in 24 h matched on boilerplate while each title named a
 # different machine, process or repo: ``laptop-1: gateway 78233 may run stale hermes-mods plugins`` vs
@@ -689,8 +717,8 @@ def _find(*, title: str, body: str, target_board: str, session_id: Optional[str]
             mine = _identity(title, body, gateways)
         admit = (f"waits on {card['id']}" if waits_on(card["id"], title, body)
                  else f"recovers {card['id']}" if recovers(card["id"], title, card.get("title") or "")
-                 # A failure-only match the new card cites by id was written knowing that owner.
-                 else f"cites {card['id']}" if (all(_failure_reason(r) for r in reasons)
+                 # A failure- or file-only match the new card cites by id was written knowing that owner.
+                 else f"cites {card['id']}" if (all(_failure_reason(r) or _file_reason(r) for r in reasons)
                                                 and cites(card["id"], title, body))
                  else _distinct(mine, _identity(card.get("title") or "", card.get("body") or "", gateways)))
         if admit and not singleton:
diff --git a/tests/tools/test_kanban_create_overlap_shared_file.py b/tests/tools/test_kanban_create_overlap_shared_file.py
new file mode 100644
index 0000000000..a06e1c7ab6
--- /dev/null
+++ b/tests/tools/test_kanban_create_overlap_shared_file.py
@@ -0,0 +1,104 @@
+"""kanban_create refuses a second owner whose title names the same code file as an open card's. [daveey]
+
+Incident (2026-11-13, t_01a1d290dc768ba1): hub card t_01a1d25511610669 ("State suite: ... runs tests/run_ci.py on a
+pool worker ...") was open when a worker-5 card created t_01a1d2586e1e5515 ("Local full state suite on pool workers:
+run_ci.py fails ...") 3.5 min later. Same work; the worker ran a 644 s suite before it was stopped as superseded. The
+titles share 8 significant words of 19, under the half-of-the-longer-title rule, and nothing else matched. A title
+naming the same code file (``run_ci.py``) plus enough shared words is the same job, the way a shared failing test is.
+
+Replay over 14 days of replica cards (8112 creates, 482 naming a code file): the rule adds 2 refusals, this pair and
+two ``sync-handoff.test.ts`` deflake cards for the same timed-out test (10-30), both true duplicates. Three more pairs
+it fires on cite the open card by id and are admitted like a failure-only match that cites its owner. The negatives
+are real pairs that name one file for different jobs.
+"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_overlap as ko
+from tests.tools import test_kanban_create_overlap as helpers
+
+home = helpers.home
+
+HUB_CARD = ("State suite: scripts/run-state-suite-local runs tests/run_ci.py on a pool worker the way the "
+            "hermes-sync tests CI job does (green on unchanged origin/state)")
+WORKER_DUP = ("Local full state suite on pool workers: run_ci.py fails 4 modules vs the worker's live core "
+              "(hermes_state_lockguard missing), not core-fixture as CI uses")
+
+
+def remote(tmp_path, title, *, cid="t_01a1d25511610669", body=""):
+    (tmp_path / "hub-state" / "hub.db").unlink(missing_ok=True)
+    helpers._fake_replica(tmp_path / "hub-state" / "hub.db", [
+        ("hub", {"id": cid, "board": "default", "title": title, "body": body, "status": "running",
+                 "gateway": "hub", "sessions": [{"session": "20261112_055658_bb1bdd", "rel": "created"}]})])
+
+
+def check(title, body=""):
+    with kbc.connect_closing() as conn:
+        refusal, _ = ko.check(conn, {"body": body}, courier=False, title=title, session_id="worker-5-run",
+                              self_tid=None, parents=[])
+    return json.loads(refusal) if refusal else None
+
+
+@pytest.fixture
+def worker(home, monkeypatch):
+    from hermes_cli import kanban_capability_registry as reg
+    monkeypatch.setattr(reg, "self_gateway", lambda: "worker-5")
+    return home
+
+
+def test_run_ci_duplicate_from_another_gateway_is_refused_naming_the_hub_card(worker, tmp_path):
+    remote(tmp_path, HUB_CARD)
+    out = check(WORKER_DUP)
+    assert out and out["code"] == "create_overlap", out
+    (m,) = out["matches"]
+    assert m["id"] == "t_01a1d25511610669" and m["gateway"] == "hub"
+    assert "run_ci.py" in m["why"], m["why"]
+
+
+def test_shared_file_with_too_few_shared_words_is_not_a_match(worker, tmp_path):
+    """Real pair (11-12): one file, two jobs (fix a validator vs read back an earlier proof); 5 shared words."""
+    remote(tmp_path, "Hub readback + live read-only proof of ci_run_metadata.py (state 1b7bc2d)")
+    assert check("Fix ci_run_metadata.py token validator rejecting real relay-minted ghs_ tokens (contain '.'), "
+                 "then re-run live proof") is None
+
+
+def test_same_words_without_a_shared_file_stay_under_the_half_rule(worker, tmp_path):
+    """The file is the strong signal: the same titles with the file name dropped share too little."""
+    remote(tmp_path, HUB_CARD.replace("tests/run_ci.py", "the state tests"))
+    assert check(WORKER_DUP.replace("run_ci.py", "the runner")) is None
+
+
+def test_a_different_file_of_the_same_kind_is_not_a_match(worker, tmp_path):
+    remote(tmp_path, HUB_CARD)
+    assert check(WORKER_DUP.replace("run_ci.py", "run_tests.py")) is None
+
+
+def test_two_dotted_files_sharing_only_their_suffix_are_not_a_match(worker, tmp_path):
+    """``sync-handoff.test.ts`` and ``theme-store.test.ts`` are two files; ``test.ts`` is not a file both name."""
+    old = "Deflake apps/desktop sync-handoff.test.ts: wall-clock ticks race slow store imports under CI load"
+    new = ("Deflake apps/desktop theme-store.test.ts: persisted palette migration reorders keys after rehydrate when "
+           "the renderer boots twice under CI load")
+    assert len(ko.words(new) & ko.words(old)) >= ko.MIN_FILE_SHARED  # enough shared words; only the file differs
+    remote(tmp_path, old)
+    assert check(new) is None
+    assert ko.code_files("see src/lib/sync-handoff.test.ts") == {"sync-handoff.test.ts"}
+
+
+def test_a_card_that_cites_the_owner_by_id_is_admitted(worker, tmp_path):
+    """Real pair (11-13 01:00): the hub deflake card names worker-5's open card t_01a1d23f8c1a6284 in its body."""
+    remote(tmp_path, "Deflake tests/test_core_drain_idle.py under load (idle_path_gateway_drain_wait..., "
+                     "ioreg_failure_means_no_window) on worker-5", cid="t_01a1d23f8c1a6284")
+    new = ("Deflake the three windowed cases in tests/test_core_drain_idle.py: their real 0.2 s claim lease "
+           "expires under a 0.3 s host stall")
+    assert check(new, body="Follow-up of t_01a1d23f8c1a6284: the windowed cases still fail.") is None
+    out = check(new, body="The windowed cases fail on a loaded host.")
+    assert out and out["code"] == "create_overlap", out
+
+
+def test_distinct_target_still_admits_a_shared_file_match(worker, tmp_path):
+    remote(tmp_path, HUB_CARD + " on daveey-mini")
+    assert check(WORKER_DUP + " on laptop-1") is None
-- 
