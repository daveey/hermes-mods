+                assert changed.wait(1), 'declared clock needed a source write'
+                assert outputs[-1][9] == {}
+                assert outputs[-1][0] == {'s1': 1}
+            elif action in ('watch-loss', 'overflow'):
+                if action == 'watch-loss':
