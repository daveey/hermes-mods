+def test_board_execution_derives_after_connection_close(tmp_path, monkeypatch):
+    from hermes_cli import kanban_execution_source as source
+
+    path = tmp_path / 'kanban.db'
+    writer = helpers._board(path, [('t1', 'running', 's1')])
