+                assert outputs[-1][0] == {'s1': 1}
+                changed.clear()
+                writer.execute("UPDATE tasks SET status='done' WHERE id='t1'")
+                assert changed.wait(1), 'coverage was not reinstalled after notification loss'
+                assert outputs[-1][0] == {}
+            elif action == 'remove':
