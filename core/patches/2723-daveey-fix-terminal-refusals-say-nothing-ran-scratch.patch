diff --git a/tests/test_scratch_dir.py b/tests/test_scratch_dir.py
index d976c4450d..e7dd8f1575 100644
--- a/tests/test_scratch_dir.py
+++ b/tests/test_scratch_dir.py
@@ -36,6 +36,9 @@ def test_boot_hook_and_prompt_hand_the_prune_to_one_child(scratch_prune_spawns,
     hints = _local_host_hints()
     assert env["TMPDIR"] == str(scratch) and scratch.is_dir()
     assert f"Scratch directory: {scratch} (TMPDIR points here" in hints[0]
+    # One dir for every session on the host: a generic name (suite.sh) silently runs another
+    # session's leftover file when this session's write never happened.
+    assert "shared by every session on this host" in hints[0] and "mktemp" in hints[0]
     assert scratch_prune_spawns == [scratch]
 
     monkeypatch.setattr(constants, "_scratch_pruned_once", False)  # the routed caller's own process
diff --git a/tests/tools/test_blocked_command_guidance.py b/tests/tools/test_blocked_command_guidance.py
index 26c7c667d1..9e0652d1a7 100644
--- a/tests/tools/test_blocked_command_guidance.py
+++ b/tests/tools/test_blocked_command_guidance.py
@@ -72,3 +72,27 @@ class TestBackgroundGuidanceRecipes:
 
     def test_quoted_ampersand_not_flagged(self):
         assert _foreground_background_guidance('git commit -m "a & b"') is None
+
+
+class TestRefusalSaysNothingRan:
+    """A refusal that doesn't say "nothing ran" invites re-sending only the refused tail, dropping
+    setup (a heredoc that writes the script). The tail then runs whatever stale file another session
+    left in the shared scratch dir under the same name."""
+
+    NOTHING_RAN = "Nothing in this command ran"
+
+    def test_heredoc_then_inline_ampersand_says_nothing_ran(self):
+        cmd = "cat > $TMPDIR/suite.sh <<'EOF'\npytest -q\nEOF\nbash $TMPDIR/suite.sh & sleep 280"
+        msg = _foreground_background_guidance(cmd)
+        assert msg is not None
+        assert msg.startswith("Foreground command uses '&' backgrounding.")  # forensics _FG_AMP prefix
+        assert self.NOTHING_RAN in msg
+        assert "heredocs" in msg
+
+    def test_nohup_refusal_says_nothing_ran(self):
+        msg = _foreground_background_guidance("mkdir -p out && nohup ./worker.sh > /dev/null 2>&1")
+        assert msg is not None and self.NOTHING_RAN in msg
+
+    def test_server_refusal_says_nothing_ran(self):
+        msg = _foreground_background_guidance("cd app && uvicorn main:app --port 8000")
+        assert msg is not None and self.NOTHING_RAN in msg
diff --git a/tools/terminal_tool_guards.py b/tools/terminal_tool_guards.py
index 451c1d94cd..be70cd8f7e 100644
--- a/tools/terminal_tool_guards.py
+++ b/tools/terminal_tool_guards.py
@@ -97,6 +97,14 @@ _LONG_LIVED_FOREGROUND_PATTERNS = tuple(re.compile(p, re.IGNORECASE) for p in (
     r"\bpython(?:3)?\s+-m\s+http\.server\b",
 ))
 
+# Every refusal below rejects the WHOLE command before anything runs. Saying so stops the resend
+# that keeps only the refused tail: a dropped `cat > x.sh <<EOF` setup then runs another session's
+# stale x.sh from the shared scratch dir instead of failing "not found".
+_NOTHING_RAN = (
+    " Nothing in this command ran (no file writes, heredocs, cd or setup steps). Re-send all of it: "
+    "put setup in a foreground call first, or the whole script in the background call."
+)
+
 # Ordered (predicate on the unquoted command, guidance) — first hit wins.
 _FOREGROUND_GUIDANCE = (
     (
@@ -104,19 +112,19 @@ _FOREGROUND_GUIDANCE = (
         "Foreground command uses shell-level background wrappers (nohup/disown/setsid). "
         "Re-send WITHOUT the wrapper as terminal(command=\"<cmd>\", background=true, "
         "notify_on_complete=true) so Hermes tracks the process, then run readiness "
-        "checks and tests in separate commands.",
+        "checks and tests in separate commands." + _NOTHING_RAN,
     ),
     (
         lambda s: _INLINE_BACKGROUND_AMP_RE.search(s) or _TRAILING_BACKGROUND_AMP_RE.search(s),
         "Foreground command uses '&' backgrounding. Re-send WITHOUT the '&' as "
         "terminal(command=\"<cmd>\", background=true) — add notify_on_complete=true "
-        "for bounded jobs — then run health checks and tests in follow-up terminal calls.",
+        "for bounded jobs — then run health checks and tests in follow-up terminal calls." + _NOTHING_RAN,
     ),
     (
         lambda s: any(p.search(s) for p in _LONG_LIVED_FOREGROUND_PATTERNS),
         "This foreground command appears to start a long-lived server/watch process. "
         "Run it with background=true, verify readiness (health endpoint/log signal), "
-        "then execute tests in a separate command.",
+        "then execute tests in a separate command." + _NOTHING_RAN,
     ),
 )
 
