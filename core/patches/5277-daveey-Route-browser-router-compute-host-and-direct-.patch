+++ b/tools/browser_launcher.py
@@ -428,9 +428,10 @@ def _prepare_dir(user_data_dir: str, ephemeral: bool) -> None:
 
 
 def _spawn(argv: list[str], env: dict, user_data_dir: str) -> subprocess.Popen:
+    from hermes_cli.worker_drain_fence import popen_worker
     log_path = os.path.join(user_data_dir, _LAUNCH_LOG)
     with open(log_path, "wb") as log:
-        return subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=log, stderr=log, env=env,
+        return popen_worker(subprocess.Popen, argv, stdin=subprocess.DEVNULL, stdout=log, stderr=log, env=env,
                                 **_spawn_kwargs())
 
 
diff --git a/tui_gateway/host_supervisor.py b/tui_gateway/host_supervisor.py
index 16e5b9b177..05450e5a9d 100644
--- a/tui_gateway/host_supervisor.py
+++ b/tui_gateway/host_supervisor.py
@@ -377,7 +377,8 @@ class HostSupervisor:
         if root not in env["PYTHONPATH"].split(os.pathsep):
             env["PYTHONPATH"] = root + os.pathsep + env["PYTHONPATH"]
         # Lossy UTF-8 decode: a locale-mismatched byte must not raise inside the drain threads.
-        proc = subprocess.Popen(
+        from hermes_cli.worker_drain_fence import popen_worker
+        proc = popen_worker(subprocess.Popen,
             self.argv, cwd=str(self.cwd), env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
             stderr=subprocess.PIPE, text=True, encoding="utf-8", errors="replace", bufsize=1,
             # detached-spawn: ok — compute host exits on its own parent-guard (compute_host._parent_guard_loop) and flushes sessions; a supervisor KILL could cut that flush short
diff --git a/tui_gateway/methods_tools.py b/tui_gateway/methods_tools.py
index 5d1a704799..5fb9149821 100644
--- a/tui_gateway/methods_tools.py
+++ b/tui_gateway/methods_tools.py
@@ -205,7 +205,8 @@ def _captured_exec(rid, cmd, timeout: int, *, on_result, timeout_err: tuple, fai
     """Run ``cmd`` captured (see ``_capture_run_kwargs``) and hand the CompletedProcess to
     ``on_result``; TimeoutExpired → ``timeout_err`` (code, message), other errors → ``fail_code``."""
     try:
-        return on_result(subprocess.run(cmd, cwd=os.getcwd(), shell=shell, env=env, **_capture_run_kwargs(timeout)))
+        from hermes_cli.worker_drain_fence import popen_worker
+        return on_result(popen_worker(subprocess.run, cmd, cwd=os.getcwd(), shell=shell, env=env, **_capture_run_kwargs(timeout)))
     except subprocess.TimeoutExpired:
         return _err(rid, *timeout_err)
     except Exception as e:
@@ -483,7 +484,8 @@ def _dispatch_quick(rid, params, session, name, arg):
     if qc.get("type") == "exec":
         # Sanitized env: the TUI server process holds every API key in os.environ.
         env = _tools_mod("tools.environments.local").build_subprocess_env()
-        r = subprocess.run(qc.get("command", ""), shell=True, env=env, **_capture_run_kwargs(30))
+        from hermes_cli.worker_drain_fence import popen_worker
+        r = popen_worker(subprocess.run, qc.get("command", ""), shell=True, env=env, **_capture_run_kwargs(30))
         output = _joined_output(r)[:4000]
         output = _tools_mod("agent.redact").redact_sensitive_text(output) if output else output
         if r.returncode != 0:
