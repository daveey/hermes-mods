From be49e3d389d5b1c664578d18564eefc9889938a6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 22:36:13 +0000
Subject: [PATCH] [daveey] Keep primary evidence ownership out of card routing

Independent review found PRIMARY evidence attachment leaked gateway and owner_profile into local list rows, which Desktop treats as remote routing. Keep the qualified owner in private _replica_run.scope; remote replicas retain their existing row-based owner.

Proof: routing row-key-set regression RED (1 failed, 20 passed), GREEN 57 primary/snapshot tests and 27 remote replica tests. Added newest-current-beat selection with a newer unrelated-run control. Full check hits unrelated stale-base BLE001 in hermes_state_dbfile.py; canonical ship rebase will rerun all gates.
---
 hermes_cli/kanban_primary_execution.py        |  6 +++--
 hermes_cli/kanban_replica_execution.py        |  3 ++-
 .../test_kanban_primary_execution.py          | 25 +++++++++++++++++++
 3 files changed, 31 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_primary_execution.py b/hermes_cli/kanban_primary_execution.py
index 3ed969b8aad..aa95a96f1d3 100644
--- a/hermes_cli/kanban_primary_execution.py
+++ b/hermes_cli/kanban_primary_execution.py
@@ -36,10 +36,12 @@ def attach(conn, rows, *, gateway, profile, board):
             if evidence is None:
                 continue
             row = rows[tid]
-            row.update(gateway=gateway, owner_profile=profile, board=board, status='running', assignee=assignee)
+            row.update(board=board, status='running', assignee=assignee)
             from hermes_cli.kanban_execution_observations import _request
             row['human_request'] = _request(row.get('human_request'))
             # Display enrichment runs only on lists; it must not change the shared evidence record.
-            row['_replica_run'] = {**evidence, 'activity_at': None, 'activity_kind': None}
+            # Evidence ownership is private adapter data, not remote-card UI routing.
+            row['_replica_run'] = {**evidence, 'activity_at': None, 'activity_kind': None,
+                                   'scope': {'gateway': gateway, 'owner_profile': profile}}
             values[tid] = raw(row)
     return values
diff --git a/hermes_cli/kanban_replica_execution.py b/hermes_cli/kanban_replica_execution.py
index 07e03e94e11..bd57054e2fc 100644
--- a/hermes_cli/kanban_replica_execution.py
+++ b/hermes_cli/kanban_replica_execution.py
@@ -72,7 +72,8 @@ def raw(row: dict) -> dict | None:
     run = row.get("_replica_run")
     if not isinstance(run, dict) or row.get("status") != "running":
         return None
-    gateway, profile = row.get("gateway"), row.get("owner_profile")
+    scope = run.get("scope", row)
+    gateway, profile = scope.get("gateway"), scope.get("owner_profile")
     identity = {"gateway": gateway, "profile": profile, "board": row.get("board"), "kind": "card",
                 "work_id": row.get("id"), "run_id": run["run_id"]}
     owner = {"gateway": gateway, "profile": profile}
diff --git a/tests/hermes_cli/test_kanban_primary_execution.py b/tests/hermes_cli/test_kanban_primary_execution.py
index 4cb47ee3e41..5a35530761c 100644
--- a/tests/hermes_cli/test_kanban_primary_execution.py
+++ b/tests/hermes_cli/test_kanban_primary_execution.py
@@ -102,6 +102,31 @@ def test_incomplete_primary_evidence_remains_unknown(primary, sql):
         assert value['state'] == 'unknown'
 
 
+def test_primary_preserves_local_row_routing_shape(primary):
+    primary_row = activity.session_tasks(['session'])[0]
+    with sqlite3.connect(primary) as conn:
+        conn.execute("UPDATE kanban_sync_state SET mode='off'")
+    local_row = activity.session_tasks(['session'])[0]
+    assert set(primary_row) == set(local_row)
+    assert 'gateway' not in primary_row
+    assert 'owner_profile' not in primary_row
+    assert primary_row.get('remote') == local_row.get('remote')
+
+
+def test_primary_uses_latest_beat_of_current_run_only(primary):
+    with sqlite3.connect(primary) as conn:
+        conn.executemany(
+            'INSERT INTO task_events (task_id,run_id,kind,created_at,uid) VALUES (?,?,?,?,?)',
+            [('card', 7, 'heartbeat', 985, 'older-current'),
+             ('card', 7, 'heartbeat', 995, 'newest-current'),
+             ('card', 6, 'heartbeat', 999, 'earlier-run')],
+        )
+    for value in read_all(primary):
+        assert value['observed_at'] == 995
+        assert value['source_revision'] == 'event:newest-current'
+        assert value['identity']['run_id'] == 'portable-run'
+
+
 def test_primary_clock_expires_without_rejuvenation(primary, monkeypatch):
     monkeypatch.setattr(activity.time, 'time', lambda: 1200)
     for value in read_all(primary):
