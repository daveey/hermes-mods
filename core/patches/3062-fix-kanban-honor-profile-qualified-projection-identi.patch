From a22c7b3b4a3465983c4b65c7ee2998cff8dd00b0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 20:04:40 +0000
Subject: [PATCH] fix(kanban): honor profile-qualified projection identities
 [daveey]

---
 hermes_cli/kanban_chat_tasks.py            |  2 ++
 hermes_cli/kanban_origin.py                |  3 ++-
 tests/hermes_cli/test_kanban_chat_tasks.py | 20 ++++++++++++++++++++
 tests/hermes_cli/test_kanban_origin.py     |  2 +-
 4 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_chat_tasks.py b/hermes_cli/kanban_chat_tasks.py
index b177f30daf..152f33effc 100644
--- a/hermes_cli/kanban_chat_tasks.py
+++ b/hermes_cli/kanban_chat_tasks.py
@@ -25,6 +25,8 @@ def matches(row: dict, expected: str) -> bool:
         return expected == row.get("id")
     if expected.count("/") == 1:
         return expected == "/".join(parts[-2:])
+    if expected.count("/") == 2 and len(parts) == 4:
+        return expected == "/".join((parts[0], *parts[-2:]))
     if len(parts) == 2:
         from hermes_cli.kanban_origin import gateway_names
         key = f"{gateway_names()[0]}/{key}"
diff --git a/hermes_cli/kanban_origin.py b/hermes_cli/kanban_origin.py
index 09c3d3267d..1c0716bb18 100644
--- a/hermes_cli/kanban_origin.py
+++ b/hermes_cli/kanban_origin.py
@@ -323,7 +323,8 @@ def bind(conn: Any, task_id: str, origin: Origin, *, board: Optional[str] = None
     target = f"{me}/{board or 'default'}/{task_id}"
     return {"origin": origin.ref, "chat_id": origin.chat_id, "task": target, "readback": "pending",
             "verify_on_origin": f"hermes-hub links {origin.session} --expect {target}",
-            "verify_visible": f"hermes kanban chat-tasks {shlex.quote(origin.session)} --expect {shlex.quote(target)}"}
+            "verify_visible": (f"hermes -p {shlex.quote(origin.profile)} kanban chat-tasks "
+                               f"{shlex.quote(origin.session)} --expect {shlex.quote(target)}")}
 
 
 def preflight(tool_names: Iterable[str]) -> None:
diff --git a/tests/hermes_cli/test_kanban_chat_tasks.py b/tests/hermes_cli/test_kanban_chat_tasks.py
index 37686c9725..d133ca60f8 100644
--- a/tests/hermes_cli/test_kanban_chat_tasks.py
+++ b/tests/hermes_cli/test_kanban_chat_tasks.py
@@ -95,6 +95,26 @@ def test_lineage_error_is_not_absence(monkeypatch, capsys):
     assert "session store unavailable" in captured.err
 
 
+@pytest.mark.parametrize("expected,code", [("remote/work/t1", 0), ("remote/research/work/t1", 0),
+                                           ("wrong/work/t1", 4), ("remote/other/t1", 4),
+                                           ("remote/wrong/work/t1", 4)])
+def test_real_profile_qualified_projection(monkeypatch, lineage, expected, code):
+    from hermes_cli.kanban_replica_projection import card_rows
+    projected = card_rows(("remote", "research", "work", "t1"), {"status": "ready"},
+                          sids=["chat"], closed=False, synced=1, stale=False, me="local",
+                          origin_profile="default", legacy_record=False, historical={})
+    monkeypatch.setattr(activity, "session_tasks", lambda *a, **kw: [row for _, row in projected])
+    assert run("chat", "--expect", expected) == code
+
+
+def test_named_origin_profile_in_command(monkeypatch):
+    from hermes_cli import kanban_origin, kanban_db_notify
+    monkeypatch.setattr(kanban_db_notify, "add_notify_sub", lambda *a, **kw: None)
+    monkeypatch.setattr(kanban_origin, "gateway_names", lambda: ("hub", set()))
+    receipt = kanban_origin.bind(None, "t1", kanban_origin.Origin("mac", "research", "chat"))
+    assert receipt["verify_visible"] == "hermes -p research kanban chat-tasks chat --expect hub/default/t1"
+
+
 def test_tool_guidance_names_projection():
     from tools.kanban_tools_schemas import KANBAN_CREATE_SCHEMA
     text = json.dumps(KANBAN_CREATE_SCHEMA)
diff --git a/tests/hermes_cli/test_kanban_origin.py b/tests/hermes_cli/test_kanban_origin.py
index 1e365fe9a1..14cd9c5cff 100644
--- a/tests/hermes_cli/test_kanban_origin.py
+++ b/tests/hermes_cli/test_kanban_origin.py
@@ -72,7 +72,7 @@ def test_tool_create_binds_origin_without_rewriting_the_creator(hub_gateway, mon
     assert _hub_subs(tid) == ["macbook/default/20261022_204322_aaaaaa"]
     assert res["origin_binding"]["readback"] == "pending"
     assert res["origin_binding"]["verify_visible"] == (
-        f"hermes kanban chat-tasks 20261022_204322_aaaaaa --expect hub/default/{tid}")
+        f"hermes -p default kanban chat-tasks 20261022_204322_aaaaaa --expect hub/default/{tid}")
     assert res["origin_binding"]["verify_on_origin"] == f"hermes-hub links 20261022_204322_aaaaaa --expect hub/default/{tid}"
     # idempotent: a retried create returns the same card and does not duplicate the binding
     again = json.loads(kt._handle_create({"title": "P0", "assignee": "default", "idempotency_key": "k-p0"}))
