From d1f73dbf8a65651332fb3047fab5528001bb6e9a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 20:27:48 +0000
Subject: [PATCH] [daveey] Widen mirror singleton identity and preserve
 capability execution

---
 hermes_cli/kanban_overlap.py                  | 21 ++++--
 .../test_kanban_create_entry_parity.py        |  8 ++-
 .../test_kanban_create_overlap_singleton.py   | 70 ++++++++++++++++++-
 3 files changed, 89 insertions(+), 10 deletions(-)

diff --git a/hermes_cli/kanban_overlap.py b/hermes_cli/kanban_overlap.py
index 14b107634e2..e91ac239c2f 100644
--- a/hermes_cli/kanban_overlap.py
+++ b/hermes_cli/kanban_overlap.py
@@ -11,9 +11,11 @@ An open card matches when:
   the hundreds of cards on ``bb`` or ``hermes`` is chance, not overlap), or
 - both titles share at least half of the longer title's significant words (3 or more).
 
-The hermes-mods core mirror is a singleton job: titles naming ``mirror``, ``hermes-mods``
-and ``core`` match regardless of score or heuristic exemptions below. Exact-key retries
-still return the existing card; an intentional second owner requires a recorded override.
+The hermes-mods core mirror is a singleton job: a whole ``mirror`` token plus
+``hermes-mods``, ``core``, or both ``fork`` and ``backlog`` matches regardless of score
+or heuristic exemptions below. Exact-key retries still return the existing card;
+a capability owner serves its quoted waiting card, not a second pass. An intentional
+second owner requires a recorded override.
 
 Naming a board means an explicit reference in the title or body: ``board <slug>``, ``--board <slug>``,
 ``<slug> board``, ``@task:<slug>@...`` / ``@task:<slug>/...`` or ``<gateway>/<slug>`` for a known gateway
@@ -23,8 +25,9 @@ A slug that is not one plain word (``unconventional-collab``) is specific enough
 or the slug itself in the title still names it (``Metta-AI/unconventional-collab``). A bare plain word that
 equals a board slug does not count.
 
-Never matched: closed cards (a replica's stale legacy ``<board>/<id>`` row never outvotes its qualified
-``<profile>/<board>/<id>`` twin), the creator's own card, the new card's parents, cards the same chat or the same
+Closed cards never match (a replica's stale legacy ``<board>/<id>`` row never outvotes its qualified
+``<profile>/<board>/<id>`` twin). Heuristic exemptions (singletons ignore these except the capability
+waiting card): the creator's own card, the new card's parents, cards the same chat or the same
 worker created (fan-out), the waiting card a capability-owner create quotes, and another capability-owner
 card for that same waiting card, a card the new one parks/waits/depends on (:func:`waits_on`), a card whose failed
 execution the new one recovers (:func:`recovers`: ``self-heal: kanban card t_X ... failed 2x``), and a card that
@@ -119,7 +122,7 @@ def _names_board(slug: str, title: str, body: str, gateways: Iterable[str] = ())
 def singleton_job(title: str) -> Optional[str]:
     """Explicit single-writer jobs, not a change to general title similarity. [daveey]"""
     tokens = set(re.findall(r"[a-z0-9]+(?:-[a-z0-9]+)*", (title or "").lower()))
-    if {"mirror", "hermes-mods", "core"} <= tokens:
+    if "mirror" in tokens and (tokens & {"hermes-mods", "core"} or {"fork", "backlog"} <= tokens):
         return "hermes-mods core mirror"
     return None
 
@@ -528,7 +531,11 @@ def find(*, title: str, body: str, target_board: str, session_id: Optional[str],
             singleton = bool(job and job == singleton_job(card.get("title") or ""))
             if (card["gateway"], card["id"]) in seen:
                 continue
-            if not singleton and (card["id"] in skip or card["id"] == waiting
+            # The capability owner executes this exact waiting card, even for a singleton.
+            # Keep other mirror owners visible; do not exempt a whole family or envelope.
+            if card["id"] == waiting:
+                continue
+            if not singleton and (card["id"] in skip
                     or (waiting and _sibling_owner(card.get("title") or "", waiting))
                     or (session_id and card["session_id"] == session_id)
                     or (self_tid and card["creator_task_id"] == self_tid)
diff --git a/tests/hermes_cli/test_kanban_create_entry_parity.py b/tests/hermes_cli/test_kanban_create_entry_parity.py
index 257731c7052..0058f0301d5 100644
--- a/tests/hermes_cli/test_kanban_create_entry_parity.py
+++ b/tests/hermes_cli/test_kanban_create_entry_parity.py
@@ -413,13 +413,17 @@ def test_rest_create_refuses_a_duplicate_owner(chat):
 
 
 @pytest.mark.parametrize("surface", ["tool", "cli", "rest"])
-def test_mirror_singleton_refused_on_every_create_path(chat, monkeypatch, capsys, surface):
-    from tests.tools.test_kanban_create_overlap_singleton import NEW, OPEN_TITLE
+@pytest.mark.parametrize("historical", [False, True])
+def test_mirror_singleton_refused_on_every_create_path(chat, monkeypatch, capsys, surface, historical):
+    from tests.tools.test_kanban_create_overlap_singleton import MISSED, NEW, OPEN_TITLE
+    if historical:
+        NEW = MISSED[0]
     with kbc.connect_closing() as conn:
         live = kb.create_task(conn, title=OPEN_TITLE, assignee="default", session_id="other-chat",
                               idempotency_key="core-mirror:a")
     payload = {"title": NEW, "assignee": "default", "requires": [], "idempotency_key": "core-mirror:b"}
     if surface == "tool":
+        from tools import kanban_tools  # registers the tool for standalone selection
         from tools.registry import registry
         out = json.loads(registry.dispatch("kanban_create", payload))
     elif surface == "cli":
diff --git a/tests/tools/test_kanban_create_overlap_singleton.py b/tests/tools/test_kanban_create_overlap_singleton.py
index fbc0c8c34aa..181f93857a4 100644
--- a/tests/tools/test_kanban_create_overlap_singleton.py
+++ b/tests/tools/test_kanban_create_overlap_singleton.py
@@ -23,6 +23,74 @@ HISTORICAL = (
 )
 
 
+MISSED = (
+    "Mirror merged post-turn secret scope repair PR678 into public core patches",
+    "Mirror trailing core commits after ordinal1539 (PR540/555/556 and landed outcome fixes) [replacement, Claude-routed]",
+    "Mirror trailing core commits after ordinal1539 (PR540/555/556 and landed outcome fixes)",
+    "Mirror core through e572a3832043: composable metadata-only ask classification",
+    "Mirror fork backlog through composer Escape origin fix d9e0c56cb2",
+    "Mirror contiguous core backlog through offline DNS wait PR429",
+    "Mirror fork backlog after frozen 1368 snapshot (next ordinals 1369+)",
+    "Mirror contiguous core range after patch1253 including PR309 cancellation lock fix",
+    "Reconcile public core mirror through frozen-decision reset fence PR296",
+    "Reconcile public core mirror past 1202, including frozen-decision reset fence PR296",
+    "Publish outstanding fork core mirror through auxiliary OAuth rotation cb1aa70f614",
+    "Mirror PR160 review admission lifecycle patch and documentation to hermes-mods",
+    "Mirror daveey/hermes commits after hermes-mods 0688",
+    "Mirror remaining unmirrored daveey/hermes commits after hermes-mods 0670",
+    "Mirror unexported Hermes core range after 0248 through continuation guard",
+)
+WIDE_OWNER = "Mirror core commits 1703+ into hermes-mods core/"
+
+
+@pytest.mark.parametrize("title", MISSED)
+@pytest.mark.parametrize("remote", [False, True])
+def test_historical_mirror_variants(home, tmp_path, title, remote):
+    if remote:
+        tid = "t_12345678"
+        helpers._fake_replica(tmp_path / "hub-state" / "hub.db", [
+            ("macbook", {"id": tid, "board": "default", "title": WIDE_OWNER, "status": "ready"})])
+    else:
+        tid = owner(WIDE_OWNER)
+    result = check(title)
+    assert result and result["code"] == "create_overlap"
+    assert [m["id"] for m in result["matches"]] == [tid]
+    assert "same singleton job: hermes-mods core mirror" in result["matches"][0]["why"]
+
+
+@pytest.mark.parametrize("envelope", [False, True])
+@pytest.mark.parametrize("remote", [False, True])
+def test_capability_owner_serves_waiter_but_not_other_mirror(home, tmp_path, envelope, remote):
+    a = "t_12345678" if remote else owner(WIDE_OWNER)
+    if remote:
+        helpers._fake_replica(tmp_path / "hub-state" / "hub.db", [
+            ("macbook", {"id": a, "board": "default", "title": WIDE_OWNER, "status": "ready"})])
+    title = f"Capability owner: ssh:hub for macbook/{a} ({WIDE_OWNER})"
+    args: dict = {"body": f"Capability owner card for waiting card macbook/{a}"}
+    if envelope:
+        args.update(distinct_from=[a], distinct_reason="Execution of waiting card, not a second pass")
+    assert check(title, **args) is None
+    b = owner("Mirror fork backlog through independent snapshot", key="other:b")
+    result = check(title, **args)
+    assert result and [m["id"] for m in result["matches"]] == [b]
+    assert "singleton" in result["matches"][0]["why"]
+
+
+@pytest.mark.parametrize("title", [
+    "BB-499: Brain freshness: brain:hub_mirror",
+    "Validate and independently review libtirpc mirror repair PR63 (exact derivation + Nix CI)",
+    "hermes-sync breaks when an agent checks out a fork branch in ~/code/hermes (mirror must stay on `state`)",
+    "Complete native Bluesky mirrors for original threads and media; durable retry",
+    "Check whether core PR#48 (goal-disposition fallback) needs a numbered-patch-mirror entry",
+    "kanban_create lets a second hermes-mods core-mirror card through when titles carry different SHAs (11-02 pair scored 0.40)",
+    "kanban_overlap: widen the core-mirror singleton identity (15 real core-mirror cards in 14 days lack 'hermes-mods' or 'core', incl. PR678 card 11-02)",
+    "hermes-mods main red: …",
+    "Merge upstream 557254faa2 into fork main",
+])
+def test_real_non_mirror_identities(title):
+    assert ko.singleton_job(title) is None
+
+
 def owner(title=OPEN_TITLE, status="ready", session="other", key="core-mirror:a"):
     with kbc.connect_closing() as conn:
         tid = kb.create_task(conn, title=title, assignee="default", session_id=session, idempotency_key=key)
@@ -75,7 +143,7 @@ def test_closed_mirror_not_an_owner(home, tmp_path, status, remote):
 @pytest.mark.parametrize("title", [
     "hermes-mods main red: test_no_bare_ro_open flags plugins/coach/origin_authority.py:80",
     "Merge upstream 557254faa2 into fork main",
-    "Mirror core commits into another-repo core/",
+    "Validate and independently review libtirpc mirror repair PR63 (exact derivation + Nix CI)",
 ])
 def test_non_mirror_titles_do_not_match_singleton(home, title):
     owner(title)
