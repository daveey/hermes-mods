diff --git a/tests/tools/test_background_spawn_path_parity.py b/tests/tools/test_background_spawn_path_parity.py
new file mode 100644
index 0000000000..a405a8ed9f
--- /dev/null
+++ b/tests/tools/test_background_spawn_path_parity.py
@@ -0,0 +1,43 @@
+"""Background terminal PATH matches the foreground's Hermes-managed dirs.
+
+A gateway started by systemd lacks ``$HERMES_HOME/bin`` on PATH. The foreground
+terminal (``_make_run_env``) appended it, the background spawn
+(``ProcessRegistry._spawn_env``) did not, so ``terminal(background=true)`` ran
+``hermes-core-wt`` as "No such file or directory" on the hub while the same
+command in the foreground worked.
+"""
+
+import os
+
+import pytest
+
+from tools.environments import local as local_mod
+from tools.environments.local import _make_run_env
+from tools.process_registry import ProcessRegistry
+
+pytestmark = pytest.mark.platforms("posix")
+
+
+@pytest.fixture
+def hermes_bin(monkeypatch, tmp_path):
+    home = tmp_path / "hermes-home"
+    (home / "bin").mkdir(parents=True)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HOME", str(tmp_path / "user-home"))
+    monkeypatch.setenv("PATH", "/usr/bin:/bin")
+    monkeypatch.setattr(local_mod, "_git_bash_bin_dirs", list)
+    monkeypatch.setattr(local_mod, "_resolve_hermes_bin_dir", lambda: None)
+    return str(home / "bin")
+
+
+def test_background_spawn_env_has_hermes_home_bin(hermes_bin):
+    entries = ProcessRegistry._spawn_env({})["PATH"].split(os.pathsep)
+    assert hermes_bin in entries
+    # The user's own entries keep precedence over appended Hermes dirs.
+    assert entries.index("/usr/bin") < entries.index(hermes_bin)
+
+
+def test_background_path_is_superset_of_foreground_path(hermes_bin):
+    foreground = set(_make_run_env({})["PATH"].split(os.pathsep))
+    background = set(ProcessRegistry._spawn_env({})["PATH"].split(os.pathsep))
+    assert foreground - background == set()
diff --git a/tests/tools/test_terminal_hints.py b/tests/tools/test_terminal_hints.py
index f61dd268f1..d0e6c2db54 100644
--- a/tests/tools/test_terminal_hints.py
+++ b/tests/tools/test_terminal_hints.py
@@ -2,6 +2,7 @@
 
 from unittest.mock import patch as mock_patch
 
+import pytest
 
 from tools.terminal_hints import annotate_failure, annotate_masked_success
 
@@ -275,3 +276,54 @@ class TestStatusEchoWrapper:
         out = "error: could not compile `x`\n"
         assert "pipeline" in (annotate_masked_success("cargo build | tail -5", out) or "")
         assert "`||` fallback" in (annotate_masked_success("cargo build || echo FAILED", out) or "")
+
+
+class TestMaskedMissingCommand:
+    """A missing command hidden behind a pipe's exit 0 (incident agent-dab059c232: a background
+    `timeout 600 hermes-core-wt test ... | tail -15` printed `timeout: failed to run command
+    'hermes-core-wt': No such file or directory` and reported exit 0)."""
+
+    INCIDENT = "timeout 600 hermes-core-wt test --wt x tests/foo.py 2>&1 | tail -15"
+
+    @pytest.mark.parametrize("output", [
+        "timeout: failed to run command 'hermes-core-wt': No such file or directory\n",
+        "timeout: failed to run command \u2018hermes-core-wt\u2019: No such file or directory\n",
+        "bash: line 1: hermes-core-wt: command not found\n",
+        "nice: \u2018hermes-core-wt\u2019: No such file or directory\n",
+        "env: 'hermes-core-wt': No such file or directory\n",
+    ])
+    def test_missing_command_behind_pipe_flagged(self, output):
+        assert "pipeline" in (annotate_masked_success(self.INCIDENT, output) or "")
+
+    def test_ordinary_no_such_file_not_flagged(self):
+        # A plain ENOENT from a tool's own file argument is content, not a missing command.
+        out = "cat: notes.txt: No such file or directory\n"
+        assert annotate_masked_success("make docs 2>&1 | tail -5", out) is None
+
+
+class TestProcessResultMaskedHint:
+    """poll/wait results on a background process carry the same masked-success hint as the
+    foreground terminal result and the completion notice."""
+
+    def test_wait_result_gets_hint(self, monkeypatch):
+        import json
+
+        from tools import process_registry as pr
+
+        result = {"session_id": "proc_x", "status": "exited", "exit_code": 0,
+                  "command": TestMaskedMissingCommand.INCIDENT,
+                  "output": "timeout: failed to run command 'hermes-core-wt': No such file or directory\n"}
+        monkeypatch.setitem(pr._SESSION_ACTIONS, "wait", (lambda sid, a: dict(result), True))
+        out = json.loads(pr._handle_process({"action": "wait", "session_id": "proc_x"}))
+        assert "pipeline" in out.get("hint", ""), out
+
+    def test_clean_wait_result_has_no_hint(self, monkeypatch):
+        import json
+
+        from tools import process_registry as pr
+
+        result = {"session_id": "proc_x", "status": "exited", "exit_code": 0,
+                  "command": TestMaskedMissingCommand.INCIDENT, "output": "12 passed\n"}
+        monkeypatch.setitem(pr._SESSION_ACTIONS, "wait", (lambda sid, a: dict(result), True))
+        out = json.loads(pr._handle_process({"action": "wait", "session_id": "proc_x"}))
+        assert "hint" not in out
diff --git a/tools/environments/local.py b/tools/environments/local.py
index e9d65a7496..7b6bc440e9 100644
--- a/tools/environments/local.py
+++ b/tools/environments/local.py
@@ -354,10 +354,14 @@ def _sanitize_subprocess_env(base_env: dict | None, extra_env: dict | None = Non
 
 
 def _terminal_env(env: dict) -> dict:
-    """*env* with the user's tools first on PATH (``_user_tools_first``), for background commands."""
+    """*env* with the foreground terminal's PATH completion, for background commands: missing
+    sane / Hermes-managed (``$HERMES_HOME/bin``, pm node) / ``~/.local/bin`` dirs appended, then
+    the user's tools first. Same composition as ``_make_run_env``, so a command that resolves in
+    the foreground also resolves under ``terminal(background=true)`` on a gateway whose service
+    PATH lacks those dirs (systemd on the hub)."""
     path_key = _path_env_key(env)
     if path_key is not None:
-        env[path_key] = _user_tools_first(env[path_key])
+        env[path_key] = _user_tools_first(_append_missing_sane_path_entries(env[path_key]))
     return env
 
 
