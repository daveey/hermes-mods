+++ b/tools/process_registry_wait_policy.py
@@ -186,3 +186,21 @@ def apply_wait_poll_policy(action: str, session_id: str, result: dict) -> dict:
     else:
         result["note"] = note
     return result
+
+
+def with_masked_success_hint(result):
+    """*result* with the foreground terminal's masked-success ``hint`` when an exited-0
+    poll/wait/log shows a hidden failure (`| tail` over "command not found"). Advice only: the
+    exit code is unchanged (agent-dab059c232: a background `timeout ... | tail` reported exit 0
+    without ever running). Results with no output (write/submit/close) pass through."""
+    if not isinstance(result, dict) or result.get("exit_code") != 0 or "hint" in result:
+        return result
+    output = result.get("output") or result.get("output_preview")
+    if isinstance(output, str) and output:
+        try:
+            from tools.terminal_hints import annotate_masked_success
+            if note := annotate_masked_success(str(result.get("command") or ""), output):
+                result["hint"] = note
+        except Exception:
+            logger.debug("masked-success hint failed", exc_info=True)
+    return result
diff --git a/tools/terminal_hints.py b/tools/terminal_hints.py
index 3a898a07c0..b42d389a56 100644
--- a/tools/terminal_hints.py
+++ b/tools/terminal_hints.py
@@ -153,6 +153,13 @@ _FAILURE_SHAPES = re.compile(
     r"|BUILD FAILED|Build FAILED"             # gradle/msbuild/echoed fallbacks
     r"|FAILED: "                              # ninja
     r"|(?m:^make(?:\[\d+\])?: \*\*\*)"        # make
+    # A missing command: the shell's own message, or a wrapper (timeout/env/nice/...) that
+    # could not exec it. Behind `| tail` the run "passed" without running at all
+    # (agent-dab059c232). A tool's own file argument (`cat: x: No such file`) is not matched.
+    r"|(?m:^[^\n]*: command not found$)"
+    r"|failed to run command [\u2018'\"][^\u2019'\"\n]+[\u2019'\"]: No such file or directory"
+    r"|(?m:^(?:env|nice|nohup|stdbuf|xargs|timeout|sudo|ionice|setsid|chrt|taskset): "
+    r"[\u2018'\"][^\u2019'\"\n]+[\u2019'\"]: No such file or directory)"
     r")")
 
 
