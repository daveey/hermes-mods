From 5ada37487f1449dda8c2a0f6c0b7216aa9510199 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 01:31:29 -0800
Subject: [PATCH] test(kanban): pr_wake fixture patches _profile_home with its
 new (assignee, task_id) signature [daveey]

f73a1f8466 changed kanban_wake_check._profile_home(task) to (assignee, task_id=None);
test_closed_pr_wakes_real_board_but_does_not_complete still patched a one-argument
lambda and failed with TypeError (2 tests, hub kanban sweep).
---
 tests/hermes_cli/test_kanban_pr_wake.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_pr_wake.py b/tests/hermes_cli/test_kanban_pr_wake.py
index b6a29215f7..9743d34057 100644
--- a/tests/hermes_cli/test_kanban_pr_wake.py
+++ b/tests/hermes_cli/test_kanban_pr_wake.py
@@ -116,7 +116,7 @@ def test_closed_pr_wakes_real_board_but_does_not_complete(probe, tmp_path, monke
         command = (f"PYTHONPATH={shlex.quote(str(Path(kb.__file__).resolve().parents[1]))} "
                    f"PATH={shlex.quote(str(tmp_path) + ':' + os.environ['PATH'])} "
                    f"{shlex.quote(sys.executable)} -m hermes_cli.kanban_pr_wake {URL}{extra}")
-        monkeypatch.setattr(wakes, "_profile_home", lambda task: str(tmp_path / "home"))
+        monkeypatch.setattr(wakes, "_profile_home", lambda assignee, task_id=None: str(tmp_path / "home"))
         assert kb.schedule_task(conn, tid, reason="SCHEDULED_UNTIL=2099-01-01T00:00:00Z", wake_check=command, check_every=120)
         wakes.run_due_wake_checks(conn, now=int(time.time()), wait=True)
         assert kb.get_task(conn, tid).status == "ready", wakes.get_state(conn, tid)["last_out"]
