From 213fc994ea3648296de06ad591216202146181ba Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 00:39:14 +0000
Subject: [PATCH] test(ci): stall the cache TLS proxy without overriding runner
 credentials

---
 .github/workflows/cache-save-timeout-smoke.yml | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/.github/workflows/cache-save-timeout-smoke.yml b/.github/workflows/cache-save-timeout-smoke.yml
index 49661fc5fee..cbf353bcd29 100644
--- a/.github/workflows/cache-save-timeout-smoke.yml
+++ b/.github/workflows/cache-save-timeout-smoke.yml
@@ -34,8 +34,8 @@ jobs:
           import threading
           root = Path(sys.argv[1])
           class Blackhole(BaseHTTPRequestHandler):
-              def do_POST(self):
-                  (root / 'request').touch()
+              def do_CONNECT(self):
+                  (root / 'request').write_text(self.path, encoding='utf-8')
                   threading.Event().wait()
               def log_message(self, *args):
                   pass
@@ -54,17 +54,18 @@ jobs:
           python3 -c 'import time, pathlib, os; pathlib.Path(os.environ["RUNNER_TEMP"], "cache-timeout-probe", "started").write_text(str(time.monotonic()), encoding="utf-8")'
 
       # This is the same pinned save action and timeout policy used by lint.yml.
-      # Use a fake token: no real credential is sent to the test endpoint.
+      # Stall CONNECT before TLS opens: the proxy receives only the hostname, never a token.
+      # ACTIONS_* overrides do not work here: the runner overwrites them before launching Node.
       - name: Save to the unresponsive cache endpoint
         id: save
         continue-on-error: true
         timeout-minutes: 1
         uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
         env:
-          ACTIONS_CACHE_SERVICE_V2: 'true'
-          ACTIONS_RESULTS_URL: ${{ env.CACHE_PROBE_URL }}
-          ACTIONS_CACHE_URL: ${{ env.CACHE_PROBE_URL }}
-          ACTIONS_RUNTIME_TOKEN: cache-timeout-probe-not-a-credential
+          HTTPS_PROXY: ${{ env.CACHE_PROBE_URL }}
+          https_proxy: ${{ env.CACHE_PROBE_URL }}
+          NO_PROXY: ''
+          no_proxy: ''
         with:
           path: ${{ runner.temp }}/cache-timeout-probe/payload
           key: timeout-probe-${{ github.run_id }}-${{ github.run_attempt }}
-- 
2.55.0

