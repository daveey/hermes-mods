From fb146e85f2da6458c28eb65f329ae0753ed34507 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 19:09:14 +0000
Subject: [PATCH] [daveey] lifecycle guard: fail closed on parameter-expanded
 script writers

Treat parameter expansion as unknown generated content, preserving quoted-heredoc literal handling. Four real-Bash differential regressions failed before this fix and pass after it. Full cron/tool guard/heredoc suite: 12929 passed, 0 failed, 9 skipped.
---
 cron/lifecycle_guard_generated.py                    |  7 +++++--
 tests/cron/test_lifecycle_guard_generated_scripts.py | 11 +++++++++++
 2 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/cron/lifecycle_guard_generated.py b/cron/lifecycle_guard_generated.py
index 30e7dacc14af04c9138348606b9e5c67967aabc1..048b1b88fc0f1d949f449759b5d55d3a9ecc9b2b 100644
--- a/cron/lifecycle_guard_generated.py
+++ b/cron/lifecycle_guard_generated.py
@@ -47,8 +47,11 @@ if TYPE_CHECKING:
 
 # Marks a write whose content the guard cannot know.
 UNKNOWN: None = None
-# Text that makes a heredoc body or argument produce output decided only when it runs.
-_DYNAMIC_MARKS = ("$(", "`", "<(", ">(")
+# Parameter expansion also changes emitted bytes; do not mistake $NAME/${NAME} for
+# literal script text. Segment views lose quoting, so dollar-bearing printer and
+# here-string arguments conservatively count as unknown even if originally quoted.
+# Quoted heredoc bodies retain their literal-content exception below.
+_DYNAMIC_MARKS = ("$", "`", "<(", ">(")
 _STDIN_COPIERS = frozenset({"cat", "tee"})
 _PRINTERS = frozenset({"echo", "printf"})
 # File copiers: what lands at the destination is another file's content, so it is unknown here.
diff --git a/tests/cron/test_lifecycle_guard_generated_scripts.py b/tests/cron/test_lifecycle_guard_generated_scripts.py
index 86962d14a1704602a216d04ec978fa57ecb65810..ab0f20bcce7c5bf81f37200f595c0df242a3cf37 100644
--- a/tests/cron/test_lifecycle_guard_generated_scripts.py
+++ b/tests/cron/test_lifecycle_guard_generated_scripts.py
@@ -99,6 +99,17 @@ def test_unpredictable_writer_then_execute_fails_closed(tmp_path, big, template)
     assert _differential(tmp_path, command)
 
 
+@pytest.mark.parametrize("command", [
+    'echo "$PAYLOAD" > F; bash F',
+    'printf "%s\\n" "${PAYLOAD}" > F; bash F',
+    'cat > F <<EOF\n$PAYLOAD\nEOF\nbash F',
+    'cat <<< "$PAYLOAD" > F; bash F',
+])
+def test_parameter_expanded_writer_fails_closed(tmp_path, big, monkeypatch, command):
+    monkeypatch.setenv("PAYLOAD", big)
+    assert _differential(tmp_path, command)
+
+
 @pytest.mark.parametrize("transport", _WRITE_THEN_RUN)
 def test_generated_lifecycle_command_is_refused(tmp_path, transport):
     (tmp_path / "sub").mkdir()
-- 
