From 3ca096ffbbccc8911672ca967edb8f6182298dc1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 11:03:33 +0000
Subject: [PATCH] fix(kanban): standing-ask re-check reads named cards from
 title/action/why_human, not evidence [daveey]

A done probe cited as proof in evidence voided t_01a18c0215a4efe9's still-valid
'Unlock the MacBook screen' ask as named_cards_closed.
---
 hermes_cli/kanban_block_policy.py           |  3 ++-
 tests/hermes_cli/test_kanban_ask_recheck.py | 15 ++++++++++++++-
 2 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_block_policy.py b/hermes_cli/kanban_block_policy.py
index 92fa94941ae..bf115017ec7 100644
--- a/hermes_cli/kanban_block_policy.py
+++ b/hermes_cli/kanban_block_policy.py
@@ -249,7 +249,8 @@ _TASK_ID = re.compile(r"(?<![\w/])t_[0-9a-f]{8,16}\b")
 
 
 def _named_task_ids(title, request: dict, own_id: str) -> list[str]:
-    text = " ".join([str(title or "")] + [str(request.get(k) or "") for k in ("action", "why_human", "evidence")])
+    # Premise only: a card cited as proof in ``evidence`` (a done probe) is not what the ask waits on.
+    text = " ".join([str(title or "")] + [str(request.get(k) or "") for k in ("action", "why_human")])
     return sorted({m.group(0) for m in _TASK_ID.finditer(text)} - {own_id})
 
 
diff --git a/tests/hermes_cli/test_kanban_ask_recheck.py b/tests/hermes_cli/test_kanban_ask_recheck.py
index 54dbbcd2475..92962aa1bb5 100644
--- a/tests/hermes_cli/test_kanban_ask_recheck.py
+++ b/tests/hermes_cli/test_kanban_ask_recheck.py
@@ -78,7 +78,7 @@ def test_all_named_cards_closed_moves_card_to_triage(conn):
     a = kb.create_task(conn, title="named a")
     b = kb.create_task(conn, title="named b")
     tid = _blocked(conn, _ask(f"Approve the deploy once {a} lands. Unblock = deploy; archive = drop.",
-                              evidence=f"waiting on {b}"))
+                              why=f"David decides once {b} is out"))
     assert _sweep(conn) == []  # both named cards open: the ask stands
     _set_status(conn, a, "done")
     assert _sweep(conn) == []  # one still open
@@ -90,6 +90,19 @@ def test_all_named_cards_closed_moves_card_to_triage(conn):
     assert a in ev["reason"] and b in ev["reason"]
 
 
+def test_card_cited_only_in_evidence_is_not_the_premise(conn):
+    # t_01a18c0215a4efe9: "Unlock the MacBook screen" cited a done probe card as proof in evidence; the sweep
+    # voided the ask while the screen was still locked. Evidence is proof, not the ask's premise.
+    from hermes_cli import kanban_db as kb
+    probe = kb.create_task(conn, title="probe")
+    _set_status(conn, probe, "done")
+    tid = _blocked(conn, _ask("Unlock the MacBook screen, then reply unlocked. Unblock = continue; archive = drop.",
+                              why="Screen is locked at loginwindow; no stored login",
+                              evidence=f"probe {probe} frontmost=com.apple.loginwindow"))
+    assert _sweep(conn) == []
+    assert kb.get_task(conn, tid).status == "blocked" and _events(conn, tid) == []
+
+
 def test_named_id_not_on_this_board_is_untouched(conn):
     tid = _blocked(conn, _ask("Approve once macbook/t_0123456789abcdef is done. Unblock = go; archive = drop."))
     assert _sweep(conn) == []
-- 
