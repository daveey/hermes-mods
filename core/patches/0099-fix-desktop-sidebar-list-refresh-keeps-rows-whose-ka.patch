From 8eb3e00750476b525c2f9ec2fae32caa5751e750 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 15 Oct 2026 20:32:19 -0700
Subject: [PATCH] fix(desktop): sidebar list refresh keeps rows whose
 kanban/goal/cron/background activity changed [daveey]

sameCronSignature gated the $sessions swap on content fields only. A refresh whose
only delta was kanban_active/kanban_blocked (a card finishing, flapping through
triage), goal_active, cron_active or background_active kept the previous array,
so the row's kanban badge and done/working stripe stayed frozen until the
session's own messages moved.
---
 apps/desktop/src/lib/session-signatures.test.ts | 17 +++++++++++++++++
 apps/desktop/src/lib/session-signatures.ts      | 10 +++++++++-
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/lib/session-signatures.test.ts b/apps/desktop/src/lib/session-signatures.test.ts
index cd5f39b086..230210a7f7 100644
--- a/apps/desktop/src/lib/session-signatures.test.ts
+++ b/apps/desktop/src/lib/session-signatures.test.ts
@@ -49,6 +49,23 @@ describe('sameCronSignature', () => {
     expect(sameCronSignature(a, b)).toBe(false)
   })
 
+  // The backend stamps live activity on list rows (kanban counts, goal, cron,
+  // background jobs). A card finishing elsewhere moves only those fields, so a
+  // gate that ignored them kept the sidebar badge and stripe frozen on the old
+  // counts until the row's own messages moved. [daveey]
+  it.each([
+    ['kanban_active', 2, 1],
+    ['kanban_blocked', 1, undefined],
+    ['goal_active', true, undefined],
+    ['cron_active', true, undefined],
+    ['background_active', 1, 2]
+  ] as const)('is false when only %s changed', (field, before, after) => {
+    const a = [session('a', 't', { [field]: before })]
+    const b = [session('a', 't', { [field]: after })]
+    expect(sameCronSignature(a, b)).toBe(false)
+    expect(sameCronSignature(a, [session('a', 't', { [field]: before })])).toBe(true)
+  })
+
   it('is false when only the archived flag changed', () => {
     const a = [session('a', 't', { archived: false })]
     const b = [session('a', 't', { archived: true })]
diff --git a/apps/desktop/src/lib/session-signatures.ts b/apps/desktop/src/lib/session-signatures.ts
index 72576e4415..cac7bde7d5 100644
--- a/apps/desktop/src/lib/session-signatures.ts
+++ b/apps/desktop/src/lib/session-signatures.ts
@@ -35,7 +35,15 @@ export function sameCronSignature(a: SessionInfo[], b: SessionInfo[]): boolean {
       // frozen copy forever. An idle conversation never moves any of the
       // fields above again, which is exactly when a pin gets toggled (#76919).
       session.pinned === other.pinned &&
-      session.archived === other.archived
+      session.archived === other.archived &&
+      // Live activity the backend stamps on each row. A kanban card finishing
+      // or a background job exiting moves only these, and they drive the
+      // sidebar badge and the done/working stripe. [daveey]
+      session.kanban_active === other.kanban_active &&
+      session.kanban_blocked === other.kanban_blocked &&
+      session.goal_active === other.goal_active &&
+      session.cron_active === other.cron_active &&
+      session.background_active === other.background_active
     )
   })
 }
