From ed23639b3088bb15826f92ce46a30d6578bc95e8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 01:51:42 -0700
Subject: [PATCH] fix(tests): the run summary counts setup errors, not just
 failures

On hermes-hub, tests/pm/test_source_update_launch.py errored in 18 fixtures
(no real uv) and exited 1 under "=== Summary: 1 files, 1 tests passed,
0 failed". The exit code was right; the one line people and agents read
said green, and I first reported that file as passing on Linux.

Five whys:
1. Why "0 failed"? The summary sums pytest's "failed" only.
2. Why are errors missing? _on_done accumulates passed/failed/skipped and
   folds "errors" into tests_collected only.
3. Why not noticed? The crash note (#113186) fixed the same shape for
   signal deaths; setup errors were left out.
4. Gap: the summary line now appends ", N errored" whenever pytest
   reported errors. Covered by
   test_setup_errors_are_counted_on_the_summary_line.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 scripts/run_tests_parallel.py            |  8 ++++--
 tests/scripts/test_run_tests_parallel.py | 36 ++++++++++++++++++++++++
 2 files changed, 42 insertions(+), 2 deletions(-)

diff --git a/scripts/run_tests_parallel.py b/scripts/run_tests_parallel.py
index 2b62a69fca..9a671fde53 100644
--- a/scripts/run_tests_parallel.py
+++ b/scripts/run_tests_parallel.py
@@ -1648,6 +1648,7 @@ def main() -> int:
     fail_count = 0
     tests_passed = 0
     tests_failed = 0
+    tests_errored = 0
     tests_skipped = 0
     skipped_files: list[tuple[Path, int]] = []
     # Every collected outcome, not just pass/fail: a legitimately all-skipped
@@ -1659,7 +1660,7 @@ def main() -> int:
     lock = threading.Lock()
 
     def _on_done(file: Path, started_at: float, fut: Future[tuple[Path, int, str, dict[str, int], float]]) -> None:
-        nonlocal files_done, tests_done, pass_count, fail_count, tests_passed, tests_failed, tests_skipped
+        nonlocal files_done, tests_done, pass_count, fail_count, tests_passed, tests_failed, tests_errored, tests_skipped
         nonlocal tests_collected, files_crashed
         n_tests = test_counts.get(file, 0)
         try:
@@ -1684,6 +1685,7 @@ def main() -> int:
             # Accumulate test-level counts from parsed summary.
             tests_passed += summary.get("passed", 0)
             tests_failed += summary.get("failed", 0)
+            tests_errored += summary.get("errors", 0)
             tests_skipped += summary.get("skipped", 0)
             if summary.get("skipped", 0):
                 skipped_files.append((fpath, summary["skipped"]))
@@ -1746,7 +1748,9 @@ def main() -> int:
         f", {files_crashed} file{'s' if files_crashed != 1 else ''} CRASHED"
         if files_crashed else ""
     )
-    print(f"=== Summary: {len(files)} files, {tests_passed} tests passed, {tests_failed} failed{crashed_note}{skipped_note} ({pct:.0f}% complete) in {elapsed:.1f}s ({args.jobs} workers) ===")
+    # Setup/teardown errors fail the run too; "0 failed" with exit 1 read as green.
+    errored_note = f", {tests_errored} errored" if tests_errored else ""
+    print(f"=== Summary: {len(files)} files, {tests_passed} tests passed, {tests_failed} failed{errored_note}{crashed_note}{skipped_note} ({pct:.0f}% complete) in {elapsed:.1f}s ({args.jobs} workers) ===")
 
     # Host-OS gating note: tests marked for another OS were skipped by the
     # conftest hook, not run. Say so explicitly — a green local run on Linux
diff --git a/tests/scripts/test_run_tests_parallel.py b/tests/scripts/test_run_tests_parallel.py
index bdadc46196..0579b1ff7c 100644
--- a/tests/scripts/test_run_tests_parallel.py
+++ b/tests/scripts/test_run_tests_parallel.py
@@ -669,6 +669,42 @@ def test_passthrough_ignore_drops_files_the_runner_hands_pytest_explicitly(
 
 
 
+def test_setup_errors_are_counted_on_the_summary_line(tmp_path: Path) -> None:
+    """A file whose tests error in setup must not read ``0 failed`` on the summary.
+
+    tests/pm/test_source_update_launch.py on a host without uv: 18 fixture errors, exit 1,
+    and ``=== Summary: 1 files, 1 tests passed, 0 failed``, which read as green.
+    """
+    probe_dir = tmp_path / "probe"
+    probe_dir.mkdir()
+    (probe_dir / "test_probe_setup_error.py").write_text(
+        textwrap.dedent(
+            """
+            import pytest
+
+            @pytest.fixture
+            def broken():
+                raise RuntimeError("setup fails")
+
+            def test_ok():
+                assert True
+
+            def test_a(broken):
+                pass
+
+            def test_b(broken):
+                pass
+            """
+        )
+    )
+
+    proc = _run_runner(probe_dir, "--file-retries", "0")
+
+    assert proc.returncode != 0
+    summary = next(line for line in proc.stdout.splitlines() if line.startswith("=== Summary"))
+    assert "1 tests passed, 0 failed, 2 errored" in summary, summary
+
+
 @pytest.mark.platforms("posix")  # POSIX signal death; Windows has no SIGSEGV exit
 def test_interpreter_crash_is_reported_as_a_crash_not_as_no_tests_ran(tmp_path: Path) -> None:
     """A file whose interpreter dies by signal is classified as CRASHED (#113186).
-- 
2.55.0

