From 4c884bdd31399b54d924ee53e4ab444cd81beb12 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 14:04:53 +0000
Subject: [PATCH] test(desktop): collect browser hint imports before behavior
 deadline [daveey]

---
 .../src/lib/keybinds/browser-hints.test.tsx   | 22 ++++++++++---------
 1 file changed, 12 insertions(+), 10 deletions(-)

diff --git a/apps/desktop/src/lib/keybinds/browser-hints.test.tsx b/apps/desktop/src/lib/keybinds/browser-hints.test.tsx
index a4929328ff3..48f60572b44 100644
--- a/apps/desktop/src/lib/keybinds/browser-hints.test.tsx
+++ b/apps/desktop/src/lib/keybinds/browser-hints.test.tsx
@@ -1,8 +1,16 @@
 import { act, cleanup, fireEvent, render, within } from '@testing-library/react'
-import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { afterEach, expect, it, vi } from 'vitest'
 
-beforeEach(() => {
-  vi.resetModules()
+import { KeybindSettings } from '@/app/settings/keybind-settings'
+import { TipBubble } from '@/components/tips/tip-bubble'
+import { TipKeybindLabel } from '@/components/ui/tooltip'
+import { I18nProvider } from '@/i18n'
+import { TIP_CATALOG } from '@/lib/tips/catalog'
+import { setBinding } from '@/store/keybinds'
+
+// Defaults read the host and saved bindings at module initialization. Stage those
+// inputs before collection imports, not a cold renderer import inside the 15s test.
+vi.hoisted(() => {
   localStorage.clear()
   window.document.documentElement.dataset.hermesDesktopHost = 'browser'
 })
@@ -13,13 +21,7 @@ afterEach(() => {
   delete window.document.documentElement.dataset.hermesDesktopHost
 })
 
-it('renders the resolved browser binding in the first-run tip, tooltips and settings, including remaps', async () => {
-  const { TipBubble } = await import('@/components/tips/tip-bubble')
-  const { TipKeybindLabel } = await import('@/components/ui/tooltip')
-  const { KeybindSettings } = await import('@/app/settings/keybind-settings')
-  const { I18nProvider } = await import('@/i18n')
-  const { TIP_CATALOG } = await import('@/lib/tips/catalog')
-  const { setBinding } = await import('@/store/keybinds')
+it('renders the resolved browser binding in the first-run tip, tooltips and settings, including remaps', () => {
   const tip = TIP_CATALOG.find(entry => entry.id === 'new-session')!
   const anchor = window.document.createElement('button')
   window.document.body.append(anchor)
