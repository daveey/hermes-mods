diff --git a/tests/hermes_cli/test_config_version_stamp_cache.py b/tests/hermes_cli/test_config_version_stamp_cache.py
new file mode 100644
index 00000000000..94049771d79
--- /dev/null
+++ b/tests/hermes_cli/test_config_version_stamp_cache.py
@@ -0,0 +1,83 @@
+"""``read_config_version_stamp`` re-parses config.yaml only when the file changes.
+
+``/api/status`` reads the stamp on every Desktop poll. A full YAML parse of a ~2500-line config there
+held the GIL ~40 ms per call and stretched every request queued behind it in a wake burst. [daveey]
+"""
+
+import os
+
+import pytest
+
+from hermes_cli import config_version_stamp as cvs
+
+
+@pytest.fixture
+def hermes_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    getattr(cvs, "_stamp_cache", {}).clear()
+    yield home
+    getattr(cvs, "_stamp_cache", {}).clear()
+
+
+@pytest.fixture
+def parses(monkeypatch):
+    from hermes_cli import config
+
+    real = config.fast_safe_load
+    count = [0]
+
+    def counting(stream):
+        count[0] += 1
+        return real(stream)
+
+    monkeypatch.setattr(config, "fast_safe_load", counting)
+    return count
+
+
+def _write(home, text):
+    path = home / "config.yaml"
+    path.write_text(text, encoding="utf-8")
+    return path
+
+
+def test_an_unchanged_config_is_parsed_once(hermes_home, parses):
+    _write(hermes_home, "_config_version: 7\nmodel:\n  default: x\n")
+    assert cvs.check_config_version()[0] == 7
+    assert cvs.check_config_version()[0] == 7
+    assert cvs.read_config_version_stamp()[0] == 7
+    assert parses[0] == 1
+
+
+def test_a_rewrite_is_seen_on_the_next_read(hermes_home, parses):
+    path = _write(hermes_home, "_config_version: 7\n")
+    assert cvs.check_config_version()[0] == 7
+    path.write_text("_config_version: 9\n", encoding="utf-8")  # same size
+    st = path.stat()
+    os.utime(path, ns=(st.st_atime_ns, st.st_mtime_ns + 1_000_000))
+    assert cvs.check_config_version()[0] == 9
+    _write(hermes_home, "model: {}\n")  # stamp removed
+    assert cvs.read_config_version_stamp()[0] is None
+    assert parses[0] == 3
+
+
+def test_parse_errors_are_not_cached_and_still_raise_for_strict_callers(hermes_home, parses):
+    from hermes_cli.config import InvalidUserConfigError
+
+    _write(hermes_home, "_config_version: [unclosed\n")
+    _, latest = cvs.check_config_version()
+    assert cvs.check_config_version() == (latest, latest)  # tolerant: latest/latest, as before
+    with pytest.raises(InvalidUserConfigError):
+        cvs.check_config_version(raise_on_parse_error=True)
+    assert parses[0] >= 3  # every call re-read the broken file
+
+
+def test_a_non_mapping_root_stays_unusable_from_the_cache(hermes_home, parses):
+    from hermes_cli.config import InvalidUserConfigError
+
+    _write(hermes_home, "- a\n- b\n")
+    assert cvs.read_config_version_stamp()[0] is None
+    with pytest.raises(InvalidUserConfigError, match="must be a mapping, got list"):
+        cvs.check_config_version(raise_on_parse_error=True)
+    assert parses[0] == 1
diff --git a/tests/hermes_cli/test_kanban_chat_links.py b/tests/hermes_cli/test_kanban_chat_links.py
index ac8e33b43b8..16333d1007e 100644
--- a/tests/hermes_cli/test_kanban_chat_links.py
+++ b/tests/hermes_cli/test_kanban_chat_links.py
@@ -251,3 +251,49 @@ def test_unknown_replica_card_waits_like_a_parked_one(live, kanban_home, monkeyp
     assert ksa.active_task_counts() == {"s1": 2, "s2": 1}
     parked, held = ksa.parked_task_counts()
     assert parked == {"s1": 2} and held == {}
+
+
+def test_session_tasks_stale_ok_reaches_the_replica_owner_labels(live, kanban_home, monkeypatch, tmp_path):
+    """[daveey] The Desktop strip's ``stale_ok`` must reach ``_ledger_owners``: it used to stop at
+    ``replica_cards``, so ``/api/session-kanban-tasks`` waited on every ledger rebuild in replica mode."""
+    rep = tmp_path / "default.db"
+    _replica(rep, [("t_remote", "from replica", "running", OTHER)], [("t_remote", ME, "s1", "shepherd", 0)])
+    _switch_to_replica(kanban_home, monkeypatch, rep)
+    calls = []
+
+    def remote_links(stale_ok=False):
+        calls.append(stale_ok)
+        return [_ledger_row("t_remote", "s1")]
+
+    monkeypatch.setattr(ksa, "_remote_links", remote_links)
+    assert [t["id"] for t in ksa.session_tasks(["s1"], stale_ok=True)] == ["t_remote"]
+    assert calls == [True]
+    calls.clear()
+    assert [t["id"] for t in ksa.session_tasks(["s1"])] == ["t_remote"]
+    assert calls == [False]  # every other reader keeps read-your-writes
+
+
+def test_session_tasks_stale_ok_does_not_wait_behind_a_ledger_rebuild(live, kanban_home, monkeypatch, tmp_path):
+    """A rebuild holding ``_links_lock`` (a board write moved the fingerprint) must not hold the strip."""
+    import threading
+    rep = tmp_path / "default.db"
+    _replica(rep, [("t_remote", "from replica", "running", OTHER)], [("t_remote", ME, "s1", "shepherd", 0)])
+    _switch_to_replica(kanban_home, monkeypatch, rep)
+    monkeypatch.setattr(ksa, "_remote_links", _real_remote_links)  # the real cache + lock, not the stub
+    monkeypatch.setattr(ksa, "_project_remote_links", lambda: [_ledger_row("t_remote", "s1")])
+    fp = ["v1"]
+    monkeypatch.setattr(ksa, "_links_fingerprint", lambda: (fp[0],))
+    assert [t["id"] for t in ksa.session_tasks(["s1"], stale_ok=True)] == ["t_remote"]  # primes the projection
+    fp[0] = "v2"  # a board write: the projection is stale and a rebuild is due
+    out: list = []
+    with ksa._links_lock:  # a rebuild in flight
+        th = threading.Thread(target=lambda: out.append(ksa.session_tasks(["s1"], stale_ok=True)), daemon=True)
+        th.start()
+        th.join(timeout=3)
+        finished = not th.is_alive()
+    th.join(timeout=5)
+    assert finished, "stale_ok session_tasks waited on _links_lock"
+    assert [t["id"] for t in out[0]] == ["t_remote"]
+
+
+_real_remote_links = ksa._remote_links
-- 
