From bc81ee9e011cfe06112d19827617a22597f875d5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 02:16:12 +0000
Subject: [PATCH] test(kanban): verify imported snapshots never inert source
 [daveey]

Extend the private-copy control through supported import as well as export; redirecting either connection to the original board is rejected by the spy before source scrubbing. No production change.
---
 tests/hermes_cli/test_kanban_containment_guard_predicates.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_containment_guard_predicates.py b/tests/hermes_cli/test_kanban_containment_guard_predicates.py
index cc4cea4718f9903bfdc449ea230aa4c80e27268b..e0230be66dc25fc3743acc159347ad81a241e986 100644
--- a/tests/hermes_cli/test_kanban_containment_guard_predicates.py
+++ b/tests/hermes_cli/test_kanban_containment_guard_predicates.py
@@ -84,6 +84,9 @@ def test_export_never_inerts_or_scrubs_source_connection(board, tmp_path, monkey
     monkeypatch.setattr(guard, "inert_snapshot", private_only)
     assert transfer.export_board("default", str(tmp_path / "fixture.tar.gz"))
     assert len(seen) == 1
+    imported = transfer.import_board(str(tmp_path / "fixture.tar.gz"), "fixture-private-import")
+    assert imported["board"] == "fixture-private-import"
+    assert len(seen) == 2 and seen[1] == imported["db_path"]
     row = kb.get_task(board, authority)
     assert row is not None and row.status == "running" and row.current_run_id is not None
     with pytest.raises(sqlite3.IntegrityError, match="containment_pending"):
