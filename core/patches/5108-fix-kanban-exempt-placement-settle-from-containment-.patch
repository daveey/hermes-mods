From 3288774dcdaa54739f65494e225abbcf06768de2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 05:53:05 +0000
Subject: [PATCH] fix(kanban): exempt placement settle from containment
 authority gate; no empty context line

---
 hermes_cli/kanban_db.py                               | 10 +++++++---
 tests/hermes_cli/test_kanban_containment_authority.py | 11 +++++++++++
 2 files changed, 18 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index ead5513532..e8c374a33e 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -2450,7 +2450,8 @@ def complete_task(
     """
     from hermes_cli.kanban_review_required import require_review
     from hermes_cli.kanban_containment_authority import require_acknowledgement
-    require_acknowledgement(conn, task_id, metadata)
+    if not placement_settled:  # a settling placement stub cannot resume/retain; gating it would park forever
+        require_acknowledgement(conn, task_id, metadata)
     require_review(conn, task_id, expected_run_id, placement_settled=placement_settled)
     from hermes_cli import kanban_completion_receipt as receipt_admission
     metadata, receipt_owners = receipt_admission.prepare(conn, task_id, metadata, summary=summary or result)
@@ -2470,7 +2471,8 @@ def complete_task(
     from hermes_cli.kanban_metadata_files import discard_on_error
     staged: list[Path] = []
     with _prestaged(conn, task_id, metadata), discard_on_error(staged), write_txn(conn):
-        require_acknowledgement(conn, task_id, metadata)
+        if not placement_settled:
+            require_acknowledgement(conn, task_id, metadata)
         require_review(conn, task_id, expected_run_id, placement_settled=placement_settled)
         if not _parents_satisfied(conn, task_id):
             return False
@@ -3576,7 +3578,9 @@ def build_worker_context(conn: sqlite3.Connection, task_id: str, *, recovery_tai
     lines: list[str] = []
     _ctx_header(lines, task, conn=conn)
     from hermes_cli.kanban_containment_authority import render_context
-    lines.append(render_context(conn, task_id))
+    authority_notice = render_context(conn, task_id)
+    if authority_notice:
+        lines.append(authority_notice)
     _ctx_standing(lines, task, list_comments(conn, task_id))  # [daveey]
     from hermes_cli.kanban_continuation import render_checkpoint_context
     checkpoint = render_checkpoint_context(conn, task_id)
diff --git a/tests/hermes_cli/test_kanban_containment_authority.py b/tests/hermes_cli/test_kanban_containment_authority.py
index b382a2ecdb..84dd687b40 100644
--- a/tests/hermes_cli/test_kanban_containment_authority.py
+++ b/tests/hermes_cli/test_kanban_containment_authority.py
@@ -147,3 +147,14 @@ def test_producer_release_still_works_with_done_authority(board):
     result = lifecycle.resume_local(board, target=target, episode=episode, actor_task=actor,
                                     actor_run_uid=local.run_uid(board, actor), kind="producer")
     assert result["status"] == "ready"
+
+
+def test_placement_settle_is_not_gated_by_open_episodes(board):
+    relay, _, authority, target, spec = local.setup(board)
+    local.contain(board, relay, target, spec)
+    assert kb.complete_task(board, authority, summary="remote settled", placement_settled=True)
+
+
+def test_context_has_no_blank_line_without_episodes(board):
+    relay = local.setup(board)[0]
+    assert "\n\n\n" not in kb.build_worker_context(board, relay)
-- 
2.43.0

