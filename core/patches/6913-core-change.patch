From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 02:49:02 +0000
Subject: [PATCH 6913] Replay sender: durable single-slot journal, deferred observation and bounded recovery (dormant)

Public mirror of source commit 59e0a37d84f792082315435029c3ba449b10dca2.

---
diff --git a/hermes_cli/kanban_origin_forward_adapter.py b/hermes_cli/kanban_origin_forward_adapter.py
index 798411927a8f7433c1214bfc3cc54124f0cdd055..e5e71efbc94d0392b4be470d4e59745bb7dfbc10 100644
--- a/hermes_cli/kanban_origin_forward_adapter.py
+++ b/hermes_cli/kanban_origin_forward_adapter.py
@@ -37,8 +37,15 @@
     def inventory():
         # Decode failures describe unavailable remote evidence, not a bad caller
         # request. Keep this normalization inside the inventory-read boundary.
+        from hermes_cli.kanban_sync_client import HubError
         try:
             return Hub(load_identity()).machines()
+        except HubError as exc:
+            # Only a malformed 200 body (typed 502 by decode_json) is a decode failure;
+            # real transport/HTTP errors keep their evidence-unavailable classification.
+            if exc.status != 502 or "invalid JSON" not in str(exc):
+                raise
+            raise ValueError("origin_forward_inventory_unavailable") from exc
         except (ValueError, RecursionError) as exc:
             raise ValueError("origin_forward_inventory_unavailable") from exc
 
