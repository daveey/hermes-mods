From 8b741ea26baf84f28932931295fea1cd06fbc763 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 19:47:24 -0700
Subject: [PATCH] kanban: first-run worker MemoryMax is 2x base
 (admission-bounded); recovery doubles from there [daveey]

---
 hermes_cli/kanban_worker_scope.py            | 12 ++++++++----
 tests/hermes_cli/test_kanban_oom_recovery.py | 15 +++++++++++++--
 2 files changed, 21 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_worker_scope.py b/hermes_cli/kanban_worker_scope.py
index dc78c92910..61f3e14dc2 100644
--- a/hermes_cli/kanban_worker_scope.py
+++ b/hermes_cli/kanban_worker_scope.py
@@ -179,10 +179,14 @@ def consecutive_oom_runs(task_id: str, board: str | None = None) -> int:
 
 
 def apply_oom_recovery(argv: list[str], task_id: str, board: str | None = None) -> list[str]:
-    """Rewrite the scope's MemoryMax property after prior OOM kills; no-op otherwise."""
+    """Rewrite the scope's MemoryMax property for a kanban worker.
+
+    Every worker starts at 2x the registry base cap (4 GiB -> 8 GiB) when MemAvailable admits it:
+    a fixed 4 GiB first-run cap OOM-killed fresh workers before recovery could ever apply
+    (3 kills/24h after the typed-recovery deploy, all first runs). Each consecutive OOM-killed
+    run then doubles again, bounded by the 12 GiB ceiling and MemAvailable admission.
+    """
     n = consecutive_oom_runs(task_id, board)
-    if not n:
-        return argv
     for i, arg in enumerate(argv):
         if arg == "--":
             break
@@ -191,7 +195,7 @@ def apply_oom_recovery(argv: list[str], task_id: str, board: str | None = None)
                 base = int(arg[len(_MEMORY_MAX_PROP):])
             except ValueError:
                 return argv
-            new = raised_memory_max(base, n, mem_available_bytes())
+            new = raised_memory_max(base, n + 1, mem_available_bytes())
             if new > base:
                 argv = list(argv)
                 argv[i] = f"{_MEMORY_MAX_PROP}{new}"
diff --git a/tests/hermes_cli/test_kanban_oom_recovery.py b/tests/hermes_cli/test_kanban_oom_recovery.py
index 69d5480b4f..d6090f94ec 100644
--- a/tests/hermes_cli/test_kanban_oom_recovery.py
+++ b/tests/hermes_cli/test_kanban_oom_recovery.py
@@ -35,9 +35,9 @@ def test_oom_run_doubles_cap_and_caps_at_12gib(kanban_home, monkeypatch):
     monkeypatch.setattr(scope, "mem_available_bytes", lambda: 40 * GiB)
     with kbc.connect() as conn:
         tid = kb.create_task(conn, title="x", assignee="a")
-        assert scope.apply_oom_recovery(ARGV, tid) == ARGV          # no OOM yet
+        assert f"MemoryMax={8 * GiB}" in scope.apply_oom_recovery(ARGV, tid)   # first run: 2x base, no OOM needed
         _run(conn, tid, "oom_killed")
-    assert f"MemoryMax={8 * GiB}" in scope.apply_oom_recovery(ARGV, tid)
+    assert f"MemoryMax={12 * GiB}" in scope.apply_oom_recovery(ARGV, tid)
     with kbc.connect() as conn:
         _run(conn, tid, "oom_killed")
         _run(conn, tid, "oom_killed")
@@ -84,3 +84,14 @@ def test_detector_opens_one_card_then_comments(kanban_home):
     with kbc.connect() as conn:
         assert len(kb.list_comments(conn, alert)) == 1
         assert conn.execute("SELECT COUNT(*) FROM tasks WHERE idempotency_key='worker-oom-rate-alert'").fetchone()[0] == 1
+
+
+def test_first_run_base_uplift_is_admission_bounded(kanban_home, monkeypatch):
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="x", assignee="a")
+    monkeypatch.setattr(scope, "mem_available_bytes", lambda: 40 * GiB)
+    assert f"MemoryMax={8 * GiB}" in scope.apply_oom_recovery(ARGV, tid)
+    monkeypatch.setattr(scope, "mem_available_bytes", lambda: 7 * GiB)   # 7-4 reserve < base: stay 4 GiB
+    assert scope.apply_oom_recovery(ARGV, tid) == ARGV
+    monkeypatch.setattr(scope, "mem_available_bytes", lambda: None)
+    assert scope.apply_oom_recovery(ARGV, tid) == ARGV
-- 
2.55.0

