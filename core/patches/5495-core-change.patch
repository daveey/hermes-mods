From 09da5dd3fdca8b733e55d84be95125953892a78a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 10:55:28 +0000
Subject: [PATCH] [daveey] Preserve legacy pickup exclusion proof under
 unclaimable-label admission

---
 tests/hermes_cli/test_kanban_unclaimable_runs_on.py | 3 +++
 tests/hermes_cli/test_kanban_worker_node.py         | 7 ++++++-
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_unclaimable_runs_on.py b/tests/hermes_cli/test_kanban_unclaimable_runs_on.py
index 5543ede899..9054e874c3 100644
--- a/tests/hermes_cli/test_kanban_unclaimable_runs_on.py
+++ b/tests/hermes_cli/test_kanban_unclaimable_runs_on.py
@@ -63,6 +63,9 @@ def test_label_only_pinned_only_machines_carry_is_impossible():
     assert roc.impossible(["macos"], MACHINES, HUB)
     assert kc.refusals(["macos"], MACHINES, HUB) == {"macbook": "pinned_only"}
     assert kc.claimants(["macos"], MACHINES, HUB) == []
+    two_macs = {**MACHINES, "mini": {**MACHINES["macbook"], "pickup": None}}
+    assert roc.impossible(["macos"], two_macs, HUB)
+    assert kc.refusals(["macos"], two_macs, HUB) == {"macbook": "pinned_only", "mini": "pinned_only"}
 
 
 def test_the_machines_own_cards_and_carried_labels_stay_claimable():
diff --git a/tests/hermes_cli/test_kanban_worker_node.py b/tests/hermes_cli/test_kanban_worker_node.py
index 01e68a7941..1ebcb9b5f5 100644
--- a/tests/hermes_cli/test_kanban_worker_node.py
+++ b/tests/hermes_cli/test_kanban_worker_node.py
@@ -305,7 +305,12 @@ def test_worker_runs_a_hub_card_and_the_hub_never_requeues_or_counts_it(gws, svc
 def test_default_placement_cards_and_pinned_cards_follow_the_rules(gws, svc):
     hub, worker = gws
     wt = _hub_card(hub, title="worktree", workspace_kind="worktree", workspace_path="/tmp/x")
-    mac = _hub_card(hub, title="mac", runs_on=["macos"])
+    # Label-only cards carried solely by foreign pinned-only machines are now
+    # refused at creation; retain the pickup exclusion proof with a legacy row.
+    mac = _hub_card(hub, title="mac", runs_on=["linux"])
+    hub.conn.execute("UPDATE tasks SET runs_on = ? WHERE id = ?", (json.dumps(["macos"]), mac))
+    hub.conn.commit()
+    hub.round()
     pinned_hub = _hub_card(hub, title="hub only", runs_on=["machine:hub"])
     worker.round()
     worker.tick()
-- 
2.43.0

