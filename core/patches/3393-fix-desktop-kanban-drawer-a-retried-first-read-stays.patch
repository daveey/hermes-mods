+    refetchOnMount: 'always'
   })
 
   const task = detail?.task
@@ -877,9 +880,10 @@ export function TaskDrawer({
 
   const { data: log } = useQuery({
     enabled: query => !!id && (!!owner || routedToScope(query)),
