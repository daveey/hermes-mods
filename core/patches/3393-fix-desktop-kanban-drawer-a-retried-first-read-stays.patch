+++ b/apps/desktop/src/plugins/kanban/api.ts
@@ -862,21 +862,20 @@ export async function fetchBoard(archived: boolean): Promise<KanbanBoard> {
   return rememberOwners(board, slug)
 }
 
-/** [daveey] One opening of a task detail view. Its first read of each kind (`kind` names the query) is the user's
- *  and goes out as priority 'foreground', so a slow link's poll thinner never skips it, even when the same task is
- *  re-opened within the thinning gap. Every later read of that kind (interval or socket refetch) is a background
- *  poll again and may be thinned (electron/slow-link.ts). */
-export function userOpenReads(): (kind: string) => PluginRestOptions {
-  const read = new Set<string>()
-
-  return kind => {
-    if (read.has(kind)) {
-      return {}
-    }
+/** [daveey] One opening of a task detail view. Its reads of each kind (`kind` names the query) go out as priority
+ *  'foreground' until one has answered, so a slow link's poll thinner never skips the user's read: not on a re-open
+ *  within the thinning gap, and not on React Query's retry of a failed first read (a kind counts as delivered only
+ *  after a successful read). Every later read of that kind (interval or socket refetch) is a background poll again
+ *  and may be thinned (electron/slow-link.ts). */
+export function userOpenReads(): <T>(kind: string, read: (options: PluginRestOptions) => Promise<T>) => Promise<T> {
+  const delivered = new Set<string>()
+
+  return async (kind, read) => {
+    const result = await read(delivered.has(kind) ? {} : { priority: 'foreground' })
 
-    read.add(kind)
+    delivered.add(kind)
 
-    return { priority: 'foreground' }
+    return result
   }
 }
 
diff --git a/apps/desktop/src/plugins/kanban/drawer.test.tsx b/apps/desktop/src/plugins/kanban/drawer.test.tsx
index a0f3808aa8..d52db0a56a 100644
--- a/apps/desktop/src/plugins/kanban/drawer.test.tsx
+++ b/apps/desktop/src/plugins/kanban/drawer.test.tsx
@@ -32,8 +32,14 @@ let detail: object
 let client: QueryClient
 let disposeApi: () => void
 let disposeLocales: () => void
+// A GET path whose next read fails once (a dropped first read that React Query then retries).
+let failOnce = new Set<string>()
 
 const rest = vi.fn(async (path: string, options?: PluginRestOptions): Promise<unknown> => {
+  if (!options?.method && failOnce.delete(path)) {
+    throw new Error(`dropped read: ${path}`)
+  }
+
   if (path === '/tasks/t_example/attachments' && options?.method === 'POST') {
     detail = { ...legacyDetail, attachments: [{ id: 1, filename: options.upload?.filename }] }
 
@@ -74,6 +80,7 @@ beforeEach(() => {
 })
 
 afterEach(() => {
+  failOnce = new Set()
   setApiRequestConnection(null)
   setApiRequestProfile(null)
   clearNotifications()
@@ -295,6 +302,40 @@ describe('task modal dialog', () => {
     await waitFor(() => expect(logReads()).toEqual(['foreground', undefined, 'foreground']))
   })
 
+  it('keeps a retried first read foreground: a read counts as delivered only once it answered', async () => {
+    detail = { ...legacyDetail, attachments: [] }
+    // The shared client retries a failed query (React Query's default retry: 3).
+    client = new QueryClient({ defaultOptions: { queries: { retry: 1, retryDelay: 0 } } })
+    failOnce = new Set(['/tasks/t_example'])
+
+    const taskReads = () =>
+      rest.mock.calls
+        .filter(([path, options]) => path === '/tasks/t_example' && !options?.method)
+        .map(([, options]) => options?.priority)
+
+    openDrawer()
+    await screen.findByText('Keep this description readable.')
+    expect(taskReads()).toEqual(['foreground', 'foreground'])
+  })
+
+  it('sends a foreground read when a task is re-opened while its cache is still fresh', async () => {
+    detail = { ...legacyDetail, attachments: [] }
+    // The shared client's staleTime (60 s): without a mount refetch a warm re-open sends nothing, and its first
+    // request is the interval refetch 15-30 s later.
+    client = new QueryClient({ defaultOptions: { queries: { retry: false, staleTime: 60_000 } } })
+
+    const taskReads = () =>
+      rest.mock.calls
+        .filter(([path, options]) => path === '/tasks/t_example' && !options?.method)
+        .map(([, options]) => options?.priority)
+
+    const first = openDrawer()
+    await waitFor(() => expect(taskReads()).toEqual(['foreground']))
+    first.unmount()
+    openDrawer()
+    await waitFor(() => expect(taskReads()).toEqual(['foreground', 'foreground']))
+  })
+
   it('is a modal dialog named by the task title that Esc dismisses', async () => {
     detail = { ...legacyDetail, attachments: [] }
     const onClose = vi.fn()
