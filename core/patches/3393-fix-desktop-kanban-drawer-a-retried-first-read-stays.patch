+    queryFn: () => openRead(`log:${id}`, read => fetchLog(id!, owner, read)),
     queryKey: logKey(scope, slug, id ?? '', owner),
-    refetchInterval: running ? 3_000 : 15_000
+    refetchInterval: running ? 3_000 : 15_000,
+    refetchOnMount: 'always'
   })
 
