From b816cb465b17c9d17435a731aa54ec8a52834bff Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 13:54:30 +0000
Subject: [PATCH] [daveey] Gate the posix -ic $ENV startup premise on Bash 4+

Problem: at main 7eef74e62dc2 two cases of test_startup_script_marker_and_clean_twin,
`ENV=start.sh bash --posix -ic true` and `env 'ENV'=start.sh bash --posix -ic true`, fail on
macOS /bin/bash 3.2.57 (`assert marker.exists()`, stderr "bash: no job control in this shell").
Linux CI (Bash 5) passes.

Why: Bash 3.2 does not run the $ENV file for `bash --posix -ic CMD`. Measured on macOS
/bin/bash 3.2.57: no marker for `--posix -ic`, `-o posix -ic` or POSIXLY_CORRECT with `-ic`,
with a bare, ./ or absolute ENV path; a marker for `sh -ic CMD` and `bash --posix -i script`.
The real-shell premise assumed Bash 5. The scanner returns (True, None) for both shapes and
(False, None) for the clean twin on both hosts, so the guard fails closed either way and must
keep flagging the shape, because a host may run either Bash.
Not caught: required core CI runs Linux Bash 5 only; the macOS Bash 3.2 lane
(t_5e88b2513095504c, PRs #3445/#3446) is not live yet.

Change: for `--posix -ic` shapes the premise follows the inner Bash's major version. On
Bash 4+ the startup file must run, as before. On Bash 3 it must not, so a Bash that starts
running it fails the test and the exception gets removed instead of going stale. The scanner
assertions run unchanged on every host.

Proof:
- macOS /bin/bash 3.2.57 on c0552f3ecd56: unpatched 2 failed, 23 passed, 10 skipped;
  patched 25 passed, 10 skipped.
- Linux hermes-worker-1 (Bash 5.2.21(1)-release): patched: 35 passed in 2.12s;
  mutant `return False` (exception on every Bash): 2 failed, 33 passed in 2.22s.
---
 .../cron/test_lifecycle_guard_startup_env.py  | 22 +++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/tests/cron/test_lifecycle_guard_startup_env.py b/tests/cron/test_lifecycle_guard_startup_env.py
index ba9583e8f2c5b1d89254f8879f76a63951cd9786..a378a68f93421a9214a23fb1584a0e740b73a760 100644
--- a/tests/cron/test_lifecycle_guard_startup_env.py
+++ b/tests/cron/test_lifecycle_guard_startup_env.py
@@ -35,6 +35,21 @@ def run_bash(tmp_path, command):
     )
 
 
+def bash_reads_env_for(tmp_path, command):
+    """Whether this host's Bash runs the $ENV file for ``command``.
+
+    macOS /bin/bash 3.2.57 skips $ENV for ``bash --posix -ic CMD`` (also with ``-o posix`` or
+    POSIXLY_CORRECT, relative or absolute path) but runs it for ``sh -ic CMD`` and
+    ``bash --posix -i script``. Bash 5 (CI) runs it for all of them. Only the real-shell
+    premise depends on the host: the scanner must flag the shape everywhere, because a
+    gateway may run either Bash.
+    """
+    if " --posix -ic " not in f" {command} ":
+        return True
+    major = run_bash(tmp_path, "bash -c 'echo \"${BASH_VERSINFO[0]}\"'").stdout.strip()
+    return int(major) >= 4
+
+
 @pytest.mark.platforms("posix")
 @pytest.mark.parametrize("command", SHAPES)
 def test_startup_script_marker_and_clean_twin(tmp_path, command):
@@ -44,8 +59,11 @@ def test_startup_script_marker_and_clean_twin(tmp_path, command):
     startup.write_text("touch ran\n")
     result = run_bash(tmp_path, command)
     assert result.returncode == 0, result.stderr
-    assert marker.exists(), result.stderr
-    marker.unlink()
+    if bash_reads_env_for(tmp_path, command):
+        assert marker.exists(), result.stderr
+        marker.unlink()
+    else:
+        assert not marker.exists(), "this Bash now runs $ENV here: drop the exception"
     startup.write_text("hermes gateway restart\n")
     assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (True, None)
     startup.write_text("touch ran\n")
-- 
2.43.0

