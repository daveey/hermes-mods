From 960a4ea3247478ff553cf0e581b36caf916b5fd0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 02:19:41 +0000
Subject: [PATCH] [daveey] Keep pending heredoc multiline groups unmasked

Proof: real Bash marker regression is RED before the fix and GREEN after; 24 delimiter/group/comment combinations retain executed hash-line payloads. All 34 condition/integration mutants killed; 33 importing suites pass 3195 tests; scripts/check passes 20 checks. Frozen read-only replay of 7099 commands from 22 hub DBs: zero boolean changes, seven existing diagnostic-only differences; 12 unmemoized controls agree.
---
 .../test_lifecycle_guard_comment_corpus.py    | 33 +++++++++++++++++++
 tools/shell_comments.py                       |  4 +++
 2 files changed, 37 insertions(+)

diff --git a/tests/cron/test_lifecycle_guard_comment_corpus.py b/tests/cron/test_lifecycle_guard_comment_corpus.py
index 98717de797..d107be83bf 100644
--- a/tests/cron/test_lifecycle_guard_comment_corpus.py
+++ b/tests/cron/test_lifecycle_guard_comment_corpus.py
@@ -35,3 +35,36 @@ def test_comment_mask_preserves_generated_executed_payloads(tmp_path):
         marker.unlink()
         unsafe, _refusal = scan_gateway_lifecycle(command, cwd=str(tmp_path))
         assert unsafe, command
+
+
+@pytest.mark.spawns_gateway_lookalike
+def test_pending_heredoc_multiline_groups_preserve_executed_hash(tmp_path):
+    """A newline inside a group starts pending heredocs, unlike quoted newlines."""
+    from tools.shell_comments import mask_root_comment_lines
+    from tools.shell_heredoc import output_reaches_shell
+
+    executable = tmp_path / 'hermes'
+    executable.write_text('#!/bin/sh\nprintf reached > seen\n', encoding='utf-8')
+    executable.chmod(0o700)
+    marker = tmp_path / 'seen'
+    groups = [('( :', ')'), ('{ :', '}'), ('[[ -n x', ']]'), ('f() ( :', ')')]
+    delimiters = ["<<'E'", '<<"E"', "<<-'E'"]
+    prefixes = ['', '# inert; `auth`\n']
+    for (opening, closing), delimiter, prefix in itertools.product(groups, delimiters, prefixes):
+        command = (
+            prefix + "emit() { printf '%s %s %s' hermes '\"gateway\"' restart; }\n"
+            + f'cat {delimiter}; {opening}\nE\n{closing}\n:\n: "\nE\n'
+            + '# $(emit | bash)\n" #"'
+        )
+        result = subprocess.run(
+            ['bash', '-c', command], cwd=tmp_path,
+            env={'PATH': f'{tmp_path}:/usr/bin:/bin'},
+            capture_output=True, check=False, text=True, encoding='utf-8', timeout=5,
+        )
+        assert result.returncode == 0, (command, result.stderr)
+        assert marker.read_text() == 'reached', command
+        marker.unlink()
+        assert output_reaches_shell(command), command
+        unsafe, refusal = scan_gateway_lifecycle(command, cwd=str(tmp_path))
+        assert unsafe, (command, refusal)
+        assert mask_root_comment_lines(command) == command, command
diff --git a/tools/shell_comments.py b/tools/shell_comments.py
index 82f35a3fbc..0c55f8daae 100644
--- a/tools/shell_comments.py
+++ b/tools/shell_comments.py
@@ -112,6 +112,10 @@ def mask_root_comment_lines(command: str) -> str:
             end = _opaque_end(command, pos, opening.group())
             if end is None:
                 return command
+            # A pending heredoc can start at a newline inside a compound group.
+            # Opaque balancing cannot identify that grammar boundary reliably.
+            if heredocs and "\n" in command[pos:end]:
+                return command
             pos = end
             boundary = False
         else:
