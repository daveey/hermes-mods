From 0d3f82dab0c0128c9d05797c624caf865f7fa3e2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 22:18:45 +0000
Subject: [PATCH] gateway: chat completions reply names the served provider and
 model (BB egress log)

---
 gateway/platforms/api_server.py               | 10 ++--------
 gateway/platforms/api_server_openai_routes.py | 18 +++++++++++-------
 2 files changed, 13 insertions(+), 15 deletions(-)

diff --git a/gateway/platforms/api_server.py b/gateway/platforms/api_server.py
index aafe4539f40..c1e42976ac8 100644
--- a/gateway/platforms/api_server.py
+++ b/gateway/platforms/api_server.py
@@ -3605,8 +3605,7 @@ class APIServerAdapter(OpenAICompatRoutesMixin, BasePlatformAdapter):
         usage = {"input_tokens": getattr(agent, "session_prompt_tokens", 0) or 0,
                  "output_tokens": getattr(agent, "session_completion_tokens", 0) or 0,
                  "total_tokens": getattr(agent, "session_total_tokens", 0) or 0}
-        # Effective session id lets callers track compression-triggered rotations.
-        # (#16938)
+        # Effective session id lets callers track compression-triggered rotations (#16938).
         _eff_sid = getattr(agent, "session_id", session_id)
         if isinstance(_eff_sid, str) and _eff_sid:
             result["session_id"] = _eff_sid
@@ -3615,12 +3614,7 @@ class APIServerAdapter(OpenAICompatRoutesMixin, BasePlatformAdapter):
         _session_rotated = isinstance(_eff_sid, str) and isinstance(session_id, str) and _eff_sid != session_id
         if getattr(agent, "_last_compaction_in_place", False) or _session_rotated:
             result["_compressed"] = True
-        # Always record who actually served the turn (a class selector names no provider or model).
-        if isinstance(result, dict):
-            _p, _m = getattr(agent, "provider", ""), getattr(agent, "model", "")
-            result["served_runtime"] = {
-                "provider": self._clean_runtime_id(_p, max_len=80) if isinstance(_p, str) else "",
-                "model": self._clean_runtime_id(_m) if isinstance(_m, str) else ""}
+        result["served_runtime"] = {k: self._clean_runtime_id(getattr(agent, k, ""), max_len=80) for k in ("provider", "model")}  # who served; a class selector names neither
         if requested_runtime or route or confirmed_runtime_lock or (route_source and route_source != "global"):
             runtime = self._turn_runtime_metadata(
                 agent, route=route, requested_runtime=requested_runtime,
diff --git a/gateway/platforms/api_server_openai_routes.py b/gateway/platforms/api_server_openai_routes.py
index aed174759be..50407d15ca7 100644
--- a/gateway/platforms/api_server_openai_routes.py
+++ b/gateway/platforms/api_server_openai_routes.py
@@ -777,6 +777,16 @@ def _parse_conversation_history(raw_history: Any) -> tuple:
     return conversation_history, None
 
 
+def _apply_served_runtime(response_data: dict, result: dict) -> None:
+    """Name who served the turn: a class selector ("class:fast") is not a model, and clients (BB's
+    egress log) attribute the request from this. ``model`` keeps echoing the request when unknown."""
+    served = result.get("served_runtime") if isinstance(result.get("served_runtime"), dict) else {}
+    if served.get("provider"):
+        response_data["provider"] = served["provider"]
+    if served.get("model"):
+        response_data["model"] = served["model"]
+
+
 class OpenAICompatRoutesMixin:
     """/v1/chat/completions and /v1/responses handlers + SSE writers."""
 
@@ -1060,13 +1070,7 @@ class OpenAICompatRoutesMixin:
             "choices": [{"index": 0, "message": {"role": "assistant", "content": "" if presentation_muted else final_response},
                          "finish_reason": finish_reason}],
             "usage": _chat_usage_payload(usage)}
-        # A class selector ("class:fast") is not a model: report who served it, so clients (BB's egress log)
-        # attribute the request. ``model`` keeps echoing the request when the runtime is unknown.
-        served = result.get("served_runtime") if isinstance(result.get("served_runtime"), dict) else {}
-        if served.get("provider"):
-            response_data["provider"] = served["provider"]
-        if served.get("model"):
-            response_data["model"] = served["model"]
+        _apply_served_runtime(response_data, result)
         # Non-streaming twin of ``delta.reasoning_content`` (#99552).
         reasoning_text = _turn_reasoning_text(history, user_message, result)
         if reasoning_text and not presentation_muted:
-- 
2.55.0

