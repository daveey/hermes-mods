                "creator_task_id": None, "key_family": None,
                "chats": sorted({str(s["session"]) for s in sessions if s.get("session")})}
@@ -244,7 +367,7 @@ def find(*, title: str, body: str, target_board: str, session_id: Optional[str],
         skip = set(parents) | ({self_tid} if self_tid else set())
         waiting = capability_owner_waiting_id(title, body)
         new_words = words(title)
-        out = []
+        out, seen = [], set()
         cards = [*_local_cards(self_gw), *_replica_cards(self_gw)]
         gateways = {g for g in (self_gw, *(c["gateway"] for c in cards)) if g}
         if gateways & {"hub", "hermes-hub"}:
@@ -254,8 +377,13 @@ def find(*, title: str, body: str, target_board: str, session_id: Optional[str],
                     or (waiting and _sibling_owner(card.get("title") or "", waiting))
                     or (session_id and card["session_id"] == session_id)
                     or (self_tid and card["creator_task_id"] == self_tid)
-                    or (family and card.get("key_family") == family)):
+                    or (family and card.get("key_family") == family)
+                    or (card["gateway"], card["id"]) in seen
+                    or waits_on(card["id"], title, body)
+                    or distinct_target(title, card.get("title") or "", gateways,
+                                       new_body=body, card_body=card.get("body") or "")):
                 continue
+            seen.add((card["gateway"], card["id"]))
             reasons, score = _reasons(card, new_words, title, body, target_board, gateways)
             if reasons:
                 out.append({**{k: card[k] for k in ("id", "board", "gateway", "status", "title", "chats")},
diff --git a/tests/tools/test_kanban_create_overlap_url_slug.py b/tests/tools/test_kanban_create_overlap_url_slug.py
index 3e8a366dde3..8c49e5c8c15 100644
--- a/tests/tools/test_kanban_create_overlap_url_slug.py
+++ b/tests/tools/test_kanban_create_overlap_url_slug.py
@@ -216,3 +216,333 @@ def test_a_refusal_matching_only_remote_cards_logs_which_cards(macbook_hermes, c
     assert out.get("code") == "create_overlap", out
     line = next(r.getMessage() for r in caplog.records if "create overlap: refused" in r.getMessage())
     assert f"macbook/hermes/{TIMEOUTS[0]} (titles share" in line, line
+
+
+# --- Target identity: overlap audit t_01a189c70884fa59 (MacBook + mini, 10-29 16:28 to 10-30 16:30 PDT) and
+# the hub leg of t_01a189b2d186a986. Titles, ids and bodies are the real ones from the audit evidence
+# (~/.hermes/kanban/evidence/overlap-audit-t_01a189c70884fa59 on hermes-hub); every logged refusal read
+# "titles share N words (...)" while the two cards named a different machine, process, ticket or repo.
+
+def _stale_body(host: str, home: str, pid: str) -> str:
+    # hermes-sync mods_stale_gateways card body (macbook t_01a18c71f9f14e95, mini t_01a18c6600fac4b6).
+    return (f"hermes-sync on {host} detected a possibly stale gateway: home={home}, pid={pid}, "
+            "started_at=1793354546.0. Enabled public plugin commits newer than this process: [...]. Disk changes "
+            "do not reload imported modules.\n\nRecheck this exact process lifetime and enabled plugin paths first; "
+            "close as superseded if it restarted.")
+
+
+_MBP = ("David-MBP", "/Users/me/.hermes")
+_MINI = ("daveey-mini", "/Users/me/.bb-hermes")
+# (creating gateway, refused pid, named gateway, named card id, named pid, refusals in the window)
+STALE_PAIRS = [
+    ("macbook", "78233", "mini", "t_01a18c6600fac4b6", "16839", 1),
+    ("macbook", "80333", "mini", "t_01a18d648a285b10", "8782", 1),
+    ("mini", "1722", "macbook", "t_01a18c71f9f14e95", "78233", 2),
+    ("mini", "45464", "macbook", "t_01a18c9822bfac2b", "81967", 7),
+    ("mini", "38406", "macbook", "t_01a18d71a1e0761a", "80333", 1),
+    ("mini", "65326", "macbook", "t_01a18d8df5c3d471", "58702", 1),
+    ("mini", "52330", "macbook", "t_01a18e14e1d3a943", "12906", 2),
+    ("mini", "82697", "macbook", "t_01a18e598b369a6c", "47337", 5),
+]
+
+
+def _stale(gw: str, pid: str) -> tuple[str, str]:
+    host, home = _MBP if gw == "macbook" else _MINI
+    return f"{host}: gateway {pid} may run stale hermes-mods plugins", _stale_body(host, home, pid)
+
+
+def _as(monkeypatch, gw):
+    from hermes_cli import kanban_capability_registry as reg
+    monkeypatch.setattr(reg, "self_gateway", lambda: gw)
+
+
+def _remote(gw, tid, title, status="ready", board="default", body=""):
+    return (gw, f"default/{board}/{tid}",
+            {"id": tid, "board": board, "title": title, "status": status, "gateway": gw, "body": body})
+
+
+def _local(board, tid, title, status="ready", body=""):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_boards as kbb
+    from hermes_cli import kanban_db_connect as kbc
+    if board != "default" and not kb.board_exists(board):
+        kbb.create_board(board)
+    conn = kbc.connect(board=board)
+    try:
+        made = kb.create_task(conn, title=title, assignee="default", session_id="other-chat")
+        conn.execute("UPDATE tasks SET id = ?, status = ?, body = ? WHERE id = ?", (tid, status, body, made))
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def _ids(out):
+    return [m["id"] for m in out.get("matches") or []]
+
+
+@pytest.mark.parametrize(("gw", "pid", "other_gw", "other_id", "other_pid", "count"), STALE_PAIRS,
+                         ids=[f"{p[0]}-{p[1]}->{p[3]}" for p in STALE_PAIRS])
+def test_stale_gateway_card_for_another_host_is_not_a_duplicate(home, tmp_path, monkeypatch, gw, pid, other_gw,
+                                                                 other_id, other_pid, count):
+    _as(monkeypatch, gw)
+    _replica(tmp_path, [_remote(other_gw, other_id, _stale(other_gw, other_pid)[0],
+                                body=_stale(other_gw, other_pid)[1])])
+    out = _create(*_stale(gw, pid))
+    assert out.get("ok") is True, out
+
+
+@pytest.mark.parametrize(("gw", "pid", "other_gw"), [(p[0], p[1], p[2]) for p in STALE_PAIRS[:3]])
+def test_stale_gateway_card_for_the_same_process_is_still_refused_even_when_remote(home, tmp_path, monkeypatch,
+                                                                                    gw, pid, other_gw):
+    """Same host + same pid = same process lifetime. The open card lives on the other gateway: a remote owner
+    of the same target is still an owner, so gateway alone exempts nothing."""
+    _as(monkeypatch, other_gw)
+    _replica(tmp_path, [_remote(gw, "t_01a1aaaaaaaaaaaa", _stale(gw, pid)[0], body=_stale(gw, pid)[1])])
+    out = _create(*_stale(gw, pid))
+    assert out.get("code") == "create_overlap", out
+    assert _ids(out) == ["t_01a1aaaaaaaaaaaa"]
+
+
+PROBE_MBP = ("t_01a18bf8331bbc3e",
+             "Probe: report hermes-mods HEAD + user-steps asks DB journal_mode on the MacBook (for t_01a18bee20c483ea)",
+             "Read-only probe for hub card t_01a18bee20c483ea (live check of hermes-mods f4dcf7a, user-steps WAL fix). "
+             "Run on THIS machine and change nothing:")
+PROBE_MINI_TITLE = ("Probe: report hermes-mods HEAD + user-steps asks DB journal_mode on the mini "
+                    "(for hub t_01a18bee20c483ea)")
+
+
+def test_probe_leg_for_another_host_is_admitted(home, tmp_path, monkeypatch):
+    _as(monkeypatch, "mini")
+    _replica(tmp_path, [_remote("macbook", *PROBE_MBP[:2], body=PROBE_MBP[2])])
+    out = _create(PROBE_MINI_TITLE, PROBE_MBP[2])
+    assert out.get("ok") is True, out
+
+
+def test_probe_leg_repeated_for_the_same_host_is_refused(home, tmp_path, monkeypatch):
+    _as(monkeypatch, "mini")
+    _replica(tmp_path, [_remote("macbook", *PROBE_MBP[:2], body=PROBE_MBP[2])])
+    out = _create(PROBE_MBP[1].replace("(for t_", "(for hub t_"), PROBE_MBP[2])
+    assert out.get("code") == "create_overlap", out
+    assert _ids(out) == [PROBE_MBP[0]]
+
+
+METTA3_DISK = ("t_01a18aa41b48edfd", "BB-1197, BB-1202, BB-1205: Fleet: metta3 still critically low on disk",
+               "# BB-1197, BB-1202, BB-1205: Fleet: metta3 still critically low on disk\n\nFiled by bb_bridge (mini).")
+MINI_DISK = "BB-1155: Fleet: mini still critically low on disk after cleanup"
