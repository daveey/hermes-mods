From 1821a05a8cd74573579fc19b2a9b4fcc608af0cb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 19:35:37 +0000
Subject: [PATCH] fix(routing): managed SDK auth check reads openai 2.54's
 auth_headers [daveey]

Upstream bumped openai 2.24 -> 2.54, which sends the API key from auth_headers at request time
and no longer folds Authorization into default_headers. The fork's fail-closed managed guard read
only default_headers, so every managed openai-codex / xai-oauth request was refused ('authorization
header changed'). It now takes a custom Authorization override from default_headers, else the
SDK's auth_headers. test_managed_responses_wire (incl. the header/credential mutation cases) green.
---
 agent/model_routing_auxiliary_guard.py | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/agent/model_routing_auxiliary_guard.py b/agent/model_routing_auxiliary_guard.py
index 8abd9a837ef..aae74b5d6f4 100644
--- a/agent/model_routing_auxiliary_guard.py
+++ b/agent/model_routing_auxiliary_guard.py
@@ -28,7 +28,12 @@ def verify_sdk_request(client, request, runtime):
     elif client.api_key != expected:
         raise ModelRoutingError("Managed auxiliary SDK credential changed")
     headers = {str(k).lower(): v for k, v in client.default_headers.items()}
-    if headers.get("authorization") != "Bearer " + expected:
+    # openai>=2.5x sends the key from ``auth_headers`` at request time instead of folding it into
+    # ``default_headers``; a custom Authorization header still lands in (and wins from) the latter.
+    auth = headers.get("authorization")
+    if auth is None:
+        auth = {str(k).lower(): v for k, v in (getattr(client, "auth_headers", None) or {}).items()}.get("authorization")
+    if auth != "Bearer " + expected:
         raise ModelRoutingError("Managed auxiliary SDK authorization header changed")
     if any(headers.get(k) for k in ("x-api-key", "api-key", "host")):
         raise ModelRoutingError("Managed auxiliary SDK has conflicting authentication headers")
-- 
2.55.0

