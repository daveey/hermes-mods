From d74e8fad3b0d9b1aa58a8ec426dc6488a9b22567 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 11:08:54 +0000
Subject: [PATCH] test(kanban-sync): distinguish defensive recovery guard
 predicates [daveey]

---
 .../test_kanban_sync_dependency_delete.py     | 36 +++++++++++++++++--
 1 file changed, 34 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_sync_dependency_delete.py b/tests/hermes_cli/test_kanban_sync_dependency_delete.py
index 958e0691c7..8d3018e289 100644
--- a/tests/hermes_cli/test_kanban_sync_dependency_delete.py
+++ b/tests/hermes_cli/test_kanban_sync_dependency_delete.py
@@ -516,10 +516,17 @@ def test_plan_alone_detects_local_change_during_proof(case, monkeypatch):
     assert recovery.plan(live, hub, BOARD, uid, "retain link").get("reason") == "local_inputs_changed"
 
 
-def test_apply_requires_string_token(case):
+@pytest.mark.parametrize("compatible", [False, True])
+def test_apply_requires_string_token(case, compatible):
     from hermes_cli import kanban_sync_dependency_delete as recovery
     live, hub, _, uid, *_ = case
-    assert recovery.apply(live, hub, BOARD, uid, None, "retain link").get("reason") == "preview_token_changed"
+
+    class EqualToAnyString:
+        def __eq__(self, other):
+            return isinstance(other, str)
+
+    token = EqualToAnyString() if compatible else None
+    assert recovery.apply(live, hub, BOARD, uid, token, "retain link").get("reason") == "preview_token_changed"
 
 
 @pytest.mark.parametrize("defect,reason", [
@@ -667,3 +674,28 @@ def test_empty_feed_conjuncts(feed):
             return feed
     with pytest.raises(recovery.Refused, match="^authoritative_feed_changed$"):
         recovery._empty(Hub(), BOARD, 1)
+
+
+def test_evidence_requires_actual_dict_not_compatible_object():
+    from collections import UserDict
+    from hermes_cli import kanban_sync_dependency_delete as recovery
+
+    class Hub:
+        def row_evidence(self, board, table, uid):
+            return UserDict(board=board, table=table, uid=uid, head=1, state="live",
+                            tombstone=None, row={"uid": uid, "version": 1, "deleted_at": None})
+
+    with pytest.raises(recovery.Refused, match="^authoritative_identity_changed$"):
+        recovery._evidence(Hub(), BOARD, "task_links", "a>b", 1)
+
+
+def test_each_delete_requires_a_retained_audit_even_with_same_second(case):
+    from hermes_cli import kanban_sync_dependency_delete as recovery
+    live, _hub, _, uid, *_ = case
+    snap = recovery._snapshot(live, uid)
+    second = snap["events"][0]["created_at"]
+    for op in snap["ops"]:
+        op["created_at"] = second * 1000
+    snap["events"] = snap["events"][:1]
+    with pytest.raises(recovery.Refused, match="^missing_unlink_audit$"):
+        recovery._local(snap, uid)
