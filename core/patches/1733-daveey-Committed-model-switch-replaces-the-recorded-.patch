diff --git a/tests/agent/test_route_switch_intent.py b/tests/agent/test_route_switch_intent.py
new file mode 100644
index 00000000000..2c571146707
--- /dev/null
+++ b/tests/agent/test_route_switch_intent.py
@@ -0,0 +1,107 @@
+"""A committed explicit model switch replaces the recorded allocation at the next build, once. [daveey]
+
+Incident: the canonical ``model`` mutation moved ``sessions.model`` to claude-opus while the allocation
+store (and ``model_config.model_routing``) still held an exact pin on gpt-astra, so the next build either
+refused ("Exact pinned route cannot fail over") or a reader restored the OLD pin.
+"""
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from agent.model_routing import ModelRoutingError
+from agent.model_routing_state import RoutingState
+from agent.model_routing_switch_intent import PREFIX, record_in_transaction
+from hermes_state import SessionDB
+from run_agent import AIAgent
+from tests.agent import test_managed_switch as switch_fixtures
+
+managed = switch_fixtures.managed
+routing_home = switch_fixtures.routing_home
+streaming_route = switch_fixtures.streaming_route
+destinations = switch_fixtures.destinations
+
+
+def _build(model, session='pin', session_db=None):
+    return AIAgent(model=model, provider='auto', session_id=session, session_db=session_db,
+                   quiet_mode=True, skip_memory=True, skip_context_files=True)
+
+
+@pytest.fixture
+def seams():
+    with patch('model_tools.get_tool_definitions', return_value=[]), \
+         patch('agent.anthropic_adapter.build_anthropic_client', return_value=MagicMock()):
+        yield
+
+
+def _commit_intent(path, session, model, provider='anthropic'):
+    db = SessionDB(path)
+    db._execute_write(lambda conn: record_in_transaction(conn, session, model, provider, 2))
+    db.close()
+
+
+def test_committed_switch_survives_restart_and_replaces_the_exact_pin(destinations, tmp_path, seams):
+    _build('anthropic-deep')
+    state = RoutingState(tmp_path / 'model-routing.sqlite3')
+    assert state.peek('pin', 'deep')['selected_model'] == 'anthropic-deep'
+    _commit_intent(tmp_path / 'state-under-test.db', 'pin', 'z-anthropic-deep')
+    restarted = SessionDB(tmp_path / 'state-under-test.db')  # a fresh owner process reads the receipt
+    try:
+        agent = _build('z-anthropic-deep', session_db=restarted)
+        assert agent.model == 'z-anthropic-deep'
+        recorded = state.peek('pin', 'deep')
+        assert (recorded['selected_model'], recorded['exact_pin'], recorded['reason']) == (
+            'z-anthropic-deep', True, 'explicit-switch')
+        assert restarted.get_meta(PREFIX + 'pin') is None  # one-shot
+        # The new pin is now itself exact: the old model cannot come back without its own switch.
+        with pytest.raises(ModelRoutingError, match='cannot fail over'):
+            _build('anthropic-deep', session_db=restarted)
+    finally:
+        restarted.close()
+
+
+def test_no_intent_cannot_override_an_exact_pin(destinations, tmp_path, seams):
+    _build('anthropic-deep')
+    state = RoutingState(tmp_path / 'model-routing.sqlite3')
+    before = state.peek('pin', 'deep')
+    db = SessionDB(tmp_path / 'state-under-test.db')
+    try:
+        with pytest.raises(ModelRoutingError, match='cannot fail over'):
+            _build('z-anthropic-deep', session_db=db)
+        assert state.peek('pin', 'deep') == before
+    finally:
+        db.close()
+
+
+@pytest.mark.parametrize('session,model', [('other', 'z-anthropic-deep'), ('pin', 'anthropic-standard')])
+def test_an_intent_for_another_session_or_tuple_does_not_move_the_pin(destinations, tmp_path, seams, session, model):
+    _build('anthropic-deep')
+    state = RoutingState(tmp_path / 'model-routing.sqlite3')
+    before = state.peek('pin', 'deep')
+    _commit_intent(tmp_path / 'state-under-test.db', session, model)
+    db = SessionDB(tmp_path / 'state-under-test.db')
+    try:
+        with pytest.raises(ModelRoutingError, match='cannot fail over'):
+            _build('z-anthropic-deep', session_db=db)
+        assert state.peek('pin', 'deep') == before
+        assert db.get_meta(PREFIX + session) is not None  # never consumed by a non-matching build
+    finally:
+        db.close()
+
+
+def test_failed_allocation_rolls_back_and_keeps_the_intent(destinations, tmp_path, seams):
+    _build('anthropic-deep')
+    state = RoutingState(tmp_path / 'model-routing.sqlite3')
+    before = state.peek('pin', 'deep')
+    _commit_intent(tmp_path / 'state-under-test.db', 'pin', 'z-anthropic-deep')
+    db = SessionDB(tmp_path / 'state-under-test.db')
+    try:
+        with patch('agent.model_routing_runtime.verify_class_runtime',
+                   side_effect=ModelRoutingError('credential refused')):
+            with pytest.raises(ModelRoutingError, match='credential refused'):
+                _build('z-anthropic-deep', session_db=db)
+        assert state.peek('pin', 'deep') == before
+        assert db.get_meta(PREFIX + 'pin') is not None
+        assert _build('z-anthropic-deep', session_db=db).model == 'z-anthropic-deep'
+        assert db.get_meta(PREFIX + 'pin') is None
+    finally:
+        db.close()
diff --git a/tests/gateway/test_model_mutation_route_intent.py b/tests/gateway/test_model_mutation_route_intent.py
new file mode 100644
index 00000000000..dcf3b8ef6b2
--- /dev/null
+++ b/tests/gateway/test_model_mutation_route_intent.py
@@ -0,0 +1,139 @@
+"""The canonical model mutation writes its route-switch intent only when the switch commits. [daveey]
+
+Only a committed receipt may later move an allocation (``agent.model_routing_switch_intent``): a refused
+(optimistic revision conflict) or deferred preparation must leave allocation state and intents alone, and
+preparation's own route lookups must never allocate in the durable store.
+"""
+import asyncio
+import json
+import threading
+
+import pytest
+
+from agent.model_routing_switch_intent import PREFIX
+from tests.gateway.test_session_mutation_model_busy import _mutate, _owner, _running_model
+from tests.waiting import async_wait_until
+
+
+def _intent(db, sid):
+    raw = db.get_meta(PREFIX + sid)
+    return json.loads(raw) if raw else None
+
+
+def _seed_stale_route(db, sid):
+    db.patch_session_model_config(sid, {'model_routing': {
+        'requested_class': 'deep', 'selected_model': 'frozen', 'selected_provider': 'anthropic',
+        'billing_group': 'subscription', 'exact_pin': True}})
+
+
+def _routing(db, sid):
+    config = db.get_session(sid)['model_config']
+    config = json.loads(config) if isinstance(config, str) else (config or {})
+    return config.get('model_routing')
+
+
+async def _noop(event):
+    return 'ok'
+
+
+@pytest.mark.asyncio
+async def test_committed_pick_records_the_intent_and_drops_the_stale_record(tmp_path, monkeypatch):
+    store, db, _authority, owner, ref = _owner(tmp_path, monkeypatch, _noop)
+    try:
+        _seed_stale_route(db, ref.session_id)
+        reply = await _mutate(owner, db, ref, 'pick', 'picked')
+        assert reply['result']['model'] == 'picked', reply
+        row = db.get_session(ref.session_id)
+        assert row['model'] == 'picked'
+        assert _routing(db, ref.session_id) is None  # restore_route no longer resumes the old pin
+        intent = _intent(db, ref.session_id)
+        assert (intent['session_id'], intent['model'], intent['provider']) == (ref.session_id, 'picked', 'custom')
+        assert intent['generation'] == row['runtime_generation']
+    finally:
+        await owner.close()
+        store.close_all_db_handles()
+
+
+@pytest.mark.asyncio
+async def test_optimistic_rejection_changes_no_route_state(tmp_path, monkeypatch):
+    store, db, _authority, owner, ref = _owner(tmp_path, monkeypatch, _noop)
+    try:
+        _seed_stale_route(db, ref.session_id)
+        before = _routing(db, ref.session_id)
+        snap = dict(db.get_session(ref.session_id))
+        snap['runtime_revision'] += 7
+        reply = await _mutate(owner, db, ref, 'stale', 'picked', snap)
+        assert reply['error']['data']['reason'] == 'revision_conflict'
+        assert _intent(db, ref.session_id) is None
+        assert _routing(db, ref.session_id) == before
+        assert db.get_session(ref.session_id)['model'] == 'frozen'
+        assert not (tmp_path / 'model-routing.sqlite3').exists()
+    finally:
+        await owner.close()
+        store.close_all_db_handles()
+
+
+@pytest.mark.asyncio
+async def test_deferred_pick_writes_its_intent_only_at_the_turn_boundary(tmp_path, monkeypatch):
+    from gateway.session_contract import Submission
+    import hermes_state_runtime as rt
+    started, release = threading.Event(), asyncio.Event()
+    state = {}
+
+    async def handle(event):
+        if event.text == 'RUNNING':
+            started.set()
+            await release.wait()
+        return 'ok'
+    store, db, authority, owner, ref = _owner(tmp_path, monkeypatch, handle)
+    state.update(authority=authority, ref=ref)
+    try:
+        _seed_stale_route(db, ref.session_id)
+        before = _routing(db, ref.session_id)
+        first = await authority.submit(owner.actor, Submission('running', ref, {'text': 'RUNNING'}, 'queue'))
+        await async_wait_until(started.is_set, timeout=10, what='the first turn is running')
+        reply = await _mutate(owner, db, ref, 'pick', 'picked')
+        assert reply['result']['status'] == 'deferred', reply
+        assert _intent(db, ref.session_id) is None
+        assert _routing(db, ref.session_id) == before
+        release.set()
+        await async_wait_until(
+            lambda: rt.get_session_admission(db, admission_id=first.admission_id)['status'] == 'terminal',
+            timeout=10, what='the running turn settled')
+        await async_wait_until(lambda: _running_model(authority, ref) == 'picked',
+                               timeout=10, what='the pick published at the turn boundary')
+        assert _intent(db, ref.session_id)['model'] == 'picked'
+        assert _routing(db, ref.session_id) is None
+    finally:
+        release.set()
+        await owner.close()
+        store.close_all_db_handles()
+
+
+@pytest.mark.asyncio
+async def test_preparation_route_lookups_never_allocate(tmp_path, monkeypatch):
+    """The current-route lookup and the target resolution run as temporary (in-memory) resolutions."""
+    from agent.model_routing_runtime import _temporary_resolution
+    from hermes_cli import model_switch
+    seen = []
+    store, db, authority, owner, ref = _owner(tmp_path, monkeypatch, _noop)
+    real_switch = model_switch.switch_model
+
+    def lookup(**kwargs):
+        seen.append(('current', _temporary_resolution.get()))
+        return 'frozen', {}
+
+    def switch(**kwargs):
+        seen.append(('target', _temporary_resolution.get()))
+        return real_switch(**kwargs)
+    authority.runner._resolve_session_agent_runtime = lookup
+    monkeypatch.setattr(model_switch, 'switch_model', switch)
+    try:
+        reply = await _mutate(owner, db, ref, 'pick', 'picked')
+        assert reply['result']['model'] == 'picked', reply
+        assert ('current', True) in seen and ('target', True) in seen
+        assert all(flag for _, flag in seen)
+        assert not (tmp_path / 'model-routing.sqlite3').exists()
+    finally:
+        await owner.close()
+        store.close_all_db_handles()
-- 
