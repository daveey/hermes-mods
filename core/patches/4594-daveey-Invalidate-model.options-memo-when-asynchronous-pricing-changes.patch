 hermes_cli/inventory.py                       |  8 ++-
 hermes_cli/models_pricing.py                  | 15 +++++
 tests/hermes_cli/test_model_options_memo.py   |  6 ++
 ...test_model_options_pricing_invalidation.py | 62 +++++++++++++++++++
 4 files changed, 90 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_cli/test_model_options_pricing_invalidation.py

