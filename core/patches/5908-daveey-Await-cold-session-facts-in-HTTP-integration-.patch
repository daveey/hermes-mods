From deac89f53aa2a269b9410fc850dceaa222420438 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 09:32:14 +0000
Subject: [PATCH] [daveey] Await cold session facts in HTTP integration tests

Public mirror of the source commit; see the accompanying feature documentation.

---
 tests/gateway/test_native_http_auth.py             | 14 ++++++++++++--
 tests/hermes_cli/test_subagent_session_activity.py | 12 ++++++++++++
 2 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/tests/gateway/test_native_http_auth.py b/tests/gateway/test_native_http_auth.py
index 62dccea3174..c51a876bad7 100644
--- a/tests/gateway/test_native_http_auth.py
+++ b/tests/gateway/test_native_http_auth.py
@@ -127,8 +127,18 @@ def test_native_http_grants_are_single_use_and_bound_to_daemon(tmp_path):
         assert sibling_config.read_bytes() == sibling_before
         assert client.get('/api/config?profile=default',
                           headers=headers(ticket(home, descriptor))).status_code == 200
-        assert client.get('/api/profiles/sessions/sidebar?recents_profile=default',
-                          headers=headers(ticket(home, descriptor))).status_code == 200
+        from tests.waiting import wait_until
+
+        def sidebar_ready():
+            # Every attempt redeems a NEW single-use grant, including cold 503s.
+            response = client.get('/api/profiles/sessions/sidebar?recents_profile=default',
+                                  headers=headers(ticket(home, descriptor)))
+            assert response.status_code in (200, 503), response.text
+            if response.status_code == 503:
+                assert response.json() == {'detail': 'sessions projection unavailable'}
+            return response.status_code == 200
+
+        assert wait_until(sidebar_ready, timeout=10)
         # The cross-profile project tree and PR scan answer one grant for its own profile only.
         assert client.get('/api/profiles/projects/tree?profile=default',
                           headers=headers(ticket(home, descriptor))).status_code == 200
diff --git a/tests/hermes_cli/test_subagent_session_activity.py b/tests/hermes_cli/test_subagent_session_activity.py
index f6b85805111..1905732eb01 100644
--- a/tests/hermes_cli/test_subagent_session_activity.py
+++ b/tests/hermes_cli/test_subagent_session_activity.py
@@ -189,7 +189,19 @@ def test_profile_lists_http_entry_paths(stored, monkeypatch, endpoint):
     monkeypatch.setattr(profiles, "_SIDEBAR_CACHE_TTL_SECONDS", 0.0)
     with TestClient(app) as client:
         client.headers[_SESSION_HEADER_NAME] = _SESSION_TOKEN
+        from tests.waiting import wait_until
+
+        def ready():
+            nonlocal response
+            response = client.get(endpoint, params={"profile": "default", "recents_profile": "default"})
+            # A new selector is built off-request; never accept another failure.
+            assert response.status_code in (200, 503), response.text
+            if response.status_code == 503:
+                assert response.json() == {"detail": "sessions projection unavailable"}
+            return response.status_code == 200
+
         response = client.get(endpoint, params={"profile": "default", "recents_profile": "default"})
+        assert wait_until(ready, timeout=10), response.text
         assert response.status_code == 200, response.text
         data = response.json()
         rows = data["recents"]["sessions"] if endpoint.endswith("sidebar") else data["sessions"]
-- 
