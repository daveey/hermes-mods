+@pytest.mark.parametrize("hub_reason", [
+    "board_admin_key", "instance_role_ssm", "needs the Board admin key", "reads it over instance-role SSM",
+])
+def test_retired_hub_write_needs_do_not_exempt_a_relay(judge, hub_reason):
+    """Board admin key / instance-role SSM are hub-write work now (hub-admin on a capability:hub-write worker), not
+    allowlist contexts: naming one no longer sends a relay card to the judge."""
+    gate, calls = judge
+    title, body = RELAYS[3]
+    verdict = gate.admit({"title": title, "body": body}, hub_reason=hub_reason)
+    assert verdict.admit is False and verdict.why.startswith("comment relay:")
+    assert calls == []
+
+
 @pytest.mark.parametrize("title,body", RELAYS)
 def test_worker_machine_hub_pin_for_a_relay_is_refused_with_the_route(judge, monkeypatch, title, body):
     """kanban_create on a worker with ``runs_on=['machine:hub']`` (how all four were filed) is refused."""
diff --git a/tests/test_kanban_hub_admission.py b/tests/test_kanban_hub_admission.py
index 3c87db98e3..619b7f165c 100644
--- a/tests/test_kanban_hub_admission.py
+++ b/tests/test_kanban_hub_admission.py
@@ -56,6 +56,21 @@ def test_invalid_verdict_denied(judge, change):
     assert result.why == "invalid admission verdict"
 
 
+@pytest.mark.parametrize("need,quote", [
+    ("board_admin_key", "Rotate the Board admin key"),
+    ("instance_role_ssm", "Read the parameter over instance-role SSM"),
+])
+def test_retired_hub_write_needs_are_not_admitted(judge, need, quote):
+    """Board admin key and instance-role SSM are hub-write work (hub-admin from a capability:hub-write worker),
+    so the rubric no longer offers them: a judge reply naming one, with a real quote, is not a valid admission."""
+    gate, _, reply, _ = judge
+    result = {"admit": True, "need": need, "evidence": quote, "why": "needs the hub"}
+    assert gate.validated(dict(result), {"title": quote, "body": ""}, None, "sha") is None
+    reply.update(result)
+    verdict = gate.admit({"title": quote, "body": ""})
+    assert verdict.admit is False and verdict.why == "invalid admission verdict"
+
+
 def test_cache_and_skill_revision(judge):
     gate, calls, _, skill = judge
     fields = {"title": "Use signed-in Chrome"}
