From d581583ba67b41e2824d142b72493ef656e03539 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 21:29:29 +0000
Subject: [PATCH] tui_gateway.watch_store: release on close_all_under and on a
 new WAL generation (card J part 2)

Like card I's hermes_state_kept_reader, the change watcher's kept readers must not outlive the file they read:

- hermes_state_registry._close_kept_readers also calls tui_gateway.watch_store.release_under (when that module
  is loaded), so close_all / close_all_under (profile delete, snapshot restore, unserve) close them before the
  header probes are released and rmtree runs (WinError 32 on Windows otherwise).
- A kept connection is dropped and reopened when a -wal/-shm it was opened against now has another identity: a
  handle stranded on a deleted WAL generation would make the next writer refuse to open
  (refuse_deleted_wal_generation).
---
 hermes_state_registry.py                   |  6 ++-
 tests/tui_gateway/test_watch_store_gate.py | 43 +++++++++++++++++++
 tui_gateway/watch_store.py                 | 49 ++++++++++++++++++----
 3 files changed, 88 insertions(+), 10 deletions(-)

diff --git a/hermes_state_registry.py b/hermes_state_registry.py
index 63efe97b88..1b6471db58 100644
--- a/hermes_state_registry.py
+++ b/hermes_state_registry.py
@@ -352,8 +352,7 @@ def close_all() -> int:
 
 
 def _close_kept_readers(root: Optional[Path]) -> None:
-    """Kept read-only handles (``hermes_state_kept_reader``, the producer-admission sweep's observers) hold the
-    same files: retire them too."""
+    """Retire kept readers, producer observers and watcher handles holding the same files."""
     import sys
 
     kept = sys.modules.get("hermes_state_kept_reader")
@@ -362,6 +361,9 @@ def _close_kept_readers(root: Optional[Path]) -> None:
     observers = sys.modules.get("tui_gateway.producer_admission")
     if observers is not None:
         observers.release_under(root)
+    watched = sys.modules.get("tui_gateway.watch_store")
+    if watched is not None:
+        watched.release_under(root)
 
 
 def close_all_under(directory: str | Path) -> int:
diff --git a/tests/tui_gateway/test_watch_store_gate.py b/tests/tui_gateway/test_watch_store_gate.py
index b1e35bf145..a38712f455 100644
--- a/tests/tui_gateway/test_watch_store_gate.py
+++ b/tests/tui_gateway/test_watch_store_gate.py
@@ -134,6 +134,49 @@ def test_kept_connections_are_bounded_and_tracked(tmp_path):
     assert not has_live_connection(paths[-1])
 
 
+def test_a_new_wal_generation_reopens_the_kept_connection(tmp_path):
+    """A handle stranded on a replaced -wal/-shm would make the next writer refuse to open: drop it."""
+    path = tmp_path / "s.db"
+    writer = sqlite3.connect(path)
+    writer.execute("PRAGMA journal_mode=WAL")
+    writer.execute("CREATE TABLE t(v)")
+    writer.commit()
+    watch_store.reset()
+    with watch_store.observed(path) as (first, _conn):
+        pass
+    wal = str(path) + "-wal"
+    assert os.path.exists(wal)
+    shutil.copy(wal, wal + ".copy")
+    os.replace(wal + ".copy", wal)  # same name, new inode: a new WAL generation
+    with watch_store.observed(path) as (second, _conn):
+        pass
+    assert second[2] != first[2], "reopened (a new generation)"
+    with watch_store.observed(path) as (third, _conn):
+        pass
+    assert third[2] == second[2], "stable once reopened"
+    watch_store.reset()
+    writer.close()
+
+
+def test_close_all_under_releases_kept_connections(tmp_path):
+    """A profile delete or snapshot restore (``hermes_state_registry.close_all_under``) closes the watcher's kept
+    readers under that home first, so rmtree on Windows and the header-probe release see no other descriptor."""
+    from hermes_cli.sqlite_safe_read import has_live_connection
+    from hermes_state_registry import close_all_under
+    watch_store.reset()
+    inside, outside = tmp_path / "doomed" / "state.db", tmp_path / "kept" / "state.db"
+    for p in (inside, outside):
+        p.parent.mkdir()
+        with sqlite3.connect(p) as conn:
+            conn.execute("CREATE TABLE t(v)")
+        with watch_store.observed(p):
+            pass
+    close_all_under(tmp_path / "doomed")
+    assert not has_live_connection(inside)
+    assert has_live_connection(outside)
+    watch_store.reset()
+
+
 def test_a_transaction_left_open_drops_the_connection(tmp_path):
     p = tmp_path / "s.db"
     with sqlite3.connect(p) as conn:
diff --git a/tui_gateway/watch_store.py b/tui_gateway/watch_store.py
index 8c2c82b5bc..48af016387 100644
--- a/tui_gateway/watch_store.py
+++ b/tui_gateway/watch_store.py
@@ -6,6 +6,11 @@ connection (schema parse), resolved the path and closed it again (about 4 ms and
 now keeps ONE read-only autocommit connection. Its key is the file identity plus ``PRAGMA data_version``, which
 moves on every commit by any other connection, this process's writers included, and is exact where an mtime is
 coarse. The main file's (size, mtime_ns) is in the key too: a restore copied over the same inode moves it.
+
+A kept connection is closed and reopened when the store's (dev, ino) changes, when a ``-wal``/``-shm`` it was
+opened against has a new identity (a new WAL generation: a handle stranded on a deleted one would make the next
+writer refuse to open, ``refuse_deleted_wal_generation``), when the store is gone, and by
+``hermes_state_registry.close_all_under`` (profile delete, snapshot restore) through :func:`release_under`.
 """
 from __future__ import annotations
 
@@ -18,11 +23,17 @@ from pathlib import Path
 
 MAX_STORES = 32
 _lock = threading.RLock()
-# path -> ((dev, ino), conn, generation). A new generation never equals an old key, so a reopened store re-reads.
-_held: OrderedDict[str, tuple[tuple[int, int], sqlite3.Connection, int]] = OrderedDict()
+# path -> [(dev, ino), conn, generation, {sidecar suffix: (dev, ino)}]. A new generation never equals an old key,
+# so a reopened store re-reads.
+_held: OrderedDict[str, list] = OrderedDict()
 _generation = 0
 
 
+def _sidecars(path: str) -> dict:
+    from hermes_state_dbfile import _stat_sqlite_sidecar_identity
+    return _stat_sqlite_sidecar_identity(Path(path))
+
+
 def _drop(path: str) -> None:
     held = _held.pop(path, None)
     if held is not None:
@@ -38,13 +49,24 @@ def reset() -> None:
 
 
 def forget(db_path) -> None:
-    """Close the kept connection of a store that is gone: a held fd on its deleted WAL would make the next
-    writer that recreates it refuse to open (``refuse_deleted_wal_generation``)."""
+    """Close the kept connection of a store that is gone."""
     with _lock:
         _drop(str(db_path))
 
 
-def _open(path: str, ident: tuple[int, int]) -> tuple:
+def release_under(root=None) -> int:
+    """Close every kept connection on a store under ``root`` (every one when None): called by
+    ``hermes_state_registry.close_all``/``close_all_under`` before the header probes are released, so a profile
+    delete's rmtree meets no kept descriptor. The next watch pass reopens what still exists."""
+    from hermes_state_common import path_is_under
+    with _lock:
+        doomed = [path for path in _held if root is None or path_is_under(Path(path), Path(root))]
+        for path in doomed:
+            _drop(path)
+    return len(doomed)
+
+
+def _open(path: str, ident: tuple[int, int]) -> list:
     global _generation
     from hermes_state import _connect_tracked_db
     from hermes_state_holders import read_only_db_uri
@@ -53,19 +75,30 @@ def _open(path: str, ident: tuple[int, int]) -> tuple:
                                check_same_thread=False, isolation_level=None, timeout=0.05)
     try:
         conn.execute("PRAGMA query_only = ON")
+        conn.execute("PRAGMA data_version").fetchone()  # attach to the current WAL generation before recording it
         st = os.stat(path)
         if (st.st_dev, st.st_ino) != ident:
             raise sqlite3.OperationalError("store replaced while its observer opened")
+        sidecars = _sidecars(path)
     except BaseException:
         conn.close()
         raise
     _generation += 1
-    held = _held[path] = (ident, conn, _generation)
+    held = _held[path] = [ident, conn, _generation, sidecars]
     while len(_held) > MAX_STORES:
         _drop(next(iter(_held)))
     return held
 
 
+def _stranded(held: list, path: str) -> bool:
+    """A sidecar the connection was opened against now names another file (or none): a new WAL generation."""
+    now = _sidecars(path)
+    if any(now.get(suffix) != ident for suffix, ident in held[3].items()):
+        return True
+    held[3] = {**now, **held[3]}  # a sidecar created since the open is this connection's generation
+    return False
+
+
 @contextlib.contextmanager
 def observed(db_path):
     """``(key, conn)`` for ``db_path`` under the module lock: equal keys mean no commit was published between them.
@@ -78,8 +111,8 @@ def observed(db_path):
             st = os.stat(path)
             ident = (st.st_dev, st.st_ino)
             held = _held.get(path)
-            if held is not None and held[0] != ident:
-                _drop(path)  # replaced or recreated under this path
+            if held is not None and (held[0] != ident or _stranded(held, path)):
+                _drop(path)  # replaced, recreated or a new WAL generation under this path
                 held = None
             if held is None:
                 held = _open(path, ident)
-- 
