From 7f2ad1204105ebd76facc7538ff66a88e203a680 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 11 Oct 2026 12:06:38 -0700
Subject: [PATCH] fix(tui-gateway): live compression config reload leaves
 context-engine plugins alone [daveey]

---
 .../test_compression_config_hot_reload.py     | 45 +++++++++++++++++++
 tui_gateway/session_compression.py            |  9 ++++
 2 files changed, 54 insertions(+)

diff --git a/tests/tui_gateway/test_compression_config_hot_reload.py b/tests/tui_gateway/test_compression_config_hot_reload.py
index 06ef6ccf84..c3e10b8728 100644
--- a/tests/tui_gateway/test_compression_config_hot_reload.py
+++ b/tests/tui_gateway/test_compression_config_hot_reload.py
@@ -326,3 +326,48 @@ def test_apply_live_compression_config_is_self_contained():
     _apply_live_compression_config(agent, {"compression": {"enabled": True}})
     assert agent.compression_enabled is True
     assert agent.codex_responses_native_compaction is False
+
+
+class _PluginEngine:
+    """A context-engine plugin (e.g. LCM) that owns its own threshold derivation.
+
+    It deliberately lacks the built-in ContextCompressor privates (``_coerce_threshold_tokens_cap``,
+    ``_effective_threshold_percent``) that the live sync used to call unconditionally.
+    """
+
+    name = "lcm"
+
+    def __init__(self):
+        self.threshold_percent = 0.75
+        self.tail_mode = "plugin-owned"
+        self.context_length = 1_000_000
+
+
+def test_plugin_context_engine_is_not_rewritten_by_live_sync(monkeypatch):
+    engine = _PluginEngine()
+    agent = SimpleNamespace(
+        model="claude-opus-5-5",
+        provider="anthropic",
+        context_compressor=engine,
+        compression_enabled=True,
+        compression_idle_compact_after_seconds=0,
+        codex_responses_native_compaction=False,
+        codex_responses_compact_threshold=200_000,
+        _config_context_length=None,
+    )
+    session = {"agent": agent, "session_key": "session-plugin-engine"}
+    monkeypatch.setattr(
+        server,
+        "_load_cfg",
+        lambda: {"compression": {"threshold": 0.5, "tail_mode": "legacy", "idle_compact_after_seconds": 600}},
+    )
+
+    # Must not raise: the sync path used to swallow an AttributeError here and log it every turn.
+    from tui_gateway.session_compression import _apply_live_compression_config
+    _apply_live_compression_config(agent, server._load_cfg())
+    assert session["agent"] is agent
+    # Agent-level keys still adopt live config.
+    assert agent.compression_idle_compact_after_seconds == 600
+    # The plugin's own settings are untouched.
+    assert engine.threshold_percent == 0.75
+    assert engine.tail_mode == "plugin-owned"
diff --git a/tui_gateway/session_compression.py b/tui_gateway/session_compression.py
index 2d10ea89e7..655d3bdfa1 100644
--- a/tui_gateway/session_compression.py
+++ b/tui_gateway/session_compression.py
@@ -114,6 +114,15 @@ def _apply_live_compression_config(agent: Any, cfg: dict | None) -> None:
     cc = getattr(agent, "context_compressor", None)
     if cc is None:
         return
+    from agent.context_compressor import ContextCompressor
+    if not isinstance(cc, ContextCompressor):
+        # A context-engine plugin (e.g. LCM) derives its own thresholds from its own config. Writing the
+        # built-in compressor's privates onto it clobbered the plugin's threshold_percent and then raised
+        # on ``_coerce_threshold_tokens_cap`` every turn. Only the agent-level context-length pin applies.
+        new_ctx = config_context_length_for_runtime(agent, cfg)
+        if new_ctx is not None:
+            agent._config_context_length = new_ctx
+        return
     # tail_mode: unknown/absent values land on the ctor default ("lean"), matching agent_init.
     default_tail = str(_compressor_ctor_default("tail_mode", "lean"))
     mode = str(compression.get("tail_mode", default_tail) or default_tail).strip().lower()
-- 
