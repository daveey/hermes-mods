Subject: [PATCH] [daveey] independently exercise board-name length bound

---
 tests/hermes_cli/test_kanban_links_reason_counters.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_links_reason_counters.py b/tests/hermes_cli/test_kanban_links_reason_counters.py
index 043697688f..b8fa18f95f 100644
--- a/tests/hermes_cli/test_kanban_links_reason_counters.py
+++ b/tests/hermes_cli/test_kanban_links_reason_counters.py
@@ -213,6 +213,10 @@ def test_each_changed_component_is_named(index, component):
 def test_board_names_are_bounded_without_evicting_admitted_boards(monkeypatch):
     from hermes_cli import kanban_links_diagnostics as diag
     monkeypatch.setattr(diag, "_boards", {})
+    assert diag.board_name("x" * 81) == "sync.links.board.other"
+    assert diag._boards == {}
+    assert diag.board_name("x" * 80) == "sync.links.board." + "x" * 80
+    monkeypatch.setattr(diag, "_boards", {})
     first = diag.board_name("first")
     for i in range(100):
         diag.board_name(str(i))
