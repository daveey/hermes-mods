diff --git a/tests/hermes_cli/test_kanban_operator_resume_observed_feed.py b/tests/hermes_cli/test_kanban_operator_resume_observed_feed.py
new file mode 100644
index 0000000000..284f931197
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_operator_resume_observed_feed.py
@@ -0,0 +1,45 @@
+"""A worker's real ``active_pr`` hold reaches the home over the Board feed, and the home's resume accepts it.
+
+``test_kanban_operator_resume_observed`` writes the promoted/respawn_guarded events by hand. Here nothing is
+hand-built: the worker's own dispatcher records the hold on its kept copy, the in-memory Board feed carries it
+to the home, and ``hermes kanban resume`` (the real argparse path) runs on the home while the home's own guard
+has released (its GitHub read says MERGED). The worker, whose read still says OPEN, then claims. [daveey]
+"""
+from __future__ import annotations
+
+from hermes_cli import kanban_db_dispatch as kbd
+from hermes_cli import kanban_db_dispatch_pr_state as prs
+from hermes_cli import kanban_operator_resume as resume
+from hermes_cli.kanban_observed_pr_hold import observed
+from tests.hermes_cli import test_kanban_edit_operator_fields as ops
+from tests.hermes_cli import test_kanban_operator_resume_worker_copy as copy
+from tests.hermes_cli import test_kanban_worker_node as support
+
+svc = support.svc
+gws = support.gws
+clock = copy.clock
+
+
+def test_real_worker_hold_fed_home_lets_home_resume_and_worker_claim(gws, clock, monkeypatch, capsys):
+    hub, worker = gws
+    tid = copy._held_on_worker(gws, clock)  # the worker's dispatch_once recorded the hold
+    hub.enter()
+    holds = hub.conn.execute("SELECT origin_gateway, payload FROM task_events WHERE task_id=? "
+                             "AND kind='respawn_guarded'", (tid,)).fetchall()
+    assert holds and all(h["origin_gateway"] == support.WORKER for h in holds)  # fed, not written at home
+    assert all('"active_pr"' in h["payload"] for h in holds)
+    monkeypatch.setattr(prs, "pr_state", lambda _: "MERGED")  # the home's read: its own guard releases
+    assert kbd.check_respawn_guard(hub.conn, tid) is None
+    assert observed(hub.conn, tid)  # only the worker's fed observation qualifies the resume
+    clock[0] += 60
+    assert ops._main(["resume", tid, "--reason", "worker still holds its PR"]) == 0
+    assert "Resumed" in capsys.readouterr().out
+    monkeypatch.setattr(prs, "pr_state", lambda _: "OPEN")  # the worker's read: still open
+    hub.round()
+    worker.round()
+    worker.enter()
+    assert resume.EVENT in copy._kinds(worker.conn, tid)
+    assert kbd.check_respawn_guard(worker.conn, tid) is None
+    clock[0] += 5
+    worker.tick()
+    assert copy._status(worker.conn, tid) == "running"
diff --git a/tests/hermes_cli/test_kanban_review_release.py b/tests/hermes_cli/test_kanban_review_release.py
index 656976f097..b8e6b817f6 100644
--- a/tests/hermes_cli/test_kanban_review_release.py
+++ b/tests/hermes_cli/test_kanban_review_release.py
@@ -150,6 +150,45 @@ def test_remote_review_change_during_precompute_drops_stamp(board, monkeypatch):
     monkeypatch.setattr(release.review, "_completed_review_run", lookup)
 
 
+@pytest.mark.parametrize("hold,evaluated", [
+    ("sticky", False), ("breaker", False), ("task_breaker", False), ("task_headroom", True), ("none", True),
+    ("todo_at_limit", True)])
+def test_held_card_gets_no_external_evaluation(board, monkeypatch, hold, evaluated):
+    # recompute_ready never promotes a sticky or breaker-held card, so its precompute
+    # must not spend GitHub reads or snapshots on it either. The breaker binds only
+    # blocked/triage stops: a todo dependency wait at the limit still promotes.
+    import json
+    from hermes_cli.kanban_block_routing import has_sticky_block
+    task, reviews = helpers.parked(board)
+    limit = kb.DEFAULT_FAILURE_LIMIT
+    status = "todo" if hold == "todo_at_limit" else "blocked"
+    failures, retries = {"breaker": (limit, None), "task_breaker": (1, 1), "todo_at_limit": (limit, None),
+                         "task_headroom": (limit, limit + 1)}.get(hold, (0, None))
+    board.execute("UPDATE tasks SET status=?, consecutive_failures=?, max_retries=? WHERE id=?",
+                  (status, failures, retries, task))
+    if hold == "sticky":
+        kb._append_event(board, task, "blocked", {"reason": "explicit"})
+    board.commit()
+    assert has_sticky_block(board, task) is (hold == "sticky")
+    reads = []
+    monkeypatch.setattr(prs, "pr_state", lambda url: reads.append(url) or "OPEN")
+    for review in reviews:
+        kb.claim_task(board, review)
+        run = kb.get_task(board, review).current_run_id
+        assert kb.complete_task(board, review, summary="Review complete", expected_run_id=run,
+                                metadata={"verdict": "changes_required", "pr": PR, "reviewed_sha": "a" * 40})
+    board.execute("UPDATE tasks SET status=? WHERE id=?", (status, task))
+    board.commit()
+    reads.clear()
+    kb.recompute_ready(board)
+    assert bool(reads) is evaluated
+    promoted = board.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='promoted'",
+                             (task,)).fetchall()
+    assert bool(promoted) is evaluated
+    if evaluated:
+        assert "review_release" in json.loads(promoted[-1]["payload"])
+
+
 def test_home_never_honours_its_own_stamp(board):
     # The home holds the evidence and keeps deciding with resumes_review, so a
     # later change to that evidence re-holds there; only a replica uses the stamp.
