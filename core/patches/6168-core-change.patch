From 3ddf2483e8d9a0e1b0e181b579c29d3c5f1c1e7b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 24 Nov 2026 11:57:29 +0000
Subject: [PATCH 6168] Fail-closed startup readiness and natural controller rollover

Public mirror of source commit 3ddf2483e8d9a0e1b0e181b579c29d3c5f1c1e7b.

---
diff --git a/tests/docker/test_dashboard.py b/tests/docker/test_dashboard.py
index 3c6003305a9..0fba3fdea27 100644
--- a/tests/docker/test_dashboard.py
+++ b/tests/docker/test_dashboard.py
@@ -59,13 +59,12 @@
 ) -> tuple[int, str]:
     """Poll ``http://127.0.0.1:9119<path>`` from inside the container.
 
-    Returns ``(status_code, body)`` as soon as the dashboard answers any
-    HTTP response — 200, 401, 503, anything. The image doesn't ship
-    ``curl`` but the venv's stdlib ``urllib`` is good enough; we use a
-    proper ``try``/``except`` to intercept ``HTTPError`` because
-    ``urlopen`` raises on 4xx/5xx, and we treat those as legitimate
-    responses (the OAuth gate's 401 IS the success signal for the
-    gate-engaged test).
+    Returns ``(status_code, body)`` as soon as the dashboard answers an
+    HTTP response other than the exact standalone-services warmup 503.
+    Other errors return immediately: in particular, 401 is the success
+    signal for the gate-engaged test. The image doesn't ship ``curl`` but
+    the venv's stdlib ``urllib`` is good enough; we intercept ``HTTPError``
+    because ``urlopen`` raises on 4xx/5xx.
 
     Connection errors (uvicorn still starting, fail-closed exited) keep
     the poll loop running until ``deadline_s`` elapses.
@@ -108,7 +107,11 @@
             try:
                 status = int(lines[0].strip())
                 body = lines[1] if len(lines) > 1 else ""
-                return status, body
+                if status == 503 and body == '{"detail":"Backend services warming"}':
+                    # The listener is live before standalone services are ready.
+                    last_err = f"startup warmup: {body}"
+                else:
+                    return status, body
             except (ValueError, IndexError) as exc:
                 last_err = f"parse: {exc!r} / stdout={r.stdout!r}"
         else:
diff --git a/tests/test_docker_poll_stalled_exec.py b/tests/test_docker_poll_stalled_exec.py
index 7422dc9451c..968504063e2 100644
--- a/tests/test_docker_poll_stalled_exec.py
+++ b/tests/test_docker_poll_stalled_exec.py
@@ -120,3 +120,40 @@
         with pytest.raises(AssertionError, match="never returned HTTP"):
             module._http_probe("c", "/api/status", deadline_s=1.0)
     assert clock.now <= 1.0
+
+
+@pytest.mark.parametrize("ready_status", [200, 401])
+def test_dashboard_http_probe_waits_through_services_warmup(monkeypatch, ready_status):
+    """Listener readiness must not expose the intentional startup 503 to gate assertions."""
+    clock = _Clock()
+    monkeypatch.setattr(test_dashboard, "time", clock)
+    warming = SimpleNamespace(returncode=0, stdout='503\n{"detail":"Backend services warming"}', stderr="")
+    ready = SimpleNamespace(returncode=0, stdout=f"{ready_status}\nready", stderr="")
+    outcomes = [warming, ready]
+    monkeypatch.setattr(test_dashboard, "docker_exec_sh", _scripted_exec(clock, outcomes))
+    assert test_dashboard._http_probe("c", "/api/auth/providers") == (ready_status, "ready")
+    assert outcomes == [ready]
+
+
+@pytest.mark.parametrize(
+    ("status", "body"),
+    [(401, '{"detail":"Backend services warming"}'), (500, '{"detail":"Backend services warming"}'),
+     (503, '{"detail":"unavailable"}'), (503, "not json")],
+)
+def test_dashboard_http_probe_preserves_non_warmup_errors(monkeypatch, status, body):
+    clock = _Clock()
+    monkeypatch.setattr(test_dashboard, "time", clock)
+    response = SimpleNamespace(returncode=0, stdout=f"{status}\n{body}", stderr="")
+    monkeypatch.setattr(test_dashboard, "docker_exec_sh", _scripted_exec(clock, [response]))
+    assert test_dashboard._http_probe("c", "/api/sessions") == (status, body)
+    assert clock.now == 0.1
+
+
+def test_dashboard_http_probe_warmup_keeps_original_deadline(monkeypatch):
+    clock = _Clock()
+    monkeypatch.setattr(test_dashboard, "time", clock)
+    warming = SimpleNamespace(returncode=0, stdout='503\n{"detail":"Backend services warming"}', stderr="")
+    monkeypatch.setattr(test_dashboard, "docker_exec_sh", _scripted_exec(clock, [warming]))
+    with pytest.raises(AssertionError, match="Backend services warming"):
+        test_dashboard._http_probe("c", "/api/auth/providers", deadline_s=2.0)
+    assert clock.now <= 2.0
