From 06bac8cc6b260463fe79acd1b0c231910c600132 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 04:56:18 +0000
Subject: [PATCH] [daveey] kanban notices: post_notice uses the held read as
 its admission (agent-b460ba9d37)

Review of #3548: post_notice made the held governor read in _queued and dropped it. With a
capable non-pacing skip recorded before the hold (worker_capacity_full, per_profile_capped),
_pacing_admission returned None, so the notice said admission unknown plus 'Not a placement
problem' while ready_hint said held. post_notice now uses the _held_over_claims result as the
admission ahead of the verdict, as ready_hint does, and skips the verdict fields when held.
New rows cover both capable skips on both notice paths.
---
 hermes_cli/kanban_parent_unclaimed.py                   | 9 +++++----
 tests/hermes_cli/test_kanban_notice_pacing_admission.py | 6 +++++-
 2 files changed, 10 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_parent_unclaimed.py b/hermes_cli/kanban_parent_unclaimed.py
index 1f0bd898c3db0e7a435829cb3ee49c1619d8fb7e..ec0989764fdda7abe5ec1543411fc11be9ba531a 100644
--- a/hermes_cli/kanban_parent_unclaimed.py
+++ b/hermes_cli/kanban_parent_unclaimed.py
@@ -325,14 +325,15 @@ def post_notice(conn, task_id: str, waiting_on: str, *, wait_key: Any, waited_se
         return False  # before the queue place: every tick asks again for each long-ready card [daveey]
     place = _place(conn, waiting_on)
     extra = _host_hold_only_if_local(extra, place)
-    busy = _queued(conn, waiting_on, place)
+    held = _held_over_claims(conn, waiting_on, place)  # the held read IS the admission, as in ready_hint [daveey]
+    busy = held is None and klb.busy(place.get("backlog"))
     from hermes_cli import kanban_notice_verdict
-    verdict = ({} if busy or (extra or {}).get("core_update_hold") else
+    verdict = ({} if busy or held or (extra or {}).get("core_update_hold") else
                kanban_notice_verdict.fields(conn, waiting_on, place, ready_seconds, _read_pacing))
     observed = {"board": place.get("board") or khc.board_of(conn), "observed_at": place.get("observed_at") or int(time.time()),
                 "admission": ({"reason": "core_update_hold", "status": "held"} if (extra or {}).get("core_update_hold")
-                              else {"reason": klb.REASON, "status": "queued"} if busy
-                              else verdict.get("admission") or _pacing_admission(conn, waiting_on, place, extra)
+                              else held or ({"reason": klb.REASON, "status": "queued"} if busy else None)
+                              or verdict.get("admission") or _pacing_admission(conn, waiting_on, place, extra)
                               or {"reason": None, "status": "unknown"})}
     guard = place.get("reason") if place.get("lane") == "respawn_guard" else None
     pool_hint = "" if guard else _pool_sentence(place, observed["observed_at"])  # outside the queue clause (#1821)
diff --git a/tests/hermes_cli/test_kanban_notice_pacing_admission.py b/tests/hermes_cli/test_kanban_notice_pacing_admission.py
index e5fcce3df53d2bb4fc6e33264ba863b95083b4bf..fd44472bd6fc23b53b44904ea712e627d4d9b64d 100644
--- a/tests/hermes_cli/test_kanban_notice_pacing_admission.py
+++ b/tests/hermes_cli/test_kanban_notice_pacing_admission.py
@@ -363,7 +363,7 @@ def _claimed_by_the_pool(conn, n=3):
             kb._append_event(conn, claimed, "claimed", {"holder": f"worker-{3 + i % 2}", "run_uid": f"r{i}"})
 
 
-@pytest.mark.parametrize("recorded", ["hub_only", "stale_paced_verdict"])
+@pytest.mark.parametrize("recorded", ["hub_only", "stale_paced_verdict", "worker_capacity_full", "per_profile_capped"])
 @pytest.mark.parametrize("path", sorted(NOTICES))
 def test_a_held_pool_beats_same_label_claims_on_other_providers(hub, path, recorded):
     """Defect agent-b460ba9d37 (hub, 2026-11-15 17:17Z): openai-codex went ``held`` (all accounts at 100% of the
@@ -380,6 +380,10 @@ def test_a_held_pool_beats_same_label_claims_on_other_providers(hub, path, recor
         assert skips.record(hub.conn, tid, "llm_paced", detail="anthropic paced",
                             extra={"providers": [{"provider": "anthropic", "state": "paced", "limit": 1,
                                                   "running": 1}]})
+    elif recorded == "worker_capacity_full":  # a capable non-pacing skip from before the hold (review of #3548)
+        assert skips.record(hub.conn, tid, "claim_deferred", detail="worker_capacity_full")
+    elif recorded == "per_profile_capped":
+        assert skips.record(hub.conn, tid, "per_profile_capped")
     _claimed_by_the_pool(hub.conn)
     payload, text = NOTICES[path](hub.conn, tid)
     assert payload["admission"]["status"] == "held", payload
