From e8cb9e606e4b468c18f7eb6b87400617ad4ac4ea Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 15:37:23 +0000
Subject: [PATCH] [daveey] Admit state candidates through shared Mac check
 hooks

Problem: native state pre-push integration failed 12 cases after core Mac
admission was installed. State fixtures load the installed core hook verbatim.
Why: judge() applied the portable-core refusal before selecting the candidate's
own checker. The dispatcher is shared by core and state branches/worktrees.
Root (happened): repository policy was attached to a cross-repository dispatcher.
Root (not caught): Mac admission fixtures covered checker-present/absent but
never the state layout or state checker dispatch.
Recurrence: follows f57b179cc01c; state fixture containment does not fix admission.

Recognize state using candidate Git objects: five existing regular state files,
with core markers forbidden. No ref-name, checkout, environment or flag bypass.
Core, mixed, incomplete and unknown trees (even without a checker) fail closed
on Darwin. Non-Mac behavior and core main() refusal are unchanged. This is a
structural layout contract, not cryptographic authentication of repository code.
The state checker still executes and its failures propagate.

Proof on pool Linux:
- Original unconditional refusal restored as mutant: 21 pass, 3 fail.
- New admission + existing Mac admission + code-health CLI: 96 pass.
- Unchanged state test_state_pre_push_check: 73 tests OK, 2 skips, 134.263s.
- Explicit Darwin admission data then real state snapshot checker: exit 0 at
  state 74e9bec8123beab2fa83eb1303e502ce6140279e; not native coverage.
- scripts/check --base origin/main: all 20 checks OK.

Deployment: update installed core, refresh shared pre-push/pre-commit hooks
using scripts/check --install-hook. Native parent reruns unchanged state suite
on mini; Linux decision tests do not claim native acceptance.
---
 scripts/check                               |  41 +++++--
 tests/scripts/test_check_mac_admission.py   |   2 +-
 tests/scripts/test_check_state_admission.py | 113 ++++++++++++++++++++
 3 files changed, 145 insertions(+), 11 deletions(-)
 create mode 100644 tests/scripts/test_check_state_admission.py

diff --git a/scripts/check b/scripts/check
index 575d1c6a833c99f3f753b257c9e8f8431e2c58d7..97a37cc1d60f472c21993be55d5e6a6c605d3e1d 100755
--- a/scripts/check
+++ b/scripts/check
@@ -11,9 +11,10 @@ profile-archive, prompt-surface and blob-size guards that CI runs in workflows o
     python scripts/check --uninstall-hook
 
 CI runs the same command (``.github/workflows/lint.yml``), so a green local run means a green
-lint lane. On macOS execution is refused: portable core checks belong on a pool worker.
-Hook management remains available. Refresh installed hooks after updating; their admission
-also protects historical candidates whose own checker predates this policy.
+lint lane. On macOS core execution is refused: portable core checks belong on a pool worker.
+Hook management remains available. Shared hooks admit only structurally identified state
+candidates on Macs, running their own checker; core, mixed and unknown trees fail closed.
+Refresh installed hooks after updating: their admission also protects historical candidates.
 Hooks are skippable (``--no-verify``); CI is not. The code-health part honours the
 ``ENFORCEMENT`` switch in ``scripts/code_health/config.py`` (blocking / advisory / off).
 """
@@ -47,7 +48,8 @@ from scripts.code_health.ruff_runner import resolve_ruff  # noqa: E402
 _HOOK_MARK = "# hermes-agent scripts/check hook"
 # Hooks are shared by every worktree of the clone, so the checked-out branch decides nothing:
 # each candidate (the index being committed, the tip of each pushed branch) is materialized and
-# judged by its own scripts/check, and a candidate that predates scripts/check is not judged.
+# judged by its own scripts/check. Non-Mac candidates predating scripts/check are not judged;
+# Macs admit only the known state layout, even when the candidate has no checker.
 _HOOK_HEAD = f"""#!/usr/bin/env bash
 {_HOOK_MARK} (`scripts/check --install-hook`; skip once with --no-verify)
 """ + r"""repo="$(git rev-parse --show-toplevel)" || exit 1
@@ -113,15 +115,32 @@ if env.get("PATH") and pp:
   py="$(command -v python3 || command -v python || echo "$py")"
   break
 done
+candidate_admitted() {  # TREE-ISH HOST: classify committed bytes, never the checkout or ref name
+  local tree=$1 host=$2 path entry
+  [ "$host" = Darwin ] || return 0
+  # State shares these hooks with core. Require its existing layout, including
+  # regular (not symlink) checker/guard files; ambiguous mixed/core trees refuse.
+  for path in pyproject.toml run_agent.py hermes_cli agent; do
+    if git cat-file -e "$tree:$path" 2>/dev/null; then
+      echo "scripts/check: portable core checks belong on a pool worker, not this Mac" >&2
+      return 2
+    fi
+  done
+  for path in scripts/check hermes-sync shared-config.json scripts/state-push-guard tests/state_guard_rules.py; do
+    entry="$(git ls-tree "$tree" -- "$path")" || return 2
+    case "$entry" in
+      "100644 blob "*|"100755 blob "*) ;;
+      *) echo "scripts/check: unknown candidate; portable core checks belong on a pool worker, not this Mac" >&2
+         return 2 ;;
+    esac
+  done
+}
 judge() {  # judge TREE-ISH ARGS...: check out TREE-ISH alone and run its own scripts/check ARGS
   local tree=$1 tmp dir rc
   shift
-  # The installed hook must also protect pushes of historical candidates whose
-  # own scripts/check predates Mac admission. Refuse, never skip a required gate.
-  if [ "$(uname -s)" = Darwin ]; then
-    echo "scripts/check: portable core checks belong on a pool worker, not this Mac" >&2
-    return 2
-  fi
+  # Installed admission also protects historical core checkers. State still runs
+  # its own real checker; recognizing it is not permission to skip any gate.
+  candidate_admitted "$tree" "$(uname -s)" || return $?
   tmp="$(mktemp -d)" || return 1
   # Git for Windows: native git and python get this path verbatim when MSYS path conversion
   # is off (MSYS_NO_PATHCONV=1, as Hermes' terminal sets it), so hand them C:/... spelling.
@@ -141,6 +160,7 @@ _HOOKS = {
 index="$(git rev-parse --path-format=absolute --git-path index)" || exit 1
 export GIT_INDEX_FILE="$index"
 tree="$(git write-tree)" || exit 1
+candidate_admitted "$tree" "$(uname -s)" || exit $?
 git cat-file -e "$tree:scripts/check" 2>/dev/null || exit 0
 judge "$tree" --staged
 """,
@@ -150,6 +170,7 @@ judge "$tree" --staged
     "pre-push": _HOOK_HEAD + """status=0
 while read -r _ local_sha _ _; do
   case "$local_sha" in *[!0]*) ;; *) continue ;; esac
+  candidate_admitted "$local_sha" "$(uname -s)" || { status=1; continue; }
   git cat-file -e "$local_sha:scripts/check" 2>/dev/null || continue
   judge "$local_sha" --commit "$local_sha" </dev/null || status=1
 done
diff --git a/tests/scripts/test_check_mac_admission.py b/tests/scripts/test_check_mac_admission.py
index bbbc05433725920c1f3a304947489b83312b6755..54edc39c3b7c3c745bdec6bef2eae3cdd3c5cbe9 100644
--- a/tests/scripts/test_check_mac_admission.py
+++ b/tests/scripts/test_check_mac_admission.py
@@ -96,7 +96,7 @@ def test_git_snapshot_push_refuses_before_historical_checker(tmp_path, caller, h
     argv = (["bash", "-c", shlex.join(push)] if caller == "terminal" else
             [sys.executable, "-c", "import subprocess,sys; sys.exit(subprocess.call(sys.argv[1:]))", *push])
     result = _run(argv, repo, env)
-    refused = host == "Darwin" and candidate
+    refused = host == "Darwin"
     assert (result.returncode != 0) == refused, result.stdout + result.stderr
     assert ("pool worker" in result.stderr) == refused
     assert sentinel.exists() == (candidate and not refused)
diff --git a/tests/scripts/test_check_state_admission.py b/tests/scripts/test_check_state_admission.py
new file mode 100644
index 0000000000000000000000000000000000000000..75ac4365a4f40de6ea3d4c85ffe44be289ee3f9d
--- /dev/null
+++ b/tests/scripts/test_check_state_admission.py
@@ -0,0 +1,113 @@
+"""Shared-hook candidate classification, without spoofing the machine's OS."""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import runpy
+import subprocess
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+STATE_FILES = ("scripts/check", "hermes-sync", "shared-config.json",
+               "scripts/state-push-guard", "tests/state_guard_rules.py")
+
+
+def run(repo, env, *argv):
+    return subprocess.run(argv, cwd=repo, env=env, capture_output=True,
+                          text=True, encoding="utf-8", timeout=30, check=False)
+
+
+@pytest.fixture
+def candidate(tmp_path):
+    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
+    env.update(HOME=str(tmp_path), HERMES_HOME=str(tmp_path / "home"),
+               GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM="1")
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    assert run(repo, env, "git", "init", "-q").returncode == 0
+    for rel in STATE_FILES:
+        path = repo / rel
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text("# fixture\n", encoding="utf-8")
+    return repo, env
+
+
+def admission(candidate, host="Darwin"):
+    repo, env = candidate
+    assert run(repo, env, "git", "add", ".").returncode == 0
+    tree = run(repo, env, "git", "write-tree").stdout.strip()
+    hook = runpy.run_path(str(ROOT / "scripts/check"))["_HOOK_HEAD"]
+    # Call the actual host decision with explicit data. No uname shim, platform
+    # patch or production bypass: native execution remains a separate proof.
+    return run(repo, env, "bash", "-c", hook + '\ncandidate_admitted "$1" "$2"',
+               "fixture", tree, host)
+
+
+def test_state_candidate_is_admitted(candidate):
+    result = admission(candidate)
+    assert result.returncode == 0, result.stderr
+
+
+@pytest.mark.parametrize("missing", STATE_FILES)
+def test_incomplete_or_unknown_candidate_refused(candidate, missing):
+    (candidate[0] / missing).unlink()
+    assert admission(candidate).returncode == 2
+
+
+@pytest.mark.parametrize("marker", ["pyproject.toml", "run_agent.py", "hermes_cli", "agent"])
+def test_core_and_mixed_candidates_refused(candidate, marker):
+    (candidate[0] / marker).write_text("historical core", encoding="utf-8")
+    assert admission(candidate).returncode == 2
+
+
+@pytest.mark.parametrize("rel", STATE_FILES)
+def test_symlink_state_markers_refused(candidate, rel):
+    path = candidate[0] / rel
+    path.unlink()
+    path.symlink_to("elsewhere")
+    assert admission(candidate).returncode == 2
+
+
+def test_worktree_state_markers_cannot_admit_unknown_index(candidate):
+    repo, env = candidate
+    assert run(repo, env, "git", "add", "scripts/check").returncode == 0
+    tree = run(repo, env, "git", "write-tree").stdout.strip()
+    hook = runpy.run_path(str(ROOT / "scripts/check"))["_HOOK_HEAD"]
+    result = run(repo, env, "bash", "-c", hook + '\ncandidate_admitted "$1" Darwin', "fixture", tree)
+    assert result.returncode == 2
+
+
+def test_linux_unknown_candidate_is_admitted(candidate):
+    (candidate[0] / "hermes-sync").unlink()
+    assert admission(candidate, "Linux").returncode == 0
+
+
+@pytest.mark.parametrize("rel", STATE_FILES)
+def test_directory_state_markers_refused(candidate, rel):
+    path = candidate[0] / rel
+    path.unlink()
+    path.mkdir()
+    (path / "child").write_text("fixture", encoding="utf-8")
+    assert admission(candidate).returncode == 2
+
+
+def test_executable_state_files_admitted(candidate):
+    for rel in STATE_FILES:
+        (candidate[0] / rel).chmod(0o755)
+    assert admission(candidate).returncode == 0
+
+
+def test_admitted_candidate_runs_checker_and_preserves_failure(candidate):
+    repo, env = candidate
+    (repo / "scripts/check").write_text('print("candidate checker ran")\nraise SystemExit(7)\n',
+                                        encoding="utf-8")
+    assert run(repo, env, "git", "add", ".").returncode == 0
+    tree = run(repo, env, "git", "write-tree").stdout.strip()
+    hook = runpy.run_path(str(ROOT / "scripts/check"))["_HOOK_HEAD"]
+    # Explicit Darwin classification followed by the real snapshot executor on
+    # this pool host. This is not native macOS coverage.
+    result = run(repo, env, "bash", "-c",
+                 hook + '\ncandidate_admitted "$1" Darwin && judge "$1" --staged', "fixture", tree)
+    assert result.returncode == 7, result.stderr
+    assert "candidate checker ran" in result.stdout
