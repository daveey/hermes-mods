+// ── Cross-gateway move [daveey] ─────────────────────────────────────────────
+// The sidebar shows every gateway's sessions and projects, but a move has to
+// run on the gateway that OWNS the session (asking the active one answers
+// "session not found"), with a folder that exists THERE. When the owning
+// gateway has no such project yet, it gets one: same name, the same
+// home-relative folder, cloned from the source's git origin when missing.
+
+interface MoveTarget {
+  connectionId: string
+  profile: null | string
+  remote: boolean
+}
+
+function treeSessionRows(): SessionInfo[] {
+  return $projectTree
+    .get()
+    .flatMap(project => [
+      ...(project.previewSessions ?? []),
+      ...(project.repos ?? []).flatMap(repo => repo.groups.flatMap(group => group.sessions))
+    ])
+}
+
+function moveTargetGateway(sessionId: string, profile?: null | string, connectionId?: null | string): MoveTarget {
+  const row =
+    $sessions.get().find(s => sessionMatchesStoredId(s, sessionId)) ??
+    treeSessionRows().find(s => sessionMatchesStoredId(s, sessionId))
+
+  const conn = (connectionId ?? row?.connection_id ?? '').trim()
+  const self = ownerGatewayId(projectRowOwner())
+
+  if (!conn || conn === self) {
+    return { connectionId: self, profile: profile ?? null, remote: false }
+  }
+
+  const remoteProfile = $connectionsRegistry.get()?.connections.find(c => c.id === conn)?.remoteProfile
+
+  return {
+    connectionId: conn,
+    profile: normalizeProfileKey(profile || row?.profile || remoteProfile || 'default'),
+    remote: true
+  }
+}
+
+function moveTargetRequest<T>(target: MoveTarget, method: string, params: Record<string, unknown>): Promise<T> {
+  return target.remote
+    ? requestGatewayForAgent<T>(target.connectionId, target.profile || 'default', method, params, 60_000)
+    : gatewayRequest<T>(method, params)
+}
+
+function expireRemoteProjectTree(connectionId: string): void {
+  const entry = remoteTrees.get(connectionId)
+
+  if (entry) {
+    entry.fetchedAt = 0
+  }
+}
+
+const labelKey = (label: string): string => label.trim().toLowerCase()
+
+/** Shell word for a path; a `~/` prefix stays expandable. */
+function shellPath(path: string): string {
+  const quote = (s: string) => `'${s.replace(/'/g, `'\\''`)}'`
+
+  return path.startsWith('~/') ? `"$HOME"/${quote(path.slice(2))}` : quote(path)
+}
+
+/** `/Users/x/code/a` or `/home/x/code/a` → `~/code/a`, so it lands in the other host's home. */
+export function homeRelativePath(path: string): string {
+  const m = path.match(/^(?:\/Users|\/home)\/[^/]+(\/.*)?$/) ?? path.match(/^\/root(\/.*)?$/)
+
+  return m ? `~${m[1] ?? ''}` : path
+}
+
+interface ShellResult {
+  code: number
+  stderr: string
+  stdout: string
+}
+
+/** Where the destination project lives on some gateway other than `target`. */
+function projectSourceFor(node: SidebarProjectTree | undefined): null | { connectionId: string; path: string } {
+  if (!node) {
+    return null
+  }
+
+  if (!isRemoteProjectId(node.id) && projectRootCwd(node)) {
+    return { connectionId: ownerGatewayId(projectRowOwner()), path: projectRootCwd(node) }
+  }
+
+  const fromId = node.id.match(/^gw:([^:]+):/)?.[1]
+
+  for (const [connectionId, entry] of remoteTrees) {
+    if (fromId && connectionId !== fromId) {
+      continue
+    }
+
+    const match = entry.projects.find(p => !p.archived && labelKey(p.label) === labelKey(node.label))
+    const path = projectRootCwd(match)
+
+    if (path) {
+      return { connectionId, path }
+    }
+  }
+
+  return null
+}
+
+async function sourceGitOrigin(source: { connectionId: string; path: string }): Promise<string> {
+  const self = ownerGatewayId(projectRowOwner())
+  const target: MoveTarget = { connectionId: source.connectionId, profile: null, remote: source.connectionId !== self }
+
+  if (target.remote) {
+    target.profile = normalizeProfileKey(
+      $connectionsRegistry.get()?.connections.find(c => c.id === source.connectionId)?.remoteProfile || 'default'
+    )
+  }
+
+  try {
+    const res = await moveTargetRequest<ShellResult>(target, 'shell.exec', {
+      command: `git -C ${shellPath(source.path)} remote get-url origin`
+    })
+
+    return res.code === 0 ? res.stdout.trim().split('\n')[0]?.trim() || '' : ''
+  } catch {
+    return ''
+  }
+}
+
+/**
+ * The destination project's root folder ON `target`, creating the project
+ * (and its folder) there when that gateway doesn't have it yet.
+ */
+async function ensureProjectRootOn(target: MoveTarget, node: SidebarProjectTree | undefined): Promise<string> {
+  if (!node || node.isNoProject) {
+    return ''
+  }
+
+  const profile = target.profile || (target.remote ? 'default' : writableProjectProfile())
+
+  // 1. The target already has it (same name — the merge key the sidebar uses).
+  const listed = await moveTargetRequest<ProjectsPayload>(target, 'projects.list', { profile })
+
+  const existing = (listed.projects ?? []).find(
+    p => !p.archived && (labelKey(p.name) === labelKey(node.label) || labelKey(p.slug) === labelKey(node.label))
+  )
+
+  const existingPath = existing?.primary_path || existing?.folders?.[0]?.path
+
+  if (existingPath) {
+    return existingPath
+  }
+
+  // 2. Create it there, at the source's home-relative folder.
+  const source = projectSourceFor(node)
+
+  if (!source) {
+    return ''
+  }
+
+  const path = homeRelativePath(source.path)
+  const word = shellPath(path)
+
+  const probe = await moveTargetRequest<ShellResult>(target, 'shell.exec', {
+    command: `test -d ${word} && echo present || echo missing`
+  })
+
+  if (probe.stdout.trim() !== 'present') {
+    const origin = await sourceGitOrigin(source)
+
+    const make = await moveTargetRequest<ShellResult>(target, 'shell.exec', {
+      command: origin
+        ? `mkdir -p "$(dirname ${word})" && git clone --quiet ${shellPath(origin)} ${word}`
+        : `mkdir -p ${word}`
+    })
+
+    if (make.code !== 0) {
+      throw new Error(`Could not create ${path} on ${target.connectionId}: ${(make.stderr || make.stdout).trim()}`)
+    }
+  }
+
+  const created = await moveTargetRequest<{ project: null | ProjectInfo }>(target, 'projects.create', {
+    name: node.label,
+    primary_path: path,
+    profile
+  })
+
+  if (target.remote) {
+    expireRemoteProjectTree(target.connectionId)
+  } else {
+    void refreshProjects()
+  }
+
+  return created.project?.primary_path || path
+}
+
 // Re-home a stored session into another project's root folder — the fix for a
 // chat created in the wrong directory. The backend replaces cwd + git identity
 // (so the tree's grouping follows) and re-anchors any live agent bound to the
@@ -947,9 +1142,20 @@ function consumeMoveFollowSuppression(cwd: string): boolean {
 export async function moveSessionToProject(
   sessionId: string,
   projectId: string,
-  profile?: null | string
+  profile?: null | string,
+  connectionId?: null | string
 ): Promise<void> {
-  const cwd = projectRootCwd($projectTree.get().find(node => node.id === projectId))
+  const node = $projectTree.get().find(n => n.id === projectId)
+  const target = moveTargetGateway(sessionId, profile, connectionId)
+
+  // [daveey] The session's OWN gateway does the move, and the destination is
+  // that gateway's copy of the project — created there (folder cloned if
+  // needed) when only another gateway has it. The fast path below is the
+  // original single-gateway behavior.
+  const cwd =
+    !target.remote && node && !isRemoteProjectId(node.id) && projectRootCwd(node)
+      ? projectRootCwd(node)
+      : await ensureProjectRootOn(target, node)
 
   if (!cwd) {
     throw new Error(translateNow('sidebar.projects.moveNoFolder'))
@@ -957,12 +1163,16 @@ export async function moveSessionToProject(
 
   suppressMoveFollow(cwd)
 
-  const res = await gatewayRequest<WorkspaceMovePayload>('session.workspace.move', {
+  const res = await moveTargetRequest<WorkspaceMovePayload>(target, 'session.workspace.move', {
     cwd,
     session_key: sessionId,
-    ...(profile ? { profile } : {})
+    ...(target.profile ? { profile: target.profile } : {})
   })
 
+  if (target.remote) {
+    expireRemoteProjectTree(target.connectionId)
+  }
+
   const moved = res.cwd || cwd
 
   if (moved !== cwd) {
@@ -992,7 +1202,12 @@ export function moveToProjectTargets(
   const cwd = session?.cwd?.trim() || ''
   const currentProjectId = cwd ? projectIdForCwd(cwd) : null
 
-  return tree.filter(node => node.id !== currentProjectId && !node.isNoProject && Boolean(projectRootCwd(node)))
+  // [daveey] Another gateway's project is a target too: the move creates it on
+  // the session's own gateway when needed.
+  return tree.filter(
+    node =>
+      node.id !== currentProjectId && !node.isNoProject && (Boolean(projectRootCwd(node)) || isRemoteProjectId(node.id))
+  )
 }
 
