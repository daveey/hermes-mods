From 20c99f7a674b20c86f93580f53809401cef6572e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 04:08:34 +0000
Subject: [PATCH] fix(shell): preserve parameter word delimiters in arithmetic
 [daveey]

Literal brackets and parentheses in parameter fallback or replacement words must not unwind enclosing arithmetic frames. Close parameter lexical frames only on their brace.

Proof: real Bash marker RED on prior head, 77 focused tests GREEN, 1624 family tests pass, and three exact-line recovery mutants killed. Addresses review 5901453801; no live Mac changes.
---
 tests/cron/test_lifecycle_guard_arith_parameter.py | 13 +++++++++++--
 tools/shell_arith_sink.py                          |  5 ++---
 2 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/tests/cron/test_lifecycle_guard_arith_parameter.py b/tests/cron/test_lifecycle_guard_arith_parameter.py
index 90d4177e57..557142b0a5 100644
--- a/tests/cron/test_lifecycle_guard_arith_parameter.py
+++ b/tests/cron/test_lifecycle_guard_arith_parameter.py
@@ -61,15 +61,20 @@ def test_parameter_data_and_closed_arithmetic_are_not_sinks(command, tmp_path):
     ("v/1/", "v=1;"), ("v//1/", "v=1;"),
     ("v/#1/", "v=1;"), ("v/%1/", "v=1;"),
     ("a[0]/1/", "a=(1);"),
+    ("v:-a[0] + ", "unset v; a=(0);"),
+    ("v:-(1) + ", "unset v;"),
+    ("v/1/a[0] + ", "v=1; a=(0);"),
+    ("v/1/(1) + ", "v=1;"),
     ("v/${w:-1}/", "v=1; unset w;"),
     ('v/"1"/', "v=1;"),
 ])
-def test_subscript_and_replacement_output_executes(tmp_path, parameter, prelude):
+@pytest.mark.parametrize("shape", ["x=$(( {word} ))", "x=$[{word}]"])
+def test_subscript_and_replacement_output_executes(tmp_path, parameter, prelude, shape):
     marker = tmp_path / "marker"
     big = tmp_path / "big.sh"
     big.write_text("# padding\n" * 130000 + f"printf RAN > {marker}\n", encoding="utf-8")
     value = "$(echo 'b[$(bash " + str(big) + ")]')"
-    command = prelude + "x=$(( ${" + parameter + value + "} ))"
+    command = prelude + shape.replace("{word}", "${" + parameter + value + "}")
     result = subprocess.run(
         ["/bin/bash"], input=command, text=True, encoding="utf-8", capture_output=True,
         timeout=20, check=False, env={"PATH": "/usr/bin:/bin", "HOME": str(tmp_path)},
@@ -91,6 +96,10 @@ def test_subscript_and_replacement_output_executes(tmp_path, parameter, prelude)
     'v=1; x=$(( ${v/"unused/$(printf unused)"/0} ))',
     "v=1; x=$(( ${v/unused/1} )); y=$(echo data)",
     "a=(1); x=$(( ${a[0]:-1} )); y=$(echo data)",
+    "unset v; x=${v:-a[0] + $(echo data)}",
+    "unset v; x=${v:-(1) + $(echo data)}",
+    "v=1; x=$[${v:-a[a[0]]}]; y=$(echo data)",
+    "v=1; x=$(( ${v:-(1)} )); y=$(echo data)",
 ])
 def test_replacement_pattern_and_subscript_controls(command, tmp_path):
     result = subprocess.run(
diff --git a/tools/shell_arith_sink.py b/tools/shell_arith_sink.py
index c7fe7ecf71..f1074c45f4 100644
--- a/tools/shell_arith_sink.py
+++ b/tools/shell_arith_sink.py
@@ -185,9 +185,8 @@ def _parameter_token(token, start, pos, stack) -> int:
         stack[-1][0] = _PARAM_ARITH
     elif token == "}":
         stack.pop()
-    elif token in (")", "]", "]]") and len(stack) > 1:
-        stack.pop()  # a parameter frame never closes on these: recover outward
-        return start
+    # Parentheses and brackets are literal parameter-word text, not closers
+    # for enclosing arithmetic. Only } ends this lexical frame.
     return pos
 
 
