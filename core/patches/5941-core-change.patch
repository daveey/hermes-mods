diff --git a/hermes_cli/fact_annotation_capture.py b/hermes_cli/fact_annotation_capture.py
new file mode 100644
index 0000000000..18db46a3fd
--- /dev/null
+++ b/hermes_cli/fact_annotation_capture.py
@@ -0,0 +1,198 @@
+"""Detached operational annotation inputs; called only by the feed owner. [daveey]
+
+Paths and profile identity come from authorized startup. No discovery, source
+publication or legacy annotation admission occurs in these capture functions.
+"""
+from contextlib import closing, contextmanager
+import json
+import os
+from pathlib import Path
+import stat
+import sqlite3
+import time
+
+from hermes_cli.fact_capture import CaptureBudgetExceeded
+
+
+@contextmanager
+def read_state(path, budget):
+    from hermes_state import _connect_tracked_db
+    from hermes_state_holders import read_only_db_uri
+    deadline = time.monotonic() + budget.max_seconds
+    with closing(_connect_tracked_db(read_only_db_uri(path), tracking_path=path,
+                                     uri=True, isolation_level=None, timeout=0)) as conn:
+        conn.execute('PRAGMA query_only=ON')
+        conn.setlimit(sqlite3.SQLITE_LIMIT_LENGTH, budget.max_bytes)
+        conn.set_progress_handler(lambda: int(time.monotonic() >= deadline), 1000)
+        conn.execute('BEGIN')
+        yield conn
+        if time.monotonic() >= deadline:
+            raise CaptureBudgetExceeded('annotation state capture deadline exceeded')
+
+
+def limited(cursor, budget):
+    rows = []
+    size = 0
+    for row in cursor:
+        size += len(repr(row).encode())
+        if len(rows) >= budget.max_keys or size > budget.max_bytes:
+            raise CaptureBudgetExceeded('annotation state capture exceeds inventory budget')
+        rows.append(tuple(row))
+    return rows
+
+
+def read_json(path, budget, *, absent):
+    try:
+        fd = os.open(path, os.O_RDONLY | getattr(os, 'O_NONBLOCK', 0) | getattr(os, 'O_NOFOLLOW', 0))
+    except FileNotFoundError:
+        return absent
+    with os.fdopen(fd, 'rb') as stream:
+        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
+            raise ValueError('annotation input must be a regular file')
+        raw = stream.read(budget.max_bytes + 1)
+    if len(raw) > budget.max_bytes:
+        raise CaptureBudgetExceeded('annotation file capture exceeds byte budget')
+    return json.loads(raw.decode('utf-8-sig'))
+
+
+def turns(path, budget, *, profile, gateway, now):
+    from hermes_cli import turn_session_activity as turns
+    from hermes_cli.turn_process_execution_observations import holder_digest
+    from tui_gateway.turn_marker import auto_continue_bounds
+    from hermes_cli.config_effective import load_profile_config_effective
+    due = [now + 30]
+    with read_state(path, budget) as conn:
+        tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'"
+                  " AND name IN ('session_turn_leases','state_meta','session_admissions','messages')")}
+        leases = limited(conn.execute(
+            'SELECT conversation_id,holder,acquired_at,expires_at FROM session_turn_leases'
+            ' WHERE expires_at > ? LIMIT ?', (now, budget.max_keys + 1)), budget) if 'session_turn_leases' in tables else []
+        live = set()
+        if {'state_meta', 'session_admissions', 'messages'} <= tables:
+            pauses = limited(conn.execute(
+                'SELECT a.target_session_id,m.value FROM state_meta m CROSS JOIN session_admissions a'
+                " ON a.admission_id=substr(m.key,?) WHERE m.key>=? AND m.key<? AND a.status='started' LIMIT ?",
+                (len(turns._GATEWAY_CHECKPOINT_PREFIX) + 1, turns._GATEWAY_CHECKPOINT_PREFIX,
+                 turns._GATEWAY_CHECKPOINT_END, budget.max_keys + 1)), budget)
+            for sid, raw in pauses:
+                try:
+                    receipt = json.loads(raw)
+                    message_id = int(receipt['max_message_id'])
+                except (ValueError, TypeError, KeyError):
+                    continue
+                stamp = conn.execute('SELECT timestamp FROM messages WHERE id=?', (message_id,)).fetchone()
+                if sid and stamp and stamp[0] is not None:
+                    expires = float(stamp[0]) + turns._GATEWAY_PAUSE_FRESH_S
+                    if now <= expires:
+                        live.add(str(sid))
+                        due.append(expires)
+    data = read_json(Path(path).parent / 'desktop/interrupted_turns.json', budget, absent={})
+    def bounds():
+        return auto_continue_bounds(load_profile_config_effective(Path(path).parent / 'config.yaml'))
+    live.update(turns.project_paused_tui_turns(data, bounds, now))
+    by_session = {}
+    for cid, holder, acquired, expires in leases:
+        if cid and not turns._holder_dead(str(holder or '')):
+            live.add(cid)
+            by_session.setdefault(cid, []).append({'conversation_id': cid, 'holder_digest': holder_digest(holder),
+                'acquired_at': acquired, 'expires_at': expires, 'profile': profile})
+            due.append(float(expires))
+    # Paused-turn eligibility is bounded by its producer policy. Reconcile its
+    # wall boundary as well as leases, without a request-time config read.
+    if isinstance(data, dict) and data:
+        _, fresh, _ = bounds()
+        for entry in data.values():
+            if isinstance(entry, dict):
+                try:
+                    due.append(max(float(entry.get(k) or 0) for k in ('started_at', 'parked_at', 'paused_at')) + fresh)
+                except (ValueError, TypeError):
+                    continue
+    return {'live': live, 'leases': by_session, 'gateway': gateway}, min((d for d in due if d > now), default=now + 30)
+
+
+def children(path, budget, *, profile, gateway, now):
+    from hermes_cli.subagent_session_activity import _WINDOW
+    with read_state(path, budget) as conn:
+        rows = limited(conn.execute(
+            "SELECT id,parent_session_id,last_activity_at,started_at FROM sessions"
+            " WHERE source='subagent' AND parent_session_id IS NOT NULL AND ended_at IS NULL"
+            ' AND started_at >= ? LIMIT ?', (now - _WINDOW, budget.max_keys + 1)), budget)
+    due = min((row[3] + _WINDOW for row in rows if row[3] + _WINDOW > now), default=now + 30)
+    return {'by_profile': {profile: (rows, None)}, 'gateway': gateway}, min(due, now + 30)
+
+
+def processes(path, budget, *, profile, gateway, now):
+    from hermes_cli import process_session_activity as activity
+    from tools.process_registry import process_registry
+    entries = read_json(path, budget, absent=[])
+    if not isinstance(entries, list):
+        raise ValueError('invalid process checkpoint')
+    if len(entries) > budget.max_keys:
+        raise CaptureBudgetExceeded('process checkpoint exceeds key budget')
+    owned, details, evidence = {}, {}, {}
+    if not process_registry._lock.acquire(timeout=budget.max_seconds):
+        raise CaptureBudgetExceeded('process registry lock capture deadline exceeded')
+    try:
+        if len(process_registry._running) > budget.max_keys:
+            raise CaptureBudgetExceeded('process registry exceeds key budget')
+        fields = ('session_key', 'pid_scope', 'pid', 'host_start_time', 'parent_session_id',
+                  'owner_task_id', 'task_id', 'id', 'command', 'started_at')
+        running = [{field: getattr(s, field) for field in fields}
+                   for s in process_registry._running.values() if not s.exited]
+    finally:
+        process_registry._lock.release()
+    for item in running:
+        recorded = activity._registry_profile(item['session_key'])
+        if recorded and recorded != profile:
+            continue
+        if item['pid_scope'] == 'host' and not activity._live(item['pid'], item['host_start_time']):
+            continue
+        owners = frozenset(activity._owner_ids(item))
+        proc_id = item['id']
+        evidence[proc_id] = {'id': proc_id, 'pid': item['pid'], 'host_start_time': item['host_start_time'],
+            'profile': recorded, 'pid_scope': item['pid_scope'], 'source': 'process.registry',
+            'observed_at': now, 'owners': owners}
+        details[proc_id] = activity._detail(proc_id, item['command'], item['started_at'], item['pid'])
+        for sid in owners:
+            owned.setdefault(sid, set()).add(proc_id)
+    for item in entries:
+        if not isinstance(item, dict) or item.get('pid_scope', 'host') != 'host':
+            continue
+        if not activity._live(item.get('pid'), item.get('host_start_time')):
+            continue
+        pid = str(item.get('session_id') or item.get('pid'))
+        owners = frozenset(activity._owner_ids(item))
+        evidence.setdefault(pid, {'id': item.get('session_id') or None, 'pid': item.get('pid'),
+            'host_start_time': item.get('host_start_time'), 'pid_scope': 'host', 'profile': profile,
+            'source': 'process.checkpoint', 'observed_at': now, 'owners': owners})
+        details.setdefault(pid, activity._detail(pid, item.get('command'), item.get('started_at'), item.get('pid')))
+        for sid in owners:
+            owned.setdefault(sid, set()).add(pid)
+    return {'owned': owned, 'details': details, 'evidence': evidence,
+            'gateway': gateway, 'local_profile': profile}, now + 30
+
+
+def reviews(path, budget, *, ids, now):
+    from hermes_cli import review_session_activity as review
+    messages, keys = {}, set()
+    if len(ids) > budget.max_keys:
+        raise CaptureBudgetExceeded('review lineage exceeds capture key budget')
+    size = 0
+    with read_state(path, budget) as conn:
+        for sid in sorted(ids):
+            row = conn.execute("SELECT id,content FROM messages WHERE session_id=? AND role='assistant'"
+                               " AND coalesce(content,'') <> '' ORDER BY id DESC LIMIT 1", (sid,)).fetchone()
+            size += len(str(row[1]).encode('utf-8')) if row else 0
+            if size > budget.max_bytes:
+                raise CaptureBudgetExceeded('review assistant evidence exceeds total byte budget')
+            message_keys = review.pr_keys(str(row[1])) if row else []
+            messages[sid] = (row[0] if row else -1, message_keys)
+            keys.update(message_keys)
+    # Provider lookup is the retained asynchronous bounded canonical owner. Its
+    # completion publication wakes our source; upstream TTL remains 300/120s.
+    values = [(key, review._pr_info(key)) for key in sorted(keys)]
+    due = [now + 30]
+    for _, value in values:
+        if value and value.get('requested_at') is not None:
+            due.append(value['requested_at'] + review.PARK_WINDOW_S)
+    return {'messages': messages, 'reviews': values}, min((d for d in due if d > now), default=now + 30)
diff --git a/hermes_cli/fact_annotation_sources.py b/hermes_cli/fact_annotation_sources.py
new file mode 100644
index 0000000000..4f68dedbde
--- /dev/null
+++ b/hermes_cli/fact_annotation_sources.py
@@ -0,0 +1,130 @@
+"""Native annotation adapters on the existing ChangeFeed, not a second cache. [daveey]"""
+import hashlib
+from pathlib import Path
+import threading
+import time
+
+from hermes_cli.fact_annotation_membership import AnnotationMembershipSource, MembershipCapture
+from hermes_cli.fact_capture import CaptureBudgetExceeded
+from hermes_cli.fact_content_owner import ContentOwner
+from hermes_cli.fact_contract import Fact, FactKey, freeze
+from hermes_cli.fact_source_watch import NativeSourceWatch
+from hermes_cli.fact_wire import encode
+
+
+class NativeAnnotationOwner(ContentOwner):
+    def __init__(self, engines, bindings, *, budget, operational=()):
+        for source in operational:
+            if isinstance(source, NativeAnnotationSource):
+                source.max_keys = budget.max_keys
+        super().__init__(engines, bindings, budget=budget, operational=operational)
+
+    def demand(self, scope, view, selector):
+        from hermes_cli.fact_annotation_views import selector_for
+        if scope not in self._demands:
+            raise ValueError('unauthorized annotation scope')
+        try:
+            valid = view.startswith('annotations.') and selector == selector_for(
+                scope, selector['row'], display=selector['display'])
+        except (AttributeError, KeyError, TypeError):
+            valid = False
+        if not valid:
+            raise ValueError('invalid annotation demand')
+        admit = lambda: super(NativeAnnotationOwner, self).demand(scope, view, selector)
+        if view == 'annotations.review':
+            for source, publisher in self._by_source.items():
+                if source.scope == scope and source.kind == view:
+                    publisher.demand(selector, admit=admit)
+                    return
+        admit()
+
+
+class NativeAnnotationSource(AnnotationMembershipSource):
+    """Capture off-request, then publish one immutable input + its derived views.
+
+    Review lineage is bounded demand membership, not a query on the caller. All
+    deadlines are monotonic; wall-clock evidence is recorded before the read.
+    """
+    def __init__(self, engine, source, paths, capture):
+        family = source.kind.removeprefix('annotations.')
+        if source.scope != engine.scope or family not in {'kanban', 'background', 'turn', 'subagent', 'review'}:
+            raise ValueError('invalid native annotation source')
+        if 'AnnotationInput' in engine._specs:
+            raise ValueError('annotation input cannot be a derived kind')
+        self.engine, self.source, self.family = engine, source, family
+        self.key = FactKey(engine.scope, 'AnnotationInput', family)
+        self.paths = tuple(Path(p).absolute() for p in paths)
+        self._capture = capture
+        self._watch = None
+        self._wake = None
+        self._ids = set()
+        self.max_keys = 2000
+        self._lock = threading.Lock()
+        self._unsubscribe = None
+        self._next_wall = 0
+
+    def watch(self, wake):
+        if self._watch is not None:
+            raise RuntimeError('annotation source already watched')
+        self._wake = wake
+        self._watch = NativeSourceWatch(self.paths, wake)
+        if self.family == 'review':
+            from hermes_cli.review_session_activity import subscribe_refresh
+            self._unsubscribe = subscribe_refresh(wake)
+        return self
+
+    def close(self):
+        if self._watch is not None:
+            self._watch.close()
+        if self._unsubscribe is not None:
+            self._unsubscribe()
+            self._unsubscribe = None
+
+    def demand(self, selector, *, admit=lambda: None):
+        if self.family != 'review':
+            raise ValueError('review demand sent to another annotation source')
+        row = selector['row']
+        ids = {row['id'], *(row.get('_lineage_ids') or ())}
+        if row.get('_lineage_root_id'):
+            ids.add(row['_lineage_root_id'])
+        with self._lock:
+            combined = self._ids | ids
+            if len(combined) > self.max_keys:
+                raise CaptureBudgetExceeded('review demand inventory exceeds key budget')
+            # The mailbox must accept before capture membership changes. Keep
+            # bounded rejected demand from poisoning all existing review views.
+            admit()
+            changed = combined != self._ids
+            self._ids = combined
+        if changed and self._wake is not None:
+            self._wake()
+
+    def capture(self, cursor, budget):
+        started, wall = time.monotonic(), time.time()
+        if self._watch is not None:
+            self._watch.check()
+        with self._lock:
+            ids = frozenset(self._ids)
+        value, due = self._capture(budget, wall, ids)
+        value = freeze(value)
+        raw = encode(value)
+        if len(raw) > budget.max_bytes or time.monotonic() - started >= budget.max_seconds:
+            raise CaptureBudgetExceeded('native annotation capture exceeds time/byte budget')
+        token = hashlib.sha256(raw).hexdigest()
+        if self._watch is not None:
+            self._watch.check()
+        if self._next_wall > wall:
+            due = min(due, self._next_wall)
+        return MembershipCapture(value, token, wall, started + min(30, max(0.001, due - wall)))
+
+    def commit(self, capture):
+        if capture.observed_at >= self._next_wall:
+            self.engine.publish([Fact(self.key, capture.value,
+                source_vector=((self.source, capture.after),), observed_at=capture.observed_at,
+                valid_until=capture.observed_at + 90, health='fresh')], now=capture.observed_at)
+            self._next_wall = capture.observed_at + max(0.001, capture.next_deadline - time.monotonic())
+        else:
+            super().commit(capture)
+            self._next_wall = min(self._next_wall, capture.observed_at + max(
+                0.001, capture.next_deadline - time.monotonic()))
+
diff --git a/hermes_cli/fact_annotation_startup.py b/hermes_cli/fact_annotation_startup.py
new file mode 100644
index 0000000000..6cfd3e05b3
--- /dev/null
+++ b/hermes_cli/fact_annotation_startup.py
@@ -0,0 +1,45 @@
+"""Startup custody and memory-only profile lookup for native annotations. [daveey]"""
+from types import MappingProxyType
+import threading
+
+from hermes_cli import kanban_annotation_facts as annotations
+
+_lock = threading.RLock()
+_registry = None
+
+
+class AnnotationRegistry:
+    """No discovery, capture or alternate view cache: only authorized handles."""
+    def __init__(self, bindings, fallback_profile):
+        self.bindings = MappingProxyType(dict(bindings))
+        if fallback_profile not in self.bindings or any(
+                name != binding.scope.profile_id for name, binding in self.bindings.items()):
+            raise ValueError('invalid annotation binding profile')
+        self.fallback_profile = fallback_profile
+        self._release = None
+
+    def select(self, profile=None):
+        return self.bindings.get(self.fallback_profile if profile is None else profile)
+
+    def install(self):
+        global _registry
+        with _lock:
+            if _registry is not None:
+                raise RuntimeError('annotation registry already installed')
+            self._release = annotations.install_lookup(self.select)
+            _registry = self
+        return self
+
+    def close(self):
+        global _registry
+        with _lock:
+            if _registry is self:
+                self._release()
+                _registry = None
+
+
+def binding_for(profile=None):
+    """Existing authorized v1 binding; a missing binding is never discovered."""
+    with _lock:
+        registry = _registry
+    return registry.select(profile) if registry is not None else None
diff --git a/hermes_cli/fact_annotation_views.py b/hermes_cli/fact_annotation_views.py
index c791e62fff..fc84c4a2b0 100644
--- a/hermes_cli/fact_annotation_views.py
+++ b/hermes_cli/fact_annotation_views.py
@@ -48,11 +48,81 @@ def _membership_projection(family, field, project, argument):
     return Projection('annotations.' + family, ('AnnotationInput',), dependencies, render)
 
 
+def _captured_projection(family, project):
+    from hermes_cli.kanban_annotation_facts import FIELDS, _thaw
+
+    def dependencies(scope, selector, snapshot):
+        if selector != selector_for(scope, selector['row'], display=selector['display']):
+            raise ValueError('invalid annotation selector')
+        return {FactKey(scope, 'AnnotationInput', family)}
+
+    def render(selector, facts, now):
+        captured = next(iter(facts.values())).value
+        row = dict(selector['row'])
+        project(row, captured, now)
+        fields = FIELDS[family] | {'execution_observations'}
+        return _thaw({key: value for key, value in row.items() if key in fields})
+
+    return Projection('annotations.' + family, ('AnnotationInput',), dependencies, render)
+
+
+def _kanban(row, captured, now):
+    from hermes_cli.kanban_activity_identity import row_ids
+    from hermes_cli.kanban_activity_projection import project_kanban_activity
+    from hermes_cli.kanban_external_activity import stamp_replica_counts
+    from hermes_cli.kanban_annotation_facts import _thaw
+    parts = list(captured['parts'])
+    if len(parts) > 11:
+        ids = set(row_ids(row))
+        parts[11] = _thaw({sid: values for sid, values in parts[11].items() if sid in ids})
+    project_kanban_activity([row], parts=parts, observed_at=captured['observed_at'],
+                            external=captured['external'], now=now)
+    stamp_replica_counts([row], captured['parts'][8], row_ids)
+
+
+def _background(row, captured, now):
+    from hermes_cli.process_session_activity import project_background_activity
+    project_background_activity([row], **captured, now=now)
+
+
+def _turn(row, captured, now):
+    from hermes_cli.turn_session_activity import project_turn_activity
+    from hermes_cli.turn_process_execution_observations import turn_from_digest
+
+    def project(lease, **kwargs):
+        return turn_from_digest(lease, digest=lease['holder_digest'], **kwargs)
+
+    project_turn_activity([row], **captured, now=now, lease_project=project)
+
+
+def _subagent(row, captured, now):
+    from hermes_cli.subagent_session_activity import project_subagent_activity
+    project_subagent_activity([row], **captured, now=now)
+
+
+def _review(row, captured, now):
+    from hermes_cli.review_session_activity import _row_ids, project_review_row
+    # Latest assistant message across exactly this lineage, not a union of PRs
+    # from older messages. Message IDs preserve the canonical SQLite ordering.
+    ids = _row_ids(row)
+    if any(sid not in captured['messages'] for sid in ids):
+        raise ValueError('review lineage not captured')
+    latest = max((captured['messages'][sid] for sid in ids),
+                 key=lambda item: item[0], default=(-1, ()))
+    info = {tuple(key): value for key, value in captured['reviews']}
+    if any(info.get(tuple(key)) is None for key in latest[1]):
+        raise ValueError('review provider pending or unavailable')
+    project_review_row(row, reviews=[(tuple(key), info[tuple(key)]) for key in latest[1]], now=now)
+
+
 def projections():
-    """Register captured goal/cron families, never silently empty other families."""
+    """All seven families consume detached captures, never legacy I/O readers."""
     from hermes_cli.goal_session_activity import project_goal_activity
     from hermes_cli.cron_session_activity import project_cron_activity
     return (
         _membership_projection('goal', 'goal_active', project_goal_activity, 'active'),
         _membership_projection('cron', 'cron_active', project_cron_activity, 'owners'),
+        *(_captured_projection(family, project) for family, project in (
+            ('kanban', _kanban), ('background', _background), ('turn', _turn),
+            ('subagent', _subagent), ('review', _review))),
     )
