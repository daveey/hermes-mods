Subject: [PATCH] test(kanban): cover attributed cron fixture cleanup scope
 [daveey]

---
 .../test_kanban_cron_fixture_cleanup.py       | 72 +++++++++++++++++++
 1 file changed, 72 insertions(+)
 create mode 100644 tests/hermes_cli/test_kanban_cron_fixture_cleanup.py

diff --git a/tests/hermes_cli/test_kanban_cron_fixture_cleanup.py b/tests/hermes_cli/test_kanban_cron_fixture_cleanup.py
new file mode 100644
index 00000000000..411d1bc77e2
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_cron_fixture_cleanup.py
@@ -0,0 +1,72 @@
+"""Cron acceptance attribution uses ordinary creator archive scope, never reporter identity."""
+from __future__ import annotations
+
+import json
+from argparse import Namespace
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli.kanban_db_connect import connect
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    path = tmp_path / "board.db"
+    monkeypatch.setenv("HERMES_KANBAN_DB", str(path))
+    monkeypatch.setenv("HERMES_KANBAN_BOARD", "default")
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.delenv("HERMES_DELEGATED_CHILD_CONTEXT", raising=False)
+    with connect(path) as conn:
+        owner = kb.create_task(conn, title="acceptance owner")
+        other = kb.create_task(conn, title="unrelated owner")
+        yield conn, owner, other
+
+
+def archive(entry, task_id):
+    if entry == "tool":
+        from tools import kanban_tools as kt
+        return json.loads(kt._handle_archive({"task_id": task_id})).get("ok") is True
+    from hermes_cli.kanban import _cmd_archive
+    return _cmd_archive(Namespace(task_ids=[task_id], purge_ids=[])) == 0
+
+
+def status(conn, task_id):
+    task = kb.get_task(conn, task_id)
+    assert task is not None
+    return task.status
+
+
+@pytest.mark.parametrize("entry", ["tool", "cli"])
+@pytest.mark.parametrize("state", ["unclaimed", "done", "running"])
+@pytest.mark.parametrize("attribution", ["owner", "other", "missing"])
+def test_acceptance_cleanup_obeys_creator_and_claim_scope(board, monkeypatch, entry, state, attribution):
+    conn, owner, other = board
+    creator = {"owner": owner, "other": other, "missing": None}[attribution]
+    fixture = kb.create_task(
+        conn, title="ACCEPTANCE FIXTURE historical replay; do not repair main",
+        body="Explicit cron acceptance fixture", created_by="nightly-e2e", creator_task_id=creator,
+    )
+    if state != "unclaimed":
+        assert kb.claim_task(conn, fixture)
+    if state == "done":
+        assert kb.complete_task(conn, fixture, summary="acceptance observed", force=True)
+    before = status(conn, fixture)
+    monkeypatch.setenv("HERMES_KANBAN_TASK", owner)
+    monkeypatch.setenv("HERMES_KANBAN_RUN_ID", "1")
+    allowed = attribution == "owner" and state != "running"
+    assert archive(entry, fixture) is allowed
+    assert status(conn, fixture) == ("archived" if allowed else before)
+    assert status(conn, other) == "ready"
+
+
+@pytest.mark.parametrize("entry", ["tool", "cli"])
+def test_nonworker_supervisor_can_archive_legacy_null_owner_fixture(board, monkeypatch, entry):
+    conn, _, _ = board
+    fixture = kb.create_task(conn, title="legacy cron fixture", created_by="nightly-e2e")
+    assert kb.claim_task(conn, fixture)
+    assert kb.complete_task(conn, fixture, summary="legacy acceptance finished", force=True)
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    monkeypatch.delenv("HERMES_KANBAN_RUN_ID", raising=False)
+    assert archive(entry, fixture)
+    assert status(conn, fixture) == "archived"
