From 4c4db9bb128a808515deb26925806d5f405a5a5d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 13:15:14 -0700
Subject: [PATCH] fix(doctor): gateway-supervision checks ask only whether s6
 is PID 1, never systemctl [daveey]

_check_gateway_service_linger and _check_s6_supervision used detect_service_manager() to learn
whether s6 was PID 1; in a container that falls through to supports_systemd_services() and runs
systemctl --user is-system-running, so plain `hermes doctor` called a service manager
(release run 40717630046, e2e-upgrade core, test_entrypoint_in_a_fresh_process[module-doctor]).
Both now ask _s6_running() directly.

Tests: tests/hermes_cli/test_doctor_supervision_no_service_probe.py (both red before); the
multiplex reporting tests now stub the s6 probe instead of detect_service_manager.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/doctor_platform.py                 | 10 ++--
 ...est_doctor_supervision_no_service_probe.py | 54 +++++++++++++++++++
 .../test_multiplex_host_topology_reporting.py |  6 +--
 3 files changed, 63 insertions(+), 7 deletions(-)
 create mode 100644 tests/hermes_cli/test_doctor_supervision_no_service_probe.py

diff --git a/hermes_cli/doctor_platform.py b/hermes_cli/doctor_platform.py
index ea75918596..43efbc3a70 100644
--- a/hermes_cli/doctor_platform.py
+++ b/hermes_cli/doctor_platform.py
@@ -184,10 +184,12 @@ def _check_s6_supervision(issues: list[str]) -> None:
     """Under our s6 /init, report static services and the ONE host gateway slot; no-op elsewhere.
     Counterpart to :func:`_check_gateway_service_linger` (systemd-on-host)."""
     try:
-        from hermes_cli.service_manager import S6ServiceManager, detect_service_manager
+        from hermes_cli.service_manager import S6ServiceManager, _s6_running
     except Exception:
         return
-    if detect_service_manager() != "s6":
+    # Only "is s6 PID 1?" matters here. detect_service_manager() would go on to probe
+    # `systemctl is-system-running` in containers, and doctor must not call a service manager.
+    if not _s6_running():
         return
     _section("s6 Supervision")
     mgr = S6ServiceManager()
@@ -262,10 +264,10 @@ def _check_gateway_service_linger(issues: list[str]) -> None:
         from hermes_cli.gateway import (
             _SERVICE_BASE, get_systemd_linger_status, get_systemd_unit_path, is_linux,
             user_systemd_unit_dir)
-        from hermes_cli.service_manager import detect_service_manager
+        from hermes_cli.service_manager import _s6_running
     except Exception as e:
         return check_warn("Gateway service linger", f"(could not import gateway helpers: {e})")
-    if not is_linux() or detect_service_manager() == "s6":
+    if not is_linux() or _s6_running():  # not detect_service_manager(): see _check_s6_supervision
         return
     host_unit = user_systemd_unit_dir() / f"{_SERVICE_BASE}.service"
     if not (get_systemd_unit_path().exists() or host_unit.exists()):
diff --git a/tests/hermes_cli/test_doctor_supervision_no_service_probe.py b/tests/hermes_cli/test_doctor_supervision_no_service_probe.py
new file mode 100644
index 0000000000..32986f1cac
--- /dev/null
+++ b/tests/hermes_cli/test_doctor_supervision_no_service_probe.py
@@ -0,0 +1,54 @@
+"""`hermes doctor`'s gateway-supervision checks never call a service manager.
+
+Regression (release run 40717630046, e2e-upgrade core, ``module-doctor``): in a container with no
+gateway unit installed, ``_check_gateway_service_linger`` and ``_check_s6_supervision`` each asked
+``detect_service_manager()`` whether s6 was PID 1, and that falls through to
+``supports_systemd_services()`` -> ``systemctl --user is-system-running``. Both checks only need
+the s6 answer, so they ask ``_s6_running()`` directly.
+"""
+
+import shutil
+
+import pytest
+
+
+@pytest.fixture
+def container_without_units(tmp_path, monkeypatch):
+    calls: list[list[str]] = []
+
+    def record(args, *a, **k):
+        calls.append(list(args))
+        raise RuntimeError("doctor called systemctl")
+
+    real_which = shutil.which
+    monkeypatch.setenv("HOME", str(tmp_path / "home"))
+    monkeypatch.setenv("XDG_CONFIG_HOME", str(tmp_path / "xdg"))
+    monkeypatch.setattr("hermes_cli.gateway.is_linux", lambda: True)
+    monkeypatch.setattr("hermes_cli.gateway.is_macos", lambda: False)
+    monkeypatch.setattr("hermes_cli.gateway.is_windows", lambda: False)
+    monkeypatch.setattr("hermes_cli.gateway.is_container", lambda: True)
+    monkeypatch.setattr("hermes_cli.gateway.is_wsl", lambda: False)
+    monkeypatch.setattr("hermes_cli.gateway.is_termux", lambda: False)
+    monkeypatch.setattr("hermes_cli.gateway.shutil.which",
+                        lambda name, *a, **k: "/usr/bin/systemctl" if name == "systemctl" else real_which(name, *a, **k))
+    monkeypatch.setattr("hermes_cli.gateway._run_systemctl", record)
+    monkeypatch.setattr("hermes_cli.service_manager._s6_running", lambda: False)
+    return calls
+
+
+def test_linger_check_does_not_probe_systemd(container_without_units):
+    from hermes_cli import doctor_platform
+
+    issues: list[str] = []
+    doctor_platform._check_gateway_service_linger(issues)
+    assert container_without_units == []
+    assert issues == []
+
+
+def test_s6_check_does_not_probe_systemd(container_without_units):
+    from hermes_cli import doctor_platform
+
+    issues: list[str] = []
+    doctor_platform._check_s6_supervision(issues)
+    assert container_without_units == []
+    assert issues == []
diff --git a/tests/hermes_cli/test_multiplex_host_topology_reporting.py b/tests/hermes_cli/test_multiplex_host_topology_reporting.py
index 51a40f7feb..67d7102cd8 100644
--- a/tests/hermes_cli/test_multiplex_host_topology_reporting.py
+++ b/tests/hermes_cli/test_multiplex_host_topology_reporting.py
@@ -77,7 +77,7 @@ def test_doctor_reports_the_single_host_gateway_not_per_profile_slots(served_hos
         def list_profile_gateways(self):
             return ["default", "served", "legacy"]
 
-    monkeypatch.setattr("hermes_cli.service_manager.detect_service_manager", lambda: "s6")
+    monkeypatch.setattr("hermes_cli.service_manager._s6_running", lambda: True)
     monkeypatch.setattr("hermes_cli.service_manager.S6ServiceManager", _Mgr)
     issues: list[str] = []
     doctor_platform._check_s6_supervision(issues)
@@ -103,7 +103,7 @@ def test_doctor_raises_an_issue_when_nothing_owns_the_gateway_role(served_host,
             return ["default", "served", "legacy"]
 
     monkeypatch.setattr("gateway.host_topology.host_gateway_topology", lambda: None)
-    monkeypatch.setattr("hermes_cli.service_manager.detect_service_manager", lambda: "s6")
+    monkeypatch.setattr("hermes_cli.service_manager._s6_running", lambda: True)
     monkeypatch.setattr("hermes_cli.service_manager.S6ServiceManager", _Mgr)
     issues: list[str] = []
     doctor_platform._check_s6_supervision(issues)
@@ -128,7 +128,7 @@ def test_doctor_checks_host_unit_linger_under_a_served_profile(served_host, tmp_
     else:
         monkeypatch.delenv("XDG_CONFIG_HOME", raising=False)
     monkeypatch.setattr("hermes_cli.gateway.is_linux", lambda: True)
-    monkeypatch.setattr("hermes_cli.service_manager.detect_service_manager", lambda: "systemd")
+    monkeypatch.setattr("hermes_cli.service_manager._s6_running", lambda: False)
     monkeypatch.setattr("hermes_cli.gateway.get_systemd_linger_status", lambda *a, **k: (False, "off"))
 
     issues: list[str] = []
