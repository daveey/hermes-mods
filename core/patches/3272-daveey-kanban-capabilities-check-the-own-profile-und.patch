From 625fef4c21a373aa2be8ed3f2667d584bed4dfa8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 08:21:10 +0000
Subject: [PATCH] [daveey] kanban capabilities: check the own profile under its
 launch secret scope

_profile_policy built the assignee's secrets from its profile files even when
the assignee is the process's own profile, while _bind_whole_profile binds
the launch secret scope there. Under multiplex semantics a scope miss is a
miss, so a managed ${VAR} in the terminal/config policy that only systemd or
op run injects did not resolve during the requires check, and the check
reported a capability the profile has as missing.

Build the scope with owner_secret_scope: the launch scope for the process's
own home, the profile's own files for any other home (unchanged, so a foreign
assignee still never sees the launch env). The bound-worker-scope behaviour
of #1987 is kept (test_profile_policy_resolves_inside_a_bound_worker_scope).

Follow-up from the exact-head review of PR #1987 (t_01a1d3f89c1e13c6).
---
 hermes_cli/kanban_capabilities.py            |  8 +++++--
 tests/hermes_cli/test_kanban_capabilities.py | 22 ++++++++++++++++++++
 2 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_capabilities.py b/hermes_cli/kanban_capabilities.py
index d34440240a..1152c49cfb 100644
--- a/hermes_cli/kanban_capabilities.py
+++ b/hermes_cli/kanban_capabilities.py
@@ -295,11 +295,12 @@ def _profile_policy(assignee: str):
     ``set_secret_scope`` moved a foreign assignee's scope back to the worker's own home, so every
     ``requires`` check from a worker failed as ``assignee_capability_mismatch`` (t_01a1d3dfcfabae47)."""
     from agent.runtime_scope import bind_state, scope_for_profile
-    from agent.secret_scope import _is_process_home, build_profile_secret_scope
+    from agent.secret_scope import _is_process_home
     from hermes_cli.config_backend import read_config_doc_readonly
     from hermes_cli.config_effective import load_profile_config_effective
     from hermes_cli.profiles import resolve_profile_env
     from tools.terminal_scope import build_profile_terminal_scope
+    from tui_gateway.launch_profile_policy import owner_secret_scope
 
     home = Path(resolve_profile_env(assignee))
     config_path = home / "config.yaml"
@@ -307,7 +308,10 @@ def _profile_policy(assignee: str):
     # shared loader. That is fine for startup, but cannot establish assignment authority.
     _check_policy_shape(read_config_doc_readonly(config_path))
     scope = scope_for_profile(home)
-    secrets = build_profile_secret_scope(home)
+    # The process's own profile reads its launch scope, as ``_bind_whole_profile`` binds it: a
+    # managed ``${VAR}`` that only systemd / ``op run`` injects has no file to rebuild from. Any
+    # other profile gets its own files only (t_01a1d3f89c1e13c6).
+    secrets = owner_secret_scope(home)
     # Unstamped marks the process's own profile, as the legacy setter left it; any other home is routed.
     stamp = not _is_process_home(home)
     with ExitStack() as stack:
diff --git a/tests/hermes_cli/test_kanban_capabilities.py b/tests/hermes_cli/test_kanban_capabilities.py
index 16ea21a8a8..b9afae09cf 100644
--- a/tests/hermes_cli/test_kanban_capabilities.py
+++ b/tests/hermes_cli/test_kanban_capabilities.py
@@ -188,6 +188,28 @@ def test_profile_policy_resolves_inside_a_bound_worker_scope(profiles, assignee)
         assert get_terminal_scope() is bound_terminal
 
 
+def test_own_profile_policy_resolves_launch_injected_refs(profiles, monkeypatch):
+    """A managed ``${VAR}`` that only the launch environment supplies (systemd ``Environment=``,
+    ``op run``) resolves when the process checks its OWN profile, as ``_bind_whole_profile`` binds
+    it; another profile still never sees the launch env (t_01a1d3f89c1e13c6). [daveey]"""
+    from agent import secret_scope
+    from tui_gateway import launch_profile_policy
+
+    monkeypatch.setenv("WORKER_TERMINAL_BACKEND", "local")
+    monkeypatch.setattr(launch_profile_policy, "_snapshot", None)  # this test's launch env
+    policy = "platform_toolsets: {cli: [terminal, file]}\nterminal: {backend: '${WORKER_TERMINAL_BACKEND}'}\n"
+    profiles("default", policy)
+    profiles("coder", policy)
+    token = secret_scope.set_multiplex_context(True)  # a multiplexing gateway: a scope miss is a miss
+    try:
+        assert validate_assignment("default", requires=["host_repo"]) == ["host_repo"]
+        with pytest.raises(CapabilityMismatchError) as caught:
+            validate_assignment("coder", requires=["host_repo"])
+        assert caught.value.missing == ["host_repo"]
+    finally:
+        secret_scope.reset_multiplex_context(token)
+
+
 def test_skill_names_are_not_guessed_as_capabilities(profiles):
     # Skill capability metadata has no established convention; do not infer from names/prose.
     assert validate_assignment("legacy", skills=["git", "terminal"]) == []
