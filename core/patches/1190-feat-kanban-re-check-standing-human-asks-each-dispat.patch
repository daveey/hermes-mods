 hermes_cli/kanban_db_dispatch.py            |  11 +-
 hermes_cli/kanban_wait_info.py              |   4 +-
 tests/hermes_cli/test_kanban_ask_recheck.py | 180 ++++++++++++++++++++
 4 files changed, 293 insertions(+), 9 deletions(-)
