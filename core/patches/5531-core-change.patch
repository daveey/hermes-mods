From 3297f586a101864c00a1cb1e1af79609e7ba9481 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 18:58:46 +0000
Subject: [PATCH] perf(kanban): skip exact history comparison for changed marks
 [daveey]

---
 plugins/kanban/dashboard/board_read.py        | 10 ++++++--
 .../test_kanban_materialization_reuse.py      | 25 +++++++++++++++++++
 2 files changed, 33 insertions(+), 2 deletions(-)

diff --git a/plugins/kanban/dashboard/board_read.py b/plugins/kanban/dashboard/board_read.py
index 9447940a59..6f5037d236 100644
--- a/plugins/kanban/dashboard/board_read.py
+++ b/plugins/kanban/dashboard/board_read.py
@@ -233,7 +233,8 @@ def _incremental_diag_inputs(conn, diag_rows: list, prev: dict, diagnostic_input
     """Retain event histories independently of task/run bookkeeping. ``event_changed``
     is the trusted P2 invalidation set: it marks every event insert, update and delete
     except inserts of ``UNREAD_EVENT_KINDS`` (heartbeats), which ``_unmarked_event_marks``
-    catches with index seeks, so a trusted refresh never scans retained histories.
+    catches with index seeks. Marked tasks compare exact history only when count/max
+    cannot already prove a change; unmarked tasks retain histories without scanning.
     Legacy callers without a cursor compare whole-history count/max plus the task row and
     runs (conservative). Clock/config rules stay fresh.
     """
@@ -242,7 +243,7 @@ def _incremental_diag_inputs(conn, diag_rows: list, prev: dict, diagnostic_input
     unmarked = _unmarked_event_marks(conn, ids)
     if trusted:  # memos built without unmarked marks fall back to whole-history marks
         marks = _event_marks(conn, [tid for tid in ids if tid in prev
-                                    and (len(prev[tid]) < 6 or prev[tid][5] is None)])
+                                    and (tid in event_changed or len(prev[tid]) < 6 or prev[tid][5] is None)])
     else:
         marks = _event_marks(conn, ids)
     runs = retained_runs(conn, ids, prev, event_changed, _rows_by_task)
@@ -253,6 +254,11 @@ def _incremental_diag_inputs(conn, diag_rows: list, prev: dict, diagnostic_input
             return True
         if trusted:
             if tid in event_changed:
+                # An append/delete is already known to differ: avoid scanning it
+                # once for equality and again to reload. Equal marks still need
+                # the exact comparison for same-ID edits and replacements.
+                if old[2] != marks.get(tid, _NO_EVENTS):
+                    return True
                 return not _same_events(conn, tid, old[3])
             if len(old) > 5 and old[5] is not None:
                 return old[5] != unmarked.get(tid)
diff --git a/tests/plugins/test_kanban_materialization_reuse.py b/tests/plugins/test_kanban_materialization_reuse.py
index e239e1ea5d..2aafcb3e47 100644
--- a/tests/plugins/test_kanban_materialization_reuse.py
+++ b/tests/plugins/test_kanban_materialization_reuse.py
@@ -30,6 +30,31 @@ def test_content_only_edit_retains_history_and_visible_payload(board, monkeypatc
     assert any(t['title'] == 'new title' for col in warm['columns'] for t in col['tasks'])
 
 
+@pytest.mark.parametrize('mutation', ['append', 'delete'])
+def test_changed_event_mark_skips_exact_scan(board, monkeypatch, mutation):
+    ids, _run = helpers._seed()
+    before = helpers._stable(helpers._read(board))
+    compared = []
+    original = board_read._same_events
+    monkeypatch.setattr(board_read, '_same_events',
+                        lambda c, tid, history: compared.append(tid) or original(c, tid, history))
+    conn = kbc.connect()
+    try:
+        if mutation == 'append':
+            conn.execute("INSERT INTO task_events (task_id, kind, payload, created_at) VALUES (?, 'test', '{}', 1)",
+                         (ids[0],))
+        else:
+            conn.execute('DELETE FROM task_events WHERE task_id = ?', (ids[0],))
+        conn.commit()
+    finally:
+        conn.close()
+    warm = helpers._stable(helpers._read(board))
+    assert ids[0] not in compared, 'known-changed histories must not pay an exact scan before reload'
+    assert warm != before
+    board_rows.clear()
+    assert warm == helpers._stable(helpers._read(board))
+
+
 @pytest.mark.parametrize('mutation', [
     "UPDATE task_events SET payload = 1.0 WHERE id = 1",
     "UPDATE task_events SET payload = NULL WHERE id = 1",
-- 
2.43.0

