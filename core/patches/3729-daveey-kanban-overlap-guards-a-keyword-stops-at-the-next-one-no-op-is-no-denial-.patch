From 16e847d897a67c38ffc9a16a1b3c26078f4cfdf7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 17:43:14 +0000
Subject: [PATCH] [daveey] kanban overlap guards: a keyword stops at the next
 one; no-op is no denial; a bumped counter is a re-issue; a moved index is an
 index

Follow-ups from exact-head review 5895179077 of PR #2429 (card t_01a1d5e98b0e7580):

1. Denial fail-open (kanban_dup_detector): an undenied keyword scanned 120 chars forward past a later denied
   keyword, so "Duplicate check: not a duplicate of t_X." and "Checked for duplicates: none, parent t_X."
   named t_X. The forward window now stops at the next duplicate/supersede keyword, and "none"/"0" right
   after a keyword ("duplicates: none", "Duplicates found: 0") denies it.
2. New false negative (same file): the two-word window after "no" denied "No-op as duplicate of t_X" and
   "Done with no changes as duplicate of t_X". The negator must now govern the keyword directly; only an
   article or hedge (a/an/the/as/really/considered/marked/...) may sit between.
3. Counter-bump fail-open (kanban_overlap_own): "Fix guard (attempt 2)" vs "(attempt 3)", "round 1" vs
   "round 2", "v2" vs "v3", "2nd attempt" vs "3rd attempt" read as enumerated fan-out. A number right after
   a re-issue word (attempt/round/retry/try/take/v/rev/pass/iteration), a vN/revN token, or an ordinal before
   one is a re-issue counter and never an enumeration marker.
4. Moved index refused (same file): "w1-01 sleep probe" vs "sleep probe w1-02" became delete + insert. A
   deleted marker paired with a differing inserted marker of the same shape (w1-01 -> a9-9, letter A/B) is
   an enumeration again; a marker only one title has (an added "round 2" or sha) is still a re-issue.

Proof: the 13 new cases fail on the parent (6 detector, 7 enumeration) and pass here; "Round 2: fix guard"
and "no further work, a duplicate" pin the other direction. All 15 files importing kanban_overlap /
kanban_dup_detector / create_overlap: 450 passed, 0 failed (the 3-completion replay still opens one card,
all 14 recorded fan-outs admitted, the round-2 and sha re-issues refused). scripts/check --base origin/main ok.
---
 hermes_cli/kanban_dup_detector.py             | 26 +++++++----
 hermes_cli/kanban_overlap_own.py              | 43 +++++++++++++++++--
 tests/hermes_cli/test_kanban_dup_detector.py  | 22 ++++++++++
 ...test_kanban_create_overlap_same_creator.py | 17 ++++++++
 4 files changed, 97 insertions(+), 11 deletions(-)

diff --git a/hermes_cli/kanban_dup_detector.py b/hermes_cli/kanban_dup_detector.py
index 6c5913911b..5e0ad83adc 100644
--- a/hermes_cli/kanban_dup_detector.py
+++ b/hermes_cli/kanban_dup_detector.py
@@ -29,10 +29,15 @@ _CARD = r"t_[0-9a-f]{8,16}"
 # "duplicate of t_X", "duplicates t_X", "DUPLICATE of t_X", "superseded by ... t_X", "Superseded: ... card t_X".
 _KEYWORD = re.compile(r"\b(?:duplicat\w*|supersed\w*)\b", re.IGNORECASE)
 _AFTER = re.compile(rf"[^.\n]{{0,120}}?\b({_CARD})\b")
-# A denial in the keyword's own clause, up to two words before it: "Not a duplicate of t_X", "No duplicates
-# found; parent t_X", "isn't a duplicate", "non-duplicate" (PR #2329 review). An earlier clause ("No code
-# changes; duplicate of t_X") does not deny it.
-_NEGATED = re.compile(r"\b(?:not|no|never|non|\w+n['\u2019]t)[\s-]+(?:[\w'\u2019]+\s+){0,2}$", re.IGNORECASE)
+# A denial that governs the keyword in its own clause: "Not a duplicate of t_X", "No duplicates found; parent
+# t_X", "isn't a duplicate", "non-duplicate", "0 duplicates" (PR #2329 review). Only an article or a hedge may
+# sit between, so "No-op as duplicate of t_X" and "no changes as duplicate of t_X" are not denials (PR #2429
+# review). An earlier clause ("No code changes; duplicate of t_X") does not deny it.
+_FILLER = r"(?:a|an|the|as|really|actually|truly|exactly|strictly|just|simply|considered|marked|being|been|be)"
+_NEGATED = re.compile(rf"(?:\b(?:not|no|never|non|zero|\w+n['\u2019]t)|(?<![\w.])0)[\s-]+(?:{_FILLER}\s+){{0,3}}$",
+                      re.IGNORECASE)
+# "Checked for duplicates: none", "Duplicates found: 0": a count of none right after the keyword.
+_NONE_AFTER = re.compile(r"\s*(?:found\s*)?[:=\-\u2013\u2014]?\s*(?:none|nil|zero|0)\b", re.IGNORECASE)
 _CLAUSE_END = re.compile(r"[.;:!?,\n]")
 
 
@@ -43,13 +48,18 @@ def _negated(text: str, start: int) -> bool:
 
 
 def sibling_named(text: str) -> list[str]:
-    """Card ids the text says this card duplicates or was superseded by, in order; a denied one is skipped."""
+    """Card ids the text says this card duplicates or was superseded by, in order; a denied one is skipped.
+
+    A keyword's forward window stops at the next keyword, so "Duplicate check: not a duplicate of t_X" is the
+    denied second keyword's, not the first one's (PR #2429 review)."""
     text = text or ""
     found = []
-    for kw in _KEYWORD.finditer(text):
-        if _negated(text, kw.start()):
+    keywords = list(_KEYWORD.finditer(text))
+    for i, kw in enumerate(keywords):
+        if _negated(text, kw.start()) or _NONE_AFTER.match(text, kw.end()):
             continue
-        card = _AFTER.match(text, kw.end())
+        stop = keywords[i + 1].start() if i + 1 < len(keywords) else len(text)
+        card = _AFTER.match(text, kw.end(), stop)
         if card:
             found.append(card.group(1))
     return list(dict.fromkeys(found))
diff --git a/hermes_cli/kanban_overlap_own.py b/hermes_cli/kanban_overlap_own.py
index 3b72e1053b..a1f9ba203b 100644
--- a/hermes_cli/kanban_overlap_own.py
+++ b/hermes_cli/kanban_overlap_own.py
@@ -103,20 +103,57 @@ def _title_tokens(title: str) -> list[str]:
     return [m.group(0) for m in _TOKEN.finditer(plain)]
 
 
+# A counter after one of these words numbers a re-issue of the same work, not a leg (PR #2429 review).
+_REISSUE_WORD = re.compile(r"(?:attempts?|rounds?|retry|retries|try|tries|take|v|rev|revision|pass|iteration)",
+                           re.IGNORECASE)
+_REISSUE_TOKEN = re.compile(r"(?:v|rev)\d+(?:\.\d+)*", re.IGNORECASE)  # "v2", "rev3"
+_ORDINAL = re.compile(r"\d+(?:st|nd|rd|th)", re.IGNORECASE)  # "2nd attempt"
+
+
+def _reissue_counter(tokens: list[str], i1: int, i2: int) -> bool:
+    """``tokens[i1:i2]`` holds a re-issue counter: a number right after a re-issue word (``attempt 2``,
+    ``round 1``), ``v3``, or an ordinal before one (``2nd attempt``)."""
+    for k in range(i1, i2):
+        tok = tokens[k]
+        if not _DIGIT_TOKEN.fullmatch(tok.lower()):
+            continue
+        if (_REISSUE_TOKEN.fullmatch(tok) or (k > 0 and _REISSUE_WORD.fullmatch(tokens[k - 1]))
+                or (_ORDINAL.fullmatch(tok) and k + 1 < len(tokens) and _REISSUE_WORD.fullmatch(tokens[k + 1]))):
+            return True
+    return False
+
+
+def _shape(marker: str) -> str:
+    """``w1-01`` -> ``a9-9``: two markers of one shape are the same index field."""
+    return re.sub(r"[a-z]+", "a", re.sub(r"\d+", "9", marker.lower()))
+
+
 def enumerated(title: str, theirs: str) -> Optional[tuple[frozenset[str], frozenset[str]]]:
     """``(mine, theirs)`` index markers that differ in the same place of both titles, else None.
 
     Only a replaced span counts, with a marker on both sides (``w1-01``/``w1-02``, ``1/3``/``3/3``, fixture
     ``A``/``B``, head ``5d2e512cbb``/``9baf8d8abc``). A marker only one title has (an added ``round 2``, an
-    appended sha, ``attempt 3``) is a re-issue of the same work, not a leg (PR #2329 review)."""
+    appended sha, ``attempt 3``) is a re-issue of the same work, not a leg (PR #2329 review), and so is a bumped
+    counter (``attempt 2``/``attempt 3``, ``round 1``/``round 2``, ``v2``/``v3``). A marker that moved (``w1-01
+    sleep probe``/``sleep probe w1-02``) is a deleted and an inserted span: it counts when both carry a marker of
+    the same shape (PR #2429 review)."""
     a, b = _title_tokens(title), _title_tokens(theirs)
     ops = SequenceMatcher(None, [t.lower() for t in a], [t.lower() for t in b], autojunk=False).get_opcodes()
+    deleted: set[str] = set()
+    inserted: set[str] = set()
     for tag, i1, i2, j1, j2 in ops:
-        if tag != "replace":
+        if tag == "equal" or _reissue_counter(a, i1, i2) or _reissue_counter(b, j1, j2):
             continue
         mine_m, their_m = markers(" ".join(a[i1:i2])), markers(" ".join(b[j1:j2]))
-        if mine_m and their_m and mine_m != their_m:
+        if tag == "replace" and mine_m and their_m and mine_m != their_m:
             return mine_m - their_m, their_m - mine_m
+        deleted |= mine_m if tag == "delete" else set()
+        inserted |= their_m if tag == "insert" else set()
+    moved = {_shape(m) for m in deleted} & {_shape(m) for m in inserted}
+    mine_m = frozenset(m for m in deleted - inserted if _shape(m) in moved)
+    their_m = frozenset(m for m in inserted - deleted if _shape(m) in moved)
+    if mine_m and their_m:
+        return mine_m, their_m
     return None
 
 
diff --git a/tests/hermes_cli/test_kanban_dup_detector.py b/tests/hermes_cli/test_kanban_dup_detector.py
index 7e1df326c1..1da019045a 100644
--- a/tests/hermes_cli/test_kanban_dup_detector.py
+++ b/tests/hermes_cli/test_kanban_dup_detector.py
@@ -95,6 +95,28 @@ def test_a_negation_in_an_earlier_clause_does_not_hide_a_duplicate():
     assert dd.sibling_named("No duplicates elsewhere, superseded by t_fedcba9876543210.") == ["t_fedcba9876543210"]
 
 
+@pytest.mark.parametrize("summary", [
+    "Duplicate check: not a duplicate of t_0123456789abcdef.",
+    "Checked for duplicates: none, parent t_0123456789abcdef.",
+    "Duplicates found: 0; parent t_0123456789abcdef owns the design.",
+    "Superseded check: wasn't superseded by t_0123456789abcdef.",
+])
+def test_a_keyword_does_not_reach_past_a_later_denied_keyword_or_a_none(summary):
+    """PR #2429 review: the forward window of an undenied keyword stops at the next keyword, and "none"/"0"
+    right after a keyword denies it."""
+    assert dd.sibling_named(summary) == []
+
+
+@pytest.mark.parametrize("summary", [
+    "No-op as duplicate of t_0123456789abcdef.",
+    "Done with no changes as duplicate of t_0123456789abcdef.",
+    "Closed with no further work, a duplicate of t_0123456789abcdef.",
+])
+def test_a_negator_that_does_not_govern_the_keyword_does_not_deny_it(summary):
+    """PR #2429 review: "no" denies only "no duplicate(s)" / "not a duplicate", not "no-op" or "no <noun> as"."""
+    assert dd.sibling_named(summary) == ["t_0123456789abcdef"]
+
+
 def test_a_closed_detector_card_lets_the_next_occurrence_open_a_new_one(conn):
     creator = kb.create_task(conn, title="creator", assignee="default")
     first, second = _pair(conn, creator)
