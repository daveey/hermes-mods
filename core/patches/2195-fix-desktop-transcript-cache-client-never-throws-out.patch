From 18fa9807a063c44cc2a3e182731505b7904c8908 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 05:54:08 +0000
Subject: [PATCH] fix(desktop): transcript cache client never throws out of
 call(); every worker call is bounded [daveey]

Review of 8326a7ded353: when the worker could not start and the
in-thread store could not open the file either, call() threw
synchronously. The renderer's sync read then never got its returnValue
(a hung renderer) and the fire-and-forget writes threw out of their IPC
listeners. call() now rejects, the failed open is remembered and logged
once, and the read answers null.

Worker calls without their own timeout now give up after 30 s, so a
worker stuck on the disk cannot leave a prefetch pass pending forever.

Test: a cache path SQLite cannot open on any thread; the sync read
answers null and the open is tried once. Fails without the catch.
---
 .../electron/transcript-cache-client.test.ts  | 30 +++++++++++++++
 .../electron/transcript-cache-client.ts       | 37 ++++++++++++-------
 2 files changed, 53 insertions(+), 14 deletions(-)

diff --git a/apps/desktop/electron/transcript-cache-client.test.ts b/apps/desktop/electron/transcript-cache-client.test.ts
index 179220ec75..787658db55 100644
--- a/apps/desktop/electron/transcript-cache-client.test.ts
+++ b/apps/desktop/electron/transcript-cache-client.test.ts
@@ -405,6 +405,36 @@ describe('[daveey] transcript cache host with a store worker', () => {
     host.stop()
   })
 
+  it('neither the worker nor the in-thread store can open the file: every call rejects, the sync read answers null', async () => {
+    const dir = fs.mkdtempSync(path.join(root, 'host-broken-'))
+    const logs: string[] = []
+    const on = new Map<string, (event: any, payload?: any) => void>()
+    // The cache path is a directory: SQLite cannot open it, on any thread.
+    fs.mkdirSync(path.join(dir, 'transcript-cache.sqlite'))
+
+    const host = installTranscriptCache({
+      backendFor: async (connectionId: string) => ({ connectionId }),
+      getJson: async () => ({}),
+      ipcMain: { handle: () => undefined, on: (channel: string, fn: any) => on.set(channel, fn) } as never,
+      log: line => logs.push(line),
+      registry: () => ({ connectionIds: ['local'], primary: 'local' }),
+      userDataDir: dir,
+      workerFile: path.join(root, 'absent.js')
+    })
+
+    clients.push(host.client)
+
+    const read = syncEvent()
+    on.get('hermes:transcript-cache:read')!(read.event, key) // must not throw out of the listener
+    expect(await read.replied).toBeNull()
+    on.get('hermes:transcript-cache:put')!({}, { key, kind: 'latest', messages: rows })
+    await expect(host.client.call('stats')).rejects.toThrow(/^transcript cache unavailable: /)
+    // Opened (and reported) once, not on every call.
+    expect(logs.filter(line => line.startsWith('transcript cache unavailable: '))).toHaveLength(1)
+    expect(logs.filter(line => line.startsWith('store worker unavailable'))).toHaveLength(1)
+    host.stop()
+  })
+
   it('the sync read always answers: null for a bad key, a miss, and a worker that cannot reply', async () => {
     const { host, logs, on } = install(() =>
       spawnSource(`require('node:worker_threads').parentPort.on('message', () => { throw new Error('disk gone') })`)
diff --git a/apps/desktop/electron/transcript-cache-client.ts b/apps/desktop/electron/transcript-cache-client.ts
index c1fcf3aaf8..4416851b38 100644
--- a/apps/desktop/electron/transcript-cache-client.ts
+++ b/apps/desktop/electron/transcript-cache-client.ts
@@ -81,6 +81,8 @@ export const WORKER_READY_LINE = 'store worker answering: cache I/O runs off the
 
 /** A store op slower than this is logged with where it ran. */
 export const SLOW_STORE_OP_MS = 250
+/** A worker call with no timeout of its own gives up (rejects) after this long. */
+export const CALL_TIMEOUT_MS = 30_000
 /** Worker (re)starts before the client gives up on it for the rest of the run. */
 export const MAX_WORKER_STARTS = 3
 
@@ -151,7 +153,7 @@ interface Pending {
   op: StoreOp
   reject: (error: Error) => void
   resolve: (value: any) => void
-  timer: null | ReturnType<typeof setTimeout>
+  timer: ReturnType<typeof setTimeout>
 }
 
 /**
@@ -170,6 +172,7 @@ export function workerClient(deps: {
   let nextId = 1
   let closed = false
   let inline: null | TranscriptCacheClient = null
+  let unusable: Error | null = null
   let announced = false
 
   const settle = (id: number): Pending | undefined => {
@@ -177,10 +180,7 @@ export function workerClient(deps: {
 
     if (entry) {
       pending.delete(id)
-
-      if (entry.timer) {
-        clearTimeout(entry.timer)
-      }
+      clearTimeout(entry.timer)
     }
 
     return entry
@@ -260,24 +260,33 @@ export function workerClient(deps: {
 
       // No worker: a start that threw (no retry: a missing worker file stays missing) or MAX_WORKER_STARTS deaths.
       if (!target) {
-        if (!inline) {
+        if (!inline && !unusable) {
           deps.log('store worker unavailable: the cache runs on the main thread for the rest of this run')
-          inline = deps.fallback()
+
+          try {
+            inline = deps.fallback()
+          } catch (error) {
+            // The file will not open here either (locked, corrupt): no cache this run. Every call rejects,
+            // none throws: the renderer's sync read must still get its answer.
+            unusable = new Error(`transcript cache unavailable: ${(error as Error)?.message || error}`)
+            deps.log(unusable.message)
+          }
         }
 
-        return inline.call<T>(op, args, opts)
+        return inline ? inline.call<T>(op, args, opts) : Promise.reject(unusable)
       }
 
       return new Promise<T>((resolve, reject) => {
         const id = nextId++
+        // Every call is bounded: a worker stuck on the disk must not leave a prefetch pass pending forever.
+        // Its late reply is dropped (the id is settled); the write itself still lands when the disk answers.
+        const timeoutMs = opts.timeoutMs ?? CALL_TIMEOUT_MS
 
-        const timer = opts.timeoutMs
-          ? setTimeout(() => {
-              settle(id)?.reject(new Error(`transcript cache ${op} timed out after ${opts.timeoutMs}ms`))
-            }, opts.timeoutMs)
-          : null
+        const timer = setTimeout(() => {
+          settle(id)?.reject(new Error(`transcript cache ${op} timed out after ${timeoutMs}ms`))
+        }, timeoutMs)
 
-        timer?.unref?.()
+        timer.unref?.()
         pending.set(id, { op, reject, resolve, timer })
 
         try {
