 tests/hermes_cli/test_kanban_card_answer_hardening.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_card_answer_hardening.py b/tests/hermes_cli/test_kanban_card_answer_hardening.py
index 61c628eda4..e27d4930a4 100644
--- a/tests/hermes_cli/test_kanban_card_answer_hardening.py
