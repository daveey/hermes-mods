@@ -282,19 +282,30 @@ class PtyHermes:
             raise AssertionError(f"hermes did not exit within {timeout:.0f}s of {command}\n{self.dump()}")
         return self.proc.returncode
 
-    def leftover_processes(self, timeout: float = 15.0) -> list[str]:
-        """Processes still alive in the child's session, or seen as its descendants, after exit.
+    def stop_gateway(self) -> None:
+        """End this sandbox's shared runtime after its viewer exits.
 
-        The profile's ``gateway run`` is not a leftover: ``hermes chat`` attaches to it and it
-        keeps serving (cron, messaging, the next client) after the client exits; ``close()`` still
-        tears it down with the rest of this harness's tree."""
+        /exit closes a viewer, not the gateway or its owner-death supervisor. End the actual
+        owner before asserting that its whole tree exited; never exempt the supervisor or
+        kill it directly, since it must remain alive to reap registered groups.
+        """
         from gateway.status import looks_like_gateway_command_line
 
+        assert self.proc.poll() is not None, "stop the viewer before its sandbox gateway"
+        for pid, started in self.seen_members:
+            if _start_time(pid) == started and looks_like_gateway_command_line(cmdline(pid)):
+                try:
+                    os.kill(pid, signal.SIGTERM)
+                except ProcessLookupError:
+                    pass
+
+    def leftover_processes(self, timeout: float = 15.0) -> list[str]:
+        """All tracked processes still alive after the viewer and sandbox runtime are stopped."""
         def alive() -> list[int]:
             pids = set(session_members(self.sid))
             # Same pid AND same start time: a recycled pid is not our leftover.
             pids |= {pid for pid, started in self.seen_members if _start_time(pid) == started}
-            return sorted(pid for pid in pids if not looks_like_gateway_command_line(cmdline(pid)))
+            return sorted(pids)
         try:
             poll(lambda: not alive(), timeout=timeout, what="the PTY session to empty")
         except AssertionError:
diff --git a/tests/e2e/core/terminal/test_pty_process_lifecycle.py b/tests/e2e/core/terminal/test_pty_process_lifecycle.py
new file mode 100644
index 00000000000..2227ade99a8
--- /dev/null
+++ b/tests/e2e/core/terminal/test_pty_process_lifecycle.py
@@ -0,0 +1,43 @@
+"""Sandbox teardown stops the real owner, and never hides surviving infrastructure."""
+from unittest.mock import MagicMock
+import signal
+
+import pytest
+
+from tests.e2e.core.terminal import _pty
+from hermes_cli.process_identity import _SUPERVISOR_SCRIPT
+
+pytestmark = pytest.mark.platforms("linux")
+
+
+def _inventory(monkeypatch, *, recycled=False):
+    gateway, supervisor, viewer = 42001, 42002, 42000
+    commands = {
+        gateway: "python -m hermes_cli.main gateway run --quiet --idle-exit",
+        supervisor: f"/bin/sh {_SUPERVISOR_SCRIPT} {gateway}",
+        viewer: "python -m hermes_cli.main chat --cli",
+    }
+    monkeypatch.setattr(_pty, "cmdline", lambda pid: commands[pid])
+    monkeypatch.setattr(_pty, "_start_time", lambda pid: 101 if recycled and pid == gateway else 100)
+    monkeypatch.setattr(_pty, "session_members", lambda sid: [])
+    term = object.__new__(_pty.PtyHermes)
+    term.proc = MagicMock(poll=MagicMock(return_value=0))
+    term.sid = viewer
+    term.seen_members = {(gateway, 100), (supervisor, 100), (viewer, 100)}
+    return term, gateway, supervisor
+
+
+@pytest.mark.parametrize("recycled", [False, True])
+def test_sandbox_shutdown_signals_only_its_live_gateway(monkeypatch, recycled):
+    term, gateway, _supervisor = _inventory(monkeypatch, recycled=recycled)
+    signals = []
+    monkeypatch.setattr(_pty.os, "kill", lambda pid, sig: signals.append((pid, sig)))
+    term.stop_gateway()
+    assert signals == ([] if recycled else [(gateway, signal.SIGTERM)])
+
+
+def test_exit_inventory_never_exempts_gateway_or_supervisor(monkeypatch):
+    term, gateway, supervisor = _inventory(monkeypatch)
+    leftovers = term.leftover_processes(timeout=0)
+    assert any(line.startswith(f"{gateway}:") for line in leftovers)
+    assert any(line.startswith(f"{supervisor}:") for line in leftovers)
