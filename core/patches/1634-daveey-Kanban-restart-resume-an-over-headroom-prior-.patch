 gateway/session_kanban_resume.py              |  97 +++++++++++++++--
 .../test_session_kanban_restart_resume.py     | 100 +++++++++++++++++-
 .../test_runtime_worker_compaction.py         |  11 ++
 4 files changed, 203 insertions(+), 9 deletions(-)

