From 2f26519116baab36e13c767d3242797dd0f6b2c0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 05:21:10 +0000
Subject: [PATCH] fix(tui_gateway): update-hold prompt.submit reply matches
 PromptSubmitResult; queued prompt replays after the update restart

---
 .../test_update_hold_submit_queue.py          | 39 +++++++++++++++++++
 tui_gateway/session_auto_continue.py          | 23 +++++++++--
 tui_gateway/turn_marker.py                    |  5 ++-
 3 files changed, 62 insertions(+), 5 deletions(-)

diff --git a/tests/tui_gateway/test_update_hold_submit_queue.py b/tests/tui_gateway/test_update_hold_submit_queue.py
index e1ce53494e..2ea3987dba 100644
--- a/tests/tui_gateway/test_update_hold_submit_queue.py
+++ b/tests/tui_gateway/test_update_hold_submit_queue.py
@@ -112,3 +112,42 @@ def test_without_a_hold_the_submit_is_admitted_normally(held, monkeypatch):
     resp = _submit()
     assert resp["result"]["status"] == "streaming"
     assert ran and not held.session.get("queued_prompt")
+
+
+def test_hold_reply_validates_as_prompt_submit_result(held):
+    """The reply is a wire reply: an extra field is rejected by the generated contract (t_01a186190e59f122)."""
+    from tui_gateway.contracts.prompt_voice import PromptSubmitResult
+    resp = _submit()
+    assert resp["result"] == {"status": "queued"}
+    assert PromptSubmitResult.model_validate(resp["result"]).status == "queued"
+
+
+def test_queued_hold_prompt_is_dispatched_after_the_update_restart(held, monkeypatch):
+    """The update restarts the backend while the hold is up: the in-memory queue is gone, the marker is not."""
+    from tui_gateway.turn_marker import read_turn_marker
+    _submit()
+    marker = read_turn_marker(held.home, "session-key")
+    assert marker and marker["reason"] == "update_hold_queue" and marker["prompt"] == "hello there"
+
+    # --- process restart: the old queue/timers vanish, the old writer pid is dead ---
+    held.timers.clear()
+    server._sessions.pop("sid", None)
+    af.clear_hold(held.home)
+    monkeypatch.setattr(server, "marker_writer_state", lambda entry: "dead")
+    reborn = {
+        "agent": types.SimpleNamespace(valid_tool_names=set()), "session_key": "session-key", "history": [],
+        "history_lock": threading.RLock(), "history_version": 0, "running": False, "transport": None,
+        "attached_images": [], "profile_home": str(held.home),
+    }
+    server._sessions["sid"] = reborn
+    ran = []
+    monkeypatch.setattr(server, "_start_session_work", lambda target, **kw: target() or True)
+    monkeypatch.setattr(server, "_start_agent_build", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_wait_agent", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_ensure_active_session_slot", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_adopt_stored_continuation_source", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_emit", lambda *a, **k: None)
+    monkeypatch.setattr(server, "_run_prompt_submit",
+                        lambda rid, sid, session, text, **kw: ran.append((text, kw.get("display_kind"))))
+    assert server._maybe_schedule_auto_continue("sid", reborn, "session-key") is not None
+    assert ran == [("hello there", None)], "the user's own text, verbatim, not an auto-continue note"
diff --git a/tui_gateway/session_auto_continue.py b/tui_gateway/session_auto_continue.py
index c6eee151a0..b0d272c5a0 100644
--- a/tui_gateway/session_auto_continue.py
+++ b/tui_gateway/session_auto_continue.py
@@ -138,6 +138,9 @@ def _adopt_stored_continuation_source(sid: str, session: dict, session_key: str)
         _clear_session_context(tokens)
 
 
+UPDATE_HOLD_QUEUE_REASON = "update_hold_queue"
+
+
 def _maybe_schedule_auto_continue(sid: str, session: dict, session_key: str) -> dict | None:
     """Kick off a continuation turn for a crash-interrupted session (session.resume cold paths). Returns a descriptor
     for the resume payload when scheduled, else None. The turn runs on a background thread after the deferred agent
@@ -179,7 +182,11 @@ def _maybe_schedule_auto_continue(sid: str, session: dict, session_key: str) ->
         session["_auto_continue_scheduled"] = True
     # [daveey] A core-update pause is not a crash: no attempt is used and the note says the step finished.
     paused = marker.get("reason") == "core_update_pause"
-    if paused:
+    # A prompt accepted behind the update hold never started: replay it verbatim, no attempt used, no note.
+    held = marker.get("reason") == UPDATE_HOLD_QUEUE_REASON
+    if held:
+        attempt, text = marker["attempts"], marker["prompt"]
+    elif paused:
         from tui_gateway.update_pause import pause_note
         attempt, text = marker["attempts"], pause_note(marker["prompt"], marker.get("killed_jobs"))
     elif receipt:
@@ -237,12 +244,13 @@ def _maybe_schedule_auto_continue(sid: str, session: dict, session_key: str) ->
             diagnostic = marker.get("notification_category") == "diagnostic"
             with _session_profile_runtime_scope(session):
                 def announce():
-                    _emit("status.update", sid, {"kind": "process", "text": "Resuming paused turn…" if paused
+                    _emit("status.update", sid, {"kind": "process", "text": "Sending your queued message…" if held
+                                                 else "Resuming paused turn…" if paused
                                                  else "Reporting stopped background jobs…" if receipt
                                                  else "Resuming interrupted turn…"})
                     _emit("message.start", sid)
                 render_notification(announce, platform="tui", diagnostic=diagnostic)
-                _run_prompt_submit(rid, sid, session, text, display_kind="auto_continue",
+                _run_prompt_submit(rid, sid, session, text, display_kind=None if held else "auto_continue",
                     **({"display_metadata": {"notification_category": "diagnostic"}} if diagnostic else {}))
         except Exception as exc:
             _notif_log_failure("auto-continue dispatch failed", exc)
@@ -597,11 +605,18 @@ def _queue_submit_behind_update_hold(rid, sid: str, session: dict, text: Any, tr
         if envelope is not None:
             _persist_queued_user_row(session, envelope, display_kind)
         session["last_active"] = time.time()
+        # Durable replay: the in-memory queue dies with this process when the update restarts the backend
+        # (and the accept row is retired on the next resume), so journal the merged text as a turn marker
+        # that the post-restart ``session.resume`` replays through auto-continue.
+        if envelope is not None and (queued_now := session.get("queued_prompt")):
+            from tui_gateway.turn_marker import record_turn_start
+            record_turn_start(_session_home(session), str(session.get("session_key") or ""),
+                              str(queued_now.get("text") or text), reason=UPDATE_HOLD_QUEUE_REASON)
         if not retry_queued_prompt(rid, sid, session) and session.get("queued_prompt"):
             # Retirement raced in between: the queue is the client's to replay; keep the 5035.
             logger.info("update-hold queue for session %s: retry unavailable, kept queued", sid)
     logger.info("prompt.submit for session %s queued behind the core-update admission hold", sid)
-    return _ok(rid, {"status": "queued", "reason": "update_hold"})
+    return _ok(rid, {"status": "queued"})
 
 
 def _drain_queued_prompt(rid, sid: str, session: dict) -> bool:
diff --git a/tui_gateway/turn_marker.py b/tui_gateway/turn_marker.py
index 509d390065..640e12ea71 100644
--- a/tui_gateway/turn_marker.py
+++ b/tui_gateway/turn_marker.py
@@ -116,7 +116,8 @@ def _update(home: Path | str, session_key: str, mutate, what: str) -> bool:
 
 def record_turn_start(home: Path | str, session_key: str, prompt: str, *, attempts: int = 0,
                       auto_continue: bool = True, notification_category: str | None = None,
-                      pauses: int = 0, killed_jobs: list | None = None, until_tool: bool = False) -> None:
+                      pauses: int = 0, killed_jobs: list | None = None, until_tool: bool = False,
+                      reason: str | None = None) -> None:
     """Persist the marker for a turn that is about to run. ``attempts`` = how many auto-continues led to
     this run (0 for a user-initiated turn); the crash-loop breaker reads it back on the next resume.
     ``pauses`` = core-update pauses this logical turn already took (``mark_turn_paused``), counted apart
@@ -135,6 +136,8 @@ def record_turn_start(home: Path | str, session_key: str, prompt: str, *, attemp
         entry["until_tool"] = True
     if notification_category == "diagnostic":
         entry["notification_category"] = notification_category
+    if reason:
+        entry["reason"] = str(reason)
     # Identity only — never the prompt: this log is read on crash triage and must not carry turn content.
     logger.debug("turn marker recorded for session %s by writer pid %s", session_key, entry["writer_pid"])
     _update(home, session_key, lambda entries: {**_prune(entries, now), session_key: entry}, "record")
