From 045c0d31c046b68690e2e3a924a519df73753127 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 20:47:10 +0000
Subject: [PATCH] fix(tests): make heredoc execution oracle independent of GNU
 timeout [daveey]

The macOS OS-marked run 43870599724 failed 20 generated execution
cases because the isolated PATH contains only the fixture directory and
os.defpath, and stock macOS has no timeout command there. The real Bash
oracle failed with exit 127 or no RUN marker before checking the guard.

Supply a fixture-local timeout wrapper double that validates the fixed
5-second argument and execs the actual consumer. The test concerns shell
wrapper classification and real heredoc execution, not GNU timeout's
implementation; subprocess.run still bounds the oracle at 10 seconds.
No scanner behavior, assertions, platform coverage or skips change.

Proof: original native run fails with timeout: command not found;
hermes-core-wt test tests/cron/test_lifecycle_guard_login_heredoc_data.py:
113 passed. scripts/check --base origin/main: all 20 checks pass.
Task: t_23239f90cf6c9679
---
 tests/cron/test_lifecycle_guard_login_heredoc_data.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/tests/cron/test_lifecycle_guard_login_heredoc_data.py b/tests/cron/test_lifecycle_guard_login_heredoc_data.py
index d0ee1648414a296fa657c6bd3fbca205a97b4b38..f2470b049256b7ec8f8f54d62f45546b5cf32526 100644
--- a/tests/cron/test_lifecycle_guard_login_heredoc_data.py
+++ b/tests/cron/test_lifecycle_guard_login_heredoc_data.py
@@ -66,6 +66,11 @@ def test_generated_real_bash_execution_is_refused(tmp_path, shell, consumer, sha
     fake = tmp_path / "hermes"
     fake.write_text('#!/bin/sh\nprintf RUN\\n\n')
     fake.chmod(0o755)
+    # Exercise wrapper peeling, not GNU timeout (absent on stock macOS).
+    # The real Bash oracle remains bounded by subprocess.run(timeout=10).
+    timeout = tmp_path / "timeout"
+    timeout.write_text('#!/bin/sh\n[ "$1" = 5 ] || exit 2\nshift\nexec "$@"\n')
+    timeout.chmod(0o755)
     danger = tmp_path / "danger.sh"
     danger.write_text('hermes gateway "restart"\n')
     payload = f"bash {danger}"
-- 
2.43.0

