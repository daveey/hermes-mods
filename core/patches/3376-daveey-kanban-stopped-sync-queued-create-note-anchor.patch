From a50418a532abaef3308af12f8b28ebd97c9b9a90 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:16:39 +0000
Subject: [PATCH] [daveey] kanban: stopped-sync queued create note anchors on
 an exact head constant, not rstrip

Review 5889250891 (PR #2070): _chat_link_queued found its insertion point with
CHAT_TASKS_QUEUED.rstrip(", "), which strips a character set, so queued wording
ending in ": " kept its colon before " once this gateway's Board sync recovers".

CHAT_TASKS_QUEUED is replaced by CHAT_TASKS_HEAD + CHAT_TASKS_SEP; kanban_tools
builds the note from both and the rewrite inserts right after the exact head.

Proof: tests/tools/test_kanban_board_delivery.py::
test_queued_rewrite_lands_after_the_exact_head_for_any_separator (head/sep
patched to "(see this chat's tasks" / ": "). RED at 5e308b9182: note read
"(see this chat's tasks: once ... recovers, ". GREEN: 341 passed across the
4 test files asserting this note's wording.
---
 tests/tools/test_kanban_board_delivery.py | 17 ++++++++++++++++-
 tools/kanban_tools.py                     |  2 +-
 tools/kanban_tools_board_delivery.py      |  8 +++++---
 3 files changed, 22 insertions(+), 5 deletions(-)

diff --git a/tests/tools/test_kanban_board_delivery.py b/tests/tools/test_kanban_board_delivery.py
index 669738d963..eaa75d8294 100644
--- a/tests/tools/test_kanban_board_delivery.py
+++ b/tests/tools/test_kanban_board_delivery.py
@@ -353,7 +353,7 @@ def test_create_note_wording_and_its_stopped_sync_rewrite_share_one_source(home,
     there made it silently do nothing. Reworded at the one source, the rewrite still lands."""
     from tools import kanban_tools_board_delivery as kbd
     monkeypatch.setattr(kbd, "CHAT_TASKS_SHOWS", " and is listed under this chat")
-    monkeypatch.setattr(kbd, "CHAT_TASKS_QUEUED", "(listed under this chat, ")
+    monkeypatch.setattr(kbd, "CHAT_TASKS_HEAD", "(listed under this chat")
     path, _conn = home
     _give_up_the_sync_role(path, monkeypatch)
     out = _place_on_worker(path, monkeypatch, task_id=task_id)
@@ -364,6 +364,21 @@ def test_create_note_wording_and_its_stopped_sync_rewrite_share_one_source(home,
     assert "this chat's tasks" not in out["note"]
 
 
+def test_queued_rewrite_lands_after_the_exact_head_for_any_separator(home, monkeypatch):
+    """Review 5889250891: the anchor was the queued wording .rstrip(", "), a character set, so wording ending in
+    ": " kept its colon before the inserted text. The rewrite now goes right after the exact head constant."""
+    from tools import kanban_tools_board_delivery as kbd
+    monkeypatch.setattr(kbd, "CHAT_TASKS_HEAD", "(see this chat's tasks")
+    monkeypatch.setattr(kbd, "CHAT_TASKS_SEP", ": ")
+    path, _conn = home
+    _give_up_the_sync_role(path, monkeypatch)
+    out = _place_on_worker(path, monkeypatch, task_id=None)
+    assert out["chat_link"] == "queued_local", out
+    later = "once this gateway's Board sync recovers"
+    assert f"(see this chat's tasks {later}: `hermes-hub requests`)" in out["note"], out["note"]
+    assert f": {later}" not in out["note"]
+
+
 def test_create_placed_elsewhere_while_the_sync_runs_is_unchanged(home, monkeypatch):
     path, _conn = home
     out = _place_on_worker(path, monkeypatch, task_id="t_01a1d42acdce8e23")
diff --git a/tools/kanban_tools.py b/tools/kanban_tools.py
index ed7e526ff4..87ae9d8645 100644
--- a/tools/kanban_tools.py
+++ b/tools/kanban_tools.py
@@ -1530,7 +1530,7 @@ def _place_remote(args: dict, *, assignee: str, skills, parents, project_id, ses
                 f"card from it (it runs there, not here: {decision['why']}). Do NOT call kanban_create again "
                 "for this card: an identical call returns this same request. Changed calls with an explicit "
                 f"creation key are refused; without one they may duplicate. Its task id appears when {target} applies it "
-                + (kbd_words.CHAT_TASKS_QUEUED if session_id else "(")
+                + (kbd_words.CHAT_TASKS_HEAD + kbd_words.CHAT_TASKS_SEP if session_id else "(")
                 + "`hermes-hub requests`).")
         return _ok(task_id=None, status="queued", **fields, runs_where=target, note=note), None
     except Exception as exc:
diff --git a/tools/kanban_tools_board_delivery.py b/tools/kanban_tools_board_delivery.py
index 401ece04ab..79307ab73a 100644
--- a/tools/kanban_tools_board_delivery.py
+++ b/tools/kanban_tools_board_delivery.py
@@ -17,9 +17,11 @@ BOARD_WRITE_TOOLS = frozenset({
 # A create placed on another gateway for this chat: the card is made there, but this chat's link row reaches the
 # Board only through this gateway's sync (01:09 PT: four cards placed on workers said "shows in this chat's tasks";
 # the Board had no task_chat_links row for any of them).
-# kanban_tools builds its placed-create notes from these two fragments, so the rewrite below always finds them.
+# kanban_tools builds its placed-create notes from these fragments, so the rewrite below always finds them. The
+# queued note is CHAT_TASKS_HEAD + CHAT_TASKS_SEP; the rewrite inserts after the exact head, whatever the separator.
 CHAT_TASKS_SHOWS = " and shows in this chat's tasks"
-CHAT_TASKS_QUEUED = "(this chat's tasks, "
+CHAT_TASKS_HEAD = "(this chat's tasks"
+CHAT_TASKS_SEP = ", "
 _LATER = " once this gateway's Board sync recovers"
 
 
@@ -33,7 +35,7 @@ def _chat_link_queued(payload: dict, board_sync: str) -> None:
     from hermes_cli.kanban_board_delivery import QUEUED_LOCAL
     text = str(payload.get("note") or "")
     text = text.replace(CHAT_TASKS_SHOWS, CHAT_TASKS_SHOWS + _LATER, 1).replace(
-        CHAT_TASKS_QUEUED, CHAT_TASKS_QUEUED.rstrip(", ") + _LATER + ", ", 1)
+        CHAT_TASKS_HEAD + CHAT_TASKS_SEP, CHAT_TASKS_HEAD + _LATER + CHAT_TASKS_SEP, 1)
     payload["note"] = f"{text} This chat's link to the card is {board_sync}."
     payload["chat_link"] = QUEUED_LOCAL
     payload["board_sync"] = board_sync
