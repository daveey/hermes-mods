From bbb6290077ad3dccfd04f6a016c2998cf25eb969 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 00:27:53 -0700
Subject: [PATCH] fix(lint): Windows footguns in kanban_provider_walls and
 core_update_drain (#107)

Co-authored-by: daveey <daveey@users.noreply.github.com>
---
 agent/core_update_drain.py          | 15 ++++-----------
 hermes_cli/kanban_provider_walls.py |  4 ++--
 2 files changed, 6 insertions(+), 13 deletions(-)

diff --git a/agent/core_update_drain.py b/agent/core_update_drain.py
index e4979ffa5e..2186b3c4ab 100644
--- a/agent/core_update_drain.py
+++ b/agent/core_update_drain.py
@@ -14,7 +14,6 @@ from __future__ import annotations
 
 import json
 import logging
-import os
 import threading
 import time
 from pathlib import Path
@@ -30,15 +29,9 @@ _logged: set[str] = set()
 
 
 def _pid_alive(pid: int) -> bool:
-    try:
-        os.kill(pid, 0)
-    except ProcessLookupError:
-        return False
-    except PermissionError:
-        return True
-    except OSError:
-        return False
-    return True
+    import psutil
+
+    return psutil.pid_exists(pid)
 
 
 def hold_paths() -> list[Path]:
@@ -56,7 +49,7 @@ def hold_paths() -> list[Path]:
 def read_hold(path: Path, now: Optional[float] = None) -> Optional[dict]:
     """The hold record when ``path`` is an active hold, else None."""
     try:
-        raw = path.read_text(encoding="utf-8")
+        raw = path.read_text(encoding="utf-8-sig")
         st = path.stat()
     except (FileNotFoundError, NotADirectoryError):
         return None
diff --git a/hermes_cli/kanban_provider_walls.py b/hermes_cli/kanban_provider_walls.py
index 7cd8414e17..6cd0b0adb4 100644
--- a/hermes_cli/kanban_provider_walls.py
+++ b/hermes_cli/kanban_provider_walls.py
@@ -40,7 +40,7 @@ def walls_path() -> Path:
 
 def _load(path: Optional[Path] = None) -> dict[str, float]:
     try:
-        data = json.loads((path or walls_path()).read_text())
+        data = json.loads((path or walls_path()).read_text(encoding="utf-8-sig"))
         return {str(k): float(v) for k, v in data.items()}
     except Exception:
         return {}
@@ -87,7 +87,7 @@ def record_wall(provider: str, retry_after: Optional[int], *, now: Optional[floa
     try:
         p.parent.mkdir(parents=True, exist_ok=True)
         tmp = p.with_suffix(".tmp")
-        tmp.write_text(json.dumps(walls))
+        tmp.write_text(json.dumps(walls), encoding="utf-8")
         tmp.replace(p)
     except OSError as exc:
         logger.warning("kanban walls: cannot write %s (%s)", p, exc)
-- 
