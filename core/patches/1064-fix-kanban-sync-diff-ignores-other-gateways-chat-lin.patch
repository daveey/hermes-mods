---
 hermes_cli/kanban_sync_client.py              | 16 ++++-
 .../test_kanban_sync_foreign_chat_links.py    | 64 +++++++++++++++++++
 2 files changed, 77 insertions(+), 3 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_sync_foreign_chat_links.py

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index 809d9c9eafb..30b6a7dcca8 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -1020,9 +1020,19 @@ def _task_rows(conn: sqlite3.Connection, ids: Optional[set[str]] = None) -> dict
     return out
 
 
-def _child_uids(conn: sqlite3.Connection, table: str, task_ids: set[str]) -> set[tuple[str, str]]:
+def _child_uids(conn: sqlite3.Connection, table: str, task_ids: set[str],
+                gateway: Optional[str] = None) -> set[tuple[str, str]]:
+    """Child row uids of ``task_ids``. With ``gateway``, chat links of OTHER gateways' chats on a card created
+    elsewhere are left out: a picked-up copy of a foreign card carries no chat links (``import_cards`` copies
+    only runs/comments/attachments/events, and the creator's chats are read from the replica), so counting them
+    made every running foreign copy a permanent ``task_chat_links`` mismatch with nothing in flight."""
     if table == "task_links":
         return {(p, f"{p}>{c}") for p, c in conn.execute("SELECT parent_id, child_id FROM task_links") if c in task_ids}
+    if table == "task_chat_links" and gateway is not None:
+        rows = conn.execute(
+            "SELECT l.task_id, l.uid FROM task_chat_links l LEFT JOIN tasks t ON t.id = l.task_id WHERE l.uid IS NOT NULL "
+            "AND NOT (t.created_on IS NOT NULL AND t.created_on != ?1 AND COALESCE(l.chat_gateway, '') != ?1)", (gateway,))
+        return {(t, u) for t, u in rows if t in task_ids}
     return {(t, u) for t, u in conn.execute(f"SELECT task_id, uid FROM {table} WHERE uid IS NOT NULL") if t in task_ids}
 
 
@@ -1053,8 +1063,8 @@ def diff(live: sqlite3.Connection, shadow: sqlite3.Connection, gateway: str) ->
             fields[tid] = bad
     children: dict[str, int] = {}
     for table in ("task_links", "task_comments", "task_runs", "task_chat_links"):
-        lv = _child_uids(live, table, checked)
-        sh = _child_uids(shadow, table, checked)
+        lv = _child_uids(live, table, checked, gateway)
+        sh = _child_uids(shadow, table, checked, gateway)
         n = len(lv ^ sh)
         if n:
             children[table] = n
diff --git a/tests/hermes_cli/test_kanban_sync_foreign_chat_links.py b/tests/hermes_cli/test_kanban_sync_foreign_chat_links.py
new file mode 100644
index 00000000000..a4577f437ca
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_sync_foreign_chat_links.py
@@ -0,0 +1,64 @@
+"""``diff`` and foreign cards' chat links: a picked-up copy of another gateway's card never carries that gateway's
+chat links (hub t_01a1895d106aeb02, 2026-10-29: child_mismatch task_chat_links with pending=0)."""
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_sync_client as ksc
+from hermes_cli import kanban_worker_node as wn
+from tests.hermes_cli.test_kanban_cross_gateway_parents import (
+    BOARD, ME, OTHER, _other, _round, kanban_home, live, svc,
+)
+
+__all__ = ["kanban_home", "live", "svc"]
+
+
+def _foreign_copy(live, svc, kanban_home):
+    _other(svc, "card", "tasks", "t_foreign", {"title": "theirs", "status": "running", "created_at": 1,
+                                                 "created_on": OTHER})
+    _other(svc, "chat", "task_chat_links", f"t_foreign:{OTHER}:-:s1:created",
+           {"task_id": "t_foreign", "chat_gateway": OTHER, "chat_session": "s1", "kind": "created", "released": 0,
+            "created_at": 1})
+    _round(kanban_home, svc)
+    replica = ksc.open_shadow(BOARD, ME)
+    try:
+        replica.row_factory = ksc.sqlite3.Row
+        assert wn.import_cards(live, replica, ["t_foreign"]) == ["t_foreign"]
+    finally:
+        replica.close()
+    assert not live.execute("SELECT 1 FROM task_chat_links WHERE task_id = 't_foreign'").fetchone()
+
+
+def _diff(live):
+    shadow = ksc.open_shadow(BOARD, ME)
+    try:
+        return ksc.diff(live, shadow, ME)
+    finally:
+        shadow.close()
+
+
+def test_a_picked_up_foreign_card_without_its_creators_chat_links_is_not_a_mismatch(live, svc, kanban_home):
+    _foreign_copy(live, svc, kanban_home)
+    report = _diff(live)
+    assert report["checked"] >= 1
+    assert report["child_mismatch"] == {}
+
+
+def test_a_missing_chat_link_of_this_gateway_on_a_foreign_card_is_still_a_mismatch(live, svc, kanban_home):
+    _foreign_copy(live, svc, kanban_home)
+    shadow = ksc.open_shadow(BOARD, ME)
+    try:
+        shadow.execute("INSERT INTO task_chat_links (uid, task_id, chat_gateway, chat_session, kind, released, "
+                       "created_at) VALUES ('t_foreign:mine', 't_foreign', ?, 's2', 'shepherd', 0, 2)", (ME,))
+        shadow.commit()
+        assert ksc.diff(live, shadow, ME)["child_mismatch"] == {"task_chat_links": 1}
+    finally:
+        shadow.close()
+
+
+def test_a_missing_chat_link_on_an_own_card_is_still_a_mismatch(live, svc, kanban_home):
+    tid = kb.create_task(live, title="own", assignee="worker")
+    _round(kanban_home, svc)
+    _other(svc, "x", "task_chat_links", f"{tid}:{OTHER}:-:s3:shepherd",
+           {"task_id": tid, "chat_gateway": OTHER, "chat_session": "s3", "kind": "shepherd", "released": 0,
+            "created_at": 2})
+    ksc._pull_replica(BOARD, svc.hub(ME), ME)
+    assert _diff(live)["child_mismatch"] == {"task_chat_links": 1}
