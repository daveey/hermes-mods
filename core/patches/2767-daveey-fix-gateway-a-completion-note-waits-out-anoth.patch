index 71df7eb93a..b671a0bfa6 100644
--- a/gateway/session_completion_notes.py
+++ b/gateway/session_completion_notes.py
@@ -27,6 +27,11 @@ _ALWAYS_NOTED = frozenset({'cron'})
 # re-dispatches into the same failure (billing, a usage limit) would otherwise wake itself forever; past
 # the limit the failure is a note again until a viewer attaches or the user sends something.
 UNATTENDED_WAKE_LIMIT = 3
+# Backoff while another turn holds the conversation's lease (``_write_note``); the warning repeats
+# at most this often, so a long turn ahead of the note is visible without flooding the log.
+_LEASE_RETRY_MIN_S = 0.25
+_LEASE_RETRY_MAX_S = 2.0
+_LEASE_NOTICE_EVERY_S = 60.0
 
 
 def _producer(identity):
@@ -86,14 +91,11 @@ async def note_if_unviewed(authority, ref, row):
         # The claim left a closed row closed for a note; the turn reopens it as any first turn does.
         await reopen_for_turn(authority, ref)
         return None
-    from gateway.session_viewer_close import _physical_target
-    metadata = {'completion_note': sorted(set(descriptor.get('identities') or ()) | {descriptor['identity']})}
-    metadata.update({key: descriptor[key] for key in ('display_text', 'notification_category') if key in descriptor})
-    target = _physical_target(authority, ref.session_id)
+    metadata = note_metadata(descriptor)
     # Keyed by its admission: a claim is never replayed, and this keeps a write retry exact.
-    await tracked_write(authority, partial(
+    target = await _write_note(authority, ref, lambda target: tracked_write(authority, partial(
         authority.db.append_completion_note, target, row['admission_id'], row['payload']['text'],
-        descriptor.get('display_kind', 'internal_notification'), metadata))
+        descriptor.get('display_kind', 'internal_notification'), metadata)))
     refresh = getattr(authority.runner, '_refresh_agent_cache_message_count', None)
     if refresh is not None:  # the owner's own row: a cached agent stays, as after a turn's writes
         await refresh(live.route, target)
@@ -102,6 +104,47 @@ async def note_if_unviewed(authority, ref, row):
     return ''
 
 
+def note_metadata(descriptor):
+    """A completion note's display metadata: every identity it covers and the producer's card fields."""
+    metadata = {'completion_note': sorted(set(descriptor.get('identities') or ()) | {descriptor['identity']})}
+    metadata.update({key: descriptor[key] for key in ('display_text', 'notification_category') if key in descriptor})
+    return metadata
+
+
+async def _write_note(authority, ref, write):
+    """Run ``write(target)`` against the session's physical tip; return that target.
+
+    The note refuses a transcript another turn on the same conversation holds the turn lease of
+    (``SessionTurnLeaseLostError``): another process's turn, or a sibling session's. That refusal is
+    transient (the lease ends with its turn, or goes stale and the guard reclaims it), while failing
+    the admission loses the completion for good: its producer was acknowledged at admission and its
+    request id is admitted once, so a re-offer resolves to the failed row (deleg_e757744d). The FIFO
+    head waits for the lease instead, as a turn of this session waits for it, and writes then; the
+    note is keyed by its admission, so a refused try leaves nothing to repeat. A drain that stops
+    meanwhile cancels the wait, as it does a running turn. The tip is re-read each try: a
+    compression may rotate it while we wait."""
+    import asyncio
+    import logging
+
+    from gateway.session_viewer_close import _physical_target
+    from hermes_state_errors import SessionTurnLeaseLostError
+    delay, waited, notice_at = 0.0, 0.0, 0.0
+    while True:
+        target = _physical_target(authority, ref.session_id)
+        try:
+            await write(target)
+            return target
+        except SessionTurnLeaseLostError:
+            if waited >= notice_at:
+                logging.getLogger(__name__).warning(
+                    'Completion note for %s waits for another turn\'s lease on %s (%.0fs so far)',
+                    ref.session_id, target, waited)
+                notice_at = waited + _LEASE_NOTICE_EVERY_S
+        delay = min(max(delay * 2, _LEASE_RETRY_MIN_S), _LEASE_RETRY_MAX_S)
+        await asyncio.sleep(delay)
+        waited += delay
+
+
 def _refresh_outcome_after_note(db, target):
     """[daveey] A note runs no turn, so no turn-end refresh restores the chat's stored outcome: refresh it here, off
     the admission loop (the judge may call a model), as ``gateway/turn_outcome.py`` does for a turn. Best-effort."""
diff --git a/tests/gateway/test_completion_admission_reconcile.py b/tests/gateway/test_completion_admission_reconcile.py
new file mode 100644
index 0000000000..badbfb96bb
--- /dev/null
+++ b/tests/gateway/test_completion_admission_reconcile.py
@@ -0,0 +1,149 @@
+"""An acknowledged completion whose admission failed is offered again and delivered once (deleg_e757744d).
+
+Before the lease wait (``test_completion_note_turn_lease``), a note refused by another turn's lease
+settled its admission ``failed`` while the ledger row already said ``delivered``. The start-up
+reconciliation reopens such rows through ``requeue_admitted_completion``; the claimed offer then
+writes the failed admission's note, keyed by that admission. Negative controls: an admission that
+completed, or a failed one whose note exists, is never reopened.
+"""
+import logging
+import queue
+
+import pytest
+
+from tests.gateway.test_completion_admission import pending
+from tests.gateway.test_session_end_delegations import _admissions, _local
+from tools import async_delegation as delegation
+
+
+@pytest.fixture(autouse=True)
+def _no_delegations():
+    delegation._reset_for_tests()
+    yield
+    delegation._reset_for_tests()
+
+
+def _target(runner, authority, ref):
+    return runner.session_store.lookup_by_session_key(authority.sessions[ref.session_id].route).session_id
+
+
+def _notes(authority, target, name):
+    return [m for m in authority.db.get_messages(target) if name in str(m.get('content'))]
+
+
+def _ledger(delegation_id):
+    with delegation._DB_LOCK, delegation._transaction() as conn:
+        return conn.execute('SELECT delivery_state, delivery_attempts FROM async_delegations '
+                            'WHERE delegation_id=?', (delegation_id,)).fetchone()
+
+
+async def _admit(runner, authority, ref, name):
+    route = authority.sessions[ref.session_id].route
+    evt = dict(pending(route, name), parent_session_id=_target(runner, authority, ref))
+    assert await runner._deliver_async_delegation_group([evt]) is True
+    assert _ledger(name)[0] == 'delivered', 'acknowledged at admission'
+    return evt
+
+
+async def _fail_next_note(authority, ref, monkeypatch):
+    """Drain the queued completion the way the old code did when the note met another turn's lease."""
+    from gateway import session_completion_notes as notes
+    from hermes_state_errors import SessionTurnLeaseLostError
+
+    async def refused(*_args):
+        raise SessionTurnLeaseLostError('Session has an active turn lease; refusing transcript mutation')
+    with monkeypatch.context() as patch:
+        patch.setattr(notes, '_write_note', refused)
+        await authority._drain(ref)
+
+
+def _offered(q):
+    events = []
+    while not q.empty():
+        events.append(q.get_nowait())
+    return events
+
+
+@pytest.mark.asyncio
+async def test_failed_admission_is_reopened_and_noted_exactly_once(tmp_path, monkeypatch):
+    from gateway.completion_admission_recovery import reconcile_failed_completion_admissions
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        target = _target(runner, authority, ref)
+        await _admit(runner, authority, ref, 'deleg_lost')
+        await _fail_next_note(authority, ref, monkeypatch)
+        assert [r['outcome'] for r in _admissions(authority, ref)] == ['failed']
+        assert _notes(authority, target, 'deleg_lost') == [] and _ledger('deleg_lost')[0] == 'delivered'
+
+        # Negative control: a completion whose admission ran its note is never reopened.
+        await _admit(runner, authority, ref, 'deleg_fine')
+        await authority._drain(ref)
+        assert len(_notes(authority, target, 'deleg_fine')) == 1
+
+        offers = queue.Queue()
+        assert reconcile_failed_completion_admissions(authority, offers) == 1
+        events = _offered(offers)
+        assert [e['delegation_id'] for e in events] == ['deleg_lost']
+        assert _ledger('deleg_lost')[0] == 'pending' and _ledger('deleg_fine')[0] == 'delivered'
+
+        # The claimed offer writes the failed admission's note; the ledger is acknowledged again.
+        assert await runner._deliver_async_delegation_group(events) is True
+        assert len(_notes(authority, target, 'deleg_lost')) == 1
+        state, attempts = _ledger('deleg_lost')
+        assert state == 'delivered' and attempts == 2
+        assert [r['outcome'] for r in _admissions(authority, ref)] == ['failed', 'completed']
+
+        # Negative control: once noted, a later start reopens nothing, and a stray copy writes nothing.
+        assert reconcile_failed_completion_admissions(authority, offers) == 0
+        assert _offered(offers) == []
+        assert await runner._deliver_async_delegation_group([dict(events[0])]) in (True, None)
+        assert len(_notes(authority, target, 'deleg_lost')) == 1
+        assert len(_notes(authority, target, 'deleg_fine')) == 1
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_refused_recovery_note_spends_attempts_until_dropped(tmp_path, monkeypatch):
+    """A recovery note still refused (a lease that never clears) releases its claim: the row converges to
+    ``dropped`` within the delivery budget, never back to a silent ``delivered``."""
+    from gateway.completion_admission_recovery import reconcile_failed_completion_admissions
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        target = _target(runner, authority, ref)
+        await _admit(runner, authority, ref, 'deleg_held')
+        await _fail_next_note(authority, ref, monkeypatch)
+        offers = queue.Queue()
+        assert reconcile_failed_completion_admissions(authority, offers) == 1
+        assert authority.db.try_acquire_session_turn_lease(target, 'other-turn', ttl_seconds=300.0)
+        monkeypatch.setattr(delegation, '_CLAIM_LEASE_S', -1.0)
+        events = _offered(offers)
+        for _ in range(delegation._MAX_DELIVERY_ATTEMPTS):
+            assert await runner._deliver_async_delegation_group([dict(events[0])]) is not True
+            if _ledger('deleg_held')[0] != 'pending':
+                break
+        state, attempts = _ledger('deleg_held')
+        assert state == 'dropped' and attempts >= 1
+        assert _notes(authority, target, 'deleg_held') == []
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_reopen_past_the_replay_age_drops_it_with_a_logged_reason(tmp_path, monkeypatch, caplog):
+    from gateway.completion_admission_recovery import reconcile_failed_completion_admissions
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        await _admit(runner, authority, ref, 'deleg_old')
+        await _fail_next_note(authority, ref, monkeypatch)
+        with delegation._DB_LOCK, delegation._transaction() as conn:
+            conn.execute('UPDATE async_delegations SET completed_at=?, dispatched_at=? WHERE delegation_id=?',
+                         (1.0, 1.0, 'deleg_old'))
+        offers = queue.Queue()
+        with caplog.at_level(logging.WARNING, logger='tools.async_delegation'):
+            assert reconcile_failed_completion_admissions(authority, offers) == 0
+        assert _offered(offers) == []
+        assert _ledger('deleg_old')[0] == 'dropped'
+        assert any('deleg_old' in r.getMessage() and 'replay age' in r.getMessage() for r in caplog.records)
+    finally:
+        authority.db.close()
diff --git a/tests/gateway/test_completion_note_turn_lease.py b/tests/gateway/test_completion_note_turn_lease.py
new file mode 100644
index 0000000000..f9ec285445
--- /dev/null
+++ b/tests/gateway/test_completion_note_turn_lease.py
@@ -0,0 +1,113 @@
+"""A completion note refused by another turn's lease waits for it; the result is never lost.
+
+Regression (live, deleg_e757744d): an async delegation's completion was admitted and its ledger row
+acknowledged ``delivered`` at admission. When the admission came up with no viewer attached, its
+note write met a turn lease another turn held on the same conversation
+(``SessionTurnLeaseLostError``); the admission settled ``failed`` and the result never reached the
+parent. A request id is admitted once, so a re-offer resolves to that failed admission and cannot
+deliver again: the note must land from the admission itself once the lease is gone.
+"""
+import asyncio
+
+import pytest
+
+from tests.gateway.test_completion_admission import pending
+from tests.gateway.test_session_end_delegations import _admissions, _local
+from tools import async_delegation as delegation
+
+
+@pytest.fixture(autouse=True)
+def _no_delegations():
+    delegation._reset_for_tests()
+    yield
+    delegation._reset_for_tests()
+
+
+def _target(runner, authority, ref):
+    return runner.session_store.lookup_by_session_key(authority.sessions[ref.session_id].route).session_id
+
+
+def _delegation_notes(authority, target, name):
+    return [m for m in authority.db.get_messages(target) if name in str(m.get('content'))]
+
+
+def _ledger_state(delegation_id):
+    with delegation._DB_LOCK, delegation._transaction() as conn:
+        return conn.execute('SELECT delivery_state FROM async_delegations WHERE delegation_id=?',
+                            (delegation_id,)).fetchone()[0]
+
+
+async def _until(predicate, timeout=10.0):
+    loop = asyncio.get_running_loop()
+    deadline = loop.time() + timeout
+    while not predicate():
+        assert loop.time() < deadline, 'condition not reached'
+        await asyncio.sleep(0.01)
+
+
+@pytest.mark.asyncio
+async def test_note_held_off_by_another_turns_lease_lands_once_it_releases(tmp_path, monkeypatch):
+    from gateway import session_completion_notes as notes
+    monkeypatch.setattr(notes, '_LEASE_RETRY_MIN_S', 0.01, raising=False)
+    monkeypatch.setattr(notes, '_LEASE_RETRY_MAX_S', 0.02, raising=False)
+    runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
+    try:
+        route = authority.sessions[ref.session_id].route
+        target = _target(runner, authority, ref)
+        evt = dict(pending(route, 'deleg_leased'), parent_session_id=target)
+        assert await runner._deliver_async_delegation_group([evt]) is True
+        assert _ledger_state('deleg_leased') == 'delivered'
+
+        # Another turn (another process's, e.g. a Kanban notice) holds the conversation's turn lease.
+        assert authority.db.try_acquire_session_turn_lease(target, 'other-turn', ttl_seconds=300.0)
+        refused = []
+        write = authority.db.append_completion_note
+
+        def counted(*args, **kwargs):
+            try:
+                return write(*args, **kwargs)
+            except Exception as exc:
+                refused.append(type(exc).__name__)
+                raise
+        monkeypatch.setattr(authority.db, 'append_completion_note', counted)
+
+        drain = asyncio.ensure_future(authority._drain(ref))
+        await _until(lambda: len(refused) >= 2 or drain.done())
+        assert not drain.done(), 'the admission settled while the lease was still held'
+        assert set(refused) == {'SessionTurnLeaseLostError'}
+        assert _delegation_notes(authority, target, 'deleg_leased') == []
+
+        authority.db.release_session_turn_lease(target, 'other-turn')
+        await asyncio.wait_for(drain, 10.0)
+        assert len(_delegation_notes(authority, target, 'deleg_leased')) == 1
+        assert [r['outcome'] for r in _admissions(authority, ref)] == ['completed']
+        assert _ledger_state('deleg_leased') == 'delivered'
+
+        # Exactly once: a re-offer resolves to the settled admission and writes nothing more.
+        assert await runner._deliver_async_delegation_group([dict(evt)]) in (True, None)
+        await authority._drain(ref)
+        assert len(_delegation_notes(authority, target, 'deleg_leased')) == 1
+    finally:
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_note_reclaims_a_dead_holders_lease(tmp_path, monkeypatch):
+    """An expired lease (its holder died) is no wait: the guard reclaims it and the note lands at once."""
+    from gateway import session_completion_notes as notes
+    monkeypatch.setattr(notes, '_LEASE_RETRY_MIN_S', 0.01, raising=False)
+    monkeypatch.setattr(notes, '_LEASE_RETRY_MAX_S', 0.02, raising=False)
