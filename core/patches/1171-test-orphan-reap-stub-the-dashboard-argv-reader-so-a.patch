From 616c162946f2d3b7ff3f2e373f089f4ff60f71c9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 01:05:00 -0700
Subject: [PATCH] test(orphan-reap): stub the dashboard argv reader so a live
 pid 777 cannot answer for the mock

_dashboard_cmdline_for_pid reads /proc/<pid>/cmdline before psutil. On a fresh tfgar CI VM pid 777 is a real
process, so its argv (no --profile) replaced the mocked one and [profile-override] reaped it (#224 slice 2,
run 41020568490). Hubs and macOS have no readable pid 777, which is why it only failed there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/hermes_cli/test_orphan_reap_home_scope.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/tests/hermes_cli/test_orphan_reap_home_scope.py b/tests/hermes_cli/test_orphan_reap_home_scope.py
index fb9553c93ef..54bd8f1d9f0 100644
--- a/tests/hermes_cli/test_orphan_reap_home_scope.py
+++ b/tests/hermes_cli/test_orphan_reap_home_scope.py
@@ -36,6 +36,8 @@ def test_reap_requires_positive_same_home_and_uid(tmp_path, monkeypatch, identit
     elif identity == "uid-unreadable":
         proc.uids.side_effect = psutil.AccessDenied(777)
     monkeypatch.setattr(psutil, "Process", lambda pid: proc)
+    # The real reader opens /proc/777/cmdline: on a fresh Linux VM pid 777 is a live process whose argv wins.
+    monkeypatch.setattr("hermes_cli.main_dashboard._dashboard_cmdline_for_pid", lambda pid: list(argv))
     monkeypatch.setattr("gateway.status.get_process_start_time", lambda pid: 1000)
     monkeypatch.setattr(procs, "_pid_environ", lambda pid: None if identity == "unreadable" else env)
     monkeypatch.setattr(procs, "_scan_dashboard_processes", lambda **kw: [(777, " ".join(argv))])
