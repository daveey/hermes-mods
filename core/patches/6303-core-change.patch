From b55851df7403cbb38acec88702b0251d88e421ab Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 01:16:57 +0000
Subject: [PATCH 6303] Primary reconnect ownership and exact sidebar list batching

Public mirror of source commit b55851df7403cbb38acec88702b0251d88e421ab.

---
diff --git a/hermes_cli/sessions_projection_manifest.py b/hermes_cli/sessions_projection_manifest.py
index d3340703868..97dda04e2aa 100644
--- a/hermes_cli/sessions_projection_manifest.py
+++ b/hermes_cli/sessions_projection_manifest.py
@@ -404,6 +404,8 @@
         SelectorParam("cron_limit", "integer", 50, validated="clamped 1..500"),
         SelectorParam("messaging_limit", "integer", 100, validated="clamped 1..500"),
         SelectorParam("messaging_exclude", "string|null", None, validated="csv"),
+        SelectorParam("list_slices", "boolean", False,
+                      validated="True requests exact list envelopes; native facts may return ordinary sidebar"),
     ),
 }
 SELECTOR_ROUTES = {"sessions": "/api/profiles/sessions", "sessions_stamps": "/api/profiles/sessions/stamps",
@@ -528,6 +530,19 @@
     explicit boolean full=True authorizes the full list projection.
     """
     fields = RESPONSES[endpoint]
+    if endpoint == "sessions_sidebar" and "list_slices_version" in value:
+        if selector.get("list_slices") is not True:
+            return ["list slices require explicit list_slices=True"]
+        envelope = (FieldSpec("list_slices_version", "const:1", ALWAYS, "read_list_slices"),)
+        errors = shape_violations({key: item for key, item in value.items()
+                                   if key not in ("recents", "cron", "messaging")}, envelope)
+        for key in ("recents", "cron", "messaging"):
+            part = value.get(key)
+            if not isinstance(part, dict):
+                errors.append(f"{key}: missing or invalid list envelope")
+            else:
+                errors.extend(f"{key}: {error}" for error in response_violations(part, "sessions", {}))
+        return errors
     if endpoint == "sessions":
         full = selector.get("full", False)
         if not isinstance(full, bool):
diff --git a/tests/hermes_cli/test_profile_session_list_slices.py b/tests/hermes_cli/test_profile_session_list_slices.py
index ff19d0a9213..1aa1cf122e6 100644
--- a/tests/hermes_cli/test_profile_session_list_slices.py
+++ b/tests/hermes_cli/test_profile_session_list_slices.py
@@ -77,6 +77,12 @@
     assert response.status_code == 200, response.text
     batch = response.json()
     assert batch["list_slices_version"] == 1
+    from hermes_cli.sessions_projection_manifest import response_violations
+
+    assert response_violations(batch, "sessions_sidebar", {"list_slices": True}) == []
+    assert response_violations(batch, "sessions_sidebar", {})
+    assert response_violations(dict(batch, list_slices_version=2), "sessions_sidebar", {"list_slices": True})
+    assert response_violations(dict(batch, recents={}), "sessions_sidebar", {"list_slices": True})
     for key, filters in (("recents", {"exclude_sources": "cron,telegram"}),
                          ("cron", {"source": "cron"}),
                          ("messaging", {"exclude_sources": "cli,cron"})):
