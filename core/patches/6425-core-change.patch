---
diff --git a/hermes_cli/kanban_spend_stop_watch.py b/hermes_cli/kanban_spend_stop_watch.py
index 479c84b07dd..6c0fe1d083c 100644
--- a/hermes_cli/kanban_spend_stop_watch.py
+++ b/hermes_cli/kanban_spend_stop_watch.py
@@ -28,7 +28,7 @@
         if stop is None or stop['created_at'] >= now - older_than:
             continue
         episode = cast(str, reviewer.episode_of(stop))
-        if reviewer.state(conn, tid, episode) is not None or decision.episode_route(conn, tid, episode) is not None:
+        if reviewer.state(conn, tid, episode) is not None or _routed(conn, tid, episode):
             continue
         if conn.execute("SELECT 1 FROM task_events WHERE task_id=? AND kind=? AND json_valid(payload) "
                         "AND json_extract(payload,'$.episode')=?", (tid, FILED, episode)).fetchone():
@@ -37,6 +37,17 @@
     return result
 
 
+def _routed(conn: sqlite3.Connection, tid: str, episode: str) -> bool:
+    """A decision card, or the notice's live chat route. ``unavailable`` means nobody was told."""
+    route = decision.episode_route(conn, tid, episode)
+    if route is None:
+        row = conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind=? AND json_valid(payload) "
+                           "AND json_extract(payload,'$.episode')=? ORDER BY id DESC LIMIT 1",
+                           (tid, decision.NOTICE, episode)).fetchone()
+        route = kb._json_dict(row[0]).get('producer') if row else None
+    return isinstance(route, dict) and route.get('kind') != 'unavailable' and decision._live_route(conn, route)
+
+
 def _file(conn: sqlite3.Connection, card: dict, now: float) -> str:
     tid, episode, stop = card['id'], card['episode'], card['stop']
     minutes = int((now - stop['created_at']) // 60)
diff --git a/tests/hermes_cli/test_kanban_spend_stop_watch.py b/tests/hermes_cli/test_kanban_spend_stop_watch.py
index e76f1ca20f2..d2d0c6642a2 100644
--- a/tests/hermes_cli/test_kanban_spend_stop_watch.py
+++ b/tests/hermes_cli/test_kanban_spend_stop_watch.py
@@ -169,3 +169,29 @@
     with kbc.connect_closing() as conn:
         card, = filed(conn)
     assert capsys.readouterr().out == f"filed {card['id']} for {tid} stop {ep}\n"
+
+
+def _notice(conn, tid, ep, producer):
+    with kb.write_txn(conn):
+        kb._append_event(conn, tid, decision.NOTICE, {'episode': ep, 'producer': producer})
+
+
+@pytest.mark.parametrize('producer,files', [
+    ({'kind': 'chats', 'sessions': ['s1']}, False), ({'kind': 'dismissed'}, False),
+    ({'kind': 'unavailable'}, True), ('chats', True), (None, True)])
+def test_notice_route_counts_only_when_somebody_was_told(kanban_home, producer, files):
+    with kbc.connect_closing() as conn:
+        tid, ep = stop(conn)
+        _notice(conn, tid, ep, producer)
+        assert len(watchdog.watch(conn, now=NOW)) == (1 if files else 0)
+
+
+def test_notice_route_of_another_episode_or_a_closed_decision_card_does_not_count(kanban_home):
+    with kbc.connect_closing() as conn:
+        tid, ep = stop(conn)
+        _notice(conn, tid, 'another-episode', {'kind': 'chats'})
+        closed = kb.create_task(conn, title='Old decision desk', assignee='default')
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='done' WHERE id=?", (closed,))
+        _notice(conn, tid, ep, {'kind': 'supervisor', 'task_id': closed})
+        assert len(watchdog.watch(conn, now=NOW)) == 1
