From 8e9d9fe40084c92cf99afd3adca3a437571736f8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 11:55:28 +0000
Subject: [PATCH] [daveey] Preserve returning legacy recovery and unrelated
 notice context

---
 gateway/kanban_wake_fold.py                    | 17 +++++++++--------
 .../test_kanban_remote_owner_delivery.py       |  2 +-
 tests/tui_gateway/test_kanban_remote_rehome.py | 18 ++++++++++++++++++
 tui_gateway/kanban_remote_notices.py           |  5 +++++
 4 files changed, 33 insertions(+), 9 deletions(-)

diff --git a/gateway/kanban_wake_fold.py b/gateway/kanban_wake_fold.py
index a582e2f582729132da5008cfee6fbd332002a50f..132a26799b8c2388756b6fec349629b9b6431ae8 100644
--- a/gateway/kanban_wake_fold.py
+++ b/gateway/kanban_wake_fold.py
@@ -205,17 +205,18 @@ def _live_task(card):
         return task.status, summary.strip()
 
 
-def _without_superseded_ask(lines):
+def _without_superseded_ask(lines, task_id=''):
     """Remove the formatter's whole ask block, including multiline field values."""
     start = next((i for i, line in enumerate(lines) if line.startswith('Next action for the user:')), None)
-    # Field values may themselves contain an Open task line; the formatter's
-    # closing link follows all multiline fields, not their first embedded link.
-    end = next((i for i in range(len(lines) - 1, -1, -1) if lines[i].startswith('Open task:')
-                and start is not None and i > start), None)
+    # Prefer this card's closing link over embedded links and unrelated trailing context.
+    ends = [i for i, line in enumerate(lines) if line.startswith('Open task:')
+            and start is not None and i > start]
+    matching = [i for i in ends if task_id and lines[i].rstrip().endswith('/' + task_id)]
+    end = (matching or ends)[-1] if ends else None
     if start is not None and end is not None:
         lines = lines[:start] + lines[end + 1:]
     return [line for line in lines if not line.startswith((
-        'Next action for the user:', 'Why only the user:', 'Scope:', 'Open task:',
+        'Next action for the user:', 'Why only the user:', 'Scope:',
         'Automatic detection stopped', 'Automatic detection had stopped for an earlier version of this ask;',
         'Your step is still needed. Filed ask, historical wording',
         "Use the owner Desktop session's user-terminal flow;"))]
@@ -249,7 +250,7 @@ def refresh_card(card, *, strict=False):
     out = [f"[kanban] Task {card['task_id']} {label}.",
            f'Note: an earlier wake for this card said "{earlier}"; that no longer holds. Live status: {status}.']
     rest = lines[1:] if _LEGACY_HEAD.match(head) else lines
-    rest = _without_superseded_ask(rest)
+    rest = _without_superseded_ask(rest, card['task_id'])
     out.extend(rest)
     if status == 'done' and result and not any(line.startswith('Result:') for line in rest):
         out.insert(2, 'Result: ' + result.splitlines()[0][:400])
@@ -292,7 +293,7 @@ def _guidance(text, cards):
     tail = '\n'.join(rest).rstrip()
     if tail and text.find(tail, pos) < 0 and f"[kanban] Task {last.get('task_id')} " in text:
         # A relabel removes the obsolete ask; an ask-only tail becomes a one-line card.
-        tail = '\n'.join(_without_superseded_ask(rest)).rstrip()
+        tail = '\n'.join(_without_superseded_ask(rest, last['task_id'])).rstrip()
     if tail:
         end = text.find(tail, pos)
         if end < 0:
diff --git a/tests/gateway/test_kanban_remote_owner_delivery.py b/tests/gateway/test_kanban_remote_owner_delivery.py
index a3f046293f4f2897a764ef863a749f79bf43964d..bde9ff2fcbba2633a87680815efde41dfbe3c709 100644
--- a/tests/gateway/test_kanban_remote_owner_delivery.py
+++ b/tests/gateway/test_kanban_remote_owner_delivery.py
@@ -81,7 +81,7 @@ def test_resolved_real_notice_drops_multiline_ask_presentation(monkeypatch, drop
                          'title': 'Keep work context'}, tid, 'default')
     assert 'Next action for the user:' in text
     item = {'ref': f'worker-6/default/default/{tid}', 'state': 'blocked@1', 'event_key': 'key',
-            'text': text + '\nKeep other context'}
+            'text': text + '\nKeep other context\nOpen task: @task:default/t_other'}
     monkeypatch.setattr(kanban_wake_fold, '_live_task', lambda _: ('ready', ''))
     card = kro._metadata(item)['kanban_cards'][0]
     result = kanban_wake_fold._compose([card], GUIDANCE, strict=True)
diff --git a/tests/tui_gateway/test_kanban_remote_rehome.py b/tests/tui_gateway/test_kanban_remote_rehome.py
index d725f4913b333ff5830ee795f8d234d74d01b4ac..a3e6a8b13cdcdac4626e2a1ee19aae93cda35750 100644
--- a/tests/tui_gateway/test_kanban_remote_rehome.py
+++ b/tests/tui_gateway/test_kanban_remote_rehome.py
@@ -188,6 +188,24 @@ def test_unconfirmed_legacy_delivery_does_not_suppress_moved_state(tmp_path):
     assert len(offered) == 1
 
 
+def test_legacy_home_recovers_after_moved_successor_fails(tmp_path):
+    now = time.time()
+    hub = once._hub(tmp_path, now)
+    ledger = tmp_path / 'ledger.db'
+    _move(hub, 'worker-6')
+    krn.collect(once.CHAT, 'default', hub_db=hub, ledger=ledger, now=now)
+    with sqlite3.connect(ledger) as conn:
+        conn.execute('UPDATE notices SET delivered=1, notice_key=NULL, legacy_seen=0')
+    _move(hub, 'hub')
+    [new] = krn.collect(once.CHAT, 'default', hub_db=hub, ledger=ledger, now=now + 10,
+                        transcript_has=lambda *_: False)
+    krn.release(new, ledger=ledger)
+    _move(hub, 'worker-6')
+    offered = krn.collect(once.CHAT, 'default', hub_db=hub, ledger=ledger, now=now + 20,
+                          transcript_has=lambda *_: False)
+    assert len(offered) == 1
+
+
 def test_legacy_returning_home_respects_live_successor(tmp_path):
     now = time.time()
     hub = once._hub(tmp_path, now)
diff --git a/tui_gateway/kanban_remote_notices.py b/tui_gateway/kanban_remote_notices.py
index e2afef2bf39a0e32272658e8217d18910c9fa441..00b5f31ede2549bee5e496a0d999403e919f4a42 100644
--- a/tui_gateway/kanban_remote_notices.py
+++ b/tui_gateway/kanban_remote_notices.py
@@ -502,14 +502,19 @@ def _reconcile_legacy(conn, session_key: str, cards: list, now: float, transcrip
     if not rows:
         return []
     by_state = {}
+    logical_states = set()
     for card in cards:
         task = card["task"]
+        logical_states.add((str(task['id']), _notice_state(task)))
         by_state[(f"{card['gw']}/{card['key']}", _notice_state(task))] = card
     pid, start = _my_holder()
     stale = 0
     out = []
     for row in rows:
         card = by_state.get((row["ref"], row["state"]))
+        if (card is None and (row['ref'].rsplit('/', 1)[-1], row['state']) in logical_states
+                and now - float(row['at'] or 0) <= FRESH_S):
+            continue  # a moved, unconfirmed legacy claim must remain recoverable if its successor fails
         if card is None or now - float(row["at"] or 0) > FRESH_S:
             stale += 1
             conn.execute("UPDATE notices SET legacy_seen=1 WHERE session=? AND ref=? AND state=?",
