diff --git a/tui_gateway/transport.py b/tui_gateway/transport.py
index 691f1d799027b211a073c685fbd7ee5d65fae3a6..43fb4379f919d201f04debd2c3aa891403c4a88f 100644
--- a/tui_gateway/transport.py
