From 2b3d839f253b9ce4b7db5e0540adb73ecc64f58f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:45:40 +0000
Subject: [PATCH] fix(cron): revisit assignments after eval discovers integer
 attributes [daveey]

Local independent review identified expanded declarations inside eval and slash-bearing parameter expansions. Three isolated Bash marker regressions fail before this correction and pass after. Check original command tokens before basename extraction; repeat the parent arithmetic pass only when quoted eval text changes its context. Preserve prior traversal order and non-integer controls.
---
 cron/lifecycle_guard_arith_words.py                  | 3 ++-
 cron/lifecycle_guard_output.py                       | 7 ++++++-
 tests/cron/test_lifecycle_guard_arith_int_context.py | 3 +++
 3 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/cron/lifecycle_guard_arith_words.py b/cron/lifecycle_guard_arith_words.py
index 7960f78500967c3dd8b637991c15178c5ba9ce4a..825fe6d51ae7daed4494171ee8e899fa441699e1 100644
--- a/cron/lifecycle_guard_arith_words.py
+++ b/cron/lifecycle_guard_arith_words.py
@@ -168,7 +168,8 @@ def may_set_integer_attributes(command: str) -> bool:
         # can introduce an integer declaration; allow the later subscript walk now,
         # before referenced files are traversed. Unknown commands may be declare.
         if name in {"source", "."} or (
-            any(char in name for char in "$`") and not _ASSIGNMENT_WORD_RE.match(words[index])
+            any(char in words[index] for char in "$`")
+            and not _ASSIGNMENT_WORD_RE.match(words[index])
         ):
             return True
         if name in _INTEGER_DECLARERS and any(
diff --git a/cron/lifecycle_guard_output.py b/cron/lifecycle_guard_output.py
index 7aa0ec55ce44a1badbf1912ac79589207c17554c..4f1a4125c0cdbb43ca528fd404cb992ce3ac1289 100644
--- a/cron/lifecycle_guard_output.py
+++ b/cron/lifecycle_guard_output.py
@@ -29,13 +29,18 @@ def iter_recursive_payloads(command, nested_texts, *, cwd, executed, budget, cov
         yield payload, True, None
     for payload in guard._iter_shell_command_payloads(command):
         yield payload, False, None
-    for payload in iter_arithmetic_word_payloads(command, integer_context=budget.integer_context):
+    integer_context = budget.integer_context
+    for payload in iter_arithmetic_word_payloads(command, integer_context=integer_context):
         yield payload, False, None
     # Snapshot after preceding nested-shell walks; shared budget state may have changed.
     scope = quote_scope(cwd, executed, budget)
     for payload, raw_quote in iter_printed_shell_payloads(
             command, include_quoted=covered_scope != scope):
         yield payload, False, scope if raw_quote else None
+    # Quoted eval text can establish attributes needed by the parent's later assignments.
+    if budget.integer_context and not integer_context:
+        for payload in iter_arithmetic_word_payloads(command, integer_context=True):
+            yield payload, False, None
 
 
 def iter_printed_shell_payloads(
diff --git a/tests/cron/test_lifecycle_guard_arith_int_context.py b/tests/cron/test_lifecycle_guard_arith_int_context.py
index b669788b9bf8949df3a53387c41f507f7a18b27b..728418146afa79b893e7780d2b4d9e8fcdafdd52 100644
--- a/tests/cron/test_lifecycle_guard_arith_int_context.py
+++ b/tests/cron/test_lifecycle_guard_arith_int_context.py
@@ -19,6 +19,9 @@ SHAPES = [
     r"o=-i; declare $o x; x=a[\$\(SCRIPT\)]",
     r"o=-i; builtin declare $o x; x=a[\$\(SCRIPT\)]",
     r"d=declare; builtin $d -i x; eval 'x=a[\$\(SCRIPT\)]'",
+    r"d=declare; eval '$d -i x'; x=a[\$\(SCRIPT\)]",
+    r"o=-i; eval 'declare $o x'; x=a[\$\(SCRIPT\)]",
+    r"d=declare; ${d//a/a} -i x; x=a[\$\(SCRIPT\)]",
     r"source ./decl.sh; x=a[\$\(SCRIPT\)]",
     r". ./decl.sh; eval 'x=a[\$\(SCRIPT\)]'",
 ]
