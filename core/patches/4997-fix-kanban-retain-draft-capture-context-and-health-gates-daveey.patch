From 3f2bbac2e7ad416dc717264c3b2508527051beea Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 16:28:28 +0000
Subject: [PATCH] fix(kanban): retain draft capture context and health gates
 [daveey]

---
 hermes_cli/config_defaults.py         | 6 ++----
 hermes_cli/kanban_fairness_runtime.py | 6 ++++--
 hermes_cli/kanban_fairness_urgency.py | 2 +-
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/config_defaults.py b/hermes_cli/config_defaults.py
index 28519f4a8631bda76cc6239a4943ea9c4507e04b..58035a84ea1f2663709f499b9b0a9f7eea951d09 100644
--- a/hermes_cli/config_defaults.py
+++ b/hermes_cli/config_defaults.py
@@ -1888,10 +1888,8 @@ DEFAULT_CONFIG = {
         "passive_intake": {},  # Exact task ID -> exact wake_check for standing external listeners.
         "sync": {"enabled": False},  # New boards get sync tables + outbox triggers when enabled. [daveey]
         "create_overlap_check": True,  # kanban_create refuses work open cards already own (kanban_overlap) [daveey]
-        # A board whose TABLE b-trees fail integrity_check (REINDEX can't fix it) pauses dispatch; true = the
-        # gateway dispatcher also starts `hermes kanban recover` for it (salvage in a child process, fill from
-        # the newest healthy backup, write back in place, loss report + follow-up card + sync reconcile). On
-        # here: fail-closed alone left a board down until an agent noticed by chance. [daveey]
+        # Failed TABLE integrity pauses dispatch; true also starts `hermes kanban recover` (child salvage,
+        # healthy backup, in-place restore, loss report + follow-up + sync reconcile). [daveey]
         "auto_recover_corruption": True,
         "recovery_card_assignee": "default",  # assignee of the card an automatic recovery files [daveey]
         # Opt-in per-profile broker argv before gh (empty = ordinary login); never include tokens.
diff --git a/hermes_cli/kanban_fairness_runtime.py b/hermes_cli/kanban_fairness_runtime.py
index 2f9522940a5d2265fb5dc1046917045f6c78e6ce..926524b95ef5213589a94f4459495d4508ad9f2c 100644
--- a/hermes_cli/kanban_fairness_runtime.py
+++ b/hermes_cli/kanban_fairness_runtime.py
@@ -80,7 +80,9 @@ class Session:
         # Validate supplied identities before starting any thread or making directories.
         self.record("loss", self.loss_payload("clock_gap", 1), 1)
         self.out.mkdir(parents=True, exist_ok=False)
-        self.thread = threading.Thread(target=self.run, name="fairness-evidence", daemon=True)
+        from agent.memory_provider import spawn_context_thread
+
+        self.thread = spawn_context_thread(self.run, name="fairness-evidence", daemon=True)
         self.thread.start()
 
     @staticmethod
@@ -150,7 +152,7 @@ class Session:
                 seal_records(self.out, expected_sources=[dict(source_gateway=self.identity["source_gateway"],
                              source_epoch=self.epoch, last_seq=self.seq)])
                 self.sealed = True
-        except Exception:
+        except (OSError, ValueError, TypeError, RuntimeError):
             # Evidence failure cannot change scheduler behavior; unsealed epoch is a gap.
             self.failed = True
             self.loss["writer_error"] += 1
diff --git a/hermes_cli/kanban_fairness_urgency.py b/hermes_cli/kanban_fairness_urgency.py
index bb49be6b630a4b68e7cce3964a2919f61a7c5614..958d674a1a74cb79d67156d3b80991739116c794 100644
--- a/hermes_cli/kanban_fairness_urgency.py
+++ b/hermes_cli/kanban_fairness_urgency.py
@@ -39,7 +39,7 @@ def emit(**observation):
     try:
         payload = receipt(**observation)
         runtime.submit(board=observation["board"], kind="owner_generation", payload=payload)
-    except Exception:
+    except (ValueError, TypeError, OverflowError, RecursionError):
         # Observation must never change an existing read result.
         runtime.submit(board=observation["board"], kind="loss", payload=dict(
             reason="unsupported", count=1, first_seq=None, last_seq=None,
-- 
2.43.0

