From 43c5e6fe501632b860b8f254e22e16d51ffeddec Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 13:07:01 +0000
Subject: [PATCH] [daveey] scratch archive: fail closed on an unjudged .git
 marker (PR #2218 review nit)

_find_repos looked up verdicts[gitrel] for every regular .git outside git
metadata, relying on judge and the loop sharing the same filter. If they
ever drift, a KeyError escaped the ArchiveRefused contract. Use
verdicts.get(gitrel, True): an unjudged marker counts as a gitlink and the
workspace is kept.

RED: test_unjudged_marker_fails_closed raises KeyError at the old line 138.
GREEN: gc_archive/custody/owned_jobs 204 passed, 0 failed.
---
 hermes_cli/kanban_scratch_archive.py               |  3 ++-
 tests/hermes_cli/test_kanban_scratch_gc_archive.py | 11 +++++++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_scratch_archive.py b/hermes_cli/kanban_scratch_archive.py
index 9db94cb75b..3f14e31e74 100644
--- a/hermes_cli/kanban_scratch_archive.py
+++ b/hermes_cli/kanban_scratch_archive.py
@@ -137,7 +137,8 @@ def _find_repos(root: Path) -> tuple[list[Path], dict[str, list[int]]]:
             if stat.S_ISDIR(gst.st_mode):
                 repos.append(directory)
                 continue
-            if not stat.S_ISREG(gst.st_mode) or verdicts[gitrel]:
+            # A marker the scan never judged counts as a gitlink (fail closed).
+            if not stat.S_ISREG(gst.st_mode) or verdicts.get(gitrel, True):
                 raise ArchiveRefused(f"linked worktree or submodule at {directory / '.git'} (left to the worktree GC)")
             markers[gitrel] = _signature(gst)  # plain data (e.g. uv's empty cache marker)
         if {"HEAD", "objects"} <= names and names & {"refs", "reftable"}:
diff --git a/tests/hermes_cli/test_kanban_scratch_gc_archive.py b/tests/hermes_cli/test_kanban_scratch_gc_archive.py
index 14c330be17..1fefb397f7 100644
--- a/tests/hermes_cli/test_kanban_scratch_gc_archive.py
+++ b/tests/hermes_cli/test_kanban_scratch_gc_archive.py
@@ -943,6 +943,17 @@ def test_marker_read_through_the_scans_own_directory_fd(board, monkeypatch):
     assert (cache.with_name("moved") / ".git").read_bytes() == b""
 
 
+def test_unjudged_marker_fails_closed(board, monkeypatch):
+    """A regular .git the scan never judged is refused, not a KeyError."""
+    from hermes_cli import kanban_scratch_archive as sa
+
+    _tid, path = _plain_task(lambda p: _uv_cache(p))
+    real_scan = sa._scan
+    monkeypatch.setattr(sa, "_scan", lambda root, on_git_file=None, **kw: real_scan(root, **kw))
+    with pytest.raises(sa.ArchiveRefused, match="linked worktree or submodule"):
+        sa.find_repos(path)
+
+
 def test_marker_rewritten_into_gitlink_after_judgement_keeps_workspace(board, monkeypatch):
     from hermes_cli import kanban_scratch_archive as sa
 
