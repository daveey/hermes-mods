From ef602fa0c7552ec2a91faad3092c466b4659ba5c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 10:15:46 +0000
Subject: [PATCH] fix(desktop): retain canonical running labels without local
 inference [daveey]

---
 .../src/app/chat/session-status-dot.test.tsx       | 14 +++++++++++++-
 apps/desktop/src/app/chat/session-status-dot.tsx   |  2 +-
 .../src/app/chat/sidebar/session-row.test.tsx      |  6 +++---
 3 files changed, 17 insertions(+), 5 deletions(-)

diff --git a/apps/desktop/src/app/chat/session-status-dot.test.tsx b/apps/desktop/src/app/chat/session-status-dot.test.tsx
index a9bdf8f287..4d8a0cb6c4 100644
--- a/apps/desktop/src/app/chat/session-status-dot.test.tsx
+++ b/apps/desktop/src/app/chat/session-status-dot.test.tsx
@@ -37,6 +37,18 @@ describe('SessionStatusDot published status', () => {
     }
   )
 
+  it.each([
+    ['running', 'waiting', 'Running'],
+    ['waiting', 'running', 'Waiting']
+  ] as const)('labels published %s without consulting legacy %s', (kind, legacyKind, label) => {
+    const { container } = mount(canonicalOutcome('waiting', { kind }, { kind: legacyKind }))
+    const dot = container.querySelector('[data-session-status-dot]')!
+    expect(dot.getAttribute('data-session-status-dot')).toBe('waiting')
+    expect(dot.getAttribute('aria-label')).toBe(label)
+    expect(dot.getAttribute('title')).toBe(label)
+    expect(dot.className).not.toContain('bg-(--ui-success)')
+  })
+
   it('announces a canonical never-started session as draft, not Running', () => {
     // Shape published by reduce_status for an empty transcript with complete source reads.
     const status = {
@@ -46,8 +58,8 @@ describe('SessionStatusDot published status', () => {
       presentation: { stripe: 'none', reason_codes: ['never_started'] }
     }
     const { container } = mount({ kind: 'unresolved', status })
-
     const dot = container.querySelector('[data-session-status-dot]')!
+
     expect(dot.getAttribute('data-session-status-dot')).toBe('none')
     expect(dot.getAttribute('aria-label')).toBe('Draft — nothing sent yet')
     expect(dot.getAttribute('title')).toBe('Draft — nothing sent yet')
diff --git a/apps/desktop/src/app/chat/session-status-dot.tsx b/apps/desktop/src/app/chat/session-status-dot.tsx
index 2e416b876b..56dfe0f24a 100644
--- a/apps/desktop/src/app/chat/session-status-dot.tsx
+++ b/apps/desktop/src/app/chat/session-status-dot.tsx
@@ -106,7 +106,7 @@ export const sessionDotVariant = (
         : stripe === 'stuck' ? r.outcomeDecision
           : stripe === 'blocked' ? r.outcomeMuted
             : stripe === 'attention' ? r.outcomeUnresolved(null)
-              : stripe === 'waiting' ? r.outcomeWaiting
+              : stripe === 'waiting' ? outcome?.status?.kind === 'running' ? r.outcomeRunning : r.outcomeWaiting
                 : r.draftSession
 
   return {
diff --git a/apps/desktop/src/app/chat/sidebar/session-row.test.tsx b/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
index c2f5aa98b3..bacad4572e 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
@@ -1179,7 +1179,7 @@ describe('SidebarSessionRow own activity stamps', () => {
 
     try {
       const { container } = renderRow(
-        makeSession({ outcome: canonicalOutcome('none', {}, { kind: 'running' }),
+        makeSession({ outcome: canonicalOutcome('waiting', { kind: 'running' }, { kind: 'running' }),
           execution_observations: [fixture.base],
           id: 'running-card',
           kanban_active: 1,
@@ -1190,7 +1190,7 @@ describe('SidebarSessionRow own activity stamps', () => {
         } as Partial<SessionInfo> & { title: string })
       )
 
-      expect(container.querySelector('[role="status"][aria-label="Running"]')?.getAttribute('data-session-status-dot')).toBe('none')
+      expect(container.querySelector('[role="status"][aria-label="Running"]')?.getAttribute('data-session-status-dot')).toBe('waiting')
       expect(container.querySelector('[aria-label="Open work, current status unknown"]')).toBeNull()
     } finally {
       vi.useRealTimers()
@@ -1540,7 +1540,7 @@ describe('SidebarSessionRow stored outcome', () => {
           kanban_active: 2,
           kanban_parked: 2,
           message_count: 4,
-          outcome: canonicalOutcome(({ waiting: 'waiting', running: 'none', unresolved: 'attention', decision: 'stuck' } as const)[outcome.kind], {}, { ...outcome, items: 'items' in outcome ? [...outcome.items] : undefined, on: 'on' in outcome ? [...outcome.on] : undefined }),
+          outcome: canonicalOutcome(({ waiting: 'waiting', running: 'waiting', unresolved: 'attention', decision: 'stuck' } as const)[outcome.kind], { kind: outcome.kind }, { ...outcome, items: 'items' in outcome ? [...outcome.items] : undefined, on: 'on' in outcome ? [...outcome.on] : undefined }),
           title: 'Parked cards'
         } as Partial<SessionInfo> & { title: string })
       )
-- 
2.43.0

