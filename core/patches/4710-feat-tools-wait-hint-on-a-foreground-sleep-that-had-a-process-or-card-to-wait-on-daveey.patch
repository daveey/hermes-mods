diff --git a/tests/tools/test_terminal_tool_wait_hint.py b/tests/tools/test_terminal_tool_wait_hint.py
new file mode 100644
index 0000000000000000000000000000000000000000..ce44eb21123dac59a465bf70f3e99f38d425b383
