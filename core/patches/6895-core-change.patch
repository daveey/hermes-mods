diff --git a/hermes_cli/kanban_replay_recovery.py b/hermes_cli/kanban_replay_recovery.py
index c6f7a1f3e62ffc6d4bfc84b2d588d8b6359a3c68..b93b1e783dff5eac95211f54ed0209fcdf6a671f 100644
