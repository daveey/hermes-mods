From ac903862595b5fe323ccc276ca070f85f0bb9764 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 18:58:11 +0000
Subject: [PATCH] [daveey] hub-read roots: a backslash-newline line
 continuation no longer hides a `..` or cd

`_strip_read_paths` judged `_DOTDOT` and `_CHDIR` on text with only quotes and
backslashes removed. Bash removes the whole `\<newline>` before it splits words,
so `.\<NL>.` is a `..` and `c\<NL>d` a cd, and these cleared the logs root
(review 5896219134 of PR #2518, pre-existing on base 82d31e6c5d):

- `cat ~/.hermes/logs/x.log .\<NL>./.env`
- `c\<NL>d ~/.hermes/logs && cat .\<NL>./.env`
- `c\<NL>d ~/.hermes/logs && cat auth.json`

Fix: also judge a spelling with every `\\\n` removed first. The old spelling is
still judged too. Only `\n` continues a line: a backslash before `\r` quotes the
CR and the following newline starts a new command, so stripping `\\\r?\n` would
glue `cat x\<CR><NL>cd ~/.hermes/logs` into `xcd` and clear it. A fourth row
pins that case.

Five whys: the split spelling modelled backslash as "drop the backslash", which
is right for every escaped character except newline, where bash drops both.
Severity matches #2405: misplacement only, since hub-read enforces READ_ROOTS.

Proof:
- RED on main cafc6b7689: the three card rows fail (`reason` is None); the CR
  row already pins there.
- GREEN: tests/hermes_cli/test_kanban_hub_read_roots.py plus every test file
  importing kanban_placement_coordination (18 files, 1022 passed);
  scripts/check --base origin/main ok.
- Mutant `\\\r?\n` with a single joined spelling turns the CR row RED.
- Real bash, HOME=<scratch>: rows 1-2 print a file in <scratch>/.hermes
  (outside logs), row 3 prints logs/auth.json, row 4 runs the cd.
---
 hermes_cli/kanban_placement_coordination.py    | 10 +++++++---
 tests/hermes_cli/test_kanban_hub_read_roots.py |  7 +++++++
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_placement_coordination.py b/hermes_cli/kanban_placement_coordination.py
index 4c1c682e18..e7855f291a 100644
--- a/hermes_cli/kanban_placement_coordination.py
+++ b/hermes_cli/kanban_placement_coordination.py
@@ -195,12 +195,16 @@ _EXPANSION = re.compile(r"\$[({'\"]")
 _PARAMETER = re.compile(r"\$[\w*]")
 _BACKTICK = re.compile(r"`")
 _CHDIR = re.compile(r"(?<![\w.-])(?:cd|pushd|popd)(?![\w.-])(?![ \t]+(?:~|/)(?![^\s;&|]*\.hermes)[\w./-]*(?=$|[\s;&|)]))")
+# Bash removes a whole backslash-newline before it splits words, so ``.\<NL>.`` is a ``..`` and ``c\<NL>d`` a cd
+# (review 5896219134 nit). Only ``\n`` continues a line: a backslash before ``\r`` quotes the CR, and the newline
+# after it starts a new command. Both spellings are judged, so neither join can hide a cd or ``..`` from the other.
+_CONTINUATION = re.compile(r"\\\n")
 
 
 def _strip_read_paths(text, roots):
-    split = _SPLIT.sub("", text)
-    if (_DOTDOT.search(text) or _DOTDOT.search(split) or _EXPANSION.search(text) or _PARAMETER.search(text)
-            or _BACKTICK.search(text) or _CHDIR.search(split)):
+    splits = {_SPLIT.sub("", text), _SPLIT.sub("", _CONTINUATION.sub("", text))}
+    if (_DOTDOT.search(text) or _EXPANSION.search(text) or _PARAMETER.search(text) or _BACKTICK.search(text)
+            or any(_DOTDOT.search(split) or _CHDIR.search(split) for split in splits)):
         return text
     # Keep a separator so the words around a removed path cannot merge into a new marker.
     return _STATE_PATH.sub(
diff --git a/tests/hermes_cli/test_kanban_hub_read_roots.py b/tests/hermes_cli/test_kanban_hub_read_roots.py
index be1e412ea7..32050c2d32 100644
--- a/tests/hermes_cli/test_kanban_hub_read_roots.py
+++ b/tests/hermes_cli/test_kanban_hub_read_roots.py
@@ -171,6 +171,13 @@ def test_malformed_roots_clear_nothing(attested, roots):
     "`printf 'c\\x64'` ~/.hermes/logs && cat `printf '\\56\\56'`/.env",
     "c''d ~/.hermes/logs && cat auth.json",
     "c\\d ~/.hermes/logs && cat auth.json",
+    # Bash drops a whole backslash-newline line continuation before it splits words, so it joins the dots of a
+    # ``..`` and the letters of a cd (review 5896219134 nit): the second reads <home>/.hermes/.env. A backslash
+    # before a carriage return only quotes that CR, so the newline after it still starts a new command.
+    "cat ~/.hermes/logs/x.log .\\\n./.env",
+    "c\\\nd ~/.hermes/logs && cat .\\\n./.env",
+    "c\\\nd ~/.hermes/logs && cat auth.json",
+    "cat x\\\r\ncd ~/.hermes/logs && cat .env",
     # One row per exact anchor of the root-clearing guards: a mutant of each passed every other row.
     'ssh hermes-hub cat --file="~/.hermes/logs/a b/c"',
     "ssh hermes-hub cat ~/.hermes/logs/x.log .\\./.env",
