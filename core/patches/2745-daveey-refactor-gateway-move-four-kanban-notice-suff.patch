From 3394e943799e797897ae2233aaf586ff796f1c50 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 12:16:53 +0000
Subject: [PATCH] [daveey] refactor(gateway): move four kanban notice suffixes
 into kanban_notice_text

session_notifications.py sits at its 2000-line FILE_LINES cap on main; the probe-loss
notice path adds net +5 lines there. Move the timed_out/quota/repin/parent-unclaimed
suffix helpers (pure text, no registry state) to the existing sibling and import them
under their old private names, so _KANBAN_EVENT_FORMATTERS is unchanged.
---
 tui_gateway/kanban_notice_text.py    | 26 ++++++++++++++++++++++++++
 tui_gateway/session_notifications.py | 26 ++------------------------
 2 files changed, 28 insertions(+), 24 deletions(-)

diff --git a/tui_gateway/kanban_notice_text.py b/tui_gateway/kanban_notice_text.py
index f96c64c96e..92973a0295 100644
--- a/tui_gateway/kanban_notice_text.py
+++ b/tui_gateway/kanban_notice_text.py
@@ -1,5 +1,7 @@
 """Small Kanban notice text helpers independent of the session registry."""
 
+import contextlib
+
 
 def chat_wait_suffix(payload: dict) -> str:
     from hermes_cli.kanban_chat_wait import notice_text
@@ -10,3 +12,27 @@ def failure_suffix(kind: str, payload: dict, title: str) -> str:
     """Cause-accurate failure wording shared by the Desktop failure formatters."""
     from hermes_cli.kanban_failure_summary import describe_failure
     return describe_failure(kind, title, payload)
+
+
+def timed_out_suffix(task, payload: dict, title: str) -> str:
+    from hermes_cli.kanban_failure_summary import retry_promised
+    limit = 0
+    with contextlib.suppress(TypeError, ValueError):
+        limit = int(payload.get("limit_seconds") or 0)
+    tail = "; will retry" if retry_promised(payload) else "; retry state was not recorded"
+    return f" timed out (max_runtime={limit}s){tail}"
+
+
+def quota_episode_suffix(payload: dict) -> str:
+    from hermes_cli.kanban_quota_episode import notice_text
+    return notice_text(payload)
+
+
+def repin_suffix(payload: dict) -> str:
+    from hermes_cli.kanban_repin_notice import notice_text
+    return ": " + notice_text(payload)
+
+
+def parent_unclaimed_suffix(payload: dict) -> str:
+    from hermes_cli.kanban_parent_unclaimed import notice_text
+    return ": " + notice_text(payload)
diff --git a/tui_gateway/session_notifications.py b/tui_gateway/session_notifications.py
index 29f269873f..1c78e9ecff 100644
--- a/tui_gateway/session_notifications.py
+++ b/tui_gateway/session_notifications.py
@@ -9,6 +9,8 @@ import threading
 
 from .method_ctx import bind_module
 from .kanban_notice_text import chat_wait_suffix as _kb_chat_wait, failure_suffix as _kb_failure
+from .kanban_notice_text import parent_unclaimed_suffix as _kb_parent_unclaimed, quota_episode_suffix as _kb_quota_episode
+from .kanban_notice_text import repin_suffix as _kb_repin_notice, timed_out_suffix as _kb_timed_out
 
 
 def _notif_locked_sessions(fn, default):
@@ -588,30 +590,6 @@ def _kb_left_open(payload: dict) -> str:
     return f"\n{notice}" if notice else ""
 
 
-def _kb_timed_out(task, payload: dict, title: str) -> str:
-    from hermes_cli.kanban_failure_summary import retry_promised
-    limit = 0
-    with contextlib.suppress(TypeError, ValueError):
-        limit = int(payload.get("limit_seconds") or 0)
-    tail = "; will retry" if retry_promised(payload) else "; retry state was not recorded"
-    return f" timed out (max_runtime={limit}s){tail}"
-
-
-def _kb_quota_episode(payload: dict) -> str:
-    from hermes_cli.kanban_quota_episode import notice_text
-    return notice_text(payload)
-
-
-def _kb_repin_notice(payload: dict) -> str:
-    from hermes_cli.kanban_repin_notice import notice_text
-    return ": " + notice_text(payload)
-
-
-def _kb_parent_unclaimed(payload: dict) -> str:
-    from hermes_cli.kanban_parent_unclaimed import notice_text
-    return ": " + notice_text(payload)
-
-
 # kind -> (glyph, suffix after "Kanban <id>"); silent kinds (archived/unblocked) are absent → None.
 _KANBAN_EVENT_FORMATTERS = {
     "request_withdrawn": ("ℹ", lambda t, p, title: " request withdrawn: the card was archived. "
-- 
