From 375b9402e1068422f8e97564c59619c248522b38 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 06:53:07 +0000
Subject: [PATCH] [daveey] Repair remaining native shell execution premises

Native RED job134627076058: 8 failures from Bash3 case-pattern parsing, absent GNU timeout, and BSD cp lacking -t. Pin the Bash3 syntax rejection while retaining every scanner assertion and add an executing balanced-pattern twin. Model only timeout argv forwarding and GNU cp target-directory syntax with isolated fixture executables; parent subprocess deadlines remain. Linux focused suites pass; native GREEN still required.
---
 .../test_lifecycle_guard_compound_output_sink.py  | 15 ++++++++++++++-
 .../test_lifecycle_guard_generated_scripts.py     | 15 ++++++++++++++-
 .../cron/test_lifecycle_guard_session_aliases.py  | 10 +++++++++-
 3 files changed, 37 insertions(+), 3 deletions(-)

diff --git a/tests/cron/test_lifecycle_guard_compound_output_sink.py b/tests/cron/test_lifecycle_guard_compound_output_sink.py
index 1cbf2ba93239ba20e0a9d70032da1d191bbd7aa8..9fd6c3d341c8367bd56db89c1abbaae5a1b8fd23 100644
--- a/tests/cron/test_lifecycle_guard_compound_output_sink.py
+++ b/tests/cron/test_lifecycle_guard_compound_output_sink.py
@@ -11,7 +11,8 @@ from tools.shell_heredoc import output_reaches_shell
 
 _BODIES = ["cd .; {sink}", ":; {sink}", "( {sink} )", "\n{sink}\n",
            "true && {sink}", "false || {sink}", "{{ :; {sink}; }}",
-           "if true; then {sink}; fi", "case x in x) {sink};; esac"]
+           "if true; then {sink}; fi", "case x in x) {sink};; esac",
+           "case x in (x) {sink};; esac"]
 
 
 @pytest.mark.parametrize("body", _BODIES)
@@ -43,6 +44,18 @@ def _assert_execution(command, tmp_path, marker, shell):
     result = subprocess.run([bash, "--noprofile", "--norc", "-c", command],
                             cwd=tmp_path, capture_output=True, text=True,
                             encoding="utf-8", timeout=15, check=False)
+    if " > >( case x in x) " in command:
+        major = subprocess.check_output(
+            [bash, "--noprofile", "--norc", "-c", 'printf "%s" "${BASH_VERSINFO[0]}"'],
+            text=True, encoding="utf-8", timeout=5,
+        )
+        if int(major) < 4:
+            # Bash 3 mistakes the unbalanced case-pattern ')' for the process
+            # substitution closer. Pin that rejection; scanner assertions in
+            # the caller still run, and the (x) twin executes on every Bash.
+            assert result.returncode != 0 and "syntax error" in result.stderr
+            assert not marker.exists()
+            return
     assert result.returncode == 0, result.stderr
     assert marker.exists() is shell, command
     if shell:
diff --git a/tests/cron/test_lifecycle_guard_generated_scripts.py b/tests/cron/test_lifecycle_guard_generated_scripts.py
index ab0f20bcce7c5bf81f37200f595c0df242a3cf37..37894ac9b2d0a2a23e19f709d16bbfced56cc0f0 100644
--- a/tests/cron/test_lifecycle_guard_generated_scripts.py
+++ b/tests/cron/test_lifecycle_guard_generated_scripts.py
@@ -8,6 +8,7 @@ marker first. (A literal lifecycle command cannot run here: tests/conftest.py bl
 """
 
 import base64
+import os
 import shutil
 import subprocess
 
@@ -93,9 +94,21 @@ def test_printed_and_herestring_writes_are_scanned(tmp_path, big, template):
     "cat > G <<'R'\nBODY\nR\ncp -t sub G; bash sub/G\n",
     "cat > G <<'R'\nBODY\nR\nln -s G F; bash F\n",
 ])
-def test_unpredictable_writer_then_execute_fails_closed(tmp_path, big, template):
+def test_unpredictable_writer_then_execute_fails_closed(tmp_path, big, template, monkeypatch):
     command = (template.replace("REVERSED", big[::-1]).replace("BODY", big)
                .replace("B64", base64.b64encode(f"{big}\n".encode()).decode()))
+    if "cp -t sub G" in command:
+        # Model GNU's target-directory argv on BSD too. Keep the scanned text
+        # unchanged, and still perform a real copy and execute its payload.
+        bindir = tmp_path / "bin"
+        bindir.mkdir()
+        copier = bindir / "cp"
+        copier.write_text(
+            '#!/bin/sh\n[ "$1" = -t ] || exit 64\ndest=$2\nshift 2\nexec /bin/cp "$@" "$dest"\n',
+            encoding="utf-8",
+        )
+        copier.chmod(0o700)
+        monkeypatch.setenv("PATH", f"{bindir}{os.pathsep}{os.environ['PATH']}")
     assert _differential(tmp_path, command)
 
 
diff --git a/tests/cron/test_lifecycle_guard_session_aliases.py b/tests/cron/test_lifecycle_guard_session_aliases.py
index 61bdf3df6b53823da7f28b830859e98c5f05352e..d244a527c2b6fc2f8a9f23cc7d63d38410da0bb0 100644
--- a/tests/cron/test_lifecycle_guard_session_aliases.py
+++ b/tests/cron/test_lifecycle_guard_session_aliases.py
@@ -889,7 +889,7 @@ def test_first_hop_payload_patch_is_data(tmp_path, live_kanban_db, payload):
 
 @pytest.mark.parametrize("prefix", ["", "env ", "timeout 5 ", "nice ", "command "])
 @pytest.mark.parametrize("flags", ["-c", "-ec", "-o pipefail -c"])
-def test_first_host_patch_wrapper_real_bash(tmp_path, live_kanban_db, prefix, flags):
+def test_first_host_patch_wrapper_real_bash(tmp_path, live_kanban_db, prefix, flags, monkeypatch):
     import shlex
 
     from tools.environments.local import build_subprocess_env
@@ -899,6 +899,14 @@ def test_first_host_patch_wrapper_real_bash(tmp_path, live_kanban_db, prefix, fl
     patch_file.write_text("diff --git a/proof.txt b/proof.txt\nnew file mode 100644\n"
                           "--- /dev/null\n+++ b/proof.txt\n@@ -0,0 +1 @@\n+" + body)
     payload = f"{prefix}bash {flags} 'git apply'"
+    # The parent enforces a hard timeout; this fixture needs only argv/stdin
+    # forwarding, not GNU coreutils (absent on the room minis).
+    bindir = tmp_path / "bin"
+    bindir.mkdir()
+    timeout = bindir / "timeout"
+    timeout.write_text('#!/bin/sh\nshift\nexec "$@"\n', encoding="utf-8")
+    timeout.chmod(0o700)
+    monkeypatch.setenv("PATH", f"{bindir}{os.pathsep}{os.environ['PATH']}")
     with patch_file.open() as stream:
         result = subprocess.run(["/bin/bash", "--noprofile", "--norc", "-c", payload],
                                 stdin=stream, cwd=tmp_path, env=build_subprocess_env(),
