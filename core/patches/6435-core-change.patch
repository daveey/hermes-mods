Subject: [PATCH 6435] Spend review, decided-triage repair and spend-stop watch

Public mirror of source commit eb417fba94a7b162032e5073eb89cc5394fcad80.

---
diff --git a/hermes_cli/kanban_hold_notices.py b/hermes_cli/kanban_hold_notices.py
index f10d201ce29..de7e7277ea6 100644
--- a/hermes_cli/kanban_hold_notices.py
+++ b/hermes_cli/kanban_hold_notices.py
@@ -85,12 +85,16 @@
     from hermes_cli import kanban_db as kb
     from hermes_cli.kanban_dispatch_storage import DispatchWriteContended
     from hermes_cli.kanban_hold_effective import current, previous
+    from hermes_cli.kanban_spend_decision import strict_episode
     from hermes_cli.kanban_wake_check import foreign_ids
     foreign = foreign_ids(conn)
     for (tid,) in conn.execute("SELECT id FROM tasks WHERE status='triage'").fetchall():
         if tid in foreign:
             continue
         try:
+            # A malformed historical cause publishes no notice: the strict read raises
+            # here and this card's hold is retained while siblings and dispatch go on.
+            strict_episode(conn, tid)
             hold = current(conn, tid)
             if hold is None:
                 continue
diff --git a/tests/hermes_cli/test_kanban_hold_failure_isolation.py b/tests/hermes_cli/test_kanban_hold_failure_isolation.py
index 1c35caef353..d6358c154d0 100644
--- a/tests/hermes_cli/test_kanban_hold_failure_isolation.py
+++ b/tests/hermes_cli/test_kanban_hold_failure_isolation.py
@@ -31,7 +31,7 @@
     return [e for e in kb.list_events(conn, tid) if e.kind == 'spend_budget_decision_ready']
 
 
-@pytest.mark.parametrize('cause', [[], {}])
+@pytest.mark.parametrize('cause', [[], {}, 7])
 def test_reclaim_survives_malformed_historical_cause(kanban_home, cause, monkeypatch, caplog):
     upkeep = []
     monkeypatch.setattr(walls, 'tick_upkeep', lambda *a, **kw: upkeep.append(True))
