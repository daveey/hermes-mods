From a994fd14406c876c69c8c1871e7218aaed1cf51e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 22:17:52 +0000
Subject: [PATCH] fix(desktop): preserve ownership recovery action label across
 error card v2 merge

---
 .../components/assistant-ui/thread/assistant-message.tsx  | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/components/assistant-ui/thread/assistant-message.tsx b/apps/desktop/src/components/assistant-ui/thread/assistant-message.tsx
index 96030f65a35..b43e296d8f7 100644
--- a/apps/desktop/src/components/assistant-ui/thread/assistant-message.tsx
+++ b/apps/desktop/src/components/assistant-ui/thread/assistant-message.tsx
@@ -1245,8 +1245,12 @@ const ERROR_ACTION_RENDERERS: Record<ErrorActionId, (ctx: ErrorActionContext) =>
   compress: ({ className, copy }) => (
     <CompressConversationAction className={className} label={copy.errorCompressConversation} />
   ),
-  start_new_session: ({ className, copy, link }) =>
-    textButton(className, requestFreshSession, link ? copy.errorStartNewChatLink : copy.errorStartNewSession),
+  start_new_session: ({ className, copy, link, surface }) =>
+    textButton(
+      className,
+      requestFreshSession,
+      link && surface?.code !== 'SESSION_NOT_OWNED' ? copy.errorStartNewChatLink : copy.errorStartNewSession
+    ),
   edit_message: ({ className, copy }) => <EditPreviousMessageAction className={className} label={copy.editMessage} />,
   open_hermes_folder: ({ className, copy, ownerProfile }) =>
     window.hermesDesktop?.logsRoot
-- 
