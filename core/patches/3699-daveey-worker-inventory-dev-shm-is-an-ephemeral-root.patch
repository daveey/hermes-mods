From 189331b431e1aaca74b8bd8cf258f12f8074659b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 16:50:01 +0000
Subject: [PATCH] [daveey] worker inventory: /dev/shm is an ephemeral root, so
 a deleted state-suite shard board retires

---
 hermes_cli/worker_account_boards.py           | 11 +++++--
 .../hermes_cli/test_worker_account_boards.py  | 30 +++++++++++++++++++
 2 files changed, 39 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/worker_account_boards.py b/hermes_cli/worker_account_boards.py
index 1d73ae5035..931932b881 100644
--- a/hermes_cli/worker_account_boards.py
+++ b/hermes_cli/worker_account_boards.py
@@ -4,7 +4,7 @@ Registration happens under account admission.lock before the final gate. Records
 survive process exits: a parked dispatcher is not evidence its running rows or
 jobs vanished. Missing registered DBs are unknown, never silently free capacity,
 except a board whose whole directory was removed from an ephemeral root (system
-temp, the account scratch dir): that workspace was garbage-collected, so its
+temp, /dev/shm, the account scratch dir): that workspace was garbage-collected, so its
 record retires instead of holding every claim on the host forever.
 
 Reads (``paths()``, called by ``refusal()`` and the never-mutating
@@ -59,10 +59,17 @@ def _refuse_test_registration() -> None:
                            f'inventory ({real}); is worker_compute_capacity.policy_root isolated?')
 
 
+# RAM-backed, boot-cleared temp roots. No real board lives there: state's run-state-suite-local runs its shards
+# with TMPDIR on /dev/shm, and a shard board left registered there held every claim on worker-1 for 17 min
+# (2026-11-13, t_01a1d5bf526e1344).
+TMPFS_ROOTS: tuple[Path, ...] = (Path('/dev/shm'),)
+
+
 def _ephemeral_roots() -> list[Path]:
     account = capacity.policy_root().resolve()
     # no-tmp: ok — matches boards OTHER processes made in system temp (pytest tmp_path), not our own scratch
-    roots = {Path('/tmp'), Path('/var/tmp'), Path(tempfile.gettempdir()), account / 'cache' / 'scratch'}
+    roots = {Path('/tmp'), Path('/var/tmp'), Path(tempfile.gettempdir()), account / 'cache' / 'scratch',
+             *TMPFS_ROOTS}
     # An odd TMPDIR (a home or /) must never make the account's own boards ephemeral.
     return [root for root in (r.resolve() for r in roots) if not account.is_relative_to(root)]
 
diff --git a/tests/hermes_cli/test_worker_account_boards.py b/tests/hermes_cli/test_worker_account_boards.py
index 48642f84ae..63acb63171 100644
--- a/tests/hermes_cli/test_worker_account_boards.py
+++ b/tests/hermes_cli/test_worker_account_boards.py
@@ -298,6 +298,36 @@ def test_ephemeral_roots_never_cover_the_account(monkeypatch, tmp_path):
     assert not any(account.resolve().is_relative_to(root) for root in roots)
 
 
+def test_tmpfs_root_is_ephemeral(monkeypatch, tmp_path):
+    """/dev/shm is RAM-backed and boot-cleared: run-state-suite-local puts its shards' TMPDIR there."""
+    monkeypatch.setattr(capacity, 'policy_root', lambda: tmp_path / 'home' / '.hermes')
+    assert Path('/dev/shm').resolve() in inventory._ephemeral_roots()
+
+
+def test_board_removed_from_a_tmpfs_root_retires_like_tmp(monkeypatch, tmp_path):
+    """worker-1, 2026-11-13 16:09-16:26Z: a state-suite shard's board under /dev/shm/<run>/shard-5 stayed
+    registered after the run deleted it, and every claim on the host deferred worker_resources_unknown."""
+    account = tmp_path / 'account'
+    account.mkdir()
+    shm = tmp_path / 'shm'
+    monkeypatch.setattr(capacity, 'policy_root', lambda: account)
+    monkeypatch.setattr(inventory, 'TMPFS_ROOTS', (shm,))
+    monkeypatch.setattr(tempfile, 'gettempdir', lambda: str(tmp_path / 'not-shm'))
+    shard = shm / 'state-suite-local-x' / 'shard-5' / 'tmpabc' / '.hermes'
+    shard.mkdir(parents=True)
+    _registered(shard / 'kanban.db')
+    record, = (account / 'worker-resources' / 'boards').glob('*.json')
+    shutil.rmtree(shm / 'state-suite-local-x')
+    assert inventory.paths() == []  # the census no longer refuses every claim
+    live = shm / 'live' / 'kanban.db'
+    live.parent.mkdir(parents=True)
+    _registered(live)  # the fenced path retires the collected record
+    assert not record.exists()
+    live.unlink()  # its directory survives: a moving board under the tmpfs root still refuses
+    with pytest.raises(FileNotFoundError):
+        inventory.paths()
+
+
 def test_pytest_never_registers_in_the_real_account_inventory(monkeypatch, tmp_path):
     """monkeypatch.undo() drops conftest's policy_root isolation; register must still refuse."""
     monkeypatch.setattr(hermes_constants, '_account_home', lambda: tmp_path)
-- 
