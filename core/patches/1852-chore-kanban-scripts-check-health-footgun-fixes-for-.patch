From 2e478ab23939d885e8ad121520563678f23fea43 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 07:59:09 +0000
Subject: [PATCH] chore(kanban): scripts/check health/footgun fixes for the hub
 CPU gate (utf-8-sig, kanban_db line cap, HX013 reasons) [daveey]

---
 hermes_cli/kanban_db.py                             | 10 +++-------
 hermes_cli/machine_metrics.py                       |  2 +-
 tests/hermes_cli/test_kanban_hub_admission.py       |  4 ++--
 tests/hermes_cli/test_kanban_sync_metrics_budget.py |  4 ++--
 4 files changed, 8 insertions(+), 12 deletions(-)

diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index 7f3d9926ec8..ebf0a7bd765 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -2194,10 +2194,8 @@ def claim_task(
     now = int(time.time())
     lock = claimer or _claimer_id()
     expires = now + _resolve_claim_ttl_seconds(ttl_seconds)
-    # [daveey] Refuse a held fence before the Board-service lease, not after it.
-    if admission_hold_set():
-        return None
-    if hub_cpu_advisory(task_id):  # lock-free, before the Board lease; the locked gate stays authoritative
+    # [daveey] Refuse a held fence, and a lock-free hub CPU advisory (final gate is under the lock), before the lease.
+    if admission_hold_set() or hub_cpu_advisory(task_id):
         return None
     gate = _sync.claim_gate(conn, task_id, expires)
     if gate.deferred:
@@ -2237,9 +2235,7 @@ def claim_review_task(
     now = int(time.time())
     lock = claimer or _claimer_id()
     expires = now + _resolve_claim_ttl_seconds(ttl_seconds)
-    if admission_hold_set():  # [daveey] before the Board-service lease (see claim_task)
-        return None
-    if hub_cpu_advisory(task_id):
+    if admission_hold_set() or hub_cpu_advisory(task_id):  # [daveey] before the Board-service lease (see claim_task)
         return None
     gate = _sync.claim_gate(conn, task_id, expires, lane="review")
     if gate.deferred:
diff --git a/hermes_cli/machine_metrics.py b/hermes_cli/machine_metrics.py
index 104a5485001..b2a7fec9692 100644
--- a/hermes_cli/machine_metrics.py
+++ b/hermes_cli/machine_metrics.py
@@ -155,7 +155,7 @@ def record_hub_cpu_sample(sample: dict, root: Optional[Path] = None) -> None:
 def read_hub_cpu_sample(root: Optional[Path] = None) -> Optional[dict]:
     import json
     try:
-        doc = json.loads(_hub_cpu_path(root).read_text(encoding="utf-8"))
+        doc = json.loads(_hub_cpu_path(root).read_text(encoding="utf-8-sig"))
     except (OSError, ValueError):
         return None
     return doc if isinstance(doc, dict) else None
diff --git a/tests/hermes_cli/test_kanban_hub_admission.py b/tests/hermes_cli/test_kanban_hub_admission.py
index 70999c0c91c..f294f04ce92 100644
--- a/tests/hermes_cli/test_kanban_hub_admission.py
+++ b/tests/hermes_cli/test_kanban_hub_admission.py
@@ -226,7 +226,7 @@ def test_simultaneous_claimers_at_6_of_7_start_at_most_one(board, monkeypatch):
         with gate_lock:
             return count["running"]
     monkeypatch.setattr(mm, "active_card_runs", active)
-    monkeypatch.setattr(cm, "sample", fake_sample(10.0, check=lambda: time.sleep(0.2)))
+    monkeypatch.setattr(cm, "sample", fake_sample(10.0, check=lambda: time.sleep(0.2)))  # health: allow HX013 -- stands in for the ~1 s sample held under the lock
     tasks = [task(conn, title=f"t{i}") for i in range(4)]
 
     def go(t):
@@ -266,7 +266,7 @@ def test_real_sample_is_entirely_under_lock_bounded_and_measures_chat_turn_cost(
 
     def chat_turn():
         started.wait(5)
-        time.sleep(0.2)  # inside the claim's ~1 s sample
+        time.sleep(0.2)  # health: allow HX013 -- positions the chat turn inside the claim's real ~1 s sample
         m["chat_try"] = time.monotonic()
         try:
             with af.admission_lock(home, timeout=backend_retirement.BUSY_WAIT_S):
diff --git a/tests/hermes_cli/test_kanban_sync_metrics_budget.py b/tests/hermes_cli/test_kanban_sync_metrics_budget.py
index 75088315cc9..366d8387c90 100644
--- a/tests/hermes_cli/test_kanban_sync_metrics_budget.py
+++ b/tests/hermes_cli/test_kanban_sync_metrics_budget.py
@@ -25,7 +25,7 @@ class Server:
                 n = int(self.headers.get("content-length") or 0)
                 outer.requests.append((self.path, self.rfile.read(n)))
                 if mode == "stall":
-                    time.sleep(4)
+                    time.sleep(4)  # health: allow HX013 -- the stalled server is the behaviour under test
                     body = b"{}"
                     self.send_response(200)
                     self.send_header("content-length", str(len(body)))
@@ -42,7 +42,7 @@ class Server:
                             self.wfile.flush()
                         except OSError:
                             return
-                        time.sleep(0.4)
+                        time.sleep(0.4)  # health: allow HX013 -- trickling bytes is the behaviour under test
                 else:
                     body = b'{"ok": true}'
                     self.send_response(200)
