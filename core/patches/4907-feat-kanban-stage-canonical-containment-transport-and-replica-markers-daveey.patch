--- /dev/null
+++ b/tests/hermes_cli/test_kanban_containment_actor.py
@@ -0,0 +1,100 @@
+"""Runtime admission for CLI/tool containment, never caller-supplied identity."""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from hermes_cli import kanban_containment_actor as actors
+from hermes_cli import kanban_db as kb
+from hermes_cli.kanban_containment_lifecycle import ContainmentRefused
+from tests.hermes_cli import test_kanban_containment_lifecycle as fixtures
+
+board = fixtures.board
+
+
+def bind(conn, monkeypatch):
+    relay, _, _, _, _ = fixtures.setup(conn)
+    task = kb.get_task(conn, relay)
+    assert task is not None
+    path = conn.execute("PRAGMA database_list").fetchone()[2]
+    session = "fixture-contained-owner"
+    for key, value in {"HERMES_KANBAN_DB": path, "HERMES_KANBAN_TASK": relay,
+                       "HERMES_KANBAN_RUN_ID": str(task.current_run_id),
+                       "HERMES_KANBAN_CLAIM_LOCK": task.claim_lock, "HERMES_SESSION_ID": session}.items():
+        monkeypatch.setenv(key, value)
+    from gateway.session_context import scoped_current_session_id
+    monkeypatch.delenv("HERMES_DELEGATED_CHILD_CONTEXT", raising=False)
+    with scoped_current_session_id(session):
+        kb._append_event(conn, relay, "owner_admitted", {"session_id": session}, run_id=task.current_run_id)
+    return relay, task.current_run_id, session
+
+
+def test_exact_runtime_claim_and_owner_session_are_required(board, monkeypatch):
+    relay, _, session = bind(board, monkeypatch)
+    from gateway.session_context import scoped_current_session_id
+    with scoped_current_session_id(session):
+        actor = actors.current_actor(board)
+    assert actor.task == relay
+    assert actor.run_uid == fixtures.run_uid(board, relay)
+
+
+@pytest.mark.parametrize("key,value", [
+    ("HERMES_KANBAN_TASK", ""), ("HERMES_KANBAN_TASK", "t_da066fc02a25c3b2"),
+    ("HERMES_KANBAN_DB", ""), ("HERMES_KANBAN_DB", "/does-not-exist/fixture.db"),
+    ("HERMES_KANBAN_RUN_ID", ""), ("HERMES_KANBAN_RUN_ID", "bad"),
+    ("HERMES_KANBAN_RUN_ID", "١"), ("HERMES_KANBAN_RUN_ID", "9999999"),
+    ("HERMES_KANBAN_CLAIM_LOCK", ""), ("HERMES_KANBAN_CLAIM_LOCK", "other"),
+])
+def test_missing_or_changed_runtime_pins_refuse(board, monkeypatch, key, value):
+    _, _, session = bind(board, monkeypatch)
+    monkeypatch.setenv(key, value)
+    from gateway.session_context import scoped_current_session_id
+    with scoped_current_session_id(session), pytest.raises(ContainmentRefused):
+        actors.current_actor(board)
+
+
+@pytest.mark.parametrize("scope", ["delegate", "cron"])
+def test_inprocess_child_cannot_borrow_workers_claim(board, monkeypatch, scope):
+    _, _, session = bind(board, monkeypatch)
+    from agent.delegation_context import delegated_child_context, non_dispatcher_owned_context
+    from gateway.session_context import scoped_current_session_id
+    context = delegated_child_context() if scope == "delegate" else non_dispatcher_owned_context()
+    with context, scoped_current_session_id(session), pytest.raises(ContainmentRefused):
+        actors.current_actor(board)
+
+
+def test_informational_worker_task_never_grants_admission(board, monkeypatch):
+    relay, _, session = bind(board, monkeypatch)
+    monkeypatch.delenv("HERMES_KANBAN_TASK")
+    monkeypatch.setenv("HERMES_KANBAN_WORKER_TASK", relay)
+    from gateway.session_context import scoped_current_session_id
+    with scoped_current_session_id(session), pytest.raises(ContainmentRefused):
+        actors.current_actor(board)
+
+
+@pytest.mark.parametrize("case", ["missing", "unrelated_run", "wrong_session", "malformed", "nonobject", "empty_context"])
+def test_owner_adoption_must_bind_exact_session_and_current_run(board, monkeypatch, case):
+    relay, rid, session = bind(board, monkeypatch)
+    if case in ("missing", "unrelated_run"):
+        board.execute("UPDATE task_events SET run_id=? WHERE task_id=? AND kind='owner_admitted'",
+                      (None if case == "missing" else rid + 1, relay))
+    elif case in ("malformed", "nonobject"):
+        board.execute("UPDATE task_events SET payload=? WHERE task_id=? AND kind='owner_admitted'",
+                      ("{bad" if case == "malformed" else json.dumps([session]), relay))
+    elif case == "wrong_session":
+        session = "different-runtime-session"
+    else:
+        session = ""  # Context-local empty must NOT fall back to an ambient owner session.
+    from gateway.session_context import scoped_current_session_id
+    with scoped_current_session_id(session), pytest.raises(ContainmentRefused):
+        actors.current_actor(board)
+
+
+def test_ended_owner_cannot_start_new_containment(board, monkeypatch):
+    relay, rid, session = bind(board, monkeypatch)
+    board.execute("UPDATE task_runs SET ended_at=1 WHERE id=?", (rid,))
+    from gateway.session_context import scoped_current_session_id
+    with scoped_current_session_id(session), pytest.raises(ContainmentRefused):
+        actors.current_actor(board)
+    assert kb.get_task(board, relay).status == "running"
diff --git a/tests/hermes_cli/test_kanban_containment_canonical.py b/tests/hermes_cli/test_kanban_containment_canonical.py
new file mode 100644
index 0000000000000000000000000000000000000000..31ff2a86fb7feaf309c23b326f0514af2742cacb
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_containment_canonical.py
@@ -0,0 +1,195 @@
+"""Canonical adapter: exact custody, unknown outcomes and durable replay.
+
+The Hub double models the documented wire contract, not a live Board or replica
+proof. Board's authenticated ingress tests exercise the producer of these bytes.
+"""
+from __future__ import annotations
+
+import copy
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_containment_canonical as canonical
+from hermes_cli.kanban_containment_lifecycle import ContainmentRefused
+from hermes_cli.kanban_containment_state import fingerprint
+from hermes_cli.kanban_db_sync import uuid7
+from tests.hermes_cli import test_kanban_containment_legacy_paths as legacy
+
+board = legacy.board
+TASK = "t_da066fc02a25c3b2"
+AUTH = "t_1123456789abcdef"
+
+
+def operation(kind="contain"):
+    target = {"gateway": "home", "board": "fixture", "task_id": TASK}
+    stop = {"version": 1, "target": target, "policy": {"version": 1, "authority": {**target, "task_id": AUTH}},
+            "producer_baseline": None}
+    episode = uuid7()
+    payload = stop if kind == "contain" else {
+        "version": 1, "episode": episode, "containment_sha256": fingerprint(stop), "resume_status": "ready",
+        "evidence": {"kind": "authority", "authority": stop["policy"]["authority"], "run_uid": uuid7()}}
+    op = {"client_op_id": uuid7(), "op": kind, "task": TASK, "actor_task": AUTH,
+          "actor_run_uid": uuid7(), "event_uid": episode if kind == "contain" else uuid7(), "payload": payload}
+    return op, stop, episode
+
+
+def evidence(op, stop, episode):
+    return {"board": "fixture", "table": "task_events", "uid": op["event_uid"], "state": "live",
+            "row": {"uid": op["event_uid"], "task_id": TASK,
+                    "kind": "contained" if op["op"] == "contain" else "containment_released",
+                    "payload": json.dumps(op["payload"], separators=(",", ":")), "origin_gateway": "worker"},
+            "containment_v1": {"version": 1, "episode": episode, "containment_sha256": fingerprint(stop),
+                               "gateway": "worker", "request": op["client_op_id"]}}
+
+
+class Hub:
+    def __init__(self, op, stop, episode):
+        self.ident = SimpleNamespace(gateway="worker")
+        self.posts = []
+        self.op = op
+        self.reply = {"results": [{"client_op_id": op["client_op_id"], "status": "applied"}]}
+        self.events = {op["event_uid"]: evidence(op, stop, episode)}
+        if op["op"] != "contain":
+            original = {**op, "op": "contain", "event_uid": episode, "payload": stop, "client_op_id": uuid7()}
+            self.events[episode] = evidence(original, stop, episode)
+        self.fail = False
+
+    def ops(self, slug, ops):
+        assert slug == "fixture"
+        self.posts.append(copy.deepcopy(ops))
+        if self.fail:
+            raise TimeoutError("fixture accepted request but reply was lost")
+        return self.reply
+
+    def row_evidence(self, slug, table, uid):
+        assert (slug, table) == ("fixture", "task_events")
+        return copy.deepcopy(self.events[uid])
+
+
+def staged(board, kind="contain"):
+    op, stop, episode = operation(kind)
+    request = canonical.stage(board, board="fixture", gateway="worker", op=op)
+    return request, op, Hub(op, stop, episode)
+
+
+@pytest.mark.parametrize("kind", ["contain", "resume_contained"])
+def test_canonical_success_never_writes_task_or_dependencies(board, kind):
+    relay, consumer = legacy._relay(board)
+    before = legacy._edges(board)
+    request, op, hub = staged(board, kind)
+    result = canonical.deliver(board, hub, request=request)
+    assert result == {"task_id": TASK, "request_uid": request, "event_uid": op["event_uid"],
+                      "canonical_confirmed": True}
+    assert legacy._edges(board) == before
+    assert legacy.kb.get_task(board, relay).status == "running"
+    assert legacy.kb.get_task(board, consumer).status == "todo"
+    assert board.execute("SELECT confirmed FROM containment_delivery").fetchone()[0] == 1
+    # Confirmed recovery still reads canonical evidence; it does not re-submit.
+    assert canonical.deliver(board, hub, request=request) == result
+    assert hub.posts == [[op]]
+
+
+def test_uncertain_delivery_recovers_identical_bytes_after_real_connection_restart(board):
+    import sqlite3
+    request, op, hub = staged(board)
+    hub.fail = True
+    with pytest.raises(TimeoutError):
+        canonical.deliver(board, hub, request=request)
+    path = board.execute("PRAGMA database_list").fetchone()[2]
+    hub.fail = False
+    with sqlite3.connect(path, isolation_level=None) as fresh:
+        fresh.row_factory = sqlite3.Row
+        canonical.deliver(fresh, hub, request=request)
+    assert hub.posts == [[op], [op]]
+    assert board.execute("SELECT COUNT(*) FROM containment_delivery").fetchone()[0] == 1
+
+
+@pytest.mark.parametrize("field", ["payload", "actor_run_uid", "task", "gateway", "board"])
+def test_request_cannot_change_on_retry(board, field):
+    request, op, _ = staged(board)
+    kwargs = {"board": "fixture", "gateway": "worker", "op": copy.deepcopy(op)}
+    if field in ("gateway", "board"):
+        kwargs[field] = "other"
+    elif field == "payload":
+        kwargs["op"][field]["producer_baseline"] = {"run_uid": uuid7(), "event_uid": None}
+    elif field == "actor_run_uid":
+        kwargs["op"][field] = uuid7()
+    else:
+        kwargs["op"][field] = AUTH
+    with pytest.raises(ContainmentRefused, match="different containment bytes"):
+        canonical.stage(board, **kwargs)
+    assert board.execute("SELECT request_uid FROM containment_delivery").fetchone()[0] == request
+
+
+@pytest.mark.parametrize("case", ["missing", "many", "nonobject", "other_request", "pending", "rejected"])
+def test_malformed_or_rejected_disposition_is_not_success(board, case):
+    request, _, hub = staged(board)
+    valid = hub.reply["results"][0]
+    hub.reply = {
+        "missing": {}, "many": {"results": [valid, valid]}, "nonobject": {"results": [None]},
+        "other_request": {"results": [{**valid, "client_op_id": uuid7()}]},
+        "pending": {"results": [{**valid, "status": "pending"}]},
+        "rejected": {"results": [{**valid, "status": "rejected"}]},
+    }[case]
+    with pytest.raises((canonical.DeliveryUnknown, ContainmentRefused)):
+        canonical.deliver(board, hub, request=request)
+    assert board.execute("SELECT confirmed FROM containment_delivery").fetchone()[0] == 0
+
+
+@pytest.mark.parametrize("path,value", [
+    (("board",), "other"), (("table",), "task_comments"), (("uid",), "bad"), (("state",), "deleted"),
+    (("row",), None), (("row", "uid"), "bad"), (("row", "task_id"), AUTH),
+    (("row", "kind"), "completed"), (("row", "deleted_at"), 1), (("row", "payload"), {}),
+    (("containment_v1",), None), (("containment_v1", "version"), True),
+    (("containment_v1", "episode"), "bad"), (("containment_v1", "request"), "bad"),
+    (("containment_v1", "gateway"), ""), (("row", "origin_gateway"), "foreign"),
+    (("containment_v1", "containment_sha256"), "0" * 64),
+])
+def test_attestation_guards_fail_closed(board, path, value):
+    request, op, hub = staged(board)
+    item = hub.events[op["event_uid"]]
+    for part in path[:-1]:
+        item = item[part]
+    item[path[-1]] = value
+    with pytest.raises(ContainmentRefused):
+        canonical.deliver(board, hub, request=request)
+    assert board.execute("SELECT confirmed FROM containment_delivery").fetchone()[0] == 0
+
+
+def test_certified_receipt_for_different_request_or_payload_is_not_delivery(board):
+    request, op, hub = staged(board)
+    hub.events[op["event_uid"]]["containment_v1"]["request"] = uuid7()
+    with pytest.raises(canonical.DeliveryUnknown):
+        canonical.deliver(board, hub, request=request)
+    # A different, internally certified policy still is not OUR staged policy.
+    item = hub.events[op["event_uid"]]
+    item["containment_v1"]["request"] = request
+    payload = json.loads(item["row"]["payload"])
+    payload["policy"]["authority"]["gateway"] = "new-home"
+    item["row"]["payload"] = json.dumps(payload)
+    item["containment_v1"]["containment_sha256"] = fingerprint(payload)
+    with pytest.raises(canonical.DeliveryUnknown):
+        canonical.deliver(board, hub, request=request)
+
+
+def test_confirmed_recovery_rechecks_canonical_evidence(board):
+    request, op, hub = staged(board)
+    canonical.deliver(board, hub, request=request)
+    hub.events[op["event_uid"]]["containment_v1"] = None
+    with pytest.raises(ContainmentRefused):
+        canonical.deliver(board, hub, request=request)
+    assert len(hub.posts) == 1
+
+
+def test_network_is_outside_writer_and_other_gateway_cannot_replay(board):
+    request, _, hub = staged(board)
+    hub.ident.gateway = "other"
+    with pytest.raises(ContainmentRefused, match="different enrolled gateway"):
+        canonical.deliver(board, hub, request=request)
+    hub.ident.gateway = "worker"
+    from hermes_cli import kanban_db as kb
+    with kb.write_txn(board), pytest.raises(ContainmentRefused, match="writer transaction"):
+        canonical.deliver(board, hub, request=request)
+    assert hub.posts == []
diff --git a/tests/hermes_cli/test_kanban_containment_paging.py b/tests/hermes_cli/test_kanban_containment_paging.py
new file mode 100644
index 0000000000000000000000000000000000000000..ac502f40c5f73edb4879a4c4c54b09e15183ac04
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_containment_paging.py
@@ -0,0 +1,108 @@
+"""A canonical task marker must hold before its history page arrives."""
+from __future__ import annotations
+
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_containment_guard as guard
+from hermes_cli import kanban_db as kb
+from hermes_cli.kanban_db_sync import uuid7
+from tests.hermes_cli import test_kanban_containment_lifecycle as fixtures
+from tests.hermes_cli import test_kanban_sync_capture as capture
+
+board = fixtures.board
+kanban_home = capture.kanban_home
+synced_conn = capture.synced_conn
+
+
+def test_marker_before_history_holds_generic_lifecycle_and_survives_restart(board):
+    relay, _, _, _, _ = fixtures.setup(board)
+    episode = uuid7()
+    # Simulate the canonical task page before containment guards are installed.
+    board.execute("UPDATE tasks SET status='triage',current_run_id=NULL,containment_episode=? WHERE id=?", (episode, relay))
+    guard.install(board)
+    assert guard.pending(board, relay)
+    assert kb.get_task(board, relay).containment_episode == episode
+    with pytest.raises(sqlite3.IntegrityError, match="containment_pending"):
+        board.execute("UPDATE tasks SET status='ready' WHERE id=?", (relay,))
+    with pytest.raises(sqlite3.IntegrityError, match="containment_pending"):
+        board.execute("UPDATE tasks SET containment_episode=NULL WHERE id=?", (relay,))
+    with kb.write_txn(board), guard.authorized_write(board, relay):
+        board.execute("UPDATE tasks SET containment_episode=NULL WHERE id=?", (relay,))
+    assert guard.pending(board, relay)  # Bootstrapped observation survives a later task page.
+    path = board.execute("PRAGMA database_list").fetchone()[2]
+    again = sqlite3.connect(path)
+    try:
+        guard.install(again)
+        assert guard.pending(again, relay)
+    finally:
+        again.close()
+
+
+def test_later_task_page_cannot_erase_an_unresolved_observed_episode(board):
+    relay, _, _, _, _ = fixtures.setup(board)
+    guard.install(board)
+    episode = uuid7()
+    board.execute("UPDATE tasks SET status='triage',current_run_id=NULL,containment_episode=? WHERE id=?", (episode, relay))
+    # Importing an authoritative task page will use a scoped sync seam. Even a
+    # later cleared marker must not authorize before the missing history arrives.
+    with kb.write_txn(board), guard.authorized_write(board, relay):
+        board.execute("UPDATE tasks SET containment_episode=NULL WHERE id=?", (relay,))
+    assert guard.pending(board, relay)
+    assert board.execute("SELECT COUNT(*) FROM containment_observations WHERE task_id=?", (relay,)).fetchone()[0] == 1
+
+
+def test_new_marker_is_not_satisfied_by_an_older_valid_release(board):
+    relay, consumer, actor, target, spec = fixtures.setup(board)
+    stop = fixtures.contain(board, relay, target, spec)
+    from hermes_cli import kanban_containment_lifecycle as lifecycle
+    released = lifecycle.resume_local(board, target=target, episode=stop["episode"], actor_task=actor,
+                                     actor_run_uid=fixtures.run_uid(board, actor), kind="authority")
+    assert released["status"] == "ready"
+    assert not guard.pending(board, relay, verify_release=lambda r, s: lifecycle.verified_release(board, r, s))
+    assert kb.get_task(board, relay).containment_episode is None
+    assert kb.get_task(board, consumer).status == "todo"
+    # The second episode's task page arrives before its stop event. The previous
+    # authenticated release is valid, but is not authority for this new episode.
+    board.execute("UPDATE tasks SET status='triage',containment_episode=? WHERE id=?", (uuid7(), relay))
+    assert guard.pending(board, relay, verify_release=lambda r, s: lifecycle.verified_release(board, r, s))
+
+
+def test_failed_trigger_upgrade_retains_prior_fence(board, monkeypatch):
+    relay, _, _, _, _ = fixtures.setup(board)
+    guard.install(board)
+    board.execute("UPDATE tasks SET status='triage',current_run_id=NULL,containment_episode=? WHERE id=?", (uuid7(), relay))
+
+    def interrupted(conn):
+        conn.execute("DROP TRIGGER containment_task_update")
+        raise sqlite3.OperationalError("fixture interrupted migration")
+
+    monkeypatch.setattr(guard, "_triggers", interrupted)
+    with pytest.raises(sqlite3.OperationalError, match="interrupted migration"):
+        guard.install(board)
+    assert not board.in_transaction
+    with pytest.raises(sqlite3.IntegrityError, match="containment_pending"):
+        board.execute("UPDATE tasks SET status='ready' WHERE id=?", (relay,))
+
+
+def test_real_replica_apply_imports_hold_marker_but_outbox_never_authors_it(synced_conn):
+    from hermes_cli import kanban_db_sync as sync
+    conn = synced_conn
+    tid = kb.create_task(conn, title="fixture metadata", assignee="default")
+    episode = uuid7()
+    capture._clear_outbox(conn)
+    guard.install(conn)
+    remote = sync.RemoteChange(1, "tasks", tid, "upsert",
+                               {"id": tid, "status": "triage", "containment_episode": episode},
+                               100, "", "fixture-home")
+    sync.apply_remote_changes(conn, [remote], new_cursor=1, board="default")
+    assert kb.get_task(conn, tid).containment_episode == episode
+    assert guard.pending(conn, tid)
+    assert sync.outbox(conn) == []
+    # An annotation may still travel. Its full task row must omit the server
+    # marker so a gateway cannot manufacture/clear canonical containment.
+    conn.execute("UPDATE tasks SET priority=priority+1 WHERE id=?", (tid,))
+    task_ops = [op for op in sync.outbox(conn) if op["table_name"] == "tasks"]
+    assert task_ops
+    assert all("containment_episode" not in op["fields"] for op in task_ops)
-- 
2.43.0

