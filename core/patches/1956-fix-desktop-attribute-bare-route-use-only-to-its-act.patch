From 054cb1853cbeb3787a69b37c149ae98ee2a16a49 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 4 Nov 2026 08:59:08 +0000
Subject: [PATCH] fix(desktop): attribute bare route use only to its actual
 primary [daveey]

---
 .../src/store/gateway-remote-use.test.ts      | 23 +++++++++++++++++++
 apps/desktop/src/store/gateway.ts             | 15 ++++++++----
 apps/desktop/src/store/remote-use.ts          |  3 ++-
 3 files changed, 36 insertions(+), 5 deletions(-)

diff --git a/apps/desktop/src/store/gateway-remote-use.test.ts b/apps/desktop/src/store/gateway-remote-use.test.ts
index eca137e28dd..4c334189dd2 100644
--- a/apps/desktop/src/store/gateway-remote-use.test.ts
+++ b/apps/desktop/src/store/gateway-remote-use.test.ts
@@ -161,6 +161,29 @@ describe('remote profile use reporting', () => {
     expect(desktop.noteRemoteUse).toHaveBeenCalledTimes(1)
   })
 
+  it.each(['open', 'request', 'retain', 'send'] as const)(
+    'a bare non-primary %s uses the legacy door without stamping the SSH primary',
+    async action => {
+      setPrimaryGatewayConnectionId(HUB, 'remote')
+
+      if (action === 'open') {
+        await openGatewayForAgent(null, 'work', { spawnPriority: 'foreground' })
+      } else if (action === 'request') {
+        await requestGatewayForAgent(null, 'work', 'session.create', {}, undefined, undefined, {
+          spawnPriority: 'foreground'
+        })
+      } else if (action === 'retain') {
+        await retainGatewayForAgent(null, 'work', { spawnPriority: 'foreground' }).then(release => release())
+      } else {
+        await retainGatewayForSessionTurn(null, 'work', 'session-1').then(release => release())
+      }
+
+      expect(desktop.getConnection).toHaveBeenCalledWith('work')
+      expect(desktop.getConnectionFor).not.toHaveBeenCalled()
+      expect(desktop.noteRemoteUse).not.toHaveBeenCalled()
+    }
+  )
+
   it("a send on the window's own (remote primary) gateway is a use of the primary's route", async () => {
     setPrimaryGateway({ connectionState: 'open' } as never, 'research')
     setPrimaryGatewayConnectionId(HUB, 'remote')
diff --git a/apps/desktop/src/store/gateway.ts b/apps/desktop/src/store/gateway.ts
index 6456aefea23..baebf8f6609 100644
--- a/apps/desktop/src/store/gateway.ts
+++ b/apps/desktop/src/store/gateway.ts
@@ -1164,7 +1164,7 @@ export async function requestGatewayForAgent<T>(
 ): Promise<T> {
   const key = normKey(profile)
   const scope = registryBackendScopeKey(connectionId, key)
-  noteForegroundUse(connectionId ?? primaryConnectionId(), key, spawnPriority)
+  noteForegroundUse(connectionId ?? (key === g.primaryProfile ? primaryConnectionId() : null), key, spawnPriority)
 
   if (scope === key) {
     return requestGatewayForProfile<T>(key, method, params, timeoutMs, signal, { spawnPriority })
@@ -1396,7 +1396,7 @@ export async function retainGatewayForAgent(
 ): Promise<() => void> {
   const key = normKey(profile)
   const scope = registryBackendScopeKey(connectionId, key)
-  noteForegroundUse(connectionId ?? primaryConnectionId(), key, spawnPriority)
+  noteForegroundUse(connectionId ?? (key === g.primaryProfile ? primaryConnectionId() : null), key, spawnPriority)
 
   if (scope === key) {
     // Plain-profile route: gatewayForProfile's request lease IS the retain —
@@ -1518,7 +1518,10 @@ export async function retainGatewayForSessionTurn(
   profile: string,
   sessionId: string
 ): Promise<() => void> {
-  noteRemoteUse(connectionId ?? primaryConnectionId(), normKey(profile)) // a prompt.submit: the user's send is use
+  noteRemoteUse(
+    connectionId ?? (normKey(profile) === g.primaryProfile ? primaryConnectionId() : null),
+    normKey(profile)
+  ) // a prompt.submit: the user's send is use
 
   // Primary events do not flow through a Secondary's terminal-event listener.
   // Registering a no-op lease here would leave a phantom key that can suppress
@@ -1670,7 +1673,11 @@ export async function openGatewayForAgent(
   }: { activationLease?: boolean; spawnPriority?: SpawnPriority } = {}
 ): Promise<void> {
   const scope = registryBackendScopeKey(connectionId, profile)
-  noteForegroundUse(connectionId ?? primaryConnectionId(), profile, spawnPriority)
+  noteForegroundUse(
+    connectionId ?? (normKey(profile) === g.primaryProfile ? primaryConnectionId() : null),
+    profile,
+    spawnPriority
+  )
 
   if (scope === normKey(profile) || isPrimaryRegistryRoute(connectionId, profile)) {
     return openGatewayForProfile(profile, { spawnPriority })
diff --git a/apps/desktop/src/store/remote-use.ts b/apps/desktop/src/store/remote-use.ts
index 093f3bc6a08..d293cc19de1 100644
--- a/apps/desktop/src/store/remote-use.ts
+++ b/apps/desktop/src/store/remote-use.ts
@@ -39,7 +39,8 @@ export function noteRemoteUse(connectionId: null | string | undefined, profile:
 }
 
 /** A 'foreground' spawn priority marks a user gesture (open, new chat, Bot Chat open): that, not the dial it may
- * cause, is use. Callers resolve a plain profile route (null connection) to the window primary's connection. */
+ * cause, is use. Only a bare route for the primary profile inherits the window primary's connection;
+ * other bare profiles use the legacy door, not that registry host. */
 export function noteForegroundUse(
   connectionId: null | string | undefined,
   profile: null | string | undefined,
-- 
2.55.0

