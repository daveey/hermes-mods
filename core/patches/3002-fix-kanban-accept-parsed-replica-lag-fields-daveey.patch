From f6557f9a64743d136213c5120c6ad7c9d98e79cd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 22:32:40 +0000
Subject: [PATCH] fix(kanban): accept parsed replica lag fields [daveey]

---
 hermes_cli/kanban_replica_lag.py                   |  3 ++-
 tests/hermes_cli/test_kanban_pickup_replica_lag.py | 11 +++++++++++
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_replica_lag.py b/hermes_cli/kanban_replica_lag.py
index 8a2b1c4705..c62baa071b 100644
--- a/hermes_cli/kanban_replica_lag.py
+++ b/hermes_cli/kanban_replica_lag.py
@@ -89,8 +89,9 @@ def acked_task_ids(rows: Iterable[dict]) -> list[str]:
         if row.get("table_name") == "tasks":
             out.append(row.get("row_uid"))
             continue
+        fields = row.get("fields") or {}
         try:
-            fields = json.loads(row.get("fields") or "{}")
+            fields = fields if isinstance(fields, dict) else json.loads(fields)
         except (TypeError, ValueError):
             continue
         if isinstance(fields, dict):
diff --git a/tests/hermes_cli/test_kanban_pickup_replica_lag.py b/tests/hermes_cli/test_kanban_pickup_replica_lag.py
index 73faf8a69e..23b586d8c7 100644
--- a/tests/hermes_cli/test_kanban_pickup_replica_lag.py
+++ b/tests/hermes_cli/test_kanban_pickup_replica_lag.py
@@ -106,6 +106,17 @@ def test_a_lagging_card_is_not_reimported_until_the_replica_catches_up(gws, cloc
     assert "reclaimed" in kinds  # the re-imported copy carries what this gateway pushed
 
 
+@pytest.mark.parametrize("fields", [
+    {"task_id": "t_1"},
+    {"child_id": "t_1"},
+    '{"task_id": "t_1"}',
+    '{"child_id": "t_1"}',
+])
+def test_acked_task_ids_accepts_parsed_and_json_fields(fields):
+    rows = [{"table_name": "task_events", "fields": fields}]
+    assert lag.acked_task_ids(rows) == ["t_1"]
+
+
 def test_a_lag_entry_expires(monkeypatch):
     lag.reset()
     mono = [1000.0]
-- 
