From f36a2e039aa3bcb3dc7be9ad925987419950ff3f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:32:02 +0000
Subject: [PATCH] [daveey] launch overlay docs: 'frozen once multiplexing is
 active, the live env before'

bind_state's owner_secret_scope docstring, launch_profile_runtime_scope's
docstring and comment, and web_host_terminal's scope comment still called
the launch env/TERMINAL_* overlay 'frozen'. _launch_env() returns the live
process env until multiplexing is active, so say that (PR #2081 review nit,
t_01a1d472aa7758f6). Docstring/comment only.
---
 agent/runtime_scope.py               | 3 ++-
 hermes_cli/web_host_terminal.py      | 3 ++-
 tui_gateway/launch_profile_policy.py | 9 +++++----
 3 files changed, 9 insertions(+), 6 deletions(-)

diff --git a/agent/runtime_scope.py b/agent/runtime_scope.py
index f823353c43..bf8648a993 100644
--- a/agent/runtime_scope.py
+++ b/agent/runtime_scope.py
@@ -91,7 +91,8 @@ def bind_state(
     A hosted scope binds the scope with no home, secrets or terminal policy: its state lives
     behind the storage ports, not in a directory. For a local scope: the home override names the
     agent's home; the secret scope is *secrets*, or ``owner_secret_scope`` (the launch home's
-    frozen env plus ``.env``, any other home's own files) with external sources hydrated first
+    env plus ``.env``: frozen once multiplexing is active, the live env before; any other home's
+    own files) with external sources hydrated first
     unless ``hydrate_secrets=False``, stamped with the home unless ``stamp_home=False`` (unstamped marks the process's own profile); the terminal policy
     is built from the profile's config over *env_overlay* (the refusal scope if it cannot be
     read), or *terminal_policy* when the caller already built it off the event loop
diff --git a/hermes_cli/web_host_terminal.py b/hermes_cli/web_host_terminal.py
index 95bf579392..c5078fe968 100644
--- a/hermes_cli/web_host_terminal.py
+++ b/hermes_cli/web_host_terminal.py
@@ -121,7 +121,8 @@ def resolve_argv(
         scope = launch_profile_runtime_scope(home)
     # The startup eager-multiplex guard applies even before a secondary's first
     # request. Home alone cannot authorize passthrough reads; both shell paths
-    # need the same complete scope, including the frozen launch environment.
+    # need the same complete scope, including the launch environment (frozen
+    # once multiplexing is active).
     override_token = set_hermes_home_override(str(home))
     try:
         with scope:
diff --git a/tui_gateway/launch_profile_policy.py b/tui_gateway/launch_profile_policy.py
index 6642ba1d91..7824ddb6d5 100644
--- a/tui_gateway/launch_profile_policy.py
+++ b/tui_gateway/launch_profile_policy.py
@@ -190,9 +190,10 @@ def launch_body() -> Iterator[None]:
 @contextlib.contextmanager
 def launch_profile_runtime_scope(launch_home: str | Path) -> Iterator[None]:
     """Bind the launch profile's own runtime scope for one body: HERMES_HOME override naming the
-    launch home, ``launch_secret_scope``, and its terminal policy over the frozen launch
-    ``TERMINAL_*`` overlay. For hosts whose launch-profile bodies are not RPC sessions (the
-    standalone messaging gateway after a hosted room activated multiplexing, #112878).
+    launch home, ``launch_secret_scope``, and its terminal policy over the launch
+    ``TERMINAL_*`` overlay (frozen once multiplexing is active, the live env before). For hosts
+    whose launch-profile bodies are not RPC sessions (the standalone messaging gateway after a
+    hosted room activated multiplexing, #112878).
 
     The home override is bound even though the launch home IS the process home: under multiplexing
     "override unset" is the fail-closed signal for an UNBOUND context (``serves_routed_profile``,
@@ -203,7 +204,7 @@ def launch_profile_runtime_scope(launch_home: str | Path) -> Iterator[None]:
     from agent.runtime_scope import bind_state, scope_for_profile
 
     home = Path(launch_home)
-    # Own home: secrets unstamped (no foreign-home stamp), terminal policy over the frozen overlay.
+    # Own home: secrets unstamped (no foreign-home stamp), terminal policy over the launch overlay.
     tokens = bind_state(scope_for_profile(home), secrets=launch_secret_scope(home), stamp_home=False,
                         env_overlay=launch_terminal_env())
     try:
-- 
2.51.0

