From 40f9d9ad03d42ba606241906ada09fb9d7a1c112 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 06:16:52 +0000
Subject: [PATCH] [daveey] kill surviving hub admission guard mutants

Adds a guard test per surviving mutant of core-mutants-run1 (pool policy validation reasons, unknown census at
dispatch/candidate/final gate, normal-card advisory ceiling, invalid policy at advisory, pool CPU recheck after a
concurrent pool change, foreign lockless holder in the pool census, capacity receipt without origin, metrics cap 0).
Drops the redundant SQL marked-first prefix: the post-donation re-partition is the single marked ordering.
Makes the concurrent cross-board pool test end with an uncontended pass so busy-lock losers cannot flake it.
---
 hermes_cli/kanban_db_dispatch_queries.py      |   3 +-
 tests/hermes_cli/test_kanban_hub_admission.py |   4 +
 .../test_kanban_hub_admission_grant_echo.py   |  12 ++
 .../test_kanban_hub_admission_guards.py       | 167 ++++++++++++++++++
 .../test_machine_admission_metrics.py         |   2 +-
 5 files changed, 185 insertions(+), 3 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_hub_admission_guards.py

diff --git a/hermes_cli/kanban_db_dispatch_queries.py b/hermes_cli/kanban_db_dispatch_queries.py
index a682d0348e..f37c954d0a 100644
--- a/hermes_cli/kanban_db_dispatch_queries.py
+++ b/hermes_cli/kanban_db_dispatch_queries.py
@@ -32,11 +32,10 @@ DISPATCH_ORDER = (
 
 def lane_rows(conn: sqlite3.Connection, status: str, *, marked_first: bool = False) -> list[sqlite3.Row]:
     """Unclaimed rows of one lane in dispatch order; optional pool ordering keeps priority ties per class."""
-    prefix = "admission_class IN ('capacity', 'urgent') DESC, " if marked_first else ""
     rows = conn.execute(
         "SELECT id, assignee, admission_class FROM tasks "
         f"WHERE status = '{status}' AND claim_lock IS NULL "
-        f"ORDER BY {prefix}{DISPATCH_ORDER}"
+        f"ORDER BY {DISPATCH_ORDER}"
     ).fetchall()
     from hermes_cli.kanban_dispatch_priority import order_with_remote_waiters
     rows = order_with_remote_waiters(conn, rows)
diff --git a/tests/hermes_cli/test_kanban_hub_admission.py b/tests/hermes_cli/test_kanban_hub_admission.py
