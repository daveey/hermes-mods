From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 06:16:51 +0000
Subject: [PATCH] [daveey] cover concurrent cross-board pools and enabled
 own-grant echo receipts

---
 tests/hermes_cli/test_kanban_hub_admission.py | 37 +++++++++++++++++++
 .../test_kanban_hub_admission_grant_echo.py   | 32 ++++++++++++++++
 2 files changed, 69 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_hub_admission.py b/tests/hermes_cli/test_kanban_hub_admission.py
index 169eae0dd3..3fdbbb5193 100644
--- a/tests/hermes_cli/test_kanban_hub_admission.py
+++ b/tests/hermes_cli/test_kanban_hub_admission.py
@@ -126,6 +126,43 @@ def test_claim_persists_immutable_regular_receipt(board):
                               (task_id,)).fetchone()) == ("regular", "capacity")
 
 
+@pytest.mark.parametrize("kind,expected", [("capacity", 2), ("urgent", 3)])
+def test_concurrent_cross_board_claims_obey_origin_and_pool_caps(board, monkeypatch, kind, expected):
+    conn, home = board
+    configure(home, limit=None)
+    for index in range(7):
+        assert kb.claim_task(conn, task(conn, title=f"regular {index}"))
+    configure(home, cap=7)
+    with (home / "config.yaml").open("a") as config:
+        config.write("    priority_slots: 3\n")
+    advisory(home)
+    monkeypatch.setattr(cm, "sample", fake_sample(10))
+    candidates = []
+    for index in range(4):
+        folder = kb.boards_root() / f"pool-{index}"
+        folder.mkdir(parents=True)
+        (folder / "board.json").write_text("{}")
+        path = folder / "kanban.db"
+        with closing(kbc.connect(path)) as other:
+            tid = task(other)
+            kb.edit_task(other, tid, admission_class=kind, admission_frees="frees: worker slots")
+            candidates.append((path, tid))
+
+    def attempt(candidate):
+        path, tid = candidate
+        with closing(kbc.connect(path)) as other:
+            return kb.claim_task(other, tid)
+
+    for _ in range(4):
+        with ThreadPoolExecutor(max_workers=4) as executor:
+            list(executor.map(attempt, candidates))
+    detail = {"pools": {"regular": 0, "priority": 0}, "capacity_origins": {}}
+    assert mm.active_card_runs(detail=detail) == 7 + expected
+    assert detail["pools"] == {"regular": 7, "priority": expected}
+    if kind == "capacity":
+        assert list(detail["capacity_origins"].values()) == [2]
+
+
 def test_queue_note_reports_pools_and_marked_lane_order(board, monkeypatch):
     from hermes_cli import kanban_queue_position as qp
     conn, home = board
diff --git a/tests/hermes_cli/test_kanban_hub_admission_grant_echo.py b/tests/hermes_cli/test_kanban_hub_admission_grant_echo.py
index 6eb5a4afa4..a166ecd08b 100644
--- a/tests/hermes_cli/test_kanban_hub_admission_grant_echo.py
+++ b/tests/hermes_cli/test_kanban_hub_admission_grant_echo.py
@@ -134,6 +134,38 @@ def rig(tmp_path, monkeypatch):
         r.close()
 
 
+@pytest.mark.parametrize("lane", LANES)
+@pytest.mark.parametrize("kind,regular,priority,pool", [("normal", 6, 3, "regular"), ("urgent", 7, 2, "priority")])
+def test_enabled_pools_exclude_only_own_echo_and_preserve_receipt(rig, lane, kind, regular, priority, pool):
+    import json
+
+    rig.fill(regular)
+    text = (rig.home / "config.yaml").read_text().replace(
+        "    cpu_busy_below_pct: 50\n", "    cpu_busy_below_pct: 50\n    priority_slots: 3\n")
+    (rig.home / "config.yaml").write_text(text)
+    for _ in range(priority):
+        marked = rig.card()
+        kb.edit_task(rig.conn, marked, admission_class="urgent")
+        rig.round()
+        assert kb.claim_task(rig.conn, marked)
+    candidate = rig.card(lane)
+    kb.edit_task(rig.conn, candidate, admission_class=kind)
+    rig.round()
+    seen = rig.echo_between_gate_and_txn()
+    assert claim(rig.conn, candidate, lane)
+    rows = rig.conn.execute("SELECT uid,admission_pool,admission_class,admission_origin FROM task_runs WHERE task_id=?", (candidate,)).fetchall()
+    assert len(rows) == 1
+    receipt = tuple(rows[0])
+    assert receipt[0] == seen["gate"].lease.run_uid
+    assert receipt[1:3] == (pool, kind)
+    evidence = json.loads(rig.conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='claimed' AND json_extract(payload,'$.hub_admission') IS NOT NULL", (candidate,)).fetchone()[0])["hub_admission"]
+    assert evidence["excluded_run_uid"] == receipt[0]
+    assert evidence["active_after"] == regular + priority
+    assert evidence["active_before"] == regular + priority + 1
+    rig.round()
+    assert tuple(rig.conn.execute("SELECT uid,admission_pool,admission_class,admission_origin FROM task_runs WHERE task_id=?", (candidate,)).fetchone()) == receipt
+
+
 def test_frozen_counter_shape_own_lockless_echo_counts_foreign_does_not(rig):
     """The counter semantics F5 measured, through the real function on a real board: own-holder lockless counts,
     foreign-holder lockless does not. The generic counter is deliberately unchanged by the fix."""
