diff --git a/tests/hermes_cli/test_kanban_claim_heartbeat_reset.py b/tests/hermes_cli/test_kanban_claim_heartbeat_reset.py
new file mode 100644
index 0000000000..e70c4a0a79
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_claim_heartbeat_reset.py
@@ -0,0 +1,82 @@
+"""A new run must not inherit the previous worker's stale heartbeat."""
+
+import signal
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as kbd
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    conn = kbc.connect(tmp_path / "kanban.db")
+    try:
+        yield conn
+    finally:
+        conn.close()
+
+
+@pytest.mark.parametrize("source_status", ["ready", "review"])
+@pytest.mark.parametrize("current_run_stale", [False, True], ids=["fresh", "stale"])
+def test_reclaim_uses_current_run_heartbeat(board, monkeypatch, source_status, current_run_stale):
+    conn = board
+    now = 2_000_000_000
+    old = now - kb.DEFAULT_CLAIM_HEARTBEAT_MAX_STALE_SECONDS - 600
+    clock = [old]
+    monkeypatch.setattr(kb.time, "time", lambda: clock[0])
+    tid = kb.create_task(conn, title="Wake a previously active task", assignee="worker")
+    previous = kb.claim_task(conn, tid)
+    assert previous is not None
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET last_heartbeat_at = ? WHERE id = ?", (old, tid))
+    assert kb.reclaim_task(conn, tid, signal_fn=lambda *_: pytest.fail("No old worker to signal"))
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET status = ? WHERE id = ?", (source_status, tid))
+
+    clock[0] = now
+    claim = kb.claim_task if source_status == "ready" else kb.claim_review_task
+    current = claim(conn, tid, ttl_seconds=60)
+    assert current is not None
+    assert current.current_run_id != previous.current_run_id
+    # Task age is intentionally retained; only the activity baseline belongs to the new run.
+    assert current.started_at == old
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET worker_pid = ?, worker_started_at = ? WHERE id = ?",
+                     (424242, "test-fingerprint", tid))
+
+    alive = [True]
+    monkeypatch.setattr(kb, "_worker_alive", lambda *_: alive[0])
+    monkeypatch.setattr(kb, "_pid_alive", lambda *_: alive[0])
+    monkeypatch.setattr(kbd, "_worker_alive", lambda *_: alive[0])
+    monkeypatch.setattr(kbd, "_pid_recycled", lambda *_: False)
+    signals = []
+
+    def terminate(pid, sig):
+        signals.append((pid, sig))
+        alive[0] = False
+
+    # Both claims expire, but only the control run has actually gone an hour without activity.
+    clock[0] = now + (kb.DEFAULT_CLAIM_HEARTBEAT_MAX_STALE_SECONDS + 1 if current_run_stale else 61)
+    assert kb.release_stale_claims(conn, signal_fn=terminate) == int(current_run_stale)
+    task = kb.get_task(conn, tid)
+    run = conn.execute("SELECT * FROM task_runs WHERE id = ?", (current.current_run_id,)).fetchone()
+    assert task.last_heartbeat_at == now
+    if current_run_stale:
+        assert signals == [(424242, signal.SIGTERM)]
+        assert task.status == source_status
+        assert task.claim_lock is None
+        assert task.worker_pid is None
+        assert run["outcome"] == "reclaimed"
+        assert run["ended_at"] == clock[0]
+    else:
+        assert signals == []
+        assert task.status == "running"
+        assert task.current_run_id == current.current_run_id
+        assert task.claim_lock == current.claim_lock
+        assert task.claim_expires > clock[0]
+        assert run["claim_expires"] == task.claim_expires
+        assert run["ended_at"] is None
+        assert run["outcome"] is None
diff --git a/tests/hermes_cli/test_kanban_sync_lease_fencing.py b/tests/hermes_cli/test_kanban_sync_lease_fencing.py
new file mode 100644
index 0000000000..56e4afc9a1
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_sync_lease_fencing.py
@@ -0,0 +1,105 @@
+"""Lease RPC acknowledgements fence feed echoes, not unrelated task fields."""
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_sync as sync
+from hermes_cli import kanban_sync_client as client
+from tests.hermes_cli import kanban_sync_support as support
+
+
+@pytest.fixture
+def primary(tmp_path, monkeypatch):
+    home = support.kanban_home(tmp_path, monkeypatch)
+    for conn in support.synced_conn(home):
+        sync.set_mode(conn, "primary")
+        yield conn
+
+
+@pytest.fixture
+def hub(primary):
+    class Hub:
+        version = 29
+        expires = int(time.time() + 900) * 1000
+        holder = primary.execute("SELECT gateway_id FROM kanban_sync_state").fetchone()[0]
+
+        def leases(self, board, body):
+            return {"status": "applied", "version": self.version,
+                    "lease": {"run_uid": body["run_uid"], "holder": self.holder,
+                              "expires": self.expires}}
+
+    hub = Hub()
+    previous = sync.set_lease_client(client.HubLeaseClient(hub))
+    try:
+        yield hub
+    finally:
+        sync.set_lease_client(previous)
+
+
+def row(conn, tid):
+    return conn.execute("SELECT * FROM tasks WHERE id = ?", (tid,)).fetchone()
+
+
+def apply(conn, tid, version, holder, expires, op="upsert", **fields):
+    sync.apply_remote_changes(conn, [sync.RemoteChange(
+        version, "tasks", tid, op,
+        {"lease_holder": holder, "lease_expires": expires, **fields},
+        version, "", "gw_remote",
+    )], new_cursor=version)
+
+
+@pytest.mark.parametrize("op", ["upsert", "lease"])
+def test_grant_fences_previous_release_and_intermediate_null(primary, hub, op):
+    tid = kb.create_task(primary, title="original", assignee="worker")
+    assert kb.claim_task(primary, tid, ttl_seconds=900, claimer="host:1")
+    before = row(primary, tid)
+    # The grant's final version must NOT acknowledge earlier task fields.
+    assert before["sync_version"] is None
+    for version in (26, 28):
+        apply(primary, tid, version, None, None, op=op,
+              **({"title": "remote edit", "status": "running"} if op == "upsert" else {}))
+        after = row(primary, tid)
+        assert after["claim_expires"] == before["claim_expires"]
+        assert after["lease_holder"] == hub.holder
+        assert after["lease_expires"] == hub.expires
+    apply(primary, tid, 29, hub.holder, hub.expires)
+    after = row(primary, tid)
+    assert after["claim_expires"] == before["claim_expires"]
+    assert after["lease_version"] == 29
+    if op == "upsert":
+        assert after["title"] == "remote edit"
+    assert "lease_version" not in sync.captured_columns(primary, "tasks")
+
+
+@pytest.mark.parametrize("op", ["upsert", "lease"])
+@pytest.mark.parametrize("holder", [None, "gw_other"])
+def test_renewal_fences_old_echo_but_new_takeover_expires(primary, hub, monkeypatch, op, holder):
+    tid = kb.create_task(primary, title="renew", assignee="worker")
+    assert kb.claim_task(primary, tid, ttl_seconds=900, claimer="host:1")
+    old_expires = hub.expires
+    hub.version = 35
+    hub.expires += 300000
+    monkeypatch.setattr(sync, "_renewal_due", lambda *args: True)
+    assert kb.heartbeat_claim(primary, tid, ttl_seconds=900, claimer="host:1")
+    before = row(primary, tid)
+    assert before["sync_version"] is None
+    apply(primary, tid, 30, hub.holder, old_expires, op=op)
+    assert row(primary, tid)["lease_expires"] == hub.expires
+    assert row(primary, tid)["claim_expires"] == before["claim_expires"]
+    assert row(primary, tid)["lease_version"] == 35
+    apply(primary, tid, 36, holder, None if holder is None else hub.expires, op=op)
+    after = row(primary, tid)
+    assert after["lease_holder"] == holder
+    assert after["lease_version"] == 36
+    assert after["claim_expires"] < int(time.time())
+
+
+def test_lease_only_feed_does_not_acknowledge_task_fields(primary, hub):
+    tid = kb.create_task(primary, title="original", assignee="worker")
+    assert kb.claim_task(primary, tid, ttl_seconds=900)
+    apply(primary, tid, 35, hub.holder, hub.expires, op="lease")
+    apply(primary, tid, 30, None, None, title="earlier field edit")
+    assert row(primary, tid)["title"] == "earlier field edit"
+    assert row(primary, tid)["lease_holder"] == hub.holder
+    assert row(primary, tid)["lease_version"] == 35
