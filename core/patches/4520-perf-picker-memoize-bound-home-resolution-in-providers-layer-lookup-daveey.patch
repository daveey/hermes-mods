From 32353e35f216ceb5ae607ad1c0facad2d160d0cd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 18:33:45 +0000
Subject: [PATCH] perf(picker): memoize bound-home resolution in providers
 layer lookup [daveey]

---
 fixture/cache/plugin_hooks.json               |  2 +-
 providers/__init__.py                         | 24 +++++++++++++++----
 .../hermes_cli/test_picker_warm_cost_cuts.py  | 17 +++++++++++++
 3 files changed, 38 insertions(+), 5 deletions(-)

diff --git a/fixture/cache/plugin_hooks.json b/fixture/cache/plugin_hooks.json
index e573b708f9b65a8553b58bd5d7d5b91ab478a83c..fc8e63031caaab61b6d3029f936e889f45cfe1ef 100644
--- a/fixture/cache/plugin_hooks.json
+++ b/fixture/cache/plugin_hooks.json
@@ -1 +1 @@
-{"version": 1, "fingerprint": "30663ffde4ba2fde515cfd40d8ec58f7b50afd3ffdb9e8ba36a5784433787f44", "hooks": ["on_session_end", "post_tool_call", "pre_tool_call", "transform_tool_result"]}
\ No newline at end of file
+{"version": 1, "fingerprint": "7af0cf1e9bc92b4cc7c8940b7947dad36625f8d6b4b817a9dcce35661e9ba698", "hooks": ["on_session_end", "post_tool_call", "pre_tool_call", "transform_tool_result"]}
\ No newline at end of file
diff --git a/providers/__init__.py b/providers/__init__.py
index a6d0b9f1bbd394550ce78a25b8abef6474eee510..6c35c384d951034f00b307f3631bb1228aeb1bfe 100644
--- a/providers/__init__.py
+++ b/providers/__init__.py
@@ -432,12 +432,28 @@ def refresh_bound_home() -> None:
     _home_layer(force_stamp_check=True).misses.clear()
 
 
+# (inputs that select the home, home, key). Only stored once ``hermes_home_key`` itself remembers the
+# path (it exists on disk), so a home that appears or moves is re-resolved exactly as before.
+_BOUND_HOME_MEMO: tuple[tuple, Path, str] | None = None
+
+
 def _bound_home_layer() -> tuple[_HomeLayer, Path | None, str]:
+    global _BOUND_HOME_MEMO
     try:
-        from hermes_constants import get_hermes_home, hermes_home_key
-
-        home = Path(get_hermes_home())
-        key = hermes_home_key(home)
+        import os
+
+        from hermes_constants import _HOME_KEY_CACHE, get_hermes_home, get_hermes_home_override, hermes_home_key
+
+        env = os.environ
+        inputs = (get_hermes_home_override(), env.get("HERMES_HOME"), env.get("HERMES_DATA_DIR_SUFFIX"), env.get("HOME"))
+        memo = _BOUND_HOME_MEMO
+        if memo is not None and memo[0] == inputs and os.fspath(memo[1]) in _HOME_KEY_CACHE:
+            _, home, key = memo
+        else:
+            home = Path(get_hermes_home())
+            key = hermes_home_key(home)
+            if os.fspath(home) in _HOME_KEY_CACHE:
+                _BOUND_HOME_MEMO = (inputs, home, key)
     except Exception:
         home, key = None, ""
     with _HOME_LAYERS_LOCK:
diff --git a/tests/hermes_cli/test_picker_warm_cost_cuts.py b/tests/hermes_cli/test_picker_warm_cost_cuts.py
index 8909040422a3c50817e806bed1cd81a28b335f59..57bdb25c0a49792aa4ebea10a0a29d754c8ff6ca 100644
--- a/tests/hermes_cli/test_picker_warm_cost_cuts.py
+++ b/tests/hermes_cli/test_picker_warm_cost_cuts.py
@@ -92,3 +92,20 @@ def home_config():
     (get_hermes_home() / "config.yaml").write_text(
         "model:\n  default: x\n  provider: openrouter\nmodel_catalog:\n  providers:\n    acme: {url: u}\n")
     return get_hermes_home()
+
+
+def test_bound_home_layer_follows_home_changes(tmp_path, monkeypatch):
+    """The memoized home resolution must re-resolve whenever HERMES_HOME (or an override) changes."""
+    import providers
+
+    a, b = tmp_path / "a", tmp_path / "b"
+    a.mkdir()
+    b.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(a))
+    layer_a, _home_a, key_a = providers._bound_home_layer()
+    assert providers._bound_home_layer()[0] is layer_a
+    monkeypatch.setenv("HERMES_HOME", str(b))
+    layer_b, home_b, key_b = providers._bound_home_layer()
+    assert layer_b is not layer_a and home_b == b and key_b != key_a
+    monkeypatch.setenv("HERMES_HOME", str(a))
+    assert providers._bound_home_layer()[0] is layer_a
-- 
