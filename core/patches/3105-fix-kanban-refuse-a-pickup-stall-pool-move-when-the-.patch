From 19e30b45b795f2ef9831664d99ad3363077ee7e3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 03:05:34 +0000
Subject: [PATCH] fix(kanban): refuse a pickup-stall pool move when the card's
 requires is not a JSON list of strings [daveey]

kanban_pickup_stall_repin._requires maps a stored requires that is valid JSON
but not a list (an object, a bare string, null) or holds non-strings to [], so
board_refusal and pool_refusal both passed with only profile:<assignee> needed.
The Board's stringList (worker_placement.ts) answers task_metadata_invalid for
such a row and never pool-places it, so the alarm's pool move left the card
stalled.

malformed_requires() mirrors stringList (NULL is []; anything else must parse
as a JSON list of strings) and scope_refusal refuses a pool:worker move with
that reason. A move to one machine:<X> is unchanged.

Regression tests: requires stored as {"a":1}, "ssh:mbp", ["terminal", 3], null
or unparseable -> pool move refused naming task_metadata_invalid, machine:<X>
move still granted; NULL, [] and ["terminal"] still take the pool queue.
Follow-up to review t_01a1d2d0d2181207 of PR #1833 (t_01a1d2d611cfe71d).
---
 hermes_cli/kanban_pickup_stall_repin.py       | 27 ++++++++++++++++---
 .../test_kanban_pickup_stall_repin.py         | 18 +++++++++++++
 2 files changed, 42 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_pickup_stall_repin.py b/hermes_cli/kanban_pickup_stall_repin.py
index 9a2b131956..aeebf167a1 100644
--- a/hermes_cli/kanban_pickup_stall_repin.py
+++ b/hermes_cli/kanban_pickup_stall_repin.py
@@ -99,6 +99,26 @@ def _requires(target: Any) -> list:
     return [r for r in requires if isinstance(r, str)] if isinstance(requires, list) else []
 
 
+def malformed_requires(target: Any) -> Optional[str]:
+    """Why the Board cannot read ``target``'s stored ``requires``, else None.
+
+    Mirrors the Board's ``stringList`` (worker_placement.ts): NULL is ``[]``; anything else must parse as a JSON list
+    of strings, or the Board answers ``task_metadata_invalid`` and never pool-places the card. :func:`_requires` maps
+    such a row to ``[]`` for the need, so this check is what keeps a pool move from looking eligible."""
+    import json
+    raw = target["requires"]
+    if raw is None:
+        return None
+    try:
+        value = json.loads(raw) if isinstance(raw, (str, bytes)) else raw
+    except (TypeError, ValueError):
+        value = None
+    if isinstance(value, list) and all(isinstance(r, str) for r in value):
+        return None
+    return (f"its stored requires {str(raw)[:80]!r} is not a JSON list of strings, so the Board's pool selection "
+            "answers task_metadata_invalid; fix the card's requires or move it to one machine:<X>")
+
+
 def _need(target: Any) -> set:
     from hermes_cli.kanban_placement_coordination import requirement_label
     return {requirement_label(r) for r in _requires(target)} | {f"profile:{target['assignee']}"}
@@ -139,10 +159,11 @@ def scope_refusal(conn: sqlite3.Connection, alarm: Any, target: Any, runs_on: An
     except ValueError as exc:
         return str(exc)
     if labels == [pool_label()]:
-        # A worker may attest ssh access, but the Board's pool selection cannot place it: the card would sit in
-        # task_requirement_unsupported instead of leaving the stalled machine.
+        # A worker may attest ssh access, but the Board's pool selection cannot place it, nor a requires it cannot
+        # read (not a JSON list of strings): the card would sit in task_requirement_unsupported or
+        # task_metadata_invalid instead of leaving the stalled machine.
         from hermes_cli.kanban_placement_coordination import board_refusal
-        if why := board_refusal(_requires(target)):
+        if why := malformed_requires(target) or board_refusal(_requires(target)):
             return f"{target['id']} cannot go to {pool_label()}: {why}"
         return pool_refusal(own, machines, _need(target), now_ms)
     if len(labels) != 1 or not labels[0].startswith("machine:"):
diff --git a/tests/hermes_cli/test_kanban_pickup_stall_repin.py b/tests/hermes_cli/test_kanban_pickup_stall_repin.py
index 0a0f8c6985..88a38445b6 100644
--- a/tests/hermes_cli/test_kanban_pickup_stall_repin.py
+++ b/tests/hermes_cli/test_kanban_pickup_stall_repin.py
@@ -248,6 +248,24 @@ def test_declared_ssh_access_refuses_the_pool_queue_with_the_board_reason(board,
     assert why is not None and coord.BOARD_REASON in why, why
 
 
+@pytest.mark.parametrize("stored", ['{"a":1}', '"ssh:mbp"', '["terminal", 3]', "null", "not json"])
+def test_a_requires_the_board_cannot_read_refuses_the_pool_queue_only(board, stored):
+    """t_01a1d2d611cfe71d: ``_requires`` maps a stored requires that is not a JSON list of strings to ``[]``, so the
+    pool move looked eligible with only ``profile:<assignee>``; the Board's ``stringList`` answers
+    ``task_metadata_invalid`` for that row and never pool-places it. A move to one machine is unchanged."""
+    board.set(board.target, requires=stored)
+    why = board.why(runs_on=[POOL], machines=_pooled())
+    assert why is not None and "task_metadata_invalid" in why and "not a JSON list of strings" in why, why
+    assert board.why(machines=_pooled()) is None  # machine:<X> still moves
+
+
+@pytest.mark.parametrize("stored", [None, "[]", '["terminal"]'])
+def test_a_requires_the_board_reads_still_takes_the_pool_queue(board, stored):
+    board.set(board.target, requires=stored)
+    machines = _pooled(worker_2={"labels": [*_worker(X)["labels"], POOL, "capability:terminal"]})
+    assert board.why(runs_on=[POOL], machines=machines) is None
+
+
 @pytest.mark.parametrize("name, label", [("hub:write", "capability:hub-write"), ("hub:read", "capability:hub-read"),
                                          ("ssh:mbp", "capability:ssh-mbp"), ("ssh:mini", "capability:ssh-mini"),
                                          ("terminal", "capability:terminal")])
-- 
