From ea896044c35b795c716e9841b3b074cde9c1f4c1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 14:14:56 +0000
Subject: [PATCH] fix(cron): join continued function names for stdin provenance
 [daveey]

Review B1: definition discovery used raw text while invocation tokenization joined backslash-newline. Apply the same comment removal and continuation normalization before discovering candidate function names. Real Bash marker oracle and safe twin: original 3 failures reproduced, then all 18 expanded definition/alias-scope cases pass.
---
 cron/lifecycle_guard_nested_shells.py         |  3 +++
 ...cycle_guard_stdin_function_continuation.py | 25 +++++++++++++++++++
 2 files changed, 28 insertions(+)
 create mode 100644 tests/cron/test_lifecycle_guard_stdin_function_continuation.py

diff --git a/cron/lifecycle_guard_nested_shells.py b/cron/lifecycle_guard_nested_shells.py
index a0d3307f4805ca5475e863e8b0cda3031e401f9a..de0c8135dbe658af9fd34d7889f59819ffd255d2 100644
--- a/cron/lifecycle_guard_nested_shells.py
+++ b/cron/lifecycle_guard_nested_shells.py
@@ -29,6 +29,7 @@ from cron.lifecycle_guard import (
     _split_redirections,
 )
 from cron.lifecycle_guard_groups import _CLOSERS
+from cron.lifecycle_guard_lines import strip_shell_comments
 
 if TYPE_CHECKING:
     from cron.lifecycle_guard import _LifecycleScanBudget
@@ -1014,6 +1015,8 @@ _FUNCTION_DEFINITION_RE = re.compile(
 
 def _defined_functions(command: str) -> frozenset[str]:
     """Names of the shell functions *command* may define."""
+    # Match the command tokenizer's joined spelling, not a suffix after a continuation.
+    command = strip_shell_comments(command).replace("\\\n", "")
     return frozenset(name for match in _FUNCTION_DEFINITION_RE.finditer(command)
                      for name in match.groups() if name)
 
diff --git a/tests/cron/test_lifecycle_guard_stdin_function_continuation.py b/tests/cron/test_lifecycle_guard_stdin_function_continuation.py
new file mode 100644
index 0000000000000000000000000000000000000000..837e324d6db5b416f61ca57ef70575e4df192642
--- /dev/null
+++ b/tests/cron/test_lifecycle_guard_stdin_function_continuation.py
@@ -0,0 +1,25 @@
+import os
+import subprocess
+import pytest
+from cron.lifecycle_guard import scan_gateway_lifecycle
+
+@pytest.mark.parametrize('definition', [
+    'run()', 'ru\\\nn()', 'r\\\nu\\\nn()', 'function ru\\\nn',
+    'function ru\\\nn()', 'run\\\n()',
+])
+@pytest.mark.parametrize('names', [frozenset({'zz'}), frozenset(), None])
+def test_function_input_review(tmp_path, definition, names):
+    command = definition + ' { bash --noprofile -l; }; run < input.sh'
+    script = tmp_path / 'input.sh'
+    startup = tmp_path / 'startup.sh'
+    startup.write_text("shopt -s expand_aliases\nalias t='true; '\n")
+    (tmp_path / 'marker.sh').write_text("printf 'REVIEW_FUNCTION_EXECUTED\\n'\n")
+    script.write_text('t ( bash marker.sh )\n')
+    result = subprocess.run(['/bin/bash', '--noprofile', '--norc', '-c', command], cwd=tmp_path, env=dict(os.environ, BASH_ENV=str(startup)), capture_output=True, text=True, timeout=5, check=False)
+    assert (result.returncode, result.stdout, result.stderr) == (0, 'REVIEW_FUNCTION_EXECUTED\n', '')
+    script.write_text('printf harmless\\n\n')
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path), session_aliases=names) == (False, None)
+    script.write_text('t ( bash huge.sh )\n')
+    (tmp_path / 'huge.sh').write_text('# padding\n' * 130000)
+    verdict = scan_gateway_lifecycle(command, cwd=str(tmp_path), session_aliases=names)
+    assert verdict[0], (definition, names, verdict)
