From af53e0f3e3a3d7b56701e0471bfb632a78518127 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 19:29:10 +0000
Subject: [PATCH] [daveey] preserve backtick boundaries when stripping hub-read
 paths

---
 hermes_cli/kanban_placement_coordination.py    | 3 ++-
 tests/hermes_cli/test_kanban_hub_read_roots.py | 4 ++++
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_placement_coordination.py b/hermes_cli/kanban_placement_coordination.py
index f66811f486..e5bd91d21a 100644
--- a/hermes_cli/kanban_placement_coordination.py
+++ b/hermes_cli/kanban_placement_coordination.py
@@ -168,8 +168,9 @@ def without_read_paths(text, cfg, *, target=None, requires=None):
 
 
 def _strip_read_paths(text, roots):
+    # Keep a separator so surrounding backtick runs cannot merge and hide later markers.
     return _STATE_PATH.sub(
-        lambda m: "" if _ends_word(text, m.start(), m.end()) and _under_roots(m.group(1), roots) else m.group(0),
+        lambda m: " " if _ends_word(text, m.start(), m.end()) and _under_roots(m.group(1), roots) else m.group(0),
         text)
 
 
diff --git a/tests/hermes_cli/test_kanban_hub_read_roots.py b/tests/hermes_cli/test_kanban_hub_read_roots.py
index 43b793dc53..d90c8a34a6 100644
--- a/tests/hermes_cli/test_kanban_hub_read_roots.py
+++ b/tests/hermes_cli/test_kanban_hub_read_roots.py
@@ -135,6 +135,10 @@ def test_controls_still_pin(attested, body):
     "chmod -R 777 `echo ~/.hermes/logs/`..",
     "chmod -R 777 `~/.hermes/state/x`",
     "read `~/.hermes/logs/x.log` then chmod -R 777 ~/.hermes/state/x",
+    # Removing a whole path must not merge its delimiters into a new backtick run.
+    "Read `~/.hermes/logs/x.log` then chmod -R 777 ~/.hermes/state/x with ``foo``",
+    "Read `~/.hermes/logs/x.log` then restart the gateway; see ``foo``",
+    "``a`` then `~/.hermes/logs/x.log` then systemctl restart hermes ``b``",
 ])
 def test_backtick_spans_follow_main_with_or_without_hub_read(attested, body):
     cfg, _, _ = attested
-- 
2.43.0

