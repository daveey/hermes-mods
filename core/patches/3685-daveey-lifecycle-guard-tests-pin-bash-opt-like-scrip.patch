From 4ac6e9b7c63902bb23edf251c6409e95d6fdb9fc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 16:47:24 +0000
Subject: [PATCH] [daveey] lifecycle guard tests: pin `bash - <opt-like
 script>` and `coproc CMD ARGS` (2 surviving mutants of #2249)

The post-merge mutation check of PR #2249 (card t_01a1d5aa7c8f204d) found two
clauses in cron/lifecycle_guard.py with no test, so a regression would pass CI.
Production behaviour on main is correct; this is a test-only change.

- G7 `_shell_options_end`: `if argument in ("--", "-"):` -> `if argument == "--":`
  survived. Pinned with `("bash - -x /x/hermes-sync", False)`: after a lone `-`
  bash takes the next word (`-x`) as the script, so hermes-sync is only an argument.
- G11 `_peel_reserved_words`: dropping the `(index + 1 == len(segment) or
  segment[index + 1] == "{")` bound on the coproc NAME survived. Pinned with
  `("coproc sudo -u root hermes-sync", True)` in test_executes_command_named and an
  end-to-end refusal-hint case `coproc sudo -u root {script} mods-pull`:
  `coproc CMD ARGS` runs CMD; only `coproc NAME {` / a bare trailing NAME is a name.

Proof (tests/cron/test_lifecycle_guard_interpreter_runners.py +
tests/tools/test_lifecycle_guard_hermes_sync_hint.py):
- main guard: 125 passed (122 before + 3 new).
- G7 alone: 1 failed (test_executes_command_named[bash - -x /x/hermes-sync-False]).
- G11 alone: 2 failed (test_executes_command_named[coproc sudo -u root hermes-sync-True],
  test_hint_survives_reserved_words[coproc sudo -u root {script} mods-pull]).

The new parametrize rows are appended at the end of each list, away from the
lines open PR #2388 edits in the same file. The redundant `_peel_external_time`
(G4-G6, covered by `time` in _TRANSPARENT_COMMAND_PREFIXES) is left in place.
---
 tests/tools/test_lifecycle_guard_hermes_sync_hint.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/tests/tools/test_lifecycle_guard_hermes_sync_hint.py b/tests/tools/test_lifecycle_guard_hermes_sync_hint.py
index 39f277c9f4..b2176c241c 100644
--- a/tests/tools/test_lifecycle_guard_hermes_sync_hint.py
+++ b/tests/tools/test_lifecycle_guard_hermes_sync_hint.py
@@ -140,6 +140,8 @@ def test_hint_survives_shell_options_with_values(tmp_path, monkeypatch, template
     "x=1 time {script} mods-pull",
     "env time -f %e {script} mods-pull",
     "coproc {script} mods-pull",
+    # `coproc CMD ARGS` runs CMD even when CMD reads like a coproc NAME.
+    "coproc sudo -u root {script} mods-pull",
 ])
 def test_hint_survives_reserved_words(tmp_path, monkeypatch, template):
     script = _script(tmp_path, "hermes-sync", _RESTART)
@@ -207,6 +209,10 @@ def test_clustered_option_value_and_rcfile_stay_refused(tmp_path, monkeypatch, t
     ("coproc SYNC { hermes-sync; }", True),
     ("time -- -p hermes-sync", False),
     ("function hermes-sync { true; }", False),
+    # Post-merge check of PR #2249: after a lone `-` the shell's next word is the script even
+    # when it looks like an option, and `coproc CMD ARGS` runs CMD (a NAME needs a `{` group).
+    ("bash - -x /x/hermes-sync", False),
+    ("coproc sudo -u root hermes-sync", True),
 ])
 def test_executes_command_named(command, expected):
     from cron.lifecycle_guard import executes_command_named
