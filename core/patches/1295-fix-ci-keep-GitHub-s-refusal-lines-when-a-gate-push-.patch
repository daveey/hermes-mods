From 89e9eac432f21fdc845b3387c2ac150db8cdc84b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 17:16:09 +0000
Subject: [PATCH] fix(ci): keep GitHub's refusal lines when a gate push is
 refused [daveey]

The tail of git push's output is paths and hints; on CI's long tmp paths the
GH013 line was cut off. Keep the remote: error lines first.
---
 scripts/ci/upstream_sync.py            | 5 ++++-
 tests/scripts/ci/test_upstream_sync.py | 1 +
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/scripts/ci/upstream_sync.py b/scripts/ci/upstream_sync.py
index 84dcb5faa5e..032cc992fbd 100644
--- a/scripts/ci/upstream_sync.py
+++ b/scripts/ci/upstream_sync.py
@@ -180,7 +180,10 @@ def _push(repo, src: str, ref: str, stage: str) -> None:
     """Push ``src`` to ``ref`` as the gate. A protection refusal raises Refused with GitHub's words."""
     push = _run(repo, "push", "-q", "origin", f"{src}:{ref}", env=_gate_env(stage))
     if push.returncode:
-        message = (push.stderr or push.stdout or "").strip()[-600:]
+        lines = [line.strip() for line in (push.stderr or push.stdout or "").splitlines() if line.strip()]
+        remote = [line for line in lines if line.startswith("remote:")]
+        # GitHub's verdict lines first (``remote: error: GH006 …``): the tail is paths and hints
+        message = " | ".join([line for line in remote if "error" in line.lower()] or remote or lines)[:600]
         if is_protection_refusal(message):
             raise Refused(f"GitHub refused the push to {ref}: {message}")
         raise GateError(f"git push to {ref} failed: {message}")
diff --git a/tests/scripts/ci/test_upstream_sync.py b/tests/scripts/ci/test_upstream_sync.py
index 898ce3e1a94..66f3172d054 100644
--- a/tests/scripts/ci/test_upstream_sync.py
+++ b/tests/scripts/ci/test_upstream_sync.py
@@ -170,6 +170,7 @@ def protect_main(world_root, refs=("refs/heads/main",), code="GH006"):
     hook.write_text("#!/bin/sh\nstatus=0\nwhile read old new ref; do\n  case \" " + " ".join(refs) + " \" in\n"
                     "    *\" $ref \"*) echo \"remote: error: " + code + ": Protected branch update failed for $ref.\" >&2\n"
                     "      echo 'remote: error: Required status check \"All required checks pass (v2)\" is expected.' >&2\n"
+                    "      echo 'remote: hint: " + "x" * 700 + "' >&2\n"  # GitHub's verdict is never the tail
                     "      status=1 ;;\n  esac\ndone\nexit $status\n")
     hook.chmod(0o755)
 
