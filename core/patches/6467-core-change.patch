From 67876b0fd11bb585442e60c57f3f1b30ed3598eb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 14:13:46 +0000
Subject: [PATCH 6467] Test isolation, fixture lifecycle and CI case partitioning

Public mirror of source commit 67876b0fd11bb585442e60c57f3f1b30ed3598eb.

---
diff --git a/tests/tui_gateway/test_readiness_singleflight.py b/tests/tui_gateway/test_readiness_singleflight.py
index 6dee859c30d..5c4f0e7edd2 100644
--- a/tests/tui_gateway/test_readiness_singleflight.py
+++ b/tests/tui_gateway/test_readiness_singleflight.py
@@ -17,6 +17,8 @@
 import threading
 import time
 
+import pytest
+
 from tui_gateway import server
 
 
@@ -153,13 +155,28 @@
     assert provider_a["result"]["provider"] == "provider-a"
 
 
-def test_probe_outliving_its_budget_answers_retryable_unknown_then_reprobes(monkeypatch):
+@pytest.mark.parametrize("queued_probe", [False, True])
+def test_probe_outliving_its_budget_answers_retryable_unknown_then_reprobes(monkeypatch, queued_probe):
     """A probe slower than the join budget answers the retryable error (unknown, not ok=False)
     while it keeps running; the next poll starts a fresh probe with the real answer."""
     monkeypatch.setattr(server, "_READINESS_SHARE_WAIT_SECONDS", 0.2)
     started = threading.Event()
     release = threading.Event()
+    admission = threading.Event()
     calls = []
+    pool = server._readiness_pool
+
+    class GatedPool:
+        def submit(self, probe):
+            def admitted_probe():
+                assert admission.wait(timeout=10)
+                return probe()
+            return pool.submit(admitted_probe)
+
+    if queued_probe:
+        # The budget includes executor admission, not only provider execution.
+        # Keep the real worker/future and hold admission until its caller answers.
+        monkeypatch.setattr(server, "_readiness_pool", GatedPool())
 
     def slow_resolve(requested=None, **kwargs):
         calls.append(requested)
@@ -171,9 +188,12 @@
     transport = _RecordingTransport()
 
     _dispatch(transport, "first", "setup.runtime_check")
-    assert started.wait(timeout=2)
     try:
+        # Timeout covers queue admission too: the RPC may correctly answer unknown
+        # before this fixture's resolver has started. Observe the caller first.
         first = transport.wait_for("first", timeout=3)
+        if queued_probe:
+            assert not started.is_set()
 
         # Unknown readiness, expressed as an unanswered RPC — the desktop keeps the
         # last authoritative result and setup.status stays the credential source.
@@ -181,11 +201,14 @@
         assert first["error"]["code"] == server._READINESS_IN_PROGRESS_ERR
     finally:
         release.set()
+        admission.set()
 
     deadline = time.monotonic() + 2
     while server._readiness_inflight and time.monotonic() < deadline:
         time.sleep(0.01)
     assert not server._readiness_inflight
+    assert started.is_set()
+    assert len(calls) == 1
 
     _dispatch(transport, "second", "setup.runtime_check")
     second = transport.wait_for("second", timeout=3)
-- 
