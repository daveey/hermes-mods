+@contextmanager
+def _member(g):
+    """The member gateway with an api_server listener of its own. Its first boot picks the port
+    through ``api_daemon``: a port picked free here can be taken by a concurrent test's daemon first,
+    and then room_link never enables. Later boots keep that port: the home's stored route names it."""
+    if g.api_port is None:
+        with api_daemon(g.root, g.target, g.target_env, g.write_target_config) as (proc, desc, _):
+            yield proc, desc
+        return
+    with daemon(g.root, g.target, g.target_env, barrier=False) as (proc, desc):
+        api = api_listener_state(g.target, desc)
+        assert api['state'] == 'connected', f'member api_server on port {g.api_port}: {api}'
+        yield proc, desc
+
