From 4e9a04d0d07e37aa8b978aada4aae0447b31eb6b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 12:50:36 +0000
Subject: [PATCH] [daveey] test(conftest): required-extras probe runs from
 tmp_path, not inside tests/

test_collection_through_conftest wrote tests/_required_extras_probe_<pid>_<tmp>/test_probe.py
into the repo's tests/ tree for the life of a pytest subprocess, then deleted it. Tests that
scan that tree run concurrently in sibling processes; test_no_shadowed_definitions_in_test_modules
globbed the probe and then read it after the deletion, failing with FileNotFoundError (CI runs
43216120953 and 43216141005, passing only on the file retry).

The probe now lives in tmp_path and the real tests/conftest.py loads as a plugin
(-p tests.conftest, repo pyproject as config/rootdir), so nothing is written under tests/.
The listed-fails row still proves the conftest hook: dropping the plugin flag turns it red.

Repro of the race on the base: put tests/zz_repro/test_probe.py in place, start the shadow
scan, delete the file mid-scan -> FileNotFoundError.

Kanban: t_01a1cfc7d2f7cc47
---
 tests/test_conftest_required_extras.py | 68 ++++++++++++++------------
 1 file changed, 36 insertions(+), 32 deletions(-)

diff --git a/tests/test_conftest_required_extras.py b/tests/test_conftest_required_extras.py
index 40c8618661..98c3ceb5b7 100644
--- a/tests/test_conftest_required_extras.py
+++ b/tests/test_conftest_required_extras.py
@@ -4,7 +4,6 @@ from __future__ import annotations
 if not __name__.startswith("tests."): raise ImportError("Use scripts/run_tests.sh; unittest discovery bypasses test isolation")  # unittest-discovery guard
 
 import os
-import shutil
 import subprocess
 import sys
 import textwrap
@@ -78,37 +77,42 @@ def test_install_matches_top_level_names_and_does_not_stack(monkeypatch):
     ids=["unset-skips", "unlisted-skips", "listed-fails"],
 )
 def test_collection_through_conftest(tmp_path, env_value, expect_error):
-    """End to end: a module-level importorskip under tests/ collects as skip or error via conftest."""
-    probe_dir = _REPO_ROOT / "tests" / f"_required_extras_probe_{os.getpid()}_{tmp_path.name}"
-    probe_dir.mkdir()
-    try:
-        probe = probe_dir / "test_probe.py"
-        probe.write_text(
-            textwrap.dedent(
-                f"""
-                import pytest
-                mod = pytest.importorskip("{_MISSING}", reason="optional extra not installed")
-                def test_never():
-                    pass
-                """
-            ),
-            encoding="utf-8",
-        )
-        env = {k: v for k, v in os.environ.items() if k != required_extras.ENV_VAR}
-        if env_value is not None:
-            env[required_extras.ENV_VAR] = env_value
-        result = subprocess.run(
-            [sys.executable, "-m", "pytest", "--collect-only", "-q", "-p", "no:cacheprovider", str(probe)],
-            cwd=_REPO_ROOT,
-            env=env,
-            capture_output=True,
-            text=True,
-            encoding="utf-8",
-            timeout=300,
-            check=False,
-        )
-    finally:
-        shutil.rmtree(probe_dir, ignore_errors=True)
+    """End to end: a module-level importorskip collects as skip or error once tests/conftest.py loads.
+
+    The probe lives in tmp_path and the real conftest loads as a plugin (``-p tests.conftest``).
+    Writing it into the repo's tests/ tree raced the tests that scan that tree in sibling processes
+    (tests/test_no_shadowed_test_definitions.py raised FileNotFoundError when the probe vanished
+    between its glob and its read).
+    """
+    probe = tmp_path / "test_probe.py"
+    probe.write_text(
+        textwrap.dedent(
+            f"""
+            import pytest
+            mod = pytest.importorskip("{_MISSING}", reason="optional extra not installed")
+            def test_never():
+                pass
+            """
+        ),
+        encoding="utf-8",
+    )
+    env = {k: v for k, v in os.environ.items() if k != required_extras.ENV_VAR}
+    if env_value is not None:
+        env[required_extras.ENV_VAR] = env_value
+    result = subprocess.run(
+        [
+            sys.executable, "-m", "pytest", "--collect-only", "-q", "-p", "no:cacheprovider",
+            "--rootdir", str(_REPO_ROOT), "-c", str(_REPO_ROOT / "pyproject.toml"),
+            "-p", "tests.conftest", str(probe),
+        ],
+        cwd=_REPO_ROOT,
+        env=env,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        timeout=300,
+        check=False,
+    )
     output = result.stdout + result.stderr
     if expect_error:
         assert result.returncode != 0, output
