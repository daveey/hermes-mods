From 8c00e84b992cb3ea12c6dc84c07b2ada98da71f6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 00:35:18 +0000
Subject: [PATCH] Preserve priority-pool order in frozen admission lanes

Expanded hub admission consumer suite failed four priority-order assertions after extracting the lane snapshot. Use the same pool-aware lane_rows wrapper as the dispatcher for both snapshot and screen budget ordering. Five focused suites now pass (final-run3-pool-order.log, rc=0).
---
 hermes_cli/kanban_hub_admission_claim.py            | 4 ++--
 tests/hermes_cli/test_kanban_hub_claim_wake_race.py | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_hub_admission_claim.py b/hermes_cli/kanban_hub_admission_claim.py
index 508e07e54b..3359e2f309 100644
--- a/hermes_cli/kanban_hub_admission_claim.py
+++ b/hermes_cli/kanban_hub_admission_claim.py
@@ -85,7 +85,7 @@ _SCREENABLE = ("status IN ('ready', 'review') AND claim_lock IS NULL AND (runs_o
 def _candidates(conn: sqlite3.Connection) -> list[sqlite3.Row]:
     """Screenable cards in the claim pass's own dispatch order, so the per-tick judge budget covers the cards the
     claims reach first and never lets lower-priority work jump a deferred higher-priority card."""
-    from hermes_cli.kanban_db_dispatch_queries import lane_rows
+    from hermes_cli.kanban_admission_pools import lane_rows
     rows = {row["id"]: row for row in conn.execute(f"SELECT * FROM tasks WHERE {_SCREENABLE}").fetchall()}
     lanes = lane_rows(conn, "ready") + lane_rows(conn, "review")
     return [rows[row["id"]] for row in lanes if row["id"] in rows]
@@ -278,7 +278,7 @@ def print_deferred(ids: list[str]) -> None:
 
 def screened_lanes(conn: sqlite3.Connection, dry_run: bool, review_enabled: bool, deferred=()) -> tuple:
     """Freeze claim candidates before judging. Async wakes during the screen wait for the next tick."""
-    from hermes_cli.kanban_db_dispatch_queries import lane_rows
+    from hermes_cli.kanban_admission_pools import lane_rows
     from hermes_cli.kanban_db_sync import board_mode
 
     ready = lane_rows(conn, "ready")
diff --git a/tests/hermes_cli/test_kanban_hub_claim_wake_race.py b/tests/hermes_cli/test_kanban_hub_claim_wake_race.py
index 1c04c10c5a..0ae72396c2 100644
--- a/tests/hermes_cli/test_kanban_hub_claim_wake_race.py
+++ b/tests/hermes_cli/test_kanban_hub_claim_wake_race.py
@@ -79,7 +79,7 @@ def test_wake_after_screen_waits_for_next_judged_pass(gws, hub_judge, monkeypatc
     (False, "replica", True), (False, "primary", False),
 ])
 def test_screened_lanes_preserves_dispatch_controls(monkeypatch, dry_run, mode, review_enabled):
-    from hermes_cli import kanban_db_dispatch_queries as queries
+    from hermes_cli import kanban_admission_pools as queries
     from hermes_cli import kanban_db_sync as sync
     calls = []
 
