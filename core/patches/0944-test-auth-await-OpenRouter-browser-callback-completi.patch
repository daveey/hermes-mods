From 6a0c51833758b94ceae03a5253c21c5b324d7255 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 09:18:16 +0000
Subject: [PATCH] test(auth): await OpenRouter browser callback completion
 [daveey]

---
 tests/hermes_cli/test_auth_commands.py | 21 ++++++++++++++++-----
 1 file changed, 16 insertions(+), 5 deletions(-)

diff --git a/tests/hermes_cli/test_auth_commands.py b/tests/hermes_cli/test_auth_commands.py
index cd24f8c5cf..054830ff16 100644
--- a/tests/hermes_cli/test_auth_commands.py
+++ b/tests/hermes_cli/test_auth_commands.py
@@ -1039,6 +1039,7 @@ def test_openrouter_loopback_callback_binds_nonce_path_and_rejects_forged_redire
     """The CSRF nonce lives in the callback PATH (OpenRouter echoes no ``state``): a redirect that
     knows the port but not the nonce is a 404 and never yields a code; the genuine path does."""
     import threading
+    from concurrent.futures import ThreadPoolExecutor
     import urllib.error
     import urllib.parse
     import urllib.request
@@ -1046,6 +1047,7 @@ def test_openrouter_loopback_callback_binds_nonce_path_and_rejects_forged_redire
     import hermes_cli.auth_openrouter as orm
 
     seen: dict = {}
+    callback_returned = threading.Event()
 
     def _browser(url):
         callback = urllib.parse.parse_qs(urllib.parse.urlparse(url).query)["callback_url"][0]
@@ -1054,20 +1056,29 @@ def test_openrouter_loopback_callback_binds_nonce_path_and_rejects_forged_redire
 
         def _redirects():
             try:
-                urllib.request.urlopen(forged, timeout=5)
+                urllib.request.urlopen(forged, timeout=30)
             except urllib.error.HTTPError as exc:
                 seen["forged_status"] = exc.code
-            with urllib.request.urlopen(f"{callback}?code=good-code", timeout=5) as resp:
+            with urllib.request.urlopen(f"{callback}?code=good-code", timeout=30) as resp:
+                # The server can finish before the browser thread records its response.
+                assert callback_returned.wait(30), "callback did not return"
                 seen["genuine_status"] = resp.status
 
-        threading.Thread(target=_redirects, daemon=True).start()
+        seen["redirects"] = executor.submit(_redirects)
         return True
 
     monkeypatch.setattr(orm, "_can_open_graphical_browser", lambda: True)
     monkeypatch.setattr(orm.webbrowser, "open", _browser)
 
-    code = orm._openrouter_loopback_code(
-        {"code_challenge": "c", "code_challenge_method": "S256"}, open_browser=True, timeout_seconds=10)
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        try:
+            code = orm._openrouter_loopback_code(
+                {"code_challenge": "c", "code_challenge_method": "S256"}, open_browser=True, timeout_seconds=30)
+        finally:
+            callback_returned.set()
+        # A returned authorization code only proves server completion, not client completion.
+        # Await the browser too, propagating request/assertion failures to the test thread.
+        seen["redirects"].result(timeout=30)
 
     parsed = urllib.parse.urlparse(seen["callback"])
     assert parsed.hostname == "127.0.0.1" and parsed.path.startswith("/callback/") and len(parsed.path) > 20
-- 
