From b55b80fe5b1b59f40fab0776b46434433195cac6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 01:01:10 +0000
Subject: [PATCH] [daveey] isolate GC retention fixtures from host process
 discovery

The retention fixture isolated files but not process discovery. Real GC invokes the external-job veto, whose same-user cwd reads may stat deleted real-home workspaces and trip the home I/O guard. Supply an empty inventory for fixtures that create no external jobs, preserving production GC, veto logic, the home guard and all retention assertions. An outer inventory tripwire makes omission fail on quiet hosts too.

Proof: controlled synthetic deleted-cwd metadata fallback reproduces exactly zero-disables and positive-collects (8 pass, 2 fail). Removing the inventory override kills those same cases. Canonical retention and owned-job suites pass; scripts/check --base origin/main passes. This is boundary reproduction, not a claim to reproduce the historical host schedule. No updater receipt or production changes.
---
 tests/hermes_cli/test_kanban_gc_retention.py | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_gc_retention.py b/tests/hermes_cli/test_kanban_gc_retention.py
index 9e8c923c73c835903d080c051ce76f949332c309..b5482d7a05b51201b2291c5e72855470c51062f6 100644
--- a/tests/hermes_cli/test_kanban_gc_retention.py
+++ b/tests/hermes_cli/test_kanban_gc_retention.py
@@ -13,9 +13,25 @@ from hermes_cli import kanban_db_connect as kbc
 from hermes_cli import kanban_ops
 
 @pytest.fixture
-def board(tmp_path, monkeypatch):
+def host_inventory_tripwire(monkeypatch):
+    """Removing fixture isolation must fail even on an otherwise quiet host."""
+    import psutil
+
+    def unexpected_inventory():
+        pytest.fail("retention fixture attempted unrelated host process discovery")
+
+    monkeypatch.setattr(psutil, "process_iter", unexpected_inventory)
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch, host_inventory_tripwire):
+    import psutil
+
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
     monkeypatch.setenv("HERMES_HOME", str(tmp_path / "hermes"))
+    # These fixtures create no external jobs. Keep real GC/veto logic, but do
+    # not inspect unrelated host cwds (including deleted real-home workspaces).
+    monkeypatch.setattr(psutil, "process_iter", lambda: iter(()))
     return tmp_path
 
 def _done_task_with_old_event(conn):
