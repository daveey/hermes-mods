     STALL_GUARD_IDENTICAL_CALL_THRESHOLD,
@@ -485,3 +489,107 @@ def test_promoted_reasoning_detector_ignores_thai_stated_answers():
         "พรุ่งนี้จะฝนตกทั่วประเทศ",  # "tomorrow it will rain" — not a first-person action verb
