From 994e17c55dcfe5c54bdc1f21f38435010add18d7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 08:15:31 +0000
Subject: [PATCH] [daveey] kanban chat waits: an answer is strictly after the
 park; drop an unused regex

Review Low items on the previous approved head: a non-worker comment in the
park's own second (or within clock skew) counted as an answer and could delay
the owner fallback by up to 2 h; no genuine answer can share the ask's second.
_answered_since now requires created_at > park_at. _AFTER_ID was unused.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/kanban_awaiting.py                | 6 +++---
 tests/hermes_cli/test_kanban_decision_ask.py | 7 +++++++
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_awaiting.py b/hermes_cli/kanban_awaiting.py
index 40f1aaf21fafbe8ab5fe2fe075a0bd9d8d80c144..9117d8557df73bfffb63dedeccd3895a2270a4b9 100644
--- a/hermes_cli/kanban_awaiting.py
+++ b/hermes_cli/kanban_awaiting.py
@@ -923,7 +923,6 @@ def prior_same_premise(conn: sqlite3.Connection, task_id: str, premise: str, *,
     return count
 
 
-_AFTER_ID = re.compile(r"--after-id\s+(\d+)")
 CHAT_PARK_CAP = 6  # chat parks per card per 24 h before the next one escalates, however each was answered
 
 
@@ -946,7 +945,8 @@ def chat_parks_today(conn: sqlite3.Connection, task_id: str) -> int:
 
 
 def _answered_since(conn: sqlite3.Connection, task_id: str, park_at: Optional[int]) -> bool:
-    """A comment at or after a chat park (``park_at``: the park event's ``created_at``) not by a kernel writer and
+    """A comment after a chat park (``park_at``: the park event's ``created_at``; an answer cannot share the ask's
+    second) not by a kernel writer and
     not by this card's own worker. Times and portable uids only: comment and run integers are local to each board
     file, and a pool worker's park is read on the owner too (review of #3647)."""
     if park_at is None:
@@ -958,7 +958,7 @@ def _answered_since(conn: sqlite3.Connection, task_id: str, park_at: Optional[in
     own_ids = {int(r[0]) for r in conn.execute("SELECT id FROM task_runs WHERE task_id = ?", (task_id,))}
     has_uid = "uid" in {r[1] for r in conn.execute("PRAGMA table_info(task_comments)")}
     rows = conn.execute(
-        f"SELECT id, author, {'uid' if has_uid else 'NULL'} FROM task_comments WHERE task_id = ? AND created_at >= ?",
+        f"SELECT id, author, {'uid' if has_uid else 'NULL'} FROM task_comments WHERE task_id = ? AND created_at > ?",
         (task_id, int(park_at))).fetchall()
     for cid, author, cuid in rows:
         if is_system_author(author):
diff --git a/tests/hermes_cli/test_kanban_decision_ask.py b/tests/hermes_cli/test_kanban_decision_ask.py
index 5ddcab005b0bade1f553a6431445a76c01020dcb..5e59b681a0aec9e248d375f3615ed39d9741395d 100644
--- a/tests/hermes_cli/test_kanban_decision_ask.py
+++ b/tests/hermes_cli/test_kanban_decision_ask.py
@@ -679,7 +679,14 @@ def test_answered_since_uses_times_not_local_ids(kanban_home, monkeypatch) -> No
         with kb.write_txn(conn):
             conn.execute("UPDATE task_comments SET created_at = ? WHERE id = ?", (park_at - 600, old))
         assert not kaw._answered_since(conn, tid, park_at)
+        same = kb.add_comment(conn, tid, "operator", "a note in the park's own second")
+        with kb.write_txn(conn):
+            conn.execute("UPDATE task_comments SET created_at = ? WHERE id = ?", (park_at, same))
+        assert not kaw._answered_since(conn, tid, park_at)  # nobody could answer an ask in the second it was made
         _orchestrator_comment(monkeypatch, conn, tid, "Go with premise A.")
+        with kb.write_txn(conn):
+            conn.execute("UPDATE task_comments SET created_at = ? WHERE id = (SELECT MAX(id) FROM task_comments)",
+                         (park_at + 5,))
         assert kaw._answered_since(conn, tid, park_at)
 
 
