From 1a5e39d3c5591e559c40e6b36e515f6e72c07a86 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 6 Nov 2026 11:51:43 +0000
Subject: [PATCH] test(relay): await queued reply delivery before status
 assertions [daveey]

---
 .../test_relay_status_anchor_per_turn.py      | 24 +++++++++++++++++--
 1 file changed, 22 insertions(+), 2 deletions(-)

diff --git a/tests/gateway/relay/test_relay_status_anchor_per_turn.py b/tests/gateway/relay/test_relay_status_anchor_per_turn.py
index 6fd104f6fc6..31c11482332 100644
--- a/tests/gateway/relay/test_relay_status_anchor_per_turn.py
+++ b/tests/gateway/relay/test_relay_status_anchor_per_turn.py
@@ -203,7 +203,8 @@ async def test_stop_after_a_follow_up_leaves_no_status_with_dm_threads_as_sessio
 
 
 @pytest.mark.asyncio
-async def test_queued_turns_each_show_and_clear_their_own_status(tmp_path, monkeypatch):
+@pytest.mark.parametrize('delayed_delivery', [False, True])
+async def test_queued_turns_each_show_and_clear_their_own_status(tmp_path, monkeypatch, delayed_delivery):
     """Two messages queue behind a running turn in one DM session. Each turn that answers clears its own
     status, and a queued turn shows its status on its own message when it starts, even though a newer
     message already reached the chat by then."""
@@ -215,6 +216,18 @@ async def test_queued_turns_each_show_and_clear_their_own_status(tmp_path, monke
         return 'first done'
 
     async with _gateway(tmp_path, 'status-anchor-queued', FLAT_DM_SESSION) as (runner, send, outgoing, _adapter):
+        if delayed_delivery:
+            original_send = _adapter.send
+
+            async def send_after_quiet(chat_id, content, **kwargs):
+                if content == 'reply third':
+                    # Execution and typing have ended, but settlement can still be
+                    # pending beyond the old quiet-window completion heuristic.
+                    await _settle(outgoing)
+                    await _settle(outgoing)
+                return await original_send(chat_id, content, **kwargs)
+
+            monkeypatch.setattr(_adapter, 'send', send_after_quiet)
         executed = _stub_model(runner, monkeypatch, {'first': held})
         await send('1700000000.000400', 'D4', 'first')
         await async_wait_until(lambda: any(_thread(a) == '1700000000.000400' for a in _heartbeats(outgoing)),
@@ -226,11 +239,18 @@ async def test_queued_turns_each_show_and_clear_their_own_status(tmp_path, monke
                                what='a heartbeat after the queued messages')
         release.set()
         await async_wait_until(lambda: executed == ['first', 'second', 'third'], timeout=20, what='all turns ran')
+        # Typing stops before settlement sends the reply. Neither model entry nor
+        # a quiet connector proves delivery, especially on a throttled runner.
+        reply_texts = ('first done', 'reply second', 'reply third')
+        await async_wait_until(
+            lambda: all(any(a.get('op') == 'send' and a.get('content') == text
+                            for a in _actions(outgoing)) for text in reply_texts),
+            timeout=30, what='all three replies reached the connector')
         await _settle(outgoing)
         actions = _actions(outgoing)
         assert _left_working(actions) == set()
         replies = [next(i for i, a in enumerate(actions) if a.get('op') == 'send' and a.get('content') == text)
-                   for text in ('first done', 'reply second', 'reply third')]
+                   for text in reply_texts]
         spans = zip(('1700000000.000400', '1700000000.000401', '1700000000.000402'), [0] + replies[:2], replies)
         for message_id, begin, end in spans:  # the heartbeats sent while that turn ran
             heartbeats = [a for a in actions[begin:end] if a.get('op') == 'typing' and a.get('content') != '']
