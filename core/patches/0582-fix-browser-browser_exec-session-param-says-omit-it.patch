From c51212b4d007630d069d7415038a09446f172a44 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:45:58 -0700
Subject: [PATCH] fix(browser): browser_exec session param says omit it and
 reuse the default daemon [daveey]

The schema invited a per-task name ("so concurrent tasks don't share tabs"), and
models followed it: 14 days of state.db show 1,559 browser_exec calls with names
like nous-portal, alpha-askeve, weco-auth, spend, each starting its own harness
daemon and browser-level CDP connection. The browser-use plugin's own rule is to
omit BU_NAME and reuse the default daemon. The description now says that.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/fixtures/prompt_surface/tools/browser_exec.json | 2 +-
 tools/browser_use_cli.py                              | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/fixtures/prompt_surface/tools/browser_exec.json b/tests/fixtures/prompt_surface/tools/browser_exec.json
index 615a29fe55..7add858a61 100644
--- a/tests/fixtures/prompt_surface/tools/browser_exec.json
+++ b/tests/fixtures/prompt_surface/tools/browser_exec.json
@@ -8,7 +8,7 @@
         "type": "string"
       },
       "session": {
-        "description": "Named isolated browser session — its own daemon and (on cloud backends) own browser, so concurrent tasks don't share tabs. Reuse the same name on every related call; omit for the shared default session.",
+        "description": "Omit for normal work: the shared default session is reused across sites, tabs and calls. Set a name only when this task runs at the same time as another browser task and needs its own tab (or, on cloud backends, its own browser); each name starts another daemon and browser connection, stopped when its agent exits. Reuse the same name on every related call; never invent per-site or per-job names.",
         "type": "string"
       },
       "timeout_s": {
diff --git a/tools/browser_use_cli.py b/tools/browser_use_cli.py
index ff87d2cc9a..46cf1d5900 100644
--- a/tools/browser_use_cli.py
+++ b/tools/browser_use_cli.py
@@ -1045,7 +1045,7 @@ BROWSER_EXEC_SCHEMA = {
         "type": "object",
         "properties": {
             "code": {"type": "string", "description": "Python code to execute using the pre-imported browser helpers. Use print(...) for any data you need back."},
-            "session": {"type": "string", "description": "Named isolated browser session — its own daemon and (on cloud backends) own browser, so concurrent tasks don't share tabs. Reuse the same name on every related call; omit for the shared default session."},
+            "session": {"type": "string", "description": "Omit for normal work: the shared default session is reused across sites, tabs and calls. Set a name only when this task runs at the same time as another browser task and needs its own tab (or, on cloud backends, its own browser); each name starts another daemon and browser connection, stopped when its agent exits. Reuse the same name on every related call; never invent per-site or per-job names."},
             "timeout_s": {"type": "integer", "default": _DEFAULT_TIMEOUT_S,
                           "description": f"Max seconds to wait for the code to finish (default {_DEFAULT_TIMEOUT_S}, max {_MAX_TIMEOUT_S})."},
         },
-- 
2.55.0

