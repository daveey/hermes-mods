From 9ad94771b938c384523a8ff5ad61c8f9bf3b02cd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 04:56:47 +0000
Subject: [PATCH 1155/1157] test(review_engine): wait on completion queue event
 instead of 5s deadline

The async delegation worker does state.db writes before pushing the completion event; on a slow runner that exceeded the fixed 5s poll window. Block on queue.get with a 120s ceiling and raise the teardown drain ceiling to 30s.
---
 tests/agent/test_review_engine.py | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/tests/agent/test_review_engine.py b/tests/agent/test_review_engine.py
index bb388f10ef7..cc78fd7bfac 100644
--- a/tests/agent/test_review_engine.py
+++ b/tests/agent/test_review_engine.py
@@ -7,6 +7,7 @@ override), and the shared dispatch-note formatter.
 """
 
 import json
+import queue
 import time
 from unittest.mock import MagicMock
 
@@ -28,7 +29,7 @@ def _clean_state():
     while not process_registry.completion_queue.empty():
         process_registry.completion_queue.get_nowait()
     yield
-    deadline = time.monotonic() + 2.0
+    deadline = time.monotonic() + 30.0
     while ad.active_count() and time.monotonic() < deadline:
         time.sleep(0.02)
     ad._reset_for_tests()
@@ -233,14 +234,13 @@ def test_start_review_dispatches_background_and_completes(monkeypatch):
     assert re_mod._REVIEW_GOAL in built["context"]
 
     # The completion re-enters via the shared queue like any subagent.
-    deadline = time.monotonic() + 5.0
-    evt = None
-    while time.monotonic() < deadline:
-        try:
-            evt = process_registry.completion_queue.get(timeout=0.2)
-            break
-        except Exception:
-            continue
+    # Event-driven wait: returns the moment the worker thread pushes the event. The generous
+    # ceiling only matters on CPU-throttled runners, where the worker (state.db writes + pool
+    # thread start) can take far longer than a fixed few-second deadline.
+    try:
+        evt = process_registry.completion_queue.get(timeout=120.0)
+    except queue.Empty:
+        evt = None
     assert evt is not None and evt["type"] == "async_delegation"
     assert evt["results"][0]["summary"] == "REVIEW: looks good"
 
