Subject: [PATCH] [daveey] Kill closure authentication and terminal writer
 scope mutants

---
 ...est_kanban_containment_terminal_archive.py | 31 +++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_containment_terminal_archive.py b/tests/hermes_cli/test_kanban_containment_terminal_archive.py
index 7d557de2c4..21a0e0eb01 100644
--- a/tests/hermes_cli/test_kanban_containment_terminal_archive.py
+++ b/tests/hermes_cli/test_kanban_containment_terminal_archive.py
@@ -79,6 +79,37 @@ def test_gc_preserves_closed_history_without_stopping_other_events(board, monkey
     assert kb.get_task(board, relay).status == "archived"
 
 
+def test_closed_reducer_requires_independent_closure_authentication(board):
+    from hermes_cli.kanban_containment_terminal import terminal_closed
+    relay, _, authority, target, spec = lifecycle.setup(board)
+    lifecycle.contain(board, relay, target, spec)
+    assert kb.archive_task(board, authority)
+    assert kb.archive_task(board, relay)
+    events = [dict(r) for r in board.execute("SELECT * FROM task_events WHERE task_id=?", (relay,))]
+    assert terminal_closed(events, verify=lambda _event, _stop: True)
+    assert not terminal_closed(events, verify=lambda _event, _stop: False)
+
+
+def test_terminal_permit_is_transaction_connection_and_task_scoped(board, tmp_path):
+    from hermes_cli.kanban_containment_terminal import permitted, writer
+    assert permitted(board, "target") == 0
+    with pytest.raises(ValueError, match="requires a transaction"):
+        with writer(board, "target"):
+            pytest.fail("writer accepted no transaction")
+    from hermes_cli.kanban_lockguard import connect
+    other = connect(tmp_path / "other.db")
+    try:
+        with kb.write_txn(board), kb.write_txn(other):
+            assert permitted(board, "target") == 0
+            with writer(board, "target"):
+                assert permitted(board, "target") == 1
+                assert permitted(board, "other") == 0
+                assert permitted(other, "target") == 0
+            assert permitted(board, "target") == 0
+    finally:
+        other.close()
+
+
 def test_terminal_writer_does_not_grant_ready_permission(board):
     from hermes_cli.kanban_containment_terminal import writer
     relay, _, _, target, spec = lifecycle.setup(board)
