From 5ca8cccfbdbee6664c4246a6d4d0870d78c54a8f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 07:03:41 +0000
Subject: [PATCH] test(desktop): spy the live localStorage.setItem in
 voice-prefs failure cases [daveey]
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Node 26's vitest.setup.ts stand-in is a plain object, so a Storage.prototype
spy never runs. The quota and SecurityError cases wrote "false" and JS checks
failed on main (run 40827146011, voice-prefs.test.ts:45 and :74). jsdom is the
opposite — an own-property spy is ignored — so spy whichever function the live
call actually invokes.

The prototype-only spy in 0a461c1d8f never got a completed CI run.
---
 apps/desktop/src/store/voice-prefs.test.ts | 18 ++++++++++++++----
 apps/desktop/vitest.setup.ts               |  6 ++++++
 2 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/apps/desktop/src/store/voice-prefs.test.ts b/apps/desktop/src/store/voice-prefs.test.ts
index a4203e151e..b87349240b 100644
--- a/apps/desktop/src/store/voice-prefs.test.ts
+++ b/apps/desktop/src/store/voice-prefs.test.ts
@@ -20,14 +20,25 @@ import {
   applyVoiceStopPhraseFromConfig
 } from './voice-prefs'
 
+// Node 26's vitest.setup.ts stand-in is a plain object, so setItem is an own
+// property and a Storage.prototype spy never runs (the write succeeds, and the
+// quota/security cases see "false" instead of null). jsdom is the opposite:
+// localStorage.setItem IS Storage.prototype.setItem, and an own-property spy
+// is ignored. Spy whichever function the live call actually invokes.
+function spyLiveSetItem() {
+  const storage = window.localStorage
+  const target = storage.setItem === Storage.prototype.setItem ? Storage.prototype : storage
+
+  return vi.spyOn(target, 'setItem')
+}
+
 it('keeps the desktop toggle local across config refreshes', async () => {
   for (const fails of [false, true]) {
     for (const enabled of [false, true]) {
       localStorage.clear()
       vi.resetModules()
       const prefs = await import('./voice-prefs')
-      // jsdom's Storage ignores an own-property spy on the instance; patch the prototype.
-      const write = vi.spyOn(Storage.prototype, 'setItem')
+      const write = spyLiveSetItem()
 
       if (fails) {
         write.mockImplementation(() => {
@@ -56,8 +67,7 @@ it('migrates the legacy preference once, not on every refresh', async () => {
       localStorage.clear()
       vi.resetModules()
       const prefs = await import('./voice-prefs')
-      // jsdom's Storage ignores an own-property spy on the instance; patch the prototype.
-      const write = vi.spyOn(Storage.prototype, 'setItem')
+      const write = spyLiveSetItem()
 
       if (fails) {
         write.mockImplementation(() => {
diff --git a/apps/desktop/vitest.setup.ts b/apps/desktop/vitest.setup.ts
index d245e110df..ad231c0070 100644
--- a/apps/desktop/vitest.setup.ts
+++ b/apps/desktop/vitest.setup.ts
@@ -14,6 +14,12 @@ globalThis.ResizeObserver ??= InertResizeObserver as unknown as typeof ResizeObs
 // accessor shadows jsdom's Storage and every `localStorage.getItem(...)` in a
 // test throws "Cannot read properties of undefined". Install a real in-memory
 // Storage when the global resolves to nothing, before any test module reads it.
+//
+// This stand-in is a plain object, not a Storage instance. setItem/getItem live
+// on the object itself, so vi.spyOn(Storage.prototype, 'setItem') does not
+// intercept writes (CI: voice-prefs quota cases wrote "false"). Spy the live
+// function: window.localStorage.setItem === Storage.prototype.setItem means
+// jsdom (spy the prototype); otherwise spy the instance.
 if (typeof (globalThis as any).localStorage === 'undefined') {
   const store = new Map<string, string>()
 
