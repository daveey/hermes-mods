 hermes_cli/kanban_parent_unclaimed.py         | 29 ++++++++---
 hermes_cli/kanban_queue_position.py           | 14 ++++--
 .../test_kanban_wait_notice_pool_hint.py      | 48 ++++++++++++++++---
 4 files changed, 77 insertions(+), 19 deletions(-)

