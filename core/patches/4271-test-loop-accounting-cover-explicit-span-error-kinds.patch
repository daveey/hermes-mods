From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:08:30 +0000
Subject: [PATCH] test(loop-accounting): cover explicit span error kinds
 [daveey]

Audit #2965 found span_close could replace error_kind with None while all 48 tests passed. Add public-API coverage for ValueError and the error=False control. No production changes.

Proof: canonical test_loop_accounting.py 50 passed; exact span_close st.error(None) mutant 49 passed / 1 assertion failure / zero skips; old tests alone 48 passed. Restored-source run 50 passed. scripts/check --base origin/main: 20 checks OK.
---
 tests/hermes_cli/test_loop_accounting.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/tests/hermes_cli/test_loop_accounting.py b/tests/hermes_cli/test_loop_accounting.py
index 08c0b1b4aa..7fe5280831 100644
--- a/tests/hermes_cli/test_loop_accounting.py
+++ b/tests/hermes_cli/test_loop_accounting.py
@@ -94,6 +94,15 @@ def test_record_and_span_errors_carry_a_kind_or_count_as_unknown():
     assert la.counters()["span"]["error_kinds"] == {la.ERROR_KIND_UNKNOWN: 1}
 
 
+@pytest.mark.parametrize("error", [True, False], ids=["error", "no-error"])
+def test_span_close_counts_explicit_error_kind_only_for_errors(error):
+    assert la.span_close(la.span_open("explicit-kind"), error=error, error_kind="ValueError") is True
+    c = la.counters()["explicit-kind"]
+    assert c["runs"] == 1
+    assert c["errors"] == int(error)
+    assert c["error_kinds"] == ({"ValueError": 1} if error else {})
+
+
 def test_snapshot_carries_error_kinds_next_to_errors():
     with pytest.raises(OperationalError):
         with la.pass_("snap"):
