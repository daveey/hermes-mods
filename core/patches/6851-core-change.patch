Subject: [PATCH 6851] Replay sender: durable single-slot journal, deferred observation and bounded recovery (dormant)

Public mirror of source commit b3d784b7a6698482d533179007ae37ec5856454b.

---
diff --git a/tests/hermes_cli/test_kanban_sync_links_replica_revision.py b/tests/hermes_cli/test_kanban_sync_links_replica_revision.py
index 2898fd5273a6ce2171266d0331887b8df191b767..4d14ed03a8c9799bde0e5b1a0d08d30fd9e9e2e7 100644
--- a/tests/hermes_cli/test_kanban_sync_links_replica_revision.py
+++ b/tests/hermes_cli/test_kanban_sync_links_replica_revision.py
@@ -22,9 +22,13 @@
         # Schema growth must not turn cursor writes into a main-file rewrite signal.
         replica.execute("PRAGMA wal_checkpoint(TRUNCATE)")
         settled = f._settled(live, ledger, kanban_home, spies)
+        before = rev.read_key(replica, rev.SHADOW_TABLES)
+        stamp = ksc.shadow_path(f.BOARD).stat().st_mtime_ns
         for i in range(4):
             with kbc.write_txn(replica):
                 replica.execute('UPDATE kanban_sync_state SET cursor=cursor+1, pulled_at=?', (i,))
+            assert rev.read_key(replica, rev.SHADOW_TABLES) == before
+            assert ksc.shadow_path(f.BOARD).stat().st_mtime_ns == stamp
             f._pass(kanban_home)
         assert spies == {'reconcile': 0, 'backfill': 0}
         assert f._links(live) == settled
