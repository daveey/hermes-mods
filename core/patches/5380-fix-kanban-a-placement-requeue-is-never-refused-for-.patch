diff --git a/tests/hermes_cli/test_kanban_placement.py b/tests/hermes_cli/test_kanban_placement.py
index 419030a3a8..deeb50bdae 100644
--- a/tests/hermes_cli/test_kanban_placement.py
+++ b/tests/hermes_cli/test_kanban_placement.py
@@ -2030,3 +2030,93 @@ def test_placement_requeue_loops_escalate_on_the_third_requeue(mac, monkeypatch,
         kinds = [e.kind for e in kb.list_events(conn, child)]
         assert kinds.count("scheduled") == 2 and kaw.ESCALATED_EVENT in kinds, (actions, kinds)
