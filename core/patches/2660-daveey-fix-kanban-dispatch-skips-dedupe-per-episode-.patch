+* Flapping details (hub 2026-11-12: ``claim_deferred`` alternated ``capacity`` / ``hub_cpu_at_or_above_limit``
+  tick to tick and filled the 16-row cap in 5 min) add nothing once seen: the dedupe is against EVERY skip of the
+  episode, so an episode holds one row per distinct (reason, detail). The reason the latest tick saw lives in the
+  machine-local, unsynced :data:`SEEN_TABLE` (one row per card: episode anchor, current skip, keys recorded), so
+  :func:`latest` stays current after a flap or the cap without appending. The table also covers the pickup round
+  trip that duplicated a row: a foreign card's copy is evicted once its outbox drains and re-imported from the
+  replica, which may not have pulled the just-pushed skip back yet (``kanban_worker_node.evict``/``import_cards``);
+  a key this host recorded in the episode is not appended again while the replica catches up.
+* :func:`latest` is the current skip of the ready episode; ``kanban_queue_position``, the chat-wait and
   the parent-unclaimed notices name it (:func:`words`) and drop the priority advice unless it is about ordering
   (:func:`is_ordering`). A card ready :data:`UNRECORDED_AFTER_SECONDS` with free slots and no recorded reason
   reads :data:`UNRECORDED` (:func:`unrecorded`), never a priority bump.
@@ -25,6 +33,7 @@ tick.
 """
 from __future__ import annotations
 
+import json
 import logging
 import sqlite3
 import time
@@ -38,6 +47,10 @@ MAX_PER_EPISODE = 16
 DETAIL_CHARS = 200
 UNRECORDED_AFTER_SECONDS = 30 * 60
 UNRECORDED = "dispatcher skip reason unrecorded"
+SEEN_TABLE = "kanban_dispatch_skip_seen"
+SEEN_REFRESH_SECONDS = 60
+SEEN_RETENTION_SECONDS = 7 * 86400
+SEEN_MAX_ROWS = 5000
 # Events after which an earlier skip no longer describes the card (same set the recorded guard reads).
 _EPISODE_KINDS = ("continued", "scheduled", "reassigned", "reopened", "hold_released", "respawn_guarded")
 
@@ -63,35 +76,129 @@ def episode_skips(conn: sqlite3.Connection, task_id: str) -> list[dict[str, Any]
     return out
 
 
+def _anchor(conn: sqlite3.Connection, task_id: str) -> str:
+    """The episode's identity: ``kind@created_at`` of its opening event, '' before any. Not the event id: a
+    re-imported pickup copy renumbers ids, while kind and created_at travel unchanged."""
+    from hermes_cli import kanban_db as kb
+    kinds = sorted(_episode_kinds() - {EVENT})
+    row = conn.execute(
+        f"SELECT kind, created_at FROM task_events WHERE task_id = ? AND kind IN ({','.join('?' * len(kinds))}) "
+        "ORDER BY created_at DESC, id DESC LIMIT 1", (task_id, *kinds)).fetchone()
+    return "" if row is None else f"{row[0]}@{kb._to_epoch(row[1])}"
+
+
+def _key(reason: Any, detail: Any, until: Any) -> tuple[Any, Any, Any]:
+    # A moved reset is news for a quota hold (the notice names it); other reasons key on reason + detail.
+    return (reason, detail, until if reason == PINNED_QUOTA_WALL else None)
+
+
+def _skip_key(skip: dict[str, Any]) -> tuple[Any, Any, Any]:
+    return _key(skip.get("reason"), skip.get("detail"), skip.get("until"))
+
+
+def _has_seen_table(conn: sqlite3.Connection) -> bool:
+    return conn.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?",
+                        (SEEN_TABLE,)).fetchone() is not None
+
+
+def _seen(conn: sqlite3.Connection, task_id: str, anchor: str) -> Optional[dict[str, Any]]:
+    """This host's current-skip row for ``task_id`` when it belongs to episode ``anchor``; else None."""
+    if not _has_seen_table(conn):
+        return None
+    row = conn.execute(f"SELECT anchor, payload, keys, since, seen_at FROM {SEEN_TABLE} WHERE task_id = ?",
+                       (task_id,)).fetchone()
+    if row is None or row[0] != anchor:
+        return None
+    try:
+        payload, keys = json.loads(row[1]), {tuple(k) for k in json.loads(row[2])}
+    except (TypeError, ValueError):
+        return None
+    return ({"payload": payload, "keys": keys, "since": int(row[3]), "seen_at": int(row[4])}
+            if isinstance(payload, dict) else None)
+
+
 def latest(conn: sqlite3.Connection, task_id: str) -> Optional[dict[str, Any]]:
-    """The newest skip of the current ready episode (``reason``, ``detail``, ``until`` when known, ``at``)."""
+    """The current skip of the ready episode (``reason``, ``detail``, ``until`` when known, ``at``): the one this
+    host's ticks last saw, unless a skip this host never saw was recorded after that; else the newest row."""
     skips = episode_skips(conn, task_id)
-    return skips[0] if skips and isinstance(skips[0].get("reason"), str) else None
+    newest = skips[0] if skips and isinstance(skips[0].get("reason"), str) else None
+    seen = _seen(conn, task_id, _anchor(conn, task_id))
+    if seen is None:
+        return newest
+    if newest is not None and _skip_key(newest) not in seen["keys"] and (newest.get("at") or 0) > seen["seen_at"]:
+        return newest  # another dispatcher's verdict, newer than this host's
+    return {**seen["payload"], "at": seen["since"]}
+
+
+def _settled(conn: sqlite3.Connection, task_id: str, key: tuple[Any, Any, Any]) -> bool:
+    """Read-only precheck: ``key`` is already the card's current skip, confirmed within
+    :data:`SEEN_REFRESH_SECONDS`, so the tick needs no write transaction. A miss is rechecked under the write lock."""
+    seen = _seen(conn, task_id, _anchor(conn, task_id))
+    if seen is not None:
+        return _skip_key(seen["payload"]) == key and time.time() - seen["seen_at"] < SEEN_REFRESH_SECONDS
+    skips = episode_skips(conn, task_id)
+    return bool(skips) and _skip_key(skips[0]) == key
+
+
+def _write_seen(conn: sqlite3.Connection, task_id: str, anchor: str, payload: dict[str, Any],
+                keys: set[tuple[Any, Any, Any]], since: int) -> None:
+    conn.execute(f"CREATE TABLE IF NOT EXISTS {SEEN_TABLE} (task_id TEXT PRIMARY KEY, anchor TEXT NOT NULL, "
+                 "payload TEXT NOT NULL, keys TEXT NOT NULL, since INTEGER NOT NULL, seen_at INTEGER NOT NULL)")
+    conn.execute(
+        f"INSERT INTO {SEEN_TABLE} (task_id, anchor, payload, keys, since, seen_at) VALUES (?, ?, ?, ?, ?, ?) "
+        "ON CONFLICT (task_id) DO UPDATE SET anchor = excluded.anchor, payload = excluded.payload, "
+        "keys = excluded.keys, since = excluded.since, seen_at = excluded.seen_at",
+        (task_id, anchor, json.dumps(payload, ensure_ascii=False), json.dumps(sorted(keys, key=repr)), since,
+         int(time.time())))
 
 
 def record(conn: sqlite3.Connection, task_id: str, reason: str, *, detail: Any = None,
            until: Optional[float] = None, extra: Optional[dict[str, Any]] = None) -> bool:
-    """Append the skip unless the episode's latest skip already says the same; True when it appended."""
+    """Append the skip unless the episode already holds the same (reason, detail); True when it appended. Either
+    way it becomes the card's current skip (:func:`latest`)."""
     from hermes_cli import kanban_db as kb
     detail = None if detail is None else str(detail)[:DETAIL_CHARS]
+    until = None if until is None else int(until)
+    key = _key(reason, detail, until)
+    if _settled(conn, task_id, key):
+        return False
+    payload: dict[str, Any] = {"reason": reason, "detail": detail, **(extra or {})}
+    if until is not None:
+        payload["until"] = until
     with kb.write_txn(conn):
         row = conn.execute("SELECT status FROM tasks WHERE id = ?", (task_id,)).fetchone()
         if row is None or row["status"] not in ("ready", "review"):
             return False  # it left the lane this tick (no-progress park, claimed): nothing waits any more
-        skips = episode_skips(conn, task_id)
-        until = None if until is None else int(until)
-        # A moved reset is news for a quota hold (the notice names it); other reasons key on reason + detail.
-        key = (reason, detail, until if reason == PINNED_QUOTA_WALL else None)
-        if skips and (skips[0].get("reason"), skips[0].get("detail"),
-                      skips[0].get("until") if reason == PINNED_QUOTA_WALL else None) == key:
-            return False
-        if len(skips) >= MAX_PER_EPISODE:
-            return False
-        payload: dict[str, Any] = {"reason": reason, "detail": detail, **(extra or {})}
-        if until is not None:
-            payload["until"] = until
-        kb._append_event(conn, task_id, EVENT, payload)
-    return True
+        anchor, skips = _anchor(conn, task_id), episode_skips(conn, task_id)
+        seen = _seen(conn, task_id, anchor)
+        # Keys this host recorded count too: a pickup copy re-imported from a replica that has not pulled this
+        # host's just-pushed skip back yet reads as missing it for a tick or two (hub 2026-11-12).
+        keys = {_skip_key(s) for s in skips} | (seen["keys"] if seen else set())
+        append = key not in keys and len(skips) < MAX_PER_EPISODE
+        if append:
+            kb._append_event(conn, task_id, EVENT, payload)
+            keys.add(key)
+        current = seen is not None and _skip_key(seen["payload"]) == key
+        if seen is None or not current or append or time.time() - seen["seen_at"] >= SEEN_REFRESH_SECONDS:
+            since = seen["since"] if seen is not None and current else int(time.time())
+            _write_seen(conn, task_id, anchor, payload, keys, since)
+    return append
+
+
+def _prune_seen(conn: sqlite3.Connection) -> None:
+    """Drop current-skip rows unwritten for :data:`SEEN_RETENTION_SECONDS`, and the oldest past
+    :data:`SEEN_MAX_ROWS`. A pruned card falls back to its newest event until its next recorded change."""
+    if not _has_seen_table(conn):
+        return
+    floor = int(time.time()) - SEEN_RETENTION_SECONDS
+    stale = conn.execute(f"SELECT 1 FROM {SEEN_TABLE} WHERE seen_at < ? LIMIT 1", (floor,)).fetchone()
+    if not stale and conn.execute(f"SELECT count(*) FROM {SEEN_TABLE}").fetchone()[0] <= SEEN_MAX_ROWS:
+        return
+    from hermes_cli import kanban_db as kb
+    with kb.write_txn(conn):
+        conn.execute(f"DELETE FROM {SEEN_TABLE} WHERE seen_at < ?", (floor,))
+        conn.execute(f"DELETE FROM {SEEN_TABLE} WHERE task_id NOT IN (SELECT task_id FROM {SEEN_TABLE} "
+                     "ORDER BY seen_at DESC LIMIT ?)", (SEEN_MAX_ROWS,))
 
 
 def _tick_skips(result: Any) -> list[tuple[str, str, Any, Optional[float], dict[str, Any]]]:
@@ -117,6 +224,10 @@ def record_tick(conn: sqlite3.Connection, result: Any, *, dry_run: bool = False)
             written += record(conn, tid, reason, detail=detail, until=until, extra=extra)
         except Exception:  # health: allow BLE001 -- the skip already happened; its evidence is advisory
             _log.debug("kanban dispatch: skip record failed for %s (%s)", tid, reason, exc_info=True)
+    try:
+        _prune_seen(conn)
+    except Exception:  # health: allow BLE001 -- pruning advisory evidence never stops a tick
+        _log.debug("kanban dispatch: skip-seen prune failed", exc_info=True)
     return written
 
 
diff --git a/tests/hermes_cli/test_kanban_dispatch_skip.py b/tests/hermes_cli/test_kanban_dispatch_skip.py
index 47cbfdc2a7..ee7eaca61a 100644
--- a/tests/hermes_cli/test_kanban_dispatch_skip.py
+++ b/tests/hermes_cli/test_kanban_dispatch_skip.py
@@ -284,3 +284,157 @@ def test_skip_records_neither_reset_a_guard_hold_nor_grow_without_bound(board, m
         with kb.write_txn(conn):
             conn.execute("UPDATE tasks SET status = 'running' WHERE id = ?", (tid,))
         assert not skips.record(conn, tid, "per_profile_capped", detail="a")  # off the lane: nothing waits
+
+
+# --- flapping details, the pickup round trip, concurrent writers (hub 2026-11-12) ------------------------------
+# t_01a1c75a008956d3 got 8 rows in 5 min: claim_deferred flapped capacity <-> hub_cpu_at_or_above_limit, and the
+# dedupe only compared the newest row. One identical pair (28 s apart) came from the pickup copy being evicted and
+# re-imported from a replica that had not pulled the host's own just-pushed skip back yet.
+
+FLAP = ("capacity", "hub_cpu_at_or_above_limit")
+
+
+def _deferred(tid, detail):
+    from types import SimpleNamespace
+    return SimpleNamespace(claim_deferred=[(tid, detail)])
+
+
+def test_flapping_detail_over_40_ticks_keeps_two_rows_and_latest_tracks_the_current_one(board, monkeypatch):
+    clock = _clock(monkeypatch)
+    monkeypatch.setattr(qp, "_running_and_limit", lambda *_a: (4, 7))
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="flapping", assignee="a")
+        for i in range(40):
+            detail = FLAP[i % 2]
+            skips.record_tick(conn, _deferred(tid, detail))
+            assert skips.latest(conn, tid)["detail"] == detail, i
+            place = qp.position(conn, kb.get_task(conn, tid))
+            assert f"the Board deferred its claim ({detail})" in qp.describe(place), i
+            clock[0] += 10
+        assert [(p["reason"], p["detail"]) for p in _skips(conn, tid)] == [("claim_deferred", d) for d in FLAP]
+
+
+def test_latest_tracks_the_current_skip_after_the_episode_cap(board, monkeypatch):
+    clock = _clock(monkeypatch)
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="capped", assignee="a")
+        for i in range(skips.MAX_PER_EPISODE):
+            assert skips.record(conn, tid, "claim_deferred", detail=f"code{i}")
+            clock[0] += 1
+        assert not skips.record(conn, tid, "claim_deferred", detail="past_the_cap")
+        assert len(_skips(conn, tid)) == skips.MAX_PER_EPISODE
+        assert skips.latest(conn, tid)["detail"] == "past_the_cap"
+        clock[0] += 1
+        assert not skips.record(conn, tid, "claim_deferred", detail="code3")  # flaps back: still no row
+        assert skips.latest(conn, tid)["detail"] == "code3"
+
+
+def test_since_is_kept_while_the_skip_stays_current_and_writes_are_throttled(board, monkeypatch):
+    clock = _clock(monkeypatch)
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="steady", assignee="a")
+        skips.record(conn, tid, "claim_deferred", detail="capacity")
+        def seen_at():
+            return conn.execute(f"SELECT seen_at FROM {skips.SEEN_TABLE} WHERE task_id = ?", (tid,)).fetchone()[0]
+        for _ in range(5):
+            clock[0] += 10
+            skips.record(conn, tid, "claim_deferred", detail="capacity")
+        assert seen_at() == START  # inside the refresh window: no write
+        clock[0] += skips.SEEN_REFRESH_SECONDS
+        skips.record(conn, tid, "claim_deferred", detail="capacity")
+        assert seen_at() == clock[0]
+        assert skips.latest(conn, tid)["at"] == START  # the current reason holds since its first tick
+
+
+def test_reimported_copy_missing_its_own_skip_does_not_append_it_again(board, monkeypatch):
+    clock = _clock(monkeypatch)
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="picked up", assignee="a")
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, "continued", {})
+        clock[0] += 5
+        assert skips.record(conn, tid, "claim_deferred", detail="hub_cpu_at_or_above_limit")
+        pushed = conn.execute("SELECT task_id, run_id, kind, payload, created_at FROM task_events "
+                              "WHERE task_id = ? AND kind = ?", (tid, skips.EVENT)).fetchone()
+        # evict + import_cards: the history comes back renumbered, without the skip the replica has not pulled yet.
+        rows = conn.execute("SELECT task_id, run_id, kind, payload, created_at FROM task_events WHERE task_id = ? "
+                            "AND kind != ? ORDER BY id", (tid, skips.EVENT)).fetchall()
+        with kb.write_txn(conn):
+            conn.execute("DELETE FROM task_events WHERE task_id = ?", (tid,))
+            conn.executemany("INSERT INTO task_events (task_id, run_id, kind, payload, created_at) "
+                             "VALUES (?, ?, ?, ?, ?)", [tuple(r) for r in rows])
+        clock[0] += 28
+        assert not skips.record(conn, tid, "claim_deferred", detail="hub_cpu_at_or_above_limit")
+        assert _skips(conn, tid) == []
+        assert skips.latest(conn, tid)["detail"] == "hub_cpu_at_or_above_limit"
+        with kb.write_txn(conn):  # the replica catches up: exactly one row
+            conn.execute("INSERT INTO task_events (task_id, run_id, kind, payload, created_at) VALUES (?, ?, ?, ?, ?)",
+                         tuple(pushed))
+        assert len(_skips(conn, tid)) == 1
+
+
+def test_a_new_episode_starts_a_fresh_skip_history(board, monkeypatch):
+    clock = _clock(monkeypatch)
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="again", assignee="a")
+        skips.record(conn, tid, "claim_deferred", detail="capacity")
+        clock[0] += 5
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, "continued", {})
+        assert skips.latest(conn, tid) is None
+        clock[0] += 5
+        assert skips.record(conn, tid, "claim_deferred", detail="capacity")  # a key of the old episode is news
+        assert skips.latest(conn, tid)["at"] == clock[0]
+
+
+def test_another_writers_newer_skip_wins_until_this_host_records_again(board, monkeypatch):
+    clock = _clock(monkeypatch)
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="two writers", assignee="a")
+        skips.record(conn, tid, "claim_deferred", detail="capacity")
+        clock[0] += 30
+        with kb.write_txn(conn):  # synced in from another machine's dispatcher
+            kb._append_event(conn, tid, skips.EVENT, {"reason": "skipped_ineligible", "detail": "labels_mismatch"})
+        assert skips.latest(conn, tid)["detail"] == "labels_mismatch"
+        clock[0] += skips.SEEN_REFRESH_SECONDS
+        skips.record(conn, tid, "claim_deferred", detail="capacity")
+        assert skips.latest(conn, tid)["detail"] == "capacity"
+
+
+@pytest.mark.parametrize("precheck", [True, False])
+def test_two_connections_recording_the_same_key_concurrently_write_one_row(board, monkeypatch, precheck):
+    import threading
+    _clock(monkeypatch)
+    if not precheck:  # both reach the write lock: the in-transaction recheck alone must dedupe
+        monkeypatch.setattr(skips, "_settled", lambda *_a: False)
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="raced", assignee="a")
+    gate, results, errors = threading.Barrier(2), [], []
+
+    def writer():
+        try:
+            with kbc.connect() as mine:
+                gate.wait(timeout=10)
+                results.append(skips.record(mine, tid, "claim_deferred", detail="hub_cpu_at_or_above_limit"))
+        except Exception as exc:  # surfaced below
+            errors.append(exc)
+    threads = [threading.Thread(target=writer) for _ in range(2)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join(timeout=30)
+    assert not errors and sorted(results) == [False, True]
+    with kbc.connect() as conn:
+        assert len(_skips(conn, tid)) == 1
+
+
+def test_seen_rows_are_pruned(board, monkeypatch):
+    clock = _clock(monkeypatch)
+    with kbc.connect() as conn:
+        old = kb.create_task(conn, title="old", assignee="a")
+        skips.record(conn, old, "claim_deferred", detail="capacity")
+        clock[0] += skips.SEEN_RETENTION_SECONDS + 1
+        fresh = kb.create_task(conn, title="fresh", assignee="a")
+        skips.record_tick(conn, _deferred(fresh, "capacity"))
+        assert [r[0] for r in conn.execute(f"SELECT task_id FROM {skips.SEEN_TABLE}")] == [fresh]
+        assert skips.latest(conn, old)["detail"] == "capacity"  # falls back to the durable row
-- 
