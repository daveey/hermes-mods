From 299b5d9d214b04c660506cbe92cc0aa97c3c630e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:01:18 +0000
Subject: [PATCH] [daveey] Scrub allocator handoff before launch preparation

Review found marked degraded startup leaking allocator settings to child commands. Consume the mark before prepare_launch, and do not ensure twice. Full-bootstrap real-child regression: RED 1 failed/5 passed; GREEN 1495 passed across eleven bootstrap, relaunch and environment guard files.
---
 hermes_bootstrap.py                           | 10 ++--
 .../test_launch_malloc_bootstrap.py           | 46 +++++++++++++++++++
 2 files changed, 53 insertions(+), 3 deletions(-)
 create mode 100644 tests/hermes_cli/test_launch_malloc_bootstrap.py

diff --git a/hermes_bootstrap.py b/hermes_bootstrap.py
index 6b26534cb8..ee1f80263d 100644
--- a/hermes_bootstrap.py
+++ b/hermes_bootstrap.py
@@ -620,8 +620,14 @@ from hermes_cli._parser import command_argv
 # Repair needs only stdlib. Do not activate the damaged tree to reach it.
 _pm_repair = command_argv(sys.argv[1:])[:2] == ["pm", "repair"]
 if not _pm_repair:
+    from hermes_cli import launch_malloc
     from hermes_cli.venv_sync import exec_launch, prepare_launch, relaunch_command
 
+    # libmalloc already consumed our exec-time setting. Scrub before preparation
+    # can spawn children or fail into degraded startup; never ensure twice.
+    _malloc_consumed = launch_malloc.MARK in os.environ
+    if _malloc_consumed:
+        launch_malloc.ensure(sys.argv[1:])
     try:
         _launch_python = prepare_launch(_root, sys.argv[1:])
         if _launch_python is not None:
@@ -635,9 +641,7 @@ if not _pm_repair:
 
                 raise RelaunchExit(subprocess.call(_command))
             exec_launch(_launch_python, _command, sys.argv[1:])
-        else:
-            from hermes_cli import launch_malloc
-
+        elif not _malloc_consumed:
             launch_malloc.ensure(sys.argv[1:])
     except Exception as exc:
         if isinstance(exc, PermissionError) and (message := install_state_permission_message(_root, exc)):
diff --git a/tests/hermes_cli/test_launch_malloc_bootstrap.py b/tests/hermes_cli/test_launch_malloc_bootstrap.py
new file mode 100644
index 0000000000..e7819a6203
--- /dev/null
+++ b/tests/hermes_cli/test_launch_malloc_bootstrap.py
@@ -0,0 +1,46 @@
+"""Bootstrap must not leak exec-time allocator settings on degraded startup."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+
+@pytest.mark.parametrize("failed", [False, True])
+@pytest.mark.parametrize("marked,value", [(True, "1"), (False, "0"), (False, "1")])
+def test_bootstrap_child_environment(tmp_path, failed, marked, value):
+    source = Path(__file__).resolve().parents[2]
+    script = f'''
+import os, sys, subprocess
+sys.path.insert(0, {str(source)!r})
+from hermes_cli import venv_sync, _early_recovery
+import pm.environments
+_early_recovery.restore_interrupted_pull = lambda *a: False
+_early_recovery.recover_if_needed = lambda *a: None
+pm.environments.activate_dependencies = lambda *a: None
+def prepare(*a):
+    if {failed!r}:
+        raise RuntimeError('injected completion failure')
+    return None
+venv_sync.prepare_launch = prepare
+sys.argv = ['hermes', 'gateway', 'run']
+os.environ['MallocSpaceEfficient'] = {value!r}
+os.environ.pop('HERMES_LAUNCH_MALLOC_SET', None)
+if {marked!r}:
+    os.environ['HERMES_LAUNCH_MALLOC_SET'] = '1'
+import hermes_bootstrap
+code = 'import os,json; print(json.dumps([os.environ.get("MallocSpaceEfficient"), os.environ.get("HERMES_LAUNCH_MALLOC_SET")]))'
+child = subprocess.run([sys.executable, '-I', '-c', code], capture_output=True,
+                       text=True, encoding='utf-8', check=True, timeout=20)
+print(child.stdout.strip())
+'''
+    result = subprocess.run(
+        [sys.executable, "-I", "-c", script],
+        env=dict(os.environ, HERMES_HOME=str(tmp_path / "home")),
+        capture_output=True, text=True, encoding="utf-8", timeout=60, check=False,
+    )
+    assert result.returncode == 0, result.stderr
+    assert json.loads(result.stdout) == [None if marked else value, None]
+    assert ("injected completion failure" in result.stderr) == failed
-- 
