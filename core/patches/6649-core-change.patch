From c5ff6142572d4793598d6d4a9e573d83ade0a0bc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 26 Nov 2026 22:05:41 +0000
Subject: [PATCH 6649] Desktop session identity across gateway renames, clarify attention and first send

Public mirror of source commit c5ff6142572d4793598d6d4a9e573d83ade0a0bc.

---
diff --git a/apps/desktop/electron/profile-session-routing.test.ts b/apps/desktop/electron/profile-session-routing.test.ts
index 0a11fcfb963d777b9f02659fb029402d1069620c..b96eb46aabebc1944cf27e18808b9c514e75b259 100644
--- a/apps/desktop/electron/profile-session-routing.test.ts
+++ b/apps/desktop/electron/profile-session-routing.test.ts
@@ -1947,20 +1947,35 @@
 
 test('registry splice still replaces the same owner and legacy rows without a canonical gateway', () => {
   const merged: unknown[] = [ownedRow('s1', 'gw-a'), ownedRow('s2', null)]
+
   const { added } = spliceRegistrySessionRows(
     merged,
     [ownedRow('s1', 'gw-a', { connection_id: 'alias' }), ownedRow('s2', 'gw-a'), ownedRow('s2', null, { connection_id: 'alias' })],
     {}
   )
+
   assert.equal(added, 0)
   assert.equal(merged.length, 2)
 })
 
+test('registry splice keeps one connection as one row after its envelope gateway changes', () => {
+  for (const connection of ['', 'server']) {
+    const merged: unknown[] = [ownedRow('s1', 'local', { connection_id: connection })]
+    const updated = ownedRow('s1', 'hub', { connection_id: connection })
+    const { added } = spliceRegistrySessionRows(merged, [updated], {})
+    assert.equal(added, 0)
+    assert.equal(merged.length, 1)
+    // Registry splice retains the primary row rather than replacing its snapshot.
+    assert.deepEqual((merged[0] as { outcome: unknown }).outcome, ownedRow('s1', 'local').outcome)
+  }
+})
+
 test('pinned window keeps same-id pinned rows from two gateways', () => {
   const rows = [
     ownedRow('filler', 'gw-a'),
-    ownedRow('twin', 'gw-a', { pinned: true }),
-    ownedRow('twin', 'gw-b', { pinned: true })
+    ownedRow('twin', 'gw-a', { pinned: true, connection_id: 'connection-a' }),
+    ownedRow('twin', 'gw-b', { pinned: true, connection_id: 'connection-b' })
   ]
+
   assert.equal(mergeProfileSessionWindow(rows, 0, 1).length, 3)
 })
diff --git a/apps/desktop/src/app/chat/sidebar/session-index.test.ts b/apps/desktop/src/app/chat/sidebar/session-index.test.ts
index e8e7e80831ec2d89c43d42d92838e02aa1a714fd..da683aad5d8e7c814736d858333384804b5002d0 100644
--- a/apps/desktop/src/app/chat/sidebar/session-index.test.ts
+++ b/apps/desktop/src/app/chat/sidebar/session-index.test.ts
@@ -159,6 +159,7 @@
 describe('owner-qualified pins', () => {
   const owned = (gateway: string, extra: Partial<SessionInfo> = {}) =>
     row('kanban_owner_terminal', {
+      connection_id: gateway,
       outcome: { kind: 'done', status: { identity: { gateway, owner_epoch: 'e', profile: 'default', session_id: 'kanban_owner_terminal' } } },
       ...extra
     } as Partial<SessionInfo>)
