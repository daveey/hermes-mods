From fc0f7c9910bc386289be43bab2eeaec26f7086bb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 02:15:13 -0700
Subject: [PATCH] feat(update): [daveey] reuse a packaged/prebuilt desktop app
 stamped with an unchanged ancestor of HEAD

The update rebuilt (or refused HERMES_DESKTOP_PREBUILT_APP) whenever the app's
baked install-stamp commit was not exactly HEAD, even when every commit since
touched no desktop input. hermes-sync therefore had to pack each skipped head
after a quiet window, and a Desktop quit inside it made `hermes update` pack.

_stamp_commit_serves_head accepts a stamp commit that is HEAD, or an ancestor of
HEAD with `git diff --quiet <stamp> HEAD -- <sourceHash('desktop') inputs>`
(DESKTOP_SOURCE_INPUT_PATHS, test-enforced mirror of freshness.mjs). Both
_packaged_desktop_current_for_head and _prebuilt_desktop_app_mismatch use it;
the build receipt, renderer, node-pty and signature checks are unchanged.
bundle-skew (no runtime-path commits after the stamp) and bundle-swap (running
vs on-disk stamp) already treat such an app as current.
---
 hermes_cli/main_desktop.py            | 56 +++++++++++++++---
 tests/hermes_cli/test_source_build.py | 84 +++++++++++++++++++++++++--
 2 files changed, 127 insertions(+), 13 deletions(-)

diff --git a/hermes_cli/main_desktop.py b/hermes_cli/main_desktop.py
index 125919d6dd..d3b94bc675 100644
--- a/hermes_cli/main_desktop.py
+++ b/hermes_cli/main_desktop.py
@@ -139,14 +139,51 @@ def _packaged_desktop_current_for_head(desktop_dir: Path, project_root: Path) ->
     if resources is None:
         return False
     from hermes_cli.steward import read_install_stamp
-    from hermes_cli.version_info import _run_git
 
-    commit = read_install_stamp(resources).get("commit")
-    if not isinstance(commit, str) or commit != _run_git(project_root, "rev-parse", "HEAD"):
+    if not _stamp_commit_serves_head(project_root, read_install_stamp(resources).get("commit")):
         return False
     return not _desktop_build_needed(desktop_dir, project_root, source_mode=False)
 
 
+# [daveey] What the desktop build reads from the checkout: sourceHash('desktop') in
+# scripts/build/freshness.mjs (test-enforced mirror). The baked install stamp is the one desktop
+# input outside this list, and the only one a commit that touches none of these changes.
+DESKTOP_SOURCE_INPUT_PATHS = (
+    "apps/desktop", "apps/shared", "package.json", "package-lock.json", ".npmrc", "pm/lock.json",
+    "scripts/build", "scripts/generate-icons.mjs", "scripts/generate_icons.py",
+    "assets", "pyproject.toml", "uv.lock",
+)
+
+
+def _stamp_commit_serves_head(project_root: Path, commit: object) -> bool:
+    """True when an app baked from ``commit`` is the app HEAD would build.
+
+    [daveey] Either ``commit`` is HEAD, or it is an ancestor of HEAD and git proves no desktop
+    source input differs between the two. The app then differs from a fresh pack only in the
+    commit its stamp names, which bundle-skew (no runtime-path commits after it) and
+    bundle-swap (it compares the running app with the one on disk) both accept. Anything git
+    cannot answer means False ("build")."""
+    from hermes_cli.version_info import _run_git
+
+    if not isinstance(commit, str) or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", commit):
+        return False
+    head = _run_git(project_root, "rev-parse", "HEAD")
+    if not head:
+        return False
+    if commit == head:
+        return True
+
+    def git_ok(*args: str) -> bool:
+        try:
+            return subprocess.run(["git", *args], cwd=str(project_root), capture_output=True,
+                                  timeout=10, check=False).returncode == 0
+        except (OSError, subprocess.SubprocessError):
+            return False
+
+    return (git_ok("merge-base", "--is-ancestor", commit, head)
+            and git_ok("diff", "--quiet", commit, head, "--", *DESKTOP_SOURCE_INPUT_PATHS))
+
+
 # [daveey] A bundle packed off to the side (hermes-sync stages the next origin/main while Desktop turns
 # keep the update deferred) stands in for the update's own pack when it was built from the new HEAD.
 DESKTOP_PREBUILT_APP_ENV = "HERMES_DESKTOP_PREBUILT_APP"
@@ -165,9 +202,10 @@ def _prebuilt_signature_error(app: Path) -> Optional[str]:
 def _prebuilt_desktop_app_mismatch(app: Path, desktop_dir: Path, project_root: Path) -> Optional[str]:
     """Why the prebuilt ``Hermes.app`` can't stand in for packing HEAD, or None when it can.
 
-    Same bar as ``_packaged_desktop_current_for_head`` (baked commit == HEAD, intact renderer,
-    node-pty present, receipt current for THIS checkout's inputs) plus a verifying signature
-    that does not downgrade the live app's signing team."""
+    Same bar as ``_packaged_desktop_current_for_head`` (baked commit is HEAD or an ancestor no
+    desktop input changed since, intact renderer, node-pty present, receipt current for THIS
+    checkout's inputs) plus a verifying signature that does not downgrade the live app's
+    signing team."""
     if sys.platform != "darwin":
         return "prebuilt desktop apps are only supported on macOS"
     if not (app / "Contents" / "MacOS" / "Hermes").is_file():
@@ -177,9 +215,9 @@ def _prebuilt_desktop_app_mismatch(app: Path, desktop_dir: Path, project_root: P
 
     resources = app / "Contents" / "Resources"
     commit = read_install_stamp(resources).get("commit")
-    head = _run_git(project_root, "rev-parse", "HEAD")
-    if not isinstance(commit, str) or commit != head:
-        return f"built from {str(commit)[:10]}, HEAD is {str(head)[:10]}"
+    if not _stamp_commit_serves_head(project_root, commit):
+        head = _run_git(project_root, "rev-parse", "HEAD")
+        return f"built from {str(commit)[:10]}, HEAD is {str(head)[:10]} and desktop inputs differ or are unknown"
     dist = resources / "app.asar.unpacked" / "dist"
     if not dist.is_dir() or _renderer_bundle_torn(dist):
         return "renderer bundle missing or incomplete"
diff --git a/tests/hermes_cli/test_source_build.py b/tests/hermes_cli/test_source_build.py
index f9d100b112..b0a3eee579 100644
--- a/tests/hermes_cli/test_source_build.py
+++ b/tests/hermes_cli/test_source_build.py
@@ -386,8 +386,9 @@ def test_module_cli_builds_the_requested_products(source_products, desktop, monk
 
 @pytest.mark.platforms("macos")
 def test_packaged_desktop_is_reused_only_while_it_names_head(tmp_path, monkeypatch):
-    """The update skips the desktop build only when the shipped app's baked commit is HEAD
-    and its receipt is current; a moved HEAD or an unreadable stamp means build."""
+    """The update skips the desktop build only when the shipped app's baked commit is HEAD, or
+    [daveey] an ancestor of HEAD that no desktop input changed since, and its receipt is current.
+    A desktop input change, an unrelated commit or an unreadable stamp means build."""
     from hermes_cli import main_desktop
 
     root = tmp_path / "checkout"
@@ -395,6 +396,7 @@ def test_packaged_desktop_is_reused_only_while_it_names_head(tmp_path, monkeypat
     git = ["git", "-C", str(root), "-c", "user.name=t", "-c", "user.email=t@example.invalid"]
     subprocess.run([*git[:3], "init", "-q"], check=True)
     subprocess.run([*git, "commit", "-q", "--allow-empty", "-m", "one"], check=True)
+    (root / ".git/info/exclude").write_text("apps/desktop/release/\n", encoding="utf-8")  # as in the repo
     desktop_dir = root / "apps/desktop"
     exe = desktop_dir / "release/app/Hermes"
     monkeypatch.setattr(main_desktop, "_desktop_packaged_executable", lambda _d: exe)
@@ -407,6 +409,12 @@ def test_packaged_desktop_is_reused_only_while_it_names_head(tmp_path, monkeypat
     def head():
         return subprocess.run([*git[:3], "rev-parse", "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
 
+    def commit_file(rel):
+        (root / rel).parent.mkdir(parents=True, exist_ok=True)
+        (root / rel).write_text(rel, encoding="utf-8")
+        subprocess.run([*git, "add", "-A"], check=True)
+        subprocess.run([*git, "commit", "-q", "-m", rel], check=True)
+
     def reused():
         return main_desktop._packaged_desktop_current_for_head(desktop_dir, root)
 
@@ -417,10 +425,32 @@ def test_packaged_desktop_is_reused_only_while_it_names_head(tmp_path, monkeypat
     assert not reused()
     receipt_current["value"] = True
     subprocess.run([*git, "commit", "-q", "--allow-empty", "-m", "two"], check=True)
-    assert not reused()
+    commit_file("agent/run.py")
+    assert reused()  # HEAD moved, but nothing the desktop build reads changed
+    commit_file("apps/desktop/src/a.ts")
+    assert not reused()  # a desktop input changed after the baked commit
+    (resources / "install-stamp.json").write_text(json.dumps({"commit": head()}), encoding="utf-8")
+    assert reused()
+    subprocess.run([*git, "checkout", "-q", "--orphan", "other"], check=True)
+    subprocess.run([*git, "commit", "-q", "--allow-empty", "-m", "unrelated"], check=True)
+    assert not reused()  # the baked commit is not an ancestor of HEAD
+
+
+def test_desktop_input_paths_mirror_the_desktop_source_hash():
+    """The git-level check covers exactly the inputs sourceHash('desktop') hashes."""
+    import re
+
+    from hermes_cli import main_desktop
+
+    src = (Path(__file__).resolve().parents[2] / "scripts/build/freshness.mjs").read_text(encoding="utf-8")
+    body = src[src.index("export function sourceHash"):]
+    listed = body[body.index("workspace,") + len("workspace,"):body.index("], name =>")]
+    listed = re.sub(r"//[^\n]*", "", listed)
+    paths = ["apps/desktop", *re.findall(r"'([^']+)'", listed)]
+    assert sorted(main_desktop.DESKTOP_SOURCE_INPUT_PATHS) == sorted(paths)
 
 
-def _prebuilt_fixture(tmp_path, monkeypatch, *, stamp_commit=None):
+def _prebuilt_fixture(tmp_path, monkeypatch, *, stamp_commit=None, head_change=None):
     """A checkout at HEAD with a live packaged app, plus a prebuilt app staged elsewhere
     (HERMES_DESKTOP_PREBUILT_APP). Records whether the normal desktop build ran."""
     from hermes_cli import main_desktop, source_build
@@ -433,6 +463,13 @@ def _prebuilt_fixture(tmp_path, monkeypatch, *, stamp_commit=None):
     subprocess.run([*git, "commit", "-q", "--allow-empty", "-m", "one"], check=True)
     head = subprocess.run([*git[:3], "rev-parse", "HEAD"], capture_output=True, text=True,
                           check=True).stdout.strip()
+    if head_change:
+        # The prebuilt names commit "one"; HEAD moves past it with one change at ``head_change``.
+        stamp_commit = stamp_commit or head
+        (root / head_change).parent.mkdir(parents=True, exist_ok=True)
+        (root / head_change).write_text("changed", encoding="utf-8")
+        subprocess.run([*git, "add", "-A"], check=True)
+        subprocess.run([*git, "commit", "-q", "-m", head_change], check=True)
 
     def app_at(base, marker, commit):
         app = base / "mac-arm64/Hermes.app"
@@ -512,3 +549,42 @@ def test_update_builds_without_a_prebuilt_desktop_app(tmp_path, monkeypatch):
     monkeypatch.delenv("HERMES_DESKTOP_PREBUILT_APP")
     _build_desktop_product(root, {"PATH": os.environ["PATH"]}, lambda _label: None)
     assert len(built) == 1
+
+
+@pytest.mark.platforms("macos")
+def test_update_swaps_in_a_prebuilt_from_an_ancestor_with_unchanged_desktop_inputs(tmp_path, monkeypatch, capsys):
+    """[daveey] hermes-sync keeps one build while new heads touch no desktop input. A prebuilt
+    stamped with such an ancestor of HEAD is installed, and nothing afterwards rebuilds it: the
+    re-entered update reuses it and `hermes desktop` launch reads it as current."""
+    from hermes_cli import main_desktop
+    from hermes_cli.source_build import _build_desktop_product
+
+    real_head_gate = main_desktop._packaged_desktop_current_for_head
+    root, desktop_dir, built = _prebuilt_fixture(tmp_path, monkeypatch, head_change="agent/run.py")
+    _build_desktop_product(root, {"PATH": os.environ["PATH"]}, lambda _label: None)
+    assert built == []
+    live = desktop_dir / "release/mac-arm64/Hermes.app/Contents/MacOS/Hermes"
+    assert live.read_text() == "prebuilt app"
+    assert "installed the prebuilt desktop app" in capsys.readouterr().out.lower()
+
+    # After install: the real HEAD gate (an "Already up to date" re-entry, a retried tail) and
+    # the launch freshness gate both keep the installed app.
+    monkeypatch.setattr(main_desktop, "_packaged_desktop_current_for_head", real_head_gate)
+    assert main_desktop._packaged_desktop_current_for_head(desktop_dir, root)
+    assert not main_desktop._desktop_build_needed(desktop_dir, root, source_mode=False)
+    monkeypatch.delenv("HERMES_DESKTOP_PREBUILT_APP")
+    _build_desktop_product(root, {"PATH": os.environ["PATH"]}, lambda _label: None)
+    assert built == []
+    assert live.read_text() == "prebuilt app"
+
+
+@pytest.mark.platforms("macos")
+@pytest.mark.parametrize("change", ["apps/desktop/src/a.ts", "apps/shared/src/x.ts", "package-lock.json"])
+def test_update_builds_when_a_desktop_input_changed_since_the_prebuilt_commit(tmp_path, monkeypatch, capsys, change):
+    from hermes_cli.source_build import _build_desktop_product
+
+    root, desktop_dir, built = _prebuilt_fixture(tmp_path, monkeypatch, head_change=change)
+    _build_desktop_product(root, {"PATH": os.environ["PATH"]}, lambda _label: None)
+    assert len(built) == 1
+    assert (desktop_dir / "release/mac-arm64/Hermes.app/Contents/MacOS/Hermes").read_text() == "previous app"
+    assert "not used" in capsys.readouterr().out
