diff --git a/docs/history-residue-audit.md b/docs/history-residue-audit.md
new file mode 100644
index 00000000000..53e48858fdd
--- /dev/null
+++ b/docs/history-residue-audit.md
@@ -0,0 +1,45 @@
+# Historical rejected-event audit (not transport retirement)
+
+This diagnostic addresses only frozen `task_events` upserts refused with the exact
+containment/spend reasons accepted by `kanban_history_residue_source`. It does not
+execute, replay, remove, rewrite, settle or accept the rejected operation. Ambiguous
+historical identity remains ambiguous. Existing restrictions remain in force.
+
+After normal server/core review, CI, landing and deployment:
+
+```
+hermes kanban --board default sync history-residue OP_ID --reason 'Retain historical rejected intent without replay' --json
+hermes kanban --board default sync diff --history-evidence --json
+```
+
+The first command stores the complete exact local outbox source in a separate
+`sync-shadow/default.history-residue.db` sidecar. It stages immutable request
+custody under short local/replica reservations, releases SQLite reservations, then
+sends at most one authenticated POST and requires an authenticated GET readback.
+An existing intent is GET-only even if its first process exited before POST.
+A missing readback remains unresolved; there is no replacement identity or resend.
+The sidecar contains reported historical source bytes; keep it private and retain
+it with the original board/evidence. It is not a normal synced task table.
+
+`sync diff` never trusts that sidecar alone. A successful nonbusy diagnostic pull
+must precede a same-head empty feed / fresh current observation / empty feed cut.
+The consumer matches the full exact source, local event, sealed receipt and
+portable local/replica/canonical parent, and vetoes active workers, claims, leases,
+new local work, tombstones, omissions and quarantine. Existing containment/spend
+restrictions are retained, not released. All network reads occur without SQLite
+writer reservations. Final zero-wait reservations compare the original snapshots
+and build the actual diff before releasing them. The 30-second monotonic evidence
+budget includes refresh, local lock acquisition, HTTP and final comparisons.
+
+The raw `rejected_ops` count stays unchanged. `audited_history_rejections` names
+only exact IDs verified in that particular cut. Unknown rejections and unrelated
+row/child drift still prevent clean. Ordinary local `kanban_sync_client.diff`
+has no historical receipt exemption. No stored proof can be applied to a later
+diff. Busy, partial, stale, unavailable or conflicting proof fails closed.
+
+`--history-evidence` includes exact per-row source and current response bytes,
+plus both empty-feed brackets and their head. Treat this output as private audit
+evidence, not publication material. The output explicitly retains
+`historical_identity_certified=false` and `execution_authority=false`.
+`no_retained_op_receipt` is only a current cache observation; it is never a
+never-seen operation claim or historical admission proof.
diff --git a/hermes_cli/kanban_history_residue_board.py b/hermes_cli/kanban_history_residue_board.py
new file mode 100644
index 00000000000..a45d3ec2022
--- /dev/null
+++ b/hermes_cli/kanban_history_residue_board.py
@@ -0,0 +1,112 @@
+"""Configured-board entry points for immutable historical audit custody. [daveey]"""
+from __future__ import annotations
+
+from contextlib import ExitStack, closing
+import json
+from pathlib import Path
+import sqlite3
+import time
+
+from hermes_cli import kanban_history_residue_custody as custody
+from hermes_cli import kanban_history_residue_cut as cut
+from hermes_cli import kanban_history_residue_http as transport
+from hermes_cli.kanban_history_residue_source import Refused, _require, decode_source, strict_object
+
+
+def ledger_path(board):
+    from hermes_cli.kanban_sync_client import shadow_path
+    return shadow_path(board).with_suffix('.history-residue.db')
+
+
+def _paths(live, shadow, board):
+    from hermes_cli.kanban_db import kanban_db_path
+    from hermes_cli.kanban_sync_client import shadow_path
+    paths = [Path(c.execute('PRAGMA database_list').fetchone()[2]).resolve() for c in (live, shadow)]
+    expected = [kanban_db_path(board=board).resolve(), shadow_path(board).resolve()]
+    _require(paths == expected and paths[0] != paths[1], 'configured_paths_required')
+    return paths
+
+
+def _ledger(board, *, create=False):
+    path = ledger_path(board)
+    _require(not path.is_symlink(), 'custody_symlink')
+    if create and not path.exists():
+        # Parent is the existing managed shadow directory. Never initialize a live board here.
+        try:
+            with path.open('xb'):
+                pass
+            path.chmod(0o600)
+        except FileExistsError:
+            pass
+    return sqlite3.connect(path.resolve().as_uri() + '?mode=rw', uri=True, isolation_level=None, timeout=0)
+
+
+def audit_diff(live, shadow, hub, board, *, pulled, started):
+    """Fresh nonbusy CLI diff only; report is built while final local reservations hold."""
+    from hermes_cli.kanban_sync_guard import board_sync_lock
+    paths = _paths(live, shadow, board)
+    _require(not pulled.busy and not pulled.more, 'diagnostic_refresh_incomplete')
+    with board_sync_lock(paths[0]), closing(_ledger(board)) as ledger:
+        identity = transport.scope(hub, board)
+        rows = ledger.execute(f'SELECT op_id FROM {custody.INTENTS} WHERE endpoint=? AND board=? AND gateway=? '
+                              'ORDER BY op_id LIMIT ?', (*identity, cut.MAX_OPS + 1)).fetchall()
+        _require(bool(rows) and len(rows) <= cut.MAX_OPS, 'cut_ops_bound')
+        return cut.verify(live, shadow, ledger, hub, board, [r[0] for r in rows], started=started)
+
+
+def observe_board(board, op_id, reason):
+    """Explicit historical observation, never retirement/replay or execution release.
+
+    Existing intent is GET-only. Stage while exact local inputs are reserved, then
+    release all SQLite reservations before HTTP. Uncertain delivery stays the same
+    immutable intent, even if a process exited before sending the first POST.
+    """
+    from hermes_cli import kanban_db_connect as kbc
+    from hermes_cli import kanban_sync_client as client
+    from hermes_cli.kanban_db import kanban_db_path
+    from hermes_cli.kanban_sync_guard import board_sync_lock
+
+    started = time.monotonic()
+    _require(isinstance(reason, str) and bool(reason.strip()), 'reason_required')
+    ident = client.load_identity()
+    hub = client.Hub(ident)
+    with ExitStack() as stack:
+        stack.callback(hub.close)
+        path = kanban_db_path(board=board)
+        pulled = client._pull_replica(board, hub, ident.gateway, path, diagnostic=True)
+        _require(not pulled.busy and not pulled.more, 'diagnostic_refresh_incomplete')
+        stack.enter_context(board_sync_lock(path))
+        live = kbc.connect(path)
+        shadow = client.open_shadow(board, ident.gateway)
+        stack.callback(live.close)
+        stack.callback(shadow.close)
+        _paths(live, shadow, board)
+        ledger = _ledger(board, create=True)
+        stack.callback(ledger.close)
+        identity = transport.scope(hub, board)
+        old = custody.lookup(ledger, identity, op_id)
+        if old is None:
+            rows = cut.local._rows(live, 'SELECT * FROM kanban_sync_outbox WHERE op_id=?', (op_id,))
+            _require(len(rows) == 1, 'source_missing')
+            source = json.dumps(rows[0], sort_keys=True, ensure_ascii=True)
+            decode_source(source)
+        else:
+            request, _ = custody._request(old['request_json'])
+            _require(request['reason'] == reason, 'intent_conflict')
+            source = request['source_json']
+        with ExitStack() as reservations:
+            for conn in (live, shadow):
+                reservations.enter_context(cut._transaction(conn, reserve=True))
+            snapshots = cut._capture(live, shadow, source, board, ident.gateway)
+            _require(snapshots[0]['portable'] == snapshots[1]['portable'], 'portable_parent_changed')
+            request_json = old['request_json'] if old else json.dumps(dict(version=1,
+                task=strict_object(decode_source(source)['fields'])['task_id'],
+                expected_version=snapshots[0]['portable']['version'], source_json=source, reason=reason))
+            cut._fresh(started)
+            first = custody.stage_once(ledger, identity, request_json)
+        if first:
+            try:
+                transport._request(hub, 'POST', transport._path(board), request_json.encode('utf-8'))
+            except (OSError, client.HubError, Refused, ValueError):
+                pass  # Only exact GET can reconcile an uncertain outcome; never POST again.
+        return transport.reconcile(ledger, hub, board, op_id)
diff --git a/hermes_cli/kanban_history_residue_cut.py b/hermes_cli/kanban_history_residue_cut.py
new file mode 100644
index 00000000000..e601ab33fc1
--- /dev/null
+++ b/hermes_cli/kanban_history_residue_cut.py
@@ -0,0 +1,117 @@
+"""Ephemeral same-head history audit cut; no cached exemptions or source writes.
+
+Network happens without SQLite writer locks. Short final reservations then CAS
+both snapshots, so claims cannot race the report's construction. Board feed cuts
+are observations, not a distributed lock or past-identity certification. [daveey]
+"""
+from __future__ import annotations
+
+from contextlib import ExitStack, contextmanager
+import json
+import time
+
+from hermes_cli import kanban_history_residue_custody as custody
+from hermes_cli import kanban_history_residue_http as transport
+from hermes_cli import kanban_history_residue_local as local
+from hermes_cli.kanban_history_residue_source import _require, strict_object, validate_current
+
+MAX_AGE = 30.0
+MAX_OPS = 20
+
+
+def _fresh(started):
+    _require(0 <= time.monotonic() - started <= MAX_AGE, 'evidence_expired')
+
+
+@contextmanager
+def _transaction(conn, *, reserve=False):
+    _require(not conn.in_transaction, 'nested_cut_transaction')
+    old = conn.execute('PRAGMA busy_timeout').fetchone()[0]
+    try:
+        # Never stall an executor behind a diagnostic. No writes occur even when reserving.
+        conn.execute('PRAGMA busy_timeout=0')
+        conn.execute('BEGIN IMMEDIATE' if reserve else 'BEGIN')
+        yield
+    finally:
+        if conn.in_transaction:
+            conn.rollback()
+        conn.execute(f'PRAGMA busy_timeout={old}')
+
+
+def _empty(hub, board, head):
+    data = hub.changes(board, head)
+    _require(isinstance(data, dict) and data.get('changes') == [] and data.get('more') is False
+             and type(data.get('head')) is int and type(data.get('next')) is int
+             and data['head'] == head == data['next'], 'authoritative_feed_changed')
+    return data
+
+
+def _capture(live, shadow, raw, board, gateway):
+    return [local.snapshot(conn, raw, board=board, gateway=gateway, replica=replica)
+            for conn, replica in ((live, False), (shadow, True))]
+
+
+def verify(live, shadow, ledger, hub, board, op_ids, *, started):
+    """Internal cut assembly. Caller MUST own board lock after a nonbusy diagnostic refresh.
+
+    This function returns evidence only. Ordinary sync.diff cannot consume a saved
+    result as an exemption. A future diagnostic wrapper must build its report in
+    the final reservations, not apply this evidence to a later diff.
+    """
+    _require(all(not c.in_transaction for c in (live, shadow, ledger)), 'nested_cut_transaction')
+    _require(0 < len(op_ids) <= MAX_OPS and len(set(op_ids)) == len(op_ids), 'cut_ops_bound')
+    identity = transport.scope(hub, board)
+    _fresh(started)
+    records, snapshots = [], []
+    with ExitStack() as stack:
+        for conn in (live, shadow, ledger):
+            stack.enter_context(_transaction(conn))
+        for op_id in op_ids:
+            saved = custody.lookup(ledger, identity, op_id)
+            _require(saved is not None and saved['receipt_json'] is not None, 'sealed_custody_missing')
+            request, source = custody._request(saved['request_json'])
+            _require(source['op_id'] == op_id, 'custody_op_identity')
+            snaps = _capture(live, shadow, request['source_json'], board, identity[2])
+            _require(snaps[0]['portable'] == snaps[1]['portable'], 'portable_parent_changed')
+            records.append((op_id, saved, request))
+            snapshots.append(snaps)
+    head = snapshots[0][1]['state'][0]['cursor']
+    _require(type(head) is int and head >= 0
+             and all(s[1]['state'][0]['cursor'] == head for s in snapshots), 'replica_cursor_changed')
+    begin = _empty(hub, board, head)
+    evidence = []
+    for (op_id, saved, request), snaps in zip(records, snapshots):
+        _fresh(started)
+        raw = transport.current(hub, board, op_id)
+        current = validate_current(raw, request['source_json'], gateway=identity[2], board=board, head=head)
+        data = strict_object(raw, max_bytes=transport.MAX_RESPONSE)
+        # Exact immutable receipt bytes are retained; compare the parsed response
+        # structurally without Python bool/int equivalence.
+        _require(json.dumps(data['receipt'], sort_keys=True) ==
+                 json.dumps(strict_object(saved['receipt_json'], max_bytes=transport.MAX_RESPONSE), sort_keys=True),
+                 'current_receipt_conflict')
+        for key, value in snaps[1]['portable'].items():
+            _require(key in current['parent'] and json.dumps(current['parent'][key], sort_keys=True) ==
+                     json.dumps(value, sort_keys=True), 'canonical_parent_changed')
+        evidence.append({'op_id': op_id, 'source_json': request['source_json'], 'proof_json': raw})
+    end = _empty(hub, board, head)
+    with ExitStack() as stack:
+        for conn in (live, shadow, ledger):
+            stack.enter_context(_transaction(conn, reserve=True))
+        _fresh(started)
+        for (op_id, saved, request), old in zip(records, snapshots):
+            _require(custody.lookup(ledger, identity, op_id) == saved, 'custody_changed')
+            _require(_capture(live, shadow, request['source_json'], board, identity[2]) == old,
+                     'local_cut_inputs_changed')
+        _fresh(started)
+        from hermes_cli.kanban_sync_client import diff
+        report = diff(live, shadow, identity[2])
+        audits = set(report['audited_retain_rejections']) | set(op_ids)
+        report['audited_history_rejections'] = list(op_ids)
+        report['clean'] = not (report['missing_in_shadow'] or report['extra_in_shadow']
+                              or report['field_mismatch'] or report['child_mismatch']
+                              or report['rejected_ops'] != len(audits))
+        _fresh(started)
+        return {'head': head, 'audited_history_rejections': list(op_ids), 'evidence': evidence, 'diff': report,
+                'begin': begin, 'end': end, 'snapshot_only': True, 'execution_authority': False,
+                'historical_identity_certified': False}
diff --git a/hermes_cli/kanban_history_residue_local.py b/hermes_cli/kanban_history_residue_local.py
new file mode 100644
index 00000000000..52f143d1757
--- /dev/null
+++ b/hermes_cli/kanban_history_residue_local.py
@@ -0,0 +1,103 @@
+"""Bounded read-only local inputs for a current historical audit, not a hold release.
+
+Containment/spend restrictions remain untouched and are not vetoed merely for
+existing: this classification authorizes no execution. Quarantine, omissions,
+new local work and any active executor do veto it. [daveey]
+"""
+from __future__ import annotations
+
+import json
+
+from hermes_cli import kanban_db_sync as sync
+from hermes_cli.kanban_history_residue_source import _positive, _require, decode_source, strict_object
+
+MAX_ROWS = 100
+MAX_SNAPSHOT_BYTES = 2 * 1024 * 1024
+
+
+def _rows(conn, sql, args=()):
+    cursor = conn.execute(sql, args)
+    # Check encoded byte budget BEFORE materializing potentially large source cells.
+    names = [c[0] for c in cursor.description]
+    bound = '+'.join(f'6*COALESCE(length(CAST("{c}" AS BLOB)),4)' for c in names)
+    total = conn.execute(f'SELECT COALESCE(sum({bound}),0),count(*) FROM ({sql})', args).fetchone()
+    _require(total[0] <= MAX_SNAPSHOT_BYTES and total[1] <= MAX_ROWS, 'local_snapshot_bound')
+    result = []
+    size = 0
+    for row in cursor.fetchmany(MAX_ROWS + 1):
+        _require(len(result) < MAX_ROWS, 'local_rows_bound')
+        item = dict(zip(names, row))
+        size += len(json.dumps(item, ensure_ascii=True).encode())
+        _require(size <= MAX_SNAPSHOT_BYTES, 'local_bytes_bound')
+        result.append(item)
+    return result
+
+
+def _portable(task):
+    columns = sync.SYNCED_COLUMNS['tasks'] | sync.SERVER_COLUMNS['tasks']
+    _require(columns <= task.keys(), 'task_schema_incomplete')
+    out = {k: task[k] for k in sorted(columns - {'current_run_id'})}
+    for key in sync.JSON_SERVER_COLUMNS['tasks']:
+        if isinstance(out[key], str):
+            out[key] = strict_object(out[key], max_bytes=MAX_SNAPSHOT_BYTES)
+    out.update(id=task['id'], uid=task['id'], version=task['sync_version'], current_run_uid=None)
+    return out
+
+
+def snapshot(conn, exact_source, *, board, gateway, replica):
+    """Caller pins a read transaction; final cut rechecks under short writer reservations.
+
+    Missing schema/errors fail closed. Return complete relevant rows for equality
+    comparison; do not normalize source fields, frozen wire or local history IDs.
+    """
+    source = decode_source(exact_source)
+    fields = strict_object(source['fields'])
+    task_id, event = fields['task_id'], source['row_uid']
+    states = _rows(conn, 'SELECT * FROM kanban_sync_state')
+    _require(len(states) == 1 and states[0]['board_id'] == board and states[0]['gateway_id'] == gateway
+             and states[0]['mode'] == ('shadow' if replica else 'primary')
+             and states[0]['applying'] == 0, 'local_sync_identity')
+    tasks = _rows(conn, 'SELECT * FROM tasks WHERE id=?', (task_id,))
+    _require(len(tasks) == 1, 'local_task_missing')
+    task = tasks[0]
+    _require(task['status'] in ('triage', 'archived') and task['created_on'] == gateway
+             and _positive(task['sync_version']), 'local_task_identity')
+    for key in ('current_run_id', 'claim_lock', 'claim_expires', 'worker_pid', 'worker_started_at',
+                'lease_holder', 'lease_expires'):
+        _require(key in task and task[key] is None, 'local_executor_active')
+    runs = _rows(conn, 'SELECT * FROM task_runs WHERE task_id=? ORDER BY id', (task_id,))
+    _require(all(r['ended_at'] is not None and r['status'] != 'running' for r in runs), 'local_running_run')
+    events = _rows(conn, 'SELECT * FROM task_events WHERE uid=? ORDER BY id', (event,))
+    if replica:
+        _require(not events, 'replica_event_present')
+    else:
+        _require(len(events) == 1, 'local_event_missing')
+        e = events[0]
+        actual = {key: e[key] for key in ('task_id', 'kind', 'payload', 'created_at')}
+        actual['run_uid'] = None
+        _require(e['run_id'] is None and actual == fields, 'local_event_changed')
+    ops = _rows(conn, "SELECT * FROM kanban_sync_outbox WHERE (table_name='tasks' AND row_uid=?) "
+                "OR (table_name='task_events' AND row_uid=?) OR "
+                "(table_name='task_runs' AND row_uid IN (SELECT uid FROM task_runs WHERE task_id=?)) OR "
+                "CASE WHEN json_valid(fields) THEN json_extract(fields,'$.task_id')=? ELSE 0 END ORDER BY op_id",
+                (task_id, event, task_id, task_id))
+    if replica:
+        _require(not ops, 'replica_local_work')
+    else:
+        same = [o for o in ops if o['row_uid'] == event and o['table_name'] == 'task_events']
+        _require(len(same) == 1 and json.dumps(same[0], sort_keys=True, ensure_ascii=True) ==
+                 json.dumps(source, sort_keys=True, ensure_ascii=True), 'local_source_changed')
+        _require(all(o['table_name'] == 'task_events' and o['state'] == 'rejected' for o in ops), 'local_uncovered_work')
+    tombstones = _rows(conn, 'SELECT * FROM kanban_sync_tombstones WHERE '
+                       "(table_name='tasks' AND row_uid=?) OR (table_name='task_events' AND row_uid=?) OR "
+                       "(table_name='task_runs' AND row_uid IN (SELECT uid FROM task_runs WHERE task_id=?))",
+                       (task_id, event, task_id))
+    omissions = _rows(conn, "SELECT * FROM kanban_sync_omissions WHERE state!='delivered' AND "
+                     "((table_name='tasks' AND row_uid=?) OR (table_name='task_events' AND row_uid=?) OR "
+                     "(table_name='task_runs' AND row_uid IN (SELECT uid FROM task_runs WHERE task_id=?)))",
+                     (task_id, event, task_id))
+    _require(not tombstones and not omissions, 'local_repair_hold')
+    from hermes_cli.kanban_sync_quarantine import held
+    _require(not held(conn, task_id), 'local_quarantine')
+    return {'state': states, 'task': tasks, 'portable': _portable(task), 'runs': runs,
+            'event': events, 'ops': ops, 'tombstones': tombstones, 'omissions': omissions}
