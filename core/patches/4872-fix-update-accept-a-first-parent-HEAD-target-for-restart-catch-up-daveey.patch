From bf6763a62a86e56cefd4b53e56b97f03b5920cc3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 19:04:50 +0000
Subject: [PATCH] fix(update): accept a first-parent HEAD target for restart
 catch-up [daveey]

A handed Desktop prebuild serves the planned commit, but an unpinned zero-commit
update can fetch and advance beyond it. Permit --up-to HEAD only when that commit
is on fetched origin/main's first-parent line. Keep target identity and reuse the
existing zero-count completion path without upstream sync, push or checkout move.
Expose UP_TO_ACCEPTS_HEAD for the sync runner's text capability negotiation.

Proof: real Git updater regressions fail on base with already-at-commit refusal;
updated --up-to and parked-branch suites pass. scripts/check --base origin/main
passes. Cover unchanged tip, tip advancing after planning, and side-parent HEAD
refusal. The fixture captures the completion request expected_sha at C.
---
 hermes_cli/update_up_to.py            | 12 +++++----
 tests/hermes_cli/test_update_up_to.py | 36 ++++++++++++++++++++++++---
 2 files changed, 40 insertions(+), 8 deletions(-)

diff --git a/hermes_cli/update_up_to.py b/hermes_cli/update_up_to.py
index f4c13c14af28fd4765a374ad35ee75e9638da75e..7ece3c15669914604a8c8b68d82b05160529fbed 100644
--- a/hermes_cli/update_up_to.py
+++ b/hermes_cli/update_up_to.py
@@ -20,6 +20,7 @@ from typing import Callable, NoReturn
 from hermes_cli.update_cmd_common import _record_stop
 
 FLAG = "--up-to"
+UP_TO_ACCEPTS_HEAD = True  # Text capability marker read by hermes-sync in the live core.
 
 #: (argparse dest, flag): flags that pick another target or do not apply an update.
 _INCOMPATIBLE = (
@@ -77,8 +78,8 @@ def select_target(git_cmd, root: Path, sha: str | None, current_branch: str, tar
     """The update target: *target_ref* unchanged without ``--up-to``; else *sha*, validated against
     the fetched ``origin/main`` and pinned as the run's ``expected_sha`` (receipt, completion).
 
-    Requires the checkout on branch main, *sha* a commit, HEAD a proper ancestor of it, and
-    *sha* on origin/main's first-parent line past HEAD. Exits 1 (after ``stop()``) otherwise.
+    Requires the checkout on branch main, *sha* a commit, HEAD an ancestor of it (or equal),
+    and *sha* on origin/main's first-parent line. Exits 1 (after ``stop()``) otherwise.
     """
     if sha is None:
         return target_ref
@@ -100,11 +101,12 @@ def select_target(git_cmd, root: Path, sha: str | None, current_branch: str, tar
     head = _out(git, ["rev-parse", "-q", "--verify", "HEAD^{commit}"])
     if not tip or not head:
         fail("origin/main or HEAD does not resolve")
-    if sha == head:
-        fail("the checkout is already at that commit")
     if git(["merge-base", "--is-ancestor", head, sha]).returncode != 0:
         fail(f"HEAD {head[:10]} is not an ancestor of it")
-    if sha not in _out(git, ["rev-list", "--first-parent", f"{head}..{tip}"]).split():
+    # An equal target still needs first-parent membership: being an ancestor via
+    # a merged side branch is not enough. Include HEAD only for the zero-move case.
+    line = tip if sha == head else f"{head}..{tip}"
+    if sha not in _out(git, ["rev-list", "--first-parent", line]).split():
         fail(f"not on origin/main's first-parent line after HEAD (origin/main is {tip[:10]})")
     count = _out(git, ["rev-list", "--count", f"{head}..{sha}"]) or "?"
     print(f"→ Updating up to {sha[:10]} (origin/main is {tip[:10]}; {count} commit(s))")
diff --git a/tests/hermes_cli/test_update_up_to.py b/tests/hermes_cli/test_update_up_to.py
index 6a6030ec5d619248980cdbdee6dee7fe57398af9..ca341b4324bb59abb9dc905a9c137cac96d418e3 100644
--- a/tests/hermes_cli/test_update_up_to.py
+++ b/tests/hermes_cli/test_update_up_to.py
@@ -116,6 +116,34 @@ def test_stops_at_the_first_parent_commit_on_main_without_upstream_sync_or_push(
     assert fork.seen.stops == []
 
 
+@pytest.mark.parametrize("advance", [False, True])
+def test_pin_at_head_finishes_without_moving_or_syncing(fork, advance, capsys):
+    git(fork.root, "reset", "-q", "--hard", fork.c)
+    origin = fork.root.parent / "origin"
+    git(origin, "reset", "-q", "--hard", fork.c)
+    git(fork.root, "fetch", "-q", "origin")
+    tip = _commit(origin, "later.txt", "later\n") if advance else fork.c
+
+    run(fork, "--up-to", fork.c)
+
+    assert head(fork) == (fork.c, "main")
+    assert git(fork.root, "rev-parse", "origin/main") == tip
+    assert fork.seen.upstream_prepared == [False]
+    assert fork.seen.upstream_synced == [] and fork.seen.pushed == []
+    assert fork.seen.armed == []
+    assert len(fork.completed) == 1
+    assert fork.completed[0]["expected_sha"] == fork.c
+    assert fork.completed[0]["completion_message"] == "✓ Already up to date!"
+    assert fork.seen.stops == []
+    assert "0 commit(s)" in capsys.readouterr().out
+
+
+def test_pin_at_head_off_first_parent_line_is_refused(fork, capsys):
+    git(fork.root, "reset", "-q", "--hard", fork.s)
+    out = _refused(fork, capsys, fork.s, head(fork))
+    assert "not on origin/main's first-parent line" in out
+
+
 def test_preflight_commit_point_and_marker_name_the_selected_commit_not_the_tip(fork, monkeypatch):
     pinned = []
     real_pull = update_cmd._pull_updates
@@ -157,11 +185,11 @@ def _refused(fork, capsys, sha, before):
 
 
 @pytest.mark.parametrize("case", [
-    "side-branch", "not-on-origin-main", "equals-head", "behind-head", "head-has-local-commit",
+    "side-branch", "not-on-origin-main", "behind-head", "head-has-local-commit",
     "unknown-commit",
 ])
 def test_refuses_a_commit_off_the_first_parent_line_or_not_past_head(fork, capsys, case):
-    sha = {"side-branch": fork.s, "equals-head": fork.a, "behind-head": fork.a,
+    sha = {"side-branch": fork.s, "behind-head": fork.a,
            "head-has-local-commit": fork.c, "unknown-commit": "0" * 40}.get(case)
     if case == "behind-head":
         git(fork.root, "reset", "-q", "--hard", fork.b)
@@ -174,7 +202,7 @@ def test_refuses_a_commit_off_the_first_parent_line_or_not_past_head(fork, capsy
     out = _refused(fork, capsys, sha, head(fork))
     expected = {"side-branch": "not on origin/main's first-parent line",
                 "not-on-origin-main": "not on origin/main's first-parent line",
-                "equals-head": "already at that commit", "behind-head": "is not an ancestor of it",
+                "behind-head": "is not an ancestor of it",
                 "head-has-local-commit": "is not an ancestor of it", "unknown-commit": "not a commit"}[case]
     assert expected in out
 
@@ -260,6 +288,8 @@ def test_capability_marker_names_the_flag():
 
     from hermes_cli.subcommands import update as parser_module
     assert '"--up-to"' in Path(parser_module.__file__).read_text(encoding="utf-8")
+    # This text marker likewise advertises the equal-HEAD extension to old sync runners.
+    assert "UP_TO_ACCEPTS_HEAD = True" in Path(update_up_to.__file__).read_text(encoding="utf-8")
 
 
 def test_a_failed_fast_forward_never_resets_or_detaches(fork, monkeypatch):
