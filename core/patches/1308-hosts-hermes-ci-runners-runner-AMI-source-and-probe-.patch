new file mode 100755
index 0000000000..29a276dc43
--- /dev/null
+++ b/hosts/hermes-ci-runners/bootstrap/serve-manifest.py
@@ -0,0 +1,32 @@
+#!/usr/bin/env python3
+"""Local helper for the GitHub App manifest flow (David's click).
+GET /          -> auto-submitting form that POSTs github-app-manifest.json to github.com/settings/apps/new
+GET /callback  -> runs store-github-app.sh <code> (credentials go straight to SSM), then redirects to the install page.
+Nothing secret is printed or written to disk."""
+import html, http.server, json, pathlib, secrets, subprocess, sys, urllib.parse
+HERE = pathlib.Path(__file__).resolve().parent
+MANIFEST = (HERE / 'github-app-manifest.json').read_text()
+STATE = secrets.token_urlsafe(16)
+class H(http.server.BaseHTTPRequestHandler):
+    def do_GET(self):
+        u = urllib.parse.urlparse(self.path); q = urllib.parse.parse_qs(u.query)
+        if u.path == '/':
+            body = f'''<form id=f method=post action="https://github.com/settings/apps/new?state={STATE}">
+<input type=hidden name=manifest value="{html.escape(MANIFEST)}"><button>Continue to GitHub</button></form>
+<script>document.getElementById('f').submit()</script>'''
+            return self.reply(200, body)
+        if u.path == '/callback':
+            if q.get('state', [''])[0] != STATE or 'code' not in q:
+                return self.reply(400, 'bad state or missing code')
+            r = subprocess.run([str(HERE / 'store-github-app.sh'), q['code'][0]], capture_output=True, text=True, check=False, timeout=120)
+            print(r.stdout.strip(), r.stderr.strip()[-300:], 'rc', r.returncode, flush=True)
+            if r.returncode != 0:
+                return self.reply(500, 'storing the app failed; see the session log')
+            slug = r.stdout.strip().rsplit('(', 1)[-1].rstrip(')')
+            self.send_response(302); self.send_header('Location', f'https://github.com/apps/{slug}/installations/new'); self.end_headers()
+            print('DONE', flush=True); return
+        self.reply(404, 'not found')
+    def reply(self, code, body):
+        self.send_response(code); self.send_header('Content-Type', 'text/html'); self.end_headers(); self.wfile.write(body.encode())
+    def log_message(self, *a): pass
+http.server.HTTPServer(('127.0.0.1', 8765), H).serve_forever()
diff --git a/hosts/hermes-ci-runners/bootstrap/store-github-app.sh b/hosts/hermes-ci-runners/bootstrap/store-github-app.sh
new file mode 100755
index 0000000000..88c04ebb41
--- /dev/null
+++ b/hosts/hermes-ci-runners/bootstrap/store-github-app.sh
@@ -0,0 +1,13 @@
+#!/usr/bin/env bash
+# Usage: store-github-app.sh <manifest-conversion-code>
+# Exchanges the one-time manifest code (from the redirect after David clicks "Create GitHub App")
+# for the App id / private key / webhook secret and stores them straight into SSM parameters.
+# Nothing is printed or written to disk.
+set -euo pipefail
+CODE=$1
+RESP=$(curl -fsS -X POST -H 'Accept: application/vnd.github+json' "https://api.github.com/app-manifests/$CODE/conversions")
+put() { aws ssm put-parameter --region us-west-2 --overwrite --type "$3" --name "$1" --value "$2" >/dev/null; }
+put /hermes-ci/github-app/id "$(jq -r .id <<<"$RESP")" String
+put /hermes-ci/github-app/key-base64 "$(jq -r .pem <<<"$RESP" | base64 | tr -d "\n")" SecureString
+put /hermes-ci/github-app/webhook-secret "$(jq -r .webhook_secret <<<"$RESP")" SecureString
+echo "stored app id $(jq -r .id <<<"$RESP") ($(jq -r .slug <<<"$RESP"))"
diff --git a/hosts/hermes-ci-runners/packer/files/ghr-imds-hook b/hosts/hermes-ci-runners/packer/files/ghr-imds-hook
new file mode 100755
index 0000000000..d493b8c588
--- /dev/null
+++ b/hosts/hermes-ci-runners/packer/files/ghr-imds-hook
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+# Fail-closed IMDS hook. Runs as root, once, BEFORE the runner agent starts.
+#   1. read identity + tags + JIT config over IMDS (still enabled)
+#   2. delete the one-shot SSM JIT parameter
+#   3. disable IMDS for this instance (ec2:ModifyInstanceMetadataOptions)
+#   4. read the option back with DescribeInstances AND probe 169.254.169.254
+#   5. write the JIT config to a root-only file for the launcher
+# Any failure exits non-zero; ghr-start then powers the instance off without ever
+# starting the runner. Credentials live only in shell variables of this process
+# (never exported, so never in /proc/*/environ) and die with it.
+set -euo pipefail
+OUT=${GHR_JIT_OUT:-/run/ghr/jitconfig}
+IMDS=${GHR_IMDS_URL:-http://169.254.169.254}
+umask 077
+mkdir -p "$(dirname "$OUT")"
+
+imds() { curl -fsS -m 5 -H "X-aws-ec2-metadata-token: $TOKEN" "$IMDS/latest/$1"; }
+awsc() { AWS_ACCESS_KEY_ID=$AK AWS_SECRET_ACCESS_KEY=$SK AWS_SESSION_TOKEN=$ST AWS_DEFAULT_REGION=$REGION aws "$@"; }
+
+TOKEN=$(curl -fsS -m 5 -X PUT "$IMDS/latest/api/token" -H 'X-aws-ec2-metadata-token-ttl-seconds: 120')
+IID=$(imds meta-data/instance-id)
+REGION=$(imds meta-data/placement/region)
+ROLE=$(imds meta-data/iam/security-credentials/)
+CREDS=$(imds "meta-data/iam/security-credentials/$ROLE")
+AK=$(jq -er .AccessKeyId <<<"$CREDS"); SK=$(jq -er .SecretAccessKey <<<"$CREDS"); ST=$(jq -er .Token <<<"$CREDS")
+CFG_PATH=$(imds meta-data/tags/instance/ghr:ssm_config_path)
+
+PARAMS=$(awsc ssm get-parameters-by-path --path "$CFG_PATH" --query 'Parameters[*].{Name:Name,Value:Value}' --output json)
+TOKEN_PATH=$(jq -er --arg p "$CFG_PATH/token_path" '.[]|select(.Name==$p)|.Value' <<<"$PARAMS")
+
+CONFIG=""
+for _ in $(seq 1 120); do
+  CONFIG=$(awsc ssm get-parameter --name "$TOKEN_PATH/$IID" --with-decryption --query Parameter.Value --output text 2>/dev/null || true)
+  if [ -n "$CONFIG" ] && [ "$CONFIG" != None ]; then break; fi
+  CONFIG=""; sleep 1
+done
+[ -n "$CONFIG" ] || { echo "ghr-imds-hook: no JIT config" >&2; exit 10; }
+awsc ssm delete-parameter --name "$TOKEN_PATH/$IID" >/dev/null
+
+awsc ec2 modify-instance-metadata-options --instance-id "$IID" --http-endpoint disabled >/dev/null
+
+# Readback 1: the control plane says disabled.
+STATE=$(awsc ec2 describe-instances --instance-ids "$IID" --query 'Reservations[0].Instances[0].MetadataOptions.HttpEndpoint' --output text)
+[ "$STATE" = "disabled" ] || { echo "ghr-imds-hook: readback says '$STATE'" >&2; exit 11; }
+# Readback 2: the data plane really refuses (allow a few seconds to propagate).
+# A disabled endpoint answers 403 rather than refusing the connection, so only a successful (-f, 2xx)
+# token PUT counts as "still reachable". A tokenless GET would be 401 under tokens-required and look gone.
+GONE=0
+for _ in $(seq 1 15); do
+  if ! curl -fsS -m 2 -o /dev/null -X PUT "$IMDS/latest/api/token" -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' 2>/dev/null; then GONE=1; break; fi
+  sleep 1
+done
+[ "$GONE" = 1 ] || { echo "ghr-imds-hook: IMDS still reachable" >&2; exit 12; }
+
+printf '%s' "$CONFIG" > "$OUT"
+echo "ghr-imds-hook: IMDS disabled and verified for $IID"
