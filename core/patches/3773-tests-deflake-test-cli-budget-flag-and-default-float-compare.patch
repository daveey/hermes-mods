From 0520bd0e244148479718b585457d77d6c41df3cd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 18:40:22 +0000
Subject: [PATCH] tests: deflake test_cli_budget_flag_and_default float compare

(s + n) - s is not exactly n for every float s: CI drew monotonic()=486.992705996
and got 516.992705996 - 486.992705996 != 30. Compare deadline against
started + n, the same sum Budget computes, so the assert is exact for any clock.
---
 tests/hermes_cli/test_kanban_scratch_gc_backoff.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_scratch_gc_backoff.py b/tests/hermes_cli/test_kanban_scratch_gc_backoff.py
index 3d0d4d6ccf..ce4a718a5d 100644
--- a/tests/hermes_cli/test_kanban_scratch_gc_backoff.py
+++ b/tests/hermes_cli/test_kanban_scratch_gc_backoff.py
@@ -228,9 +228,11 @@ def test_cli_budget_flag_and_default(monkeypatch):
         kanban_ops._cmd_gc(argparse.Namespace(event_retention_days=0, log_retention_days=0,
                                               worktree_retention_days=7, scratch_budget_seconds=value))
     default, unlimited, short = seen
-    assert default.deadline - default.started == bo.DEFAULT_BUDGET_S
+    # Compare against the sum the Budget computes: (s + n) - s is not exactly n for
+    # every monotonic() float s (e.g. s=486.992705996, n=30).
+    assert default.deadline == default.started + bo.DEFAULT_BUDGET_S
     assert unlimited.deadline is None and not unlimited.exhausted()
-    assert short.deadline - short.started == 30
+    assert short.deadline == short.started + 30
 
 
 def test_default_budget_leaves_headroom_below_the_wrapper_kill():
-- 
2.43.0

