From 1ed8b097d2d9c54103e4ee5da30ac582b5f5a746 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 20:14:48 +0000
Subject: [PATCH] fix(kanban): scope shared outage owners to originating host
 [daveey]

Replicated default-board incident rows made a fleet-wide idempotency suffix adopt another host outage. Include the captured hostname in the key; same-host late joiners still coalesce. Regression exercises real report/create/comment against a shared board view and fails before the fix.
---
 hermes_cli/kanban_sync_host_outage.py            |  3 ++-
 tests/hermes_cli/test_kanban_sync_host_outage.py | 15 +++++++++++++++
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_sync_host_outage.py b/hermes_cli/kanban_sync_host_outage.py
index 79a075c7d2ae2725965cd7e1af676f14d4f72f98..9bb9786479b800070279e79870322ae2369cc4ac 100644
--- a/hermes_cli/kanban_sync_host_outage.py
+++ b/hermes_cli/kanban_sync_host_outage.py
@@ -72,7 +72,8 @@ def report(entries: list[tuple[str, str, str]], *, fresh: bool, cause: str) -> O
         "is understood (precedent: t_d3f56f1f216a033d)."
     )
     comment = (("New incident: " if fresh else "Also affected: ") + detail + "\n\n" + sections)
-    return outbox_age.report(SLUG, detail, key=replica_age.KEY, author=replica_age.AUTHOR, body=body,
+    # Owner rows replicate across hosts: a fleet-wide key would adopt another host's incident.
+    return outbox_age.report(f"{SLUG}:{host}", detail, key=replica_age.KEY, author=replica_age.AUTHOR, body=body,
                              what="Board unreachable", comment=comment,
                              title=f"Kanban sync: {host} cannot reach the Board ({cause}); "
                                    f"{len(entries)} board replica(s) stale 20+ awake min")
diff --git a/tests/hermes_cli/test_kanban_sync_host_outage.py b/tests/hermes_cli/test_kanban_sync_host_outage.py
index 1e76a00e5f6dd61a0eeefef095cc502402886208..e7e883f148547b01414f1ef0e9915adfbd5a1538 100644
--- a/tests/hermes_cli/test_kanban_sync_host_outage.py
+++ b/tests/hermes_cli/test_kanban_sync_host_outage.py
@@ -182,6 +182,21 @@ def test_ten_boards_failing_on_one_dns_cause_file_one_card_naming_every_board_an
     assert len(_cards(home)) == 1 and _comments(home, card["id"]) == []  # the same incident files once
 
 
+def test_replicated_foreign_host_incident_is_not_adopted(home, monkeypatch):
+    """Both hosts see the same replicated owner rows; only same-host reports may coalesce."""
+    monkeypatch.setattr(host_outage.socket, "gethostname", lambda: "host-a")
+    first = host_outage.report([("bb", "DNS failed", "t_frozen_a")], fresh=True, cause="dns")
+    monkeypatch.setattr(host_outage.socket, "gethostname", lambda: "host-b")
+    second = host_outage.report([("runners", "DNS failed", "t_frozen_b")], fresh=True, cause="dns")
+    assert first and second and first != second
+    assert len(_cards(home)) == 2
+    assert _comments(home, first) == []
+    again = host_outage.report([("research", "DNS failed", "t_frozen_late")], fresh=False, cause="dns")
+    assert again == second
+    assert "t_frozen_late" in _comments(home, second)[0]
+    assert _comments(home, first) == []
+
+
 def test_an_unrelated_board_failure_keeps_its_own_card(home):
     host = Host(home, TEN + ["ledger"])
     host.run(1)
