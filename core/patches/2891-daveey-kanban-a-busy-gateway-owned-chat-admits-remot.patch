+def _busy(db, fifo):
+    """A gateway turn runs in the chat: its admission is started and it holds the turn lease."""
+    assert db.try_acquire_session_turn_lease(CHAT, GW_HOLDER)
+    fifo.admit("human prompt", {}, status="started")
