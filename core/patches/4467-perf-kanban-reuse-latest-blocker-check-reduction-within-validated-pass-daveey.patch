From e5d8621dd7a2eee71f9b9a5de7c8e8c87bb9bc03 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 11:39:09 +0000
Subject: [PATCH] perf(kanban): reuse latest blocker check reduction within
 validated pass [daveey]

G2d t_ddd313d65e0f67f7: scoped check-payload reuse still reduced the
same rows five times per dirty reclaim tick. Retain the winning map
through the existing commit/config-validated input scope instead.
Preserve private copies, one pinned timestamp, transaction bypass,
peer/local mutation checks and exact tie ordering. Explicitly read the
reducer config once and do not cache its unavailable-config fallback.
No dispatch frequency, recovery deadline, quota or crash policy changes.

Why: aggregate reclaim increased from 263 to 411 calls per comparable
421s live window. Per-call costs mostly improved but repeated winner
reductions remained. Prior tests protected input reuse but not reduction
count. New RED failed with three reductions rather than one; GREEN
passes mutation, alias, lookback, rollback, race and failure controls.

Proof: 22 files/351 tests pass; scripts/check all20 passed before the
last test-only additions. Real-drain isolated copied-board replay under
cProfile,30 dirty ticks: shared blocker sweep21.995->19.700ms/tick.
This is NOT live <=0.4% acceptance; G2d retains >=360s loaded-SHA P1.
Independent design review: claude-opus-5-5/anthropic deleg_26557664,
approve-with-conditions incorporated. Exact-head code review pending.
---
 hermes_cli/kanban_shared_blocker_checks.py    |  19 +-
 .../test_kanban_latest_check_memo.py          | 167 ++++++++++++++++++
 2 files changed, 184 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_latest_check_memo.py

diff --git a/hermes_cli/kanban_shared_blocker_checks.py b/hermes_cli/kanban_shared_blocker_checks.py
index ecdb4bffee700e06327e60ddadb3a8ac1f8a2967..a071abbc90cd167d27e4ca66de64280fb41ec522 100644
--- a/hermes_cli/kanban_shared_blocker_checks.py
+++ b/hermes_cli/kanban_shared_blocker_checks.py
@@ -149,16 +149,31 @@ def _check_payloads(conn, now):
 
 
 def _latest_results(conn, now=None) -> dict[str, dict]:
+    # All lanes reduce the same inputs. Retain the reduction only within the
+    # existing commit/config-validated scope, with private copies for callers.
+    ts = int(time.time()) if now is None else int(now)
+    results, _trusted = read('latest_check_results', conn, ts,
+                             lambda: _reduce_latest_results(conn, ts), store_if=lambda value: value[1])
+    return results
+
+
+def _reduce_latest_results(conn, now):
     from hermes_cli.kanban_shared_blockers import normalize_blocker_id
+    from hermes_cli.kanban_blocker_inputs import config
+    from hermes_cli.config_backend import ConfigBackendUnavailable
 
+    try:
+        cfg, trusted = config(), True
+    except ConfigBackendUnavailable:
+        cfg, trusted = {}, False  # preserve slug fallback, but never publish it as an alias-aware result
     results = {}
     tokens = _assertion_tokens(conn, now)
     for payload in _check_payloads(conn, now):
-        bid = normalize_blocker_id(payload.get("blocker_id"))
+        bid = normalize_blocker_id(payload.get("blocker_id"), cfg=cfg)
         token = tokens.get(bid)
         if bid and (bid not in results or _result_key(payload, token) > _result_key(results[bid], token)):
             results[bid] = payload
-    return results
+    return results, trusted
 
 
 def apply_check_clears(conn, states, now=None) -> None:
diff --git a/tests/hermes_cli/test_kanban_latest_check_memo.py b/tests/hermes_cli/test_kanban_latest_check_memo.py
new file mode 100644
index 0000000000000000000000000000000000000000..3d18e758f3390058f29745d7cfc39e97c27584c2
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_latest_check_memo.py
@@ -0,0 +1,167 @@
+"""G2d: reuse the winning check reduction, not only its decoded input rows."""
+import pytest
+
+from hermes_cli import kanban_blocker_inputs as inputs
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_shared_blocker_checks as checks
+from tests.hermes_cli import test_kanban_shared_blockers as helpers
+
+kanban_home = helpers.kanban_home
+
+
+def _seed(conn, *, rc=1, at=100):
+    tid = kb.create_task(conn, title='check carrier', assignee='nobody')
+    with kb.write_txn(conn):
+        kb._append_event(conn, tid, checks.CHECK_EVENT,
+                         {'blocker_id': 'test-wall', 'checked_at': at, 'rc': rc})
+    return tid
+
+
+def test_repeated_consumers_reduce_once_and_receive_private_results(kanban_home, monkeypatch):
+    with kbc.connect_closing() as conn:
+        _seed(conn)
+        calls = []
+        real = checks._check_payloads
+
+        def payloads(*args):
+            calls.append(1)
+            return real(*args)
+        monkeypatch.setattr(checks, '_check_payloads', payloads)
+
+        @inputs.input_pass
+        def exercise():
+            first = checks._latest_results(conn, 100)
+            assert first['test-wall']['rc'] == 1
+            first['test-wall']['rc'] = 0
+            assert checks._latest_results(conn, 100)['test-wall']['rc'] == 1
+            assert checks._latest_results(conn, 100)['test-wall']['rc'] == 1
+            assert len(calls) == 1
+        exercise()
+        assert inputs._SCOPE.get() is None
+
+
+def test_local_peer_writes_and_rollback_invalidate(kanban_home):
+    with kbc.connect_closing() as conn, kbc.connect_closing() as peer:
+        tid = _seed(conn)
+
+        @inputs.input_pass
+        def exercise():
+            assert checks._latest_results(conn, 100)['test-wall']['rc'] == 1
+            with kb.write_txn(peer):
+                kb._append_event(peer, tid, checks.CHECK_EVENT,
+                                 {'blocker_id': 'test-wall', 'checked_at': 101, 'rc': 0})
+            assert checks._latest_results(conn, 100)['test-wall']['rc'] == 0
+            conn.execute('BEGIN')
+            kb._append_event(conn, tid, checks.CHECK_EVENT,
+                             {'blocker_id': 'test-wall', 'checked_at': 102, 'rc': 1})
+            assert checks._latest_results(conn, 100)['test-wall']['rc'] == 1
+            conn.rollback()
+            assert checks._latest_results(conn, 100)['test-wall']['rc'] == 0
+            with kb.write_txn(conn):
+                kb._append_event(conn, tid, checks.CHECK_EVENT,
+                                 {'blocker_id': 'test-wall', 'checked_at': 103, 'rc': 1})
+            assert checks._latest_results(conn, 100)['test-wall']['rc'] == 1
+        exercise()
+
+
+def test_aliases_and_lookback_are_live_inputs(kanban_home, monkeypatch):
+    from hermes_cli import config
+    from hermes_cli.kanban_shared_blockers import _LOOKBACK_SECONDS
+    cfg = {'kanban': {'shared_blocker_aliases': {}}}
+    monkeypatch.setattr(config, 'load_config_readonly', lambda: cfg)
+    with kbc.connect_closing() as conn:
+        tid = _seed(conn)
+        with kb.write_txn(conn):
+            conn.execute('UPDATE task_events SET created_at=100 WHERE task_id=?', (tid,))
+
+        @inputs.input_pass
+        def exercise():
+            assert set(checks._latest_results(conn, 100)) == {'test-wall'}
+            cfg['kanban']['shared_blocker_aliases']['test-wall'] = 'new-wall'
+            assert set(checks._latest_results(conn, 100)) == {'new-wall'}
+            assert checks._latest_results(conn, 101 + _LOOKBACK_SECONDS) == {}
+        exercise()
+
+
+def test_unavailable_reduction_config_is_not_published(kanban_home, monkeypatch):
+    from hermes_cli import config
+    from hermes_cli.config_backend import ConfigBackendUnavailable
+    cfg = {'kanban': {'shared_blocker_aliases': {'test-wall': 'new-wall'}}}
+    monkeypatch.setattr(config, 'load_config_readonly', lambda: cfg)
+    real, calls = inputs.config, []
+
+    def transient():
+        calls.append(1)
+        if len(calls) == 1:
+            raise ConfigBackendUnavailable('reducer only')
+        return real()
+    monkeypatch.setattr(inputs, 'config', transient)
+    with kbc.connect_closing() as conn:
+        _seed(conn)
+
+        @inputs.input_pass
+        def exercise():
+            assert set(checks._latest_results(conn, 100)) == {'test-wall'}
+            assert set(checks._latest_results(conn, 100)) == {'new-wall'}
+            assert len(calls) >= 2
+        exercise()
+
+
+def test_peer_write_during_reduction_refuses_publication(kanban_home, monkeypatch):
+    with kbc.connect_closing() as conn, kbc.connect_closing() as peer:
+        tid = _seed(conn)
+        real, calls = checks._check_payloads, []
+
+        def payloads(*args):
+            value = real(*args)
+            calls.append(1)
+            if len(calls) == 1:
+                with kb.write_txn(peer):
+                    kb._append_event(peer, tid, checks.CHECK_EVENT,
+                                     {'blocker_id': 'test-wall', 'checked_at': 101, 'rc': 0})
+            return value
+        monkeypatch.setattr(checks, '_check_payloads', payloads)
+
+        @inputs.input_pass
+        def exercise():
+            assert checks._latest_results(conn, 100)['test-wall']['rc'] == 1
+            assert checks._latest_results(conn, 100)['test-wall']['rc'] == 0
+            assert len(calls) == 2
+        exercise()
+
+
+@pytest.mark.parametrize('order', [(0, 1), (1, 0)])
+def test_same_second_failure_wins_on_cached_path(kanban_home, order):
+    with kbc.connect_closing() as conn:
+        for rc in order:
+            _seed(conn, rc=rc)
+
+        @inputs.input_pass
+        def exercise():
+            expected, trusted = checks._reduce_latest_results(conn, 100)
+            assert trusted and expected['test-wall']['rc'] == 1
+            assert checks._latest_results(conn, 100) == expected
+            assert checks._latest_results(conn, 100) == expected
+        exercise()
+
+
+def test_failed_reduction_is_retried(kanban_home, monkeypatch):
+    with kbc.connect_closing() as conn:
+        _seed(conn)
+        real, calls = checks._check_payloads, []
+
+        def payloads(*args):
+            calls.append(1)
+            if len(calls) == 1:
+                raise RuntimeError('read failed')
+            return real(*args)
+        monkeypatch.setattr(checks, '_check_payloads', payloads)
+
+        @inputs.input_pass
+        def exercise():
+            with pytest.raises(RuntimeError, match='read failed'):
+                checks._latest_results(conn, 100)
+            assert checks._latest_results(conn, 100)['test-wall']['rc'] == 1
+            assert len(calls) == 2
+        exercise()
