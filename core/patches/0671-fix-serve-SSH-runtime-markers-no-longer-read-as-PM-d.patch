diff --git a/hermes_cli/web_server.py b/hermes_cli/web_server.py
index 505c9cf583..62d81a7c37 100644
--- a/hermes_cli/web_server.py
+++ b/hermes_cli/web_server.py
@@ -409,6 +409,7 @@ _SESSION_HEADER_NAME = "X-Hermes-Session-Token"
 _SSH_OWNER_NONCE: Optional[str] = None
 _SSH_RUNTIME_PURELIB: Optional[tuple[str, int, int]] = None
 _SSH_RUNTIME_MARKER: Optional[str] = None
+_SSH_RUNTIME_FINGERPRINT: Optional[str] = None
 
 
 def _apply_ssh_session_token(token: str) -> None:
@@ -447,11 +448,55 @@ def _ssh_bootstrap_session():
                    access_token="", refresh_token="")
 
 
+def _ssh_runtime_fingerprint(purelib: str) -> Optional[str]:
+    """[daveey] Content identity of the runtime a backend booted on: interpreter version and path,
+    the site-packages listing (markers and caches excluded), each ``*.dist-info/RECORD`` (per-file
+    sha256 of every installed package) and each small top-level file (``.pth``). Equal values mean
+    a swap re-realized the same bytes (PM repairing a tree), not a new runtime. None when unreadable."""
+    import hashlib
+
+    try:
+        names = sorted(n for n in os.listdir(purelib)
+                       if n != "__pycache__" and not n.startswith(".hermes-ssh-runtime-"))
+    except OSError:
+        return None
+    digest = hashlib.sha256()
+    digest.update(f"{sys.version}\0{os.path.realpath(sys.executable)}\0".encode("utf-8", "replace"))
+    try:  # a venv rebuilt on another interpreter keeps its purelib path but rewrites pyvenv.cfg
+        with open(os.path.join(sys.prefix, "pyvenv.cfg"), "rb") as fh:
+            digest.update(fh.read())
+    except OSError:
+        pass
+    digest.update(b"\0")
+    for name in names:
+        digest.update(name.encode("utf-8", "replace") + b"\0")
+        path = os.path.join(purelib, name)
+        target = os.path.join(path, "RECORD") if name.endswith(".dist-info") else path
+        try:
+            if os.path.isfile(target) and os.path.getsize(target) <= 4 * 1024 * 1024:
+                with open(target, "rb") as fh:
+                    digest.update(fh.read())
+        except OSError:
+            return None
+        digest.update(b"\0")
+    return digest.hexdigest()
+
+
+def _write_ssh_runtime_marker(marker: str) -> bool:
+    try:
+        with open(marker, "w", encoding="utf-8") as fh:
+            fh.write(f"pid={os.getpid()}\n")
+        return True
+    except OSError:
+        return False
+
+
 def _apply_ssh_owner_nonce(nonce: Optional[str]) -> None:
-    global _SSH_OWNER_NONCE, _SSH_RUNTIME_PURELIB, _SSH_RUNTIME_MARKER
+    global _SSH_OWNER_NONCE, _SSH_RUNTIME_PURELIB, _SSH_RUNTIME_MARKER, _SSH_RUNTIME_FINGERPRINT
     _SSH_OWNER_NONCE = nonce
     _SSH_RUNTIME_PURELIB = None
     _SSH_RUNTIME_MARKER = None
+    _SSH_RUNTIME_FINGERPRINT = None
     if nonce:
         try:
             purelib = sysconfig.get_paths()["purelib"]
@@ -461,13 +506,13 @@ def _apply_ssh_owner_nonce(nonce: Optional[str]) -> None:
         # loses it deterministically; pip installs leave it. A bare (dev, ino)
         # snapshot alone is NOT enough: ext4 reuses directory inodes at once,
         # so `rm -rf venv && uv venv` can land on the same inode undetected.
-        try:
-            marker = os.path.join(purelib, f".hermes-ssh-runtime-{nonce}")
-            with open(marker, "w", encoding="utf-8") as fh:
-                fh.write(f"pid={os.getpid()}\n")
+        # The marker name must stay in step with pm.store.RUNTIME_STATE_FILE_RE: PM digests skip
+        # exactly that shape, so an intact runtime holding markers is never "repaired" away.
+        marker = os.path.join(purelib, f".hermes-ssh-runtime-{nonce}")
+        if _write_ssh_runtime_marker(marker):
             _SSH_RUNTIME_MARKER = marker
-        except OSError:
-            pass  # read-only site-packages — fall back to the stat snapshot
+            _SSH_RUNTIME_FINGERPRINT = _ssh_runtime_fingerprint(purelib)
+        # else: read-only site-packages — fall back to the stat snapshot
         try:
             st = os.stat(purelib)
             _SSH_RUNTIME_PURELIB = (purelib, st.st_dev, st.st_ino)
@@ -475,6 +520,25 @@ def _apply_ssh_owner_nonce(nonce: Optional[str]) -> None:
             pass
 
 
+def _ssh_runtime_reattach() -> bool:
+    """[daveey] The marker is gone but the runtime under it holds the bytes this backend booted on
+    (a PM repair re-realized an identical tree): write the marker back and report True, so the
+    backend stays reusable instead of retiring. False (retire as before) for any real change."""
+    global _SSH_RUNTIME_PURELIB
+    marker, fingerprint = _SSH_RUNTIME_MARKER, _SSH_RUNTIME_FINGERPRINT
+    if marker is None or fingerprint is None or os.path.isfile(marker):
+        return False
+    purelib = os.path.dirname(marker)
+    if _ssh_runtime_fingerprint(purelib) != fingerprint or not _write_ssh_runtime_marker(marker):
+        return False
+    try:
+        st = os.stat(purelib)
+        _SSH_RUNTIME_PURELIB = (purelib, st.st_dev, st.st_ino)
+    except OSError:
+        pass
+    return True
+
+
 def _ssh_runtime_intact() -> bool:
     if _SSH_RUNTIME_MARKER is not None:
         return os.path.isfile(_SSH_RUNTIME_MARKER)
diff --git a/hermes_cli/web_server_skew_exit.py b/hermes_cli/web_server_skew_exit.py
index 8a0cc8f6f3..d517bd756b 100644
--- a/hermes_cli/web_server_skew_exit.py
+++ b/hermes_cli/web_server_skew_exit.py
@@ -60,8 +60,73 @@ def _runtime_intact() -> bool:
         return True  # cannot prove the runtime moved: stay up
 
 
+def _runtime_reattach() -> bool:
+    try:
+        from hermes_cli.web_server import _ssh_runtime_reattach
+
+        return _ssh_runtime_reattach()
+    except Exception:
+        return False  # cannot prove the bytes are unchanged: treat the loss as a real swap
+
+
+# [daveey] A runtime retirement respawns the backend on the same nonce (the always-on dashboard
+# keeps it fixed), so a cause that keeps deleting the marker turns retirement into a restart loop
+# that no in-process state can see. The last runtime retirement per nonce is persisted, and a second
+# one inside this window is held: the backend keeps serving (Desktop already refuses to reuse it on
+# ``runtimeIntact: false``) instead of exiting every minute. Code-revision retirement is not held.
+RUNTIME_RETIRE_BACKOFF_S = 900.0
+
+
+class RuntimeRetireLedger:
+    """Wall-clock time of the last runtime retirement per owner nonce, shared across restarts."""
+
+    def __init__(self, path=None):
+        if path is None:
+            from hermes_constants import get_hermes_home
+
+            path = get_hermes_home() / "cache" / "ssh-runtime-retirements.json"
+        self.path = path
+
+    def _read(self) -> dict:
+        import json
+
+        try:
+            data = json.loads(self.path.read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            return {}
+        return data if isinstance(data, dict) else {}
+
+    def last(self, key: str) -> Optional[float]:
+        value = self._read().get(key)
+        return float(value) if isinstance(value, (int, float)) else None
+
+    def record(self, key: str, when: float) -> None:
+        import json
+        import os
+
+        data = {k: v for k, v in self._read().items() if isinstance(v, (int, float)) and when - v < 7 * 86400}
+        data[key] = when
+        try:
+            self.path.parent.mkdir(parents=True, exist_ok=True)
+            tmp = self.path.with_name(f".{self.path.name}.{os.getpid()}.tmp")
+            tmp.write_text(json.dumps(data), encoding="utf-8")
+            os.replace(tmp, self.path)
+        except OSError as exc:
+            _log.warning("could not record the runtime retirement in %s: %s", self.path, exc)
+
+
+def _runtime_key() -> str:
+    try:
+        from hermes_cli import web_server
+
+        return web_server._SSH_OWNER_NONCE or web_server._SSH_RUNTIME_MARKER or "default"
+    except Exception:
+        return "default"
+
+
 def _run_retirement_watchdog(server, *, observe: Callable[[], Optional[str]], fence, poll_s: float,
-                             max_polls: Optional[int], thread_name: str) -> threading.Thread:
+                             max_polls: Optional[int], thread_name: str,
+                             on_retire: Optional[Callable[[str], None]] = None) -> threading.Thread:
     """Daemon thread shared by the SSH-isolated retirement watchdogs: ``observe`` returns the log
     reason while retirement is warranted (else None); after ``_CONFIRMATIONS`` consecutive reasons
     the backend exits only through the retirement fence (proven idle, admission closed first)."""
@@ -76,10 +141,12 @@ def _run_retirement_watchdog(server, *, observe: Callable[[], Optional[str]], fe
             polls += 1
             reason = observe()
             seen = seen + 1 if reason else 0
-            if seen >= _CONFIRMATIONS:
+            if reason and seen >= _CONFIRMATIONS:
                 permit = fence.prepare()
                 if permit.get("ok") and fence.commit(permit.get("token")).get("ok"):
                     _log.warning("%s", reason)
+                    if on_retire is not None:
+                        on_retire(reason)
                     server.should_exit = True
                     return
             time.sleep(poll_s)
@@ -89,9 +156,18 @@ def _run_retirement_watchdog(server, *, observe: Callable[[], Optional[str]], fe
     return thread
 
 
+_RUNTIME_REASON = ("SSH-isolated backend's runtime was replaced under it (runtimeIntact false); "
+                   "retiring so its client respawns it on the new runtime.")
+
+
 def start_code_skew_watchdog(server, *, skew_fn: Optional[Callable[[], Skew]] = None,
                              update_probe: Callable[[], bool] = _update_in_progress,
                              runtime_probe: Callable[[], bool] = _runtime_intact,
+                             runtime_reattach: Callable[[], bool] = _runtime_reattach,
+                             ledger: Optional[RuntimeRetireLedger] = None,
+                             runtime_key: Callable[[], str] = _runtime_key,
+                             backoff_s: float = RUNTIME_RETIRE_BACKOFF_S,
+                             clock: Callable[[], float] = time.time,
                              fence=None, poll_s: float = DEFAULT_SKEW_POLL_S,
                              max_polls: Optional[int] = None) -> threading.Thread:
     """Daemon thread that sets ``server.should_exit`` once the loaded code is provably stale and
@@ -101,16 +177,47 @@ def start_code_skew_watchdog(server, *, skew_fn: Optional[Callable[[], Skew]] =
 
         skew_fn = detect_code_skew
     read_skew: Callable[[], Skew] = skew_fn
+    held_until: list[float] = [0.0]
+
+    def _ledger() -> Optional[RuntimeRetireLedger]:
+        nonlocal ledger
+        if ledger is None:
+            try:
+                ledger = RuntimeRetireLedger()
+            except Exception:
+                return None
+        return ledger
 
     def _observe() -> Optional[str]:
         skew = read_skew()
         if skew and should_retire_for_skew(skew=skew, update_in_progress=update_probe()):
             return ("SSH-isolated backend loaded {} but the install is now at {}; "
                     "retiring so its client respawns it on the new code.".format(*skew))
-        if not runtime_probe() and not update_probe():
-            return ("SSH-isolated backend's runtime was replaced under it (runtimeIntact false); "
-                    "retiring so its client respawns it on the new runtime.")
-        return None
+        if runtime_probe() or update_probe():
+            return None
+        if runtime_reattach():
+            # Same bytes re-realized (a PM repair): the marker is back and the backend is reusable.
+            _log.info("SSH-isolated backend's runtime was re-realized with identical content; "
+                      "runtime marker restored, not retiring.")
+            return None
+        book = _ledger()
+        last = book.last(runtime_key()) if book is not None else None
+        now = clock()
+        if last is not None and 0 <= now - last < backoff_s:
+            if held_until[0] != last + backoff_s:
+                held_until[0] = last + backoff_s
+                _log.warning("SSH-isolated backend's runtime marker is gone again %.0fs after the last "
+                             "runtime retirement; holding retirement for %.0fs so one bad signal "
+                             "cannot restart it every minute.", now - last, backoff_s - (now - last))
+            return None
+        return _RUNTIME_REASON
+
+    def _on_retire(reason: str) -> None:
+        if reason is _RUNTIME_REASON:
+            book = _ledger()
+            if book is not None:
+                book.record(runtime_key(), clock())
 
     return _run_retirement_watchdog(server, observe=_observe, fence=fence, poll_s=poll_s,
-                                    max_polls=max_polls, thread_name="ssh-isolated-skew-watchdog")
+                                    max_polls=max_polls, thread_name="ssh-isolated-skew-watchdog",
+                                    on_retire=_on_retire)
diff --git a/pm/store.py b/pm/store.py
index ac0d63ce52..d7aff0424a 100644
--- a/pm/store.py
+++ b/pm/store.py
@@ -4,6 +4,7 @@ from __future__ import annotations
 
 import os
 import platform
+import re
 import shutil
 import stat
 import sys
@@ -302,6 +303,19 @@ def merge_tree(src: Path, dst: Path) -> None:
         retry_held(lambda: item.replace(target))
 
 
+# [daveey] Liveness markers an SSH-isolated ``hermes serve`` writes into its interpreter's
+# site-packages (``hermes_cli.web_server._apply_ssh_owner_nonce``): ``.hermes-ssh-runtime-<16 hex>``.
+# They are process state, never package bytes. Hashing them made every deliberate install see the
+# store Python as drifted and re-realize it, which deleted the markers and retired every such backend
+# (always-on dashboard restart loop, every ~70 s on a busy host).
+RUNTIME_STATE_FILE_RE = re.compile(r"\.hermes-ssh-runtime-[0-9a-f]{16}")
+
+
+def is_runtime_state_file(name: str) -> bool:
+    """True for a file name a running Hermes writes into a published tree as process state."""
+    return RUNTIME_STATE_FILE_RE.fullmatch(name) is not None
+
+
 def tree_digest(root: Path) -> str:
     """Deterministic sha256 over a directory tree: walk every file, sort
     by posix relpath, hash `relpath\\0<content>` per entry. No mtimes, no
@@ -312,7 +326,9 @@ def tree_digest(root: Path) -> str:
     ``__pycache__`` directories are skipped: CPython writes .pyc caches
     into them the first time the staged interpreter runs (uv venv/uv sync
     in a bundle build; first boot of a shipped app), so they are runtime
-    state, not package bytes — the digest is over what pm published."""
+    state, not package bytes — the digest is over what pm published.
+    SSH-backend runtime markers (``is_runtime_state_file``) are skipped for
+    the same reason."""
     import hashlib
 
     files: list[tuple[str, Path]] = []
@@ -326,6 +342,8 @@ def tree_digest(root: Path) -> str:
                 descend.append(name)
         dirnames[:] = descend
         for fname in filenames:
+            if is_runtime_state_file(fname):
+                continue
             path = Path(dirpath) / fname
             files.append((path.relative_to(root).as_posix(), path))
     files.sort(key=lambda item: item[0])
diff --git a/tests/hermes_cli/test_ssh_ownership_endpoint.py b/tests/hermes_cli/test_ssh_ownership_endpoint.py
index a56d7f1937..9adc871c40 100644
--- a/tests/hermes_cli/test_ssh_ownership_endpoint.py
+++ b/tests/hermes_cli/test_ssh_ownership_endpoint.py
@@ -90,6 +90,57 @@ def test_ssh_runtime_marker_detects_recreated_venv_even_with_reused_inode(
         web_server._apply_ssh_owner_nonce(None)
 
 
+def _pkg(purelib, name, record):
+    info = purelib / f"{name}.dist-info"
+    info.mkdir()
+    (info / "RECORD").write_text(record, encoding="utf-8")
+
+
+def test_ssh_runtime_reattaches_only_when_the_rerealized_tree_holds_the_same_bytes(tmp_path, monkeypatch):
+    """[daveey] A PM repair re-realizes an identical tree: the marker dies with the old tree, but the
+    backend's runtime did not change, so it writes the marker back and stays reusable instead of
+    retiring. A tree whose packages changed is a real swap: no reattach, the watchdog retires."""
+    import shutil
+
+    purelib = tmp_path / "py" / "lib" / "site-packages"
+    purelib.mkdir(parents=True)
+    _pkg(purelib, "pip-26.2.1", "pip/__init__.py,sha256=aaa,10\n")
+    monkeypatch.setattr(
+        web_server,
+        "sysconfig",
+        types.SimpleNamespace(get_paths=lambda *a, **k: {"purelib": str(purelib)}),
+    )
+    web_server._apply_ssh_owner_nonce("0123456789abcdef")
+    marker = purelib / ".hermes-ssh-runtime-0123456789abcdef"
+    try:
+        assert web_server._ssh_runtime_reattach() is False  # nothing lost: nothing to do
+
+        shutil.rmtree(tmp_path / "py")
+        purelib.mkdir(parents=True)
+        _pkg(purelib, "pip-26.2.1", "pip/__init__.py,sha256=aaa,10\n")
+        assert web_server._ssh_runtime_intact() is False
+        assert web_server._ssh_runtime_reattach() is True
+        assert marker.is_file()
+        assert web_server._ssh_runtime_intact() is True
+
+        shutil.rmtree(tmp_path / "py")
+        purelib.mkdir(parents=True)
+        _pkg(purelib, "pip-26.3.0", "pip/__init__.py,sha256=bbb,10\n")
+        assert web_server._ssh_runtime_reattach() is False
+        assert not marker.exists()
+        assert web_server._ssh_runtime_intact() is False
+    finally:
+        web_server._apply_ssh_owner_nonce(None)
+
+
+def test_ssh_runtime_marker_name_is_the_shape_pm_digests_skip():
+    """The marker lives in a PM-published tree; PM must treat exactly this name as process state."""
+    from pm.store import is_runtime_state_file
+
+    assert is_runtime_state_file(".hermes-ssh-runtime-0123456789abcdef")
+    assert not is_runtime_state_file(".hermes-ssh-runtime-0123456789abcdef.py")
+
+
 def test_ssh_runtime_marker_survives_in_place_installs(tmp_path, monkeypatch):
     """pip/uv installs INTO the live venv must not read as a replacement."""
     purelib = tmp_path / "venv" / "lib" / "site-packages"
