diff --git a/hermes_cli/chat_visibility.py b/hermes_cli/chat_visibility.py
index 6b0e85f8c6..31298805ca 100644
--- a/hermes_cli/chat_visibility.py
+++ b/hermes_cli/chat_visibility.py
@@ -20,7 +20,7 @@ def hide_classic_session(db, session_id):
         return  # gateway create already committed the visibility with its immutable receipt
     flags = creation_visibility()
     if flags['agent_cli']:
-        db.patch_session_model_config(session_id, {'_agent_cli': True})
+        db.seed_session_model_config(session_id, {'_agent_cli': True})
     if flags['hidden']:
         db.set_session_hidden(session_id, True)
 
diff --git a/tests/hermes_cli/test_empty_toolset_launches.py b/tests/hermes_cli/test_empty_toolset_launches.py
