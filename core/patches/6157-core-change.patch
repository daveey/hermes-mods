+"""Own-hold decision and provider upkeep before dispatcher capacity admission. [daveey]"""
+from hermes_cli import kanban_db as kb
+from hermes_cli import loop_accounting as la
+
+
+def run(conn, result, *, board, dry_run):
+    from hermes_cli.kanban_idle_candidates import sweep_shared_blockers
+    la.timed('dispatch.sweep_shared_blockers', sweep_shared_blockers, conn, result)
+    if not dry_run:
+        from hermes_cli.kanban_hold_notices import sweep as holds
+        la.timed('dispatch.hold_notices', holds, conn)
+    from hermes_cli.kanban_provider_walls import tick_upkeep
+    la.timed('dispatch.tick_upkeep', tick_upkeep, conn, board=board, dry_run=dry_run)
+    from hermes_cli import kanban_db_dispatch_quota as quota
+    try:
+        result.quota_block_released = la.timed('dispatch.release_recovered_quota_blocks', quota.release_recovered_quota_blocks, conn)
+    except Exception:  # health: allow BLE001 -- retain existing best-effort provider maintenance
+        kb._log.warning('kanban: releasing recovered quota-wall blocks failed', exc_info=True)
diff --git a/hermes_cli/kanban_hold_audience.py b/hermes_cli/kanban_hold_audience.py
new file mode 100644
index 00000000000..8baf11449dc
--- /dev/null
+++ b/hermes_cli/kanban_hold_audience.py
@@ -0,0 +1,62 @@
+"""Read-only renewal authority for decision notices; subscriptions are not grants. [daveey]"""
+from __future__ import annotations
+
+
+def describe(conn, task_id: str) -> dict:
+    """Describe only stored candidates accepted by the real renewal actor reader.
+
+    This is routing evidence, not authentication or a release receipt. The eventual
+    caller must still prove its process ancestry and pass canonical revalidation.
+    Legacy observer-only cards remain owner-unavailable; never adopt them here.
+    """
+    from hermes_cli.kanban_archive_scope import _creator_task_id
+    from hermes_cli.kanban_create_authority import _accepts, _gateway
+    from hermes_cli.kanban_creator_chats import _chat_links
+    from hermes_cli.kanban_db_notify import is_machine_session
+    from hermes_cli.kanban_scope_renewal_cli import _sessions
+    from hermes_cli.profiles import get_active_profile_name
+    own, profile = _gateway(conn), get_active_profile_name()
+    candidates = []
+    if conn.execute("SELECT 1 FROM sqlite_master WHERE name='task_chat_links'").fetchone():
+        candidates = [(r['chat_gateway'], r.get('chat_profile') or 'default', r['chat_session'])
+                      for r in _chat_links(conn, task_id) if r.get('kind', 'created') == 'created']
+    else:
+        candidates = [(own, profile, r[0]) for r in conn.execute(
+            "SELECT chat_id FROM kanban_notify_subs WHERE task_id=? AND platform='tui'", (task_id,))]
+    from hermes_cli.kanban_session_provenance import proven_foreign_chats
+    chats, proven = [], None
+    for gateway, prof, session in dict.fromkeys(candidates):
+        if not session:
+            continue
+        if is_machine_session(gateway, session, local_gateway=own, profile=prof):
+            # A foreign Desktop's local-<hash> cannot be inspected in our state.db.
+            # Match creation's provenance exception, then still validate renewal.
+            proven = proven if proven is not None else proven_foreign_chats(conn, (task_id,), local_gateway=own)
+            if f'{gateway}/{prof}/{session}' not in proven:
+                continue
+        if _accepts(conn, task_id, session, gateway, prof):
+            chats.append({'gateway': gateway, 'profile': prof, 'session': session})
+    creator = _creator_task_id(conn, task_id)
+    active_creator = bool(creator and any(_accepts(conn, task_id, s, own, profile, creator)
+                                         for s in _sessions(conn, creator)))
+    return {'chats': chats, 'creator_task_id': creator, 'creator_active': active_creator}
+
+
+def chats(authority) -> list[dict]:
+    """Validate a replicated authority snapshot without accepting partial identities."""
+    values = authority.get('chats') if isinstance(authority, dict) else None
+    return [c for c in values if isinstance(c, dict)
+            and all(isinstance(c.get(k), str) and c[k].strip() for k in ('gateway', 'profile', 'session'))
+            ] if isinstance(values, list) else []
+
+
+def guidance(authority: dict) -> str:
+    """Never imply an observer can execute a renewal just because it got this notice."""
+    refs = [f"@session:{c['profile']}@{c['gateway']}/{c['session']}" for c in chats(authority)]
+    if isinstance(authority, dict) and authority.get('creator_active') is True and authority.get('creator_task_id'):
+        refs.append('running creator task ' + str(authority['creator_task_id']))
+    if refs:
+        return 'Recorded renewal authority: ' + ', '.join(refs) + '. Observer recipients have no renewal authority.'
+    return ('No recorded renewable agent authority. This legacy card remains held; an observer cannot renew it. '
+            'Ownership must be resolved through the supported operator authority path, not inferred from '
+            'notification delivery. No scope was renewed and no execution was authorized.')
diff --git a/hermes_cli/kanban_hold_effective.py b/hermes_cli/kanban_hold_effective.py
new file mode 100644
index 00000000000..1bdd35edd2f
--- /dev/null
+++ b/hermes_cli/kanban_hold_effective.py
@@ -0,0 +1,57 @@
+"""Current guidance over a stable hold episode; notification revision is not clearance."""
+from __future__ import annotations
+
+
+def current(conn, task_id: str):
+    """Read actual fences, not the original spend payload that later fences annotate."""
+    import hashlib
+    import json
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_spend_decision as decision
+    from hermes_cli.kanban_hold_audience import describe
+    from hermes_cli.kanban_refusal_receipt import restricted
+    from hermes_cli.kanban_scope_renewal import covered, key
+    from hermes_cli.kanban_sync_divergence import _event_order
+    stop = decision.pending_episode(conn, task_id)
+    if stop is None:
+        return None
+    episode = stop.get('uid') or str(stop['id'])
+    payload = kb._json_dict(stop['payload'])
+    safety = restricted(conn, task_id)
+    cause = 'safety_refusal' if safety else 'scope_stopped' if decision.execution_restricted(conn, task_id) else None
+    source = stop
+    if cause:
+        renewed = covered(conn, task_id)
+        candidates = [dict(r) for r in conn.execute(
+            "SELECT * FROM task_events WHERE task_id=? AND kind IN "
+            "('spend_budget_triaged','decision_hold_restricted')", (task_id,))]
+        candidates = [e for e in candidates if kb._json_dict(e['payload']).get('cause') == cause
+                      and (safety or key(e) not in renewed)]
+        candidates.extend(e for e in decision.receipt_restrictions(conn, task_id, safety_only=safety)
+                          if safety or key(e) not in renewed)
+        if candidates:
+            source = max(candidates, key=_event_order)
+            payload.update(kb._json_dict(source['payload']))
+        payload['cause'] = cause
+    payload.update(task_id=task_id, episode=episode, authority=describe(conn, task_id))
+    # Producer routing is delivery bookkeeping, not a guidance change.
+    payload.pop('producer', None)
+    revision = hashlib.sha256(json.dumps(payload, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+    return source, {**payload, 'revision': revision}
+
+
+def previous(conn, task_id: str, payload: dict):
+    """A pre-revision notice counts only when it already carries identical safe guidance."""
+    import json
+    from hermes_cli import kanban_db as kb
+    rows = conn.execute("SELECT * FROM task_events WHERE task_id=? AND kind='spend_budget_decision_ready' "
+                        "ORDER BY id DESC", (task_id,))
+    wanted = {k: v for k, v in payload.items() if k != 'revision'}
+    for row in rows:
+        prior = kb._json_dict(row['payload'])
+        if prior.get('revision') == payload['revision']:
+            return dict(row)
+        prior = {k: v for k, v in prior.items() if k not in ('revision', 'producer')}
+        if json.dumps(prior, sort_keys=True) == json.dumps(wanted, sort_keys=True):
+            return dict(row)
+    return None
diff --git a/hermes_cli/kanban_hold_notices.py b/hermes_cli/kanban_hold_notices.py
new file mode 100644
index 00000000000..247962a2a20
--- /dev/null
+++ b/hermes_cli/kanban_hold_notices.py
@@ -0,0 +1,104 @@
+"""Every-tick decision delivery, independent of stale triage and spawn capacity. [daveey]
+
+Only the card home produces events. Foreign owning chats consume the existing
+replica envelope; a notification never renews scope or satisfies acceptance.
+"""
+from __future__ import annotations
+
+
+def destinations(conn, task_id: str):
+    """Actual authority addresses, shared by binding and idle missing-link detection."""
+    from hermes_cli.kanban_hold_audience import describe
+    from hermes_cli.kanban_origin import gateway_names
+    from hermes_cli.profiles import get_active_profile_name
+    own, profile = gateway_names()[0], get_active_profile_name()
+    for link in describe(conn, task_id)['chats']:
+        gw, prof, session = link['gateway'], link['profile'], link['session']
+        local = gw == own and prof == profile
+        yield 'tui' if local else 'hub', session if local else f'{gw}/{prof}/{session}'
+
+
+def bind(conn, task_id: str, *, replay_event: int | None = None) -> None:
+    """Bind before publication, or replay an existing notice only for a new recipient."""
+    for platform, chat in destinations(conn, task_id):
+        conn.execute("INSERT OR IGNORE INTO kanban_notify_subs "
+                     "(task_id,platform,chat_id,thread_id,delivery_mode,delivery_metadata,created_at,last_event_id) "
+                     "VALUES (?,?,?,'','notify','{\"reason\":\"origin\"}',unixepoch(),"
+                     "COALESCE(?,(SELECT COALESCE(MAX(id),0) FROM task_events WHERE task_id=?)))",
+                     (task_id, platform, chat, replay_event - 1 if replay_event else None, task_id))
+
+
+def creator_pending(conn, task_id: str, identity: str) -> bool:
+    """Read-only destination/dedup preflight; callers recheck under their writer."""
+    from hermes_cli.kanban_archive_scope import _creator_task_id
+    from hermes_cli.kanban_wake_check import foreign_ids
+    owner = _creator_task_id(conn, task_id)
+    return bool(owner and owner not in foreign_ids(conn) and conn.execute(
+        'SELECT 1 FROM tasks WHERE id=?', (owner,)).fetchone() and not conn.execute(
+        "SELECT 1 FROM task_events WHERE task_id=? AND kind='hold_creator_notified' "
+        "AND CASE WHEN json_valid(payload) THEN json_extract(payload,'$.identity') END=? "
+        "AND CASE WHEN json_valid(payload) THEN json_extract(payload,'$.source_task_id') END=?",
+        (owner, identity, task_id)).fetchone())
+
+
+def creator(conn, task_id: str, identity: str, body: str) -> None:
+    """Same-transaction handoff to a recorded creator; no invented guard/decider card."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_archive_scope import _creator_task_id
+    if not creator_pending(conn, task_id, identity):
+        return
+    owner = _creator_task_id(conn, task_id)
+    kb.add_comment(conn, owner, 'kanban-decision-notice', f'{task_id}: {body}', system=True)
+    kb._append_event(conn, owner, 'hold_creator_notified',
+                     {'identity': identity, 'source_task_id': task_id, 'creator_task_id': owner})
+
+
+
+
+def publish(conn, task_id: str, *, with_producer: bool = False) -> None:
+    """Publish one guidance revision; bind authentic recipients before its event cursor."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_spend_decision as decision
+    from hermes_cli.kanban_hold_effective import current, previous
+    hold = current(conn, task_id)
+    if hold is None:
+        return
+    payload = hold[1]
+    prior = previous(conn, task_id, payload)
+    bind(conn, task_id, replay_event=prior['id'] if prior else None)
+    prior_prod = kb._json_dict(prior['payload']).get('producer') if prior else None
+    episode = payload.get('episode')
+    historical = decision.episode_route(conn, task_id, episode) if with_producer and isinstance(episode, str) else None
+    if historical is not None:
+        # Reuse a legacy wrapper, including a same-episode dismissal, without minting a guard.
+        if historical != prior_prod:
+            kb._append_event(conn, task_id, decision.NOTICE, {**payload, 'producer': historical})
+    elif prior is None:
+        if with_producer:
+            payload = {**payload, 'producer': decision.producer(conn, task_id, payload.get('reason') or 'Hold')}
+        kb._append_event(conn, task_id, decision.NOTICE, payload)
+    creator(conn, task_id, payload['revision'],
+            str(payload.get('reason') or 'Hold') + '. ' + decision.notice(payload))
+
+
+def sweep(conn) -> None:
+    """Repair fresh canonical retains in one dispatch tick, not hours later in the age sweep."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_hold_effective import current, previous
+    from hermes_cli.kanban_wake_check import foreign_ids
+    foreign = foreign_ids(conn)
+    for (tid,) in conn.execute("SELECT id FROM tasks WHERE status='triage'").fetchall():
+        if tid in foreign:
+            continue
+        hold = current(conn, tid)
+        if hold is None:
+            continue
+        # New recipients/restrictions are revisions even when the base episode
+        # was delivered. Unchanged polls remain read-only.
+        if previous(conn, tid, hold[1]) is not None and all(conn.execute(
+                'SELECT 1 FROM kanban_notify_subs WHERE task_id=? AND platform=? AND chat_id=?',
+                (tid, platform, chat)).fetchone() for platform, chat in destinations(conn, tid)):
+            continue
+        with kb.write_txn(conn):
+            if conn.execute('SELECT status FROM tasks WHERE id=?', (tid,)).fetchone()[0] == 'triage':
+                publish(conn, tid)
