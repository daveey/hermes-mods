From 914ee2e4cfe4df7bfadf7070ee8706f8a64c1957 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 19:26:42 -0800
Subject: [PATCH] fix(i18n): French, German and Spanish copy for the update
 backup progress [daveey]
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

catalog-completeness keeps fr/de/es Updates copy in their own overlays (no
English fallback), so the backup stage title, its progress line and
"Checking the backup…" get real translations there; overlay-gaps.json no
longer lists those three locales for these keys.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 apps/desktop/src/i18n/de.ts             | 3 +++
 apps/desktop/src/i18n/es.ts             | 3 +++
 apps/desktop/src/i18n/fr.ts             | 4 ++++
 apps/desktop/src/i18n/overlay-gaps.json | 6 +++---
 4 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/apps/desktop/src/i18n/de.ts b/apps/desktop/src/i18n/de.ts
index effdcdebb5..5970e64249 100644
--- a/apps/desktop/src/i18n/de.ts
+++ b/apps/desktop/src/i18n/de.ts
@@ -4255,6 +4255,7 @@ export const deOverrides = {
     stages: {
       idle: 'Wird vorbereitet…',
       prepare: 'Wird vorbereitet…',
+      backup: 'Sicherung vor dem Update…',
       fetch: 'Wird heruntergeladen…',
       pull: 'Fast fertig…',
       pydeps: 'Wird abgeschlossen…',
@@ -4307,6 +4308,8 @@ export const deOverrides = {
     applyingBodyBackend:
       'Das Remote-Backend wendet das Update an und startet neu. Hermes verbindet sich automatisch wieder, wenn es zurück ist.',
     applyingClose: 'Dieses Fenster schließt sich während des Updates, dann öffnet sich Hermes von selbst wieder.',
+    backupProgress: (done, total) => `Dein Chatverlauf wird vor dem Update gesichert: ${done} von ${total}`,
+    backupChecking: 'Sicherung wird geprüft…',
     errorTitle: 'Update nicht abgeschlossen',
     errorBody: 'Keine Sorge – es ging nichts verloren. Sie können es jetzt erneut versuchen.',
     blockerTitle: 'Lokale Vorschauen schließen, um Hermes zu aktualisieren?',
diff --git a/apps/desktop/src/i18n/es.ts b/apps/desktop/src/i18n/es.ts
index 05a784b5d9..e05c80935b 100644
--- a/apps/desktop/src/i18n/es.ts
+++ b/apps/desktop/src/i18n/es.ts
@@ -4244,6 +4244,7 @@ export const esOverrides = {
     stages: {
       idle: 'Preparando…',
       prepare: 'Preparando…',
+      backup: 'Haciendo una copia de seguridad antes de actualizar…',
       fetch: 'Descargando…',
       pull: 'Casi listo…',
       pydeps: 'Terminando…',
@@ -4297,6 +4298,8 @@ export const esOverrides = {
     applyingBodyBackend:
       'El backend remoto está aplicando la actualización y se reiniciará. Hermes se reconectará automáticamente cuando vuelva a estar disponible.',
     applyingClose: 'Hermes se cerrará para aplicar la actualización.',
+    backupProgress: (done, total) => `Copiando tu historial de chats antes de actualizar: ${done} de ${total}`,
+    backupChecking: 'Comprobando la copia de seguridad…',
     errorTitle: 'La actualización no terminó',
     errorBody: 'No pasa nada: no se perdió nada. Puedes intentarlo de nuevo ahora.',
     blockerTitle: '¿Cerrar las vistas previas locales para actualizar Hermes?',
diff --git a/apps/desktop/src/i18n/fr.ts b/apps/desktop/src/i18n/fr.ts
index b1c01b0821..d8cb2830f7 100644
--- a/apps/desktop/src/i18n/fr.ts
+++ b/apps/desktop/src/i18n/fr.ts
@@ -4265,6 +4265,7 @@ export const frOverrides = {
     stages: {
       idle: 'Préparation…',
       prepare: 'Préparation…',
+      backup: 'Sauvegarde avant la mise à jour…',
       fetch: 'Téléchargement…',
       pull: 'Presque prêt…',
       pydeps: 'Finalisation…',
@@ -4318,6 +4319,9 @@ export const frOverrides = {
     applyingBodyBackend:
       'Le backend distant applique la mise à jour et va redémarrer. Hermes se reconnecte automatiquement à son retour.',
     applyingClose: 'Cette fenêtre se fermera pendant la mise à jour, puis Hermes se rouvre seul.',
+    backupProgress: (done, total) =>
+      `Sauvegarde de votre historique de discussions avant la mise à jour : ${done} sur ${total}`,
+    backupChecking: 'Vérification de la sauvegarde…',
     errorTitle: 'Mise à jour non terminée',
     errorBody: "Pas de souci — rien n'a été perdu. Vous pouvez réessayer maintenant.",
     blockerTitle: 'Fermer les aperçus locaux pour mettre à jour Hermes ?',
diff --git a/apps/desktop/src/i18n/overlay-gaps.json b/apps/desktop/src/i18n/overlay-gaps.json
index 7e5a28bbb6..257983e15d 100644
--- a/apps/desktop/src/i18n/overlay-gaps.json
+++ b/apps/desktop/src/i18n/overlay-gaps.json
@@ -2387,7 +2387,7 @@
   "shell.statusbar.forceUpdate.failed": ["ar","de","es","fr","ja","ru","zh","zh-hant"],
   "assistant.thread.errorCodes.core_update_forced_stop.body": ["ar","de","es","fr","ja","ru","zh","zh-hant"],
   "assistant.thread.errorCodes.core_update_forced_stop.title": ["ar","de","es","fr","ja","ru","zh","zh-hant"],
-  "updates.stages.backup": ["ar","de","es","fr","ja","ru","zh","zh-hant"],
-  "updates.backupProgress": ["ar","de","es","fr","ja","ru","zh","zh-hant"],
-  "updates.backupChecking": ["ar","de","es","fr","ja","ru","zh","zh-hant"]
+  "updates.stages.backup": ["ar","ja","ru","zh","zh-hant"],
+  "updates.backupProgress": ["ar","ja","ru","zh","zh-hant"],
+  "updates.backupChecking": ["ar","ja","ru","zh","zh-hant"]
 }
-- 
2.43.0

