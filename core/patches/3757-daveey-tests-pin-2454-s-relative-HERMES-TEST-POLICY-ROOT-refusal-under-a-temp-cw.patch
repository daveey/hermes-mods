From efe9eae9c58c0d8237acdc5f5d1ce42a8859fa19 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 18:36:11 +0000
Subject: [PATCH] [daveey] tests: pin #2454's relative HERMES_TEST_POLICY_ROOT
 refusal under a temp cwd and the primary-board-only unknown-streak sweep

Post-merge check t_01a1d61df02c9eca of #2454 found two exact-anchor mutants that
survive the three worker-resources suites (t_01a1d62f12ab6265):

- C2 `_test_policy_override`: `if not raw or not os.path.isabs(raw):` -> `if not raw:`.
  realpath resolves a relative value against the cwd, so a process whose cwd sits
  under a temp root would honour `relative/.hermes`. The existing parametrized case
  passed only because the test cwd is not under a temp root. New test chdirs into a
  dir under a (monkeypatched) temp root, proves the absolute form is honoured there,
  and asserts the relative form is still refused.
- C4 `worker_resources_unknown_alarm.sweep`: `if sync.board_mode(conn) != "primary":`
  -> `if False:`. A shadow or unsynced board would open its own repair card, breaking
  one card per host per incident. New test (shadow, off) with a stalled streak asserts
  sweep returns None and files no card.

Proof (hermes-core-wt test, the three suites):
- GREEN at this head: 57 passed, 0 failed.
- C2 mutant: 1 failed (test_a_relative_policy_root_is_refused_even_when_the_cwd_is_a_temp_root).
- C4 mutant: 2 failed (test_a_non_primary_board_never_sweeps[shadow], [off]).

Tests only; no production change.
---
 tests/hermes_cli/test_worker_compute_capacity.py | 15 +++++++++++++++
 .../test_worker_resources_unknown_alarm.py       | 16 ++++++++++++++++
 2 files changed, 31 insertions(+)

diff --git a/tests/hermes_cli/test_worker_compute_capacity.py b/tests/hermes_cli/test_worker_compute_capacity.py
index 5787636beb..aa3c5794ac 100644
--- a/tests/hermes_cli/test_worker_compute_capacity.py
+++ b/tests/hermes_cli/test_worker_compute_capacity.py
@@ -109,6 +109,21 @@ def test_an_odd_tmpdir_never_admits_a_durable_policy_root(tmp_path, monkeypatch,
     assert got == (Path(os.path.realpath(raw)) if honoured else None)
 
 
+def test_a_relative_policy_root_is_refused_even_when_the_cwd_is_a_temp_root(tmp_path, monkeypatch):
+    """#2454 post-merge mutant C2 (t_01a1d62f12ab6265): realpath resolves a relative value against the cwd, so
+    without the isabs check a process whose cwd sits under a temp root would honour ``relative/.hermes``."""
+    import os
+    from pathlib import Path
+    from hermes_cli import worker_compute_capacity as capacity
+    cwd = tmp_path / 'cwd'
+    cwd.mkdir()
+    monkeypatch.setattr(capacity, 'SYSTEM_TEMP_ROOTS', (str(tmp_path),))
+    monkeypatch.chdir(cwd)
+    resolved = Path(os.path.realpath('relative/.hermes'))
+    assert capacity._test_policy_override({'HERMES_TEST_POLICY_ROOT': str(resolved)}) == resolved  # cwd: a temp root
+    assert capacity._test_policy_override({'HERMES_TEST_POLICY_ROOT': 'relative/.hermes'}) is None
+
+
 def test_policy_root_follows_the_override_in_a_child(tmp_path):
     """The unpatched policy_root (a fresh interpreter, no conftest) answers the shard dir, not the account."""
     import os
diff --git a/tests/hermes_cli/test_worker_resources_unknown_alarm.py b/tests/hermes_cli/test_worker_resources_unknown_alarm.py
index bdacdca206..10ddd22cdd 100644
--- a/tests/hermes_cli/test_worker_resources_unknown_alarm.py
+++ b/tests/hermes_cli/test_worker_resources_unknown_alarm.py
@@ -12,6 +12,8 @@ import json
 import sqlite3
 import time
 
+import pytest
+
 from hermes_cli import worker_account_boards as inventory
 from hermes_cli import worker_compute_capacity as capacity
 from hermes_cli import worker_resource_admission as admission
@@ -104,6 +106,20 @@ def test_a_streak_past_ten_minutes_files_one_card_off_this_host(gws):
     assert len(_alarms(worker.conn)) == 1  # same incident: the open card is reused
 
 
+@pytest.mark.parametrize("mode", ["shadow", "off"])
+def test_a_non_primary_board_never_sweeps(gws, mode):
+    """#2454 post-merge mutant C4 (t_01a1d62f12ab6265): only the primary board files the host's repair card; a shadow
+    or unsynced board opening its own would break one card per host per incident."""
+    from hermes_cli import kanban_db_sync as sync
+    _hub, worker = gws
+    _streak(alarm.STALL_SECONDS + 60)
+    assert sync.board_mode(worker.conn) == "primary"
+    sync.set_mode(worker.conn, mode)
+    assert sync.board_mode(worker.conn) == mode
+    assert alarm.sweep(worker.conn) is None
+    assert not _alarms(worker.conn)
+
+
 def test_a_stale_streak_files_nothing(gws):
     _hub, worker = gws
     path = capacity.policy_root() / "worker-resources" / "unknown.json"
