diff --git a/tests/hermes_cli/test_kanban_goal_loop_clean_stop.py b/tests/hermes_cli/test_kanban_goal_loop_clean_stop.py
new file mode 100644
index 00000000000..121e6528ccb
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_goal_loop_clean_stop.py
@@ -0,0 +1,198 @@
+"""A goal-mode worker whose loop stops on a dispatcher-owned status exits clean; a broken loop does not. [daveey]
+
+t_82f0fe15 (2026-10-30): a goal-mode worker that parks itself (``kanban_schedule``) ends its run as
+``scheduled``; the run's own view (``goal_run_status``) then reads ``scheduled`` and the loop stops.
+That stop must exit 0 so the dispatcher keeps the ``scheduled`` outcome and counts no failure. A loop
+that broke (a follow-up turn raised, the judge or the status read failed) must still exit non-zero
+instead of looking like a clean exit on the last good turn's result.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import goals
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as kbd
+from hermes_cli.turn_exit import turn_exit_code
+
+OK_TURN = {"final_response": "parked until the PR merges", "completed": True}
+# Every lifecycle status the dispatcher (or an operator) owns once the worker's run is no longer live.
+DISPATCHER_OWNED = ["scheduled", "superseded", "continued", "blocked", "archived", "triage", "todo",
+                    "review", "done", "changes_requested", None]
+
+
+def _judge(monkeypatch, verdict="continue", transport_failed=False):
+    def fake(goal, response, subgoals=None, background_processes=None, **_kw):
+        return verdict, f"scripted:{verdict}", False, None, transport_failed
+    monkeypatch.setattr(goals, "judge_goal", fake)
+
+
+def _exit(result, loop):
+    return turn_exit_code(goals.kanban_goal_loop_turn_result(result, loop), kanban_worker=True)
+
+
+@pytest.mark.parametrize("status", DISPATCHER_OWNED)
+def test_dispatcher_owned_status_is_a_clean_stop_exit_0(monkeypatch, status):
+    _judge(monkeypatch)
+    turns = []
+    loop = goals.run_kanban_goal_loop(
+        task_id="t1", goal_text="g", run_turn=lambda p: turns.append(p) or "x",
+        task_status_fn=lambda: status, block_fn=lambda r: pytest.fail("must not block"),
+        first_response="parked")
+    assert loop["failed"] is False
+    assert turns == []
+    assert _exit(OK_TURN, loop) == 0
+
+
+def test_run_turn_exception_still_exits_nonzero(monkeypatch):
+    _judge(monkeypatch)
+
+    def boom(_prompt):
+        raise RuntimeError("model call died")
+    loop = goals.run_kanban_goal_loop(task_id="t1", goal_text="g", run_turn=boom,
+                                      task_status_fn=lambda: "running", block_fn=lambda r: None,
+                                      first_response="first")
+    assert loop["outcome"] == "stopped" and loop["reason"] == "run_turn error: RuntimeError"
+    assert loop["failed"] is True
+    assert _exit(OK_TURN, loop) == 1
+
+
+def test_judge_transport_failure_still_exits_nonzero(monkeypatch):
+    _judge(monkeypatch, verdict="wait", transport_failed=True)
+    loop = goals.run_kanban_goal_loop(task_id="t1", goal_text="g", run_turn=lambda p: "x",
+                                      task_status_fn=lambda: "running", block_fn=lambda r: None)
+    assert loop["failed"] is True
+    assert _exit(OK_TURN, loop) == 1
+
+
+def test_status_read_failure_still_exits_nonzero(monkeypatch):
+    _judge(monkeypatch)
+
+    def unreadable():
+        raise OSError("board locked")
+    loop = goals.run_kanban_goal_loop(task_id="t1", goal_text="g", run_turn=lambda p: "x",
+                                      task_status_fn=unreadable, block_fn=lambda r: None)
+    assert loop["failed"] is True
+    assert _exit(OK_TURN, loop) == 1
+
+
+def test_failed_follow_up_turn_keeps_its_provider_exit(monkeypatch):
+    """A follow-up turn that failed on a rate-limit wall keeps EX_TEMPFAIL (requeued uncounted)."""
+    _judge(monkeypatch)
+    failed = {"final_response": "", "failed": True, "failure_reason": "rate_limit"}
+    loop = goals.run_kanban_goal_loop(
+        task_id="t1", goal_text="g", run_turn=lambda p: {"response": "", "failed": True, "failure_reason": "rate_limit"},
+        task_status_fn=lambda: "running", block_fn=lambda r: None)
+    assert loop["failed"] is True
+    assert _exit(failed, loop) == kb.KANBAN_RATE_LIMIT_EXIT_CODE
+
+
+def test_no_loop_keeps_the_turn_result():
+    assert goals.kanban_goal_loop_turn_result(OK_TURN, None) is OK_TURN
+
+
+# ---------------------------------------------------------------------------
+# Managed worker path (gateway.session_kanban._run_task_turns): the production entry point.
+# ---------------------------------------------------------------------------
+
+
+@pytest.fixture
+def kanban_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_KANBAN_CRASH_GRACE_SECONDS", "0")
+    kb.init_db()
+    return home
+
+
+def _running_goal_card(conn):
+    tid = kb.create_task(conn, title="goal card", body="merge the PR", assignee="default", goal_mode=True)
+    kb.claim_task(conn, tid, claimer=f"{kb._claimer_id().split(':', 1)[0]}:w4242")
+    return tid, kb.get_task(conn, tid).current_run_id
+
+
+class _Agent:
+    session_id = "s1"
+
+    def __init__(self, on_turn):
+        self.calls, self._on_turn = 0, on_turn
+        self._session_db = type("DB", (), {"get_messages_as_conversation": lambda _s, _sid: []})()
+
+    def run_conversation(self, prompt, conversation_history=None, turn_author=None):
+        self.calls += 1
+        return self._on_turn(self.calls)
+
+
+def _managed(monkeypatch, tid, run_id, agent):
+    from agent import kanban_turn_recovery as recovery
+    from agent import skill_commands
+    from gateway import session_kanban
+    monkeypatch.setattr(skill_commands, "build_preloaded_skills_prompt", lambda *a, **k: ("", [], []))
+    monkeypatch.setattr(recovery, "recover_failed_kanban_turns", lambda *a, **k: None)
+    context = {"skills": [], "context": "", "task_id": tid, "run_id": run_id, "goal_mode": True,
+               "goal_text": "goal card\n\nmerge the PR", "goal_max_turns": 5}
+    result = session_kanban._run_task_turns(agent, {"text": "work kanban task"}, [], context)
+    return turn_exit_code(result, kanban_worker=True)
+
+
+def test_managed_worker_that_parks_itself_exits_0_and_keeps_scheduled(kanban_home, monkeypatch):
+    _judge(monkeypatch)
+    with kbc.connect() as conn:
+        tid, run_id = _running_goal_card(conn)
+
+        def turn(n):
+            # The worker's first turn parks the card (kanban_schedule / kanban_block kind=time).
+            with kbc.connect() as c:
+                assert kb.schedule_task(c, tid, reason="SCHEDULED_UNTIL=2099-01-01T00:00:00Z PR not merged",
+                                        expected_run_id=run_id, clock_only=True)
+            return dict(OK_TURN)
+        agent = _Agent(turn)
+        assert kb.goal_run_status(conn, tid, run_id) == "running"
+        code = _managed(monkeypatch, tid, run_id, agent)
+        assert agent.calls == 1  # no continuation turn after the park
+        assert code == 0
+        assert kb.goal_run_status(conn, tid, run_id) == "scheduled"  # the run's own park, not an ownership loss
+        run = conn.execute("SELECT outcome FROM task_runs WHERE id=?", (run_id,)).fetchone()
+        task = kb.get_task(conn, tid)
+        assert run["outcome"] == "scheduled"
+        assert task.status == "scheduled" and task.consecutive_failures == 0
+
+
+def test_managed_worker_whose_follow_up_turn_raises_exits_nonzero(kanban_home, monkeypatch):
+    _judge(monkeypatch)
+    with kbc.connect() as conn:
+        tid, run_id = _running_goal_card(conn)
+
+    def turn(n):
+        if n == 1:
+            return dict(OK_TURN)
+        raise RuntimeError("provider socket closed")
+    agent = _Agent(turn)
+    assert _managed(monkeypatch, tid, run_id, agent) == 1
+    assert agent.calls == 2
+
+
+# ---------------------------------------------------------------------------
+# Dispatcher booking of a parked goal worker that exits 0.
+# ---------------------------------------------------------------------------
+
+
+def test_parked_goal_worker_exit_0_is_not_booked_as_a_crash(kanban_home, monkeypatch):
+    monkeypatch.setattr(kb, "_pid_alive", lambda pid: False)
+    monkeypatch.setattr(kbd, "_classify_worker_exit", lambda pid: ("clean_exit", 0))
+    with kbc.connect() as conn:
+        tid, run_id = _running_goal_card(conn)
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET worker_pid=4242 WHERE id=?", (tid,))
+        assert kb.schedule_task(conn, tid, reason="SCHEDULED_UNTIL=2099-01-01T00:00:00Z wait",
+                                expected_run_id=run_id, clock_only=True)
+        kbd.detect_crashed_workers(conn)
+        run = conn.execute("SELECT outcome FROM task_runs WHERE id=?", (run_id,)).fetchone()
+        task = kb.get_task(conn, tid)
+        assert run["outcome"] == "scheduled"
+        assert task.status == "scheduled" and task.consecutive_failures == 0
diff --git a/tests/hermes_cli/test_kanban_owner_unavailable.py b/tests/hermes_cli/test_kanban_owner_unavailable.py
new file mode 100644
index 00000000000..bc1160c7072
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_owner_unavailable.py
@@ -0,0 +1,194 @@
+"""A worker whose profile owner never answers its claim is requeued uncounted, not booked a crash. [daveey]
+
+t_82f0fe15 runs 7630/7649 (2026-10-30 08:30-08:37Z): the hub gateway sat in a restart's
+``restart_wait`` drain, so each dispatcher worker waited ``OWNER_WAIT_S`` for an owner that never
+admitted the claim, printed ``Kanban owner refused: Kanban owner silent for 185s: Gateway draining:
+restart_wait`` and exited 1. Both were booked ``crashed``; failure_limit=2 sent the card to triage
+although no turn ever ran. The next run after the restart (7690) parked cleanly.
+"""
+from __future__ import annotations
+
+import asyncio
+from contextlib import asynccontextmanager
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.drain_control import RESTART_WAIT_REASON
+from hermes_cli import gateway_client, kanban_worker_client
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as kbd
+from hermes_cli import kanban_owner_unavailable as ou
+
+GUE = gateway_client.GatewayUnavailableError
+
+
+# ---------------------------------------------------------------------------
+# Worker client: the exit code.
+# ---------------------------------------------------------------------------
+
+
+def _fake_clock(monkeypatch):
+    clock = [0.0]
+    monkeypatch.setattr(kanban_worker_client, "time", SimpleNamespace(monotonic=lambda: clock[0]))
+
+    async def _sleep(seconds):
+        clock[0] += seconds
+    monkeypatch.setattr(kanban_worker_client.asyncio, "sleep", _sleep)
+
+
+def _owner(*, admit_first: bool):
+    """Every dial lands in a restart wait, except (``admit_first``) one that admits the claim first."""
+    dials = [0]
+
+    @asynccontextmanager
+    async def _connect(*_, **__):
+        dials[0] += 1
+        if not (admit_first and dials[0] == 1):
+            raise GUE(f"Gateway draining: {RESTART_WAIT_REASON}", "draining", RESTART_WAIT_REASON)
+
+        class _Client:
+            events = asyncio.Queue()
+
+            async def rpc(self, method, **params):
+                if method == "kanban.run":
+                    return {"session_id": "s1", "receipt": {"status": "pending", "admission_id": "a1"}}
+                raise gateway_client.GatewayClientError("Gateway disconnected; turn outcome is unknown")
+        yield _Client()
+    return _connect
+
+
+def _submit_env(monkeypatch, tmp_path):
+    monkeypatch.delenv("HERMES_TUI_GATEWAY_URL", raising=False)
+    for key, value in {"HERMES_KANBAN_BOARD": "default", "HERMES_KANBAN_TASK": "t1", "HERMES_KANBAN_RUN_ID": "7",
+                       "HERMES_KANBAN_CLAIM_LOCK": "h:1", "HERMES_KANBAN_DB": str(tmp_path / "kanban.db")}.items():
+        monkeypatch.setenv(key, value)
+
+
+def test_owner_that_never_admits_exits_owner_unavailable(monkeypatch, tmp_path, capsys):
+    _fake_clock(monkeypatch)
+    _submit_env(monkeypatch, tmp_path)
+    monkeypatch.setattr(gateway_client, "connect_gateway", _owner(admit_first=False))
+    assert kanban_worker_client._submit() == ou.KANBAN_OWNER_UNAVAILABLE_EXIT_CODE == 69
+    assert "Kanban owner refused: Kanban owner silent for" in capsys.readouterr().err
+
+
+def test_owner_that_admitted_then_went_silent_still_exits_1(monkeypatch, tmp_path):
+    _fake_clock(monkeypatch)
+    _submit_env(monkeypatch, tmp_path)
+    monkeypatch.setattr(gateway_client, "connect_gateway", _owner(admit_first=True))
+    assert kanban_worker_client._submit() == 1
+
+
+def test_a_final_owner_refusal_still_exits_1(monkeypatch, tmp_path):
+    _submit_env(monkeypatch, tmp_path)
+
+    @asynccontextmanager
+    async def _connect(*_, **__):
+        raise GUE("Gateway refused: unsafe peer", "inaccessible", "unsafe_control_peer")
+        yield
+    monkeypatch.setattr(gateway_client, "connect_gateway", _connect)
+    assert kanban_worker_client._submit() == 1
+
+
+# ---------------------------------------------------------------------------
+# Dispatcher: the booking.
+# ---------------------------------------------------------------------------
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_KANBAN_CRASH_GRACE_SECONDS", "0")
+    monkeypatch.setattr(kb, "_pid_alive", lambda pid: False)
+    monkeypatch.setattr(kbd, "_worker_final_output", lambda *a, **kw: "")
+    kb.init_db()
+    return home
+
+
+def _exits(monkeypatch, code):
+    from hermes_cli.kanban_db_dispatch_exit_code import exit_code_kind
+    monkeypatch.setattr(kbd, "_classify_worker_exit", lambda pid: exit_code_kind(code))
+
+
+def _running(conn, tid=None, pid=71001):
+    tid = tid or kb.create_task(conn, title="goal card", assignee="default", goal_mode=True)
+    kb.claim_task(conn, tid, claimer=f"{kb._claimer_id().split(':', 1)[0]}:w{pid}")
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET worker_pid=? WHERE id=?", (pid, tid))
+    return tid
+
+
+def _last_run(conn, tid):
+    return conn.execute("SELECT outcome, error FROM task_runs WHERE task_id=? ORDER BY id DESC LIMIT 1",
+                        (tid,)).fetchone()
+
+
+def test_owner_unavailable_exit_requeues_uncounted(home, monkeypatch):
+    _exits(monkeypatch, ou.KANBAN_OWNER_UNAVAILABLE_EXIT_CODE)
+    with kbc.connect() as conn:
+        tid = _running(conn)
+        kbd.detect_crashed_workers(conn)
+        task = kb.get_task(conn, tid)
+        run = _last_run(conn, tid)
+        assert run["outcome"] == "owner_unavailable"
+        assert "no turn ran" in run["error"]
+        assert task.status == "ready" and task.consecutive_failures == 0
+
+
+def test_two_owner_unavailable_runs_do_not_spend_the_failure_budget(home, monkeypatch):
+    """The t_82f0fe15 sequence: two refusals in a row under failure_limit=2 must leave it dispatchable."""
+    _exits(monkeypatch, ou.KANBAN_OWNER_UNAVAILABLE_EXIT_CODE)
+    with kbc.connect() as conn:
+        tid = _running(conn)
+        kbd.detect_crashed_workers(conn)
+        _running(conn, tid, pid=71002)
+        kbd.detect_crashed_workers(conn)
+        task = kb.get_task(conn, tid)
+        assert task.status == "ready" and task.consecutive_failures == 0
+        outcomes = [r["outcome"] for r in conn.execute("SELECT outcome FROM task_runs WHERE task_id=?", (tid,))]
+        assert outcomes == ["owner_unavailable", "owner_unavailable"]
+
+
+def test_owner_unavailable_after_an_admission_is_still_a_crash(home, monkeypatch):
+    _exits(monkeypatch, ou.KANBAN_OWNER_UNAVAILABLE_EXIT_CODE)
+    with kbc.connect() as conn:
+        tid = _running(conn)
+        run_id = kb.get_task(conn, tid).current_run_id
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, "owner_admitted", {"db": "/nowhere"}, run_id=run_id)
+        from hermes_cli import kanban_owner_recovery
+        monkeypatch.setattr(kanban_owner_recovery, "owner_reclaim_blocked", lambda *a, **k: False)
+        kbd.detect_crashed_workers(conn)
+        run = _last_run(conn, tid)
+        assert run["outcome"] == "crashed"
+        assert "the owner had admitted this run" in run["error"]
+        assert kb.get_task(conn, tid).consecutive_failures == 1
+
+
+def test_an_owner_that_never_returns_reaches_the_breaker(home, monkeypatch):
+    _exits(monkeypatch, ou.KANBAN_OWNER_UNAVAILABLE_EXIT_CODE)
+    with kbc.connect() as conn:
+        tid = _running(conn)
+        for i in range(ou.NEUTRAL_STREAK_LIMIT):
+            kbd.detect_crashed_workers(conn)
+            _running(conn, tid, pid=72000 + i)
+        kbd.detect_crashed_workers(conn)
+        run = _last_run(conn, tid)
+        assert run["outcome"] == "crashed"
+        assert f"{ou.NEUTRAL_STREAK_LIMIT} runs in a row found no owner" in run["error"]
+        assert kb.get_task(conn, tid).consecutive_failures == 1
+
+
+def test_plain_exit_1_is_still_a_crash(home, monkeypatch):
+    _exits(monkeypatch, 1)
+    with kbc.connect() as conn:
+        tid = _running(conn)
+        kbd.detect_crashed_workers(conn)
+        assert _last_run(conn, tid)["outcome"] == "crashed"
+        assert kb.get_task(conn, tid).consecutive_failures == 1
diff --git a/tests/hermes_cli/test_single_query_exit_contract.py b/tests/hermes_cli/test_single_query_exit_contract.py
index 1566f025eac..3918a1d297e 100644
--- a/tests/hermes_cli/test_single_query_exit_contract.py
+++ b/tests/hermes_cli/test_single_query_exit_contract.py
@@ -107,3 +107,54 @@ def test_quiet_kanban_worker_exits_tempfail_when_credentials_are_rate_limited(mo
     with pytest.raises(SystemExit) as exc:
         cli._run_single_query_mode(stub, "do the thing", None, True, True)
     assert exc.value.code == expected
+
+
+# [daveey] Goal-mode workers (t_82f0fe15, 2026-10-30): a loop that stops because the worker parked the
+# card (scheduled, read back as superseded) or the dispatcher owns it exits 0; a broken loop exits 1.
+_PARKED = {"outcome": "stopped", "reason": "status=superseded", "turns_used": 0, "failed": False}
+_BROKEN = {"outcome": "stopped", "reason": "run_turn error: RuntimeError", "turns_used": 1, "failed": True}
+
+
+@pytest.mark.parametrize(("loop", "expected"), [(_PARKED, 0), (_BROKEN, 1), (None, 0)])
+def test_q_goal_worker_exit_follows_the_goal_loop(monkeypatch, loop, expected):
+    monkeypatch.setenv("HERMES_KANBAN_TASK", "t_abc123")
+    monkeypatch.setenv("HERMES_KANBAN_GOAL_MODE", "1")
+    monkeypatch.setattr(cli, "_run_kanban_goal_loop_chat", lambda c, r: loop)
+    assert _run_non_quiet(monkeypatch, {"final_response": "parked", "completed": True}) == expected
