From f8d0dfbe761f43c07223f7344c9726fe450ba903 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 02:13:25 +0000
Subject: [PATCH] fix(tests): deflake unmapped-home proof; wait for the stub's
 /proc cmdline+environ after Popen (vfork returns before they are published)

---
 .../test_update_pause_unmapped_home_proof.py        | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/tests/hermes_cli/test_update_pause_unmapped_home_proof.py b/tests/hermes_cli/test_update_pause_unmapped_home_proof.py
index 735049bcc5..27822a409e 100644
--- a/tests/hermes_cli/test_update_pause_unmapped_home_proof.py
+++ b/tests/hermes_cli/test_update_pause_unmapped_home_proof.py
@@ -41,6 +41,19 @@ def homes_and_spawn(tmp_path):
     def spawn(home) -> subprocess.Popen:
         proc = subprocess.Popen(argv, env={**os.environ, "HERMES_HOME": str(home)})
         procs.append(proc)
+        # Popen returns once the child's mm is replaced (vfork), which is before the kernel has
+        # published its /proc cmdline and environ. A throttled runner can be preempted in that
+        # window, and the readiness predicate then reads an empty cmdline/environ and matches nothing.
+        deadline = time.monotonic() + 60
+        while True:
+            try:
+                p = psutil.Process(proc.pid)
+                if list(p.cmdline()) == argv and p.environ().get("HERMES_HOME") == str(home):
+                    break
+            except (psutil.Error, OSError):
+                pass
+            assert time.monotonic() < deadline, "spawned stub never exposed its cmdline/environ"
+            time.sleep(0.01)
         return proc
 
     yield home_a, home_b, spawn
