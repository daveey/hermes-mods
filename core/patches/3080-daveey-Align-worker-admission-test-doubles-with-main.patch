From 16e8994cc33fa52bbca54b145f7afca55a2b9ce0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 00:10:21 +0000
Subject: [PATCH] [daveey] Align worker admission test doubles with main's
 final-gate keywords and policy reads

---
 tests/hermes_cli/test_machine_admission_metrics.py  | 3 +++
 tests/hermes_cli/test_worker_account_admission.py   | 2 +-
 tests/hermes_cli/test_worker_retirement_recovery.py | 2 +-
 3 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_machine_admission_metrics.py b/tests/hermes_cli/test_machine_admission_metrics.py
index 3fb104f24d..5403be4ad4 100644
--- a/tests/hermes_cli/test_machine_admission_metrics.py
+++ b/tests/hermes_cli/test_machine_admission_metrics.py
@@ -26,8 +26,11 @@ def test_collect_uses_one_config_and_one_census(monkeypatch, tmp_path):
             detail["pools"].update(regular=7, priority=1)
         return 8
 
+    from hermes_cli import worker_compute_capacity
     monkeypatch.setattr(config_backend, "read_config_doc_readonly", read)
     monkeypatch.setattr(mm, "active_card_runs", census)
+    # [daveey] The worker-resource policy is a separate account-root read; this test pins the hub tuple's one read.
+    monkeypatch.setattr(worker_compute_capacity, "worker_enabled", lambda: False)
     out = mm.collect(tmp_path)
     assert {key: out.get(key) for key in EXPECTED} == EXPECTED
     assert out["active_card_runs"] == 8
diff --git a/tests/hermes_cli/test_worker_account_admission.py b/tests/hermes_cli/test_worker_account_admission.py
index e03178fe31..a8f29232a6 100644
--- a/tests/hermes_cli/test_worker_account_admission.py
+++ b/tests/hermes_cli/test_worker_account_admission.py
@@ -14,7 +14,7 @@ def account(monkeypatch, tmp_path):
     root.mkdir()
     monkeypatch.setattr(capacity, 'policy_root', lambda: root)
     monkeypatch.setattr(capacity, 'worker_enabled', lambda: True)
-    monkeypatch.setattr(admission, '_final_hub_gate', lambda *a: (None, None))
+    monkeypatch.setattr(admission, '_final_hub_gate', lambda *a, **k: (None, None))
     return root
 
 
diff --git a/tests/hermes_cli/test_worker_retirement_recovery.py b/tests/hermes_cli/test_worker_retirement_recovery.py
index 0fafdce3db..23b736f79b 100644
--- a/tests/hermes_cli/test_worker_retirement_recovery.py
+++ b/tests/hermes_cli/test_worker_retirement_recovery.py
@@ -107,7 +107,7 @@ def test_claim_with_disabled_policy_invalidates_proof_under_account_fence(board,
     _, intent = retirement.record_paths(board)
     monkeypatch.setattr(capacity, 'worker_enabled', lambda: False)
     monkeypatch.setattr('hermes_constants.get_default_hermes_root', lambda: board.parent)
-    monkeypatch.setattr(admission, '_final_hub_gate', lambda *a: (None, None))
+    monkeypatch.setattr(admission, '_final_hub_gate', lambda *a, **k: (None, None))
     with sqlite3.connect(board) as conn:
         with admission_lock(capacity.policy_root(), timeout=0):
             with admission.claim_transaction(conn) as accepted:
-- 
2.51.0

