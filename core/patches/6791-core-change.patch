Subject: [PATCH 6791] Origin-forward refusals, queued-create wait handles and wait-check parsing

Public mirror of source commit 5b9e6634f8c1090e81d911d3ec7c622cba5ee15b.

---
diff --git a/tests/hermes_cli/test_kanban_awaited_card_wake.py b/tests/hermes_cli/test_kanban_awaited_card_wake.py
index d18c1fd594c502518764d774ceaddc3e801f367e..9d252885bd2ac89cae9142227a6a7014d26b4872 100644
--- a/tests/hermes_cli/test_kanban_awaited_card_wake.py
+++ b/tests/hermes_cli/test_kanban_awaited_card_wake.py
@@ -185,6 +185,8 @@
     monkeypatch.setenv("HERMES_HUB_STATE", str(state))
     db = sqlite3.connect(state / "hub.db")
     db.execute("CREATE TABLE replica(gw TEXT, coll TEXT, key TEXT, data TEXT, updated_at INTEGER)")
+    # Preserve the courier journal shape while exercising a lagging registry.
+    db.execute("CREATE TABLE sent(id TEXT PRIMARY KEY, state TEXT, body TEXT)")
     scope = {"task_scopes": [{"board": BOARD, "profile": "default", "state": "ok", "observed_at": time.time() - 30}]}
     db.execute("INSERT INTO replica VALUES(?,?,?,?,?)", (OTHER, "gateway", OTHER, json.dumps(scope), 1))
     row = dict(id=REVIEW, board=BOARD, status="running", gateway=OTHER, profile="default", owner_profile="default",
diff --git a/tests/hermes_cli/test_kanban_board_replica_refs.py b/tests/hermes_cli/test_kanban_board_replica_refs.py
index 327ccaba25bde897f30a35b346123281525b4173..4c383f4f5c54c781fb5dd0a49ebfdf83cda4d51d 100644
--- a/tests/hermes_cli/test_kanban_board_replica_refs.py
+++ b/tests/hermes_cli/test_kanban_board_replica_refs.py
@@ -33,6 +33,8 @@
     conn = sqlite3.connect(state_dir / "hub.db")
     conn.execute("CREATE TABLE replica (coll TEXT, gw TEXT, key TEXT, data TEXT, updated_at INTEGER)")
     conn.execute("CREATE TABLE meta (k TEXT PRIMARY KEY, v TEXT)")
+    # The real courier store also has an empty outbound request journal.
+    conn.execute("CREATE TABLE sent(id TEXT PRIMARY KEY, state TEXT, body TEXT)")
     conn.execute("INSERT INTO meta VALUES ('gateway', 'worker-1')")
     conn.execute("INSERT INTO meta VALUES ('last_ok', ?)", (str(time.time() - 2),))
     conn.commit()
diff --git a/tests/tools/test_kanban_worker_review_origin.py b/tests/tools/test_kanban_worker_review_origin.py
index 33cb4852a38679c6ecb8044135e2c9d97f4da040..ae0946c72134d54f2bb3a1bd9620a2b75f868a99 100644
--- a/tests/tools/test_kanban_worker_review_origin.py
+++ b/tests/tools/test_kanban_worker_review_origin.py
@@ -4,6 +4,7 @@
 import pytest
 
 from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db as kb
 from hermes_cli import kanban_placement as kp
 from hermes_cli import kanban_placement_provenance as provenance
 from tests.tools import test_kanban_cross_board_creator_chats as helpers
@@ -32,6 +33,16 @@
     if worker != 'none':
         monkeypatch.setenv('HERMES_KANBAN_TASK', creator)
     if worker == 'bound':
+        # Authority now reserves under the actual live creator run before the
+        # courier seam. A string-only authority fake is not a bound run.
+        with kbc.connect_closing() as conn:
+            # Pickup's authoritative ready snapshot has already satisfied the
+            # foreign ancestor; its dependency edge is not copied locally.
+            conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (creator,))
+            conn.commit()
+            assert kb.claim_task(conn, creator) is not None
+            conn.execute('UPDATE task_runs SET uid=? WHERE task_id=?', ('authenticated-run', creator))
+            conn.commit()
         monkeypatch.setattr(provenance, 'forwarding_authority', lambda *a, **k: {
             'creator': {'gateway': 'macbook', 'profile': 'default', 'board': 'default', 'task_id': creator},
             'run_uid': 'authenticated-run'})
