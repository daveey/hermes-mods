From ba7743dd6e2f97b5e787c5f75602cc1749509fe0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 12:23:09 +0000
Subject: [PATCH] [daveey] fix(kanban): unchecked-worktree cause says "gave no
 usable answer", not "no answer"

PR #2126 review nit (t_01a1d4bf9a0927af, card t_01a1d4c6f0f6f6f8). When
noninteractive_repo_git_env returns None under a git budget, _worktree_is_dirty
and worktree_archive._env raise GitUnchecked("git config probe gave no answer").
But None also covers answers the probe got and refused: a non-file include
origin, a FIFO/directory include target, too many include targets or filter
keys. The cause text was wrong for those.

Fix: one shared cause, git_budget.NO_FILTER_ENV = "git filter discovery gave
no usable answer", used at both raise sites; docstrings say "no usable answer".
Wording only: the tree still reads "unchecked worktree <p> (<cause>)" (fail
safe), and unbudgeted callers keep their dirty/ArchiveError verdicts.

Proof: new test_a_refused_filter_discovery_answer_reads_unchecked_with_an_accurate_cause
gives a real tree 257 filter keys (git answers rc 0, discovery refuses).
RED on origin/main 27740f5def: tree_state read "... (git config probe gave no
answer)". GREEN with the fix; all 6 test files importing the touched modules:
122 passed. No test asserted the old string.
---
 hermes_cli/git_budget.py                          |  5 ++++-
 hermes_cli/worktree_archive.py                    |  4 ++--
 hermes_cli/worktree_ops.py                        |  6 +++---
 tests/hermes_cli/test_kanban_move_guard_budget.py | 13 +++++++++++++
 4 files changed, 22 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/git_budget.py b/hermes_cli/git_budget.py
index 2c68a05ffc..699c6678a4 100644
--- a/hermes_cli/git_budget.py
+++ b/hermes_cli/git_budget.py
@@ -7,7 +7,7 @@ returns the timeout that call may use (the cap, or less when the deadline is nea
 the deadline, whatever their number.
 
 With a budget, a helper reports a check it could not finish (time spent, git timed out, a hardening probe that
-gave no answer) by raising :class:`GitUnchecked` instead of turning it into a verdict ("dirty", "unpushed"): the
+gave no usable answer) by raising :class:`GitUnchecked` instead of turning it into a verdict ("dirty", "unpushed"): the
 caller then says the tree is unchecked, which it still treats as state (fail safe). Without one, helpers keep
 their own fail-safe verdicts.
 """
@@ -20,6 +20,9 @@ GitBudget = Callable[[float], float]
 
 BUDGET_SPENT = "git budget spent"
 GIT_TIMED_OUT = "git timed out"
+# noninteractive_repo_git_env returned None: its probe gave no answer, or an answer it refuses (non-file include
+# origin, FIFO/directory include target, too many include targets or filter keys). No hardened env, no verdict.
+NO_FILTER_ENV = "git filter discovery gave no usable answer"
 
 
 class GitUnchecked(Exception):
diff --git a/hermes_cli/worktree_archive.py b/hermes_cli/worktree_archive.py
index c8f2e1f13d..dedc38e979 100644
--- a/hermes_cli/worktree_archive.py
+++ b/hermes_cli/worktree_archive.py
@@ -62,9 +62,9 @@ def _env(cwd, index: Optional[str] = None, *, budget=None) -> dict:
     env = noninteractive_repo_git_env(cwd, budget=budget)
     if env is None:
         if budget is not None:  # a budgeted scan reports the tree unchecked (hermes_cli.git_budget)
-            from hermes_cli.git_budget import GitUnchecked, ensure_left
+            from hermes_cli.git_budget import NO_FILTER_ENV, GitUnchecked, ensure_left
             ensure_left(budget)
-            raise GitUnchecked("git config probe gave no answer")
+            raise GitUnchecked(NO_FILTER_ENV)
         raise ArchiveError("git filter discovery failed")
     env.update(_IDENTITY)
     start = int(env["GIT_CONFIG_COUNT"])
diff --git a/hermes_cli/worktree_ops.py b/hermes_cli/worktree_ops.py
index d2e9818f95..010605a0bf 100644
--- a/hermes_cli/worktree_ops.py
+++ b/hermes_cli/worktree_ops.py
@@ -541,17 +541,17 @@ def _worktree_is_dirty(worktree_path: str, repo_root, timeout: float = 10, *, bu
 
     With ``budget`` (:mod:`hermes_cli.git_budget`) every git call, the hardening probes and the
     hidden-edit scan included, draws its timeout from it; a spent budget, a git timeout or a probe
-    with no answer raises ``GitUnchecked`` instead of reading as dirty.
+    with no usable answer raises ``GitUnchecked`` instead of reading as dirty.
     """
     from hermes_cli._subprocess_compat import noninteractive_repo_git_env
-    from hermes_cli.git_budget import GitUnchecked, ensure_left, timed_out, timeout_for
+    from hermes_cli.git_budget import NO_FILTER_ENV, GitUnchecked, ensure_left, timed_out, timeout_for
     try:
         # Reclaimers run this unattended; status reads the index (core.fsmonitor, clean filters).
         env = noninteractive_repo_git_env(worktree_path, budget=budget)
         if env is None:
             if budget is not None:
                 ensure_left(budget)
-                raise GitUnchecked("git config probe gave no answer")
+                raise GitUnchecked(NO_FILTER_ENV)
             return True
         result = _git(["status", "--porcelain", "-z", "--untracked-files=normal"], worktree_path,
                       timeout=timeout_for(budget, timeout), stdin=subprocess.DEVNULL, env=env)
diff --git a/tests/hermes_cli/test_kanban_move_guard_budget.py b/tests/hermes_cli/test_kanban_move_guard_budget.py
index ffe6e3d2bb..7790e529da 100644
--- a/tests/hermes_cli/test_kanban_move_guard_budget.py
+++ b/tests/hermes_cli/test_kanban_move_guard_budget.py
@@ -121,6 +121,19 @@ def test_a_git_status_timeout_reads_unchecked_not_dirty(tmp_path, monkeypatch):
     assert worktree_ops._worktree_is_dirty(str(tree), str(tree)) is True  # unbudgeted callers keep failing safe
 
 
+def test_a_refused_filter_discovery_answer_reads_unchecked_with_an_accurate_cause(tmp_path):
+    # git answers the config probe, but with more filter keys than discovery accepts: an answer it refuses,
+    # not "no answer". The cause names both cases; the tree still reads unchecked, never clean.
+    tree = _clean_pushed_tree(tmp_path, "refused-answer")
+    path = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-path", "config"], cwd=tree,
+                          check=True, capture_output=True, text=True).stdout.strip()
+    with open(path, "a") as fh:
+        fh.writelines(f'[filter "f{i}"]\n\tclean = cat\n' for i in range(_subprocess_compat._MAX_FILTER_KEYS + 1))
+    assert _subprocess_compat.noninteractive_repo_git_env(str(tree)) is None  # refused, though git answered rc 0
+    assert kmp.tree_state([str(tree)]) == f"unchecked worktree {tree} (git filter discovery gave no usable answer)"
+    assert worktree_ops._worktree_is_dirty(str(tree), str(tree)) is True  # unbudgeted callers keep failing safe
+
+
 def test_unbudgeted_unpushed_check_still_fails_safe_on_a_timeout(tmp_path, monkeypatch):
     tree = _clean_pushed_tree(tmp_path, "unbudgeted")
 
-- 
