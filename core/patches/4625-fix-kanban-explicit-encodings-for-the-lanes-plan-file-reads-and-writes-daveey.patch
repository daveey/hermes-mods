From 5ab02264d8aff623bb9d31d6b1d655010461485a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 14:23:38 -0800
Subject: [PATCH] fix(kanban): explicit encodings for the lanes plan file reads
 and writes [daveey]

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 hermes_cli/kanban_lanes_cli.py  | 2 +-
 hermes_cli/kanban_lanes_plan.py | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_lanes_cli.py b/hermes_cli/kanban_lanes_cli.py
index f8e22c203ec94004143f41d4f9717286f0eb7e7d..fd8acc6ff6f136f6a6596b05be2c44b94f7c86cb 100644
--- a/hermes_cli/kanban_lanes_cli.py
+++ b/hermes_cli/kanban_lanes_cli.py
@@ -158,7 +158,7 @@ def _set(args) -> int:
 def _apply(args) -> int:
     from hermes_cli import kanban_lanes_plan as plan
 
-    raw = sys.stdin.read() if args.file == "-" else open(args.file, encoding="utf-8").read()
+    raw = sys.stdin.read() if args.file == "-" else open(args.file, encoding="utf-8-sig").read()
     with kbc.connect_closing() as conn:
         result = plan.apply(conn, json.loads(raw), dry_run=args.dry_run)
     if not args.dry_run:
diff --git a/hermes_cli/kanban_lanes_plan.py b/hermes_cli/kanban_lanes_plan.py
index bcdb9c01951abb9bbb7d394acac7aa72d76f5baa..a4ec5e2bccea945d109cc4250fa2f7365fef7371 100644
--- a/hermes_cli/kanban_lanes_plan.py
+++ b/hermes_cli/kanban_lanes_plan.py
@@ -183,12 +183,12 @@ def save_notes(result: dict, *, now: Optional[float] = None) -> None:
     doc = {"at": int(time.time() if now is None else now), "notes": result["notes"],
            "applied": len(result["applied"]), "rejected": len(result["rejected"])}
     tmp = path.with_suffix(".tmp")
-    tmp.write_text(json.dumps(doc))
+    tmp.write_text(json.dumps(doc), encoding="utf-8")
     tmp.replace(path)
 
 
 def read_notes() -> Optional[dict]:
     try:
-        return json.loads(notes_path().read_text())
+        return json.loads(notes_path().read_text(encoding="utf-8-sig"))
     except (OSError, ValueError):
         return None
-- 
