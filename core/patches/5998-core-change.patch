Subject: [PATCH 5998] Kanban wake notices, ready-entry registry and external-park display

Public mirror of source commit 279cea0c57c0d175dc3cbea40420d168da705cbc.

---
diff --git a/hermes_cli/kanban_wake_unproven.py b/hermes_cli/kanban_wake_unproven.py
index 3dbb1d4e27a..e72a2ff6dfd 100644
--- a/hermes_cli/kanban_wake_unproven.py
+++ b/hermes_cli/kanban_wake_unproven.py
@@ -7,8 +7,9 @@
 24 h away, the card's origin chat gets ONE passive ``wake_probe_unproven_notice`` naming the probe and its
 last output. Probe semantics, backstops and admission are untouched; the card stays scheduled.
 
-One notice per park episode: a later park event (re-park) opens a new episode. Clock-only waits run no probe,
-so they never reach this.
+One notice per task/backstop: re-parking with the same ``wake_at`` does not open a new notice episode,
+even if probe custody changes the command. A new backstop allows another notice after the new park's
+checks age. Clock-only waits run no probe, so they never reach this.
 """
 from __future__ import annotations
 
@@ -64,11 +65,12 @@
     if wake_at - now <= FAR_BACKSTOP_SECONDS:
         return False
     limit = notice_seconds() if threshold is None else threshold
-    since = max(first_at, parked_at)  # a re-park opens a new episode and restarts the age
+    since = max(first_at, parked_at)  # a re-park restarts check age, not same-backstop notice eligibility
     if now - since < limit:
         return False
-    if conn.execute("SELECT 1 FROM task_events WHERE task_id = ? AND kind = ? AND id > ?",
-                    (task_id, NOTICE_KIND, park_id)).fetchone():
+    if conn.execute("SELECT 1 FROM task_events WHERE task_id = ? AND kind = ? "
+                    "AND (id > ? OR json_extract(payload, '$.wake_at') = ?)",
+                    (task_id, NOTICE_KIND, park_id, wake_at)).fetchone():
         return False
     kb._append_event(conn, task_id, NOTICE_KIND, {
         "wake_check": cmd, "output": (out or "")[-500:], "checks": checks, "hours": round((now - since) / 3600, 1),
diff --git a/tests/hermes_cli/test_kanban_wake_unproven.py b/tests/hermes_cli/test_kanban_wake_unproven.py
index e14234283ad..59f63db6b0c 100644
--- a/tests/hermes_cli/test_kanban_wake_unproven.py
+++ b/tests/hermes_cli/test_kanban_wake_unproven.py
@@ -96,6 +96,34 @@
     assert len(notices(conn, tid)) == 2
 
 
+@pytest.mark.parametrize("same_backstop, probe", [
+    (True, PROBE),
+    (False, PROBE),
+    (True, "python3 moved_run6_ready.py"),
+], ids=["same-backstop", "new-backstop", "same-backstop-new-probe"])
+def test_repark_notice_is_deduplicated_by_backstop(parked, same_backstop, probe):
+    conn, tid, clock = parked
+    for hour in (0, 3, 6):
+        result(parked, hour)
+    first = notices(conn, tid)
+    assert len(first) == 1
+    wake_at = first[0].payload["wake_at"]
+    clock[0] += 9 * HOUR
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+    assert kb.claim_task(conn, tid, claimer="worker")
+    next_wake_at = wake_at if same_backstop else wake_at + HOUR
+    until = datetime.fromtimestamp(next_wake_at, UTC).isoformat()
+    assert kb.schedule_task(conn, tid, reason=f"waiting SCHEDULED_UNTIL={until}", wake_check=probe)
+    assert wc.get_state(conn, tid)["cmd"] == probe
+    assert unproven._latest_park(conn, tid)[2] == next_wake_at
+    for hour in (0, 3, 6, 12):
+        result(parked, hour)
+    found = notices(conn, tid)
+    assert len(found) == (1 if same_backstop else 2)
+    assert found[-1].payload["wake_at"] == next_wake_at
+
+
 def test_clock_only_wait_never_notifies(kanban_home, monkeypatch):
     clock = [int(time.time())]
     monkeypatch.setattr(time, "time", lambda: clock[0])
