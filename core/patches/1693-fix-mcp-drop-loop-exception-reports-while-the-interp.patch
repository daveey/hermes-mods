From b345d3609b62567f9753268139dfec0790c3845a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 13:23:32 +0000
Subject: [PATCH] fix(mcp): drop loop exception reports while the interpreter
 finalizes [daveey]

Managed workers exiting cleanly left MCP tasks pending; asyncio's 'Task was destroyed but it is pending!'
reports reached _mcp_loop_exception_handler after sys.meta_path was gone, so logging each one printed a
'--- Logging error ---' traceback to managed-worker.log. The coach crash detector read those as an
'Arguments: ()' crash storm (kanban-96867340ba). Return early when sys.is_finalizing().
---
 tests/tools/test_mcp_stability.py | 12 ++++++++++++
 tools/mcp_tool_loop.py            |  7 ++++++-
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/tests/tools/test_mcp_stability.py b/tests/tools/test_mcp_stability.py
index beb8fe15e9c..85e409d5e11 100644
--- a/tests/tools/test_mcp_stability.py
+++ b/tests/tools/test_mcp_stability.py
@@ -25,6 +25,18 @@ class TestMCPLoopExceptionHandler:
         _mcp_loop_exception_handler(loop, context)
         loop.default_exception_handler.assert_not_called()
 
+    def test_drops_reports_while_interpreter_finalizes(self):
+        """Pending-task reports at interpreter shutdown are dropped: logging them then prints a
+        '--- Logging error ---' traceback to the worker's stderr (kanban-96867340ba)."""
+        from tools.mcp_tool_loop import _mcp_loop_exception_handler
+        loop = MagicMock()
+        context = {"message": "Task was destroyed but it is pending!", "task": MagicMock()}
+        with patch("sys.is_finalizing", return_value=True):
+            _mcp_loop_exception_handler(loop, context)
+        loop.default_exception_handler.assert_not_called()
+        _mcp_loop_exception_handler(loop, context)
+        loop.default_exception_handler.assert_called_once_with(context)
+
 
     def test_probe_cleanup_does_not_stop_loop_with_registered_servers(self):
         """Probe cleanup must not kill the shared loop used by live MCP tools."""
diff --git a/tools/mcp_tool_loop.py b/tools/mcp_tool_loop.py
index ebe6730cf5b..11a863506e0 100644
--- a/tools/mcp_tool_loop.py
+++ b/tools/mcp_tool_loop.py
@@ -11,6 +11,7 @@ import contextlib
 import errno
 import logging
 import os
+import sys
 import threading
 import time
 from typing import Any, Coroutine, Optional
@@ -94,7 +95,11 @@ def _try_acquire_mcp_discovery_lock() -> Any:
 
 def _mcp_loop_exception_handler(loop, context):
     """Suppress the benign 'Event loop is closed' RuntimeError httpx finalizers raise against the
-    dead loop during shutdown; forward the rest."""
+    dead loop during shutdown; forward the rest. While the interpreter finalizes, drop everything: the
+    'Task was destroyed but it is pending!' reports for MCP tasks still alive at exit can no longer be logged
+    (each one prints a ``--- Logging error ---`` traceback to stderr, which crash detectors misread)."""
+    if sys.is_finalizing():
+        return
     exc = context.get("exception")
     if not (isinstance(exc, RuntimeError) and "Event loop is closed" in str(exc)):
         loop.default_exception_handler(context)
