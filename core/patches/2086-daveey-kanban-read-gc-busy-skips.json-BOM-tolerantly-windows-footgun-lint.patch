Subject: [PATCH] [daveey] kanban: read gc-busy-skips.json BOM-tolerantly
 (windows-footgun lint)

---
 hermes_cli/kanban_worktree_gc.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_worktree_gc.py b/hermes_cli/kanban_worktree_gc.py
index b1bd71e22e7..1e603b6906d 100644
--- a/hermes_cli/kanban_worktree_gc.py
+++ b/hermes_cli/kanban_worktree_gc.py
@@ -349,7 +349,7 @@ def _note_busy_skip(board: Path, *, cleared: bool = False) -> None:
     from hermes_cli import kanban_db as kb
     state_file = kb.kanban_home() / "gc-busy-skips.json"
     try:
-        state = json.loads(state_file.read_text(encoding="utf-8"))
+        state = json.loads(state_file.read_text(encoding="utf-8-sig"))
         if not isinstance(state, dict):
             state = {}
     except (OSError, ValueError):
