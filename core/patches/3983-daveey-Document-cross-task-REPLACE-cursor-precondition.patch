From a0d80ee320569e6085915506ccdb3752d3caf452 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 23:05:24 +0000
Subject: [PATCH] [daveey] Document cross-task REPLACE cursor precondition

Choose the explicitly permitted documentation minimum for t_01a1d70e4b15a1e2 / PR #2660 review 5898003274. REPLACE may silently delete another task row when recursive_triggers is off. State that coverage checks cannot detect that miss, recommend ON CONFLICT DO UPDATE, and do not alter sync delete/tombstone semantics.

Proof: cursor and revision modules were byte-identical to #2660 head b7dbbe449c875f1efb1d6b60adbca48fb34d703e before the edit. New contract test RED on missing documentation (1 failed, 1 passed), then GREEN with independent reader/writer SQLite counterexample and safe-upsert control. Both cursor files: 36 passed. scripts/check --base origin/main: 20 checks OK. This documents, but does not fix, unsupported REPLACE behavior.
---
 hermes_cli/kanban_task_change.py              | 13 ++++-
 ...est_kanban_task_change_replace_contract.py | 53 +++++++++++++++++++
 2 files changed, 65 insertions(+), 1 deletion(-)
 create mode 100644 tests/hermes_cli/test_kanban_task_change_replace_contract.py

diff --git a/hermes_cli/kanban_task_change.py b/hermes_cli/kanban_task_change.py
index fb9f71d8e2..9a68e83e16 100644
--- a/hermes_cli/kanban_task_change.py
+++ b/hermes_cli/kanban_task_change.py
@@ -6,7 +6,18 @@ the rev index, at a cost that does not grow with the board, so a reader that kee
 those tasks. A task id whose row is gone was deleted. Bookkeeping writes (claims, leases, heartbeats) do not mark: they
 do not bump the revision either (``BOOKKEEPING_COLUMNS``, ``UNREAD_EVENT_KINDS``).
 
-A cursor is trusted only when all of these hold in the reader's snapshot; otherwise the answer is ``FULL``:
+Writer precondition: do not use ``INSERT OR REPLACE`` (including SQLite's ``REPLACE INTO`` shorthand) on watched
+rows when a conflict can delete a row belonging to another task. With ``recursive_triggers`` off, SQLite silently
+deletes the conflicting row without firing its DELETE trigger. For example, replacing task a's comment uid with
+a comment for task b marks only b, although a lost a comment. The checks below do NOT detect that missing task and
+do NOT force ``FULL``. The same-task replacement test does not establish safety for a cross-task unique-key conflict.
+Use an ``ON CONFLICT DO UPDATE`` upsert instead: its UPDATE trigger marks both OLD and NEW task keys. A writer that
+must use REPLACE needs separately verified delete-trigger coverage or explicit full invalidation; a reader's pragma
+cannot enable another connection's delete triggers. Enabling recursive triggers globally also changes sync
+DELETE-trigger/outbox/tombstone behavior and is not part of this cursor's contract.
+
+Subject to that writer precondition, a cursor is trusted only when all of these hold in the reader's snapshot;
+otherwise the answer is ``FULL``:
 
 - the file carries every trigger of epoch >= 2 for the tables it watches, and the change table (``_covered``);
 - (a) ``MAX(kanban_task_change.rev) == kanban_activity_revision.revision``. An older writer's init replaces our
diff --git a/tests/hermes_cli/test_kanban_task_change_replace_contract.py b/tests/hermes_cli/test_kanban_task_change_replace_contract.py
new file mode 100644
index 0000000000..950b812fcf
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_task_change_replace_contract.py
@@ -0,0 +1,53 @@
+"""Keep the cursor's REPLACE limitation explicit and reproducible. [daveey]"""
+
+import sqlite3
+from contextlib import closing
+
+from hermes_cli import kanban_activity_revision as rev
+from hermes_cli import kanban_task_change as tc
+
+
+def test_cross_task_replace_limit_is_documented_and_reproduced(tmp_path):
+    # A reader cannot inspect the pragma of a different writer connection.
+    # This is a documented unsupported write, not a claim that REPLACE is safe.
+    assert tc.__doc__ is not None
+    assert "INSERT OR REPLACE" in tc.__doc__
+    assert "recursive_triggers" in tc.__doc__
+    assert "ON CONFLICT DO UPDATE" in tc.__doc__
+    path = tmp_path / "board.db"
+    with closing(sqlite3.connect(path)) as writer, writer:
+        writer.execute("PRAGMA recursive_triggers=OFF")
+        writer.execute("CREATE TABLE task_comments (task_id TEXT, body TEXT, uid TEXT UNIQUE)")
+        rev.ensure_revision(writer, ("task_comments",))
+        writer.execute("INSERT INTO task_comments VALUES ('a', 'original', 'u1')")
+    with closing(sqlite3.connect(path)) as reader, closing(sqlite3.connect(path)) as writer:
+        writer.execute("PRAGMA recursive_triggers=OFF")
+        _, cursor = tc.changed_since(reader, None, tables=("task_comments",))
+        assert cursor is not None
+        writer.execute("INSERT OR REPLACE INTO task_comments VALUES ('b', 'replacement', 'u1')")
+        writer.commit()
+        assert reader.execute("SELECT task_id FROM task_comments").fetchall() == [("b",)]
+        # The hidden delete is not represented, and the trust checks do not return FULL.
+        changed, _ = tc.changed_since(reader, cursor, tables=("task_comments",))
+        assert changed == {"b"}
+
+
+def test_upsert_moving_a_unique_key_between_tasks_marks_both(tmp_path):
+    path = tmp_path / "board.db"
+    with closing(sqlite3.connect(path)) as writer, writer:
+        writer.execute("PRAGMA recursive_triggers=OFF")
+        writer.execute("CREATE TABLE task_comments (task_id TEXT, body TEXT, uid TEXT UNIQUE)")
+        rev.ensure_revision(writer, ("task_comments",))
+        writer.execute("INSERT INTO task_comments VALUES ('a', 'original', 'u1')")
+    with closing(sqlite3.connect(path)) as reader, closing(sqlite3.connect(path)) as writer:
+        writer.execute("PRAGMA recursive_triggers=OFF")
+        _, cursor = tc.changed_since(reader, None, tables=("task_comments",))
+        assert cursor is not None
+        writer.execute(
+            "INSERT INTO task_comments VALUES ('b', 'replacement', 'u1') "
+            "ON CONFLICT(uid) DO UPDATE SET task_id=excluded.task_id, body=excluded.body"
+        )
+        writer.commit()
+        assert reader.execute("SELECT task_id FROM task_comments").fetchall() == [("b",)]
+        changed, _ = tc.changed_since(reader, cursor, tables=("task_comments",))
+        assert changed == {"a", "b"}
