From 00ee72e37c4f9693c6e3c96be0f222775672504a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 07:07:14 +0000
Subject: [PATCH] [daveey] core-update pause: document first-request pause
 follow-ups from #1883 review (t_01a1d351f76f9239)

Review 5886488676 on PR #1883 left non-blocking points, answered here without a behavior change:
- model_request_in_flight: a continuation's first request is tracked (first_request_can_pause), not only
  requests at a step boundary.
- run_conversation's pause_before_turn early return skips the boundary export / user_intervened /
  context_usage stamping; the transcript is unchanged.
- update_pause: a continuation's pre-turn and pre-first-request pauses make no progress but count toward
  MAX_PAUSES; after three windows released without an apply the turn parks (drain_retry_pending, at most
  PARK_MAX_S) without a step. Kept as is: that bound is what stops a window that cannot apply from re-running
  the same request.
- test_update_pause_first_request: the other-turn cases assert a literal False (vs unset) before and after.
---
 agent/conversation_loop.py                           | 2 +-
 agent/update_pause_cancel.py                         | 3 ++-
 tests/tui_gateway/test_update_pause_first_request.py | 4 +++-
 tui_gateway/update_pause.py                          | 4 ++++
 4 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/agent/conversation_loop.py b/agent/conversation_loop.py
index 48c299674c..0426687f2b 100644
--- a/agent/conversation_loop.py
+++ b/agent/conversation_loop.py
@@ -1845,7 +1845,7 @@ def run_conversation(
     # Per-provider-response context accounting starts empty every turn (agent/context_usage.py).
     begin_turn_context_usage(agent)
     if (paused := pause_before_turn(agent, conversation_history)) is not None:  # [daveey] t_01a1d31bf400d56c
-        return paused  # a continuation dispatched under a pending core-update pause never starts
+        return paused  # never started: skips the boundary/user_intervened/context_usage stamping, transcript unchanged
     # Images attached natively to this user turn stay visible to vision_analyze for the turn, so
     # it does not embed the same pixels a second time into the same request (#76411).
     with native_turn_images(user_message):
diff --git a/agent/update_pause_cancel.py b/agent/update_pause_cancel.py
index 96e58a5573..0291fb7efa 100644
--- a/agent/update_pause_cancel.py
+++ b/agent/update_pause_cancel.py
@@ -150,7 +150,8 @@ def model_request_in_flight(agent: Any, messages: Any, *, api_call_count: int) -
     """[daveey] t_01a1d293248f5e12: a model request at a step boundary is in flight like a tool call, so the
     watcher's cancel reaches it after the same grace. Without this a long request (169 s on the hub) held the
     turn's admission reservation unpublished past the instant update's cap: a pause lands only at a step boundary.
-    The turn's first request (no tool result yet) is not tracked: there is no boundary to pause at."""
+    A turn's first request (no tool result yet) is tracked only for a continuation (``first_request_can_pause``):
+    its refunded iteration pauses before any request. Any other turn has no boundary to pause at there."""
     tracked = model_request_can_yield(messages, api_call_count=api_call_count,
                                       first_request_ok=first_request_can_pause(agent))
     if tracked:
diff --git a/tests/tui_gateway/test_update_pause_first_request.py b/tests/tui_gateway/test_update_pause_first_request.py
index c8669f580a..62593fb101 100644
--- a/tests/tui_gateway/test_update_pause_first_request.py
+++ b/tests/tui_gateway/test_update_pause_first_request.py
@@ -56,5 +56,7 @@ def test_a_continuation_turn_may_yield_before_its_first_request(home):
 
 @pytest.mark.parametrize("kind", [None, "kanban_notice", "process_complete"])
 def test_any_other_turn_waits_for_a_real_step_boundary(home, kind):
-    seen, _agent = _submit(home, display_kind=kind)
+    seen, agent = _submit(home, display_kind=kind)
+    assert seen[0][0] is False  # set to a literal False, not left unset (None)
     assert seen == [(False, True)]
+    assert agent.update_pause_first_request is False
diff --git a/tui_gateway/update_pause.py b/tui_gateway/update_pause.py
index 1ee05e20f0..b6e886f936 100644
--- a/tui_gateway/update_pause.py
+++ b/tui_gateway/update_pause.py
@@ -10,6 +10,10 @@ so the update applies. The next backend's startup sweep continues the turn with
 crash-resume attempt is used. After ``MAX_PAUSES`` checkpoints, a failed window no longer restarts
 the turn while its drainer holds ``cache/core-update/drain.lock``: it stays idle for the next window.
 The threshold bounds no-progress continuations, never the checkpoint needed to let the update apply.
+A continuation's pre-turn and pre-first-request pauses (t_01a1d31bf400d56c) make no progress yet count toward
+``MAX_PAUSES`` like any other: after three windows released without an apply the turn parks between windows
+(``drain_retry_pending``, at most ``PARK_MAX_S``) without having taken a step. That is the intended bound: a
+window that cannot apply should not keep re-running the same request.
 
 A turn the next backend would not auto-continue is never paused. A paused turn whose window ends without
 an update (expired, apply refused) continues in place (``start_in_place_watcher``), unless its pause
