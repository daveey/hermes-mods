From 7e0d8f321aa657580a2f4289efaf844b893bf37a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 22:20:05 +0000
Subject: [PATCH] test(pty): consume the full output frame before asserting
 idle [daveey]

---
 tests/tools/test_drain_high_fd.py | 24 ++++++++++++++++++------
 1 file changed, 18 insertions(+), 6 deletions(-)

diff --git a/tests/tools/test_drain_high_fd.py b/tests/tools/test_drain_high_fd.py
index d235cf1a32f..1dba1ddefe1 100644
--- a/tests/tools/test_drain_high_fd.py
+++ b/tests/tools/test_drain_high_fd.py
@@ -88,7 +88,8 @@ def _assert_idle_read_waits(bridge):
 
 
 @pytest.mark.platforms("posix")
-def test_pty_bridge_reads_and_waits_above_fd_setsize(high_fds, monkeypatch):
+@pytest.mark.parametrize("read_size", [65536, 1], ids=["normal", "fragmented"])
+def test_pty_bridge_reads_and_waits_above_fd_setsize(high_fds, monkeypatch, read_size):
     """The PTY bridge delivers output at a high fd and an idle read blocks for its timeout;
     when the selector cannot be created (EMFILE), the bridge either still waits (poll
     fallback) or refuses to spawn, never a busy-looping bridge (macOS poll on a PTY)."""
@@ -98,18 +99,29 @@ def test_pty_bridge_reads_and_waits_above_fd_setsize(high_fds, monkeypatch):
     from hermes_cli.pty_bridge import PtyBridge
     from tools.environments import fd_wait
 
-    bridge = PtyBridge.spawn(["/bin/sh", "-c", "echo pty-high-fd; exec sleep 30"])
+    # Stay alive until teardown, even if the test is descheduled for a long time.
+    bridge = PtyBridge.spawn(["/bin/sh", "-c", "echo pty-high-fd; read -r reply"])
+    real_read = os.read
     try:
         assert bridge._fd >= 1024
+        # A PTY is a byte stream: exercise real reads with every byte split,
+        # including the line terminator after the payload.
+        def fragmented_read(fd, size):
+            return real_read(fd, min(size, read_size) if fd == bridge._fd else size)
+
+        monkeypatch.setattr(os, "read", fragmented_read)
         buf = bytearray()
-        deadline = time.monotonic() + 5
-        while b"pty-high-fd" not in buf and time.monotonic() < deadline:
+        expected = b"pty-high-fd\r\n"
+        deadline = time.monotonic() + 30
+        # Seeing the payload alone does not mean its trailing CRLF was read.
+        while expected not in buf and time.monotonic() < deadline:
             chunk = bridge.read(timeout=0.2)
             assert chunk is not None, f"PTY reported EOF before output (got {bytes(buf)!r})"
             buf.extend(chunk)
-        assert b"pty-high-fd" in buf
+        assert bytes(buf) == expected
         _assert_idle_read_waits(bridge)
     finally:
+        monkeypatch.setattr(os, "read", real_read)
         bridge.close()
 
     def _emfile():
@@ -117,7 +129,7 @@ def test_pty_bridge_reads_and_waits_above_fd_setsize(high_fds, monkeypatch):
 
     monkeypatch.setattr(fd_wait.selectors, "DefaultSelector", _emfile)
     try:
-        fallback = PtyBridge.spawn(["/bin/sh", "-c", "exec sleep 30"])
+        fallback = PtyBridge.spawn(["/bin/sh", "-c", "read -r reply"])
     except OSError:
         return  # no safe wait for this device on this OS: the spawn is refused
     try:
-- 
