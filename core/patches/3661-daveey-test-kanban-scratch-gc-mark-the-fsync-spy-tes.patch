From 9979b42a794a921d450937efe5acadcd5b49f829 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 16:09:50 +0000
Subject: [PATCH] [daveey] test(kanban scratch gc): mark the fsync-spy tests
 platforms("posix") so macOS CI runs _fd_path's F_GETPATH branch

PR #2347 fixed _fd_path (fcntl F_GETPATH on darwin, /proc on Linux) after
it broke on macOS, but the file still had no macOS-reaching platforms
marker: the macOS tests-os lane (-m "platforms and not integration", file
list from scripts/ci/list_os_marked_tests.py) never imported it, so the
darwin branch had no CI coverage and the next Linux-only helper here could
break macOS unseen.

Mark the two tests that call _fd_path (the bottom-up fsync ordering test
and all three params of the fsync-failure fail-closed test)
platforms("posix"): the Linux suite still runs them (posix covers linux),
and list_os_marked_tests.py now selects this file for the macOS lane.

The fail-closed test also passed vacuously with a broken _fd_path: the
helper's own OSError inside the fsync spy fails the archive closed just
like the injected EIO. It now asserts the injected fault actually fired.

Proof (mbp, Darwin 25.6.0, lane selector): with _fd_path reverted to
os.readlink(f"/proc/self/fd/{fd}") the ordering test fails; before the
hits assertion the 3 fail-closed params still passed, after it they fail
too. Linux: full file passes.
---
 tests/hermes_cli/test_kanban_scratch_gc_archive.py | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_scratch_gc_archive.py b/tests/hermes_cli/test_kanban_scratch_gc_archive.py
index 2c10e9218c..3affda0702 100644
--- a/tests/hermes_cli/test_kanban_scratch_gc_archive.py
+++ b/tests/hermes_cli/test_kanban_scratch_gc_archive.py
@@ -752,6 +752,7 @@ def _real(path):
     return os.path.realpath(str(path))
 
 
+@pytest.mark.platforms("posix")  # macOS lane runs _fd_path's F_GETPATH branch
 def test_archive_fsyncs_all_artifacts_bottom_up_before_publication_and_detach(board, monkeypatch):
     from hermes_cli import kanban_scratch_archive as sa
 
@@ -834,23 +835,28 @@ def test_ancestor_fsync_failure_preserves_workspace(board, monkeypatch, ancestor
     assert not _archive(tid).exists()
 
 
+@pytest.mark.platforms("posix")  # macOS lane runs _fd_path's F_GETPATH branch
 @pytest.mark.parametrize("target", ["file", "directory", "publication_parent"])
 def test_fsync_failure_fails_closed_without_publication(board, monkeypatch, target):
     from hermes_cli import kanban_scratch_archive as sa
 
     tid, path = _plain_task(lambda p: None)
     real_fsync = os.fsync
+    hits = []
 
     def flaky(fd):
         link = _fd_path(fd)
         hit = {"file": link.endswith("manifest.json"), "directory": link.endswith(sa.PAYLOAD_DIR),
                "publication_parent": link == _real(_archive(tid).parent)}[target]
         if hit:
+            hits.append(link)
             raise OSError(5, "EIO")
         return real_fsync(fd)
 
     monkeypatch.setattr(os, "fsync", flaky)
     assert _gc() == 0
+    # The injected EIO, not a broken _fd_path (whose own OSError also fails closed), stopped the archive.
+    assert hits
     assert (path / "notes.txt").read_text() == "scratch"
     parent = _archive(tid).parent
     assert not parent.exists() or list(parent.iterdir()) == []
