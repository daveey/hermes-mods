From b1b10e7e5b3daa3e8e9e6b43da1d05269dccea09 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 00:22:08 +0000
Subject: [PATCH] [daveey] kanban restart resume: code-health fixes (narrow
 catch, kanban_db size, fallback table)

---
 gateway/session_kanban_resume.py              |  7 +-
 hermes_cli/kanban_db.py                       | 15 ++---
 .../test_session_kanban_restart_resume.py     | 67 ++++++++++---------
 3 files changed, 43 insertions(+), 46 deletions(-)

diff --git a/gateway/session_kanban_resume.py b/gateway/session_kanban_resume.py
index 759fcb0441a..5607cecdd88 100644
--- a/gateway/session_kanban_resume.py
+++ b/gateway/session_kanban_resume.py
@@ -180,11 +180,8 @@ def compaction_threshold_tokens(policy) -> Optional[int]:
     settings = _parse_compression_config(probe, config)
     model_cfg = config.get('model') if isinstance(config, dict) else None
     ctx = model_cfg.get('context_length') if isinstance(model_cfg, dict) else None
-    try:
-        from hermes_cli.config import get_compatible_custom_providers
-        custom = get_compatible_custom_providers(config)
-    except Exception:
-        custom = None
+    from hermes_cli.config import get_compatible_custom_providers
+    custom = get_compatible_custom_providers(config) if isinstance(config, dict) else None
     compressor = ContextCompressor(
         model=model, threshold_percent=settings.threshold, quiet_mode=True, base_url=probe.base_url,
         config_context_length=ctx if isinstance(ctx, int) and ctx > 0 else None, provider=probe.provider,
diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index 3be9269be9a..f3ef13b7455 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -4013,12 +4013,10 @@ def delete_task(conn: sqlite3.Connection, task_id: str) -> bool:
 # --- Worker context builder (what a spawned worker sees) ---
 
 def build_worker_context(conn: sqlite3.Connection, task_id: str, *, recovery_tail: bool = True) -> str:
-    """Everything a worker should read about its task: header, body,
-    attachments, prior attempts, done-parent handoffs, the assignee's recent
-    work, comments. Lists are tail-capped and fields char-capped
-    (``_CTX_MAX_*``) so the prompt stays bounded on pathological boards.
-    ``recovery_tail=False`` omits the interrupted-run transcript tail: a run resumed
-    after an owner restart carries that run's whole conversation instead. [daveey]"""
+    """Everything a worker should read about its task: header, body, attachments, prior attempts,
+    done-parent handoffs, the assignee's recent work, comments. Lists are tail-capped and fields char-capped
+    (``_CTX_MAX_*``) so the prompt stays bounded. ``recovery_tail=False`` omits the transcript tail (a run
+    resumed after an owner restart carries the lost run's whole conversation instead). [daveey]"""
     task = get_task(conn, task_id)
     if not task:
         raise ValueError(f"unknown task {task_id}")
@@ -4050,11 +4048,8 @@ def build_worker_context(conn: sqlite3.Connection, task_id: str, *, recovery_tai
     _ctx_parent_results(lines, conn, task_id, now)
     _ctx_role_history(lines, conn, task, now)
     _ctx_comments(lines, list_comments(conn, task_id), now)
-    base = "\n".join(lines).rstrip() + "\n"
-    if not recovery_tail:
-        return base
     from hermes_cli.kanban_worker_recovery import build_recovery_context
-    return base + build_recovery_context(conn, task_id)
+    return "\n".join(lines).rstrip() + "\n" + (build_recovery_context(conn, task_id) if recovery_tail else "")
 
 
 def _ctx_standing(lines: list[str], task: Task, comments: list[Comment]) -> None:
diff --git a/tests/gateway/test_session_kanban_restart_resume.py b/tests/gateway/test_session_kanban_restart_resume.py
index 08341cbf16a..bbe02da3cae 100644
--- a/tests/gateway/test_session_kanban_restart_resume.py
+++ b/tests/gateway/test_session_kanban_restart_resume.py
@@ -189,48 +189,53 @@ def test_a_mid_tool_call_turn_gets_a_synthetic_interrupted_result(env):
     assert run.events['owner_admitted']['resumed_session_id'] == PRIOR
 
 
-@pytest.mark.parametrize('case', ['missing', 'empty', 'foreign_home', 'foreign_profile', 'unreadable', 'over_threshold'])
+def _broken_reader(env):
+    real = env.db.get_messages_as_conversation
+
+    def broken(sid, *a, **kw):
+        if sid == PRIOR:
+            raise ValueError('corrupt transcript')
+        return real(sid, *a, **kw)
+    env.monkeypatch.setattr(env.db, 'get_messages_as_conversation', broken)
+
+
+def _tiny_threshold(env):
+    env.monkeypatch.setattr('gateway.session_kanban_resume.compaction_threshold_tokens', lambda policy: 10)
+
+
+# case -> (prior session setup, owner_admitted db relative to the real one, extra patch, expected fallback,
+#          whether the transcript-tail reader still renders a tail for it)
+_FALLBACKS = {
+    'missing': (None, None, None, 'prior_session_missing', False),  # names a session absent from state.db
+    'empty': ({'messages': []}, None, None, 'prior_session_empty', False),
+    'foreign_home': ({}, 'other-home/state.db', None, 'foreign_home', False),
+    'foreign_profile': ({'profile': 'other'}, None, None, 'foreign_profile', False),
+    'unreadable': ({}, None, _broken_reader, 'prior_session_unreadable', True),
+    'over_threshold': ({}, None, _tiny_threshold, 'over_compaction_threshold', True),
+}
+
+
+@pytest.mark.parametrize('case', sorted(_FALLBACKS))
 def test_each_fallback_keeps_the_tail_only_fresh_session(env, case):
     from gateway.session_kanban_resume import worker_prompt_context
-    state_db = env.db.db_path
-    if case == 'missing':
-        pass  # owner_admitted names a session that is not in state.db
-    elif case == 'empty':
-        _prior_session(env.db, messages=[])
-    elif case == 'foreign_home':
-        _prior_session(env.db)
-        state_db = env.tmp / 'other-home' / 'state.db'
-    elif case == 'foreign_profile':
-        _prior_session(env.db, profile='other')
-    elif case == 'unreadable':
-        _prior_session(env.db)
-        real = env.db.get_messages_as_conversation
-
-        def broken(sid, *a, **kw):
-            if sid == PRIOR:
-                raise ValueError('corrupt transcript')
-            return real(sid, *a, **kw)
-        env.monkeypatch.setattr(env.db, 'get_messages_as_conversation', broken)
-    elif case == 'over_threshold':
-        _prior_session(env.db)
-        env.monkeypatch.setattr('gateway.session_kanban_resume.compaction_threshold_tokens', lambda policy: 10)
+    session, other_db, patch, expected, tail = _FALLBACKS[case]
+    if session is not None:
+        _prior_session(env.db, **session)
+    if patch is not None:
+        patch(env)
+    state_db = env.tmp / other_db if other_db else env.db.db_path
     tid = _task(env)
     _lose_run(tid, code=KANBAN_OWNER_RESTART_EXIT_CODE, state_db=state_db, monkeypatch=env.monkeypatch)
     run = _admit_next(env, tid)
-    expected = {'missing': 'prior_session_missing', 'empty': 'prior_session_empty', 'foreign_home': 'foreign_home',
-                'foreign_profile': 'foreign_profile', 'unreadable': 'prior_session_unreadable',
-                'over_threshold': 'over_compaction_threshold'}[case]
     assert run.events['restart_resume']['fallback'] == expected
     assert 'resumed_session_id' not in run.events['restart_resume']
     assert 'resumed_session_id' not in run.events['owner_admitted']
     assert run.history == []  # a fresh session
     assert 'resume_context' not in run.context
     prompt = worker_prompt_context(run.context, run.history)
-    if case in ('missing', 'empty', 'foreign_home', 'foreign_profile'):
-        # The tail reader applies its own checks; whatever it renders is today's context, unchanged.
-        assert prompt == run.context['context']
-    else:
-        assert 'Interrupted worker continuation' in prompt and 'Resumed after gateway restart' not in prompt
+    # Today's context, unchanged: the tail reader applies its own checks and renders a tail where it can.
+    assert prompt == run.context['context']
+    assert ('Interrupted worker continuation' in prompt) == tail and 'Resumed after gateway restart' not in prompt
 
 
 @pytest.mark.parametrize('kind', ['crash', 'timeout'])
-- 
