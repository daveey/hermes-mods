index 0000000000..135a725c56
--- /dev/null
+++ b/apps/desktop/src/test/archive-queue-locks.setup.ts
@@ -0,0 +1,10 @@
+import { afterEach, beforeEach, vi } from 'vitest'
+
+import { archiveQueueLocksFixture } from './web-locks'
+
+// Opt in only archive consumers. Global Web Locks also activates unrelated
+// prepared-submission custody paths whose tests deliberately model no Web Locks.
+beforeEach(() => {
+  vi.stubGlobal('navigator', { locks: archiveQueueLocksFixture().locks })
+})
+afterEach(() => vi.unstubAllGlobals())
diff --git a/apps/desktop/src/test/web-locks.test.ts b/apps/desktop/src/test/web-locks.test.ts
new file mode 100644
index 0000000000..c4478b4b00
--- /dev/null
+++ b/apps/desktop/src/test/web-locks.test.ts
@@ -0,0 +1,30 @@
+import { expect, it } from 'vitest'
+
+import { archiveQueueLocksFixture } from './web-locks'
+
+it('supports the two-argument request used by composer drains', async () => {
+  const { locks, held } = archiveQueueLocksFixture()
+  const request = locks as unknown as LockManager
+  expect(await request.request('composer', lock => lock?.name)).toBe('composer')
+  expect(held.size).toBe(0)
+})
+
+it('serializes blocking requests while nonblocking peers see a held lock', async () => {
+  const { locks, held } = archiveQueueLocksFixture()
+  const request = locks as unknown as LockManager
+  let release!: () => void
+  const order: string[] = []
+
+  const first = request.request('composer', async () => {
+    order.push('first')
+    await new Promise<void>(resolve => { release = resolve })
+  })
+
+  const second = request.request('composer', () => { order.push('second') })
+  expect(await request.request('composer', { ifAvailable: true }, lock => lock)).toBeNull()
+  expect(order).toEqual(['first'])
+  release()
+  await Promise.all([first, second])
+  expect(order).toEqual(['first', 'second'])
+  expect(held.size).toBe(0)
+})
diff --git a/apps/desktop/src/test/web-locks.ts b/apps/desktop/src/test/web-locks.ts
index 8b556b166d..f120e8c8c4 100644
--- a/apps/desktop/src/test/web-locks.ts
+++ b/apps/desktop/src/test/web-locks.ts
@@ -1,18 +1,35 @@
-// Shared origin-wide lock fixture; separate module instances/renderers see the
-// same manager, while a reload can release the old renderer's held callbacks.
+// Shared origin-wide exclusive lock fixture. Both request overloads are used
+// by renderer consumers; blocking requests queue instead of failing a peer.
 export function archiveQueueLocksFixture() {
   const held = new Set<string>()
+  const waiters = new Map<string, Array<() => void>>()
+  type Callback = (lock: Lock | null) => unknown
 
   const locks = {
-    request: async (name: string, options: LockOptions, callback: (lock: Lock | null) => unknown) => {
+    request: async (name: string, optionsOrCallback: LockOptions | Callback, callback?: Callback) => {
+      const options = typeof optionsOrCallback === 'function' ? {} : optionsOrCallback
+      const run = typeof optionsOrCallback === 'function' ? optionsOrCallback : callback!
+
       if (held.has(name)) {
-        if (options.ifAvailable) {return callback(null)}
-        throw new Error('duplicate fixture lock')
+        if (options.ifAvailable) {return run(null)}
+        await new Promise<void>(resolve => {
+          const queue = waiters.get(name) ?? []
+          queue.push(resolve)
+          waiters.set(name, queue)
+        })
+      } else {
+        held.add(name)
       }
 
-      held.add(name)
+      try {return await run({ name, mode: 'exclusive' } as Lock)} finally {
+        const queue = waiters.get(name)
+        const next = queue?.shift()
 
-      try {return await callback({ name, mode: 'exclusive' } as Lock)} finally {held.delete(name)}
+        if (next) {next()} else {
+          held.delete(name)
+          waiters.delete(name)
+        }
+      }
     }
   }
 
