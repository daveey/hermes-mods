diff --git a/tests/hermes_cli/test_kanban_edit_requires.py b/tests/hermes_cli/test_kanban_edit_requires.py
index b16c0ec53f..92e6e4513d 100644
--- a/tests/hermes_cli/test_kanban_edit_requires.py
+++ b/tests/hermes_cli/test_kanban_edit_requires.py
@@ -69,3 +69,36 @@ def test_requires_edit_refuses_combined_flags(kanban_home):
     tid = helpers._new(requires=["host_repo"])
     assert helpers._main(["edit", tid, "--requires", "terminal", "--title", "replacement"]) == 2
     assert helpers._edited_events(tid) == []
+
+
+def test_requires_edit_unknown_card(kanban_home, capsys):
+    assert helpers._main(["edit", "t_missing", "--requires", "terminal"]) == 1
+    assert "unknown id" in capsys.readouterr().err
+
+
+def test_requires_edit_force_is_not_an_escape(kanban_home):
+    tid = helpers._new(requires=["host_repo"])
+    assert helpers._main(["edit", tid, "--requires", "terminal", "--force"]) == 2
+    assert helpers._edited_events(tid) == []
+
+
+def test_requires_edit_retains_skill_requirements(kanban_home, monkeypatch):
+    from hermes_cli import kanban_capabilities as capabilities
+    tid = helpers._new(requires=["host_repo"])
+    monkeypatch.setattr(capabilities, "skill_requirements", lambda skills, profile: ["host_repo"])
+    assert helpers._main(["edit", tid, "--requires", "terminal"]) == 0
+    with kbc.connect() as conn:
+        assert kb.get_task(conn, tid).requires == ["terminal", "host_repo"]
+
+
+@pytest.mark.parametrize("field", ["claim_lock", "lease_holder"])
+def test_requires_edit_rejects_ready_card_with_custodian(kanban_home, field):
+    tid = helpers._new(requires=["host_repo"])
+    with kbc.connect() as conn:
+        # Unsynced fixtures lack the server lease mirror; install just that column.
+        if field == "lease_holder":
+            conn.execute("ALTER TABLE tasks ADD COLUMN lease_holder TEXT")
+        conn.execute(f"UPDATE tasks SET {field}='custodian' WHERE id=?", (tid,))
+        conn.commit()
+    assert helpers._main(["edit", tid, "--requires", "terminal"]) == 2
+    assert helpers._edited_events(tid) == []
diff --git a/tests/hermes_cli/test_kanban_recovery_cache.py b/tests/hermes_cli/test_kanban_recovery_cache.py
new file mode 100644
index 0000000000..f451ce14f5
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_recovery_cache.py
@@ -0,0 +1,67 @@
+"""Recovery caches are bounded and isolated by authoritative endpoint identity."""
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_placement_recovery as recovery
+from hermes_cli import kanban_sync_client as client
+from tests.hermes_cli import test_kanban_placement_recovery as fixtures
+
+conn = fixtures.conn
+
+
+@pytest.fixture(autouse=True)
+def isolated_caches(monkeypatch):
+    monkeypatch.setattr(recovery, "_unsupported", {})
+    monkeypatch.setattr(recovery, "_scan_cursor", {})
+    monkeypatch.setattr(recovery.time, "monotonic", lambda: 100.0)
+
+
+def test_backoff_shared_across_new_clients_but_not_url_board_gateway():
+    hub = SimpleNamespace(ident=SimpleNamespace(url="https://one.invalid"))
+    again = SimpleNamespace(ident=SimpleNamespace(url="https://one.invalid"))
+    other = SimpleNamespace(ident=SimpleNamespace(url="https://two.invalid"))
+    assert recovery.unavailable_endpoint(hub, "board", "gateway", client.HubError(404, "missing"), "promote")
+    assert not recovery.endpoint_available(again, "board", "gateway")
+    assert recovery.endpoint_available(other, "board", "gateway")
+    assert recovery.endpoint_available(hub, "other", "gateway")
+    assert recovery.endpoint_available(hub, "board", "other")
+
+
+def test_reservation_errors_do_not_poison_recovery():
+    hub = object()
+    assert not recovery.unavailable_endpoint(hub, "b", "g", client.HubError(404, "missing"), None)
+    assert recovery.endpoint_available(hub, "b", "g")
+
+
+def test_backoff_expires_at_boundary(monkeypatch):
+    hub = object()
+    recovery.unavailable_endpoint(hub, "b", "g", client.HubError(404, "missing"), "promote")
+    monkeypatch.setattr(recovery.time, "monotonic", lambda: 699.999)
+    assert not recovery.endpoint_available(hub, "b", "g")
+    monkeypatch.setattr(recovery.time, "monotonic", lambda: 700.0)
+    assert recovery.endpoint_available(hub, "b", "g")
+
+
+def test_backoff_has_hard_bound_and_keeps_latest():
+    hub = object()
+    for i in range(1025):
+        recovery.unavailable_endpoint(hub, str(i), "g", client.HubError(404, "missing"), "promote")
+    assert len(recovery._unsupported) == 1024
+    assert recovery.endpoint_available(hub, "0", "g")
+    assert not recovery.endpoint_available(hub, "1024", "g")
+
+
+def test_scan_cursor_is_board_scoped_and_bounded(conn):
+    ids = sorted(fixtures.make(conn) for _ in range(2))
+    for i in range(1025):
+        rows = recovery.select_rows(conn, str(i), "hub", "", 1)
+        assert [r["id"] for r in rows] == ids[:1]
+    assert len(recovery._scan_cursor) == 1024
+    assert [r["id"] for r in recovery.select_rows(conn, "1024", "hub", "", 1)] == ids[1:]
+    assert [r["id"] for r in recovery.select_rows(conn, "0", "hub", "", 1)] == ids[:1]
+
+
+def test_empty_scan_does_not_allocate_cursor(conn):
+    assert recovery.select_rows(conn, "b", "hub", "", 1) == []
+    assert recovery._scan_cursor == {}
diff --git a/tests/hermes_cli/test_kanban_recovery_guard_isolation.py b/tests/hermes_cli/test_kanban_recovery_guard_isolation.py
new file mode 100644
index 0000000000..ae10887193
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_recovery_guard_isolation.py
@@ -0,0 +1,82 @@
+"""Independent recovery fences must reject even when adjacent guards accept."""
+import json
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_placement_recovery as recovery
+from hermes_cli import kanban_worker_node as node
+from hermes_cli import kanban_worker_placement as wp
+from tests.hermes_cli import test_kanban_placement_recovery as fixtures
+
+conn = fixtures.conn
+setup = fixtures.setup
+
+
+@pytest.mark.parametrize("change", ["delete", "version", "status"])
+def test_snapshot_fence_without_pending_outbox(setup, change):
+    db, _ = setup
+    tid = fixtures.make(db)
+    row = dict(db.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone())
+    assert recovery.unchanged_ready(db, row)
+    if change == "delete":
+        db.execute("DELETE FROM tasks WHERE id=?", (tid,))
+    elif change == "version":
+        db.execute("UPDATE tasks SET sync_version=sync_version+1 WHERE id=?", (tid,))
+    else:
+        db.execute("UPDATE tasks SET status='running' WHERE id=?", (tid,))
+    # Model a preceding authoritative feed import, not a locally pending write.
+    db.execute("DELETE FROM kanban_sync_outbox WHERE row_uid=?", (tid,))
+    db.commit()
+    assert not recovery.unchanged_ready(db, row)
+
+
+def test_pending_owner_move_preempts_stale_recovery(setup, monkeypatch):
+    db, _ = setup
+    tid = fixtures.fixtures.acknowledged(db, placement_policy=wp.POLICY, runs_on='["machine:worker-1"]')
+    kb._append_event(db, tid, "moved", {"runs_on": ["machine:worker-2"]})
+    db.commit()
+    monkeypatch.setattr(node, "registry", lambda **kw: {"machines": {"worker-1": {"state": "revoked"}}})
+    row = dict(db.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone())
+    assert wp.requested_move(db, tid) == ["machine:worker-2"]
+    assert recovery.recovery_mode(db, row, {}) is None
+
+
+def test_promotion_helper_preserves_explicit_empty_labels(setup):
+    db, _ = setup
+    tid = fixtures.make(db, runs_on="[]")
+    row = dict(db.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone())
+    assert recovery.promotion_mode(db, row, {}) is None
+
+
+@pytest.mark.parametrize("payload", [None, "null", "[]", "broken"])
+def test_missing_or_malformed_creation_never_promotes(setup, payload):
+    db, _ = setup
+    tid = fixtures.make(db)
+    if payload is None:
+        db.execute("DELETE FROM task_events WHERE task_id=? AND kind='created'", (tid,))
+    else:
+        db.execute("UPDATE task_events SET payload=? WHERE task_id=? AND kind='created'", (payload, tid))
+    db.commit()
+    row = dict(db.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone())
+    assert recovery.promotion_mode(db, row, {}) is None
+    assert not recovery.current_portable(db, row, {})
+
+
+@pytest.mark.parametrize("kind", ["moved", "placement_repinned"])
+def test_historical_owner_move_prevents_reenrollment(setup, kind):
+    db, hub = setup
+    tid = fixtures.make(db)
+    kb._append_event(db, tid, kind, {"runs_on": []})
+    db.commit()
+    assert wp.reevaluate(db, hub, "default", "hub") == 0
+    assert not hub.calls
+
+
+@pytest.mark.parametrize("value", [[1], {"terminal": True}, 5])
+def test_current_requirement_shape_rejected_independently(setup, value):
+    db, _ = setup
+    tid = fixtures.make(db)
+    row = dict(db.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone())
+    row['requires'] = json.dumps(value)
+    assert not recovery.current_portable(db, row, {})
