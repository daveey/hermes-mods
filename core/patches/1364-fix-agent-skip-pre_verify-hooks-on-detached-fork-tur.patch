From 966154e8d356ecab6701a67bd24db282ec282cde Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 00:52:03 +0000
Subject: [PATCH] fix(agent): skip pre_verify hooks on detached fork turns
 [daveey]

Background review / side-question forks share the parent's session_id but
their text never reaches the user. post_llm_call already skipped them
(turn_finalizer _persist_disabled); _pre_verify_nudge did not, so the coach
reply check judged a skill-review summary against the user's question and
nudged it as report_only (coach defect agent-77325213e1). Return None when
_turn_origin or _persist_disabled is set and log one info line.
---
 agent/turn_stop_gates.py         | 12 ++++++++-
 tests/agent/test_verify_hooks.py | 43 ++++++++++++++++++++++++++++++++
 2 files changed, 54 insertions(+), 1 deletion(-)

diff --git a/agent/turn_stop_gates.py b/agent/turn_stop_gates.py
index d80ecad6ea6..c90e8aa8a55 100644
--- a/agent/turn_stop_gates.py
+++ b/agent/turn_stop_gates.py
@@ -62,7 +62,17 @@ def _verify_on_stop_nudge(agent) -> Optional[str]:
 
 def _pre_verify_nudge(agent, final_response, attempt: int) -> Optional[str]:
     """After code edits (or on every text stop with ``agent.pre_verify_every_turn``) a registered
-    ``pre_verify`` hook may keep the agent going one more turn; no default continuation cost."""
+    ``pre_verify`` hook may keep the agent going one more turn; no default continuation cost.
+
+    Detached forks (background review, side questions: ``_turn_origin`` / ``_persist_disabled``) share the
+    parent's session_id but their text never reaches the user, so the hook is not consulted for them,
+    matching ``post_llm_call`` in turn_finalizer. Otherwise a reply check judges the fork's summary
+    against the user's last question and spends a continuation inside the fork."""
+    _origin = getattr(agent, "_turn_origin", None)
+    if _origin or getattr(agent, "_persist_disabled", False):
+        logger.info("pre_verify skipped for fork turn origin=%s session=%s",
+                    _origin or "persist_disabled", getattr(agent, "session_id", None) or "")
+        return None
     _edited = sorted(getattr(agent, "_turn_file_mutation_paths", set()) or [])
     try:
         from agent.verify_hooks import max_verify_nudges, pre_verify_every_turn
diff --git a/tests/agent/test_verify_hooks.py b/tests/agent/test_verify_hooks.py
index 1d6438f0226..620cd0f7e20 100644
--- a/tests/agent/test_verify_hooks.py
+++ b/tests/agent/test_verify_hooks.py
@@ -97,3 +97,46 @@ class TestPreVerifyGateWithoutEdits:
     def test_edits_still_call_hook_when_off(self, monkeypatch):
         msg, calls = self._run(monkeypatch, every_turn=False, edited=["a.py"])
         assert msg == "keep going" and calls[0]["changed_paths"] == ["a.py"]
+
+
+class TestPreVerifySkipsForkTurns:
+    """Detached forks (background skill/memory review, side questions) share the parent's session_id but
+    their text never reaches the user. post_llm_call already skips them (turn_finalizer ``_persist_disabled``);
+    pre_verify must too, or a reply-check plugin judges the fork's summary against the user's question
+    (coach defect agent-77325213e1)."""
+
+    def _run(self, monkeypatch, **marks):
+        from types import SimpleNamespace
+        from agent import turn_stop_gates
+        from hermes_cli import lifecycle
+        from hermes_cli import plugins
+
+        calls = []
+        monkeypatch.setattr(lifecycle, "has_hook", lambda name: name == "pre_verify")
+        monkeypatch.setattr(verify_hooks, "pre_verify_every_turn", lambda config=None: True)
+        monkeypatch.setattr(verify_hooks, "max_verify_nudges", lambda config=None: 3)
+
+        def fake(**kw):
+            calls.append(kw)
+            return "report only: fix it"
+
+        monkeypatch.setattr(plugins, "get_pre_verify_continue_message", fake)
+        agent = SimpleNamespace(_turn_file_mutation_paths={"a.py"}, session_id="parent-session",
+                                platform="cli", model="m", _resolved_is_coding=False, **marks)
+        return turn_stop_gates._pre_verify_nudge(agent, "I added one thing to the skill library.", 0), calls
+
+    def test_background_review_fork_never_calls_hook(self, monkeypatch):
+        msg, calls = self._run(monkeypatch, _turn_origin="background_review", _persist_disabled=True)
+        assert msg is None and calls == []
+
+    def test_turn_origin_alone_skips_hook(self, monkeypatch):
+        msg, calls = self._run(monkeypatch, _turn_origin="side_question")
+        assert msg is None and calls == []
+
+    def test_persist_disabled_alone_skips_hook(self, monkeypatch):
+        msg, calls = self._run(monkeypatch, _persist_disabled=True)
+        assert msg is None and calls == []
+
+    def test_live_turn_still_calls_hook(self, monkeypatch):
+        msg, calls = self._run(monkeypatch, _turn_origin=None, _persist_disabled=False)
+        assert msg == "report only: fix it" and calls[0]["session_id"] == "parent-session"
-- 
