From ff8ec1d78c389996fda03d49a75598bbb2c49224 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 22:06:57 -0700
Subject: [PATCH] fix(desktop): hide delegate_task children from replica
 sidebar rows (#133)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

"Subagent: …" rows showed in Home. The local list hides delegate children
by their _delegate_from marker, but hub replica rows (other gateways, and
this gateway's own in the boot snapshot) only went through the source rule,
and a delegate child keeps its parent's source ('desktop').

The replica recents rule now drops rows the owner stamps
is_internal_child (hermes-hub collector, same projection as the API's
is_internal_child). Exact-id opens are unaffected.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../src/store/offline-sessions.test.ts        | 20 +++++++++++++++++++
 apps/desktop/src/store/offline-sessions.ts    |  5 ++++-
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/store/offline-sessions.test.ts b/apps/desktop/src/store/offline-sessions.test.ts
index be707d93ee..ea2e87d987 100644
--- a/apps/desktop/src/store/offline-sessions.test.ts
+++ b/apps/desktop/src/store/offline-sessions.test.ts
@@ -145,6 +145,26 @@ describe('offlineSessionsFromReplica', () => {
     expect(ids(rows)).toEqual(['ok'])
   })
 
+  it('skips delegate_task children the owner stamped is_internal_child, whatever their source', () => {
+    // A delegate child keeps its parent's source ('desktop'), so the source rule
+    // let "Subagent: …" rows into Home; the owner's collector stamps the flag.
+    const records = [
+      rec('child', { is_internal_child: true, source: 'desktop', title: 'Subagent: do a thing' }),
+      rec('parent', { is_internal_child: false })
+    ]
+
+    expect(ids(offlineSessionsFromReplica(records, connFor))).toEqual(['parent'])
+  })
+
+  it('keeps delegate children out of the boot snapshot of this gateway too', () => {
+    const records = [
+      rec('child', { is_internal_child: true, local: true }),
+      rec('mine', { local: true })
+    ]
+
+    expect(ids(offlineSessionsFromReplica(records, connFor, undefined, { includeLocal: true }))).toEqual(['mine'])
+  })
+
   it('skips gateways this Desktop has no connection for (gateway selection needs a registry id)', () => {
     expect(offlineSessionsFromReplica([rec('x', { gateway: 'ghost' })], connFor)).toEqual([])
   })
diff --git a/apps/desktop/src/store/offline-sessions.ts b/apps/desktop/src/store/offline-sessions.ts
index adf124c42f..2a7088365b 100644
--- a/apps/desktop/src/store/offline-sessions.ts
+++ b/apps/desktop/src/store/offline-sessions.ts
@@ -37,6 +37,8 @@ export interface OfflineReplicaRecord {
   end_reason?: null | string
   ended_at?: null | number
   hidden?: boolean
+  /** Owner-stamped: a delegate_task child (`_delegate_from`), hidden like the local list hides it. */
+  is_internal_child?: boolean
   message_count?: null | number
   model?: null | string
   parent_session_id?: null | string
@@ -203,7 +205,7 @@ const recordKey = (record: OfflineReplicaRecord, id: string) =>
 
 const isCompressionAncestor = (record: OfflineReplicaRecord) => record.end_reason === 'compression'
 
-/** The normal recents rule: no excluded source, not empty/archived/hidden, has a title. */
+/** The normal recents rule: no excluded source or delegate child, not empty/archived/hidden, has a title. */
 function isRecentsEligible(record: OfflineReplicaRecord, excluded: ReadonlySet<string>, includeLocal: boolean): boolean {
   const source = normalizeSessionSource(record.source)
 
@@ -211,6 +213,7 @@ function isRecentsEligible(record: OfflineReplicaRecord, excluded: ReadonlySet<s
     (record.local && !includeLocal) ||
     record.archived ||
     record.hidden ||
+    record.is_internal_child === true ||
     (source && excluded.has(source)) ||
     (record.message_count ?? 0) < 1 ||
     !record.title?.trim()
-- 
