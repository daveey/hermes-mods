diff --git a/tests/tui_gateway/test_session_wake_turn.py b/tests/tui_gateway/test_session_wake_turn.py
new file mode 100644
index 0000000000..c8fd310be6
--- /dev/null
+++ b/tests/tui_gateway/test_session_wake_turn.py
@@ -0,0 +1,105 @@
+"""``server._wake_session_turn``: one agent turn in a chat without the user typing. [daveey]
+
+Plugins use it to close a loop (e.g. chat-closeout: all of a chat's kanban cards finished while no backend held
+it). A chat live here is used as is; otherwise it is resumed in-process first, like the re-adopted-exit waker.
+"""
+
+from __future__ import annotations
+
+import threading
+
+import pytest
+
+from tui_gateway import server
+
+KEY = "20261022_170000_abcdef"
+
+
+def _session(**kw) -> dict:
+    ready = threading.Event()
+    ready.set()
+    return {"history_lock": threading.RLock(), "running": False, "agent_ready": ready, "session_key": KEY,
+            "profile_home": None, **kw}
+
+
+@pytest.fixture
+def wired(monkeypatch, tmp_path):
+    monkeypatch.setattr("hermes_constants.get_hermes_home", lambda: tmp_path)
+    live: dict = {}
+    calls: dict = {"resume": [], "submit": [], "released": 0}
+    monkeypatch.setattr(server, "_find_live_session_by_key",
+                        lambda key, profile_home=None: (live["sid"], live["session"]) if live and key == KEY else None)
+    monkeypatch.setattr(server, "_start_agent_build", lambda sid, session: None)
+    monkeypatch.setattr(server, "_ensure_active_session_slot", lambda sid, session: None)
+
+    def submit(rid, sid, session, text, what, **kwargs):
+        calls["submit"].append((sid, text, kwargs))
+        return True
+
+    monkeypatch.setattr(server, "_notif_submit", submit)
+    real_release = server._notif_release_turn
+
+    def release(session):
+        calls["released"] += 1
+        real_release(session)
+
+    monkeypatch.setattr(server, "_notif_release_turn", release)
+    return live, calls
+
+
+def test_unloaded_chat_is_resumed_then_runs_one_turn(wired, monkeypatch):
+    live, calls = wired
+
+    def resume(rid, params):
+        calls["resume"].append(params)
+        live.update(sid="sid-1", session=_session())
+        return {"result": {"session_id": "sid-1"}}
+
+    monkeypatch.setitem(server._methods, "session.resume", resume)
+    got = server._wake_session_turn(KEY, "close out", display_kind="kanban_notice",
+                                    display_metadata={"display_text": "x"}, label="closeout")
+    assert got == "started"
+    assert calls["resume"] and calls["resume"][0]["session_id"] == KEY and calls["resume"][0]["omit_messages"]
+    assert calls["submit"] == [("sid-1", "close out",
+                                {"display_kind": "kanban_notice", "display_metadata": {"display_text": "x"}})]
+    assert live["session"]["running"] is True  # claimed for the turn (the turn thread releases it)
+
+
+def test_chat_live_here_is_not_resumed(wired, monkeypatch):
+    live, calls = wired
+    live.update(sid="sid-live", session=_session())
+    monkeypatch.setitem(server._methods, "session.resume", lambda rid, params: pytest.fail("resumed a live chat"))
+    assert server._wake_session_turn(KEY, "close out") == "started"
+    assert calls["submit"][0][0] == "sid-live" and calls["submit"][0][2] == {}
+
+
+def test_busy_or_stopped_chat_is_left_alone(wired, monkeypatch):
+    live, calls = wired
+    live.update(sid="s", session=_session(running=True))
+    assert server._wake_session_turn(KEY, "close out") == "busy"
+    live.update(sid="s", session=_session(_turn_cancel_requested=True))
+    assert server._wake_session_turn(KEY, "close out") == "busy"
+    assert calls["submit"] == []
+
+
+def test_resume_refused_by_another_owner(wired, monkeypatch):
+    _live, calls = wired
+    monkeypatch.setitem(server._methods, "session.resume",
+                        lambda rid, params: {"error": {"code": 4011, "message": "open in another Hermes window"}})
+    assert server._wake_session_turn(KEY, "close out") == "refused"
+    assert calls["submit"] == []
+
+
+def test_chat_in_no_store_is_missing(wired, monkeypatch):
+    monkeypatch.setitem(server._methods, "session.resume",
+                        lambda rid, params: {"error": {"code": 4007, "message": "session not found"}})
+    assert server._wake_session_turn(KEY, "close out") == "missing"
+
+
+def test_owner_slot_refusal_releases_the_claim(wired, monkeypatch):
+    live, calls = wired
+    live.update(sid="s", session=_session())
+    monkeypatch.setattr(server, "_ensure_active_session_slot", lambda sid, session: "owned elsewhere")
+    assert server._wake_session_turn(KEY, "close out") == "refused"
+    assert calls["released"] == 1 and live["session"]["running"] is False
+    assert calls["submit"] == []
diff --git a/tui_gateway/session_notifications.py b/tui_gateway/session_notifications.py
index 05e0b5433e..d2d9366f7f 100644
--- a/tui_gateway/session_notifications.py
+++ b/tui_gateway/session_notifications.py
@@ -899,6 +899,76 @@ def _wake_chat_for_readopted_exit(key: str):
     return None
 
 
+def _wake_session_turn(session_key: str, text: str, *, display_kind: str | None = None,
+                       display_metadata: dict | None = None, label: str = "wake", build_timeout: float = 120.0) -> str:
+    """Run ONE agent turn with ``text`` in chat ``session_key`` from this backend: the chat live here is used as is,
+    otherwise it is resumed in-process first (``session.resume``, launch store then each named profile, the same
+    path the re-adopted-exit waker uses). For plugins that must close a loop without the user typing (e.g. a chat
+    whose kanban cards all finished while no backend held it). [daveey]
+
+    Returns ``"started"`` (the turn was admitted and runs on its own thread), ``"busy"`` (a turn is live or the
+    user stopped the last one), ``"refused"`` (another backend owns the chat, or resume was refused),
+    ``"missing"`` (no store has it) or ``"error"``. Blocks for at most ``build_timeout`` while the agent builds.
+    Never raises."""
+    import itertools as _it
+    key = str(session_key or "")
+    if not key or not text:
+        return "error"
+    try:
+        live = _find_live_session_by_key(key)
+        if live is None:
+            handler = _methods.get("session.resume")
+            if handler is None:
+                return "error"
+            resumed = False
+            for n, profile in zip(_it.count(1), _readopt_wake_profiles()):
+                params = {"session_id": key, "omit_messages": True, **({"profile": profile} if profile else {})}
+                env = handler(f"{label}-resume-{n}", params) or {}
+                err = env.get("error") if isinstance(env, dict) else None
+                if not err:
+                    resumed = True
+                    break
+                if not (isinstance(err, dict) and err.get("code") == 4007):
+                    logger.info("%s: resume of %s refused (%s)", label, key, err)
+                    return "refused"
+            if not resumed:
+                return "missing"
+            live = _find_live_session_by_key(key)
+            if live is None:
+                tip = None
+                with contextlib.suppress(Exception):
+                    from hermes_state import SessionDB
+                    tip = SessionDB().get_compression_tip(key)
+                live = _find_live_session_by_key(tip) if tip else None
+            if live is None:
+                logger.warning("%s: %s resumed but no live session holds it", label, key)
+                return "error"
+        sid, session = live
+        rid = f"__{label}__{int(time.time() * 1000)}"
+        _start_agent_build(sid, session)  # idempotent; a resumed chat builds lazily
+        if _wait_agent(session, rid, timeout=build_timeout):
+            logger.warning("%s: agent build failed for %s", label, key)
+            return "error"
+        with session["history_lock"]:
+            if session.get("running") or session.get("_turn_cancel_requested") or session.get("_finalized"):
+                return "busy"
+            session["running"] = True
+            session["last_active"] = time.time()
+        if _ensure_active_session_slot(sid, session) is not None:
+            _notif_release_turn(session)
+            logger.info("%s: %s has another live owner; not waking it here", label, key)
+            return "refused"
+        kwargs = {k: v for k, v in (("display_kind", display_kind), ("display_metadata", display_metadata)) if v}
+        accepted = _notif_submit(rid, sid, session, text, f"{label} dispatch failed", **kwargs)
+        if accepted is False:
+            return "refused"
+        logger.info("%s: started a turn in chat %s (live sid %s)", label, key, sid)
+        return "started"
+    except Exception:
+        logger.warning("%s: waking %s failed", label, key, exc_info=True)
+        return "error"
+
+
