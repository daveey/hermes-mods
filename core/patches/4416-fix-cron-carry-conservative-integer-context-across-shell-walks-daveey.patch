         "lines_remaining",
         "mask_heredocs",
         "overrun",
@@ -547,6 +548,7 @@ class _LifecycleScanBudget:
             and all(isinstance(name, str) for name in session_aliases) else None)
         # Sticky: some walked text may define or enable an alias (see `note_aliases`).
         self.aliases_defined = False
