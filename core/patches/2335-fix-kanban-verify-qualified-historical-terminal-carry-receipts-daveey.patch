+        assert links.reconcile(conn, 'default', 'origin')['changed'] == 1
+        assert conn.execute("SELECT released FROM task_chat_links WHERE kind='shepherd'").fetchone()[0] == 0
+        assert conn.execute('SELECT count(*) FROM tasks').fetchone()[0] == 0
