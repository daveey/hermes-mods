     """
     from hermes_cli import kanban_db as kb
 
@@ -150,7 +152,7 @@ def failed_result_receipt(conn, task_id, run_id, claim_lock, *, allow_continuabl
     if owner and (bound.get('pid'), bound.get('started_at')) != (row['worker_pid'], row['worker_started_at']):
         return None
     code = result.get('exit_code')
-    if (not isinstance(code, int) or isinstance(code, bool) or code == 0
+    if (not isinstance(code, int) or isinstance(code, bool) or (code == 0 and not (allow_clean and modern))
             or (result.get('continuable') and not (owner and allow_continuable))
             or (not modern and result_event['id'] <= bound_event['id'])
             or result.get('pid') != bound.get('pid')):
@@ -184,7 +186,8 @@ def modern_result_recorded(conn, task_id, run_id):
 def reclaim_proof(conn, row, *, failed_results_only=False):
     """Keep strict receipt vetoes distinct from unsupported legacy recovery."""
     identity = (row['id'], row['current_run_id'], row['claim_lock'])
-    proof = failed_result_proof(conn, *identity, allow_continuable=not failed_results_only)
+    proof = failed_result_proof(conn, *identity, allow_continuable=not failed_results_only,
+                                allow_clean=not failed_results_only)
     hold = proof is None and (failed_results_only or modern_result_recorded(conn, *identity[:2]))
     return proof, hold
 
@@ -197,14 +200,14 @@ def result_exit_code(conn, row, proof):
     return managed_run_exit_code(conn, row['id'], row['worker_pid'], row['claim_lock'])
 
 
-def failed_result_proof(conn, task_id, run_id, claim_lock, *, allow_continuable=False):
+def failed_result_proof(conn, task_id, run_id, claim_lock, *, allow_continuable=False, allow_clean=False):
     """Return an attributable failure after outer and every bound incarnation exit.
 
     Only the dispatcher opts into continuable bookings, after their submitter
     is gone. Observers must leave checkpoints available to a replacement owner.
     """
     receipt = failed_result_receipt(conn, task_id, run_id, claim_lock,
-                                    allow_continuable=allow_continuable)
+                                    allow_continuable=allow_continuable, allow_clean=allow_clean)
     if receipt is None:
         return None
     if not process_gone(*receipt.pop('outer')) or not process_gone(*receipt.pop('bound')):
diff --git a/tests/hermes_cli/test_kanban_comment_liveness.py b/tests/hermes_cli/test_kanban_comment_liveness.py
new file mode 100644
index 0000000000..da00578397
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_comment_liveness.py
@@ -0,0 +1,63 @@
+"""A comment on a ``running`` card whose worker exited must not promise a live run. [daveey]
+
+Incident (2026-11-13, hermes-worker-6, t_01a1d563324d7e8e run 11569): the continued worker ended its turn rc=0 at
+15:55, both pids dead, run row still ``running``. ``hermes kanban comment`` at 16:05 answered "The card has a live
+worker run: it gets this note at its next model call"; no process would ever make that call.
+"""
+import argparse
+import json
+import os
+
+from hermes_cli import kanban as kcli
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_dispatch as dispatch
+from hermes_cli.kanban_comment_liveness import EXITED_NOTE, worker_exited
+from tests.hermes_cli import test_kanban_owner_restart_failed_receipt as shapes
+from tools import kanban_tools as kt
+
+board = shapes.board
+LIVE_RUN_PROMISE = "gets this note at its next model call"
+
+
+def _exited_continued_run(conn, context):
+    shapes._failed_child(conn, context)
+    shapes.book(context, True)
+    shapes._continued_turn(context, 0, "Tell me how you'd like to proceed")
+
+
+def test_the_cli_comment_on_an_exited_worker_says_the_note_waits(board, capsys, monkeypatch):
+    conn, context = board
+    monkeypatch.delenv('HERMES_KANBAN_TASK', raising=False)
+    _exited_continued_run(conn, context)
+    assert kb.live_run_id(conn, context['task_id']) == context['run_id']  # still ``running`` on the board
+    rc = kcli._cmd_comment(argparse.Namespace(task_id=context['task_id'], text=['are', 'you', 'there'],
+                                              max_len=None, author='me', origin_gateway=None, _slash_typed=True))
+    printed = capsys.readouterr().out
+    assert rc == 0 and LIVE_RUN_PROMISE not in printed
+    assert "it waits for the card's next run" in printed
+
+
+def test_the_comment_tool_on_an_exited_worker_claims_no_live_run(board, monkeypatch):
+    conn, context = board
+    monkeypatch.setattr(kt, '_persisted_identity', lambda: 'default')
+    _exited_continued_run(conn, context)
+    out = json.loads(kt._handle_comment({'task_id': context['task_id'], 'body': 'are you there'}))
+    assert out['live_run'] is False and out['worker_exited'] is True
+    assert out['delivery'] == EXITED_NOTE and LIVE_RUN_PROMISE not in out['delivery']
+
+
+def test_a_live_worker_keeps_the_live_run_promise(board, monkeypatch):
+    conn, context = board
+    monkeypatch.setattr(kt, '_persisted_identity', lambda: 'default')
+    dispatch._set_worker_pid(conn, context['task_id'], os.getpid())  # a live outer, nothing booked yet
+    assert not worker_exited(conn, context['task_id'], context['run_id'])
+    out = json.loads(kt._handle_comment({'task_id': context['task_id'], 'body': 'hello worker'}))
+    assert out['live_run'] is True and LIVE_RUN_PROMISE in out['delivery'] and 'worker_exited' not in out
+
+
+def test_a_checkpointed_turn_with_a_live_submitter_is_still_live(board):
+    """The restart gap: the old owner checkpointed the turn and the submitter waits for the next owner."""
+    conn, context = board
+    shapes._failed_child(conn, context, outer_pid=os.getpid())
+    shapes.book(context, True)
+    assert not worker_exited(conn, context['task_id'], context['run_id'])
diff --git a/tests/hermes_cli/test_kanban_owner_restart_failed_receipt.py b/tests/hermes_cli/test_kanban_owner_restart_failed_receipt.py
index bd9d5d391c..eff96e1b7f 100644
--- a/tests/hermes_cli/test_kanban_owner_restart_failed_receipt.py
+++ b/tests/hermes_cli/test_kanban_owner_restart_failed_receipt.py
@@ -160,6 +160,86 @@ def test_owner_snapshot_survives_replica_event_ids(board):
     assert proof.failed_result_proof(conn, context['task_id'], context['run_id'], context['claim_lock'])
 
 
+_CONTINUED_CHILD = '''
+import json, os, sys
+from pathlib import Path
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_dispatch as kbd
+from hermes_cli.kanban_db_connect import connect_closing
+from gateway.session_kanban import _record_worker_result
+import hermes_cli.kanban_failed_result_observer as observer
+observer.arm = lambda context: None
+context, code, output = json.loads(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
+with connect_closing(Path(context['db'])) as conn, kb.write_txn(conn):
+    kb._append_event(conn, context['task_id'], 'worker_bound',
+        {'pid': os.getpid(), 'started_at': kbd._process_fingerprint(os.getpid()),
+         'claim_lock': context['claim_lock']}, run_id=context['run_id'])
+_record_worker_result(context, code, output)
+'''
+
+
+def _continued_turn(context, code, output):
+    """The next owner's interpreter for the SAME run: binds, ends its continued turn with ``code``, exits."""
+    import subprocess
+    import sys
+    from pathlib import Path
+    from tools.environments.local import build_subprocess_env
+    done = subprocess.run([sys.executable, '-c', _CONTINUED_CHILD, json.dumps(context), str(code), output],
+                          capture_output=True, text=True, timeout=60, env=build_subprocess_env(), check=False,
+                          cwd=str(Path(__file__).resolve().parents[2]))
+    assert done.returncode == 0, (done.stdout, done.stderr)
+
+
+def test_a_continued_run_whose_worker_exits_cleanly_is_a_protocol_violation(board):
+    """t_01a1d563324d7e8e run 11569 (worker-6, 11-13): the owner's continuable restart booking makes the
+    run's evidence modern; the continued interpreter's rc=0 result carried no modern identity, so no
+    result was attributable, ``reclaim_proof`` held, and the card sat ``running`` with every pid dead."""
+    conn, context = board
+    _failed_child(conn, context)          # the first owner's interpreter, stopped by the restart
+    book(context, True)                   # the stopping owner's continuable checkpoint (exit 76)
+    last = "I stopped retrying because I kept running kanban_link 8 times. Tell me how you'd like to proceed"
+    _continued_turn(context, 0, last)     # the next owner continues the turn; it ends without a terminal call
+    dispatch.detect_crashed_workers(conn)  # one pass, every pid of the run already dead
+    task = kb.get_task(conn, context['task_id'])
+    run = conn.execute('SELECT * FROM task_runs WHERE id=?', (context['run_id'],)).fetchone()
+    assert task is not None and task.last_failure_error is not None
+    assert task.status == 'ready', dict(run)
+    assert run['outcome'] == 'crashed' and run['ended_at'] is not None
+    assert json.loads(run['metadata'])['protocol_violation'] is True
+    assert run['error'].startswith(dispatch._PROTOCOL_VIOLATION_ERROR)
+    assert last[:60] in run['error'] and last[:60] in task.last_failure_error
+    assert task.last_failure_error.startswith(dispatch._PROTOCOL_VIOLATION_ERROR)
+    kinds = [r[0] for r in conn.execute('SELECT kind FROM task_events WHERE run_id=?', (context['run_id'],))]
+    assert kinds.count('protocol_violation') == 1
+
+
+def test_a_continued_run_whose_worker_fails_is_still_a_crash(board):
+    """The same continued shape with a failing worker keeps the strict failed-result booking."""
+    conn, context = board
+    _failed_child(conn, context)
+    book(context, True)
+    _continued_turn(context, 1, 'continued turn failed')
+    dispatch.detect_crashed_workers(conn)
+    run = conn.execute('SELECT * FROM task_runs WHERE id=?', (context['run_id'],)).fetchone()
+    assert run['outcome'] == 'crashed' and 'protocol_violation' not in json.loads(run['metadata'])
+    assert 'continued turn failed' in run['error']
+
+
+def test_a_live_continued_interpreter_with_a_clean_result_still_holds(board, monkeypatch):
+    """A clean receipt is not a death proof: a still-live bound interpreter keeps the run."""
+    conn, context = board
+    _failed_child(conn, context)
+    book(context, True)
+    _continued_turn(context, 0, 'done talking')
+    real = proof.process_gone
+    bound = [json.loads(r[0])['pid'] for r in conn.execute(
+        "SELECT payload FROM task_events WHERE kind='worker_bound' ORDER BY id")][-1]
+    monkeypatch.setattr(proof, 'process_gone', lambda pid, birth: pid != bound and real(pid, birth))
+    dispatch.detect_crashed_workers(conn)
+    task = kb.get_task(conn, context['task_id'])
+    assert task is not None and task.status == 'running'
+
+
 def test_child_can_supersede_owner_after_continuation_rebind(board):
     from hermes_cli.kanban_failed_result_identity import result_identity_fields
     conn, context = board
