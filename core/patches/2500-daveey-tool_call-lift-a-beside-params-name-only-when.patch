From 1ba334d140132b336102e2edc385c4cf70681605 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 07:31:39 +0000
Subject: [PATCH] [daveey] tool_call: lift a beside-params name only when every
 other key is that tool's param

Review of PR1262 (t_01a1cea6b4375743): a nameless call to tool Y whose own `name`
argument equals a registered tool X, e.g. {name: X, file_path: ...}, was rerouted to
X(file_path=...) and passed validation (extra properties are allowed). Now the
beside-params lift also requires set(rest) <= X's declared params; anything else
keeps the actionable "requires a 'name'" error. (rest is never empty here: an
empty rest takes the nested-envelope branch.)

Proof: RED 2 failed without the guard (new parametrized regression test); GREEN
127 passed across 9 tool_call/tool_search test files. The hub replay's 4 recovered
historical entries are unaffected: both beside-params ones carry only `request`,
which action_request declares.
---
 tests/tools/test_tool_call_entry_name.py | 15 +++++++++++++++
 tools/tool_search_validation.py          |  7 +++++--
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/tests/tools/test_tool_call_entry_name.py b/tests/tools/test_tool_call_entry_name.py
index 9fff99eda9..460fbc5d87 100644
--- a/tests/tools/test_tool_call_entry_name.py
+++ b/tests/tools/test_tool_call_entry_name.py
@@ -79,6 +79,21 @@ def test_name_beside_params_is_kept_when_the_tool_declares_name():
     assert "calls[0] requires a 'name'" in err
 
 
+@pytest.mark.parametrize("args", [
+    # A nameless call to another tool Y, e.g. skill_view(name=X, file_path=...), whose own
+    # `name` argument happens to equal a registered tool X: rerouting it to X would run a
+    # tool the model never chose. Every other key must be one of X's declared params.
+    {"name": "fake_action_request", "file_path": "references/api.md"},
+    {"name": "fake_action_request", "request": {}, "file_path": "references/api.md"},
+])
+def test_name_beside_params_foreign_to_that_tool_is_not_rerouted(args):
+    entries, err = normalize_tool_call_entries({"calls": [{"arguments": args}]})
+    assert entries == []
+    assert "calls[0] requires a 'name'" in err
+    _, _, err = resolve_underlying_call({"calls": [{"arguments": args}]})
+    assert err and "calls[0] requires a 'name'" in err
+
+
 @pytest.mark.parametrize("args", [
     {"name": "not_a_registered_tool", "content": "x"},  # beside params, unknown tool
     {"name": "fake_no_props", "content": "x"},  # beside params, schema declares nothing
diff --git a/tools/tool_search_validation.py b/tools/tool_search_validation.py
index 13c2ad7332..a21bdc0227 100644
--- a/tools/tool_search_validation.py
+++ b/tools/tool_search_validation.py
@@ -220,9 +220,12 @@ def _lift_misplaced_entry_name(raw_args: Any) -> Optional[tuple[str, Any]]:
                 or canonical in BRIDGE_TOOL_NAMES):
             return None
         return inner, rest.get("arguments")
-    # Beside params: only a registered tool with a known schema that declares no `name`.
+    # Beside params: only a registered tool with a known schema that declares no `name`,
+    # and every other key must be one of THAT tool's params. Otherwise `name` may be an
+    # argument of some other tool Y (e.g. skill_view(name=X, file_path=...)) whose value
+    # happens to be a tool name, and lifting would reroute Y's call to X.
     declared = _declared_parameter_names(canonical)
-    if declared is None or "name" in declared:
+    if declared is None or "name" in declared or not set(rest) <= declared:
         return None
     return inner, rest
 
-- 
