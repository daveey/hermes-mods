--- a/tools/kanban_tools.py
+++ b/tools/kanban_tools.py
@@ -1149,7 +1149,10 @@ def _handle_block(args: dict, **kw) -> str:
                 "so this was recorded as needs_input (sticky until a human unblocks) "
