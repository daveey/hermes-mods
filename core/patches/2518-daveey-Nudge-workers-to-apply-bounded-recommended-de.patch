             )
-        return _ok_landed(kb, conn, tid, "blocked", **extra)
+        from hermes_cli.kanban_block_policy import recommended_choice_warning
+
+        return _ok_landed(kb, conn, tid, "blocked", **extra,
+                          **recommended_choice_warning(args.get("human_request")))
 
 
 @_kanban_handler("kanban_schedule")
