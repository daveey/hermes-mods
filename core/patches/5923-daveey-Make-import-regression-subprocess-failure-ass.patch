 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_lanes_cold_import.py b/tests/hermes_cli/test_lanes_cold_import.py
index a177e140d36..4f35e4dca2b 100644
--- a/tests/hermes_cli/test_lanes_cold_import.py
+++ b/tests/hermes_cli/test_lanes_cold_import.py
