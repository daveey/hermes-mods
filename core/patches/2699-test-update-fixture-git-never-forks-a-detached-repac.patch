From 1bf51c1b2907a8c5d0e8a468b34d8a9c8ee8b852 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 11:56:36 +0000
Subject: [PATCH] test(update): fixture git never forks a detached repack that
 races the next clone

test_concurrent_launches_take_turns_and_all_rerun_from_the_restored_tree
failed on CI (run 43208592021) in setup: `git clone` of the fixture origin
died with "unable to read sha1 file of m0.py". The runner has git 2.55,
whose auto-maintenance defaults to the geometric strategy: once 100+ loose
objects exist (commit B leaves 604), `git commit` forks a detached
`maintenance run --auto` that packs the loose objects and deletes them.
The test clones the origin immediately; the local clone copies objects/
directory by directory, so a pack written after it passed pack/ and loose
files deleted before it reached their directory leave the clone without
B's blobs. A throttled runner widens that window.

The file's git helper (and its one bare `git merge`) now carry the
updater's own GIT_NO_DETACH (`gc.autoDetach=false`,
`maintenance.auto=false`), so fixture git never runs background
maintenance.

Repro (git 2.43 with gc.auto=1 to force the same detached repack, clone
starved by a SIGSTOP/SIGCONT duty cycle): 10/60 clones fail without the
flags, 0/60 with them.
---
 tests/hermes_cli/test_update_interrupted_pull.py | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_update_interrupted_pull.py b/tests/hermes_cli/test_update_interrupted_pull.py
index a3d1d57378..6d9b2ef4ab 100644
--- a/tests/hermes_cli/test_update_interrupted_pull.py
+++ b/tests/hermes_cli/test_update_interrupted_pull.py
@@ -18,10 +18,13 @@ import pytest
 
 from hermes_cli import _early_recovery as er
 from hermes_cli import update_cmd
+from hermes_cli.update_custody import GIT_NO_DETACH
 
 
 def _git(root: Path, *args: str) -> str:
-    return subprocess.run(["git", "-C", str(root), *args], check=True, capture_output=True,
+    # A fixture commit of 100+ loose objects makes git >= 2.54 fork a detached geometric repack that
+    # packs and deletes those loose files while the next `git clone` of the repo is still copying them.
+    return subprocess.run(["git", *GIT_NO_DETACH, "-C", str(root), *args], check=True, capture_output=True,
                           text=True, encoding="utf-8").stdout.strip()
 
 
@@ -211,7 +214,7 @@ def test_restore_never_touches_user_work_when_git_wrote_nothing(checkout, capsys
     # following the printed advice leaves a merge in progress, and edits git never wrote are theirs.
     stale = f"pid=0\npre={_git(root, 'rev-parse', 'HEAD')}\ntarget={b}\nstash=\n"
     marker.write_text(stale, encoding="utf-8", newline="")
-    merge = subprocess.run(["git", "-C", str(root), "merge", "origin/main"],
+    merge = subprocess.run(["git", *GIT_NO_DETACH, "-C", str(root), "merge", "origin/main"],
                            capture_output=True, text=True, encoding="utf-8", check=False)
     assert (root / ".git" / "MERGE_HEAD").exists(), merge.stdout + merge.stderr
     (root / "utils.py").write_text("OLD = 1  # resolved by hand\n", encoding="utf-8", newline="")
