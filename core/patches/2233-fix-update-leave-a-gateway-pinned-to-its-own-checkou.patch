 hermes_cli/update_cmd_posix_pause.py          |   3 +
 hermes_cli/update_fleet_scope.py              |  32 +++-
 hermes_cli/update_receipt.py                  |   7 +
 .../test_update_pause_pinned_runtime.py       | 179 ++++++++++++++++++
 5 files changed, 230 insertions(+), 7 deletions(-)
