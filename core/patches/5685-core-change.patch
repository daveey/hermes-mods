From 48675c4780e40a36adfa770a5f291fb1952d3c60 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 05:59:55 +0000
Subject: [PATCH] test(auth): force live observations in quota boundary
 controls [daveey]

---
 tests/agent/test_codex_rotation_window.py            | 2 ++
 tests/agent/test_codex_rotation_window_boundaries.py | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/tests/agent/test_codex_rotation_window.py b/tests/agent/test_codex_rotation_window.py
index c65f2ca1ae..43a5a2af64 100644
--- a/tests/agent/test_codex_rotation_window.py
+++ b/tests/agent/test_codex_rotation_window.py
@@ -143,6 +143,8 @@ def test_rotation_exclusion_precedes_resync_and_quota_probe(tmp_path, monkeypatc
     resynced.clear()
     probed.clear()
     auth_codex._codex_quota_probe_cache.clear()
+    from hermes_cli.auth_codex_quota_negative import _path
+    _path().unlink(missing_ok=True)  # force the live-probe non-vacuity control, not the disk throttle
     available, pending = pool._available_entries(clear_expired=True)
     assert resynced == ["A", "B", "C"]
     assert probed == (["B", "C"] if other_walled else ["C"])
diff --git a/tests/agent/test_codex_rotation_window_boundaries.py b/tests/agent/test_codex_rotation_window_boundaries.py
index 1990aea399..a8259c3153 100644
--- a/tests/agent/test_codex_rotation_window_boundaries.py
+++ b/tests/agent/test_codex_rotation_window_boundaries.py
@@ -75,6 +75,8 @@ def test_singleton_positive_probe_only_clears_proven_row(tmp_path, monkeypatch,
     pool, rows, reset = _pool(tmp_path, monkeypatch, other_walled=True)
     assert _rotate(pool, reset) is None
     auth_codex._codex_quota_probe_cache.clear()
+    from hermes_cli.auth_codex_quota_negative import _path
+    _path().unlink(missing_ok=True)  # force a fresh upstream recovery observation
     payload = {"rate_limit": {"primary_window": {"used_percent": 0, "reset_at": reset}}}
     transport = httpx.MockTransport(lambda request: httpx.Response(200, json=payload))
     monkeypatch.setattr(auth_codex, "_codex_http_client", lambda **kwargs: httpx.Client(transport=transport))
-- 
2.43.0

