+@pytest.mark.parametrize('column,value', [('rev', 'bad'), ('floor', 'bad'), ('keys', 'bad'),
+                                         ('epoch', b'x'), ('nonce', b'x')])
+def test_corrupt_stamp_falls_back_without_exception(db, column, value):
