diff --git a/apps/desktop/src/store/onboarding.test.ts b/apps/desktop/src/store/onboarding.test.ts
index f95c28b038..6a0652ea28 100644
--- a/apps/desktop/src/store/onboarding.test.ts
+++ b/apps/desktop/src/store/onboarding.test.ts
@@ -7,10 +7,12 @@ import type { OAuthProvider } from '@/types/hermes'
 
 import {
   $desktopOnboarding,
+  closeManualOnboarding,
   completeDesktopOnboarding,
   confirmOnboardingModel,
   type DesktopOnboardingState,
   type OnboardingContext,
+  recheckExternalSignin,
   refreshOnboarding,
   requestDesktopOnboarding,
   resetBootRaceWindowForTests,
@@ -1218,3 +1220,167 @@ describe('setOnboardingModel', () => {
     }
   })
 })
+
+describe('credential-failure overlay on a configured install never overwrites the default', () => {
+  const model = 'claude-sonnet-5'
+  let calls: { body?: unknown; path: string }[] = []
+
+  function installBackend(mainModel: { model: string; provider: string }) {
+    calls = []
+
+    installApiMock(async ({ body, path }: { body?: unknown; path: string }) => {
+      calls.push({ body, path })
+
+      if (path.startsWith('/api/model/options')) {
+        return {
+          ...mainModel,
+          providers: [{ name: 'Anthropic', slug: 'anthropic', models: [model] }]
+        }
+      }
+
+      if (path.startsWith('/api/model/recommended-default?')) {
+        return { provider: 'anthropic', model, free_tier: false }
+      }
+
+      if (path === '/api/model/set') {
+        return { ok: true, provider: 'anthropic', model, gateway_tools: [] }
+      }
+
+      throw new Error(`unexpected api path: ${path}`)
+    })
+  }
+
+  const gateway: OnboardingContext['requestGateway'] = async (method, params) => {
+    if (method === 'reload.env') {
+      return {} as never
+    }
+
+    if (method === 'setup.runtime_check') {
+      // The runtime gate validates the just-connected provider directly.
+      expect(params).toEqual({ provider: 'anthropic' })
+
+      return { ok: true } as never
+    }
+
+    if (method === 'setup.status') {
+      return { provider_configured: true } as never
+    }
+
+    throw new Error(`unexpected gateway method: ${method}`)
+  }
+
+  const setCalls = () => calls.filter(c => c.path === '/api/model/set')
+
+  async function signInExternally(configured: boolean) {
+    $desktopOnboarding.set(
+      baseState({
+        configured,
+        // requestDesktopOnboarding(): credential failure, manual: false.
+        requested: true,
+        reason: 'ChatGPT usage limit reached',
+        flow: {
+          status: 'external_pending',
+          copied: false,
+          provider: { ...makeOAuthProvider('anthropic', 'Anthropic'), flow: 'external' }
+        }
+      })
+    )
+
+    await recheckExternalSignin(onboardingContext(gateway))
+  }
+
+  beforeEach(() => {
+    window.localStorage.clear()
+    $desktopOnboarding.set(baseState())
+  })
+
+  afterEach(() => {
+    window.localStorage.clear()
+    $desktopOnboarding.set(baseState())
+    resetBootRaceWindowForTests()
+    vi.restoreAllMocks()
+  })
+
+  it('writes nothing before the confirm card, and Begin writes exactly once', async () => {
+    installBackend({ model: 'gpt-6-astra', provider: 'openai-codex' })
+    await signInExternally(true)
+
+    const flow = $desktopOnboarding.get().flow
+    expect(flow.status).toBe('confirming_model')
+    expect(setCalls()).toHaveLength(0)
+
+    if (flow.status === 'confirming_model') {
+      expect(flow.deferPersist).toBe(true)
+      expect(flow.currentModel).toBe(model)
+    }
+
+    const onCompleted = vi.fn()
+    await confirmOnboardingModel({ requestGateway: gateway, onCompleted })
+
+    expect(setCalls()).toHaveLength(1)
+    expect(setCalls()[0]?.body).toMatchObject({ scope: 'main', provider: 'anthropic', model })
+    expect(onCompleted).toHaveBeenCalledTimes(1)
+  })
+
+  it('treats a configured main model as configured even when the cached flag is unknown', async () => {
+    installBackend({ model: 'gpt-6-astra', provider: 'openai-codex' })
+    await signInExternally(false)
+
+    expect($desktopOnboarding.get().flow.status).toBe('confirming_model')
+    expect(setCalls()).toHaveLength(0)
+  })
+
+  it('dismissing the confirm card leaves the default untouched', async () => {
+    installBackend({ model: 'gpt-6-astra', provider: 'openai-codex' })
+    await signInExternally(true)
+
+    closeManualOnboarding()
+
+    expect($desktopOnboarding.get().flow.status).toBe('idle')
+    expect(setCalls()).toHaveLength(0)
+  })
+
+  it('picking another model on the card only writes on Begin', async () => {
+    installBackend({ model: 'gpt-6-astra', provider: 'openai-codex' })
+    await signInExternally(true)
+
+    await setOnboardingModel('claude-opus-5', 'anthropic', 'Anthropic')
+    expect(setCalls()).toHaveLength(0)
+
+    await confirmOnboardingModel({ requestGateway: gateway })
+    expect(setCalls()).toHaveLength(1)
+    expect(setCalls()[0]?.body).toMatchObject({ provider: 'anthropic', model: 'claude-opus-5' })
+  })
+
+  it('a true first run (nothing configured) still pre-persists before the card', async () => {
+    installBackend({ model: '', provider: '' })
+    await signInExternally(false)
+
+    expect($desktopOnboarding.get().flow.status).toBe('confirming_model')
+    expect(setCalls()).toHaveLength(1)
+    expect(setCalls()[0]?.body).toMatchObject({ scope: 'main', provider: 'anthropic', model })
+
+    const flow = $desktopOnboarding.get().flow
+    expect(flow.status === 'confirming_model' && flow.deferPersist).toBeFalsy()
+  })
+
+  it('defers a local/custom endpoint on a configured install until Begin', async () => {
+    installBackend({ model: 'gpt-6-astra', provider: 'openai-codex' })
+
+    const probeApi = window.hermesDesktop.api
+    installApiMock(async (req: { path: string }) => {
+      if (req.path.startsWith('/api/providers/validate')) {
+        return { ok: true, reachable: true, models: ['local-m'], resolved_base_url: 'http://localhost:1234/v1' }
+      }
+
+      return probeApi(req as never)
+    })
+
+    $desktopOnboarding.set(baseState({ configured: true, requested: true }))
+    const result = await saveOnboardingLocalEndpoint('http://localhost:1234', 'k', onboardingContext(gateway))
+
+    expect(result.ok).toBe(true)
+    expect($desktopOnboarding.get().flow.status).toBe('confirming_model')
+    expect(setCalls()).toHaveLength(0)
+  })
+})
diff --git a/apps/desktop/src/store/onboarding.ts b/apps/desktop/src/store/onboarding.ts
index 9f1551fad4..edfc1f6d50 100644
--- a/apps/desktop/src/store/onboarding.ts
+++ b/apps/desktop/src/store/onboarding.ts
@@ -46,7 +46,15 @@ export type OnboardingFlow =
       // ModelPickerDialog, which fetches its own model list from
       // /api/model/options — no need to cache the list here.
       currentModel: string
+      // True when the app already has a main model configured: nothing has
+      // been written to config.yaml yet, and the confirm card is the ONLY
+      // thing that changes the default for new chats (Begin writes it,
+      // dismiss writes nothing). Absent on a genuine first run.
+      deferPersist?: boolean
       label: string
+      // Local / custom endpoint connected on a configured install: the
+      // endpoint details to write together with the model on Begin.
+      pendingEndpoint?: { apiKey: string; baseUrl: string }
       providerSlug: string
       saving: boolean
       status: 'confirming_model'
@@ -345,7 +353,7 @@ function notifyGatewayTools(tools: string[] | undefined) {
 async function fetchProviderDefaultModel(
   preferredSlugs: string[],
   profile?: ProfileScope
-): Promise<null | { providerSlug: string; defaultModel: string }> {
+): Promise<null | { defaultModel: string; mainModelConfigured: boolean; providerSlug: string }> {
   let options
 
   try {
@@ -360,6 +368,10 @@ async function fetchProviderDefaultModel(
     return null
   }
 
+  // The backend reports the model.default/provider currently in config.yaml.
+  // Both set means a default already exists that a silent write would clobber.
+  const mainModelConfigured = Boolean(String(options?.model ?? '').trim() && String(options?.provider ?? '').trim())
+
   // Try each preferred slug (lowercased), fall back to the first provider
   // returned (model.options orders by recency / authenticated state, so
   // the just-authenticated provider is usually first anyway).
@@ -384,7 +396,7 @@ async function fetchProviderDefaultModel(
     String(options?.provider ?? '').toLowerCase() === String(matched.slug).toLowerCase() &&
     models.map(String).includes(currentModel)
   ) {
-    return { providerSlug: String(matched.slug), defaultModel: currentModel }
+    return { providerSlug: String(matched.slug), defaultModel: currentModel, mainModelConfigured }
   }
 
   // Prefer the backend's recommended default — it mirrors the curation
@@ -410,10 +422,22 @@ async function fetchProviderDefaultModel(
 
   return {
     providerSlug: String(matched.slug),
-    defaultModel
+    defaultModel,
+    mainModelConfigured
   }
 }
 
+// True when the global default must NOT be written until the user confirms on
+// the card: the user opened the picker from a working app (manual), or the
+// install already has a configured main model (credential-failure overlay,
+// runtime-not-ready with a model set). Only a genuine first run — no main model
+// anywhere — may pre-persist.
+function shouldDeferGlobalDefault(mainModelConfigured: boolean) {
+  const state = $desktopOnboarding.get()
+
+  return state.manual || state.configured === true || mainModelConfigured
+}
+
 // After OAuth/API-key success: reload the backend env, verify runtime,
 // then either show the model-confirm step or fall straight through to
 // completion if we can't determine a default.
@@ -449,19 +473,21 @@ async function completeWithModelConfirm(
     return
   }
 
-  // Manual connect (Settings / model picker "Add provider" on an already-
-  // configured install): the global default must NOT change until the user
-  // explicitly confirms a model on the confirm card. checkRuntime below
-  // already passes preferredSlugs[0] as requestedProvider, so the runtime
-  // gate can validate the just-connected provider without persisting first.
-  // confirmOnboardingModel persists on Begin instead.
-  const manual = $desktopOnboarding.get().manual
-
-  if (defaults && !manual) {
-    // First-run only: persist the chosen provider/model before the runtime
-    // gate so a stale config provider (e.g. anthropic from a prior failed
-    // setup) cannot make setup.runtime_check validate the wrong backend
-    // after a fresh OAuth login. There's no prior default to protect here.
+  // Any overlay on an already-configured install (manual Settings / "Add
+  // provider", or the credential-failure overlay that opens on its own): the
+  // global default must NOT change until the user explicitly confirms a model
