diff --git a/tests/hermes_cli/test_review_forwarded_history.py b/tests/hermes_cli/test_review_forwarded_history.py
new file mode 100644
index 0000000000..f2da720a4c
--- /dev/null
+++ b/tests/hermes_cli/test_review_forwarded_history.py
@@ -0,0 +1,56 @@
+"""Independent real forwarding producer to common creation boundary."""
+import pytest
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli.kanban_placement_forward import remote_args
+from tests.hermes_cli import test_kanban_model_tier as fixtures
+board = fixtures.board
+
+@pytest.mark.parametrize('where', ['control', 'title', 'parent_title', 'parent_summary', 'parent_handoff'])
+@pytest.mark.parametrize('legacy', ['Independent primary Opus review required',
+                                  'Must use "claude-opus-5-5" only\nrequire_model: true'])
+def test_forwarded_history_remains_creatable(board, where, legacy):
+    with kbc.connect() as conn:
+        parent = kb.create_task(conn, title='source work', assignee='default')
+        tid = kb.create_task(conn, title='ordinary forwarded work', assignee='default', parents=[parent])
+        if where == 'title':
+            conn.execute('UPDATE tasks SET title=? WHERE id=?', (legacy, tid))
+        elif where == 'parent_title':
+            conn.execute('UPDATE tasks SET title=? WHERE id=?', (legacy, parent))
+        elif where == 'parent_summary':
+            conn.execute('UPDATE tasks SET result=? WHERE id=?', (legacy, parent))
+        elif where == 'parent_handoff':
+            kb.complete_task(conn, parent, summary=legacy, force=True)
+        conn.commit()
+        args = remote_args(conn, kb.get_task(conn, tid), self_gw='source')
+        created = kb.create_task(conn, title=args['title'], body=args['body'], assignee=args['assignee'],
+                                 model_override=args['model'], provider_override=args['provider'])
+        assert kb.get_task(conn, created) is not None
+        assert (args['model'], args['provider']) == (None, None)
+        source = kb.get_task(conn, tid)
+        assert source is not None
+        if where == 'title':
+            assert args['title'] == f'Continue forwarded work {tid}'
+            assert source.title == legacy
+        else:
+            assert args['title'] == source.title == 'ordinary forwarded work'
+        if where != 'control':
+            from hermes_cli.kanban_model_neutral import _EVIDENCE
+            import json
+            restored = '\n'.join(json.loads(line.lstrip()[len(_EVIDENCE):])
+                                 if line.lstrip().startswith(_EVIDENCE) else line
+                                 for line in args['body'].splitlines())
+            assert legacy in restored
+            parent_source = kb.get_task(conn, parent)
+            assert parent_source is not None
+            preserved = (source.title if where == 'title' else parent_source.title if where == 'parent_title'
+                         else kb.latest_summaries(conn, [parent])[parent] if where == 'parent_handoff'
+                         else parent_source.result)
+            assert legacy == preserved
+        # Serialized history does not exempt newly appended active instructions.
+        before = conn.execute('SELECT COUNT(*) FROM tasks').fetchone()[0]
+        for field in ('title', 'body'):
+            with pytest.raises(ValueError, match='model-neutral'):
+                kb.create_task(conn, title=legacy if field == 'title' else args['title'],
+                               body=args['body'] + ('\nMust use claude-opus-5-5 only' if field == 'body' else ''),
+                               assignee=args['assignee'])
+        assert conn.execute('SELECT COUNT(*) FROM tasks').fetchone()[0] == before
diff --git a/tests/hermes_cli/test_review_wall_reason_family.py b/tests/hermes_cli/test_review_wall_reason_family.py
new file mode 100644
index 0000000000..388c4b0866
--- /dev/null
+++ b/tests/hermes_cli/test_review_wall_reason_family.py
@@ -0,0 +1,47 @@
+"""Independent family probe: every resolved class obeys known quota walls."""
+import pytest
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as dispatch, kanban_model_tier as tier, kanban_provider_walls as walls
+from tests.hermes_cli import test_kanban_quota_episode as fixtures
+from tests.hermes_cli.test_kanban_quota_episode_walls import _class_routes, _clock
+
+board = fixtures.board
+
+@pytest.mark.parametrize('case', ['default', 'explicit', 'pattern', 'out_of_scope', 'retry'])
+@pytest.mark.parametrize('walled', [True, False])
+def test_resolved_class_wall(board, monkeypatch, all_assignees_spawnable, case, walled):
+    clock = _clock(monkeypatch)
+    config, _ = fixtures.routing(monkeypatch)
+    _class_routes(config, standard=[('openai-codex', 'gpt-6-astra')], deep=[('anthropic', 'claude-opus-5-5')])
+    cfg = {'default_model': 'class:standard'}
+    if case == 'pattern':
+        cfg['default_model_keep_patterns'] = ['complex work']
+    if case == 'out_of_scope':
+        cfg['default_model_profiles'] = ['other']
+    monkeypatch.setattr(tier, 'load_tier_config', lambda: cfg)
+    monkeypatch.setattr(walls, 'active_walls', lambda **kw: {'openai-codex': clock[0]+900, 'anthropic': clock[0]+900} if walled else {})
+    monkeypatch.setattr(walls, 'live_quota_wall', lambda *args: clock[0]+900 if walled else None)
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title='complex work', assignee='a', model_override='class:deep' if case == 'explicit' else None)
+        if case == 'retry':
+            assert kb.claim_task(conn, tid) is not None
+            # Historical non-quota crash: retain its run, measure only new claims.
+            conn.execute("UPDATE task_runs SET status='crashed', outcome='crashed', ended_at=1 WHERE task_id=?", (tid,))
+            conn.execute("UPDATE tasks SET status='ready', claim_lock=NULL, claim_expires=NULL, current_run_id=NULL "
+                         "WHERE id=?", (tid,))
+            conn.commit()
+        initial_runs = conn.execute('SELECT COUNT(*) FROM task_runs WHERE task_id=?', (tid,)).fetchone()[0]
+        route = tier.resolve_model_tier(conn, kb.get_task(conn, tid), lane='ready')
+        expected_reason = {'default': 'default', 'explicit': 'class', 'pattern': 'pattern:complex work',
+                           'out_of_scope': 'profile_out_of_scope', 'retry': 'retry_after_run_crashed'}[case]
+        assert route == ('class:standard' if case in ('default', 'out_of_scope') else 'class:deep', 'auto', expected_reason)
+        launched = []
+        result = dispatch.dispatch_once(conn, spawn_fn=lambda task, ws: launched.append((task.model_override, task.provider_override)))
+        runs = conn.execute('SELECT COUNT(*) FROM task_runs WHERE task_id=?', (tid,)).fetchone()[0] - initial_runs
+        assert (len(launched), runs) == ((0, 0) if walled else (1, 1)), (case, route, launched, runs, result)
+        stored = kb.get_task(conn, tid)
+        assert stored is not None
+        if walled:
+            assert stored.status == 'ready' and stored.claim_lock is None
+            assert tid in result.clock_held
+        assert (stored.model_override, stored.provider_override) == (('class:deep', 'auto') if case == 'explicit' else (None, None))
