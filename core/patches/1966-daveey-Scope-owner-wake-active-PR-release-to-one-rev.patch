diff --git a/hermes_cli/kanban_hold_release.py b/hermes_cli/kanban_hold_release.py
new file mode 100644
index 00000000000..836eca1676c
--- /dev/null
+++ b/hermes_cli/kanban_hold_release.py
@@ -0,0 +1,152 @@
+"""Machine-checked owner-wake recovery, scoped to one dependency park. [daveey]
+
+This is NOT an unblock or merge approval. Only the authenticated tool grant calls
+release; a new run consumes the receipt even if that run crashes. Generic handoff
+and recent-success guards deliberately do not recognize this event.
+"""
+from __future__ import annotations
+
+import time
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_dependency_review as review
+
+
+def _identity(row):
+    return {"run_uid": row["uid"]} if "uid" in row.keys() and row["uid"] else {"run_id": row["id"]}
+
+
+def _park(conn, task_id):
+    row = conn.execute(
+        "SELECT e.payload, e.created_at, r.*, t.assignee FROM task_events e "
+        "JOIN task_runs r ON r.id=e.run_id JOIN tasks t ON t.id=e.task_id "
+        "WHERE e.task_id=? AND e.kind='dependency_wait' AND r.task_id=t.id "
+        "AND r.id=(SELECT MAX(id) FROM task_runs WHERE task_id=t.id) "
+        "ORDER BY e.id DESC LIMIT 1", (task_id,),
+    ).fetchone()
+    if row is None or row["outcome"] != "blocked" or row["profile"] != row["assignee"]:
+        raise ValueError("hold release requires latest orderly owner park")
+    payload = kb._json_dict(row["payload"])
+    evidence = payload.get("review_checkpoint")
+    if (not review._checkpoint_matches_run(evidence, row)
+            or payload.get("kind") != "dependency"
+            or payload.get("source_status") not in {"ready", "review"}):
+        raise ValueError("hold release requires authenticated dependency checkpoint")
+    parked = kb._to_epoch(row["created_at"])
+    if parked is None or row["ended_at"] is None:
+        raise ValueError("hold release requires portable completed park identity")
+    if not conn.execute("SELECT 1 FROM task_events WHERE task_id=? AND run_id=? AND kind='claimed'",
+                        (task_id, row["id"])).fetchone():
+        raise ValueError("hold release requires claimed owner run")
+    return row, evidence, parked
+
+
+def _scope(conn, task_id):
+    row, evidence, parked = _park(conn, task_id)
+    parents = kb.parent_ids(conn, task_id)
+    original = evidence.get("parents")
+    if (not isinstance(original, list) or not original
+            or not all(isinstance(p, str) for p in original)
+            or not set(original).issubset(parents) or kb.unsatisfied_parents(conn, task_id)):
+        raise ValueError("hold release requires retained satisfied dependencies")
+    captured = evidence.get("prs")
+    if (not isinstance(captured, list) or not captured
+            or not all(isinstance(u, str) and u.startswith("https://github.com/") for u in captured)):
+        raise ValueError("hold release requires captured PR scope")
+    captured = {u.rstrip("/").lower() for u in captured}
+    covered = set()
+    proofs = []
+    for parent in parents:
+        result = review._completed_review_run(conn, parent, parked, row["id"])
+        if result is None:
+            continue
+        data = kb._json_dict(result["metadata"])
+        named = review._named_prs(data, captured)
+        if not named or not review._exact_head(data):
+            continue
+        covered.update(named)
+        proofs.append({"task": parent, **_identity(result), "metadata": {
+            k: data[k] for k in ("pr", "reviewed_pr", "reviewed_sha", "head", "exact_head") if k in data}})
+    if not captured.issubset(covered):
+        raise ValueError("hold release requires independent explicit-PR exact-head review after park")
+    return row, captured, proofs
+
+
+def _check_publications(conn, task_id, captured):
+    from hermes_cli.kanban_db_dispatch import _RESPAWN_GUARD_PR_URL_RE
+    from hermes_cli.kanban_db_dispatch_pr_state import _foreign_pr_comment_ids
+    foreign = _foreign_pr_comment_ids(conn, task_id)
+    for comment in conn.execute("SELECT * FROM task_comments WHERE task_id=?", (task_id,)):
+        if comment["id"] in foreign or comment["author"] == "kanban-dispatcher":
+            continue
+        urls = {u.rstrip("/").lower() for u in _RESPAWN_GUARD_PR_URL_RE.findall(comment["body"] or "")}
+        if not urls.issubset(captured):
+            raise ValueError("hold release PR publication scope changed")
+        at = kb._to_epoch(comment["created_at"])
+        if urls and (at is None or at >= int(time.time())):
+            raise ValueError("hold release must strictly follow PR publication")
+
+
+def _event_tip(conn, task_id):
+    return conn.execute("SELECT COALESCE(MAX(id),0) FROM task_events WHERE task_id=?", (task_id,)).fetchone()[0]
+
+
+def release(conn, task_id, *, supervisor, supervisor_board, precondition):
+    """Called only with a live exact-target tool grant; never via generic unblock.
+
+    Network-capable admission runs before the write transaction. Its event tip
+    must be unchanged inside the transaction; all local eligibility is rechecked.
+    """
+    from hermes_cli.kanban_db_connect import write_txn
+    from hermes_cli.kanban_db_dispatch import check_respawn_guard
+    from hermes_cli.kanban_wake_check import foreign_copy
+
+    tip = _event_tip(conn, task_id)
+    if check_respawn_guard(conn, task_id) != "active_pr":
+        raise ValueError("hold release requires active_pr hold")
+    with write_txn(conn):
+        error = precondition(conn)
+        if error:
+            raise ValueError(error)
+        task = kb.get_task(conn, task_id)
+        if (task is None or task.status != "ready" or task.current_run_id is not None
+                or task.claim_lock or task.claim_expires):
+            raise ValueError("hold release requires unclaimed READY target")
+        if foreign_copy(conn, task_id):
+            raise ValueError("hold release requires local home authority")
+        if _event_tip(conn, task_id) != tip:
+            raise ValueError("hold release admission changed; retry")
+        row, captured, proofs = _scope(conn, task_id)
+        _check_publications(conn, task_id, captured)
+        for event in conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='hold_released'", (task_id,)):
+            if review._checkpoint_matches_run(kb._json_dict(event[0]).get("park"), row):
+                raise ValueError("hold release already used for this park")
+        kb._append_event(conn, task_id, "hold_released", {
+            "via": "owner-wake-hold-release", "supervisor": supervisor,
+            "supervisor_board": supervisor_board, "park": _identity(row),
+            "prs": sorted(captured), "reviews": proofs,
+            "scope": "one_continuation", "merge_authorized": False,
+        })
+
+
+def released_after(conn, task_id, since, pr_urls):
+    """A receipt older than any claim, or tied with publication, grants nothing."""
+    from hermes_cli.kanban_wake_check import foreign_copy
+    run = conn.execute("SELECT * FROM task_runs WHERE task_id=? ORDER BY id DESC LIMIT 1", (task_id,)).fetchone()
+    if run is None:
+        return False
+    urls = {u.rstrip("/").lower() for u in pr_urls}
+    for event in conn.execute("SELECT payload, created_at FROM task_events WHERE task_id=? AND kind='hold_released'",
+                              (task_id,)):
+        data = kb._json_dict(event["payload"])
+        at = kb._to_epoch(event["created_at"])
+        captured = data.get("prs")
+        if (at is not None and at > since and at <= int(time.time())
+                and data.get("via") == "owner-wake-hold-release"
+                and data.get("scope") == "one_continuation" and data.get("merge_authorized") is False
+                and review._checkpoint_matches_run(data.get("park"), run)
+                and ("run_uid" in data["park"] or not foreign_copy(conn, task_id))
+                and isinstance(captured, list) and all(isinstance(u, str) for u in captured)
+                and urls and urls.issubset(captured)):
+            return True
+    return False
diff --git a/tests/tools/test_kanban_hold_release_transport.py b/tests/tools/test_kanban_hold_release_transport.py
new file mode 100644
index 00000000000..28a339eff63
--- /dev/null
+++ b/tests/tools/test_kanban_hold_release_transport.py
@@ -0,0 +1,49 @@
+"""Release receipt transport and cross-board tool entry paths."""
+import json
+import time
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as dispatch
+from hermes_cli.kanban_hold_release import release
+from tests.hermes_cli import test_kanban_dependency_review_sync as sync_tests
+from tests.tools import test_kanban_owner_wake_hold_release as cases
+from tests.tools import test_kanban_owner_wake_requeue as wake
+
+boards = sync_tests.boards
+board = wake.board
+
+
+def test_receipt_survives_remapped_ids_and_is_consumed(boards, monkeypatch):
+    source, target = boards
+    task, _, sup = cases.held(source, monkeypatch)
+    now = int(time.time()) + 2
+    monkeypatch.setattr(time, "time", lambda: now)
+    release(source, task, supervisor=sup, supervisor_board="default", precondition=lambda _: None)
+    sync_tests.transport(source, target)
+    src, dst = sync_tests.checkpoint_row(source, task), sync_tests.checkpoint_row(target, task)
+    assert src["run_id"] != dst["run_id"]
+    assert dispatch.check_respawn_guard(target, task) is None
+    assert kb.claim_task(target, task) is not None
+    assert dispatch.check_respawn_guard(target, task) == "active_pr"
+
+
+def test_cross_board_ready_release(board, monkeypatch):
+    from tools import kanban_tools as kt
+    kb.create_board("ops")
+    with kbc.connect_closing() as own, kbc.connect_closing(board="ops") as target_conn:
+        task, _, _ = cases.held(target_conn, monkeypatch)
+        # Rebind to the real caller on default; target owns its review history.
+        monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+        monkeypatch.delenv("HERMES_KANBAN_RUN_ID", raising=False)
+        sup = wake._supervisor(own, kb, [wake._line(f"ops/{task}")])
+        monkeypatch.setenv("HERMES_KANBAN_DB", str(kb.kanban_db_path()))
+        wake._as_worker(monkeypatch, own, kb, sup)
+        now = int(time.time()) + 2
+        monkeypatch.setattr(time, "time", lambda: now)
+        assert not json.loads(kt._handle_unblock({"task_id": task, "board": "default"})).get("ok")
+        out = json.loads(kt._handle_unblock({"task_id": task, "board": "ops"}))
+        assert out.get("ok"), out
+        assert out["via"] == "owner-wake-hold-release"
+        assert dispatch.check_respawn_guard(target_conn, task) is None
+        assert not any(e.kind == "hold_released" for e in kb.list_events(own, sup))
diff --git a/tests/tools/test_kanban_owner_wake_hold_release.py b/tests/tools/test_kanban_owner_wake_hold_release.py
new file mode 100644
index 00000000000..15196d0824d
--- /dev/null
+++ b/tests/tools/test_kanban_owner_wake_hold_release.py
@@ -0,0 +1,88 @@
+"""Scoped recovery of a replaced review; never a generic READY unblock."""
+import time
+import json
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as dispatch
+from hermes_cli import kanban_db_dispatch_pr_state as prs
+from tests.hermes_cli import test_kanban_dependency_review as reviews
+from tests.tools import test_kanban_owner_wake_requeue as wake
+
+board = wake.board
+
+
+def held(conn, monkeypatch):
+    monkeypatch.setattr(prs, "pr_state", lambda _: "OPEN")
+    task, old = reviews.parked(conn)
+    # Original result is administratively completed, not a claimed review.
+    for parent in old:
+        assert kb.complete_task(conn, parent, summary="Old review", metadata={"reviewed_head": "a" * 40})
+    replacement = kb.create_task(conn, title="replacement review", assignee="reviewer")
+    kb.link_tasks(conn, replacement, task)
+    reviews.finish_reviews(conn, [replacement], metadata={
+        "reviewed_pr": reviews.PR, "reviewed_sha": "a" * 40, "verdict": "approve"})
+    assert kb.get_task(conn, task).status == "ready"
+    assert dispatch.check_respawn_guard(conn, task) == "active_pr"
+    sup = wake._supervisor(conn, kb, [wake._line(f"default/{task}")])
+    wake._as_worker(monkeypatch, conn, kb, sup)
+    return task, replacement, sup
+
+
+@pytest.mark.parametrize("defect", ["short_sha", "absent_pr", "unrelated_pr", "unclaimed", "before_park",
+                                  "revoked", "unlisted", "foreign", "claim_race", "new_pr"])
+def test_release_refuses_invalid_evidence(board, monkeypatch, defect):
+    from hermes_cli import kanban_wake_check
+    from tests.hermes_cli.kanban_guard_helpers import worker_comment
+    with kbc.connect() as conn:
+        task, replacement, sup = held(conn, monkeypatch)
+        now = int(time.time()) + 2
+        monkeypatch.setattr(time, "time", lambda: now)
+        metadata = {
+            "short_sha": {"reviewed_pr": reviews.PR, "reviewed_sha": "abc"},
+            "absent_pr": {"reviewed_sha": "a" * 40},
+            "unrelated_pr": {"reviewed_pr": reviews.PR + "9", "reviewed_sha": "a" * 40},
+        }
+        sql = {
+            "unclaimed": ("DELETE FROM task_events WHERE task_id=? AND kind='claimed'", replacement),
+            "before_park": ("UPDATE task_runs SET ended_at=1 WHERE task_id=?", replacement),
+            "revoked": ("UPDATE tasks SET current_run_id=NULL WHERE id=?", sup),
+            "unlisted": ("UPDATE tasks SET body='No grants' WHERE id=?", sup),
+            "claim_race": ("UPDATE tasks SET claim_lock='other' WHERE id=?", task),
+        }
+        if defect in metadata:
+            conn.execute("UPDATE task_runs SET metadata=? WHERE task_id=?", (json.dumps(metadata[defect]), replacement))
+        if defect in sql:
+            statement, target = sql[defect]
+            conn.execute(statement, (target,))
+        if defect == "foreign":
+            monkeypatch.setattr(kanban_wake_check, "foreign_copy", lambda *_: True)
+        if defect == "new_pr":
+            worker_comment(conn, task, "dev", reviews.PR + "9")
+        conn.commit()
+        out = wake._unblock(task)
+        assert out.get("ok") is not True, out
+        assert not any(e.kind == "hold_released" for e in kb.list_events(conn, task))
+
+
+def test_exact_target_release_is_single_use(board, monkeypatch):
+    with kbc.connect() as conn:
+        task, _, _ = held(conn, monkeypatch)
+        # Explicitly later than publication, including on second-resolution stores.
+        now = int(time.time()) + 2
+        monkeypatch.setattr(time, "time", lambda: now)
+        out = wake._unblock(task)
+        assert out.get("ok") is True, out
+        assert out["via"] == "owner-wake-hold-release"
+        assert kb.get_task(conn, task).status == "ready"
+        assert dispatch.check_respawn_guard(conn, task) is None
+        assert wake._unblock(task).get("ok") is not True
+        events = kb.list_events(conn, task)
+        assert not any(e.kind == "unblocked" for e in events)
+        assert sum(e.kind == "hold_released" for e in events) == 1
+        assert kb.claim_task(conn, task) is not None
+        assert dispatch.check_respawn_guard(conn, task) == "active_pr"
+        assert kb.reclaim_task(conn, task, reason="Worker died", signal_fn=lambda *_: None)
+        assert dispatch.check_respawn_guard(conn, task) == "active_pr"
