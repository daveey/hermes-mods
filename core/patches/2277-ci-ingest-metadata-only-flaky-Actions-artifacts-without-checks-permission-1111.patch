+
+    def simple(self, run_id: int = 5, tests: tuple[str, ...] = (), art_id: int = 100) -> None:
+        """One run, one slice, one complete artifact."""
+        self.run(run_id)
+        self.jobs[(run_id, 1)] = [job(9)]
+        self.artifacts[run_id] = [artifact(art_id, run_id)]
