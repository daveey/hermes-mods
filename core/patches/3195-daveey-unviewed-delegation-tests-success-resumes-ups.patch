From 56c52f7c63b66f44af1210ba486a0ea6cb92796e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 05:14:36 +0000
Subject: [PATCH] [daveey] unviewed delegation tests: success resumes
 (upstream), requested stop stays a note (fork)

---
 .../test_unviewed_delegation_failure_turn.py  | 24 +++++++++++--------
 1 file changed, 14 insertions(+), 10 deletions(-)

diff --git a/tests/gateway/test_unviewed_delegation_failure_turn.py b/tests/gateway/test_unviewed_delegation_failure_turn.py
index cd47818aad..16b4a4b292 100644
--- a/tests/gateway/test_unviewed_delegation_failure_turn.py
+++ b/tests/gateway/test_unviewed_delegation_failure_turn.py
@@ -5,9 +5,9 @@ call. That is right for a result the parent will read next time, but a failed su
 parent's plan stalled until a human returns: a provider refusal (``content_policy_blocked``) stopped a
 background subagent and the parent sat on the note for 48 minutes. A final delegation result with a
 failed child now runs as the parent's turn, so it can re-dispatch (on another model) or report, as a
-successful one does (test_unviewed_completion_resumes_parent.py). The early per-task notice stays a
-note. So do a manual cron run's result, a failure in a chat its viewer closed, and a failure past the
-unattended-wake limit.
+successful one does (test_unviewed_completion_resumes_parent.py). The early per-task notice and a stop
+someone asked for stay notes. So do a manual cron run's result, a failure in a chat its viewer closed,
+and a failure past the unattended-wake limit.
 """
 import pytest
 
@@ -53,8 +53,8 @@ def _notes(authority, target, name):
     (("timeout",), True),
     (("completed", "failed"), True),        # one failed sibling is enough
     (("completed",), True),                 # a finished result resumes the parent too
-    (("interrupted",), True),               # unbounded like a success: a stop is not a failure
-    (("cancelled", "completed"), True),
+    (("interrupted",), False),              # a stop someone asked for stays a note (requested_stop)
+    (("cancelled", "completed"), False),
 ], ids=["refused", "timeout", "mixed", "success", "interrupted", "cancelled"])
 async def test_unviewed_failed_delegation_runs_as_a_turn(tmp_path, monkeypatch, statuses, turn):
     runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
@@ -153,8 +153,8 @@ def _batch_event(status):
                          ids=["stall-monitor", "user-stop"])
 async def test_unit_the_stall_monitor_stopped_wakes_the_parent(tmp_path, monkeypatch, stall, failed):
     """A stuck child that honours the stall monitor's stop reports ``interrupted``, as a user stop does:
-    the unit's stall context is what makes it a failure to recover from (bounded, and told why). Both
-    resume the parent."""
+    the unit's stall context is what makes it a failure to recover from (bounded, and told why). A user
+    stop is a requested stop: it stays a note."""
     runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
     try:
         route, target = authority.sessions[ref.session_id].route, _target(runner, authority, ref)
@@ -162,8 +162,10 @@ async def test_unit_the_stall_monitor_stopped_wakes_the_parent(tmp_path, monkeyp
         assert await runner._deliver_async_delegation_group([evt]) is True
         seen = _turns(runner, authority, target, "deleg_stall")
         await authority._drain(ref)
-        assert len(seen) == 1 and _notes(authority, target, "deleg_stall") == []
-        assert ("stall monitor stopped this unit after 600s" in seen[0][0]) is failed
+        assert len(seen) == int(failed)
+        assert len(_notes(authority, target, "deleg_stall")) == int(not failed)
+        if failed:
+            assert "stall monitor stopped this unit after 600s" in seen[0][0]
         assert authority.sessions[ref.session_id].unattended_wakes == int(failed)
     finally:
         authority.db.close()
@@ -237,9 +239,11 @@ async def test_requested_stop_is_logged_only_when_it_is_kept_as_a_note(tmp_path,
 
 @pytest.mark.asyncio
 async def test_unviewed_successful_result_is_a_note_without_a_warning(tmp_path, monkeypatch, caplog):
-    """A finished result the parent reads next time is the ordinary note: nothing was left undone."""
+    """A finished result kept as a note (the note path, with upstream's resume of an unviewed parent off;
+    test_unviewed_completion_resumes_parent.py covers the resume) logs no warning: nothing was left undone."""
     import logging
     caplog.set_level(logging.WARNING)
+    monkeypatch.setattr("tools.process_registry_notifications.completion_resumes_parent", lambda evt: False)
     runner, authority, ref, _actor = await _local(tmp_path, monkeypatch)
     try:
         route, target = authority.sessions[ref.session_id].route, _target(runner, authority, ref)
-- 
