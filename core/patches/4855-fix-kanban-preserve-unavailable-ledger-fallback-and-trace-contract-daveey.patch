From a174785fd4dfc3c534a2d3718a05722029868c9c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 10:29:55 +0000
Subject: [PATCH] fix(kanban): preserve unavailable-ledger fallback and trace
 contract [daveey]

---
 tui_gateway/kanban_remote_notices.py      | 3 ++-
 tui_gateway/kanban_remote_observations.py | 6 +++---
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/tui_gateway/kanban_remote_notices.py b/tui_gateway/kanban_remote_notices.py
index 50998dc1213aa1ac41e8ce6226b14d810783c25e..04c7bf17819f74bb6e3322529ae16c2301a61eae 100644
--- a/tui_gateway/kanban_remote_notices.py
+++ b/tui_gateway/kanban_remote_notices.py
@@ -1353,7 +1353,8 @@ def _deliver_link(owner, key, task, link, *, me, ref, state, path, live, session
                 return
             if waker is None:
                 from tui_gateway.kanban_remote_identity import moved_claim
-                with contextlib.closing(_ledger(ledger)) as conn:
+                # The passive sweep historically works in memory when its ledger is unavailable.
+                with contextlib.suppress(sqlite3.Error, OSError), contextlib.closing(_ledger(ledger)) as conn:
                     if moved_claim(conn, session=sid, ref=ref, state=state, now=now or time.time(),
                                    notice_key=event_key, swept_key=memo_key,
                                    transcript_has=lambda k, t: notice_in_transcript(db, tip, k, t)) is not None:
diff --git a/tui_gateway/kanban_remote_observations.py b/tui_gateway/kanban_remote_observations.py
index d36cbff06eed15590e4b6421c47627367b708bf5..c39f2016b30a5bc870f2821f9b96e84fbae64ed6 100644
--- a/tui_gateway/kanban_remote_observations.py
+++ b/tui_gateway/kanban_remote_observations.py
@@ -168,12 +168,12 @@ def _persist(source: str, cards: list[tuple], ledger, now: float, extra=()) -> d
             for key, state, ref, at, answer in missing:
                 # Unknown ages and frozen legacy keys cannot establish local freshness.
                 seen = now if at is not None and key.count('/') >= 2 and (not initial or now - at <= FRESH_S) else None
-                rows = conn.execute("SELECT ref, first_seen FROM observations WHERE source=? AND state=? "
+                rows = conn.execute("SELECT first_seen, ref FROM observations WHERE source=? AND state=? "
                                     "AND substr(ref, instr(ref, '/') + 1)=?",
                                     (source, state, key)).fetchall()
                 if rows:
-                    seen = None if any(row[1] is None for row in rows) else min(row[1] for row in rows)
-                if not any(row[0] == ref for row in rows):
+                    seen = None if any(row[0] is None for row in rows) else min(row[0] for row in rows)
+                if not any(row[1] == ref for row in rows):
                     conn.execute("INSERT INTO observations VALUES (?,?,?,?)", (source, ref, state, seen))
                 if answer:
                     added[(ref, state)] = seen
-- 
2.43.0

