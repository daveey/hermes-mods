From ad95bb2668d6c6ff6edd03f0e4104282994dd203 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 06:43:21 +0000
Subject: [PATCH 6338] Sized titlebar tools and Sessions tab-strip contributions

Public mirror of source commit ad95bb2668d6c6ff6edd03f0e4104282994dd203.

---
diff --git a/apps/desktop/src/app/shell/titlebar-controls.tsx b/apps/desktop/src/app/shell/titlebar-controls.tsx
index 66727ac8e1f..979f19b2e70 100644
--- a/apps/desktop/src/app/shell/titlebar-controls.tsx
+++ b/apps/desktop/src/app/shell/titlebar-controls.tsx
@@ -316,10 +316,16 @@
 
   const view = appViewForPath(location.pathname)
 
-  // Route changes can replace measured clusters without resizing the panels.
+  // Route changes can replace measured clusters without resizing the panels;
+  // so can a plugin tool registering after first paint (the tools cluster mounts).
+  const paneToolsKey = tools
+    .filter(visibleTool)
+    .map(tool => `${tool.id}:${tool.span ?? 1}`)
+    .join(',')
+
   useEffect(() => {
     window.dispatchEvent(new CustomEvent(TITLEBAR_CHROME_CHANGED_EVENT))
-  }, [location.pathname, pageOwnsTitlebar])
+  }, [location.pathname, pageOwnsTitlebar, paneToolsKey])
 
   // Overlays own the window. These clusters are `fixed` at a higher z-index
   // than the overlay card, so they'd otherwise bleed over it — hide them (and
@@ -386,6 +392,8 @@
             titlebarToolClusterClass,
             'top-[calc(var(--titlebar-controls-top)+var(--right-rail-top-inset,0px))] right-[calc(var(--titlebar-tools-right)+var(--shell-preview-toolbar-gap,0))]'
           )}
+          // Measured by usePanelTitlebar so the pane drag handle stops short of these tools.
+          data-titlebar-cluster="tools"
         >
           {visiblePaneTools.map(tool => (
             <TitlebarToolButton key={tool.id} navigate={navigate} tool={tool} />
diff --git a/apps/desktop/src/components/pane-shell/tree/renderer/panel-titlebar.test.tsx b/apps/desktop/src/components/pane-shell/tree/renderer/panel-titlebar.test.tsx
index e9a51239aa4..5d52046f0fb 100644
--- a/apps/desktop/src/components/pane-shell/tree/renderer/panel-titlebar.test.tsx
+++ b/apps/desktop/src/components/pane-shell/tree/renderer/panel-titlebar.test.tsx
@@ -71,6 +71,35 @@
     expect(element.style.getPropertyValue('--panel-titlebar-left')).toBe('86px')
   })
 
+  it('reserves the contributed pane-tools cluster too, so the window-drag handle never covers its buttons', () => {
+    // Plugin titlebar tools (titleBar.tools.right) render in their own cluster
+    // left of the fixed one. Electron app-region ignores stacking, so a drag
+    // handle under them turns every real click into a window drag.
+    const tools = document.createElement('div')
+    tools.dataset.titlebarCluster = 'tools'
+    tools.getBoundingClientRect = () => rect(500, 384)
+    document.body.append(tools)
+    const element = document.createElement('div')
+    element.getBoundingClientRect = () => rect(0, 1000)
+    document.body.append(element)
+
+    renderHook(() => usePanelTitlebar({ current: element }, true, false))
+    expect(element.style.getPropertyValue('--panel-titlebar-right')).toBe('500px')
+  })
+
+  it('ignores a pane-tools cluster pushed below the titlebar band (right rail inset)', () => {
+    const tools = document.createElement('div')
+    tools.dataset.titlebarCluster = 'tools'
+    tools.getBoundingClientRect = () => ({ ...rect(500, 384), bottom: 74, top: 40, y: 40 }) as DOMRect
+    document.body.append(tools)
+    const element = document.createElement('div')
+    element.getBoundingClientRect = () => rect(0, 1000)
+    document.body.append(element)
+
+    renderHook(() => usePanelTitlebar({ current: element }, true, false))
+    expect(element.style.getPropertyValue('--panel-titlebar-right')).toBe('100px')
+  })
+
   it('ignores connection updates that leave the chrome where it is', () => {
     const element = document.createElement('div')
     element.getBoundingClientRect = () => rect(0, 1000)
diff --git a/apps/desktop/src/components/pane-shell/tree/renderer/panel-titlebar.ts b/apps/desktop/src/components/pane-shell/tree/renderer/panel-titlebar.ts
index 6424ffe00cb..39607b0d9f5 100644
--- a/apps/desktop/src/components/pane-shell/tree/renderer/panel-titlebar.ts
+++ b/apps/desktop/src/components/pane-shell/tree/renderer/panel-titlebar.ts
@@ -42,12 +42,23 @@
       return
     }
 
+    // Contributed pane tools (titleBar.tools.right) sit in their own cluster
+    // just left of the fixed one. Reserve them too while they share the band:
+    // Electron app-region ignores stacking, so the drag handle under them
+    // turns every real click on a plugin tool into a window drag.
+    const paneTools = document.querySelector<HTMLElement>('[data-titlebar-cluster="tools"]')?.getBoundingClientRect()
+
+    const rightEdge =
+      paneTools && paneTools.width > 0 && paneTools.top < rightControls.bottom
+        ? Math.min(rightControls.left, paneTools.left)
+        : rightControls.left
+
     const left = Math.min(rect.width, Math.max(0, leftControls.right + 12 - rect.left))
     // No extra pad on the right: a +N here is a dead strip (the spacer has no
     // app-region) flush against Settings. The 48px data-window-drag-handle is
     // already the gutter (#131729). Do not mark this spacer drag — it sits
     // under the z-70 cluster, and Electron app-region ignores stacking.
-    const right = Math.min(rect.width - left, Math.max(0, rect.right - rightControls.left))
+    const right = Math.min(rect.width - left, Math.max(0, rect.right - rightEdge))
     element.style.setProperty('--panel-titlebar-left', `${left}px`)
     element.style.setProperty('--panel-titlebar-right', `${right}px`)
     setBelowControls(minimized || rect.width - left - right < 120)
