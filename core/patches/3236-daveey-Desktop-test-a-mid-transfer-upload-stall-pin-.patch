+  const received = { stalled: 0 }
+
   const server = http.createServer((req, res) => {
     let bytes = 0
+
+    if (req.url === '/stall-upload') {
+      req.once('data', chunk => {
+        received.stalled += chunk.length
+        req.pause()
+      })
+
+      return
+    }
+
     req.on('data', chunk => (bytes += chunk.length))
     req.on('end', () => {
       if (req.url === '/silent-upload') {
