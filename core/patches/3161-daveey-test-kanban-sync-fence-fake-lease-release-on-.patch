From e2d7c95bb9eca3a84e3fa41bc9f3bef96e431f19 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 05:35:44 +0000
Subject: [PATCH] [daveey] test(kanban-sync): fence fake lease release on the
 holder's run; ended run retries the card

Review 5886579700 on PR #1880 (non-blocking nits): FakeHub.leases action=release
now matches hermes-hub releaseTask more closely under lease_runs:

- fence(): a release whose run_uid or gateway does not hold the live lease is
  rejected with lease_lost and changes nothing (lease, card mirror, run kept).
- A release whose run row already ended still moves a still-running card to
  retryStatusForRun (review for a review-lane claim, else ready) and clears
  current_run_uid, as endRun does, besides clearing the lease mirror.
- The unused-grant released event carries that same retry_status.

Tests: the ended-run test now asserts status/current_run_uid, plus a
review-lane variant and a parametrized fence test (RED on the old fake:
4 failed; GREEN: 54 FakeService consumer files, 961 passed).
---
 tests/hermes_cli/kanban_sync_fake_board.py    | 62 ++++++++++++-------
 .../hermes_cli/test_kanban_sync_rejections.py | 38 ++++++++++++
 2 files changed, 76 insertions(+), 24 deletions(-)

diff --git a/tests/hermes_cli/kanban_sync_fake_board.py b/tests/hermes_cli/kanban_sync_fake_board.py
index cba715f9b8..43b7d4c07a 100644
--- a/tests/hermes_cli/kanban_sync_fake_board.py
+++ b/tests/hermes_cli/kanban_sync_fake_board.py
@@ -23,8 +23,9 @@ class FakeService:
         self.calls: list[tuple[str, str, Any]] = []
         self.offline = False
         # Like transitions.ts grantLease/releaseTask: a grant writes the card running plus its run row (setLease
-        # mirrors lease_holder/lease_run_uid/lease_expires onto the card), a release ends that run, clears that
-        # mirror (clearLease) and returns the card to ready. Off by default (the older tests count rows).
+        # mirrors lease_holder/lease_run_uid/lease_expires onto the card), a release is fenced on the holder's run
+        # (lease_lost otherwise), ends that run, clears that mirror (clearLease) and returns a running card to its
+        # retryStatusForRun. Off by default (the older tests count rows).
         self.lease_runs = lease_runs
         # Opt-in placement, like transitions.ts checkPlacement's runs_on rule: a grant needs every runs_on label
         # on the claiming machine ({name: {"labels": [...]}}; machine:<name> is implicit). None = no check.
@@ -115,6 +116,15 @@ class FakeService:
         b = self.board(bid)
         b["floor"] = b["seq"]
 
+    @staticmethod
+    def retry_status_for_run(b: dict, run: Optional[str]) -> str:
+        """As BoardTx.retryStatusForRun: ``review`` when the run's latest ``claimed`` event came out of review."""
+        claims = [e for e in b["rows"].get("task_events", {}).values()
+                  if run and e.get("kind") == "claimed" and e.get("run_uid") == run and not e.get("deleted_at")]
+        latest = max(claims, key=lambda e: e["seq"], default=None)
+        payload = json.loads(latest.get("payload") or "{}") if latest else {}
+        return "review" if payload.get("source_status") == "review" else "ready"
+
     # transitions.ts NEUTRAL_RELEASES: release outcome -> (run outcome, event kind); never charged.
     NEUTRAL = {"rate_limited": ("rate_limited", "rate_limited"), "owner_restart": ("reclaimed", "owner_restart_lost"),
                "owner_unavailable": ("owner_unavailable", "owner_unavailable"), "owner_down": ("owner_down", "owner_down"),
@@ -254,30 +264,34 @@ class FakeHub:
             if not cur or cur["holder"] != self.gateway or cur["run_uid"] != run:
                 return {"status": "rejected", "reason": "lease_lost", "lease": cur}
         else:
+            if self.svc.lease_runs and (not cur or cur["holder"] != gw or cur["run_uid"] != run):
+                # releaseTask's fence(): a release that does not name this gateway's live lease run is refused and
+                # changes nothing (the card keeps its lease and mirror).
+                return {"status": "rejected", "reason": "lease_lost", "lease": cur}
             b["leases"].pop(task, None)
-            runs = b["rows"].get("task_runs", {})
-            if (self.svc.lease_runs and cur and cur["run_uid"] == run and run in runs
-                    and runs[run].get("ended_at") is None):
-                unused = bool(body.get("unused_grant"))
-                # As the Board's releaseTask with ``unused_grant: true`` (live t_01a1a1dea9c64d6a run 164239): the
-                # run's metadata and the ``released`` event both say the grant never started anything.
-                self.svc._put(b, "task_runs", run, {"status": "released", "outcome": "released", "ended_at": 2,
-                                                    **({"metadata": json.dumps({"unused_grant": True},
-                                                                               separators=(",", ":"))}
-                                                       if unused else {})},
-                              gw, op_id, hlc)
-                if unused:
-                    self.svc._put(b, "task_events", f"ev-rel-{run}",
-                                  {"task_id": task, "run_uid": run, "kind": "released",
-                                   "payload": json.dumps({"error": None, "retry_status": "ready",
-                                                          "unused_grant": True}, separators=(",", ":")),
-                                   "created_at": int(time.time())}, gw, op_id, hlc)
-                self.svc._put(b, "tasks", task, {"status": "ready", "current_run_uid": None, "lease_holder": None,
+            runs, card = b["rows"].get("task_runs", {}), b["rows"].get("tasks", {}).get(task)
+            if self.svc.lease_runs and card is not None:
+                retry = self.svc.retry_status_for_run(b, card.get("current_run_uid"))
+                if run in runs and runs[run].get("ended_at") is None:
+                    unused = bool(body.get("unused_grant"))
+                    # As the Board's releaseTask with ``unused_grant: true`` (live t_01a1a1dea9c64d6a run 164239):
+                    # the run's metadata and the ``released`` event both say the grant never started anything.
+                    self.svc._put(b, "task_runs", run, {"status": "released", "outcome": "released", "ended_at": 2,
+                                                        **({"metadata": json.dumps({"unused_grant": True},
+                                                                                   separators=(",", ":"))}
+                                                           if unused else {})},
+                                  gw, op_id, hlc)
+                    if unused:
+                        self.svc._put(b, "task_events", f"ev-rel-{run}",
+                                      {"task_id": task, "run_uid": run, "kind": "released",
+                                       "payload": json.dumps({"error": None, "retry_status": retry,
+                                                              "unused_grant": True}, separators=(",", ":")),
+                                       "created_at": int(time.time())}, gw, op_id, hlc)
+                # clearLease drops the lease mirror; a still-running card goes back to retryStatusForRun; endRun
+                # clears current_run_uid even when the holder already ended its run row.
+                self.svc._put(b, "tasks", task, {**({"status": retry} if card.get("status") == "running" else {}),
+                                                 "current_run_uid": None, "lease_holder": None,
                                                  "lease_run_uid": None, "lease_expires": None}, gw, op_id, hlc)
-            elif self.svc.lease_runs and cur and task in b["rows"].get("tasks", {}):
-                # releaseTask's clearLease drops the card's lease mirror even when the holder already ended its run.
-                self.svc._put(b, "tasks", task, {"lease_holder": None, "lease_run_uid": None, "lease_expires": None},
-                              gw, op_id, hlc)
             return {"status": "applied", "lease": None}
         return {"status": "applied", "lease": b["leases"][task], "version": version}
 
diff --git a/tests/hermes_cli/test_kanban_sync_rejections.py b/tests/hermes_cli/test_kanban_sync_rejections.py
index 26f89c9fc6..2d3fa167bf 100644
--- a/tests/hermes_cli/test_kanban_sync_rejections.py
+++ b/tests/hermes_cli/test_kanban_sync_rejections.py
@@ -322,6 +322,44 @@ def test_fake_lease_release_after_run_end_clears_mirror(live, kanban_home):
     assert hub.leases(BOARD, {"action": "release", "task": tid, "run_uid": RUN, "client_op_id": "r"})["status"] == "applied"
     card = svc.board(BOARD)["rows"]["tasks"][tid]
     assert (card["lease_holder"], card["lease_run_uid"], card["lease_expires"]) == (None, None, None)
+    # releaseTask also moves the still-running card to retryStatusForRun and endRun clears current_run_uid.
+    assert (card["status"], card["current_run_uid"]) == ("ready", None)
+    assert svc.board(BOARD)["rows"]["task_runs"][RUN]["outcome"] == "crashed"  # the holder's own end stands
+
+
+def test_fake_lease_release_after_review_run_end_retries_to_review(live, kanban_home):
+    """retryStatusForRun: a run claimed out of review goes back to ``review`` when its ended lease is released."""
+    svc = FakeService(lease_runs=True)
+    hub = svc.hub(ME)
+    tid = kb.create_task(live, title="leased", assignee="worker")
+    client.push(live, hub, BOARD, ME, primary=False)
+    grant = {"action": "grant", "task": tid, "run_uid": RUN, "client_op_id": "g", "lane": "review"}
+    assert hub.leases(BOARD, grant)["status"] == "applied"
+    hub.ops(BOARD, [{"client_op_id": "end", "table": "task_runs", "uid": RUN, "op": "upsert",
+                     "fields": {"ended_at": 1794527437, "status": "crashed", "outcome": "crashed"},
+                     "hlc": f"{9_999_999_999_999:013d}-0001-{ME}"}])
+    assert hub.leases(BOARD, {"action": "release", "task": tid, "run_uid": RUN, "client_op_id": "r"})["status"] == "applied"
+    card = svc.board(BOARD)["rows"]["tasks"][tid]
+    assert (card["status"], card["current_run_uid"], card["lease_run_uid"]) == ("review", None, None)
+
+
+@pytest.mark.parametrize("gateway,run_uid", [(ME, "run-someone-else"), (OTHER, RUN)])
+def test_fake_lease_release_is_fenced_on_the_holders_run(live, kanban_home, gateway, run_uid):
+    """As releaseTask's fence(): a release naming another run, or from another gateway, is lease_lost and leaves the
+    lease, its card mirror and the run untouched."""
+    svc = FakeService(lease_runs=True)
+    hub = svc.hub(ME)
+    tid = kb.create_task(live, title="leased", assignee="worker")
+    client.push(live, hub, BOARD, ME, primary=False)
+    assert hub.leases(BOARD, {"action": "grant", "task": tid, "run_uid": RUN, "client_op_id": "g"})["status"] == "applied"
+    res = svc.hub(gateway).leases(BOARD, {"action": "release", "task": tid, "run_uid": run_uid, "client_op_id": "r"})
+    assert (res["status"], res["reason"]) == ("rejected", "lease_lost")
+    b = svc.board(BOARD)
+    card = b["rows"]["tasks"][tid]
+    assert b["leases"][tid]["run_uid"] == RUN
+    assert (card["status"], card["current_run_uid"], card["lease_holder"], card["lease_run_uid"]) == (
+        "running", RUN, ME, RUN)
+    assert b["rows"]["task_runs"][RUN]["ended_at"] is None
 
 
 def test_release_local_change_during_read_vetoes(live, svc, monkeypatch):
