From b762a671136c739b6518ce9a17b103fc8db6ed2f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 01:36:12 +0000
Subject: [PATCH] test(kanban): isolate attachment cleanup from host process
 discovery [daveey]

The byte-custody fixture creates no external workspace-owning jobs but left
psutil.process_iter attached to the real host. Completion performs synchronous
best-effort cleanup: unavailable or incomplete owned-job discovery retains
scratch, and unexpected errors are swallowed by the cleanup boundary. Thus a
successful completion does not guarantee removal under arbitrary host state.
The historical flake log lacks a veto reason; its exact transient cause is not
proven. A controlled unavailable inventory reproduces the same root.exists
failure deterministically, including on the runner retry.

Provide an empty process inventory in stores, keeping the real owned-job veto,
filesystem removal, Board byte transfer and all original assertions. Add an
outer unavailable-inventory fixture so deleting the isolation fails even on a
quiet host. No production changes, sleeps or weakened assertions.

Proof: canonical core-wt RED with isolation removed fails original cleanup
assertion; GREEN attachment + real owned-job suites 42 passed. External hostile
inventory repetition 20 fresh runs passed. scripts/check --base origin/main:
20 checks OK. Prior PR987 isolated another fixture, not this attachment suite.
---
 tests/hermes_cli/test_kanban_sync_attachments.py | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_sync_attachments.py b/tests/hermes_cli/test_kanban_sync_attachments.py
index 790155d754bd590aadc0ee7ee6b021e7d45aee7e..ae8ff739ead7c3ab8d6b7775fad57c1131d6d50a 100644
--- a/tests/hermes_cli/test_kanban_sync_attachments.py
+++ b/tests/hermes_cli/test_kanban_sync_attachments.py
@@ -47,6 +47,9 @@ class BlobService(FakeService):
 @pytest.fixture
 def stores(tmp_path, monkeypatch):
     home = support.kanban_home(tmp_path, monkeypatch)
+    # These stores launch no external workspace-owning jobs. Keep the real
+    # cleanup veto, but do not make byte-custody assertions scan the busy host.
+    monkeypatch.setattr("psutil.process_iter", lambda: iter(()))
     support.write_sync_config(home, True)
     worker = tmp_path / "worker"
     worker.mkdir()
@@ -97,6 +100,15 @@ def test_worker_attachment_reaches_normal_home_read_path(stores):
     assert Path(rows[0].stored_path).read_bytes() == data
 
 
+@pytest.fixture
+def unavailable_host_inventory(monkeypatch):
+    # The stores fixture must override discovery even on an unhealthy host.
+    def unavailable():
+        raise RuntimeError("host process inventory unavailable")
+    monkeypatch.setattr("psutil.process_iter", unavailable)
+
+
+@pytest.mark.usefixtures("unavailable_host_inventory")
 def test_worker_completion_removes_scratch_but_home_reads_its_bytes(stores):
     from hermes_cli import kanban_db_workspace as workspace
     home, worker, hub_conn, conn, _service, tid, round_at = stores
