From 8e8da03e77e282257a1d3f5c8cd8b96a366ead24 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 00:45:51 -0700
Subject: [PATCH] feat(desktop): a worker-launched test instance gets no Dock
 icon and never shows a window

A kanban worker reproducing a Desktop bug ran its own `electron .` with a scratch
--user-data-dir; it appeared as a second Hermes app with a Dock icon and a focused
window on the owner's screen (card t_ed201037). When main.ts finds an inherited
worker env AND the instance is a test instance (unpackaged, or a custom
--user-data-dir), it switches to the accessory activation policy and makes every
window's show/showInactive/focus/moveTop a no-op; CDP still drives it. The owner's
packaged Desktop reopened from a worker stays visible. HERMES_DESKTOP_AGENT_VISIBLE=1
opts back in.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff --git a/apps/desktop/electron/agent-test-instance.test.ts b/apps/desktop/electron/agent-test-instance.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ba66a311f2cf435d0e7622a1d43208013f4541e5
--- /dev/null
+++ b/apps/desktop/electron/agent-test-instance.test.ts
@@ -0,0 +1,93 @@
+import { describe, expect, it, vi } from 'vitest'
+
+import { hideAgentTestInstance, isHiddenAgentTestInstance } from './agent-test-instance'
+
+const leaked = ['HERMES_KANBAN_TASK', 'TERMINAL_CWD']
+
+describe('isHiddenAgentTestInstance', () => {
+  it('hides an unpackaged `electron .` a worker started (the t_ed201037 second window)', () => {
+    expect(
+      isHiddenAgentTestInstance({
+        leakedWorkerEnv: leaked,
+        isPackaged: false,
+        argv: ['/x/Electron', '.', '--remote-debugging-port=9455', '--user-data-dir=/x/ssr-live/userdata'],
+        env: {}
+      })
+    ).toBe(true)
+  })
+
+  it('hides a packaged build a worker started on a scratch profile', () => {
+    expect(
+      isHiddenAgentTestInstance({ leakedWorkerEnv: leaked, isPackaged: true, argv: ['/x/Hermes', '--user-data-dir', '/tmp/p'], env: {} })
+    ).toBe(true)
+  })
+
+  it("keeps the owner's packaged Desktop visible when a worker reopens it", () => {
+    expect(isHiddenAgentTestInstance({ leakedWorkerEnv: leaked, isPackaged: true, argv: ['/x/Hermes'], env: {} })).toBe(false)
+  })
+
+  it('never hides a Desktop no worker launched', () => {
+    expect(isHiddenAgentTestInstance({ leakedWorkerEnv: [], isPackaged: false, argv: ['/x/Electron', '.'], env: {} })).toBe(false)
+  })
+
+  it('HERMES_DESKTOP_AGENT_VISIBLE=1 opts a test instance back in', () => {
+    expect(
+      isHiddenAgentTestInstance({ leakedWorkerEnv: leaked, isPackaged: false, argv: ['/x/Electron', '.'], env: { HERMES_DESKTOP_AGENT_VISIBLE: '1' } })
+    ).toBe(false)
+  })
+})
+
+describe('hideAgentTestInstance', () => {
+  function fakeApp() {
+    let created: ((event: unknown, win: never) => void) | null = null
+
+    const app = {
+      on: vi.fn((_event: string, listener: (event: unknown, win: never) => void) => {
+        created = listener
+      }),
+      setActivationPolicy: vi.fn(),
+      dock: { hide: vi.fn() },
+      focus: vi.fn()
+    }
+
+    return { app, emitWindow: (win: object) => created?.({}, win as never) }
+  }
+
+  it('drops the Dock icon on macOS and makes every new window unshowable', () => {
+    const { app, emitWindow } = fakeApp()
+    const focus = app.focus
+
+    hideAgentTestInstance(app as never, 'darwin')
+
+    expect(app.setActivationPolicy).toHaveBeenCalledWith('accessory')
+    expect(app.dock.hide).toHaveBeenCalled()
+
+    const win = { show: vi.fn(), showInactive: vi.fn(), focus: vi.fn(), moveTop: vi.fn() }
+    const original = { ...win }
+    emitWindow(win)
+    win.show()
+    win.showInactive()
+    win.focus()
+    win.moveTop()
+    app.focus({ steal: true })
+
+    expect(original.show).not.toHaveBeenCalled()
+    expect(original.showInactive).not.toHaveBeenCalled()
+    expect(original.focus).not.toHaveBeenCalled()
+    expect(original.moveTop).not.toHaveBeenCalled()
+    expect(focus).not.toHaveBeenCalled()
+  })
+
+  it('leaves the Dock alone off macOS but still never shows windows', () => {
+    const { app, emitWindow } = fakeApp()
+
+    hideAgentTestInstance(app as never, 'linux')
+
+    expect(app.dock.hide).not.toHaveBeenCalled()
+    const win = { show: vi.fn(), showInactive: vi.fn(), focus: vi.fn(), moveTop: vi.fn() }
+    const show = win.show
+    emitWindow(win)
+    win.show()
+    expect(show).not.toHaveBeenCalled()
+  })
+})
diff --git a/apps/desktop/electron/agent-test-instance.ts b/apps/desktop/electron/agent-test-instance.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ccdd43839156833c156730c4530b8af63bb5418a
--- /dev/null
+++ b/apps/desktop/electron/agent-test-instance.ts
@@ -0,0 +1,56 @@
+// A worker that reproduces a Desktop bug runs its own instance (`electron .` from a checkout, or
+// a packaged build with a scratch `--user-data-dir`). That instance showed up as a second Hermes
+// app with its own Dock icon and focused windows on the owner's screen (2026-10-27, card
+// t_ed201037, pid 26918). It is driven over CDP, so it needs no Dock icon and no visible window.
+// The owner's own Desktop relaunched from a worker (a worker's `hermes update`, mac-fixer) stays
+// visible: it is packaged and uses the default profile. HERMES_DESKTOP_AGENT_VISIBLE=1 opts a
+// test instance back in. [daveey]
+
+export interface AgentTestInstanceInput {
+  /** Keys scrubLeakedWorkerEnv() removed: non-empty means a worker launched this process. */
+  leakedWorkerEnv: readonly string[]
+  isPackaged: boolean
+  argv: readonly string[]
+  env: NodeJS.ProcessEnv
+}
+
+export function isHiddenAgentTestInstance({ leakedWorkerEnv, isPackaged, argv, env }: AgentTestInstanceInput): boolean {
+  if (env.HERMES_DESKTOP_AGENT_VISIBLE === '1' || leakedWorkerEnv.length === 0) {
+    return false
+  }
+
+  return !isPackaged || argv.some(arg => arg === '--user-data-dir' || arg.startsWith('--user-data-dir='))
+}
+
+interface HideableWindow {
+  show: () => void
+  showInactive: () => void
+  focus: () => void
+  moveTop: () => void
+}
+
+interface HideableApp {
+  on: (event: 'browser-window-created', listener: (event: unknown, win: HideableWindow) => void) => unknown
+  setActivationPolicy?: (policy: 'regular' | 'accessory' | 'prohibited') => void
+  dock?: { hide: () => void }
+  focus: (options?: { steal: boolean }) => void
+}
+
+/** No Dock icon or menu bar (macOS accessory policy), and no window is ever shown or focused.
+ *  Windows still render (they are created with `show: false`), so CDP drives and screenshots them. */
+export function hideAgentTestInstance(app: HideableApp, platform: NodeJS.Platform = process.platform): void {
+  if (platform === 'darwin') {
+    app.setActivationPolicy?.('accessory')
+    app.dock?.hide()
+  }
+
+  app.focus = () => {}
+  app.on('browser-window-created', (_event, win) => {
+    const noop = () => {}
+
+    win.show = noop
+    win.showInactive = noop
+    win.focus = noop
+    win.moveTop = noop
+  })
+}
