From 30894c09f8791f20b73bcee824b2fcda725f1109 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 08:21:48 +0000
Subject: [PATCH] [daveey] kanban tui owner reads the session-authority
 registry's launch property instead of calling it

SessionAuthorities.launch is a @property; _launch_authority called it, so every
registry-backed gateway raised "'SessionAuthority' object is not callable" for each
tui subscription and no legacy tui notice was claimed. Regression tests use a real
SessionAuthorities registry (the old fixture set session_authorities=None).

Task: t_01a1cea109ada326
---
 gateway/kanban_tui_owner.py                   |  2 +-
 .../gateway/test_kanban_tui_owner_delivery.py | 31 +++++++++++++++++++
 2 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/gateway/kanban_tui_owner.py b/gateway/kanban_tui_owner.py
index 25d023e709..9fab8fa211 100644
--- a/gateway/kanban_tui_owner.py
+++ b/gateway/kanban_tui_owner.py
@@ -56,7 +56,7 @@ def _launch_authority(runner: Any, profile: Optional[str]) -> Any:
     answer with the launch authority for every profile. A sub stamped with another served profile is
     left to the legacy backend instead of being matched against the wrong session store."""
     registry = getattr(runner, "session_authorities", None)
-    authority = registry.launch() if registry is not None else getattr(runner, "session_authority", None)
+    authority = registry.launch if registry is not None else getattr(runner, "session_authority", None)
     if authority is None or not profile:
         return authority
     name = None
diff --git a/tests/gateway/test_kanban_tui_owner_delivery.py b/tests/gateway/test_kanban_tui_owner_delivery.py
index be518aaff0..3c36334fce 100644
--- a/tests/gateway/test_kanban_tui_owner_delivery.py
+++ b/tests/gateway/test_kanban_tui_owner_delivery.py
@@ -344,3 +344,34 @@ async def test_stale_live_claim_is_released_logged_and_then_delivered(env, monke
     assert any("was never delivered" in r.getMessage() and "without an ack" in r.getMessage()
                for r in caplog.records)
     assert [x["chat"] for x in admitted] == [CHAT_B] and _row(tid, CHAT_B)[0] == _max_event(tid)
+
+
+def _registry(runner, authority, tmp_path):
+    """A real SessionAuthorities map whose launch slot holds ``authority`` (``launch`` is a property)."""
+    from gateway.session_authorities import SessionAuthorities
+    authority.profile_id = str(tmp_path / "home")
+    registry = SessionAuthorities(authority.profile_id)
+    registry.add(authority.profile_id, authority)
+    runner.session_authorities = registry
+    return registry
+
+
+def test_launch_authority_reads_the_registry_launch_property(env, tmp_path):
+    from gateway.kanban_tui_owner import _launch_authority
+    runner, authority, _admitted, _ = env
+    _registry(runner, authority, tmp_path)
+    assert _launch_authority(runner, "default") is authority
+    assert _launch_authority(runner, None) is authority
+    assert _launch_authority(runner, "work") is None
+
+
+@pytest.mark.asyncio
+async def test_registry_backed_gateway_claims_and_delivers_owned_tui_row(env, tmp_path):
+    runner, authority, admitted, _ = env
+    _registry(runner, authority, tmp_path)
+    authority.sessions[CHAT_B] = _Live(CHAT_B)
+    authority.db.work(CHAT_B)
+    tid = _task("registry", CHAT_B)
+    _complete(tid)
+    await _tick(runner)
+    assert [a["chat"] for a in admitted] == [CHAT_B] and _row(tid, CHAT_B)[0] == _max_event(tid)
