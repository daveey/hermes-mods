From 7ba11361e4f4d44a8fea7c63480fd815905625b7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 01:14:41 +0000
Subject: [PATCH] [daveey] Preserve conditional exec descriptor alternatives
 and wrapped exec bindings

Proof: #2702 baseline be63ac710f yields 59 failures / 35 passes with current regressions. Recovered implementation fails 3 additional cases (time/function scopes and distinct candidate eviction); fixed cron suite passes. Never discard reachable intermediate descriptor alternatives.
---
 cron/lifecycle_guard_fds.py                   | 148 +++++++++++++++---
 .../test_lifecycle_guard_descriptor_carry.py  |  42 ++++-
 2 files changed, 164 insertions(+), 26 deletions(-)

diff --git a/cron/lifecycle_guard_fds.py b/cron/lifecycle_guard_fds.py
index 90ecfe6ea7a20253bbd49154173d07cafe812c43..23674694c48e474824b7912718729a3cffbda352 100644
--- a/cron/lifecycle_guard_fds.py
+++ b/cron/lifecycle_guard_fds.py
@@ -2,6 +2,13 @@
 
 Keep lexical redirection metadata intact; quoted operator-shaped arguments are data.
 The caller's existing ordered fd resolver handles each command's local redirections.
+
+The table maps fd -> tuple of *possible* targets. A redirection-only ``exec`` that certainly
+runs (top level, after ``;``/newline, not piped/backgrounded) replaces the fd; one that may not
+run (inside ``if``/``while``/``case``/groups, after ``&&``/``||``, in a pipeline) *adds* its
+result to the old targets, so a conditional close/rebind never erases a dangerous earlier open.
+A line whose fds have several candidates is emitted once per candidate index (zipped, not a
+product), so growth is linear in the candidate count. Never discard reachable targets.
 """
 from __future__ import annotations
 
@@ -11,6 +18,13 @@ import re
 from cron.lifecycle_guard_words import ShellWord, redirection_parts
 
 
+_OPENERS = frozenset({"if", "while", "until", "{"})
+_CLOSERS = frozenset({"fi", "done", "esac", "}"})
+_LEADING_KEYWORDS = frozenset({"if", "then", "else", "elif", "while", "until", "do", "!", "{"})
+_HEADERS = frozenset({"for", "case", "select"})  # `for x in …`/`case x in`: no command follows
+_Table = dict[str, tuple[str, ...]]
+
+
 def _redirections(words: list[str], pattern: re.Pattern[str]):
     index = 0
     while index < len(words):
@@ -25,13 +39,13 @@ def _redirections(words: list[str], pattern: re.Pattern[str]):
         yield start, index, (fd, operator, target)
 
 
-def _apply(table: dict[str, str], fd: str, operator: str, target: str) -> None:
+def _apply(table: _Table, fd: str, operator: str, target: str) -> None:
     fd = fd or ("0" if operator.startswith("<") else "1")
     source = target.removesuffix("-")
     value = table.get(source) if operator in ("<&", ">&") else None
     table.pop(fd, None)
     if operator in ("<", "<>") and target:
-        table[fd] = target
+        table[fd] = (target,)
     elif value is not None:
         table[fd] = value
     if operator in ("<&", ">&") and target.endswith("-"):
@@ -40,16 +54,35 @@ def _apply(table: dict[str, str], fd: str, operator: str, target: str) -> None:
         table.pop("2", None)
 
 
-def _carry_segment(segment: list[str], table: dict[str, str], command: int,
-                   pattern: re.Pattern[str]) -> list[str]:
-    found = list(_redirections(segment[command + 1:], pattern))
-    if segment[command:command + 1] == ["exec"] and sum(
-            end - start for start, end, _ in found) == len(segment) - command - 1:
-        for _, _, parts in found:
-            _apply(table, *parts)
-        return segment
+def _exec_redirections(words: list[str], pattern: re.Pattern[str]):
+    """Redirections of a redirection-only ``exec`` (also ``command``/``builtin`` wrapped, or with
+    leading redirections); ``None`` when *words* is not one."""
+    found = list(_redirections(words, pattern))
+    consumed = {i for start, end, _ in found for i in range(start, end)}
+    rest = [word for i, word in enumerate(words) if i not in consumed]
+    while rest and rest[0] in ("command", "builtin"):
+        wrapper = rest.pop(0)
+        while rest and (rest[0] == "--" or (wrapper == "command" and rest[0] == "-p")):
+            rest.pop(0)
+    return [parts for _, _, parts in found] if rest == ["exec"] else None
+
+
+def _merge(old: _Table, new: _Table) -> None:
+    """Make *old* the union of itself and *new* (the result of a maybe-run ``exec``)."""
+    for fd in set(old) | set(new):
+        values = tuple(dict.fromkeys(old.get(fd, ()) + new.get(fd, ())))
+
+        if values:
+            old[fd] = values
+        else:
+            old.pop(fd, None)
+
+
+def _carry_segment(segment: list[str], table: dict[str, str], pattern: re.Pattern[str]
+                   ) -> list[str]:
+    """Rewrite *segment*'s fd copies using the concrete *table* (fd -> one target)."""
     out: list[str] = []
-    local = dict(table)
+    local = {fd: (target,) for fd, target in table.items()}
     position = 0
     for start, end, (fd, operator, target) in _redirections(segment, pattern):
         source = target.removesuffix("-")
@@ -58,7 +91,7 @@ def _carry_segment(segment: list[str], table: dict[str, str], command: int,
             out.extend(segment[position:start])
             destination = fd or ("0" if operator.startswith("<") else "1")
             out.append(ShellWord(destination + "<", (destination, "<", "")))
-            out.append(ShellWord(value, None))
+            out.append(ShellWord(value[0], None))
             # A moved source is closed after copying, including same-fd moves.
             if target.endswith("-"):
                 out.append(ShellWord(source + "<&-", (source, "<&", "-")))
@@ -68,27 +101,92 @@ def _carry_segment(segment: list[str], table: dict[str, str], command: int,
     return out
 
 
+def _command_start(segment: list[str], nesting: list[str], pattern: re.Pattern[str]) -> int:
+    """Index past leading compound-command keywords, tracking *nesting* of open compounds."""
+    start = 0
+    while start < len(segment):
+        word = segment[start]
+        if word in _CLOSERS:
+            if nesting:
+                nesting.pop()
+            start += 1
+        elif word in _LEADING_KEYWORDS:
+            if word in _OPENERS:
+                nesting.append(word)
+            start += 1
+        elif word == "time":
+            start += 1
+            if segment[start:start + 1] == ["-p"]:
+                start += 1
+            if segment[start:start + 1] == ["--"]:
+                start += 1
+        elif word in ("function", "coproc"):
+            # Definitions and asynchronous bodies cannot certainly mutate the parent.
+            nesting.append(word)
+            start += 1
+            if word == "function" or segment[start + 1:start + 2] == ["{"]:
+                start += 1
+        elif word in _HEADERS:
+            nesting.append(word)
+            return len(segment)
+        elif (nesting and nesting[-1] == "case" and word.endswith(")")
+                and redirection_parts(word, pattern) is None):
+            start += 1  # a case pattern `x)`
+        else:
+            break
+    return start
+
+
 def carry_exec_descriptors(
     lines: Iterable[list[str]], *, pattern: re.Pattern[str],
     peel_reserved_words: Callable[[list[str]], int], control_chars: frozenset[str],
 ) -> Iterator[list[str]]:
     """Resolve inherited fd copies in script order, without changing pipeline boundaries.
 
-    Redirection-only execs in branches/groups are conservatively carried too. Each
-    script gets its own table, so heredoc bodies cannot rebind their enclosing script.
+    Redirection-only execs in branches/groups are carried as alternatives (see module doc).
+    Each script gets its own table, so heredoc bodies cannot rebind their enclosing script.
     """
-    table: dict[str, str] = {}
+    table: _Table = {}
+    nesting: list[str] = []  # open compound commands; persists across lines
     for tokens in lines:
-        if not table and "exec" not in tokens:
-            yield tokens
-            continue
-        out: list[str] = []
+        pieces: list[tuple[list[str], str, str]] = []  # (segment, control before, control after)
         segment: list[str] = []
+        before = ""
         for token in [*tokens, ";"]:
-            if not (token and set(token) <= control_chars):
+            if token and set(token) <= control_chars:
+                pieces.append((segment, before, token))
+                segment, before = [], token
+            else:
                 segment.append(token)
-                continue
-            out.extend(_carry_segment(segment, table, peel_reserved_words(segment), pattern))
-            out.append(token)
-            segment = []
-        yield out[:-1]
+        variants: list[list[list[str]]] = []
+        for segment, before, after in pieces:
+            start = _command_start(segment, nesting, pattern)
+            command = start + peel_reserved_words(segment[start:])
+            redirects = _exec_redirections(segment[command:], pattern)
+            if redirects is not None:
+                new = dict(table)
+                for parts in redirects:
+                    _apply(new, *parts)
+                if not nesting and before in ("", ";") and after not in ("|", "&", "|&"):
+                    table = new
+                else:
+                    _merge(table, new)
+                variants.append([segment])
+            else:
+                seen: list[list[str]] = []
+                for index in range(max((len(v) for v in table.values()), default=1)):
+                    concrete = {fd: v[index % len(v)] for fd, v in table.items()}
+                    rewritten = _carry_segment(segment, concrete, pattern) if concrete else segment
+                    if rewritten not in seen:
+                        seen.append(rewritten)
+                variants.append(seen)
+            if after == "(":
+                nesting.append("sub")
+            elif after == ")" and nesting and nesting[-1] == "sub":
+                nesting.pop()
+        for index in range(max((len(v) for v in variants), default=1)):
+            out: list[str] = []
+            for (_, _, after), options in zip(pieces, variants):
+                out.extend(options[index % len(options)])
+                out.append(after)
+            yield out[:-1]
diff --git a/tests/cron/test_lifecycle_guard_descriptor_carry.py b/tests/cron/test_lifecycle_guard_descriptor_carry.py
index f7626f13ec722a8f10866c9fd50410828f0b151a..123a19e66bbad2538024b3cb59e36289814b50dd 100644
--- a/tests/cron/test_lifecycle_guard_descriptor_carry.py
+++ b/tests/cron/test_lifecycle_guard_descriptor_carry.py
@@ -72,6 +72,34 @@ def files(tmp_path) -> dict[str, str]:
         "exec 3<{sh}; bash -s <&3 '0<&-'",
         "exec 3<{sh}; bash -s <&3 '0>/dev/null'",
         "exec 3<{sh}; bash 1>&3 <&1",
+        # Leading-redirection and wrapped `exec` still keep their redirections.
+        "3<{sh} exec; bash <&3",
+        "<{sh} exec; bash <&0",
+        "command exec 3<{sh}; bash <&3",
+        "command -p exec 3<{sh}; bash <&3",
+        "builtin exec 3<{sh}; bash <&3",
+        "builtin -- exec 3<{sh}; bash <&3",
+        "3<{sh} command exec; bash <&3",
+        # A conditional close or rebind keeps the earlier dangerous open as an alternative.
+        "exec 3<{sh}; if false; then exec 3<&-; fi; bash <&3",
+        "exec 3<{sh}; if false; then exec 3<{clean_sh}; fi; bash <&3",
+        "exec 3<{sh}; false && exec 3<&-; bash <&3",
+        "exec 3<{sh}; true || exec 3<{clean_sh}; bash <&3",
+        "exec 3<{sh}; while false; do exec 3<&-; done; bash <&3",
+        "exec 3<{sh}; {{ exec 3<&-; }}; bash <&3",
+        "exec 3<{sh}; case x in y) exec 3<&- ;; esac; bash <&3",
+        "exec 3<{sh}; if x; then exec 4<&3-; fi; bash <&3",
+        "exec 3<{sh}; if x; then exec 3<&-; fi; exec 4<&3; bash <&4",
+        "exec 3<{sh}; if x; then exec 3<{clean_sh}; fi; if y; then exec 3<&-; fi; bash <&3",
+        "exec 3<{clean_sh}; if x; then exec 3<{sh}; fi; if y; then exec 3<&-; fi; bash <&3",
+        "exec 3<{sh}; time if false; then exec 3<&-; fi; bash <&3",
+        "exec 3<{sh}; function f {{ exec 3<&-; }}; bash <&3",
+        # Distinct alternatives must not evict a reachable dangerous middle target.
+        "exec 3<{clean_sh}; "
+        + "".join("if x; then exec 3<{clean_sh}." + str(i) + "; fi; " for i in range(8))
+        + "if x; then exec 3<{sh}; fi; "
+        + "".join("if x; then exec 3<{clean_sh}." + str(i) + "; fi; " for i in range(8, 40))
+        + "bash <&3",
     ],
 )
 def test_descriptor_fed_script_is_scanned(files, template):
@@ -109,7 +137,19 @@ def test_descriptor_fed_script_is_scanned(files, template):
         "exec 3<{sh}; bash 3<&3- <&3",
         "exec 3<{sh}; bash 3>&- <&3",
         "exec 3<{sh}; bash '<&3'",
-        "exec '3<{sh}'; bash <&3", 
+        "exec '3<{sh}'; bash <&3",
+        "command exec 3<{clean_sh}; bash <&3",
+        "command -v exec 3<{sh}; bash <&3",
+        "command exec 3<{sh} true; bash <&3",
+        "builtin exec 3<{sh} true; bash <&3",
+        "echo exec 3<{sh}; bash <&3",
+        "3<{clean_sh} exec; bash <&3",
+        # An unconditional close/rebind after a conditional one wins.
+        "exec 3<{sh}; if x; then exec 3<{clean_sh}; fi; exec 3<&-; bash <&3",
+        "exec 3<{sh}; if x; then :; fi; exec 3<{clean_sh}; bash <&3",
+        "exec 3<{sh}; if x; then :; fi; command exec 3<&-; bash <&3",
+        "if x; then exec 3<{clean_sh}; fi; bash <&3",
+        "exec 3<{clean_sh}; if x; then exec 3<{clean_sh}; fi; bash <&3",
     ],
 )
 def test_unread_or_clean_descriptor_stays_allowed(files, template):
