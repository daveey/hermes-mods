From b4eb31d2e70e4761f77ea0b0541a33ae394a20bf Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 13:09:22 +0000
Subject: [PATCH] [daveey] fix(kanban): capacity note names the machine behind
 machine-scoped restrictions

at_capacity, capacity.update_drain and capacity.memory_pressure come from the
observing dispatcher's machine, yet describe() rendered them on every ready card
it observed, including cards pinned to other machines (a worker-1 card shown on
worker-4 read "at_capacity (max_in_progress=10/10)" while queued for worker-1).
describe() now appends "on <machine>" to those reasons from the evidence's
recorded machine. Card-scoped reasons stay unattributed. Advisory text only: no
change to recorded evidence, dispatch, claim, limits or config.
---
 hermes_cli/kanban_capacity_evidence.py        | 17 ++++++++++--
 .../test_kanban_capacity_evidence.py          | 27 +++++++++++++++++++
 2 files changed, 42 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_capacity_evidence.py b/hermes_cli/kanban_capacity_evidence.py
index 7c534bfd28..c60c2d00f4 100644
--- a/hermes_cli/kanban_capacity_evidence.py
+++ b/hermes_cli/kanban_capacity_evidence.py
@@ -242,10 +242,23 @@ def read(conn, task, *, board=None, now=None):
     return out
 
 
+# Restrictions of the observing dispatcher's machine, not of the card: a card pinned
+# elsewhere waits for another machine, so the note names the one that observed them.
+MACHINE_CODES = frozenset({"capacity.memory_pressure", "capacity.update_drain"})
+MACHINE_FIELDS = frozenset({"at_capacity"})
+
+
 def describe(value):
     """Never turn an incomplete restriction list into an assertion of availability."""
-    codes = ", ".join(r["code"] + " (" + r["native_code"] + "; " + r["phase"] + ")" for r in value.get("reasons", []))
-    native = ", ".join(r.get("source_field", "restriction") + " (" + r["native_code"] + ")"
+    machine = value.get("machine")
+
+    def on(text, scoped):
+        return f"{text} on {machine}" if scoped and isinstance(machine, str) and machine else text
+
+    codes = ", ".join(on(r["code"] + " (" + r["native_code"] + "; " + r["phase"] + ")", r["code"] in MACHINE_CODES)
+                      for r in value.get("reasons", []))
+    native = ", ".join(on(r.get("source_field", "restriction") + " (" + r["native_code"] + ")",
+                          r.get("source_field") in MACHINE_FIELDS)
                        for r in value.get("native_restrictions", []))
     codes = "; ".join(v for v in (codes, native) if v)
     return (f"{value.get('freshness', 'unknown')}: {codes or 'restriction coverage incomplete'}; "
diff --git a/tests/hermes_cli/test_kanban_capacity_evidence.py b/tests/hermes_cli/test_kanban_capacity_evidence.py
index d86465bb08..db5f303067 100644
--- a/tests/hermes_cli/test_kanban_capacity_evidence.py
+++ b/tests/hermes_cli/test_kanban_capacity_evidence.py
@@ -288,3 +288,30 @@ def test_describe_without_observed_restrictions_never_asserts_availability(board
     text = evidence.describe(evidence.read(board, kb.get_task(board, tid), board="default", now=1001))
     assert text == "current: restriction coverage incomplete; admissible capacity unknown"
     assert "no restriction" not in text
+
+
+def test_describe_names_observing_machine_for_machine_scoped_restrictions(board):
+    """A card pinned to worker-1 seen by worker-4's dispatcher: worker-4's limits are named as worker-4's."""
+    from hermes_cli import kanban_db_sync as sync
+    sync._add_column_if_missing(board, "tasks", "runs_on", "runs_on TEXT")
+    tid = kb.create_task(board, title="pinned", assignee="alice")
+    with kb.write_txn(board):
+        board.execute("UPDATE tasks SET runs_on=? WHERE id=?", ('["machine:worker-1"]', tid))
+    result = dispatch.DispatchResult(at_capacity="max_in_progress=10/10", memory_pressure="critical",
+                                     skipped_ineligible=[(tid, "labels_mismatch")])
+    evidence.record(board, result, board="default", machine="worker-4", now=1000, update_drain=True)
+    text = evidence.describe(evidence.read(board, kb.get_task(board, tid), board="default", now=1001))
+    assert "at_capacity (max_in_progress=10/10) on worker-4" in text
+    assert "capacity.update_drain (suppress_spawn; pre_claim) on worker-4" in text
+    assert "capacity.memory_pressure (critical; pre_claim) on worker-4" in text
+    # Card-scoped reasons are the card's own and stay unattributed.
+    assert "capacity.placement (labels_mismatch; pre_claim)" in text
+    assert "labels_mismatch; pre_claim) on" not in text
+    assert text.endswith("admissible capacity unknown")
+
+
+@pytest.mark.parametrize("machine", [None, ""])
+def test_describe_without_machine_keeps_plain_reason(machine):
+    value = {"freshness": "current", "machine": machine, "reasons": [],
+             "native_restrictions": [{"source_field": "at_capacity", "native_code": "max_spawn=3/3"}]}
+    assert evidence.describe(value) == "current: at_capacity (max_spawn=3/3); admissible capacity unknown"
