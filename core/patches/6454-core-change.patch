From 7f929c56a48bd9580f4ff46c7109014f92e14936 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 13:47:10 +0000
Subject: [PATCH 6454] Test isolation, fixture lifecycle and CI case partitioning

Public mirror of source commit 7f929c56a48bd9580f4ff46c7109014f92e14936.

---
diff --git a/tests/gateway/fixtures/queued_work_publication_daemon.py b/tests/gateway/fixtures/queued_work_publication_daemon.py
index 311a7ed70ca..4839cb3382b 100644
--- a/tests/gateway/fixtures/queued_work_publication_daemon.py
+++ b/tests/gateway/fixtures/queued_work_publication_daemon.py
@@ -11,9 +11,14 @@
 
 def delayed_finish(*args, **kwargs):
     result = finish_result(*args, **kwargs)
+    home = Path(os.environ['HERMES_HOME'])
+    if kwargs['row']['payload'].get('text') == 'B_TURN':
+        # The database is terminal, but resume still overlays the running claim.
+        wait_until(lambda: (home / 'release-b-publication').exists(),
+                   timeout=60, what='viewer observed B before completion publication')
     if kwargs['row']['request_id'] == 'A_FOLLOWER_2':
         # No stream lock is held here: the real replay RPC can observe the gap.
-        wait_until(lambda: (Path(os.environ['HERMES_HOME']) / 'release-publication').exists(),
+        wait_until(lambda: (home / 'release-publication').exists(),
                    timeout=60, what='viewer observed the terminal/publication gap')
     return result
 
diff --git a/tests/gateway/test_journey_new_session_queued_work.py b/tests/gateway/test_journey_new_session_queued_work.py
index 32eaba408a2..af0a5e0deaa 100644
--- a/tests/gateway/test_journey_new_session_queued_work.py
+++ b/tests/gateway/test_journey_new_session_queued_work.py
@@ -92,7 +92,16 @@
             rows = admissions()
             assert {k: (r['target_session_id'], r['status']) for k, r in rows.items() if k.startswith('A_')} == {
                 'A_HEAD': (a, 'started'), **{n: (a, 'queued') for n in A_FOLLOWERS}}, rows
-            b_snapshot = await client.rpc('session.resume', session_id=b)
+            # A terminal admission is committed before the owner publishes completion.
+            # Wait for the viewer contract, not merely the SQLite state sampled above.
+            async with asyncio.timeout(30):
+                while True:
+                    b_snapshot = await client.rpc('session.resume', session_id=b)
+                    if publication_gap and not (home / 'release-b-publication').exists():
+                        assert b_snapshot['pending'], b_snapshot
+                        (home / 'release-b-publication').touch()
+                    if not b_snapshot['pending']:
+                        break
             a_snapshot = (await rpc(other, 'session.resume', session_id=a))['result']
             assert b_snapshot['pending'] == [] and b_snapshot['messages'][0]['content'] == 'B_TURN', b_snapshot
             assert [r['input_id'] for r in a_snapshot['pending']] == ['A_HEAD', *A_FOLLOWERS], a_snapshot['pending']
