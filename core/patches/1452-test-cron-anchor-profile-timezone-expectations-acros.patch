From e901f8029d5a6b80658d8950636fd58ff0739604 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 18:37:28 +0000
Subject: [PATCH] test(cron): anchor profile timezone expectations across DST
 [daveey]

---
 .../test_cron_next_run_profile_timezone.py    | 26 ++++++++++++++++---
 1 file changed, 23 insertions(+), 3 deletions(-)

diff --git a/tests/cron/test_cron_next_run_profile_timezone.py b/tests/cron/test_cron_next_run_profile_timezone.py
index ff33ca59b83..fddbe518442 100644
--- a/tests/cron/test_cron_next_run_profile_timezone.py
+++ b/tests/cron/test_cron_next_run_profile_timezone.py
@@ -14,7 +14,6 @@ The invariant pinned here: ``next_run_at`` written during a foreign-process
 tick carries the JOB-OWNING profile's configured UTC offset.
 """
 from datetime import datetime
-from pathlib import Path
 from zoneinfo import ZoneInfo
 
 import pytest
@@ -30,8 +29,18 @@ def _fresh_tz_cache(monkeypatch):
     hermes_time.reset_cache()
 
 
+@pytest.mark.parametrize(
+    "start, expected",
+    [
+        ("2026-01-15T20:00:00+00:00", "2026-01-16T14:00:00-05:00"),
+        ("2026-07-15T20:00:00+00:00", "2026-07-16T14:00:00-04:00"),
+        ("2026-03-07T20:00:00+00:00", "2026-03-08T14:00:00-04:00"),
+        ("2026-10-31T20:00:00+00:00", "2026-11-01T14:00:00-05:00"),
+    ],
+    ids=["winter", "summer", "spring-forward", "fall-back"],
+)
 def test_foreign_process_tick_persists_owning_profile_offset(
-    tmp_path, monkeypatch
+    tmp_path, monkeypatch, start, expected
 ):
     """next_run_at persisted during a multiplex tick uses the ticked
     profile's timezone, not the backend process's."""
@@ -48,6 +57,14 @@ def test_foreign_process_tick_persists_owning_profile_offset(
 
     monkeypatch.setenv("HERMES_HOME", str(backend_home))
 
+    class FrozenDatetime(datetime):
+        @classmethod
+        def now(cls, tz=None):
+            return datetime.fromisoformat(start).astimezone(tz)
+
+    # Freeze only the clock; keep real profile-scoped timezone resolution.
+    monkeypatch.setattr(hermes_time, "datetime", FrozenDatetime)
+
     # Backend process resolves its own timezone first (process startup).
     assert hermes_time.now().utcoffset() == datetime.now(
         ZoneInfo("UTC")
@@ -70,7 +87,9 @@ def test_foreign_process_tick_persists_owning_profile_offset(
         reset_hermes_home_override(token)
 
     next_run = datetime.fromisoformat(job["next_run_at"])
-    expected_offset = datetime.now(ZoneInfo("America/New_York")).utcoffset()
+    # The next occurrence can be across DST; today's offset is not its oracle.
+    expected_run = datetime.fromisoformat(expected)
+    expected_offset = expected_run.utcoffset()
     assert next_run.utcoffset() == expected_offset, (
         f"next_run_at {job['next_run_at']} persisted with foreign offset "
         f"{next_run.utcoffset()} instead of the owning profile's "
@@ -78,3 +97,4 @@ def test_foreign_process_tick_persists_owning_profile_offset(
     )
     # And the wall clock honors the cron expression in the profile's zone.
     assert (next_run.hour, next_run.minute) == (14, 0)
+    assert next_run == expected_run
-- 
