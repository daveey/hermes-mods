diff --git a/hermes_cli/kanban_triage_attention.py b/hermes_cli/kanban_triage_attention.py
index 5bb5d22bb1dcd6e002491b806456f7f1b58938d0..afab9aac5e7b126718a4cb0c8d97e539635151c9 100644
--- a/hermes_cli/kanban_triage_attention.py
+++ b/hermes_cli/kanban_triage_attention.py
@@ -5,6 +5,7 @@
 """
 import json
 import math
+import sqlite3
 
 TRIAGE_AFTER_S = 600
 _FIXED = {
@@ -111,18 +112,23 @@
     Only triage cards need histories. Callers retain this detached result under
     their existing source revision memo; elapsed clock passes never call here.
     """
-    from hermes_cli.kanban_table_columns import table_columns
     rows = list(rows)
     targets = {str(row['id']) for row in rows if row.get('status') == 'triage'}
-    columns = table_columns(conn, 'task_events')
     events = {tid: [] for tid in targets}
-    if targets and {'task_id', 'id', 'kind', 'created_at', 'payload'} <= columns:
-        for item in conn.execute(
+    # One statement per call and none without a triage card: hot membership passes call this per status set,
+    # so no schema probe. A board without the event columns reads as unknown entry, never a fabricated age.
+    if targets:
+        try:
+            found = conn.execute(
                 'SELECT task_id, kind, created_at, payload FROM task_events '
                 'WHERE task_id IN (SELECT value FROM json_each(?)) '
                 'AND kind IN (SELECT value FROM json_each(?)) ORDER BY id',
-                (json.dumps(sorted(targets)), json.dumps(LIFECYCLE_KINDS))):
-            tid, kind, at, payload = item
+                (json.dumps(sorted(targets)), json.dumps(LIFECYCLE_KINDS))).fetchall()
+        except sqlite3.OperationalError as exc:
+            if 'no such' not in str(exc):
+                raise
+            found = ()
+        for tid, kind, at, payload in found:
             events[str(tid)].append({'kind': kind, 'created_at': at, 'payload': payload})
     for row in rows:
         row['triage_entered_at'] = current_entry({'status': row.get('status'), 'events': events.get(str(row['id']), ())})
diff --git a/tests/hermes_cli/test_kanban_triage_attention.py b/tests/hermes_cli/test_kanban_triage_attention.py
index 94eee784eb6f55b54563830320a1e99d87fa89ef..aa47cd361388a21e1a1091f82b1a063f5f5cc59e 100644
--- a/tests/hermes_cli/test_kanban_triage_attention.py
+++ b/tests/hermes_cli/test_kanban_triage_attention.py
@@ -167,3 +167,24 @@
     for _, kind, payload in _WRITER_ENTRIES:
         assert attention.landing(kind, payload) == 'triage'
         assert kind in attention.LIFECYCLE_KINDS
+
+
+def test_annotate_costs_one_statement_with_triage_cards_and_none_without():
+    import sqlite3
+    conn = sqlite3.connect(':memory:')
+    conn.execute('CREATE TABLE task_events (id INTEGER PRIMARY KEY, task_id TEXT, kind TEXT, payload TEXT, created_at INTEGER)')
+    conn.execute("INSERT INTO task_events (task_id, kind, payload, created_at) VALUES ('t1', 'contained', '{}', ?)", (NOW - 700,))
+    statements = []
+    conn.set_trace_callback(statements.append)
+    rows = attention.annotate(conn, [{'id': 't1', 'status': 'triage'}, {'id': 't2', 'status': 'ready'}])
+    assert [row['triage_entered_at'] for row in rows] == [NOW - 700, None]
+    assert len(statements) == 1, statements
+    statements.clear()
+    assert attention.annotate(conn, [{'id': 't2', 'status': 'ready'}])[0]['triage_entered_at'] is None
+    assert statements == []
+
+
+def test_annotate_without_an_event_table_is_unknown_not_aged():
+    import sqlite3
+    conn = sqlite3.connect(':memory:')
+    assert attention.annotate(conn, [{'id': 't1', 'status': 'triage'}])[0]['triage_entered_at'] is None
