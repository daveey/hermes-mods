 hermes_cli/kanban_wait_replica.py             |  28 ++
 hermes_cli/kanban_wake_check.py               |  54 +++-
 .../hermes_cli/test_kanban_offline_backoff.py |  16 ++
 .../test_kanban_wait_replica_unknown_scope.py | 259 ++++++++++++++++++
 5 files changed, 357 insertions(+), 8 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_wait_replica_unknown_scope.py

diff --git a/hermes_cli/kanban_offline_backoff.py b/hermes_cli/kanban_offline_backoff.py
index b17933099ce..8c3b72d3cbc 100644
--- a/hermes_cli/kanban_offline_backoff.py
+++ b/hermes_cli/kanban_offline_backoff.py
@@ -6,12 +6,14 @@ import sqlite3
 
 
 def recently_escalated(conn: sqlite3.Connection, task_id: str, cmd: str,
-                       gateway: str, now: int, cooldown: int) -> bool:
+                       gateway: str, now: int, cooldown: int,
+                       reasons: tuple[str, ...] = ("gateway_offline",)) -> bool:
     """Read durable (also pre-fix) wake receipts, not the disposable probe row.
 
     Age in the output continually increases and is not a new premise. A bounded
     persisted wall-clock deadline survives process restart and board replication.
-    Only offline escalations are throttled; success and unexpected faults bypass it.
+    Only source-unavailable escalations (``reasons``: offline, or the owner's board
+    scope unknown) are throttled; success and unexpected faults bypass it.
     """
     rows = conn.execute(
         "SELECT payload FROM task_events WHERE task_id = ? AND kind = 'wake_check_broken' "
@@ -22,7 +24,7 @@ def recently_escalated(conn: sqlite3.Connection, task_id: str, cmd: str,
             payload = json.loads(raw or "{}")
         except (TypeError, ValueError):
             continue
-        if (isinstance(payload, dict) and payload.get("reason") == "gateway_offline"
+        if (isinstance(payload, dict) and payload.get("reason") in reasons
                 and payload.get("wake_check") == cmd and payload.get("gateway") == gateway):
             return True
     return False
diff --git a/hermes_cli/kanban_wait_replica.py b/hermes_cli/kanban_wait_replica.py
index d27a44d1e91..051d4f72c10 100644
--- a/hermes_cli/kanban_wait_replica.py
+++ b/hermes_cli/kanban_wait_replica.py
@@ -29,6 +29,20 @@ class StaleReplica(ValueError):
         self.gateway, self.board, self.age, self.task, self.limit = gateway, board, age, task, limit
 
 
+class UnknownScope(ValueError):
+    """The card was seen in the gateway's replica, but its owner published this board's scope as ``unknown``.
+
+    The owner's collector (hermes-hub ``collect_all``/``scope_heartbeats``) writes ``state: unknown`` with no
+    ``observed_at`` when it could not read the board for longer than its carry window; the task records it published
+    before are kept, never tombstoned. So the last-seen status is known and nothing vouches for it now: "cannot tell,
+    not yet", like a stale replica, but with no observation time to report as an age. [daveey]
+    """
+
+    def __init__(self, gateway, board, task):
+        super().__init__(f"task scope unknown for {gateway}/{board}")
+        self.gateway, self.board, self.task = gateway, board, task
+
+
 def read_task(gateway, target, board=None):
     """Exact owner-qualified match, including completed/archived records, with fresh scope proof."""
     board = board or "default"
@@ -55,6 +69,8 @@ def read_task(gateway, target, board=None):
             # readers still count as fresh (kanban_scope_heartbeat). [daveey]
             limit = max(limit, scope_window(info))
         matched = [s for s in scopes if s.get("profile") == "default" and s.get("board") == board]
+        if len(matched) == 1 and matched[0].get("state") == "unknown" and "observed_at" not in matched[0]:
+            raise UnknownScope(gateway, board, task)
         if len(matched) != 1 or matched[0].get("state") != "ok":
             raise ValueError(f"missing successful task-scope observation for {gateway}/{board}")
         age = time.time() - float(matched[0].get("observed_at") or 0)
@@ -100,6 +116,16 @@ def stale_message(target, stale):
             f"stale_age={stale.age:.0f}s, limit={stale.limit:.0f}s; last seen {status}, unknown now: not yet)")
 
 
+def unknown_message(target, unknown):
+    """Like ``stale_message``: words 0-1 keep the reader shape; ``source_state=unknown`` and ``gateway=`` are what the
+    wake-check dispatcher reads (``kanban_wake_check.source_unknown``). No ``stale_age=``: the owner published no
+    observation time, so none is invented. Never starts with ``error:``."""
+    status = unknown.task.get("status")
+    orphan = " orphan producer;" if orphan_reason(unknown.task) else ""
+    return (f"{target} {status} (replica scope unknown:{orphan} gateway={unknown.gateway} could not read board "
+            f"{unknown.board} (source_state=unknown); last seen {status}, unknown now: not yet)")
+
+
 def check(gateway, target, *, board=None, until=(), since=(), live_timeout=None):
     try:
         source = "replica"
@@ -113,6 +139,8 @@ def check(gateway, target, *, board=None, until=(), since=(), live_timeout=None)
             source = "live owner"
         except StaleReplica as stale:
             return STALE_RC, stale_message(target, stale)
+        except UnknownScope as unknown:
+            return STALE_RC, unknown_message(target, unknown)
         status = task["status"]
         orphan = orphan_reason(task)
         suffix = f" ({source}; orphan producer)" if orphan else f" ({source})"
diff --git a/hermes_cli/kanban_wake_check.py b/hermes_cli/kanban_wake_check.py
index 17e45b9e6e4..699e94a48d6 100644
--- a/hermes_cli/kanban_wake_check.py
+++ b/hermes_cli/kanban_wake_check.py
@@ -14,6 +14,12 @@ dispatcher probes it off-thread on each tick:
   then the card wakes (``wake_check_broken`` with ``reason=gateway_offline``) saying how long the
   gateway has been offline. Identical task/probe/gateway escalations are limited to once per
   24 hours across worker reparks; regular probes and successful-condition wakes are unchanged;
+* exit 3 with ``source_state=unknown`` and ``gateway=<name>`` -> unknown, not yet: the producer's gateway
+  published that board's scope as ``unknown`` (its collector could not read the board), so nothing vouches
+  for the last-seen status and there is no observation age. Never counted toward ``BROKEN_AFTER``; the
+  first such result wakes the card once (``wake_check_broken`` with ``reason=gateway_scope_unknown``), and
+  later ones for the same task/probe/gateway are held while a source-unavailable escalation
+  (``gateway_offline`` or ``gateway_scope_unknown``) is under 24 hours old;
 * anything else, or a timeout, ``BROKEN_AFTER`` times in a row -> the card wakes with a
   ``wake_check_broken`` event so a worker fixes the probe. A broken probe is never silent.
 
@@ -62,6 +68,11 @@ UNKNOWN_RC = 3
 STALE_WAKE_AFTER = 24 * 3600
 STALE_AGE_RE = re.compile(r"\bstale_age=(\d+)s\b")
 STALE_GATEWAY_RE = re.compile(r"\bgateway=(\S+)")
+# kanban_wait_replica.unknown_message: the owner published this board's scope as ``unknown``. [daveey]
+SOURCE_UNKNOWN_RE = re.compile(r"\bsource_state=unknown\b")
+SCOPE_UNKNOWN_REASON = "gateway_scope_unknown"
+# Escalations meaning "the producer's owner cannot vouch for its card": one acknowledges the other.
+SOURCE_UNAVAILABLE_REASONS = ("gateway_offline", SCOPE_UNKNOWN_REASON)
 GUARD_SECONDS = 2 * 3600
 OUTPUT_TAIL_CHARS = 500
 MAX_CMD_CHARS = 2000
@@ -98,6 +109,15 @@ def stale_age(rc: Any, out: str) -> Optional[int]:
     return int(m.group(1)) if m else None
 
 
+def source_unknown(rc: Any, out: str) -> Optional[str]:
+    """The producer's gateway when this result is "owner scope unknown, not yet", else None. [daveey]"""
+    text = out or ""
+    if rc != UNKNOWN_RC or output_error(text) or STALE_AGE_RE.search(text) or not SOURCE_UNKNOWN_RE.search(text):
+        return None
+    m = STALE_GATEWAY_RE.search(text)
+    return (m.group(1).rstrip(",;)") or None) if m else None
+
+
 def output_error(out: str) -> Optional[str]:
     """The matching error line when a probe's output shows it crashed, else None."""
     m = ERROR_OUTPUT_RE.search(out or "")
@@ -148,8 +168,8 @@ def dry_run_error(cmd: Optional[str], *, cwd: Optional[str] = None, env: Optiona
     if rc == 0 and not output_error(out):
         return already_true_message(out, blocker_id=blocker_id)
     bad = None
-    if stale_age(rc, out) is not None:
-        return None  # unknown, not yet: the producer's gateway is offline right now
+    if stale_age(rc, out) is not None or source_unknown(rc, out):
+        return None  # unknown, not yet: the producer's gateway is offline or cannot read its board right now
     if not isinstance(rc, int) or rc >= 2:
         bad = f"exited {rc}"
     elif output_error(out):
@@ -678,10 +698,10 @@ def _remote_producer(gateway: str, ref: str, board: Optional[str]) -> tuple[int,
 def _remote_completed_at(gateway: str, ref: str, board: Optional[str]) -> Optional[int]:
     """The remote card's ``completed_at`` from this host's hermes-hub replica, when it has one. Best effort."""
     try:
-        from hermes_cli.kanban_wait_replica import StaleReplica, read_task
+        from hermes_cli.kanban_wait_replica import StaleReplica, UnknownScope, read_task
         try:
             task = read_task(gateway, ref, board=board)
-        except StaleReplica as exc:
+        except (StaleReplica, UnknownScope) as exc:
             task = exc.task
         value = task.get("completed_at")
         return int(value) if value else None
@@ -863,7 +883,8 @@ def apply_result(conn: sqlite3.Connection, task_id: str, cmd: str, rc: Any, out:
             from hermes_cli.kanban_offline_backoff import recently_escalated
             m = STALE_GATEWAY_RE.search(out or "")
             gw = m.group(1).rstrip(",;)") if m else "the producer's gateway"
-            if age >= STALE_WAKE_AFTER and not recently_escalated(conn, task_id, cmd, gw, now, STALE_WAKE_AFTER):
+            if age >= STALE_WAKE_AFTER and not recently_escalated(conn, task_id, cmd, gw, now, STALE_WAKE_AFTER,
+                                                                  reasons=SOURCE_UNAVAILABLE_REASONS):
                 hours = age / 3600
                 return _wake(conn, task_id, BROKEN_EVENT, {
                     "wake_check": cmd, "rc": rc, "fails": 0, "output": tail, "reason": "gateway_offline",
@@ -877,6 +898,26 @@ def apply_result(conn: sqlite3.Connection, task_id: str, cmd: str, rc: Any, out:
                 "next_at = ? WHERE task_id = ?", (now, rc, tail, now + int(state["every"]), task_id))
             _note_alive(conn, task_id, cmd, now)
             return None
+        gw = source_unknown(rc, out)
+        if gw is not None:
+            # The owner is publishing but says it could not read this board: unknown, not yet, never "broken".
+            # Escalate once; while that (or an offline) escalation is under 24 h old the same probe stays parked.
+            from hermes_cli.kanban_offline_backoff import recently_escalated
+            if not recently_escalated(conn, task_id, cmd, gw, now, STALE_WAKE_AFTER,
+                                      reasons=SOURCE_UNAVAILABLE_REASONS):
+                return _wake(conn, task_id, BROKEN_EVENT, {
+                    "wake_check": cmd, "rc": rc, "fails": 0, "output": tail, "reason": SCOPE_UNKNOWN_REASON,
+                    "gateway": gw,
+                    "note": (f"Gateway {gw} is syncing but reports it could not read its board, so the producer "
+                             "card's status is unknown (its last-seen status is kept, not trusted). Check that "
+                             "gateway's Hermes runtime and hermes-hub collector, then re-check and park again on "
+                             "the same probe (identical unknown results are then held for 24 h), or replan.")})
+            # Same unchanged source state, already escalated: keep any real-failure streak as it was.
+            conn.execute(
+                "UPDATE task_wake_checks SET last_at = ?, last_rc = ?, last_out = ?, "
+                "next_at = ? WHERE task_id = ?", (now, rc, tail, now + int(state["every"]), task_id))
+            _note_alive(conn, task_id, cmd, now)
+            return None
         fails = int(state["fails"] or 0) + 1
         if rc == 1:  # exit 1 with error output: a crashed probe posing as "not yet"
             rc, rc_col = f"exit 1 with error output: {output_error(out)}", 1
@@ -1030,6 +1071,9 @@ def _render_wake_context(conn: sqlite3.Connection, task_id: str) -> str:
         elif payload.get("reason") == "gateway_offline":
             lines.append("## Woken because the producer's gateway is offline")
             lines.append(f"{payload.get('note')} Probe: `{payload.get('wake_check')}`. Last output:")
+        elif payload.get("reason") == SCOPE_UNKNOWN_REASON:
+            lines.append("## Woken because the producer's gateway could not read its board")
+            lines.append(f"{payload.get('note')} Probe: `{payload.get('wake_check')}`. Last output:")
         else:
             lines.append("## Woken because the wake check is broken")
             lines.append(f"The park's wake_check `{payload.get('wake_check')}` failed "
diff --git a/tests/hermes_cli/test_kanban_offline_backoff.py b/tests/hermes_cli/test_kanban_offline_backoff.py
index 56d1177fceb..1e938559550 100644
--- a/tests/hermes_cli/test_kanban_offline_backoff.py
+++ b/tests/hermes_cli/test_kanban_offline_backoff.py
@@ -31,3 +31,19 @@ def test_receipt_identity_and_deadline(change, expected):
         conn.execute("CREATE TABLE task_events(task_id TEXT, kind TEXT, created_at INTEGER, payload TEXT)")
         conn.execute("INSERT INTO task_events VALUES(:task_id, :kind, :created_at, :payload)", row)
         assert recently_escalated(conn, "waiter", "probe", "other", 1000, 100) is expected
+
+
+@pytest.mark.parametrize("reason, reasons, expected", [
+    ("gateway_scope_unknown", None, False),  # default family is offline only (pre-existing callers)
+    ("gateway_scope_unknown", ("gateway_offline", "gateway_scope_unknown"), True),
+    ("gateway_offline", ("gateway_offline", "gateway_scope_unknown"), True),
+    (None, ("gateway_offline", "gateway_scope_unknown"), False),  # a broken-probe wake is never a receipt
+    ("other", ("gateway_offline", "gateway_scope_unknown"), False),
+])
