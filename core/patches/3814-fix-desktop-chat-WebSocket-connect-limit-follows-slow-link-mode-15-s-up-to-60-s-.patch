+
+import { HermesGateway } from './client'
+
+const WS = 'ws://127.0.0.1:41001/api/ws?native_dial=fixture&ticket=fixture'
+
+afterEach(() => {
+  vi.restoreAllMocks()
+  delete (window as { hermesDesktop?: unknown }).hermesDesktop
+})
+
+function bridge(limit: unknown) {
+  const desktop = { gatewayConnectLimit: vi.fn(() => limit), noteGatewayConnect: vi.fn() }
+
+  ;(window as { hermesDesktop?: unknown }).hermesDesktop = desktop
+
+  return desktop
+}
+
+describe('HermesGateway.connect uses the connect limit Desktop main gives its ws URL', () => {
+  it('passes the slow-link limit to the shared dial and reports the open', async () => {
+    const desktop = bridge(60_000)
+    const connect = vi.spyOn(JsonRpcGatewayClient.prototype, 'connect').mockResolvedValue()
+
+    const client = new HermesGateway()
+    await client.connect(WS)
+
+    expect(desktop.gatewayConnectLimit).toHaveBeenCalledWith(WS)
+    expect(connect).toHaveBeenCalledWith(WS, { connectTimeoutMs: 60_000 })
+    expect(desktop.noteGatewayConnect).toHaveBeenCalledWith(WS, expect.objectContaining({ kind: 'opened' }))
+    client.close()
+  })
+
+  it('reports a connect timeout as timed-out and still rejects with it', async () => {
+    const desktop = bridge(15_000)
+
+    const timeout = Object.assign(new Error('no WebSocket open within 15000 ms'), {
+      code: GATEWAY_CONNECT_TIMEOUT_CODE
+    })
+
+    vi.spyOn(JsonRpcGatewayClient.prototype, 'connect').mockRejectedValue(timeout)
+
+    await expect(new HermesGateway().connect(WS)).rejects.toBe(timeout)
+    expect(desktop.noteGatewayConnect).toHaveBeenCalledWith(WS, { kind: 'timed-out' })
+  })
+
+  it('a non-timeout failure is not reported as a strike', async () => {
+    const desktop = bridge(15_000)
+    vi.spyOn(JsonRpcGatewayClient.prototype, 'connect').mockRejectedValue(new Error('WebSocket error before open'))
+
+    await expect(new HermesGateway().connect(WS)).rejects.toThrow('error before open')
+    expect(desktop.noteGatewayConnect).not.toHaveBeenCalled()
+  })
+
+  it.each([undefined, 0, -1, Number.NaN, 'x'])('falls back to the client default when main answers %s', async limit => {
+    bridge(limit)
+    const connect = vi.spyOn(JsonRpcGatewayClient.prototype, 'connect').mockResolvedValue()
+
+    const client = new HermesGateway()
+    await client.connect(WS)
+
+    expect(connect).toHaveBeenCalledWith(WS, {})
+    client.close()
+  })
+
+  it('dials with the client default when there is no Desktop bridge (browser-hosted, tests)', async () => {
+    const connect = vi.spyOn(JsonRpcGatewayClient.prototype, 'connect').mockResolvedValue()
+
+    const client = new HermesGateway()
+    await client.connect(WS)
+
+    expect(connect).toHaveBeenCalledWith(WS, {})
+    client.close()
+  })
+})
diff --git a/apps/desktop/src/api/gateway-link-dial.ts b/apps/desktop/src/api/gateway-link-dial.ts
new file mode 100644
index 0000000000..a7ef23609c
--- /dev/null
+++ b/apps/desktop/src/api/gateway-link-dial.ts
@@ -0,0 +1,62 @@
+// [daveey] The chat WebSocket's connect limit follows Desktop main's slow-link mode (electron/slow-link.ts).
+//
+// Before each dial the renderer asks main for the limit of that URL: 15 s, or up to 60 s while the SSH-forwarded
+// backend behind it is on a slow link. After the dial it reports how it ended, so an open counts as an answer and a
+// timeout as a strike for that link. Without a Desktop bridge (browser-hosted, tests) the client default applies.
+
+import { GATEWAY_CONNECT_TIMEOUT_CODE } from '@hermes/shared'
+
+export type GatewayConnectOutcome = { elapsedMs: number; kind: 'opened' } | { kind: 'timed-out' }
+
+export interface GatewayLinkBridge {
+  gatewayConnectLimit?: (wsUrl: string) => number
+  noteGatewayConnect?: (wsUrl: string, outcome: GatewayConnectOutcome) => void
+}
+
+const desktopBridge = (): GatewayLinkBridge | undefined =>
+  (globalThis as { hermesDesktop?: GatewayLinkBridge }).hermesDesktop
+
+/** The limit main gives this dial, or undefined (client default) when main has no answer. */
+function connectLimit(bridge: GatewayLinkBridge | undefined, wsUrl: string): number | undefined {
+  try {
+    const limit = bridge?.gatewayConnectLimit?.(wsUrl)
+
+    return typeof limit === 'number' && Number.isFinite(limit) && limit > 0 ? limit : undefined
+  } catch {
+    return undefined
+  }
+}
+
+function report(bridge: GatewayLinkBridge | undefined, wsUrl: string, outcome: GatewayConnectOutcome): void {
+  try {
+    bridge?.noteGatewayConnect?.(wsUrl, outcome)
+  } catch {
+    // Reporting is advisory: the dial's own result stands.
+  }
+}
+
+/**
+ * Run one WebSocket dial with the connect limit main gives `wsUrl`, then report its outcome. `dial` receives the
+ * per-dial options for `JsonRpcGatewayClient.connect`; its result or rejection is passed through unchanged.
+ */
+export async function dialWithLinkLimit(
+  wsUrl: string,
+  dial: (options: { connectTimeoutMs?: number }) => Promise<void>,
+  bridge: GatewayLinkBridge | undefined = desktopBridge(),
+  now: () => number = Date.now
+): Promise<void> {
+  const connectTimeoutMs = connectLimit(bridge, wsUrl)
+  const startedAt = now()
+
+  try {
+    await dial(connectTimeoutMs === undefined ? {} : { connectTimeoutMs })
+  } catch (error) {
+    if ((error as { code?: unknown } | null)?.code === GATEWAY_CONNECT_TIMEOUT_CODE) {
+      report(bridge, wsUrl, { kind: 'timed-out' })
+    }
+
+    throw error
+  }
+
+  report(bridge, wsUrl, { elapsedMs: now() - startedAt, kind: 'opened' })
+}
