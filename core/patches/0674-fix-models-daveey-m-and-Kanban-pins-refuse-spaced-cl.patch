+    _reject_spaced_pin(model, provider)
     return model, provider
 
 
+def _reject_spaced_pin(model: Optional[str], provider: Optional[str]) -> None:
+    """The ``/model`` whitespace rule for Kanban pins [daveey]. A provider-less pin is checked again
+    once ``resolve_pin_provider`` binds its provider (a ``custom`` profile keeps spaced ids)."""
+    if not model or not provider:
+        return
+    from hermes_cli.models_validate import model_whitespace_error
+
+    message = model_whitespace_error(model, provider)
+    if message:
+        raise ValueError(f"{message} Pin one model per card (got {model!r} on provider {provider!r}).")
+
+
 def _canonical_assignee(assignee: Optional[str]) -> Optional[str]:
     """Lowercase-assignee normalization for Kanban rows (dashboard/CLI parity)."""
     if assignee is None:
@@ -1322,6 +1335,7 @@ def create_task(
     # [daveey] Bind a provider-less concrete pin now (or refuse), never late-bind it to config at spawn.
     from hermes_cli.kanban_pin_provider import resolve_pin_provider
     model_override, provider_override = resolve_pin_provider(model_override, provider_override, assignee=assignee)
+    _reject_spaced_pin(model_override, provider_override)
 
     # Retry once on the extremely unlikely id collision.
     for attempt in range(2):
@@ -1524,6 +1538,7 @@ def set_model_override(
         from hermes_cli.kanban_pin_provider import resolve_pin_provider
         row = conn.execute("SELECT assignee FROM tasks WHERE id = ?", (task_id,)).fetchone()
         model, provider = resolve_pin_provider(model, None, assignee=row[0] if row else None)
+        _reject_spaced_pin(model, provider)
     return _set_task_override(
         conn, task_id,
         "UPDATE tasks SET model_override = ?, provider_override = ? WHERE id = ?", (model, provider),
diff --git a/hermes_cli/main.py b/hermes_cli/main.py
index fcb2cc2e6183b48ab8a10e3d37daf7e2b11e322b..e5214a0feed2d0621af0b012dbb1ffa71fa9c2e2 100644
--- a/hermes_cli/main.py
+++ b/hermes_cli/main.py
@@ -1185,6 +1185,29 @@ def _has_any_provider_configured(*, strict_profile_scope: bool = False) -> bool:
     return False
 
 
+def _reject_startup_spaced_model(explicit_model: str, explicit_provider: str, model_cfg: dict) -> None:
+    """``-m`` gets the ``/model`` whitespace rule before any API call [daveey].
+
+    A shell loop that fails to split a list passes every id as one ``-m`` value; a cloud provider
+    then 404s it (or a fallback chain answers on a different model and the probe "passes").
+    The configured base_url only counts when it belongs to the provider being used.
+    """
+    if not explicit_model or not any(ch.isspace() for ch in explicit_model):
+        return
+    cfg_provider = str(model_cfg.get("provider") or "").strip()
+    provider = explicit_provider or cfg_provider
+    base_url = str(model_cfg.get("base_url") or "").strip()
+    if explicit_provider and explicit_provider != cfg_provider:
+        base_url = ""
+    from hermes_cli.models_validate import model_whitespace_error
+
+    if model_whitespace_error(explicit_model, provider, base_url or None):
+        sys.stderr.write(
+            f"Model names cannot contain spaces. Pass one model per run.\n  got: -m {explicit_model!r}\n"
+        )
+        raise SystemExit(2)
+
+
 def _confirm_startup_expensive_model_override(args) -> None:
     """Guard startup -m/--provider overrides before the first API call."""
     explicit_model = (getattr(args, "model", None) or "").strip()
@@ -1211,6 +1234,7 @@ def _confirm_startup_expensive_model_override(args) -> None:
     config = _dict(config)
     model_cfg = _dict(config.get("model"))
     security_cfg = _dict(config.get("security"))
+    _reject_startup_spaced_model(explicit_model, explicit_provider, model_cfg)
 
     model = explicit_model or (model_cfg.get("default") or "").strip()
     if not model:
