From 0bee5c66da5a986cd1544de39a396634495984df Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 07:51:06 +0000
Subject: [PATCH] fix(models): [daveey] -m and Kanban pins refuse spaced cloud
 model ids like /model does

A route probe passed seven model ids as one `-m` value ("claude-opus-5-5
openai-codex/gpt-6-astra ..."). /model has refused spaced ids on cloud
providers for a long time, but the startup -m/--model flag (chat, TUI, -z)
and Kanban --model pins never called that rule: Anthropic answered 404 x3,
and on a host with a fallback chain the probe "passed" on another model.

- models_validate.model_whitespace_error(): the /model whitespace rule as a
  shared helper (same self-hosted / user base_url exemptions).
- startup -m: refuse before any API call, exit 2, "Model names cannot
  contain spaces. Pass one model per run."
- kanban create_task / set_model_override: ValueError, also after a
  provider-less pin is bound by resolve_pin_provider.
- error_classifier: Anthropic 404 not_found_error "model: <id>" is
  model_not_found, not a generic unknown 404.
- tests/hermes_cli/test_model_whitespace_entry_parity.py runs the same bad
  and good ids through /model, -m, -z and Kanban so they cannot drift.

Self-heal agent-0a0a3008d1 (card t_01a1815770364ddb).
---
diff --git a/agent/error_classifier.py b/agent/error_classifier.py
index e9489f492c3fb095d46bef2a06b29cff4484acc6..2a95fa102517982ce74ec5324997fa74560acbd2 100644
--- a/agent/error_classifier.py
+++ b/agent/error_classifier.py
@@ -1088,6 +1088,18 @@ def _status_403(c: _Ctx) -> Verdict:
     return _V_AUTH_FALLBACK
 
 
+def _is_anthropic_model_not_found(body: Any) -> bool:
+    """Anthropic's unknown-model 404 names the field instead of saying "model not found":
+    ``{"type": "error", "error": {"type": "not_found_error", "message": "model: <id>"}}`` [daveey].
+    Only the ``model:`` field counts; a 404 on a file or batch id is not a missing model."""
+    if not isinstance(body, dict):
+        return False
+    err = _error_obj(body)
+    if not isinstance(err, dict) or str(err.get("type") or "").lower() != "not_found_error":
+        return False
+    return str(err.get("message") or "").strip().lower().startswith("model:")
+
+
 def _status_404(c: _Ctx) -> Verdict:
     # Structured billing code first, as in _status_429: this handler always returns,
     # so _by_error_code never sees it; a bare "Not Found" message has nothing to match.
@@ -1096,6 +1108,8 @@ def _status_404(c: _Ctx) -> Verdict:
     verdict = _first_match(c.msg, _404_RULES)
     if verdict is not None:
         return verdict
+    if _is_anthropic_model_not_found(c.body):
+        return _V_MODEL_NOT_FOUND
     # Bare id the catalogue only knows prefixed → malformed id (NVIDIA NIM "404
     # page not found", #78796). A generic 404 (wrong path, proxy glitch) stays
     # unknown so the real error surfaces instead of a silent misreported fallback.
