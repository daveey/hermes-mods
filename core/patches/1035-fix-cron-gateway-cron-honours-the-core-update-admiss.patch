diff --git a/gateway/run_shutdown_restart_wait.py b/gateway/run_shutdown_restart_wait.py
new file mode 100644
index 00000000000..d1924cb76a4
--- /dev/null
+++ b/gateway/run_shutdown_restart_wait.py
@@ -0,0 +1,102 @@
+"""Restart-wait helpers of ``GatewayShutdownMixin``: naming the work a restart waits on, and cancelling a
+core update's drain restart when that update gives up. [daveey]
+
+hermes-gateway-launcher (the core-update execution gate) SIGUSR1s its gateway when hermes-sync publishes
+``<HERMES_HOME>/core-update/intent``, and hermes-sync removes the intent when the gateway drain outlives
+its wait. The deferred restart used to run anyway once the last work unit ended, relaunching the OLD code
+(David-MBP 2026-10-29 15:29-15:47: a cron run held the restart 17 min, t_01a189db034f3b2b).
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import time
+from contextlib import suppress
+from pathlib import Path
+from typing import Optional
+
+logger = logging.getLogger("gateway.run")
+
+# ``_await_active_work_before_restart`` result: the core update behind the restart gave up.
+RESTART_CANCELLED = object()
+
+
+class GatewayRestartWaitMixin:
+    """Mixed into ``GatewayShutdownMixin``; methods use the runner's restart/drain state."""
+
+    def _describe_active_work(self) -> list:
+        """One dict per in-flight work unit the restart wait is holding for, so an observer
+        (``hermes update``, ``hermes gateway status``) can name it instead of printing a bare count.
+
+        ``kind`` ∈ ``chat`` (session turn), ``cron`` (job id + external worker pid when the run was
+        handed to a restart-safe scope), ``api`` / ``deferred`` (count only — those sources expose
+        no identity). Best-effort: a source that can't be read is omitted, never raises.
+        """
+        from gateway.run import _AGENT_PENDING_SENTINEL
+        now = time.time()
+        units: list = []
+        for key, state in list(self._sessions_map().items()):
+            agent = state.turn.agent
+            if agent is None:
+                continue
+            unit: dict = {"kind": "chat", "session": key, "pid": os.getpid()}
+            if state.turn.started_ts:
+                unit["elapsed_s"] = round(now - state.turn.started_ts, 1)
+            if agent is not _AGENT_PENDING_SENTINEL:
+                unit["model"] = getattr(agent, "model", None)
+                summary_fn = getattr(agent, "get_activity_summary", None)
+                if callable(summary_fn):
+                    with suppress(Exception):
+                        summary = summary_fn()
+                        unit["current_tool"] = summary.get("current_tool")
+                        unit["idle_s"] = summary.get("seconds_since_activity")
+            units.append(unit)
+        with suppress(Exception):
+            from cron.scheduler import get_running_job_details, get_wedged_job_ids
+            wedged = get_wedged_job_ids()
+            for job in get_running_job_details():
+                units.append({"kind": "cron", "job_id": job["job_id"], "elapsed_s": job["elapsed_s"],
+                              "pid": job["worker_pid"] or os.getpid(), "external": bool(job["worker_pid"]),
+                              "wedged": job["job_id"] in wedged,
+                              "restart_safe": bool(job.get("restart_safe"))})
+        for kind, count in (("api", self._active_api_run_count()), ("deferred", self._active_deferred_agent_worker_count())):
+            units.extend({"kind": kind, "pid": os.getpid()} for _ in range(count))
+        return units
+
+    def _core_update_intent_path(self) -> Optional[Path]:
+        """``<HERMES_HOME>/core-update/intent`` when it exists now, else None. A restart requested
+        while it exists is that update's drain request."""
+        with suppress(Exception):
+            home = os.environ.get("HERMES_HOME")
+            if not home:
+                from hermes_constants import get_hermes_home
+                home = str(get_hermes_home())
+            path = Path(home) / "core-update" / "intent"
+            if path.exists():
+                return path
+        return None
+
+    def _update_intent_withdrawn(self, intent: Optional[Path]) -> bool:
+        """True (and logged) when the update intent behind this restart is gone: the update gave up,
+        so restarting now would only relaunch the code already running. While a launcher-supervised
+        gateway child is alive the updater cannot have applied (it needs LOCK_EX on exec.lock)."""
+        if intent is None or intent.exists():
+            return False
+        logger.warning(
+            "Restart cancelled: the core update that requested it gave up (%s removed) with %d active "
+            "work unit(s) still running; staying up on the current code instead of restarting for an "
+            "update that did not apply", intent, self._awaitable_work_count())
+        return True
+
+    def _cancel_restart(self) -> None:
+        """Undo ``request_restart`` before ``stop()``: accept new turns again, report ``running``, and
+        let the next update's SIGUSR1 request a fresh restart. API runs keep their informational
+        ``shutdown_requested_at`` stamp."""
+        self._restart_requested = False
+        self._restart_detached = False
+        self._restart_via_service = False
+        self._restart_update_intent = None
+        self._draining = False
+        self._restart_task_started = False
+        self._scale_to_zero_status("running", "restart cancel: status mark failed")
diff --git a/hermes_cli/admission_fence.py b/hermes_cli/admission_fence.py
index 96a09a0094e..cfbbd0a4a01 100644
--- a/hermes_cli/admission_fence.py
+++ b/hermes_cli/admission_fence.py
@@ -90,6 +90,26 @@ def reserve(home):
             raise
 
 
+def extend(home):
+    """A reservation taken WITHOUT the hold check, for work already admitted under a live reservation
+    the caller still holds (a cron run registered inside its tick's reservation). The updater reads
+    reservations after setting the hold, so it sees the caller's or this one: never neither. [daveey]"""
+    import fcntl
+
+    with admission_lock(home, timeout=0.05) as root:
+        directory = root / "reservations"
+        directory.mkdir(exist_ok=True)
+        path = directory / uuid.uuid4().hex
+        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_RDWR, 0o600)
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            return Reservation(fd, path)
+        except BaseException:
+            os.close(fd)
+            path.unlink(missing_ok=True)
+            raise
+
+
 def _state_locked(root):
     import fcntl
 
diff --git a/tests/cron/test_update_admission_hold.py b/tests/cron/test_update_admission_hold.py
new file mode 100644
index 00000000000..a15138d74b5
--- /dev/null
+++ b/tests/cron/test_update_admission_hold.py
@@ -0,0 +1,91 @@
+"""Cron honours the core-update admission fence (t_01a189db034f3b2b).
+
+hermes-sync's drain window sets ``<root>/core-update/holds/hermes-sync`` and publishes the update intent
+only once every admission reservation is gone. Cron took no reservation, so a job due in the window
+started under the hold and held the gateway restart open past the window (David-MBP 2026-10-29).
+"""
+
+from datetime import UTC, datetime
+import threading
+
+
+def _root():
+    from cron import scheduler
+    from hermes_constants import get_default_hermes_root
+
+    return get_default_hermes_root(home=scheduler._get_hermes_home())
+
+
+def _quiet(monkeypatch):
+    from cron import scheduler
+
+    for name in ("_maybe_run_worktree_maintenance", "_sweep_mcp_orphans", "_maybe_reap_dead_owners"):
+        monkeypatch.setattr(scheduler, name, lambda: None)
+    monkeypatch.setattr(scheduler, "_should_yield_tick_to_fresh_gateway", lambda: None)
+
+
+def test_a_job_due_during_the_hold_is_deferred_not_dropped(tmp_path, monkeypatch):
+    from cron import jobs, scheduler
+    from hermes_cli import admission_fence
+
+    _quiet(monkeypatch)
+    ran = []
+    monkeypatch.setattr(scheduler, "_process_due_job", lambda job, *a: ran.append(job["id"]) or True)
+    script = tmp_path / "job.py"
+    script.write_text("print('x')\n")
+    job = jobs.create_job(prompt=None, schedule="every 15m", script=str(script), no_agent=True)
+    jobs.update_job(job["id"], {"next_run_at": datetime.now(UTC).isoformat()})
+    before = jobs.get_job(job["id"])["next_run_at"]
+
+    root = _root()
+    admission_fence.set_hold(root)
+    try:
+        assert scheduler.tick(verbose=False) == 0
+        assert ran == []
+        assert jobs.get_job(job["id"])["next_run_at"] == before  # still due, not advanced
+    finally:
+        admission_fence.clear_hold(root)
+    assert scheduler.tick(verbose=False) == 1
+    assert ran == [job["id"]]
+
+
+def test_a_running_job_holds_an_admission_reservation_until_it_ends(tmp_path, monkeypatch):
+    from concurrent.futures import ThreadPoolExecutor
+    from cron import jobs, scheduler
+    from hermes_cli import admission_fence
+
+    _quiet(monkeypatch)
+    running, release = threading.Event(), threading.Event()
+
+    def process_job(*args):
+        running.set()
+        assert release.wait(10)
+        return True
+
+    monkeypatch.setattr(scheduler, "_process_due_job", process_job)
+    script = tmp_path / "job.py"
+    script.write_text("print('x')\n")
+    job = jobs.create_job(prompt=None, schedule=datetime.now(UTC).isoformat(), script=str(script), no_agent=True)
+    root = _root()
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        monkeypatch.setattr(scheduler, "_get_parallel_pool", lambda *a: pool)
+        try:
+            assert scheduler.tick(verbose=False, sync=False) == 1
+            assert running.wait(10)
+            assert job["id"] in scheduler.get_running_job_ids()
+            # The tick's own reservation is gone; the run's stays until it ends.
+            assert admission_fence.state(root)["reservations"] == 1
+            # A hold set mid-run does not hide it from the updater's post-hold read.
+            admission_fence.set_hold(root)
+            assert admission_fence.state(root) == {"version": 1, "held": True, "reservations": 1}
+        finally:
+            release.set()
+    deadline = threading.Event()
+    for _ in range(100):
+        if not scheduler.get_running_job_ids():
+            break
+        deadline.wait(0.05)
+    try:
+        assert admission_fence.state(root)["reservations"] == 0
+    finally:
+        admission_fence.clear_hold(root)
