+  const source = atom([{ id: 'kept' }])
+  paneMirror({
+    source,
+    key: tile => tile.id,
+    prefix: 'retain-tile',
+    title: id => id,
+    minWidth: '10rem',
+    dir: () => 'center',
+    anchor: () => 'workspace',
+    render: () => null,
+    close: () => undefined,
+    retain: () => true,
+    retainLimit: 4
