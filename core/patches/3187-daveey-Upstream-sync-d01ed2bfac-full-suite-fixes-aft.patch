From b39991718ab6015b10fb2b286d45943c4fd7f591 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 09:33:02 +0000
Subject: [PATCH] [daveey] Upstream sync d01ed2bfac: full-suite fixes after the
 merge

- sidecar registry: _chat_adopted (upstream delegate-row adoption) is an owner-reserved
  lineage marker written only by the gateway's session recovery
- cron shutdown test rows carry the claim fence upstream's bind_turn reads
- the upstream reset-row delegate-marker heal skips a damaged sessions b-tree on open
  (the first write latches it, as the fork's corruption contract requires)
- header-probe release: the lock-safe readers' pread fds hold no locks either
- legacy local-completion route tests keep their note outcome under upstream resumes_parent
- e2e dashboard auth sweep: /api/peer is peer-pass gated (404 peer_access_unavailable)
- kanban: forward HERMES_KANBAN_RATE_LIMIT_COOLDOWN_SECONDS to the worker client, its
  owner and the failed-result observer, which books the quota episode with it
---
 hermes_cli/kanban_failed_result_service.py      |  6 ++++--
 hermes_cli/kanban_worker_client.py              |  6 ++++--
 hermes_cli/kanban_worker_env.py                 |  3 +++
 hermes_state_dbfile.py                          |  4 ++++
 hermes_state_schema.py                          |  4 +++-
 hermes_state_sidecar_keys.py                    |  5 +++--
 tests/cron/test_shutdown_interrupt.py           |  2 +-
 tests/e2e/core/dashboard/test_dashboard_auth.py | 17 ++++++++++++++++-
 tests/gateway/test_legacy_local_completion.py   |  5 +++++
 .../hermes_state/test_sidecar_keys_registry.py  |  3 +++
 10 files changed, 46 insertions(+), 9 deletions(-)

diff --git a/hermes_cli/kanban_failed_result_service.py b/hermes_cli/kanban_failed_result_service.py
index 1b7dcbb19e..fde40f57c3 100644
--- a/hermes_cli/kanban_failed_result_service.py
+++ b/hermes_cli/kanban_failed_result_service.py
@@ -55,9 +55,11 @@ def arm_service(context, *, startup_seconds=5.0):
                '--property=StartLimitIntervalSec=0',
                f'--working-directory={project_root_str()}']
     # A manager-created service does not inherit its submitter's environment.
-    # Keep profile/path resolution, without forwarding secrets or worker pins.
+    # Keep profile/path resolution, without forwarding secrets or worker pins. The rate-limit
+    # cooldown is policy the reaper applies when it records a quota episode for this run: without it
+    # the observer books the default backoff although its dispatcher runs another one.
     for key in ('PATH', 'PYTHONPATH', 'HERMES_HOME', 'HERMES_KANBAN_HOME', 'HERMES_KANBAN_BOARD',
-                'HOME', 'LANG', 'TZ', 'TMPDIR'):
+                'HERMES_KANBAN_RATE_LIMIT_COOLDOWN_SECONDS', 'HOME', 'LANG', 'TZ', 'TMPDIR'):
         if key in env:
             command.append(f'--setenv={key}={env[key]}')
     command += ['--', *argv]
diff --git a/hermes_cli/kanban_worker_client.py b/hermes_cli/kanban_worker_client.py
index 9fc53ba1f4..362f681a2e 100644
--- a/hermes_cli/kanban_worker_client.py
+++ b/hermes_cli/kanban_worker_client.py
@@ -386,8 +386,10 @@ def _submit():
         board_db = os.environ['HERMES_KANBAN_DB']
         # Owner startup must never inherit this worker's task/tool/goal identity.
         for key in list(os.environ):
-            # The busy timeout is a host tuning knob, not task identity: the answer budget reads it.
-            if key.startswith('HERMES_KANBAN_') and key not in ('HERMES_KANBAN_HOME', 'HERMES_KANBAN_BUSY_TIMEOUT_MS'):
+            # The busy timeout is a host tuning knob, not task identity: the answer budget reads it. So is
+            # the rate-limit cooldown, which this run's failed-result observer books its quota episode with.
+            if key.startswith('HERMES_KANBAN_') and key not in (
+                    'HERMES_KANBAN_HOME', 'HERMES_KANBAN_BUSY_TIMEOUT_MS', 'HERMES_KANBAN_RATE_LIMIT_COOLDOWN_SECONDS'):
                 os.environ.pop(key)
         for key in ('HERMES_SESSION_SOURCE', 'HERMES_TENANT', 'TERMINAL_CWD'):
             os.environ.pop(key, None)
diff --git a/hermes_cli/kanban_worker_env.py b/hermes_cli/kanban_worker_env.py
index cb44f50943..8ded31f398 100644
--- a/hermes_cli/kanban_worker_env.py
+++ b/hermes_cli/kanban_worker_env.py
@@ -39,6 +39,9 @@ _HOST_NAMES = frozenset({
     "HERMES_PYTHON_SRC_ROOT", "HERMES_DATA_DIR_SUFFIX", "HERMES_HOME_MODE", "HERMES_MANAGED",
     "HERMES_CONTAINER", "HERMES_SKIP_CHMOD", "HERMES_GATEWAY_LOCK_DIR", "HERMES_DISABLE_LAZY_INSTALLS",
     "HERMES_KANBAN_HOME", "HERMES_KANBAN_BUSY_TIMEOUT_MS",
+    # The board's rate-limit cooldown: the worker's failed-result observer reaps a 429 run and books
+    # its quota episode with it, so it must match the dispatcher's (else it books the default).
+    "HERMES_KANBAN_RATE_LIMIT_COOLDOWN_SECONDS",
     # The administrator-managed scope directory (an IT bootstrap override, never in any profile's
     # ``.env``): without it a cold-started gateway loses the managed overlay stored elsewhere.
     "HERMES_MANAGED_DIR",
diff --git a/hermes_state_dbfile.py b/hermes_state_dbfile.py
index 944d0b0001..d44feef20a 100644
--- a/hermes_state_dbfile.py
+++ b/hermes_state_dbfile.py
@@ -145,6 +145,10 @@ def inodes_with_other_descriptors(identities: set[tuple[int, int]]) -> Optional[
         probe_fds.update(_RETIRED_HEADER_PROBE_FDS)  # retired probes hold no locks either
     finally:
         _HEADER_PROBE_LOCK.release()
+    # The lock-safe readers' cached O_RDONLY pread fds (hermes_cli.sqlite_safe_read) hold no locks
+    # either: counting them would pin every probe of a file that path also read a header through.
+    from hermes_cli.sqlite_safe_read import lock_safe_fds
+    probe_fds.update(lock_safe_fds())
     descriptors = own_descriptors()
     if descriptors is None:
         return None
