From f670884d3e950ea77f8e80fa1f608ded6cbc2134 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 23:24:50 -0700
Subject: [PATCH 1147/1157] test: deflake runtime lookup deadline test [daveey]
 (#260)

test_runtime_lookup_has_one_deadline_with_bounded_parallel_reads gave the
3 s lookup deadline only a 2 s margin (finished.wait(5) after overlap). A
throttled CI runner that stalls the process across the deadline let the
test's wait time out first (CI run 41007103734; reproduced 1/4 under a
2.5 s SIGSTOP / 0.4 s SIGCONT duty cycle).

The stalled responses now trickle a byte every 0.5 s until released, so no
socket timeout can end them and only the lookup deadline can; the waits are
60 s and return as soon as the event is set. Verified the test still fails
when the deadline is removed (_RUNTIME_LOOKUP_SECONDS=1000).
---
 tests/hermes_cli/test_source_check.py | 21 +++++++++++++++++----
 1 file changed, 17 insertions(+), 4 deletions(-)

diff --git a/tests/hermes_cli/test_source_check.py b/tests/hermes_cli/test_source_check.py
index 972f6822661..a51f537d920 100644
--- a/tests/hermes_cli/test_source_check.py
+++ b/tests/hermes_cli/test_source_check.py
@@ -721,7 +721,7 @@ def test_runtime_lookup_has_one_deadline_with_bounded_parallel_reads(installatio
     peak = 0
     verdicts = []
 
-    def stalled(_handler):
+    def stalled(handler):
         nonlocal active, peak
         with lock:
             active += 1
@@ -729,7 +729,17 @@ def test_runtime_lookup_has_one_deadline_with_bounded_parallel_reads(installatio
             if active == 4:
                 overlapped.set()
         try:
-            release.wait(20)
+            # A response that keeps trickling bytes: no socket timeout ends it, only the lookup
+            # deadline can. It stalls far past every wait below (until `release`).
+            handler.send_response(200)
+            handler.end_headers()
+            for _ in range(240):
+                if release.wait(0.5):
+                    break
+                try:
+                    handler.wfile.write(b"#")
+                except OSError:
+                    break
             return 200, "SCHEMA_SQL = 'old schema'"
         finally:
             with lock:
@@ -750,9 +760,12 @@ def test_runtime_lookup_has_one_deadline_with_bounded_parallel_reads(installatio
     checker = threading.Thread(target=check, daemon=True)
     checker.start()
     try:
+        # Generous waits that return as soon as the event is set: the trickling responses last until
+        # `release` (set only in `finally`), so the check can finish here only by its 3 s deadline.
+        # A fixed 2 s margin over that deadline flaked when a throttled runner stalled the process.
         if blocked == "modules":
-            assert overlapped.wait(5), "independent schema reads must overlap"
-        assert finished.wait(5), "a slow successful response must not extend the whole lookup deadline"
+            assert overlapped.wait(60), "independent schema reads must overlap"
+        assert finished.wait(60), "a slow successful response must not extend the whole lookup deadline"
         assert verdicts == [None]
         assert peak <= 4
     finally:
-- 
