From 843023af876e81eda78427f52f6716b153d6190c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 03:47:58 +0000
Subject: [PATCH] fix(kanban): declare intended custody projection boundary
 [daveey]

The bundled Kanban dashboard intentionally reads the same internal custody projection as CLI and tool show, rather than duplicating event semantics or exposing staging internals as a public plugin API. Record only this one file/symbol crossing. Proof: required CI caught the missing boundary declaration; boundary, notifier and custody surface suites now pass 51 tests with zero skips.
---
 scripts/boundary_lint_baseline.json | 1 +
 1 file changed, 1 insertion(+)

diff --git a/scripts/boundary_lint_baseline.json b/scripts/boundary_lint_baseline.json
index 6382c9db93..ebada0c22a 100644
--- a/scripts/boundary_lint_baseline.json
+++ b/scripts/boundary_lint_baseline.json
@@ -196,6 +196,7 @@
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.inventory.build_models_payload": 1,
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.inventory.load_picker_context": 1,
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.kanban._check_dispatcher_presence": 1,
+    "plugins/kanban/dashboard/plugin_api.py hermes_cli.kanban_artifact_receipt.latest_receipt": 1,
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.kanban_db": 1,
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.kanban_db_attachment_names._collision_free_path": 1,
     "plugins/kanban/dashboard/plugin_api.py hermes_cli.kanban_db_attachment_names._safe_attachment_name": 1,
