From 4ff082cbade713f61dc328fd8e6b5de2979e1c43 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 08:02:25 +0000
Subject: [PATCH] [daveey] Preserve pickup lane in candidate refusal replay

Review found final pickup skip replay defaulted review cards to ready. Carry observed candidate status through the existing evaluation loop; unknown lanes are excluded rather than guessed. No extra graph query or scheduling changes.

Proof: reviewer pickup-to-export reproduction fails on d190d0928c; ready/review prefilter and late import regression matrix passes, with receipt and lockguard suites 32 passed. Full scripts/check passed.
---
 hermes_cli/kanban_worker_node.py              |  9 +++-
 .../test_kanban_candidate_pickup_receipts.py  | 49 +++++++++++++++++++
 2 files changed, 56 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_candidate_pickup_receipts.py

diff --git a/hermes_cli/kanban_worker_node.py b/hermes_cli/kanban_worker_node.py
index b763cbb696..f0cd0bf3cf 100644
--- a/hermes_cli/kanban_worker_node.py
+++ b/hermes_cli/kanban_worker_node.py
@@ -596,6 +596,7 @@ def _unimported_pinned(conn: sqlite3.Connection, replica: sqlite3.Connection, ow
 def _evaluate(conn: sqlite3.Connection, replica: sqlite3.Connection, own: str, *, mode: str, limit: Any,
               profile_exists: Optional[Callable[[str], bool]], full_detail: str,
               held: Optional[dict[str, tuple]] = None,
+              statuses: Optional[dict[str, str]] = None,
               ) -> tuple[list[str], dict[str, tuple[str, Optional[str]]]]:
     """One pass over the candidates: ids to copy (at most ``limit``, in candidate order) and, for each card pinned
     to this machine that the pass leaves on the Board, why. ``budget_exhausted`` only for a card this pass would
@@ -624,6 +625,8 @@ def _evaluate(conn: sqlite3.Connection, replica: sqlite3.Connection, own: str, *
     room = PoolBudget(limit.regular, limit.priority, limit.limit) if isinstance(limit, PoolBudget) else \
         PoolBudget(limit, 0)  # an int is a classless budget; a hub's pool budget never copies unstartable work
     for card in listed:
+        if statuses is not None:
+            statuses[card["id"]] = card["status"]
         full = not room.admits(row_class(card))
         if full and card["id"] not in mine:
             from hermes_cli.kanban_candidate_receipts import note
@@ -777,9 +780,10 @@ def pickup(conn: sqlite3.Connection, *, budget: Any,
     from hermes_cli import kanban_pickup_held as kph
     own = _own(conn)
     held: dict[str, tuple] = {}
+    statuses: dict[str, str] = {}
     try:
         picked, skips = _evaluate(conn, replica, own, mode=mode, limit=limit, profile_exists=profile_exists,
-                                  full_detail="pickup batch full this tick", held=held)
+                                  full_detail="pickup batch full this tick", held=held, statuses=statuses)
         from hermes_cli import kanban_replica_lag as lag  # copied back next tick, once the replica holds our push
         behind = lag.lagging(_replica_path(conn), picked)
         skips.update({tid: ("other", "replica behind this gateway's push") for tid in behind})
@@ -796,7 +800,8 @@ def pickup(conn: sqlite3.Connection, *, budget: Any,
     skips.update(denied)
     from hermes_cli.kanban_candidate_receipts import pickup_skip
     for tid, why in skips.items():
-        pickup_skip(tid, why)
+        # Preserve the observed lane; unlisted/unknown cards are not ready-only evidence.
+        pickup_skip(tid, why, status=statuses.get(tid, 'unknown'))
     imported = [tid for tid in imported if tid not in denied]
     kph.remember({tid: sig for tid, sig in held.items() if tid in imported})
     _record_skips(conn, {tid: why for tid, why in skips.items() if tid not in imported})
diff --git a/tests/hermes_cli/test_kanban_candidate_pickup_receipts.py b/tests/hermes_cli/test_kanban_candidate_pickup_receipts.py
new file mode 100644
index 0000000000..fa399aec22
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_candidate_pickup_receipts.py
@@ -0,0 +1,49 @@
+from unittest.mock import Mock
+import pytest
+from hermes_cli import kanban_candidate_receipts as receipts
+from hermes_cli import kanban_worker_node as node
+
+
+@pytest.mark.parametrize('status', ['ready', 'review'])
+@pytest.mark.parametrize('stage', ['prefilter', 'import'])
+def test_pickup_refusal_preserves_lane(monkeypatch, status, stage):
+    from hermes_cli import kanban_hub_admission_pickup as admission
+    from hermes_cli import kanban_pickup_held as held
+    from hermes_cli import kanban_replica_lag as lag
+    from hermes_cli import kanban_db_dispatch as dispatch
+    from hermes_cli import kanban_dispatch_priority as priority
+    card = dict(id='review-card', status=status, assignee='missing', runs_on=['pool:worker'])
+    monkeypatch.setattr(node, 'pickup_mode', lambda: 'pool')
+    monkeypatch.setattr(node.sync, 'board_mode', lambda _: 'primary')
+    for name in ('evict', '_refill_copies', '_record_skips'):
+        monkeypatch.setattr(node, name, lambda *a: None)
+    monkeypatch.setattr(node, 'open_replica', lambda _: Mock())
+    monkeypatch.setattr(node, '_own', lambda _: 'worker-a1')
+    monkeypatch.setattr(node, '_replica_path', lambda _: 'unused')
+    monkeypatch.setattr(node, '_unimported_pinned', lambda *a: {'review-card'})
+    monkeypatch.setattr(node, 'registry', lambda: dict(machines={}))
+    monkeypatch.setattr(node, 'candidates', lambda *a: [card])
+    monkeypatch.setattr(dispatch, 'review_dispatch_enabled', lambda: True)
+    monkeypatch.setattr(priority, 'order_with_remote_waiters', lambda conn, rows: rows)
+    monkeypatch.setattr(node, '_skip_reason', lambda *a, **kw:
+                        ('profile_ineligible', 'missing profile') if stage == 'prefilter' else None)
+    for name in ('_quota_held', '_review_walled', '_paced'):
+        monkeypatch.setattr(node, name, lambda *a: None)
+    monkeypatch.setattr(held, 'board_hold', lambda *a: None)
+    monkeypatch.setattr(lag, 'lagging', lambda *a: [])
+    monkeypatch.setattr(admission, 'screen', lambda *a: (a[-1], {}, {}))
+    monkeypatch.setattr(admission, 'apply', lambda *a: {})
+    monkeypatch.setattr(node, 'import_cards', lambda *a: [])
+    monkeypatch.setattr(node, 'import_refusals', dict)
+    monkeypatch.setattr(held, 'remember', lambda *a: None)
+    with receipts.collect(worker='worker-a1') as capture:
+        assert node.pickup(Mock(), budget=1) == []
+    import sqlite3
+    conn = sqlite3.connect(':memory:')
+    receipts.persist(conn, capture)
+    exported = receipts.read(conn)
+    rows = exported['receipts']
+    assert len(rows) == (1 if status == 'ready' else 0), rows
+    if rows:
+        assert rows[0]['reason'] == ('profile_ineligible: missing profile' if stage == 'prefilter'
+                                     else 'other: import failed')
