From db7a16a8ec61766726388d88e5284e456e1ce007 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 04:28:26 +0000
Subject: [PATCH] fix(kanban): exclude foreign-owned boards from capacity
 health aggregation [daveey]

---
 hermes_cli/kanban_db_dispatch_stuck.py        |  2 +-
 .../test_kanban_external_drain_hold.py        | 24 +++++++++++++++++++
 tests/hermes_cli/test_kanban_host_cap.py      |  8 +++++++
 3 files changed, 33 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_db_dispatch_stuck.py b/hermes_cli/kanban_db_dispatch_stuck.py
index bbabf955774..5d265990b26 100644
--- a/hermes_cli/kanban_db_dispatch_stuck.py
+++ b/hermes_cli/kanban_db_dispatch_stuck.py
@@ -76,5 +76,5 @@ def all_at_capacity(results: Iterable[Optional[Any]]) -> bool:
 
     The "dispatcher stuck" detectors skip such ticks: ready work waiting behind ``kanban.max_in_progress``
     running workers is the cap doing its job (stale/timeout reclaim frees hung workers). [daveey]"""
-    ran = [res for res in results if res is not None and not res.skipped_locked]
+    ran = [res for res in results if res is not None and not res.skipped_locked and not res.skipped_owned]
     return bool(ran) and all(res.at_capacity for res in ran)
diff --git a/tests/gateway/test_kanban_external_drain_hold.py b/tests/gateway/test_kanban_external_drain_hold.py
index 097eb1585ca..56519e38a8e 100644
--- a/tests/gateway/test_kanban_external_drain_hold.py
+++ b/tests/gateway/test_kanban_external_drain_hold.py
@@ -120,6 +120,30 @@ class _NoSpawnDispatcher:
         return None
 
 
+def test_capacity_with_foreign_owned_board_keeps_bad_ticks_zero(home, monkeypatch, caplog):
+    from gateway import kanban_watchers as watchers
+    from hermes_cli.kanban_db import DispatchResult
+
+    calls = []
+
+    def capped_tick(self, *, suppress_spawn=False):
+        calls.append(suppress_spawn)
+        return [
+            ("default", DispatchResult(at_capacity="max_in_progress=16/16")),
+            ("dedicated", DispatchResult(skipped_owned=True)),
+        ]
+
+    monkeypatch.setattr(_NoSpawnDispatcher, "tick_once", capped_tick)
+    monkeypatch.setattr(watchers, "_KanbanDispatcher", _NoSpawnDispatcher)
+    # Even one bad tick would warn: silence proves zero, not merely below the window.
+    monkeypatch.setattr(watchers, "_HEALTH_WINDOW", 1)
+    caplog.set_level(logging.INFO, logger="gateway")
+    assert _run_ticks(monkeypatch, [False] * 10) == 10
+    assert calls == [False] * 10
+    assert _lines(caplog, STUCK) == []
+    assert not [r for r in caplog.records if r.levelno >= logging.ERROR]
+
+
 def test_external_drain_suppresses_spawns_and_never_reports_stuck(home, monkeypatch, caplog):
     """Many held ticks with a non-empty ready queue: every tick is spawn-suppressed, bad_ticks never reaches
     the stuck window, and the hold is announced once."""
diff --git a/tests/hermes_cli/test_kanban_host_cap.py b/tests/hermes_cli/test_kanban_host_cap.py
index 7a2e6c3242a..7aefc929cd2 100644
--- a/tests/hermes_cli/test_kanban_host_cap.py
+++ b/tests/hermes_cli/test_kanban_host_cap.py
@@ -408,6 +408,14 @@ def test_all_at_capacity_needs_every_ticked_board_capped():
     assert not kbd.all_at_capacity([locked]), "no board actually ticked"
 
 
+def test_all_at_capacity_ignores_boards_owned_by_another_dispatcher():
+    capped = kb.DispatchResult(at_capacity="max_in_progress=16/16")
+    owned = kb.DispatchResult(skipped_owned=True)
+    assert kbd.all_at_capacity([capped, owned])
+    assert not kbd.all_at_capacity([owned]), "no board actually ticked"
+    assert not kbd.all_at_capacity([capped, owned, kb.DispatchResult()])
+
+
 def _daemon_stderr(monkeypatch, capsys, res, ticks=8):
     import argparse
     from hermes_cli import kanban_ops
