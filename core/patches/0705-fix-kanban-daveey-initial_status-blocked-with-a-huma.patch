From d4cb0dafe142becad840b1c66e41a7168fd478df Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 09:41:26 +0000
Subject: [PATCH] fix(kanban): [daveey] initial_status=blocked with a
 human_request sets block_kind=needs_input

record_created stored the human_request and a blocked event but never
classified the card, leaving block_kind NULL (block_task is the only
classifier and creation does not call it). Creation-time asks are
decision waits (validate_human_request refuses dependency/transient/time
alongside one), so classify them needs_input in the same UPDATE and tag
the blocked event. Blocked creations without an ask stay unclassified.
---
diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index 486595f138..25e0118df5 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -1405,18 +1405,8 @@ def create_task(
                     creator_task_id=creator_task_id, tenant=tenant, workspace_kind=workspace_kind,
                     workspace_path=workspace_path, branch_name=branch_name, project_id=project_id,
                     skills=skills_list, goal_mode=goal_mode, model_override=model_override,
-                    provider_override=provider_override, created_by=created_by, requires=required,
+                    provider_override=provider_override, created_by=created_by, requires=required, human_request=human_request,
                 )
-                if task_status == "blocked":
-                    conn.execute("UPDATE tasks SET human_request = ? WHERE id = ?",
-                                 (json.dumps(human_request) if human_request else None, task_id))
-                    _append_event(
-                        conn,
-                        task_id,
-                        "blocked",
-                        {"reason": "initial_status", "status": "blocked", "actor": created_by or "user",
-                         "human_request": human_request},
-                    )
                 # ACK-edge: the originating channel hears a child BLOCK, not just the fan-in.
                 inherit_creator_origin(conn, task_id, creator_task_id, created_at=now)
                 _inherit_notify_subs(conn, task_id, parents, created_at=now)
diff --git a/hermes_cli/kanban_db_creation.py b/hermes_cli/kanban_db_creation.py
index 98b340e24f..a26b55c5e1 100644
--- a/hermes_cli/kanban_db_creation.py
+++ b/hermes_cli/kanban_db_creation.py
@@ -1,9 +1,12 @@
 """Creation lifecycle events, shared by ordinary and origin-bound tasks."""
 
 
+import json
+
+
 def record_created(conn, task_id, *, assignee, status, parents, creator_task_id,
                    tenant, workspace_kind, workspace_path, branch_name, project_id,
-                   skills, goal_mode, model_override, provider_override, created_by, requires):
+                   skills, goal_mode, model_override, provider_override, created_by, requires, human_request=None):
     from hermes_cli import kanban_db as kb
 
     kb._append_event(conn, task_id, "created", {
@@ -23,9 +26,20 @@ def record_created(conn, task_id, *, assignee, status, parents, creator_task_id,
         "provider_override": provider_override,
     })
     if status == "blocked":
-        kb._append_event(conn, task_id, "blocked", {
+        # A creation-time human ask is a decision wait: validate_human_request
+        # already refuses dependency/transient/time alongside one, and create
+        # has no kind argument. Without an ask (lint_blocked=False trackers)
+        # leave block_kind NULL rather than invent one.
+        block_kind = "needs_input" if human_request else None
+        conn.execute("UPDATE tasks SET human_request = ?, block_kind = ? WHERE id = ?",
+                     (json.dumps(human_request) if human_request else None, block_kind, task_id))
+        payload = {
             "reason": "initial_status", "status": "blocked", "actor": created_by or "user",
-        })
+            "human_request": human_request,
+        }
+        if block_kind:
+            payload["kind"] = block_kind
+        kb._append_event(conn, task_id, "blocked", payload)
     if status == "todo":
         # Match link_tasks: a card parked behind a parent needs a reason.
         gating = [p for p in parents if kb._task_status(conn, p) not in ("done", "archived")]
diff --git a/tests/hermes_cli/test_kanban_human_request.py b/tests/hermes_cli/test_kanban_human_request.py
index 77ba0dc908..0961ebe29f 100644
--- a/tests/hermes_cli/test_kanban_human_request.py
+++ b/tests/hermes_cli/test_kanban_human_request.py
@@ -44,3 +44,35 @@ def test_invalid_request_rejected_before_any_write(tmp_path):
         assert db.get_task(conn, task).status == "ready"
     finally:
         conn.close()
+
+
+def test_initial_blocked_with_request_is_classified_needs_input(tmp_path):
+    conn = connect(tmp_path / "board.db")
+    try:
+        task = db.create_task(conn, title="Deploy", assignee="worker", initial_status="blocked",
+                              human_request=REQUEST)
+        row = db.get_task(conn, task)
+        assert row.block_kind == "needs_input"
+        assert row.human_request == REQUEST
+        blocked = [e for e in db.list_events(conn, task) if e.kind == "blocked"]
+        assert len(blocked) == 1
+        assert blocked[0].payload["kind"] == "needs_input"
+        assert blocked[0].payload["reason"] == "initial_status"
+    finally:
+        conn.close()
+
+
+def test_initial_blocked_without_request_keeps_kind_unset(tmp_path):
+    conn = connect(tmp_path / "board.db")
+    try:
+        task = db.create_task(conn, title="Swarm root tracker", assignee="worker",
+                              initial_status="blocked", lint_blocked=False)
+        row = db.get_task(conn, task)
+        assert row.status == "blocked"
+        assert row.block_kind is None
+        assert row.human_request is None
+        blocked = [e for e in db.list_events(conn, task) if e.kind == "blocked"]
+        assert len(blocked) == 1
+        assert "kind" not in blocked[0].payload
+    finally:
+        conn.close()

