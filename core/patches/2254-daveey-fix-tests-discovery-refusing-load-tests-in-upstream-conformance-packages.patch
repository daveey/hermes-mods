From 207e763543c7dbde067e64404a5c2ff4b021a76f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 13:57:48 +0000
Subject: [PATCH] [daveey] fix(tests): discovery-refusing load_tests in
 upstream conformance packages

Upstream 4d7e45d983d added tests/plugins/conformance and its frozen plugin
fixture package after the fork's 89a2d4a3daf required a discovery-refusing
load_tests in every tests/ package, so the merge failed
test_every_test_package_refuses_discovery (CI run 42823459740 shard 7).
Add the same load_tests to both packages; the fixture gets it appended after
register(), as 89a2d4a3daf did for plugin_compat_legacy, so the plugin
surface it exercises is unchanged.
---
 tests/plugins/conformance/__init__.py                        | 3 +++
 .../conformance/fixtures/conformance_surface/__init__.py     | 5 +++++
 2 files changed, 8 insertions(+)

diff --git a/tests/plugins/conformance/__init__.py b/tests/plugins/conformance/__init__.py
index e69de29bb2d..7e0d9d04a34 100644
--- a/tests/plugins/conformance/__init__.py
+++ b/tests/plugins/conformance/__init__.py
@@ -0,0 +1,3 @@
+def load_tests(loader, tests, pattern):
+    """Refuse unittest discovery: it imports test modules without conftest isolation."""
+    raise RuntimeError("Use scripts/run_tests.sh; unittest discovery bypasses test isolation")
diff --git a/tests/plugins/conformance/fixtures/conformance_surface/__init__.py b/tests/plugins/conformance/fixtures/conformance_surface/__init__.py
index 6fd6dc5901c..fa60d1d6073 100644
--- a/tests/plugins/conformance/fixtures/conformance_surface/__init__.py
+++ b/tests/plugins/conformance/fixtures/conformance_surface/__init__.py
@@ -179,3 +179,8 @@ def register(ctx):
     ctx.register_delegation_provider(ConformanceDelegation())
     ctx.register_secret_source(ConformanceSecretSource())
     ctx.on_unload(_on_unload)
+
+
+def load_tests(loader, tests, pattern):
+    """Refuse unittest discovery: it imports test modules without conftest isolation."""
+    raise RuntimeError("Use scripts/run_tests.sh; unittest discovery bypasses test isolation")
-- 
2.55.0

