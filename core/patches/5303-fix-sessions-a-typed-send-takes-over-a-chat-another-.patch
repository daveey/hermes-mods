+
+  if (last !== undefined && now - last < AUTO_TAKE_OVER_COOLDOWN_MS) {
+    return false
+  }
+
+  autoTakeOverAt.set(chatId, now)
+
+  return true
+}
+
+export function resetAutoTakeOverForTests() {
+  autoTakeOverAt.clear()
+}
