From e5cd0c8517827b20570a0874ff8349487ce4ee2b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:34:17 +0000
Subject: [PATCH] [daveey] code_execution_rpc: scope _wire_bytes pair comment
 to file reads; conditional side-effect clause

Follow-up to PR #2118 review 5889953729 (card t_01a1d49d593b369f), non-blocking nits:

1. The _wire_bytes comment claimed a tool result "never holds" a high+low
   surrogate pair. That holds for surrogateescape file reads only; an MCP or
   plugin tool result could carry one. The comment now says so, and that the
   only effect is a lossless join into one astral char on the remote side.
2. The oversize-result error told every tool, read-only ones included, that
   "any change the call made stands". It now says "if the call changed
   anything, that change stands; do not repeat it to get the result".

Proof: RED (new wording asserts in
test_remote_file_rpc_bounds_a_large_non_terminal_result fail on main),
GREEN: 5 files importing the module, 76 passed.
---
 .../test_code_execution_terminal_full_output.py    |  3 +++
 tools/code_execution_rpc.py                        | 14 ++++++++------
 2 files changed, 11 insertions(+), 6 deletions(-)

diff --git a/tests/tools/test_code_execution_terminal_full_output.py b/tests/tools/test_code_execution_terminal_full_output.py
index 7954b897e6..18dc005374 100644
--- a/tests/tools/test_code_execution_terminal_full_output.py
+++ b/tests/tools/test_code_execution_terminal_full_output.py
@@ -184,6 +184,9 @@ def test_remote_file_rpc_bounds_a_large_non_terminal_result(monkeypatch):
     # The tool already ran: the error must not read as a failed call to retry.
     assert "read_file ran" in r["error"] and "only its result was dropped" in r["error"]
     assert "do not repeat" in r["error"]
+    # Read-only tools change nothing, so the side-effect clause is conditional, not asserted.
+    assert "if the call changed anything, that change stands" in r["error"]
+    assert "any change the call made stands" not in r["error"]
     assert shipped < 2 * 1024 * 1024
     assert log[-1]["tool"] == "read_file" and "limit" in log[-1]["error"]
     # A result within the cap ships unchanged.
diff --git a/tools/code_execution_rpc.py b/tools/code_execution_rpc.py
index 2eda30ea1d..4f336beff4 100644
--- a/tools/code_execution_rpc.py
+++ b/tools/code_execution_rpc.py
@@ -66,9 +66,10 @@ def _wire_bytes(text: str) -> bytes:
     ``\\uXXXX`` escape, which inside a JSON string (where ``json.dumps`` puts every one)
     decodes back to the same text. Only for RPC results: a shipped file (script, env file)
     stays strict, since there the escape would be literal text."""
-    # Exact for lone surrogates only: a high+low pair held as two code points would ship as
-    # two escapes that json.loads joins into one astral char. surrogateescape yields only
-    # low surrogates (U+DC80..U+DCFF), so a tool result never holds such a pair.
+    # Exact for lone surrogates only: a high+low pair held as two code points ships as two
+    # escapes that json.loads joins into one astral char. A file read never holds such a
+    # pair (surrogateescape yields only low surrogates, U+DC80..U+DCFF), but an MCP or
+    # plugin tool result could; the only effect is that lossless join on the remote side.
     return text.encode("utf-8", "backslashreplace")
 
 
@@ -144,9 +145,10 @@ def _handle_rpc_request(request: dict, *, allowed_tools: frozenset, tool_call_co
             result = tool_error(
                 f"{tool_name} ran, but its result is {size:,} bytes, over the "
                 f"{full_output_cap:,}-byte limit of this remote sandbox's tool transport, so "
-                "only its result was dropped: any change the call made stands, do not repeat it "
-                "to get the result. To read data, ask for less (read_file offset/limit, a "
-                "narrower search_files pattern or limit, a shorter web_extract char_limit)",
+                "only its result was dropped: if the call changed anything, that change stands; "
+                "do not repeat it to get the result. To read data, ask for less (read_file "
+                "offset/limit, a narrower search_files pattern or limit, a shorter web_extract "
+                "char_limit)",
                 result_bytes=size, limit_bytes=full_output_cap)
     entry = {"tool": tool_name, "args_preview": str(tool_args)[:80],
              "duration": round(time.monotonic() - call_start, 2)}
-- 
