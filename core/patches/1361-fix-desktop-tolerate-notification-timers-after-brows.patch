From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 00:24:45 +0000
Subject: [PATCH] fix(desktop): tolerate notification timers after browser
 teardown [daveey]

---
 .../capabilities/plugins/plugins-tab.test.tsx |  8 ++-
 .../src/store/layout-focus-timer.test.ts      | 36 +++++++++++++
 apps/desktop/src/store/layout.ts              |  6 ++-
 .../src/store/notifications-timers.test.ts    | 51 +++++++++++++++++++
 apps/desktop/src/store/notifications.ts       |  8 +++
 5 files changed, 106 insertions(+), 3 deletions(-)
 create mode 100644 apps/desktop/src/store/layout-focus-timer.test.ts
 create mode 100644 apps/desktop/src/store/notifications-timers.test.ts

diff --git a/apps/desktop/src/app/capabilities/plugins/plugins-tab.test.tsx b/apps/desktop/src/app/capabilities/plugins/plugins-tab.test.tsx
index 120411f01b0..74efd4169c3 100644
--- a/apps/desktop/src/app/capabilities/plugins/plugins-tab.test.tsx
+++ b/apps/desktop/src/app/capabilities/plugins/plugins-tab.test.tsx
@@ -8,7 +8,7 @@ import { $pluginDecisions, $pluginRecords, dropPlugin, patchPlugin, publishPlugi
 import { queryClient } from '@/lib/query-client'
 import { $agentPlugins, $agentPluginsStatus } from '@/store/agent-plugins'
 import { $confirmRequest, settleConfirm } from '@/store/confirm'
-import { $notifications } from '@/store/notifications'
+import { $notifications, dismissNotification } from '@/store/notifications'
 import { $pluginInstallRequest, closePluginInstallRequest } from '@/store/plugin-install-request'
 import { $connection, $gatewayState } from '@/store/session'
 
@@ -117,6 +117,11 @@ afterEach(() => {
   settleConfirm(false)
   $connection.set(null)
   queryClient.clear()
+
+  for (const { id } of $notifications.get()) {
+    dismissNotification(id)
+  }
+
   vi.unstubAllGlobals()
 })
 
@@ -563,7 +568,6 @@ describe('PluginsTab', () => {
 
     beforeEach(() => {
       $pluginDecisions.set({})
-      $notifications.set([])
       window.localStorage.clear()
     })
 
diff --git a/apps/desktop/src/store/layout-focus-timer.test.ts b/apps/desktop/src/store/layout-focus-timer.test.ts
new file mode 100644
index 00000000000..d736e852176
--- /dev/null
+++ b/apps/desktop/src/store/layout-focus-timer.test.ts
@@ -0,0 +1,36 @@
+import { afterEach, expect, test, vi } from 'vitest'
+
+import { requestSessionSearchFocus, SESSION_SEARCH_FOCUS_EVENT } from './layout'
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+  vi.restoreAllMocks()
+})
+
+test('queued session-search focus tolerates browser teardown', () => {
+  let focus!: () => void
+  vi.spyOn(window, 'setTimeout').mockImplementation(callback => {
+    focus = callback as () => void
+
+    return 1 as unknown as ReturnType<typeof window.setTimeout>
+  })
+  requestSessionSearchFocus()
+  vi.stubGlobal('window', undefined)
+
+  expect(() => focus()).not.toThrow()
+})
+
+test('queued session-search focus still dispatches in a live browser', () => {
+  vi.useFakeTimers()
+  const listener = vi.fn()
+  window.addEventListener(SESSION_SEARCH_FOCUS_EVENT, listener)
+
+  try {
+    requestSessionSearchFocus()
+    vi.runOnlyPendingTimers()
+    expect(listener).toHaveBeenCalledTimes(1)
+  } finally {
+    window.removeEventListener(SESSION_SEARCH_FOCUS_EVENT, listener)
+    vi.useRealTimers()
+  }
+})
diff --git a/apps/desktop/src/store/layout.ts b/apps/desktop/src/store/layout.ts
index d7a31e9a7c2..679125753c1 100644
--- a/apps/desktop/src/store/layout.ts
+++ b/apps/desktop/src/store/layout.ts
@@ -824,7 +824,11 @@ export function requestSessionSearchFocus() {
   setSidebarOpen(true)
 
   if (typeof window !== 'undefined') {
-    window.setTimeout(() => window.dispatchEvent(new CustomEvent(SESSION_SEARCH_FOCUS_EVENT)), 0)
+    window.setTimeout(() => {
+      if (typeof window !== 'undefined') {
+        window.dispatchEvent(new CustomEvent(SESSION_SEARCH_FOCUS_EVENT))
+      }
+    }, 0)
   }
 }
 
diff --git a/apps/desktop/src/store/notifications-timers.test.ts b/apps/desktop/src/store/notifications-timers.test.ts
new file mode 100644
index 00000000000..fbe8b8dea4d
--- /dev/null
+++ b/apps/desktop/src/store/notifications-timers.test.ts
@@ -0,0 +1,51 @@
+import { afterEach, expect, test, vi } from 'vitest'
+
+import { $notifications, clearNotifications, dismissNotification, notify } from './notifications'
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+  vi.restoreAllMocks()
+  clearNotifications()
+  vi.useRealTimers()
+})
+
+test('auto-dismiss is harmless after the browser environment is torn down', () => {
+  let dismiss!: () => void
+  vi.spyOn(window, 'setTimeout').mockImplementation(callback => {
+    dismiss = callback as () => void
+
+    return 1 as unknown as ReturnType<typeof window.setTimeout>
+  })
+  const onDismiss = vi.fn()
+  notify({ message: 'Plugin enabled', onDismiss })
+  vi.stubGlobal('window', undefined)
+
+  expect(() => dismiss()).not.toThrow()
+  expect(onDismiss).not.toHaveBeenCalled()
+})
+
+test('auto-dismiss still removes a live toast and calls its callback once', () => {
+  vi.useFakeTimers()
+  const onDismiss = vi.fn()
+  const id = notify({ message: 'Plugin enabled', onDismiss })
+
+  vi.advanceTimersByTime(5_000)
+
+  expect($notifications.get().find(item => item.id === id)).toBeUndefined()
+  expect(onDismiss).toHaveBeenCalledTimes(1)
+  expect(vi.getTimerCount()).toBe(0)
+})
+
+test('reset and explicit dismissal cancel pending auto-dismiss callbacks', () => {
+  vi.useFakeTimers()
+  const onDismiss = vi.fn()
+  const id = notify({ message: 'Plugin enabled', onDismiss })
+  dismissNotification(id)
+  notify({ message: 'Plugin disabled', onDismiss })
+  clearNotifications()
+
+  expect(vi.getTimerCount()).toBe(0)
+  vi.advanceTimersByTime(5_000)
+  expect(onDismiss).toHaveBeenCalledTimes(2)
+  expect($notifications.get()).toEqual([])
+})
diff --git a/apps/desktop/src/store/notifications.ts b/apps/desktop/src/store/notifications.ts
index b27405f8a5a..0d9e4b18d1d 100644
--- a/apps/desktop/src/store/notifications.ts
+++ b/apps/desktop/src/store/notifications.ts
@@ -390,6 +390,14 @@ export function notifyError(
 }
 
 export function dismissNotification(id: string) {
+  // A queued auto-dismiss may outlive the renderer environment (e.g. jsdom teardown).
+  // Do not run consumer callbacks against a browser that no longer exists.
+  if (typeof window === 'undefined') {
+    timers.delete(id)
+
+    return
+  }
+
   window.clearTimeout(timers.get(id))
   timers.delete(id)
   const dismissed = $notifications.get().find(item => item.id === id)
-- 
