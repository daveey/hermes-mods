From f81b2d108b6c524e675cee381e9ca3eb184deb87 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:13:07 +0000
Subject: [PATCH] [daveey] kanban dup-detector: "not as duplicate of t_X"
 denies again (PR #2535 review 5896481270)

#2535 (17f28630e4) taught the detector that a not/never negating another verb before "as" is no denial
("Never started as duplicate of t_X" counts). Its _NOT_NOUN refuses a leading joining word and the _JUDGED
branch needs a verb, so a bare not/never right before "as" lost its denial: "Closed, not as duplicate of t_X"
and "Not as duplicate of t_X" returned [] on 70f920be3f but ['t_X'] after #2535, over-counting the detector.

Fix: the judging verb in the not/never branch is optional, so `not|never` + `as\s+(?:(?:an?|the)\s+)?`
directly before the keyword denies again. A word between not/never and "as" that is not a judging verb still
breaks the denial, so "Never started as duplicate", "Not run as duplicate" and "no work because duplicate"
still count, and "Not marked as (a) duplicate" stays a denial.

Proof (worker-1, hermes-core-wt test):
- RED (test only, old detector): 3 failed, the three new denial cases.
- GREEN: test_kanban_dup_detector.py + test_kanban_dup_detector_repeat.py 40 passed, 0 failed;
  tests/tools/test_kanban_create_overlap_same_creator.py (replay fixture) 49 passed.

Card: t_01a1d648ec1bfa35
---
 hermes_cli/kanban_dup_detector.py            | 5 +++--
 tests/hermes_cli/test_kanban_dup_detector.py | 4 ++++
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_dup_detector.py b/hermes_cli/kanban_dup_detector.py
index bee86c53fc..9a99caacea 100644
--- a/hermes_cli/kanban_dup_detector.py
+++ b/hermes_cli/kanban_dup_detector.py
@@ -35,14 +35,15 @@ _AFTER = re.compile(rf"[^.\n]{{0,120}}?\b({_CARD})\b")
 # no denial, and a window holding a joining word ("as", "with", "because", ...) negates another word, not the
 # keyword ("no changes as duplicate of t_X", "Never started as duplicate of t_X", "no work because duplicate of
 # t_X") (PR #2429 reviews, PR #2481 review 5896093750). After not/never, a judging verb before "as" still denies
-# ("Not marked as a duplicate of t_X"). An earlier clause ("No code changes; duplicate of t_X") does not deny it.
+# ("Not marked as a duplicate of t_X"), and so does "as" right after it ("Closed, not as duplicate of t_X") (PR
+# #2535 review 5896481270). An earlier clause ("No code changes; duplicate of t_X") does not deny it.
 _WORD = r"[\w'\u2019]+\s+"
 _JOIN = r"(?:as|with|because|since|so|but|due|hence|thus)"
 _NOT_NOUN = rf"(?:(?!{_JOIN}\b){_WORD})"
 _JUDGED = (r"(?:marked|considered|flagged|treated|closed|counted|filed|labell?ed|tagged|reported|listed|deemed|"
            r"regarded|classified|recorded|identified|confirmed|resolved|seen)")
 _NEGATED = re.compile(rf"(?:\b(?:not|never|\w+n['\u2019]t)\s+(?:{_NOT_NOUN}{{0,2}}"
-                      rf"|{_NOT_NOUN}?{_JUDGED}\s+(?:as\s+)?(?:(?:an?|the)\s+)?)"
+                      rf"|(?:{_NOT_NOUN}?{_JUDGED}\s+)?(?:as\s+)?(?:(?:an?|the)\s+)?)"
                       rf"|(?:\b(?:no|zero)|(?<![\w.])0)\s+{_NOT_NOUN}{{0,2}}"
                       r"|\bnon[\s-]+)$", re.IGNORECASE)
 # "Checked for duplicates: none", "Duplicates found: 0": a count of none right after the keyword that ends the
diff --git a/tests/hermes_cli/test_kanban_dup_detector.py b/tests/hermes_cli/test_kanban_dup_detector.py
index 6c92c66c10..e7f67ccb88 100644
--- a/tests/hermes_cli/test_kanban_dup_detector.py
+++ b/tests/hermes_cli/test_kanban_dup_detector.py
@@ -137,6 +137,10 @@ def test_a_negator_that_does_not_govern_the_keyword_does_not_deny_it(summary):
     "Not closed as a duplicate of t_0123456789abcdef.",
     "Not being a duplicate of t_0123456789abcdef, it stays open.",
     "Checked for duplicates: none found, parent t_0123456789abcdef.",
+    # PR #2535 review 5896481270: not/never right before "as" denies, as it did before #2535.
+    "Closed, not as duplicate of t_0123456789abcdef.",
+    "Not as duplicate of t_0123456789abcdef.",
+    "Never as a duplicate of t_0123456789abcdef.",
 ])
 def test_a_negator_two_words_before_the_keyword_still_denies_it(summary):
     """PR #2481 review: a hedge or adjective between the negator and the keyword keeps the denial."""
