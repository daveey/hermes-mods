From 8b0b242940d57a996a67d93f2ece267066641bbb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 16:16:43 +0000
Subject: [PATCH] [daveey] kanban CI progress: pool-scan fake honours per_page;
 pin the in-progress run-list page size

The fake `_scan_api` returned every in-progress run whatever `per_page` asked,
so the mutant `("in_progress", 10, IN_PROGRESS_RUNS_MAX)` (the pre-#2321 page
size) passed all 70 tests of test_kanban_ci_progress.py. With per_page=10 the
scan reads only the first 10 in-progress runs: the false `not_starting`
(runners-offline wake) #2321 fixed. Live 2026-11-13 15:54Z: 24 in-progress runs,
the running hermes-state pool job sat in run index 23.

Test-only change: `_scan_api` now returns at most `per_page` runs (GitHub's
default 30 when absent), and test_scan_lists_more_than_ten_in_progress_runs
lists 23 in-progress runs with the match in run 921.

RED (production mutated to per_page=10):
  FAILED tests/hermes_cli/test_kanban_ci_progress.py::test_scan_lists_more_than_ten_in_progress_runs
  AssertionError: Progress(state='not_starting', ...)
  1 failed, 70 passed
GREEN (main): 71 passed, 0 failed, 0 skipped.

Card: t_01a1d5ad1e637681 (gap from post-merge check t_01a1d59496e180a0 on #2321).
---
 tests/hermes_cli/test_kanban_ci_progress.py | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_ci_progress.py b/tests/hermes_cli/test_kanban_ci_progress.py
index 97bee81a13..f7ea6f6cbe 100644
--- a/tests/hermes_cli/test_kanban_ci_progress.py
+++ b/tests/hermes_cli/test_kanban_ci_progress.py
@@ -13,6 +13,7 @@ import stat
 import sqlite3
 import threading
 import time
+import urllib.parse
 from concurrent.futures import Future
 from pathlib import Path
 
@@ -1228,12 +1229,15 @@ def test_unreadable_run_list_is_not_remembered(kanban_home, monkeypatch) -> None
 
 
 def _scan_api(monkeypatch, runs: int, jobs_for) -> None:
-    """Fake ``_gh_api`` for a repo scan: ``runs`` in-progress runs (ids 900..), each run's jobs from ``jobs_for``."""
+    """Fake ``_gh_api`` for a repo scan: ``runs`` in-progress runs (ids 900..), each run's jobs from ``jobs_for``.
+    Like GitHub, a run list returns at most ``per_page`` runs (default 30)."""
     def api(path: str) -> dict:
         if "actions/runs?" in path:
             if "status=completed" in path:
                 return {"workflow_runs": []}
-            return {"workflow_runs": [{"id": 900 + i, "status": "in_progress"} for i in range(runs)]}
+            query = urllib.parse.parse_qs(path.split("?", 1)[1])
+            per_page = int(query.get("per_page", ["30"])[0])
+            return {"workflow_runs": [{"id": 900 + i, "status": "in_progress"} for i in range(min(runs, per_page))]}
         return {"jobs": jobs_for(int(path.split("/runs/", 1)[1].split("/", 1)[0]))}
 
     monkeypatch.setattr(kcp, "_gh_api", api)
@@ -1256,6 +1260,17 @@ def test_job_lists_of_a_scan_are_read_concurrently(kanban_home, monkeypatch) ->
     assert p.state == kcp.BUSY and "took job 9050" in p.detail, p
 
 
+def test_scan_lists_more_than_ten_in_progress_runs(kanban_home, monkeypatch) -> None:
+    """On 2026-11-13 the run holding the one ``hermes-state`` runner sat at index 23 of 24 in-progress runs: a
+    run list read with ``per_page=10`` never sees it and answers ``not_starting`` for a busy pool."""
+    def jobs_for(run_id: int) -> list:
+        return [_taken(run_id=run_id, started_age=60, status="in_progress")] if run_id == 921 else []
+
+    _scan_api(monkeypatch, 23, jobs_for)
+    p = kcp.ci_run_progress(RUN_URL, fetch=lambda *_: _QUEUED, fetch_runners=lambda _r: None)
+    assert p.state == kcp.BUSY and "took job 9210" in p.detail, p
+
+
 @pytest.mark.parametrize("match,state", [(True, kcp.BUSY), (False, kcp.NOT_STARTING)], ids=["match", "no-match"])
 def test_one_unreadable_job_list_in_a_scan(kanban_home, monkeypatch, match, state) -> None:
     """A 502 on one run's jobs does not hide a match in another; with no match the scan is not remembered."""
-- 
