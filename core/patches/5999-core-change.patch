+    with kbc.connect_closing() as conn:
+        source = stopped(conn)
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET body=? WHERE id=?", ("Fix the frozen sidebar in the Mac app.\nImplementation detail", source))
