From 969ae889b4eb6c43dbe4bc18b75ddde307b5ce24 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 16:51:34 +0000
Subject: [PATCH] [daveey] hub admission: move the separate-transaction
 admission refusal into edit_preflight (CC cap)

---
 hermes_cli/kanban.py                          |  4 ----
 hermes_cli/kanban_requires_edit.py            |  5 +++++
 tests/hermes_cli/test_kanban_hub_admission.py | 16 ++++++++++++++++
 3 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban.py b/hermes_cli/kanban.py
index 506fa90b6c..a5f6ce64b1 100644
--- a/hermes_cli/kanban.py
+++ b/hermes_cli/kanban.py
@@ -1282,10 +1282,6 @@ def _cmd_edit(args: argparse.Namespace) -> int:
     from hermes_cli.kanban_admission_class import AdmissionMetadataError
     from hermes_cli.kanban_requires_edit import edit_preflight  # --requires / --completion-contract / --reason
     admission = {name: getattr(args, name, None) for name in ("admission_class", "admission_frees")}
-    if any(value is not None for value in admission.values()):
-        for flag in ("completion_contract", "requires"):
-            if getattr(args, flag, None) is not None:
-                return _err(f"kanban edit: admission metadata cannot be combined with --{flag.replace('_', '-')}", 2)
     if (rc := edit_preflight(args)) is not None:
         return rc
     reason = getattr(args, "reason", None)
diff --git a/hermes_cli/kanban_requires_edit.py b/hermes_cli/kanban_requires_edit.py
index 5b09e14128..67f317bbae 100644
--- a/hermes_cli/kanban_requires_edit.py
+++ b/hermes_cli/kanban_requires_edit.py
@@ -41,6 +41,11 @@ def edit_preflight(args):
     from hermes_cli import kanban_contract_cli
     from hermes_cli.kanban import _err
 
+    if getattr(args, "admission_class", None) is not None or getattr(args, "admission_frees", None) is not None:
+        # [daveey] these flags edit in their own transaction and would silently drop admission metadata
+        for flag in ("completion_contract", "requires"):
+            if getattr(args, flag, None) is not None:
+                return _err(f"kanban edit: admission metadata cannot be combined with --{flag.replace('_', '-')}", 2)
     if getattr(args, "requires", None) is not None:
         return cmd_edit_requires(args)
     if getattr(args, "completion_contract", None) is not None:
diff --git a/tests/hermes_cli/test_kanban_hub_admission.py b/tests/hermes_cli/test_kanban_hub_admission.py
index 1ee4a49077..38adcc79be 100644
--- a/tests/hermes_cli/test_kanban_hub_admission.py
+++ b/tests/hermes_cli/test_kanban_hub_admission.py
@@ -735,6 +735,22 @@ def test_cli_admission_refuses_separate_transaction_edits(board, monkeypatch, ca
     assert tuple(conn.execute("SELECT * FROM tasks WHERE id=?", (task_id,)).fetchone()) == before
 
 
+def test_cli_frees_alone_refuses_requires_edit(board, monkeypatch, capsys):
+    import argparse
+    from hermes_cli import kanban as cli
+
+    conn, home = board
+    monkeypatch.setenv("HERMES_KANBAN_DB", str(home / "kanban.db"))
+    task_id = kb.create_task(conn, title="Unchanged")
+    before = tuple(conn.execute("SELECT * FROM tasks WHERE id=?", (task_id,)).fetchone())
+    parser = argparse.ArgumentParser()
+    cli.build_parser(parser.add_subparsers())
+    args = parser.parse_args(["kanban", "edit", task_id, "--frees", "frees: worker slots", "--requires", "terminal"])
+    assert cli._cmd_edit(args) == 2
+    assert "admission metadata cannot be combined with --requires" in capsys.readouterr().err
+    assert tuple(conn.execute("SELECT * FROM tasks WHERE id=?", (task_id,)).fetchone()) == before
+
+
 @pytest.mark.parametrize("changes,reason", [
     ({"admission_class": "capacity"}, "capacity requires a one-line frees: claim"),
     ({"admission_class": "unknown"}, "admission_class must be normal, capacity or urgent"),
-- 
2.51.0

