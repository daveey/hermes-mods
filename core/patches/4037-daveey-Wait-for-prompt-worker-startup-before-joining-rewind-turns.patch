From 4e8245f6bf1c4a894d865908020ee41a27070d13 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 00:31:46 +0000
Subject: [PATCH] [daveey] Wait for prompt worker startup before joining rewind
 turns

Fix published-before-start handle race without extending deadlines or retries. Proof: held-start regression fails on baseline; start-event synchronization passes it and never-started control. Six selected tests pass under 159 owned-tree SIGSTOP/SIGCONT cycles; full files pass 640 tests without retries.
---
 tests/tui_gateway/test_prompt_turn_join.py   | 46 ++++++++++++++++++++
 tests/tui_gateway/test_tui_gateway_server.py |  8 ++--
 2 files changed, 50 insertions(+), 4 deletions(-)
 create mode 100644 tests/tui_gateway/test_prompt_turn_join.py

diff --git a/tests/tui_gateway/test_prompt_turn_join.py b/tests/tui_gateway/test_prompt_turn_join.py
new file mode 100644
index 0000000000..78cf97f36f
--- /dev/null
+++ b/tests/tui_gateway/test_prompt_turn_join.py
@@ -0,0 +1,46 @@
+"""Exercise the real-thread handoff used by the consecutive rewind fixture."""
+
+import threading
+
+import pytest
+
+from tests.tui_gateway.test_tui_gateway_server import _join_turn_thread
+
+
+def test_join_waits_for_published_worker_start(monkeypatch):
+    worker = threading.Thread(target=lambda: None)
+    sess = {"_run_thread": worker}
+    observed = threading.Event()
+    original_wait = worker._started.wait
+
+    def observe_wait(timeout=None):
+        observed.set()
+        return original_wait(timeout)
+
+    monkeypatch.setattr(worker._started, "wait", observe_wait)
+    errors = []
+
+    def join():
+        try:
+            _join_turn_thread(sess)
+        except (AssertionError, RuntimeError) as exc:
+            errors.append(exc)
+        finally:
+            observed.set()
+
+    waiter = threading.Thread(target=join)
+    waiter.start()
+    try:
+        assert observed.wait(10), "joiner never observed the published worker"
+        assert not errors, errors
+    finally:
+        worker.start()
+        worker.join(10)
+        waiter.join(10)
+    assert not waiter.is_alive()
+    assert not errors, errors
+
+
+def test_join_rejects_worker_that_never_starts():
+    with pytest.raises(AssertionError, match="did not start"):
+        _join_turn_thread({"_run_thread": threading.Thread()}, timeout=0)
diff --git a/tests/tui_gateway/test_tui_gateway_server.py b/tests/tui_gateway/test_tui_gateway_server.py
index 9c922c754a..f2f342b2dc 100644
--- a/tests/tui_gateway/test_tui_gateway_server.py
+++ b/tests/tui_gateway/test_tui_gateway_server.py
@@ -21725,12 +21725,12 @@ def test_prompt_submit_row_id_db_fallback_ordinal_mapping_verifies_content(
 
 
 def _join_turn_thread(sess, timeout=10.0):
-    """Join the real turn ``prompt.submit`` started, so nothing it does races the
-    assertions or leaks into the next test. The submit's dispatch thread hands off to a
-    ``prompt-turn-*`` worker that replaces ``_run_thread``: follow the handle until it
-    stops changing."""
+    """Follow dispatch-to-turn handoffs through start and completion."""
     deadline = time.monotonic() + timeout
     while isinstance(run_thread := sess.get("_run_thread"), threading.Thread):
+        # Handoff publishes the handle before start(); join rejects that window.
+        assert run_thread._started.wait(max(0.0, deadline - time.monotonic())), \
+            "prompt.submit turn thread did not start"
         run_thread.join(timeout=max(0.0, deadline - time.monotonic()))
         assert not run_thread.is_alive(), "prompt.submit turn thread did not finish"
         if sess.get("_run_thread") is run_thread:
