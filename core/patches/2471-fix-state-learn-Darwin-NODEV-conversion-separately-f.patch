From 4c3c01a0f773a2d9b328dc24550272628dd95681 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 21:58:22 -0800
Subject: [PATCH] fix(state): learn Darwin NODEV conversion separately from
 real devices [daveey]

CPython 3.14 _PyLong_FromDev keeps NODEV (-1, AF_UNIX sockets) signed while
converting other negative dev_t to uint64. Learning from a socket first on a
positive-devfs host (mini) taught 'signed' and broke later identities.
Separate learn cells; test covers NODEV-first on both conversions.
---
 hermes_state_lockguard_darwin.py              | 20 +++++++++++--------
 .../test_lockguard_darwin_safety.py           | 18 +++++++++++++++++
 2 files changed, 30 insertions(+), 8 deletions(-)

diff --git a/hermes_state_lockguard_darwin.py b/hermes_state_lockguard_darwin.py
index 3022b0327c..e9faa53461 100644
--- a/hermes_state_lockguard_darwin.py
+++ b/hermes_state_lockguard_darwin.py
@@ -31,11 +31,14 @@ def build():
 
     mask = (1 << 64) - 1
     # CPython builds differ in how a negative int32 dev_t becomes st_dev
-    # (signed vs uint64). None = not yet proven on this interpreter.
-    unsigned_dev = [None]
+    # (signed vs uint64), and 3.14 keeps NODEV (-1, e.g. AF_UNIX sockets)
+    # signed even when it converts other devices to uint64. So NODEV and
+    # ordinary negative devices are learned separately: [ordinary, nodev].
+    # None = not yet proven on this interpreter.
+    unsigned_dev = [None, None]
 
-    def learn(fd, dev, ino):
-        # Until a negative device has been observed, ask Python itself (one
+    def learn(fd, dev, ino, kind):
+        # Until a device of this kind has been observed, ask Python itself (one
         # GIL-releasing fstat) and learn its conversion only from a consistent
         # answer. Python's own st_dev is always the authoritative identity.
         try:
@@ -43,7 +46,7 @@ def build():
         except OSError:
             return None
         if st.st_ino == ino and st.st_dev in (dev, dev & mask):
-            unsigned_dev[0] = st.st_dev != dev
+            unsigned_dev[kind] = st.st_dev != dev
         return st.st_dev, st.st_ino
 
     def raw(fd):
@@ -61,9 +64,10 @@ def build():
         dev, ino = got
         if dev >= 0:
             return dev, ino
-        if unsigned_dev[0] is None:
-            return learn(fd, dev, ino)
-        return (dev & mask if unsigned_dev[0] else dev), ino
+        kind = 1 if dev == -1 else 0
+        if unsigned_dev[kind] is None:
+            return learn(fd, dev, ino, kind)
+        return (dev & mask if unsigned_dev[kind] else dev), ino
 
     def descriptors():
         buf = ctypes.create_string_buffer(MAX_FDS * 8)
diff --git a/tests/hermes_state/test_lockguard_darwin_safety.py b/tests/hermes_state/test_lockguard_darwin_safety.py
index b287c5228e..038ed668c4 100644
--- a/tests/hermes_state/test_lockguard_darwin_safety.py
+++ b/tests/hermes_state/test_lockguard_darwin_safety.py
@@ -92,6 +92,24 @@ def test_unlearned_negative_device_defers_to_python(abi, monkeypatch):
     assert native(42) == (-8, 123)
 
 
+@pytest.mark.parametrize("nodev_py", [-1, (1 << 64) - 1])
+@pytest.mark.parametrize("unsigned", [False, True])
+def test_nodev_never_teaches_real_device_conversion(abi, nodev_py, unsigned):
+    # CPython 3.14 keeps NODEV (-1, e.g. AF_UNIX sockets) signed even where it
+    # converts other negative dev_t to uint64: NODEV must not poison learning.
+    abi.dev = abi.stat_dev = 7
+    native, _descriptors = darwin.build()
+    abi.dev, abi.stat_dev = -1, nodev_py
+    assert native(42) == (nodev_py, 123)
+    abi.dev = -7
+    abi.stat_dev = ((1 << 64) - 7) if unsigned else -7
+    assert native(42) == (abi.stat_dev, 123)
+    abi.stat_dev = 12345  # both conversions learned: no further Python handoff
+    assert native(42) == ((((1 << 64) - 7) if unsigned else -7), 123)
+    abi.dev = -1
+    assert native(42) == (nodev_py, 123)
+
+
 def test_runtime_fstat_failure_before_learning_reports_closed(abi, monkeypatch):
     abi.dev = abi.stat_dev = 7
     native, _descriptors = darwin.build()
-- 
