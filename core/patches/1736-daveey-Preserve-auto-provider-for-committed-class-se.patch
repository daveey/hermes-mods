From 9cfbff688a8546eba1f0cbb1aa4eab51e2620050 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 19:13:32 +0000
Subject: [PATCH] [daveey] Preserve auto provider for committed class
 selections

---
 agent/model_routing_agent.py                  |  6 ++++-
 gateway/session_mutation_model.py             |  4 ++++
 .../test_model_switch_worker_composed.py      | 22 +++++++++++++++++++
 3 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/agent/model_routing_agent.py b/agent/model_routing_agent.py
index 26e189ff717..4575f04945e 100644
--- a/agent/model_routing_agent.py
+++ b/agent/model_routing_agent.py
@@ -40,7 +40,11 @@ def prepare_agent_route(agent, model, provider, session_id, api_key, base_url,
     from agent.model_routing_switch_intent import consume, pending
     intent = pending(session_db, session_id, model, provider)
     requested = provider or "auto"
-    if intent is not None and requested == "auto":
+    if intent is not None and is_class_selector(model):
+        # Canonical class picks inherit the prior provider in their stored policy;
+        # that is not an exact-provider pin for the class allocator.
+        requested = "auto"
+    if intent is not None and requested == "auto" and not is_class_selector(model):
         # An ``auto`` build honouring a switch must land on the provider the switch committed, never a
         # sibling route serving the same model name; a provider that cannot serve it refuses below.
         import json
diff --git a/gateway/session_mutation_model.py b/gateway/session_mutation_model.py
index 62520731eb6..b148229d851 100644
--- a/gateway/session_mutation_model.py
+++ b/gateway/session_mutation_model.py
@@ -106,6 +106,10 @@ async def prepare_model(authority, live, payload, prepared):
     # and the endpoint-bound credential fields (inline key, key_env/api_key_env) drop on a route change.
     # Off-loop: the context-pin check can do cold-start disk I/O.
     frozen['model'] = await asyncio.to_thread(apply_model_selection, frozen.get('model'), result)
+    from agent.model_routing import is_class_selector
+    if is_class_selector(result.new_model):
+        # A class is not pinned to the provider of the route being left.
+        frozen['model']['provider'] = 'auto'
     if 'reasoning' in payload:
         # The level picked with the model lands in the same commit (as prepare_reasoning writes it).
         from gateway.session_policy import pin_reasoning_effort
diff --git a/tests/gateway/test_model_switch_worker_composed.py b/tests/gateway/test_model_switch_worker_composed.py
index 17e76dbebd8..b40d705545a 100644
--- a/tests/gateway/test_model_switch_worker_composed.py
+++ b/tests/gateway/test_model_switch_worker_composed.py
@@ -218,6 +218,28 @@ async def test_committed_switch_reaches_the_next_managed_worker(home, monkeypatc
         store.close_all_db_handles()
 
 
+@pytest.mark.asyncio
+async def test_class_switch_releases_exact_pin_and_rebuilds(home, monkeypatch):
+    store, db, authority, owner, ref = _owner(home, monkeypatch, _noop)
+    try:
+        _pinned_opus(home, authority, db, ref, monkeypatch)
+        reply = await _mutate(owner, db, ref, 'class-pick', {'model': 'class:deep'})
+        assert reply['result']['model'] == 'class:deep', reply
+        assert _intent(db, ref) is not None
+        agent = _worker_build(authority, db, ref, monkeypatch, 'w-class')
+        recorded = _allocation(home, ref.session_id)
+        assert recorded is not None
+        assert not recorded.get('exact_pin', False)
+        assert recorded['reason'] == 'explicit-switch'
+        assert recorded['selected_model'] == agent.model
+        assert _intent(db, ref) is None
+        again = _worker_build(authority, db, ref, monkeypatch, 'w-class-again')
+        assert (again.model, again.provider) == (agent.model, agent.provider)
+    finally:
+        await owner.close()
+        store.close_all_db_handles()
+
+
 @pytest.mark.asyncio
 async def test_rejected_switch_keeps_the_worker_on_the_original_pin(home, monkeypatch):
     store, db, authority, owner, ref = _owner(home, monkeypatch, _noop)
-- 
