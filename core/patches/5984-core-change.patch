From b231ab688db79a9ab9ea3bdfaae2be33616636f7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 21:08:48 +0000
Subject: [PATCH 5984] Kanban scratch archive: foreign ownership, retention and promisor clones

Public mirror of source commit b231ab688db79a9ab9ea3bdfaae2be33616636f7.

---
diff --git a/hermes_cli/kanban_scratch_archive_shapes.py b/hermes_cli/kanban_scratch_archive_shapes.py
index 6124451853f..5089705f3f1 100644
--- a/hermes_cli/kanban_scratch_archive_shapes.py
+++ b/hermes_cli/kanban_scratch_archive_shapes.py
@@ -9,6 +9,10 @@
   (as before) or one whose tip came from a promisor pack (``rev-list
   --exclude-promisor-objects``), such as the tags a ``blob:none`` clone fetched,
   whose bundle needed blobs that were never local (``fatal: unable to read``).
+  A commit counts only if a plain walk (no promisor exclusion) also finds it off every
+  remote-tracking ref: git 2.43 drops a promisor-pack remote tip from the ``--not`` side,
+  so an alternates clone's pushed history read as unpushed and ``bundle create`` refused
+  an empty bundle forever (worker-a2, undated representative observation).
   A remaining ref is bundled only when every object it adds is local. A ref
   that needs objects the promisor remote vouches for is recorded and left to the
   complete payload (its local objects are in ``.git``); a ref needing objects
@@ -114,12 +118,13 @@
     tips, remote, nested = _commit_tips(repo, env, git, head)
     local = _rev_list(repo, env, git, ["--exclude-promisor-objects"], sorted(set(tips.values())), remote)
     unpushed = {line[:40] for line in local.stdout.decode("ascii", "replace").split()}
-    # --exclude-promisor-objects also drops promisor remote tips from the negative side, so local commits
-    # a fetched tip already contains still list here; `bundle create ... --not --remotes` then finds nothing
-    # and refuses ("empty bundle") forever. Keep only commits the plain walk agrees are not on a remote.
+    # git 2.43 (not 2.55) drops a remote tip that is also in a promisor pack from the negative side of
+    # this walk (seen with an objects/info/alternates clone), so pushed history lists here while
+    # `bundle create ... --not --remotes` finds nothing and refuses ("empty bundle") forever. Keep only
+    # commits the plain walk also finds off every remote-tracking ref.
     if unpushed:
         plain = _rev_list(repo, env, git, [], sorted(set(tips.values())), remote, ok=(0, 128))
-        if not plain.returncode:  # a walk that cannot finish (missing commit) keeps the stricter set
+        if not plain.returncode:  # a plain walk that cannot finish keeps the promisor-walk set (bundles more)
             unpushed &= {line[:40] for line in plain.stdout.decode("ascii", "replace").split()}
     refs = [r for r, oid in tips.items() if oid in unpushed]
     for ref in nested:
diff --git a/tests/hermes_cli/test_kanban_scratch_archive_partial_clone.py b/tests/hermes_cli/test_kanban_scratch_archive_partial_clone.py
index b0e94bcb10d..27a98ef70ab 100644
--- a/tests/hermes_cli/test_kanban_scratch_archive_partial_clone.py
+++ b/tests/hermes_cli/test_kanban_scratch_archive_partial_clone.py
@@ -269,10 +269,30 @@
 
     repo = tmp_path / "w" / "repo"
     _clone(promisor, repo)
-    (repo / "mine.txt").write_text("mine\\n")
+    (repo / "mine.txt").write_text("mine\n")
     _run("add", ".", cwd=repo)
     _run("commit", "-q", "-m", "mine", cwd=repo)
     dest = tmp_path / "out"
     sa.archive_repo(repo, dest, task_id="t_x", completed_at=None)
     heads = _run("bundle", "list-heads", str(dest / "commits.bundle"), cwd=repo)
     assert _run("rev-parse", "HEAD", cwd=repo) in heads
+
+
+def test_failed_plain_walk_keeps_the_promisor_walk_set(board, promisor, tmp_path, monkeypatch):
+    """A plain walk that exits 128 (e.g. a missing commit) changes nothing: the refusal path stays as before."""
+    from hermes_cli import kanban_scratch_archive as sa
+
+    repo = tmp_path / "w" / "repo"
+    _clone(promisor, repo)
+    head = _run("rev-parse", "HEAD", cwd=repo)
+    _git_243(sa, monkeypatch, head)
+    listed = sa._git
+
+    def git(repo_, env, *args, **kwargs):
+        if args[:1] == ("rev-list",) and "--stdin" in args and "--exclude-promisor-objects" not in args \
+                and "--objects" not in args:
+            return subprocess.CompletedProcess(args, 128, b"", b"fatal: bad object")
+        return listed(repo_, env, *args, **kwargs)
+    monkeypatch.setattr(sa, "_git", git)
+    with pytest.raises(sa.ArchiveRefused, match="empty bundle"):
+        sa.archive_repo(repo, tmp_path / "out", task_id="t_x", completed_at=None)
