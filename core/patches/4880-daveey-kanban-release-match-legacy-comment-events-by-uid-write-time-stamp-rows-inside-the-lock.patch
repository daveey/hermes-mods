 hermes_cli/kanban_comment_transcript_proof.py | 10 ++-
 hermes_cli/kanban_db_comment_ids.py           |  4 +-
 hermes_cli/kanban_release_comments.py         | 29 ++++++-
 .../test_kanban_release_imported_comments.py  | 75 ++++++++++++++++++-
 .../test_kanban_release_transcript_proof.py   |  5 +-
 5 files changed, 112 insertions(+), 11 deletions(-)

diff --git a/hermes_cli/kanban_comment_transcript_proof.py b/hermes_cli/kanban_comment_transcript_proof.py
index dd0900fe1bc0d86a2a09b83f8e0c8e2b19a76142..3dbe483729ff50afadcc951e63fc6e88cdc4df6d 100644
--- a/hermes_cli/kanban_comment_transcript_proof.py
+++ b/hermes_cli/kanban_comment_transcript_proof.py
@@ -15,9 +15,11 @@ same source integer under any other tool name refuses.
 
 The retained call holds the body *before* the writer stored it, and
 ``kanban_comment`` stores ``redact_sensitive_text(body, force=True)``. So a body
-matches as written or after that same forced redaction, nothing looser: a
-legacy comment quoting an E.164 number (stored as ``+141****0134``) is otherwise
-unprovable forever and refuses every ``--seen`` release of its card.
+matches as written or after that same forced redaction: a legacy comment quoting
+an E.164 number (stored as ``+141****0134``) is otherwise unprovable forever and
+refuses every ``--seen`` release of its card. Masking is many-to-one, so a row
+with the same masked text can stand in for a missing one; it is the exact text
+the call stored, and when the true row syncs the two candidates refuse again.
 """
 from __future__ import annotations
 
@@ -134,6 +136,6 @@ def resolve(rows, event, payload, transcript, *, board=None):
         candidates = [r for r in rows if r['body'] in bodies
                       and r['author'] == author.strip()
                       and start <= r['created_at'] <= event['created_at']]
-    except (_Unprovable, ValueError, TypeError, KeyError, AttributeError, OverflowError):
+    except (_Unprovable, ValueError, TypeError, KeyError, AttributeError, OverflowError, ImportError):
         return []
     return candidates if len(candidates) == 1 else []
diff --git a/hermes_cli/kanban_db_comment_ids.py b/hermes_cli/kanban_db_comment_ids.py
index 9179be78770810703cc1d2af4531f7bd64ccc496..bf2a3634d55f2153bca99c8ebb2ec7c6ee7b81e6 100644
--- a/hermes_cli/kanban_db_comment_ids.py
+++ b/hermes_cli/kanban_db_comment_ids.py
@@ -123,13 +123,15 @@ def add_comment(conn: sqlite3.Connection, task_id: str, author: str, body: str,
         raise ValueError(f"writer_kind must be 'agent' or 'human', not {writer_kind!r}")
     from hermes_cli.kanban_comment_origin import resolve_origin
     origin = resolve_origin(author, origin_gateway)
-    now = int(time.time())
     # [daveey] A comment written from inside a worker run records that run on its
     # ``commented`` event, so the live comment bridge can skip exactly the run's own notes
     # by id. Authorship cannot: workers and the chats steering them share a profile.
     # ``allow_nested=True``: graph builders (kanban_swarm blackboard seeding)
     # compose comment writes under one outer commit.
     with _kb.write_txn(conn, allow_nested=True):
+        # Stamped after the write lock, like the event: a stamp taken before it put the row
+        # seconds ahead of its event while another writer held the lock.
+        now = int(time.time())
         _kb._require_task(conn, task_id)
         if relayed_human:  # the card holder's own checks, atomic with the write (one relay per user turn)
             from hermes_cli.kanban_relayed_human import admit
diff --git a/hermes_cli/kanban_release_comments.py b/hermes_cli/kanban_release_comments.py
index ad09e0ae2025fe1880b74c7e5a362854e130ea61..79a2376a24e9363df0d39409fffa9a5d5b6a6620 100644
--- a/hermes_cli/kanban_release_comments.py
+++ b/hermes_cli/kanban_release_comments.py
@@ -5,6 +5,7 @@ import json
 import os
 import shlex
 import time
+import uuid
 from datetime import UTC, datetime
 
 UNREAD_EXIT = 4
@@ -155,7 +156,8 @@ def _resolve(rows, event, payload, *, local_writer=False):
     Legacy synced events have no portable reference. Require acknowledgement of
     every plausible same-time/author row rather than guess among collisions.
     The timestamp tolerance covers the writer crossing a second between inserts;
-    body length cannot disambiguate because add_comment strips stored text.
+    UUIDv7 write times cover legacy rows stamped before the write lock (``_same_write``).
+    Body length cannot disambiguate because add_comment strips stored text.
     """
     if payload.get("comment_uid"):
         return [r for r in rows if "uid" in r.keys() and r["uid"] == payload["comment_uid"]]
@@ -166,10 +168,33 @@ def _resolve(rows, event, payload, *, local_writer=False):
         # the second timestamp. Local run provenance makes its integer usable.
         return [r for r in rows if r["id"] == payload.get("comment_id")
                 and r["author"] == payload["author"].strip()]
-    return [r for r in rows if abs(r["created_at"] - event["created_at"]) <= 1
+    return [r for r in rows if (abs(r["created_at"] - event["created_at"]) <= 1 or _same_write(r, event))
             and (not payload.get("author") or r["author"] == payload["author"].strip())]
 
 
+def _uuid7_ms(uid):
+    """Millisecond write time a UUIDv7 carries; None for any other value."""
+    try:
+        value = uuid.UUID(str(uid))
+    except (ValueError, TypeError, AttributeError):
+        return None
+    return value.int >> 80 if value.version == 7 else None
+
+
+def _same_write(row, event):
+    """Row and event uids minted within a second: the same tolerance as ``created_at``, on a clock that is right.
+
+    Legacy ``add_comment`` stamped the row's ``created_at`` before waiting for the
+    write lock and the event's after it, so the two integers drift by seconds
+    (5 s and 7 s seen live) while their UUIDv7 uids, minted inside the one
+    transaction, sit milliseconds apart.
+    """
+    keys = row.keys()
+    row_ms = _uuid7_ms(row["uid"]) if "uid" in keys else None
+    event_ms = _uuid7_ms(event["uid"]) if "uid" in event.keys() else None
+    return row_ms is not None and event_ms is not None and abs(row_ms - event_ms) <= 1000
+
+
 def cli_guard(args, tid, verb):
     """Build a transactional precondition using the CLI's inherited caller identity."""
     return lambda conn: check(conn, tid, session=os.environ.get("HERMES_SESSION_ID"),
