From 8b2262fd1324908e4f29f1105fcd7ffe6fea7295 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 05:53:43 +0000
Subject: [PATCH] [daveey] Scan lifecycle payloads behind expanded Bash names

Why: name-taking builtins and indirect parameters can evaluate a subscript stored in an earlier assignment. Recovery previously activated only when the sink visibly contained a bracket, so expansion-supplied names hid referenced scripts. Recognize expanded names, nameref declarations and active indirect parameters; retain plain-name and inert unset controls.

Proof: nine real-Bash marker regressions fail on base and pass with lifecycle/clean twins. Full tests/cron/test_lifecycle_guard*.py: 9055 passed in 47 files. scripts/check: 20 checks OK. Seven helper branch mutants killed. Read-only payload-helper replay: 431 unique wake commands across 26 hub board/shadow DBs, zero changed outputs.
---
 cron/lifecycle_guard_arith_words.py               | 15 ++++++++++-----
 .../cron/test_lifecycle_guard_name_indirection.py | 15 +++++++++++++++
 2 files changed, 25 insertions(+), 5 deletions(-)

diff --git a/cron/lifecycle_guard_arith_words.py b/cron/lifecycle_guard_arith_words.py
index 825fe6d51ae7daed4494171ee8e899fa441699e1..4b06b6988ac45894dcc6332bc1a39f86ac2e2281 100644
--- a/cron/lifecycle_guard_arith_words.py
+++ b/cron/lifecycle_guard_arith_words.py
@@ -59,7 +59,8 @@ def _name_taking_mode(name: str, arguments: list[str]) -> bool:
         name in {"test", "[", "printf"} and "-v" in arguments
     ) or (name == "wait" and "-p" in arguments) or (
         name in _INTEGER_DECLARERS
-        and any("[" in argument.split("=", 1)[0] for argument in arguments)
+        and (any(any(c in argument.split("=", 1)[0] for c in "[$") for argument in arguments)
+             or any(argument.startswith("-") and "n" in argument[1:] for argument in arguments))
     )
 
 
@@ -102,12 +103,16 @@ def _recursive_arithmetic_segment(segment: list[str]) -> bool:
     name = guard._executable_name(words[index])
     arguments = words[index + 1:]
     # NAME subscripts recursively evaluate variables just like explicit arithmetic.
-    # A plain NAME does not: `read x` must not activate earlier data assignments.
+    # Expansion-supplied names and nameref targets can hide the entire subscript
+    # in an earlier assignment. A plain NAME does not: `read x` stays inert.
+    # Bash unset does not re-expand a subscript supplied through a parameter.
+    expanded_name = any("[" in token or (name != "unset" and "$" in token)
+                        for token in arguments)
     return name == "let" or (
         name == "[[" and (any(token in _INT_OPERATORS for token in arguments)
-                          or ("-v" in arguments and any("[" in token for token in arguments)))
+                          or ("-v" in arguments and expanded_name))
     ) or (
-        _name_taking_mode(name, arguments) and any("[" in token for token in arguments)
+        _name_taking_mode(name, arguments) and expanded_name
     )
 
 
@@ -130,7 +135,7 @@ def _implicit_arithmetic_expansion(command: str) -> bool:
     This is only a context prefilter, not an evaluator. Preserve shell quoting so
     literal examples in printf/echo do not activate unrelated data assignments.
     """
-    tokens = re.compile(r'''\\.|'|"|\$\$|\$\[|\$\{[#!]?(?:[A-Za-z_]\w*|\d+|[@*#?$!-])(?:\[|:(?![-=?+]))''')
+    tokens = re.compile(r'''\\.|'|"|\$\$|\$\[|\$\{![A-Za-z_]\w*(?=[}:])|\$\{[#!]?(?:[A-Za-z_]\w*|\d+|[@*#?$!-])(?:\[|:(?![-=?+]))''')
     quoted = False
     pos = 0
     while match := tokens.search(command, pos):
diff --git a/tests/cron/test_lifecycle_guard_name_indirection.py b/tests/cron/test_lifecycle_guard_name_indirection.py
index e58ce1e48c9825e7ab9cf67c7fe0e0ebe06782de..856169d9d0902d87e9d873a8eb7ac0abec8bf47d 100644
--- a/tests/cron/test_lifecycle_guard_name_indirection.py
+++ b/tests/cron/test_lifecycle_guard_name_indirection.py
@@ -10,6 +10,15 @@ from tests.cron.test_lifecycle_guard_arith_escaped_words import _run_bash
 
 
 SHAPES = [
+    r'x="a[\$(SCRIPT)]"; printf -v "$x" 1',
+    r'x="a[\$(SCRIPT)]"; read "$x" <<< 1',
+    r'x="a[\$(SCRIPT)]"; test -v "$x"',
+    r'x="a[\$(SCRIPT)]"; [[ -v $x ]]',
+    r'x="a[\$(SCRIPT)]"; declare "$x=1"',
+    r'x="a[\$(SCRIPT)]"; declare -n r="$x"; echo $r',
+    r'x="a[\$(SCRIPT)]"; echo ${!x}',
+    r'x="a[\$(SCRIPT)]"; echo "${!x}"',
+    r'x="a[\$(SCRIPT)]"; echo ${!x:-d}',
     "declare 'a[$(SCRIPT)]=1'",
     r"declare a[\$\(SCRIPT\)]=1",
     "declare -a 'a[$(SCRIPT)]=1'",
@@ -157,6 +166,12 @@ def test_name_and_indirection_scripts_are_scanned(tmp_path, shape, bash_version)
     "x='a[$(SCRIPT)]'; printf -v x 1",
     "x='a[$(SCRIPT)]'; read x <<< 1",
     "x='a[$(SCRIPT)]'; unset x",
+    'x=\'a[$(SCRIPT)]\'; unset "$x"',
+    "x='a[$(SCRIPT)]'; echo '${!x}'",
+    r"x='a[$(SCRIPT)]'; echo \${!x}",
+    "x='a[$(SCRIPT)]'; echo $${!x}",
+    "x='a[$(SCRIPT)]'; echo ${!x@}",
+    "x='a[$(SCRIPT)]'; echo ${!x*}",
     "echo 'x=a[$(SCRIPT)]'; test -v 'a[x]'",
 ])
 def test_inert_name_words_stay_allowed(tmp_path, shape):
