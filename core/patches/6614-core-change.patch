From da87293a127cff5139a5df16a4c3e515c90aa53d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 26 Nov 2026 09:51:41 +0000
Subject: [PATCH 6614] Profile resource custody and retirement before deletion

Public mirror of source commit da87293a127cff5139a5df16a4c3e515c90aa53d.

---
diff --git a/hermes_cli/plugins.py b/hermes_cli/plugins.py
index 0c4804ecca3be44c88c48ed398b235164906f758..af61862f9f858a6a0201d26ef15504730d53262c 100644
--- a/hermes_cli/plugins.py
+++ b/hermes_cli/plugins.py
@@ -283,6 +283,7 @@
         self.scope_key = hermes_home_key(scope_key)
         self.home_path = Path(self.scope_key)
         self._discovery_lock = threading.RLock()
+        self._profile_resource_lock = threading.Lock()
         self._discovered: bool = False
         self._nowait_last: dict[str, frozenset[str]] = {}  # [daveey] last live *_nowait answers (_nowait_plugin_set)
         # [daveey] Inputs the last completed sweep read (``plugins_snapshot.fingerprint`` / ``precheck``,
diff --git a/hermes_cli/plugins_profile_lifecycle.py b/hermes_cli/plugins_profile_lifecycle.py
index 537ca860fff5837b45b653381cb295d75381d050..cf164595350d5e2defa35cb91b68b2b035d4bcbb 100644
--- a/hermes_cli/plugins_profile_lifecycle.py
+++ b/hermes_cli/plugins_profile_lifecycle.py
@@ -7,7 +7,8 @@
 
 
 def protect_profile_manager(manager, home: Path) -> None:
-    with manager._discovery_lock:
+    # A host callback can ask for its manager while discovery waits on that host.
+    with manager._profile_resource_lock:
         if getattr(manager, '_profile_resource_lease', None) is not None:
             manager._profile_resource_lease.assert_reopen_allowed()
             return
