Subject: [PATCH] fix(gateway): project canonical served identity in chat
 replies [daveey]

---
 gateway/platforms/api_server_openai_routes.py | 12 +++++-----
 tests/gateway/fixtures/api_authority_peer.py  |  2 ++
 tests/gateway/test_api_served_identity.py     | 22 +++++++++++++++++++
 3 files changed, 31 insertions(+), 5 deletions(-)
 create mode 100644 tests/gateway/test_api_served_identity.py

diff --git a/gateway/platforms/api_server_openai_routes.py b/gateway/platforms/api_server_openai_routes.py
index 50407d15ca7..c5a7c2066ab 100644
--- a/gateway/platforms/api_server_openai_routes.py
+++ b/gateway/platforms/api_server_openai_routes.py
@@ -780,11 +780,13 @@ def _parse_conversation_history(raw_history: Any) -> tuple:
 def _apply_served_runtime(response_data: dict, result: dict) -> None:
     """Name who served the turn: a class selector ("class:fast") is not a model, and clients (BB's
     egress log) attribute the request from this. ``model`` keeps echoing the request when unknown."""
-    served = result.get("served_runtime") if isinstance(result.get("served_runtime"), dict) else {}
-    if served.get("provider"):
-        response_data["provider"] = served["provider"]
-    if served.get("model"):
-        response_data["model"] = served["model"]
+    # Direct execution supplies served_runtime; the canonical FIFO stores the same
+    # post-turn agent identity at result top level (including on durable retries).
+    served = result.get("served_runtime") if isinstance(result.get("served_runtime"), dict) else result
+    for key in ("provider", "model"):
+        value = served.get(key)
+        if isinstance(value, str) and value.strip():
+            response_data[key] = value
 
 
 class OpenAICompatRoutesMixin:
diff --git a/tests/gateway/fixtures/api_authority_peer.py b/tests/gateway/fixtures/api_authority_peer.py
index 66cf9b7f783..4ff6695dc8e 100644
--- a/tests/gateway/fixtures/api_authority_peer.py
+++ b/tests/gateway/fixtures/api_authority_peer.py
@@ -57,6 +57,8 @@ async def probe(peer):
             async with client.post(url, json=body, headers=headers) as response:
                 data = await response.json()
                 assert response.status == 200, data
+                assert data.get('provider') == 'custom', data.get('provider')
+                assert data['model'] == 'local-wire-stub', data['model']
             authority = runner.session_authority
             ref = SessionRef('default', 'api-shared')
             assert ref.session_id in authority.sessions, 'API bypassed canonical authority'
diff --git a/tests/gateway/test_api_served_identity.py b/tests/gateway/test_api_served_identity.py
new file mode 100644
index 00000000000..8e6b9436f9a
--- /dev/null
+++ b/tests/gateway/test_api_served_identity.py
@@ -0,0 +1,22 @@
+"""Non-streaming response identity comes only from executed, string-valued metadata."""
+import pytest
+
+from gateway.platforms.api_server_openai_routes import _apply_served_runtime
+
+
+@pytest.mark.parametrize("result,expected", [
+    ({"provider": "anthropic", "model": "claude-concrete"},
+     {"provider": "anthropic", "model": "claude-concrete"}),
+    ({"provider": "openai-codex", "model": "gpt-concrete"},
+     {"provider": "openai-codex", "model": "gpt-concrete"}),
+    ({"served_runtime": {"provider": "anthropic", "model": "fallback-concrete"},
+      "provider": "openai-codex", "model": "primary-concrete"},
+     {"provider": "anthropic", "model": "fallback-concrete"}),
+    ({"final_response": "", "completed": False}, {"model": "class:fast"}),
+    ({"provider": None, "model": 42}, {"model": "class:fast"}),
+    ({"provider": "   ", "model": ""}, {"model": "class:fast"}),
+])
+def test_served_identity_projection(result, expected):
+    response = {"model": "class:fast"}
+    _apply_served_runtime(response, result)
+    assert response == expected
