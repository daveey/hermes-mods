From b41e178cb12d924a3e4fd4e25b24ccaf366e385e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 03:26:57 +0000
Subject: [PATCH] [daveey] chore(kanban-sync): drop unused decide(local_min_s),
 note deferred link repairs

Follow-up to PR #1815 review (t_01a1d2cfec4bb602):

- decide() no longer takes local_min_s: no caller passed it (production passes
  only min_s; tests monkeypatch LOCAL_WRITE_REPAIR_MIN_S). It reads the module
  constant directly.
- Rewrap the 159-char docstring line at 120.
- The LOCAL_WRITE_REPAIR_MIN_S comment now says the deferral covers the whole
  pass: repair_partition_links, repair_partition_chat_links and
  retire_lost_placeholder_links also run up to 30 s after a link written by
  another process (the remote-parent mirror is never deferred).
- New test in the copy-links suite keeps the production window (conftest pins
  it to 0 for 10 sync suites): a lost edge stays missing on the deferred round
  and is restored once the window ends.

Behaviour unchanged.
---
 hermes_cli/kanban_sync_repair_window.py       | 17 ++++++++-------
 .../hermes_cli/test_kanban_sync_copy_links.py | 21 +++++++++++++++++++
 2 files changed, 30 insertions(+), 8 deletions(-)

diff --git a/hermes_cli/kanban_sync_repair_window.py b/hermes_cli/kanban_sync_repair_window.py
index d64e2797a1..9f57ddd489 100644
--- a/hermes_cli/kanban_sync_repair_window.py
+++ b/hermes_cli/kanban_sync_repair_window.py
@@ -23,7 +23,9 @@ _REPAIR_CREDIT: dict[str, int] = {}
 # A write by another process (a worker heartbeat or claim, the dispatcher) is a repair-revision gap, and each gap
 # ran the full pass at once: hub default board 2026-11-13, 5,428 cards, 80 of 86 full passes in 601 s were
 # ``local_write`` (20% of gateway CPU samples). Such gaps now share one pass per window; an uncaptured edit is
-# found at most this long after the previous pass instead of on the next round.
+# found at most this long after the previous pass instead of on the next round. The deferral covers the whole pass,
+# so ``repair_partition_links``, ``repair_partition_chat_links`` and ``retire_lost_placeholder_links`` also run up to
+# this long after a link written by another process (the remote-parent mirror is never deferred).
 LOCAL_WRITE_REPAIR_MIN_S = 30.0
 
 
@@ -38,8 +40,7 @@ def applies_chain(start: Any, applies: Iterable[tuple], end: Any) -> bool:
     return at is not None and at == end
 
 
-def decide(key: str, inputs: Optional[tuple], applies: Optional[Iterable[tuple]], now: float, min_s: float,
-           local_min_s: Optional[float] = None) -> str:
+def decide(key: str, inputs: Optional[tuple], applies: Optional[Iterable[tuple]], now: float, min_s: float) -> str:
     """Why this round's changed repair inputs run the full pass now, or ``deferred``.
 
     ``deferred`` when the only inputs that changed since the last completed pass are the replica's feed cursor and
@@ -49,10 +50,10 @@ def decide(key: str, inputs: Optional[tuple], applies: Optional[Iterable[tuple]]
     feed applies, push acknowledgements, the remote-parent mirror, pool reservations); they must chain from the
     credited revision (the last pass's, or the last deferring round's) to this round's without a gap. Any gap is a
     write the scans exist to find (another process, or this thread outside those steps): it repairs at once when
-    the last pass is older than ``local_min_s`` (default ``LOCAL_WRITE_REPAIR_MIN_S``), else that pass is due when
-    the window ends (``deferred``, nothing credited). A missing list (None: a rebuild) repairs at once. The reason: ``unknown`` inputs, ``first`` (no completed
-    pass), ``inputs`` (schema, replica file, mode, gateway or placement), ``local_write`` (a gap) or ``window``
-    (the last pass is older than ``min_s``). [daveey]"""
+    the last pass is older than ``LOCAL_WRITE_REPAIR_MIN_S``, else that pass is due when the window ends
+    (``deferred``, nothing credited). A missing list (None: a rebuild) repairs at once. The reason: ``unknown``
+    inputs, ``first`` (no completed pass), ``inputs`` (schema, replica file, mode, gateway or placement),
+    ``local_write`` (a gap) or ``window`` (the last pass is older than ``min_s``). [daveey]"""
     last = _REPAIRED.get(key)
     if inputs is None:
         return "unknown"
@@ -66,7 +67,7 @@ def decide(key: str, inputs: Optional[tuple], applies: Optional[Iterable[tuple]]
         return "inputs"
     if not applies_chain(_REPAIR_CREDIT.get(key, last_revision), applies, revision):
         # Not credited: every later round still sees the gap, so the pass runs when this window ends at the latest.
-        due = _REPAIRED_AT.get(key, float("-inf")) + (LOCAL_WRITE_REPAIR_MIN_S if local_min_s is None else local_min_s)
+        due = _REPAIRED_AT.get(key, float("-inf")) + LOCAL_WRITE_REPAIR_MIN_S
         if now >= due:
             return "local_write"
         _REPAIR_DEFERRED[key] = due
diff --git a/tests/hermes_cli/test_kanban_sync_copy_links.py b/tests/hermes_cli/test_kanban_sync_copy_links.py
index 373ab5eec3..8d4e82f972 100644
--- a/tests/hermes_cli/test_kanban_sync_copy_links.py
+++ b/tests/hermes_cli/test_kanban_sync_copy_links.py
@@ -14,6 +14,7 @@ The next sync round restores edges already lost that way (``repair_partition_lin
 from hermes_cli import kanban_db as kb
 from hermes_cli import kanban_db_connect as kbc
 from hermes_cli import kanban_sync_client as ksc
+from hermes_cli import kanban_sync_repair_window as win
 from hermes_cli import kanban_worker_node as wn
 from tests.hermes_cli.test_kanban_cross_gateway_parents import (
     BOARD, ME, OTHER, _other, _round, kanban_home, live, svc,
@@ -21,6 +22,9 @@ from tests.hermes_cli.test_kanban_cross_gateway_parents import (
 
 __all__ = ["kanban_home", "live", "svc"]
 
+# Read at import, before the conftest fixture pins it to 0 for this module.
+PRODUCTION_LOCAL_WRITE_WINDOW = win.LOCAL_WRITE_REPAIR_MIN_S
+
 
 def _import(live, *ids):
     replica = ksc.open_shadow(BOARD, ME)
@@ -90,6 +94,23 @@ def test_a_round_restores_a_lost_edge_from_a_present_foreign_parent_to_our_child
     assert _diff(live)["child_mismatch"] == {}
 
 
+def test_a_lost_edge_is_restored_when_the_production_repair_window_ends(live, svc, kanban_home, monkeypatch):
+    """conftest pins ``LOCAL_WRITE_REPAIR_MIN_S`` to 0 here; this one test keeps the production window. The edge is
+    dropped by another connection (a gap), so the restoring pass waits until the window after the last pass ends."""
+    monkeypatch.setattr(win, "LOCAL_WRITE_REPAIR_MIN_S", PRODUCTION_LOCAL_WRITE_WINDOW)
+    now = [1000.0]
+    monkeypatch.setattr(ksc, "_repair_clock", lambda: now[0])
+    child = _foreign_parent_with_own_child(live, svc, kanban_home)
+    _drop_uncaptured(live, "t_copy", child)
+    now[0] += 1
+    assert _round(kanban_home, svc).repair_deferred
+    assert _edges(live, child) == []  # repair_partition_links waits for the window
+    now[0] = 1000.0 + PRODUCTION_LOCAL_WRITE_WINDOW
+    assert not _round(kanban_home, svc).repair_deferred
+    assert _edges(live, child) == [("t_copy", child)]
+    assert _diff(live)["child_mismatch"] == {}
+
+
 def _foreign_child_of_done_parent(svc, kanban_home, status="running"):
     _other(svc, "dp", "tasks", "t_done", {"title": "parent", "status": "done", "created_at": 1,
                                           "created_on": OTHER})
