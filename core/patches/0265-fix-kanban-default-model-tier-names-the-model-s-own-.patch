From 5ee4d4d481959ae8489c9909a93a41baa33a41b9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 20:45:48 -0700
Subject: [PATCH] fix(kanban): default model tier names the model's own
 provider when default_provider is unset [daveey]

Problem: 4 cards created 10-23 20:39 PT all crashed on their first run: 'claude-sonnet-5-5 is not
supported when using Codex with a ChatGPT account' (HTTP 400), then gave up after 1 attempt.
Why 1: the tier set model_override=claude-sonnet-5-5 with provider None.
Why 2: kanban.default_provider was unset, so the worker paired the tier model with the profile's
  provider, which had been switched to openai-codex (gpt-6-astra).
Root: a tier that pins a model but not its provider depends on the profile never changing provider.
Not caught: tests asserted provider None for a claude default (encoded the bug).
Fix: infer_provider() (static catalog, then claude-* -> anthropic) when default_provider is unset.
Tests: test_unset_default_provider_is_inferred_not_the_profiles; two assertions corrected.
---
 hermes_cli/kanban_model_tier.py            | 16 +++++++++++++++-
 tests/hermes_cli/test_kanban_model_tier.py | 19 +++++++++++++++++--
 2 files changed, 32 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_model_tier.py b/hermes_cli/kanban_model_tier.py
index fed45e8a9f..0d27eafd2e 100644
--- a/hermes_cli/kanban_model_tier.py
+++ b/hermes_cli/kanban_model_tier.py
@@ -104,7 +104,21 @@ def resolve_model_tier(
                 return None, None, f"pattern:{pattern}"
         except re.error as exc:
             logger.warning("kanban model tier: bad default_model_keep_patterns entry %r (%s)", pattern, exc)
-    return default_model, _str(cfg.get("default_provider")) or None, "default"
+    return default_model, _str(cfg.get("default_provider")) or infer_provider(default_model), "default"
+
+
+def infer_provider(model: str) -> Optional[str]:
+    """Provider for a tier model when ``default_provider`` is unset. Without one the worker pairs the tier model
+    with the PROFILE's provider, so ``claude-sonnet-5-5`` was sent to openai-codex (HTTP 400, every card dead on
+    its first run) after the profile model was switched to a GPT. Static catalog first, then the model family."""
+    try:
+        from hermes_cli.models import detect_static_provider_for_model
+        hit = detect_static_provider_for_model(model, "")
+        if hit:
+            return hit[0]
+    except Exception as exc:  # never break dispatch over the catalog
+        logger.debug("kanban model tier: provider lookup failed for %s (%s)", model, exc)
+    return "anthropic" if model.lower().startswith("claude") else None
 
 
 def apply_model_tier(conn: sqlite3.Connection, task: Any, *, lane: str, cfg: Optional[dict[str, Any]] = None) -> str:
diff --git a/tests/hermes_cli/test_kanban_model_tier.py b/tests/hermes_cli/test_kanban_model_tier.py
index 2933b1db5d..eaa52add27 100644
--- a/tests/hermes_cli/test_kanban_model_tier.py
+++ b/tests/hermes_cli/test_kanban_model_tier.py
@@ -147,7 +147,7 @@ def test_keep_patterns_and_profile_scope(board):
     assert got["sec"][0] is None and got["sec"][2].startswith("pattern:")
     assert got["core"][0] is None and got["core"][2] == "pattern:hermes-core-wt"
     assert got["other"] == (None, None, "profile_out_of_scope")
-    assert got["plain"] == (SONNET, None, "default")
+    assert got["plain"] == (SONNET, "anthropic", "default")
 
 
 def test_bad_pattern_is_ignored_not_fatal(board):
@@ -155,7 +155,7 @@ def test_bad_pattern_is_ignored_not_fatal(board):
         t = kb.get_task(conn, kb.create_task(conn, title="routine", assignee="default"))
         got = tier.resolve_model_tier(conn, t, lane="ready",
                                       cfg={"default_model": SONNET, "default_model_keep_patterns": ["("]})
-    assert got == (SONNET, None, "default")
+    assert got == (SONNET, "anthropic", "default")
 
 
 def test_tier_pin_reaches_worker_argv(board, monkeypatch):
@@ -167,3 +167,18 @@ def test_tier_pin_reaches_worker_argv(board, monkeypatch):
     argv = kbd._worker_argv(t, "default", None)
     assert argv[argv.index("-m") + 1] == SONNET
     assert argv[argv.index("--provider") + 1] == "anthropic"
+
+
+def test_unset_default_provider_is_inferred_not_the_profiles(board):
+    """default_model claude-* with no default_provider ran on the profile's provider (openai-codex after the
+    profile switched to a GPT): HTTP 400 on every card. The tier now names the model's own provider."""
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="plain job", assignee="default")
+        task = kb.get_task(conn, tid)
+        model, prov, reason = tier.resolve_model_tier(conn, task, lane="ready", cfg={"default_model": SONNET})
+        assert (model, prov, reason) == (SONNET, "anthropic", "default")
+        # An explicit default_provider still wins.
+        _m, prov, _r = tier.resolve_model_tier(conn, task, lane="ready",
+                                               cfg={"default_model": SONNET, "default_provider": "openrouter"})
+        assert prov == "openrouter"
+    assert tier.infer_provider("some-unknown-model") is None
