From 895881f9e4b17d2227e703b8313efcc7ef702257 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:28:47 +0000
Subject: [PATCH] fix(kanban): share guarded board reader boundary [daveey]

The short-lived snapshot reader added a second open_ro import, exceeding the plugin boundary baseline. Extract the existing guarded opener and share it between observers and snapshots, preserving per-reader thread affinity and snapshot close semantics. Do not change boundary lint or its baseline.

Proof: bcb622bb15e4 boundary suite 1 failed/6 passed (duplicate open_ro); fixed suite plus 19 board/dashboard suites 219 passed. Full scripts/check --base origin/main passed. Existing reader-lifetime tests cover close on success and failure.
---
 plugins/kanban/dashboard/board_rows.py | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/plugins/kanban/dashboard/board_rows.py b/plugins/kanban/dashboard/board_rows.py
index 6cf231e9e0..c964fd079c 100644
--- a/plugins/kanban/dashboard/board_rows.py
+++ b/plugins/kanban/dashboard/board_rows.py
@@ -107,14 +107,18 @@ def _retire(*observers: Optional[_Observer]) -> None:
                 obs.close()
 
 
-def _open_observer(path: str, ident: tuple) -> _Observer:
+def _open_reader(path: str, *, check_same_thread: bool = True) -> sqlite3.Connection:
     from hermes_state_guard import ensure_kanban_test_isolation
     from hermes_cli.kanban_generation import open_ro
 
     ensure_kanban_test_isolation(Path(path))
     # Guarded and registered (recover() runs first, remember() records its -shm generation): never
     # an unregistered handle that could pin a deleted generation where recover() cannot retire it.
-    conn = open_ro(Path(path), check_same_thread=False)
+    return open_ro(Path(path), check_same_thread=check_same_thread)
+
+
+def _open_observer(path: str, ident: tuple) -> _Observer:
+    conn = _open_reader(path, check_same_thread=False)
     try:
         if _ident(path) != ident:  # replaced between stat and open
             raise sqlite3.OperationalError("board file replaced while opening observer")
@@ -297,8 +301,7 @@ def incremental(key: tuple, path: str, build: Callable, fallback: Callable) -> d
                 rows = hit[1]
             cursor = hit[0]
         else:
-            from hermes_cli.kanban_generation import open_ro
-            conn = open_ro(Path(path))
+            conn = _open_reader(path)
             conn.row_factory = sqlite3.Row
             try:
                 conn.execute("BEGIN")
