From 2b74bf1583eccc12014d00916a405aea1959d2d8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 17 Nov 2026 15:59:27 +0000
Subject: [PATCH] [daveey] Mark courier receipt reader as non-board SQLite
 access

CI lockguard scan correctly requires an explicit non-board marker. This reader opens only courier hub.db in read-only mode, not a Kanban board. Use the existing narrow per-call exemption, retaining board guard policy. Proof: scanner reproduced red before marker; canonical lockguard, producer and flaky intake suites pass 41 tests after it. Full check finds only stale-base lifecycle_guard CC drift; canonical ship will rebase and rerun gates.
---
 hermes_cli/kanban_selfwork_producer.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_selfwork_producer.py b/hermes_cli/kanban_selfwork_producer.py
index ecba726c450a4300ac31aeb7339cf2353b26f26f..18aecf3d4b7606ca1c9099df0afc767cc113d4cc 100644
--- a/hermes_cli/kanban_selfwork_producer.py
+++ b/hermes_cli/kanban_selfwork_producer.py
@@ -90,7 +90,7 @@ def receipt(frozen, row):
 
 def read_receipt(frozen):
     path = Path(os.environ.get('HERMES_HUB_STATE') or Path.home() / '.local/state/hermes-hub') / 'hub.db'
-    with sqlite3.connect(path.as_uri() + '?mode=ro', uri=True, timeout=5) as db:
+    with sqlite3.connect(path.as_uri() + '?mode=ro', uri=True, timeout=5) as db:  # noqa: kanban-lockguard (hub.db, not a board)
         db.row_factory = sqlite3.Row
         sender = db.execute("SELECT v FROM meta WHERE k='gateway'").fetchone()
         if sender is None or sender[0] != frozen['sender']:
-- 
