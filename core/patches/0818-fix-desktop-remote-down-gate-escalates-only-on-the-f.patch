From 7ab44c136e8bec3eafedc99433edaa88ee727722 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 15:25:04 -0700
Subject: [PATCH] fix(desktop): remote down gate escalates only on the first
 drop and failed trials [daveey]

Review of 08c725d741: every in-flight request failing in one outage bumped the
backoff, so 5 concurrent resets jumped it to the 30 s cap and the hub kept
fast-failing ~20 s after a ~10 s restart. A stale failure also cleared the
trial slot, letting a second trial in.

Admissions now carry a per-key epoch and the trial an id. Only the first
up->down transition and the owning trial's failure escalate; only the trial
(or a request sent after the down-mark, e.g. probe retire then reconnect)
reopens; stale in-flight verdicts are ignored. Tests fail on 08c725d741.
---
 .../desktop/electron/remote-down-gate.test.ts | 114 +++++++++++++-
 apps/desktop/electron/remote-down-gate.ts     | 143 ++++++++++++++----
 2 files changed, 225 insertions(+), 32 deletions(-)

diff --git a/apps/desktop/electron/remote-down-gate.test.ts b/apps/desktop/electron/remote-down-gate.test.ts
index 6dc1385ab4..5a2b01fe3d 100644
--- a/apps/desktop/electron/remote-down-gate.test.ts
+++ b/apps/desktop/electron/remote-down-gate.test.ts
@@ -103,16 +103,126 @@ describe('remote down gate', () => {
     h.time.advance(REMOTE_DOWN_INITIAL_BACKOFF_MS)
     await expect(h.run(async () => 'back')).resolves.toBe('back')
 
+    // Every further failed trial doubles again, up to the cap.
     const capped = new RemoteDownGate(h.time.now)
+    capped.markDown(KEY, 'reset')
 
     for (let i = 0; i < 20; i++) {
-      capped.markDown(KEY, 'reset')
+      h.time.advance(REMOTE_DOWN_MAX_BACKOFF_MS)
+      capped.markDown(KEY, 'reset', capped.admit(KEY))
     }
 
     h.time.advance(REMOTE_DOWN_MAX_BACKOFF_MS - 1)
     expect(() => capped.admit(KEY)).toThrow()
     h.time.advance(1)
-    expect(capped.admit(KEY)).toEqual({ trial: true })
+    expect(capped.admit(KEY)).toMatchObject({ trial: true })
+  })
+
+  it('many requests failing together in one outage cost one initial backoff, not the cap', async () => {
+    const h = harness()
+
+    // Several renderer polls (hub-sync/status, kanban/board, runners) are in flight when the hub restarts.
+    await Promise.allSettled([1, 2, 3, 4, 5].map(() => h.run(async () => Promise.reject(reset()))))
+    expect(h.gate.isDown(KEY)).toBe(true)
+
+    const blocked = (() => {
+      try {
+        h.gate.admit(KEY)
+      } catch (error) {
+        return error as { retryInMs: number }
+      }
+
+      return null
+    })()
+
+    expect(blocked?.retryInMs).toBe(REMOTE_DOWN_INITIAL_BACKOFF_MS)
+    h.time.advance(REMOTE_DOWN_INITIAL_BACKOFF_MS - 1)
+    expect(() => h.gate.admit(KEY)).toThrow()
+    h.time.advance(1)
+    await expect(h.run(async () => 'back')).resolves.toBe('back')
+    expect(h.gate.isDown(KEY)).toBe(false)
+  })
+
+  it('a stale failure during the trial neither frees the trial slot nor extends the backoff', async () => {
+    const h = harness()
+
+    let failStale: (error: Error) => void = () => {}
+    const stale = h.run(() => new Promise((_, reject) => (failStale = reject))).catch(e => e)
+
+    await vi.waitFor(() => expect(h.connect).toHaveBeenCalledTimes(1))
+    await h.run(async () => Promise.reject(reset())).catch(() => {})
+    h.time.advance(REMOTE_DOWN_INITIAL_BACKOFF_MS)
+
+    let failTrial: (error: Error) => void = () => {}
+    const trial = h.run(() => new Promise((_, reject) => (failTrial = reject))).catch(e => e)
+
+    await vi.waitFor(() => expect(h.connect).toHaveBeenCalledTimes(3))
+
+    // The request admitted before the outage fails late, while the trial is still running.
+    failStale(reset())
+    await stale
+
+    const during = (() => {
+      try {
+        h.gate.admit(KEY)
+      } catch (error) {
+        return error as { retryInMs: number }
+      }
+
+      return null
+    })()
+
+    expect(during).not.toBeNull()
+    expect(during?.retryInMs).toBe(0)
+    h.time.advance(REMOTE_DOWN_MAX_BACKOFF_MS)
+    expect(() => h.gate.admit(KEY)).toThrow(/reconnect in progress/)
+
+    // The trial's own failure escalates exactly once: 2 s -> 4 s.
+    failTrial(reset())
+    await trial
+    h.time.advance(2 * REMOTE_DOWN_INITIAL_BACKOFF_MS - 1)
+    expect(() => h.gate.admit(KEY)).toThrow()
+    h.time.advance(1)
+    expect(h.gate.admit(KEY)).toMatchObject({ trial: true })
+  })
+
+  it('an answer to a request admitted before the outage does not reopen the gate', async () => {
+    const h = harness()
+
+    let finishStale: (value: unknown) => void = () => {}
+    const stale = h.run(() => new Promise(resolve => (finishStale = resolve)))
+
+    await vi.waitFor(() => expect(h.connect).toHaveBeenCalledTimes(1))
+    await h.run(async () => Promise.reject(reset())).catch(() => {})
+    finishStale({ ok: true })
+    await expect(stale).resolves.toEqual({ ok: true })
+    expect(h.gate.isDown(KEY)).toBe(true)
+  })
+
+  it('a dispatch probe that marks the remote down, then reconnects and answers, reopens the gate', async () => {
+    const h = harness()
+
+    // connect() runs the dispatch probe; its retire path marks the key down before redialing.
+    h.connect.mockImplementationOnce(async () => {
+      h.gate.markDown(KEY, 'dispatch probe failed: socket hang up')
+
+      return { baseUrl: BASE_URL }
+    })
+    await expect(h.run(async () => 'fresh')).resolves.toBe('fresh')
+    expect(h.gate.isDown(KEY)).toBe(false)
+  })
+
+  it('outside evidence (a failed dispatch probe) never escalates an existing outage', () => {
+    const h = harness()
+
+    h.gate.markDown(KEY, 'reset')
+
+    for (let i = 0; i < 5; i++) {
+      h.gate.markDown(KEY, 'dispatch probe failed')
+    }
+
+    h.time.advance(REMOTE_DOWN_INITIAL_BACKOFF_MS)
+    expect(h.gate.admit(KEY)).toMatchObject({ trial: true })
   })
 
   it('an HTTP error is an answer: it does not mark the remote down, and it reopens a down gate', async () => {
diff --git a/apps/desktop/electron/remote-down-gate.ts b/apps/desktop/electron/remote-down-gate.ts
index 56c6d64c67..9792d4cc0e 100644
--- a/apps/desktop/electron/remote-down-gate.ts
+++ b/apps/desktop/electron/remote-down-gate.ts
@@ -10,7 +10,8 @@
 // backend" errors and blocked UI work behind them. This gate records the outage per pool key
 // (`conn:<id>::<profile>`) and, while it lasts, rejects requests at once with RemoteBackendDownError. After a short
 // backoff ONE request is let through as the trial: it reprobes/redials; its success reopens the gate, its failure
-// doubles the backoff. Requests that arrive while the trial is in flight fail fast too.
+// doubles the backoff. Only the first up->down transition and failed trials count toward the backoff; failures from
+// requests that were already in flight when the remote dropped are ignored, so one restart costs one 2 s backoff. Requests that arrive while the trial is in flight fail fast too.
 
 export const REMOTE_DOWN_INITIAL_BACKOFF_MS = 2_000
 export const REMOTE_DOWN_MAX_BACKOFF_MS = 30_000
@@ -67,22 +68,36 @@ export function isRemoteTimeout(error: unknown): boolean {
 }
 
 interface DownState {
+  // Failed trials so far, plus the first up->down transition. Only these escalate the backoff: requests that were
+  // already in flight when the remote dropped all fail together, and counting each would jump the backoff straight
+  // to the cap for a single ~10 s restart.
   failures: number
   reason: string
   since: number
   retryAt: number
-  trialInFlight: boolean
+  // The admission that owns the trial slot. Only that request's verdict may release it, escalate or reopen.
+  trialId: null | number
 }
 
 export interface RemoteDownAdmission {
   trial: boolean
+  // Per-key status epoch at admission (bumped on every up<->down transition) and, for the trial, its id. A request
+  // admitted in an earlier epoch is stale: its failure says nothing new about this outage.
+  readonly epoch?: number
+  readonly trialId?: number
+  // Epoch when the request was actually sent (after connect, which may have reconnected). An answer to a request sent
+  // during the current epoch is fresh evidence, even if it was not the trial (e.g. a failed dispatch probe marked the
+  // remote down and the same request's reconnect then succeeded).
+  sentEpoch?: number
 }
 
 export class RemoteDownGate {
   readonly #down = new Map<string, DownState>()
+  readonly #epoch = new Map<string, number>()
   readonly #now: () => number
   readonly #initialBackoffMs: number
   readonly #maxBackoffMs: number
+  #nextTrialId = 1
 
   constructor(
     now: () => number = Date.now,
@@ -98,50 +113,116 @@ export class RemoteDownGate {
     return this.#down.has(key)
   }
 
+  epochOf(key: string): number {
+    return this.#epochOf(key)
+  }
+
+  #epochOf(key: string): number {
+    return this.#epoch.get(key) ?? 0
+  }
+
+  #bumpEpoch(key: string): void {
+    this.#epoch.set(key, this.#epochOf(key) + 1)
+  }
+
+  #backoff(failures: number): number {
+    return Math.min(this.#initialBackoffMs * 2 ** (failures - 1), this.#maxBackoffMs)
+  }
+
   /** Throws RemoteBackendDownError while `key` is down; otherwise admits the request (as the trial when down). */
   admit(key: string): RemoteDownAdmission {
     const state = this.#down.get(key)
+    const epoch = this.#epochOf(key)
 
     if (!state) {
-      return { trial: false }
+      return { trial: false, epoch }
     }
 
     const now = this.#now()
 
-    if (state.trialInFlight || now < state.retryAt) {
+    if (state.trialId !== null || now < state.retryAt) {
       throw new RemoteBackendDownError(key, state.reason, now - state.since, Math.max(0, state.retryAt - now))
     }
 
-    state.trialInFlight = true
+    const trialId = this.#nextTrialId++
+    state.trialId = trialId
 
-    return { trial: true }
+    return { trial: true, epoch, trialId }
   }
 
-  markDown(key: string, reason: string): void {
+  #ownsTrial(state: DownState, admission?: RemoteDownAdmission): boolean {
+    return Boolean(admission?.trial && admission.trialId !== undefined && admission.trialId === state.trialId)
+  }
+
+  /**
+   * Record that `key` failed. Without an admission (e.g. a failed dispatch probe) this is outside evidence: it takes
+   * an up remote down but never escalates an existing outage. With an admission, only a current-epoch request may take
+   * an up remote down, and only the owning trial may escalate the backoff and release the trial slot; stale in-flight
+   * failures are ignored.
+   */
+  markDown(key: string, reason: string, admission?: RemoteDownAdmission): void {
     const now = this.#now()
-    const previous = this.#down.get(key)
-    const failures = (previous?.failures ?? 0) + 1
-    const backoff = Math.min(this.#initialBackoffMs * 2 ** (failures - 1), this.#maxBackoffMs)
-
-    this.#down.set(key, {
-      failures,
-      reason: String(reason || 'unreachable').slice(0, 160),
-      since: previous?.since ?? now,
-      retryAt: now + backoff,
-      trialInFlight: false
-    })
+    const state = this.#down.get(key)
+    const cleanReason = String(reason || 'unreachable').slice(0, 160)
+
+    if (!state) {
+      const seenEpoch = admission?.sentEpoch ?? admission?.epoch
+
+      if (seenEpoch !== undefined && seenEpoch !== this.#epochOf(key)) {
+        return
+      }
+
+      this.#bumpEpoch(key)
+      this.#down.set(key, {
+        failures: 1,
+        reason: cleanReason,
+        since: now,
+        retryAt: now + this.#backoff(1),
+        trialId: null
+      })
+
+      return
+    }
+
+    if (!this.#ownsTrial(state, admission)) {
+      return
+    }
+
+    state.failures += 1
+    state.reason = cleanReason
+    state.retryAt = now + this.#backoff(state.failures)
+    state.trialId = null
   }
 
-  markUp(key: string): boolean {
-    return this.#down.delete(key)
+  /**
+   * The backend answered. While down, only the owning trial (or an outside caller with no admission) reopens the
+   * gate; an answer to a request admitted before the outage may predate the reset.
+   */
+  markUp(key: string, admission?: RemoteDownAdmission): boolean {
+    const state = this.#down.get(key)
+
+    if (!state) {
+      return false
+    }
+
+    const fresh = admission?.sentEpoch !== undefined && admission.sentEpoch === this.#epochOf(key)
+
+    if (admission && !this.#ownsTrial(state, admission) && !fresh) {
+      return false
+    }
+
+    this.#down.delete(key)
+    this.#bumpEpoch(key)
+
+    return true
   }
 
   /** A trial that ended without a verdict (e.g. a slow endpoint) hands the trial slot back. */
-  releaseTrial(key: string): void {
+  releaseTrial(key: string, admission?: RemoteDownAdmission): void {
     const state = this.#down.get(key)
 
-    if (state) {
-      state.trialInFlight = false
+    if (state && (admission ? this.#ownsTrial(state, admission) : true)) {
+      state.trialId = null
     }
   }
 }
