From 56bef6c2a80c34065472473907c0e33c65113f5c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 13:34:41 -0800
Subject: [PATCH] [daveey] Use bound notice helpers and cover
 journal-after-marker cancellation

---
 tests/tui_gateway/test_shutdown_job_receipts.py | 12 ++++++++++++
 tui_gateway/prompt_turn.py                      |  2 --
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/tests/tui_gateway/test_shutdown_job_receipts.py b/tests/tui_gateway/test_shutdown_job_receipts.py
index f0845df98b6..c92de628f04 100644
--- a/tests/tui_gateway/test_shutdown_job_receipts.py
+++ b/tests/tui_gateway/test_shutdown_job_receipts.py
@@ -852,3 +852,15 @@ def test_user_stop_before_late_marker_keeps_journaled_receipts(home):
     marker = read_turn_marker(home, "session-key")
     assert marker["reason"] == JOBS_REASON
     assert sorted(j["session_id"] for j in marker["killed_jobs"]) == ["K1", "P2"]
+
+
+def test_marker_then_exit_journal_then_cancelled_retire_keeps_journaled_receipt(home):
+    """Retiring the cancelled notice turn must preserve a later journaled completion."""
+    from tui_gateway.exit_job_receipts import JOBS_REASON, _save_receipts
+    from tui_gateway.turn_marker import retire_cancelled_turn_marker
+    assert record_turn_start(home, "session-key", "notice P1 finished", carried_job_ids=["P1"])
+    assert _save_receipts(home, "session-key", [_rcpt("P2")])
+    retire_cancelled_turn_marker(home, "session-key")
+    marker = read_turn_marker(home, "session-key")
+    assert marker is not None and marker["reason"] == JOBS_REASON
+    assert [j["session_id"] for j in marker["killed_jobs"]] == ["P2"]
diff --git a/tui_gateway/prompt_turn.py b/tui_gateway/prompt_turn.py
index 5d30696f229..ca14602087f 100644
--- a/tui_gateway/prompt_turn.py
+++ b/tui_gateway/prompt_turn.py
@@ -182,7 +182,6 @@ def _admit_prompt_turn(
                 # the session already held stays for close's own handoff (_settle_isolated_turn_before_close).
                 _release_active_session_slot(session)
             return None
-        from tui_gateway.session_notifications import admit_synthesized_turn
         if not admit_synthesized_turn(session):
             # [daveey] A backend exit fenced automatic turns after this one's claim: its notice is journaled
             # for the next backend (exit_job_receipts), so it must not also run here. Delivery itself is
@@ -1501,7 +1500,6 @@ def _run_admitted_prompt(
                 _reopen_routed_session_row(routing_db, sid, session)
             # [daveey] Under _sessions_lock: the exit fence check, the notice's delivered mark and the start
             # are one commit (a refused or raising start rolls the mark back; exit_job_receipts).
-            from tui_gateway.session_notifications import start_synthesized_turn
             can_start = start_synthesized_turn(session, lambda: _start_session_work(
                 run, name=f"prompt-turn-{sid}", session=session)) is not None
     if not can_start:
-- 
2.55.0

