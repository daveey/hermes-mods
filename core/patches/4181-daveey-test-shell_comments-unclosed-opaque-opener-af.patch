From 7325d3c867639ad9a735cd0ff7974490c6d53d82 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 05:37:14 +0000
Subject: [PATCH] [daveey] test(shell_comments): unclosed opaque opener after
 root comment abandons masking

Post-merge mutant sweep of PR #2872 (card t_01a1d862a9782e70) found a
surviving non-equivalent mutant in tools/shell_comments.py
mask_root_comment_lines: replacing `return command` with
`end = len(command)` in the `_opaque_end(...) is None` branch masked an
earlier root comment line when a later `$(`/`${`/`"$(`/`(` never closes,
flipping output_reaches_shell from True to False.

Add a behaviour test: "# cat payload.sh | bash\necho <opener>" is
returned unmasked and still reaches the shell, for each opener.

Proof (sdlc-review scripts/mutants.py, isolated HOME/HERMES_HOME):
  BASELINE (no mutation): ok rc=0 96 passed
  M1 unclosed opaque opener masks to end instead of abandoning: killed rc=1 4 failed, 92 passed
---
 tests/cron/test_lifecycle_guard_comment_sink.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/tests/cron/test_lifecycle_guard_comment_sink.py b/tests/cron/test_lifecycle_guard_comment_sink.py
index 1ccbcde679..eca6bd1ea9 100644
--- a/tests/cron/test_lifecycle_guard_comment_sink.py
+++ b/tests/cron/test_lifecycle_guard_comment_sink.py
@@ -122,6 +122,15 @@ def test_uncertain_regions_abandon_masking(text):
     assert output_reaches_shell(text)
 
 
+@pytest.mark.parametrize("opener", ["$(", "${", '"$(', "("])
+def test_unclosed_opener_after_root_comment_abandons_masking(opener):
+    from tools.shell_comments import mask_root_comment_lines
+
+    text = "# cat payload.sh | bash\necho " + opener
+    assert mask_root_comment_lines(text) == text
+    assert output_reaches_shell(text)
+
+
 @pytest.mark.parametrize("tabs", [False, True])
 def test_unquoted_heredoc_false_close_runs_real_substitution(tmp_path, tabs):
     from tools.shell_comments import mask_root_comment_lines
