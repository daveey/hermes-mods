From 410640ba9624db74a65c74e20a3e3e48e96b25e6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 15:10:57 +0000
Subject: [PATCH] [daveey] test(state-repair): snapshot deadline test pins the
 _monotonic seam

The interrupted-snapshot test started its fake clock at 0.0, so the
deadline (start + >=120 s) was already behind the real monotonic clock on
any host up more than ~2 minutes: a deadline check reading the shared
time.monotonic instead of the module's _monotonic seam still raised
TimeoutError and the test passed either way (mutant survived, 24 passed).

Start the fake clock 10**6 s ahead of the real clock and count seam reads
(start tick plus at least one deadline-check read). With the mutant the
backup now completes and the test fails with DID NOT RAISE TimeoutError.
Test-only; every existing assertion kept.
---
 .../test_state_db_repair_non_destructive.py   | 20 +++++++++++++++----
 1 file changed, 16 insertions(+), 4 deletions(-)

diff --git a/tests/hermes_state/test_state_db_repair_non_destructive.py b/tests/hermes_state/test_state_db_repair_non_destructive.py
index 2f1f7f817f..5de1e81661 100644
--- a/tests/hermes_state/test_state_db_repair_non_destructive.py
+++ b/tests/hermes_state/test_state_db_repair_non_destructive.py
@@ -742,15 +742,27 @@ def test_interrupted_snapshot_rolls_back_destination(tmp_path, monkeypatch):
 
     # The fake clock is the repair module's own seam (never the shared time
     # module, which teardown and other callers read) and never runs dry: after
-    # the start tick it stays past the deadline for any number of reads.
-    expired = hermes_state._REPAIR_LOCK_TIMEOUT_SECONDS + 1.0
-    ticks = itertools.chain((0.0,), itertools.repeat(expired))
-    monkeypatch.setattr(hermes_state_repair, "_monotonic", lambda: next(ticks))
+    # the start tick it stays past the deadline for any number of reads. It
+    # starts far ahead of the real clock, so a deadline check that read the
+    # shared time.monotonic instead of the seam would never see it expire.
+    start = time.monotonic() + 10**6
+    expired = start + hermes_state_repair._repair_snapshot_timeout_seconds(source) + 1.0
+    ticks = itertools.chain((start,), itertools.repeat(expired))
+    reads = 0
+
+    def fake_monotonic():
+        nonlocal reads
+        reads += 1
+        return next(ticks)
+
+    monkeypatch.setattr(hermes_state_repair, "_monotonic", fake_monotonic)
     real_monotonic = time.monotonic
 
     with pytest.raises(TimeoutError):
         hermes_state_repair._copy_database_snapshot(source, destination)
 
+    # The start tick plus at least one deadline-check read, both from the seam.
+    assert reads >= 2
     assert time.monotonic is real_monotonic
     assert [hermes_state_repair._monotonic() for _ in range(5)] == [expired] * 5
 
