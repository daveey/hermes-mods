From 31da736ef247134fb6828c99dfb91b3b903953a3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:02:46 +0000
Subject: [PATCH] [daveey] fix(benchmark): charge quiet annotation narrow
 probes

Match holder floor and renewal ordering without the obsolete exact-first gate. Add deterministic quiet-stream counts and CLI threshold pass/fail coverage. Proof: original replay fails all four regressions; corrected focused suites pass 48 tests, expanded benchmark suite passes 5.
---
 scripts/benchmark_kanban_annotation_holder.py | 15 ++++---
 ...test_kanban_annotation_holder_benchmark.py | 44 +++++++++++++++++++
 2 files changed, 52 insertions(+), 7 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_annotation_holder_benchmark.py

diff --git a/scripts/benchmark_kanban_annotation_holder.py b/scripts/benchmark_kanban_annotation_holder.py
index 1d6213a792..a2504fb31f 100644
--- a/scripts/benchmark_kanban_annotation_holder.py
+++ b/scripts/benchmark_kanban_annotation_holder.py
@@ -332,21 +332,22 @@ def replay(union: dict, key_ms: float, per_refresh_ms: float, probe_ms: float, e
     comps = {"hub", "ledger"}
     samples = union["samples"]
     last, refreshes, renews, keys, probes, pending = -1e9, 0, 0, 0, 0, False
-    exact_since = False
     for i, s in enumerate(samples):
         t = (i + 1) * 2.0
         moved = set(s["moved"].get("default", ()))
-        probes += 1
-        exact_since = exact_since or bool(moved) or random.random() < exact_move_rate
         pending = pending or bool(moved & comps) or random.random() < local_move_rate
         if t - last >= 20.0:
-            refreshes, renews, last, pending, exact_since = refreshes + 1, renews + 1, t, False, False
+            refreshes, renews, last, pending = refreshes + 1, renews + 1, t, False
             continue
-        if t - last < 10.0 or not exact_since:
+        if t - last < 10.0:
             continue
-        keys += 1  # exact moved past the floor: the holder computes the narrow key
+        # Match _holder_refresh_scope: no input work inside the floor; every
+        # post-floor pass probes the narrow key, even when exact inputs are quiet.
+        # Refresh cost already includes its publication-time input/key reads.
+        probes += 1
+        keys += 1
         if pending:
-            refreshes, last, pending, exact_since = refreshes + 1, t, False, False
+            refreshes, last, pending = refreshes + 1, t, False
     elapsed = len(samples) * 2.0
     holder = (refreshes * per_refresh_ms + keys * key_ms + probes * probe_ms) / 1000 / elapsed * 100
     base_refreshes = sum(1 for _ in samples if random.random() < exact_move_rate)
diff --git a/tests/hermes_cli/test_kanban_annotation_holder_benchmark.py b/tests/hermes_cli/test_kanban_annotation_holder_benchmark.py
new file mode 100644
index 0000000000..cd7940513f
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_annotation_holder_benchmark.py
@@ -0,0 +1,44 @@
+"""Decision replay must charge quiet post-floor work, not just exact moves."""
+import importlib.util
+import json
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def bench():
+    path = Path(__file__).resolve().parents[2] / "scripts/benchmark_kanban_annotation_holder.py"
+    spec = importlib.util.spec_from_file_location("annotation_holder_bench", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def quiet_stream(count):
+    return {"samples": [{"moved": {"default": []}} for _ in range(count)]}
+
+
+@pytest.mark.parametrize("count,renewals,keys", [(10, 1, 5), (11, 2, 5), (20, 2, 10)])
+def test_quiet_replay_probes_every_post_floor_pass(bench, count, renewals, keys):
+    result = bench.replay(quiet_stream(count), 100, 0, 0, 0, local_move_rate=0)
+    assert result["refreshes"] == result["renewals"] == renewals
+    assert result["narrow_key_calls"] == keys
+    assert result["narrow_key_pct"] == round(keys * 0.1 / (count * 2) * 100, 4)
+
+
+@pytest.mark.parametrize("key_ms,exit_code", [(10, 0), (100, 1)])
+def test_quiet_replay_enforces_key_cpu_threshold(bench, monkeypatch, tmp_path, capsys, key_ms, exit_code):
+    union = tmp_path / "quiet.json"
+    union.write_text(json.dumps(quiet_stream(10)), encoding="utf-8")
+    monkeypatch.setattr(bench, "OWN_CHANGE_P", 0)
+    original = bench.replay
+    monkeypatch.setattr(bench, "replay", lambda *args: original(*args, local_move_rate=0))
+    monkeypatch.setattr(bench, "scale_tier", lambda *_: {
+        "tier": "small", "key_ms_mean": key_ms, "key_moved_without_substantive": 0,
+    })
+    monkeypatch.setattr(bench.sys, "argv", ["benchmark", "--tiers", "small", "--union", str(union),
+                                           "--exact-move-rate", "0", "--per-refresh-ms", "0", "--probe-ms", "0"])
+    assert bench.main() == exit_code
+    assert ("narrow_key_pct" in capsys.readouterr().err) == bool(exit_code)
