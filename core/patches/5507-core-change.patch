+def _db_file_identity(path: Path) -> Optional[tuple[int, int]]:
+    """Identity only: ordinary WAL commits do not invalidate a checked snapshot."""
+    try:
+        st = path.stat()
+        return (st.st_dev, st.st_ino) if st.st_size else None
+    except OSError:
+        return None
