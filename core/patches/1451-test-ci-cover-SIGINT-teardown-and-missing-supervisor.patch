From 01d1e563788b81c79be30188df04d7608bfe91da Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 17:49:26 +0000
Subject: [PATCH] test(ci): cover SIGINT teardown and missing supervisor
 acknowledgment [daveey]

---
 scripts/ci/plugin_validation_sandbox.py    | 8 ++++----
 tests/ci/test_plugin_sandbox_lifecycle.py  | 2 +-
 tests/ci/test_plugin_validation_sandbox.py | 7 ++++---
 3 files changed, 9 insertions(+), 8 deletions(-)

diff --git a/scripts/ci/plugin_validation_sandbox.py b/scripts/ci/plugin_validation_sandbox.py
index e48457519a8..e8b0ff1e27e 100644
--- a/scripts/ci/plugin_validation_sandbox.py
+++ b/scripts/ci/plugin_validation_sandbox.py
@@ -582,11 +582,11 @@ def _ppid(pid: str) -> int | None:
 
 
 def _child_pidfds(parent: int) -> list[int]:
-    """pidfds of ``parent``'s children: bwrap's one child is the sandbox's PID 1.
+    """Pin the dedicated supervisor's adopted children without PID-reuse races.
 
-    Taken while bwrap is still alive. ``pidfd_open`` pins the pid; the ppid read
-    after it proves the pid was not reaped and reused in between (an exited child
-    is kept: its pidfd only ever reports that it exited).
+    ``pidfd_open`` pins the pid; the ppid read after it proves the pid was not
+    reaped and reused in between. This is a kill-target snapshot, NOT proof of
+    quiescence: only waitpid's ECHILD after reaping the monitor supplies that.
     """
     out = []
     for pid in (p for p in os.listdir("/proc") if p.isdigit() and _ppid(p) == parent):
diff --git a/tests/ci/test_plugin_sandbox_lifecycle.py b/tests/ci/test_plugin_sandbox_lifecycle.py
index 0bf4f774660..fa99892856a 100644
--- a/tests/ci/test_plugin_sandbox_lifecycle.py
+++ b/tests/ci/test_plugin_sandbox_lifecycle.py
@@ -88,7 +88,7 @@ def test_missing_quiescence_ack_retains_scratch(work):
             assert "--supervise" in argv
             return real_popen(["/bin/true"], **kwargs)
         mod.subprocess.Popen = lost_supervisor
-        sys.exit(mod.main(["--no-network", "--", "true"]))
+        sys.exit(mod.main(["--bwrap", "/bin/false", "--no-network", "--", "true"]))
     ''')
     result = subprocess.run([sys.executable, "-I", "-c", probe, str(helpers.SCRIPT)],
                             capture_output=True, text=True, timeout=60,
diff --git a/tests/ci/test_plugin_validation_sandbox.py b/tests/ci/test_plugin_validation_sandbox.py
index c8a7e7a3258..db9dee21818 100644
--- a/tests/ci/test_plugin_validation_sandbox.py
+++ b/tests/ci/test_plugin_validation_sandbox.py
@@ -535,7 +535,8 @@ def _dead(pid: int) -> bool:
 
 
 @pytest.mark.parametrize("launch", ["wrapper", "timeout"])
-def test_scratch_is_removed_only_after_every_sandboxed_process_exits(work, launch):
+@pytest.mark.parametrize("signum", [2, 15], ids=["sigint", "sigterm"])
+def test_scratch_is_removed_only_after_every_sandboxed_process_exits(work, launch, signum):
     """Regression (CI job 124558089350): reaping bwrap does not mean the sandbox is
     gone. The kernel kills the rest of its PID namespace only after bwrap exits, so
     the overlay copy was removed while a sandboxed process still wrote into it and a
@@ -585,8 +586,8 @@ def test_scratch_is_removed_only_after_every_sandboxed_process_exits(work, launc
     try:
         wait_until(ready.exists, timeout=20, what="the sandboxed writer starting")
         writer = int(ready.read_text())
-        proc.send_signal(15)
-        assert proc.wait(timeout=60) == 128 + 15
+        proc.send_signal(signum)
+        assert proc.wait(timeout=60) == 128 + signum
         assert _dead(writer), "the wrapper exited while a sandboxed process still ran"
         assert not list(work.glob("plugin-sandbox-*"))
         assert list(home.iterdir()) == []
