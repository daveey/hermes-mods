From 22a48418c2575ebb9fb533fddb54d3426d3ffabf Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 01:31:50 +0000
Subject: [PATCH] fix(kanban): reload bounded histories without trusted cursor
 [daveey]

Public mirror of the source commit; see the accompanying feature documentation.

---
 plugins/kanban/dashboard/board_shadow.py    |  4 +++
 tests/plugins/test_kanban_shadow_refresh.py | 27 +++++++++++++++++++++
 2 files changed, 31 insertions(+)

diff --git a/plugins/kanban/dashboard/board_shadow.py b/plugins/kanban/dashboard/board_shadow.py
index a10fde52998..ce50cd6e35a 100644
--- a/plugins/kanban/dashboard/board_shadow.py
+++ b/plugins/kanban/dashboard/board_shadow.py
@@ -63,6 +63,10 @@ def merge(payload: dict, live, tenant, include_archived, workflow_template_id, c
 
         def build(conn, prev=None, changed=None):
             ids, total = _selection(conn, filters, live_ids, live_done, cap)
+            # Without trusted content marks, count/max cannot detect same-ID history edits.
+            # Reload only the selected cards; ordinary board_read reuse stays unchanged.
+            if changed is None:
+                prev = None
             result = board_read.materialize(
                 conn, tenant, include_archived, workflow_template_id, current_step_key, cap,
                 diagnostic_inputs=diagnostic_inputs, prev=prev, changed=changed, selected_ids=ids)
diff --git a/tests/plugins/test_kanban_shadow_refresh.py b/tests/plugins/test_kanban_shadow_refresh.py
index c673e08c14d..136bdd4e4a6 100644
--- a/tests/plugins/test_kanban_shadow_refresh.py
+++ b/tests/plugins/test_kanban_shadow_refresh.py
@@ -63,6 +63,33 @@ def test_payload_parity_with_legacy_reader(shadow_board, monkeypatch, cap, archi
     _compare(env, monkeypatch, done_limit=cap, archived=archived)
 
 
+@pytest.mark.parametrize('reader', ['head', 'base_oracle'])
+def test_legacy_cursor_same_id_history_edit(shadow_board, monkeypatch, reader):
+    """Count/max are not content evidence when the P2 cursor is unavailable."""
+    from hermes_cli import kanban_task_change
+
+    if reader == 'base_oracle':
+        oracle.clear()
+        monkeypatch.setattr(board_shadow, 'merge', oracle.merge)
+    env = shadow_board
+    monkeypatch.setattr(kanban_task_change, 'changed_since', lambda *args: (None, None))
+    captured = []
+    original = env['mod']._diagnostics_from_inputs
+
+    def capture(inputs):
+        captured.append(inputs)
+        return original(inputs)
+
+    monkeypatch.setattr(env['mod'], '_diagnostics_from_inputs', capture)
+    tid = env['running']
+    _write(env, "INSERT INTO task_events(task_id,kind,payload,created_at) VALUES (?,'test','{}',1)", (tid,))
+    _read(env)
+    assert captured[-1][1][tid][-1]['payload'] == '{}'
+    _write(env, "UPDATE task_events SET payload=? WHERE task_id=? AND kind='test'", ('{"fresh":true}', tid))
+    _read(env)
+    assert captured[-1][1][tid][-1]['payload'] == '{"fresh":true}'
+
+
 def test_live_collision_changes_without_replica_commit(shadow_board):
     env = shadow_board
     assert env['done'] in _cards(_read(env))
