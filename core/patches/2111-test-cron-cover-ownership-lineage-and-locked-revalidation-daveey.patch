Subject: [PATCH] test(cron): cover ownership lineage and locked revalidation
 [daveey]

---
 .../test_cron_ownership_controls.py           | 65 +++++++++++++++++++
 1 file changed, 65 insertions(+)
 create mode 100644 tests/hermes_state/test_cron_ownership_controls.py

diff --git a/tests/hermes_state/test_cron_ownership_controls.py b/tests/hermes_state/test_cron_ownership_controls.py
new file mode 100644
index 00000000000..c68b95187fc
--- /dev/null
+++ b/tests/hermes_state/test_cron_ownership_controls.py
@@ -0,0 +1,65 @@
+"""Boundary controls for metadata-only cron ownership transitions."""
+import pytest
+
+from cron import jobs, session_ownership
+from hermes_state import SessionDB
+import hermes_state_outcome as outcomes
+
+
+def test_profile_done_releases_root_lineage_and_is_idempotent(tmp_path):
+    profile = tmp_path / "profiles" / "other"
+    profile.mkdir(parents=True)
+    with jobs.use_cron_store(tmp_path), SessionDB(db_path=profile / "state.db") as db:
+        db.create_session("root", source="desktop")
+        db.end_session("root", "compression")
+        db.create_session("tip", source="desktop", parent_session_id="root")
+        job = jobs.create_job(prompt="Check", schedule="every 1h", owner_session_id="root")
+        result = outcomes.declare_outcome("tip", {"kind": "done", "summary": "Finished."}, db=db)
+        assert [r["id"] for r in result["released_crons"]] == [job["id"]]
+        before = (tmp_path / "cron" / "jobs.json").read_bytes()
+        assert outcomes.declare_outcome("tip", {"kind": "done", "summary": "Finished."}, db=db)["released_crons"] == []
+        assert (tmp_path / "cron" / "jobs.json").read_bytes() == before
+
+
+@pytest.mark.parametrize("state", ["paused", "completed", "disabled"])
+@pytest.mark.parametrize("operation", ["declare", "migrate"])
+def test_inactive_jobs_are_not_released(tmp_path, state, operation):
+    with jobs.use_cron_store(tmp_path), SessionDB(db_path=tmp_path / "state.db") as db:
+        db.create_session("chat", source="desktop")
+        jobs.create_job(prompt="Check", schedule="every 1h", owner_session_id="chat")
+        records = jobs.load_jobs()
+        records[0]["state"] = state
+        jobs.save_jobs(records)
+        before = (tmp_path / "cron" / "jobs.json").read_bytes()
+        if operation == "declare":
+            assert outcomes.declare_outcome("chat", {"kind": "done", "summary": "Finished."}, db=db)["released_crons"] == []
+        else:
+            outcomes._write(db, "chat", {"kind": "done", "summary": "Finished."})
+            assert session_ownership.release_done_owners(db, apply=True) == []
+        assert (tmp_path / "cron" / "jobs.json").read_bytes() == before
+
+
+def test_release_revalidates_owner_after_taking_store_lock(tmp_path):
+    import threading
+
+    with jobs.use_cron_store(tmp_path):
+        job = jobs.create_job(prompt="Check", schedule="every 1h", owner_session_id="chat")
+        started = threading.Event()
+        result = []
+
+        def release():
+            with jobs.use_cron_store(tmp_path):
+                started.set()
+                result.extend(session_ownership.release_session_jobs(["chat"]))
+
+        with jobs._jobs_lock():
+            worker = threading.Thread(target=release)
+            worker.start()
+            assert started.wait(5)
+            records = jobs.load_jobs()
+            records[0]["owner_session_id"] = "new-owner"
+            jobs.save_jobs(records)
+        worker.join(5)
+        assert not worker.is_alive()
+        assert result == []
+        assert jobs.get_job(job["id"])["owner_session_id"] == "new-owner"
