From e60925770c2ce553eef88e14e68acdb95183a5b9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:23:14 +0000
Subject: [PATCH] [daveey] kanban remote owner: drop the dead tick throttle;
 zero the start delay in the notify_in_gateway test

Follow-up to PR #2224 review 5891766452 nits (t_01a1d518cd38f534). No behaviour change.

1. gateway/kanban_remote_owner.py `tick`: the `_next_at`/`force` throttle was dead. Its only caller,
   `_kanban_remote_owner_watcher`, always passed force=True and sets the cadence itself with
   `_sleep_between_ticks(INTERVAL_S)`. Removed the parameter, the module global and its reset; the
   docstring now says the caller sets the cadence.
2. tests/gateway/test_kanban_remote_owner_delivery.py
   `test_remote_owner_watcher_honours_notify_in_gateway`: set `_KANBAN_WATCHER_START_DELAY = 0` like the
   sibling tests, and make the `tick` stub async and end the loop after one pass. A gate regression now
   fails on `assert calls == []` instead of a TimeoutError (or a TypeError from awaiting the sync stub's None).

Proof: with the notify_in_gateway gate disabled by hand, the test fails in ~1 s with
`AssertionError: assert [(<gateway.ru...>,)] == []`; restored, the remote owner delivery and sibling
custody suites pass (59 tests).
---
 gateway/kanban_remote_owner.py                     | 12 +++---------
 gateway/kanban_watchers.py                         |  2 +-
 tests/gateway/test_kanban_remote_owner_delivery.py | 10 ++++++++--
 3 files changed, 12 insertions(+), 12 deletions(-)

diff --git a/gateway/kanban_remote_owner.py b/gateway/kanban_remote_owner.py
index 3c1116beac..726f1292c3 100644
--- a/gateway/kanban_remote_owner.py
+++ b/gateway/kanban_remote_owner.py
@@ -44,14 +44,11 @@ _DISPLAY_LIMIT = 2000  # session_automation._DISPLAY_TEXT_LIMIT
 _lock = threading.Lock()
 # (ledger session, ref, state) -> {"claim", "key", "ids", "tip"} for claims this process admitted or adopted.
 _admitted: dict[tuple, dict] = {}
-_next_at = 0.0
 
 
 def _reset_for_tests() -> None:
-    global _next_at
     with _lock:
         _admitted.clear()
-    _next_at = 0.0
 
 
 def _claim_id(claim: dict) -> tuple:
@@ -249,12 +246,9 @@ async def _admit(runner: Any, adapter: Any, live: Any, ids: frozenset, tip: str,
     return True
 
 
-async def tick(runner: Any, *, force: bool = False) -> list[dict]:
-    """One pass (at most every ``INTERVAL_S``); the admitted notices. Never raises."""
-    global _next_at
-    if not force and time.monotonic() < _next_at:
-        return []
-    _next_at = time.monotonic() + INTERVAL_S
+async def tick(runner: Any) -> list[dict]:
+    """One pass; the admitted notices. Never raises. The caller sets the cadence (the gateway's remote owner
+    watcher, every ``INTERVAL_S`` by default)."""
     try:
         from gateway.config import Platform
         from gateway.kanban_tui_owner import _launch_authority
diff --git a/gateway/kanban_watchers.py b/gateway/kanban_watchers.py
index ba8458d49b..f109550de8 100644
--- a/gateway/kanban_watchers.py
+++ b/gateway/kanban_watchers.py
@@ -193,7 +193,7 @@ class GatewayKanbanWatchersMixin:
         interval = kanban_remote_owner.INTERVAL_S if interval is None else interval
         await asyncio.sleep(self._KANBAN_WATCHER_START_DELAY)  # as the notifier: let adapters wire up first
         while self._running:
-            await kanban_remote_owner.tick(self, force=True)  # never raises
+            await kanban_remote_owner.tick(self)  # never raises
             await self._sleep_between_ticks(interval)
 
     def _kanban_sub_op(self, board: Optional[str], op: str, sub: dict, **extra: Any) -> Any:
diff --git a/tests/gateway/test_kanban_remote_owner_delivery.py b/tests/gateway/test_kanban_remote_owner_delivery.py
index 26a34844ce..ab3dc40e36 100644
--- a/tests/gateway/test_kanban_remote_owner_delivery.py
+++ b/tests/gateway/test_kanban_remote_owner_delivery.py
@@ -223,7 +223,7 @@ def _ledger(tid, gw="worker-2"):
 
 
 def _tick(runner):
-    return asyncio.run(kro.tick(runner, force=True))
+    return asyncio.run(kro.tick(runner))
 
 
 def test_n1_busy_owned_chat_admits_on_first_pass_and_row_lands_at_next_boundary(env, caplog):
@@ -839,9 +839,15 @@ def test_remote_owner_watcher_honours_notify_in_gateway(env, monkeypatch):
     from hermes_cli import config as hc
     _hub, runner, _authority, _fifo, _db = env
     runner._running = True
+    runner._KANBAN_WATCHER_START_DELAY = 0.0  # a gate regression fails on ``calls``, not on the 2 s timeout
     calls = []
+
+    async def tick(*a, **k):
+        calls.append(a)
+        runner._running = False  # one pass, so a gate regression fails on ``calls`` below
+        return []
     monkeypatch.setattr(hc, "load_config", lambda: {"kanban": {"notify_in_gateway": False}})
-    monkeypatch.setattr(kro, "tick", lambda *a, **k: calls.append(a))
+    monkeypatch.setattr(kro, "tick", tick)
     asyncio.run(asyncio.wait_for(runner._kanban_remote_owner_watcher(interval=1), 2))
     assert calls == []
 
