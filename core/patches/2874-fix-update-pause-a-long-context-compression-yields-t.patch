+                                     "max_attempts": 2}}}
+SUMMARY_CAP_S = 8.0  # a summary left alone streams this long, then commits
+_TICK = threading.Event()  # never set: ``_TICK.wait(s)`` paces a fake stream without a wall-clock sleep
+
+
