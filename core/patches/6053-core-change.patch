+
+
+def _home(tmp_path):
+    root = tmp_path / 'hermes'
+    root.mkdir()
+    (root / 'spawn-ledger.json').write_text('[]')
+    os.chmod(root / 'spawn-ledger.json', 0o600)
+    return root
