-"""Fail-closed admission orchestration; deliberately not wired to serve yet.
+"""Fail-closed admission cuts and pre-import enrollment for supported launches.
 
-The host supplies strict collectors and canonical process classification, never
-client-supplied receipts. A COMPLETE cut is scoped to one held gate acquisition;
-there is no persisted clean bit that a successor or boot may reuse. This module
-provides no default permissive collector/classifier and does not start producers.
+Enrollment is positive launch-coverage evidence, NOT guarded readiness. Until a
+broker establishes family custody, enrolled processes remain legacy conflicts.
+A COMPLETE cut is scoped to one held gate acquisition; no persisted clean bit
+can authorize a successor or boot. This module starts no external producers.
 """
 from __future__ import annotations
 
+import hashlib
+import json
 import os
-from dataclasses import dataclass
