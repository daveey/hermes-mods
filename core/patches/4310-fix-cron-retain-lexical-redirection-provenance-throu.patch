diff --git a/cron/lifecycle_guard_words.py b/cron/lifecycle_guard_words.py
new file mode 100644
index 0000000000..0b267c777b
--- /dev/null
+++ b/cron/lifecycle_guard_words.py
@@ -0,0 +1,57 @@
+"""Carry redirection syntax through quote removal without changing argv text."""
+from __future__ import annotations
+
+from collections.abc import Callable
+import re
+
+from cron.lifecycle_guard_groups import split_glued_redirections
+
+
+class ShellWord(str):
+    """A decoded word plus the redirection parsed before quoted punctuation is decoded."""
+
+    redirection: tuple[str, str, str] | None
+
+    def __new__(cls, text: str, redirection: tuple[str, str, str] | None):
+        word = super().__new__(cls, text)
+        word.redirection = redirection
+        return word
+
+
+def redirection_parts(word: str, pattern: re.Pattern[str]) -> tuple[str, str, str] | None:
+    if isinstance(word, ShellWord):
+        return word.redirection
+    match = pattern.match(word)  # Legacy callers supply already lexical redirection words.
+    return (match[1], match[2], match[3]) if match else None
+
+
+def tokenize_redirections(line: str, tokenize: Callable[[str], list[str]],
+                          pattern: re.Pattern[str]) -> list[str]:
+    # Encode the escape character itself too, even outside quotes. A one-pass
+    # decode cannot confuse literal fragments joined by quote removal with syntax.
+    marker = "\ue000"
+    alphabet = "<>&|" + marker
+    replacements = {ch: f"{marker}{index}{marker}" for index, ch in enumerate(alphabet)}
+    protected: list[str] = []
+    single = double = escaped = False
+    for ch in line:
+        literal = single or double or escaped
+        if escaped:
+            escaped = False
+        elif ch == "\\" and not single:
+            escaped = True
+        elif ch == "'" and not double:
+            single = not single
+        elif ch == '"' and not single:
+            double = not double
+        protected.append(replacements.get(ch, ch) if literal or ch == marker else ch)
+
+    def restore(text: str) -> str:
+        return re.sub(marker + r"([0-4])" + marker, lambda m: alphabet[int(m[1])], text)
+
+    words: list[str] = []
+    for token in tokenize(split_glued_redirections("".join(protected))):
+        match = pattern.match(token)
+        parts = (restore(match[1]), restore(match[2]), restore(match[3])) if match else None
+        words.append(ShellWord(restore(token), parts))
+    return words
diff --git a/tests/cron/test_lifecycle_guard_quoted_redirections.py b/tests/cron/test_lifecycle_guard_quoted_redirections.py
new file mode 100644
index 0000000000..43702abe3d
--- /dev/null
+++ b/tests/cron/test_lifecycle_guard_quoted_redirections.py
@@ -0,0 +1,69 @@
+"""Quoted argv must not overwrite the provenance of real stdin redirections."""
+import subprocess
+
+import pytest
+
+from cron.lifecycle_guard import _iter_command_token_lists, _split_redirections, scan_gateway_lifecycle
+
+
+ARGV = ["'0<&-'", "'0>out'", "'0<clean'", r"0\<\&-"]
+
+
+@pytest.mark.parametrize("argument", ARGV)
+@pytest.mark.parametrize("dangerous", [True, False])
+def test_quoted_redirection_argument_keeps_stdin(tmp_path, argument, dangerous):
+    script = tmp_path / "r.sh"
+    script.write_text(" ".join(["hermes", "gateway", "restart"]) + "\n"
+                      if dangerous else "echo harmless\n", encoding="utf-8")
+    (tmp_path / "clean").write_text("echo clean\n", encoding="utf-8")
+    assert scan_gateway_lifecycle(f"bash -s <{script} {argument}", cwd=str(tmp_path)) == (dangerous, None)
+
+
+@pytest.mark.parametrize("argument", ARGV)
+def test_real_bash_quoted_redirection_argument_executes_stdin(tmp_path, argument):
+    # Only a harmless marker is executed, never a lifecycle command.
+    (tmp_path / "r.sh").write_text("printf 'STDIN_EXECUTED\\n'\n", encoding="utf-8")
+    (tmp_path / "clean").write_text("echo clean\n", encoding="utf-8")
+    result = subprocess.run(["bash", "--noprofile", "--norc", "-c", f"bash -s <r.sh {argument}"],
+                            cwd=tmp_path, capture_output=True, text=True, encoding="utf-8", timeout=5, check=False)
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == "STDIN_EXECUTED\n"
+    assert not (tmp_path / "out").exists()
+
+
+@pytest.mark.parametrize("source, kept, stdin", [
+    ("<bad '0<&-'", ["0<&-"], ["bad"]),
+    ('<bad "0<&-"', ["0<&-"], ["bad"]),
+    (r"<bad 0\<\&-", ["0<&-"], ["bad"]),
+    ("<bad 0'<'\"&-\"", ["0<&-"], ["bad"]),
+    ("<bad 0<&-", [], []),
+    ("<bad 0>out", [], []),
+    ("<bad 0<clean", [], ["clean"]),
+    ("<bad 0<'&-'", [], ["&-"]),
+    (r"<bad 0<\&-", [], ["&-"]),
+    ("3<bad 4>&3- <&4", [], ["bad"]),
+    ("3<bad '4>&3-' <&3", ["4>&3-"], ["bad"]),
+    ("<'0<clean'", [], ["0<clean"]),
+    ("< '\ue0000\ue000'", [], ["\ue0000\ue000"]),
+])
+def test_lexical_redirection_parts(source, kept, stdin):
+    tokens, = _iter_command_token_lists(source)
+    assert _split_redirections(tokens) == (kept, stdin)
+
+
+@pytest.mark.parametrize("name", ["0<clean", "\ue0000\ue000", "\ue000\ue0001\ue000\ue000"])
+@pytest.mark.parametrize("dangerous", [True, False])
+def test_quoted_input_filename_preserved(tmp_path, name, dangerous):
+    (tmp_path / name).write_text(" ".join(["hermes", "gateway", "restart"]) + "\n"
+                                 if dangerous else "echo harmless\n", encoding="utf-8")
+    assert scan_gateway_lifecycle(f"bash <'{name}'", cwd=str(tmp_path)) == (dangerous, None)
+
+
+@pytest.mark.parametrize("spelling", ["\ue0000\ue000", "\ue000''0\ue000", "\ue000''\ue0000\ue000''\ue000"])
+@pytest.mark.parametrize("literal_dangerous", [True, False])
+def test_quote_fragment_marker_collision(tmp_path, spelling, literal_dangerous):
+    literal = spelling.replace("'", "")
+    bad = " ".join(["hermes", "gateway", "restart"]) + "\n"
+    for name, dangerous in [(literal, literal_dangerous), ("<", not literal_dangerous)]:
+        (tmp_path / name).write_text(bad if dangerous else "echo harmless\n", encoding="utf-8")
+    assert scan_gateway_lifecycle(f"bash <{spelling}", cwd=str(tmp_path)) == (literal_dangerous, None)
