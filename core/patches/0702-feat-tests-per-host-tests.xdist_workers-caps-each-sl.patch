From 175f5c0e57983664b8bb49bce63aef7164cea46a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 02:41:47 -0700
Subject: [PATCH] feat(tests): per-host tests.xdist_workers caps each slot
 holder's xdist workers below cores // slots [daveey]

---
 scripts/run_tests_host_slots.py            | 19 +++++++++-----
 tests/scripts/test_run_tests_host_slots.py | 29 +++++++++++++++++++++-
 2 files changed, 41 insertions(+), 7 deletions(-)

diff --git a/scripts/run_tests_host_slots.py b/scripts/run_tests_host_slots.py
index fc26a1895f..5f0e25362e 100644
--- a/scripts/run_tests_host_slots.py
+++ b/scripts/run_tests_host_slots.py
@@ -30,8 +30,8 @@ HELD_ENV = "HERMES_TEST_SLOT_HELD"
 POLL_S = 0.1
 
 
-def _config_slots() -> int | None:
-    """Per-host ``tests.host_slots`` from the Hermes config (``HERMES_TEST_SLOT_CONFIG`` overrides the path).
+def _config_int(key: str) -> int | None:
+    """Per-host ``tests.<key>`` integer from the Hermes config (``HERMES_TEST_SLOT_CONFIG`` overrides the path).
 
     A laptop the user works on caps the tests every agent runs on it without restarting anything that
     would have to inherit an env var. [daveey]
@@ -45,9 +45,9 @@ def _config_slots() -> int | None:
     try:
         import yaml
 
-        value = ((yaml.safe_load(text) or {}).get("tests") or {}).get("host_slots")
+        value = ((yaml.safe_load(text) or {}).get("tests") or {}).get(key)
     except Exception:  # no PyYAML in this interpreter, or a config it cannot parse: read the one key
-        m = re.search(r"^tests:[ \t]*\n(?:[ \t]+.*\n|[ \t]*\n)*?[ \t]+host_slots:[ \t]*(\d+)", text, re.MULTILINE)
+        m = re.search(r"^tests:[ \t]*\n(?:[ \t]+.*\n|[ \t]*\n)*?[ \t]+" + re.escape(key) + r":[ \t]*(\d+)", text, re.MULTILINE)
         value = m.group(1) if m else None
     try:
         return max(0, int(value)) if value is not None and not isinstance(value, bool) else None
@@ -55,6 +55,10 @@ def _config_slots() -> int | None:
         return None
 
 
+def _config_slots() -> int | None:
+    return _config_int("host_slots")
+
+
 def host_slot_count() -> int:
     """``HERMES_TEST_HOST_SLOTS`` env, else the host's ``tests.host_slots`` config, else ``os.cpu_count()``."""
     raw = os.environ.get("HERMES_TEST_HOST_SLOTS", "").strip()
@@ -70,7 +74,8 @@ def host_slot_count() -> int:
 
 
 def xdist_worker_budget() -> int:
-    """Max xdist workers one slot holder may start: ``HERMES_TEST_XDIST_MAX``, else cpu_count // host slots.
+    """Max xdist workers one slot holder may start: ``HERMES_TEST_XDIST_MAX``, else cpu_count // host slots,
+    lowered by the host's ``tests.xdist_workers`` config when set.
 
     A direct ``pytest -n 8`` session holds ONE host slot but runs 8 workers, so four slot holders on a
     16-core Mac ran 32+ workers and the load average passed 100 (ready Kanban cards then sat unclaimed).
@@ -83,7 +88,9 @@ def xdist_worker_budget() -> int:
         except ValueError:
             pass
     cores = os.cpu_count() or 4
-    return max(1, cores // max(1, host_slot_count()))
+    share = max(1, cores // max(1, host_slot_count()))
+    configured = _config_int("xdist_workers")  # per-host: a laptop caps workers below its share, never above
+    return max(1, min(share, configured)) if configured is not None else share
 
 
 def host_slot_dir() -> str:
diff --git a/tests/scripts/test_run_tests_host_slots.py b/tests/scripts/test_run_tests_host_slots.py
index a48dfc4456..61201ac8d6 100644
--- a/tests/scripts/test_run_tests_host_slots.py
+++ b/tests/scripts/test_run_tests_host_slots.py
@@ -185,8 +185,9 @@ def test_direct_pytest_run_holds_a_slot_for_its_session(slot_env, monkeypatch, t
                 p.kill()
 
 
-def test_xdist_worker_budget_is_cores_over_slots(monkeypatch):
+def test_xdist_worker_budget_is_cores_over_slots(monkeypatch, tmp_path):
     monkeypatch.delenv("HERMES_TEST_XDIST_MAX", raising=False)
+    monkeypatch.setenv("HERMES_TEST_SLOT_CONFIG", str(tmp_path / "absent.yaml"))
     monkeypatch.setenv("HERMES_TEST_HOST_SLOTS", "4")
     monkeypatch.setattr(slots.os, "cpu_count", lambda: 16)
     assert slots.xdist_worker_budget() == 4
@@ -196,6 +197,32 @@ def test_xdist_worker_budget_is_cores_over_slots(monkeypatch):
     assert slots.xdist_worker_budget() == 3, "the env override wins"
 
 
+def test_host_config_sets_the_xdist_worker_budget(tmp_path, monkeypatch):
+    """A laptop caps each holder's workers below cores // slots: tests/hermes_cli spawns ~15 processes/s per worker."""
+    cfg = tmp_path / "config.yaml"
+    cfg.write_text("tests:\n  host_slots: 4\n  xdist_workers: 2\n")
+    monkeypatch.setenv("HERMES_TEST_SLOT_CONFIG", str(cfg))
+    monkeypatch.delenv("HERMES_TEST_HOST_SLOTS", raising=False)
+    monkeypatch.delenv("HERMES_TEST_XDIST_MAX", raising=False)
+    monkeypatch.setattr(slots.os, "cpu_count", lambda: 16)
+    assert slots.xdist_worker_budget() == 2, "config caps below cores // slots (4)"
+    monkeypatch.setenv("HERMES_TEST_XDIST_MAX", "3")
+    assert slots.xdist_worker_budget() == 3, "env still wins"
+    monkeypatch.delenv("HERMES_TEST_XDIST_MAX")
+    cfg.write_text("tests:\n  host_slots: 4\n")
+    assert slots.xdist_worker_budget() == 4, "unset keeps cores // slots"
+    cfg.write_text("tests:\n  host_slots: 4\n  xdist_workers: 9\n")
+    assert slots.xdist_worker_budget() == 4, "config never raises above cores // slots"
+
+
+def test_host_config_xdist_workers_parses_without_pyyaml(tmp_path, monkeypatch):
+    cfg = tmp_path / "config.yaml"
+    cfg.write_text("tests:\n  host_slots: 4\n  xdist_workers: 2\n")
+    monkeypatch.setenv("HERMES_TEST_SLOT_CONFIG", str(cfg))
+    monkeypatch.setitem(sys.modules, "yaml", None)  # import yaml -> ImportError
+    assert slots._config_int("xdist_workers") == 2
+
+
 def test_direct_pytest_n8_is_capped_to_the_slot_budget(tmp_path):
     """A direct `pytest -n 8` session holds one slot, so it may start only its share of the cores."""
     pytest.importorskip("xdist")
-- 
