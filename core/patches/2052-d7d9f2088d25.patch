From d7d9f2088d25c7486ca8526d2aca2afc55659122 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 8 Nov 2026 12:22:16 +0000
Subject: [PATCH] test(e2e): report owned processes on TUI startup timeout
 [daveey]

---
 tests/e2e/core/terminal/_pty.py               |  8 +++--
 .../terminal/test_pty_process_lifecycle.py    | 30 +++++++++++++++++++
 tests/e2e/core/tui_pty/_helpers.py            |  3 +-
 3 files changed, 38 insertions(+), 3 deletions(-)

diff --git a/tests/e2e/core/terminal/_pty.py b/tests/e2e/core/terminal/_pty.py
index e8575810cf9..abf099c57c8 100644
--- a/tests/e2e/core/terminal/_pty.py
+++ b/tests/e2e/core/terminal/_pty.py
@@ -252,8 +252,12 @@ class PtyHermes:
         deadline = time.monotonic() + timeout
         while True:
             remaining = max(1.0, deadline - time.monotonic())
-            poll(lambda: self._dead() or self._raw_mode(), timeout=remaining,
-                 what="the UI to take the terminal (raw mode)")
+            try:
+                poll(lambda: self._dead() or self._raw_mode(), timeout=remaining,
+                     what="the UI to take the terminal (raw mode)")
+            except AssertionError as exc:
+                members = {pid: cmdline(pid) for pid in session_members(self.sid)}
+                raise AssertionError(f"{exc}\n--- screen ---\n{self.dump()}\n--- processes ---\n{members}") from None
             assert self.proc.poll() is None, f"hermes exited ({self.proc.returncode}) during startup\n{self.dump()}"
             self.wait_quiet(1.0, timeout=max(1.0, deadline - time.monotonic()))
             if self._raw_mode():
diff --git a/tests/e2e/core/terminal/test_pty_process_lifecycle.py b/tests/e2e/core/terminal/test_pty_process_lifecycle.py
index e425e520073..f55a7882bf5 100644
--- a/tests/e2e/core/terminal/test_pty_process_lifecycle.py
+++ b/tests/e2e/core/terminal/test_pty_process_lifecycle.py
@@ -55,3 +55,33 @@ def test_exit_inventory_never_exempts_gateway_or_supervisor(monkeypatch):
     leftovers = term.leftover_processes(timeout=0)
     assert any(line.startswith(f"{gateway}:") for line in leftovers)
     assert any(line.startswith(f"{supervisor}:") for line in leftovers)
+
+
+@pytest.mark.parametrize("surface", ["pty", "tmux"])
+def test_startup_timeout_reports_screen_and_owned_processes(monkeypatch, surface):
+    from tests.e2e.core.tui_pty import _helpers
+
+    module = _pty if surface == "pty" else _helpers
+    if surface == "pty":
+        term = object.__new__(_pty.PtyHermes)
+        term.sid = 42000
+        wait = term.wait_ready
+    else:
+        term = object.__new__(_helpers.TmuxTui)
+        term.pane_pid = 42000
+        wait = term.wait_raw
+    monkeypatch.setattr(term, "dump", lambda: "startup screen")
+    monkeypatch.setattr(module, "session_members", lambda sid: [sid, 42001])
+    monkeypatch.setattr(module, "cmdline", lambda pid: f"owned-child-{pid}")
+
+    def timeout(*args, **kwargs):
+        raise AssertionError("raw mode deadline")
+
+    monkeypatch.setattr(module, "poll", timeout)
+    with pytest.raises(AssertionError) as error:
+        wait()
+    message = str(error.value)
+    assert "raw mode deadline" in message
+    assert "startup screen" in message
+    assert "owned-child-42000" in message
+    assert "owned-child-42001" in message
diff --git a/tests/e2e/core/tui_pty/_helpers.py b/tests/e2e/core/tui_pty/_helpers.py
index 15ab54a0cf4..b16bce4b923 100644
--- a/tests/e2e/core/tui_pty/_helpers.py
+++ b/tests/e2e/core/tui_pty/_helpers.py
@@ -394,7 +394,8 @@ class TmuxTui:
             poll(lambda: not self.alive() or self._raw_mode(), timeout=timeout,
                  what="the TUI to take the terminal (raw mode)")
         except AssertionError as exc:
-            raise AssertionError(f"{exc}\n{self.dump()}") from None
+            members = {pid: cmdline(pid) for pid in session_members(self.pane_pid)}
+            raise AssertionError(f"{exc}\n--- screen ---\n{self.dump()}\n--- processes ---\n{members}") from None
         state = self.pane_state()
         assert state.startswith("0 "), (
             f"hermes --tui exited during startup (pane_dead pid status={state!r}, "
-- 
2.55.0

