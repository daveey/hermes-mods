From 28efea77017010d93bc93842c28668c37ece35b4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 12:08:28 +0000
Subject: [PATCH] [daveey] kanban: disregard recovered pin wall history before
 rerouting

---
 hermes_cli/kanban_pin_reroute.py              | 12 ++-
 .../test_kanban_pin_history_recovery.py       | 91 +++++++++++++++++++
 2 files changed, 101 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_pin_history_recovery.py

diff --git a/hermes_cli/kanban_pin_reroute.py b/hermes_cli/kanban_pin_reroute.py
index 80f2196b22bdb8b746fa4fdc4b198d5e02235d30..33502ac346aa9ee725ed14ab4bcb6c878d6577cb 100644
--- a/hermes_cli/kanban_pin_reroute.py
+++ b/hermes_cli/kanban_pin_reroute.py
@@ -22,6 +22,8 @@ Rule (:func:`pinned_route`); every condition must hold, anything else keeps the
 
 Rule 1 reads the card's history, not only the live episode: a rerouted run that ends (continued,
 reclaimed, blocked) closes the episode, and the next run must not go back into a wall the card knows.
+Historical pin evidence is ignored when a positive live pool read proves room for that exact model;
+unknown pool state retains it. Current episode, provider-file and live quota walls still count.
 
 The reroute lives on the in-memory claimed task only: the row's pin is never written, so the first
 run after the reset goes back to the pin. Every rerouted admission records a ``model_reroute`` event;
@@ -155,12 +157,18 @@ def pinned_route(conn: Any, task: Any, *, lane: str, now: float, cfg: Optional[d
     pin's own provider counts as the card's (rule 1); on any other provider it only rules peers out.
     Non-allocating: reads config and the credential pool and writes nothing, so preview and admission
     decide alike."""
-    from hermes_cli.kanban_provider_walls import active_walls
+    from hermes_cli.kanban_provider_walls import active_walls, live_quota_room
     pinned = pin(task)
     if lane == "review" or pinned is None or is_mandatory_pin(task):
         return None
     model, provider = pinned
-    own = _with_known_wall(own_walls(conn, task.id, now, current), pinned, now)
+    own = own_walls(conn, task.id, now, current)
+    # History survives episode closure and provider-file pruning. A future receipt deadline is not
+    # a live wall when this pool positively serves the pin; unknown pool state proves nothing.
+    # Keep the episode caller's current walls and fold current provider/live evidence back in below.
+    if provider in own and provider not in (current or {}) and live_quota_room(provider, model):
+        own.pop(provider)
+    own = _with_known_wall(own, pinned, now)
     if provider not in own or own[provider][0] - now < min_wall_seconds(cfg):
         return None
     return peer_route(task, model, {**active_walls(now=now), **{name: wall[0] for name, wall in own.items()}})
diff --git a/tests/hermes_cli/test_kanban_pin_history_recovery.py b/tests/hermes_cli/test_kanban_pin_history_recovery.py
new file mode 100644
index 0000000000000000000000000000000000000000..199b3374322f4c3a5ec8eb6962ec99ffc43eb241
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_pin_history_recovery.py
@@ -0,0 +1,91 @@
+"""Historical pin-wall receipts are not live quota evidence after pool recovery."""
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_llm_pacing_dispatch as lpd
+from hermes_cli import kanban_pin_reroute as pr
+from hermes_cli import kanban_provider_walls as walls
+from tests.hermes_cli import test_kanban_model_tier_paced_reroute as pacing
+from tests.hermes_cli import test_kanban_pin_reroute as pins
+from tests.hermes_cli import test_kanban_quota_episode as quota
+
+board = quota.board
+clock = pacing.clock
+
+
+def _history(conn, tid, kind, until):
+    payload = ({'walled_provider': pins.PIN[1], 'resets_at': until, 'episode_id': 213}
+               if kind == 'model_reroute' else
+               {'provider': pins.PIN[1], 'until': until, 'episode_id': 213})
+    kb._append_event(conn, tid, kind, payload)
+    conn.commit()
+
+
+@pytest.mark.parametrize('kind', ['model_reroute', 'quota_episode'])
+@pytest.mark.parametrize('peer_held', [False, True])
+def test_recovered_pin_ignores_historical_wall(board, clock, monkeypatch, all_assignees_spawnable,
+                                             kind, peer_held):
+    pins._deep(monkeypatch)
+    pacing._pools(clock, openai_codex=('paced', None),
+                  anthropic=('held' if peer_held else 'paced', pacing.HELD_FAR))
+    calls = []
+
+    def room(provider, model):
+        calls.append((model, provider))
+        return (model, provider) == pins.PIN
+
+    monkeypatch.setattr(walls, 'live_quota_room', room)
+    with kbc.connect() as conn:
+        tid = pins._pinned_card(conn)
+        _history(conn, tid, kind, clock[0] + pacing.HELD_FAR)
+        before = conn.total_changes
+        assert pacing._route(conn, tid) == (None, None, 'pinned')  # keep the row's explicit pin
+        assert conn.total_changes == before
+        assert lpd.candidate_providers(conn, kb.get_task(conn, tid), 'ready') == [pins.PIN[1]]
+        assert pins._tick(conn) == [pins.PIN]
+        assert pins.PIN in calls
+        assert len(pins._events(conn, tid, kind)) == 1
+        assert pins._events(conn, tid, 'run_route')[-1]['tier_reason'] == 'pinned'
+
+
+@pytest.mark.parametrize('live_evidence', ['unknown', 'wall', 'current', 'provider_file'])
+def test_history_is_retained_without_recovery_or_with_current_wall(board, clock, monkeypatch, live_evidence):
+    _, cfg = pins._deep(monkeypatch)
+    until = clock[0] + pacing.HELD_FAR
+    monkeypatch.setattr(walls, 'live_quota_room', lambda *_: live_evidence != 'unknown')
+    if live_evidence == 'wall':
+        monkeypatch.setattr(walls, 'live_quota_wall', lambda p, m: until if (m, p) == pins.PIN else None)
+    if live_evidence == 'provider_file':
+        monkeypatch.setattr(walls, 'active_walls', lambda **_: {pins.PIN[1]: until})
+    with kbc.connect() as conn:
+        tid = pins._pinned_card(conn)
+        _history(conn, tid, 'model_reroute', until)
+        current = {pins.PIN[1]: until} if live_evidence == 'current' else None
+        assert pr.pinned_route(conn, kb.get_task(conn, tid), lane='ready', now=clock[0],
+                               cfg=cfg, current=current) == pins.PEER
+
+
+def test_no_history_needs_no_recovery_read(board, clock, monkeypatch):
+    _, cfg = pins._deep(monkeypatch)
+
+    def unexpected(*_):
+        pytest.fail('No historical pin wall needs a recovery probe')
+
+    monkeypatch.setattr(walls, 'live_quota_room', unexpected)
+    with kbc.connect() as conn:
+        tid = pins._pinned_card(conn)
+        assert pr.pinned_route(conn, kb.get_task(conn, tid), lane='ready', now=clock[0], cfg=cfg) is None
+
+
+def test_unreadable_pool_does_not_disprove_history(board, clock, monkeypatch):
+    _, cfg = pins._deep(monkeypatch)
+
+    def unreadable(_provider):
+        raise OSError('pool read failed')
+
+    monkeypatch.setattr(walls, '_oauth_pool', unreadable)
+    with kbc.connect() as conn:
+        tid = pins._pinned_card(conn)
+        _history(conn, tid, 'model_reroute', clock[0] + pacing.HELD_FAR)
+        assert pr.pinned_route(conn, kb.get_task(conn, tid), lane='ready', now=clock[0], cfg=cfg) == pins.PEER
