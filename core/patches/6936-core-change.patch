Subject: [PATCH 6936] File-descriptor headroom guard and incident reporting

Public mirror of source commit 0d795087625f2636a21d9b1863121f253c7e1187.

---
diff --git a/hermes_cli/fd_headroom_incident.py b/hermes_cli/fd_headroom_incident.py
index ed04c1ec2fdfe962b6f2a87551092f4967c5c710..4ad2b36dedcf9b91a032c61b4b827d18f76d0389 100644
--- a/hermes_cli/fd_headroom_incident.py
+++ b/hermes_cli/fd_headroom_incident.py
@@ -143,6 +143,11 @@
                     state['terminal_rearmed_by'] = (list(dict.fromkeys([*rearmed, producer])))[-64:]
                     state['terminal_rearmed'] = True  # Legacy diagnostic, not authority.
                 if not sample.get('triggered') or producer not in rearmed:
+                    # A successful local write supersedes any earlier storage fault,
+                    # not the immutable rejection. A current fault still hits except.
+                    terminal = state['terminal']
+                    state.update(error=str(TerminalRequest(terminal['state'], terminal['result']))[:1000],
+                                 error_class='TerminalRequest')
                     _save(path, state)
                     return state  # No identity/transport I/O after a definitive receipt.
                 state['last_terminal'] = {'envelope': state['envelope'], 'receipt': state['terminal']}
diff --git a/tests/hermes_cli/test_fd_headroom_terminal_health.py b/tests/hermes_cli/test_fd_headroom_terminal_health.py
index e107e3ee51c1c14a219a2da0049d84cd4c796723..a34aad108a14a44865c9666bbae20ea72df62be7 100644
--- a/tests/hermes_cli/test_fd_headroom_terminal_health.py
+++ b/tests/hermes_cli/test_fd_headroom_terminal_health.py
@@ -96,6 +96,57 @@
     assert calls == ['GET']
 
 
+@pytest.mark.parametrize('restart', [False, True])
+@pytest.mark.parametrize('probe', [False, True])
+def test_transient_save_error_clears_after_storage_recovers(checker, monkeypatch, caplog, restart, probe):
+    check, calls = checker
+    first = check(600, 0, probe)
+    path = incidents._path(first, probe)
+    frozen = json.loads(path.read_text())
+    real_save = incidents._save
+    failures = [1]
+    def flaky(path, state):
+        if failures[0]:
+            failures[0] -= 1
+            raise OSError(28, 'fixture transient full disk')
+        return real_save(path, state)
+    monkeypatch.setattr(incidents, '_save', flaky)
+    check(100, 300, probe)
+    failed = json.loads(path.read_text())
+    assert failed['error_class'] == 'OSError'
+    assert limits.fd_headroom_status()['create_state'] == 'failing'
+    if restart:
+        limits._fd_incident = {}
+        limits._fd_status.clear()
+        limits._fd_samples.clear()
+        limits._fd_last_check = None
+        monkeypatch.setattr(incidents, '_producer_token', None)
+    caplog.clear()
+    with caplog.at_level(logging.WARNING):
+        for tick in range(2, 38):
+            sample = check(100, tick * 300, probe)
+            assert sample['count'] == 100
+            status = limits.fd_headroom_status()
+            assert status['create_state'] == 'ok'
+            assert status['error_class'] is None and status['failing_since'] is None
+    assert not caplog.records
+    current = json.loads(path.read_text())
+    assert current['terminal'] == frozen['terminal']
+    assert current['envelope'] == frozen['envelope']
+    assert current['error_class'] == 'TerminalRequest'
+    assert current['error'] == frozen['error']
+    assert current['failing_since'] == frozen['failing_since']
+    assert calls == ['GET']
+    monkeypatch.setattr(incidents, '_producer_token', None)
+    with caplog.at_level(logging.WARNING):
+        sample = check(600, 12000, probe)
+    assert sample['triggered']
+    assert limits.fd_headroom_status()['create_state'] == 'failing'
+    assert limits.fd_headroom_status()['error_class'] == 'TerminalRequest'
+    assert 'card create failing since' in caplog.text
+    assert calls == ['GET'], 'recovered history must remain latched for an unqualified birth'
+
+
 @pytest.mark.parametrize('probe', [False, True])
 def test_unreadable_discovery_preserves_healthy_sample(checker, probe):
     check, calls = checker
