From 0a91e5a5cd2c6a7a394cc3fe715c420b5e1ff6a1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 19:09:05 +0000
Subject: [PATCH] ci(upstream-sync): run all eight Python slices; two slices
 hit tests.yml's 30 min timeout

---
 .github/workflows/upstream-sync.yml    | 6 ++++--
 scripts/ci/upstream_sync.py            | 4 ++--
 tests/hermes_cli/upstream_gate_fake.py | 2 +-
 3 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/.github/workflows/upstream-sync.yml b/.github/workflows/upstream-sync.yml
index b7042e2536..8703d96c92 100644
--- a/.github/workflows/upstream-sync.yml
+++ b/.github/workflows/upstream-sync.yml
@@ -1,7 +1,7 @@
 name: Upstream sync full suite
 
 # The evidence scripts/ci/upstream_sync.py requires before an upstream sync may reach main:
-# the full suite (both Python slices + e2e) on the fork's own self-hosted runners, at exactly
+# the full suite (all eight Python slices + e2e) on the fork's own self-hosted runners, at exactly
 # the candidate's head. The gate stages each candidate on sync/upstream-<sha>; nothing else
 # should push these branches.
 on:
@@ -25,6 +25,8 @@ jobs:
     with:
       commit: ${{ github.sha }}
       python_changed: ''
-      python_slices: '[1, 2]'
+      # tests.yml's 30 min job timeout is sized for 8 slices; two slices (~45 min each) were
+      # cancelled at the timeout on every candidate.
+      python_slices: '[1, 2, 3, 4, 5, 6, 7, 8]'
       e2e: true
       e2e_upgrade: false
diff --git a/scripts/ci/upstream_sync.py b/scripts/ci/upstream_sync.py
index 032cc992fb..d4ad1270c9 100644
--- a/scripts/ci/upstream_sync.py
+++ b/scripts/ci/upstream_sync.py
@@ -6,7 +6,7 @@
 
 A candidate X (a commit that brings upstream/main commits into the fork) is pushed to its own
 branch ``sync/upstream-<X>``. ``.github/workflows/upstream-sync.yml`` runs the full suite there
-(both Python slices and e2e, self-hosted, never cancelled by main's concurrency). Only an X whose
+(all eight Python slices and e2e, self-hosted, never cancelled by main's concurrency). Only an X whose
 run completed green, with every required job succeeding on a self-hosted runner at exactly X, is
 landed through a pull request from that same branch. main is protected for admins too: GitHub
 refuses any direct push whose exact sha lacks a green "All required checks pass (v2)" (ci.yaml).
@@ -45,7 +45,7 @@ WORKFLOW_FILE = "upstream-sync.yml"
 WORKFLOW_PATH = f".github/workflows/{WORKFLOW_FILE}"
 BRANCH_PREFIX = "sync/upstream-"
 # The job names tests.yml gives the full suite (called as job "Full suite"); all must succeed.
-REQUIRED_JOBS = ("Run tests (1/2)", "Run tests (2/2)", "e2e")
+REQUIRED_JOBS = (*(f"Run tests ({n}/8)" for n in range(1, 9)), "e2e")
 RED_BACKOFF_S = 6 * 3600
 STALE_PENDING_S = 6 * 3600  # a run queued this long never got runners: it no longer holds the slot
 # Set on the gate's own pushes; the pre-push guard lets exactly those through.
diff --git a/tests/hermes_cli/upstream_gate_fake.py b/tests/hermes_cli/upstream_gate_fake.py
index 73c69bee61..bf75027900 100644
--- a/tests/hermes_cli/upstream_gate_fake.py
+++ b/tests/hermes_cli/upstream_gate_fake.py
@@ -61,7 +61,7 @@ if "/jobs" in endpoint:
     run = next(r for r in runs if f"/runs/{{r['id']}}/jobs" in endpoint)
     jobs = [{{"name": "Full suite / " + n, "status": "completed", "conclusion": run["conclusion"],
               "labels": ["self-hosted", "hermes-hub"], "runner_name": "hub-1"}}
-            for n in ("Run tests (1/2)", "Run tests (2/2)", "e2e")]
+            for n in [f"Run tests ({{i}}/8)" for i in range(1, 9)] + ["e2e"]]
     print(json.dumps([{{"jobs": jobs}}]))
 elif "/pulls?" in endpoint:
     branch = endpoint.split("head=", 1)[1].split("&", 1)[0].split(":", 1)[1]
-- 
2.54.0 (Apple Git-157)

