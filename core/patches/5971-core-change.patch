From 36406c0ee007403f82f59aecfb933f3506c61156 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 19:07:58 +0000
Subject: [PATCH 5971] Kanban scratch archive: foreign ownership, retention and promisor clones

Public mirror of source commit 36406c0ee007403f82f59aecfb933f3506c61156.

---
diff --git a/tests/hermes_cli/test_kanban_scratch_archive_ownership.py b/tests/hermes_cli/test_kanban_scratch_archive_ownership.py
index b54474331fc..5655259b070 100644
--- a/tests/hermes_cli/test_kanban_scratch_archive_ownership.py
+++ b/tests/hermes_cli/test_kanban_scratch_archive_ownership.py
@@ -369,13 +369,17 @@
     _tid, path = base._plain_task(_root_owned_locked_tree)
     real_txn = kb.write_txn
 
+    reached = []
+
     def txn(conn):
         if any(f.function == "owner_unchanged" for f in inspect.stack()[1:4]):
+            reached.append(True)
             raise sqlite3.OperationalError("database is locked")
         return real_txn(conn)
     monkeypatch.setattr(kb, "write_txn", txn)
     try:
         assert base._gc() == 0  # the pass completes
+        assert reached  # the GC re-check ran and its error became a refusal
         assert path.exists() and os.lstat(path / "rootfs" / "etc" / "shadow").st_uid == 0
     finally:
         _cleanup(path)
@@ -446,13 +450,17 @@
     path = _custody_tree(env)
     real_txn = kb.write_txn
 
+    reached = []
+
     def txn(conn):
         if _from_owner_unchanged():
+            reached.append(True)
             raise sqlite3.OperationalError("database is locked")
         return real_txn(conn)
     monkeypatch.setattr(kb, "write_txn", txn)
     try:
         assert gc.gc_task_scratch(env.conn, older_than_days=7) == 0
+        assert reached  # the custody re-check ran and its error became a refusal
         assert path.exists() and os.lstat(path / "rootfs" / "etc" / "shadow").st_uid == 0
     finally:
         _cleanup(path)
