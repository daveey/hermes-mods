@@ -58,6 +68,8 @@ def test_held_orphan_is_kept(tmp_path):
                       runtime / "pm-runtime" / "generations" / "gen" / ".leases"):
         lease_dir.mkdir(parents=True)
         fds.append(os.open(lease_dir / "reader", os.O_CREAT | os.O_RDWR, 0o600))
