@@ -76,10 +88,12 @@ def test_partly_removed_orphan_keeps_its_record_until_retried(tmp_path):
     state = _state(installs, "aaaa", tmp_path / "gone")
     stuck = state / "environments" / "gen" / "venv"
     (stuck / "pyvenv.cfg").write_text("", encoding="utf-8")
