Subject: [PATCH 6610] Annotation holder counts custody and read sharing

Public mirror of source commit 2c7d3ae1deb040f16c8105846483274eb41be86d.

---
diff --git a/hermes_cli/kanban_session_activity_timers.py b/hermes_cli/kanban_session_activity_timers.py
index 8ab9f3b4389757f4aa6c4795bdf7bac44bea112c..867a5b19aec18eefa598fa80c749fdd28bc2a5c1 100644
--- a/hermes_cli/kanban_session_activity_timers.py
+++ b/hermes_cli/kanban_session_activity_timers.py
@@ -26,7 +26,9 @@
     start = ('(SELECT r.started_at FROM task_runs r WHERE r.id = '
              f'{alias}.current_run_id AND r.task_id = {alias}.id)'
              if 'current_run_id' in columns and {'id', 'task_id', 'started_at'} <= runs else 'NULL')
-    blocked = (f"(SELECT MAX(e.created_at) FROM task_events e WHERE e.task_id = {alias}.id AND e.kind = 'blocked')"
+    # Unary + preserves values but disables SQLite's MAX timestamp-index walk:
+    # prefer the selective (kind, task_id) lookup over unrelated newer history.
+    blocked = (f"(SELECT MAX(+e.created_at) FROM task_events e WHERE e.task_id = {alias}.id AND e.kind = 'blocked')"
                if {'task_id', 'kind', 'created_at'} <= events else 'NULL')
     return ', '.join(f'{expression} AS {key}' for key, expression in (
         ('timer_run_start', start), ('timer_block_start', blocked),
diff --git a/tests/hermes_cli/test_kanban_session_activity_timers.py b/tests/hermes_cli/test_kanban_session_activity_timers.py
index 87e43b6b43d634905e1d4c89b840db848be73d4a..487820fb3685f7090e6eac5e979e3f2c4a0319d9 100644
--- a/tests/hermes_cli/test_kanban_session_activity_timers.py
+++ b/tests/hermes_cli/test_kanban_session_activity_timers.py
@@ -136,6 +136,32 @@
     activity._reset_cache_for_tests()
 
 
+@pytest.mark.parametrize('indexed', [True, False])
+def test_block_clock_avoids_unrelated_history_and_preserves_max(db, indexed):
+    for tid in ('a', 'b', 'c'):
+        add(db, tid, 'blocked')
+    db.execute('CREATE INDEX idx_events_task ON task_events(task_id, created_at)')
+    if indexed:
+        db.execute('CREATE INDEX idx_events_kind_task_id ON task_events(kind, task_id, id)')
+    # ID order is not timestamp order; NULL and another task cannot win.
+    db.executemany('INSERT INTO task_events(task_id, kind, created_at) VALUES (?, ?, ?)',
+                   [('a', 'blocked', 190), ('a', 'blocked', 170), ('a', 'blocked', None),
+                    ('b', 'blocked', 210)])
+    db.executemany('INSERT INTO task_events(task_id, kind, created_at) VALUES (?, ?, ?)',
+                   [(tid, 'heartbeat', 1000 + i) for tid in ('a', 'b', 'c') for i in range(3000)])
+    steps = []
+    db.set_progress_handler(lambda: steps.append(1) or 0, 100)
+    try:
+        found = timers.local(db, {('s', tid) for tid in ('a', 'b', 'c')})
+    finally:
+        db.set_progress_handler(None, 0)
+    assert {tid: value['timer_block_start'] for tid, value in found.items()} == {
+        'a': 190, 'b': 210, 'c': None}
+    if indexed:
+        # Count VM work, not flaky wall time or just execute() invocations.
+        assert len(steps) < 50
+
+
 def test_read_failure_and_legacy_columns_never_raise():
     conn = sqlite3.connect(':memory:')
     assert timers.local(conn, {('s', 'a')}) == {}
