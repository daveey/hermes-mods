From 445d82067616e90285fa8500a50c7224e5530a08 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 05:56:02 +0000
Subject: [PATCH 228/248] ci: main pushes share one concurrency group per
 CI/Nix/actionlint workflow: the run in flight finishes, only the newest
 pending push waits (hub runner load) [daveey]

---
 .github/workflows/actionlint.yml | 2 +-
 .github/workflows/ci.yaml        | 7 ++++++-
 .github/workflows/nix.yml        | 4 +++-
 3 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/actionlint.yml b/.github/workflows/actionlint.yml
index 3963a872d2..436a6df473 100644
--- a/.github/workflows/actionlint.yml
+++ b/.github/workflows/actionlint.yml
@@ -24,7 +24,7 @@ permissions:
   contents: read
 
 concurrency:
-  group: actionlint-${{ github.ref == 'refs/heads/main' && github.run_id || github.ref }}
+  group: actionlint-${{ github.ref == 'refs/heads/main' && 'main' || github.ref }}
   cancel-in-progress: ${{ github.event_name == 'pull_request' }}
 
 jobs:
diff --git a/.github/workflows/ci.yaml b/.github/workflows/ci.yaml
index 71e1e11da3..4bf5a1b28f 100644
--- a/.github/workflows/ci.yaml
+++ b/.github/workflows/ci.yaml
@@ -49,8 +49,13 @@ permissions:
 # Release (workflow_call with inputs.release) never cancels and never gets
 # cancelled: its group is github.run_id. PRs collapse per-PR; pushes use the
 # ref as before.
+# fork (daveey/hermes): pushes to main share ONE group (`ci-main`). A run in
+# flight always finishes; while it runs only the NEWEST main push waits (an
+# older pending one is superseded — the newer run tests a tree containing it).
+# A per-run group queued one full suite per push and saturated the shared
+# hermes-hub runners. [daveey]
 concurrency:
-  group: ci-${{ (inputs.release == true || github.ref == 'refs/heads/main') && github.run_id || (github.event_name == 'pull_request' && github.event.pull_request.number || github.ref) }}
+  group: ci-${{ inputs.release == true && github.run_id || github.ref == 'refs/heads/main' && 'main' || (github.event_name == 'pull_request' && github.event.pull_request.number || github.ref) }}
   cancel-in-progress: ${{ inputs.release != true && github.event_name == 'pull_request' }}
 
 jobs:
diff --git a/.github/workflows/nix.yml b/.github/workflows/nix.yml
index c3349fc911..d2f5b157a9 100644
--- a/.github/workflows/nix.yml
+++ b/.github/workflows/nix.yml
@@ -36,8 +36,10 @@ permissions:
 # github.run_id so a parent rerun cannot kill this child mid-flight, and
 # cancel-in-progress is false there — each run saves the store cache that
 # later PRs restore from.
+# fork (daveey/hermes): main pushes share `nix-main` (in-flight run finishes, only the newest
+# pending push waits), as in ci.yaml. [daveey]
 concurrency:
-  group: nix-${{ (inputs.release == true || github.ref == 'refs/heads/main') && github.run_id || github.event.pull_request.number || github.ref }}
+  group: nix-${{ inputs.release == true && github.run_id || github.ref == 'refs/heads/main' && 'main' || github.event.pull_request.number || github.ref }}
   cancel-in-progress: ${{ inputs.release != true && github.event_name == 'pull_request' }}
 
 jobs:
-- 
2.54.0 (Apple Git-157)

