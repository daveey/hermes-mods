From 018c219209a208cb1d3af1a5aa0619c39abe5e18 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 02:53:58 +0000
Subject: [PATCH] fix(kanban): honor operator release before cheap-wall worker
 holds [daveey]

---
 hermes_cli/kanban_shared_blockers.py          | 13 +++++--
 .../test_kanban_shared_blocker_operator.py    | 35 +++++++++++++++++++
 2 files changed, 46 insertions(+), 2 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_shared_blocker_operator.py

diff --git a/hermes_cli/kanban_shared_blockers.py b/hermes_cli/kanban_shared_blockers.py
index 848657204d..0a80edee7b 100644
--- a/hermes_cli/kanban_shared_blockers.py
+++ b/hermes_cli/kanban_shared_blockers.py
@@ -460,7 +460,8 @@ def blocker_for_task(states: dict[str, BlockerState], task_id: str) -> Optional[
     return None
 
 
-def _unblocked_since_assertion(conn: sqlite3.Connection, task_id: str, blocker_id: str) -> bool:
+def _unblocked_since_assertion(conn: sqlite3.Connection, task_id: str, blocker_id: str, *,
+                               own_only: bool = False) -> bool:
     """True when ``task_id`` was unblocked after the newest event asserting ``blocker_id``
     (event ids, not seconds: a bulk unblock and a re-assertion often share a second)."""
     from hermes_cli import kanban_db as kb
@@ -471,9 +472,11 @@ def _unblocked_since_assertion(conn: sqlite3.Connection, task_id: str, blocker_i
     if unblocked is None:
         return False
     for row in conn.execute(
-        "SELECT payload FROM task_events WHERE kind IN ('blocked', 'scheduled', 'continued', 'block_loop_detected') "
+        "SELECT task_id, payload FROM task_events WHERE kind IN ('blocked', 'scheduled', 'continued', 'block_loop_detected') "
         "AND id>=? AND payload LIKE '%\"blocker_id\"%' ORDER BY id DESC", (unblocked,),
     ):
+        if own_only and row["task_id"] != task_id:
+            continue
         if normalize_blocker_id(kb._json_dict(row["payload"]).get("blocker_id")) == blocker_id:
             return False
     return True
@@ -490,6 +493,12 @@ def shared_blocker_guard(
     st = blocker_for_task(states, task_id)
     if st is None or not st.is_open or not task_applies(conn, st, task_id):
         return None
+    from hermes_cli.kanban_shared_blocker_checks import registered_checks
+    if st.blocker_id in registered_checks() and _unblocked_since_assertion(
+            conn, task_id, st.blocker_id, own_only=True):
+        # This wall has an independent dispatcher probe. A peer's long run or
+        # reassertion cannot revoke the operator's explicit release of this card.
+        return None
     others = [t for t in st.behind if t != task_id and task_applies(conn, st, t)]
     if others:
         marks = ",".join("?" * len(others))
diff --git a/tests/hermes_cli/test_kanban_shared_blocker_operator.py b/tests/hermes_cli/test_kanban_shared_blocker_operator.py
new file mode 100644
index 0000000000..e21b1c8f9c
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_shared_blocker_operator.py
@@ -0,0 +1,35 @@
+"""Operator releases and long-running work must not starve cheap-check walls."""
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_shared_blocker_checks as checks
+from hermes_cli import kanban_shared_blockers as blockers
+from tests.hermes_cli import test_kanban_shared_blockers as helpers
+
+kanban_home = helpers.kanban_home
+
+
+def test_operator_unblock_survives_peer_running_and_reassertion(kanban_home, monkeypatch):
+    monkeypatch.setattr(checks, 'registered_checks', lambda cfg=None: {'test-wall': 'exit 1'})
+    with kbc.connect_closing() as conn:
+        target = helpers._blocked_behind(conn, 'target', blocker_id='test-wall')
+        peer = helpers._blocked_behind(conn, 'long landing', blocker_id='test-wall')
+        assert kb.unblock_task(conn, peer) and kb.claim_task(conn, peer)
+        assert kb.unblock_task(conn, target)
+        helpers._blocked_behind(conn, 'another assertion', blocker_id='test-wall')
+        assert blockers.shared_blocker_guard(conn, target) is None
+        # An explicit unblock is consumed by a fresh assertion from this card.
+        assert kb.claim_task(conn, target)
+        assert kb.block_task(conn, target, reason='wall remains', kind='capability', blocker_id='test-wall')
+        assert blockers.shared_blocker_guard(conn, target) == blockers.GUARD_REASON
+
+
+def test_cheap_check_releases_waiter_without_waiting_for_long_run(kanban_home):
+    with kbc.connect_closing() as conn:
+        target = helpers._blocked_behind(conn, 'target', blocker_id='test-wall')
+        peer = helpers._blocked_behind(conn, 'long landing', blocker_id='test-wall')
+        assert kb.unblock_task(conn, peer) and kb.claim_task(conn, peer)
+        now = blockers.blocker_states(conn)['test-wall'].asserted_at + 10
+        assert checks.run_due_checks(conn, cfg={'kanban': {'shared_blocker_checks': {'test-wall': 'exit 0'}}}, now=now) == ['test-wall']
+        assert target in blockers.release_cleared_blockers(conn, now=now)
+        assert kb.get_task(conn, peer).status == 'running'
+        assert blockers.shared_blocker_guard(conn, target, now=now) is None
-- 
