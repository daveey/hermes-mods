From 7993f9bc6be348fc5aa4e903d3c3949cd1dd733a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 20:20:30 -0700
Subject: [PATCH] fix(desktop): ::preview frames read the whole document and
 grow to its height

Problem: an inline ::preview of a 662 KB design board rendered section 0, then
the tail of the injected measurement script as text; nothing after it showed.
Smaller boards taller than 1200 px showed only their first section.

Why 1: the frame's srcdoc was cut at 512 KiB, inside an inlined image's data
  URI, so the appended chrome <script> was parsed as attribute text up to its
  first quote; everything after the cut was lost (hermes:readFileText,
  TEXT_PREVIEW_MAX_BYTES; /api/fs/read-text, _FS_TEXT_PREVIEW_MAX_BYTES).
Why 2: InlinePreviewDirective rendered with readDesktopFileText, the *preview*
  read (skim the head of a file for the right rail), and ignored the
  `truncated: true` it returned.
Why 3: when the same truncation broke runtime plugins, the fix added a
  plugin-only full read (readPluginSource) instead of a full-read mode for
  every caller that renders/evaluates a document; the inline preview sibling
  kept the skim read.
Why 4 (height): MAX_HEIGHT = 1200 clamped every frame; the rest sat behind an
  inner scrollbar inside the transcript, which reads as "only A rendered".
Root: no way to ask for a whole document from the fs bridge, and a renderer
  that silently accepted a truncated one.
Not caught: no test fed the directive a > 512 KiB or > 1200 px document.

Fix:
- readFileText(path, { full: true }) (Electron IPC) and read-text?full=1
  (remote API): whole file up to 16 MiB, EFBIG/413 above it, never truncated.
- readInlineDoc: full read; a result still marked truncated (older shell)
  falls back to the attachment card instead of a broken frame.
- Frame height cap 1200 -> 16000; viewport-coupled pages (100vh + margin)
  are stopped by nextFrameHeight (two equal grow steps = feedback loop)
  instead of by a low ceiling.
Tests: textReadLimits + 700 KB file (electron), readInlineDoc full/truncated/
  error (renderer), desktop-fs local+remote full paths, read-text full=1 and
  413 (python), nextFrameHeight growth/churn/runaway.
---
diff --git a/apps/desktop/electron/hardening.test.ts b/apps/desktop/electron/hardening.test.ts
index 7d70271009d263d64dd4afc5e4a5f8cb6157359e..08c3761bcc62544a6a4fe0296d392e1ff329d018 100644
--- a/apps/desktop/electron/hardening.test.ts
+++ b/apps/desktop/electron/hardening.test.ts
@@ -27,10 +27,40 @@ import {
   SAFE_STORAGE_ENCODING,
   SECRET_FILE_MODE,
   sensitiveFileBlockReason,
+  TEXT_FULL_READ_MAX_BYTES,
+  TEXT_PREVIEW_MAX_BYTES,
+  TEXT_PREVIEW_SOURCE_MAX_BYTES,
+  textReadLimits,
   tightenSecretFileMode,
   writeSecretFileAtomic
 } from './hardening'
 
+// hermes:readFileText — the preview read skims 512 KiB; `{ full: true }` (inline
+// ::preview documents) returns the whole file or rejects it, never a cut one.
+test('textReadLimits: preview skims, full never truncates', async () => {
+  assert.deepEqual(textReadLimits(undefined), {
+    full: false,
+    maxBytes: TEXT_PREVIEW_SOURCE_MAX_BYTES,
+    readLimit: TEXT_PREVIEW_MAX_BYTES
+  })
+  assert.deepEqual(textReadLimits({ full: 'yes' }), textReadLimits(undefined), 'only a literal true opts in')
+
+  const full = textReadLimits({ full: true })
+  assert.equal(full.full, true)
+  assert.equal(full.readLimit, full.maxBytes, 'a full read returns everything it accepts')
+  assert.equal(full.maxBytes, TEXT_FULL_READ_MAX_BYTES)
+  assert.ok(full.readLimit > 5 * 1024 * 1024, 'room for a multi-MB design board')
+
+  // A 700 KB board (the size that broke) is accepted whole and over the cap is rejected outright.
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'hermes-fullread-'))
+  const board = path.join(dir, 'board.html')
+  fs.writeFileSync(board, 'x'.repeat(700 * 1024))
+  const ok = await resolveReadableFileForIpc(board, { maxBytes: full.maxBytes, purpose: 'Full text read' })
+  assert.ok(ok.stat.size <= full.readLimit)
+  await assert.rejects(resolveReadableFileForIpc(board, { maxBytes: 600 * 1024, purpose: 'Full text read' }), /too large/)
+  fs.rmSync(dir, { force: true, recursive: true })
+})
+
 /**
  * Real temp dir per test: the property under test IS the on-disk mode after a
  * temp-file-then-rename, which a mocked fs would assert into existence rather
