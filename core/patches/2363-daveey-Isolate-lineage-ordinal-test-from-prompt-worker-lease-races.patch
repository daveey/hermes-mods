From 3c092567c55e538d2f7cd4986efb20e98af9f910 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:26:49 +0000
Subject: [PATCH] [daveey] Isolate lineage ordinal test from prompt worker
 lease races

Stub worker dispatch, retain real admission and truncation, and assert exactly one dispatch and one DB rewrite across accepted/stale cases. Event-fenced replay reproduces 4090 vs 4030 before fix; 638 file tests and 20 SIGSTOP/SIGCONT repetitions pass without retries.
---
 tests/tui_gateway/test_tui_gateway_server.py | 21 ++++++++++----------
 1 file changed, 10 insertions(+), 11 deletions(-)

diff --git a/tests/tui_gateway/test_tui_gateway_server.py b/tests/tui_gateway/test_tui_gateway_server.py
index f924d3a8bcb..ae806bc718b 100644
--- a/tests/tui_gateway/test_tui_gateway_server.py
+++ b/tests/tui_gateway/test_tui_gateway_server.py
@@ -13991,13 +13991,7 @@ def test_prompt_submit_truncate_oor_includes_structured_user_turn_count(monkeypa
 
 
 def test_prompt_submit_row_id_accepts_full_lineage_ordinal(monkeypatch):
-    """Desktop sends rowId + a full-lineage ordinal; both must agree (#82462).
-
-    After compression the client's visible-user ordinal counts the ancestor
-    prefix turns while the gateway resolves the row id tip-relative. The
-    reconcile cross-check must treat `tip_ordinal + prefix_user_count` as
-    agreement, not #82756 drift — and the cut stays aimed by the row id.
-    """
+    """RowId and full-lineage ordinal agree after compression; stale ordinals still refuse."""
     from agent.context_compressor import (
         HISTORICAL_TASK_HEADING,
         SUMMARY_PREFIX,
@@ -14045,6 +14039,9 @@ def test_prompt_submit_row_id_accepts_full_lineage_ordinal(monkeypatch):
     server._sessions["lineage-row-sid"] = sess
     monkeypatch.setattr(server, "_get_db", lambda: _FakeDB())
     monkeypatch.setattr(server, "_start_agent_build", lambda *a, **k: None)
+    # No real turn: a late worker can reclaim the lease after the first cleanup.
+    start_work = Mock()
+    monkeypatch.setattr(server, "_start_session_work", start_work)
 
     try:
         resp = server.handle_request(
@@ -14064,11 +14061,11 @@ def test_prompt_submit_row_id_accepts_full_lineage_ordinal(monkeypatch):
         )
         assert resp.get("error") is None, f"got error: {resp.get('error')}"
         assert sess["history"] == tip_history[:2]
+        start_work.assert_called_once()
+        assert start_work.call_args.kwargs["session"] is sess
+        assert replaced == [(sess["session_key"], tip_history[:2])]
     finally:
-        # Release the slot the first turn claimed, as _finalize_session does in
-        # production. Popping alone leaks the lease, and the second session below
-        # uses the same session_key -- so without this the test fences itself out
-        # of its own key and never reaches the mismatch it is checking.
+        # Both cases use the same key; release before testing the stale ordinal.
         server._release_active_session_slot(sess)
         server._sessions.pop("lineage-row-sid", None)
 
@@ -14095,6 +14092,8 @@ def test_prompt_submit_row_id_accepts_full_lineage_ordinal(monkeypatch):
         )
         assert resp.get("error") is not None
         assert resp["error"]["code"] == 4030
+        start_work.assert_called_once()  # Refused input must not dispatch another turn.
+        assert replaced == [(sess["session_key"], tip_history[:2])]
     finally:
         server._release_active_session_slot(sess2)
         server._sessions.pop("lineage-row-sid-2", None)
-- 
