From 52189d93d01f31829b0052c3c95c0cded9c724c5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 15:47:58 +0000
Subject: [PATCH] fix(kanban): accept reasonless assignment-block history; read
 block_loop_detected

---
 hermes_cli/kanban_assignment_routing.py         | 11 +++++++----
 .../test_kanban_assignment_routing.py           | 17 ++++++++++++++++-
 2 files changed, 23 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_assignment_routing.py b/hermes_cli/kanban_assignment_routing.py
index cd04febed2..15f9e41830 100644
--- a/hermes_cli/kanban_assignment_routing.py
+++ b/hermes_cli/kanban_assignment_routing.py
@@ -204,7 +204,7 @@ def validate_repair_completion(conn, task_id, *, observation=None):
         original, payloads = resolve(conn, task_id, key, observation)
     else:
         payloads = tuple(row[0] for row in conn.execute(
-            "SELECT payload FROM task_events WHERE task_id=? AND kind='blocked' ORDER BY id DESC",
+            "SELECT payload FROM task_events WHERE task_id=? AND kind IN ('blocked','block_loop_detected') ORDER BY id DESC",
             (original.id,)).fetchall())
     if original.assignee is None:
         raise AssignmentRoutingError('Assignment repair has no assigned original task')
@@ -216,11 +216,14 @@ def validate_repair_completion(conn, task_id, *, observation=None):
         except ValueError:
             continue
         if isinstance(data, dict) and data.get('supervisor_task_id') == task_id:
-            if not isinstance(data.get('reason'), str):
+            reason = data.get('reason')
+            # A reasonless block (CLI/dashboard default) is a supported producer
+            # and asks for no authority; only a non-string reason is malformed.
+            if reason is not None and not isinstance(reason, str):
                 raise AssignmentRoutingError('Assignment repair has invalid authority history')
-            needs = execution_authority_need(original.id, data.get('reason'))
+            needs = execution_authority_need(original.id, reason)
             if needs:
-                raise _authority_error(original.id, needs, data.get('reason'))
+                raise _authority_error(original.id, needs, reason)
             break
     else:
         # A local row can arrive before its history. Its assignment alone cannot
diff --git a/tests/hermes_cli/test_kanban_assignment_routing.py b/tests/hermes_cli/test_kanban_assignment_routing.py
index a8daccaf8d..bb1211d0c1 100644
--- a/tests/hermes_cli/test_kanban_assignment_routing.py
+++ b/tests/hermes_cli/test_kanban_assignment_routing.py
@@ -269,7 +269,7 @@ def test_running_original_handoff_waits_then_dispatches_new_profile(board):
 
 
 @pytest.mark.parametrize('history', [
-    'missing', 'other-repair', 'invalid-json', 'non-object', 'missing-reason', 'null-reason', 'non-string-reason',
+    'missing', 'other-repair', 'invalid-json', 'non-object', 'non-string-reason',
 ])
 def test_local_repair_requires_matching_authority_history(board, history):
     from hermes_cli.kanban_assignment_routing import AssignmentRoutingError
@@ -298,6 +298,21 @@ def test_local_repair_requires_matching_authority_history(board, history):
     assert not kb._parents_satisfied(conn, tid)
 
 
+@pytest.mark.parametrize('payload_kind', ['null-reason', 'missing-reason'])
+def test_reasonless_assignment_block_repair_still_completes(board, payload_kind):
+    conn, _ = board
+    tid = task_with_drift(board)
+    assert kb.block_task(conn, tid, kind='assignment', reason=None)
+    repair_id = payload(conn, tid)['supervisor_task_id']
+    if payload_kind == 'missing-reason':
+        conn.execute("UPDATE task_events SET payload=? WHERE task_id=? AND kind='blocked'",
+                     (json.dumps({'supervisor_task_id': repair_id}), tid))
+        conn.commit()
+    assert kb.complete_task(conn, repair_id, result='Verified')
+    kb.recompute_ready(conn)
+    assert kb.get_task(conn, tid).status == 'ready'
+
+
 def test_repair_completion_rechecks_policy_drift(board):
     from hermes_cli.kanban_capabilities import CapabilityMismatchError
     conn, home = board
