From 7d0f7274adad2cb22e31a7bb9bde04f692a3bf45 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:37:33 +0000
Subject: [PATCH] test(kanban): verify clean HTTP callers through user managers
 [daveey]

---
 hermes_cli/kanban_http_comment_writer.py        |  4 ++++
 .../test_kanban_http_comment_real_client.py     | 17 +++++++++++++++++
 2 files changed, 21 insertions(+)

diff --git a/hermes_cli/kanban_http_comment_writer.py b/hermes_cli/kanban_http_comment_writer.py
index c512f497eb8..8e6db616b7f 100644
--- a/hermes_cli/kanban_http_comment_writer.py
+++ b/hermes_cli/kanban_http_comment_writer.py
@@ -15,6 +15,10 @@ own dashboard/webapp auto-open drops them (``top_level_env.open_url_for_person``
 in-process ``webbrowser.open`` callers (OAuth/device-flow sign-ins) can still cold-start a
 marked browser. macOS denies the global socket inventory, so each bare comment scans
 same-user processes there.
+Resolved peers use the CLI ancestry policy: unreadable ordinary ancestors fail closed to
+``agent``, while root supervisors and access-denied same-uid ``systemd --user`` managers
+with permitted capabilities beyond the reader's are skipped. This preserves clean Linux
+GUI/user-unit ancestry without ignoring markers on readable descendants or managers.
 """
 from __future__ import annotations
 
diff --git a/tests/tools/test_kanban_http_comment_real_client.py b/tests/tools/test_kanban_http_comment_real_client.py
index 9efd8e6e89f..72bc5ad6c16 100644
--- a/tests/tools/test_kanban_http_comment_real_client.py
+++ b/tests/tools/test_kanban_http_comment_real_client.py
@@ -94,6 +94,23 @@ def test_agent_curl_with_token_records_agent(served):
     assert actor._last_payload(tid)["writer_kind"] == "agent"
 
 
+def test_clean_curl_with_token_records_human(served):
+    from hermes_cli import kanban_comment_writer as ancestry
+
+    # A clean child cannot undo an agent-marked (or unreadable) pytest ancestor.
+    # On clean CI this control makes the adjacent curl marker load-bearing.
+    try:
+        marker = ancestry.agent_ancestor()
+    except ancestry.Inconclusive as exc:
+        pytest.skip(f"pytest ancestry is inconclusive: {exc}")
+    if marker:
+        pytest.skip(f"pytest ancestry is agent-marked: {marker}")
+    tid = actor._ready_task()
+    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin")}
+    assert _curl(served, tid, token=TOKEN, env=env) == "200"
+    assert actor._last_payload(tid)["writer_kind"] == "human"
+
+
 def test_curl_without_token_is_refused_and_stores_nothing(served):
     tid = actor._ready_task()
     env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HERMES_AGENT": "1"}
-- 
