From d906269336ccb62b554afad513fb316d2deb3176 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 26 Oct 2026 01:01:16 -0700
Subject: [PATCH] fix(delegate): advertise one-shot total budget before
 spawning [daveey]

---
 tests/agent/test_oneshot_footprint.py | 35 +++++++++++++++++++++++++++
 tools/delegate_tool.py                | 20 ++++++++++++++-
 2 files changed, 54 insertions(+), 1 deletion(-)

diff --git a/tests/agent/test_oneshot_footprint.py b/tests/agent/test_oneshot_footprint.py
index ecc8d16b03..2439531063 100644
--- a/tests/agent/test_oneshot_footprint.py
+++ b/tests/agent/test_oneshot_footprint.py
@@ -63,3 +63,38 @@ def test_oneshot_delegation_budget_charges_total_children_then_refuses(oneshot,
     # Interactive sessions are never charged, whatever the count.
     monkeypatch.delenv("HERMES_SINGLE_QUERY_SESSION")
     assert delegate_tool._oneshot_spawn_budget(parent, 50) is None
+
+
+@pytest.mark.parametrize("cap", [1, 2, 7])
+def test_oneshot_schema_advertises_total_budget(oneshot, monkeypatch, cap):
+    from tools import delegate_tool
+
+    monkeypatch.setattr(delegate_tool, "_get_oneshot_max_children", lambda: cap)
+    schema = delegate_tool._build_dynamic_schema_overrides()
+    description = schema["parameters"]["properties"]["tasks"]["description"]
+    assert f"at most {cap} subagents total" in description
+    assert "across all calls" in description
+    assert "inline" in description
+
+
+@pytest.mark.parametrize("single_query,cap", [(False, 2), (True, 0)])
+def test_schema_does_not_advertise_inapplicable_budget(monkeypatch, single_query, cap):
+    from tools import delegate_tool
+
+    monkeypatch.setenv("HERMES_SINGLE_QUERY_SESSION", "1" if single_query else "0")
+    monkeypatch.setattr(delegate_tool, "_get_oneshot_max_children", lambda: cap)
+    description = delegate_tool._build_tasks_param_description()
+    assert "subagents total" not in description
+
+
+def test_oversized_batch_reports_remaining_budget(oneshot, monkeypatch):
+    from tools import delegate_tool
+
+    monkeypatch.setattr(delegate_tool, "_get_oneshot_max_children", lambda: 2)
+    parent = type("P", (), {})()
+    error = delegate_tool._oneshot_spawn_budget(parent, 3)
+    assert error is not None
+    assert "2 remaining" in error
+    assert "requested 3" in error
+    assert "exhausted" not in error
+    assert getattr(parent, "_oneshot_children_spawned", 0) == 0
diff --git a/tools/delegate_tool.py b/tools/delegate_tool.py
index b11f7be26b..a7caea8390 100644
--- a/tools/delegate_tool.py
+++ b/tools/delegate_tool.py
@@ -537,6 +537,13 @@ def _oneshot_spawn_budget(parent_agent: Any, requested: int) -> Optional[str]:
         return None
     spent = getattr(parent_agent, "_oneshot_children_spawned", 0)
     if spent + requested > cap:
+        remaining = max(0, cap - spent)
+        if remaining:
+            return (
+                f"Delegation request exceeds this one-shot run's budget ({spent}/{cap} subagents used; "
+                f"{remaining} remaining; requested {requested}; delegation.oneshot_max_children). "
+                f"Submit at most {remaining} tasks and do the rest inline."
+            )
         return (
             f"Delegation budget for this one-shot run is exhausted ({spent}/{cap} subagents used; "
             f"delegation.oneshot_max_children). Do the remaining work yourself in this session — reviewing "
@@ -743,12 +750,23 @@ def _build_tasks_param_description() -> str:
         max_children = _get_max_concurrent_children()
     except Exception:
         max_children = _DEFAULT_MAX_CONCURRENT_CHILDREN
+    from agent.oneshot_footprint import is_single_query_session
+
+    budget = ""
+    if is_single_query_session():
+        cap = _get_oneshot_max_children()
+        if cap > 0:
+            budget = (
+                f" This one-shot run may spawn at most {cap} subagents total across all calls "
+                "(delegation.oneshot_max_children), not per batch. Plan within that total; "
+                "do remaining work, self-review, and tests inline once it is used."
+            )
     return (
         f"The task(s), up to {max_children} in parallel for this user (set "
         "via delegation.max_concurrent_children). Each entry spawns one "
         "subagent with isolated context and terminal session; a single task "
         "is a one-entry array. Required when spawning."
-    )
+    ) + budget
 
 def _build_dynamic_schema_overrides() -> dict:
     """Per-call schema overrides (ToolEntry.dynamic_schema_overrides): every
-- 
2.55.0

