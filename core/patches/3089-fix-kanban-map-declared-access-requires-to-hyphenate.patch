From 87c95ac0ee1cfd02eeb4abe57aabb270fba47848 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 01:49:54 +0000
Subject: [PATCH] fix(kanban): map declared access requires to hyphenated
 labels in pickup-stall/repin gates [daveey]

The pickup-stall operator move (kanban_pickup_stall_repin._need), the alarm
placement need (kanban_pickup_stall.alarm_placement / _replace_stranded) and the
repin notice's required_labels built `capability:<r>` for every requires entry.
For declared access (`hub:write`, `hub:read`, `ssh:mbp`, `ssh:mini`) that gave
`capability:hub:write`, which no machine carries: workers attest the hyphenated
`capability:hub-write` (ACCESS_LABELS). Alarm t_01a1d28d2ff68689 saw the pool
move of a requires=["hub:write"] card refused for worker-1..6 though all carry
capability:hub-write.

One shared helper, kanban_placement_coordination.requirement_label(), maps
through ACCESS_LABELS before falling back to `capability:<r>`; all four sites
use it. Regression tests: a card requiring ["terminal","hub:write"] is eligible
for the pool move onto a worker carrying capability:hub-write +
capability:terminal + profile:default (refused without hub-write), and every
need site maps each access name to its attested label. The new tests fail on
the previous code (5 failed).
---
 hermes_cli/kanban_pickup_stall.py             |  6 +++--
 hermes_cli/kanban_pickup_stall_repin.py       |  3 ++-
 hermes_cli/kanban_placement_coordination.py   |  7 ++++++
 hermes_cli/kanban_repin_notice.py             |  3 ++-
 .../test_kanban_pickup_stall_repin.py         | 24 +++++++++++++++++++
 5 files changed, 39 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_pickup_stall.py b/hermes_cli/kanban_pickup_stall.py
index 605e26c265..995aa9f13b 100644
--- a/hermes_cli/kanban_pickup_stall.py
+++ b/hermes_cli/kanban_pickup_stall.py
@@ -308,7 +308,8 @@ def alarm_placement(own: str, machines: Optional[Mapping[str, Mapping[str, Any]]
     (default placement): the registry offers nowhere else."""
     from hermes_cli import kanban_worker_node as wn
     now_ms = _now_ms() if now_ms is None else now_ms
-    need = {f"capability:{r}" for r in requires} | {f"profile:{assignee}"}
+    from hermes_cli.kanban_placement_coordination import requirement_label
+    need = {requirement_label(r) for r in requires} | {f"profile:{assignee}"}
     if machines is None:
         if own != OPERATOR_LANE:
             return [f"machine:{OPERATOR_LANE}"], f"the machine registry is unreadable from {own}: hub operator lane"
@@ -348,12 +349,13 @@ def _replace_stranded(conn, task_id: str, own: str, machines, runs_on: list[str]
     from hermes_cli import kanban_db as kb
     from hermes_cli import kanban_worker_node as wn
     from hermes_cli.kanban_db_comment_ids import add_comment
+    from hermes_cli.kanban_placement_coordination import requirement_label
     with kb.write_txn(conn):
         row = conn.execute("SELECT status, claim_lock, runs_on, assignee FROM tasks WHERE id = ?",
                            (task_id,)).fetchone()
         if row is None or row["status"] in ("running", "done", "archived") or row["claim_lock"] is not None:
             return
-        need = {f"capability:{r}" for r in _REQUIRES} | {f"profile:{row['assignee']}"}
+        need = {requirement_label(r) for r in _REQUIRES} | {f"profile:{row['assignee']}"}
         if not _stranded(row["runs_on"], own, machines, need) or wn._parse(row["runs_on"]) == runs_on:
             return
         wn.set_runs_on(conn, task_id, runs_on)
diff --git a/hermes_cli/kanban_pickup_stall_repin.py b/hermes_cli/kanban_pickup_stall_repin.py
index 259acedf98..163c2d40e0 100644
--- a/hermes_cli/kanban_pickup_stall_repin.py
+++ b/hermes_cli/kanban_pickup_stall_repin.py
@@ -96,7 +96,8 @@ def _need(target: Any) -> set:
         requires = json.loads(target["requires"]) if target["requires"] else []
     except (TypeError, ValueError):
         requires = []
-    return {f"capability:{r}" for r in requires if isinstance(r, str)} | {f"profile:{target['assignee']}"}
+    from hermes_cli.kanban_placement_coordination import requirement_label
+    return {requirement_label(r) for r in requires if isinstance(r, str)} | {f"profile:{target['assignee']}"}
 
 
 def eligible_now(name: str, own: str, machines: Optional[Mapping[str, Mapping[str, Any]]], need: set,
diff --git a/hermes_cli/kanban_placement_coordination.py b/hermes_cli/kanban_placement_coordination.py
index affaacfa9d..ec2f55922c 100644
--- a/hermes_cli/kanban_placement_coordination.py
+++ b/hermes_cli/kanban_placement_coordination.py
@@ -108,6 +108,13 @@ def requirements(text):
     return labels, None
 
 
+def requirement_label(name):
+    """The attested label a declared ``requires`` entry needs: access names map through :data:`ACCESS_LABELS`
+    (``hub:write`` -> ``capability:hub-write``; no machine carries ``capability:hub:write``), others to
+    ``capability:<name>``."""
+    return ACCESS_LABELS.get(name, f"capability:{name}")
+
+
 def access_requirements(requires):
     """Labels for declared access; unknown names remain gateway-scoped."""
     return {ACCESS_LABELS[r] for r in requires or [] if r in ACCESS_LABELS}
diff --git a/hermes_cli/kanban_repin_notice.py b/hermes_cli/kanban_repin_notice.py
index defcf014c6..eddefe88b8 100644
--- a/hermes_cli/kanban_repin_notice.py
+++ b/hermes_cli/kanban_repin_notice.py
@@ -34,9 +34,10 @@ def _json_list(text):
 
 def required_labels(row):
     """The labels a pool worker must attest to run this card (mirrors the Board's ``requiredLabels``)."""
+    from hermes_cli.kanban_placement_coordination import requirement_label
     row = dict(row)
     return ([f"profile:{row.get('assignee') or 'default'}"]
-            + [f"capability:{r}" for r in _json_list(row.get("requires"))]
+            + [requirement_label(r) for r in _json_list(row.get("requires"))]
             + [f"skill:{s}" for s in _json_list(row.get("skills"))])
 
 
diff --git a/tests/hermes_cli/test_kanban_pickup_stall_repin.py b/tests/hermes_cli/test_kanban_pickup_stall_repin.py
index b9a233089d..3d7f89db91 100644
--- a/tests/hermes_cli/test_kanban_pickup_stall_repin.py
+++ b/tests/hermes_cli/test_kanban_pickup_stall_repin.py
@@ -223,6 +223,30 @@ def test_the_new_machine_needs_the_cards_required_capabilities(board):
     assert board.why(machines=_machines(**{X: {"labels": [*_worker(X)["labels"], "capability:gpu"]}})) is None
 
 
+def test_declared_hub_write_needs_the_hyphenated_label_a_worker_attests(board):
+    """t_01a1d28d2ff68689: ``requires=["hub:write"]`` built ``capability:hub:write``, which no worker carries, so
+    the pool move refused every worker that attests ``capability:hub-write``."""
+    board.set(board.target, requires=json.dumps(["terminal", "hub:write"]))
+    pooled = {"labels": ["linux", "capability:terminal", "capability:hub-write", "profile:default", POOL]}
+    assert board.why(runs_on=[POOL], machines=_machines(**{X: pooled})) is None
+    assert board.why(machines=_machines(**{X: pooled})) is None
+    lacking = {"labels": ["linux", "capability:terminal", "profile:default", POOL]}
+    assert "capability:hub-write" in board.why(runs_on=[POOL], machines=_machines(**{X: lacking}))
+
+
+@pytest.mark.parametrize("name, label", [("hub:write", "capability:hub-write"), ("hub:read", "capability:hub-read"),
+                                         ("ssh:mbp", "capability:ssh-mbp"), ("ssh:mini", "capability:ssh-mini"),
+                                         ("terminal", "capability:terminal")])
+def test_every_need_site_maps_access_names_to_their_attested_labels(name, label):
+    from hermes_cli import kanban_placement_coordination as coord
+    from hermes_cli import kanban_repin_notice as rn
+    assert coord.requirement_label(name) == label
+    assert label in rp._need({"requires": json.dumps([name]), "assignee": "default"})
+    assert label in rn.required_labels({"requires": json.dumps([name]), "assignee": "default"})
+    machines = {X: {**_worker(X), "labels": ["linux", label, "profile:default"]}}
+    assert kps.alarm_placement(M, machines, assignee="default", requires=(name,), now_ms=NOW)[0] == [f"machine:{X}"]
+
+
 def test_the_hub_lane_without_hub_write_is_a_valid_target(board):
     assert board.why(runs_on=["machine:hub"]) is None  # hub-write is the alarm's need, not the card's
 
