From 537e15f6261ab441143d8ffc8fb73dc87f260679 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 23:37:26 +0000
Subject: [PATCH] test(kanban): align facade refusal notices with no-retry
 contract [daveey]

---
 .../test_kanban_failure_notice_text.py        | 24 +++++++++++--------
 1 file changed, 14 insertions(+), 10 deletions(-)

diff --git a/tests/tui_gateway/test_kanban_failure_notice_text.py b/tests/tui_gateway/test_kanban_failure_notice_text.py
index 15cbfd546c..4ca4738875 100644
--- a/tests/tui_gateway/test_kanban_failure_notice_text.py
+++ b/tests/tui_gateway/test_kanban_failure_notice_text.py
@@ -24,14 +24,14 @@ def test_gave_up_after_refusal_is_a_refusal_not_a_spawn_failure():
     text = _text("gave_up", {"failures": 3, "effective_limit": 3, "error": ANSI_REFUSAL,
                              "trigger_outcome": "crashed", "retry_status": "ready"})
     head = _headline(text)
-    assert "Fix notification wording" in head
-    assert "refused" in head and "refusal" in head
-    assert "spawn" not in head.lower()
-    assert "3 of 3" in head and "Blocked" in head
-    assert "refusal needs review" in head
+    assert "Provider unknown (unknown) refused the content of run unknown" in head
+    assert "Not a worker crash; no automatic retry" in head
+    assert "rephrase or re-scope the card" in head
+    assert "then promote it, or archive it" in head
     assert "alternate provider" not in text and "no user action" not in head
-    # raw material lives only under Details, with ANSI stripped
-    assert "pid" not in head and "\x1b" not in text and "pid 4242" in text.split("Details:")[1]
+    assert "exited unexpectedly" not in head and "retry policy applies" not in head
+    # Legacy errors without a Provider said: delimiter retain their sanitized excerpt.
+    assert "\x1b" not in text and "pid 4242" in head
 
 
 def test_generic_crash_event_names_title_retry_and_owner():
@@ -44,9 +44,13 @@ def test_generic_crash_event_names_title_retry_and_owner():
     assert "pid 99" in text.split("Details:")[1]
 
 
-def test_crash_with_refusal_output_is_classified_as_refusal_and_retry_stated():
-    text = _text("crashed", {"pid": 7, "worker_output": "Model declined: safety refusal", "retry_status": "ready"})
-    assert "refused" in _headline(text) and "retry policy applies" in _headline(text)
+def test_crash_with_refusal_output_never_promises_retry_even_with_legacy_ready_state():
+    text = _text("crashed", {"pid": 7, "worker_output": "Model declined: safety refusal", "retry_status": "ready",
+                             "provider": "openai-codex", "model": "fixture-model", "run_number": 203994})
+    head = _headline(text)
+    assert "Provider openai-codex (fixture-model) refused the content of run 203994" in head
+    assert "Not a worker crash; no automatic retry" in head
+    assert "retry policy applies" not in head and "no user action identified" not in head
 
 
 def test_true_spawn_failure_still_says_spawn():
-- 
2.43.0

