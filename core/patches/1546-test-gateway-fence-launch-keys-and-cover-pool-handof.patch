From af1c8db5e72ba24862f4c1bcd70f81c827748dde Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 12:19:25 -0800
Subject: [PATCH] test(gateway): fence launch keys and cover pool handoff on
 updater Pythons [daveey]

---
 gateway/session_worker_construct.py           |  5 ++--
 .../test_managed_worker_pool_rotation.py      | 15 +++++++++++
 .../test_worker_pool_handoff_contract.py      | 26 +++++++++++++++++++
 3 files changed, 44 insertions(+), 2 deletions(-)
 create mode 100644 tests/gateway/test_worker_pool_handoff_contract.py

diff --git a/gateway/session_worker_construct.py b/gateway/session_worker_construct.py
index d19b8e5b04d..dd575c2c486 100644
--- a/gateway/session_worker_construct.py
+++ b/gateway/session_worker_construct.py
@@ -250,8 +250,9 @@ def worker_route(policy, construct):
               'api_mode': api_mode}
     # Preserve the resolver's rotation authority, not just its first bearer. Managed
     # Kanban turns otherwise retry the same account forever while in-process turns rotate.
-    # Explicit credentials and deferred class routes do not supply a pool; don't invent one.
-    if runtime.get('credential_pool') is not None:
+    # A bound launch key remains authoritative even if an OAuth resolver also
+    # returns its profile pool. Deferred class routes supply no pool.
+    if not construct['api_key'] and runtime.get('credential_pool') is not None:
         result['credential_pool'] = runtime['credential_pool']
     return result
 
diff --git a/tests/gateway/test_managed_worker_pool_rotation.py b/tests/gateway/test_managed_worker_pool_rotation.py
index 022f106d0bc..b1a1a1d3cc5 100644
--- a/tests/gateway/test_managed_worker_pool_rotation.py
+++ b/tests/gateway/test_managed_worker_pool_rotation.py
@@ -45,6 +45,21 @@ def test_worker_does_not_invent_pool_for_nonpool_route(monkeypatch, explicit):
     assert worker_route(policy, {'api_key': 'fake-explicit' if explicit else None}).get('credential_pool') is None
 
 
+def test_bound_xai_launch_key_does_not_attach_profile_pool(tmp_path, monkeypatch):
+    import time
+    from hermes_cli import runtime_provider
+    entry = PooledCredential('xai-oauth', 'profile', 'profile', 'oauth', 0, 'manual:test',
+                             'fake-profile-token', expires_at_ms=int((time.time() + 3600) * 1000))
+    pool = CredentialPool('xai-oauth', [entry])
+    monkeypatch.setattr(pool, '_persist', lambda **kw: None)
+    monkeypatch.setattr(runtime_provider, 'load_pool', lambda *a, **kw: pool)
+    frame = _routed_frame(tmp_path, monkeypatch, 'grok-4', {'provider': 'xai-oauth'},
+                          api_key='fake-launch-token')
+    built = _constructed_agent(frame, monkeypatch)
+    assert built.api_key == 'fake-launch-token'
+    assert built._credential_pool is None
+
+
 def test_fallback_pool_never_attaches_to_primary(monkeypatch):
     from types import SimpleNamespace
     from gateway.session_worker_construct import worker_route
diff --git a/tests/gateway/test_worker_pool_handoff_contract.py b/tests/gateway/test_worker_pool_handoff_contract.py
new file mode 100644
index 00000000000..6fcc1781d1c
--- /dev/null
+++ b/tests/gateway/test_worker_pool_handoff_contract.py
@@ -0,0 +1,26 @@
+"""Dependency-free handoff contract, also executable on updater Python versions."""
+import importlib.util
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+
+class WorkerPoolHandoff(unittest.TestCase):
+    def test_resolver_pool_survives_for_each_subscription_provider(self):
+        path = Path(__file__).resolve().parents[2] / 'gateway/session_worker_construct.py'
+        spec = importlib.util.spec_from_file_location('worker_construct_contract', path)
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        for provider in ('anthropic', 'openai-codex'):
+            with self.subTest(provider=provider):
+                pool = object()
+                runtime = {'provider': provider, 'api_key': 'fake-token', 'credential_pool': pool}
+                module.route_runtime = lambda *a, **k: (runtime, None)
+                policy = SimpleNamespace(effective=lambda: ({'model': {}}, 'test-model'))
+                result = module.worker_route(policy, {'api_key': None})
+                self.assertIs(result.get('credential_pool'), pool)
+                self.assertEqual(result['api_key'], 'fake-token')
+
+
+if __name__ == '__main__':
+    unittest.main()
-- 
