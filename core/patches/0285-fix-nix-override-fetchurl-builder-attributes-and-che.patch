From 2efaa6f81e5be46233af0ae0edf346eab4592aac Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 26 Oct 2026 03:41:48 +0000
Subject: [PATCH] fix(nix): override fetchurl builder attributes and check
 source [daveey]

---
 nix/source-mirrors.nix | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/nix/source-mirrors.nix b/nix/source-mirrors.nix
index 1f58e1df57..9a1d85436a 100644
--- a/nix/source-mirrors.nix
+++ b/nix/source-mirrors.nix
@@ -2,8 +2,11 @@
 { inputs, ... }:
 {
   perSystem =
-    { system, ... }:
+    { system, pkgs, ... }:
     {
+      # Exercise the real fetcher in flake check, even without a desktop build.
+      checks.libtirpc-source = pkgs.libtirpc.src;
+
       _module.args.pkgs = import inputs.nixpkgs {
         inherit system;
         overlays = [
@@ -14,9 +17,11 @@
             libtirpc = prev.libtirpc.overrideAttrs (
               old:
               final.lib.optionalAttrs (old.version == "1.3.7") {
-                src = old.src.override {
-                  url = "https://tarballs.nixos.org/sha256/5467ed12bdf1cc2a7c3b7a2a0a3219a3396ae7df60c4de48b07051686dfb18fe";
-                };
+                src = old.src.overrideAttrs (_: {
+                  urls = [
+                    "https://tarballs.nixos.org/sha256/5467ed12bdf1cc2a7c3b7a2a0a3219a3396ae7df60c4de48b07051686dfb18fe"
+                  ];
+                });
               }
             );
           })
-- 
2.55.0

