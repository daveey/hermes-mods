From c073ce09a822e2c678db76bfd94013cbcc6a1b0b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 02:02:33 +0000
Subject: [PATCH] fix(desktop): preserve external dot precedence with running
 cards [daveey]

---
 .../src/app/chat/session-status-dot.test.tsx  | 30 +++++++++++++++++++
 .../src/app/chat/session-status-dot.tsx       | 14 +++++++--
 .../src/app/chat/sidebar/session-row.test.tsx | 17 +++++++++++
 3 files changed, 58 insertions(+), 3 deletions(-)

diff --git a/apps/desktop/src/app/chat/session-status-dot.test.tsx b/apps/desktop/src/app/chat/session-status-dot.test.tsx
index e468301a4b..7cee46a058 100644
--- a/apps/desktop/src/app/chat/session-status-dot.test.tsx
+++ b/apps/desktop/src/app/chat/session-status-dot.test.tsx
@@ -501,6 +501,36 @@ describe('SessionStatusDot external label', () => {
     expect(bg(down.querySelector('[data-background-label="external_down"]'))).toBe('rgb(239, 68, 68)')
   })
 
+  it.each(['external', 'external_down'] as const)('keeps %s semantics with a running linked card', label => {
+    const session = {
+      id: `mixed-${label}`,
+      kanban_active: 2,
+      kanban_external: label === 'external' ? 1 : 0,
+      kanban_external_down: label === 'external_down' ? 1 : 0,
+      kanban_observed_at: NOW,
+      kanban_parked: 1,
+      message_count: 4
+    } as SessionInfo
+
+    const { container } = render(
+      <SessionStatusDot runningCardCount={1} session={session} storedSessionId={session.id} />
+    )
+
+    const el = container.querySelector('.rounded-full')!
+
+    if (label === 'external_down') {
+      expect(el.getAttribute('data-background-label')).toBe('external_down')
+      expect(getComputedStyle(el).backgroundColor).toBe('rgb(239, 68, 68)')
+      expect(el.getAttribute('aria-label')).toBe('An external service is down')
+      expect(el.getAttribute('title')).toBe('An external service is down')
+    } else {
+      expect(el.getAttribute('data-background-label')).toBe('external')
+      expect(getComputedStyle(el).backgroundColor).toBe('rgb(56, 189, 248)')
+      expect(el.getAttribute('aria-label')).toBe('Running on an external service')
+      expect(el.getAttribute('title')).toBe('Running on an external service')
+    }
+  })
+
   it('missing cards keep the generic external label, not a service claim', () => {
     const c = dot({
       id: 'ext-generic',
diff --git a/apps/desktop/src/app/chat/session-status-dot.tsx b/apps/desktop/src/app/chat/session-status-dot.tsx
index 174667e959..e92395de5d 100644
--- a/apps/desktop/src/app/chat/session-status-dot.tsx
+++ b/apps/desktop/src/app/chat/session-status-dot.tsx
@@ -190,10 +190,18 @@ export function SessionStatusDot({
   // status changes, but a given dot only repaints when ITS OWN state flips.
   const agentState = useSessionDotState(storedSessionId, session)
 
-  const dotState =
-    runningCardCount > 0 && agentState !== 'needs-input' && agentState !== 'unread' ? 'working' : agentState
+  const agentBackgroundLabel = useBackgroundDotLabel(storedSessionId, session, agentState)
 
-  const backgroundLabel = useBackgroundDotLabel(storedSessionId, session, dotState)
+  const dotState =
+    runningCardCount > 0 &&
+    agentState !== 'needs-input' &&
+    agentState !== 'unread' &&
+    agentBackgroundLabel !== 'external' &&
+    agentBackgroundLabel !== 'external_down'
+      ? 'working'
+      : agentState
+
+  const backgroundLabel = dotState === 'background' ? agentBackgroundLabel : 'running'
 
   const variant = sessionDotVariant(dotState, session?.outcome, backgroundLabel)
 
diff --git a/apps/desktop/src/app/chat/sidebar/session-row.test.tsx b/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
index 8330f48c0a..982b24907c 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row.test.tsx
@@ -691,6 +691,23 @@ describe('SidebarSessionRow inside the sortable list', () => {
     )
   }
 
+  it('passes running cards into the sortable grabber dot', () => {
+    const { container } = render(
+      <Host
+        onResume={noop}
+        session={makeSession({ title: 'Card work', kanban_active: 2, kanban_observed_at: Date.now() / 1000 })}
+      />
+    )
+
+    const grabber = container.querySelector('[data-reorder-handle]')!
+    const dot = grabber.querySelector('.rounded-full')!
+
+    expect(dot.className).toContain('bg-(--ui-accent)')
+    expect(dot.className).not.toContain('border')
+    expect(container.querySelector('[data-run-square]')).toBeNull()
+    expect(container.querySelector('[data-card-colour="blue"]')).toBeNull()
+  })
+
   const space = { code: 'Space', key: ' ' }
 
   it('lets Space through to a focused row control instead of arming a keyboard drag', () => {
