Subject: [PATCH 6389] Private-hold diagnostic: released capability stops and stacked historical releases

Public mirror of source commit 8f502bf5646d695d601cdc2ca6a8ecdd232fa709.

---
diff --git a/hermes_cli/kanban_actionability_sources.py b/hermes_cli/kanban_actionability_sources.py
index 8039329923d..eb0886a3367 100644
--- a/hermes_cli/kanban_actionability_sources.py
+++ b/hermes_cli/kanban_actionability_sources.py
@@ -274,12 +274,20 @@
         verified = covered(Rows(conn), task['id'])
     except EVIDENCE_ERRORS:
         verified = frozenset()  # Missing mandate evidence cannot resolve a scope hold.
-    # Synced provenance is the Board-stamped envelope, never actor text in the payload.
+    # Synced provenance is the Board-stamped envelope, never actor text in the payload. A row this gateway
+    # wrote has no envelope until its Board echo applies, so only the card's home gateway (sync identity ==
+    # created_on) reads its own un-echoed release; elsewhere a pulled row may also lack one and proves nothing.
     # An unsynced board's own release writer is local; foreign envelopes are not local writes.
-    releases = frozenset(key(row) for row in rows if row['kind'] == 'stop_released' and (
-        (reader.synced and isinstance(task.get('created_on'), str) and task['created_on']
-         and row.get('origin_gateway') == task['created_on'])
-        or (not reader.synced and not row.get('origin_gateway'))))
+    home = task.get('created_on') if isinstance(task.get('created_on'), str) and task.get('created_on') else None
+    if reader.synced:
+        from hermes_cli.kanban_db_sync import sync_state
+        origins = set() if home is None else {home}
+        if home is not None and (sync_state(conn) or {}).get('gateway_id') == home:
+            origins.add(None)
+    else:
+        origins = {None, ''}
+    releases = frozenset(key(row) for row in rows
+                         if row['kind'] == 'stop_released' and row.get('origin_gateway') in origins)
     return held(task['status'], events, verified_cover=verified, verified_releases=releases)
 
 
diff --git a/tests/hermes_cli/test_kanban_release.py b/tests/hermes_cli/test_kanban_release.py
index c7cbb7f30b1..4070e7eb486 100644
--- a/tests/hermes_cli/test_kanban_release.py
+++ b/tests/hermes_cli/test_kanban_release.py
@@ -99,6 +99,36 @@
     assert 'private_hold' not in describe(board, tid)['violations']
 
 
+@pytest.mark.parametrize('gateway,echo,clear', [
+    ('home', None, True),        # the home gateway's own release, Board echo not applied yet
+    ('home', 'home', True),      # echoed with the home envelope
+    ('home', 'foreign', False),  # the envelope was replaced by another gateway's write
+    ('replica', None, False),    # a replica's envelope-less row is not proof of a home write
+])
+def test_synced_home_release_clears_private_diagnostic_before_board_echo(board, gateway, echo, clear):
+    from hermes_cli import kanban_db_sync as sync
+    from hermes_cli.kanban_actionability_sources import Reader, describe
+    sync.apply_sync_schema_steps(board)
+    board.commit()
+    if not board.execute("SELECT 1 FROM kanban_sync_state").fetchone():
+        board.execute("INSERT INTO kanban_sync_state (board_id, gateway_id, hlc_last, mode) VALUES ('b', 'home', '', 'shadow')")
+        board.commit()
+    sync.set_identity(board, 'b', 'home')
+    sync.set_mode(board, 'primary')
+    assert Reader(board).synced is True
+    tid = kb.create_task(board, title='Capability stop', assignee='default')
+    with kb.write_txn(board):
+        board.execute("UPDATE tasks SET status='triage', created_on='home' WHERE id=?", (tid,))
+        kb._append_event(board, tid, decision.EVENT, {'cause': 'capability_unavailable'})
+    assert run(board, tid)['outcome'] == 'released'
+    rows = board.execute("SELECT uid, origin_gateway FROM task_events WHERE task_id=? AND kind='stop_released'", (tid,)).fetchall()
+    assert len(rows) == 1 and rows[0][0] and rows[0][1] is None  # the real writer: uid yes, no envelope
+    board.execute("UPDATE task_events SET origin_gateway=? WHERE task_id=? AND kind='stop_released'", (echo, tid))
+    board.commit()
+    sync.set_identity(board, 'b', gateway)
+    assert ('private_hold' not in describe(board, tid)['violations']) is clear
+
+
 def test_ordinary_spend_stop_released(board):
     tid = spend_stopped(board)
     out = run(board, tid, note='Desktop Unblock, operation op-1')
