From 73b1a5db1beefab7c8dac4031b9b5e99c4373304 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 11:29:00 -0700
Subject: [PATCH] ci(hermes-state-macos): utility QoS and 2 workers on the
 shared mini (#217)

The mini also runs BabyBear services and Desktop builds/signing; this lane ran
4 workers at normal priority on every main push (about 3 an hour, 5 min each).

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/hermes-state-macos.yml | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/hermes-state-macos.yml b/.github/workflows/hermes-state-macos.yml
index baf35962a5d..2c3f2319d67 100644
--- a/.github/workflows/hermes-state-macos.yml
+++ b/.github/workflows/hermes-state-macos.yml
@@ -46,7 +46,9 @@ jobs:
           HERMES_HOME="$(mktemp -d "${RUNNER_TEMP:-/tmp}/hermes-home.XXXXXX")"
           export HERMES_HOME
           trap 'rm -rf "$HERMES_HOME"' EXIT
-          scripts/run_tests.sh tests/hermes_state/ -j 4
+          # The mini also runs BabyBear services and Desktop builds/signing: utility QoS lets
+          # macOS put those first, and 2 workers instead of 4 halve this lane's CPU.
+          taskpolicy -c utility scripts/run_tests.sh tests/hermes_state/ -j 2
         env:
           OPENROUTER_API_KEY: ''
           OPENAI_API_KEY: ''
-- 
2.55.0

