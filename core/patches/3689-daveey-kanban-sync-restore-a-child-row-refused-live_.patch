From bf08acbc3e1fc396a588e4ffc8ecca841bb0a227 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 17:05:30 +0000
Subject: [PATCH] [daveey] kanban sync: restore a child row refused live_claim
 on its compat (reduced) retry

`restore_child` restored only `upsert` ops, while `refused()` still reported the
row handled. A `task_runs`/`task_events` `compat` op -- the reduced retry
`enqueue_retry` queues after a `forbidden_field` rejection, sent as an upsert --
refused `live_claim` on a primary board was recorded on the card but neither
restored nor passed to the generic returned-row apply, so the local run kept the
refused handoff. Treat `compat` as restorable like `upsert`.

Follow-up from the exact-head review of #2377 (t_01a1d5b1a45a05c6, review
5894603102); card t_01a1d5c0a7667904.

RED (main 3de04d8928): test_refused_compat_retry_of_a_run_handoff_restores_the_local_run
fails `('done', 'completed', ...) != ('running', None, ...)` -- the local run keeps
the refused summary.
GREEN: same test passes; all 25 test files referencing live_claim /
kanban_sync_live_claim: 525 passed, 0 failed.
---
 hermes_cli/kanban_sync_live_claim.py          |  3 ++-
 .../test_kanban_live_claim_child_rows.py      | 20 +++++++++++++++++++
 2 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_sync_live_claim.py b/hermes_cli/kanban_sync_live_claim.py
index ea8e36f324..41c9d47dc0 100644
--- a/hermes_cli/kanban_sync_live_claim.py
+++ b/hermes_cli/kanban_sync_live_claim.py
@@ -48,7 +48,8 @@ def restore_child(conn: sqlite3.Connection, row: dict, res: dict) -> list[sync.R
     """The changes that make a refused child row match the Board (primary boards; the caller applies them in the
     push's authoritative batch). Prepares the local run so the Board's copy is not skipped as already seen."""
     table, uid = row["table_name"], str(row["row_uid"])
-    if table not in CHILD_TABLES or row["op"] != "upsert":
+    # ``compat`` is ``enqueue_retry``'s reduced retry after a forbidden_field rejection, sent as an upsert.
+    if table not in CHILD_TABLES or row["op"] not in ("upsert", "compat"):
         return []
     board_row = res.get("row")
     if board_row:
diff --git a/tests/hermes_cli/test_kanban_live_claim_child_rows.py b/tests/hermes_cli/test_kanban_live_claim_child_rows.py
index f518734ca7..dc59356266 100644
--- a/tests/hermes_cli/test_kanban_live_claim_child_rows.py
+++ b/tests/hermes_cli/test_kanban_live_claim_child_rows.py
@@ -107,6 +107,26 @@ def test_refused_run_handoff_is_recorded_and_the_local_run_restored(gws, svc):
     assert hub.conn.execute("SELECT summary FROM task_runs WHERE uid = ?", (uid,)).fetchone()[0] == "worker's handoff"
 
 
+def test_refused_compat_retry_of_a_run_handoff_restores_the_local_run(gws, svc):
+    """The reduced retry ``enqueue_retry`` queues after a ``forbidden_field`` rejection is a ``compat`` op (sent as an
+    upsert); its live_claim refusal restores the local run exactly like the original upsert's."""
+    hub, worker = gws
+    tid = _running_on_worker(hub, worker, svc)
+    run_id = _old_core_complete(hub.conn, tid)
+    uid = hub.conn.execute("SELECT uid FROM task_runs WHERE id = ?", (run_id,)).fetchone()[0]
+    with hub.conn:
+        n = hub.conn.execute("UPDATE kanban_sync_outbox SET op = 'compat' WHERE table_name = 'task_runs'"
+                             " AND row_uid = ? AND state = 'pending'", (uid,)).rowcount
+    assert n == 1
+    hub.round()
+    assert _board_runs(svc, tid)[uid]["summary"] is None
+    assert ("task_runs", "live_claim") in {(r.get("table", "tasks"), r["reason"].split(":")[0])
+                                           for r in _rejections(hub.conn, tid)}
+    run = hub.conn.execute("SELECT status, outcome, ended_at, summary, metadata FROM task_runs WHERE uid = ?",
+                           (uid,)).fetchone()
+    assert tuple(run) == ("running", None, None, None, None)
+
+
 def test_refused_phantom_run_is_removed_and_never_reuploaded(gws, svc):
     hub, worker = gws
     tid = _running_on_worker(hub, worker, svc)
