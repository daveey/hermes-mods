+    async def offline():
+        return await asyncio.to_thread(_with_db, profile, fn, read_only=False)
+
+    if getattr(request.app.state, "gateway_runner", None) is not None:
+        return await offline()
+    return await _on_live_owner(request, profile, offline)
 
 
