diff --git a/hermes_cli/kanban_db_stale_claims.py b/hermes_cli/kanban_db_stale_claims.py
new file mode 100644
index 00000000000..491cc241bee
--- /dev/null
+++ b/hermes_cli/kanban_db_stale_claims.py
@@ -0,0 +1,76 @@
+"""Stale-claim helpers shared by ``kanban_db.release_stale_claims`` and the dispatcher sweeps.
+
+Moved out of ``kanban_db`` / ``kanban_db_dispatch`` (file-size caps); both re-export them.
+"""
+
+from __future__ import annotations
+
+import sqlite3
+from typing import Optional
+
+
+def _extend_live_stale_claim(conn: sqlite3.Connection, row: sqlite3.Row, now: int) -> None:
+    """TTL-expired claim whose host-local worker is alive: extend instead of
+    reclaiming (``claim_extended`` event). CAS on the same expired lock so a
+    concurrent reclaimer wins cleanly."""
+    from hermes_cli import kanban_db as _kb
+
+    new_expires = now + _kb._resolve_claim_ttl_seconds()
+    with _kb.write_txn(conn):
+        cur = conn.execute(
+            "UPDATE tasks SET claim_expires = ? "
+            "WHERE id = ? AND status = 'running' "
+            "  AND claim_lock IS ? "
+            "  AND claim_expires IS NOT NULL "
+            "  AND claim_expires < ?", (new_expires, row["id"], row["claim_lock"], now),
+        )
+        if cur.rowcount != 1:
+            return
+        run_id = _kb._extend_run_claim(conn, row["id"], new_expires)
+        _kb._append_event(
+            conn, row["id"], "claim_extended",
+            {
+                "reason": "pid_alive",
+                "worker_pid": int(row["worker_pid"]),
+                "claim_lock": row["claim_lock"],
+                "claim_expires_was": _kb._to_epoch(row["claim_expires"]),
+                "claim_expires_now": new_expires,
+                "last_heartbeat_at": _kb._to_epoch(row["last_heartbeat_at"]),
+            },
+            run_id=run_id,
+        )
+
+
+def _defer_reclaim_for_live_worker(
+    conn: sqlite3.Connection,
+    task_id: str,
+    claim_lock: Optional[str],
+    now: int,
+    termination: dict,
+    *,
+    reason: str,
+) -> None:
+    """Hold a claim whose worker survived termination instead of releasing it.
+
+    Extends ``claim_expires`` by ``RECLAIM_DEFER_GRACE_SECONDS`` so the task
+    stays ``running`` (no duplicate spawn) and records ``reclaim_deferred``.
+    The next tick retries the kill; not spawning a duplicate is what lets the
+    throttled worker finally die.
+    """
+    from hermes_cli import kanban_db as _kb
+
+    grace = now + _kb.RECLAIM_DEFER_GRACE_SECONDS
+    with _kb.write_txn(conn):
+        cur = conn.execute(
+            "UPDATE tasks SET claim_expires = ? "
+            "WHERE id = ? AND status = 'running' AND claim_lock IS ?",
+            (grace, task_id, claim_lock),
+        )
+        if cur.rowcount != 1:
+            return
+        run_id = _kb._current_run_id(conn, task_id)
+        if run_id is not None:
+            conn.execute("UPDATE task_runs SET claim_expires = ? WHERE id = ?", (grace, run_id))
+        payload = {"reason": reason, "claim_lock": claim_lock, "claim_expires_now": grace}
+        payload.update(termination)
+        _kb._append_event(conn, task_id, "reclaim_deferred", payload, run_id=run_id)
diff --git a/hermes_cli/kanban_suspend_ledger.py b/hermes_cli/kanban_suspend_ledger.py
new file mode 100644
index 00000000000..bda16bcbc21
--- /dev/null
+++ b/hermes_cli/kanban_suspend_ledger.py
@@ -0,0 +1,124 @@
+"""Suspend ledger: which wall-clock spans this host's dispatcher spent asleep. [daveey]
+
+A Mac lid-close stops every process, so a worker sends no heartbeat while it sleeps. The stale
+checks that measure ``now - last_heartbeat_at`` (or ``now - started_at``) in wall-clock time then
+read a long sleep as a wedged worker and SIGTERM it on the first pass after wake.
+
+Each dispatcher pass calls :func:`record_dispatch_pass` before the reclaim sweeps. When the gap
+since the previous pass exceeds :func:`gap_threshold_seconds` (``max(300, 3 x
+kanban.dispatch_interval_seconds)``), the span ``[previous, now]`` is recorded as suspended. The
+checks then use :func:`awake_seconds`, which subtracts recorded spans from a wall-clock window.
+
+The ledger lives in ``kanban.db`` (two small tables created lazily here), so a gateway restart or a
+one-shot ``hermes kanban dispatch`` sees the same history. Spans that ended more than 7 days ago are
+pruned. A host that never sleeps (the hub) keeps an empty ledger, and :func:`awake_seconds` then
+equals the wall-clock difference. A missing table (no pass recorded yet) also reads as empty.
+"""
+
+from __future__ import annotations
+
+import logging
+import sqlite3
+import time
+from typing import Optional
+
+_log = logging.getLogger(__name__)
+
+MIN_GAP_SECONDS = 300
+GAP_INTERVAL_MULTIPLE = 3
+RETENTION_SECONDS = 7 * 86400
+DEFAULT_INTERVAL_SECONDS = 60
+
+_DDL = (
+    "CREATE TABLE IF NOT EXISTS kanban_suspend_ledger ("
+    " start INTEGER NOT NULL, end INTEGER NOT NULL)",
+    "CREATE TABLE IF NOT EXISTS kanban_dispatch_stamp ("
+    " id INTEGER PRIMARY KEY CHECK (id = 1), at INTEGER NOT NULL)",
+)
+
+
+def gap_threshold_seconds(interval_seconds: Optional[float] = None) -> int:
+    """A gap between passes longer than this counts as a suspend."""
+    interval = interval_seconds if interval_seconds is not None else _configured_interval_seconds()
+    try:
+        interval = float(interval)
+    except (TypeError, ValueError):
+        interval = DEFAULT_INTERVAL_SECONDS
+    return int(max(MIN_GAP_SECONDS, GAP_INTERVAL_MULTIPLE * max(interval, 0)))
+
+
+def _configured_interval_seconds() -> float:
+    try:
+        from hermes_cli.config import load_config_readonly
+        raw = ((load_config_readonly() or {}).get("kanban") or {}).get("dispatch_interval_seconds")
+        return float(raw or DEFAULT_INTERVAL_SECONDS)
+    except Exception:  # health: allow BLE001 -- an unreadable config must never stop a dispatch pass
+        _log.debug("kanban: reading kanban.dispatch_interval_seconds failed; using %ss",
+                   DEFAULT_INTERVAL_SECONDS, exc_info=True)
+        return DEFAULT_INTERVAL_SECONDS
+
+
+def record_dispatch_pass(
+    conn: sqlite3.Connection, *, now: Optional[int] = None, interval_seconds: Optional[float] = None,
+) -> Optional[tuple[int, int]]:
+    """Stamp this pass; record ``[previous, now]`` as suspended when the gap is over the threshold.
+
+    Returns the recorded span, else ``None``. Never raises: a failure leaves the checks on wall-clock
+    time, which is the pre-ledger behaviour.
+    """
+    from hermes_cli.kanban_db import write_txn
+
+    now = int(time.time()) if now is None else int(now)
+    threshold = gap_threshold_seconds(interval_seconds)
+    recorded = None
+    try:
+        with write_txn(conn):
+            for ddl in _DDL:
+                conn.execute(ddl)
+            row = conn.execute("SELECT at FROM kanban_dispatch_stamp WHERE id = 1").fetchone()
+            previous = int(row[0]) if row is not None else None
+            if previous is not None and now - previous > threshold:
+                conn.execute("INSERT INTO kanban_suspend_ledger (start, end) VALUES (?, ?)", (previous, now))
+                recorded = (previous, now)
+            conn.execute(
+                "INSERT INTO kanban_dispatch_stamp (id, at) VALUES (1, ?) "
+                "ON CONFLICT(id) DO UPDATE SET at = excluded.at", (now,))
+            conn.execute("DELETE FROM kanban_suspend_ledger WHERE end < ?", (now - RETENTION_SECONDS,))
+    except (sqlite3.Error, RuntimeError):
+        _log.warning("kanban: recording the dispatcher pass stamp failed", exc_info=True)
+        return None
+    if recorded is not None:
+        _log.info("kanban: dispatcher was suspended for %ss (%s -> %s); stale checks skip it",
+                  recorded[1] - recorded[0], recorded[0], recorded[1])
+    return recorded
+
+
+def suspended_intervals(conn: sqlite3.Connection) -> list[tuple[int, int]]:
+    """Recorded suspend spans, oldest first; empty when none (or no table yet)."""
+    try:
+        rows = conn.execute("SELECT start, end FROM kanban_suspend_ledger ORDER BY start, end").fetchall()
+    except sqlite3.OperationalError:
+        return []
+    return [(int(r[0]), int(r[1])) for r in rows]
+
+
+def awake_seconds(conn: sqlite3.Connection, since: float, now: float) -> float:
+    """``now - since`` minus the overlap of recorded suspends with ``[since, now]``."""
+    total = now - since
+    if total <= 0:
+        return total
+    try:
+        rows = conn.execute(
+            "SELECT start, end FROM kanban_suspend_ledger WHERE end > ? AND start < ? ORDER BY start",
+            (since, now),
+        ).fetchall()
+    except sqlite3.OperationalError:
+        return total
+    asleep = 0.0
+    cursor = since  # merge overlapping spans so none is subtracted twice
+    for start, end in rows:
+        lo, hi = max(float(start), cursor), min(float(end), now)
+        if hi > lo:
+            asleep += hi - lo
+            cursor = hi
+    return max(0.0, total - asleep)
diff --git a/tests/hermes_cli/test_kanban_suspend_ledger.py b/tests/hermes_cli/test_kanban_suspend_ledger.py
new file mode 100644
index 00000000000..b6eea71cf4c
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_suspend_ledger.py
@@ -0,0 +1,226 @@
+"""Sleep-aware stale checks: time the Mac spent suspended is not counted as worker idleness. [daveey]
+
+The dispatcher records a gap between two of its passes that is far longer than its interval as a
+suspend (``kanban_suspend_ledger``). The heartbeat backstop of ``release_stale_claims``,
+``detect_stale_running`` and ``enforce_max_runtime`` then measure awake time only, so a lid-close
+longer than an hour no longer SIGTERMs live workers on the first pass after wake.
+"""
+
+import os
+import subprocess
+import sys
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as kbd
+from hermes_cli import kanban_suspend_ledger as ledger
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_KANBAN_CRASH_GRACE_SECONDS", "0")
+    conn = kbc.connect(tmp_path / "kanban.db")
+    try:
+        yield conn
+    finally:
+        conn.close()
+
+
+@pytest.fixture
+def child():
+    proc = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(120)"])
+    try:
+        # The fingerprint needs the process to exist; give exec a moment.
+        for _ in range(50):
+            if kbd._process_fingerprint(proc.pid):
+                break
+            time.sleep(0.05)
+        yield proc
+    finally:
+        proc.kill()
+        proc.wait()
+
+
+def _running(conn, pid, *, hb_age, started_age=None, max_runtime=None) -> str:
+    """A host-local running card with a live worker ``pid``, an expired claim and a heartbeat
+    ``hb_age`` seconds old."""
+    tid = kb.create_task(conn, title="job", assignee="worker", max_runtime_seconds=max_runtime)
+    kb.claim_task(conn, tid)
+    kbd._set_worker_pid(conn, tid, pid)
+    now = int(time.time())
+    started = now - (started_age if started_age is not None else hb_age)
+    with kb.write_txn(conn):
+        conn.execute(
+            "UPDATE tasks SET worker_started_at = ?, started_at = ?, claim_expires = ?, "
+            "last_heartbeat_at = ? WHERE id = ?",
+            (kbd._process_fingerprint(pid), started, now - 60, now - hb_age, tid))
+        conn.execute("UPDATE task_runs SET started_at = ?, last_heartbeat_at = ? "
+                     "WHERE id = (SELECT current_run_id FROM tasks WHERE id = ?)",
+                     (started, now - hb_age, tid))
+    return tid
+
+
+def _suspend(conn, start, end):
+    """Record a suspend the way the dispatcher does: a pass at ``start``, the next at ``end``."""
+    ledger.record_dispatch_pass(conn, now=start, interval_seconds=60)
+    ledger.record_dispatch_pass(conn, now=end, interval_seconds=60)
+
+
+def _reaping_kill(proc, killed):
+    """signal_fn that really signals the child and reaps it, so the sweep sees it gone."""
+    def kill(pid, sig):
+        killed.append((pid, sig))
+        os.kill(pid, sig)
+        proc.wait(timeout=10)
+    return kill
+
+
