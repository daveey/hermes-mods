From 29c8ad97f8c646bc3da919504099b0f888aa534f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 09:43:30 +0000
Subject: [PATCH] fix(nix): address stable-cache review findings [daveey]

Keep only PM tools that flake checks build in the stable cache root;
npm and just otherwise add avoidable upstream fetches after checks pass.
Exercise the actual root workflow shell with a failed build, an over-budget
closure and an in-budget control, and pin unconditional failure handling.

Proof: root-set test fails before dropping npm/just. All three previously
surviving workflow mutants now fail: no pipefail (2), noop (3), and
continue-on-error (3). Four targeted Nix suites: 24 passed. Full
scripts/check --base origin/main: 21 checks pass.

Co-Authored-By: OpenAI GPT-6.1-sol <noreply@openai.com>
---
 nix/packages.nix                        |  2 +-
 tests/ci/test_nix_cache_observations.py | 38 +++++++++++++++++++++++++
 2 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/nix/packages.nix b/nix/packages.nix
index be86590e74..396fcd58fe 100644
--- a/nix/packages.nix
+++ b/nix/packages.nix
@@ -81,7 +81,7 @@
         # GC root for the expensive tool outputs and shared runtime dependencies.
         # The build inputs alone do not keep patchelf alive after GC.
         ci-cache = pkgs.writeText "hermes-ci-cache" (lib.concatStringsSep "\n" (
-          map toString ((lib.attrVals [ "npm" "pnpm" "ripgrep" "ffmpeg" "node" "python" "uv" "just" ] pmPackages) ++ [
+          map toString ((lib.attrVals [ "pnpm" "ripgrep" "ffmpeg" "node" "python" "uv" ] pmPackages) ++ [
             (pkgs.callPackage ./patchelf-fixed.nix { })
             full.hermesVenv
             full.hermesNpmLib.pnpmDeps
diff --git a/tests/ci/test_nix_cache_observations.py b/tests/ci/test_nix_cache_observations.py
index df72b96812..c87946c8da 100644
--- a/tests/ci/test_nix_cache_observations.py
+++ b/tests/ci/test_nix_cache_observations.py
@@ -69,6 +69,44 @@ fi
     assert ('::error::' in result.stdout) is not success
 
 
+@pytest.mark.parametrize(('mode', 'expected'), [('over-budget', 1), ('build-fails', 42), ('within-budget', 0)])
+def test_root_workflow_propagates_failures(tmp_path, mode, expected):
+    doc = YAML(typ='safe').load((ROOT / '.github/workflows/nix.yml').read_text())
+    steps = doc['jobs']['flake-check']['steps']
+    root = next(s for s in steps if s.get('name') == 'Root stable Nix outputs before cache GC')
+    assert 'if' not in root
+    assert not root.get('continue-on-error', False)
+    nix = tmp_path / 'nix'
+    nix.write_text('''#!/usr/bin/env bash
+if [ "$1" = build ]; then
+  if [ "$MODE" = build-fails ]; then echo build-failed >&2; exit 42; fi
+  while [ "$1" != --out-link ]; do shift; done
+  ln -s /nix/store/stable-tools "$2"
+else
+  if [ "$MODE" = over-budget ]; then size=5368709121; else size=1024; fi
+  printf '[{"closureSize":%s}]\\n' "$size"
+fi
+''')
+    nix.chmod(0o755)
+    result = subprocess.run(
+        ['bash', '-e', '-c', root['run']], cwd=ROOT,
+        env=dict(os.environ, PATH=f'{tmp_path}:{os.environ["PATH"]}', MODE=mode,
+                 RUNNER_TEMP=str(tmp_path), GITHUB_STEP_SUMMARY=str(tmp_path / 'summary')),
+        capture_output=True, text=True, encoding='utf-8', check=False,
+    )
+    assert result.returncode == expected, result.stdout + result.stderr
+    log = (tmp_path / 'nix-cache-roots.log').read_text()
+    assert ('::error::' in log) is (mode == 'over-budget')
+    if mode == 'build-fails':
+        assert 'build-failed' in log
+
+
+def test_cache_roots_only_tools_used_by_checks():
+    packages = (ROOT / 'nix/packages.nix').read_text()
+    roots = packages.split('lib.attrVals [', 1)[1].split(']', 1)[0]
+    assert roots.split() == ['"pnpm"', '"ripgrep"', '"ffmpeg"', '"node"', '"python"', '"uv"']
+
+
 def test_workflow_tee_retains_failure_and_summary_is_always_run(tmp_path):
     doc = YAML(typ='safe').load((ROOT / '.github/workflows/nix.yml').read_text())
     steps = doc['jobs']['flake-check']['steps']
