@@ -181,6 +181,21 @@ def _safe(value: Any, placeholder: str) -> str:
     return text if _SAFE_NAME.match(text) else placeholder
 
 
+def _turn_session_id(env: Mapping[str, str], explicit_env: bool) -> str:
+    """The chat this turn runs for. A gateway or Desktop backend serves several chats in one process, and
+    ``os.environ["HERMES_SESSION_ID"]`` holds whichever chat wrote it last: the current turn's id is the session
+    ContextVar (``get_session_env`` falls back to the env only when none is bound). A hint built from the env
+    told chat aaaaaa to subscribe chat bbbbbb to its cards (agent-884fdd96f8). An explicit ``env`` (tests, a
+    caller replaying a child's env) is used as given. [daveey]"""
+    if explicit_env:
+        return str(env.get("HERMES_SESSION_ID") or "")
+    try:
+        from gateway.session_context import get_session_env
+    except ImportError:
+        return str(env.get("HERMES_SESSION_ID") or "")
+    return str(get_session_env("HERMES_SESSION_ID", "") or "")
+
+
 def adopt_next_step(task_id: str, board: str, *, env: Optional[Mapping[str, str]] = None) -> dict[str, Any]:
     """The supported way to attach an existing card to a chat, for a ``kanban_origin_adopt`` call that has no
     courier context. That tool only runs inside a courier-delivered adoption; a chat (or a worker) gets the
@@ -190,6 +205,7 @@ def adopt_next_step(task_id: str, board: str, *, env: Optional[Mapping[str, str]
     another gateway: a ``hermes-hub create-task`` that gets the command run there. Unknown or unsafe parts stay
     ``<placeholders>`` and ``complete`` is False: such a command must be filled in before it is run.
     """
+    explicit_env = env is not None
     env = os.environ if env is None else env
     me, _ = gateway_names()
     me = _safe(me, "")
@@ -218,7 +234,7 @@ def adopt_next_step(task_id: str, board: str, *, env: Optional[Mapping[str, str]
         owner_gw, owner_profile = ((_safe(owners[0][0], "<owner-gateway>"), _safe(owners[0][1], "<owner-profile>"))
                                    if len(owners) == 1 else ("<owner-gateway>", "<owner-profile>"))
         run_on = me or "<this-gateway>"
-        session = _safe(env.get("HERMES_SESSION_ID"), "<origin-session-id>")
+        session = _safe(_turn_session_id(env, explicit_env), "<origin-session-id>")
         # "custom" = a HERMES_HOME outside ~/.hermes: no profile name to pass; the CLI resolves its own.
         origin_profile = my_profile if my_profile != "custom" else ""
     if me and owner_gw == me and (not worker or run_on == me):
diff --git a/tests/hermes_cli/test_kanban_notify_subscribe_target.py b/tests/hermes_cli/test_kanban_notify_subscribe_target.py
new file mode 100644
index 00000000000..5d0b4c0b569
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_notify_subscribe_target.py
@@ -0,0 +1,83 @@
+"""``hermes kanban notify-subscribe --platform tui`` says which chat it binds. [daveey]
+
+agent-884fdd96f8: an agent ran the subscribe with another chat's id (a wrong hint), read back the subscriber ids
+and reported the card linked to its own chat. The command now prints the target chat's title, and a WARNING when
+the calling agent's chat (HERMES_SESSION_KEY / HERMES_SESSION_ID in its env) is a different chat.
+"""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+
+import pytest
+
+import gateway.session_context as sc
+from hermes_cli import kanban as kc
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+
+MINE, OTHER = "20261103_032737_aaaaaa", "20261102_172718_bbbbbb"
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    for var in ("HERMES_SESSION_KEY", "HERMES_SESSION_ID", "HERMES_KANBAN_TASK"):
+        monkeypatch.delenv(var, raising=False)
+    kb.init_db()
+    from hermes_state import SessionDB
+    db = SessionDB(db_path=home / "state.db")
+    try:
+        db.create_session(session_id=MINE, source="desktop")
+        db.set_session_title(MINE, "Repair cards for the forwarder")
+        db.create_session(session_id=OTHER, source="desktop")
+        db.set_session_title(OTHER, "Unrelated research chat")
+    finally:
+        db.close()
+    tokens = [var.set(sc._UNSET) for var in sc._VAR_MAP.values()]  # a CLI subprocess: env only
+    engaged = sc._session_context_engaged
+    sc._session_context_engaged = False
+    yield home
+    sc._session_context_engaged = engaged
+    for var, tok in zip(sc._VAR_MAP.values(), tokens):
+        var.reset(tok)
+
+
+def _subscribe(chat_id: str) -> tuple[int, str]:
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="repair", assignee="default")
+    root = argparse.ArgumentParser(prog="hermes")
+    kc.build_parser(root.add_subparsers())
+    args = root.parse_args(["kanban", "notify-subscribe", tid, "--platform", "tui", "--chat-id", chat_id])
+    return kc._cmd_notify_subscribe(args), tid
+
+
+def test_subscribe_names_the_target_chat(home, monkeypatch, capsys):
+    monkeypatch.setenv("HERMES_SESSION_ID", MINE)
+    rc, _ = _subscribe(MINE)
+    out = capsys.readouterr()
+    assert rc == 0
+    assert "Repair cards for the forwarder" in out.out
+    assert "WARNING" not in out.out + out.err
+
+
+def test_subscribe_warns_when_binding_a_different_chat(home, monkeypatch, capsys):
+    monkeypatch.setenv("HERMES_SESSION_ID", MINE)
+    rc, _ = _subscribe(OTHER)
+    out = capsys.readouterr()
+    text = out.out + out.err
+    assert rc == 0
+    assert "WARNING: binding a different chat (Unrelated research chat)" in text, text
+    assert MINE in text
+
+
+def test_subscribe_from_a_plain_shell_does_not_warn(home, capsys):
+    rc, _ = _subscribe(OTHER)
+    out = capsys.readouterr()
+    assert rc == 0 and "WARNING" not in out.out + out.err
+    assert "Unrelated research chat" in out.out
