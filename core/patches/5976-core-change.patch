From dbe843adeb2f9c299a92079f0c7ab46f91714310 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 18:27:09 +0000
Subject: [PATCH 5976] Desktop startup-timeout recovery and gateway-drain retry

Public mirror of source commit dbe843adeb2f9c299a92079f0c7ab46f91714310.

---
diff --git a/apps/desktop/electron/review-readiness-deadline.test.ts b/apps/desktop/electron/review-readiness-deadline.test.ts
new file mode 100644
index 00000000000..bf292cf2748
--- /dev/null
+++ b/apps/desktop/electron/review-readiness-deadline.test.ts
@@ -0,0 +1,28 @@
+import { expect, it } from 'vitest'
+
+import { isBackendReadinessTimeout } from '../../shared/src/backend-readiness-timeout'
+
+import { shouldLatchBackendStartFailure } from './backend-start-failure'
+import { ensureLocalGateway } from './local-gateway'
+
+it.each([undefined, 'Still starting.'])('canonical starting/deadline remains recoverable (detail: %s)', async detail => {
+  const error = await ensureLocalGateway(async () => ({
+    code: 5,
+    stdout: JSON.stringify({ state: 'starting', reason_code: 'deadline', detail })
+  })).catch((error: unknown) => error)
+
+  expect(error).toBeInstanceOf(Error)
+  expect(isBackendReadinessTimeout(error)).toBe(true)
+  expect(shouldLatchBackendStartFailure({ attemptedRemote: false, error })).toBe(false)
+  expect(isBackendReadinessTimeout(error, 'connecting')).toBe(false)
+})
+
+it.each([
+  { state: 'incompatible', reason_code: 'deadline' },
+  { state: 'starting', reason_code: 'update_paused' },
+  { state: 'failed', reason_code: 'deadline' }
+])('does not retry a terminal ensure verdict: %j', async verdict => {
+  const error = await ensureLocalGateway(async () => ({ code: 5, stdout: JSON.stringify(verdict) })).catch((error: unknown) => error)
+  expect(isBackendReadinessTimeout(error)).toBe(false)
+  expect(shouldLatchBackendStartFailure({ attemptedRemote: false, error })).toBe(true)
+})
diff --git a/apps/desktop/src/app/gateway/hooks/use-gateway-boot-timeout.test.tsx b/apps/desktop/src/app/gateway/hooks/use-gateway-boot-timeout.test.tsx
index a12ff2121a6..c194ad1f4fc 100644
--- a/apps/desktop/src/app/gateway/hooks/use-gateway-boot-timeout.test.tsx
+++ b/apps/desktop/src/app/gateway/hooks/use-gateway-boot-timeout.test.tsx
@@ -188,6 +188,24 @@
   view.unmount()
 })
 
+it('keeps recovery alive after the canonical ensure deadline verdict', async () => {
+  const desktop = fakeDesktop()
+  const pending = deferred<typeof primaryConn>()
+  desktop.getConnection.mockImplementationOnce(() => pending.promise)
+  desktop.getConnection.mockRejectedValueOnce(new Error('Gateway starting (deadline). Use hermes gateway status for recovery.'))
+  ;(window as { hermesDesktop?: unknown }).hermesDesktop = desktop
+  const refreshSessions = vi.fn(async () => undefined)
+  render(<Harness refreshSessions={refreshSessions} />)
+  await act(async () => { await vi.advanceTimersByTimeAsync(BACKEND_BOOT_WAIT_TIMEOUT_MS) })
+  expect($desktopBoot.get().error).toMatch(/Timed out connecting/)
+  await act(async () => { await vi.advanceTimersByTimeAsync(2_001) })
+  expect($desktopBoot.get().error).toMatch(/Gateway starting \(deadline\)/)
+  await act(async () => { await vi.advanceTimersByTimeAsync(4_001) })
+  expect.soft(desktop.getConnection.mock.calls.length).toBe(3)
+  expect.soft(refreshSessions).toHaveBeenCalledOnce()
+  expect.soft($desktopBoot.get().error).toBeNull()
+})
+
 it('stops queued recovery on unmount and ignores a late original readiness reply', async () => {
   const desktop = fakeDesktop()
   const pending = deferred<typeof primaryConn>()
diff --git a/apps/shared/src/backend-readiness-timeout.ts b/apps/shared/src/backend-readiness-timeout.ts
index 1179c82ae33..934e37c7c2d 100644
--- a/apps/shared/src/backend-readiness-timeout.ts
+++ b/apps/shared/src/backend-readiness-timeout.ts
@@ -1,6 +1,9 @@
 /** Readiness timeouts are observations, not proof of a broken local install. */
 export function isBackendReadinessTimeout(error: unknown, stage = 'resolving'): boolean {
   return (
-    stage === 'resolving' && error instanceof Error && /timed out.*(?:Hermes backend|backend port)/i.test(error.message)
+    stage === 'resolving' && error instanceof Error && (
+      /timed out.*(?:Hermes backend|backend port)/i.test(error.message)
+      || /^Gateway starting \(deadline\)\./.test(error.message)
+    )
   )
 }
