From 0335b11c310170a08782d78efdd0ca490bd85574 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 22:34:58 +0000
Subject: [PATCH] fix(kanban): keep forwarder transport keys separate from
 create identity [daveey]

---
 hermes_cli/kanban_placement.py                |  6 ++++--
 hermes_cli/kanban_placement_forward.py        |  7 ++++---
 tests/hermes_cli/test_kanban_placement.py     |  6 ++----
 .../test_kanban_placement_identity.py         | 21 ++++++++++++++-----
 tools/kanban_tools.py                         |  4 ++--
 5 files changed, 28 insertions(+), 16 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index c5cc7c4034b..d7cabc82e87 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -869,7 +869,8 @@ def remote_body(args: dict, *, self_gw: str, target: str, carried: bool = False)
 
 
 def create_remote(args: dict, *, target: str, origin_session: Optional[str], origin_profile: str,
-                  self_gw: str, cfg: Optional[dict] = None, hub_cli: str = "hermes-hub") -> dict:
+                  self_gw: str, cfg: Optional[dict] = None, hub_cli: str = "hermes-hub",
+                  transport_key: Optional[str] = None) -> dict:
     """Queue on ``target``; a fatal refusal must not fall back to a second local card."""
     c = _Cfg(config() if cfg is None else cfg)
     carried = hub_carries_options(hub_cli)
@@ -879,7 +880,8 @@ def create_remote(args: dict, *, target: str, origin_session: Optional[str], ori
         options = carried_options(args) if carried else {}
     except (TypeError, ValueError) as exc:
         return {"ok": False, "fatal": True, "error": str(exc)}
-    rid = request_id(self_gw, args, origin_session or "", options)
+    transport_args = {**args, "idempotency_key": transport_key} if transport_key else args
+    rid = request_id(self_gw, transport_args, origin_session or "", options)
     prior = remote_state(rid)
     if prior in ("queued", "sent", "done") and not options.get("idempotency_key"):
         # Content-addressed retries need no send. Explicit keys must let the courier compare
diff --git a/hermes_cli/kanban_placement_forward.py b/hermes_cli/kanban_placement_forward.py
index 9fae8121cab..2c7afe8db48 100644
--- a/hermes_cli/kanban_placement_forward.py
+++ b/hermes_cli/kanban_placement_forward.py
@@ -443,8 +443,7 @@ def remote_args(conn: sqlite3.Connection, task, *, self_gw: str) -> dict:
         "model": task.model_override, "provider": task.provider_override if task.model_override else None,
         "goal_mode": bool(task.goal_mode), "goal_max_turns": task.goal_max_turns if task.goal_mode else None,
         "completion_contract": task.completion_contract,
-        # One request per local card: a re-forward after a crash maps to the same hub request.
-        "idempotency_key": f"placement-forward:{self_gw}:{task.id}",
+
     }
 
 
@@ -498,7 +497,9 @@ class Forwarder:
         args = remote_args(self.conn, task, self_gw=self.self_gw)
         placed = self.create(args, target=target, origin_session=st.get("origin_session"),
                              origin_profile=st.get("origin_profile") or "default", self_gw=self.self_gw,
-                             cfg=self.cfg, hub_cli=self.hub_cli)
+                             cfg=self.cfg, hub_cli=self.hub_cli,
+                             # This is transport identity, not a caller's receiver-side creation key.
+                             transport_key=f"placement-forward:{self.self_gw}:{task.id}")
         if not placed.get("ok"):
             return self._cancel(f"{target} refused the card: {placed.get('error')}")
         rid = placed["request_id"]
diff --git a/tests/hermes_cli/test_kanban_placement.py b/tests/hermes_cli/test_kanban_placement.py
index f104cd86a18..6afa9026b45 100644
--- a/tests/hermes_cli/test_kanban_placement.py
+++ b/tests/hermes_cli/test_kanban_placement.py
@@ -1086,9 +1086,7 @@ def _forwarder(conn, tid, mac, monkeypatch, *, check=(1, "x"), await_tid=HUB_TID
     from hermes_cli import kanban_db as kb
     from hermes_cli import kanban_placement_forward as kpf
     from hermes_cli import kanban_wait_check as kwait
-    # Forwarding carries an explicit creation key and requires a field-capable courier.
-    mac["result"]["help"] = NEW_HELP
-    monkeypatch.setattr(kp, "_help_cache", {})
+
     monkeypatch.setattr(kwait, "check_remote", lambda gw, kind, tid_, **kw: (1, f"{tid_} ready"))
     claimed = kb.claim_task(conn, tid)
     assert claimed is not None
@@ -1149,7 +1147,7 @@ def test_forwarder_sends_the_card_with_parent_handoffs_and_parks_until_the_hub_c
         assert argv[argv.index("--origin-session") + 1] == "20261027_183000_abc123"
         body = argv[argv.index("--body") + 1]
         assert body.startswith("Push it.") and "fanned out; lint fix is the child" in body and child in body
-        assert _options(mac["calls"][0])["max_runtime_seconds"] == 900  # options travel with the card
+        assert "Runtime budget asked by the creator: 900 s." in body  # options travel with the card
         t = kb.get_task(conn, child)
         assert t.status == "scheduled"
         ev = [e for e in kb.list_events(conn, child) if e.kind == "scheduled"][-1]
diff --git a/tests/hermes_cli/test_kanban_placement_identity.py b/tests/hermes_cli/test_kanban_placement_identity.py
index 72f0238bb15..091f2df9c06 100644
--- a/tests/hermes_cli/test_kanban_placement_identity.py
+++ b/tests/hermes_cli/test_kanban_placement_identity.py
@@ -141,16 +141,27 @@ def test_legacy_auto_create_keeps_explicit_key_locally(mac):
         assert conn.execute("SELECT idempotency_key FROM tasks WHERE id=?", (out["task_id"],)).fetchone()[0] == args["idempotency_key"]
 
 
-def test_legacy_forwarder_falls_back_without_sending_a_lossy_request(mac, monkeypatch):
+@pytest.mark.parametrize("modern", [False, True])
+def test_forwarder_transport_identity_survives_pre_receipt_crash(mac, monkeypatch, modern):
     from hermes_cli import kanban_db as kb
     from hermes_cli import kanban_db_connect as kbc
+    from hermes_cli import kanban_placement_forward as kpf
     from tools import kanban_tools as kt
     with kbc.connect_closing() as conn:
         parent = helpers._done_parent(kb, conn)
         child = json.loads(kt._handle_create({"title": "Separate work", "parents": [parent]}))["task_id"]
         kb.recompute_ready(conn)
         forwarder = helpers._forwarder(conn, child, mac, monkeypatch)
-        monkeypatch.setattr(kp, "hub_carries_options", lambda cli: False)
-        assert forwarder.run() == "fallback"
-        assert kb.get_task(conn, child).status == "running"
-    assert mac["calls"] == []
+        monkeypatch.setattr(kp, "hub_carries_options", lambda cli: modern)
+        args = kpf.remote_args(conn, kb.get_task(conn, child), self_gw="macbook")
+        key = f"placement-forward:macbook:{child}"
+        sent = kp.create_remote(args, target="hub", self_gw="macbook", origin_session=None,
+                                origin_profile="default", cfg={}, transport_key=key)
+        assert sent["request_id"] == kp.request_id("macbook", {**args, "idempotency_key": key}, "")
+        assert "idempotency_key" not in helpers._options(mac["calls"][0])
+        # The courier accepted the request before FORWARDED was recorded. A parent edit
+        # must not make recovery execute a duplicate locally or enqueue a second envelope.
+        monkeypatch.setattr(kpf, "remote_args", lambda *a, **kw: {**args, "body": "Changed parent handoff"})
+        assert forwarder.run() == "parked"
+        assert kb.get_task(conn, child).status == "scheduled"
+    assert len(mac["calls"]) == 1
diff --git a/tools/kanban_tools.py b/tools/kanban_tools.py
index 372237960c9..d1c7561e8b7 100644
--- a/tools/kanban_tools.py
+++ b/tools/kanban_tools.py
@@ -1536,8 +1536,8 @@ def _place_remote(args: dict, *, assignee: str, skills, parents, project_id, ses
                        note=note), None
         note = (f"{retry}The card IS created: it is queued on {target} as request {rid} and {target} makes the "
                 f"card from it (it runs there, not here: {decision['why']}). Do NOT call kanban_create again "
-                "for this card: an identical call returns this same request, and any changed call creates a "
-                f"second, duplicate card. Its task id appears once {target} applies the request "
+                "for this card: an identical call returns this same request. Changed calls with an explicit "
+                f"creation key are refused; without one they may duplicate. Its task id appears when {target} applies it "
                 + ("(this chat's tasks, " if session_id else "(")
                 + "`hermes-hub requests`).")
         return _ok(task_id=None, status="queued", **fields, runs_where=target, note=note), None
-- 
2.55.0

