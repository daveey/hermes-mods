From 5780449cad0ad99ed1cead5cb70382c0b245f200 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 06:59:49 +0000
Subject: [PATCH] test: wait on the turn thread, not the clock, in the
 busy-chat send test [daveey]

---
 tests/gateway/test_busy_chat_send_queues_behind_turn.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/gateway/test_busy_chat_send_queues_behind_turn.py b/tests/gateway/test_busy_chat_send_queues_behind_turn.py
index 21db0f68288..90ae19f45ca 100644
--- a/tests/gateway/test_busy_chat_send_queues_behind_turn.py
+++ b/tests/gateway/test_busy_chat_send_queues_behind_turn.py
@@ -81,7 +81,7 @@ def _user_rows(db):
 def _assert_queued_then_processed(db, agent, holder, text):
     with patch("model_tools.get_tool_definitions", return_value=[]):
         thread, outcome = _send(agent, text)
-        time.sleep(2.5)  # a refusing admission returns at once; a queued one is still waiting
+        thread.join(2.5)  # a refusing admission ends the turn at once; a queued one is still waiting
         assert thread.is_alive(), f"refused while the turn ran: {outcome.get('result', {}).get('final_response')}"
         assert db.session_turn_lease_owner(SID)["holder"] == holder, "the running turn kept the chat"
         assert text not in _user_rows(db), "nothing of the queued send ran beside the running turn"
-- 
2.55.0

