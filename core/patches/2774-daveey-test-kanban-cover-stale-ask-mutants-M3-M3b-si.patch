From 2116307ca706732a22854e8d40e0e800f4b076c9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 14:07:07 +0000
Subject: [PATCH] [daveey] test(kanban): cover stale-ask mutants M3/M3b
 (since_line + F8 guards) and M6 (tui unkeyed submit)

Each still-blocked guard in kanban_stale_ask was only covered together with
the other one, and the tui unkeyed verdict's submit text (batch_text) was
never exercised. The new cases fail on each exact-anchor mutant from verify
card t_01a1d00515fc7eea and pass on main. Card t_01a1d01204fc25fe.
---
 tests/gateway/test_kanban_stale_block_ask.py  | 35 +++++++++++++++++++
 .../test_kanban_notice_stale_ask_buffered.py  | 29 +++++++++++++++
 2 files changed, 64 insertions(+)

diff --git a/tests/gateway/test_kanban_stale_block_ask.py b/tests/gateway/test_kanban_stale_block_ask.py
index fb256c5bb6..36ec7be0c5 100644
--- a/tests/gateway/test_kanban_stale_block_ask.py
+++ b/tests/gateway/test_kanban_stale_block_ask.py
@@ -4,6 +4,7 @@ The wake text is rendered when the card blocks, then waits behind the running tu
 notice for t_01a1cd4dbbc27e50 (blocked 19:26, unblocked 20:08, done 20:25 PST) reached its Desktop
 chat at 22:14 still saying "Next action for the user: Reply ...".
 """
+import json
 from types import SimpleNamespace
 
 import pytest
@@ -400,6 +401,40 @@ def test_gave_up_into_triage_without_a_new_ask_says_it_no_longer_applies(tmp_pat
     assert "This ask no longer applies" in out and "now triage" in out
 
 
+def test_still_blocked_card_whose_live_ask_was_cleared_keeps_the_ask(tmp_path, monkeypatch):
+    """Still blocked with no transition since the notice's block, but the live ``tasks.human_request`` no
+    longer renders to this ask (cleared here), so the live-ask guard in ``_stale_line`` cannot keep it:
+    ``since_line``'s own still-blocked guard must (mutant M3 of t_01a1d00515fc7eea)."""
+    from hermes_cli.kanban_db_connect import connect_closing
+    from hermes_cli.kanban_stale_ask import refresh_stale_ask
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    for status in ("blocked", "triage"):
+        tid, task = _blocked_card()
+        text = _wake_text(tid, task)
+        with connect_closing() as conn:
+            conn.execute("UPDATE tasks SET status=?, human_request=NULL WHERE id=?", (status, tid))
+            conn.commit()
+        assert refresh_stale_ask(text) == text, status
+
+
+def test_live_ask_equal_to_the_notice_keeps_it_past_a_reblock_event_without_a_request(tmp_path, monkeypatch):
+    """Review F8 guard on its own: unblocked, then re-blocked by an event that carries no human_request
+    while the card's live ask is still this very ask. ``since_line`` alone would call it replaced; the
+    live-ask guard keeps the notice byte-identical (mutant M3b of t_01a1d00515fc7eea)."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_db_connect import connect_closing
+    from hermes_cli.kanban_stale_ask import refresh_stale_ask
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    tid, task = _blocked_card()
+    text = _wake_text(tid, task)
+    with connect_closing() as conn:
+        assert kb.unblock_task(conn, tid)
+        kb._append_event(conn, tid, "blocked", {"reason": "Choose coverage"})
+        conn.execute("UPDATE tasks SET status='blocked', human_request=? WHERE id=?", (json.dumps(REQUEST), tid))
+        conn.commit()
+    assert refresh_stale_ask(text) == text
+
+
 def test_many_ask_marks_on_one_long_line_are_fast(tmp_path, monkeypatch):
     """Review F9: tens of thousands of ask marks on one long line must not cost seconds."""
     import time
diff --git a/tests/tui_gateway/test_kanban_notice_stale_ask_buffered.py b/tests/tui_gateway/test_kanban_notice_stale_ask_buffered.py
index 7c6c5f16be..2a8fe6332a 100644
--- a/tests/tui_gateway/test_kanban_notice_stale_ask_buffered.py
+++ b/tests/tui_gateway/test_kanban_notice_stale_ask_buffered.py
@@ -105,6 +105,35 @@ def test_buffered_block_notice_for_a_finished_card_drops_the_ask(gate, sdb):
     assert original.split(ASK)[0] in submitted, "the notice itself stays"
 
 
+def test_unkeyed_buffered_block_notice_for_a_finished_card_drops_the_ask(gate, monkeypatch):
+    """No session store for the chat: ``_kb_persist_batch`` returns ``unkeyed`` and writes no row, so the
+    submitted text comes from ``batch_text`` itself, which must still re-read the card (mutant M6 of
+    t_01a1d00515fc7eea: a raw join of the buffered texts survived the ``written``-only tests)."""
+    @contextlib.contextmanager
+    def _no_store(session):
+        yield None
+
+    monkeypatch.setattr(server, "_session_db", _no_store)
+    tid = _blocked_card()
+    busy = _session(running=True)
+    server._notif_poll_kanban_scoped("ui", busy)
+    assert gate["submitted"] == []
+    buffered = next(t for t in busy["_kanban_pending"] if ASK in t)
+    assert f"Open task: @task:default/{tid}" in buffered
+    _finish(tid)
+    busy["_kanban_refused_until"] = float("inf")
+    with busy["history_lock"]:
+        busy["running"] = False
+    assert server._kb_persist_batch(busy, list(busy["_kanban_pending"]), False)[0] == "unkeyed"
+    server._notif_poll_kanban_scoped("ui", busy)
+    assert len(gate["submitted"]) == 1, "the buffered batch runs as one turn once the chat is idle"
+    submitted = gate["submitted"][0]
+    assert ASK not in submitted, "the card finished while the notice waited: no decision is left to ask for"
+    assert "Why only the user" not in submitted
+    assert "Since then: unblocked" in submitted and "No action needed." in submitted
+    assert "Scope: Only the standalone Docker integration acceptance." in submitted
+
+
 def test_buffered_block_notice_for_a_still_blocked_card_is_byte_identical(gate, sdb):
     original, row, submitted = _buffer_then_deliver(gate, sdb, lambda tid: None)
     assert submitted == original
