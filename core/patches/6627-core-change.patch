+  $projectTreeLoading.set(false)
+  $projectTree.set(tree)
+  $sessions.set([...rows, other, home].map(row => ({ ...row, kanban_observed_at: Date.now() / 1000 })))
+})
+afterEach(() => {
+  cleanup()
+  resetSidebarView()
+  $projectScope.set(ALL_PROJECTS)
+  $projectTree.set([])
+  $sessions.set([])
+  $removedSessionIds.set(new Set())
