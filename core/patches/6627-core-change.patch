+  try {
+    mount()
+    expect($projectScope.get()).toBe('/b')
+    expect(screen.getByText('Project B')).toBeTruthy()
+    expect(screen.queryByText('Project A')).toBeNull()
+  } finally {
+    act(dispose)
+  }
+})
