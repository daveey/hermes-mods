From: daveey <daveey@users.noreply.github.com>
Date: Tue, 10 Nov 2026 23:32:58 +0000
Subject: [PATCH] fix(kanban): read foreign parents from the Board replica
 [daveey]

---
 tests/tools/test_kanban_show_replica.py | 76 +++++++++++++++++++++++++
 tools/kanban_show.py                    | 74 ++++++++++++++++--------
 2 files changed, 125 insertions(+), 25 deletions(-)
 create mode 100644 tests/tools/test_kanban_show_replica.py

diff --git a/tests/tools/test_kanban_show_replica.py b/tests/tools/test_kanban_show_replica.py
new file mode 100644
index 00000000000..00294aada08
--- /dev/null
+++ b/tests/tools/test_kanban_show_replica.py
@@ -0,0 +1,76 @@
+"""Tool reads must see a foreign parent without importing it into the live board."""
+import json
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_sync as sync
+from tools import kanban_tools as kt
+
+
+@pytest.fixture
+def boards(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    for key in ("HERMES_KANBAN_DB", "HERMES_KANBAN_BOARD", "HERMES_KANBAN_TASK"):
+        monkeypatch.delenv(key, raising=False)
+    monkeypatch.setattr(sync, "sync_config", lambda: {"enabled": True, "boards": ["default"]})
+    kb.init_db()
+    shadow = home / "kanban" / sync.SHADOW_DIR / "default.db"
+    shadow.parent.mkdir(parents=True, exist_ok=True)
+    with kbc.connect(shadow) as replica:
+        tid = kb.create_task(replica, title="Foreign parent", assignee="default")
+        kb.add_comment(replica, tid, author="owner", body="Parent evidence")
+        if "created_on" not in {r[1] for r in replica.execute("PRAGMA table_info(tasks)")}:
+            replica.execute("ALTER TABLE tasks ADD COLUMN created_on TEXT")
+        replica.execute("UPDATE tasks SET created_on = 'owner-gateway' WHERE id = ?", (tid,))
+    return tid, shadow
+
+
+def test_foreign_parent_read_is_labelled_and_does_not_import(boards):
+    tid, shadow = boards
+    out = json.loads(kt._handle_show({"task_id": tid}))
+    assert out.get("source") == "replica", out
+    assert out["owner"] == "owner-gateway"
+    assert out["task"]["id"] == tid
+    assert [c["body"] for c in out["comments"]] == ["Parent evidence"]
+    assert "queue" not in out
+    assert "queue_hint" not in out
+    assert "worker_context" in out
+    with kbc.connect() as live:
+        assert kb.get_task(live, tid) is None
+    with kbc.connect(shadow) as replica:
+        assert len(kb.list_comments(replica, tid)) == 1
+
+
+def test_disabled_sync_does_not_read_foreign_card(boards, monkeypatch):
+    tid, _ = boards
+    monkeypatch.setattr(sync, "sync_config", lambda: {"enabled": False})
+    out = json.loads(kt._handle_show({"task_id": tid}))
+    assert "not found" in out["error"]
+
+
+def test_missing_card_remains_not_found(boards):
+    out = json.loads(kt._handle_show({"task_id": "t_missing"}))
+    assert "not found" in out["error"]
+
+
+def test_live_card_wins_over_replica(boards, monkeypatch):
+    tid, _ = boards
+    monkeypatch.setattr(sync, "new_task_id", lambda conn: tid)
+    with kbc.connect() as live:
+        assert kb.create_task(live, title="Live card", assignee="default") == tid
+    out = json.loads(kt._handle_show({"task_id": tid}))
+    assert out.get("source") == "live", out
+    assert out["task"]["title"] == "Live card"
+    assert "owner" not in out
+
+
+def test_foreign_comment_is_still_refused(boards):
+    tid, shadow = boards
+    out = json.loads(kt._handle_comment({"task_id": tid, "body": "must not land"}))
+    assert out.get("rejection") == "foreign_card", out
+    with kbc.connect(shadow) as replica:
+        assert [c.body for c in kb.list_comments(replica, tid)] == ["Parent evidence"]
diff --git a/tools/kanban_show.py b/tools/kanban_show.py
index cac11fe0958..50e02ede5b3 100644
--- a/tools/kanban_show.py
+++ b/tools/kanban_show.py
@@ -3,7 +3,7 @@ import json
 
 
 def show(args: dict) -> str:
-    from hermes_cli import kanban_queue_reason as kqr
+    from hermes_cli import kanban_foreign_card as kfc
     from tools import kanban_tools as kt
 
     tid = kt._default_task_id(args.get("task_id"))
@@ -15,34 +15,58 @@ def show(args: dict) -> str:
                 "task to show by default. Call kanban_list to see task ids on "
                 "the board, then kanban_show(task_id=<id>) for full state."),
         })
+    # Retain board grants before consulting a replica; a foreign read is not a
+    # cross-board permission grant, and never imports a writable local card.
     with kt._granted_board(args.get("board"), tid) as (kb, conn, _):
-        task = kt._existing_task(kb, conn, tid)
-        from tools.kanban_tools_capsule import own_card_view
-        worker_context, capsule = own_card_view(task, tid, kb.build_worker_context(conn, tid))
-        # A card ready and unclaimed 30+ min gets its queue place and the moves that start it (kanban-447c98343f):
-        # "ready but has not started" was reported as a status instead of acted on. [daveey]
+        task = kb.get_task(conn, tid)
+        if task is not None:
+            return json.dumps(_detail(kb, conn, task, args, replica=False))
+        with kfc.open_replica(kfc._live_db_file(conn)) as replica:
+            task = kb.get_task(replica, tid) if replica is not None else None
+            if replica is not None and task is not None:
+                owner = kfc.created_on(replica, tid)
+                out = _detail(kb, replica, task, args, replica=True)
+                out["owner"] = None if owner is kfc._UNSET else owner
+                return json.dumps(out)
+        kt._existing_task(kb, conn, tid)  # preserve the existing not-found error
+    raise AssertionError("missing task lookup must reject")
+
+
+def _detail(kb, conn, task, args, *, replica: bool) -> dict:
+    from hermes_cli import kanban_queue_reason as kqr
+    from hermes_cli import kanban_queue_position as kqp
+    from tools import kanban_tools as kt
+    from tools.kanban_tools_capsule import own_card_view
+
+    tid = task.id
+    worker_context = kb.build_worker_context(conn, tid)
+    capsule = {}
+    queue = None
+    queue_hint = None
+    if not replica:
+        worker_context, capsule = own_card_view(task, tid, worker_context)
+        # Queue position and capsule identity belong to this gateway's live
+        # dispatcher, not to a replicated owner's cached task/run IDs.
         from hermes_cli.kanban_parent_unclaimed import ready_hint
         try:
             queue_hint = ready_hint(conn, task)
         except Exception:  # health: allow BLE001 -- an advisory hint must never fail the read
             queue_hint = None
-        # Every ready card says where it waits, same dict as the REST read (kanban-7d720d4ab8): a null queue_reason
-        # for a card waiting on a full hub read as stuck, and a chat ran its work outside the dispatcher. [daveey]
-        from hermes_cli import kanban_queue_position as kqp
         queue = kqp.read(conn, task, args.get("board"))
-        return json.dumps({
-            "task": kt._fields(task, kt._TASK_FIELDS),
-            **capsule,
-            "queue_reason": kqr.latest(conn, tid),
-            **kqp.fields(queue),
-            **({"queue_hint": queue_hint} if queue_hint else {}),
-            "parents": kb.parent_ids(conn, tid),
-            "unsatisfied_parents": [
-                {"id": pid, "status": status} for pid, status in kb.unsatisfied_parents(conn, tid)],
-            "children": kb.child_ids(conn, tid),
-            "comments": [kt._fields(c, kt._COMMENT_FIELDS) for c in kb.list_comments(conn, tid)],
-            "undelivered_comments": [c.id for c in kb.undelivered_live_comments(conn, tid)],
-            "events": [kt._fields(e, kt._EVENT_FIELDS) for e in kb.list_events(conn, tid)[-50:]],
-            "runs": [kt._fields(r, kt._RUN_FIELDS) for r in kb.list_runs(conn, tid)],
-            "supervisor_requests": kt._graph.supervisor_requests(conn, tid),
-            "worker_context": worker_context})
+    return {
+        "task": kt._fields(task, kt._TASK_FIELDS),
+        "source": "replica" if replica else "live",
+        **capsule,
+        "queue_reason": kqr.latest(conn, tid),
+        **kqp.fields(queue),
+        **({"queue_hint": queue_hint} if queue_hint else {}),
+        "parents": kb.parent_ids(conn, tid),
+        "unsatisfied_parents": [
+            {"id": pid, "status": status} for pid, status in kb.unsatisfied_parents(conn, tid)],
+        "children": kb.child_ids(conn, tid),
+        "comments": [kt._fields(c, kt._COMMENT_FIELDS) for c in kb.list_comments(conn, tid)],
+        "undelivered_comments": [] if replica else [c.id for c in kb.undelivered_live_comments(conn, tid)],
+        "events": [kt._fields(e, kt._EVENT_FIELDS) for e in kb.list_events(conn, tid)[-50:]],
+        "runs": [kt._fields(r, kt._RUN_FIELDS) for r in kb.list_runs(conn, tid)],
+        "supervisor_requests": kt._graph.supervisor_requests(conn, tid),
+        "worker_context": worker_context}
