From 60147f355dd44067a030bb78c6943231fb9a859b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 23:54:48 +0000
Subject: [PATCH] test(kanban): create parity accepts the requires pattern
 (profile tools + namespaced gateway needs) [daveey]

---
 tests/hermes_cli/test_kanban_create_entry_parity.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_create_entry_parity.py b/tests/hermes_cli/test_kanban_create_entry_parity.py
index 539b69ed28..a2e63fc594 100644
--- a/tests/hermes_cli/test_kanban_create_entry_parity.py
+++ b/tests/hermes_cli/test_kanban_create_entry_parity.py
@@ -13,6 +13,7 @@ from __future__ import annotations
 
 import argparse
 import json
+import re
 import sys
 from pathlib import Path
 
@@ -177,7 +178,10 @@ def test_create_requires_and_default_creator_parity(restricted_creator, surface)
     if surface == "registry":
         from tools.registry import registry
         schema = registry.get_schema("kanban_create")
-        assert "kanban" in schema["parameters"]["properties"]["requires"]["items"]["enum"]
+        items = schema["parameters"]["properties"]["requires"]["items"]
+        # Profile tool names plus namespaced gateway capability needs (cross-gateway routing).
+        assert re.fullmatch(items["pattern"], "kanban") and re.fullmatch(items["pattern"], "ssh:mini")
+        assert not re.fullmatch(items["pattern"], "bogus")
         good = json.loads(registry.dispatch("kanban_create", {"title": "Allowed", "requires": []}))
         assert good.get("task_id"), good
         bad = json.loads(registry.dispatch("kanban_create", {"title": "Denied", "requires": ["terminal"]}))
