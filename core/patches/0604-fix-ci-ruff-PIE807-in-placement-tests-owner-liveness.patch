From fd394a4611aa967ec3a15e4c389ee84efeb27768 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 04:30:35 +0000
Subject: [PATCH] fix(ci): ruff PIE807 in placement tests; owner liveness
 without os.kill(pid, 0)

Problem: HEAD 2f6f37d6 would fail the next main CI. ruff check . reports
PIE807 at tests/hermes_cli/test_kanban_placement.py:393 and :418. Windows
footguns flags tools/browser_use_cli.py:738 os.kill(pid, 0).

Why: fc317cf6 stubbed kanban_placement.config with `lambda: {}`. config()
takes no args, so the lambda is a useless wrapper around dict(). 4c6a424f
probed owner liveness with os.kill(pid, 0), which on Windows is
CTRL_C_EVENT for the whole console group (bpo-14484).

Why not caught: both commits landed while main's concurrency group was
cancelling every newer run behind 529b6c9f, so ruff and the footgun job
never finished on those shas.

Fix: setattr config to dict (same pattern as the daemon-reap tests).
_owner_alive now uses gateway.status._pid_exists, which is the repo's
cross-platform probe and treats zombies as dead.
---
diff --git a/tests/hermes_cli/test_kanban_placement.py b/tests/hermes_cli/test_kanban_placement.py
index 1d239ce26c3b4db606ac0f6b91b24dc1aed314af..b487bcd090aea3a9f1e5551fb1088ec2cb6b0723 100644
--- a/tests/hermes_cli/test_kanban_placement.py
+++ b/tests/hermes_cli/test_kanban_placement.py
@@ -390,7 +390,7 @@ def test_pin_to_an_unrouted_gateway_is_refused_not_created_locally(mac, pin):
 def test_pin_to_a_gateway_when_no_route_is_configured_is_refused(mac, monkeypatch):
     # The reported case: a hub worker (no route on the hub) pinned placement='macbook'.
     from tools import kanban_tools as kt
-    monkeypatch.setattr(kp, "config", lambda: {})
+    monkeypatch.setattr(kp, "config", dict)
     monkeypatch.setattr(reg, "self_gateway", lambda: "hub")
     out = json.loads(kt._handle_create({"title": "MacBook-only drill", "placement": "macbook"}))
     assert not out.get("ok") and out["code"] == "placement_unavailable", out
@@ -415,7 +415,7 @@ def test_pin_local_or_own_gateway_still_creates_locally(mac, pin):
 
 def test_own_gateway_pin_creates_locally_with_no_route_configured(mac, monkeypatch):
     from tools import kanban_tools as kt
-    monkeypatch.setattr(kp, "config", lambda: {})
+    monkeypatch.setattr(kp, "config", dict)
     monkeypatch.setattr(reg, "self_gateway", lambda: "hub")
     out = json.loads(kt._handle_create({"title": "Hub drill", "placement": "hub"}))
     assert out["ok"] and out["task_id"] and _local_count() == 1
