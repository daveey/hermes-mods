From a15f099682d6446a352609c6077f6abda44e87fa Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 18:15:20 -0800
Subject: [PATCH] fix(doctor): base64 padding is not a NAME=value assignment

Review follow-up: a padded random token (Zm9v...MA==, Xy9k...abc=) matched
the assignment pattern, its random 'name' was never judged and its value
'=' is no secret, so it printed in full. A token is an assignment only when
its value is non-empty, does not start with '=' and its name does not itself
look like a random token; otherwise it is judged whole. Tested.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_state_argv_secrets.py            | 7 +++++--
 tests/hermes_state/test_argv_secrets.py | 5 +++++
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/hermes_state_argv_secrets.py b/hermes_state_argv_secrets.py
index 3b327073d50..14d548bb1c0 100644
--- a/hermes_state_argv_secrets.py
+++ b/hermes_state_argv_secrets.py
@@ -100,8 +100,11 @@ def mask_argv_secrets(argv: list[str]) -> list[str]:
                 out.append(token)
                 mask_next = secret_named
             continue
-        if assignment := _ASSIGNMENT.match(token):  # ssh -o ServerAliveInterval=15, env-style NAME=value
-            name, value = assignment.group(1), token[assignment.end():]
+        assignment = _ASSIGNMENT.match(token)
+        name, value = (assignment.group(1), token[assignment.end():]) if assignment else ("", "")
+        # ssh -o ServerAliveInterval=15, env-style NAME=value -- not base64 padding (``Zm9v…MA==``: a random "name"
+        # followed by "=" or nothing), which is judged as one token below.
+        if assignment and value and not value.startswith("=") and not _looks_like_bare_secret(name):
             out.append(f"{name}={_mask_value(value, secret_named=_is_secret_flag('--' + name))}")
             continue
         out.append(_mask_value(token, secret_named=False))
diff --git a/tests/hermes_state/test_argv_secrets.py b/tests/hermes_state/test_argv_secrets.py
index 23454051732..3dc280cf711 100644
--- a/tests/hermes_state/test_argv_secrets.py
+++ b/tests/hermes_state/test_argv_secrets.py
@@ -57,6 +57,11 @@ KEY = "q8ZpL2vXk9RtYwB4mN7cQ1sD5fH3jK6g"
             ],
             ["--auth-header", MASK, f"--private-key-pem={MASK}", "--apikey", MASK],
         ),
+        # base64 padding is not an assignment: a padded random token is masked whole
+        (
+            ["Zm9vYmFyYmF6cXV4MTIzNDU2Nzg5MA==", "Xy9kq2LmZp4Rt7Wb3NcQ8abc="],
+            [MASK, MASK],
+        ),
         # NAME=value assignments: the value is judged under its name
         (
             ["API_TOKEN=abc123", "Config=" + KEY],
-- 
2.43.0

