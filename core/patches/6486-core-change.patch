From: daveey <daveey@users.noreply.github.com>
Date: Wed, 25 Nov 2026 14:52:54 +0000
Subject: [PATCH 6486] Lane PR observations and CI park whole-commit wait

Public mirror of source commit 6bee359584bf75e9908ecbe44e9d3ce5a3f2c848.

---
diff --git a/hermes_cli/kanban_lanes_flow_pr.py b/hermes_cli/kanban_lanes_flow_pr.py
index bc7598ea02c..8c12edffe6d 100644
--- a/hermes_cli/kanban_lanes_flow_pr.py
+++ b/hermes_cli/kanban_lanes_flow_pr.py
@@ -59,6 +59,7 @@
     def __init__(self, budget=BUDGET_S):
         self.deadline = time.monotonic() + budget
         self.cache = {}
+        self.states = {}  # successful provider states, including unclassified CLOSED
 
     def _read(self, argv):
         from hermes_cli.kanban_db_dispatch_pr_state import _gh_argv
@@ -73,7 +74,7 @@
             result = subprocess.run(
                 [*gh, *argv], stdin=subprocess.DEVNULL, capture_output=True,
                 text=True, encoding="utf-8", errors="replace", timeout=remaining,
-                env=build_subprocess_env(), check=False)
+                env={**build_subprocess_env(), "GH_SHIM_PARENT": "lanes-flow"}, check=False)
             return json.loads(result.stdout) if result.returncode in (0, 8) else None
         except (OSError, subprocess.SubprocessError, ValueError):
             return None
@@ -112,5 +113,7 @@
                     out["checks"] = "red"
                 elif "pending" in buckets:
                     out["checks"] = "pending"
+        if state in ("OPEN", "MERGED", "CLOSED"):
+            self.states[url] = state
         self.cache[url] = out
         return out
diff --git a/tests/hermes_cli/test_kanban_lanes_flow_pr.py b/tests/hermes_cli/test_kanban_lanes_flow_pr.py
index cade02de5e3..c25492961c3 100644
--- a/tests/hermes_cli/test_kanban_lanes_flow_pr.py
+++ b/tests/hermes_cli/test_kanban_lanes_flow_pr.py
@@ -138,3 +138,26 @@
     assert time.monotonic() - start < 9
     for url in urls:
         assert reader.get(url) == {"merged": False, "approved": True, "checks": "green"}
+
+
+def test_child_attribution_and_terminal_state_are_observed_without_global_env(tmp_path, monkeypatch):
+    import os
+    script = tmp_path / 'attributed_gh.py'
+    script.write_text(
+        "import os,json\n"
+        "assert os.environ['GH_SHIM_PARENT'] == 'lanes-flow'\n"
+        "print(json.dumps({'state':'CLOSED'}))\n")
+    monkeypatch.setenv('GH_SHIM_PARENT', 'unrelated-parent')
+    monkeypatch.setattr(shared, '_gh_argv', lambda: [sys.executable, str(script)])
+    reader = Reader()
+    url = 'https://github.com/example/repo/pull/7'
+    assert reader.get(url) == {}
+    assert reader.states[url] == 'CLOSED'
+    assert os.environ['GH_SHIM_PARENT'] == 'unrelated-parent'
+
+
+def test_failed_or_unconfirmed_observation_has_no_success_state(monkeypatch):
+    monkeypatch.setattr(Reader, '_read', lambda self, argv: None)
+    reader = Reader()
+    assert reader.get('https://github.com/example/repo/pull/8') == {}
+    assert reader.states == {}
