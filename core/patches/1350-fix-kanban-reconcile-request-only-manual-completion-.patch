From 418247b0b1d0f52f56e8c323f361c924f41f07b6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 22:33:04 +0000
Subject: [PATCH] fix(kanban): reconcile request-only manual completion without
 waiting [daveey]

---
 hermes_cli/kanban_placement_forward.py    |  6 +++---
 tests/hermes_cli/test_kanban_placement.py | 22 ++++++++++++++++++++++
 2 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_placement_forward.py b/hermes_cli/kanban_placement_forward.py
index 0e5e9b92fcd..0dd5b013501 100644
--- a/hermes_cli/kanban_placement_forward.py
+++ b/hermes_cli/kanban_placement_forward.py
@@ -211,13 +211,13 @@ def forward_archive(conn: sqlite3.Connection, task_id: str, *, runner: Optional[
 
 def sweep_unresolved_archives(conn: sqlite3.Connection, *, now: Optional[float] = None,
                               runner: Optional[Callable] = None) -> list[str]:
-    """Dispatcher tick: send the archive for each archived card whose last ``placement_archive_forwarded`` is
+    """Dispatcher tick: send the archive for each archived/done card whose last ``placement_archive_forwarded`` is
     ``unresolved`` once the target's card id reached this gateway's hub replica (no waiting here: the tick reads
     the replica only). A card still unresolved after :data:`ARCHIVE_SWEEP_GIVE_UP` gets an ``expired`` event and
     a comment, and is not swept again. Returns the ids whose archive request was sent."""
     now = time.time() if now is None else now
     rows = conn.execute(
-        "SELECT t.id FROM tasks t WHERE t.status = 'archived' AND EXISTS "
+        "SELECT t.id FROM tasks t WHERE t.status IN ('archived', 'done') AND EXISTS "
         "(SELECT 1 FROM task_events e WHERE e.task_id = t.id AND e.kind = ?)", (ARCHIVE_FORWARDED,)).fetchall()
     sent: list[str] = []
     for (task_id,) in rows:
@@ -270,7 +270,7 @@ def forward_completion(conn: sqlite3.Connection, task_id: str) -> Optional[dict]
                     return None
             except Exception as exc:  # health: allow BLE001 -- unavailable observation must not prevent durable cancellation
                 print(f"placement completion observation failed; forwarding archive: {exc!r}", file=sys.stderr)
-        return forward_archive(conn, task_id)
+        return forward_archive(conn, task_id, await_budget=0)
     except Exception as exc:  # health: allow BLE001 -- courtesy forwarding must not undo a committed completion
         print(f"placement completion forward failed: {exc!r}", file=sys.stderr)
         return None
diff --git a/tests/hermes_cli/test_kanban_placement.py b/tests/hermes_cli/test_kanban_placement.py
index 4a4a97ac261..942b745862d 100644
--- a/tests/hermes_cli/test_kanban_placement.py
+++ b/tests/hermes_cli/test_kanban_placement.py
@@ -1634,6 +1634,28 @@ def test_unresolved_archive_is_sent_by_the_dispatcher_sweep_once_the_target_make
     assert len(_archive_requests(mac)) == 1
 
 
+def test_request_only_completion_never_waits_and_sweep_cancels_late_copy(mac, monkeypatch):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    from hermes_cli import kanban_placement as kp
+    from hermes_cli import kanban_placement_forward as kpf
+    with kbc.connect_closing() as conn:
+        child, rid = _unresolved_forwarded_card(mac, monkeypatch, conn)
+        assert kb.unblock_task(conn, child)
+        monkeypatch.setattr(kp, "await_task_id", lambda *a, **kw: pytest.fail("completion must not wait"))
+        assert kb.complete_task(conn, child, summary="Manual override", force=True)
+        assert kb.get_task(conn, child).status == "done"
+        assert kpf.archive_forward_view(conn, child)["status"] == "unresolved"
+        assert kpf.sweep_unresolved_archives(conn) == []
+        mac["hub"].execute("UPDATE sent SET state='done', result=? WHERE id=?",
+                           (json.dumps({"ok": True, "task_id": "t_hub0001", "status": "ready"}), rid))
+        mac["hub"].commit()
+        assert kpf.sweep_unresolved_archives(conn) == [child]
+        assert kpf.archive_forward_view(conn, child)["status"] == "pending"
+        assert kpf.sweep_unresolved_archives(conn) == []
+    assert len(_archive_requests(mac)) == 1
+
+
 def test_unresolved_archive_sweep_gives_up_after_seven_days_with_a_comment(mac, monkeypatch):
     from hermes_cli import kanban_db as kb
     from hermes_cli import kanban_db_connect as kbc
