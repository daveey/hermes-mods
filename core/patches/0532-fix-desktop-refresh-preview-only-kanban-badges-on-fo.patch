From 98906dadc75497a66b66df4d3b340157083e5eaf Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 14:26:16 -0700
Subject: [PATCH] fix(desktop): refresh preview-only kanban badges on focus and
 backstop [daveey]

---
 .../contrib/hooks/use-background-sync.test.ts | 30 +++++++++++++++++++
 .../app/contrib/hooks/use-background-sync.ts  | 23 ++++++++++++++
 2 files changed, 53 insertions(+)

diff --git a/apps/desktop/src/app/contrib/hooks/use-background-sync.test.ts b/apps/desktop/src/app/contrib/hooks/use-background-sync.test.ts
index e3b8d5ce32..8f61c9baa2 100644
--- a/apps/desktop/src/app/contrib/hooks/use-background-sync.test.ts
+++ b/apps/desktop/src/app/contrib/hooks/use-background-sync.test.ts
@@ -916,6 +916,36 @@ describe('active transcript refresh', () => {
     await waitFor(() => expect(refreshProjectTree).toHaveBeenCalled())
   })
 
+  it.each([true, false])('refreshes preview-only kanban rows without session events (events=%s)', async events => {
+    vi.useFakeTimers()
+    $changeEventsAvailable.set(events)
+    vi.spyOn(document, 'hasFocus').mockReturnValue(true)
+    renderSync(vi.fn(async () => undefined))
+    vi.mocked(refreshProjectTree).mockClear()
+
+    await act(async () => { await vi.advanceTimersByTimeAsync(60_000) })
+    expect(refreshProjectTree).toHaveBeenCalled()
+  })
+
+  it('keeps the preview backstop quiet while unfocused and catches up on focus', async () => {
+    vi.useFakeTimers()
+    $changeEventsAvailable.set(true)
+    const focus = vi.spyOn(document, 'hasFocus').mockReturnValue(false)
+    const { unmount } = renderSync(vi.fn(async () => undefined))
+    vi.mocked(refreshProjectTree).mockClear()
+
+    await act(async () => { await vi.advanceTimersByTimeAsync(60_000) })
+    expect(refreshProjectTree).not.toHaveBeenCalled()
+    focus.mockReturnValue(true)
+    act(() => { window.dispatchEvent(new Event('focus')) })
+    expect(refreshProjectTree).toHaveBeenCalledTimes(1)
+    unmount()
+    vi.mocked(refreshProjectTree).mockClear()
+    act(() => { window.dispatchEvent(new Event('focus')) })
+    await act(async () => { await vi.advanceTimersByTimeAsync(60_000) })
+    expect(refreshProjectTree).not.toHaveBeenCalled()
+  })
+
   it('does not refresh projects on a bare sessions.changed tick', async () => {
     // The two stores are independent: a sessions.changed refresh pulls the tree
     // (grouping of the same rows) but must not also fire a projects.list read.
diff --git a/apps/desktop/src/app/contrib/hooks/use-background-sync.ts b/apps/desktop/src/app/contrib/hooks/use-background-sync.ts
index ac8cfb2fef..f2421e6b6b 100644
--- a/apps/desktop/src/app/contrib/hooks/use-background-sync.ts
+++ b/apps/desktop/src/app/contrib/hooks/use-background-sync.ts
@@ -1294,6 +1294,29 @@ export function useBackgroundSync({
     // not create a new request (and invalidate the old result) on every tick.
   }, [activeConnectionId, activeGatewayProfile, changeEventsAvailable, gatewayState, requestGateway])
 
+  // Kanban replica/release changes need not emit sessions.changed. Older chats can
+  // exist only in project previews (outside the capped sessions list), so refreshing
+  // live statuses alone leaves their badges frozen. Catch up on focus and bound
+  // staleness while viewed, without polling hidden windows. [daveey]
+  useEffect(() => {
+    if (gatewayState !== 'open') {
+      return
+    }
+
+    let inFlight = false
+
+    return visiblePoll(60_000, () => {
+      if (inFlight) {
+        return
+      }
+
+      inFlight = true
+      void refreshProjectTree().finally(() => {
+        inFlight = false
+      })
+    })
+  }, [activeConnectionId, activeGatewayProfile, gatewayState])
+
   // sessions.changed also means the *stored* list may have new rows (a cron
   // run's session, an inbound messaging turn creating a thread). The full list
   // refresh is heavier than the active_list snapshot, so trail it on a gap
-- 
