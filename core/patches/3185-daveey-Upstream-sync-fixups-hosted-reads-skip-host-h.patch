From 928a4912a946a6fe4c95a7d040f70614e49db03a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 08:12:48 +0000
Subject: [PATCH] [daveey] Upstream sync fixups: hosted reads skip host-home
 guard; composed worker test advances generation 0

Upstream's sandbox-conformance test forbids host lookups for a hosted read; the fork's
HOME_READ_DENIED_DIRS loop realpath'd host homes for a sandbox path. Upstream's turn Fence refuses
generation 0, which the fork's composed worker test built directly before any turn.
---
 agent/file_safety.py                               | 4 +++-
 tests/gateway/test_model_switch_worker_composed.py | 6 ++++++
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/agent/file_safety.py b/agent/file_safety.py
index ad4fdd9172..61f69c7cd2 100644
--- a/agent/file_safety.py
+++ b/agent/file_safety.py
@@ -452,7 +452,9 @@ def get_read_block_error(path: str) -> Optional[str]:
                     break
             if reason:
                 break
-        if reason is None:
+        # A hosted (sandbox) path never names this host's home: resolving the host homes here would
+        # look the host up for a path that lives elsewhere (sandbox_conformance). [daveey]
+        if reason is None and lexical is None:
             for home in _guard_homes(path):
                 for rel in HOME_READ_DENIED_DIRS:
                     blocked_dir = Path(os.path.realpath(os.path.join(home, *rel.split("/"))))
diff --git a/tests/gateway/test_model_switch_worker_composed.py b/tests/gateway/test_model_switch_worker_composed.py
index b40d705545..13315d7c9d 100644
--- a/tests/gateway/test_model_switch_worker_composed.py
+++ b/tests/gateway/test_model_switch_worker_composed.py
@@ -124,6 +124,12 @@ def _worker_build(authority, db, ref, monkeypatch, execution_id):
     from gateway.session_managed_worker import _bootstrap
     from hermes_state_runtime import mutate_worker_execution, register_worker_execution
     import run_agent
+    # A real turn's prepared mutation advances the generation before its worker spawns; a turn's
+    # Fence (hermes_scope) refuses generation 0, so a construction before any turn advances it too
+    # (never during a running turn, whose generation it would make stale).
+    if not db.get_session(ref.session_id)['runtime_generation']:
+        db._execute_write(lambda conn: conn.execute(
+            'UPDATE sessions SET runtime_generation=runtime_generation+1 WHERE id=?', (ref.session_id,)))
     generation = db.get_session(ref.session_id)['runtime_generation']
     scope = {'profile_id': authority.profile_id, 'session_id': ref.session_id, 'execution_id': execution_id,
              'generation': generation, 'pid': 0, 'birth': 0, 'secret': 's', 'epoch': authority.epoch}
