From 987876f5d0a1e6e0e4588c6e07ac8239db9785d4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:14:59 +0000
Subject: [PATCH] perf(web): memo delta frames on (credential, base hash, body
 hash) [daveey]

The delta middleware re-ran the zstd encode on every poll of a route whose
body had not changed: the client names the same base and the handler
returns the same bytes, so the frame is identical (card t_01a1d59ed9eb75fe;
design t_01a1d563324d7e8e section 6 serve-residue lever, ~0.5% of a core).

BodyStore now also remembers recent frames, bounded at 8 MiB / 512 entries,
keyed on the credential namespace, the base hash and the body hash (the
route's change key). A changed body is a new key and is encoded on the
first request that sees it. The base must still be in the store, so an
evicted base keeps getting the whole body. P1 pass delta.encode counts a
memo hit as a skip.

RED->GREEN: tests/hermes_cli/test_web_delta_response_memo.py
---
 hermes_cli/web_delta_response.py              |  63 +++++++--
 .../test_web_delta_response_memo.py           | 130 ++++++++++++++++++
 2 files changed, 183 insertions(+), 10 deletions(-)
 create mode 100644 tests/hermes_cli/test_web_delta_response_memo.py

diff --git a/hermes_cli/web_delta_response.py b/hermes_cli/web_delta_response.py
index 7dcd00362d..b06280361a 100644
--- a/hermes_cli/web_delta_response.py
+++ b/hermes_cli/web_delta_response.py
@@ -61,6 +61,8 @@ DELTA_MEDIA_TYPE = "application/vnd.hermes.delta+zstd"
 MIN_BYTES = 16 * 1024
 MAX_BYTES = 8 * 1024 * 1024
 STORE_MAX_BYTES = 64 * 1024 * 1024
+FRAMES_MAX_BYTES = 8 * 1024 * 1024
+FRAMES_MAX_ENTRIES = 512
 ZSTD_LEVEL = 3
 CREDENTIAL_HEADERS = ("x-hermes-session-token", "authorization", "cookie")
 VARY_ON = ("X-Hermes-Delta-Accept", "X-Hermes-Delta-Base")
@@ -93,14 +95,44 @@ def encode_delta(body: bytes, base: bytes) -> bytes:
 
 
 class BodyStore:
-    """Recently served bodies by hash, least recently used first out, bounded by total bytes."""
+    """Recently served bodies by hash, least recently used first out, bounded by total bytes.
 
-    def __init__(self, max_bytes: int = STORE_MAX_BYTES):
+    It also remembers recent delta frames by (namespace, base hash, body hash): a client polling an unchanged
+    route names the same base for the same body every time, so the zstd encode runs once per change, not once
+    per poll (t_01a1d59ed9eb75fe). The body hash is the route's change key; a new body is a new key, encoded
+    on the request that first sees it. [daveey]"""
+
+    def __init__(self, max_bytes: int = STORE_MAX_BYTES, frames_max_bytes: int = FRAMES_MAX_BYTES):
         self._max_bytes = max_bytes
         self._bodies: OrderedDict[str, bytes] = OrderedDict()
         self._bytes = 0
+        self._frames_max_bytes = frames_max_bytes
+        self._frames: OrderedDict[str, Optional[bytes]] = OrderedDict()
+        self._frames_bytes = 0
         self._lock = threading.Lock()
 
+    def frame(self, key: str) -> tuple[bool, Optional[bytes]]:
+        """(remembered, frame); a remembered ``None`` is an encode that came out no smaller than its body."""
+        with self._lock:
+            if key not in self._frames:
+                return False, None
+            self._frames.move_to_end(key)
+            return True, self._frames[key]
+
+    def put_frame(self, key: str, frame: Optional[bytes]) -> None:
+        size = len(frame) if frame is not None else 0
+        with self._lock:
+            if key in self._frames or size > self._frames_max_bytes:
+                return
+            self._frames[key] = frame
+            self._frames_bytes += size
+            while self._frames_bytes > self._frames_max_bytes and self._frames:
+                _, dropped = self._frames.popitem(last=False)
+                self._frames_bytes -= len(dropped) if dropped is not None else 0
+            while len(self._frames) > FRAMES_MAX_ENTRIES:
+                _, dropped = self._frames.popitem(last=False)
+                self._frames_bytes -= len(dropped) if dropped is not None else 0
+
     def get(self, digest: str) -> Optional[bytes]:
         with self._lock:
             body = self._bodies.get(digest)
@@ -139,14 +171,25 @@ def _eligible(message: Message) -> bool:
 
 
 def _encode(body: bytes, base_digest: str, namespace: str, store: BodyStore) -> tuple[str, Optional[bytes]]:
-    """(hash of body, delta frame or None). Runs off the event loop: hashing and zstd release the GIL."""
-    digest = body_hash(body)
-    base = store.get(f"{namespace}:{base_digest}") if base_digest else None
-    store.put(f"{namespace}:{digest}", body)
-    if base is None:
-        return digest, None
-    frame = encode_delta(body, base)
-    return digest, frame if len(frame) < len(body) else None
+    """(hash of body, delta frame or None). Runs off the event loop: hashing and zstd release the GIL.
+    P1 pass ``delta.encode``: a skip is a frame served from the memo."""
+    from hermes_cli import loop_accounting as la
+    with la.pass_("delta.encode") as p:
+        digest = body_hash(body)
+        base = store.get(f"{namespace}:{base_digest}") if base_digest else None
+        store.put(f"{namespace}:{digest}", body)
+        if base is None:
+            return digest, None
+        key = f"{namespace}:{base_digest}:{digest}"
+        remembered, frame = store.frame(key)
+        if remembered:
+            p.skip()
+        else:
+            p.change()
+            frame = encode_delta(body, base)
+            frame = frame if len(frame) < len(body) else None
+            store.put_frame(key, frame)
+        return digest, frame
 
 
 def _merge_vary(headers: MutableHeaders) -> None:
diff --git a/tests/hermes_cli/test_web_delta_response_memo.py b/tests/hermes_cli/test_web_delta_response_memo.py
new file mode 100644
index 0000000000..6df9d41c82
--- /dev/null
+++ b/tests/hermes_cli/test_web_delta_response_memo.py
@@ -0,0 +1,130 @@
+"""A polled route's delta frame is encoded once per change of its body, and a change is served on the next poll.
+
+Card t_01a1d59ed9eb75fe (design t_01a1d563324d7e8e §6, serve residue): every Desktop poll of an unchanged
+route re-ran the zstd encode against the same base. [daveey]
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+from starlette.applications import Starlette
+from starlette.responses import JSONResponse
+from starlette.routing import Route
+from starlette.testclient import TestClient
+
+from hermes_cli import loop_accounting as la
+from hermes_cli import web_delta_response as wdr
+from tests.hermes_cli.test_web_delta_response import ASK, board, decode, needs_zstd
+
+
+@pytest.fixture
+def served():
+    """A /board answer the test can change, behind the middleware (as in test_web_delta_response)."""
+    state = {"board": board(2000)}
+
+    async def get_board(request):
+        return JSONResponse(state["board"])
+
+    app = Starlette(routes=[Route("/board", get_board)])
+    store = wdr.BodyStore()
+    app.add_middleware(wdr.DeltaResponseMiddleware, store=store)
+    return TestClient(app), state, store
+
+
+def _encodes(monkeypatch) -> list[int]:
+    calls: list[int] = []
+    real = wdr.encode_delta
+    monkeypatch.setattr(wdr, "encode_delta", lambda body, base: calls.append(len(body)) or real(body, base))
+    return calls
+
+
+@needs_zstd
+def test_polls_of_an_unchanged_route_encode_once(served, monkeypatch):
+    client, _, _ = served
+    calls = _encodes(monkeypatch)
+    first = client.get("/board", headers=ASK)
+    base = {**ASK, "X-Hermes-Delta-Base": first.headers[wdr.HASH_HEADER]}
+    polls = [client.get("/board", headers=base) for _ in range(4)]
+    assert len(calls) == 1
+    for poll in polls:
+        assert poll.headers[wdr.DELTA_HEADER] == "zstd"
+        assert decode(poll.content, first.content) == first.content
+
+
+@needs_zstd
+def test_a_changed_body_is_encoded_and_served_on_the_next_poll(served, monkeypatch):
+    client, state, _ = served
+    calls = _encodes(monkeypatch)
+    first = client.get("/board", headers=ASK)
+    base = {**ASK, "X-Hermes-Delta-Base": first.headers[wdr.HASH_HEADER]}
+    client.get("/board", headers=base)
+    state["board"] = board(2000, done=7)
+    changed = client.get("/board", headers=base)
+    assert len(calls) == 2
+    assert json.loads(decode(changed.content, first.content)) == state["board"]
+    assert changed.headers[wdr.HASH_HEADER] != first.headers[wdr.HASH_HEADER]
+    again = client.get("/board", headers=base)
+    assert len(calls) == 2
+    assert again.content == changed.content
+
+
+@needs_zstd
+def test_the_memo_is_per_credential_and_per_base(served, monkeypatch):
+    client, state, _ = served
+    calls = _encodes(monkeypatch)
+    alice = {**ASK, "Authorization": "Bearer alice"}
+    bob = {**ASK, "Authorization": "Bearer bob"}
+    a0 = client.get("/board", headers=alice)
+    b0 = client.get("/board", headers=bob)
+    assert a0.headers[wdr.HASH_HEADER] == b0.headers[wdr.HASH_HEADER]
+    client.get("/board", headers={**alice, "X-Hermes-Delta-Base": a0.headers[wdr.HASH_HEADER]})
+    client.get("/board", headers={**bob, "X-Hermes-Delta-Base": b0.headers[wdr.HASH_HEADER]})
+    assert len(calls) == 2  # same body and base, other credential: its own encode
+    state["board"] = board(2000, done=3)
+    a1 = client.get("/board", headers=alice)
+    client.get("/board", headers={**alice, "X-Hermes-Delta-Base": a1.headers[wdr.HASH_HEADER]})
+    client.get("/board", headers={**alice, "X-Hermes-Delta-Base": a0.headers[wdr.HASH_HEADER]})
+    assert len(calls) == 4  # another base for the same body is another frame
+
+
+@needs_zstd
+def test_an_evicted_base_still_gets_the_whole_body_after_a_memo_hit(served):
+    client, state, store = served
+    first = client.get("/board", headers=ASK)
+    base = {**ASK, "X-Hermes-Delta-Base": first.headers[wdr.HASH_HEADER]}
+    assert wdr.DELTA_HEADER in client.get("/board", headers=base).headers
+    store._bodies.clear()
+    store._bytes = 0
+    response = client.get("/board", headers=base)
+    assert wdr.DELTA_HEADER not in response.headers
+    assert response.json() == state["board"]
+
+
+def test_frame_memo_is_bounded_by_bytes_and_entries(monkeypatch):
+    monkeypatch.setattr(wdr, "FRAMES_MAX_ENTRIES", 3)
+    store = wdr.BodyStore(frames_max_bytes=100)
+    for i in range(5):
+        store.put_frame(f"k{i}", b"x" * 10)
+    assert [store.frame(f"k{i}")[0] for i in range(5)] == [False, False, True, True, True]
+    store.put_frame("big", b"x" * 101)
+    assert store.frame("big") == (False, None)
+    store.put_frame("none", None)
+    assert store.frame("none") == (True, None)
+    for i in range(10):
+        store.put_frame(f"m{i}", b"y" * 40)
+    assert store._frames_bytes <= 100
+
+
+@needs_zstd
+def test_memo_hits_are_p1_skips(served):
+    client, _, _ = served
+    before = la.counters().get("delta.encode", {"runs": 0, "skips": 0})
+    first = client.get("/board", headers=ASK)
+    base = {**ASK, "X-Hermes-Delta-Base": first.headers[wdr.HASH_HEADER]}
+    for _ in range(3):
+        client.get("/board", headers=base)
+    after = la.counters()["delta.encode"]
+    assert after["runs"] - before["runs"] == 4
+    assert after["skips"] - before["skips"] == 2
-- 
