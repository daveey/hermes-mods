From cafc6b7689a16c1175a906b93b28eaac98de45a1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 17:52:47 +0000
Subject: [PATCH] tests(ci lint advisory fetch): healthy-path shim survives the
 runner's own git 2.55 BUG

On CI the real git is 2.55, so the 'healthy' fetch on step 1's partial clone hit the
promisor BUG itself and took the fallback. The shim now answers that one fetch without
promisor mode, so the no-fallback assertion holds on every host git.
---
 tests/ci/test_lint_advisory_fetch.py | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/tests/ci/test_lint_advisory_fetch.py b/tests/ci/test_lint_advisory_fetch.py
index b628b2a203..d3a2b9e630 100644
--- a/tests/ci/test_lint_advisory_fetch.py
+++ b/tests/ci/test_lint_advisory_fetch.py
@@ -49,6 +49,25 @@ if (( is_fetch )); then
     cat "$LINT_BUG_TEXT" >&2
     exit 128
   fi
+  if [[ -z $LINT_FAIL ]]; then
+    # Healthy mode must succeed on every host git, but the runner's real git 2.55 hits the BUG
+    # itself here: answer that one fetch without promisor mode, invisibly to the step.
+    err=$(mktemp); rc=0
+    "$LINT_REAL_GIT" "$@" 2>"$err" || rc=$?
+    if (( rc )) && grep -q should_include_obj "$err"; then
+      saved=()
+      for k in remote.origin.promisor remote.origin.partialclonefilter extensions.partialclone; do
+        saved+=("$k=$("$LINT_REAL_GIT" config --get "$k" || true)")
+        "$LINT_REAL_GIT" config --unset "$k" || true
+      done
+      args=(); for a in "$@"; do [[ $a == --filter=* ]] || args+=("$a"); done
+      rc=0; "$LINT_REAL_GIT" "${args[@]}" || rc=$?
+      for kv in "${saved[@]}"; do [[ -n ${kv#*=} ]] && "$LINT_REAL_GIT" config "${kv%%=*}" "${kv#*=}"; done
+    else
+      cat "$err" >&2
+    fi
+    rm -f "$err"; exit "$rc"
+  fi
 fi
 exec "$LINT_REAL_GIT" "$@"
 """
-- 
2.43.0

