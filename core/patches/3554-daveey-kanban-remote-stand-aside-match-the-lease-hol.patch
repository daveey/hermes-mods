+def _tip_ledger():
+    with contextlib.closing(sqlite3.connect(krn.ledger_path())) as conn:
+        return conn.execute("SELECT session, delivered FROM notices WHERE ref=?",
+                            (f"worker-3/default/default/{TID}",)).fetchall()
