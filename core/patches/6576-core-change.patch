diff --git a/hermes_cli/kanban_producer_wait.py b/hermes_cli/kanban_producer_wait.py
index bc0a33a3f78..3450fd0dbc5 100644
--- a/hermes_cli/kanban_producer_wait.py
+++ b/hermes_cli/kanban_producer_wait.py
@@ -4,9 +4,23 @@
 import sqlite3
 import time
 
+from pathlib import Path
+
 from hermes_cli.kanban_table_columns import table_columns
 
 
+def _selected_board(conn):
+    """Name only recognized selected-file layouts; never discover ambient boards."""
+    from hermes_cli.kanban_db_sync import board_slug_for_path
+    path = next((r[2] for r in conn.execute('PRAGMA database_list') if r[1] == 'main'), '')
+    if not path:
+        return None
+    file = Path(path)
+    if file.name == 'kanban.db' or file.parent.name in ('sync-shadow', 'sync-links'):
+        return board_slug_for_path(path)
+    return None
+
+
 def overlay(conn, info, parked, now=None):
     """An active named card producer is a wait, never this owner's running executor.
 
@@ -37,7 +51,10 @@
     refs = json.dumps(list({a['ref'] for _, a, _ in candidates}))
     producers = {r[0]: (r[1], r[2]) for r in conn.execute(
         f'SELECT id, status, {owner} FROM tasks WHERE id IN (SELECT value FROM json_each(?))', (refs,))}
+    board = _selected_board(conn)
     for tid, awaited, since in candidates:
+        if awaited.get('board') is not None and awaited['board'] != board:
+            continue
         state, gateway = producers.get(awaited['ref'], (None, None))
         if state not in ('running', 'review') or (awaited.get('gateway') and awaited['gateway'] != gateway):
             continue
diff --git a/tests/hermes_cli/test_kanban_producer_wait.py b/tests/hermes_cli/test_kanban_producer_wait.py
index 6ec9328ea7b..a14453c45e9 100644
--- a/tests/hermes_cli/test_kanban_producer_wait.py
+++ b/tests/hermes_cli/test_kanban_producer_wait.py
@@ -26,6 +26,48 @@
     conn.close()
 
 
+@pytest.mark.parametrize('selected, requested, expected', [
+    ('kanban.db', None, True),
+    ('kanban.db', 'default', True),
+    ('kanban.db', 'other', False),
+    ('kanban/boards/other/kanban.db', 'other', True),
+    ('kanban/boards/other/kanban.db', 'default', False),
+    ('sync-shadow/other.db', 'other', True),
+    ('sync-shadow/other.db', 'default', False),
+    ('unidentified.db', 'default', False),
+])
+@pytest.mark.parametrize('consumer', ['status', 'timer'])
+def test_selected_board_identity_reaches_status_and_timer(
+        board, tmp_path, monkeypatch, selected, requested, expected, consumer):
+    from hermes_cli import kanban_db
+    def no_discovery(*args, **kwargs):
+        pytest.fail('selected snapshot must not discover ambient boards')
+    monkeypatch.setattr(kanban_db, 'list_boards', no_discovery)
+    monkeypatch.setattr(kanban_db, 'kanban_db_path', no_discovery)
+    path = tmp_path / selected
+    path.parent.mkdir(parents=True, exist_ok=True)
+    board.commit()
+    with sqlite3.connect(path) as conn:
+        board.backup(conn)
+        awaiting = {'kind': 'card', 'ref': 'review', 'gateway': 'hub'}
+        if requested is not None:
+            awaiting['board'] = requested
+        conn.execute('UPDATE tasks SET awaiting=? WHERE id=?', (json.dumps(awaiting), 'owner'))
+        info = _local_wait_info(conn, ['owner'], now=820)['owner']
+        raw = timers.local(conn, {('ordinary', 'owner')})['owner']
+        if consumer == 'status':
+            assert ('producer_wait' in info) is expected
+        else:
+            assert (timers.card_timer(raw) is not None) is expected
+
+
+def test_explicit_board_without_selected_identity_is_unknown(board):
+    board.execute('UPDATE tasks SET awaiting=? WHERE id=?',
+                  (json.dumps({'kind': 'card', 'ref': 'review', 'board': 'default'}), 'owner'))
+    assert 'producer_wait' not in _local_wait_info(board, ['owner'], now=820)['owner']
+    assert timers.card_timer(timers.local(board, {('ordinary', 'owner')})['owner']) is None
+
+
 @pytest.mark.parametrize('producer_state', ['running', 'review'])
 def test_real_park_wait_drives_timer_and_canonical_status(board, monkeypatch, producer_state):
     board.execute("UPDATE tasks SET status=? WHERE id='review'", (producer_state,))
