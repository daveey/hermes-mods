Subject: [PATCH 6957] TUI turn-start outcome publishing and status counts agreement

Public mirror of source commit ef8322d166db0d5871727bc7548694671260db33.

---
diff --git a/hermes_cli/kanban_counts_agreement.py b/hermes_cli/kanban_counts_agreement.py
index 3b548f9fe1753b27c6b0ca0ac53b6fdabb9fb1a0..8400458782259a4f55b53f42d35119cd0ee32dbc 100644
--- a/hermes_cli/kanban_counts_agreement.py
+++ b/hermes_cli/kanban_counts_agreement.py
@@ -14,6 +14,7 @@
 
 from __future__ import annotations
 
+import functools
 import logging
 import threading
 from collections.abc import Callable, Hashable
@@ -104,7 +105,9 @@
     if start:  # outside ``_lock``: the recompute's settle path takes it
         # Shared by every waiter of this scope: never custody of the first caller's local-work scope.
         try:
-            spawn_context_thread(_run, name="kanban-counts-agreement", args=(scope, flight), passive=True).start()
+            # A zero-argument target: inline ``Thread`` doubles in gateway suites call ``target()`` and drop ``args``.
+            spawn_context_thread(functools.partial(_run, scope, flight), name="kanban-counts-agreement",
+                                 passive=True).start()
         except BaseException as exc:  # health: allow BLE001 -- settle the flight, never leave it pending forever
             with _lock:
                 flight.error = exc
diff --git a/tests/hermes_state/test_session_status_counts_agreement.py b/tests/hermes_state/test_session_status_counts_agreement.py
index 499a9a9a247738e15c7d3afed5cb8d7adb3d6755..68f874ef2846c7cc937dc996759a392390e5337d 100644
--- a/tests/hermes_state/test_session_status_counts_agreement.py
+++ b/tests/hermes_state/test_session_status_counts_agreement.py
@@ -238,6 +238,31 @@
     assert is_done(stored_status(state_db))
 
 
+class TargetOnlyThread:
+    """The gateway suites' ``_ImmediateThread``: it calls ``target()`` and drops ``args``."""
+
+    def __init__(self, target, daemon=None, **_options):
+        self._target = target
+
+    def start(self):
+        self._target()
+
+
+def test_target_only_thread_double_settles(state_db, board, monkeypatch):
+    """The recompute target takes no arguments, so a double that ignores ``args`` still runs it."""
+    from hermes_cli import kanban_counts_agreement as agreement
+
+    controls = Controls()
+    so.register_outcome_provider("user-steps", controls)
+    controls_refresh(state_db)
+    unrelated_write(board)
+    controls.open = False
+    monkeypatch.setattr(threading, "Thread", TargetOnlyThread)
+    controls_refresh(state_db)
+    assert is_done(stored_status(state_db))
+    assert ksa._origin_scope() not in agreement._flights  # other suites may leave their own scopes pending
+
+
 def test_failed_thread_start_settles_the_flight(state_db, board, monkeypatch):
     """A recompute that cannot start is a read failure (unknown), and the next refresh starts a new one."""
     from hermes_cli import kanban_counts_agreement as agreement
@@ -253,7 +278,7 @@
     monkeypatch.setattr(threading, "Thread", NoThread)
     controls_refresh(state_db)
     assert stored_status(state_db)["coverage"]["state"] == "unknown"
-    assert agreement._flights == {}
+    assert ksa._origin_scope() not in agreement._flights  # other suites may leave their own scopes pending
     monkeypatch.setattr(threading, "Thread", InlineThread)
     controls_refresh(state_db)
     assert is_done(stored_status(state_db))
