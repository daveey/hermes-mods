 tests/tools/test_terminal_hints.py            | 60 ++++++++++++++
 tools/process_registry_notifications.py       | 28 ++++++-
 tools/terminal_hints.py                       | 37 ++++++++-
 4 files changed, 201 insertions(+), 6 deletions(-)
