From 780b40e8a68576786338e6546bd4ff1a08726365 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 17:53:42 +0000
Subject: [PATCH] [daveey] kanban comment writer: match ssm-session-worker on
 its 15-char comm prefix

agent_ancestor compared INTERACTIVE_SSM by exact name while runner names
are matched on Linux's 15-char comm prefix. When psutil can't widen the
name (argv rewritten, e.g. `exec -a`), name() is `ssm-session-wor`, the
interactive flag never set, and an `aws ssm start-session` shell walked
on to `amazon-ssm-agen` and recorded `agent` instead of the clean walk.
Fail-safe direction (only lowered authority), but inconsistent with the
runner match.

Fix: compare name[:15] == INTERACTIVE_SSM[:15].

Proof: test_interactive_ssm_session_stays_human is parametrized over full
and comm-truncated names; [comm-truncated] fails on base with
'905:runner:amazon-ssm-agent' is None, passes with the fix. All 6 test
files importing kanban_comment_writer: 178 passed, 1 skipped.
scripts/check --base origin/main: 19 checks ok.

Follow-up from review 5895146691 on PR #2427 (nit 1); card t_01a1d5e98514d4e1.
---
 hermes_cli/kanban_comment_writer.py                |  4 ++--
 tests/hermes_cli/test_kanban_cli_comment_writer.py | 12 ++++++++----
 2 files changed, 10 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_comment_writer.py b/hermes_cli/kanban_comment_writer.py
index a8469f3b97..4237c8763b 100644
--- a/hermes_cli/kanban_comment_writer.py
+++ b/hermes_cli/kanban_comment_writer.py
@@ -115,7 +115,7 @@ RUNNER_FOR_NAME: dict[str, str] = {**{r[:15]: r for r in AUTOMATION_RUNNERS},
                                    **{r: r for r in AUTOMATION_RUNNERS}}
 # An interactive SSM session (``aws ssm start-session``) is a person's shell; its ancestors are the
 # same ssm-agent-worker/amazon-ssm-agent that start SendCommand documents, so no runner above it
-# counts and the walk goes on to init exactly as before.
+# counts and the walk goes on to init exactly as before. Matched on the 15-char prefix like runners.
 INTERACTIVE_SSM = "ssm-session-worker"
 
 # Agent comment handles: ``<gateway>/t_<16 hex>`` (a worker run's note) and ``hub-chat-<hex>``.
@@ -251,7 +251,7 @@ def agent_ancestor(pid: Optional[int] = None, *, read: Optional[ProcReader] = No
         if marker:
             return f"{current}:{marker}"
         name = name_of(current) if name_of else None
-        if name == INTERACTIVE_SSM:
+        if name and name[:15] == INTERACTIVE_SSM[:15]:  # comm prefix, as RUNNER_FOR_NAME
             interactive = True
         runner = RUNNER_FOR_NAME.get(name or "")
         if runner and not interactive:
diff --git a/tests/hermes_cli/test_kanban_cli_comment_writer.py b/tests/hermes_cli/test_kanban_cli_comment_writer.py
index 899f99d38a..60c1d9b9cd 100644
--- a/tests/hermes_cli/test_kanban_cli_comment_writer.py
+++ b/tests/hermes_cli/test_kanban_cli_comment_writer.py
@@ -589,14 +589,18 @@ def test_tree_rooted_at_an_automation_runner_is_an_agent(monkeypatch, runner):
 
 
 @posix_only
-def test_interactive_ssm_session_stays_human(monkeypatch):
+@pytest.mark.parametrize("session, agent", [("ssm-session-worker", "amazon-ssm-agent"),
+                                            ("ssm-session-wor", "amazon-ssm-agen")],
+                         ids=["full-names", "comm-truncated"])
+def test_interactive_ssm_session_stays_human(monkeypatch, session, agent):
     """``aws ssm start-session``: a person's shell under ssm-session-worker, whose own ancestors are
-    the same ssm-agent-worker/amazon-ssm-agent that start SendCommand documents."""
+    the same ssm-agent-worker/amazon-ssm-agent that start SendCommand documents. Names psutil can't
+    widen (argv rewritten) are Linux's 15-char ``comm``, matched like the runners."""
     _fake_psutil_tree(monkeypatch, {900: (901, "ubuntu", CLEAN, "python3"),
                                     901: (920, "ubuntu", CLEAN, "bash"),
-                                    920: (904, "root", None, "ssm-session-worker"),
+                                    920: (904, "root", None, session),
                                     904: (905, "root", None, "ssm-agent-worker"),
-                                    905: (1, "root", None, "amazon-ssm-agent"), **INIT})
+                                    905: (1, "root", None, agent), **INIT})
     assert kcw.agent_ancestor(900) is None
 
 
