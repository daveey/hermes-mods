diff --git a/hermes_cli/update_fleet_scope.py b/hermes_cli/update_fleet_scope.py
index 4fc3939233d..6b3629392dd 100644
--- a/hermes_cli/update_fleet_scope.py
+++ b/hermes_cli/update_fleet_scope.py
@@ -179,6 +179,44 @@ def gateway_foreign_code_root(pid: int, home) -> Path | None:
     return None
 
 
+def profiles_on_another_checkout() -> dict[str, Path]:
+    """Profile → the other checkout its live gateway runs, read fresh from each profile's own
+    status record. Restart-abort recovery asks this itself: it can run before the restart phase
+    looked at any unit, so nothing an earlier pass remembered is there to rely on."""
+    import json
+
+    import psutil
+    from hermes_cli.update_receipt import _profile_homes
+    pinned: dict[str, Path] = {}
+    with suppress(Exception):
+        for profile, home in _profile_homes():
+            with suppress(Exception):
+                pid = int(json.loads((home / "gateway_state.json").read_text(encoding="utf-8-sig")).get("pid") or 0)
+                root = gateway_foreign_code_root(pid, home) if pid > 0 and psutil.pid_exists(pid) else None
+                if root is not None:
+                    pinned[profile] = root
+    return pinned
+
+
+def drop_gateways_on_another_checkout(pids) -> list[int]:
+    """*pids* minus the gateway processes that provably run another checkout (each named once).
+
+    The manual sweep stops every gateway process of this home that no supervisor claims; a pinned
+    unit's gateway lands there whenever its unit PID lookup fails, and it is not stale either."""
+    from hermes_cli.dashboard_procs import _hermes_home_for_pid
+    kept = []
+    for pid in pids:
+        home = None
+        with suppress(Exception):
+            home = _hermes_home_for_pid(pid)
+        root = gateway_foreign_code_root(pid, home)
+        if root is None:
+            kept.append(pid)
+        else:
+            announce_skipped_runtime("gateway process", f"PID {pid}", home, code_root=root)
+    return kept
+
+
 def describe_skipped_runtime(kind: str, name: str, home: str | None, code_root: Path | None = None) -> str:
     """One notice line for a runtime the update leaves alone (foreign home, its own checkout, or
     unreadable ownership)."""
diff --git a/hermes_cli/update_receipt.py b/hermes_cli/update_receipt.py
index 7c110f3abb7..0dcb675f484 100644
--- a/hermes_cli/update_receipt.py
+++ b/hermes_cli/update_receipt.py
@@ -1088,13 +1088,20 @@ def _gateway_code_root(pid: int, home: Path) -> Optional[Path]:
         import psutil  # type: ignore
 
         process = psutil.Process(pid)
-        # The import path outranks where the interpreter lives: ``python -m hermes_cli.main`` under a
-        # PYTHONPATH naming a checkout runs THAT checkout whatever venv the python came from, and
-        # names no other path at all (an Ask Eve pinned owner's unit). [daveey]
+        # ``python -m hermes_cli.main`` names no path at all, so the import path decides, in the
+        # interpreter's own order: the working directory (unless safe-path mode drops it), then
+        # PYTHONPATH, and only then the venv the python came from (an Ask Eve pinned owner's unit
+        # runs another venv's python under a PYTHONPATH naming its pinned core). [daveey]
         with suppress(Exception):
-            for probe in ((process.environ() or {}).get("PYTHONPATH") or "").split(os.pathsep):
-                if probe and os.path.isabs(probe) and (Path(probe) / "hermes_cli" / "main.py").is_file():
-                    return Path(probe).resolve()
+            cmdline, env = process.cmdline() or [], process.environ() or {}
+            # Interpreter options end at the first ``-m``; any other option (``-P``, ``-I``, ``-E``,
+            # ``-u``…) may change the import path, so only the two plain shapes are read here.
+            if cmdline[1:2] == ["-m"]:
+                safe = bool(env.get("PYTHONSAFEPATH"))
+                probes = ([] if safe else [process.cwd()]) + (env.get("PYTHONPATH") or "").split(os.pathsep)
+                for probe in probes:
+                    if probe and os.path.isabs(probe) and (Path(probe) / "hermes_cli" / "main.py").is_file():
+                        return Path(probe).resolve()
         with suppress(Exception):
             root = _code_root_for_path((process.environ() or {}).get("VIRTUAL_ENV"))
             if root:
