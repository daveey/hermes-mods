From 6e8e590fdb2ecc86bcc971c255344c09c19240db Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 06:56:24 +0000
Subject: [PATCH] [daveey] gateway: bound asyncio.run's shutdown and the outer
 finally to a core update's exit target

PR #1840 review (t_01a1d2ef53b4d141) nits, card t_01a1d3084e300f2a.

The checkpoint's soft exit target bounded only the post-stop tail's cooperative waits. After the tail
resolved its verdict, asyncio.run's own shutdown (cancelling leftover tasks, the default-executor join:
up to 300s on a wedged executor thread) and start_gateway's outer finally (drain_gateway_runtime, a
second runner.stop) still ran unbounded until the hard exit deadline.

- exit_deadline.bound_post_tail: with an exit target set, a daemon thread takes the graceful exit
  funnel with the tail's verdict (0/1 or the SystemExit code) at target + POST_TAIL_GRACE_S (3s, inside
  the 8s UPDATE_EXIT_MARGIN_S), unless the funnel disarmed first; disarm() now refuses (False) on the
  main thread once that thread owns the exit, and the funnel parks instead of running twice
- phase marks: tail_start, tail_done (always), outer_finally, post_tail_bound, exit_funnel; the
  slow-tail log line names tail_start..tail_done so tail_s and the marks compare directly
- the outer finally's second control socket stop takes the same bounded close wait as the tail's
---
 gateway/exit_deadline.py                 |  75 +++++++++++-
 gateway/run.py                           |   2 +-
 gateway/run_bootstrap.py                 |  22 +++-
 tests/gateway/test_update_exit_target.py | 146 +++++++++++++++++++++++
 4 files changed, 237 insertions(+), 8 deletions(-)

diff --git a/gateway/exit_deadline.py b/gateway/exit_deadline.py
index 46194e8f15..402bf8d70e 100644
--- a/gateway/exit_deadline.py
+++ b/gateway/exit_deadline.py
@@ -116,6 +116,59 @@ def set_exit_target(target_mono: Optional[float], reason: str = "") -> None:
             _state.update(target_mono=float(target_mono), target_reason=reason)
 
 
+# After the tail resolved its verdict, the steps left are asyncio.run's own shutdown (cancelling leftover
+# tasks, the default-executor join: up to 300s on a wedged executor thread) and start_gateway's outer
+# finally (drain_gateway_runtime, a second runner.stop). None of them is a cooperative wait the exit
+# target can clamp, so a checkpointed stop takes the exit funnel this long after the target instead: still
+# inside UPDATE_EXIT_MARGIN_S, i.e. before the updater's wait (accept + CHECKPOINT_DRAIN_S) ends.
+POST_TAIL_GRACE_S = 3.0
+# Least time left for those steps when the tail itself ended past the target (normally milliseconds).
+POST_TAIL_MIN_S = 0.5
+POST_TAIL_THREAD_NAME = "gateway-post-tail-exit"
+
+
+def bound_post_tail(exit_code: int, exit_fn: Callable[[int], None], *,
+                    grace_s: Optional[float] = None) -> bool:
+    """Bound everything after the shutdown tail to the exit target; False when no target is set.
+
+    A daemon thread calls ``exit_fn(exit_code)`` (the graceful exit funnel, which ``os._exit``s) at
+    ``target + grace_s`` unless the funnel disarmed first. The tail's verdict is already resolved and
+    its teardown done, so this exit is graceful (clean ledger stamp, PID/lock release, log drain), not
+    the hard deadline's forced one. Without a target only the hard exit deadline covers these steps.
+    """
+    target = _state.get("target_mono")
+    if target is None:
+        return False
+    grace = POST_TAIL_GRACE_S if grace_s is None else grace_s
+    fire_at = max(target + grace, time.monotonic() + min(grace, POST_TAIL_MIN_S))
+
+    def _watch() -> None:
+        if _done.wait(timeout=max(0.0, fire_at - time.monotonic())):
+            return
+        with _lock:
+            if _done.is_set() or _state.get("exit_owner") is not None:
+                return
+            _state["exit_owner"] = threading.get_ident()  # the main thread's funnel now parks (disarm)
+        mark_phase("post_tail_bound")
+        with contextlib.suppress(Exception):
+            logger.warning("Shutdown still running %.1fs after the core update exit target (%s): asyncio.run "
+                           "shutdown / outer finally did not finish; exiting %s now (phase marks: %s)",
+                           time.monotonic() - target, _state.get("target_reason"), exit_code, phases())
+        try:
+            exit_fn(exit_code)
+        except Exception:  # health: allow BLE001 -- hand the exit back to the main thread's funnel
+            logger.exception("Post-tail exit bound: the exit funnel failed")
+            with _lock:
+                _state.pop("exit_owner", None)
+
+    try:
+        threading.Thread(target=_watch, daemon=True, name=POST_TAIL_THREAD_NAME).start()
+    except Exception:
+        logger.debug("Failed to start the post-tail exit bound", exc_info=True)
+        return False
+    return True
+
+
 def phases() -> dict[str, float]:
     """Phase marks (seconds since the stop began) recorded so far, for the tail's timing log line."""
     with _lock:
@@ -213,9 +266,25 @@ def arm_for_stop(runner: Any, stop_leash_s: float, snapshot_fn: Callable[[], dic
         min_budget_s=None if by_signal else stop_leash_s + TAIL_RESERVE_S, snapshot_fn=snapshot_fn)
 
 
-def disarm() -> None:
-    """Called by the graceful exit funnel just before ``os._exit``."""
-    _done.set()
+def disarm() -> bool:
+    """Called by the graceful exit funnel just before ``os._exit``. False when the post-tail bound
+    (:func:`bound_post_tail`) already took the exit on another thread: that thread runs the funnel and
+    ``os._exit``s, so the caller must not run it a second time."""
+    with _lock:
+        owner = _state.get("exit_owner")
+        if owner is not None and owner != threading.get_ident():
+            return False
+        _done.set()
+        return True
+
+
+def enter_exit_funnel() -> None:
+    """The graceful exit funnel's disarm: marks ``exit_funnel`` and disarms. When the post-tail bound
+    already took the exit on another thread, the caller parks for good instead: that thread is running
+    the same funnel and ``os._exit``s."""
+    mark_phase("exit_funnel")
+    if not disarm():
+        threading.Event().wait()
 
 
 def _exit_diag_record() -> dict[str, Any]:
diff --git a/gateway/run.py b/gateway/run.py
index 83548f325b..b7bb64f10f 100644
--- a/gateway/run.py
+++ b/gateway/run.py
@@ -5074,7 +5074,7 @@ def _exit_after_graceful_shutdown(exit_code: int) -> None:
         from hermes_logging import drain_log_queue
         drain_log_queue(timeout=1.0)
 
-    exit_deadline.disarm()  # here and only here: the exit deadline covers everything up to os._exit
+    exit_deadline.enter_exit_funnel()  # here and only here: the exit deadline covers everything up to os._exit
     for _step in (_release_locks, _mark_exited, _flush_metrics, _write_cpu_profile, _drain_logs):
         _best_effort(_step)
     os._exit(exit_code)
diff --git a/gateway/run_bootstrap.py b/gateway/run_bootstrap.py
index 9643f6583e..4e604c1980 100644
--- a/gateway/run_bootstrap.py
+++ b/gateway/run_bootstrap.py
@@ -527,6 +527,7 @@ async def _start_gateway_shutdown_tail(
     """Post-``wait_for_shutdown`` teardown; returns the process exit verdict (True = exit 0)."""
     from gateway.run import (_CRON_SHUTDOWN_DRAIN_TIMEOUT, _HOUSEKEEPING_SHUTDOWN_DRAIN_TIMEOUT, _await_thread_exit, _best_effort, _resolve_gateway_exit_verdict, _shutdown_mcp_servers_nonblocking, _stop_cron_provider, exit_deadline)
     tail_started = time.monotonic()
+    exit_deadline.mark_phase("tail_start")  # the slow-tail line's phase marks count from the stop's start
     # Control socket first: once shutdown begins we are no longer a truthful "serving here" answer and a
     # successor must be able to bind. Early-exit paths rely on the atexit cleanup_files hook instead.
     if _control_server is not None:
@@ -574,12 +575,23 @@ async def _start_gateway_shutdown_tail(
     # One line naming where a slow tail went: the stop's own phases are logged by stop(), and a tail that
     # outlived a core update's wait was otherwise unattributable (hermes-hub 2026-11-13 01:58:45-01:59:29Z).
     tail_s = time.monotonic() - tail_started
+    exit_deadline.mark_phase("tail_done")
     if tail_s >= _SLOW_TAIL_LOG_S:
-        exit_deadline.mark_phase("tail_done")
-        logger.warning("Shutdown tail took %.1fs (phase marks since stop began: %s)", tail_s, exit_deadline.phases())
+        logger.warning("Shutdown tail took %.1fs (phase marks since stop began, tail_start..tail_done: %s)",
+                       tail_s, exit_deadline.phases())
     # The failure verdict comes AFTER the cooperative teardown: returning early here leaked the
     # cron ticker + housekeeping threads (and open MCP connections) for embedded callers (#12175).
-    return _resolve_gateway_exit_verdict(runner, _signal_initiated_shutdown[0])
+    # Then asyncio.run's shutdown and start_gateway's outer finally are bounded to a core update's exit
+    # target too: they are no cooperative waits, and a wedged executor join held the exit for 300s.
+    from gateway.run import _exit_after_graceful_shutdown
+    try:
+        verdict = _resolve_gateway_exit_verdict(runner, _signal_initiated_shutdown[0])
+    except SystemExit as exc:
+        exit_deadline.bound_post_tail(
+            0 if exc.code is None else exc.code if isinstance(exc.code, int) else 1, _exit_after_graceful_shutdown)
+        raise
+    exit_deadline.bound_post_tail(0 if verdict else 1, _exit_after_graceful_shutdown)
+    return verdict
 
 
 
@@ -842,6 +854,7 @@ async def _start_gateway_runtime(config: Optional[GatewayConfig] = None, replace
         _run_planned_stop_watcher,
         _start_gateway_make_restart_signal_handler,
         asyncio,
+        exit_deadline,
         load_gateway_config_for_runner,
         os,
         threading,
@@ -1044,6 +1057,7 @@ async def _start_gateway_runtime(config: Optional[GatewayConfig] = None, replace
         return verdict
 
     finally:
+        exit_deadline.mark_phase("outer_finally")  # then asyncio.run's own shutdown, then exit_funnel
         try:
             if runner is not None:
                 from gateway.run_runtime import drain_gateway_runtime
@@ -1058,6 +1072,6 @@ async def _start_gateway_runtime(config: Optional[GatewayConfig] = None, replace
             if _planned_stop_watcher_stop is not None:
                 _planned_stop_watcher_stop.set()
             if _control_server is not None:
-                await _control_server.stop()
+                await _control_server.stop(close_wait_s=exit_deadline.clamp_wait(_CONTROL_STOP_TIMEOUT_S, 0.0))
             remove_pid_file()
             release_gateway_runtime_lock()
diff --git a/tests/gateway/test_update_exit_target.py b/tests/gateway/test_update_exit_target.py
index 0000dd4854..154cd94908 100644
--- a/tests/gateway/test_update_exit_target.py
+++ b/tests/gateway/test_update_exit_target.py
@@ -8,6 +8,7 @@ and hermes-sync cooled off 60 min. The tail's waits are now clamped to the check
 from __future__ import annotations
 
 import asyncio
+import contextlib
 import threading
 import time
 from unittest.mock import MagicMock
@@ -16,12 +17,16 @@ import pytest
 
 from gateway import exit_deadline
 import gateway.run as gateway_run
+from tests.waiting import wait_until
 
 
 @pytest.fixture(autouse=True)
 def _clean_deadline():
     exit_deadline._reset_for_tests()
     yield
+    exit_deadline._done.set()  # a post-tail watcher still waiting stands down
+    for watcher in [t for t in threading.enumerate() if t.name == exit_deadline.POST_TAIL_THREAD_NAME]:
+        watcher.join(5)
     exit_deadline._reset_for_tests()
 
 
@@ -135,3 +140,144 @@ def test_control_socket_stop_does_not_wait_on_a_held_connection(tmp_path):
 
     elapsed = asyncio.run(scenario())
     assert elapsed < 3.0
+
+
+# --- After the tail: asyncio.run's own shutdown and the outer finally (PR #1840 review) ---------------
+# The exit target bounded only the tail's cooperative waits. asyncio.run's shutdown (cancelling leftover
+# tasks, shutdown_default_executor: up to 300s on a wedged executor thread) and start_gateway's outer
+# finally then ran unbounded until the hard exit deadline. Once the tail has resolved its verdict, a
+# watcher takes the graceful exit funnel by target + POST_TAIL_GRACE_S.
+
+
+def _fake_tail_env(monkeypatch, exits):
+    cron_stop = threading.Event()
+    threads = [threading.Thread(target=cron_stop.wait, daemon=True) for _ in range(2)]
+    for thread in threads:
+        thread.start()
+    watcher_stop = threading.Event()
+    watcher = threading.Thread(target=watcher_stop.wait, daemon=True)
+    watcher.start()
+
+    async def fake_mcp_shutdown(*_args, **_kwargs):
+        return True
+
+    def fake_exit(code):
+        exits.append((code, time.monotonic()))
+
+    monkeypatch.setattr(gateway_run, "_shutdown_mcp_servers_nonblocking", fake_mcp_shutdown)
+    monkeypatch.setattr(gateway_run, "_stop_cron_provider", lambda provider: None)
+    monkeypatch.setattr(gateway_run, "_exit_after_graceful_shutdown", fake_exit)
+    monkeypatch.setattr("hermes_cli.nous_auth_keepalive.stop_nous_auth_keepalive", lambda: None)
+    return (cron_stop, object(), threads[0], threads[1], watcher_stop, watcher)
+
+
+def _post_tail_watchers():
+    return [t for t in threading.enumerate() if t.name == exit_deadline.POST_TAIL_THREAD_NAME]
+
+
+@pytest.mark.parametrize(("runner_kwargs", "code"), [
+    (dict(should_exit_with_failure=True, exit_code=None), 1),
+    (dict(should_exit_with_failure=False, exit_code=75), 75),  # a service restart raises SystemExit(75)
+])
+def test_post_tail_bound_takes_the_exit_with_the_tail_verdict(monkeypatch, runner_kwargs, code):
+    exits: list = []
+    env = _fake_tail_env(monkeypatch, exits)
+    monkeypatch.setattr(exit_deadline, "POST_TAIL_GRACE_S", 0.2)
+    exit_deadline._state.update(started_mono=time.monotonic())  # armed: phase marks are recorded
+    exit_deadline.set_exit_target(time.monotonic() + 0.3, "test")
+    runner = MagicMock(exit_reason="test stop", **runner_kwargs)
+
+    from gateway.run_bootstrap import _start_gateway_shutdown_tail
+    with contextlib.suppress(SystemExit):
+        asyncio.run(_start_gateway_shutdown_tail(runner, None, *env, [False]))
+    started = time.monotonic()
+    wait_until(lambda: exits, timeout=5.0, what="the post-tail bound to take the exit")
+    assert exits[0][0] == code
+    assert exits[0][1] - started < 2.0
+    assert "post_tail_bound" in exit_deadline.phases()
+
+
+def test_post_tail_bound_needs_an_exit_target(monkeypatch):
+    exits: list = []
+    env = _fake_tail_env(monkeypatch, exits)
+    runner = MagicMock(exit_reason="test stop", should_exit_with_failure=True, exit_code=None)
+
+    from gateway.run_bootstrap import _start_gateway_shutdown_tail
+    asyncio.run(_start_gateway_shutdown_tail(runner, None, *env, [False]))
+    assert not _post_tail_watchers()  # no checkpoint promise: the hard exit deadline alone covers it
+    assert exit_deadline.bound_post_tail(1, exits.append) is False
+    assert not exits
+
+
+def test_post_tail_bound_stands_down_once_the_funnel_disarmed():
+    exits: list = []
+    exit_deadline.set_exit_target(time.monotonic() + 0.2, "test")
+    assert exit_deadline.bound_post_tail(0, exits.append, grace_s=0.1)
+    assert exit_deadline.disarm()  # the main thread reached the exit funnel first
+    for watcher in _post_tail_watchers():
+        watcher.join(5)
+    assert not _post_tail_watchers()
+    assert not exits
+
+
+def test_post_tail_bound_cuts_a_wedged_default_executor_join():
+    """asyncio.run joins the default executor (up to 300s) after the coroutine returns."""
+    exits: list = []
+    release = threading.Event()
+
+    async def main():
+        loop = asyncio.get_running_loop()
+        loop.run_in_executor(None, release.wait, 30)  # a wedged executor thread
+        exit_deadline.set_exit_target(time.monotonic() + 0.3, "test")
+        exit_deadline.bound_post_tail(0, lambda code: exits.append((code, time.monotonic())), grace_s=0.2)
+
+    runner = threading.Thread(target=asyncio.run, args=(main(),), daemon=True)
+    started = time.monotonic()
+    runner.start()
+    try:
+        wait_until(lambda: exits, timeout=5.0, what="the post-tail bound to take the exit")
+        assert runner.is_alive()  # asyncio.run is still joining the executor: the bound did not wait for it
+        assert exits[0][0] == 0 and exits[0][1] - started < 2.0
+    finally:
+        release.set()
+        runner.join(10)
+
+
+def test_exit_funnel_parks_while_the_post_tail_bound_owns_the_exit():
+    exit_deadline._state["exit_owner"] = -1  # another thread took the exit
+    assert exit_deadline.disarm() is False
+    assert not exit_deadline._done.is_set()
+    exit_deadline._state.pop("exit_owner")
+    assert exit_deadline.disarm() is True
+
+
+def test_exit_funnel_parks_the_main_thread_once_the_bound_owns_the_exit():
+    exit_deadline._state["exit_owner"] = -1  # the post-tail bound's thread is running the funnel
+    funnel = threading.Thread(target=exit_deadline.enter_exit_funnel, daemon=True)
+    funnel.start()
+    funnel.join(0.5)
+    assert funnel.is_alive()  # parked: no second release/stamp/os._exit from the main thread
+    assert not exit_deadline._done.is_set()
+
+
+def test_exit_funnel_marks_its_phase(monkeypatch):
+    exit_deadline._state.update(started_mono=time.monotonic() - 2.0)
+    monkeypatch.setattr(gateway_run, "_best_effort", lambda step, *a, **k: None)
+    monkeypatch.setattr(gateway_run.os, "_exit", lambda code: None)
+    gateway_run._exit_after_graceful_shutdown(0)
+    assert 1.5 <= exit_deadline.phases()["exit_funnel"] <= 5.0
+
+
+def test_slow_tail_log_carries_a_tail_start_mark(monkeypatch, caplog):
+    """tail_s counted from the tail's start, the phase marks from the stop's: tail_start ties them."""
+    exits: list = []
+    env = _fake_tail_env(monkeypatch, exits)
+    import gateway.run_bootstrap as bootstrap
+    monkeypatch.setattr(bootstrap, "_SLOW_TAIL_LOG_S", 0.0)
+    exit_deadline._state.update(started_mono=time.monotonic() - 3.0)
+    runner = MagicMock(exit_reason="test stop", should_exit_with_failure=True, exit_code=None)
+    with caplog.at_level("WARNING", logger="gateway.run"):
+        asyncio.run(bootstrap._start_gateway_shutdown_tail(runner, None, *env, [False]))
+    marks = exit_deadline.phases()
+    assert 2.5 <= marks["tail_start"] <= marks["tail_done"]
+    assert any("tail_start" in rec.getMessage() for rec in caplog.records)
-- 
