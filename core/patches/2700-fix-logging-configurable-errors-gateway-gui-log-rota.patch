diff --git a/tests/tui_gateway/test_notification_park_drop_log.py b/tests/tui_gateway/test_notification_park_drop_log.py
new file mode 100644
index 0000000000..7e74c1b52d
--- /dev/null
+++ b/tests/tui_gateway/test_notification_park_drop_log.py
@@ -0,0 +1,71 @@
+"""A dropped process completion leaves one INFO line naming the process and its session. [daveey]
+
+A chat that never woke for a re-adopted job's exit could not be root-caused: the park, the unowned-event path
+and the registry's parked-event box all dropped completions at DEBUG (or silently), so agent.log held no trace.
+Progress notices (``watch_*``, ``heartbeat``) stay DEBUG so a chatty watcher cannot flood the log.
+"""
+
+from __future__ import annotations
+
+import logging
+
+import pytest
+
+from tools import process_registry_readopt
+from tools.process_registry import ProcessRegistry
+from tui_gateway import notification_park
+from tui_gateway import session_notifications
+
+KEY = "20261103_024624_52dad5"
+COMPLETION = {"type": "completion", "session_id": "proc_697954de64e9", "session_key": KEY, "exit_code": 0,
+              "park_if_unowned": True}
+
+
+@pytest.fixture(autouse=True)
+def _empty_park():
+    notification_park.clear()
+    yield
+    notification_park.clear()
+
+
+def _drop_lines(caplog, level=logging.INFO):
+    return [r.getMessage() for r in caplog.records if r.levelno == level and r.getMessage().startswith("Dropped ")]
+
+
+def test_completion_expiring_from_the_park_logs_info_with_process_and_session(caplog):
+    caplog.set_level(logging.DEBUG)
+    assert notification_park.park(dict(COMPLETION))
+    with notification_park._lock:
+        expired = notification_park._expire_locked(float("inf"))
+    notification_park._release(expired)
+    lines = _drop_lines(caplog)
+    assert len(lines) == 1, lines
+    assert "proc_697954de64e9" in lines[0] and KEY in lines[0] and "retention window" in lines[0]
+
+
+def test_progress_notice_drop_stays_debug(caplog):
+    caplog.set_level(logging.DEBUG)
+    notification_park.log_drop({"type": "watch_match", "session_id": "proc_x", "session_key": KEY}, "test")
+    assert _drop_lines(caplog) == []
+    assert len(_drop_lines(caplog, logging.DEBUG)) == 1
+
+
+def test_unowned_completion_the_park_refuses_logs_info(caplog, monkeypatch):
+    caplog.set_level(logging.DEBUG)
+    monkeypatch.setattr(notification_park, "park", lambda evt: False)
+    session_notifications._notif_unowned_event("poller-sid", dict(COMPLETION), None)
+    session_notifications._notif_unowned_event("poller-sid", dict(COMPLETION), [])  # shutdown drain
+    lines = _drop_lines(caplog)
+    assert len(lines) == 2, lines
+    assert all("proc_697954de64e9" in line and KEY in line for line in lines)
+
+
+def test_registry_parked_box_overflow_logs_the_evicted_exit(caplog, monkeypatch):
+    caplog.set_level(logging.DEBUG)
+    monkeypatch.setattr(process_registry_readopt, "_MAX_PARKED_EVENTS", 1)
+    registry = ProcessRegistry()
+    registry.park_unowned_event(dict(COMPLETION))
+    registry.park_unowned_event({**COMPLETION, "session_id": "proc_newer"})
+    lines = _drop_lines(caplog)
+    assert len(lines) == 1, lines
+    assert "proc_697954de64e9" in lines[0] and KEY in lines[0]
diff --git a/tools/process_registry_readopt.py b/tools/process_registry_readopt.py
index a3d36a245c..6a2a802359 100644
--- a/tools/process_registry_readopt.py
+++ b/tools/process_registry_readopt.py
@@ -206,7 +206,12 @@ class ProcessReadoptMixin:
             if self._parked_events is None:
                 self._parked_events = []
             self._parked_events.append(event)
+            evicted = self._parked_events[:-_MAX_PARKED_EVENTS]
             del self._parked_events[:-_MAX_PARKED_EVENTS]
+        for old in evicted:  # [daveey] never silent: a lost exit must leave a trace in agent.log
+            logger.info("Dropped %s notification for process %s (session=%s): parked-event box full (%d)",
+                        old.get("type", "completion"), old.get("session_id") or "?",
+                        old.get("session_key") or "?", _MAX_PARKED_EVENTS)
         from tui_gateway.notification_wait import wake
         wake(self.completion_queue)
 
diff --git a/tui_gateway/notification_park.py b/tui_gateway/notification_park.py
index a0aaf6e746..40c88ae9b6 100644
--- a/tui_gateway/notification_park.py
+++ b/tui_gateway/notification_park.py
@@ -69,9 +69,20 @@ def _release(events) -> None:
         if is_delegation:
             return_completion_offer(evt)
         unhold([evt])
-        (logger.warning if is_delegation else logger.debug)(
-            "Dropping parked %s notification past its retention window (key=%r)",
-            evt.get("type", "completion"), str(evt.get("session_key") or ""))
+        if is_delegation:
+            logger.warning("Dropping parked %s notification past its retention window (key=%r)",
+                           evt.get("type", "completion"), str(evt.get("session_key") or ""))
+        else:
+            log_drop(evt, "parked past its retention window")
+
+
+def log_drop(evt: dict, why: str) -> None:
+    """[daveey] One line for a process notification nobody will deliver. A completion (re-adopted or parked) is
+    INFO, naming the process and its owner session, so a chat that never woke for an exit leaves a trace in
+    agent.log; progress notices (``watch_*``, ``heartbeat``) stay DEBUG."""
+    (logger.debug if _is_progress(evt) else logger.info)(
+        "Dropped %s notification for process %s (session=%s): %s", evt.get("type", "completion"),
+        evt.get("session_id") or "?", str(evt.get("session_key") or "") or "?", why)
 
 
 def _key(evt: dict) -> str:
@@ -108,8 +119,7 @@ def park(evt: dict) -> bool:
             _parked.append((now + RETENTION_SECONDS, evt))
     _release(expired)
     for held in displaced:
-        logger.debug("Dropping parked %s notification to make room for a %s (key=%r)",
-                     held.get("type"), evt.get("type", "completion"), _key(held))
+        log_drop(held, f"displaced from the park by a {evt.get('type', 'completion')}")
     if admitted:
         from tools.process_registry import process_registry
         from tui_gateway.notification_wait import wake
diff --git a/tui_gateway/session_notifications.py b/tui_gateway/session_notifications.py
index 941f512d87..6db01f5da2 100644
--- a/tui_gateway/session_notifications.py
+++ b/tui_gateway/session_notifications.py
@@ -336,15 +336,17 @@ def _notif_unowned_event(sid: str, evt: dict, deferred) -> None:
         if is_delegation:
             deferred.append(evt)
         else:
-            logger.debug("Dropping unowned %s notification during shutdown drain (origin=%r key=%r)",
-                         evt_type, origin, key)
+            notification_park.log_drop(evt, f"unowned during shutdown drain (origin={origin!r})")
     else:
         # A durable replay stays pending: hand it back so the orphan sweep re-offers it once its owner
         # is live (#97202), and keep that retry out of WARNING.
         restored = is_delegation and bool(evt.get("restored"))
-        (logger.warning if is_delegation and not restored else logger.debug)(
-            "Dropping unowned %s notification (origin=%r key=%r) instead of delivering to session %s",
-            evt_type, origin, key, sid)
+        if is_delegation:
+            (logger.debug if restored else logger.warning)(
+                "Dropping unowned %s notification (origin=%r key=%r) instead of delivering to session %s",
+                evt_type, origin, key, sid)
+        else:
+            notification_park.log_drop(evt, f"unowned and not parkable (origin={origin!r}, poller={sid})")
         if is_delegation:
             from tools.async_delegation import return_completion_offer
             return_completion_offer(evt)
