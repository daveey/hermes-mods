From 268c093d4926826f54532958ba25e291d854f001 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 10:12:41 +0000
Subject: [PATCH] refactor(status): move links-health recovery step to topical
 module [daveey]

Move scoped links-health recovery into a topical module. Stale or partial
card rows remain source_unknown before status interpretation. Source health
changes wake the existing outcome executor, including stored unknown outcomes
without remote rows; recovery uses the exact origin store without profile
fallback and acknowledges only after every refresh succeeds.

---
 tui_gateway/notice_fanout.py       | 11 ++---------
 tui_gateway/notice_links_health.py | 13 +++++++++++++
 2 files changed, 15 insertions(+), 9 deletions(-)

diff --git a/tui_gateway/notice_fanout.py b/tui_gateway/notice_fanout.py
index b4242f7eb3..03d500b74e 100644
--- a/tui_gateway/notice_fanout.py
+++ b/tui_gateway/notice_fanout.py
@@ -393,6 +393,7 @@ def _remote_change_pass(session_db: Callable, origin_db: Optional[Callable] = No
     global _remote_memo
     from hermes_cli import kanban_session_activity as activity
     from hermes_cli import fact_links_health
+    from tui_gateway import notice_links_health
     origin = activity._origin_scope()
     health_generation = fact_links_health.pending(origin)
     out = FanoutResult()
@@ -464,15 +465,7 @@ def _remote_change_pass(session_db: Callable, origin_db: Optional[Callable] = No
     committed = state.ack_remote(acked)
     if not committed:
         out.retry()
-    recovered_all = True
-    if health_generation is not None:
-        from tui_gateway import notice_links_health
-        done, recovered_all = notice_links_health.recover(origin, set(previous.keys() | snapshot.keys()), origin_db)
-        for chat, tip in done:
-            out.append({"board": None, "task_id": None, "chat_id": chat, "session_id": tip,
-                        "status": None, "skipped": None, "source": "remote"})
-        if not recovered_all:
-            out.retry()
+    recovered_all = notice_links_health.recover_into(out, origin, health_generation, set(previous.keys() | snapshot.keys()), origin_db)
     if committed and inputs is not None and all(previous.get(c) == snapshot.get(c) or c in acked for c in previous.keys() | snapshot.keys()):
         # Only certify a projection if its cursor stayed still THROUGH fingerprint collection. A later
         # fingerprint must not describe a write the projection never saw.
diff --git a/tui_gateway/notice_links_health.py b/tui_gateway/notice_links_health.py
index f72ece89c2..2cda387cff 100644
--- a/tui_gateway/notice_links_health.py
+++ b/tui_gateway/notice_links_health.py
@@ -65,3 +65,16 @@ def recover(origin: tuple, skip: set[str], opener: Optional[Callable] = None) ->
         logger.warning("links-health outcome recovery failed", exc_info=True)
         complete = False
     return done, complete
+
+
+def recover_into(out: Any, origin: tuple, generation: Optional[int], skip: set[str], opener: Optional[Callable] = None) -> bool:
+    """Executor-side step: only while a health generation is pending. True when nothing is left to retry."""
+    if generation is None:
+        return True
+    done, complete = recover(origin, skip, opener)
+    for chat, tip in done:
+        out.append({"board": None, "task_id": None, "chat_id": chat, "session_id": tip,
+                    "status": None, "skipped": None, "source": "remote"})
+    if not complete:
+        out.retry()
+    return complete
-- 
