From a8b0525d5341bc9ba465422c4db283abb0482f31 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:14:40 +0000
Subject: [PATCH] [daveey] Deflake Docker skills refresh interval assertion

---
 tests/tools/test_docker_skills_mount_live.py | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/tests/tools/test_docker_skills_mount_live.py b/tests/tools/test_docker_skills_mount_live.py
index a6aa98a764b..174fdfb00f3 100644
--- a/tests/tools/test_docker_skills_mount_live.py
+++ b/tests/tools/test_docker_skills_mount_live.py
@@ -8,6 +8,7 @@ now mounts its sanitized copy, refreshed in place before commands.
 
 import subprocess
 from pathlib import Path
+from types import SimpleNamespace
 
 import pytest
 
@@ -59,6 +60,10 @@ def _past_refresh_interval(env) -> None:
 
 
 def test_files_added_after_start_reach_mount_only_if_readable(skills_home, monkeypatch):
+    # Container startup / a descheduled worker can exceed the refresh interval.
+    # Control only Docker's clock, not the shared time module used by test deadlines.
+    now = 100.0
+    monkeypatch.setattr(docker_env, "time", SimpleNamespace(monotonic=lambda: now))
     calls = _mock_docker(monkeypatch)
     env = _make_env()
     mounted = _skills_mount_source(calls)
@@ -70,11 +75,14 @@ def test_files_added_after_start_reach_mount_only_if_readable(skills_home, monke
     (skills_home / "s" / ".env").write_text("TOKEN=secret")
     (skills_home / "s" / "SKILL.md").write_text("# s")
 
-    env._before_execute()  # inside the interval: no refresh yet, and nothing denied either
+    refreshed_at = now
+    now = refreshed_at + docker_env._SKILLS_REFRESH_INTERVAL_SECONDS - 0.01
+    env._before_execute()  # just inside the interval: nothing new, including denied files
     assert _files(mounted) == {"s/notes.md"}
 
-    _past_refresh_interval(env)
+    now = refreshed_at + docker_env._SKILLS_REFRESH_INTERVAL_SECONDS
     env._before_execute()
+    assert env._skills_refreshed_at == now
     assert _files(mounted) == {"s/notes.md", "s/SKILL.md"}
     assert not (mounted / ".hub").exists()
 
-- 
2.55.0

