From fb8ae4e4361c1221695d7047360c663806719f20 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 06:58:43 +0000
Subject: [PATCH] test(cli): await title output before asserting classic view
 [daveey]

---
 .../test_gateway_chat_commands_live.py        | 28 +++++++++++++++----
 1 file changed, 23 insertions(+), 5 deletions(-)

diff --git a/tests/hermes_cli/test_gateway_chat_commands_live.py b/tests/hermes_cli/test_gateway_chat_commands_live.py
index e2a778cc98c..b860c442353 100644
--- a/tests/hermes_cli/test_gateway_chat_commands_live.py
+++ b/tests/hermes_cli/test_gateway_chat_commands_live.py
@@ -87,9 +87,9 @@ def classic_session(tmp_path):
         with sqlite3.connect(f"file:{home / 'state.db'}?mode=ro", uri=True) as conn:
             return conn.execute(sql, args).fetchall()
 
-    def session_id():
-        """Main's bare `/title` prints the full id (the banner shows main's 8-character label)."""
-        shown = send("/title", "Session ID: ")
+    def session_id(title=None):
+        """Wait for the title too when asserting it: the ID is printed before the store read."""
+        shown = send("/title", f"Title: {title}" if title is not None else "Session ID: ")
         return [line.split("Session ID: ", 1)[1].strip() for line in shown.splitlines() if "Session ID: " in line][-1]
 
     with (home / "gw.log").open("w") as log:
@@ -129,13 +129,31 @@ def classic_session(tmp_path):
 
 
 @pytest.mark.platforms("linux")
-def test_classic_view_title_and_usage_match_main(tmp_path):
+@pytest.mark.parametrize("fragment_title", [False, True], ids=["normal", "fragmented-title"])
+def test_classic_view_title_and_usage_match_main(tmp_path, monkeypatch, fragment_title):
+    # /title prints the ID before its separate store read and title print. Model
+    # three pane observations in that gap, without changing the CLI or its data.
+    run = subprocess.run
+    fragments = []
+
+    def capture_fragment(*args, **kwargs):
+        result = run(*args, **kwargs)
+        if (fragment_title and "capture-pane" in args[0]
+                and "Session ID: " in result.stdout and len(fragments) < 3):
+            before, marker, after = result.stdout.partition("Session ID: ")
+            result.stdout = before + marker + after.split("\n", 1)[0] + "\n"
+            fragments.append(result.stdout)
+        return result
+
+    monkeypatch.setattr(subprocess, "run", capture_fragment)
     with classic_session(tmp_path) as (send, screen, db, session_id):
         send("first question", "RECOVERY_ACK_first question")
         send("second question", "RECOVERY_ACK_second question")
         send("/title View Title", "Session title set: View Title")
-        sid = session_id()
+        sid = session_id(title="View Title")
         assert "Title: View Title" in screen()
+        if fragment_title:
+            assert len(fragments) == 3
         assert db("SELECT title FROM sessions WHERE id=?", sid) == [("View Title",)]
         send("/usage", "Session Token Usage")
         active = [r[0] for r in db("SELECT content FROM messages WHERE session_id=? AND active=1 AND role='user'", sid)]
-- 
