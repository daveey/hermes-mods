+
+// [daveey] desktop.log `state=unread … outcome=waiting` with every card parked: the dot painted the emerald unread
+// colour, which users read as done. Unread is emerald only when the stored outcome is done (or absent).
+describe('unread dot precedence against the stored outcome', () => {
+  it.each([
+    ['waiting', 'waiting'],
+    ['running', 'waiting'],
+    ['unresolved', 'attention'],
+    ['decision', 'stuck'],
+    ['muted', 'blocked']
+  ] as const)('an unread %s chat paints the %s tone, not the done emerald', (kind, stripe) => {
+    expect(unreadDotOutcomeStripe(OUTCOMES[kind])).toBe(stripe)
+    expect(unreadDotOutcomeStripe(OUTCOMES[kind])).not.toBe('done')
+  })
+
+  it('keeps the emerald unread dot for done, no outcome, or an unknown kind', () => {
+    expect(unreadDotOutcomeStripe(OUTCOMES.done)).toBeNull()
+    expect(unreadDotOutcomeStripe(null)).toBeNull()
+    expect(unreadDotOutcomeStripe(undefined)).toBeNull()
+    expect(unreadDotOutcomeStripe({ kind: 'from-the-future' })).toBeNull()
+  })
+
+  it('labels the dot unread plus the outcome, never "Finished"', () => {
+    expect(unreadDotOutcomeLabel(OUTCOMES.waiting, r)).toBe('Unread — Waiting')
+    expect(unreadDotOutcomeLabel(OUTCOMES.unresolved, r)).toBe(
+      'Unread — Unresolved: a card update arrived and nothing answered it'
+    )
+    expect(unreadDotOutcomeLabel(OUTCOMES.decision, r)).toBe('Unread — Waiting on your decision')
+    expect(unreadDotOutcomeLabel(OUTCOMES.waiting, r)).not.toContain(r.finishedUnread)
+  })
+})
diff --git a/apps/desktop/src/lib/session-outcome.ts b/apps/desktop/src/lib/session-outcome.ts
index e55245ef19..85c46ce19d 100644
--- a/apps/desktop/src/lib/session-outcome.ts
+++ b/apps/desktop/src/lib/session-outcome.ts
@@ -35,6 +35,42 @@ export const outcomeStripe = (outcome: null | SessionOutcome | undefined): null
   }
 }
 
+/** [daveey] The tone an UNREAD dot takes from the stored outcome. The emerald unread dot means "finished, not yet
+ *  seen", and users read it as done; a chat whose outcome is waiting / running / unresolved / decision / muted is not
+ *  done, so its unread dot paints that outcome's stripe colour instead (still filled, so it still reads as new).
+ *  Null = keep the emerald unread dot (outcome `done`, no outcome, or a kind this app does not know). */
+export const unreadDotOutcomeStripe = (outcome: null | SessionOutcome | undefined): null | SessionStatusStripe => {
+  const stripe = outcomeStripe(outcome)
+
+  return stripe && stripe !== 'done' ? stripe : null
+}
+
+/** [daveey] The unread dot's label when its outcome is not done: unread, plus what the outcome says (not "Finished"). */
+export const unreadDotOutcomeLabel = (
+  outcome: SessionOutcome,
+  r: Pick<
+    Translations['sidebar']['row'],
+    'outcomeDecision' | 'outcomeMuted' | 'outcomeRunning' | 'outcomeUnresolved' | 'outcomeWaiting' | 'unreadNotDone'
+  >
+): string => {
+  switch (outcome.kind) {
+    case 'decision':
+      return r.unreadNotDone(r.outcomeDecision)
+
+    case 'muted':
+      return r.unreadNotDone(r.outcomeMuted)
+
+    case 'running':
+      return r.unreadNotDone(r.outcomeRunning)
+
+    case 'unresolved':
+      return r.unreadNotDone(r.outcomeUnresolved(outcome.reason ?? null))
+
+    default:
+      return r.unreadNotDone(r.outcomeWaiting)
+  }
+}
+
