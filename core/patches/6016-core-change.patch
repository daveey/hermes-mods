From 46715076198f9b00e1a44bcbeb35214b105f1c3e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 22:32:43 +0000
Subject: [PATCH 6016] Kanban sync: bounded feed apply, replica write guards and snapshot rebuild

Public mirror of source commit 46715076198f9b00e1a44bcbeb35214b105f1c3e.

---
diff --git a/docs/designs/kanban-feed-writer-budget.md b/docs/designs/kanban-feed-writer-budget.md
index 8cddd4a77f6..0a39b790f16 100644
--- a/docs/designs/kanban-feed-writer-budget.md
+++ b/docs/designs/kanban-feed-writer-budget.md
@@ -16,8 +16,9 @@
 transaction. The atomic repair/snapshot API remains available unchanged.
 
 Schema columns are captured outside the reservation and reused for its page.
-A 5 ms scheduling opportunity after each reservation avoids immediately retaking
-the writer ahead of an already waiting dispatcher. SQLite has no FIFO guarantee;
+A 100 ms scheduling opportunity after each reservation avoids immediately retaking
+ the writer ahead of an already waiting dispatcher, including SQLite's busy-handler
+ backoff (a 5 ms gap can fall entirely between its retries). SQLite has no FIFO guarantee;
 the contention regression checks measured dispatcher acquisition, while the
 separate dispatcher-side timeout remains the ultimate admission-wait bound.
 
diff --git a/hermes_cli/kanban_sync_apply_budget.py b/hermes_cli/kanban_sync_apply_budget.py
index c0cc477d58d..575f4b06b86 100644
--- a/hermes_cli/kanban_sync_apply_budget.py
+++ b/hermes_cli/kanban_sync_apply_budget.py
@@ -18,6 +18,7 @@
 MAX_ROWS = 32
 MAX_TRANSACTION_S = 0.25
 PUSH_INTERVAL_S = 5.0
+WRITER_YIELD_S = 0.1
 _SCHEMA: contextvars.ContextVar[Any] = contextvars.ContextVar("sync_apply_schema", default=None)
 _LIMIT: contextvars.ContextVar[Any] = contextvars.ContextVar("sync_apply_limit", default=None)
 _DEADLINE: contextvars.ContextVar[Any] = contextvars.ContextVar("sync_apply_deadline", default=None)
@@ -151,7 +152,7 @@
             if size == 1:
                 raise
             size = max(1, size // 2)
-            _YIELD.wait(0.005)
+            _YIELD.wait(WRITER_YIELD_S)
             continue
         finally:
             _LIMIT.reset(token)
@@ -164,6 +165,6 @@
             break
         # SQLite does not promise FIFO writer admission. Give an already-waiting
         # dispatcher a real scheduling window, not an immediate reacquisition.
-        _YIELD.wait(0.005)
+        _YIELD.wait(WRITER_YIELD_S)
     service_pushes()
     return result
diff --git a/tests/hermes_cli/test_kanban_sync_apply_budget.py b/tests/hermes_cli/test_kanban_sync_apply_budget.py
index 8cae54e93a2..c6dce12480d 100644
--- a/tests/hermes_cli/test_kanban_sync_apply_budget.py
+++ b/tests/hermes_cli/test_kanban_sync_apply_budget.py
@@ -105,7 +105,7 @@
         conn.set_trace_callback(None)
     lookups = [(inside, sql) for inside, sql in statements if "TABLE_INFO" in sql.upper()]
     assert lookups and not any(inside for inside, _ in lookups), "\n".join(stacks)
-    assert len(lookups) <= len(sync.SYNCED_TABLES) + 1
+    assert len([sql for _, sql in lookups if not sql.lstrip().startswith("--")]) <= len(sync.SYNCED_TABLES) + 1
 
 
 def test_sql_deadline_rolls_back_single_row(conn, monkeypatch):
