From abd7d490f31e81b6851127f5ed78537d010ee596 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 9 Oct 2026 11:56:24 -0700
Subject: [PATCH] feat(desktop): add 'Off' option to completion sound settings

- Add COMPLETION_SOUND_OFF_ID (0) and isCompletionSoundOff() to the store
- Skip playback in playCompletionSound and previewCompletionSound when off
- Add 'Off' SelectItem to the notifications settings dropdown
---
 .../app/settings/notifications-settings.tsx   |  3 ++-
 apps/desktop/src/lib/completion-sound.ts      | 22 ++++++++++++++++---
 apps/desktop/src/store/completion-sound.ts    | 13 +++++++++++
 3 files changed, 34 insertions(+), 4 deletions(-)

diff --git a/apps/desktop/src/app/settings/notifications-settings.tsx b/apps/desktop/src/app/settings/notifications-settings.tsx
index c210cca8f0..deccc1cc55 100644
--- a/apps/desktop/src/app/settings/notifications-settings.tsx
+++ b/apps/desktop/src/app/settings/notifications-settings.tsx
@@ -8,7 +8,7 @@ import { COMPLETION_SOUND_VARIANTS, previewCompletionSound } from '@/lib/complet
 import { triggerHaptic } from '@/lib/haptics'
 import { Bell, Play } from '@/lib/icons'
 import { cn } from '@/lib/utils'
-import { $completionSoundVariantId, setCompletionSoundVariantId } from '@/store/completion-sound'
+import { $completionSoundVariantId, COMPLETION_SOUND_OFF_ID, setCompletionSoundVariantId } from '@/store/completion-sound'
 import {
   $nativeNotifyPrefs,
   NATIVE_NOTIFICATION_KINDS,
@@ -97,6 +97,7 @@ export function NotificationsSettings({ subpage }: NotificationsSettingsProps =
                 </SelectTrigger>
 
                 <SelectContent>
+                  <SelectItem value={String(COMPLETION_SOUND_OFF_ID)}>Off</SelectItem>
                   {COMPLETION_SOUND_VARIANTS.map(variant => (
                     <SelectItem key={variant.id} value={String(variant.id)}>
                       {variant.name}
diff --git a/apps/desktop/src/lib/completion-sound.ts b/apps/desktop/src/lib/completion-sound.ts
index 6245c10723..0b9524ac52 100644
--- a/apps/desktop/src/lib/completion-sound.ts
+++ b/apps/desktop/src/lib/completion-sound.ts
@@ -3,7 +3,7 @@
 
 import { getAudioContext } from '@/lib/audio-context'
 import { ownsAmbientCue } from '@/store/ambient'
-import { $completionSoundVariantId, resolveCompletionSoundVariantId } from '@/store/completion-sound'
+import { $completionSoundVariantId, COMPLETION_SOUND_OFF_ID, isCompletionSoundOff, resolveCompletionSoundVariantId } from '@/store/completion-sound'
 import { $hapticsMuted } from '@/store/haptics'
 
 type OscType = OscillatorType
@@ -420,7 +420,13 @@ function playVariant(variantId: number) {
 // Audition the selected variant from settings. Bypasses the haptics mute toggle so
 // sound design can be compared even when turn-end cues are silenced.
 export function previewCompletionSound(variantId?: number) {
-  playVariant(resolveCompletionSoundVariantId(variantId ?? $completionSoundVariantId.get()))
+  const resolved = resolveCompletionSoundVariantId(variantId ?? $completionSoundVariantId.get())
+
+  if (resolved === COMPLETION_SOUND_OFF_ID) {
+    return
+  }
+
+  playVariant(resolved)
 }
 
 // Plays the selected completion cue on any `message.complete`. Pass a dedupeKey
@@ -432,7 +438,17 @@ export function playCompletionSound(dedupeKey?: string) {
     return
   }
 
-  const play = () => playVariant($completionSoundVariantId.get())
+  if (isCompletionSoundOff($completionSoundVariantId.get())) {
+    return
+  }
+
+  const play = () => {
+    if (isCompletionSoundOff($completionSoundVariantId.get())) {
+      return
+    }
+
+    playVariant($completionSoundVariantId.get())
+  }
 
   if (!dedupeKey) {
     return play()
diff --git a/apps/desktop/src/store/completion-sound.ts b/apps/desktop/src/store/completion-sound.ts
index 2db17feb58..b69978e6d9 100644
--- a/apps/desktop/src/store/completion-sound.ts
+++ b/apps/desktop/src/store/completion-sound.ts
@@ -6,12 +6,25 @@ const STORAGE_KEY = 'hermes.desktop.completionSoundVariantId'
 
 export const DEFAULT_COMPLETION_SOUND_VARIANT_ID = 1
 
+// 0 = Off (no completion sound). 1–14 are the curated presets in
+// lib/completion-sound.ts. Validating by range (not membership) keeps this
+// store free of a dependency on the lib, which imports the atom back.
+export const COMPLETION_SOUND_OFF_ID = 0
+
 // Range mirrors COMPLETION_SOUND_VARIANTS in lib/completion-sound.ts. Validating
 // by range (not membership) keeps this store free of a dependency on the lib,
 // which imports the atom back — a membership check would close that cycle.
 const VARIANT_COUNT = 14
 
+export function isCompletionSoundOff(variantId: number): boolean {
+  return variantId === COMPLETION_SOUND_OFF_ID
+}
+
 export function resolveCompletionSoundVariantId(variantId: number): number {
+  if (variantId === COMPLETION_SOUND_OFF_ID) {
+    return COMPLETION_SOUND_OFF_ID
+  }
+
   return Number.isInteger(variantId) && variantId >= 1 && variantId <= VARIANT_COUNT
     ? variantId
     : DEFAULT_COMPLETION_SOUND_VARIANT_ID
-- 
