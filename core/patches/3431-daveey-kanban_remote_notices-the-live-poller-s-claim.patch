From c1aef778f81bac1fb5d1b5f4369316bccc6d0427 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:25:31 +0000
Subject: [PATCH] [daveey] kanban_remote_notices: the live poller's claim log
 can't strand its claim; healthy open-chat skip is DEBUG (PR #2116 review
 nits)

t_01a1d49b1212016e, follow-up to review 5889924188 on PR #2116.

- collect logged the live poller's claim (`_note_wait`) after `_claim_notice` returned offer but before
  `out.append`. An exception there (eviction racing a concurrent sweep past 5000 entries) fell into collect's
  outer except, which returns [] and stranded the claim in flight under this pid. The log now runs after the
  append, and `_note_wait` never raises: the `_waits` bookkeeping runs under a lock with `pop(k, None)`
  eviction, and any failure is swallowed to DEBUG.
- The healthy path logged two INFO lines per remote notice in an open chat (sweep "chat is open in this
  backend" + collect "claimed by the live poller"). The open-chat skip now logs INFO only when the notice is
  still unclaimed by this backend's poller past the waker's grace window; otherwise DEBUG.
- Tests: collect still offers (and holds) its claim when the wait log raises (RED before: collect returned
  []); open-chat skip is DEBUG within the grace window and after the poller's claim, INFO once when stuck past
  it (RED before: 3 INFO lines); `_wait_reason`'s own-holder branch ("in flight in this backend (pid N) until
  its turn's row is written") and the gateway-FIFO skip each log once over two sweeps.

Verified: 35 test files importing kanban_remote_notices, 512 passed; scripts/check --base origin/main ok.
---
 .../tui_gateway/test_kanban_remote_notices.py | 123 ++++++++++++++++++
 tui_gateway/kanban_remote_notices.py          |  42 ++++--
 2 files changed, 155 insertions(+), 10 deletions(-)

diff --git a/tests/tui_gateway/test_kanban_remote_notices.py b/tests/tui_gateway/test_kanban_remote_notices.py
index 9d0c430134..bd84ea9ff3 100644
--- a/tests/tui_gateway/test_kanban_remote_notices.py
+++ b/tests/tui_gateway/test_kanban_remote_notices.py
@@ -846,3 +846,126 @@ def test_every_silent_sweep_skip_names_its_reason_once(tmp_path, caplog):
         f"remote Kanban notice {ref} {state} for chat {CHAT} waits: claimed by the live poller of backend pid "
         f"{os.getpid()}",
     ]
+
+
+class _GraceWaker:
+    def __init__(self, grace_s=0.0):
+        self.grace_s, self.woken = grace_s, []
+
+    def deliver(self, tip, text, metadata, task, now, *, persist, started):
+        self.woken.append(task["id"])
+        return "started"
+
+
+@contextlib.contextmanager
+def _chat_db(tmp_path):
+    with SessionDB(tmp_path / "state.db") as db:
+        db.create_session(CHAT, "desktop")
+
+        @contextlib.contextmanager
+        def opener(profile, sid):
+            yield (db, sid) if sid == CHAT else (None, None)
+
+        yield opener
+
+
+def _wait_lines(caplog, level=None):
+    return [r.getMessage() for r in caplog.records
+            if " waits: " in r.getMessage() and (level is None or r.levelno == level)]
+
+
+def test_collect_still_offers_its_claim_when_the_wait_log_raises(tmp_path, monkeypatch, caplog):
+    """PR #2116 review: the claim log ran between _claim_notice's offer and out.append, so an exception there
+    (eviction racing a concurrent sweep) fell into collect's outer except and stranded the claim in flight
+    under this pid. The log is after the append now and never raises."""
+    import logging
+    from tui_gateway import kanban_remote_notices as krn
+
+    now = time.time()
+    replica = _hub(tmp_path, [_card("t_logboom", CHAT, status="done", at=now - 40)])
+    ledger = tmp_path / "ledger.db"
+    krn._reset_for_tests()
+
+    def boom(*a, **k):
+        raise RuntimeError("dictionary changed size during iteration")
+
+    caplog.set_level(logging.INFO, logger=krn.__name__)
+    monkeypatch.setattr(krn.logger, "info", boom)
+    got = krn.collect(CHAT, "default", hub_db=replica, ledger=ledger, now=now)
+    assert [g["ref"].rsplit("/", 1)[-1] for g in got] == ["t_logboom"]
+    row = _ledger_row(ledger, CHAT, "hub/default/default/t_logboom")
+    assert row is not None and row["delivered"] == 0 and row["holder_pid"] == os.getpid()  # in flight AND offered
+
+
+def test_open_chat_skip_logs_info_only_when_unclaimed_past_the_grace_window(tmp_path, caplog):
+    """PR #2116 review: the healthy path logged two INFO lines per notice (the sweep's open-chat skip and the
+    poller's claim). Within the grace window, or once this backend's poller claimed it, the skip is DEBUG."""
+    import logging
+    from tui_gateway import kanban_remote_notices as krn
+
+    now = time.time()
+    replica = _hub(tmp_path, [_card("t_open", CHAT, status="done", at=now - 40)])
+    ref = "hub/default/default/t_open"
+    caplog.set_level(logging.DEBUG, logger=krn.__name__)
+    with _chat_db(tmp_path) as opener:
+        krn._reset_for_tests()
+        ledger = tmp_path / "healthy.db"
+        sweep = dict(replica_path=replica, gateway="macbook", session_db=opener, ledger=ledger,
+                     waker=_GraceWaker(60.0), live_ids={CHAT})
+        sweep_remote_notices(now=now, **sweep)  # inside the grace window
+        assert krn.collect(CHAT, "default", hub_db=replica, ledger=ledger, now=now + 1)
+        sweep_remote_notices(now=now + 120, **sweep)  # past it, but our poller holds the claim
+        info = _wait_lines(caplog, logging.INFO)
+        assert len(info) == 1 and "claimed by the live poller" in info[0], info
+
+        caplog.clear()
+        krn._reset_for_tests()
+        sweep["ledger"] = tmp_path / "stuck.db"
+        sweep_remote_notices(now=now, **sweep)
+        assert _wait_lines(caplog, logging.INFO) == []
+        sweep_remote_notices(now=now + 120, **sweep)  # still unclaimed past the window: worth an INFO line
+        assert [line.split(" waits: ")[1] for line in _wait_lines(caplog, logging.INFO)] == [
+            "chat is open in this backend; its live poller claims it"]
+        assert ref in _wait_lines(caplog, logging.INFO)[0]
+
+
+def test_sweep_names_its_own_in_flight_claim_and_the_gateway_fifo_once(tmp_path, monkeypatch, caplog):
+    """PR #2116 review: _wait_reason's own-holder branch and the FIFO skip had no test."""
+    import logging
+    from tui_gateway import kanban_remote_fifo
+    from tui_gateway import kanban_remote_notices as krn
+
+    now = time.time()
+    card = _card("t_mine", CHAT, status="done", at=now - 40)
+    replica = _hub(tmp_path, [card])
+    ref, state = "hub/default/default/t_mine", krn._notice_state(card["task"])
+    caplog.set_level(logging.INFO, logger=krn.__name__)
+    with _chat_db(tmp_path) as opener:
+        krn._reset_for_tests()
+        ledger = tmp_path / "mine.db"
+        krn._ledger(ledger).close()
+        with sqlite3.connect(ledger) as conn:  # this backend claimed it; its turn has not written the row yet
+            conn.execute("INSERT INTO notices (session, ref, state, at, delivered, holder_pid, holder_start, "
+                         "notice_key, legacy_seen) VALUES (?,?,?,?,0,?,NULL,?,0)",
+                         (CHAT, ref, state, now - 30, os.getpid(), "k"))
+        waker = _GraceWaker()
+        for _ in range(2):
+            sweep_remote_notices(replica_path=replica, gateway="macbook", session_db=opener, ledger=ledger,
+                                 now=now, waker=waker)
+        assert waker.woken == []
+        assert _wait_lines(caplog) == [
+            f"remote Kanban notice {ref} {state} for chat {CHAT} waits: in flight in this backend (pid "
+            f"{os.getpid()}) until its turn's row is written"]
+
+        caplog.clear()
+        krn._reset_for_tests()
+        held = []
+        monkeypatch.setattr(kanban_remote_fifo, "gateway_holds", lambda db, ids, key: held.append(key) or True)
+        waker = _GraceWaker()
+        for _ in range(2):
+            sweep_remote_notices(replica_path=replica, gateway="macbook", session_db=opener,
+                                 ledger=tmp_path / "fifo.db", now=now, waker=waker)
+        assert held and waker.woken == []
+        assert _wait_lines(caplog) == [
+            f"remote Kanban notice {ref} {state} for chat {CHAT} waits: left to the gateway's FIFO (the gateway "
+            "runs this chat's turns)"]
diff --git a/tui_gateway/kanban_remote_notices.py b/tui_gateway/kanban_remote_notices.py
index 7e0c295470..dc66ac15d0 100644
--- a/tui_gateway/kanban_remote_notices.py
+++ b/tui_gateway/kanban_remote_notices.py
@@ -653,9 +653,9 @@ def collect(session_key: str, profile: str, *, hub_db: Optional[Path] = None, le
                 if verdict == "settled" and reason == "expired":
                     _log_dropped(task, ref, state, claim_session, first_seen or 0.0, now)  # expired: observed
                 if verdict == "offer":
-                    _note_wait(claim_session, ref, state, f"claimed by the live poller of backend pid {os.getpid()}")
                     out.append(_notice_item(card, claim_session, me, profile, now))
                     offered.add((ref, state))
+                    _note_wait(claim_session, ref, state, f"{_POLLER_CLAIM}{os.getpid()}")  # after the claim is out
         finally:
             conn.close()
         from tui_gateway.kanban_remote_late import collect_groups, release_undelivered
@@ -739,18 +739,40 @@ _last_stale: dict[str, int] = {}  # replica -> stale count last logged, so the s
 # change of reason. Without it a notice held in flight for 30 min left no line, and the 46 min "discovery lag" on
 # t_01a1d46be379dfd3 was filed against a poller that had seen the card in 63 s.
 _waits: dict[tuple, str] = {}
+_waits_lock = threading.Lock()
 _WAITS_MAX = 5000
+_POLLER_CLAIM = "claimed by the live poller of backend pid "
 
 
 def _note_wait(session: str, ref: str, state: str, why: str) -> None:
-    key = (session, ref, state)
-    if _waits.get(key) == why:
-        return
-    _waits.pop(key, None)
-    _waits[key] = why
-    while len(_waits) > _WAITS_MAX:
-        _waits.pop(next(iter(_waits)))
-    logger.info("remote Kanban notice %s %s for chat %s waits: %s", ref, state, session, why)
+    """Log why a notice waits, once per change of reason. Never raises: collect calls it holding a claim, and an
+    exception there (eviction racing a concurrent sweep) would strand that claim in flight (PR #2116 review)."""
+    try:
+        key = (session, ref, state)
+        with _waits_lock:
+            if _waits.get(key) == why:
+                return
+            _waits.pop(key, None)
+            _waits[key] = why
+            while len(_waits) > _WAITS_MAX:
+                _waits.pop(next(iter(_waits)), None)
+        logger.info("remote Kanban notice %s %s for chat %s waits: %s", ref, state, session, why)
+    except Exception:  # diagnostics only; the caller's claim must not depend on them
+        with contextlib.suppress(Exception):
+            logger.debug("remote kanban: wait log failed", exc_info=True)
+
+
+def _note_open_chat(sid: str, ref: str, state: str, waker, observed_at, now) -> None:
+    """The healthy path: this backend's live poller claims the notice within seconds and logs that claim. Only a
+    notice still unclaimed past the waker's grace window logs the open-chat skip at INFO (PR #2116 review)."""
+    with _waits_lock:
+        last = _waits.get((sid, ref, state), "")
+    grace = waker.grace_s if waker is not None else 0.0
+    if observed_at is not None and now is not None and now - observed_at >= grace and not last.startswith(
+            _POLLER_CLAIM):
+        _note_wait(sid, ref, state, "chat is open in this backend; its live poller claims it")
+    else:
+        logger.debug("remote Kanban notice %s %s for chat %s: chat is open in this backend", ref, state, sid)
 
 
 def _wait_reason(conn, session: str, ref: str, state: str) -> Optional[str]:
@@ -1142,7 +1164,7 @@ def _deliver_link(owner, key, task, link, *, me, ref, state, path, live, session
         if memo_key in _delivered:
             return
         if sid in live:
-            _note_wait(sid, ref, state, "chat is open in this backend; its live poller claims it")
+            _note_open_chat(sid, ref, state, waker, observed_at, now)
             return
         if waker is not None and observed_at is not None and now is not None and now - observed_at < waker.grace_s:
             return  # a live poller (any backend) claims within seconds; it owns the chat's turn
