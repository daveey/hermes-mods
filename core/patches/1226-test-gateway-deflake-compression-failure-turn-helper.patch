From 29e3270533d5598b11efbdd4288c7d5c6176e0ca Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 11:17:12 +0000
Subject: [PATCH] test(gateway): deflake compression-failure turn helper's 2s
 wait_for deadline

_run_compression_failure_turn wrapped the whole runner turn in
asyncio.wait_for(timeout=2). A quiet hub run of the first caller takes
~1.8s (first-call imports), so CPU-throttled CI runners missed it:
test_runner_compressed_receipt[rotated] failed with TimeoutError in
run 41028380688 and passed on retry. Under a 10% SIGSTOP/SIGCONT duty
cycle all 5 callers failed; with a 120s hang guard (returns as soon as
the turn finishes) all 5 pass under the same starvation.
---
 tests/gateway/test_compression_failure_session_sync.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/gateway/test_compression_failure_session_sync.py b/tests/gateway/test_compression_failure_session_sync.py
index 5ac9bfa450f..4582af279e1 100644
--- a/tests/gateway/test_compression_failure_session_sync.py
+++ b/tests/gateway/test_compression_failure_session_sync.py
@@ -153,7 +153,9 @@ def _run_compression_failure_turn(runner, source, *, run_generation=None):
                 session_key=SESSION_KEY,
                 run_generation=run_generation,
             ),
-            timeout=2,
+            # Hang guard only: wait_for returns the moment the turn finishes. A quiet run takes ~1.8 s
+            # (first-call imports), so a 2 s deadline failed on CPU-throttled CI runners.
+            timeout=120,
         )
     )
 
