From 6a9bdec69518107b1c4bec6cb46b99ca2ca821a7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 19:23:23 -0800
Subject: [PATCH] [daveey] Keep upstream skill locks fail-closed when process
 cwd is gone

---
 tests/tools/test_deleted_process_cwd.py | 16 ++++++++++++++++
 tools/skill_lock.py                     |  8 +++++++-
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/tests/tools/test_deleted_process_cwd.py b/tests/tools/test_deleted_process_cwd.py
index 560d6582816..7da209e96d5 100644
--- a/tests/tools/test_deleted_process_cwd.py
+++ b/tests/tools/test_deleted_process_cwd.py
@@ -80,6 +80,22 @@ def test_process_cwd_helper_returns_live_cwd(tmp_path):
         os.chdir(original)
 
 
+def test_skill_lock_refuses_unknown_cwd_without_losing_explicit_scope(deleted_cwd, tmp_path, monkeypatch):
+    from tools import skill_lock
+
+    locked = tmp_path / "locked-skill"
+    locked.mkdir()
+    monkeypatch.setattr(skill_lock, "locked_skill_dirs", lambda: [("locked-skill", str(locked))])
+    monkeypatch.setattr(skill_lock, "_record_path", lambda: str(tmp_path / ".usage.json"))
+    refusal = skill_lock.command_refusal("touch SKILL.md", "")
+    assert refusal and "working directory" in refusal
+    refusal = skill_lock.command_refusal("touch SKILL.md", str(locked))
+    assert refusal and "locked by the user" in refusal
+    assert skill_lock.command_refusal("cat SKILL.md", str(locked)) is None
+    monkeypatch.setattr(skill_lock, "locked_skill_dirs", list)
+    assert skill_lock.command_refusal("touch notes.txt", "") is None
+
+
 # --- detection guard -------------------------------------------------------------------------
 
 _REPO = Path(__file__).resolve().parents[2]
diff --git a/tools/skill_lock.py b/tools/skill_lock.py
index c91bea36113..4b9bbcedb3b 100644
--- a/tools/skill_lock.py
+++ b/tools/skill_lock.py
@@ -438,4 +438,10 @@ def command_refusal(command: str, cwd: str) -> str | None:
     locked = locked_skill_dirs()
     if not locked:
         return None
-    return _command_refusal(command, cwd or os.getcwd(), locked, _record_path())
+    from agent.runtime_cwd import process_cwd
+
+    cwd = cwd or process_cwd()
+    if not cwd:
+        # Without a base, relative targets cannot be checked against the user's locks.
+        return "Cannot check skill locks: working directory is unavailable. Supply an explicit workdir."
+    return _command_refusal(command, cwd, locked, _record_path())
-- 
2.55.0

