From 418c075690f7be6ba38b7b5cee5024eb072a2f87 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 05:45:56 -0700
Subject: [PATCH] tests: give the local-recovery rpc helper a hang-bound
 deadline, not a 20s one (deflake typed-alias test) (#295)

---
 tests/gateway/fixtures/local_recovery_probe.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/tests/gateway/fixtures/local_recovery_probe.py b/tests/gateway/fixtures/local_recovery_probe.py
index b77671a7dfc..0b555a78a27 100644
--- a/tests/gateway/fixtures/local_recovery_probe.py
+++ b/tests/gateway/fixtures/local_recovery_probe.py
@@ -71,9 +71,12 @@ def stop_child(proc, timeout=10):
     proc.wait(timeout=10)
 
 
+RPC_DEADLINE = 120  # a hang bound, not a delay: the reply returns at once; a CPU-throttled runner's cold daemon can exceed 20 s
+
+
 async def rpc(ws, method, **params):
     await ws.send(json.dumps({'jsonrpc': '2.0', 'id': method, 'method': method, 'params': params}))
-    async with asyncio.timeout(20):
+    async with asyncio.timeout(RPC_DEADLINE):
         while True:
             reply = json.loads(await ws.recv())
             if reply.get('id') == method:
-- 
2.55.0

