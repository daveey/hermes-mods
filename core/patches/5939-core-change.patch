+import { afterEach, expect, it, vi } from 'vitest'
+
+import { $pluginRecords, setPluginEnabled } from './plugins-store'
+import { discoverRuntimePlugins, refreshChangedDiskPlugins, unloadRuntimePlugin, watchRuntimePlugins } from './runtime-loader'
+import { routeBlobImportsToDataUrls } from './runtime-loader.test-helpers'
+
+const root = '/fixture/desktop-plugins'
+const file = `${root}/owned/plugin.js`
+const state = globalThis as any
+const version = (name: string, prefix = '') => `${prefix}; export default {id:'disk-owned',register(ctx){globalThis.__diskRuns.push('${name}');ctx.onDispose(()=>globalThis.__diskStops.push('${name}'))}} // ${name}`
+let restore = () => {}
+afterEach(() => {
+  unloadRuntimePlugin('disk-owned'); restore(); vi.restoreAllMocks(); vi.useRealTimers(); vi.unstubAllGlobals()
+  delete state.__diskRuns; delete state.__diskStops; delete state.__diskBarrier
+  delete state.__diskEvaluated; delete state.__diskImportEntered
+  delete (window as any).hermesDesktop
+})
+it('actual disk discovery/watch/refresh preserves disabled and superseding owners across pending identity IO', async () => {
+  restore = routeBlobImportsToDataUrls()
+  vi.useFakeTimers({toFake:['setInterval', 'clearInterval']})
+  state.__diskRuns = []; state.__diskStops = []
+  let source = version('initial')
+  let watchEvent: (event: {id: string}) => void = () => {}
+  const readFileText = vi.fn(async () => ({text:source}))
+  const roots = vi.fn(async () => root)
+  let present = true
+  ;(window as any).hermesDesktop = {
+    desktopPluginsRoot: roots,
+    readDir: async (path: string) => ({entries:!present ? [] : path === root ? [{name:'owned', path:`${root}/owned`, isDirectory:true}] : path === `${root}/owned` ? [{name:'plugin.js', path:file, isDirectory:false}] : []}),
+    readFileText,
+    watchPreviewFile: async () => ({id:'owned-watch'}),
+    stopPreviewFileWatch: async () => true,
