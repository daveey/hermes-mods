diff --git a/agent/model_routing_restore.py b/agent/model_routing_restore.py
index fee5d8cf967..bc02dceba23 100644
--- a/agent/model_routing_restore.py
+++ b/agent/model_routing_restore.py
@@ -40,12 +40,18 @@ def stale_session_pin(row):
     return stale_managed_pin(row.get("model"), SessionDB.session_gateway_runtime(row).get("provider"))
 
 
-def restore_route(model, config):
+def restore_route(model, config, policy_config=None):
     """Return (model selector, provider), leaving policy validation to runtime.
 
     Class allocations may fail over; exact pins must retain both tuple members,
     including when the allocation database has been lost. Session metadata is
     intent, not authorization to bypass the current managed policy.
+
+    A row whose ``model`` disagrees with its recorded route resumes on the recorded route: the recorded
+    allocation is the only state that carries an explicit switch (``/model`` replaces it, reason
+    ``explicit-switch``). Replaying the row's tuple as a NEW exact pin collides with the recorded pin and is
+    refused as "Exact pinned route cannot fail over" on every build, so the chat can never reopen. A recorded
+    pin that policy no longer approves is not restored; the allocator keeps refusing it. [daveey]
     """
     if isinstance(config, str):
         try:
@@ -53,13 +59,17 @@ def restore_route(model, config):
         except (ValueError, TypeError):
             return None
     route = config.get("model_routing") if isinstance(config, dict) else None
-    if not isinstance(route, dict) or route.get("selected_model") != model:
+    if not isinstance(route, dict):
         return None
+    if route.get("selected_model") != model:
+        model = route.get("selected_model")  # row and record disagree: the record wins
+        if not isinstance(model, str) or not model:
+            return None
     if route.get("exact_pin"):
         provider = route.get("selected_provider")
         if not isinstance(model, str) or not model or not isinstance(provider, str) or not provider or provider == "auto":
             raise ModelRoutingError("Persisted exact pin lacks a concrete model/provider tuple")
-        return None if stale_managed_pin(model, provider) else (model, provider)
+        return None if stale_managed_pin(model, provider, policy_config) else (model, provider)
     level = route.get("requested_class")
     if level in CLASSES:
         return "class:" + level, "auto"
diff --git a/tests/agent/test_model_routing_row_route_desync.py b/tests/agent/test_model_routing_row_route_desync.py
new file mode 100644
index 00000000000..643651db53e
--- /dev/null
+++ b/tests/agent/test_model_routing_row_route_desync.py
@@ -0,0 +1,82 @@
+"""A stored session row whose model disagrees with its recorded route must still resume. [daveey]
+
+Hub chat 20260101_120000_example: ``sessions.model`` = gpt-6-astra (openai-codex) while ``model_config.model_routing``
+and the allocation row recorded an exact pin on claude-opus-5-5 (anthropic). Resume replayed the row's tuple as a NEW
+exact pin, the allocator saw the recorded pin outside the single-route candidate set and refused with
+"Exact pinned route cannot fail over" on every build.
+"""
+import json
+
+import pytest
+
+from agent.model_routing import ModelRoutingError, resolve_model_route
+from agent.model_routing_managed import pin_policy
+from agent.model_routing_restore import restore_route
+from agent.model_routing_state import RoutingState
+from tests.agent.test_model_routing import policy
+
+
+def _managed(cfg):
+    cfg["model_routing"]["enforce_subscription_only"] = True
+    return cfg
+
+
+def _pin(cfg, model, path, session="s", **kw):
+    level, restricted = pin_policy(model, None, cfg)
+    return resolve_model_route("class:" + level, config=restricted, session_id=session, state_path=path,
+                               exact_pin=True, **kw)
+
+
+def _recorded(cfg, tmp_path, model):
+    path = tmp_path / "routes.db"
+    first = _pin(cfg, model, path)
+    assert first["metadata"]["exact_pin"] is True
+    return path, first["metadata"]
+
+
+def test_repro_row_model_replayed_as_new_pin_is_refused(tmp_path):
+    """Root of the failure: the replayed row tuple collides with the recorded pin."""
+    cfg = _managed(policy())
+    path, _ = _recorded(cfg, tmp_path, "anthropic-deep")
+    with pytest.raises(ModelRoutingError, match="Exact pinned route cannot fail over"):
+        _pin(cfg, "openai-codex-deep", path)
+
+
+def test_resume_restores_the_recorded_pin_when_the_row_disagrees(tmp_path):
+    cfg = _managed(policy())
+    path, recorded = _recorded(cfg, tmp_path, "anthropic-deep")
+    model_config = {"model_routing": recorded, "provider": "openai-codex"}
+    restored = restore_route("openai-codex-deep", model_config, policy_config=cfg)
+    assert restored == ("anthropic-deep", "anthropic")
+    again = _pin(cfg, restored[0], path)
+    assert again["metadata"] == recorded  # no reallocation, no write
+
+
+def test_recorded_class_route_wins_over_a_disagreeing_row(tmp_path):
+    cfg = _managed(policy())
+    first = resolve_model_route("class:deep", config=cfg, session_id="s", state_path=tmp_path / "r.db")
+    model_config = {"model_routing": first["metadata"]}
+    other = next(r["model"] for r in cfg["model_routing"]["routes"]["deep"] if r["model"] != first["model"])
+    assert restore_route(other, json.dumps(model_config), policy_config=cfg) == ("class:deep", "auto")
+
+
+def test_legitimate_pin_rejection_survives_the_repair(tmp_path):
+    """The recorded pin is gone from policy: it still cannot fail over, and a desynced row does not bypass that."""
+    cfg = _managed(policy())
+    path, recorded = _recorded(cfg, tmp_path, "anthropic-deep")
+    cfg["model_routing"]["routes"]["deep"] = [
+        r for r in cfg["model_routing"]["routes"]["deep"] if r["model"] != "anthropic-deep"]
+    model_config = {"model_routing": recorded}
+    # recorded pin is no longer approved -> restore falls back to the row, which the allocator still refuses
+    restored = restore_route("openai-codex-deep", model_config, policy_config=cfg)
+    assert restored is None
+    with pytest.raises(ModelRoutingError, match="Exact pinned route cannot fail over"):
+        _pin(cfg, "openai-codex-deep", path)
+    assert RoutingState(path).peek("s", "deep") == recorded
+
+
+def test_matching_row_is_unchanged(tmp_path):
+    cfg = _managed(policy())
+    _, recorded = _recorded(cfg, tmp_path, "openai-codex-deep")
+    assert restore_route("openai-codex-deep", {"model_routing": recorded}, policy_config=cfg) == (
+        "openai-codex-deep", "openai-codex")
diff --git a/tests/tui_gateway/test_kanban_unloaded_failed_build.py b/tests/tui_gateway/test_kanban_unloaded_failed_build.py
new file mode 100644
index 00000000000..96d99354565
--- /dev/null
+++ b/tests/tui_gateway/test_kanban_unloaded_failed_build.py
@@ -0,0 +1,96 @@
+"""A chat whose agent build failed is still the sweeper's to deliver to. [daveey]
+
+Hub chat 20260101_120000_example: every resume died at agent build ("Exact pinned route cannot fail over"). The failed
+record stayed in ``server._sessions`` with no agent and no notification poller, ``live_session_ids`` counted its
+key as loaded, and the sweeper skipped the chat, so a completed card's FINAL SEND waited with nobody to claim it.
+"""
+
+import contextlib
+import threading
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_notify as kbn
+from hermes_state import SessionDB
+from tui_gateway import kanban_unloaded as ku
+from tui_gateway import server
+
+CHAT = "20260101_120000_example"
+LATER = time.time() + 3600
+FINAL = ("Example project update: PR passed review. " + "Full detail sentence. " * 30).strip()
+
+
+@pytest.fixture
+def db(tmp_path):
+    d = SessionDB(tmp_path / "state.db")
+    d.create_session(CHAT, "desktop")
+    d.append_message(CHAT, "user", "go")
+    d.append_message(CHAT, "assistant", "ok")
+    return d
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch):
+    monkeypatch.delenv("HERMES_KANBAN_UNLOADED_WAKE", raising=False)
+    ku._reset_wake_budget_for_tests()
+    yield
+    ku._reset_wake_budget_for_tests()
+    with server._sessions_lock:
+        server._sessions.pop("deadbuild", None)
+
+
+def _record(*, error, agent=None, ready=True):
+    event = threading.Event()
+    if ready:
+        event.set()
+    return {"agent": agent, "agent_error": error, "agent_ready": event, "session_key": CHAT}
+
+
+def _opener(db):
+    @contextlib.contextmanager
+    def opener(chat_id):
+        yield (db, db.get_compression_tip(chat_id) or chat_id) if db.get_session(chat_id) else (None, None)
+    return opener
+
+
+def _final_send_card():
+    conn = kbc.connect()
+    try:
+        tid = kb.create_task(conn, title="relay", assignee="worker")
+        kbn.add_notify_sub(conn, task_id=tid, platform="tui", chat_id=CHAT)
+        kb.claim_task(conn, tid)
+        kb.complete_task(conn, tid, summary=f"done\nFINAL SEND for @session:default/{CHAT}: {FINAL}")
+        return tid
+    finally:
+        conn.close()
+
+
+def test_failed_build_record_does_not_count_as_loaded():
+    with server._sessions_lock:
+        server._sessions["deadbuild"] = _record(error="ModelRoutingError: Exact pinned route cannot fail over")
+    assert CHAT not in ku.live_session_ids()
+
+
+@pytest.mark.parametrize("record", [
+    _record(error=None, agent=object()),                                   # built agent
+    _record(error=None, ready=False),                                      # build still running
+    _record(error="late failure", agent=object()),                         # has an agent: its poller owns it
+], ids=["built", "building", "agent-present"])
+def test_other_records_still_count_as_loaded(record):
+    with server._sessions_lock:
+        server._sessions["deadbuild"] = record
+    assert CHAT in ku.live_session_ids()
+
+
+def test_final_send_is_delivered_in_full_without_a_model(db):
+    with server._sessions_lock:
+        server._sessions["deadbuild"] = _record(error="ModelRoutingError: Exact pinned route cannot fail over")
+    _final_send_card()
+    done = ku.sweep_once(ku.live_session_ids(), now=LATER, session_db=_opener(db), spawn=lambda job: job())
+    assert len(done) == 1
+    rows = [m for m in db.get_messages(CHAT) if m.get("display_kind") == "kanban_notice"]
+    assert len(rows) == 1
+    assert FINAL in (rows[0]["content"] or "")  # complete, not truncated
diff --git a/tui_gateway/kanban_unloaded.py b/tui_gateway/kanban_unloaded.py
index 12987679dad..4720c09e746 100644
--- a/tui_gateway/kanban_unloaded.py
+++ b/tui_gateway/kanban_unloaded.py
@@ -132,12 +132,24 @@ def _board_slugs(_kb) -> list[str]:
     return list(unique.values())
 
 
+def build_failed(session: Any) -> bool:
+    """A record whose deferred agent build failed holds no agent and starts no notification poller
+    (``_wire_session_agent`` never ran), so it can neither claim nor wake anything. Counting its key as loaded
+    made the sweeper skip the chat for as long as the record lingered: hub chat 20260101_120000_example sat on a
+    completed card's FINAL SEND after "Exact pinned route cannot fail over". The sweeper owns such a chat: its
+    wake reports ``error`` and the full notice is written as a passive row, with no model call. [daveey]"""
+    return (isinstance(session, dict) and session.get("agent") is None and bool(session.get("agent_error"))
+            and session.get("agent_ready") is not None and session["agent_ready"].is_set())
+
+
 def live_session_ids() -> set[str]:
-    """Every id this process holds in memory: live sid, agent session_id, session_key."""
+    """Every id this process holds in memory: live sid, agent session_id, session_key (a failed build holds none)."""
     from tui_gateway import server
     ids: set[str] = set()
     with server._sessions_lock:
         for sid, session in server._sessions.items():
+            if build_failed(session):
+                continue
             cands = [sid]
             if isinstance(session, dict):
                 cands += [getattr(session.get("agent"), "session_id", None), session.get("session_key")]
