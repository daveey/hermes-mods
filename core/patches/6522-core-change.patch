Subject: [PATCH 6522] Forward retry identity

Public mirror of source commit 4813ba583c36e823f4bdf75ee6d42845f447a3a6.

---
diff --git a/tests/hermes_cli/test_kanban_forward_retry_boundary.py b/tests/hermes_cli/test_kanban_forward_retry_boundary.py
index 66620cbc7dc..0be25779d3b 100644
--- a/tests/hermes_cli/test_kanban_forward_retry_boundary.py
+++ b/tests/hermes_cli/test_kanban_forward_retry_boundary.py
@@ -71,3 +71,33 @@
     assert kp._forward_binding_retry("original", {"idempotency_key": "product-key"}, "hub", "default", "s1", CREATOR, "run-2")
     assert not kp._forward_binding_retry("original", {"idempotency_key": "product-key"}, "hub", "default", "s1", CREATOR, "run-1")
     assert path.read_bytes() == before
+
+
+@pytest.mark.parametrize("case", ["sql-null", "json-null", "json-list", "missing-args", "list-args", "string-create"])
+def test_malformed_history_retains_original_transport_and_refusal(monkeypatch, case):
+    result, body = _history()
+    if case == "missing-args":
+        body.pop("args")
+    elif case == "list-args":
+        body["args"] = []
+    elif case == "string-create":
+        body["args"]["create"] = "invalid"
+    raw_result = {"sql-null": None, "json-null": "null", "json-list": "[]"}.get(case, json.dumps(result))
+    monkeypatch.setattr(kp, "_sent_row", lambda rid: ("rejected", raw_result, json.dumps(body)))
+    options = {"idempotency_key": "product-key"}
+    assert not kp._forward_binding_retry("original", options, "hub", "default", "s1", CREATOR, "run-2")
+    monkeypatch.setattr(kp, "hub_carries_options", lambda cli: True)
+    monkeypatch.setattr(kp, "remote_state", lambda rid: "rejected")
+    expected = kp.request_id("w", options, "s1", options)
+    sent = []
+
+    def refuse(argv):
+        sent.append(argv[argv.index("--id") + 1])
+        return 2, "", "request_id_conflict: unchanged immutable refusal"
+
+    monkeypatch.setattr(kp, "hub_runner", refuse)
+    out = kp.create_remote(options, target="hub", self_gw="w", origin_session="s1", origin_profile="default",
+                           cfg={}, origin_gateway="hub", creator=CREATOR, run_uid="run-2")
+    assert sent == [expected]
+    assert out == {"ok": False, "request_id": expected, "rc": 2, "fatal": True,
+                   "error": "request_id_conflict: unchanged immutable refusal"}
diff --git a/tests/hermes_cli/test_kanban_placement_identity.py b/tests/hermes_cli/test_kanban_placement_identity.py
index c916539d794..86d785ca362 100644
--- a/tests/hermes_cli/test_kanban_placement_identity.py
+++ b/tests/hermes_cli/test_kanban_placement_identity.py
@@ -187,10 +187,10 @@
         states.get(rid), json.dumps({"status": "rejected", "code": "origin_forward_binding_missing", "handoff_complete": False}),
         json.dumps({"coll": "sessions", "action": "origin-forward", "args": {
             "origin": {"gateway": "hub", "profile": "default", "session": "s1"},
-            "creator": creator, "run_uid": stored[rid][0], "create": {"idempotency_key": "product-key"}}})))
+            "creator": creator, "run_uid": stored[rid][0], "create": {"idempotency_key": json.loads(stored[rid][1][0].split("=", 1)[1])}}})))
     creator = {"gateway": "w", "profile": "default", "board": "default", "task_id": "t_0123456789abcdef"}
-    call = lambda run: kp.create_remote(
-        {"title": "B3a", "idempotency_key": "product-key"}, target="hub", self_gw="w", origin_session="s1",
+    call = lambda run, key="product-key": kp.create_remote(
+        {"title": "B3a", "idempotency_key": key}, target="hub", self_gw="w", origin_session="s1",
         origin_profile="default", cfg={}, origin_gateway="hub", creator=creator, run_uid=run)
     first = call("run-1")
     assert first["ok"]
@@ -198,9 +198,19 @@
     states[first["request_id"]] = "rejected"
     second = call("run-2")
     assert second["ok"] and second["request_id"] != first["request_id"]
+    assert second["retry"] is False  # the rotated transport has not been sent before
+    states[second["request_id"]] = "sent"
+    assert call("run-2")["retry"] is True
     assert call("run-2")["request_id"] == second["request_id"]  # exact retries in that run stay stable
     third = call("run-3")
     assert third["ok"] and third["request_id"] not in (first["request_id"], second["request_id"])
     assert call("run-3")["request_id"] == third["request_id"]
     for retry in (second, third):
         assert ["idempotency_key=" + json.dumps("product-key")] == stored[retry["request_id"]][1]
+    other_first = call("run-1", "other-product-key")
+    assert other_first["ok"]
+    states[other_first["request_id"]] = "rejected"
+    other_second = call("run-2", "other-product-key")
+    assert other_second["ok"] and other_second["retry"] is False
+    assert len({first["request_id"], second["request_id"], other_first["request_id"], other_second["request_id"]}) == 4
+    assert stored[other_second["request_id"]][1] == ['idempotency_key="other-product-key"']
