diff --git a/tests/tui_gateway/test_session_projection_revision.py b/tests/tui_gateway/test_session_projection_revision.py
new file mode 100644
index 00000000000..4ef3947c2df
--- /dev/null
+++ b/tests/tui_gateway/test_session_projection_revision.py
@@ -0,0 +1,209 @@
+"""Real SQLite writers must invalidate projections without reading session history."""
+import sqlite3
+
+import pytest
+
+import hermes_state
+from hermes_state import SessionDB
+from tui_gateway import server
+
+
+@pytest.fixture
+def store(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path / "kanban"))
+    path = tmp_path / "state.db"
+    db = SessionDB(path)
+    db.create_session("s", source="cli")
+    server._sessions_db_sig_cache.clear()
+    server._sessions_digest_at.clear()
+    yield path, db
+    db.close()
+
+
+def test_settled_unchanged_tick_opens_no_database(store, monkeypatch):
+    import os
+
+    path, _db = store
+    # A settled timestamp is safe to reuse; recent writes retain the racy guard.
+    for candidate in (path, path.with_name(path.name + "-wal")):
+        if candidate.exists():
+            os.utime(candidate, ns=(1_000_000_000, 1_000_000_000))
+    before = server._session_db_content_sig(path)
+    connect = hermes_state._connect_tracked_db
+    calls = []
+
+    def observed(*args, **kwargs):
+        calls.append(args)
+        return connect(*args, **kwargs)
+
+    monkeypatch.setattr(hermes_state, "_connect_tracked_db", observed)
+    assert server._session_db_content_sig(path) == before
+    assert calls == []
+    with sqlite3.connect(path) as writer:
+        writer.execute("UPDATE sessions SET title='next tick'")
+    assert server._session_db_content_sig(path) != before
+    assert calls
+
+
+def test_projection_reads_are_bounded_after_unrelated_commits(store, monkeypatch):
+    path, _db = store
+    statements = []
+    connect = hermes_state._connect_tracked_db
+
+    def traced(*args, **kwargs):
+        conn = connect(*args, **kwargs)
+        conn.set_trace_callback(statements.append)
+        return conn
+
+    monkeypatch.setattr(hermes_state, "_connect_tracked_db", traced)
+    monkeypatch.setattr(server, "SESSION_DIGEST_MIN_S", 0)
+    before = server._session_db_content_sig(path)
+    with sqlite3.connect(path) as writer:
+        writer.execute("INSERT INTO state_meta(key, value) VALUES ('unrelated', '1')")
+    assert server._session_db_content_sig(path) == before
+    assert server._session_db_content_sig(path) == before
+    assert not [s for s in statements if "FROM SESSIONS" in s.upper()]
+
+
+@pytest.mark.parametrize("field", server._SESSION_SIGNATURE_FIELDS)
+def test_every_projection_field_invalidates_on_next_tick(store, field):
+    path, _db = store
+    before = server._session_db_content_sig(path)
+    # Raw sqlite connection models a writer from a release predating the counter.
+    with sqlite3.connect(path) as writer:
+        value = writer.execute(f'SELECT "{field}" FROM sessions WHERE id = ?', ('s',)).fetchone()[0]
+        new = value + 1 if isinstance(value, (int, float)) else "changed"
+        writer.execute(f'UPDATE sessions SET "{field}" = ? WHERE id = ?', (new, 's'))
+    assert server._session_db_content_sig(path) != before
+
+
+def test_insert_delete_and_rollback(store):
+    path, _db = store
+    before = server._session_db_content_sig(path)
+    with sqlite3.connect(path) as writer:
+        writer.execute("INSERT INTO sessions(id, source, started_at) VALUES ('new', 'cli', 1)")
+    inserted = server._session_db_content_sig(path)
+    assert inserted != before
+    with sqlite3.connect(path) as writer:
+        writer.execute("DELETE FROM sessions WHERE id = 'new'")
+    deleted = server._session_db_content_sig(path)
+    assert deleted != inserted
+    with sqlite3.connect(path) as writer:
+        writer.execute("UPDATE sessions SET title = 'rollback' WHERE id = 's'")
+        assert server._session_db_content_sig(path) == deleted
+        writer.rollback()
+    assert server._session_db_content_sig(path) == deleted
+
+
+def test_heartbeat_and_equal_updates_do_not_write_counter(store):
+    path, _db = store
+    with sqlite3.connect(path) as writer:
+        before = writer.execute("SELECT value FROM state_meta WHERE key='sessions_change_seq'").fetchone()
+        assert before is not None
+        changes = writer.total_changes
+        writer.execute("UPDATE sessions SET last_activity_at=123, last_activity_description='busy'")
+        writer.execute("UPDATE sessions SET title=title, archived=archived")
+        assert writer.total_changes - changes == 2
+        assert writer.execute("SELECT value FROM state_meta WHERE key='sessions_change_seq'").fetchone() == before
+
+
+def test_first_install_zero_and_settled_open_are_read_only(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path / "kanban"))
+    path = tmp_path / "state.db"
+    db = SessionDB(path)
+    db.close()
+    with sqlite3.connect(path) as observer:
+        assert observer.execute("SELECT value FROM state_meta WHERE key='sessions_change_seq'").fetchone() is None
+        schema_before = observer.execute("PRAGMA schema_version").fetchone()
+        before = server._session_db_content_sig(path)
+        assert before[0] == "revision"
+        assert before[-1] == 0
+        reopened = SessionDB(path)
+        reopened.close()
+        assert observer.execute("PRAGMA schema_version").fetchone() == schema_before
+        assert server._session_db_content_sig(path) == before
+        observer.execute("INSERT INTO sessions(id, source, started_at) VALUES ('first', 'cli', 1)")
+    assert server._session_db_content_sig(path) != before
+
+
+def test_replacement_with_equal_counter_is_not_cached(store, tmp_path):
+    path, _db = store
+    before = server._session_db_content_sig(path)
+    replacement = tmp_path / "replacement.db"
+    other = SessionDB(replacement)
+    other.create_session("different", source="cli")
+    other.close()
+    # Force the same generation to exercise the independent inode fence.
+    from contextlib import closing
+
+    # A connection context commits but does not close. Close/checkpoint the source
+    # before moving its main file, otherwise the generation remains in its WAL.
+    with closing(sqlite3.connect(replacement)) as writer:
+        writer.execute("UPDATE state_meta SET value=? WHERE key='sessions_change_seq'", (before[-1],))
+        writer.commit()
+        writer.execute("PRAGMA wal_checkpoint(TRUNCATE)")
+    _db.close()
+    replacement.replace(path)
+    after = server._session_db_content_sig(path)
+    assert after != before
+    assert after[-1] == before[-1]
+
+
+def test_in_place_restore_of_equal_count_store_invalidates(store, tmp_path):
+    path, db = store
+    other_path = tmp_path / "other.db"
+    other = SessionDB(other_path)
+    other.create_session("different", source="cli")
+    other.close()
+    db.close()
+    before = server._session_db_content_sig(path)
+    inode = path.stat().st_ino
+    with sqlite3.connect(other_path) as source, sqlite3.connect(path) as target:
+        source.backup(target)
+    assert path.stat().st_ino == inode
+    assert server._session_db_content_sig(path) != before
+
+
+def test_failed_read_retries_without_throttle(store, monkeypatch):
+    path, _db = store
+    before = server._session_db_content_sig(path)
+    with sqlite3.connect(path) as writer:
+        writer.execute("UPDATE sessions SET title='after failure'")
+    connect = hermes_state._connect_tracked_db
+
+    def locked(*args, **kwargs):
+        raise sqlite3.OperationalError("database is locked")
+
+    monkeypatch.setattr(hermes_state, "_connect_tracked_db", locked)
+    assert server._session_db_content_sig(path) == before
+    monkeypatch.setattr(hermes_state, "_connect_tracked_db", connect)
+    assert server._session_db_content_sig(path) != before
+
+
+def test_upgrade_populated_store_without_counter(store):
+    from hermes_state_projection import SESSION_PROJECTION_TRIGGERS
+
+    path, _db = store
+    _db.close()
+    with sqlite3.connect(path) as writer:
+        for name in SESSION_PROJECTION_TRIGGERS:
+            writer.execute(f"DROP TRIGGER {name}")
+        writer.execute("DELETE FROM state_meta WHERE key='sessions_change_seq'")
+    upgraded = SessionDB(path)
+    upgraded.close()
+    before = server._session_db_content_sig(path)
+    assert before[0] == "revision"
+    assert before[-1] == 0
+    with sqlite3.connect(path) as writer:
+        assert writer.execute("SELECT id FROM sessions").fetchall() == [('s',)]
+        writer.execute("UPDATE sessions SET title='upgraded'")
+    assert server._session_db_content_sig(path) != before
+
+
+def test_missing_trigger_falls_back_to_content(store):
+    path, _db = store
+    server._session_db_content_sig(path)
+    with sqlite3.connect(path) as writer:
+        writer.execute("DROP TRIGGER sessions_projection_update")
+    fallback = server._session_db_content_sig(path)
+    assert fallback[0] == server._SESSION_SIGNATURE_FIELDS
diff --git a/tui_gateway/change_watcher.py b/tui_gateway/change_watcher.py
index 26f85313050..7a0f777e51c 100644
--- a/tui_gateway/change_watcher.py
+++ b/tui_gateway/change_watcher.py
@@ -190,12 +190,7 @@ def _pet_changed_payload() -> dict:
 # last_activity_at / _description are left out on purpose: the session activity heartbeat restamps
 # them mid-turn and on idle ticks, so hashing them re-fired sessions.changed every heartbeat window
 # (#98005). Liveness comes from session.active_list, and a real turn still moves message_count.
-_SESSION_SIGNATURE_FIELDS = (
-    "id", "source", "session_key", "display_name", "model", "parent_session_id",
-    "started_at", "ended_at", "end_reason", "message_count", "tool_call_count",
-    "cwd", "git_branch", "git_repo_root", "title", "title_source", "profile_name",
-    "archived", "pinned", "hidden", "last_read_at", "handoff_state",
-)
+from hermes_state_projection import SESSION_SIGNATURE_FIELDS as _SESSION_SIGNATURE_FIELDS
 # path -> (database/WAL mtime, session-table digest). The mtime guard keeps the
 # normal 0.5 s watch pass stat-only; SQLite is read only after another process
 # actually commits (and for ``utils.RACY_MTIME_WINDOW_NS`` after it, see _settled_mtime).
@@ -205,25 +200,37 @@ _sessions_db_sig_cache: dict[str, tuple[object, tuple | None]] = {}
 # the cached mtime stays stale in between, so the change is still seen on the trailing edge.
 SESSION_DIGEST_MIN_S = 3.0
 _sessions_digest_at: dict[str, float] = {}
+_sessions_db_identity: dict[str, tuple[int, int]] = {}
 
 
 def _session_db_content_sig(db_path: Path):
-    """Digest list/transcript-relevant session rows, excluding unrelated tables.
+    """Read the transactional projection revision, or digest a legacy store.
 
-    ``gateway_heartbeats`` shares state.db and writes every minute. Using the
-    database mtime directly therefore emits sessions.changed while no session
-    changed (#98005). Cache behind the DB/WAL mtime, then inspect only the
-    sessions columns that drive Desktop projections. Legacy stores safely use
-    the subset of columns they have.
+    Upgraded stores use bounded schema/meta probes after writes, independent of
+    the legacy digest throttle. Settled unchanged files need no query. The file
+    identity distinguishes replacements whose counters happen to be equal.
+    Stores without the complete trigger capability retain the content fallback.
     """
     mtime = _newest_mtime_ns((db_path, db_path.with_name(f"{db_path.name}-wal")))
     cache_key = str(db_path)
     cached = _sessions_db_sig_cache.get(cache_key)
+    try:
+        stat = db_path.stat()
+        identity = (stat.st_dev, stat.st_ino)
+    except OSError:
+        _sessions_db_sig_cache.pop(cache_key, None)
+        return None
+    previous_identity = _sessions_db_identity.get(cache_key)
+    if previous_identity != identity:
+        cached = None
+        _sessions_db_sig_cache.pop(cache_key, None)
+    _sessions_db_identity[cache_key] = identity
+    revision_cached = cached is not None and cached[1] is not None and cached[1][0] == "revision"
 
     if cached is not None and cached[0] == mtime:
         return cached[1]
     now = time.monotonic()
-    if (cached is not None and cached[1] is not None
+    if (not revision_cached and cached is not None and cached[1] is not None
             and now - _sessions_digest_at.get(cache_key, -SESSION_DIGEST_MIN_S) < SESSION_DIGEST_MIN_S):
         return cached[1]
     if not db_path.exists():
@@ -239,6 +246,13 @@ def _session_db_content_sig(db_path: Path):
 
         conn = _connect_tracked_db(read_only_db_uri(db_path), tracking_path=db_path,
                                    uri=True, timeout=0.05)
+        from hermes_state_projection import session_projection_revision
+        conn.execute("BEGIN")
+        revision = session_projection_revision(conn)
+        if revision is not None:
+            signature = ("revision", identity, revision)
+            _sessions_db_sig_cache[cache_key] = (_settled_mtime(mtime), signature)
+            return signature
         available = {row[1] for row in conn.execute("PRAGMA table_info(sessions)")}
         fields = tuple(field for field in _SESSION_SIGNATURE_FIELDS if field in available)
         if not fields:
