From 542617f0f0598407f8c7aee1719b30d993f9353c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 08:29:28 +0000
Subject: [PATCH] [daveey] kanban capacity: pin four advisory invariants
 surviving mutation (spawn receipt, telemetry gap, 180s source bound, describe
 wording)

---
 .../hermes_cli/test_kanban_capacity_evidence.py  | 16 ++++++++++++++++
 tests/hermes_cli/test_kanban_capacity_metrics.py | 16 ++++++++++++++++
 2 files changed, 32 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_capacity_evidence.py b/tests/hermes_cli/test_kanban_capacity_evidence.py
index f86964d9cb..d86465bb08 100644
--- a/tests/hermes_cli/test_kanban_capacity_evidence.py
+++ b/tests/hermes_cli/test_kanban_capacity_evidence.py
@@ -272,3 +272,19 @@ def test_read_never_invents_generation_from_an_event_or_poll(board):
     assert "generation" not in observation["identity"]
     assert "run_id" not in observation["identity"]
     assert observation["state"] == "unknown"
+
+
+def test_recorded_source_validity_is_the_sidebar_bound_not_longer(board):
+    tid = kb.create_task(board, title="one", assignee="alice")
+    evidence.record(board, dispatch.DispatchResult(), board="default", machine="m", now=1000)
+    out = evidence.read(board, kb.get_task(board, tid), board="default", now=1001)
+    assert out["valid_until_ms"] - out["observed_at_ms"] == 180_000
+    assert out["execution_observation"]["valid_until"] == 1180
+
+
+def test_describe_without_observed_restrictions_never_asserts_availability(board):
+    tid = kb.create_task(board, title="one", assignee="alice")
+    evidence.record(board, dispatch.DispatchResult(), board="default", machine="m", now=1000)
+    text = evidence.describe(evidence.read(board, kb.get_task(board, tid), board="default", now=1001))
+    assert text == "current: restriction coverage incomplete; admissible capacity unknown"
+    assert "no restriction" not in text
diff --git a/tests/hermes_cli/test_kanban_capacity_metrics.py b/tests/hermes_cli/test_kanban_capacity_metrics.py
index 723b56ab4e..efcf045e3b 100644
--- a/tests/hermes_cli/test_kanban_capacity_metrics.py
+++ b/tests/hermes_cli/test_kanban_capacity_metrics.py
@@ -168,3 +168,19 @@ def test_conflicting_shared_slot_readings_are_unknown():
     result = idle_coverage([interval(), interval("two", admissible_slots=4)])
     assert result["unknown_seconds"] == 10
     assert result["unexplained_idle_slot_seconds"] == 0
+
+
+def test_submitter_spawn_receipt_is_never_process_start_even_with_binding_fields():
+    events = [event(1, "promoted", 10), event(2, "claimed", 12, 7, lock="host:1"),
+              event(3, "spawned", 13, 7, pid=111, claim_lock="host:1", started_at="birth|1")]
+    out = attempts(events, board="one", task_id="t", now=20)[0]
+    assert out["process_start_at"] is None and out["process_pid"] is None
+    assert out["claim_to_process_start_s"] is None and out["censored"] is True
+
+
+def test_telemetry_gap_between_observations_is_unknown_not_dropped():
+    result = idle_coverage([interval(start=10, end=20),
+                            interval(start=30, end=40, observed_at=30, valid_until=40)])
+    assert result["unknown_seconds"] == 10
+    assert result["observed_seconds"] == 20
+    assert result["unexplained_idle_slot_seconds"] == 40
-- 
2.43.0

