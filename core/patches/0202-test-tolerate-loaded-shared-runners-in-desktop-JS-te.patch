From def4a662e1779e05623fe6e2e4cc8f172471dd30 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 01:08:56 +0000
Subject: [PATCH] test: tolerate loaded shared runners in desktop JS tests
 (#14)

* test: tolerate loaded shared runners in desktop JS tests (git probe, PM source backend, checkout handoff)

Hub runners share 16 cores across concurrent jobs (load avg 40-90), so
process-spawning tests that pass on idle hosts time out:
- tests-js: vitest 5s default -> 30s
- source-backend: PM backend port wait 45s -> 150s, test budget 400s
- checkout-source: handoff claim timeout 2s -> 20s, test budget 120s, assertion prints the refusal

* test(desktop): checkout-source spawn mock stamps the Desktop's HERMES_UPDATE_STARTED_AT

The protocol-1 claim only counts when marker startedAt === updateStartedAt.
The mock re-read Date.now() at spawn time, so an event-loop stall across a
second boundary on a loaded runner made the claim never match (ok:false,
updater-spawn-failed). Write the startedAt the Desktop passes, as
posix.sh/marker.sh do. The earlier 2s->20s handoffClaimTimeoutMs bump is not
the fix (the claim check is deterministic); it is kept only to match
production HANDOFF_CLAIM_TIMEOUT_MS.
---
diff --git a/apps/desktop/electron/source-backend.test.ts b/apps/desktop/electron/source-backend.test.ts
index b352279fe15b1f0e2087ef68716f924d89c04ce0..5c5ccb072c9c832f76d0c022140dc1985a8738fb 100644
--- a/apps/desktop/electron/source-backend.test.ts
+++ b/apps/desktop/electron/source-backend.test.ts
@@ -103,7 +103,7 @@ test.skipIf(process.platform === 'win32')(
           cwd: temp,
           env,
           encoding: 'utf8',
-          timeout: 90_000
+          timeout: 180_000
         })
       ) as Fixture
 
@@ -159,7 +159,7 @@ test.skipIf(process.platform === 'win32')(
         })
 
         try {
-          const port: number = (await waitForDashboardPort(child, 45_000)) as number
+          const port: number = (await waitForDashboardPort(child, 150_000)) as number
 
           const response: Response = await fetch(`http://127.0.0.1:${port}/api/health`, {
             headers: { 'X-Hermes-Session-Token': token }
@@ -208,7 +208,9 @@ test.skipIf(process.platform === 'win32')(
       vi.unstubAllEnvs()
     }
   },
-  150_000
+  // Two cold Python backend starts; on a loaded shared runner each can take
+  // minutes of wall time.
+  400_000
 )
 
 test('Windows console selection uses only the selected interpreter directory', (): void => {
diff --git a/tests-js/vitest.config.ts b/tests-js/vitest.config.ts
index ffc666f654ef9c552dc83860e848b4ffafdc134a..a794f19a0b694c2359f328a5e78009197f16a633 100644
--- a/tests-js/vitest.config.ts
+++ b/tests-js/vitest.config.ts
@@ -4,5 +4,8 @@ export default defineConfig({
   test: {
     environment: 'node',
     include: ['**/*.test.ts', '**/*.test.mjs'],
+    // Several files shell out to real git/python/npm. vitest's 5s default
+    // times them out on a loaded shared runner; match the electron project.
+    testTimeout: 30_000,
   },
 })
