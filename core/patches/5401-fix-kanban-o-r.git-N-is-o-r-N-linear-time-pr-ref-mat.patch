From e57923b39b49c9a4d394d1a53ac504112c1d9827 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 06:06:40 +0000
Subject: [PATCH] fix(kanban): o/r.git#N is o/r#N; linear-time pr ref match
 (review of #3890)

A trailing .git on a ref repo is dropped, so o/r.git#N and the .git URL form are the same PR as o/r#N (the duplicate-admitting direction). \bpr\s*(?:#\s*)? replaces \bpr\s*#?\s*, whose adjacent \s* backtracked quadratically on pr + many spaces (pre-existing on main). Tests fail before, pass after.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/kanban_overlap.py                     |  8 +++++---
 tests/tools/test_kanban_create_overlap_pr_ids.py | 14 ++++++++++++++
 2 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_overlap.py b/hermes_cli/kanban_overlap.py
index 125a4804e5..1aa228f734 100644
--- a/hermes_cli/kanban_overlap.py
+++ b/hermes_cli/kanban_overlap.py
@@ -246,11 +246,12 @@ def cites(card_id: str, title: str, body: str) -> bool:
 # named no PR and every retro for another PR collided with any open one: the backstop stalled until an example state
 # PR #3876 worked around it. A ref is now (repo, N): ``owner/repo#N`` and a github.com ``.../owner/repo/pull/N`` URL
 # carry their repo (lowercased); ``#N``, ``PR N``, ``PRN``, ``PR #N`` and ``pull/N`` carry none and match any repo.
-# ``##N``, ``word#N`` and ``a/b/c#N`` stay non-refs; N is 2-6 digits.
+# ``##N``, ``word#N`` and ``a/b/c#N`` stay non-refs; N is 2-6 digits. A trailing ``.git`` on the repo is dropped.
+# ``\bpr\s*(?:#\s*)?`` (not ``\s*#?\s*``): two adjacent ``\s*`` backtracked quadratically on "pr" + many spaces.
 _PR_REF = re.compile(
     r"(?<![\w./#-])(?P<repo>[a-z0-9][a-z0-9-]{0,38}/[a-z0-9_.-]+)#(?P<rn>\d{2,6})(?!\d)"
     r"|github\.com/(?P<url>[a-z0-9][a-z0-9-]{0,38}/[a-z0-9_.-]+)/pull/(?P<un>\d{2,6})(?!\d)"
-    r"|(?:(?<![\w#])#|\bpr\s*#?\s*|\bpull/)(?P<n>\d{2,6})(?!\d)",
+    r"|(?:(?<![\w#])#|\bpr\s*(?:#\s*)?|\bpull/)(?P<n>\d{2,6})(?!\d)",
     re.IGNORECASE)
 
 PrRef = tuple[Optional[str], int]  # (lowercased "owner/repo" or None when the title does not say, PR number)
@@ -262,7 +263,8 @@ def pr_refs(title: str) -> frozenset[PrRef]:
     refs = set()
     for m in _PR_REF.finditer(title or ""):
         repo = m.group("repo") or m.group("url")
-        refs.add((repo.lower() if repo else None, int(m.group("rn") or m.group("un") or m.group("n"))))
+        repo = repo.lower().removesuffix(".git") if repo else None  # o/r.git#N is o/r#N (same PR, never "different")
+        refs.add((repo, int(m.group("rn") or m.group("un") or m.group("n"))))
     return frozenset(refs)
 
 
diff --git a/tests/tools/test_kanban_create_overlap_pr_ids.py b/tests/tools/test_kanban_create_overlap_pr_ids.py
index d9b1ab2d9e..309ade9bbe 100644
--- a/tests/tools/test_kanban_create_overlap_pr_ids.py
+++ b/tests/tools/test_kanban_create_overlap_pr_ids.py
@@ -143,3 +143,17 @@ def test_pr_refs_carry_the_repo():
 def test_not_pr_refs(title):
     assert ko.pr_refs(title) == frozenset()
     assert ko.pr_numbers(title) == frozenset()
+
+
+def test_dot_git_repo_is_the_same_pr():
+    assert not ko._different_prs("Retro review a/b.git#55 merged", "Retro review a/b#55 merged")
+    assert not ko._different_prs("see https://github.com/a/b.git/pull/55", "Retro review a/b#55 merged")
+    assert ko.pr_refs("a/b.git#55") == {("a/b", 55)}
+
+
+def test_pr_followed_by_many_spaces_is_linear():
+    import time
+    start = time.monotonic()
+    assert ko.pr_refs("pr" + " " * 20000 + "x") == frozenset()
+    assert time.monotonic() - start < 0.5
+    assert ko.pr_refs("PR #55") == {(None, 55)} and ko.pr_refs("pr # 55") == {(None, 55)}
