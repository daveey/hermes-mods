diff --git a/hermes_cli/kanban_db_schedule.py b/hermes_cli/kanban_db_schedule.py
new file mode 100644
index 0000000000..7f1dddb58f
--- /dev/null
+++ b/hermes_cli/kanban_db_schedule.py
@@ -0,0 +1,50 @@
+"""``schedule_task``: park a card in ``scheduled`` (split out of ``kanban_db``). [daveey]
+
+Late-bound via ``_kb`` (import-cycle breaking) so monkeypatching ``kanban_db`` helpers in
+tests still reaches this code. Re-exported from ``kanban_db``.
+"""
+from __future__ import annotations
+
+import sqlite3
+from typing import Any, Optional
+
+from hermes_cli import kanban_db as _kb
+
+
+def schedule_task(
+    conn: sqlite3.Connection, task_id: str, *, reason: Optional[str] = None,
+    expected_run_id: Optional[int] = None, wake_check: Optional[str] = None,
+    check_every: Optional[int] = None, clock_only: bool = False,
+) -> bool:
+    """Park in ``scheduled`` (waiting on time, not a human; not dispatchable) until its wake
+    (``SCHEDULED_UNTIL=`` in the reason, else ``kanban_timed_park.DEFAULT_WAKE_SECONDS``) or an
+    ``unblock_task``. Refused (False) while the card waits on a human answer: ``scheduled`` is
+    not on any needs-me surface, so such a park hid the ask (t_6feb6afd). [daveey]"""
+    with _kb.write_txn(conn):
+        if _kb._awaiting_human_answer(conn, task_id):
+            return False
+        params: list[Any] = [task_id]
+        sql = """
+            UPDATE tasks
+               SET status       = 'scheduled',
+                   claim_lock   = NULL,
+                   claim_expires= NULL,
+                   worker_pid   = NULL
+             WHERE id = ?
+               AND status IN ('todo', 'ready', 'running', 'blocked')
+        """
+        if expected_run_id is not None:
+            sql += " AND current_run_id = ?"
+            params.append(int(expected_run_id))
+        if conn.execute(sql, params).rowcount != 1:
+            return False
+        run_id = _kb._end_or_synthesize_run(
+            conn, task_id, outcome="scheduled", status="scheduled", summary=reason, synthesize=bool(reason),
+        )
+        from hermes_cli.kanban_timed_park import scheduled_payload  # SCHEDULED_UNTIL= wakes it [daveey]
+        from hermes_cli import kanban_wake_check as kwc  # condition wake [daveey]
+        _kb._append_event(conn, task_id, "scheduled", {
+            **scheduled_payload(reason), **kwc.park_fields(wake_check, check_every, clock_only),
+        }, run_id=run_id)
+        kwc.set_check(conn, task_id, wake_check, check_every)
+        return True
diff --git a/hermes_cli/kanban_diagnostics.py b/hermes_cli/kanban_diagnostics.py
index dd0500d9c2..4774bbdd39 100644
--- a/hermes_cli/kanban_diagnostics.py
+++ b/hermes_cli/kanban_diagnostics.py
@@ -818,6 +818,78 @@ def _rule_scheduled_without_wake(task, events, runs, now, cfg) -> list[Diagnosti
     )]
 
 
+def _rule_clock_only_park(task, events, runs, now, cfg) -> list[Diagnostic]:
+    """A ``scheduled`` card waiting more than 2 h on a clock with no ``wake_check`` and no
+    ``clock_only``: parked before condition wakes existed, so a condition that came true
+    early sits unnoticed until the clock (t_9be6b361). [daveey]"""
+    from hermes_cli import kanban_continuation as kc
+    from hermes_cli.kanban_wake_check import GUARD_SECONDS
+
+    if _task_field(task, "status") != "scheduled" or cfg.get("_wake_check"):
+        return []
+    ev = _latest_parking_event(events)
+    if ev is None:
+        return []
+    payload = _parse_payload(ev)
+    if kc.pending_wake_payload(_event_kind(ev), payload) is None:
+        return []
+    if payload.get("wake_check") or payload.get("clock_only"):
+        return []
+    wake_at = int(payload["wake_at"])
+    if wake_at - now <= GUARD_SECONDS:
+        return []
+    task_id = str(_task_field(task, "id") or "")
+    left = (wake_at - now) / 3600
+    return [Diagnostic(
+        kind="clock_only_park", severity="warning",
+        title=f"Parked {left:.1f}h behind a clock with no wake check",
+        detail=("This card waits on a clock with no wake_check probe and was not marked "
+                "clock_only. If it waits on a readable fact (a DB row, a tag, a file, a log line), "
