From b013346b36ade82e1805a242550c1d18f2f27e16 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 22:13:53 -0700
Subject: [PATCH] fix(tools): diagnose disabled MCP servers instead of name
 retries [daveey]

---
 tests/tools/test_tool_search_disabled_mcp.py | 27 ++++++++++++++++++++
 tools/tool_search_validation.py              | 17 ++++++++++++
 2 files changed, 44 insertions(+)
 create mode 100644 tests/tools/test_tool_search_disabled_mcp.py

diff --git a/tests/tools/test_tool_search_disabled_mcp.py b/tests/tools/test_tool_search_disabled_mcp.py
new file mode 100644
index 0000000000..2aed1c63e6
--- /dev/null
+++ b/tests/tools/test_tool_search_disabled_mcp.py
@@ -0,0 +1,27 @@
+"""A disabled MCP server is not an unknown tool spelling. [daveey]"""
+import pytest
+from tools.tool_search_validation import not_deferrable_error
+
+
+@pytest.mark.parametrize('enabled', [False, 'false'])
+def test_disabled_server_explains_config_not_name(monkeypatch, enabled):
+    from tools import mcp_tool_config
+    monkeypatch.setattr(mcp_tool_config, '_load_mcp_config', lambda: {
+        'midbrain-memory': {'enabled': enabled, '_relay_note': 'secret must not echo'}})
+    error = not_deferrable_error('mcp__midbrain_memory__memory_search')
+    assert 'disabled' in error
+    assert 'mcp_servers.midbrain-memory.enabled' in error
+    assert 'Use tool_search' not in error
+    assert 'secret' not in error
+
+
+def test_unknown_server_retains_name_hint(monkeypatch):
+    from tools import mcp_tool_config
+    monkeypatch.setattr(mcp_tool_config, '_load_mcp_config', dict)
+    assert 'not a known tool name' in not_deferrable_error('mcp__absent__search')
+
+
+def test_enabled_server_does_not_claim_disabled(monkeypatch):
+    from tools import mcp_tool_config
+    monkeypatch.setattr(mcp_tool_config, '_load_mcp_config', lambda: {'example': {'enabled': True}})
+    assert 'disabled' not in not_deferrable_error('mcp__example__missing')
diff --git a/tools/tool_search_validation.py b/tools/tool_search_validation.py
index 3224b9cc9c..18f81e6ce6 100644
--- a/tools/tool_search_validation.py
+++ b/tools/tool_search_validation.py
@@ -266,6 +266,23 @@ def not_deferrable_error(name: str, in_session: bool = True) -> str:
     if name in _core_tool_names() or _registry_entry(name) is not None:
         return (f"'{name}' is a directly-listed tool, not a deferred one. "
                 "Call it directly instead of via tool_call. The tool was NOT invoked.")
+    # [daveey] A configured disabled MCP server cannot be recovered by trying
+    # alternate tool spellings. Inspect configuration only; never connect or enable it.
+    if name.startswith("mcp__"):
+        try:
+            from tools.mcp_tool_config import _load_mcp_config
+            from tools.mcp_tool_common import mcp_server_enabled
+            from tools.mcp_tool_schema import sanitize_mcp_name_component
+            matches = [(server, cfg) for server, cfg in _load_mcp_config().items()
+                       if name.startswith(f"mcp__{sanitize_mcp_name_component(server)}__")]
+            if len(matches) == 1 and not mcp_server_enabled(matches[0][1]):
+                server = matches[0][0]
+                return (f"'{name}' belongs to configured MCP server '{server}', which is disabled "
+                        f"(mcp_servers.{server}.enabled). Tool search cannot expose its tools while "
+                        "disabled. Check why the server was disabled and repair its configuration "
+                        "if appropriate, then start a new session. The tool was NOT invoked.")
+        except Exception:
+            pass  # Diagnostic failure must not change tool authorization.
     suffix = f"__{name}"
     try:
         from tools.registry import registry
-- 
