fa073eb288 added a text=True ssh subprocess without encoding= (trips
test_subprocess_text_encoding). 15f2bfb9bd refuses ownerless agent blocks,
so test_kanban_block_reason_scrubbed_jwt's bare block was rejected and
asserted outcome None; the test now passes kind=needs_input + human_request
and asserts the call succeeded. [daveey]
---
 hermes_cli/kanban_wait_check.py      |  3 ++-
 tests/tools/test_kanban_redaction.py | 14 +++++++++++++-
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_wait_check.py b/hermes_cli/kanban_wait_check.py
index 32dc8451d4..f915d39a71 100644
--- a/hermes_cli/kanban_wait_check.py
+++ b/hermes_cli/kanban_wait_check.py
@@ -67,7 +67,8 @@ def check_remote(gateway: str, kind: str, target: str, *, board: Optional[str] =
     remote = "export PATH=$HOME/.local/bin:$HOME/.hermes/bin:$PATH; " + shlex.join(inner)
     try:
         p = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", f"ConnectTimeout={SSH_TIMEOUT}", host, remote],
-                           capture_output=True, text=True, timeout=SSH_TIMEOUT + 15, check=False)
+                           capture_output=True, text=True, encoding="utf-8", errors="replace",
+                           timeout=SSH_TIMEOUT + 15, check=False)
     except (OSError, subprocess.TimeoutExpired) as exc:
         return 2, f"error: ssh {host}: {exc}"
     out = (p.stdout + p.stderr).strip()
diff --git a/tests/tools/test_kanban_redaction.py b/tests/tools/test_kanban_redaction.py
index 7cb57372ac..e2a1d42125 100644
--- a/tests/tools/test_kanban_redaction.py
+++ b/tests/tools/test_kanban_redaction.py
@@ -75,7 +75,19 @@ def test_kanban_block_reason_scrubbed_jwt(worker_env):
         ".eyJzdWIiOiIxMjM0NTY3ODkwIn0"
         ".dozjgNryP4J3jVmNHl0w5N_5NjP1-iXkpHgcth826Iw"
     )
-    kt._handle_block({"reason": f"Bearer {jwt}"})
+    # An ownerless block is refused (agent_owned_block), so name the human ask.
+    out = kt._handle_block({
+        "reason": f"Bearer {jwt}",
+        "kind": "needs_input",
+        "human_request": {
+            "action": "Rotate the leaked token",
+            "why_human": "Only the account owner can rotate it",
+            "interaction": "external",
+            "scope": "test token",
+            "evidence": "token appeared in a block reason",
+        },
+    })
+    assert "error" not in out, out
     conn = kbc.connect()
     try:
         run = kb.latest_run(conn, worker_env)
