From 288f6022310af17ee2465a5c74c57fec993c867e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:03:33 +0000
Subject: [PATCH] [daveey] existing-work record: pin CRLF list stripping
 (CR-only normalisation survived)

Post-merge mutation check of #2428 (t_01a1d615bdcca774): replacing
`.replace("\r\n", "\n").replace("\r", "\n")` with `.replace("\r", "\n")` in
`kanban_placement.without_evidence` survived all 21 tests. That mutant is not
equivalent: every CRLF becomes a blank line, so the "Existing work checked"
record paragraph ends after its first line and its list items (card ids, PR
refs) leak back into the scanned text, the fail-open #2428 closed.

New test: a CRLF body whose record (bold-label and heading forms) carries a
two-item list with a card id; without_evidence must drop both items and keep
the surrounding paragraphs.

Proof: tests/hermes_cli/test_kanban_existing_work_checked.py
- origin/main: 23 passed
- mutant: 2 failed (both new params)
Tests only; no production change.
---
 .../test_kanban_existing_work_checked.py           | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_existing_work_checked.py b/tests/hermes_cli/test_kanban_existing_work_checked.py
index 36c438241d..d5e7e0d348 100644
--- a/tests/hermes_cli/test_kanban_existing_work_checked.py
+++ b/tests/hermes_cli/test_kanban_existing_work_checked.py
@@ -92,6 +92,20 @@ def test_crlf_blank_lines_still_end_the_record_paragraph(body, newline):
     assert kp.portable_reason(_args(body, title="sign in")) == "local marker"
 
 
+@pytest.mark.parametrize("record", [
+    "**Existing work checked:** searched board for X\r\n",
+    "## Existing work checked\r\nSearched board for X\r\n",
+])
+def test_a_crlf_record_list_is_stripped_whole(record):
+    # RED under CR-only normalisation ("\r" -> "\n" before "\r\n"): every CRLF became a blank line, so the record
+    # paragraph ended after its first line and the list items leaked back into the scanned text.
+    body = ("Fix the thing.\r\n\r\n" + record + "- t_01a1d5f0c0ffee02 is different\r\n- PR #12 closed\r\n\r\n"
+            "Next para stays.\r\n")
+    text = kp.without_evidence(body)
+    assert "t_01a1d5f0c0ffee02" not in text and "PR #12" not in text and "\r" not in text
+    assert "Fix the thing." in text and "Next para stays." in text
+
+
 def test_the_same_action_outside_the_record_still_stays_home():
     body = BODY.replace("## Decided fix\n", "## Decided fix\nRun `hermes-hub tasks` to list every board.\n")
     assert coordination.required_labels(_args(body), POOLS) is None
