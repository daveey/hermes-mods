diff --git a/hermes_cli/kanban_home_transfer.py b/hermes_cli/kanban_home_transfer.py
new file mode 100644
index 0000000000000000000000000000000000000000..589f150bcaf979e93a7f4a528bcabdfb3bdb6bb6
--- /dev/null
+++ b/hermes_cli/kanban_home_transfer.py
@@ -0,0 +1,133 @@
+"""Dormant local preparation for a cooperative administrative-home transfer.
+
+This is NOT a Board ACK, migration command or permission to change created_on.
+No production caller prepares a transfer yet. It is one half of a coordinated
+protocol: fences remain durable on an unknown outcome, with no timed release.
+SQLite cannot revoke already serialized packets; Board ingress fencing is also
+required before this substrate can be used for a production transfer. [daveey]
+"""
+from __future__ import annotations
+
+import re
+import sqlite3
+
+_NAME = re.compile(r"[a-z0-9][a-z0-9-]{0,31}\Z")
+_NONCE = re.compile(r"[A-Za-z0-9._:-]{16,128}\Z")
+_TABLE = "kanban_home_prepared1"
+
+
+def _install(conn: sqlite3.Connection) -> None:
+    conn.execute(f"""CREATE TABLE IF NOT EXISTS {_TABLE} (
+        task_id TEXT PRIMARY KEY, source TEXT NOT NULL, destination TEXT NOT NULL,
+        nonce TEXT NOT NULL, expected_version INTEGER NOT NULL)""")
+    # Include local-only task custody (wake/ask probes, subscriptions, private
+    # restriction records), not just the rows sent by sync. Discover task_id
+    # tables from this board's real schema, retaining guards across sync detach.
+    related = {}
+    for (table,) in conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'"):
+        quoted = '"' + table.replace('"', '""') + '"'
+        columns = {row[1] for row in conn.execute(f"PRAGMA table_info({quoted})")}
+        if "task_id" in columns and table != _TABLE:
+            related[table] = columns
+    for table in ("tasks", "task_links", *sorted(related)):
+        quoted = '"' + table.replace('"', '""') + '"'
+        for action in ("INSERT", "UPDATE", "DELETE"):
+            refs = ["NEW"] if action == "INSERT" else ["OLD"] if action == "DELETE" else ["OLD", "NEW"]
+            if table == "tasks":
+                ids = [f"{ref}.id" for ref in refs]
+            elif table == "task_links":
+                ids = [f"{ref}.{col}" for ref in refs for col in ("parent_id", "child_id")]
+            else:
+                ids = [f"{ref}.task_id" for ref in refs]
+            tests = [f"task_id IN ({','.join(ids)})"]
+            if action == "INSERT" and table in related:
+                # REPLACE's implicit deletion need not fire DELETE triggers.
+                # Every unique identity matters, not only conventional id/uid.
+                # A private custody row may be keyed by an episode or compound
+                # receipt. SQL equality uses the column's declared collation.
+                groups = []
+                primary = [r[1] for r in conn.execute(f"PRAGMA table_info({quoted})") if r[5]]
+                if primary:
+                    groups.append([(col, None) for col in primary])
+                for index in conn.execute(f"PRAGMA index_list({quoted})"):
+                    if not index[2]:
+                        continue
+                    index_name = '"' + index[1].replace('"', '""') + '"'
+                    cols = [(r[2], r[4]) for r in conn.execute(f"PRAGMA index_xinfo({index_name})") if r[5]]
+                    if not cols or any(col is None for col, _ in cols):
+                        raise ValueError("unsupported expression identity in home custody")
+                    groups.append(cols)
+                conflicts = []
+                for cols in groups:
+                    parts = []
+                    for col, collation in cols:
+                        name = '"' + col.replace('"', '""') + '"'
+                        coll = '' if collation is None else ' COLLATE "' + collation.replace('"', '""') + '"'
+                        parts.append(f'{name}{coll}=NEW.{name}{coll}')
+                    conflicts.append('(' + ' AND '.join(parts) + ')')
+                if conflicts:
+                    tests.append(f"task_id IN (SELECT task_id FROM {quoted} WHERE {' OR '.join(conflicts)})")
+            cond = " OR ".join(tests)
+            trigger = '"home_prepared1_' + table.replace('"', '""') + '_' + action.lower() + '"'
+            conn.execute(f"""CREATE TRIGGER IF NOT EXISTS {trigger}
+                BEFORE {action} ON {quoted} WHEN EXISTS(SELECT 1 FROM {_TABLE} WHERE {cond})
+                BEGIN SELECT RAISE(ABORT, 'home transfer prepared'); END""")
+    for action in ("UPDATE", "DELETE"):
+        conn.execute(f"""CREATE TRIGGER IF NOT EXISTS home_prepared1_marker_{action.lower()}
+            BEFORE {action} ON {_TABLE}
+            BEGIN SELECT RAISE(ABORT, 'home transfer preparation immutable'); END""")
+    conn.execute(f"""CREATE TRIGGER IF NOT EXISTS home_prepared1_marker_insert
+        BEFORE INSERT ON {_TABLE} WHEN EXISTS(SELECT 1 FROM {_TABLE} WHERE task_id=NEW.task_id)
+        BEGIN SELECT RAISE(ABORT, 'home transfer preparation immutable'); END""")
+
+
+def prepare(conn: sqlite3.Connection, task_id: str, *, source: str, destination: str,
+            nonce: str, expected_version: int) -> dict:
+    """Fence one idle local task inside the caller's write transaction.
+
+    An exact retry returns the existing immutable tuple even after reopening.
+    Refusals roll back this helper even when caught by a caller which commits.
+    Outbox drainage is conservative across the entire board, including rejected
+    custody and synthetic parents. This does not attest remote receipt/drainage.
+    """
+    if not conn.in_transaction:
+        raise ValueError("home preparation requires a write transaction")
+    if (not isinstance(source, str) or not _NAME.fullmatch(source)
+            or not isinstance(destination, str) or not _NAME.fullmatch(destination)
+            or source == destination or not isinstance(nonce, str) or not _NONCE.fullmatch(nonce)
+            or type(expected_version) is not int or expected_version < 1):
+        raise ValueError("invalid home preparation identity")
+    record = dict(task_id=task_id, source=source, destination=destination,
+                  nonce=nonce, expected_version=expected_version)
+    conn.execute("SAVEPOINT home_prepare")
+    try:
+        _install(conn)
+        old = conn.execute(f"SELECT task_id,source,destination,nonce,expected_version FROM {_TABLE} WHERE task_id=?",
+                           (task_id,)).fetchone()
+        if old:
+            if tuple(old) != tuple(record.values()):
+                raise ValueError("home preparation identity changed")
+        else:
+            state = conn.execute("SELECT gateway_id FROM kanban_sync_state").fetchall()
+            if len(state) != 1 or state[0][0] != source:
+                raise ValueError("home preparation is not on the source gateway")
+            row = conn.execute("SELECT created_on,sync_version,status,claim_lock,worker_pid,lease_holder,"
+                               "workspace_custody FROM tasks WHERE id=?", (task_id,)).fetchone()
+            if not row or row[0] != source or row[1] != expected_version:
+                raise ValueError("home preparation version or source changed")
+            if row[2] in ("running", "done", "archived") or any(row[i] is not None for i in (3, 4, 5, 6)):
+                raise ValueError("home preparation requires an idle open task without custody")
+            if conn.execute("SELECT 1 FROM task_runs WHERE task_id=? AND ended_at IS NULL LIMIT 1", (task_id,)).fetchone():
+                raise ValueError("home preparation has an unended run")
+            if (conn.execute("SELECT 1 FROM kanban_sync_outbox LIMIT 1").fetchone()
+                    or conn.execute("SELECT 1 FROM kanban_sync_parent_envelopes LIMIT 1").fetchone()
+                    or conn.execute("SELECT 1 FROM kanban_sync_omissions LIMIT 1").fetchone()):
+                raise ValueError("home preparation requires drained pending custody")
+            conn.execute(f"INSERT INTO {_TABLE}(task_id,source,destination,nonce,expected_version) VALUES (?,?,?,?,?)",
+                         tuple(record.values()))
+    except BaseException:
+        conn.execute("ROLLBACK TO home_prepare")
+        conn.execute("RELEASE home_prepare")
+        raise
+    conn.execute("RELEASE home_prepare")
+    return {"phase": "prepared_local", **record}
diff --git a/tests/hermes_cli/test_kanban_home_transfer_fence.py b/tests/hermes_cli/test_kanban_home_transfer_fence.py
new file mode 100644
index 0000000000000000000000000000000000000000..873483a73caa0da94366c988c1bd0e405b80645b
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_home_transfer_fence.py
@@ -0,0 +1,184 @@
+"""Local live-home preparation fences SQLite writers, not just dispatcher ticks."""
+from __future__ import annotations
+
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from tests.hermes_cli import kanban_sync_support as support
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    home = support.kanban_home(tmp_path, monkeypatch)
+    yield from support.synced_conn(home)
+
+
+def prepare(conn, tid, nonce="transfer-00000001"):
+    from hermes_cli import kanban_home_transfer
+
+    return kanban_home_transfer.prepare(conn, tid, source="worker-a3", destination="hermes-hub",
+                                       nonce=nonce, expected_version=7)
+
+
+def seed(conn):
+    tid = kb.create_task(conn, title="existing worker home")
+    with kbc.write_txn(conn):
+        conn.execute("UPDATE tasks SET created_on='worker-a3',sync_version=7 WHERE id=?", (tid,))
+        conn.execute("UPDATE kanban_sync_state SET gateway_id='worker-a3'")
+        conn.execute("DELETE FROM kanban_sync_outbox")
+    return tid
+
+
+def test_prepare_stops_an_existing_connection_even_with_sync_applying(board):
+    tid = seed(board)
+    before = board.execute("SELECT status FROM tasks WHERE id=?", (tid,)).fetchone()[0]
+    with kbc.write_txn(board):
+        prepare(board, tid)
+    # applying is only an echo guard, never administrative-transfer permission.
+    with kbc.write_txn(board):
+        board.execute("UPDATE kanban_sync_state SET applying=1")
+    with pytest.raises(sqlite3.IntegrityError, match="home transfer prepared"):
+        with kbc.write_txn(board):
+            board.execute("UPDATE tasks SET status='blocked' WHERE id=?", (tid,))
+    assert board.execute("SELECT status FROM tasks WHERE id=?", (tid,)).fetchone()[0] == before
+
+
+@pytest.mark.parametrize("sql", [
+    "UPDATE tasks SET claim_lock='other:123' WHERE id=?",
+    "UPDATE tasks SET id='replacement-task' WHERE id=?",
+    "DELETE FROM tasks WHERE id=?",
+    "INSERT INTO task_comments(task_id,author,body,created_at) VALUES (?,'actor','late',1)",
+    "INSERT INTO task_events(task_id,kind,payload,created_at) VALUES (?,'late','{}',1)",
+    "INSERT INTO task_runs(task_id,profile,status,started_at) VALUES (?,'default','running',1)",
+    "INSERT INTO task_links(parent_id,child_id) VALUES (?,'missing-child')",
+    "INSERT INTO task_links(child_id,parent_id) VALUES (?,'missing-parent')",
+])
+def test_task_children_and_both_link_directions_are_fenced(board, sql):
+    tid = seed(board)
+    with kbc.write_txn(board):
+        prepare(board, tid)
+    with pytest.raises(sqlite3.IntegrityError, match="home transfer prepared"):
+        with kbc.write_txn(board):
+            board.execute(sql, (tid,))
+
+
+def test_prepare_is_durable_idempotent_and_does_not_block_a_neighbour(board):
+    tid = seed(board)
+    with kbc.write_txn(board):
+        first = prepare(board, tid)
+    with kbc.write_txn(board):
+        assert prepare(board, tid) == first
+    with pytest.raises(ValueError, match="identity changed"):
+        with kbc.write_txn(board):
+            prepare(board, tid, nonce="transfer-00000002")
+    other = kb.create_task(board, title="unrelated task")
+    kb.add_comment(board, other, "actor", "still works")
+    assert first["phase"] == "prepared_local"
+    assert board.execute("SELECT count(*) FROM task_comments WHERE task_id=?", (other,)).fetchone()[0] == 1
+
+
+@pytest.mark.parametrize("mutation, message", [
+    ("UPDATE tasks SET sync_version=8 WHERE id=?", "version or source changed"),
+    ("UPDATE tasks SET created_on='worker-a2' WHERE id=?", "version or source changed"),
+    ("UPDATE tasks SET status='running' WHERE id=?", "idle open task"),
+    ("UPDATE tasks SET worker_pid=123 WHERE id=?", "idle open task"),
+    ("UPDATE tasks SET claim_lock='actor:123' WHERE id=?", "idle open task"),
+    ("UPDATE tasks SET lease_holder='peer' WHERE id=?", "idle open task"),
+    ("UPDATE tasks SET workspace_custody='{}' WHERE id=?", "idle open task"),
+    ("INSERT INTO task_runs(task_id,profile,status,started_at) VALUES (?,'default','running',1)", "unended run"),
+])
+def test_refusal_rolls_back_even_when_outer_caller_commits(board, mutation, message):
+    tid = seed(board)
+    with kbc.write_txn(board):
+        board.execute(mutation, (tid,))
+        board.execute("DELETE FROM kanban_sync_outbox")
+    with kbc.write_txn(board):
+        with pytest.raises(ValueError, match=message):
+            prepare(board, tid)
+    assert board.execute("SELECT 1 FROM sqlite_master WHERE name='kanban_home_prepared1'").fetchone() is None
+
+
+def test_replacement_of_a_child_cannot_delete_a_fenced_old_identity(board):
+    tid = seed(board)
+    other = kb.create_task(board, title="unfenced neighbour")
+    kb.add_comment(board, tid, "actor", "retained")
+    with kbc.write_txn(board):
+        board.execute("DELETE FROM kanban_sync_outbox")
+        row = board.execute("SELECT id,uid FROM task_comments WHERE task_id=?", (tid,)).fetchone()
+        prepare(board, tid)
+    for col, value in (("id", row[0]), ("uid", row[1])):
+        with pytest.raises(sqlite3.IntegrityError, match="home transfer prepared"):
+            with kbc.write_txn(board):
+                board.execute(f"INSERT OR REPLACE INTO task_comments({col},task_id,author,body,created_at) "
+                              "VALUES (?,?,'actor','wrong home',1)", (value, other))
+    assert board.execute("SELECT body FROM task_comments WHERE id=?", (row[0],)).fetchone()[0] == "retained"
+
+
+def test_pending_custody_is_not_discarded_to_make_preparation_pass(board):
+    tid = seed(board)
+    kb.add_comment(board, tid, "actor", "not pushed yet")
+    before = board.execute("SELECT count(*) FROM kanban_sync_outbox").fetchone()[0]
+    with kbc.write_txn(board):
+        with pytest.raises(ValueError, match="drained pending custody"):
+            prepare(board, tid)
+    assert board.execute("SELECT count(*) FROM kanban_sync_outbox").fetchone()[0] == before
+
+
+def test_probe_custody_cannot_change_while_prepared(board):
+    tid = seed(board)
+    with kbc.write_txn(board):
+        board.execute("INSERT INTO task_wake_checks(task_id,cmd,every,next_at) VALUES (?,'true',120,1)", (tid,))
+        prepare(board, tid)
+    with pytest.raises(sqlite3.IntegrityError, match="home transfer prepared"):
+        with kbc.write_txn(board):
+            board.execute("DELETE FROM task_wake_checks WHERE task_id=?", (tid,))
+
+
+def test_fence_survives_reopen_and_refuses_sync_detach_evidence_loss(board):
+    from hermes_cli import kanban_db_sync as sync
+
+    tid = seed(board)
+    path = board.execute("PRAGMA database_list").fetchone()[2]
+    with kbc.write_txn(board):
+        prepare(board, tid)
+    # Normal detach clears captured origin custody, so it must fail closed too.
+    # Its refusal must not erase the independent administrative-home fence.
+    with pytest.raises(sqlite3.IntegrityError, match="home transfer prepared"):
+        with kbc.write_txn(board):
+            sync.drop_triggers(board)
+    # Raw old connections do not have to import this module to be fenced.
+    with sqlite3.connect(path) as other:
+        with pytest.raises(sqlite3.IntegrityError, match="home transfer prepared"):
+            other.execute("UPDATE tasks SET title='stale writer' WHERE id=?", (tid,))
+    assert board.execute("SELECT title FROM tasks WHERE id=?", (tid,)).fetchone()[0] == "existing worker home"
+
+
+@pytest.mark.parametrize("sql", [
+    "DELETE FROM kanban_home_prepared1 WHERE task_id=?",
+    "UPDATE kanban_home_prepared1 SET nonce='another-nonce-0001' WHERE task_id=?",
+    "INSERT OR REPLACE INTO kanban_home_prepared1 SELECT * FROM kanban_home_prepared1 WHERE task_id=?",
+])
+def test_uncertain_preparation_cannot_be_reset_or_replaced(board, sql):
+    tid = seed(board)
+    with kbc.write_txn(board):
+        prepare(board, tid)
+    with pytest.raises(sqlite3.IntegrityError, match="preparation immutable"):
+        with kbc.write_txn(board):
+            board.execute(sql, (tid,))
+
+
+def test_private_custody_primary_key_replacement_checks_the_old_task(board):
+    tid = seed(board)
+    other = kb.create_task(board, title="unprepared")
+    with kbc.write_txn(board):
+        board.execute("CREATE TABLE transfer_fixture_custody(episode TEXT PRIMARY KEY,task_id TEXT NOT NULL)")
+        board.execute("INSERT INTO transfer_fixture_custody VALUES ('episode-1',?)", (tid,))
+        board.execute("DELETE FROM kanban_sync_outbox")
+        prepare(board, tid)
+    with pytest.raises(sqlite3.IntegrityError, match="home transfer prepared"):
+        with kbc.write_txn(board):
+            board.execute("INSERT OR REPLACE INTO transfer_fixture_custody VALUES ('episode-1',?)", (other,))
+    assert board.execute("SELECT task_id FROM transfer_fixture_custody").fetchone()[0] == tid
