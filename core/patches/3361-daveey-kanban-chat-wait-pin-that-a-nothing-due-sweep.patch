From a4dbc3ca0a3227bbe0a7bd1aa3f06210c6fd68b2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 10:17:09 +0000
Subject: [PATCH] [daveey] kanban chat-wait: pin that a nothing-due sweep skips
 lag_hold for an unwarned board

PR #2072 review nit 2 (review 5889301365, card t_01a1d4672c08d567). A board outside _LAG_WARNED swept with nothing due never reads the replica lag, and another board's recorded stall survives. RED: an unconditional fresh.lag_hold() on the discard path fails the new test; GREEN on main.
---
 .../test_kanban_ready_wait_checkpoint.py      | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_ready_wait_checkpoint.py b/tests/hermes_cli/test_kanban_ready_wait_checkpoint.py
index 0803f9a15d..cd821597bc 100644
--- a/tests/hermes_cli/test_kanban_ready_wait_checkpoint.py
+++ b/tests/hermes_cli/test_kanban_ready_wait_checkpoint.py
@@ -444,3 +444,30 @@ def test_board_with_nothing_due_ends_its_stall(tmp_path, monkeypatch, caplog):
         assert deferred == ["WARNING", "INFO", "WARNING"]
     finally:
         a.close()
+
+
+def test_nothing_due_sweep_of_unwarned_board_skips_lag_hold(tmp_path, monkeypatch):
+    """PR #2072 review nit 2: a sweep with nothing due never reads the replica lag for a board outside
+    ``_LAG_WARNED``, so a healthy board pays no extra replica read per tick. Another board's stall stays recorded."""
+    from hermes_cli import kanban_replica_freshness as fresh
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    for key in ("HERMES_KANBAN_DB", "HERMES_KANBAN_BOARD", "HERMES_KANBAN_TASK"):
+        monkeypatch.delenv(key, raising=False)
+    other = str(tmp_path / "lagging.db")
+    monkeypatch.setattr(cw, "_LAG_WARNED", {other})  # non-empty, so the nothing-due discard path runs
+    calls = []
+
+    def _lag_hold(conn, now=None):
+        calls.append(_db_file(conn))
+        raise AssertionError("lag_hold read on a nothing-due sweep of an unwarned board")
+
+    monkeypatch.setattr(fresh, "lag_hold", _lag_hold)
+    a = kbc.connect(tmp_path / "a.db")
+    try:
+        assert cw.sweep(a) == 0
+        assert calls == []
+        assert cw._LAG_WARNED == {other}
+    finally:
+        a.close()
-- 
