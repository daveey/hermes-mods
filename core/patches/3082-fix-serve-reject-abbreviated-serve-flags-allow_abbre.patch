From b1c86d167fdafdf9150efedcd4bcf4d6d03d3bb9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 01:44:10 +0000
Subject: [PATCH] fix(serve): reject abbreviated serve flags
 (allow_abbrev=False) [daveey]

The serve parsers kept argparse's allow_abbrev=True, so unique prefixes such as
--ssh-session-tok=/f or --ssh-session /g set ssh_session_token_file while
_startup_fast.is_desktop_ssh_backend_argv (the proof-home Desktop-backend shape
check and process_identity.is_desktop_owned_backend) only matches the exact flag.
An agent-stamped abbreviated form slipped past the production-home guard.

Build both serve parsers (lean build_serve_parser and the full-tree serve
subparser) with allow_abbrev=False so argv shape and parser agree.
Follow-up to PR #1808 review nit (t_01a1d28b07c574aa).
---
 hermes_cli/subcommands/dashboard.py        | 12 ++++++--
 tests/hermes_cli/test_fast_serve_launch.py | 14 +++++++++
 tests/hermes_cli/test_serve_proof_home.py  | 36 ++++++++++++++++++++++
 3 files changed, 59 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/subcommands/dashboard.py b/hermes_cli/subcommands/dashboard.py
index c7c8bb4caa..9a4b9e743f 100644
--- a/hermes_cli/subcommands/dashboard.py
+++ b/hermes_cli/subcommands/dashboard.py
@@ -48,7 +48,12 @@ def _add_server_runtime_args(parser) -> None:
 
 
 def _configure_serve_parser(parser, *, cmd_dashboard: Callable) -> None:
-    """Canonical ``serve`` arguments; shared by the full tree and Desktop's lean hot-path parser."""
+    """Canonical ``serve`` arguments; shared by the full tree and Desktop's lean hot-path parser.
+
+    Both callers build ``parser`` with ``allow_abbrev=False``: argv-shape readers
+    (``_startup_fast.is_desktop_ssh_backend_argv``) match exact flags, so a prefix the parser
+    accepted would set ``--ssh-session-token-file`` while the shape check missed it.
+    """
     _add_server_runtime_args(parser)
     # Redundant (serve is always headless) but accepted so legacy callers don't error.
     parser.add_argument("--no-open", action="store_true", help=argparse.SUPPRESS)
@@ -70,7 +75,7 @@ def build_serve_parser(
         description="Run the Hermes backend server - the JSON-RPC/WebSocket gateway the "
             "desktop app and remote clients connect to. Headless: it never opens "
             "a browser UI.",
-        add_help=add_help, exit_on_error=exit_on_error)
+        add_help=add_help, exit_on_error=exit_on_error, allow_abbrev=False)
     _configure_serve_parser(parser, cmd_dashboard=cmd_dashboard)
     return parser
 
@@ -99,7 +104,8 @@ def build_dashboard_parser(
         help="Start the Hermes backend server (headless; powers the desktop app and remote backends)",
         description="Run the Hermes backend server — the JSON-RPC/WebSocket gateway the "
             "desktop app and remote clients connect to. Headless: it never opens "
-            "a browser UI.")
+            "a browser UI.",
+        allow_abbrev=False)
     _configure_serve_parser(serve_parser, cmd_dashboard=cmd_dashboard)
 
     # `register` is nested so bare `hermes dashboard` keeps launching the server.
diff --git a/tests/hermes_cli/test_fast_serve_launch.py b/tests/hermes_cli/test_fast_serve_launch.py
index a0f3961596..1e92e4d54f 100644
--- a/tests/hermes_cli/test_fast_serve_launch.py
+++ b/tests/hermes_cli/test_fast_serve_launch.py
@@ -26,6 +26,20 @@ def test_lean_serve_parser_matches_full_subcommand_parser() -> None:
     assert vars(lean.parse_args(argv)) == vars(root.parse_args(["serve", *argv]))
 
 
+def test_serve_parsers_reject_abbreviated_token_file_flag() -> None:
+    """argv-shape readers (``is_desktop_ssh_backend_argv``) match the exact flag; no prefix may parse."""
+    root = argparse.ArgumentParser()
+    subparsers = root.add_subparsers(dest="command")
+    build_dashboard_parser(subparsers, cmd_dashboard=_capture, cmd_dashboard_register=_capture)
+    lean = build_serve_parser(cmd_dashboard=_capture, add_help=False, exit_on_error=False)
+
+    for argv in (["--ssh-session-tok=/f"], ["--ssh-session", "/g"], ["--ssh-session-token-fil", "/h"]):
+        args, unknown = lean.parse_known_args(argv)
+        assert args.ssh_session_token_file is None and unknown, argv
+        args, unknown = root.parse_known_args(["serve", *argv])
+        assert args.ssh_session_token_file is None and unknown, argv
+
+
 def test_fast_serve_launch_dispatches_only_unambiguous_serve(monkeypatch) -> None:
     captured = []
     monkeypatch.setattr(config_mod, "get_container_exec_info", lambda: None)
diff --git a/tests/hermes_cli/test_serve_proof_home.py b/tests/hermes_cli/test_serve_proof_home.py
index 9590682b11..3d525e936c 100644
--- a/tests/hermes_cli/test_serve_proof_home.py
+++ b/tests/hermes_cli/test_serve_proof_home.py
@@ -133,6 +133,42 @@ def test_desktop_backend_shape_without_isolated_still_rejected(sentinel, extra,
     _assert_refused(result, sentinel, before)
 
 
+_PARSE_BOUNDARY = '''
+import argparse, runpy, sys
+_parse = argparse.ArgumentParser.parse_known_args
+def parse_known_args(self, *a, **k):
+    ns, rest = _parse(self, *a, **k)
+    if getattr(ns, 'ssh_session_token_file', None):
+        print('PARSED_TOKEN_FILE=' + ns.ssh_session_token_file, flush=True)
+        raise SystemExit(87)
+    return ns, rest
+argparse.ArgumentParser.parse_known_args = parse_known_args
+sys.argv = ['hermes'] + sys.argv[1:]
+runpy.run_module('hermes_cli.main', run_name='__main__')
+'''
+
+
+@pytest.mark.parametrize('args', [
+    ['serve', '--ssh-session-tok=/fixture/token'],
+    ['serve', '--ssh-session', '/fixture/token'],
+])
+def test_abbreviated_token_file_flag_is_rejected_by_parser(sentinel, args):
+    """The bootstrap shape check matches the exact flag, so no parser may accept a prefix of it: an
+    agent-stamped abbreviated form would otherwise set the token file while skipping the guard.
+    (``hermes_cli.main`` imports config at module level, so the parser rejects it after that import;
+    the tripwire here is the first parse that yields a token file, before ``cmd_dashboard``.)"""
+    before = _snapshot(sentinel)
+    env = _clean_env(sentinel, 'HERMES_AGENT_TOOL_CALL', {'HERMES_DESKTOP': '1'})
+    result = subprocess.run([sys.executable, '-c', _PARSE_BOUNDARY, *args], env=env, cwd=ROOT,
+                            capture_output=True, text=True, encoding='utf-8', timeout=30, check=False)
+    assert result.returncode == 2, (result.stdout, result.stderr)
+    assert 'PARSED_TOKEN_FILE=' not in result.stdout
+    assert 'unrecognized arguments' in result.stderr
+    # main's startup seeds default home files for every command; the recovery state is untouched.
+    after = _snapshot(sentinel)
+    assert {name: after.get(name) for name in before} == before
+
+
 @pytest.mark.parametrize('args', [['dashboard', '--port', '0', '--no-open'], ['serve', '--port', '0']])
 def test_desktop_chat_tool_child_may_run_plain_backend(sentinel, args):
     """A Desktop chat's tool children inherit HERMES_DESKTOP=1 (and never the session token):
