From 98279ccfb42003a18db185cf6c9c9f3cfcd1a891 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 06:38:17 +0000
Subject: [PATCH] [daveey] kanban_tools: move _store_attachment into the
 attach-url sibling (FILE_LINES offset)

The consent-stop fence in _handle_comment took kanban_tools.py to 2004 lines after main grew it; moving the attachment store helper (pure move, re-exported under the same name) brings it back to 1994.
---
 tools/kanban_tools.py            | 12 +-----------
 tools/kanban_tools_attach_url.py | 13 +++++++++++++
 2 files changed, 14 insertions(+), 11 deletions(-)

diff --git a/tools/kanban_tools.py b/tools/kanban_tools.py
index 33b3f94ddf..25ab64a7d7 100644
--- a/tools/kanban_tools.py
+++ b/tools/kanban_tools.py
@@ -28,7 +28,7 @@ from tools.kanban_tools_placement import (_local_placement, _machine_placement,
                                           _effective_board_args, _origin_enrollment, _landing_placement, _pinned_note,
                                           _admission_refused, _effective_requires, _with_admission)
 # SSRF-checked capped download lives in a sibling; tests monkeypatch it on this module.
-from tools.kanban_tools_attach_url import _download_url_with_cap
+from tools.kanban_tools_attach_url import _download_url_with_cap, _store_attachment
 from tools.kanban_tools_db_hint import generic_tool_error
 from tools.kanban_tools_park_args import (_blocker_id_arg, _clear_blocker_arg, _blocker_scope_args, _park_guard,
                                           _wake_check_args, _wake_check_echo, _escalated)
@@ -1389,16 +1389,6 @@ def _handle_comment(args: dict, **kw) -> str:
                    **({"subscribed": True} if subscribed else {}))
 
 
-def _store_attachment(board, tid, filename, data, content_type) -> str:
-    """Store via ``kanban_db.store_attachment_bytes`` (shared size cap, per-task
-    dir, metadata row) so agent, dashboard, and CLI surfaces stay in lockstep."""
-    with _board(board) as (kb, conn):
-        att_id = kb.store_attachment_bytes(
-            conn, tid, str(filename), data,
-            content_type=content_type, uploaded_by="agent", board=board)
-        return _ok(task_id=tid, attachment_id=att_id, size=len(data))
-
-
 @_kanban_handler("kanban_attach")
 def _handle_attach(args: dict, **kw) -> str:
     """Attach an inline (base64) file to a task."""
diff --git a/tools/kanban_tools_attach_url.py b/tools/kanban_tools_attach_url.py
index 320dfbec6e..97035dc8b2 100644
--- a/tools/kanban_tools_attach_url.py
+++ b/tools/kanban_tools_attach_url.py
@@ -1,6 +1,7 @@
 """SSRF-checked, size-capped URL download for ``kanban_attach_url`` (split from kanban_tools). [daveey]"""
 from __future__ import annotations
 
+import json
 from typing import Optional
 
 _MAX_ATTACH_URL_REDIRECTS = 5
@@ -42,3 +43,15 @@ def _download_url_with_cap(url: str, max_bytes: int) -> tuple[bytes, Optional[st
                 chunks.append(chunk)
         return b"".join(chunks), content_type
     raise ValueError(f"too many redirects fetching {url}")
+
+
+def _store_attachment(board, tid, filename, data, content_type) -> str:
+    """Store via ``kanban_db.store_attachment_bytes`` (shared size cap, per-task
+    dir, metadata row) so agent, dashboard, and CLI surfaces stay in lockstep.
+    Moved from kanban_tools (its line cap); re-exported there under the same name."""
+    from tools.kanban_tools_board import tool_board
+    with tool_board(board) as (kb, conn):
+        att_id = kb.store_attachment_bytes(
+            conn, tid, str(filename), data,
+            content_type=content_type, uploaded_by="agent", board=board)
+        return json.dumps({"ok": True, "task_id": tid, "attachment_id": att_id, "size": len(data)})
-- 
2.51.0

