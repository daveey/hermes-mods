From 0ec87174b2ba19e366913e69c441565e2a7179ad Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:25:13 +0000
Subject: [PATCH] [daveey] managed_worker: keyless orphans wait for a gateway
 restart only; explicit recover stub default

Follow-up to PR #2115 review (t_01a1d4964c80c82b) nits:

1. The comment at recover_from_checkpoint(session_keys=...) said keyless
   orphans wait for "a gateway/Desktop backend restart". owner_accepts()
   (tools/process_registry_readopt.py) lets the gateway keeper
   (owner='gateway') take gateway-kind and keyless entries, while the
   Desktop/TUI keeper (owner='tui') takes only tui-kind (keyed, no ':')
   entries. So a keyless orphan is re-adopted only by a gateway restart,
   never on a Desktop-only host. Reworded: keyed orphans wait for a later
   run of their route or their owner's keeper; keyless ones for a gateway
   restart only. Comment-only change.

2. tests/gateway/test_managed_worker_route_key.py _execute: the recover stub
   default is now an explicit `if recover is None:` like built/sent, instead
   of `recover or (lambda **_k: None)`.

Tests: 44 managed_worker test files, 194 passed. scripts/check --base
origin/main: 19 checks ok.
---
 agent/managed_worker.py                        | 8 +++++---
 tests/gateway/test_managed_worker_route_key.py | 6 ++++--
 2 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/agent/managed_worker.py b/agent/managed_worker.py
index 3019320722..de462e2ce5 100644
--- a/agent/managed_worker.py
+++ b/agent/managed_worker.py
@@ -354,9 +354,11 @@ def execute(frame, channel):
     # (F24); adopt them so process_manage in this turn can poll and kill them. Only this session's:
     # another chat's orphan (a Desktop job whose backend just rolled over) would finish in this
     # per-turn process, whose completion queue nobody reads, and its notice was lost. So a managed
-    # worker no longer adopts keyless orphans or orphans of other worker routes either: they wait
-    # for a later run of the same route, or for a gateway/Desktop backend restart, whose keeper
-    # adopts them. [daveey]
+    # worker no longer adopts keyless orphans or orphans of other worker routes either. A keyed
+    # orphan waits for a later run of its own route or for its owner's keeper (gateway keeper for
+    # messaging keys, Desktop/TUI keeper for Desktop session ids). A keyless one waits for a gateway
+    # restart only: the Desktop keeper never takes keyless entries (owner_accepts), so a host with
+    # no gateway never re-adopts it. [daveey]
     from tools.process_registry import process_registry
     process_registry.recover_from_checkpoint(session_keys=(frame['route'], scope['session_id']))
     # Store construction binds the delegation ledger before tool discovery.
diff --git a/tests/gateway/test_managed_worker_route_key.py b/tests/gateway/test_managed_worker_route_key.py
index f4405204cd..03181365f1 100644
--- a/tests/gateway/test_managed_worker_route_key.py
+++ b/tests/gateway/test_managed_worker_route_key.py
@@ -31,6 +31,9 @@ def _minimax_frame(tmp_path, monkeypatch, api_key=None):
 def _execute(frame, monkeypatch, base=object, built=None, result=None, sent=None, recover=None):
     from agent import managed_worker as worker
     built = {} if built is None else built
+    if recover is None:
+        def recover(**_k):
+            return None
 
     class Agent(base):
         def __init__(self, **kwargs):
@@ -61,8 +64,7 @@ def _execute(frame, monkeypatch, base=object, built=None, result=None, sent=None
     monkeypatch.setattr(worker, 'WorkerControls', Controls)
     monkeypatch.setattr('agent.runtime_session_store.WorkerRPC', lambda home: lambda *a, **k: {'owner_epoch': 1})
     monkeypatch.setattr('agent.runtime_session_store.RuntimeSessionStore', Store)
-    monkeypatch.setattr('tools.process_registry.process_registry.recover_from_checkpoint',
-                        recover or (lambda **_k: None))
+    monkeypatch.setattr('tools.process_registry.process_registry.recover_from_checkpoint', recover)
     monkeypatch.setattr('run_agent.AIAgent', Agent)
     monkeypatch.setattr('agent.title_generator.wait_for_title_upgrades', lambda: None)
     sent = [] if sent is None else sent
