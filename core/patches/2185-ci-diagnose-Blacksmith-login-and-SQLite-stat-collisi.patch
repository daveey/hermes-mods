From a7b665398d30059bcd0ca876753a3f373ca2bf48 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 07:12:41 +0000
Subject: [PATCH] ci: diagnose Blacksmith login and SQLite stat collisions
 [daveey]

---
 .github/workflows/blacksmith-diagnostic.yml | 40 +++++++++++++++++++++
 1 file changed, 40 insertions(+)
 create mode 100644 .github/workflows/blacksmith-diagnostic.yml

diff --git a/.github/workflows/blacksmith-diagnostic.yml b/.github/workflows/blacksmith-diagnostic.yml
new file mode 100644
index 0000000000..2895c3121e
--- /dev/null
+++ b/.github/workflows/blacksmith-diagnostic.yml
@@ -0,0 +1,40 @@
+name: Blacksmith filesystem and login diagnostic
+on:
+  push:
+    branches: [wt/blacksmith-stat-login]
+permissions:
+  contents: read
+jobs:
+  diagnose:
+    runs-on: blacksmith-4vcpu-ubuntu-2404
+    steps:
+      - name: Inspect login startup and SQLite commit signatures
+        shell: bash
+        run: |
+          python3 - <<'PY'
+          import os, pathlib, subprocess, tempfile, sqlite3
+          print('identity', subprocess.check_output(['id'], text=True))
+          for p in [pathlib.Path('/etc/profile'), pathlib.Path('/etc/bash.bashrc'), *pathlib.Path('/etc/profile.d').glob('*')]:
+              if p.is_file():
+                  print('PROFILE', p, p.read_text())
+          with tempfile.TemporaryDirectory() as d:
+              home = pathlib.Path(d)
+              for name in ['.profile', '.bash_profile']:
+                  (home/name).write_text('export HERMES_LOGIN_MARKER=from-login-rc\n')
+              for shell in ['/bin/bash', '/bin/sh']:
+                  r = subprocess.run([shell, '-lic', 'printf "HOME=%s marker=%s\\n" "$HOME" "$HERMES_LOGIN_MARKER"'], env={**os.environ, 'HOME':d}, text=True, capture_output=True)
+                  print('LOGIN', shell, r.returncode, r.stdout, r.stderr)
+              p=home/'probe.db'
+              c=sqlite3.connect(p)
+              c.execute('CREATE TABLE t(x)'); c.execute('INSERT INTO t VALUES (0)'); c.commit()
+              same=0
+              for i in range(100):
+                  before=p.stat()
+                  c.execute('UPDATE t SET x=?',(i+1,)); c.commit()
+                  after=p.stat()
+                  if (before.st_ino,before.st_size,before.st_mtime_ns)==(after.st_ino,after.st_size,after.st_mtime_ns):
+                      same+=1
+                      if same <= 3: print('COLLISION', before.st_mtime_ns, after.st_mtime_ns, before.st_ctime_ns, after.st_ctime_ns)
+              print('sqlite version',sqlite3.sqlite_version,'same-stat commits',same)
+              print(subprocess.check_output(['stat','-f',str(p)],text=True))
+          PY
-- 
2.55.0

