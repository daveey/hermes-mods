From bb4d3d72134a5fea9be02045561ce22b40171275 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 12:51:59 +0000
Subject: [PATCH] [daveey] Update native ticket fallback contract for receipt
 purpose

Retain remote bypass and Webapp fallback assertions while including the new receipt-only native purpose in the exact redemption sequence. Proof: CI 44905232264 failed this old two-purpose assertion; updated originless transport and receipt suites pass 11 tests with retries disabled.
---
 tests/gateway/test_webapp_ws_originless_remote_ticket.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/gateway/test_webapp_ws_originless_remote_ticket.py b/tests/gateway/test_webapp_ws_originless_remote_ticket.py
index 6047447295..2ec40ca21f 100644
--- a/tests/gateway/test_webapp_ws_originless_remote_ticket.py
+++ b/tests/gateway/test_webapp_ws_originless_remote_ticket.py
@@ -65,8 +65,8 @@ async def test_remote_originless_dial_matches_the_same_dial_with_an_origin():
 async def test_loopback_ticket_still_takes_the_native_grant_first():
     reached, closes, redeemed = await _dial("127.0.0.1")
     assert closes == []
-    assert [purpose for _ticket, purpose in redeemed] == ["interactive", "worker-adoption"]
-    assert reached == [("127.0.0.1", 40000)]  # neither grant matched: the Webapp's issuer, as before
+    assert [purpose for _ticket, purpose in redeemed] == ["interactive", "worker-adoption", "prompt-receipt"]
+    assert reached == [("127.0.0.1", 40000)]  # no native grant matched: the Webapp's issuer, as before
 
 
 @pytest.mark.asyncio
-- 
