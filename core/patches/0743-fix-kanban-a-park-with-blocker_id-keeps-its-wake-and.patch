             requested_kind, rekind_reason = kind, None
             if kind == "assignment":
                 kind, rekind_reason = assignment_routing.classify(get_task(conn, task_id), kind, reason, human_request=human_request)
@@ -3235,12 +3268,17 @@ def block_task(
