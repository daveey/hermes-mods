                 return ktp.park(conn, task_id, reason=reason, requested_kind=kind, source_status="ready",
                                 from_untyped_block=True, wake_check=wake_check,
-                                check_every=check_every, clock_only=clock_only, awaiting=awaiting)
+                                check_every=check_every, clock_only=clock_only, awaiting=awaiting,
