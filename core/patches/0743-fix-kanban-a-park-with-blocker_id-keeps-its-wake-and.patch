+        kb.claim_task(conn, tid)
+        wake = kwc.planned_wake(conn, tid, op="block", kind="time", blocker_id=BID,
+                                reason=f"SCHEDULED_UNTIL={_future_iso(5 * 3600)}")
+        assert wake is not None and wake > time.time() + 4 * 3600
+
+
