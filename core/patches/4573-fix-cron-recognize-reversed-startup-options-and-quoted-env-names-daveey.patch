From f998b4b5087322433d799fbcc07ade5296600d98 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 15:21:00 +0000
Subject: [PATCH] fix(cron): recognize reversed startup options and quoted env
 names [daveey]

---
 cron/lifecycle_guard_startup.py                | 8 ++++----
 tests/cron/test_lifecycle_guard_startup_env.py | 6 ++++++
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/cron/lifecycle_guard_startup.py b/cron/lifecycle_guard_startup.py
index 2b34406b10b3cc886d3ab37ad095b47d15ef6bbe..60dbe1475f2cbd6248b73389685334c4ef5496b3 100644
--- a/cron/lifecycle_guard_startup.py
+++ b/cron/lifecycle_guard_startup.py
@@ -24,8 +24,8 @@ def _startup_variable(shell: str, arguments: list[str]) -> str | None:
         elif word == "--interactive":
             interactive = True
         elif not word.startswith("--"):
-            if word.startswith("-") and "i" in word[1:]:
-                interactive = True
+            if "i" in word[1:]:
+                interactive = word.startswith("-")
             for flag in word[1:]:
                 if flag in "oO":
                     value = arguments[index] if index < len(arguments) else ""
@@ -44,8 +44,8 @@ def iter_startup_sources(command: str) -> Iterator[tuple[str, bool]]:
     stay identical. Prefix assignments are conservative across wrappers; inherited
     process environment is deliberately not consulted for remote commands.
     """
-    if "BASH_ENV=" not in command and "ENV=" not in command:
-        return
+    # Assignment names may contain shell quotes or escapes. Match only after
+    # the shared segment tokenizer removes them, not against raw source text.
     from cron.lifecycle_guard import (
         _executable_name, _executed_command_index, _iter_command_segment_views,
         _split_redirections,
diff --git a/tests/cron/test_lifecycle_guard_startup_env.py b/tests/cron/test_lifecycle_guard_startup_env.py
index f005773da3accbfb31b5859856c99bd1fbb2365c..b059f2930a775b559384ba9035c14de9faf57117 100644
--- a/tests/cron/test_lifecycle_guard_startup_env.py
+++ b/tests/cron/test_lifecycle_guard_startup_env.py
@@ -10,6 +10,12 @@ from cron.lifecycle_guard import scan_gateway_lifecycle
 
 SHAPES = [
     "BASH_ENV=start.sh bash -c true",
+    "BASH_ENV=start.sh bash -i +i -c true",
+    "BASH_ENV=start.sh bash -i +i -i +i -c true",
+    "env 'BASH_ENV'=start.sh bash -c true",
+    "env BASH_ENV''=start.sh bash -c true",
+    "env BA\\SH_ENV=start.sh bash -c true",
+    "env 'ENV'=start.sh bash --posix -ic true",
     "env BASH_ENV=./start.sh bash -c true",
     "BASH_ENV='start.sh' command bash -c true",
     "env -i PATH=/usr/bin:/bin BASH_ENV=start.sh bash -c true",
-- 
2.43.0

