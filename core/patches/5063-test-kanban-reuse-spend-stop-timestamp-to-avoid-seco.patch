From 74e8765b4270536d15316686f90e4ccba9893c9e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 04:20:29 +0000
Subject: [PATCH] test(kanban): reuse spend stop timestamp to avoid second race
 [daveey]

---
 tests/hermes_cli/test_kanban_spend_promote.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_spend_promote.py b/tests/hermes_cli/test_kanban_spend_promote.py
index a22b91e709..74ba1de118 100644
--- a/tests/hermes_cli/test_kanban_spend_promote.py
+++ b/tests/hermes_cli/test_kanban_spend_promote.py
@@ -107,8 +107,8 @@ def test_decision_card_promotes_with_an_exact_four_run_window(fleet):
 
 def test_plain_manual_promote_does_not_reset_the_spend_window(fleet):
     f = fleet
-    _stop(f, at=int(time.time()) - 1000)
     stop_at = int(time.time()) - 1000
+    _stop(f, at=stop_at)
     with kb.write_txn(f.h):
         kb._append_event(f.h, f.target, "promoted_manual", {"actor": "user", "reason": "x"})
     assert ksb.spend(f.h, f.target).since == stop_at
