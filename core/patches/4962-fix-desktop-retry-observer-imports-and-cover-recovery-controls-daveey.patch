From 330110514541c7ca2ade0ebfdf28a356390a9f47 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 09:59:27 +0000
Subject: [PATCH] fix(desktop): retry observer imports and cover recovery
 controls [daveey]

---
 .../test_startup_resume_observer_guards.py    | 65 +++++++++++++++++++
 tui_gateway/startup_resume.py                 |  6 +-
 2 files changed, 68 insertions(+), 3 deletions(-)

diff --git a/tests/tui_gateway/test_startup_resume_observer_guards.py b/tests/tui_gateway/test_startup_resume_observer_guards.py
index db982d7e7433d0fdd50f1b915b44efe8972f23f2..8d97ff5a356804ae920d62680fd575121ccab719 100644
--- a/tests/tui_gateway/test_startup_resume_observer_guards.py
+++ b/tests/tui_gateway/test_startup_resume_observer_guards.py
@@ -47,6 +47,7 @@ def test_observer_refreshes_guards_and_recovers(tmp_path, monkeypatch, caplog, m
     assert calls and calls[-1] == 7
     if mode in {"skew", "disabled"}:
         assert min(calls) >= 3
+        assert waits[:3] == [5, 30, 30]
     if mode.endswith("error"):
         assert "observer iteration failed" in caplog.text
     if mode == "config_error":
@@ -55,3 +56,67 @@ def test_observer_refreshes_guards_and_recovers(tmp_path, monkeypatch, caplog, m
         assert waits == [5, 10, 20, 40, 80, 160, 300, 300]
         assert "remain unscheduled" in caplog.text
     assert 8 not in calls
+
+
+@pytest.mark.parametrize("failure", ["import", "refused", "deleted"])
+def test_observer_recovers_to_fast_cadence(tmp_path, monkeypatch, failure):
+    import builtins
+    from gateway import code_skew
+    from hermes_cli import config
+
+    stop = threading.Event()
+    waits = []
+    calls = []
+    real_import = builtins.__import__
+
+    def importing(name, *args, **kwargs):
+        if failure == "import" and name == "gateway.code_skew" and len(waits) == 1:
+            raise ImportError("transient import failure")
+        return real_import(name, *args, **kwargs)
+
+    def sleep(seconds):
+        waits.append(seconds)
+        if len(waits) == 4:
+            stop.set()
+
+    def resume(*args, **kwargs):
+        calls.append(len(waits))
+        if len(waits) == 1:
+            return [{"scheduled": False, "deleted": failure == "deleted"}]
+        return [{"scheduled": True}]
+
+    monkeypatch.setattr(sr, "time", SimpleNamespace(sleep=sleep))
+    monkeypatch.setattr(config, "load_config", dict)
+    monkeypatch.setattr(code_skew, "detect_code_skew", lambda: None)
+    monkeypatch.setattr(sr, "_paused_markers_remain", lambda *a: True)
+    monkeypatch.setattr(sr, "resume_interrupted_sessions", resume)
+    monkeypatch.setattr(builtins, "__import__", importing)
+    sr._observe_pauses(lambda *a: None, tmp_path, {}, stop)
+    assert waits == [5, {"import": 30, "refused": 10, "deleted": 5}[failure], 5, 5]
+    assert calls == ([2, 3] if failure == "import" else [1, 2, 3])
+
+
+def test_boot_scan_failure_still_starts_observer(tmp_path, monkeypatch):
+    from hermes_cli import config, proof_home
+    import hermes_constants
+    from tui_gateway import server
+
+    stop = threading.Event()
+    observed = []
+    handler = lambda *a: None
+    monkeypatch.setattr(proof_home, "recovery_home_allowed", lambda *a: True)
+    monkeypatch.setattr(hermes_constants, "get_hermes_home", lambda: tmp_path)
+    monkeypatch.setattr(config, "load_config", dict)
+    monkeypatch.setattr(server, "_methods", {"session.resume": handler})
+    monkeypatch.setattr(sr, "time", SimpleNamespace(sleep=lambda *a: None))
+
+    def fail(*args, **kwargs):
+        raise OSError("boot marker scan failed")
+
+    monkeypatch.setattr(sr, "resume_interrupted_sessions", fail)
+    monkeypatch.setattr(sr, "_observe_pauses", lambda *a: observed.append(a))
+    thread = sr.start_startup_resume_sweep(stop=stop)
+    assert thread is not None
+    thread.join(5)
+    assert not thread.is_alive()
+    assert observed == [(handler, tmp_path, {}, stop)]
diff --git a/tui_gateway/startup_resume.py b/tui_gateway/startup_resume.py
index 1e3b4ffa4be4054d09fcca286ce7eac668831ab0..dee54b38cbb8899392bf1067d39f1da7ce2d5c94 100644
--- a/tui_gateway/startup_resume.py
+++ b/tui_gateway/startup_resume.py
@@ -178,9 +178,6 @@ def _paused_markers_remain(home: Path, cfg: dict | None) -> bool:
 
 def _observe_pauses(handler: Callable, home: Path, cfg: dict, stopped: threading.Event) -> None:
     """Passive lifetime observer; refusals back off, but never retire the observer."""
-    from gateway.code_skew import detect_code_skew
-    from hermes_cli.config import load_config
-
     retry_delay = 5.0
     while not stopped.is_set():
         try:
@@ -192,6 +189,9 @@ def _observe_pauses(handler: Callable, home: Path, cfg: dict, stopped: threading
         if stopped.is_set():
             break
         try:
+            from gateway.code_skew import detect_code_skew
+            from hermes_cli.config import load_config
+
             cfg = load_config()
             if not _settings(cfg)[0] or detect_code_skew() is not None:
                 retry_delay = 30.0
