+            left = board_calls.renew_remaining(conn, task.id, run.run_uid, ttl)
+        except board_calls.SourceCallRefused as exc:
+            raise PublishRefused("publish_lease_lost", exc.detail) from exc
+        if left < cfg.push_timeout_s + 60:
