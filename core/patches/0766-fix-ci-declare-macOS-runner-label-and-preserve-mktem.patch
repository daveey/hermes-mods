From 6e65da3e6fe9db5aea3109bb331cd3aa9d22998b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 07:39:42 -0700
Subject: [PATCH] fix(ci): declare macOS runner label and preserve mktemp
 errors [daveey]

---
 .github/actionlint.yaml                  | 2 ++
 .github/workflows/hermes-state-macos.yml | 3 ++-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/.github/actionlint.yaml b/.github/actionlint.yaml
index 29bb95efdb..57d43d577f 100644
--- a/.github/actionlint.yaml
+++ b/.github/actionlint.yaml
@@ -16,6 +16,8 @@ self-hosted-runner:
     - ci-fast
     # bubblewrap-capable hub slots (tests.yml e2e-upgrade).
     - ci-bwrap
+    # Dedicated single-job macOS state-suite runner on the mini.
+    - hermes-state
 
 # fork (daveey/hermes): known findings that are not bugs. The lint runs in
 # .github/workflows/actionlint.yml. Keep each pattern narrow.
diff --git a/.github/workflows/hermes-state-macos.yml b/.github/workflows/hermes-state-macos.yml
index 33e0370967..baf35962a5 100644
--- a/.github/workflows/hermes-state-macos.yml
+++ b/.github/workflows/hermes-state-macos.yml
@@ -43,7 +43,8 @@ jobs:
         shell: bash
         run: |
           set -euo pipefail
-          export HERMES_HOME="$(mktemp -d "${RUNNER_TEMP:-/tmp}/hermes-home.XXXXXX")"
+          HERMES_HOME="$(mktemp -d "${RUNNER_TEMP:-/tmp}/hermes-home.XXXXXX")"
+          export HERMES_HOME
           trap 'rm -rf "$HERMES_HOME"' EXIT
           scripts/run_tests.sh tests/hermes_state/ -j 4
         env:
-- 
2.55.0

