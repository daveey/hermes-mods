-    cards[0]["skip"].update(last_at=1201000, passes=2)
-    assert kps.file_repairs(worker.conn, WORKER, cards, now=1201) == [tid]
+    cards[0]["skip"].update(last_at=clock[0] * 1000, passes=2)
