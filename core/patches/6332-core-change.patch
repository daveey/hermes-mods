Subject: [PATCH 6332] Semantic annotation parts and fail-fresh caching

Public mirror of source commit 4c7ca30a14877b59edd32e9946c6cbe76158ad52.

---
diff --git a/tests/hermes_cli/test_annotation_native_holder.py b/tests/hermes_cli/test_annotation_native_holder.py
index a668ba7c16d..20bed2b70ca 100644
--- a/tests/hermes_cli/test_annotation_native_holder.py
+++ b/tests/hermes_cli/test_annotation_native_holder.py
@@ -384,6 +384,13 @@
     scope = ('native-recovery-test', 'default')
     path = tmp_path / 'kanban.db'
     writer = helpers._board(path, [('t1', 'running', 's1')])
+    # Give semantic lineage probing a real isolated store. Missing state is
+    # deliberately fail-fresh and would turn settle confirmations into forced reads.
+    from hermes_state import SessionDB
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    state = SessionDB(db_path=tmp_path / 'state.db')
+    state.create_session('s1', 'cli')
+    state.close()
     monkeypatch.setenv('HERMES_KANBAN_HOME', str(tmp_path))
     monkeypatch.setattr(disk, 'FORCE', True)
     monkeypatch.setattr(ksa, '_origin_scope', lambda: scope)
diff --git a/tests/hermes_cli/test_kanban_notify.py b/tests/hermes_cli/test_kanban_notify.py
index 9a636a68f30..cb6db591f41 100644
--- a/tests/hermes_cli/test_kanban_notify.py
+++ b/tests/hermes_cli/test_kanban_notify.py
@@ -958,6 +958,10 @@
         # triggers, which name every read column and so block the DROP.
         from hermes_cli.kanban_activity_revision import drop_triggers
         drop_triggers(conn)
+        # The pre-column image predates the independent annotation revisions too.
+        for (name,) in conn.execute("SELECT name FROM sqlite_master WHERE type='trigger' "
+                                    "AND tbl_name='kanban_notify_subs' AND name LIKE 'kanban_annotation_%'").fetchall():
+            conn.execute(f'DROP TRIGGER "{name}"')
         conn.execute("ALTER TABLE kanban_notify_subs DROP COLUMN delivery_mode")
         conn.execute(
             "INSERT INTO kanban_notify_subs "
diff --git a/tests/hermes_cli/test_kanban_schema_owner.py b/tests/hermes_cli/test_kanban_schema_owner.py
index 4cc95f9a85e..ec53296943c 100644
--- a/tests/hermes_cli/test_kanban_schema_owner.py
+++ b/tests/hermes_cli/test_kanban_schema_owner.py
@@ -141,11 +141,13 @@
     leaves readers on a stat fallback or a full read."""
     from hermes_cli.kanban_activity_revision import CHANGE_TABLE, REVISION_TABLE
     from hermes_cli.kanban_notify_revision import TABLE as NOTIFY_REVISION_TABLE
+    from hermes_cli.kanban_annotation_revision import KINDS
+    optional = {REVISION_TABLE, CHANGE_TABLE, NOTIFY_REVISION_TABLE, *(k.table for k in KINDS)}
     db = home / "kanban.db"
     kbc.connect(db).close()
     raw = sqlite3.connect(db)
     try:
-        created = {t: c for t, c in owner._tables(raw).items() if t not in (REVISION_TABLE, CHANGE_TABLE, NOTIFY_REVISION_TABLE)}
+        created = {t: c for t, c in owner._tables(raw).items() if t not in optional}
         assert created == owner._reference_schema()
     finally:
         raw.close()
@@ -339,11 +341,13 @@
     """With sync live, the at-par reference also holds every sync table/column connect() installs."""
     from hermes_cli.kanban_activity_revision import CHANGE_TABLE, REVISION_TABLE
     from hermes_cli.kanban_notify_revision import TABLE as NOTIFY_REVISION_TABLE
+    from hermes_cli.kanban_annotation_revision import KINDS
+    optional = {REVISION_TABLE, CHANGE_TABLE, NOTIFY_REVISION_TABLE, *(k.table for k in KINDS)}
     monkeypatch.setattr(owner, "_REFERENCE", {})
     db = _synced_board(home)
     raw = sqlite3.connect(db)
     try:
-        created = {t: c for t, c in owner._tables(raw).items() if t not in (REVISION_TABLE, CHANGE_TABLE, NOTIFY_REVISION_TABLE)}
+        created = {t: c for t, c in owner._tables(raw).items() if t not in optional}
         assert "kanban_sync_state" in created
         assert created == owner._reference_schema(sync=True)
     finally:
