From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 21:53:16 -0800
Subject: [PATCH 6071] Kanban spend budget: window semantics, input checks and immediate reviewer

Public mirror of source commit bfce6da3e9df5fb9450b85e43985998d58e2cea2.

---
diff --git a/hermes_cli/kanban_spend_budget_cli.py b/hermes_cli/kanban_spend_budget_cli.py
index 42941ca2dc1..0bdba586267 100644
--- a/hermes_cli/kanban_spend_budget_cli.py
+++ b/hermes_cli/kanban_spend_budget_cli.py
@@ -56,7 +56,7 @@
     if not tripped:
         return ''
     return (f"kanban spend-budget: {tid}: " + '; '.join(tripped) + ". A limit counts spend already recorded, "
-            "so this would trip the budget at once. To stop the card, block or archive it instead.")
+            "so this would trip the budget at once. Use --exempt for no limit; to stop the card, block or archive it.")
 
 
 def command(args: argparse.Namespace) -> int:
diff --git a/tests/hermes_cli/test_kanban_spend_budget_below_spent.py b/tests/hermes_cli/test_kanban_spend_budget_below_spent.py
index 2dbf0b20839..c2695980659 100644
--- a/tests/hermes_cli/test_kanban_spend_budget_below_spent.py
+++ b/tests/hermes_cli/test_kanban_spend_budget_below_spent.py
@@ -85,3 +85,13 @@
     cli.run_slash(f'spend-budget {tid} --runs 9 --reason x')
     with kbc.connect_closing() as conn:
         assert budget.card_limits(conn, tid, helpers.LIMITS).runs == 9
+
+
+def test_clearing_back_to_a_board_limit_already_spent_is_refused(kanban_home, monkeypatch):
+    tid = _card_with_spend(7)
+    cli.run_slash(f'spend-budget {tid} --exempt --reason standing')
+    monkeypatch.setattr(budget, 'limits', lambda cfg=None: budget.Limits(5, helpers.LIMITS.cache_read_tokens))
+    out = cli.run_slash(f'spend-budget {tid} --clear --reason done')
+    assert "the board's runs limit 5" in out and '--runs 12' in out and '--exempt' in out, out
+    with kbc.connect_closing() as conn:
+        assert budget.card_limits(conn, tid, budget.limits()) == (0, 0)
