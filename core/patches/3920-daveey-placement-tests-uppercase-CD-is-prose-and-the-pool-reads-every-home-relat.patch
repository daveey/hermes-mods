From c95a58bcdc79342699e37926940daddb200aaaa5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 21:41:10 +0000
Subject: [PATCH] [daveey] placement tests: uppercase CD is prose, and the pool
 reads every home-relative hit

Post-merge mutants on PR #2585 (card t_01a1d6cc4a9eaa0a, check t_01a1d697acbb03f7), on top of
PR #2649 (span ends only at a cd of this shell).

Rows added:
- test_an_uppercase_cd_does_not_end_the_span (4 pin rows: CI/CD prose, a line-start "CD",
  "; CD repo;", "&& CD ~/x &&"). Kills M2: the command-position cd/pushd made case-insensitive.
- test_an_uppercase_cd_is_no_home_marker (2 portable rows: "the backup CD;" then a repo
  .hermes path, "the backup CD ~/.hermes;"). Kills M2c (_CD_HOME case-insensitive) and M2b
  (_CD_INTO case-insensitive).
- test_a_worker_reads_every_home_relative_hit_as_its_home_path (pool queue): two cd-home spans,
  the first naming ~/.hermes/.env, the second this worker's own artifact; the card keeps as
  a-artifact with hit ~/.hermes/kanban/workspaces/<id>/log.txt. Kills M8 (no span finditer) and
  M8b (relative hit not rewritten to ~/).

M13 (pushd no longer ends the span) and M3 (drop the `.hermes` lookahead on the stop) are
already killed at #2649's head by its rows (`cd ~ && pushd repo && cat .hermes/notes.md`;
`cd ~ && cd .hermes && cat .env` and the hub-read-roots controls): since #2649 the stop starts
at the `&&`, before the span's own `cd .hermes` alternative, so M3 is no longer equivalent.
M12 (popd) is gone: #2649 keeps the span open at popd.

Mutants (sdlc-review scripts/mutants.py, placement_home_spellings + hub_read_roots + the
pool-queue home rows, 218 tests): baseline ok; M2, M2b, M2c, M3, M8, M8b, M13 all killed.
Before these rows M2, M2b, M2c, M8, M8b survived. Test-only; both timing rows stay green.
---
 .../test_kanban_placement_home_spellings.py   | 21 +++++++++++++++++++
 tests/hermes_cli/test_kanban_pool_queue.py    | 14 +++++++++++++
 2 files changed, 35 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_placement_home_spellings.py b/tests/hermes_cli/test_kanban_placement_home_spellings.py
index 881c54b729..b3ae37ee40 100644
--- a/tests/hermes_cli/test_kanban_placement_home_spellings.py
+++ b/tests/hermes_cli/test_kanban_placement_home_spellings.py
@@ -113,6 +113,27 @@ def test_a_cd_of_this_shell_still_ends_the_span(body):
     assert helpers._hub({"title": "Maintenance", "body": body})["runs_on"] == ["machine:worker-1"]
 
 
+# Post-merge mutants on PR #2585 (card t_01a1d6cc4a9eaa0a): cd/pushd match lowercase only, as the shell does. An
+# uppercase "CD" in prose (a disc, CI/CD) neither ends a home-relative span nor starts or names one.
+@pytest.mark.parametrize("body", [
+    "Run pytest, then cd ~ && read the CI/CD notes, then cat .hermes/.env",
+    "Run pytest, then cd ~ && read the notes\nCD burns are out of scope; cat .hermes/.env",
+    "Run pytest, then cd ~; CD repo; cat .hermes/.env",
+    "Run pytest, then cd ~ && CD ~/x && cat .hermes/.env",
+])
+def test_an_uppercase_cd_does_not_end_the_span(body):
+    d = helpers._hub({"title": "Maintenance", "body": body})
+    assert d["where"] == "local" and "runs_on" not in d, d
+
+
+@pytest.mark.parametrize("body", [
+    "Run pytest, then label the backup CD; then cat .hermes/notes.md in the repo",
+    "Run pytest, then label the backup CD ~/.hermes; it holds the hermes-agent tree",
+])
+def test_an_uppercase_cd_is_no_home_marker(body):
+    assert helpers._hub({"title": "Maintenance", "body": body})["runs_on"] == ["machine:worker-1"]
+
+
 def test_a_large_no_match_prose_cd_body_is_linear():
     """Spans no longer end at a prose cd, so a later cd home must still end one: no O(n^2) on one long line."""
     from hermes_cli import kanban_placement as kp
diff --git a/tests/hermes_cli/test_kanban_pool_queue.py b/tests/hermes_cli/test_kanban_pool_queue.py
index 105c15bb49..e78fedfcc2 100644
--- a/tests/hermes_cli/test_kanban_pool_queue.py
+++ b/tests/hermes_cli/test_kanban_pool_queue.py
@@ -1366,6 +1366,20 @@ def test_a_worker_keeps_a_card_naming_its_own_artifact_by_a_home_spelling(on_w2,
     assert _home_marker(on_w2.conn, out["task_id"])["class"] == "a-artifact"
 
 
+def test_a_worker_reads_every_home_relative_hit_as_its_home_path(on_w2, tmp_path):
+    """Every relative ``.hermes/<p>`` after a cd home reads as ``~/.hermes/<p>``, not only the first one (post-merge
+    mutants M8/M8b on PR #2585): the first span names hub state, the second this worker's own artifact, which keeps."""
+    log = tmp_path / ".hermes" / "kanban" / "workspaces" / "t_0000000000000005" / "log.txt"
+    log.parent.mkdir(parents=True)
+    log.write_text("x\n")
+    out = _kept(on_w2.conn, _create(
+        title="cd ~ && cat .hermes/.env; cd ~ && cat .hermes/kanban/workspaces/t_0000000000000005/log.txt"))
+    assert "exists only on this worker" in out["note"], out
+    marker = _home_marker(on_w2.conn, out["task_id"])
+    assert marker["class"] == "a-artifact", marker
+    assert marker["hit"] == "~/.hermes/kanban/workspaces/t_0000000000000005/log.txt", marker
+
+
 def test_a_repo_relative_hermes_after_a_later_cd_is_no_home_marker(on_w2, tmp_path):
     """A later cd elsewhere ends the home-relative span (PR #2463 review 5895947424 nit): the repo's own
     ``.hermes/kanban/...`` is not read as this worker's ``~/.hermes/kanban/...`` artifact."""
-- 
