From 2464c9c484acbcb22994bb091d908481671c7a4d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 08:54:30 -0700
Subject: [PATCH] ci(gate): the fork-disabled tests-os lane is a tolerated
 release skip; fork_guard tests are never hidden [daveey]

ci.yaml turns tests-os off on the fork (if: false, no macOS/Windows runner), but the strict release
gate still required it, so release run 40864619088 failed 'All required checks pass' with all 38 lanes
green - no release run on this fork could ever pass. required_results.py now tolerates
FORK_DISABLED_JOBS in release mode.

Why it was not caught: tests/ci/conftest.py (written by scripts/fork-ci-runner.sh) turns any failure
that mentions tests-os into a skip, which also hides a gate that wrongly requires it. Tests marked
fork_guard are now exempt.

Tests: test_every_job_ci_turns_off_is_a_tolerated_release_skip (fork_guard) reads ci.yaml and requires
every if:false job the gate needs to be tolerated; it and test_release_exclusion_policy fail against
the old gate (before the hook change, the new guard failure showed as a skip).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pyproject.toml                    |  1 +
 scripts/ci/required_results.py    |  5 ++++-
 scripts/fork-ci-runner.sh         |  4 +++-
 tests/ci/conftest.py              |  4 +++-
 tests/ci/test_required_results.py | 17 +++++++++++++++++
 5 files changed, 28 insertions(+), 3 deletions(-)

diff --git a/pyproject.toml b/pyproject.toml
index 3499250b184..6de4bd21be7 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -698,6 +698,7 @@ markers = [
   "real_retry_backoff: opt out of the tests/agent autouse stub that zeroes jittered_backoff",
   "requires_wal: needs the runtime to actually enable SQLite WAL mode (skipped where Hermes falls back to journal_mode=DELETE)",
   "no_isolate: opt out of per-file subprocess isolation (tests share mutable module-level state)",
+  "fork_guard: [daveey] never turned into a skip by the fork's tests-os conftest hook (tests/ci/conftest.py)",
   "ssh: marks tests requiring a reachable SSH server (skipped in normal CI)",
   "platforms(*specs, arch=None, arch_negate=False): run only on hosts matching at least one spec — linux/macos/windows/posix/any, 'not X' negation, optional arch filter",
 ]
diff --git a/scripts/ci/required_results.py b/scripts/ci/required_results.py
index 1752bfd53ff..d1a7e6c6d1d 100644
--- a/scripts/ci/required_results.py
+++ b/scripts/ci/required_results.py
@@ -25,7 +25,10 @@ from typing import Any
 # Desktop E2E. These are the only skips a strict run tolerates.
 PR_ONLY_JOBS = ("history-check", "lockfile-diff", "prompt-surface-diff", "supply-chain")
 DEFERRED_JOBS = ("e2e-desktop",)
-EXCLUDED_JOBS = frozenset((*PR_ONLY_JOBS, *DEFERRED_JOBS))
+# [daveey] fork-ci-runner: ci.yaml turns these off with ``if: false`` (no macOS/Windows runner), so a
+# strict release run that required them could never pass the gate however green every lane was.
+FORK_DISABLED_JOBS = ("tests-os",)
+EXCLUDED_JOBS = frozenset((*PR_ONLY_JOBS, *DEFERRED_JOBS, *FORK_DISABLED_JOBS))
 
 NEEDS_JSON_OUTPUT = "needs-json"
 
diff --git a/scripts/fork-ci-runner.sh b/scripts/fork-ci-runner.sh
index ccd533a7f9d..f3a27d7e486 100755
--- a/scripts/fork-ci-runner.sh
+++ b/scripts/fork-ci-runner.sh
@@ -150,7 +150,9 @@ _FORK_OS_LANE_RE = _fork_re.compile(r"tests-os|e2e-windows|_windows_desktop_upda
 def pytest_runtest_makereport(item, call):
     outcome = yield
     rep = outcome.get_result()
-    if _FORK_NO_OS_LANE and rep.when == "call" and rep.failed and _FORK_OS_LANE_RE.search(str(rep.longrepr)):
+    # A fork_guard test asserts the fork's own wiring: its failure is real even when it names tests-os.
+    if (_FORK_NO_OS_LANE and rep.when == "call" and rep.failed and not item.get_closest_marker("fork_guard")
+            and _FORK_OS_LANE_RE.search(str(rep.longrepr))):
         rep.outcome = "skipped"
         rep.longrepr = (str(item.path), item.location[1] or 0, "fork: asserts the macOS/Windows tests-os lane, which is off on daveey/hermes")
 PY
diff --git a/tests/ci/conftest.py b/tests/ci/conftest.py
index 64d89313760..6a5a9e0895e 100644
--- a/tests/ci/conftest.py
+++ b/tests/ci/conftest.py
@@ -16,6 +16,8 @@ _FORK_OS_LANE_RE = _fork_re.compile(r"tests-os|e2e-windows|_windows_desktop_upda
 def pytest_runtest_makereport(item, call):
     outcome = yield
     rep = outcome.get_result()
-    if _FORK_NO_OS_LANE and rep.when == "call" and rep.failed and _FORK_OS_LANE_RE.search(str(rep.longrepr)):
+    # A fork_guard test asserts the fork's own wiring: its failure is real even when it names tests-os.
+    if (_FORK_NO_OS_LANE and rep.when == "call" and rep.failed and not item.get_closest_marker("fork_guard")
+            and _FORK_OS_LANE_RE.search(str(rep.longrepr))):
         rep.outcome = "skipped"
         rep.longrepr = (str(item.path), item.location[1] or 0, "fork: asserts the macOS/Windows tests-os lane, which is off on daveey/hermes")
diff --git a/tests/ci/test_required_results.py b/tests/ci/test_required_results.py
index 22ef268cf0b..6201d0b65e4 100644
--- a/tests/ci/test_required_results.py
+++ b/tests/ci/test_required_results.py
@@ -60,9 +60,26 @@ def test_selected_update_consumers_must_succeed(lane, jobs, result):
 def test_release_exclusion_policy():
     assert required_results.EXCLUDED_JOBS == {
         "history-check", "lockfile-diff", "prompt-surface-diff", "supply-chain", "e2e-desktop",
+        *required_results.FORK_DISABLED_JOBS,
     }
 
 
+@pytest.mark.fork_guard
+def test_every_job_ci_turns_off_is_a_tolerated_release_skip():
+    """A ci.yaml job with ``if: false`` always skips; if the strict gate needs it, no release run can pass
+    (release run 40864619088: 38 lanes green, gate red on the fork-disabled OS lane)."""
+    import hermes_yaml
+
+    ci = hermes_yaml.safe_load((SCRIPT.parents[2] / ".github" / "workflows" / "ci.yaml").read_text(encoding="utf-8"))
+    gate = next(j for j in ci["jobs"].values() if j.get("name") == "All required checks pass (v2)")
+    off = {name for name, job in ci["jobs"].items() if job.get("if") is False}
+    untolerated = sorted((off & set(gate["needs"])) - required_results.EXCLUDED_JOBS)
+    assert not untolerated, f"always-skipped job(s) the strict gate still requires: {untolerated}"
+    # The gate agrees: a release run where only these are skipped passes.
+    needs = {name: {"result": "skipped" if name in off else "success"} for name in gate["needs"]}
+    assert evaluate_gate(needs, release=True)["ok"], evaluate_gate(needs, release=True)
+
+
 @pytest.mark.parametrize("needs", [{}, None])
 @pytest.mark.parametrize("release", [False, True])
 def test_empty_needs_fails_closed(needs, release):
-- 
