 gateway/session_mutation_model.py             |  8 ++--
 .../gateway/test_model_pick_refused_route.py  | 45 +++++++++++++++++++
 2 files changed, 50 insertions(+), 3 deletions(-)
 create mode 100644 tests/gateway/test_model_pick_refused_route.py

diff --git a/gateway/session_mutation_model.py b/gateway/session_mutation_model.py
