From bad20e7e2928a3d76add5b13cfb6a232dfea0bef Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 14:28:52 +0000
Subject: [PATCH] [daveey] kanban quota episode: a strong-tier class route
 takes its class's free provider instead of waiting out one provider's wall

A card that crashed once resolves to the strong tier ('class:deep', 'auto', 'retry_after_run_crashed'). When a later run hit the Codex wall (until 11-18), decision() held it there although class:deep's anthropic route served live: _base_route gives no target for a class, and alternate_route/_strong_fallback accepted only default-tier reasons. Every worker's pickup recorded quota_hold and placement kept re-placing the card (Pickup queue full).

An unpinned strong-tier class route (class selector + provider auto, reason retry_after_*/pattern:*/legacy unpinned review) now takes the first eligible route of its class whose provider is outside the episode walls and active_walls(), under the same billing/capability/provider-enabled eligibility, and which serves on this gateway's live pool (live_pool_serving). The hold stays while every class route is closed. Pinned cards (pinned_route), concrete strong tiers, class routes bound to one provider and independence-chosen reviewers (review_unpinned/override) are unchanged.

Proof: new test file RED on old code (3 failed, 6 controls passed), GREEN 10/10; 10/10 mutants killed (class/auto/reason gates, each strong reason, live-serving filter, review-lane exemption and hold); affected suites 227 passed; scripts/check 18 ok. Read-only replay on worker-6 (kanban.db + 6 sync-shadow boards, 54 open episode rows): exactly 3 rows change, all subscription_quota_reset -> (claude-opus-5-5, anthropic): t_01a1cf7624ae27d9 and t_01a1cc614d3119cd (twice: local + shadow) - the two target cards.
---
 hermes_cli/kanban_quota_episode.py            |  30 +++-
 .../test_kanban_quota_episode_class_strong.py | 136 ++++++++++++++++++
 2 files changed, 160 insertions(+), 6 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_quota_episode_class_strong.py

diff --git a/hermes_cli/kanban_quota_episode.py b/hermes_cli/kanban_quota_episode.py
index b325832868..bd481b8606 100644
--- a/hermes_cli/kanban_quota_episode.py
+++ b/hermes_cli/kanban_quota_episode.py
@@ -181,16 +181,30 @@ def hold_until(conn, task_id, now=None):
     return max(s['until'] for s in outstanding) if outstanding else None
 
 
+def _strong_class(base):
+    """True for an unpinned strong-tier class route (``retry_after_*``/``pattern:*``/``review`` on
+    ``class:<x>``/``auto``): the worker would allocate any route of that class, so a wall on one provider
+    leaves the class's other providers open to it. [daveey]"""
+    from agent.model_routing import is_class_selector
+    model, provider, reason = base
+    return (isinstance(model, str) and is_class_selector(model) and str(provider or 'auto').strip().lower() == 'auto'
+            and (reason == 'review' or str(reason).startswith(('retry_after_', 'pattern:'))))
+
+
 def alternate_route(conn, task, walls, base, now):
-    """Non-allocating probe using the worker's billing/capability eligibility."""
+    """Non-allocating probe using the worker's billing/capability eligibility.
+
+    A strong-tier class route (``_strong_class``) also requires the route's provider to serve on this
+    gateway's live pool: the strong tier is chosen for its strength, so it moves only to proven room."""
     from agent.model_routing import eligible_routes, validate_policy, ModelRoutingError
     from agent.model_routing_agent import class_requirements
     from hermes_cli.config import is_provider_enabled
     from hermes_cli.kanban_model_assignment import _assignee_config
-    from hermes_cli.kanban_provider_walls import active_walls
+    from hermes_cli.kanban_provider_walls import active_walls, live_pool_serving
     model, _provider, reason = base
-    if (task.model_override or task.provider_override or reason not in {'default', 'off', 'profile_out_of_scope'}
-            or not walls):
+    strong = _strong_class(base)
+    if (task.model_override or task.provider_override
+            or (reason not in {'default', 'off', 'profile_out_of_scope'} and not strong) or not walls):
         return None
     config = _assignee_config(task.assignee) or {}
     policy = config.get('model_routing') or {}
@@ -215,6 +229,8 @@ def alternate_route(conn, task, walls, base, now):
     providers = config.get('providers') or {}
     routes = eligible_routes(policy, level, class_requirements(config), eligible=lambda r: (
         r['provider'] not in walled and is_provider_enabled(providers.get(r['provider'], {}))))
+    if strong:
+        routes = [r for r in routes if live_pool_serving(r['provider'], r['model'])]
     return (routes[0]['model'], routes[0]['provider']) if routes else None
 
 
@@ -319,8 +335,10 @@ def decision(conn, task, *, lane='ready', cfg=None, base=None, now=None):
     except Exception:
         logger.warning('kanban quota: route resolve failed for %s; holding', task.id, exc_info=True)
         return held, None
-    if lane == 'review' or base[2] in ('review_unpinned', 'review_override', 'review_override_refused') or unknown:
-        # An unrecorded wall may be any provider: no route can be proven to avoid it.
+    if (lane == 'review' and not _strong_class(base)) or base[2] in (
+            'review_unpinned', 'review_override', 'review_override_refused') or unknown:
+        # An unrecorded wall may be any provider: no route can be proven to avoid it. A legacy unpinned
+        # review on a class route (reason ``review``) chose no reviewer, so another route of its class may take it.
         return held, None
     try:
         if base[2] == 'pinned':
diff --git a/tests/hermes_cli/test_kanban_quota_episode_class_strong.py b/tests/hermes_cli/test_kanban_quota_episode_class_strong.py
new file mode 100644
index 0000000000..b2822e0b21
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_quota_episode_class_strong.py
@@ -0,0 +1,136 @@
+"""A strong-tier class route (``class:deep``/``auto``) waits only while every route of its class is walled.
+
+worker-6 2026-11-12 (t_01a1d016bd9f3b32): t_01a1cf7624ae27d9 crashed once, so it resolved to the strong tier
+``('class:deep', 'auto', 'retry_after_run_crashed')``. A later run hit the Codex wall (until 11-18). ``decision``
+held it there although class:deep's anthropic route served live: ``_base_route`` gives no target for a class,
+and ``alternate_route``/``_strong_fallback`` accepted only ``default`` reasons. Every worker's pickup recorded
+``quota_hold`` and the placement layer kept re-placing the card ("Pickup queue full").
+"""
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as dispatch
+from hermes_cli import kanban_model_tier as tier
+from hermes_cli import kanban_provider_walls as walls
+from hermes_cli.kanban_quota_episode import decision
+from tests.hermes_cli.test_kanban_quota_episode import board as board, reap, routing  # noqa: PLC0414 -- the self-alias is load-bearing: it suppresses F811 for the pytest fixture parameter shadowing this import
+from tests.hermes_cli.test_kanban_quota_episode_walls import _clock, _codex_wall
+
+CLASS_CFG = {'default_model': 'gpt-6-astra', 'default_provider': 'openai-codex',
+             'strong_model': 'class:deep', 'strong_provider': 'auto'}
+
+
+def _deep_routes(monkeypatch):
+    config, _ = routing(monkeypatch)
+    route = config['model_routing']['routes']['standard'][0]
+    config['model_routing']['routes'] = {'deep': [dict(route, provider='openai-codex', model='gpt-6-astra'),
+                                                  dict(route, model='claude-opus-5-5')]}
+    monkeypatch.setattr(tier, 'load_tier_config', lambda: CLASS_CFG)
+    return config
+
+
+def _serving(monkeypatch, served):
+    monkeypatch.setattr(walls, 'live_pool_serving', lambda provider, model=None: provider in served)
+    monkeypatch.setattr(walls, 'live_quota_wall', lambda *_a, **_k: None)
+    monkeypatch.setattr(walls, 'live_quota_room', lambda *_a, **_k: False)
+
+
+def _walled_card(conn, clock, *, lane='ready', title='retry after a crash'):
+    tid = kb.create_task(conn, title=title, assignee='a')
+    if lane == 'ready':
+        # Run 1 crashed (HTTP 401): every later run resolves to the strong tier.
+        conn.execute("INSERT INTO task_runs(task_id,started_at,ended_at,status,outcome) "
+                     "VALUES (?,?,?,'crashed','crashed')", (tid, clock[0] - 20, clock[0] - 10))
+    else:
+        conn.execute("UPDATE tasks SET status='review' WHERE id=?", (tid,))
+    conn.commit()
+    reap(conn, tid, lane=lane, admit=CLASS_CFG, **_codex_wall(clock[0] + 55 * 3600))
+    clock[0] += 301
+    return tid
+
+
+def test_retry_card_on_class_route_takes_the_free_provider_of_its_class(board, monkeypatch, all_assignees_spawnable):
+    clock = _clock(monkeypatch)
+    _deep_routes(monkeypatch)
+    _serving(monkeypatch, {'anthropic'})
+    monkeypatch.setattr(walls, 'active_walls', lambda **_k: {})
+    with kbc.connect() as conn:
+        tid = _walled_card(conn, clock)
+        task = kb.get_task(conn, tid)
+        base = tier.resolve_model_tier(conn, task, lane='ready')
+        assert base == ('class:deep', 'auto', 'retry_after_run_crashed')
+        assert decision(conn, task, lane='ready') == (None, ('claude-opus-5-5', 'anthropic'))
+        assert dispatch.check_respawn_guard(conn, tid) is None
+        seen = []
+        dispatch.dispatch_once(conn, spawn_fn=lambda task, ws: seen.append((task.model_override, task.provider_override)))
+        assert seen == [('claude-opus-5-5', 'anthropic')]
+        route = conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='run_route' "
+                             "ORDER BY id DESC LIMIT 1", (tid,)).fetchone()[0]
+        assert 'retry_after_run_crashed+quota_reroute' in route
+
+
+@pytest.mark.parametrize('why', ['walled_elsewhere', 'not_serving', 'provider_disabled'])
+def test_retry_card_keeps_its_hold_while_every_class_route_is_closed(board, monkeypatch, why):
+    clock = _clock(monkeypatch)
+    config = _deep_routes(monkeypatch)
+    _serving(monkeypatch, set() if why == 'not_serving' else {'anthropic'})
+    active = {'anthropic': float(clock[0] + 3600)} if why == 'walled_elsewhere' else {}
+    monkeypatch.setattr(walls, 'active_walls', lambda **_k: active)
+    if why == 'provider_disabled':
+        config['providers'] = {'anthropic': {'enabled': False}}
+    with kbc.connect() as conn:
+        tid = _walled_card(conn, clock)
+        assert decision(conn, kb.get_task(conn, tid), lane='ready') == ('subscription_quota_reset', None)
+        assert dispatch.check_respawn_guard(conn, tid) == 'subscription_quota_reset'
+
+
+def test_pattern_strong_class_card_takes_the_free_provider(board, monkeypatch):
+    clock = _clock(monkeypatch)
+    _deep_routes(monkeypatch)
+    _serving(monkeypatch, {'anthropic'})
+    monkeypatch.setattr(walls, 'active_walls', lambda **_k: {})
+    monkeypatch.setattr(tier, 'load_tier_config', lambda: {**CLASS_CFG, 'default_model_keep_patterns': ['security']})
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title='security work', assignee='a')
+        reap(conn, tid, admit=CLASS_CFG, **_codex_wall(clock[0] + 55 * 3600))
+        clock[0] += 301
+        assert decision(conn, kb.get_task(conn, tid), lane='ready') == (None, ('claude-opus-5-5', 'anthropic'))
+
+
+def test_unpinned_class_review_takes_the_free_provider_but_a_chosen_reviewer_waits(board, monkeypatch):
+    clock = _clock(monkeypatch)
+    _deep_routes(monkeypatch)
+    _serving(monkeypatch, {'anthropic'})
+    monkeypatch.setattr(walls, 'active_walls', lambda **_k: {})
+    with kbc.connect() as conn:
+        tid = _walled_card(conn, clock, lane='review', title='legacy unpinned review')
+        task = kb.get_task(conn, tid)
+        assert tier.resolve_model_tier(conn, task, lane='review') == ('class:deep', 'auto', 'review')
+        assert decision(conn, task, lane='review') == (None, ('claude-opus-5-5', 'anthropic'))
+        # A reviewer chosen for independence (review_unpinned) never moves off its walled provider.
+        chosen = ('gpt-6-astra', 'openai-codex', 'review_unpinned')
+        assert decision(conn, task, lane='review', base=chosen) == ('subscription_quota_reset', None)
+        # Nor does the review lane take the default tier's class reroute.
+        default = ('gpt-6-astra', 'openai-codex', 'default')
+        assert decision(conn, task, lane='ready', base=default) == (None, ('claude-opus-5-5', 'anthropic'))  # control
+        assert decision(conn, task, lane='review', base=default) == ('subscription_quota_reset', None)
+
+
+@pytest.mark.parametrize('base', [
+    ('claude-opus-5-5', 'anthropic', 'retry_after_run_crashed'),  # concrete strong tier: _strong_fallback's job
+    ('claude-opus-5-5', 'auto', 'retry_after_run_crashed'),  # a concrete model is no class
+    ('class:deep', 'openai-codex', 'retry_after_run_crashed'),  # a class bound to one provider
+    ('class:deep', 'auto', 'unknown_rule'),  # only the strong-tier reasons
+    ('class:deep', 'auto', 'pinned'),
+])
+def test_only_unpinned_strong_class_routes_move(board, monkeypatch, base):
+    clock = _clock(monkeypatch)
+    _deep_routes(monkeypatch)
+    _serving(monkeypatch, {'anthropic'})
+    monkeypatch.setattr(walls, 'active_walls', lambda **_k: {'anthropic': float(clock[0] + 3600)}
+                        if base[1] == 'anthropic' else {})
+    with kbc.connect() as conn:
+        tid = _walled_card(conn, clock)
+        task = kb.get_task(conn, tid)
+        assert decision(conn, task, lane='ready', base=base) == ('subscription_quota_reset', None)
