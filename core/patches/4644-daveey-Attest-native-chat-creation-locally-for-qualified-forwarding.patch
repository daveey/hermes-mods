diff --git a/hermes_cli/kanban_origin_native.py b/hermes_cli/kanban_origin_native.py
new file mode 100644
index 0000000000000000000000000000000000000000..d141a6e967db2ee6b1a7ad1985c01f6a446260f7
--- /dev/null
+++ b/hermes_cli/kanban_origin_native.py
@@ -0,0 +1,101 @@
+"""Machine-local creation attestations; never reconstructed from synced rows.
+
+The tool captures interactive context, and create_task records it in its own
+transaction. An inherited receipt is read only from that same primary board.
+"""
+from __future__ import annotations
+
+from contextlib import closing
+import json
+import os
+import sqlite3
+
+from hermes_cli.kanban_origin_ledger import validate_binding
+
+
+def capture(creator_task_id, *, courier=False):
+    """Trusted ambient context, never the tool's session/origin arguments."""
+    if courier:
+        return None
+    worker = os.environ.get("HERMES_KANBAN_TASK")
+    if worker:
+        return {"creator": worker} if creator_task_id == worker else None
+    if creator_task_id:
+        return None
+    from gateway.session_context import get_session_env
+    from hermes_cli.kanban_origin import gateway_names
+    from hermes_cli.profiles import get_active_profile_name
+    from hermes_cli.kanban_session_provenance import _local_session_sources, _INTERACTIVE_SOURCES
+    from hermes_cli.kanban_placement import is_placeholder_session
+    sid = get_session_env("HERMES_SESSION_ID")
+    gateway, profile = gateway_names()[0], get_active_profile_name()
+    if (not gateway or profile == "custom" or not sid or is_placeholder_session(sid)
+            or _local_session_sources([sid]).get(sid) not in _INTERACTIVE_SOURCES):
+        return None
+    return {"origin": {"gateway": gateway, "profile": profile, "session": sid}}
+
+
+def _receipt(conn, task_id):
+    if not conn.execute("SELECT 1 FROM sqlite_master WHERE name='origin_native_receipts'").fetchone():
+        return None
+    row = conn.execute("SELECT binding_json FROM origin_native_receipts WHERE task_id=?", (task_id,)).fetchone()
+    if row is None:
+        return None
+    binding = json.loads(row[0])
+    validate_binding(binding)
+    return binding
+
+
+def record(conn, task_id, context, created_at):
+    """Called inside create_task's transaction; no event or sync projection."""
+    if context is None:
+        return
+    from hermes_cli.kanban_db_sync import _db_key
+    from hermes_cli.kanban_execution_observations import board_owner_profile
+    from hermes_cli.kanban_placement_forward import opened_board
+    from hermes_cli.kanban_origin import gateway_names
+    gateway = gateway_names()[0]
+    profile = board_owner_profile(_db_key(conn))
+    board = opened_board(conn)
+    if not all((gateway, profile, board)):
+        return
+    creator = context.get("creator")
+    if creator:
+        parent = _receipt(conn, creator)
+        expected = {"gateway": gateway, "profile": profile, "board": board, "task_id": creator}
+        if parent is None or parent["owner"] != expected:
+            return
+        origin = parent["origin"]
+    else:
+        origin = context["origin"]
+    if origin["gateway"] != gateway:
+        return
+    binding = {"binding_id": "native-" + task_id, "version": 1, "publication_version": 1,
+               "origin": origin, "owner": {"gateway": gateway, "profile": profile, "board": board,
+                                           "task_id": task_id},
+               "task_record_key": f"{profile}/{board}/{task_id}"}
+    validate_binding(binding)
+    conn.execute("CREATE TABLE IF NOT EXISTS origin_native_receipts (task_id TEXT PRIMARY KEY, "
+                 "binding_json TEXT NOT NULL, inherited_from TEXT, created_at INTEGER NOT NULL)")
+    conn.execute("INSERT INTO origin_native_receipts VALUES (?,?,?,?)",
+                 (task_id, json.dumps(binding, sort_keys=True), creator, created_at))
+
+
+def lookup(origin, creator, *, gateway):
+    """Read only the qualified local primary board; never a shadow replica."""
+    if creator["gateway"] != gateway:
+        return None
+    from hermes_cli.kanban_db import kanban_db_path
+    from hermes_cli.kanban_execution_observations import board_owner_profile
+    from hermes_cli import kanban_lockguard
+    path = kanban_db_path(creator["board"])
+    if not path.exists() or board_owner_profile(path) != creator["profile"]:
+        return None
+    with closing(kanban_lockguard.connect(path.resolve().as_uri() + "?mode=ro", uri=True)) as conn:
+        from hermes_cli.kanban_placement_forward import opened_board
+        if opened_board(conn) != creator["board"]:
+            return None
+        binding = _receipt(conn, creator["task_id"])
+    if binding and binding["owner"] == creator and binding["origin"] == origin:
+        return binding
+    return None
diff --git a/tests/hermes_cli/test_origin_native.py b/tests/hermes_cli/test_origin_native.py
new file mode 100644
index 0000000000000000000000000000000000000000..ae3cbccfe74cff8f7e79f11c2122434cde1a0b31
--- /dev/null
+++ b/tests/hermes_cli/test_origin_native.py
@@ -0,0 +1,94 @@
+"""Native attestations are local transaction state, not synced provenance."""
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_origin_native as native
+
+
+@pytest.fixture
+def scope(monkeypatch):
+    from hermes_cli import kanban_origin, kanban_execution_observations, kanban_placement_forward
+    monkeypatch.setattr(kanban_origin, "gateway_names", lambda: ("macbook", []))
+    monkeypatch.setattr(kanban_execution_observations, "board_owner_profile", lambda path: "default")
+    monkeypatch.setattr(kanban_placement_forward, "opened_board", lambda conn: "default")
+    return {"origin": {"gateway": "macbook", "profile": "default", "session": "chat-1"}}
+
+
+def test_transaction_and_inheritance(scope):
+    conn = sqlite3.connect(":memory:")
+    conn.execute("BEGIN")
+    native.record(conn, "t_root", scope, 1)
+    native.record(conn, "t_child", {"creator": "t_root"}, 2)
+    assert native._receipt(conn, "t_child")["origin"] == scope["origin"]
+    assert conn.execute("SELECT inherited_from FROM origin_native_receipts WHERE task_id='t_child'").fetchone()[0] == "t_root"
+    conn.rollback()
+    assert native._receipt(conn, "t_root") is None
+
+
+def test_missing_receipt_and_synced_ancestry_cannot_authorize(scope):
+    conn = sqlite3.connect(":memory:")
+    conn.execute("CREATE TABLE task_chat_links (task_id, chat_gateway, chat_profile, chat_session)")
+    conn.execute("INSERT INTO task_chat_links VALUES ('t_fake','macbook','default','chat-1')")
+    native.record(conn, "t_child", {"creator": "t_fake"}, 2)
+    assert native._receipt(conn, "t_child") is None
+
+
+def test_foreign_parent_namespace_rejected(scope, monkeypatch):
+    conn = sqlite3.connect(":memory:")
+    native.record(conn, "t_root", scope, 1)
+    from hermes_cli import kanban_execution_observations
+    monkeypatch.setattr(kanban_execution_observations, "board_owner_profile", lambda path: "other")
+    native.record(conn, "t_child", {"creator": "t_root"}, 2)
+    assert native._receipt(conn, "t_child") is None
+
+
+@pytest.mark.parametrize("source", ["kanban", "cron", "oneshot", "subagent", None])
+def test_capture_rejects_noninteractive(scope, monkeypatch, source):
+    from gateway import session_context
+    from hermes_cli import kanban_session_provenance, profiles
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    monkeypatch.setattr(session_context, "get_session_env", lambda name: "chat-1")
+    monkeypatch.setattr(profiles, "get_active_profile_name", lambda: "default")
+    monkeypatch.setattr(kanban_session_provenance, "_local_session_sources", lambda sids: {"chat-1": source})
+    assert native.capture(None) is None
+
+
+def test_capture_ambient_interactive_only(scope, monkeypatch):
+    from gateway import session_context
+    from hermes_cli import kanban_session_provenance, profiles
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    monkeypatch.setattr(session_context, "get_session_env", lambda name: "chat-1")
+    monkeypatch.setattr(profiles, "get_active_profile_name", lambda: "default")
+    monkeypatch.setattr(kanban_session_provenance, "_local_session_sources", lambda sids: {"chat-1": "desktop"})
+    assert native.capture(None) == scope
+    assert native.capture(None, courier=True) is None
+    assert native.capture("t_forged") is None
+    monkeypatch.setenv("HERMES_KANBAN_TASK", "t_worker")
+    assert native.capture(None) is None
+    assert native.capture("t_other") is None
+    assert native.capture("t_worker") == {"creator": "t_worker"}
+
+
+def test_real_tool_creation_authorizes_native_worker_forward(tmp_path, monkeypatch, capsys):
+    from tests.tools import test_kanban_worker_created_chats as fixtures
+    from hermes_cli import kanban_origin, kanban_db_connect as kbc
+    from hermes_cli.kanban_origin_forward import authorize
+    home = fixtures.make_home(tmp_path, monkeypatch)
+    monkeypatch.setattr(kanban_origin, "gateway_names", lambda: ("here", {"here"}))
+    monkeypatch.setenv("HERMES_SESSION_ID", fixtures.CHAT)
+    task = fixtures.create("tool", monkeypatch, capsys)
+    with kbc.connect_closing() as conn:
+        binding = native._receipt(conn, task)
+    assert binding is not None
+    assert binding["origin"] == {"gateway": "here", "profile": "default", "session": fixtures.CHAT}
+    kwargs = dict(ledger=home / "missing-ledger.db", origin=binding["origin"], creator=binding["owner"],
+                  gateway="here", profile="default", sender="gw:worker-7", run_uid="run-1",
+                  lease={"task_id": task, "holder": "worker-7", "run_uid": "run-1", "expires": 200},
+                  now_ms=100, session_exists=lambda sid: sid == fixtures.CHAT,
+                  native_lookup=lambda origin, creator: native.lookup(origin, creator, gateway="here"))
+    assert authorize(**kwargs) == binding
+    kwargs["lease"]["holder"] = "worker-8"
+    with pytest.raises(ValueError, match="lease_invalid"):
+        authorize(**kwargs)
+    assert not (home / "missing-ledger.db").exists()
