From 56dc6c7e85d925dd8bf4df60e1cad3381d63cf8a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 01:48:49 +0000
Subject: [PATCH] test(notices): assert transcript recovery without passive
 rewrites [daveey]

---
 tests/tui_gateway/test_kanban_remote_notices.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/tui_gateway/test_kanban_remote_notices.py b/tests/tui_gateway/test_kanban_remote_notices.py
index 41c4f396fc155e4f4b208aa70a97023af5acefed..5865780d9c97bfbd5baef22480ee3938ac045147 100644
--- a/tests/tui_gateway/test_kanban_remote_notices.py
+++ b/tests/tui_gateway/test_kanban_remote_notices.py
@@ -380,7 +380,9 @@ def test_sweep_skips_persisted_notices_without_opening_store_even_after_restart(
         for suffix in ("-wal", "-shm"):
             ledger.with_name(ledger.name + suffix).unlink(missing_ok=True)
         krn._reset_for_tests()
-        assert len(sweep()) == 2
+        assert sweep() == []  # transcript recovery restores receipts without another write
+        with sqlite3.connect(ledger) as conn:
+            assert conn.execute('SELECT delivered FROM notices').fetchall() == [(krn.DELIVERED,)] * 2
         assert len(opens) == 4 and len(db.get_messages(CHAT)) == 1
         krn._reset_for_tests()
         assert sweep() == [] and len(opens) == 4
-- 
2.43.0

