From 508082a6d769208309a8b9d14270aa4e2efbd357 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 1 Nov 2026 16:23:25 +0000
Subject: [PATCH] ci: place always-running state consumer on ci-fast

---
 .github/workflows/ci.yaml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.github/workflows/ci.yaml b/.github/workflows/ci.yaml
index ceab27fc88a..1902145da27 100644
--- a/.github/workflows/ci.yaml
+++ b/.github/workflows/ci.yaml
@@ -586,7 +586,7 @@ jobs:
     name: macOS state required (v1)
     needs: [detect, hermes-state-macos]
     if: ${{ always() }}
-    runs-on: [self-hosted, hermes-hub]
+    runs-on: [self-hosted, ci-fast]
     timeout-minutes: 10
     steps:
       - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a  # v7.0.1 (fork: upstream uses useblacksmith/checkout)
-- 
