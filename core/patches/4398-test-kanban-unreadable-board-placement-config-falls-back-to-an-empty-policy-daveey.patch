From 68cb181be735b237d67024b635faf1dd0803d9e5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 05:24:21 +0000
Subject: [PATCH] test(kanban): unreadable board placement config falls back to
 an empty policy [daveey]

Coverage survivor from the audit of #3074 (0ae229feab): in
hermes_cli/kanban_placement.py config(), replacing the board-home read's
`except Exception: return {}` with `raise` left 255/255 tests green (no skips),
because nothing made the board-home read fail.

Tests only (no production change):
- read_config_doc_readonly / config_exists raising (parametrized) under a profile
  with no placement block -> config() == {} and the failing call was reached.
- control: a profile's own non-empty block still wins and never touches the
  broken board-home read.
- control: config_snapshot taken while the board config is unreadable pins {}
  for the block; the next block loads afresh.

Proof (sdlc-review scripts/mutants.py, zero skips, test_kanban_placement_board_home.py +
test_kanban_placement.py):
- original 255 tests + mutant `raise`: SURVIVED (255 passed, 4 new deselected)
- with the new tests: baseline 259 passed; mutant: KILLED (3 failed, 256 passed:
  both parametrized cases and the snapshot test)
---
 .../test_kanban_placement_board_home.py       | 52 +++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_placement_board_home.py b/tests/hermes_cli/test_kanban_placement_board_home.py
index 28a0b3f342f5e284578696a628cc4bc6f0033add..fa91d4e635d149aab464fcec251041226e181a68 100644
--- a/tests/hermes_cli/test_kanban_placement_board_home.py
+++ b/tests/hermes_cli/test_kanban_placement_board_home.py
@@ -79,3 +79,55 @@ def test_snapshot_pins_the_fallback_block(tmp_path, monkeypatch, no_kanban_overr
         (root / "config.yaml").write_text("kanban: {}\n")
         assert kp.config() is snap
         assert snap["worker_queue"] == {"worker-7": "pool:worker"}
+
+
+@pytest.mark.parametrize("broken", ["read_config_doc_readonly", "config_exists"])
+def test_unreadable_board_config_means_empty_policy(tmp_path, monkeypatch, no_kanban_override, broken):
+    """A profile with no placement block whose board-home config cannot be read gets ``{}``, not the exception."""
+    from hermes_cli import config_backend
+
+    _, profile = _homes(tmp_path, "kanban:\n  review_dispatch: true\n")
+    monkeypatch.setenv("HERMES_HOME", str(profile))
+    calls: list[str] = []
+
+    def boom(*_a, **_k):
+        calls.append(broken)
+        raise OSError("board config unreadable")
+
+    monkeypatch.setattr(config_backend, broken, boom)
+    assert kp.config() == {}
+    assert calls == [broken]  # the board-home read was reached and failed, not skipped
+
+
+def test_unreadable_board_config_does_not_hide_the_profile_block(tmp_path, monkeypatch, no_kanban_override):
+    """Control: a profile's own non-empty block wins and never touches the (broken) board-home read."""
+    from hermes_cli import config_backend
+
+    _, profile = _homes(tmp_path, "kanban:\n  placement:\n    worker_queue:\n      worker-9: pool:other\n")
+    monkeypatch.setenv("HERMES_HOME", str(profile))
+
+    def boom(*_a, **_k):
+        raise OSError("board config unreadable")
+
+    monkeypatch.setattr(config_backend, "read_config_doc_readonly", boom)
+    monkeypatch.setattr(config_backend, "config_exists", boom)
+    assert kp.config() == {"worker_queue": {"worker-9": "pool:other"}}
+
+
+def test_snapshot_pins_the_empty_policy_of_an_unreadable_board_config(tmp_path, monkeypatch, no_kanban_override):
+    """Control: a snapshot taken while the board config is unreadable pins ``{}`` for the whole block."""
+    from hermes_cli import config_backend
+
+    _, profile = _homes(tmp_path, "kanban: {}\n")
+    monkeypatch.setenv("HERMES_HOME", str(profile))
+    real = config_backend.read_config_doc_readonly
+
+    def boom(*_a, **_k):
+        raise OSError("board config unreadable")
+
+    monkeypatch.setattr(config_backend, "read_config_doc_readonly", boom)
+    with kp.config_snapshot() as snap:
+        assert snap == {}
+        monkeypatch.setattr(config_backend, "read_config_doc_readonly", real)
+        assert kp.config() is snap
+    assert kp.config()["worker_queue"] == {"worker-7": "pool:worker"}  # the next block loads afresh
