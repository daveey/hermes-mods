From 99ff5b51c6234cee69c0c19846cc7c3ee9a300aa Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 21:10:07 +0000
Subject: [PATCH] [daveey] test: pin canonical_home tilde expansion and
 relative bytes spelling

Post-merge mutation check of PR #2576 (t_01a1d6962c783474) found two
survivors in hermes_cli/local_work.py canonical_home():

- M3f: dropping os.path.expanduser keyed "~/h" as <cwd>/~/h instead of
  $HOME/h, so two spellings of one home got different keys (a regression
  from pre-#2576 behaviour no test could see).
- M3e: joining a relative bytes spelling onto os.getcwd() instead of
  os.getcwdb() raises TypeError (str + bytes).

Tests only. Two new cases in tests/hermes_cli/test_local_work.py:
- test_canonical_home_expands_tilde_before_joining_the_cwd (HOME
  monkeypatched, cwd unrelated, <cwd>/~/h also exists)
- test_canonical_home_resolves_a_relative_bytes_spelling_against_the_cwd
  (bytes key == normcase(fsencode(realpath(cwd/rel))))

Proof (worker-4, base d9cbfd19f88):
- main: 16 passed, 0 failed, 0 skipped
- M3f applied: only the tilde test fails (AssertionError '.../elsewhere/~/h' != '.../user/h')
- M3e applied: only the bytes test fails (TypeError: Can't mix strings and bytes in path components)

Card: t_01a1d6bb7ce88ee8
---
 tests/hermes_cli/test_local_work.py | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/tests/hermes_cli/test_local_work.py b/tests/hermes_cli/test_local_work.py
index 91d6df2576..9f9a9d9aac 100644
--- a/tests/hermes_cli/test_local_work.py
+++ b/tests/hermes_cli/test_local_work.py
@@ -69,6 +69,32 @@ def test_canonical_home_follows_a_symlink_before_dotdot_like_hermes_home_key(tmp
     assert module.canonical_home(os.path.join("x", "link", "..", "h")) == expected
 
 
+def test_canonical_home_expands_tilde_before_joining_the_cwd(tmp_path, monkeypatch):
+    """``~/h`` names ``$HOME/h``, not ``<cwd>/~/h``: without expanduser the tilde spelling joined
+    onto the cwd and keyed differently from the absolute spelling of the same home."""
+    import hermes_cli.local_work as module
+    monkeypatch.setattr(module, "_HOME_KEYS", {})
+    user_home, elsewhere = tmp_path / "user", tmp_path / "elsewhere"
+    (user_home / "h").mkdir(parents=True)
+    (elsewhere / "~" / "h").mkdir(parents=True)  # the wrong answer exists too
+    monkeypatch.setenv("HOME", str(user_home))
+    monkeypatch.chdir(elsewhere)
+    expected = os.path.normcase(os.path.realpath(user_home / "h"))
+    assert module.canonical_home("~/h") == expected
+    assert module.canonical_home("~/h") == module.canonical_home(str(user_home / "h"))
+
+
+def test_canonical_home_resolves_a_relative_bytes_spelling_against_the_cwd(tmp_path, monkeypatch):
+    """A relative bytes spelling is joined onto ``os.getcwdb()`` and keeps a bytes key; joining
+    it onto the str ``os.getcwd()`` raised TypeError."""
+    import hermes_cli.local_work as module
+    monkeypatch.setattr(module, "_HOME_KEYS", {})
+    (tmp_path / "a" / "rel").mkdir(parents=True)
+    monkeypatch.chdir(tmp_path / "a")
+    expected = os.path.normcase(os.fsencode(os.path.realpath(tmp_path / "a" / "rel")))
+    assert module.canonical_home(b"rel") == expected
+
+
 def test_install_is_explicit_and_snapshot_is_detached(tmp_path, monkeypatch):
     import hermes_cli.local_work as module
     monkeypatch.setattr(module, "_registry", None)
