From 2704c529293195ef58615fde9486fe8f2571ca9e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 04:45:06 -0800
Subject: [PATCH] fix(ci): accept migrated Blacksmith sync suite evidence
 [daveey]

---
 scripts/ci/upstream_sync.py            |  7 ++++---
 tests/scripts/ci/test_upstream_sync.py | 22 +++++++++++++++++++++-
 2 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/scripts/ci/upstream_sync.py b/scripts/ci/upstream_sync.py
index c20b1851ad5..e5166454651 100644
--- a/scripts/ci/upstream_sync.py
+++ b/scripts/ci/upstream_sync.py
@@ -6,8 +6,8 @@
 
 A candidate X (a commit that brings upstream/main commits into the fork) is pushed to its own
 branch ``sync/upstream-<X>``. ``.github/workflows/upstream-sync.yml`` runs the full suite there
-(all eight Python slices and e2e, self-hosted, never cancelled by main's concurrency). Only an X whose
-run completed green, with every required job succeeding on a self-hosted runner at exactly X, is
+(all eight Python slices and e2e, on fork runners, never cancelled by main's concurrency). Only an X whose
+run completed green, with every required job succeeding on an approved fork runner at exactly X, is
 landed through a pull request from that same branch. main is protected for admins too: GitHub
 refuses any direct push whose exact sha lacks a green "All required checks pass (v2)" (ci.yaml).
 The gate opens (or reuses) the PR, waits across calls until that check is green on exactly X, then
@@ -147,7 +147,8 @@ def _jobs_green(gh_repo, run_id, request) -> bool:
     jobs = {job["name"].rsplit(" / ", 1)[-1]: job for page in pages for job in page["jobs"]}
     return all(name in jobs and jobs[name]["status"] == "completed"
                and jobs[name]["conclusion"] == "success"
-               and "self-hosted" in (jobs[name].get("labels") or []) and jobs[name].get("runner_name")
+               and {"self-hosted", "blacksmith-4vcpu-ubuntu-2404"}.intersection(jobs[name].get("labels") or [])
+               and jobs[name].get("runner_name")
                for name in REQUIRED_JOBS)
 
 
diff --git a/tests/scripts/ci/test_upstream_sync.py b/tests/scripts/ci/test_upstream_sync.py
index d6126544e35..5aa83dc2add 100644
--- a/tests/scripts/ci/test_upstream_sync.py
+++ b/tests/scripts/ci/test_upstream_sync.py
@@ -272,7 +272,25 @@ def test_moved_main_gets_a_non_forced_merge_of_the_tested_head(world):
     assert parents == [moved, head]  # main kept, tested head merged, nothing rewritten
 
 
-@pytest.mark.parametrize("fault", ["missing", "skipped", "hosted", "no-runner"])
+def test_migrated_blacksmith_full_suite_can_land(world):
+    root, checkout = world
+    upstream_commit(root, {"u.txt": "u\n"}, "upstream")
+    head = merge_upstream(checkout)
+    before = main_of(root)
+    actions = FakeActions(root / "origin.git", root)
+    gate(checkout, head, actions)
+    actions.ci()
+
+    def migrated(jobs):
+        for job in jobs:
+            job["labels"] = ["blacksmith-4vcpu-ubuntu-2404"]
+            job["runner_name"] = "blacksmith-4vcpu-ubuntu-2404-fixture"
+    actions.job_override = migrated
+    assert gate(checkout, head, actions) == sync.LANDED
+    assert landed_by_merge(root, head, before)
+
+
+@pytest.mark.parametrize("fault", ["missing", "skipped", "hosted", "no-runner", "unknown-blacksmith"])
 def test_incomplete_job_evidence_cannot_land(world, fault):
     root, checkout = world
     upstream_commit(root, {"u.txt": "u\n"}, "upstream")
@@ -289,6 +307,8 @@ def test_incomplete_job_evidence_cannot_land(world, fault):
             jobs[-1]["conclusion"] = "skipped"
         elif fault == "hosted":
             jobs[-1]["labels"] = ["ubuntu-latest"]
+        elif fault == "unknown-blacksmith":
+            jobs[-1]["labels"] = ["blacksmith-unapproved"]
         else:
             jobs[-1]["runner_name"] = None
     actions.job_override = corrupt
-- 
2.55.0

