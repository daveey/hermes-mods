From ac65bb81a186bb2aead93c6c49d3ce39591eb953 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 07:07:27 +0000
Subject: [PATCH] fix(tests): await managed worker warning publication [daveey]

---
 tests/gateway/test_managed_worker_lineage.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/tests/gateway/test_managed_worker_lineage.py b/tests/gateway/test_managed_worker_lineage.py
index 7c88c1d89eb..568c51d1990 100644
--- a/tests/gateway/test_managed_worker_lineage.py
+++ b/tests/gateway/test_managed_worker_lineage.py
@@ -76,6 +76,10 @@ def test_worker_lineage_and_settlement(tmp_path, mode, invariant):
                 await async_wait_until(lambda: query('SELECT status FROM session_admissions') == [('unknown',)],
                                        timeout=30, interval=.02, what='failed worker admission unknown')
                 assert peer.requests == []
+                # Admission settlement and queued file logging publish independently.
+                await async_wait_until(
+                    lambda: 'Managed worker lost: managed_worker_failed' in (home / 'logs/errors.log').read_text(),
+                    timeout=30, interval=.02, what='managed worker failure warning written')
                 errors = (home / 'logs/errors.log').read_text()
                 assert 'Managed worker lost: managed_worker_failed' in errors
                 assert 'invalid_worker_frame' not in errors
