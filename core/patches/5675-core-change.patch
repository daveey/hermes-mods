From a1b4584d86366feec26afbd1a63f1dde1e8b6372 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 00:22:15 +0000
Subject: [PATCH] test(kanban): assert module-first courier profile environment
 [daveey]

---
 tests/hermes_cli/test_card_answer_courier_integration.py | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/tests/hermes_cli/test_card_answer_courier_integration.py b/tests/hermes_cli/test_card_answer_courier_integration.py
index 6ea085fea2..57c86dd834 100644
--- a/tests/hermes_cli/test_card_answer_courier_integration.py
+++ b/tests/hermes_cli/test_card_answer_courier_integration.py
@@ -138,11 +138,13 @@ class World:
 
     def runner(self, name):
         def run(cfg, argv, stdin=None, **kw):  # runs the real runtime main in this host
-            assert argv[:4] == ["-p", self.profile[name][0], "--run-module", "hermes_cli.kanban_card_answer_runtime"]
+            assert argv[:2] == ["--run-module", "hermes_cli.kanban_card_answer_runtime"]
+            assert kw['env']['HERMES_PROFILE'] == self.profile[name][0]
+            assert kw['env']['HERMES_HOME'] == str(self.homes[name])
             out = io.StringIO()
             with contextlib.redirect_stdout(out):
-                rc = runtime.main(argv[4:])
-            self.runs.append((name, argv[4], rc, json.loads(out.getvalue())))
+                rc = runtime.main(argv[2:])
+            self.runs.append((name, argv[2], rc, json.loads(out.getvalue())))
             return rc, out.getvalue(), ""
         return run
 
-- 
