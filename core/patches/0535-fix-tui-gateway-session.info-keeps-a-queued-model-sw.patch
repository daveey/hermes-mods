From 3458007706af0c4c83e17b16e3437d18d72766fc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 15:50:18 -0700
Subject: [PATCH] fix(tui-gateway): session.info keeps a queued model switch's
 provider; goal tests stop faking Path.home [daveey]

CI run 40582043662 (main @ 42b8d9b755) failed 7 tests in both Python shards.

session.info provider (test_session_info_reports_pending_model_switch: 'openai' == 'anthropic')
  Why 1: _session_info ends with info.update(credential_failure_fields(provider, ...)).
  Why 2: that dict carries "provider" = the live agent's provider, so it overwrote the queued
    switch's display_provider that _session_info had just put in info["provider"].
  Why 3: 42b8d9b755 added the merge to every session.info with a live agent, and
    credential_failure_fields shares the "provider" key with session.info's own identity field.
  Why not caught: the commit's tests (test_credential_failure.py) cover the fields alone, not the
    merge into session.info. The existing pending-switch test caught it in CI, after the commit
    reached main.
  Fix: merge the failure fields except "provider". The two values only differ while a switch is
    queued, and then the next turn runs on the queued provider.

Goal and session-control tests (5x "Refusing to touch real user auth store ... <tmp>/.hermes/auth.json")
  Why 1: _session_info now reads the credential pool (read_credential_pool -> _auth_file_path) on
    every settled turn, so goal-judge turns in these tests reach the auth store.
  Why 2: the seat belt compares HERMES_HOME/auth.json to Path.home()/.hermes/auth.json.
  Why 3: the hermes_home fixtures in test_goal_command.py and test_session_control.py set
    Path.home() = tmp_path AND HERMES_HOME = tmp_path/.hermes, so their isolated store looks
    exactly like "the real user store" to the seat belt.
  Why 4: the patch was redundant. tests/conftest.py already isolates HERMES_HOME and keeps
    Path.home() intact on purpose, and these fixtures never touched the auth store until 42b8d9b755.
  Fix: drop the Path.home patch from both fixtures (the guard is unchanged). Faking Path.home also
    blinds the seat belt in the other direction: it can no longer see the real ~/.hermes.

test_exit_cleanup_kills_foreground_command_still_running ("foreground command survived exit cleanup")
  Evidence: passes on macOS and on the Linux hub (alone and with its neighbours). In CI it failed
  only on ec2-gwgen3-* runners between 20:57 and 21:14 UTC (runs 40582043662, 40584874610, retry
  included), and passed at 21:37 on ec2-f18cf3g2-stable-1 for 8ef1dfe016, which contains the same
  code. No process code changed between the last green run (b23ad074be) and the failure. Each
  failing attempt finished in ~17 s, i.e. cleanup returned without the 1 s TERM grace.
  Why 1 (shown by timing): kill_live_foreground_processes did no TERM->KILL for the registered command.
  Why 2 (not provable from CI output): either the registry was empty or _kill_process raised.
    _quiet_kill swallows that exception at debug, so the CI log has no trace.
  Process gap: a failed exit-time kill, which orphans a tree to init, left no evidence at the
  default log level.
  Fix: the graceful path logs that failure at WARNING (the hard-exit path stays at debug, since it
  may run in a signal handler). The test adds the captured logs to its failure message. A new test
  pins the warning.

Verified: scripts/run_tests.sh on the four files, 720 passed on Linux (hermes-hub, clean clone at
98906dadc7 plus this patch) and 718 passed + 2 skipped on macOS. The 5 auth-guard failures were
reproduced on Linux before the fix.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/tools/test_local_interrupt_cleanup.py | 22 +++++++++++++++++++--
 tests/tui_gateway/test_goal_command.py      |  2 --
 tests/tui_gateway/test_session_control.py   |  1 -
 tools/environments/base.py                  |  8 +++++---
 tui_gateway/server.py                       |  5 +++--
 5 files changed, 28 insertions(+), 10 deletions(-)

diff --git a/tests/tools/test_local_interrupt_cleanup.py b/tests/tools/test_local_interrupt_cleanup.py
index b33aa74a9a..77a66379ae 100644
--- a/tests/tools/test_local_interrupt_cleanup.py
+++ b/tests/tools/test_local_interrupt_cleanup.py
@@ -214,7 +214,7 @@ def _descendant_running(marker: str):
     return None
 
 
-def test_exit_cleanup_kills_foreground_command_still_running(monkeypatch):
+def test_exit_cleanup_kills_foreground_command_still_running(monkeypatch, caplog):
     """The host-exit funnel (CLI, one-shot, messaging gateway, serve atexit) must take an
     in-flight foreground command's process group with it: it runs in its own session, so
     the host exiting mid-command would otherwise orphan it to init."""
@@ -235,7 +235,8 @@ def test_exit_cleanup_kills_foreground_command_still_running(monkeypatch):
         terminal_tool_lifecycle.cleanup_all_environments()
 
         assert _wait_for_pgid_exit(pgid, timeout=15.0), (
-            f"foreground command survived exit cleanup:\n{_process_group_snapshot(pgid)}")
+            f"foreground command survived exit cleanup:\n{_process_group_snapshot(pgid)}\n"
+            f"logs:\n{caplog.text}")
         t.join(timeout=15.0)
         assert not t.is_alive() and result.get("returncode") not in (None, 0), result
     finally:
@@ -314,3 +315,20 @@ def test_hard_exit_kill_never_blocks_on_a_slow_remote_cancel(monkeypatch):
     base.kill_live_foreground_processes(now=True)
     elapsed = time.monotonic() - t0
     assert cancelled.is_set() and elapsed < 1.0, f"blocked {elapsed:.2f}s"
+
+
+def test_failed_exit_cleanup_kill_is_logged_as_a_warning(monkeypatch, caplog):
+    """A graceful exit-time kill that raises orphans the command's tree, so it must be visible
+    at the default log level, not only under debug."""
+    from tools.environments import base
+
+    class _BrokenEnv:
+        def _kill_process(self, proc):
+            raise RuntimeError("kill exploded")
+
+    handle = object()
+    monkeypatch.setitem(base._live_foreground, id(handle), (_BrokenEnv(), handle))
+    with caplog.at_level("WARNING", logger=base.logger.name):
+        assert base.kill_live_foreground_processes() == 1
+    assert any(r.levelname == "WARNING" and "exit-time kill" in r.getMessage() and r.exc_info
+               for r in caplog.records), caplog.text
diff --git a/tests/tui_gateway/test_goal_command.py b/tests/tui_gateway/test_goal_command.py
index 22ac870f87..4dff282fa9 100644
--- a/tests/tui_gateway/test_goal_command.py
+++ b/tests/tui_gateway/test_goal_command.py
@@ -13,7 +13,6 @@ from __future__ import annotations
 import importlib
 import threading
 import types
-from pathlib import Path
 from unittest.mock import MagicMock, patch
 
 import pytest
@@ -23,7 +22,6 @@ import pytest
 def hermes_home(tmp_path, monkeypatch):
     home = tmp_path / ".hermes"
     home.mkdir()
-    monkeypatch.setattr(Path, "home", lambda: tmp_path)
     monkeypatch.setenv("HERMES_HOME", str(home))
 
     # Bust the goal-module DB cache so it re-resolves HERMES_HOME.
diff --git a/tests/tui_gateway/test_session_control.py b/tests/tui_gateway/test_session_control.py
index 27ae37c6c8..4bb28b9005 100644
--- a/tests/tui_gateway/test_session_control.py
+++ b/tests/tui_gateway/test_session_control.py
@@ -18,7 +18,6 @@ def hermes_home(tmp_path, monkeypatch):
     """Give the persisted control managers an isolated database for every test."""
     home = tmp_path / ".hermes"
     home.mkdir()
-    monkeypatch.setattr("pathlib.Path.home", lambda: tmp_path)
     monkeypatch.setenv("HERMES_HOME", str(home))
     from hermes_cli import goals
 
diff --git a/tools/environments/base.py b/tools/environments/base.py
index 0a3cc4c3d2..9e20750cf8 100644
--- a/tools/environments/base.py
+++ b/tools/environments/base.py
@@ -85,11 +85,11 @@ def _leave_foreground_spawn(env: "BaseEnvironment", spawned) -> bool:
         return _exit_fenced
 
 
-def _quiet_kill(kill: Callable, proc) -> None:
+def _quiet_kill(kill: Callable, proc, log: Callable = logger.debug) -> None:
     try:
         kill(proc)
     except Exception:
-        logger.debug("exit-time kill of a foreground command failed", exc_info=True)
+        log("exit-time kill of a foreground command failed", exc_info=True)
 
 
 def kill_live_foreground_processes(*, now: bool = False) -> int:
@@ -105,7 +105,9 @@ def kill_live_foreground_processes(*, now: bool = False) -> int:
         with _live_foreground_cond:
             live = list(_live_foreground.values())
         for env, proc in live:
-            _quiet_kill(env._kill_process, proc)
+            # A failed kill here orphans the command's tree to init, so it must leave a trace. The
+            # hard-exit path below stays at debug: it may run in a signal handler (logging locks).
+            _quiet_kill(env._kill_process, proc, logger.warning)
         return len(live)
     deadline = time.monotonic() + _HARD_KILL_BUDGET_S
     _exit_fenced = True
diff --git a/tui_gateway/server.py b/tui_gateway/server.py
index 9c64c2a170..2c8867c2b4 100644
--- a/tui_gateway/server.py
+++ b/tui_gateway/server.py
@@ -2445,8 +2445,9 @@ def _session_info(agent, session: dict | None = None) -> dict:
     if live_agent and (warn := _probe_credentials(agent)):
         from tui_gateway.credential_failure import credential_failure_fields
         with _session_profile_runtime_scope(sess):
-            info.update(credential_failure_fields(
-                provider, pool=getattr(agent, "_credential_pool", None)))
+            failure = credential_failure_fields(provider, pool=getattr(agent, "_credential_pool", None))
+        # Its "provider" is the live one; a queued switch must keep showing as the session's provider.
+        info.update({k: v for k, v in failure.items() if k != "provider"})
         info["credential_warning"] = (
             f"All configured credentials for '{provider}' are rate limited or out of quota."
             if info["failure_kind"] == "exhausted" else warn)
