From 0bc9716305a22613f04506ee862ed0be7dcb5bf1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 08:40:10 +0000
Subject: [PATCH] [daveey] test(selfwork): make oldest guard ordering
 deterministic

Choose an oldest owner that is neither first inserted nor lexically smallest. Proof: 32 guard tests pass; replacing ORDER BY created_at,id with id alone fails test_oldest_open_guard_owner_receives (21 passed, 1 failed). No production change.
---
 tests/hermes_cli/test_kanban_selfwork_guards.py | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_selfwork_guards.py b/tests/hermes_cli/test_kanban_selfwork_guards.py
index f23c6d64eb..54322dd19f 100644
--- a/tests/hermes_cli/test_kanban_selfwork_guards.py
+++ b/tests/hermes_cli/test_kanban_selfwork_guards.py
@@ -106,8 +106,10 @@ def test_malformed_switch_does_not_unfreeze(board, settings, bad):
 
 
 def test_oldest_open_guard_owner_receives(board, settings):
-    older, newer = seed(board), seed(board)
-    board.execute('UPDATE tasks SET created_at=100 WHERE id=?', (older,))
-    board.execute('UPDATE tasks SET created_at=200 WHERE id=?', (newer,))
+    owners = [seed(board) for _ in range(3)]
+    # Neither insertion order nor lexical task-id order may select the oldest.
+    oldest = next(tid for tid in owners if tid != owners[0] and tid != min(owners))
+    for tid in owners:
+        board.execute('UPDATE tasks SET created_at=? WHERE id=?', (100 if tid == oldest else 200, tid))
     board.commit()
-    assert admit(board)['task_id'] == older
+    assert admit(board)['task_id'] == oldest
