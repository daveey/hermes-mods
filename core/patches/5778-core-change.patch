+def _mail_gateway(cfg: Path) -> str:
+    """The gateway name the hermes-mail config carries; "" when it has none or cannot be read."""
+    try:
+        return str(json.loads(cfg.read_text(encoding="utf-8-sig")).get("gateway") or "")
