From 5e206f07aa5ffbcfef3c0c5d99976ab35a1420da Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 01:12:11 +0000
Subject: [PATCH] fix(tests): regenerate prompt surface for session_move and
 browser tab close

59009a4979 added the session_move tool without re-rendering
tests/fixtures/prompt_surface, and 410bb33433 added the close_tab
sentence to browser_exec. test_committed_prompt_surface_is_current
fails on both. Re-rendered hermetically (TMPDIR outside the home
tree); the diff is session_move.json, that tool on every surface,
and the close_tab sentence in browser_exec.json.
---
diff --git a/tests/fixtures/prompt_surface/tools/session_move.json b/tests/fixtures/prompt_surface/tools/session_move.json
new file mode 100644
index 0000000000000000000000000000000000000000..d46935e3eaf9bf5c5f4567f45078995fdab65089
--- /dev/null
+++ b/tests/fixtures/prompt_surface/tools/session_move.json
@@ -0,0 +1,21 @@
+{
+  "description": "Move THIS chat to another gateway (machine) after the current turn ends, e.g. when the work needs files, devices or tools that only exist there. The chat's whole history is copied, the other gateway becomes its owner and the copy here is archived; the user reopens the chat on the target. Only targets listed in sessions.move.hosts are allowed. Say what will happen and why before calling it; the move starts once this turn is over.",
+  "name": "session_move",
+  "parameters": {
+    "properties": {
+      "reason": {
+        "description": "Why this chat must move (recorded with the move)",
+        "type": "string"
+      },
+      "to": {
+        "description": "Target gateway name (a key of sessions.move.hosts)",
+        "type": "string"
+      }
+    },
+    "required": [
+      "to",
+      "reason"
+    ],
+    "type": "object"
+  }
+}
-- 
2.55.0

