diff --git a/tests/hermes_cli/test_core_update_progress.py b/tests/hermes_cli/test_core_update_progress.py
new file mode 100644
index 00000000000..10f9e75ad64
--- /dev/null
+++ b/tests/hermes_cli/test_core_update_progress.py
@@ -0,0 +1,86 @@
+"""Desktop's version pill reads the host's background core update through one route. [daveey]
+
+example-gw 2020-01-01: hermes-sync drained for 12 min before applying and Desktop showed nothing but
+"Waiting for a Hermes update" on the held message. ``GET /api/hermes/update/progress`` now reports the
+published window (``cache/core-update/window.json``), the drainer's cap (``drain.json``) and what the
+latest deferral waited on (``governor-other-defers.json``); anything unusable is ``null``, never an error.
+"""
+import asyncio
+import json
+import socket
+
+import pytest
+
+from hermes_cli import core_update_progress as cup
+
+NOW = 1_795_131_600
+
+
+@pytest.fixture
+def cu(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    (home / "cache" / "core-update").mkdir(parents=True)
+    monkeypatch.setattr("pathlib.Path.home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    return home / "cache" / "core-update"
+
+
+def window(cu, **changes):
+    data = dict(version=1, host=socket.gethostname().split(".")[0], observed_at=NOW - 5,
+                window_at=NOW - 701, state="draining", state_since=NOW - 701, drain_bound_s=7200,
+                last_update_at=NOW - 5000, writer="drainer")
+    data.update(changes)
+    (cu / "window.json").write_text(json.dumps(data))
+
+
+def test_draining_reports_elapsed_cap_and_what_it_waits_on(cu):
+    window(cu)
+    (cu / "drain.json").write_text(json.dumps({"pid": 1, "state": "draining", "total_cap_s": 60.0}))
+    reasons = [f"default:2026111{i}_000000_aaaaa{i}" for i in range(10)]
+    (cu / "governor-other-defers.json").write_text(json.dumps({"ts": NOW - 30, "reasons": reasons}))
+    assert cup.read_progress(NOW) == {
+        "state": "draining", "due_at": NOW - 701, "state_since": NOW - 701, "elapsed_s": 701.0,
+        "cap_s": 60.0, "waiting_on": reasons[:cup.MAX_WAITING_ON]}
+
+
+def test_applying_has_no_waiting_list_and_batching_is_due_in_the_future(cu):
+    window(cu, state="applying")
+    (cu / "drain.json").write_text(json.dumps({"pid": 1, "state": "applying", "total_cap_s": 60.0}))
+    (cu / "governor-other-defers.json").write_text(json.dumps({"ts": NOW, "reasons": ["default:x"]}))
+    got = cup.read_progress(NOW)
+    assert (got["state"], got["waiting_on"], got["cap_s"]) == ("applying", [], 60.0)
+
+    window(cu, state="batching", window_at=NOW + 1860)
+    (cu / "drain.json").write_text(json.dumps({"pid": 1, "state": "idle", "total_cap_s": 60.0}))
+    got = cup.read_progress(NOW)
+    assert (got["state"], got["elapsed_s"], got["cap_s"]) == ("batching", -1860.0, None)
+
+
+@pytest.mark.parametrize("change", [
+    {"state": "idle"},                       # nothing owed
+    {"host": "some-other-host"},             # another host's record
+    {"observed_at": NOW - 3600},             # stale publisher
+    {"version": 2},                          # unknown schema
+    {"window_at": "soon"},                   # malformed
+])
+def test_unusable_window_is_no_progress(cu, change):
+    window(cu, **change)
+    assert cup.read_progress(NOW) is None
+
+
+def test_missing_files_and_stale_or_junk_side_records_degrade(cu):
+    assert cup.read_progress(NOW) is None
+    window(cu)
+    (cu / "drain.json").write_text("not json")
+    (cu / "governor-other-defers.json").write_text(json.dumps({"ts": NOW - 3600, "reasons": ["old"]}))
+    got = cup.read_progress(NOW)
+    assert (got["state"], got["cap_s"], got["waiting_on"]) == ("draining", None, [])
+
+
+def test_route_serves_the_reader(cu, monkeypatch):
+    from hermes_cli.web_routers import actions
+
+    monkeypatch.setattr("time.time", lambda: NOW)
+    assert asyncio.run(actions.hermes_update_progress()) == {"progress": None}
+    window(cu)
+    assert asyncio.run(actions.hermes_update_progress())["progress"]["state"] == "draining"
diff --git a/tests/tui_gateway/test_hold_queue_marker_sibling.py b/tests/tui_gateway/test_hold_queue_marker_sibling.py
new file mode 100644
index 00000000000..95a4fcef1de
--- /dev/null
+++ b/tests/tui_gateway/test_hold_queue_marker_sibling.py
@@ -0,0 +1,58 @@
+"""A message queued behind the update hold never replaces a live sibling backend's turn marker. [daveey]
+
+hermes-sync skips ``update_hold_queue`` markers as "not running" (a queued message waits FOR the update; counting
+it deadlocked the hub's drain on 2020-01-01). With two backends on one HERMES_HOME (#00000), backend A can be
+mid-turn on session S while the user's message reaches backend B, where S is idle and the hold refuses it. B's
+hold-queue marker used to replace A's live-turn marker under the same key, so the drain stopped seeing A's turn.
+"""
+import json
+import subprocess
+import sys
+
+import pytest
+
+from tui_gateway.turn_marker import UPDATE_HOLD_QUEUE_REASON, read_turn_marker, record_turn_start
+
+
+@pytest.fixture
+def sibling():
+    proc = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(60)"])
+    yield proc.pid
+    proc.kill()
+    proc.wait()
+
+
+def _seed(home, entry):
+    (home / "desktop").mkdir(parents=True, exist_ok=True)
+    (home / "desktop" / "interrupted_turns.json").write_text(json.dumps({"S": entry}))
+
+
+def test_hold_queue_marker_keeps_a_live_siblings_running_turn(tmp_path, sibling):
+    import time
+    _seed(tmp_path, {"attempts": 0, "prompt": "A's turn", "started_at": time.time(), "auto_continue": True,
+                     "writer_pid": sibling})
+    assert record_turn_start(tmp_path, "S", "queued on B", reason=UPDATE_HOLD_QUEUE_REASON) is False
+    kept = read_turn_marker(tmp_path, "S")
+    assert (kept["writer_pid"], kept.get("reason"), kept["prompt"]) == (sibling, None, "A's turn")
+
+
+def test_hold_queue_marker_still_replaces_dead_paused_or_own_markers(tmp_path):
+    import os
+    import time
+    dead = subprocess.Popen([sys.executable, "-c", "pass"])
+    dead.wait()
+    for prior in ({"writer_pid": dead.pid},                                        # crashed writer
+                  {"writer_pid": os.getpid()},                                     # this backend's own
+                  {"writer_pid": os.getpid() + 0, "reason": "core_update_pause"}):  # a paused turn
+        _seed(tmp_path, {"attempts": 0, "prompt": "old", "started_at": time.time(), "auto_continue": True, **prior})
+        assert record_turn_start(tmp_path, "S", "queued", reason=UPDATE_HOLD_QUEUE_REASON) is True
+        got = read_turn_marker(tmp_path, "S")
+        assert (got["reason"], got["prompt"], got["writer_pid"]) == (UPDATE_HOLD_QUEUE_REASON, "queued", os.getpid())
+
+
+def test_a_normal_turn_start_is_unchanged(tmp_path, sibling):
+    import time
+    _seed(tmp_path, {"attempts": 0, "prompt": "A's turn", "started_at": time.time(), "auto_continue": True,
+                     "writer_pid": sibling})
+    assert record_turn_start(tmp_path, "S", "B runs") is True
+    assert read_turn_marker(tmp_path, "S")["prompt"] == "B runs"
