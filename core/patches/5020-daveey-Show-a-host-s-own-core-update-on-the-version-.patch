+      $desktopVersion.set(desktop)
+      $updateStatus.set({ behind: 0, supported: true })
+      $clientUpdateProgress.set({
+        state: 'draining',
+        elapsedS: 30,
+        capS: 60,
+        waitingOn: ['default:s1'],
