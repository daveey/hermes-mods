+    "assistant.thread.errorCodes.session_turn_lease_lost.title",
     "assistant.thread.errorCodes.ssl_cert_verification.body",
     "assistant.thread.errorCodes.ssl_cert_verification.title",
     "assistant.thread.errorCodes.stream_drop.body",
