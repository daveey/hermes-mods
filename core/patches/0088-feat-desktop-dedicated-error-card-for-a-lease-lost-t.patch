From cd0a76798c64286129715dd7b2a2598b32c58629 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 15 Oct 2026 12:16:35 -0700
Subject: [PATCH] feat(desktop): dedicated error card for a lease-lost turn
 [daveey]

The backend now reports a turn stopped by session_turn_lease_lost as a
retryable failure with code session_turn_lease_lost. Without its own entry the
card fell back to the gateway layer's 'Hermes hit an internal problem' copy.
It now says Hermes stopped the reply because another process took over the
chat, that the work is kept, and offers Retry. Translated in en/de/es/fr;
ar/ja/ru/zh/zh-hant are listed in overlay-gaps next to their neighbours.
---
diff --git a/apps/desktop/src/i18n/de.ts b/apps/desktop/src/i18n/de.ts
index 7efdc6b2be28e094fbf1b08419517195f2f04bc1..32c8c63d292fa218de48f9c1cf194279c76c4aa5 100644
--- a/apps/desktop/src/i18n/de.ts
+++ b/apps/desktop/src/i18n/de.ts
@@ -4968,6 +4968,10 @@ export const deOverrides = {
           title: 'Hermes ist in einer Schleife hängen geblieben',
           body: 'Die Antwort hat dieselben Schritte wiederholt, daher hat Hermes sie gestoppt. Versuchen Sie es erneut oder starten Sie einen neuen Chat, wenn es wieder passiert.'
         },
+        session_turn_lease_lost: {
+          title: 'Hermes hat diese Antwort angehalten',
+          body: 'Ein anderer Hermes-Prozess hat diesen Chat übernommen, während die Antwort lief. Hermes hat sie angehalten, um das Protokoll zu schützen. Bereits erledigte Arbeit bleibt erhalten. Wiederhole den Vorgang, um sie erneut auszuführen.'
+        },
         SESSION_NOT_OWNED: {
           title: 'Dieser Chat ist woanders offen',
           body: 'Dieser Chat ist in einem anderen Hermes-Fenster oder Terminal geöffnet. Übernehmen Sie ihn hier, oder starten Sie einen neuen Chat.'
diff --git a/apps/desktop/src/i18n/es.ts b/apps/desktop/src/i18n/es.ts
index 48e0b3abda9f2b8d7ae1bd943ede291c42a4a036..807ef31381928375146bc5d0c8f6b1dec1e5c104 100644
--- a/apps/desktop/src/i18n/es.ts
+++ b/apps/desktop/src/i18n/es.ts
@@ -4952,6 +4952,10 @@ export const esOverrides = {
           title: 'Hermes se quedó atascado en un bucle',
           body: 'La respuesta repetía los mismos pasos, así que Hermes la detuvo. Reinténtalo o empieza un chat nuevo si vuelve a ocurrir.'
         },
+        session_turn_lease_lost: {
+          title: 'Hermes detuvo esta respuesta',
+          body: 'Otro proceso de Hermes tomó este chat mientras la respuesta estaba en curso, así que Hermes la detuvo para proteger la transcripción. El trabajo hecho antes de la detención se conserva. Reintenta para ejecutarla de nuevo.'
+        },
         SESSION_NOT_OWNED: {
           title: 'Este chat está abierto en otro sitio',
           body: 'Este chat está abierto en otra ventana de Hermes o en un terminal. Continúalo aquí o empieza un chat nuevo.'
diff --git a/apps/desktop/src/i18n/fr.ts b/apps/desktop/src/i18n/fr.ts
index d4b7385f4ab40b0b83b7589874e08708fabbce15..3d3b6f63c04c30844a7c2d180616c3f1f63f94d7 100644
--- a/apps/desktop/src/i18n/fr.ts
+++ b/apps/desktop/src/i18n/fr.ts
@@ -4974,6 +4974,10 @@ export const frOverrides = {
           title: 'Hermes est resté bloqué dans une boucle',
           body: 'La réponse répétait les mêmes étapes ; Hermes l’a donc arrêtée. Réessayez ou démarrez une nouvelle conversation.'
         },
+        session_turn_lease_lost: {
+          title: 'Hermes a arrêté cette réponse',
+          body: 'Un autre processus Hermes a repris cette conversation pendant la réponse, donc Hermes l\'a arrêtée pour protéger la transcription. Le travail fait avant l\'arrêt est conservé. Réessayez pour la relancer.'
+        },
         SESSION_NOT_OWNED: {
           title: 'Cette conversation est ouverte ailleurs',
           body: 'Cette conversation est ouverte dans une autre fenêtre Hermes ou un terminal. Reprenez-la ici, ou démarrez-en une nouvelle.'
diff --git a/apps/desktop/src/i18n/overlay-gaps.json b/apps/desktop/src/i18n/overlay-gaps.json
index 1ad507aed4eb68a4e868bd8c141faff11153d90c..3b6574d1228fc11924b0933a246d1d516554f5b5 100644
--- a/apps/desktop/src/i18n/overlay-gaps.json
+++ b/apps/desktop/src/i18n/overlay-gaps.json
@@ -90,6 +90,8 @@
   "assistant.thread.errorCodes.invalid_response.title": ["ar","ru"],
   "assistant.thread.errorCodes.loop_error.body": ["ar","ja","ru","zh","zh-hant"],
   "assistant.thread.errorCodes.loop_error.title": ["ar","ja","ru","zh","zh-hant"],
+  "assistant.thread.errorCodes.session_turn_lease_lost.body": ["ar","ja","ru","zh","zh-hant"],
+  "assistant.thread.errorCodes.session_turn_lease_lost.title": ["ar","ja","ru","zh","zh-hant"],
   "assistant.thread.errorCodes.model_not_found.body": ["ar","ja","ru","zh","zh-hant"],
   "assistant.thread.errorCodes.model_not_found.title": ["ar","ja","ru","zh","zh-hant"],
   "assistant.thread.errorCodes.no_reply.body": ["ar","ja","ru","zh","zh-hant"],
diff --git a/apps/desktop/src/lib/error-surface-copy.test.ts b/apps/desktop/src/lib/error-surface-copy.test.ts
index 25f56f9cd493d603914d88cfb1d13690b470151b..359de486700fd52cf33350cd5739da69a87e138a 100644
--- a/apps/desktop/src/lib/error-surface-copy.test.ts
+++ b/apps/desktop/src/lib/error-surface-copy.test.ts
@@ -92,3 +92,15 @@ it('keeps the generic owner copy for an older backend that names no machine', ()
   )
   expect(sessionNotOwnedSurface('no details at all').owner).toBeUndefined()
 })
+
+// [daveey] A turn the backend stopped because another owner claimed its session lease gets its own
+// card (not the generic "internal problem" gateway copy), and Retry stays on.
+it('renders a lease-lost turn with its own card and a retry', async () => {
+  const { errorRecoveryPlan } = await import('./error-surface')
+  const surface = parseErrorSurface({ layer: 'gateway', code: 'session_turn_lease_lost', retryable: true })
+  const copy = errorCardText(TRANSLATIONS.en.assistant.thread, surface)
+  expect(copy.title).toBe('Hermes stopped this reply')
+  expect(copy.body).toContain('took over this chat')
+  expect(copy.title).not.toBe(TRANSLATIONS.en.assistant.thread.errorLayers.gateway)
+  expect(errorRecoveryPlan(surface).retry).toBe(true)
+})
diff --git a/apps/desktop/src/lib/error-surface.ts b/apps/desktop/src/lib/error-surface.ts
index 2f08fcd4afbfa0fe0e501c0d459908d79fa1e6a4..5d92d97cc55eb1a2520af66159a7fff2b482578e 100644
--- a/apps/desktop/src/lib/error-surface.ts
+++ b/apps/desktop/src/lib/error-surface.ts
@@ -48,6 +48,9 @@ export const ERROR_CODE_KEYS = [
   'invalid_response',
   'empty_response',
   'loop_error',
+  // [daveey] The backend stopped the turn because another owner claimed its session lease
+  // (tui_gateway/prompt_turn._surface_system_interrupt). Retry re-runs it once the session is free.
+  'session_turn_lease_lost',
   'SESSION_NOT_OWNED',
   // The gateway that owns the chat is mid-turn and could not queue this send: transient.
   'SESSION_OWNER_BUSY',
-- 
