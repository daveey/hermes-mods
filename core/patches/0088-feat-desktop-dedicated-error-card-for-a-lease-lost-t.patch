diff --git a/apps/desktop/src/lib/error-surface-copy.test.ts b/apps/desktop/src/lib/error-surface-copy.test.ts
index 25f56f9cd4..359de48670 100644
--- a/apps/desktop/src/lib/error-surface-copy.test.ts
+++ b/apps/desktop/src/lib/error-surface-copy.test.ts
@@ -92,3 +92,15 @@ it('keeps the generic owner copy for an older backend that names no machine', ()
   )
   expect(sessionNotOwnedSurface('no details at all').owner).toBeUndefined()
 })
+
+// [daveey] A turn the backend stopped because another owner claimed its session lease gets its own
+// card (not the generic "internal problem" gateway copy), and Retry stays on.
+it('renders a lease-lost turn with its own card and a retry', async () => {
+  const { errorRecoveryPlan } = await import('./error-surface')
+  const surface = parseErrorSurface({ layer: 'gateway', code: 'session_turn_lease_lost', retryable: true })
+  const copy = errorCardText(TRANSLATIONS.en.assistant.thread, surface)
+  expect(copy.title).toBe('Hermes stopped this reply')
+  expect(copy.body).toContain('took over this chat')
+  expect(copy.title).not.toBe(TRANSLATIONS.en.assistant.thread.errorLayers.gateway)
+  expect(errorRecoveryPlan(surface).retry).toBe(true)
+})
diff --git a/apps/desktop/src/lib/error-surface.ts b/apps/desktop/src/lib/error-surface.ts
index e94f89bccf..f42c298037 100644
--- a/apps/desktop/src/lib/error-surface.ts
+++ b/apps/desktop/src/lib/error-surface.ts
@@ -48,6 +48,9 @@ export const ERROR_CODE_KEYS = [
   'invalid_response',
   'empty_response',
   'loop_error',
+  // [daveey] The backend stopped the turn because another owner claimed its session lease
+  // (tui_gateway/prompt_turn._surface_system_interrupt). Retry re-runs it once the session is free.
+  'session_turn_lease_lost',
   'SESSION_NOT_OWNED',
   'disk_full',
   // Raised by the desktop, never by the backend: the backend reported a turn
