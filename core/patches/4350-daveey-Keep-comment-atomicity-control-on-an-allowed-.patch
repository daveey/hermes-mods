From 930944842f640b791c6152341fcc00d101c0fe3c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:10:51 +0000
Subject: [PATCH] [daveey] Keep comment atomicity control on an allowed clock
 wait

---
 tests/hermes_cli/test_kanban_refused_op_comments.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_refused_op_comments.py b/tests/hermes_cli/test_kanban_refused_op_comments.py
index a23039bceb..4663b7723c 100644
--- a/tests/hermes_cli/test_kanban_refused_op_comments.py
+++ b/tests/hermes_cli/test_kanban_refused_op_comments.py
@@ -91,10 +91,10 @@ def test_successful_schedule_and_unblock_write_exactly_one_comment_each(kanban_h
         task = kb.get_task(conn, tid)
         assert task.status == "ready"
         kb.claim_task(conn, tid)
-    assert _cli("schedule", tid, "waiting", "on", "the", "soak", "--clock-only") == 0
+    assert _cli("schedule", tid, "waiting", "on", "the", "cooldown", "--clock-only") == 0
     with kbc.connect() as conn:
         assert kb.get_task(conn, tid).status == "scheduled"
-        assert _comments(conn, tid) == ["UNBLOCK: ask moved to t_feedface", "SCHEDULED: waiting on the soak"]
+        assert _comments(conn, tid) == ["UNBLOCK: ask moved to t_feedface", "SCHEDULED: waiting on the cooldown"]
         kinds = [r[0] for r in conn.execute(
             "SELECT kind FROM task_events WHERE task_id = ? AND kind IN ('commented', 'scheduled', 'unblocked') "
             "ORDER BY id", (tid,))]
-- 
