From 583a2ee9972cd79fc77c19bd3608d1695e29ae7b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 08:01:39 +0000
Subject: [PATCH] [daveey] kanban placement: annotate label_machines(label) as
 str | Iterable[str]

Nit 3 of PR #1908 review t_01a1d3cfae2d48b7: the parameter lost its str annotation when it began accepting a label set.
---
 hermes_cli/kanban_placement.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_placement.py b/hermes_cli/kanban_placement.py
index 93dbb53f32..2ce74b3949 100644
--- a/hermes_cli/kanban_placement.py
+++ b/hermes_cli/kanban_placement.py
@@ -89,7 +89,7 @@ import subprocess
 import threading
 import time
 from contextlib import contextmanager
-from typing import Callable, Iterator, Optional
+from typing import Callable, Iterable, Iterator, Optional
 
 from hermes_cli import kanban_capability_registry as reg
 
@@ -274,7 +274,7 @@ def route_labels(dest: str) -> list[str]:
     return [dest] if is_pool_label(dest) else [f"machine:{dest}"]
 
 
-def label_machines(label, machines: Optional[dict] = None) -> list[str]:
+def label_machines(label: str | Iterable[str], machines: Optional[dict] = None) -> list[str]:
     """Active, unheld registry machines that carry ``label`` (or every label of a list/set) and pick up other
     gateways' cards (sorted)."""
     from hermes_cli import kanban_worker_node as wn
-- 
