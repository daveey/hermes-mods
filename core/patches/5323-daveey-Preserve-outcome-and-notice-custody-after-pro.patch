+    out, calls = _run(db)
+    assert calls == [] and out[0]["msg_id"] == row and out[0]["result"] == "superseded"
+    assert ng.candidates(db, time.time())[0]["msg_id"] == older
+    assert so.get_outcome(CHAT, db=db)["reason"] == "notice_tail"
