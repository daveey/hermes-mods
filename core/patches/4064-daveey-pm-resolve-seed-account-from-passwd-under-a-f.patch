 pm/environments.py                            |  7 +++---
 scripts/bundles/desktop_toolchain.py          |  2 ++
 .../test_web_memory_provider_setup_install.py |  1 +
 tests/pm/conftest.py                          |  3 +++
 tests/pm/test_account_seed.py                 | 25 +++++++++++++++++++
 tests/pm/test_plugin_survival_contract.py     |  1 +
 tests/pm/test_startup_recovery.py             |  2 ++
 tests/pm/test_worker.py                       |  1 +
 tests/scripts/test_bundle_native.py           |  1 +
 9 files changed, 40 insertions(+), 3 deletions(-)

diff --git a/pm/environments.py b/pm/environments.py
index 4a24e5c6cd..5a76fec8f4 100644
--- a/pm/environments.py
+++ b/pm/environments.py
@@ -45,7 +45,8 @@ def account_seed_enabled() -> bool:
 def account_home_root() -> Path | None:
     """The account's default home when the active home is another one on its filesystem, else ``None``.
 
-    A test, review or mutation home (``HERMES_HOME=<scratch>``) then reuses the account's
+    A test, review or mutation home (``HERMES_HOME=<scratch>`` or ``HOME=<scratch>``)
+    reuses the passwd account's
     immutable, content-checked state (verified tool entries, uv's cache, source snapshots) by
     hard link instead of fetching and unpacking its own ~2 GiB copy. Another filesystem keeps
     the home's own state: a link cannot cross it.
@@ -56,11 +57,11 @@ def account_home_root() -> Path | None:
     and CI (whose cache save/restore and prune act on the uv cache path), set
     ``HERMES_PM_ACCOUNT_SEED=0`` (``ACCOUNT_SEED_ENV``) to keep every piece of state its own.
     """
-    from hermes_constants import _get_platform_default_hermes_home
+    from hermes_constants import account_default_hermes_home
 
     if not account_seed_enabled():
         return None
-    account = _get_platform_default_hermes_home()
+    account = account_default_hermes_home()
     active = dependency_home_root()
     while not active.exists() and active.parent != active:
         active = active.parent
diff --git a/scripts/bundles/desktop_toolchain.py b/scripts/bundles/desktop_toolchain.py
index 49bb9a4931..89a6440255 100644
--- a/scripts/bundles/desktop_toolchain.py
+++ b/scripts/bundles/desktop_toolchain.py
@@ -47,6 +47,8 @@ def bootstrap_environment(source: Path, work: Path, cache: Path,
         "LOCALAPPDATA": str(home / "AppData/Local"),
         "APPDATA": str(home / "AppData/Roaming"),
         "HERMES_HOME": str(work / "hermes-home"),
+        # Build-owned state must not borrow the invoking account's PM cache/seed.
+        "HERMES_PM_ACCOUNT_SEED": "0",
         "HERMES_RUNTIME_DIR": str(cache / "tools"),
         "HERMES_PYTHON_SRC_ROOT": str(source),
         "XDG_CONFIG_HOME": str(home / "config"), "XDG_CACHE_HOME": str(home / "cache"),
diff --git a/tests/hermes_cli/test_web_memory_provider_setup_install.py b/tests/hermes_cli/test_web_memory_provider_setup_install.py
