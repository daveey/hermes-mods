From 6325fbeac3c2f37a096f668ea74c29d60f5678c2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 16:42:16 -0800
Subject: [PATCH] fix(doctor): list state.db holders with their whole command
 line

describe_holder_pid cut every holder description at 80 characters, so
`hermes doctor` showed "PID 98920 (python3.14 -I -I -c <inline code>
/Users/me/.local/share/hermes-mail/hermes_)": the part that says what
the process is was cut off exactly where a person deciding what to stop
needs it. The function takes a limit now (default 80, kept for the log and
error lines that use it) and doctor's three holder lists (FTS deferral
advice, retired-WAL holders, platform lock holders) pass limit=None.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/doctor_platform.py                 |  2 +-
 hermes_cli/doctor_state.py                    |  4 +--
 hermes_state_holders.py                       | 10 +++---
 .../test_doctor_fts_deferral_holders.py       | 33 +++++++++++++++++++
 4 files changed, 42 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/doctor_platform.py b/hermes_cli/doctor_platform.py
index 836a2b5be7e..3eb3e2ede6b 100644
--- a/hermes_cli/doctor_platform.py
+++ b/hermes_cli/doctor_platform.py
@@ -113,7 +113,7 @@ def _report_database_holders(name: str, db_path: Path) -> None:
         else:
             by_pid.setdefault(pid, set()).add(Path(target.removesuffix(" (deleted)")).name)
     for pid in sorted(by_pid):
-        check_info(f"{name} is held by {describe_holder_pid(pid)}: {', '.join(sorted(by_pid[pid]))}")
+        check_info(f"{name} is held by {describe_holder_pid(pid, limit=None)}: {', '.join(sorted(by_pid[pid]))}")
     if unknown:
         check_warn(f"{name}: cannot prove the database is quiet",
                    f"(holder scan incomplete: {unknown[0][:120]}" + (f"; +{len(unknown) - 1} more" if len(unknown) > 1 else "") + ")")
diff --git a/hermes_cli/doctor_state.py b/hermes_cli/doctor_state.py
index 4af162363e9..1b665fe2e6d 100644
--- a/hermes_cli/doctor_state.py
+++ b/hermes_cli/doctor_state.py
@@ -98,7 +98,7 @@ def _live_state_db_holders(state_db_path: Path):
     pids = db_holder_pids(state_db_path)
     if pids is None:
         return None
-    return [(pid, describe_holder_pid(pid), _looks_like_gateway_process(pid)) for pid in pids if pid != os.getpid()]
+    return [(pid, describe_holder_pid(pid, limit=None), _looks_like_gateway_process(pid)) for pid in pids if pid != os.getpid()]
 
 
 def _render_state_db_stats(stats: dict, holders=None, host_note: str = "", live_holders=None) -> list:
@@ -516,7 +516,7 @@ def _retired_wal_holders(f: Finding, state_db_path: Path, _DHH: str) -> bool:
     pids = list(dict.fromkeys(pid for pid, _ in iter_deleted_sqlite_sidecar_holders(state_db_path)))
     if not pids:
         return False
-    rendered = ", ".join(describe_holder_pid(pid) for pid in pids)
+    rendered = ", ".join(describe_holder_pid(pid, limit=None) for pid in pids)
     check_warn(f"{_DHH}/state.db: {len(pids)} process(es) still hold a retired WAL generation ({rendered})",
                "(every new session refuses to open until they exit; health/stats probes skipped)")
     f.issues.append(f"state.db retired WAL generation held by {rendered}{host_gateway_note()} — stop the host "
diff --git a/hermes_state_holders.py b/hermes_state_holders.py
index 0e6f782fd51..dd1835d0b6d 100644
--- a/hermes_state_holders.py
+++ b/hermes_state_holders.py
@@ -57,8 +57,10 @@ def _read_proc_argv(pid: int) -> Optional[list[str]]:
         return None
 
 
-def describe_holder_pid(pid: int) -> str:
-    """``PID 123 (hermes gateway run)`` for operator-facing holder lists; /proc argv first, psutil elsewhere."""
+def describe_holder_pid(pid: int, *, limit: Optional[int] = 80) -> str:
+    """``PID 123 (hermes gateway run)`` for operator-facing holder lists; /proc argv first, psutil elsewhere.
+    The command line is cut to *limit* characters for log and error lines; ``None`` keeps all of it
+    (``hermes doctor``, whose holder lists are read by a person deciding what to stop)."""
     argv = _read_proc_argv(pid)
     if argv is None and psutil is not None:
         try:
@@ -69,9 +71,9 @@ def describe_holder_pid(pid: int) -> str:
         from gateway.status_inline_source import inline_source_flag_index
         at = inline_source_flag_index(argv)
         if at is not None and at + 1 < len(argv):
-            # An interpreter's inline source (launcher wrappers) would fill the 80 characters; its arguments follow.
+            # An interpreter's inline source (launcher wrappers) would fill the description; its arguments follow.
             argv = [*argv[:at + 1], "<inline code>", *argv[at + 2:]]
-    who = " ".join(" ".join([os.path.basename(argv[0]), *argv[1:]]).split())[:80] if argv else "command line unavailable"
+    who = " ".join(" ".join([os.path.basename(argv[0]), *argv[1:]]).split())[:limit] if argv else "command line unavailable"
     return f"PID {pid} ({who})"
 
 
diff --git a/tests/hermes_cli/test_doctor_fts_deferral_holders.py b/tests/hermes_cli/test_doctor_fts_deferral_holders.py
index 8958691bf58..a2e6dd9b173 100644
--- a/tests/hermes_cli/test_doctor_fts_deferral_holders.py
+++ b/tests/hermes_cli/test_doctor_fts_deferral_holders.py
@@ -134,3 +134,36 @@ def test_holder_description_keeps_a_non_python_dash_c():
     finally:
         proc.stdin.close()
         proc.wait(timeout=30)
+
+
+@pytest.mark.platforms("linux", "macos")
+def test_doctor_lists_holders_with_their_whole_command_line(tmp_path):
+    """Doctor's holder list is what a person reads to decide what to stop: no 80-character cut there,
+    while the default description (log and error lines) keeps it."""
+    from hermes_state_holders import describe_holder_pid
+
+    db_path = tmp_path / "state.db"
+    sqlite3.connect(str(db_path)).execute("CREATE TABLE t (x)").connection.close()
+    tail = "--profile " + "p" * 120 + " --the-end"
+    holder = subprocess.Popen(
+        [
+            sys.executable,
+            "-c",
+            "import sqlite3, sys; c = sqlite3.connect(sys.argv[1]); c.execute('select * from t');"
+            " print('ready', flush=True); sys.stdin.read()",
+            str(db_path),
+            *tail.split(),
+        ],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        text=True,
+    )
+    try:
+        assert holder.stdout.readline().strip() == "ready"
+        ((pid, desc, _is_gateway),) = _live_state_db_holders(db_path)
+        assert pid == holder.pid and desc.endswith(f"{db_path} {tail})"), desc
+        short = describe_holder_pid(holder.pid)
+        assert len(short) < len(desc) and "--the-end" not in short
+    finally:
+        holder.stdin.close()
+        holder.wait(timeout=30)
-- 
2.43.0

