From ad074af728d3cd0b370fbd2073113bf65f19432c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 22 Nov 2026 20:49:48 +0000
Subject: [PATCH] docs(kanban): bind classification evidence row revisions
 [daveey]

---
 tests/hermes_cli/test_kanban_classification_cas.py | 4 ++--
 website/docs/user-guide/features/kanban.md         | 9 ++++++---
 2 files changed, 8 insertions(+), 5 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_classification_cas.py b/tests/hermes_cli/test_kanban_classification_cas.py
index 4a4072592a..727f949c10 100644
--- a/tests/hermes_cli/test_kanban_classification_cas.py
+++ b/tests/hermes_cli/test_kanban_classification_cas.py
@@ -21,9 +21,9 @@ def args(tid, cas):
 
 def request(tid):
     return dict(client_op_id="correction-1", op="reclassify_parked", task=tid, expected_revision=1,
-                expected_event_uid="withdrawn-ask", expected_spend_episode="unchanged-stop",
+                expected_event_uid="withdrawn-ask", expected_event_version=2, expected_spend_episode="unchanged-stop",
                 expected_parents=["parent"], expected_parent_links=[dict(uid="parent>task", version=1)],
-                disposition_comment_uid="owner-disposition", reason="Keep parked")
+                disposition_comment_uid="owner-disposition", disposition_comment_version=3, reason="Keep parked")
 
 
 def parked():
diff --git a/website/docs/user-guide/features/kanban.md b/website/docs/user-guide/features/kanban.md
index 70b6e2810c..c6a9ced00d 100644
--- a/website/docs/user-guide/features/kanban.md
+++ b/website/docs/user-guide/features/kanban.md
@@ -536,11 +536,14 @@ hermes kanban --board <board> block <task> '<reason>' --metadata-only \
 
 The operation is `reclassify_parked`, with an explicit retained `client_op_id`,
 `task`, `reason` matching the CLI reason, `expected_revision`,
-`expected_event_uid` (the latest withdrawn metadata-only ask classification),
+`expected_event_uid` and `expected_event_version` (the exact latest withdrawn
+metadata-only ask classification row),
 `expected_spend_episode` (the current pending stop UID or null), sorted
 `expected_parents`, `expected_parent_links` (matching ordered `{uid,version}`
-link snapshots), and `disposition_comment_uid` (the home-authored disposition
-already recorded on this exact task). The enrolled home gateway authenticates
+link snapshots), and `disposition_comment_uid` plus `disposition_comment_version`
+(the exact home-authored disposition row already recorded on this task).
+Editing either evidence row invalidates the frozen request even if its UID and
+the task revision stay unchanged. The enrolled home gateway authenticates
 canonical ingress; free-form actor labels are not credentials. Worker entry is
 refused; use the authorized, audited owner operator transport, never stripped
 worker identity or direct SQLite edits.
-- 
