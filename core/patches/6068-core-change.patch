From: daveey <daveey@users.noreply.github.com>
Date: Tue, 24 Nov 2026 05:09:34 +0000
Subject: [PATCH 6068] Fact store, reducer and capture CPU reductions

Public mirror of source commit 0744e98ae622c70dda06db0c204f73a4e7201592.

---
diff --git a/hermes_cli/fact_board_inputs.py b/hermes_cli/fact_board_inputs.py
index 208ded9dcd6..efcd6d08b67 100644
--- a/hermes_cli/fact_board_inputs.py
+++ b/hermes_cli/fact_board_inputs.py
@@ -152,7 +152,8 @@
 
     def _fail(self, key):
         old = self.engine.store.snapshot(self.engine.scope).get(key)
-        fact = (evolve(old, health='stale', error_code='board_capture_failed') if old is not None
+        fact = (evolve(old, health='stale', error_code='board_capture_failed')
+                if old is not None and old.health != 'unknown'
                 else Fact(key, {}, error_code='board_capture_failed'))
         self.engine.publish([fact], now=time.time())
 
diff --git a/tests/hermes_cli/test_fact_board_inputs.py b/tests/hermes_cli/test_fact_board_inputs.py
index a7af0d41941..56a692bbb9e 100644
--- a/tests/hermes_cli/test_fact_board_inputs.py
+++ b/tests/hermes_cli/test_fact_board_inputs.py
@@ -84,6 +84,37 @@
     assert engine.store.snapshot(engine.scope).get(key).health == 'fresh'
 
 
+@pytest.mark.parametrize('warm', [False, True])
+def test_repeated_capture_failure_preserves_evidence_health(source, warm):
+    adapter, engine, _calls, woke = source
+    adapter.want('board', {'n': 1})
+    original = adapter._capture
+    key = adapter.input_key('board', {'n': 1})
+    if warm:
+        settle(adapter, woke)
+    previous = engine.store.snapshot(engine.scope).get(key)
+
+    def fail(*args):
+        raise OSError('controlled repeated failure')
+
+    adapter._capture = fail
+    for _ in range(3):
+        settle(adapter, woke)
+        # Both a failed detached capture and the scheduler failure callback
+        # must preserve unknown until there has actually been a good capture.
+        adapter.failure()
+        fact = engine.store.snapshot(engine.scope).get(key)
+        assert fact.health == ('stale' if warm else 'unknown')
+        assert fact.error_code == 'board_capture_failed'
+        if warm:
+            assert fact.value == previous.value
+            assert fact.observed_at == previous.observed_at
+            assert fact.source_vector == previous.source_vector
+    adapter._capture = original
+    settle(adapter, woke)
+    assert engine.store.snapshot(engine.scope).get(key).health == 'fresh'
+
+
 def test_source_close_forbids_new_demand(source):
     adapter, _, _, _ = source
     adapter.close()
