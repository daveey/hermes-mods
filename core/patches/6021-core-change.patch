From: daveey <daveey@users.noreply.github.com>
Date: Tue, 24 Nov 2026 00:33:59 +0000
Subject: [PATCH 6021] Test fixture and flake hardening (no production behavior)

Public mirror of source commit 084005cff887fcf53bc2c4b58e79065ee2a1a8aa.

---
diff --git a/scripts/ci/upstream_sync.py b/scripts/ci/upstream_sync.py
index 4a8305635c3..163efaa18e1 100644
--- a/scripts/ci/upstream_sync.py
+++ b/scripts/ci/upstream_sync.py
@@ -273,9 +273,10 @@
         raise GateError(f"git push ({stage}) to {ref} timed out after {PUSH_TIMEOUT_S} seconds") from exc
     if push.returncode:
         lines = [line.strip() for line in (push.stderr or push.stdout or "").splitlines() if line.strip()]
-        remote = [line for line in lines if line.startswith("remote:")]
-        # GitHub's verdict lines first (``remote: error: GH006 …``): the tail is paths and hints
-        message = " | ".join([line for line in remote if "error" in line.lower()] or remote or lines)[:600]
+        # Keep Git's local rejection/transport errors ahead of GitHub's PR hints.
+        errors = [line for line in lines if line.startswith(("!", "error:", "fatal:"))
+                  or (line.startswith("remote:") and "error" in line.lower())]
+        message = " | ".join(errors + [line for line in lines if line not in errors])[:1200]
         if is_protection_refusal(message):
             raise Refused(f"GitHub refused the push to {ref}: {message}")
         raise GateError(f"git push to {ref} failed: {message}")
diff --git a/tests/scripts/ci/test_upstream_sync.py b/tests/scripts/ci/test_upstream_sync.py
index 64f1bf0c1fc..8e2271eb922 100644
--- a/tests/scripts/ci/test_upstream_sync.py
+++ b/tests/scripts/ci/test_upstream_sync.py
@@ -54,6 +54,20 @@
     assert isinstance(error.value.__cause__, subprocess.TimeoutExpired)
 
 
+@pytest.mark.parametrize("failure", [
+    "! [remote rejected] HEAD -> sync/upstream-test (failed)",
+    "error: failed to push some refs",
+    "fatal: the remote end hung up unexpectedly",
+])
+def test_push_reports_local_failure_before_remote_hints(monkeypatch, tmp_path, failure):
+    hints = "remote: Create a pull request by visiting: " + "x" * 700
+    monkeypatch.setattr(sync, "_run", lambda *a, **kw:
+                        subprocess.CompletedProcess(a, 1, "", hints + "\n" + failure))
+    with pytest.raises(sync.GateError, match="git push") as error:
+        sync._push(tmp_path, "HEAD", "refs/heads/sync/upstream-test", "stage")
+    assert failure in str(error.value)
+
+
 def git(cwd, *args, env=None):
     return subprocess.run(["git", "-C", str(cwd), *args], check=True, capture_output=True, text=True,
                           env=env).stdout.strip()
