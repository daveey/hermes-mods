From 8dc2012416be026e9a4afc6dd2f26933f1b1d27d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 02:18:04 +0000
Subject: [PATCH] fix(kanban): hermes-sync bug cards are not the core-mirror
 singleton [daveey]

The widened mirror singleton matched hub t_01a19ddcef566978, a hermes-sync bug card naming its core pass and a
missing mirror checkout, so it was refused while any mirror card was open. 'core' and 'fork backlog' now count only
when the title lacks the hermes-sync token; hermes-mods still matches alone. 30-day hub replay (live board, other
boards, replica; 7314 titles): 74 singleton matches on main, 73 after, the only drop being that card.
t_01a19ea9f1739df6
---
 hermes_cli/kanban_overlap.py                      |  5 ++++-
 .../tools/test_kanban_create_overlap_singleton.py | 15 +++++++++++++++
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_overlap.py b/hermes_cli/kanban_overlap.py
index 449d16552d7..31ca6d360e0 100644
--- a/hermes_cli/kanban_overlap.py
+++ b/hermes_cli/kanban_overlap.py
@@ -122,7 +122,10 @@ def _names_board(slug: str, title: str, body: str, gateways: Iterable[str] = ())
 def singleton_job(title: str) -> Optional[str]:
     """Explicit single-writer jobs, not a change to general title similarity. [daveey]"""
     tokens = set(re.findall(r"[a-z0-9]+(?:-[a-z0-9]+)*", (title or "").lower()))
-    if "mirror" in tokens and (tokens & {"hermes-mods", "core"} or {"fork", "backlog"} <= tokens):
+    # "core"/"fork backlog" name the mirror pass only outside hermes-sync bug cards: "a core pass of hermes-sync
+    # crashed … hosts without a mirror checkout" is a hermes-sync fix, not a second mirror pass (t_01a19ddcef566978).
+    mirror_words = {"hermes-mods"} if "hermes-sync" in tokens else {"hermes-mods", "core"}
+    if "mirror" in tokens and (tokens & mirror_words or ("hermes-sync" not in tokens and {"fork", "backlog"} <= tokens)):
         return "hermes-mods core mirror"
     return None
 
diff --git a/tests/tools/test_kanban_create_overlap_singleton.py b/tests/tools/test_kanban_create_overlap_singleton.py
index 181f93857a4..18af9508c88 100644
--- a/tests/tools/test_kanban_create_overlap_singleton.py
+++ b/tests/tools/test_kanban_create_overlap_singleton.py
@@ -181,3 +181,18 @@ def test_mirror_override_is_recorded(home):
     assert len(events) == 1
     assert events[0]["outcome"] == "override" and events[0]["reason"] == args["distinct_reason"]
     assert events[0]["matches"][0]["id"] == tid
+
+
+HERMES_SYNC_BUG = ("hermes-sync on the hub: a core pass run outside hub-core-update crashed with ENOENT writing its "
+                   "deferral marker under the missing ~/code/hermes/.git (19:57:04Z 11-02); make host-state paths "
+                   "valid on hosts without a mirror checkout")
+
+
+def test_hermes_sync_bug_card_is_not_the_mirror_singleton(home):
+    """Real hub t_01a19ddcef566978: a hermes-sync bug that mentions its core pass and a mirror checkout. Over 30 days
+    of hub titles it was the only singleton match containing ``hermes-sync`` (74 matches; 73 after this rule)."""
+    assert ko.singleton_job(HERMES_SYNC_BUG) is None
+    assert ko.singleton_job("hermes-sync: fork backlog mirror pass") is None
+    assert ko.singleton_job("hermes-sync: hermes-mods core mirror pass") == "hermes-mods core mirror"
+    owner()
+    assert check(title=HERMES_SYNC_BUG) is None
-- 
