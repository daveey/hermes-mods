 hermes_cli/kanban_sync_rejected_event.py      | 10 ++---
 hermes_cli/kanban_sync_rejections.py          |  2 +-
 .../test_kanban_live_claim_child_rows.py      |  2 +
 .../test_kanban_rejected_phantom_event.py     | 43 +++++++++++--------
 4 files changed, 34 insertions(+), 23 deletions(-)

diff --git a/hermes_cli/kanban_sync_rejected_event.py b/hermes_cli/kanban_sync_rejected_event.py
index 05fb226591..59c9a1bbfe 100644
--- a/hermes_cli/kanban_sync_rejected_event.py
+++ b/hermes_cli/kanban_sync_rejected_event.py
@@ -8,7 +8,7 @@ from hermes_cli import kanban_db_sync as sync
 
 def snapshot(conn, op, task):
     """Include provenance and mode in the resolver's compare-and-delete snapshot."""
-    if op['table_name'] != 'task_events' or not task:
+    if op['table_name'] not in ('task_events', 'task_runs') or not task:
         return None
     audits = []
     for row in conn.execute("SELECT * FROM task_events WHERE task_id=? AND kind='sync_rejected'", (task,)):
@@ -22,7 +22,7 @@ def snapshot(conn, op, task):
 
 
 def moot_event(op, before, evidence):
-    """Never replay a phantom lifecycle event or remove its anti-resurrection tombstone.
+    """Never replay a phantom lifecycle event/run or remove its anti-resurrection tombstone.
 
     This does not authorize a lifecycle write: another worker may still hold the lease.
     The immutable rejection audit and exact local tombstone survive outbox retirement.
@@ -30,17 +30,17 @@ def moot_event(op, before, evidence):
     stamp = before.get('fenced_event') or {}
     audits = stamp.get('audits') or []
     tombs = before['tombstones']
-    if (op['table_name'] != 'task_events' or op['op'] not in ('upsert', 'compat')
+    if (op['table_name'] not in ('task_events', 'task_runs') or op['op'] not in ('upsert', 'compat')
             or str(op.get('last_error') or '').partition(':')[0] != 'live_claim'
             or stamp.get('mode') != 'primary' or before['row'] is not None
             or not before['parent'] or before['parent_ops'] or before['pending'] or before['receipt']
-            or len(tombs) != 1 or tuple(tombs[0][:2]) != ('task_events', op['row_uid'])
+            or len(tombs) != 1 or tuple(tombs[0][:2]) != (op['table_name'], op['row_uid'])
             or len(audits) != 1):
         return False
     audit = json.loads(audits[0]['payload'])
     fields = json.loads(op['fields'])
     return bool(
-        audit.get('table') == 'task_events' and audit.get('uid') == op['row_uid']
+        audit.get('table') == op['table_name'] and audit.get('uid') == op['row_uid']
         and audit.get('reason') == op['last_error'] and audit.get('fields') == sorted(fields)
         and fields.get('task_id') == before['task']
         and evidence.get('state') == 'never_existed' and evidence.get('floor') == 0
diff --git a/hermes_cli/kanban_sync_rejections.py b/hermes_cli/kanban_sync_rejections.py
index 8cc97c2acb..7c432c7b15 100644
--- a/hermes_cli/kanban_sync_rejections.py
+++ b/hermes_cli/kanban_sync_rejections.py
@@ -94,7 +94,7 @@ def _classify(op, before, evidence, parent_evidence, run_evidence=None):
     from hermes_cli import kanban_sync_client as client
     from hermes_cli.kanban_sync_rejected_event import moot_event
     if moot_event(op, before, evidence):
-        return "moot", "live-claim fenced phantom event remains tombstoned with its rejection audit; never stored by Board"
+        return "moot", "live-claim fenced phantom event/run remains tombstoned with its rejection audit; never stored by Board"
     if before["pending"] or before["tombstones"]:
         return "unresolved", "pending local work or local tombstone"
     gate = reserved_key.receipt_resolution(op, before, evidence, parent_evidence)
