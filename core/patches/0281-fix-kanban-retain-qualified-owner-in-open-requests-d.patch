From 0f73d1b414cdff6deacce9f76f3270f11615d2dc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 24 Oct 2026 05:14:39 +0000
Subject: [PATCH] fix(kanban): retain qualified owner in open requests [daveey]

---
 .../src/plugins/kanban/open-task.test.ts      | 29 +++++++++++++++++++
 apps/desktop/src/plugins/kanban/open-task.ts  | 21 ++++++++++----
 2 files changed, 45 insertions(+), 5 deletions(-)

diff --git a/apps/desktop/src/plugins/kanban/open-task.test.ts b/apps/desktop/src/plugins/kanban/open-task.test.ts
index 7b3f07f99e..963e69a33d 100644
--- a/apps/desktop/src/plugins/kanban/open-task.test.ts
+++ b/apps/desktop/src/plugins/kanban/open-task.test.ts
@@ -47,6 +47,35 @@ describe('installOpenTaskHook', () => {
     expect(rememberOwner).not.toHaveBeenCalled()
   })
 
+  it('retains a qualified owner in the parked request and forwards its profile', () => {
+    const target: Record<string, unknown> = {}
+    const rememberOwner = vi.fn()
+    installOpenTaskHook({ navigate: vi.fn(), rememberOwner }, target)
+    const hook = target[OPEN_TASK_HOOK] as (...args: string[]) => boolean
+
+    expect(hook('t_abcdef01', 'ops', 'remote', 'worker')).toBe(true)
+    expect(rememberOwner).toHaveBeenCalledWith('t_abcdef01', 'ops', 'remote', 'worker')
+    expect($openTaskRequest.get()).toEqual({
+      board: 'ops', taskId: 't_abcdef01', owner: { gateway: 'remote', profile: 'worker', board: 'ops' }
+    })
+    // Do not advertise support until the drawer/actions consume the identity.
+    expect((hook as unknown as { supportsQualifiedOwners?: boolean }).supportsQualifiedOwners).not.toBe(true)
+  })
+
+  it.each([null, '', 'worker'])('rejects incomplete explicit owner routes (%s)', profile => {
+    const target: Record<string, unknown> = {}
+    const navigate = vi.fn()
+    const rememberOwner = vi.fn()
+    installOpenTaskHook({ navigate, rememberOwner }, target)
+    $openTaskRequest.set(null)
+    const hook = target[OPEN_TASK_HOOK] as (id: string, board: string, gateway: string | null, profile: string | null) => boolean
+
+    expect(hook('t_abcdef01', 'ops', profile === 'worker' ? null : 'remote', profile)).toBe(false)
+    expect(navigate).not.toHaveBeenCalled()
+    expect(rememberOwner).not.toHaveBeenCalled()
+    expect($openTaskRequest.get()).toBeNull()
+  })
+
   it('disposer removes only its own hook', () => {
     const target: Record<string, unknown> = {}
     const dispose = installOpenTaskHook({ navigate: vi.fn() }, target)
diff --git a/apps/desktop/src/plugins/kanban/open-task.ts b/apps/desktop/src/plugins/kanban/open-task.ts
index 4e53c9d8bb..bdef690e69 100644
--- a/apps/desktop/src/plugins/kanban/open-task.ts
+++ b/apps/desktop/src/plugins/kanban/open-task.ts
@@ -13,6 +13,7 @@ import { atom } from '@hermes/plugin-sdk'
 export interface OpenTaskRequest {
   board: string
   taskId: string
+  owner?: { gateway: string; profile: string; board: string }
 }
 
 export const $openTaskRequest = atom<null | OpenTaskRequest>(null)
@@ -20,12 +21,12 @@ export const $openTaskRequest = atom<null | OpenTaskRequest>(null)
 /** [daveey] Global name of the cross-plugin "open this card" hook. */
 export const OPEN_TASK_HOOK = '__hermesKanbanOpenTask'
 
-type OpenTaskHook = (taskId: string, board?: null | string, gateway?: null | string) => boolean
+type OpenTaskHook = (taskId: string, board?: null | string, gateway?: null | string, profile?: null | string) => boolean
 
 export interface OpenTaskHookDeps {
   navigate: (path: string) => void
   /** Seed the task's owning gateway + board (api.ts `rememberTaskOwner`). */
-  rememberOwner?: (taskId: string, board: string, gateway: string) => void
+  rememberOwner?: (taskId: string, board: string, gateway: string, profile?: string) => void
 }
 
 /**
@@ -40,18 +41,28 @@ export function installOpenTaskHook(
   deps: OpenTaskHookDeps,
   target: Record<string, unknown> = globalThis as unknown as Record<string, unknown>
 ): () => void {
-  const hook: OpenTaskHook = (taskId, board, gateway) => {
+  const hook: OpenTaskHook = (taskId, board, gateway, profile) => {
     if (typeof taskId !== 'string' || !taskId) {
       return false
     }
 
     const slug = typeof board === 'string' ? board : ''
 
-    if (typeof gateway === 'string' && gateway) {
+    const owner = typeof gateway === 'string' && gateway && typeof profile === 'string' && profile
+      ? { gateway, profile, board: slug }
+      : undefined
+
+    if (profile !== undefined && !owner) {
+      return false
+    }
+
+    if (owner) {
+      deps.rememberOwner?.(taskId, slug, owner.gateway, owner.profile)
+    } else if (typeof gateway === 'string' && gateway) {
       deps.rememberOwner?.(taskId, slug, gateway)
     }
 
-    $openTaskRequest.set({ board: slug, taskId })
+    $openTaskRequest.set({ board: slug, taskId, ...(owner ? { owner } : {}) })
     deps.navigate('/kanban')
 
     return true
-- 
2.55.0

