From 9621acba095937beb295f59b2f10c91246e58ab9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 14 Oct 2026 16:38:36 -0700
Subject: [PATCH] fix(kanban): CLI create in an agent terminal stamps
 HERMES_SESSION_KEY and subscribes the chat (tui) [daveey]

---
 hermes_cli/kanban.py                          | 18 ++++++-
 .../test_kanban_create_session_stamp.py       | 54 +++++++++++++++++++
 2 files changed, 70 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban.py b/hermes_cli/kanban.py
index a468df8a31..2b22ce0bc2 100644
--- a/hermes_cli/kanban.py
+++ b/hermes_cli/kanban.py
@@ -364,18 +364,27 @@ def _cmd_create(args: argparse.Namespace) -> int:
     # An agent shelling out to the CLI from a chat (terminal / execute_code) owns the
     # card just like the kanban_create tool would: stamp its session so the Desktop
     # session's task list shows it. Workers' cards inherit their creator task's session.
+    # The desktop/TUI key (HERMES_SESSION_KEY) is what the session's notify poller
+    # listens on, so it wins over HERMES_SESSION_ID; plain shells have neither. [daveey]
     session_id = None
+    session_key = "" if in_worker else os.environ.get("HERMES_SESSION_KEY", "").strip()
     if not in_worker:
         from tools.kanban_tools import _persisted_session_id
-        session_id = _persisted_session_id(os.environ.get("HERMES_SESSION_ID"))
+        session_id = (_persisted_session_id(session_key)
+                      or _persisted_session_id(os.environ.get("HERMES_SESSION_ID")))
+    idem_key = getattr(args, "idempotency_key", None)
     with kbc.connect_closing() as conn:
+        # An --idempotency-key hit returns an existing card: never re-stamp/re-subscribe it.
+        idem_hit = bool(idem_key) and conn.execute(
+            "SELECT 1 FROM tasks WHERE idempotency_key = ? AND status != 'archived' LIMIT 1",
+            (idem_key,)).fetchone() is not None
         task_id = kb.create_task(
             conn, title=args.title, body=body, assignee=args.assignee, session_id=session_id,
             created_by=args.created_by or _profile_author(),
             workspace_kind=ws_kind, workspace_path=ws_path, branch_name=branch_name,
             project_id=getattr(args, "project", None), tenant=args.tenant, priority=args.priority,
             parents=tuple(args.parent or ()), triage=bool(getattr(args, "triage", False)),
-            idempotency_key=getattr(args, "idempotency_key", None),
+            idempotency_key=idem_key,
             max_runtime_seconds=max_runtime, skills=getattr(args, "skills", None) or None,
             max_retries=max_retries, model_override=getattr(args, "model_override", None),
             provider_override=getattr(args, "provider_override", None),
@@ -386,6 +395,11 @@ def _cmd_create(args: argparse.Namespace) -> int:
             creator_task_id=(os.environ.get("HERMES_KANBAN_TASK")
                              if in_worker else None),
         )
+        if session_key and not idem_hit:
+            # Same completion subscription the kanban_create tool adds, so the chat
+            # that shelled out hears when the card lands (and its row stays busy).
+            from tools.kanban_tools import _maybe_auto_subscribe
+            _maybe_auto_subscribe(conn, task_id)
         task = kb.get_task(conn, task_id)
     if getattr(args, "json", False):
         _print_json(_task_to_dict(task))
diff --git a/tests/hermes_cli/test_kanban_create_session_stamp.py b/tests/hermes_cli/test_kanban_create_session_stamp.py
index ea58827993..2ec751296f 100644
--- a/tests/hermes_cli/test_kanban_create_session_stamp.py
+++ b/tests/hermes_cli/test_kanban_create_session_stamp.py
@@ -30,6 +30,10 @@ def kanban_home(tmp_path, monkeypatch):
     monkeypatch.setattr(Path, "home", lambda: tmp_path)
     monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
     monkeypatch.delenv("HERMES_SESSION_ID", raising=False)
+    for var in ("HERMES_SESSION_KEY", "HERMES_SESSION_PLATFORM", "HERMES_SESSION_CHAT_ID"):
+        monkeypatch.delenv(var, raising=False)
+    from hermes_cli import kanban_session_activity as ksa
+    ksa._reset_cache_for_tests()
     kb.init_db()
     return home
 
@@ -72,3 +76,53 @@ def test_cli_create_in_worker_does_not_stamp_worker_session(kanban_home, monkeyp
     monkeypatch.setenv("HERMES_SESSION_ID", "worker_sess")
     monkeypatch.setenv("HERMES_KANBAN_TASK", "t_doesnotexist")
     assert _create("worker child") is None
+
+
+def _create_args(*argv: str) -> str:
+    root = argparse.ArgumentParser(prog="hermes")
+    kc.build_parser(root.add_subparsers())
+    assert kc._cmd_create(root.parse_args(["kanban", "create", *argv])) == 0
+    with kbc.connect_closing() as conn:
+        return next(t for t in kb.list_tasks(conn) if t.title == argv[0]).id
+
+
+def _subs(task_id: str) -> list[tuple[str, str]]:
+    from hermes_cli import kanban_db_notify as kbn
+
+    with kbc.connect_closing() as conn:
+        return [(s["platform"], s["chat_id"]) for s in kbn.list_notify_subs(conn, task_id)]
+
+
+def test_cli_create_with_session_key_stamps_and_subscribes(kanban_home, monkeypatch, capsys):
+    """Desktop/TUI terminals carry HERMES_SESSION_KEY: the card is owned by that chat,
+    gets the same ``tui`` completion subscription the kanban_create tool adds, and
+    keeps the chat's sidebar row busy (kanban_active). [daveey]"""
+    from hermes_cli import kanban_session_activity as ksa
+
+    _seed_session(kanban_home, "20261014_152627_e39461")
+    monkeypatch.setenv("HERMES_SESSION_KEY", "20261014_152627_e39461")
+    tid = _create_args("cli card from desktop terminal")
+    with kbc.connect_closing() as conn:
+        assert kb.get_task(conn, tid).session_id == "20261014_152627_e39461"
+    assert ("tui", "20261014_152627_e39461") in _subs(tid)
+    ksa._reset_cache_for_tests()
+    assert ksa.active_task_counts().get("20261014_152627_e39461") == 1
+
+
+def test_cli_create_without_session_key_adds_no_subscription(kanban_home, capsys):
+    from hermes_cli import kanban_session_activity as ksa
+
+    tid = _create_args("plain user shell")
+    assert _subs(tid) == []
+    ksa._reset_cache_for_tests()
+    assert ksa.active_task_counts() == {}
+
+
+def test_cli_create_idempotency_hit_does_not_restamp(kanban_home, monkeypatch, capsys):
+    tid = _create_args("idem card", "--idempotency-key", "k1")
+    _seed_session(kanban_home, "sess_later")
+    monkeypatch.setenv("HERMES_SESSION_KEY", "sess_later")
+    assert _create_args("idem card", "--idempotency-key", "k1") == tid
+    with kbc.connect_closing() as conn:
+        assert kb.get_task(conn, tid).session_id is None
+    assert _subs(tid) == []
