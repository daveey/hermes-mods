From 51287b9e6f80f3fe7514fa59df8ad37080580b9b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 26 Oct 2026 22:32:41 -0700
Subject: [PATCH 456/456] fix(kanban): never-run guard release still posts the
 merge-queue rejection note

f75d239f8b returned before the rejection check, so a never-run repair card whose
handoff names a queue-rejected PR lost its 'repair and resubmit' note, and 5
test_kanban_pr_rejection cases (which model a worker that opened its PR) failed.
Post the note on the never-run path too; mark worker-opened cases with worker_ran.
[t_5c49906d]

(cherry picked from commit fb67f2fac212adb2418e8fc63391417cc395798f)
---
 hermes_cli/kanban_db_dispatch_pr_state.py    |  6 ++++++
 tests/hermes_cli/test_kanban_pr_rejection.py | 20 +++++++++++++++++++-
 2 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_db_dispatch_pr_state.py b/hermes_cli/kanban_db_dispatch_pr_state.py
index 2312097610..f91e73cc05 100644
--- a/hermes_cli/kanban_db_dispatch_pr_state.py
+++ b/hermes_cli/kanban_db_dispatch_pr_state.py
@@ -199,6 +199,12 @@ def active_pr_reason(conn: sqlite3.Connection, task_id: str, now: int) -> Option
     if not pr_times:
         return None
     if _pr_comments_predate_first_run(conn, task_id, max(pr_times)):
+        # Not held, but a queue-rejected PR in the handoff still gets its repair note,
+        # exactly as when the guard releases a worker that opened it.
+        from hermes_cli.kanban_db_dispatch_pr_rejection import comment_rejection
+        for url in dict.fromkeys(pr_urls):
+            if pr_state(url) == "REJECTED":
+                comment_rejection(conn, task_id, url, _rejections[url.rstrip("/").lower()])
         return None
     if _immediate_checkpoint_after(conn, task_id, max(pr_times), latest_pr_comment_id):
         return None
diff --git a/tests/hermes_cli/test_kanban_pr_rejection.py b/tests/hermes_cli/test_kanban_pr_rejection.py
index 26973925f1..95261a9892 100644
--- a/tests/hermes_cli/test_kanban_pr_rejection.py
+++ b/tests/hermes_cli/test_kanban_pr_rejection.py
@@ -9,6 +9,9 @@ from hermes_cli import kanban_db_connect as kbc
 from tests.hermes_cli.test_kanban_park_invariants import kanban_home
 from hermes_cli import kanban_db_dispatch as kbd
 from hermes_cli import kanban_db_dispatch_pr_state as prs
+from tests.hermes_cli.kanban_guard_helpers import worker_ran
+
+__all__ = ["kanban_home", "worker_ran"]  # register shared fixtures
 
 _REAL_LOOKUP = prs._gh_pr_state
 URL = "https://github.com/example/project/pull/12"
@@ -28,7 +31,11 @@ def lookup(monkeypatch, state, bodies):
     monkeypatch.setattr(prs.subprocess, 'run', run)
 
 
-def test_rejected_open_pr_spawns_with_reason(kanban_home, monkeypatch, all_assignees_spawnable):
+@pytest.mark.parametrize('ran', [True, False], ids=['worker-ran', 'never-run'])
+def test_rejected_open_pr_spawns_with_reason(kanban_home, monkeypatch, all_assignees_spawnable, request, ran):
+    # never-run: a repair card whose handoff names the rejected PR still gets the repair note.
+    if ran:
+        request.getfixturevalue('worker_ran')
     lookup(monkeypatch, 'OPEN', [marker('queued', False, 0), marker('rejected')])
     spawned = []
     with kbc.connect() as conn:
@@ -45,6 +52,7 @@ def test_rejected_open_pr_spawns_with_reason(kanban_home, monkeypatch, all_assig
         assert spawned == [tid]
 
 
+@pytest.mark.usefixtures('worker_ran')
 @pytest.mark.parametrize('state,bodies,expected', [
     ('OPEN', [marker('rejected'), marker('queued', False, 0)], 'active_pr'),
     ('OPEN', [marker('rejected', False)], 'active_pr'),
@@ -64,6 +72,7 @@ def test_newest_queue_result(kanban_home, monkeypatch, state, bodies, expected):
             assert conn.execute('SELECT COUNT(*) FROM task_comments WHERE task_id = ?', (tid,)).fetchone()[0] == 1
 
 
+@pytest.mark.usefixtures('worker_ran')
 def test_requeue_after_rejection_is_not_cached(kanban_home, monkeypatch):
     bodies = [marker('rejected')]
     lookup(monkeypatch, 'OPEN', bodies)
@@ -73,3 +82,12 @@ def test_requeue_after_rejection_is_not_cached(kanban_home, monkeypatch):
         assert kbd.check_respawn_guard(conn, tid) is None
         bodies.append(marker('queued', False, 0))
         assert kbd.check_respawn_guard(conn, tid) == 'active_pr'
+
+
+def test_never_run_card_names_open_pr_is_not_held_and_not_noted(kanban_home, monkeypatch):
+    lookup(monkeypatch, 'OPEN', [marker('queued', False, 0)])
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title='review', assignee='a')
+        kb.add_comment(conn, tid, 'impl', f'please review {URL}')
+        assert kbd.check_respawn_guard(conn, tid) is None
+        assert conn.execute('SELECT COUNT(*) FROM task_comments WHERE task_id = ?', (tid,)).fetchone()[0] == 1
