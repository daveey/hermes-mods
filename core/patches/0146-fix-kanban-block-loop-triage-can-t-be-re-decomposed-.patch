 hermes_cli/kanban_db.py                     |  93 +++++++++++++++---
 hermes_cli/kanban_decompose.py              |  23 +++--
 hermes_cli/kanban_parser.py                 |   9 +-
 tests/hermes_cli/test_kanban_block_kinds.py | 103 +++++++++++++++++++-
 tools/kanban_tools.py                       |   4 +-
 tools/kanban_tools_schemas.py               |   3 +-
 website/docs/user-guide/features/kanban.md  |  11 ++-
 8 files changed, 221 insertions(+), 32 deletions(-)

