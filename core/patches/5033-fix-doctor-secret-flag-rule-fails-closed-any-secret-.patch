From a2781ae897fee773515298fc57a591157631d34a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 17:17:30 -0800
Subject: [PATCH] fix(doctor): secret-flag rule fails closed: any secret word,
 unless the name ends in a setting

Review follow-up: requiring the secret word to END the flag name stopped
masking --client-secret-value, --token-b64, --api-key-value, --auth-header
and --private-key-pem, so short, '/'-containing and hex secrets after them
printed in full. A flag is now secret-named when any part of its name is or
ends with a secret word, unless its LAST part names a setting about the
secret (-file, -env, -timeout, -name, -id, -path, -backend, -mode, plural
-tokens/-keys, ...). A new suffix therefore stays secret. Tests cover the
suffixed flags and pin the deliberate settings exemptions.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_state_argv_secrets.py            | 23 +++++++++----
 tests/hermes_state/test_argv_secrets.py | 46 +++++++++++++++++++++++++
 2 files changed, 62 insertions(+), 7 deletions(-)

diff --git a/hermes_state_argv_secrets.py b/hermes_state_argv_secrets.py
index 1121ed7f335..b1cc43dd65e 100644
--- a/hermes_state_argv_secrets.py
+++ b/hermes_state_argv_secrets.py
@@ -14,12 +14,16 @@ import re
 from collections import Counter
 
 MASK = "***"
-# The secret word ends the name: --api-key, --webhook-secret, --aws-secret-access-key, --db-password, --auth-token;
-# not --api-key-timeout, --token-env, --max-tokens or --password-file, whose values are settings or paths.
-_SECRET_FLAG = re.compile(
-    r"^-{1,2}[\w.-]*?(?:key|token|secret|passw(?:or)?d|passwd|pwd|auth|credentials?|cookie|bearer)$",
-    re.IGNORECASE,
-)
+# A flag is secret-named when a part of its name is, or ends with, a secret word (--api-key, --apikey,
+# --client-secret-value, --token-b64, --auth-header) -- fail closed: a new suffix stays secret -- unless its LAST
+# part names a setting about the secret rather than the secret (--api-key-timeout, --token-env, --key-file).
+_SECRET_WORD = re.compile(r"(?:key|token|secret|passw(?:or)?d|passwd|pwd|auth|credentials?|cookie|bearer)$",
+                          re.IGNORECASE)
+_SETTING_SUFFIXES = frozenset({
+    "file", "files", "env", "timeout", "ttl", "name", "names", "id", "ids", "path", "paths", "dir", "url", "uri",
+    "host", "port", "count", "limit", "size", "length", "len", "mode", "type", "kind", "format", "store", "backend",
+    "provider", "browser", "helper", "cmd", "command", "tokens", "keys", "enabled", "required", "only",
+})
 # Flags that LOOK secret-named but carry public, identifying values.
 _PUBLIC_FLAGS = frozenset({"--ssh-session-token-file", "--token-file", "--key-file", "--auth-file",
                            "--keychain", "--monkey", "--keyboard", "--author", "--authority",
@@ -52,7 +56,12 @@ def _looks_like_bare_secret(token: str) -> bool:
 
 
 def _is_secret_flag(token: str) -> bool:
-    return bool(_SECRET_FLAG.match(token)) and token.lower() not in _PUBLIC_FLAGS
+    if not token.startswith("-") or token.lower() in _PUBLIC_FLAGS:
+        return False
+    parts = [part for part in re.split(r"[-_.]", token.lstrip("-")) if part]
+    if not parts or parts[-1].lower() in _SETTING_SUFFIXES:
+        return False
+    return any(_SECRET_WORD.search(part) for part in parts)
 
 
 def _looks_like_path(value: str) -> bool:
diff --git a/tests/hermes_state/test_argv_secrets.py b/tests/hermes_state/test_argv_secrets.py
index 3c67198453f..5963ed0d4d2 100644
--- a/tests/hermes_state/test_argv_secrets.py
+++ b/tests/hermes_state/test_argv_secrets.py
@@ -28,6 +28,35 @@ KEY = "q8ZpL2vXk9RtYwB4mN7cQ1sD5fH3jK6g"
             ["--aws-secret-access-key", MASK],
         ),
         (["--webhook-secret=Zm9vYmFyYmF6/cXV4cXV1eA=="], [f"--webhook-secret={MASK}"]),
+        # a suffix after the secret word keeps the flag secret (fail closed); short, "/" and hex values too
+        (
+            [
+                "--client-secret-value",
+                "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
+                "--token-b64",
+                "Zm9vYmFy/YmF6cXV4",
+            ],
+            ["--client-secret-value", MASK, "--token-b64", MASK],
+        ),
+        (
+            [
+                "--api-key-value",
+                "hunter2hunter2",
+                "--secret-key-base",
+                "0a1b2c3d4e5f60718293a4b5c6d7e8f9",
+            ],
+            ["--api-key-value", MASK, "--secret-key-base", MASK],
+        ),
+        (
+            [
+                "--auth-header",
+                "Bearer.Xy9kq2LmZp4Rt7",
+                "--private-key-pem=abc",
+                "--apikey",
+                "x",
+            ],
+            ["--auth-header", MASK, f"--private-key-pem={MASK}", "--apikey", MASK],
+        ),
         # a numeric value after a secret-named flag is the secret
         (
             ["--webhook-secret", "12345678901234567890", "--signing-key=4242424242"],
@@ -91,6 +120,23 @@ def test_secrets_are_masked(argv, expected):
         ],
         ["--model", "Qwen3-Coder-480B-A35B-Instruct"],
         ["--api-key-timeout", "30"],
+        # settings about a secret, not the secret: deliberate (an id, a name, an env var, a store, a jar path)
+        [
+            "--access-key-id",
+            "deploy-bot",
+            "--secret-name",
+            "prod/db",
+            "--api-key-env",
+            "OPENAI_API_KEY",
+        ],
+        [
+            "--keyring-backend",
+            "macos",
+            "--auth-mode",
+            "oauth",
+            "--cookie-jar",
+            "~/.hermes/cookies.txt",
+        ],
         ["--key-file", "C:\\Users\\x\\key.pem"],
         ["--token-file", "./token.txt"],
     ],
