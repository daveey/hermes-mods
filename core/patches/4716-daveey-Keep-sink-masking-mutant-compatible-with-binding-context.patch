From 33f93c6b7ef0a3250bbbb937abe61701abb69ea6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 03:03:48 +0000
Subject: [PATCH] [daveey] Keep sink masking mutant compatible with binding
 context

Preserve the always-false sink mutation and all nesting assertions while accepting the new keyword-only binding_source context. Proof: full cron, terminal heredoc, self-repo and 11 mutation probes: 294 files, 12500 passed, 0 failed, 9 skipped (cron-signature-green.log). Prior identical suite failed only on the old lambda signature.
---
 tests/cron/test_lifecycle_guard_output_sink.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/cron/test_lifecycle_guard_output_sink.py b/tests/cron/test_lifecycle_guard_output_sink.py
index ec2d098285ae4dbf8f9d8dfa92b7cd2601cbd15a..92ac1ae69ffe094bff30415dc3ce02099d3acba9 100644
--- a/tests/cron/test_lifecycle_guard_output_sink.py
+++ b/tests/cron/test_lifecycle_guard_output_sink.py
@@ -260,7 +260,9 @@ def test_shape_corpus_catches_a_guard_that_keeps_masking_sink_bodies(tmp_path, m
              and case.sink in ("| bash", 'eval "$(…)"')]
     assert {case.nesting for case in cases} == set(corpus.SINK_NESTINGS)
     assert not corpus.violations(corpus.evaluate(tmp_path / "good", cases), lambda case: True)
-    monkeypatch.setattr(shell_heredoc, "output_reaches_shell", lambda command: False)
+    monkeypatch.setattr(
+        shell_heredoc, "output_reaches_shell", lambda command, *, binding_source=None: False,
+    )
     bad = corpus.violations(corpus.evaluate(tmp_path / "mutant", cases), lambda case: True)
     assert {case.nesting for case in bad} == set(corpus.SINK_NESTINGS)
 
