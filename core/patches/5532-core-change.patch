diff --git a/hermes_cli/kanban_pr_idle_checks.py b/hermes_cli/kanban_pr_idle_checks.py
new file mode 100644
index 0000000000..9d9e90bea0
--- /dev/null
+++ b/hermes_cli/kanban_pr_idle_checks.py
@@ -0,0 +1,72 @@
+"""Bounded background exact-head CI observations; never wait inside the dispatch lock."""
+from __future__ import annotations
+
+from collections import OrderedDict
+from concurrent.futures import Future, ThreadPoolExecutor
+from contextvars import copy_context
+from threading import RLock
+import time
+
+TTL_SECONDS = 300
+MAX_ENTRIES = 256
+OBSERVATION_BUDGET_SECONDS = 120
+_pool = ThreadPoolExecutor(max_workers=2, thread_name_prefix="kanban-idle-pr")
+_cache: OrderedDict[tuple, tuple[float, bool]] = OrderedDict()
+_pending: dict[tuple, tuple[float, Future]] = {}
+_lock = RLock()
+
+
+def clear_cache() -> None:
+    with _lock:
+        _clear_cache()
+
+
+def _clear_cache() -> None:
+    _cache.clear()
+    # Running jobs have no DB handle and cannot publish a release themselves.
+    for _started, future in _pending.values():
+        future.cancel()
+    _pending.clear()
+
+
+def _collect(contract, assignee, head) -> bool:
+    from hermes_cli import kanban_db_dispatch_pr_state as prs
+    from hermes_cli.kanban_pr_acceptance import collect_acceptance
+    receipt = collect_acceptance(contract, contract, assignee=assignee)
+    green = (receipt.get("ok") is True and receipt.get("pr_state") == "OPEN"
+             and receipt.get("pr_url") == contract and receipt.get("head_sha") == head
+             and bool(receipt.get("checks")))
+    return bool(green and prs.pr_head(contract, max_age=0) == head)
+
+
+def green(key, contract, assignee, head) -> bool:
+    with _lock:
+        return _green(key, contract, assignee, head)
+
+
+def _green(key, contract, assignee, head) -> bool:
+    """At most two outstanding jobs, no queued backlog, discard over-budget observations."""
+    now = time.monotonic()
+    hit = _cache.get(key)
+    if hit is not None and now < hit[0]:
+        return hit[1]
+    # Reap finished jobs even if their original task never asks again.
+    for old, (started, future) in list(_pending.items()):
+        if future.done():
+            try:
+                passed = future.result() is True and now - started <= OBSERVATION_BUDGET_SECONDS
+            except (OSError, ValueError, TypeError, KeyError, RuntimeError):
+                # Failed observation remains fail-closed; never retain exception text.
+                passed = False
+            _cache[old] = (now + TTL_SECONDS, passed)
+            _pending.pop(old)
+    while len(_cache) > MAX_ENTRIES:
+        _cache.popitem(last=False)
+    hit = _cache.get(key)
+    if hit is not None and now < hit[0]:
+        return hit[1]
+    if key not in _pending and len(_pending) < 2:
+        _pending[key] = (now, _pool.submit(copy_context().run, _collect, contract, assignee, head))
+        if _pending[key][1].done():
+            return green(key, contract, assignee, head)
+    return False  # next tick consumes the result; the 35-min home cap bounds an outage
diff --git a/hermes_cli/kanban_pr_idle_green.py b/hermes_cli/kanban_pr_idle_green.py
new file mode 100644
index 0000000000..8baa920134
--- /dev/null
+++ b/hermes_cli/kanban_pr_idle_green.py
@@ -0,0 +1,61 @@
+"""Resume idle PR publishers after bounded-age, exact-head green CI observations.
+
+Admission is to finish the existing PR, never permission to merge. Repeated crash
+recovery remains subject to ordinary run/spend breakers; green CI is not review.
+"""
+from __future__ import annotations
+
+from hermes_cli.kanban_db_dispatch_pr_policy import norm_pr
+from hermes_cli import kanban_pr_idle_checks as checks
+
+
+def clear_cache() -> None:
+    checks.clear_cache()
+
+
+def _idle(conn, task_id: str) -> bool:
+    row = conn.execute("SELECT status FROM tasks WHERE id=?", (task_id,)).fetchone()
+    return bool(row and row[0] == "ready" and not conn.execute(
+        "SELECT 1 FROM task_runs WHERE task_id=? AND ended_at IS NULL LIMIT 1", (task_id,),
+    ).fetchone() and not conn.execute(
+        "SELECT 1 FROM task_wake_checks WHERE task_id=?", (task_id,),
+    ).fetchone())
+
+
+def _identity(conn, task_id):
+    row = conn.execute("SELECT completion_contract, assignee FROM tasks WHERE id=?", (task_id,)).fetchone()
+    comments = conn.execute("SELECT MAX(id) FROM task_comments WHERE task_id=?", (task_id,)).fetchone()[0]
+    run = conn.execute("SELECT MAX(id) FROM task_runs WHERE task_id=?", (task_id,)).fetchone()[0]
+    return (*row, comments, run) if row else None
+
+
+def releases(conn, task_id: str, states: dict[str, str | None]) -> bool:
+    """Every unfinished provenance-filtered holding PR must have green exact-head CI."""
+    from hermes_cli import kanban_db_dispatch_pr_state as prs
+    from hermes_cli.kanban_pr_acceptance import validate_contract
+
+    if not _idle(conn, task_id):
+        return False
+    before = _identity(conn, task_id)
+    if before is None:
+        return False
+    contract, assignee = before[:2]
+    try:
+        contract = validate_contract(contract)
+    except ValueError:
+        return False
+    unfinished = {url: state for url, state in states.items() if state not in prs.TERMINAL_STATES}
+    if not unfinished or any(state != "OPEN" for state in unfinished.values()):
+        return False
+    if contract.startswith("https://github.com/") and norm_pr(contract) not in {norm_pr(u) for u in states}:
+        return False
+    database = tuple(tuple(r) for r in conn.execute("PRAGMA database_list"))
+    results = []
+    for url in unfinished:
+        head = prs.pr_head(url)
+        if head is None:
+            return False
+        key = (database, task_id, before, url, head)
+        results.append(checks.green(key, url, assignee, head))
+    # A newly published PR/run cannot reuse a prior observation, even on another board.
+    return bool(all(results) and before == _identity(conn, task_id) and _idle(conn, task_id))
diff --git a/tests/hermes_cli/test_kanban_active_pr_idle_async.py b/tests/hermes_cli/test_kanban_active_pr_idle_async.py
