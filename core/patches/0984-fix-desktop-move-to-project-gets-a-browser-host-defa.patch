From dae5da215fc4552091976a9b23be76f5193b0605 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 19:00:52 +0000
Subject: [PATCH] fix(desktop): move-to-project gets a browser-host default
 [daveey]
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The fork's session.moveToProject (⌘⇧P / Ctrl+Shift+P) is a chord browsers take first (private
window); upstream's browser-defaults test rejects it. Browser hosts get ⌃⌘⇧P / Alt+Shift+P like the
other reserved chords; native Desktop keeps ⌘⇧P.
---
 apps/desktop/src/lib/keybinds/actions.ts | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/lib/keybinds/actions.ts b/apps/desktop/src/lib/keybinds/actions.ts
index b371b19d1a0..3a9cae6fe94 100644
--- a/apps/desktop/src/lib/keybinds/actions.ts
+++ b/apps/desktop/src/lib/keybinds/actions.ts
@@ -212,7 +212,12 @@ export const KEYBIND_ACTIONS: readonly KeybindActionMeta[] = [
   { id: 'session.archive', category: 'session', defaults: ['mod+shift+a'] },
   // ⌘⇧P — "p" for project: re-home the selected session into another project
   // through a typeahead palette page (same move as the row menu's submenu).
-  { id: 'session.moveToProject', category: 'session', defaults: ['mod+shift+p'] },
+  // In a browser tab ⌘⇧P / Ctrl+Shift+P opens a private window first.
+  {
+    id: 'session.moveToProject',
+    category: 'session',
+    ...hostDefaults(['mod+shift+p'], { mac: 'mod+ctrl+shift+p', other: 'alt+shift+p' })
+  },
   // ⌘⇧B — "b" for branch: spin up a new git worktree from the active repo.
   { id: 'workspace.newWorktree', category: 'session', defaults: ['mod+shift+b'] },
   // ⌘O — the editor-standard "open folder" chord (VS Code ⌘O, Zed's
