 .../test_deleted_wal_generation_guard.py      | 52 ++++++++++++++++
 .../test_finalize_plugin_discovery.py         | 59 +++++++++++++++++++
 tui_gateway/session_lifecycle.py              | 14 +++--
 4 files changed, 147 insertions(+), 5 deletions(-)
