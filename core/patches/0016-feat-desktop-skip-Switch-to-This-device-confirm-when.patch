From e93f1fe0f1a91ecaf65cfa123b8d9c72085288c8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 12 Oct 2026 16:13:04 -0700
Subject: [PATCH] feat(desktop): skip 'Switch to This device?' confirm when
 local runtime is installed [daveey]

---
 .../app/chat/sidebar/local-device-switch.tsx    |  8 ++++----
 .../chat/sidebar/profile-rail-fleet.test.tsx    | 17 +++++------------
 2 files changed, 9 insertions(+), 16 deletions(-)

diff --git a/apps/desktop/src/app/chat/sidebar/local-device-switch.tsx b/apps/desktop/src/app/chat/sidebar/local-device-switch.tsx
index 931932c5df..907001ce1a 100644
--- a/apps/desktop/src/app/chat/sidebar/local-device-switch.tsx
+++ b/apps/desktop/src/app/chat/sidebar/local-device-switch.tsx
@@ -71,15 +71,15 @@ export function useLocalDeviceSwitch() {
       return false
     }
 
-    const freshSession = target.replaceCenter === true || target.profile == null || target.profile === 'default'
-
-    if (!bootstrapNeeded && !freshSession) {
+    // [daveey] An installed runtime switches straight through — the "fresh
+    // session" confirm was pure friction. Only a real install still confirms.
+    if (!bootstrapNeeded) {
       return true
     }
 
     return new Promise(resolve => {
       waiter.current = resolve
-      setPrompt({ ...target, kind: bootstrapNeeded ? 'install' : 'switch' })
+      setPrompt({ ...target, kind: 'install' })
     })
   }
 
diff --git a/apps/desktop/src/app/chat/sidebar/profile-rail-fleet.test.tsx b/apps/desktop/src/app/chat/sidebar/profile-rail-fleet.test.tsx
index 4cc5a45b19..ab1d4a2f95 100644
--- a/apps/desktop/src/app/chat/sidebar/profile-rail-fleet.test.tsx
+++ b/apps/desktop/src/app/chat/sidebar/profile-rail-fleet.test.tsx
@@ -531,7 +531,7 @@ describe('ProfileRail fleet mode', () => {
     expect(builder.getAttribute('aria-busy')).toBeNull()
   })
 
-  it('asks before a fresh session when This device is already installed', async () => {
+  it('switches straight to This device without a confirm when already installed', async () => {
     armFleet()
     await renderFleet()
 
@@ -541,20 +541,12 @@ describe('ProfileRail fleet mode', () => {
       })
     )
 
-    expect(selectConnection).not.toHaveBeenCalled()
-    expect(await screen.findByRole('dialog', { name: 'Switch to This device?' })).toBeTruthy()
-    expect(
-      screen.getByText(
-        'This opens a fresh session on this computer. The conversation you are in stays on the other gateway.'
-      )
-    ).toBeTruthy()
-
-    fireEvent.click(screen.getByRole('button', { name: 'Switch' }))
-
     await act(async () => {
       await Promise.resolve()
+      await Promise.resolve()
     })
 
+    expect(screen.queryByRole('dialog', { name: 'Switch to This device?' })).toBeNull()
     expect(selectConnection).toHaveBeenCalledWith('local', { profile: 'default' })
   })
 
@@ -582,8 +574,9 @@ describe('ProfileRail fleet mode', () => {
     expect(await screen.findByText('Connect to existing Hermes')).toBeTruthy()
   })
 
-  it('does not switch when the fresh-session cue is cancelled', async () => {
+  it('does not switch when the install confirm is cancelled', async () => {
     armFleet()
+    probeLocalBackend.mockResolvedValue({ bootstrapNeeded: true })
     await renderFleet()
 
     fireEvent.click(
-- 
