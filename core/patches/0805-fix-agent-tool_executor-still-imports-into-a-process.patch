From 32c097c75e8d4370b4071227f92259bb7f75cee1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 13:32:16 -0700
Subject: [PATCH] fix(agent): tool_executor still imports into a process
 running the previous release [daveey]

A long-lived process mid-update (dashboard in e2e-upgrade handoff, release run 40717630046)
lazily loads HEAD's agent.tool_executor while its cached agent.interrupt_control predates
interrupt_skip_wording (post-v2026.9.24). Fall back locally, like cron.unreachable_retry
(66c42a1aa5). Test: tests/agent/test_tool_executor_mixed_version_import.py (red before).
---
 agent/tool_executor.py                        | 10 +++++++-
 ...test_tool_executor_mixed_version_import.py | 25 +++++++++++++++++++
 2 files changed, 34 insertions(+), 1 deletion(-)
 create mode 100644 tests/agent/test_tool_executor_mixed_version_import.py

diff --git a/agent/tool_executor.py b/agent/tool_executor.py
index 4d35ee79ea..be44cf96bc 100644
--- a/agent/tool_executor.py
+++ b/agent/tool_executor.py
@@ -31,7 +31,15 @@ from agent.display import (
     _detect_tool_failure,
 )
 from agent.compression_marker import _COMPRESSION_MARKER_PREFIX
-from agent.interrupt_control import _REASON_USER_INTERRUPT, interrupt_skip_wording
+from agent.interrupt_control import _REASON_USER_INTERRUPT
+
+try:
+    from agent.interrupt_control import interrupt_skip_wording
+except ImportError:  # mid-update: an older process cached agent.interrupt_control and loads this file fresh
+    def interrupt_skip_wording(agent) -> str:
+        """Fallback for a pre-10-04 cached ``agent.interrupt_control`` (see interrupt_control.interrupt_skip_wording)."""
+        reason = getattr(agent, "_tool_interrupt_reason", None)
+        return "Turn interrupted" if not reason else str(reason).replace("_", " ").capitalize()
 from agent.message_sanitization import coalesce_tool_call_id
 from agent.inline_tool_executors import (
     INLINE_TOOL_EXECUTORS,
diff --git a/tests/agent/test_tool_executor_mixed_version_import.py b/tests/agent/test_tool_executor_mixed_version_import.py
new file mode 100644
index 0000000000..f4aa330769
--- /dev/null
+++ b/tests/agent/test_tool_executor_mixed_version_import.py
@@ -0,0 +1,25 @@
+"""agent.tool_executor imports into a process that cached the previous release's agent.interrupt_control.
+
+During ``hermes update`` a long-lived process (gateway, dashboard) keeps its old modules in
+``sys.modules`` while the files on disk become HEAD. The dashboard then lazily imported HEAD's
+tool_executor, which needed ``interrupt_skip_wording`` (added after v2026.9.24), and got
+ImportError (e2e-upgrade handoff, release run 40717630046, dashboard.log).
+"""
+from __future__ import annotations
+
+import importlib
+import sys
+import types
+
+
+def test_tool_executor_imports_against_previous_release_interrupt_control(monkeypatch):
+    real = importlib.import_module("agent.interrupt_control")
+    old = types.ModuleType(real.__name__)
+    for k, v in vars(real).items():
+        if k != "interrupt_skip_wording" and not k.startswith("__"):
+            setattr(old, k, v)
+    monkeypatch.setitem(sys.modules, "agent.interrupt_control", old)
+    monkeypatch.delitem(sys.modules, "agent.tool_executor", raising=False)
+    m = importlib.import_module("agent.tool_executor")
+    assert m.interrupt_skip_wording(types.SimpleNamespace(_tool_interrupt_reason=None)) == "Turn interrupted"
+    assert m.interrupt_skip_wording(types.SimpleNamespace(_tool_interrupt_reason="user interrupt")) == "User interrupt"
