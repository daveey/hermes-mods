From 2de2471028ec60ded61ac3144289648c681575a0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 01:06:26 -0700
Subject: [PATCH] fix(tests): deflake prepared-compaction pass joins; wait on
 the pass, not a 5s clock (#264)

test_splice_carries_the_passs_main_model_fallback_and_call_telemetry failed on main
(run 41009740205) with _entry None after thread.join(5.0). Reproduced under a
SIGSTOP/SIGCONT 0.3s/0.1s duty cycle: join returned at 5.2s with the pass still
alive (not failed: _retry_after 0; not cancelled). The pass's failed summary call
is classified through classify_api_error -> plugin hook -> plugins.discover_and_load,
which cold-loads the bundled plugins in each test (conftest resets the plugin
manager), 0.7-2.6s on a quiet hub and past 5s on a starved runner.

Every pass join in the file now goes through _finish(): join with a 60s deadline
that returns as soon as the pass ends, then assert the thread actually ended, so
a hang fails loudly instead of the post-join _entry-is-None assertions passing
vacuously. The overlap wait inside the turn-loop test gets the same deadline.

Verified: the target test 3/3 under the duty cycle (was 1/1 red), the full file
50/50 under a 0.2s/0.1s duty cycle, scripts/run_tests.sh green.
---
 tests/agent/test_prepared_compaction.py | 37 +++++++++++++++++--------
 1 file changed, 25 insertions(+), 12 deletions(-)

diff --git a/tests/agent/test_prepared_compaction.py b/tests/agent/test_prepared_compaction.py
index 4686fcc6d18..94e617cd8af 100644
--- a/tests/agent/test_prepared_compaction.py
+++ b/tests/agent/test_prepared_compaction.py
@@ -98,10 +98,22 @@ def _agent(cc, tokens: int = 19500):
     return SimpleNamespace(context_compressor=cc, compression_enabled=True, api_mode="chat_completions")
 
 
+# A deadline, not a delay: join returns the moment the pass ends. A pass can spend seconds of CPU before
+# its summary call returns (a failed summary call's error classification cold-loads the bundled plugins
+# in a fresh test process), and a starved CI container stretches that far past a fixed 5 s join.
+_PASS_DEADLINE = 60.0
+
+
+def _finish(thread: threading.Thread) -> None:
+    """Wait for a pass thread to end; a pass still running at the deadline is a hang, not a result."""
+    thread.join(_PASS_DEADLINE)
+    assert not thread.is_alive(), f"the pass was still running after {_PASS_DEADLINE:g}s"
+
+
 def _prepare(cc, msgs, tokens: int = 19500):
     thread = pc.maybe_prepare(_agent(cc, tokens), msgs, origin="tool-batch")
     assert thread is not None, "expected a pass to start"
-    thread.join(5.0)
+    _finish(thread)
     entry = cc.prepared_compaction._entry
     assert entry is not None
     return entry
@@ -192,7 +204,7 @@ def test_turn_end_pass_skipped_where_the_session_ends_with_the_turn(agent_attrs)
     assert pc.maybe_prepare(agent, _messages(30), origin="turn-end") is None
     thread = pc.maybe_prepare(agent, _messages(30), origin="tool-batch")  # mid-turn passes still run
     assert thread is not None
-    thread.join(5.0)
+    _finish(thread)
 
 
 def test_pass_runs_under_the_callers_profile_scope(tmp_path):
@@ -257,7 +269,7 @@ def test_growth_past_the_candidate_beyond_the_tail_budget_still_splices_keeping_
         compressed = cc.compress(later, current_tokens=cc.threshold_tokens + 1)
 
     if pass_state == "running":
-        running.join(5.0)
+        _finish(running)
     assert [c["worker"] for c in cc.calls] == [True], "one summary, written by the pass"
     kept = later[window.compress_end:]
     for original, row in zip(kept, compressed[-len(kept):]):
@@ -290,7 +302,7 @@ def test_a_fresh_cut_before_the_candidate_boundary_still_splices_and_the_boundar
         compressed = cc.compress(later, current_tokens=cc.threshold_tokens + 1)
 
     if pass_state == "running":
-        running.join(5.0)
+        _finish(running)
     assert [c["worker"] for c in cc.calls] == [True], "one summary, written by the pass"
     kept = later[window.compress_end:]
     assert kept, "the pass planned its own tail"
@@ -430,7 +442,7 @@ def test_compaction_waits_for_a_running_pass_and_forwards_its_progress():
     threading.Thread(target=lambda: wait_until(lambda: pending.on_progress is not None) and cc.gate.set()).start()
     with aux_progress_hook(lambda: host_progress.append(threading.current_thread().name)):
         compressed = cc.compress(msgs, current_tokens=cc.threshold_tokens + 1)
-    running.join(5.0)
+    _finish(running)
 
     assert [c["worker"] for c in cc.calls] == [True], "the pass's summary was spliced, no inline call"
     assert "Summary v1" in _summary_row(compressed)["content"]
@@ -452,7 +464,7 @@ def test_wait_ends_at_the_host_deadline_then_summarises_inline_and_the_pass_cann
     assert [c["worker"] for c in cc.calls] == [False], "inline summary after the deadline"
 
     cc.gate.set()
-    running.join(5.0)
+    _finish(running)
     assert cc.prepared_compaction._entry is None
 
 
@@ -475,7 +487,7 @@ def test_prompt_reading_in_the_pass_extends_the_deadline_the_wait_honours():
     initial.append(deadline[0])
     with aux_stream_deadline(lambda: deadline[0]), prompt_reading_hook(lambda s: deadline.__setitem__(0, deadline[0] + s)):
         compressed = cc.compress(msgs, current_tokens=cc.threshold_tokens + 1)
-    running.join(5.0)
+    _finish(running)
 
     assert [c["worker"] for c in cc.calls] == [True], "the extended wait outlived the initial deadline"
     assert "Summary v1" in _summary_row(compressed)["content"]
@@ -498,7 +510,7 @@ def test_host_cancel_ends_the_wait_and_cancels_the_superseded_pass(monkeypatch):
         cc.compress(msgs, current_tokens=cc.threshold_tokens + 1)
     assert [c["worker"] for c in cc.calls] == [False], "inline summary after the host cancelled the wait"
     assert pending.cancelled.is_set(), "the pass nobody can use is told to stop streaming"
-    running.join(5.0)
+    _finish(running)
     assert not running.is_alive() and escaped == [], "the cancelled stream ends the pass quietly"
 
 
@@ -517,7 +529,7 @@ def test_session_reset_during_the_wait_wakes_it_without_waiting_for_the_pass():
         cc.compress(msgs, current_tokens=cc.threshold_tokens + 1)
     assert [c["worker"] for c in cc.calls] == [False]
     cc.gate.set()
-    running.join(5.0)
+    _finish(running)
     assert cc.prepared_compaction._entry is None
 
 
@@ -545,7 +557,7 @@ def test_session_boundary_discards_candidate_and_running_pass(boundary):
     assert running is not None
     cross(cc, msgs)
     cc.gate.set()
-    running.join(5.0)
+    _finish(running)
     assert cc.prepared_compaction._entry is None and cc.prepared_compaction._pending is None
 
 
@@ -586,7 +598,8 @@ def test_failed_pass_backs_off_without_touching_live_failure_state(tmp_path, mon
     call = MagicMock(side_effect=RuntimeError("No LLM provider configured"))
     monkeypatch.setattr(module, "call_llm", call)
     thread = pc.maybe_prepare(_agent(cc), msgs, origin="test")
-    thread.join(5.0)
+    assert thread is not None
+    _finish(thread)
 
     assert call.call_count == 1
     assert cc.prepared_compaction._entry is None
@@ -685,7 +698,7 @@ def test_turn_that_crosses_the_trigger_splices_the_summary_prepared_during_its_t
     def summarise(turns, focus_topic=None, **_):
         on_worker = threading.current_thread().name == "compaction-prepare"
         if on_worker:  # the pass is meant to overlap the tool
-            assert tool_started.wait(5.0), "no tool ran while the pass was pending"
+            assert tool_started.wait(_PASS_DEADLINE), "no tool ran while the pass was pending"
         summaries.append(on_worker)
         return cc._with_summary_prefix(f"Summary of {len(turns)} turns.")
 
