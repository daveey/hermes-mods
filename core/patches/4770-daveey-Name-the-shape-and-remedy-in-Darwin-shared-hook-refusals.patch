From 8eb811ae3bd31011f23bed159e4ce51286014e69 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 16 Nov 2026 03:31:37 +0000
Subject: [PATCH] [daveey] Name the shape and remedy in Darwin shared-hook
 refusals

Problem: review t_d53a0b05361c484e of PR #3346 showed the shared pre-push hook on a Mac
refuses evidence orphan trees, Oct-2026 state trees without scripts/check and stale state
branches (based before 808ded1b8b) with "portable core checks belong on a pool worker".
None of those is a core candidate, so the message points the pusher the wrong way.
Why 1: candidate_admitted() printed one core-worded message for every refusal
  (scripts/check at e8cb9e606e, both echo lines).
Why 2: the admission decision was designed as fail-closed for unknown trees (parent
  acceptance), and the refusal text was written for the original core-only refusal
  (f57b179cc0) and reused when state admission was added.
Root (happened): the refusal reported the policy, not the classification it had computed.
Root (not caught): admission tests asserted only rc 2 for incomplete/unknown trees, never
  which class was named or what the remedy was.
Recurrence: follow-up of e8cb9e606e (PR #3346), which followed f57b179cc0.

Decision: keep fail-closed; do not add a checker-less admission. Read-only evidence
(t_6f760c9577e4ef65): on the mini both shared-hook clones (~/code/hermes on state,
~/code/hermes-agent) run this hook as pre-push.chained. Their push reflogs show
3365 pushes of state (full layout, admitted) and 11 fix/*, bb-dev/* and codex-lane branches,
all stale-state shape, last pushed 2026-11-10, before f57b179cc0 already refused any tree
with a checker on Darwin. No evidence/* or bb-tuner/* push from a Mac: both evidence
branches were pushed from the hub/workers (author ubuntu@worker-host; t_example
ran on hub/worker-1) and bb-tuner/* by the bb-tuner agent, not on the mini. The MacBook was
unreachable (ssh timeout), so its clones were not inspected.

Change: Darwin refusals now say "refused on this Mac: <class>; <remedy>":
- core candidate (has <marker>): run hermes-core-wt test/ship on a pool worker;
- no checker (missing or not a regular file: ...): push it from a pool worker;
- unknown layout (missing ...): push it from a pool worker;
- stale state layout (missing: scripts/state-push-guard ...): rebase onto current
  origin/state, or push it from a pool worker;
- unreadable candidate: push it from a pool worker.
The decision is unchanged: same inputs, same rc. Core candidates (historical too) still
refuse; the full state layout is still admitted through its own checker; Linux is unchanged.

Proof on pool Linux (worker-2):
- RED at origin/main 208402a5bd with the new tests: 13 failed (5 shape cases, 8 Darwin
  real-Git push cases asserting the class).
- GREEN: tests/scripts/test_check_state_admission.py + test_check_mac_admission.py
  44 passed, 0 failed. bash -n on both generated hooks OK.
---
 scripts/check                               | 24 ++++++++++---
 tests/scripts/test_check_mac_admission.py   |  2 ++
 tests/scripts/test_check_state_admission.py | 37 +++++++++++++++++++++
 3 files changed, 58 insertions(+), 5 deletions(-)

diff --git a/scripts/check b/scripts/check
index 5243d7e1a78b1e8de9051f0e37fe72a79833d8e6..ccb2aaedcd13c646291823364923641ef97e7ed6 100755
--- a/scripts/check
+++ b/scripts/check
@@ -116,24 +116,38 @@ if env.get("PATH") and pp:
   break
 done
 candidate_admitted() {  # TREE-ISH HOST: classify committed bytes, never the checkout or ref name
-  local tree=$1 host=$2 path entry
+  local tree=$1 host=$2 path entry missing="" why fix
   [ "$host" = Darwin ] || return 0
   # State shares these hooks with core. Require its existing layout, including
   # regular (not symlink) checker/guard files; ambiguous mixed/core trees refuse.
+  # Every refusal names the candidate's shape and its remedy.
   for path in pyproject.toml run_agent.py hermes_cli agent; do
     if git cat-file -e "$tree:$path" 2>/dev/null; then
-      echo "scripts/check: portable core checks belong on a pool worker, not this Mac" >&2
+      echo "scripts/check: refused on this Mac: core candidate (has $path); portable core checks" \
+        "belong on a pool worker: run hermes-core-wt test/ship there" >&2
       return 2
     fi
   done
   for path in scripts/check hermes-sync shared-config.json scripts/state-push-guard tests/state_guard_rules.py; do
-    entry="$(git ls-tree "$tree" -- "$path")" || return 2
+    entry="$(git ls-tree "$tree" -- "$path")" || {
+      echo "scripts/check: refused on this Mac: unreadable candidate $tree; push it from a pool worker" >&2
+      return 2; }
     case "$entry" in
       "100644 blob "*|"100755 blob "*) ;;
-      *) echo "scripts/check: unknown candidate; portable core checks belong on a pool worker, not this Mac" >&2
-         return 2 ;;
+      *) missing="${missing:+$missing }$path" ;;
     esac
   done
+  [ -n "$missing" ] || return 0
+  case " $missing " in
+    *" scripts/check "*) why="no checker (missing or not a regular file: $missing)"
+      fix="Macs admit only the current state layout through its own checker; push it from a pool worker" ;;
+    *" hermes-sync "*|*" shared-config.json "*) why="unknown layout (missing or not a regular file: $missing)"
+      fix="push it from a pool worker" ;;
+    *) why="stale state layout (missing: $missing)"
+      fix="rebase it onto current origin/state, or push it from a pool worker" ;;
+  esac
+  echo "scripts/check: refused on this Mac: $why; $fix" >&2
+  return 2
 }
 judge() {  # judge TREE-ISH ARGS...: check out TREE-ISH alone and run its own scripts/check ARGS
   local tree=$1 tmp dir rc
diff --git a/tests/scripts/test_check_mac_admission.py b/tests/scripts/test_check_mac_admission.py
index 54edc39c3b7c3c745bdec6bef2eae3cdd3c5cbe9..84b429ce01043f0dc78da1b3d3d17dc88ca52ec1 100644
--- a/tests/scripts/test_check_mac_admission.py
+++ b/tests/scripts/test_check_mac_admission.py
@@ -99,6 +99,8 @@ def test_git_snapshot_push_refuses_before_historical_checker(tmp_path, caller, h
     refused = host == "Darwin"
     assert (result.returncode != 0) == refused, result.stdout + result.stderr
     assert ("pool worker" in result.stderr) == refused
+    if refused:  # the refusal names the candidate's shape, not only "core belongs on a pool worker"
+        assert ("no checker" if not candidate else "unknown layout") in result.stderr
     assert sentinel.exists() == (candidate and not refused)
     refs = _run(["git", "--git-dir", str(remote), "show-ref"], repo, env)
     assert refs.returncode == (1 if refused else 0), refs.stdout
diff --git a/tests/scripts/test_check_state_admission.py b/tests/scripts/test_check_state_admission.py
index 75ac4365a4f40de6ea3d4c85ffe44be289ee3f9d..5af0dd20b0cb511f6309ba4614771b3b9d7d19d5 100644
--- a/tests/scripts/test_check_state_admission.py
+++ b/tests/scripts/test_check_state_admission.py
@@ -98,6 +98,43 @@ def test_executable_state_files_admitted(candidate):
     assert admission(candidate).returncode == 0
 
 
+# Real refused shapes from review of PR #3346 (t_d53a0b05361c484e). None was found pushed from a
+# Mac (t_6f760c9577e4ef65), so they stay refused; the refusal must say which shape and what to do.
+REFUSED_SHAPES = {
+    # refs/heads/evidence/t_cd70b7f140dadd83-capacity-rollout: orphan evidence tree
+    "evidence-orphan": (("README.md", "rollout-kit.tgz"), "no checker",
+                        "push it from a pool worker"),
+    # bb-tuner/2026-10-28-*: state tree from before state had scripts/check
+    "state-without-checker": (("hermes-sync", "shared-config.json", "README.md"), "no checker",
+                              "push it from a pool worker"),
+    # state branch based before 808ded1b8b (no scripts/state-push-guard yet)
+    "stale-state": (("scripts/check", "hermes-sync", "shared-config.json"),
+                    "stale state layout (missing: scripts/state-push-guard tests/state_guard_rules.py)",
+                    "rebase it onto current origin/state"),
+    "unknown-with-checker": (("scripts/check", "README.md"), "unknown layout",
+                             "push it from a pool worker"),
+    "historical-core-without-checker": (("pyproject.toml", "hermes-sync"),
+                                        "core candidate (has pyproject.toml)",
+                                        "hermes-core-wt test/ship"),
+}
+
+
+@pytest.mark.parametrize("shape", sorted(REFUSED_SHAPES))
+def test_darwin_refusal_names_classification_and_remedy(candidate, shape):
+    repo, _ = candidate
+    files, classification, remedy = REFUSED_SHAPES[shape]
+    for rel in STATE_FILES:
+        (repo / rel).unlink()
+    for rel in files:
+        (repo / rel).parent.mkdir(parents=True, exist_ok=True)
+        (repo / rel).write_text("# fixture\n", encoding="utf-8")
+    result = admission(candidate)
+    assert result.returncode == 2
+    assert f"refused on this Mac: {classification}" in result.stderr
+    assert remedy in result.stderr
+    assert admission(candidate, "Linux").returncode == 0
+
+
 def test_admitted_candidate_runs_checker_and_preserves_failure(candidate):
     repo, env = candidate
     (repo / "scripts/check").write_text('print("candidate checker ran")\nraise SystemExit(7)\n',
-- 
