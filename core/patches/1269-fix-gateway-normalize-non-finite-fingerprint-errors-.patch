-    Args that already carry a double quote stay as-is. Empty parts (the trailing NUL) are dropped."""
-    return " ".join(
-        f'"{part}"' if any(c.isspace() for c in part) and '"' not in part else part
-        for part in parts
-        if part
-    ).strip()
-
-
 def _read_process_cmdline(pid: int) -> Optional[str]:
     """Process command line as one string: /proc, then psutil, then ``ps``.
 
diff --git a/gateway/status_command_line.py b/gateway/status_command_line.py
new file mode 100644
index 00000000000..c1650090428
--- /dev/null
+++ b/gateway/status_command_line.py
@@ -0,0 +1,17 @@
+"""Command-line rendering for gateway process identity checks."""
+
+
+def argv_to_command_line(parts) -> str:
+    """[daveey] One command-line string from an exact argv, for the identity matchers.
+
+    Whitespace-bearing args (``~/Applications/Hermes Python.app/...``, an inline ``-c`` source) are
+    double-quoted so the quote-aware tokenizer in ``_gateway_command_subcommand`` keeps each one a
+    single token. A space-joined argv (``ps -o command=``, a NUL->space ``/proc`` read) loses those
+    boundaries: the interpreter path splits in two, the ``-c`` walk stops at its second half, and a
+    Hermes runpy bootstrap (``python -I -c "import sys, runpy; …"``) stops matching as a gateway.
+    Args that already carry a double quote stay as-is. Empty parts (the trailing NUL) are dropped."""
+    return " ".join(
+        f'"{part}"' if any(c.isspace() for c in part) and '"' not in part else part
+        for part in parts
+        if part
+    ).strip()
diff --git a/tests/gateway/test_owner_liveness_drift.py b/tests/gateway/test_owner_liveness_drift.py
index 358d57693a1..03c77221f4d 100644
--- a/tests/gateway/test_owner_liveness_drift.py
+++ b/tests/gateway/test_owner_liveness_drift.py
@@ -58,6 +58,14 @@ def test_one_second_drift_keeps_owner_live(site, monkeypatch, tmp_path):
         assert _async_delegation_alive(monkeypatch, tmp_path) is True
 
 
+@pytest.mark.parametrize("junk", [float("inf"), float("-inf"), float("nan"), None, "abc"])
+@pytest.mark.parametrize("side", ["recorded", "current"])
+def test_junk_fingerprint_raises_contract_error(junk, side):
+    recorded, current = (junk, RECORDED) if side == "recorded" else (RECORDED, junk)
+    with pytest.raises((TypeError, ValueError)):
+        status.start_time_fingerprints_match(recorded, current)
+
+
 def test_far_fingerprint_is_still_a_recycled_pid(monkeypatch):
     monkeypatch.setattr(status, "get_process_start_time", lambda pid: RECORDED + 3600)
     assert _delivery_ledger_alive() is False
