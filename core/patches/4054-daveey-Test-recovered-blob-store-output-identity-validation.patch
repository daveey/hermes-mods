From 608185b126e557d5236ae8faec9100bf2fdb9c44 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 02:20:04 +0000
Subject: [PATCH] [daveey] Test recovered blob store output identity validation

The store-error fixture only injected nonzero exit status, leaving the defensive stdout identity predicate untested. Supply rc0/wrong OID after a real expected pre-hash of binary bytes and assert cannot-store refusal. Production unchanged.

Proof: classifier 35 passed; exact removal of stored.stdout identity guard yields DID NOT RAISE in the new test; restored upstream-sync suites 190 passed across 7 files, zero skips. scripts/check: 20 checks ok.
---
 tests/scripts/ci/test_upstream_sync_review.py | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/tests/scripts/ci/test_upstream_sync_review.py b/tests/scripts/ci/test_upstream_sync_review.py
index 00ae7cb86c..24d0b49b69 100644
--- a/tests/scripts/ci/test_upstream_sync_review.py
+++ b/tests/scripts/ci/test_upstream_sync_review.py
@@ -339,6 +339,36 @@ def test_recover_blob_git_failure_refuses(world, monkeypatch, phase):
         review._recover_blob(checkout, oid.decode("ascii"))
 
 
+def test_recover_blob_zero_exit_wrong_store_identity_refuses(world, monkeypatch):
+    _, checkout = world
+    data = b"\x00\xff\r\n\x80"
+    oid = subprocess.run(["git", "hash-object", "--stdin"], input=data, capture_output=True, check=True).stdout.strip()
+    wrong_oid = b"0" * len(oid)
+    assert wrong_oid != oid
+    monkeypatch.setattr(sync, "gh_cli", lambda *a, **k: subprocess.CompletedProcess(a, 0, json.dumps({
+        "encoding": "base64", "content": base64.b64encode(data).decode("ascii")}), ""))
+    run = subprocess.run
+    phases = []
+
+    def wrong_store_identity(cmd, **kwargs):
+        if "hash-object" not in cmd:
+            return run(cmd, **kwargs)
+        assert kwargs["input"] == data
+        if "-w" in cmd:
+            assert phases == ["hash"]
+            phases.append("store")
+            return subprocess.CompletedProcess(cmd, 0, wrong_oid + b"\n", b"")
+        result = run(cmd, **kwargs)
+        assert result.returncode == 0 and result.stdout.strip() == oid
+        phases.append("hash")
+        return result
+
+    monkeypatch.setattr(review.subprocess, "run", wrong_store_identity)
+    with pytest.raises(review.ClassifyError, match="cannot store"):
+        review._recover_blob(checkout, oid.decode("ascii"))
+    assert phases == ["hash", "store"]
+
+
 # --- Controls ---------------------------------------------------------------------------------------------------
 
 def test_mechanical_sync_lands_without_any_review(world, land_stub):
