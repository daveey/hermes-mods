From d96ebe6ea934b463efe967d152275a83ebaf306d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 05:38:08 +0000
Subject: [PATCH] [daveey] Use sanitized UTF-8 subprocesses for ancestry
 diagnosis

---
 hermes_cli/kanban_dead_ancestry.py | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_dead_ancestry.py b/hermes_cli/kanban_dead_ancestry.py
index 6605f6fd7cc..b9f74a56ba8 100644
--- a/hermes_cli/kanban_dead_ancestry.py
+++ b/hermes_cli/kanban_dead_ancestry.py
@@ -44,14 +44,21 @@ def ancestry_probes(cmd: str, cwd: str) -> list[tuple[str, str]]:
     return found
 
 
+def _git_env() -> dict[str, str]:
+    from tools.environments.local import build_subprocess_env
+
+    return build_subprocess_env(
+        extra={"GIT_NO_LAZY_FETCH": "1", "GIT_TERMINAL_PROMPT": "0"})
+
+
 def _git(repo: str, args: list[str], deadline: float, *, data: str | None = None) -> str:
     remaining = deadline - time.monotonic()
     if remaining <= 0:
         raise subprocess.TimeoutExpired("git", BUDGET_SECONDS)
     result = subprocess.run(["git", "--no-pager", "-C", repo, *args],
-                            input=data, capture_output=True, text=True,
+                            input=data, capture_output=True, text=True, encoding="utf-8",
                             timeout=remaining, check=True,
-                            env={**os.environ, "GIT_NO_LAZY_FETCH": "1", "GIT_TERMINAL_PROMPT": "0"})
+                            env=_git_env())
     return result.stdout.strip()
 
 
@@ -88,7 +95,7 @@ def _landed(repo: str, sha: str, deadline: float) -> dict | None:
 
 def _find_patch(repo: str, tip: str, full: str, patch_id: str, deadline: float) -> str | None:
     # Stream diffs: no per-commit process loop and no full-history diff in Python memory.
-    env = {**os.environ, "GIT_NO_LAZY_FETCH": "1", "GIT_TERMINAL_PROMPT": "0"}
+    env = _git_env()
     log = subprocess.Popen(
         ["git", "--no-pager", "-C", repo, "log", "--no-merges", "--no-ext-diff",
          "--no-textconv", "--no-renames", "-p", tip, "--not", f"{full}~1", "--"],
@@ -98,7 +105,8 @@ def _find_patch(repo: str, tip: str, full: str, patch_id: str, deadline: float)
         if remaining <= 0:
             return None
         ids = subprocess.run(["git", "-C", repo, "patch-id", "--stable"], stdin=log.stdout,
-                             capture_output=True, text=True, timeout=remaining, check=True, env=env)
+                             capture_output=True, text=True, encoding="utf-8",
+                             timeout=remaining, check=True, env=env)
         if log.wait(timeout=max(0.001, deadline - time.monotonic())) != 0:
             return None
         for line in ids.stdout.splitlines():
-- 
