From 046910a388d2cff32fbdf52b892c00db53a1015c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 11:33:57 +0000
Subject: [PATCH] fix(sessions): consume elapsed display deadlines instead of
 rearming [daveey]

An active annotation can survive its last_active+300 boundary. SessionsRuntime
passes that elapsed boundary to SessionsSource.refresh_at on every capture.
Clamping it to now rearmed ChangeFeed immediately after its own publication;
with selectors clean, the next capture re-dirtied them and repeated forever.
Ignore elapsed deadlines already observed by this capture. Keep future display
boundaries, native source hints, capture cooldown and 30s reconciliation intact.

Proof: idle-minute regression RED at immediate deadline 100.0, GREEN with at
most three captures per simulated idle minute. Sessions source/startup and
ChangeFeed suites: 22 passed. No live serve restart/signals.


---
 hermes_cli/sessions_native_source.py          |  8 +++++++-
 .../hermes_cli/test_sessions_native_source.py | 20 +++++++++++++++++++
 2 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/sessions_native_source.py b/hermes_cli/sessions_native_source.py
index 79cc7a22c8..742ff043ee 100644
--- a/hermes_cli/sessions_native_source.py
+++ b/hermes_cli/sessions_native_source.py
@@ -87,8 +87,14 @@ class SessionsSource:
             wake()
 
     def refresh_at(self, wall_deadline):
+        # A capture already observes elapsed boundaries. Rearming one at now
+        # feeds its own publication straight back into capture forever when a
+        # canonical row still carries an active annotation after that boundary.
+        delay = wall_deadline - time.time()
+        if delay <= 0:
+            return
         with self._lock:
-            self._refresh = min(self._refresh, time.monotonic() + max(0, wall_deadline - time.time()))
+            self._refresh = min(self._refresh, time.monotonic() + delay)
 
     def _deadline(self):
         deadlines = [max(self._next_capture, self._retry.get(key, 0)) for key in self._dirty]
diff --git a/tests/hermes_cli/test_sessions_native_source.py b/tests/hermes_cli/test_sessions_native_source.py
index 3eecc2211a..a5959c246d 100644
--- a/tests/hermes_cli/test_sessions_native_source.py
+++ b/tests/hermes_cli/test_sessions_native_source.py
@@ -118,6 +118,26 @@ def test_time_boundary_and_total_bytes(source):
     assert owner.store._fact_bytes <= owner.store._fact_limit
 
 
+def test_elapsed_display_deadline_does_not_spin_idle_minute(source):
+    owner, clock, calls = source
+    original = owner.reader
+    def read(name, selector):
+        owner.refresh_at(clock[0] - 1)  # canonical annotation can still say active after its boundary
+        return original(name, selector)
+    owner.reader = read
+    owner.demand('sessions', {'id': 'one'})
+    captures = 0
+    end = clock[0] + 60
+    while clock[0] <= end:
+        capture = owner.capture(None, CaptureBudget())
+        owner.commit(capture)
+        captures += 1
+        assert capture.next_deadline > clock[0], 'expired display boundary must not rearm itself'
+        clock[0] = capture.next_deadline
+    assert captures <= 3
+    assert len(calls) == captures
+
+
 def test_expiry_watch_failure_and_close(source):
     owner, clock, _ = source
     owner.demand('sessions', {'id': 'one'})
