From eddf6d92ce75cf09543c5f0858ebd4e7e9b8f06f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:24:53 +0000
Subject: [PATCH] fix(kanban): create_overlap log line names the matched cards
 [daveey]

A refusal whose matches are all on other gateways writes no board event, so
agent.log was the only trace and it carried only a count (hub
t_01a189b2d186a986 could not tell which cards a 21:51 refusal named). The line
now lists gateway/board/id and the reason for up to 8 matches.
---
 hermes_cli/kanban_overlap.py                       |  5 ++++-
 tests/tools/test_kanban_create_overlap_url_slug.py | 10 ++++++++++
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_overlap.py b/hermes_cli/kanban_overlap.py
index b21260c40d7..1c231c8e598 100644
--- a/hermes_cli/kanban_overlap.py
+++ b/hermes_cli/kanban_overlap.py
@@ -304,7 +304,10 @@ def record(conn: Optional[sqlite3.Connection], task_id: Optional[str], *, outcom
     payload = {"outcome": outcome, "title": title, "reason": reason or None, "session_id": session_id,
                "matches": [{"id": m["id"], "board": m["board"], "gateway": m["gateway"], "status": m["status"]}
                            for m in public(matches)]}
-    _log.info("kanban create overlap: %s %r (%d matches)", outcome, title, len(matches))
+    # The matched cards ride in the log line: a refusal whose matches are all on other gateways records no
+    # event anywhere, so this line is the only trace an audit can read (hub t_01a189b2d186a986).
+    _log.info("kanban create overlap: %s %r (%d matches: %s)", outcome, title, len(matches),
+              ", ".join(f"{m['gateway']}/{m['board']}/{m['id']} ({m['why']})" for m in matches[:MAX_SHOWN]))
     try:
         if conn is not None and task_id:
             with kb.write_txn(conn):
diff --git a/tests/tools/test_kanban_create_overlap_url_slug.py b/tests/tools/test_kanban_create_overlap_url_slug.py
index 74bd57a7477..3e8a366dde3 100644
--- a/tests/tools/test_kanban_create_overlap_url_slug.py
+++ b/tests/tools/test_kanban_create_overlap_url_slug.py
@@ -206,3 +206,13 @@ def test_legacy_row_without_a_qualified_twin_still_counts(home, tmp_path):
     out = _create("Desktop session GET stalls recurring after 24c3eda at 14:26 PDT", "")
     assert out.get("code") == "create_overlap", out
     assert [m["id"] for m in out["matches"]] == [STALLS[0]]
+
+
+def test_a_refusal_matching_only_remote_cards_logs_which_cards(macbook_hermes, caplog):
+    """No board event is written when every match is on another gateway; the log line is the audit trail."""
+    import logging
+    with caplog.at_level(logging.INFO, logger="hermes_cli.kanban_overlap"):
+        out = _create("David-MBP desktop backend timeouts again: 40 in 30 min", "")
+    assert out.get("code") == "create_overlap", out
+    line = next(r.getMessage() for r in caplog.records if "create overlap: refused" in r.getMessage())
+    assert f"macbook/hermes/{TIMEOUTS[0]} (titles share" in line, line
-- 
