diff --git a/tests/hermes_platform/test_wake_clock.py b/tests/hermes_platform/test_wake_clock.py
new file mode 100644
index 0000000000000000000000000000000000000000..b3930cbc66658fba593b3b7090e8f3c70289d21f
--- /dev/null
+++ b/tests/hermes_platform/test_wake_clock.py
@@ -0,0 +1,58 @@
+"""Native ABI decoding uses a fake sysctl; platform dispatch runs on its real host."""
+
+import ctypes
+
+import pytest
+
+from hermes_platform import wake_clock
+
+
+class FakeLib:
+    def __init__(self, *, ticks=12_000_000_000, size=8, status=0,
+                 numer=125, denom=3, scale_status=0):
+        self.ticks, self.size, self.status = ticks, size, status
+        self.numer, self.denom, self.scale_status = numer, denom, scale_status
+
+    def sysctlbyname(self, name, out, size, new, length):
+        assert name == b"kern.wake_abs_time"
+        assert new is None and length == 0
+        ctypes.cast(out, ctypes.POINTER(ctypes.c_uint64))[0] = self.ticks
+        ctypes.cast(size, ctypes.POINTER(ctypes.c_size_t))[0] = self.size
+        return self.status
+
+    def mach_timebase_info(self, out):
+        scale = ctypes.cast(out, ctypes.POINTER(wake_clock._Timebase)).contents
+        scale.numer, scale.denom = self.numer, self.denom
+        return self.scale_status
+
+
+def test_native_ticks_convert_to_monotonic_seconds():
+    assert wake_clock._darwin_wake_awake_s(FakeLib()) == 500.0
+
+
+@pytest.mark.parametrize("overrides", [
+    {"ticks": 0}, {"size": 4}, {"status": -1},
+    {"scale_status": 1}, {"numer": 0}, {"denom": 0},
+])
+def test_missing_or_invalid_native_signal(overrides):
+    assert wake_clock._darwin_wake_awake_s(FakeLib(**overrides)) is None
+
+
+@pytest.mark.platforms("not macos")
+def test_unsupported_host_has_no_native_signal():
+    assert wake_clock.host_wake_awake_s() is None
+
+
+@pytest.mark.platforms("macos")
+def test_darwin_entry_uses_native_reader(monkeypatch):
+    monkeypatch.setattr(wake_clock, "_darwin_api", lambda: FakeLib())
+    assert wake_clock.host_wake_awake_s() == 500.0
+
+
+@pytest.mark.platforms("macos")
+@pytest.mark.parametrize("error", [OSError, AttributeError])
+def test_unavailable_native_api_is_no_signal(monkeypatch, error):
+    def unavailable():
+        raise error("unavailable")
+    monkeypatch.setattr(wake_clock, "_darwin_api", unavailable)
+    assert wake_clock.host_wake_awake_s() is None
diff --git a/tests/hermes_state/test_fresh_process_wake_grace.py b/tests/hermes_state/test_fresh_process_wake_grace.py
new file mode 100644
index 0000000000000000000000000000000000000000..21680e5c400f627d8b32278838de651d2bea1b5c
--- /dev/null
+++ b/tests/hermes_state/test_fresh_process_wake_grace.py
@@ -0,0 +1,46 @@
+"""A waiter born after resume must respect the host's remaining awake grace."""
+
+import pytest
+
+import hermes_state_wake_grace as grace
+
+
+@pytest.fixture(autouse=True)
+def fresh_tracker(monkeypatch):
+    monkeypatch.setattr(grace, "suspended_total_s", lambda: 1000.0)
+    monkeypatch.setattr(grace, "_awake_now", lambda: 500.0)
+    grace._reset_for_tests()
+    yield
+    grace._reset_for_tests()
+
+
+@pytest.mark.parametrize("wake,expected", [
+    (490.0, True), (300.0, False), (410.0, False),
+    (410.001, True), (None, False), (501.0, False),
+])
+def test_fresh_tracker_uses_host_wake(monkeypatch, wake, expected):
+    monkeypatch.setattr(grace, "host_wake_awake_s", lambda: wake, raising=False)
+    assert grace.recently_woke() is expected
+    assert grace.lapsed_row_reclaimable("live", 1.0, 2.0) is not expected
+
+
+def test_host_grace_expires_without_restarting_on_each_poll(monkeypatch):
+    monkeypatch.setattr(grace, "host_wake_awake_s", lambda: 490.0, raising=False)
+    assert grace.recently_woke()
+    monkeypatch.setattr(grace, "_awake_now", lambda: 580.0)
+    assert not grace.recently_woke()
+
+
+def test_host_signal_does_not_require_process_suspend_baseline(monkeypatch):
+    monkeypatch.setattr(grace, "suspended_total_s", lambda: None)
+    monkeypatch.setattr(grace, "host_wake_awake_s", lambda: 490.0, raising=False)
+    assert grace.recently_woke()
+
+
+def test_absent_host_signal_retains_process_suspend_detection(monkeypatch):
+    monkeypatch.setattr(grace, "host_wake_awake_s", lambda: None, raising=False)
+    assert not grace.recently_woke()
+    monkeypatch.setattr(grace, "suspended_total_s", lambda: 1600.0)
+    assert grace.recently_woke()
+    monkeypatch.setattr(grace, "_awake_now", lambda: 590.0)
+    assert not grace.recently_woke()
