---
diff --git a/tests/hermes_cli/test_kanban_worker_node.py b/tests/hermes_cli/test_kanban_worker_node.py
index 36e7ecfcd60..fdd54c39ee2 100644
--- a/tests/hermes_cli/test_kanban_worker_node.py
+++ b/tests/hermes_cli/test_kanban_worker_node.py
@@ -39,9 +39,6 @@
     def __init__(self, root, name, svc, monkeypatch, *, pickup):
         self.home, self.name, self.svc, self.mp = root / name / ".hermes", name, svc, monkeypatch
         self.home.mkdir(parents=True)
-        # Durable create authority needs a genuinely registered owning chat in this gateway's own state.db.
-        from tests.tools.test_kanban_create_overlap import register_chat
-        self.chat = register_chat(self.home, f"20261123_120000_{name.replace('-', '_')}_owner")
         self.enter()
         from tests.hermes_cli.test_kanban_managed_pin_policy import _managed_yaml
         (self.home / "config.yaml").write_text(
@@ -53,7 +50,7 @@
 
     def enter(self):
         self.mp.setenv("HERMES_HOME", str(self.home))
-        self.mp.setenv("HERMES_SESSION_ID", self.chat)
+
         sync.set_lease_client(ksc.HubLeaseClient(self.svc.hub(self.name)))
         wn.set_registry_fetch(lambda: {"me": self.name, "machines": seen_now(MACHINES.values())})
         return self.conn if hasattr(self, "conn") else None
@@ -165,7 +162,13 @@
 
 def _tool_create(args):
     from tools import kanban_tools
-    return json.loads(kanban_tools._handle_create(args))
+    from hermes_constants import get_hermes_home
+    from tests.tools.test_kanban_create_overlap import register_chat
+    # Only tool callers need a registered chat; background gateway fixtures do not.
+    session = register_chat(get_hermes_home())
+    with pytest.MonkeyPatch.context() as caller:
+        caller.setenv("HERMES_SESSION_ID", session)
+        return json.loads(kanban_tools._handle_create(args))
 
 
 def test_tool_create_runs_on_and_placement_to_an_enrolled_machine(gws, monkeypatch, caplog):
