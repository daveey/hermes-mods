From 2f0f788ed6d0c8e3e72d4536adc971625b5ec7ea Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 04:35:43 +0000
Subject: [PATCH] [daveey] Preserve redirection binding order across command
 position

Why: final-stdin provenance consumed a view that appended leading redirects after later bindings. Expose the executable by placing those leading redirects immediately after it, preserving their relative order and lexical token metadata. Proof: both public-scanner findings fail before the fix and pass after; 29 focused tests include a real Bash harmless-marker matrix of command positions, copies, moves, closes, rebinds and quoted/escaped argv. No lifecycle operation is executed.
---
 cron/lifecycle_guard.py                       | 10 ++---
 .../test_lifecycle_guard_redirection_order.py | 40 +++++++++++++++++++
 2 files changed, 45 insertions(+), 5 deletions(-)
 create mode 100644 tests/cron/test_lifecycle_guard_redirection_order.py

diff --git a/cron/lifecycle_guard.py b/cron/lifecycle_guard.py
index 11584c64e6..f8b3416a5e 100644
--- a/cron/lifecycle_guard.py
+++ b/cron/lifecycle_guard.py
@@ -1034,7 +1034,7 @@ def _peel_external_time(segment: list[str], index: int) -> int:
 
 def _command_segment_views(segment: list[str]) -> list[list[str]]:
     """*segment* as written, then without its leading reserved words when it has any, then each
-    of those with its command-position redirections moved to the end (see
+    of those with its command-position redirections moved just after the executable (see
     ``_hoist_command_redirections``). Callers read every view, so peeling only ever ADDS a
     reference. Without the peeled view `time ./x.sh`, `if true; then ./x.sh; fi` and
     `{ ./x.sh; }` read the keyword as the command and never open ``./x.sh``; without the hoisted
@@ -1051,9 +1051,9 @@ def _command_segment_views(segment: list[str]) -> list[list[str]]:
 
 def _hoist_command_redirections(segment: list[str]) -> list[str]:
     """*segment* with each redirection that sits where the command word is read (before it, or
-    glued to it: `< f.py python3`, `sudo < f.sh bash`, `python3<f.py`) moved to the end, where the
-    stdin scan reads it. A shell applies a simple command's redirections wherever they appear,
-    so this is the same command. Only the command position is split: an argument such as
+    glued to it: `< f.py python3`, `sudo < f.sh bash`, `python3<f.py`) moved just after the
+    executable, before any later redirections. Keep their left-to-right binding order while
+    exposing the command. Only the command position is split: an argument such as
     ``bash -c 'python3<f.py'`` may be quoted program text, and its payload is re-scanned whole."""
     tokens = list(segment)
     moved: list[str] = []
@@ -1070,7 +1070,7 @@ def _hoist_command_redirections(segment: list[str]) -> list[str]:
             # `python3<f.py`: a word is the command up to its first `<`/`>`.
             glued = min((p for p in (word.find("<"), word.find(">")) if p >= 0), default=-1)
             if glued < 0:
-                break
+                return tokens[:index + 1] + moved + tokens[index + 1:]
             tokens[index: index + 1] = [word[:glued], word[glued:]]
             index += 1
             width = _redirection_width(tokens[index])
diff --git a/tests/cron/test_lifecycle_guard_redirection_order.py b/tests/cron/test_lifecycle_guard_redirection_order.py
new file mode 100644
index 0000000000..3b43ea9f32
--- /dev/null
+++ b/tests/cron/test_lifecycle_guard_redirection_order.py
@@ -0,0 +1,40 @@
+"""Command exposure must preserve the shell's left-to-right fd bindings."""
+import subprocess
+
+import pytest
+
+from cron.lifecycle_guard import scan_gateway_lifecycle
+
+
+@pytest.mark.parametrize("command", ["<clean bash <bad", "<clean bash 3<bad <&3"])
+def test_command_position_stdin_override(tmp_path, command):
+    (tmp_path / "bad").write_text(" ".join(["hermes", "gateway", "restart"]) + "\n", encoding="utf-8")
+    (tmp_path / "clean").write_text("echo clean\n", encoding="utf-8")
+    assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (True, None)
+
+
+# Each sequence is crossed with every command-word position. Only harmless
+# marker files are ever executed; lifecycle text is written after Bash exits.
+@pytest.mark.parametrize("redirects, final", [
+    (["<clean", "<bad"], "bad"),
+    (["<bad", "<clean"], "clean"),
+    (["<clean", "3<bad", "<&3"], "bad"),
+    (["3<bad", "4<&3", "3<clean", "<&4"], "bad"),
+    (["3<bad", "4>&3-", "3<clean", "<&4"], "bad"),
+    (["3<bad", "<&3-", "<clean"], "clean"),
+    (["<bad", "0<&-", "<clean"], "clean"),
+    (["3<bad", "3>out", "<clean"], "clean"),
+    (["3<clean", "4<&3", "3<bad", "<&4"], "clean"),
+])
+@pytest.mark.parametrize("argument", ["", "'0<&-'", r"0\<\&-"])
+def test_redirection_order_against_bash(tmp_path, redirects, final, argument):
+    for position in range(len(redirects) + 1):
+        command = " ".join(redirects[:position] + ["bash -s"] + redirects[position:] + [argument])
+        for name in ("bad", "clean"):
+            (tmp_path / name).write_text(f"printf '{name}\\n'\n", encoding="utf-8")
+        result = subprocess.run(["bash", "--noprofile", "--norc", "-c", command],
+                                cwd=tmp_path, capture_output=True, text=True, encoding="utf-8", timeout=5, check=False)
+        assert result.returncode == 0, (command, result.stderr)
+        assert result.stdout == final + "\n", command
+        (tmp_path / "bad").write_text(" ".join(["hermes", "gateway", "restart"]) + "\n", encoding="utf-8")
+        assert scan_gateway_lifecycle(command, cwd=str(tmp_path)) == (final == "bad", None), command
