From ad397d545a08c9d15fae119178f00ba5610f4951 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 06:54:00 +0000
Subject: [PATCH] [daveey] Auto-continue kickoff clears a stale
 _turn_owner_refusal before its submit

A refusal left by an earlier ownership-refused prompt.submit survived a kickoff refusal that returns before
_admit_prompt_turn clears it, so _auto_continue_refused misread it as an owner refusal and skipped the
pause watcher re-arm (30 s backoff instead). PR #1921 review nit.
---
 .../test_update_pause_refused_kickoff.py        | 17 +++++++++++++++++
 tui_gateway/session_auto_continue.py            |  2 ++
 2 files changed, 19 insertions(+)

diff --git a/tests/tui_gateway/test_update_pause_refused_kickoff.py b/tests/tui_gateway/test_update_pause_refused_kickoff.py
index d1fb6bb149..382cdeeb5a 100644
--- a/tests/tui_gateway/test_update_pause_refused_kickoff.py
+++ b/tests/tui_gateway/test_update_pause_refused_kickoff.py
@@ -303,3 +303,20 @@ def test_paused_continuation_refused_for_ownership_does_not_rearm(env, monkeypat
     assert env.watchers == []
     assert session["_auto_continue_retry_after"] > time.monotonic() + 20.0
     assert any("owner refusal SESSION_MOVED" in r.getMessage() for r in caplog.records)
+
+
+def test_stale_owner_refusal_from_an_earlier_submit_does_not_block_the_rearm(env, caplog):
+    """``_turn_owner_refusal`` left by an earlier ownership-refused prompt.submit survives a refusal that returns
+    before _admit_prompt_turn clears it (here: the hold re-taken at admission). The kickoff clears it before its
+    own submit, so that refusal re-arms the watcher instead of being misread as an owner refusal."""
+    import logging
+    caplog.set_level(logging.WARNING)
+    record_turn_start(env.home, "session-key", "the prompt")
+    mark_turn_paused(env.home, "session-key", up.PAUSE_REASON)
+    session = _session(_turn_owner_refusal="SESSION_MOVED")  # stale: an earlier user submit was refused
+
+    server._maybe_schedule_auto_continue("sid", session, "session-key")
+
+    assert env.watchers == [("sid", "session-key")]
+    assert session["_auto_continue_retry_after"] < time.monotonic() + 15.0  # the short re-arm backoff
+    assert not any("owner refusal" in r.getMessage() for r in caplog.records)
diff --git a/tui_gateway/session_auto_continue.py b/tui_gateway/session_auto_continue.py
index 9d9d613469..ceac6b0af6 100644
--- a/tui_gateway/session_auto_continue.py
+++ b/tui_gateway/session_auto_continue.py
@@ -332,6 +332,8 @@ def _maybe_schedule_auto_continue(sid: str, session: dict, session_key: str) ->
             session["_auto_continue_killed_jobs"] = marker.get("killed_jobs", [])
             # [daveey] A continued at-most-once turn keeps the contract: off again at its first tool.
             session["_marker_until_tool"] = bool(marker.get("until_tool"))
+            # Read back by _auto_continue_refused: only this submit's own ownership fence may set it.
+            session.pop("_turn_owner_refusal", None)
         try:
             from gateway.warning_notifications import render_notification
             diagnostic = marker.get("notification_category") == "diagnostic"
