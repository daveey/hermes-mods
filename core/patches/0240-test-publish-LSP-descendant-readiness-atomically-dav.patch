From f93dc86cfe594c34af56cf27c9f95c10d32f1ea7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 17:22:43 +0000
Subject: [PATCH 240/248] test: publish LSP descendant readiness atomically
 [daveey]

---
 tests/agent/lsp/_mock_lsp_server.py | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/tests/agent/lsp/_mock_lsp_server.py b/tests/agent/lsp/_mock_lsp_server.py
index c02c13dcf1..08c2a27700 100644
--- a/tests/agent/lsp/_mock_lsp_server.py
+++ b/tests/agent/lsp/_mock_lsp_server.py
@@ -89,7 +89,11 @@ def main():
                 "-c",
                 "import os, pathlib, signal, time; "
                 "signal.signal(signal.SIGTERM, signal.SIG_IGN); "
-                "pathlib.Path(os.environ['MOCK_LSP_CHILD_PID']).write_text(str(os.getpid())); "
+                # Publish readiness atomically: existence must imply a complete PID.
+                "pid_file = pathlib.Path(os.environ['MOCK_LSP_CHILD_PID']); "
+                "pending = pid_file.with_suffix('.pending'); "
+                "pending.write_text(str(os.getpid())); "
+                "pending.replace(pid_file); "
                 "time.sleep(60)",
             ],
             env=os.environ,
