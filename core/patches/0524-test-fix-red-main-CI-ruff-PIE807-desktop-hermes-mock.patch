 .../src/app/session/hooks/use-prompt-actions/index.test.tsx   | 2 ++
 tests/tui_gateway/test_credential_failure.py                  | 4 ++--
 3 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/app/chat/session-tile-attachments.test.tsx b/apps/desktop/src/app/chat/session-tile-attachments.test.tsx
index 4ad4f82a84..d1e672f003 100644
--- a/apps/desktop/src/app/chat/session-tile-attachments.test.tsx
+++ b/apps/desktop/src/app/chat/session-tile-attachments.test.tsx
@@ -30,6 +30,8 @@ vi.mock('@/i18n', () => ({
 
 vi.mock('@/hermes', () => ({
   HermesGateway: class {},
+  getApiRequestConnection: () => null,
+  getApiRequestProfile: () => null,
   PROMPT_SUBMIT_REQUEST_TIMEOUT_MS: 1_000,
   setApiRequestProfile: vi.fn(),
   transcribeAudio: vi.fn()
diff --git a/apps/desktop/src/app/session/hooks/use-prompt-actions/index.test.tsx b/apps/desktop/src/app/session/hooks/use-prompt-actions/index.test.tsx
index a9d97def96..34d7b6c900 100644
--- a/apps/desktop/src/app/session/hooks/use-prompt-actions/index.test.tsx
+++ b/apps/desktop/src/app/session/hooks/use-prompt-actions/index.test.tsx
@@ -50,6 +50,8 @@ beforeEach(() => {
 })
 
 vi.mock('@/hermes', () => ({
+  getApiRequestConnection: () => null,
+  getApiRequestProfile: () => null,
   getLatestSessionMessages: vi.fn(async () => ({ messages: [], session_id: 'session' })),
   getProfiles: vi.fn(async () => ({ profiles: [] })),
   getSession: vi.fn(),
diff --git a/tests/tui_gateway/test_credential_failure.py b/tests/tui_gateway/test_credential_failure.py
index f1ee99fc02..b2dd3d6e3d 100644
--- a/tests/tui_gateway/test_credential_failure.py
+++ b/tests/tui_gateway/test_credential_failure.py
@@ -113,7 +113,7 @@ def test_named_profile_failure_is_classified_before_scope_exits(tmp_path, monkey
     monkeypatch.setattr("hermes_cli.profiles.profile_exists", lambda name: name == "named")
     monkeypatch.setattr(server, "_profile_home", lambda name: named)
     monkeypatch.setattr(server, "_resolve_startup_runtime", lambda: ("m", "anthropic"))
-    monkeypatch.setattr(server, "_load_cfg", lambda: {})
+    monkeypatch.setattr(server, "_load_cfg", dict)
     def fail(*a, **kw):
         raise AuthError("opaque")
     monkeypatch.setattr(server, "_resolve_agent_model_runtime", fail)
@@ -133,7 +133,7 @@ def test_deferred_build_error_and_rpc_carry_exhaustion(tmp_path, monkeypatch):
     monkeypatch.setenv("HERMES_HOME", str(tmp_path))
     pool(tmp_path, [row(4102444800)])
     monkeypatch.setattr(server, "_resolve_startup_runtime", lambda: ("m", "anthropic"))
-    monkeypatch.setattr(server, "_load_cfg", lambda: {})
+    monkeypatch.setattr(server, "_load_cfg", dict)
     events = []
     monkeypatch.setattr(server, "_emit", lambda kind, sid, payload: events.append((kind, payload)))
     session = _fail_build(monkeypatch, ProviderNotConfiguredError("opaque"))
