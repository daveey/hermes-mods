From bdc727251dfc7c77882c021488d21fcd18f742b6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 23:48:17 +0000
Subject: [PATCH] [daveey] Drop persistent safety observation before metrics
 downgrade

---
 hermes_cli/machine_drain_metrics.py           |  7 ++++++
 .../test_machine_persistent_jobs.py           | 23 +++++++++++++++++++
 2 files changed, 30 insertions(+)
 create mode 100644 tests/hermes_cli/test_machine_persistent_jobs.py

diff --git a/hermes_cli/machine_drain_metrics.py b/hermes_cli/machine_drain_metrics.py
index febfe22e9d623ed294dc6298b66d9ccfcbde88de..67e912e9d5dc4bfd6ffe848843a7d7f8f4bac7bf 100644
--- a/hermes_cli/machine_drain_metrics.py
+++ b/hermes_cli/machine_drain_metrics.py
@@ -57,6 +57,13 @@ def send_compatible(send, sample, on_counters_rejected=None):
     except HubError as exc:
         if exc.status != 400:
             raise
+        # A rejected safety observation is UNKNOWN on every downgrade, not a
+        # reason to disable unrelated throughput counters. Never replay its zero.
+        persistent = ("persistent_jobs", "persistent_jobs_at_ms")
+        if any(k in sample for k in persistent):
+            from hermes_cli.machine_cpu_metrics import FIELDS as CPU
+            return send_compatible(send, {k: v for k, v in sample.items()
+                                          if k not in persistent and k not in CPU}, on_counters_rejected)
         if "tokens_by_model" in sample:
             # A scalar-capable Board may predate the model map. Keep its counters
             # enabled, and never restamp the already attempted CPU sample.
diff --git a/tests/hermes_cli/test_machine_persistent_jobs.py b/tests/hermes_cli/test_machine_persistent_jobs.py
new file mode 100644
index 0000000000000000000000000000000000000000..c67f38c44eb9c5f23e13d8063a03cc25b9820e0d
--- /dev/null
+++ b/tests/hermes_cli/test_machine_persistent_jobs.py
@@ -0,0 +1,23 @@
+"""Persistent-work safety observations must fail closed across Board downgrades."""
+from hermes_cli import machine_drain_metrics as drain
+from hermes_cli.kanban_sync_client import HubError
+
+
+def test_persistent_pair_rejection_preserves_counters_without_replaying_safety():
+    calls, rejected = [], []
+    sample = {"active_card_runs": 0, "persistent_jobs": 0, "persistent_jobs_at_ms": 1000,
+              "tokens_io_total": 42, "tokens_by_model": {"model": [42, 0]},
+              "cpu_busy_pct": 1, "cpu_busy_window_ms": 1000, "cpu_busy_sample_end_ms": 1000}
+
+    def send(payload):
+        calls.append(dict(payload))
+        if "persistent_jobs" in payload:
+            raise HubError(400, "unknown field(s): persistent_jobs, persistent_jobs_at_ms")
+        return "ok"
+
+    assert drain.send_compatible(send, sample, lambda: rejected.append(True)) == "ok"
+    assert len(calls) == 2
+    assert calls[-1] == {"active_card_runs": 0, "tokens_io_total": 42,
+                         "tokens_by_model": {"model": [42, 0]}}
+    assert rejected == []
+    assert sample["persistent_jobs"] == 0
-- 
2.43.0

