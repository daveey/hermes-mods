From 2ade8fdc8b8141d0374d5455175b550cb58d3d46 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 10:07:24 +0000
Subject: [PATCH] ci(metrics): exercise native memory regressions on Darwin
 [daveey]

---
 .github/workflows/native-memory-macos.yml | 50 +++++++++++++++++++++++
 tests/ci/test_native_memory_workflow.py   | 30 ++++++++++++++
 2 files changed, 80 insertions(+)
 create mode 100644 .github/workflows/native-memory-macos.yml
 create mode 100644 tests/ci/test_native_memory_workflow.py

diff --git a/.github/workflows/native-memory-macos.yml b/.github/workflows/native-memory-macos.yml
new file mode 100644
index 00000000000..b05f87bea50
--- /dev/null
+++ b/.github/workflows/native-memory-macos.yml
@@ -0,0 +1,50 @@
+name: Native memory (macOS)
+
+# The generic OS lane is disabled in this fork. These ABI and no-fork
+# regressions must execute on Darwin before a memory-reader change lands.
+on:
+  pull_request:
+    paths: &memory-paths
+      - 'hermes_cli/machine_memory_darwin.py'
+      - 'hermes_cli/machine_metrics.py'
+      - 'tests/hermes_cli/test_machine_memory_darwin.py'
+      - 'tests/hermes_cli/test_machine_memory_nofork.py'
+      - '.github/workflows/native-memory-macos.yml'
+      - 'tests/ci/test_native_memory_workflow.py'
+  push:
+    branches: [main]
+    paths: *memory-paths
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: native-memory-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  native-memory:
+    name: Native memory ABI and no-fork tests
+    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
+    runs-on: [self-hosted, macOS, hermes-state]
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          ref: ${{ github.event.pull_request.head.sha || github.sha }}
+      - name: Exercise native memory APIs
+        shell: bash
+        run: |
+          set -euo pipefail
+          python3 -c "import sys; assert sys.platform == 'darwin'"
+          HERMES_HOME="$(mktemp -d "${RUNNER_TEMP:-/tmp}/native-memory-home.XXXXXX")"
+          export HERMES_HOME
+          trap 'rm -rf "$HERMES_HOME"' EXIT
+          taskpolicy -c utility scripts/run_tests.sh \
+            tests/hermes_cli/test_machine_memory_darwin.py \
+            tests/hermes_cli/test_machine_memory_nofork.py -j 1 --file-retries 0
+        env:
+          OPENROUTER_API_KEY: ''
+          OPENAI_API_KEY: ''
+          NOUS_API_KEY: ''
diff --git a/tests/ci/test_native_memory_workflow.py b/tests/ci/test_native_memory_workflow.py
new file mode 100644
index 00000000000..597d5f6f9ed
--- /dev/null
+++ b/tests/ci/test_native_memory_workflow.py
@@ -0,0 +1,30 @@
+"""Native memory regressions must execute on Darwin, not skip on Linux."""
+from pathlib import Path
+
+import hermes_yaml
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def test_native_memory_lane_routes_and_executes_real_tests():
+    workflow = hermes_yaml.safe_load((ROOT / ".github/workflows/native-memory-macos.yml").read_text())
+    triggers = workflow.get("on", workflow.get(True))
+    paths = triggers["pull_request"]["paths"]
+    for path in ("hermes_cli/machine_memory_darwin.py", "hermes_cli/machine_metrics.py",
+                 "tests/hermes_cli/test_machine_memory_darwin.py", "tests/hermes_cli/test_machine_memory_nofork.py"):
+        assert path in paths
+    assert "workflow_dispatch" in triggers
+    assert triggers["push"]["branches"] == ["main"]
+    job = workflow["jobs"]["native-memory"]
+    assert job["runs-on"] == ["self-hosted", "macOS", "hermes-state"]
+    assert "github.event.pull_request.head.repo.full_name == github.repository" in job["if"]
+    assert workflow["permissions"] == {"contents": "read"}
+    checkout, run = job["steps"]
+    assert checkout["with"]["ref"] == "${{ github.event.pull_request.head.sha || github.sha }}"
+    command = run["run"]
+    assert "HERMES_HOME" in command and "mktemp -d" in command
+    assert "taskpolicy -c utility scripts/run_tests.sh" in command
+    for test in ("test_machine_memory_darwin.py", "test_machine_memory_nofork.py"):
+        assert f"tests/hermes_cli/{test}" in command
+    assert "sys.platform == 'darwin'" in command
+    assert "--file-retries 0" in command
-- 
2.55.0

