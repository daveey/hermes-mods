From 0c4fe44b5a19c933015c3af63f5d79716b07ca16 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 26 Nov 2026 11:08:21 +0000
Subject: [PATCH 6601] Truthful non-running reasons and refusal provenance

Public mirror of source commit 0c4fe44b5a19c933015c3af63f5d79716b07ca16.

---
diff --git a/tests/gateway/fixtures/kanban_recovery_probe.py b/tests/gateway/fixtures/kanban_recovery_probe.py
index 15333c1bca6668f81c5f915120721887147e30ae..87bf9ed987c1a3b1c32f3f79dc680690bab32432 100644
--- a/tests/gateway/fixtures/kanban_recovery_probe.py
+++ b/tests/gateway/fixtures/kanban_recovery_probe.py
@@ -27,9 +27,11 @@
         return result
     # Only the typed admission-lock refusal is repeatable, never a failed/guarded
     # spawn or a lost attempt. The reservation publisher can still own the flock.
+    assert result.claim_deferred in (
+        [(tid, 'update_admission_busy')], [(tid, 'turn_admission_waiting')]), result
     assert result == dispatch.DispatchResult(
         scheduling_admitted=True, lane_candidates=1,
-        claim_deferred=[(tid, 'claim_not_acquired')]), result
+        claim_deferred=result.claim_deferred), result
     task = kb.get_task(conn, tid)
     assert task is not None and task.status == 'ready' and task.current_run_id is None, task
     return None
diff --git a/tests/hermes_cli/test_kanban_hub_admission_turns.py b/tests/hermes_cli/test_kanban_hub_admission_turns.py
index a901b8b328ce58d7cde48cd1df64d7daa45ce368..58b1d89400a13b13c98ff291686bbf278229eeac 100644
--- a/tests/hermes_cli/test_kanban_hub_admission_turns.py
+++ b/tests/hermes_cli/test_kanban_hub_admission_turns.py
@@ -97,7 +97,9 @@
         assert kb.claim_task(conn, t) is None
         assert kb.get_task(conn, t).status == "ready"
         assert conn.execute("SELECT count(*) FROM task_runs").fetchone()[0] == 0
-        assert sync.pop_claim_deferral(t) is None  # an ordinary busy-lock defer, not a gate refusal
+        # Publish the actual waiting-turn cause without changing admission or opening a run.
+        assert sync.pop_claim_deferral(t) == 'turn_admission_waiting'
+        assert sync.pop_claim_deferral(t) is None  # one-shot diagnostic, not a retained hold
     assert not af.turns_waiting(home / "core-update")
     locked(monkeypatch, slow_sample(threading.Event(), hold_s=0))
     assert kb.claim_task(conn, t) is not None
-- 
