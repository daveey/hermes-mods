 hermes_cli/kanban_db_dispatch.py           |   4 +
 hermes_cli/kanban_model_tier.py            | 131 ++++++++++++++++
 tests/hermes_cli/test_kanban_model_tier.py | 169 +++++++++++++++++++++
 4 files changed, 313 insertions(+)
 create mode 100644 hermes_cli/kanban_model_tier.py
