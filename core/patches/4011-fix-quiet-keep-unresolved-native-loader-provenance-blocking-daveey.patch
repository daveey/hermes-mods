From b5bb8772b9ba56301fb0b782339a3e9e929edfde Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 00:36:56 +0000
Subject: [PATCH] fix(quiet): keep unresolved native loader provenance blocking
 [daveey]

---
 hermes_cli/code_attestation.py               |  8 +++++++-
 tests/gateway/test_quiet_extension_report.py | 18 ++++++++++++++++++
 2 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/code_attestation.py b/hermes_cli/code_attestation.py
index e230e80590..c9079202a3 100644
--- a/hermes_cli/code_attestation.py
+++ b/hermes_cli/code_attestation.py
@@ -1267,7 +1267,13 @@ class Attestation:
                 if not allowed:
                     self.mark_unknown("dependency-unreceipted:" + str(path))
         if caller is None or not allowed:
-            self._extension_unknown("native-load:" + str(name), name)
+            reason = "native-load:" + str(name)
+            # Loader search is not cwd-relative provenance. Only absolute paths
+            # can establish that an unknown library is outside the core root.
+            if isinstance(name, str) and os.path.isabs(name):
+                self._extension_unknown(reason, name)
+            else:
+                self.mark_unknown(reason)
             return
         if len(self._native_loads) < MAX_DEP_REPORT:
             self._native_loads.append({"name": name, "caller_component": caller})
diff --git a/tests/gateway/test_quiet_extension_report.py b/tests/gateway/test_quiet_extension_report.py
index 24b964b5da..c2a393e85d 100644
--- a/tests/gateway/test_quiet_extension_report.py
+++ b/tests/gateway/test_quiet_extension_report.py
@@ -115,6 +115,24 @@ def test_real_plugin_dataclass_and_absolute_ctypes_through_gateway(tmp_path, ext
     assert result['start']['valid'] and result['snapshot']['valid'], result
 
 
+def test_core_native_soname_is_not_external(tmp_path, extension_core, python):
+    libraries = list(Path('/lib').glob('*/libc.so.6'))
+    if not libraries or not Path('/proc/self/maps').exists():
+        pytest.skip('loader-search regression requires Linux libc and proc maps')
+    native = extension_core / 'libquietreview.so'
+    shutil.copyfile(libraries[0].resolve(), native)
+    probe = extension_core / 'attest_probe.py'
+    probe.write_text(PROBE.replace(
+        'assert mod.Point(3).x == 3',
+        "assert mod.Point(3).x == 3\nassert str(pathlib.Path(__file__).parent / 'libquietreview.so') in pathlib.Path('/proc/self/maps').read_text()"))
+    route._git(extension_core, 'add', '-A')
+    route._git(extension_core, 'commit', '-qm', 'native loader search fixture')
+    result = route.run_stub(tmp_path, python, route.current_script(extension_core), extra_env={
+        'QUIET_NATIVE_LIBRARY': native.name, 'LD_LIBRARY_PATH': str(extension_core)})
+    assert 'unknown:code:native-load:' + native.name in result['check']['reasons'], result
+    assert not result['check']['admitted'] and not result['start']['valid']
+
+
 @pytest.mark.parametrize('state,delta,age,foreign,hold,admitted', [
     ('batching', 3600, 0, False, False, True),
     ('batching', 600, 0, False, False, True),
-- 
2.43.0

