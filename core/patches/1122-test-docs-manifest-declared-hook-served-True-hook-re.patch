From 6b5b84ef4c29ab3c7933be13c612fe2b017645bb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 02:55:44 +0000
Subject: [PATCH] test+docs: manifest-declared hook served True;
 hook-registration contract [daveey]

---
 hermes_cli/plugins_snapshot.py                       | 6 ++++++
 tests/hermes_cli/test_plugin_hook_presence_record.py | 4 +++-
 2 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/plugins_snapshot.py b/hermes_cli/plugins_snapshot.py
index 3c505cee342..b8ed59c0dc4 100644
--- a/hermes_cli/plugins_snapshot.py
+++ b/hermes_cli/plugins_snapshot.py
@@ -204,6 +204,12 @@ def record(stamp: Optional[str], home: Optional[Path] = None) -> None:
 # * hooks a manifest declares (``provides_hooks``) count even when the plugin did not register them;
 # * records with the same stamp are unioned, so processes that load the same inputs differently
 #   (another surface, a config-owned shell hook) can only grow the set.
+#
+# Contract for plugins: whether register() subscribes a hook must depend only on fingerprinted
+# inputs (plugin files, config.yaml, .env, the env flags above, installed packages); a hook gated on
+# anything else (another env var, argv, the surface, a data file) must be listed in the manifest's
+# ``provides_hooks``. A register() that raises (other than a timeout) is recorded as contributing
+# only its declared hooks: a plugin that always fails would otherwise prevent any record.
 
 HOOKS_VERSION = 1
 
diff --git a/tests/hermes_cli/test_plugin_hook_presence_record.py b/tests/hermes_cli/test_plugin_hook_presence_record.py
index 06c946f7dac..c22063726d4 100644
--- a/tests/hermes_cli/test_plugin_hook_presence_record.py
+++ b/tests/hermes_cli/test_plugin_hook_presence_record.py
@@ -180,9 +180,11 @@ def test_manifest_declared_hook_counts_even_when_not_registered(home):
     _plugin(home, "declarer", "def register(ctx):\n    pass\n",
             manifest_extra="provides_hooks: [on_kanban_task_updated]\n")
     _config(home, ["bystander", "declarer"])
-    _run(home, "setup")
+    tid = _run(home, "setup")["task_id"]
     _run(home, "discover")
     assert "on_kanban_task_updated" in _hooks_record(home)["hooks"]
+    out = _run(home, "assign", task_id=tid, profile="bob")
+    assert out["assigned"] is True and out["sweeps"] == 1  # served True: the invoke discovers
 
 
 def test_sweep_with_a_timed_out_plugin_does_not_vouch_for_the_hook_set(home):
-- 
