From b0e56d1a4c4adb5d5974a96f7c0aca352dbb698c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 23:18:50 +0000
Subject: [PATCH] [daveey] Give host-sleep poll fixture a real executor future

---
 tests/gateway/test_gateway_watchdog_host_sleep.py | 2 +-
 tests/hermes_state/test_outcome_run_custody.py    | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/gateway/test_gateway_watchdog_host_sleep.py b/tests/gateway/test_gateway_watchdog_host_sleep.py
index 907f6f5dec..cfe5c44e77 100644
--- a/tests/gateway/test_gateway_watchdog_host_sleep.py
+++ b/tests/gateway/test_gateway_watchdog_host_sleep.py
@@ -114,7 +114,7 @@ async def test_turn_poll_loop_ignores_host_sleep(clock, monkeypatch):
         agent_timeout=TIMEOUT_S, agent_warning=900.0, task_id="t", process_baseline=None,
         worker_done=threading.Event(), timeout_fired=threading.Event(),
         cleanup_lock=threading.Lock(), is_current=lambda: True)
-    worker.executor_task = object()
+    worker.executor_task = asyncio.get_running_loop().create_future()
 
     result = await runner._run_agent_await_turn_worker(worker, turn_ctx, asyncio.Event(), None)
 
diff --git a/tests/hermes_state/test_outcome_run_custody.py b/tests/hermes_state/test_outcome_run_custody.py
index 36d561a0bd..3d9ea38c58 100644
--- a/tests/hermes_state/test_outcome_run_custody.py
+++ b/tests/hermes_state/test_outcome_run_custody.py
@@ -143,7 +143,7 @@ async def test_abandoned_worker_captures_own_live_lease(db, monkeypatch, cancell
         if cancelled:
             raise asyncio.CancelledError
         return set(), {pending}
-    monkeypatch.setattr("gateway.run_turn.asyncio.wait", poll)
+    monkeypatch.setattr("gateway.run_turn_wait.asyncio.wait", poll)
     runner = SimpleNamespace(_session_db=db, _run_agent_timeout_result=lambda *a: {"failed": True},
                              _session_state=lambda *a: pytest.fail("successor slot read"))
     token = gw.run_outcome.set({"session_id": "chat"})
-- 
2.51.0

