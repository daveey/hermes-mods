From bb0c85f52dfe2eb7983bd4432f65172216eed373 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 4 Nov 2026 03:40:30 +0000
Subject: [PATCH] test(rendezvous): check brokered ends by socket identity, not
 fd number [daveey] (#823)

test_authenticated_listener_receives_fd_and_child_gets_start asserted the
owner kept no copy of the child's socketpair end with os.fstat(<number>).
The owner closes that end right after Popen, so the number is free, and the
next allocation in the process (the in-test acceptor's recv_fds of the
parent end, or any other thread) reuses it. In CI, earlier tests in the
file leave the lower fds occupied, so the number was often reused and the
assert failed with _fd_open(18/19) == True (4 CI flakes on 11-03).

The Recorder now records the /proc/self/fd link (socket:[inode]) of each
pass_fds end at spawn time. The test asserts no fd in the owner still
points at the child end, and only the acceptor's received channel points
at the parent end. Proven: a forced reuse fails the old check with the CI
signature and passes the new one; a retained child end, or a dup of the
parent end, fails the new check. 73/73 pass, also under SIGSTOP/SIGCONT
starvation.
---
 .../gateway/test_session_kanban_rendezvous.py | 33 ++++++++++++++-----
 1 file changed, 25 insertions(+), 8 deletions(-)

diff --git a/tests/gateway/test_session_kanban_rendezvous.py b/tests/gateway/test_session_kanban_rendezvous.py
index dddd50c2ca5..1f86e2f56ab 100644
--- a/tests/gateway/test_session_kanban_rendezvous.py
+++ b/tests/gateway/test_session_kanban_rendezvous.py
@@ -194,6 +194,8 @@ class Recorder:
 
     def __call__(self, *args, **kwargs):
         self.calls.append((args, kwargs))
+        # Identity of each inherited end at spawn time: fd numbers are reused once the owner closes them.
+        self.passed = {fd: _socket_link(fd) for fd in kwargs.get('pass_fds', ())}
         process = subprocess.Popen(*args, **kwargs)
         self.processes.append(process)
         return process
@@ -248,17 +250,32 @@ def test_authenticated_listener_receives_fd_and_child_gets_start(required, accep
     [(args, kwargs)] = recorder.calls
     assert args[0][:2] == [sys.executable, '-c'] and args[0][-2] == '--observation-fd'
     assert kwargs['pass_fds'] == (int(args[0][-1]),)
-    # The owner keeps no copy of either end once brokered.
-    assert not _fd_open(int(args[0][-1]))
+    # The owner keeps no copy of either end once brokered. Compare socket identities, not fd numbers:
+    # the freed child-end number is reused by the next allocation in this process (the acceptor's
+    # recv_fds, any other thread), which made a number-based check flaky.
+    child_end = recorder.passed[int(args[0][-1])]
+    [channel] = acceptor.fds
+    parent_end = _socket_link(channel.fileno())
+    links = _open_links()
+    assert child_end not in links.values()
+    assert [fd for fd, link in links.items() if link == parent_end] == [channel.fileno()]
     assert (acceptor.dir / f"{context['run_id']}.consumed").exists()
 
 
-def _fd_open(fd):
-    try:
-        os.fstat(fd)
-    except OSError:
-        return False
-    return True
+def _socket_link(fd):
+    link = os.readlink(f'/proc/self/fd/{fd}')
+    assert link.startswith('socket:['), link
+    return link
+
+
+def _open_links():
+    links = {}
+    for name in os.listdir('/proc/self/fd'):
+        try:
+            links[int(name)] = os.readlink(f'/proc/self/fd/{name}')
+        except OSError:
+            pass  # the listdir fd itself, or one closed meanwhile
+    return links
 
 
 def test_fingerprint_matches_worker_bound_shape(required, acceptors):
