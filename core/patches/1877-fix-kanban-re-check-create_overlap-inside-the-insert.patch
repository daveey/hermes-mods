--- a/tools/kanban_tools_placement.py
+++ b/tools/kanban_tools_placement.py
@@ -149,3 +149,24 @@ def _runs_where(runs_on, pinned_machine, marker_placement) -> str:
     except Exception:
         gw = None
     return f"here ({gw})" if gw else "here"
+
+
+def _create_session_id(args: dict, origin_intent: Optional[dict], self_task) -> Optional[str]:
+    """The new card's session. The worker/API runtime may be transient; the owning task's origin is durable.
+    The ambient id is the request-scoped ContextVar binding, not the process-global os.environ: in a
+    multi-session gateway the env holds the LAST agent built, and an id that never reached its ``sessions``
+    row is provenance pointing at nothing."""
+    if origin_intent is not None:
+        # Courier retries use only their durable envelope, never the receiving
+        # process's current session/tenant/project. Creator provenance remains
+        # unchanged even if its session is compressed or subsequently removed.
+        return args.get("session_id")
+    from gateway.session_context import get_session_env
+    from tools.async_delegation import _current_origin_session_id
+    return (_persisted_session_id(args.get("session_id"))
+            # The parent card's session too: a card placed from another gateway carries
+            # a placeholder (or a chat that lives elsewhere), and handing that on as a
+            # child's origin made the owner's bind fail (kanban-69709bcf16). [daveey]
+            or _persisted_session_id(self_task.session_id if self_task else None)
+            or _persisted_session_id(_current_origin_session_id())
+            or _persisted_session_id(get_session_env("HERMES_SESSION_ID", "")))
diff --git a/website/docs/user-guide/features/kanban.md b/website/docs/user-guide/features/kanban.md
index 6606ce02193..fcb538a6e24 100644
--- a/website/docs/user-guide/features/kanban.md
+++ b/website/docs/user-guide/features/kanban.md
@@ -55,6 +55,15 @@ when the proposed work is genuinely separate. Set `kanban.create_overlap_check`
 `false` to disable this check. Missing or unreadable replicas are skipped and logged;
 the check cannot guarantee uniqueness against unavailable boards.
 
+Two creates that run at the same moment both pass the first check before either card
+exists. So every entry (the `kanban_create` tool, `hermes kanban create`, and the
+dashboard REST API) runs the match again inside the write transaction that inserts the
+card. That second pass reads only open cards on the target board that were created
+since the first check began. Of two concurrent owners of one piece of work on one
+board, exactly one lands and the other gets the same `create_overlap` refusal. A
+concurrent create on another board or another gateway is not re-checked under that
+lock, so that race remains.
+
 Every refusal is recorded with each match's `why`: as a `create_overlap` event on the
 creator's card or the best local match, or, when every match is on another gateway, as a
 line in `<kanban home>/logs/create_overlap.jsonl` (rotated to `.1` at 1 MiB).
