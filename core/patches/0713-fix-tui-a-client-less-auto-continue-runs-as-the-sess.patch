index 4775b9e9a92..1a181c720b7 100644
--- a/tui_gateway/session_auto_continue.py
+++ b/tui_gateway/session_auto_continue.py
@@ -86,6 +86,58 @@ def _auto_continue_note(prompt: str) -> str:
