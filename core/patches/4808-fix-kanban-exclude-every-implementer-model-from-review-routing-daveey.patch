+def _handoff_card(conn, pin, ran):
+    """A card pinned to *pin* whose finished runs used *ran*, now waiting in review."""
+    tid = _card(conn, pin)
+    for model in ran:
+        _run(conn, tid, model=model)
+    conn.execute("UPDATE tasks SET status='review' WHERE id=?", (tid,))
+    conn.commit()
+    return tid
