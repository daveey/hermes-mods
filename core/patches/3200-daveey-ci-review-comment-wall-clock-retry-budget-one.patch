+    f.comments = {1: [{"id": 77, "body": f.posted.pop("1")}]}
+    d.fail, d.calls = 0, 0
+    assert b.run_batch("t", REPO, NOW + timedelta(minutes=30), head_sha=sha, trigger_workflow="CI") == 0
+    m = b._STATE_RE.search(f.posted["1"])
+    assert m and not m.group(4) and not m.group(5)
