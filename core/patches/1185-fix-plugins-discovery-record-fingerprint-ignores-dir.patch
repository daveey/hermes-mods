From eff5c32d416356765fcc5ceb95947c25b3048c47 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 09:03:47 +0000
Subject: [PATCH] fix(plugins): discovery record fingerprint ignores dir mtimes
 moved by __pycache__ creation; flaked second cold process [daveey]

---
 hermes_cli/plugins_snapshot.py                | 22 +++++++++++++---
 ...est_kanban_capabilities_plugin_snapshot.py | 26 +++++++++++++++++++
 2 files changed, 45 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/plugins_snapshot.py b/hermes_cli/plugins_snapshot.py
index 4414b4744ca..291914063a7 100644
--- a/hermes_cli/plugins_snapshot.py
+++ b/hermes_cli/plugins_snapshot.py
@@ -97,6 +97,19 @@ def _stat_entry(path: Path, label: str) -> list:
     return [label, st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns]
 
 
+_DIST_SUFFIXES = (".dist-info", ".egg-info", ".egg-link", ".pth", ".egg")
+
+
+def _site_entry(path: Path, label: str) -> list:
+    """A site dir's installed-distribution entries (not the dir's own mtime, which also moves
+    whenever any process first byte-compiles a top-level module into ``__pycache__``)."""
+    try:
+        names = sorted(n for n in os.listdir(path) if n.endswith(_DIST_SUFFIXES))
+    except OSError as exc:
+        return [label, "missing", exc.errno]
+    return [label, [_stat_entry(path / n, n) for n in names]]
+
+
 def _walk_root(root: Path, label: str, out: list) -> None:
     if not root.is_dir():
         out.append([label, "absent"])
@@ -112,8 +125,11 @@ def _walk_root(root: Path, label: str, out: list) -> None:
             continue
         seen.add((st.st_dev, st.st_ino))
         rel = os.path.relpath(dirpath, root)
-        # The directory's own entry changes when a file is added, removed or renamed.
-        out.append([f"{label}:{rel}/", st.st_dev, st.st_ino, st.st_mtime_ns])
+        # The directory's identity only: its mtime also moves when ANY process (a sibling test worker,
+        # a pytest run importing a bundled plugin) first creates a __pycache__ in it, which made a
+        # record stale between two cold processes. Added/removed/renamed plugin files and
+        # subdirectories already show up below as entries of their own.
+        out.append([f"{label}:{rel}/", st.st_dev, st.st_ino])
         dirnames[:] = sorted(d for d in dirnames if d not in _SKIP_DIRS)
         for name in sorted(filenames):
             if name.endswith(_PLUGIN_SUFFIXES):
@@ -142,7 +158,7 @@ def fingerprint(home: Optional[Path] = None) -> Optional[str]:
         # uninstall changes the directory. Script and source dirs on sys.path differ per caller
         # and hold no distributions, so they are left out to keep the record shared.
         for entry in sorted({e for e in sys.path if e and os.path.basename(e) in ("site-packages", "dist-packages")}):
-            parts.append(_stat_entry(Path(entry), f"syspath:{entry}"))
+            parts.append(_site_entry(Path(entry), f"syspath:{entry}"))
         roots = [("bundled", Path(_plugins.get_bundled_plugins_dir())), ("user", home / "plugins")]
         if _plugins._env_enabled("HERMES_ENABLE_PROJECT_PLUGINS"):
             roots.append(("project", Path.cwd() / ".hermes" / "plugins"))
diff --git a/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py b/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py
index c6dcccff09c..2805fd10f8f 100644
--- a/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py
+++ b/tests/hermes_cli/test_kanban_capabilities_plugin_snapshot.py
@@ -271,3 +271,29 @@ def test_profile_scoped_caller_reads_the_profile_record(home):
     assert first["discoveries"] == 1 and (prof / "cache" / "plugin_toolset_keys.json").exists()
     assert _run(home, assignee="worker")["discoveries"] == 0
     assert _run(prof)["discoveries"] == 0  # the profile's own process (HERMES_HOME=profile) shares it
+
+
+def test_fingerprint_ignores_bytecode_cache_creation_but_sees_plugin_changes(home, monkeypatch):
+    """Another process byte-compiling a plugin (or a first __pycache__ in a site dir) moves the
+    directory mtime without changing what discovery reads; that must not stale the record."""
+    from hermes_cli import plugins_snapshot as S
+
+    plugin = _tool_plugin(home, "extra", "extra_ping", "extra")
+    site = home.parent / "site-packages"
+    (site / "pkg-1.0.dist-info").mkdir(parents=True)
+    monkeypatch.setattr(sys, "path", [*sys.path, str(site)])
+    before = S.fingerprint(home)
+    assert before
+    (plugin / "__pycache__").mkdir()
+    (plugin / "__pycache__" / "__init__.cpython-312.pyc").write_bytes(b"x")
+    (site / "__pycache__").mkdir()
+    os.utime(plugin, ns=(1, 1))
+    os.utime(home / "plugins", ns=(1, 1))
+    os.utime(site, ns=(1, 1))
+    assert S.fingerprint(home) == before
+    (plugin / "extra_more.py").write_text("X = 1\n")
+    changed = S.fingerprint(home)
+    assert changed != before
+    (plugin / "extra_more.py").unlink()
+    (site / "other-2.0.dist-info").mkdir()
+    assert S.fingerprint(home) not in (before, changed)
-- 
