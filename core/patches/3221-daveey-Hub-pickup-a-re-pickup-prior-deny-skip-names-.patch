From 00fbd4ab1beb2b08a54bf48c53e0db3369f4f4b2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 06:52:25 +0000
Subject: [PATCH] [daveey] Hub pickup: a re-pickup prior-deny skip names its
 home reason; pin path-qualified hub-admin stays home

Follow-up to review 5887184884 nits on PR #1845:
- kanban_hub_admission_pickup: one _denied() builds the skip text for apply and for the
  re-pickup prior-verdict skip, so both say '; kept home (<reason>), left for its creator'
  (the prior skip used to drop it). Direct tests for both texts.
- kanban_placement_coordination: document and test that the _HUB_ADMIN lookbehind keeps a
  path-qualified hub-admin (~/.hermes/bin/hub-admin '...') home (ACTION_REASON): the hub-write
  attestation covers the bare hub-admin on PATH only; fail closed.
---
 hermes_cli/kanban_hub_admission_pickup.py     | 15 ++++--
 hermes_cli/kanban_placement_coordination.py   |  3 ++
 .../test_kanban_coordination_placement.py     | 13 ++++++
 .../test_kanban_hub_admission_pickup.py       | 46 +++++++++++++++++++
 4 files changed, 73 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_hub_admission_pickup.py b/hermes_cli/kanban_hub_admission_pickup.py
index 6d1d41a6d9..21fa0fa773 100644
--- a/hermes_cli/kanban_hub_admission_pickup.py
+++ b/hermes_cli/kanban_hub_admission_pickup.py
@@ -84,6 +84,15 @@ def _fields(card: Mapping[str, Any], board: str) -> dict:
                if k in card.keys()}}
 
 
+def _denied(audit: Mapping[str, Any], replaced: bool) -> str:
+    """The pickup-skip text of a deny: the verdict, plus why it stays put when no worker queue took it."""
+    why = f"hub admission denied: {str(audit.get('why') or '')[:150]}"
+    if replaced:
+        return why
+    kept = f"kept home ({audit['home']})" if audit.get("home") else "no worker queue fits"
+    return f"{why}; {kept}, left for its creator"
+
+
 def _target(fields: dict, own: str, cfg: dict, audit: dict) -> Optional[list[str]]:
     """The worker-queue labels a denied card moves to (the creation-time deny route), or None when none fits."""
     from hermes_cli import kanban_hub_admission_placement as hp
@@ -131,7 +140,7 @@ def screen(conn: sqlite3.Connection, replica: sqlite3.Connection, own: str, ids:
         prior = verdict(replica, tid)
         if prior and prior.get("entry") == ENTRY and prior.get("runs_on") == labels:
             # Denied here already and not re-placed (no worker queue fits): never judged again on this placement.
-            skips[tid] = ("other", f"hub admission denied: {str(prior.get('why') or '')[:150]}")
+            skips[tid] = ("other", _denied(prior, False))
             continue
         if down or conn.in_transaction:
             if not down:
@@ -165,7 +174,6 @@ def apply(conn: sqlite3.Connection, own: str, plans: Mapping[str, dict], importe
         if plan is None:
             continue
         audit, target = plan["audit"], plan["target"]
-        why = f"hub admission denied: {str(audit.get('why') or '')[:150]}"
         try:
             with kb.write_txn(conn):
                 row = conn.execute("SELECT runs_on FROM tasks WHERE id = ?", (tid,)).fetchone()
@@ -174,8 +182,7 @@ def apply(conn: sqlite3.Connection, own: str, plans: Mapping[str, dict], importe
                 kb._append_event(conn, tid, "hub_admission", audit)
                 if audit["admit"]:
                     continue
-                kept = f"kept home ({audit['home']})" if audit.get("home") else "no worker queue fits"
-                out[tid] = ("other", why + ("" if target else f"; {kept}, left for its creator"))
+                out[tid] = ("other", _denied(audit, target is not None))
                 if target is None:
                     continue  # the backstop (refusals) keeps it unclaimed here
                 previous = wn._parse(row["runs_on"])
diff --git a/hermes_cli/kanban_placement_coordination.py b/hermes_cli/kanban_placement_coordination.py
index 078aa9d058..f1a6094731 100644
--- a/hermes_cli/kanban_placement_coordination.py
+++ b/hermes_cli/kanban_placement_coordination.py
@@ -25,6 +25,9 @@ _EXECUTION = re.compile(r"(?:\b(?:run|execute|invoke|call|use|via|with)\s+`?|`|[
 # still-open quote acts with the hub's identity and replica, so it needs ``capability:hub-write`` (the hub-admin
 # attestation), not this worker's own hermes-hub install. A worker's ``hermes-hub outcomes --id`` reads only its
 # OWN sent requests (the hub's request read back as ``state: null`` on worker-1, 11-13), so bare spellings stay home.
+# The lookbehind also rejects a path-qualified spelling (``~/.hermes/bin/hub-admin '...'``): the hub-write
+# attestation covers the bare ``hub-admin`` on PATH, not an arbitrary install path, so such a card keeps the
+# wrapped action's own verdict (ACTION_REASON: stays home). Deliberate: the fail-closed direction.
 _HUB_ADMIN = re.compile(r"(?<![\w/.-])hub-admin\s+(['\"])(?:(?!\1).)*$", re.IGNORECASE)
 HUB_WRITE = "capability:hub-write"
 
diff --git a/tests/hermes_cli/test_kanban_coordination_placement.py b/tests/hermes_cli/test_kanban_coordination_placement.py
index bf8e76246e..0fc016f6d1 100644
--- a/tests/hermes_cli/test_kanban_coordination_placement.py
+++ b/tests/hermes_cli/test_kanban_coordination_placement.py
@@ -527,3 +527,16 @@ def test_hub_admin_lookalike_names_do_not_open_a_hub_write_quote(prefix):
     from hermes_cli import kanban_placement_coordination as coord
     assert coord.requirements(f"{prefix} 'hermes-hub outcomes --id t_x'")[1] == coord.ACTION_REASON
     assert coord.requirements("run hub-admin 'hermes-hub outcomes --id t_x'") == ({"capability:hub-write"}, None)
+
+
+@pytest.mark.parametrize("text", [
+    "~/.hermes/bin/hub-admin 'hermes-hub outcomes --id t_x'",
+    "run /home/ubuntu/.hermes/bin/hub-admin 'hermes-hub requests --json'",
+    "./hub-admin 'hermes-hub outcomes --id t_x'",
+])
+def test_path_qualified_hub_admin_stays_home(text):
+    """Pinned: the hub-write attestation covers the bare hub-admin on PATH only, so a path-qualified spelling
+    is not read as hub-admin and the wrapped action keeps its own verdict (fail closed: stays home)."""
+    from hermes_cli import kanban_placement_coordination as coord
+    labels, reason = coord.requirements(text)
+    assert reason == coord.ACTION_REASON and coord.HUB_WRITE not in labels
diff --git a/tests/hermes_cli/test_kanban_hub_admission_pickup.py b/tests/hermes_cli/test_kanban_hub_admission_pickup.py
index b9544222ed..d6041a1333 100644
--- a/tests/hermes_cli/test_kanban_hub_admission_pickup.py
+++ b/tests/hermes_cli/test_kanban_hub_admission_pickup.py
@@ -327,3 +327,49 @@ def test_verdict_reads_events_after_the_created_payload():
                  (json.dumps({"admit": False, "entry": "move"}),))
     assert hap.verdict(conn, "t")["admit"] is False
     assert hap.verdict(conn, "other") is None
+
+
+HOME_SKIP = ("hub admission denied: fake judge denies; kept home (needs home coordination action), "
+             "left for its creator")
+
+
+def _screen_and_copy(hub, tid):
+    hub.round()
+    hub.enter()
+    replica = wn.open_replica(hub.conn)
+    assert replica is not None
+    try:
+        copy, plans, skips = hap.screen(hub.conn, replica, HUB, [tid], cfg=CFG, machines=MACHINES)
+        imported = wn.import_cards(hub.conn, replica, copy)
+    finally:
+        replica.close()
+    return copy, plans, skips, imported
+
+
+def test_apply_skip_text_names_the_home_reason_when_no_queue_takes_it(gws, hub_judge):
+    hub, worker, _svc = gws
+    hub_judge.admit_next = False
+    tid = _worker_card(worker)
+    _copy, plans, _skips, imported = _screen_and_copy(hub, tid)
+    audit = {**plans[tid]["audit"], "home": "needs home coordination action"}
+    assert hap.apply(hub.conn, HUB, {tid: {"audit": audit, "target": None}}, imported) == {tid: ("other", HOME_SKIP)}
+    assert _events(hub.conn, tid, "moved") == []
+
+
+def test_denied_text_without_home_or_once_re_placed():
+    audit = {"admit": False, "why": "w"}
+    assert hap._denied(audit, False) == "hub admission denied: w; no worker queue fits, left for its creator"
+    assert hap._denied({**audit, "home": "h"}, True) == "hub admission denied: w"
+
+
+def test_a_re_pickup_prior_verdict_skip_keeps_the_home_reason(gws, hub_judge, monkeypatch):
+    hub, worker, _svc = gws
+    tid = _worker_card(worker)
+    prior = {"admit": False, "why": "fake judge denies", "entry": hap.ENTRY, "runs_on": ["machine:hub"],
+             "home": "needs home coordination action"}
+    monkeypatch.setattr(hap, "verdict", lambda conn, task_id: prior if task_id == tid else None)
+    copy, plans, skips, _imported = _screen_and_copy(hub, tid)
+    assert (copy, plans, hub_judge.calls) == ([], {}, [])
+    assert skips[tid] == ("other", HOME_SKIP)
+    del prior["home"]
+    assert _screen_and_copy(hub, tid)[2][tid][1].endswith("; no worker queue fits, left for its creator")
-- 
