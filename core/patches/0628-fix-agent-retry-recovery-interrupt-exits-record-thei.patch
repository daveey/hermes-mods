     assert verdict.final_response == "Visible draft."
diff --git a/tests/tui_gateway/test_interrupt_reason.py b/tests/tui_gateway/test_interrupt_reason.py
index 8ed654ef29..44b4a6da9f 100644
--- a/tests/tui_gateway/test_interrupt_reason.py
