From 246370c63cb6a3f9f8fe87dee3d1aeeb752a8247 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 05:41:59 +0000
Subject: [PATCH] fix(agent): retry/recovery interrupt exits record their
 reason too; phase field [daveey]

Follow-up to 7b9f2606cc. abort_turn_on_interrupt (error handling, retry backoff,
empty-response retry, provider autorecover) wrote its own "Operation interrupted: ..."
row with no reason, the same blind spot as the model-wait path (found by the live
check: a Stop during a retry backoff saved a bare row). It now records
display_metadata.interrupt and result["interrupt"] before clear_interrupt drops the
reason. record_api_interrupt gains phase=model_wait|retry_wait so the slow-first-token
count can tell the two apart.

test_turn_api_call_interrupt: the partial row now carries the interrupt record next to
interrupted=True; the exact-dict assertion pinned the old shape (stale after 7b9f2606cc).
New: test_backend_exit_during_retry_backoff_records_backend_exit (red before).
---
 agent/interrupt_control.py                  | 15 +++----
 agent/turn_recovery.py                      |  8 +++-
 tests/agent/test_turn_api_call_interrupt.py |  4 +-
 tests/tui_gateway/test_interrupt_reason.py  | 46 +++++++++++++++++++++
 4 files changed, 63 insertions(+), 10 deletions(-)

diff --git a/agent/interrupt_control.py b/agent/interrupt_control.py
index fd0a1fd94e..9b6e8f81f9 100644
--- a/agent/interrupt_control.py
+++ b/agent/interrupt_control.py
@@ -66,17 +66,18 @@ def interrupt_reason(agent) -> str:
     return _USER_REASON_SLUGS.get(reason) or interrupt_issuer(agent) or "unknown"
 
 
-def record_api_interrupt(agent, waited_s: float, messages) -> dict:
-    """[daveey] Note an interrupt that landed while waiting for the model: ``{reason, waited_s, prompt_tokens}``
-    on ``agent._last_api_interrupt`` (the finalizer stamps it on the interrupted row and the turn result) and one
-    INFO line in agent.log. Before this every producer saved the same bare text (self-heal agent-38bad5aced)."""
+def record_api_interrupt(agent, waited_s: float, messages, *, phase: str = "model_wait") -> dict:
+    """[daveey] Note an interrupt that landed while waiting for the model (``phase="model_wait"``) or in a retry /
+    recovery backoff (``"retry_wait"``): ``{reason, phase, waited_s, prompt_tokens}`` on ``agent._last_api_interrupt``
+    (stamped on the interrupted row and the turn result) and one INFO line in agent.log. Before this every producer
+    saved the same bare text (self-heal agent-38bad5aced)."""
     from agent.model_metadata import estimate_messages_tokens_rough
     prompt_tokens = int(estimate_messages_tokens_rough(list(messages or [])))
-    info = {"reason": interrupt_reason(agent), "waited_s": round(max(0.0, float(waited_s)), 1),
+    info = {"reason": interrupt_reason(agent), "phase": phase, "waited_s": round(max(0.0, float(waited_s)), 1),
             "prompt_tokens": prompt_tokens}
     agent._last_api_interrupt = info
-    logger.info("turn interrupted: reason=%s waited=%.1fs prompt_tokens=%d model=%s session=%s",
-                info["reason"], info["waited_s"], prompt_tokens, getattr(agent, "model", None),
+    logger.info("turn interrupted: reason=%s phase=%s waited=%.1fs prompt_tokens=%d model=%s session=%s",
+                info["reason"], phase, info["waited_s"], prompt_tokens, getattr(agent, "model", None),
                 getattr(agent, "session_id", None) or "none")
     return info
 
diff --git a/agent/turn_recovery.py b/agent/turn_recovery.py
index 635fb55297..0a23f08d55 100644
--- a/agent/turn_recovery.py
+++ b/agent/turn_recovery.py
@@ -1334,14 +1334,18 @@ def abort_turn_on_interrupt(
     # already-executed tool result. Strip only that request-local scaffold before
     # closing, so this exit owner can persist its specific interrupt reason.
     agent._drop_trailing_empty_response_scaffolding(messages)
-    close_interrupted_tool_sequence(messages, interrupt_text)
+    # [daveey] Record WHY (user_stop / backend_exit / ...) before clear_interrupt drops the reason.
+    from agent.interrupt_control import record_api_interrupt
+    interrupt_info = record_api_interrupt(agent, 0.0, messages, phase="retry_wait")
+    vars(agent).pop("_last_api_interrupt", None)
+    close_interrupted_tool_sequence(messages, interrupt_text, display_metadata={"interrupt": interrupt_info})
     agent._persist_session(messages, conversation_history)
     # The turn was stopped, not rebuilt: a pending steer was aimed at this turn's next
     # tool iteration, which will no longer happen — drop it (hard-cancel semantics).
     agent.clear_interrupt(hard_cancel=True)
     return {
         "final_response": interrupt_text, "messages": messages, "api_calls": api_call_count,
-        "completed": False, "interrupted": True,
+        "completed": False, "interrupted": True, "interrupt": interrupt_info,
     }
 
 
diff --git a/tests/agent/test_turn_api_call_interrupt.py b/tests/agent/test_turn_api_call_interrupt.py
index 764c961157..65d84b7ff3 100644
