diff --git a/hermes_cli/kanban_diagnostic_correction.py b/hermes_cli/kanban_diagnostic_correction.py
new file mode 100644
index 0000000000..fae1d8d6ac
--- /dev/null
+++ b/hermes_cli/kanban_diagnostic_correction.py
@@ -0,0 +1,68 @@
+"""Quote diagnostic prose without rewriting the text it describes. [daveey]
+
+Quotation planning is pure. It grants no authority to mutate a card or comment.
+"""
+from __future__ import annotations
+
+import os
+import sqlite3
+
+
+def correct_diagnostics(
+    conn: sqlite3.Connection, task_id: str, *, comment_uid: str,
+    expected_body: str, expected_comment: str, body_diagnostic: str,
+    comment_diagnostic: str, reason: str, request_id: str,
+) -> dict:
+    """Operator-only local CAS; sync convergence must be verified separately.
+
+    Caller-provided prose is an audit reason, never an authorization grant.
+    The existing process/DB fence remains the mutation authority boundary.
+    """
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_sync as sync
+    from hermes_cli.kanban_review_required import worker_identity
+
+    if worker_identity():
+        raise PermissionError("diagnostic correction requires an independent non-worker operator")
+    if not reason.strip() or not request_id.strip():
+        raise ValueError("reason and request_id must be nonempty")
+    after = {
+        "body": quote_diagnostic(expected_body, body_diagnostic),
+        "comment": quote_diagnostic(expected_comment, comment_diagnostic),
+    }
+    with kb.write_txn(conn):
+        task = conn.execute("SELECT * FROM tasks WHERE id = ?", (task_id,)).fetchone()
+        comment = conn.execute("SELECT * FROM task_comments WHERE uid = ?", (comment_uid,)).fetchone()
+        if task is None or comment is None or comment["task_id"] != task_id:
+            raise ValueError("task/comment identity mismatch")
+        state = sync.sync_state(conn)
+        if state and (state["mode"] != "primary" or not state["gateway_id"]
+                      or task["created_on"] != state["gateway_id"]):
+            raise PermissionError("diagnostic correction requires the owning primary gateway")
+        if task["status"] not in ("todo", "ready", "blocked", "scheduled", "triage") or task["current_run_id"]:
+            raise ValueError("diagnostic correction requires an inactive open task")
+        if task["body"] != expected_body or comment["body"] != expected_comment:
+            raise ValueError("stale body or comment; no correction applied")
+        payload = {
+            "request_id": request_id, "comment_uid": comment_uid, "reason": reason,
+            "before": {"body": expected_body, "comment": expected_comment}, "after": after,
+            "operator": {"kind": "non-worker", "session": os.environ.get("HERMES_SESSION_ID"),
+                         "gateway": state["gateway_id"] if state else None},
+        }
+        conn.execute("UPDATE tasks SET body = ? WHERE id = ?", (after["body"], task_id))
+        conn.execute("UPDATE task_comments SET body = ? WHERE uid = ?", (after["comment"], comment_uid))
+        kb._append_event(conn, task_id, "diagnostic_corrected", payload)
+    return payload
+
+
+def quote_diagnostic(original: str, diagnostic: str) -> str:
+    """Insert quotation marks around an exact diagnostic occurrence."""
+    if not diagnostic or any(char in diagnostic for char in ('"', '\n', '\r')):
+        raise ValueError("diagnostic must be nonempty single-line text without double quotes")
+    if original.count(diagnostic) != 1:
+        raise ValueError("diagnostic occurrence is missing or ambiguous")
+    start = original.index(diagnostic)
+    acceptance = original.casefold().find("acceptance:")
+    if acceptance >= 0 and start + len(diagnostic) > acceptance:
+        raise ValueError("diagnostic overlaps acceptance text")
+    return original[:start] + f'"{diagnostic}"' + original[start + len(diagnostic):]
diff --git a/tests/hermes_cli/test_kanban_diagnostic_correction.py b/tests/hermes_cli/test_kanban_diagnostic_correction.py
new file mode 100644
index 0000000000..6646bf2fe5
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_diagnostic_correction.py
@@ -0,0 +1,74 @@
+"""Audited diagnostic quotation must not rewrite acceptance or destinations."""
+from __future__ import annotations
+
+import importlib
+import importlib.util
+
+import pytest
+
+from tests.hermes_cli import test_kanban_edit_operator_fields as fixtures
+
+kanban_home = fixtures.kanban_home
+
+
+def test_atomic_correction_keeps_original_comment_identity_and_audit(kanban_home):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    from hermes_cli import kanban_diagnostic_correction as correction
+
+    body = "Diagnostic: origin chat @session:example.\nAcceptance: unchanged."
+    comment = "Error: origin chat @session:example."
+    with kbc.connect_closing() as conn:
+        from hermes_cli import kanban_db_sync as sync
+        sync.apply_sync_schema_steps(conn)
+        conn.commit()
+        task_id = kb.create_task(conn, title="Correction fixture", body=body)
+        kb.add_comment(conn, task_id, "original-author", comment)
+        with kb.write_txn(conn):
+            conn.execute("UPDATE task_comments SET uid = ? WHERE task_id = ?", ("fixture-comment-1", task_id))
+        before = dict(conn.execute("SELECT * FROM task_comments WHERE task_id = ?", (task_id,)).fetchone())
+        apply = getattr(correction, "correct_diagnostics", None)
+        assert callable(apply), "audited atomic correction entry point is missing"
+        result = apply(
+            conn, task_id, comment_uid=before["uid"], expected_body=body, expected_comment=comment,
+            body_diagnostic="origin chat @session:example", comment_diagnostic="origin chat @session:example",
+            reason="The two occurrences reproduce an error; neither is a delivery destination.",
+            request_id="fixture-correction-1",
+        )
+        after = dict(conn.execute("SELECT * FROM task_comments WHERE task_id = ?", (task_id,)).fetchone())
+        assert after == {**before, "body": 'Error: "origin chat @session:example".'}
+        assert kb.get_task(conn, task_id).body == 'Diagnostic: "origin chat @session:example".\nAcceptance: unchanged.'
+        events = [event for event in kb.list_events(conn, task_id) if event.kind == "diagnostic_corrected"]
+        assert len(events) == 1
+        assert events[0].payload["before"] == {"body": body, "comment": comment}
+        assert events[0].payload["comment_uid"] == before["uid"]
+        assert result["request_id"] == "fixture-correction-1"
+
+
+@pytest.mark.parametrize(("original", "diagnostic", "reason"), [
+    ("No error here", "origin chat @session:example", "missing or ambiguous"),
+    ("x x", "x", "missing or ambiguous"),
+    ("Acceptance: x", "x", "acceptance"),
+    ("x", "", "nonempty single-line"),
+    ('a"b', 'a"b', "nonempty single-line"),
+    ("a\nb", "a\nb", "nonempty single-line"),
+])
+def test_quote_plan_refuses_unsafe_spans(original, diagnostic, reason):
+    module = importlib.import_module("hermes_cli.kanban_diagnostic_correction")
+    with pytest.raises(ValueError, match=reason):
+        module.quote_diagnostic(original, diagnostic)
+
+
+def test_quote_plan_preserves_every_other_byte():
+    spec = importlib.util.find_spec("hermes_cli.kanban_diagnostic_correction")
+    assert spec is not None, "supported diagnostic correction planner is missing"
+    module = importlib.import_module("hermes_cli.kanban_diagnostic_correction")
+    original = (
+        "Probe reproduces origin chat @session:example.\n\n"
+        "Acceptance: deliver to @session:real-destination and retain all gates."
+    )
+    result = module.quote_diagnostic(original, "origin chat @session:example")
+    assert result == (
+        'Probe reproduces "origin chat @session:example".\n\n'
+        "Acceptance: deliver to @session:real-destination and retain all gates."
+    )
