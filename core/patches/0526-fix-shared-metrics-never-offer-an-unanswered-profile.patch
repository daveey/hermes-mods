From 1fe662a3a40bd2ad76b628727b668af461664929 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 13:35:19 -0700
Subject: [PATCH] fix(shared-metrics): never offer; an unanswered profile reads
 as "No thanks"

consent_state() now always reports decided=True/reask=False, with enabled/send
taken from the profile's own config. The Desktop composer strip, the dashboard
offer, the pre-chat terminal offer and the end-of-setup offer all gate on
`decided`, so none of them shows again. Opting in stays explicit via
`hermes setup telemetry` or shared_metrics.set; collection still reads only the
profile's own keys (shipped default off).

Tests: the three tests that asserted the offer now assert it never appears,
one per entry path (Desktop RPC status, dashboard consent read, pre-chat offer,
end-of-setup offer), plus pre-fix answers kept without a re-ask.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../observability/shared_metrics_consent.py   | 12 ++--
 tests/hermes_cli/test_setup_telemetry.py      | 66 +++++++++++--------
 .../test_shared_metrics_consent_rpc.py        | 18 ++---
 3 files changed, 54 insertions(+), 42 deletions(-)

diff --git a/hermes_cli/observability/shared_metrics_consent.py b/hermes_cli/observability/shared_metrics_consent.py
index b1313c962a..6c1bd71f05 100644
--- a/hermes_cli/observability/shared_metrics_consent.py
+++ b/hermes_cli/observability/shared_metrics_consent.py
@@ -56,18 +56,16 @@ OFFER_VERSION = 2
 
 
 def consent_state(raw_cfg: Any) -> dict:
-    """``{enabled, send, decided, reask}`` from a RAW config mapping (no defaults merged). ``reask``:
-    an "off" answer from before ``OFFER_VERSION`` that may never have been seen; it reads undecided
-    so every surface offers it once more. An opt-in was always a deliberate pick and stays."""
+    """``{enabled, send, decided, reask}`` from a RAW config mapping (no defaults merged). Fork
+    default: a profile that never answered (or answered "off" before ``OFFER_VERSION``) reads as
+    "No thanks", so no surface ever offers; ``hermes setup telemetry`` still opts in explicitly."""
     section = _section(raw_cfg)
     enabled = section.get("enabled") is True
-    answered = "enabled" in section or "send" in section
-    reask = answered and not enabled and section.get("offer_version") != OFFER_VERSION
     return {
         "enabled": enabled,
         "send": enabled and section.get("send") is True,
-        "decided": answered and not reask,
-        "reask": reask,
+        "decided": True,
+        "reask": False,
     }
 
 
diff --git a/tests/hermes_cli/test_setup_telemetry.py b/tests/hermes_cli/test_setup_telemetry.py
index 93abca3742..e9764813e7 100644
