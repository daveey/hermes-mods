From 8efcd4c5e6a2ba47701dbbbcd54c74a9e89cb501 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 19:30:29 +0000
Subject: [PATCH] [daveey] spike(R1) V2b: old Board forbidden_field on a
 virtual wire field drops it, no omission, original retired

---
 hermes_cli/kanban_sync_client.py |  6 +++---
 hermes_cli/kanban_sync_compat.py | 24 +++++++++++++++++++++++-
 2 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index 5a5709dd68..8d7b089e3c 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -733,10 +733,10 @@ def push(conn: sqlite3.Connection, hub: Hub, board: str, gateway: str, *, primar
                     out.rejected += 1
                     _log.warning("kanban sync: %s %s %s rejected (%s)", board, row["table_name"], row["row_uid"], reason)
                     if res.get("reason") == "forbidden_field":
-                        from hermes_cli.kanban_sync_compat import enqueue_retry, record_rejection
+                        from hermes_cli.kanban_sync_compat import VIRTUAL_DROPPED, enqueue_retry, record_rejection
                         sent_op = next(op for op in wire if op["client_op_id"] == op_id)
-                        enqueue_retry(conn, row, sent_op, res)
-                        record_rejection(conn, row, reason)
+                        if enqueue_retry(conn, row, sent_op, res) != VIRTUAL_DROPPED:
+                            record_rejection(conn, row, reason)
                     elif row["table_name"] == "tasks" and res.get("reason") == "live_claim":
                         _record_live_claim_rejection(conn, row, reason)
                     if primary and res.get("row"):
diff --git a/hermes_cli/kanban_sync_compat.py b/hermes_cli/kanban_sync_compat.py
index bc2ddb370e..51f66ac05e 100644
--- a/hermes_cli/kanban_sync_compat.py
+++ b/hermes_cli/kanban_sync_compat.py
@@ -41,7 +41,7 @@ def record_rejection(conn: sqlite3.Connection, row: dict, reason: str) -> None:
                      {"reason": reason[:300], "fields": sorted(fields), "op_id": row["op_id"]})
 
 
-def enqueue_retry(conn: sqlite3.Connection, row: dict, wire: dict, result: dict) -> bool:
+def enqueue_retry(conn: sqlite3.Connection, row: dict, wire: dict, result: dict) -> bool | str:
     """Retain the rejected original; one fresh, non-hydrated upsert carries the reduced payload.
 
     The local-only op kind survives crashes and transient retries. The durable omission ledger
@@ -56,6 +56,8 @@ def enqueue_retry(conn: sqlite3.Connection, row: dict, wire: dict, result: dict)
     fields = wire.get("fields", {})
     if match[2] not in fields:
         return False
+    if match[2] in sync.VIRTUAL_WIRE_FIELDS.get(row["table_name"], frozenset()):
+        return _drop_virtual(conn, row, wire, match[2])
     reduced = {k: v for k, v in fields.items() if k != match[2]}
     retry_id = sync.uuid7()
     inserted = conn.execute(
@@ -71,3 +73,23 @@ def enqueue_retry(conn: sqlite3.Connection, row: dict, wire: dict, result: dict)
          "compat_import" if wire.get("import") else "compat", json.dumps(reduced),
          row.get("base_version"), wire["hlc"], row["created_at"]))
     return True
+
+
+VIRTUAL_DROPPED = "virtual_dropped"
+
+
+def _drop_virtual(conn: sqlite3.Connection, row: dict, wire: dict, field: str) -> str:
+    """An old Board refused a wire-only field (``sync.VIRTUAL_WIRE_FIELDS``): nothing local holds it, so there is
+    nothing to restore. Resend the same op without it under a fresh id, keeping the original op kind (a later
+    refusal of a real column still takes the omission path), and retire the refused original: an omission row
+    could never be delivered (``_queue_restore`` reads real columns only) and a retained rejected op would hold
+    the card from repair (``repair_holds``) forever."""
+    reduced = {k: v for k, v in (row["fields"] if isinstance(row["fields"], dict)
+                                 else json.loads(row["fields"])).items() if k != field}
+    conn.execute(
+        "INSERT INTO kanban_sync_outbox (op_id, table_name, row_uid, op, fields, base_version, hlc, created_at) "
+        "VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+        (sync.uuid7(), row["table_name"], row["row_uid"], row["op"], json.dumps(reduced),
+         row.get("base_version"), wire["hlc"], row["created_at"]))
+    conn.execute("DELETE FROM kanban_sync_outbox WHERE op_id = ?", (row["op_id"],))
+    return VIRTUAL_DROPPED
-- 
2.51.0

