Stepping derived the stripe from the sections' flat row model; in the projects overview the drawn lane rows aren't in that model, so green rows there had no message count and were skipped (⌘] bounced between two sessions). Rows now publish their painted stripe (data-sidebar-stripe) and stepping trusts it for drawn rows, falling back to the model only for unmounted virtualized rows.
---
 .../src/app/chat/sidebar/session-row.tsx      |  2 ++
 .../src/store/sidebar-visible-order.test.ts   | 35 +++++++++++++++++++
 .../src/store/sidebar-visible-order.ts        | 13 +++++++
 3 files changed, 50 insertions(+)

diff --git a/apps/desktop/src/app/chat/sidebar/session-row.tsx b/apps/desktop/src/app/chat/sidebar/session-row.tsx
index b4aa51813b..98a7c979aa 100644
--- a/apps/desktop/src/app/chat/sidebar/session-row.tsx
+++ b/apps/desktop/src/app/chat/sidebar/session-row.tsx
@@ -418,6 +418,8 @@ function SidebarSessionRowImpl({
         data-glass-opaque={dragging ? '' : undefined}
         // ⌘⇧] / ⌘⇧[ read the drawn row order from this (sidebar-visible-order).
         data-sidebar-session-id={session.id}
+        // ⌘] / ⌘[ stop on rows whose painted stripe is done / stuck.
+        data-sidebar-stripe={statusStripe ?? undefined}
         data-working={liveTurn ? 'true' : undefined}
         // The row runs BOTH drags off one press, and each declines outside its
         // own region — so no timing/arbitration rule is needed and neither can
diff --git a/apps/desktop/src/store/sidebar-visible-order.test.ts b/apps/desktop/src/store/sidebar-visible-order.test.ts
index aa499289e7..53c0d5d19b 100644
--- a/apps/desktop/src/store/sidebar-visible-order.test.ts
+++ b/apps/desktop/src/store/sidebar-visible-order.test.ts
@@ -173,4 +173,39 @@ describe('nextSidebarSessionId (⌘] / ⌘[)', () => {
     expect(toggleSessionBlocked('d')).toBe(false)
     expect(nextSidebarSessionId('a', 1, false)).toBe('d')
   })
+
+  it('trusts the stripe a drawn row paints over the section row model (projects view)', () => {
+    // The projects overview draws lane rows the section's flat model doesn't
+    // carry, so the model has no `message_count` for them: a green row there
+    // used to be skipped. The drawn row's own stripe is the authority.
+    const group = document.createElement('div')
+    const anchor = document.createElement('span')
+    group.append(anchor)
+
+    for (const [id, stripe] of [
+      ['p1', 'done'],
+      ['p2', ''],
+      ['p3', 'done'],
+      ['p4', 'blocked'],
+      ['p5', 'stuck']
+    ] as const) {
+      const row = document.createElement('div')
+      row.dataset.sidebarSessionId = id
+
+      if (stripe) {
+        row.dataset.sidebarStripe = stripe
+      }
+
+      group.append(row)
+    }
+
+    document.body.append(group)
+    publishSidebarSection(key, { anchor, ids: ['other'], turnIds: [] })
+    dots.value = { p1: 'idle', p2: 'idle', p3: 'idle', p4: 'idle', p5: 'needs-input' }
+
+    expect(nextSidebarSessionId('p1', 1, false)).toBe('p3')
+    expect(nextSidebarSessionId('p3', 1, false)).toBe('p5') // p4 is grey (⌘B)
+    expect(nextSidebarSessionId('p5', 1, false)).toBe('p1') // wraps
+    expect(nextSidebarSessionId('p1', -1, false)).toBe('p5')
+  })
 })
diff --git a/apps/desktop/src/store/sidebar-visible-order.ts b/apps/desktop/src/store/sidebar-visible-order.ts
index 48ff68d943..7ba31c0a3e 100644
--- a/apps/desktop/src/store/sidebar-visible-order.ts
+++ b/apps/desktop/src/store/sidebar-visible-order.ts
@@ -86,6 +86,19 @@ export function sessionHasStatusStripe(id: string): boolean {
     return false
   }
 
+  // A drawn row is the authority: step exactly where the sidebar paints a
+  // green / red stripe. The projects overview draws lane rows the sections'
+  // flat row model doesn't carry, so the model below had no message count
+  // for them and skipped green rows there.
+  const row = document.querySelector<HTMLElement>(`[data-sidebar-session-id="${CSS.escape(id)}"]`)
+
+  if (row) {
+    const stripe = row.dataset.sidebarStripe
+
+    return stripe === 'done' || stripe === 'stuck'
+  }
+
+  // Not drawn (virtualized off-screen row): derive it from the row model.
   let hasTurns = false
 
   for (const entry of sections.values()) {
