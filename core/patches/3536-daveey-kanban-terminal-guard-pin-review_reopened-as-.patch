From cd7bdaa7cb3f3ab2679717e80e1a3f24d2f0b4ed Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 13:12:39 +0000
Subject: [PATCH] [daveey] kanban terminal guard: pin review_reopened as a
 reopen (tests)

PR #2186 post-merge check t_01a1d4f926aae458 found two surviving mutants:
c1 drops "review_reopened" from kanban_terminal_guard.REOPEN_KINDS, and
c3 makes reopen_review_task return False for any card with a prior
`completed` event. Both survived all 11 guard/review-reopen test files
(264 passed, same as baseline).

Tests only, in tests/hermes_cli/test_kanban_stale_wake_terminal.py:

* test_a_review_reopen_after_the_completion_is_a_reopen[scheduled|blocked]:
  `completed`, then `review_reopened` ordered after it, row parked; asserts
  terminal_hold is None, unblock_task returns True and lands ready, and no
  stale_wake_ignored note. RED under c1 (terminal_hold returns the
  completion), GREEN on main.
* test_a_review_reopen_after_a_completion_and_reopen_cycle_lands_and_is_not_held:
  the real path (complete -> reopen_done_task -> claim -> request_review ->
  reopen_review_task); asserts the review reopen lands ready, writes
  review_reopened, and the card is not held. RED under c3, GREEN on main.

Proof: hermes-core-wt test on test_kanban_stale_wake_terminal.py +
test_kanban_review_lifecycle.py, 49 passed; scripts/check --base origin/main
19 checks ok. Card t_01a1d505d871e800.
---
 .../test_kanban_stale_wake_terminal.py        | 35 +++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_stale_wake_terminal.py b/tests/hermes_cli/test_kanban_stale_wake_terminal.py
index 8050f2b020..be85bed9ea 100644
--- a/tests/hermes_cli/test_kanban_stale_wake_terminal.py
+++ b/tests/hermes_cli/test_kanban_stale_wake_terminal.py
@@ -426,6 +426,41 @@ def test_unblock_of_a_live_card_still_lands(board):
         assert _ignored(board, tid) == []
 
 
+@pytest.mark.parametrize("parked", ["scheduled", "blocked"])
+def test_a_review_reopen_after_the_completion_is_a_reopen(board, parked):
+    """``review_reopened`` is in ``REOPEN_KINDS``: a card completed, then reopened through review and parked, is live.
+    Without it ``unblock_task`` refuses the card and a wake skips it (PR #2186 post-merge mutant c1)."""
+    tid = _parked(board)
+    with kb.write_txn(board):
+        kb._append_event(board, tid, "completed", {})
+        kb._append_event(board, tid, "review_reopened", None)
+        board.execute("UPDATE tasks SET status = ? WHERE id = ?", (parked, tid))
+    assert ktg.terminal_hold(board, tid) is None
+    assert kb.unblock_task(board, tid) is True
+    assert _status(board, tid) == "ready"
+    assert _ignored(board, tid) == []
+
+
+def test_a_review_reopen_after_a_completion_and_reopen_cycle_lands_and_is_not_held(board):
+    """The real path: done, reopened by an operator, back in ``review``; the review reopen still lands (PR #2186
+    post-merge mutant c3 refused any card with a prior ``completed``), and the card is not held afterwards."""
+    from hermes_cli.kanban_db_operator import reopen_done_task
+    tid = kb.create_task(board, title="t", assignee="worker")
+    claim = kb.claim_task(board, tid, claimer="worker")
+    assert claim is not None
+    assert kb.complete_task(board, tid, result="first pass", expected_run_id=claim.current_run_id) is True
+    assert reopen_done_task(board, tid, reason="more", actor="david") == "ready"
+    claim = kb.claim_task(board, tid, claimer="worker")
+    assert claim is not None
+    assert kb.request_review(board, tid, summary="second pass", expected_run_id=claim.current_run_id) is True
+    assert _status(board, tid) == "review"
+    assert kb.reopen_review_task(board, tid) is True
+    assert _status(board, tid) == "ready"
+    assert "review_reopened" in _kinds(board, tid)
+    assert ktg.terminal_hold(board, tid) is None
+    assert _ignored(board, tid) == []
+
+
 def test_unblock_of_a_done_row_is_refused_without_a_note(board):
     """Not unblockable anyway: the row is already terminal, so there is no stale wake to record."""
     tid = kb.create_task(board, title="t", assignee="worker")
