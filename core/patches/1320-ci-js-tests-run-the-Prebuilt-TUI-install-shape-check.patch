From 5974f72bb3e63b27612e29e6d368aa23eeaa1c33 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 19:52:08 +0000
Subject: [PATCH] ci(js-tests): run the Prebuilt TUI install-shape checks on
 frontend PRs [daveey]

---
 .github/workflows/js-tests.yml     | 35 +++++++++++++
 scripts/ci/classify_changes.py     | 10 +++-
 tests/ci/test_classify_changes.py  |  9 +++-
 tests/ci/test_tui_install_shape.py | 80 ++++++++++++++++++++++++++++++
 4 files changed, 131 insertions(+), 3 deletions(-)
 create mode 100644 tests/ci/test_tui_install_shape.py

diff --git a/.github/workflows/js-tests.yml b/.github/workflows/js-tests.yml
index 735b5e0a4e..309d6b42d4 100644
--- a/.github/workflows/js-tests.yml
+++ b/.github/workflows/js-tests.yml
@@ -124,3 +124,38 @@ jobs:
         # every earlier step passed: a step that failed midway can leave its own temp files
         # (a half-extracted download, a worktree its later cleanup never removed).
         uses: ./.github/actions/check-clean-worktree
+
+  # The Prebuilt TUI job of termux-verify.yml installs ONLY ui-tui + tests-js
+  # (npm adds apps/shared and ui-tui/packages/hermes-ink), not the full
+  # workspace the job above installs. A tests-js or ui-tui change that assumes
+  # another workspace is installed passes `check` above and first fails there,
+  # on some unrelated scripts/termux or pm PR: termux-verify's path filter never
+  # runs it on the PR that made the break (7a33a706f5, then run 41097455062 on
+  # PR #339). This job runs the same install and the same three commands on
+  # every PR that runs this workflow (the frontend lane), so the break lands on
+  # its own PR. Its steps must stay identical to termux-verify's `tui` job
+  # (tests/ci/test_tui_install_shape.py). About 2 minutes. [daveey]
+  tui-install-shape:
+    name: Prebuilt TUI install-shape checks
+    runs-on: [self-hosted, hermes-hub]
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a  # v7.0.1 (fork: upstream uses useblacksmith/checkout)
+        with:
+          ref: ${{ inputs.commit }}
+          persist-credentials: false
+      - uses: ./.github/actions/setup-pm
+        with:
+          toolchain: all
+          # tests-js generates real icons; the wrapper needs core Pillow/resvg.
+          extras: '[]'
+          cache-node: false
+      - name: Install the locked JS workspace
+        run: npm ci --workspace ui-tui --workspace tests-js --include-workspace-root --include=dev --no-fund --no-audit
+      - name: Check and bundle the TUI
+        run: |
+          npm run check --workspace tests-js
+          npm run check --workspace ui-tui
+          npm run build --workspace ui-tui
+      - name: Check the checkout is clean
+        uses: ./.github/actions/check-clean-worktree
diff --git a/scripts/ci/classify_changes.py b/scripts/ci/classify_changes.py
index 857f65eee8..f9e139d592 100644
--- a/scripts/ci/classify_changes.py
+++ b/scripts/ci/classify_changes.py
@@ -94,7 +94,15 @@ import sys
 
 _FRONTEND = ("ui-tui/", "web/", "apps/")  # TS typecheck-matrix packages
 # Shipped page outside those packages, exercised by the desktop Electron suite.
-_FRONTEND_FILES = {"scripts/desktop-update/ui.html"}
+_FRONTEND_FILES = {
+    "scripts/desktop-update/ui.html",
+    # Root inputs of every workspace's checks: each package's eslint config
+    # imports the shared one, and .npmrc shapes every ``npm ci``. As
+    # unrecognized paths they ran only the Python lane, so a lint-breaking edit
+    # went green on its own PR. [daveey]
+    "eslint.config.shared.mjs",
+    ".npmrc",
+}
 # The WhatsApp bridge's ``node --test`` suites run in the JS & TS job, so a
 # change to the bridge or to the Python adapter that speaks its protocol
 # selects ``frontend``.
diff --git a/tests/ci/test_classify_changes.py b/tests/ci/test_classify_changes.py
index dd73cfdaeb..7f876639a2 100644
--- a/tests/ci/test_classify_changes.py
+++ b/tests/ci/test_classify_changes.py
@@ -287,9 +287,14 @@ CASES = {
         ["apps/desktop/eslint.config.mjs"],
         _lanes(frontend=True),
     ),
-    "shared eslint config → python": (
+    # Every workspace's eslint config imports it, so it must run the JS checks.
+    "shared eslint config → python + frontend": (
         ["eslint.config.shared.mjs"],
-        _lanes(python=True),
+        _lanes(python=True, frontend=True),
+    ),
+    "root .npmrc → python + frontend": (
+        [".npmrc"],
+        _lanes(python=True, frontend=True),
     ),
     "ui-tui eslint config → frontend": (
         ["ui-tui/eslint.config.mjs"],
diff --git a/tests/ci/test_tui_install_shape.py b/tests/ci/test_tui_install_shape.py
new file mode 100644
index 0000000000..ca2e6e7d00
--- /dev/null
+++ b/tests/ci/test_tui_install_shape.py
@@ -0,0 +1,80 @@
+"""The Prebuilt TUI install shape is checked on the PRs that can break it.
+
+termux-verify.yml's ``tui`` job installs only ui-tui + tests-js (npm adds
+apps/shared and ui-tui/packages/hermes-ink) and runs their checks. Its path
+filter covers scripts/termux, pm and its own tests, so a tests-js or ui-tui
+change never ran it on its own PR: 7a33a706f5 added a tests-js test that
+assumed apps/desktop was installed, passed the main CI's full install, and
+first failed on the unrelated pm PR #339 (run 41097455062).
+
+js-tests.yml's ``tui-install-shape`` job runs the same install and commands on
+every PR that selects the frontend lane. These tests keep the two jobs from
+drifting apart and keep the job inside the merge gate.
+"""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+_REPO = Path(__file__).resolve().parents[2]
+_spec = importlib.util.spec_from_file_location("classify_changes", _REPO / "scripts/ci/classify_changes.py")
+assert _spec and _spec.loader
+_classify = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(_classify)
+
+
+def _yaml(rel: str):
+    yaml = pytest.importorskip("hermes_yaml")
+    return yaml.safe_load((_REPO / rel).read_text(encoding="utf-8-sig"))
+
+
+def _shape(job: dict) -> list:
+    """The steps that define the install shape: setup inputs and every run command."""
+    out = []
+    for step in job["steps"]:
+        uses = step.get("uses", "")
+        if uses == "./.github/actions/setup-pm":
+            out.append(("setup-pm", step.get("with") or {}))
+        elif "run" in step:
+            out.append(("run", step["run"].strip()))
+    return out
+
+
+def test_main_ci_job_matches_the_termux_prebuilt_tui_job():
+    termux = _yaml(".github/workflows/termux-verify.yml")["jobs"]["tui"]
+    main = _yaml(".github/workflows/js-tests.yml")["jobs"]["tui-install-shape"]
+    assert _shape(main) == _shape(termux)
+    runs = [cmd for kind, cmd in _shape(main) if kind == "run"]
+    # The point of the job: a minimal install, not the full workspace.
+    assert any("npm ci --workspace ui-tui --workspace tests-js --include-workspace-root" in r for r in runs)
+    assert not any(r.startswith("npm ci") and "apps/desktop" in r for r in runs)
+    assert "npm run check --workspace tests-js" in runs[-1]
+    assert "npm run build --workspace ui-tui" in runs[-1]
+    assert not main.get("continue-on-error")
+
+
+def test_job_gates_the_merge_through_js_tests():
+    ci = _yaml(".github/workflows/ci.yaml")
+    js = ci["jobs"]["js-tests"]
+    assert js["uses"] == "./.github/workflows/js-tests.yml"
+    assert "frontend" in js["if"]
+    assert "js-tests" in ci["jobs"]["all-checks-pass"]["needs"]
+    assert "if" not in _yaml(".github/workflows/js-tests.yml")["jobs"]["tui-install-shape"]
+
+
+@pytest.mark.parametrize("path", [
+    "tests-js/run-workspace-checks.test.mjs",
+    "ui-tui/src/entry.tsx",
+    "ui-tui/packages/hermes-ink/src/index.ts",
+    "apps/shared/src/index.ts",
+    ".github/scripts/run-workspace-checks.mjs",
+    "package.json",
+    "package-lock.json",
+    "scripts/build/tui.mjs",
+    "eslint.config.shared.mjs",
+    ".npmrc",
+])
+def test_every_input_of_the_shape_selects_the_frontend_lane(path):
+    assert _classify.classify([path])["frontend"] is True
-- 
