From f8d8391d87ff5b16258da0a5f8e9339a89db005d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 02:22:44 +0000
Subject: [PATCH] test(worker-legacy-scopes): derive stale inode from the
 recreated scope [daveey]

test_stale_records_are_ignored rmdir'd the scope, recreated it, then marked
the record stale with `old_ino + 1`. The recreated directory's inode is the
filesystem's choice: under parallel CI load it can be exactly old_ino + 1 (a
freed child inode reused), so the "stale" record matched the live scope and
register() refused with "already registered to another owner" (CI run
43348004549, slice 6). Set the stale inode from the recreated directory's
actual inode + 1 so it can never match.

Repro: a scratch test patching Path.lstat to give the recreated dir
old_ino + 1 fails with the CI ValueError before, passes after.
---
 tests/hermes_cli/test_worker_legacy_scopes.py | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_worker_legacy_scopes.py b/tests/hermes_cli/test_worker_legacy_scopes.py
index bfcf3d9c58..ad63aad1cf 100644
--- a/tests/hermes_cli/test_worker_legacy_scopes.py
+++ b/tests/hermes_cli/test_worker_legacy_scopes.py
@@ -129,8 +129,11 @@ def test_stale_records_are_ignored(env):
     (pool / 'old-job.scope' / 'cpu.weight').unlink()
     (pool / 'old-job.scope').rmdir()
     assert legacy.lookup(pool, 'old-job.scope') is None
-    scope(pool)
-    data['ino'] += 1
+    # The recreated directory's inode is up to the filesystem and can be the old
+    # one + 1 (a freed child inode reused under parallel load), so derive the
+    # stale identity from the scope that actually exists now.
+    recreated = scope(pool)
+    data['ino'] = recreated.lstat().st_ino + 1
     path.write_text(json.dumps(data))
     assert legacy.register('old-job.scope', db, 't2', pool=pool)['owner'][1] == 't2'
 
