From b55e36a61dc91a44d828b3b2cd36f5df8fde94e6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 2 Nov 2026 09:24:09 +0000
Subject: [PATCH] test(gateway): stub service discovery and synchronize
 teardown [daveey]

---
 hermes_cli/gateway.py                                |  6 +-----
 ..._restart_installed_service_external_supervisor.py | 12 +++++++-----
 2 files changed, 8 insertions(+), 10 deletions(-)

diff --git a/hermes_cli/gateway.py b/hermes_cli/gateway.py
index e3002da03cd..004929e0e0a 100644
--- a/hermes_cli/gateway.py
+++ b/hermes_cli/gateway.py
@@ -5483,11 +5483,7 @@ def _cmd_restart(args):
         gateway_declares_external_supervisor, refuse_restart_of_service_managed_gateway,
         restart_externally_supervised_gateway, start_restart_replacement,
     )
-    # External supervision is the running process's lifecycle contract, so it is honored before
-    # any service dispatch, even when the installed canonical service owns the gateway: a
-    # service-manager failure (a stale or unloaded canonical definition beside a custom agent)
-    # exited 1 before the graceful SIGUSR1 handback was ever reached. This is also the only
-    # handback point: the manual fallback below never sees a supervised gateway (#110637).
+    # Honor the running process's supervisor before service failures can prevent handback.
     supervised_pid = get_running_pid()
     if supervised_pid and gateway_declares_external_supervisor(supervised_pid):
         restart_externally_supervised_gateway(supervised_pid)
diff --git a/tests/hermes_cli/test_gateway_restart_installed_service_external_supervisor.py b/tests/hermes_cli/test_gateway_restart_installed_service_external_supervisor.py
index 061072e332d..f6979f2add7 100644
--- a/tests/hermes_cli/test_gateway_restart_installed_service_external_supervisor.py
+++ b/tests/hermes_cli/test_gateway_restart_installed_service_external_supervisor.py
@@ -21,7 +21,6 @@ import signal
 import subprocess
 import sys
 import threading
-import time
 
 import pytest
 
@@ -127,8 +126,8 @@ def scenario(tmp_path, monkeypatch):
     monkeypatch.setattr(gw, "_guard_named_profile_under_multiplexer", lambda **k: None)
     monkeypatch.setattr(gw, "_dispatch_via_service_manager_if_s6", lambda *a, **k: False)
     monkeypatch.setattr(gw, "_reap_unsupervised_gateway_orphans", lambda *a, **k: 0)  # never scan real processes
-    # Installed launchd stub (the real _installed_service_kind_for runs against it).
-    monkeypatch.setattr(gw, "is_macos", lambda: True)
+    # Stub service discovery, not the host OS; no real launchctl is ever called.
+    monkeypatch.setattr(gw, "_installed_service_kind_for", lambda *a: "launchd")
     monkeypatch.setattr(gw, "_systemd_unit_installed", lambda *a, **k: False)
     monkeypatch.setattr(gw, "get_launchd_plist_path", lambda: plist)
     monkeypatch.setattr(gw, "_launchd_domain", lambda: "gui/501")
@@ -189,11 +188,14 @@ def test_refusal_guards_still_run_before_the_handback(scenario, monkeypatch):
     def _refuse(verb, args):
         raise SystemExit(4)
 
+    def unexpected_handback(*args):
+        pytest.fail("refused restart reached handback")
+
+    monkeypatch.setattr(supervised, "restart_externally_supervised_gateway", unexpected_handback)
     monkeypatch.setattr("hermes_cli.gateway_lifecycle_guards.refuse_while_sessions_live", _refuse)
     with pytest.raises(SystemExit) as exc:
         gw.gateway_command(_parse("restart", "--detach"))
     assert exc.value.code == 4
-    time.sleep(0.2)
     assert supervisor.first.poll() is None, "a refused restart must not signal the gateway"
     assert calls["service"] == []
 
@@ -218,7 +220,7 @@ def test_fake_supervisor_close_never_relaunches_after_teardown(tmp_path):
     supervisor = _FakeSupervisor(script)
     first_pid = supervisor.first.pid
     supervisor.close()
-    time.sleep(0.5)  # longer than a relaunch takes to start a second child
+    supervisor._watcher.join(timeout=10)
     assert supervisor.second is None, "close() must stop the supervisor before it kills the gateway"
     assert supervisor.first.returncode is not None
     assert not supervisor._watcher.is_alive()
-- 
2.55.0

