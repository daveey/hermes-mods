+def gc_task_scratch(conn: sqlite3.Connection, *, older_than_days: int | None = None) -> int:
     """Retry terminal scratch cleanup, failing closed on any unreadable board.
 
     Only task records establish ownership; never infer it from directory names.
     Read every board before the first removal, even if an earlier board reports
     a live sharer. Keep the selected owner locked against concurrent resumption.
+
+    A tree that is kept only because it holds standalone git clones is archived
+    and then removed once its card finished more than *older_than_days* ago
+    (default ``kanban.worktree_retention_days``; 0 disables). [daveey]
     """
     import shutil
 
     from hermes_cli import kanban_db as kb
 
+    days = retention_days() if older_than_days is None else older_than_days
     removed = 0
+    aged: list[tuple[str, Path, int | None]] = []
     with kb.write_txn(conn):
         try:
             rows = conn.execute(
-                "SELECT id, workspace_path FROM tasks WHERE workspace_kind='scratch' "
-                f"AND status IN {ws._TERMINAL_STATUSES_SQL}"
+                "SELECT t.id, t.workspace_path, t.completed_at, t.created_at, "
+                "(SELECT MAX(created_at) FROM task_events e WHERE e.task_id=t.id "
+                " AND e.kind NOT LIKE 'workspace%') AS last_event "
+                "FROM tasks t WHERE t.workspace_kind='scratch' "
+                f"AND t.status IN {ws._TERMINAL_STATUSES_SQL}"
             ).fetchall()
             for board in ws._sibling_board_db_files(conn):
                 with _read_board(board) as other:
@@ -63,18 +73,81 @@ def gc_task_scratch(conn: sqlite3.Connection) -> int:
                 continue
             if ws._has_active_children(conn, row["id"]):
                 continue
-            if not ws._scratch_tree_removable(path):
+            removable = ws._scratch_tree_removable(path)
+            if not removable and not _finished_before(row, days):
                 continue
             if ws._defer_shared_workspace_cleanup(conn, row["id"], path):
                 continue
+            if not removable:
+                aged.append((row["id"], path, row["completed_at"]))
+                continue
             ws.release_lsp_clients(str(path))
             shutil.rmtree(path, ignore_errors=True)
             if not path.exists():
                 ws._log_scratch_removal(conn, row["id"], path, "scratch workspace (GC retry)")
                 removed += 1
+    # Archiving runs git for minutes on big clones: never hold the board's write lock for it.
+    for task_id, path, completed_at in aged:
+        removed += _archive_and_remove_scratch(conn, task_id, path, completed_at)
     return removed
 
 
+def _finished_before(row: sqlite3.Row, days: int) -> bool:
+    if days <= 0:
+        return False
+    since = row["completed_at"] or row["last_event"] or row["created_at"]
+    return bool(since and since <= time.time() - days * 86400)
+
+
+def _board_slug(conn: sqlite3.Connection) -> str:
+    from hermes_cli.kanban_db_connect import _main_db_file
+    from hermes_cli.kanban_db_sync import board_slug_for_path
+    db_file = _main_db_file(conn)
+    return board_slug_for_path(db_file) if db_file else "default"
+
+
+def _archive_and_remove_scratch(conn: sqlite3.Connection, task_id: str, path: Path,
+                                completed_at: int | None) -> int:
+    """Archive every git repo in an aged scratch tree, then remove it; 1 when removed.
+
+    Any refusal or failure keeps the workspace and logs why. The owner is
+    re-checked under the write lock after archiving, and the tree is renamed
+    away inside that lock so a resumed card can never see it half-deleted.
+    """
+    import shutil
+    import subprocess
+
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_scratch_archive as sa
+
+    archive_dir = kb.kanban_home() / "archive" / "scratch" / _board_slug(conn) / task_id
+    try:
+        final = sa.archive_workspace(path, archive_dir, task_id=task_id, completed_at=completed_at)
+    except (sa.ArchiveRefused, OSError, subprocess.SubprocessError, ValueError) as exc:
+        log.info("Keeping aged scratch workspace for task %s: %s (%s)", task_id, path, exc)
+        return 0
+    ws.release_lsp_clients(str(path))
+    trash = path.with_name(f".{path.name}.gc-{os.getpid()}")
+    with kb.write_txn(conn):
+        if (not ws._is_terminal_task(conn, task_id) or ws._has_active_children(conn, task_id)
+                or ws._defer_shared_workspace_cleanup(conn, task_id, path)):
+            log.info("Keeping scratch workspace for task %s after archiving it to %s: "
+                     "the card is live again or shares the path: %s", task_id, final, path)
+            return 0
+        try:
+            path.rename(trash)
+        except OSError as exc:
+            log.info("Keeping aged scratch workspace for task %s: cannot move %s away (%s); "
+                     "archive at %s", task_id, path, exc, final)
+            return 0
+        kb._append_event(conn, task_id, "workspace_archived", {"path": str(path), "archive": str(final)})
+        ws._log_scratch_removal(conn, task_id, path, "scratch workspace (aged, git archived)")
+    shutil.rmtree(trash, ignore_errors=True)
+    if trash.exists():
+        log.warning("Archived scratch workspace for task %s was not fully removed: %s", task_id, trash)
+    return 1
+
+
 def gc_task_worktrees(conn: sqlite3.Connection, *, older_than_days: int = 7,
                      repo_root: str | None = None) -> int:
     """Reap terminal rows only, retaining active children and cross-board sharers.
diff --git a/tests/hermes_cli/test_kanban_scratch_gc_archive.py b/tests/hermes_cli/test_kanban_scratch_gc_archive.py
new file mode 100644
index 00000000000..cb734f57de3
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_scratch_gc_archive.py
@@ -0,0 +1,252 @@
+"""Aged terminal scratch holding git clones is archived, then removed. [daveey]"""
+import argparse
+import json
+import os
+import subprocess
+import tarfile
+import time
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_ops
+
+OLD = int(time.time()) - 10 * 86400
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "hermes"))
+    monkeypatch.delenv("HERMES_KANBAN_DB", raising=False)
+    monkeypatch.delenv("HERMES_KANBAN_BOARD", raising=False)
+    monkeypatch.delenv("HERMES_KANBAN_WORKSPACES_ROOT", raising=False)
+    return tmp_path
+
+
+def _run(*args, cwd=None):
+    return subprocess.run(
+        ["git", "-c", "user.name=t", "-c", "user.email=t@example.com",
+         "-c", "init.defaultBranch=main", *args],
+        cwd=cwd, check=True, capture_output=True, text=True,
+    ).stdout.strip()
+
+
+@pytest.fixture
+def remote(tmp_path):
+    src = tmp_path / "seed"
+    src.mkdir()
+    _run("init", "-q", cwd=src)
+    (src / "tracked.txt").write_text("one\n")
+    _run("add", ".", cwd=src)
+    _run("commit", "-q", "-m", "seed", cwd=src)
+    bare = tmp_path / "remote.git"
+    _run("clone", "-q", "--bare", str(src), str(bare))
+    return bare
+
+
+def _task(status="done", completed_at=OLD, clone_into="repo", remote=None):
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="scratch with clone")
+        path = kb.workspaces_root() / tid
+        path.mkdir(parents=True)
+        (path / "notes.txt").write_text("scratch")
+        if remote is not None:
+            target = path if clone_into == "." else path / clone_into
+            if clone_into == ".":
+                _run("clone", "-q", str(remote), str(target / "tmpclone"))
+                for entry in (target / "tmpclone").iterdir():
+                    entry.rename(target / entry.name)
+                (target / "tmpclone").rmdir()
+            else:
+                _run("clone", "-q", str(remote), str(target))
+        with kb.write_txn(conn):
+            conn.execute(
+                "UPDATE tasks SET status=?, workspace_kind='scratch', workspace_path=?, "
+                "completed_at=?, created_at=? WHERE id=?",
+                (status, str(path), completed_at, OLD, tid),
+            )
+    return tid, path
+
+
+def _gc(days=7):
+    return kanban_ops._cmd_gc(argparse.Namespace(
+        event_retention_days=0, log_retention_days=0, worktree_retention_days=days,
+    ))
+
+
+def _archive(tid, board_slug="default"):
+    return kb.kanban_home() / "archive" / "scratch" / board_slug / tid
+
+
+def _events(tid):
+    with kbc.connect_closing() as conn:
+        return [(r["kind"], json.loads(r["payload"] or "null"))
+                for r in conn.execute("SELECT kind, payload FROM task_events WHERE task_id=?", (tid,))]
+
+
+def test_clean_pushed_clone_is_archived_and_removed(board, remote):
+    tid, path = _task(remote=remote)
+    assert _gc() == 0
+    assert not path.exists()
+    meta = json.loads((_archive(tid) / "repo" / "meta.json").read_text())
+    assert meta["task_id"] == tid and meta["completed_at"] == OLD
+    assert meta["branch"] == "main" and meta["head"]
+    assert meta["remotes"]["origin"] == str(remote)
+    assert sorted(os.listdir(_archive(tid) / "repo")) == ["meta.json"]
+    archived = [p for k, p in _events(tid) if k == "workspace_archived"]
+    assert archived == [{"path": str(path), "archive": str(_archive(tid))}]
+    assert not [p for p in path.parent.iterdir() if p.name.startswith(".")]
+
+
+def test_uncommitted_and_untracked_land_in_diff_and_tar(board, remote):
+    tid, path = _task(remote=remote)
+    (path / "repo" / "tracked.txt").write_text("one\nlocal edit\n")
+    (path / "repo" / "new.txt").write_text("brand new\n")
+    (path / "repo" / "node_modules").symlink_to(board)  # never followed
+    assert _gc() == 0
+    assert not path.exists()
+    dest = _archive(tid) / "repo"
+    assert "+local edit" in (dest / "tracked.diff").read_text()
+    with tarfile.open(dest / "untracked.tar") as tar:
+        names = tar.getnames()
+        assert "new.txt" in names
+        assert tar.extractfile("new.txt").read() == b"brand new\n"
+        assert tar.getmember("node_modules").issym()
+
+
+def test_unpushed_commit_lands_in_verified_bundle(board, remote, tmp_path):
+    tid, path = _task(remote=remote)
+    repo = path / "repo"
+    (repo / "tracked.txt").write_text("two\n")
+    _run("commit", "-q", "-am", "unpushed work", cwd=repo)
+    sha = _run("rev-parse", "HEAD", cwd=repo)
+    assert _gc() == 0
+    assert not path.exists()
+    bundle = _archive(tid) / "repo" / "commits.bundle"
+    check = tmp_path / "check"
+    _run("clone", "-q", str(remote), str(check))
+    _run("bundle", "verify", str(bundle), cwd=check)
+    assert sha in _run("bundle", "list-heads", str(bundle), cwd=check)
+
+
+def test_workspace_that_is_itself_a_clone(board, remote):
+    tid, path = _task(remote=remote, clone_into=".")
+    (path / "extra.txt").write_text("x")
+    assert _gc() == 0
+    assert not path.exists()
+    dest = _archive(tid)
+    assert json.loads((dest / "meta.json").read_text())["task_id"] == tid
+    with tarfile.open(dest / "untracked.tar") as tar:
+        assert {"extra.txt", "notes.txt"} <= set(tar.getnames())
+
+
+def test_young_workspace_is_kept(board, remote):
+    _, path = _task(remote=remote, completed_at=int(time.time()) - 3600)
+    assert _gc() == 0
+    assert (path / "repo" / ".git").is_dir()
+
+
+def test_retention_zero_keeps_it(board, remote):
+    tid, path = _task(remote=remote)
+    assert _gc(days=0) == 0
+    assert (path / "repo" / ".git").is_dir()
+    assert not _archive(tid).exists()
+
+
+@pytest.mark.parametrize("status", ["ready", "running", "blocked", "review"])
+def test_nonterminal_card_keeps_it(board, remote, status):
+    tid, path = _task(remote=remote, status=status)
+    assert _gc() == 0
+    assert (path / "repo" / ".git").is_dir()
+    assert not _archive(tid).exists()
+
+
+def test_active_child_keeps_it(board, remote):
+    tid, path = _task(remote=remote)
+    with kbc.connect_closing() as conn:
+        kb.create_task(conn, title="needs artifacts", parents=[tid])
+    assert _gc() == 0
+    assert (path / "repo" / ".git").is_dir()
+    assert not _archive(tid).exists()
+
+
+def test_live_sharer_on_another_board_keeps_it(board, remote):
+    tid, path = _task(remote=remote)
