From 738ff9ab5b8362abaef0dd37749f221e55cc943b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 04:05:16 -0800
Subject: [PATCH] ci: state-contract-dispatch: one concurrency group per event,
 so a daily or manual run can't cancel a push run [daveey]

ci_main_watch reads a cancelled newest push run on main as red; a shared group let the 11:17 UTC schedule or a manual dispatch cancel an in-flight push run.
---
 .github/workflows/state-contract-dispatch.yml | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/state-contract-dispatch.yml b/.github/workflows/state-contract-dispatch.yml
index a8860677a3a..36607be3c03 100644
--- a/.github/workflows/state-contract-dispatch.yml
+++ b/.github/workflows/state-contract-dispatch.yml
@@ -54,7 +54,9 @@ permissions:
   contents: read
 
 concurrency:
-  group: state-contract-dispatch
+  # One group per event, so a scheduled or manual run never cancels a push run: ci_main_watch reads the newest
+  # push run on main, and a cancelled one with no newer push run reads as red.
+  group: state-contract-dispatch-${{ github.event_name }}
   cancel-in-progress: true
 
 jobs:
-- 
2.55.0

