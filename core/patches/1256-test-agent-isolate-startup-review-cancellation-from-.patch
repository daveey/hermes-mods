From 2ec33a80eb3f85c75d990ffd3ced5fa6640e47a4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 06:42:27 -0700
Subject: [PATCH] test(agent): isolate startup review cancellation from
 scheduler latency [daveey] (#305)

---
 tests/agent/test_background_review.py | 29 ++++++++++++++++++---------
 1 file changed, 19 insertions(+), 10 deletions(-)

diff --git a/tests/agent/test_background_review.py b/tests/agent/test_background_review.py
index 9f766065271..6fbb10d2493 100644
--- a/tests/agent/test_background_review.py
+++ b/tests/agent/test_background_review.py
@@ -528,6 +528,13 @@ def test_live_turn_waits_for_review_exit_before_relay_and_turn_context(monkeypat
 
 def test_live_turn_cancels_review_during_startup_before_provider(monkeypatch):
     """A review cancelled before its worker runs must never call its provider."""
+    import agent.background_review as background_review_module
+
+    # This tests startup ordering, not the production cancellation deadline.
+    # Leave room for a descheduled test thread to start the captured worker.
+    monkeypatch.setattr(
+        background_review_module, "_BACKGROUND_REVIEW_CANCEL_TIMEOUT_SECONDS", 30.0
+    )
     provider_calls = []
     boundary_reached = threading.Event()
 
@@ -537,14 +544,16 @@ def test_live_turn_cancels_review_during_startup_before_provider(monkeypatch):
 
     monkeypatch.setattr(run_agent_module, "AIAgent", RecordingReviewAgent)
     CapturingThread.targets = []
-    monkeypatch.setattr(run_agent_module.threading, "Thread", CapturingThread)
-
     agent = _bare_agent()
-    AIAgent._spawn_background_review(
-        agent,
-        messages_snapshot=[{"role": "user", "content": "hello"}],
-        review_memory=True,
-    )
+    # Capture only the review spawn: the real foreground wrapper may lazily
+    # discover plugins, whose loader needs actual threads (including args).
+    with monkeypatch.context() as capture:
+        capture.setattr(run_agent_module.threading, "Thread", CapturingThread)
+        AIAgent._spawn_background_review(
+            agent,
+            messages_snapshot=[{"role": "user", "content": "hello"}],
+            review_memory=True,
+        )
     run = agent._background_review_run
     assert run is not None
 
@@ -557,12 +566,12 @@ def test_live_turn_cancels_review_during_startup_before_provider(monkeypatch):
         daemon=True,
     )
     live.start()
-    assert run.cancel_requested.wait(2.0)
+    assert run.cancel_requested.wait(30.0)
 
     worker = _REAL_THREAD(target=CapturingThread.targets[0], daemon=True)
     worker.start()
-    worker.join(timeout=2.0)
-    live.join(timeout=2.0)
+    worker.join(timeout=30.0)
+    live.join(timeout=30.0)
 
     assert not worker.is_alive()
     assert not live.is_alive()
-- 
