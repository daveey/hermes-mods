+import { describe, expect, it, vi } from 'vitest'
+
+import { classifyBackendExit, createBackendExitSender } from './backend-exit-report'
+
+describe('classifyBackendExit', () => {
+  it('marks a SIGTERM during a core update (live marker) as a planned update restart', async () => {
+    await expect(classifyBackendExit({ code: null, signal: 'SIGTERM' }, async () => true)).resolves.toEqual({
+      code: null,
+      signal: 'SIGTERM',
+      planned: 'update'
+    })
+  })
+
+  it('reports an exit with no update in progress as unexpected', async () => {
+    const payload = { code: 1, signal: null, error: 'boom' }
+
+    await expect(classifyBackendExit(payload, async () => false)).resolves.toEqual(payload)
+  })
+
+  it('reports the exit as unexpected when the update probe fails, so a real crash is never hidden', async () => {
+    const payload = { code: null, signal: 'SIGKILL' }
+
+    await expect(
+      classifyBackendExit(payload, async () => {
+        throw new Error('marker unreadable')
+      })
+    ).resolves.toEqual(payload)
+  })
+})
+
+describe('createBackendExitSender', () => {
+  function harness({ planned = false, silenced = false } = {}) {
+    const send = vi.fn()
+    const log = vi.fn()
+
+    const sender = createBackendExitSender({
+      isSilenced: () => silenced,
+      isPlannedRestart: async () => planned,
+      window: () => ({ isDestroyed: () => false, webContents: { isDestroyed: () => false, send } }),
+      log
+    })
+
+    return { log, send, sender }
+  }
+
+  it('sends a planned update exit with planned set and logs it', async () => {
+    const { log, send, sender } = harness({ planned: true })
+
+    await sender({ code: null, signal: 'SIGTERM' })
+
+    expect(send).toHaveBeenCalledWith('hermes:backend-exit', { code: null, signal: 'SIGTERM', planned: 'update' })
+    expect(log).toHaveBeenCalledWith(expect.stringContaining('planned update'))
+  })
+
+  it('sends an unexpected exit unchanged', async () => {
+    const { log, send, sender } = harness()
+
+    await sender({ code: 1, signal: null })
+
+    expect(send).toHaveBeenCalledWith('hermes:backend-exit', { code: 1, signal: null })
+    expect(log).not.toHaveBeenCalled()
+  })
+
+  it('stays silent during an intentional soft re-home', async () => {
+    const { send, sender } = harness({ silenced: true })
+
+    await sender({ code: null, signal: 'SIGTERM' })
+
+    expect(send).not.toHaveBeenCalled()
+  })
+})
diff --git a/apps/desktop/electron/backend-exit-report.ts b/apps/desktop/electron/backend-exit-report.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7bee3c33ef16c650178ce090010b08234b7501e6
--- /dev/null
+++ b/apps/desktop/electron/backend-exit-report.ts
@@ -0,0 +1,67 @@
+/**
+ * [daveey] What the renderer is told when the primary backend child exits.
+ *
+ * A planned restart (a core update — `hermes update` stops the Desktop-owned
+ * backend while it holds the update marker — or this app's own update
+ * hand-off) is not a crash: the payload carries `planned: 'update'` so the
+ * renderer shows a quiet "Updating Hermes…" notice instead of the red
+ * "stopped working in the background" card. Anything else, including a probe
+ * that throws, is reported as unexpected: a real crash must never be hidden.
+ */
+export type BackendExitPayload = {
+  code: number | null
+  signal: string | null
+  error?: string
+  planned?: 'update'
+}
+
+export async function classifyBackendExit(
+  payload: BackendExitPayload,
+  isPlannedRestart: () => boolean | Promise<boolean>
+): Promise<BackendExitPayload> {
+  let planned = false
+
+  try {
+    planned = Boolean(await isPlannedRestart())
+  } catch {
+    planned = false
+  }
+
+  return planned ? { ...payload, planned: 'update' } : payload
+}
+
+type ExitWindow = {
+  isDestroyed(): boolean
+  webContents?: { isDestroyed(): boolean; send(channel: string, payload: BackendExitPayload): void } | null
+}
+
+/**
+ * `sendBackendExit` for the primary window: silent while `isSilenced` (an intentional soft re-home), otherwise
+ * classifies the exit and sends `hermes:backend-exit`. Returns the send's promise for tests; main ignores it.
+ */
+export function createBackendExitSender(deps: {
+  isSilenced: () => boolean
+  isPlannedRestart: () => boolean | Promise<boolean>
+  window: () => ExitWindow | null | undefined
+  log: (line: string) => void
+}) {
+  return (payload: BackendExitPayload): Promise<void> => {
+    if (deps.isSilenced()) {
+      return Promise.resolve()
+    }
+
+    return classifyBackendExit(payload, deps.isPlannedRestart).then(classified => {
+      if (classified.planned) {
+        deps.log('[supervisor] backend exit during a planned update; renderer shows the quiet updating notice')
+      }
+
+      const win = deps.window()
+
+      if (!win || win.isDestroyed() || !win.webContents || win.webContents.isDestroyed()) {
+        return
+      }
+
+      win.webContents.send('hermes:backend-exit', classified)
+    })
+  }
+}
diff --git a/apps/desktop/src/app/gateway/hooks/use-gateway-boot-exit-notice.test.tsx b/apps/desktop/src/app/gateway/hooks/use-gateway-boot-exit-notice.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..be721aad78bd6bef7326db312be705b0e7ea0326
--- /dev/null
+++ b/apps/desktop/src/app/gateway/hooks/use-gateway-boot-exit-notice.test.tsx
@@ -0,0 +1,198 @@
+import { act, cleanup, render } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+import { $desktopBoot } from '@/store/boot'
+import { closeSecondaryGateways } from '@/store/gateway'
+import { $notifications, clearNotifications } from '@/store/notifications'
+import { $activeGatewayProfile } from '@/store/profile'
+import { $connection, $gatewayState } from '@/store/session'
+
+import { FakeWebSocket } from '../../../test/fake-gateway-socket'
+
+import { takeGatewaySurvivor } from './gateway-hmr-survivor'
+import { BACKEND_EXIT_TOAST_ID, BACKEND_UPDATING_TOAST_ID, useGatewayBoot } from './use-gateway-boot'
+
+// [daveey] The backend-exit notices. hermes-sync's core update SIGTERMs the Desktop-owned backend several times a
+// day and main marks that exit `planned: 'update'`; seen 2026-10-29 07:29/08:14/08:38/09:10 as four red "stopped
+// working in the background" cards that never cleared. Shares the fake socket with use-gateway-boot.test.tsx.
+
+vi.mock(import('@/store/terminal-backend-warning'), () => ({
+  warnIfTerminalBackendUnavailable: vi.fn(async () => false)
+}))
+
+const primaryConn = {
+  authMode: 'token' as const,
+  baseUrl: 'https://vps.example.com',
+  connectionId: 'primary-vps',
+  profile: 'default',
+  token: 't',
+  wsUrl: 'wss://vps.example.com/api/ws?token=t'
+}
+
+let backendExit: null | ((payload: unknown) => void) = null
+
+function fakeDesktop() {
+  const unsubscribe = () => () => undefined
+
+  return {
+    getConnection: vi.fn(async () => primaryConn),
+    getGatewayWsUrl: vi.fn(async (conn?: { wsUrl?: string }) => conn?.wsUrl ?? primaryConn.wsUrl),
+    getBootProgress: vi.fn(async () => ({
+      error: null,
+      fakeMode: false,
+      message: '',
+      phase: 'init',
+      progress: 0,
+      retryable: false,
+      running: true,
+      timestamp: Date.now()
+    })),
+    onBootProgress: vi.fn(unsubscribe),
+    onBackendExit: vi.fn(callback => {
+      backendExit = callback
+
+      return () => {
+        backendExit = null
+      }
+    }),
+    onConnectionApplied: vi.fn(unsubscribe),
+    onPowerResume: vi.fn(unsubscribe),
+    revalidateConnection: vi.fn(async () => ({ ok: true, rebuilt: false })),
+    onWindowStateChanged: vi.fn(unsubscribe),
+    touchBackend: vi.fn(async () => undefined),
+    profile: { get: vi.fn(async () => ({ profile: 'default' })) }
+  }
+}
+
+function Harness() {
+  useGatewayBoot({
+    beforeConnectionSwitch: () => undefined,
+    handleGatewayEvent: () => undefined,
+    handleServerRequest: () => false,
+    onConnectionReady: () => undefined,
+    onGatewayReady: () => undefined,
+    refreshHermesConfig: async () => undefined,
+    refreshSessions: async () => undefined
+  })
+
+  return null
+}
+
+function closeSurvivor() {
+  try {
+    takeGatewaySurvivor()?.gateway.close()
+  } catch {
+    // ignore
+  }
+}
+
+const originalWebSocket = globalThis.WebSocket
+
+beforeEach(() => {
+  closeSurvivor()
+  closeSecondaryGateways()
+  clearNotifications()
+  backendExit = null
+  $activeGatewayProfile.set('default')
+  $connection.set(null)
+  vi.useFakeTimers()
+  FakeWebSocket.mode = 'open'
+  FakeWebSocket.instances = []
+  FakeWebSocket.pingMode = 'pong'
+  ;(globalThis as { WebSocket: unknown }).WebSocket = FakeWebSocket
+  ;(window as { hermesDesktop?: unknown }).hermesDesktop = fakeDesktop()
+  $gatewayState.set('idle')
+  $desktopBoot.set({
+    error: null,
+    fakeMode: false,
+    message: '',
+    phase: 'init',
+    progress: 0,
+    running: true,
+    timestamp: Date.now(),
+    visible: true
+  })
+})
+
+afterEach(() => {
+  cleanup()
+  closeSurvivor()
+  closeSecondaryGateways()
+  clearNotifications()
+  $connection.set(null)
+  vi.useRealTimers()
+  ;(globalThis as { WebSocket: unknown }).WebSocket = originalWebSocket
+  delete (window as { hermesDesktop?: unknown }).hermesDesktop
+})
+
+async function flushAsync() {
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(0)
+  })
+}
+
+const errorIds = () => $notifications.get().filter(entry => entry.kind === 'error').map(entry => entry.id)
+
+it('a planned core-update exit after boot shows one quiet updating notice and no crash card', async () => {
+  render(<Harness />)
+  await flushAsync()
+  expect($desktopBoot.get().visible).toBe(false)
+
+  act(() => backendExit?.({ code: null, signal: 'SIGTERM', planned: 'update' }))
+  act(() => backendExit?.({ code: null, signal: 'SIGTERM', planned: 'update' }))
+
+  expect(errorIds()).toEqual([])
+  expect($notifications.get().map(entry => [entry.id, entry.kind])).toEqual([[BACKEND_UPDATING_TOAST_ID, 'info']])
+  expect($notifications.get()[0]?.action).toBeUndefined()
+})
+
+it('a planned core-update exit while the boot overlay is up does not fail the boot', async () => {
+  const desktop = fakeDesktop()
+  desktop.getConnection = vi.fn(() => new Promise<never>(() => undefined))
+  ;(window as { hermesDesktop?: unknown }).hermesDesktop = desktop
+
+  render(<Harness />)
+  await flushAsync()
+  expect($desktopBoot.get().visible).toBe(true)
+
+  act(() => backendExit?.({ code: null, signal: 'SIGTERM', planned: 'update' }))
+
+  expect($desktopBoot.get().error).toBeNull()
+  expect($notifications.get()).toHaveLength(0)
+})
+
+it('an unexpected exit still raises the crash card, and repeated exits keep exactly one', async () => {
+  render(<Harness />)
+  await flushAsync()
+
+  act(() => backendExit?.({ code: null, signal: 'SIGTERM' }))
+  act(() => backendExit?.({ code: 1, signal: null }))
+  act(() => backendExit?.({ code: null, signal: 'SIGKILL' }))
+
+  expect(errorIds()).toEqual([BACKEND_EXIT_TOAST_ID])
+})
+
+it('the crash card and the updating notice clear once the backend serves again', async () => {
+  render(<Harness />)
+  await flushAsync()
+  expect($gatewayState.get()).toBe('open')
+
+  act(() => backendExit?.({ code: null, signal: 'SIGTERM' }))
+  act(() => backendExit?.({ code: null, signal: 'SIGTERM', planned: 'update' }))
+  expect(
+    $notifications
+      .get()
+      .map(entry => entry.id)
+      .sort()
+  ).toEqual([BACKEND_EXIT_TOAST_ID, BACKEND_UPDATING_TOAST_ID].sort())
+
+  // The old child's socket drops; the respawned backend accepts the reconnect.
+  act(() => FakeWebSocket.instances.at(-1)!.drop())
+  expect($gatewayState.get()).not.toBe('open')
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(15_000)
+  })
+
+  expect($gatewayState.get()).toBe('open')
+  expect($notifications.get()).toHaveLength(0)
+})
