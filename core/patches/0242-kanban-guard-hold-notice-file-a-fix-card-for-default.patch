From a596df362e401f3d3e4157e68857cf823ba33aa9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 10:48:46 -0700
Subject: [PATCH 242/248] kanban guard-hold notice: file a fix card for default instead
 of posting to the Inbox

---
 hermes_cli/kanban_db_dispatch_guard_notice.py | 30 ++++++++++++++-----
 .../hermes_cli/test_kanban_park_invariants.py | 12 ++++----
 2 files changed, 30 insertions(+), 12 deletions(-)

diff --git a/hermes_cli/kanban_db_dispatch_guard_notice.py b/hermes_cli/kanban_db_dispatch_guard_notice.py
index 0d1a53e394..3f2fe8f92b 100644
--- a/hermes_cli/kanban_db_dispatch_guard_notice.py
+++ b/hermes_cli/kanban_db_dispatch_guard_notice.py
@@ -1,12 +1,12 @@
-"""Respawn-guard hold notice: one kanban comment per unbroken hold. [daveey]
+"""Respawn-guard hold notice: one kanban comment + one fix card per unbroken hold. [daveey]
 
 Well before the hold cap, a held card must be visible: past
 ``HERMES_KANBAN_GUARD_HOLD_NOTIFY_SECONDS`` (default 30 min) of unbroken hold the dispatcher
-posts ONE kanban comment naming the guard reason and, for ``active_pr``, the PR and its
-failing checks (2026-10-21: t_806b9e8f sat held 360 min on a PR with 11 failing checks and
-nothing said so). No Inbox card: the Inbox is reserved for owner-only decisions (AGENTS.md)
-and a guard hold is agent-fixable board state. Split out of ``kanban_db_dispatch``
-(code-health file cap).
+posts ONE kanban comment + a fix card (assignee default) naming the guard reason and, for
+``active_pr``, the PR and its failing checks (2026-10-21: t_806b9e8f sat held 360 min on a PR
+with 11 failing checks and nothing said so). Never an Inbox card: the Inbox is reserved for
+owner-only decisions (AGENTS.md) and a guard hold is agent-fixable board state. Split out of
+``kanban_db_dispatch`` (code-health file cap).
 """
 
 from __future__ import annotations
@@ -66,8 +66,23 @@ def _pr_failing_checks(pr_url: str) -> str:
     return f"{len(failing)} failing check(s): " + ", ".join(failing[:12]) if failing else ""
 
 
+def _file_fix_card(conn: sqlite3.Connection, task_id: str, reason: str, body: str) -> None:
+    """Agent-fixable hold -> a Kanban card for the default assignee (never the Inbox: David
+    muted the ``kanban-dispatcher`` poster after 3 unactioned cards). Idempotent per hold."""
+    from hermes_cli import kanban_db as _kb
+
+    try:
+        _kb.create_task(
+            conn, title=f"Fix respawn-guard hold ({reason}) on {task_id}"[:120],
+            body=(f"{body}\n\nRead kanban card {task_id}'s latest [respawn-guard] comment, fix the cause "
+                  f"(failing PR checks, binding) and unblock it. Only ask David for a decision he alone can make."),
+            assignee="default", created_by="kanban-dispatcher", idempotency_key=f"guard-hold:{task_id}")
+    except Exception:
+        logger.warning("kanban: guard-hold fix card for %s failed", task_id, exc_info=True)
+
+
 def notify_guard_hold(conn: sqlite3.Connection, task_id: str, reason: str) -> bool:
-    """Once per unbroken hold, past the notify threshold: one kanban comment. [daveey]"""
+    """Once per unbroken hold, past the notify threshold: comment + fix card. [daveey]"""
     from hermes_cli import kanban_db as _kb
     from hermes_cli import kanban_db_dispatch as _kbd
 
@@ -95,6 +110,7 @@ def notify_guard_hold(conn: sqlite3.Connection, task_id: str, reason: str) -> bo
             f"without running.{detail} It will be auto-blocked at the hold cap; fix the cause "
             f"(merge/close the PR, rebind, or unblock) before then.")
     _kb.add_comment(conn, task_id, "kanban-dispatcher", body)
+    _file_fix_card(conn, task_id, reason, body)
     return True
 
 
diff --git a/tests/hermes_cli/test_kanban_park_invariants.py b/tests/hermes_cli/test_kanban_park_invariants.py
index 429f313009..817be296a5 100644
--- a/tests/hermes_cli/test_kanban_park_invariants.py
+++ b/tests/hermes_cli/test_kanban_park_invariants.py
@@ -382,12 +382,12 @@ def test_desktop_relaunch_after_update_gets_scrubbed_env(monkeypatch, tmp_path):
 
 def test_guard_hold_posts_one_comment_and_no_inbox_card_naming_pr_and_checks(
         kanban_home, monkeypatch, all_assignees_spawnable):
-    """Within 30 min of a hold the card gets ONE kanban comment naming the PR and its failing
-    checks, NO Inbox card (Inbox = owner-only decisions, AGENTS.md), one ``respawn_guarded``
-    event per hold instead of one per tick, and the notice does not restart the hold clock
-    (the 6 h cap still fires). [daveey]"""
+    """Within 30 min of a hold the card gets ONE kanban comment + ONE fix card (assignee default)
+    naming the PR and its failing checks, NO Inbox card (Inbox = owner-only decisions, AGENTS.md),
+    one ``respawn_guarded`` event per hold instead of one per tick, and the notice does not
+    restart the hold clock (the 6 h cap still fires). [daveey]"""
     pr = "https://github.com/daveey/hermes/pull/19"
-    posted = []
+    posted, cards = [], []
     monkeypatch.setattr(kbd._guard_notice, "_pr_failing_checks", lambda url: "2 failing check(s): lint, unit")
     real_run = kbd._guard_notice.subprocess.run
 
@@ -396,6 +396,7 @@ def test_guard_hold_posts_one_comment_and_no_inbox_card_naming_pr_and_checks(
             posted.append(cmd)
         return real_run(["true"], *a, **k)
     monkeypatch.setattr(kbd._guard_notice.subprocess, "run", _spy_run)
+    monkeypatch.setattr(kbd._guard_notice, "_file_fix_card", lambda conn, tid, reason, body: cards.append((tid, reason, body)))
     with kbc.connect() as conn:
         tid = kb.create_task(conn, title="pr held", assignee="a")
         kb.add_comment(conn, tid, "a", f"opened {pr}")
@@ -409,6 +410,7 @@ def test_guard_hold_posts_one_comment_and_no_inbox_card_naming_pr_and_checks(
         kbd.dispatch_once(conn, spawn_fn=lambda *a, **k: 1)
         kbd.dispatch_once(conn, spawn_fn=lambda *a, **k: 1)  # second tick: no duplicate
         assert not posted and not hasattr(kbd._guard_notice, "_post_inbox_card")
+        assert [(c[0], c[1]) for c in cards] == [(tid, "active_pr")] and pr in cards[0][2]
         notes = [c for c in kb.list_comments(conn, tid) if c.body.startswith("[respawn-guard]")]
         assert len(notes) == 1
         assert pr in notes[0].body and "lint, unit" in notes[0].body and "active_pr" in notes[0].body
-- 
