Subject: [PATCH] [daveey] fence forensic copies for justified SQLite guard
 exemption

---
 hermes_state_repair.py                       |  8 +--
 tests/hermes_state/test_repair_copy_fence.py | 54 ++++++++++++++++++++
 2 files changed, 59 insertions(+), 3 deletions(-)
 create mode 100644 tests/hermes_state/test_repair_copy_fence.py

diff --git a/hermes_state_repair.py b/hermes_state_repair.py
index 6dba2a837c7..d4921f5712f 100644
--- a/hermes_state_repair.py
+++ b/hermes_state_repair.py
@@ -474,9 +474,11 @@ def _publish_backup_bundle(db_path: Path, staging: Path, backup_path: Path) -> N
                 for suffix, sidecar in zip(_DB_SIDECAR_SUFFIXES, _sidecars(db_path)) if sidecar.exists()]
     published: list[Path] = []
     try:
-        for src, staged, _dst in (main, *sidecars):
-            # sqlite-sidecar-open: ok — _backup_db_file refuses while this database has a live connection.
-            shutil.copy2(src, staged)
+        from hermes_cli.sqlite_safe_read import offline_file_access
+        with offline_file_access(db_path):
+            for src, staged, _dst in (main, *sidecars):
+                # sqlite-sidecar-open: ok — offline_file_access fences connections for the whole copy.
+                shutil.copy2(src, staged)
         for _src, staged, dst in (*sidecars, main):
             os.replace(staged, dst)
             published.append(dst)
diff --git a/tests/hermes_state/test_repair_copy_fence.py b/tests/hermes_state/test_repair_copy_fence.py
new file mode 100644
index 00000000000..54872c37c1c
--- /dev/null
+++ b/tests/hermes_state/test_repair_copy_fence.py
@@ -0,0 +1,54 @@
+"""Raw forensic copies must hold the connection-lifecycle fence, not just check it."""
+import sqlite3
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+
+from hermes_cli.sqlite_safe_read import LiveConnectionError, connect_tracked
+from hermes_state_repair import _publish_backup_bundle
+
+
+def test_copy_rejects_connection_opened_after_preflight(tmp_path):
+    db = tmp_path / "state.db"
+    conn = connect_tracked(db)
+    try:
+        with pytest.raises(LiveConnectionError):
+            _publish_backup_bundle(db, tmp_path / "staged", tmp_path / "backup")
+        assert not (tmp_path / "backup").exists()
+    finally:
+        conn.close()
+
+
+def test_copy_holds_fence_against_concurrent_opener(tmp_path, monkeypatch):
+    import hermes_state_repair as repair
+
+    db = tmp_path / "state.db"
+    conn = connect_tracked(db)
+    conn.execute("CREATE TABLE sample (value)")
+    conn.close()
+    original = repair.shutil.copy2
+    probes = []
+
+    def attempt_open():
+        try:
+            peer = connect_tracked(db, wait_for_tracking=False)
+        except sqlite3.OperationalError:
+            return "fenced"
+        peer.close()
+        return "opened"
+
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        def checked_copy(src, dst):
+            result = pool.submit(attempt_open).result(timeout=5)
+            probes.append(result)
+            assert result == "fenced"
+            return original(src, dst)
+
+        monkeypatch.setattr(repair.shutil, "copy2", checked_copy)
+        _publish_backup_bundle(db, tmp_path / "staged", tmp_path / "backup")
+    assert probes == ["fenced"]
+    restored = sqlite3.connect(tmp_path / "backup")
+    try:
+        assert restored.execute("SELECT * FROM sample").fetchall() == []
+    finally:
+        restored.close()
