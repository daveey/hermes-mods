From a5a79b09d006602971e180da29cd470cf39131dd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 18:49:25 +0000
Subject: [PATCH] [daveey] kanban dup detector: a repeat completion of the card
 in the detector body adds no comment

note_completion's repeat dedupe only looked at the detector card's comments.
The first occurrence is written into the detector card's body, so when that
first card was reopened and completed again the detector posted its line a
second time as a comment.

The dedupe now also counts an occurrence line ("\n- <card> ") in the body.
An id that only appears quoted inside a handoff is still a new occurrence.

RED (before the fix): test_the_card_named_in_the_body_completing_again_adds_no_comment
failed with one extra dup-detector comment. GREEN: test_kanban_dup_detector*.py,
29 passed.

Card: t_01a1d639077fda84 (found closing PR #2522's mutant gaps).
---
 hermes_cli/kanban_dup_detector.py             |  7 ++---
 .../test_kanban_dup_detector_repeat.py        | 26 +++++++++++++++++++
 2 files changed, 30 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_dup_detector.py b/hermes_cli/kanban_dup_detector.py
index 59fbd56a34..bee86c53fc 100644
--- a/hermes_cli/kanban_dup_detector.py
+++ b/hermes_cli/kanban_dup_detector.py
@@ -125,11 +125,12 @@ def note_completion(conn: sqlite3.Connection, task_id: str, *texts: Optional[str
             return None
         sibling, creator = hit
         line = _occurrence(task_id, sibling, creator, text)
-        row = conn.execute("SELECT id FROM tasks WHERE idempotency_key LIKE ? AND status NOT IN ('done', "
+        row = conn.execute("SELECT id, body FROM tasks WHERE idempotency_key LIKE ? AND status NOT IN ('done', "
                            "'archived') ORDER BY created_at LIMIT 1", (KEY_PREFIX + "%",)).fetchone()
         if row:
-            seen = conn.execute("SELECT 1 FROM task_comments WHERE task_id = ? AND body LIKE ?",
-                                (row[0], f"- {task_id} %")).fetchone()
+            # The first occurrence is the body's line, later ones are comments: either means this card is noted.
+            seen = f"\n- {task_id} " in (row[1] or "") or conn.execute(
+                "SELECT 1 FROM task_comments WHERE task_id = ? AND body LIKE ?", (row[0], f"- {task_id} %")).fetchone()
             if not seen:
                 kb.add_comment(conn, row[0], "dup-detector", line)
             return row[0]
diff --git a/tests/hermes_cli/test_kanban_dup_detector_repeat.py b/tests/hermes_cli/test_kanban_dup_detector_repeat.py
index e19940ffcc..5452ce2fa6 100644
--- a/tests/hermes_cli/test_kanban_dup_detector_repeat.py
+++ b/tests/hermes_cli/test_kanban_dup_detector_repeat.py
@@ -38,3 +38,29 @@ def test_the_same_card_noted_twice_is_commented_once(conn):
         assert dd.note_completion(conn, third, f"duplicate of {first}") == card
     comments = [c.body for c in kb.list_comments(conn, card)]
     assert len(comments) == 1 and comments[0].startswith(f"- {third} closed as a duplicate of {first};")
+
+
+def test_the_card_named_in_the_body_completing_again_adds_no_comment(conn):
+    """The first occurrence lives in the detector card's body, not a comment (card t_01a1d639077fda84): its card
+    completing again must not post the same line as a comment."""
+    creator = kb.create_task(conn, title="creator", assignee="default")
+    first, second = (kb.create_task(conn, title=t, assignee="default", creator_task_id=creator)
+                     for t in ("first", "second"))
+    card = dd.note_completion(conn, second, f"duplicate of {first}")
+    assert card is not None
+    task = kb.get_task(conn, card)
+    assert task is not None and f"\n- {second} closed as a duplicate of {first};" in (task.body or "")
+    for _ in range(2):  # the second card is reopened and completes again
+        assert dd.note_completion(conn, second, f"duplicate of {first}") == card
+    assert kb.list_comments(conn, card) == []
+
+
+def test_a_card_whose_id_only_appears_quoted_in_the_body_is_still_commented(conn):
+    """Only an occurrence line counts as seen: an id quoted inside the first card's handoff is a new occurrence."""
+    creator = kb.create_task(conn, title="creator", assignee="default")
+    first, second, third = (kb.create_task(conn, title=t, assignee="default", creator_task_id=creator)
+                            for t in ("first", "second", "third"))
+    card = dd.note_completion(conn, second, f"duplicate of {first}; see also {third}")
+    assert card is not None and dd.note_completion(conn, third, f"duplicate of {first}") == card
+    comments = [c.body for c in kb.list_comments(conn, card)]
+    assert len(comments) == 1 and comments[0].startswith(f"- {third} closed as a duplicate of {first};")
-- 
