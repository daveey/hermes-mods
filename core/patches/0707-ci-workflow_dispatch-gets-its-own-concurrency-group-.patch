From 250ee8a8a8e1d3688b0e4f4cd255f0e0f74ca9bf Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 10:25:53 +0000
Subject: [PATCH] ci: workflow_dispatch gets its own concurrency group so a
 manual gate on main is never superseded by or blocking pushes [daveey]

---
 .github/workflows/ci.yaml | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/ci.yaml b/.github/workflows/ci.yaml
index 95c4bdace8..10c12beadf 100644
--- a/.github/workflows/ci.yaml
+++ b/.github/workflows/ci.yaml
@@ -54,8 +54,13 @@ permissions:
 # older pending one is superseded — the newer run tests a tree containing it).
 # A per-run group queued one full suite per push and saturated the shared
 # hermes-hub runners. [daveey]
+# Manual gate: a workflow_dispatch run (e.g. a green-gate run on main HEAD)
+# gets its own group `ci-dispatch-<run_id>`. Before, it shared `ci-main`: it
+# held the slot while pushes behind it were superseded one by one, and a
+# pending dispatch could itself be cancelled by the next push. Now a dispatch
+# is never superseded and never blocks the push group; pushes still coalesce.
 concurrency:
-  group: ci-${{ inputs.release == true && github.run_id || github.ref == 'refs/heads/main' && 'main' || (github.event_name == 'pull_request' && github.event.pull_request.number || github.ref) }}
+  group: ci-${{ inputs.release == true && github.run_id || github.event_name == 'workflow_dispatch' && format('dispatch-{0}', github.run_id) || github.ref == 'refs/heads/main' && 'main' || (github.event_name == 'pull_request' && github.event.pull_request.number || github.ref) }}
   cancel-in-progress: ${{ inputs.release != true && github.event_name == 'pull_request' }}
 
 jobs:
-- 
