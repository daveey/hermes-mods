From 9fd190840a03189ad13939f7cf83cbc68428ea16 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 02:10:06 +0000
Subject: [PATCH] test(update): retain fence custody assertions after rebase
 [daveey]

---
 tests/hermes_cli/test_update_preswap_deadline.py         | 4 +++-
 tests/hermes_cli/test_update_preswap_strict_discovery.py | 3 ++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_update_preswap_deadline.py b/tests/hermes_cli/test_update_preswap_deadline.py
index 94e687a966..fcdd2a6039 100644
--- a/tests/hermes_cli/test_update_preswap_deadline.py
+++ b/tests/hermes_cli/test_update_preswap_deadline.py
@@ -249,10 +249,12 @@ def test_the_pause_hands_one_deadline_to_the_stop_that_covers_discovery(monkeypa
     monkeypatch.setattr(record, "record_pause", lambda *a: None)
     monkeypatch.setattr(record, "mark_stop_requested", lambda *a, **k: None)
     monkeypatch.setattr(record, "sync", lambda token: None)
-    monkeypatch.setattr(pause, "_stop_gateways", lambda token, entries, deadline=None: seen.update(deadline=deadline))
+    monkeypatch.setattr(pause, "_stop_gateways", lambda token, entries, deadline=None, **kw:
+                        seen.update(deadline=deadline, **kw))
     token = pause._empty_token()
     assert pause._pause(token) is None
     assert seen["deadline"] == 100.0 + pause._PRE_SWAP_DRAIN_WAIT_S
+    assert seen["fence_checked"] is True
 
 
 def test_discovery_that_spent_the_whole_budget_stops_nothing(monkeypatch):
diff --git a/tests/hermes_cli/test_update_preswap_strict_discovery.py b/tests/hermes_cli/test_update_preswap_strict_discovery.py
index 6f8c511b44..613d30125b 100644
--- a/tests/hermes_cli/test_update_preswap_strict_discovery.py
+++ b/tests/hermes_cli/test_update_preswap_strict_discovery.py
@@ -11,6 +11,7 @@ from hermes_cli import update_cmd_posix_pause as pause
 from hermes_cli import update_fleet_scope as scope, update_pause_deferrals as deferrals
 
 UNIT = "hermes-gateway-review"
+REAL_STOP_GATEWAYS = pause._stop_gateways
 
 
 @pytest.fixture
@@ -121,7 +122,7 @@ def test_stop_verification_failures_report_third_attempt_and_rollback(probes, mo
 
     _, report = probes
     # Use the real stop transaction and async systemctl helper, never a host mutation.
-    monkeypatch.setattr(pause, "_stop_gateways", pause._stop_busy_gateways)
+    monkeypatch.setattr(pause, "_stop_gateways", REAL_STOP_GATEWAYS)
     entries = [{"kind": "systemd", "scope": "user", "unit": UNIT, "pid": 424242},
                {"pid": 424243, "argv": ["fixture"]}]
     monkeypatch.setattr(pause, "_discover_systemd", lambda: entries[:1])
-- 
