From 5853223033b612da6cfd07444db5bb1c8e521a72 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 01:16:01 +0000
Subject: [PATCH] test(loop-accounting): exercise nonzero baselines through
 real fork [daveey]

---
 tests/hermes_cli/test_loop_accounting.py | 47 ++++++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/tests/hermes_cli/test_loop_accounting.py b/tests/hermes_cli/test_loop_accounting.py
index ee12e8db2f..2a219bcd2c 100644
--- a/tests/hermes_cli/test_loop_accounting.py
+++ b/tests/hermes_cli/test_loop_accounting.py
@@ -689,6 +689,53 @@ def test_inherited_passes_subtract_nonzero_child_fork_clocks(monkeypatch, forks)
     assert la.snapshot()["process"]["accounted_cpu_s"] == pytest.approx(2.25)
 
 
+@pytest.mark.platforms("posix")
+def test_real_fork_subtracts_nonzero_clocks_from_inherited_passes():
+    # A subprocess confines the registered at-fork hook and child assertions.
+    result = subprocess.run([sys.executable, "-c", '''
+import os
+from hermes_cli import loop_accounting as la
+
+clock = [50.0, 1000.0]
+la._thread_time = lambda: clock[0]
+la._perf = lambda: clock[1]
+la.reset()
+with la.pass_("outer"):
+    with la.pass_("inner"):
+        # Both clocks are nonzero when os.fork invokes the real registered hook.
+        clock[:] = [2.0, 1100.0]
+        pid = os.fork()
+        if pid == 0:
+            clock[:] = [2.25, 1102.0]
+            with la.pass_("child_inner"):
+                clock[:] = [2.75, 1105.0]
+            la.record("child_record", cpu_s=0.125, wall_s=0.25)
+    if pid == 0:
+        clock[:] = [3.75, 1109.0]
+if pid == 0:
+    try:
+        counters = la.counters()
+        for name, cpu, wall in (("inner", 0.75, 5.0), ("outer", 1.75, 9.0),
+                                ("child_inner", 0.5, 3.0), ("child_record", 0.125, 0.25)):
+            actual = counters[name]
+            assert (actual["runs"], actual["cpu_s"], actual["wall_s"]) == (1, cpu, wall), (name, actual)
+        assert la.snapshot()["process"]["accounted_cpu_s"] == 1.75
+        with la.pass_("after"):
+            clock[:] = [4.25, 1115.0]
+        assert la.counters()["after"]["cpu_s"] == 0.5
+        assert la.counters()["after"]["wall_s"] == 6.0
+        assert la.snapshot()["process"]["accounted_cpu_s"] == 2.25
+    except BaseException:
+        import traceback
+        traceback.print_exc()
+        os._exit(1)
+    os._exit(0)
+_, status = os.waitpid(pid, 0)
+assert os.waitstatus_to_exitcode(status) == 0, status
+'''], capture_output=True, text=True, timeout=20, check=False)
+    assert result.returncode == 0, result.stdout + result.stderr
+
+
 def _fork_inside_nested_passes() -> int:
     with la.pass_("outer"):
         _burn(0.1)  # the parent's thread clock is well past the child's at the fork
