From 6df42bc73772b7b9c80023c8c9f967cc0998ae16 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:57:15 +0000
Subject: [PATCH] [daveey] fix(update-pause): the paused turn's own request row
 never counts as a later turn

later_turns_since counted every user row stamped after paused_at, so a paused
request whose row was written (or stamped) after the pause stamp counted itself
as a turn that ran over it and the continuation lost the previous-turn note.
CI showed it: the wake/cold-resume/recovery suites back-date the marker and got
the stale note. Exclude the marker's prompt from the count.

Task: t_01a1d4920ce3cbf4
---
 tests/tui_gateway/test_update_pause_ledger_owner.py |  9 +++++++++
 tui_gateway/session_auto_continue.py                |  5 +++--
 tui_gateway/update_pause.py                         | 12 ++++++++----
 3 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/tests/tui_gateway/test_update_pause_ledger_owner.py b/tests/tui_gateway/test_update_pause_ledger_owner.py
index 69ec6f428d..ca1cd5a4cd 100644
--- a/tests/tui_gateway/test_update_pause_ledger_owner.py
+++ b/tests/tui_gateway/test_update_pause_ledger_owner.py
@@ -231,6 +231,15 @@ def test_continuation_right_after_the_pause_keeps_the_previous_turn_note(env, mo
     assert env.ran == [up.pause_note(PROMPT)]
 
 
+def test_the_paused_turns_own_request_row_is_never_a_later_turn(env, monkeypatch):
+    """The paused request's row stamped after the pause (a late step flush; the CI fixtures back-date the marker)
+    is the paused turn itself, not a turn that ran over it: the note stays the previous-turn note."""
+    env.ledger["status"] = None
+    _shift_pause(env.home, -3 * up.STALE_NOTE_AFTER_S)  # the transcript rows now postdate the pause stamp
+    server._maybe_schedule_auto_continue("sid", _session(env.home), "chat")
+    assert env.ran == [up.pause_note(PROMPT)]
+
+
 def test_continuation_that_paused_again_is_forwarded_once_and_named_as_a_chain(env, monkeypatch):
     """laptop-1 03:07-03:29 PST: the 02:24 continuation of the 00:55 pause paused again (``pauses: 2``, the marker
     keeping the chain's root prompt, the 00:33 notice). The ledger refused it while the gateway continued its own
diff --git a/tui_gateway/session_auto_continue.py b/tui_gateway/session_auto_continue.py
index c7eb06457f..7a24167301 100644
--- a/tui_gateway/session_auto_continue.py
+++ b/tui_gateway/session_auto_continue.py
@@ -269,7 +269,7 @@ def _maybe_schedule_auto_continue(sid: str, session: dict, session_key: str) ->
         attempt, text = marker["attempts"], pause_note(
             marker["prompt"], marker.get("killed_jobs"), carried=bool(marker.get("carried_turn_paused")),
             paused_at=marker.get("paused_at"), pauses=int(marker.get("pauses") or 0),
-            later_turns=later_turns_since(session, session_key, marker.get("paused_at")))
+            later_turns=later_turns_since(session, session_key, marker.get("paused_at"), marker.get("prompt")))
     elif receipt:
         attempt, text = marker["attempts"], jobs_stopped_note(marker.get("killed_jobs"))
     else:
@@ -400,7 +400,8 @@ def _paused_turn_to_ledger_owner(sid: str, session: dict, session_key: str, mark
     # It runs after the owner's queued turns, so it is never worded as the chat's previous turn.
     text = pause_note(marker["prompt"], marker.get("killed_jobs"), carried=bool(marker.get("carried_turn_paused")),
                       paused_at=marker.get("paused_at"), queued=True, pauses=int(marker.get("pauses") or 0),
-                      later_turns=later_turns_since(session, session_key, marker.get("paused_at")))
+                      later_turns=later_turns_since(session, session_key, marker.get("paused_at"),
+                                                    marker.get("prompt")))
     try:
         receipt = owner_forward.forward_prompt(sid, session, text)
     except owner_forward.OwnerUnconfirmed:
diff --git a/tui_gateway/update_pause.py b/tui_gateway/update_pause.py
index 38fc3825b0..0d2ac62e3d 100644
--- a/tui_gateway/update_pause.py
+++ b/tui_gateway/update_pause.py
@@ -580,10 +580,13 @@ def _age_label(at: float) -> str:
     return f"{age / 3600:.1f} h"
 
 
-def later_turns_since(session: dict, session_key: str, since: float | None) -> int | None:
+def later_turns_since(session: dict, session_key: str, since: float | None,
+                      prompt: str | None = None) -> int | None:
     """[daveey] User-originated rows the stored transcript holds after the pause stamp ``since``: turns that ran
-    over the paused turn (notices carried over it, the owner's queued turns). The paused turn wrote none after its
-    pause. None when it cannot be read. The compression tip is counted too (a rotation moves the chat)."""
+    over the paused turn (notices carried over it, the owner's queued turns). The paused turn's own request row
+    (``prompt``) never counts, even when it was persisted or stamped after the pause (a late step flush): a turn is
+    never later than itself. None when it cannot be read. The compression tip is counted too (a rotation moves the
+    chat)."""
     if not session_key or since is None:
         return 0 if since is None else None
     try:
@@ -600,7 +603,8 @@ def later_turns_since(session: dict, session_key: str, since: float | None) -> i
             with read_ctx() as conn:
                 row = conn.execute(
                     f"SELECT COUNT(*) FROM messages WHERE session_id IN ({marks}) AND role='user' AND timestamp>? "
-                    "AND COALESCE(_compressed_summary, 0)=0", (*ids, float(since))).fetchone()
+                    "AND COALESCE(_compressed_summary, 0)=0 AND content IS NOT ?",
+                    (*ids, float(since), prompt)).fetchone()
         return int(row[0] or 0) if row else 0
     except Exception:
         logger.debug("core-update pause: could not count later turns of %s", session_key, exc_info=True)
