From d105dfdc9d87079899f40c7c6cbbc1e2746f45dd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 06:41:02 +0000
Subject: [PATCH] fix(cron): preserve computed command position around
 assignment data [daveey]

Reproduce six exact-head CI clean-control failures after the rebase. Treat array indices and compound values as data while walking their nested substitutions and retaining commands after assignments. An unterminated backtick cannot produce an executable word; keep complete unknown outputs fail-closed. Add real-Bash marker controls for array and heredoc execution. All 303 cron test files pass (13414 tests, 9 skipped), including both newly inherited regression suites; scripts/check passes.
---
 cron/lifecycle_guard_computed.py              | 35 +++++++++++++++++--
 .../test_lifecycle_guard_computed_commands.py | 10 ++++++
 2 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/cron/lifecycle_guard_computed.py b/cron/lifecycle_guard_computed.py
index 5f74f1adb3c6986961bae56765da0ffae8964ca9..b5282cf211159d53d387fe372bd197e84082220e 100644
--- a/cron/lifecycle_guard_computed.py
+++ b/cron/lifecycle_guard_computed.py
@@ -103,18 +103,42 @@ def _expansion(text, index, quoted, bindings):
         end = _paren_end(text, index)
         values = _printed(text[opener:end - 1]) if text[end - 1:end] == ')' else None
     elif text[index] == '`':
-        end = _backtick_end(text, index)
-        values = _printed(text[index + 1:end - 1]) if text[end - 1:end] == '`' else None
+        end = _backtick_end(text + '\x00', index)
+        if end > len(text):
+            return None  # An unclosed backtick cannot produce an executable word.
+        values = _printed(text[index + 1:end - 1])
     else:
         return None
     return Expansion(index, end, quoted, values, variable)
 
 
 def _opaque_expansions(text, bindings):
+    from cron.lifecycle_guard_lines import _bracket_end
+    # Assignment data is not an executable word. Nested substitutions have
+    # already been walked independently before this structural view is used.
     out, expansions = [], {}
     index, quote = 0, ''
     while index < len(text):
         ch = text[index]
+        if not quote and (not index or text[index - 1] in ' \t\n;&|('):
+            assignment = re.match(r'([A-Za-z_][A-Za-z_0-9]*)(?=\[|\+?=)', text[index:])
+            if assignment:
+                end = index + assignment.end()
+                if text[end:end + 1] == '[':
+                    bracket = _bracket_end(text, end)
+                    if bracket >= 0 and text.startswith(('=', '+='), bracket + 1):
+                        end = bracket + 1
+                if text.startswith(('=(', '+=('), end):
+                    paren = end + (2 if text[end] == '+' else 1)
+                    close = paren + _paren_end('$' + text[paren:], 0) - 1
+                    if text[close - 1:close] == ')':
+                        out.append(assignment[1] + '=')
+                        index = close
+                        continue
+                if end > index + assignment.end():
+                    out.append(assignment[1])
+                    index = end
+                    continue
         if ch == '\\' and quote != "'":
             out.append(text[index:index + 2])
             index += 2
@@ -184,6 +208,13 @@ def scan_computed_commands(command, *, cwd, executed, variable_source, budget, r
         if recurse(body, cwd, True, source):
             return True
     opaque, expansions = _opaque_expansions(command, budget.variable_candidates.values)
+    # Retain an additional executable reading after assignment syntax was
+    # normalized: legacy candidate discovery only peels scalar NAME=value.
+    normalized = opaque
+    for marker, span in expansions.items():
+        normalized = normalized.replace(marker, command[span.start:span.end])
+    if normalized != command and recurse(normalized, cwd, True, source):
+        return True
     for segment in _structural_segments(opaque):
         words = segment[guard._peel_reserved_words(segment):]
         words = guard._split_redirections(words)[0]
diff --git a/tests/cron/test_lifecycle_guard_computed_commands.py b/tests/cron/test_lifecycle_guard_computed_commands.py
index 13a543e26c896cc0b1241b0d7129f2d172aa18c6..260ffdf2fd236c86fd717a40dfbd62be8b7ab429 100644
--- a/tests/cron/test_lifecycle_guard_computed_commands.py
+++ b/tests/cron/test_lifecycle_guard_computed_commands.py
@@ -8,6 +8,11 @@ from cron.lifecycle_guard import scan_gateway_lifecycle
 
 
 RUN = [
+    'a[$(${x:-bash} ./r.sh; echo 0)]=3',
+    'a=( [$(${x:-bash} ./r.sh; echo 0)]=3 )',
+    'a[$(echo 0)]=3 ${x:-bash} ./r.sh',
+    'a=($(echo 0)); ${x:-bash} ./r.sh',
+    'bash <<E\n${x:-bash} ./r.sh\nE',
     'x=$(cat command-name); ${x:-echo} gateway restart',
     'x=$(printf %s hermes); ${x:-echo} gateway restart',
     '$\\\n(echo hermes) gateway restart',
@@ -39,6 +44,11 @@ RUN = [
     '. ./producer.sh; $(echo echo) gateway restart',
 ]
 CLEAN = [
+    'a[$(printf %d 0)]=3',
+    'a=( [$(printf %d 0)]=3 )',
+    'a[$(printf %d 0)]=3 ${x:-bash} ./clean.sh',
+    'a=($(printf %d 0)); ${x:-bash} ./clean.sh',
+    'bash <<E\n${x:-bash} ./clean.sh\nE',
     '$\\\n(echo echo) hi',
     "echo '$\\\n(echo hermes) gateway restart'",
     'echo hi # $\\\n(echo hi)',
