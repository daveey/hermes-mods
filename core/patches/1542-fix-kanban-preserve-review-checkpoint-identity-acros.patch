diff --git a/hermes_cli/kanban_dependency_review.py b/hermes_cli/kanban_dependency_review.py
index 6185a6786dc..b618c628e07 100644
--- a/hermes_cli/kanban_dependency_review.py
+++ b/hermes_cli/kanban_dependency_review.py
@@ -3,7 +3,7 @@
 Neither a promotion nor comment prose is permission to retry an implementation.
 Only an authenticated park can capture the PRs and dependency edges being awaited.
 A completed review then authorizes one continuation of those same PRs: a repair
-when it records ``changes_required`` with ``reviewed_sha``, or a landing
+when it records ``changes_required`` with ``reviewed_sha``/``head``, or a landing
 continuation when it records an exact-head approval. The next claim consumes it.
 A later comment that repeats a captured PR does not re-arm the hold; a new PR,
 a review naming a different PR, or a crash/reclaim does.
@@ -25,7 +25,7 @@ def checkpoint(conn, task_id, expected_run_id):
     if expected_run_id is None:
         return None
     row = conn.execute(
-        "SELECT r.id FROM tasks t JOIN task_runs r ON r.id = t.current_run_id "
+        "SELECT r.* FROM tasks t JOIN task_runs r ON r.id = t.current_run_id "
         "WHERE t.id = ? AND t.status = 'running' AND r.id = ? "
         "AND r.task_id = t.id AND r.profile = t.assignee AND r.ended_at IS NULL",
         (task_id, expected_run_id),
@@ -40,8 +40,13 @@ def checkpoint(conn, task_id, expected_run_id):
         return None
     awaited = [p for p, status in kb.parent_states(conn, task_id)
                if status not in {"done", "archived"}]
-    return {"run_id": expected_run_id, "parents": sorted(parents),
-            "awaited": sorted(awaited), "prs": sorted(urls)}
+    evidence = {"run_id": expected_run_id, "parents": sorted(parents),
+                "awaited": sorted(awaited), "prs": sorted(urls)}
+    # Integer run IDs are database-local; sync remaps the event FK but deliberately
+    # leaves its JSON payload unchanged. Carry the run's stable identity as well.
+    if "uid" in row.keys() and row["uid"]:
+        evidence["run_uid"] = row["uid"]
+    return evidence
 
 
 def apply_block_update(conn, task_id, expected_run_id, kind, new_status, set_sql, params, payload):
@@ -145,8 +150,7 @@ def _reviewed_prs(conn, parent_id, parked_at, owner_run_id, captured: set[str])
     if row is None:
         return set()
     data = kb._json_dict(row["metadata"])
-    sha = data.get("reviewed_sha")
-    if not isinstance(sha, str) or not _SHA.fullmatch(sha) or not _requests_changes(row, data):
+    if not _exact_head(data) or not _requests_changes(row, data):
         return set()
     named = _named_prs(data, captured)
     if named is not None:
@@ -211,12 +215,24 @@ def _awaited_parents(conn, parents, evidence, parked_at):
     return [p for p in parents if p in awaited or not _historical_parent(conn, p, parked_at)]
 
 
+def _checkpoint_matches_run(evidence, run):
+    if not isinstance(evidence, dict):
+        return False
+    if "run_uid" in evidence:
+        uid = evidence["run_uid"]
+        # A present but invalid/mismatched UID must never fall back to an integer
+        # that happens to collide on this gateway.
+        return isinstance(uid, str) and bool(uid) and "uid" in run.keys() and uid == run["uid"]
+    # Legacy/local-only boards have no UID. Do not infer a remapped legacy ID.
+    return type(evidence.get("run_id")) is int and evidence["run_id"] == run["id"]
+
+
 def resumes_review(conn, task_id, pr_urls, *, discharged=()):
     """One continuation only: claiming any new run consumes the park's permission."""
     from hermes_cli import kanban_db as kb
 
     row = conn.execute(
-        "SELECT e.payload, e.created_at, r.id, r.profile, r.outcome, t.assignee "
+        "SELECT e.payload, e.created_at, r.*, t.assignee "
         "FROM task_events e JOIN task_runs r ON r.id = e.run_id "
         "JOIN tasks t ON t.id = e.task_id "
         "WHERE e.task_id = ? AND e.kind = 'dependency_wait' AND r.task_id = t.id "
@@ -227,7 +243,7 @@ def resumes_review(conn, task_id, pr_urls, *, discharged=()):
         return False
     payload = kb._json_dict(row["payload"])
     evidence = payload.get("review_checkpoint")
-    if not isinstance(evidence, dict) or evidence.get("run_id") != row["id"]:
+    if not isinstance(evidence, dict) or not _checkpoint_matches_run(evidence, row):
         return False
     parents = kb.parent_ids(conn, task_id)
     if (not parents or sorted(parents) != evidence.get("parents")
diff --git a/tests/hermes_cli/test_kanban_dependency_review_sync.py b/tests/hermes_cli/test_kanban_dependency_review_sync.py
new file mode 100644
index 00000000000..c710b337a6d
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_dependency_review_sync.py
@@ -0,0 +1,120 @@
+"""Review continuation survives database-local run ID remapping, not identity mismatches."""
+import json
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as dispatch
+from hermes_cli import kanban_db_dispatch_pr_state as prs
+from hermes_cli import kanban_db_sync as sync
+from tests.hermes_cli import kanban_sync_support as support
+from tests.hermes_cli.test_kanban_dependency_review import HEAD, PR, finish_reviews, parked
+
+
+@pytest.fixture
+def boards(tmp_path, monkeypatch):
+    home = support.kanban_home(tmp_path, monkeypatch)
+    support.write_sync_config(home, True)
+    monkeypatch.setattr(prs, "pr_state", lambda _: "OPEN")
+    with kbc.connect(home / "source.db") as source, kbc.connect(home / "target.db") as target:
+        # Force a different local integer namespace without changing any transported row.
+        for _ in range(3):
+            task = kb.create_task(target, title="local history", assignee="dev")
+            kb.claim_task(target, task)
+        yield source, target
+
+
+def transport(source, target):
+    changes = [sync.RemoteChange(i, op["table_name"], op["row_uid"], op["op"],
+                                op["fields"], i, op["hlc"], "source")
+               for i, op in enumerate(sync.outbox(source), 1)]
+    sync.apply_remote_changes(target, changes, new_cursor=len(changes), observers=False)
+    # Repeat the PR as an unattributed publication on the destination. Comment
+    # provenance has its own local IDs; it is not the checkpoint under test.
+    for row in source.execute("SELECT DISTINCT task_id FROM task_events WHERE kind = 'dependency_wait'"):
+        kb.add_comment(target, row["task_id"], "dev", PR)
+
+
+def checkpoint_row(conn, task):
+    return conn.execute("SELECT * FROM task_events WHERE task_id = ? AND kind = 'dependency_wait'",
+                        (task,)).fetchone()
+
+
+@pytest.mark.parametrize("key", ["reviewed_sha", "head"])
+@pytest.mark.parametrize("verdict", ["changes_required", "approved"])
+def test_sync_remap_preserves_one_review_continuation(boards, key, verdict):
+    source, target = boards
+    task, reviews = parked(source)
+    finish_reviews(source, reviews, metadata={"verdict": verdict, key: HEAD, "pr": PR})
+    transport(source, target)
+    src, dst = checkpoint_row(source, task), checkpoint_row(target, task)
+    assert src["run_id"] != dst["run_id"]
+    assert src["payload"] == dst["payload"]
+    assert dispatch.check_respawn_guard(target, task) is None
+    assert kb.claim_task(target, task) is not None
+    assert dispatch.check_respawn_guard(target, task) == "active_pr"
+    assert kb.reclaim_task(target, task, reason="crash", signal_fn=lambda *_: None)
+    assert dispatch.check_respawn_guard(target, task) == "active_pr"
+
+
+@pytest.mark.parametrize("key", ["reviewed_sha", "head"])
+def test_local_change_request_accepts_either_exact_head_key(boards, key):
+    source, _ = boards
+    task, reviews = parked(source)
+    finish_reviews(source, reviews, metadata={"verdict": "changes_required", key: HEAD, "pr": PR})
+    assert dispatch.check_respawn_guard(source, task) is None
+
+
+@pytest.mark.parametrize("bad_uid", [None, "", 42, "unrelated-run"])
+def test_uid_mismatch_never_falls_back_to_matching_integer(boards, bad_uid):
+    source, _ = boards
+    task, reviews = parked(source)
+    finish_reviews(source, reviews)
+    row = checkpoint_row(source, task)
+    payload = json.loads(row["payload"])
+    payload["review_checkpoint"]["run_uid"] = bad_uid
+    with kb.write_txn(source):
+        source.execute("UPDATE task_events SET payload = ? WHERE id = ?", (json.dumps(payload), row["id"]))
+    assert dispatch.check_respawn_guard(source, task) == "active_pr"
+
+
+@pytest.mark.parametrize("mode", ["other_pr", "short_head", "other_assignee", "unowned"])
+def test_synced_invalid_review_or_owner_stays_held(boards, mode):
+    source, target = boards
+    task, reviews = parked(source, authenticated=mode != "unowned")
+    finish_reviews(source, reviews, metadata={"verdict": "changes_required",
+                   "head": HEAD[:8] if mode == "short_head" else HEAD,
+                   "pr": PR + "1" if mode == "other_pr" else PR})
+    if mode == "other_assignee":
+        kb.assign_task(source, task, "other")
+    transport(source, target)
+    assert dispatch.check_respawn_guard(target, task) == "active_pr"
+
+
+@pytest.mark.parametrize("remapped", [False, True])
+def test_legacy_checkpoint_only_accepts_original_local_id(boards, remapped):
+    source, target = boards
+    task, reviews = parked(source)
+    finish_reviews(source, reviews)
+    row = checkpoint_row(source, task)
+    payload = json.loads(row["payload"])
+    payload["review_checkpoint"].pop("run_uid", None)
+    with kb.write_txn(source):
+        source.execute("UPDATE task_events SET payload = ? WHERE id = ?", (json.dumps(payload), row["id"]))
+    if remapped:
+        transport(source, target)
+    assert dispatch.check_respawn_guard(target if remapped else source, task) == ("active_pr" if remapped else None)
+
+
+def test_real_other_run_uid_cannot_authorize_owner_checkpoint(boards):
+    source, _ = boards
+    task, reviews = parked(source)
+    finish_reviews(source, reviews)
+    row = checkpoint_row(source, task)
+    payload = json.loads(row["payload"])
+    other_uid = source.execute("SELECT uid FROM task_runs WHERE task_id = ?", (reviews[0],)).fetchone()[0]
+    payload["review_checkpoint"]["run_uid"] = other_uid
+    with kb.write_txn(source):
+        source.execute("UPDATE task_events SET payload = ? WHERE id = ?", (json.dumps(payload), row["id"]))
+    assert dispatch.check_respawn_guard(source, task) == "active_pr"
