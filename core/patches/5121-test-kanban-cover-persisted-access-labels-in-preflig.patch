From ffca2bf258ec5f8ba76e3c7cd6980d0837bcfe8e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 04:23:23 +0000
Subject: [PATCH] test(kanban): cover persisted access labels in preflight
 [daveey]

Address PR #3732 independent review: exercise real create_task, persisted runs_on, real preflight and empty capability registry for hub:read, hub:write, ssh:mini and ssh:mbp. Each missing-label control retains no_capability_holder. Disabling the SQL label read causes four failures; restored code passes 336 tests (one skipped) in declared-access, routing, relay and placement suites. Consolidate ACCESS_LABELS lookup to address the cosmetic nit.
---
 hermes_cli/kanban_capability_routing.py       |  8 ++---
 .../hermes_cli/test_kanban_declared_access.py | 31 +++++++++++++++++++
 2 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_capability_routing.py b/hermes_cli/kanban_capability_routing.py
index a83e5d1458..e4efd5ddef 100644
--- a/hermes_cli/kanban_capability_routing.py
+++ b/hermes_cli/kanban_capability_routing.py
@@ -670,16 +670,16 @@ def preflight(conn, task_id: str, *, board: Optional[str] = None, **lookup) -> O
         if task is None:
             return None
         needs = needs_from_requires(task.requires)
+        access_labels = _access_labels()
         if getattr(task, "placement_policy", None) == "worker-first-v1":
             # Enrollment checked the pool; pickup/execution recheck the actual
             # worker. Do not create an origin-side owner for its remote access.
-            from hermes_cli.kanban_placement_coordination import ACCESS_LABELS
-            needs = [need for need in needs if need not in ACCESS_LABELS]
-        elif any(need in _access_labels() for need in needs):
+            needs = [need for need in needs if need not in access_labels]
+        elif any(need in access_labels for need in needs):
             # The Board enforces a carried access label at claim time and no gateway advertises these
             # needs in the registry, so a registry check would warn no_capability_holder falsely.
             carried = _task_runs_on(conn, task)
-            needs = [need for need in needs if _access_labels().get(need) not in carried]
+            needs = [need for need in needs if access_labels.get(need) not in carried]
         if not needs:
             return None
         if task.status != "ready":
diff --git a/tests/hermes_cli/test_kanban_declared_access.py b/tests/hermes_cli/test_kanban_declared_access.py
index d8a8e8ae1e..20f62e43c8 100644
--- a/tests/hermes_cli/test_kanban_declared_access.py
+++ b/tests/hermes_cli/test_kanban_declared_access.py
@@ -137,6 +137,37 @@ def test_preflight_drops_access_needs_the_runs_on_label_carries(monkeypatch, run
     assert (placed is None) == (not expected)
 
 
+@pytest.mark.parametrize("requirement,label", [
+    ("hub:read", "capability:hub-read"),
+    ("hub:write", "capability:hub-write"),
+    ("ssh:mini", "capability:ssh-mini"),
+    ("ssh:mbp", "capability:ssh-mbp"),
+])
+@pytest.mark.parametrize("carried", [False, True])
+def test_preflight_reads_persisted_access_labels(conn, monkeypatch, requirement, label, carried):
+    from hermes_cli import kanban_capability_routing as routing
+
+    tid = kb.create_task(conn, title="Check declared access", assignee="default",
+                         requires=["terminal", requirement])
+    # Exercise the production Task and SQL read, not a mock carrying runs_on.
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET placement_policy=NULL, runs_on=? WHERE id=?",
+                     (json.dumps(["pool:worker", label] if carried else ["pool:worker"]), tid))
+    task = kb.get_task(conn, tid)
+    assert task is not None
+    assert not hasattr(task, "runs_on")
+    assert task.placement_policy is None
+    monkeypatch.setattr(routing, "has_replica", lambda: True)
+    result = routing.preflight(conn, tid, self_gw="hub", local={}, remote={})
+    if carried:
+        assert result is None
+    else:
+        assert result is not None
+        assert result["code"] == "no_capability_holder", result
+    unchanged = kb.get_task(conn, tid)
+    assert unchanged is not None and unchanged.status == "ready"
+
+
 @pytest.mark.parametrize("requirement,label,body", [
     ("hub:read", "capability:hub-read", "read the log on the hub"),
     ("ssh:mbp", "capability:ssh-mbp", "ssh to the MacBook for a read"),
-- 
2.43.0

