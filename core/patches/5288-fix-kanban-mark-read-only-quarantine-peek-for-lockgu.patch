From fd08fbdaaa36057b4b3979a11d27e97fc9fbafb1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 16:23:47 +0000
Subject: [PATCH] fix(kanban): mark read-only quarantine peek for lockguard
 scan

---
 hermes_cli/kanban_sync_quarantine.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_sync_quarantine.py b/hermes_cli/kanban_sync_quarantine.py
index f5900791f3..b72fcd2c26 100644
--- a/hermes_cli/kanban_sync_quarantine.py
+++ b/hermes_cli/kanban_sync_quarantine.py
@@ -35,7 +35,8 @@ def _exists(conn) -> bool:
 def file_holds(path: Path) -> bool:
     """Cheap peek: does this database file hold any quarantine row? Opens no pooled shadow connection."""
     try:
-        peek = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=5)
+        # Short-lived read-only peek, closed below; never a pooled handle.
+        peek = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=5)  # noqa: kanban-lockguard
     except sqlite3.Error:
         return False
     try:
