--- /dev/null
+++ b/hermes_cli/kanban_sync_reconcile_links.py
@@ -0,0 +1,11 @@
+"""Reconciliation eligibility for chat links retained after a card leaves this gateway."""
+from __future__ import annotations
+
+import sqlite3
+
+
+def existing_task_chat_links(conn: sqlite3.Connection, service_tasks: set[str]) -> set[str]:
+    """Keep local-card links and remote-card links, not links with no surviving target."""
+    local_tasks = {row[0] for row in conn.execute("SELECT id FROM tasks")}
+    known = local_tasks | service_tasks
+    return {uid for uid, task in conn.execute("SELECT uid, task_id FROM task_chat_links") if task in known}
diff --git a/tests/hermes_cli/test_kanban_board_columns.py b/tests/hermes_cli/test_kanban_board_columns.py
new file mode 100644
index 00000000000..724aabb39e2
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_board_columns.py
@@ -0,0 +1,23 @@
+"""Core's wire schema must be accepted by the deployed Board's declared row contract."""
+import json
+from pathlib import Path
+
+from hermes_cli import kanban_db_sync as sync
+
+
+def test_wire_columns_are_writable_on_board():
+    snapshot = json.loads(
+        (Path(sync.__file__).with_name("kanban_board_row_fields.json")).read_text(encoding="utf-8")
+    )
+    missing = sorted(
+        f"{table}.{wire}"
+        for table, columns in sync.SYNCED_COLUMNS.items()
+        for column in columns
+        if (wire := sync.REF_COLUMNS.get((table, column), column))
+        not in snapshot["row_fields"].get(table, [])
+    )
+    assert not missing, (
+        f"Board {snapshot['commit']} does not accept {', '.join(missing)}: "
+        "add it to hermes-hub worker/src/rows.ts ROW_FIELDS and board_schema.ts "
+        "(ADDED_*_COLUMNS), deploy the Board, then update this snapshot"
+    )
diff --git a/tests/hermes_cli/test_kanban_sync_orphan_chat_links.py b/tests/hermes_cli/test_kanban_sync_orphan_chat_links.py
