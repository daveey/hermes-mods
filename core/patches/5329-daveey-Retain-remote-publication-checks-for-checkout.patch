From dfff4ad8f6571de22006c35b859501e80d3228e7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 22:55:00 +0000
Subject: [PATCH] [daveey] Retain remote publication checks for checkout
 deletions

A local branch can be an upstream without publishing HEAD. Keep the existing unpushed-commit and remote publication checks after accepting checkout-only dirt. Independent review reproduced the bypass for both deletion shapes.

Proof: both real-Git local-upstream regressions fail on e56f5087 and pass here; all 23 placement consumer files pass (508 tests); full scripts/check passes.
---
 hermes_cli/kanban_move_pool.py                |  6 +++---
 .../test_review_checkout_local_upstream.py    | 19 +++++++++++++++++++
 2 files changed, 22 insertions(+), 3 deletions(-)
 create mode 100644 tests/hermes_cli/test_review_checkout_local_upstream.py

diff --git a/hermes_cli/kanban_move_pool.py b/hermes_cli/kanban_move_pool.py
index 96d2cea6e4..f5237668b4 100644
--- a/hermes_cli/kanban_move_pool.py
+++ b/hermes_cli/kanban_move_pool.py
@@ -306,9 +306,9 @@ def tree_state(trees: Iterable[str], *, budget: float = STATE_BUDGET_S,
         try:
             if _worktree_is_dirty(tree, tree, timeout=10, budget=timeouts):
                 from hermes_cli.kanban_checkout_deletions import published_checkout_deletions
-                if published_checkout_deletions(tree, timeouts):
-                    continue
-                return f"{_DIRTY}{tree}"
+                if not published_checkout_deletions(tree, timeouts):
+                    return f"{_DIRTY}{tree}"
+                # A local-branch upstream is not remote publication; retain the unpushed check below.
             if _commit_less(tree, timeouts):
                 continue
             if (_worktree_has_unpushed_commits(tree, timeout=10, budget=timeouts)
diff --git a/tests/hermes_cli/test_review_checkout_local_upstream.py b/tests/hermes_cli/test_review_checkout_local_upstream.py
new file mode 100644
index 0000000000..4e60d423e7
--- /dev/null
+++ b/tests/hermes_cli/test_review_checkout_local_upstream.py
@@ -0,0 +1,19 @@
+"""Checkout-deletion exceptions cannot certify local-branch publication."""
+from __future__ import annotations
+
+import pytest
+
+from hermes_cli import kanban_move_pool as kmp
+from tests.hermes_cli import test_kanban_checkout_deletions as checkout
+from tests.hermes_cli import test_kanban_pool_queue as pq
+
+
+@pytest.mark.parametrize("empty_index", [False, True])
+def test_local_upstream_does_not_publish_private_commits(tmp_path, empty_index):
+    _ws, repo = checkout._checkout(tmp_path)
+    pq._commit(repo, "private.txt")
+    pq._git(repo, "branch", "local-upstream")
+    pq._git(repo, "branch", "--set-upstream-to=local-upstream")
+    if empty_index:
+        pq._git(repo, "rm", "-q", "-f", "a.txt", "b.txt", "hidden.txt", "private.txt")
+    assert kmp.tree_state([str(repo)], refresh=False) is not None
-- 
