From 2691544878d9f5d0aed5a5109cc8498794d07e3e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 08:21:22 -0700
Subject: [PATCH] ci: tests.yml ci-bwrap comment names on-demand box A, not
 spot

---
 .github/workflows/tests.yml | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/tests.yml b/.github/workflows/tests.yml
index 71526dd5f6..2eb10d0bd2 100644
--- a/.github/workflows/tests.yml
+++ b/.github/workflows/tests.yml
@@ -319,8 +319,9 @@ jobs:
     # syscalls, unmasked /proc). A plain hermes-hub slot fails the bwrap probe below:
     # Docker's default seccomp/AppArmor and masked /proc block bwrap, and the
     # container cannot set the host's apparmor_restrict_unprivileged_userns.
-    # Do not also require hermes-hub. The only ci-bwrap slots are on spot, and
-    # hermes-hub on those boxes is what put long jobs on hosts EC2 ACPI-stops.
+    # ci-bwrap slots live only on the on-demand box A (ec2-gwgen-1..3); never put the
+    # label on a spot box: EC2 ACPI-stops spot hosts and kills in-flight shards
+    # (pinned by test_long_job_labels_stay_off_spot_boxes in the hermes-sync repo).
     # Runbook: hosts/hermes-ci-capacity/BWRAP.md in the hermes-sync repo.
     runs-on: [self-hosted, ci-bwrap]
     timeout-minutes: 60
-- 
2.55.0

