From 3adb98db804f5ee75f2fdd021be1b52d6c7c5eef Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:31:53 +0000
Subject: [PATCH] test(delegate): profile-route child doubles are not
 class-routed [daveey]

The fork keeps a class-routed child's billing-fenced pool (child.model_routing set) instead of
the resolved one; upstream's MagicMock child read model_routing as a truthy auto-attribute, so
the named-custom-profile pool lease never landed. The double now says model_routing=None.
---
 tests/tools/test_delegation_profile_route.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/tests/tools/test_delegation_profile_route.py b/tests/tools/test_delegation_profile_route.py
index 85cd9a33a2e..7a4e305166f 100644
--- a/tests/tools/test_delegation_profile_route.py
+++ b/tests/tools/test_delegation_profile_route.py
@@ -147,7 +147,10 @@ def _build(route, parent):
 
     def construct(**kwargs):
         seen.update(kwargs)
-        return MagicMock(session_id="child-1")
+        # Fork: a class-routed child (``model_routing`` set) keeps its billing-fenced native pool and is never
+        # given the resolved pool (tools.delegate_tool, [daveey]); a bare MagicMock's auto attribute would
+        # read as class-routed. These profile children are not class-routed.
+        return MagicMock(session_id="child-1", model_routing=None)
 
     with patch("run_agent.AIAgent", side_effect=construct):
         child = _build_child_agent(task_index=0, goal="work as coder", context=None, toolsets=None,
