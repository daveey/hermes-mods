+        cli.renew(board, tid, episode=episode, comment_id=comment, reason='x', writer=AGENT,
+                  env={'HERMES_SESSION_ID': CHAT}, ancestry=[{'LC_HERMES_AGENT': '20261101_000000_abcdef'}])
+    assert caught.value.code == 'identity_unavailable'
