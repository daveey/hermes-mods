diff --git a/tests/hermes_cli/test_kanban_scope_renewal.py b/tests/hermes_cli/test_kanban_scope_renewal.py
index e6fb762b57..efd08d2766 100644
--- a/tests/hermes_cli/test_kanban_scope_renewal.py
+++ b/tests/hermes_cli/test_kanban_scope_renewal.py
@@ -536,3 +536,282 @@ def test_b_renewal_listing_a_confirmed_safety_receipt_never_hides_it(board, monk
     stop = decision.pending_episode(board, tid)
     assert stop is not None and renewal.key(stop) == episode
     assert renewal.mandate(board, tid) is None
+
