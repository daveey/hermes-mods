From 86c6e20743aa45fea68d6a8d68e995c8996d1866 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 22:08:34 -0800
Subject: [PATCH 6076] TUI RPC method lanes, projects tree caching and GC budget

Public mirror of source commit 86c6e20743aa45fea68d6a8d68e995c8996d1866.

---
diff --git a/gateway/gc_budget.py b/gateway/gc_budget.py
index bdd8ed108f9..d9d2bc01810 100644
--- a/gateway/gc_budget.py
+++ b/gateway/gc_budget.py
@@ -58,8 +58,7 @@
     row[0] += 1
     row[1] += cpu
     row[2] += wall
-    if wall > row[3]:
-        row[3] = wall
+    row[3] = max(row[3], wall)
     row[4] += info.get("collected", 0)
 
 
diff --git a/hermes_cli/loop_accounting.py b/hermes_cli/loop_accounting.py
index 7332954a245..47bc35be888 100644
--- a/hermes_cli/loop_accounting.py
+++ b/hermes_cli/loop_accounting.py
@@ -632,9 +632,9 @@
     """Collection counts and stop-the-world time (``gateway.gc_budget``), None when unavailable."""
     try:
         from gateway.gc_budget import snapshot as gc_snapshot
-        return gc_snapshot()
-    except Exception:
+    except ImportError:  # a trimmed install without the gateway package
         return None
+    return gc_snapshot()
 
 
 def _residual(threads: list[dict[str, Any]], process_cpu: float, accounted_total: float,
diff --git a/tests/tui_gateway/test_git_probe_warm_settled.py b/tests/tui_gateway/test_git_probe_warm_settled.py
index 9509da6642f..ba398ed35c8 100644
--- a/tests/tui_gateway/test_git_probe_warm_settled.py
+++ b/tests/tui_gateway/test_git_probe_warm_settled.py
@@ -53,7 +53,7 @@
 
 
 def test_only_the_new_cwd_is_probed(probes, tmp_path):
-    calls, repos, pools = probes
+    calls, _repos, pools = probes
     old, new = tmp_path / "old", tmp_path / "new"
     old.mkdir()
     new.mkdir()
@@ -66,7 +66,7 @@
 
 
 def test_negative_is_reprobed_when_the_dir_changes_or_the_ttl_ends(probes, tmp_path, monkeypatch):
-    calls, repos, pools = probes
+    calls, repos, _pools = probes
     a, b = tmp_path / "a", tmp_path / "b"
     a.mkdir()
     b.mkdir()
@@ -86,7 +86,7 @@
 
 
 def test_repo_with_unresolved_common_root_is_still_warmed(probes, tmp_path):
-    calls, repos, pools = probes
+    calls, repos, _pools = probes
     repo = tmp_path / "repo"
     repo.mkdir()
     repos[str(repo)] = str(repo)
diff --git a/tui_gateway/methods_projects.py b/tui_gateway/methods_projects.py
index dbe9fe77c37..6d846894a4f 100644
--- a/tui_gateway/methods_projects.py
+++ b/tui_gateway/methods_projects.py
@@ -182,7 +182,6 @@
         profiles_stamp = os.stat(profiles).st_mtime_ns  # moves when a profile is added, removed or relinked
     except OSError:
         profiles_stamp = None
-    # no-tmp: ok — classify OS temp roots, not scratch-file creation.
     key = (str(get_hermes_home()), str(default_home), os.path.expanduser("~"), tempfile.gettempdir(),
            os.getenv("TMPDIR", ""), profiles_stamp)
     memo = _non_workspace_memo
@@ -191,7 +190,9 @@
         return memo[2], memo[3]
     # Resolve sibling profile homes too: a profile can be symlinked outside the base home.
     profile_homes = tuple(str(p) for p in profiles.glob("*"))
-    roots = (key[0], key[1], *profile_homes, key[3], "/tmp", "/private/tmp", "/var/folders", key[4])
+    roots = (key[0], key[1], *profile_homes, key[3],
+             # no-tmp: ok — classify OS temp roots, not scratch-file creation.
+             "/tmp", "/private/tmp", "/var/folders", key[4])
     dirs = frozenset(_non_workspace_dirs())
     prefixes = tuple(sorted({_canonical_workspace_path(p) for p in roots if p}))
     _non_workspace_memo = (key, now + _NON_WORKSPACE_TTL_S, dirs, prefixes)
