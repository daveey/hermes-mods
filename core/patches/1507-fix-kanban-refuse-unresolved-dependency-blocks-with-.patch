diff --git a/hermes_cli/kanban_dependency_validation.py b/hermes_cli/kanban_dependency_validation.py
new file mode 100644
index 00000000000..30fec3ddb58
--- /dev/null
+++ b/hermes_cli/kanban_dependency_validation.py
@@ -0,0 +1,41 @@
+"""Refuse unresolved dependency edges before ending a worker's run."""
+import sqlite3
+
+
+def would_cycle(conn: sqlite3.Connection, parent_id: str, child_id: str) -> bool:
+    """True iff ``parent_id`` is already a descendant of ``child_id``."""
+    seen = set()
+    stack = [child_id]
+    while stack:
+        node = stack.pop()
+        if node == parent_id:
+            return True
+        if node in seen:
+            continue
+        seen.add(node)
+        rows = conn.execute(
+            "SELECT child_id FROM task_links WHERE parent_id = ?", (node,)
+        ).fetchall()
+        stack.extend(r["child_id"] for r in rows)
+    return False
+
+
+def missing_dependency_error(ids):
+    return ValueError(
+        f"unknown task(s): {', '.join(ids)}; not on this board. "
+        "For a parent on another gateway, unlink any dangling edge, then use "
+        "kind='time', awaiting={kind:'card', ref:'<parent-id>', gateway:'<owner-gateway>'}. "
+        "The card wait supplies an owner-aware wake probe automatically "
+        "(kanban_wait.py task <id> over ssh); do not create a local dependency edge."
+    )
+
+
+def validate_dependency_block(conn, task_id, kind):
+    if kind != "dependency":
+        return
+    from hermes_cli.kanban_db import parent_states
+
+    # Synced-board foreign parents are valid when the replica resolves their state.
+    missing = [parent for parent, state in parent_states(conn, task_id) if state is None]
+    if missing:
+        raise missing_dependency_error(missing)
diff --git a/tests/hermes_cli/test_kanban_missing_parent_refusal.py b/tests/hermes_cli/test_kanban_missing_parent_refusal.py
new file mode 100644
index 00000000000..14deb3c448f
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_missing_parent_refusal.py
@@ -0,0 +1,72 @@
+"""Unresolved dependencies must refuse atomically with a remote-wait remedy."""
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from tests.hermes_cli.test_kanban_cross_gateway_parents import local
+
+__all__ = ["local"]
+
+
+def test_link_missing_parent_explains_cross_gateway_wait(local):
+    child = kb.create_task(local, title="child", assignee="worker")
+    before = kb.get_task(local, child)
+    with pytest.raises(ValueError, match="awaiting=.*gateway"):
+        kb.link_tasks(local, "t_foreign", child)
+    assert kb.get_task(local, child) == before
+    assert kb.parent_ids(local, child) == []
+
+
+@pytest.mark.parametrize("state", ["running", "blocked"])
+def test_dependency_block_refuses_dangling_edge_without_ending_run(local, state):
+    child = kb.create_task(local, title="child", assignee="worker")
+    kb.claim_task(local, child)
+    with kbc.write_txn(local):
+        local.execute("INSERT INTO task_links (parent_id, child_id) VALUES (?, ?)",
+                      ("t_foreign", child))
+        if state == "blocked":
+            local.execute("UPDATE tasks SET status='blocked', current_run_id=NULL WHERE id=?", (child,))
+    before = kb.get_task(local, child)
+    runs = [tuple(r) for r in local.execute("SELECT * FROM task_runs")]
+    events = [tuple(r) for r in local.execute("SELECT * FROM task_events")]
+    with pytest.raises(ValueError, match="awaiting=.*gateway"):
+        kb.block_task(local, child, kind="dependency", reason="Wait for foreign owner",
+                      comment=("worker", "Must roll back on refusal"))
+    assert kb.get_task(local, child) == before
+    assert [tuple(r) for r in local.execute("SELECT * FROM task_runs")] == runs
+    assert [tuple(r) for r in local.execute("SELECT * FROM task_events")] == events
+    assert not local.execute("SELECT 1 FROM task_comments WHERE task_id=?", (child,)).fetchone()
+
+
+def test_local_dependency_still_blocks_and_releases(local):
+    parent = kb.create_task(local, title="parent", assignee="worker")
+    child = kb.create_task(local, title="child", assignee="worker")
+    kb.claim_task(local, child)
+    run = kb.get_task(local, child).current_run_id
+    kb.link_tasks(local, parent, child, expected_child_run_id=run)
+    assert kb.block_task(local, child, kind="dependency", expected_run_id=run)
+    assert kb.get_task(local, child).status == "todo"
+    kb.claim_task(local, parent)
+    assert kb.complete_task(local, parent, result="finished")
+    kb.recompute_ready(local)
+    assert kb.get_task(local, child).status == "ready"
+
+
+def test_synced_parent_with_known_state_can_still_gate_dependency_block(local):
+    from hermes_cli import kanban_db_sync as sync
+
+    child = kb.create_task(local, title="child", assignee="worker")
+    kb.claim_task(local, child)
+    local.executescript(sync.SYNC_SCHEMA_SQL)
+    with kbc.write_txn(local):
+        local.execute("INSERT INTO task_links (parent_id, child_id) VALUES (?, ?)",
+                      ("t_remote", child))
+        local.execute("INSERT INTO kanban_sync_remote_parents (parent_id, status, refreshed_at) "
+                      "VALUES ('t_remote', 'running', 1)")
+    assert kb.get_task(local, "t_remote") is None
+    assert kb.block_task(local, child, kind="dependency")
+    assert kb.get_task(local, child).status == "todo"
+    with kbc.write_txn(local):
+        local.execute("UPDATE kanban_sync_remote_parents SET status='done'")
+    kb.recompute_ready(local)
+    assert kb.get_task(local, child).status == "ready"
diff --git a/tests/tools/test_kanban_missing_parent_refusal.py b/tests/tools/test_kanban_missing_parent_refusal.py
new file mode 100644
index 00000000000..26e673d5080
--- /dev/null
+++ b/tests/tools/test_kanban_missing_parent_refusal.py
@@ -0,0 +1,32 @@
+"""Both tool entry paths retain the worker claim when a parent cannot resolve."""
+import json
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from tests.tools.test_kanban_tools import worker_env
+from tools import kanban_tools as kt
+from tools.registry import registry
+
+__all__ = ["kt", "worker_env"]
+
+
+@pytest.mark.parametrize("entry", ["kanban_link", "kanban_block"])
+def test_missing_parent_tool_refusal(worker_env, entry):
+    with kbc.connect() as conn:
+        if entry == "kanban_block":
+            with kbc.write_txn(conn):
+                conn.execute("INSERT INTO task_links (parent_id, child_id) VALUES (?, ?)",
+                             ("t_foreign", worker_env))
+        before = kb.get_task(conn, worker_env)
+    args = ({"parent_id": "t_foreign", "child_id": worker_env} if entry == "kanban_link"
+            else {"task_id": worker_env, "kind": "dependency", "reason": "Wait for remote owner"})
+    tool = registry.get_entry(entry)
+    assert tool is not None
+    result = json.loads(tool.handler(args))
+    assert result.get("error"), result
+    assert "awaiting=" in result["error"] and "gateway" in result["error"]
+    with kbc.connect() as conn:
+        assert kb.get_task(conn, worker_env) == before
+        assert kb.parent_ids(conn, worker_env) == (["t_foreign"] if entry == "kanban_block" else [])
