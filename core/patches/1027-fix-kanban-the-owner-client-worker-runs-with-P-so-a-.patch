From 656f56b49009a07d32c32dbf84327cb3945fa091 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:16:33 +0000
Subject: [PATCH] fix(kanban): the owner-client worker runs with -P so a
 worktree cwd never shadows the install [daveey]

The merge took upstream's _worker_argv ([python, -m, hermes_cli.kanban_worker_client]) and
dropped the fork's -P (hermes_module_argv). A hermes-agent worktree card runs its worker with
cwd = that worktree, so the worker imported the worktree's hermes_cli. Red before:
test_worker_argv_ignores_cwd_checkout 'DECOY hermes_cli imported from the cwd'; green after.
Upstream exact-argv assertions gain -P.
---
 hermes_cli/kanban_db_dispatch.py                    |  9 +++++++--
 tests/hermes_cli/test_kanban_db.py                  |  2 +-
 .../test_kanban_gateway_restart_handoff.py          |  6 +++---
 .../test_worker_argv_ignores_cwd_checkout.py        | 13 ++++++++-----
 tests/plugins/test_kanban_model_override.py         |  2 +-
 5 files changed, 20 insertions(+), 12 deletions(-)

diff --git a/hermes_cli/kanban_db_dispatch.py b/hermes_cli/kanban_db_dispatch.py
index 23a5db7f5c7..408fcb7285f 100644
--- a/hermes_cli/kanban_db_dispatch.py
+++ b/hermes_cli/kanban_db_dispatch.py
@@ -3110,9 +3110,14 @@ def _retag_legacy_worker_sessions(workspaces_root_path: str) -> None:
 
 
 def _worker_argv(task: Task, profile_arg: str, hermes_home: Optional[str]) -> list[str]:
-    """The profile owner executes; this subprocess only waits for its receipt."""
+    """The profile owner executes; this subprocess only waits for its receipt.
+
+    [daveey] ``-P``: the worker runs with cwd = the task workspace, which for a hermes-agent worktree
+    card is another Hermes checkout; plain ``-m`` put that cwd first on ``sys.path`` and the worker
+    imported the worktree's ``hermes_cli`` (see ``hermes_module_argv``)."""
     import sys
-    return [sys.executable, "-m", "hermes_cli.kanban_worker_client"]
+    from cron.scheduler_worker_env import hermes_module_argv
+    return hermes_module_argv(sys.executable, "hermes_cli.kanban_worker_client")
 
 
 def _open_worker_log(task: Task, board: Optional[str]):
diff --git a/tests/hermes_cli/test_kanban_db.py b/tests/hermes_cli/test_kanban_db.py
index e95923625ae..001e021ceb6 100644
--- a/tests/hermes_cli/test_kanban_db.py
+++ b/tests/hermes_cli/test_kanban_db.py
@@ -1674,7 +1674,7 @@ def test_default_spawn_pins_repo_root_on_module_worker_pythonpath(tmp_path, monk
     for resolved in ([sys.executable, "-m", "hermes_cli.main"], ["/opt/hermes/bin/hermes"]):
         monkeypatch.setattr(kbd, "_resolve_hermes_argv", lambda resolved=resolved: resolved)
         kbd._default_spawn(task, str(tmp_path / "ws"))
-        assert captured["cmd"][-3:] == [sys.executable, "-m", "hermes_cli.kanban_worker_client"]
+        assert captured["cmd"][-4:] == [sys.executable, "-P", "-m", "hermes_cli.kanban_worker_client"]  # Fork: -P, the workspace cwd never shadows the install
         assert captured["env"]["PYTHONPATH"].split(os.pathsep)[0] == root
 
 
diff --git a/tests/hermes_cli/test_kanban_gateway_restart_handoff.py b/tests/hermes_cli/test_kanban_gateway_restart_handoff.py
index 1fbd7d4fed9..dd4ee7683a2 100644
--- a/tests/hermes_cli/test_kanban_gateway_restart_handoff.py
+++ b/tests/hermes_cli/test_kanban_gateway_restart_handoff.py
@@ -85,7 +85,7 @@ def test_managed_gateway_worker_is_spawned_in_restart_safe_scope(
     assert captured_cmd[unit_index + 1] == "hermes-worker-kanban-t_candidate_restart-run-23"
     assert "MemoryMax=1073741824" in captured_cmd
     separator = captured_cmd.index("--")
-    assert captured_cmd[separator + 1 :] == [sys.executable, "-m", "hermes_cli.kanban_worker_client"]
+    assert captured_cmd[separator + 1 :] == [sys.executable, "-P", "-m", "hermes_cli.kanban_worker_client"]  # Fork: -P, the workspace cwd never shadows the install
     assert task.assignee is not None
     assert captured_env["HERMES_PROFILE"] == task.assignee
     assert captured_env["HERMES_HOME"] == str(workspace.parent / ".hermes" / "profiles" / task.assignee)
@@ -145,7 +145,7 @@ def test_standalone_dispatcher_keeps_direct_worker_spawn(
     )
 
     assert kbd._default_spawn(task, str(workspace)) == 4243
-    assert captured_cmd == [sys.executable, "-m", "hermes_cli.kanban_worker_client"]
+    assert captured_cmd == [sys.executable, "-P", "-m", "hermes_cli.kanban_worker_client"]  # Fork: -P, the workspace cwd never shadows the install
 
 
 @pytest.mark.platforms("linux")
@@ -184,7 +184,7 @@ def test_oneshot_unit_dispatcher_scope_wraps_or_warns_never_dooms_silently(
     with caplog.at_level("WARNING", logger=process_registry.logger.name):
         kbd._default_spawn(task, str(workspace))
     # Unwrapped: the bare worker argv (the profile owner executes; this client waits for its receipt).
-    assert spawned[-1] == [sys.executable, "-m", "hermes_cli.kanban_worker_client"]
+    assert spawned[-1] == [sys.executable, "-P", "-m", "hermes_cli.kanban_worker_client"]  # Fork: -P, the workspace cwd never shadows the install
     warned = [r.getMessage() for r in caplog.records if "KILLED when the unit exits" in r.getMessage()]
     assert len(warned) == 1 and "KillMode=process" in warned[0]
 
diff --git a/tests/hermes_cli/test_worker_argv_ignores_cwd_checkout.py b/tests/hermes_cli/test_worker_argv_ignores_cwd_checkout.py
index a5263f6d09a..ab8418a83dd 100644
--- a/tests/hermes_cli/test_worker_argv_ignores_cwd_checkout.py
+++ b/tests/hermes_cli/test_worker_argv_ignores_cwd_checkout.py
@@ -22,6 +22,7 @@ from pathlib import Path
 import pytest
 
 REPO_ROOT = Path(__file__).resolve().parents[2]
+WORKER_MODULE = "hermes_cli.kanban_worker_client"
 PROBE = "import hermes_cli, cron; print(hermes_cli.__file__); print(cron.__file__)"
 # The spawn paths under test get ``subprocess.Popen`` monkeypatched; the probe needs the real one.
 _REAL_POPEN = subprocess.Popen
@@ -106,12 +107,14 @@ def test_kanban_worker_in_a_checkout_workspace_imports_the_install(
     captured = _capture_kanban_spawn(monkeypatch, tmp_path, decoy_checkout)
 
     assert captured["cwd"] == str(decoy_checkout)
-    assert "hermes_cli.main" in captured["cmd"]
+    # Fork: upstream's worker is the owner client ``-m hermes_cli.kanban_worker_client`` (the profile
+    # owner runs the card), not ``-m hermes_cli.main ... chat``; the cwd rule is the same.
+    assert WORKER_MODULE in captured["cmd"]
     _assert_install_tree(_imports_from(captured["cmd"], captured["env"], decoy_checkout))
-    # And the real entry point starts from there (it refused with the PM error before).
-    module_at = captured["cmd"].index("hermes_cli.main")
+    # And the real worker module imports from there (it refused with the PM error before).
+    module_at = captured["cmd"].index(WORKER_MODULE)
     child_env = {k: v for k, v in captured["env"].items() if k != "PYTHONSAFEPATH"}
-    returncode, out, err = _run([*captured["cmd"][: module_at + 1], "--version"],
+    returncode, out, err = _run([*captured["cmd"][: module_at - 1], "-c", f"import {WORKER_MODULE}"],
                                 cwd=decoy_checkout, env=child_env)
     assert returncode == 0 and "DECOY" not in err, (out, err)
 
@@ -140,7 +143,7 @@ def test_placement_forwarder_and_its_worker_import_the_install(
     assert fwd.MODULE in cmd, cmd
     _assert_install_tree(_imports_from(cmd, captured["env"], decoy_checkout))
     worker = cmd[cmd.index("--") + 1:]
-    assert "hermes_cli.main" in worker
+    assert WORKER_MODULE in worker  # Fork: upstream's owner client, see above
     _assert_install_tree(_imports_from(worker, captured["env"], decoy_checkout))
 
 
