From a5cd70aac2514bae1667a7ad502cbb4e6bc264a7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 10:56:01 +0000
Subject: [PATCH] [daveey] A wake carrying its Kanban card stays a kanban-wake
 so queued wakes still fold

---
 gateway/wake.py                        | 3 ++-
 tests/gateway/test_kanban_wake_fold.py | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/gateway/wake.py b/gateway/wake.py
index 03fdee33b0..ef375a4e34 100644
--- a/gateway/wake.py
+++ b/gateway/wake.py
@@ -148,7 +148,8 @@ async def deliver_wake(adapter: Any, *, text: str, session_id: str = "", source:
             if kanban_card:
                 category["kanban_cards"] = [{**kanban_card, "text": str(kanban_card.get("text") or "")[:32000]}]
             try:
-                producer = "kanban-wake" if core_update_notifier else "background-wake"
+                # A wake carrying its card is a Kanban notifier wake (it folds, kanban_wake_fold) even without the flag.
+                producer = "kanban-wake" if core_update_notifier or kanban_card else "background-wake"
                 if await admit_route_wake(runner, adapter, source, text, producer, category):
                     return  # committed to the session FIFO: never interrupts the admitted turn
             except RuntimeStoreError as exc:
diff --git a/tests/gateway/test_kanban_wake_fold.py b/tests/gateway/test_kanban_wake_fold.py
index fa0ec273bc..150ca7c1ee 100644
--- a/tests/gateway/test_kanban_wake_fold.py
+++ b/tests/gateway/test_kanban_wake_fold.py
@@ -244,7 +244,7 @@ async def test_a_wake_queued_before_the_upgrade_still_folds(tmp_path, monkeypatc
     try:
         old, new = board('old'), board('new')
         await deliver_wake(adapter, text=f'[kanban] Task {old} completed.\nTitle: old\nBoard: default\n\n{GUIDANCE}',
-                           source=source)
+                           source=source, core_update_notifier=True)  # the old notifier's producer: kanban-wake, no card
         await _wake(adapter, source, new, 'completed')
         [row] = _automation(queued())
         text = row['payload']['text']
-- 
2.43.0

