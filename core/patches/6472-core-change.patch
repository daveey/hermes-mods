---
diff --git a/tests/hermes_cli/test_kanban_annotation_revision.py b/tests/hermes_cli/test_kanban_annotation_revision.py
index c20a85a0569..7ea7128ba8b 100644
--- a/tests/hermes_cli/test_kanban_annotation_revision.py
+++ b/tests/hermes_cli/test_kanban_annotation_revision.py
@@ -263,6 +263,16 @@
     assert not conn.in_transaction
 
 
+def test_unknown_containment_table_refuses_counts_and_links_but_not_attention(conn):
+    """Attention reads no containment ledger: an unenumerated ``containment_*`` table must not uncertify it."""
+    conn.execute("CREATE TABLE containment_future_input (x TEXT)")
+    conn.commit()
+    values = rev.read_revisions(conn, ID, (rev.COUNTS, rev.LINKS, rev.ATTENTION))
+    assert values[rev.COUNTS.name] is None and values[rev.LINKS.name] is None
+    assert values[rev.ATTENTION.name] is not None
+    assert rev.read_attention_revision(conn, ID) == values[rev.ATTENTION.name]
+
+
 def test_dropping_optional_table_makes_old_triggers_foreign(conn):
     conn.execute("DROP TABLE containment_attestations")
     conn.commit()
diff --git a/tests/hermes_cli/test_kanban_annotation_semantic_parts.py b/tests/hermes_cli/test_kanban_annotation_semantic_parts.py
index 589e295fef7..9b1b7ee3f9b 100644
--- a/tests/hermes_cli/test_kanban_annotation_semantic_parts.py
+++ b/tests/hermes_cli/test_kanban_annotation_semantic_parts.py
@@ -36,6 +36,30 @@
     assert calls == [(world.board, ('counts', 'links', 'attention'))]
 
 
+def test_holder_keys_carry_the_hub_signature_for_every_local_part(world, monkeypatch, tmp_path):
+    """Each batched part key is the per-part fingerprint, hub signature included, and moves with the hub alone."""
+    from hermes_cli import kanban_annotation_parts as parts
+
+    _install(world)
+    hub = tmp_path / 'hub.db'
+    hub.write_bytes(b'')
+    signature = ['hub-1']
+    monkeypatch.setattr(ksa, '_hub_db_path', lambda: hub)
+    monkeypatch.setattr(ksa, '_hub_content_signature', lambda path: (str(path), signature[0]))
+    local = ('counts', 'links', 'attention')
+    before = parts.keys(helpers.SCOPE)
+    for part in local:
+        assert before[part][0] == parts._part_fingerprint(part)
+        assert before[part][0][-1] == (str(hub), 'hub-1')
+    assert parts.keys(helpers.SCOPE)['links'] == before['links']  # unchanged hub and board: stable key
+    signature[0] = 'hub-2'
+    after = parts.keys(helpers.SCOPE)
+    for part in local:
+        assert after[part][0] != before[part][0]
+        assert after[part][0][:-1] == before[part][0][:-1]  # only the hub element moved
+        assert after[part][0] == parts._part_fingerprint(part)
+
+
 def test_irrelevant_board_storm_reads_no_part(world):
     _install(world)
     # Complete declaration: this check reads only its card and the explicit file.
