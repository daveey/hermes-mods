From 3d863861773364b4f457fe5d0c089a7714aaebd3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 15:32:33 +0000
Subject: [PATCH] [daveey] hub-read root paths: allow-list path chars, refuse
 dot-only segments

Review 5877095261: a shell operator glued to a root path (~/.hermes/logs/x&&systemctl ...,
...:systemctl) was swallowed into the path, and logs/.. counted as under logs. The path is now
[\w.@+%~/-]*, and dot-only segments are refused before a trailing sentence dot is trimmed.
Kanban t_01a1cf7175102c70.
---
 hermes_cli/kanban_placement_coordination.py    | 12 ++++++++----
 tests/hermes_cli/test_kanban_hub_read_roots.py | 13 +++++++++++++
 2 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_placement_coordination.py b/hermes_cli/kanban_placement_coordination.py
index 8e620822e6..f729ce00af 100644
--- a/hermes_cli/kanban_placement_coordination.py
+++ b/hermes_cli/kanban_placement_coordination.py
@@ -98,8 +98,9 @@ _ACCESS = (
 HUB_READ_SUBCOMMANDS = ("cat", "tail", "head", "ls", "grep", "sqlite", "status", "journal", "units", "git", "help")
 _HUB_READ_SSH = re.compile(r"\bssh[ \t]+hermes-hub[ \t]+(?:" + "|".join(HUB_READ_SUBCOMMANDS) + r")(?![\w-])",
                            re.IGNORECASE)
-# A Hermes state path (same roots as ``kanban_placement.HERMES_STATE_PATH``) up to the next space, quote or bracket.
-_STATE_PATH = re.compile(r"(?:~|/home/[^/\s]+)/\.hermes/([^\s`'\"<>()\[\]{},;|]*)")
+# A Hermes state path (same roots as ``kanban_placement.HERMES_STATE_PATH``). The path is an allow-list of path
+# characters, so a shell operator glued to it (``&&``, ``;``, ``:``, ``|``, ``$(``) ends it and stays in the text.
+_STATE_PATH = re.compile(r"(?:~|/home/[^/\s]+)/\.hermes/([\w.@+%~/-]*)")
 
 
 def hub_read_roots(cfg) -> tuple:
@@ -118,9 +119,12 @@ def hub_read_roots(cfg) -> tuple:
 
 
 def _under_roots(path: str, roots) -> bool:
-    segs = path.rstrip(".:!?").rstrip("/").split("/")
-    if any(s in ("", ".", "..") for s in segs):
+    segs = path.rstrip("/").split("/")
+    # Dot-only segments (``.``, ``..``) are refused before a sentence's trailing ``.`` is trimmed, so ``logs/..``
+    # never reads as ``logs``.
+    if any(s.strip(".") == "" for s in segs):
         return False
+    segs[-1] = segs[-1].rstrip(".")
     return any(tuple(segs[:len(r)]) == r for r in roots)
 
 
diff --git a/tests/hermes_cli/test_kanban_hub_read_roots.py b/tests/hermes_cli/test_kanban_hub_read_roots.py
index 4e3ca0e602..da84dd87e8 100644
--- a/tests/hermes_cli/test_kanban_hub_read_roots.py
+++ b/tests/hermes_cli/test_kanban_hub_read_roots.py
@@ -40,6 +40,8 @@ def test_declared_read_step_is_portable(attested):
     "ssh hermes-hub ls ~/.hermes/cache/core-update/",
     "ssh hermes-hub sqlite kanban 'select 1'",
     "read `~/.hermes/kanban/boards/x/kanban.db`.",
+    "ssh hermes-hub grep X ~/.hermes/logs/hermes-sync.log.",
+    "ssh hermes-hub cat ~/.hermes/config.yaml: check kanban.placement",
 ])
 def test_other_hub_read_shapes_are_portable(attested, body):
     cfg, _, _ = attested
@@ -80,6 +82,17 @@ def test_malformed_roots_clear_nothing(attested, roots):
     "ssh hermes-hub grep X ~/.hermes/logs/hermes-sync.log, then restart the gateway",
     "ssh hermes-hub grep X ~/.hermes/logs/hermes-sync.log, then systemctl restart hermes-sync",
     "ssh hermes-hub cat ~/.hermes/config.yaml and hermes config set kanban.x 1",
+    # A write glued to a root path is not part of the path (review 5877095261).
+    "ssh hermes-hub cat ~/.hermes/logs/x&&systemctl restart hermes-gateway",
+    "ssh hermes-hub cat ~/.hermes/logs/x&&hermes-sync push",
+    "ssh hermes-hub cat ~/.hermes/logs/x:systemctl restart hermes-gateway",
+    "ssh hermes-hub cat ~/.hermes/logs/x;systemctl restart hermes-gateway",
+    "ssh hermes-hub cat ~/.hermes/logs/x|systemctl restart hermes-gateway",
+    # Dot-only segments never count as under a root.
+    "rm -rf ~/.hermes/logs/..",
+    "rm -rf ~/.hermes/logs/x/..",
+    "rm -rf ~/.hermes/logs/.",
+    "rm -rf ~/.hermes/logs/...",
 ])
 def test_controls_still_pin(attested, body):
     cfg, _, _ = attested
