From 79eb5ecb16026c6e57b27897a5514037ec81a880 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:19:06 +0000
Subject: [PATCH] [daveey] Deflake hosted member warning order assertions

---
 tests/gateway/test_hosted_group_members.py | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/tests/gateway/test_hosted_group_members.py b/tests/gateway/test_hosted_group_members.py
index c01f03b3b16..f7f936182da 100644
--- a/tests/gateway/test_hosted_group_members.py
+++ b/tests/gateway/test_hosted_group_members.py
@@ -244,9 +244,13 @@ def test_single_profile_gateway_seats_only_itself_and_configured_profiles(tmp_pa
         assert 'result' in created, created
 
 
-def test_a_bad_hosted_rooms_entry_refuses_only_the_member_naming_it(tmp_path, monkeypatch, caplog):
-    from gateway import hosted_rooms, session_finite
+@pytest.mark.parametrize('entry_order', [('alpha', 'helper'), ('helper', 'alpha')])
+def test_a_bad_hosted_rooms_entry_refuses_only_the_member_naming_it(tmp_path, monkeypatch, caplog, entry_order):
+    from gateway import hosted_rooms, session_finite, session_hosted_members
 
+    # The process-wide dedup cache otherwise carries value-independent warnings
+    # (such as alpha=None) from the first entry-order case into the next.
+    monkeypatch.setattr(session_hosted_members, '_REPORTED', set())
     caplog.set_level(logging.WARNING, logger='gateway.session_hosted_members')
     ran = []
 
@@ -269,7 +273,7 @@ def test_a_bad_hosted_rooms_entry_refuses_only_the_member_naming_it(tmp_path, mo
 
         # Now alpha's entry moves a served bot, and helper's names beta's home a second time.
         config.write_text(json.dumps({'hosted_rooms': {'profiles': {
-            'alpha': str(homes['beta']), 'helper': str(homes['beta'])}}}))
+            name: str(homes['beta']) for name in entry_order}}}))
         for attempt in range(2):
             assert 'result' in desktop('default', 'profiles.list', include_sessions=False)
             assert 'result' in create(desktop, f'rest-{attempt}', 'default', 'beta')
@@ -282,8 +286,9 @@ def test_a_bad_hosted_rooms_entry_refuses_only_the_member_naming_it(tmp_path, mo
             assert create(desktop, f'alias-{attempt}', 'default', 'helper')['error']['data'] == {
                 'reason': 'invalid_params', 'field': 'hosted_rooms.profiles.helper',
                 'detail': "member 1 profile 'helper': names the home already seated as 'beta'"}
-        # Each ignored entry is logged once, however often the roster is read.
-        assert ignored() == [
+        # Concurrent roster readers can emit these in either order. Compare a sorted
+        # list, not a set: each ignored entry must still be logged exactly once.
+        assert sorted(ignored()) == [
             'Ignoring hosted_rooms.profiles.alpha for profile=default: this gateway serves that profile from another home',
             "Ignoring hosted_rooms.profiles.helper for profile=default: names the home already seated as 'beta'"]
         # The room that already seats helper keeps running its other members.
-- 
