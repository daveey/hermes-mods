Subject: [PATCH] test(kanban): separate WAL poll reuse from checkpoint pager
 refresh [daveey]

---
 tests/hermes_cli/test_kanban_sync_idle_round.py | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_sync_idle_round.py b/tests/hermes_cli/test_kanban_sync_idle_round.py
index 3a0033c132..6d6850efba 100644
--- a/tests/hermes_cli/test_kanban_sync_idle_round.py
+++ b/tests/hermes_cli/test_kanban_sync_idle_round.py
@@ -207,6 +207,10 @@ def test_write_during_repair_is_not_cached_as_already_repaired(live, svc, kanban
 
 
 def test_outbox_poll_keeps_one_connection_per_board_and_sees_new_work(live, kanban_home, monkeypatch):
+    # Keep this a WAL-commit reuse test, not an auto-checkpoint page-count lottery.
+    # Schema growth can put task capture across the default 1000-page threshold;
+    # a main-file checkpoint correctly makes BoardWatch reopen its pager.
+    live.execute("PRAGMA wal_autocheckpoint=0")
     path = kanban_home / "kanban.db"
     with kbc.write_txn(live):
         live.execute("DELETE FROM kanban_sync_outbox")
@@ -219,6 +223,15 @@ def test_outbox_poll_keeps_one_connection_per_board_and_sees_new_work(live, kanb
     kb.create_task(live, title="new local work", assignee="worker")  # captured into the outbox by trigger
     assert ksc.outbox_pending([path]) is True
     assert len(opened) == 1
+    # Checkpoint is different from a WAL-only commit: reopening the main-file
+    # pager must preserve visibility, then return to kept-connection polling.
+    checkpoint = tuple(live.execute("PRAGMA wal_checkpoint(TRUNCATE)").fetchone())
+    assert checkpoint[0] == 0
+    assert ksc.outbox_pending([path]) is True
+    assert len(opened) == 2
+    for _ in range(20):
+        assert ksc.outbox_pending([path]) is True
+    assert len(opened) == 2
 
 
 def test_outbox_poll_reopens_a_replaced_board_file(live, kanban_home):
