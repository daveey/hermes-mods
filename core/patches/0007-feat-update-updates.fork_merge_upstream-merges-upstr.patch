-            f"\nℹ Your fork has {origin_ahead} commit(s) not on upstream.\n"
-            "  Skipping upstream sync to preserve your changes.\n"
-            "  If you want to merge upstream changes, run:\n    git pull upstream main"
-        )
-        return True
-    if upstream_ahead == 0:
+        if upstream_ahead == 0:
+            print(f"  ✓ Fork is up to date with upstream ({origin_ahead} fork commit(s) on top)")
+            return True
+        if not _fork_merges_upstream():
+            print(
+                f"\nℹ Your fork has {origin_ahead} commit(s) not on upstream.\n"
+                "  Skipping upstream sync to preserve your changes.\n"
+                "  If you want to merge upstream changes, run:\n    git pull upstream main\n"
+                "  (or set updates.fork_merge_upstream: true to merge on every update)"
+            )
+            return True
+        # updates.fork_merge_upstream: carry the fork's commits forward by merging upstream into HEAD.
+        # The merge is computed off-tree (merge-tree + commit-tree), so the live checkout only ever
+        # fast-forwards — the same custody path as a plain upstream pull — and a conflict moves nothing.
+        merged = _synthesize_upstream_merge(git_cmd, cwd, upstream)
+        if merged is None:
+            return False
+        target = merged
+        print(f"\n→ Fork is {upstream_ahead} commit(s) behind upstream\n→ Merging upstream into the fork ({target[:10]})...")
+    elif upstream_ahead == 0:
         print("  ✓ Fork is up to date with upstream")
         return True
-    print(f"\n→ Fork is {upstream_ahead} commit(s) behind upstream\n→ Pulling from upstream...")
+    else:
+        print(f"\n→ Fork is {upstream_ahead} commit(s) behind upstream\n→ Pulling from upstream...")
     # A tree move like the pull itself: the marker and the owed tail are armed before git writes,
     # and the just-fetched ref is merged (a second `git pull` fetch could move past the marker's target).
     from hermes_cli import update_cmd_commit as _commit
@@ -428,7 +474,6 @@ def _sync_with_upstream_if_needed(git_cmd: list[str], cwd: Path, *, assume_yes:
         # The marker's ``pre`` is what a killed move is restored to: never arm ``pre=``.
         print("  ✗ Could not resolve HEAD. Skipping upstream sync.")
         return False
-    target = upstream  # the counted commit is the marker's target and the merge's (m2)
