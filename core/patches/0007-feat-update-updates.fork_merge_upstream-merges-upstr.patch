         if refused or _commit.settle_failed_tree_move(cwd):
             # Back at ``pre``; that is still new code when the origin pull moved first, and disarm
@@ -457,11 +502,11 @@ def _sync_with_upstream_if_needed(git_cmd: list[str], cwd: Path, *, assume_yes:
             print(f"    ({detail})")
         return False
     interrupted_pull_marker(cwd).unlink(missing_ok=True)  # git exited 0: whole at what it landed on
-    if (landed := _git_stdout(git_cmd, ["rev-parse", "-q", "--verify", "HEAD"], cwd)) != upstream:
+    if (landed := _git_stdout(git_cmd, ["rev-parse", "-q", "--verify", "HEAD"], cwd)) != target:
         # Not the commit the debt was armed for (O3's check, here): owed for the HEAD it is on, or
         # handed back at the run's start commit; the caller's HEAD check refuses the update.
         _commit.disarm_commit_obligations()
-        print(f"  ✗ HEAD is on {(landed or '?')[:10]} after the upstream merge, not {upstream[:10]}.")
+        print(f"  ✗ HEAD is on {(landed or '?')[:10]} after the upstream merge, not {target[:10]}.")
         return False
     print("  ✓ Updated from upstream")
     # The fork push waits for a validated update: ``_push_synced_fork`` after the syntax guard.
@@ -478,7 +523,9 @@ def _push_synced_fork(git_cmd: list[str], cwd: Path) -> None:
     # Full ref names: a local branch called upstream/main or origin/main must not answer (m2).
     upstream = _git_stdout(git_cmd, ["rev-parse", "-q", "--verify", "refs/remotes/upstream/main^{commit}"], cwd)
     origin = _git_stdout(git_cmd, ["rev-parse", "-q", "--verify", "refs/remotes/origin/main^{commit}"], cwd)
-    if not head or head != upstream or head == origin:
+    if not head or not upstream or head == origin:
+        return
+    if head != upstream and not (_fork_merges_upstream() and _git_ok(git_cmd, ["merge-base", "--is-ancestor", upstream, head], cwd)):
         return
     if origin and not _git_ok(git_cmd, ["merge-base", "--is-ancestor", origin, head], cwd):
         return
diff --git a/tests/hermes_cli/test_update_fork_merge_upstream.py b/tests/hermes_cli/test_update_fork_merge_upstream.py
new file mode 100644
index 0000000000..63032a5bce
--- /dev/null
+++ b/tests/hermes_cli/test_update_fork_merge_upstream.py
@@ -0,0 +1,56 @@
+"""Functional test: fork with own commits + updates.fork_merge_upstream merges upstream via ff of a synthesized merge."""
+import subprocess
+from pathlib import Path
+from unittest import mock
+import hermes_cli.update_cmd_git as g
+
+def sh(*a, cwd=None):
+    return subprocess.run(a, cwd=cwd, check=True, capture_output=True, text=True).stdout.strip()
+
+def mkrepo(tmp):
+    up = tmp / "up"; up.mkdir(); sh("git", "init", "-q", "-b", "main", cwd=up)
+    for k, v in {"user.email": "t@t", "user.name": "t"}.items(): sh("git", "config", k, v, cwd=up)
+    (up / "a.txt").write_text("a\n"); (up / "b.txt").write_text("b\n")
+    sh("git", "add", "-A", cwd=up); sh("git", "commit", "-qm", "base", cwd=up)
+    fork = tmp / "fork.git"; sh("git", "clone", "-q", "--bare", str(up), str(fork))
+    live = tmp / "live"; sh("git", "clone", "-q", str(fork), str(live))
+    for k, v in {"user.email": "t@t", "user.name": "t"}.items(): sh("git", "config", k, v, cwd=live)
+    sh("git", "remote", "add", "upstream", str(up), cwd=live)
+    (live / "a.txt").write_text("a fork\n"); sh("git", "commit", "-qam", "fork change", cwd=live); sh("git", "push", "-q", "origin", "main", cwd=live)
+    return up, fork, live
+
+def run(live, merge_flag, upstream_edit):
+    up = live.parent / "up"
+    (up / upstream_edit[0]).write_text(upstream_edit[1]); sh("git", "commit", "-qam", "upstream change", cwd=up)
+    with mock.patch.object(g, "_fork_merges_upstream", return_value=merge_flag), \
+         mock.patch("hermes_cli.update_cmd_commit.arm_commit_point", return_value=None), \
+         mock.patch("hermes_cli.update_cmd_commit.target_syntax_error", return_value=None), \
+         mock.patch("hermes_cli.update_cmd._should_skip_upstream_prompt", return_value=False):
+        ok = g._sync_with_upstream_if_needed(["git"], live, assume_yes=True)
+        if ok: g._push_synced_fork(["git"], live)
+    return ok
+
+
+
+def test_flag_off_leaves_fork_untouched(tmp_path):
+    up, fork, live = mkrepo(tmp_path); pre = sh("git", "rev-parse", "HEAD", cwd=live)
+    assert run(live, False, ("b.txt", "b up\n"))
+    assert sh("git", "rev-parse", "HEAD", cwd=live) == pre
+
+
+def test_flag_on_merges_upstream_and_pushes(tmp_path):
+    up, fork, live = mkrepo(tmp_path)
+    assert run(live, True, ("b.txt", "b up\n"))
+    head = sh("git", "rev-parse", "HEAD", cwd=live)
+    assert (live / "a.txt").read_text() == "a fork\n" and (live / "b.txt").read_text() == "b up\n"
+    assert len(sh("git", "rev-list", "--parents", "-n1", "HEAD", cwd=live).split()) == 3
+    assert sh("git", "rev-parse", "main", cwd=fork) == head
+    assert sh("git", "status", "--porcelain", cwd=live) == ""
+
+
+def test_conflict_moves_nothing(tmp_path):
+    up, fork, live = mkrepo(tmp_path); pre = sh("git", "rev-parse", "HEAD", cwd=live)
+    assert not run(live, True, ("a.txt", "a upstream conflict\n"))
+    assert sh("git", "rev-parse", "HEAD", cwd=live) == pre
+    assert sh("git", "rev-parse", "main", cwd=fork) == pre
+    assert sh("git", "status", "--porcelain", cwd=live) == ""
