--- a/hermes_cli/update_cmd_git.py
+++ b/hermes_cli/update_cmd_git.py
@@ -365,6 +365,37 @@ def _offer_upstream_remote(git_cmd: list[str], cwd: Path, *, assume_yes: bool, i
     return True
 
 
+def _fork_merges_upstream() -> bool:
+    """``updates.fork_merge_upstream`` (default off): merge upstream into a fork that has its own commits."""
+    with suppress(Exception):
+        from hermes_cli.config import load_config
+        return bool((load_config().get("updates") or {}).get("fork_merge_upstream", False))
+    return False
+
+
+def _synthesize_upstream_merge(git_cmd: list[str], cwd: Path, upstream: str) -> Optional[str]:
+    """Merge commit of ``upstream`` into HEAD built without touching the work tree; None on conflict/error."""
+    head = _git_stdout(git_cmd, ["rev-parse", "HEAD"], cwd)
+    if not head:
+        print("  ✗ Could not resolve HEAD. Skipping upstream merge.")
+        return None
+    tree_proc = subprocess.run([*git_cmd, "merge-tree", "--write-tree", "--no-messages", head, upstream],
+                               cwd=cwd, capture_output=True, text=True)
+    tree = (tree_proc.stdout or "").split("\n", 1)[0].strip()
+    if tree_proc.returncode != 0 or not tree:
+        conflicts = subprocess.run([*git_cmd, "merge-tree", "--write-tree", "--name-only", "--no-messages", head, upstream],
+                                   cwd=cwd, capture_output=True, text=True).stdout.splitlines()[1:]
+        print("  ✗ Upstream does not merge cleanly into your fork — nothing changed.\n"
+              "    Conflicting paths: " + (", ".join(p for p in conflicts if p.strip())[:400] or "?") + "\n"
+              "    Resolve by hand: git merge upstream/main, fix, commit, git push origin main")
+        return None
+    msg = f"Merge upstream/main ({upstream[:10]}) into fork"
+    commit = _git_stdout(git_cmd, ["commit-tree", tree, "-p", head, "-p", upstream, "-m", msg], cwd)
+    if not commit:
+        print("  ✗ Could not create the upstream merge commit. Skipping upstream merge.")
+    return commit or None
+
+
 class UpstreamTargetBroken(Exception):
     """The fork sync's upstream target fails the startup syntax check: refused before its move."""
 
@@ -408,17 +439,32 @@ def _sync_with_upstream_if_needed(git_cmd: list[str], cwd: Path, *, assume_yes:
     if origin_ahead < 0 or upstream_ahead < 0:
         print("  ✗ Could not compare branches. Skipping upstream sync.")
         return False
+    target = upstream  # what the live tree fast-forwards to: upstream itself, or a merge of it into the fork
