From 0759d3093b78954dc038f505db8543437d0c0ff6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 17:24:42 +0000
Subject: [PATCH] test(desktop): archive preflight resolves a hub chat painted
 only from the sidebar replica [daveey]

Pins that a no-selected-row archive (hotkey, tile menu) of a remote chat the
sidebar shows only from the hub-sync replica (outside the first Recents page or
while the hub's pooled backend reconnects, no owner hint) checks ancestry and
Kanban status on its owner, not the registry primary. Fails if
sessionActionRow stops merging $sidebarFallbackSessions.
---
 .../use-session-actions/archive-linked-confirm.test.tsx    | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/app/session/hooks/use-session-actions/archive-linked-confirm.test.tsx b/apps/desktop/src/app/session/hooks/use-session-actions/archive-linked-confirm.test.tsx
index 1c3b7af7f10..25752cb8757 100644
--- a/apps/desktop/src/app/session/hooks/use-session-actions/archive-linked-confirm.test.tsx
+++ b/apps/desktop/src/app/session/hooks/use-session-actions/archive-linked-confirm.test.tsx
@@ -371,7 +371,12 @@ describe('archive preflight follows the remote owner when Recents lacks it', ()
       setSessions([remoteRow({ connection_id: undefined })])
       $projectTree.set([{ previewSessions: [remoteRow()], repos: [] } as never])
     }],
-    ['no list has a row but its owner is remembered', () => setSessionOwnerHint('hub-1', hub)]
+    ['no list has a row but its owner is remembered', () => setSessionOwnerHint('hub-1', hub)],
+    // The sidebar paints the chat from the hub-sync replica (outside the first
+    // Recents page, or while the hub's pooled backend reconnects) and no owner
+    // hint was ever recorded on this Desktop.
+    ['only the sidebar hub-replica row lists it', () =>
+      $offlineSessions.set([remoteRow({ offline_cached: false, offline_gateway: 'hub', offline_version: 7 })])]
   ])('archives an idle hub chat without a warning when %s', async (_case, seed) => {
     seed()
     api.mockImplementation(desktopApi('up'))
-- 
