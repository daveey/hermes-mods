From 0a461c1d8f5398ca67dc1334b949e2ab7f5f6120 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 22:54:14 -0700
Subject: [PATCH] test(desktop): voice-prefs storage-failure cases spy on
 Storage.prototype

jsdom's Storage ignores vi.spyOn(localStorage, 'setItem') (the own-property
spy never intercepts window.localStorage.setItem), so the QuotaExceeded /
SecurityError paths wrote 'false' and two tests failed on main.
---
 apps/desktop/src/store/voice-prefs.test.ts | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/apps/desktop/src/store/voice-prefs.test.ts b/apps/desktop/src/store/voice-prefs.test.ts
index 0181240ccd..a4203e151e 100644
--- a/apps/desktop/src/store/voice-prefs.test.ts
+++ b/apps/desktop/src/store/voice-prefs.test.ts
@@ -26,7 +26,8 @@ it('keeps the desktop toggle local across config refreshes', async () => {
       localStorage.clear()
       vi.resetModules()
       const prefs = await import('./voice-prefs')
-      const write = vi.spyOn(localStorage, 'setItem')
+      // jsdom's Storage ignores an own-property spy on the instance; patch the prototype.
+      const write = vi.spyOn(Storage.prototype, 'setItem')
 
       if (fails) {
         write.mockImplementation(() => {
@@ -55,7 +56,8 @@ it('migrates the legacy preference once, not on every refresh', async () => {
       localStorage.clear()
       vi.resetModules()
       const prefs = await import('./voice-prefs')
-      const write = vi.spyOn(localStorage, 'setItem')
+      // jsdom's Storage ignores an own-property spy on the instance; patch the prototype.
+      const write = vi.spyOn(Storage.prototype, 'setItem')
 
       if (fails) {
         write.mockImplementation(() => {
