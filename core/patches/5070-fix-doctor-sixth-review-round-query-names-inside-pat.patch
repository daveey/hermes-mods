From a0248a44f2b3bef68c6ae5129a875ef9db6bd4f4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 21:23:57 -0800
Subject: [PATCH] fix(doctor): sixth review round - query names, "?" inside
 path secrets, -u scope

- query names must read as plain names: a secret used as a name is masked
  with its value, and malformed pieces after a masked pair (the rest of a
  secret cut at "&") are masked too
- a path piece with password symbols carries the secret past a "?", and
  the whole-segment rule then spans that "?"
- the generic -u/--user rule applies only where no program is known
  (options in env or shell text); curl's own -u masks admin:admin; ps,
  docker and sudo keep their -u
- exemptions narrowed: printf tokens only standing alone (%r@%h:%p), a
  "*" inside a word only in file or path globs (foo*bar.txt); ripgrep's
  !glob kept
- tests pin _password_cut_at_question, query names, user==password and the
  glob cases; the fuzz symbol alphabet has "?" and a query-name position;
  docstring rates re-measured

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_state_argv_secrets.py            | 53 +++++++++++++++++--------
 tests/hermes_state/test_argv_secrets.py | 46 ++++++++++++++++++++-
 2 files changed, 81 insertions(+), 18 deletions(-)

diff --git a/hermes_state_argv_secrets.py b/hermes_state_argv_secrets.py
index 11f1c4684c..4edf7011fd 100644
--- a/hermes_state_argv_secrets.py
+++ b/hermes_state_argv_secrets.py
@@ -10,10 +10,10 @@ env prefixes in shell strings. ``agent.redact`` still runs afterwards for known
 
 Limits, measured on generated secrets of every common shape (letters and digits, base32/64, urlsafe, hex, symbol
 passwords, single- and mixed-case letters, grouped keys) as a bare argument, in an absolute or relative path, in a
-URL, in a list, inside a spaced env value or a flag value and as a ``NAME=`` value -- a shown tail of 8+ characters
-counts as a leak: the worst shape and position shows about 8% of 16-character secrets, 3% of 24-character, 2% of
-32-character and 1% of 40-character ones (random letters can read like words); the tests hold these under 10%, 5%,
-3% and 2%. About 0.15% of this repo's identifiers and 0.1% of its env names are masked. This is a rate, not a
+URL, as a URL query name, in a list, inside a spaced env value or a flag value and as a ``NAME=`` value -- a shown
+tail of 8+ characters counts as a leak: the worst shape and position shows about 8.5% of 16-character secrets, 3% of
+24-character, 2% of 32-character and 1.5% of 40-character ones (random letters can read like words); the tests hold
+these under 10%, 5%, 3% and 2%. About 0.15% of this repo's identifiers and 0.1% of its env names are masked. This is a rate, not a
 guarantee, and some secrets look exactly like identifiers and are shown: pronounceable passwords (``correcthorse``),
 all-digit values, UUIDs, strings under 12 characters and a secret shaped like a kebab-case ``--flag`` right after a
 secret-named flag (read as the next flag, as switches need), unless a name marks them secret. Short hex (up to 12
@@ -87,9 +87,9 @@ _PROGRAM_SECRET_FLAGS = {
     "lftp": ((), (), ("-u", "--user")),
 }
 _NO_FLAGS = ((), (), ())
-# Any program: a separate -u/--user argument that is user:pass has its password masked (curl-style options passed
-# through env or shell text); a bare user, user:same-group (docker --user app:app) and uid:gid stay. Only as a separate
-# argument: -url=…, -upstream=… are other flags.
+# Where no program is known (options passed through env or shell text: CURL_ARGS='-u admin:pw'), a separate -u/--user
+# argument that is user:pass has its password masked; a bare user and a numeric uid:gid stay. Known programs (ps,
+# docker, sudo) keep their own meaning of -u, and -url=…, -upstream=… are other flags.
 _GENERIC_USER_FLAGS = frozenset({"-u", "--user"})
 _COOKIE_FLAGS = frozenset({"-b", "--cookie", "cookie"})
 # Programs that run a command given as their first positional argument: that program's own flags apply after it.
@@ -149,6 +149,7 @@ _USERINFO = re.compile(r"^([^:@/\s]+):([^:@/\s]+)@([A-Za-z][A-Za-z0-9-]*(?:\.[A-
 _NOT_USERINFO = frozenset({"mailto", "npm", "github", "gitlab", "bitbucket", "pkg", "jsr", "docker", "oci", "git"})
 _STRUCTURE = re.compile(r"[/?&#=;@]")  # between the components of a path or URL
 _NAME_COLON = re.compile(r"^([A-Za-z_][\w.-]*):(\S+)$")  # name:value, judged by the name
+_QUERY_NAME = re.compile(r"^[\w.\-\[\]]+$")  # a query parameter name: word characters, dots, dashes, brackets
 _IMAGE_DIGEST = re.compile(r"^[\w.-]+@sha\d+:[0-9a-fA-F]+$")  # image@sha256:… (the long hex is still masked)
 # A file that holds a key or credential, named after a secret flag (openssl -key server.key). A secret that looks
 # exactly like such a file name (--password notes.txt) is shown, like other secrets shaped as identifiers.
@@ -306,7 +307,10 @@ def is_identifier(token: str) -> bool:
     token = _KNOWN_ID_INSIDE.sub("id", token)  # followup:t_eeeeee0000000015:notify, hermes-kanban-t_…
     if not _NPM_SPEC.match(token):
         # globs (*.example.com, dir/*, gc*) and printf tokens (%r@%h:%p) are not password symbols
-        unglobbed = re.sub(r"(?:(?<=[./:\-*(])|^)\*|\*(?=[./:\-*)]|$)|%[A-Za-z]", "", token)
+        unglobbed = re.sub(r"(?:(?<=[./:\-*(])|^)\*|\*(?=[./:\-*)]|$)|(?<![A-Za-z0-9])%[A-Za-z](?![A-Za-z0-9])"
+                           r"|^!(?=[A-Za-z])", "", token)
+        if not re.search(r"[^\w.*/-]", unglobbed) and re.search(r"\.[A-Za-z]{1,5}$|/", unglobbed):
+            unglobbed = unglobbed.replace("*", "")  # foo*bar.txt, src/*util*/x: a file glob
         if re.search(r"[A-Za-z0-9]", unglobbed) and (
                 re.search(r"[!^$*]", unglobbed) or len(re.findall(r"[&#%@]", unglobbed)) >= 2):
             return False  # shell-unsafe symbols, or several of &#%@, in a name: a password, not an identifier
@@ -407,14 +411,15 @@ def _segments(seps: list[str], count: int) -> list[range]:
     return ranges
 
 
-def _mask_password_segments(parts: list[str], seps: list[str], bad: list[bool], content_bad: list[bool]) -> None:
+def _mask_password_segments(parts: list[str], seps: list[str], bad: list[bool], content_bad: list[bool], *,
+                            through_question: bool = False) -> None:
     """The path part of a "/" segment (before any "?") with password symbols is one secret cut at # & @ %: when that
     part as a whole is not a name, mask all of its pieces. An image digest (name@sha256:…) is not one."""
     for segment in _segments(seps, len(parts)):
         pieces = []
         for index in segment:
             pieces.append(index)
-            if index < len(seps) and seps[index] == "?":
+            if index < len(seps) and seps[index] == "?" and not through_question:
                 break
         text = "".join(parts[i] + (seps[i] if i != pieces[-1] else "") for i in pieces)
         if (re.search(r"[&#%@]", text) and re.search(r"[A-Za-z0-9]", text) and not _IMAGE_DIGEST.match(text)
@@ -428,14 +433,15 @@ def _mask_components(value: str, *, depth: int = 0) -> str:
     identifier is masked, base64 pieces next to a masked piece too, and a segment that is a symbol password cut into
     pieces (# & @ %) as a whole; the query after the first "?" is judged pair by pair under its names."""
     path, question, query = value.partition("?")
-    if question and not _password_cut_at_question(path, query):
+    cut = bool(question) and _password_cut_at_question(path, query)
+    if question and not cut:
         return f"{_mask_components(path, depth=depth)}?{_mask_query(query, depth=depth)}"
     parts = _STRUCTURE.split(value)
     seps = _STRUCTURE.findall(value)
     content_bad = [not is_identifier(part) for part in parts]
     bad = list(content_bad)
     _spread_to_base64_neighbours(parts, seps, bad)
-    _mask_password_segments(parts, seps, bad, content_bad)
+    _mask_password_segments(parts, seps, bad, content_bad, through_question=cut)
     out = [MASK if bad[0] else parts[0]]
     for sep, part, masked in zip(seps, parts[1:], bad[1:]):
         out += [sep, MASK if masked else part]
@@ -448,18 +454,31 @@ def _password_cut_at_question(path: str, query: str) -> bool:
     last = path.rsplit("/", 1)[-1]
     if not last or (is_identifier(last) and not re.search(r"[!^$*#%@&]", last)):
         return False  # a clean path piece: the "?" starts a real query
+    if re.search(r"[!^$*#@&]", last):
+        return True  # a path piece with password symbols: the secret goes on past the "?" (Xk9#mP2q?L7vN&…)
     first = re.split(r"[&/]", query, maxsplit=1)[0]
     joined = f"{last}?{first}"
     return bool(re.search(r"[!^$*#%@]", joined)) and not is_identifier(joined.replace("?", "-"))
 
 
 def _mask_query(query: str, *, depth: int) -> str:
-    """``a=1&token=x``: each value judged whole under its name (an e-mail with "@" stays one value)."""
+    """``a=1&token=x``: each name must read as one (a secret used as a name is masked), and each value is judged
+    whole under its name (an e-mail with "@" stays one value)."""
     out = []
+    masking = False  # pieces after a masked pair that are not well-formed pairs: the rest of a secret cut at "&"
     for pair in query.split("&"):
         name, eq, value = pair.partition("=")
+        well_formed = bool(eq) and bool(_QUERY_NAME.match(name)) and is_identifier(name)
+        if masking and not well_formed:
+            out.append(MASK)
+            continue
+        masking = False
         if not eq:
-            out.append(pair if is_identifier(pair) else MASK)
+            masking = not is_identifier(pair)
+            out.append(MASK if masking else pair)
+        elif not well_formed:
+            masking = True
+            out.append(f"{MASK}={MASK if value else value}")  # the name is the secret (?Xk9mP2…=1); its value goes too
         elif _is_secret_name(name) or name.lower() in _QUERY_SECRETS:
             out.append(f"{name}={MASK if value else value}")
         else:
@@ -487,8 +506,8 @@ def _mask_userpass(value: str) -> str:
     if split is None:
         return value if is_identifier(value) else MASK
     user, sep, secret = split.groups()
-    if (user.isdigit() and secret.isdigit()) or (sep == ":" and user == secret):
-        return value  # uid:gid, app:app
+    if user.isdigit() and secret.isdigit():
+        return value  # uid:gid
     return f"{user if user and is_identifier(user) else MASK}{sep}{MASK}"
 
 
@@ -712,7 +731,7 @@ def mask_argv_secrets(argv: list[str], *, program: str = "", _depth: int = 0) ->
             if (shown := _pending_value(token, kind, name, depth=_depth)) is not None:
                 out.append(shown)
                 continue
-        if token in _GENERIC_USER_FLAGS and flags is _NO_FLAGS:
+        if token in _GENERIC_USER_FLAGS and flags is _NO_FLAGS and not program:
             out.append(token)
             pending = ("userpass", token)
             continue
