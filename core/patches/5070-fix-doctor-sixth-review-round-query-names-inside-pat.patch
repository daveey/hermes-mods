-        "symbols": lambda: pick(string.ascii_letters + string.digits + "!@#$%^&*"),
+        "symbols": lambda: pick(string.ascii_letters + string.digits + "!@#$%^&*?"),
         "base64": lambda: base64.b64encode(rng.randbytes(length)).decode()[:length],
