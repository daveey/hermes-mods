From 3ca96173afd92ea280265f56bf321577e005d57b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 19:21:54 +0000
Subject: [PATCH] [daveey] lifecycle guard: a bare `cat` relays its stdin feed;
 a subshell's redirection keeps its output

A `cat` with no file operand (or a `-` operand) writes the stdin it is fed, but
`_cat_operands` only named its operands and its own `<` redirections. These ran a
lifecycle script the guard never opened (scan_gateway_lifecycle -> (False, None) on main
0068f2ca86):

- `cat r.sh | cat | bash`, `cat r.sh | (cat) | bash`, `cat r.sh | { cat; } | bash`
- `{ cat; } < r.sh | bash`, `(cat) < r.sh | bash` (PR #2442 review)

Fix: `_cat_relays_stdin` (cron/lifecycle_guard.py) says whether an executed `cat` reads its
feed: no file operand or a `-` one, and no fd-0 redirection, heredoc or here-string of its
own (`<&0` keeps the feed). `_LineWalk.flush` adds the segment's feed to what it writes when
so. `cat r.sh | cat x.txt | bash`, `cat r.sh | cat < clean.sh | bash` and
`{ cat; } < clean.sh | bash` stay allowed. The check only runs when there is a feed, so
the 8000-line heredoc perf case keeps its base timing (~1.6 s).

Also fixed (same family, found while testing `(cat) < r.sh`): words after a subshell's `)`
(`) < f`, `) 2>/dev/null`) flushed as a segment that wrote nothing and overwrote the
subshell's output, so `(cat r.sh) 2>/dev/null | bash` failed open. `)` now records the
group's output as `closed`, like a `}` closer does.

Not covered here: `cat r.sh 2>&1 | bash` still fails open because the tokenizer splits
`2>&1` into a background `&`; follow-up t_01a1d655f3e69b6e.

Tests: tests/cron/test_lifecycle_guard_cat_relay.py, 34 cases; on base 22 fail / 12 pass,
at head 34 pass. tests/cron/test_lifecycle*.py 826 passed; tests/cron 2743 passed,
9 skipped (scripts/run_tests.sh).

Card: t_01a1d5c442ed5fc9
---
 cron/lifecycle_guard.py                      | 24 ++++-
 cron/lifecycle_guard_groups.py               | 21 +++--
 tests/cron/test_lifecycle_guard_cat_relay.py | 94 ++++++++++++++++++++
 3 files changed, 132 insertions(+), 7 deletions(-)
 create mode 100644 tests/cron/test_lifecycle_guard_cat_relay.py

diff --git a/cron/lifecycle_guard.py b/cron/lifecycle_guard.py
index c6631a90e3..4cfc96a0ca 100644
--- a/cron/lifecycle_guard.py
+++ b/cron/lifecycle_guard.py
@@ -834,7 +834,8 @@ def _iter_segment_contexts(
         return _opens_call_arguments(segment) and alias_names.isdisjoint(segment)
     for tokens in _iter_command_token_lists(command):
         yield from iter_line_segment_contexts(
-            tokens, cat_operands=_cat_operands, opens_call_arguments=opens_call,
+            tokens, cat_operands=_cat_operands, cat_relays_stdin=_cat_relays_stdin,
+            opens_call_arguments=opens_call,
             peel_reserved_words=_peel_reserved_words,
             stdin_redirections=lambda words: _split_redirections(words)[1])
 
@@ -961,6 +962,27 @@ def _cat_operands(segment: Optional[list[str]]) -> list[str]:
     return []
 
 
+def _cat_relays_stdin(segment: list[str]) -> bool:
+    """Whether a ``cat`` segment writes the stdin it is fed (``… | cat | bash``, ``{ cat; } <
+    f``): no file operand or a ``-`` one, and no redirection, heredoc or here-string of its own
+    on fd 0 (``cat < x``, ``cat <<< x`` and ``cat x.txt`` ignore the feed)."""
+    for view in _command_segment_views(segment):
+        index = _executed_command_index(view)
+        if index is not None and _executable_name(view[index]) == "cat":
+            words, arguments = iter(view[index + 1 :]), []
+            for word in words:
+                match = _REDIRECTION.match(word)
+                if match is None:
+                    arguments.append(word)
+                    continue
+                fd, operator, target = match.groups()
+                target = target or next(words, "")
+                if fd in ("", "0") and operator.startswith("<") and (operator, target) != ("<&", "0"):
+                    return False  # `cat < x`, `cat <<< x`, `cat <&3` read their own stdin
+            return "-" in arguments or all(argument.startswith("-") for argument in arguments)
+    return False
+
+
 def contains_launchctl_submit_command(command: str) -> bool:
     """Detect an executed ``launchctl submit``/``bootstrap``, not quoted text.
 
