From 535743583d9e88069db7906741fb0c3d687a60fd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 20:30:10 +0000
Subject: [PATCH] fix(auth): use shared subprocess environment factory for
 relay [daveey]

---
 agent/credential_relay_repull.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/agent/credential_relay_repull.py b/agent/credential_relay_repull.py
index 730186632b..a1e548b81f 100644
--- a/agent/credential_relay_repull.py
+++ b/agent/credential_relay_repull.py
@@ -131,7 +131,8 @@ def _run_pull(cmd: list[str]) -> None:
             # The relay owns its interpreter (workers use /usr/bin/python3 for boto3).
             # PM's backend PYTHONPATH mixes its cryptography with distro OpenSSL and
             # fails at GEN_EMAIL. Preserve relay/AWS/home settings, not Python imports.
-            env = os.environ.copy()
+            from tools.environments.local import build_subprocess_env
+            env = build_subprocess_env(scrub_secrets=False, inherit_profile_home=False)
             env.pop("PYTHONPATH", None)
             env.pop("PYTHONHOME", None)
             proc = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace",
-- 
