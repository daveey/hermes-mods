diff --git a/hermes_cli/kanban_sync_replica_unfreeze.py b/hermes_cli/kanban_sync_replica_unfreeze.py
index 9fb425ec3edb2f61b5a958fc91a19b783ef78439..ab88c8b769a818e4afabadf67337779e85d27878 100644
--- a/hermes_cli/kanban_sync_replica_unfreeze.py
+++ b/hermes_cli/kanban_sync_replica_unfreeze.py
@@ -1,19 +1,15 @@
-"""One-time rebuild of replicas that froze stopped cards against the feed. [daveey]
+"""One-time full rebuild of replicas that consumed changes while stop-frozen. [daveey]
 
-Before ``kanban_stop_sync.frozen_change`` skipped replicas, a pulled copy (``sync-shadow/<board>.db``) dropped every
-feed change for a card holding an ``administrative_stop_restricted`` event, while its cursor advanced. The feed
-never resends those changes, so such a replica keeps the stopped card's status as of the stop (a stopped card
-stayed ``scheduled`` after its home archived it). A snapshot resync re-delivers every row; it runs once per replica
-that holds a stop event, and a marker beside the file records it.
+A snapshot upserts live rows but cannot recover consumed deletions in a populated
+replica. Use the retention-rebuild path, preserving quarantine and invalidating
+pooled descriptors. Persist intent before discarding the old replica so failures
+retry even when the new database has not yet received its stop event.
 """
 from __future__ import annotations
 
-import logging
 import sqlite3
 from pathlib import Path
-from typing import Any
 
-_log = logging.getLogger(__name__)
 SUFFIX = ".stop-unfrozen"
 
 
@@ -21,19 +17,22 @@
     return path.with_name(path.name + SUFFIX)
 
 
+def _pending(path: Path) -> Path:
+    return path.with_name(path.name + SUFFIX + ".pending")
+
+
 def needed(replica: sqlite3.Connection, path: Path) -> bool:
     from hermes_cli.kanban_stop_ended import KIND
     if _marker(path).exists():
         return False
-    return replica.execute("SELECT 1 FROM task_events WHERE kind = ? LIMIT 1", (KIND,)).fetchone() is not None
+    return _pending(path).exists() or replica.execute(
+        "SELECT 1 FROM task_events WHERE kind = ? LIMIT 1", (KIND,)).fetchone() is not None
+
+
+def begin(path: Path) -> None:
+    _pending(path).write_text("pending\n", encoding="utf-8")
 
 
-def unfreeze(replica: sqlite3.Connection, hub: Any, slug: str, path: Path) -> int:
-    """Resync ``replica`` from the Board snapshot once when it may hold frozen cards; returns rows read."""
-    from hermes_cli import kanban_sync_client as ksc
-    if not needed(replica, path):
-        return 0
-    count = ksc.resync(replica, hub, slug, observers=False)
+def finish(path: Path) -> None:
     _marker(path).write_text("done\n", encoding="utf-8")
-    _log.warning("kanban sync: %s replica held stopped cards frozen against the feed; resynced %d rows", slug, count)
-    return count
+    _pending(path).unlink(missing_ok=True)
