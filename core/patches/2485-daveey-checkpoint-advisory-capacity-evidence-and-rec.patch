diff --git a/hermes_cli/kanban_capacity_evidence.py b/hermes_cli/kanban_capacity_evidence.py
new file mode 100644
index 0000000000..ff4087bf21
--- /dev/null
+++ b/hermes_cli/kanban_capacity_evidence.py
@@ -0,0 +1,201 @@
+"""Advisory dispatch evidence; never read by admission or scheduling decisions.
+
+One bounded latest snapshot per local board, not a replicated authority. Reads
+never write or renew source validity. Unknown admission coverage is explicit.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import sqlite3
+import time
+import uuid
+
+from hermes_cli.execution_observations import adapt, capacity_reason, epoch
+
+_log = logging.getLogger(__name__)
+TABLE = "kanban_capacity_observation"
+TASK_LIMIT = 128
+
+
+def _lifecycle(conn, task_id):
+    row = conn.execute("SELECT * FROM tasks WHERE id=?", (task_id,)).fetchone()
+    if row is None:
+        return None
+    row = dict(row)
+    count = conn.execute("SELECT count(*) FROM task_runs WHERE task_id=?", (task_id,)).fetchone()[0]
+    return {"status": row["status"], "run_id": row["current_run_id"],
+            "runs_on": row.get("runs_on"), "run_count": count}
+
+
+def _reason(code, native, reference, phase="pre_claim"):
+    return capacity_reason(code, native_code=native, phase=phase, evidence_ref=reference)
+
+
+def _native_restrictions(result, tid, reference):
+    """Keep unmapped admission restrictions without inventing a capacity category."""
+    rows = []
+    if result.at_capacity:
+        rows.append({"native_code": "at_capacity", "evidence_ref": reference})
+    for name in ("claim_deferred", "capsule_refused", "owner_down", "skipped_per_profile_capped", "respawn_guarded"):
+        for item in getattr(result, name):
+            if item[0] == tid:
+                rows.append({"native_code": name, "evidence_ref": reference})
+    return rows
+
+
+def _task_reasons(result, tid, reference):
+    reasons = []
+    for task, native in result.skipped_ineligible:
+        if task == tid:
+            reasons.append(_reason("placement", native, reference))
+    if tid in result.rate_limited:
+        # A reaped submitter can refuse before its managed worker ever starts.
+        reasons.append(_reason("provider_limit", "rate_limited", reference, "post_claim"))
+    # Only explicit provider quota clocks; generic cooldowns are not provider limits.
+    held = result.clock_held.get(tid)
+    if held and held[0] in {"subscription_quota_reset", "rate_limit_cooldown"}:
+        reasons.append(_reason("provider_limit", held[0], reference))
+    for task, native in result.respawn_guarded:
+        if task == tid and native in {"subscription_quota_reset", "rate_limit_cooldown"}:
+            reason = _reason("provider_limit", native, reference)
+            if reason not in reasons:
+                reasons.append(reason)
+    return reasons
+
+
+def record(conn, result, *, board, machine, now=None, update_drain=False, dry_run=False):
+    """Record only genuine dispatch observations; a failed diagnostic cannot stop dispatch.
+
+    No free-slot or ready-eligibility inference from registry caps/status counts.
+    Coverage stays unknown until a same-interval producer proves those facts.
+    """
+    if dry_run or result.skipped_locked or result.skipped_owned:
+        return False
+    from hermes_cli import kanban_db as kb
+
+    now = time.time() if now is None else now
+    revision = str(uuid.uuid4())
+    reference = f"dispatch:{machine}:{board}:{revision}"
+    common = []
+    if result.memory_pressure:
+        common.append(_reason("memory_pressure", result.memory_pressure, reference))
+    if update_drain:
+        common.append(_reason("update_drain", "suppress_spawn", reference))
+    try:
+        # A deferred snapshot keeps multi-query reads coherent without taking
+        # the writer lock. Release it before the single-row write transaction.
+        conn.execute("SAVEPOINT capacity_snapshot")
+        try:
+            rows = conn.execute(
+                "SELECT id, assignee, status, current_run_id, claim_lock FROM tasks "
+                "WHERE status IN ('ready','todo','running','review','scheduled','blocked') "
+                "ORDER BY CASE status WHEN 'ready' THEN 0 ELSE 1 END, id LIMIT ?", (TASK_LIMIT,)).fetchall()
+            tasks = {}
+            for row in rows:
+                tid = row["id"]
+                reasons = _task_reasons(result, tid, reference)
+                parents = kb.unsatisfied_parents(conn, tid)
+                if parents:
+                    reasons.append(_reason("dependency", "unsatisfied_parents", reference))
+                elif row["status"] == "ready" and not row["claim_lock"]:
+                    reasons = common + reasons
+                event = conn.execute("SELECT max(id) FROM task_events WHERE task_id=?", (tid,)).fetchone()[0]
+                tasks[tid] = {"lifecycle": _lifecycle(conn, tid), "reasons": reasons,
+                              "native_restrictions": _native_restrictions(result, tid, reference) if row["status"] == "ready" else [],
+                              "parents": parents, "assignee": row["assignee"], "source_event": event}
+            value = {"version": 1, "observed_at_ms": now * 1000, "valid_until_ms": (now + 180) * 1000,
+                     "source": "kanban.dispatch", "source_revision": revision, "machine": machine,
+                     "board": board, "evidence_ref": reference, "tasks": tasks,
+                     "machine_reasons": common,
+                     "coverage_truncated": len(rows) == TASK_LIMIT}
+        finally:
+            conn.execute("RELEASE capacity_snapshot")
+        with kb.write_txn(conn):
+            conn.execute(f"CREATE TABLE IF NOT EXISTS {TABLE} (id INTEGER PRIMARY KEY CHECK(id=1), payload TEXT NOT NULL)")
+            conn.execute(f"INSERT INTO {TABLE} (id,payload) VALUES(1,?) "
+                         "ON CONFLICT(id) DO UPDATE SET payload=excluded.payload", (json.dumps(value),))
+        return True
+    except (sqlite3.Error, RuntimeError, TypeError, ValueError):
+        _log.warning("capacity observation write unavailable", exc_info=True)
+        return False
+
+
+def observe_dispatch(conn, result, *, board, dry_run=False, update_drain=False):
+    """Best-effort post-result seam; diagnostics never change dispatch's return."""
+    try:
+        import socket
+        from hermes_cli import kanban_db_sync as sync
+        machine = (sync.sync_state(conn) or {}).get("gateway_id") or socket.gethostname()
+        record(conn, result, board=board or "default", machine=machine,
+               dry_run=dry_run, update_drain=update_drain)
+    except Exception:  # health: allow BLE001 -- optional evidence cannot control admission
+        _log.warning("capacity observation unavailable", exc_info=True)
+
+
+def _unknown(reason, **fields):
+    return {"version": 1, "freshness": "unknown", "unknown_reason": reason,
+            "reasons": [], "eligible_backlog": None, "admissible_slots": None,
+            "unknown_coverage": [reason], **fields}
+
+
+def read(conn, task, *, board=None, now=None):
+    """Read a lifecycle-qualified observation without manufacturing freshness."""
+    if board is None:
+        from hermes_cli import kanban_db_sync as sync
+        path = conn.execute("PRAGMA database_list").fetchone()[2]
+        board = sync.board_slug_for_path(path)
+    now = time.time() if now is None else now
+    if task is None:
+        return _unknown("missing_task")
+    try:
+        row = conn.execute(f"SELECT payload FROM {TABLE} WHERE id=1").fetchone()
+        value = json.loads(row[0]) if row else None
+    except (sqlite3.Error, TypeError, ValueError):
+        return _unknown("observation_unavailable")
+    if not isinstance(value, dict) or value.get("version") != 1 or value.get("board") != board:
+        return _unknown("missing_or_foreign_observation")
+    stored = value.get("tasks", {}).get(task.id)
+    if not stored:
+        return _unknown("task_not_observed")
+    source = {k: value[k] for k in ("observed_at_ms", "valid_until_ms", "source", "source_revision",
+                                   "machine", "board", "evidence_ref")}
+    if stored["lifecycle"] != _lifecycle(conn, task.id):
+        return _unknown("lifecycle_changed", **source)
+    identity = {"gateway": value["machine"], "profile": stored["assignee"], "board": board,
+                "kind": "card", "work_id": task.id}
+    if stored["lifecycle"]["run_id"] is not None:
+        identity["run_id"] = stored["lifecycle"]["run_id"]
+    # Neither a poll/event id nor task.status is an execution generation or a
+    # live process receipt. An unclaimed card's optional envelope is unknown.
+    state = {"ready": "queued", "todo": "waiting"}.get(task.status, "unknown")
+    observation = adapt({"version": 1, "identity": identity,
+                         "owner": {"gateway": value["machine"], "profile": stored["assignee"]},
+                         "state": state, "source": value["source"], "source_revision": value["source_revision"],
+                         "observed_at": value["observed_at_ms"] / 1000,
+                         "valid_until": value["valid_until_ms"] / 1000,
+                         "evidence_refs": [value["evidence_ref"]], "diagnostics": stored["reasons"],
+                         "last_activity": None, "last_progress": None}, now=now, source_class="sidebar")
+    at, until = source["observed_at_ms"] / 1000, source["valid_until_ms"] / 1000
+    freshness = "unknown"
+    if all(epoch(v) for v in (at, until, now)) and at <= now and until >= at:
+        freshness = "current" if now < min(until, at + 180) else "stale"
+    out = {"version": 1, **source, "task_id": task.id, "lifecycle": stored["lifecycle"],
+           "freshness": freshness, "reasons": stored["reasons"],
+           "native_restrictions": stored.get("native_restrictions", []),
+           "machine_reasons": value.get("machine_reasons", []),
+           "eligible_backlog": False if stored["parents"] and freshness == "current" else None,
+           "admissible_slots": None, "unknown_coverage": ["admission_not_fully_observed"],
+           "execution_observation": observation}
+    if observation.get("unknown_reason"):
+        out["execution_unknown_reason"] = observation["unknown_reason"]
+    return out
+
+
+def describe(value):
+    """Never turn an incomplete restriction list into an assertion of availability."""
+    codes = ", ".join(r["code"] + " (" + r["native_code"] + ")" for r in value.get("reasons", []))
+    native = ", ".join(r["native_code"] for r in value.get("native_restrictions", []))
+    codes = "; ".join(v for v in (codes, native) if v)
+    return (f"{value.get('freshness', 'unknown')}: {codes or 'restriction coverage incomplete'}; "
+            "admissible capacity unknown")
diff --git a/hermes_cli/kanban_capacity_metrics.py b/hermes_cli/kanban_capacity_metrics.py
new file mode 100644
index 0000000000..6127721939
--- /dev/null
+++ b/hermes_cli/kanban_capacity_metrics.py
@@ -0,0 +1,165 @@
+"""Pure bounded-window receipt metrics. Never used to admit, retry or declare progress.
+
+Event order is producer order, not sorted wall time: sorting clocks would conceal
+skew. ``spawned`` is a submitter, not the owner-bound executing interpreter.
+Callers must pass a complete ordered task history (or report truncated coverage).
+"""
+from __future__ import annotations
+
+import json
+from itertools import pairwise
+import math
+import statistics
+
+from hermes_cli.execution_observations import epoch
+
+METRICS = ("ready_to_claim_s", "claim_to_process_start_s", "ready_to_process_start_s")
+
+
+def _payload(event):
+    raw = event.get("payload")
+    if isinstance(raw, dict):
+        return raw
+    try:
+        value = json.loads(raw) if isinstance(raw, str) else {}
+    except ValueError:
+        return {}
+    return value if isinstance(value, dict) else {}
+
+
+def _ready(event, payload):
+    # Creation is not readiness. Only explicit ready transitions qualify.
+    if event.get("kind") == "promoted":
+        return payload.get("status", "ready") == "ready"
+    if event.get("kind") in {"released", "reclaimed", "owner_unavailable", "crashed", "rate_limited",
+                              "timed_out", "stale", "reconciled", "owner_restart_lost",
+                              "protocol_violation", "oom_killed", "signaled"}:
+        return payload.get("retry_status") == "ready"
+    return event.get("kind") in {"continued", "unblocked", "status", "continuation_woken"} and payload.get("status") == "ready"
+
+
+def _delta(start, end):
+    return end - start if epoch(start) and epoch(end) and end >= start else None
+
+
+def _attempt(board, task_id, ready, claim=None):
+    return {"board": board, "task_id": task_id,
+            "run_id": claim.get("run_id") if claim else None,
+            "ready_at": ready.get("created_at") if ready else None,
+            "claim_at": claim.get("created_at") if claim else None,
+            "ready_ref": ready.get("id") if ready else None,
+            "claim_ref": claim.get("id") if claim else None,
+            "claim_lock": _payload(claim).get("lock") if claim else None,
+            "process_start_at": None, "process_ref": None, "process_pid": None,
+            "last_progress": None}
+
+
+def attempts(events, *, board, task_id, now):
+    """One record per observed claim, plus a right-censored unclaimed ready interval.
+
+    Binding must match the actual run and claim, with process birth evidence.
+    Timestamp is the durable binding receipt time, NOT the OS fingerprint (which
+    is not an epoch). This measures time-to-process-start-receipt, an upper bound
+    on actual launch latency. Missing/skewed receipts produce null metrics.
+    """
+    rows, ready, current = [], None, None
+    for event in events:
+        payload, kind = _payload(event), event.get("kind")
+        if _ready(event, payload):
+            ready, current = event, None
+        elif kind == "claimed" and event.get("run_id") is not None:
+            # A Board lease event followed by local claim may share the run.
+            # Only the local lock-bearing claim binds the interpreter receipt.
+            if not payload.get("lock"):
+                continue
+            if current and current["run_id"] == event["run_id"]:
+                continue
+            current = _attempt(board, task_id, ready, event)
+            rows.append(current)
+            ready = None
+        elif kind == "worker_bound" and current:
+            if (event.get("run_id") == current["run_id"] and current["claim_lock"]
+                    and payload.get("claim_lock") == current["claim_lock"]
+                    and type(payload.get("pid")) is int and payload["pid"] > 0
+                    and payload.get("started_at") not in (None, "", "unverified")
+                    and current["process_ref"] is None):
+                current.update(process_start_at=event.get("created_at"), process_ref=event.get("id"),
+                               process_pid=payload["pid"])
+        elif kind in {"dependency_wait", "blocked", "scheduled", "completed", "archived", "changes_requested"}:
+            ready, current = None, None
+    if ready is not None:
+        rows.append(_attempt(board, task_id, ready))
+    for row in rows:
+        r, c, s = row["ready_at"], row["claim_at"], row["process_start_at"]
+        unknown = []
+        for label, value in (("ready", r), ("claim", c), ("process_start", s)):
+            if not epoch(value):
+                unknown.append("missing_" + label + "_receipt")
+        skew = (not epoch(now) or any(epoch(v) and v > now for v in (r, c, s))
+                or (epoch(r) and epoch(c) and c < r) or (epoch(c) and epoch(s) and s < c))
+        if skew:
+            unknown.append("clock_inconsistent")
+        values = (_delta(r, c), _delta(c, s), _delta(r, s) if epoch(c) else None)
+        row.update(zip(METRICS, (None, None, None) if skew else values))
+        row.update(unknown=unknown, censored=s is None,
+                   process_start_semantics="owner_bound_receipt_not_progress")
+    return rows
+
+
+def summarize(rows):
+    """Retain raw samples; p50 needs two, p95 twenty (nearest-rank) samples."""
+    out = {"attempt_count": len(rows), "censored_count": sum(bool(r["censored"]) for r in rows),
+           "receipt_resolution_seconds": 1, "latency_semantics": "durable_receipt_delta_not_exact_launch"}
+    for key in METRICS:
+        values = sorted(r[key] for r in rows if r[key] is not None)
+        out[key] = {"samples": values, "sample_count": len(values),
+                    "p50": statistics.median(values) if len(values) >= 2 else None,
+                    "p95": values[math.ceil(.95 * len(values)) - 1] if len(values) >= 20 else None}
+    return out
+
+
+def _valid_interval(row, left, right):
+    at, until = row.get("observed_at"), row.get("valid_until")
+    return (epoch(at) and epoch(until) and at <= left and until >= right and until <= at + 180
+            and row.get("coverage_complete") is True
+            and type(row.get("eligible_backlog")) is int and row["eligible_backlog"] >= 0
+            and type(row.get("admissible_slots")) is int and row["admissible_slots"] >= 0
+            and isinstance(row.get("restrictions"), list))
+
+
+def idle_coverage(intervals):
+    """Integrate aligned complete observations, unioning shared host slots.
+
+    ``slot_scope`` identifies the actual shared slot pool, NOT the candidate or
+    board. Incomplete/conflicting evidence contributes unknown machine-seconds,
+    never fabricated unknown slot-seconds. Each input is an explicitly observed
+    interval; point snapshots must not be extended to fill observation gaps.
+    """
+    out = {"unexplained_idle_slot_seconds": 0, "unknown_seconds": 0,
+           "explained_seconds": 0, "observed_seconds": 0, "invalid_intervals": 0}
+    groups = {}
+    for row in intervals:
+        start, end = row.get("start"), row.get("end")
+        if (not epoch(start) or not epoch(end) or end <= start
+                or not row.get("machine") or not row.get("slot_scope")):
+            out["invalid_intervals"] += 1
+            continue
+        groups.setdefault((row["machine"], row["slot_scope"]), []).append(row)
+    for rows in groups.values():
+        points = sorted({r[k] for r in rows for k in ("start", "end")})
+        for left, right in pairwise(points):
+            active = [r for r in rows if r["start"] <= left and r["end"] >= right]
+            if not active:
+                # The bounding observation window contains a telemetry gap.
+                out["unknown_seconds"] += right - left
+                continue
+            width = right - left
+            out["observed_seconds"] += width
+            if (not all(_valid_interval(r, left, right) for r in active)
+                    or len({r.get("admissible_slots") for r in active}) != 1):
+                out["unknown_seconds"] += width
+            elif any(r["restrictions"] for r in active) or not any(r["eligible_backlog"] for r in active):
+                out["explained_seconds"] += width
+            else:
+                out["unexplained_idle_slot_seconds"] += width * active[0]["admissible_slots"]
+    return out
