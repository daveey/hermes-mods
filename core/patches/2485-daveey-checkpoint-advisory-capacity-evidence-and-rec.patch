new file mode 100644
index 0000000000..135e882550
--- /dev/null
+++ b/schemas/execution-observation-v1.schema.json
@@ -0,0 +1,55 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "urn:hermes:execution-observation:v1",
+  "title": "Source execution observation v1 (consumer unknown adapters may be incomplete)",
+  "type": "object",
+  "required": ["version", "identity", "owner", "state", "source", "source_revision", "evidence_refs", "observed_at", "valid_until"],
+  "properties": {
+    "version": {"const": 1},
+    "identity": {
+      "type": "object",
+      "required": ["gateway", "profile", "kind", "work_id"],
+      "properties": {
+        "gateway": {"type": "string", "minLength": 1},
+        "profile": {"type": "string", "minLength": 1},
+        "kind": {"type": "string", "minLength": 1},
+        "work_id": {"type": "string", "minLength": 1},
+        "board": {"type": "string", "minLength": 1},
+        "session": {"type": "string", "minLength": 1},
+        "lineage": {"type": "string", "minLength": 1},
+        "run_id": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]},
+        "generation": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]}
+      },
+      "anyOf": [{"required": ["run_id"]}, {"required": ["generation"]}],
+      "if": {"properties": {"kind": {"const": "card"}}},
+      "then": {"required": ["board"]},
+      "else": {"anyOf": [{"required": ["session"]}, {"required": ["lineage"]}]}
+    },
+    "owner": {"type": "object", "required": ["gateway", "profile"], "properties": {
+      "gateway": {"type": "string", "minLength": 1}, "profile": {"type": "string", "minLength": 1}
+    }},
+    "state": {"enum": ["running", "queued", "waiting", "needs_user", "done", "failed", "cancelled", "unknown"]},
+    "last_known_state": {"type": ["string", "null"]},
+    "source": {"type": "string", "minLength": 1},
+    "source_revision": {"type": "string", "minLength": 1},
+    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
+    "observed_at": {"$ref": "#/$defs/epoch"},
+    "valid_until": {"$ref": "#/$defs/epoch"},
+    "last_activity": {"anyOf": [{"$ref": "#/$defs/epoch"}, {"type": "null"}]},
+    "last_progress": {"anyOf": [{"$ref": "#/$defs/epoch"}, {"type": "null"}]},
+    "diagnostics": {"type": "array", "items": {
+      "type": "object", "required": ["code", "native_code", "phase", "evidence_ref"],
+      "properties": {
+        "code": {"enum": ["capacity.memory_pressure", "capacity.provider_limit", "capacity.placement", "capacity.dependency", "capacity.update_drain"]},
+        "native_code": {"type": "string", "minLength": 1},
+        "phase": {"enum": ["pre_claim", "post_claim", "post_start"]},
+        "evidence_ref": {"type": "string", "minLength": 1}
+      }
+    }},
+    "required_sources": {"type": "array", "items": {"type": "object", "required": ["observed_at", "valid_until"], "properties": {
+      "observed_at": {"$ref": "#/$defs/epoch"}, "valid_until": {"$ref": "#/$defs/epoch"}
+    }}}
+  },
+  "$defs": {"epoch": {"type": "number", "minimum": 0, "maximum": 8640000000000}},
+  "$comment": "Consumers also check valid_until >= observed_at, now >= observed_at, separate source TTL bounds and min(required_sources.valid_until)."
+}
diff --git a/tests/hermes_cli/test_execution_observations.py b/tests/hermes_cli/test_execution_observations.py
new file mode 100644
index 0000000000..75628c47af
--- /dev/null
+++ b/tests/hermes_cli/test_execution_observations.py
@@ -0,0 +1,117 @@
+"""Source-owned validity; no consumer read turns history into live execution."""
+from copy import deepcopy
+
+import pytest
+
+from hermes_cli.execution_observations import adapt, capacity_reason
+
+
+def observation():
+    return {
+        "version": 1,
+        "identity": {"gateway": "gateway-a", "profile": "default", "board": "sample",
+                     "kind": "card", "work_id": "task-a", "run_id": 7},
+        "owner": {"gateway": "gateway-a", "profile": "default"},
+        "state": "queued", "source": "dispatcher", "source_revision": "event:31",
+        "evidence_refs": ["event:31"], "observed_at": 1000, "valid_until": 1180,
+        "last_activity": 1000, "last_progress": None, "diagnostics": [],
+    }
+
+
+def test_current_preserves_source_and_separates_progress():
+    raw = observation()
+    before = deepcopy(raw)
+    out = adapt(raw, now=1100, source_class="sidebar")
+    assert out["state"] == "queued" and out["freshness"] == "current"
+    assert out["observed_at"] == 1000 and out["valid_until"] == 1180
+    assert out["age_seconds"] == 100
+    assert out["last_progress"] is None
+    assert raw == before
+
+
+@pytest.mark.parametrize("now,expected", [(1180, "stale"), (1200, "stale"), (999, "unknown")])
+def test_stale_and_clock_skew_never_mean_idle_or_failed(now, expected):
+    out = adapt(observation(), now=now, source_class="sidebar")
+    assert out["state"] == "unknown"
+    assert out["last_known_state"] == "queued"
+    assert out["freshness"] == expected
+    assert out["observed_at"] == 1000
+
+
+@pytest.mark.parametrize("field", ["identity", "source", "source_revision", "observed_at", "valid_until"])
+def test_missing_required_source_is_unknown_without_fabrication(field):
+    raw = observation()
+    del raw[field]
+    out = adapt(raw, now=1100, source_class="sidebar")
+    assert out["state"] == "unknown" and out["unknown_reason"]
+    assert out["observed_at"] == raw.get("observed_at")
+
+
+@pytest.mark.parametrize("value", [float("nan"), float("inf"), True, "1000", -1])
+def test_invalid_clock_is_unknown(value):
+    raw = observation()
+    raw["observed_at"] = value
+    assert adapt(raw, now=1100, source_class="sidebar")["state"] == "unknown"
+
+
+def test_board_and_attempt_identity_required_for_card():
+    for key in ("board", "run_id"):
+        raw = observation()
+        del raw["identity"][key]
+        out = adapt(raw, now=1100, source_class="sidebar")
+        assert out["state"] == "unknown"
+        assert key not in out["identity"]
+
+
+def test_generation_is_valid_without_invented_run():
+    raw = observation()
+    del raw["identity"]["run_id"]
+    raw["identity"]["generation"] = "ready-event:4"
+    out = adapt(raw, now=1100, source_class="sidebar")
+    assert out["state"] == "queued" and "run_id" not in out["identity"]
+
+
+def test_source_validity_is_minimum_and_upper_bounds_are_separate():
+    raw = observation()
+    raw["valid_until"] = 5000
+    assert adapt(raw, now=1200, source_class="sidebar")["state"] == "unknown"
+    imported = adapt(raw, now=1200, source_class="imported_owner")
+    assert imported["valid_until"] == 1600 and imported["state"] == "queued"
+    raw["required_sources"] = [{"observed_at": 990, "valid_until": 1050}]
+    assert adapt(raw, now=1100, source_class="imported_owner")["state"] == "unknown"
+
+
+def test_fetch_never_renews_ttl():
+    first = adapt(observation(), now=1100, source_class="sidebar")
+    second = adapt(first, now=1200, source_class="sidebar")
+    assert second["state"] == "unknown" and second["valid_until"] == 1180
+    assert second["last_known_state"] == "queued"
+
+
+def test_legacy_unknown_retains_human_request_and_delivery_receipt():
+    legacy = {"state": "running", "human_request": {"action": "answer"},
+              "completion_receipt": {"verified": True}}
+    out = adapt(legacy, now=1100, source_class="sidebar")
+    assert out["state"] == "unknown" and out["observed_at"] is None
+    assert out["human_request"] == legacy["human_request"]
+    assert out["completion_receipt"] == legacy["completion_receipt"]
+
+
+@pytest.mark.parametrize("code", ["memory_pressure", "provider_limit", "placement", "dependency", "update_drain"])
+def test_namespaced_concurrent_native_diagnostics(code):
+    reason = capacity_reason(code, native_code="native_hold", phase="pre_claim", evidence_ref="event:2")
+    assert reason == {"code": "capacity." + code, "native_code": "native_hold",
+                      "phase": "pre_claim", "evidence_ref": "event:2"}
+    raw = observation()
+    raw["diagnostics"] = [reason, capacity_reason("placement", native_code="missing_labels",
+                                                 phase="pre_claim", evidence_ref="event:3")]
+    assert adapt(raw, now=1100, source_class="sidebar")["diagnostics"] == raw["diagnostics"]
+
+
+def test_provider_after_start_stays_after_start():
+    reason = capacity_reason("provider_limit", native_code="rate_limited", phase="post_start", evidence_ref="event:8")
+    assert reason["phase"] == "post_start"
+
+
+def test_unknown_source_class_cannot_manufacture_validity():
+    assert adapt(observation(), now=1100, source_class="invented")["state"] == "unknown"
diff --git a/tests/hermes_cli/test_kanban_capacity_evidence.py b/tests/hermes_cli/test_kanban_capacity_evidence.py
new file mode 100644
index 0000000000..faa2ae74dd
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_capacity_evidence.py
@@ -0,0 +1,133 @@
+"""Capacity evidence is concurrent, durable, lifecycle fenced and advisory only."""
+from contextlib import closing
+from dataclasses import asdict
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as dispatch
+from hermes_cli import kanban_capacity_evidence as evidence
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    monkeypatch.delenv("HERMES_KANBAN_DB", raising=False)
+    monkeypatch.delenv("HERMES_KANBAN_BOARD", raising=False)
+    assert kb.kanban_db_path().is_relative_to(tmp_path)
+    with closing(kbc.connect()) as conn:
+        yield conn
+
+
+@pytest.mark.parametrize("field,value,code", [
+    ("memory_pressure", "critical", "capacity.memory_pressure"),
+    ("rate_limited", ["TASK"], "capacity.provider_limit"),
+    ("skipped_ineligible", [("TASK", "labels_mismatch")], "capacity.placement"),
+])
+def test_native_dispatch_result_persists_without_mutation(board, field, value, code):
+    tid = kb.create_task(board, title="one", assignee="alice")
+    if isinstance(value, list):
+        value = [tid if x == "TASK" else (tid, x[1]) for x in value]
+    result = dispatch.DispatchResult(**{field: value})
+    before = asdict(result)
+    evidence.record(board, result, board="sample", machine="machine-a", now=1000)
+    out = evidence.read(board, kb.get_task(board, tid), board="sample", now=1001)
+    assert code in [r["code"] for r in out["reasons"]]
+    assert asdict(result) == before
+    if field == "rate_limited":
+        assert out["reasons"][0]["phase"] == "post_claim"
+
+
+def test_multiple_reasons_dependency_and_update_drain(board):
+    parent = kb.create_task(board, title="parent", assignee="alice")
+    child = kb.create_task(board, title="child", assignee="alice", parents=[parent])
+    result = dispatch.DispatchResult(memory_pressure="critical")
+    evidence.record(board, result, board="sample", machine="machine-a", now=1000, update_drain=True)
+    out = evidence.read(board, kb.get_task(board, child), board="sample", now=1001)
+    assert {r["code"] for r in out["reasons"]} == {"capacity.dependency"}
+    assert {r["code"] for r in out["machine_reasons"]} == {
+        "capacity.memory_pressure", "capacity.update_drain"}
+    ready = evidence.read(board, kb.get_task(board, parent), board="sample", now=1001)
+    assert {r["code"] for r in ready["reasons"]} == {
+        "capacity.memory_pressure", "capacity.update_drain"}
+    assert out["eligible_backlog"] is False
+
+
+def test_read_does_not_renew_timestamp_or_create_table(board):
+    tid = kb.create_task(board, title="one", assignee="alice")
+    task = kb.get_task(board, tid)
+    assert evidence.read(board, task, board="sample", now=1000)["freshness"] == "unknown"
+    assert not board.execute("SELECT name FROM sqlite_master WHERE name='kanban_capacity_observation'").fetchall()
+    evidence.record(board, dispatch.DispatchResult(memory_pressure="critical"), board="sample", machine="m", now=1000)
+    current = evidence.read(board, task, board="sample", now=1001)
+    stale = evidence.read(board, task, board="sample", now=1180)
+    assert current["observed_at_ms"] == stale["observed_at_ms"] == 1000000
+    assert stale["freshness"] == "stale"
+    assert stale["eligible_backlog"] is None
+    assert stale["execution_observation"]["state"] == "unknown"
+
+
+def test_retry_or_board_mismatch_cannot_reuse_restrictions(board):
+    tid = kb.create_task(board, title="one", assignee="alice")
+    evidence.record(board, dispatch.DispatchResult(memory_pressure="critical"), board="sample", machine="m", now=1000)
+    assert evidence.read(board, kb.get_task(board, tid), board="other", now=1001)["freshness"] == "unknown"
+    kb.claim_task(board, tid)
+    out = evidence.read(board, kb.get_task(board, tid), board="sample", now=1001)
+    assert out["freshness"] == "unknown" and out["unknown_reason"] == "lifecycle_changed"
+
+
+def test_clock_skew_and_missing_admission_coverage_are_unknown(board):
+    tid = kb.create_task(board, title="one", assignee="alice")
+    evidence.record(board, dispatch.DispatchResult(), board="sample", machine="m", now=1000)
+    out = evidence.read(board, kb.get_task(board, tid), board="sample", now=999)
+    assert out["freshness"] == "unknown"
+    out = evidence.read(board, kb.get_task(board, tid), board="sample", now=1001)
+    assert out["admissible_slots"] is None and out["eligible_backlog"] is None
+    assert out["unknown_coverage"]
+
+
+def test_dry_or_skipped_tick_never_manufactures_evidence(board):
+    tid = kb.create_task(board, title="one", assignee="alice")
+    for result in [dispatch.DispatchResult(skipped_locked=True), dispatch.DispatchResult(skipped_owned=True)]:
+        assert evidence.record(board, result, board="sample", machine="m", now=1000) is False
+    assert evidence.record(board, dispatch.DispatchResult(), board="sample", machine="m", now=1000, dry_run=True) is False
+    assert evidence.read(board, kb.get_task(board, tid), board="sample", now=1001)["freshness"] == "unknown"
+
+
+@pytest.mark.parametrize("native,is_provider", [
+    ("subscription_quota_reset", True), ("rate_limit_cooldown", True),
+    ("infrastructure_cooldown", False), ("owner_restart_cooldown", False),
+])
+def test_native_provider_clocks_are_preclaim_and_deduplicated(board, native, is_provider):
+    tid = kb.create_task(board, title="clock", assignee="alice")
+    result = dispatch.DispatchResult(clock_held={tid: (native, 1100)}, respawn_guarded=[(tid, native)])
+    evidence.record(board, result, board="sample", machine="m", now=1000)
+    out = evidence.read(board, kb.get_task(board, tid), board="sample", now=1001)
+    assert len(out["reasons"]) == int(is_provider)
+    if is_provider:
+        assert out["reasons"][0]["native_code"] == native
+        assert out["reasons"][0]["phase"] == "pre_claim"
+
+
+def test_claim_does_not_prove_execution_or_inherit_preclaim_pressure(board):
+    tid = kb.create_task(board, title="claimed", assignee="alice")
+    kb.claim_task(board, tid)
+    evidence.record(board, dispatch.DispatchResult(memory_pressure="critical"),
+                    board="sample", machine="m", now=1000)
+    out = evidence.read(board, kb.get_task(board, tid), board="sample", now=1001)
+    assert out["reasons"] == []
+    assert out["execution_observation"]["state"] == "unknown"
+    assert out["execution_observation"]["last_progress"] is None
+
+
+def test_read_never_invents_generation_from_an_event_or_poll(board):
+    tid = kb.create_task(board, title="unclaimed", assignee="alice")
+    evidence.record(board, dispatch.DispatchResult(), board="sample", machine="m", now=1000)
+    out = evidence.read(board, kb.get_task(board, tid), board="sample", now=1001)
+    assert out["freshness"] == "current"
+    observation = out["execution_observation"]
+    assert "generation" not in observation["identity"]
+    assert "run_id" not in observation["identity"]
+    assert observation["state"] == "unknown"
