index 0000000000..dc6523731e
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_capacity_integration.py
@@ -0,0 +1,96 @@
+"""Actual dispatch/read seams, isolated four-card harness; no model calls."""
+from dataclasses import asdict
+
+from hermes_cli import kanban_capacity_evidence as evidence
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_dispatch as dispatch
+from hermes_cli import kanban_queue_position as queue
+from tests.hermes_cli import test_kanban_capacity_harness as harness
+
+capacity_board = harness.capacity_board
+
+
+def test_dispatch_publishes_pressure_without_changing_decision(capacity_board, all_assignees_spawnable, monkeypatch):
+    conn, ids, child = capacity_board
+    monkeypatch.setattr(dispatch, "_memory_pressure_level", lambda sample=None: "critical")
+    seen = []
+    result = dispatch.dispatch_once(conn, spawn_fn=lambda *a: seen.append(a),
+                                    max_in_progress=4, reconcile_orphans=False, board="sample")
+    assert seen == [] and result.memory_pressure == "critical"
+    out = evidence.read(conn, kb.get_task(conn, ids[0]), board="sample")
+    assert out["freshness"] == "current"
+    assert out["reasons"][0]["code"] == "capacity.memory_pressure"
+    assert kb.get_task(conn, child).status == "todo"
+
+
+def test_drain_is_explicit_not_inferred_from_zero_budget(capacity_board, all_assignees_spawnable, monkeypatch):
+    conn, ids, _ = capacity_board
+    monkeypatch.setattr(dispatch, "_memory_pressure_level", lambda sample=None: "ok")
+    dispatch.dispatch_once(conn, max_spawn=0, reconcile_orphans=False, board="sample",
+                           observation_update_drain=True)
+    out = evidence.read(conn, kb.get_task(conn, ids[0]), board="sample")
+    assert [r["code"] for r in out["reasons"]] == ["capacity.update_drain"]
+    dispatch.dispatch_once(conn, max_spawn=0, reconcile_orphans=False, board="sample")
+    assert evidence.read(conn, kb.get_task(conn, ids[0]), board="sample")["reasons"] == []
+
+
+def test_observer_exception_cannot_change_dispatch_return(capacity_board, monkeypatch):
+    conn, _, _ = capacity_board
+    expected = dispatch.DispatchResult(memory_pressure="critical")
+    monkeypatch.setattr(dispatch, "_dispatch_once_locked", lambda *a, **kw: expected)
+    monkeypatch.setattr(evidence, "record", lambda *a, **kw: (_ for _ in ()).throw(ValueError("fixture")))
+    result = dispatch.dispatch_once(conn, board="sample")
+    assert result is expected and asdict(result) == asdict(expected)
+
+
+def test_existing_queue_read_adds_optional_fields(capacity_board, monkeypatch):
+    conn, ids, _ = capacity_board
+    task = kb.get_task(conn, ids[0])
+    monkeypatch.setattr(queue, "_running_and_limit", lambda *a: (0, 4))
+    evidence.record(conn, dispatch.DispatchResult(memory_pressure="critical"), board="sample", machine="m")
+    fields = queue.detail_fields(conn, task, "sample")
+    place = fields["queue"]
+    assert fields["capacity_evidence"]["freshness"] == "current"
+    assert fields["execution_observations"][0]["state"] == "unknown"
+    assert "capacity.memory_pressure" in fields["capacity_note"]
+    assert "capacity_evidence" not in place
+    assert place["limit"] == 4 and place["running"] == 0
+
+
+def test_tool_cli_rest_read_actual_persisted_evidence(capacity_board, monkeypatch, capsys):
+    import json
+    from argparse import Namespace
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+    from hermes_cli import kanban as cli
+    from tools.kanban_show import show
+    from tests.plugins.test_kanban_foreign_card_api import _load_plugin_router
+
+    conn, ids, child = capacity_board
+    monkeypatch.setattr(queue, "_running_and_limit", lambda *a: (0, 4))
+    evidence.record(conn, dispatch.DispatchResult(memory_pressure="critical"), board="default", machine="m")
+    app = FastAPI()
+    app.include_router(_load_plugin_router(), prefix="/api/plugins/kanban")
+    with TestClient(app) as client:
+        for tid, reason in ((ids[0], "capacity.memory_pressure"), (child, "capacity.dependency")):
+            tool = json.loads(show({"task_id": tid}))
+            assert cli._cmd_show(Namespace(task_id=tid, json=True, board=None)) == 0
+            command = json.loads(capsys.readouterr().out)
+            response = client.get(f"/api/plugins/kanban/tasks/{tid}")
+            assert response.status_code == 200
+            for payload in (tool, command, response.json()):
+                assert reason in [r["code"] for r in payload["capacity_evidence"]["reasons"]]
+                assert payload["capacity_evidence"]["observed_at_ms"] == tool["capacity_evidence"]["observed_at_ms"]
+                if tid == child:
+                    assert "queue" not in payload
+                    assert payload["capacity_evidence"]["eligible_backlog"] is False
+    assert cli._cmd_show(Namespace(task_id=child, json=False, board=None)) == 0
+    assert "capacity.dependency" in capsys.readouterr().out
+
+
+def test_unmapped_restriction_remains_explicit(capacity_board):
+    conn, ids, _ = capacity_board
+    evidence.record(conn, dispatch.DispatchResult(at_capacity="max_in_progress"), board="default", machine="m")
+    out = queue.detail_fields(conn, kb.get_task(conn, ids[0]))
+    assert "at_capacity" in out["capacity_note"]
+    assert "no restriction observed" not in out["capacity_note"]
diff --git a/tests/hermes_cli/test_kanban_capacity_metrics.py b/tests/hermes_cli/test_kanban_capacity_metrics.py
new file mode 100644
index 0000000000..741cfe58d0
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_capacity_metrics.py
@@ -0,0 +1,112 @@
+"""Latency is receipt evidence, never readiness inference or liveness."""
+import pytest
+
+from hermes_cli.kanban_capacity_metrics import attempts, idle_coverage, summarize
+
+
+def event(n, kind, at, run=None, **payload):
+    return {"id": n, "kind": kind, "created_at": at, "run_id": run, "payload": payload}
+
+
+def history():
+    return [event(1, "promoted", 10), event(2, "claimed", 12, 7, lock="host:1"),
+            event(3, "spawned", 13, 7, pid=111),
+            event(4, "worker_bound", 15, 7, pid=222, claim_lock="host:1", started_at="birth|2")]
+
+
+def test_actual_interpreter_not_submitter_and_no_progress_inference():
+    out = attempts(history(), board="one", task_id="t", now=20)
+    assert len(out) == 1
+    assert out[0]["ready_to_claim_s"] == 2
+    assert out[0]["claim_to_process_start_s"] == 3
+    assert out[0]["ready_to_process_start_s"] == 5
+    assert out[0]["process_pid"] == 222
+    assert out[0]["last_progress"] is None
+
+
+def test_creation_time_and_claim_do_not_substitute_for_missing_receipts():
+    events = [event(1, "created", 1, status="ready"), event(2, "claimed", 12, 7, lock="h")]
+    out = attempts(events, board="one", task_id="t", now=20)[0]
+    assert out["ready_to_claim_s"] is None
+    assert out["claim_to_process_start_s"] is None
+    assert out["censored"] is True
+    assert "missing_ready_receipt" in out["unknown"]
+
+
+@pytest.mark.parametrize("change", ["wrong_run", "wrong_lock", "missing_birth", "skew"])
+def test_start_requires_matching_attempt_and_consistent_clock(change):
+    events = history()
+    if change == "wrong_run":
+        events[-1]["run_id"] = 8
+    elif change == "wrong_lock":
+        events[-1]["payload"]["claim_lock"] = "other"
+    elif change == "missing_birth":
+        events[-1]["payload"].pop("started_at")
+    else:
+        events[-1]["created_at"] = 11
+    out = attempts(events, board="one", task_id="t", now=20)[0]
+    assert out["claim_to_process_start_s"] is None
+    assert out["ready_to_process_start_s"] is None
+
+
+def test_retry_does_not_reuse_previous_ready_or_process_start():
+    events = history() + [event(5, "released", 16, 7, retry_status="ready"),
+                          event(6, "claimed", 18, 8, lock="h:2")]
+    out = attempts(events, board="one", task_id="t", now=20)
+    assert len(out) == 2
+    assert out[1]["ready_to_claim_s"] == 2
+    assert out[1]["process_pid"] is None
+    assert out[1]["censored"]
+
+
+def test_dependency_and_observation_activity_do_not_establish_ready_or_progress():
+    events = [event(1, "created", 1, status="todo"), event(2, "dependency_wait", 2),
+              event(3, "heartbeat", 3), event(4, "commented", 4)]
+    assert attempts(events, board="one", task_id="t", now=20) == []
+
+
+def test_summary_keeps_pending_and_small_sample_percentiles_unknown():
+    out = attempts(history(), board="one", task_id="t", now=20)
+    out += attempts([event(1, "promoted", 16)], board="two", task_id="t", now=20)
+    report = summarize(out)
+    assert report["attempt_count"] == 2
+    assert report["censored_count"] == 1
+    assert report["claim_to_process_start_s"]["sample_count"] == 1
+    assert report["claim_to_process_start_s"]["p50"] is None
+    assert report["claim_to_process_start_s"]["samples"] == [3]
+
+
+def interval(board="one", **overrides):
+    return {"machine": "m", "slot_scope": "host", "board": board,
+            "start": 10, "end": 20, "observed_at": 10, "valid_until": 20,
+            "eligible_backlog": 2, "admissible_slots": 3, "restrictions": [],
+            "coverage_complete": True, **overrides}
+
+
+def test_idle_shared_slots_never_sum_across_boards():
+    result = idle_coverage([interval(), interval("two")])
+    assert result["unexplained_idle_slot_seconds"] == 30
+    assert result["unknown_seconds"] == 0
+
+
+@pytest.mark.parametrize("overrides", [
+    {"observed_at": None}, {"valid_until": 15}, {"eligible_backlog": None},
+    {"admissible_slots": None}, {"coverage_complete": False}, {"observed_at": 11},
+])
+def test_missing_stale_skewed_telemetry_is_unknown_not_idle(overrides):
+    result = idle_coverage([interval(**overrides)])
+    assert result["unexplained_idle_slot_seconds"] == 0
+    assert result["unknown_seconds"] == 10
+
+
+def test_restrictions_and_no_backlog_are_not_unexplained_idle():
+    for sample in [interval(restrictions=["capacity.memory_pressure"]), interval(eligible_backlog=0)]:
+        result = idle_coverage([sample])
+        assert result["unexplained_idle_slot_seconds"] == 0
+        assert result["explained_seconds"] == 10
+
+
+def test_conflicting_shared_slot_readings_are_unknown():
+    result = idle_coverage([interval(), interval("two", admissible_slots=4)])
+    assert result["unknown_seconds"] == 10
+    assert result["unexplained_idle_slot_seconds"] == 0
