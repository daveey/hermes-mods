From 7422102ade2d3ce2081e0519f43499e57bd43be1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 09:28:30 +0000
Subject: [PATCH] test(update): select refusal run receipts independently of
 sidecars [daveey]

The ref-lock recovery PR writes ref_lock_alerts.json beside update run
archives. The refusal contract globbed every JSON except latest.json and
loaded the first entry, so directory ordering could select {entries: {}}
and raise KeyError outcome despite a correctly written refusal receipt.

Select update_*.json, matching the production run-archive namespace, and
require exactly one real receipt. Seed the sidecar and exercise both glob
orders deterministically. Keep outcome, stop reason, failed admission and
docker-pull detail assertions unchanged. No production behavior changes.

Proof: exact incident head da0536fd4531488e0e7e2a6bffa4990f2cab3ccc
failed both whole-file and isolated runs; diagnostic payload identified
the ref-lock ledger. Current main's test was identical. Controlled RED:
18 passed/1 failed (sidecar first); GREEN: 87 passed across 10 contract and
receipt files. Fixed test on incident head: 19 passed. Full scripts/check
--base origin/main passed. No sleeps, weakened assertions or retry changes.
---
 tests/hermes_cli/test_update_contract.py | 25 +++++++++++++++++++-----
 1 file changed, 20 insertions(+), 5 deletions(-)

diff --git a/tests/hermes_cli/test_update_contract.py b/tests/hermes_cli/test_update_contract.py
index b24bf2fd3cf942d287d332372c3d91944aad9273..92299c07538a221b4327c39c07e8d24f1623a2ae 100644
--- a/tests/hermes_cli/test_update_contract.py
+++ b/tests/hermes_cli/test_update_contract.py
@@ -152,11 +152,27 @@ def test_admission_nix_refuses(tmp_path, monkeypatch):
 # ---------------------------------------------------------------------------
 
 
-def test_refusal_receipt_written_as_refused(tmp_path, monkeypatch):
+@pytest.mark.parametrize("sidecar_first", [True, False])
+def test_refusal_receipt_written_as_refused(tmp_path, monkeypatch, sidecar_first):
     monkeypatch.setenv("HERMES_HOME", str(tmp_path))
     import hermes_cli.update_receipt as ur
 
-    monkeypatch.setattr(ur, "_receipt_dir", lambda: tmp_path / "receipts")
+    directory = tmp_path / "receipts"
+    directory.mkdir()
+    # Ref-lock alert bookkeeping shares the directory but is not an update receipt.
+    sidecar = directory / "ref_lock_alerts.json"
+    sidecar.write_text(json.dumps({"entries": {}}))
+    monkeypatch.setattr(ur, "_receipt_dir", lambda: directory)
+    original_glob = Path.glob
+
+    def ordered_glob(path, pattern, **kwargs):
+        paths = list(original_glob(path, pattern, **kwargs))
+        if path == directory:
+            paths.sort(key=lambda p: p == sidecar, reverse=sidecar_first)
+        return iter(paths)
+
+    # Directory enumeration order is unspecified; exercise either sidecar position.
+    monkeypatch.setattr(Path, "glob", ordered_glob)
 
     record_refusal_receipt(
         UpdateRefusal(
@@ -165,9 +181,8 @@ def test_refusal_receipt_written_as_refused(tmp_path, monkeypatch):
             update_command="docker pull nousresearch/hermes-agent:latest",
         )
     )
-    receipts = list((tmp_path / "receipts").glob("*.json"))
-    receipts = [p for p in receipts if p.name != "latest.json"]
-    assert receipts, "a refusal receipt must be written"
+    receipts = list(directory.glob("update_*.json"))
+    assert len(receipts) == 1, "exactly one refusal receipt must be written"
     data = json.loads(receipts[0].read_text())
     assert data["outcome"] == "refused"
     assert data["stop_reason"] == "image-marker"
