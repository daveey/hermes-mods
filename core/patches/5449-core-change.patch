From 5ab1e690384f1aea0dab784e7ca00bec8cd67eb8 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 08:10:08 +0000
Subject: [PATCH] fix(kanban): retain healthy concurrent probe identity within
 bounded admission [daveey]

Full consumer suite caught a correctness-preserving but noisy immediate fallback: concurrent healthy legacy probes no longer shared their observer. Allow at most 50ms for the probe lock; real held-lock regressions remain green and both DELETE/WAL concurrency controls pass. This bounds previously infinite contention without weakening content invalidation.
---
 hermes_cli/kanban_activity_revision.py | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_activity_revision.py b/hermes_cli/kanban_activity_revision.py
index b69e446e1a..20f2cb3097 100644
--- a/hermes_cli/kanban_activity_revision.py
+++ b/hermes_cli/kanban_activity_revision.py
@@ -292,8 +292,9 @@ def probe_lock(path: Path):
 
 def content_key(path: Path, tables: Iterable[str], open_ro: Callable) -> tuple:
     lock = probe_lock(path)
-    if not lock.acquire(blocking=False):
-        # Speculative keys must never queue behind another probe. Unknown keys
+    if not lock.acquire(timeout=0.05):
+        # Briefly serialize healthy probes so legacy data_version keys share one
+        # observer; never convoy indefinitely behind a slow reader. Unknown keys
         # are deliberately unequal, so they cannot certify a cached answer.
         return ("stat", file_stat(path), object())
     try:
