From 59abd5f8920afc513f799705d57fd7a312474615 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 06:50:08 +0000
Subject: [PATCH 1152/1157] fix(cli): an inherited kanban session label never
 becomes a chat's create source [daveey]

A process that inherited a worker's HERMES_SESSION_SOURCE=kanban sent source=kanban on
session.create, which build_policy refuses from a client (only dispatcher admission mints
kanban sessions), so every descendant `hermes chat -q` failed before sending: "Hermes couldn't
start the model connection: invalid_params" (example-hub 2026-10-30 05:44, card t_01a18b3d519d00c1).
Unless --source was explicit, such a chat is labelled oneshot (-q) or cli.

Tests: tests/hermes_cli/test_gateway_session_store.py (RED before, 52 passed).
---
 hermes_cli/gateway_session_store.py           | 11 ++++++--
 .../hermes_cli/test_gateway_session_store.py  | 27 +++++++++++++++++++
 2 files changed, 36 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/gateway_session_store.py b/hermes_cli/gateway_session_store.py
index ca7fa8b291a..ae5e82d172e 100644
--- a/hermes_cli/gateway_session_store.py
+++ b/hermes_cli/gateway_session_store.py
@@ -162,11 +162,18 @@ class GatewaySessionStore:
         """``session.create`` with the launch policy (and ``title``: the owner's resolve -> create ->
         title step); adopts and returns the new session id. ``record_cwd=False`` (``/new``,
         ``--create-if-missing``) leaves the row's cwd empty, as main's explicit creates did."""
-        from agent.session_source import CLI_FAMILY_SOURCES, create_surface, session_source_for
+        from agent.session_source import CLI_FAMILY_SOURCES, ONESHOT_SOURCE, create_surface, session_source_for
+        from gateway.session_context import get_session_env
         params = _creation_policy(launch or {})
         params["cwd"] = _launch_cwd()
         # Main's row label: ``cli``, ``oneshot`` for a finite -q/-Q run, or an explicit --source.
-        params["source"] = create_surface(session_source_for("cli"))
+        source = session_source_for("cli")
+        if source == "kanban" and get_session_env("HERMES_SESSION_SOURCE_EXPLICIT", "") != "1":
+            # [daveey] Only the gateway's dispatcher admission mints ``kanban`` sessions; build_policy
+            # refuses it from a client (invalid_params). An inherited worker label (a worker shell from
+            # older code, a job it started) made every descendant ``hermes chat`` fail before sending.
+            source = ONESHOT_SOURCE if get_session_env("HERMES_SINGLE_QUERY_SESSION", "") == "1" else "cli"
+        params["source"] = create_surface(source)
         # Main's row stamp (run_agent._launch_cwd_for_session): this process's cwd (``-w`` never
         # chdirs, so the repo root), only for a CLI-family label on a local terminal backend.
         local = (os.getenv("TERMINAL_ENV") or "local").strip().lower() in ("", "local")
diff --git a/tests/hermes_cli/test_gateway_session_store.py b/tests/hermes_cli/test_gateway_session_store.py
index e69eef585b2..334e7772975 100644
--- a/tests/hermes_cli/test_gateway_session_store.py
+++ b/tests/hermes_cli/test_gateway_session_store.py
@@ -889,3 +889,30 @@ def test_clear_banner_shows_the_new_gateway_sessions_tools_and_short_label(store
     assert banner["session_id"] == "ab12cd34"
     assert sorted(t["function"]["name"] for t in banner["tools"]) == ["mcp__zeta__ro_probe", "read_file"]
     assert banner["get_toolset_for_tool"]("mcp__zeta__ro_probe") == "mcp-zeta"
+
+
+def test_an_inherited_kanban_label_is_never_sent_as_the_create_source(store, monkeypatch):
+    """[daveey] ``kanban`` is minted only by the gateway's dispatcher admission; ``build_policy`` refuses it
+    from a client (``invalid_params (source)``). A process that inherited a worker's
+    ``HERMES_SESSION_SOURCE=kanban`` (a worker shell from older code, a nohup job it started) made every
+    ``hermes chat -q`` it ran fail "couldn't start the model connection: invalid_params" before sending
+    (hermes-hub, 2026-10-30 05:44, card t_01a18b3d519d00c1). That descendant chat is a CLI run."""
+    monkeypatch.delenv("HERMES_SESSION_SOURCE_EXPLICIT", raising=False)
+    monkeypatch.setenv("HERMES_SESSION_SOURCE", "kanban")
+    monkeypatch.setenv("HERMES_KANBAN_WORKER_TASK", "t_0123456789ab")
+    monkeypatch.setenv("HERMES_SINGLE_QUERY_SESSION", "1")
+    db, client = store
+    db.open_session(cli(), {})
+    assert client.calls[-1][1]["source"] == "oneshot"
+    monkeypatch.delenv("HERMES_SINGLE_QUERY_SESSION")
+    GatewaySessionStore(db.connection).open_session(cli(), {})
+    assert client.calls[-1][1]["source"] == "cli"
+
+
+def test_an_explicit_kanban_source_is_still_sent_for_the_gateway_to_refuse(store, monkeypatch):
+    """Control: ``--source kanban`` the user typed is not rewritten; the gateway names the refused field."""
+    monkeypatch.setenv("HERMES_SESSION_SOURCE_EXPLICIT", "1")
+    monkeypatch.setenv("HERMES_SESSION_SOURCE", "kanban")
+    db, client = store
+    db.open_session(cli(), {})
+    assert client.calls[-1][1]["source"] == "kanban"
