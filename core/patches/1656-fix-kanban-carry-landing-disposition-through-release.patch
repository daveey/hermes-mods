         if final := final_send_for_chat(payload, str(sub.get("chat_id") or "")):
-            return f"{prefix}Kanban {task_id} done — {title}\n{final}"
+            return f"{prefix}Kanban {task_id} done — {title}\n{final}{_kb_left_open(payload)}"
