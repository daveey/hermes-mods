From 17a2e742a452739251c9afd9434b5952cdf30d4a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 06:20:16 +0000
Subject: [PATCH] [daveey] tests: move placement ROUTE/decide helpers into
 tests/hermes_cli/_placement_helpers.py

test_kanban_placement_myapp_marker.py imported ROUTE and decide from the sibling test module
test_kanban_placement.py. Both now import them (and ALIVE/NOWHERE/SILENT, which decide uses) from a
shared helper module. No behaviour change; test_kanban_placement.py still exposes the names for its
other importers.
---
 tests/hermes_cli/_placement_helpers.py        | 24 +++++++++++++++++++
 tests/hermes_cli/test_kanban_placement.py     | 18 +-------------
 .../test_kanban_placement_myapp_marker.py  |  2 +-
 3 files changed, 26 insertions(+), 18 deletions(-)
 create mode 100644 tests/hermes_cli/_placement_helpers.py

diff --git a/tests/hermes_cli/_placement_helpers.py b/tests/hermes_cli/_placement_helpers.py
new file mode 100644
index 0000000000..9274544db4
--- /dev/null
+++ b/tests/hermes_cli/_placement_helpers.py
@@ -0,0 +1,24 @@
+"""Shared Kanban placement test helpers: the default route and ``decide`` with fake probes. [daveey]
+
+Imported by test_kanban_placement.py and its split-out sibling test files, so no test module
+depends on another test module's internals.
+"""
+from __future__ import annotations
+
+from hermes_cli import kanban_placement as kp
+
+ROUTE = {"route": {"macbook": "hub"}, "creator_session": {"hub": "20261023_052109_5b3dee"}}
+ALIVE = lambda target: None
+NOWHERE = lambda need: {"need": need, "local": "absent", "holders": [], "stale": []}
+# The target advertises nothing (an older hub client/core): profiles unknown, profile tools unpublished.
+SILENT = lambda target: {"profiles": None, "tools": None}
+
+
+def decide(args, **kw):
+    kw.setdefault("cfg", ROUTE)
+    kw.setdefault("self_gw", "macbook")
+    kw.setdefault("live", ALIVE)
+    kw.setdefault("locate", NOWHERE)
+    kw.setdefault("info", SILENT)
+    kw.setdefault("carries", False)  # a hermes-hub client without create-task --option (< 1.8.0)
+    return kp.decide(args, **kw)
diff --git a/tests/hermes_cli/test_kanban_placement.py b/tests/hermes_cli/test_kanban_placement.py
index 88fc86d088..d67566b658 100644
--- a/tests/hermes_cli/test_kanban_placement.py
+++ b/tests/hermes_cli/test_kanban_placement.py
@@ -18,23 +18,7 @@ import pytest
 
