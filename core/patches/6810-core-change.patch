Subject: [PATCH 6810] Aggregate-bus discovery and superseded-unit retirement deadlines

Public mirror of source commit 2e5d6937995e5f0de7c0b80f150a82e01916b92e.

---
diff --git a/tests/hermes_cli/test_kanban_aggregate_bus.py b/tests/hermes_cli/test_kanban_aggregate_bus.py
index 52075e6a35a8bfa696caad635750311a97bf321b..3a1a335beccbbed035ac3c7aa00b2b54976c824f 100644
--- a/tests/hermes_cli/test_kanban_aggregate_bus.py
+++ b/tests/hermes_cli/test_kanban_aggregate_bus.py
@@ -4,6 +4,7 @@
 from pathlib import Path
 import socket
 import sys
+from types import SimpleNamespace
 
 import pytest
 
@@ -100,7 +101,7 @@
     }
     actions[invalid]()
     report = fake_systemctl(tmp_path, monkeypatch, runtime)
-    monkeypatch.setattr(scope.time, 'sleep', lambda _: None)
+    monkeypatch.setattr(scope, 'time', SimpleNamespace(sleep=lambda _: None))
     with pytest.raises(pr.RestartSafeScopeUnavailable, match='aggregate'):
         scope.bounded_scope(['systemd-run', '--user', '--scope', '--', 'worker'])
     _, env = json.loads(report.read_text())
@@ -117,6 +118,9 @@
     run = scope.subprocess.run
 
     def record(*args, **kwargs):
+        # subprocess timeout polling uses the shared time module too.
+        import time
+        time.sleep(0)
         calls.append(kwargs['env'])
         return run(*args, **kwargs)
 
@@ -129,7 +133,7 @@
                 bus.bind(str(runtime / 'bus'))
             delays.append(delay)
 
-        monkeypatch.setattr(scope.time, 'sleep', appear)
+        monkeypatch.setattr(scope, 'time', SimpleNamespace(sleep=appear))
         scope.configure_pool()
     assert delays == [1]
     assert len(calls) == 2
