From aab7a2402651ceff8ef3f9acff4dcca689330800 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 03:33:17 -0700
Subject: [PATCH] test(desktop): transform sync-handoff's store graph in
 beforeAll, not the first test

The first test paid the cold transform of ten store modules inside its 15s
testTimeout. Alone it takes 1.2s; in CI's "Run all workspace checks" it timed
out twice (ec2-gwgen-1, then a fresh tfgar-hub VM), because that step runs up
to 10 checks at once and each sizes its worker pool to every core. Warming the
graph under hookTimeout (30s, set for exactly this cold-import cost) leaves the
test with only module re-evaluation: 88ms locally.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../lib/ui-preferences/sync-handoff.test.ts   | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/lib/ui-preferences/sync-handoff.test.ts b/apps/desktop/src/lib/ui-preferences/sync-handoff.test.ts
index 16fd764f2e1..3e857e39faf 100644
--- a/apps/desktop/src/lib/ui-preferences/sync-handoff.test.ts
+++ b/apps/desktop/src/lib/ui-preferences/sync-handoff.test.ts
@@ -2,7 +2,7 @@ import fs from 'node:fs'
 import os from 'node:os'
 import path from 'node:path'
 
-import { afterEach, expect, it, vi } from 'vitest'
+import { afterEach, beforeAll, expect, it, vi } from 'vitest'
 
 import { parseUiPreferencesWrite, readUiPreferences, writeUiPreferences } from '../../../electron/ui-preferences'
 
@@ -111,6 +111,23 @@ const outboxes = () =>
     key.startsWith(OUTBOX_PREFIX)
   )
 
+// Transform the store graph once, under hookTimeout: each pageLoad re-evaluates it after
+// vi.resetModules(), and the first test paying the cold transform inside its own 15s budget
+// timed out when CI ran every workspace check at once (1.2s alone, >15s there).
+beforeAll(async () => {
+  await import('./sync')
+  await import('@/lib/storage')
+  await import('@/store/favorite-models')
+
+  for (const load of LOAD_WRITERS) {
+    await load()
+  }
+
+  vi.resetModules()
+  window.localStorage.clear()
+  window.sessionStorage.clear()
+})
+
 afterEach(() => {
   closeTabs()
   vi.useRealTimers()
-- 
