+        assert result == 'pending'
+        assert [tuple(r) for r in c.execute('SELECT * FROM task_events WHERE task_id=?', ('t_A',))] == before
+        assert reviewer.state(c, 't_A', ep) == reviewer.STARTED
+    else:
+        assert result in ('settled', 'escalated')
