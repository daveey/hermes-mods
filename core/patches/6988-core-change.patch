diff --git a/tests/hermes_cli/test_home_shared_consumer_custody.py b/tests/hermes_cli/test_home_shared_consumer_custody.py
new file mode 100644
index 0000000000000000000000000000000000000000..964c1666e42a4f78b2ee790282f1c729fe299e42
