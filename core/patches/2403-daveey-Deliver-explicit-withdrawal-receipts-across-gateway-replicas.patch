diff --git a/hermes_cli/kanban_withdrawal_notice.py b/hermes_cli/kanban_withdrawal_notice.py
new file mode 100644
index 00000000000..7471ab0127b
--- /dev/null
+++ b/hermes_cli/kanban_withdrawal_notice.py
@@ -0,0 +1,38 @@
+"""Explicit, content-free owner withdrawal receipts for remote transport."""
+from __future__ import annotations
+
+import json
+import math
+
+
+def publish(conn, task: dict) -> dict | None:
+    """Read inside the collector snapshot; never infer withdrawal from status."""
+    if task.get("status") != "archived":
+        return None
+    row = conn.execute(
+        "SELECT id,created_at,payload FROM task_events WHERE task_id=? "
+        "AND kind='request_withdrawn' ORDER BY id DESC LIMIT 1", (task["id"],)).fetchone()
+    if row is None:
+        return None
+    try:
+        payload = json.loads(row[2] or "{}")
+    except (TypeError, ValueError):
+        return None
+    if (not isinstance(payload, dict) or type(payload.get("notice_version")) is not int
+            or payload["notice_version"] != 1):
+        return None
+    return {"event_id": row[0], "kind": "request_withdrawn", "created_at": row[1]}
+
+
+def envelope(task: dict) -> dict | None:
+    """Fail closed for malformed/other-state envelopes at the replica boundary."""
+    notice = task.get("withdrawal_notice")
+    if task.get("status") != "archived" or not isinstance(notice, dict):
+        return None
+    if (set(notice) != {"event_id", "kind", "created_at"}
+            or notice.get("kind") != "request_withdrawn"
+            or type(notice.get("event_id")) is not int or notice["event_id"] <= 0
+            or type(notice.get("created_at")) not in (int, float)
+            or not math.isfinite(notice["created_at"]) or notice["created_at"] <= 0):
+        return None
+    return notice
diff --git a/hermes_cli/kanban_withdrawal_recipients.py b/hermes_cli/kanban_withdrawal_recipients.py
new file mode 100644
index 00000000000..3a88d98ad49
--- /dev/null
+++ b/hermes_cli/kanban_withdrawal_recipients.py
@@ -0,0 +1,44 @@
+"""Archive-time remote receipt custody, independent of later link cleanup."""
+from __future__ import annotations
+
+import json
+
+
+def snapshot(conn, task_id: str) -> list[dict]:
+    """Capture identities only, inside the archive write transaction."""
+    destinations: set[tuple[str, str, str]] = set()
+    released: set[tuple[str, str, str]] = set()
+    tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
+    if "task_chat_links" in tables:
+        for gw, profile, session, release in conn.execute(
+                "SELECT chat_gateway,chat_profile,chat_session,released FROM task_chat_links WHERE task_id=?",
+                (task_id,)):
+            key = (gw, profile or "default", session)
+            (released if release else destinations).add(key)
+    if "kanban_notify_subs" in tables:
+        for (chat,) in conn.execute(
+                "SELECT chat_id FROM kanban_notify_subs WHERE task_id=? AND platform='hub'", (task_id,)):
+            parts = str(chat).split("/", 2)
+            if len(parts) == 3 and all(parts):
+                destinations.add((parts[0], parts[1], parts[2]))
+    if "origin_creation_intents" in tables:
+        for (raw,) in conn.execute("SELECT binding_json FROM origin_creation_intents WHERE task_id=?", (task_id,)):
+            try:
+                binding = json.loads(raw)
+            except (TypeError, ValueError):
+                continue
+            origin = binding.get("origin") if isinstance(binding, dict) else None
+            if not isinstance(origin, dict):
+                continue
+            gw, profile, session = (origin.get(field) for field in ("gateway", "profile", "session"))
+            if all(isinstance(value, str) and value for value in (gw, profile, session)):
+                destinations.add((gw, profile, session))
+    return [dict(gw=gw, profile=profile, session=session, rel="shepherd")
+            for gw, profile, session in sorted(destinations - released)]
+
+
+def published(conn, event_id: int) -> list[dict] | None:
+    """No fallback to current bindings: their custody may have changed."""
+    row = conn.execute("SELECT payload FROM task_events WHERE id=?", (event_id,)).fetchone()
+    payload = json.loads(row[0])
+    return payload.get("recipients")
diff --git a/tests/tui_gateway/test_remote_withdrawal_guards.py b/tests/tui_gateway/test_remote_withdrawal_guards.py
