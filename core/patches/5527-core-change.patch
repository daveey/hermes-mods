From a4dc297f009b691ffaf4514e92464075d94a9df5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 21 Nov 2026 17:30:58 +0000
Subject: [PATCH] test(worker): route shared owner fixtures through read RPC
 [daveey]

---
 tests/hermes_state/conftest.py                      | 5 +++--
 tests/hermes_state/test_runtime_worker_lifecycle.py | 3 ++-
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/tests/hermes_state/conftest.py b/tests/hermes_state/conftest.py
index a4aed4e93e..2dbd775a27 100644
--- a/tests/hermes_state/conftest.py
+++ b/tests/hermes_state/conftest.py
@@ -21,7 +21,8 @@ def worker(tmp_path):
     # Imported here, not at module level: this conftest loads for every hermes_state test file.
     from agent.runtime_session_store import RuntimeSessionStore
     from hermes_state import SessionDB
-    from hermes_state_runtime import begin_runtime_epoch, mutate_worker_execution, register_worker_execution
+    from hermes_state_runtime import begin_runtime_epoch, register_worker_execution
+    from tests.worker_store_rpc import worker_store_rpc
 
     db = SessionDB(tmp_path / 'state.db')
     db.create_session('owned', 'cli', system_prompt='prefix')
@@ -29,7 +30,7 @@ def worker(tmp_path):
     epoch = begin_runtime_epoch(db, instance_id='fixture')
     scope = dict(epoch=epoch, execution_id='worker', session_id='owned', generation=0)
     register_worker_execution(db, **scope, kind='compute', adoption_secret='secret')
-    store = RuntimeSessionStore(lambda method, **p: mutate_worker_execution(db, **p), scope, tmp_path / 'outbox')
+    store = RuntimeSessionStore(lambda method, **p: worker_store_rpc(db, method, **p), scope, tmp_path / 'outbox')
     yield db, store
     store.failure = None
     store.journal['pending'] = []
diff --git a/tests/hermes_state/test_runtime_worker_lifecycle.py b/tests/hermes_state/test_runtime_worker_lifecycle.py
index e31c45fb37..d21d74485f 100644
--- a/tests/hermes_state/test_runtime_worker_lifecycle.py
+++ b/tests/hermes_state/test_runtime_worker_lifecycle.py
@@ -15,7 +15,8 @@ def setup_store(tmp_path):
     epoch = begin_runtime_epoch(db, instance_id='fixture')
     scope = dict(epoch=epoch, execution_id='worker', session_id='owned', generation=0)
     register_worker_execution(db, **scope, kind='compute', adoption_secret='private')
-    store = RuntimeSessionStore(lambda method, **p: mutate_worker_execution(db, **p), scope, tmp_path / 'outbox')
+    from tests.worker_store_rpc import worker_store_rpc
+    store = RuntimeSessionStore(lambda method, **p: worker_store_rpc(db, method, **p), scope, tmp_path / 'outbox')
     return db, store, scope
 
 
-- 
2.43.0

