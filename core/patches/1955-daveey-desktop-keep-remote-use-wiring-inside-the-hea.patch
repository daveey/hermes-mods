From c1d970e4e7dcf654ee2d1cd95b9da468d89a13f4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 23:54:25 +0000
Subject: [PATCH] [daveey] desktop: keep remote-use wiring inside the health
 caps (move isStalledDialError to gateway-dial-failures)

---
 apps/desktop/electron/main.ts                 |  8 ++-----
 .../electron/remote-warm-dispatch.test.ts     |  2 +-
 apps/desktop/electron/remote-warm-set.ts      |  2 +-
 apps/desktop/electron/remote-warm-use.test.ts |  5 ++--
 apps/desktop/src/store/gateway.ts             | 24 ++++---------------
 apps/desktop/src/store/remote-use.ts          | 12 ++++++++++
 6 files changed, 24 insertions(+), 29 deletions(-)

diff --git a/apps/desktop/electron/main.ts b/apps/desktop/electron/main.ts
index 6e99a624f82..3c2a925df7c 100644
--- a/apps/desktop/electron/main.ts
+++ b/apps/desktop/electron/main.ts
@@ -10670,10 +10670,7 @@ async function ensureRegistryBackend(
     throw new Error(`Profile '${profileKey}' does not exist.`)
   }
 
-  // Only a dial made for a user action counts as use (prewarm recent set + 30-min hold); see registryDialCountsAsUse.
-  if (source.kind === 'ssh') {
-    remoteWarmSet.noteDial(id, profileKey, opts)
-  }
+  remoteWarmSet.noteDial(id, profileKey, opts) // counts as use only for a user-action dial (registryDialCountsAsUse)
 
   let resolvedRegistrySshConfig
   let registryEffectiveFingerprintPromise: null | Promise<string> = null
@@ -14145,8 +14142,7 @@ async function connectDesktopProfileRoute(route: DesktopProfileRoute, sender?: E
 // canonical gateway when the v1 global mode is remote (the registry 'local'
 // entry always means this machine) unless the profile is remote-only.
 // A renderer user action (open, new chat, send) on a registry route: the only renderer signal that counts as use.
-ipcMain.handle('hermes:remote:note-use', (_event, payload) => remoteWarmSet.noteUse(payload?.connectionId, payload?.profile))
-
+ipcMain.handle('hermes:remote:note-use', (_e, p) => remoteWarmSet.noteUse(p?.connectionId, p?.profile))
 ipcMain.handle('hermes:connection:for', async (event, payload) => {
   const { connectionId, profile } = payload && typeof payload === 'object' ? (payload as any) : ({} as any)
   const registry = readDesktopConnectionsRegistry()
diff --git a/apps/desktop/electron/remote-warm-dispatch.test.ts b/apps/desktop/electron/remote-warm-dispatch.test.ts
index 5fec2213430..4e690e1e520 100644
--- a/apps/desktop/electron/remote-warm-dispatch.test.ts
+++ b/apps/desktop/electron/remote-warm-dispatch.test.ts
@@ -274,7 +274,7 @@ describe('main.ts wiring', () => {
   it('records a named profile only for a dial flagged as use (never a sweep, prewarm or passive call)', () => {
     // A plain non-passive dial used to count, so a post-reconnect sweep stamped every listed profile
     // (remote-warm-use.test.ts). The gate lives in remote-warm-set.ts noteDial/registryDialCountsAsUse.
-    expect(main).toMatch(/if \(source\.kind === 'ssh'\) \{\n\s+remoteWarmSet\.noteDial\(id, profileKey, opts\)/)
+    expect(main).toContain('  remoteWarmSet.noteDial(id, profileKey, opts)')
     expect(warmSet).toMatch(/return opts\.use === true && !opts\.passive && !opts\.forceProbe/)
   })
 
diff --git a/apps/desktop/electron/remote-warm-set.ts b/apps/desktop/electron/remote-warm-set.ts
index 85a807a2f2b..9eb5c6b99f9 100644
--- a/apps/desktop/electron/remote-warm-set.ts
+++ b/apps/desktop/electron/remote-warm-set.ts
@@ -56,7 +56,7 @@ export function createRemoteWarmSet(deps: RemoteWarmSetDeps) {
     return true
   }
 
-  // ensureRegistryBackend's call for every SSH dial: stamps only when the dial was made for a user action.
+  // ensureRegistryBackend's call for every dial: stamps only an SSH dial made for a user action.
   const noteDial = (connectionId: unknown, profile: unknown, opts: RegistryDialUseOpts = {}): boolean =>
     registryDialCountsAsUse(opts) && noteUse(connectionId, profile)
 
diff --git a/apps/desktop/electron/remote-warm-use.test.ts b/apps/desktop/electron/remote-warm-use.test.ts
index c9c5e7c9375..c0326e8f3c0 100644
--- a/apps/desktop/electron/remote-warm-use.test.ts
+++ b/apps/desktop/electron/remote-warm-use.test.ts
@@ -87,6 +87,7 @@ describe('remote warm set: what counts as use', () => {
     const before = stateBytes()
 
     expect(set.noteUse('local', 'research')).toBe(false)
+    expect(set.noteDial('local', 'research', { use: true })).toBe(false)
     expect(set.noteUse('nope', 'research')).toBe(false)
     expect(set.noteUse('hermes-hub', 'default@hermes-hub')).toBe(false)
     expect(set.noteUse('', 'research')).toBe(false)
@@ -114,8 +115,8 @@ describe('main.ts wiring', () => {
   })
 
   it('the renderer note-use door is wired to the warm set', () => {
-    expect(main).toMatch(
-      /ipcMain\.handle\('hermes:remote:note-use',[^\n]*remoteWarmSet\.noteUse\(payload\?\.connectionId, payload\?\.profile\)/
+    expect(main).toContain(
+      "ipcMain.handle('hermes:remote:note-use', (_e, p) => remoteWarmSet.noteUse(p?.connectionId, p?.profile))"
     )
   })
 
diff --git a/apps/desktop/src/store/gateway.ts b/apps/desktop/src/store/gateway.ts
index 602cfebe130..6456aefea23 100644
--- a/apps/desktop/src/store/gateway.ts
+++ b/apps/desktop/src/store/gateway.ts
@@ -42,7 +42,7 @@ import type { Secondary } from '@/store/gateway-socket-entry'
 import { notifyError, RECOVERY_ACTIONS } from '@/store/notifications'
 import { markNativeNotifyBaseline } from '@/store/notify-baseline'
 import { requestAfterPrimaryRecovery } from '@/store/primary-gateway-recovery'
-import { noteRemoteUse } from '@/store/remote-use'
+import { noteForegroundUse, noteRemoteUse } from '@/store/remote-use'
 import { setConnection, setGatewayState } from '@/store/session'
 import { stampSecondaryProfileOwner } from '@/store/session-event-provenance'
 export { useGatewayActivationEpoch } from '@/store/gateway-activation-epoch'
@@ -66,15 +66,6 @@ const normKey = (profile: string | null | undefined): string => (profile ?? '').
 // distinguishable from ambient hydration at the call site.
 export type SpawnPriority = 'foreground' | 'background'
 
-// [daveey] 'foreground' marks a user gesture (open, new chat, Bot Chat open): that, not the dial it may cause, is
-// what counts as use of a remote profile (store/remote-use). Background reads and reconnect sweeps never count.
-// A null connection id is a plain profile route on the window's own source: a use of the primary's connection.
-function noteForegroundUse(connectionId: null | string, profile: string, spawnPriority: SpawnPriority): void {
-  if (spawnPriority === 'foreground') {
-    noteRemoteUse(connectionId ?? primaryConnectionId(), normKey(profile))
-  }
-}
-
 // Read connection state through a call so TS control-flow analysis doesn't
 // narrow the getter to a constant across guards (it genuinely changes).
 const isOpen = (gateway: HermesGateway | null): boolean => gateway?.connectionState === 'open'
@@ -1173,8 +1164,7 @@ export async function requestGatewayForAgent<T>(
 ): Promise<T> {
   const key = normKey(profile)
   const scope = registryBackendScopeKey(connectionId, key)
-
-  noteForegroundUse(connectionId, key, spawnPriority)
+  noteForegroundUse(connectionId ?? primaryConnectionId(), key, spawnPriority)
 
   if (scope === key) {
     return requestGatewayForProfile<T>(key, method, params, timeoutMs, signal, { spawnPriority })
@@ -1406,8 +1396,7 @@ export async function retainGatewayForAgent(
 ): Promise<() => void> {
   const key = normKey(profile)
   const scope = registryBackendScopeKey(connectionId, key)
-
-  noteForegroundUse(connectionId, key, spawnPriority)
+  noteForegroundUse(connectionId ?? primaryConnectionId(), key, spawnPriority)
 
   if (scope === key) {
     // Plain-profile route: gatewayForProfile's request lease IS the retain —
@@ -1529,9 +1518,7 @@ export async function retainGatewayForSessionTurn(
   profile: string,
   sessionId: string
 ): Promise<() => void> {
-  // Only a prompt.submit reaches here (session-request-router): the user's send counts as use of the route. A
-  // send on the window's own gateway arrives with a null connection id; it is a use of the primary's route.
-  noteRemoteUse(connectionId ?? primaryConnectionId(), normKey(profile))
+  noteRemoteUse(connectionId ?? primaryConnectionId(), normKey(profile)) // a prompt.submit: the user's send is use
 
   // Primary events do not flow through a Secondary's terminal-event listener.
   // Registering a no-op lease here would leave a phantom key that can suppress
@@ -1683,8 +1670,7 @@ export async function openGatewayForAgent(
   }: { activationLease?: boolean; spawnPriority?: SpawnPriority } = {}
 ): Promise<void> {
   const scope = registryBackendScopeKey(connectionId, profile)
-
-  noteForegroundUse(connectionId, profile, spawnPriority)
+  noteForegroundUse(connectionId ?? primaryConnectionId(), profile, spawnPriority)
 
   if (scope === normKey(profile) || isPrimaryRegistryRoute(connectionId, profile)) {
     return openGatewayForProfile(profile, { spawnPriority })
diff --git a/apps/desktop/src/store/remote-use.ts b/apps/desktop/src/store/remote-use.ts
index 7c0bdcd64d2..093f3bc6a08 100644
--- a/apps/desktop/src/store/remote-use.ts
+++ b/apps/desktop/src/store/remote-use.ts
@@ -38,6 +38,18 @@ export function noteRemoteUse(connectionId: null | string | undefined, profile:
   }
 }
 
+/** A 'foreground' spawn priority marks a user gesture (open, new chat, Bot Chat open): that, not the dial it may
+ * cause, is use. Callers resolve a plain profile route (null connection) to the window primary's connection. */
+export function noteForegroundUse(
+  connectionId: null | string | undefined,
+  profile: null | string | undefined,
+  spawnPriority: string
+): void {
+  if (spawnPriority === 'foreground') {
+    noteRemoteUse(connectionId, profile)
+  }
+}
+
 export function _resetRemoteUseForTests(): void {
   lastNoted.clear()
 }
