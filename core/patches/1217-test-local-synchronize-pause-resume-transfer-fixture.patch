+
 
 @pytest.fixture
 def client(tmp_path, monkeypatch):
@@ -557,6 +559,46 @@ def _pin_budget(monkeypatch):
                         lambda **kw: budget)
 
 
+@pytest.fixture
+def pause_at_progress(monkeypatch):
+    """Hold each initial range reader after its first real write until pause.
+
+    A server delay is only a scheduling window that a descheduled test can
+    miss. Holding the coordinator's progress hook alone isn't enough either:
+    range workers would finish every byte, making resume coverage vacuous.
+    """
+    import threading
+
+    from pm import downloader
+
+    real_read = downloader.Download._read_range
+    lock = threading.Lock()
+    first = []
+    monkeypatch.setattr(downloader, "_CHUNK", 128 * 1024)
+
+    def read(self, source, remote, part, start, end, stop, record):
+        with lock:
+            if not first:
+                first.append(self)
+            initial = self is first[0]
+
+        def gated(start, position):
+            record(start, position)
+            # record has released the downloader lock; the coordinator can
+            # publish progress and the route can set this same pause Event.
+            if initial:
+                assert self._paused.wait(60), "test never requested a mid-transfer pause"
+
+        return real_read(self, source, remote, part, start, end, stop, gated)
+
+    monkeypatch.setattr(downloader.Download, "_read_range", read)
+    try:
+        yield
+    finally:
+        for download in first:
+            download.pause()
+
+
 def _serve_plan(monkeypatch, dl_server, tmp_partials, bodies):
     """Point the download plan at the real loopback range server: one
     served body per plan file, dests under the temp models dir, partials
@@ -567,7 +609,7 @@ def _serve_plan(monkeypatch, dl_server, tmp_partials, bodies):
     from hermes_cli.web_routers import local_models as lm
 
     RangeHandler.chunk = 128 * 1024
-    RangeHandler.slow_per_chunk = 0.2
