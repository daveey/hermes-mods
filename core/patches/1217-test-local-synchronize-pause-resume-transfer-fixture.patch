@@ -582,10 +624,10 @@ def _serve_plan(monkeypatch, dl_server, tmp_partials, bodies):
     return plan
 
 
-def _poll_job(client, job_id, deadline_s=15, until=("paused", "done", "error")):
-    deadline = time.time() + deadline_s
+def _poll_job(client, job_id, deadline_s=60, until=("paused", "done", "error")):
+    deadline = time.monotonic() + deadline_s
     status = None
-    while time.time() < deadline:
+    while time.monotonic() < deadline:
