From 6b554713f2c0af4948e46799230bacc7f49c290b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 06:06:11 +0000
Subject: [PATCH] [daveey] preserve lexical redirection metadata after
 substitution tokenizer rebase

Keep main lexical ShellWord metadata through the extracted token walker, sharing the redirection pattern without a circular import. Proof: 51 lifecycle suites 9286 passed; six remaining importers 446 passed; pinned full corpus 30852 cases, zero violations and false refusals. Removing token metadata is killed by quoted-redirection regressions.
---
 cron/lifecycle_guard.py        | 5 +----
 cron/lifecycle_guard_tokens.py | 7 ++++---
 cron/lifecycle_guard_words.py  | 4 ++++
 3 files changed, 9 insertions(+), 7 deletions(-)

diff --git a/cron/lifecycle_guard.py b/cron/lifecycle_guard.py
index 9c6e0b2c6e72b166ba99a6dfa3e6f1c4b2d31f94..7f0d6ea9c62192b3d9342c92b9a5bad40f8c08c1 100644
--- a/cron/lifecycle_guard.py
+++ b/cron/lifecycle_guard.py
@@ -23,6 +23,7 @@ from cron.lifecycle_guard_aliases import _may_define_alias, _session_aliases_sha
 from cron.lifecycle_guard_groups import CONTROL_CHARS as _CONTROL_CHARS
 from cron.lifecycle_guard_groups import (
     heredoc_scripts, iter_script_segment_contexts, join_continued_lines)
+from cron.lifecycle_guard_words import REDIRECTION as _REDIRECTION
 from cron.lifecycle_guard_words import redirection_parts, tokenize_redirections
 from cron.lifecycle_guard_lines import join_line_continuations
 # Lines a printer may print, walked as the sink's command (moved out for FILE_LINES).
@@ -371,10 +372,6 @@ _ENV_ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
 # Python program runners whose file operand (or stdin) is scanned as Python source.
 _PYTHON_RUNNER_RE = re.compile(r"^(?:pythonw?|pypy)(?:\d+(?:\.\d+)*)?(?:\.exe)?$|^py(?:\.exe)?$")
 _PYTHON_SOURCE_SUFFIXES = (".py", ".pyw")
-# A redirection word: optional fd or `{NAME}` (NAME may be an array element, `{a[1]}`),
-# operator, optional glued target (`<f`, `0<f`, `2>>log`, `{fd}>&2`, `{a[1]}>/dev/null`, `&>f`).
-_REDIRECTION = re.compile(
-    r"^(\d*|\{[A-Za-z_][A-Za-z0-9_]*(?:\[.+?\])?\})(<<<|<<-|<<|<>|<&|>&|>>|>\||&>>|&>|<|>)(.*)$", re.DOTALL)
 
 # Bound the walk: a pathological token run must not spin here.
 _MAX_PREFIX_PEELS = 8
diff --git a/cron/lifecycle_guard_tokens.py b/cron/lifecycle_guard_tokens.py
index e7b4424cd22ec4d427a281ab0e7a11be7982d13e..990d306e4c83691e4e9003cea7ef209ea5670d16 100644
--- a/cron/lifecycle_guard_tokens.py
+++ b/cron/lifecycle_guard_tokens.py
@@ -5,9 +5,10 @@ import shlex
 from collections.abc import Iterator
 
 from cron.lifecycle_guard_groups import (
-    protect_redirection_ampersands, restore_redirection_ampersands, split_glued_redirections,
+    protect_redirection_ampersands, restore_redirection_ampersands,
 )
 from cron.lifecycle_guard_lines import _split_logical_lines, strip_shell_comments
+from cron.lifecycle_guard_words import REDIRECTION, tokenize_redirections
 from cron.lifecycle_guard_substitutions import (
     MAX_SUBSTITUTION_DEPTH, SubstitutionNestingLimit, normalize_ansi_c_quotes, separate_substitutions,
 )
@@ -58,11 +59,11 @@ def _iter_raw_token_lists(command: str) -> Iterator[list[str]]:
     """Preserve the original logical/physical-line fallback without rewriting."""
     for line in _split_logical_lines(command):
         try:
-            tokens = _shlex_tokens(split_glued_redirections(line))
+            tokens = tokenize_redirections(line, _shlex_tokens, REDIRECTION)
         except ValueError:
             for physical_line in line.splitlines():
                 try:
-                    yield _shlex_tokens(split_glued_redirections(physical_line))
+                    yield tokenize_redirections(physical_line, _shlex_tokens, REDIRECTION)
                 except ValueError:
                     continue
             continue
diff --git a/cron/lifecycle_guard_words.py b/cron/lifecycle_guard_words.py
index 0b267c777bc2587f2df5de6026e93c136573a319..676004ae75d51d6a3cf8c6abdd772963b38596e3 100644
--- a/cron/lifecycle_guard_words.py
+++ b/cron/lifecycle_guard_words.py
@@ -6,6 +6,10 @@ import re
 
 from cron.lifecycle_guard_groups import split_glued_redirections
 
+# Optional fd or array-element fd variable, operator, and glued target.
+REDIRECTION = re.compile(
+    r"^(\d*|\{[A-Za-z_][A-Za-z0-9_]*(?:\[.+?\])?\})(<<<|<<-|<<|<>|<&|>&|>>|>\||&>>|&>|<|>)(.*)$", re.DOTALL)
+
 
 class ShellWord(str):
     """A decoded word plus the redirection parsed before quoted punctuation is decoded."""
-- 
2.43.0

