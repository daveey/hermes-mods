             result.auto_blocked.append(claimed.id)
         return False
diff --git a/hermes_cli/kanban_db_workspace.py b/hermes_cli/kanban_db_workspace.py
index bf5d878fc0..f10e8088f8 100644
--- a/hermes_cli/kanban_db_workspace.py
+++ b/hermes_cli/kanban_db_workspace.py
@@ -622,6 +622,78 @@ def _maybe_emit_scratch_tip(
 # Workspace resolution
 # ---------------------------------------------------------------------------
 
+class WorktreeWorkspaceConfigError(ValueError):
+    """A ``worktree`` workspace that can never resolve as configured (no repo to
+    anchor it on, relative path, board without ``default_workdir``). Retrying the
+    spawn cannot fix it, so the dispatcher blocks on the first occurrence and
+    ``create_task(validate_workspace=True)`` rejects it up front. [daveey]"""
+
+
+def _sibling_repo_hint(requested: Path) -> Optional[Path]:
+    """For a sibling-worktree name like ``~/code/<repo>-<slug>``, the ``<repo>``
+    root it most likely meant (longest matching sibling that is a repo root)."""
+    parent = _nearest_existing_path(requested.parent)
+    if parent != requested.parent:
+        return None
+    best: Optional[Path] = None
+    try:
+        siblings = [p for p in parent.iterdir() if p.is_dir()]
+    except OSError:
+        return None
+    for sib in siblings:
+        if not requested.name.startswith(sib.name + "-"):
+            continue
+        if best is not None and len(sib.name) <= len(best.name):
+            continue
+        top = _git_toplevel(sib)
+        if top is not None and _path_key(top) == _path_key(sib.resolve(strict=False)):
+            best = sib
+    return best
+
+
+def worktree_workspace_problem(
+    workspace_path: Optional[str], *, board: Optional[str] = None,
+) -> Optional[str]:
+    """Why a ``worktree`` workspace with this path would fail to resolve at
+    spawn, or ``None`` when it resolves. Same acceptance rules as
+    :func:`_resolve_worktree_workspace`, without creating anything: an existing
+    linked worktree, a repo root, or a path whose parent is inside a repo; no
+    path -> the board's ``default_workdir`` must be an absolute path in a repo."""
+    if not workspace_path:
+        board_slug = board if board else _kb.get_current_board()
+        board_default = (_kb.read_board_metadata(board_slug).get("default_workdir") or "").strip()
+        if not board_default:
+            return (
+                f"workspace_kind=worktree with no workspace_path needs a board default_workdir, "
+                f"and board {board_slug!r} has none. Pass workspace_path=<absolute git repo root> "
+                "(the dispatcher then creates <repo>/.worktrees/<task-id>)."
+            )
+        anchor = Path(board_default).expanduser()
+        if not anchor.is_absolute() or _git_toplevel(anchor) is None:
+            return (
+                f"board {board_slug!r} default_workdir {board_default!r} is not an absolute path "
+                "inside a git repo. Pass workspace_path=<absolute git repo root> instead."
+            )
+        return None
+    requested = Path(workspace_path).expanduser()
+    if not requested.is_absolute():
+        return f"worktree workspace_path {workspace_path!r} is not absolute; use an absolute path"
+    if requested.exists() and _is_linked_worktree_checkout(requested):
+        return None
+    if _git_toplevel(requested) is not None:
+        return None
+    if _repo_root_for_worktree_target(requested.parent) is not None:
+        return None
+    hint = _sibling_repo_hint(requested)
+    repo = str(hint) if hint is not None else "<repo root>"
+    return (
+        f"worktree path {workspace_path!r} is not inside a git repo and does not point at a "
+        f"git repo root. Fix: use workspace_path={repo!r} (the dispatcher creates "
+        f"<repo>/.worktrees/<task-id>), or first run: "
+        f"git -C {repo} worktree add {workspace_path} -b <branch>"
+    )
+
+
 def _git_toplevel(path: Path) -> Optional[Path]:
     """Return the git toplevel containing ``path``, or ``None`` if not in a repo."""
     out = _kb._git_out(path, "rev-parse", "--show-toplevel")
@@ -723,7 +795,7 @@ def _resolve_worktree_workspace(task: Task, *, board: Optional[str] = None) -> t
         board_slug = board if board else _kb.get_current_board()
         board_default = (_kb.read_board_metadata(board_slug).get("default_workdir") or "").strip()
         if not board_default:
-            raise ValueError(
+            raise WorktreeWorkspaceConfigError(
                 f"task {task.id} has workspace_kind=worktree but no workspace_path, "
                 f"and board {board_slug!r} has no default_workdir set. Set a board "
                 "default workdir (a git repo) or create the task with "
@@ -731,13 +803,13 @@ def _resolve_worktree_workspace(task: Task, *, board: Optional[str] = None) -> t
             )
         anchor = Path(board_default).expanduser()
         if not anchor.is_absolute():
-            raise ValueError(
+            raise WorktreeWorkspaceConfigError(
                 f"board {board_slug!r} default_workdir {board_default!r} is not "
                 "absolute; use an absolute path to a git repo"
             )
         repo_root = _git_toplevel(anchor)
         if repo_root is None:
-            raise ValueError(
+            raise WorktreeWorkspaceConfigError(
                 f"task {task.id} has workspace_kind=worktree but board "
                 f"{board_slug!r} default_workdir {board_default!r} is not inside a git repo"
             )
@@ -745,7 +817,7 @@ def _resolve_worktree_workspace(task: Task, *, board: Optional[str] = None) -> t
 
     requested = Path(task.workspace_path).expanduser()
     if not requested.is_absolute():
-        raise ValueError(
+        raise WorktreeWorkspaceConfigError(
             f"task {task.id} has non-absolute worktree path "
             f"{task.workspace_path!r}; use an absolute path"
         )
@@ -776,9 +848,11 @@ def _resolve_worktree_workspace(task: Task, *, board: Optional[str] = None) -> t
 
     repo_root = _repo_root_for_worktree_target(requested.parent)
     if repo_root is None:
-        raise ValueError(
-            f"task {task.id} worktree path {task.workspace_path!r} is not inside a git repo "
-            "and does not point at a git repo root"
+        raise WorktreeWorkspaceConfigError(
+            f"task {task.id} "
+            + (worktree_workspace_problem(task.workspace_path, board=board)
+               or f"worktree path {task.workspace_path!r} is not inside a git repo "
+                  "and does not point at a git repo root")
         )
     _ensure_git_worktree(repo_root, requested, branch_name)
     return requested, branch_name
diff --git a/tests/hermes_cli/test_kanban_worktree_create_validation.py b/tests/hermes_cli/test_kanban_worktree_create_validation.py
new file mode 100644
index 0000000000..1240db3fba
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_worktree_create_validation.py
@@ -0,0 +1,180 @@
+"""Worktree workspaces that can never resolve are rejected at create time and,
+for legacy rows, block on the FIRST spawn failure instead of burning retries.
+
+Regression: a worker created a card with ``workspace_path=~/code/<repo>-<slug>``
+(a sibling of the repo, outside any git repo, board without default_workdir).
+``_resolve_worktree_workspace`` failed identically on every dispatch, the card
+spent its retry budget (spawn_failed -> gave_up) and the creator never saw why.
+"""
+
+from __future__ import annotations
+
+import argparse
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_workspace as kbw
+
+# Match by base class + name: other kanban tests ``importlib.reload`` the workspace
+# module, which rebinds the class object this file imported at collection.
+_CONFIG_ERR = ValueError
+
+
+def _is_config_err(exc: BaseException) -> bool:
+    return type(exc).__name__ == "WorktreeWorkspaceConfigError"
+
+
+@pytest.fixture
+def kanban_home(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    kb.init_db()
+    return home
+
+
+def _git(cwd: Path, *args: str) -> None:
+    subprocess.run(
+        ["git", "-C", str(cwd), "-c", "user.name=T", "-c", "user.email=t@example.com",
+         "-c", "commit.gpgsign=false", *args],
+        check=True, capture_output=True, text=True,
+    )
+
+
+@pytest.fixture
+def code_dir(tmp_path):
+    """``<tmp>/code`` (not a repo) holding repo ``myapp``."""
+    code = tmp_path / "code"
+    repo = code / "myapp"
+    repo.mkdir(parents=True)
+    subprocess.run(["git", "init", "-b", "main", str(repo)], check=True, capture_output=True)
+    (repo / "README.md").write_text("x\n", encoding="utf-8")
+    _git(repo, "add", "README.md")
+    _git(repo, "commit", "-m", "init")
+    return code
+
+
+def test_create_rejects_sibling_path_outside_repo_and_names_fix(kanban_home, code_dir):
+    bad = str(code_dir / "myapp-s4-speaker-admission")
+    with kbc.connect() as conn:
+        with pytest.raises(_CONFIG_ERR) as ei:
+            kb.create_task(conn, title="t", assignee="a", workspace_kind="worktree",
+                           workspace_path=bad, validate_workspace=True)
+        assert conn.execute("SELECT COUNT(*) FROM tasks").fetchone()[0] == 0
+    assert _is_config_err(ei.value)
+    msg = str(ei.value)
+    repo = str(code_dir / "myapp")
+    assert "not inside a git repo" in msg and "Fix:" in msg
+    assert f"workspace_path={repo!r}" in msg  # sibling repo suggested
+    assert f"git -C {repo} worktree add {bad} -b <branch>" in msg
+
+
+@pytest.mark.parametrize("which", ["repo_root", "inside_repo", "linked_worktree"])
+def test_create_accepts_resolvable_worktree_paths(kanban_home, code_dir, which):
+    repo = code_dir / "myapp"
+    if which == "repo_root":
+        path = repo
+    elif which == "inside_repo":
+        path = repo / ".worktrees" / "new-one"  # parent need not exist yet
+    else:
+        path = code_dir / "myapp-feature"
+        _git(repo, "worktree", "add", str(path), "-b", "feature", "HEAD")
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="t", assignee="a", workspace_kind="worktree",
+                             workspace_path=str(path), validate_workspace=True)
+        assert kb.get_task(conn, tid).workspace_kind == "worktree"
+
+
+def test_create_rejects_relative_and_missing_board_default(kanban_home):
+    with kbc.connect() as conn:
+        with pytest.raises(_CONFIG_ERR, match="not absolute") as rel:
+            kb.create_task(conn, title="t", assignee="a", workspace_kind="worktree",
+                           workspace_path="rel/path", validate_workspace=True)
+        with pytest.raises(_CONFIG_ERR, match="default_workdir") as nodef:
+            kb.create_task(conn, title="t", assignee="a", workspace_kind="worktree",
+                           validate_workspace=True)
+    assert _is_config_err(rel.value) and _is_config_err(nodef.value)
+
+
+def test_create_without_validation_keeps_legacy_behaviour(kanban_home, code_dir):
+    # Internal callers (decompose, tests, imports) are unchanged.
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="t", assignee="a", workspace_kind="worktree",
+                             workspace_path=str(code_dir / "myapp-x"))
+        assert kb.get_task(conn, tid) is not None
+
+
+def test_kanban_create_tool_returns_error_to_creator(kanban_home, code_dir, monkeypatch):
+    import json
+
+    from tools import kanban_tools
+
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    out = json.loads(kanban_tools._handle_create({
+        "title": "t", "assignee": "a", "workspace_kind": "worktree",
+        "workspace_path": str(code_dir / "myapp-s4-speaker-admission"),
+    }))
+    assert "error" in out, out
+    assert "worktree add" in out["error"]
+    with kbc.connect() as conn:
+        assert conn.execute("SELECT COUNT(*) FROM tasks").fetchone()[0] == 0
+
+
+def test_cli_create_rejects_bad_worktree(kanban_home, code_dir, capsys):
+    from hermes_cli import kanban as kcli
+
+    ns = argparse.Namespace(
+        title="t", body=None, body_file=None, assignee="a", created_by="test",
+        workspace=f"worktree:{code_dir / 'myapp-s4'}", branch=None, max_runtime=None,
+        max_retries=None, tenant=None, priority=0, parent=None, triage=False,
+        idempotency_key=None, skills=None, json=False,
+    )
+    rc = kcli._cmd_create(ns)
+    assert rc == 2
+    assert "worktree add" in capsys.readouterr().err
+    with kbc.connect() as conn:
+        assert conn.execute("SELECT COUNT(*) FROM tasks").fetchone()[0] == 0
+
+
+def test_dispatcher_blocks_config_error_on_first_failure(kanban_home, code_dir, all_assignees_spawnable):
+    from hermes_cli import kanban_db_dispatch as kbd
+
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="t", assignee="a", workspace_kind="worktree",
+                             workspace_path=str(code_dir / "myapp-s4"))
+        spawned = []
+        kbd.dispatch_once(conn, spawn_fn=lambda *a, **k: spawned.append(a) or 1234, failure_limit=3)
+        task = kb.get_task(conn, tid)
+        assert spawned == []
+        assert task.status == "blocked"
+        assert task.consecutive_failures == 1
+        assert "not inside a git repo" in task.last_failure_error
+        assert "Fix: use workspace_path=" in task.last_failure_error
+        gave_up = [e for e in kb.list_events(conn, tid) if e.kind == "gave_up"]
+        assert gave_up and gave_up[-1].payload.get("sticky") is True
+        assert gave_up[-1].payload.get("workspace_config_error") is True
+        # Sticky: recompute_ready must not auto-resume it.
+        kb.recompute_ready(conn)
+        assert kb.get_task(conn, tid).status == "blocked"
+
+
+def test_dispatcher_transient_workspace_error_still_retries(
+    kanban_home, monkeypatch, all_assignees_spawnable,
+):
+    from hermes_cli import kanban_db_dispatch as kbd
+
+    def boom(task, board=None):
+        raise OSError("disk hiccup")
+
+    monkeypatch.setattr(kbd._kbw, "resolve_workspace", boom)
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="t", assignee="a")
+        kbd.dispatch_once(conn, spawn_fn=lambda *a, **k: 1234, failure_limit=3)
+        task = kb.get_task(conn, tid)
+        assert task.status == "ready"
+        assert task.consecutive_failures == 1
