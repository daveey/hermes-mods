From c439d46ceea863bd77a6e54fdd486486a092e476 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 11:51:17 +0000
Subject: [PATCH] test(desktop): kanban drawer: pin a cancelRefetch restart in
 a failed read's retry delay as a poll [daveey]

Follow-up to PR #2147 (review 5890276372, non-blocking points 1-2).

1. cancelRefetch during a retry delay. The review read query-core as restarting a fetch that a socket invalidation
   (cancelRefetch: true) cancels in its retry delay, on a query with data, without a 'fetch' dispatch, so
   fetchFailureCount would survive and the new fetch's first read would pass for a retry (foreground). Checked
   against the installed @tanstack/query-core 5.104.1 (src/query.ts fetch()): the restart does dispatch 'fetch',
   because its condition is `fetchStatus === 'idle' || state.fetchMeta !== fetchOptions?.meta`, the 'fetch' reducer
   stores `fetchMeta: action.meta ?? null`, and a refetch/invalidate passes no meta (undefined !== null). So the count
   resets and the new fetch's reads are polls today. No code change; the behaviour now has a test, since it rests on
   that null-vs-undefined detail:
   - "makes the reads of a fetch that replaced a failed one during its retry delay polls" (drawer.test.tsx): warm
     cache, re-open with the task read failing (retry 1, retryDelay 300), wait until fetchFailureCount is 1, then
     invalidate; expects ['foreground', 'foreground', undefined, undefined] (first open, failed re-open read, then the
     replacement fetch's read and its retry as polls).
   It passes on main (pin, not a RED/GREEN fix). Mutation check: with retryingFetch replaced by a classifier that
   cannot tell a restart from a retry (`fetchStatus === 'fetching'`), this test and the #2147 test both fail.
2. retryingFetch doc. Its comment now names the query-core reducer details it leans on ('failed' sets
   fetchFailureCount, 'fetch' and 'success' reset it, the cancelRefetch restart above) and the two drawer tests that
   pin them, so a React Query bump knows what to check.

Kanban plugin vitest 146/146, tsc --noEmit clean, eslint clean on the touched files, prettier clean on the test (api.ts
prettier drift is pre-existing on main, not in these lines).
---
 apps/desktop/src/plugins/kanban/api.ts        |  8 ++++-
 .../src/plugins/kanban/drawer.test.tsx        | 32 +++++++++++++++++++
 2 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/plugins/kanban/api.ts b/apps/desktop/src/plugins/kanban/api.ts
index f46d1eed79..fb54ab44bf 100644
--- a/apps/desktop/src/plugins/kanban/api.ts
+++ b/apps/desktop/src/plugins/kanban/api.ts
@@ -901,7 +901,13 @@ export function userOpenReads(): <T>(
 export type ReadFetchContext = { client: typeof queryClient; queryKey: readonly unknown[] }
 
 /** [daveey] Whether React Query is calling a query function to retry a failed read of the same fetch: it counts the
- *  fetch's failures before each retry and resets the count when a new fetch starts. */
+ *  fetch's failures before each retry and resets the count when a new fetch starts. That leans on query-core reducer
+ *  details it does not document ('failed' sets `fetchFailureCount`, 'fetch' and 'success' reset it), including a fetch
+ *  that `cancelRefetch` (a socket invalidation) starts in a failed fetch's retry delay: query-core 5.104 still
+ *  dispatches 'fetch' there, because the restart's undefined meta differs from the running fetch's `fetchMeta` (null).
+ *  drawer.test.tsx pins both; after a React Query bump, check "makes the refetches of a kind whose reads all fail polls
+ *  once its first fetch spent its retries" and "makes the reads of a fetch that replaced a failed one during its retry
+ *  delay polls". */
 export const retryingFetch = ({ client, queryKey }: ReadFetchContext) =>
   (client.getQueryState(queryKey)?.fetchFailureCount ?? 0) > 0
 
diff --git a/apps/desktop/src/plugins/kanban/drawer.test.tsx b/apps/desktop/src/plugins/kanban/drawer.test.tsx
index d9486b1a02..3c292602a5 100644
--- a/apps/desktop/src/plugins/kanban/drawer.test.tsx
+++ b/apps/desktop/src/plugins/kanban/drawer.test.tsx
@@ -345,6 +345,38 @@ describe('task modal dialog', () => {
     await waitFor(() => expect(taskReads()).toEqual(['foreground', 'foreground', undefined, undefined]))
   })
 
+  it('makes the reads of a fetch that replaced a failed one during its retry delay polls', async () => {
+    detail = { ...legacyDetail, attachments: [] }
+    client = new QueryClient({ defaultOptions: { queries: { retry: 1, retryDelay: 300 } } })
+
+    const taskReads = () =>
+      rest.mock.calls
+        .filter(([path, options]) => path === '/tasks/t_example' && !options?.method)
+        .map(([, options]) => options?.priority)
+
+    const taskQuery = () => client.getQueryCache().find({ exact: false, queryKey: ['kanban', 'task'] })
+
+    // A first open caches the task, so the re-open's query has data.
+    const first = openDrawer()
+    await screen.findByText('Keep this description readable.')
+    first.unmount()
+
+    failAlways = new Set(['/tasks/t_example'])
+    openDrawer()
+    await waitFor(() => expect(taskReads()).toEqual(['foreground', 'foreground']))
+    // Its read failed: the fetch waits out its retry delay.
+    await waitFor(() => expect(taskQuery()?.state.fetchFailureCount).toBe(1))
+
+    // A socket invalidation in the retry delay cancels that fetch and starts a new one (cancelRefetch). The new fetch's
+    // reads (first and retry) are polls: its first read must not pass for a retry of the cancelled fetch.
+    await act(async () => {
+      await client.invalidateQueries({ queryKey: ['kanban'] })
+    })
+    await waitFor(() => expect(taskReads()).toEqual(['foreground', 'foreground', undefined, undefined]), {
+      timeout: 3_000
+    })
+  })
+
   it('sends a foreground read when a task is re-opened while its cache is still fresh', async () => {
     detail = { ...legacyDetail, attachments: [] }
     // The shared client's staleTime (60 s): without a mount refetch a warm re-open sends nothing, and its first
