From bf6093e0c02030175017b8a62a207e10b31966bf Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 05:02:03 +0000
Subject: [PATCH] fix(kanban-recover): share <db>.recovery.lock with
 sqlite-live-guard's swap_db.py [daveey]

---
 hermes_cli/kanban_db_recover.py            |  7 ++++---
 tests/hermes_cli/test_kanban_db_recover.py | 14 ++++++++++++++
 2 files changed, 18 insertions(+), 3 deletions(-)

diff --git a/hermes_cli/kanban_db_recover.py b/hermes_cli/kanban_db_recover.py
index 91b07bce7b..31bc251646 100644
--- a/hermes_cli/kanban_db_recover.py
+++ b/hermes_cli/kanban_db_recover.py
@@ -13,8 +13,9 @@ those connections and corrupted the next copy. This module is the supported path
    opened nothing has nothing to lose. The child also re-checks the file from a clean process:
    a caller stranded on deleted ``-wal``/``-shm`` files sees "corruption" that is not on disk,
    and the child then reports ``healthy`` instead of rebuilding a good board.
-2. **One recovery at a time.** ``<db>.recover.lock`` (non-blocking flock). A second recovery,
-   automatic or ``hermes kanban recover``, exits ``busy`` instead of racing the first.
+2. **One recovery at a time.** ``<db>.recovery.lock`` (non-blocking flock; the same lock the
+   sqlite-live-guard mod's swap_db.py takes). A second recovery, automatic or ``hermes kanban
+   recover``, or a manual swap, exits ``busy`` instead of racing the first.
 3. **Snapshot through SQLite.** The damaged board is copied with the backup API (consistent with
    its WAL), kept as ``<db>.recover-<ts>.damaged.bak``, and salvaged from that copy: every table
    is read forward and backward by rowid and through each of its indexes, so only rows on pages
@@ -113,7 +114,7 @@ class RecoveryResult:
 # --- locking ----------------------------------------------------------------------------------
 
 def _lock_path(db_path: Path) -> Path:
-    return db_path.with_name(db_path.name + ".recover.lock")
+    return db_path.with_name(db_path.name + ".recovery.lock")  # shared with sqlite-live-guard swap_db.py
 
 
 @contextlib.contextmanager
diff --git a/tests/hermes_cli/test_kanban_db_recover.py b/tests/hermes_cli/test_kanban_db_recover.py
index be56d9301a..bc44ae3a73 100644
--- a/tests/hermes_cli/test_kanban_db_recover.py
+++ b/tests/hermes_cli/test_kanban_db_recover.py
@@ -254,6 +254,20 @@ def test_a_second_recovery_of_the_same_board_is_refused_busy(home):
     assert path.read_bytes() == digest, "a refused recovery writes nothing"
 
 
+def test_a_manual_swap_holding_the_shared_lock_makes_recovery_busy(home):
+    """sqlite-live-guard's swap_db.py flocks ``<db>.recovery.lock``: recovery must not run under it."""
+    import fcntl
+    path = home / "kanban.db"
+    _make_board(path)
+    _damage_table(path, "task_events")
+    digest = path.read_bytes()
+    with open(path.with_name(path.name + ".recovery.lock"), "a+") as fh:
+        fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+        result = rec.recover(path, file_card=False, reconcile_sync=False)
+    assert result.status == "busy"
+    assert path.read_bytes() == digest
+
+
 def test_a_board_a_clean_process_reads_fine_is_left_untouched(home):
     """A caller stranded on deleted -wal/-shm files sees "corruption" that is not on disk: the child re-checks."""
     path = home / "kanban.db"
