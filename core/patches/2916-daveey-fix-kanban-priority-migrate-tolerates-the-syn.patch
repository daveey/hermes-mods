-     --writer ORIGIN --attachment-id LOCAL_ATTACHMENT_ID --digest SHA256 \
-     --allow-legacy-rollback
+     --writer ORIGIN --attachment-id LOCAL_ATTACHMENT_ID --digest SHA256
    ```
 
-   The explicit flag acknowledges policy rollback when restoring above-cap old
-   values; coordinate cap-aware import/deployment policy first or imports may
-   immediately clip restored values. Restore requires exact owned membership and
+   Without `--allow-legacy-rollback` an above-cap original is restored at the cap
+   (1000, same effective rank). The explicit flag restores the exact legacy value
+   (policy rollback); the sync pull may clip it again on any replica. Restore
+   requires exact owned membership and
    target-value CAS, just like apply (new cards also cause refusal). It never
    reverts lifecycle state, lease, parents or runs. Publish and read back restore
    through normal sync too.
diff --git a/hermes_cli/kanban_priority.py b/hermes_cli/kanban_priority.py
index 5afdf58f5d..573dad1c07 100644
--- a/hermes_cli/kanban_priority.py
+++ b/hermes_cli/kanban_priority.py
@@ -11,6 +11,17 @@ def bounded(value: int) -> int:
     return min(PRIORITY_CAP, int(value))
 
 
+def at_value(stored: int, recorded: int) -> bool:
+    """Whether a stored priority still holds a recorded one, up to the cap clamp.
+
+    The sync pull stores ``bounded()`` of every received priority without an event,
+    so a replica of an above-cap legacy value reads PRIORITY_CAP while the Board
+    keeps the raw value. Both rank identically (effective priority is capped at
+    read time); any other difference is a real edit.
+    """
+    return stored == recorded or (recorded > PRIORITY_CAP and stored == PRIORITY_CAP)
+
+
 def bound_reopened(conn, task_id: str) -> None:
     """Bound an opened legacy row in the caller's transaction, retaining its audit."""
     from hermes_cli import kanban_db as kb
