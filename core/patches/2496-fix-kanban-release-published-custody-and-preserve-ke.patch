+def involuntary_park(task_id, fn, *args, **kwargs):
+    """Kernel-only call scope; never inferred from worker metadata or reason text."""
+    token = _kernel_park.set(task_id)
+    try:
+        return fn(*args, **kwargs)
+    finally:
+        _kernel_park.reset(token)
+
+
