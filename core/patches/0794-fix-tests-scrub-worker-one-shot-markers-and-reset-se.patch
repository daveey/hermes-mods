diff --git a/tests/_fixtures/session_context_reset.py b/tests/_fixtures/session_context_reset.py
new file mode 100644
index 0000000000..9401416f47
--- /dev/null
+++ b/tests/_fixtures/session_context_reset.py
@@ -0,0 +1,29 @@
+"""Autouse reset of ``gateway.session_context`` state before every test.
+
+Imported into ``tests/conftest.py`` so pytest registers the fixture there (see live_system_guard.py
+for why ``pytest_plugins`` is not used).
+
+The canonical runner gives each test file its own process, but a multi-file invocation
+(``pytest a.py b.py``, a sweep of related files) shares one interpreter. ``clear_session_vars``
+leaves every session ContextVar at ``""``, which masks ``os.environ`` in ``get_session_env``, and
+``set_session_vars`` latches the process-wide ``_session_context_engaged`` flag. A test in one file
+that bound and cleared a session therefore made later files ignore their monkeypatched
+HERMES_SESSION_ID / HERMES_CRON_SESSION (test_kanban_provenance before test_cronjob_tools,
+test_kanban_tools and test_completed_process_results). Resetting to "never bound here" makes any
+file combination behave like a fresh process. A near no-op while the module is not imported.
+"""
+import sys
+from typing import Any
+
+import pytest
+
+_SESSION_CONTEXT_MODULE = "gateway.session_context"
+
+
+@pytest.fixture(autouse=True)
+def _reset_session_context_vars():
+    mod: Any = sys.modules.get(_SESSION_CONTEXT_MODULE)
+    if mod is not None:
+        mod.reset_session_vars()
+        mod._session_context_engaged = False
+    yield
diff --git a/tests/conftest.py b/tests/conftest.py
index 10600e51fd..38a7331cf4 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -261,6 +261,7 @@ from tests._fixtures.live_system_guard import (
     _live_system_guard,
 )
 from tests._fixtures.platform_gating import _platforms_gate_reason, _reject_contradictory_platform_marks
+from tests._fixtures.session_context_reset import _reset_session_context_vars
 
 
 @pytest.fixture(autouse=True)
diff --git a/tests/test_hermetic_env_agent_markers.py b/tests/test_hermetic_env_agent_markers.py
new file mode 100644
index 0000000000..6e48d6ccc8
--- /dev/null
+++ b/tests/test_hermetic_env_agent_markers.py
@@ -0,0 +1,56 @@
+"""The hermetic test env drops agent-session markers a worker/agent shell exports, and resets
+session ContextVars between tests.
+
+pytest launched from a Kanban worker terminal inherits HERMES_SINGLE_QUERY_SESSION=1 (the worker
+is a ``hermes -q`` one-shot). Unscrubbed, ``delegate_task`` charged the one-shot spawn budget and
+test_delegate_apiserver_background failed with a TypeError on hosts only, never on CI.
+
+A multi-file run (``pytest a.py b.py``) shares one interpreter: a test that binds and clears
+session vars (``clear_session_vars`` sets ``""``, which masks ``os.environ``) made later files'
+``get_session_env`` ignore their monkeypatched HERMES_SESSION_ID / HERMES_CRON_SESSION
+(test_kanban_provenance -> test_cronjob_tools, test_kanban_tools, test_completed_process_results).
+"""
+
+import os
+
+from tests._fixtures.env_filter import _HERMES_BEHAVIORAL_VARS
+
+_WORKER_SHELL_MARKERS = (
+    "HERMES_SINGLE_QUERY_SESSION",
+    "HERMES_UI_SESSION_ID",
+    "HERMES_KANBAN_WORKER_TASK",
+    "HERMES_DELEGATED_CHILD_OWNER",
+    "HERMES_SUPERVISED_CHILD",
+)
+
+
+def test_worker_shell_markers_are_scrubbed_per_test():
+    for name in _WORKER_SHELL_MARKERS:
+        assert name in _HERMES_BEHAVIORAL_VARS
+        assert name not in os.environ, f"{name} leaked from the host into a test"
+
+
+def test_single_query_marker_off_in_tests():
+    from agent.oneshot_footprint import is_single_query_session
+
+    assert is_single_query_session() is False
+
+
+def test_a_test_that_binds_and_clears_session_vars():
+    """Leaves the ContextVars at ``""`` (masking env) and engages the process latch, like
+    test_kanban_provenance does. The next test must not see either."""
+    from gateway import session_context as sc
+
+    sc.clear_session_vars(sc.set_session_vars(platform="discord", chat_id="chat", session_id="s1"))
+    assert sc.get_session_env("HERMES_SESSION_ID", "fallback") == ""
+    assert sc.session_context_engaged() is True
+
+
+def test_next_test_reads_env_through_session_vars(monkeypatch):
+    from gateway import session_context as sc
+
+    assert sc.session_context_engaged() is False
+    monkeypatch.setenv("HERMES_SESSION_ID", "s_env")
+    monkeypatch.setenv("HERMES_CRON_SESSION", "1")
+    assert sc.get_session_env("HERMES_SESSION_ID") == "s_env"
+    assert sc.get_session_env("HERMES_CRON_SESSION") == "1"
