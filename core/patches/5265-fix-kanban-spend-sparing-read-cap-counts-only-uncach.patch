From 922117faba6ef146a98435758d111546fd2d7afd Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 17:27:17 +0000
Subject: [PATCH] fix(kanban): spend-sparing read cap counts only uncached PR
 reads; cap tested [daveey]

---
 hermes_cli/kanban_spend_pr_owner.py           | 18 +++++++-
 .../test_kanban_spend_pr_trailer.py           | 43 +++++++++++++++++++
 2 files changed, 59 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_spend_pr_owner.py b/hermes_cli/kanban_spend_pr_owner.py
index 8a7b0bdeab..589d7d747c 100644
--- a/hermes_cli/kanban_spend_pr_owner.py
+++ b/hermes_cli/kanban_spend_pr_owner.py
@@ -61,20 +61,34 @@ def recognised_prs(conn: sqlite3.Connection, task_id: str) -> set[str]:
     return published_prs(conn, task_id) | comment_candidates(conn, task_id)
 
 
-_MAX_READS = 8  # newest candidates verified per card; a long comment history stays bounded
+_MAX_CANDIDATES = 20  # most recently named PRs considered per card
+_MAX_READS = 8  # uncached GitHub reads per card; cached (e.g. merged) candidates are free
 
 
 def _number(url: str) -> int:
     return int(url.rsplit("/", 1)[1])
 
 
+def _cached(url: str) -> bool:
+    import time
+    from hermes_cli.kanban_db_dispatch_pr_state import OPEN_TTL_SECONDS, _details, norm_pr
+
+    hit = _details.get(norm_pr(url))
+    return hit is not None and time.monotonic() - hit[2] < OPEN_TTL_SECONDS
+
+
 def open_core_pr(conn: sqlite3.Connection, task_id: str) -> str | None:
     from hermes_cli.kanban_db_dispatch_pr_state import pr_card_owners, pr_details
 
     for url in sorted(published_prs(conn, task_id)):
         if pr_details(url) == ("OPEN", "main"):
             return url
-    for url in sorted(comment_candidates(conn, task_id), key=_number, reverse=True)[:_MAX_READS]:
+    reads = 0
+    for url in sorted(comment_candidates(conn, task_id), key=_number, reverse=True)[:_MAX_CANDIDATES]:
+        if not _cached(url):
+            if reads >= _MAX_READS:
+                continue  # fail closed on the rest; cached candidates are still checked
+            reads += 1
         if pr_details(url) == ("OPEN", "main") and pr_card_owners(url) == (task_id,):
             return url
     return None
diff --git a/tests/hermes_cli/test_kanban_spend_pr_trailer.py b/tests/hermes_cli/test_kanban_spend_pr_trailer.py
index 8dc964300a..eecb002075 100644
--- a/tests/hermes_cli/test_kanban_spend_pr_trailer.py
+++ b/tests/hermes_cli/test_kanban_spend_pr_trailer.py
@@ -113,3 +113,46 @@ def test_below_budget_trailer_reads_nothing(kanban_home, github):
         _stamped(conn, tid, f"See {PR}")
         assert spend.hold(conn, tid) is None
         assert github[1] == []
+
+
+def _per_pr_gh(monkeypatch, github, bodies):
+    """gh stub answering per PR number: (state, body)."""
+    import json as _json
+    from types import SimpleNamespace
+
+    def read(argv, **kwargs):
+        github[1].append(argv)
+        number = int(next(a for a in argv if a.rsplit("/", 1)[-1].isdigit()).rsplit("/", 1)[-1])
+        state, body = bodies[number]
+        data = {"state": state, "baseRefName": "main", "body": body, "comments": []}
+        return SimpleNamespace(returncode=0, stdout=_json.dumps(data), stderr="")
+
+    monkeypatch.setattr(base.prs.subprocess, "run", read)
+
+
+def test_read_cap_bounds_uncached_reads_and_fails_closed(kanban_home, github, monkeypatch):
+    with kbc.connect_closing() as conn:
+        tid = owner(conn, key="reviewed_pr", url="https://github.com/example-org/hermes/pull/3598")
+        newer = list(range(3600, 3609))  # 9 newer candidates, all merged
+        bodies = {n: ("MERGED", "") for n in newer}
+        bodies[3598] = ("OPEN", f"Hermes-Card: {tid}")
+        _per_pr_gh(monkeypatch, github, bodies)
+        _stamped(conn, tid, "Own PR #3598 and " + " ".join(f"PR #{n}" for n in newer))
+        assert spend.hold(conn, tid) == "triage"  # own PR never reached within 8 uncached reads
+        assert len(github[1]) == 8
+
+
+def test_cached_candidates_do_not_consume_the_read_cap(kanban_home, github, monkeypatch):
+    from hermes_cli import kanban_db_dispatch_pr_state as prs
+    with kbc.connect_closing() as conn:
+        tid = owner(conn, key="reviewed_pr", url="https://github.com/example-org/hermes/pull/3598")
+        newer = list(range(3600, 3609))
+        bodies = {n: ("MERGED", "") for n in newer}
+        bodies[3598] = ("OPEN", f"Hermes-Card: {tid}")
+        _per_pr_gh(monkeypatch, github, bodies)
+        for n in newer:
+            prs.pr_details(f"https://github.com/example-org/hermes/pull/{n}")
+        github[1].clear()
+        _stamped(conn, tid, "Own PR #3598 and " + " ".join(f"PR #{n}" for n in newer))
+        assert spend.hold(conn, tid) is None  # merged candidates were free; own PR verified
+        assert len(github[1]) == 1
