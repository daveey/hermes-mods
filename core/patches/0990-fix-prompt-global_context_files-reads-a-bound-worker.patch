From 7aa8db0ce7e0ecf08d9e0d7ac291c27df1cd4d70 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 19:19:15 +0000
Subject: [PATCH] fix(prompt): global_context_files reads a bound worker's
 config, not config.yaml [daveey]

Upstream's safe-worker policy test (ignore_user_config) caught the fork's global_context_files
reading the profile's config.yaml straight from disk. A worker bound to an explicit config now takes
the setting from worker_config_snapshot().
---
 agent/prompt_builder.py                  | 12 ++++++++----
 tests/agent/test_global_context_files.py | 21 +++++++++++++++++++++
 2 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/agent/prompt_builder.py b/agent/prompt_builder.py
index a846cbc35bb..d6d270fd845 100644
--- a/agent/prompt_builder.py
+++ b/agent/prompt_builder.py
@@ -1754,10 +1754,14 @@ def global_context_file_paths(home_override: Path | None = None) -> list[Path]:
     path, and the right profile even on a thread that lost the HERMES_HOME ContextVar). Never raises: a missing
     or unreadable config means no global files."""
     try:
-        from utils import load_yaml_file_readonly
-        home = Path(home_override) if home_override is not None else get_hermes_home()
-        cfg_path = home / "config.yaml"
-        cfg = load_yaml_file_readonly(cfg_path) if cfg_path.is_file() else {}
+        from agent.safe_worker_policy import worker_config_snapshot
+        # A worker bound to an explicit config (ignore_user_config) never reads the profile's file.
+        cfg = worker_config_snapshot()
+        if cfg is None:
+            from utils import load_yaml_file_readonly
+            home = Path(home_override) if home_override is not None else get_hermes_home()
+            cfg_path = home / "config.yaml"
+            cfg = load_yaml_file_readonly(cfg_path) if cfg_path.is_file() else {}
         raw = ((cfg or {}).get("agent") or {}).get("global_context_files") if isinstance(cfg, dict) else None
     except Exception as e:
         logger.debug("Could not read agent.global_context_files: %s", e)
diff --git a/tests/agent/test_global_context_files.py b/tests/agent/test_global_context_files.py
index 6451ac96c80..64a173effe4 100644
--- a/tests/agent/test_global_context_files.py
+++ b/tests/agent/test_global_context_files.py
@@ -183,3 +183,24 @@ def test_context_manifest_lists_global_rows(profile, tmp_path):
     with patch("agent.system_prompt._agent_home", return_value=profile.home):
         rows = context_file_sources_for_agent(cron)
     assert [r["path"] for r in rows] == [str(profile.rules), str(missing)]
+
+
+def test_worker_bound_to_an_explicit_config_never_reads_the_profile_file(profile, tmp_path, monkeypatch):
+    """A worker started with ignore_user_config reads the setting from its bound config, not config.yaml."""
+    import agent.safe_worker_policy as policy
+    other = tmp_path / "bound.md"
+    other.write_text("BOUND RULE")
+    monkeypatch.setattr(policy, "worker_config_snapshot",
+                        lambda: {"agent": {"global_context_files": [str(other)]}})
+    real_open = open
+    opened = []
+
+    def spy(path, *args, **kwargs):
+        opened.append(str(path))
+        return real_open(path, *args, **kwargs)
+
+    with patch("builtins.open", spy):
+        assert global_context_file_paths(profile.home) == [other]
+    assert not any(p.endswith("config.yaml") for p in opened)
+    monkeypatch.setattr(policy, "worker_config_snapshot", lambda: {})
+    assert global_context_file_paths(profile.home) == []
-- 
