From b70191410e95a7ec8c81974ea0ec3a8cdea30812 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 04:19:07 +0000
Subject: [PATCH] [daveey] execute_code: leave pending-approval terminal()
 results unchanged

The full-output post-processing added truncated: false to a refused
command's pending_approval result, breaking that contract's exact shape
(tests/tools/test_execute_code_local_session_approval.py).
---
 tests/tools/test_code_execution_terminal_full_output.py | 6 ++++++
 tools/code_execution_rpc.py                             | 2 ++
 2 files changed, 8 insertions(+)

diff --git a/tests/tools/test_code_execution_terminal_full_output.py b/tests/tools/test_code_execution_terminal_full_output.py
index 994f583ae0..0ae8184eee 100644
--- a/tests/tools/test_code_execution_terminal_full_output.py
+++ b/tests/tools/test_code_execution_terminal_full_output.py
@@ -107,6 +107,12 @@ def test_short_output_is_marked_complete():
     assert r["truncated"] is False
 
 
+def test_pending_approval_result_keeps_its_shape():
+    pending = {"output": "", "exit_code": -1, "error": "", "status": "pending_approval",
+               "approval_pending": True, "command": "rm -rf x"}
+    assert _rpc(pending) == pending
+
+
 def test_write_file_warns_on_truncation_marker(tmp_path):
     marked = tmp_path / "SHA256SUMS"
     content = ("abc  a.txt\n\n... [OUTPUT TRUNCATED - 13,635 chars omitted out of 63,562 total] ...\n\n"
diff --git a/tools/code_execution_rpc.py b/tools/code_execution_rpc.py
index a2f32382c8..b1cf85e6e3 100644
--- a/tools/code_execution_rpc.py
+++ b/tools/code_execution_rpc.py
@@ -154,6 +154,8 @@ def _complete_terminal_output(result):
         return result
     if not isinstance(body, dict) or not isinstance(body.get("output"), str):
         return result
+    if body.get("approval_pending") or body.get("status") == "pending_approval":
+        return result  # the command never ran: keep the approval contract's exact shape
     spill_path = body.get("full_output_path")
     full = _read_full_output(spill_path) if spill_path else None
     if full is not None:
-- 
2.51.0

