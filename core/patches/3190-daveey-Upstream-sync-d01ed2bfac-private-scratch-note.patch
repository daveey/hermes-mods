Subject: [PATCH] [daveey] Upstream sync d01ed2bfac: private-scratch note
 follows the brief on fresh runs only; continue tests pin turns without it

---
 tests/tools/test_delegate_continue.py        |  8 ++++++++
 tests/tools/test_delegate_private_scratch.py | 18 ++++++++++--------
 tests/tools/test_delegate_resumable.py       |  2 +-
 tools/delegate_tool_child_run.py             | 11 ++++++-----
 4 files changed, 25 insertions(+), 14 deletions(-)

diff --git a/tests/tools/test_delegate_continue.py b/tests/tools/test_delegate_continue.py
index 19f688050d..f303897de7 100644
--- a/tests/tools/test_delegate_continue.py
+++ b/tests/tools/test_delegate_continue.py
@@ -29,6 +29,14 @@ def _empty_completion_queue():
     drain()
 
 
+@pytest.fixture(autouse=True)
+def _no_private_scratch_note(monkeypatch):
+    """These tests pin the child's exact turns; the fork's private-scratch note on a non-git child's first turn
+    is covered by test_delegate_private_scratch.py. [daveey]"""
+    from tools.delegate_tool_child_run import _ChildRun
+    monkeypatch.setattr(_ChildRun, "attach_private_scratch", lambda self, parent_cwd: None)
+
+
 class _ScriptedModel:
     """Stands in for AIAgent: records how each child was built and what each turn saw, and persists each turn
     into the child's dedicated SessionDB handle the way a real child's transcript lands there."""
diff --git a/tests/tools/test_delegate_private_scratch.py b/tests/tools/test_delegate_private_scratch.py
index 5a35b5dca4..2a01652ef9 100644
--- a/tests/tools/test_delegate_private_scratch.py
+++ b/tests/tools/test_delegate_private_scratch.py
@@ -48,8 +48,9 @@ def test_non_git_children_get_distinct_private_scratch_named_in_prompt(tmp_path,
             assert Path(private).parent == tmpdir
             assert Path(private).name.startswith(f"subagent-{sid}-")
             assert child.ephemeral_system_prompt == _BASE_PROMPT
-            prompt = run.goal
-            assert prompt.startswith("do the thing\n\nPRIVATE SCRATCH: ")
+            assert run.goal == "do the thing"
+            prompt = run.private_scratch_note
+            assert prompt.startswith("\n\nPRIVATE SCRATCH: ")
             assert "PRIVATE SCRATCH" in prompt and private in prompt
             assert "SHARED" in prompt and str(shared) in prompt
             # The session cwd stays the parent's: brief paths are relative to it.
@@ -58,8 +59,8 @@ def test_non_git_children_get_distinct_private_scratch_named_in_prompt(tmp_path,
             dirs.append(private)
         assert dirs[0] != dirs[1]
         # Each prompt names only its own private folder.
-        assert dirs[1] not in runs[0][0].goal
-        assert dirs[0] not in runs[1][0].goal
+        assert dirs[1] not in runs[0][0].private_scratch_note
+        assert dirs[0] not in runs[1][0].private_scratch_note
     finally:
         clear_session_cwd("parent-ps-1")
         for run, _ in runs:
@@ -76,8 +77,9 @@ def test_unrecorded_parent_cwd_falls_back_to_workspace_hint(tmp_path, monkeypatc
     try:
         run.seed_workspace()
         assert child.ephemeral_system_prompt is None
-        prompt = run.goal
-        assert prompt.startswith("goal\n\nPRIVATE SCRATCH: ")
+        assert run.goal == "goal"
+        prompt = run.private_scratch_note
+        assert prompt.startswith("\n\nPRIVATE SCRATCH: ")
         assert f"Your working directory {hinted} is SHARED" in prompt
     finally:
         clear_session_cwd(run.child_task_id)
@@ -106,7 +108,7 @@ def test_git_isolated_child_gets_no_private_scratch_block(tmp_path, monkeypatch)
         assert run.worktree_info is not None
         assert run.private_scratch is None
         assert child.ephemeral_system_prompt == _BASE_PROMPT
-        assert "PRIVATE SCRATCH" not in run.goal
+        assert run.private_scratch_note == ""
         assert list(tmpdir.iterdir()) == []
     finally:
         if run is not None and run.worktree_info is not None:
@@ -128,7 +130,7 @@ def test_non_local_backend_gets_no_host_private_scratch(tmp_path, monkeypatch):
             run, child = _seed("parent-ps-3", "sa-0-dddd4444")
         assert run.private_scratch is None
         assert child.ephemeral_system_prompt == _BASE_PROMPT
-        assert "PRIVATE SCRATCH" not in run.goal
+        assert run.private_scratch_note == ""
         assert list(tmpdir.iterdir()) == []
     finally:
         clear_session_cwd("parent-ps-3")
