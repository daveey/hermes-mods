     _pty: Any = field(default=None, repr=False)  # ptyprocess handle (use_pty=True)
+    # Re-adopted by a Desktop/TUI backend: queue a status-unknown completion when the PID goes. [daveey]
+    _report_lost_exit: bool = field(default=False, repr=False)
 
     def __post_init__(self):
         # A session built without an explicit owner is owned by its own task, so ownership checks compare
@@ -698,7 +701,7 @@ def _is_wsl_launcher_command(command: str) -> bool:
     return False
 
 
-class ProcessRegistry(ProcessTerminationMixin, ProcessCheckpointMixin):
+class ProcessRegistry(ProcessTerminationMixin, ProcessCheckpointMixin, ProcessReadoptMixin):
     """In-memory registry of running and finished background processes.
     Thread-safe: accessed from executor threads (terminal_tool, process handlers),
     the gateway asyncio loop (watchers, reset checks) and the cleanup thread."""
@@ -1063,12 +1066,14 @@ class ProcessRegistry(ProcessTerminationMixin, ProcessCheckpointMixin):
         with session._lock:
             session.exited = True
         with self._lock:
-            self._running.pop(session.id, None)
+            was_running = self._running.pop(session.id, None) is not None
             if session.systemd_unit:
                 self._finished[session.id] = session
             else:
                 self._finished.pop(session.id, None)
         self._write_checkpoint()
+        if was_running and session._report_lost_exit and session.notify_on_complete:
+            self._queue_unknown_exit(session)
         session._completion_event.set()
         return session if session.systemd_unit else None
 
diff --git a/tools/process_registry_checkpoint.py b/tools/process_registry_checkpoint.py
index e272d35724..32c577ec6a 100644
--- a/tools/process_registry_checkpoint.py
+++ b/tools/process_registry_checkpoint.py
@@ -128,13 +128,28 @@ class ProcessCheckpointMixin:
         from utils import atomic_json_write
         atomic_json_write(_checkpoint_path(), entries)
 
-    def recover_from_checkpoint(self) -> int:
-        """On gateway startup, probe PIDs from the checkpoint file; returns how many
-        were recovered as detached sessions."""
+    def recover_from_checkpoint(self, owner: Optional[str] = None) -> int:
+        """On startup, probe PIDs from the checkpoint file; returns how many were
+        recovered as detached sessions.
+
+        ``owner`` limits adoption to one kind of entry (see
+        ``tools.process_registry_readopt``): ``"gateway"`` (messaging session keys and
+        legacy keyless entries) or ``"tui"`` (Desktop/TUI session ids). ``None`` adopts
+        every orphan. The whole read-decide-write runs under the checkpoint file lock,
+        so two backends starting together adopt an orphan once. [daveey]"""
+        try:
+            with self._checkpoint_file_lock():
+                return self._recover_from_checkpoint_locked(owner)
+        except Exception as e:
+            logger.warning("Process checkpoint recovery failed: %s", e, exc_info=True)
+            return 0
+
+    def _recover_from_checkpoint_locked(self, owner: Optional[str]) -> int:
         from tools.process_registry import (
             ProcessSession, _CHECKPOINT_FIELDS, _checkpoint_path,
             _CHECKPOINT_DEFAULTS, _WATCHER_ROUTE_KEYS, _stop_systemd_unit,
