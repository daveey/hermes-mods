 hermes_cli/kanban_chat_wait.py                |  27 +++-
 hermes_cli/kanban_replica_freshness.py        | 129 ++++++++++++++++++
 tests/gateway/test_kanban_wake_fold.py        |  48 +++++++
 .../test_kanban_ready_wait_checkpoint.py      | 107 +++++++++++++++
 5 files changed, 315 insertions(+), 5 deletions(-)
 create mode 100644 hermes_cli/kanban_replica_freshness.py

