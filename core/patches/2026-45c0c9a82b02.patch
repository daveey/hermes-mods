From 45c0c9a82b02f98c0af52f2559b7bca068ef3a4d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 6 Nov 2026 21:13:49 +0000
Subject: [PATCH] [daveey] Route Nix dependency hash checks to fork runners

---
 .github/workflows/nix.yml            |  4 ++--
 tests/ci/test_fork_runner_routing.py | 20 ++++++++++++++++++++
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/nix.yml b/.github/workflows/nix.yml
index 8ab67f98754..267a88ec50d 100644
--- a/.github/workflows/nix.yml
+++ b/.github/workflows/nix.yml
@@ -80,10 +80,10 @@ jobs:
     name: pnpm deps hash
     needs: [detect]
     if: needs.detect.outputs.nix == 'true' || inputs.release == true
-    runs-on: blacksmith-4vcpu-ubuntu-2404
+    runs-on: [self-hosted, docker-ci]
     timeout-minutes: 20
     steps:
-      - uses: useblacksmith/checkout@25227e61ff9dafe400e22fa487b673eac4e4409a  # v1
+      - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a  # v7.0.1 (fork: upstream uses useblacksmith/checkout)
         with:
           ref: ${{ inputs.commit || github.sha }}
 
diff --git a/tests/ci/test_fork_runner_routing.py b/tests/ci/test_fork_runner_routing.py
index 624631ebdf5..e9a00f71560 100644
--- a/tests/ci/test_fork_runner_routing.py
+++ b/tests/ci/test_fork_runner_routing.py
@@ -102,6 +102,26 @@ def test_fork_rewriter_preserves_completion_capacity(tmp_path, original_label):
         assert _labels(observer["jobs"]["comment"]) == {"self-hosted", POLL}
 
 
+def test_fork_linux_jobs_never_require_blacksmith_runners():
+    # PR classifiers can skip a new job even while its workflow is green.
+    # Check every Linux routing declaration, including matrix runner values.
+    offenders = [
+        f"{wf}:{name}"
+        for wf, name, job in _jobs()
+        if re.search(r"blacksmith-[^'\"\s,\]}]*ubuntu", str({
+            "runs-on": job.get("runs-on"), "strategy": job.get("strategy"),
+        }))
+    ]
+    assert not offenders, f"Fork has no Blacksmith Linux runners: {offenders}"
+
+
+def test_nix_jobs_use_portable_checkout():
+    for wf, name, job in _jobs():
+        if wf == "nix.yml":
+            for step in job.get("steps", []):
+                assert not step.get("uses", "").startswith("useblacksmith/"), name
+
+
 def test_detect_timeout_tolerates_a_loaded_hub():
     data = _YAML.load((WORKFLOWS / "ci.yaml").read_text(encoding="utf-8"))
     assert data["jobs"]["detect"]["timeout-minutes"] >= 5
-- 
