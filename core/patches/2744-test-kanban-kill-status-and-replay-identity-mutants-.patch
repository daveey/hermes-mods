---
 .../test_kanban_ask_survivor_fences.py        | 81 +++++++++++++++++++
 1 file changed, 81 insertions(+)
 create mode 100644 tests/hermes_cli/test_kanban_ask_survivor_fences.py

diff --git a/tests/hermes_cli/test_kanban_ask_survivor_fences.py b/tests/hermes_cli/test_kanban_ask_survivor_fences.py
new file mode 100644
index 0000000000..f5bc4e4729
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_ask_survivor_fences.py
@@ -0,0 +1,81 @@
+"""Independent status and malformed/replayed event identity fences."""
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_ask_resolved as kar
+from hermes_cli import kanban_ask_resolved_backfill as bf
+from hermes_cli import kanban_block_notice as bn
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from tests.hermes_cli import test_kanban_ask_backfill as legacy
+from tests.hermes_cli import test_kanban_ask_resolved_check as helpers
+
+board = helpers.board
+
+
+def test_status_prefilter_avoids_even_reading_nonblocked_drop_history(board, monkeypatch):
+    with kbc.connect_closing() as conn:
+        tid = helpers._blocked_ask(conn, "exit 1")
+        legacy._legacy(conn, tid, kar.BROKEN_EVENT)
+        # A status-only update must not rely on unblock_task clearing the request.
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='done' WHERE id=?", (tid,))
+        seen = []
+        real = bf._latest_drop
+
+        def observe(c, t):
+            seen.append(t)
+            return real(c, t)
+
+        monkeypatch.setattr(bf, "_latest_drop", observe)
+        assert bf.backfill(conn) == []
+        assert seen == []
+        assert "resolved_check_dropped_at" not in legacy._request(conn, tid)
+
+
+def test_status_only_change_between_scan_and_write_rejects_backfill(board, monkeypatch):
+    with kbc.connect_closing() as conn:
+        tid = helpers._blocked_ask(conn, "exit 1")
+        legacy._legacy(conn, tid, kar.BROKEN_EVENT)
+        real = bf._latest_drop
+        changed = False
+
+        def race(c, t):
+            nonlocal changed
+            result = real(c, t)
+            if not changed:
+                changed = True
+                with kb.write_txn(c):
+                    c.execute("UPDATE tasks SET status='done' WHERE id=?", (t,))
+            return result
+
+        monkeypatch.setattr(bf, "_latest_drop", race)
+        before_events = legacy._count(conn)
+        assert bf.backfill(conn) == []
+        assert changed
+        assert legacy._count(conn) == before_events
+        assert "resolved_check_dropped_at" not in legacy._request(conn, tid)
+
+
+def test_non_drop_replay_payload_cannot_suppress_same_kind_history():
+    old = SimpleNamespace(id=1, kind="comment", uid="old", payload={})
+    replay = SimpleNamespace(id=2, kind="comment", uid="new",
+                             payload={"backfilled": True, "origin_event_uid": "old"})
+    assert bn.coalesce_superseded_blocks([old, replay]) == [old, replay]
+
+
+@pytest.mark.parametrize("uid", [["unhashable"], {"invalid": "uid"}, ""])
+def test_invalid_uid_reference_never_suppresses_or_crashes(uid):
+    # Empty historical UIDs must not be treated as stable identities either.
+    old = SimpleNamespace(id=1, kind=kar.BROKEN_EVENT, uid="", payload={})
+    replay = SimpleNamespace(id=2, kind=old.kind, uid="replay",
+                             payload={"backfilled": True, "origin_event_uid": uid})
+    assert bn.coalesce_superseded_blocks([old, replay]) == [old, replay]
+
+
+def test_synced_replay_integer_collision_does_not_remove_uidless_local_event():
+    old = SimpleNamespace(id=1, kind=kar.BROKEN_EVENT, uid=None, payload={})
+    replay = SimpleNamespace(id=2, kind=old.kind, uid="foreign-replay",
+                             payload={"backfilled": True, "origin_event_id": old.id})
+    assert bn.coalesce_superseded_blocks([old, replay]) == [old, replay]
