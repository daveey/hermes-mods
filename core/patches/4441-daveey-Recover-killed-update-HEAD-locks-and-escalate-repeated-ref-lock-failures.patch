+    assert {e["identity"]["path"] for e in ledger["entries"].values()} == {
+        f"/repo/.git/refs/heads/{run}.lock" for run in range(3, alert._MAX_ENTRIES + 3)}
+
+
+def test_expired_observation_does_not_combine_with_new_run(tmp_path):
