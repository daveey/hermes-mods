diff --git a/tests/agent/test_worker_thread_session_tag.py b/tests/agent/test_worker_thread_session_tag.py
new file mode 100644
index 0000000000..4dc8a13c15
--- /dev/null
+++ b/tests/agent/test_worker_thread_session_tag.py
@@ -0,0 +1,50 @@
+"""[daveey] Errors logged on the API worker thread carry the session tag (self-heal agent-1572c64e24).
+
+The session id that prefixes log lines is thread-local; the streaming/API worker runs on its own
+thread, so "Streaming failed before delivery" reached errors.log without ``[<sid>]`` and the errors
+signal (which reads the tag) filed the defect with an empty session id.
+"""
+
+import logging
+import threading
+
+
+def test_worker_thread_logs_carry_the_callers_session_tag():
+    from agent.chat_completion_helpers import _context_thread_target
+    from hermes_logging import _install_session_record_factory, clear_session_context, set_session_context
+
+    _install_session_record_factory()
+    records = []
+
+    class _Capture(logging.Handler):
+        def emit(self, record):
+            records.append(record)
+
+    log = logging.getLogger("agent.chat_completion_helpers.test_session_tag")
+    handler = _Capture()
+    log.addHandler(handler)
+    log.setLevel(logging.ERROR)
+    try:
+        set_session_context("20261027_220000_5326d3")
+        worker = threading.Thread(
+            target=_context_thread_target(lambda: log.error("Streaming failed before delivery: boom")))
+        worker.start()
+        worker.join(5)
+    finally:
+        clear_session_context()
+        log.removeHandler(handler)
+    assert [r.session_tag for r in records] == [" [20261027_220000_5326d3]"]
+
+
+def test_worker_thread_without_a_session_stays_untagged():
+    from agent.chat_completion_helpers import _context_thread_target
+    from hermes_logging import _install_session_record_factory, clear_session_context
+
+    _install_session_record_factory()
+    clear_session_context()
+    tags = []
+    worker = threading.Thread(target=_context_thread_target(
+        lambda: tags.append(logging.getLogRecordFactory()("x", logging.ERROR, "", 0, "m", (), None).session_tag)))
+    worker.start()
+    worker.join(5)
+    assert tags == [""]
diff --git a/website/docs/user-guide/configuration.md b/website/docs/user-guide/configuration.md
index 9f750524a5..a3e4c90dd2 100644
--- a/website/docs/user-guide/configuration.md
+++ b/website/docs/user-guide/configuration.md
@@ -1242,6 +1242,8 @@ A rate limit that names its reset (`Retry-After` or a `retry_after` body field)
 
 `agent.auto_recovery_cycles` is the safety net *after* both the retries and the fallback chain are spent. When the failure is a transient outage (HTTP 5xx, an `overloaded`/529 response, a connect or read timeout) and no answer text has reached you yet, Hermes does not end the turn with "API failed after N retries" — it waits and tries again, up to this many cycles (default `5`), with a jittered 15/30/60/60/60 s schedule. A provider `Retry-After` header wins over the schedule (honoured up to 120 s). Every surface shows the same line while it waits — `⏳ Provider temporarily unavailable — retrying automatically in 30s (cycle 2/5); press Esc to stop` on the CLI/TUI/Desktop, a status bubble on messaging platforms (`send /stop to cancel`), a `hermes.status` SSE event on the API server, and a log line for cron jobs. Pressing Esc (or `/stop`) cancels the wait immediately. Fallback still comes first: with a fallback chain configured, exhaustion moves to the next provider as before, and the ladder only engages once the chain has nothing left. Authentication, billing, request-format, entitlement, content-policy and account-policy errors never enter the ladder. Set `0` to disable it.
 
+`agent.model_provider_guard` (default `true`) stops an agent at startup when the route resolved to OpenRouter or the Nous Portal but the model is a bare vendor id such as `claude-opus-5-5`. Those services only accept `vendor/model` ids, so the request could only fail with HTTP 400 ("is not a valid model ID"). The error names the provider, the base URL, the model and how the route was chosen (`pinned`, `fallback` or `auto`), and suggests `anthropic/claude-opus-5-5` or `--provider anthropic`. Ids with a `/` (such as `openrouter/auto`) and ids with no recognisable vendor pass. Set it to `false` to turn the check off.
+
 ## Wall-Clock Run Budget
 
 Separate from the iteration budget, you can give each conversation run an optional **wall-clock** budget. This is designed for one-shot and eval-harness invocations that run under a hard external ceiling (e.g. a 900-second per-task limit): without it, a run can time out with the work essentially done — one generation short of emitting the final answer, or stuck in a single hung provider call.
