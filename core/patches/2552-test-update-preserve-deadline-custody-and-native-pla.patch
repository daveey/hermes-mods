From 069a5bd579011c031e50a0aabd42086a00f0b8a5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 03:53:09 +0000
Subject: [PATCH] test(update): preserve deadline custody and native platform
 coverage [daveey]

Why: the inherited fence-custody consumer still asserted the pre-deadline call signature; Linux-only busy-stop fixtures were marked POSIX. The prior focused gate omitted the inherited fence module, and Linux could not expose the native platform mismatch. Assert the exact deadline without weakening fence_checked, run all 20 importing consumers (343 pass, 7 platform skips), and move non-Linux refusal coverage out of the Linux deadline suite with a native macOS case. RED: r8-red.log, custody assertion reproducibly fails at 4399db603fa.
---
 .../test_update_fenced_launcher_pause.py      |  3 +-
 .../test_update_preswap_deadline.py           | 17 +----------
 tests/hermes_cli/test_update_preswap_drain.py | 28 +++++++++++++++++--
 3 files changed, 28 insertions(+), 20 deletions(-)

diff --git a/tests/hermes_cli/test_update_fenced_launcher_pause.py b/tests/hermes_cli/test_update_fenced_launcher_pause.py
index 25bb381c41..a172caa408 100644
--- a/tests/hermes_cli/test_update_fenced_launcher_pause.py
+++ b/tests/hermes_cli/test_update_fenced_launcher_pause.py
@@ -151,7 +151,8 @@ def test_pause_discovery_leaves_restart_custody_with_fence(parked, monkeypatch,
     assert token['posix_units'] == ([ordinary] if mixed else [])
     if mixed:
         write.assert_called_once()
-        stop.assert_called_once_with(token, [ordinary], fence_checked=True)
+        stop.assert_called_once_with(
+            token, [ordinary], parked.now[0] + pause._PRE_SWAP_DRAIN_WAIT_S, fence_checked=True)
     else:
         write.assert_not_called()
         stop.assert_not_called()
diff --git a/tests/hermes_cli/test_update_preswap_deadline.py b/tests/hermes_cli/test_update_preswap_deadline.py
index fcdd2a6039..02d0a296ae 100644
--- a/tests/hermes_cli/test_update_preswap_deadline.py
+++ b/tests/hermes_cli/test_update_preswap_deadline.py
@@ -22,7 +22,7 @@ import pytest
 
 from hermes_cli import update_cmd_posix_pause as pause
 
-pytestmark = pytest.mark.platforms("posix")
+pytestmark = pytest.mark.platforms("linux")
 
 BOUND = 4.0  # the scaled-down stand-in for the 30 s pre-swap bound
 SLACK = 1.5  # scheduling slack on a loaded CI box
@@ -386,21 +386,6 @@ def test_idle_only_still_prints_and_continues_on_unmanageable(monkeypatch, capsy
     assert "x keeps running" in capsys.readouterr().out
 
 
-def test_macos_ignores_the_opt_in_and_stays_idle_only(monkeypatch, capsys):
-    monkeypatch.setenv(pause.STOP_BUSY_ENV, "1")
-    monkeypatch.setattr(pause, "_is_linux", lambda: False)
-    assert not pause._stop_busy_opted_in()
-    monkeypatch.setattr(pause, "_stop_busy_gateways", lambda *a: pytest.fail("busy stop on macOS"))
-    asked = []
-    monkeypatch.setattr(pause, "_ask_to_drain", lambda e: asked.append(e) or False)
-    from hermes_cli import update_pause_record as record
-    monkeypatch.setattr(record, "mark_stop_sent", lambda *a: None)
-    monkeypatch.setattr(record, "mark_stop_refused", lambda *a: None)
-    with pytest.raises(pause.PauseRefused):
-        pause._stop_gateways({}, [{"pid": 4242, "kind": "launchd", "label": "ai.hermes.gateway", "home": "/h"}])
-    assert asked  # the idle-only verb, which a busy gateway answers with a deferral
-
-
 def test_recovery_is_announced_as_its_own_phase(monkeypatch, capsys):
     from hermes_cli import update_pause_record as record
     from hermes_cli import update_cmd_windows as windows
diff --git a/tests/hermes_cli/test_update_preswap_drain.py b/tests/hermes_cli/test_update_preswap_drain.py
index 583ef8e434..570ba32e77 100644
--- a/tests/hermes_cli/test_update_preswap_drain.py
+++ b/tests/hermes_cli/test_update_preswap_drain.py
@@ -311,7 +311,7 @@ def _busy_gateway_at_commit_point(tmp_path, monkeypatch, *, active_work=7):
     return order, runner, root, head(), _fake_clock(monkeypatch)
 
 
-@pytest.mark.platforms("posix")
+@pytest.mark.platforms("linux")
 def test_opted_in_update_stops_a_busy_gateway_within_the_bound_before_any_tree_move(tmp_path, monkeypatch):
     from hermes_cli import update_cmd_commit as commit
     order, runner, root, start_head, now = _busy_gateway_at_commit_point(tmp_path, monkeypatch)
@@ -344,7 +344,7 @@ def test_without_the_opt_in_a_busy_gateway_defers_and_nothing_is_stopped(tmp_pat
     assert now[0] == 0.0
 
 
-@pytest.mark.platforms("posix")
+@pytest.mark.platforms("linux")
 def test_opted_in_update_stops_a_gateway_that_predates_the_pause_verbs_at_once(monkeypatch):
     """hermes-hub's pinned askeve gateways: no idle verb, so the default path refuses them forever."""
     from gateway import control_socket
@@ -368,7 +368,7 @@ def test_opted_in_update_stops_a_gateway_that_predates_the_pause_verbs_at_once(m
     assert now[0] == 0.0  # a supervised gateway that cannot drain is not waited for
 
 
-@pytest.mark.platforms("posix")
+@pytest.mark.platforms("linux")
 def test_opted_in_stop_that_fails_still_refuses_the_move(tmp_path, monkeypatch):
     from hermes_cli import update_cmd_commit as commit
     order, _runner, root, _head, _now = _busy_gateway_at_commit_point(tmp_path, monkeypatch)
@@ -381,6 +381,28 @@ def test_opted_in_stop_that_fails_still_refuses_the_move(tmp_path, monkeypatch):
     assert order == ["drain", "resume"]  # rolled back under the fence, never armed
 
 
+@pytest.mark.parametrize("native", [
+    pytest.param(False, marks=pytest.mark.platforms("posix")),
+    pytest.param(True, marks=pytest.mark.platforms("macos")),
+])
+def test_macos_ignores_the_opt_in_and_stays_idle_only(monkeypatch, native):
+    # The native case exercises the real platform predicate on macOS CI; the
+    # simulated case keeps the refusal contract exercised on Linux as well.
+    if not native:
+        monkeypatch.setattr(pause, "_is_linux", lambda: False)
+    monkeypatch.setenv(pause.STOP_BUSY_ENV, "1")
+    assert not pause._stop_busy_opted_in()
+    monkeypatch.setattr(pause, "_stop_busy_gateways", lambda *a: pytest.fail("busy stop on macOS"))
+    asked = []
+    monkeypatch.setattr(pause, "_ask_to_drain", lambda e: asked.append(e) or False)
+    monkeypatch.setattr(record, "mark_stop_sent", lambda *a: None)
+    monkeypatch.setattr(record, "mark_stop_refused", lambda *a: None)
+    entry = {"pid": 4242, "kind": "launchd", "label": "ai.hermes.gateway", "home": "/h"}
+    with pytest.raises(pause.PauseRefused):
+        pause._stop_gateways({}, [entry])
+    assert asked == [entry]
+
+
 def test_the_opt_in_is_not_inherited_by_a_replayed_gateway():
     import inspect
     assert "STOP_BUSY_ENV" in inspect.getsource(pause._relaunch_bare).split("for leaked in", 1)[1].split("\n", 1)[0]
