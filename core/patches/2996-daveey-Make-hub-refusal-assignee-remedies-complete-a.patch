From a28d3266de7b8e2ed0fc599d36f42b9e094231e2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 20:50:30 +0000
Subject: [PATCH] [daveey] Make hub refusal assignee remedies complete and
 conditional

Proof: four regression cases fail before the fix; 145 admission tests pass after it.
---
 hermes_cli/kanban_hub_admission_placement.py | 14 ++++-----
 tests/test_kanban_hub_admission_placement.py | 30 ++++++++++++++++++++
 2 files changed, 37 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban_hub_admission_placement.py b/hermes_cli/kanban_hub_admission_placement.py
index badccd6e19..5d2ce9e88e 100644
--- a/hermes_cli/kanban_hub_admission_placement.py
+++ b/hermes_cli/kanban_hub_admission_placement.py
@@ -447,7 +447,7 @@ def _refusal(args, verdict, audit, cfg, *, on_hub, machine_hub, pin, labels):
     out = {"where": "refuse", "why": verdict.why, "hub_admission": audit, "pin": "hub"}
     if on_hub and not machine_hub and not is_hub(pin, cfg):
         out["remedy"] = hub_stay_remedy(structural_reason({**args, "runs_on": None}, cfg), labels,
-                                        assignee=args.get("assignee"), pool_profiles=_Cfg(cfg).assignees())
+                                        assignee=args.get("assignee") or "default", pool_profiles=_Cfg(cfg).assignees())
     return out
 
 
@@ -501,20 +501,20 @@ def hub_stay_remedy(structural, labels, *, assignee=None, pool_profiles=()):
     tailnet work as ``mac-ops`` and, told only "assignee not allowlisted", kept the hub-only profile
     (sweep slug profile-not-in-pool, t_01a1d09e42e2c4fd). [daveey]
     """
-    if labels is not None:
-        first = "drop runs_on (or name labels a pool worker carries) so the card joins the worker pool"
-    elif structural == ASSIGNEE_KEEP:
+    if structural == ASSIGNEE_KEEP:
         pool = sorted(pool_profiles) or ["default"]
         pick = "default" if "default" in pool else pool[0]
         first = (f"assignee {assignee!r} is a profile no pool worker runs (pool profiles: {', '.join(pool)}); "
-                 f"re-create it with assignee={pick!r}, no placement, and runs_on=['capability:<label>'] for the "
-                 "access the work needs (capability:tailnet-exec for commands on a Mac, capability:hub-write "
-                 "for hub-admin changes, capability:hub-read for hub logs and DBs)")
+                 f"re-create it with assignee={pick!r} and no placement; add access constraints only if the work needs it "
+                 "(runs_on=['capability:tailnet-exec'] for commands on a Mac, requires=['hub:write'] "
+                 "for hub-admin changes, runs_on=['capability:hub-read'] for hub logs and DBs)")
     elif structural:
         first = (f"remove what keeps it on this host ({structural}) and omit placement so the card joins the "
                  "worker pool")
     else:
         first = "omit placement (or pass placement='auto') so the card joins the worker pool"
+    if labels is not None:
+        first = "drop runs_on (or name labels a pool worker carries); " + first
     return (f"On the hub, placement='local' is a hub slot and needs an admit. Instead: {first}; or pass "
             "hub_reason quoting what only the hub can do; or, for a question to David, create it with "
             "initial_status='blocked' and a human_request (it takes no slot and is never judged).")
diff --git a/tests/test_kanban_hub_admission_placement.py b/tests/test_kanban_hub_admission_placement.py
index 2a7764fe84..3e16576252 100644
--- a/tests/test_kanban_hub_admission_placement.py
+++ b/tests/test_kanban_hub_admission_placement.py
@@ -204,6 +204,36 @@ def test_origin_and_courier_denies_never_queue(gate, monkeypatch):
     assert hap.pool_route({"title": "x"}, QUEUE_CFG, "hub", audit, ["hub:write"])["runs_on"][0] == "pool:worker"
 
 
+@pytest.mark.parametrize("assignee", [None, ""])
+def test_omitted_assignee_remedy_names_default(gate, assignee):
+    fields = {"title": "Portable work", "placement": "local"}
+    if assignee is not None:
+        fields["assignee"] = assignee
+    result = placement.decide(fields, self_gw="hub", cfg={"assignees": ["bb-tuner"]})
+    assert result["where"] == "refuse"
+    assert "assignee 'default'" in result["remedy"]
+    assert "assignee='bb-tuner'" in result["remedy"]
+
+
+def test_explicit_labels_remedy_also_names_non_pool_assignee(gate):
+    result = placement.decide(
+        {"title": "Portable work", "placement": "local", "assignee": "mac-ops", "runs_on": []},
+        self_gw="hub", cfg={"assignees": ["default"]},
+    )
+    assert result["where"] == "refuse"
+    assert "drop runs_on" in result["remedy"]
+    assert "assignee 'mac-ops'" in result["remedy"]
+    assert "assignee='default'" in result["remedy"]
+
+
+def test_assignee_remedy_access_is_optional_and_uses_hub_contract():
+    from hermes_cli import kanban_hub_admission_placement as hap
+    text = hap.hub_stay_remedy(hap.ASSIGNEE_KEEP, None, assignee="mac-ops", pool_profiles={"default"})
+    assert "only if the work needs it" in text
+    assert "requires=['hub:write']" in text
+    assert "capability:hub-write" not in text
+
+
 def test_assignee_keep_remedy_tracks_structural_reason():
     """The remedy keys on structural_reason's exact text; a reworded reason must not silently drop it."""
     from hermes_cli import kanban_hub_admission_placement as hap
-- 
