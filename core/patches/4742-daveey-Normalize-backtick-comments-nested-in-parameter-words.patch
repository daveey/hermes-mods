From 4081ac886fa1cfcac5bc97e95634e9be1f3e32f9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 03:55:45 +0000
Subject: [PATCH] [daveey] Normalize backtick comments nested in parameter
 words

Route nested backticks through the existing expansion normalizer so comment quotes cannot hide subsequent referenced commands from shlex. Add real-Bash RUN/clean twins for nested and double-quoted contexts. Proof: before fix 2 failures/36 passes; after fix 38 passes; all 23 lifecycle cron suites 1417 passed without retries; health clean.
---
 cron/lifecycle_guard_lines.py                      | 4 +++-
 tests/cron/test_lifecycle_guard_nested_comments.py | 4 ++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/cron/lifecycle_guard_lines.py b/cron/lifecycle_guard_lines.py
index 1c339509956eb3af79090dc6076e4e8a4a5af8f4..bfc6c4c79fb4303063c49be517c919f727eccbec 100644
--- a/cron/lifecycle_guard_lines.py
+++ b/cron/lifecycle_guard_lines.py
@@ -37,7 +37,9 @@ def _parameter_span(text: str, start: int, *, shlex_quotes: bool) -> tuple[int,
     parts = [text[start - 2:start]]
     while pos < len(text) and stack:
         char = text[pos]
-        if text.startswith("$'", pos):
+        if char == "`" or text.startswith("$'", pos):
+            # Nested backticks need the same inner-comment normalization as root
+            # substitutions; otherwise a comment's quote leaks into outer shlex.
             end, span = _expansion(text, pos, in_double=False, shlex_quotes=shlex_quotes)
             parts.extend((text[copied:pos], span))
             pos = copied = end
diff --git a/tests/cron/test_lifecycle_guard_nested_comments.py b/tests/cron/test_lifecycle_guard_nested_comments.py
index 993ffe6d885ad9a50af9478b2cb90fc524814947..6c92e7eb1fbfec8bbd00007f726634f2b7e147fa 100644
--- a/tests/cron/test_lifecycle_guard_nested_comments.py
+++ b/tests/cron/test_lifecycle_guard_nested_comments.py
@@ -15,6 +15,10 @@ PREFIXES = [
     r"echo ${x:-a\} #b}",
     'echo "${x:-a #b}"',
     "echo `echo #it's`",
+    "echo ${x:-`echo #it's`}",
+    "echo ${x:-${y:-`echo #it's`}}",
+    'echo ${x:-"`echo #it\'s`"}',
+    'echo "${x:-`echo #it\'s`}"',
     'echo "`echo #x`"',
     r"echo $'it\'s'#word",
     r"echo $'it\'s' " + "# it's\ntrue",
-- 
