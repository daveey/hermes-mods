+      } else {
+        // Unknown is held, visibly, and is never zero work or done.
+        expect(rowExecution(r)?.unknown).toBe(1)
+        expect(dot).toBe('background')
+        expect(stripe).not.toBe('done')
+      }
+    })
+  }
