diff --git a/hermes_cli/plugins_discovery.py b/hermes_cli/plugins_discovery.py
index 852e667d2d396557b8b548eeb66890ab17e37361..26235e0793cb8efb9082baf0566ca5bd7fe559fa 100644
--- a/hermes_cli/plugins_discovery.py
+++ b/hermes_cli/plugins_discovery.py
@@ -10,6 +10,7 @@ import contextlib
 import contextvars
 import importlib.metadata
 import logging
+import re
 from dataclasses import dataclass
 from pathlib import Path
 from typing import Any, Dict, List, Optional, Set
@@ -131,14 +132,64 @@ def _get_enabled_plugins() -> Optional[set]:
         return None
 
 
+# [daveey] Backup copies left inside a plugins dir (``foo.bak-premacops/``, ``foo.orig/``, ``foo.old/``) are never
+# plugins: one with the live plugin's manifest name sorted after it and silently won discovery, so fixes to the
+# live copy never ran. They are skipped with a warning; move them to ``<home>/plugin-backups/``.
+_BACKUP_DIR_RE = re.compile(r"\.(bak[^/]*|orig|old)$", re.IGNORECASE)
+
+
+def is_backup_plugin_dir(name: str) -> bool:
+    """True for a backup-named directory (``*.bak*``, ``*.orig``, ``*.old``) that discovery must skip."""
+    return bool(_BACKUP_DIR_RE.search(name))
+
+
+@dataclass(frozen=True)
+class PluginDirConflict:
+    """A plugin directory discovery ignored: a backup-named dir, or a same-name copy that lost to *kept*."""
+
+    kind: str  # "backup" | "duplicate"
+    name: str  # manifest key the ignored dir declares ("" when its manifest was not read)
+    ignored: str
+    kept: str = ""
+
+
+def _dedupe_same_name(
+    level: list[PluginManifest], path: Path, conflicts: Optional[list[PluginDirConflict]],
+) -> list[PluginManifest]:
+    """[daveey] Collapse manifests from ONE directory level that share a key: the dir whose basename equals the
+    manifest name wins (else the first in scan order), and every loser is warned about by path. Without this the
+    later sorted dir won silently (``slack-workspace.bak-x`` over ``slack-workspace``)."""
+    groups: dict[str, list[PluginManifest]] = {}
+    for manifest in level:
+        groups.setdefault(manifest_key(manifest), []).append(manifest)
+    keep: dict[str, PluginManifest] = {}
+    for key, group in groups.items():
+        winner = next((m for m in group if m.path and Path(m.path).name == key.rsplit("/", 1)[-1]), group[0])
+        keep[key] = winner
+        for loser in group:
+            if loser is winner:
+                continue
+            if conflicts is not None:
+                conflicts.append(PluginDirConflict("duplicate", key, str(loser.path), str(winner.path)))
+            logger.log(
+                logging.DEBUG if conflicts is not None else logging.WARNING,
+                "Plugin '%s' is declared by two directories in %s: loading %s, ignoring %s (same name; move or "
+                "rename the extra copy)", key, path, winner.path, loser.path,
+            )
+    return [m for m in level if keep.get(manifest_key(m)) is m]
+
+
 def scan_directory(
-    path: Path, source: str, *, skip_names: Optional[set[str]] = None, prefix: str = "", depth: int = 0
+    path: Path, source: str, *, skip_names: Optional[set[str]] = None, prefix: str = "", depth: int = 0,
+    conflicts: Optional[list[PluginDirConflict]] = None,
 ) -> list[PluginManifest]:
     """Read manifests under *path*: flat ``<root>/<name>/plugin.yaml`` (key ``name``) or category
     ``<root>/<cat>/<name>/plugin.yaml`` (key ``cat/name``; a manifest-less directory recurses one level, depth
     capped at two). *skip_names* ignores top-level names; portable ``plugin.json`` packages are accepted
-    alongside YAML manifests."""
+    alongside YAML manifests. Backup-named dirs are skipped and same-name dirs collapse to the basename match
+    (see :func:`_dedupe_same_name`); pass *conflicts* to collect those records (logged at DEBUG instead)."""
     manifests: list[PluginManifest] = []
+    level: list[PluginManifest] = []
     if not path.is_dir():
         return manifests
     try:
@@ -156,6 +207,13 @@ def scan_directory(
         if child.name in _FOREIGN_HARNESS_MANIFEST_DIRS:
             logger.debug("Skipping %s (foreign-harness manifest convention)", child)
             continue
+        if is_backup_plugin_dir(child.name):
+            if conflicts is not None:
+                conflicts.append(PluginDirConflict("backup", _peek_manifest_name(child), str(child)))
+            logger.log(logging.DEBUG if conflicts is not None else logging.WARNING,
+                       "Skipping backup plugin directory %s (backup-named dirs never load; move it to "
+                       "<hermes home>/plugin-backups/)", child)
+            continue
         # pathlib.Path.is_dir() swallows OSError, but injected Path-likes
         # and test doubles can still raise. Fail closed per child.
         try:
@@ -172,18 +230,44 @@ def scan_directory(
         if manifest_file is not None:
             manifest = parse_manifest_file(manifest_file, child, source, prefix)
             if manifest is not None:
+                level.append(manifest)
                 manifests.append(manifest)
         elif has_portable:
             try:
-                manifests.append(portable_plugin_manifest(child, source, prefix))
+                level.append(portable_plugin_manifest(child, source, prefix))
+                manifests.append(level[-1])
             except Exception as exc:
                 logger.warning("Failed to parse %s: %s", portable_file, exc)
         elif depth >= 1:
             logger.debug("Skipping %s (no plugin.yaml, depth cap reached)", child)
         else:
             sub_prefix = f"{prefix}/{child.name}" if prefix else child.name
-            manifests.extend(scan_directory(child, source, prefix=sub_prefix, depth=depth + 1))
-    return manifests
+            manifests.extend(scan_directory(child, source, prefix=sub_prefix, depth=depth + 1, conflicts=conflicts))
+    if len({manifest_key(m) for m in level}) == len(level):
+        return manifests
+    dropped = {id(m) for m in level} - {id(m) for m in _dedupe_same_name(level, path, conflicts)}
+    return [m for m in manifests if id(m) not in dropped]
+
+
+def _peek_manifest_name(plugin_dir: Path) -> str:
+    """Best-effort ``name:`` of a dir's plugin.yaml without full parsing (for conflict reports only)."""
+    for fname in ("plugin.yaml", "plugin.yml"):
+        try:
+            for line in (plugin_dir / fname).read_text(encoding="utf-8", errors="replace").splitlines():
+                m = re.match(r"\s*name\s*:\s*['\"]?([^'\"#\s]+)", line)
+                if m and not line.startswith((" ", "\t")):
+                    return m.group(1)
+        except OSError:
+            continue
+    return ""
+
+
+def plugin_dir_conflicts(path: Path) -> list[PluginDirConflict]:
+    """[daveey] Backup-named and same-name shadowed plugin dirs under *path*, for ``hermes plugins list`` and
+    ``hermes doctor`` (reads manifests only, loads nothing, logs nothing above DEBUG)."""
+    conflicts: list[PluginDirConflict] = []
+    scan_directory(Path(path), "user", conflicts=conflicts)
+    return conflicts
 
 
 def collect_directory_manifests() -> list[PluginManifest]:
diff --git a/tests/hermes_cli/test_plugin_dir_conflicts.py b/tests/hermes_cli/test_plugin_dir_conflicts.py
new file mode 100644
index 0000000000000000000000000000000000000000..aec876858070ba4e24596be67b0e7eed4d3f1de2
--- /dev/null
+++ b/tests/hermes_cli/test_plugin_dir_conflicts.py
@@ -0,0 +1,169 @@
+"""Two plugin dirs in one scope declaring the same manifest ``name`` (#daveey).
+
+A ``slack-workspace.bak-premacops/`` backup (``name: slack-workspace``) left next to the live
+``slack-workspace/`` silently won discovery because the scan is sorted and later manifests win, so
+every fix to the live plugin never ran. Discovery now skips backup-named dirs (``*.bak*``,
+``*.orig``, ``*.old``) and, for any remaining same-name pair, loads the dir whose basename equals the
+name, warning with both paths. ``hermes plugins list`` and ``hermes doctor`` surface the ignored copy.
+"""
+
+import logging
+import sys
+
+import hermes_yaml as yaml
+import pytest
+
+from hermes_cli.plugins import PluginManager
+
+
+def _write_plugin(base, dirname, name=None, probe=None):
+    plugin_dir = base / dirname
+    plugin_dir.mkdir(parents=True, exist_ok=True)
+    name = name or dirname
+    (plugin_dir / "plugin.yaml").write_text(
+        yaml.safe_dump({"name": name, "version": "0.1.0", "description": f"{dirname} copy"}))
+    body = f"import sys; sys._dup_probe = {probe or dirname!r}"
+    (plugin_dir / "__init__.py").write_text(f"def register(ctx):\n    {body}\n")
+    return plugin_dir
+
+
+def _enable(home, names):
+    (home / "config.yaml").write_text(yaml.safe_dump({"plugins": {"enabled": list(names)}}))
+
+
+@pytest.fixture
+def hermes_home(tmp_path, monkeypatch):
+    home = tmp_path / "hermes_home"
+    (home / "plugins").mkdir(parents=True)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_ENABLE_PROJECT_PLUGINS", "0")
+    monkeypatch.setenv("HERMES_BUNDLED_PLUGINS", str(tmp_path / "empty-bundled"))
+    (tmp_path / "empty-bundled").mkdir()
+    yield home
+    if hasattr(sys, "_dup_probe"):
+        del sys._dup_probe
+
+
+def _load(home, caplog):
+    with caplog.at_level(logging.INFO, logger="hermes_cli.plugins"):
+        mgr = PluginManager()
+        mgr.discover_and_load()
+    return mgr
+
+
+class TestSameNameDirsInOneScope:
+    def test_backup_dir_never_shadows_the_live_plugin(self, hermes_home, caplog):
+        plugins = hermes_home / "plugins"
+        live = _write_plugin(plugins, "slack-workspace", probe="live")
+        backup = _write_plugin(plugins, "slack-workspace.bak-premacops", name="slack-workspace", probe="backup")
+        _enable(hermes_home, ["slack-workspace"])
+        mgr = _load(hermes_home, caplog)
+        assert mgr._plugins["slack-workspace"].manifest.path == str(live)
+        assert sys._dup_probe == "live"
+        warnings = [r.getMessage() for r in caplog.records if r.levelno >= logging.WARNING]
+        assert any(str(backup) in w and "backup" in w for w in warnings), warnings
+
+    @pytest.mark.parametrize("suffix", [".bak", ".bak2", ".BAK-old", ".orig", ".old"])
+    def test_backup_suffixes_are_skipped_even_when_unique(self, hermes_home, caplog, suffix):
+        _write_plugin(hermes_home / "plugins", f"solo{suffix}", name="solo")
+        _enable(hermes_home, ["solo"])
+        mgr = _load(hermes_home, caplog)
+        assert "solo" not in mgr._plugins
+        assert not hasattr(sys, "_dup_probe")
+        assert any(f"solo{suffix}" in r.getMessage() for r in caplog.records if r.levelno >= logging.WARNING)
+
+    def test_non_backup_copy_loses_to_basename_match_and_both_paths_are_named(self, hermes_home, caplog):
+        plugins = hermes_home / "plugins"
+        live = _write_plugin(plugins, "thing", probe="live")
+        copy = _write_plugin(plugins, "thing-copy", name="thing", probe="copy")  # sorts after "thing"
+        _enable(hermes_home, ["thing"])
+        mgr = _load(hermes_home, caplog)
+        assert mgr._plugins["thing"].manifest.path == str(live)
+        assert sys._dup_probe == "live"
+        warnings = [r.getMessage() for r in caplog.records if r.levelno >= logging.WARNING]
+        assert any(str(live) in w and str(copy) in w for w in warnings), warnings
+
+    def test_basename_match_wins_regardless_of_scan_order(self, hermes_home, caplog):
+        plugins = hermes_home / "plugins"
+        copy = _write_plugin(plugins, "a-zeta-copy", name="zeta", probe="copy")  # sorts before "zeta"
+        live = _write_plugin(plugins, "zeta", probe="live")
+        _enable(hermes_home, ["zeta"])
+        mgr = _load(hermes_home, caplog)
+        assert mgr._plugins["zeta"].manifest.path == str(live)
+        warnings = [r.getMessage() for r in caplog.records if r.levelno >= logging.WARNING]
+        assert any(str(live) in w and str(copy) in w for w in warnings), warnings
+
+    def test_no_basename_match_keeps_first_and_warns(self, hermes_home, caplog):
+        plugins = hermes_home / "plugins"
+        first = _write_plugin(plugins, "x1", name="thing", probe="x1")
+        second = _write_plugin(plugins, "x2", name="thing", probe="x2")
+        _enable(hermes_home, ["thing"])
+        mgr = _load(hermes_home, caplog)
+        assert mgr._plugins["thing"].manifest.path == str(first)
+        warnings = [r.getMessage() for r in caplog.records if r.levelno >= logging.WARNING]
+        assert any(str(first) in w and str(second) in w for w in warnings), warnings
+
+    def test_unrelated_plugins_raise_no_conflict(self, hermes_home, caplog):
+        from hermes_cli.plugins_discovery import plugin_dir_conflicts
+        _write_plugin(hermes_home / "plugins", "alpha")
+        _write_plugin(hermes_home / "plugins", "beta")
+        _enable(hermes_home, ["alpha", "beta"])
+        _load(hermes_home, caplog)
+        assert not [r for r in caplog.records if r.levelno >= logging.WARNING and "plugin" in r.getMessage().lower()
+                    and ("backup" in r.getMessage() or "same name" in r.getMessage())]
+        assert plugin_dir_conflicts(hermes_home / "plugins") == []
+
+
+class TestConflictsAreSurfaced:
+    def _setup(self, home):
+        plugins = home / "plugins"
+        live = _write_plugin(plugins, "slack-workspace")
+        backup = _write_plugin(plugins, "slack-workspace.bak-premacops", name="slack-workspace")
+        dup = _write_plugin(plugins, "slack-copy", name="slack-workspace")
+        return live, backup, dup
+
+    def test_plugin_dir_conflicts_lists_backup_and_shadowed_copy(self, hermes_home):
+        from hermes_cli.plugins_discovery import plugin_dir_conflicts
+        live, backup, dup = self._setup(hermes_home)
+        conflicts = plugin_dir_conflicts(hermes_home / "plugins")
+        by_path = {c.ignored: c for c in conflicts}
+        assert set(by_path) == {str(backup), str(dup)}
+        assert by_path[str(backup)].kind == "backup"
+        assert by_path[str(dup)].kind == "duplicate"
+        assert by_path[str(dup)].kept == str(live)
+        assert by_path[str(dup)].name == "slack-workspace"
+
+    def test_listing_shows_the_live_copy(self, hermes_home):
+        from hermes_cli.plugins_cmd import _discover_all_plugins
+        live, _backup, _dup = self._setup(hermes_home)
+        rows = {r[5]: r for r in _discover_all_plugins()}
+        assert str(rows["slack-workspace"][4]) == str(live)
+
+    def test_plugins_list_prints_the_shadowed_copies(self, hermes_home, capsys):
+        from types import SimpleNamespace
+        from hermes_cli.plugins_cmd_listing import cmd_list
+        _live, backup, dup = self._setup(hermes_home)
+        cmd_list(SimpleNamespace(plain=True, json=False))
+        out = capsys.readouterr()
+        text = out.out + out.err
+        assert str(backup) in text and str(dup) in text
+
+    def test_doctor_warns_about_shadowed_copies(self, hermes_home, monkeypatch):
+        from hermes_cli import doctor_state as ds
+        _live, backup, dup = self._setup(hermes_home)
+        warned = []
+        monkeypatch.setattr(ds, "check_warn", lambda text, detail="": warned.append(f"{text} {detail}"))
+        monkeypatch.setattr(ds, "check_ok", lambda *a, **k: None)
+        finding = ds._check_plugin_dir_conflicts(False)
+        joined = "\n".join(warned)
+        assert str(backup) in joined and str(dup) in joined
+        assert finding.manual_issues
+
+    def test_doctor_is_quiet_when_clean(self, hermes_home, monkeypatch):
+        from hermes_cli import doctor_state as ds
+        _write_plugin(hermes_home / "plugins", "alpha")
+        warned = []
+        monkeypatch.setattr(ds, "check_warn", lambda text, detail="": warned.append(text))
+        monkeypatch.setattr(ds, "check_ok", lambda *a, **k: None)
+        finding = ds._check_plugin_dir_conflicts(False)
+        assert warned == [] and not finding.manual_issues
-- 
2.55.0

