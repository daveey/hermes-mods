From fca7545a028bcf98a9a6cdfb38961afe9a7e5ed0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 22 Oct 2026 20:31:00 -0700
Subject: [PATCH] fix(plugins): a same-name backup dir never shadows the live
 plugin [daveey]

Two plugin dirs in one scope declaring the same manifest name were resolved by
scan order (later sorted dir wins, silently), so a slack-workspace.bak-premacops/
backup next to slack-workspace/ loaded instead of the live plugin.

- discovery skips backup-named dirs (*.bak*, *.orig, *.old) with a WARNING
- same-name dirs in one level: the dir whose basename == name wins, WARNING names both paths
- hermes plugins list prints ignored/shadowed copies (stderr in --plain/--json)
- hermes doctor: new 'Plugin Directories' check
---
diff --git a/hermes_cli/doctor_state.py b/hermes_cli/doctor_state.py
index 5812a8c93b171a91cc6c538c797e87cc77517f7e..5cbd34a675b3e8968c29cab02def75d61329f24b 100644
--- a/hermes_cli/doctor_state.py
+++ b/hermes_cli/doctor_state.py
@@ -546,6 +546,26 @@ def _plugin_provenance_rows(plugins_dir) -> list:
     return rows or [("info", "No provenanced plugins found", "")]
 
 
+@doctor_check("Plugin directory conflict check failed: {e}")
+def _check_plugin_dir_conflicts(should_fix: bool, f: Finding) -> None:
+    """[daveey] Warn about plugin dirs discovery ignores: backup-named copies (``*.bak*``/``.orig``/``.old``) and
+    same-name copies shadowed by the basename match. A backup once silently replaced a live plugin."""
+    from hermes_constants import get_hermes_home
+    from hermes_cli.plugins_discovery import plugin_dir_conflicts
+
+    plugins_dir = get_hermes_home() / "plugins"
+    conflicts = plugin_dir_conflicts(plugins_dir) if plugins_dir.is_dir() else []
+    if not conflicts:
+        check_ok("No backup or same-name duplicate plugin directories")
+        return
+    for c in conflicts:
+        if c.kind == "backup":
+            check_warn(f"Backup plugin dir inside plugins/: {c.ignored}", "(never loads; move it to plugin-backups/)")
+        else:
+            check_warn(f"Plugin '{c.name}' has a shadowed copy: {c.ignored}", f"(loading {c.kept})")
+    f.manual_issues.append(f"Move ignored plugin copies out of {plugins_dir} (e.g. to {get_hermes_home() / 'plugin-backups'})")
+
+
 @doctor_check("")
 def _check_update_provenance(should_fix: bool, f: Finding) -> None:
     """Inspect local plugin update provenance without network or writes."""
