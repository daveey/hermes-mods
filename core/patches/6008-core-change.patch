From: daveey <daveey@users.noreply.github.com>
Date: Mon, 23 Nov 2026 23:38:17 +0000
Subject: [PATCH 6008] Test fixture and flake hardening (no production behavior)

Public mirror of source commit 8740478bdbcdef0b4b7e1a4dd4c4115a4c827d62.

---
diff --git a/scripts/run_tests_launch.py b/scripts/run_tests_launch.py
index 48b8d2a0e37..e048878a225 100644
--- a/scripts/run_tests_launch.py
+++ b/scripts/run_tests_launch.py
@@ -165,7 +165,10 @@
     """
     server = _fork_server_for_run(repo_root)
     # Temporary, targeted evidence for tests passing then hanging at interpreter exit.
-    if file.resolve() == (repo_root / "tests/gateway/test_derived_session_after_delete.py").resolve():
+    if file.resolve() in {
+        (repo_root / "tests/gateway/test_derived_session_after_delete.py").resolve(),
+        (repo_root / "tests/gateway/test_authenticated_session_identity.py").resolve(),
+    }:
         pytest_args = [*pytest_args, "-p", "scripts.pytest_exit_diagnostics"]
     selection = list(targets) if targets else [str(file)]
     # The first files copied os.environ before the knob was popped; no test sees it.
diff --git a/tests/scripts/test_pytest_exit_diagnostics.py b/tests/scripts/test_pytest_exit_diagnostics.py
index 8b90047b3ae..f3541329e46 100644
--- a/tests/scripts/test_pytest_exit_diagnostics.py
+++ b/tests/scripts/test_pytest_exit_diagnostics.py
@@ -176,13 +176,14 @@
 
 
 @pytest.mark.platforms("posix")
-@pytest.mark.parametrize("affected", [True, False])
-def test_launcher_instruments_only_affected_file(tmp_path, monkeypatch, affected):
+@pytest.mark.parametrize("name", ["test_derived_session_after_delete.py", "test_authenticated_session_identity.py", "test_other.py"])
+def test_launcher_instruments_only_affected_file(tmp_path, monkeypatch, name):
     monkeypatch.setattr(launch, "_fork_server_for_run", lambda root: None)
     popen = Mock(return_value=SimpleNamespace(pid=123))
     monkeypatch.setattr(launch.subprocess, "Popen", popen)
     monkeypatch.setattr(launch.os, "getpgid", lambda pid: pid)
-    file = tmp_path / ("tests/gateway/test_derived_session_after_delete.py" if affected else "test_other.py")
+    affected = name != "test_other.py"
+    file = tmp_path / "tests/gateway" / name
     args = ["-q"]
     launch.start_pytest(file, args, tmp_path, {}, str(tmp_path))
     assert (PLUGIN in popen.call_args.args[0]) is affected
