From a62d6d73c122798b641c65a8db157dcb83457b47 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 11:15:08 +0000
Subject: [PATCH] fix(kanban): report removed pinned skills to the worker
 instead of crashing [daveey]

---
 gateway/session_kanban.py                        | 14 ++++++++++----
 .../core/kanban/test_kanban_worker_contract.py   |  4 +++-
 tests/e2e/core/providers/_catalog_helpers.py     | 13 +++++--------
 .../providers/test_catalog_gateway_lifecycle.py  | 16 ++++++++++++++++
 4 files changed, 34 insertions(+), 13 deletions(-)
 create mode 100644 tests/e2e/core/providers/test_catalog_gateway_lifecycle.py

diff --git a/gateway/session_kanban.py b/gateway/session_kanban.py
index 0d9ed676abd..fdcd9d69970 100644
--- a/gateway/session_kanban.py
+++ b/gateway/session_kanban.py
@@ -420,10 +420,16 @@ KANBAN_TURN_AUTHOR = {'id': 'kanban:dispatcher', 'name': 'Kanban dispatcher', 'i
 
 def _run_task_turns(agent, frame, history, context):
     from agent.skill_commands import build_preloaded_skills_prompt
-    skills, loaded, missing = build_preloaded_skills_prompt(context['skills'], task_id=agent.session_id)
-    if missing and not loaded:
-        raise ValueError('kanban_skills_unavailable')
-    prompt = '\n\n'.join(p for p in (skills, context['context'], frame['text']) if p)
+    skills, _loaded, missing = build_preloaded_skills_prompt(context['skills'], task_id=agent.session_id)
+    # Pins were validated when the card was created; a later removal must reach the worker,
+    # not crash it before it can report or recover the stale prerequisite.
+    warning = ''
+    if missing:
+        from agent.skill_commands import format_missing_skills
+        import logging
+        warning = f'Pinned skills unavailable: {format_missing_skills(missing)}. Do not assume their instructions were loaded.'
+        logging.getLogger(__name__).warning('%s', warning)
+    prompt = '\n\n'.join(p for p in (skills, warning, context['context'], frame['text']) if p)
     result = agent.run_conversation(prompt, conversation_history=history, turn_author=KANBAN_TURN_AUTHOR)
 
     def recover(nudge):
diff --git a/tests/e2e/core/kanban/test_kanban_worker_contract.py b/tests/e2e/core/kanban/test_kanban_worker_contract.py
index e7dc953d455..ed63527f9b1 100644
--- a/tests/e2e/core/kanban/test_kanban_worker_contract.py
+++ b/tests/e2e/core/kanban/test_kanban_worker_contract.py
@@ -177,7 +177,9 @@ def test_worker_with_unresolvable_pinned_skill_still_starts_its_session(tmp_path
                             raises=KnownGap):
                 if not srv.main_requests() and ((exits and exits[-1] != 0) or "e2e-archived" in log):
                     raise KnownGap(f"worker died before its session (exits={exits}); board:\n{board.diag(tid)}")
-            assert SKILL_MARK not in str(srv.main_requests()[0]["messages"]), "removed skill still loaded"
+            first = srv.main_requests()[0]["messages"]
+            assert SKILL_MARK not in str(first), "removed skill still loaded"
+            assert "e2e-archived" in str(first) and "Pinned skills unavailable" in str(first)
             assert board.task(tid)["status"] == "done", board.diag(tid)
         finally:
             board.kill_workers()
diff --git a/tests/e2e/core/providers/_catalog_helpers.py b/tests/e2e/core/providers/_catalog_helpers.py
index 59ce7f416ab..77cd59dc7f7 100644
--- a/tests/e2e/core/providers/_catalog_helpers.py
+++ b/tests/e2e/core/providers/_catalog_helpers.py
@@ -221,14 +221,11 @@ def write_home(root: Path, model: dict[str, Any], extra_cfg: dict[str, Any] | No
 
 
 def stop_auto_started_gateway(hermes_home: Path, timeout: float = 30.0) -> None:
-    """Stop the daemon a ``hermes -z`` client auto-started for this hermetic home.
-
-    The oneshot client spawns the home's gateway (``ensure_gateway_runtime``), which outlives the
-    client for ``gateway.unmanaged_idle_exit_seconds`` (600 s). A matrix shard drives dozens of
-    homes, so un-reaped daemons (each a full gateway: cron, kanban dispatcher, housekeeping) pile up
-    across the whole E2E run and starve later children of CPU/RAM until they miss ``TURN_TIMEOUT``
-    with no request ever sent. Only the live process the gateway's own identity check proves is
-    this home's gateway is signalled (a recycled PID in a stale record is left alone).
+    """Stop this row's daemon before its fake/proxy closes or another row starts.
+
+    Oneshot clients leave a shared runtime alive for 600 s. Retaining dozens of sandbox
+    gateways leaks processes and lets background requests outlive their proxy's ownership.
+    Only signal the live process the canonical identity check proves belongs to this home.
     """
     import psutil
     from gateway.status import live_gateway_pid_for_home
diff --git a/tests/e2e/core/providers/test_catalog_gateway_lifecycle.py b/tests/e2e/core/providers/test_catalog_gateway_lifecycle.py
new file mode 100644
index 00000000000..b943bd8f494
--- /dev/null
+++ b/tests/e2e/core/providers/test_catalog_gateway_lifecycle.py
@@ -0,0 +1,16 @@
+"""Catalog turns own the auto-started sandbox daemon as well as the short-lived CLI."""
+import pytest
+
+from gateway.status import live_gateway_pid_for_home
+from tests.e2e.core.providers._catalog_helpers import FINAL, discover_catalog, drive_turn
+
+
+# The sandbox daemon is reparented when its oneshot viewer exits; cleanup proves its home identity.
+@pytest.mark.live_system_guard_bypass
+def test_catalog_turn_stops_its_sandbox_gateway(tmp_path):
+    catalog = discover_catalog()
+    row = next(r for r in catalog if r.api_mode == "chat_completions" and r.skip_reason() is None)
+    result = drive_turn(row, tmp_path, catalog)
+    assert result.rc == 0 and FINAL in result.stdout, result.detail()
+    home = tmp_path / "home" / ".hermes"
+    assert live_gateway_pid_for_home(home) is None, "catalog row left its gateway running"
-- 
