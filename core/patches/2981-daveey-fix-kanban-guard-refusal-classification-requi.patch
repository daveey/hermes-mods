From f3a03dcf34a230daf80d552b244d250bc87922c2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 18:12:29 +0000
Subject: [PATCH] [daveey] fix(kanban): guard-refusal classification requires
 the result to BE the refusal on a park/report/complete call

Review 5879504029 (request changes): refused_kanban_calls matched the refusal marker as a substring of any
kanban_* tool result, so a plain kanban_show of a card whose body quotes the marker rebooked a genuine
clean-exit protocol violation as an uncounted owner_restart.

- Parse the tool result as JSON and require its "error" to start with the marker.
- Count only TERMINAL_KANBAN_TOOLS (the lifecycle-exempt set + kanban_complete): a refused read
  (kanban_show/kanban_list) does not stop a worker from parking.
- Read the full content (no 2000-char substr that could truncate the JSON).
- Docstring: reusing owner_restart bookkeeping (cooldown, owner-restart labels) is intended.
- Tests: quoted-in-success, quoted-in-other-error, refused-read-only controls stay protocol violations;
  a refused kanban_complete counts as a host refusal.
---
 hermes_cli/kanban_guard_refusal.py            | 30 ++++++++++++---
 tests/hermes_cli/test_kanban_guard_refusal.py | 38 +++++++++++++++++++
 2 files changed, 63 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/kanban_guard_refusal.py b/hermes_cli/kanban_guard_refusal.py
index 85922632a4..860b4bab68 100644
--- a/hermes_cli/kanban_guard_refusal.py
+++ b/hermes_cli/kanban_guard_refusal.py
@@ -13,6 +13,10 @@ call, the run is rebooked like a run lost to its owner's restart: requeued, no f
 (the ``owner_restart`` bookkeeping, which the Board's neutral release already knows), with
 ``guard_refusal`` in the run metadata and the refused tools in the error text. A run that never attempted a
 Kanban call, or whose refusals are older than its last few tool results, stays a protocol violation.
+Only a park/report/complete call counts (``TERMINAL_KANBAN_TOOLS``), and its result must BE the refusal,
+not quote it. Reusing the owner-restart bookkeeping is intended, side effects included: the next dispatch
+waits out the owner-restart cooldown, which outlasts the guard's 60 s suppression window, and diagnostics
+label the run an owner restart (``exit_kind`` / ``guard_refusal`` in its event and run metadata tell them apart).
 (``kanban_host_refusal`` is the unrelated startup/owner-storage proof.)
 """
 from __future__ import annotations
@@ -24,12 +28,16 @@ from contextlib import closing
 from pathlib import Path
 from typing import Optional
 
-from hermes_cli.plugins_dispatch import _PRE_TOOL_CALL_TIMEOUT_BLOCK_MESSAGE as REFUSAL_MARKER
+from hermes_cli.plugins_dispatch import (
+    _HOOK_SKIP_EXEMPT_LIFECYCLE_TOOLS, _PRE_TOOL_CALL_TIMEOUT_BLOCK_MESSAGE as REFUSAL_MARKER)
 
 logger = logging.getLogger(__name__)
 PAYLOAD_KEY = "guard_refusal"
 # The worker's last tool results that count as "how the run ended".
 TAIL_TOOL_RESULTS = 6
+# The calls a worker ends a run with. A refused read (kanban_show/kanban_list) does not stop a worker from
+# parking, so it is no excuse for a clean exit without a terminal call.
+TERMINAL_KANBAN_TOOLS = _HOOK_SKIP_EXEMPT_LIFECYCLE_TOOLS | {"kanban_complete"}
 # Consecutive uncounted guard-refusal runs before the next one is charged as a protocol violation again.
 STREAK_LIMIT = 3
 
@@ -50,9 +58,21 @@ def _prior_refusal_streak(conn: sqlite3.Connection, task_id: str, run_id) -> int
     return streak
 
 
+def _is_guard_refusal(content) -> bool:
+    """The tool result IS the skipped-guard refusal (``tool_error``'s ``{"error": "<marker>..."}``), not
+    merely a result quoting it (a ``kanban_show`` of a card whose body cites the marker)."""
+    try:
+        body = json.loads(content or "")
+    except (TypeError, ValueError):
+        return False
+    error = body.get("error") if isinstance(body, dict) else None
+    return isinstance(error, str) and error.startswith(REFUSAL_MARKER)
+
+
 def refused_kanban_calls(conn: Optional[sqlite3.Connection], task_id: str, run_id) -> list[str]:
-    """Kanban tools among *run_id*'s last ``TAIL_TOOL_RESULTS`` tool results that a skipped
-    ``pre_tool_call`` guard refused, oldest first; ``[]`` when none or the session can't be read."""
+    """Park/report/complete Kanban tools (``TERMINAL_KANBAN_TOOLS``) among *run_id*'s last
+    ``TAIL_TOOL_RESULTS`` tool results whose result is a skipped ``pre_tool_call`` guard's refusal,
+    oldest first; ``[]`` when none or the session can't be read."""
     if conn is None or not task_id or run_id is None:
         return []
     try:
@@ -67,14 +87,14 @@ def refused_kanban_calls(conn: Optional[sqlite3.Connection], task_id: str, run_i
     try:
         with closing(sqlite3.connect(Path(state_db).as_uri() + "?mode=ro", uri=True, timeout=2)) as state:
             rows = state.execute(
-                "SELECT tool_name, substr(content, 1, 2000) FROM messages "
+                "SELECT tool_name, content FROM messages "
                 "WHERE session_id=? AND role='tool' ORDER BY id DESC LIMIT ?",
                 (session_id, TAIL_TOOL_RESULTS)).fetchall()
     except (OSError, ValueError, sqlite3.Error):
         logger.debug("guard refusal: session %s unreadable", session_id, exc_info=True)
         return []
     return [str(name) for name, content in reversed(rows)
-            if str(name or "").startswith("kanban_") and REFUSAL_MARKER in (content or "")]
+            if name in TERMINAL_KANBAN_TOOLS and _is_guard_refusal(content)]
 
 
 def note(dead, conn: Optional[sqlite3.Connection], task_id: Optional[str], run_id) -> None:
diff --git a/tests/hermes_cli/test_kanban_guard_refusal.py b/tests/hermes_cli/test_kanban_guard_refusal.py
index 4c806ddd92..f0b9e2e7cd 100644
--- a/tests/hermes_cli/test_kanban_guard_refusal.py
+++ b/tests/hermes_cli/test_kanban_guard_refusal.py
@@ -135,6 +135,44 @@ def test_old_refusal_outside_the_tail_stays_a_protocol_violation(kanban_home):
         assert "failure_finalized" in kinds
 
 
+@pytest.mark.parametrize("tail", [
+    # A plain kanban_show whose card body quotes the refusal text: the call succeeded (review 5879504029).
+    [("kanban_show", json.dumps({"task": {"body": f"refusal was: {json.loads(REFUSAL)['error']}"}}))],
+    # A refusal that does not START the error field is some other error quoting it.
+    [("kanban_comment", json.dumps({"error": f"comment rejected; body quoted {json.loads(REFUSAL)['error']}"}))],
+    # A refused read does not stop a worker from parking: no excuse for exiting without a terminal call.
+    [("kanban_show", REFUSAL), ("kanban_list", REFUSAL)],
+], ids=["quoted-in-success", "quoted-in-other-error", "refused-read-only"])
+def test_non_refusal_kanban_results_stay_a_protocol_violation(kanban_home, tail):
+    """Controls: only a terminal/lifecycle Kanban call whose result IS the guard refusal counts."""
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="t", assignee="default")
+        run_id = _clean_exit(conn, tid, 70104)
+        _session(kanban_home, conn, tid, run_id, tail)
+
+        kbd.detect_crashed_workers(conn)
+
+        run, kinds, _task = _booking(conn, tid)
+        meta = json.loads(run["metadata"])
+        assert meta.get("protocol_violation") is True and not meta.get("guard_refusal")
+        assert "failure_finalized" in kinds and "owner_restart_lost" not in kinds
+        assert kbd._protocol_violation_streak(conn, tid) == 1
+
+
+def test_refused_kanban_complete_counts_as_host_refusal(kanban_home):
+    """kanban_complete stays fail-closed during a skip, so its refusal is a host refusal too."""
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="t", assignee="default")
+        run_id = _clean_exit(conn, tid, 70105)
+        _session(kanban_home, conn, tid, run_id, [("read_file", '{"content": "x"}'), ("kanban_complete", REFUSAL)])
+
+        kbd.detect_crashed_workers(conn)
+
+        run, kinds, task = _booking(conn, tid)
+        assert json.loads(run["metadata"])["guard_refusal"] == {"refused_tools": ["kanban_complete"]}
+        assert task.status == "ready" and "failure_finalized" not in kinds
+
+
 def test_refusal_streak_is_bounded(kanban_home):
     """A guard that stays hung must not requeue a card uncounted forever: after ``STREAK_LIMIT`` such runs
     the next one is charged as a protocol violation again."""
