From 0338055477defcd8d05d7abcb1e3c2d587d799f5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 06:27:23 +0000
Subject: [PATCH] fix(tests): anchor archive comments to persisted move time
 [daveey]

The fixture wrote its archive comment before the moved event, then added
one second to the comment and expected it to postdate the move. Crossing
a second boundary makes those timestamps equal (or leaves the comment
older), so the production strict-greater-than window correctly rejects it.

Exercise zero-, one-, and two-second comment-to-move gaps explicitly.
Anchor same-second exclusion and post-move acceptance to the persisted
moved timestamp, keeping the failed-new-reference/no-old-fallback check.
No production portability or test retry policy changes.

Proof: incident 1482c3589ee6 isolated and whole-file baseline 21 passed.
Controlled old fixture: gap 0 passes; gaps 1 and 2 fail at acceptance.
Fixed incident and current-main whole-file: 23 passed with
HERMES_TEST_FILE_RETRIES=0. Full scripts/check passes in PM test venv.
Historical CI recorded no event timestamps; the controlled interleaving
confirms the fixture vulnerability, not an unrecorded historical schedule.

Co-Authored-By: OpenAI GPT-6.1 <noreply@openai.com>
---
 tests/hermes_cli/test_kanban_continue_archive.py | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_continue_archive.py b/tests/hermes_cli/test_kanban_continue_archive.py
index f8f5175387..394d663b95 100644
--- a/tests/hermes_cli/test_kanban_continue_archive.py
+++ b/tests/hermes_cli/test_kanban_continue_archive.py
@@ -65,16 +65,26 @@ def test_reference_scope(w2, monkeypatch, mutation):
     assert archive.portable(w2.conn, tid, text) is (mutation == "valid")
 
 
-def test_comments_after_move_and_no_old_fallback(w2, monkeypatch):
+@pytest.mark.parametrize("move_gap", [0, 1, 2])
+def test_comments_after_move_and_no_old_fallback(w2, monkeypatch, move_gap):
     tid, text = _task(w2, monkeypatch)
     _backdate_run(w2.conn, tid, 5)
     kb.add_comment(w2.conn, tid, author="default", body=text)
     with kb.write_txn(w2.conn):
         kb._append_event(w2.conn, tid, "moved", {})
+        # Exercise a move in the comment's second, the next second, or after a pause.
+        w2.conn.execute("UPDATE task_events SET created_at = "
+                        "(SELECT MAX(created_at) FROM task_comments WHERE task_id = ?) + ? "
+                        "WHERE task_id = ? AND kind = 'moved'", (tid, move_gap, tid))
+        moved_at = w2.conn.execute("SELECT MAX(created_at) FROM task_events "
+                                   "WHERE task_id = ? AND kind = 'moved'", (tid,)).fetchone()[0]
     monkeypatch.setattr(archive, "verify", lambda *args: True)
     assert not archive.portable(w2.conn, tid, "resume")
     with kb.write_txn(w2.conn):
-        w2.conn.execute("UPDATE task_comments SET created_at = created_at + 1 WHERE task_id = ?", (tid,))
+        w2.conn.execute("UPDATE task_comments SET created_at = ? WHERE task_id = ?", (moved_at, tid))
+    assert not archive.portable(w2.conn, tid, "resume")  # Same-second publication is excluded.
+    with kb.write_txn(w2.conn):
+        w2.conn.execute("UPDATE task_comments SET created_at = ? WHERE task_id = ?", (moved_at + 1, tid))
     assert archive.portable(w2.conn, tid, "resume")
     monkeypatch.setattr(archive, "verify", lambda path, sha, *args: sha == 'a' * 64)
     assert not archive.portable(w2.conn, tid, text.replace('a' * 64, 'b' * 64))
