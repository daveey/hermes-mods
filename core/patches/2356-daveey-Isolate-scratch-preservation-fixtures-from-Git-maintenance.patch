From db32032f11f52385d0541cefedee3f803df8a0e9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:17:15 +0000
Subject: [PATCH] [daveey] Isolate scratch preservation fixtures from Git
 maintenance

---
 .../test_kanban_scratch_git_preservation.py     | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_scratch_git_preservation.py b/tests/hermes_cli/test_kanban_scratch_git_preservation.py
index 478ea0a7c97..cf584ab1230 100644
--- a/tests/hermes_cli/test_kanban_scratch_git_preservation.py
+++ b/tests/hermes_cli/test_kanban_scratch_git_preservation.py
@@ -50,6 +50,8 @@ def repository(ws, state):
     git(repo, "init", "--bare" if state == "bare" else "--quiet")
     if state == "bare":
         return repo
+    # Snapshot all Git metadata without racing a detached auto-maintenance job.
+    git(repo, "config", "maintenance.auto", "false")
     git(repo, "config", "user.email", "test@example.invalid")
     git(repo, "config", "user.name", "Test")
     (repo / "tracked").write_text("initial")
@@ -66,6 +68,21 @@ def repository(ws, state):
     return repo
 
 
+def test_repository_setup_does_not_spawn_background_maintenance(tmp_path, monkeypatch):
+    # Even a tiny commit launches auto-maintenance, which can briefly create
+    # objects/maintenance.lock after the foreground Git command has returned.
+    trace = tmp_path / "git-trace.jsonl"
+    monkeypatch.setenv("GIT_TRACE2_EVENT", str(trace))
+    repository(tmp_path / "workspace", "unpushed")
+    children = [json.loads(line) for line in trace.read_text().splitlines()]
+    maintenance = [
+        event for event in children
+        if event.get("event") == "child_start"
+        and event.get("argv", [])[:2] == ["git", "maintenance"]
+    ]
+    assert not maintenance, maintenance
+
+
 def snapshot(ws):
     return {str(p.relative_to(ws)): p.read_bytes() for p in ws.rglob("*") if p.is_file()}
 
