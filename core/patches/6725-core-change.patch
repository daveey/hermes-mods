   expect(next.container.querySelector('[data-card-timer]')).toBeNull()
   act(() => setSessions([]))
 })
+
+it.each(['lane', 'preview'] as const)('a project-tree %s known-empty read clears an unmounted timer', source => {
+  vi.useFakeTimers({ now: NOW * 1000 })
+  const first = render(view(row({ kanban_observed_at: NOW, kanban_timed_cards: cards })))
+  first.unmount()
+  act(() => vi.advanceTimersByTime(120_000))
+  const empty = row({ kanban_observed_at: NOW + 120 })
+  act(() => $projectTree.set([{
+    id: 'project', label: 'Project', path: null, sessionCount: 1,
+    previewSessions: source === 'preview' ? [empty] : [],
+    repos: [{ id: 'repo', label: 'Repo', path: null, sessionCount: 1,
+      groups: [{ id: 'lane', label: 'Lane', path: null, sessions: source === 'lane' ? [empty] : [] }] }]
+  }]))
+  const next = render(view(row({ kanban_unknown: true })))
+  expect(next.container.querySelector('[data-card-timer]')).toBeNull()
+  act(() => $projectTree.set([]))
+})
diff --git a/apps/desktop/src/store/project-tree.ts b/apps/desktop/src/store/project-tree.ts
index 9053969721fcf6bfb13a3491619d116346b3303d..9ab0becb580159b794a79b29814f577f13d9f3fe 100644
--- a/apps/desktop/src/store/project-tree.ts
+++ b/apps/desktop/src/store/project-tree.ts
@@ -1,6 +1,7 @@
 import { atom } from 'nanostores'
 
 import type { SidebarProjectTree } from '@/app/chat/sidebar/projects/workspace-groups'
+import { rememberRowTimers } from '@/app/chat/sidebar/session-row-timer-memory'
 
 // The project tree atom lives in this leaf so store/session-states.ts can
 // read it (a focused tile's session is often older than the paginated recents
@@ -9,3 +10,15 @@
 // suite that partially mocks the gateway. store/projects.ts owns all writes
 // and re-exports the atom so existing call sites keep their import path.
 export const $projectTree = atom<SidebarProjectTree[]>([])
+
+// Virtualized project rows can receive a known-zero update without mounting.
+$projectTree.listen(projects => {
+  for (const project of projects) {
+    project.previewSessions?.forEach(rememberRowTimers)
+    for (const repo of project.repos) {
+      for (const group of repo.groups) {
+        group.sessions.forEach(rememberRowTimers)
+      }
+    }
+  }
+})
