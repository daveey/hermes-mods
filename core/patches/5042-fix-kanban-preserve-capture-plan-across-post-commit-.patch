From bbd93d4c24d3bc5f23a1d8b11c7b9e74d0a6c683 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 22:05:38 +0000
Subject: [PATCH] fix(kanban): preserve capture plan across post-commit
 failures [daveey]

Review 5984010060 found that journal.arm commits before its status read.
The previous return-based armed flag could erase a committed capture's plan.
Use SQLite's transactional schema cookie to distinguish committed table
creation/replacement from rollback, including same-id same-millisecond
replacement. Keep the plan if rollback cannot be established. Explicitly
roll back interrupted open transactions before checking the cookie.

Regression: OSError and KeyboardInterrupt after real commit, with and without
same-id replacement; pre-commit failures restore both journal and plan.
Also pin the two surviving review mutants: dispatcher lease remains held
until cancelled close completes, and every required fcntl attribute is checked.

Proof: post-commit regression red on 0e5a50c27c; both surviving mutants killed
(4 failed cases). Restored focused suite green; 78 consumer files / 1167 tests
passed; full scripts/check passed. No live capture or default changes.
---
 scripts/kanban_fairness.py                    | 12 ++++-
 .../test_kanban_dispatcher_capture_cancel.py  |  9 +++-
 ...est_kanban_fairness_activation_platform.py |  7 ++-
 .../test_kanban_fairness_arm_rollback.py      | 47 +++++++++++++++++++
 4 files changed, 70 insertions(+), 5 deletions(-)

diff --git a/scripts/kanban_fairness.py b/scripts/kanban_fairness.py
index fa85489b2f..827f7bdbac 100644
--- a/scripts/kanban_fairness.py
+++ b/scripts/kanban_fairness.py
@@ -102,8 +102,16 @@ def _arm(args) -> int:
     armed = False
     try:
         with _connect(db) as conn:
-            state = journal.arm(conn, args.capture_id, replace=args.replace)
-            armed = True
+            schema_before = conn.execute("PRAGMA schema_version").fetchone()[0]
+            # arm always creates (or replaces) its tables transactionally. The
+            # schema cookie witnesses commit even for same-id, same-ms replacement.
+            armed = True  # Keep the plan unless rollback is positively established.
+            try:
+                state = journal.arm(conn, args.capture_id, replace=args.replace)
+            except BaseException:
+                conn.rollback()  # Also discard a transaction interrupted by Ctrl-C.
+                armed = conn.execute("PRAGMA schema_version").fetchone()[0] != schema_before
+                raise
             store.drain(conn, out)
     except BaseException:
         # Budget admission comes first; only roll back before the journal is armed.
diff --git a/tests/gateway/test_kanban_dispatcher_capture_cancel.py b/tests/gateway/test_kanban_dispatcher_capture_cancel.py
index f708774fa2..07c0e9aca3 100644
--- a/tests/gateway/test_kanban_dispatcher_capture_cancel.py
+++ b/tests/gateway/test_kanban_dispatcher_capture_cancel.py
@@ -261,8 +261,13 @@ def test_cancel_during_close_releases_lease_and_session_not_open(monkeypatch):
         task = asyncio.create_task(_held(runner, lease))
         await asyncio.to_thread(entered.wait, 5)
         task.cancel()
-        await asyncio.sleep(0)
-        await asyncio.gather(_expect_cancelled(task), asyncio.to_thread(proceed.wait, 5))
+        try:
+            await asyncio.sleep(0)
+            assert released == [], "lease released before capture.close completed"
+            assert runner._kanban_dispatcher_lock_handle is lease.handle
+            assert session.open
+        finally:
+            await asyncio.gather(_expect_cancelled(task), asyncio.to_thread(proceed.wait, 5))
 
     asyncio.run(run())
     assert session.close_calls == 1
diff --git a/tests/hermes_cli/test_kanban_fairness_activation_platform.py b/tests/hermes_cli/test_kanban_fairness_activation_platform.py
