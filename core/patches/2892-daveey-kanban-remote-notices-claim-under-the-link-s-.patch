+def _remote_item(tid, event_id):
+    return {"text": f"✔ Remote Kanban card {tid} on worker-2 completed.\nResult: {tid} verdict",
+            "ref": f"worker-2/default/default/{tid}", "state": "done", "session": CHAT,
+            "event_key": _key(tid, event_id)}
