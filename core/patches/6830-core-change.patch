diff --git a/hermes_cli/code_attestation.py b/hermes_cli/code_attestation.py
index 3406025f6e46aacf8e89fbc790cbc2321744b661..431b8ba28b8b871b85d1526d584a2aac32b5b801 100644
--- a/hermes_cli/code_attestation.py
+++ b/hermes_cli/code_attestation.py
@@ -24,6 +24,10 @@
 from types import CodeType, FunctionType
 from typing import TYPE_CHECKING
 
+# Load the stdlib-only observer before an audit ledger can be activated. A lazy
+# import inside its first inventory would itself change the observed code graph.
+from hermes_cli.code_inventory_diagnostics import inventory_modules
+
 if TYPE_CHECKING:
     from hermes_cli.code_attestation_snapshot import DiagnosticSnapshot
 
@@ -1164,7 +1168,6 @@
         return inventory_modules(self, deadline=deadline, progress=progress)
 
     def _inventory_modules(self, *, deadline=None):
-        from hermes_cli.code_inventory_diagnostics import inventory_modules
         return inventory_modules(self, deadline=deadline)
 
     def _audit(self, event, args):
diff --git a/tests/hermes_cli/test_code_inventory_diagnostics.py b/tests/hermes_cli/test_code_inventory_diagnostics.py
index f61458ca5798fa17b236d2677f033c432b40c8eb..aeb0fd641f5dd172d7a4b8d9dc4debe57e0aa755 100644
--- a/tests/hermes_cli/test_code_inventory_diagnostics.py
+++ b/tests/hermes_cli/test_code_inventory_diagnostics.py
@@ -1,6 +1,9 @@
 """Requested inventory emits bounded stage totals, never module paths or reasons."""
 from types import ModuleType
 import logging
+from pathlib import Path
+import subprocess
+import sys
 
 import pytest
 
@@ -8,6 +11,22 @@
 from hermes_cli import code_inventory_diagnostics as diagnostics
 
 
+def test_cold_attestation_import_loads_observer_before_ledger_activation(tmp_path):
+    source = '''
+import sys
+sys.path.insert(0, sys.argv[1])
+from hermes_cli import code_attestation as ca
+observer = sys.modules.get('hermes_cli.code_inventory_diagnostics')
+assert observer is not None, 'observer must load before any ledger can activate'
+assert ca.inventory_modules is observer.inventory_modules
+assert 'logging' not in sys.modules, 'observer must not initialize logging'
+'''
+    result = subprocess.run(
+        [sys.executable, '-I', '-S', '-B', '-c', source, str(Path(ca.__file__).parents[1])],
+        cwd=tmp_path, capture_output=True, text=True, check=False, timeout=30)
+    assert result.returncode == 0, result.stdout + result.stderr
+
+
 def test_actual_inventory_reports_stages_without_changing_module_observation(tmp_path, caplog):
     ledger = object.__new__(ca.Attestation)
     ledger._components = {}
