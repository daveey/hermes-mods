From a4be7beb315b07e63204a3ad82c3dad96186f17b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 05:04:59 +0000
Subject: [PATCH] test(shell): cover expanding heredoc substitution fallback
 [daveey]

Pin the conservative helper contract for dollar and backtick substitutions in unquoted heredoc bodies, with quoted-delimiter controls and both date-exemption modes. No production changes.

Proof: baseline 41 passed; exact expanding-body elif -> False mutant 4 assertion failures, 37 passed, zero skips; restored affected lifecycle guard family 2006 passed across 27 files. scripts/check --base origin/main passed.
---
 tests/cron/test_arith_quote_desync.py | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/tests/cron/test_arith_quote_desync.py b/tests/cron/test_arith_quote_desync.py
index 516258eead..91d96853e3 100644
--- a/tests/cron/test_arith_quote_desync.py
+++ b/tests/cron/test_arith_quote_desync.py
@@ -108,6 +108,22 @@ def test_masking_agrees_with_real_bash_execution(tmp_path, shape):
         assert unsafe
 
 
+@pytest.mark.parametrize("body", ["$(echo data)", "`echo data`"], ids=["dollar", "backtick"])
+@pytest.mark.parametrize("date_exempt", [True, False])
+def test_expanding_heredoc_substitution_fails_closed(body, date_exempt):
+    # This is the helper's conservative contract, not a claim that echo is unsafe.
+    # No arithmetic or unmatched quotes can make another scanner branch catch it.
+    command = f"cat <<EOF\n{body}\nEOF\n"
+    assert substitution_in_arithmetic(command, date_exempt=date_exempt)
+
+
+@pytest.mark.parametrize("body", ["$(echo data)", "`echo data`"], ids=["dollar", "backtick"])
+@pytest.mark.parametrize("date_exempt", [True, False])
+def test_literal_heredoc_plain_substitution_is_not_arithmetic(body, date_exempt):
+    command = f"cat <<'EOF'\n{body}\nEOF\n"
+    assert not substitution_in_arithmetic(command, date_exempt=date_exempt)
+
+
 def test_nested_literal_body_date_exemption_and_depth_limit():
     command = "bash <<'R'\nx=$(( $(date +%s) + 2700 ))\nR\n"
     assert not substitution_in_arithmetic(command, date_exempt=True)
-- 
