From 3818f9c2f7e8bb0a40783a97c63d038f5a1a7bf0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 04:07:20 +0000
Subject: [PATCH] [daveey] Honor nested expansions inside double-quoted
 parameter words

Keep backtick comment quotes in their own frame when traversing a double-quoted parameter fallback. Normalize nested spans for shlex without changing the outer quote boundary.

Proof: five new real-Bash RUN rows fail before the correction while clean twins pass; 48 focused cases and all 1427 lifecycle tests across 23 files pass without retries. Code health and diff checks pass.
---
 cron/lifecycle_guard_lines.py                 | 32 +++++++++++++++++--
 .../test_lifecycle_guard_nested_comments.py   |  5 +++
 2 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/cron/lifecycle_guard_lines.py b/cron/lifecycle_guard_lines.py
index bfc6c4c79fb4303063c49be517c919f727eccbec..9c174854261e926777d03ba0b6c8e399639b1c9e 100644
--- a/cron/lifecycle_guard_lines.py
+++ b/cron/lifecycle_guard_lines.py
@@ -26,6 +26,29 @@ def _quoted_end(text: str, start: int, closer: str, *, escapes: bool = True) ->
     return len(text)
 
 
+def _double_span(text: str, start: int, *, shlex_quotes: bool) -> tuple[int, str]:
+    """A substitution's quotes belong to its own frame, not the enclosing word."""
+    pos = copied = start
+    parts = ['"']
+    while pos < len(text):
+        char = text[pos]
+        if char == "\\":
+            pos += 2
+            continue
+        if char == '"':
+            pos += 1
+            break
+        if char in "$`":
+            end, span = _expansion(text, pos, in_double=True, shlex_quotes=shlex_quotes)
+            if span:
+                parts.extend((text[copied:pos], span))
+                pos = copied = end
+                continue
+        pos += 1
+    parts.append(text[copied:pos])
+    return pos, "".join(parts)
+
+
 def _parameter_span(text: str, start: int, *, shlex_quotes: bool) -> tuple[int, str]:
     """Keep parameter words opaque to the OUTER comment/line scanner.
 
@@ -47,8 +70,13 @@ def _parameter_span(text: str, start: int, *, shlex_quotes: bool) -> tuple[int,
         if char == "\\":
             pos += 2
             continue
-        if char in "'\"`":
-            pos = _quoted_end(text, pos + 1, char, escapes=char != "'")
+        if char == '"':
+            end, span = _double_span(text, pos + 1, shlex_quotes=shlex_quotes)
+            parts.extend((text[copied:pos], span))
+            pos = copied = end
+            continue
+        if char == "'":
+            pos = _quoted_end(text, pos + 1, char, escapes=False)
             continue
         if text.startswith(("${", "$("), pos):
             stack.append("}" if text[pos + 1] == "{" else ")")
diff --git a/tests/cron/test_lifecycle_guard_nested_comments.py b/tests/cron/test_lifecycle_guard_nested_comments.py
index 6c92e7eb1fbfec8bbd00007f726634f2b7e147fa..f533c15cfccac5c4c444048f203c99941b3a9ad3 100644
--- a/tests/cron/test_lifecycle_guard_nested_comments.py
+++ b/tests/cron/test_lifecycle_guard_nested_comments.py
@@ -20,6 +20,11 @@ PREFIXES = [
     'echo ${x:-"`echo #it\'s`"}',
     'echo "${x:-`echo #it\'s`}"',
     'echo "`echo #x`"',
+    'echo ${x:-"`echo #say "x`"}',
+    'echo ${x:-${y:-"`echo #say "x`"}}',
+    'echo ${x:-"${y:-`echo #say "x`}"}',
+    'echo ${x:-"before `echo #say "x` after"}',
+    'echo ${x:-"escaped \\" before `echo #say "x`"}',
     r"echo $'it\'s'#word",
     r"echo $'it\'s' " + "# it's\ntrue",
     r"echo ${x:-$'it\'s'}",
