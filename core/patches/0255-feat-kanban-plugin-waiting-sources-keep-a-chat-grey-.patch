From 92d3b5835d98fe24e45eff128818950f3fe8b567 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 15:41:09 -0700
Subject: [PATCH 246/248] feat(kanban): plugin waiting sources keep a chat grey
 until its close-out; wake uses the shared turn admission [daveey]

---
diff --git a/hermes_cli/kanban_session_activity.py b/hermes_cli/kanban_session_activity.py
index 2182752813137dcae99aa1d236516c8ed58c1673..5d39cc608545b68623a4aaeb7a0dd8d2d16ff03c 100644
--- a/hermes_cli/kanban_session_activity.py
+++ b/hermes_cli/kanban_session_activity.py
@@ -359,6 +359,31 @@ def _read_local_boards(active: dict[str, int], blocked: dict[str, int], unseen:
                 _log.debug("kanban activity read failed for %s: %s", path, exc)
 
 
+# [daveey] Extra "this chat still waits" sources (plugins): name -> fn() -> {session_id: iterable of task ids}. A
+# chat-closeout plugin registers the cards of a settled batch whose close-out turn has not run yet, so the row
+# stays grey "waiting" between the last notice and the closing answer instead of flashing green.
+_waiting_sources: dict[str, Any] = {}
+
+
+def register_waiting_source(name: str, fn) -> None:
+    """Register (or replace, ``fn=None`` removes) a plugin source of waiting card ids per session. [daveey]"""
+    if fn is None:
+        _waiting_sources.pop(name, None)
+    else:
+        _waiting_sources[name] = fn
+
+
+def _extra_waiting() -> dict[str, set[str]]:
+    out: dict[str, set[str]] = {}
+    for name, fn in list(_waiting_sources.items()):
+        try:
+            for sid, ids in (fn() or {}).items():
+                out.setdefault(str(sid), set()).update(str(i) for i in ids if i)
+        except Exception:  # a plugin must never break the sidebar
+            _log.debug("waiting source %s failed", name, exc_info=True)
+    return out
+
+
 def waiting_on_task_ids() -> dict[str, frozenset[str]]:
     """``{session_id: open task ids}`` on this gateway's boards: queued/running cards plus those waiting on a human,
     created or shepherded by the session — what the chat is waiting on. Same cache as the counts. [daveey]"""
@@ -567,6 +592,7 @@ def annotate_kanban_activity(rows: list[dict[str, Any]]) -> list[dict[str, Any]]
     try:
         active, blocked, unseen, remote_stale = _all_counts()
         waiting = waiting_on_task_ids()
+        extra = _extra_waiting()
     except Exception:
         _log.debug("kanban activity unavailable", exc_info=True)
         return rows
@@ -585,7 +611,12 @@ def annotate_kanban_activity(rows: list[dict[str, Any]]) -> list[dict[str, Any]]
             else:
                 row.pop(key, None)
         # [daveey] The open card ids the chat waits on (lineage-wide, capped): the sidebar's "waiting on N cards".
-        ids_waiting = sorted({tid for sid in ids for tid in waiting.get(sid, ())})
+        open_ids = {tid for sid in ids for tid in waiting.get(sid, ())}
+        # Plugin sources (pending close-outs): count the ids the boards don't already count as open.
+        pending = {tid for sid in ids for tid in extra.get(sid, ())} - open_ids
+        if pending:
+            row["kanban_active"] = int(row.get("kanban_active") or 0) + len(pending)
+        ids_waiting = sorted(open_ids | pending)
         if ids_waiting:
             row["kanban_waiting_on"] = ids_waiting[:WAITING_ON_CAP]
         else:
diff --git a/tests/hermes_cli/test_kanban_session_activity.py b/tests/hermes_cli/test_kanban_session_activity.py
index 950756ec7ffe934418deec54da420918b8dd91f5..2bf0c9bababb0a8eff5563ffa4bd95afd802d245 100644
--- a/tests/hermes_cli/test_kanban_session_activity.py
+++ b/tests/hermes_cli/test_kanban_session_activity.py
@@ -443,3 +443,28 @@ def test_rows_carry_the_open_card_ids_the_chat_waits_on(kanban_root):
     assert rows[0]["kanban_active"] == 2 and rows[0]["kanban_blocked"] == 1
     assert "kanban_waiting_on" not in rows[1]
     assert ksa.waiting_on_task_ids() == {"s_root": frozenset({"t1"}), "s_tip": frozenset({"t2", "t5"})}
+
+
+def test_plugin_waiting_source_keeps_a_settled_batch_waiting_until_its_close_out(kanban_root):
+    """A registered source (chat-closeout's pending close-outs) adds its ids to ``kanban_waiting_on`` and to
+    ``kanban_active`` without double-counting ids the boards already report open; a failing source is harmless
+    and unregistering removes it. [daveey]"""
+    _make_board(kanban_root / "kanban.db", [("t1", "running", "s_a"), ("t2", "done", "s_b")])
+
+    def boom():
+        raise RuntimeError("plugin bug")
+
+    ksa.register_waiting_source("closeout", lambda: {"s_b": ["t2"], "s_a": ["t1"]})
+    ksa.register_waiting_source("broken", boom)
+    try:
+        rows = [{"id": "s_a"}, {"id": "s_b"}, {"id": "s_c"}]
+        ksa.annotate_kanban_activity(rows)
+        assert rows[0]["kanban_active"] == 1 and rows[0]["kanban_waiting_on"] == ["t1"]  # not double-counted
+        assert rows[1]["kanban_active"] == 1 and rows[1]["kanban_waiting_on"] == ["t2"]  # grey until close-out
+        assert "kanban_active" not in rows[2]
+    finally:
+        ksa.register_waiting_source("closeout", None)
+        ksa.register_waiting_source("broken", None)
+    rows = [{"id": "s_b"}]
+    ksa.annotate_kanban_activity(rows)
+    assert "kanban_active" not in rows[0] and "kanban_waiting_on" not in rows[0]
diff --git a/tests/tui_gateway/test_session_wake_turn.py b/tests/tui_gateway/test_session_wake_turn.py
index c8fd310be6f3d41b6f09ccfc040e34b23e566013..db500fef31f96dac7f39b84083d43affd8fb8588 100644
--- a/tests/tui_gateway/test_session_wake_turn.py
+++ b/tests/tui_gateway/test_session_wake_turn.py
@@ -103,3 +103,12 @@ def test_owner_slot_refusal_releases_the_claim(wired, monkeypatch):
     assert server._wake_session_turn(KEY, "close out") == "refused"
     assert calls["released"] == 1 and live["session"]["running"] is False
     assert calls["submit"] == []
+
+
+def test_wake_goes_through_the_shared_turn_admission(wired, monkeypatch):
+    """A retiring backend (or any refused admission) never starts the close-out turn. [daveey]"""
+    live, calls = wired
+    live.update(sid="s", session=_session())
+    monkeypatch.setattr(server, "_notif_claim_turn", lambda session: False)
+    assert server._wake_session_turn(KEY, "close out") == "busy"
+    assert calls["submit"] == [] and live["session"]["running"] is False
