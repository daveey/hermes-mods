From 5b406a8073048ef2dfd3c75a35e076349bfd5128 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:42:15 +0000
Subject: [PATCH] [daveey] deflake sandbox normal-exit probe: a process reaped
 mid-scan is not alive

test_normal_exit_quiesces_namespace_before_remove_tree scans /proc/*/ns/pid
at remove_tree entry. An unrelated host process reaped between the glob and
the readlink makes readlink raise ESRCH (ProcessLookupError), which the probe
did not catch, so the probe crashed with returncode 1 (CI run 43445818099).
A reaped task is outside every namespace, so treat ESRCH like ENOENT.

Repro outside bwrap: scanning /proc/*/ns/pid while 32 shells fork /bin/true
hits ProcessLookupError within seconds on a 16-CPU worker.
---
 tests/ci/test_plugin_sandbox_normal_exit.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/ci/test_plugin_sandbox_normal_exit.py b/tests/ci/test_plugin_sandbox_normal_exit.py
index 5fcc33e905..0e181acbea 100644
--- a/tests/ci/test_plugin_sandbox_normal_exit.py
+++ b/tests/ci/test_plugin_sandbox_normal_exit.py
@@ -84,8 +84,8 @@ def test_normal_exit_quiesces_namespace_before_remove_tree(work):
                 try:
                     if os.readlink(entry) == namespace:
                         observation["namespace_alive"].append(str(entry))
-                except FileNotFoundError:
-                    pass
+                except (FileNotFoundError, ProcessLookupError):
+                    pass  # reaped between glob and readlink: not alive
                 except PermissionError:
                     pass  # unrelated host processes, not this uid's sandbox
             observation["late_file"] = (copy / "after-remove-entry").exists()
-- 
