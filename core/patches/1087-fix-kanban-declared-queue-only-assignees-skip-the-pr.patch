From ec86adb01ec3e4b99e642b1449d8bbc236910a13 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 18:31:42 -0700
Subject: [PATCH] fix(kanban): declared queue-only assignees skip the profile
 capability check [daveey]

---
 hermes_cli/kanban_capabilities.py            | 35 ++++++++++++++++++++
 tests/hermes_cli/test_kanban_capabilities.py | 13 ++++++++
 2 files changed, 48 insertions(+)

diff --git a/hermes_cli/kanban_capabilities.py b/hermes_cli/kanban_capabilities.py
index bbcb15ccb17..3e209abdea5 100644
--- a/hermes_cli/kanban_capabilities.py
+++ b/hermes_cli/kanban_capabilities.py
@@ -91,6 +91,38 @@ def declaration_required() -> bool:
     return False
 
 
+def queue_assignees() -> frozenset[str]:
+    """Queue-only assignee names declared in ``kanban.queue_assignees``. Never raises. [daveey]
+
+    A queue assignee is a parking name with no Hermes profile on purpose (bb-queue): the
+    dispatcher can never spawn it, and an external gate reassigns the card to a real worker
+    profile, which is validated then. Read from the active profile's config and the board
+    home's config, like :func:`declaration_required`.
+    """
+    names: set[str] = set()
+
+    def _add(cfg) -> None:
+        raw = ((cfg or {}).get("kanban") or {}).get("queue_assignees") or []
+        if isinstance(raw, str):
+            raw = [raw]
+        names.update(n.strip() for n in raw if isinstance(n, str) and n.strip())
+
+    try:
+        from hermes_cli.config import load_config_readonly
+        _add(load_config_readonly())
+    except Exception:  # health: allow BLE001 S110 -- a policy read never breaks create; default is none
+        pass
+    try:
+        from hermes_cli.kanban_db import kanban_home
+        from utils import load_yaml_file_readonly
+        path = kanban_home() / "config.yaml"
+        if path.is_file():
+            _add(load_yaml_file_readonly(path))
+    except Exception:  # health: allow BLE001 S110 -- an unreadable board config declares none
+        pass
+    return frozenset(names)
+
+
 def _skill_frontmatter(name: str) -> dict | None:
     """Frontmatter of skill *name* resolved the way ``skill_view`` resolves it in this home, or None."""
     from agent.skill_utils import normalize_skill_lookup_name
@@ -332,6 +364,9 @@ def validate_assignment(
     if not any(name in _CAPABILITIES for name in required) or assignee is None:
         # Unassigned drafts cannot dispatch; assign_task validates before binding.
         return required
+    if assignee in queue_assignees():
+        # Declared parking name (kanban.queue_assignees): no profile, never spawned. [daveey]
+        return required
     try:
         available = _profile_capabilities(assignee, required)
     except Exception as exc:
diff --git a/tests/hermes_cli/test_kanban_capabilities.py b/tests/hermes_cli/test_kanban_capabilities.py
index 0dc1785ad0a..527d3ad9fb6 100644
--- a/tests/hermes_cli/test_kanban_capabilities.py
+++ b/tests/hermes_cli/test_kanban_capabilities.py
@@ -169,3 +169,16 @@ def test_profile_scopes_are_restored_on_success_and_failure(profiles):
 def test_skill_names_are_not_guessed_as_capabilities(profiles):
     # Skill capability metadata has no established convention; do not infer from names/prose.
     assert validate_assignment("legacy", skills=["git", "terminal"]) == []
+
+
+def test_declared_queue_assignee_skips_profile_policy(profiles):
+    """A name in kanban.queue_assignees has no profile and still takes dir/worktree cards."""
+    with pytest.raises(CapabilityMismatchError) as caught:
+        validate_assignment("bb-queue", workspace_kind="dir")
+    assert "does not exist" in str(caught.value) or "unavailable" in str(caught.value)
+    profiles("default", "kanban:\n  queue_assignees: [bb-queue]\n")
+    assert validate_assignment("bb-queue", workspace_kind="dir") == ["terminal", "file", "host_repo"]
+    assert validate_assignment("bb-queue", workspace_kind="worktree") == ["terminal", "file", "git", "host_repo"]
+    # Only the declared name is exempt; other missing profiles still refuse.
+    with pytest.raises(CapabilityMismatchError):
+        validate_assignment("bb-typo", workspace_kind="dir")
-- 
