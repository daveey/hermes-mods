From f03b229e34959ecf8bef144ee16f784fb54619b3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 02:07:04 +0000
Subject: [PATCH] fix(kanban): refuse a human ask that only relays a message to
 an agent (agent_relay_ask) [daveey]

Hub t_01a188c8ddf998ac blocked on David with 'Ask for the broker Gemini secret repair from your
own Hermes chat on the AWS-authorized Mac'; that chat did the repair itself in 10 minutes. The
kanban_block/kanban_create ask lint now refuses such relay asks with code agent_relay_ask and points
the worker at needs=[...], cross_session or an owner card on the holding gateway; the
no_capability_holder refusal no longer invites the relay ask. Real asks (approve, pay, sign in,
physical, A/B replies) still pass; a scan of the board's 59 distinct historical ask lines matches
only the 2 relay asks. Self-heal agent-c03353a3cf.
---
 hermes_cli/kanban_block_policy.py          |  38 +++++-
 hermes_cli/kanban_capability_routing.py    |   6 +-
 tests/tools/test_kanban_agent_relay_ask.py | 135 +++++++++++++++++++++
 3 files changed, 177 insertions(+), 2 deletions(-)
 create mode 100644 tests/tools/test_kanban_agent_relay_ask.py

diff --git a/hermes_cli/kanban_block_policy.py b/hermes_cli/kanban_block_policy.py
index 08da59a1e17..928e30d85ea 100644
--- a/hermes_cli/kanban_block_policy.py
+++ b/hermes_cli/kanban_block_policy.py
@@ -60,17 +60,52 @@ _UNBLOCK = re.compile(r"\bun-?block", re.IGNORECASE)
 _ARCHIVE = re.compile(r"\barchiv", re.IGNORECASE)
 
 
+RELAY_ASK_CODE = "agent_relay_ask"
+# "from/in your own Hermes (Desktop|CLI) chat", "ask/tell your (Hermes) chat/agent/session to ...": the ask only
+# makes David carry a message to an agent. Kept narrow: "asks the vendor's agent" or "sign in" never match.
+_RELAY = re.compile(
+    r"\b(?:from|in|via|using)\s+your\s+own\s+(?:hermes\s+)?(?:desktop\s+|cli\s+)?(?:or\s+cli\s+)?"
+    r"(?:chat|session|agent)\b"
+    r"|\b(?:ask|tell|have|get)\s+your\s+(?:own\s+)?(?:hermes\s+)?(?:desktop\s+|cli\s+)?"
+    r"(?:chat|session|agent)\b",
+    re.IGNORECASE)
+
+
+def agent_relay_ask_error(action: str) -> Optional[str]:
+    """Typed refusal for an ask that only relays a message from David to an agent (self-heal agent-c03353a3cf).
+
+    Hub t_01a188c8ddf998ac asked David to "ask for the broker Gemini secret repair from your own Hermes chat on
+    the AWS-authorized Mac"; that chat did it itself in 10 minutes. Such a block is a routing gap shown to David
+    as his task, so the worker must route it to an agent instead.
+    """
+    if not _RELAY.search(action):
+        return None
+    return (f"{RELAY_ASK_CODE}: human_request.action asks David to pass a message to an agent or chat "
+            "(\"from your own Hermes chat\", \"ask your agent to ...\"). Agents can do that without him: "
+            "(1) declare the capability the other gateway holds with kanban_block(needs=['aws:<account>:<scope>' "
+            "| 'ssh:<host>' | 'host:<gateway>']) so an owner card opens there; or (2) kanban_comment the exact "
+            "request and send it to the owning chat with cross_session (action='send'), or kanban_create the "
+            "owner card on that gateway (placement='<gateway>') and park on it. If no gateway holds the "
+            "capability, the gap is the capability registry: fix the probe config (kanban.capabilities.probes) "
+            "on the host that has the access. Keep human_request for what only David can do: approve, pay, "
+            "sign in, a physical step.")
+
+
 def user_ask_lint_error(human_request) -> Optional[str]:
     """Typed refusal when a block on David does not say, in its ask line, what unblock and archive mean.
 
     ``human_request.action`` is the one line every surface shows David verbatim (card view, For-you queue, chat
     close-out and ask-relay notices). An action like "Pick A or B" or "the safety change" left him reading
     "blocked" with no idea what to do or what his click would do (coach pattern blocked-card-missing-user-ask).
+    An action that only asks him to relay a message to an agent is refused too (:func:`agent_relay_ask_error`).
     Only agent entry points (kanban_block / kanban_create tools) call this; internal trackers are not linted.
     """
     if not isinstance(human_request, dict):
         return None
     action = " ".join(str(human_request.get("action") or "").split())
+    relay = agent_relay_ask_error(action)
+    if relay:
+        return relay
     missing = [label for label, rx in (("what unblocking the card does", _UNBLOCK),
                                        ("what archiving it does", _ARCHIVE)) if not rx.search(action)]
     if not missing:
@@ -86,7 +121,8 @@ def user_ask_lint_error(human_request) -> Optional[str]:
 def ask_lint_check(human_request) -> tuple:
     """``_check`` args for the tool entry points: ``(ok, message, rejection)``."""
     err = user_ask_lint_error(human_request)
-    return err is None, err or "", ASK_LINT_CODE
+    code = RELAY_ASK_CODE if err and err.startswith(RELAY_ASK_CODE) else ASK_LINT_CODE
+    return err is None, err or "", code
 
 
 def creation_lint_error(title, initial_status, human_request, *, triage=False) -> Optional[str]:
diff --git a/hermes_cli/kanban_capability_routing.py b/hermes_cli/kanban_capability_routing.py
index 70464e14a1b..3909d03a35a 100644
--- a/hermes_cli/kanban_capability_routing.py
+++ b/hermes_cli/kanban_capability_routing.py
@@ -208,7 +208,11 @@ def plan(needs: list[str], *, now: Optional[float] = None, **lookup) -> dict:
         raise CapabilityRouteError(
             "no_capability_holder",
             f"no gateway holds {f['need']} (hermes-hub capability registry). If only David can grant it, "
-            "block with kind='needs_input' and a human_request naming the exact command and scope.",
+            "block with kind='needs_input' and a human_request naming the exact command and scope. If an "
+            "agent on another host has the access but does not advertise it, that is a registry gap, not a "
+            "human ask: never ask David to relay a request to his chat (refused as agent_relay_ask); send it "
+            "to that chat with cross_session or kanban_create the owner card there, and add the probe to "
+            "that host's kanban.capabilities.probes.",
             details={"need": f["need"]})
     return {"routes": routes, "local": local}
 
diff --git a/tests/tools/test_kanban_agent_relay_ask.py b/tests/tools/test_kanban_agent_relay_ask.py
new file mode 100644
index 00000000000..4db08e2facc
--- /dev/null
+++ b/tests/tools/test_kanban_agent_relay_ask.py
@@ -0,0 +1,135 @@
+"""A human ask that only asks David to relay a message to an agent/chat is refused (self-heal
+agent-c03353a3cf). Replays hub t_01a188c8ddf998ac (blocked event 81905, 2026-10-29 10:53 PT): the
+worker asked David to "ask for the broker Gemini secret repair from your own Hermes chat on the
+AWS-authorized Mac"; the chat then did the repair itself in 10 minutes. The wall was a routing gap
+(the MacBook did not advertise that AWS account), not a decision only David can make."""
+import json
+import time
+
+import pytest
+
+
+@pytest.fixture
+def worker_env(monkeypatch, tmp_path):
+    """A claimed card in an isolated board, as a dispatcher-spawned worker sees it."""
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_PROFILE", "test-worker")
+    monkeypatch.delenv("HERMES_SESSION_ID", raising=False)
+    from pathlib import Path
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    conn = kbc.connect()
+    try:
+        tid = kb.create_task(conn, title="worker-test", assignee="test-worker")
+        kb.claim_task(conn, tid)
+        run_id = kb._current_run_id(conn, tid)
+    finally:
+        conn.close()
+    monkeypatch.setenv("HERMES_KANBAN_TASK", tid)
+    monkeypatch.setenv("HERMES_KANBAN_RUN_ID", str(run_id))
+    return tid
+
+
+def _status(tid):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    conn = kbc.connect()
+    try:
+        return kb.get_task(conn, tid).status
+    finally:
+        conn.close()
+
+
+# Exact action of event 81905, plus the unblock/archive tail the ask lint now requires, so only the
+# relay check can refuse it.
+RELAY_81905 = {
+    "action": ("Ask for the broker Gemini secret repair from your own Hermes chat on the AWS-authorized Mac, "
+               "then unblock this card. Unblock = verify the hub vend; archive = drop the Gemini repair."),
+    "why_human": "No registered gateway holds broker-account Secrets Manager capability",
+    "interaction": "external",
+    "scope": "Only gemini.inference mapped broker secret",
+    "evidence": "capability routing returned no_capability_holder",
+}
+REAL_APPROVAL = {**RELAY_81905, "interaction": "approval",
+                 "action": ("Approve the $40 EC2 launch in this chat. Unblock = launch it and run the soak; "
+                            "archive = no launch, nothing is spent.")}
+
+RELAY_VARIANTS = [
+    "From your own Hermes Desktop chat on the Mac, ask: \"Repair token-broker gemini.inference\". "
+    "Unblock = verify; archive = drop it.",
+    "Ask your Hermes chat to rerun the force-push with --force-with-lease. Unblock = continue; archive = drop.",
+    "Tell your agent on the MacBook to repair the secret. Unblock = verify; archive = drop.",
+    "In your own Hermes CLI chat, request: \"Resume t_x and provision the host\". Unblock = go; archive = stop.",
+]
+REAL_ASKS = [
+    REAL_APPROVAL["action"],
+    "Sign in to github.com/settings/billing in the Chrome window and raise the Actions limit. "
+    "Unblock = rerun CI; archive = leave CI red.",
+    "Plug the Pi into the hallway outlet. Unblock = the agent pairs it; archive = skip the device.",
+    "Reply A or B in this chat (A asks the vendor's agent for a refund, B keeps it). Unblock = do it; "
+    "archive = keep the order.",
+]
+
+
+@pytest.mark.parametrize("action", [RELAY_81905["action"], *RELAY_VARIANTS])
+def test_relay_ask_is_refused_by_the_lint(action):
+    from hermes_cli.kanban_block_policy import user_ask_lint_error
+    err = user_ask_lint_error({**RELAY_81905, "action": action})
+    assert err and err.startswith("agent_relay_ask"), err
+    assert "needs=" in err and "cross_session" in err
+
+
+@pytest.mark.parametrize("action", REAL_ASKS)
+def test_real_human_asks_still_pass(action):
+    from hermes_cli.kanban_block_policy import user_ask_lint_error
+    assert user_ask_lint_error({**RELAY_81905, "action": action}) is None
+
+
+def test_block_entry_refuses_the_81905_relay_ask(worker_env):
+    from tools import kanban_tools as kt
+    d = json.loads(kt._handle_block({"reason": "Gemini broker key invalid", "kind": "needs_input",
+                                     "human_request": RELAY_81905}))
+    assert d.get("rejection") == "agent_relay_ask", d
+    assert _status(worker_env) == "running"
+
+
+def test_block_entry_still_accepts_a_real_approval(worker_env):
+    from tools import kanban_tools as kt
+    d = json.loads(kt._handle_block({"reason": "needs spend approval", "kind": "needs_input",
+                                     "human_request": REAL_APPROVAL}))
+    assert d.get("ok") is True, d
+    assert _status(worker_env) == "blocked"
+
+
+def test_create_entry_refuses_a_relay_ask(worker_env, monkeypatch):
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    from tools import kanban_tools as kt
+    d = json.loads(kt._handle_create({"title": "Repair broker Gemini key", "initial_status": "blocked",
+                                      "human_request": RELAY_81905, "requires": [], "placement": "local"}))
+    assert "error" in d and "agent_relay_ask" in d["error"], d
+
+
+# --- (c) routing: once the MacBook advertises the broker account, the need routes there -----------
+
+def test_macbook_holding_broker_account_admin_gets_the_secrets_need(tmp_path):
+    from hermes_cli import kanban_capability_routing as kcr
+    now = time.time()
+    macbook = {"schema": 1, "gateway": "macbook", "refreshed_at": now, "capabilities": [
+        {"name": "aws:767406518141:admin", "ok": True, "checked_at": now},
+        {"name": "aws:751442549699:admin", "ok": True, "checked_at": now},
+        {"name": "aws:111005867451:admin", "ok": True, "checked_at": now}]}
+    out = kcr.plan(["aws:751442549699:secrets-write"], now=now, cfg={}, local={}, remote={"macbook": macbook},
+                   self_gw="hub")
+    assert out["routes"] == [{"need": "aws:751442549699:secrets-write", "gateway": "macbook", "checked_at": now}]
+    # Before: the MacBook advertised only 767406518141, so the same need had no holder.
+    macbook["capabilities"] = macbook["capabilities"][:1]
+    with pytest.raises(kcr.CapabilityRouteError) as exc:
+        kcr.plan(["aws:751442549699:secrets-write"], now=now, cfg={}, local={}, remote={"macbook": macbook},
+                 self_gw="hub")
+    assert exc.value.code == "no_capability_holder"
+    assert "relay" in str(exc.value)  # the refusal must not invite a "go ask your chat" human ask
-- 
2.55.0

