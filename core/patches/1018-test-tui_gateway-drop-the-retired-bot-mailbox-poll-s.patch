From d5d6e1ab125943919f5db4a65feb959e130aae3a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:10:54 +0000
Subject: [PATCH] test(tui_gateway): drop the retired bot-mailbox poll stub
 from poller fixtures

Upstream retired the viewer poller's Bot delivery claim (c8ae25cd112, 3cb5d556d94) and the merge kept that,
so _poll_bot_live_delivery_guarded no longer exists to stub out. [daveey]
---
 tests/tui_gateway/test_notification_owner_refusal_backoff.py | 4 +++-
 tests/tui_gateway/test_process_consumer_health.py            | 4 +++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/tests/tui_gateway/test_notification_owner_refusal_backoff.py b/tests/tui_gateway/test_notification_owner_refusal_backoff.py
index 81e77cf558e..914cfe303d7 100644
--- a/tests/tui_gateway/test_notification_owner_refusal_backoff.py
+++ b/tests/tui_gateway/test_notification_owner_refusal_backoff.py
@@ -66,7 +66,9 @@ def poller_env(monkeypatch):
     monkeypatch.setattr(server, "_foreign_turn_owner", lambda session: None)
     monkeypatch.setattr(server, "_get_usage", lambda agent: {})
     monkeypatch.setattr(server, "_ensure_session_db_row", lambda session: True)
-    for name in ("_poll_bot_live_delivery_guarded", "_maybe_fire_tui_loop_tick",
+    # Fork: upstream retired the bot-mailbox claim from the notification poller (c8ae25cd112, kept by
+    # the merge), so there is no _poll_bot_live_delivery_guarded pass left to stub out.
+    for name in ("_maybe_fire_tui_loop_tick",
                  "_maybe_fire_tui_heartbeat_tick", "_notif_poll_kanban", "_notif_take_parked"):
         monkeypatch.setattr(server, name, lambda *a, **k: None)
     monkeypatch.setattr("tools.async_delegation.maybe_sweep_orphaned_completions", lambda q: None)
diff --git a/tests/tui_gateway/test_process_consumer_health.py b/tests/tui_gateway/test_process_consumer_health.py
index c95f2e0af4e..c8464754889 100644
--- a/tests/tui_gateway/test_process_consumer_health.py
+++ b/tests/tui_gateway/test_process_consumer_health.py
@@ -25,7 +25,9 @@ def consumer(tmp_path, monkeypatch):
 
     monkeypatch.setattr(registry, "_new_session", notifying_session)
     monkeypatch.setattr("tools.process_registry.process_registry", registry)
-    for name in ("_poll_bot_live_delivery_guarded", "_maybe_fire_tui_loop_tick",
+    # Fork: upstream retired the bot-mailbox claim from the notification poller (c8ae25cd112, kept by
+    # the merge), so there is no _poll_bot_live_delivery_guarded pass left to stub out.
+    for name in ("_maybe_fire_tui_loop_tick",
                  "_maybe_fire_tui_heartbeat_tick", "_notif_poll_kanban", "_notif_take_parked"):
         monkeypatch.setattr(server, name, lambda *a, **k: None)
     monkeypatch.setattr(server, "_emit", lambda *a, **k: None)
-- 
