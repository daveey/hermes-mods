From 4591dd52da477f86f99a558964fdf570f46945f2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 09:40:22 +0000
Subject: [PATCH] test(update): the fork sync never pushes main directly, even
 with write access [daveey]

The fork-upstream/fork-late cases asserted the old raw push of main. Under the upstream-sync
gate the updater hands the sync to scripts/ci/upstream_sync.py; the fixture checkout has no gate,
so main stays put and no direct push happens. Card t_01a18bb880ab1f28.
---
 tests/hermes_cli/test_update_target_identity.py | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/tests/hermes_cli/test_update_target_identity.py b/tests/hermes_cli/test_update_target_identity.py
index 16abf526fba..cd8c5d4119e 100644
--- a/tests/hermes_cli/test_update_target_identity.py
+++ b/tests/hermes_cli/test_update_target_identity.py
@@ -198,8 +198,11 @@ def test_branch_update_uses_real_refs_and_completion_request(update_tree, monkey
                 assert 'Code did not move' not in output
                 assert 'Already up to date' not in output
                 origin_before = t.wanted if case.startswith('fork-late') else t.base
-                assert git(t.origin, 'rev-parse', 'HEAD') == (t.newer if case.endswith('push-ok') else origin_before)
-                assert pushes and all((rc == 0) is case.endswith('push-ok') for rc in pushes)
+                # Even with write access (push-ok) the updater never pushes the fork's main: an upstream
+                # sync reaches it only through scripts/ci/upstream_sync.py, which this fixture lacks.
+                assert git(t.origin, 'rev-parse', 'HEAD') == origin_before
+                assert pushes == []
+                assert 'no scripts/ci/upstream_sync.py gate' in output
                 if case.startswith('fork-late'):
                     assert local.read_bytes() == local_work
                     assert not git(t.clone, 'stash', 'list')
