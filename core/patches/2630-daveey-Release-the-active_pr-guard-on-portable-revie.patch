diff --git a/tests/hermes_cli/test_kanban_operator_resume.py b/tests/hermes_cli/test_kanban_operator_resume.py
new file mode 100644
index 0000000000..76ddf9298a
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_operator_resume.py
@@ -0,0 +1,130 @@
+"""``hermes kanban resume``: operator-only release of an ``active_pr`` hold. [daveey]
+
+A supported handoff for a READY owner the respawn guard holds (no move checkpoint,
+no readable review result). It authorizes exactly one continuation of the latest
+run, never a merge; worker lineage (the worker process, its tool shells, delegated
+children) is refused and records nothing.
+"""
+from __future__ import annotations
+
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as kbd
+from hermes_cli import kanban_db_dispatch_pr_state as prs
+from hermes_cli import kanban_operator_resume as resume
+from tests.hermes_cli import test_kanban_edit_operator_fields as ops
+from tests.hermes_cli import test_kanban_shared_blockers as shared
+from tests.hermes_cli.kanban_guard_helpers import worker_comment
+
+kanban_home = shared.kanban_home
+spawns = shared.spawns
+
+T0 = 1_793_686_000
+PR = "https://github.com/daveey/hermes/pull/9002"
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    now = [T0]
+    monkeypatch.setattr(time, "time", lambda: now[0])
+    monkeypatch.setattr(prs, "pr_state", lambda url: "OPEN")
+    for var in ("HERMES_KANBAN_WORKER_TASK", "HERMES_KANBAN_RUN_ID"):
+        monkeypatch.delenv(var, raising=False)
+    return now
+
+
+def _held(conn):
+    """A crash/reclaim after publishing a PR: no review, no handoff -> active_pr."""
+    tid = kb.create_task(conn, title="implement", assignee="default")
+    assert kb.claim_task(conn, tid) is not None
+    worker_comment(conn, tid, "default", f"Opened {PR}")
+    assert kb.reclaim_task(conn, tid, reason="worker crashed", signal_fn=lambda *_: None)
+    assert kb.get_task(conn, tid).status == "ready"
+    return tid
+
+
+def _guard(tid):
+    with kbc.connect_closing() as conn:
+        return kbd.check_respawn_guard(conn, tid)
+
+
+def _events(tid):
+    with kbc.connect_closing() as conn:
+        return [e for e in kb.list_events(conn, tid) if e.kind == resume.EVENT]
+
+
+def test_crash_without_review_stays_guarded(kanban_home, clock):
+    with kbc.connect_closing() as conn:
+        tid = _held(conn)
+    clock[0] += 60
+    assert _guard(tid) == "active_pr"
+
+
+def test_operator_resume_releases_once_and_is_recorded(kanban_home, clock, spawns, capsys):
+    spawned, spawn = spawns
+    with kbc.connect_closing() as conn:
+        tid = _held(conn)
+    clock[0] += 60
+    assert ops._main(["resume", tid, "--reason", f"review on another gateway asked for changes on {PR}"]) == 0
+    assert "Resumed" in capsys.readouterr().out
+    [event] = _events(tid)
+    assert event.payload["via"] == "operator-resume" and event.payload["merge_authorized"] is False
+    assert event.payload["after_run"] and event.payload["actor"]
+    with kbc.connect_closing() as conn:
+        assert any(c.body.startswith("RESUMED: ") for c in kb.list_comments(conn, tid))
+    # The operator's note names the PR but is FYI: it must not re-arm the hold it records.
+    assert _guard(tid) is None
+    with kbc.connect_closing() as conn:
+        kbd.dispatch_once(conn, spawn_fn=spawn)
+        assert spawned == [tid]
+        # The resumed run crashes too: the receipt named the previous run, so it is spent.
+        clock[0] += 60
+        assert kb.reclaim_task(conn, tid, reason="crashed again", signal_fn=lambda *_: None)
+    assert _guard(tid) == "active_pr"
+
+
+@pytest.mark.parametrize("var", ["HERMES_KANBAN_TASK", "HERMES_KANBAN_WORKER_TASK"])
+def test_worker_lineage_is_refused(kanban_home, clock, monkeypatch, capsys, var):
+    with kbc.connect_closing() as conn:
+        tid = _held(conn)
+    clock[0] += 60
+    monkeypatch.setenv(var, tid)
+    assert ops._main(["resume", tid, "--reason", "let me run again"]) != 0
+    assert "worker lineage" in capsys.readouterr().err
+    with kbc.connect_closing() as conn, pytest.raises(resume.ResumeRefused, match="worker lineage"):
+        resume.resume(conn, tid, reason="direct import", actor="worker")
+    monkeypatch.delenv(var)
+    assert _events(tid) == []
+    assert _guard(tid) == "active_pr"
+
+
+def test_resume_requires_reason_and_an_active_pr_hold(kanban_home, clock):
+    with kbc.connect_closing() as conn:
+        tid = _held(conn)
+        free = kb.create_task(conn, title="no PR", assignee="default")
+        clock[0] += 60
+        with pytest.raises(resume.ResumeRefused, match="reason"):
+            resume.resume(conn, tid, reason="  ", actor="op")
+        with pytest.raises(resume.ResumeRefused, match="active_pr"):
+            resume.resume(conn, free, reason="no hold", actor="op")
+    assert _events(tid) == [] and _events(free) == []
+
+
+def test_same_second_or_forged_receipt_grants_nothing(kanban_home, clock):
+    with kbc.connect_closing() as conn:
+        tid = _held(conn)
+        # Same second as the PR comment: strictly-after ordering fails closed.
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, resume.EVENT, {"via": "operator-resume", "scope": "one_continuation",
+                                                       "merge_authorized": False, "after_run": None})
+    assert _guard(tid) == "active_pr"
+    clock[0] += 60
+    with kbc.connect_closing() as conn:
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, resume.EVENT, {"via": "operator-resume", "scope": "one_continuation",
+                                                       "merge_authorized": True, "after_run": None})
+    assert _guard(tid) == "active_pr"
diff --git a/tests/hermes_cli/test_kanban_review_checkpoint_cross_machine.py b/tests/hermes_cli/test_kanban_review_checkpoint_cross_machine.py
new file mode 100644
index 0000000000..92eaf952fc
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_review_checkpoint_cross_machine.py
@@ -0,0 +1,103 @@
+"""A review parked on one gateway releases the respawn guard on the card's home gateway. [daveey]
+
+Production shape (t_01a1cde626be2ada, t_01a1c59e0410b2fb): a hub card is moved to a worker with a
+plain queued move (no checkpoint), the worker's run publishes a PR, creates an exact-head review card
+on the worker and parks on it. The review is worker-owned, so on the hub it exists only in the Board
+replica, never in the hub's live ``tasks``/``task_runs``. The review completes; the hub must let the
+owner resume instead of holding ``active_pr`` forever. Integer run/comment ids differ between the two
+files throughout, so only portable identity may connect them.
+"""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_dispatch as kbd
+from hermes_cli import kanban_db_dispatch_pr_state as prs
+from hermes_cli import kanban_move as km
+from tests.hermes_cli.kanban_guard_helpers import worker_comment
+from tests.hermes_cli import test_kanban_move as moves
+
+PR = "https://github.com/example/repo/pull/10"
+HEAD = "a" * 40
+gws = moves.gws
+svc = moves.svc
+
+
+def _claimed_run(conn, task):
+    return conn.execute("SELECT current_run_id FROM tasks WHERE id = ?", (task,)).fetchone()[0]
+
+
+def _park_on_worker_review(hub, worker, monkeypatch):
+    monkeypatch.setattr(prs, "pr_state", lambda _: "OPEN")
+    hub.enter()
+    task = kb.create_task(hub.conn, title="implement PR", assignee="default")
+    # Like production: a plain capacity move, no checkpoint text.
+    assert km.move_queued(hub.conn, task, runs_on=["machine:worker-1"], reason="capacity")["ok"]
+    hub.round()
+    worker.round()
+    worker.tick()
+    worker.enter()
+    run = _claimed_run(worker.conn, task)
+    assert run is not None, "worker must claim the moved card"
+    worker_comment(worker.conn, task, "default", f"Implementation published as {PR} at head {HEAD}")
+    review = kb.create_task(worker.conn, title="exact-head review", assignee="reviewer")
+    kb.link_tasks(worker.conn, review, task, expected_child_run_id=run)
+    assert kb.block_task(worker.conn, task, kind="dependency", reason="await review", expected_run_id=run)
+    worker.round()
+    hub.round()
+    return task, review
+
+
+def _finish_review(hub, worker, review, metadata):
+    worker.enter()
+    kb.claim_task(worker.conn, review)
+    assert kb.complete_task(worker.conn, review, summary="review done", metadata=metadata)
+    worker.round()
+    hub.round()
+    worker.round()
+    hub.round()
+    hub.enter()
+    kb.recompute_ready(hub.conn)
+
+
+def _guard(gw, task):
+    gw.enter()
+    return kbd.check_respawn_guard(gw.conn, task)
+
+
+@pytest.mark.parametrize("verdict", ["request_changes", "approve"])
+def test_foreign_review_releases_guard_on_home_gateway(gws, monkeypatch, verdict):
+    hub, worker = gws
+    task, review = _park_on_worker_review(hub, worker, monkeypatch)
+    assert kb.get_task(hub.conn, review) is None, "the review must be foreign to the hub's live file"
+    hub_run = hub.conn.execute("SELECT id FROM task_runs WHERE task_id = ? ORDER BY id DESC LIMIT 1",
+                               (task,)).fetchone()[0]
+    worker_run = worker.conn.execute("SELECT id FROM task_runs WHERE task_id = ? ORDER BY id DESC LIMIT 1",
+                                     (task,)).fetchone()[0]
+    park = json.loads(hub.conn.execute(
+        "SELECT payload FROM task_events WHERE task_id = ? AND kind = 'dependency_wait'", (task,)).fetchone()[0])
+    assert park["review_checkpoint"]["run_id"] == worker_run
+    del hub_run  # ids may or may not collide in a fixture; identity must never rely on them
+    _finish_review(hub, worker, review, {"verdict": verdict, "reviewed_sha": HEAD, "pr": PR})
+    assert kb.get_task(hub.conn, task).status == "ready"
+    assert _guard(hub, task) is None
+
+
+def test_foreign_review_without_exact_head_still_holds(gws, monkeypatch):
+    hub, worker = gws
+    task, review = _park_on_worker_review(hub, worker, monkeypatch)
+    _finish_review(hub, worker, review, {"verdict": "approve", "reviewed_sha": "short", "pr": PR})
+    assert kb.get_task(hub.conn, task).status == "ready"
+    assert _guard(hub, task) == "active_pr"
+
+
+def test_crash_after_park_with_foreign_review_still_holds(gws, monkeypatch):
+    hub, worker = gws
+    task, review = _park_on_worker_review(hub, worker, monkeypatch)
+    _finish_review(hub, worker, review, {"verdict": "request_changes", "reviewed_sha": HEAD, "pr": PR})
+    with kb.write_txn(hub.conn):
+        kb._append_event(hub.conn, task, "crashed", {})
+    assert _guard(hub, task) == "active_pr"
diff --git a/website/docs/reference/cli-commands.md b/website/docs/reference/cli-commands.md
index d624534ddd..66d594c486 100644
--- a/website/docs/reference/cli-commands.md
+++ b/website/docs/reference/cli-commands.md
@@ -845,6 +845,7 @@ Multi-profile, multi-project collaboration board. Each install can host many boa
 | `request-review <id>` | Move a task to `review` with a reviewer handoff — NOT a block. Flags: `--summary`, `--metadata`, `--reviewer` (reassigns before review dispatch). |
 | `request-changes <id> <reason>` | Reviewer verdict for an active review run: close the review attempt and route the task back to its original implementer. |
 | `reopen-review <id>...` | Send review task(s) back for changes (`review` → ready/todo). Flag: `--reason` (appended as a comment). |
+| `resume <id> --reason "..."` | Operator-only: let a `ready` card held by the `active_pr` respawn guard run once more (records an `operator_resumed` event and a `RESUMED:` comment; refused from a Kanban worker or its tool shells; never authorizes a merge). |
 | `schedule <id> "<reason>"` | Park time-delay/follow-up work in `scheduled` so it is not shown as a human blocker. |
 | `unblock <id>` | Restore a blocked task to its source phase (`review` or `ready`), or `todo` while dependencies remain open. |
 | `archive <id>` | Hide from default list. `gc` will remove scratch workspaces. |
