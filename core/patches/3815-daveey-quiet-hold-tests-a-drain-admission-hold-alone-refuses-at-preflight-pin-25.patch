From eb03eb9fea849ce0f0085a02b523dfb343e24f13 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:25:11 +0000
Subject: [PATCH] [daveey] quiet-hold tests: a drain/admission hold alone
 refuses at preflight (pin #2591 M4)

Exact-head review t_01a1d66fa7598d89 of #2591 found a surviving mutant (M4):
dropping `_hold_reasons()` from `gateway.quiet_control.start_preflight_reasons`
left every test green, because each preflight test refused via the deploy window.

New test in tests/hermes_cli/test_kanban_quiet.py, with a fresh idle window:
patch `gateway.session_notifier_drain.held` to return True, and (second case)
to raise. `kq.hold` must exit 78 (EXIT_PREFLIGHT) naming `update:update_hold` /
`update:update_hold_unreadable`, with no lease taken, no `last-started.json`
written and the observer never run.

Proof (hermes-core-wt test, test_kanban_quiet.py + test_quiet_control.py):
- GREEN at head: 78 passed.
- RED with M4 applied (`for r in window_reasons` only): both new cases fail,
  `assert 0 == 78` (the hold ran the observer and spent the cooldown); 76 others pass.

Test-only; no production change.
---
 tests/hermes_cli/test_kanban_quiet.py | 28 +++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_quiet.py b/tests/hermes_cli/test_kanban_quiet.py
index 0bd601a1a5..40a7f8fe76 100644
--- a/tests/hermes_cli/test_kanban_quiet.py
+++ b/tests/hermes_cli/test_kanban_quiet.py
@@ -204,6 +204,34 @@ def test_an_unreadable_preflight_refuses_rather_than_passing(home, monkeypatch):
     assert not (home / "kanban" / "claim-quiet" / "last-started.json").exists()
 
 
+def _held_on():
+    return True
+
+
+def _held_unreadable():
+    raise OSError("hold marker unreadable")
+
+
+@pytest.mark.parametrize(("held", "reason"), [
+    (_held_on, "update:update_hold"),
+    (_held_unreadable, "update:update_hold_unreadable"),
+])
+def test_preflight_refuses_under_a_drain_or_admission_hold_even_with_an_idle_window(
+        home, tmp_path, monkeypatch, capsys, held, reason):
+    """A core-update drain/admission hold alone (window fresh and idle) refuses before the lease."""
+    from gateway import session_notifier_drain
+
+    monkeypatch.setattr(session_notifier_drain, "held", held)
+    marker = tmp_path / "ran"
+    observer = _script(tmp_path, "mark.py", "import sys; open(sys.argv[1], 'w').write('x')")
+    assert kq.hold(30, "r", [sys.executable, observer, str(marker)]) == kq.EXIT_PREFLIGHT
+    err = capsys.readouterr().err
+    assert reason in err and "no cooldown spent" in err, err
+    assert cq.inspect().state == "inactive", "the lease was taken"
+    assert not (home / "kanban" / "claim-quiet" / "last-started.json").exists(), "cooldown was committed"
+    assert not marker.exists(), "the observer must never start"
+
+
 @pytest.mark.live_system_guard_bypass  # we SIGKILL our own orphaned observer group
 def test_busy_when_another_process_holds_the_lease(home, tmp_path):
     pidfile = tmp_path / "pids"
