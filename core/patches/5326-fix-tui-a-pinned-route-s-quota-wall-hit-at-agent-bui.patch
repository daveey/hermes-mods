diff --git a/tests/tui_gateway/test_agent_init_quota_wall_card.py b/tests/tui_gateway/test_agent_init_quota_wall_card.py
new file mode 100644
index 0000000000..2f0d7671cb
--- /dev/null
+++ b/tests/tui_gateway/test_agent_init_quota_wall_card.py
@@ -0,0 +1,153 @@
+"""A chat pinned to a quota-walled subscription route whose agent BUILD hit the wall reads like the pre-build refusal.
+
+Example incident (Desktop, anthropic/claude-fable-5-2): the build raised ``SubscriptionQuotaUnavailable`` and the user got a
+toast with the raw epoch reset and `hermes setup` advice, a "Couldn't start this chat ... Retry" card and a "Send it
+again" boundary. The pre-build refusal of the same pin (``agent.model_routing_walls.held_reply``) already says the reset
+in PT and /model; the build-time path now says the same, as a non-retryable ``route_refused`` card."""
+import json
+
+import pytest
+
+from agent.model_routing_unavailable import SubscriptionQuotaUnavailable
+from tui_gateway import server
+
+RESET = 1795216785.57385  # Fri 11-20 15:19 PT
+HELD = ("⚠️ anthropic/claude-fable-5-2 subscription quota is out until Fri 11-20 15:19 PT. "
+        "This chat is pinned to it; use /model to switch, or resend after the reset.")
+
+
+@pytest.fixture(autouse=True)
+def isolate_recovery(monkeypatch):
+    # This worktree's gitdir belongs to the live installation; imports must not probe it.
+    monkeypatch.setattr("hermes_cli._early_recovery.restore_interrupted_pull", lambda *a, **kw: False)
+
+
+def _wall():
+    return SubscriptionQuotaUnavailable("anthropic", "claude-fable-5-2", RESET)
+
+
+# --- (a) one sentence for the pre-build and build-time refusal --------------------------------------------------
+
+def test_held_reply_is_the_walled_pin_reply():
+    from agent.model_routing_walls import held_reply, walled_pin_reply
+    assert walled_pin_reply("anthropic", "claude-fable-5-2", RESET) == HELD
+    assert held_reply(_wall()) == HELD
+
+
+# --- (b) the build-failure toast ---------------------------------------------------------------------------------
+
+def test_walled_build_message_names_the_reset_in_pt_and_model_not_an_epoch_or_setup():
+    from tui_gateway.user_messages import agent_init_failed_message
+    message = agent_init_failed_message(_wall())
+    assert message == HELD
+    assert "1795216785" not in message and "hermes setup" not in message
+
+
+def test_walled_build_behind_a_fallback_chain_names_the_terminal_route():
+    from hermes_cli.fallback_errors import ProviderFallbackError
+    from tui_gateway.user_messages import agent_init_failed_message
+    chain = ProviderFallbackError([("anthropic", "claude-fable-5-2", _wall())])
+    assert agent_init_failed_message(chain) == HELD
+
+
+@pytest.mark.parametrize("exc", [
+    RuntimeError("the session database is locked"),
+    SubscriptionQuotaUnavailable("anthropic", "claude-fable-5-2", float("nan")),  # no usable reset
+], ids=["unrelated", "quota-without-reset"])
+def test_other_build_failures_keep_the_generic_message(exc):
+    from tui_gateway.user_messages import agent_init_failed_message
+    message = agent_init_failed_message(exc)
+    assert message.startswith("Hermes could not start the assistant for this session. Details: ")
+    assert "hermes setup" in message
+
+
+# --- (c) the route is recorded server-side and never reaches a client ---------------------------------------------
+
+def test_walled_build_records_its_route_and_never_sends_it(tmp_path, monkeypatch):
+    from tests.tui_gateway.test_credential_failure import _strict_build
+    from tui_gateway.contracts import registry
+    assert registry.STRICT  # ErrorPayload forbids unknown keys: a leaked failure_route raises here
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    session, payloads, crashes = _strict_build(monkeypatch, _wall())
+    assert crashes == []
+    assert session["agent_failure"]["failure_route"] == {
+        "provider": "anthropic", "model": "claude-fable-5-2", "resets_at": RESET}
+    (payload,) = payloads
+    assert payload["message"] == HELD
+    assert "failure_route" not in payload and "failure_resets_at" not in payload
+    assert payload["reset_at"] == RESET
+    data = server._wait_agent(session, "r")["error"]["data"] or {}
+    assert "failure_route" not in data and "failure_resets_at" not in data
+
+
+def test_unrelated_build_failure_records_no_route(tmp_path, monkeypatch):
+    from tests.tui_gateway.test_credential_failure import _strict_build
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    session, _payloads, crashes = _strict_build(monkeypatch, RuntimeError("the session database is locked"))
+    assert crashes == []
+    assert "failure_route" not in (session.get("agent_failure") or {})
+
+
+# --- (d) the turn waiting on the build closes as a route refusal -------------------------------------------------
+
+def _turn_on_failed_build(monkeypatch, tmp_path, agent_failure, error_message):
+    """Submit a turn whose deferred build failed; return the client frames and the durable transcript rows."""
+    from tests.tui_gateway.test_submit_time_user_row import _desktop_session
+    from hermes_state import SessionDB
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    db = SessionDB(db_path=tmp_path / "state.db")
+    sid, key = _desktop_session(monkeypatch, db)
+    session = server._sessions[sid]
+    frames = []
+    monkeypatch.setattr(server, "write_json", lambda frame: frames.append(frame) or True)
+    monkeypatch.setattr(server, "_wait_agent_for_prompt",
+                        lambda _session, _rid, _sid: {"error": {"message": error_message}})
+    try:
+        session["agent_failure"] = agent_failure
+        with session["history_lock"]:
+            session["running"] = True
+            server._start_inflight_turn(session, "whats left")
+        assert server._persist_session_row_for_submit("rid", session, "whats left", None) is None
+        server._run_after_agent_ready("rid", sid, session, "whats left", None, None, None)
+        rows = db.get_messages_as_conversation(key, include_inactive=True)
+    finally:
+        server._sessions.pop(sid, None)
+        db.close()
+    complete = [f["params"]["payload"] for f in frames
+                if f.get("params", {}).get("type") == "message.complete"]
+    return complete, rows
+
+
+def _metadata(row):
+    meta = row.get("display_metadata")
+    return json.loads(meta) if isinstance(meta, str) else (meta or {})
+
+
+def test_walled_build_turn_closes_with_the_route_refused_card_and_no_send_it_again(monkeypatch, tmp_path):
+    from agent.turn_failure_copy import FAILED_TURN_DISPLAY_KIND, ROUTE_REFUSED_TURN_NOTICE
+    failure = {"failure_resets_at": RESET,
+               "failure_route": {"provider": "anthropic", "model": "claude-fable-5-2", "resets_at": RESET}}
+    complete, rows = _turn_on_failed_build(monkeypatch, tmp_path, failure, str(_wall()))
+    expected = {"layer": "gateway", "code": "route_refused", "retryable": False, "message": HELD}
+
+    (payload,) = complete
+    assert payload["status"] == "error"
+    assert payload["error_surface"] == expected
+    assert payload["error"] == HELD
+    assert "1795216785" not in payload["text"] and "/model" in payload["text"]
+    assert "failure_route" not in payload and "failure_resets_at" not in payload
+    assert payload["reset_at"] == RESET
+
+    assert [(r["role"], r["content"]) for r in rows] == [("user", "whats left"), ("assistant", ROUTE_REFUSED_TURN_NOTICE)]
+    boundary = rows[-1]
+    assert boundary["display_kind"] == FAILED_TURN_DISPLAY_KIND
+    assert "Send it again" not in boundary["content"]
+    assert _metadata(boundary)["error_surface"] == expected
+
+
+def test_control_other_build_failure_keeps_agent_init_failed(monkeypatch, tmp_path):
+    from agent.turn_failure_copy import FAILED_TURN_NOTICE
+    complete, rows = _turn_on_failed_build(monkeypatch, tmp_path, {}, "the session database is locked")
+    (payload,) = complete
+    assert payload["error_surface"] == {"layer": "runtime", "code": "agent_init_failed", "retryable": True}
+    assert [(r["role"], r["content"]) for r in rows] == [("user", "whats left"), ("assistant", FAILED_TURN_NOTICE)]
diff --git a/tui_gateway/credential_failure.py b/tui_gateway/credential_failure.py
index 387c1390fe..34983de2e5 100644
--- a/tui_gateway/credential_failure.py
+++ b/tui_gateway/credential_failure.py
@@ -32,13 +32,18 @@ def credential_failure_fields(provider: str, *, pool=None) -> dict:
     return {**fields, "failure_kind": "exhausted", "reset_at": min(resets) if resets else None}
 
 
+# [daveey] ``agent_failure`` keys no wire contract declares: ``failure_resets_at`` (the automation replay's clock)
+# and ``failure_route`` (the quota-walled pin the waiting turn's route-refused card names).
+_SERVER_ONLY_FAILURE_FIELDS = frozenset({"failure_resets_at", "failure_route"})
+
+
 def client_failure_fields(failure) -> dict:
     """[daveey] ``agent_failure`` as a client may see it. ``failure_resets_at`` is the automation replay's own
     clock (``automation_replay.replay_failed_wake``): the wire contracts declare ``reset_at`` instead, so it
-    fills ``reset_at`` when that is unset and never travels under its own name."""
+    fills ``reset_at`` when that is unset and never travels under its own name. ``failure_route`` never travels."""
     if not isinstance(failure, dict):
         return failure
-    fields = {k: v for k, v in failure.items() if k != "failure_resets_at"}
+    fields = {k: v for k, v in failure.items() if k not in _SERVER_ONLY_FAILURE_FIELDS}
     if fields.get("reset_at") is None and failure.get("failure_resets_at") is not None:
         fields["reset_at"] = failure["failure_resets_at"]
     return fields
@@ -91,8 +96,10 @@ def session_failure_payload(event: str, payload: dict, session: dict) -> dict:
         return payload
     surface = payload.get("error_surface") or {}
     code = surface.get("code")
-    if code == "agent_init_failed" and session.get("agent_failure"):
-        return {**payload, **client_failure_fields(session["agent_failure"])}
+    failure = session.get("agent_failure")
+    if failure and (code == "agent_init_failed"
+                    or (code == "route_refused" and isinstance(failure, dict) and failure.get("failure_route"))):
+        return {**payload, **client_failure_fields(failure)}
     if surface.get("layer") != "auth" and code not in {"rate_limit", "billing", "quota_exceeded"}:
         return payload
     from tui_gateway.server import _session_profile_runtime_scope
diff --git a/tui_gateway/methods_prompt.py b/tui_gateway/methods_prompt.py
index c3fffb2001..8a1823baff 100644
--- a/tui_gateway/methods_prompt.py
+++ b/tui_gateway/methods_prompt.py
@@ -671,14 +671,38 @@ def _persist_session_row_for_submit(rid, session, text=None, display_kind=None):
     return error
 
 
-def _close_agent_init_failed_turn(session: dict, message: str, error_surface: dict) -> None:
+def _agent_init_failure_surface(session: dict, message: str) -> tuple[str, dict, str | None]:
+    """[daveey] ``(message, error_surface, boundary notice)`` for a turn whose agent build failed.
+
+    A build refused by the pinned route's subscription quota wall (``agent_failure.failure_route``, recorded by
+    the build-failure handler) closes like the pre-build refusal of that pin (``gateway/run_turn_runner.py``
+    ``_resolution_failure_result``): a non-retryable ``route_refused`` card whose body names the reset in PT and
+    /model, and the boundary copy without "Send it again". Everything else stays ``agent_init_failed``."""
+    failure = session.get("agent_failure")
+    route = failure.get("failure_route") if isinstance(failure, dict) else None
+    if isinstance(route, dict):
+        try:
+            from agent.model_routing_walls import walled_pin_reply
+            reply = walled_pin_reply(route["provider"], route["model"], route["resets_at"])
+        except Exception:  # health: allow BLE001 -- a malformed record keeps the generic card
+            logger.warning("prompt.submit: unusable failure_route %r", route, exc_info=True)
+        else:
+            from agent.turn_failure_copy import ROUTE_REFUSED_TURN_NOTICE
+            return reply, {"layer": "gateway", "code": "route_refused", "retryable": False,
+                           "message": reply}, ROUTE_REFUSED_TURN_NOTICE
+    return message, {"layer": "runtime", "code": "agent_init_failed", "retryable": True}, None
+
+
+def _close_agent_init_failed_turn(
+        session: dict, message: str, error_surface: dict, notice: str | None = None) -> None:
     """[daveey] Close the accepted user row of a turn whose agent build failed with the failed-turn boundary.
 
     No agent ran, so neither ``agent/conversation_loop.py::_close_durable_failed_turn`` nor the gateway's
     ``_hmwa_close_failed_turn`` exists on this path: without this row the chat's durable tail stays the
     user row and its outcome reads ``unresolved{interrupted}`` forever instead of ``turn_failed``.
     Idempotent on the DURABLE tail (``OPEN_TURN_TAIL_ROLES``), like the other two closers: a redelivery
-    or a tail another writer already closed is a no-op. No tool ran, so the copy is ``FAILED_TURN_NOTICE``.
+    or a tail another writer already closed is a no-op. No tool ran, so the copy is ``FAILED_TURN_NOTICE``
+    unless *notice* replaces it (a route refusal's ``ROUTE_REFUSED_TURN_NOTICE``).
     Best-effort: the client frame still goes out when the store cannot be written."""
     sid = str(session.get("session_key") or "")
     if not sid:
@@ -692,7 +716,7 @@ def _close_agent_init_failed_turn(session: dict, message: str, error_surface: di
             if db is None or db.latest_conversation_role(sid) not in OPEN_TURN_TAIL_ROLES:
                 return
             error = redact_sensitive_text(str(message or "").strip()[:2000], force=True)
-            row = {"role": "assistant", "content": FAILED_TURN_NOTICE, "display_kind": FAILED_TURN_DISPLAY_KIND,
+            row = {"role": "assistant", "content": notice or FAILED_TURN_NOTICE, "display_kind": FAILED_TURN_DISPLAY_KIND,
                    "display_metadata": {k: v for k, v in (("error", error), ("error_surface", error_surface)) if v}}
             try:
                 db.append_message(sid, **row)
@@ -726,8 +750,8 @@ def _run_after_agent_ready(
         # without this the accepted message reads in agent.log as one that silently never ran. [daveey]
         logger.warning("prompt.submit: turn for session %s (%s) failed before the agent was ready: %s",
                        sid, session.get("session_key") or "", str(message)[:300])
-        surface = {"layer": "runtime", "code": "agent_init_failed", "retryable": True}
-        _close_agent_init_failed_turn(session, message, surface)
+        message, surface, notice = _agent_init_failure_surface(session, message)
+        _close_agent_init_failed_turn(session, message, surface, notice)
         # Terminal frame + retained snapshot (not a bare "error" event): the snapshot is
         # the only way resume shows this to a disconnected client.
         _emit_terminal_turn_error(sid, session, message, error_surface=surface)
