From d4af0e12c801d163cd32ee22de1ab8f3a9e082f3 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 02:28:06 +0000
Subject: [PATCH] test: await PTY EOF custody before closing test client
 [daveey]

The TestClient websocket context cancels its ASGI handler on exit. Exiting immediately after ready can cancel EOF cleanup before bridge.close reaches its executor, leaving the reservation permanently active. Waiting after portal teardown cannot fix this race.

Wait for release while the socket portal is alive; require both data and EOF reads. No production timeout or retry changes.

Proof: delayed close dispatch (200ms) reproduces original assertion failure; fixed file passes 5/5. Five descendant SIGSTOP/SIGCONT runs each before and after passed (150ms stopped/15ms runnable); starvation alone did not reproduce. scripts/check: 20 checks OK.
---
 tests/hermes_cli/test_quiet_pty_custody.py | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/tests/hermes_cli/test_quiet_pty_custody.py b/tests/hermes_cli/test_quiet_pty_custody.py
index dea6778c18..dbaebfb99c 100644
--- a/tests/hermes_cli/test_quiet_pty_custody.py
+++ b/tests/hermes_cli/test_quiet_pty_custody.py
@@ -101,6 +101,7 @@ def test_pty_route_holds_reservation_while_child_runs_and_releases_after_close(r
     """/api/pty (legacy 1:1 path) through the real handler: EOF closes the bridge, which releases."""
     from urllib.parse import urlencode
     from starlette.testclient import TestClient
+    from tests.waiting import wait_until
     import hermes_cli.web_server as ws
 
     chat, seen = bridge_env
@@ -123,12 +124,15 @@ def test_pty_route_holds_reservation_while_child_runs_and_releases_after_close(r
     try:
         with client.websocket_connect(f"/api/pty?{urlencode({'token': ws._SESSION_TOKEN})}") as conn:
             assert conn.receive_bytes() == b"ready"
+            # Keep the ASGI portal alive until EOF has reaped the child. Leaving
+            # this context cancels the handler and can prevent close from even
+            # reaching its executor; waiting after teardown cannot repair that.
+            wait_until(lambda: registry.snapshot().active == 0, what="EOF closes bridge and releases")
     finally:
         client.close()
     assert seen["active_at_spawn"] == 1
-    assert active_during_read and all(n == 1 for n in active_during_read)
-    from tests.waiting import wait_until
-    wait_until(lambda: registry.snapshot().active == 0, what="bridge close releases")
+    assert len(active_during_read) == 2, "the reader consumed data and then EOF"
+    assert all(n == 1 for n in active_during_read)
     _clean(registry)
 
 
