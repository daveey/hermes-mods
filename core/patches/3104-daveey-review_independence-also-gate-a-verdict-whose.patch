From 3095de887e6f1b3af7df2ccd8b9d3e31f72849fb Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 02:22:52 +0000
Subject: [PATCH] [daveey] review_independence: also gate a verdict whose own
 reviewed_pr names a core pull

Defect agent-8a7de4b89f: review card t_01a1cd9ac1af23fa named PR #1123 only in prose
("example-org/hermes PR #1123"), so core_pull(body) was None and the
independence gate (38677ae278, 41b11cf87c) never applied. The orchestrator chat completed
it with an in-chat delegate_task verdict and reviewed_pr = the core pull URL; complete_task
synthesized a zero-length run and `hermes-core-wt ship --review-task` refused it hours
later ("its latest run did not complete; no completed review record").

independence_refusal now falls back to the completion's own reviewed_pr when the body names
no core-fork pull: a verdict-bearing review result naming a core pull (URL or owner/repo#n)
from a caller with no worker run on the card is refused (review_independence, nothing
changes). The card's own dispatched worker, landing handoffs (published_pr), verdictless
handoffs and non-core reviewed_pr values are unaffected. Covers the tool, CLI and dashboard
paths through refuse_outside/completion_refusal.

Replay (earlier run, read-only over hub DBs + sync-shadow): 14798 completed events, 492 with
a synthesized run; 5 review completions would have been refused, incl. the incident card
(body-only rules caught 4, missing it).

Tests: 12 new cases RED on base; 6/6 applied mutants of the new rule killed.
Supersedes the original #1706 head 9b6e752cc9 (backed up as wt/review-run-fence-v1-9b6e752).
---
 hermes_cli/kanban_review_contract.py       | 25 +++++++-
 tests/tools/test_kanban_review_contract.py | 71 +++++++++++++++++++++-
 2 files changed, 90 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_review_contract.py b/hermes_cli/kanban_review_contract.py
index c391304209..8193047f0d 100644
--- a/hermes_cli/kanban_review_contract.py
+++ b/hermes_cli/kanban_review_contract.py
@@ -127,13 +127,28 @@ def refusal(body: Optional[str], metadata: Any) -> Optional[str]:
             "\"reviewed_pr\": \"https://github.com/<owner>/<repo>/pull/<n>\"}.")
 
 
+def reviewed_core_pull(metadata: Any) -> Optional[str]:
+    """The completion's own ``reviewed_pr`` when it names a core-fork pull, else None.
+
+    Review card t_01a1cd9ac1af23fa (defect agent-8a7de4b89f) named PR #1123 only in prose ("example-org/
+    daveey-hermes PR #1123"), so ``core_pull(body)`` is None; the chat's completion still recorded
+    ``reviewed_pr`` = the core pull URL with a verdict, and ship refused that record at land time.
+    """
+    pr = metadata.get("reviewed_pr") if isinstance(metadata, dict) else None
+    if not isinstance(pr, str):
+        return None
+    m = _PULL.search(pr) or re.fullmatch(r"(?P<repo>[\w.-]+/[\w.-]+)#\d+", pr.strip())
+    return pr.strip() if m and m.group("repo").lower() in CORE_REPOS else None
+
+
 def independence_refusal(body: Optional[str], metadata: Any, worker_run_id: Optional[int], *,
                          worker_shell: Optional[str] = None) -> Optional[str]:
     """The refusal text for a ship review verdict recorded outside the card's own dispatched worker run, else None.
 
     ``worker_run_id`` is the caller's dispatcher run id for this card (None for a chat, an orchestrator, the CLI or
     the dashboard; a worker's terminal shell gets it only once ``kanban_worker_shell.run_for`` proves the run). A ship
-    review card is one whose body names a core-fork pull (``states_contract`` implies it). Landing handoffs
+    review card is one whose body names a core-fork pull (``states_contract`` implies it); when the body names none,
+    the verdict's own ``reviewed_pr`` naming a core-fork pull makes it one (``reviewed_core_pull``). Landing handoffs
     (``published_pr``), completions with no verdict key and other cards are left alone. ``worker_shell`` is why the
     proof failed when the caller's ``HERMES_KANBAN_WORKER_TASK`` names this card: the card's own worker, for which
     "leave it for a worker" is the wrong advice.
@@ -143,9 +158,13 @@ def independence_refusal(body: Optional[str], metadata: Any, worker_run_id: Opti
     if not is_review_result(metadata) or not any(key in metadata for key in _VERDICT_KEYS):
         return None
     pull = core_pull(body)
-    if pull is None:
+    if pull is not None:
+        card = (f"this is a ship review card for {pull}" if states_contract(body)
+                else f"this card names core pull {pull}")
+    elif (pull := reviewed_core_pull(metadata)) is not None:
+        card = f"this completion reviews core pull {pull}"
+    else:
         return None
-    card = f"this is a ship review card for {pull}" if states_contract(body) else f"this card names core pull {pull}"
     if worker_shell:
         return (f"{card}, and this shell names it in HERMES_KANBAN_WORKER_TASK, but {worker_shell}. "
                 "`hermes-core-wt ship` accepts only a review completed by the card's own dispatched run with its "
diff --git a/tests/tools/test_kanban_review_contract.py b/tests/tools/test_kanban_review_contract.py
index cd8c40acbb..b93424c215 100644
--- a/tests/tools/test_kanban_review_contract.py
+++ b/tests/tools/test_kanban_review_contract.py
@@ -27,6 +27,8 @@ HEAD_BODY = ("Exact-head review of https://github.com/daveey/hermes/pull/1123 at
              "Complete with `reviewed_pr=https://github.com/daveey/hermes/pull/1123`, `reviewed_head=<sha>`, "
              "`verdict` approve or request_changes.")
 GOOD = {"verdict": "approve", "reviewed_sha": SHA, "reviewed_pr": PR}
+# A full review of a pull outside the core fork: no ship review, whoever completes it.
+NOT_CORE_GOOD = {**GOOD, "reviewed_pr": "https://github.com/me/myapp/pull/3730"}
 
 
 # --- contract detection --------------------------------------------------------------------------------------
@@ -315,9 +317,9 @@ def test_independence_refuses_outside_verdict_on_ship_review(body, md):
     (SHIP_BODY, {"reviewed_sha": SHA, "reviewed_pr": PR, "landed_sha": SHA}),  # no verdict key
     (PR_KEY_BODY, LANDING_MDS[0]),
     (SHIP_BODY, {"changed_files": ["a.py"]}), (SHIP_BODY, {}), (SHIP_BODY, None),
-    ("Fix the sidebar scroll.", dict(GOOD)),  # not a ship review card
+    ("Fix the sidebar scroll.", NOT_CORE_GOOD),  # not a ship review card
     (PR_KEY_BODY.replace(PR_KEY_PULL, "https://github.com/me/myapp/pull/3730"), dict(PR_KEY_MD)),
-    (None, dict(GOOD)),
+    (None, NOT_CORE_GOOD),
 ], ids=["landing", "no_verdict", "pr_key_landing", "no_review_key", "empty", "none", "not_ship", "myapp", "no_body"])
 def test_independence_leaves_non_reviews_alone(body, md):
     assert krc.independence_refusal(body, md, None) is None
@@ -364,7 +366,7 @@ def test_tool_dispatched_worker_completes_same_card(board, monkeypatch):
 
 
 @pytest.mark.parametrize("body,md", [
-    ("Fix the sidebar scroll. Done when its tests pass.", dict(GOOD)),  # not a ship review card
+    ("Fix the sidebar scroll. Done when its tests pass.", NOT_CORE_GOOD),  # not a ship review card
     (PR_KEY_BODY, dict(LANDING_MDS[0])),  # a verdictless landing handoff on a core-pull card
     (SHIP_BODY, {"changed_files": ["a.py"]}),  # no review key at all
 ], ids=["not_ship", "verdictless_landing", "no_review_key"])
@@ -558,3 +560,66 @@ def test_independence_names_a_core_pull_card_softly():
     msg = krc.independence_refusal(PR_KEY_BODY, dict(PR_KEY_MD), None) or ""
     assert msg.startswith(f"this card names core pull {PR_KEY_PULL}; ")
     assert krc.independence_refusal(SHIP_BODY, dict(GOOD), None).startswith(f"this is a ship review card for {PR};")
+
+
+# --- a brief that names the core pull only in prose (agent-8a7de4b89f) ---------------------------------------
+# Review card t_01a1cd9ac1af23fa named PR #1123 only as "example-org/hermes PR #1123", so core_pull(body)
+# was None and independence never applied; the orchestrator chat completed it with reviewed_pr = the core pull URL
+# and a delegate_task verdict, and ship refused the synthesized run at land time.
+PROSE_BODY = ("Independent exact-head delta review of example-org/hermes PR #1123 (review_required flag).\n"
+              "Done when: an approve or request_changes verdict that names the exact full SHA reviewed (reviewed_sha).")
+
+
+@pytest.mark.parametrize("pr", [PR, "example-org/hermes#1349", " https://github.com/Daveey/Hermes/pull/9 "])
+def test_independence_refuses_outside_verdict_named_only_by_reviewed_pr(pr):
+    md = {**GOOD, "reviewed_pr": pr}
+    assert krc.core_pull(PROSE_BODY) is None
+    msg = krc.independence_refusal(PROSE_BODY, md, None) or ""
+    assert msg.startswith(f"this completion reviews core pull {pr.strip()}; `hermes-core-wt ship` accepts only")
+    assert krc.independence_refusal(PROSE_BODY, md, 7) is None  # the card's own dispatched worker run
+    assert krc.refusal(PROSE_BODY, md) is None  # the shape gate on such a card is unchanged
+
+
+@pytest.mark.parametrize("md", [
+    {**GOOD, "reviewed_pr": "https://github.com/me/myapp/pull/3730"},  # another repository
+    {**GOOD, "reviewed_pr": "example-org/myapp#12"},
+    {**GOOD, "reviewed_pr": 1123}, {**GOOD, "reviewed_pr": "PR #1123"}, {**GOOD, "reviewed_pr": None},  # no pull
+    {"reviewed_sha": SHA, "reviewed_pr": PR},  # no verdict: a landing/cleanup handoff
+    {"published_pr": PR, "verdict": "approve", "reviewed_pr": PR},  # a landing handoff
+    {"verdict": "approve", "reviewed_sha": SHA},  # names no pull anywhere
+], ids=["myapp_url", "myapp_ref", "int", "prose", "none", "no_verdict", "landing", "no_pr"])
+def test_independence_reviewed_pr_rule_needs_a_core_pull_verdict(md):
+    assert krc.independence_refusal(PROSE_BODY, md, None) is None
+
+
+@pytest.mark.parametrize("md,want", [
+    ({"reviewed_pr": PR}, PR), ({"reviewed_pr": "example-org/hermes#3"}, "example-org/hermes#3"),
+    ({"reviewed_pr": "https://github.com/me/myapp/pull/1"}, None), ({"reviewed_pr": "x#1"}, None),
+    ({}, None), (None, None), ("reviewed_pr", None),
+])
+def test_reviewed_core_pull(md, want):
+    assert krc.reviewed_core_pull(md) == want
+
+
+def test_tool_refuses_outside_approval_named_only_by_reviewed_pr(board):  # RED before agent-8a7de4b89f
+    from tools import kanban_tools as kt
+    tid = _outside_card(board, PROSE_BODY)
+    out = json.loads(kt._handle_complete({"task_id": tid, "summary": "APPROVE (subagent verdict)",
+                                          "metadata": {**GOOD, "reviewed_pr": PR}}))
+    assert out.get("error") and out["rejection"] == "review_independence", out
+    assert f"this completion reviews core pull {PR}" in out["error"]
+    assert _status(board, tid) == "ready" and _runs(board, tid) == 0  # nothing changed, no synthesized run
+
+
+def test_cli_refuses_outside_approval_named_only_by_reviewed_pr(board, capsys):
+    tid = _outside_card(board, PROSE_BODY)
+    assert _cli_complete(tid, {**GOOD, "reviewed_pr": PR}, force=True) != 0
+    assert "review_independence" in capsys.readouterr().err
+    assert _status(board, tid) == "ready" and _runs(board, tid) == 0
+
+
+def test_tool_dispatched_worker_completes_prose_review_card(board, monkeypatch):
+    tid = _claim(board, monkeypatch, PROSE_BODY)
+    out = _complete({**GOOD, "reviewed_pr": PR})
+    assert not out.get("error"), out
+    assert _status(board, tid) == "done"
