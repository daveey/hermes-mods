From 252d273034fc71400c7ee352bf0c5da126ec52ce Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 15:30:47 +0000
Subject: [PATCH] fix(kanban): pin utf-8 decoding on host-reboot journalctl
 reader [daveey]

43cb700f69 added a text=True subprocess.run without encoding=, which
tests/hermes_cli/test_subprocess_text_encoding.py rejects; it turned
Python tests shard 2/2 red on main and every PR (e.g. run 40893068102).
---
 hermes_cli/kanban_host_reboot.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_host_reboot.py b/hermes_cli/kanban_host_reboot.py
index 13ef8fe5681..a711a13f301 100644
--- a/hermes_cli/kanban_host_reboot.py
+++ b/hermes_cli/kanban_host_reboot.py
@@ -82,7 +82,8 @@ def parse_power_commands(journal_text: str) -> list[dict]:
 
 def _read_journal(boot: str) -> str:
     p = subprocess.run(["journalctl", "-b", boot, "_COMM=sudo", "--no-pager", "-q", "-o", "short-iso"],
-                       capture_output=True, text=True, timeout=10, stdin=subprocess.DEVNULL, check=False)
+                       capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=10,
+                       stdin=subprocess.DEVNULL, check=False)
     return p.stdout if p.returncode == 0 else ""
 
 
