From 529b6c9f66abdd3bf7c1f412f326f567db664d7e Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 20:39:50 -0700
Subject: [PATCH] test(kanban): restart-safe scope test pins MemAvailable and
 asserts the 2x first-run cap [daveey]

CI run 40622987086 (8b741ea26b) shard 1: test_managed_gateway_worker_is_spawned_in_restart_safe_scope
expected MemoryMax=536870912 in the systemd-run argv.

Why 1: the spawned argv carries MemoryMax=1073741824, not the 512 MiB base.
Why 2: since 8b741ea26b every first run goes through raised_memory_max(base, 1, MemAvailable),
  which doubles the cap when MemAvailable minus the 4 GiB reserve admits it.
Why 3: the test pinned the base but not MemAvailable, so it read the runner's real /proc/meminfo
  (the hub: 17.7 GiB free) and its expectation encoded the old first-run cap.
Why not caught: 8b741ea26b updated test_kanban_oom_recovery.py but not this Linux-only sibling,
  which is skipped on macOS where the change was made.
Fix: pin hermes_cli.kanban_worker_scope.mem_available_bytes to 16 GiB and assert the doubled cap.
Verified on the Linux hub: red on main (512f93867f), green with this change
(with test_kanban_oom_recovery.py: 12 passed).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/hermes_cli/test_kanban_gateway_restart_handoff.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_kanban_gateway_restart_handoff.py b/tests/hermes_cli/test_kanban_gateway_restart_handoff.py
index c02c4308fb..890b643688 100644
--- a/tests/hermes_cli/test_kanban_gateway_restart_handoff.py
+++ b/tests/hermes_cli/test_kanban_gateway_restart_handoff.py
@@ -75,13 +75,15 @@ def test_managed_gateway_worker_is_spawned_in_restart_safe_scope(
     monkeypatch.setattr("tools.process_registry._is_supervised_gateway_process", lambda: True)
     monkeypatch.setattr("tools.process_registry._systemd_run_user_scope_available", lambda: True)
     monkeypatch.setattr("tools.process_registry._worker_memory_max_bytes", lambda: 536_870_912)
+    # First runs get 2x the base cap when MemAvailable admits it; pin it so the cap is host-independent.
+    monkeypatch.setattr("hermes_cli.kanban_worker_scope.mem_available_bytes", lambda: 16 * 1024**3)
     monkeypatch.setattr("shutil.which", lambda name: "/usr/bin/systemd-run")
 
     assert kbd._default_spawn(task, str(workspace)) == 4242
     assert captured_cmd[:4] == ["/usr/bin/systemd-run", "--user", "--scope", "--quiet"]
     unit_index = captured_cmd.index("--unit")
     assert captured_cmd[unit_index + 1] == "hermes-worker-kanban-t_candidate_restart-run-23"
-    assert "MemoryMax=536870912" in captured_cmd
+    assert "MemoryMax=1073741824" in captured_cmd
     separator = captured_cmd.index("--")
     assert captured_cmd[separator + 1 : separator + 4] == ["hermes", "-p", "coder"]
     assert captured_cwd == str(workspace)
