From 77a71becc9e63d410751944c752a1b956d2b2985 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 21:37:20 +0000
Subject: [PATCH] fix(kanban): prioritize branch destinations within refresh
 cap [daveey]

---
 hermes_cli/kanban_move_pool.py             | 13 ++++++++++-
 tests/hermes_cli/test_kanban_pool_queue.py | 26 ++++++++++++++++++++++
 2 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_move_pool.py b/hermes_cli/kanban_move_pool.py
index e3f3ff234d..e355110690 100644
--- a/hermes_cli/kanban_move_pool.py
+++ b/hermes_cli/kanban_move_pool.py
@@ -126,6 +126,13 @@ def pushed_on_remote(tree: str) -> bool:
         remotes = (git_out(["remote"], tree) or "").split()
         if not head or not remotes:
             return False
+        branch = git_out(["symbolic-ref", "-q", "HEAD"], tree)
+        preferred: set[tuple[str, str]] = set()
+        if branch:
+            destinations = git_out(["for-each-ref", "--format=%(upstream:remotename) %(upstream:remoteref)"
+                                    "%0a%(push:remotename) %(push:remoteref)", branch], tree) or ""
+            preferred = {(remote, ref) for line in destinations.splitlines() if " " in line
+                         for remote, ref in [line.split(" ", 1)]}
         stale: list[tuple[str, str, str]] = []
         fallback: list[tuple[str, str, str]] = []
         checks = 0
@@ -153,7 +160,11 @@ def pushed_on_remote(tree: str) -> bool:
                 # New URL-pushed branches have no tracking ref; rebased URL pushes
                 # can leave a tracking tip unrelated to HEAD. Both need a refresh.
                 fallback.append(candidate)
-        refresh = (stale + fallback)[:_MAX_REFRESHES]
+        # Spend the bounded refresh budget on this branch's likely destinations first,
+        # not the first five alphabetic heads of a large remote.
+        refresh = sorted(stale + fallback, key=lambda c: (
+            (c[0], c[1]) not in preferred, c[1] != branch,
+        ))[:_MAX_REFRESHES]
         for remote, ref, tracking in refresh:
             git_out(["fetch", "--no-tags", "-q", remote, f"+{ref}:{tracking}"], tree, timeout=_REMOTE_TIMEOUT)
         return bool(refresh) and not _worktree_has_unpushed_commits(tree)
diff --git a/tests/hermes_cli/test_kanban_pool_queue.py b/tests/hermes_cli/test_kanban_pool_queue.py
index 3362e799fe..53611cfd94 100644
--- a/tests/hermes_cli/test_kanban_pool_queue.py
+++ b/tests/hermes_cli/test_kanban_pool_queue.py
@@ -362,6 +362,32 @@ def test_url_push_moved_tip_without_ancestral_tracking(w2, tmp_path, monkeypatch
     assert _runs_on(w2.conn, tid) == [POOL]
 
 
+@pytest.mark.parametrize("destination", ["same-name", "upstream", "push"])
+def test_url_push_refresh_prioritizes_branch_over_earlier_heads(tmp_path, destination):
+    from hermes_cli import kanban_move_pool as kmp
+    tree = _pushed_clone(tmp_path, tmp_path / "priority")
+    remote = str(tmp_path / "priority-remote.git")
+    _git(tree, "branch", "-m", "wt/x")
+    # Six earlier heads must not spend the entire five-fetch budget.
+    for i in range(6):
+        _git(tree, "push", "-q", remote, f"HEAD:refs/heads/aaa/{i}")
+    _git(tree, "commit", "--amend", "-qm", "rewritten root")
+    branch = "wt/x" if destination == "same-name" else "zzz/destination"
+    if destination == "upstream":
+        _git(tree, "config", "branch.wt/x.remote", "origin")
+        _git(tree, "config", "branch.wt/x.merge", f"refs/heads/{branch}")
+    elif destination == "push":
+        _git(tree, "config", "remote.origin.push", f"refs/heads/wt/x:refs/heads/{branch}")
+    _git(tree, "push", "-q", "--force", remote, f"HEAD:refs/heads/{branch}")
+    other = tmp_path / "priority-other"
+    _git(tmp_path, "clone", "-q", "-b", branch, remote, str(other))
+    _commit(other, "advanced.txt")
+    _git(other, "push", "-q", "origin", f"HEAD:refs/heads/{branch}")
+    assert kmp.pushed_on_remote(str(tree))
+    _commit(tree, "unpublished.txt")
+    assert not kmp.pushed_on_remote(str(tree))
+
+
 @pytest.mark.parametrize("failure", ["bad-url", "timeout"])
 def test_remote_failure_pins_without_reading_stdin(w2, tmp_path, monkeypatch, failure):
     from hermes_cli import worktree_ops
