From 489c6652ef88c08780974fd4865c57c3d4d916c2 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 12:57:44 +0000
Subject: [PATCH] [daveey] managed worker: a teardown broken pipe never books a
 finished turn failed

close() re-flushed a control frame whose write already hit EPIPE (the child had exited),
raising BrokenPipeError from execute_managed's finally and replacing the completed reply.
Suppress it like Popen.communicate, and run every owner teardown through close_quietly so a
teardown OSError is logged, never the turn's outcome. Self-heal defect gateway-68129b876d.

Proof:
- RED on origin/main (fixes reverted, tests kept): test_close_tolerates_a_control_frame_that_raced_the_childs_exit
  and test_finished_turn_keeps_its_answer_when_worker_teardown_raises fail with BrokenPipeError.
- GREEN: tests/gateway/test_managed_worker*.py 41 files, 144 tests pass.
- Mutants (sdlc-review mutants.py, tests/gateway/test_managed_worker_drain.py): 6/6 killed -- stdin
  suppress, stdout suppress, stderr suppress, finally close_quietly, restart-path close_quietly,
  close_quietly's except OSError.
---
 gateway/session_kanban_restart.py          |   3 +-
 gateway/session_managed_worker.py          |  24 ++++-
 tests/gateway/test_managed_worker_drain.py | 106 +++++++++++++++++++++
 3 files changed, 128 insertions(+), 5 deletions(-)

diff --git a/gateway/session_kanban_restart.py b/gateway/session_kanban_restart.py
index 3b531eca4b..369c85e9b9 100644
--- a/gateway/session_kanban_restart.py
+++ b/gateway/session_kanban_restart.py
@@ -38,7 +38,8 @@ async def close_and_book_restart_loss(authority, policy, worker):
     """
     if not policy.kanban_json or not _restart_stop(worker.stop_cause):
         return worker.close
-    await asyncio.to_thread(worker.close)
+    from gateway.session_managed_worker import close_quietly
+    await asyncio.to_thread(close_quietly, worker.close)
     logger.info('Kanban restart: not checkpointing the turn (managed worker lost before its result); '
                 'the run is requeued uncounted')
     await book_restart_interruption(authority, policy)
diff --git a/gateway/session_managed_worker.py b/gateway/session_managed_worker.py
index 95892a8779..72599bff66 100644
--- a/gateway/session_managed_worker.py
+++ b/gateway/session_managed_worker.py
@@ -340,15 +340,31 @@ class ManagedWorker:
             self._signal_worker(kill=True)
         if self.writer.ident is not None:
             self.writer.join(timeout=5)
-        self.process.stdin.close()
+        # A control frame whose flush hit EPIPE (the child exited first) stays buffered, and close()
+        # flushes it again. As in Popen.communicate, that broken pipe is moot once the child is gone;
+        # the fd is closed either way.
+        with suppress(BrokenPipeError):
+            self.process.stdin.close()
         if self.reader is None:
-            self.process.stdout.close()
+            with suppress(OSError):
+                self.process.stdout.close()
         else:
             self.reader.join(timeout=5)
         if self.stderr_drain is not None:
             self.stderr_drain.join(timeout=5)  # EOF once the child is gone; the thread closes it
         elif self.process.stderr is not None:
-            self.process.stderr.close()
+            with suppress(OSError):
+                self.process.stderr.close()
+
+
+def close_quietly(close):
+    """Run a worker teardown whose OSError must never replace the turn's reply or its
+    ManagedExecutionUnknown: the turn's outcome was decided before cleanup began."""
+    try:
+        close()
+    except OSError as exc:
+        import logging
+        logging.getLogger(__name__).warning('Managed worker teardown failed: %s: %s', type(exc).__name__, exc)
 
 
 def interrupt_managed(authority, actor, ref, generation):
@@ -786,4 +802,4 @@ async def execute_managed(authority, ref, row, policy):
         raise ManagedExecutionUnknown('managed_worker_unknown') from exc
     finally:
         workers.pop(ref.session_id, None)
-        await asyncio.to_thread(close_worker)
+        await asyncio.to_thread(close_quietly, close_worker)
diff --git a/tests/gateway/test_managed_worker_drain.py b/tests/gateway/test_managed_worker_drain.py
index ef411dc261..5490a8a557 100644
