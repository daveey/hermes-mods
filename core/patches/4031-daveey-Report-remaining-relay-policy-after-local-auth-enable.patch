From a4d578cc4e6136d7a5dc48a1ef3e28b1fd99103a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 00:56:46 +0000
Subject: [PATCH] [daveey] Report remaining relay policy after local auth
 enable

---
 agent/credential_pool_disabled.py             | 14 +++++++++
 hermes_cli/auth_commands.py                   |  8 ++++-
 tests/hermes_cli/test_auth_disable_command.py | 29 +++++++++++++++++++
 3 files changed, 50 insertions(+), 1 deletion(-)

diff --git a/agent/credential_pool_disabled.py b/agent/credential_pool_disabled.py
index b8b4efe6ec..3b5a19016c 100644
--- a/agent/credential_pool_disabled.py
+++ b/agent/credential_pool_disabled.py
@@ -290,6 +290,20 @@ def forget_removed(provider: str, removed: Any, remaining: Iterable[Any]) -> boo
     return True
 
 
+def disabled_by_relay(provider: str, entry: Any) -> bool:
+    """Whether relay-owned policy in the active or root home still disables this row."""
+    from hermes_cli import auth as auth_mod
+    for path in {auth_mod._auth_file_path(), _root_path()} - {None}:
+        try:
+            store = json.loads(Path(path).read_text(encoding="utf-8-sig"))
+        except (OSError, ValueError):
+            continue
+        records = (r for r in _records(store, provider) if r.get("source") == "hub-oauth-relay")
+        if matches(entry, _keys_from_records(records)):
+            return True
+    return False
+
+
 def disabled_by_root(provider: str, entry: Any) -> bool:
     """True when the global root (not the active profile) holds a record disabling *entry*."""
     from hermes_cli import auth as auth_mod
diff --git a/hermes_cli/auth_commands.py b/hermes_cli/auth_commands.py
index 82eb44e777..add0ed3a61 100644
--- a/hermes_cli/auth_commands.py
+++ b/hermes_cli/auth_commands.py
@@ -511,7 +511,9 @@ def auth_priority_command(args) -> None:
 
 def _auth_set_disabled(args, disabled: bool) -> None:
     """`hermes auth disable|enable <provider> <target>`: switch one pooled credential off or back on."""
-    from agent.credential_pool_disabled import SUPPORTED_PROVIDERS, disabled_by_root, set_credential_disabled
+    from agent.credential_pool_disabled import (
+        SUPPORTED_PROVIDERS, disabled_by_relay, disabled_by_root, set_credential_disabled,
+    )
     provider = _normalize_provider(getattr(args, "provider", ""))
     if disabled and provider not in SUPPORTED_PROVIDERS:
         raise SystemExit(f"Disabling is supported for {', '.join(sorted(SUPPORTED_PROVIDERS))}, not {provider}; "
@@ -522,6 +524,10 @@ def _auth_set_disabled(args, disabled: bool) -> None:
     if matched is None or index is None:
         raise SystemExit(f"{error} Provider: {provider}.")
     changed = set_credential_disabled(provider, matched, disabled)
+    if not disabled and disabled_by_relay(provider, matched):
+        print(f"Still disabled: {provider} credential #{index} ({matched.label}) by hub-oauth-relay policy; "
+              "local disable cleared. Enable on the hub, then pull again.")
+        return
     verb = "Disabled" if disabled else "Enabled"
     state = "" if changed else " (already " + ("disabled" if disabled else "enabled") + ")"
     print(f"{verb} {provider} credential #{index} ({matched.label}){state}")
diff --git a/tests/hermes_cli/test_auth_disable_command.py b/tests/hermes_cli/test_auth_disable_command.py
index e2ddd15806..a7af998210 100644
--- a/tests/hermes_cli/test_auth_disable_command.py
+++ b/tests/hermes_cli/test_auth_disable_command.py
@@ -82,6 +82,35 @@ def test_enable_warns_when_root_disables(home, monkeypatch, tmp_path, capsys):
     assert "(already enabled)" in out and "global Hermes home also disables" in out
 
 
+@pytest.mark.parametrize("location", ["active", "root"])
+@pytest.mark.parametrize("local", [False, True])
+def test_enable_reports_remaining_relay_policy(home, monkeypatch, tmp_path, capsys, location, local):
+    from agent import credential_pool_disabled as cpd
+    from agent.credential_pool import load_pool
+    from hermes_cli import auth
+
+    store = auth._load_auth_store()
+    store["credential_pool"]["anthropic"][0]["source"] = "manual:hub_minted"
+    auth._save_auth_store(store)
+    if local:
+        _run("disable", "acct0")
+    record = {"label": "acct0", "source": "hub-oauth-relay", "scope": "manual:hub_minted"}
+    if location == "active":
+        store = auth._load_auth_store()
+        store.setdefault("disabled_credentials", {}).setdefault("anthropic", []).append(record)
+        auth._save_auth_store(store)
+    else:
+        root = tmp_path / "root.json"
+        root.write_text(json.dumps({"disabled_credentials": {"anthropic": [record]}}))
+        monkeypatch.setattr(cpd, "_root_path", lambda: root)
+    capsys.readouterr()
+    _run("enable", "acct0")
+    out = capsys.readouterr().out
+    assert "Still disabled" in out and "hub-oauth-relay" in out
+    assert "already enabled" not in out
+    assert cpd.is_credential_disabled("anthropic", load_pool("anthropic").entries()[0])
+
+
 def test_remove_forgets_the_disable_so_a_re_added_row_is_not_born_disabled(home):
     from hermes_cli.auth_commands import auth_remove_command
     _run("disable", "acct0")
