Subject: [PATCH 6823] Policy-config interning: exact-byte storage and opt-in rollout

Public mirror of source commit 0f36a16327b1c6bf4a104e0de615f5a3bd2fe30b.

---
diff --git a/tests/hermes_state/test_policy_config_consumers.py b/tests/hermes_state/test_policy_config_consumers.py
index 0c4f46f9103e934d5cd67e266f37ee80f67f0428..860e2ab11a119b1d89affeb584b16f527d6ff7e1 100644
--- a/tests/hermes_state/test_policy_config_consumers.py
+++ b/tests/hermes_state/test_policy_config_consumers.py
@@ -68,6 +68,9 @@
         _commit_policy(db, conn, sid, {'snapshot': snapshot, 'policy': changed})
     db._execute_write(update)
     assert local_receipt(db, sid)['policy'] == changed
+    with db._read_ctx() as conn:
+        assert conn.execute('SELECT COUNT(*) FROM state_meta WHERE key GLOB ?',
+                            (REF_PREFIX + '*',)).fetchone()[0] == 1
     db._execute_write(lambda conn: release_receipts(conn, [sid]))
     _assert_no_blobs(db)
 
