+afterEach(() => {
+  cleanup()
+  client.clear()
+  dispose()
+  locales()
+  unhook()
+  vi.unstubAllGlobals()
+})
+
+it('carries a qualified open request through the board, drawer, edits, uploads, download and related navigation', async () => {
+  const owner = { gateway: 'owner-a', profile: 'research', board: 'ops' }
+  const save = vi.fn().mockResolvedValue({ saved: true })
+  vi.stubGlobal('hermesDesktop', { saveGatewayFile: save })
+
+  const rest = vi.fn(async (path: string, opts?: PluginRestOptions) => {
+    const url = new URL(path, 'http://example.com')
+
+    if (url.pathname === '/boards') {return { current: 'default', boards: [] }}
+
+    if (url.pathname === '/board') {return { columns: [], tenants: [], assignees: [], latest_event_id: 1 }}
+
+    if (url.pathname === '/profiles') {return { profiles: [{ name: `${opts?.connectionId ?? 'ambient'}-worker` }] }}
+
+    if (url.pathname === '/orchestration') {return { default_assignee: '' }}
+
+    if (url.pathname.endsWith('/log')) {return { exists: false, content: '' }}
+
+    if (opts?.method) {return { ok: true }}
+
+    if (url.pathname.startsWith('/tasks/')) {
+      const id = url.pathname.split('/')[2]
+
+      return {
+        task: { id, title: `${opts?.connectionId}/${opts?.profile}/${id}`, status: 'todo', body: 'Description' },
