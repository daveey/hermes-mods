From a6335e96d6e06eeba91ad536230b1768f95ba36b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 22:09:50 -0800
Subject: [PATCH] fix(doctor): ninth review round - containers behind a
 wrapper, wrapper long flags

- a wrapper handing off to docker/podman/nerdctl (sudo docker run img tool
  -u admin:pw) starts the container image counting, so the inner program
  gets the generic user:pass rule
- sudo's long value flags (--user admin) are not the wrapped program
- non-ASCII characters in a decoded query value are dropped, not split at,
  so a secret is judged whole
- tests pin the duration handoff (timeout 5m) and the cases above; the rate
  fuzz runs middle lengths only where the code differs most

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_state_argv_secrets.py            | 16 ++++++----
 tests/hermes_state/test_argv_secrets.py | 42 +++++++++++++++++++++++--
 2 files changed, 49 insertions(+), 9 deletions(-)

diff --git a/hermes_state_argv_secrets.py b/hermes_state_argv_secrets.py
index b7df902de6..1b1fdb5c96 100644
--- a/hermes_state_argv_secrets.py
+++ b/hermes_state_argv_secrets.py
@@ -18,10 +18,10 @@ masked. This is a rate, not a guarantee, and some secrets look exactly like iden
 passwords (``correcthorse``), all-digit values, UUIDs, strings under 12 characters and a secret shaped like a
 kebab-case ``--flag`` right after a secret-named flag (read as the next flag, as switches need), unless a name marks
 them secret. Short hex (up to 12 characters) is shown on purpose: it is how commits are abbreviated; longer hex (full
-commits, digests, container ids) is masked with the keys it looks like. Encoded query values are judged decoded;
-non-ASCII characters in them (``%E2%9C%93``) are shown. ``--pin`` and ``--private`` are not secret names on purpose
-(switches or provider slugs in Hermes and common tools); the query names ``code``, ``session`` and ``hash`` are, so
-harmless values there are masked too.
+commits, digests, container ids) is masked with the keys it looks like. Encoded query values are judged decoded,
+with non-ASCII characters (``%E2%9C%93``) left out of the judgement and shown. ``--pin`` and ``--private`` are not
+secret names on purpose (switches or provider slugs in Hermes and common tools); the query names ``code``,
+``session`` and ``hash`` are, so harmless values there are masked too.
 """
 
 from __future__ import annotations
@@ -104,7 +104,9 @@ _USER_FLAG_PROGRAMS = frozenset({
 _CONTAINER_PROGRAMS = frozenset({"docker", "podman", "nerdctl"})
 # A wrapper's own flags that take a value, which is not the wrapped program (sudo -u admin ps …, nice -n 5 cmd).
 _WRAPPER_VALUE_FLAGS = {
-    "sudo": frozenset({"-u", "-g", "-C", "-h", "-p", "-U", "-r", "-t", "-D", "-R", "-T"}),
+    "sudo": frozenset({"-u", "-g", "-C", "-h", "-p", "-U", "-r", "-t", "-D", "-R", "-T", "--user", "--group",
+                       "--close-from", "--host", "--prompt", "--other-user", "--role", "--type", "--chdir",
+                       "--chroot", "--command-timeout"}),
     "doas": frozenset({"-u", "-C"}),
     "env": frozenset({"-u", "-C", "-S", "--unset", "--chdir", "--split-string"}),
     "nice": frozenset({"-n", "--adjustment"}),
@@ -503,7 +505,7 @@ def _judge_query_value(value: str, *, depth: int) -> str:
     decoded = urllib.parse.unquote(value)
     if decoded == value:
         return _judge(value, secret=False, depth=depth)
-    words = [word for word in re.split(r"[\s+]+", re.sub(r"[^\x00-\x7f]", " ", decoded)) if word]
+    words = [word for word in re.split(r"[\s+]+", re.sub(r"[^\x00-\x7f]", "", decoded)) if word]
     shown = [_judge(word, secret=False, depth=depth) for word in words]
     return value if all(MASK not in word for word in shown) else MASK
 
@@ -826,11 +828,13 @@ def mask_argv_secrets(argv: list[str], *, program: str = "", _depth: int = 0) ->
         if (wrapped := _program_flags(token)) is not None:
             flags, wrapper = wrapped, False  # sudo mysql …, docker exec db mysql …, env X=1 mysql …
             current = os.path.basename(token).lower()
+            container, before_image = current in _CONTAINER_PROGRAMS, 2  # sudo docker run img tool …
             out.append(token)
             continue
         if wrapper and not skip_handoff and "=" not in token and not _DURATION.fullmatch(token):
             # sshpass -p x ssh -p 2222 …: from the wrapped program on, its own flags (here none) apply
             current = os.path.basename(token).lower()
             flags, wrapper = _NO_FLAGS, current in _COMMAND_WRAPPERS
+            container, before_image = current in _CONTAINER_PROGRAMS, 2  # sudo docker run img tool …
         out.append(_judge(token, secret=False, depth=_depth))
     return out
diff --git a/tests/hermes_state/test_argv_secrets.py b/tests/hermes_state/test_argv_secrets.py
index 4454287de2..593c4cf3c2 100644
--- a/tests/hermes_state/test_argv_secrets.py
+++ b/tests/hermes_state/test_argv_secrets.py
@@ -672,14 +672,15 @@ def _shape(rng: random.Random, kind: str, length: int) -> str:
     }[kind]()
 
 
-# The two query positions take only the shortest and longest lengths: they share the URL path's code, and the
-# suite stays fast.
+# Every position runs the shortest and longest lengths; the middle ones run where the code differs most (bare
+# arguments, paths, URLs, env values), so the suite stays fast. Query positions share the URL code.
+_FULL_POSITIONS = frozenset({"bare", "path", "url", "spaced_env"})
 _RATE_CASES = [
     (position, kind, length)
     for position in sorted(_POSITIONS)
     for kind in _SHAPES
     for length in sorted(_LEAK_CEILING)
-    if not position.startswith("query_") or length in (16, 40)
+    if length in (16, 40) or (length == 24 and not position.startswith("query_")) or position in _FULL_POSITIONS
 ]
 
 
@@ -1215,3 +1216,38 @@ def test_a_docker_login_password_is_masked():
 def test_encoded_non_ascii_query_values_are_kept():
     value = "https://h/?q=%E2%9C%93&x=caf%C3%A9"
     assert shown([value]) == [value]
+
+
+# ---- the ninth review: containers behind a wrapper, wrapper long flags, durations, non-ASCII in a secret ----------
+
+
+@pytest.mark.parametrize(
+    "argv, program",
+    [
+        (["docker", "run", "--rm", "img", "tool", "-u", "admin:sunshine"], "sudo"),
+        (["-u", "root", "docker", "run", "img", "tool", "-u", "admin:sunshine"], "sudo"),
+        (["DOCKER_HOST=x", "docker", "run", "img", "tool", "-u", "admin:sunshine"], "env"),
+        (["60", "docker", "exec", "ctr", "tool", "--user", "admin:sunshine"], "timeout"),
+        (["podman", "run", "img", "./t", "-u", "admin:sunshine"], "nohup"),
+        (["-c", "sudo docker run img tool -u admin:sunshine"], "bash"),
+    ],
+)
+def test_a_container_started_through_a_wrapper_masks_the_inner_programs_password(argv, program):
+    out = " ".join(shown(argv, program))
+    assert "sunshine" not in out and f":{MASK}" in out
+
+
+@pytest.mark.parametrize(
+    "argv, program",
+    [
+        (["docker", "run", "-u", "app:app", "img"], "sudo"),
+        (["--user", "admin", "ps", "-u", "daveey:staff"], "sudo"),
+        (["5m", "ps", "-u", "daveey:staff"], "timeout"),
+    ],
+)
+def test_wrapper_long_flag_values_and_durations_are_not_the_wrapped_program(argv, program):
+    assert shown(argv, program) == argv
+
+
+def test_non_ascii_inside_an_encoded_secret_does_not_cut_it_into_short_pieces():
+    assert shown(["https://h/?q=Xk9%C3%A9mP2q%C3%BCL7vN4%C3%9FaB3c"]) == [f"https://h/?q={MASK}"]
-- 
2.43.0

