From 7074fd8be9b718a59857066c5c7eaedaf0d5f533 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 03:14:03 +0000
Subject: [PATCH] [daveey] Freeze retry header clock in metrics sender test

The HTTP-date fixture used wall time, so scheduler pauses aged its 120s deadline before parsing and CI returned 118 instead of 119/120. Freeze only retry_utils.datetime and retain real HTTP-date parsing, exact whole/fractional-second truncation, floor, cap and fallback assertions.

Proof: original CI run 43529546363 shows 118; controlled owned-pytest SIGSTOP/SIGCONT for 2.2s reproduced 117 on the unchanged fixture. Fixed cases pass the same pauses (2 passed); canonical whole file 10 passed; scripts/check --base origin/main: 20 checks OK. No retry policy or production changes.
---
 tests/agent/test_retry_delay_parsers_shared.py | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/tests/agent/test_retry_delay_parsers_shared.py b/tests/agent/test_retry_delay_parsers_shared.py
index e5bf332181..86607c4851 100644
--- a/tests/agent/test_retry_delay_parsers_shared.py
+++ b/tests/agent/test_retry_delay_parsers_shared.py
@@ -37,10 +37,17 @@ class TestRetryAfterHeaderOneParser:
         ctx = extract_api_error_context(err)
         assert 85 <= ctx["reset_at"] - time.time() <= 91
 
-    def test_metrics_sender_clamps_on_top_of_the_shared_parser(self):
+    @pytest.mark.parametrize("microsecond, expected", [(0, 120), (750_000, 119)])
+    def test_metrics_sender_clamps_on_top_of_the_shared_parser(self, monkeypatch, microsecond, expected):
+        from agent import retry_utils
         from hermes_cli.observability.shared_metrics_sender import _retry_after_seconds
 
-        assert _retry_after_seconds(_http_date(120), 7) in (119, 120)
+        # Freeze only the parser's clock: scheduler pauses must not age the header.
+        # Keep real HTTP-date parsing and cover the sender's integer truncation.
+        now = datetime(2026, 1, 1, microsecond=microsecond, tzinfo=UTC)
+        monkeypatch.setattr(retry_utils, "datetime", SimpleNamespace(now=lambda tz: now))
+        header = format_datetime(now + timedelta(seconds=120), usegmt=True)
+        assert _retry_after_seconds(header, 7) == expected
         assert _retry_after_seconds("0", 7) == 1          # floor survives
         assert _retry_after_seconds("99999999", 7) == 86_400  # cap survives
         assert _retry_after_seconds("garbage", 7) == 7
