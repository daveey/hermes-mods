--- /dev/null
+++ b/tests/hermes_cli/test_kanban_annotation_host_split.py
@@ -0,0 +1,155 @@
+"""Host header advances independently of immutable annotation bodies."""
+import json
+
+import pytest
+
+from hermes_cli import kanban_annotation_disk as disk
+
+SCOPE = ('split-host', 'default')
+
+
+@pytest.fixture
+def world(tmp_path, monkeypatch):
+    monkeypatch.setattr(disk, 'FORCE', True)
+    monkeypatch.setattr(disk, '_path', lambda scope: tmp_path / (scope[0] + '.json'))
+    monkeypatch.setattr(disk.time, 'time', lambda: 1000.0)
+    disk.reset()
+    yield tmp_path
+    disk.reset()
+
+
+def parts(value=1):
+    return ({'session': value},) + tuple({} for _ in range(11))
+
+
+def header():
+    return json.loads(disk._path(SCOPE).with_suffix('.host.json').read_text())
+
+
+def test_identical_parts_advance_header_without_rewriting_body(world, monkeypatch):
+    writes = []
+    original = disk._write_json
+
+    def record(path, body):
+        writes.append(path)
+        original(path, body)
+
+    monkeypatch.setattr(disk, '_write_json', record)
+    assert disk.save_host(SCOPE, 'input-1', 990, parts())
+    first = header()
+    assert 'parts' not in first
+    assert isinstance(first['parts_digest'], str)
+    writes.clear()
+    assert disk.save_host(SCOPE, 'input-2', 999, parts())
+    second = header()
+    assert second['parts_digest'] == first['parts_digest']
+    assert writes == [disk._path(SCOPE).with_suffix('.host.json')]
+    disk.reset()  # another process knows only disk state
+    assert disk.load_host(SCOPE) == ('input-2', 999, parts())
+
+
+def test_changed_parts_get_distinct_body_old_header_remains_readable(world):
+    assert disk.save_host(SCOPE, 'old', 990, parts(1))
+    old = header()
+    assert disk.save_host(SCOPE, 'new', 999, parts(2))
+    assert header()['parts_digest'] != old['parts_digest']
+    assert disk.load_host(SCOPE) == ('new', 999, parts(2))
+    disk._write_json(disk._path(SCOPE).with_suffix('.host.json'), old)
+    disk.reset()
+    assert disk.load_host(SCOPE) == ('old', 990, parts(1))
+
+
+def test_missing_body_repaired_even_with_warm_publisher(world):
+    assert disk.save_host(SCOPE, 'old', 990, parts())
+    bodies = list(world.glob('*.body.json'))
+    assert len(bodies) == 1
+    bodies[0].unlink()
+    assert disk.load_host(SCOPE) is None
+    assert disk.save_host(SCOPE, 'new', 999, parts())
+    assert disk.load_host(SCOPE) == ('new', 999, parts())
+
+
+def test_corrupt_body_is_not_adopted(world):
+    assert disk.save_host(SCOPE, 'old', 990, parts())
+    bodies = list(world.glob('*.body.json'))
+    assert len(bodies) == 1
+    bodies[0].write_text('{}')
+    disk.reset()
+    assert disk.load_host(SCOPE) is None
+
+
+def test_body_retention_is_bounded_and_previous_is_readable(world):
+    for value in range(12):
+        assert disk.save_host(SCOPE, str(value), 990, parts(value))
+    assert len(list(world.glob('*.body.json'))) <= 2
+    assert disk.load_host(SCOPE) == ('11', 990, parts(11))
+
+
+def test_warm_publisher_repairs_corrupt_body(world):
+    assert disk.save_host(SCOPE, 'old', 990, parts())
+    body = next(world.glob('*.body.json'))
+    body.write_text('{}')
+    assert disk.save_host(SCOPE, 'new', 999, parts())
+    assert disk.load_host(SCOPE) == ('new', 999, parts())
+
+
+def test_shared_read_reuses_body_but_observes_new_header(world, monkeypatch):
+    assert disk.save_host(SCOPE, 'old', 990, parts())
+    first = disk.load_host(SCOPE, shared=True)
+    assert disk.save_host(SCOPE, 'new', 999, parts())
+    monkeypatch.setattr(disk, '_decode_parts', lambda raw: pytest.fail('body decoded twice'))
+    second = disk.load_host(SCOPE, shared=True)
+    assert second[:2] == ('new', 999)
+    assert second[2] is first[2]
+
+
+def test_shared_read_rejects_changed_body_and_reset_clears(world, monkeypatch):
+    assert disk.save_host(SCOPE, 'old', 990, parts())
+    assert disk.load_host(SCOPE, shared=True) is not None
+    next(world.glob('*.body.json')).write_text('{}')
+    assert disk.load_host(SCOPE, shared=True) is None
+    assert disk.save_host(SCOPE, 'new', 999, parts())
+    assert disk.load_host(SCOPE, shared=True) is not None
+    disk.reset()
+    calls = []
+    original = disk._decode_parts
+    monkeypatch.setattr(disk, '_decode_parts', lambda raw: calls.append(True) or original(raw))
+    assert disk.load_host(SCOPE, shared=True) is not None
+    assert calls == [True]
+
+
+def test_reader_custody_refuses_concurrent_publish(world):
+    from hermes_cli.kanban_annotation_storage import custody
+    assert disk.save_host(SCOPE, 'old', 990, parts())
+    with custody(disk._path(SCOPE), writer=False):
+        assert not disk.save_host(SCOPE, 'new', 999, parts(2))
+        assert disk.load_host(SCOPE) == ('old', 990, parts())
+    assert disk.save_host(SCOPE, 'new', 999, parts(2))
+
+
+def test_new_publisher_reuses_existing_verified_body(world, monkeypatch):
+    assert disk.save_host(SCOPE, 'old', 990, parts())
+    first = disk.load_host(SCOPE, shared=True)
+    disk._host_saved.clear()  # a publisher has no other process's saved-parts memo
+    writes = []
+    original = disk._write_json
+    monkeypatch.setattr(disk, '_write_json', lambda path, body: writes.append(path) or original(path, body))
+    assert disk.save_host(SCOPE, 'new', 999, parts())
+    assert writes == [disk._path(SCOPE).with_suffix('.host.json')]
+    second = disk.load_host(SCOPE, shared=True)
+    assert second[:2] == ('new', 999)
+    assert second[2] is first[2]
+
+
+def test_header_publication_failure_preserves_previous_copy(world, monkeypatch):
+    assert disk.save_host(SCOPE, 'old', 990, parts(1))
+    original = disk._write_json
+
+    def fail_header(path, body):
+        if path.name.endswith('.host.json'):
+            raise OSError('controlled header failure')
+        original(path, body)
+
+    monkeypatch.setattr(disk, '_write_json', fail_header)
+    assert not disk.save_host(SCOPE, 'new', 999, parts(2))
+    assert disk.load_host(SCOPE) == ('old', 990, parts(1))
diff --git a/tests/hermes_cli/test_kanban_annotation_incremental.py b/tests/hermes_cli/test_kanban_annotation_incremental.py
new file mode 100644
index 0000000000..8864693ac1
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_annotation_incremental.py
@@ -0,0 +1,140 @@
+"""Incremental DependencySelector / TaskTokens deltas equal a fresh full scan; ledger current cache. [daveey]"""
+import json
+import random
+
+import pytest
+
+from hermes_cli import kanban_annotation_ledger as L
+from hermes_cli import kanban_annotation_semantic as semantic
+from hermes_cli.kanban_annotation_dependencies import DependencySelector
+from hermes_cli.kanban_replica_rows import Rows, pack
+
+ME, PROF = "gw1", "prof"
+
+
+def rows_at(gen, tasks, base_gen=None, changed=frozenset(), removed=frozenset(), previous=None):
+    by_key = {}
+    for k, t in tasks.items():
+        row = (*k, pack(json.dumps(t)), gen, gen)
+        if previous is not None and k not in changed and k in previous.by_key:
+            row = previous.by_key[k]  # the real delta reader keeps unchanged row objects
+        by_key[k] = row
+    return Rows(path="r", ident=(1, 2), gen=gen, base_gen=base_gen, changed=frozenset(changed),
+                removed=frozenset(removed), by_key=by_key, version_column="version", meta={}, sums=(), last_seq=gen)
+
+
+def random_task(rng, key, linked):
+    t = {"id": key[1].split("/")[-1], "title": rng.choice("abc"), "activity_at": rng.random()}
+    if linked:
+        t["sessions"] = [{"session": "s1", "gw": ME if rng.random() < 0.8 else "gwX", "profile": PROF,
+                          "rel": "shepherd"}]
+    return t
+
+
+@pytest.mark.parametrize("seed", range(12))
+def test_incremental_selection_equals_full_scan(seed):
+    rng = random.Random(seed)
+    universe = [(rng.choice(["gw1", "gw2"]), f"{rng.choice(['p', 'q'])}/b{rng.randrange(3)}/t{i % 15}")
+                for i in range(40)] + [("gw1", f"b0/t{i}") for i in range(5)]  # legacy twins share ids
+    universe = list(dict.fromkeys(universe))
+    tasks = {k: random_task(rng, k, rng.random() < 0.3) for k in universe[:25]}
+    toks, sel = semantic.TaskTokens(), DependencySelector()
+    prev = rows_at(1, tasks)
+    owner = ()
+    sel.select(prev, toks.advance(prev), ME, PROF, owner_keys=owner)
+    for gen in range(2, 60):
+        changed, removed = set(), set()
+        for _ in range(rng.randrange(1, 4)):
+            k = rng.choice(universe)
+            op = rng.random()
+            if op < 0.2 and k in tasks:
+                del tasks[k]
+                removed.add(k)
+                changed.discard(k)
+            elif op < 0.5:  # liveness-only
+                if k in tasks:
+                    tasks[k] = dict(tasks[k], activity_at=rng.random())
+                    changed.add(k)
+            else:
+                tasks[k] = random_task(rng, k, rng.random() < 0.4)
+                changed.add(k)
+                removed.discard(k)
+        if rng.random() < 0.1:
+            owner = (rng.choice(universe),)
+        cur = rows_at(gen, tasks, base_gen=prev.gen, changed=changed, removed=removed, previous=prev)
+        mapping = toks.advance(cur)
+        got = sel.select(cur, mapping, ME, PROF, owner_keys=owner, changed=toks.changed, base=toks.base)
+        want = DependencySelector().select(cur, mapping, ME, PROF, owner_keys=owner)
+        assert got == want, gen
+        prev = cur
+    assert sel.full_scans == 1  # every later generation was served incrementally
+
+
+def test_unrelated_change_reuses_result_object_without_scan():
+    linked = {"session": "s1", "gw": ME, "profile": PROF, "rel": "shepherd"}
+    tasks = {("gw1", f"p/b/t{i}"): {"id": f"t{i}", "title": "x"} for i in range(200)}
+    tasks[("gw1", "p/b/t0")]["sessions"] = [linked]
+    toks, sel = semantic.TaskTokens(), DependencySelector()
+    r1 = rows_at(1, tasks)
+    first = sel.select(r1, toks.advance(r1), ME, PROF)
+    tasks[("gw1", "p/b/t7")] = {"id": "t7", "title": "changed"}
+    r2 = rows_at(2, tasks, base_gen=1, changed={("gw1", "p/b/t7")}, previous=r1)
+    m2 = toks.advance(r2)
+    decodes = sel.decodes
+    again = sel.select(r2, m2, ME, PROF, changed=toks.changed, base=toks.base)
+    assert again is first
+    assert sel.decodes == decodes + 1 and sel.full_scans == 1
+    tasks[("gw1", "p/b/t0")] = {"id": "t0", "title": "substantive", "sessions": [linked]}
+    r3 = rows_at(3, tasks, base_gen=2, changed={("gw1", "p/b/t0")}, previous=r2)
+    m3 = toks.advance(r3)
+    moved = sel.select(r3, m3, ME, PROF, changed=toks.changed, base=toks.base)
+    assert moved != first and moved == DependencySelector().select(r3, m3, ME, PROF)
+
+
+def test_wrong_base_falls_back_to_full_scan():
+    tasks = {("gw1", "p/b/t1"): {"id": "t1", "title": "x"}}
+    toks, sel = semantic.TaskTokens(), DependencySelector()
+    r1 = rows_at(1, tasks)
+    sel.select(r1, toks.advance(r1), ME, PROF)
+    tasks[("gw1", "p/b/t1")] = {"id": "t1", "title": "y"}
+    r2 = rows_at(2, tasks, base_gen=1, changed={("gw1", "p/b/t1")}, previous=r1)
+    m2 = toks.advance(r2)
+    sel.select(r2, m2, ME, PROF, changed=toks.changed, base={})  # not the mapping it last saw
+    assert sel.full_scans == 2
+
+
+def test_failed_incremental_call_leaves_state_intact():
+    linked = [{"session": "s1", "gw": ME, "profile": PROF, "rel": "shepherd"}]
+    tasks = {("gw1", "p/b/t1"): {"id": "t1", "title": "x", "sessions": linked}}
+    toks, sel = semantic.TaskTokens(), DependencySelector()
+    r1 = rows_at(1, tasks)
+    first = sel.select(r1, toks.advance(r1), ME, PROF)
+    tasks[("gw1", "p/b/t1")] = {"id": "t1", "title": "y", "sessions": linked}
+    r2 = rows_at(2, tasks, base_gen=1, changed={("gw1", "p/b/t1")}, previous=r1)
+    m2 = toks.advance(r2)
+    bad = dict(m2)
+    bad[("gw1", "p/b/t1")] = ""  # an invalid token for a changed key: phase 1 raises before any mutation
+    with pytest.raises(ValueError):
+        sel.select(r2, bad, ME, PROF, changed=toks.changed, base=toks.base)
+    assert sel._result is first and sel._tokens is not m2 and sel._tokens is toks.base
+    assert sel.select(r2, m2, ME, PROF, changed=toks.changed, base=toks.base) != first
+    assert sel.full_scans == 1
+
+
+def test_current_cache_reuses_verdict_only_for_identical_row_and_ledger():
+    row_task = {"id": "t1", "x": 1}
+    obligation = {"binding_id": "b1", "task_json": json.dumps(row_task), "observation_version": 3,
+                  "binding": {"owner": {"gateway": "g"}, "task_record_key": "p/b/t1"}}
+    ledger = L.LedgerSnapshot("gw", "p", (obligation,), (), (), (), "tok")
+    row = ("g", "p/b/t1", pack(json.dumps(row_task)), 3, 3)
+
+    class R:
+        by_key = {("g", "p/b/t1"): row}
+
+    cache: dict = {}
+    assert L.current_matches(ledger, R, cache) == (("b1", True),)
+    assert cache["b1"][0] is row
+    R.by_key = {("g", "p/b/t1"): ("g", "p/b/t1", pack(json.dumps({"id": "t1", "x": 2})), 3, 3)}
+    assert L.current_matches(ledger, R, cache) == (("b1", False),)  # new row object: recomputed
+    stale = dict(obligation, task_json=json.dumps({"id": "t1", "x": 2}))
+    assert L.current_matches(L.LedgerSnapshot("gw", "p", (stale,), (), (), (), "t2"), R, cache) == (("b1", True),)
diff --git a/tests/hermes_cli/test_kanban_annotation_ledger.py b/tests/hermes_cli/test_kanban_annotation_ledger.py
new file mode 100644
index 0000000000..763bec7a70
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_annotation_ledger.py
@@ -0,0 +1,195 @@
+import dataclasses
+import json
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_annotation_ledger as L
+from hermes_cli import kanban_origin_ledger as O
+
+
+def _binding(task="t1", origin=("gw", "p", "s1"), owner=("ogw", "op", "board"), bid="b1"):
+    return {"binding_id": bid, "version": 1,
+            "owner": {"gateway": owner[0], "profile": owner[1], "board": owner[2], "task_id": task},
+            "origin": {"gateway": origin[0], "profile": origin[1], "session": origin[2]},
+            "task_record_key": f"{owner[1]}/{owner[2]}/{task}", "publication_version": 1}
+
+
+def _conn(tmp_path):
+    c = sqlite3.connect(tmp_path / "l.db", isolation_level=None)
+    c.execute("CREATE TABLE origin_obligations (binding_id TEXT PRIMARY KEY, binding_hash TEXT NOT NULL,"
+              "binding_json TEXT NOT NULL, resolved_session TEXT NOT NULL, task_json TEXT NOT NULL,"
+              "observation_version INTEGER NOT NULL, released INTEGER NOT NULL DEFAULT 0)")
+    c.execute("CREATE TABLE origin_receipts (request_id TEXT PRIMARY KEY NOT NULL, binding_hash TEXT NOT NULL,"
+              "receipt_json TEXT NOT NULL)")
+    return c
+
+
+def _add(c, b, *, released=0, task='{"a": 1}', version=3, rid=None, receipt_hash=None, col_hash=None):
+    h = O.binding_hash(b)
+    c.execute("INSERT INTO origin_obligations VALUES (?,?,?,?,?,?,?)",
+              (O._binding_key(b), col_hash or h, O._json(b), "res", task, version, released))
+    if rid:
+        c.execute("INSERT INTO origin_receipts VALUES (?,?,?)",
+                  (rid, col_hash or h, json.dumps({"binding_hash": receipt_hash or h, "status": "accepted"})))
+
+
+def _snap(c, gw="gw", p="p"):
+    c.execute("BEGIN")
+    try:
+        return L.snapshot(c, gw, p)
+    finally:
+        c.rollback()
+
+
+def test_requires_read_transaction(tmp_path):
+    c = _conn(tmp_path)
+    with pytest.raises(ValueError, match="origin_ledger_snapshot_required"):
+        L.snapshot(c, "gw", "p")
+
+
+def test_missing_tables_fail_closed_and_no_schema_created(tmp_path):
+    c = sqlite3.connect(tmp_path / "e.db", isolation_level=None)
+    with pytest.raises(sqlite3.OperationalError, match="no such table"):
+        _snap(c)
+    assert c.execute("SELECT count(*) FROM sqlite_master").fetchone()[0] == 0
+
+
+@pytest.mark.parametrize("table", ["origin_obligations", "origin_receipts"])
+def test_partial_schema_fails_closed(tmp_path, table):
+    c = _conn(tmp_path)
+    _add(c, _binding(), rid="req-00000001")
+    c.execute(f"DROP TABLE {table}")
+    with pytest.raises(sqlite3.OperationalError, match="no such table"):
+        _snap(c)
+
+
+def test_filters_origin_and_keeps_released_raw(tmp_path):
+    c = _conn(tmp_path)
+    _add(c, _binding("t1"), released=1, rid="req-00000001", task='{ "z":1 }')
+    _add(c, _binding("t2", bid="b2"), released=0)
+    _add(c, _binding("t3", origin=("other", "p", "s"), bid="b3"), rid="req-00000003")
+    _add(c, _binding("t4", origin=("gw", "q", "s"), bid="b4"))
+    s = _snap(c)
+    assert [o["binding"]["owner"]["task_id"] for o in s.obligations] == ["t1", "t2"]
+    first = s.obligations[0]
+    assert first["released"] == 1 and first["task_json"] == '{ "z":1 }' and first["observation_version"] == 3
+    assert [r["request_id"] for r in s.receipts] == ["req-00000001"]
+    assert s.owner_keys == (("ogw", "op/board/t1"), ("ogw", "op/board/t2"))
+    assert s.own_boards == ()
+
+
+def test_receipt_links_by_parsed_binding_hash_not_sql_column(tmp_path):
+    c = _conn(tmp_path)
+    b = _binding("t1")
+    _add(c, b, rid="req-00000001")
+    # SQL column points to the relevant hash but parsed receipt says foreign: excluded.
+    c.execute("INSERT INTO origin_receipts VALUES (?,?,?)",
+              ("req-00000002", O.binding_hash(b), json.dumps({"binding_hash": "f" * 64})))
+    # SQL column foreign but parsed hash relevant: included.
+    c.execute("INSERT INTO origin_receipts VALUES (?,?,?)",
+              ("req-00000003", "f" * 64, json.dumps({"binding_hash": O.binding_hash(b)})))
+    s = _snap(c)
+    assert [r["request_id"] for r in s.receipts] == ["req-00000001", "req-00000003"]
+    assert s.receipts[1]["binding_hash"] == "f" * 64  # raw column preserved
+
+
+def test_local_owner_populates_own_boards(tmp_path):
+    c = _conn(tmp_path)
+    _add(c, _binding("t1", owner=("gw", "p", "main")))
+    _add(c, _binding("t2", owner=("gw", "p", "alt"), bid="b2"))
+    _add(c, _binding("t3", owner=("gw", "x", "nope"), bid="b3"))
+    assert _snap(c).own_boards == (("p", "alt"), ("p", "main"))
+
+
+def test_token_deterministic_independent_of_insert_order(tmp_path):
+    bs = [_binding(f"t{i}", bid=f"b{i}") for i in range(3)]
+    c1 = _conn(tmp_path)
+    for i, b in enumerate(bs):
+        _add(c1, b, rid=f"req-0000000{i}")
+    c2 = sqlite3.connect(":memory:", isolation_level=None)
+    for (sql,) in c1.execute("SELECT sql FROM sqlite_master WHERE sql IS NOT NULL"):
+        c2.execute(sql)
+    for i, b in reversed(list(enumerate(bs))):
+        _add(c2, b, rid=f"req-0000000{i}")
+    assert _snap(c1).token == _snap(c2).token
+
+
+def test_token_changes_on_any_relevant_column(tmp_path):
+    c = _conn(tmp_path)
+    b = _binding()
+    _add(c, b, rid="req-00000001")
+    before = _snap(c).token
+    for sql in ("UPDATE origin_obligations SET released=1", "UPDATE origin_obligations SET observation_version=9",
+                "UPDATE origin_obligations SET task_json='{\"a\":1}'",
+                "UPDATE origin_obligations SET resolved_session='zz'",
+                "UPDATE origin_receipts SET receipt_json=receipt_json||' '"):
+        c.execute(sql)
+        after = _snap(c).token
+        assert after != before, sql
+        before = after
+    # foreign rows do not move the token
+    _add(c, _binding("t9", origin=("o", "o", "o"), bid="b9"), rid="req-00000009")
+    assert _snap(c).token == before
+
+
+def test_immutable(tmp_path):
+    c = _conn(tmp_path)
+    _add(c, _binding(), rid="req-00000001")
+    s = _snap(c)
+    with pytest.raises(dataclasses.FrozenInstanceError):
+        s.token = "x"
+    with pytest.raises(TypeError):
+        s.obligations[0]["released"] = 5
+    with pytest.raises(TypeError):
+        s.obligations[0]["binding"]["owner"]["task_id"] = "x"
+    assert isinstance(s.obligations, tuple) and isinstance(s.owner_keys, tuple)
+    c.execute("UPDATE origin_obligations SET released=1")
+    assert s.obligations[0]["released"] == 0
+
+
+@pytest.mark.parametrize("mutate", [
+    lambda b: b.pop("owner"),
+    lambda b: b["origin"].update(session="bad session"),
+    lambda b: b.update(task_record_key="wrong"),
+])
+def test_malformed_binding_fails_closed_even_foreign(tmp_path, mutate):
+    c = _conn(tmp_path)
+    b = _binding(origin=("other", "p", "s"))
+    _add(c, b)
+    bad = json.loads(O._json(b))
+    mutate(bad)
+    c.execute("UPDATE origin_obligations SET binding_json=?", (json.dumps(bad),))
+    with pytest.raises(ValueError, match="origin_binding_invalid"):
+        _snap(c)
+
+
+def test_non_json_binding_and_receipt_fail_closed(tmp_path):
+    c = _conn(tmp_path)
+    _add(c, _binding())
+    c.execute("INSERT INTO origin_receipts VALUES ('req-00000001','h','not json')")
+    with pytest.raises(ValueError, match="origin_receipt_invalid"):
+        _snap(c)
+    c.execute("DELETE FROM origin_receipts")
+    c.execute("UPDATE origin_obligations SET binding_json='{'")
+    with pytest.raises(ValueError, match="origin_binding_invalid"):
+        _snap(c)
+
+
+def test_key_and_hash_mismatch_fail_closed(tmp_path):
+    c = _conn(tmp_path)
+    _add(c, _binding(), col_hash="a" * 64)
+    with pytest.raises(ValueError, match="origin_obligation_inconsistent"):
+        _snap(c)
+    c.execute("DELETE FROM origin_obligations")
+    _add(c, _binding())
+    c.execute("UPDATE origin_obligations SET binding_id='wrong'")
+    with pytest.raises(ValueError, match="origin_obligation_inconsistent"):
+        _snap(c)
+
+
+def test_bad_args(tmp_path):
+    c = _conn(tmp_path)
+    c.execute("BEGIN")
+    with pytest.raises(ValueError, match="origin_scope_invalid"):
+        L.snapshot(c, "", "p")
