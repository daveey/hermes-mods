new file mode 100644
index 0000000000..5f3864ff45
--- /dev/null
+++ b/hermes_cli/kanban_annotation_narrow.py
@@ -0,0 +1,189 @@
+"""Display/holder-only narrow origin key for the annotation holder. [daveey]
+
+The holder probes the exact fingerprint every 2 s. When it moved, this key
+decides whether the move was substantive for the annotation of one origin
+scope. It is NEVER used by strict callers (task APIs, closeout, the default
+``_remote_links()``): those keep the exact ``_links_fingerprint`` path.
+
+Key inputs (union for one origin ``(gateway, profile)``):
+  * hub replica rows linking this origin (and ledger-bound owner rows, plus
+    every same ``(board, id)`` publisher) by liveness-normalized semantic token
+    (``kanban_annotation_semantic``): ``activity_at``/``activity_kind`` and a
+    valid observation's ``task_hash`` restamp do not move the key;
+  * the scoped origin-ledger snapshot token and its raw current-match bits;
+  * gateway info rows with ``observed_at`` clocks reduced to 180 s buckets,
+    and the replica's ``last_ok`` as a 180 s bucket plus ``offline_since``;
+  * every own-board and sync-shadow content key from the exact fingerprint
+    (unchanged), plus the exact waiting inputs and code identity.
+
+Anything the key misses is bounded by the holder's 20 s forced renewal; any
+read error returns None, which the holder treats as "moved" (exact fallback).
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import math
+import threading
+from pathlib import Path
+
+log = logging.getLogger(__name__)
+
+_VERSION = 1
+BUCKET_S = 180.0
+stats = {"keys": 0, "errors": 0, "selections": 0}
+
+
+def _bucket(value) -> int | None:
+    if value is None:
+        return None
+    value = float(value)
+    if not math.isfinite(value):
+        raise ValueError("nonfinite clock")
+    return int(value // BUCKET_S)
+
+
+def _normalize_info(value):
+    """Gateway info with every ``observed_at`` clock bucketed; other fields verbatim."""
+    if isinstance(value, dict):
+        return {k: (_bucket(v) if k == "observed_at" and isinstance(v, (int, float)) else _normalize_info(v))
+                for k, v in value.items()}
+    if isinstance(value, list):
+        return [_normalize_info(v) for v in value]
+    return value
+
+
+def _infos(rows: tuple) -> list:
+    from hermes_cli.kanban_replica_rows import text
+
+    out = []
+    for gw, data in rows:
+        info = json.loads(text(data) if not isinstance(data, str) else data)
+        # A collector's heartbeat period jitters by seconds; it only sizes a >=450 s window.
+        if isinstance(info, dict) and isinstance(info.get("scope_heartbeat_period_s"), (int, float)):
+            info = dict(info, scope_heartbeat_period_s=round(info["scope_heartbeat_period_s"] / 60))
+        out.append([gw, _normalize_info(info)])
+    return out
+
+
+class _ScopeState:
+    def __init__(self) -> None:
+        self.lock = threading.Lock()
+        self.clear()
+
+    def clear(self) -> None:
+        """Drop every derived view (never the lock): a failed read is never reused."""
+        from hermes_cli.kanban_annotation_dependencies import DependencySelector
+        from hermes_cli.kanban_annotation_reader import ReplicaReader
+        from hermes_cli.kanban_annotation_semantic import TaskTokens
+
+        self.reader = ReplicaReader()
+        self.tokens = TaskTokens()
+        self.selector = DependencySelector()
+        self.memo: tuple | None = None  # (selection object, its digest)
+        self.ledger_memo: tuple | None = None  # (fence, LedgerSnapshot)
+        self.current_cache: dict = {}
+
+
+_states: dict[tuple, _ScopeState] = {}
+_states_lock = threading.Lock()
+_SCOPE_CAP = 32
+
+
+def _state(scope: tuple[str, ...]) -> _ScopeState:
+    with _states_lock:
+        state = _states.get(scope)
+        if state is None:
+            while len(_states) >= _SCOPE_CAP:
+                del _states[next(iter(_states))]
+            state = _states[scope] = _ScopeState()
+        return state
+
+
+def reset() -> None:
+    with _states_lock:
+        _states.clear()
+
+
+def _ledger_path() -> Path:
+    from hermes_constants import get_hermes_home
+
+    return get_hermes_home() / "kanban" / "origin-ledger.db"
+
+
+def _origin_part(state: _ScopeState, profile: str) -> list:
+    from hermes_cli import kanban_annotation_ledger as kal
+    from hermes_cli import kanban_session_activity as ksa
+
+    hub = ksa._hub_db_path()
+    if hub is None or not Path(hub).is_file():
+        return ["no-hub"]
+    with ksa.cached_ro(Path(hub), busy_budget=0) as conn:
+        conn.execute("BEGIN")
+        try:
+            snap = state.reader.read(conn, hub)
+        finally:
+            conn.rollback()
+    rows = snap.rows
+    tokens = state.tokens.advance(rows)
+    ledger_path = _ledger_path()
+    if ledger_path.is_file():
+        with ksa.cached_ro(ledger_path, busy_budget=0) as lconn:
+            lconn.execute("BEGIN")
+            try:
+                # [daveey] Same connection, same data_version/total_changes, same file: no commit since the last
+                # snapshot, so the O(obligations) decode + binding-hash validation is not repeated.
+                st = ledger_path.stat()
+                fence = (lconn, lconn.execute("PRAGMA data_version").fetchone()[0], lconn.total_changes,
+                         st.st_dev, st.st_ino, snap.gateway, profile)
+                memo = state.ledger_memo
+                if memo is not None and len(memo[0]) == len(fence) and all(
+                        a is b or a == b for a, b in zip(memo[0], fence)):
+                    ledger = memo[1]
+                else:
+                    ledger = kal.snapshot(lconn, snap.gateway, profile)
+                    state.ledger_memo = (fence, ledger)
+            finally:
+                lconn.rollback()
+        current = kal.current_matches(ledger, rows, state.current_cache)
+        ledger_token, owner_keys = ledger.token, ledger.owner_keys
+    else:
+        current, ledger_token, owner_keys = (), "absent", ()
+    selection = state.selector.select(rows, tokens, snap.gateway, profile, owner_keys=owner_keys,
+                                      changed=state.tokens.changed, base=state.tokens.base)
+    if state.memo is None or state.memo[0] is not selection:
+        stats["selections"] += 1
+        digest = hashlib.sha256(json.dumps([[list(k), t] for k, t in selection], separators=(",", ":"),
+                                           allow_nan=False).encode()).hexdigest()
+        state.memo = (selection, digest)
+    return [snap.gateway, ledger_token, [list(c) for c in current], state.memo[1],
+            _infos(snap.info_rows), _bucket(snap.last_ok), snap.offline_since is not None]
+
+
+def key(scope: tuple[str, ...], full: tuple, waiting: list) -> str | None:
+    """Narrow key for ``scope``; ``full`` is the exact activity fingerprint (hub signature first when a hub
+    exists), ``waiting`` the exact declared waiting inputs. None = unknown (caller treats as moved)."""
+    from hermes_cli import kanban_annotation_host as host
+    from hermes_cli import kanban_session_activity as ksa
+
+    if len(scope) < 2:
+        return None
+    state = _state(scope)
+    if not state.lock.acquire(blocking=False):
+        return None
+    try:
+        local = list(full[1:]) if ksa._hub_db_path() is not None else list(full)
+        body = [_VERSION, list(scope), host.core_sha(), host._portable(local), waiting,
+                [[name, host._code_id(fn)] for name, fn in sorted(ksa._done_checks.items())],
+                _origin_part(state, scope[1])]
+        stats["keys"] += 1
+        return hashlib.sha256(json.dumps(body, separators=(",", ":"), sort_keys=True,
+                                         allow_nan=False).encode()).hexdigest()
+    except Exception:  # health: allow BLE001 -- an unknown input is no key; the holder falls back to exact
+        stats["errors"] += 1
+        state.clear()
+        log.debug("kanban annotation narrow key unavailable", exc_info=True)
+        return None
+    finally:
+        state.lock.release()
diff --git a/hermes_cli/kanban_annotation_reader.py b/hermes_cli/kanban_annotation_reader.py
new file mode 100644
index 0000000000..6d39c38252
--- /dev/null
+++ b/hermes_cli/kanban_annotation_reader.py
@@ -0,0 +1,124 @@
+"""Caller-owned raw replica reader for annotation semantic keys. [daveey]
+
+Never reads or populates the strict projector's process-global Rows cache. The
+caller owns the connection lifecycle and must hold one read transaction; it must
+also fence the connection against pathname replacement before borrowing it (the
+normal cached_ro lifecycle does this). Errors are unkeyable, not empty snapshots.
+"""
+from __future__ import annotations
+
+import math
+import os
+import sqlite3
+from dataclasses import dataclass
+
+from hermes_cli import kanban_replica_rows as rr
+
+_PROBE = ("SELECT count(*), count(seq), max(seq), total(seq), total(version), "
+          "total(octet_length(data)) FROM replica WHERE coll='tasks'")
+_SEQ_PROBE = "SELECT count(*), count(seq), max(seq), total(seq) FROM replica WHERE coll='tasks'"
+
+
+@dataclass(frozen=True)
+class ReplicaSnapshot:
+    rows: rr.Rows
+    gateway: str
+    info_rows: tuple
+    last_ok: float | None
+    offline_since: float | None
+
+
+def _file_fence(path) -> tuple:
+    """File identity (main inode + WAL-index inode). Size/mtime are deliberately NOT part of it: every WAL
+    checkpoint moves them, and a 19k-row full re-read costs seconds of CPU (measured on worker-6). Content
+    changes under one identity are proven by the seq/probe totals, the strict reader's own protocol."""
+    st = os.stat(path)
+    try:
+        shm = os.stat(str(path) + '-shm')
+        sidecar = shm.st_dev, shm.st_ino
+    except FileNotFoundError:
+        sidecar = None
+    return st.st_dev, st.st_ino, sidecar
+
+
+def _clock(conn: sqlite3.Connection, key: str) -> float | None:
+    row = conn.execute('SELECT v FROM meta WHERE k=?', (key,)).fetchone()
+    if not row or row[0] in (None, ''):
+        return None
+    value = float(row[0])
+    if not math.isfinite(value):
+        raise ValueError('nonfinite replica clock')
+    return value
+
+
+class ReplicaReader:
+    """One serialized caller's last raw view; no retained transaction or owned FD.
+
+    Same-connection data_version and total_changes are raw fences, not semantic
+    inputs. Any other commit advances the view by the seq delta protocol the
+    strict reader (``rr.read``) trusts; probe totals that do not add up force a
+    full read. A seq-preserving, total-preserving in-place rewrite is invisible
+    here exactly as it is to the strict reader; this key is display-only and the
+    holder's 20 s forced renewal bounds any such miss. A new main-file or WAL
+    index inode, schema change or connection always reads in full.
+    """
+
+    def __init__(self):
+        self._conn = None
+        self._fence = None
+        self._version = None
+        self._probe = None
+        self._seq_probe = None
+        self._rows = None
+
+    def clear(self) -> None:
+        self.__init__()
+
+    def read(self, conn: sqlite3.Connection, path) -> ReplicaSnapshot:
+        if not conn.in_transaction:
+            raise ValueError('replica read requires transaction')
+        try:
+            return self._read(conn, path)
+        except (sqlite3.Error, OSError, ValueError, TypeError, OverflowError):
+            self.clear()
+            raise
+
+    def _read(self, conn: sqlite3.Connection, path) -> ReplicaSnapshot:
+        fence = _file_fence(path)
+        schema = conn.execute('PRAGMA schema_version').fetchone()[0]
+        version = (conn.execute('PRAGMA data_version').fetchone()[0], conn.total_changes)
+        columns = {r[1] for r in conn.execute('PRAGMA table_info(replica)')}
+        if not {'seq', 'version'} <= columns:
+            raise ValueError('unproven replica sequence schema')
+        identity = str(path), fence, schema
+        base = self._rows if self._conn is conn and self._fence == identity else None
+        # hermes_hub stamps every replica task write with the server log's seq (upsert/insert) and deletes rows
+        # outright, so (count, max seq, seq total) - a ~1.5 ms covering scan of replica_poll_metadata - moves on
+        # every task change. Unmoved: the ~30 ms full probe (a 19k-row data scan on worker-6) is skipped.
+        seq_probe = tuple(conn.execute(_SEQ_PROBE).fetchone())
+        unchanged = base is not None and (version == self._version or seq_probe == self._seq_probe)
+        probe = self._probe if unchanged else tuple(conn.execute(_PROBE).fetchone())
+        if probe[0] != probe[1]:
+            raise ValueError('unproven replica sequence')
+        from hermes_cli.kanban_session_activity import _self_gateway
+        gateway = _self_gateway(conn)
+        if not gateway:
+            raise ValueError('unknown replica gateway')
+        infos = tuple(conn.execute("SELECT gw,data FROM replica WHERE coll='gateway' AND key='info' ORDER BY gw"))
+        last_ok, offline = _clock(conn, 'last_ok'), _clock(conn, 'offline_since')
+        rows = None
+        if base is not None:
+            if unchanged:
+                rows = base
+            else:
+                # Same protocol the strict reader trusts (``rr.read``): every replica write stamps a new seq, so
+                # a commit elsewhere (sessions, gateway rows) is a zero-row delta, not a full re-read. A rewrite
+                # the seq cannot see fails the probe totals and falls through to the full read below.
+                rows = rr._delta(conn, base, probe)
+        if rows is None:
+            rows = rr._full(conn, str(path), fence[:2], 'version', probe)
+        if _file_fence(path) != fence:
+            raise ValueError('replica file changed during snapshot')
+        self._conn, self._fence, self._version = conn, identity, version
+        self._probe, self._seq_probe, self._rows = probe, seq_probe, rows
+        return ReplicaSnapshot(rows, gateway, infos, last_ok, offline)
