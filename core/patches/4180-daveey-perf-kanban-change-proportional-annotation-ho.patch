@@ -0,0 +1,131 @@
+"""Only committed foreground writes expedite annotation; savepoints retain custody."""
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_annotation_host as host
+from hermes_cli import kanban_annotation_mutation as mutation
+from hermes_cli import kanban_db_connect as db
+
+
+@pytest.fixture
+def world(monkeypatch):
+    conn = sqlite3.connect(':memory:', isolation_level=None)
+    conn.executescript('''
+        CREATE TABLE tasks(id TEXT PRIMARY KEY, status TEXT, title TEXT);
+        CREATE TABLE task_links(parent_id TEXT, child_id TEXT);
+        CREATE TABLE task_chat_links(task_id TEXT, session_id TEXT);
+        INSERT INTO tasks VALUES('t1', 'running', 'one');
+    ''')
+    monkeypatch.setattr(db._kb, '_assert_not_delegated_child_mutation', lambda *a: None)
+    monkeypatch.setattr(db, '_check_file_length_invariant', lambda *a: None)
+    monkeypatch.setattr(db._local_status_wake, 'flush', lambda *a: None)
+    monkeypatch.setattr(host, 'enabled', lambda: True)
+    calls = []
+    monkeypatch.setattr(host, 'kick', calls.append)
+    yield conn, calls
+    conn.close()
+
+
+def test_own_commit_cues_after_commit_only(world):
+    conn, calls = world
+    with mutation.foreground(('home', 'profile')):
+        with db.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='done'")
+            assert calls == []
+    assert calls == [('home', 'profile')]
+    assert not conn.in_transaction
+
+
+def test_background_and_noop_never_cue(world):
+    conn, calls = world
+    with mutation.foreground(('home', 'profile')):
+        with db.write_txn(conn):
+            conn.execute("UPDATE tasks SET status=status")
+    with db.write_txn(conn):
+        conn.execute("UPDATE tasks SET status='done'")
+    with mutation.foreground(('home', 'profile')):
+        with db.write_txn(conn):
+            pass
+    assert calls == []
+
+
+@pytest.mark.parametrize('nested', [False, True])
+def test_rollback_does_not_cue(world, nested):
+    conn, calls = world
+    with mutation.foreground(('home', 'profile')):
+        if nested:
+            with db.write_txn(conn):
+                with pytest.raises(ValueError), db.write_txn(conn, allow_nested=True):
+                    conn.execute("INSERT INTO task_links VALUES('t1', 't2')")
+                    raise ValueError('rollback savepoint')
+        else:
+            with pytest.raises(ValueError), db.write_txn(conn):
+                conn.execute("UPDATE tasks SET status='done'")
+                raise ValueError('rollback transaction')
+    assert calls == []
+
+
+def test_nested_link_flushes_at_outer_commit_before_other_wakes(world, monkeypatch):
+    conn, calls = world
+    def other_wake(c):
+        assert calls == [('home', 'profile')]
+    monkeypatch.setattr(db._local_status_wake, 'flush', other_wake)
+    with mutation.foreground(('home', 'profile')):
+        with db.write_txn(conn):
+            with db.write_txn(conn, allow_nested=True):
+                conn.execute("INSERT INTO task_chat_links VALUES('t1', 's1')")
+            assert calls == []
+    assert calls == [('home', 'profile')]
+
+
+def test_profile_context_restored(world):
+    conn, calls = world
+    with mutation.foreground(('home', 'outer')):
+        with mutation.foreground(('home', 'inner')):
+            with db.write_txn(conn):
+                conn.execute("UPDATE tasks SET status='done'")
+        with db.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='running'")
+    with db.write_txn(conn):
+        conn.execute("UPDATE tasks SET status='done'")
+    assert calls == [('home', 'inner'), ('home', 'outer')]
+
+
+def test_commit_failure_preserves_no_cue(world, monkeypatch):
+    conn, calls = world
+    boundary = db._execute_boundary_with_retry
+    def fail_commit(c, sql):
+        if sql == 'COMMIT':
+            raise sqlite3.OperationalError('commit failed')
+        return boundary(c, sql)
+    monkeypatch.setattr(db, '_execute_boundary_with_retry', fail_commit)
+    with mutation.foreground(('home', 'profile')):
+        with pytest.raises(sqlite3.OperationalError), db.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='done'")
+    assert calls == []
+    assert conn.execute('SELECT status FROM tasks').fetchone()[0] == 'running'
+    assert not conn.in_transaction
+
+
+def test_kill_switch_disables_recorder(world, monkeypatch):
+    conn, calls = world
+    monkeypatch.setattr(host, 'enabled', lambda: False)
+    with mutation.foreground(('home', 'profile')):
+        with db.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='done'")
+    assert calls == []
+
+
+@pytest.mark.parametrize('sql', [
+    "INSERT INTO tasks VALUES('t2', 'running', 'two')",
+    "DELETE FROM tasks WHERE id='t1'",
+    "INSERT INTO task_links VALUES('t1', 't2')",
+    "INSERT INTO task_chat_links VALUES('t1', 's1')",
+])
+def test_membership_changes_cue(world, sql):
+    conn, calls = world
+    with mutation.foreground(('home', 'profile')):
+        with db.write_txn(conn):
+            conn.execute(sql)
+    assert calls == [('home', 'profile')]
diff --git a/tests/hermes_cli/test_kanban_annotation_reader.py b/tests/hermes_cli/test_kanban_annotation_reader.py
new file mode 100644
index 0000000000..7fb5b75176
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_annotation_reader.py
@@ -0,0 +1,250 @@
+"""Fenced raw snapshots for the annotation-only semantic gate."""
+import json
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_replica_rows as rr
+
+
+def store(path):
+    conn = sqlite3.connect(path)
+    conn.execute('PRAGMA journal_mode=WAL')
+    conn.executescript('''CREATE TABLE replica(gw TEXT, coll TEXT, key TEXT, data TEXT,
+        updated_at REAL, version INTEGER, seq INTEGER);
+        CREATE TABLE meta(k TEXT PRIMARY KEY, v TEXT);
+        INSERT INTO meta VALUES('gateway', 'origin');
+        INSERT INTO meta VALUES('last_ok', '100');''')
+    conn.execute("INSERT INTO replica VALUES('owner','tasks','default/main/t',?,100,1,1)",
+                 (json.dumps({'status': 'todo'}),))
+    conn.commit()
+    return conn
+
+
+def take(reader, conn, path):
+    conn.execute('BEGIN')
+    try:
+        return reader.read(conn, path)
+    finally:
+        conn.rollback()
+
+
+def factory():
+    from hermes_cli.kanban_annotation_reader import ReplicaReader
+    return ReplicaReader()
+
+
+def test_requires_snapshot(tmp_path):
+    path = tmp_path / 'hub.db'
+    with store(path) as conn:
+        with pytest.raises(ValueError, match='transaction'):
+            factory().read(conn, path)
+
+
+def test_unchanged_rows_reused_but_gateway_read_each_time(tmp_path):
+    path = tmp_path / 'hub.db'
+    writer = store(path)
+    conn = sqlite3.connect(path)
+    reader = factory()
+    try:
+        first = take(reader, conn, path)
+        second = take(reader, conn, path)
+        assert second.rows is first.rows
+        assert second.gateway == 'origin'
+        writer.execute("INSERT INTO replica VALUES('owner','gateway','info','{}',100,1,2)")
+        writer.commit()
+        third = take(reader, conn, path)
+        assert third.info_rows == (('owner', '{}'),)
+        assert third.last_ok == 100
+    finally:
+        conn.close()
+        writer.close()
+
+
+def test_unrelated_commit_is_zero_row_delta(tmp_path):
+    path = tmp_path / 'hub.db'
+    writer = store(path)
+    conn = sqlite3.connect(path)
+    reader = factory()
+    try:
+        first = take(reader, conn, path)
+        writer.execute("INSERT INTO replica VALUES('owner','sessions','s','{}',100,1,5)")
+        writer.commit()
+        second = take(reader, conn, path)
+        assert second.rows is first.rows  # task seq probe unmoved: no probe scan, no delta, no full re-read
+    finally:
+        conn.close()
+        writer.close()
+
+
+def test_seq_less_rewrite_is_outside_writer_protocol(tmp_path):
+    """hermes_hub stamps every task write with a new seq; a raw seq-less rewrite (no such writer exists) is not
+    seen by the narrow reader. Display-only: the holder's 20 s renewal and the exact strict paths bound it."""
+    path = tmp_path / 'hub.db'
+    writer = store(path)
+    conn = sqlite3.connect(path)
+    reader = factory()
+    try:
+        first = take(reader, conn, path)
+        writer.execute("UPDATE replica SET data=replace(data,'todo','finished')")  # seq kept
+        writer.commit()
+        assert take(reader, conn, path).rows is first.rows
+        writer.execute("UPDATE replica SET seq=7, data=replace(data,'finished','done')")  # the writer's protocol
+        writer.commit()
+        assert json.loads(take(reader, conn, path).rows.rows()[0][2])['status'] == 'done'
+    finally:
+        conn.close()
+        writer.close()
+
+
+def test_new_connection_never_compares_data_versions(tmp_path):
+    path = tmp_path / 'hub.db'
+    writer = store(path)
+    reader = factory()
+    conn = sqlite3.connect(path)
+    first = take(reader, conn, path)
+    conn.close()
+    writer.execute("UPDATE replica SET data=replace(data,'todo','done')")
+    writer.commit()
+    conn = sqlite3.connect(path)
+    try:
+        second = take(reader, conn, path)
+        assert second.rows is not first.rows
+        assert 'done' in second.rows.rows()[0][2]
+    finally:
+        conn.close()
+        writer.close()
+
+
+def test_null_sequence_fails_closed_and_recovers(tmp_path):
+    path = tmp_path / 'hub.db'
+    writer = store(path)
+    conn = sqlite3.connect(path)
+    reader = factory()
+    try:
+        take(reader, conn, path)
+        writer.execute('UPDATE replica SET seq=NULL')
+        writer.commit()
+        with pytest.raises(ValueError, match='sequence'):
+            take(reader, conn, path)
+        writer.execute("UPDATE replica SET seq=1, data=replace(data,'todo','done')")
+        writer.commit()
+        assert 'done' in take(reader, conn, path).rows.rows()[0][2]
+    finally:
+        conn.close()
+        writer.close()
+
+
+def test_sequence_delta_and_deletion(tmp_path):
+    path = tmp_path / 'hub.db'
+    writer = store(path)
+    conn = sqlite3.connect(path)
+    reader = factory()
+    try:
+        first = take(reader, conn, path)
+        writer.execute("UPDATE replica SET seq=2, version=2, data=replace(data,'todo','done')")
+        writer.commit()
+        second = take(reader, conn, path)
+        assert second.rows.base_gen == first.rows.gen
+        assert second.rows.changed == frozenset({('owner', 'default/main/t')})
+        assert 'done' in second.rows.rows()[0][2]
+        writer.execute('DELETE FROM replica')
+        writer.commit()
+        third = take(reader, conn, path)
+        assert third.rows.rows() == []
+        assert third.rows.removed == frozenset({('owner', 'default/main/t')})
+    finally:
+        conn.close()
+        writer.close()
+
+
+def test_error_clears_successful_view(tmp_path):
+    path = tmp_path / 'hub.db'
+    writer = store(path)
+    reader = factory()
+    try:
+        take(reader, writer, path)
+        writer.execute("UPDATE meta SET v='nan' WHERE k='last_ok'")
+        writer.commit()
+        with pytest.raises(ValueError, match='nonfinite'):
+            take(reader, writer, path)
+        assert reader._rows is None
+        writer.execute("UPDATE meta SET v='101' WHERE k='last_ok'")
+        writer.commit()
+        assert take(reader, writer, path).last_ok == 101
+    finally:
+        writer.close()
+
+
+def test_same_inode_restore_with_different_totals_reads_in_full(tmp_path):
+    path = tmp_path / 'hub.db'
+    writer = store(path)
+    reader = factory()
+    conn = sqlite3.connect(path)
+    backup = sqlite3.connect(tmp_path / 'backup.db')
+    try:
+        writer.backup(backup)
+        backup.execute("UPDATE replica SET data=replace(data,'todo','restored')")
+        backup.commit()
+        first = take(reader, conn, path)
+        inode = path.stat().st_ino
+        backup.backup(writer)
+        writer.execute('PRAGMA wal_checkpoint(TRUNCATE)')
+        assert path.stat().st_ino == inode
+        second = take(reader, conn, path)
+        assert second.rows.gen != first.rows.gen
+        assert 'restored' in second.rows.rows()[0][2]
+    finally:
+        backup.close()
+        conn.close()
+        writer.close()
+
+
+def test_checkpoint_does_not_force_full_read(tmp_path):
+    path = tmp_path / 'hub.db'
+    writer = store(path)
+    conn = sqlite3.connect(path)
+    reader = factory()
+    try:
+        first = take(reader, conn, path)
+        writer.execute("UPDATE replica SET seq=2, version=2, data=replace(data,'todo','done')")
+        writer.commit()
+        writer.execute('PRAGMA wal_checkpoint(TRUNCATE)')
+        second = take(reader, conn, path)
+        assert second.rows.base_gen == first.rows.gen
+        assert 'done' in second.rows.rows()[0][2]
+    finally:
+        conn.close()
+        writer.close()
+
+
+def test_file_changes_during_read_not_published(tmp_path, monkeypatch):
+    from hermes_cli import kanban_annotation_reader as ar
+    path = tmp_path / 'hub.db'
+    conn = store(path)
+    reader = factory()
+    real = ar._file_fence
+    calls = []
+
+    def fence(p):
+        calls.append(p)
+        result = real(p)
+        return result if len(calls) == 1 else (*result, 'moved')
+
+    monkeypatch.setattr(ar, '_file_fence', fence)
+    try:
+        with pytest.raises(ValueError, match='file changed'):
+            take(reader, conn, path)
+        assert reader._rows is None
+    finally:
+        conn.close()
+
+
+def test_never_uses_strict_global_rows_cache(tmp_path, monkeypatch):
+    path = tmp_path / 'hub.db'
+    conn = store(path)
+    monkeypatch.setattr(rr, 'read', lambda *a: pytest.fail('shared strict cache'))
+    try:
+        assert take(factory(), conn, path).rows.rows()
+    finally:
+        conn.close()
