From 82d31e6c5d070ea211f592ac3b132a295a66793f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 17:53:04 +0000
Subject: [PATCH] [daveey] worker policy root: an odd TMPDIR never admits a
 durable HERMES_TEST_POLICY_ROOT

PR #2454 review nits (review 5895543145, card t_01a1d602f93945f1).

Nit 2 (missing guard): _test_policy_override honoured any path under
tempfile.gettempdir(). With TMPDIR=/home/ubuntu it honoured /home/ubuntu/x/.hermes,
a durable path; an honoured empty root turns worker_enabled() off, so refusal()
fails open. TMPDIR now joins /tmp, /var/tmp and /dev/shm only when it is
ephemeral: not an ancestor of the passwd account or HOME, and inside the account
only under .hermes/cache/scratch (the worker default, which the state runner's
fallback shard dirs use).

Nit 1: refusal()-level test that a non-unknown answer clears
<policy root>/worker-resources/unknown.json and that an unknown answer with no
exception records the streak (the 'pass' mutant of the plain observe now fails).

Nit 3: worker_enabled() docstring names the HERMES_TEST_POLICY_ROOT override.

RED (base + refactor-only SYSTEM_TEMP_ROOTS constant, observe->pass mutant): 5 failed
(4 odd-TMPDIR durable cases, the refusal observe test). GREEN: 54/54 in the three
files; 21 importer files incl. worker_node/pickup_stall 366/366.
---
 hermes_cli/worker_compute_capacity.py         | 39 ++++++++++++++++---
 .../test_worker_compute_capacity.py           | 28 +++++++++++++
 .../test_worker_resources_unknown_alarm.py    | 15 +++++++
 3 files changed, 77 insertions(+), 5 deletions(-)

diff --git a/hermes_cli/worker_compute_capacity.py b/hermes_cli/worker_compute_capacity.py
index 1a8be772fd..460d666595 100644
--- a/hermes_cli/worker_compute_capacity.py
+++ b/hermes_cli/worker_compute_capacity.py
@@ -155,21 +155,50 @@ def _test_policy_override(environ=None) -> Path | None:
     policy anywhere durable, so it cannot disable host CPU policy by accident.
     """
     import os
-    import tempfile
     raw = (os.environ if environ is None else environ).get('HERMES_TEST_POLICY_ROOT', '')
     if not raw or not os.path.isabs(raw):
         return None
     path = Path(os.path.realpath(raw))
-    # no-tmp: ok — recognises a harness's temp root; nothing is written here
-    for root in ('/tmp', '/var/tmp', '/dev/shm', tempfile.gettempdir()):
-        real = Path(os.path.realpath(root))
+    for real in _override_temp_roots():
         if path != real and path.is_relative_to(real):
             return path
     return None
 
 
+# no-tmp: ok — recognises a harness's temp root; nothing is written here
+SYSTEM_TEMP_ROOTS: tuple[str, ...] = ('/tmp', '/var/tmp', '/dev/shm')
+
+
+def _override_temp_roots() -> list[Path]:
+    """Roots a policy override may live under: the system temp roots, plus TMPDIR only when it is ephemeral.
+
+    An honoured empty root turns :func:`worker_enabled` off, so ``refusal()`` lets every claim through. An odd
+    TMPDIR (``/``, a home, the account root, a durable dir inside the account) must not let the override move a
+    worker's policy somewhere durable; inside the account only the pruned ``.hermes/cache/scratch`` qualifies.
+    Same intent as ``worker_account_boards._ephemeral_roots``, judged against the passwd account, never the
+    override itself.
+    """
+    import os
+    import tempfile
+    from hermes_constants import _account_home
+    roots = [Path(os.path.realpath(root)) for root in SYSTEM_TEMP_ROOTS]
+    account = Path(os.path.realpath(_account_home()))
+    home = Path(os.path.realpath(os.path.expanduser('~')))
+    scratch = account / '.hermes' / 'cache' / 'scratch'
+    tmp = Path(os.path.realpath(tempfile.gettempdir()))
+    durable = (account.is_relative_to(tmp) or home.is_relative_to(tmp)
+               or (tmp.is_relative_to(account) and not tmp.is_relative_to(scratch)))
+    if not durable:
+        roots.append(tmp)
+    return roots
+
+
 def worker_enabled() -> bool:
-    """Read installation policy, never a card's environment or profile override."""
+    """Read installation policy, never a card's environment or profile override.
+
+    The only environment that moves it is a test harness's ``HERMES_TEST_POLICY_ROOT`` under a temp root
+    (:func:`_test_policy_override`).
+    """
     from hermes_cli.config_backend import read_config_doc_readonly
 
     try:
diff --git a/tests/hermes_cli/test_worker_compute_capacity.py b/tests/hermes_cli/test_worker_compute_capacity.py
index a9557b487d..8db1afc050 100644
--- a/tests/hermes_cli/test_worker_compute_capacity.py
+++ b/tests/hermes_cli/test_worker_compute_capacity.py
@@ -68,6 +68,34 @@ def test_test_policy_root_is_honoured_only_under_a_temp_root(raw, honoured):
     assert got == (Path(os.path.realpath(raw)) if honoured else None)
 
 
+@pytest.mark.parametrize('tmpdir, raw, honoured', [
+    ('{home}', '{home}/x/.hermes', False),  # TMPDIR=HOME: a durable home dir is no temp root
+    ('{account}', '{account}/x/.hermes', False),  # the account itself
+    ('/', '/srv/policy/.hermes', False),  # TMPDIR=/ would admit anything
+    ('{account}/.hermes', '{account}/.hermes/x/.hermes', False),  # durable dirs inside the account
+    ('{account}/.hermes/cache/scratch', '{account}/.hermes/cache/scratch/t1/.hermes', True),  # the worker default
+    ('{other}', '{other}/shard-1/account-policy/.hermes', True),  # an ordinary harness TMPDIR
+])
+def test_an_odd_tmpdir_never_admits_a_durable_policy_root(tmp_path, monkeypatch, tmpdir, raw, honoured):
+    """PR #2454 review nit 2 (t_01a1d602f93945f1): TMPDIR=/home/ubuntu honoured /home/ubuntu/x/.hermes. An honoured
+    empty root turns worker_enabled() off, so refusal() fails open; TMPDIR joins the roots only when ephemeral."""
+    import os
+    import tempfile
+    from pathlib import Path
+    from hermes_cli import worker_compute_capacity as capacity
+    account, home, other = tmp_path / 'account', tmp_path / 'home', tmp_path / 'harness-tmp'
+    for path in (account / '.hermes' / 'cache' / 'scratch', home, other):
+        path.mkdir(parents=True)
+    names = {'account': str(account), 'home': str(home), 'other': str(other)}
+    monkeypatch.setattr('hermes_constants._account_home', lambda: account)
+    monkeypatch.setattr(capacity, 'SYSTEM_TEMP_ROOTS', ())  # tmp_path itself sits under /tmp
+    monkeypatch.setenv('HOME', str(home))
+    monkeypatch.setattr(tempfile, 'tempdir', tmpdir.format(**names))
+    raw = raw.format(**names)
+    got = capacity._test_policy_override({'HERMES_TEST_POLICY_ROOT': raw})
+    assert got == (Path(os.path.realpath(raw)) if honoured else None)
+
+
 def test_policy_root_follows_the_override_in_a_child(tmp_path):
     """The unpatched policy_root (a fresh interpreter, no conftest) answers the shard dir, not the account."""
     import os
diff --git a/tests/hermes_cli/test_worker_resources_unknown_alarm.py b/tests/hermes_cli/test_worker_resources_unknown_alarm.py
index 82343ca9e0..bdacdca206 100644
--- a/tests/hermes_cli/test_worker_resources_unknown_alarm.py
+++ b/tests/hermes_cli/test_worker_resources_unknown_alarm.py
@@ -66,6 +66,21 @@ def test_any_other_answer_ends_the_streak_and_a_gap_starts_a_new_one(tmp_path):
     assert alarm.read()["since"] == 2000.0 + alarm.GAP_SECONDS + 1
 
 
+def test_refusal_answers_feed_the_streak_without_an_exception(monkeypatch):
+    """PR #2454 review nit 1 (t_01a1d602f93945f1): refusal()'s plain-answer observe was untested (a `pass` mutant
+    survived). A non-unknown answer clears unknown.json; an unknown one with no exception (cap unreadable) records it."""
+    alarm.observe(True, now=time.time())
+    assert alarm.read() is not None
+    monkeypatch.setattr(admission, "_refusal", lambda echo, *, claimant: "worker_load_pressure")
+    assert admission.refusal(enabled=True) == "worker_load_pressure"
+    assert not (capacity.policy_root() / "worker-resources" / "unknown.json").exists()
+    monkeypatch.setattr(admission, "_refusal", lambda echo, *, claimant: "worker_resources_unknown")
+    assert admission.refusal(enabled=True) == "worker_resources_unknown"
+    state = alarm.read()
+    assert state is not None
+    assert state["detail"] == "occupancy or max_in_progress unreadable" and state["record"] is None
+
+
 def _streak(seconds, *, record="/acct/.hermes/worker-resources/boards/abc.json"):
     now = time.time()
     path = capacity.policy_root() / "worker-resources" / "unknown.json"
