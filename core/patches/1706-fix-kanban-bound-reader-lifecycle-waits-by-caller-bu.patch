diff --git a/hermes_cli/kanban_dispatch_owner.py b/hermes_cli/kanban_dispatch_owner.py
index be31c708224..c7d0ae9c392 100644
--- a/hermes_cli/kanban_dispatch_owner.py
+++ b/hermes_cli/kanban_dispatch_owner.py
@@ -16,7 +16,7 @@ def connect_with_identity(path, **kwargs):
     dispatch: reopen after contention clears instead of trusting a pathname.
     """
     from hermes_cli.kanban_db_connect import _dispatch_tick_lock
-    from hermes_cli.kanban_generation import lifecycle_lock, recover, remember
+    from hermes_cli.kanban_generation import lifecycle_access, recover, remember
     from hermes_cli.sqlite_safe_read import connect_tracked, _tracking_factory
 
     canonical = Path(path).resolve()
@@ -25,8 +25,7 @@ def connect_with_identity(path, **kwargs):
     # global lock; the first journal read may wait on an unrelated board writer.
     kwargs["factory"] = _kanban_lockguard.lifecycle_factory(_kanban_lockguard.guarded_factory(
         _tracking_factory(kwargs.get("factory", sqlite3.Connection))))
-    lock = lifecycle_lock(canonical)
-    with lock, _dispatch_tick_lock(canonical) as held:
+    with lifecycle_access(canonical, kwargs.get("timeout", 5.0)) as lock, _dispatch_tick_lock(canonical) as held:
         recover(str(canonical))
         conn = connect_tracked(str(canonical), **kwargs)
         conn._hermes_lifecycle_lock = lock
diff --git a/hermes_cli/kanban_generation.py b/hermes_cli/kanban_generation.py
index 3e9cba5140b..ac8566e357f 100644
--- a/hermes_cli/kanban_generation.py
+++ b/hermes_cli/kanban_generation.py
@@ -38,6 +38,18 @@ def lifecycle_lock(database):
         return lock
 
 
+@contextmanager
+def lifecycle_access(database, timeout):
+    """A reader keeps its own busy budget even behind a long-timeout opener."""
+    lock = lifecycle_lock(database)
+    if not lock.acquire(timeout=max(0.0, float(timeout))):
+        raise sqlite3.OperationalError("database is locked: board lifecycle is busy")
+    try:
+        yield lock
+    finally:
+        lock.release()
+
+
 class DeletedWalGenerationError(sqlite3.OperationalError):
     """Retry after the remaining active handles leave the dead WAL generation."""
 
diff --git a/hermes_cli/kanban_lockguard.py b/hermes_cli/kanban_lockguard.py
index ea0056c5f1f..28f811fc233 100644
--- a/hermes_cli/kanban_lockguard.py
+++ b/hermes_cli/kanban_lockguard.py
@@ -55,23 +55,24 @@ def _release(conn: Any) -> None:
         fin()  # runs hermes_state_lockguard.release(held) exactly once
 
 
-class _LifecycleMixin:
-    def close(self) -> None:
-        # Must wrap BOTH tracking and guard close, even with an already-guarded
-        # custom factory: no board-lock wait while holding the tracking lock.
-        with getattr(self, "_hermes_lifecycle_lock", nullcontext()):
-            super().close()
-
-
 _lifecycle_factory_cache: dict[type, type] = {}
 
 
 def lifecycle_factory(factory: type) -> type:
-    if issubclass(factory, _LifecycleMixin):
+    # Inherited lifecycle support is not enough: a tracking wrapper may now
+    # precede it. Always put this method outside any newly composed wrappers.
+    if factory.__dict__.get("_hermes_outer_lifecycle", False):
         return factory
     cached = _lifecycle_factory_cache.get(factory)
     if cached is None:
-        cached = type(f"Lifecycle{factory.__name__}", (_LifecycleMixin, factory), {})
+        class LifecycleConnection(factory):
+            _hermes_outer_lifecycle = True
+
+            def close(self) -> None:
+                with getattr(self, "_hermes_lifecycle_lock", nullcontext()):
+                    super().close()
+
+        cached = LifecycleConnection
         _lifecycle_factory_cache[factory] = cached
     return cached
 
@@ -171,9 +172,9 @@ def guard(conn: sqlite3.Connection) -> bool:
 
 def connect(database: Any, *args: Any, **kwargs: Any) -> sqlite3.Connection:
     """Drop-in ``sqlite3.connect`` for Kanban board files: same arguments, guarded result."""
-    from hermes_cli.kanban_generation import lifecycle_lock, recover, remember
-    lock = lifecycle_lock(database)
-    with lock:
+    from hermes_cli.kanban_generation import lifecycle_access, recover, remember
+    timeout = args[0] if args else kwargs.get("timeout", 5.0)
+    with lifecycle_access(database, timeout) as lock:
         recover(database)
         kwargs["factory"] = lifecycle_factory(guarded_factory(kwargs.get("factory", sqlite3.Connection)))
         conn = sqlite3.connect(database, *args, **kwargs)
