Subject: [PATCH] [daveey] test(gateway): retain exec command success controls

---
 tests/gateway/test_exec_quick_command_tree.py | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/tests/gateway/test_exec_quick_command_tree.py b/tests/gateway/test_exec_quick_command_tree.py
index f0f417fb79..866cdd527f 100644
--- a/tests/gateway/test_exec_quick_command_tree.py
+++ b/tests/gateway/test_exec_quick_command_tree.py
@@ -29,6 +29,14 @@ def _pid(path: Path):
     return int(text) if text else None
 
 
+@pytest.mark.platforms("posix")
+@pytest.mark.asyncio
+@pytest.mark.parametrize(('command', 'output'), [('printf hello', 'hello'), ('printf error >&2', 'error'), ('true', None)])
+async def test_exec_command_success(command, output):
+    reply = await GatewayInboundHooksMixin()._hm_run_exec_quick_command('probe', command)
+    assert reply == (output or run_inbound_hooks.t('gateway.quick_command.no_output'))
+
+
 @pytest.mark.platforms("posix")
 @pytest.mark.asyncio
 async def test_timed_out_exec_command_kills_its_background_child(tmp_path, monkeypatch):
