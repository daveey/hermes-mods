 4 files changed, 30 insertions(+), 18 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_host_cap.py b/tests/hermes_cli/test_kanban_host_cap.py
index 7b493d0df3182c1321bb09bf0b301894f5e2c2aa..62c59ffc5098eb0e0051f2c04cbf43bb8f098680 100644
--- a/tests/hermes_cli/test_kanban_host_cap.py
+++ b/tests/hermes_cli/test_kanban_host_cap.py
@@ -271,10 +271,10 @@ def test_unspawnable_review_does_not_reserve_the_only_ready_slot(
     assert [task_id for task_id, *_ in res.spawned] == [ready_id]
 
 
-def test_unguarded_review_reserves_the_only_ready_slot(
+def test_urgent_review_wins_the_only_shared_slot(
     kanban_home, all_assignees_spawnable, monkeypatch,
 ):
-    """A dispatchable review card still receives the single shared slot."""
+    """A dispatchable urgent review wins by score, not an unconditional reservation."""
     import hermes_cli.config as cfgmod
 
     monkeypatch.setattr(
@@ -286,6 +286,8 @@ def test_unguarded_review_reserves_the_only_ready_slot(
     with kbc.connect() as conn:
         kb.create_task(conn, title="ready-now", assignee="alice")
         review_id = _park_in_review(conn, "review-now", "reviewer")
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET priority=900 WHERE id=?", (review_id,))
         res = kbd.dispatch_once(
             conn, spawn_fn=_fake_spawn_factory(spawns), max_in_progress=1,
         )
diff --git a/tests/hermes_cli/test_kanban_label_backlog_wait.py b/tests/hermes_cli/test_kanban_label_backlog_wait.py
index fea00c609fea683780acb42c56d1fd2f1fb9327c..92ad76ce8f2a3bc2dab27456b9418877c4112f95 100644
--- a/tests/hermes_cli/test_kanban_label_backlog_wait.py
+++ b/tests/hermes_cli/test_kanban_label_backlog_wait.py
@@ -192,7 +192,8 @@ def test_unavailable_matching_workers_do_not_override_current_holds(hub, state):
     assert "Not a placement problem" not in text
 
 
-def test_claim_duplicates_count_once_and_priority_donation_orders_queue(hub):
+@pytest.mark.parametrize("priority,ahead", [(100, 2), (1000, 3)])
+def test_claim_duplicates_count_once_and_priority_donation_orders_queue(hub, priority, ahead):
     from hermes_cli import kanban_label_backlog as klb
     tid = _seed(hub.conn, claims=1)
     claimed = hub.conn.execute("SELECT id FROM tasks WHERE title='claimed 0'").fetchone()[0]
@@ -200,10 +201,11 @@ def test_claim_duplicates_count_once_and_priority_donation_orders_queue(hub):
     waiter = _card(hub.conn, "urgent waiter", int(time.time()))
     with kb.write_txn(hub.conn):
         kb._append_event(hub.conn, claimed, "claimed", {"holder": "worker-3"})
-        hub.conn.execute("UPDATE tasks SET priority=100, status='todo' WHERE id=?", (waiter,))
+        hub.conn.execute("UPDATE tasks SET priority=?, status='todo' WHERE id=?", (priority, waiter))
         hub.conn.execute("INSERT INTO task_links(parent_id, child_id) VALUES (?, ?)", (later, waiter))
     backlog = klb.read(hub.conn, tid, LABELS, machines={"worker-3"})
-    assert backlog["ahead"] == 3 and backlog["claimed_recent"] == 1
+    # Thirty-one minutes of age beats donated 100, but not donated 1000.
+    assert backlog["ahead"] == ahead and backlog["claimed_recent"] == 1
     assert "approximate, this board view" in klb.words(backlog)
 
 
diff --git a/tests/hermes_cli/test_kanban_parent_first_dispatch.py b/tests/hermes_cli/test_kanban_parent_first_dispatch.py
