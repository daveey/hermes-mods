From cdcc2afc36462cc0f3fa7b27e9c4cd898620dcf4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 31 Oct 2026 06:06:16 +0000
Subject: [PATCH] fix(ci): keep optional BuildKit cache export failures
 non-fatal [daveey]

---
 .github/workflows/docker.yml             |  5 +++--
 .github/workflows/sandbox-image.yml      |  2 +-
 tests/ci/test_artifact_quota_advisory.py | 17 +++++++++++++++++
 3 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/.github/workflows/docker.yml b/.github/workflows/docker.yml
index da46807dd37..aaa90307606 100644
--- a/.github/workflows/docker.yml
+++ b/.github/workflows/docker.yml
@@ -233,8 +233,9 @@ jobs:
             HERMES_BOT_DESKTOP=${{ matrix.variant == 'desktop' && '1' || '0' }}
           # Slim owns the scope; desktop adds the gated apt layer, so it reads
           # and writes nothing — a mode=max scope could exceed the cache cap.
+          # Cache export is optional; backend outages must not discard a tested image.
           cache-from: type=gha,scope=docker-${{ matrix.arch }}
-          cache-to: ${{ (github.event_name != 'pull_request' && matrix.variant == 'slim') && format('type=gha,mode=max,scope=docker-{0}', matrix.arch) || '' }}
+          cache-to: ${{ (github.event_name != 'pull_request' && matrix.variant == 'slim') && format('type=gha,mode=max,ignore-error=true,scope=docker-{0}', matrix.arch) || '' }}
 
 
       # Run the docker-integration test suite against the freshly-built image
@@ -412,7 +413,7 @@ jobs:
             org.opencontainers.image.revision=${{ env.CANDIDATE_COMMIT }}
           outputs: type=image,name=${{ env.IMAGE_NAME }},push-by-digest=true,name-canonical=true,push=true
           cache-from: type=gha,scope=docker-${{ matrix.arch }}
-          cache-to: ${{ matrix.variant == 'slim' && format('type=gha,mode=max,scope=docker-{0}', matrix.arch) || '' }}
+          cache-to: ${{ matrix.variant == 'slim' && format('type=gha,mode=max,ignore-error=true,scope=docker-{0}', matrix.arch) || '' }}
 
       - name: Export digest
         run: |
diff --git a/.github/workflows/sandbox-image.yml b/.github/workflows/sandbox-image.yml
index d7a3574473c..4f9475c2c86 100644
--- a/.github/workflows/sandbox-image.yml
+++ b/.github/workflows/sandbox-image.yml
@@ -64,7 +64,7 @@ jobs:
           tags: ${{ env.IMAGE_NAME }}:test
           load: true
           cache-from: type=gha,scope=sandbox-${{ matrix.arch }}
-          cache-to: ${{ github.event_name != 'pull_request' && format('type=gha,mode=max,scope=sandbox-{0}', matrix.arch) || '' }}
+          cache-to: ${{ github.event_name != 'pull_request' && format('type=gha,mode=max,ignore-error=true,scope=sandbox-{0}', matrix.arch) || '' }}
 
       # The contract: the launcher, cua-driver and a headed Chromium work as `pn`.
       - name: Smoke
diff --git a/tests/ci/test_artifact_quota_advisory.py b/tests/ci/test_artifact_quota_advisory.py
index c3fa182066c..919058cca6a 100644
--- a/tests/ci/test_artifact_quota_advisory.py
+++ b/tests/ci/test_artifact_quota_advisory.py
@@ -39,6 +39,23 @@ def test_every_artifact_upload_is_continue_on_error():
     assert not blocking, f"upload-artifact steps that can fail their job on the artifact quota: {blocking}"
 
 
+def test_buildkit_cache_exports_are_advisory_without_ignoring_build_failures():
+    exporters = [
+        (f"{name}:{job_name}:{step.get('name', step.get('uses'))}", step)
+        for name, workflow in _loaded().items()
+        for job_name, job in (workflow.get("jobs") or {}).items()
+        for step in _steps(job)
+        if "type=gha" in str((step.get("with") or {}).get("cache-to", ""))
+    ]
+    assert exporters, "no GitHub Actions cache exporters exercised"
+    for name, step in exporters:
+        cache_to = step["with"]["cache-to"]
+        assert "ignore-error=true" in cache_to, f"optional cache export can fail the build: {name}"
+        assert str(step.get("continue-on-error", "false")).lower() == "false", (
+            f"real image build/push failures must remain fatal: {name}"
+        )
+
+
 def _required_jobs(workflows):
     """Every job the required gate waits on, following local reusable-workflow calls."""
     jobs = workflows["ci.yaml"]["jobs"]
-- 
2.55.0

