From 64d569b3cfd328fec689e2fc4cfd35c3a7a40756 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 22:27:22 +0000
Subject: [PATCH] test(kanban): upstream dir-workspace owner tests grant the
 fork's capability gate [daveey]

kanban_capabilities (fork) requires the assignee's profile config.yaml to prove
terminal/file/host_repo for a dir workspace and fails closed on a missing file; fork-base
behaved the same (utils.load_yaml_file_readonly raises FileNotFoundError on both sides).
These upstream tests never met that gate and are about owner policy, the run-off-loop
write and the trial model, so they stub _profile_capabilities like 3be1dc41d09 did.
---
 tests/gateway/test_session_kanban.py                  | 8 ++++++++
 tests/gateway/test_session_kanban_run_off_loop.py     | 4 ++++
 tests/hermes_cli/test_kanban_worker_spawn_toolsets.py | 4 ++++
 tests/hermes_cli/test_welcome_trial.py                | 5 +++++
 4 files changed, 21 insertions(+)

diff --git a/tests/gateway/test_session_kanban.py b/tests/gateway/test_session_kanban.py
index b6af6174d63..efa459ab982 100644
--- a/tests/gateway/test_session_kanban.py
+++ b/tests/gateway/test_session_kanban.py
@@ -17,6 +17,10 @@ def test_claim_freezes_task_policy_and_rejects_forgery(tmp_path, monkeypatch):
     monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
     monkeypatch.delenv('HERMES_DELEGATED_CHILD', raising=False)
     monkeypatch.setattr('hermes_cli.profiles.resolve_profile_env', lambda name: str(tmp_path) if name == 'default' else str(tmp_path / name))
+    # Fork: dir workspaces need terminal/file/host_repo in the assignee's profile policy; that gate
+    # (hermes_cli.kanban_capabilities) is not what this upstream test covers, so the assignee has them.
+    monkeypatch.setattr('hermes_cli.kanban_capabilities._profile_capabilities',
+                        lambda name: {'terminal', 'file', 'git', 'host_repo', 'kanban'})
     workspace = tmp_path / 'workspace'
     workspace.mkdir()
     (workspace / 'pyproject.toml').write_text('[project]\nname = "task"\n')  # a code worktree
@@ -113,6 +117,10 @@ def test_claim_reclaimed_before_admission_marker_is_refused(tmp_path, monkeypatc
     monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
     monkeypatch.delenv('HERMES_DELEGATED_CHILD', raising=False)
     monkeypatch.setattr('hermes_cli.profiles.resolve_profile_env', lambda name: str(tmp_path) if name == 'default' else str(tmp_path / name))
+    # Fork: dir workspaces need terminal/file/host_repo in the assignee's profile policy; that gate
+    # (hermes_cli.kanban_capabilities) is not what this upstream test covers, so the assignee has them.
+    monkeypatch.setattr('hermes_cli.kanban_capabilities._profile_capabilities',
+                        lambda name: {'terminal', 'file', 'git', 'host_repo', 'kanban'})
     workspace = tmp_path / 'workspace'
     workspace.mkdir()
     kb.create_board('owned')  # explicit creation; connect() never creates a board (#43243)
diff --git a/tests/gateway/test_session_kanban_run_off_loop.py b/tests/gateway/test_session_kanban_run_off_loop.py
index 7d93095903c..5d40c916613 100644
--- a/tests/gateway/test_session_kanban_run_off_loop.py
+++ b/tests/gateway/test_session_kanban_run_off_loop.py
@@ -24,6 +24,10 @@ def test_run_task_kanban_write_never_blocks_the_loop(tmp_path, monkeypatch):
     monkeypatch.delenv('HERMES_DELEGATED_CHILD', raising=False)
     monkeypatch.setattr('hermes_cli.profiles.resolve_profile_env',
                         lambda name: str(tmp_path) if name == 'default' else str(tmp_path / name))
+    # Fork: dir workspaces need terminal/file/host_repo in the assignee's profile policy; that gate
+    # (hermes_cli.kanban_capabilities) is not what this upstream test covers, so the assignee has them.
+    monkeypatch.setattr('hermes_cli.kanban_capabilities._profile_capabilities',
+                        lambda name: {'terminal', 'file', 'git', 'host_repo', 'kanban'})
     workspace = tmp_path / 'workspace'
     workspace.mkdir()
     kb.create_board('owned')
diff --git a/tests/hermes_cli/test_kanban_worker_spawn_toolsets.py b/tests/hermes_cli/test_kanban_worker_spawn_toolsets.py
index 026ae441c18..890c6048ae2 100644
--- a/tests/hermes_cli/test_kanban_worker_spawn_toolsets.py
+++ b/tests/hermes_cli/test_kanban_worker_spawn_toolsets.py
@@ -181,6 +181,10 @@ def test_worker_toolsets_come_from_the_assignee_profile_not_the_parent_config(tm
     monkeypatch.setenv("HOME", str(tmp_path / "home"))
     monkeypatch.delenv("HERMES_KANBAN_DB", raising=False)
     monkeypatch.setattr("hermes_cli.profiles.resolve_profile_env", lambda name: str(profile))
+    # Fork: dir workspaces need terminal/file/host_repo in the assignee's profile policy; that gate
+    # (hermes_cli.kanban_capabilities) is not what this upstream test covers, so the assignee has them.
+    monkeypatch.setattr("hermes_cli.kanban_capabilities._profile_capabilities",
+                        lambda name: {"terminal", "file", "git", "host_repo", "kanban"})
     workspace = tmp_path / "workspace"
     workspace.mkdir()
     kb.create_board("owned")  # explicit creation; connect() never creates a board (#43243)
diff --git a/tests/hermes_cli/test_welcome_trial.py b/tests/hermes_cli/test_welcome_trial.py
index b2ec63be73e..1e15b2d5c21 100644
--- a/tests/hermes_cli/test_welcome_trial.py
+++ b/tests/hermes_cli/test_welcome_trial.py
@@ -324,6 +324,11 @@ def _kanban_worker_model(monkeypatch, tmp_path) -> str:
     monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path / "kanban"))
     monkeypatch.delenv("HERMES_KANBAN_DB", raising=False)
     monkeypatch.setattr("hermes_cli.profiles.resolve_profile_env", lambda name: home)
+    # Fork: dir workspaces need terminal/file/host_repo proven by the assignee's profile config.yaml
+    # (hermes_cli.kanban_capabilities fails closed on a missing file); that gate is not what this
+    # upstream trial-model test covers, so the assignee has them.
+    monkeypatch.setattr("hermes_cli.kanban_capabilities._profile_capabilities",
+                        lambda name: {"terminal", "file", "git", "host_repo", "kanban"})
     workspace = tmp_path / "workspace"
     workspace.mkdir()
     kb.create_board("trial")
-- 
