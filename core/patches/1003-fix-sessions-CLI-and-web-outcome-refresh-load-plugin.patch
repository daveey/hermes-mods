From 4913c3c71d032c994771bafe8a9d64abc7e2edc1 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 29 Oct 2026 14:51:49 -0700
Subject: [PATCH] fix(sessions): CLI and web outcome refresh load plugin
 providers and judge first [daveey]

Without plugins loaded, `hermes sessions outcome-audit --refresh` (run by the
auditor cron every 10 min) re-derived without the user-steps provider and
stored `done` over chats waiting on a user decision.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hermes_cli/sessions_cmd_outcome.py            | 19 +++++++
 hermes_cli/web_routers/sessions.py            |  4 ++
 .../test_session_outcome_surfaces.py          | 49 +++++++++++++++++++
 3 files changed, 72 insertions(+)

diff --git a/hermes_cli/sessions_cmd_outcome.py b/hermes_cli/sessions_cmd_outcome.py
index c6361c92cea..3a929dd195b 100644
--- a/hermes_cli/sessions_cmd_outcome.py
+++ b/hermes_cli/sessions_cmd_outcome.py
@@ -8,6 +8,7 @@ session-status auditor's input.
 from __future__ import annotations
 
 import json
+import logging
 import time
 from typing import Any
 
@@ -50,9 +51,25 @@ def _describe(outcome: dict[str, Any] | None) -> str:
     return str(kind)
 
 
+def ensure_outcome_hooks() -> None:
+    """Load plugins before a re-derive so their outcome providers and judge are registered. Without
+    them a CLI/web refresh drops plugin-sourced decisions (user-steps tiles) and downgrades to the
+    heuristic, overwriting what the chat's own backend stored. Idempotent; a load failure leaves the
+    core-only derivation."""
+    try:
+        from hermes_cli.plugins import discover_plugins
+
+        discover_plugins()
+    except Exception:  # health: allow BLE001 -- plugin load is best effort; core sources still derive
+        logging.getLogger(__name__).warning("outcome refresh: plugin load failed", exc_info=True)
+
+
 def cmd_outcome(db, args):
     from hermes_state_outcome import get_outcome, refresh_outcome
 
+    if args.refresh:
+        ensure_outcome_hooks()
+
     sid = _resolve(db, args.session_id)
     if not sid:
         return 1
@@ -79,6 +96,8 @@ def audit_rows(db, *, refresh: bool = False, limit: int = AUDIT_DEFAULT_LIMIT) -
     """``{id, title, kind, reason, age_h, on, items}`` per sidebar row (``age_h`` = hours since last activity)."""
     from hermes_state_outcome import refresh_outcome
 
+    if refresh:
+        ensure_outcome_hooks()
     now, out = time.time(), []
     for row in sidebar_rows(db, limit):
         outcome = refresh_outcome(row["id"], "manual", db=db) if refresh else row.get("outcome")
diff --git a/hermes_cli/web_routers/sessions.py b/hermes_cli/web_routers/sessions.py
index 0096ff2a9b3..9618f13f4b5 100644
--- a/hermes_cli/web_routers/sessions.py
+++ b/hermes_cli/web_routers/sessions.py
@@ -1025,6 +1025,10 @@ async def get_session_outcome_endpoint(session_id: str, refresh: bool = False, p
         sid = _resolve_session_id(db, session_id)
         if not sid:
             raise HTTPException(status_code=404, detail=_NOT_FOUND)
+        if refresh:
+            from hermes_cli.sessions_cmd_outcome import ensure_outcome_hooks
+
+            ensure_outcome_hooks()
         outcome = refresh_outcome(sid, "manual", db=db) if refresh else get_outcome(sid, db=db)
         return {"session_id": sid, "outcome": outcome}
 
diff --git a/tests/hermes_cli/test_session_outcome_surfaces.py b/tests/hermes_cli/test_session_outcome_surfaces.py
index 86a23382141..5c5ca2f6e7a 100644
--- a/tests/hermes_cli/test_session_outcome_surfaces.py
+++ b/tests/hermes_cli/test_session_outcome_surfaces.py
@@ -147,3 +147,52 @@ def test_cli_outcome_audit_lists_exactly_the_sidebar_rows(homes, capsys):
         db.close()
     run_cli("outcome-audit")
     assert "no_summary" in capsys.readouterr().out
+
+
+# ── refresh loads plugin hooks ───────────────────────────────────────────
+
+PROBE_PLUGIN = '''
+def register(ctx):
+    import hermes_state_outcome as so
+
+    def provider(sid):
+        return {"decision_items": [{"id": "us_probe", "question": "Ship it?",
+                                    "choices": [{"label": "Yes", "value": "yes"}, {"label": "No", "value": "no"}],
+                                    "state": "open"}]}
+
+    so.register_outcome_provider("probe", provider)
+'''
+
+
+@pytest.fixture
+def probe_plugin(homes):
+    from hermes_cli import plugins
+
+    pdir = homes["default"] / "plugins" / "outcome-probe"
+    pdir.mkdir(parents=True)
+    (pdir / "plugin.yaml").write_text("name: outcome-probe\nversion: 0.1.0\ndescription: probe\n", encoding="utf-8")
+    (pdir / "__init__.py").write_text(PROBE_PLUGIN, encoding="utf-8")
+    (homes["default"] / "config.yaml").write_text("plugins:\n  enabled: [outcome-probe]\n", encoding="utf-8")
+    plugins._reset_plugin_managers_for_tests()
+    yield
+    plugins._reset_plugin_managers_for_tests()
+
+
+def test_cli_refresh_loads_plugin_providers(homes, probe_plugin, capsys):
+    """A CLI re-derive must see plugin decisions; without loading plugins it stored ``done`` over them."""
+    seed(homes["default"])
+    run_cli("outcome", "chat", "--refresh", "--json")
+    outcome = json.loads(capsys.readouterr().out)["outcome"]
+    assert outcome["kind"] == "decision"
+    assert outcome["items"][0]["id"] == "us_probe"
+    so._reset_hooks_for_tests()
+    from hermes_cli import plugins
+
+    plugins._reset_plugin_managers_for_tests()
+    run_cli("outcome-audit", "--json", "--refresh")
+    assert json.loads(capsys.readouterr().out)[0]["kind"] == "decision"
+
+
+def test_web_refresh_loads_plugin_providers(client, homes, probe_plugin):
+    seed(homes["default"])
+    assert client.get("/api/sessions/chat/outcome?refresh=1").json()["outcome"]["kind"] == "decision"
-- 
