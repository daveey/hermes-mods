From 7d7074c52f8bc192c42610895e9e9836b063e09d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:29:00 +0000
Subject: [PATCH] [daveey] Pin three surviving mutants from #2616, #2612 and
 #2577 (test-only)

The post-merge check t_01a1d6c731341d02 (sweep-2039 A2) found three production
behaviours that their own tests did not pin. Each mutant survived both at its
merge and at origin/main.

- #2616 pr_target / _only_sha (B5): a ref that itself names two shas must read
  the PR's current head (sha None), not fall through to the hint's one sha.
  New test: test_pr_target_ref_with_two_shas_ignores_the_hint.
- #2612 session_cron._expected_stop (C9): only an error text that STARTS with
  "CronRunCancelled: " / "CronShutdownInterrupted: " is an expected stop. A
  RuntimeError that merely mentions one stays a failure (ERROR + traceback,
  not INFO). New test: test_a_failure_that_mentions_a_stop_class_is_still_a_failure.
- #2577 kanban_dup_detector._NEGATED (D2): "as" after a judging verb is
  optional, so "Not even marked a duplicate of t_X" and "Never formally
  flagged the duplicate of t_X" still deny. New test:
  test_negator_without_as_still_denies_the_duplicate.

C10 (isinstance -> bool) is equivalent (run_job's result[3] is str | None)
and is left alone.

Proof (scripts/run_tests.sh, exact-anchor mutant runner):
- head: 138 passed, 0 failed across the three files
- with the new tests:    B5 killed (1 failed), C9 killed (2 failed), D2 killed (2 failed)
- without the new tests: B5 survived, C9 survived, D2 survived

Card: t_01a1d7005fb0a1f0
---
 tests/gateway/test_session_cron.py             | 14 ++++++++++++++
 tests/hermes_cli/test_kanban_ci_progress_pr.py |  7 +++++++
 tests/hermes_cli/test_kanban_dup_detector.py   | 10 ++++++++++
 3 files changed, 31 insertions(+)

diff --git a/tests/gateway/test_session_cron.py b/tests/gateway/test_session_cron.py
index 27affc5d5f..baf7cd0258 100644
--- a/tests/gateway/test_session_cron.py
+++ b/tests/gateway/test_session_cron.py
@@ -439,3 +439,17 @@ async def test_requested_cron_stop_is_not_an_admitted_turn_failure(tmp_path, mon
     assert len(records) <= 1, records
     assert all(r.levelno <= logging.WARNING and not r.exc_info for r in records), records
     assert all('failed' not in r.getMessage() for r in records), records
+
+
+@pytest.mark.parametrize('error, expected', [
+    ('CronRunCancelled: Cron job \'probe\' was stopped: job removed while running', True),
+    ('CronShutdownInterrupted: gateway shutting down', True),
+    ('RuntimeError: lost fire ownership after retry of CronRunCancelled: stale marker', False),
+    ('RuntimeError: worker died during CronShutdownInterrupted: drain', False),
+])
+def test_a_failure_that_mentions_a_stop_class_is_still_a_failure(error, expected):
+    """Post-merge check of PR #2612: only an error text that starts with a stop class's ``<type>: `` is an
+    expected stop. A real failure whose message merely mentions one stays a failure, so it is still logged as an
+    ERROR with its traceback rather than hidden at INFO."""
+    from gateway import session_cron
+    assert session_cron._expected_stop(error) is expected
diff --git a/tests/hermes_cli/test_kanban_ci_progress_pr.py b/tests/hermes_cli/test_kanban_ci_progress_pr.py
index 3b5cc18641..4e223a598a 100644
--- a/tests/hermes_cli/test_kanban_ci_progress_pr.py
+++ b/tests/hermes_cli/test_kanban_ci_progress_pr.py
@@ -168,6 +168,13 @@ def test_pr_target(ref, hint, want) -> None:
     assert kcp.pr_target(ref, hint) == want
 
 
+def test_pr_target_ref_with_two_shas_ignores_the_hint() -> None:
+    """Post-merge check of PR #2616: a ref that itself names two shas reads the PR's current head. It never falls
+    through to the hint's one sha, which may be an old head the ref's own text already disagrees with."""
+    ref = f"https://github.com/{REPO}/pull/{PR} {OTHER} {BASE}"
+    assert kcp.pr_target(ref, f"head is {HEAD}") == (REPO, PR, None)
+
+
 # --- a. park time -------------------------------------------------------------------------------------------------
 
 @CONFLICTS
diff --git a/tests/hermes_cli/test_kanban_dup_detector.py b/tests/hermes_cli/test_kanban_dup_detector.py
index abc62453fa..5e1c3b4cf3 100644
--- a/tests/hermes_cli/test_kanban_dup_detector.py
+++ b/tests/hermes_cli/test_kanban_dup_detector.py
@@ -207,3 +207,13 @@ def test_every_joining_word_stops_the_negator_reaching_the_keyword(summary):
 def test_every_judging_verb_after_a_negator_denies_the_keyword(verb, template):
     """Post-merge check of PR #2535: each ``_JUDGED`` verb keeps the denial across "as"."""
     assert dd.sibling_named(template.format(verb)) == []
+
+
+@pytest.mark.parametrize("summary", [
+    "Not even marked a duplicate of t_0123456789abcdef.",
+    "Never formally flagged the duplicate of t_0123456789abcdef.",
+])
+def test_negator_without_as_still_denies_the_duplicate(summary):
+    """Post-merge check of PR #2577: "as" after the judging verb is optional. With a hedge word before the verb,
+    the denial reaches the keyword only through that branch, since the plain two-word window is too short."""
+    assert dd.sibling_named(summary) == []
