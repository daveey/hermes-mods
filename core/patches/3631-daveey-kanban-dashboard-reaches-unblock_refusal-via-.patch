From 4d54f3b4f70253e93aa4e676e470fe4207bd1d3c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 13:50:44 +0000
Subject: [PATCH] [daveey] kanban: dashboard reaches unblock_refusal via
 kanban_db; reopen's stale-copy UPDATE pins its statuses

CI on 580652713a was red on two guards:
- tests/scripts/test_boundary_lint.py: plugins/kanban/dashboard/plugin_api.py imported
  hermes_cli.kanban_terminal_guard (new core boundary import). kanban_db now re-exports the
  stdlib-only unblock_refusal at module scope and the dashboard calls kanban_db.unblock_refusal.
- The CLI unblock refusal also calls kb.unblock_refusal (no function-local import; kanban.py stays at its 2000-line cap).
- tests/hermes_cli/test_kanban_source_receipt_sites.py: reopen_done_task's UPDATE pinned
  status = ? (unprovable off-running). The WHERE now also pins
  status IN ('done', 'blocked', 'scheduled', 'triage'): reopen never moves a running card.

Proof: 15 related files / 329 tests green locally (both guards included); scripts/check ok.
---
 hermes_cli/kanban.py                   | 4 +---
 hermes_cli/kanban_db.py                | 1 +
 hermes_cli/kanban_db_operator.py       | 3 ++-
 plugins/kanban/dashboard/plugin_api.py | 6 +++---
 4 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/hermes_cli/kanban.py b/hermes_cli/kanban.py
index 32d65e5b49..164d4c459f 100644
--- a/hermes_cli/kanban.py
+++ b/hermes_cli/kanban.py
@@ -1498,10 +1498,8 @@ def _cmd_unblock(args: argparse.Namespace) -> int:
         if rc:
             return rc
         op = _commented(reason, author, "UNBLOCK", lambda tid, comment: kb.unblock_task(conn, tid, comment=comment, event_extra={"actor": cli_actor()}))
-        from hermes_cli.kanban_terminal_guard import unblock_refusal
         return _bulk_apply(ids, op, lambda tid: f"Unblocked {tid}{suffix}",
-                           lambda tid: (unblock_refusal(conn, tid)
-                                        or f"cannot unblock {tid} (not blocked/scheduled?)"), conn=conn)
+                           lambda tid: kb.unblock_refusal(conn, tid) or f"cannot unblock {tid} (not blocked/scheduled?)", conn=conn)
 
 
 def _cmd_request_review(args: argparse.Namespace) -> int:
diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index 3ea7ec5d25..323922327e 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -40,6 +40,7 @@ from hermes_cli import kanban_placement_forward as _placement_fwd  # stdlib-only
 from hermes_cli import kanban_run_end_lease as _run_end_lease  # stdlib-only at import: no cycle
 from hermes_cli.kanban_host_identity import is_local_claim as _claim_is_local
 from hermes_cli.kanban_db_dispatch_queries import DISPATCH_ORDER  # stdlib-only at import: no cycle
+from hermes_cli.kanban_terminal_guard import unblock_refusal  # stdlib-only at import: no cycle; re-exported for plugins
 from hermes_cli.kanban_admission import admission_hold_set, claim_transaction, claim_and_open_run, hub_cpu_advisory
 from hermes_cli.kanban_workflow import DEFAULT_STATUSES as VALID_STATUSES
 from toolsets import get_toolset_names
diff --git a/hermes_cli/kanban_db_operator.py b/hermes_cli/kanban_db_operator.py
index 5850076d8d..c9f8c36823 100644
--- a/hermes_cli/kanban_db_operator.py
+++ b/hermes_cli/kanban_db_operator.py
@@ -149,7 +149,8 @@ def reopen_done_task(
         cur = conn.execute(
             "UPDATE tasks SET status = ?, completed_at = NULL, current_run_id = NULL, "
             "claim_lock = NULL, claim_expires = NULL, worker_pid = NULL, worker_started_at = NULL, "
-            "consecutive_failures = 0, human_request = NULL WHERE id = ? AND status = ?",
+            "consecutive_failures = 0, human_request = NULL "
+            "WHERE id = ? AND status IN ('done', 'blocked', 'scheduled', 'triage') AND status = ?",
             (new_status, task_id, previous),
         )
         if cur.rowcount != 1:
diff --git a/plugins/kanban/dashboard/plugin_api.py b/plugins/kanban/dashboard/plugin_api.py
index 676c23e5f1..396612a4dc 100644
--- a/plugins/kanban/dashboard/plugin_api.py
+++ b/plugins/kanban/dashboard/plugin_api.py
@@ -31,7 +31,7 @@ from fastapi import (
 from fastapi.responses import FileResponse, Response
 from pydantic import BaseModel, Field
 
-from hermes_cli import kanban_db, kanban_terminal_guard as ktg
+from hermes_cli import kanban_db
 from hermes_cli import kanban_review_contract as _review_contract  # a dashboard "done" is never a worker run
 from hermes_cli import kanban_workflow
 from hermes_cli.web_read_coalescing import coalesced_read
@@ -763,9 +763,9 @@ def _patch_status(conn, task_id: str, payload: UpdateTaskBody, review_assignee_d
 
 def _refusal_detail(conn, task_id: str, s: str) -> Optional[str]:
     """Why a move was refused, past the generic text: a drag to ``ready`` ``unblock_task`` refused for a stale copy of
-    a done/archived card (``kanban_terminal_guard``), or a ``done``/``review`` with open parents (bare False too)."""
+    a done/archived card (``kanban_db.unblock_refusal``), or a ``done``/``review`` with open parents (bare False too)."""
     if s == "ready":
-        return ktg.unblock_refusal(conn, task_id)
+        return kanban_db.unblock_refusal(conn, task_id)
     blockers = kanban_db.unsatisfied_parents(conn, task_id) if s in ("done", "review") else []
     if not blockers:
         return None
