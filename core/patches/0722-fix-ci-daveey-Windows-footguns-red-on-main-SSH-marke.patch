From 39b6ddb29fe4e913331292faae096825545fc60f Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 11:15:40 +0000
Subject: [PATCH] fix(ci): [daveey] Windows footguns red on main: SSH marker
 prune uses _pid_exists, BOM-tolerant reads, explicit ps encoding

e4222cf97b (os.kill(pid, 0) and a utf-8 read in web_server.py) and fc7b1ac399 (text=True without
encoding, utf-8 json read in update_gateway_fence.py) turned 'Windows footguns (blocking)' red on main
and every PR. gateway.status._pid_exists keeps the prune contract: a dead pid's marker is removed, a
live or permission-denied one is kept.
---
 hermes_cli/update_gateway_fence.py |  4 ++--
 hermes_cli/web_server.py           | 14 ++++++--------
 2 files changed, 8 insertions(+), 10 deletions(-)

diff --git a/hermes_cli/update_gateway_fence.py b/hermes_cli/update_gateway_fence.py
index 3109daeb07..0526a662ec 100644
--- a/hermes_cli/update_gateway_fence.py
+++ b/hermes_cli/update_gateway_fence.py
@@ -39,7 +39,7 @@ def _ancestor_pids() -> set[int]:
             break
         pids.add(pid)
         try:
-            out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True,
+            out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True, encoding="utf-8",
                                  timeout=5, check=False).stdout.strip()
             pid = int(out)
         except (OSError, ValueError, subprocess.SubprocessError):
@@ -49,7 +49,7 @@ def _ancestor_pids() -> set[int]:
 
 def _intent_pid(home: Path) -> Optional[int]:
     try:
-        data = json.loads((Path(home) / "core-update" / "intent").read_text(encoding="utf-8"))
+        data = json.loads((Path(home) / "core-update" / "intent").read_text(encoding="utf-8-sig"))
         pid = int(data["pid"])
     except (OSError, ValueError, KeyError, TypeError):
         return None
diff --git a/hermes_cli/web_server.py b/hermes_cli/web_server.py
index dc5f2e0510..2f4cbf6606 100644
--- a/hermes_cli/web_server.py
+++ b/hermes_cli/web_server.py
@@ -500,7 +500,7 @@ _SSH_RUNTIME_ATEXIT_ARMED = False
 def _ssh_marker_pid(marker: str) -> Optional[int]:
     """[daveey] The pid a marker file records (``pid=<n>``), None when unreadable or malformed."""
     try:
-        with open(marker, "r", encoding="utf-8") as fh:
+        with open(marker, "r", encoding="utf-8-sig") as fh:
             text = fh.read(64)
     except (OSError, UnicodeDecodeError):
         return None
@@ -535,13 +535,11 @@ def _prune_stale_ssh_runtime_markers(purelib: str) -> None:
         pid = _ssh_marker_pid(marker)
         if pid is None or pid == os.getpid():
             continue
-        try:
-            os.kill(pid, 0)
-        except ProcessLookupError:
-            pass
-        except OSError:
-            continue
-        else:
+        # [daveey] gateway.status._pid_exists, not os.kill(pid, 0): on Windows that sends CTRL_C_EVENT to the
+        # target's console group (bpo-14484). It reports a permission-denied pid as alive, so it is kept.
+        from gateway.status import _pid_exists
+
+        if _pid_exists(pid):
             continue
         if _ssh_marker_pid(marker) == pid:
             try:
-- 
