From 55023a8782bd18ca83564cf97ea61a3b21c1a5e9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 23:18:31 +0000
Subject: [PATCH] [daveey] Require positive remote publication for checkout
 deletion exception

The legacy unpushed predicate permits a local-trunk baseline without remote refs. Require a remote-tracking ref containing HEAD before granting this placement-only exception; keep clean-tree policy unchanged.

Proof: real-Git no-remote regressions RED on 8a7da681; 24-case Cartesian publication/upstream/deletion/refresh matrix GREEN. All 23 placement consumer files passed (535 tests); final checkout suite including empty-evidence controls passed (55 tests). Publication-condition mutant killed by six assertions; full scripts/check --base origin/main passed.
---
 hermes_cli/kanban_checkout_deletions.py       |  6 +++
 .../test_kanban_checkout_deletions.py         | 39 ++++++++++++++++++-
 2 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_checkout_deletions.py b/hermes_cli/kanban_checkout_deletions.py
index bec8f4f461..d5cfa97548 100644
--- a/hermes_cli/kanban_checkout_deletions.py
+++ b/hermes_cli/kanban_checkout_deletions.py
@@ -43,6 +43,12 @@ def published_checkout_deletions(tree: str, budget) -> bool:
             return False
         if probe(["merge-base", "--is-ancestor", "HEAD", "@{upstream}"]) is None:
             return False
+        # A local upstream/trunk is not publication. Require positive remote-ref
+        # reachability here; the legacy unpushed predicate allows a local-trunk
+        # baseline when there are no remote refs, which must not grant this exception.
+        published = probe(["for-each-ref", "--contains=HEAD", "--format=%(refname)", "refs/remotes/"])
+        if not published or not published.strip():
+            return False
         return not hidden_index_edits(tree, env=env, budget=budget)
     except subprocess.TimeoutExpired:
         raise timed_out(budget) from None
diff --git a/tests/hermes_cli/test_kanban_checkout_deletions.py b/tests/hermes_cli/test_kanban_checkout_deletions.py
index 0432725cd7..d391bdbed8 100644
--- a/tests/hermes_cli/test_kanban_checkout_deletions.py
+++ b/tests/hermes_cli/test_kanban_checkout_deletions.py
@@ -83,7 +83,41 @@ def test_upstream_may_be_ahead(tmp_path, empty_index):
     assert kmp.tree_state([str(repo)]) is None
 
 
-@pytest.mark.parametrize("probe_name", ["status", "symbolic-ref", "merge-base", "ls-files"])
+@pytest.mark.parametrize("empty_index", [False, True])
+@pytest.mark.parametrize("publication", ["none", "unrelated", "published"])
+@pytest.mark.parametrize("upstream", ["local", "remote"])
+@pytest.mark.parametrize("refresh", [False, True])
+def test_upstream_requires_remote_publication(tmp_path, empty_index, publication, upstream, refresh):
+    _ws, repo = _checkout(tmp_path, empty_index=empty_index)
+    if publication != "published":
+        pq._commit(repo, "private.txt")
+        if empty_index:
+            pq._git(repo, "rm", "-q", "-f", "private.txt")
+    if publication == "none":
+        pq._git(repo, "remote", "remove", "origin")
+    if upstream == "local":
+        pq._git(repo, "branch", "-f", "main", "HEAD")
+        pq._git(repo, "branch", "--set-upstream-to=main")
+    state = kmp.tree_state([str(repo)], refresh=refresh)
+    assert (state is None) == (publication == "published")
+
+
+@pytest.mark.parametrize("output", ["", " \n\t"])
+def test_empty_remote_publication_is_not_proof(tmp_path, monkeypatch, output):
+    from hermes_cli import worktree_ops
+    _ws, repo = _checkout(tmp_path)
+    real = worktree_ops._git
+
+    def git(args, *a, **kw):
+        if args[0] == "for-each-ref" and "--contains=HEAD" in args:
+            return subprocess.CompletedProcess(args, 0, output, "")
+        return real(args, *a, **kw)
+
+    monkeypatch.setattr(worktree_ops, "_git", git)
+    assert kmp.tree_state([str(repo)]) is not None
+
+
+@pytest.mark.parametrize("probe_name", ["status", "symbolic-ref", "merge-base", "ls-files", "for-each-ref"])
 @pytest.mark.parametrize("failure", ["exit", "stderr", "timeout"])
 def test_unknown_probe_still_pins(tmp_path, monkeypatch, probe_name, failure):
     from hermes_cli import worktree_ops
@@ -91,7 +125,8 @@ def test_unknown_probe_still_pins(tmp_path, monkeypatch, probe_name, failure):
     real = worktree_ops._git
 
     def git(args, *a, **kw):
-        if args[0] == probe_name and (probe_name != "status" or "--porcelain=v1" in args):
+        selected = args[0] == probe_name and (probe_name != "status" or "--porcelain=v1" in args)
+        if selected and (probe_name != "for-each-ref" or "--contains=HEAD" in args):
             if failure == "timeout":
                 raise subprocess.TimeoutExpired(args, 10)
             return subprocess.CompletedProcess(args, 128 if failure == "exit" else 0, "", "warning: unknown")
