+# Exactly what hermes-mods' kanban-worker-nice terminal_request middleware prefixes on protected Linux hosts.
+NICE_PREAMBLE = ('# kanban-worker-nice terminal floor\n'
+                 'if [ "$(nice)" -lt 10 ]; then renice -n 10 -p "${BASHPID:-$$}" >/dev/null || exit $?; fi\n')
+
+
+def test_process_labels_drop_injected_nice_preamble(home, sleeper):
+    """Chat 20990101_030000_decade: two ``bb-land --wait`` rows read ``# kanban-worker-nice terminal floor if ...``."""
+    import tools.process_registry as pr
+    from hermes_state_outcome import _process_items
+
+    a, b = sleeper(), sleeper()
+    (home / "processes.json").write_text(json.dumps([
+        {**_entry("proc_land", a.pid, session_key="s_w"), "command": NICE_PREAMBLE + "bb-land --wait 858",
+         "started_at": 100.0},
+    ]))
+    pr.process_registry._running["proc_mem"] = ProcessSession(
+        id="proc_mem", command=NICE_PREAMBLE + "cd /repo && gh pr checks 858 --watch", task_id="default",
+        session_key="s_w", pid=b.pid, host_start_time=ProcessRegistry._safe_host_start_time(b.pid), started_at=200.0)
+    rows = [{"id": "s_w"}]
+
+    psa.annotate_background_activity(rows)
+
+    assert [p["command"] for p in rows[0]["background_processes"]] == [
+        "bb-land --wait 858", "cd /repo && gh pr checks 858 --watch"]
+    psa._reset_cache_for_tests()
+    assert sorted(i["label"] for i in _process_items("s_w", ["s_w"])) == [
+        "bb-land --wait 858", "cd /repo && gh pr checks 858 --watch"]
+
+
+def test_process_labels_keep_agent_comments_and_unprefixed_commands(home, sleeper):
+    a, b, c = sleeper(), sleeper(), sleeper()
+    (home / "processes.json").write_text(json.dumps([
+        {**_entry("proc_a", a.pid, session_key="s_w"), "command": "# my note\nsleep 600", "started_at": 1.0},
+        {**_entry("proc_b", b.pid, session_key="s_w"), "command": "echo '# kanban-worker-nice terminal floor'",
+         "started_at": 2.0},
+        {**_entry("proc_c", c.pid, session_key="s_w"), "command": NICE_PREAMBLE, "started_at": 3.0},
+    ]))
+    rows = [{"id": "s_w"}]
+
+    psa.annotate_background_activity(rows)
+
+    assert [p["command"] for p in rows[0]["background_processes"]] == [
+        "# my note sleep 600", "echo '# kanban-worker-nice terminal floor'", "background process"]
+
+
+def test_foreign_checkpoint_outcome_label_drops_injected_nice_preamble(home, sleeper):
+    """refresh_outcome's foreign-checkpoint items label the same way as the sidebar's."""
+    from hermes_state_process_checkpoint import checkpoint_items
+
+    live = sleeper()
+    (home / "processes.json").write_text(json.dumps([
+        {**_entry("proc_land", live.pid, parent_session_id="s_w"), "command": NICE_PREAMBLE + "bb-land --wait 858"},
+        {**_entry("proc_bare", live.pid, parent_session_id="s_w"), "command": NICE_PREAMBLE},
+    ]))
+    registry = type("R", (), {"_detached_host_fate": staticmethod(lambda pid, birth: "running")})
+
+    assert [i["label"] for i in checkpoint_items(registry, "s_w", set())] == ["bb-land --wait 858", "proc_bare"]
diff --git a/tests/tools/test_process_display.py b/tests/tools/test_process_display.py
new file mode 100644
index 0000000000000000000000000000000000000000..8a7962e52d6edd0215449e4b0aac6f2112c84f19
--- /dev/null
+++ b/tests/tools/test_process_display.py
@@ -0,0 +1,24 @@
+"""display_command: what a background process is shown as. [daveey]"""
+
+import pytest
+
+from tools.process_display import display_command
+
+NICE = ('# kanban-worker-nice terminal floor\n'
+        'if [ "$(nice)" -lt 10 ]; then renice -n 10 -p "${BASHPID:-$$}" >/dev/null || exit $?; fi\n')
+
+
+@pytest.mark.parametrize("raw, shown", [
+    (NICE + "bb-land --wait", "bb-land --wait"),
+    (NICE + NICE + "make test", "make test"),  # stacked prefixes
+    (NICE.replace("\n", "\r\n", 1) + "ls", "ls"),
+    (NICE, ""),
+    (NICE.rstrip("\n"), ""),
+    ("# kanban-worker-nice terminal floor", "# kanban-worker-nice terminal floor"),  # no injected line: not a prefix
+    ("ls\n" + NICE + "pwd", "ls\n" + NICE + "pwd"),  # only a leading block
+    ("# build it\nmake", "# build it\nmake"),
+    ("", ""),
+    (None, ""),
+])
+def test_display_command(raw, shown):
+    assert display_command(raw) == shown
diff --git a/tools/process_display.py b/tools/process_display.py
new file mode 100644
index 0000000000000000000000000000000000000000..d33d9df076aed397e5753edc6762644e58eecfeb
--- /dev/null
+++ b/tools/process_display.py
@@ -0,0 +1,26 @@
+"""The command a background process should be *shown* as.
+
+Host ``tool_request`` middleware may prefix a terminal command before it runs:
+hermes-mods' ``kanban-worker-nice`` plugin adds a niceness floor as two lines,
+``# kanban-worker-nice terminal floor`` and one ``renice`` line. The registry
+records the command that actually ran, so session outcomes, the sidebar and the
+status panel labelled such a process ``# kanban-worker-nice terminal floor if
+[ "$(nice)" -lt 10 ]; then renice ...`` instead of what the agent asked for.
+
+Contract for injecting middleware: mark the prefix with a ``# <source> terminal
+floor`` comment line followed by exactly one shell line. Only leading blocks of
+that shape are dropped, so an agent's own comments and commands stay intact.
+[daveey]
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+INJECTED_PREAMBLE_RE = re.compile(r"\A(?:# [A-Za-z0-9_.-]+ terminal floor\r?\n[^\n]*(?:\n|\Z))+")
+
+
+def display_command(command: Any) -> str:
+    """``command`` without a host middleware's injected preamble (``''`` for a missing command)."""
+    return INJECTED_PREAMBLE_RE.sub("", str(command or ""), count=1)
