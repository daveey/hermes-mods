From 63d021d1388beebaf85289c8eca62ca1b92f799b Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:48:56 -0800
Subject: [PATCH] [daveey] Stale block-ask refresh: one Open task line per
 notice, linear field matching (review N1/N2)

---
 hermes_cli/kanban_stale_ask.py               | 23 ++++++---
 tests/gateway/test_kanban_stale_block_ask.py | 54 ++++++++++++++++++++
 2 files changed, 71 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_stale_ask.py b/hermes_cli/kanban_stale_ask.py
index a5ea341fc3..02c83eaad4 100644
--- a/hermes_cli/kanban_stale_ask.py
+++ b/hermes_cli/kanban_stale_ask.py
@@ -24,13 +24,24 @@ TERMINAL_HINT = ("\nUse the owner Desktop session's user-terminal flow; opening
 # Every free-text field is a tempered token: it may span lines (a human_request field can) but never
 # another notice's actor line or ask mark, so a stray "Next action for the user:" in prose or a second
 # joined notice cannot pull the text between them into one match. The ask mark must also sit at the
-# start of the line right under block_notice()'s own "blocked — actor:" line.
-_FIELD = r"(?:(?!Next action for the user: |\nblocked — actor: ).)*?"
+# start of the line right under block_notice()'s own "blocked — actor:" line. Each field also stops at
+# the next field's own line mark, so a field can end in one place only: the match is linear (no
+# backtracking across thousands of repeated "\nWhy only the user:" lines) and a field that quotes the
+# next mark makes the notice ambiguous, which leaves it unchanged.
+_STOPS = r"Next action for the user: |\nblocked — actor: "
+
+
+def _field(*marks: str) -> str:
+    return r"(?:(?!" + "|".join([_STOPS, *(re.escape(m) for m in marks)]) + r").)*"
+
+
 _ASK = re.compile(
-    r"(?P<head>blocked — actor: [^\n]*\n)Next action for the user: (?P<action>" + _FIELD + r")\n"
-    r"Why only the user: " + _FIELD + r"\n"
-    r"(?P<rest>Scope: " + _FIELD + r"\nOpen task: @task:(?P<board>[^/@\s]+)(?:@(?P<gw>[^/\s]+))?/(?P<tid>[A-Za-z0-9_-]+))"
-    r"(?P<hint>" + re.escape(TERMINAL_HINT) + r")?",
+    r"(?P<head>blocked — actor: [^\n]*\n)Next action for the user: (?P<action>" + _field("\nWhy only the user: ") + r")\n"
+    r"Why only the user: " + _field("\nScope: ") + r"\n"
+    r"(?P<rest>Scope: " + _field("\nOpen task: ") + r"\nOpen task: @task:(?P<board>[^/@\s]+)(?:@(?P<gw>[^/\s]+))?/(?P<tid>[A-Za-z0-9_-]+))"
+    r"(?P<hint>" + re.escape(TERMINAL_HINT) + r")?"
+    # A second "Open task:" line before the notice ends means a field quoted one: ambiguous, leave it.
+    r"(?!(?:(?!\n\n|blocked — actor: ).)*\nOpen task: )",
     re.DOTALL)
 logger = logging.getLogger(__name__)
 _PT = "America/Los_Angeles"
diff --git a/tests/gateway/test_kanban_stale_block_ask.py b/tests/gateway/test_kanban_stale_block_ask.py
index e16381930f..2c1cfe2c3e 100644
--- a/tests/gateway/test_kanban_stale_block_ask.py
+++ b/tests/gateway/test_kanban_stale_block_ask.py
@@ -182,3 +182,57 @@ def test_unexpected_refresh_error_leaves_the_text_unchanged(tmp_path, monkeypatc
     payload = {"text": text, "local_automation_v1": {"owner": "s"}}
     kanban_stale_ask.refresh_payload(payload)
     assert payload["text"] == text
+
+
+def _card_with_scope(scope):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_db_connect import connect_closing
+    with connect_closing() as conn:
+        tid = kb.create_task(conn, title="scope fixture", assignee="default")
+        assert kb.block_task(conn, tid, kind="needs_input", reason="Choose",
+                             human_request=dict(REQUEST, scope=scope))
+        return tid, kb.get_task(conn, tid)
+
+
+def test_open_task_line_inside_scope_does_not_redirect_the_read(tmp_path, monkeypatch):
+    """Review N1: a scope quoting another card's "Open task:" line must not make the refresh read that card."""
+    from hermes_cli.kanban_stale_ask import refresh_stale_ask
+    done, _text = _stale_notice(tmp_path, monkeypatch)
+    for scope in (f"Only this card.\nOpen task: @task:default/{done}",
+                  f"Only this card.\nOpen task: @task:default/{done}\nand nothing else."):
+        tid, task = _card_with_scope(scope)
+        text = _wake_text(tid, task)
+        assert f"Open task: @task:default/{tid}" in text
+        assert refresh_stale_ask(text) == text  # still blocked on this very ask: byte-identical
+
+
+def test_open_task_line_inside_scope_of_a_done_card_is_left_alone(tmp_path, monkeypatch):
+    """Ambiguous notice (two Open task lines): unchanged, never guessed."""
+    from hermes_cli.kanban_stale_ask import refresh_stale_ask
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    live, _task = _blocked_card()
+    tid, task = _card_with_scope(f"Only this card.\nOpen task: @task:default/{live}")
+    text = _wake_text(tid, task)
+    _finish(tid)
+    assert refresh_stale_ask(text) == text
+
+
+def test_pathological_producer_text_is_bounded(tmp_path, monkeypatch):
+    """Review N2: thousands of field-mark lines after an ask mark cannot cost seconds of regex backtracking."""
+    import time
+    from hermes_cli.kanban_stale_ask import _ASK, refresh_stale_ask
+    _tid, text = _stale_notice(tmp_path, monkeypatch)
+    head = "blocked — actor: user\nNext action for the user: Choose.\n"
+    no_match = (head + "\nWhy only the user: x" * 3000,
+                head + "Why only the user: y\n" + "\nScope: x" * 3000,
+                head + "Why only the user: y\nScope: z" + "\nWhy only the user: x" * 3000)
+    for big in no_match:
+        start = time.monotonic()
+        assert _ASK.search(big) is None
+        assert time.monotonic() - start < 0.5
+    # Inside a real stale notice the repeated lines are just a long field: still fast, still refreshed.
+    big = text.replace("Why only the user: ", "Why only the user: " + "\nWhy only the user: x" * 3000, 1)
+    start = time.monotonic()
+    out = refresh_stale_ask(big)
+    assert time.monotonic() - start < 0.5
+    assert "Since then: unblocked 20:08, completed 20:25 PST. No action needed." in out
-- 
