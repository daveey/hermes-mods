From 623b38d306f8d3f42fa4a6601d075a86a65de636 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 22 Oct 2026 20:14:31 -0700
Subject: [PATCH 218/248] ci: lint workflows with actionlint; move remaining
 auto-triggered jobs off GitHub-hosted runners [daveey]

- New Workflow lint (actionlint.yml) on hermes-hub with its own pull_request/push
  triggers. A workflow GitHub cannot parse now fails a named check on the PR. Before,
  main got a 0-job red run: the #30 duplicate key caused runs 39882449610 and
  39883176284. actionlint 1.7.12 is pinned by sha256. The hermes-hub/docker-ci labels
  and the known non-bugs (cache-mode, bare if: false, an intentional duplicate matrix
  leg) are in .github/actionlint.yaml. Checked locally: it flags the pre-#30
  lockfile-diff.yml and passes on the current tree.
- archive-inputs (push to main on pm/lock.json), label-rerun, plugin-catalog-ci
  and install-e2e-red now run on hermes-hub. GitHub-hosted jobs do not start on this
  account ("recent account payments have failed").
- pm-bundle and windows-bundle-sdk (macOS/Windows only) and the OSV scan (its
  reusable workflow pins ubuntu-latest) skip on the fork. Each has its reason inline.
---
diff --git a/.github/actionlint.yaml b/.github/actionlint.yaml
index f00d40563785a0b731658ad221b2472421898e09..5c2ff7d55ccc6119c526e8b32e502f9f0ab699ef 100644
--- a/.github/actionlint.yaml
+++ b/.github/actionlint.yaml
@@ -15,3 +15,24 @@ self-hosted-runner:
     - blacksmith-32vcpu-windows-2025
     # GitHub larger runners still used by matrices not yet migrated.
     - windows-latest-32-arm-core
+    # fork (daveey/hermes): self-hosted runners on hermes-hub
+    # (scripts/fork-ci-runner.sh).
+    - hermes-hub
+    - docker-ci
+
+# fork (daveey/hermes): known findings that are not bugs. The lint runs in
+# .github/workflows/actionlint.yml. Keep each pattern narrow.
+paths:
+  .github/workflows/**/*.{yml,yaml}:
+    ignore:
+      # `cache-mode` is a real job key (workflow syntax,
+      # jobs.<job_id>.cache-mode) that actionlint 1.7.12 does not know yet.
+      - 'unexpected key "cache-mode" for "job" section'
+      # A bare `if: false` switches off a lane that has no runner here
+      # (macOS/Windows) or is deferred upstream; ci.yaml says why it must
+      # stay a bare constant.
+      - 'constant expression "false" in condition'
+  .github/workflows/windows-bundle-sdk.yml:
+    ignore:
+      # Upstream runs the cold Windows ARM64 SDK leg twice on purpose.
+      - 'duplicate value "windows-latest-32-arm-core" is found in matrix "runner"'
diff --git a/.github/workflows/actionlint.yml b/.github/workflows/actionlint.yml
new file mode 100644
index 0000000000000000000000000000000000000000..3963a872d2609ed4998c29c5d424104b17cad7f6
--- /dev/null
+++ b/.github/workflows/actionlint.yml
@@ -0,0 +1,59 @@
+name: Workflow lint
+
+# fork (daveey/hermes): lints every workflow file with actionlint.
+#
+# A workflow file GitHub cannot parse never starts a single job. On main that
+# looked like a silent red run with 0 jobs ("This run likely failed because of
+# a workflow file issue"): a duplicate key in lockfile-diff.yml stopped every
+# CI run on main (runs 39882449610, 39883176284) until #30. This workflow has
+# its own triggers on purpose. It is NOT called from ci.yaml, so a broken
+# ci.yaml or a broken callee still gets a named, failing check on the PR.
+#
+# Scope: workflow structure, expressions, contexts, needs/outputs and runner
+# labels. shellcheck and pyflakes on `run:` scripts are off: they flag style
+# in upstream scripts that this fork does not own. Exceptions live in
+# .github/actionlint.yaml, each with its reason.
+
+on:
+  pull_request:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: actionlint-${{ github.ref == 'refs/heads/main' && github.run_id || github.ref }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
+jobs:
+  actionlint:
+    name: actionlint
+    runs-on: [self-hosted, hermes-hub]
+    timeout-minutes: 5
+    env:
+      ACTIONLINT_VERSION: 1.7.12
+      ACTIONLINT_SHA256: 8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
+    steps:
+      - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          persist-credentials: false
+
+      - name: Install pinned actionlint
+        run: |
+          set -euo pipefail
+          tarball="actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz"
+          dest="$RUNNER_TEMP/actionlint"
+          mkdir -p "$dest"
+          curl -fsSL --retry 3 -o "$dest/$tarball" \
+            "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/${tarball}"
+          echo "${ACTIONLINT_SHA256}  $dest/$tarball" | sha256sum -c -
+          tar -xzf "$dest/$tarball" -C "$dest" actionlint
+          echo "$dest" >> "$GITHUB_PATH"
+
+      - name: Lint every workflow
+        # One ::error annotation per finding, so the PR shows file and line.
+        run: |
+          actionlint -shellcheck= -pyflakes= \
+            -format '{{range $err := .}}::error file={{$err.Filepath}},line={{$err.Line}},col={{$err.Column}}::{{$err.Message}} [{{$err.Kind}}]\n{{end}}'
diff --git a/.github/workflows/osv-scanner.yml b/.github/workflows/osv-scanner.yml
index 11928250d5d0a4a298bad941b43ceafb8fd94dd0..bea30e0aa428c34f3a6cdccde6000c8629d95d18 100644
--- a/.github/workflows/osv-scanner.yml
+++ b/.github/workflows/osv-scanner.yml
@@ -37,6 +37,9 @@ permissions:
 jobs:
   scan:
     name: Scan lockfiles
+    # fork (daveey/hermes): the reusable workflow pins ubuntu-latest and
+    # GitHub-hosted runners do not start on this account; Dependabot covers it.
+    if: github.repository != 'daveey/hermes'
     uses: google/osv-scanner-action/.github/workflows/osv-scanner-reusable.yml@9a498708959aeaef5ef730655706c5a1df1edbc2 # v2.3.8
     with:
       # Scan explicit lockfiles rather than recursing, so we only look at
diff --git a/.github/workflows/pm-bundle.yml b/.github/workflows/pm-bundle.yml
index 62b990cacc84366c1b44190ffcf883830dda4b8e..07ed1bf417c4bd5d7e92010f2323a8bb4e9a7996 100644
--- a/.github/workflows/pm-bundle.yml
+++ b/.github/workflows/pm-bundle.yml
@@ -57,6 +57,9 @@ concurrency:
 jobs:
   bundle:
     name: bundle ${{ matrix.target.label }}
+    # fork (daveey/hermes): only self-hosted Linux runners (hermes-hub, docker-ci);
+    # GitHub-hosted runners do not start on this account, so these legs skip here.
+    if: github.repository != 'daveey/hermes'
     runs-on: ${{ matrix.target.runner }}
     # Leave time for setup, cache saves and smoke tests around the wheel build.
     timeout-minutes: 180
diff --git a/.github/workflows/windows-bundle-sdk.yml b/.github/workflows/windows-bundle-sdk.yml
index a1f510de7d5bb2a3b44404139a1d9f200bccbc7e..116bcfa394ce5965e82bcc000ec8fb2ab4388429 100644
--- a/.github/workflows/windows-bundle-sdk.yml
+++ b/.github/workflows/windows-bundle-sdk.yml
@@ -23,6 +23,9 @@ concurrency:
 jobs:
   windows-bundle-tools:
     name: Cold Windows SDK (${{ matrix.runner }})
+    # fork (daveey/hermes): only self-hosted Linux runners (hermes-hub, docker-ci);
+    # GitHub-hosted runners do not start on this account, so these legs skip here.
+    if: github.repository != 'daveey/hermes'
     runs-on: ${{ matrix.runner }}
     # Cold ARM64 npm extraction alone can exceed 15 minutes on the hosted runner.
     timeout-minutes: 45
-- 
