+            payload["comment_uid"] = row["uid"]
         if not system:
             payload.update(writer_provenance(conn, task_id))  # writer_run_id + portable writer_run_uid
         if writer_kind:
diff --git a/hermes_cli/kanban_release_comments.py b/hermes_cli/kanban_release_comments.py
index fe7d26bd42d52af69ad5a7387a837fe9942f519e..29b36105f90e6419cdb43abf81bfa5a1f520e39c 100644
--- a/hermes_cli/kanban_release_comments.py
+++ b/hermes_cli/kanban_release_comments.py
@@ -1,6 +1,7 @@
 """Unread-thread policy for manual release surfaces, never autonomous DB callers. [daveey]"""
 from __future__ import annotations
 
+import json
 import os
 import shlex
 import time
@@ -24,28 +25,59 @@ class UnreadComments(Exception):
 
 def check(conn, tid, *, session, seen=None, verb="unblock", board=None):
     """Called under the status writer's lock; exceptions leave events/comments unchanged."""
-    rows = conn.execute(
-        "SELECT c.id, c.body, e.created_at, json_extract(e.payload, '$.writer_session') AS writer "
-        "FROM task_events e JOIN task_comments c ON c.task_id=e.task_id "
-        "AND c.id=json_extract(e.payload, '$.comment_id') "
-        "WHERE e.task_id=? AND e.kind='commented' "
-        "AND coalesce(json_extract(e.payload, '$.writer_session'), '') != '' "
-        "AND json_extract(e.payload, '$.writer_session') != ? "
-        "AND ((? IS NOT NULL AND c.id > ?) OR (? IS NULL AND e.created_at >= ?)) "
-        "ORDER BY c.id", (tid, session or "", seen, seen, seen, int(time.time()) - 3600),
+    events = conn.execute(
+        "SELECT * FROM task_events WHERE task_id=? AND kind='commented' "
+        "AND coalesce(json_extract(payload, '$.writer_session'), '') != '' "
+        "AND json_extract(payload, '$.writer_session') != ? "
+        "AND (? IS NOT NULL OR created_at >= ?)",
+        (tid, session or "", seen, int(time.time()) - 3600),
     ).fetchall()
-    if not rows:
+    if not events:
         return
-    comments = [{"id": r["id"], "writer_session": r["writer"],
-                 "time": datetime.fromtimestamp(r["created_at"], UTC).isoformat(),
-                 "body": r["body"][:300]} for r in rows]
+    rows = conn.execute("SELECT * FROM task_comments WHERE task_id=? ORDER BY id", (tid,)).fetchall()
+    comments = []
+    for event in events:
+        payload = json.loads(event["payload"])
+        candidates = _resolve(rows, event, payload)
+        if not candidates:
+            # A partial sync must not turn missing comment data into permission.
+            comments.append(_listing(None, "Comment data unavailable; wait for sync and read again. --seen cannot "
+                                     "acknowledge missing data.", event, payload))
+        for row in candidates:
+            if seen is None or row["id"] > seen:
+                comments.append(_listing(row["id"], row["body"], event, payload))
+    if not comments:
+        return
+    comments = list({(r["id"], r["writer_session"]): r for r in comments}.values())
     command = ["hermes", "kanban"]
     if board:
         command += ["--board", board]
-    command += [verb, tid, "--seen", str(max(r["id"] for r in rows))]
+    newest = max((r["id"] for r in comments if r["id"] is not None), default=seen or 0)
+    command += [verb, tid, "--seen", str(newest)]
     raise UnreadComments(comments, shlex.join(command))
 
 
+def _listing(cid, body, event, payload):
+    return {"id": cid, "writer_session": payload["writer_session"],
+            "time": datetime.fromtimestamp(event["created_at"], UTC).isoformat(), "body": body[:300]}
+
+
+def _resolve(rows, event, payload):
+    """Never compare a wire-local integer with a receiver's watermark.
+
+    Legacy synced events have no portable reference. Require acknowledgement of
+    every plausible same-time/author row rather than guess among collisions.
+    The timestamp tolerance covers the writer crossing a second between inserts;
+    body length cannot disambiguate because add_comment strips stored text.
+    """
+    if payload.get("comment_uid"):
+        return [r for r in rows if "uid" in r.keys() and r["uid"] == payload["comment_uid"]]
+    if rows and "uid" not in rows[0].keys():  # never-synced board: IDs are local
+        return [r for r in rows if r["id"] == payload.get("comment_id")]
+    return [r for r in rows if abs(r["created_at"] - event["created_at"]) <= 1
+            and (not payload.get("author") or r["author"] == payload["author"].strip())]
+
+
 def cli_guard(args, tid, verb):
     """Build a transactional precondition using the CLI's inherited caller identity."""
     return lambda conn: check(conn, tid, session=os.environ.get("HERMES_SESSION_ID"),
diff --git a/tests/hermes_cli/test_kanban_release_imported_comments.py b/tests/hermes_cli/test_kanban_release_imported_comments.py
new file mode 100644
index 0000000000000000000000000000000000000000..7932924e701de51483dc2105b7f52c95817812ec
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_release_imported_comments.py
@@ -0,0 +1,126 @@
+"""Release watermarks use local IDs even when comment events came from a peer. [daveey]"""
+import json
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_sync as sync
+from tests.hermes_cli.test_kanban_release_unread_comments import board as _board, comment, release, snapshot
+
+board = _board  # Re-export the shared fixture without shadowing an imported name.
+
+
+def enable_sync(tid):
+    from hermes_constants import get_hermes_home
+    from tests.hermes_cli.kanban_sync_support import write_sync_config
+    write_sync_config(get_hermes_home(), True)
+    kb._INITIALIZED_PATHS.clear()
+    with kbc.connect_closing() as conn:
+        sync.apply_sync_schema_steps(conn)
+        sync.set_mode(conn, "shadow")
+        sync.set_identity(conn, "test-board", "owner")
+        with kbc.write_txn(conn):
+            conn.execute("UPDATE tasks SET created_on=? WHERE id=?", ("owner", tid))
+
+
+def imported(tid, source_id, *, portable=True, age=180, session="peer-session", suffix="one"):
+    now = int(time.time()) - age
+    uid = "remote-comment-" + suffix
+    payload = {"comment_id": source_id, "writer_session": session, "writer_kind": "agent"}
+    if portable:
+        payload["comment_uid"] = uid
+    changes = [
+        sync.RemoteChange(1, "task_comments", uid, "upsert",
+                          {"task_id": tid, "author": "default", "body": "Retracted: do not release " + suffix,
+                           "created_at": now}, 1, "", "peer"),
+        sync.RemoteChange(2, "task_events", "remote-event-" + suffix, "upsert",
+                          {"task_id": tid, "kind": "commented", "created_at": now,
+                           "payload": json.dumps(payload)}, 1, "", "peer"),
+    ]
+    with kbc.connect_closing() as conn:
+        assert sync.apply_remote_changes(conn, changes, new_cursor=2, observers=False).applied == 2
+        cid = conn.execute("SELECT id FROM task_comments WHERE uid=?", (uid,)).fetchone()[0]
+        from hermes_cli.kanban_foreign_card import refusal
+        assert refusal(conn, tid) is None
+    return cid
+
+
+@pytest.mark.parametrize("entry", ["promote", "unblock", "tool"])
+@pytest.mark.parametrize("portable", [True, False])
+@pytest.mark.parametrize("collision", [True, False])
+def test_imported_owner_release_acknowledges_local_id(board, entry, portable, collision, capsys):
+    enable_sync(board)
+    older = comment(board, session="reader", age=300, body="Already read local note")
+    cid = imported(board, older if collision else 900001, portable=portable)
+    assert cid != older
+    before = snapshot(board)
+    for seen in (None, older):
+        ok, output = release(board, entry, capsys, seen)
+        assert not ok, output
+        assert "unread_comments" in output and "Retracted: do not release" in output
+        assert f"--seen {cid}" in output
+        assert "Already read local note" not in output
+        assert snapshot(board) == before
+    ok, output = release(board, entry, capsys, cid)
+    assert ok, output
+
+
+@pytest.mark.parametrize("portable", [True, False])
+@pytest.mark.parametrize("session,age", [("reader", 180), (None, 180), ("peer-session", 3660)])
+def test_imported_policy_exceptions(board, portable, session, age, capsys):
+    enable_sync(board)
+    imported(board, 900001, portable=portable, session=session, age=age)
+    ok, output = release(board, "promote", capsys)
+    assert ok, output
+
+
+@pytest.mark.parametrize("portable", [True, False])
+def test_imported_explicit_watermark_has_no_age_limit(board, portable, capsys):
+    enable_sync(board)
+    older = comment(board, session="reader", age=8000)
+    cid = imported(board, 900001, portable=portable, age=7200)
+    ok, output = release(board, "promote", capsys, older)
+    assert not ok and f"--seen {cid}" in output
+    ok, output = release(board, "promote", capsys, cid)
+    assert ok, output
+
+
+@pytest.mark.parametrize("portable", [True, False])
+def test_missing_imported_comment_is_not_acknowledged_by_colliding_id(board, portable, capsys):
+    enable_sync(board)
+    older = comment(board, session="reader", age=300)
+    cid = imported(board, older, portable=portable)
+    with kbc.connect_closing() as conn:
+        with kbc.write_txn(conn):
+            conn.execute("DELETE FROM task_comments WHERE id=?", (cid,))
+    before = snapshot(board)
+    for seen in (None, older, cid):
+        ok, output = release(board, "promote", capsys, seen)
+        assert not ok and "Comment data unavailable" in output
+        assert snapshot(board) == before
+    restored = imported(board, older, portable=portable)
+    ok, output = release(board, "promote", capsys)
+    assert not ok and "Retracted: do not release" in output
+    ok, output = release(board, "promote", capsys, restored)
+    assert ok, output
+
+
+def test_writer_stamps_actual_comment_uid(board):
+    enable_sync(board)
+    cid = comment(board)
+    with kbc.connect_closing() as conn:
+        uid = conn.execute("SELECT uid FROM task_comments WHERE id=?", (cid,)).fetchone()[0]
+        payload = json.loads(conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='commented'",
+                                          (board,)).fetchone()[0])
+    assert uid and payload["comment_uid"] == uid
+
+
+def test_legacy_ambiguous_same_second_lists_all_candidates(board, capsys, monkeypatch):
+    monkeypatch.setattr(time, "time", lambda: 1794700000)
+    enable_sync(board)
+    first = imported(board, 800001, portable=False, suffix="first")
+    second = imported(board, 800002, portable=False, suffix="second")
+    ok, output = release(board, "promote", capsys, first)
+    assert not ok and "do not release second" in output
+    ok, output = release(board, "promote", capsys, second)
+    assert ok, output
