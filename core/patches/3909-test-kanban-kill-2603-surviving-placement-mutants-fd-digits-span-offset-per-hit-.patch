From f8716be6da613f3b7ce996dba443ab7a6af92b71 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:36:57 +0000
Subject: [PATCH] test(kanban): kill #2603 surviving placement mutants (fd
 digits, span offset, per-hit span, last .hermes/) [daveey]

Post-merge check t_01a1d6c5e0bc2fbb found PR #2603 (f77225df88) mutants that survived
the PR test file and 12 placement suites. This adds only test rows to
tests/hermes_cli/test_kanban_state_path_home_forms.py, one per mutant:

- M3 kanban_placement._REDIR `\d+>` -> `\d>`: `cd ~ 12>/dev/null && cat .hermes/.env`
  and `cd 12>/dev/null && cat .hermes/.env` must still be state paths.
- M4 _last_rel_state without re.IGNORECASE: `cd ~ && cat .HERMES/.env` names
  `~/.HERMES/.env` (already killed on main by 0bebc403ff's .HERMES/logs row;
  the card's exact input is pinned too).
- M5 first vs last `.hermes/` in a span (the card called it probe-equivalent):
  NOT equivalent. A span can hold two `.hermes/` when the first is a code tree
  or a non-home `.hermes` (`cd ~ && cat .hermes/hermes-agent/x .hermes/.env`,
  `cd ~ && cat src/.hermes/x .hermes/logs/y.log`); the first one names
  `~/.hermes/hermes-agent/x` / `~/.hermes/x` instead of the real state path.
- M6 offset `match.start() + last[0]` -> `last[0]`: a span starting mid-text
  (`echo hi; cd ~ && make all && cat .hermes/logs/x.log`).
- M7 per-hit `_last_rel_state(m)` -> `(match)`: two cd-home spans yield two
  verdicts, the second an artifact-not-here hit.

Proof (worker-7, mutant runner swapping each mutant in and running this file
with the new tests and with origin/main's copy):
  M3: new=FAIL main=PASS
  M4: new=FAIL main=FAIL (already killed)
  M5: new=FAIL main=PASS
  M6: new=FAIL main=PASS
  M7: new=FAIL main=PASS
Unmutated: the file passes; scripts/check --base origin/main ok.
---
 .../test_kanban_state_path_home_forms.py      | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_state_path_home_forms.py b/tests/hermes_cli/test_kanban_state_path_home_forms.py
index 01bf8a6481..49111ff340 100644
--- a/tests/hermes_cli/test_kanban_state_path_home_forms.py
+++ b/tests/hermes_cli/test_kanban_state_path_home_forms.py
@@ -90,6 +90,9 @@ def test_tilde_root_path_still_clears(attested):
     "cd ~ 2>/dev/null && cat .hermes/.env",
     "cd $HOME 2>&1 >/dev/null; cat .hermes/.env",
     "cd ~ &>/dev/null && cat .hermes/.env",
+    # A multi-digit fd (``12>``) is a redirect too, after a home word or a bare cd.
+    "cd ~ 12>/dev/null && cat .hermes/.env",
+    "cd 12>/dev/null && cat .hermes/.env",
     # PR #2603 review nit 1: a bare cd with only redirects (and no operand after them) still goes home.
     "cd 2>/dev/null && cat .hermes/.env",
     "cd >/dev/null; cat .hermes/.env",
@@ -150,6 +153,13 @@ def test_many_cd_home_lines_without_a_state_path_scan_in_linear_time():
      "~/.hermes/kanban/workspaces/t_x/f"),
     # The state-path rule is case-insensitive, so an upper-case relative path is still named as its ``~/`` path.
     ("cd ~ && cat .HERMES/logs/x.log", "b", "~/.HERMES/logs/x.log"),
+    ("cd ~ && cat .HERMES/.env", "b", "~/.HERMES/.env"),
+    # A span that starts mid-text: the ``.hermes/`` offset is taken in the span, so it must be shifted by its start.
+    ("echo hi; cd ~ && make all && cat .hermes/logs/x.log", "b", "~/.hermes/logs/x.log"),
+    # A span holding two ``.hermes/``: the first is a code tree or a non-home ``.hermes``, so the span's last one names
+    # the state path.
+    ("cd ~ && cat .hermes/hermes-agent/x .hermes/.env", "b", "~/.hermes/.env"),
+    ("cd ~ && cat src/.hermes/x .hermes/logs/y.log", "b", "~/.hermes/logs/y.log"),
 ])
 def test_relative_state_path_hit_is_the_home_path_not_the_cd_span(body, cls, path, tmp_path, monkeypatch):
     from hermes_cli import kanban_home_marker_placement as hm
@@ -159,3 +169,15 @@ def test_relative_state_path_hit_is_the_home_path_not_the_cd_span(body, cls, pat
     [(decision, got_cls, hit, labels, note)] = hm._state_path(kp.HERMES_STATE_PATH, match, "worker-2", hm._Probe())
     assert (decision, got_cls, hit, labels) == ("queue", cls, path, ("capability:hub-write",))
     assert "make all" not in note
+
+
+def test_each_cd_home_span_names_its_own_relative_state_path(tmp_path, monkeypatch):
+    # Two cd-home spans: each is named from its own span (and its own offset), so the second span's workspace
+    # artifact is a hit of its own, not lost behind the first span's path.
+    from hermes_cli import kanban_home_marker_placement as hm
+
+    monkeypatch.setenv("HOME", str(tmp_path))
+    body = "cd ~ && cat .hermes/logs/x.log; cd ~ && cat .hermes/kanban/workspaces/t_x/f"
+    got = [v[:3] for v in hm._state_path(kp.HERMES_STATE_PATH, _hit(body), "worker-2", hm._Probe())]
+    assert got == [("queue", "b", "~/.hermes/logs/x.log"),
+                   ("queue", "artifact-not-here", "~/.hermes/kanban/workspaces/t_x/f")]
