From 5c5b105619a84528d834d206ca98efb9c7ade707 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 22:40:41 +0000
Subject: [PATCH] test(kanban): freeze containment retention cutoff without
 wall sleep [daveey]

---
 hermes_cli/kanban_transfer.py                         | 4 ++--
 tests/hermes_cli/test_kanban_containment_retention.py | 5 +++--
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/hermes_cli/kanban_transfer.py b/hermes_cli/kanban_transfer.py
index c09fdae73c12a2cb9c2f54e3048ad3eb44b0bdd1..3c122c15e73a5923401d571a8e5df67e4fd119ed 100644
--- a/hermes_cli/kanban_transfer.py
+++ b/hermes_cli/kanban_transfer.py
@@ -68,11 +68,11 @@ def _snapshot_db(source: Path, target: Path) -> None:
 
 
 def _scrub_local_state(conn: sqlite3.Connection) -> None:
-    from hermes_cli.kanban_containment_guard import inert_snapshot
-    inert_snapshot(conn)
     """Strip machine-local runtime state (claims, PIDs, and above all the
     gateway chat ids subscribed to task events). Caller owns the transaction.
     Run on export and again on import (an archive is untrusted input)."""
+    from hermes_cli.kanban_containment_guard import inert_snapshot
+    inert_snapshot(conn)
     conn.execute("DELETE FROM kanban_notify_subs")
     conn.execute(
         """
diff --git a/tests/hermes_cli/test_kanban_containment_retention.py b/tests/hermes_cli/test_kanban_containment_retention.py
index af337e11dd64ca02cdc86318cc88ccc1f529ee3a..caeeac37d305fa28dc59813b46aadea623679af8 100644
--- a/tests/hermes_cli/test_kanban_containment_retention.py
+++ b/tests/hermes_cli/test_kanban_containment_retention.py
@@ -26,14 +26,15 @@ def _protected(conn, task):
                         "('contained','containment_released')", (task,)).fetchone()[0]
 
 
-def test_gc_events_prunes_board_and_retains_protected_history(board):
+def test_gc_events_prunes_board_and_retains_protected_history(board, monkeypatch):
     relay = _released_done(board)
     other = kb.create_task(board, title="Unrelated", assignee="default")
     assert kb.claim_task(board, other, claimer="default")
     assert kb.complete_task(board, other, summary="done")
     before = _protected(board, relay)
     assert before == 2
-    time.sleep(1.2)
+    cutoff = time.time() + 10
+    monkeypatch.setattr(kb.time, "time", lambda: cutoff)
     assert kb.gc_events(board, older_than_seconds=0) > 0
     assert board.execute("SELECT COUNT(*) FROM task_events WHERE task_id=?", (other,)).fetchone()[0] == 0
     assert _protected(board, relay) == before
-- 
2.43.0

