Date: Wed, 28 Oct 2026 05:56:48 +0000
Subject: [PATCH] fix(tests): real-home guard allows reads of the checkout's
 own install-stamp/owner-facts probes (checkout under scratch TMPDIR) [daveey]

---
 tests/hermes_cli/test_real_home_tripwire.py | 21 +++++++++++++++++++
 tests/home_io_guard.py                      | 23 ++++++++++++++++++++-
 2 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_cli/test_real_home_tripwire.py b/tests/hermes_cli/test_real_home_tripwire.py
index 17af02b774..8b6063de7c 100644
--- a/tests/hermes_cli/test_real_home_tripwire.py
+++ b/tests/hermes_cli/test_real_home_tripwire.py
@@ -216,6 +216,27 @@ def test_payload_manifest_beside_a_guarded_checkout_is_readable_not_writable():
         guard.check(PROJECT_ROOT.parent / "manifest.json.bak")
 
 
+def test_checkout_identity_probes_are_readable_not_writable():
+    """pm.environments.store_root walks the checkout and every ancestor for ``install-stamp.json``;
+    owning_home_root reads ``<checkout parent>/installs/<key>/facts.json``. With the checkout in a
+    guarded root (a worktree under the scratch TMPDIR, or the live install) those reads are the
+    checkout's own probes: allowed. Writes and other siblings stay refused."""
+    from tests.home_io_guard import HomeIOGuard
+
+    guard = HomeIOGuard(lambda: [PROJECT_ROOT.parent])
+    stamp = PROJECT_ROOT.parent / "install-stamp.json"
+    facts = PROJECT_ROOT.parent / "installs" / "abc123" / "facts.json"
+    guard.check(stamp)
+    guard.check(facts)
+    for path in (stamp, facts):
+        with pytest.raises(AssertionError, match="REAL hermes home"):
+            guard.check(path, destructive=True)
+    with pytest.raises(AssertionError, match="REAL hermes home"):
+        guard.check(PROJECT_ROOT.parent / "installs" / "abc123" / "other.json")
+    with pytest.raises(AssertionError, match="REAL hermes home"):
+        guard.check(PROJECT_ROOT.parent / "install-stamp.json.bak")
+
+
 def test_hermes_exported_scratch_tmp_is_not_the_test_temp_root(tmp_path):
     """A Hermes-launched shell hands pytest TMPDIR=<home>/cache/scratch (tagged by
     HERMES_SCRATCH_DIR). With that home guarded, honoring it would put the session
diff --git a/tests/home_io_guard.py b/tests/home_io_guard.py
index 4d55c1dced..2c9f162857 100644
--- a/tests/home_io_guard.py
+++ b/tests/home_io_guard.py
@@ -52,6 +52,27 @@ _INTERPRETER_PREFIX_STRS = tuple(_normcase(os.fspath(p)) for p in _INTERPRETER_P
 # guarded root (default install ``~/.hermes/hermes-agent``, or a worktree under ~/.hermes/cache) that
 # read is the checkout asking "am I a payload?", not Hermes state. Reads only; writes stay refused.
 _PAYLOAD_MANIFEST_STR = _normcase(os.fspath(Path(__file__).resolve().parent.parent.parent / "manifest.json"))
+# The same checkout also asks "am I stamped?" (pm.environments.store_root walks the checkout and
+# every ancestor looking for ``install-stamp.json``) and "does my parent root own me?"
+# (owning_home_root reads ``<checkout parent>/installs/<key>/facts.json``). A checkout inside a
+# guarded root -- the live ``~/.hermes/hermes-agent``, or a worktree under the Hermes scratch dir
+# (the TMPDIR Hermes workers export) -- makes those probes land in the home. Reads only.
+_CHECKOUT_ROOT = Path(__file__).resolve().parent.parent
+_STAMP_PROBE_STRS = frozenset(
+    _normcase(os.fspath(d / "install-stamp.json")) for d in (_CHECKOUT_ROOT, *_CHECKOUT_ROOT.parents)
+)
+_OWNER_FACTS_DIR_STR = _normcase(os.fspath(_CHECKOUT_ROOT.parent / "installs"))
+
+
+def _is_checkout_probe(absolute: str) -> bool:
+    """A normalized absolute path the checkout reads to learn its own identity or owner."""
+    if absolute == _PAYLOAD_MANIFEST_STR or absolute in _STAMP_PROBE_STRS:
+        return True
+    prefix = _OWNER_FACTS_DIR_STR + os.sep
+    if absolute.startswith(prefix):
+        parts = absolute[len(prefix):].split(os.sep)
+        return len(parts) == 2 and parts[1] == "facts.json"
+    return False
 
 
 def _within(path: str, prefix: str) -> bool:
@@ -102,7 +123,7 @@ class HomeIOGuard:
             # which is not I/O against the home.
             if metadata and (absolute == "/proc" or absolute.startswith("/proc" + os.sep)):
                 return
-            if absolute == _PAYLOAD_MANIFEST_STR and not destructive:
+            if not destructive and _is_checkout_probe(absolute):
                 return
             resolved = self._refuse_installed_app_change(value, absolute) if destructive else None
             roots = tuple(_normcase(os.fspath(r)) for r in self.roots())
