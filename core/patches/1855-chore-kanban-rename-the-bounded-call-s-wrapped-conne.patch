From 72b3be808b073f6908c4a6169a5bccefc27daf68 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 3 Nov 2026 08:56:37 +0000
Subject: [PATCH] chore(kanban): rename the bounded call's wrapped connect so
 the websockets HX015 rule does not misfire on an http.client connect [daveey]

---
 hermes_cli/kanban_sync_client.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/hermes_cli/kanban_sync_client.py b/hermes_cli/kanban_sync_client.py
index 01a53a038a9..78e6ef26fae 100644
--- a/hermes_cli/kanban_sync_client.py
+++ b/hermes_cli/kanban_sync_client.py
@@ -191,10 +191,10 @@ def _bounded_call(ident: Identity, method: str, path: str, body: Optional[dict],
         def _connection(self, parts, timeout=None):
             pair = super()._connection(parts, timeout)
             conn = pair[0]
-            connect = conn.connect
+            open_socket = conn.connect
 
             def connect_then_check() -> None:
-                connect()
+                open_socket()
                 with expiry:
                     if box.get("expired"):
                         cut(conn)
-- 
2.55.0

