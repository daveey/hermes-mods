From c45c7f9263d452bb0feb50675cc1f7877570b6b9 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:13:31 +0000
Subject: [PATCH] [daveey] Scan implicit recursive arithmetic and declaration
 subscripts

Address review 5908036954: declaration NAME subscripts evaluate without -i; parameter indices, substring offsets, indexed assignments, legacy arithmetic and [[ -v indexed-name ]] recursively evaluate earlier assignments. Preserve quoted/escaped expansion examples and plain declaration values as data. Real Bash: five declaration and seven implicit-site tests RED before their respective fixes; 2349 lifecycle tests GREEN and 20 scripts/check checks OK.
---
 cron/lifecycle_guard_arith_words.py           | 41 +++++++++++++++++--
 .../test_lifecycle_guard_name_indirection.py  | 21 ++++++++++
 2 files changed, 59 insertions(+), 3 deletions(-)

diff --git a/cron/lifecycle_guard_arith_words.py b/cron/lifecycle_guard_arith_words.py
index 89b5c20b6bb1d41104892c22a148a45f293e21a7..d985e91ccd209a8739157eab11088805f203e04d 100644
--- a/cron/lifecycle_guard_arith_words.py
+++ b/cron/lifecycle_guard_arith_words.py
@@ -50,7 +50,10 @@ def _integer_declaration(arguments: list[str]) -> bool:
 def _name_taking_mode(name: str, arguments: list[str]) -> bool:
     return name in {"unset", "read", "mapfile", "readarray"} or (
         name in {"test", "[", "printf"} and "-v" in arguments
-    ) or (name == "wait" and "-p" in arguments)
+    ) or (name == "wait" and "-p" in arguments) or (
+        name in _INTEGER_DECLARERS
+        and any("[" in argument.split("=", 1)[0] for argument in arguments)
+    )
 
 
 def _arithmetic_operands(segment: list[str]) -> Iterator[str]:
@@ -82,6 +85,11 @@ def _recursive_arithmetic_segment(segment: list[str]) -> bool:
 
     words = segment[guard._peel_reserved_words(segment):]
     index = guard._executed_command_index(words)
+    # A compound initializer is segmented as `a+=`, `[x]=1`; its indexed
+    # member is an arithmetic site too. Do not inspect ordinary command argv.
+    prefix = words if index is None else words[:index + 1]
+    if any(re.match(r"(?:[A-Za-z_]\w*)?\[.*\]\+?=", word) for word in prefix):
+        return True
     if index is None:
         return False
     name = guard._executable_name(words[index])
@@ -89,7 +97,8 @@ def _recursive_arithmetic_segment(segment: list[str]) -> bool:
     # NAME subscripts recursively evaluate variables just like explicit arithmetic.
     # A plain NAME does not: `read x` must not activate earlier data assignments.
     return name == "let" or (
-        name == "[[" and any(token in _INT_OPERATORS for token in arguments)
+        name == "[[" and (any(token in _INT_OPERATORS for token in arguments)
+                          or ("-v" in arguments and any("[" in token for token in arguments)))
     ) or (
         _name_taking_mode(name, arguments) and any("[" in token for token in arguments)
     )
@@ -108,6 +117,32 @@ def _indirect_assignment_words(segment: list[str]) -> Iterator[str]:
             yield from words[index + 1:]
 
 
+def _implicit_arithmetic_expansion(command: str) -> bool:
+    """Recognize active legacy arithmetic, parameter indices and substring offsets.
+
+    This is only a context prefilter, not an evaluator. Preserve shell quoting so
+    literal examples in printf/echo do not activate unrelated data assignments.
+    """
+    tokens = re.compile(r'''\\.|'|"|\$\$|\$\[|\$\{[#!]?(?:[A-Za-z_]\w*|\d+|[@*#?$!-])(?:\[|:(?![-=?+]))''')
+    quoted = False
+    pos = 0
+    while match := tokens.search(command, pos):
+        token = match.group()
+        pos = match.end()
+        if token.startswith("\\") or token == "$$":
+            continue
+        if token == '"':
+            quoted = not quoted
+        elif token == "'" and not quoted:
+            close = command.find("'", pos)
+            if close < 0:
+                return True  # uncertain shell syntax: fail towards scanning
+            pos = close + 1
+        elif token.startswith("$"):
+            return True
+    return False
+
+
 def iter_arithmetic_word_payloads(command: str) -> Iterator[str]:
     """Yield dequoted arithmetic operands of *command* whose subscript may run a substitution."""
     from cron import lifecycle_guard as guard
@@ -125,7 +160,7 @@ def iter_arithmetic_word_payloads(command: str) -> Iterator[str]:
     # Arithmetic recursively evaluates variable values. Recover earlier dequoted
     # assignments too, not just the word at the evaluation site. Preserve argv
     # boundaries so a quoted shell program or echo argument is not an assignment.
-    recursive_text = "((" in command or any(
+    recursive_text = "((" in command or _implicit_arithmetic_expansion(command) or any(
         _recursive_arithmetic_segment(segment) for segment in segments
     )
     for segment in segments:
diff --git a/tests/cron/test_lifecycle_guard_name_indirection.py b/tests/cron/test_lifecycle_guard_name_indirection.py
index 820e568863ba08f65289377bf0c35bc87345c748..ff1fcbc6347f60fd1a5fd7b8007fc5feeaf503ab 100644
--- a/tests/cron/test_lifecycle_guard_name_indirection.py
+++ b/tests/cron/test_lifecycle_guard_name_indirection.py
@@ -7,6 +7,19 @@ from tests.cron.test_lifecycle_guard_arith_escaped_words import _run_bash
 
 
 SHAPES = [
+    "declare 'a[$(SCRIPT)]=1'",
+    r"declare a[\$\(SCRIPT\)]=1",
+    "declare -a 'a[$(SCRIPT)]=1'",
+    "typeset 'a[$(SCRIPT)]=1'",
+    "f() { local 'a[$(SCRIPT)]=1'; }; f",
+    "x='a[$(SCRIPT)]'; echo ${a[x]}",
+    "x='a[$(SCRIPT)]'; a[x]=1",
+    "x='a[$(SCRIPT)]'; a+=([x]=1)",
+    "x='a[$(SCRIPT)]'; s=hello; echo ${s:x}",
+    "x='a[$(SCRIPT)]'; set -- hi; echo ${@:x}",
+    "x='a[$(SCRIPT)]'; echo $[x]",
+    "x='a[$(SCRIPT)]'; [[ -v a[x] ]]",
+    "x='a[$(SCRIPT)]'; declare 'a[x]=1'",
     "test -v 'a[$(SCRIPT)]'",
     r"test -v a[\$\(SCRIPT\)]",
     "[ -v 'a[$(SCRIPT)]' ]",
@@ -58,6 +71,14 @@ def test_name_and_indirection_scripts_are_scanned(tmp_path, shape):
     r"test -n a[\$\(SCRIPT\)]",
     r"echo 'x=a[$(SCRIPT)]'; echo $((1))",
     r"printf '%s' 'x=a[$(SCRIPT)]; ((x))'",
+    "x='a[$(SCRIPT)]'; echo '${a[x]}'",
+    "x='a[$(SCRIPT)]'; echo '${s:x}'",
+    "x='a[$(SCRIPT)]'; echo '$[x]'",
+    r"x='a[$(SCRIPT)]'; echo \${a[x]}",
+    "x='a[$(SCRIPT)]'; echo $${a[x]}",
+    "x='a[$(SCRIPT)]'; echo 'a[x]=1'",
+    "x='a[$(SCRIPT)]'; echo '${s:-x}'",
+    "declare x='a[$(SCRIPT)]'; echo x",
     "x='a[$(SCRIPT)]'; test -n 'a[x]'",
     "x='a[$(SCRIPT)]'; printf '%s' 'a[x]'",
     "x='a[$(SCRIPT)]'; echo 'a[x]'",
