index 0000000000..401fc7e5cb
--- /dev/null
+++ b/hermes_cli/kanban_capability_registry.py
@@ -0,0 +1,378 @@
+"""Gateway capability registry: what this gateway can do, live-checked, shared via hermes-hub. [daveey]
+
+A *capability* is a namespaced, secret-free name for something a gateway can do on behalf of any
+card, whatever profile runs it: ``aws:123456789012:admin``, ``github:daveey:repo``,
+``ssh:mini``, ``sudo:nopasswd``, ``token-broker:user/cf-dbloom-infra``, ``browser:signed-in``.
+Each one is held only while its probe (a cheap shell command: ``aws sts get-caller-identity
+--profile …``, ``gh auth status``, ``ssh -o BatchMode=yes <host> true``) exits 0, and every
+entry carries the time it was last checked.
+
+This gateway writes ``<kanban home>/kanban/capabilities.json``. The hermes-hub client publishes
+that file as its ``capabilities`` record (names, ok, checked_at; never commands or output), so
+every gateway's replica (``~/.local/state/hermes-hub/hub.db``) knows who holds what. Routing
+(:mod:`hermes_cli.kanban_capability_routing`) reads it and only trusts entries checked within
+``stale_after_seconds``: stale data never routes.
+
+Config (``config.yaml``, default profile of the gateway)::
+
+    kanban:
+      capabilities:
+        probes:                       # name -> shell command; exit 0 = held
+          "aws:123456789012:admin": "aws sts get-caller-identity --profile my-sso-profile"
+        ssh_hosts:                    # ssh:<name> held while BatchMode ssh to the host works
+          hub: ubuntu@192.0.2.10
+        builtin: true                 # sudo:nopasswd and github:<login>[:<scope>]
+        refresh_seconds: 600
+        stale_after_seconds: 1800
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import shlex
+import subprocess
+import threading
+import time
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from typing import Optional
+
+SCHEMA = 1
+NEED_RE = re.compile(r"[a-z][a-z0-9-]*(?::[A-Za-z0-9._@/+-]+)+")
+COVERING_LEAVES = ("admin", "*")
+DEFAULT_REFRESH_SECONDS = 600
+DEFAULT_STALE_AFTER_SECONDS = 1800
+PROBE_TIMEOUT = 20
+MAX_NAME_LEN = 160
+
+_lock = threading.Lock()
+_thread: Optional[threading.Thread] = None
+
+
+# --- names ---------------------------------------------------------------------------------
+
+def is_gateway_need(value) -> bool:
+    """A namespaced capability name (``ns:part[:part…]``), never a profile tool name."""
+    return isinstance(value, str) and len(value) <= MAX_NAME_LEN and bool(NEED_RE.fullmatch(value))
+
+
+def normalize_needs(value) -> list[str]:
+    """Validated, deduplicated, order-preserving list of capability needs (ValueError if bad)."""
+    if value is None:
+        return []
+    if isinstance(value, str):
+        value = [value]
+    if not isinstance(value, (list, tuple)):
+        raise ValueError("needs must be a list of capability names")
+    out: list[str] = []
+    for item in value:
+        if not is_gateway_need(item):
+            raise ValueError(
+                f"invalid capability need {item!r}: use a namespaced name such as "
+                "'aws:<account>:<action-or-role>', 'ssh:<host>', 'github:<owner>:<scope>', "
+                "'token-broker:<scope>', 'sudo:nopasswd' or 'browser:signed-in'")
+        if item not in out:
+            out.append(item)
+    return out
+
+
+def satisfies(held: str, need: str) -> bool:
+    """``held`` covers ``need``: equal; a covering leaf (``aws:1:admin`` covers ``aws:1:x``);
+    or a more specific holding of a broader need (``aws:1:admin`` covers ``aws:1``)."""
+    if held == need:
+        return True
+    h, n = held.split(":"), need.split(":")
+    if h[-1] in COVERING_LEAVES and len(n) >= len(h) and n[: len(h) - 1] == h[:-1]:
+        return True
+    return len(h) > len(n) and h[: len(n)] == n
+
+
+# --- config / paths ------------------------------------------------------------------------
+
+def _config() -> dict:
+    try:
+        from hermes_cli.config import load_config_readonly
+        cfg = (load_config_readonly() or {}).get("kanban", {}) or {}
+        caps = cfg.get("capabilities") or {}
+        return caps if isinstance(caps, dict) else {}
+    except Exception:
+        return {}
+
+
+def _seconds(cfg: dict, key: str, default: int) -> int:
+    try:
+        return max(30, int(cfg.get(key, default)))
+    except (TypeError, ValueError):
+        return default
+
+
+def stale_after(cfg: Optional[dict] = None) -> int:
+    return _seconds(_config() if cfg is None else cfg, "stale_after_seconds", DEFAULT_STALE_AFTER_SECONDS)
+
+
+def registry_path() -> Path:
+    from hermes_cli.kanban_db import kanban_home
+    return kanban_home() / "kanban" / "capabilities.json"
+
+
+def hub_db_path() -> Path:
+    return Path(os.environ.get("HERMES_HUB_STATE") or Path.home() / ".local/state/hermes-hub") / "hub.db"
+
+
+def self_gateway() -> Optional[str]:
+    """This gateway's hermes-hub name (hermes-mail config, else the replica's meta)."""
+    cfg = Path(os.environ.get("HERMES_MAIL_CONFIG") or Path.home() / ".config/hermes-mail/config.json")
+    try:
+        gw = json.loads(cfg.read_text(encoding="utf-8-sig")).get("gateway")
+        if isinstance(gw, str) and gw:
+            return gw
+    except (OSError, ValueError, AttributeError):
+        pass
+    try:
+        db = _ro(hub_db_path())
+        try:
+            row = db.execute("SELECT v FROM meta WHERE k='gateway'").fetchone()
+            return row[0] if row and row[0] else None
+        finally:
+            db.close()
+    except Exception:
+        return None
+
+
+def _ro(path: Path):
+    import sqlite3
+    if not path.exists():
+        raise FileNotFoundError(str(path))
+    return sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=10)
+
+
+# --- probes --------------------------------------------------------------------------------
+
+def _run(cmd, timeout: int = PROBE_TIMEOUT) -> tuple[int, str]:
+    try:
+        p = subprocess.run(cmd if isinstance(cmd, list) else ["bash", "-lc", cmd],
+                           capture_output=True, text=True, timeout=timeout, check=False,
+                           stdin=subprocess.DEVNULL, encoding="utf-8", errors="replace")
+        return p.returncode, (p.stdout or "") + (p.stderr or "")
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        return 124, str(exc)
+
+
+def _builtin_github() -> list[tuple[str, bool]]:
+    rc, out = _run(["gh", "api", "user", "--jq", ".login"])
+    login = out.strip().splitlines()[0] if rc == 0 and out.strip() else ""
+    if not re.fullmatch(r"[A-Za-z0-9-]{1,64}", login or ""):
+        return []
+    found = [(f"github:{login}", True)]
+    rc, status = _run(["gh", "auth", "status"])
+    m = re.search(r"Token scopes:\s*(.+)", status or "") if rc == 0 else None
+    for scope in re.findall(r"'([a-z:_]+)'", m.group(1) if m else ""):
+        found.append((f"github:{login}:{scope.replace(':', '-')}", True))
+    return found
+
+
+def probe_specs(cfg: dict) -> list[tuple[str, object]]:
+    """(name, command) pairs from config, plus ssh hosts."""
+    specs: list[tuple[str, object]] = []
+    probes = cfg.get("probes") or {}
+    if isinstance(probes, dict):
+        for name, cmd in probes.items():
+            if is_gateway_need(name) and isinstance(cmd, str) and cmd.strip():
+                specs.append((name, cmd))
+    hosts = cfg.get("ssh_hosts") or {}
+    if isinstance(hosts, dict):
+        for name, host in hosts.items():
+            if isinstance(host, str) and host.strip() and is_gateway_need(f"ssh:{name}"):
+                specs.append((f"ssh:{name}", ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
+                                              host.strip(), "true"]))
+    return specs
+
+
+def refresh(cfg: Optional[dict] = None, *, now: Optional[float] = None) -> dict:
+    """Run every probe now and atomically rewrite the registry file. Returns the record."""
+    cfg = _config() if cfg is None else cfg
+    specs = probe_specs(cfg)
+    results: dict[str, dict] = {}
+
+    def one(spec):
+        name, cmd = spec
+        rc, _ = _run(cmd)
+        return name, rc == 0, time.time()
+
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        futures = [pool.submit(one, s) for s in specs]
+        if cfg.get("builtin", True):
+            futures.append(pool.submit(lambda: ("sudo:nopasswd", _run(["sudo", "-n", "true"])[0] == 0, time.time())))
+            gh = pool.submit(_builtin_github)
+        else:
+            gh = None
+        for fut in futures:
+            name, ok, at = fut.result()
+            results[name] = {"name": name, "ok": ok, "checked_at": round(at, 3)}
+        if gh is not None:
+            at = round(time.time(), 3)
+            for name, ok in gh.result():
+                results.setdefault(name, {"name": name, "ok": ok, "checked_at": at})
+    record = {
+        "schema": SCHEMA,
+        "gateway": self_gateway(),
+        "refreshed_at": round(time.time() if now is None else now, 3),
+        "refresh_seconds": _seconds(cfg, "refresh_seconds", DEFAULT_REFRESH_SECONDS),
+        "stale_after_seconds": stale_after(cfg),
+        "capabilities": sorted(results.values(), key=lambda r: r["name"]),
+    }
+    path = registry_path()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_suffix(f".json.{os.getpid()}.tmp")
+    tmp.write_text(json.dumps(record, indent=2, sort_keys=True), encoding="utf-8")
+    os.replace(tmp, path)
+    return record
+
+
+def read_local() -> Optional[dict]:
+    try:
+        data = json.loads(registry_path().read_text(encoding="utf-8"))
+        return data if isinstance(data, dict) and data.get("schema") == SCHEMA else None
+    except (OSError, ValueError):
+        return None
+
+
+def maybe_refresh_async(*, now: Optional[float] = None) -> bool:
+    """Start a background refresh when the file is older than ``refresh_seconds``. Never waits,
+    never raises: the dispatcher tick calls this."""
+    global _thread
+    try:
+        cfg = _config()
+        if cfg.get("enabled") is False:
+            return False
+        now = time.time() if now is None else now
+        local = read_local()
+        if local and now - float(local.get("refreshed_at") or 0) < _seconds(cfg, "refresh_seconds",
+                                                                              DEFAULT_REFRESH_SECONDS):
+            return False
+        with _lock:
+            if _thread is not None and _thread.is_alive():
+                return False
+            _thread = threading.Thread(target=_safe_refresh, args=(cfg,), name="kanban-capabilities",
+                                       daemon=True)
+            _thread.start()
+        return True
+    except Exception:
+        return False
+
+
+def _safe_refresh(cfg):
+    try:
+        refresh(cfg)
+    except Exception:
+        import logging
+        logging.getLogger(__name__).warning("kanban capability refresh failed", exc_info=True)
+
+
+# --- lookup --------------------------------------------------------------------------------
+
+def _entries(record) -> list[dict]:
+    caps = record.get("capabilities") if isinstance(record, dict) else None
+    return [c for c in caps or [] if isinstance(c, dict) and isinstance(c.get("name"), str)]
+
+
+def _match(record, need: str, now: float, limit: int) -> tuple[Optional[float], Optional[float]]:
+    """(freshest fresh checked_at, freshest stale checked_at) of ok entries covering ``need``."""
+    fresh = stale = None
+    for c in _entries(record):
+        if not c.get("ok") or not satisfies(c["name"], need):
+            continue
+        raw = c.get("checked_at")
+        if isinstance(raw, bool) or not isinstance(raw, (int, float)):
+            continue
+        at = float(raw)
+        if now - at <= limit:
+            fresh = max(fresh or 0, at)
+        else:
+            stale = max(stale or 0, at)
+    return fresh, stale
+
+
+def remote_records(*, exclude: Optional[str] = None) -> dict[str, dict]:
+    """``{gateway: capabilities record}`` from the hermes-hub replica (empty if unreadable)."""
+    try:
+        db = _ro(hub_db_path())
+    except Exception:
+        return {}
+    try:
+        rows = db.execute("SELECT gw, data FROM replica WHERE coll = 'capabilities' AND key = 'info'").fetchall()
+    except Exception:
+        rows = []
+    finally:
+        db.close()
+    out = {}
+    for gw, data in rows:
+        if gw == exclude:
+            continue
+        try:
+            rec = json.loads(data)
+        except ValueError:
+            continue
+        if isinstance(rec, dict) and rec.get("schema") == SCHEMA:
+            out[gw] = rec
+    return out
+
+
+def locate(need: str, *, now: Optional[float] = None, cfg: Optional[dict] = None,
+           local: Optional[dict] = None, remote: Optional[dict] = None,
+           self_gw: Optional[str] = None) -> dict:
+    """Where ``need`` is held: ``{need, local: fresh|stale|absent, holders: [(gw, at)…] fresh
+    newest first, stale: [(gw, at)…]}``. Only fresh entries are routable."""
+    now = time.time() if now is None else now
+    limit = stale_after(cfg)
+    local = read_local() if local is None else local
+    self_gw = self_gateway() if self_gw is None else self_gw
+    remote = remote_records(exclude=self_gw) if remote is None else remote
+    lf, ls = _match(local or {}, need, now, limit)
+    holders, stale = [], []
+    for gw, rec in sorted(remote.items()):
+        if gw == self_gw:
+            continue
+        f, s = _match(rec, need, now, limit)
+        if f is not None:
+            holders.append((gw, f))
+        elif s is not None:
+            stale.append((gw, s))
+    holders.sort(key=lambda x: -x[1])
+    return {"need": need, "local": "fresh" if lf is not None else ("stale" if ls is not None else "absent"),
+            "holders": holders, "stale": stale}
+
+
+# --- CLI -----------------------------------------------------------------------------------
+
+def run_cli(args) -> int:
+    action = getattr(args, "cap_action", None) or "list"
+    if action == "refresh":
+        rec = refresh()
+        print(json.dumps(rec, indent=2, sort_keys=True))
+        return 0
+    if action == "locate":
+        try:
+            needs = normalize_needs(args.needs)
+        except ValueError as exc:
+            print(str(exc))
+            return 2
+        out = [locate(n) for n in needs]
+        print(json.dumps(out, indent=2))
+        return 0 if all(o["local"] == "fresh" or o["holders"] for o in out) else 1
+    local = read_local()
+    gws = {self_gateway() or "local": local or {}}
+    gws.update(remote_records(exclude=self_gateway()))
+    now = time.time()
+    limit = stale_after()
+    for gw, rec in gws.items():
+        for c in _entries(rec):
+            age = now - float(c.get("checked_at") or 0)
+            state = ("held" if c.get("ok") else "not held") + (" (stale)" if age > limit else "")
+            print(f"{gw:10} {c['name']:48} {state:18} checked {int(age)}s ago")
+    return 0
+
+
+def describe_probe(cmd) -> str:
+    return shlex.join(cmd) if isinstance(cmd, list) else str(cmd)
diff --git a/hermes_cli/kanban_capability_routing.py b/hermes_cli/kanban_capability_routing.py
new file mode 100644
index 0000000000..5a8fa47c63
--- /dev/null
+++ b/hermes_cli/kanban_capability_routing.py
@@ -0,0 +1,319 @@
+"""Cross-gateway capability routing: a wall on one gateway opens an owner card where the
+capability lives. [daveey]
+
+A worker that hits a wall declares what it needs (``kanban_block(needs=[...])`` /
+``kanban_schedule(needs=[...])``, CLI ``--need``, or a card's ``requires`` entries that are
+namespaced capability names). When this gateway lacks a need and another gateway holds it
+(fresh entry in the hermes-hub capability registry, :mod:`kanban_capability_registry`):
+
+1. ONE owner card is created on the holder through ``hermes-hub create-task`` with request id
+   ``capability-owner:<card>:<need>`` (exact retries are idempotent on both ends). Its body is
+   the scoped action, the readback and the wake of the waiting card. If the action goes beyond
+   the approved plan, the owner card -- not the worker -- files the real ``human_request``.
+2. The waiting card parks ``scheduled`` on that owner card: wake_check
+   ``hermes kanban wait-check capability-owner <request ids>`` exits 0 once every owner card is
+   done (1 while the request or card is pending, 2 if the request was rejected).
+
+Refusals are typed (:class:`CapabilityRouteError`), and nothing is written:
+
+* ``no_capability_holder`` -- no gateway holds it: if only David can grant it, block with
+  kind='needs_input' and a ``human_request`` naming the exact command.
+* ``capability_registry_stale`` -- a holder exists but was not live-checked recently; stale
+  registry data never routes.
+* ``capability_held_locally`` -- this gateway holds it: the wall is the worker's profile
+  (kind='assignment') or a real failure, not a missing capability.
+* ``capability_route_exhausted`` -- this card already routed that need once; the existing owner
+  card must finish or report why.
+"""
+from __future__ import annotations
+
+import json
+import re
+import subprocess
+import time
+from datetime import datetime, timezone, UTC
+from typing import Callable, Optional
+
+from hermes_cli import kanban_capability_registry as reg
+
+OWNER_PREFIX = "capability-owner:"
+ROUTED_EVENT = "capability_routed"
+WAKE_EVERY = 120
+WAKE_HORIZON = 72 * 3600
+HUB_TIMEOUT = 60
+
+
+class CapabilityRouteError(ValueError):
+    """No owner card can be routed; nothing was written. ``code`` is the typed reason."""
+
+    def __init__(self, code: str, message: str, *, details: Optional[dict] = None):
+        self.code = code
+        self.details = details or {}
+        super().__init__(f"{code}: {message}")
+
+
+def request_id(task_id: str, need: str) -> str:
+    """Stable hermes-hub request id (and owner idempotency) for one card's need."""
+    return re.sub(r"[^A-Za-z0-9._:-]", "-", f"{OWNER_PREFIX}{task_id}:{need}")[:128]
+
+
+def needs_from_requires(requires) -> list[str]:
+    """Namespaced capability needs declared in a card's ``requires``."""
+    return [r for r in (requires or []) if reg.is_gateway_need(r)]
+
+
+def _hub_cli() -> str:
+    cfg = reg._config()
+    value = cfg.get("hub_cli")
+    return value if isinstance(value, str) and value.strip() else "hermes-hub"
+
+
+def _owner_assignee() -> str:
+    value = reg._config().get("owner_assignee")
+    return value if isinstance(value, str) and value.strip() else "default"
+
+
+def _default_runner(argv: list[str]) -> tuple[int, str]:
+    try:
+        p = subprocess.run(argv, capture_output=True, text=True, timeout=HUB_TIMEOUT, check=False,
+                           stdin=subprocess.DEVNULL, encoding="utf-8", errors="replace")
+        return p.returncode, (p.stdout or "").strip() + ("\n" + p.stderr.strip() if p.stderr else "")
+    except (OSError, subprocess.TimeoutExpired) as exc:
+        return 127, str(exc)
+
+
+# Tests replace this with a fake that records argv.
+hub_runner: Callable[[list[str]], tuple[int, str]] = _default_runner
+
+
+def _ago(at: float, now: float) -> str:
+    s = int(max(0, now - at))
+    return f"{s // 3600}h{(s % 3600) // 60:02d}m" if s >= 3600 else f"{s // 60}m{s % 60:02d}s"
+
+
+def plan(needs: list[str], *, now: Optional[float] = None, **lookup) -> dict:
+    """Decide routing without writing. Raises CapabilityRouteError for the typed refusals.
+
+    Returns ``{"routes": [{need, gateway, checked_at}], "local": [needs held here]}``.
+    """
+    now = time.time() if now is None else now
+    found = [reg.locate(n, now=now, **lookup) for n in needs]
+    local = [f["need"] for f in found if f["local"] == "fresh"]
+    missing = [f for f in found if f["local"] != "fresh"]
+    if not missing:
+        raise CapabilityRouteError(
+            "capability_held_locally",
+            f"this gateway holds {', '.join(local)} (live-checked); the wall is not a missing gateway "
+            "capability. If this worker's profile cannot use it, block with kind='assignment'; "
+            "otherwise fix the failure yourself.", details={"local": local})
+    routes = []
+    for f in missing:
+        if f["holders"]:
+            gw, at = f["holders"][0]
+            routes.append({"need": f["need"], "gateway": gw, "checked_at": at})
+            continue
+        if f["stale"]:
+            gws = ", ".join(f"{gw} ({_ago(at, now)} ago)" for gw, at in f["stale"])
+            raise CapabilityRouteError(
+                "capability_registry_stale",
+                f"{f['need']} was last confirmed on {gws}, older than the {reg.stale_after()}s freshness "
+                "window, so it is not routed. That gateway's probe or hermes-hub sync is not running; "
+                "fix that, or if only David can grant it, block with kind='needs_input' and a "
+                "human_request naming the exact command.", details={"need": f["need"], "stale": f["stale"]})
+        raise CapabilityRouteError(
+            "no_capability_holder",
+            f"no gateway holds {f['need']} (hermes-hub capability registry). If only David can grant it, "
+            "block with kind='needs_input' and a human_request naming the exact command and scope.",
+            details={"need": f["need"]})
+    return {"routes": routes, "local": local}
+
+
+def _previous_routes(conn, task_id: str) -> dict[str, dict]:
+    out: dict[str, dict] = {}
+    for (payload,) in conn.execute(
+            "SELECT payload FROM task_events WHERE task_id = ? AND kind = ? ORDER BY id", (task_id, ROUTED_EVENT)):
+        try:
+            for r in json.loads(payload or "{}").get("routes") or []:
+                if isinstance(r, dict) and r.get("need"):
+                    out[r["need"]] = r
+        except ValueError:
+            continue
+    return out
+
+
+def owner_body(task, need: str, *, self_gw: str, board: str, reason: str, checked_at: float, now: float) -> str:
+    ref = f"{self_gw}/default/{board}/{task.id}"
+    excerpt = (reason or "").strip()
+    if len(excerpt) > 3000:
+        excerpt = excerpt[:3000] + "…"
+    return (
+        f"Capability owner card for waiting card {ref} (\"{(task.title or '')[:160]}\").\n"
+        f"It needs `{need}`. This gateway holds it (live-checked {_ago(checked_at, now)} before routing); "
+        f"{self_gw} does not.\n\n"
+        "## Action (from the waiting card, inside its approved plan)\n"
+        f"{excerpt or '(no reason given; read the waiting card first)'}\n\n"
+        "## Do\n"
+        f"1. Read the waiting card: `hermes-hub tasks --gw {self_gw} --json` (or cross_task read "
+        f"@task:{board}@{self_gw}/{task.id}).\n"
+        f"2. Perform exactly the scoped action above with this gateway's `{need}`. Keep it to the minimum "
+        "the waiting card needs (least privilege, tag/resource conditions where they apply).\n"
+        "3. If the action goes beyond the waiting card's approved plan or scope, do NOT do it: block THIS "
+        "card with kind='needs_input' and a human_request naming the exact command. The waiting worker "
+        "does not ask David; this card does.\n\n"
+        "## Readback\n"
+        "Verify the effect from the waiting card's side where you can (for example run its failing call "
+        "again from that gateway) and record the evidence in your completion summary.\n\n"
+        "## Wake\n"
+        f"The waiting card is parked on this card: completing it wakes {ref} within its next probe "
+        f"(about {WAKE_EVERY // 60} min). Also comment the result on it: "
+        f"`hermes-hub request {self_gw} tasks default/{board}/{task.id} comment --arg text=...`.\n"
+    )
+
+
+def route(conn, task_id: str, needs, *, reason: str, expected_run_id: Optional[int] = None,
+          board: Optional[str] = None, now: Optional[float] = None, **lookup) -> dict:
+    """Route ``needs`` for a running/ready card: create owner cards, then park it on them.
+
+    Raises CapabilityRouteError (typed, nothing written) or ValueError for bad input.
+    """
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_timed_park as ktp
+
+    needs = reg.normalize_needs(needs)
+    if not needs:
+        raise ValueError("needs is empty")
+    task = kb.get_task(conn, task_id)
+    if task is None:
+        raise ValueError(f"unknown task {task_id}")
+    if task.status not in ("running", "ready"):
+        raise CapabilityRouteError("capability_route_invalid_state",
+                                   f"{task_id} is {task.status}; only a running or ready card can be routed")
+    now = time.time() if now is None else now
+    previous = _previous_routes(conn, task_id)
+    repeat = [n for n in needs if n in previous]
+    if repeat:
+        p = previous[repeat[0]]
+        raise CapabilityRouteError(
+            "capability_route_exhausted",
+            f"{task_id} already routed {repeat[0]} to {p.get('gateway')} (hermes-hub request "
+            f"{p.get('request_id')}). That owner card must finish or report why; check it with "
+            f"`hermes kanban wait-check capability-owner {p.get('request_id')}` and `hermes-hub requests`. "
+            "If it is done and the grant was insufficient, comment the exact gap on it and reopen it.",
+            details={"need": repeat[0], **p})
+    self_gw = lookup.pop("self_gw", None) or reg.self_gateway()
+    if not self_gw:
+        raise CapabilityRouteError("capability_hub_unavailable",
+                                   "this gateway has no hermes-hub identity (~/.config/hermes-mail/config.json)")
+    decided = plan(needs, now=now, self_gw=self_gw, **lookup)
+    board_slug = board or kb.get_current_board() or "default"
+    hub = _hub_cli()
+    routes = []
+    for r in decided["routes"]:
+        rid = request_id(task_id, r["need"])
+        title = f"Capability owner: {r['need']} for {self_gw}/{task_id} ({(task.title or '')[:80]})"
+        body = owner_body(task, r["need"], self_gw=self_gw, board=board_slug, reason=reason,
+                          checked_at=r["checked_at"], now=now)
+        argv = [hub, "create-task", r["gateway"], title, "--body", body, "--assignee", _owner_assignee(),
+                "--origin-session", "", "--id", rid]
+        rc, out = hub_runner(argv)
+        # 0 = sent, 3 = queued locally (hub unreachable; sent on the next sync). Both are durable.
+        if rc not in (0, 3):
+            raise CapabilityRouteError("capability_hub_unavailable",
+                                       f"hermes-hub create-task to {r['gateway']} failed (exit {rc}): {out[-400:]}",
+                                       details={"need": r["need"], "gateway": r["gateway"]})
+        routes.append({**r, "request_id": rid, "queued_only": rc == 3})
+    ids = ",".join(x["request_id"] for x in routes)
+    until = datetime.fromtimestamp(int(now) + WAKE_HORIZON, tz=UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
+    summary = "; ".join(f"{x['need']} on {x['gateway']} (request {x['request_id']})" for x in routes)
+    park_reason = (f"Waiting on capability owner card(s): {summary}. Wakes when they are done. "
+                   f"SCHEDULED_UNTIL={until}\n{(reason or '').strip()[:1500]}")
+    wake_check = f"hermes kanban wait-check capability-owner {ids}"
+    with kb.write_txn(conn):
+        cur = conn.execute("SELECT status FROM tasks WHERE id = ?", (task_id,)).fetchone()
+        source = kb._retry_status_for_run(conn, task_id) if cur and cur[0] == "running" else "ready"
+        ok = ktp.park(conn, task_id, reason=park_reason, requested_kind="capability", source_status=source,
+                      expected_run_id=expected_run_id, wake_check=wake_check, check_every=WAKE_EVERY)
+        if not ok:
+            raise CapabilityRouteError(
+                "capability_route_invalid_state",
+                f"owner request(s) {ids} were queued but {task_id} could not be parked (claim lost?)",
+                details={"routes": routes})
+        kb._append_event(conn, task_id, ROUTED_EVENT, {
+            "routes": routes, "local": decided["local"], "self_gateway": self_gw,
+            # A named live producer for the park (see the no-producer-no-park contract).
+            "awaiting": [{"kind": "card", "ref": f"{x['gateway']}/request/{x['request_id']}",
+                          "why": f"capability {x['need']}"} for x in routes],
+        })
+    return {"status": "scheduled", "routes": routes, "wake_check": wake_check, "local": decided["local"]}
+
+
+def preflight(conn, task_id: str, *, board: Optional[str] = None, **lookup) -> Optional[dict]:
+    """Placement preflight for a just-created card whose ``requires`` declare gateway needs.
+
+    Pre-routes needs this gateway lacks but another holds (owner card first, the card waits).
+    Returns the route result, a ``{"warning": ...}`` dict when nothing can be routed, or None
+    when there is nothing to do. Never raises.
+    """
+    from hermes_cli import kanban_db as kb
+    try:
+        task = kb.get_task(conn, task_id)
+        if task is None:
+            return None
+        needs = needs_from_requires(task.requires)
+        if not needs:
+            return None
+        if task.status != "ready":
+            return {"warning": f"declared needs {needs} not preflighted: card is {task.status}"}
+        return route(conn, task_id, needs, reason=(task.body or task.title or "")[:3000],
+                     board=board, **lookup)
+    except CapabilityRouteError as exc:
+        if exc.code == "capability_held_locally":
+            return None
+        return {"warning": str(exc), "code": exc.code}
+    except Exception as exc:
+        return {"warning": f"capability preflight failed: {exc}"}
+
+
+# --- wait-check ----------------------------------------------------------------------------
+
+def owner_status(rid: str) -> tuple[int, str]:
+    """(rc, message) for one owner request: 0 done, 1 pending, 2 cannot tell / rejected."""
+    try:
+        db = reg._ro(reg.hub_db_path())
+    except Exception as exc:
+        return 2, f"error: hermes-hub replica unreadable: {exc}"
+    try:
+        row = db.execute("SELECT body, state, result FROM sent WHERE id = ?", (rid,)).fetchone()
+        if row is None:
+            return 2, f"error: no hermes-hub request {rid} on this gateway"
+        body = json.loads(row[0] or "{}")
+        state = row[1]
+        if state in ("rejected", "expired", "failed"):
+            return 2, f"error: request {rid} {state}: {str(row[2])[:300]}"
+        if state != "done":
+            return 1, f"{rid} request {state}"
+        result = json.loads(row[2] or "{}") or {}
+        tid = result.get("task") if isinstance(result, dict) else None
+        if not tid:
+            return 2, f"error: request {rid} done without a task id: {str(row[2])[:300]}"
+        gw = body.get("to_gw")
+        board = (body.get("key") or "default/default/new").split("/")[1] if body.get("key") else "default"
+        rec = db.execute("SELECT data FROM replica WHERE gw = ? AND coll = 'tasks' AND key = ?",
+                         (gw, f"default/{board}/{tid}")).fetchone()
+        if rec is None:
+            return 1, f"{rid} -> {gw}/{tid} not replicated yet"
+        status = json.loads(rec[0]).get("status")
+        return (0 if status in ("done", "archived") else 1), f"{rid} -> {gw}/{tid} {status}"
+    except Exception as exc:  # cannot tell, never "not yet"
+        return 2, f"error: {exc}"
+    finally:
+        db.close()
+
+
+def wait_check(target: str) -> tuple[int, str]:
+    rids = [r for r in (target or "").split(",") if r.strip()]
+    if not rids:
+        return 2, "error: no request id"
+    results = [owner_status(r.strip()) for r in rids]
+    rc = 2 if any(r[0] == 2 for r in results) else (0 if all(r[0] == 0 for r in results) else 1)
+    return rc, "; ".join(m for _, m in results)
