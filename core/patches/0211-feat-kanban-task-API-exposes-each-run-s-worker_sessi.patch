From 5d1bb6ae24b7f4f27971c5779cb8d68357c701a5 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 23 Oct 2026 04:02:56 +0000
Subject: [PATCH] feat(kanban): task API exposes each run's worker_session_id
 so clients open the worker, not the creating chat [daveey] (#19)

* feat(kanban): task API exposes each run's worker_session_id (from worker_recovery_sessions) so clients open the worker, not the creating chat [daveey]

* test(kanban): use monkeypatch for asdict stand-in [daveey]
---
 hermes_cli/kanban_worker_recovery.py          | 17 +++++++++++++++
 plugins/kanban/dashboard/plugin_api.py        | 21 ++++++++++++++++++-
 .../hermes_cli/test_kanban_worker_recovery.py | 17 +++++++++++++++
 3 files changed, 54 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/kanban_worker_recovery.py b/hermes_cli/kanban_worker_recovery.py
index 04e46ffaff..671f059058 100644
--- a/hermes_cli/kanban_worker_recovery.py
+++ b/hermes_cli/kanban_worker_recovery.py
@@ -94,6 +94,23 @@ def register_worker_session(session_db, session_id: str) -> bool:
         return False
 
 
+def worker_session_ids(conn: sqlite3.Connection, task_id: str) -> dict[int, str]:
+    """``{run_id: worker_session_id}`` for a task, newest registration winning.
+
+    Registration happens when the worker's session is created (and again on compression
+    rotation), so a *running* run already has its session here, unlike
+    ``metadata.worker_session_id`` which is only stamped at completion. Never raises.
+    """
+    try:
+        rows = conn.execute(
+            "SELECT run_id, session_id FROM worker_recovery_sessions "
+            "WHERE task_id=? ORDER BY registered_at ASC", (task_id,),
+        ).fetchall()
+    except sqlite3.Error:
+        return {}
+    return {int(r[0]): str(r[1]) for r in rows}
+
+
 def build_recovery_context(conn: sqlite3.Connection, task_id: str) -> str:
     """Return bounded notes from the latest closed run of this task/profile.
 
diff --git a/plugins/kanban/dashboard/plugin_api.py b/plugins/kanban/dashboard/plugin_api.py
index d80a9e046a..4228a0a772 100644
--- a/plugins/kanban/dashboard/plugin_api.py
+++ b/plugins/kanban/dashboard/plugin_api.py
@@ -428,6 +428,24 @@ async def get_board_endpoint(
 
 # --- GET /tasks/:id ---------------------------------------------------------
 
+def _runs_with_worker_sessions(conn, task_id: str, runs) -> list[dict]:
+    """Run dicts plus ``worker_session_id``: the session the worker actually runs in.
+
+    ``tasks.session_id`` is the chat that CREATED the card, so clients must use this to open
+    the worker transcript. Registered at worker start; completed runs also carry it in metadata.
+    """
+    from hermes_cli.kanban_worker_recovery import worker_session_ids
+    registered = worker_session_ids(conn, task_id)
+    out = []
+    for r in runs:
+        d = asdict(r)
+        meta = d.get("metadata")
+        d["worker_session_id"] = registered.get(r.id) or (
+            meta.get("worker_session_id") if isinstance(meta, dict) else None) or None
+        out.append(d)
+    return out
+
+
 @router.get("/tasks/{task_id}")
 def get_task(
     task_id: str,
@@ -458,7 +476,8 @@ def get_task(
             "child_results": [
                 {"id": c.id, "title": c.title, "status": c.status, "latest_summary": child_summaries.get(c.id), "result": c.result}
                 for c in children],
-            "runs": [asdict(r) for r in kanban_db.list_runs(conn, task_id, state_type=run_state_type, state_name=run_state_name)]}
+            "runs": _runs_with_worker_sessions(
+                conn, task_id, kanban_db.list_runs(conn, task_id, state_type=run_state_type, state_name=run_state_name))}
 
 
 # --- POST /tasks ------------------------------------------------------------
diff --git a/tests/hermes_cli/test_kanban_worker_recovery.py b/tests/hermes_cli/test_kanban_worker_recovery.py
index 6544470c53..b4c734b048 100644
--- a/tests/hermes_cli/test_kanban_worker_recovery.py
+++ b/tests/hermes_cli/test_kanban_worker_recovery.py
@@ -222,3 +222,20 @@ def test_compression_rotation_uses_latest_registered_session(worker):
     result = recovery.build_recovery_context(worker.conn, "t_one")
     assert "Compressed progress and next actions" in result
     assert "Implemented parser" not in result
+
+
+def test_worker_session_ids_maps_running_run_to_its_worker_session(worker):
+    assert recovery.worker_session_ids(worker.conn, "t_one") == {}  # no table yet: never raises
+    assert recovery.register_worker_session(worker, "worker")
+    assert recovery.worker_session_ids(worker.conn, "t_one") == {1: "worker"}
+    assert recovery.worker_session_ids(worker.conn, "t_other") == {}
+
+
+def test_dashboard_runs_expose_worker_session_id(worker, monkeypatch):
+    import plugins.kanban.dashboard.plugin_api as api
+    assert recovery.register_worker_session(worker, "worker")
+    runs = [SimpleNamespace(id=1), SimpleNamespace(id=2, metadata={"worker_session_id": "from-meta"}),
+            SimpleNamespace(id=3, metadata=None)]
+    monkeypatch.setattr(api, "asdict", lambda r: dict(vars(r)))  # stand-ins, not Run dataclasses
+    out = api._runs_with_worker_sessions(worker.conn, "t_one", runs)
+    assert [r["worker_session_id"] for r in out] == ["worker", "from-meta", None]
