From a3fb42d03bc35a4e34341862410917264cda4afc Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:11:21 +0000
Subject: [PATCH] [daveey] lifecycle guard: pin the closed-group output reset
 at an operator (#2586 test gap)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

PR #2586 made `_LineWalk.operator` reset `self.closed` with `self.closing`. Mutant M8 reverts
that (`self.closing = None`) and survived all 17 tests/cron/test_lifecycle_guard*.py files, yet it
fails open: the output of a closed `( … )` outlives an operator whose segment is empty, so the
next flush reads `pending = self.closed` instead of the command's own output and
`(true); cat r.sh | bash` loses its feed.

New tests/cron/test_lifecycle_guard_closed_output_reset.py (test-only):
- `(true); cat {sh} | bash`, `(echo hi); …`, `(true) && …`, `(true) || …`, `(true) & …`,
  `(echo hi; true); cat {py} | python3`, `( (true) ); cat {sh} | bash` -> (True, None)
- controls `(cat {sh}); echo x | bash`, `(cat {sh}) && echo x | bash` -> (False, None)

Proof (sdlc-review scripts/mutants.py, card t_01a1d6f3aa3869f1):
  BASELINE: ok, 9 passed, 0 skipped
  M8 operator keeps closed output: killed, 9 failed (the controls fail closed under M8 too:
  the stale subshell output feeds `echo x | bash`)
---
 ...est_lifecycle_guard_closed_output_reset.py | 55 +++++++++++++++++++
 1 file changed, 55 insertions(+)
 create mode 100644 tests/cron/test_lifecycle_guard_closed_output_reset.py

diff --git a/tests/cron/test_lifecycle_guard_closed_output_reset.py b/tests/cron/test_lifecycle_guard_closed_output_reset.py
new file mode 100644
index 0000000000..6fefacbf0b
--- /dev/null
+++ b/tests/cron/test_lifecycle_guard_closed_output_reset.py
@@ -0,0 +1,55 @@
+"""A closed ``( … )`` group's output ends at the next operator (PR #2586 test gap).
+
+``_LineWalk.operator`` resets ``self.closed`` along with ``self.closing``. Without that reset the
+output of ``(true)`` outlived an operator whose segment was empty (``(true); …``), and the next
+flush took ``pending = self.closed`` in place of the command's own output: the feed of
+``cat r.sh | bash`` was lost and the guard failed open.
+"""
+
+from __future__ import annotations
+
+import shlex
+
+import pytest
+
+from cron.lifecycle_guard import scan_gateway_lifecycle
+
+# Assembled so this file's own text never carries the literal command.
+LIFECYCLE = " ".join(["hermes", "gateway", "re" + "start"])
+
+
+@pytest.fixture
+def files(tmp_path) -> dict[str, str]:
+    sh = tmp_path / "r.sh"
+    sh.write_text(f"#!/bin/sh\necho hi\n{LIFECYCLE}\n", encoding="utf-8")
+    py = tmp_path / "r.py"
+    py.write_text(f"import os\nos.system({LIFECYCLE!r})\n", encoding="utf-8")
+    return {name: shlex.quote(str(path)) for name, path in {"sh": sh, "py": py}.items()}
+
+
+@pytest.mark.parametrize(
+    "template",
+    [
+        "(true); cat {sh} | bash",
+        "(echo hi); cat {sh} | bash",
+        "(true) && cat {sh} | bash",
+        "(true) || cat {sh} | bash",
+        "(true) & cat {sh} | bash",
+        "(echo hi; true); cat {py} | python3",
+        "( (true) ); cat {sh} | bash",
+    ],
+)
+def test_closed_subshell_output_does_not_outlive_the_next_operator(files, template):
+    assert scan_gateway_lifecycle(template.format(**files)) == (True, None)
+
+
+@pytest.mark.parametrize(
+    "template",
+    [
+        # The subshell's output went to its own `;`, not into the later pipe.
+        "(cat {sh}); echo x | bash",
+        "(cat {sh}) && echo x | bash",
+    ],
+)
+def test_closed_subshell_output_does_not_feed_a_later_pipe(files, template):
+    assert scan_gateway_lifecycle(template.format(**files)) == (False, None)
-- 
