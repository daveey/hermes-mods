+      - name: Plan Python tests (affected files on PRs, full suite otherwise)
+        # Pull requests run the test files their change can reach plus a smoke set
+        # (scripts/ci/affected_tests.py); every other event, the label ci:full-tests, a failed
+        # compare (empty list) or a list at the compare API's 300-file cap runs the full suite.
+        # Main pushes still run everything, so a miss surfaces there. Each tests.yml slice
+        # recomputes the same file list from `changed` and its own checkout.
+        id: python-plan
+        env:
+          EVENT_NAME: ${{ github.event_name }}
+          FULL_LABEL: ${{ contains(github.event.pull_request.labels.*.name, 'ci:full-tests') }}
+        run: |
+          set -euo pipefail
+          changed_file="$RUNNER_TEMP/detect-changed-files.txt"
+          mapfile -t changed < <(grep -v '^$' "$changed_file" 2>/dev/null || true)
+          full=""
+          if [ "$EVENT_NAME" != "pull_request" ]; then full="$EVENT_NAME runs the full suite"
+          elif [ "$FULL_LABEL" = "true" ]; then full="label ci:full-tests"
+          elif [ "${#changed[@]}" -eq 0 ]; then full="no changed-file list from the compare API"
+          elif [ "${#changed[@]}" -ge 300 ]; then full="${#changed[@]} changed files (compare API caps the list at 300)"
+          fi
+          plan_out="$RUNNER_TEMP/python-plan.txt"
+          if [ -n "$full" ]; then
+            python3 scripts/ci/affected_tests.py --full "$full" --github-output "$plan_out" > /dev/null
+          else
+            python3 scripts/ci/affected_tests.py --changed "${changed[@]}" --github-output "$plan_out" > /dev/null
+          fi
+          cat "$plan_out"
