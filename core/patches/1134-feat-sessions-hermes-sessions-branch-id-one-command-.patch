+          reason=$(sed -n 's/^reason=//p' "$plan_out")
+          slices=$(sed -n 's/^slices=//p' "$plan_out")
+          echo "slices=$slices" >> "$GITHUB_OUTPUT"
+          {
+            echo "changed<<CHANGED_EOF"
+            if [ "$mode" = "affected" ]; then printf '%s\n' "${changed[@]}"; fi
+            echo "CHANGED_EOF"
+          } >> "$GITHUB_OUTPUT"
+          echo "### Python tests: $mode ($reason)" >> "$GITHUB_STEP_SUMMARY"
