From f5ec2367c980e0b1d6bad394705671236bbc39de Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 21 Oct 2026 15:08:22 -0700
Subject: [PATCH] fix(kanban): worker guidance pairs every git worktree add
 with git worktree remove before kanban_complete [daveey]

---
 agent/prompt_builder.py           |  3 +++
 tests/agent/test_system_prompt.py | 11 +++++++++++
 2 files changed, 14 insertions(+)

diff --git a/agent/prompt_builder.py b/agent/prompt_builder.py
index 44df54887b..1232e68dd9 100644
--- a/agent/prompt_builder.py
+++ b/agent/prompt_builder.py
@@ -333,6 +333,9 @@ KANBAN_GUIDANCE = (
     "<path> ${HERMES_KANBAN_BRANCH:-wt/$HERMES_KANBAN_TASK}` from the main repo, then cd there. For a project-linked "
     "task the workspace is a fresh `<repo>/.worktrees/<task-id>` and `$HERMES_KANBAN_BRANCH` a deterministic "
     "`<project-slug>/<task-id>` — the main repo is two levels up, so run `git worktree add` from there.\n"
+    "- **Worktrees you create.** Any other `git worktree add` you run (nested in the workspace, a sibling "
+    "`~/code/<repo>-<slug>`, `$TMPDIR`) is yours to remove: `git worktree remove <path>` once its branch is "
+    "pushed, merged or abandoned, before `kanban_complete` (the branch survives). Name in the handoff any you must leave.\n"
     "- **Deliverables.** Files a human wants go in `kanban_complete(artifacts=[<absolute paths>])` (top-level param; "
     "paths in `metadata` are NOT uploaded). Files must exist at completion.\n"
     "- **Attachments.** Attach real downloadable artifacts instead of pasting links in comments: `kanban_attach` "
diff --git a/tests/agent/test_system_prompt.py b/tests/agent/test_system_prompt.py
index e7c660d1e4..35a5ac0176 100644
--- a/tests/agent/test_system_prompt.py
+++ b/tests/agent/test_system_prompt.py
@@ -970,3 +970,14 @@ def test_kanban_guidance_routes_timed_waits_to_schedule_not_block():
     assert 'kind=\\"time\\"' in repr(KANBAN_GUIDANCE) or 'kind="time"' in KANBAN_GUIDANCE
     assert "time" in KANBAN_BLOCK_SCHEMA["parameters"]["properties"]["kind"]["enum"]
     assert "kind='time'" in KANBAN_BLOCK_SCHEMA["description"]
+
+
+def test_kanban_guidance_makes_the_worker_remove_worktrees_it_creates():
+    """Every `git worktree add` instruction needs a matching remove step: an audit found 630 leaked worktrees,
+    ~100 of them made by Kanban workers that completed without `git worktree remove`. [daveey]"""
+    from agent.prompt_builder import KANBAN_GUIDANCE
+
+    assert "git worktree add" in KANBAN_GUIDANCE
+    assert "git worktree remove" in KANBAN_GUIDANCE
+    i = KANBAN_GUIDANCE.index("git worktree remove")
+    assert "kanban_complete" in KANBAN_GUIDANCE[i - 400:i + 400]
-- 
2.54.0 (Apple Git-157)

