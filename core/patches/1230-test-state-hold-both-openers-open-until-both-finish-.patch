From 16bc0e6ef1002e0ce20a3758f14e0f756d1e657c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 12:09:32 +0000
Subject: [PATCH] test(state): hold both openers open until both finish so
 close() cannot race the other open

---
 .../hermes_state/test_zeroed_db_quarantine_race.py | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/tests/hermes_state/test_zeroed_db_quarantine_race.py b/tests/hermes_state/test_zeroed_db_quarantine_race.py
index e6e34bbb92c..59a896cb291 100644
--- a/tests/hermes_state/test_zeroed_db_quarantine_race.py
+++ b/tests/hermes_state/test_zeroed_db_quarantine_race.py
@@ -41,11 +41,23 @@ def test_preflight_cannot_observe_db_mid_quarantine(tmp_path, monkeypatch):
             late_reached.set()  # about to block on the lock worker 0 holds
         return real_lock(path, *args, **kwargs)
 
+    late_done = threading.Event()
+
     def worker(idx):
+        # Neither opener closes until BOTH have opened: a close() unlinks -wal/-shm (and retires the
+        # WAL generation), which would race the other opener's chmod/generation check. That close
+        # race is not what this test covers (the sidecar tolerance has its own test below).
+        db_obj = None
         try:
-            hs.SessionDB(db_path=db).close()
+            db_obj = hs.SessionDB(db_path=db)
         except Exception as exc:  # surfaced by the assertions below
             errors[idx] = exc
+        if idx == 1:
+            late_done.set()
+        else:
+            late_done.wait(20)
+        if db_obj is not None:
+            db_obj.close()
 
     late = threading.Thread(target=worker, args=(1,), name="late-opener")
 
-- 
