diff --git a/apps/desktop/src/plugins/hub-sync/api.ts b/apps/desktop/src/plugins/hub-sync/api.ts
new file mode 100644
index 0000000000..66e322d3cb
--- /dev/null
+++ b/apps/desktop/src/plugins/hub-sync/api.ts
@@ -0,0 +1,110 @@
+/**
+ * [daveey] Data side of the hub-sync sidebar section: replica session rows for
+ * gateways that are not live right now, and the owner requests their actions
+ * send. Best-effort throughout: with hub-sync/hermes-hub missing or the hub
+ * down every read answers [] and the live sidebar is untouched.
+ */
+import { $connectionsRegistry } from '@/store/connection-registry-state'
+import {
+  connectionForHubGateway,
+  hubGatewayForConnection,
+  hubGet,
+  hubReplicaConnectionId,
+  hubRequest,
+  type HubRequestResult,
+  learnHubGatewayName
+} from '@/store/hub-sync'
+import type { SessionInfo } from '@/types/hermes'
+
+import {
+  type HubSessionAction,
+  type HubSessionRow,
+  type LiveSessionKey,
+  replicaSessionsToShow,
+  sessionRequestBody
+} from './model'
+
+const REPLICA_LIMIT = 300
+
+type LiveRow = Pick<SessionInfo, 'connection_id' | 'id'>
+
+/** Hub gateway name of a live row (untagged rows belong to the primary). */
+function liveRowGateway(row: LiveRow, primary: string): string {
+  const connectionId = row.connection_id?.trim() || primary
+
+  return hubGatewayForConnection(connectionId) ?? connectionId
+}
+
+export function liveSessionKeys(live: readonly LiveRow[]): LiveSessionKey[] {
+  const primary = hubReplicaConnectionId()
+
+  return live.filter(row => row?.id).map(row => ({ gateway: liveRowGateway(row, primary), id: row.id }))
+}
+
+/** Registered non-primary connections that answer hub-sync `/status` now. */
+export async function reachableConnections(): Promise<Set<string>> {
+  const primary = hubReplicaConnectionId()
+  const ids = ($connectionsRegistry.get()?.connections ?? []).map(c => c.id).filter(id => id && id !== primary)
+  const answers = await Promise.all(ids.map(async id => ((await learnHubGatewayName(id)) ? id : null)))
+
+  return new Set(answers.filter((id): id is string => Boolean(id)))
+}
+
+/**
+ * Replica rows the sidebar should add: gateways that neither answered a
+ * status probe nor contributed rows to the live list (unreachable or not
+ * registered on this Desktop), deduped against the live list by (gateway, id).
+ */
+export async function loadReplicaSidebarRows(live: readonly LiveRow[]): Promise<HubSessionRow[]> {
+  const primary = hubReplicaConnectionId()
+  const [result, reachable] = await Promise.all([
+    hubGet<{ sessions?: HubSessionRow[] }>(`/sessions?limit=${REPLICA_LIMIT}`, primary),
+    reachableConnections()
+  ])
+
+  const rows = Array.isArray(result?.sessions) ? result.sessions : []
+
+  if (!rows.length) {
+    return []
+  }
+
+  const liveConnections = new Set(live.map(row => row.connection_id?.trim() || primary))
+  const primaryName = hubGatewayForConnection(primary)
+
+  const isGatewayLive = (gateway: string) => {
+    if (gateway === primaryName) {
+      return true
+    }
+
+    const connectionId = connectionForHubGateway(gateway)
+
+    return Boolean(connectionId && (reachable.has(connectionId) || liveConnections.has(connectionId)))
+  }
+
+  return replicaSessionsToShow(rows, liveSessionKeys(live), isGatewayLive)
+}
+
+/** Queue `action` on the row's owning gateway (offline-safe on the primary). */
+export function sendSessionAction(
+  row: HubSessionRow,
+  action: HubSessionAction,
+  args?: Record<string, unknown>
+): Promise<HubRequestResult> {
+  return hubRequest(sessionRequestBody(row, action, args))
+}
+
+/** Owner route for opening a replica row; null when this Desktop has no
+ *  connection for the row's gateway. */
+export function replicaRowRoute(row: HubSessionRow) {
+  const connectionId = connectionForHubGateway(row.gateway)
+
+  if (!connectionId) {
+    return null
+  }
+
+  const profile = row.profile?.trim() || 'default'
+  const kind = ($connectionsRegistry.get()?.connections ?? []).find(c => c.id === connectionId)?.kind
+  const mode = kind === 'local' ? ('local' as const) : ('remote' as const)
+
+  return { connectionId, mode, profile, targetProfile: profile }
+}
diff --git a/apps/desktop/src/plugins/hub-sync/model.test.ts b/apps/desktop/src/plugins/hub-sync/model.test.ts
new file mode 100644
index 0000000000..4d88f40cd6
--- /dev/null
+++ b/apps/desktop/src/plugins/hub-sync/model.test.ts
@@ -0,0 +1,93 @@
+import { describe, expect, it } from 'vitest'
+
+import {
+  type HubSessionRow,
+  isRowPending,
+  markRowPending,
+  replicaSessionsToShow,
+  sessionRequestBody,
+  syncedAgo
+} from './model'
+
+// [daveey] Sidebar rows for sessions on gateways that aren't live right now,
+// read from the window gateway's hermes-hub replica (hub-sync plugin REST).
+
+const row = (gateway: string, id: string, extra: Partial<HubSessionRow> = {}): HubSessionRow => ({
+  gateway,
+  id,
+  key: `default/${id}`,
+  local: false,
+  profile: 'default',
+  stale: false,
+  synced_at: 1_000,
+  title: id,
+  version: 3,
+  ...extra
+})
+
+describe('replicaSessionsToShow', () => {
+  it('shows only gateways that are not live, never the local gateway', () => {
+    const hub = [row('mac', 's_local', { local: true }), row('mini', 's_mini'), row('cloud', 's_cloud')]
+    const shown = replicaSessionsToShow(hub, [], gw => gw === 'cloud')
+
+    expect(shown.map(r => r.id)).toEqual(['s_mini'])
+  })
+
+  it('keeps live data primary: a row the live list already has for that gateway is dropped', () => {
+    const hub = [row('mini', 's_a'), row('mini', 's_b')]
+    const live = [{ gateway: 'mini', id: 's_a' }]
+
+    expect(replicaSessionsToShow(hub, live, () => false).map(r => r.id)).toEqual(['s_b'])
+  })
+
+  it('dedupes by (gateway, session id): same id on another gateway is a different row', () => {
+    const hub = [row('mini', 's_x'), row('mini', 's_x', { key: 'bb/s_x' }), row('cloud', 's_x')]
+    const live = [{ gateway: 'laptop', id: 's_x' }]
+
+    expect(replicaSessionsToShow(hub, live, () => false).map(r => `${r.gateway}:${r.id}`)).toEqual([
+      'mini:s_x',
+      'cloud:s_x'
+    ])
+  })
+
+  it('drops archived and hidden replica rows', () => {
+    const hub = [row('mini', 's_a', { archived: true }), row('mini', 's_b', { hidden: true }), row('mini', 's_c')]
+
+    expect(replicaSessionsToShow(hub, [], () => false).map(r => r.id)).toEqual(['s_c'])
+  })
+})
+
+describe('syncedAgo', () => {
+  it('formats the replica age', () => {
+    const now = 10_000_000
+
+    expect(syncedAgo(now / 1000 - 20, now)).toBe('synced just now')
+    expect(syncedAgo(now / 1000 - 5 * 60, now)).toBe('synced 5m ago')
+    expect(syncedAgo(now / 1000 - 3 * 3600, now)).toBe('synced 3h ago')
+    expect(syncedAgo(now / 1000 - 2 * 86_400, now)).toBe('synced 2d ago')
+    expect(syncedAgo(null, now)).toBe('never synced')
+  })
+})
+
+describe('owner requests', () => {
+  it('builds a sessions request for the owning gateway with the record version', () => {
+    expect(sessionRequestBody(row('mini', 's_a'), 'rename', { title: 'New' })).toEqual({
+      action: 'rename',
+      args: { title: 'New' },
+      base_version: 3,
+      coll: 'sessions',
+      gateway: 'mini',
+      key: 'default/s_a'
+    })
+  })
+
+  it('marks a row pending optimistically and reads the marker back', () => {
+    const rows = [row('mini', 's_a'), row('mini', 's_b')]
+    const next = markRowPending(rows, rows[1], { action: 'archive', id: 'r1', state: 'local' })
+
+    expect(isRowPending(next[0])).toBe(false)
+    expect(isRowPending(next[1])).toBe(true)
+    expect(next[1].pending?.[0].action).toBe('archive')
+    expect(rows[1].pending).toBeUndefined()
+  })
+})
diff --git a/apps/desktop/src/plugins/hub-sync/model.ts b/apps/desktop/src/plugins/hub-sync/model.ts
new file mode 100644
index 0000000000..b7fd34601f
--- /dev/null
+++ b/apps/desktop/src/plugins/hub-sync/model.ts
@@ -0,0 +1,110 @@
+/**
+ * [daveey] Pure model for the hub-sync sidebar section: which replica session
+ * rows to show, how old they are, and the owner requests their actions send.
+ * See ./plugin.tsx and ../../store/hub-sync.ts.
+ */
+import type { HubPending, HubRecord, HubRequestBody } from '@/store/hub-sync'
+
+export interface HubSessionRow extends HubRecord {
+  id: string
+  profile?: string
+  title?: null | string
+  source?: null | string
+  activity?: null | number
+  archived?: boolean
+  hidden?: boolean
+  pinned?: boolean
+  running?: boolean
+}
+
+/** A live sidebar row reduced to what dedupe needs: its hub gateway + id. */
+export interface LiveSessionKey {
+  gateway: string
+  id: string
+}
+
+/**
+ * Replica rows worth a sidebar row: other gateways only, never one that is
+ * live right now (its live rows are primary), never a (gateway, id) the live
+ * list already has, archived/hidden dropped, first copy per (gateway, id).
+ */
+export function replicaSessionsToShow(
+  hub: readonly HubSessionRow[],
+  live: readonly LiveSessionKey[],
+  isGatewayLive: (gateway: string) => boolean
+): HubSessionRow[] {
+  const seen = new Set(live.map(entry => `${entry.gateway}\u0000${entry.id}`))
+  const out: HubSessionRow[] = []
+
+  for (const record of hub) {
+    if (!record?.id || record.local || record.archived || record.hidden || isGatewayLive(record.gateway)) {
+      continue
+    }
+
+    const key = `${record.gateway}\u0000${record.id}`
+
+    if (seen.has(key)) {
+      continue
+    }
+
+    seen.add(key)
+    out.push(record)
+  }
+
+  return out
+}
+
+/** "synced 5m ago" from an epoch-seconds stamp. */
+export function syncedAgo(syncedAt: null | number | undefined, nowMs: number = Date.now()): string {
+  if (!syncedAt) {
+    return 'never synced'
+  }
+
+  const seconds = Math.max(0, nowMs / 1000 - syncedAt)
+
+  if (seconds < 60) {
+    return 'synced just now'
+  }
+
+  if (seconds < 3600) {
+    return `synced ${Math.floor(seconds / 60)}m ago`
+  }
+
+  if (seconds < 86_400) {
+    return `synced ${Math.floor(seconds / 3600)}h ago`
+  }
+
+  return `synced ${Math.floor(seconds / 86_400)}d ago`
+}
+
+export type HubSessionAction = 'archive' | 'pin' | 'rename' | 'unpin'
+
+/** The owner request for an action on a replica row (optimistic-concurrency
+ *  checked against the record version the row was read at). */
+export function sessionRequestBody(
+  row: HubSessionRow,
+  action: HubSessionAction,
+  args?: Record<string, unknown>
+): HubRequestBody {
+  return {
+    action,
+    ...(args ? { args } : {}),
+    base_version: row.version,
+    coll: 'sessions',
+    gateway: row.gateway,
+    key: row.key
+  }
+}
+
+/** Copy of `rows` with `target` carrying a pending marker (immutable). */
+export function markRowPending<T extends HubRecord>(rows: readonly T[], target: T, pending: HubPending): T[] {
+  return rows.map(record =>
+    record.gateway === target.gateway && record.key === target.key
+      ? { ...record, pending: [...(record.pending ?? []), pending] }
+      : record
+  )
+}
+
+export function isRowPending(record: Pick<HubRecord, 'pending'>): boolean {
+  return Boolean(record.pending?.some(entry => entry.state === 'local' || entry.state === 'queued'))
+}
diff --git a/apps/desktop/src/plugins/hub-sync/plugin.tsx b/apps/desktop/src/plugins/hub-sync/plugin.tsx
