From 41f2076490e2598732c7cb4e63de4b7f3c662422 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 20 Nov 2026 04:15:15 +0000
Subject: [PATCH] [daveey] test(selfwork): pin guard-freeze default,
 create-path refusal and oldest-owner order

---
 .../test_kanban_selfwork_guard_entry.py       | 21 +++++++++++++++++++
 .../hermes_cli/test_kanban_selfwork_guards.py |  8 +++++++
 2 files changed, 29 insertions(+)

diff --git a/tests/hermes_cli/test_kanban_selfwork_guard_entry.py b/tests/hermes_cli/test_kanban_selfwork_guard_entry.py
index 1f120de115..1ead06b939 100644
--- a/tests/hermes_cli/test_kanban_selfwork_guard_entry.py
+++ b/tests/hermes_cli/test_kanban_selfwork_guard_entry.py
@@ -38,3 +38,24 @@ def test_guard_policy_at_entry(request_envelope, monkeypatch, capsys, surface, m
         else:
             assert result.get('created') is True, result
     assert len([r for r in caplog.records if 'guard creation frozen' in r.message]) == (mode in {'refuse', 'append'})
+
+
+def test_shipped_default_is_on(request_envelope):
+    """No config patching: the real DEFAULT_CONFIG merge must freeze guards."""
+    request_envelope['args']['create']['self_work']['kind'] = 'guard'
+    result = receive(request_envelope)
+    assert result['status'] == 'rejected' and result['code'] == 'self_work_guard_frozen', result
+    with kbc.connect_closing() as conn:
+        assert not kb.list_tasks(conn)
+
+
+def test_create_path_refusal_stays_definitive(request_envelope, monkeypatch):
+    """Switch reads off during replay, on during admit: still rejected, not retryable pending."""
+    from hermes_cli import kanban_selfwork_guards as module
+    reads = iter([False])
+    monkeypatch.setattr(module, "frozen", lambda: next(reads, True))
+    request_envelope['args']['create']['self_work']['kind'] = 'guard'
+    result = receive(request_envelope)
+    assert result['status'] == 'rejected' and result['code'] == 'self_work_guard_frozen', result
+    with kbc.connect_closing() as conn:
+        assert not kb.list_tasks(conn)
diff --git a/tests/hermes_cli/test_kanban_selfwork_guards.py b/tests/hermes_cli/test_kanban_selfwork_guards.py
index bd7fc23ebb..f23c6d64eb 100644
--- a/tests/hermes_cli/test_kanban_selfwork_guards.py
+++ b/tests/hermes_cli/test_kanban_selfwork_guards.py
@@ -103,3 +103,11 @@ def test_malformed_switch_does_not_unfreeze(board, settings, bad):
     settings['freeze_guards'] = bad
     with pytest.raises(policy.SelfWorkError, match='freeze_guards'):
         admit(board)
+
+
+def test_oldest_open_guard_owner_receives(board, settings):
+    older, newer = seed(board), seed(board)
+    board.execute('UPDATE tasks SET created_at=100 WHERE id=?', (older,))
+    board.execute('UPDATE tasks SET created_at=200 WHERE id=?', (newer,))
+    board.commit()
+    assert admit(board)['task_id'] == older
-- 
