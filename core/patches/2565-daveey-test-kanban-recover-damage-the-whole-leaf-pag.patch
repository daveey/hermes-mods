From ada5cda08f0373dbcfaab9abda4709f11501640d Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 12 Nov 2026 09:11:23 +0000
Subject: [PATCH] [daveey] test(kanban-recover): damage the whole leaf page so
 every read fails closed

Deflakes test_stale_index_entries_of_deleted_rows_are_not_filled_back_in
(CI run 43176433429: filled_from_backup 17 != 16, stale_index_entries 39).

_damage_table kept the leaf header and overwrote only the cell area with
0xff. The 0xffff cell pointers mask to the page's last byte, so SQLite's cell
parse ran past the page buffer into adjacent memory: depending on heap state a
scan of the damaged page returned rows with random rowids (0, 16265, 928777,
...) instead of SQLITE_CORRUPT. Those rows fail NOT NULL and are dropped on
insert, so usually nothing showed; when a garbage rowid equalled one of the 40
deleted rows, the salvage skipped that rid's stale point lookup and the backup
fill resurrected it (recovered 1448 = 1447 + the garbage row, stale 39, filled
17 -- exactly the CI numbers).

Overwriting the page header too (page type 0xff) makes every access fail with
SQLITE_CORRUPT. Measured on the recover path: garbage rowids salvaged in
186/360 runs before, 0/360 after; all six salvage scans now stop on the page.
---
 tests/hermes_cli/test_kanban_db_recover.py | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/tests/hermes_cli/test_kanban_db_recover.py b/tests/hermes_cli/test_kanban_db_recover.py
index 7932414945..f6e51b8bd1 100644
--- a/tests/hermes_cli/test_kanban_db_recover.py
+++ b/tests/hermes_cli/test_kanban_db_recover.py
@@ -95,7 +95,13 @@ def _leaf_rowids(data: bytes, page_size: int, page: int) -> list[int]:
 
 
 def _damage_table(path: Path, table: str) -> list[int]:
-    """Overwrite the cell area of a middle leaf page of ``table``; return the rowids it held."""
+    """Overwrite a middle leaf page of ``table`` whole, header included; return the rowids it held.
+
+    The page type byte becomes 0xff, which SQLite rejects on every access (SQLITE_CORRUPT). Keeping a
+    valid leaf header over a garbage cell area is not deterministic: its cell pointers mask to the
+    page's last byte, so the cell parse runs into whatever memory follows the page buffer and some
+    reads return rows with random rowids (0, 16265, ...) instead of an error. One that equals a deleted
+    row's rowid hid that row's stale index entry and made the backup fill resurrect it (CI flake)."""
     conn = sqlite3.connect(path)
     root = conn.execute("SELECT rootpage FROM sqlite_master WHERE type='table' AND name=?", (table,)).fetchone()[0]
     conn.close()
@@ -107,8 +113,8 @@ def _damage_table(path: Path, table: str) -> list[int]:
     rowids = _leaf_rowids(data, page_size, page)
     off = (page - 1) * page_size
     with open(path, "r+b") as fh:
-        fh.seek(off + 8)
-        fh.write(b"\xff" * (page_size - 8))
+        fh.seek(off)
+        fh.write(b"\xff" * page_size)
     return rowids
 
 
