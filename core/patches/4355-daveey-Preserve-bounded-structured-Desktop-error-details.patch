+import { expect, test, vi } from 'vitest'
+
+import { errorDiagnostic, errorField } from './error-diagnostic'
+
+test('preserves legacy strings and Error messages', () => {
+  expect(errorDiagnostic('text', 'fallback')).toEqual({ text: 'text', codes: '' })
+  expect(errorDiagnostic(new Error('error'), 'fallback')).toEqual({ text: 'error', codes: '' })
+})
+
+test('ignores nonobjects, inherited fields, empty text, and unsafe code payloads', () => {
+  for (const value of [null, undefined, 0, true, () => {}, Object.create({ message: 'inherited' })]) {
+    expect(errorDiagnostic(value, 'fallback')).toEqual({ text: 'fallback', codes: '' })
+    expect(errorField(value, 'message')).toBeUndefined()
+  }
+
+  expect(errorDiagnostic({ detail: ' ', message: ' useful ', code: 'secret' }, 'fallback')).toEqual({
+    text: 'useful',
+    codes: ''
+  })
+  expect(errorDiagnostic({ code: { token: 'secret' } }, 'fallback').codes).toBe('')
+  expect(errorDiagnostic({ code: `storage_${'x'.repeat(1000)}` }, 'fallback').codes).toBe('')
+  expect(errorDiagnostic({ code: 42 }, 'fallback').codes).toBe('')
+})
+
+test('visits a cycle only once', () => {
+  const cycle: { detail?: unknown; code: string } = { code: 'storage_locked' }
+  cycle.detail = cycle
+  expect(errorDiagnostic(cycle, 'fallback').codes).toBe('{"code":"storage_locked"}')
+})
+
+test('does not invoke accessors and tolerates descriptor lookup refusal', () => {
+  const getter = vi.fn(() => {
+    throw new Error('unsafe')
+  })
+
+  const object = Object.defineProperty({}, 'message', { get: getter })
+  expect(errorDiagnostic(object, 'fallback').text).toBe('fallback')
+  expect(getter).not.toHaveBeenCalled()
+
+  const proxy = new Proxy(
+    {},
+    {
+      getOwnPropertyDescriptor() {
+        throw new Error('denied')
+      }
+    }
+  )
+
+  expect(errorDiagnostic(proxy, 'fallback').text).toBe('fallback')
+})
+
+test('bounds breadth independently of depth while retaining earlier codes', () => {
+  let reads = 0
+
+  const tree = (depth: number): object =>
+    new Proxy(
+      {},
+      {
+        getOwnPropertyDescriptor(_target, key) {
+          reads++
+
+          return { configurable: true, value: key === 'code' ? 'storage_locked' : depth ? tree(depth - 1) : undefined }
+        }
+      }
+    )
+
+  const result = errorDiagnostic(tree(5), 'fallback')
+  expect(reads).toBe(32 * 5)
+  expect(result.codes.split(' ')).toHaveLength(32)
+  expect(result.text).toBe('fallback')
+})
diff --git a/apps/desktop/src/lib/error-diagnostic.ts b/apps/desktop/src/lib/error-diagnostic.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2049c84fbd98ac65df973613c8d4e45a61f315f5
--- /dev/null
+++ b/apps/desktop/src/lib/error-diagnostic.ts
@@ -0,0 +1,71 @@
+// Deliberately never stringify the thrown object: RPC envelopes can carry credentials,
+// request bodies, cycles, accessors and user-defined toJSON implementations.
+const MAX_TEXT = 8192
+const MAX_DEPTH = 6
+const MAX_NODES = 32
+
+export function errorField(value: unknown, key: string): unknown {
+  if (!value || typeof value !== 'object') {
+    return undefined
+  }
+
+  try {
+    return Object.getOwnPropertyDescriptor(value, key)?.value
+  } catch {
+    return undefined
+  }
+}
+
+export function errorDiagnostic(error: unknown, fallback: string): { text: string; codes: string } {
+  if (typeof error === 'string') {
+    return { text: error, codes: '' }
+  }
+
+  if (error instanceof Error) {
+    return { text: error.message, codes: '' }
+  }
+
+  const seen = new Set<object>()
+  const codes: string[] = []
+
+  function visit(value: unknown, depth: number): string | undefined {
+    if (depth > MAX_DEPTH) {
+      return undefined
+    }
+
+    if (typeof value === 'string') {
+      return value.slice(0, MAX_TEXT).trim() || undefined
+    }
+
+    if (!value || typeof value !== 'object' || seen.has(value) || seen.size >= MAX_NODES) {
+      return undefined
+    }
+
+    seen.add(value)
+    const code = errorField(value, 'code')
+
+    // Only classification tokens, not arbitrary fields or code payloads.
+    if (
+      typeof code === 'string' &&
+      code.length <= 128 &&
+      /^(storage_[a-z_]+|disk_full|gateway_auth_failed|invalid_api_key)$/.test(code)
+    ) {
+      codes.push(JSON.stringify({ code }))
+    }
+
+    let text: string | undefined
+
+    // Inner diagnostic detail wins over generic RPC wrapper messages. Continue
+    // the bounded walk to retain classification codes even after finding text.
+    for (const key of ['detail', 'data', 'error', 'message']) {
+      const candidate = visit(errorField(value, key), depth + 1)
+      text ??= candidate
+    }
+
+    return text
+  }
+
+  const text = visit(error, 0) ?? fallback
+
+  return { text, codes: codes.join(' ') }
+}
diff --git a/apps/desktop/src/store/notifications-objects.test.ts b/apps/desktop/src/store/notifications-objects.test.ts
