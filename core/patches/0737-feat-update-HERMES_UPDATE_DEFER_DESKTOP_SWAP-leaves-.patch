From a82898b665881c30e832d7b6c2db1e50ab8ca49c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 28 Oct 2026 05:55:01 -0700
Subject: [PATCH] feat(update): HERMES_UPDATE_DEFER_DESKTOP_SWAP leaves a
 running Desktop's bundle in place [daveey]

hermes-sync sets it for updates applied while Desktop is open, so the swap no longer stops and
relaunches the UI under the user; it swaps the bundle on the next quit or while the user is away.
Unset = upstream behaviour. t_01a1825a82e472f6
---
 hermes_cli/source_build.py            | 23 ++++++++++++++
 tests/hermes_cli/test_source_build.py | 45 +++++++++++++++++++++++++++
 2 files changed, 68 insertions(+)

diff --git a/hermes_cli/source_build.py b/hermes_cli/source_build.py
index 2e271679f4..1e544bc09d 100644
--- a/hermes_cli/source_build.py
+++ b/hermes_cli/source_build.py
@@ -232,6 +232,23 @@ def build_update_products(project_root: Path, *, desktop: bool) -> None:
         raise ProductBuildError(failures)
 
 
+# [daveey] Set by hermes-sync for updates it applies while a Desktop is open: leave the running app's
+# bundle in place (no build, no swap, no stop/relaunch). Unset = upstream behaviour.
+DEFER_DESKTOP_SWAP_ENV = "HERMES_UPDATE_DEFER_DESKTOP_SWAP"
+
+
+def _defer_desktop_swap(desktop_dir: Path) -> bool:
+    """True when the caller asked to defer the swap and a Desktop main process runs from this release tree."""
+    if os.environ.get(DEFER_DESKTOP_SWAP_ENV, "").strip().lower() not in ("1", "true", "yes"):
+        return False
+    from hermes_cli import main_desktop
+
+    try:
+        return bool(main_desktop._desktop_main_launches(desktop_dir))
+    except Exception:  # health: allow BLE001 -- unknown process table: swap as upstream does
+        return False
+
+
 def _build_desktop_product(project_root: Path, env: dict, publish_stage) -> None:
     from hermes_cli.main_desktop import (
         DESKTOP_PREBUILT_APP_ENV, _packaged_desktop_current_for_head, _refresh_installed_desktop_apps,
@@ -240,6 +257,12 @@ def _build_desktop_product(project_root: Path, env: dict, publish_stage) -> None
     desktop_dir = project_root / "apps/desktop"
     if _packaged_desktop_current_for_head(desktop_dir, project_root):
         print("  ✓ Desktop app is up to date")
+    elif _defer_desktop_swap(desktop_dir):
+        # [daveey] The swap would stop the running Desktop (UI relaunch) under the user. hermes-sync
+        # swaps the bundle on the next quit or while the user is away (t_01a1825a82e472f6).
+        print("  ⓘ Desktop app swap deferred: the desktop app is running (HERMES_UPDATE_DEFER_DESKTOP_SWAP); "
+              "the rebuilt app is installed after it quits")
+        return
     else:
         publish_stage("Building the desktop app")
         # The desktop build mutates checkout-scoped node_modules and
diff --git a/tests/hermes_cli/test_source_build.py b/tests/hermes_cli/test_source_build.py
index 2502ab3b5d..35f489b64e 100644
--- a/tests/hermes_cli/test_source_build.py
+++ b/tests/hermes_cli/test_source_build.py
@@ -578,6 +578,51 @@ def test_update_swaps_in_a_prebuilt_from_an_ancestor_with_unchanged_desktop_inpu
     assert live.read_text() == "prebuilt app"
 
 
+@pytest.mark.platforms("macos")
+def test_defer_desktop_swap_leaves_a_running_desktop_alone(tmp_path, monkeypatch, capsys):
+    """[daveey] HERMES_UPDATE_DEFER_DESKTOP_SWAP=1 (hermes-sync, while Desktop is open): the core update
+    lands but the bundle is neither built nor swapped, so the running Desktop is never stopped
+    (t_01a1825a82e472f6). hermes-sync swaps it on the next quit or while the user is away."""
+    from hermes_cli import main_desktop
+    from hermes_cli.source_build import _build_desktop_product
+
+    root, desktop_dir, built = _prebuilt_fixture(tmp_path, monkeypatch)
+    monkeypatch.setenv("HERMES_UPDATE_DEFER_DESKTOP_SWAP", "1")
+    monkeypatch.setattr(main_desktop, "_desktop_main_launches", lambda _d: {4242: []})
+    stopped = []
+    monkeypatch.setattr(main_desktop, "_stop_desktop_processes_locking_build",
+                        lambda *a, **k: stopped.append(a) or [4242])
+    _build_desktop_product(root, {"PATH": os.environ["PATH"]}, lambda _label: None)
+    assert built == [] and stopped == []
+    assert (desktop_dir / "release/mac-arm64/Hermes.app/Contents/MacOS/Hermes").read_text() == "previous app"
+    assert "desktop app swap deferred" in capsys.readouterr().out.lower()
+
+
+@pytest.mark.platforms("macos")
+def test_defer_desktop_swap_still_installs_when_desktop_is_not_running(tmp_path, monkeypatch):
+    """With the flag but no Desktop main process (it quit), the swap runs as usual."""
+    from hermes_cli import main_desktop
+    from hermes_cli.source_build import _build_desktop_product
+
+    root, desktop_dir, _built = _prebuilt_fixture(tmp_path, monkeypatch)
+    monkeypatch.setenv("HERMES_UPDATE_DEFER_DESKTOP_SWAP", "1")
+    monkeypatch.setattr(main_desktop, "_desktop_main_launches", lambda _d: {})
+    _build_desktop_product(root, {"PATH": os.environ["PATH"]}, lambda _label: None)
+    assert (desktop_dir / "release/mac-arm64/Hermes.app/Contents/MacOS/Hermes").read_text() == "prebuilt app"
+
+
+@pytest.mark.platforms("macos")
+def test_without_the_defer_flag_a_running_desktop_is_swapped_as_upstream(tmp_path, monkeypatch):
+    from hermes_cli import main_desktop
+    from hermes_cli.source_build import _build_desktop_product
+
+    root, desktop_dir, _built = _prebuilt_fixture(tmp_path, monkeypatch)
+    monkeypatch.delenv("HERMES_UPDATE_DEFER_DESKTOP_SWAP", raising=False)
+    monkeypatch.setattr(main_desktop, "_desktop_main_launches", lambda _d: {4242: []})
+    _build_desktop_product(root, {"PATH": os.environ["PATH"]}, lambda _label: None)
+    assert (desktop_dir / "release/mac-arm64/Hermes.app/Contents/MacOS/Hermes").read_text() == "prebuilt app"
+
+
 @pytest.mark.platforms("macos")
 @pytest.mark.parametrize("change", ["apps/desktop/src/a.ts", "apps/shared/src/x.ts", "package-lock.json"])
 def test_update_builds_when_a_desktop_input_changed_since_the_prebuilt_commit(tmp_path, monkeypatch, capsys, change):
