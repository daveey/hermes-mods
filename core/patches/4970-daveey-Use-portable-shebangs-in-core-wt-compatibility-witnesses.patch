From bc317e62deff04bffce0fbfb52a975f3dca9ace4 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Thu, 19 Nov 2026 11:34:58 +0000
Subject: [PATCH] [daveey] Use portable shebangs in core-wt compatibility
 witnesses

---
 tests/cron/test_lifecycle_guard_core_worktree_compat.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/cron/test_lifecycle_guard_core_worktree_compat.py b/tests/cron/test_lifecycle_guard_core_worktree_compat.py
index 6eff0359fe5301d94da27a121a488ee462b9473d..89910ac1ba7e8465d2a345d5e257c57568ce73f2 100644
--- a/tests/cron/test_lifecycle_guard_core_worktree_compat.py
+++ b/tests/cron/test_lifecycle_guard_core_worktree_compat.py
@@ -4,7 +4,7 @@ from cron.lifecycle_guard import scan_gateway_lifecycle
 
 def test_core_worktree_ssh_quote_fragments_are_not_programs(tmp_path):
     script = tmp_path / "helper.sh"
-    script.write_text('''#!/bin/bash
+    script.write_text('''#!/usr/bin/env bash
 hub_sh() {
   local s="$1"; shift
   ssh some-host "bash -c $(printf '%q' "$s") probe $(printf '%q ' "$@")"
@@ -19,7 +19,7 @@ hub_sh "$s"
 
 def test_core_worktree_python_watchdog_is_not_unknown_shell(tmp_path):
     script = tmp_path / "helper.sh"
-    script.write_text('''#!/bin/bash
+    script.write_text('''#!/usr/bin/env bash
 PY3="$(command -v /usr/bin/python3 || command -v python3)"
 read -r -d '' TRANSFER_BOUND_PY <<'PY' || true
 import sys
-- 
