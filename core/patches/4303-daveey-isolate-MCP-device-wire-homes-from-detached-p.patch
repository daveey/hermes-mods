From 2988b4b08a77c88d8562ff8198ae4881549ab0b7 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sat, 14 Nov 2026 23:30:48 +0000
Subject: [PATCH] [daveey] isolate MCP device wire homes from detached plugin
 installers

Why: run_cli waits for the CLI, but first-boot default plugin installation detaches and keeps writing home/cache after CLI exit. TemporaryDirectory can race that writer and fail ENOTEMPTY. The wire fixture omitted the existing lazy-install opt-out; protocol assertions did not check unrelated startup work.

Fix: disable security.allow_lazy_installs only in the disposable OAuth fixture. Preserve real CLI authentication, credential/state assertions, and strict TemporaryDirectory cleanup. Regression drives the real boot policy and gates an owned writer between cache enumeration and rmdir; no external installs or credentials.

Proof: historical 950a410dd3b5 whole-file reproduction: 9 passed, issuer errno39; isolated malformed/unsupported pass. 600467908e1c whole 10 pass, isolated 2 pass; strace proves detached installer writes after CLI exit/home removal. Deterministic RED errno39, GREEN three repetitions of both files (11 passed each), lazy-install-enabled mutant killed by errno39, restored GREEN. Full scripts/check passes.
---
 evals/mcp_device_flow.py                      |  4 +-
 tests/evals/test_mcp_device_flow_isolation.py | 76 +++++++++++++++++++
 2 files changed, 79 insertions(+), 1 deletion(-)
 create mode 100644 tests/evals/test_mcp_device_flow_isolation.py

diff --git a/evals/mcp_device_flow.py b/evals/mcp_device_flow.py
index c443985363..86780e0d79 100644
--- a/evals/mcp_device_flow.py
+++ b/evals/mcp_device_flow.py
@@ -120,7 +120,9 @@ def run_cli(repo, mode):
         oauth = {"flow": "device", "cimd": False, "scope": "fixture.read", "timeout": 15}
         if mode == "preregistered":
             oauth.update(client_id="fixture-client", client_secret="fixture-client-secret")
-        config = {"mcp_servers": {"fixture": {"url": base + "/mcp", "auth": "oauth", "oauth": oauth}}}
+        # Detached default-plugin installs can outlive the CLI and race home cleanup.
+        config = {"security": {"allow_lazy_installs": False},
+                  "mcp_servers": {"fixture": {"url": base + "/mcp", "auth": "oauth", "oauth": oauth}}}
         (home / "config.yaml").write_text(json.dumps(config))
         previous = {}
         if mode == "persistence":
diff --git a/tests/evals/test_mcp_device_flow_isolation.py b/tests/evals/test_mcp_device_flow_isolation.py
new file mode 100644
index 0000000000..30ab6bee9a
--- /dev/null
+++ b/tests/evals/test_mcp_device_flow_isolation.py
@@ -0,0 +1,76 @@
+"""The wire harness must not launch unrelated installers into its disposable home."""
+import os
+from pathlib import Path
+import subprocess
+import threading
+
+from evals import mcp_device_flow
+from hermes_cli import default_plugins
+from pm import environments, plugins_state
+
+
+def test_wire_home_disables_detached_installers_before_cleanup(monkeypatch):
+    release = threading.Event()
+    written = threading.Event()
+    writers = []
+    homes = []
+    errors = []
+    original_rmdir = os.rmdir
+
+    def delayed_install(home):
+        try:
+            assert release.wait(10), "cleanup never reached the cache directory"
+            (home / "cache" / "late-install").write_text("fixture")
+        except (AssertionError, OSError) as exc:
+            errors.append(exc)
+        finally:
+            written.set()
+
+    def spawn_install():
+        home = homes[-1]
+        (home / "cache").mkdir(exist_ok=True)
+        writer = threading.Thread(target=delayed_install, args=(home,))
+        writers.append(writer)
+        writer.start()
+        return True
+
+    def cli_startup(argv, **kwargs):
+        # Exercise the real boot policy on the exact home run_cli passes to its child.
+        # Auth protocol and nondisclosure are covered by test_mcp_device_flow.
+        home = Path(kwargs["env"]["HERMES_HOME"])
+        homes.append(home)
+        with monkeypatch.context() as scoped:
+            scoped.delenv("HERMES_DISABLE_LAZY_INSTALLS", raising=False)
+            scoped.setattr(plugins_state, "dependency_homes", lambda: [home])
+            scoped.setattr(environments, "dependency_home_root", lambda: home)
+            scoped.setattr(default_plugins, "spawn_install", spawn_install)
+            outcome = default_plugins.step_install_default_plugins()
+        assert outcome["ok"], outcome
+        return subprocess.CompletedProcess(argv, 0, "Authentication failed", "")
+
+    def remove_after_writer(path, *args, **kwargs):
+        # Force the observed interleaving: scandir has finished, but rmdir has not.
+        if writers and Path(os.fspath(path)).name == "cache":
+            release.set()
+            assert written.wait(10), "installer did not finish its write"
+        return original_rmdir(path, *args, **kwargs)
+
+    monkeypatch.setattr(mcp_device_flow.subprocess, "run", cli_startup)
+    monkeypatch.setattr(os, "rmdir", remove_after_writer)
+    try:
+        mcp_device_flow.run_cli(Path(__file__).resolve().parents[2], "unsupported")
+    finally:
+        release.set()
+        for writer in writers:
+            writer.join(10)
+            assert not writer.is_alive()
+        # A failing RED run still owns and cleans its controlled writer's files.
+        with monkeypatch.context() as scoped:
+            scoped.setattr(os, "rmdir", original_rmdir)
+            import shutil
+            for home in homes:
+                if home.exists():
+                    shutil.rmtree(home)
+    assert not errors
+    assert not writers, "an unrelated installer outlives the CLI"
+    assert homes and all(not home.exists() for home in homes)
