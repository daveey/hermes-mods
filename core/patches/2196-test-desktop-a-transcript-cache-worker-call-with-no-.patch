From 9cf5fb83a148b5343f3b1582970d1211be589fed Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 11 Nov 2026 05:56:41 +0000
Subject: [PATCH] test(desktop): a transcript cache worker call with no timeout
 gives up after CALL_TIMEOUT_MS [daveey]

Review of d61f91892562: the 30 s default was claimed but untested. A
worker that never answers rejects the call at exactly CALL_TIMEOUT_MS,
its late reply is dropped, and the next call still resolves.
---
 .../electron/transcript-cache-client.test.ts  | 48 ++++++++++++++++++-
 1 file changed, 47 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/electron/transcript-cache-client.test.ts b/apps/desktop/electron/transcript-cache-client.test.ts
index 787658db55..c7fe23e54a 100644
--- a/apps/desktop/electron/transcript-cache-client.test.ts
+++ b/apps/desktop/electron/transcript-cache-client.test.ts
@@ -4,10 +4,11 @@ import path from 'node:path'
 import { Worker } from 'node:worker_threads'
 
 import { build } from 'esbuild'
-import { afterAll, afterEach, beforeAll, describe, expect, it } from 'vitest'
+import { afterAll, afterEach, beforeAll, describe, expect, it, vi } from 'vitest'
 
 import { TranscriptCacheStore } from './transcript-cache'
 import {
+  CALL_TIMEOUT_MS,
   inlineClient,
   MAX_WORKER_STARTS,
   type StoreWorkerPort,
@@ -193,6 +194,51 @@ describe('[daveey] transcript cache store off the main thread', () => {
     await expect(client.call('read', [key], { timeoutMs: 50 })).rejects.toThrow(/read timed out after 50ms/)
   })
 
+  it('a call with no timeout of its own gives up after CALL_TIMEOUT_MS; the late reply is dropped', async () => {
+    vi.useFakeTimers()
+
+    try {
+      let deliver: (reply: unknown) => void = () => undefined
+      const posted: { id: number }[] = []
+
+      const client = workerClient({
+        fallback: () => {
+          throw new Error('no fallback expected')
+        },
+        log: () => undefined,
+        // A worker that is alive but never answers (stuck on the disk).
+        spawn: () => ({
+          on: (event, listener) => {
+            if (event === 'message') {
+              deliver = listener
+            }
+          },
+          postMessage: message => posted.push(message),
+          terminate: () => undefined
+        })
+      })
+
+      clients.push(client)
+
+      let outcome = 'pending'
+      const stuck = client.call('putLatest', [key, rows]).catch(error => (outcome = (error as Error).message))
+
+      await vi.advanceTimersByTimeAsync(CALL_TIMEOUT_MS - 1)
+      expect(outcome).toBe('pending')
+      await vi.advanceTimersByTimeAsync(1)
+      await stuck
+      expect(outcome).toBe(`transcript cache putLatest timed out after ${CALL_TIMEOUT_MS}ms`)
+
+      // The worker answers at last: nothing is waiting, and the next call still works.
+      deliver({ id: posted[0]!.id, ms: 40_000, ok: true, result: true })
+      const next = client.call('stats')
+      deliver({ id: posted[1]!.id, ms: 1, ok: true, result: { bytes: 0, sessions: 0 } })
+      await expect(next).resolves.toEqual({ bytes: 0, sessions: 0 })
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+
   it(`a worker that keeps dying is restarted ${MAX_WORKER_STARTS} times, then the in-thread store takes over`, async () => {
     const logs: string[] = []
     const file = cacheFile('dying')
-- 
