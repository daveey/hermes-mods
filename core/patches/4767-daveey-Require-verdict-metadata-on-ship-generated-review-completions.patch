From 0a7a8315a48dedbb0100182db716c8ac3d8e75c0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 05:40:17 +0000
Subject: [PATCH] [daveey] Require verdict metadata on ship-generated review
 completions

Ship briefs explicitly require verdict, reviewed_sha and reviewed_pr, but the completion classifier previously required an existing review key before validating the contract. Receipt-only handoffs therefore silently completed. Recognize the generated review brief even with no keys; keep discussion and landing controls outside that rule. Regression proves tool refusal leaves the card running and corrected metadata completes the same run. Proof: canonical review-contract suite 152 passed; scripts/check --base origin/main passed.
---
 hermes_cli/kanban_review_contract.py       | 10 +++++++---
 tests/tools/test_kanban_review_contract.py | 18 +++++++++++++++---
 2 files changed, 22 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/kanban_review_contract.py b/hermes_cli/kanban_review_contract.py
index 8a31b635b8d08d4410a96c6fb3be3feb99ada7e8..642209f51f4c23756faa27f69b5b747215575190 100644
--- a/hermes_cli/kanban_review_contract.py
+++ b/hermes_cli/kanban_review_contract.py
@@ -15,8 +15,9 @@ This module catches that gap at completion time, while the reviewer can still fi
   cards record ``reviewed_sha``/``reviewed_pr`` without one (replayed over the real boards) and are not reviews.
 - On such a card, a completion whose metadata looks like a review result (any review key) must carry exactly
   ``verdict`` in {approve, request_changes}, a lowercase 40-hex ``reviewed_sha`` and ``reviewed_pr`` naming the
-  pull. A landing/implementation handoff (``published_pr``) and a completion with no review key at all (a card
-  that only discusses the contract) are not review results and are left alone.
+  pull. A landing/implementation handoff (``published_pr``) and a completion with no review key at all are
+  normally left alone. Ship's explicit "Independent exact-head review of" brief is the exception: its stated
+  metadata contract is required even when every review key is absent, so the reviewer can retry in the same run.
 
 Ship itself is unchanged: it accepts no aliases and infers no sha.
 
@@ -109,7 +110,10 @@ def problems(metadata: Any) -> list[str]:
 
 def refusal(body: Optional[str], metadata: Any) -> Optional[str]:
     """The refusal text for a review result on a core-fork pull card that ship cannot read, else None."""
-    if not is_review_result(metadata):
+    # Ship's generated brief is a review assignment, even when a reviewer forgets every
+    # metadata key. Other cards may merely discuss the contract or hand off a landing.
+    required = states_contract(body) and re.match(r"\s*Independent exact-head review of\b", body or "", re.IGNORECASE)
+    if not required and not is_review_result(metadata):
         return None
     if states_contract(body):
         cause = "this card states the ship review contract"
diff --git a/tests/tools/test_kanban_review_contract.py b/tests/tools/test_kanban_review_contract.py
index b130b2a01f65595cca45540adb836765f1d000ba..ef378d401c930b653f612ae1ad9a3daf0615049c 100644
--- a/tests/tools/test_kanban_review_contract.py
+++ b/tests/tools/test_kanban_review_contract.py
@@ -122,7 +122,15 @@ def test_refusal_none_without_contract():
     {"published_pr": PR, "reviewed_head": SHA, "landed_sha": SHA},  # the landing handoff of an implementation card
 ])
 def test_refusal_none_when_not_a_review_result(md):
-    assert krc.refusal(SHIP_BODY, md) is None
+    assert krc.refusal("Investigate the review contract: " + SHIP_BODY, md) is None
+
+
+@pytest.mark.parametrize("md", [None, {}, {"completion_receipt": {}}, {"published_pr": PR}])
+def test_ship_brief_requires_metadata_even_without_review_keys(md):
+    result = krc.completion_refusal(SHIP_BODY, md, worker_run_id=1)
+    assert result and result[1] == "review_contract"
+    assert "metadata.verdict" in result[0]
+    assert "metadata.reviewed_sha" in result[0]
 
 
 @pytest.mark.parametrize("key", ["verdict", "review_verdict", "review_outcome", "reviewed_sha", "reviewed_head",
@@ -173,13 +181,17 @@ def _status(kb, tid):
 
 
 @pytest.mark.parametrize("bad,key", [
+    ({"completion_receipt": {"version": 1, "items": [{"scope": "review", "disposition": "delivered",
+       "evidence": [{"ref": "review evidence", "observed_at": "2026-11-18T00:00:00+00:00",
+                     "verification": "reported"}], "remaining": []}]}}, "metadata.verdict"),
+    ({}, "metadata.verdict"),
     ({"review_verdict": "approve", "reviewed_sha": SHA, "reviewed_pr": PR}, "metadata.verdict"),
     ({"verdict": "approve", "reviewed_pr": PR}, "metadata.reviewed_sha"),
     ({"verdict": "approve", "reviewed_head": SHA, "reviewed_pr": PR}, "metadata.reviewed_sha"),
 ])
 def test_tool_refuses_unreadable_review_then_accepts_fix(board, monkeypatch, bad, key):
     from tools import kanban_tools as kt
-    tid = _claim(board, monkeypatch, MISNAMED_BODY)
+    tid = _claim(board, monkeypatch, SHIP_BODY)
     out = _complete(bad)
     assert out.get("error") and out["rejection"] == "review_contract"
     assert out["rejection"] in kt.COMPLETE_REJECTION_CLASSES
@@ -368,7 +380,7 @@ def test_tool_dispatched_worker_completes_same_card(board, monkeypatch):
 @pytest.mark.parametrize("body,md", [
     ("Fix the sidebar scroll. Done when its tests pass.", NOT_CORE_GOOD),  # not a ship review card
     (PR_KEY_BODY, dict(LANDING_MDS[0])),  # a verdictless landing handoff on a core-pull card
-    (SHIP_BODY, {"changed_files": ["a.py"]}),  # no review key at all
+    ("Investigate the review contract: " + SHIP_BODY, {"changed_files": ["a.py"]}),
 ], ids=["not_ship", "verdictless_landing", "no_review_key"])
 def test_tool_outside_non_review_completions_still_complete(board, body, md):
     from tools import kanban_tools as kt
