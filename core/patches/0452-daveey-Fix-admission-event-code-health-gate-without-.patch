From 1f220668a628d9c5cec93779a3aa4276c669cd96 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 27 Oct 2026 03:19:04 +0000
Subject: [PATCH] [daveey] Fix admission event code-health gate without
 changing guards

---
 .../use-message-stream/gateway-event/admitted-message.ts  | 8 ++++++--
 tests/tui_gateway/test_prompt_admission_event.py          | 5 ++++-
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/apps/desktop/src/app/session/hooks/use-message-stream/gateway-event/admitted-message.ts b/apps/desktop/src/app/session/hooks/use-message-stream/gateway-event/admitted-message.ts
index 14266e3a8f..f7e0001895 100644
--- a/apps/desktop/src/app/session/hooks/use-message-stream/gateway-event/admitted-message.ts
+++ b/apps/desktop/src/app/session/hooks/use-message-stream/gateway-event/admitted-message.ts
@@ -5,6 +5,11 @@ import { knownOwnerForSession } from '@/store/session-states'
 
 import type { GatewayEventContext } from './types'
 
+function isCommittedUserRow(row: GatewayEventMap['message.admitted']): boolean {
+  return Number.isSafeInteger(row.user_row_id) && row.user_row_id > 0 &&
+    Boolean(row.message_uid) && typeof row.text === 'string' && Number.isFinite(row.timestamp)
+}
+
 /** Merge only the committed user row: a busy stream still owns all assistant parts. */
 export function handleAdmittedMessageEvent(ctx: GatewayEventContext): boolean {
   const { event, deps, explicitSid } = ctx
@@ -27,8 +32,7 @@ export function handleAdmittedMessageEvent(ctx: GatewayEventContext): boolean {
     current.storedSessionId !== row.stored_session_id || profile !== row.profile ||
     registryBackendScopeKey(connectionId ?? null, sourceProfile ?? null) !==
       registryBackendScopeKey(event.connectionId ?? null, event.profile ?? null) ||
-    !Number.isSafeInteger(row.user_row_id) || row.user_row_id <= 0 ||
-    !row.message_uid || typeof row.text !== 'string' || !Number.isFinite(row.timestamp)
+    !isCommittedUserRow(row)
   ) {
     return true
   }
diff --git a/tests/tui_gateway/test_prompt_admission_event.py b/tests/tui_gateway/test_prompt_admission_event.py
index d76a841995..1ba12fe2aa 100644
--- a/tests/tui_gateway/test_prompt_admission_event.py
+++ b/tests/tui_gateway/test_prompt_admission_event.py
@@ -1,7 +1,10 @@
 """Admission projects its committed row before output, never on cancelled dispatch."""
-from tests.tui_gateway.test_prompt_admission import call, owner
+from tests.tui_gateway import test_prompt_admission as admission
 from tui_gateway import server
 
+call = admission.call
+owner = admission.owner
+
 
 def test_committed_user_event_precedes_turn_and_retry_does_not_reemit(owner, monkeypatch):
     db, session, params, started = owner
-- 
2.55.0

