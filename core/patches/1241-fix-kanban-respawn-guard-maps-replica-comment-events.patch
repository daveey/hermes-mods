From 9be462ac4575358ebf58be30d475b7287d699db0 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 13:09:58 +0000
Subject: [PATCH] fix(kanban): respawn guard maps replica comment events to
 local rows by (created_at, author, len) [daveey]

A card homed on another board keeps that board's 'commented' events verbatim, so
their comment_id is the home row id while the synced local row has another id
(home 6684 = hub row 9723 on t_01a18c47420df7e2). _foreign_pr_comment_ids
returned home ids, active_pr_reason tested local ids against them, and a chat
FYI naming an open PR counted as the card's own publication: active_pr for 24 h.

Events now map to local rows by (created_at within a 120 s write-lock skew,
author, len); the payload id is used only when that row has the same triple
and no other row does, so home boards map as before. Two rows for one event
or two events for one row stay fail-closed, as do unreadable events.
_immediate_checkpoint_after maps comment_id_at_checkpoint the same way and
falls back to strict checkpoint-time ordering when it names no single row.
---
 hermes_cli/kanban_db_dispatch_pr_state.py     | 123 +++++++++++--
 .../test_kanban_pr_replica_comment_ids.py     | 171 ++++++++++++++++++
 2 files changed, 277 insertions(+), 17 deletions(-)
 create mode 100644 tests/hermes_cli/test_kanban_pr_replica_comment_ids.py

diff --git a/hermes_cli/kanban_db_dispatch_pr_state.py b/hermes_cli/kanban_db_dispatch_pr_state.py
index 98db65c1329..30b4173e562 100644
--- a/hermes_cli/kanban_db_dispatch_pr_state.py
+++ b/hermes_cli/kanban_db_dispatch_pr_state.py
@@ -132,14 +132,24 @@ def _immediate_checkpoint_after(
         return False
     ended_at = kb._to_epoch(run["ended_at"])
     meta = kb._json_dict(run["metadata"])
-    # A server-derived comment watermark distinguishes ordering within one second.
+    # A server-derived comment watermark distinguishes ordering within one second. It is a
+    # row id on the host that parked, so map it to the local row first (replica cards); a
+    # watermark that names no single local row falls back to strict time ordering.
     event = conn.execute(
-        "SELECT payload FROM task_events WHERE task_id = ? AND run_id = ? "
+        "SELECT payload, created_at FROM task_events WHERE task_id = ? AND run_id = ? "
         "AND kind = 'continued' ORDER BY id DESC LIMIT 1", (task_id, run["id"]),
     ).fetchone()
     watermark = kb._json_dict(event["payload"]).get("comment_id_at_checkpoint") if event else None
-    if type(watermark) is not int or watermark < latest_pr_comment_id:
+    if type(watermark) is not int:
         return False
+    local = _local_comment_id(conn, task_id, watermark) if watermark > 0 else None
+    if local is not None:
+        if local < latest_pr_comment_id:
+            return False
+    else:
+        parked_at = kb._to_epoch(event["created_at"])
+        if parked_at is None or parked_at <= since:
+            return False
     return bool(
         ended_at is not None and ended_at >= since
         and meta.get("checkpoint") and meta.get("resume_after_seconds") == 0
@@ -170,27 +180,106 @@ def _comment_rejections(conn: sqlite3.Connection, task_id: str, urls: Iterable[s
             comment_rejection(conn, task_id, url, _rejections[url.rstrip("/").lower()])
 
 
-def _foreign_pr_comment_ids(conn: sqlite3.Connection, task_id: str) -> set[int]:
-    """Known foreign writers are FYI; absent or unreadable provenance fails closed.
+# ``add_comment`` stamps the row before taking the write lock and its ``commented`` event
+# after, so the event can trail its row by lock-wait seconds (31 s seen on the hub).
+COMMENT_EVENT_SKEW_SECONDS = 120
 
-    The display author is a profile shared by workers and chats, not ownership.
-    Read events once per card, rather than issuing a query per comment.
+
+def _comment_rows(conn: sqlite3.Connection, task_id: str) -> dict[int, tuple[str, Optional[int], int]]:
+    """Local ``task_comments`` rows: id -> (author, created_at epoch, len(body))."""
+    from hermes_cli import kanban_db as _kb
+
+    return {r[0]: (r[1], _kb._to_epoch(r[2]), r[3] or 0) for r in conn.execute(
+        "SELECT id, author, created_at, length(body) FROM task_comments WHERE task_id = ?", (task_id,))}
+
+
+def _row_matches(row: tuple[str, Optional[int], int], at: int, author: str, length: int, *, exact: bool) -> bool:
+    r_author, r_at, r_len = row
+    if r_at is None or r_author != author or not 0 <= at - r_at <= COMMENT_EVENT_SKEW_SECONDS:
+        return False
+    # The row body is stripped and the payload ``len`` is not: stripping only shortens.
+    return r_len == length if exact else r_len <= length
+
+
+def _event_row_id(rows: dict[int, tuple[str, Optional[int], int]], at: Optional[int],
+                  data: dict) -> Optional[int]:
+    """The local row a ``commented`` event describes, or None when it can't be told.
+
+    A replica keeps the home board's events verbatim, so ``comment_id`` is the HOME row id;
+    the synced local row has a different one (2026-10-30: home 6684 = hub row 9723). Match
+    by (created_at, author, len). The payload id is used only when that local row has the
+    same triple and no other row does, so a home board, where ids agree, maps as before.
+    Two rows with the event's triple are indistinguishable: None (the caller fails closed).
     """
-    foreign: set[int] = set()
-    seen: set[int] = set()
-    for row in conn.execute(
-        "SELECT payload FROM task_events WHERE task_id = ? AND kind = 'commented'",
+    author, length, cid = data.get("author"), data.get("len"), data.get("comment_id")
+    if at is None or not isinstance(author, str) or type(length) is not int:
+        return None
+    author = author.strip()
+    exact = [i for i, r in rows.items() if _row_matches(r, at, author, length, exact=True)]
+    row = rows.get(cid) if type(cid) is int else None
+    if row is not None and _row_matches(row, at, author, length, exact=False) \
+            and all(i == cid for i in exact):
+        return cid
+    return exact[0] if len(exact) == 1 else None
+
+
+def _comment_events(conn: sqlite3.Connection, task_id: str) -> Optional[list[tuple[dict, Optional[int], Optional[int]]]]:
+    """Every ``commented`` event as (payload, event epoch, local row id or None).
+
+    None when any event is unreadable: it cannot be associated with a comment.
+    """
+    from hermes_cli import kanban_db as _kb
+
+    rows = _comment_rows(conn, task_id)
+    out: list[tuple[dict, Optional[int], Optional[int]]] = []
+    for payload, created_at in conn.execute(
+        "SELECT payload, created_at FROM task_events WHERE task_id = ? AND kind = 'commented'",
         (task_id,),
     ):
         try:
-            data = json.loads(row[0])
+            data = json.loads(payload)
         except (ValueError, TypeError):
-            return set()  # cannot associate this unreadable event with a comment
-        if not isinstance(data, dict) or type(data.get("comment_id")) is not int:
-            return set()
-        cid = data["comment_id"]
+            return None
+        if not isinstance(data, dict) or type(data.get("comment_id")) is not int \
+                or not isinstance(data.get("author"), str) or type(data.get("len")) is not int:
+            return None
+        at = _kb._to_epoch(created_at)
+        out.append((data, at, _event_row_id(rows, at, data)))
+    return out
+
+
+def _local_comment_id(conn: sqlite3.Connection, task_id: str, comment_id: int) -> Optional[int]:
+    """Translate a payload comment id (any host's id space) to the local row it names.
+
+    None unless every ``commented`` event carrying that id maps to one and the same row.
+    """
+    events = _comment_events(conn, task_id)
+    if events is None:
+        return None
+    hits = {row for data, _at, row in events if data["comment_id"] == comment_id}
+    if len(hits) != 1 or None in hits:
+        return None
+    return hits.pop()
+
+
+def _foreign_pr_comment_ids(conn: sqlite3.Connection, task_id: str) -> set[int]:
+    """Local row ids of comments from known foreign writers (FYI); absent, unreadable
+    or ambiguous provenance fails closed.
+
+    The display author is a profile shared by workers and chats, not ownership.
+    Read events once per card, rather than issuing a query per comment. Events are
+    matched to rows by :func:`_event_row_id`, so replica cards work too.
+    """
+    events = _comment_events(conn, task_id)
+    if events is None:
+        return set()
+    foreign: set[int] = set()
+    seen: set[int] = set()
+    for data, _at, cid in events:
+        if cid is None:
+            continue  # no row is tied to it; an unmatched row stays owned (fail closed)
         if cid in seen:
-            foreign.discard(cid)  # ambiguous duplicate provenance fails closed
+            foreign.discard(cid)  # two events for one row: ambiguous provenance fails closed
             continue
         seen.add(cid)
         writer = data.get("writer_run_id")
diff --git a/tests/hermes_cli/test_kanban_pr_replica_comment_ids.py b/tests/hermes_cli/test_kanban_pr_replica_comment_ids.py
new file mode 100644
index 00000000000..319ee45c361
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_pr_replica_comment_ids.py
@@ -0,0 +1,171 @@
+"""Replica cards: a synced comment row id differs from its event's ``comment_id``. [daveey]
+
+A card homed on another board (the MacBook) and run on this host keeps the home board's
+``commented`` events verbatim, so ``comment_id`` is the HOME row id while the local
+``task_comments`` row was inserted under a new id (2026-10-30: home 6684 -> hub row 9723).
+The respawn guard must match events to rows by (created_at, author, len), not by raw id.
+"""
+import json
+import time
+
+import pytest
+
+from hermes_cli import kanban_continuation as kc
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch_pr_state as prs
+from tests.hermes_cli.kanban_guard_helpers import worker_comment
+from tests.hermes_cli.test_kanban_park_invariants import kanban_home
+
+__all__ = ["kanban_home"]
+pytestmark = pytest.mark.usefixtures("kanban_home")
+URL = "https://github.com/example/project/pull/1523"
+OFFSET = 1000
+
+
+@pytest.fixture(autouse=True)
+def open_pr(monkeypatch):
+    monkeypatch.setattr(prs, "pr_state", lambda url: "OPEN")
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    monkeypatch.delenv("HERMES_KANBAN_RUN_ID", raising=False)
+
+
+def _clock(monkeypatch, t):
+    monkeypatch.setattr(time, "time", lambda: t)
+
+
+def _replicate(conn, tid):
+    """Renumber the card's comment rows as a replica sync does (new local ids, empty uid)."""
+    conn.execute("UPDATE task_comments SET id = id + ? WHERE task_id = ?", (OFFSET, tid))
+    if any(c[1] == "uid" for c in conn.execute("PRAGMA table_info(task_comments)")):  # sync-only column
+        conn.execute("UPDATE task_comments SET uid = '' WHERE task_id = ?", (tid,))
+
+
+def _ran_card(conn):
+    tid = kb.create_task(conn, title="recover PR", assignee="a")
+    kb.claim_task(conn, tid)
+    return tid
+
+
+def _chat_fyi(conn, tid, body=f"FYI: wake to recover {URL}"):
+    return kb.add_comment(conn, tid, "default", body)  # no worker env: no writer_run_id
+
+
+def test_replica_chat_fyi_naming_open_pr_is_not_held(monkeypatch):
+    now = int(time.time())
+    _clock(monkeypatch, now)
+    with kbc.connect() as conn:
+        tid = _ran_card(conn)
+        _clock(monkeypatch, now + 5)
+        cid = _chat_fyi(conn, tid)
+        _replicate(conn, tid)
+        local = conn.execute("SELECT id FROM task_comments WHERE task_id=?", (tid,)).fetchone()[0]
+        assert local != cid
+        assert prs.active_pr_reason(conn, tid, now + 10) is None
+
+
+def test_replica_chat_fyi_sharing_its_second_with_unblocked_is_not_held(monkeypatch):
+    """The t_01a18c47420df7e2 shape: the strict-after handoff check cannot lift it."""
+    now = int(time.time())
+    _clock(monkeypatch, now)
+    with kbc.connect() as conn:
+        tid = _ran_card(conn)
+        _clock(monkeypatch, now + 5)
+        _chat_fyi(conn, tid)
+        kb._append_event(conn, tid, "unblocked", {"reason": "resume"})
+        _replicate(conn, tid)
+        assert prs.active_pr_reason(conn, tid, now + 10) is None
+
+
+def test_replica_own_worker_pr_comment_still_held(monkeypatch):
+    now = int(time.time())
+    _clock(monkeypatch, now)
+    with kbc.connect() as conn:
+        tid = _ran_card(conn)
+        _clock(monkeypatch, now + 5)
+        worker_comment(conn, tid, "default", f"Opened {URL}")
+        _replicate(conn, tid)
+        assert prs.active_pr_reason(conn, tid, now + 10) == "active_pr"
+
+
+@pytest.mark.parametrize("replica", [False, True])
+def test_two_rows_with_one_triple_fail_closed(monkeypatch, replica):
+    now = int(time.time())
+    _clock(monkeypatch, now)
+    with kbc.connect() as conn:
+        tid = _ran_card(conn)
+        _clock(monkeypatch, now + 5)
+        _chat_fyi(conn, tid)
+        _chat_fyi(conn, tid)  # same (created_at, author, len): rows are indistinguishable
+        if replica:
+            _replicate(conn, tid)
+        assert prs.active_pr_reason(conn, tid, now + 10) == "active_pr"
+
+
+def test_two_events_matching_one_row_fail_closed(monkeypatch):
+    now = int(time.time())
+    _clock(monkeypatch, now)
+    with kbc.connect() as conn:
+        tid = _ran_card(conn)
+        _clock(monkeypatch, now + 5)
+        body = f"FYI: wake to recover {URL}"
+        _chat_fyi(conn, tid, body)
+        conn.execute(
+            "INSERT INTO task_events (task_id, kind, payload, created_at) VALUES (?, 'commented', ?, ?)",
+            (tid, json.dumps({"author": "default", "len": len(body), "comment_id": 424242}), now + 5),
+        )
+        _replicate(conn, tid)
+        assert prs.active_pr_reason(conn, tid, now + 10) == "active_pr"
+
+
+def test_home_board_event_written_seconds_after_its_row_still_matches(monkeypatch):
+    """add_comment stamps the row before taking the write lock; its event can be later."""
+    now = int(time.time())
+    _clock(monkeypatch, now)
+    with kbc.connect() as conn:
+        tid = _ran_card(conn)
+        _clock(monkeypatch, now + 5)
+        _chat_fyi(conn, tid)
+        conn.execute("UPDATE task_events SET created_at = created_at + 30 "
+                     "WHERE task_id = ? AND kind = 'commented'", (tid,))
+        assert prs.active_pr_reason(conn, tid, now + 60) is None
+
+
+def _immediate_checkpoint(monkeypatch, conn, now):
+    tid = _ran_card(conn)
+    worker_comment(conn, tid, "default", f"Draft {URL}")
+    assert kc.continue_task(conn, tid, checkpoint="finish the existing PR")["ok"]
+    return tid
+
+
+def _latest_pr_row(conn, tid):
+    return conn.execute("SELECT MAX(id) FROM task_comments WHERE task_id=?", (tid,)).fetchone()[0]
+
+
+def test_replica_checkpoint_watermark_maps_to_local_row(monkeypatch):
+    now = int(time.time())
+    _clock(monkeypatch, now)
+    with kbc.connect() as conn:
+        tid = _immediate_checkpoint(monkeypatch, conn, now)
+        _replicate(conn, tid)  # watermark keeps the home id; the PR row is now home id + OFFSET
+        assert prs._immediate_checkpoint_after(conn, tid, now, _latest_pr_row(conn, tid))
+        assert prs.active_pr_reason(conn, tid, now + 1) is None
+
+
+@pytest.mark.parametrize("later,expected", [(False, "active_pr"), (True, None)])
+def test_unmappable_watermark_uses_checkpoint_time(monkeypatch, later, expected):
+    now = int(time.time())
+    _clock(monkeypatch, now)
+    with kbc.connect() as conn:
+        tid = _ran_card(conn)
+        worker_comment(conn, tid, "default", f"Draft {URL}")
+        _clock(monkeypatch, now + (1 if later else 0))
+        assert kc.continue_task(conn, tid, checkpoint="finish the existing PR")["ok"]
+        row = conn.execute("SELECT id, payload FROM task_events WHERE task_id=? AND kind='continued'",
+                           (tid,)).fetchone()
+        data = kb._json_dict(row["payload"])
+        data["comment_id_at_checkpoint"] = 0  # names no comment event
+        conn.execute("UPDATE task_events SET payload=? WHERE id=?", (json.dumps(data), row["id"]))
+        _replicate(conn, tid)
+        got = prs._immediate_checkpoint_after(conn, tid, now, _latest_pr_row(conn, tid))
+        assert got is (expected is None)
-- 
