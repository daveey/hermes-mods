From 376ef93435676db5a03f00d20234a231b30b4852 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 13 Nov 2026 20:43:45 +0000
Subject: [PATCH] [daveey] lifecycle guard: split a `&>` glued to the word
 before it

Review of #2485 at 38af268a42: protect_redirection_ampersands kept the `&` of
`&>` even when glued to a preceding word, and split_glued_redirections did not
split `word&>`, so `bash restart.sh&>/dev/null` became one token and the
script was never opened (blocked on base, allowed at 38af268a42).
split_glued_redirections now puts a space before an unquoted `&>` glued to a
word (same meaning in bash). This also covers the pre-existing
`python3&>/dev/null <f.py`.

Proof: 10 new cases in tests/cron/test_lifecycle_guard_feed_routing.py fail at
38af268a42 and pass here; the 927 lifecycle_guard tests and the importer test
files pass.
---
 cron/lifecycle_guard_groups.py                |  3 +++
 .../cron/test_lifecycle_guard_feed_routing.py | 22 +++++++++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/cron/lifecycle_guard_groups.py b/cron/lifecycle_guard_groups.py
index 85886743ca..275c976ecd 100644
--- a/cron/lifecycle_guard_groups.py
+++ b/cron/lifecycle_guard_groups.py
@@ -61,6 +61,7 @@ def split_glued_redirections(line: str) -> str:
     (before a ``#`` comment), or at its start when the line ends in a control operator (``|``,
     ``&&``, ...), so no operand is added and no pipe is cut. A head with no such tail is an
     ordinary word and changes nothing (``bash -s {a[x < f.sh`` keeps its stdin)."""
+
     out: list[str] = []
     word = ""
     word_out = 0  # where *word* starts in *out*
@@ -84,6 +85,8 @@ def split_glued_redirections(line: str) -> str:
                 out.append("\\" + ch)
                 word += ch
                 continue
+            if ch == "&" and word and word[-1] not in "<>" and line[index + 1: index + 2] == ">":
+                out.append(" ")
             if ch.isspace() or ch in CONTROL_CHARS:
                 if ch in CONTROL_CHARS:
                     head_out = None
diff --git a/tests/cron/test_lifecycle_guard_feed_routing.py b/tests/cron/test_lifecycle_guard_feed_routing.py
index f4256d8236..b17a7a5a9f 100644
--- a/tests/cron/test_lifecycle_guard_feed_routing.py
+++ b/tests/cron/test_lifecycle_guard_feed_routing.py
@@ -74,6 +74,16 @@ def files(tmp_path) -> dict[str, str]:
         # The program reader's own `&>`/`>&` redirections leave it reading the pipe.
         "cat {py} | python3 &>{out}",
         "cat {py} | python3 2>&1",
+        # A `&>` glued to the word before it is still a redirection, not part of that word.
+        "bash {sh}&>/dev/null",
+        "bash {sh}&>/dev/null &",
+        "bash {sh}&>>{out}",
+        ". {sh}&>/dev/null",
+        "python3 {py}&>/dev/null",
+        "python3 {py}&>{out}",
+        "python3 <{py}&>/dev/null",
+        "python3&>/dev/null <{py}",
+        "cat {py}|python3&>/dev/null",
         # A `cat` reading the pipe inside `<(…)`, and beside a file.
         "cat {sh} | bash <(cat)",
         "cat {py} | cat {clean} - | python3",
@@ -131,3 +141,15 @@ def test_redirection_ampersands_survive_tokenizing():
     assert words("echo '2>&1' \"&>\" 'a&'>x") == ["echo", "2>&1", "&>", "a&>x"]
     assert words("echo \\>&1") == ["echo", ">", "&", "1"]
     assert words("echo '>'&1") == ["echo", ">", "&", "1"]
+
+
+def test_glued_ampersand_redirection_splits_from_its_word():
+    from cron.lifecycle_guard_groups import split_glued_redirections as split
+
+    assert split("python3 f.py&>x") == "python3 f.py &>x"
+    assert split("a 'b'&>>y") == "a 'b' &>>y"
+    # `>&`, `&&>`, `|&>`, a quoted `&` and a lone `&` are left as written; an escaped `&` is
+    # part of the word, so only the `>` after it splits off.
+    assert split("a 2>&1 >&2") == "a 2>&1 >&2"
+    assert split("a&&>x a|&>x a & b") == "a&&>x a|&>x a & b"
+    assert split("echo 'a&>x' a\\&>x") == "echo 'a&>x' a\\& >x"
-- 
2.43.0

