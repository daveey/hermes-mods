From bb7d8ca7bed410a1d4dac5ff99a5d7482a43149c Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 18 Nov 2026 09:56:27 +0000
Subject: [PATCH] test(lifecycle): classify resolved process substitutions
 after rebase [daveey]

---
 tests/cron/test_lifecycle_guard_session_aliases.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tests/cron/test_lifecycle_guard_session_aliases.py b/tests/cron/test_lifecycle_guard_session_aliases.py
index 23dfe0936b292cb53b58902080aa6bff486e2eb1..bdd1efd6b5bdee6a7abf2201649f4890a57a752a 100644
--- a/tests/cron/test_lifecycle_guard_session_aliases.py
+++ b/tests/cron/test_lifecycle_guard_session_aliases.py
@@ -279,6 +279,7 @@ _NESTED_FOREIGN_SHELLS = [
     "doas -a style -s <<< 't ( bash {db} )'",
     # A stdin file fed to a login-shell launcher is that shell's script (review 5903452583 B1).
     "su -l bob < <(cat {script})",
+    "while read l; do su -l bob; done < <(cat {script})",
     "bash -l < <(cat {script})",
     "su -l bob 0< <(cat {script})",
     "sudo -i < <(cat {script})",
@@ -642,8 +643,7 @@ def test_multiline_group_without_a_fed_shell_stays_allowed(tmp_path, live_kanban
 
 
 @pytest.mark.parametrize("shape", [
-    "su -l bob < <(cat {script})",
-    "while read l; do su -l bob; done < <(cat {script})",
+    # cat process substitutions resolve to their file and are covered above.
     "su -l bob < $S",
     "su -l bob < \"$S\"",
     "su -l bob < ${{S}}",
-- 
