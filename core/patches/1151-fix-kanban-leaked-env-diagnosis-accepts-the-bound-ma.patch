From 502694fc49f6da378c5020da89707581a8ed7c20 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Fri, 30 Oct 2026 06:41:18 +0000
Subject: [PATCH 1151/1157] fix(kanban): leaked-env diagnosis accepts the bound
 managed-worker pid [daveey]

A managed worker's shells descend from agent.managed_worker (the run's
worker_bound pid / HERMES_DELEGATED_CHILD_OWNER), never from
task_runs.worker_pid (the kanban_worker_client spawn pid, a sibling under
the gateway). The CLI fence therefore told a live worker shell it had a
leaked env and to Cmd-Q Desktop (t_01a18b6ffd5e33c1). Accept a live
ancestor bound pid or delegation owner as proof of a live parent agent;
the fence itself is unchanged.
---
 hermes_cli/top_level_env.py                | 51 ++++++++++--
 tests/hermes_cli/test_leaked_worker_env.py | 97 ++++++++++++++++++++++
 2 files changed, 142 insertions(+), 6 deletions(-)

diff --git a/hermes_cli/top_level_env.py b/hermes_cli/top_level_env.py
index b561462425c..f6412a5a2cb 100644
--- a/hermes_cli/top_level_env.py
+++ b/hermes_cli/top_level_env.py
@@ -102,8 +102,33 @@ def _board_db(env: Mapping[str, str]) -> Optional[Path]:
 _TERMINAL_STATUSES = frozenset({"done", "archived"})
 
 
-def _task_state(db: Path, task_id: str) -> Optional[tuple[str, Optional[int]]]:
-    """``(status, worker_pid)`` of ``task_id``; ``("", None)`` when absent; ``None`` when unreadable."""
+def _bound_pid(conn, task_id: str) -> Optional[int]:
+    """The interpreter the owner bound to the task's current run (``worker_bound`` event).
+
+    A managed worker runs in ``agent.managed_worker`` under the gateway, a sibling of the
+    ``kanban_worker_client`` spawn pid ``task_runs.worker_pid`` records, so its shells descend
+    from this pid and never from that one (t_01a18b6ffd5e33c1). [daveey]
+    """
+    import json
+    import sqlite3
+
+    try:
+        row = conn.execute(
+            "SELECT payload FROM task_events WHERE task_id = ? AND kind = 'worker_bound' AND run_id = "
+            "(SELECT max(id) FROM task_runs WHERE task_id = ?) ORDER BY id DESC LIMIT 1",
+            (task_id, task_id)).fetchone()
+    except sqlite3.Error:
+        return None
+    try:
+        pid = int((json.loads(row[0]) or {}).get("pid") or 0) if row and row[0] else 0
+    except (TypeError, ValueError, AttributeError):
+        return None
+    return pid or None
+
+
+def _task_state(db: Path, task_id: str) -> Optional[tuple[str, Optional[int], Optional[int]]]:
+    """``(status, worker_pid, bound_pid)`` of ``task_id``; ``("", None, None)`` when absent; ``None``
+    when unreadable. ``bound_pid`` is the latest run's ``worker_bound`` interpreter, if any."""
     import sqlite3
 
     if not db.is_file():
@@ -127,13 +152,14 @@ def _task_state(db: Path, task_id: str) -> Optional[tuple[str, Optional[int]]]:
                     run = None
                 if run is not None and run[0]:
                     row = (row[0], run[0])
+            bound = _bound_pid(conn, task_id) if row is not None else None
         finally:
             conn.close()
     except sqlite3.Error:
         return None
     if row is None:
-        return ("", None)
-    return (str(row[0] or ""), int(row[1]) if row[1] else None)
+        return ("", None, None)
+    return (str(row[0] or ""), int(row[1]) if row[1] else None, bound)
 
 
 def _pid_alive(pid: int) -> bool:
@@ -179,6 +205,17 @@ def _is_ancestor(pid: int, start: Optional[int] = None) -> bool:
     return False
 
 
+def _descends_from_live_agent(env: Mapping[str, str], bound_pid: Optional[int]) -> bool:
+    """Whether this process descends from a live agent of the lineage other than the spawn pid:
+    the run's ``worker_bound`` interpreter, or the ``HERMES_DELEGATED_CHILD_OWNER`` process that
+    fenced the lineage (that same managed worker, named even when no bind row is readable). [daveey]"""
+    from agent.delegation_context import DELEGATED_CHILD_OWNER_ENV
+
+    owner = (env.get(DELEGATED_CHILD_OWNER_ENV) or "").strip().partition(":")[0]
+    candidates = [bound_pid] + ([int(owner)] if owner.isdigit() else [])
+    return any(pid and pid > 1 and _pid_alive(pid) and _is_ancestor(pid) for pid in candidates)
+
+
 def leaked_worker_env_diagnosis(environ: Optional[Mapping[str, str]] = None) -> Optional[str]:
     """Why this process's ``HERMES_DELEGATED_CHILD_CONTEXT`` looks leaked, or ``None``.
 
@@ -197,11 +234,13 @@ def leaked_worker_env_diagnosis(environ: Optional[Mapping[str, str]] = None) ->
     state = _task_state(db, tid) if db is not None else None
     if state is None:
         return None
-    status, worker_pid = state
+    status, worker_pid, bound_pid = state
     if not status:
         reason = f"its worker card {tid} is not on the board"
-    elif status != "running" and (status in _TERMINAL_STATUSES or not worker_pid):
+    elif status != "running" and (status in _TERMINAL_STATUSES or not (worker_pid or bound_pid)):
         reason = f"its worker card {tid} is {status}"
+    elif _descends_from_live_agent(env, bound_pid):
+        return None  # a live managed worker / delegation owner is this process's ancestor
     elif worker_pid and not _pid_alive(worker_pid):
         reason = f"{tid}'s worker pid {worker_pid} is gone"
     elif worker_pid and not _is_ancestor(worker_pid):
diff --git a/tests/hermes_cli/test_leaked_worker_env.py b/tests/hermes_cli/test_leaked_worker_env.py
index 372cca95f45..5415e7baa89 100644
--- a/tests/hermes_cli/test_leaked_worker_env.py
+++ b/tests/hermes_cli/test_leaked_worker_env.py
@@ -263,3 +263,100 @@ def test_parked_card_without_any_run_pid_is_still_a_leak(tmp_path):
     db = _board(tmp_path, [("t_45d5a361", "todo", None)])
     msg = tle.leaked_worker_env_diagnosis(_leak_env(db))
     assert msg and "is todo" in msg
+
+
+# ── a live managed worker: the shell descends from the worker_bound interpreter ───────────────
+# t_01a18b6ffd5e33c1 (hub, 2026-10-30): the worker's own shell (parent: ``agent.managed_worker``
+# pid 4081359, the run's ``worker_bound`` pid and HERMES_DELEGATED_CHILD_OWNER) was told
+# "leaked worker env ... Cmd-Q", because only task_runs.worker_pid (4081264, the
+# kanban_worker_client spawn pid, a sibling under the gateway) was checked for ancestry.
+
+def _managed_board(tmp_path, spawn_pid, bound_pid, status="running"):
+    db = _board(tmp_path, [("t_45d5a361", status, spawn_pid)])
+    conn = sqlite3.connect(db)
+    conn.execute("CREATE TABLE task_runs (id INTEGER PRIMARY KEY AUTOINCREMENT, task_id TEXT, worker_pid INTEGER)")
+    conn.execute("CREATE TABLE task_events (id INTEGER PRIMARY KEY AUTOINCREMENT, task_id TEXT, run_id INTEGER, "
+                 "kind TEXT, payload TEXT, created_at INTEGER)")
+    conn.execute("INSERT INTO task_runs (task_id, worker_pid) VALUES ('t_45d5a361', ?)", (spawn_pid,))
+    run_id = conn.execute("SELECT max(id) FROM task_runs").fetchone()[0]
+    # An older run's bind must not vouch for the current run.
+    conn.execute("INSERT INTO task_events (task_id, run_id, kind, payload, created_at) "
+                 "VALUES ('t_45d5a361', ?, 'worker_bound', ?, 0)", (run_id - 1, json.dumps({"pid": os.getpid()})))
+    if bound_pid is not None:
+        conn.execute("INSERT INTO task_events (task_id, run_id, kind, payload, created_at) "
+                     "VALUES ('t_45d5a361', ?, 'worker_bound', ?, 1)", (run_id, json.dumps({"pid": bound_pid})))
+    conn.commit()
+    conn.close()
+    return db
+
+
+@pytest.fixture
+def sibling_spawn_pid():
+    """A live process this one does not descend from (the kanban_worker_client spawn pid)."""
+    p = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(30)"])
+    try:
+        yield p.pid
+    finally:
+        p.kill()
+        p.wait()
+
+
+def test_no_diagnosis_for_a_shell_of_the_bound_managed_worker(tmp_path, sibling_spawn_pid):
+    db = _managed_board(tmp_path, sibling_spawn_pid, os.getpid())
+    assert tle.leaked_worker_env_diagnosis(_leak_env(db)) is None
+
+
+def test_no_diagnosis_when_the_delegation_owner_is_a_live_ancestor(tmp_path, sibling_spawn_pid):
+    """No worker_bound row readable, but HERMES_DELEGATED_CHILD_OWNER names a live ancestor."""
+    db = _managed_board(tmp_path, sibling_spawn_pid, None)
+    env = {**_leak_env(db), "HERMES_DELEGATED_CHILD_OWNER": f"{os.getppid()}:123"}
+    assert tle.leaked_worker_env_diagnosis(env) is None
+
+
+def test_bound_pid_this_process_does_not_descend_from_is_still_a_leak(tmp_path, sibling_spawn_pid):
+    db = _managed_board(tmp_path, sibling_spawn_pid, sibling_spawn_pid)
+    env = {**_leak_env(db), "HERMES_DELEGATED_CHILD_OWNER": f"{sibling_spawn_pid}:123"}
+    msg = tle.leaked_worker_env_diagnosis(env)
+    assert msg and "does not descend from" in msg
+
+
+def test_older_runs_bind_does_not_vouch_for_the_current_run(tmp_path, sibling_spawn_pid):
+    db = _managed_board(tmp_path, sibling_spawn_pid, None)
+    msg = tle.leaked_worker_env_diagnosis(_leak_env(db))
+    assert msg and "does not descend from" in msg
+
+
+def test_live_managed_worker_shell_gets_the_plain_cli_fence(monkeypatch, tmp_path, capsys, sibling_spawn_pid):
+    """End to end on a real board: the fence still refuses, but without the Cmd-Q leak advice."""
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    for k in ("HERMES_KANBAN_TASK", "HERMES_KANBAN_DB", "HERMES_KANBAN_BOARD", "HERMES_KANBAN_RUN_ID"):
+        monkeypatch.delenv(k, raising=False)
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    conn = kbc.connect()
+    try:
+        tid = kb.create_task(conn, title="live managed worker", assignee="default")
+        kb.claim_task(conn, tid)
+        other = kb.create_task(conn, title="the worker tries to unblock this", assignee="default")
+        run_id = conn.execute("SELECT current_run_id FROM tasks WHERE id = ?", (tid,)).fetchone()[0]
+        with conn:
+            conn.execute("UPDATE tasks SET worker_pid = ? WHERE id = ?", (sibling_spawn_pid, tid))
+            conn.execute("UPDATE task_runs SET worker_pid = ? WHERE id = ?", (sibling_spawn_pid, run_id))
+            conn.execute("INSERT INTO task_events (task_id, run_id, kind, payload, created_at) "
+                         "VALUES (?, ?, 'worker_bound', ?, 0)", (tid, run_id, json.dumps({"pid": os.getpid()})))
+    finally:
+        conn.close()
+    monkeypatch.setenv(MARKER, str(home))
+    monkeypatch.setenv("HERMES_KANBAN_WORKSPACE", str(home / "kanban" / "workspaces" / tid))
+    import argparse
+    from hermes_cli import kanban as kcli
+    rc = kcli.kanban_command(argparse.Namespace(kanban_action="archive", task_ids=[other], board=None))
+    err = capsys.readouterr()
+    text = err.err + err.out
+    assert rc != 0
+    assert "cannot mutate Kanban tasks via the CLI" in text and "kanban_* tools" in text
+    assert "leaked worker env" not in text and "Cmd-Q" not in text
