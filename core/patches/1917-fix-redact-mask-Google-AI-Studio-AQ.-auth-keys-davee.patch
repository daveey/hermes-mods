From d5e6c396d46ae8738c5a0e139e7d1c22ff3c6880 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Wed, 4 Nov 2026 03:44:06 +0000
Subject: [PATCH] fix(redact): mask Google AI Studio AQ. auth keys [daveey]

AI Studio now issues Gemini API keys as `AQ.` + ~50 chars of
[A-Za-z0-9_-]; they work as x-goog-api-key / ?key= like legacy AIza keys.
redact.py only knew AIza..., so an AQ key printed by a tool reached chat,
logs and state.db in cleartext.

Add `AQ\.[A-Za-z0-9_-]{40,}` to _PREFIX_PATTERNS. The shared matcher's
lookbehind keeps FAQ.* prose out; the 40-char floor keeps short AQ.x out.

Tests (synthetic key only): plain text, KEY=value, URL ?key= and a JSON
value are masked; FAQ. prose and AQ.x are untouched. RED before the fix:
plain/URL/JSON failed (env form was already caught by the env rule).
The a2a outbound-parity corpus gains a dotted 48-char body so it can
synthesize a token for the new pattern.
---
 agent/redact.py                  |  3 +++
 tests/agent/test_redact.py       | 35 ++++++++++++++++++++++++++++++++
 tests/plugins/test_a2a_plugin.py |  3 ++-
 3 files changed, 40 insertions(+), 1 deletion(-)

diff --git a/agent/redact.py b/agent/redact.py
index 62b1052534c..28bb1001b99 100644
--- a/agent/redact.py
+++ b/agent/redact.py
@@ -184,6 +184,9 @@ _PREFIX_PATTERNS = [
     r"xapp-\d+-[A-Za-z0-9-]{10,}",      # Slack app-Level token
     r"xox[baprs]-[A-Za-z0-9-]{10,}",    # Slack bot/app/user tokens
     r"AIza[A-Za-z0-9_-]{30,}",          # Google API keys
+    # Google AI Studio "auth key" Gemini keys (``AQ.`` + ~50 chars), used exactly like ``AIza…``.
+    # The matcher's lookbehind keeps ``FAQ.…`` prose out; the length floor keeps short ``AQ.x`` out.
+    r"AQ\.[A-Za-z0-9_-]{40,}",
     r"pplx-[A-Za-z0-9]{10,}",           # Perplexity
     r"fal_[A-Za-z0-9_-]{10,}",          # Fal.ai
     r"fc-[A-Za-z0-9]{10,}",             # Firecrawl
diff --git a/tests/agent/test_redact.py b/tests/agent/test_redact.py
index ea0712372fe..a0881ed869e 100644
--- a/tests/agent/test_redact.py
+++ b/tests/agent/test_redact.py
@@ -1041,6 +1041,41 @@ class TestXaiToken:
 
 
 
+class TestGoogleAuthKey:
+    """AI Studio "auth key" Gemini keys: ``AQ.`` + ~50 body chars (synthetic here, never a real key)."""
+
+    KEY = "AQ." + "Ab8SyntheticTestOnly0123456789abcdefghijKLMNOP_-xy"
+    BODY = KEY[3:]
+
+    def test_key_shape_is_53_chars(self):
+        assert len(self.KEY) == 53
+
+    def test_plain_text_masked(self):
+        result = redact_sensitive_text(f"gemini key is {self.KEY} ok", force=True)
+        assert self.BODY not in result
+
+    def test_env_assignment_masked(self):
+        result = redact_sensitive_text(f"GEMINI_API_KEY={self.KEY}", force=True)
+        assert self.BODY not in result
+
+    def test_url_key_query_masked(self):
+        url = f"https://generativelanguage.googleapis.com/v1beta/models?key={self.KEY}&pageSize=5"
+        result = redact_sensitive_text(url, force=True)
+        assert self.BODY not in result
+        assert "pageSize=5" in result
+
+    def test_json_value_masked(self):
+        import json
+        text = json.dumps({"value": self.KEY, "model": "gemini"})
+        result = redact_sensitive_text(text, force=True)
+        assert self.BODY not in result
+        assert '"model": "gemini"' in result
+
+    def test_faq_prose_and_short_aq_untouched(self):
+        text = "See FAQ.questionsAndAnswersSectionForMoreDetailsAboutKeys and AQ.x here."
+        assert redact_sensitive_text(text, force=True) == text
+
+
 class TestDbConnstrCodeOutput:
     """Regression tests for issue #33801 — _DB_CONNSTR_RE corrupting code output.
 
