+@pytest.mark.parametrize('system,resolved,version,accepted', [
+    ('Darwin', '/bin/bash', '3.2', True),
+    ('Linux', '/bin/bash', '3.2', False),
+    ('Darwin', '/opt/homebrew/bin/bash', '3.2', False),
