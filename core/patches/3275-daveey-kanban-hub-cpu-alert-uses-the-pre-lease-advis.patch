+# stale-advisory alert (``kanban_hub_cpu_alert``), which must call a sample stale at the age the advisory defers.
+PRELEASE_MAX_AGE_MS = ADVISORY_MAX_AGE_MS - PRELEASE_HEADROOM_MS
