From 7d6704600ed8cbb11bf75d99e1c5332f891c1af6 Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Sun, 25 Oct 2026 23:20:46 +0000
Subject: [PATCH] test(desktop): require fresh evidence in merged done-state
 fixture [daveey]

---
 apps/desktop/src/store/session-dot-state.test.ts | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/apps/desktop/src/store/session-dot-state.test.ts b/apps/desktop/src/store/session-dot-state.test.ts
index 892100f6d4..45d5cda8bf 100644
--- a/apps/desktop/src/store/session-dot-state.test.ts
+++ b/apps/desktop/src/store/session-dot-state.test.ts
@@ -69,7 +69,9 @@ describe('sessionStatusStripe', () => {
   })
 
   it('all cards done with results unseen → green (unread); none open, all done → green', () => {
-    const unseenRow = { kanban_unseen: 1 }
+    // Completion is green only with a fresh authoritative observation.
+    expect(withRowActivity('idle', { kanban_unseen: 1 })).toBe('background')
+    const unseenRow = { kanban_observed_at: Date.now() / 1000, kanban_unseen: 1 }
     const state = withRowActivity('idle', unseenRow)
     expect(state).toBe('unread')
     expect(sessionStatusStripe(state, true, false, 0, false, null, 0, 0)).toBe('done')
