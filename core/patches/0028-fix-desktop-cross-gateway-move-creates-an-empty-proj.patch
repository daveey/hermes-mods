From 8cfbc3ffc36d2e453fffa3d582f6545d859cb49a Mon Sep 17 00:00:00 2001
From: daveey <daveey@users.noreply.github.com>
Date: Tue, 13 Oct 2026 16:03:06 -0700
Subject: [PATCH] fix(desktop): cross-gateway move creates an empty project
 folder instead of cloning [daveey]

---
 .../store/projects-cross-gateway-move.test.ts | 30 +++++--------
 apps/desktop/src/store/projects.ts            | 44 +++----------------
 2 files changed, 18 insertions(+), 56 deletions(-)

diff --git a/apps/desktop/src/store/projects-cross-gateway-move.test.ts b/apps/desktop/src/store/projects-cross-gateway-move.test.ts
index 5306563753..caffa3c6a1 100644
--- a/apps/desktop/src/store/projects-cross-gateway-move.test.ts
+++ b/apps/desktop/src/store/projects-cross-gateway-move.test.ts
@@ -68,9 +68,7 @@ const localDefault: Handler = method =>
       ? { active_id: null, projects: [] }
       : method === 'session.workspace.move'
         ? { branch: 'main', cwd: LOCAL_PATH, git_repo_root: LOCAL_PATH }
-        : method === 'shell.exec'
-          ? { code: 0, stderr: '', stdout: 'git@github.com:me/myapp.git\n' }
-          : {}
+        : {}
 
 beforeEach(() => {
   vi.clearAllMocks()
@@ -110,7 +108,7 @@ describe('moveSessionToProject across gateways', () => {
       method === 'projects.list'
         ? { active_id: null, projects: [] }
         : method === 'shell.exec'
-          ? { code: 0, stderr: '', stdout: 'present\n' }
+          ? { code: 0, stderr: '', stdout: '' }
           : method === 'projects.create'
             ? { project: { id: 'p_new', name: 'myapp', primary_path: '/Users/me/code/myapp' } }
             : method === 'session.workspace.move'
@@ -149,14 +147,12 @@ describe('moveSessionToProject across gateways', () => {
     expect(remoteCalls[1][2]).toMatchObject({ cwd: '/srv/bb' })
   })
 
-  it("clones the source repo's origin when the folder is missing on the remote", async () => {
-    setup(localDefault, (method, params) =>
+  it('creates an empty folder on the remote (no clone) before creating the project', async () => {
+    setup(localDefault, method =>
       method === 'projects.list'
         ? { active_id: null, projects: [] }
         : method === 'shell.exec'
-          ? String(params.command).startsWith('test -d')
-            ? { code: 0, stderr: '', stdout: 'missing\n' }
-            : { code: 0, stderr: '', stdout: '' }
+          ? { code: 0, stderr: '', stdout: '' }
           : method === 'projects.create'
             ? { project: { primary_path: '/home/me/code/myapp' } }
             : method === 'session.workspace.move'
@@ -166,22 +162,18 @@ describe('moveSessionToProject across gateways', () => {
 
     await moveSessionToProject('remote-s', 'p_local')
 
-    const clone = remoteCalls.find(([, m, p]) => m === 'shell.exec' && String(p.command).includes('git clone'))
-    expect(clone?.[2].command).toContain(`'git@github.com:me/myapp.git'`)
-    expect(clone?.[2].command).toContain(`"$HOME"/'code/myapp'`)
-    // The origin came from the gateway that has the project (the active one).
-    expect(localCalls.find(([m]) => m === 'shell.exec')?.[1].command).toContain('remote get-url origin')
+    const shells = remoteCalls.filter(([, m]) => m === 'shell.exec').map(([, , p]) => String(p.command))
+    expect(shells).toEqual([`mkdir -p "$HOME"/'code/myapp'`])
+    expect(localCalls.some(([m]) => m === 'shell.exec')).toBe(false)
     expect(remoteCalls.at(-1)?.[2]).toMatchObject({ cwd: '/home/me/code/myapp' })
   })
 
-  it('surfaces a failed clone instead of moving', async () => {
-    setup(localDefault, (method, params) =>
+  it('surfaces a failed mkdir instead of moving', async () => {
+    setup(localDefault, method =>
       method === 'projects.list'
         ? { active_id: null, projects: [] }
         : method === 'shell.exec'
-          ? String(params.command).startsWith('test -d')
-            ? { code: 0, stderr: '', stdout: 'missing\n' }
-            : { code: 128, stderr: 'Permission denied (publickey).', stdout: '' }
+          ? { code: 1, stderr: 'Permission denied', stdout: '' }
           : {}
     )
 
diff --git a/apps/desktop/src/store/projects.ts b/apps/desktop/src/store/projects.ts
index 50d2d80fee..f85ed1ada0 100644
--- a/apps/desktop/src/store/projects.ts
+++ b/apps/desktop/src/store/projects.ts
@@ -944,7 +944,8 @@ function consumeMoveFollowSuppression(cwd: string): boolean {
 // run on the gateway that OWNS the session (asking the active one answers
 // "session not found"), with a folder that exists THERE. When the owning
 // gateway has no such project yet, it gets one: same name, the same
-// home-relative folder, cloned from the source's git origin when missing.
+// home-relative folder (created empty if missing — projects only organize the
+// sidebar).
 
 interface MoveTarget {
   connectionId: string
@@ -1046,27 +1047,6 @@ function projectSourceFor(node: SidebarProjectTree | undefined): null | { connec
   return null
 }
 
-async function sourceGitOrigin(source: { connectionId: string; path: string }): Promise<string> {
-  const self = ownerGatewayId(projectRowOwner())
-  const target: MoveTarget = { connectionId: source.connectionId, profile: null, remote: source.connectionId !== self }
-
-  if (target.remote) {
-    target.profile = normalizeProfileKey(
-      $connectionsRegistry.get()?.connections.find(c => c.id === source.connectionId)?.remoteProfile || 'default'
-    )
-  }
-
-  try {
-    const res = await moveTargetRequest<ShellResult>(target, 'shell.exec', {
-      command: `git -C ${shellPath(source.path)} remote get-url origin`
-    })
-
-    return res.code === 0 ? res.stdout.trim().split('\n')[0]?.trim() || '' : ''
-  } catch {
-    return ''
-  }
-}
-
 /**
  * The destination project's root folder ON `target`, creating the project
  * (and its folder) there when that gateway doesn't have it yet.
@@ -1099,24 +1079,14 @@ async function ensureProjectRootOn(target: MoveTarget, node: SidebarProjectTree
   }
 
   const path = homeRelativePath(source.path)
-  const word = shellPath(path)
 
-  const probe = await moveTargetRequest<ShellResult>(target, 'shell.exec', {
-    command: `test -d ${word} && echo present || echo missing`
+  // Projects only organize the sidebar here, so the folder just has to exist.
+  const make = await moveTargetRequest<ShellResult>(target, 'shell.exec', {
+    command: `mkdir -p ${shellPath(path)}`
   })
 
-  if (probe.stdout.trim() !== 'present') {
-    const origin = await sourceGitOrigin(source)
-
-    const make = await moveTargetRequest<ShellResult>(target, 'shell.exec', {
-      command: origin
-        ? `mkdir -p "$(dirname ${word})" && git clone --quiet ${shellPath(origin)} ${word}`
-        : `mkdir -p ${word}`
-    })
-
-    if (make.code !== 0) {
-      throw new Error(`Could not create ${path} on ${target.connectionId}: ${(make.stderr || make.stdout).trim()}`)
-    }
+  if (make.code !== 0) {
+    throw new Error(`Could not create ${path} on ${target.connectionId}: ${(make.stderr || make.stdout).trim()}`)
   }
 
   const created = await moveTargetRequest<{ project: null | ProjectInfo }>(target, 'projects.create', {
-- 
